<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tessera</AssemblyName>
    <RootNamespace>Tessera</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tessera.Tests" />
  </ItemGroup>

  <!-- The sources are in src\. tests\ is its own project, and the work folders hold no part of the builder. -->
  <ItemGroup>
    <Compile Remove="tests\**;scratch\**;playground\**" />
    <None Remove="tests\**;scratch\**;playground\**" />
    <Content Remove="tests\**;scratch\**;playground\**" />
    <EmbeddedResource Remove="tests\**;scratch\**;playground\**" />
  </ItemGroup>

</Project>
