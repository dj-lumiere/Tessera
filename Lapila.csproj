<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lapila</AssemblyName>
    <RootNamespace>Lapila</RootNamespace>
    <Version>0.5.0</Version>
    <!-- The shipped form is NativeAOT (dotnet publish -r <rid>). dotnet build still makes lapila.dll for the tests. -->
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lapila.Tests" />
  </ItemGroup>

  <!-- rider-plugin\ is the Rider plugin, a Gradle project of its own. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);rider-plugin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The sources are in src\. tests\ is its own project, and the work folders hold no part of the builder. -->
  <ItemGroup>
    <Compile Remove="tests\**;scratch\**;playground\**" />
    <None Remove="tests\**;scratch\**;playground\**" />
    <Content Remove="tests\**;scratch\**;playground\**" />
    <EmbeddedResource Remove="tests\**;scratch\**;playground\**" />
  </ItemGroup>

</Project>
