<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Tessera</string>
    <key>scopeName</key>
    <string>source.tess</string>
    <key>fileTypes</key>
    <array>
        <string>tess</string>
    </array>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comment</string></dict>
        <dict><key>include</key><string>#attribute</string></dict>
        <dict><key>include</key><string>#string</string></dict>
        <dict><key>include</key><string>#char</string></dict>
        <dict><key>include</key><string>#number</string></dict>
        <dict><key>include</key><string>#module-decl</string></dict>
        <dict><key>include</key><string>#routine-decl</string></dict>
        <dict><key>include</key><string>#block-decl</string></dict>
        <dict><key>include</key><string>#record-decl</string></dict>
        <dict><key>include</key><string>#member-decl</string></dict>
        <dict><key>include</key><string>#concept-decl</string></dict>
        <dict><key>include</key><string>#preset-decl</string></dict>
        <dict><key>include</key><string>#expression</string></dict>
    </array>
    <key>repository</key>
    <dict>

        <!-- /// doc comment (Markdown, so `code` spans stand out) and // line comment -->
        <key>comment</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>comment.line.documentation.tess</string>
                    <key>begin</key>
                    <string>///</string>
                    <key>end</key>
                    <string>$</string>
                    <key>patterns</key>
                    <array>
                        <dict>
                            <key>name</key>
                            <string>markup.inline.raw.tess</string>
                            <key>match</key>
                            <string>`[^`]*`</string>
                        </dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key>
                    <string>comment.line.double-slash.tess</string>
                    <key>match</key>
                    <string>//.*$</string>
                </dict>
            </array>
        </dict>

        <!-- @[key("val"), key], bare @word, and @word(args) attributes, such as @derive(Equal, Hash) -->
        <key>attribute</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>meta.attribute.tess</string>
                    <key>begin</key>
                    <string>@\[</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\]</string>
                    <key>endCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                    </dict>
                    <key>patterns</key>
                    <array>
                        <dict>
                            <key>match</key>
                            <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\(|,|\])</string>
                            <key>captures</key>
                            <dict>
                                <key>1</key>
                                <dict><key>name</key><string>entity.other.attribute-name.tess</string></dict>
                            </dict>
                        </dict>
                        <dict><key>include</key><string>#attribute-args</string></dict>
                        <dict><key>include</key><string>#string</string></dict>
                        <dict><key>include</key><string>#number</string></dict>
                        <dict><key>include</key><string>#comment</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key>
                    <string>meta.attribute.tess</string>
                    <key>begin</key>
                    <string>(@)([a-zA-Z_][a-zA-Z0-9_]*)\s*(\()</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.other.attribute-name.tess</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\)</string>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#attribute-arg-body</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(@)([a-zA-Z_][a-zA-Z0-9_]*)\b</string>
                    <key>name</key>
                    <string>meta.attribute.tess</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.other.attribute-name.tess</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- (...) argument list of an attribute, with nested parentheses -->
        <key>attribute-args</key>
        <dict>
            <key>begin</key>
            <string>\(</string>
            <key>end</key>
            <string>\)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#attribute-arg-body</string></dict>
            </array>
        </dict>

        <key>attribute-arg-body</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#attribute-args</string></dict>
                <dict><key>include</key><string>#string</string></dict>
                <dict><key>include</key><string>#char</string></dict>
                <dict><key>include</key><string>#number</string></dict>
                <dict><key>include</key><string>#comment</string></dict>
                <dict>
                    <key>match</key>
                    <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)(?!:)</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.parameter.attribute.tess</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#types</string></dict>
            </array>
        </dict>

        <!-- "strings", with escapes and write/print template holes: "x = {%x}, {{literal}}" -->
        <key>string</key>
        <dict>
            <key>name</key>
            <string>string.quoted.double.tess</string>
            <key>begin</key>
            <string>"</string>
            <key>end</key>
            <string>"</string>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.character.escape.tess</string>
                    <key>match</key>
                    <string>\\(?:[ntr0\\"']|x[0-9a-fA-F]{2})</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.character.escape.tess</string>
                    <key>match</key>
                    <string>\{\{|\}\}</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>meta.embedded.expression.tess</string>
                    <key>begin</key>
                    <string>\{</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.section.embedded.begin.tess</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\}</string>
                    <key>endCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.section.embedded.end.tess</string></dict>
                    </dict>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#char</string></dict>
                        <dict><key>include</key><string>#number</string></dict>
                        <dict><key>include</key><string>#expression</string></dict>
                    </array>
                </dict>
            </array>
        </dict>

        <!-- b'A' b'\x7f' (Byte) and 'A' '\n' (Char) literals -->
        <key>char</key>
        <dict>
            <key>name</key>
            <string>string.quoted.single.tess</string>
            <key>match</key>
            <string>b?'(?:\\(?:[ntr0\\"']|x[0-9a-fA-F]{2})|[^\\'])'</string>
        </dict>

        <!-- numbers: 0xFF 0b1010 0o17 1_000 -5 3.14 1.5e10 2e-3 -->
        <key>number</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.hex.tess</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0x[0-9a-fA-F_]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.binary.tess</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0b[01_]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.octal.tess</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0o[0-7_]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.float.tess</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?[0-9][0-9_]*(?:\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.integer.tess</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?[0-9][0-9_]*\b</string>
                </dict>
            </array>
        </dict>

        <!-- module Standard::Core / import Standard::Format -->
        <key>module-decl</key>
        <dict>
            <key>match</key>
            <string>^(module|import)\s+([A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.namespace.tess</string></dict>
            </dict>
        </dict>

        <!-- [private|internal] routine Foo<T>.bar(...) or routine foo<T>(...) -->
        <key>routine-decl</key>
        <dict>
            <key>match</key>
            <string>^(?:(private|internal)\s+)?(routine)\s+(?:([A-Za-z_][A-Za-z0-9_]*(?:&lt;[^&gt;(]*&gt;)?)(\.))?([A-Za-z_][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>storage.modifier.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>3</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
                <key>5</key>
                <dict><key>name</key><string>entity.name.function.tess</string></dict>
            </dict>
        </dict>

        <!-- block entry(): or block loop(%i: U64): -->
        <key>block-decl</key>
        <dict>
            <key>match</key>
            <string>\b(block)\s+([a-zA-Z_][a-zA-Z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.label.tess</string></dict>
            </dict>
        </dict>

        <!-- record Foo<T>, then its require / conform lines and its fields -->
        <key>record-decl</key>
        <dict>
            <key>begin</key>
            <string>^(?:(private|internal)\s+)?(record)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>beginCaptures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>storage.modifier.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>3</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
            </dict>
            <key>end</key>
            <string>^(?=\S)(?!require\b|conform\b)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#comment</string></dict>
                <dict><key>include</key><string>#attribute</string></dict>
                <dict>
                    <key>match</key>
                    <string>^\s+(?:(private|internal)\s+)?([a-z_][A-Za-z0-9_]*)\s*(?=:)</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>storage.modifier.tess</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.property.tess</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#expression</string></dict>
            </array>
        </dict>

        <!-- choice Color: U8 and variant Expr, then their members and cases -->
        <key>member-decl</key>
        <dict>
            <key>begin</key>
            <string>^(?:(private|internal)\s+)?(choice|variant)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>beginCaptures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>storage.modifier.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>3</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
            </dict>
            <key>end</key>
            <string>^(?=\S)(?!require\b|conform\b)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#comment</string></dict>
                <dict>
                    <key>match</key>
                    <string>^\s+([A-Z][A-Za-z0-9_]*)\b</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.other.enummember.tess</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#number</string></dict>
                <dict><key>include</key><string>#expression</string></dict>
            </array>
        </dict>

        <!-- concept Equal<T> -->
        <key>concept-decl</key>
        <dict>
            <key>match</key>
            <string>\b(concept)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
            </dict>
        </dict>

        <!-- preset PI: F64 = ... and preset F64.MAX: F64 = ... -->
        <key>preset-decl</key>
        <dict>
            <key>match</key>
            <string>\b(preset)\s+(?:([A-Z][A-Za-z0-9_]*)(\.))?([A-Z_][A-Za-z0-9_]*)\b</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
                <key>4</key>
                <dict><key>name</key><string>variable.other.constant.tess</string></dict>
            </dict>
        </dict>

        <!-- everything that can appear in a routine body or a type position -->
        <key>expression</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#jump-target</string></dict>
                <dict><key>include</key><string>#keywords</string></dict>
                <dict><key>include</key><string>#values</string></dict>
                <dict><key>include</key><string>#namespace</string></dict>
                <dict><key>include</key><string>#calls</string></dict>
                <dict><key>include</key><string>#members</string></dict>
                <dict><key>include</key><string>#types</string></dict>
                <dict><key>include</key><string>#punctuation</string></dict>
            </array>
        </dict>

        <!-- jump loop(...): the block it goes to -->
        <key>jump-target</key>
        <dict>
            <key>match</key>
            <string>\b(jump)\s+([a-z_][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.control.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.label.tess</string></dict>
            </dict>
        </dict>

        <key>keywords</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>keyword.control.tess</string>
                    <key>match</key>
                    <string>(?&lt;![%#\w])(branch|jump|return|unreachable|when|else|continue)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.other.declaration.tess</string>
                    <key>match</key>
                    <string>(?&lt;![%#\w])(routine|block|record|choice|variant|concept|conform|preset|module|import|claim)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>storage.modifier.tess</string>
                    <key>match</key>
                    <string>(?&lt;![%#\w])(private|internal)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.other.tess</string>
                    <key>match</key>
                    <string>(?&lt;![%#\w])(require|typename)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.language.tess</string>
                    <key>match</key>
                    <string>(?&lt;![%#\w])(true|false|null)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>variable.language.self-type.tess</string>
                    <key>match</key>
                    <string>\bSelf\b</string>
                </dict>
            </array>
        </dict>

        <!-- %value (pointers included) and %self -->
        <key>values</key>
        <dict>
            <key>patterns</key>
            <array>
                <!-- the whole name, % included, takes one scope, so a theme colors it as one token -->
                <dict>
                    <key>name</key>
                    <string>variable.language.self.tess</string>
                    <key>match</key>
                    <string>%self\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>variable.parameter.tess</string>
                    <key>match</key>
                    <string>%[A-Za-z_][A-Za-z0-9_]*</string>
                </dict>
            </array>
        </dict>

        <!-- Standard::Collections:: in a qualified path -->
        <key>namespace</key>
        <dict>
            <key>match</key>
            <string>\b([A-Z][A-Za-z0-9_]*)(::)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>entity.name.namespace.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>punctuation.separator.namespace.tess</string></dict>
            </dict>
        </dict>

        <!-- %x.method(...), routine(...), routine<T>(...), and a block called from branch / when -->
        <key>calls</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>match</key>
                    <string>(\.)([a-z_][A-Za-z0-9_]*)(?=\s*[(&lt;])</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.name.function.method.tess</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(?&lt;![%#\w.])([a-z_][A-Za-z0-9_]*)(?=\s*[(&lt;])</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>entity.name.function.call.tess</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- .field, .CONSTANT, and .Case / Color.Red after a dot -->
        <key>members</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>match</key>
                    <string>(\.)([A-Z][A-Z0-9_]+)\b(?![a-z])</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.constant.tess</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(\.)([A-Z][A-Za-z0-9_]*)\b</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.enummember.tess</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(\.)([a-z_][A-Za-z0-9_]*)\b</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.property.tess</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- built-in types, presets (UPPER_CASE), and other types (PascalCase, T) -->
        <key>types</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>support.type.primitive.tess</string>
                    <key>match</key>
                    <string>\b(S8|S16|S32|S64|S128|S256|U8|U16|U32|U64|U128|U256|USize|SSize|Byte|Char|F16|BF16|F32|F64|F128|Bool|Void|Unit|CInt|CLong|CWChar|Ptr|Addr|Array|Callable)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>variable.other.constant.tess</string>
                    <key>match</key>
                    <string>\b[A-Z][A-Z0-9]*_[A-Z0-9_]*\b|\b[A-Z]{2,}\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>entity.name.type.tess</string>
                    <key>match</key>
                    <string>\b[A-Z][A-Za-z0-9_]*\b</string>
                </dict>
            </array>
        </dict>

        <!-- no operators: only the arrow, the select / branch marks, binding, and paths -->
        <key>punctuation</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>keyword.operator.arrow.tess</string>
                    <key>match</key>
                    <string>-&gt;</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.operator.ternary.tess</string>
                    <key>match</key>
                    <string>\?</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.operator.assignment.tess</string>
                    <key>match</key>
                    <string>(?&lt;![=!&lt;&gt;])=(?!=)</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>punctuation.separator.namespace.tess</string>
                    <key>match</key>
                    <string>::</string>
                </dict>
            </array>
        </dict>

    </dict>
</dict>
</plist>
