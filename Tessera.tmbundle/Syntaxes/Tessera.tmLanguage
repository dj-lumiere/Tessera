<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Tessera</string>
    <key>scopeName</key>
    <string>source.tess</string>
    <key>fileTypes</key>
    <array>
        <string>tess</string>
    </array>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comment</string></dict>
        <dict><key>include</key><string>#attribute</string></dict>
        <dict><key>include</key><string>#string</string></dict>
        <dict><key>include</key><string>#char</string></dict>
        <dict><key>include</key><string>#number</string></dict>
        <dict><key>include</key><string>#routine-decl</string></dict>
        <dict><key>include</key><string>#block-decl</string></dict>
        <dict><key>include</key><string>#record-decl</string></dict>
        <dict><key>include</key><string>#choice-decl</string></dict>
        <dict><key>include</key><string>#concept-decl</string></dict>
        <dict><key>include</key><string>#preset-decl</string></dict>
        <dict><key>include</key><string>#module-decl</string></dict>
        <dict><key>include</key><string>#keywords-control</string></dict>
        <dict><key>include</key><string>#keywords-declaration</string></dict>
        <dict><key>include</key><string>#keywords-other</string></dict>
        <dict><key>include</key><string>#builtin-types</string></dict>
        <dict><key>include</key><string>#sigil-self</string></dict>
        <dict><key>include</key><string>#sigil-ssa</string></dict>
        <dict><key>include</key><string>#sigil-ptr</string></dict>
        <dict><key>include</key><string>#operators</string></dict>
    </array>
    <key>repository</key>
    <dict>

        <!-- /// doc comment and // line comment -->
        <key>comment</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>comment.line.documentation.tess</string>
                    <key>match</key>
                    <string>///.*$</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>comment.line.double-slash.tess</string>
                    <key>match</key>
                    <string>//.*$</string>
                </dict>
            </array>
        </dict>

        <!-- @[key("val"), key], bare @word, and @word(args) attributes -->
        <key>attribute</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>meta.attribute.tess</string>
                    <key>begin</key>
                    <string>@\[</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\]</string>
                    <key>endCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                    </dict>
                    <key>patterns</key>
                    <array>
                        <dict>
                            <key>match</key>
                            <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\(|,|\])</string>
                            <key>captures</key>
                            <dict>
                                <key>1</key>
                                <dict><key>name</key><string>entity.other.attribute-name.tess</string></dict>
                            </dict>
                        </dict>
                        <dict><key>include</key><string>#attribute-args</string></dict>
                        <dict><key>include</key><string>#string</string></dict>
                        <dict><key>include</key><string>#number</string></dict>
                        <dict><key>include</key><string>#comment</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key>
                    <string>meta.attribute.tess</string>
                    <key>begin</key>
                    <string>(@)([a-zA-Z_][a-zA-Z0-9_]*)\s*(\()</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.other.attribute-name.tess</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\)</string>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#attribute-arg-body</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(@)([a-zA-Z_][a-zA-Z0-9_]*)\b</string>
                    <key>name</key>
                    <string>meta.attribute.tess</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>punctuation.definition.attribute.tess</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.other.attribute-name.tess</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- (...) argument list of an attribute, with nested parentheses -->
        <key>attribute-args</key>
        <dict>
            <key>begin</key>
            <string>\(</string>
            <key>end</key>
            <string>\)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#attribute-arg-body</string></dict>
            </array>
        </dict>

        <key>attribute-arg-body</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#attribute-args</string></dict>
                <dict><key>include</key><string>#string</string></dict>
                <dict><key>include</key><string>#char</string></dict>
                <dict><key>include</key><string>#number</string></dict>
                <dict><key>include</key><string>#comment</string></dict>
                <dict>
                    <key>match</key>
                    <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)(?!:)</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.parameter.attribute.tess</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- "string literals" -->
        <key>string</key>
        <dict>
            <key>name</key>
            <string>string.quoted.double.tess</string>
            <key>begin</key>
            <string>"</string>
            <key>end</key>
            <string>"</string>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.character.escape.tess</string>
                    <key>match</key>
                    <string>\\(n|t|r|0|\\|"|'|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})</string>
                </dict>
            </array>
        </dict>

        <!-- b'A' b'\xFF' (Byte) and 'A' '\u{…}' (Char) literals -->
        <key>char</key>
        <dict>
            <key>name</key>
            <string>string.quoted.single.tess</string>
            <key>match</key>
            <string>b?'(\\(n|t|r|0|\\|'|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})|[^\\'])'</string>
        </dict>

        <!-- numeric literals: 0xFF 0b1010 0o17 3.14 1.5e10 42 -->
        <key>number</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.hex.tess</string>
                    <key>match</key>
                    <string>\b0x[0-9a-fA-F]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.binary.tess</string>
                    <key>match</key>
                    <string>\b0b[01]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.octal.tess</string>
                    <key>match</key>
                    <string>\b0o[0-7]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.float.tess</string>
                    <key>match</key>
                    <string>\b[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.integer.tess</string>
                    <key>match</key>
                    <string>\b[0-9]+\b</string>
                </dict>
            </array>
        </dict>

        <!-- routine Foo<T>.bar(...) or routine foo<T>(...) -->
        <key>routine-decl</key>
        <dict>
            <key>match</key>
            <string>\b(routine)\s+([A-Za-z_][A-Za-z0-9_]*(?:&lt;[^&gt;(]*&gt;)?(?:\.[A-Za-z_][A-Za-z0-9_]*(?:&lt;[^&gt;(]*&gt;)?)?)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.function.tess</string></dict>
            </dict>
        </dict>

        <!-- block entry(): or block loop(%i: U64): -->
        <key>block-decl</key>
        <dict>
            <key>match</key>
            <string>\b(block)\s+([a-zA-Z_][a-zA-Z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.label.tess</string></dict>
            </dict>
        </dict>

        <!-- record Foo<T> -->
        <key>record-decl</key>
        <dict>
            <key>match</key>
            <string>\b(record)\s+([A-Z][A-Za-z0-9_]*(?:&lt;[^&gt;]*&gt;)?)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
            </dict>
        </dict>

        <!-- choice Foo -->
        <key>choice-decl</key>
        <dict>
            <key>match</key>
            <string>\b(choice)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
            </dict>
        </dict>

        <!-- concept Equal<T> -->
        <key>concept-decl</key>
        <dict>
            <key>match</key>
            <string>\b(concept)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.tess</string></dict>
            </dict>
        </dict>

        <!-- preset PI: F64 = ... -->
        <key>preset-decl</key>
        <dict>
            <key>match</key>
            <string>\b(preset)\s+([A-Z_][A-Z0-9_]*)\b</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>variable.other.constant.tess</string></dict>
            </dict>
        </dict>

        <!-- control flow terminators -->
        <key>keywords-control</key>
        <dict>
            <key>name</key>
            <string>keyword.control.tess</string>
            <key>match</key>
            <string>\b(branch|jump|return|unreachable|when|continue)\b</string>
        </dict>

        <!-- module Standard::Core / import Standard::Format -->
        <key>module-decl</key>
        <dict>
            <key>match</key>
            <string>^(module|import)\s+([A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.tess</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.namespace.tess</string></dict>
            </dict>
        </dict>

        <!-- declaration keywords (not already handled by decl patterns above) -->
        <key>keywords-declaration</key>
        <dict>
            <key>name</key>
            <string>keyword.other.declaration.tess</string>
            <key>match</key>
            <string>\b(routine|block|record|choice|concept|preset|private|module|import|claim|self)\b</string>
        </dict>

        <!-- remaining keywords -->
        <key>keywords-other</key>
        <dict>
            <key>name</key>
            <string>keyword.other.tess</string>
            <key>match</key>
            <string>\b(require|typename|Self|true|false|null|conform)\b</string>
        </dict>

        <!-- built-in primitive types -->
        <key>builtin-types</key>
        <dict>
            <key>name</key>
            <string>support.type.primitive.tess</string>
            <key>match</key>
            <string>\b(S8|S16|S32|S64|S128|S256|U8|U16|U32|U64|U128|U256|Byte|Bits16|Bits32|Bits64|Bits128|Bits256|Char|F16|BF16|F32|F64|F128|Bool|Void|Unit|CInt|CLong|CSize|CWChar|Ptr|Addr|Array)\b</string>
        </dict>

        <!-- %self / #self — the special self parameter -->
        <key>sigil-self</key>
        <dict>
            <key>name</key>
            <string>variable.language.self.tess</string>
            <key>match</key>
            <string>[%#]self\b</string>
        </dict>

        <!-- %ssa_value -->
        <key>sigil-ssa</key>
        <dict>
            <key>match</key>
            <string>(%)[a-zA-Z_][a-zA-Z0-9_]*</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>punctuation.definition.variable.tess</string></dict>
                <key>0</key>
                <dict><key>name</key><string>variable.other.ssa.tess</string></dict>
            </dict>
        </dict>

        <!-- #ptr_variable -->
        <key>sigil-ptr</key>
        <dict>
            <key>match</key>
            <string>(#)[a-zA-Z_][a-zA-Z0-9_]*</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>punctuation.definition.variable.tess</string></dict>
                <key>0</key>
                <dict><key>name</key><string>variable.other.pointer.tess</string></dict>
            </dict>
        </dict>

        <!-- operators -->
        <key>operators</key>
        <dict>
            <key>name</key>
            <string>keyword.operator.tess</string>
            <key>match</key>
            <string>(->|::|==|!=|\?|~|\+|-|\*|&amp;|\||\^|!(?!=))</string>
        </dict>

    </dict>
</dict>
</plist>
