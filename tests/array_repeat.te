### `[0] * 256` repeats the elements: in a value, a preset, and a global, with the count a literal or a preset.
import Hosted

global ROW: &Array[S64, WIDTH] <- [7] * WIDTH

preset WIDTH: U64 = 4
preset ZEROS: &Array[U8, 8] <- [0] * 8
preset PAIRS: &Array[S32, 6] <- [1, 2] * 3

### Prints an array of S32 on one line.
### :param a: The array.
routine show_six(a: Array[S32, 6]) -> None
    Console.show("{a.getitem(0)} {a.getitem(1)} {a.getitem(2)} {a.getitem(3)} {a.getitem(4)} {a.getitem(5)}")
    return

routine start() -> None
    twice: Array[S32, 6] = [5, 6, 9] * 2
    show_six(twice)
    show_six(PAIRS.peek())
    Console.show("{ZEROS.getitem(7)} {ROW.getitem(3)}")
    filled: Array[B64, 3] = [0.5] * 3
    Console.show("{filled.getitem(2)}")
    return
