// Membership: has / lacks for an element or a piece of text, has_key / lacks_key for a dict's key.

import Standard/Collections
import Standard/Format
import Standard/Os

/// Prints each membership test.
routine start() -> Void
    local s: @Set[S64] <- .construct()
    local d: @Dict[S64, S64] <- .construct()

    s.add(1)
    d.setitem(key: 2, value: 3)
    t: Span[Byte] = "hello"
    needle: Span[Byte] = "ell"
    Out.write("{s.has(1)} {s.lacks(1)} {s.lacks(5)} {d.has_key(2)} {d.lacks_key(2)} {t.has(needle)} {t.lacks(needle)}\n")
    s.destruct()
    d.destruct()
    return()
