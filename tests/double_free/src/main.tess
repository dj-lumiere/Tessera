// Copying a Memory copies its address, its manager, and its generation: both copies are the same memory. The first
// drop() gives the memory back and leaves its own copy hollow, so a second drop() of it does nothing. The other copy
// is stale: it was copied in another routine, where the build doesn't follow it, so the build can't see that it was
// given back already, and its drop() finds the block's stamp cleared and crashes with DroppedMemoryError at that line,
// before the memory is given back a second time. This handler prints the crash and exits with status 3.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> Void

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    Out.write("{name}: {message}\nat {place.file.peek()} line {place.line.peek()}\n")
    exit(3)

/// A copy of the memory in `slot`: the same memory, made where the caller doesn't see it.
/// :param slot: The slot.
/// :returns: The copy.
routine copy_of(slot: @Memory[U64]) -> Memory[U64]
    return slot.peek()

routine start() -> Void
    local first: @Memory[U64] <- .construct(4)
    local second: @Memory[U64] <- copy_of(first)
    first.drop()
    Out.write("first dropped\n")
    first.drop()
    Out.write("first again: nothing, it is hollow now\n")
    second.drop()
    Out.write("not reached\n")
    return
