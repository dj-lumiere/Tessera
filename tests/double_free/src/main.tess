// Copying a Slice copies its allocator, so both copies can give the memory back. The first destruct() does, and
// empties its own copy. The other copy still holds the address and the allocator, and its destruct() frees the block a
// second time: in a debug build the default heap sees that and crashes with DoubleFreeError at that line. This
// handler prints the crash and exits with status 3.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat {place.file.load()} line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    block entry()
        claim first  : @Slice<U64> <- .construct(4)
        claim second : @Slice<U64> <- first.load()
        first.destruct()
        Out.write("first destructed\n")
        first.destruct()
        Out.write("first again: nothing, its allocator is null now\n")
        second.destruct()
        Out.write("not reached\n")
        return(0)
