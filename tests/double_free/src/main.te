# A Memory is never copied, but two holders of one can still be made out of the build's sight: the bytes of one copied
# into another's slot. Both are the same memory. The first drop gives the memory back. The other holder is stale: its
# bits were copied where the build doesn't follow them, so the build can't see that it was given back already, and its
# drop finds the block's stamp cleared and crashes with DestructedMemoryError at that line, before the memory is given
# back a second time. This handler prints the crash and exits with status 3.

import Standard/Alloc
import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\nat {place.file.peek()} line {place.line.peek()}\n")
    exit(3)

### Makes `into` a second holder of the memory in `slot`: the holder's bytes copied one by one, which the build doesn't
### follow, so both hold the same memory.
### :param slot: The holder copied.
### :param into: The slot that becomes the second holder.
routine copy_of(slot: @Memory[U64], into: @Memory[U64]) -> None
    into.to[@Byte]().copy(src: slot.to[@Byte](), count: sizeof[Memory[U64]]())
    return

routine start() -> None
    local first: @Memory[U64] <- .construct(4)
    local second: @Memory[U64] <- .hollow()

    copy_of(slot: first, into: second)
    drop first
    Out.write("first dropped\n")
    drop second
    Out.write("not reached\n")
    return
