# An entity made with a view, handed over with steal, takes the view's source along.
import Hosted

### Holds a view.
entity Holder
    data: @[Byte]

### Makes a holder.
### :param data: The view to keep.
### :returns: The holder.
common routine Holder.construct(data: @[Byte]) -> Me
    return Me(data)

### Hands the holder over, then reads it after the view's memory is given back.
routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP
    h: &Holder <- Holder.construct(data: m.getslice()) from HEAP
    k: &Holder <- steal h
    drop m
    Console.show("{k.data.peek().count}")
    drop k
    return
