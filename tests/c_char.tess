// CChar is C's char: S8 where char is signed (x86, Apple arm64, Windows on ARM, MIPS, wasm, AVR) and U8 where it's
// unsigned (other AArch64, 32-bit ARM, RISC-V, POWER). Every CI host has a signed char.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        lowest : CChar = CChar.MIN
        Out.write("{lowest} {CInt.MAX}\n")
        return(0)
