# A ticket destructed before it is given back crashes with TicketNotGivenBackError: its thread would be lost.

import Standard/Os

routine one() -> U64
    return 1

routine start() -> None
    local t: @Thread[U64] <- get_thread[U64]()

    t.peek().put_work(entry: one.to[Callable]())
    t.peek().wait_finished()
    drop t
    return
