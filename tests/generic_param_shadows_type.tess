/// A type parameter shadows a type of the same name inside the routine or record that declares it: here a record
/// called `TKey` and a generic `pick[TKey]` coexist, and outside the generic code `TKey` is the record again.
import Standard/Format

import Standard/Os

/// A record that happens to share its name with a type parameter.
record TKey
    id: S64

/// A pair whose first slot is named after the record above.
record Entry[TKey, TValue]
needs TKey: typename, TValue: typename
    key: TKey
    value: TValue

/// Makes a `TKey` from its fields.
/// :param id: Its `id`.
/// :returns: The new value.
routine TKey.construct(id: S64) -> Me
    return Me(id)

/// Releases nothing: a `TKey` holds no memory of its own.
routine TKey.destruct(me: @Me) -> None
    return

/// Makes a `Entry` from its fields.
/// :param key: Its `key`.
/// :param value: Its `value`.
/// :returns: The new value.
routine Entry[TKey, TValue].construct(key: TKey, value: TValue) -> Me
needs TKey: typename, TValue: typename
    return Me(key, value)

/// Releases nothing: a `Entry` holds no memory of its own.
routine Entry[TKey, TValue].destruct(me: @Me) -> None
needs TKey: typename, TValue: typename
    return

/// Returns its argument.
/// :param x: The value.
/// :returns: The same value, of the parameter's type, not of the record `TKey`.
routine pick[TKey](x: TKey) -> TKey
needs TKey: typename
    return x

/// Builds an `Entry` from a key and a value.
/// :param k: The key.
/// :param v: The value.
/// :returns: The entry.
routine make[TKey, TValue](k: TKey, v: TValue) -> Entry[TKey, TValue]
needs TKey: typename, TValue: typename
    return Entry[TKey, TValue](key: k, value: v)

/// Shows that the parameter and the record of the same name stay apart.
routine start() -> None
    n: S64 = pick[S64](41)
    t: Span[Byte] = pick[Span[Byte]]("text")
    r: TKey = TKey(id: 9)
    e: Entry[Span[Byte], S64] = make[Span[Byte], S64](k: "k", v: 3)
    Out.write("{n.add(1)} {t} {r.id} {e.key} {e.value}\n")
    return
