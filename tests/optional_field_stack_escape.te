# A field filled from STACK holds a slot of the frame: filling one the caller keeps is a build error.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

### Gives the node a next one.
### :param node: The node.
routine attach(node: @Node) -> None
    node.next <- Node.construct(2) from STACK
    return

routine start() -> None
    first: &Node <- Node.construct(1)
    attach(first)
    return
