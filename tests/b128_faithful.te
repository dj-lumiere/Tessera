# text.to_faithful_result[B128]() returns one of the two B128 values around each decimal.

import Standard/Format
import Standard/Os

routine check(out: @ConsoleOutput, text: @[Byte], lo: U128, hi: U128) -> None
    local parsed: Result[B128, ParseError] = text.to_faithful_result[B128]()
    local bits: U128 = parsed.unwrap().bits()

    if bits == lo or bits == hi
        out.write("ok\n")
        return
    else
        out.write("outside: {text} ")
        bits.represent_hex_into(out)
        out.write("\n")
        return

