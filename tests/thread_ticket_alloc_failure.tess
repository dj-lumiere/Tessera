// get_thread crashes with MemoryAllocationError, at the caller's line, when its manager's allocator can't give the
// thread's worker.

import Standard/Alloc
import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> Void

/// Reports the crash and the caller's line on stdout, where the golden test sees them, and exits with status 3.
/// :param name: The crash kind.
/// :param message: The crash message.
/// :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    Out.write("crashed: {name} at line {place.line.peek()}\n")
    exit(3)

/// An allocator call that always fails.
/// :param state: Unused.
/// :param size: Unused.
/// :returns: Null.
routine refuse_alloc(state: Addr, size: USize, align: USize) -> Addr
    return null

/// A reallocation that always fails.
/// :param state: Unused.
/// :param old: Unused.
/// :param size: Unused.
/// :returns: Null.
routine refuse_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    return null

/// A free that has nothing to do.
/// :param state: Unused.
/// :param ptr: Unused.
routine ignore_free(state: Addr, ptr: Addr) -> Void
    return

/// The thread's work, never run.
/// :param count: Unused.
routine work(count: @U32) -> Void
    return

routine start() -> Void
    local count: @U32 <- 0
    local nothing: @MemoryManager <- (alloc_fn: refuse_alloc.to[Callable](), realloc_fn: refuse_realloc.to[Callable](), free_fn: ignore_free.to[Callable](), reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: null)
    local threads: @ThreadManager <- .construct(alloc: nothing)

    t: Thread[Void] = get_thread[Void](manager: threads)
    t.put_work(entry: work.to[Callable](), args: count)
    t.wait_finished()
    t.give_back()
    Out.write("not reached\n")
    return
