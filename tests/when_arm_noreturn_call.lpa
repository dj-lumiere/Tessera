# A value when's arm that calls a routine that never returns fits a value of any type, as an arm with return does.

import Hosted

### Stops the program.
@noreturn
routine fail_now() -> None
    unreachable

### Picks the value for `k`, and stops for any other.
### :param k: The key.
### :returns: The value.
routine pick(k: S64) -> S64
    v: S64 = when k
        1 => 10
        else => fail_now()
    return v

routine start() -> None
    Console.show("{pick(1)}")
    return
