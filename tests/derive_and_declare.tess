// A type either derives a routine or declares it, not both.

#derive(Equatable)
record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.eq(me: Me, other: Me) -> Bool
    return(true)

routine start() -> Void
    return()
