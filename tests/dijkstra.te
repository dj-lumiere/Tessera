# Dijkstra's shortest path
#
# Finds single-source shortest distances on a directed weighted graph.
#
# Stdlib used:
#   PriorityQueue[S64, U64]      min-heap of nodes keyed by tentative distance
#   List[Edge]                     per-node adjacency list
#
# Control flow highlights:
#   block-parameter loops for dist initialisation, edge relaxation, printing
#   inline branch terminator to drop stale priority-queue entries
#   pop_entry for the distance and the node together

import Standard/Alloc
import Standard/Collections
import Standard/Os

# ── C FFI ─────────────────────────────────────────────────────────────────────

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

# ── Types ─────────────────────────────────────────────────────────────────────

preset INF: S64 = S64.MAX  # the sentinel for "unreachable"

record Edge
    to: U64
    weight: S64

### adj owns one List[Edge] per node: getslot(u) lends node u's list in place, and dropping the graph ends every
### list with it.
entity Graph
    adj: List[List[Edge]]
    num_nodes: U64

# ── Graph ─────────────────────────────────────────────────────────────────────

common routine Graph.construct(num_nodes: U64, alloc: @MemoryManager) -> Me
    local adj: @List[List[Edge]] <- .construct(alloc)

    each i in 0 til num_nodes
        adj.add_last(List[Edge].construct(alloc))
    then
        return Me(adj: steal adj, num_nodes)

@reshaping
routine @Graph.add_edge(from: U64, to: U64, weight: S64) -> None
    me.adj.getslot(from).add_last(Edge(to, weight))
    return

routine @Graph.destruct() -> None
    drop me.adj
    return

# ── Dijkstra ─────────────────────────────────────────────────────────────────
#
# dist must be caller-allocated with num_nodes elements.
# Fills it with shortest distances from source (INF where unreachable).
# Owns and frees the priority queue before returning.

routine dijkstra(graph:  @Graph, source: U64, dist:   @S64, alloc:  @MemoryManager) -> None
    local n: U64 = graph.num_nodes.peek()
    local pq: @PriorityQueue[S64, U64] <- .construct(alloc)

    # Phase 1 — initialise every distance slot to INF.
    each i in 0 til n
        dist.stride(i).poke(INF)

    # Phase 2 — set the source distance to 0 and seed the queue.
    dist.stride(source).poke(0)
    pq.add(priority: 0, element: source)

    # Phase 3 — drain the queue, relaxing edges on each settled node.
    until pq.is_empty()
        top: PriorityEntry[S64, U64] = pq.remove_entry()
        d: S64 = top.priority
        u: U64 = top.element
        best: S64 = dist.stride(u).peek()
        # re-push instead of decrease-key produces stale entries — drop them.
        if d > best
            continue
        else
            list: @List[Edge] = graph.adj.getslot(u)

            len: U64 = list.count()

            each i in 0 til len
                edge: Edge = list[i]
                v: U64 = edge.to
                w: S64 = edge.weight
                new_dist: S64 = d + w
                best2: S64 = dist.stride(v).peek()
                if new_dist < best2
                    dist.stride(v).poke(new_dist)
                    pq.add(priority: new_dist, element: v)
            then
                continue
    drop pq
    return

# ── start ────────────────────────────────────────────────────────────────────
#
# Classic 6-node directed weighted graph:
#
#       7        10       11        6
#   0 ───> 1 ───> 2 ───> 3 ───> 4
#   |      |      |              |
#   | 9    | 15   | 2            | 9
#   v      v      v              v
#   2      3      5 <─────────── 5
#   |             ^
#   └─────14──────┘   (0 ──14──> 5)
#
# Expected shortest distances from node 0:
#   node 0:  0    (source)
#   node 1:  7    (0→1)
#   node 2:  9    (0→2)
#   node 3: 20    (0→2→3)
#   node 4: 26    (0→2→3→4)
#   node 5: 11    (0→2→5)

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local graph: @Graph <- .construct(num_nodes: 6, alloc)
    local distances: @Memory[S64] <- .hollow()

    graph.add_edge(from: 0, to: 1, weight: 7)
    graph.add_edge(from: 0, to: 2, weight: 9)
    graph.add_edge(from: 0, to: 5, weight: 14)
    graph.add_edge(from: 1, to: 2, weight: 10)
    graph.add_edge(from: 1, to: 3, weight: 15)
    graph.add_edge(from: 2, to: 3, weight: 11)
    graph.add_edge(from: 2, to: 5, weight: 2)
    graph.add_edge(from: 3, to: 4, weight: 6)
    graph.add_edge(from: 4, to: 5, weight: 9)

    distances.poke(.construct(count: 6, manager: alloc))
    dist: @S64 = distances.to[@S64]()
    dijkstra(graph, source: 0, dist, alloc)

    c_printf("Shortest distances from node 0:\n")

    each i: U64 in 0 til 6
        d: S64 = distances[i]
        c_printf("  node %zu  dist %lld\n", i, d)
    drop graph
    drop distances
    return
