# A module-qualified type goes wherever a type goes, without an import: a binding, a local slot, a parameter, a return
# type, and a field.

import Standard/Os

### Two points side by side.
record Pair
    left: Physics/Point
    right: Physics/Point

### The heavier of two points.
### :param a: One point.
### :param b: The other point.
### :returns: The one with the larger mass.
routine heavier(a: Physics/Point, b: Physics/Point) -> Physics/Point
    if a.mass > b.mass
        return a
    return b

### Writes the masses.
routine start() -> None
    local slot: @Physics/Point <- Physics/Point.make(4)

    light: Physics/Point = Physics/Point.make(2)
    pair: Pair = Pair(left: light, right: slot.peek())
    big: Physics/Point = heavier(a: pair.left, b: pair.right)
    Console.show("slot {slot.mass.peek()}, heavier {big.mass}")
    return
