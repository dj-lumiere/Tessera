# An integer power takes its exponent in the base's own type: a negative one gives no whole number, so pow_checked
# gives None and pow crashes with NumericDomainError (exit status 82).

import Standard/Os

routine start() -> None
    base: S64 = 3
    two: S64 = 2
    down: S64 = -1
    Console.show("{base ** two} {base.pow_checked(two)} {base.pow_checked(down)} {base.pow_wrap(two)}")
    r: S64 = base ** down
    Console.show("not reached {r}")
    return
