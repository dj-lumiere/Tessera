# A bitmask becomes a flags value with to[F](): every unsigned integer converts, and a bit no member has is
# UnknownBitsError, which try and check receive.

import Hosted

### The mode bits of POSIX `access`.
flags AccessCheck: U32
    ### X_OK: the file can be run.
    RUN
    ### W_OK: the file can be written.
    WRITE
    ### R_OK: the file can be read.
    READ

### A flags type that states its width and its members' bits.
flags Small: U8
    LOW: 0
    HIGH: 7

routine start() -> None
    granted: U32 = 6
    back: AccessCheck = granted.to[AccessCheck]()
    Console.show("6 is {back}, has READ: {back.has(READ)}")
    small: U8 = 3
    Console.show("U8 3 is {small.to[AccessCheck]()}, U64 1 is {U64.to[AccessCheck](1)}")
    wide: U64 = 0x81
    Console.show("U64 0x81 is {wide.to[Small]()}, U16 0x80 is {U16.to[Small](0x80)}")
    stray: U32 = 12
    when check stray.to[AccessCheck]()
        is AccessCheck as fits => Console.show("12 fits: {fits}")
        is UnknownBitsError as e => Console.show("12: {e}")
    Console.show("try 0x100 as Small: {try U64.to[Small](0x100)}")
    Console.show("try 0x1 as Small: {try U64.to[Small](0x1)}")
    Console.show("bare 0x2 as Small, the program stops:")
    two: U64 = 2
    Console.show("{two.to[Small]()}")
    return
