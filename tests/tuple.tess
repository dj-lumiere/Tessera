// Tuples: (A, B) to (A, B, C, D) as types, (a, b) as values, and the one binding that takes a value apart,
// q, r = .... They compare, hash, and print item by item, and they go wherever a type does: returns, generic
// arguments, collections, and Callable signatures, where the first parenthesized list is still the parameters.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine div_rem(a: U64, b: U64) -> (U64, U64)
    return((a.div(b), a.mod(b)))

routine swap[TFirst, TSecond](pair: (TFirst, TSecond)) -> (TSecond, TFirst)
require TFirst: typename, TSecond: typename
    first, second = pair
    return((second, first))

routine apply(f: Callable[(S64, S64), (S64, S64)], a: S64, b: S64) -> (S64, S64)
    return(f.call(a, b))

routine sum_and_difference(a: S64, b: S64) -> (S64, S64)
    return((a.add(b), a.sub(b)))

routine start() -> Void
    q, r = div_rem(a: 17, b: 5)
    Out.write("17 = 5 * {q} + {r}\n")

    named: (Span[Byte], S64) = ("seven", 7)
    swapped: (S64, Span[Byte]) = swap[Span[Byte], S64](named)
    Out.write("{named} swapped is {swapped}\n")

    s, d = apply(f: sum_and_difference.to[Callable](), a: 10, b: 3)
    Out.write("sum {s}, difference {d}\n")

    four: (Bool, U8, Char, Span[Byte]) = (true, 255, 'x', "end")
    flag, byte, char, text = four
    Out.write("{four}: {flag} {byte} {char} {text}\n")

    a: (S64, S64) = (1, 2)
    b: (S64, S64) = (1, 3)
    Out.write("eq {a.eq(a)} {a.eq(b)}, compare {a.compare(b)} {b.compare(a)}, ")
    c: (S64, S64) = (1, 2)
    Out.write("same hash {a.hash().eq(c.hash())}\n")

    claim alloc: @MemoryManager <- make_heap_memory()
    claim scores: @Dict[(Span[Byte], S64), Bool] <- .construct(alloc)
    scores.setitem(key: ("ada", 1), value: true)
    scores.setitem(key: ("bob", 2), value: false)
    scores.setitem(key: ("ada", 1), value: false)
    Out.write("dict {scores.peek()} has (bob, 2): {scores.has_key((\"bob\", 2))}\n")
    scores.destruct()
    return()
