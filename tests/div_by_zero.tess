// Division by zero panics with TrapCode.DivByZero: exit status 101. U256 divides in software-sized steps, and
// still checks first.

import Standard::Format

routine main() -> S32
    block entry():
        big  : U256 = 0x1_0000000000000000_0000000000000000_0000000000000000
        zero : U256 = 0
        print("before\n")
        q : U256 = big.div(zero)
        print("not reached\n")
        return(0)
