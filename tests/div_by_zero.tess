// Division by zero crashes with DivisionByZeroError: exit status 82. U256 divides in software-sized steps, and
// still checks first.

import Standard/Format
import Standard/Os

routine start() -> None
    big: U256 = 0x1000000000000000000000000000000000000000000000000
    zero: U256 = 0
    Out.write("before\n")
    q: U256 = big / zero
    Out.write("not reached\n")
    return
