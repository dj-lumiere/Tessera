# A number where a choice member goes in a type is a build error.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE

### A cell with an order.
### :typeparam O: The order.
record Cell[O]
needs Order O
    v: U64

### The rank of O.
### :typeparam O: The order.
### :returns: 0 or 1.
routine rank[O]() -> U64
needs Order O
    when O
        Order.RELAXED => return 0
        Order.ACQUIRE => return 1

### Runs.
routine start() -> None
    c: Cell[0]
    return
