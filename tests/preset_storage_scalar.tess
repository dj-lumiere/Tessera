// A preset in memory needn't be an array: its name is the address of read-only data, and = binds only a value.

import Standard::Format
import Standard::Os

preset LIMIT: U64 = 10
preset BOUND: @U64 <- 20

routine start() -> Void
    block entry()
        bound : U64 = BOUND.load()
        Out.write("{LIMIT} {bound}\n")
        return()
