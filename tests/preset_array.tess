// Preset arrays are read-only static data. K[i] is a place you load from, K alone is its address, and the
// Array methods work through that address.

#[external("c"), symbol("printf"), variadic]
routine c_printf(%fmt: @Byte) -> S32

preset PRIMES: @Array<S64, 5> <- { 2, 3, 5, 7, 11 }

/// U32 elements take the whole unsigned range (as in SHA-256's round constants).
preset WORDS: @Array<U32, 3> <- { 0x428a2f98, 0xb5c0fbcf, 0xFFFFFFFF }

preset GRID: @Array<Array<S16, 3>, 2> <- { Array<S16, 3> { 1, 2, 3 }, Array<S16, 3> { 4, 5, 6 } }

preset HALVES: @Array<F64, 2> <- { 0.5, -2.25 }

preset FLAGS: @Array<Bool, 2> <- { true, false }

routine sum_primes() -> S64
    block entry():
        jump loop(0, 0)

    block loop(%i: USize, %acc: S64):
        %done : Bool = %i.ge(5)
        branch %done ? return(%acc) : add(%i, %acc)

    block add(%i: USize, %acc: S64):
        %p : S64 = PRIMES.get(%i)
        jump loop(%i.add(1), %acc.add(%p))

routine main() -> S32
    block entry():
        c_printf("%lld\n", sum_primes())

        %w1 : U32 = WORDS.get(1)
        %w2 : U32 = WORDS.get(2)
        c_printf("%08x %d\n", %w1, %w2)

        %g : S16 = GRID.to_ptr().stride(1).get(2)
        c_printf("%d\n", %g.to_s32())

        %h : F64 = HALVES.get(1)
        c_printf("%g\n", %h)

        %flag : Bool = FLAGS.get(0)
        c_printf("%d\n", %flag.to_s32())

        // the bare name is the address
        %table : @Array<S64, 5> = PRIMES
        %third : S64            = %table.get(2)
        %first : @S64           = PRIMES.to_ptr()
        %two   : S64            = %first.load()
        c_printf("%lld %lld\n", %third, %two)

        %elem : @S64 = PRIMES.to_ptr().stride(4)
        %last : S64  = %elem.load()
        c_printf("%lld\n", %last)
        return(0)
