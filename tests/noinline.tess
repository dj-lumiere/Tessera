// #noinline keeps a routine out of line at every call (LLVM noinline). The program means the same either way.

import Standard::Format
import Standard::Os

#noinline
routine square(x: S64) -> S64
    block entry()
        return(x.mul(x))

routine start() -> Void
    block entry()
        Out.write("{square(7)}\n")
        return()
