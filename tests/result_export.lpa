# Result[T, TErrorCode] is a C record of the value and then the code, both always there: what an @export routine
# returns when it can fail. A failed Result's value is .hollow(), and an ok one's code is the choice's 0 member.

import Hosted

### Why a ratio couldn't be made, as C reads it: 0 is the success code.
choice RatioError
    OK
    ZERO_DIVISOR
    TOO_LARGE

### `part` out of `whole` in percent, or the code that says why there is none.
### :param part: The part.
### :param whole: The whole.
### :returns: The percentage and the code.
@export("ratio_percent")
routine ratio_percent(part: S64, whole: S64) -> Result[S64, RatioError]
    when check (part * 100) // whole
        is S64 as percent => return .ok(percent)
        is DivisionByZeroError => return .error(RatioError.ZERO_DIVISOR)
        else => return .error(RatioError.TOO_LARGE)

### Shows one call's Result.
### :param part: The part.
### :param whole: The whole.
routine show(part: S64, whole: S64) -> None
    r: Result[S64, RatioError] = ratio_percent(part, whole)
    Console.show("{part} of {whole}: value {r.value}, code {r.code}, ok {r.is_ok()}")
    return

routine start() -> None
    show(part: 3, whole: 4)
    show(part: 1, whole: 0)
    show(part: S64.MAX, whole: 2)
    return
