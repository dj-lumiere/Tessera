// PriorityQueue<Job> against a model. Jobs order by priority, then by sequence number, so every pop is determined. An
// LCG drives random push / pop / peek and a rare clear in three phases (filling, steady, draining), with a checkpoint
// every 500 operations (length and a running checksum of every result). Then the heap is drained and must come out
// sorted.
// The expected output is generated by scripts/gen_collection_seq.py.

record Rng
    state: U64

routine Rng.below(#self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state: U64 := #self.state
        %next:  U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        #self.state = %next
        %value: U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed: S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

record Job
conform Priority<Job>
    priority: S64
    sequence: S64

// Lower priority first; equal priorities in push order.
routine Job.less(%a: Job, %b: Job) -> Bool
    block entry():
        %pa: S64 = %a.priority
        %pb: S64 = %b.priority
        %before: Bool = %pa.lt(%pb)
        %tied:   Bool = %pa.eq(%pb)
        %sa: S64 = %a.sequence
        %sb: S64 = %b.sequence
        %earlier: Bool = %sa.lt(%sb)
        %result:  Bool = %before.bitor(%tied.bitand(%earlier))
        return(%result)

// One number per job for the checksum. Sequence numbers stay below a million.
routine Job.key(%self: Job) -> S64
    block entry():
        %priority: S64 = %self.priority
        %sequence: S64 = %self.sequence
        %key: S64 = %priority.mul(1000000).add(%sequence)
        return(%key)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #heap: Ptr<PriorityQueue<Job>>, %phase: U64, %op: U64, %results: S64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op.to_s64())
        labeled(#out, "length", #heap.length().to_s64())
        labeled(#out, "results", %results)
        write_line(#out)
        return()

// Runs %ops random operations; %push is the percentage of pushes, pop takes the next 30 and peek the rest. Priorities
// are below %priorities, so small bounds make many ties. #sequence counts pushes. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #heap: Ptr<PriorityQueue<Job>>, #rng: Ptr<Rng>, #sequence: Ptr<S64>,
        %phase: U64, %ops: U64, %push: U64, %priorities: U64, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: U64, %results: S64):
        %done: Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: U64, %results: S64):
        %kind:     U64  = #rng.below(1000)
        %is_push:  Bool = %kind.lt(%push.mul(10))
        %is_pop:   Bool = %kind.lt(%push.add(30).mul(10))
        %is_clear: Bool = %kind.eq(999)
        select:
            %is_push -> push(%op, %results)
            %is_pop -> pop(%op, %results)
            %is_clear -> clear(%op, %results)
            _ -> peek(%op, %results)

    block push(%op: U64, %results: S64):
        %priority: S64 = #rng.below(%priorities).to_s64()
        %sequence: S64 := #sequence
        #sequence = %sequence.add(1)
        %job: Job = Job { priority: %priority, sequence: %sequence }
        #heap.push(%job)
        jump record(%op, %results, %job.key())

    block pop(%op: U64, %results: S64):
        %empty: Bool = #heap.is_empty()
        branch %empty ? record(%op, %results, -1) : pop_one(%op, %results)

    block pop_one(%op: U64, %results: S64):
        %job: Job = #heap.pop()
        jump record(%op, %results, %job.key())

    block peek(%op: U64, %results: S64):
        %empty: Bool = #heap.is_empty()
        branch %empty ? record(%op, %results, -2) : peek_one(%op, %results)

    block peek_one(%op: U64, %results: S64):
        %job: Job = #heap.peek()
        jump record(%op, %results, %job.key())

    block clear(%op: U64, %results: S64):
        #heap.clear()
        jump record(%op, %results, -3)

    block record(%op: U64, %results: S64, %result: S64):
        %mixed:   S64  = mix(%results, %result)
        %op_next: U64  = %op.add(1)
        %report:  Bool = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: U64, %results: S64):
        checkpoint(#out, #heap, %phase, %op, %results)
        jump next(%op, %results)

// Pops everything, printing the count, a hash of the pop order, and whether each pop was no smaller than the last.
routine drain(#out: Ptr<BufWriter<FdWriter>>, #heap: Ptr<PriorityQueue<Job>>) -> Void
    block entry():
        jump next(0, 0, -1, true)

    block next(%count: S64, %hash: S64, %last: S64, %sorted: Bool):
        %empty: Bool = #heap.is_empty()
        branch %empty ? done(%count, %hash, %sorted) : pop(%count, %hash, %last, %sorted)

    block pop(%count: S64, %hash: S64, %last: S64, %sorted: Bool):
        %job: Job = #heap.pop()
        %key: S64 = %job.key()
        %in_order: Bool = %key.gt(%last)
        jump next(%count.add(1), mix(%hash, %key), %key, %sorted.bitand(%in_order))

    block done(%count: S64, %hash: S64, %sorted: Bool):
        write_str(#out, "drained")
        labeled(#out, "count", %count)
        labeled(#out, "hash", %hash)
        write_str(#out, " sorted ")
        %sorted.format(#out)
        write_line(#out)
        return()

routine main() -> S32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap_alloc: Allocator      = make_heap_allocator()
        #alloc:      Ptr<Allocator> = alloca<Allocator>([%heap_alloc])
        %rng_val: Rng      = Rng { state: 4 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        #sequence: Ptr<S64> = alloca<S64>([0])
        %heap_val: PriorityQueue<Job> = PriorityQueue<Job>.new(#alloc)
        #heap: Ptr<PriorityQueue<Job>> = alloca<PriorityQueue<Job>>([%heap_val])

        %r1: S64 = run_phase(#out, #heap, #rng, #sequence, 1, 4000, 55, 1000000, 0)
        %r2: S64 = run_phase(#out, #heap, #rng, #sequence, 2, 4000, 40, 20, %r1)
        %r3: S64 = run_phase(#out, #heap, #rng, #sequence, 3, 3000, 25, 1000, %r2)
        %r4: S64 = run_phase(#out, #heap, #rng, #sequence, 4, 3000, 60, 5, %r3)
        drain(#out, #heap)
        #heap.free()
        write_str(#out, "freed is empty ")
        #heap.is_empty().format(#out)
        write_line(#out)
        #out.flush()
        return(0)
