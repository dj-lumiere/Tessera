// PriorityQueue[Job, S64] against a model: each Job is the priority, and its checksum key the element. Jobs order by
// priority, then by sequence number, so every pop is determined. An LCG drives random push / pop / peek and a rare
// clear in three phases (filling, steady, draining), with a checkpoint every 500 operations (length and a running
// checksum of every result). Then the heap is drained and must come out sorted.
// The expected output comes from an independent Python model of the collection.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Rng
    state: U64

/// What every phase works with besides the collection.
record Harness
    /// Where checkpoints are written.
    out: @BufWriter[Out]
    /// The generator that picks each operation.
    rng: @Rng
    /// The next job's sequence number, counting across phases.
    sequence: @S64

/// One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    /// The phase's number, as checkpoints print it.
    number: USize
    /// How many operations the phase runs.
    ops: USize
    /// The percentage of operations that push.
    push: USize
    /// How many distinct priorities a pushed job draws from.
    priorities: USize

/// Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    /// The phase's number.
    phase: USize
    /// The operations run so far in the phase.
    op: USize
    /// The checksum of every result so far.
    results: S64

record Job
conform Comparable[Job]
    priority: S64
    sequence: S64

/// Makes a `Rng` from its fields.
/// :param state: Its `state`.
/// :returns: The new value.
routine Rng.construct(state: U64) -> Me
    return(Me(state))

/// Releases nothing: a `Rng` holds no memory of its own.
routine Rng.destruct(me: @Me) -> Void
    return()

/// Makes a `Harness` from its fields.
/// :param out: Its `out`.
/// :param rng: Its `rng`.
/// :param sequence: Its `sequence`.
/// :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng, sequence: @S64) -> Me
    return(Me(out, rng, sequence))

/// Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> Void
    return()

/// Makes a `Phase` from its fields.
/// :param number: Its `number`.
/// :param ops: Its `ops`.
/// :param push: Its `push`.
/// :param priorities: Its `priorities`.
/// :returns: The new value.
routine Phase.construct(number: USize, ops: USize, push: USize, priorities: USize) -> Me
    return(Me(number, ops, push, priorities))

/// Releases nothing: a `Phase` holds no memory of its own.
routine Phase.destruct(me: @Me) -> Void
    return()

/// Makes a `Checkpoint` from its fields.
/// :param phase: Its `phase`.
/// :param op: Its `op`.
/// :param results: Its `results`.
/// :returns: The new value.
routine Checkpoint.construct(phase: USize, op: USize, results: S64) -> Me
    return(Me(phase, op, results))

/// Releases nothing: a `Checkpoint` holds no memory of its own.
routine Checkpoint.destruct(me: @Me) -> Void
    return()

/// Makes a `Job` from its fields.
/// :param priority: Its `priority`.
/// :param sequence: Its `sequence`.
/// :returns: The new value.
routine Job.construct(priority: S64, sequence: S64) -> Me
    return(Me(priority, sequence))

/// Releases nothing: a `Job` holds no memory of its own.
routine Job.destruct(me: @Me) -> Void
    return()

routine Rng.below(me: @Me, bound: USize) -> USize
    state: U64 = me.state.peek()
    next: U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
    me.state.poke(next)
    bucket: U64 = next.shr(33).mod(bound.to[U64]())
    value: USize = bucket.to[USize]()
    return(value)

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash.mul_wrap(1000003).add_wrap(value)
    return(mixed)

routine labeled[T](out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer[T]
    out.write(" {label} {value}")
    return()

// Lower priority first, equal priorities in push order.
routine Job.compare(me: Me, other: Me) -> S32
    by_priority: S32 = me.priority.compare(other.priority)
    tied: Bool = by_priority.eq(0)
    branch tied
        ? return(me.sequence.compare(other.sequence))
        : return(by_priority)

// One number per job for the checksum. Sequence numbers stay below a million.
routine Job.key(me: Me) -> S64
    priority: S64 = me.priority
    sequence: S64 = me.sequence
    key: S64 = priority.mul(1000000).add(sequence)
    return(key)

routine checkpoint(out: @BufWriter[Out], heap: @PriorityQueue[Job, S64], at: Checkpoint) -> Void
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: USize = heap.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    out.write("\n")
    return()

// Runs ops random operations: push is the percentage of pushes, pop takes the next 30 and peek the rest. Priorities
// are below priorities, so small bounds make many ties. sequence counts pushes. Returns the updated results checksum.
routine run_phase(harness: Harness, heap: @PriorityQueue[Job, S64], phase: Phase,
    results: S64) -> S64
    local rng: @Rng = harness.rng
    local sequence: @S64 = harness.sequence
    local ops: USize = phase.ops
    local push: USize = phase.push
    local priorities: USize = phase.priorities

    jump next(0, results)

    block next(op: USize, checksum: S64)
        done: Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        kind: USize = rng.below(1000)
        is_push: Bool = kind.lt(push.mul(10))
        is_pop: Bool = kind.lt(push.add(30).mul(10))
        is_clear: Bool = kind.eq(999)
        when
            is_push => push(op, checksum)
            is_pop => pop(op, checksum)
            is_clear => clear(op, checksum)
            else => peek(op, checksum)

    block push(op: USize, checksum: S64)
        priority: S64 = rng.below(priorities).to[S64]()
        sequence_val: S64 = sequence.peek()
        sequence.poke(sequence_val.add(1))
        job: Job = Job(priority: priority, sequence: sequence_val)
        key: S64 = job.key()
        heap.add(priority: job, element: key)
        jump record(op, checksum, key)

    block pop(op: USize, checksum: S64)
        empty: Bool = heap.is_empty()
        branch empty
            ? record(op, checksum, -1)
            : pop_one(op, checksum)

    block pop_one(op: USize, checksum: S64)
        key: S64 = heap.remove()
        jump record(op, checksum, key)

    block peek(op: USize, checksum: S64)
        empty: Bool = heap.is_empty()
        branch empty
            ? record(op, checksum, -2)
            : peek_one(op, checksum)

    block peek_one(op: USize, checksum: S64)
        key: S64 = heap.first()
        jump record(op, checksum, key)

    block clear(op: USize, checksum: S64)
        heap.clear()
        jump record(op, checksum, -3)

    block record(op: USize, checksum: S64, result: S64)
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: USize = op.add(1)
        report: Bool = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out: harness.out, heap,
            at: Checkpoint(phase: phase.number, op: op, results: checksum))
        jump next(op, checksum)

// Pops everything, printing the count, a hash of the pop order, and whether each pop was no smaller than the last.
routine drain(out: @BufWriter[Out], heap: @PriorityQueue[Job, S64]) -> Void
    local count: @S64 <- 0
    local hash: @S64 <- 0
    local last: @S64 <- -1
    local sorted: @Bool <- true

    jump next()

    block next()
        empty: Bool = heap.is_empty()
        branch empty
            ? done()
            : pop()

    block pop()
        key: S64 = heap.remove()
        in_order: Bool = key.gt(last.peek())
        next_sorted: Bool = sorted.peek().bitand(in_order)
        next_last: S64 = key
        next_hash: S64 = mix(hash: hash.peek(), value: key)
        next_count: S64 = count.peek().add(1)
        next_count.poke_into(count)
        next_hash.poke_into(hash)
        next_last.poke_into(last)
        next_sorted.poke_into(sorted)
        jump next()

    block done()
        out.write("drained")
        labeled(out, label: "count", value: count.peek())
        labeled(out, label: "hash", value: hash.peek())
        out.write(" sorted {sorted.peek()}\n")
        return()

routine start() -> Void
    fd: @Out = Out.writer()
    claim out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    claim alloc: @MemoryManager <- make_heap_memory()
    claim rng: @Rng <- Rng(state: 4)
    claim sequence: @S64 <- 0
    claim heap: @PriorityQueue[Job, S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng, sequence: sequence)
    r1: S64 = run_phase(harness, heap,
        phase: Phase(number: 1, ops: 4000, push: 55, priorities: 1000000), results: 0)
    r2: S64 = run_phase(harness, heap, phase: Phase(number: 2, ops: 4000, push: 40, priorities: 20),
        results: r1)
    r3: S64 = run_phase(harness, heap,
        phase: Phase(number: 3, ops: 3000, push: 25, priorities: 1000), results: r2)
    r4: S64 = run_phase(harness, heap, phase: Phase(number: 4, ops: 3000, push: 60, priorities: 5),
        results: r3)
    drain(out, heap)
    heap.destruct()
    out.write("freed is empty {heap.is_empty()}\n")
    out.flush()
    return()
