/// A generic overload and a concrete one: an exact concrete match wins, and the generic one takes every other type.
/// A routine's constraints are part of whether it fits.
import Standard/Format
import Standard/Os

routine kind[T](value: T) -> Span[Byte]
needs T: typename
    return "generic"

routine kind(value: S64) -> Span[Byte]
    return "S64"

routine order[T](a: T, b: T) -> Span[Byte]
needs T: typename, Comparable[T]
    return "comparable"

routine order(a: Bool, b: Bool) -> Span[Byte]
    return "two Bools"

routine start() -> Void
    n: S64 = 1
    w: U32 = 2
    t: Span[Byte] = "x"
    Out.write("{kind(n)} {kind(w)} {kind(t)}\n")
    Out.write("{order(a: w, b: w)} {order(a: true, b: false)}\n")
    Out.write("{kind[S64](n)}\n")
    return
