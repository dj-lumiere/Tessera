# A bare call of a failable routine that fails stops the program on the call's line: the Crash service reports the
# crashable the throw put in the flow's mold, its name and its message with the values it was thrown with, and the
# exit status is 82. A failure received with check before it doesn't change what is reported.

import Standard/Hosted

crashable TooLargeError
    value: S64
    limit: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine TooLargeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("{me.value} is past {me.limit}")
    return

### n, failing past the limit.
### :param n: The number.
### :param limit: The largest it may be.
### :returns: n.
failable routine at_most(n: S64, limit: S64) -> S64
    if n > limit
        throw TooLargeError(value: n, limit)
    return n

routine start() -> None
    when check at_most(n: 7, limit: 5)
        is S64 as v => Console.show("first: {v}")
        is TooLargeError as e => Console.show("first: {e.value} past {e.limit}")
    Console.show("second: {at_most(n: 3, limit: 5)}")
    third: S64 = at_most(n: 12, limit: 10)
    Console.show("not reached: {third}")
    return
