# A failable middle under try or check: the word takes the whole chain, and a failure in the middle ends it before
# the comparison after it.

import Hosted

crashable OddError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine OddError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("{me.value} is odd")
    return

### Half of an even n.
### :param n: The number.
### :returns: Its half.
failable routine half(n: S64) -> S64
    Console.show("half {n}")
    if n % 2 != 0
        throw OddError(value: n)
    return n // 2

### Shows a name and a value, and gives the value back.
### :param name: What is shown first.
### :param value: The value shown and given back.
### :returns: value.
routine seen(name: @[Byte], value: S64) -> S64
    Console.show("{name} {value}")
    return value

routine start() -> None
    when try 0 < half(n: 8) < seen("end", 10)
        is Bool as inside => Console.show("eight: {inside}")
        is None => Console.show("eight: none")
    when try 0 < half(n: 7) < seen("end", 10)
        is Bool as inside => Console.show("seven: {inside}")
        is None => Console.show("seven: none")
    when check 0 < half(n: 5) < 3
        is Bool as inside => Console.show("five: {inside}")
        is OddError as e => Console.show("five: odd {e.value}")
    return
