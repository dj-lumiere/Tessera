/// Each overload is its own C routine, so an exported overload names its C symbol, and an overloaded C routine
/// declared here names the C function it is: here the program's own two exports, reached again through C names.
import Standard::Format
import Standard::Os

#export("doubled_s64")
routine doubled(n: S64) -> S64
    block entry()
        return(n.mul(2))

#export("doubled_f64")
routine doubled(x: F64) -> F64
    block entry()
        return(x.mul(2.0))

#[external("c"), symbol("doubled_s64")]
routine c_doubled(n: S64) -> S64

#[external("c"), symbol("doubled_f64")]
routine c_doubled(x: F64) -> F64

routine main() -> S32
    block entry()
        n : S64 = 21
        x : F64 = 1.25
        Out.write("{doubled(n)} {doubled(x)} {c_doubled(n)} {c_doubled(x)}\n")
        return(0)
