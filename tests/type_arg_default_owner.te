# A routine on a type can't give the type's parameter a default: the type's own needs line does.
import Hosted

### A box.
### :typeparam L: The value.
record Box[L]
needs L: U64
    v: U64

### L.
### :returns: L.
routine Box[L].get() -> U64
needs L: U64 = 2
    return L

### Runs.
routine start() -> None
    return
