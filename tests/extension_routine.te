### Routines can be added to a type from another file: U64 and @[Byte] are declared in the stdlib.
import Standard/Format
import Standard/Os

routine U64.double(me: Me) -> Me
    r: Me = me * 2
    return r

routine @[Byte].shout(me: Me) -> None
    Console.show("{me}!")
    return

routine start() -> None
    x: U64 = 21
    Console.show("{x.double()}")
    s: @[Byte] = "hello"
    s.shout()
    return
