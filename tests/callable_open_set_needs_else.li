# A check of a call through a Callable kept in a field needs an else arm: the value there may throw any failure.

import Hosted

crashable BadWorkError
    code: S64

### A handler kept in a field.
record Handler
    action: Callable[(S64,), S64]

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadWorkError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad work {me.code}")
    return

### Twice n, failing for a negative n.
### :param n: The number.
### :returns: Twice n.
routine twice(n: S64) -> S64
    if n < 0
        throw BadWorkError(code: n)
    return n * 2

### Runs the example.
routine start() -> None
    h: Handler = Handler(action: twice.to[Callable]())
    when check h.action.call(4)
        is S64 as v => Console.show("got {v}")
        is BadWorkError as e => Console.show("bad work {e.code}")
    return
