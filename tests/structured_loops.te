# each over a range, while and until with carried values, continue with, break, then (on the loop's own end and after
# a break).

import Standard/Format
import Standard/Os

### The Collatz steps from `start`: the carried values are the number and the count.
routine collatz_steps(start: U64) -> U64
    while n > 1 with n: U64 = start, steps: U64 = 0
        after: U64 = when
            n % 2 == 0 => n // 2
            else => 3 * n + 1
        continue with n: after, steps: steps + 1
    then
        return steps

### The sum of the squares below `limit`, through each.
routine sum_squares(limit: U64) -> U64
    local total: @U64 <- 0

    each i in 0 til limit
        (total.peek() + i * i).poke_into(total)
    return total.peek()

### The first index at or past `from` whose value is zero, or the count.
routine first_zero(data: @[S64], from: U64) -> U64
    local found: @U64 <- data.count

    each i in from til data.count
        if data[i] == 0
            found.poke(i)
            break
    return found.peek()

### Counts down from `n` to 1 inclusively, and says how many rounds ran.
routine count_down(n: S64) -> S64
    local rounds: @S64 <- 0

    each i in n to 1 by -1
        rounds.poke(rounds.peek() + 1)
    return rounds.peek()

### Doubles until past `limit`: the carried value alone, and then sees its last value.
routine past(limit: U64) -> U64
    while x <= limit with x: U64 = 1
        continue with x: x * 2
    then
        return x

### The first number whose square is over `limit`: `then` runs after the `break` and sees the carried value, and a
### `then` that returns ends the routine.
routine first_square_over(limit: U64) -> U64
    while x < 100 with x: U64 = 1
        if x * x > limit
            break
        continue with x: x + 1
    then
        return x

routine start() -> None
    out: @ConsoleOutput = Console.output()
    out.write("steps(27) = {collatz_steps(27)}\n")
    out.write("sum_squares(10) = {sum_squares(10)}\n")
    local data: @[S64] <- [3, 1, 0, 4, 0]
    out.write("first_zero = {first_zero(data, from: 0)} {first_zero(data, from: 3)} {first_zero(data, from: 5)}\n")
    out.write("count_down(5) = {count_down(5)}\n")
    out.write("past(100) = {past(100)}\n")
    out.write("first_square_over(50) = {first_square_over(50)} {first_square_over(20000)}\n")
    local nested: @U64 <- 0
    each i: U64 in 0 til 3
        each j: U64 in 0 til 4
            if j == 2
                break
            (nested.peek() + 1).poke_into(nested)
        then
            (nested.peek() + 10).poke_into(nested)
    out.write("nested = {nested.peek()}\n")
    return
