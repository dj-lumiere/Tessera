# Two fibers of one thread take exclusive access to two values in opposite orders. A fiber that waits parks, so the
# other runs and closes the cycle: the deadlock check stops the program with DeadlockError instead of parking both
# forever.

import Standard/Fiber
import Standard/Os

record Pair
    first: U64
    second: U64

routine forward(pair: @Pair) -> None
    first: Authorized[U64] <- pair.first.get_exclusive_access()
    FIBERS.waitfor(10ms)
    second: Authorized[U64] <- pair.second.get_exclusive_access()
    drop second
    drop first
    return

routine backward(pair: @Pair) -> None
    second: Authorized[U64] <- pair.second.get_exclusive_access()
    FIBERS.waitfor(10ms)
    first: Authorized[U64] <- pair.first.get_exclusive_access()
    drop first
    drop second
    return

routine start() -> None
    pair: &Pair <- Pair(first: 0, second: 0)

    Console.show("starting")
    f: Fiber[None] <- FIBERS.get_fiber[None]()
    g: Fiber[None] <- FIBERS.get_fiber[None]()
    work_f: Work[None] <- forward.to[Work](pair: pair)
    f.put_work(work_f)
    drop work_f
    work_g: Work[None] <- backward.to[Work](pair: pair)
    g.put_work(work_g)
    drop work_g
    f.wait_finished()
    g.wait_finished()
    drop f
    drop g
    drop FIBERS
    Console.show("not reached")
    return
