# Decimal from Ingrid/Decimal: `+ - *` exact or NumericOverflowError past 34 digits, `/` rounded to 34 digits, every
# rounding half up (x goes to the n with n - 0.5 <= x < n + 0.5), text without the zeros after the point that don't
# change the value, and only finite values.

import Ingrid/Decimal
import Standard/Os

### Shows a Decimal read from text, with a label.
### :param label: What the line says first.
### :param text: The text read.
routine show(label: @[Byte], text: @[Byte]) -> None
    d: Decimal = text.to[Decimal]()
    Console.show("{label} is {d}")
    return

### Shows what reading `text` as a Decimal gives.
### :param text: The text read.
routine show_try(text: @[Byte]) -> None
    when check text.to[Decimal]()
        is Decimal as d => Console.show("{text}: {d}")
        is Crashables as e => Console.show("{text}: {e.name()}")
    return

### Shows the exact arithmetic and where it fails.
routine exact() -> None
    price: Decimal = "19.99".to[Decimal]()
    count: Decimal = S64.to[Decimal](3)
    cent: Decimal = "0.01".to[Decimal]()
    Console.show("19.99 * 3 = {price * count}, + 0.01 = {price * count + cent}")
    show("2.50", "2.50")
    show("10.000", "10.000")
    show("100", "100")
    show("1.5e3", "1.5e3")
    show("0.0000001", "0.0000001")
    show("-0", "-0")
    a: Decimal = "0.1".to[Decimal]()
    b: Decimal = "0.2".to[Decimal]()
    c: Decimal = "0.3".to[Decimal]()
    Console.show("0.1 + 0.2 == 0.3: {a + b == c}")
    wide: Decimal = "9999999999999999999999999999999999".to[Decimal]()
    one: Decimal = S64.to[Decimal](1)
    Console.show("34 nines + 1: {try wide + one}, 34 nines - 1: {try wide - one}")
    three: Decimal = S64.to[Decimal](3)
    third: Decimal = one / three
    two: Decimal = S64.to[Decimal](2)
    Console.show("1 / 3 = {third}, times 3 exactly: {try third * three}, 2 / 3 = {two / three}")
    small: Decimal = "1e-20".to[Decimal]()
    smaller: Decimal = "1e-40".to[Decimal]()
    Console.show("1e-20 + 1: {try small + one}, 1e-40 + 1: {try smaller + one}")
    when check wide * wide
        is Decimal as product => Console.show("product {product}")
        is NumericOverflowError as e => Console.show("the product has more than 34 digits: {e.name()}")
    return

### Shows the rest of the routines.
routine others() -> None
    x: Decimal = "-2.5".to[Decimal]()
    one: Decimal = S64.to[Decimal](1)
    Console.show("rounding: {x.trunc()} {x.floor()} {x.ceil()} {x.round()} {x.round_ties_even()}")
    Console.show("compare: {x < one}, {x.compare(x)}, {x.min(one)}, {x.max(one)}, {x.abs()}, {-x}")
    price: Decimal = "2.675".to[Decimal]()
    half: Decimal = "1.50".to[Decimal]()
    Console.show("fixed: {Fixed[Decimal](value: price, digits: 2)}, diagnose: {half.diagnose()}")
    y: Decimal = "-7.9".to[Decimal]()
    z: Decimal = S64.to[Decimal](300)
    Console.show("to integers: {y.to[S64]()}, try 300 as U8: {try z.to[U8]()}")
    big: U64 = 18446744073709551615
    zero: Decimal = Decimal.zero()
    Console.show("from integers: {big.to[Decimal]()}, zero: {zero}, is_zero: {zero.is_zero()}")
    as_d128: D128 = half.to[D128]()
    Console.show("as D128: {as_d128}, back: {as_d128.to[Decimal]()}")
    show_try("inf")
    show_try("nan")
    show_try("1e7000")
    show_try("x")
    show_try("")
    return

### Shows that every rounding takes a tie up, toward +infinity (2.5 to 3, -2.5 to -2).
routine ties() -> None
    odd: Decimal = "2000000000000000000000000000000001".to[Decimal]()
    two: Decimal = S64.to[Decimal](2)
    Console.show("2000000000000000000000000000000001 / 2 = {odd / two}, negated: {-odd / two}")
    show("1.0000000000000000000000000000000005", "1.0000000000000000000000000000000005")
    show("-1.0000000000000000000000000000000005", "-1.0000000000000000000000000000000005")
    wide: U128 = 12345678901234567890123456789012345
    Console.show("12345678901234567890123456789012345 is {wide.to[Decimal]()}")
    a: Decimal = "2.665".to[Decimal]()
    b: Decimal = "-2.5".to[Decimal]()
    c: Decimal = "2.5".to[Decimal]()
    Console.show("fixed: {Fixed[Decimal](value: a, digits: 2)}, {Fixed[Decimal](value: b, digits: 0)}, {Fixed[Decimal](value: c, digits: 0)}")
    Console.show("round: {b.round()} {c.round()}, round_ties_even: {b.round_ties_even()} {c.round_ties_even()}")
    e: Decimal = "-0.5".to[Decimal]()
    f: Decimal = "-7.125".to[Decimal]()
    g: Decimal = "7.125".to[Decimal]()
    Console.show("-0.5 round: {e.round()}, -7.125 fixed: {Fixed[Decimal](value: f, digits: 2)}, 7.125 fixed: {Fixed[Decimal](value: g, digits: 2)}")
    d: D64 = "2.665".to[D64]()
    Console.show("D64 keeps ties to even: {Fixed[D64](value: d, digits: 2)}")
    return

routine start() -> None
    exact()
    others()
    ties()
    zero: Decimal = Decimal.zero()
    one: Decimal = S64.to[Decimal](1)
    Console.show("1 / 0, the program stops:")
    Console.show("{one / zero}")
    return
