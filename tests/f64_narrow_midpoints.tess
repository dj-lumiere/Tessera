// F64.to_f16 and F64.to_bf16 round to nearest, ties to even, at every midpoint between neighbouring finite values
// of the narrow type, both signs: the midpoint itself (a tie), the F64 values next to it, and values 2^-20 of the
// gap away. They narrow through F32 with round-to-odd, which must truncate before setting the low bit.

import Standard::Format
import Standard::Os

/// The narrow value a correct rounding gives at %d near the midpoint of %lo and %hi (bits, %lo even or odd).
routine expected(%d: F64, %mid: F64, %lo: U16, %hi: U16) -> U16
    block entry():
        %below  : Bool = %d.lt(%mid)
        %above  : Bool = %d.gt(%mid)
        %lo_odd : Bool = %lo.bitand(1).eq(1)
        when:
            %below  -> return(%lo)
            %above  -> return(%hi)
            %lo_odd -> return(%hi)
            else    -> return(%lo)

/// The %k-th probe near %mid: the midpoint, its F64 neighbours, and 2^-20 of the gap either side.
routine probe_at(%mid: F64, %gap: F64, %k: USize) -> F64
    block entry():
        %bits : U64 = %mid.bits()
        %off  : F64 = %gap.mul(0x1p-20)
        when:
            %k.eq(0) -> return(%mid)
            %k.eq(1) -> return(F64.from_bits(%bits.sub(1)))
            %k.eq(2) -> return(F64.from_bits(%bits.add(1)))
            %k.eq(3) -> return(%mid.sub(%off))
            else     -> return(%mid.add(%off))

/// Failures of F64.to_f16 over all positive finite F16 pairs, both signs.
routine check_f16() -> U64
    block entry():
        jump pair(0, 0)

    block pair(%lo: U16, %fails: U64):
        %done : Bool = %lo.eq(0x7BFF)  // F16.MAX has no finite neighbour above
        branch %done ? return(%fails) : probe(%lo, %fails)

    block probe(%lo: U16, %fails: U64):
        %hi  : U16 = %lo.add(1)
        %a   : F64 = F16.from_bits(%lo).to_f64()
        %b   : F64 = F16.from_bits(%hi).to_f64()
        %mid : F64 = %a.add(%b).mul(0.5)
        jump one(%lo, %hi, %mid, %b.sub(%a), 0, %fails)

    block one(%lo: U16, %hi: U16, %mid: F64, %gap: F64, %k: USize, %fails: U64):
        %done : Bool = %k.eq(5)
        branch %done ? pair(%hi, %fails) : test(%lo, %hi, %mid, %gap, %k, %fails)

    block test(%lo: U16, %hi: U16, %mid: F64, %gap: F64, %k: USize, %fails: U64):
        %d        : F64  = probe_at(%mid, %gap, %k)
        %want     : U16  = expected(%d, %mid, %lo, %hi)
        %got      : U16  = %d.to_f16().bits()
        %got_neg  : U16  = %d.neg().to_f16().bits()
        %ok       : Bool = %got.eq(%want).bitand(%got_neg.eq(%want.bitor(0x8000)))
        %fails_to : U64  = %ok ? %fails : %fails.add(1)
        jump one(%lo, %hi, %mid, %gap, %k.add(1), %fails_to)

/// Failures of F64.to_bf16 over all positive finite BF16 pairs, both signs.
routine check_bf16() -> U64
    block entry():
        jump pair(0, 0)

    block pair(%lo: U16, %fails: U64):
        %done : Bool = %lo.eq(0x7F7F)  // BF16.MAX has no finite neighbour above
        branch %done ? return(%fails) : probe(%lo, %fails)

    block probe(%lo: U16, %fails: U64):
        %hi  : U16 = %lo.add(1)
        %a   : F64 = BF16.from_bits(%lo).to_f64()
        %b   : F64 = BF16.from_bits(%hi).to_f64()
        %mid : F64 = %a.add(%b).mul(0.5)
        jump one(%lo, %hi, %mid, %b.sub(%a), 0, %fails)

    block one(%lo: U16, %hi: U16, %mid: F64, %gap: F64, %k: USize, %fails: U64):
        %done : Bool = %k.eq(5)
        branch %done ? pair(%hi, %fails) : test(%lo, %hi, %mid, %gap, %k, %fails)

    block test(%lo: U16, %hi: U16, %mid: F64, %gap: F64, %k: USize, %fails: U64):
        %d        : F64  = probe_at(%mid, %gap, %k)
        %want     : U16  = expected(%d, %mid, %lo, %hi)
        %got      : U16  = %d.to_bf16().bits()
        %got_neg  : U16  = %d.neg().to_bf16().bits()
        %ok       : Bool = %got.eq(%want).bitand(%got_neg.eq(%want.bitor(0x8000)))
        %fails_to : U64  = %ok ? %fails : %fails.add(1)
        jump one(%lo, %hi, %mid, %gap, %k.add(1), %fails_to)

routine main() -> S32
    block entry():
        print("F16 failures: {check_f16()}\n")
        print("BF16 failures: {check_bf16()}\n")
        return(0)
