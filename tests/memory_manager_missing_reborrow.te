# A type used as a memory manager has every routine MemoryManageable asks for: this one has no reborrow.

import Standard/Hosted

entity Half
    calls: U64

obeys MemoryManageable[Half]

common routine Half.construct() -> Me
    return Me(calls: 0)

routine @Half.destruct() -> None
    return

routine @Half.borrow(size: U64, align: U64) -> Addr
    return HEAP.borrow(size, align)

routine @Half.give_back(at: Addr) -> None
    HEAP.give_back(at)
    return

routine start() -> None
    half: &Half <- .construct()
    table: &MemoryManager <- half.to[MemoryManager]()

    taken: Addr = table.borrow(size: 8, align: 8)
    table.give_back(taken)
    drop half
    return
