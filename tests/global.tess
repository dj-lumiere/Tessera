// Globals: mutable static storage. The name is a @T. With no value the storage starts all-zero.

import Standard/Format
import Standard/Os

global TICKS: @U32 <- 5
global HISTORY: @Array[S64, 4]
global STATS: @Stats
private global SEEN: @Bool

record Stats
    calls: U32
    total: S64

routine tick() -> Void
    next_ticks: U32 = TICKS.peek().add(1)
    next_ticks.poke_into(TICKS)
    return()

routine record_value(stats: @Stats, value: S64) -> Void
    next_calls: U32 = stats.calls.peek().add(1)
    next_calls.poke_into(stats.calls)
    next_total: S64 = stats.total.peek().add(value)
    next_total.poke_into(stats.total)
    return()

routine start() -> Void
    tick()
    tick()
    HISTORY.setitem(index: 1, value: 42)
    HISTORY.setitem(index: 3, value: -7)
    record_value(stats: STATS, value: 10)
    record_value(stats: STATS, value: 32)
    SEEN.poke(true)
    Out.write("{TICKS.peek()} {HISTORY.peek()} {STATS.calls.peek()} {STATS.total.peek()} {SEEN.peek()}\n")
    return()
