// Globals: mutable static storage. The name is a @T; with no value the storage starts all-zero.

import Standard::Format

global TICKS: @U32 <- 5
global HISTORY: @Array<S64, 4>
global STATS: @Stats
private global SEEN: @Bool

record Stats
    calls : U32
    total : S64

routine tick() -> Void
    block entry():
        TICKS.load().add(1).store_into(TICKS)
        return()

routine record_value(%stats: @Stats, %value: S64) -> Void
    block entry():
        %stats.calls.load().add(1).store_into(%stats.calls)
        %stats.total.load().add(%value).store_into(%stats.total)
        return()

routine main() -> S32
    block entry():
        tick()
        tick()
        HISTORY.set(1, 42)
        HISTORY.set(3, -7)
        record_value(STATS, 10)
        record_value(STATS, 32)
        SEEN.store(true)
        print("{TICKS.load()} {HISTORY.load()} {STATS.calls.load()} {STATS.total.load()} {SEEN.load()}\n")
        return(0)
