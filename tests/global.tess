// Globals: mutable static storage. The name is a @T. With no value the storage starts all-zero.

import Standard::Format
import Standard::Os

global TICKS: @U32 <- 5
global HISTORY: @Array<S64, 4>
global STATS: @Stats
private global SEEN: @Bool

record Stats
    calls : U32
    total : S64

routine tick() -> Void
    block entry()
        next_ticks : U32 = TICKS.load().add(1)
        next_ticks.store_into(TICKS)
        return()

routine record_value(stats: @Stats, value: S64) -> Void
    block entry()
        next_calls : U32 = stats.calls.load().add(1)
        next_calls.store_into(stats.calls)
        next_total : S64 = stats.total.load().add(value)
        next_total.store_into(stats.total)
        return()

routine start() -> Void
    block entry()
        tick()
        tick()
        HISTORY.setitem(1, 42)
        HISTORY.setitem(3, -7)
        record_value(STATS, 10)
        record_value(STATS, 32)
        SEEN.store(true)
        Out.write("{TICKS.load()} {HISTORY.load()} {STATS.calls.load()} {STATS.total.load()} {SEEN.load()}\n")
        return()
