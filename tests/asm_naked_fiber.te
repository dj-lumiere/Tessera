# A fiber on a second stack, switched to and back by a #naked routine: swap saves the registers the calling
# convention keeps across a call on the current stack, stores the stack pointer, loads the other one, restores the
# registers saved there and returns into that stack. A new stack starts with a frame whose return address is the
# fiber's first routine.

import Standard/Format
import Standard/Os

global MAIN_SP: @Addr
global FIBER_SP: @Addr

### System V x86-64: from arrives in RDI, to in RSI. RBX, RBP and R12 to R15 are the caller's.
@target(arch: "x86_64", os: not "windows")
@external("asm")
@naked
routine swap(from: @Addr = R7, to: Addr = R6) -> None
    block entry()
        push[U64](R5)
        push[U64](R3)
        push[U64](R12)
        push[U64](R13)
        push[U64](R14)
        push[U64](R15)
        mov[U64, U64](from.offset(0), SP)
        mov[U64, U64](SP, to)
        pop[U64](R15)
        pop[U64](R14)
        pop[U64](R13)
        pop[U64](R12)
        pop[U64](R3)
        pop[U64](R5)
        return

### Windows x64: from arrives in RCX, to in RDX. RBX, RBP, RDI, RSI, R12 to R15 and XMM6 to XMM15 are the
### caller's, and the thread block's stack base and limit (GS:[8], GS:[16]) follow the stack.
@target(arch: "x86_64", os: "windows")
@external("asm")
@naked
routine swap(from: @Addr = R1, to: Addr = R2) -> None
    block entry()
        push[U64](R5)
        push[U64](R3)
        push[U64](R7)
        push[U64](R6)
        push[U64](R12)
        push[U64](R13)
        push[U64](R14)
        push[U64](R15)
        mov[U64, U64](R0, GS.offset(8))
        push[U64](R0)
        mov[U64, U64](R0, GS.offset(16))
        push[U64](R0)
        sub[U64](SP, 160)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(0), V6)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(16), V7)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(32), V8)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(48), V9)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(64), V10)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(80), V11)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(96), V12)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(112), V13)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(128), V14)
        movdqu[Vector[U8, 16], Vector[U8, 16]](SP.offset(144), V15)
        mov[U64, U64](from.offset(0), SP)
        mov[U64, U64](SP, to)
        movdqu[Vector[U8, 16], Vector[U8, 16]](V6, SP.offset(0))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V7, SP.offset(16))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V8, SP.offset(32))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V9, SP.offset(48))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V10, SP.offset(64))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V11, SP.offset(80))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V12, SP.offset(96))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V13, SP.offset(112))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V14, SP.offset(128))
        movdqu[Vector[U8, 16], Vector[U8, 16]](V15, SP.offset(144))
        add[U64](a: SP, b: 160)
        pop[U64](R0)
        mov[U64, U64](GS.offset(16), R0)
        pop[U64](R0)
        mov[U64, U64](GS.offset(8), R0)
        pop[U64](R15)
        pop[U64](R14)
        pop[U64](R13)
        pop[U64](R12)
        pop[U64](R6)
        pop[U64](R7)
        pop[U64](R3)
        pop[U64](R5)
        return

### AArch64: from arrives in X0, to in X1. X19 to X28, the frame pointer, the link register (the return address)
### and D8 to D15 are the caller's.
@target(arch: "aarch64")
@external("asm")
@naked
routine swap(from: @Addr = R0, to: Addr = R1) -> None
    block entry()
        stp[B64, B64, U64](V8, V9, SP.offset(-16).update())
        stp[B64, B64, U64](V10, V11, SP.offset(-16).update())
        stp[B64, B64, U64](V12, V13, SP.offset(-16).update())
        stp[B64, B64, U64](V14, V15, SP.offset(-16).update())
        stp[U64, U64, U64](R19, R20, SP.offset(-16).update())
        stp[U64, U64, U64](R21, R22, SP.offset(-16).update())
        stp[U64, U64, U64](R23, R24, SP.offset(-16).update())
        stp[U64, U64, U64](R25, R26, SP.offset(-16).update())
        stp[U64, U64, U64](R27, R28, SP.offset(-16).update())
        stp[U64, U64, U64](FP, LR, SP.offset(-16).update())
        mov[U64, U64](R9, SP)
        str[U64, U64](R9, from.offset(0))
        mov[U64, U64](SP, to)
        ldp[U64, U64, U64](FP, LR, SP.after_offset(16))
        ldp[U64, U64, U64](R27, R28, SP.after_offset(16))
        ldp[U64, U64, U64](R25, R26, SP.after_offset(16))
        ldp[U64, U64, U64](R23, R24, SP.after_offset(16))
        ldp[U64, U64, U64](R21, R22, SP.after_offset(16))
        ldp[U64, U64, U64](R19, R20, SP.after_offset(16))
        ldp[B64, B64, U64](V14, V15, SP.after_offset(16))
        ldp[B64, B64, U64](V12, V13, SP.after_offset(16))
        ldp[B64, B64, U64](V10, V11, SP.after_offset(16))
        ldp[B64, B64, U64](V8, V9, SP.after_offset(16))
        return

### The words a new stack starts with, below its 16-byte aligned top, as swap restores them: the saved registers
### (zero), the fiber's first routine where swap returns, and on x86 the room above a return address that a
### routine's entry expects (its own return address slot, and Windows' 32-byte home area).
@target(arch: "x86_64", os: not "windows")
routine frame_words() -> U64
    return 8

@target(arch: "x86_64", os: "windows")
routine frame_words() -> U64
    return 36

@target(arch: "aarch64")
routine frame_words() -> U64
    return 20

### The word of the frame swap returns through.
@target(arch: "x86_64", os: not "windows")
routine entry_word() -> U64
    return 6

@target(arch: "x86_64", os: "windows")
routine entry_word() -> U64
    return 30

@target(arch: "aarch64")
routine entry_word() -> U64
    return 1

### A new stack in `words` U64s at `stack`: its stack pointer, at a frame that returns into `entry`.
routine fiber_stack(stack: @U64, words: U64, entry: Addr) -> Addr
    local end: U64 = ptrtoint[@U64, U64](stack.stride(words))
    local top: U64 = end & 0xFFFFFFFFFFFFFFF0
    local frame: U64 = frame_words()
    local sp: @U64 = inttoptr[U64, @U64](top - (frame * 8).to[U64]())

    each i in 0 til frame
        sp.stride(i).poke(0)
    sp.stride(entry_word()).poke(ptrtoint[Addr, U64](entry))
    base: U64 = ptrtoint[@U64, U64](stack.stride(words)) & 0xFFFFFFFFFFFFFFF0
    store_bounds(sp, limit: ptrtoint[@U64, U64](stack), base)
    sp_addr: Addr = inttoptr[U64, Addr](ptrtoint[@U64, U64](sp))
    return sp_addr

### Windows checks a stack against the thread block's base and limit, which swap restores from the 21st and 22nd
### words of the frame. Elsewhere nothing follows the stack.
@target(arch: "x86_64", os: "windows")
routine store_bounds(sp: @U64, limit: U64, base: U64) -> None
    limit.poke_into(sp.stride(20))
    base.poke_into(sp.stride(21))
    return

@target(arch: not "x86_64", os: not "windows")
routine store_bounds(sp: @U64, limit: U64, base: U64) -> None
    return

@target(arch: "x86_64", os: not "windows")
routine store_bounds(sp: @U64, limit: U64, base: U64) -> None
    return

@noreturn
routine fiber_main() -> None
    Out.write("fiber: step 1\n")
    swap(from: FIBER_SP, to: MAIN_SP.peek())
    Out.write("fiber: step 2\n")
    swap(from: FIBER_SP, to: MAIN_SP.peek())
    unreachable

routine start() -> None
    local stack: @Array[U64, 8192] <- .hollow()

    sp: Addr = fiber_stack(stack: stack.to[@U64](), words: 8192,
        entry: fiber_main.to[Callable]().addr())
    sp.poke_into(FIBER_SP)
    Out.write("main: start\n")
    swap(from: MAIN_SP, to: FIBER_SP.peek())
    Out.write("main: back once\n")
    swap(from: MAIN_SP, to: FIBER_SP.peek())
    Out.write("main: back twice\n")
    return
