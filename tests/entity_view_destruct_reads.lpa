# An entity whose destruct, written by the program, reads its view: giving it back after the view's memory is given
# back is a build error.

import Hosted

### Holds a view and shows it when it ends.
entity Holder
    data: @[Byte]

### Makes a holder.
### :param data: The view to keep.
### :returns: The holder.
common routine Holder.construct(data: @[Byte]) -> Me
    return Me(data)

### Shows how many bytes it viewed.
routine @Holder.destruct() -> None
    Console.show("{me.data.peek().count}")
    return

### Gives the view's memory back before the holder.
routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP
    h: &Holder <- Holder.construct(data: m.getslice()) from HEAP
    drop m
    drop h
    return
