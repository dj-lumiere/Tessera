# `loop` is the loop that doesn't end by itself: it is left with break (its then block runs) or return, and the
# routine after a loop that only returns needs nothing more.
import Hosted

routine first_square_over(limit: U64) -> U64
    loop with n: U64 = 1
        if n * n > limit
            return n
        continue with n: n + 1

routine start() -> None
    loop with i: U64 = 0
        if i == 3
            break
        Console.show("round {i}")
        continue with i: i + 1
    then
        Console.show("left after 3 rounds")
    Console.show("first square over 50: {first_square_over(limit: 50)}")
    return
