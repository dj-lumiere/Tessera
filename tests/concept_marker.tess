/// A marker concept (no routines) holds only where it's declared.
concept Sendable<T>
require T: typename

conform Sendable<U64>

routine send<T>(v: T) -> T
require T: typename, Sendable<T>
    block entry():
        return(v)

routine main() -> S32
    block entry():
        x : S64 = 1
        y : S64 = send(x)
        return(0)
