// The store comes after the load in the loop, so the first pass loads a slot nothing was stored into.
routine total(count: S64) -> S64
    shared sum : @S64 <- uninit

    block entry()
        jump add(0)

    block add(i: S64)
        so_far : S64 = sum.load()
        so_far.add(i).store_into(sum)
        more : Bool = i.lt(count)
        branch more
            ? add(i.add(1))
            : return(sum.load())

routine start() -> Void
    block entry()
        n : S64 = total(3)
        return()
