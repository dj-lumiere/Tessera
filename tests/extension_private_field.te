### An added routine sees only the public fields (BufWriter.count is secret to Standard/Format).
import Standard/Format
import Standard/Os

routine BufWriter[T].buffered(me: @Me) -> U64
needs T: typename
    return me.count.peek()

routine start() -> None
    local out: @BufWriter[Out] <- .hollow()

    out.construct(Out.writer())
    buffered: U64 = out.buffered()
    return
