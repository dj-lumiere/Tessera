### An added routine sees only the public fields (BufWriter.count is secret to Standard/System/Text).
import Standard/Hosted

routine @BufWriter[T].buffered() -> U64
needs T: typename
    return me.count.peek()

routine start() -> None
    out: &BufWriter[ConsoleOutput] <- .hollow()

    out.construct(Console.output())
    buffered: U64 = out.buffered()
    return
