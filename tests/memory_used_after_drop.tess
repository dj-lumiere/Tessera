# A Memory isn't used once it was handed on with steal.

import Standard/Os

routine keep(m: Memory[Byte]) -> None
    drop m
    return

routine start() -> None
    local m: @Memory[Byte] <- Memory[Byte].construct(count: 4, manager: DEFAULT_HEAP)

    keep(steal m)
    m.store(index: 0, value: 0x01)
    return
