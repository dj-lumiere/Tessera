; BTreeMap<I64, I64> against a model. An LCG drives random put / remove / contains / get in three phases (few keys,
; many keys for a deep tree, then a drain that removes keys picked by rank so borrows and merges run). Every 500
; operations a checkpoint prints the length, a running checksum of every result, a hash of the ascending iteration
; sequence, and key_order / get_order at the first, middle, and last rank. Then eq.
; The expected output is generated by scripts/gen_collection_btree.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every (key, value) pair in iteration order.
routine iteration_hash(#map: Ptr<BTreeMap<I64, I64>>) -> I64
    block entry():
        %iter_val: BTreeMapIter<I64, I64> = BTreeMapIter<I64, I64>.new(#map)
        #iter: Ptr<BTreeMapIter<I64, I64>> = alloca<BTreeMapIter<I64, I64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<BTreeMapIter<I64, I64>>, %hash: I64):
        %item: Option<KVPair<I64, I64>> = #iter.next()
        %more: Bool = %item.tag
        %pair: KVPair<I64, I64> = %item.value
        branch %more ? fold(#iter, %hash, %pair) : return(%hash)

    block fold(#iter: Ptr<BTreeMapIter<I64, I64>>, %hash: I64, %pair: KVPair<I64, I64>):
        %key:   I64 = %pair.key
        %value: I64 = %pair.value
        jump next(#iter, mix(mix(%hash, %key), %value))

routine rank_hash_at(#map: Ptr<BTreeMap<I64, I64>>, %hash: I64, %rank: I64) -> I64
    block entry():
        %key:   I64 = #map.key_order(%rank)
        %value: I64 = #map.get_order(%rank)
        return(mix(mix(%hash, %key), %value))

; Folds key_order and get_order at the first, middle, and last rank; 0 for an empty map.
routine rank_hash(#map: Ptr<BTreeMap<I64, I64>>) -> I64
    block entry():
        %length: I64 = #map.length()
        %empty:  Bool = %length.eq(0)
        branch %empty ? return(0) : ranks(%length)

    block ranks(%length: I64):
        %first:  I64 = rank_hash_at(#map, 0, 0)
        %middle: I64 = rank_hash_at(#map, %first, %length.sdiv(2))
        %last:   I64 = rank_hash_at(#map, %middle, %length.sub(1))
        return(%last)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #map: Ptr<BTreeMap<I64, I64>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #map.length())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#map))
        labeled(#out, "ranks", rank_hash(#map))
        write_line(#out)
        return()

; Runs %ops random operations on keys below %keys. An operation kind is drawn below 10: below %puts it's a put, below
; %removes a remove of a random key, below %rank_removes a remove of the key at a random rank, otherwise a lookup.
; Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #map: Ptr<BTreeMap<I64, I64>>, #rng: Ptr<Rng>,
        %phase: I64, %ops: I64, %keys: I64, %puts: I64, %removes: I64, %rank_removes: I64, %results: I64) -> I64
    block entry():
        jump next(0, %results)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %key:            I64  = #rng.below(%keys)
        %kind:           I64  = #rng.below(10)
        %is_put:         Bool = %kind.slt(%puts)
        %is_remove:      Bool = %kind.slt(%removes)
        %is_rank_remove: Bool = %kind.slt(%rank_removes)
        select:
            %is_put -> put(%op, %results, %key)
            %is_remove -> remove(%op, %results, %key)
            %is_rank_remove -> remove_ranked(%op, %results)
            _ -> lookup(%op, %results, %key)

    block put(%op: I64, %results: I64, %key: I64):
        %value: I64 = #rng.below(1000000)
        #map.put(%key, %value)
        jump record(%op, %results, %value)

    block remove(%op: I64, %results: I64, %key: I64):
        %removed: Bool = #map.remove(%key)
        jump record(%op, %results, %removed.to_i64())

    block remove_ranked(%op: I64, %results: I64):
        %length: I64  = #map.length()
        %empty:  Bool = %length.eq(0)
        branch %empty ? record(%op, %results, -2) : remove_at(%op, %results, %length)

    block remove_at(%op: I64, %results: I64, %length: I64):
        %rank:    I64  = #rng.below(%length)
        %key:     I64  = #map.key_order(%rank)
        %removed: Bool = #map.remove(%key)
        jump record(%op, %results, mix(%key, %removed.to_i64()))

    block lookup(%op: I64, %results: I64, %key: I64):
        %found: Bool = #map.contains(%key)
        branch %found ? get(%op, %results, %key) : record(%op, %results, -1)

    block get(%op: I64, %results: I64, %key: I64):
        %value: I64 = #map.get(%key)
        jump record(%op, %results, %value)

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #map, %phase, %op, %results)
        jump next(%op, %results)

; Copies #from into #to from the largest key down, so the two trees are built by a different insertion order.
routine copy_reversed(#from: Ptr<BTreeMap<I64, I64>>, #to: Ptr<BTreeMap<I64, I64>>) -> Void
    block entry():
        jump next(#from.length())

    block next(%rank_end: I64):
        %done: Bool = %rank_end.eq(0)
        branch %done ? return() : copy(%rank_end.sub(1))

    block copy(%rank: I64):
        #to.put(#from.key_order(%rank), #from.get_order(%rank))
        jump next(%rank)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 1 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %map_val: BTreeMap<I64, I64> = BTreeMap<I64, I64>.new(#alloc)
        #map: Ptr<BTreeMap<I64, I64>> = alloca<BTreeMap<I64, I64>>([%map_val])

        %r1: I64 = run_phase(#out, #map, #rng, 1, 3000, 64, 5, 7, 7, 0)
        %r2: I64 = run_phase(#out, #map, #rng, 2, 10000, 20000, 6, 7, 7, %r1)

        %copy_val: BTreeMap<I64, I64> = BTreeMap<I64, I64>.new(#alloc)
        #copy: Ptr<BTreeMap<I64, I64>> = alloca<BTreeMap<I64, I64>>([%copy_val])
        report_eq(#out, "empty copy equal", #map.eq(#copy))
        copy_reversed(#map, #copy)
        report_eq(#out, "reversed copy equal", #map.eq(#copy))
        report_eq(#out, "reversed copy same order", iteration_hash(#map).eq(iteration_hash(#copy)))
        #copy.put(-1, 0)
        report_eq(#out, "extra key equal", #map.eq(#copy))
        #copy.remove(-1)
        report_eq(#out, "extra key removed equal", #map.eq(#copy))
        %key: I64 = #map.key_order(0)
        #copy.put(%key, #map.get(%key).add(1))
        report_eq(#out, "changed value equal", #map.eq(#copy))
        #copy.free()

        %r3: I64 = run_phase(#out, #map, #rng, 3, 14000, 20000, 1, 3, 8, %r2)
        #map.free()
        report_eq(#out, "freed is empty", #map.is_empty())
        #out.flush()
        return(0)
