# @[T].getitem checks the index against the count: one past the end crashes with IndexOutOfBoundsError at the
# caller's line (getitem is @track_caller), after what came before reached stdout.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    local digits: @Array[U32, 3] <- [1, 2, 3]

    Crash.report_with(on_crash.to[Callable]())
    view: @[U32] = digits.getview()
    Console.show("last: {view.getitem(2)}")
    past: U32 = view[3]
    Console.show("not reached {past}")
    return
