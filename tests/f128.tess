routine hex(out: @FdWriter, x: F128) -> Void
    block entry():
        x.bits().represent_hex(out)
        write(out, " ")
        return()

routine bit(out: @FdWriter, b: Bool) -> Void
    block entry():
        write(out, "{b.to<U64>()} ")
        return()

routine one(out: @FdWriter, i: USize) -> Void
    block entry():
        a_bits : U128 = F128_A.get(i)
        b_bits : U128 = F128_B.get(i)
        a      : F128 = f128_of(a_bits)
        b      : F128 = f128_of(b_bits)
        hex(out, a.add(b))
        hex(out, a.sub(b))
        hex(out, a.mul(b))
        hex(out, a.div(b))
        hex(out, a.sqrt())
        a.to<F64>().bits().represent_hex(out)
        write(out, " ")
        a.to<F32>().bits().represent_hex(out)
        write(out, " ")
        a.to<F16>().bits().represent_hex(out)
        write(out, " ")
        a.to<BF16>().bits().represent_hex(out)
        write(out, " {a.to_clamp<S128>()} ")
        bit(out, a.lt(b))
        bit(out, a.eq(b))
        write(out, "{a.total_compare(b)}\n")
        return()

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()
        jump pairs(0, out)

    block pairs(i: USize, out: @FdWriter):
        done : Bool = i.ge(164)
        branch done
            ? ints(0, out)
            : pair(i, out)

    block pair(i: USize, out: @FdWriter):
        one(out, i)
        jump pairs(i.add(1), out)

    block ints(i: USize, out: @FdWriter):
        done : Bool = i.ge(30)
        branch done
            ? return(0)
            : int(i, out)

    block int(i: USize, out: @FdWriter):
        n : S128 = F128_INTS.get(i)
        n.to<F128>().bits().represent_hex(out)
        write(out, "\n")
        jump ints(i.add(1), out)
