routine hex(#out: Ptr<FdWriter>, %x: F128) -> Void
    block entry():
        %x.bits.format_hex(#out)
        write_str(#out, " ")
        return()

routine bit(#out: Ptr<FdWriter>, %b: Bool) -> Void
    block entry():
        %b.to_i64().format(#out)
        write_str(#out, " ")
        return()

routine one(#out: Ptr<FdWriter>, %i: I64) -> Void
    block entry():
        %a_bits: I128 := F128_A[%i]
        %b_bits: I128 := F128_B[%i]
        %a: F128 = F128.from_bits(%a_bits)
        %b: F128 = F128.from_bits(%b_bits)
        hex(#out, %a.add(%b))
        hex(#out, %a.sub(%b))
        hex(#out, %a.mul(%b))
        hex(#out, %a.div(%b))
        hex(#out, %a.sqrt())
        %a.to_f64().to_bits().format_hex(#out)
        write_str(#out, " ")
        %a.to_f32().to_bits().format_hex(#out)
        write_str(#out, " ")
        %a.to_f16().to_bits().format_hex(#out)
        write_str(#out, " ")
        %a.to_bf16().to_bits().format_hex(#out)
        write_str(#out, " ")
        %a.to_i128().format(#out)
        write_str(#out, " ")
        bit(#out, %a.lt(%b))
        bit(#out, %a.eq(%b))
        %a.total_compare(%b).format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        jump pairs(0, #out)

    block pairs(%i: I64, #out: Ptr<FdWriter>):
        %done: Bool = %i.sge(164)
        branch %done ? ints(0, #out) : pair(%i, #out)

    block pair(%i: I64, #out: Ptr<FdWriter>):
        one(#out, %i)
        jump pairs(%i.add(1), #out)

    block ints(%i: I64, #out: Ptr<FdWriter>):
        %done: Bool = %i.sge(30)
        branch %done ? return(0) : int(%i, #out)

    block int(%i: I64, #out: Ptr<FdWriter>):
        %n: I128 := F128_INTS[%i]
        %n.to_f128().bits.format_hex(#out)
        write_line(#out)
        jump ints(%i.add(1), #out)
