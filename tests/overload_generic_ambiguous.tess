// Two generic overloads that both fit, and no concrete one: ambiguous.

routine pair<T>(a: T, b: S64) -> S64
require T: typename
    block entry()
        return(b)

routine pair<U>(a: S64, b: U) -> S64
require U: typename
    block entry()
        return(a)

routine main() -> S32
    block entry()
        n : S64 = 1
        r : S64 = pair(n, n)
        return(0)
