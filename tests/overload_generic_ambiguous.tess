// Two generic overloads that both fit, and no concrete one: ambiguous.

routine pair<T>(a: T, b: S64) -> S64
require T: typename
    block entry()
        return(b)

routine pair<T>(a: S64, b: T) -> S64
require T: typename
    block entry()
        return(a)

routine start() -> Void
    block entry()
        n : S64 = 1
        r : S64 = pair(n, n)
        return()
