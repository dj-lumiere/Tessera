// A literal without its type goes into a variant through the one branch of its shape: a tuple, an array, a record
// literal, or a number.

import Standard/Format
import Standard/Os

#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Point
    x: S64
    y: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

/// Prints each value.
routine start() -> Void
    pair: Maybe[(S64, S64)] = (1, 2)
    three: Maybe[Array[S64, 3]] = [7, 8, 9]
    point: Point | Bool = (x: 3, y: 4)
    number: Maybe[U8] = 5
    Out.write("{pair.diagnose()} {three.diagnose()} {point} {number}\n")
    return()
