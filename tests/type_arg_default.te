# A type parameter or a value type parameter may declare a default (needs T: typename = U64, needs O: Order = SEQ_CST).
# A use that leaves out trailing arguments takes the defaults, and an argument the call's values give (inference) wins
# over a default.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE
    ### One order for every thread.
    SEQ_CST

### A cell with an order, SEQ_CST unless the type says another.
### :typeparam O: The order.
record Cell[O]
needs Order O = SEQ_CST
    v: U64

### A pair whose second type is the first unless it is written.
### :typeparam A: The first type.
### :typeparam B: The second type.
record Pair[A, B]
needs AnyType B = A
    count: U64

### The rank of O.
### :typeparam O: The order.
### :returns: 0 to 2.
routine rank[O]() -> U64
needs Order O
    return when O
        Order.RELAXED => 0
        Order.ACQUIRE => 1
        Order.SEQ_CST => 2

### x plus a hundred times O's rank, SEQ_CST unless the call says another.
### :typeparam O: The order.
### :param x: The value.
### :returns: The sum.
routine add[O](x: U64) -> U64
needs Order O = SEQ_CST
    return rank[O]() * 100 + x

### The rank of a cell's order.
### :typeparam O: The order.
### :param c: The cell.
### :returns: Its rank.
routine order_of[O](c: Cell[O]) -> U64
needs Order O = RELAXED
    return rank[O]()

### A zero cell, SEQ_CST unless the call or where the cell goes says another.
### :typeparam O: The order.
### :returns: The cell.
routine cell[O]() -> Cell[O]
needs Order O = SEQ_CST
    return Cell[O](v: 0)

### The name of T, U64 unless the call says another.
### :typeparam T: The type.
### :returns: The type's name.
routine name_of[T]() -> @[Byte]
needs AnyType T = U64
    return type_name[T]()

### The name of x's type, which x gives, whatever the default says.
### :typeparam T: The type.
### :param x: The value.
### :returns: The type's name.
routine kind_of[T](x: T) -> @[Byte]
needs AnyType T = U64
    return type_name[T]()

### N times x, with N four unless written.
### :typeparam T: The type.
### :typeparam N: The factor.
### :param x: The value.
### :returns: The product.
routine times[T, N](x: T) -> U64
needs U64 N = 4
    return N * 10

### Runs.
routine start() -> None
    Console.show("{add(1)} {add[SEQ_CST](1)} {add[RELAXED](1)} {add[Order.ACQUIRE](1)}")
    usual: Cell
    written: Cell[SEQ_CST] = usual
    relaxed: Cell[RELAXED]
    Console.show("{type_name[Cell]()} {order_of(written)} {order_of(relaxed)}")
    Console.show("{type_name[Pair[S32]]()} {type_name[Pair[S32, Bool]]()}")
    narrow: S8 = 5
    Console.show("{name_of()} {name_of[Bool]()} {kind_of(narrow)} {kind_of[Bool](true)}")
    made: Cell[ACQUIRE] = cell()
    Console.show("{order_of(cell())} {order_of(made)} {order_of(cell[RELAXED]())}")
    Console.show("{times[S64](1)} {times[S64, 2](1)}")
    return
