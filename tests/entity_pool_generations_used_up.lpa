# The generations only go up across pools: a stamp of an ended pool never matches a slot of a later one, and when the
# slots of earlier pools reached the last generation, the next set_up is refused (loud, never a silent wrong read).

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### What a stamp fetches now: the value, or -1 when it fails.
### :param s: The stamp.
### :returns: The value or -1.
routine value_of(s: PoolStamp[Node]) -> S64
    when try s.fetch()
        is @Node as n => return n.value.peek()
        is None => return -1

### Whether a pool can be set up now.
### :returns: True when it worked.
routine can_set_up() -> Bool
    when try EntityPool.set_up(memory: PAGES)
        is EntityPool as other =>
            drop other
            return true
        is None => return false

### Shows the stamps across pools, then the refusal.
routine start() -> None
    first: &EntityPool <- EntityPool.set_up(memory: PAGES)
    a: PoolStamp[Node] = EntityPool.add(Node.construct(value: 1))
    EntityPool.remove(a)
    EntityPool.sweep()
    b: PoolStamp[Node] = EntityPool.add(Node.construct(value: 2))
    drop first
    EntityPool.raise_generation_floor(floor: 4000000000)
    second: &EntityPool <- EntityPool.set_up(memory: PAGES)
    c: PoolStamp[Node] = EntityPool.add(Node.construct(value: 3))
    Console.show("old stamps: {value_of(a)} {value_of(b)}, new: {value_of(c)}")
    drop second
    EntityPool.raise_generation_floor(floor: 4294967294)
    Console.show("can set up after the last generation: {can_set_up()}")
    return
