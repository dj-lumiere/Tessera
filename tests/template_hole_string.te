# A string literal inside a template hole is written as it is, quotes and escapes included, and a string whose braces
# are only text stays as it was.
import Hosted

routine start() -> None
    greeting: @[Byte] = "hello world"
    Console.show("{greeting.find("world")} {greeting.find("o w")} {greeting.find("}")}")
    Console.show("{greeting.find("x\\y")} {{literal}}")
    open: @[Byte] = "{"
    close: @[Byte] = "}"
    Console.show("{open.count()} {close.count()}")
    Console.show("{greeting.find(\"hello\")}")
    return
