// `continue` on the one arm of a `when` that doesn't leave the block keeps that arm's payload: the lines after the
// when see it as a binding of the block, the let-else shape. A variant with several payload cases, an Option in a
// loop, and a Result whose failure leaves through a finish block.

import Standard::Collections
import Standard::Format
import Standard::Os

variant Shape
    Circle : S64
    Square : S64
    Empty

/// The area of a circle (3 for pi), and 0 for anything else.
routine circle_area(shape: Shape) -> S64
    block entry()
        when shape
            Shape.Circle(radius) -> continue
            Shape.Square         -> return(0)
            Shape.Empty          -> return(0)
        squared : S64 = radius.mul(radius)
        return(squared.mul(3))

/// The sum of the list, read through its iterator until it runs out.
routine sum(list: @List<S64>) -> S64
    shared iter  : @ListIter<S64> <- .construct(list)
    shared total : @S64           <- 0

    block entry()
        jump next()

    block next()
        item : Option<S64> = iter.next()
        when item
            .Present(value) -> continue
            .Absent         -> return(total.load())
        total.load().add(value).store_into(total)
        jump next()

/// The text as a number, or -1 when it isn't one.
routine number_or_minus_one(text: Bytes) -> S64
    block entry()
        parsed : Result<S64, ParseError> = text.to_result<S64>()
        when parsed
            .Success(number) -> continue
            .Failure         -> finish(-1)
        doubled : S64 = number.mul(2)
        jump finish(doubled.div(2))

    block finish(result: S64)
        return(result)

routine start() -> Void
    block entry()
        a : S64 = circle_area(.Circle(4))
        b : S64 = circle_area(.Square(4))
        Out.write("areas {a} {b}\n")
        claim list : @List<S64> <- .construct()
        list.push(5)
        list.push(7)
        list.push(30)
        total : S64 = sum(list)
        Out.write("sum {total}\n")
        list.destruct()
        good : S64 = number_or_minus_one("42")
        bad  : S64 = number_or_minus_one("x")
        Out.write("parsed {good} {bad}\n")
        return()
