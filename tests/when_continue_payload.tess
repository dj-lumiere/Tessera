// `continue` on the one arm of a `when` that doesn't leave the block keeps the value that arm names: the lines after
// the when see it as a binding of the block, the let-else shape. A variant of three records, a Maybe in a loop, and a
// Result whose failure leaves through a finish block.

import Standard/Collections
import Standard/Format
import Standard/Os

record Circle
    radius: S64

record Square
    side: S64

record Empty

variant Shape
    Circle
    Square
    Empty

/// The area of a circle (3 for pi), and 0 for anything else.
routine circle_area(shape: Shape) -> S64
    when shape
        is Circle as circle => continue
        is Square => return(0)
        is Empty => return(0)
    squared: S64 = circle.radius.mul(circle.radius)
    return(squared.mul(3))

/// The sum of the list, read through its iterator until it runs out.
routine sum(list: @List[S64]) -> S64
    local iter: @ListIter[S64] <- .construct(list)
    local total: @S64 <- 0

    jump next()

    block next()
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as value => continue
            is Unit => return(total.peek())
        total.peek().add(value).poke_into(total)
        jump next()

/// The text as a number, or -1 when it isn't one.
routine number_or_minus_one(text: Span[Byte]) -> S64
    parsed: Result[S64, ParseError] = text.to_result[S64]()
    when parsed
        is S64 as number => continue
        is ParseError => finish(-1)
    doubled: S64 = number.mul(2)
    jump finish(doubled.div(2))

    block finish(result: S64)
        return(result)

routine start() -> Void
    a: S64 = circle_area(Circle(radius: 4))
    b: S64 = circle_area(Square(side: 4))
    Out.write("areas {a} {b}\n")
    claim list: @List[S64] <- .construct()
    list.add_last(5)
    list.add_last(7)
    list.add_last(30)
    total: S64 = sum(list)
    Out.write("sum {total}\n")
    list.destruct()
    good: S64 = number_or_minus_one("42")
    bad: S64 = number_or_minus_one("x")
    Out.write("parsed {good} {bad}\n")
    return()
