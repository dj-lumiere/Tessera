# A poke over a BorrowedSlice field that holds memory.

import Standard/Hosted

### Holds memory.
entity Q
    m: BorrowedSlice[S64]

### An empty one.
### :returns: It.
common routine Q.construct() -> Me
    return Me(m: .hollow())

### Gives the field back.
routine @Q.destruct() -> None
    drop me.m
    return

routine start() -> None
    q: &Q <- .construct()

    q.m.replace(value: BorrowedSlice[S64].construct(values: [7], times: 4, manager: HEAP))
    q.m.poke(BorrowedSlice[S64].construct(values: [8], times: 4, manager: HEAP))
    drop q
    Console.show("done")
    return
