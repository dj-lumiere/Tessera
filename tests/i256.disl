routine space(#out: Ptr<BufWriter<FdWriter>>) -> Void
    block entry():
        write_str(#out, " ")
        return()

routine field(#out: Ptr<BufWriter<FdWriter>>, %x: I256) -> Void
    block entry():
        space(#out)
        %x.format_hex(#out)
        return()

routine field_bool(#out: Ptr<BufWriter<FdWriter>>, %b: Bool) -> Void
    block entry():
        space(#out)
        %b.format(#out)
        return()

routine field_order(#out: Ptr<BufWriter<FdWriter>>, %order: I32) -> Void
    block entry():
        space(#out)
        %order.format(#out)
        return()

routine field_option(#out: Ptr<BufWriter<FdWriter>>, %o: Option<I256>) -> Void
    block entry():
        %some: Bool = %o.tag
        branch %some ? value(%o.value) : none()

    block value(%x: I256):
        field(#out, %x)
        return()

    block none():
        write_str(#out, " none")
        return()

routine field_overflowing(#out: Ptr<BufWriter<FdWriter>>, %o: Overflowing<I256>) -> Void
    block entry():
        field(#out, %o.value)
        write_str(#out, "/")
        %o.overflow.format(#out)
        return()

routine check_unary(#out: Ptr<BufWriter<FdWriter>>, %x: I256) -> Void
    block entry():
        write_str(#out, "u")
        field(#out, %x.count_ones())
        field(#out, %x.leading_zeros())
        field(#out, %x.trailing_zeros())
        field(#out, %x.swap_bytes())
        field(#out, %x.abs())
        field(#out, %x.neg())
        field(#out, %x.bitnot())
        field(#out, %x.count_zeros())
        field(#out, %x.leading_ones())
        field(#out, %x.trailing_ones())
        field(#out, %x.reverse_bits())
        field_bool(#out, %x.is_power_of_two())
        field(#out, %x.signum())
        field_bool(#out, %x.is_negative())
        field_bool(#out, %x.is_positive())
        space(#out)
        %x.to_i8().format_hex(#out)
        space(#out)
        %x.to_i16().format_hex(#out)
        space(#out)
        %x.to_i32().format_hex(#out)
        space(#out)
        %x.to_i64().format_hex(#out)
        space(#out)
        %x.to_i128().format_hex(#out)
        space(#out)
        %x.hash().format_hex(#out)
        space(#out)
        %x.format(#out)
        space(#out)
        %x.uformat(#out)
        space(#out)
        %x.limb(0).format_hex(#out)
        space(#out)
        %x.limb(1).format_hex(#out)
        space(#out)
        %x.limb(2).format_hex(#out)
        space(#out)
        %x.limb(3).format_hex(#out)
        write_line(#out)
        return()

routine check_binary(#out: Ptr<BufWriter<FdWriter>>, %a: I256, %b: I256) -> Void
    block entry():
        write_str(#out, "b")
        field(#out, %a.add(%b))
        field(#out, %a.sub(%b))
        field(#out, %a.mul(%b))
        field(#out, %a.bitand(%b))
        field(#out, %a.bitor(%b))
        field(#out, %a.bitxor(%b))
        field(#out, %a.min(%b))
        field(#out, %a.max(%b))
        field(#out, %a.umin(%b))
        field(#out, %a.umax(%b))
        field_bool(#out, %a.slt(%b))
        field_bool(#out, %a.sle(%b))
        field_bool(#out, %a.sgt(%b))
        field_bool(#out, %a.sge(%b))
        field_bool(#out, %a.ult(%b))
        field_bool(#out, %a.ule(%b))
        field_bool(#out, %a.ugt(%b))
        field_bool(#out, %a.uge(%b))
        field_bool(#out, %a.eq(%b))
        field_bool(#out, %a.ne(%b))
        field_order(#out, %a.compare(%b))
        field_order(#out, %a.ucompare(%b))
        field_option(#out, %a.checked_sadd(%b))
        field_option(#out, %a.checked_uadd(%b))
        field_option(#out, %a.checked_ssub(%b))
        field_option(#out, %a.checked_usub(%b))
        field(#out, %a.saturating_sadd(%b))
        field(#out, %a.saturating_uadd(%b))
        field(#out, %a.saturating_ssub(%b))
        field(#out, %a.saturating_usub(%b))
        field_overflowing(#out, %a.overflowing_sadd(%b))
        field_overflowing(#out, %a.overflowing_uadd(%b))
        field_overflowing(#out, %a.overflowing_ssub(%b))
        field_overflowing(#out, %a.overflowing_usub(%b))
        write_line(#out)
        return()

routine check_shift(#out: Ptr<BufWriter<FdWriter>>, %x: I256, %n: I256, %rot: I256) -> Void
    block entry():
        write_str(#out, "s")
        field(#out, %x.shl(%n))
        field(#out, %x.lshr(%n))
        field(#out, %x.ashr(%n))
        field(#out, %x.rotl(%rot))
        field(#out, %x.rotr(%rot))
        write_line(#out)
        return()

routine check_widen(#out: Ptr<BufWriter<FdWriter>>, %x: I64) -> Void
    block entry():
        write_str(#out, "w")
        field(#out, %x.to_i8().to_i256())
        field(#out, %x.to_i8().to_u256())
        field(#out, %x.to_i16().to_i256())
        field(#out, %x.to_i16().to_u256())
        field(#out, %x.to_i32().to_i256())
        field(#out, %x.to_i32().to_u256())
        field(#out, %x.to_i256())
        field(#out, %x.to_u256())
        write_line(#out)
        return()

routine check_wide_mul(#out: Ptr<BufWriter<FdWriter>>, %a: I128, %b: I128) -> Void
    block entry():
        write_str(#out, "m")
        field(#out, %a.to_i256())
        field(#out, %a.to_u256())
        field(#out, %a.umul_wide(%b))
        field(#out, %a.smul_wide(%b))
        write_line(#out)
        return()

routine check_division(#out: Ptr<BufWriter<FdWriter>>, %u: I256, %d: I256) -> Void
    block entry():
        write_str(#out, "d")
        field(#out, %u.udiv(%d))
        field(#out, %u.urem(%d))
        field(#out, %u.sdiv(%d))
        field(#out, %u.srem(%d))
        write_line(#out)
        return()

routine field_2by1(#out: Ptr<BufWriter<FdWriter>>, %r: Div2By1) -> Void
    block entry():
        space(#out)
        %r.quotient.format_hex(#out)
        space(#out)
        %r.remainder.format_hex(#out)
        return()

routine check_2by1(#out: Ptr<BufWriter<FdWriter>>, %u1: I64, %u0: I64, %d: I64) -> Void
    block entry():
        write_str(#out, "t")
        field_2by1(#out, div_2by1_divq(%u1, %u0, %d))
        %v: I64 = reciprocal_2by1(%d)
        field_2by1(#out, div_2by1_mg(%u1, %u0, %d, %v))
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        jump unary(0, #out)

    block unary(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(139)
        branch %done ? binary(0, #out) : unary_one(%i, #out)

    block unary_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %x: I256 := UNARY[%i]
        check_unary(#out, %x)
        jump unary(%i.add(1), #out)

    block binary(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(444)
        branch %done ? shift(0, #out) : binary_one(%i, #out)

    block binary_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %a: I256 := BIN_A[%i]
        %b: I256 := BIN_B[%i]
        check_binary(#out, %a, %b)
        jump binary(%i.add(1), #out)

    block shift(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(240)
        branch %done ? widen(0, #out) : shift_one(%i, #out)

    block shift_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %x:   I256 := SHIFT_X[%i]
        %n:   I256 := SHIFT_N[%i]
        %rot: I256 := ROT_N[%i]
        check_shift(#out, %x, %n, %rot)
        jump shift(%i.add(1), #out)

    block widen(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(67)
        branch %done ? wide_mul(0, #out) : widen_one(%i, #out)

    block widen_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %x: I64 := SMALL[%i]
        check_widen(#out, %x)
        jump widen(%i.add(1), #out)

    block wide_mul(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(85)
        branch %done ? division(0, #out) : wide_mul_one(%i, #out)

    block wide_mul_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %a: I128 := WIDE_A[%i]
        %b: I128 := WIDE_B[%i]
        check_wide_mul(#out, %a, %b)
        jump wide_mul(%i.add(1), #out)

    block division(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(4339)
        branch %done ? two_by_one(0, #out) : division_one(%i, #out)

    block division_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %u: I256 := DIV_U[%i]
        %d: I256 := DIV_D[%i]
        check_division(#out, %u, %d)
        jump division(%i.add(1), #out)

    block two_by_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %done: Bool = %i.sge(400)
        branch %done ? finish(#out) : two_by_one_one(%i, #out)

    block two_by_one_one(%i: I64, #out: Ptr<BufWriter<FdWriter>>):
        %u1: I64 := TWO_U1[%i]
        %u0: I64 := TWO_U0[%i]
        %d:  I64 := TWO_D[%i]
        check_2by1(#out, %u1, %u0, %d)
        jump two_by_one(%i.add(1), #out)

    block finish(#out: Ptr<BufWriter<FdWriter>>):
        #out.flush()
        return(0)
