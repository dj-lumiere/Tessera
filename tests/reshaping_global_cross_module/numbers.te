# Numbers keeps a list in a global and grows it.

module Numbers

import Collections
import Hosted

lateinit global NUMBERS: &List[S64]

### Fills the list with its first number.
routine set_up() -> None
    NUMBERS.poke(List[S64].construct(manager: HEAP))
    NUMBERS.add_last(5)
    return

### Adds a number to the list.
routine grow() -> None
    NUMBERS.add_last(6)
    return
