# A view of what another module's global holds ends at a call to a routine of that module: the module the routine
# is in is the global's, so the routine can reach it.

import Collections
import Hosted
import Numbers

routine start() -> None
    set_up()
    s: @[S64] = NUMBERS.getview()
    grow()
    Console.show(s.getslot(0).peek())
    return
