# A piece of work is a plain value bound with =: nothing lends it, so binding it with <- is a build error.

import Standard/Os

routine seven() -> S64
    return 7

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] <- seven.to[Work]()
    t.put_work(work)
    Console.show("{t.retrieve()}")
    drop t
    return
