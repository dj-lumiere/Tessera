// A field of a global record is a place: loaded, stored, and the target of store_into.
import Standard/Format
import Standard/Os

global ROOTS: @HeaderBuffer

record HeaderBuffer
    items: @Addr
    count: U64
    capacity: U64

routine reset() -> Void
    ROOTS.count.poke(0)
    return()

routine set(n: U64) -> Void
    n.poke_into(ROOTS.count)
    return()

routine get() -> U64
    c: U64 = ROOTS.count.peek()
    return(c)

routine start() -> Void
    set(5)
    Out.write("{get()}\n")
    reset()
    Out.write("{get()}\n")
    return()
