// A field of a global record is a place: loaded, stored, and the target of store_into.
import Standard::Format
import Standard::Os

global ROOTS: @HeaderBuffer

record HeaderBuffer
    items    : @Addr
    count    : U64
    capacity : U64

routine reset() -> Void
    block entry()
        ROOTS.count.store(0)
        return()

routine set(n: U64) -> Void
    block entry()
        n.store_into(ROOTS.count)
        return()

routine get() -> U64
    block entry()
        c : U64 = ROOTS.count.load()
        return(c)

routine main() -> S32
    block entry()
        set(5)
        Out.write("{get()}\n")
        reset()
        Out.write("{get()}\n")
        return(0)
