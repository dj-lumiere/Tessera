# steal place as old inject new: the new value is computed first (it may read the place), the old one goes to `old`,
# and the new one goes into the place in the same step, so the place is never hollow. An element at any index (of a
# Slots or a List), and a field. A place the builder follows (a constant index) still takes the steal-then-refill form.

import Hosted
import Collections

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Counter(n: n)

### Ends it.
routine @Counter.destruct() -> None
    return

### Two counters.
entity Pair
    left: Counter
    right: Counter

### Makes one.
### :param left: The first counter, taken over.
### :param right: The second counter, taken over.
### :returns: The new value.
common routine Pair.construct(left: Counter, right: Counter) -> Me
    return Pair(left: steal left, right: steal right)

### Ends both counters.
routine @Pair.destruct() -> None
    drop me.left
    drop me.right
    return

routine start() -> None
    a: &Slots[Counter, 2] <- [Counter.construct(n: 1), Counter.construct(n: 2)]
    i: U64 = 1
    steal a.getslot(i) as old inject Counter.construct(n: a.getslot(i).n.peek() + 10)
    Console.show(old.n.peek())
    j: U64 = i
    Console.show(a.getslot(j).n.peek())
    drop old
    xs: &List[Counter] <- List[Counter].construct(HEAP)
    xs.add_last(Counter.construct(n: 5))
    xs.add_last(Counter.construct(n: 6))
    k: U64 = 0
    steal xs.getslot(k) as first inject Counter.construct(n: 50)
    Console.show(first.n.peek())
    Console.show(xs.getslot(0).n.peek())
    drop first
    p: &Pair <- Pair.construct(left: Counter.construct(n: 7), right: Counter.construct(n: 8))
    steal p.left as was inject Counter.construct(n: 70)
    Console.show(was.n.peek())
    Console.show(p.left.n.peek())
    drop was
    steal a.getslot(0) as zero
    Console.show(zero.n.peek())
    a.getslot(0).poke(steal zero)
    Console.show(a.getslot(0).n.peek())
    drop xs
    drop p
    drop a.getslot(0)
    drop a.getslot(1)
    return
