// Span<T>.getspan checks the whole range: a view that would run one past the end crashes with
// IndexOutOfBoundsError, while one that ends exactly at the end (even an empty one) is fine.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    block entry()
        text : Bytes      = "span"
        view : Span<Byte> = text.to<Span<Byte>>()
        tail : Span<Byte> = view.getspan(2, 2)
        none : Span<Byte> = view.getspan(4, 0)
        Out.write("tail {tail.count()}, none {none.count()}\n")
        past : Span<Byte> = view.getspan(3, 2)
        Out.write("not reached {past.count()}\n")
        return(0)
