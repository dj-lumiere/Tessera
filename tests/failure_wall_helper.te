# Every routine passes its failures on but an infallible one, which is a wall: a failure below it stops the program
# there, even with a try above it.

import Hosted

crashable OddError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine OddError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.value} is odd")
    return

### Half of an even n.
### :param n: The number.
### :returns: Its half.
routine half(n: S64) -> S64
    if n % 2 != 0
        throw OddError(value: n)
    return n // 2

### Infallible: half's failure stops the program here.
### :param n: The number.
### :returns: Its half.
infallible routine helper(n: S64) -> S64
    return half(n)

### Passes failures on, calling the helper.
### :param n: The number.
### :returns: Its half.
routine through(n: S64) -> S64
    return helper(n)

routine start() -> None
    when try through(n: 4)
        is S64 as v => Console.show("first: {v}")
        is None => Console.show("first: none")
    when try through(n: 3)
        is S64 as v => Console.show("not reached: {v}")
        is None => Console.show("not reached: none")
    return
