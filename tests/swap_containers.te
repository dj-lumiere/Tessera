# swap on the other containers that hand out element places by index: a Span, an Array through its pointer, a Memory,
# and a CircularList whose front isn't at the start of its storage.

import Standard/Collections
import Standard/Os

### Writes the values of a span in order.
### :param values: The values to write.
routine show(values: @[S64]) -> None
    each i in 0 til values.count()
        Console.show("{values[i]} ", end: "")
    Console.show("")
    return

### Swaps the first and last value of each container and writes it.
routine start() -> None
    local frame: @[S64] <- [1, 2, 3]
    local array: @Array[S64, 3] <- [4, 5, 6]
    local memory: @Memory[S64] <- [7] * 3 from HEAP
    local ring: @CircularList[S64] <- .construct()

    frame.swap(first: 0, second: 2)
    show(frame)
    array.swap(first: 0, second: 2)
    show(array.getview())
    memory.getslot(2).poke(9)
    memory.swap(first: 0, second: 2)
    show(memory.getslice())
    ring.add_last(11)
    ring.add_last(12)
    ring.add_first(10)
    ring.swap(first: 0, second: 2)
    each i in 0 til ring.count()
        Console.show("{ring[i]} ", end: "")
    Console.show("")
    drop memory
    drop ring
    return
