# swap on the other containers that hand out element places by index: a PointedSlice, an Items through its pointer, a BorrowedSlice,
# and a RotatableList whose front isn't at the start of its storage.

import Collections
import Hosted

### Writes the values of a span in order.
### :param values: The values to write.
routine show(values: @[S64]) -> None
    for i in 0 til values.count()
        Console.show("{values[i]} ", end: "")
    Console.show("")
    return

### Swaps the first and last value of each container and writes it.
routine start() -> None
    frame: &[S64] <- [1, 2, 3]
    array: &Items[S64, 3] <- [4, 5, 6]
    memory: &[S64] <- [7] * 3 from HEAP
    ring: &RotatableList[S64] <- .construct(HEAP)

    frame.swap(first: 0, second: 2)
    show(frame)
    array.swap(first: 0, second: 2)
    show(array.getview())
    memory.getslot(2).poke(9)
    memory.swap(first: 0, second: 2)
    show(memory.getslice())
    ring.add_last(11)
    ring.add_last(12)
    ring.add_first(10)
    ring.swap(first: 0, second: 2)
    for i in 0 til ring.count()
        Console.show("{ring[i]} ", end: "")
    Console.show("")
    drop memory
    drop ring
    return
