# Exclusive access to one element of a BorrowedSlice keeps another thread's access to that element waiting until it is given
# back, and leaves the element next to it free: an access covers the bytes of one value.

import Hosted

### Takes exclusive access to the first element, which the main thread holds: waits, then reads what it wrote.
### :param m: The memory.
### :returns: The value it read, and whether it had to wait.
routine read_first(m: @BorrowedSlice[U64]) -> (U64, Bool)
    started: Duration = Clock.monotonic()
    first: Authorized[U64] <- m.getslot(0).get_exclusive_access()
    waited: Bool = Clock.monotonic() - started >= 20ms
    value: U64 = first.getview().peek()
    drop first
    return (value, waited)

### Takes exclusive access to the second element without waiting.
### :param m: The memory.
### :returns: Whether it got it.
routine take_second(m: @BorrowedSlice[U64]) -> Bool
    lateinit place: &SourceLocation

    second: @U64 = m.getslot(1)
    taken: Bool = AccessManager.try_take(
        request: AccessRequest(at: second, size: 8, mode: ACCESS_WRITE), place)
    if taken
        AccessManager.give_back(at: second)
    return taken

routine start() -> None
    m: &[U64] <- [0] * 2 from HEAP

    first: Authorized[U64] <- m.getslot(0).get_exclusive_access()
    t: Thread[(U64, Bool)] <- get_thread[(U64, Bool)]()
    work_t: Work[(U64, Bool)] = read_first.to[Work](m: m)
    t.put_work(work_t)
    u: Thread[Bool] <- get_thread[Bool]()
    work_u: Work[Bool] = take_second.to[Work](m: m)
    u.put_work(work_u)
    next_one: Bool = u.retrieve()
    drop u
    waitfor(40ms)
    first.getview().poke(5)
    drop first
    value, waited = t.retrieve()
    drop t
    Console.show("the next element was free: {next_one}")
    Console.show("the other thread waited: {waited}, then read {value}")
    drop m
    return
