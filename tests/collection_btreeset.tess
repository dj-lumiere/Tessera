; BTreeSet<I64> against a model. An LCG drives random add / remove / contains in three phases: few keys, then enough
; keys for a B-tree at least four levels deep, then a phase that removes by random rank until most keys are gone, so borrows
; and merges run. Every 500 operations a checkpoint prints the length, a running checksum of every result, the
; elements at a few ranks, and a hash of the (ascending) iteration sequence. Then eq.
; The expected output is generated by scripts/gen_collection_sets.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every element in iteration order.
routine iteration_hash(#set: Ptr<BTreeSet<I64>>) -> I64
    block entry():
        %iter_val: BTreeSetIter<I64> = BTreeSetIter<I64>.new(#set)
        #iter: Ptr<BTreeSetIter<I64>> = alloca<BTreeSetIter<I64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<BTreeSetIter<I64>>, %hash: I64):
        %item: Option<I64> = #iter.next()
        %more: Bool = %item.tag
        %key:  I64 = %item.value
        branch %more ? next(#iter, mix(%hash, %key)) : return(%hash)

; Folds the elements at ranks 0, length / 3, length / 2, and length - 1 (0 for an empty set).
routine rank_hash(#set: Ptr<BTreeSet<I64>>) -> I64
    block entry():
        %length: I64 = #set.length()
        %empty: Bool = %length.eq(0)
        branch %empty ? return(0) : fold(%length)

    block fold(%length: I64):
        %first: I64 = #set.get_order(0)
        %third: I64 = #set.get_order(%length.sdiv(3))
        %half:  I64 = #set.get_order(%length.sdiv(2))
        %last:  I64 = #set.get_order(%length.sub(1))
        %hash:  I64 = mix(mix(mix(mix(0, %first), %third), %half), %last)
        return(%hash)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #set: Ptr<BTreeSet<I64>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #set.length())
        labeled(#out, "results", %results)
        labeled(#out, "ranks", rank_hash(#set))
        labeled(#out, "iteration", iteration_hash(#set))
        write_line(#out)
        return()

; Runs %ops random operations on keys below %keys: an add when the kind (0..9) is below %adds, a remove below 7, and
; a contains otherwise. With %by_rank, a remove takes the element at a random rank instead of a random key.
; Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #set: Ptr<BTreeSet<I64>>, #rng: Ptr<Rng>,
        %phase: I64, %ops: I64, %keys: I64, %adds: I64, %by_rank: Bool, %results: I64) -> I64
    block entry():
        jump next(0, %results)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %key:       I64  = #rng.below(%keys)
        %kind:      I64  = #rng.below(10)
        %is_add:    Bool = %kind.slt(%adds)
        %is_remove: Bool = %kind.slt(7)
        select:
            %is_add -> add(%op, %results, %key)
            %is_remove -> remove(%op, %results, %key)
            _ -> lookup(%op, %results, %key)

    block add(%op: I64, %results: I64, %key: I64):
        %added: Bool = #set.add(%key)
        jump record(%op, %results, %added.to_i64())

    block remove(%op: I64, %results: I64, %key: I64):
        %nonempty: Bool = #set.is_empty().bitnot()
        %rank_remove: Bool = %by_rank.bitand(%nonempty)
        branch %rank_remove ? remove_rank(%op, %results) : remove_key(%op, %results, %key)

    block remove_rank(%op: I64, %results: I64):
        %rank: I64 = #rng.below(#set.length())
        %key:  I64 = #set.get_order(%rank)
        jump remove_key(%op, %results, %key)

    block remove_key(%op: I64, %results: I64, %key: I64):
        %removed: Bool = #set.remove(%key)
        jump record(%op, %results, mix(%key, %removed.to_i64()))

    block lookup(%op: I64, %results: I64, %key: I64):
        %found: Bool = #set.contains(%key)
        jump record(%op, %results, %found.to_i64())

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #set, %phase, %op, %results)
        jump next(%op, %results)

; Adds #from's elements to #to by rank, starting from the middle, so #to is built in a different order.
routine copy_rotated(#from: Ptr<BTreeSet<I64>>, #to: Ptr<BTreeSet<I64>>) -> Void
    block entry():
        %length: I64 = #from.length()
        %half:   I64 = %length.sdiv(2)
        jump next(0, %length, %half)

    block next(%i: I64, %length: I64, %half: I64):
        %done: Bool = %i.sge(%length)
        branch %done ? return() : copy(%i, %length, %half)

    block copy(%i: I64, %length: I64, %half: I64):
        %rank: I64 = %i.add(%half).srem(%length)
        #to.add(#from.get_order(%rank))
        jump next(%i.add(1), %length, %half)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 1 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %set_val: BTreeSet<I64> = BTreeSet<I64>.new(#alloc)
        #set: Ptr<BTreeSet<I64>> = alloca<BTreeSet<I64>>([%set_val])

        %r1: I64 = run_phase(#out, #set, #rng, 1, 3000, 64, 5, false, 0)
        %r2: I64 = run_phase(#out, #set, #rng, 2, 12000, 20000, 5, false, %r1)
        %r3: I64 = run_phase(#out, #set, #rng, 3, 9000, 20000, 1, true, %r2)

        %copy_val: BTreeSet<I64> = BTreeSet<I64>.new(#alloc)
        #copy: Ptr<BTreeSet<I64>> = alloca<BTreeSet<I64>>([%copy_val])
        report_eq(#out, "empty copy equal", #set.eq(#copy))
        copy_rotated(#set, #copy)
        report_eq(#out, "rotated copy equal", #set.eq(#copy))
        report_eq(#out, "rotated copy same order", iteration_hash(#set).eq(iteration_hash(#copy)))
        #copy.add(-1)
        report_eq(#out, "extra element equal", #set.eq(#copy))
        #copy.remove(-1)
        report_eq(#out, "extra element removed equal", #set.eq(#copy))
        %last: I64 = #set.get_order(#set.length().sub(1))
        #copy.remove(%last)
        #copy.add(%last.add(1))
        report_eq(#out, "changed element equal", #set.eq(#copy))
        #copy.free()
        #set.free()
        report_eq(#out, "freed is empty", #set.is_empty())
        #out.flush()
        return(0)
