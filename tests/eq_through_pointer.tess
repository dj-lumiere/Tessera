/// A collection's eq takes values; through a pointer, the load is written.
import Standard::Alloc
import Standard::Collections
import Standard::Os

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %set_val : Set<S64> = .construct(%alloc)
        claim %set : Ptr<Set<S64>>
        %set.store(%set_val)
        %same : Bool = %set.eq(%set)
        return(0)
