// A name between backticks holds any character but a backtick or a line break, and a keyword between backticks is a
// plain name. The symbol it gets is valid LLVM whatever it holds.

import Standard::Format

routine `Core.Character.eq(Core.Character)`(a: U32, b: U32) -> Bool
    block entry():
        same : Bool = a.eq(b)
        return(same)

routine `say "hi" \ é`() -> S64
    block entry():
        return(7)

routine `return`(x: S64) -> S64
    block entry():
        y : S64 = x.add(1)
        return(y)

routine main() -> S32
    block entry():
        e : Bool = `Core.Character.eq(Core.Character)`(65, 65)
        n : S64  = `say "hi" \ é`()
        r : S64  = `return`(41)
        print("{e} {n} {r}\n")
        return(0)
