routine one(out: @Out, a: U128, b: U128, c: U128) -> Void
    block entry()
        r : F128 = f128_of(a).mul_add(f128_of(b), f128_of(c))
        r.bits().represent_hex_into(out)
        out.write("\n")
        return()

routine mismatch(out: @Out, a: U128, b: U128, c: U128, got: U128, want: U128) -> Void
    block entry()
        out.write("a ")
        a.represent_hex_into(out)
        out.write(" b ")
        b.represent_hex_into(out)
        out.write(" c ")
        c.represent_hex_into(out)
        out.write(" got ")
        got.represent_hex_into(out)
        out.write(" want ")
        want.represent_hex_into(out)
        out.write("\n")
        return()

// Checks count triples against their expected bits, printing each mismatch, then the summary line.
routine check_group(out: @Out, name: Bytes, a: @U128, b: @U128, c: @U128, want: @U128,
    count: USize) -> Void
    shared bad : @U64 <- 0

    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.eq(count)
        branch done
            ? summary()
            : test(i)

    block test(i: USize)
        x   : U128 = a.stride(i).load()
        y   : U128 = b.stride(i).load()
        z   : U128 = c.stride(i).load()
        w   : U128 = want.stride(i).load()
        r   : F128 = f128_of(x).mul_add(f128_of(y), f128_of(z))
        got : U128 = r.bits()
        ok  : Bool = got.eq(w)
        branch ok
            ? loop(i.add(1))
            : fail(i, x, y, z, got, w)

    block fail(i: USize, x: U128, y: U128, z: U128, got: U128, w: U128)
        mismatch(out, x, y, z, got, w)
        bad.load().add(1).store_into(bad)
        jump loop(i.add(1))

    block summary()
        out.write("{name}: {count} cases, {bad.load()} mismatches\n")
        return()

