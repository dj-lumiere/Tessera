// Collections conform to Equal, so a collection of collections compares element by element.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine set_of(%alloc: @Allocator, %a: S64, %b: S64) -> Set<S64>
    block entry():
        %set_val : Set<S64> = .construct(%alloc)
        claim %set : @Set<S64> <- %set_val
        %set.add(%a)
        %set.add(%b)
        %result : Set<S64> = %set.load()
        return(%result)

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator <- %heap

        %left_val : List<Set<S64>> = .construct(%alloc)
        claim %left : @List<Set<S64>> <- %left_val
        %left.push(set_of(%alloc, 1, 2))
        %left.push(set_of(%alloc, 3, 4))

        %right_val : List<Set<S64>> = .construct(%alloc)
        claim %right : @List<Set<S64>> <- %right_val
        %right.push(set_of(%alloc, 2, 1))  // same elements, other insertion order
        %right.push(set_of(%alloc, 4, 3))
        print("sets in lists equal: {%left.load().eq(%right.load())}\n")

        %right.push(set_of(%alloc, 5, 6))
        print("after a push: {%left.load().eq(%right.load())}\n")

        %grid_a : Array<Array<S64, 2>, 2> = Array<Array<S64, 2>, 2> { Array<S64, 2> { 1, 2 },
                Array<S64, 2> { 3, 4 } }
        %grid_b : Array<Array<S64, 2>, 2> = Array<Array<S64, 2>, 2> { Array<S64, 2> { 1, 2 },
                Array<S64, 2> { 3, 5 } }
        print("grids equal: {%grid_a.eq(%grid_a)} {%grid_a.eq(%grid_b)}\n")
        return(0)
