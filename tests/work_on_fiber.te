# A piece of work on a fiber of a CoroutineManager of the program's own: retrieve() on the manager's thread runs its
# fibers until the work is done, then gives the result. Fibers switch stacks, which only the targets in
# work_on_fiber.arch do.

import Standard/Fiber
import Standard/Os

### Sums 1 to n.
### :param n: The last number.
### :returns: The sum.
routine sum_to(n: U64) -> U64
    each i in 1 to n with total: U64 = 0
        continue with total: total + i
    then
        return total

### Runs the work on a fiber.
routine start() -> None
    fibers: &CoroutineManager <- .construct(stack_size: 64kib, stack_manager: PAGES, manager: HEAP)
    f: Fiber[U64] <- fibers.get_fiber[U64]()
    on_fiber: Work[U64] = sum_to.to[Work](n: 4)
    f.put_work(steal on_fiber)
    Console.show("{f.retrieve()}")
    drop f
    return
