# A choice that doesn't write its underlying type is an S32, as C's int: four bytes, and its members count from 0.

import Standard/Hosted

### A traffic light's colors.
choice Light
    RED
    AMBER
    GREEN

### A choice that names its type.
choice Small: U8
    ONE
    TWO

routine start() -> None
    green: Light = Light.GREEN
    Console.show("size {sizeof[Light]()}, small {sizeof[Small]()}, green {green}")
    return
