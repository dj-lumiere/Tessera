# Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
# {key: value} for maps. A PriorityQueue writes its heap array, the top first, as [priority: element].

import Standard/Collections
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local list: @List[@[Byte]] <- .construct(alloc)

    list.add_last("a")
    list.add_last("b\n")
    Console.show("{list} ", end: "")
    list.diagnose_into(Console.output())
    Console.show("")

    local empty: @List[S64] <- .construct(alloc)
    Console.show("{empty} ", end: "")
    empty.diagnose_into(Console.output())
    Console.show("")
    drop empty

    local sorted: @SortedList[S64] <- .construct(alloc)
    sorted.add(3)
    sorted.add(1)
    sorted.add(2)
    Console.show("{sorted}")

    local ring: @CircularList[Char] <- .construct(alloc)
    ring.add_last('b')
    ring.add_first('a')
    Console.show("{ring} ", end: "")
    ring.diagnose_into(Console.output())
    Console.show("")

    local set: @Set[S64] <- .construct(alloc)
    set.add(7)
    set.add(5)
    Console.show("{set}")

    local tree: @SortedSet[@[Byte]] <- .construct(alloc)
    tree.add("pear")
    tree.add("apple")
    Console.show("{tree} ", end: "")
    tree.diagnose_into(Console.output())
    Console.show("")

    local map: @Dict[@[Byte], S64] <- .construct(alloc)
    map["one"] = 1
    map["two"] = 2
    Console.show("{map} ", end: "")
    map.diagnose_into(Console.output())
    Console.show("")

    local index: @SortedDict[S64, Maybe[S64]] <- .construct(alloc)
    index[2] = None()
    index[1] = 10
    index.diagnose_into(Console.output())
    Console.show("")

    local queue: @PriorityQueue[S64, @[Byte]] <- .construct(alloc)
    queue.add(priority: 2, element: "b")
    queue.add(priority: 1, element: "a")
    Console.show("{queue}")
    queue.diagnose_into(Console.output())
    Console.show("")

    drop list
    drop sorted
    drop ring
    drop set
    drop tree
    drop map
    drop index
    drop queue
    return
