# Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
# {key: value} for maps. A PriorityQueue writes its heap array, the top first, as [priority: element].

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local list: @List[@[Byte]] <- .construct(alloc)

    list.add_last("a")
    list.add_last("b\n")
    Out.write("{list} ")
    list.diagnose_into(Out.writer())
    Out.write("\n")

    local empty: @List[S64] <- .construct(alloc)
    Out.write("{empty} ")
    empty.diagnose_into(Out.writer())
    Out.write("\n")
    drop empty

    local sorted: @SortedList[S64] <- .construct(alloc)
    sorted.add(3)
    sorted.add(1)
    sorted.add(2)
    Out.write("{sorted}\n")

    local ring: @CircularList[Char] <- .construct(alloc)
    ring.add_last('b')
    ring.add_first('a')
    Out.write("{ring} ")
    ring.diagnose_into(Out.writer())
    Out.write("\n")

    local set: @Set[S64] <- .construct(alloc)
    set.add(7)
    set.add(5)
    Out.write("{set}\n")

    local tree: @SortedSet[@[Byte]] <- .construct(alloc)
    tree.add("pear")
    tree.add("apple")
    Out.write("{tree} ")
    tree.diagnose_into(Out.writer())
    Out.write("\n")

    local map: @Dict[@[Byte], S64] <- .construct(alloc)
    map["one"] = 1
    map["two"] = 2
    Out.write("{map} ")
    map.diagnose_into(Out.writer())
    Out.write("\n")

    local index: @SortedDict[S64, Maybe[S64]] <- .construct(alloc)
    index[2] = None()
    index[1] = 10
    index.diagnose_into(Out.writer())
    Out.write("\n")

    local queue: @PriorityQueue[S64, @[Byte]] <- .construct(alloc)
    queue.add(priority: 2, element: "b")
    queue.add(priority: 1, element: "a")
    Out.write("{queue}\n")
    queue.diagnose_into(Out.writer())
    Out.write("\n")

    drop list
    drop sorted
    drop ring
    drop set
    drop tree
    drop map
    drop index
    drop queue
    return
