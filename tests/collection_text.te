# Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
# {key: value} for maps. A PriorityQueue writes its [priority: element] pairs in the order they come out.

import Collections
import Hosted

routine start() -> None
    manager: @MemoryManager = HEAP
    list: &List[@[Byte]] <- .construct(manager)

    list.add_last("a")
    list.add_last("b\n")
    Console.show("{list} ", end: "")
    list.diagnose_into(Console.output())
    Console.show("")

    empty: &List[S64] <- .construct(manager)
    Console.show("{empty} ", end: "")
    empty.diagnose_into(Console.output())
    Console.show("")
    drop empty

    sorted: &SortedList[S64] <- .construct(manager)
    sorted.add(3)
    sorted.add(1)
    sorted.add(2)
    Console.show("{sorted}")

    ring: &RotatableList[Char] <- .construct(manager)
    ring.add_last('b')
    ring.add_first('a')
    Console.show("{ring} ", end: "")
    ring.diagnose_into(Console.output())
    Console.show("")

    set: &Set[S64] <- .construct(manager)
    set.add(7)
    set.add(5)
    Console.show("{set}")

    tree: &SortedSet[@[Byte]] <- .construct(manager)
    tree.add("pear")
    tree.add("apple")
    Console.show("{tree} ", end: "")
    tree.diagnose_into(Console.output())
    Console.show("")

    map: &Dict[@[Byte], S64] <- .construct(manager)
    map["one"] = 1
    map["two"] = 2
    Console.show("{map} ", end: "")
    map.diagnose_into(Console.output())
    Console.show("")

    index: &SortedDict[S64, Maybe[S64]] <- .construct(manager)
    index[2] = None()
    index[1] = 10
    index.diagnose_into(Console.output())
    Console.show("")

    queue: &PriorityQueue[S64, @[Byte]] <- .construct(manager)
    queue.add(priority: 2, element: "b")
    queue.add(priority: 1, element: "a")
    Console.show("{queue}")
    queue.diagnose_into(Console.output())
    Console.show("")

    drop list
    drop sorted
    drop ring
    drop set
    drop tree
    drop map
    drop index
    drop queue
    return
