# A variant branch Counter? keeps the counter in a place from a manager, as an entity branch does: the value lives in a
# place and the arm that takes it ends it.
import Hosted

### A counter.
entity Counter
    n: S64

### Closed.
record Closed
    nothing

### A slot that is closed, or open with a counter or none yet.
variant Slot
    Counter?
    Closed

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### Says which counter ends.
routine @Counter.destruct() -> None
    Console.show("end {me.n.peek()}")
    return

### An open slot with a counter.
### :param n: The count.
### :returns: The slot.
routine open_slot(n: S64) -> Slot
    counter: &Counter <- Counter.construct(n) from HEAP
    return counter

### Shows what a slot holds and ends it.
### :param slot: The slot.
routine show(slot: Slot) -> None
    when steal slot
        is Counter? as kept =>
            when kept
                is Counter as c => Console.show("open {c.n.peek()}")
                is None => Console.show("open, none")
            drop kept
        is Closed => Console.show("closed")
    return

routine start() -> None
    opened: &Slot <- open_slot(4)
    show(steal opened)
    closed: &Slot <- Closed()
    show(steal closed)
    return
