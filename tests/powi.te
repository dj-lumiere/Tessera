# powi, correctly rounded for every type: x^n rounded once. B64 and B128 call powf with n converted (exact). B32
# does the same for |n| <= 2^24 and goes through the B64 power beyond. B16 and BF16 go through the B64 power. At a
# narrow midpoint the B128 power decides (exhaustively checked: x^n is then exact and ties to even, or, for 53 B32
# pairs, at least 2^-61 away from the midpoint). Expected bits are x^n from exact rationals or mpmath, rounded once.

import Hosted

routine start() -> None
    b64_power_1: B64 = B64.from_bits(0x3FF8000000000000).powi_unchecked(-3)
    Console.show("B64.from_bits(0x3FF8000000000000).powi(-3) {b64_power_1.bits()}")
    b64_power_2: B64 = B64.from_bits(0x4008000000000000).powi_unchecked(40)
    Console.show("B64.from_bits(0x4008000000000000).powi(40) {b64_power_2.bits()}")
    b64_power_3: B64 = B64.from_bits(0x3FF0000000000001).powi_unchecked(2147483647)
