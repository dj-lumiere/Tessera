# Console.ask_line() crashes at the end of the input with AbsentValueError, at the line of the call. A blank line is ""
# and not the end. Standard input is "one\n\n". read_line_checked() is the form for reading to the end. This handler
# prints the crash and exits with status 3.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    local line: @Memory[Byte] <- Console.ask_line()

    Crash.report_with(on_crash.to[Callable]())
    Console.show("[{line.getview()}]")
    drop line
    local blank: @Memory[Byte] <- Console.ask_line()
    Console.show("[{blank.getview()}] count {blank.count()}")
    drop blank
    local past: @Memory[Byte] <- Console.ask_line()
    Console.show("not reached [{past.getview()}]")
    drop past
    return
