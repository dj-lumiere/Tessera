# Console.ask_line(HEAP) stops the program at the end of the input with EndOfInputError, at the line of the call. A blank
# line is "" and not the end. Standard input is "one\n\n". `try Console.ask_line(HEAP)` is the form for reading to the
# end. This handler prints the crash and exits with status 3.

import Standard/Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    line: &[Byte] <- Console.ask_line(HEAP)

    Crash.report_with(on_crash.to[Callable]())
    Console.show("[{line.getslice()}]")
    drop line
    blank: &[Byte] <- Console.ask_line(HEAP)
    Console.show("[{blank.getslice()}] count {blank.count()}")
    drop blank
    past: &[Byte] <- Console.ask_line(HEAP)
    Console.show("not reached [{past.getslice()}]")
    drop past
    return
