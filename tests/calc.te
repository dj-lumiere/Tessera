# Integer expression calculator
#
# Parses and evaluates integer expressions such as "-(4 - 10) % 4":
#
#     expr    = term    (("+" | "-") term)*
#     term    = primary (("*" | "/" | "%") primary)*
#     primary = number | "(" expr ")" | "-" primary
#
# The parser builds a heap-allocated tree, the evaluator walks it with
# overflow-checked S64 arithmetic, and every error (bad token, missing ")",
# division by zero, overflow) is reported with its column.
#
# What this program stresses:
#   * sum types: Expr is a tag plus every variant's fields. There is no
#     payload-carrying choice. Switches on the tag name every kind instead of
#     using '_', so adding a kind is a build error until each one handles it
#   * failures: CalcError is a crashable the failable routines throw, and a
#     caller passes one on by checking the call and naming only the value
#   * cleanup on failure paths: when the right operand fails to parse, the
#     already-built left subtree has to be freed by hand
#   * recursion: parse_binary, parse_primary, eval, and free_expr recurse

import Standard/Os

# ── C FFI ─────────────────────────────────────────────────────────────────────

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

# ── Tokens ────────────────────────────────────────────────────────────────────

choice TokenKind: U8
    NUMBER
    PLUS
    MINUS
    STAR
    SLASH
    PERCENT
    L_PAREN
    R_PAREN
    END
    INVALID

record Token
    kind: TokenKind
    value: S64  # Number only
    pos: U64  # byte offset of the first character
    end: U64  # byte offset just past the token

crashable CalcError
    message: @Byte
    pos: U64

### Writes the message and the column.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine CalcError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    text: @[Byte] = me.message.to[CStrView]().getview()
    out.write("{text} at column {me.pos + 1}")
    return

# ── Syntax tree ───────────────────────────────────────────────────────────────

choice ExprKind: U8
    NUM
    NEG
    ADD
    SUB
    MUL
    DIV
    REM

### A manual sum type: `kind` says which fields mean something.
###   Num                    value
###   Neg                    lhs (the operand)
###   Add Sub Mul Div Rem    lhs, rhs
### `pos` is the column of the number or operator, for error messages.
record Expr
    kind: ExprKind
    value: S64
    lhs: @Expr
    rhs: @Expr
    pos: U64

### Makes a `Expr` from its fields.
### :param kind: Its `kind`.
### :param value: Its `value`.
### :param lhs: Its `lhs`.
### :param rhs: Its `rhs`.
### :param pos: Its `pos`.
### :returns: The new value.
common routine Expr.construct(kind: ExprKind, value: S64, lhs: @Me, rhs: @Me, pos: U64) -> Me
    return Me(kind, value, lhs, rhs, pos)

### Releases nothing: a `Expr` holds no memory of its own.
routine @Expr.destruct() -> None
    return

routine new_expr(node: Expr, alloc: @MemoryManager) -> @Expr
    local p: @Expr = allocate[Expr](count: 1, alloc)

    if p.is_hollow()
        crash_allocation()
    else
        p.poke(node)
        return p

### Frees e and its whole subtree.
routine free_expr(e: @Expr, alloc: @MemoryManager) -> None
    kind: ExprKind = e.kind.peek()
    when kind
        ExprKind.NUM => pass
        ExprKind.NEG =>
            operand: @Expr = e.lhs.peek()
            free_expr(e: operand, alloc)
        ExprKind.ADD, ExprKind.SUB, ExprKind.MUL, ExprKind.DIV, ExprKind.REM =>
            lhs: @Expr = e.lhs.peek()
            rhs: @Expr = e.rhs.peek()
            free_expr(e: lhs, alloc)
            free_expr(e: rhs, alloc)
    deallocate(data: e, alloc)
    return

# ── Lexer ─────────────────────────────────────────────────────────────────────

record Parser
    src: @Byte
    len: U64
    pos: U64
    alloc: @MemoryManager

### Makes a `Parser` from its fields.
### :param src: Its `src`.
### :param len: Its `len`.
### :param pos: Its `pos`.
### :param alloc: Its `alloc`.
### :returns: The new value.
common routine Parser.construct(src: @Byte, len: U64, pos: U64, alloc: @MemoryManager) -> Me
    return Me(src, len, pos, alloc)

### Releases nothing: a `Parser` holds no memory of its own.
routine @Parser.destruct() -> None
    return

routine is_digit(c: Byte) -> Bool
    above: Bool = c >= b'0'
    below: Bool = c <= b'9'
    return above and below

### Reads the token at the current position without consuming it.
### Fails only on a number that doesn't fit in S64.
@generated
failable routine @Parser.peek() -> Token
    jump skip_space(me.pos.peek())

    block skip_space(i: U64)
        len: U64 = me.len.peek()
        if i >= len
            jump end_token(i)
        else
            jump check_space(i)

    block check_space(i: U64)
        src: @Byte = me.src.peek()
        c: Byte = src.stride(i).peek()
        if c == b' '
            jump skip_space(i + 1)
        else
            jump classify(i, c)

    block end_token(i: U64)
        tok: Token = Token(kind: TokenKind.END, value: 0, pos: i, end: i)
        return tok

    block classify(i: U64, c: Byte)
        if is_digit(c)
            jump digits(i, i, 0)
        else
            jump punct(i, c)

    block punct(i: U64, c: Byte)
        when c
            b'+' => jump single(i, TokenKind.PLUS)
            b'-' => jump single(i, TokenKind.MINUS)
            b'*' => jump single(i, TokenKind.STAR)
            b'/' => jump single(i, TokenKind.SLASH)
            b'%' => jump single(i, TokenKind.PERCENT)
            b'(' => jump single(i, TokenKind.L_PAREN)
            b')' => jump single(i, TokenKind.R_PAREN)
            else => jump single(i, TokenKind.INVALID)

    block single(i: U64, kind: TokenKind)
        end: U64 = i + 1
        tok: Token = Token(kind: kind, value: 0, pos: i, end: end)
        return tok

    # acc is the value of src[start..j) so far.
    block digits(start: U64, j: U64, acc: S64)
        len: U64 = me.len.peek()
        if j >= len
            jump number_done(start, j, acc)
        else
            jump check_digit(start, j, acc)

    block check_digit(start: U64, j: U64, acc: S64)
        src: @Byte = me.src.peek()
        c: Byte = src.stride(j).peek()
        if is_digit(c)
            jump scale(start, j, acc, c)
        else
            jump number_done(start, j, acc)

    block scale(start: U64, j: U64, acc: S64, c: Byte)
        scaled: Maybe[S64] = acc.mul_checked(10)
        times10: S64 = when scaled
            is S64 as times10 => times10
            is None => jump too_large(start)
        digit_code: U8 = c.to[U8]() - b'0'.to[U8]()
        digit: S64 = digit_code.to[S64]()
        sum: Maybe[S64] = times10.add_checked(digit)
        when sum
            is S64 as next => jump digits(start, j + 1, next)
            is None => jump too_large(start)

    block too_large(start: U64)
        e: CalcError = CalcError(message: "number too large", pos: start)
        throw e

    block number_done(start: U64, j: U64, acc: S64)
        tok: Token = Token(kind: TokenKind.NUMBER, value: acc, pos: start, end: j)
        return tok

routine @Parser.advance(tok: Token) -> None
    end: U64 = tok.end
    me.pos.poke(end)
    return

# ── Parser ────────────────────────────────────────────────────────────────────

### The binary operator kind stands for at precedence level
### (0: + -, 1: * / %), or None when it isn't one.
routine operator_at(kind: TokenKind, level: S64) -> Maybe[ExprKind]
    additive: Bool = level == 0
    op: ExprKind = when
        additive =>
            when kind
                TokenKind.PLUS =>
                    becomes ExprKind.ADD
                TokenKind.MINUS =>
                    becomes ExprKind.SUB
                else =>
                    r: Maybe[ExprKind] = None()
                    return r
        else =>
            when kind
                TokenKind.STAR =>
                    becomes ExprKind.MUL
                TokenKind.SLASH =>
                    becomes ExprKind.DIV
                TokenKind.PERCENT =>
                    becomes ExprKind.REM
                else =>
                    r: Maybe[ExprKind] = None()
                    return r
    r: Maybe[ExprKind] = op
    return r

### An operand of a level-level operator: the next level down, or a primary.
failable routine @Parser.parse_operand(level: S64) -> @Expr
    if level == 0
        return when check me.parse_binary(1)
            is @Expr as tree => tree
    return when check me.parse_primary()
        is @Expr as tree => tree

### operand (op operand)* at one precedence level, folded to the left.
failable routine @Parser.parse_binary(level: S64) -> @Expr
    lhs: @Expr = when check me.parse_operand(level)
        is @Expr as first => first
    while true with lhs2: @Expr = lhs
        peeked: Check[Token] = check me.peek()
        tok: Token = when peeked
            is Token as next => next
            is CalcError as error =>
                free_expr(e: lhs2, alloc: me.alloc.peek())
                throw error
        op: Maybe[ExprKind] = operator_at(kind: tok.kind, level)
        kind: ExprKind = when op
            is ExprKind as kind => kind
            is None => return lhs2
        me.advance(tok)
        rhs: Check[@Expr] = check me.parse_operand(level)
        when rhs
            is @Expr as right =>
                node: Expr = Expr(kind: kind, value: 0, lhs: lhs2, rhs: right, pos: tok.pos)
                continue with lhs2: new_expr(node, alloc: me.alloc.peek())
            is CalcError as error =>
                # The left side parsed but what follows didn't: free it before failing.
                free_expr(e: lhs2, alloc: me.alloc.peek())
                throw error

### A number, a parenthesized expression, or a negated primary.
failable routine @Parser.parse_primary() -> @Expr
    tok: Token = when check me.peek()
        is Token as next => next
    pos: U64 = tok.pos
    when tok.kind
        TokenKind.NUMBER =>
            me.advance(tok)
            node: Expr = Expr(kind: ExprKind.NUM, value: tok.value, lhs: .hollow(), rhs: .hollow(),
                pos: pos)
            return new_expr(node, alloc: me.alloc.peek())
        TokenKind.L_PAREN =>
            # "(" expr ")"
            me.advance(tok)
            tree: @Expr = when check me.parse_binary(0)
                is @Expr as inner => inner
            close: Check[Token] = check me.peek()
            error: CalcError = when close
                is Token as next =>
                    if next.kind == TokenKind.R_PAREN
                        me.advance(next)
                        return tree
                    becomes CalcError(message: "expected ')'", pos: next.pos)
                is CalcError as error => error
            free_expr(e: tree, alloc: me.alloc.peek())
            throw error
        TokenKind.MINUS =>
            me.advance(tok)
            operand: @Expr = when check me.parse_primary()
                is @Expr as inner => inner
            node: Expr = Expr(kind: ExprKind.NEG, value: 0, lhs: operand, rhs: .hollow(), pos: pos)
            return new_expr(node, alloc: me.alloc.peek())
        TokenKind.END => throw CalcError(message: "unexpected end of input", pos)
        TokenKind.INVALID => throw CalcError(message: "unexpected character", pos)
        else => throw CalcError(message: "expected a number or '('", pos)

### Parses all of source. Anything left after the expression is an error.
failable routine parse(source: @[Byte], alloc: @MemoryManager) -> @Expr
    local parser: @Parser <- Parser(src: source.data, len: source.count, pos: 0, alloc: alloc)

    tree: @Expr = when check parser.parse_binary(0)
        is @Expr as parsed => parsed
    peeked: Check[Token] = check parser.peek()
    # a lex error here is still "something after the expression"
    pos: U64 = when peeked
        is Token as tok =>
            if tok.kind == TokenKind.END
                return tree
            becomes tok.pos
        is CalcError as error => error.pos
    free_expr(e: tree, alloc)
    throw CalcError(message: "unexpected input after expression", pos)

# ── Evaluator ─────────────────────────────────────────────────────────────────

@generated
failable routine eval(e: @Expr) -> S64
    local kind: ExprKind = e.kind.peek()
    local pos: U64 = e.pos.peek()

    when kind
        ExprKind.NUM => jump number()
        ExprKind.NEG => jump negate()
        ExprKind.ADD, ExprKind.SUB, ExprKind.MUL, ExprKind.DIV, ExprKind.REM => jump binary()

    block number()
        value: S64 = e.value.peek()
        return value

    block negate()
        operand: @Expr = e.lhs.peek()
        x: S64 = when check eval(operand)
            is S64 as found => found
        jump checked(x.neg_checked())

    block binary()
        lhs: @Expr = e.lhs.peek()
        a: S64 = when check eval(lhs)
            is S64 as found => found
        rhs: @Expr = e.rhs.peek()
        b: S64 = when check eval(rhs)
            is S64 as found => found
        zero_divisor: Bool = b == 0
        when kind
            ExprKind.ADD => jump checked(a.add_checked(b))
            ExprKind.SUB => jump checked(a.sub_checked(b))
            ExprKind.MUL => jump checked(a.mul_checked(b))
            ExprKind.DIV => jump divide(a, b, zero_divisor)
            ExprKind.REM => jump remainder(a, b, zero_divisor)
            else => unreachable

    # only the five binary kinds reach binary()
    block divide(a: S64, b: S64, zero_divisor: Bool)
        quotient: Maybe[S64] = a.floordiv_checked(b)
        if zero_divisor
            jump division_by_zero()
        else
            jump checked(quotient)

    block remainder(a: S64, b: S64, zero_divisor: Bool)
        rest: Maybe[S64] = a.mod_checked(b)
        if zero_divisor
            jump division_by_zero()
        else
            jump checked(rest)

    # None from a checked operation with a nonzero divisor means overflow.
    block checked(result: Maybe[S64])
        when result
            is S64 as value => return value
            is None => throw CalcError(message: "overflow", pos: pos)

    block division_by_zero()
        throw CalcError(message: "division by zero", pos: pos)

# ── Driver ────────────────────────────────────────────────────────────────────

routine calculate(source: @[Byte], alloc: @MemoryManager) -> None
    src: @Byte = source.data
    c_printf("%-34s ", src)
    parsed: Check[@Expr] = check parse(source, alloc)
    error: CalcError = when parsed
        is @Expr as tree =>
            result: Check[S64] = check eval(tree)
            free_expr(e: tree, alloc)
            when result
                is S64 as value =>
                    c_printf("= %lld\n", value)
                    return
                is CalcError as error =>
                    becomes error
        is CalcError as error => error
    pos: U64 = error.pos
    message: @Byte = error.message
    c_printf("error at column %llu: %s\n", pos + 1, message)
    return

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()

    calculate(source: "1 + 2 * 3", alloc)
    calculate(source: "(1 + 2) * 3", alloc)
    calculate(source: "-(4 - 10) % 4", alloc)
    calculate(source: "2 * (3 + 4) * 5 - 100 / 7", alloc)
    calculate(source: "--7", alloc)
    calculate(source: "((((42))))", alloc)
    calculate(source: "9223372036854775807", alloc)

    calculate(source: "7 / (3 - 3)", alloc)
    calculate(source: "9223372036854775807 + 1", alloc)
    calculate(source: "-9223372036854775807 - 1 - 1", alloc)
    calculate(source: "99999999999999999999", alloc)
    calculate(source: "1 + * 2", alloc)
    calculate(source: "(1 + 2", alloc)
    calculate(source: "1 + 2)", alloc)
    calculate(source: "3 $ 4", alloc)
    calculate(source: "", alloc)
    return
