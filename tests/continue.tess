// A continue arm goes on with the next line of the same block, so a guard doesn't need a new block: the lines after
// it still see every value above.

import Standard::Format

routine sum_to(%n: U64) -> U64
    block entry():
        jump loop(0, 0)

    block loop(%i: U64, %acc: U64):
        %done : Bool = %i.ge(%n)
        branch %done ? return(%acc) : continue
        %next : U64 = %acc.add(%i)
        jump loop(%i.add(1), %next)

/// Guards stack: each one leaves or goes on.
routine classify(%n: S64) -> S64
    block entry():
        branch %n.lt(0) ? return(-1) : continue
        branch %n.eq(0) ? return(0) : continue
        %big : Bool = %n.gt(100)
        branch %big ? continue : return(1)
        %huge : Bool = %n.gt(10000)
        when:
            %huge -> return(3)
            _     -> continue
        return(2)

routine name_of(%tag: U8) -> S64
    block entry():
        when %tag:
            0    -> return(10)
            1, 2 -> continue
            _    -> return(99)
        %doubled : S64 = %tag.to_s64().mul(2)
        return(%doubled)

routine main() -> S32
    block entry():
        print("{sum_to(10)}\n")
        print("{classify(-5)} {classify(0)} {classify(7)} {classify(500)} {classify(50000)}\n")
        print("{name_of(0)} {name_of(1)} {name_of(2)} {name_of(9)}\n")
        return(0)
