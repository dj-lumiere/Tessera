# A stepped range whose next index would pass the end of its type stops there instead of wrapping (Rust #122420 in
# Tessera): 100 to 127 by 20 over S8 walks 100 and 120, and the same over the top of S64 walks twice.

import Standard/Os

### Counts the rounds of a few ranges at the top of their types.
routine start() -> None
    count: &U64 <- 0
    each i: S8 in 100 to 127 by 20
        (count.load() + 1).store_into(count)
    Console.show("S8 100 to 127 by 20: {count.load()}")
    0.store_into(count)
    each j: S8 in 100 til 127 by 20
        (count.load() + 1).store_into(count)
    Console.show("S8 100 til 127 by 20: {count.load()}")
    0.store_into(count)
    top: S64 = S64.MAX
    each k: S64 in top - 5 to top by 4
        (count.load() + 1).store_into(count)
    Console.show("S64 MAX-5 to MAX by 4: {count.load()}")
    0.store_into(count)
    each m: S8 in -100 to -128 by -20
        (count.load() + 1).store_into(count)
    Console.show("S8 -100 to -128 by -20: {count.load()}")
    0.store_into(count)
    each u: U8 in 200 to 255 by 50
        (count.load() + 1).store_into(count)
    Console.show("U8 200 to 255 by 50: {count.load()}")
    0.store_into(count)
    each n: S64 in 0 to 10 by 3
        (count.load() + 1).store_into(count)
    Console.show("S64 0 to 10 by 3: {count.load()}")
    return
