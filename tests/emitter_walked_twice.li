# A second for loop over an emitter the first one walked to its end runs zero times: a build error.

import Collections
import Hosted

routine start() -> None
    points: &List[S64] <- .construct(HEAP)
    points.add_last(1)
    walk: &ListEmitter[S64] <- points.emitter()
    for point in walk
        Console.show(point)
    for point in walk
        Console.show(point)
    return
