# A choice or variant without @derive derives Representable, Diagnosable, Equatable, Hashable, and Comparable:
# print, eq, compare, a Dict key, and a sort all work below. A variant's conformance holds only when its branches
# have the concept (Point derives only Representable, Diagnosable, and Equatable, so Label is Representable,
# Diagnosable, and Equatable but not Hashable or Comparable), a routine it declares itself replaces the derived one,
# and @derive() derives nothing.

import Standard/Collections
import Standard/Os

choice Color: U8
    RED
    GREEN
    BLUE

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Circle
    radius: S64

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Square
    side: S64

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Empty
    nothing

variant Shape
    Circle
    Square
    Empty

@derive(Representable, Diagnosable, Equatable)
record Point
    x: S64
    y: S64

variant Label
    Point
    None

### Its own eq: equal whatever it holds, so the derived one isn't made.
variant Loose
    S64
    None

@derive()
choice Silent: U8
    QUIET

routine Loose.eq(other: Me) -> Bool
    return true

routine start() -> None
    c: Color = Color.GREEN
    Console.show("{c}, eq {c.eq(Color.GREEN)}, compare {c.compare(Color.BLUE)}, hash {c.hash().eq(Color.GREEN.hash())}")

    s: Shape = Circle(radius: 3)
    t: Shape = Square(side: 2)
    e: Shape = Empty()
    Console.show("{s} vs {t}: eq {s.eq(t)}, compare {s.compare(t)}, {e.compare(t)}")

    l: Label = Point(x: 1, y: 2)
    none: Label = None()
    Console.show("label {l}, eq {l.eq(none)}")

    a: Loose = 1
    b: Loose = None()
    Console.show("loose eq {a.eq(b)}")

    manager: @MemoryManager = HEAP
    local counts: @Dict[Color, S64] <- .construct(manager)
    counts[Color.BLUE] = 2
    counts[Color.RED] = 1
    Console.show("counts {counts}")
    drop counts

    local shapes: @List[Shape] <- .construct(manager)
    shapes.add_last(Square(side: 1))
    shapes.add_last(Empty())
    shapes.add_last(Circle(radius: 9))
    shapes.add_last(Circle(radius: 4))
    shapes.sort()
    Console.show("sorted {shapes}")
    drop shapes
    return
