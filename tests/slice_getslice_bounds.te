# @[T].getslice checks the whole range: a view that would run one past the end crashes with
# IndexOutOfBoundsError, while one that ends exactly at the end (even an empty one) is fine.

import Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    text: @[Byte] = "span"
    view: @[Byte] = text.getview()
    tail: @[Byte] = view.getslice(start: 2, count: 2)
    none: @[Byte] = view.getslice(start: 4, count: 0)
    Console.show("tail {tail.count()}, none {none.count()}")
    past: @[Byte] = view.getslice(start: 3, count: 2)
    Console.show("not reached {past.count()}")
    return
