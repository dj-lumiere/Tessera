# A pointer isn't Representable: `{sum}` on a slot would print where the sum is, not the sum, so the build asks
# for {sum.peek()} or {sum.to[Addr]()}.

import Standard/Os

routine start() -> None
    local sum: @S64 <- 0

    (sum.peek() + 5).poke_into(sum)
    Console.show("total: {sum}")
    return
