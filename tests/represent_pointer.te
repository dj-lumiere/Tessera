# A pointer isn't Representable: `{view}` on a @S64 would print where the sum is, not the sum, so the build asks
# for {view.peek()} or {view.to[Addr]()}. A &S64 box shows the value it holds.

import Standard/Os

routine start() -> None
    sum: &S64 <- 0

    (sum.load() + 5).poke_into(sum)
    Console.show("box: {sum}")
    view: @S64 = sum.getview()
    Console.show("total: {view}")
    return
