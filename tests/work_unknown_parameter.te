# Each argument of to[Work] names a parameter of the routine.

import Standard/Os

### Sums 1 to n.
### :param n: The last number.
### :returns: The sum.
routine sum_to(n: U64) -> U64
    return n * (n + 1) // 2

routine start() -> None
    work: Work[U64] <- sum_to.to[Work](m: 10)
    drop work
    return
