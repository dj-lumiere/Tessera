# stride moves a @T by whole Ts, where offset counts bytes.
import Standard/Hosted

routine start() -> None
    buf: &Array[S32, 4] <- [10, 20, 30, 40]
    first: @S32 = buf.to[@S32]()
    third: @S32 = first.stride(2)
    back: @S32 = third.stride(-1)

    if third === first.offset(8)
        a: S32 = third.peek()
        b: S32 = back.peek()
        r: S32 = a + b
        set_exit_code(r)
        return
    else
        set_exit_code(1)
        return
