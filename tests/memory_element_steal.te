# The place of an element of a Memory, m.getslot(i), is a slot the memory keeps: stealing out of it is a build error,
# and the value comes out with m[i].take().

import Standard/Collections
import Standard/Os

routine start() -> None
    local lists: @Memory[List[S64]] <- Memory[List[S64]].construct(count: 1, manager: HEAP)

    lists.getview(0).poke(List[S64].construct(HEAP))
    local first: @List[S64] <- steal lists.getslot(0)
    drop first
    drop lists
    return
