// push, the trapping form of push_result, panics when the allocator fails: stdout keeps what came before, and the
// exit status is 101.

import Standard::Alloc
import Standard::Collections
import Standard::Format

routine refuse_alloc(state: Addr, size: USize) -> Addr
    block entry():
        return(null)

routine refuse_realloc(state: Addr, old: Addr, size: USize) -> Addr
    block entry():
        return(null)

routine ignore_free(state: Addr, ptr: Addr) -> Void
    block entry():
        return()

routine main() -> S32
    block entry():
        refusing : Allocator = Allocator { alloc_fn: refuse_alloc.to<Callable>(),
                realloc_fn: refuse_realloc.to<Callable>(), free_fn: ignore_free.to<Callable>(),
                state: null }
        claim alloc : @Allocator <- refusing
        claim list  : @List<S64> <- .construct(alloc)
        pushed : Result<Unit, AllocFailed> = list.push_result(1)
        print("push_result: {pushed}\n")
        list.push(1)
        print("not reached\n")
        return(0)
