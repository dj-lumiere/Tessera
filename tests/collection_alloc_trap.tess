// push, the crashing form of push_result, crashes when the allocator fails: stdout keeps what came before, and the
// exit status is 101.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine refuse_alloc(state: Addr, size: USize, align: USize) -> Addr
    block entry()
        return(null)

routine refuse_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    block entry()
        return(null)

routine ignore_free(state: Addr, ptr: Addr) -> Void
    block entry()
        return()

routine start() -> Void
    block entry()
        refusing: MemoryManager = MemoryManager(alloc_fn: refuse_alloc.to[Callable](),
            realloc_fn: refuse_realloc.to[Callable](), free_fn: ignore_free.to[Callable](),
            reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: null)
        claim alloc: @MemoryManager <- refusing
        claim list: @List[S64] <- .construct(alloc)
        pushed: Result[Unit, AllocFailed] = list.add_last_result(1)
        Out.write("push_result: {pushed}\n")
        list.add_last(1)
        Out.write("not reached\n")
        return()
