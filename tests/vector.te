# Vector[T, N]: lane-wise arithmetic, compares into a mask, select, reductions, and memory. Integer lanes keep the
# scalar rules (add crashes on overflow, _wrap and _clamp don't, and a shift by the lane width shifts everything out),
# and float min and max return the other lane when one is NaN.

import Standard/Format
import Standard/Os

routine show_b32(label: @[Byte], v: Vector[B32, 4]) -> None
    Console.show("{label} {v.getitem(0)} {v.getitem(1)} {v.getitem(2)} {v.getitem(3)}")
    return

routine show_s32(label: @[Byte], v: Vector[S32, 4]) -> None
    Console.show("{label} {v.getitem(0)} {v.getitem(1)} {v.getitem(2)} {v.getitem(3)}")
    return

routine show_mask(label: @[Byte], m: Vector[Bool, 4]) -> None
    Console.show("{label} {m.getitem(0)} {m.getitem(1)} {m.getitem(2)} {m.getitem(3)}")
    return

routine start() -> None
    a: Vector[B32, 4] = [1.5, -2.0, 4.0, 9.0]
    b: Vector[B32, 4] = .splat(2.0)
    show_b32(label: "add", v: a + b)
    show_b32(label: "sub", v: a - b)
    show_b32(label: "mul", v: a * b)
    show_b32(label: "div", v: a / b)
    show_b32(label: "neg", v: -a)
    show_b32(label: "abs", v: a.abs())
    show_b32(label: "sqrt", v: a.abs().sqrt())
    nan: B32 = B32.NAN
    with: Vector[B32, 4] = a.with(index: 1, x: nan)
    show_b32(label: "min", v: with.min(b))
    show_b32(label: "max", v: with.max(b))
    Console.show("sum {a.sum()} min {a.reduce_min()} max {a.reduce_max()}")

    lt: Vector[Bool, 4] = a < b
    show_mask(label: "lt", m: lt)
    Console.show("all {lt.is_all_true()} any {lt.is_any_true()} none {lt.is_none_true()} count {lt.count_true()}")
    show_b32(label: "select", v: lt.select(if_true: a, if_false: b))

    i: Vector[S32, 4] = [1, -8, 2147483647, 40]
    one: Vector[S32, 4] = .splat(1)
    show_s32(label: "add_wrap", v: i +% one)
    show_s32(label: "add_clamp", v: i +^ one)
    show_s32(label: "mul_wrap", v: i *% (one + one))
    shift: Vector[S32, 4] = [1, 2, 32, -1]
    show_s32(label: "shl", v: i << shift)
    show_s32(label: "shr", v: i >> shift)
    show_s32(label: "bitand", v: i & Vector[S32, 4].splat(15))
    show_s32(label: "bitnot", v: ~i)
    show_s32(label: "min", v: i.min(one))
    show_mask(label: "ge", m: i >= one)

    u: Vector[U8, 4] = [250, 1, 2, 3]
    u_sum: Vector[U8, 4] = u +^ Vector[U8, 4].splat(10)
    Console.show("u8 clamp {u_sum.getitem(0)} {u_sum.getitem(1)} min {u.reduce_min()} max {u.reduce_max()}")

    local buf: @Array[S64, 6] <- [10, 20, 30, 40, 50, 60]
    first: @S64 = buf.getslot(1)
    mid: Vector[S64, 4] = .peek_at(first)
    twice: Vector[S64, 4] = mid + mid
    twice.poke_at(first)
    Console.show("memory {buf.getitem(0)} {buf.getitem(1)} {buf.getitem(4)} {buf.getitem(5)} sum {mid.sum()}")

    local slot: @Array[S32, 4] <- i.to[Array[S32, 4]]()
    Console.show("to<Array> {slot.getitem(2)} length {Vector[S32, 4].count()}")
    Console.show("sizes {sizeof[Vector[B32, 3]]()} {sizeof[Vector[Bool, 8]]()} {sizeof[Vector[S64, 2]]()}")
    return
