# me isn't written among a routine's parameters: the header says how the routine takes it.

record Point
    x: S64

### Makes a `Point` from its fields.
### :param x: Its `x`.
### :returns: The new value.
common routine Point.construct(x: S64) -> Me
    return Me(x)

### Releases nothing: a `Point` holds no memory of its own.
routine @Point.destruct() -> None
    return

routine Point.scaled(by: S64, me: Me) -> Me
    return Me(x: me.x * by)

routine start() -> None
    p: Point = Point(x: 1).scaled(2)
    return
