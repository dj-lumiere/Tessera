# Work put on a ticket again may throw only what the first work's routine can: the ticket's type took that list, and
# its retrieve() throws only it. Work whose routine throws more is a build error that names both routines.

import Hosted

crashable BadInputError
    value: S64

crashable TooLargeError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine TooLargeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.value} is too large")
    return

### n, failing for a negative n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    return n

### n, failing for a large n.
### :param n: The number.
### :returns: It.
routine small(n: S64) -> S64
    if n > 100
        throw TooLargeError(value: n)
    return n

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(checked.to[Work](n: 1))
    first: S64? = try t.retrieve()
    t.put_work(small.to[Work](n: 1000))
    second: S64? = try t.retrieve()
    Console.show("{first} {second}")
    drop t
    return
