// A record with one field lowers to that field's type: same size and alignment, and it passes, stores, and reads
// like the field. #aggregate keeps it a one-member struct.

import Standard::Os

record Meters
    value : F64

record Wrapped
    inner : Meters

#aggregate
record Boxed
    value : F64

routine double(m: Meters) -> Meters
    block entry()
        v : F64    = m.value
        r : Meters = Meters { value: v.mul(2.0) }
        return(r)

routine start() -> Void
    block entry()
        m : Meters = Meters { value: 1.5 }
        d : Meters = double(m)
        claim slot : @Wrapped <- uninit
        slot.inner.store(d)
        w          : Wrapped = slot.load()
        inner      : Meters  = w.inner
        same_size  : Bool    = sizeof<Wrapped>().eq(sizeof<F64>())
        same_align : Bool    = alignof<Boxed>().eq(alignof<F64>())
        three      : Bool    = inner.value.eq(3.0)
        ok         : Bool    = same_size.bitand(same_align).bitand(three)
        branch ok
            ? return()
            : failed()

    block failed()
        set_exit_code(1)
        return()
