// No overload of eq has the signature Equal wants, so the conformance doesn't hold; the error lists each one.

record Money
conform Equal<Money>
    cents : S64

routine Money.eq(self: Self, cents: S64) -> Bool
    block entry()
        return(self.cents.eq(cents))

routine Money.eq(self: Self, cents: S32) -> Bool
    block entry()
        return(false)

routine main() -> S32
    block entry()
        return(0)
