// No overload of eq has the signature Equatable wants, so the conformance doesn't hold. The error lists each one.

record Money
conform Equatable[Money]
    cents: S64

/// Makes a `Money` from its fields.
/// :param cents: Its `cents`.
/// :returns: The new value.
routine Money.construct(cents: S64) -> Me
    return(Me(cents))

/// Releases nothing: a `Money` holds no memory of its own.
routine Money.destruct(me: @Me) -> Void
    return()

routine Money.eq(me: Me, cents: S64) -> Bool
    return(me.cents.eq(cents))

routine Money.eq(me: Me, cents: S32) -> Bool
    return(false)

routine start() -> Void
    return()
