/// A method's own type parameter stands next to its record's: `Box[T].replaced[TOther]` keeps the record's `T` for
/// `me` and binds `TOther` from the call, and a method called on a box of a box binds `T` at the right level.
import Standard/Format
import Standard/Os

/// A single value.
record Box[T]
needs T: typename
    value: T

/// Makes a `Box` from its fields.
/// :param value: Its `value`.
/// :returns: The new value.
routine Box[T].construct(value: T) -> Me
needs T: typename
    return Me(value)

/// Releases nothing: a `Box` holds no memory of its own.
routine Box[T].destruct(me: @Me) -> None
needs T: typename
    return

/// Returns a box holding something else.
/// :param v: The new value.
/// :returns: A box of the new value's type.
routine Box[T].replaced[TOther](me: Me, v: TOther) -> Box[TOther]
needs TOther: typename
    return Box[TOther](value: v)

/// Returns the value inside.
/// :returns: The value.
routine Box[T].get(me: Me) -> T
    return me.value

/// Shows both levels binding their own parameter.
routine start() -> None
    b: Box[S64] = Box[S64](value: 5)
    t: Box[Span[Byte]] = b.replaced[Span[Byte]]("five")
    bb: Box[Box[S64]] = Box[Box[S64]](value: b)
    inner: Box[S64] = bb.get()
    Out.write("{b.get()} {t.get()} {inner.get()}\n")
    return
