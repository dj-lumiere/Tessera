# An element's access waits while another flow holds the access of the run around it: the thread sees the
# value written before the run's access is given back.

import Standard/Os

### Reads one value of the run under its own access, which waits while another flow holds the run's.
### :param numbers: The run.
### :returns: The value at 2.
routine read_third(numbers: @[S64]) -> S64
    one: ReadAuthorized[S64] <- numbers.getslot(2).get_shared_read_access()
    value: S64 = one.getview().peek()
    drop one
    return value

### Holds the run's exclusive access while a thread asks for one of its values, then changes it and gives the access
### back: the thread sees the new value.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3, 4] * 1 from HEAP
    whole: AuthorizedSlice[S64] <- numbers.get_exclusive_access()
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = read_third.to[Work](numbers: numbers.getslice())
    t.put_work(steal work)
    waitfor(Duration.from_milliseconds(50))
    whole.getview().getslot(2).poke(30)
    drop whole
    Console.show("{t.retrieve()}")
    drop t
    drop numbers
    return
