# `for x in xs.emitter()` walks the emitter a call hands out: the builder keeps it in a STACK place for the loop, so
# the line needs no name for it. Each loop makes a new emitter, so the inner loop walks the whole list every round.

import Collections
import Hosted

### Walks a list, a set and a dict through the emitters their calls hand out.
routine start() -> None
    xs: &List[S64] <- .construct(HEAP)
    xs.add_last(3)
    xs.add_last(1)
    xs.add_last(4)
    total: &S64 <- 0
    for x in xs.emitter()
        (total.load() + x).store_into(total)
    Console.show("sum: {total.load()}")

    0.store_into(total)
    for x in xs.emitter()
        if x == 4
            break
        (total.load() + x).store_into(total)
    Console.show("before 4: {total.load()}")

    pairs: &S64 <- 0
    for a in xs.emitter()
        for b in xs.emitter()
            if a < b
                (pairs.load() + 1).store_into(pairs)
    Console.show("pairs a < b: {pairs.load()}")

    seen: &Set[S64] <- .construct(HEAP)
    for x in xs.emitter()
        seen.add(x * 10)
    0.store_into(total)
    for s in seen.emitter()
        (total.load() + s).store_into(total)
    Console.show("set sum: {total.load()}")

    squares: &Dict[S64, S64] <- .construct(HEAP)
    for x in xs.emitter()
        squares.setitem(x, x * x)
    0.store_into(total)
    for entry in squares.emitter()
        (total.load() + entry.key + entry.value).store_into(total)
    Console.show("dict keys and values: {total.load()}")

    drop squares
    drop seen
    drop xs
    return
