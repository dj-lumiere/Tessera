# A crash 42 frames deep: the trace keeps the innermost TRACE_CAPACITY (32) of them, and trace_depth still says how
# deep the program was. The crash handler writes them in the default handler's shape, on stdout.

import Hosted

### The recursion reached its bottom.
crashable DepthReachedError
    nothing

### Writes `The recursion reached the bottom.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine DepthReachedError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The recursion reached the bottom.")
    return

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Writes the trace as the default handler does, then exits with status 3.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    depth: U64 = trace_depth()
    shown: U64 = depth.min(TRACE_CAPACITY)

    Console.show("{name}: {message.text()}\nStack trace:")

    for back in 0 til shown
        at: TraceFrame = trace_frame(back)
        label: @[Byte] = at.name.getview()
        file: @[Byte] = at.file.getview()
        line: U32 = at.line
        column: U32 = at.column
        Console.show("  {back}: at {label} ({file}:{line}:{column})")
    Console.show("  ... ({depth} frames total)")
    exit(3)

### Recurses n more times, then crashes.
routine descend(n: U32) -> U32
    if n == 0
        throw DepthReachedError()
    else
        return descend(n - 1)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    reached: U32 = descend(40)
    set_exit_code(reached.to[S32]())
    return
