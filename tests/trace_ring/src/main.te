# A crash 42 frames deep: the trace keeps the innermost TRACE_CAPACITY (32) of them, and trace_depth still says how
# deep the program was. The crash handler writes them in the default handler's shape, on stdout.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Writes the trace as the default handler does, then exits with status 3.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    local depth: U64 = trace_depth()
    local shown: U64 = depth.min(TRACE_CAPACITY)

    Console.show("{name}: {message}\nStack trace:")

    each back in 0 til shown
        at: TraceFrame = trace_frame(back)
        label: @[Byte] = at.name.getview()
        file: @[Byte] = at.file.getview()
        line: U32 = at.line
        column: U32 = at.column
        Console.show("  {back}: at {label} ({file}:{line}:{column})")
    Console.show("  ... ({depth} frames total)")
    exit(3)

### Recurses n more times, then crashes.
routine descend(n: U32) -> U32
    if n == 0
        crash(name: "DepthReachedError", message: "The recursion reached the bottom.")
    else
        return descend(n - 1)

routine start() -> None
    reached: U32 = descend(40)
    set_exit_code(reached.to[S32]())
    return
