# Work handed an entity runs once on one ticket: after t.put_work(steal work), putting the same work on a second ticket
# is a build error that names the argument.

import Standard/Hosted

### A value with nothing in it but its number.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Token) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

routine start() -> None
    a: &Token <- Token.construct(1)
    t: Thread[S64] <- get_thread[S64]()
    u: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = look.to[Work](item: steal a)
    t.put_work(steal work)
    u.put_work(steal work)
    Console.show("{t.retrieve()} {u.retrieve()}")
    drop u
    drop t
    return
