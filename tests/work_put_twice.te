# A piece of work runs once on one ticket: after t.put_work(steal work), putting the same work on a second ticket is a
# build error.

import Standard/Os

routine seven() -> S64
    return 7

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    u: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = seven.to[Work]()
    t.put_work(steal work)
    u.put_work(steal work)
    Console.show("{t.retrieve()} {u.retrieve()}")
    drop u
    drop t
    return
