# A routine on a type takes me without writing it: `routine Counter.get()` takes it as a value, `routine @Counter.bump()`
# by its address, and `common routine Counter.zero()` takes none and is called on the type. A call through a pointer
# finds `routine @Counter.peek` before `routine Ptr[T].peek`, the more specific receiver.

import Standard/Os

record Counter
    n: S64

common routine Counter.zero() -> Me
    return Me(n: 0)

routine Counter.get() -> S64
    return me.n

routine @Counter.bump(by: S64) -> None
    me.n.poke(me.n.peek() + by)
    return

routine @Counter.peek() -> S64
    return me.n.peek() * 100

routine start() -> None
    c: &Counter <- Counter.zero()

    c.bump(by: 3)
    c.bump(by: 4)
    Console.show("{c.load()} {Counter.zero().get()}")
    return
