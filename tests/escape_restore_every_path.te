# A routine keeps its parameter's address in a global and puts the old one back on every path: an Addr, which the
# build follows no lifetime through.

import Hosted

global CURRENT: &Addr

### Runs with p as the current value.
### :param p: The value.
### :param flag: Which way it goes.
routine run(p: @S64, flag: Bool) -> None
    outer: Addr = CURRENT.peek()
    CURRENT.poke(p.to[Addr]())
    if flag
        CURRENT.poke(outer)
        return
    CURRENT.poke(outer)
    return

### Runs with a local.
routine fill() -> None
    l: &S64 <- 5

    run(p: l, flag: false)
    return

routine start() -> None
    fill()
    Console.show("done")
    return
