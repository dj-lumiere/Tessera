# A routine keeps its parameter in a global and puts the old value back on every path.

import Standard/Hosted

global CURRENT: &@S64 <- .hollow()

### Runs with p as the current value.
### :param p: The value.
### :param flag: Which way it goes.
routine run(p: @S64, flag: Bool) -> None
    outer: @S64 = CURRENT.peek()
    CURRENT.poke(p)
    if flag
        CURRENT.poke(outer)
        return
    CURRENT.poke(outer)
    return

### Runs with a local.
routine fill() -> None
    l: &S64 <- 5

    run(p: l, flag: false)
    return

routine start() -> None
    fill()
    Console.show("done")
    return
