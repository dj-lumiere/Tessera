# A STACK place handed over with steal and filled again with poke holds a value again, which the builder gives back
# at the end of its body (Rust #42903 / #73137 in Tessera: each value ends once).

import Hosted

global ENDED: &S64 <- 0

### Counts its end.
entity Tag
    n: S64

### A tag.
### :param n: Its number.
### :returns: The tag.
common routine Tag.construct(n: S64) -> Me
    return Me(n: n)

### Counts one end.
routine @Tag.destruct() -> None
    Console.show("end {me.n.peek()}")
    (ENDED.peek() + 1).poke_into(ENDED)
    return

### Takes a tag over and ends it.
### :param t: The tag.
routine consume(t: Tag) -> None
    drop t
    return

### Hands one tag over and puts another in its place.
routine run() -> None
    t: &Tag <- .construct(1)

    consume(steal t)
    t.poke(Tag.construct(2))
    return

### Runs.
routine start() -> None
    run()
    Console.show("ended {ENDED.peek()}")
    return
