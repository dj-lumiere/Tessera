// -- internal routines against exact models ------------------------------------------------

/// Prints "<name> i" for a mismatch; returns 1 for a mismatch, else 0.
routine unit_miss(%out: @FdWriter, %name: Bytes, %i: USize, %ok: Bool) -> U64
    block entry():
        branch %ok ? return(0) : bad(%i)

    block bad(%i: USize):
        write(%out, "{%name} #{%i} differs\n")
        return(1)

routine unit_summary(%out: @FdWriter, %name: Bytes, %count: USize, %bad: U64) -> Void
    block entry():
        write(%out, "{%name}: {%count} cases, {%bad} mismatches\n")
        return()

/// The 256-bit value stored as (high, low) at p[2i], p[2i + 1].
routine load256(%p: @U128, %i: USize) -> U256
    block entry():
        %at   : USize = %i.mul(2)
        %next : USize = %at.add(1)
        %high : U128  = %p.stride(%at).load()
        %low  : U128  = %p.stride(%next).load()
        %r    : U256  = cm_trig_join(%high, %low)
        return(%r)

/// The 384-bit value stored as (l0, l1, l2) at p[3i ..].
routine load384(%p: @U128, %i: USize) -> CmTrigU384
    block entry():
        %at : USize      = %i.mul(3)
        %i1 : USize      = %at.add(1)
        %i2 : USize      = %at.add(2)
        %l0 : U128       = %p.stride(%at).load()
        %l1 : U128       = %p.stride(%i1).load()
        %l2 : U128       = %p.stride(%i2).load()
        %r  : CmTrigU384 = CmTrigU384 { l0: %l0, l1: %l1, l2: %l2 }
        return(%r)

routine same384(%a: CmTrigU384, %b: CmTrigU384) -> Bool
    block entry():
        %r : Bool = %a.l0.eq(%b.l0).bitand(%a.l1.eq(%b.l1)).bitand(%a.l2.eq(%b.l2))
        return(%r)

routine check_mul256(%out: @FdWriter) -> Void
    block entry():
        %a    : @U128 = UNIT_MUL256_A.to_ptr()
        %b    : @U128 = UNIT_MUL256_B.to_ptr()
        %want : @U128 = UNIT_MUL256_WANT.to_ptr()
        jump loop(%a, %b, %want, 0, 0)

    block loop(%a: @U128, %b: @U128, %want: @U128, %i: USize, %bad: U64):
        %done : Bool = %i.eq(UNIT_MUL256_COUNT)
        branch %done ? finish(%bad) : test(%a, %b, %want, %i, %bad)

    block test(%a: @U128, %b: @U128, %want: @U128, %i: USize, %bad: U64):
        %got  : U256 = cm_trig_mul256(load256(%a, %i), load256(%b, %i))
        %miss : U64  = unit_miss(%out, "mul256", %i, %got.eq(load256(%want, %i)))
        jump loop(%a, %b, %want, %i.add(1), %bad.add(%miss))

    block finish(%bad: U64):
        unit_summary(%out, "mul256", UNIT_MUL256_COUNT, %bad)
        return()

routine check_mul384(%out: @FdWriter) -> Void
    block entry():
        %a    : @U128 = UNIT_MUL384_A.to_ptr()
        %b    : @U128 = UNIT_MUL384_B.to_ptr()
        %want : @U128 = UNIT_MUL384_WANT.to_ptr()
        jump loop(%a, %b, %want, 0, 0)

    block loop(%a: @U128, %b: @U128, %want: @U128, %i: USize, %bad: U64):
        %done : Bool = %i.eq(UNIT_MUL384_COUNT)
        branch %done ? finish(%bad) : test(%a, %b, %want, %i, %bad)

    block test(%a: @U128, %b: @U128, %want: @U128, %i: USize, %bad: U64):
        %got  : CmTrigU384 = cm_trig_mul384(load384(%a, %i), load384(%b, %i))
        %miss : U64        = unit_miss(%out, "mul384", %i, same384(%got, load384(%want, %i)))
        jump loop(%a, %b, %want, %i.add(1), %bad.add(%miss))

    block finish(%bad: U64):
        unit_summary(%out, "mul384", UNIT_MUL384_COUNT, %bad)
        return()

routine check_addsub384(%out: @FdWriter) -> Void
    block entry():
        %a    : @U128 = UNIT_ADDSUB_A.to_ptr()
        %b    : @U128 = UNIT_ADDSUB_B.to_ptr()
        %sum  : @U128 = UNIT_ADDSUB_SUM.to_ptr()
        %diff : @U128 = UNIT_ADDSUB_DIFF.to_ptr()
        jump loop(%a, %b, %sum, %diff, 0, 0)

    block loop(%a: @U128, %b: @U128, %sum: @U128, %diff: @U128, %i: USize, %bad: U64):
        %done : Bool = %i.eq(UNIT_ADDSUB_COUNT)
        branch %done ? finish(%bad) : test(%a, %b, %sum, %diff, %i, %bad)

    block test(%a: @U128, %b: @U128, %sum: @U128, %diff: @U128, %i: USize, %bad: U64):
        %x       : CmTrigU384 = load384(%a, %i)
        %y       : CmTrigU384 = load384(%b, %i)
        %sum_ok  : Bool       = same384(cm_trig_add384(%x, %y), load384(%sum, %i))
        %diff_ok : Bool       = same384(cm_trig_sub384(%x, %y), load384(%diff, %i))
        %miss    : U64        = unit_miss(%out, "add384/sub384", %i, %sum_ok.bitand(%diff_ok))
        jump loop(%a, %b, %sum, %diff, %i.add(1), %bad.add(%miss))

    block finish(%bad: U64):
        unit_summary(%out, "add384/sub384", UNIT_ADDSUB_COUNT, %bad)
        return()

routine check_place_top(%out: @FdWriter) -> Void
    block entry():
        %f     : @U128 = UNIT_SHIFT_F.to_ptr()
        %shift : @S64  = UNIT_SHIFT_BY.to_ptr()
        %place : @U128 = UNIT_SHIFT_PLACE.to_ptr()
        %x     : @U128 = UNIT_SHIFT_X.to_ptr()
        %top   : @U128 = UNIT_SHIFT_TOP.to_ptr()
        jump loop(%f, %shift, %place, %x, %top, 0, 0)

    block loop(%f: @U128, %shift: @S64, %place: @U128, %x: @U128, %top: @U128, %i: USize,
            %bad: U64):
        %done : Bool = %i.eq(UNIT_SHIFT_COUNT)
        branch %done ? finish(%bad) : test(%f, %shift, %place, %x, %top, %i, %bad)

    block test(%f: @U128, %shift: @S64, %place: @U128, %x: @U128, %top: @U128, %i: USize,
            %bad: U64):
        %value    : U128 = %f.stride(%i).load()
        %by       : S64  = %shift.stride(%i).load()
        %top_want : U128 = %top.stride(%i).load()
        %placed   : U256 = cm_trig_place256(%value, %by)
        %topped   : U128 = cm_trig_top256(load256(%x, %i), %by)
        %ok       : Bool = %placed.eq(load256(%place, %i)).bitand(%topped.eq(%top_want))
        %miss     : U64  = unit_miss(%out, "place/top", %i, %ok)
        jump loop(%f, %shift, %place, %x, %top, %i.add(1), %bad.add(%miss))

    block finish(%bad: U64):
        unit_summary(%out, "place/top", UNIT_SHIFT_COUNT, %bad)
        return()

/// ok | negative << 1 | n << 2 | (et + 1000) << 12, as the generator packs it.
routine reduce_meta(%ok: Bool, %negative: Bool, %n: U64, %et: S64) -> U64
    block entry():
        %r : U64 = %ok.to_u64().bitor(%negative.to_u64().shl(1)).bitor(%n.shl(2)).bitor(%et.add(1000).to_u64().shl(12))
        return(%r)

routine check_reduce(%out: @FdWriter) -> Void
    block entry():
        %m    : @U128 = UNIT_REDUCE_M.to_ptr()
        %e    : @S64  = UNIT_REDUCE_E.to_ptr()
        %t1   : @U128 = UNIT_REDUCE_T1.to_ptr()
        %meta : @U64  = UNIT_REDUCE_META.to_ptr()
        jump loop(%m, %e, %t1, %meta, 0, 0)

    block loop(%m: @U128, %e: @S64, %t1: @U128, %meta: @U64, %i: USize, %bad: U64):
        %done : Bool = %i.eq(UNIT_REDUCE_COUNT)
        branch %done ? finish(%bad) : test(%m, %e, %t1, %meta, %i, %bad)

    block test(%m: @U128, %e: @S64, %t1: @U128, %meta: @U64, %i: USize, %bad: U64):
        %mv        : U128          = %m.stride(%i).load()
        %ev        : S64           = %e.stride(%i).load()
        %t1_want   : U128          = %t1.stride(%i).load()
        %meta_want : U64           = %meta.stride(%i).load()
        %red       : CmTrigReduced = cm_trig_reduce(%mv, %ev)
        %meta_val  : U64           = reduce_meta(%red.ok, %red.negative, %red.n, %red.et)
        %ok        : Bool          = %red.t1.eq(%t1_want).bitand(%meta_val.eq(%meta_want))
        %miss      : U64           = unit_miss(%out, "reduce", %i, %ok)
        jump loop(%m, %e, %t1, %meta, %i.add(1), %bad.add(%miss))

    block finish(%bad: U64):
        unit_summary(%out, "reduce", UNIT_REDUCE_COUNT, %bad)
        return()

routine check_reduce_wide(%out: @FdWriter) -> Void
    block entry():
        %m    : @U128 = UNIT_WIDE_M.to_ptr()
        %e    : @S64  = UNIT_WIDE_E.to_ptr()
        %t    : @U128 = UNIT_WIDE_T.to_ptr()
        %meta : @U64  = UNIT_WIDE_META.to_ptr()
        jump loop(%m, %e, %t, %meta, 0, 0)

    block loop(%m: @U128, %e: @S64, %t: @U128, %meta: @U64, %i: USize, %bad: U64):
        %done : Bool = %i.eq(UNIT_WIDE_COUNT)
        branch %done ? finish(%bad) : test(%m, %e, %t, %meta, %i, %bad)

    block test(%m: @U128, %e: @S64, %t: @U128, %meta: @U64, %i: USize, %bad: U64):
        %mv        : U128              = %m.stride(%i).load()
        %ev        : S64               = %e.stride(%i).load()
        %meta_want : U64               = %meta.stride(%i).load()
        %red       : CmTrigWideReduced = cm_trig_reduce_wide(%mv, %ev)
        %meta_val  : U64               = reduce_meta(true, %red.negative, %red.n, %red.et)
        %ok        : Bool              = same384(%red.t,
                load384(%t, %i)).bitand(%meta_val.eq(%meta_want))
        %miss      : U64               = unit_miss(%out, "reduce_wide", %i, %ok)
        jump loop(%m, %e, %t, %meta, %i.add(1), %bad.add(%miss))

    block finish(%bad: U64):
        unit_summary(%out, "reduce_wide", UNIT_WIDE_COUNT, %bad)
        return()
