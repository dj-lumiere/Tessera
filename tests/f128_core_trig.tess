/// 1 when got differs from want (and the difference is printed), else 0.
routine report(%out: @FdWriter, %name: Bytes, %i: USize, %got: U128, %want: U128) -> U64
    block entry():
        %ok : Bool = %got.eq(%want)
        branch %ok ? return(0) : bad(%out, %name, %i, %got, %want)

    block bad(%out: @FdWriter, %name: Bytes, %i: USize, %got: U128, %want: U128):
        write(%out, "{%name} #{%i}: ")
        %got.represent_hex(%out)
        write(%out, " want ")
        %want.represent_hex(%out)
        write(%out, "\n")
        return(1)

routine summary(%out: @FdWriter, %name: Bytes, %failures: U64) -> Void
    block entry():
        write(%out, "{%name}: ")
        %total  : U64 = 2521
        %passed : U64 = %total.sub(%failures)
        write(%out, "{%passed} / 2521\n")
        return()

routine main() -> S32
    block entry():
        %out_val : FdWriter = .stdout()
        claim %out : @FdWriter
        %out.store(%out_val)
        jump next(0, 0, 0, 0, %out)

    block next(%i: USize, %sin_bad: U64, %cos_bad: U64, %pair_bad: U64, %out: @FdWriter):
        %done : Bool = %i.ge(2521)
        branch %done ? finish(%sin_bad, %cos_bad, %pair_bad, %out)
                     : check(%i, %sin_bad, %cos_bad, %pair_bad, %out)

    block check(%i: USize, %sin_bad: U64, %cos_bad: U64, %pair_bad: U64, %out: @FdWriter):
        %bits      : U128       = INPUTS.get(%i)
        %sin_want  : U128       = SIN_WANT.get(%i)
        %cos_want  : U128       = COS_WANT.get(%i)
        %x         : F128       = f128_of(%bits)
        %sin       : F128       = %x.sin()
        %cos       : F128       = %x.cos()
        %pair      : F128SinCos = %x.sin_cos()
        %pair_sin  : F128       = %pair.sin
        %pair_cos  : F128       = %pair.cos
        %sin_miss  : U64        = report(%out, "sin", %i, %sin.bits(), %sin_want)
        %cos_miss  : U64        = report(%out, "cos", %i, %cos.bits(), %cos_want)
        %ps_miss   : U64        = report(%out, "sin_cos.sin", %i, %pair_sin.bits(), %sin_want)
        %pc_miss   : U64        = report(%out, "sin_cos.cos", %i, %pair_cos.bits(), %cos_want)
        %pair_miss : U64        = %ps_miss.bitor(%pc_miss)
        %sin_next  : U64        = %sin_bad.add(%sin_miss)
        %cos_next  : U64        = %cos_bad.add(%cos_miss)
        %pair_next : U64        = %pair_bad.add(%pair_miss)
        jump next(%i.add(1), %sin_next, %cos_next, %pair_next, %out)

    block finish(%sin_bad: U64, %cos_bad: U64, %pair_bad: U64, %out: @FdWriter):
        summary(%out, "sin", %sin_bad)
        summary(%out, "cos", %cos_bad)
        summary(%out, "sin_cos", %pair_bad)
        check_mul256(%out)
        check_mul384(%out)
        check_addsub384(%out)
        check_place_top(%out)
        check_reduce(%out)
        check_reduce_wide(%out)
        return(0)

