# An entity field Node? keeps the next node in memory from HEAP: built, walked, one unlinked in the middle, all dropped.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A list of nodes.
entity Chain
    head: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

### Says which node ends, then ends the rest of the list.
routine @Node.destruct() -> None
    Console.show("end {me.value.peek()}")
    drop me.next
    return

### An empty list.
### :returns: The list.
common routine Chain.construct() -> Me
    return Me(head: None())

### Puts a value in front.
### :param value: The value.
routine @Chain.push_front(value: S64) -> None
    steal me.head as old inject .hollow()
    fresh: &Node <- Node.construct(value)
    fresh.next <- steal old
    me.head <- steal fresh from HEAP
    return

### Takes the first node holding a value out of the list and ends it.
### :param value: The value.
### :returns: Whether a node held it.
routine @Chain.remove(value: S64) -> Bool
    when me.head
        is None => return false
        is Node as first =>
            if first.value.peek() == value
                steal me.head as gone inject .hollow()
                steal gone.getview().next as rest inject .hollow()
                me.head <- steal rest
                drop gone
                return true
            loop with prev: @Node = first
                when prev.next
                    is None => return false
                    is Node as cur =>
                        if cur.value.peek() == value
                            steal prev.next as gone inject .hollow()
                            steal gone.getview().next as rest inject .hollow()
                            prev.next <- steal rest
                            drop gone
                            return true
                        continue with prev: cur

### Shows the values on one line.
routine @Chain.show_all() -> None
    when me.head
        is None => Console.show("empty")
        is Node as first =>
            loop with cur: @Node = first, line: U64 = 0
                Console.show("{line}: {cur.value.peek()}")
                when cur.next
                    is Node as next => continue with cur: next, line: line + 1
                    is None => break
    return

routine start() -> None
    chain: &Chain <- Chain.construct()
    chain.push_front(4)
    chain.push_front(3)
    chain.push_front(2)
    chain.push_front(1)
    chain.show_all()
    three: Bool = chain.remove(3)
    Console.show("removed 3: {three}")
    nine: Bool = chain.remove(9)
    Console.show("removed 9: {nine}")
    one: Bool = chain.remove(1)
    Console.show("removed 1: {one}")
    chain.show_all()
    drop chain
    Console.show("done")
    return
