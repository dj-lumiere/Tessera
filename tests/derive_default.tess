// A choice or variant without #derive derives Representable, Diagnosable, Equatable, Hashable, and Comparable:
// print, eq, compare, a Dict key, and a sort all work below. A variant's conformance holds only when its branches
// have the concept (Point derives only Representable, Diagnosable, and Equatable, so Label is Representable,
// Diagnosable, and Equatable but not Hashable or Comparable), a routine it declares itself replaces the derived one,
// and #derive() derives nothing.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

choice Color: U8
    RED
    GREEN
    BLUE

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Circle
    radius: S64

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Square
    side: S64

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Empty

variant Shape
    Circle
    Square
    Empty

@derive(Representable, Diagnosable, Equatable)
record Point
    x: S64
    y: S64

variant Label
    Point
    Unit

/// Its own eq: equal whatever it holds, so the derived one isn't made.
variant Loose
    S64
    Unit

@derive()
choice Silent: U8
    QUIET

routine Loose.eq(me: Me, other: Me) -> Bool
    return true

routine start() -> Void
    c: Color = Color.GREEN
    Out.write("{c}, eq {c.eq(Color.GREEN)}, compare {c.compare(Color.BLUE)}, hash {c.hash().eq(Color.GREEN.hash())}\n")

    s: Shape = Circle(radius: 3)
    t: Shape = Square(side: 2)
    e: Shape = Empty()
    Out.write("{s} vs {t}: eq {s.eq(t)}, compare {s.compare(t)}, {e.compare(t)}\n")

    l: Label = Point(x: 1, y: 2)
    none: Label = Unit()
    Out.write("label {l}, eq {l.eq(none)}\n")

    a: Loose = 1
    b: Loose = Unit()
    Out.write("loose eq {a.eq(b)}\n")

    local alloc: @MemoryManager <- make_heap_memory()
    local counts: @Dict[Color, S64] <- .construct(alloc)
    counts[Color.BLUE] = 2
    counts[Color.RED] = 1
    Out.write("counts {counts.peek()}\n")
    counts.destruct()

    local shapes: @List[Shape] <- .construct(alloc)
    shapes.add_last(Square(side: 1))
    shapes.add_last(Empty())
    shapes.add_last(Circle(radius: 9))
    shapes.add_last(Circle(radius: 4))
    shapes.sort()
    Out.write("sorted {shapes.peek()}\n")
    shapes.destruct()
    return
