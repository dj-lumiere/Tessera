// A choice or variant without #derive derives Representable, Diagnosable, Equatable, Hashable, and Comparable:
// print, eq, compare, a Dict key, and a sort all work below. A variant's conformance holds only when its payloads
// have the concept (Point derives only Diagnosable and Equatable, so Label is Representable, Diagnosable, and Equatable but not Hashable or
// Comparable), a routine it declares itself replaces the derived one, and #derive() derives nothing.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

choice Color: U8
    RED
    GREEN
    BLUE

variant Shape
    Circle: S64
    Square: S64
    Empty

#derive(Diagnosable, Equatable)
record Point
    x: S64
    y: S64

variant Label
    At: Point
    None

/// Its own eq: equal whatever the payload, so the derived one isn't made.
variant Loose
    Some: S64
    Nothing

#derive()
choice Silent: U8
    QUIET

routine Loose.eq(me: Me, other: Me) -> Bool
    block entry()
        return(true)

routine start() -> Void
    block entry()
        c: Color = Color.GREEN
        Out.write("{c}, eq {c.eq(Color.GREEN)}, compare {c.compare(Color.BLUE)}, hash {c.hash().eq(Color.GREEN.hash())}\n")

        s: Shape = .Circle(3)
        t: Shape = .Square(2)
        Out.write("{s} vs {t}: eq {s.eq(t)}, compare {s.compare(t)}, {Shape.Empty.compare(t)}\n")

        l: Label = .At(Point(x: 1, y: 2))
        Out.write("label {l}, eq {l.eq(Label.None)}\n")

        a: Loose = .Some(1)
        b: Loose = .Nothing
        Out.write("loose eq {a.eq(b)}\n")

        claim alloc: @MemoryManager <- make_heap_memory()
        claim counts: @Dict[Color, S64] <- .construct(alloc)
        counts.setitem(key: Color.BLUE, value: 2)
        counts.setitem(key: Color.RED, value: 1)
        Out.write("counts {counts.peek()}\n")
        counts.destruct()

        claim shapes: @List[Shape] <- .construct(alloc)
        shapes.add_last(.Square(1))
        shapes.add_last(.Empty)
        shapes.add_last(.Circle(9))
        shapes.add_last(.Circle(4))
        shapes.sort()
        Out.write("sorted {shapes.peek()}\n")
        shapes.destruct()
        return()
