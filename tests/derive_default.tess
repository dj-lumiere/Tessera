// A choice or variant without #derive derives Represent, Diagnose, Equal, Hash, and Compare:
// print, eq, compare, a Dict key, and a sort all work below. A variant's conformance holds only when its payloads
// have the concept (Point derives only Diagnose and Equal, so Label is Represent, Diagnose, and Equal but not Hash or
// Compare), a routine it declares itself replaces the derived one, and #derive() derives nothing.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

choice Color: U8
    Red
    Green
    Blue

variant Shape
    Circle : S64
    Square : S64
    Empty

#derive(Diagnose, Equal)
record Point
    x : S64
    y : S64

variant Label
    At : Point
    None

/// Its own eq: equal whatever the payload, so the derived one isn't made.
variant Loose
    Some : S64
    Nothing

routine Loose.eq(%self: Self, %other: Self) -> Bool
    block entry():
        return(true)

#derive()
choice Silent: U8
    Quiet

routine main() -> S32
    block entry():
        %c : Color = Color.Green
        print("{%c}, eq {%c.eq(Color.Green)}, compare {%c.compare(Color.Blue)}, hash {%c.hash().eq(Color.Green.hash())}\n")

        %s : Shape = .Circle(3)
        %t : Shape = .Square(2)
        print("{%s} vs {%t}: eq {%s.eq(%t)}, compare {%s.compare(%t)}, {Shape.Empty.compare(%t)}\n")

        %l : Label = .At(Point { x: 1, y: 2 })
        print("label {%l}, eq {%l.eq(Label.None)}\n")

        %a : Loose = .Some(1)
        %b : Loose = .Nothing
        print("loose eq {%a.eq(%b)}\n")

        claim %alloc : @Allocator
        make_heap_allocator().store_into(%alloc)
        claim %counts : @Dict<Color, S64>
        Dict<Color, S64>.construct(%alloc).store_into(%counts)
        %counts.put(Color.Blue, 2)
        %counts.put(Color.Red, 1)
        print("counts {%counts.load()}\n")
        %counts.destruct()

        claim %shapes : @List<Shape>
        List<Shape>.construct(%alloc).store_into(%shapes)
        %shapes.push(.Square(1))
        %shapes.push(.Empty)
        %shapes.push(.Circle(9))
        %shapes.push(.Circle(4))
        %shapes.sort()
        print("sorted {%shapes.load()}\n")
        %shapes.destruct()
        return(0)
