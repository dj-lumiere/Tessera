# A failure of a ticket's work that no try or check receives stops the program on the line of the retrieve(), with the
# failure's name and message: the work's thread doesn't stop the program, the retrieve does.

import Hosted

crashable BadInputError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### n, failing for a negative n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    return n

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(checked.to[Work](n: -4))
    Console.show("the work runs")
    Console.show("{t.retrieve()}")
    drop t
    return
