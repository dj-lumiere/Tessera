# A request to end the process (SIGTERM on Linux and macOS, a closed console window on Windows) goes to the
# CpuEventManager's when_terminated handler, and the handler decides. The first one returns, so the program goes on.
# The second cleans up, sets the status and ends the process itself: the line after its raise never runs.

import Standard/Hosted

### Says what it got and lets the program go on.
### :param event: The event.
routine on_terminated(event: CpuEvent) -> None
    Console.show("terminated: {event.kind == CpuEventKind.TERMINATED}")
    return

### Says it is ending and ends the process with status 3.
### :param event: The event.
routine on_terminated_end(event: CpuEvent) -> None
    Console.show("ending")
    ProcessManager.exit_process(3)

routine start() -> None
    before: Callable[(CpuEvent,), None] = CpuEventManager.when_terminated(on_terminated.to[Callable]())
    Console.show("no handler before: {before.addr().is_hollow()}")
    CpuEventManager.raise(CpuEventKind.TERMINATED)
    Console.show("still running")
    CpuEventManager.when_terminated(on_terminated_end.to[Callable]())
    CpuEventManager.raise(CpuEventKind.TERMINATED)
    Console.show("not reached")
    return
