// An implicit conversion (a @S64 passes where an Addr is expected) doesn't take part in choosing an overload.

routine where_is(at: Addr) -> S64
    block entry()
        return(0)

routine where_is(n: S64) -> S64
    block entry()
        return(1)

routine start() -> Void
    block entry()
        claim slot : @S64 <- 5
        r : S64 = where_is(slot)
        return()
