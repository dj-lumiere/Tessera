# Console.ask[T]() crashes on a word that isn't a T, naming the word and the type, at the line of the call (read[T] is
# @track_caller). Standard input is "5 x7". This handler prints the crash and exits with status 3.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    first: S32 = Console.ask[S32]()
    Console.show("first: {first}")
    second: S32 = Console.ask[S32]()
    Console.show("second: {second}")
    return
