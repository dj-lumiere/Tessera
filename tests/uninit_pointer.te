# .uninit() leaves the slot's bytes as they were, so a type holding a pointer can't start that way.

record Link
    count: U64
    next: Addr

routine Link.construct(count: U64, next: Addr) -> Me
    return Me(count: count, next: next)

routine Link.destruct(me: @Me) -> None
    return

routine start() -> None
    local r: @Link <- .uninit()

    return
