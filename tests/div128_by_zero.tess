// U128 division by zero crashes with DivisionByZeroError, on 64-bit and 32-bit targets alike (div128_edges.tess
// has the results that don't crash).

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

/// Reports the crash on stdout, where the golden test sees it, and exits with status 3.
#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("crashed: {name}: {message}\n")
        exit(3)

routine start() -> Void
    block entry()
        big  : U128 = 0xFFFFFFFF_00000000_0000000000000001
        zero : U128 = 0
        Out.write("before\n")
        q : U128 = big.div(zero)
        Out.write("not reached {q}\n")
        return()
