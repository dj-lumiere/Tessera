# A file's top-level lines are its start: local lines first, routines between the lines, the end of the file returns.

import Standard/Collections
import Standard/Os

local alloc: @MemoryManager <- HEAP.peek()
local list: @List[S64] <- .construct(alloc)

list.add_last(twice(n: 21))
first: S64 = list[0]

routine twice(n: S64) -> S64
    return n * 2

Console.show("first: {first}, count: {list.count()}")
if first > 40
    Console.show("big")
drop list
