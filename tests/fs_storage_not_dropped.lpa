# A FileStorage is borrowed from OsFileManager with <- and given back with drop: a missing drop is a build error.

import Hosted

routine start() -> None
    s: FileStorage[Byte] <- OsFileManager.storage[Byte](at: File.at("data.bin"), write: false,
        start: 0, count: U64.MAX)
    Console.show("{s.count()}")
    return
