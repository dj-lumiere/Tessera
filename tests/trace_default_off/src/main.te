# release-time leaves the crash trace out unless the manifest asks for it: trace_depth reads 0 and trace_frame an
# empty frame, and the build has no trace storage.

import Hosted

### Reports the trace from one call down.
routine report() -> None
    depth: U64 = trace_depth()
    top: TraceFrame = trace_frame(0)
    label: @[Byte] = top.name.getview()
    Console.show("depth {depth}, innermost \"{label}\"")
    return

routine start() -> None
    report()
    return
