// each over an iterator in memory: every element until emit_checked gives None, and then.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> None
    out: @Out = Out.writer()
    local alloc: @MemoryManager <- make_heap_memory()
    local xs: @List[S64] <- .construct(alloc)
    xs.add_last(4)
    xs.add_last(9)
    xs.add_last(16)
    local it: @ListIter[S64] <- .construct(xs)
    each x in it with sum: S64 = 0
        out.write("{x} ")
        continue with sum: sum + x
    then
        out.write("sum {sum}\n")
    xs.destruct()
    return
