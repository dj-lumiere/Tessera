// A Dict's values iterator hands out each value's slot in insertion order, so a loop doubles the values in place, and
// emit reads them. It conforms to SlotIterator, and so to Iterator without saying it.

import Standard/Collections
import Standard/Format
import Standard/Os

/// The sum of what an iterator hands out, through Iterator alone.
/// :typeparam TIter: The iterator type.
/// :param iter: The iterator.
/// :returns: The sum.
routine total[TIter](iter: @TIter) -> S64
require TIter: typename, Iterator[S64, TIter]
    local sum: @S64 <- 0

    block entry()
        jump next()

    block next()
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as value => continue
            is Unit => return(sum.peek())
        sum.peek().add(value).poke_into(sum)
        jump next()

routine start() -> Void
    local scores: @Dict[Bytes, S64] <- .construct()
    local slots: @DictValues[Bytes, S64] <- .hollow()
    local values: @DictValues[Bytes, S64] <- .hollow()

    block entry()
        scores.setitem(key: "a", value: 1)
        scores.setitem(key: "b", value: 2)
        scores.setitem(key: "c", value: 3)
        drop: Bool = scores.remove("b")
        DictValues[Bytes, S64].construct(scores).poke_into(slots)
        jump double()

    block double()
        slot: Maybe[@S64] = slots.next_checked()
        when slot
            is @S64 as p => continue
            is Unit => read()
        p.peek().mul(2).poke_into(p)
        jump double()

    block read()
        Out.write("{scores.peek()}\n")
        DictValues[Bytes, S64].construct(scores).poke_into(values)
        Out.write("total {total(values)}\n")
        scores.destruct()
        return()
