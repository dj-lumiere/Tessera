// An #inline routine that calls itself directly can't be inlined at every call either.

#inline
routine fact(%n: U64) -> U64
    block entry():
        %done : Bool = %n.le(1)
        branch %done ? return(1) : more(%n)

    block more(%n: U64):
        return(%n.mul(fact(%n.sub(1))))

routine main() -> S32
    block entry():
        %f : U64 = fact(5)
        return(0)
