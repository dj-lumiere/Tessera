# A piece of work made in a loop's body and not put on a ticket in that pass is a build error: the next pass makes
# another, and this one would never run.

import Standard/Os

routine square(n: S64) -> S64
    return n * n

routine start() -> None
    each i in 0 til 4
        work: Work[S64] = square.to[Work](n: i)
        Console.show("{i}")
    return
