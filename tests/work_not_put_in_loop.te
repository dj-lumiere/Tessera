# Work handed an entity, made in a loop's body and not put on a ticket in that pass, is a build error.

import Hosted

### A value with nothing in it but its number.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Token) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

routine start() -> None
    each i in 0 til 4
        a: &Token <- Token.construct(i)
        work: Work[S64] = look.to[Work](item: steal a)
        Console.show("{i}")
    return
