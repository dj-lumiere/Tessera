/// A private declaration doesn't claim its name outside its file: the stdlib's private NODE_KEYS
/// (collections) and U256Division (div256.tess) leave these names free.
preset NODE_KEYS: U64 = 3

record U256Division
    parts: U64

routine main() -> S32
    block entry():
        %d: U256Division = U256Division { parts: NODE_KEYS }
        print("{%d.parts}\n")
        return(0)
