/// A private declaration doesn't claim its name outside its file: the stdlib's private NODE_KEYS
/// (collections) and U256Division (div256.tess) leave these names free.
import Standard/Format
import Standard/Os

preset NODE_KEYS: U64 = 3

record U256Division
    parts: U64

/// Makes a `U256Division` from its fields.
/// :param parts: Its `parts`.
/// :returns: The new value.
routine U256Division.construct(parts: U64) -> Me
    return(Me(parts))

/// Releases nothing: a `U256Division` holds no memory of its own.
routine U256Division.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    d: U256Division = U256Division(parts: NODE_KEYS)
    Out.write("{d.parts}\n")
    return()
