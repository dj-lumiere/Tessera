// wide_div(S128.MIN, -1) crashes with IntegerOverflowError like S128.div, instead of wrapping to MIN.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

/// Reports the crash and the caller's line on stdout, where the golden test sees them, and exits with status 3.
/// :param name: The crash kind.
/// :param message: The crash message.
/// :param place: Where the crash was raised.
#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("crashed: {name} at line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    block entry()
        q : S128 = wide_div(S128.MIN, -1)
        Out.write("not reached {q}\n")
        return(0)
