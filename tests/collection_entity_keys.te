# Entity keys and elements in the keyed collections: Set and Dict keys, PriorityQueue priorities and elements, and the
# sorted collections' elements are entities here. Hash, eq, and compare read them through their places, they move in
# with steal, a duplicate that doesn't go in ends at once, and remove, a replaced value, and destruct end each one.

import Standard/Collections
import Standard/Os

### A key that ends loudly.
entity Key
obeys HashEquatable[Key], Comparable[Key], Diagnosable[Key]
    n: S64

### Makes one.
### :param n: The value.
### :returns: The key.
common routine Key.construct(n: S64) -> Me
    return Me(n)

### Ends it.
routine @Key.destruct() -> None
    Console.show("~{me.n.peek()} ", end: "")
    return

### Equal when the values are.
### :param other: The other key.
### :returns: Whether they are equal.
routine @Key.eq(other: @Me) -> Bool
    return me.n.peek() == other.n.peek()

### The value's hash.
### :returns: The hash.
routine @Key.hash() -> U64
    return me.n.peek().hash()

### Orders by value.
### :param other: The other key.
### :returns: -1, 0 or 1.
routine @Key.compare(other: @Me) -> S32
    return me.n.peek().compare(other.n.peek())

### Writes the value.
### :typeparam TWriter: The writer type.
### :param out: The writer.
routine @Key.diagnose_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    write_str(out, text: "k")
    me.n.peek().diagnose_into(out)
    return

### Runs.
routine start() -> None
    local sl: @SortedList[Key] <- .construct(HEAP)
    local ss: @SortedSet[Key] <- .construct(HEAP)
    local sd: @SortedDict[Key, Key] <- .construct(HEAP)
    local pq: @PriorityQueue[Key, Key] <- .construct(HEAP)
    local d: @Dict[Key, Key] <- .construct(HEAP)
    local s: @Set[Key] <- .construct(HEAP)

    each i: U64 in 0 til 20
        n: S64 = (i * 7 % 20).to[S64]()
        sl.add(Key.construct(n))
        ss.add(Key.construct(n))
        sd.setitem(key: Key.construct(n), value: Key.construct(n * 10))
        pq.add(priority: Key.construct(n), element: Key.construct(n * 10))
        d.setitem(key: Key.construct(n), value: Key.construct(n * 10))
        s.add(Key.construct(n))
    Console.show("\n-- filled")
    ss.add(Key.construct(3))
    sd.setitem(key: Key.construct(3), value: Key.construct(33))
    d.setitem(key: Key.construct(3), value: Key.construct(33))
    s.add(Key.construct(3))
    Console.show("\n-- duplicates")
    Console.show("has {sl.has(Key.construct(5))} {ss.has(Key.construct(5))} {sd.has_key(Key.construct(5))} {d.has_key(Key.construct(25))}")
    each j: U64 in 0 til 12
        i: S64 = j.to[S64]()
        ss.remove(Key.construct(i))
        sd.remove(Key.construct(i))
        d.remove(Key.construct(i))
        s.remove(Key.construct(i))
        local top: @Key <- pq.remove()
        drop top
        local first: @Key <- sl.remove(0)
        drop first
    Console.show("\n-- removed")
    sl.diagnose_into(Console.output())
    Console.show("")
    ss.diagnose_into(Console.output())
    Console.show("")
    sd.diagnose_into(Console.output())
    Console.show("")
    pq.diagnose_into(Console.output())
    Console.show("")
    d.diagnose_into(Console.output())
    Console.show("")
    s.diagnose_into(Console.output())
    Console.show("")
    Console.show("{sd.getslot(Key.construct(15)).n.peek()} {d.getslot(Key.construct(15)).n.peek()}")
    drop sl
    Console.show("")
    drop ss
    Console.show("")
    drop sd
    Console.show("")
    drop pq
    Console.show("")
    drop d
    Console.show("")
    drop s
    Console.show("")
    return
