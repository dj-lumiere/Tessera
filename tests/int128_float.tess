// F32 / F64 <-> S128 / U128 conversions at the rounding edges. On a 64-bit target they run through compiler-rt, on
// a 32-bit target through the stdlib's own copies (Standard/SoftFloat's integer-only conversions, which
// Standard/SoftFloat/Exports.tess exports there), and both must print the same.

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

routine show_u128(label: @Byte, v: U128) -> Void
    block entry()
        hi : U64 = v.shr(64).to_wrap<U64>()
        lo : U64 = v.to_wrap<U64>()
        c_printf("%s %016llx%016llx\n", label, hi, lo)
        return()

routine show_s128(label: @Byte, v: S128) -> Void
    block entry()
        show_u128(label, v.to_wrap<U128>())
        return()

routine show_f64(label: @Byte, v: F64) -> Void
    block entry()
        c_printf("%s %016llx\n", label, v.bits())
        return()

routine show_f32(label: @Byte, v: F32) -> Void
    block entry()
        c_printf("%s %08x\n", label, v.bits())
        return()

routine start() -> Void
    block entry()
        // float to integer: truncation, the exact top of the range, clamping
        show_u128("f64 0.9 ->u", F64.to_clamp<U128>(0.9))
        show_u128("f64 2^53+2 ->u", F64.to_clamp<U128>(9007199254740994.0))
        show_u128("f64 1e20 ->u", F64.to_clamp<U128>(100000000000000000000.0))
        show_u128("f64 2^127 ->u", F64.to_clamp<U128>(170141183460469231731687303715884105728.0))
        show_u128("f64 2^128 ->u", F64.to_clamp<U128>(340282366920938463463374607431768211456.0))
        show_u128("f64 -1.5 ->u", F64.to_clamp<U128>(-1.5))
        show_s128("f64 -1.5 ->s", F64.to_clamp<S128>(-1.5))
        show_s128("f64 -1e30 ->s", F64.to_clamp<S128>(-1000000000000000000000000000000.0))
        show_s128("f64 -2^127 ->s", F64.to_clamp<S128>(-170141183460469231731687303715884105728.0))
        show_s128("f64 2^127 ->s", F64.to_clamp<S128>(170141183460469231731687303715884105728.0))
        show_u128("f32 3.4e38 ->u", F32.to_clamp<U128>(340282346638528859811704183484516925440.0))
        show_s128("f32 -1e20 ->s", F32.to_clamp<S128>(-100000000000000000000.0))

        // integer to float: exact, round down, round up through the sticky bit, ties to even
        show_f64("u 2^64-1 ->f64", U128.to<F64>(18446744073709551615))
        show_f64("u 2^64+2^11 ->f64", U128.to<F64>(18446744073709553664))
        show_f64("u 2^64+2^11+1 ->f64", U128.to<F64>(18446744073709553665))
        show_f64("u 2^64+3*2^11 ->f64", U128.to<F64>(18446744073709557760))
        show_f64("u max ->f64", U128.to<F64>(340282366920938463463374607431768211455))
        show_f64("s min ->f64", S128.to<F64>(-170141183460469231731687303715884105728))
        show_f64("s -(2^64+2^11+1) ->f64", S128.to<F64>(-18446744073709553665))
        show_f32("u 2^32+2^8 ->f32", U128.to<F32>(4294967552))
        show_f32("u 2^32+2^8+1 ->f32", U128.to<F32>(4294967553))
        show_f32("u 2^100+1 ->f32", U128.to<F32>(1267650600228229401496703205377))
        show_f32("u max ->f32", U128.to<F32>(340282366920938463463374607431768211455))
        show_f32("s -(2^40+1) ->f32", S128.to<F32>(-1099511627777))
        return()
