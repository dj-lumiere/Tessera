# B16 and BF16 mul_add round once. Computing a*b + c as a B32 fma and then narrowing rounds twice, and these
# inputs came out one ulp off that way (the expected bits are the exact result rounded to nearest, ties to even).

import Standard/Format
import Standard/Os

routine b16(a: U16, b: U16, c: U16) -> None
    r: B16 = B16.from_bits(a).mul_add_unchecked(a: B16.from_bits(b), b: B16.from_bits(c))
    Console.show("B16 {r.bits()}")
    return

routine bf16(a: U16, b: U16, c: U16) -> None
    r: BF16 = BF16.from_bits(a).mul_add_unchecked(a: BF16.from_bits(b), b: BF16.from_bits(c))
    Console.show("BF16 {r.bits()}")
    return

routine start() -> None
    b16(a: 0x4240, b: 0x73D0, c: 0x1206)  # 0x7A1B
    b16(a: 0x4A00, b: 0xE18E, c: 0x8EED)  # 0xF02B
    b16(a: 0x665E, b: 0xCD00, c: 0x02C4)  # 0xF7F5
    b16(a: 0xE780, b: 0xCD68, c: 0x869C)  # 0x7911
    bf16(a: 0x730C, b: 0x9630, c: 0x88C2)  # 0xC9C1
    bf16(a: 0x5408, b: 0x8B48, c: 0x89C6)  # 0x9FD5
    bf16(a: 0x14C0, b: 0xF93E, c: 0x8E76)  # 0xCE8F
    bf16(a: 0x51C0, b: 0x06CA, c: 0x82DC)  # 0x1917
    # an exact cancellation gives +0, and a finite product plus an infinity is that infinity
    b16(a: 0x3C00, b: 0x3C00, c: 0xBC00)  # 1 * 1 - 1 = +0
    b16(a: 0x3C00, b: 0x3C00, c: 0xFC00)  # -inf
    return
