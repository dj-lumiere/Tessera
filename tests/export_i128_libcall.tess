// A program's own __udivti3 replaces the C runtime's, and LLVM's 128-bit division calls it with the C ABI's
// convention (on Win64 the operands by pointer and the result in XMM0), so the exported definition has to match it.

import Standard::Format
import Standard::Os

global CALLS: @U64 <- 0

#export("__udivti3")
routine udivti3(a: U128, b: U128) -> U128
    shared q : @U128 <- 0

    block entry()
        next_calls : U64 = CALLS.load().add(1)
        next_calls.store_into(CALLS)
        jump step(a)

    block step(left: U128)
        branch left.ge(b)
            ? continue
            : return(q.load())
        q.load().add(1).store_into(q)
        jump step(left.sub(b))

#noinline
routine divide(a: U128, b: U128) -> U128
    block entry()
        return(udiv<U128>(a, b))

routine start() -> Void
    block entry()
        q : U128 = divide(30, 7)
        Out.write("{q} {CALLS.load()}\n")
        return()
