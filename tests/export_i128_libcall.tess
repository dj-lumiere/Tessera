// A program's own __udivti3 replaces the C runtime's, and LLVM's 128-bit division calls it with the C ABI's
// convention (on Win64 the operands by pointer and the result in XMM0), so the exported definition has to match it.

import Standard/Format
import Standard/Os

global CALLS: @U64 <- 0

@export("__udivti3")
routine udivti3(a: U128, b: U128) -> U128
    local q: @U128 <- 0

    next_calls: U64 = CALLS.peek() + 1
    next_calls.poke_into(CALLS)

    while left >= b with left: U128 = a
        (q.peek() + 1).poke_into(q)
        continue with left: left - b
    then
        return q.peek()

@noinline
routine divide(a: U128, b: U128) -> U128
    return udiv[U128](a, b)

routine start() -> None
    q: U128 = divide(a: 30, b: 7)
    Out.write("{q} {CALLS.peek()}\n")
    return
