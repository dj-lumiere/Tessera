### A value of an overloaded routine is the overload whose signature is the Callable written, or the Callable the
### value goes to.
import Standard/Hosted

routine step(n: S64) -> S64
    return n + 1

routine step(n: U64) -> U64
    return n + 10

routine apply(f: Callable[(U64,), U64], n: U64) -> U64
    return f.call(n)

routine start() -> None
    signed: Callable[(S64,), S64] = step.to[Callable]()
    written: Callable[(U64,), U64] = step.to[Callable[(U64,), U64]]()
    n: S64 = 1
    u: U64 = 1
    by_value: U64 = apply(f: step.to[Callable](), n: u)
    Console.show("{signed.call(n)} {written.call(u)} {by_value}")
    return
