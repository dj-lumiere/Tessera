# A member of another choice where an Order goes is a build error.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE

### A color.
choice Color: U8
    ### Red.
    RED
    ### Green.
    GREEN

### The rank of O.
### :typeparam O: The order.
### :returns: 0 or 1.
routine rank[O]() -> U64
needs O: Order
    when O
        Order.RELAXED => return 0
        Order.ACQUIRE => return 1

### Runs.
routine start() -> None
    Console.show("{rank[Color.GREEN]()}")
    return
