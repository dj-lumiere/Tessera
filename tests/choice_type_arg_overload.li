# A routine on a receiver with a choice member named (Cell[RELAXED].load, Cell[Order.SEQ_CST].load) beats the one for any
# member (Cell[O].load), as a number named does, and a generic body calls the one its instance's member picks.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE
    ### One order for every thread.
    SEQ_CST

### A cell with an order.
### :typeparam O: The order.
record Cell[O]
needs Order O
    v: U64

### The one for any order.
### :returns: 1.
routine Cell[O].load() -> U64
needs Order O
    return 1

### The one for RELAXED, named bare.
### :returns: 2.
routine Cell[RELAXED].load() -> U64
    return 2

### The one for SEQ_CST, named with its choice.
### :returns: 3.
routine Cell[Order.SEQ_CST].load() -> U64
    return 3

### Loads through any cell.
### :typeparam O: The order.
### :param c: The cell.
### :returns: What load gives.
routine through[O](c: Cell[O]) -> U64
needs Order O
    return c.load()

### Runs.
routine start() -> None
    relaxed: Cell[RELAXED]
    acquiring: Cell[ACQUIRE]
    sequential: Cell[SEQ_CST]
    Console.show("{relaxed.load()} {acquiring.load()} {sequential.load()}")
    Console.show("{through(relaxed)} {through(acquiring)} {through(sequential)}")
    return
