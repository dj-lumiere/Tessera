# A record that holds a view of what a list holds ends with that view at a #reshaping call on the list.

import Collections
import Hosted

### Part of a list.
record Part
    values: @[S64]

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)
    xs.add_last(5)
    part: Part = Part(values: xs.getslice(start: 0, count: 1))
    xs.add_last(6)
    Console.show(part.values.getslot(0).peek())
    drop xs
    return
