/// Option<T> is Equal only when T is: `conform Equal<Option<T>> when T: typename, Equal<T>`.
record Point
    x : S64

routine same<T>(%a: T, %b: T) -> Bool
require T: typename, Equal<T>
    block entry():
        %r : Bool = %a.eq(%b)
        return(%r)

routine main() -> S32
    block entry():
        %p : Option<Point> = .Absent
        %s : Bool          = same(%p, %p)
        return(0)
