/// Option<T> is Equatable only when T is: `conform Equatable<Option<T>> when T: typename, Equatable<T>`.
record Point
    x : S64

routine same<T>(a: T, b: T) -> Bool
require T: typename, Equatable<T>
    block entry()
        r : Bool = a.eq(b)
        return(r)

routine start() -> Void
    block entry()
        p : Option<Point> = .Absent
        s : Bool          = same(p, p)
        return()
