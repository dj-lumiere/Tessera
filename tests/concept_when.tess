/// Maybe[T] is Equatable only when T is: `conform Equatable[Maybe[T]] when T: typename, Equatable[T]`.
record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine same[T](a: T, b: T) -> Bool
require T: typename, Equatable[T]
    r: Bool = a.eq(b)
    return(r)

routine start() -> Void
    p: Maybe[Point] = Unit()
    s: Bool = same(a: p, b: p)
    return()
