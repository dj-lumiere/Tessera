/// Byte shifts by 8 or more shift every bit out (see Operations, Bitwise and Shifts).
import Standard::Format
import Standard::Os

routine show(b: Byte) -> Void
    block entry():
        Out.write("{b.to<U8>().to<U64>()}\n")
        return()

routine main() -> S32
    block entry():
        b : Byte = 0xB5
        show(b.shl(0x01))
        show(b.shr(0x03))
        show(b.shl(0x08))
        show(b.shr(0x08))
        show(b.shr(0xFF))
        return(0)
