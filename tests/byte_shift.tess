/// Byte shifts by 8 or more shift every bit out (see Operations, Bitwise and Shifts).
import Standard/Format
import Standard/Os

routine show(b: Byte) -> Void
    Out.write("{b.to[U8]().to[U64]()}\n")
    return

routine start() -> Void
    b: Byte = 0xB5
    show(b << 0x01)
    show(b >> 0x03)
    show(b << 0x08)
    show(b >> 0x08)
    show(b >> 0xFF)
    return
