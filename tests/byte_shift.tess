/// Byte shifts by 8 or more shift every bit out (Roadmap #8).

import Standard::Format

routine show(%b: Byte) -> Void
    block entry():
        print("{%b.to_u8().to_u64()}\n")
        return()

routine main() -> S32
    block entry():
        %b : Byte = 0xB5
        show(%b.shl(0x01))
        show(%b.shr(0x03))
        show(%b.shl(0x08))
        show(%b.shr(0x08))
        show(%b.shr(0xFF))
        return(0)
