# An entity value that a routine taking me: @Me is called on, or that goes where an @E is taken, is put in an unnamed
# slot that ends with the statement: a call's receiver, an argument, an if or while condition, a when subject and a
# value when's arm (as soon as they are read), and a returned value (before the return), an argument of a returned
# call too. Each Counter says when it ends.

import Standard/Format
import Standard/Os

### A counter that says when it ends.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
routine Counter.construct(n: S64) -> Me
    return Me(n)

### Says that it ends.
routine Counter.destruct(me: @Me) -> None
    Console.show("[end {me.n.peek()}]", end: "")
    return

### A counter made on the spot.
### :param n: The count.
### :returns: The counter.
routine Counter.at(n: S64) -> Me
    return Me.construct(n)

### Reads the count.
### :returns: The count.
routine Counter.get(me: @Me) -> S64
    return me.n.peek()

### The sum of two counters' counts.
### :param a: One counter.
### :param b: The other.
### :returns: The sum.
routine sum(a: @Counter, b: @Counter) -> S64
    return a.get() + b.get()

### A count read through a temporary counter.
### :param n: The count.
### :returns: The same count.
routine read(n: S64) -> S64
    return Counter.at(n).get()

### A count read through a temporary counter given as an argument.
### :param n: The count.
### :returns: Twice the count.
routine read_twice(n: S64) -> S64
    return sum(a: Counter.at(n), b: Counter.at(n))

### A count read through a temporary counter given as an argument of a routine called on the type.
### :param n: The count.
### :returns: The same count.
routine read_on_type(n: S64) -> S64
    return Counter.count_of(c: Counter.at(n))

### The count of a counter, called on the type.
### :param c: The counter.
### :returns: Its count.
routine Counter.count_of(c: @Me) -> S64
    return c.get()

### Writes what each temporary gave and where it ended.
routine start() -> None
    v: S64 = Counter.at(1).get()
    Console.show(" bound {v}")
    Console.show("argument {sum(a: Counter.at(2), b: Counter.at(3))}", end: "")
    Console.show("")
    if Counter.at(4).get() == 4
        Console.show(" if body")
    while Counter.at(5).get() == 6
        Console.show("never")
    Console.show(" after while")
    r: S64 = read(6)
    Console.show(" returned {r}")
    when Counter.at(7).get()
        7 => Console.show(" when arm")
        else => Console.show("other")
    w: S64 = when v
        1 => Counter.at(8).get()
        else => 0
    Console.show(" value when {w}")
    drop Counter.at(9)
    Console.show(" dropped once")
    t: S64 = read_twice(10)
    Console.show(" returned through arguments {t}")
    o: S64 = read_on_type(11)
    Console.show(" returned through a type's routine {o}")
    return
