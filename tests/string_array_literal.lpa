# A string literal is also an array literal whose count the build knows: its UTF-8 bytes where Bytes go, its code
# points where Chars go. A @[Byte] or @[Char] of it is a view with no copy, and an Items or a STACK &[...] a copy the
# routine can change.

import Hosted

routine start() -> None
    bytes: Items[Byte, 4] = "Lumi"
    hangul_bytes: Items[Byte, 6] = "루미"
    hangul_chars: Items[Char, 2] = "루미"
    placed: &Items[Char, 4] <- "Lumi"
    copy: &[Byte] <- "Lumi"
    chars: &[Char] <- "루미"
    view: @[Char] = "루미"
    read_only: @[Byte] = "Lumi"
    copy.getslot(0).poke(b'l')
    chars.getslot(1).poke('리')
    Console.show("{bytes.getitem(0).to[U8]()} {hangul_bytes.getitem(5).to[U8]()} {hangul_chars.getitem(1)}")
    Console.show("{copy.count()} {chars.count()} {view.count()} {read_only.count()}")
    Console.show("{copy.getview()} {read_only}")
    Console.show("{chars.getview()} {view}")
    Console.show("{placed.getview()}")
    return
