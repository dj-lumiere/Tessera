# Vector arithmetic is unchecked on every lane kind: a check on each lane would cost what SIMD saves. Integer lanes
# wrap where the scalar add would crash, and float lanes give the raw IEEE 754 result where the scalar one would crash.

import Hosted

routine start() -> None
    a: Vector[S16, 4] = [1, 2, 32767, 4]
    one: Vector[S16, 4] = .splat(1)
    sum: Vector[S16, 4] = a + one
    Console.show("add {sum.getitem(0)} {sum.getitem(2)}")
    low: Vector[S16, 4] = [-32768, 0, 5, 6]
    diff: Vector[S16, 4] = low - one
    Console.show("sub {diff.getitem(0)} {diff.getitem(1)}")
    big: Vector[U8, 4] = [200, 2, 3, 4]
    product: Vector[U8, 4] = big * Vector[U8, 4].splat(2)
    Console.show("mul {product.getitem(0)} {product.getitem(1)}")
    total: S16 = a.sum()
    Console.show("sum {total}")

    x: Vector[B64, 4] = [1.0, 0.0, -1.0, 1.0e308]
    zero: Vector[B64, 4] = .zero()
    q: Vector[B64, 4] = x / zero
    Console.show("div {q.getitem(0)} {q.getitem(1)} {q.getitem(2)}")
    huge: Vector[B64, 4] = x * Vector[B64, 4].splat(10.0)
    Console.show("mul {huge.getitem(3)}")
    root: Vector[B64, 4] = x.sqrt()
    Console.show("sqrt {root.getitem(2)}")
    return
