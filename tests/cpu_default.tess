// Without --cpu, x86_64 is the x86-64 baseline (v1): SSE2 but no AVX2 or FMA, so #feature picks the fallbacks and
// mul_add takes its software path. It is still a single rounding: (1+2^-52)(1-2^-53) - 1 is 2^-53 - 2^-105, not 0.

import Standard::Format
import Standard::Os

#feature("sse2")
routine sse2() -> Bytes
    block entry():
        return("sse2")

#feature(not "sse2")
routine sse2() -> Bytes
    block entry():
        return("no sse2")

#feature("avx2")
routine avx2() -> Bytes
    block entry():
        return("avx2")

#feature(not "avx2")
routine avx2() -> Bytes
    block entry():
        return("no avx2")

routine main() -> S32
    block entry():
        %r : F64 = F64.from_bits(0x3FF0000000000001).mul_add(F64.from_bits(0x3FEFFFFFFFFFFFFF),
                -1.0)
        print("{sse2()} {avx2()} {%r.bits()}\n")
        return(0)
