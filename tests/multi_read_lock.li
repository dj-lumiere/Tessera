# Shared read access: four threads read a pair of counters that must always be equal while two threads write them,
# each reader under shared read access and each writer under exclusive access. No reader ever sees them differ, and the
# writers' updates all land. From another thread, exclusive access can't be taken while a reader holds shared read
# access, and shared read access can't be taken while a writer holds exclusive access.

import Hosted

record Pair
    a: U64
    b: U64

record Counts
    torn: Unbroken[U64]

routine read_many(pair: @Pair, counts: @Counts) -> None
    until i == 20000 with i: U64 = 0
        reading: ReadAuthorized[Pair] <- pair.get_shared_read_access()
        view: @Pair = reading.getview()
        same: Bool = view.a.peek() == view.b.peek()
        drop reading
        if not same
            counts.torn.fetch_add(1)
        continue with i: i + 1
    then
        return

routine write_many(pair: @Pair, counts: @Counts) -> None
    until i == 10000 with i: U64 = 0
        held: Authorized[Pair] <- pair.get_exclusive_access()
        view: @Pair = held.getview()
        view.a.poke(view.a.peek() + 1)
        view.b.poke(view.b.peek() + 1)
        drop held
        continue with i: i + 1
    then
        return

routine try_access(pair: @Pair, mode: U8) -> Bool
    lateinit place: &SourceLocation

    taken: Bool = AccessManager.try_take(
        request: AccessRequest(at: pair, size: sizeof[Pair](), mode), place)
    if taken
        AccessManager.give_back(at: pair)
    return taken

routine elsewhere(pair: @Pair, mode: U8) -> Bool
    t: Thread[Bool] <- get_thread[Bool]()
    work_t: Work[Bool] = try_access.to[Work](pair: pair, mode: mode)
    t.put_work(work_t)
    taken: Bool = t.retrieve()
    drop t
    return taken

routine start() -> None
    pair: &Pair <- Pair(a: 0, b: 0)
    counts: &Counts <- Counts(torn: Unbroken[U64](value: 0))
    threads: &Slots[Thread[None], 6]

    for i: U64 in 0 til 6
        t: Thread[None] <- get_thread[None]()
        if i < 4
            work_t: Work[None] = read_many.to[Work](pair: pair, counts: counts)
            t.put_work(work_t)
            threads.getslot(i).poke(steal t)
        else
            work_t_2: Work[None] = write_many.to[Work](pair: pair, counts: counts)
            t.put_work(work_t_2)
            threads.getslot(i).poke(steal t)

    for i: U64 in 0 til 6
        steal threads.getslot(i) as t inject lateinit
        t.retrieve()
        drop t
    Console.show("a {pair.a.peek()}, b {pair.b.peek()}, torn reads {counts.torn.peek()}")
    reading: ReadAuthorized[Pair] <- pair.get_shared_read_access()
    write_while_read: Bool = elsewhere(pair, mode: ACCESS_WRITE)
    read_while_read: Bool = elsewhere(pair, mode: ACCESS_READ)
    drop reading
    writing: Authorized[Pair] <- pair.get_exclusive_access()
    read_while_written: Bool = elsewhere(pair, mode: ACCESS_READ)
    drop writing
    Console.show("exclusive while read: {write_while_read}, shared while read: {read_while_read}, shared while written: {read_while_written}")
    return
