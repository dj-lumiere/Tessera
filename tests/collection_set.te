# Set[S64] against a model. An LCG drives random add / remove / has in three phases (few keys, many keys to
# force rehashing, then a small key range on the large set). Every 500 operations a checkpoint prints the length, a
# running checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
# The expected output comes from an independent Python model of the collection.

import Collections
import Hosted

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[ConsoleOutput]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: U64
    ### How many operations the phase runs.
    ops: U64
    ### How many distinct keys the operations draw from.
    keys: U64

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: U64
    ### The operations run so far in the phase.
    op: U64
    ### The checksum of every result so far.
    results: S64

routine @Rng.below(bound: U64) -> U64
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: U64 = bucket.to[U64]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: @[Byte], value: S64) -> None
needs T obeys Writer
    out.write(" {label} {value}")
    return

# Folds every element in iteration order.
routine iteration_hash(set: @Set[S64]) -> S64
    iter_val: SetEmitter[S64] = .construct(set)
    iter: &SetEmitter[S64] <- iter_val

    loop with hash: S64 = 0
        item: Optional[S64] = try iter.emit()
        when item
            is S64 as key => continue with hash: mix(hash, value: key)
            is None => return hash

routine checkpoint(out: @BufWriter[ConsoleOutput], set: @Set[S64], at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: U64 = set.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(set))
    out.write("\n")
    return

# Runs ops random operations on keys below keys. Returns the updated results checksum.
@reshaping(set)
routine run_phase(harness: Harness, set: @Set[S64], phase: Phase, results: S64) -> S64
    rng: @Rng = harness.rng
    ops: U64 = phase.ops
    keys: U64 = phase.keys

    until op >= ops with op: U64 = 0, checksum: S64 = results
        key: S64 = rng.below(keys).to[S64]()
        kind: U64 = rng.below(10)
        is_add: Bool = kind < 5
        is_remove: Bool = kind < 7
        result: S64 = when
            is_add =>
                added: Bool = set.add(key)
                becomes added.to[S64]()
            is_remove =>
                removed: Bool = set.remove(key)
                becomes removed.to[S64]()
            else =>
                found: Bool = set.has(key)
                becomes found.to[S64]()
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: U64 = op + 1
        if op_next % 500 == 0
            checkpoint(out: harness.out, set,
                at: Checkpoint(phase: phase.number, op: op_next, results: mixed))
        continue with op: op_next, checksum: mixed
    then
        return checksum

# Copies from into to in iteration order, but starting from its second half, so the two sets hold the same elements
# in a different insertion order.
@reshaping(to)
routine copy_rotated(from: @Set[S64], to: @Set[S64]) -> None
    size: U64 = from.count()
    half: U64 = size // 2
    iter: &SetEmitter[S64] <- .hollow()

    loop with round: U64 = 0, second: Bool = true
        done2: Bool = round == 2
        iter_val2: SetEmitter[S64] = .construct(from)
        iter.store(iter_val2)
        if done2
            return
        else
            loop with index: U64 = 0
                item: Optional[S64] = try iter.emit()
                when item
                    is S64 as key =>
                        in_second: Bool = index >= half
                        if not (in_second == second)
                            continue with index: index + 1
                        else
                            to.add(key)
                            continue with index: index + 1
                    is None => break

            continue with round: round + 1, second: not second

routine report_eq(out: @BufWriter[ConsoleOutput], label: @[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    out: &BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    manager: @MemoryManager = HEAP
    rng: &Rng <- Rng(state: 1)
    set: &Set[S64] <- .construct(manager)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, set, phase: Phase(number: 1, ops: 3000, keys: 64), results: 0)
    r2: S64 = run_phase(harness, set, phase: Phase(number: 2, ops: 8000, keys: 5000), results: r1)
    r3: S64 = run_phase(harness, set, phase: Phase(number: 3, ops: 4000, keys: 300), results: r2)

    copied: &Set[S64] <- .construct(manager)
    report_eq(out, label: "empty copy equal", equal: set.eq(copied))
    copy_rotated(from: set, to: copied)
    report_eq(out, label: "rotated copy equal", equal: set.eq(copied))
    report_eq(out, label: "rotated copy same order",
        equal: iteration_hash(set) == iteration_hash(copied))
    copied.add(-1)
    report_eq(out, label: "extra element equal", equal: set.eq(copied))
    copied.remove(-1)
    report_eq(out, label: "extra element removed equal", equal: set.eq(copied))
    iter_val: SetEmitter[S64] = .construct(set)
    iter: &SetEmitter[S64] <- iter_val
    first: S64 = (try iter.emit()).unwrap()
    copied.remove(first)
    report_eq(out, label: "missing element equal", equal: set.eq(copied))
    report_eq(out, label: "missing element equal reversed", equal: copied.eq(set))
    copied.add(first)
    report_eq(out, label: "re-added element equal", equal: set.eq(copied))
    report_eq(out, label: "re-added element same order",
        equal: iteration_hash(set) == iteration_hash(copied))
    drop copied
    drop set
    out.flush()
    return
