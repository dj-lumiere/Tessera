# Decimal from Ingrid/Decimal has one form per value: no -0 (a zero result is 0) and no trailing zeros in the
# coefficient, so `1.0` and `1.00` hash the same. A routine that rounds on purpose takes a RoundingRule, and leaving
# it out gives the type's own rule: half up for Decimal, a tie to the even one for D64.

import Ingrid/Decimal
import Hosted

### Reads `text` as a Decimal.
### :param text: The text.
### :returns: The decimal.
routine dec(text: @[Byte]) -> Decimal
    return text.to[Decimal]()

### Shows `x` rounded to a whole number by every rule, then by the default one.
### :param x: The value.
routine decimal_rules(x: Decimal) -> None
    Console.show("{x}: {x.round(rule: RoundingRule.HALF_UP)} {x.round(rule: RoundingRule.HALF_EVEN)} {x.round(rule: RoundingRule.HALF_AWAY)} {x.round(rule: RoundingRule.FLOOR)} {x.round(rule: RoundingRule.CEIL)} {x.round(rule: RoundingRule.TRUNC)} default {x.round()}")
    return

### Shows `x` rounded to a whole number by every rule, then by the default one.
### :param x: The value.
routine d64_rules(x: D64) -> None
    Console.show("{x}: {x.round(rule: RoundingRule.HALF_UP)} {x.round(rule: RoundingRule.HALF_EVEN)} {x.round(rule: RoundingRule.HALF_AWAY)} {x.round(rule: RoundingRule.FLOOR)} {x.round(rule: RoundingRule.CEIL)} {x.round(rule: RoundingRule.TRUNC)} default {x.round()}")
    return

### Shows that a zero result is never -0.
routine zeros() -> None
    zero: Decimal = Decimal.zero()
    m1: Decimal = dec("-1")
    half: Decimal = dec("-0.5")
    one: Decimal = S64.to[Decimal](1)
    nz: Decimal = dec("-0")
    nzz: Decimal = dec("-0.00")
    Console.show("no -0: {nz} {nzz} {-zero} {zero * m1} {zero / m1} {m1 + one} {half.round()} {Fixed[Decimal](value: half, digits: 0)}")
    Console.show("diagnose: {nz.diagnose()}, negative: {nz.is_negative()}")
    return

### Shows that equal values have one form.
routine one_form() -> None
    a: Decimal = dec("1.0")
    b: Decimal = dec("1.00")
    c: Decimal = S64.to[Decimal](1)
    Console.show("hash: {a.hash() == b.hash()}, {a.hash() == c.hash()}, equal: {a == b}")
    sum: Decimal = dec("1.5") + dec("2.5")
    four: Decimal = S64.to[Decimal](4)
    hundred: Decimal = dec("100")
    sci: Decimal = dec("1e2")
    mixed: Decimal = dec("1.50e2")
    wide: Decimal = dec("12.5e3")
    tenth: Decimal = dec("2.50")
    Console.show("sum: {sum}, {sum.hash() == four.hash()}, text: {hundred} {sci} {mixed} {wide}, {hundred.hash() == sci.hash()}")
    Console.show("diagnose: {hundred.diagnose()}, {tenth.diagnose()}")
    return

### Shows the rounding rules.
routine rules() -> None
    Console.show("Decimal: half up, half even, half away, floor, ceil, trunc")
    decimal_rules(dec("2.5"))
    decimal_rules(dec("-2.5"))
    decimal_rules(dec("2.4"))
    decimal_rules(dec("-2.6"))
    Console.show("D64: half up, half even, half away, floor, ceil, trunc")
    d64_rules("2.5".to[D64]())
    d64_rules("-2.5".to[D64]())
    d64_rules("2.4".to[D64]())
    d64_rules("-2.6".to[D64]())
    price: Decimal = dec("2.675")
    tie: D64 = "2.665".to[D64]()
    Console.show("places: {price.round(places: 2)} {price.round(places: 2, rule: RoundingRule.TRUNC)} {tie.round(places: 2)} {tie.round(places: 2, rule: RoundingRule.HALF_UP)}")
    one: Decimal = dec("1")
    three: Decimal = dec("3")
    eight: Decimal = dec("8")
    pos2: Decimal = dec("2")
    neg2: Decimal = dec("-2")
    neg1: Decimal = dec("-1")
    Console.show("divide: {one.divide(by: three, places: 2)} {pos2.divide(by: three, places: 2, rule: RoundingRule.FLOOR)} {neg2.divide(by: three, places: 2)} {one.divide(by: eight, places: 2)} {neg1.divide(by: eight, places: 2)} {one.divide(by: eight, places: 2, rule: RoundingRule.HALF_EVEN)}")
    forty: U64 = 40
    when check one.divide(by: three, places: forty)
        is Decimal as q => Console.show("fits: {q}")
        is Crashables as e => Console.show("40 places of 1/3: {e.name()}")
    return

### Shows add, subtract, and multiply with places: exact, then rounded once, where the operators fail.
routine places_ops() -> None
    wide: Decimal = dec("1.23456789012345678901")
    ten: U64 = 10
    zero: U64 = 0
    one: U64 = 1
    two: U64 = 2
    Console.show("multiply: {try wide * wide} {wide.multiply(by: wide, places: ten)}")
    huge: Decimal = dec("1e30")
    tiny: Decimal = dec("1e-30")
    Console.show("add: {try huge + tiny} {huge.add(tiny, places: 2)} {huge.add(other: tiny, places: zero, rule: RoundingRule.CEIL)}")
    p: Decimal = dec("1.25")
    h: Decimal = dec("0.5")
    n: Decimal = dec("-1.25")
    Console.show("rules: {p.multiply(by: h, places: 2)} {p.multiply(by: h, places: 2, rule: RoundingRule.HALF_EVEN)} {n.multiply(by: h, places: 2, rule: RoundingRule.HALF_AWAY)} {n.multiply(by: h, places: 2, rule: RoundingRule.FLOOR)} {tiny.subtract(other: huge, places: zero, rule: RoundingRule.CEIL)} {p.subtract(other: tiny, places: one, rule: RoundingRule.TRUNC)}")
    return

routine start() -> None
    zeros()
    one_form()
    rules()
    places_ops()
    return
