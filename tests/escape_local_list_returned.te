# The address of a frame slot added to a local list, and the list returned.

import Standard/Collections
import Standard/Os

### A list that holds the address of a local.
### :returns: The list.
routine make() -> List[@S64]
    l: &S64 <- 1234567
    xs: &List[@S64] <- .construct()

    xs.add_last(l)
    return xs

routine start() -> None
    xs: &List[@S64] <- make()

    Console.show("{xs[0].peek()}")
    drop xs
    return
