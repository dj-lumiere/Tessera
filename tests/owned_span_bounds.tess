// OwnedSpan<T>.at checks the index like a Span: an address past the end crashes with IndexOutOfBoundsError at the
// caller's line, through the pointer receiver too.

import Standard::Alloc
import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    block entry()
        claim values : @OwnedSpan<S64> <- .construct(2)
        values.at(1).store(7)
        Out.write("values[1] = {values.at(1).load()}\n")
        values.at(2).store(8)
        Out.write("not reached\n")
        values.destruct()
        return(0)
