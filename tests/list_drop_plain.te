# drop ends a list: it ends each element (a plain S64 gives nothing back) and gives its memory back.

import Standard/Collections
import Standard/Hosted

### Fills a list of plain values and drops it.
routine start() -> None
    manager: @MemoryManager = HEAP
    l: &List[S64] <- .construct(manager)

    l.add_last(1)
    l.add_last(2)
    Console.show("{l}")
    drop l
    Console.show("dropped")
    return
