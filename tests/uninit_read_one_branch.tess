// A head slot only one branch fills: the other path reaches the load with nothing stored.
routine pick(flag: Bool) -> S64
    shared result : @S64 <- uninit

    block entry()
        branch flag
            ? fill()
            : skip()

    block fill()
        7.store_into(result)
        jump done()

    block skip()
        jump done()

    block done()
        return(result.load())

routine start() -> Void
    block entry()
        n : S64 = pick(true)
        return()
