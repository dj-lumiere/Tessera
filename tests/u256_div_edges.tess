// U256 division at algorithm D's edges, for the U64-limb form (64-bit targets) and the U32-limb one (32-bit
// targets), which must print the same. Each case also checks u = q × d + r with r < d. The limbs below are 32 bits,
// most significant first. The add-back cases are Hacker's Delight's (divmnu64), where q̂ survives Knuth's D3 test
// one too big.

import Standard/Format
import Standard/Os

/// The U256 with these 32-bit limbs, most significant first.
routine words(limbs: Array[U32, 8]) -> U256
    jump next(0, 0)

    block next(i: USize, value: U256)
        done: Bool = i.ge(8)
        branch done
            ? return(value)
            : continue
        limb: U256 = limbs.getitem(i).to[U256]()
        jump next(i.add(1), value.shl(32).bitor(limb))

routine check(name: Span[Byte], u: U256, d: U256) -> Void
    q: U256 = u.div(d)
    r: U256 = u.mod(d)
    back: U256 = q.mul_wrap(d).add_wrap(r)
    exact: Bool = back.eq(u).bitand(r.lt(d))
    verdict: Span[Byte] = verdict(exact)
    Out.write("{name}: q = {q}, r = {r} ({verdict})\n")
    return()

routine verdict(exact: Bool) -> Span[Byte]
    branch exact
        ? return("ok")
        : return("WRONG")

routine start() -> Void
    // Add back needed: q̂ passes D3 and is still one too big.
    check(name: "add back, 3 by 3", u: words([0, 0, 0, 0, 0, 0x80000000, 0, 3]),
        d: words([0, 0, 0, 0, 0, 0x20000000, 0, 1]))
    check(name: "add back, 4 by 3", u: words([0, 0, 0, 0, 0x7FFFFFFF, 0x80000000, 0, 0]),
        d: words([0, 0, 0, 0, 0, 0x80000000, 0, 1]))
    // D3 lowers q̂.
    check(name: "D3 correction", u: words([0, 0, 0, 0, 0, 0x80000000, 0x0000FFFE, 0]),
        d: words([0, 0, 0, 0, 0, 0, 0x80000000, 0x0000FFFF]))
    // The window's top limb equals the divisor's: q̂ starts above a limb.
    check(name: "q-hat over a limb", u: words([0, 0, 0x80000000, 0xFFFFFFFF, 0xFFFFFFFF, 0, 0, 0]),
        d: words([0, 0, 0, 0, 0, 0x80000000, 0xFFFFFFFF, 0xFFFFFFFF]))
    // Full width, divisors of every limb count.
    max: U256 = U256.MAX
    check(name: "max by 1 limb", u: max, d: words([0, 0, 0, 0, 0, 0, 0, 0xFFFFFFFF]))
    check(name: "max by 2 limbs", u: max, d: words([0, 0, 0, 0, 0, 0, 1, 0]))
    check(name: "max by 3 limbs", u: max,
        d: words([0, 0, 0, 0, 0, 0x12345678, 0x9ABCDEF0, 0x0FEDCBA9]))
    check(name: "max by 4 limbs", u: max,
        d: words([0, 0, 0, 0, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF]))
    check(name: "max by 5 limbs", u: max, d: words([0, 0, 0, 1, 0, 0, 0, 0]))
    check(name: "max by 7 limbs", u: max, d: words([0, 0x7FFFFFFF, 0, 0, 0, 0, 0, 1]))
    check(name: "max by 8 limbs", u: max, d: words([0x80000000, 0, 0, 0, 0, 0, 0, 0]))
    check(name: "max by max", u: max, d: max)
    check(name: "normalized top", u: words([0xFFFFFFFF, 0xFFFFFFFE, 0, 0, 0, 0, 0, 0]),
        d: words([0, 0xFFFFFFFF, 0xFFFFFFFF, 0, 0, 0, 0, 7]))
    check(name: "unnormalized, remainder", u: words([0, 0, 0, 0x5, 0x6, 0x7, 0x8, 0x9]),
        d: words([0, 0, 0, 0, 0, 0x3, 0x0, 0x2]))
    check(name: "fits 64 bits", u: words([0, 0, 0, 0, 0, 0, 0xFFFFFFFF, 0xFFFFFFFF]),
        d: words([0, 0, 0, 0, 0, 0, 0, 10]))
    check(name: "below", u: words([0, 0, 0, 0, 0, 0, 0, 5]), d: words([0, 0, 0, 0, 0, 0, 0, 6]))
    return()
