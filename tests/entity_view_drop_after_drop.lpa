# Giving back an entity made with a view after the view's memory is given back: the destruct the builder writes
# reads no view, so both orders build.
import Hosted

### Holds a view.
entity Holder
    data: @[Byte]

### Makes a holder.
### :param data: The view to keep.
### :returns: The holder.
common routine Holder.construct(data: @[Byte]) -> Me
    return Me(data)

### Gives the view's memory back first, then the holders.
routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP
    h: &Holder <- Holder.construct(data: m.getslice()) from HEAP
    here: &Holder <- Holder.construct(data: m.getslice())
    Console.show("{h.data.peek().count} {here.data.peek().count}")
    drop m
    drop h
    return
