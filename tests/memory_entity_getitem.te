# m[i] is the value at i, a copy, and an entity element is never copied: look at it through m.getslot(i), or take it
# out with steal m.getslot(i).

import Standard/Collections
import Standard/Os

routine start() -> None
    lists: &[List[S64]] <- Memory[List[S64]].construct(count: 1, manager: HEAP)

    lists.getslot(0).poke(List[S64].construct(HEAP))
    Console.show("{lists[0].count()}")
    lists.destruct_all()
    return
