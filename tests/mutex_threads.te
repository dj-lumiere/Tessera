# Four threads add to one counter under an ExclusiveAccess, so no increment is lost: the ExclusiveAccess is atomics plus
# wait_on / wake_one, the same on every operating system. try_lock from another thread fails while it is held.

import Standard/Os

record Shared
    lock: ExclusiveAccess
    count: U64

routine add_many(state: @Shared) -> None
    while i != 100000 with i: U64 = 0
        state.lock.lock()
        next_count: U64 = state.count.peek() + 1
        next_count.poke_into(state.count)
        state.lock.unlock()
        continue with i: i + 1
    then
        return

routine try_take(state: @Shared) -> Bool
    taken: Bool = state.lock.try_lock()
    if taken
        state.lock.unlock()
    return taken

routine start() -> None
    local state: @Shared <- Shared(lock: .construct(), count: 0)

    t1: Thread[None] = get_thread[None]()
    t1.put_work(entry: add_many.to[Callable](), args: state)
    t2: Thread[None] = get_thread[None]()
    t2.put_work(entry: add_many.to[Callable](), args: state)
    t3: Thread[None] = get_thread[None]()
    t3.put_work(entry: add_many.to[Callable](), args: state)
    t4: Thread[None] = get_thread[None]()
    t4.put_work(entry: add_many.to[Callable](), args: state)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    t3.wait_finished()
    t3.give_back()
    t4.wait_finished()
    t4.give_back()
    Console.show("{state.count.peek()}")
    Console.show("cpus: {cpu_count().gt(0)}")
    first: Bool = state.lock.try_lock()
    t5: Thread[Bool] = get_thread[Bool]()
    t5.put_work(entry: try_take.to[Callable](), args: state)
    t5.wait_finished()
    second: Bool = t5.retrieve()
    t5.give_back()
    state.lock.unlock()
    Console.show("try_lock: {first} then {second}")
    return
