# Four threads add to one counter, each under exclusive access to it, so no increment is lost. From another thread,
# taking the access without waiting fails while it is held.

import Standard/Os

record Shared
    count: U64

routine add_many(state: @Shared) -> None
    until i == 100000 with i: U64 = 0
        held: Authorized[Shared] <- state.get_exclusive_access()
        view: @Shared = held.getview()
        next_count: U64 = view.count.peek() + 1
        next_count.poke_into(view.count)
        drop held
        continue with i: i + 1
    then
        return

routine try_take(state: @Shared) -> Bool
    place: &SourceLocation <- .hollow()

    taken: Bool = AccessManager.try_take(at: state, size: sizeof[Shared](), mode: ACCESS_WRITE,
        place)
    if taken
        AccessManager.give_back(at: state)
    return taken

routine start() -> None
    state: &Shared <- Shared(count: 0)

    t1: Thread[None] = get_thread[None]()
    t1.put_work(entry: add_many.to[Callable](), args: state)
    t2: Thread[None] = get_thread[None]()
    t2.put_work(entry: add_many.to[Callable](), args: state)
    t3: Thread[None] = get_thread[None]()
    t3.put_work(entry: add_many.to[Callable](), args: state)
    t4: Thread[None] = get_thread[None]()
    t4.put_work(entry: add_many.to[Callable](), args: state)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    t3.wait_finished()
    t3.give_back()
    t4.wait_finished()
    t4.give_back()
    Console.show("{state.count.peek()}")
    Console.show("cpus: {cpu_count().gt(0)}")
    held: Authorized[Shared] <- state.get_exclusive_access()
    t5: Thread[Bool] = get_thread[Bool]()
    t5.put_work(entry: try_take.to[Callable](), args: state)
    t5.wait_finished()
    second: Bool = t5.retrieve()
    t5.give_back()
    drop held
    Console.show("taken without waiting while held: {second}")
    return
