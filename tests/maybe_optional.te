# T? is Maybe[T] for a T whose values hold nothing to give back, laid out as { i1, T }: the present flag, then the
# value, so .hollow() is None. For an entity T it is Optional[T], which holds the entity or nothing and lives in a
# place. Both are read with when, made by try, and written as T? or by their names.

import Hosted

### A counter that says when it ends.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Counter(n: n)

### Says it ends.
routine @Counter.destruct() -> None
    Console.show("end {me.n.peek()}")
    return

### Half of an even number.
### :param n: The number.
### :returns: Half of it.
### :throws: Throws `UnacceptedValueError` for an odd number.
failable routine half(n: S64) -> S64
    if n % 2 == 0
        return n // 2
    throw UnacceptedValueError(description: "odd")

### A counter for a positive count, or nothing.
### :param n: The count.
### :returns: The counter, or None.
routine counter_for(n: S64) -> Counter?
    if n > 0
        made: &Counter <- .construct(n)
        return made
    return None()

### Reads a Maybe.
### :param m: The value or None.
### :returns: The text.
routine describe(m: S64?) -> S64
    return when m
        is S64 as v => v
        is None => -1

routine start() -> None
    a: S64? = 7
    b: Maybe[S64] = None()
    c: Maybe[S64] = .hollow()
    Console.show("{describe(a)} {describe(b)} {describe(c)} {a.is_present()} {c.is_absent()}")
    Console.show("sizes {sizeof[S64?]()} {sizeof[Maybe[U8]]()} {sizeof[Maybe[Bool]]()} {alignof[S64?]()}")
    tried: S64? = try half(10)
    failed: S64? = try half(3)
    Console.show("{tried} {failed} {tried.unwrap_or(0)} {failed.unwrap_or(0)}")
    when counter_for(3)
        is Counter as made =>
            Console.show("made {made.n.peek()}")
            drop made
        is None => Console.show("none")
    kept: &Optional[Counter] <- counter_for(0)
    when steal kept
        is Counter as made =>
            drop made
        is None => Console.show("none for 0")
    return
