/// A record can hold itself only through a pointer.
record Loop
    next: Loop

/// Makes a `Loop` from its fields.
/// :param next: Its `next`.
/// :returns: The new value.
routine Loop.construct(next: Me) -> Me
    return(Me(next))

/// Releases nothing: a `Loop` holds no memory of its own.
routine Loop.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    s: U64 = sizeof[Loop]()
    return()
