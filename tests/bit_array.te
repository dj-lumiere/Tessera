# BitArray[BITS]: a record of BITS bits in (BITS + 7) // 8 bytes, copied by value. Reads by value and through the
# address, changes through the address, the clear high bits of the last byte after set_all / flip_all, counting,
# searching, the bitwise operators, equality, and iteration.

import Standard/Collections
import Standard/Hosted

### Writes the positions of the set bits, found with first_true and next_true.
### :param bits: The array to search.
routine show_set(bits: BitArray[12]) -> None
    Console.show("set at:", end: "")
    loop with found: Maybe[U64] = bits.first_true()
        when found
            is U64 as at =>
                Console.show(" {at}", end: "")
                continue with found: bits.next_true(after: at)
            is None => break
    Console.show("")
    return

### Counts the true bits by walking a BitArrayIter.
### :param bits: The array to walk.
### :returns: The number of true bits the iterator yields.
routine count_by_iter(bits: @BitArray[12]) -> U64
    iter: &BitArrayIter[12] <- .construct(bits)

    each bit in iter with total: U64 = 0
        if bit
            continue with total: total + 1
        continue with total: total
    then
        return total

routine start() -> None
    a: &BitArray[12] <- .zero()
    wide: &BitArray[64] <- .zero()

    Console.show("sizes: {sizeof[BitArray[12]]()} {sizeof[BitArray[64]]()} {sizeof[BitArray[65]]()}")
    Console.show("count {BitArray[12].count()} empty {BitArray[12].is_empty()} {BitArray[0].is_empty()}")
    Console.show("zero: {a.load()} none {a.is_none_true()} has true {a.has(true)}")

    each i: U64 in 0 til 12 by 5
        a.setitem(index: i, value: true)
    a.flip(11)
    Console.show("{a.load()}")
    Console.show("ones {a.count_trues()} zeros {a.count_falses()} [5] {a[5]} [6] {a[6]}")
    show_set(a.load())
    Console.show("by iterator: {count_by_iter(a)}")

    # A copy is its own value.
    b: BitArray[12] = a.load()
    a.flip(0)
    Console.show("copy kept [0]: {b[0]} {try b.getitem(0)}, original [0]: {a[0]}, eq {a.load().eq(b)}")
    a.flip(0)
    Console.show("eq again {a.load() == b} {a.load() != b}")

    # set_all and flip_all keep the four spare bits of the second byte clear.
    a.set_all(true)
    Console.show("set_all: ones {a.count_trues()} all {a.is_all_true()} lacks false {a.lacks(false)}")
    a.flip_all()
    Console.show("flip_all: ones {a.count_trues()} any {a.is_any_true()} first_true {a.first_true()}")

    # The bitwise operators make new arrays.
    a.setitem(index: 1, value: true)
    a.setitem(index: 2, value: true)
    c: BitArray[12] = a.load() | b
    d: BitArray[12] = c & b
    e: BitArray[12] = c ^ b
    f: BitArray[12] = ~e
    Console.show("or  {c}")
    Console.show("and {d} eq b {d == b}")
    Console.show("xor {e}")
    Console.show("not {f} ones {f.count_trues()} zeros {f.count_falses()}")
    Console.show("value reads: {f.is_all_true()} {f.is_none_true()} {f.has(false)} {f.lacks(true)} {f.next_true(after: 11)}")

    # A whole number of bytes: no spare bits.
    wide.set_all(true)
    wide.setitem(index: 63, value: false)
    Console.show("wide: ones {wide.count_trues()} [62] {wide[62]} [63] {wide[63]} {try wide.getitem(64)}")
    wide.flip_all()
    Console.show("wide flipped: ones {wide.count_trues()} first_true {wide.first_true()}")
    # Searching for false: the spare high bits of the last byte are never found.
    twelve: &BitArray[12] <- BitArray[12].zero()
    twelve.set_all(true)
    twelve.setitem(index: 3, value: false)
    Console.show("false: first {twelve.first_false()} next after 3 {twelve.next_false(after: 3)}")
    return
