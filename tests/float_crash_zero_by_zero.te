# Zero divided by zero has no result: it crashes with NumericDomainError, as in RazorForge.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("float_crash_zero_by_zero.te")
    Console.show("crashed: {name}: {message.text()} (this file {here}, line {place.line.peek()})")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    zero: B128 = B128.from_bits(0)
    r: B128 = zero / zero
    Console.show("not reached {r}")
    return
