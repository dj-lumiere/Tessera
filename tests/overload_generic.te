### A generic overload and a concrete one: an exact concrete match wins, and the generic one takes every other type.
### A routine's constraints are part of whether it fits.
import Standard/Hosted

routine kind[T](value: T) -> @[Byte]
needs T: typename
    return "generic"

routine kind(value: S64) -> @[Byte]
    return "S64"

routine order[T](a: T, b: T) -> @[Byte]
needs T: typename, Comparable[T]
    return "comparable"

routine order(a: Bool, b: Bool) -> @[Byte]
    return "two Bools"

routine start() -> None
    n: S64 = 1
    w: U32 = 2
    t: @[Byte] = "x"
    Console.show("{kind(n)} {kind(w)} {kind(t)}")
    Console.show("{order(a: w, b: w)} {order(a: true, b: false)}")
    Console.show("{kind[S64](n)}")
    return
