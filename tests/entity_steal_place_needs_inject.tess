import Standard/Os

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine Counter.destruct(me: @Me) -> None
    return

### Takes a counter over and ends it.
### :param c: The counter.
routine finish(c: Counter) -> None
    local slot: @Counter <- steal c
    drop slot
    return

entity Pair
    left: Counter

routine Pair.construct() -> Me
    return Me(left: .construct())

routine Pair.destruct(me: @Me) -> None
    drop me.left
    return

routine start() -> None
    local p: @Pair <- .construct()
    steal p.left as old
    finish(c: steal old)
    drop p
    return
