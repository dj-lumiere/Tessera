// F128 transcendentals are faithful: each result is one of the two F128 values around the
// true value (mpmath). Generated by scripts/gen_f128_math_tests.py; do not edit.

import Standard::Format
import Standard::Os

routine check(%out: @FdWriter, %r: F128, %lo: U128, %hi: U128) -> Void
    block entry():
        %bits : U128 = %r.bits()
        %ok   : Bool = %bits.eq(%lo).bitor(%bits.eq(%hi))
        branch %ok
            ? good()
            : bad(%bits)

    block good():
        write(%out, "ok\n")
        return()

    block bad(%bits: U128):
        write(%out, "outside: ")
        %bits.represent_hex(%out)
        write(%out, " not ")
        %lo.represent_hex(%out)
        write(%out, " / ")
        %hi.represent_hex(%out)
        write(%out, "\n")
        return()

