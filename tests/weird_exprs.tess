/// Expressions that are legal but stack features the way a real program does, in the spirit of rustc's
/// weird-exprs and its RazorForge and Suflae twins. Each line is a combination worth keeping working.
import Standard::Format
import Standard::Os

/// A single value.
record Box<T>
require T: typename
    value : T

/// Puts a value in a box.
/// :param x: The value.
/// :returns: The box.
routine wrap<T>(x: T) -> Box<T>
require T: typename
    block entry()
        return(Box<T> { value: x })

/// Adds up 1 to `last`, skipping multiples of 3, with the running state carried by block arguments and the
/// choice made by a `when` terminator.
/// :param last: The last number.
/// :returns: The sum.
routine skip_threes(last: S64) -> S64
    block entry()
        jump loop(1, 0)

    block loop(i: S64, sum: S64)
        done : Bool = i.gt(last)
        branch done
            ? return(sum)
            : continue
        when
            i.mod(3).eq(0) -> loop(i.add(1), sum)
            else           -> loop(i.add(1), sum.add(i))

/// Shows each combination on its own line.
routine start() -> Void
    block entry()
        a : S64 = 3
        b : S64 = 8

        // A value select whose two sides are method chains.
        m : S64 = a.lt(b)
            ? a.add(b).mul(2)
            : b.sub(a)
        Out.write("select_chains: {m}\n")

        // A generic call nested in a generic call, read through two fields inside a format hole.
        Out.write("nested_generic_in_hole: {wrap<Box<S64>>(wrap<S64>(5)).value.value}\n")

        // Load, act, store through a pointer, then read it back in a hole.
        claim p : @S64 <- 5
        p.load().add(1).store_into(p)
        p.load().mul(3).store_into(p)
        Out.write("pointer_chain: {p.load()}\n")

        // Conversions chained with arithmetic on both sides.
        n : S32 = 41
        w : S64 = n.to<U64>().add(1).to<S64>()
        Out.write("conversion_chain: {w} {w.to_wrap<U8>()}\n")

        // A record built from a select, its field read through a generic box.
        boxed : Box<S64> = wrap<S64>(b.gt(a) ? b : a)
        Out.write("select_into_generic: {boxed.value}\n")

        // A loop with block arguments and a when terminator.
        Out.write("skip_threes: {skip_threes(10)}\n")
        return()
