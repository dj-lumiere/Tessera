# The access a routine returns is one the caller holds: a caller that never gives it back is a build error.

import Standard/Os

global COUNTER: @U64

### Takes exclusive access to the counter and hands it to the caller.
### :returns: The access.
routine open_counter() -> Authorized[U64]
    return COUNTER.get_exclusive_access()

routine start() -> None
    held: Authorized[U64] = open_counter()
    held.getview().poke(3)
    return
