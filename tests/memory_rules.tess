# What the memory rules allow: a global that holds memory, changed with replace and given back in start's finish
# block, a copy of its own made with duplicate() and dropped on every pass of a loop, a slot dropped twice (the
# second drop finds it hollow and does nothing), memory handed to a routine that takes it over, and a view used
# before a #reshaping call, then taken again after it.

import Standard/Collections
import Standard/Format
import Standard/Os

global CACHE: @Memory[Byte]

### Takes `m` over and gives it back.
### :param m: The memory.
### :returns: How many bytes it held.
routine consume(m: Memory[Byte]) -> USize
    n: USize = m.count()
    drop m
    return n

@reshaping(items)
routine grow(items: @List[S64]) -> None
    items.add_last(2)
    return

routine start() -> None
    local out: @Out = Out.writer()
    local base: Memory[Byte] = [0x41, 0x42] x 3 at DEFAULT_HEAP
    local xs: @List[S64] <- .construct(alloc: DEFAULT_HEAP)

    CACHE.replace(Memory[Byte].construct(count: 4, manager: DEFAULT_HEAP))
    CACHE.replace(base.duplicate())

    each i in 0 til 3 with total: USize = 0
        copy: Memory[Byte] = base.duplicate()
        continue with total: total + consume(copy)
    then
        local slot: @Memory[Byte] <- base
        drop slot
        drop slot
        xs.add_last(1)
        first: @S64 = xs.getslot(0)
        before: S64 = first.peek()
        grow(xs)
        again: @S64 = xs.getslot(0)
        out.write("{total} {CACHE.count()} {before} {again.peek()} {xs.count()}\n")
        drop xs
        drop CACHE
        return
