# A type that holds something to release and writes no destruct gets the builder's: it drops each field that holds
# something, the last field first (an array field element by element, a variant the value of its branch), and the
# fields' own destructs do the same in turn. A destruct written by hand replaces the walk (Bell's says its name), and
# a generic record's field of a type parameter is dropped only when the instance holds something.

import Collections
import Hosted

### Says its name when it ends.
entity Bell
    name: @[Byte]

### Two bells and a number: no destruct of its own.
entity Tower
    first: Bell
    count: S64
    second: Bell

### A tower and a list: no destruct of its own either.
entity Town
    tower: Tower
    houses: List[S64]
    bells: Array[Bell, 2]

### A bell or nothing.
variant MaybeBell
    Bell
    None

### One value of any type.
entity Holder[T]
needs T: typename
    value: T

### A bell called `name`.
### :param name: Its name.
### :returns: The bell.
common routine Bell.construct(name: @[Byte]) -> Me
    return Me(name)

### Rings: says its name.
routine @Bell.destruct() -> None
    Console.show("ends {me.name.peek()}")
    return

### Makes a `Tower` from its fields.
### :param first: Its `first`.
### :param count: Its `count`.
### :param second: Its `second`.
### :returns: The new value.
common routine Tower.construct(first: Bell, count: S64, second: Bell) -> Me
    return Me(first: steal first, count, second: steal second)

### Makes a `Town` from its fields.
### :param tower: Its `tower`.
### :param houses: Its `houses`.
### :param bells: Its `bells`.
### :returns: The new value.
common routine Town.construct(tower: Tower, houses: List[S64], bells: Array[Bell, 2]) -> Me
    return Me(tower: steal tower, houses: steal houses, bells: steal bells)

### Makes a `Holder` from its fields.
### :param value: Its `value`.
### :returns: The new value.
common routine Holder[T].construct(value: T) -> Me
needs T: typename
    return Me(value: steal value)

routine start() -> None
    houses: &List[S64] <- .construct(manager: HEAP)
    houses.add_last(1)
    town: &Town <- .construct(
        tower: .construct(first: .construct(name: "first"), count: 2, second: .construct(name: "second")),
        houses: steal houses, bells: [Bell.construct(name: "left"), Bell.construct(name: "right")])
    drop town
    maybe: &MaybeBell <- Bell.construct(name: "maybe")
    drop maybe
    held: &Holder[Bell] <- .construct(value: .construct(name: "held"))
    drop held
    plain: &Holder[S64] <- .construct(value: 3)
    Console.show("plain {plain.value.peek()}")
    return
