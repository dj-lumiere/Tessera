// Buildtime sizeof / alignof must match what LLVM lays out at run time. Probe[T] copies T's layout from the
// buildtime values (an #aligned field over a byte array). The runtime sizeof / alignof of both must agree.

preset LARGER: S64 = max(sizeof[S32](), sizeof[S16]())

record Probe[T]
require T: typename
    #aligned(alignof[T]())
    bytes: Array[Byte, sizeof[T]()]

record Mixed
    a: S8
    b: S64
    c: S16

record Nested
    tag: S8
    inner: Mixed

record Wide
    tag: S8
    value: S128

choice Level: S8
    LOW
    HIGH

#[layout(align: 32)]
record Aligned32
    x: S8

record FieldAligned
    a: S8
    #aligned(16)
    b: S8

/// Makes a `Probe` from its fields.
/// :param bytes: Its `bytes`.
/// :returns: The new value.
routine Probe[T].construct(bytes: Array[Byte, sizeof[T]()]) -> Me
require T: typename
    return(Me(bytes))

/// Releases nothing: a `Probe` holds no memory of its own.
routine Probe[T].destruct(me: @Me) -> Void
require T: typename
    return()

/// Makes a `Mixed` from its fields.
/// :param a: Its `a`.
/// :param b: Its `b`.
/// :param c: Its `c`.
/// :returns: The new value.
routine Mixed.construct(a: S8, b: S64, c: S16) -> Me
    return(Me(a, b, c))

/// Releases nothing: a `Mixed` holds no memory of its own.
routine Mixed.destruct(me: @Me) -> Void
    return()

/// Makes a `Nested` from its fields.
/// :param tag: Its `tag`.
/// :param inner: Its `inner`.
/// :returns: The new value.
routine Nested.construct(tag: S8, inner: Mixed) -> Me
    return(Me(tag, inner))

/// Releases nothing: a `Nested` holds no memory of its own.
routine Nested.destruct(me: @Me) -> Void
    return()

/// Makes a `Wide` from its fields.
/// :param tag: Its `tag`.
/// :param value: Its `value`.
/// :returns: The new value.
routine Wide.construct(tag: S8, value: S128) -> Me
    return(Me(tag, value))

/// Releases nothing: a `Wide` holds no memory of its own.
routine Wide.destruct(me: @Me) -> Void
    return()

/// Makes a `Aligned32` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Aligned32.construct(x: S8) -> Me
    return(Me(x))

/// Releases nothing: a `Aligned32` holds no memory of its own.
routine Aligned32.destruct(me: @Me) -> Void
    return()

/// Makes a `FieldAligned` from its fields.
/// :param a: Its `a`.
/// :param b: Its `b`.
/// :returns: The new value.
routine FieldAligned.construct(a: S8, b: S8) -> Me
    return(Me(a, b))

/// Releases nothing: a `FieldAligned` holds no memory of its own.
routine FieldAligned.destruct(me: @Me) -> Void
    return()

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

routine check[T](name: @Byte) -> Void
require T: typename
    local size: USize = sizeof[T]()
    local align: USize = alignof[T]()
    local probe_size: USize = sizeof[Probe[T]]()
    local probe_align: USize = alignof[Probe[T]]()

    size_ok: Bool = size.eq(probe_size)
    align_ok: Bool = align.eq(probe_align)
    ok: Bool = size_ok.bitand(align_ok)
    branch ok
        ? same()
        : differ()

    block same()
        c_printf("%s ok\n", name)
        return()

    block differ()
        c_printf("%s: runtime %zu/%zu, compile time %zu/%zu\n", name, size, align, probe_size,
            probe_align)
        return()

routine start() -> Void
    check[S8]("S8")
    check[S16]("S16")
    check[S32]("S32")
    check[S64]("S64")
    check[S128]("S128")
    check[B16]("B16")
    check[BF16]("BF16")
    check[B32]("B32")
    check[B64]("B64")
    check[Bool]("Bool")
    check[@Byte]("Ptr")
    check[Array[S16, 3]]("Array")
    check[Mixed]("Mixed")
    check[Nested]("Nested")
    check[Wide]("Wide")
    check[Level]("Level")
    check[Aligned32]("Aligned32")
    check[FieldAligned]("FieldAligned")

    // #aligned really moves things: Aligned32 is one byte padded to 32, FieldAligned.b sits at offset 16.
    a32_size: USize = sizeof[Aligned32]()
    a32_align: USize = alignof[Aligned32]()
    fa_size: USize = sizeof[FieldAligned]()
    larger: USize = sizeof[Array[S8, LARGER]]()
    c_printf("%zu %zu %zu %zu\n", a32_size, a32_align, fa_size, larger)
    return()
