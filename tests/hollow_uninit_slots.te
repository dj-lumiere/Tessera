# A big array slot with no value starts zeroed: a memset rather than one whole-array store.

import Hosted

routine fill(buf: @Items[U8, 65536]) -> None
    buf.setitem(index: 0, value: 7)
    return

routine start() -> None
    zeroed: &Items[U8, 65536]
    raw: &Items[U8, 65536]
    n: &U64

    fill(buf: raw)
    n.store(5)
    Console.show("{zeroed.getitem(65535)} {raw.getitem(0)} {n.load()}")
    return
