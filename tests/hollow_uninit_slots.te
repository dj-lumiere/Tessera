# A big array slot starts zeroed with .hollow(), a memset rather than one whole-array store, or
# unwritten with .uninit(), which only a slot holding no pointer may.

import Standard/Os

routine fill(buf: @Array[U8, 65536]) -> None
    buf.setitem(index: 0, value: 7)
    return

routine start() -> None
    local zeroed: @Array[U8, 65536] <- .hollow()
    local raw: @Array[U8, 65536] <- .uninit()
    local n: @U64 <- .uninit()

    fill(buf: raw)
    n.poke(5)
    Console.show("{zeroed.getitem(65535)} {raw.getitem(0)} {n.peek()}")
    return
