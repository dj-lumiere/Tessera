# A C variable the program links against: #[external("c"), symbol(...)] on a global declares it (C's extern) and
# reads it through its pointer type. POSIX's environ, and on Windows the image's own header, which the linker defines
# as __ImageBase for MSVC and MinGW alike (the C runtime there has no environ variable, only __p__environ()).

import Hosted

@external("c")
@symbol("environ")
@target(os: not "windows")
global ENVIRON: &(@(@Byte?)?)

@external("c")
@symbol("__ImageBase")
@target(os: "windows")
global IMAGE_BASE: &CSize

@target(os: not "windows")
routine is_linked() -> Bool
    when ENVIRON.load()
        is @(@Byte?) as env => return env.peek().is_present()
        is None => return false

@target(os: "windows")
routine is_linked() -> Bool
    return IMAGE_BASE.load() != 0

routine start() -> None
    Console.show("{is_linked()}")
    return
