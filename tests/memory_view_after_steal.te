# A view used after its memory was handed over with steal.

import Standard/Os

### Takes memory over and gives it back.
### :param m: The memory.
routine consume(m: Memory[S64]) -> None
    drop m
    return

routine start() -> None
    m: &[S64] <- [1234567] * 4 from HEAP

    v: @[S64] = m.getslice()

    consume(steal m)
    Console.show("{v.getitem(0)}")
    return
