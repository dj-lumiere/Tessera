# A check of a ticket that holds an open set of failures needs an else arm: the arms name the failures it handles, and
# the rest can be any failure the program throws.

import Hosted

crashable BadInputError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### Says what the ticket's work gave.
### :param t: The ticket.
routine receive(t: @Thread[S64]) -> None
    when check t.retrieve()
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
    return

### Runs the example.
routine start() -> None
    return
