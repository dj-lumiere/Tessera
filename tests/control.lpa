# when v, when, value select, and inline terminators. The exit code encodes the result.

import Hosted

routine classify(x: S64) -> S64
    when
        x < 0 => return -1
        x == 0 => return 0
        x > 1000 => return 2
        else => return 1

routine op(code: S64, a: S64, b: S64) -> S64
    when code
        1 => return a + b
        2 => return a - b
        3 => return a * b
        else => unreachable

routine start() -> None
    c1: S64 = classify(-5)
    c2: S64 = classify(0)
    c3: S64 = classify(7)
    c4: S64 = classify(5000)
    # -1 + 0 + 1 + 2 = 2
    first_three: S64 = c1 + c2 + c3
    cs: S64 = first_three + c4
    # (6 + 4) * (6 - 4) * 3 = 60 ... computed through op
    s: S64 = op(code: 1, a: 6, b: 4)
    d: S64 = op(code: 2, a: 6, b: 4)
    p: S64 = op(code: 3, a: s, b: d)
    m: S64 = op(code: 3, a: p, b: 3)
    neg: Bool = m < 0
    abs: S64 = when
        neg => 0
        else => m
    total: S64 = abs + cs
    set_exit_code(total.to_wrap[S32]())
    return
