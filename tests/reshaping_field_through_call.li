# What a routine moves is found through the routines it calls: a routine that reaches the walked field two calls down is not allowed in the loop.

import Collections
import Hosted

### A box with two lists.
entity Box
    rows: List[List[U64]]
    log: List[U64]

### A box with empty lists.
### :returns: The box.
common routine Box.construct() -> Me
    return Me(rows: .construct(HEAP), log: .construct(HEAP))

### Adds to the rows.
### :param x: The value.
routine @Box.grow(x: U64) -> None
    row: &List[U64] <- .construct(HEAP)
    row.add_last(x)
    me.rows.add_last(steal row)
    return

### Adds to the log, then calls grow.
### :param x: The value.
routine @Box.wrap(x: U64) -> None
    me.log.add_last(x)
    me.grow(x)
    return

routine start() -> None
    b: &Box <- .construct()
    row: &List[U64] <- .construct(HEAP)
    row.add_last(1)
    b.rows.add_last(steal row)
    for x in b.rows.getslot(0).emitter()
        b.wrap(x)
    Console.show(b.rows.count())
    return
