// A List<Byte> is a Writer: write appends to it, growing through its allocator, and to_string views the result.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine main() -> S32
    shared alloc : @Allocator  <- make_heap_allocator()
    shared buf   : @List<Byte> <- .construct(alloc)

    block entry()

        name  : Bytes = "Tessera"
        count : U64   = 3
        buf.write("Hello, {name}! You have {count} messages.")
        buf.write("")
        jump grow(0)

    // many appends force several reallocations
    block grow(i: USize)
        done : Bool = i.ge(20)
        branch done
            ? show()
            : append(i)

    block append(i: USize)
        buf.write(" {i}")
        jump grow(i.add(1))

    block show()
        text : Bytes = buf.to<Bytes>()
        Out.write("{text}\n")
        Out.write("{buf.count()} bytes\n")
        buf.destruct()
        return(0)
