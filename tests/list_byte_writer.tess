// A List<Byte> is a Writer: write appends to it, growing through its allocator, and to_string views the result.
routine main() -> S32
    block entry():
        %heap  : Allocator      = make_heap_allocator()
        #alloc : Ptr<Allocator> = claim
        #alloc.store(%heap)
        %buf_val : List<Byte>      = .construct(#alloc)
        #buf     : Ptr<List<Byte>> = claim
        #buf.store(%buf_val)

        %name  : String = "Tessera"
        %count : U64    = 3
        write(#buf, "Hello, {%name}! You have {%count} messages.")
        write(#buf, "")
        jump grow(#buf, 0)

    // many appends force several reallocations
    block grow(#buf: Ptr<List<Byte>>, %i: U64):
        %done : Bool = %i.ge(20)
        branch %done ? show(#buf) : append(#buf, %i)

    block append(#buf: Ptr<List<Byte>>, %i: U64):
        write(#buf, " {%i}")
        jump grow(#buf, %i.add(1))

    block show(#buf: Ptr<List<Byte>>):
        %text : String = #buf.to_string()
        print("{%text}\n")
        print("{#buf.length()} bytes\n")
        #buf.destruct()
        return(0)
