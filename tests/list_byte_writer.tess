// A List<Byte> is a Writer: write appends to it, growing through its allocator, and to_string views the result.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine main() -> S32
    block entry()
        claim alloc : @Allocator  <- make_heap_allocator()
        claim buf   : @List<Byte> <- .construct(alloc)

        name  : Bytes = "Tessera"
        count : U64   = 3
        buf.write("Hello, {name}! You have {count} messages.")
        buf.write("")
        jump grow(buf, 0)

    // many appends force several reallocations
    block grow(buf: @List<Byte>, i: USize)
        done : Bool = i.ge(20)
        branch done
            ? show(buf)
            : append(buf, i)

    block append(buf: @List<Byte>, i: USize)
        buf.write(" {i}")
        jump grow(buf, i.add(1))

    block show(buf: @List<Byte>)
        text : Bytes = buf.load().to<Bytes>()
        Out.write("{text}\n")
        Out.write("{buf.load().count()} bytes\n")
        buf.destruct()
        return(0)
