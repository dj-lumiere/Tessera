# A routine that says it moves one field of me can't move another.

import Collections
import Hosted

### A box with two lists.
entity Box
    rows: List[List[U64]]
    log: List[U64]

### A box with empty lists.
### :returns: The box.
common routine Box.construct() -> Me
    return Me(rows: .construct(HEAP), log: .construct(HEAP))

### Adds to the rows and says it moves the log.
### :param x: The value.
@reshaping(me.log)
routine @Box.wrong(x: U64) -> None
    row: &List[U64] <- .construct(HEAP)
    row.add_last(x)
    me.rows.add_last(steal row)
    return

routine start() -> None
    b: &Box <- .construct()
    b.wrong(1)
    Console.show(b.rows.count())
    return
