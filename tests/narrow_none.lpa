import Hosted

### A pair that may have a second number.
record Pair
    first: S64
    second: S64?

### Doubles `x`, or gives 0 when there is none.
### :param x: The number, if any.
### :returns: Twice the number.
routine twice(x: S64?) -> S64
    when x
        is None => return 0
    return x + x

### The sum of both numbers, or just the first.
### :param p: The pair.
### :returns: The sum.
routine total(p: Pair) -> S64
    when p.second
        is None => return p.first
        else => nothing
    return p.first + p.second

### Triples `x` the long way.
### :param x: The number, if any.
### :returns: Three times the number.
routine triple(x: S64?) -> S64
    when x
        is None => return 0
        else => nothing
    n: S64 = x * 3
    return n

Console.show("{twice(4)} {twice(None())}")
Console.show("{total(Pair(first: 1, second: 2))} {total(Pair(first: 5, second: None()))}")
Console.show("{triple(5)} {triple(None())}")
