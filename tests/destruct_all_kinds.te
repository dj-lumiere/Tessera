# drop ends the elements of the other owning collections too: a CircularList of lists and a List of sets.

import Standard/Collections
import Standard/Os

### Drops collections that own collections.
routine start() -> None
    manager: @MemoryManager = HEAP
    c: &CircularList[List[S64]] <- .construct(manager)

    c.add_last(List[S64].construct(manager))
    c.add_first(List[S64].construct(manager))
    c.getslot(0).add_last(4)
    Console.show("{c}")
    drop c
    s: &List[Set[S64]] <- .construct(manager)
    s.add_last(Set[S64].construct(manager))
    s.getslot(0).add(9)
    Console.show("{s}")
    drop s
    Console.show("ok")
    return
