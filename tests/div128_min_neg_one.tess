// S128.MIN / -1 overflows (the quotient, 2^127, isn't an S128) and crashes with IntegerOverflowError, on 64-bit
// and 32-bit targets alike; div_wrap and div_checked are the forms that don't (div128_edges.tess).

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

/// Reports the crash on stdout, where the golden test sees it, and exits with status 3.
#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("crashed: {name}: {message}\n")
        exit(3)

routine main() -> S32
    block entry()
        min       : S128 = S128.MIN
        minus_one : S128 = -1
        Out.write("before\n")
        q : S128 = min.div(minus_one)
        Out.write("not reached {q}\n")
        return(0)
