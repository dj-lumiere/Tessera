// A conversion names the type it goes to, so generic code converts once its type parameter is known, and a
// pointer's to<@U> binds U from the call.

import Standard::Format
import Standard::Os

routine widen<T>(x: S32) -> T
require T: typename
    block entry()
        r : T = x.to<T>()
        return(r)

routine main() -> S32
    block entry()
        a : S64 = widen<S64>(-5)
        b : F64 = widen<F64>(3)
        Out.write("{a} {b}\n")
        claim slot : @U64 <- 0x3FF0000000000000
        f   : F64 = slot.to<@F64>().load()
        big : S64 = 300
        Out.write("{f} {a.to_wrap<U8>()} {big.to_clamp<U8>()}\n")
        return(0)
