# A bare call of a failable routine that fails stops the program on the call's line, through the Crash service: its
# report goes to standard error, and the exit status is 82. What was written before stays.

import Hosted

crashable EmptyError
    nothing

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine EmptyError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("there is nothing to take")
    return

### Fails for zero.
failable routine take(n: S64) -> S64
    if n == 0
        throw EmptyError()
    return n

routine start() -> None
    first: S64 = take(5)
    Console.show("first: {first}")
    second: S64 = take(0)
    Console.show("second: {second}")
    Console.show("not reached")
    return
