// Array<T, COUNT> { ... } makes an array value from a literal, a load through a pointer of the array type reads one from
// memory, and a claimed array slot is filled with a store like every other slot.

import Standard::Format
import Standard::Os

routine sum3(a: Array<S64, 3>) -> S64
    block entry()
        claim slot : @Array<S64, 3> <- a
        first_two : S64 = slot.getitem(0).add(slot.getitem(1))
        s         : S64 = first_two.add(slot.getitem(2))
        return(s)

routine main() -> S32
    block entry()
        x : S64           = 7
        a : Array<S64, 3> = Array<S64, 3> { 1, 2, x }
        Out.write("{sum3(a)}\n")

        grid_val : Array<Array<S16, 3>, 2> = Array<Array<S16, 3>, 2> { Array<S16, 3> { 1, 2, 3 },
            Array<S16, 3> { 4, 5, 6 } }
        claim grid : @Array<Array<S16, 3>, 2> <- grid_val
        claim row  : @Array<S16, 3>           <- grid.getitem(1)
        Out.write("{row.getitem(2).to<S64>()}\n")

        // a load through @Array<S64, 3> copies 3 values out of memory
        claim wide : @Array<S64, 5> <- Array<S64, 5> { 10, 20, 30, 40, 50 }
        middle : @S64          = wide.to<@S64>().stride(1)
        b      : Array<S64, 3> = middle.to<@Array<S64, 3>>().load()
        Out.write("{sum3(b)}\n")
        return(0)
