# Array[T, COUNT] { ... } makes an array value from a literal, a load through a pointer of the array type reads one from
# memory, and a claimed array slot is filled with a store like every other slot.

import Standard/Format
import Standard/Os

routine sum3(a: Array[S64, 3]) -> S64
    local slot: @Array[S64, 3] <- a
    first_two: S64 = slot[0] + slot[1]
    s: S64 = first_two + slot[2]
    return s

routine start() -> None
    x: S64 = 7
    a: Array[S64, 3] = [1, 2, x]
    Out.write("{sum3(a)}\n")

    grid_val: Array[Array[S16, 3], 2] = [[1, 2, 3], [4, 5, 6]]
    local grid: @Array[Array[S16, 3], 2] <- grid_val
    local row: @Array[S16, 3] <- grid[1]
    Out.write("{row.getitem(2).to[S64]()}\n")

    # a load through @Array[S64, 3] copies 3 values out of memory
    local wide: @Array[S64, 5] <- [10, 20, 30, 40, 50]
    middle: @S64 = wide.to[@S64]().stride(1)
    b: Array[S64, 3] = middle.to[@Array[S64, 3]]().peek()
    Out.write("{sum3(b)}\n")
    return
