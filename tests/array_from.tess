// Array<T, N>.from([...]) makes an array value from a literal, from_ptr reads one from memory, and a claimed
// array slot is filled with a store like every other slot.
routine sum3(%a: Array<S64, 3>) -> S64
    block entry():
        claim #slot : Ptr<Array<S64, 3>>
        #slot.store(%a)
        %s : S64 = #slot.get(0).add(#slot.get(1)).add(#slot.get(2))
        return(%s)

routine main() -> S32
    block entry():
        %x : S64           = 7
        %a : Array<S64, 3> = .from([1, 2, %x])
        print("{sum3(%a)}\n")

        %grid : Array<Array<S16, 3>, 2> = .from([[1, 2, 3], [4, 5, 6]])
        claim #grid : Ptr<Array<Array<S16, 3>, 2>>
        #grid.store(%grid)
        %row : Array<S16, 3> = #grid.get(1)
        claim #row : Ptr<Array<S16, 3>>
        #row.store(%row)
        print("{#row.get(2).to_s64()}\n")

        // from_ptr copies N values out of memory
        %wide : Array<S64, 5> = .from([10, 20, 30, 40, 50])
        claim #wide : Ptr<Array<S64, 5>>
        #wide.store(%wide)
        #middle : Ptr<S64>      = #wide.to_ptr()[1]
        %b      : Array<S64, 3> = .from_ptr(#middle)
        print("{sum3(%b)}\n")
        return(0)
