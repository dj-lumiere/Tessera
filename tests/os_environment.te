# OsEnvironment and OsEntropy: the arguments (none under the test runner), a variable that is set (PATH) and one that
# isn't, a snapshot of every variable, the working and temporary directories, two draws of random bits, and the
# partition the working directory is on.

import Standard/Collections
import Standard/Os

routine start() -> None
    Console.show("arguments: {OsEnvironment.argument_count()}")
    when OsEnvironment.variable("PATH")
        is BorrowedSlice[Byte] as path =>
            Console.show("PATH set: {not path.getslice().is_empty()}")
            drop path
        is None => Console.show("PATH set: false")
    when OsEnvironment.variable("TESSERA_NOT_A_VARIABLE_ANYWHERE")
        is BorrowedSlice[Byte] as value =>
            Console.show("a variable nobody set: true")
            drop value
        is None => Console.show("a variable nobody set: false")
    all: &List[EnvironmentEntry] <- OsEnvironment.variables()
    Console.show("snapshot has variables: {all.count() > 0}")
    drop all
    working: &Directory <- OsEnvironment.working_directory()
    temp: &Directory <- OsEnvironment.temp_directory()
    Console.show("working: {not working.path.peek().is_empty()}, temporary: {not temp.path.peek().is_empty()}")

    first: U64 = OsEntropy.next_u64()
    second: U64 = OsEntropy.next_u64()
    Console.show("two draws differ: {first != second}")

    partition: &PartitionManager <- OsFileManager.partition(at: working)
    Console.show("working directory's partition is mounted: {not partition.mounted_at.getslice().is_empty()}")
    drop partition
    drop temp
    drop working
    return
