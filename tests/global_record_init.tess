// A global or a preset in memory can start as a record literal, field by field, and a Callable field can start as a
// routine (name.to[Callable]()): the linker knows its address, so the record is ready before start runs. That is how
// Standard/Os gives DEFAULT_HEAP its malloc, realloc, and free.

import Standard/Format
import Standard/Os

global HANDLER: @Handler <- (id: 1, on: double.to[Callable](), where: (x: 1, y: -2), calls: 0)
global LENGTH: @Meters <- (value: 42)

preset NEGATE: @Handler <- (id: 2, on: negate.to[Callable](), where: (x: 3, y: 4), calls: 7)

record Point
    x: S64
    y: S64

record Handler
    id: U32
    on: Callable[(S64,), S64]
    where: Point
    calls: U32

/// One field: the record is that field underneath.
record Meters
    value: U64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

/// Makes a `Handler` from its fields.
/// :param id: Its `id`.
/// :param on: Its `on`.
/// :param where: Its `where`.
/// :param calls: Its `calls`.
/// :returns: The new value.
routine Handler.construct(id: U32, on: Callable[(S64,), S64], where: Point, calls: U32) -> Me
    return(Me(id, on, where, calls))

/// Releases nothing: a `Handler` holds no memory of its own.
routine Handler.destruct(me: @Me) -> Void
    return()

/// Makes a `Meters` from its fields.
/// :param value: Its `value`.
/// :returns: The new value.
routine Meters.construct(value: U64) -> Me
    return(Me(value))

/// Releases nothing: a `Meters` holds no memory of its own.
routine Meters.destruct(me: @Me) -> Void
    return()

routine double(n: S64) -> S64
    return(n.mul(2))

routine negate(n: S64) -> S64
    return(n.neg())

routine start() -> Void
    on: Callable[(S64,), S64] = HANDLER.on.peek()
    Out.write("{HANDLER.id.peek()}: {on.call(21)}, at {HANDLER.where.x.peek()}, {HANDLER.where.y.peek()}\n")
    calls: U32 = HANDLER.calls.peek().add(1)
    HANDLER.calls.poke(calls)
    Out.write("calls {HANDLER.calls.peek()}\n")
    HANDLER.on.poke(negate.to[Callable]())
    again: Callable[(S64,), S64] = HANDLER.on.peek()
    Out.write("swapped: {again.call(21)}\n")
    fixed: Handler = NEGATE.peek()
    Out.write("{fixed.id}: {fixed.on.call(5)}, at {fixed.where.x}, {fixed.where.y}, calls {fixed.calls}\n")
    Out.write("length {LENGTH.value.peek()}\n")
    return()
