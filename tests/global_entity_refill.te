# A global that holds an entity changes its value by taking the old one out (steal ... inject) or by ending it first
# (drop), each of which ends the old value exactly once.
import Hosted

global G: &Noisy <- .hollow()

entity Noisy
    n: S64

common routine Noisy.construct(n: S64) -> Me
    return Me(n)

routine @Noisy.destruct() -> None
    Console.show("destruct {me.n.peek()}")
    return

routine start() -> None
    G.poke(Noisy.construct(n: 1))
    steal G as old inject Noisy.construct(n: 2)
    drop old
    Console.show("holds {G.n.peek()}")
    drop G
    G.poke(Noisy.construct(n: 3))
    drop G
    return
