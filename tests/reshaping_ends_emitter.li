# An emitter walks what its list holds, so it ends at a #reshaping call on the list.

import Collections
import Hosted

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)
    xs.add_last(5)
    e: &ListEmitter[S64] <- xs.emitter()
    xs.add_last(6)
    v: S64 = e.emit()
    Console.show(v)
    drop xs
    return
