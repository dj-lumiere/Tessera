# An Optional stays in the frame its entity lives in: this is a build error that says what to write.
import Collections
import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### A counter for a positive count, or nothing.
### :param n: The count.
### :returns: The counter, or None.
routine counter_for(n: S64) -> Counter?
    if n > 0
        made: &Counter <- .construct(n)
        return made
    return None()

routine start() -> None
    xs: &List[Counter?] <- .construct(HEAP)
    return
