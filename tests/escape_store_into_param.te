# `v.store_into(box)` is a store into the box: a view of this frame stored into a box the caller passed outlives the
# routine.

import Standard/Os

### Keeps the address of a local in the box.
### :param box: The box to write to.
routine keep(box: @&@S64) -> None
    l: &S64 <- 7
    view: @S64 = l.getview()
    view.store_into(box)
    return

### Calls keep.
routine start() -> None
    box: &@S64 <- .hollow() from HEAP
    keep(box)
    drop box
    return
