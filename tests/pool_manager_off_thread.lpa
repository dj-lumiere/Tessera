# A work that doesn't touch the pool builds and runs next to a pool the main thread uses.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### The work: it only prints a number it was handed.
### :param n: The number.
routine show_number(n: S64) -> None
    Console.show("work {n}")
    return

routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    s: Stamped[Node] = PoolManager.add(Node.construct(value: 7))
    t: Thread[None] <- get_thread[None]()
    w: Work[None] = show_number.to[Work](n: 5)
    t.put_work(w)
    t.retrieve()
    drop t
    Console.show("pool {s.fetch().value.peek()}")
    drop pool
    return
