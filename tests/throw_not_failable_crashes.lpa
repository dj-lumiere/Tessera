# A throw in an infallible routine stops the program there, with the crashable's name and message, even when a try
# waits further up: the routine promises not to fail, so a failure inside it breaks the promise.

import Hosted

crashable NopeError
    nothing

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine NopeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("nope")
    return

### Infallible: its throw stops the program on its line.
### :returns: Never.
infallible routine refuse() -> S64
    throw NopeError()

### Passes failures on, but the failure of refuse never reaches it.
### :returns: Never.
routine outer() -> S64
    return refuse() + 1

routine start() -> None
    Console.show("before")
    got: Optional[S64] = try outer()
    when got
        is S64 as v => Console.show("not reached: {v}")
        is None => Console.show("not reached: none")
    return
