# An entity made with a view of a place of this routine, handed into a global: rule 6, like the view itself.
import Hosted

### Holds a view.
entity Holder
    data: @[Byte]

### Makes a holder.
### :param data: The view to keep.
### :returns: The holder.
common routine Holder.construct(data: @[Byte]) -> Me
    return Me(data)

### Where the holder goes.
lateinit global KEPT: &Holder

### Hands the holder to a global.
routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP
    h: &Holder <- Holder.construct(data: m.getslice())
    KEPT.poke(steal h)
    drop m
    return
