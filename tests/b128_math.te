# B128 transcendentals are faithful: each result is one of the two B128 values around the
# true value (mpmath).

import Standard/Os

routine check(out: @ConsoleOutput, r: B128, lo: U128, hi: U128) -> None
    bits: U128 = r.bits()

    if bits == lo or bits == hi
        out.write("ok\n")
        return
    else
        out.write("outside: ")
        bits.represent_hex_into(out)
        out.write(" not ")
        lo.represent_hex_into(out)
        out.write(" / ")
        hi.represent_hex_into(out)
        out.write("\n")
        return

