# OsFileManager.copy_result reports the bytes it copied (an empty file, a small one, and one of several chunks), each
# copy the same size as its source, and a copy that fails (the source is a directory) leaves nothing at the
# destination: on Linux and macOS the destination used to stay behind, made and empty, after the read failed.

import Standard/Collections
import Standard/Os

### The size of a file, or U64.MAX when it can't be read.
### :param f: The file.
### :returns: Its size in bytes.
routine size_of(f: @File) -> U64
    m: Check[Metadata] = check OsFileManager.metadata(at: f)
    when m
        is Metadata as info => return info.size
        is FsError => return U64.MAX

### Writes `count` bytes to a file in `root`, copies it, and prints what the copy reported.
### :param root: The test's directory.
### :param count: The file's size.
### :param alloc: The allocator for the paths and the text.
routine copy_of(root: @Directory, count: U64, alloc: @MemoryManager) -> None
    local text: @List[Byte] <- .construct(alloc)

    each i in 0 til count
        letter: U8 = (i % 26).to[U8]() + 97
        text.add_last(letter.bits())
    local source: @File <- root.file(name: "source.txt", alloc)
    local target: @File <- root.file(name: "target.txt", alloc)
    discard_made: Check[None] = check OsFileManager.make_file(at: source, replacing: true)
    discard_written: Check[None] = check OsFileManager.write_all(at: source, data: text.getview())
    r: Check[U64] = check OsFileManager.copy(from: source, to: target, replacing: true)
    when r
        is U64 as n =>
            same: Bool = size_of(target) == n
            Console.show("{count} bytes: copied {n}, the copy has as many {same}")
        is FsError => Console.show("{count} bytes: failed")
    drop target
    drop source
    drop text
    return

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local tmp: @Directory <- OsEnvironment.temp_directory(alloc)
    local root: @Directory <- tmp.go_to(name: "tessera_fs_copy", alloc)

    discard_old: Check[None] = check OsFileManager.delete_all(at: root, alloc)
    discard_made: Check[None] = check OsFileManager.make_directory(at: root, parents: true)
    copy_of(root, count: 0, alloc)
    copy_of(root, count: 5, alloc)
    copy_of(root, count: 100000, alloc)
    local inner: @Directory <- root.go_to(name: "inner", alloc)
    local target: @File <- root.file(name: "from_directory.txt", alloc)
    discard_inner: Check[None] = check OsFileManager.make_directory(at: inner, parents: false)
    r: Maybe[U64] = try OsFileManager.copy(from: File.at(inner.path.peek()), to: target,
        replacing: false)
    left: Bool = OsFileManager.is_present(at: target)
    Console.show("copying a directory fails: {r.is_absent()}, leaves a file behind: {left}")
    discard_gone: Check[None] = check OsFileManager.delete_all(at: root, alloc)
    drop target
    drop inner
    drop root
    drop tmp
    return
