# Byte literals are Byte, character literals are Char, and hex / binary / octal integer literals take their type
# from context.

import Standard/Hosted

@external("c")
@symbol("putchar")
routine c_putchar(c: CInt) -> CInt

routine put_byte(b: Byte) -> None
    c_putchar(b.to[U8]().to[S32]())
    return

### Maps a byte to a letter class through a when on byte literals.
routine class_of(b: Byte) -> Byte
    when b
        b'a', b'e' => return b'V'
        b'\n' => return b'N'
        else => return b'C'

routine start() -> None
    put_byte(class_of(b'a'))
    put_byte(class_of(b'x'))
    put_byte(class_of(b'\n'))
    put_byte(b'\n')
    snow: Char = '\u002603'
    is_snowman: Bool = snow.to[U32]() == 0x2603
    mask: S64 = 10 | 5
    ok_mask: Bool = mask == 15
    big: Byte = 0xFF
    ok_big: Bool = big.to[U8]() == 255
    all: Bool = is_snowman and ok_mask and ok_big
    code: S32 = when
        all => 0
        else => 1
    set_exit_code(code)
    return
