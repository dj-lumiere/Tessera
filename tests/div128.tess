# U128 / S128 division (Div128.tess: Knuth's algorithm D on U64 limbs, or on 32-bit limbs on a 32-bit target)
# against LLVM's own division, on operands of every bit length so each path runs: both in one limb, a one-limb
# divisor (normalized by 0 to 63 bits), and a two-limb divisor.

import Standard/Format
import Standard/Os

### xorshift64*
routine next(state: @U64) -> U64
    x0: U64 = state.peek()
    x1: U64 = x0 ^ (x0 >> 12)
    x2: U64 = x1 ^ (x1 << 25)
    x3: U64 = x2 ^ (x2 >> 27)
    state.poke(x3)
    return x3 *% 0x2545F4914F6CDD1D

### A random U128 of a random bit length (1 to 128), so small, one-limb, and two-limb values all come up.
routine operand(state: @U64) -> U128
    high_word: U128 = next(state).to[U128]()
    hi: U128 = high_word << 64
    full: U128 = hi | next(state).to[U128]()
    keep_less_one: U64 = next(state) % 128
    keep: U64 = keep_less_one + 1
    return (full >> (128 - keep).to[U128]()) | 1

### Divisors at the limb boundary and of every normalization shift, and S128.MIN.
routine edge_cases() -> U64
    local wrong: @U64 <- 0

    while k != 128 with k: U64 = 0
        d: U128 = U128.MIN + 1 << k.to[U128]()
        a: U128 = U128.MAX
        d1: U128 = d -% 1 | 1
        div_ok: Bool = a // d == udiv[U128](a, d)
        if not (div_ok and a % d1 == urem[U128](a, d1))
            (wrong.peek() + 1).poke_into(wrong)
        continue with k: k + 1
    m: S128 = S128.MIN
    min_div_ok: Bool = m.div_trunc(3) == sdiv[S128](m, 3)
    low: Bool = min_div_ok and m.mod_trunc(-7) == srem[S128](m, -7)
    self_div_ok: Bool = m.div_trunc(m) == 1
    high: Bool = self_div_ok and S128.MAX.mod_trunc(m) == S128.MAX
    if low and high
        return wrong.peek()
    else
        return wrong.peek() + 1

routine start() -> None
    local state: @U64 <- 0x9E3779B97F4A7C15
    local wrong: @U64 <- 0

    while i != 20000 with i: U64 = 0
        a: U128 = operand(state)
        b: U128 = operand(state)
        sa: S128 = bitcast[U128, S128](a)
        sb: S128 = bitcast[U128, S128](b)
        u_div_ok: Bool = a // b == udiv[U128](a, b)
        u_ok: Bool = u_div_ok and a % b == urem[U128](a, b)
        # MIN / -1 overflows and crashes in both, so skip it.
        if sa == S128.MIN and sb == -1
            continue with i: i + 1
        else
            s_div_ok: Bool = sa.div_trunc(sb) == sdiv[S128](sa, sb)
            if u_ok and (s_div_ok and sa.mod_trunc(sb) == srem[S128](sa, sb))
                continue with i: i + 1
            else
                (wrong.peek() + 1).poke_into(wrong)
                continue with i: i + 1
    edges: U64 = edge_cases()
    Out.write("U128 / S128: 20000 random cases, {wrong.peek()} wrong; edge cases {edges} wrong\n")
    return
