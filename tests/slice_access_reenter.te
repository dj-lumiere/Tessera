# Taking an element's access through another routine while this flow holds the run's stops the program with
# ReenterDuringAccessError: the two ranges overlap.

import Standard/Os

### Takes the access of one value of the run.
### :param numbers: The run.
routine first_one(numbers: @[S64]) -> S64
    one: ReadAuthorized[S64] <- numbers.getslot(0).get_shared_read_access()
    value: S64 = one.getview().peek()
    drop one
    return value

### Takes the run's exclusive access, then calls a routine that takes one of its values' access.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3] * 1 from HEAP
    whole: AuthorizedSlice[S64] <- numbers.get_exclusive_access()
    Console.show("{first_one(numbers.getslice())}")
    drop whole
    drop numbers
    return
