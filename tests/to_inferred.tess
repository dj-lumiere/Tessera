// A conversion without its type takes the type its value goes to: a binding's, an argument's, a return's.

import Standard::Format
import Standard::Os

routine widen(x: S64) -> S64
    block entry():
        return(x.add(1))

routine main() -> S32
    block entry():
        claim arr : @Array<@S32, 2> <- { null, null }
        elems : @@S32 = arr.to()
        same  : Bool  = elems.ptr_eq(arr.to<@@S32>())
        small : S32   = 41
        wide  : S64   = small.to()
        big   : U16   = 300
        byte  : U8    = big.to_wrap()
        Out.write("{same} {widen(small.to())} {wide} {byte}\n")
        return(small.sub(41).to())
