# put_work takes the arguments its entry takes: an entry on an @S64 can't be handed a @U8, on a fiber as on a thread.

import Standard/Fiber
import Standard/Os

routine count_up(n: @S64) -> None
    (n.peek() + 1).poke_into(n)
    return

routine start() -> None
    small: &U8 <- 0

    f: Fiber[None] <- FIBERS.get_fiber[None]()
    work_f: Work[None] <- count_up.to[Work](n: small)
    f.put_work(work_f)
    drop work_f
    f.wait_finished()
    drop f
    return
