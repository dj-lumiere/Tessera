# A list broken over lines may end with a comma before its closing bracket: an array literal, a tuple, the arguments
# of a call, the parameters of a routine, and a record literal.

import Standard/Collections
import Standard/Hosted

### A point on a plane.
record Point
    x: S64
    y: S64

### Adds three numbers.
### :param a: The first number.
### :param b: The second number.
### :param c: The third number.
### :returns: The sum.
routine add3(
    a: S64,
    b: S64,
    c: S64,
) -> S64
    return a + b + c

### Builds each kind of broken list with a trailing comma.
routine start() -> None
    xs: &List[S64] <- List[S64].of(values: [
        1,
        2,
    ], manager: HEAP)
    pair: (S64, S64) = (
        3,
        4,
    )
    p: Point = (
        x: 5,
        y: 6,
    )
    total: S64 = add3(
        a: xs.count().to[S64](),
        b: pair.item0,
        c: p.y,
    )
    Console.show("{total}")
    return
