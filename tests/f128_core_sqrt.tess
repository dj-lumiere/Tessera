routine report(#out: Ptr<FdWriter>, %name: String, %count: U64, %mismatches: U64) -> Void
    block entry():
        write(#out, "{%name}: {%count} cases, {%mismatches} mismatches\n")
        return()

routine mismatch(#out: Ptr<FdWriter>, %x: U128, %y: U128, %got: U128, %want: U128) -> Void
    block entry():
        write(#out, "x ")
        %x.format_hex(#out)
        write(#out, " y ")
        %y.format_hex(#out)
        write(#out, " got ")
        %got.format_hex(#out)
        write(#out, " want ")
        %want.format_hex(#out)
        write(#out, "\n")
        return()

/// Prints each mismatch; returns how many there were.
routine check_sqrt(#out: Ptr<FdWriter>) -> U64
    block entry():
        #xs   : Ptr<U128> = TEST_SQRT_X.to_ptr()
        #want : Ptr<U128> = TEST_SQRT_WANT.to_ptr()
        jump loop(#xs, #want, 0, 0)

    block loop(#xs: Ptr<U128>, #want: Ptr<U128>, %i: U64, %bad: U64):
        %done : Bool = %i.eq(SQRT_COUNT)
        branch %done ? return(%bad) : test(#xs, #want, %i, %bad)

    block test(#xs: Ptr<U128>, #want: Ptr<U128>, %i: U64, %bad: U64):
        %x   : U128 = #xs[%i].load()
        %w   : U128 = #want[%i].load()
        %r   : F128 = f128_cm_sqrt(f128_of(%x))
        %got : U128 = %r.bits
        %ok  : Bool = %got.eq(%w)
        branch %ok ? loop(#xs, #want, %i.add(1), %bad) : fail(#xs, #want, %i, %bad, %x, %got, %w)

    block fail(#xs: Ptr<U128>, #want: Ptr<U128>, %i: U64, %bad: U64, %x: U128, %got: U128,
            %w: U128):
        mismatch(#out, %x, 0, %got, %w)
        jump loop(#xs, #want, %i.add(1), %bad.add(1))

/// Prints each mismatch; returns how many there were.
routine check_hypot(#out: Ptr<FdWriter>, #xs: Ptr<U128>, #ys: Ptr<U128>, #want: Ptr<U128>,
        %count: U64) -> U64
    block entry():
        jump loop(#xs, #ys, #want, 0, 0)

    block loop(#xs: Ptr<U128>, #ys: Ptr<U128>, #want: Ptr<U128>, %i: U64, %bad: U64):
        %done : Bool = %i.eq(%count)
        branch %done ? return(%bad) : test(#xs, #ys, #want, %i, %bad)

    block test(#xs: Ptr<U128>, #ys: Ptr<U128>, #want: Ptr<U128>, %i: U64, %bad: U64):
        %x   : U128 = #xs[%i].load()
        %y   : U128 = #ys[%i].load()
        %w   : U128 = #want[%i].load()
        %r   : F128 = f128_cm_hypot(f128_of(%x), f128_of(%y))
        %got : U128 = %r.bits
        %ok  : Bool = %got.eq(%w)
        branch %ok ? loop(#xs, #ys, #want, %i.add(1), %bad)
                   : fail(#xs, #ys, #want, %i, %bad, %x, %y, %got, %w)

    block fail(#xs: Ptr<U128>, #ys: Ptr<U128>, #want: Ptr<U128>, %i: U64, %bad: U64, %x: U128,
            %y: U128, %got: U128, %w: U128):
        mismatch(#out, %x, %y, %got, %w)
        jump loop(#xs, #ys, #want, %i.add(1), %bad.add(1))

/// One group of hypot cases: checks them and prints the summary line.
routine hypot_group(#out: Ptr<FdWriter>, %name: String, #xs: Ptr<U128>, #ys: Ptr<U128>,
        #want: Ptr<U128>, %count: U64) -> Void
    block entry():
        %bad : U64 = check_hypot(#out, #xs, #ys, #want, %count)
        report(#out, %name, %count, %bad)
        return()

routine main() -> S32
    block entry():
        %out_val : FdWriter      = .stdout()
        #out     : Ptr<FdWriter> = claim
        #out.store(%out_val)
        %sqrt_bad : U64 = check_sqrt(#out)
        report(#out, "sqrt", SQRT_COUNT, %sqrt_bad)
        #hypot_x    : Ptr<U128> = TEST_HYPOT_X.to_ptr()
        #hypot_y    : Ptr<U128> = TEST_HYPOT_Y.to_ptr()
        #hypot_want : Ptr<U128> = TEST_HYPOT_WANT.to_ptr()
        hypot_group(#out, "hypot", #hypot_x, #hypot_y, #hypot_want, 3153)
        #hypot_wide_ties_x    : Ptr<U128> = TEST_HYPOT_WIDE_TIES_X.to_ptr()
        #hypot_wide_ties_y    : Ptr<U128> = TEST_HYPOT_WIDE_TIES_Y.to_ptr()
        #hypot_wide_ties_want : Ptr<U128> = TEST_HYPOT_WIDE_TIES_WANT.to_ptr()
        hypot_group(#out, "hypot wide ties", #hypot_wide_ties_x, #hypot_wide_ties_y,
                #hypot_wide_ties_want, 150)
        #hypot_wide_near_x    : Ptr<U128> = TEST_HYPOT_WIDE_NEAR_X.to_ptr()
        #hypot_wide_near_y    : Ptr<U128> = TEST_HYPOT_WIDE_NEAR_Y.to_ptr()
        #hypot_wide_near_want : Ptr<U128> = TEST_HYPOT_WIDE_NEAR_WANT.to_ptr()
        hypot_group(#out, "hypot wide near", #hypot_wide_near_x, #hypot_wide_near_y,
                #hypot_wide_near_want, 150)
        #hypot_narrow_near_x    : Ptr<U128> = TEST_HYPOT_NARROW_NEAR_X.to_ptr()
        #hypot_narrow_near_y    : Ptr<U128> = TEST_HYPOT_NARROW_NEAR_Y.to_ptr()
        #hypot_narrow_near_want : Ptr<U128> = TEST_HYPOT_NARROW_NEAR_WANT.to_ptr()
        hypot_group(#out, "hypot narrow near", #hypot_narrow_near_x, #hypot_narrow_near_y,
                #hypot_narrow_near_want, 100)
        return(0)
