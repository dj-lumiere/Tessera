# Work handed the address of a local, waited for before the routine returns: allowed.

import Standard/Os

### Reads an address.
### :param p: The address.
### :returns: What it holds.
routine read(p: @S64) -> S64
    return p.peek()

### Starts the work on a local and waits for it.
### :returns: What the work read.
routine fill() -> S64
    local l: @S64 <- 1234567

    t: Thread[S64] = get_thread[S64]()
    t.put_work(entry: read.to[Callable](), args: l)
    t.wait_finished()
    r: S64 = t.retrieve()
    t.give_back()
    return r

routine start() -> None
    Console.show("{fill()}")
    return
