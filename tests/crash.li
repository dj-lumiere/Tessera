# An out-of-bounds List.get crashes: stdout keeps what came before, and the exit status is 101.

import Collections
import Hosted

routine start() -> None
    manager: @MemoryManager = HEAP
    list: &List[S64] <- .construct(manager)

    list.add_last(10)
    first: S64 = list[0]
    Console.show("{first}")
    missing: S64 = list[3]
    Console.show("not reached")
    drop list
    return
