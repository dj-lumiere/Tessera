# An entity element of a BorrowedSlice doesn't come out as a copy: steal m.getslot(i) takes it out and leaves the place
# hollow, which destruct_all then passes over.

import Collections
import Hosted

routine start() -> None
    lists: &[List[S64]] <- BorrowedSlice[List[S64]].construct(count: 2, manager: HEAP)

    lists.getslot(0).poke(List[S64].construct(HEAP))
    lists.getslot(1).poke(List[S64].construct(HEAP))
    lists.getslot(0).add_last(4)
    first: &List[S64] <- steal lists.getslot(0)
    Console.show("taken: {first.count()}")
    drop first
    lists.destruct_all()
    return
