# One string literal is a UTF-8 @[Byte] and a @[Char] of code points, and an Items of either where one is expected.
# Each case checks both counts and that the text show writes for the @[Char] is the literal's own UTF-8 (round trip).

import Hosted

### Shows the counts of one text and whether writing its characters gives back its bytes.
### :param name: What the text is.
### :param bytes: The text as UTF-8 bytes.
### :param chars: The text as code points.
routine check(name: @[Byte], bytes: @[Byte], chars: @[Char]) -> None
    buf: &Items[Byte, 64]
    out: &SliceWriter <- .construct(data: buf.getview().to[@Byte](), capacity: 64)
    chars.represent_into(out)
    Console.show("{name}: {bytes.count()} bytes, {chars.count()} chars, round trip {out.getview() == bytes}")
    return

routine start() -> None
    check(name: "ascii", bytes: "\u000041", chars: "\u000041")
    check(name: "nul", bytes: "\u000000", chars: "\u000000")
    check(name: "e acute", bytes: "\u0000E9", chars: "\u0000E9")
    check(name: "U+07FF", bytes: "\u0007FF", chars: "\u0007FF")
    check(name: "U+0800", bytes: "\u000800", chars: "\u000800")
    check(name: "hangul", bytes: "\u00AC00", chars: "\u00AC00")
    check(name: "U+FFFF", bytes: "\u00FFFF", chars: "\u00FFFF")
    check(name: "Lumi in hangul", bytes: "루미", chars: "루미")
    check(name: "U+10000", bytes: "\u010000", chars: "\u010000")
    check(name: "emoji", bytes: "\u01F600", chars: "\u01F600")
    check(name: "U+10FFFF", bytes: "\u10FFFF", chars: "\u10FFFF")
    check(name: "combining", bytes: "e\u000301", chars: "e\u000301")
    check(name: "zero width", bytes: "a\u00200Bb\u00200Dc", chars: "a\u00200Bb\u00200Dc")
    check(name: "mixed", bytes: "A\u0000E9\u00AC00\u01F600", chars: "A\u0000E9\u00AC00\u01F600")

    one: Items[Byte, 1] = "\u00007F"
    two: Items[Byte, 2] = "\u0007FF"
    three: Items[Byte, 3] = "\u00FFFF"
    four: Items[Byte, 4] = "\u10FFFF"
    Console.show("bytes {one.getitem(0).to[U8]()} {two.getitem(1).to[U8]()} {three.getitem(2).to[U8]()} {four.getitem(3).to[U8]()}")
    chars: Items[Char, 4] = "A\u0000E9\u00AC00\u01F600"
    Console.show("{chars}")
    Console.show("{chars.getitem(3).to[U32]()} {chars.getitem(2).to[U32]()}")
    marks: Items[Char, 2] = "e\u000301"
    Console.show("{marks.getitem(1).to[U32]()}")
    view: @[Char] = "A\u0000E9\u00AC00\u01F600"
    Console.show("{view}|")
    raw: @[Byte] = "a\xFFb"
    Console.show("raw {raw.count()} {raw.getitem(1).to[U8]()}")
    return
