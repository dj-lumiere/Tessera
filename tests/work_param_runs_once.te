# A routine that takes a Work[T] doesn't know what the work's arguments hold, so the work runs once there: put it
# without steal is a build error.

import Standard/Os

### Runs the work on a thread of its own.
### :param work: The work.
### :returns: Its result.
routine run_on_thread(work: Work[S64]) -> S64
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(work)
    result: S64 = t.retrieve()
    drop t
    return result

routine seven() -> S64
    return 7

routine start() -> None
    work: Work[S64] = seven.to[Work]()
    Console.show("{run_on_thread(work: work)}")
    return
