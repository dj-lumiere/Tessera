// S128 remainder by zero crashes with DivisionByZeroError, on 64-bit and 32-bit targets alike.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

/// Reports the crash on stdout, where the golden test sees it, and exits with status 3.
#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("crashed: {name}: {message}\n")
        exit(3)

routine main() -> S32
    block entry()
        min  : S128 = S128.MIN
        zero : S128 = 0
        Out.write("before\n")
        r : S128 = min.mod(zero)
        Out.write("not reached {r}\n")
        return(0)
