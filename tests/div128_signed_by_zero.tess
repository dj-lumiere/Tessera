# S128 remainder by zero crashes with DivisionByZeroError, on 64-bit and 32-bit targets alike.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash on stdout, where the golden test sees it, and exits with status 3.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("crashed: {name}: {message}\n")
    exit(3)

routine start() -> None
    min: S128 = S128.MIN
    zero: S128 = 0
    Out.write("before\n")
    r: S128 = min % zero
    Out.write("not reached {r}\n")
    return
