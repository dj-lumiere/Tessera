# An entity made with a view holds its source: reading it after the source is given back is a build error.
import Hosted

### Holds a view.
entity Holder
    data: @[Byte]

### Makes a holder.
### :param data: The view to keep.
### :returns: The holder.
common routine Holder.construct(data: @[Byte]) -> Me
    return Me(data)

### Reads the holder after its view's memory is given back.
routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP
    h: &Holder <- Holder.construct(data: m.getslice()) from HEAP
    drop m
    Console.show("{h.data.peek().getitem(0).to[U8]()}")
    drop h
    return
