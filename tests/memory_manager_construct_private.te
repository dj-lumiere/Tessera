# A program makes a MemoryManager table with m.to[MemoryManager](): building one by hand from routines is
# Standard/System/Memory's own.

routine refuse(state: Addr, size: U64, align: U64) -> Addr
    return .hollow()

routine refuse_reborrow(state: Addr, at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

routine ignore(state: Addr, at: Addr) -> None
    return

routine start() -> None
    local table: @MemoryManager <- .construct(borrow_fn: refuse.to[Callable](),
        reborrow_fn: refuse_reborrow.to[Callable](), give_back_fn: ignore.to[Callable](), state: .hollow())

    return
