# A program makes a MemoryManager table with m.to[MemoryManager](): building one by hand from routines is
# Standard/Alloc's own.

import Standard/Alloc

routine refuse(state: Addr, size: U64, align: U64) -> Addr
    return null

routine refuse_realloc(state: Addr, at: Addr, size: U64, align: U64) -> Addr
    return null

routine ignore(state: Addr, at: Addr) -> None
    return

routine start() -> None
    local table: @MemoryManager <- .construct(alloc_fn: refuse.to[Callable](),
        realloc_fn: refuse_realloc.to[Callable](), free_fn: ignore.to[Callable](), state: null)

    return
