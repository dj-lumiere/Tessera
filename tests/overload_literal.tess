/// An untyped integer literal prefers USize (SSize when negative) when several overloads could take it, the rule
/// `stride` follows. A typed argument picks its own overload.
import Standard/Format
import Standard/Os

routine size(n: USize) -> Span[Byte]
    return "USize"

routine size(n: U8) -> Span[Byte]
    return "U8"

routine size(n: SSize) -> Span[Byte]
    return "SSize"

routine start() -> Void
    small: U8 = 3
    Out.write("{size(3)} {size(-3)} {size(small)}\n")
    return
