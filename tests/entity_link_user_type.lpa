# @entity_link marks a record whose fetch() gives an entity's view: a user type with it is a way to change an entity,
# read where it is in the view of a shared read access and never copied out of it, as a Stamped is.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### A link to a node by its address, marked as a way to change one.
@entity_link
record Handle
    at: Addr

### A record that keeps a handle.
record Link
    target: Handle

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### The node a handle names.
### :returns: The node's view.
routine Handle.fetch() -> @Node
    return me.at.to[@Node]()

routine start() -> None
    node: &Node <- Node.construct(value: 1)
    link: &Link <- Link(target: Handle(at: node.getview().to[Addr]()))
    reading: ReadAuthorized[Link] <- link.get_shared_read_access()
    view: @Link = reading.getview()
    copy: Link = view.peek()
    drop reading
    return
