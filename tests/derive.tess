// #derive(Equal, Hash, Compare): field by field, in declaration order. A choice compares as its underlying integer.

import Standard::Format
import Standard::Os

#derive(Equal, Hash, Compare, Diagnose)
record Version
    major : U32
    minor : U32

#derive(Equal, Hash, Compare)
record Pair<T>
require T: typename
    first  : T
    second : T

#derive(Equal, Hash, Compare, Represent)
choice Level: U8
    Low
    High

#derive(Equal)
record Empty

routine main() -> S32
    block entry()
        a : Version = Version { major: 1, minor: 2 }
        b : Version = Version { major: 1, minor: 3 }
        c : Version = Version { major: 1, minor: 2 }
        Out.write("{a.eq(c)} {a.eq(b)} {a.hash().eq(c.hash())} {a.hash().eq(b.hash())}\n")
        Out.write("{a.compare(b)} {b.compare(a)} {a.compare(c)}\n")
        p : Pair<Bytes> = Pair<Bytes> { first: "x", second: "b" }
        q : Pair<Bytes> = Pair<Bytes> { first: "x", second: "a" }
        Out.write("{p.eq(q)} {p.compare(q)} {p.hash().eq(q.hash())}\n")
        low  : Level = Level.Low
        high : Level = Level.High
        Out.write("{low} {low.eq(high)} {low.compare(high)} {high.hash().eq(high.hash())}\n")
        some  : Option<Version> = .Present(a)
        other : Option<Version> = .Present(c)
        Out.write("{some.eq(other)}\n")
        e : Empty = Empty {}
        Out.write("{e.eq(e)}\n")
        b.diagnose_into(Out.shared())
        Out.write("\n")
        return(0)
