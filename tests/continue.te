# A continue arm goes on with the next line of the same block, so a guard doesn't need a new block: the lines after
# it still see every value above.

import Standard/Os

routine sum_to(n: U64) -> U64
    local acc: @U64 <- 0

    each i in 0 til n
        next: U64 = acc.peek() + i
        next.poke_into(acc)
    then
        return acc.peek()

### Guards stack: each one leaves or goes on.
routine classify(n: S64) -> S64
    if n < 0
        return -1
    if n == 0
        return 0
    if not (n > 100)
        return 1
    when
        n > 10000 => return 3
        else => nothing
    return 2

routine name_of(tag: U8) -> S64
    when tag
        0 => return 10
        1, 2 => nothing
        else => return 99
    doubled: S64 = tag.to[S64]() * 2
    return doubled

routine start() -> None
    Console.show("{sum_to(10)}")
    Console.show("{classify(-5)} {classify(0)} {classify(7)} {classify(500)} {classify(50000)}")
    Console.show("{name_of(0)} {name_of(1)} {name_of(2)} {name_of(9)}")
    return
