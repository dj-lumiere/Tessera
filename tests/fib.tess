// Recursive and loop-based Fibonacci, printed through libc putchar.

#[external("c"), symbol("putchar")]
routine c_putchar(c: CInt) -> CInt

/// Prints n in decimal: digits above the last one first, by recursion.
routine print_decimal(n: U64) -> Void
    block entry()
        has_more : Bool = n.ge(10)
        branch has_more
            ? print_prefix()
            : print_last()

    block print_prefix()
        rest : U64 = n.div(10)
        print_decimal(rest)
        jump print_last()

    block print_last()
        digit : U64 = n.mod(10)
        ch    : U64 = digit.add(b'0'.to<U8>().to<U64>())
        c_putchar(ch.to<S32>())
        return()

routine println_decimal(n: U64) -> Void
    block entry()
        print_decimal(n)
        c_putchar(10)
        return()

routine fib_rec(n: U64) -> U64
    block entry()
        small : Bool = n.lt(2)
        branch small
            ? return(n)
            : split()

    block split()
        a : U64 = fib_rec(n.sub(1))
        b : U64 = fib_rec(n.sub(2))
        return(a.add(b))

routine fib_loop(n: U64) -> U64
    block entry()
        jump loop(0, 0, 1)

    block loop(i: U64, a: U64, b: U64)
        done : Bool = i.ge(n)
        branch done
            ? return(a)
            : step(i, a, b)

    block step(i: U64, a: U64, b: U64)
        next : U64 = a.add(b)
        jump loop(i.add(1), b, next)

routine main() -> S32
    block entry()
        println_decimal(fib_rec(10))
        println_decimal(fib_loop(20))
        println_decimal(fib_loop(90))
        return(0)
