; Recursive and loop-based Fibonacci, printed through libc putchar.

@[external("c"), callconv("c"), symbol("putchar")]
routine c_putchar(%c: CInt) -> CInt

; Prints a non-negative I64 in decimal: digits above the last one first, by recursion.
routine print_uint(%n: I64) -> Void
    block entry():
        %has_more: Bool = %n.sge(10)
        branch %has_more ? print_prefix(%n) : print_last(%n)

    block print_prefix(%n: I64):
        %rest: I64 = %n.sdiv(10)
        print_uint(%rest)
        jump print_last(%n)

    block print_last(%n: I64):
        %digit: I64 = %n.srem(10)
        %ch: I64 = %digit.add(b'0'.to_i64())
        c_putchar(%ch.to_i32())
        return()

routine println_uint(%n: I64) -> Void
    block entry():
        print_uint(%n)
        c_putchar(10)
        return()

routine fib_rec(%n: I64) -> I64
    block entry():
        %small: Bool = %n.slt(2)
        branch %small ? return(%n) : split(%n)

    block split(%n: I64):
        %a: I64 = fib_rec(%n.sub(1))
        %b: I64 = fib_rec(%n.sub(2))
        return(%a.add(%b))

routine fib_loop(%n: I64) -> I64
    block entry():
        jump loop(0, 0, 1)

    block loop(%i: I64, %a: I64, %b: I64):
        %done: Bool = %i.sge(%n)
        branch %done ? return(%a) : step(%i, %a, %b)

    block step(%i: I64, %a: I64, %b: I64):
        %next: I64 = %a.add(%b)
        jump loop(%i.add(1), %b, %next)

routine main() -> I32
    block entry():
        println_uint(fib_rec(10))
        println_uint(fib_loop(20))
        println_uint(fib_loop(90))
        return(0)
