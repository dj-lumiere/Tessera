// Recursive and loop-based Fibonacci, printed through libc putchar.

#[external("c"), symbol("putchar")]
routine c_putchar(c: CInt) -> CInt

/// Prints n in decimal: digits above the last one first, by recursion.
routine print_decimal(n: U64) -> Void
    has_more: Bool = n.ge(10)
    branch has_more
        ? print_prefix()
        : print_last()

    block print_prefix()
        rest: U64 = n.div(10)
        print_decimal(rest)
        jump print_last()

    block print_last()
        digit: U64 = n.mod(10)
        ch: U64 = digit.add(b'0'.to[U8]().to[U64]())
        c_putchar(ch.to[S32]())
        return()

routine println_decimal(n: U64) -> Void
    print_decimal(n)
    c_putchar(10)
    return()

routine fib_rec(n: U64) -> U64
    small: Bool = n.lt(2)
    branch small
        ? return(n)
        : split()

    block split()
        a: U64 = fib_rec(n.sub(1))
        b: U64 = fib_rec(n.sub(2))
        return(a.add(b))

routine fib_loop(n: U64) -> U64
    local a: @U64 <- 0
    local b: @U64 <- 1

    jump loop(0)

    block loop(i: U64)
        done: Bool = i.ge(n)
        branch done
            ? return(a.peek())
            : step(i)

    block step(i: U64)
        next: U64 = a.peek().add(b.peek())
        next_b: U64 = next
        next_a: U64 = b.peek()
        next_a.poke_into(a)
        next_b.poke_into(b)
        jump loop(i.add(1))

routine start() -> Void
    println_decimal(fib_rec(10))
    println_decimal(fib_loop(20))
    println_decimal(fib_loop(90))
    return()
