# A view of a STACK slot made with `getview()`, `getslice()` or `to[@T]()` sees that slot's memory, so the address of
# another STACK slot of the same routine may be poked through it: both are gone together when the routine returns.

import Hosted

routine start() -> None
    lateinit arr: &Items[@S32, 3]
    a: &S32 <- 10
    b: &S32 <- 20
    c: &S32 <- 30

    elems: @[@S32] = arr.getview()
    elems.getslot(0).poke(a)
    elems.getslot(1).poke(b)
    part: @[@S32] = arr.getslice(2, 1)
    part.getslot(0).poke(c)
    Console.show("{elems[0].peek()} {elems[1].peek()} {elems[2].peek()}")
    first: @@S32 = elems.to[@@S32]()
    first.poke(c)
    second: @@S32 = first.stride(1)
    Console.show("{elems[0].peek() + second.peek().peek()}")
    return
