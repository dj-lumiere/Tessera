# text.to[T]() crashes on text that isn't a T, with InvalidValueError and a message naming the text and the type, at
# the line of the call (to[T] is @track_caller). This handler prints them and exits with status 3.

import Standard/Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    good: @[Byte] = "300"
    n: U16 = good.to[U16]()
    Console.show("{n}")
    bad: @[Byte] = "300"
    m: U8 = bad.to[U8]()
    Console.show("{m}")
    return
