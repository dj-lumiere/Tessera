# Fibers of one manager: two workers take turns through yield, a third starts a fourth from inside and waits for it,
# and run returns when all have finished. The stacks come from the stack memory manager, with a guard page below each.

import Standard/Fiber
import Standard/Os

### A worker's state: its name, how many steps it takes, and the manager it yields to.
record Worker
    name: @[Byte]
    steps: S64
    sched: @CoroutineManager

routine worker(state: @Worker) -> None
    each i in 1 to state.steps.peek()
        Console.show("{state.name.peek()} {i}")
        state.sched.peek().yield()
    Console.show("{state.name.peek()} done")
    return

### Starts a late worker from inside a fiber, and waits for it before it returns: only this fiber waits, and the
### others go on.
routine spawner(late: @Worker) -> None
    sched: @CoroutineManager = late.sched.peek()
    Console.show("spawner")
    f: Fiber[None] <- sched.get_fiber[None]()
    work_f: Work[None] = worker.to[Work](state: late)
    f.put_work(steal work_f)
    f.retrieve()
    drop f
    return

routine start() -> None
    manager: @MemoryManager = HEAP
    stack_manager: @MemoryManager = PAGES
    sched: &CoroutineManager <- .construct(stack_size: 64kib, stack_manager, manager)
    a: &Worker <- Worker(name: "a", steps: 3, sched: sched)
    b: &Worker <- Worker(name: "b", steps: 2, sched: sched)
    c: &Worker <- Worker(name: "c", steps: 1, sched: sched)

    fa: Fiber[None] <- sched.get_fiber[None]()
    work_fa: Work[None] = worker.to[Work](state: a)
    fa.put_work(steal work_fa)
    fb: Fiber[None] <- sched.get_fiber[None]()
    work_fb: Work[None] = worker.to[Work](state: b)
    fb.put_work(steal work_fb)
    fc: Fiber[None] <- sched.get_fiber[None]()
    work_fc: Work[None] = spawner.to[Work](late: c)
    fc.put_work(steal work_fc)
    sched.run()
    drop fa
    drop fb
    drop fc
    Console.show("all done")
    drop sched
    return
