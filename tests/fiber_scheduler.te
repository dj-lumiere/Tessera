# Fibers of one manager: two workers take turns through yield, a third starts a fourth from inside and waits for it,
# and run returns when all have finished. The stacks come from the stack allocator, with a guard page below each.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

### A worker's state: its name, how many steps it takes, and the manager it yields to.
record Worker
    name: @[Byte]
    steps: S64
    sched: @FiberManager

### Makes a `Worker` from its fields.
### :param name: Its `name`.
### :param steps: Its `steps`.
### :param sched: Its `sched`.
### :returns: The new value.
common routine Worker.construct(name: @[Byte], steps: S64, sched: @FiberManager) -> Me
    return Me(name, steps, sched)

### Releases the memory its `name` holds.
routine @Worker.destruct() -> None
    me.name.destruct()
    return

routine worker(state: @Worker) -> None
    each i in 1 to state.steps.peek()
        Console.show("{state.name.peek()} {i}")
        state.sched.peek().yield()
    Console.show("{state.name.peek()} done")
    return

### Starts a late worker from inside a fiber, and waits for it before it returns: only this fiber waits, and the
### others go on.
routine spawner(late: @Worker) -> None
    sched: @FiberManager = late.sched.peek()
    Console.show("spawner")
    f: Fiber[None] = sched.get_fiber[None]()
    f.put_work(entry: worker.to[Callable](), args: late)
    f.wait_finished()
    f.give_back()
    return

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local stacks: @MemoryManager <- PAGES.peek()
    local sched: @FiberManager <- .construct(stack_size: 64kib, stacks, alloc)
    local a: @Worker <- Worker(name: "a", steps: 3, sched: sched)
    local b: @Worker <- Worker(name: "b", steps: 2, sched: sched)
    local c: @Worker <- Worker(name: "c", steps: 1, sched: sched)

    fa: Fiber[None] = sched.get_fiber[None]()
    fa.put_work(entry: worker.to[Callable](), args: a)
    fb: Fiber[None] = sched.get_fiber[None]()
    fb.put_work(entry: worker.to[Callable](), args: b)
    fc: Fiber[None] = sched.get_fiber[None]()
    fc.put_work(entry: spawner.to[Callable](), args: c)
    sched.run()
    fa.give_back()
    fb.give_back()
    fc.give_back()
    Console.show("all done")
    drop sched
    return
