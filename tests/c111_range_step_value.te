# A range's step held in a value takes its direction from the value: a negative step walks down whatever the step's
# written form looks like, the way RazorForge's ranges do.

import Hosted

### Writes the indexes a range walks, on one line.
routine walk(from: S64, to: S64, step: S64) -> None
    Console.show("{from} to {to} by {step}:", end: "")
    each i in from to to by step
        Console.show(" {i}", end: "")
    Console.show("")
    return

### Writes the indexes a range that leaves its end out walks, on one line.
routine walk_til(from: S64, to: S64, step: S64) -> None
    Console.show("{from} til {to} by {step}:", end: "")
    each i in from til to by step
        Console.show(" {i}", end: "")
    Console.show("")
    return

### Walks ranges with steps held in values, both directions, near the ends of S8 too.
routine start() -> None
    walk(from: 10, to: 0, step: -3)
    walk(from: 0, to: 10, step: 3)
    walk(from: 0, to: 10, step: -1)
    walk(from: 10, to: 0, step: 1)
    walk_til(from: 10, to: 0, step: -2)
    walk_til(from: 0, to: 10, step: 4)
    down: S64 = -1
    walk(from: 3, to: -3, step: -down - 2)
    small: S8 = -50
    Console.show("S8 -100 to -128 by -50:", end: "")
    each k: S8 in -100 to -128 by small
        Console.show(" {k}", end: "")
    Console.show("")
    Console.show("S8 100 to 127 by 50:", end: "")
    each m: S8 in 100 to 127 by -small
        Console.show(" {m}", end: "")
    Console.show("")
    return
