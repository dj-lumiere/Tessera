# A BF16 signaling NaN keeps its bits through a debug build: a value made in one block and used in another (a
# routine's parameter, an if's arms, a phi) crosses as its bits, never quieted on the way.
import Hosted

### The bits of `x`, read in a block other than the one the parameter arrives in.
### :param x: The value.
### :param flip: Whether to give back -x instead.
### :returns: The bits.
routine pick(x: BF16, flip: Bool) -> U16
    if flip
        return x.neg().bits()
    return x.bits()

routine start() -> None
    s: BF16 = BF16.from_bits(0x7F81)
    Console.show("{s.bits()} {pick(x: s, flip: false)} {pick(x: s, flip: true)}")
    return
