// destruct_all needs elements that own something: S64 isn't a Destructible.

import Standard::Alloc
import Standard::Collections
import Standard::Os

routine start() -> Void
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        claim l     : @List<S64> <- .construct(alloc)
        l.destruct_all()
        return()
