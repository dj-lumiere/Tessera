// destruct_all needs elements that own something: S64 isn't a Destruct.

import Standard::Alloc
import Standard::Collections
import Standard::Os

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %l_val : List<S64> = .construct(%alloc)
        claim %l : Ptr<List<S64>>
        %l.store(%l_val)
        %l.destruct_all()
        return(0)
