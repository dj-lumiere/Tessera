// destruct_all needs elements that own something: S64 isn't a Destruct.
routine main() -> S32
    block entry():
        %heap: Allocator = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %l_val: List<S64> = List<S64>.construct(#alloc)
        #l: Ptr<List<S64>> = alloca<List<S64>>([%l_val])
        #l.destruct_all()
        return(0)
