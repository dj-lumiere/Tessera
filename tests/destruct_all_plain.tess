// destruct_all needs elements that own something: S64 isn't a Destructible.

import Standard/Alloc
import Standard/Collections
import Standard/Os

routine start() -> Void
    block entry()
        claim alloc: @MemoryManager <- make_heap_memory()
        claim l: @List[S64] <- .construct(alloc)
        l.destruct_all()
        return()
