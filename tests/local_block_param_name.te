# A block parameter can't take the name of a value the head shares: every block already sees it. The head is the
# binding lines before `block entry()`.
@generated
routine count_down(n: S64) -> S64
    start: S64 = n.add(1)

    block entry()
        jump loop(start)

    block loop(start: S64)
        if start == 0
            return start
        jump loop(start - 1)

routine start() -> None
    drop count_down(3)
    return
