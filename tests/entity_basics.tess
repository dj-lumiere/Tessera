# An entity is one of a kind: it lives in a slot (or a field of another entity), is lent as a pointer, moves with
# steal, and ends with drop.
import Standard/Format

import Standard/Os

### Counts things.
entity Counter
    count: S64

### Two counters, each its own.
entity Pair
    left: Counter
    right: Counter

### A counter at zero.
### :returns: The counter.
routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing: a Counter holds no memory.
routine Counter.destruct(me: @Me) -> None
    return

### Counts one more.
routine Counter.bump(me: @Me) -> None
    (me.count.peek() + 1).poke_into(me.count)
    return

### The count so far.
### :returns: The count.
routine Counter.read(me: @Me) -> S64
    n: S64 = me.count.peek()
    return n

### Two counters at zero.
### :returns: The pair.
routine Pair.construct() -> Me
    return Me(left: .construct(), right: .construct())

### Ends both counters.
routine Pair.destruct(me: @Me) -> None
    drop me.left
    drop me.right
    return

### Takes a counter over, reads it, and ends it.
### :param c: The counter, handed over.
### :returns: Its count.
routine finish(c: Counter) -> S64
    local slot: @Counter <- steal c

    n: S64 = slot.read()
    drop slot
    return n

routine start() -> None
    out: @Out = Out.writer()
    local a: @Counter <- .construct()
    a.bump()
    a.bump()
    first: S64 = finish(c: steal a)

    local p: @Pair <- .construct()
    p.left.bump()
    p.left.bump()
    p.left.bump()
    p.right.bump()
    steal p.left as old inject .construct()
    second: S64 = finish(c: steal old)
    after: S64 = p.left.read()
    right: S64 = p.right.read()
    drop p

    out.write("{first} {second} {after} {right}\n")
    return
