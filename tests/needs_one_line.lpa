# Constraints on different parameters go on one needs line, separated by commas, or on lines of their own.
import Hosted

### A pair of a key and a value, stored by value.
### :typeparam K: The key's type.
### :typeparam V: The value's type.
record Entry[K, V]
needs RecordType K, RecordType V, V obeys Equatable
    key: K
    value: V

### Whether the first values are equal and the second values are in order.
### :typeparam A: The first values' type.
### :typeparam B: The second values' type.
### :param a1: One first value.
### :param a2: The other first value.
### :param b1: One second value.
### :param b2: The other second value.
### :returns: Whether both hold.
routine both[A, B](a1: A, a2: A, b1: B, b2: B) -> Bool
needs A obeys Equatable, Hashable, B obeys Comparable
    return a1 == a2 and a1.hash() == a2.hash() and b1 < b2

### Whether two entries hold equal values.
### :param other: The other entry.
### :returns: Whether the values are equal.
routine Entry[K, V].same_value(other: Me) -> Bool
    return me.value == other.value

### Runs.
routine start() -> None
    one: S64 = 1
    two: S64 = 2
    e: Entry[S64, S64] = Entry[S64, S64](key: 1, value: 7)
    f: Entry[S64, S64] = Entry[S64, S64](key: 2, value: 7)
    Console.show("{both(a1: one, a2: one, b1: one, b2: two)} {both(a1: one, a2: two, b1: one, b2: two)} {e.same_value(f)}")
    return
