// me is the receiver of a routine on a type, so a free routine has none.

record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine x_of(me: Point) -> S64
    return(me.x)

routine start() -> Void
    return()
