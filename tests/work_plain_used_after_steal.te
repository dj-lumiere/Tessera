# steal on plain work ends its name: using it after is a build error that points at the copying form.

import Standard/Hosted

routine seven() -> S64
    return 7

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = seven.to[Work]()
    t.put_work(steal work)
    first: S64 = t.retrieve()
    t.put_work(work)
    Console.show("{first} {t.retrieve()}")
    drop t
    return
