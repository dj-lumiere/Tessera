# Fibers without an operating system: start switches to a fiber on a stack of its own (a global array), the fiber
# counts and switches back, three times, and start adds up what it counted. There is no scheduler here (it needs
# threads), only Standard/Fiber's switch_fiber and initial_stack, which a board's own cooperative loop is built on.
# The fiber reserves its own failure mold first, and switch_fiber puts each side's mold back in place when it
# resumes, so a failure on the fiber never lands in start's mold. CI builds it for the targets without an OS that
# have fiber switches (32-bit ARM's Cortex-M, AArch64, x86_64), links it with the board of each target, and checks
# that nothing is left undefined (see freestanding_fiber.arch: it never runs here).

import Standard/Fiber
import Standard/Unhosted

global MAIN_SP: &Addr
global FIBER_SP: &Addr
global STEPS: &U32
global TOTAL: &U32

### The fiber's stack: 4 KiB.
global FIBER_STACK: &Array[U64, 512]

### Halts on a crash: there's nowhere to print and nothing to exit to.
@untraced
routine halt(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    loop
        nothing

### The fiber: reserves its failure mold, then counts a step and switches back to start, forever.
@noreturn
routine fiber_main() -> None
    RUNNING_MOLD.poke(reserve_failure_mold())
    loop
        (STEPS.peek() + 1).poke_into(STEPS)
        switch_fiber(from: FIBER_SP, to: MAIN_SP.peek())

### Turns the managers on, then puts the reporting routine in the Crash service's slot.
routine when_power_on() -> None
    prepare_core()
    Crash.report_with(halt.to[Callable]())
    return

### Switches to the fiber three times and keeps the sum of the steps it had counted after each.
routine start() -> None
    size: U64 = sizeof[Array[U64, 512]]()

    sp: Addr = initial_stack(stack: FIBER_STACK, size, entry: fiber_main.to[Callable]().addr())
    sp.poke_into(FIBER_SP)

    until i == 3 with i: U32 = 0
        switch_fiber(from: MAIN_SP, to: FIBER_SP.peek())
        (TOTAL.peek() + STEPS.peek()).poke_into(TOTAL)
        continue with i: i + 1
    then
        return
