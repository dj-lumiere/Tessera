### A secret declaration doesn't claim its name outside its module: the stdlib's secret SORTED_SET_NODE_KEYS
### (Collections) and U256Division (System) leave these names free.
import Hosted

preset SORTED_SET_NODE_KEYS: U64 = 3

record U256Division
    parts: U64

routine start() -> None
    d: U256Division = U256Division(parts: SORTED_SET_NODE_KEYS)
    Console.show("{d.parts}")
    return
