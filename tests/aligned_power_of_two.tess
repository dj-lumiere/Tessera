/// #aligned needs a power of two.
record Odd
    #aligned(3)
    x: S8

/// Makes a `Odd` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Odd.construct(x: S8) -> Me
    return(Me(x))

/// Releases nothing: a `Odd` holds no memory of its own.
routine Odd.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    s: U64 = sizeof[Odd]()
    return()
