# Memory given back by the flow that holds an access inside it would wait for itself: the program stops with
# DeadlockError, naming where the access was taken.

import Standard/Os

routine start() -> None
    local m: @Memory[U64] <- [0] * 4 from HEAP

    held: Authorized[U64] = m.getview(2).get_exclusive_access()
    Console.show("holding the third element")
    drop m
    drop held
    return
