# Overloads that differ only in a span parameter's element type: a span literal whose elements have a known type
# picks the overload of that element type.

import Hosted

### A meter reading.
record Meters
    ### The value.
    value: S64

### A second count.
record Seconds
    ### The value.
    value: S64

### Says which overload took the call.
### :param values: The readings.
### :returns: A name for the overload.
routine describe(values: @[Meters]) -> @[Byte]
    return "meters"

### Says which overload took the call.
### :param values: The counts.
### :returns: A name for the overload.
routine describe(values: @[Seconds]) -> @[Byte]
    return "seconds"

routine start() -> None
    first: @[Byte] = describe([Meters(value: 1), Meters(value: 2)])
    second: @[Byte] = describe([Seconds(value: 3)])
    Console.show("{first} {second}")
    return
