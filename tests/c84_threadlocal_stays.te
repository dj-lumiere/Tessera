# The address of a @threadlocal may go anywhere on its own thread: a name, a routine's result, another @threadlocal.
module C84/ThreadlocalStays
import Standard/Hosted

@threadlocal
global COUNTER: &S64 <- 41

@threadlocal
global LAST: &@S64 <- .hollow()

### The running thread's counter address.
### :returns: The address.
routine where_is() -> @S64
    return COUNTER

### Keeps the address in this thread's own global.
### :param p: The address.
routine remember(p: @S64) -> None
    LAST.poke(p)
    return

### Adds one through the address this thread remembered.
### :param n: Unused.
### :returns: The new value.
routine bump(n: S64) -> S64
    remember(where_is())
    p: @S64 = LAST.peek()
    p.poke(p.peek() + 1)
    return COUNTER.peek()

### Runs the example.
routine start() -> None
    Console.show("here: {bump(0)}")
    t: Thread[S64] <- get_thread[S64]()
    work_t: Work[S64] = bump.to[Work](n: 0)
    t.put_work(work_t)
    Console.show("there: {t.retrieve()}")
    drop t
    return
