routine compute(id: U64, a: F128, b: F128, c: F128, n: S64) -> U128
    block entry()
        when id
            0    -> f0()
            1    -> f1()
            2    -> f2()
            3    -> f3()
            4    -> f4()
            5    -> f5()
            6    -> f6()
            7    -> f7()
            8    -> f8()
            9    -> f9()
            10   -> f10()
            11   -> f11()
            12   -> f12()
            13   -> f13()
            14   -> f14()
            15   -> f15()
            16   -> f16()
            18   -> f18()
            19   -> f19()
            20   -> f20()
            21   -> f21()
            22   -> f22()
            23   -> f23()
            24   -> f24()
            25   -> f25()
            26   -> f26()
            27   -> f27()
            28   -> f28()
            29   -> f29()
            30   -> f30()
            31   -> f31()
            32   -> f32()
            33   -> f33()
            34   -> f34()
            else -> crash_logic_breached()

    block f0()
        r : U128 = a.signum().bits()
        return(r)

    block f1()
        sign_flag      : U128 = a.is_sign_positive().to<U128>()
        normal_flag    : U128 = a.is_normal().to<U128>()
        subnormal_flag : U128 = a.is_subnormal().to<U128>()
        r              : U128 = sign_flag.bitor(normal_flag.shl(1)).bitor(subnormal_flag.shl(2))
        return(r)

    block f2()
        r : U128 = a.recip().bits()
        return(r)

    block f3()
        r : U128 = a.div(b).bits()
        return(r)

    block f4()
        same_hash : Bool = a.hash().eq(a.bits().hash())
        r         : U128 = same_hash.to<U128>()
        return(r)

    block f5()
        r : U128 = a.mod(b).bits()
        return(r)

    block f6()
        r : U128 = a.rem(b).bits()
        return(r)

    block f7()
        r : U128 = a.div_euclid(b).bits()
        return(r)

    block f8()
        r : U128 = a.mod_euclid(b).bits()
        return(r)

    block f9()
        r : U128 = a.minimum(b).bits()
        return(r)

    block f10()
        r : U128 = a.maximum(b).bits()
        return(r)

    block f11()
        r : U128 = a.clamp(b, c).bits()
        return(r)

    block f12()
        r : U128 = a.fdim(b).bits()
        return(r)

    block f13()
        r : U128 = a.midpoint(b).bits()
        return(r)

    block f14()
        r : U128 = a.next_up().bits()
        return(r)

    block f15()
        r : U128 = a.next_down().bits()
        return(r)

    block f16()
        r : U128 = a.scalbn(n).bits()
        return(r)

    block f18()
        r : U128 = a.logb().bits()
        return(r)

    block f19()
        r : U128 = a.frexp().fraction.bits()
        return(r)

    block f20()
        frexp_exponent : S64  = a.frexp().exponent
        r              : U128 = frexp_exponent.to<S128>().to_wrap<U128>()
        return(r)

    block f21()
        clamped_s8 : S8   = a.to_clamp<S8>()
        r          : U128 = clamped_s8.to<S128>().to_wrap<U128>()
        return(r)

    block f22()
        clamped_s16 : S16  = a.to_clamp<S16>()
        r           : U128 = clamped_s16.to<S128>().to_wrap<U128>()
        return(r)

    block f23()
        clamped_s32 : S32  = a.to_clamp<S32>()
        r           : U128 = clamped_s32.to<S128>().to_wrap<U128>()
        return(r)

    block f24()
        r : U128 = a.to_clamp<U8>().to<U128>()
        return(r)

    block f25()
        r : U128 = a.to_clamp<U16>().to<U128>()
        return(r)

    block f26()
        r : U128 = a.to_clamp<U32>().to<U128>()
        return(r)

    block f27()
        r : U128 = a.to_clamp<U64>().to<U128>()
        return(r)

    block f28()
        r : U128 = a.to_clamp<U128>()
        return(r)

    block f29()
        r : U128 = a.sin_pi().bits()
        return(r)

    block f30()
        r : U128 = a.cos_pi().bits()
        return(r)

    block f31()
        r : U128 = a.tan_pi().bits()
        return(r)

    block f32()
        r : U128 = f128_sin_pi(a, true).bits()
        return(r)

    block f33()
        r : U128 = f128_cos_pi(a, true).bits()
        return(r)

    block f34()
        r : U128 = f128_tan_pi(a, true).bits()
        return(r)

routine name(out: @Out, id: U64) -> Void
    block entry()
        when id
            0    -> n0()
            1    -> n1()
            2    -> n2()
            3    -> n3()
            4    -> n4()
            5    -> n5()
            6    -> n6()
            7    -> n7()
            8    -> n8()
            9    -> n9()
            10   -> n10()
            11   -> n11()
            12   -> n12()
            13   -> n13()
            14   -> n14()
            15   -> n15()
            16   -> n16()
            18   -> n18()
            19   -> n19()
            20   -> n20()
            21   -> n21()
            22   -> n22()
            23   -> n23()
            24   -> n24()
            25   -> n25()
            26   -> n26()
            27   -> n27()
            28   -> n28()
            29   -> n29()
            30   -> n30()
            31   -> n31()
            32   -> n32()
            33   -> n33()
            34   -> n34()
            else -> crash_logic_breached()

    block n0()
        out.write("signum")
        return()

    block n1()
        out.write("classify")
        return()

    block n2()
        out.write("recip")
        return()

    block n3()
        out.write("div")
        return()

    block n4()
        out.write("hash")
        return()

    block n5()
        out.write("mod")
        return()

    block n6()
        out.write("rem")
        return()

    block n7()
        out.write("div_euclid")
        return()

    block n8()
        out.write("mod_euclid")
        return()

    block n9()
        out.write("minimum")
        return()

    block n10()
        out.write("maximum")
        return()

    block n11()
        out.write("clamp")
        return()

    block n12()
        out.write("fdim")
        return()

    block n13()
        out.write("midpoint")
        return()

    block n14()
        out.write("next_up")
        return()

    block n15()
        out.write("next_down")
        return()

    block n16()
        out.write("scalbn")
        return()

    block n18()
        out.write("logb")
        return()

    block n19()
        out.write("frexp_fraction")
        return()

    block n20()
        out.write("frexp_exponent")
        return()

    block n21()
        out.write("to_s8_clamp")
        return()

    block n22()
        out.write("to_s16_clamp")
        return()

    block n23()
        out.write("to_s32_clamp")
        return()

    block n24()
        out.write("to_u8_clamp")
        return()

    block n25()
        out.write("to_u16_clamp")
        return()

    block n26()
        out.write("to_u32_clamp")
        return()

    block n27()
        out.write("to_u64_clamp")
        return()

    block n28()
        out.write("to_u128_clamp")
        return()

    block n29()
        out.write("sin_pi")
        return()

    block n30()
        out.write("cos_pi")
        return()

    block n31()
        out.write("tan_pi")
        return()

    block n32()
        out.write("sin_pi_exact")
        return()

    block n33()
        out.write("cos_pi_exact")
        return()

    block n34()
        out.write("tan_pi_exact")
        return()

// "name: count ok", or how many of the count were wrong
routine summary(out: @Out, id: U64, count: USize, bad: U64) -> Void
    block entry()
        name(out, id)
        out.write(": {count}")
        clean : Bool = bad.eq(0)
        branch clean
            ? ok()
            : failed()

    block ok()
        out.write(" ok\n")
        return()

    block failed()
        out.write(" run, {bad} wrong\n")
        return()

routine mismatch(out: @Out, row: USize, got: U128, want: U128) -> Void
    block entry()
        out.write("row {row}: got ")
        got.represent_hex_into(out)
        out.write(" want ")
        want.represent_hex_into(out)
        out.write("\n")
        return()

routine main() -> S32
    block entry()
        out : @Out = Out.writer()
        jump row(0, 0, 0, 0, out)

    block row(i: USize, id: U64, count: USize, bad: U64, out: @Out)
        done : Bool = i.ge(6573)
        branch done
            ? last(id, count, bad, out)
            : load(i, id, count, bad, out)

    block last(id: U64, count: USize, bad: U64, out: @Out)
        summary(out, id, count, bad)
        return(0)

    block load(i: USize, id: U64, count: USize, bad: U64, out: @Out)
        row_id   : U64  = EXTRA_ID.getitem(i)
        new_func : Bool = row_id.ne(id)
        branch new_func
            ? next_function(i, row_id, id, count, bad, out)
            : check(i, id, count, bad, out)

    block next_function(i: USize, row_id: U64, id: U64, count: USize, bad: U64, out: @Out)
        summary(out, id, count, bad)
        jump check(i, row_id, 0, 0, out)

    block check(i: USize, id: U64, count: USize, bad: U64, out: @Out)
        a_bits : U128 = EXTRA_A.getitem(i)
        b_bits : U128 = EXTRA_B.getitem(i)
        c_bits : U128 = EXTRA_C.getitem(i)
        n      : S64  = EXTRA_N.getitem(i)
        want   : U128 = EXTRA_WANT.getitem(i)
        a      : F128 = f128_of(a_bits)
        b      : F128 = f128_of(b_bits)
        c      : F128 = f128_of(c_bits)
        got    : U128 = compute(id, a, b, c, n)
        right  : Bool = got.eq(want)
        branch right
            ? next_row(i, id, count, bad, out)
            : report(i, id, count, bad, got, want, out)

    block report(i: USize, id: U64, count: USize, bad: U64, got: U128, want: U128, out: @Out)
        mismatch(out, i, got, want)
        jump next_row(i, id, count, bad.add(1), out)

    block next_row(i: USize, id: U64, count: USize, bad: U64, out: @Out)
        jump row(i.add(1), id, count.add(1), bad, out)
