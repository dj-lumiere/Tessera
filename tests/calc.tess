# Integer expression calculator
#
# Parses and evaluates integer expressions such as "-(4 - 10) % 4":
#
#     expr    = term    (("+" | "-") term)*
#     term    = primary (("*" | "/" | "%") primary)*
#     primary = number | "(" expr ")" | "-" primary
#
# The parser builds a heap-allocated tree, the evaluator walks it with
# overflow-checked S64 arithmetic, and every error (bad token, missing ")",
# division by zero, overflow) is reported with its column.
#
# What this program stresses:
#   * sum types: Expr is a tag plus every variant's fields. There is no
#     payload-carrying choice. Switches on the tag name every kind instead of
#     using '_', so adding a kind is a build error until each one handles it
#   * error propagation: every call that can fail is followed by an explicit
#     tag test and branch. Result[@Expr, CalcError] is spelled out each time
#   * cleanup on failure paths: when the right operand fails to parse, the
#     already-built left subtree has to be freed by hand
#   * recursion: parse_binary, parse_primary, eval, and free_expr recurse

import Standard/Alloc
import Standard/Os

# ── C FFI ─────────────────────────────────────────────────────────────────────

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

# ── Tokens ────────────────────────────────────────────────────────────────────

choice TokenKind: U8
    NUMBER
    PLUS
    MINUS
    STAR
    SLASH
    PERCENT
    L_PAREN
    R_PAREN
    END
    INVALID

record Token
    kind: TokenKind
    value: S64  # Number only
    pos: USize  # byte offset of the first character
    end: USize  # byte offset just past the token

record CalcError
    message: @Byte
    pos: USize

### Makes a `CalcError` from its fields.
### :param message: Its `message`.
### :param pos: Its `pos`.
### :returns: The new value.
routine CalcError.construct(message: @Byte, pos: USize) -> Me
    return Me(message, pos)

### Releases nothing: a `CalcError` holds no memory of its own.
routine CalcError.destruct(me: @Me) -> None
    return

# ── Syntax tree ───────────────────────────────────────────────────────────────

choice ExprKind: U8
    NUM
    NEG
    ADD
    SUB
    MUL
    DIV
    REM

### A manual sum type: `kind` says which fields mean something.
###   Num                    value
###   Neg                    lhs (the operand)
###   Add Sub Mul Div Rem    lhs, rhs
### `pos` is the column of the number or operator, for error messages.
record Expr
    kind: ExprKind
    value: S64
    lhs: @Expr
    rhs: @Expr
    pos: USize

### Makes a `Expr` from its fields.
### :param kind: Its `kind`.
### :param value: Its `value`.
### :param lhs: Its `lhs`.
### :param rhs: Its `rhs`.
### :param pos: Its `pos`.
### :returns: The new value.
routine Expr.construct(kind: ExprKind, value: S64, lhs: @Me, rhs: @Me, pos: USize) -> Me
    return Me(kind, value, lhs, rhs, pos)

### Releases nothing: a `Expr` holds no memory of its own.
routine Expr.destruct(me: @Me) -> None
    return

routine new_expr(node: Expr, alloc: @MemoryManager) -> @Expr
    local p: @Expr = allocate[Expr](count: 1, alloc)

    if p.is_null()
        crash_allocation()
    else
        p.poke(node)
        return p

### Frees e and its whole subtree.
routine free_expr(e: @Expr, alloc: @MemoryManager) -> None
    kind: ExprKind = e.kind.peek()
    when kind
        ExprKind.NUM => pass
        ExprKind.NEG =>
            operand: @Expr = e.lhs.peek()
            free_expr(e: operand, alloc)
        ExprKind.ADD, ExprKind.SUB, ExprKind.MUL, ExprKind.DIV, ExprKind.REM =>
            lhs: @Expr = e.lhs.peek()
            rhs: @Expr = e.rhs.peek()
            free_expr(e: lhs, alloc)
            free_expr(e: rhs, alloc)
    deallocate(data: e, alloc)
    return

# ── Lexer ─────────────────────────────────────────────────────────────────────

record Parser
    src: @Byte
    len: USize
    pos: USize
    alloc: @MemoryManager

### Makes a `Parser` from its fields.
### :param src: Its `src`.
### :param len: Its `len`.
### :param pos: Its `pos`.
### :param alloc: Its `alloc`.
### :returns: The new value.
routine Parser.construct(src: @Byte, len: USize, pos: USize, alloc: @MemoryManager) -> Me
    return Me(src, len, pos, alloc)

### Releases nothing: a `Parser` holds no memory of its own.
routine Parser.destruct(me: @Me) -> None
    return

routine is_digit(c: Byte) -> Bool
    above: Bool = c >= b'0'
    below: Bool = c <= b'9'
    return above and below

### Reads the token at the current position without consuming it.
### Fails only on a number that doesn't fit in S64.
routine Parser.peek(me: @Me) -> Result[Token, CalcError]
    jump skip_space(me.pos.peek())

    block skip_space(i: USize)
        len: USize = me.len.peek()
        if i >= len
            jump end_token(i)
        else
            jump check_space(i)

    block check_space(i: USize)
        src: @Byte = me.src.peek()
        c: Byte = src.stride(i).peek()
        if c == b' '
            jump skip_space(i + 1)
        else
            jump classify(i, c)

    block end_token(i: USize)
        tok: Token = Token(kind: TokenKind.END, value: 0, pos: i, end: i)
        r: Result[Token, CalcError] = tok
        return r

    block classify(i: USize, c: Byte)
        if is_digit(c)
            jump digits(i, i, 0)
        else
            jump punct(i, c)

    block punct(i: USize, c: Byte)
        when c
            b'+' => jump single(i, TokenKind.PLUS)
            b'-' => jump single(i, TokenKind.MINUS)
            b'*' => jump single(i, TokenKind.STAR)
            b'/' => jump single(i, TokenKind.SLASH)
            b'%' => jump single(i, TokenKind.PERCENT)
            b'(' => jump single(i, TokenKind.L_PAREN)
            b')' => jump single(i, TokenKind.R_PAREN)
            else => jump single(i, TokenKind.INVALID)

    block single(i: USize, kind: TokenKind)
        end: USize = i + 1
        tok: Token = Token(kind: kind, value: 0, pos: i, end: end)
        r: Result[Token, CalcError] = tok
        return r

    # acc is the value of src[start..j) so far.
    block digits(start: USize, j: USize, acc: S64)
        len: USize = me.len.peek()
        if j >= len
            jump number_done(start, j, acc)
        else
            jump check_digit(start, j, acc)

    block check_digit(start: USize, j: USize, acc: S64)
        src: @Byte = me.src.peek()
        c: Byte = src.stride(j).peek()
        if is_digit(c)
            jump scale(start, j, acc, c)
        else
            jump number_done(start, j, acc)

    block scale(start: USize, j: USize, acc: S64, c: Byte)
        scaled: Maybe[S64] = acc.mul_checked(10)
        times10: S64 = when scaled
            is S64 as times10 => times10
            is None => jump too_large(start)
        digit_code: U8 = c.to[U8]() - b'0'.to[U8]()
        digit: S64 = digit_code.to[S64]()
        sum: Maybe[S64] = times10.add_checked(digit)
        when sum
            is S64 as next => jump digits(start, j + 1, next)
            is None => jump too_large(start)

    block too_large(start: USize)
        e: CalcError = CalcError(message: "number too large", pos: start)
        r: Result[Token, CalcError] = e
        return r

    block number_done(start: USize, j: USize, acc: S64)
        tok: Token = Token(kind: TokenKind.NUMBER, value: acc, pos: start, end: j)
        r: Result[Token, CalcError] = tok
        return r

routine Parser.advance(me: @Me, tok: Token) -> None
    end: USize = tok.end
    me.pos.poke(end)
    return

# ── Parser ────────────────────────────────────────────────────────────────────

### The binary operator kind stands for at precedence level
### (0: + -, 1: * / %), or None when it isn't one.
routine operator_at(kind: TokenKind, level: S64) -> Maybe[ExprKind]
    additive: Bool = level == 0
    op: ExprKind = when
        additive =>
            when kind
                TokenKind.PLUS =>
                    becomes ExprKind.ADD
                TokenKind.MINUS =>
                    becomes ExprKind.SUB
                else =>
                    r: Maybe[ExprKind] = None()
                    return r
        else =>
            when kind
                TokenKind.STAR =>
                    becomes ExprKind.MUL
                TokenKind.SLASH =>
                    becomes ExprKind.DIV
                TokenKind.PERCENT =>
                    becomes ExprKind.REM
                else =>
                    r: Maybe[ExprKind] = None()
                    return r
    r: Maybe[ExprKind] = op
    return r

### An operand of a level-level operator: the next level down, or a primary.
routine Parser.parse_operand(me: @Me, level: S64) -> Result[@Expr, CalcError]
    if level == 0
        r: Result[@Expr, CalcError] = me.parse_binary(1)
        return r
    else
        r: Result[@Expr, CalcError] = me.parse_primary()
        return r

### operand (op operand)* at one precedence level, folded to the left.
routine Parser.parse_binary(me: @Me, level: S64) -> Result[@Expr, CalcError]
    first: Result[@Expr, CalcError] = me.parse_operand(level)
    when first
        is @Expr as lhs =>
            while true with lhs2: @Expr = lhs
                peeked: Result[Token, CalcError] = me.peek()
                when peeked
                    is Token as tok =>
                        tok_kind: TokenKind = tok.kind
                        op: Maybe[ExprKind] = operator_at(kind: tok_kind, level)
                        done: Result[@Expr, CalcError] = lhs2
                        kind: ExprKind = when op
                            is ExprKind as kind => kind
                            is None => return done
                        me.advance(tok)
                        rhs: Result[@Expr, CalcError] = me.parse_operand(level)
                        pos: USize = tok.pos
                        when rhs
                            is @Expr as right =>
                                alloc: @MemoryManager = me.alloc.peek()
                                node: Expr = Expr(kind: kind, value: 0, lhs: lhs2, rhs: right, pos: pos)
                                continue with lhs2: new_expr(node, alloc)
                            is CalcError as error =>
                                # The left side parsed but what follows didn't: free it before failing.
                                alloc: @MemoryManager = me.alloc.peek()
                                free_expr(e: lhs2, alloc)
                                r: Result[@Expr, CalcError] = error
                                return r
                    is CalcError as error =>
                        alloc: @MemoryManager = me.alloc.peek()
                        free_expr(e: lhs2, alloc)
                        r: Result[@Expr, CalcError] = error
                        return r
        is CalcError => return first

routine Parser.parse_primary(me: @Me) -> Result[@Expr, CalcError]
    peeked: Result[Token, CalcError] = me.peek()
    when peeked
        is Token as tok =>
            kind: TokenKind = tok.kind
            pos: USize = tok.pos
            when kind
                TokenKind.NUMBER =>
                    me.advance(tok)
                    alloc: @MemoryManager = me.alloc.peek()
                    value: S64 = tok.value
                    pos2: USize = tok.pos
                    node: Expr = Expr(kind: ExprKind.NUM, value: value, lhs: null, rhs: null, pos: pos2)
                    leaf: @Expr = new_expr(node, alloc)
                    r: Result[@Expr, CalcError] = leaf
                    return r
                TokenKind.L_PAREN =>
                    # "(" expr ")"
                    me.advance(tok)
                    inner: Result[@Expr, CalcError] = me.parse_binary(0)
                    tree: @Expr = when inner
                        is @Expr as tree => tree
                        is CalcError => return inner
                    peeked2: Result[Token, CalcError] = me.peek()
                    error: CalcError = when peeked2
                        is Token as close =>
                            kind2: TokenKind = close.kind
                            closed: Bool = kind2 == TokenKind.R_PAREN
                            pos2: USize = close.pos
                            e: CalcError = CalcError(message: "expected ')'", pos: pos2)
                            if closed
                                me.advance(close)
                                r: Result[@Expr, CalcError] = tree
                                return r
                            else
                                becomes e
                        is CalcError as error => error
                    alloc: @MemoryManager = me.alloc.peek()
                    free_expr(e: tree, alloc)
                    r: Result[@Expr, CalcError] = error
                    return r
                TokenKind.MINUS =>
                    me.advance(tok)
                    inner: Result[@Expr, CalcError] = me.parse_primary()
                    pos2: USize = tok.pos
                    operand: @Expr = when inner
                        is @Expr as operand => operand
                        is CalcError => return inner
                    alloc: @MemoryManager = me.alloc.peek()
                    node: Expr = Expr(kind: ExprKind.NEG, value: 0, lhs: operand, rhs: null, pos: pos2)
                    tree: @Expr = new_expr(node, alloc)
                    r: Result[@Expr, CalcError] = tree
                    return r
                TokenKind.END =>
                    message: @Byte = "unexpected end of input"

                    error: CalcError = CalcError(message: message, pos: pos)
                    r: Result[@Expr, CalcError] = error
                    return r
                TokenKind.INVALID =>
                    message: @Byte = "unexpected character"

                    error: CalcError = CalcError(message: message, pos: pos)
                    r: Result[@Expr, CalcError] = error
                    return r
                else =>
                    message: @Byte = "expected a number or '('"

                    error: CalcError = CalcError(message: message, pos: pos)
                    r: Result[@Expr, CalcError] = error
                    return r
        is CalcError as error =>
            r: Result[@Expr, CalcError] = error
            return r

    block fail(error: CalcError)
        r: Result[@Expr, CalcError] = error
        return r

### Parses all of source. Anything left after the expression is an error.
routine parse(source: Span[Byte], alloc: @MemoryManager) -> Result[@Expr, CalcError]
    local src: @Byte = source.data
    local len: USize = source.count
    local parser: @Parser <- Parser(src: src, len: len, pos: 0, alloc: alloc)

    parsed: Result[@Expr, CalcError] = parser.parse_binary(0)
    tree: @Expr = when parsed
        is @Expr as tree => tree
        is CalcError => return parsed
    peeked: Result[Token, CalcError] = parser.peek()
    # a lex error here is still "something after the expression"
    pos: USize = when peeked
        is Token as tok =>
            kind: TokenKind = tok.kind
            at_end: Bool = kind == TokenKind.END
            done: Result[@Expr, CalcError] = tree
            if at_end
                return done
            else
                becomes tok.pos
        is CalcError as error => error.pos
    free_expr(e: tree, alloc)
    e: CalcError = CalcError(message: "unexpected input after expression", pos: pos)
    r: Result[@Expr, CalcError] = e
    return r

# ── Evaluator ─────────────────────────────────────────────────────────────────

routine eval(e: @Expr) -> Result[S64, CalcError]
    local kind: ExprKind = e.kind.peek()
    local pos: USize = e.pos.peek()

    when kind
        ExprKind.NUM => jump number()
        ExprKind.NEG => jump negate()
        ExprKind.ADD, ExprKind.SUB, ExprKind.MUL, ExprKind.DIV, ExprKind.REM => jump binary()

    block number()
        value: S64 = e.value.peek()
        r: Result[S64, CalcError] = value
        return r

    block negate()
        operand: @Expr = e.lhs.peek()
        inner: Result[S64, CalcError] = eval(operand)
        when inner
            is S64 as x => jump checked(x.neg_checked())
            is CalcError => return inner

    block binary()
        lhs: @Expr = e.lhs.peek()
        left: Result[S64, CalcError] = eval(lhs)
        a: S64 = when left
            is S64 as a => a
            is CalcError => return left
        rhs: @Expr = e.rhs.peek()
        right: Result[S64, CalcError] = eval(rhs)
        b: S64 = when right
            is S64 as b => b
            is CalcError => return right
        zero_divisor: Bool = b == 0
        when kind
            ExprKind.ADD => jump checked(a.add_checked(b))
            ExprKind.SUB => jump checked(a.sub_checked(b))
            ExprKind.MUL => jump checked(a.mul_checked(b))
            ExprKind.DIV => jump divide(a, b, zero_divisor)
            ExprKind.REM => jump remainder(a, b, zero_divisor)
            else => unreachable

    # only the five binary kinds reach binary()
    block divide(a: S64, b: S64, zero_divisor: Bool)
        quotient: Maybe[S64] = a.div_checked(b)
        if zero_divisor
            jump division_by_zero()
        else
            jump checked(quotient)

    block remainder(a: S64, b: S64, zero_divisor: Bool)
        rest: Maybe[S64] = a.mod_checked(b)
        if zero_divisor
            jump division_by_zero()
        else
            jump checked(rest)

    # None from a checked operation with a nonzero divisor means overflow.
    block checked(result: Maybe[S64])
        error: CalcError = CalcError(message: "overflow", pos: pos)
        fail: Result[S64, CalcError] = error
        when result
            is S64 as value => return value
            is None => return fail

    block division_by_zero()
        error: CalcError = CalcError(message: "division by zero", pos: pos)
        r: Result[S64, CalcError] = error
        return r

# ── Driver ────────────────────────────────────────────────────────────────────

routine calculate(source: Span[Byte], alloc: @MemoryManager) -> None
    src: @Byte = source.data
    c_printf("%-34s ", src)
    parsed: Result[@Expr, CalcError] = parse(source, alloc)
    error: CalcError = when parsed
        is @Expr as tree =>
            result: Result[S64, CalcError] = eval(tree)
            free_expr(e: tree, alloc)
            when result
                is S64 as value =>
                    c_printf("= %lld\n", value)
                    return
                is CalcError as error =>
                    becomes error
        is CalcError as error => error
    pos: USize = error.pos
    message: @Byte = error.message
    c_printf("error at column %zu: %s\n", pos + 1, message)
    return

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()

    calculate(source: "1 + 2 * 3", alloc)
    calculate(source: "(1 + 2) * 3", alloc)
    calculate(source: "-(4 - 10) % 4", alloc)
    calculate(source: "2 * (3 + 4) * 5 - 100 / 7", alloc)
    calculate(source: "--7", alloc)
    calculate(source: "((((42))))", alloc)
    calculate(source: "9223372036854775807", alloc)

    calculate(source: "7 / (3 - 3)", alloc)
    calculate(source: "9223372036854775807 + 1", alloc)
    calculate(source: "-9223372036854775807 - 1 - 1", alloc)
    calculate(source: "99999999999999999999", alloc)
    calculate(source: "1 + * 2", alloc)
    calculate(source: "(1 + 2", alloc)
    calculate(source: "1 + 2)", alloc)
    calculate(source: "3 $ 4", alloc)
    calculate(source: "", alloc)
    return
