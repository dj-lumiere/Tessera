// Integer expression calculator
//
// Parses and evaluates integer expressions such as "-(4 - 10) % 4":
//
//     expr    = term    (("+" | "-") term)*
//     term    = primary (("*" | "/" | "%") primary)*
//     primary = number | "(" expr ")" | "-" primary
//
// The parser builds a heap-allocated tree, the evaluator walks it with
// overflow-checked S64 arithmetic, and every error (bad token, missing ")",
// division by zero, overflow) is reported with its column.
//
// What this program stresses:
//   * sum types: Expr is a tag plus every variant's fields. There is no
//     payload-carrying choice; switches on the tag name every kind instead of
//     using '_', so adding a kind is a build error until each one handles it
//   * error propagation: every call that can fail is followed by an explicit
//     tag test and branch; Result<@Expr, CalcError> is spelled out each time
//   * cleanup on failure paths: when the right operand fails to parse, the
//     already-built left subtree has to be freed by hand
//   * recursion: parse_binary, parse_primary, eval, and free_expr recurse

import Standard::Alloc
import Standard::Os

// ── C FFI ─────────────────────────────────────────────────────────────────────

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

// ── Tokens ────────────────────────────────────────────────────────────────────

choice TokenKind: U8
    Number
    Plus
    Minus
    Star
    Slash
    Percent
    LParen
    RParen
    End
    Invalid

record Token
    kind  : TokenKind
    value : S64  // Number only
    pos   : USize  // byte offset of the first character
    end   : USize  // byte offset just past the token

record CalcError
    message : @Byte
    pos     : USize

// ── Syntax tree ───────────────────────────────────────────────────────────────

choice ExprKind: U8
    Num
    Neg
    Add
    Sub
    Mul
    Div
    Rem

/// A manual sum type: `kind` says which fields mean something.
///   Num                    value
///   Neg                    lhs (the operand)
///   Add Sub Mul Div Rem    lhs, rhs
/// `pos` is the column of the number or operator, for error messages.
record Expr
    kind  : ExprKind
    value : S64
    lhs   : @Expr
    rhs   : @Expr
    pos   : USize

routine new_expr(alloc: @Allocator, node: Expr) -> @Expr
    block entry()
        p      : @Expr = allocate<Expr>(alloc, 1)
        failed : Bool  = p.is_null()
        branch failed
            ? crash_allocation()
            : store(p)

    block store(p: @Expr)
        p.store(node)
        return(p)

/// Frees e and its whole subtree.
routine free_expr(e: @Expr, alloc: @Allocator) -> Void
    block entry()
        kind : ExprKind = e.kind.load()
        when kind
            ExprKind.Num                                                         -> release()
            ExprKind.Neg                                                         -> free_operand()
            ExprKind.Add, ExprKind.Sub, ExprKind.Mul, ExprKind.Div, ExprKind.Rem -> free_both()

    block free_operand()
        operand : @Expr = e.lhs.load()
        free_expr(operand, alloc)
        jump release()

    block free_both()
        lhs : @Expr = e.lhs.load()
        rhs : @Expr = e.rhs.load()
        free_expr(lhs, alloc)
        free_expr(rhs, alloc)
        jump release()

    block release()
        e.free(alloc)
        return()

// ── Lexer ─────────────────────────────────────────────────────────────────────

record Parser
    src   : @Byte
    len   : USize
    pos   : USize
    alloc : @Allocator

routine is_digit(c: Byte) -> Bool
    block entry()
        above  : Bool = c.ge(b'0')
        below  : Bool = c.le(b'9')
        result : Bool = above.bitand(below)
        return(result)

/// Reads the token at the current position without consuming it.
/// Fails only on a number that doesn't fit in S64.
routine Parser.peek(self: @Self) -> Result<Token, CalcError>
    block entry()
        start : USize = self.pos.load()
        jump skip_space(start)

    block skip_space(i: USize)
        len    : USize = self.len.load()
        at_end : Bool  = i.ge(len)
        branch at_end
            ? end_token(i)
            : check_space(i)

    block check_space(i: USize)
        src      : @Byte = self.src.load()
        c        : Byte  = src.stride(i).load()
        is_space : Bool  = c.eq(b' ')
        branch is_space
            ? skip_space(i.add(1))
            : classify(i, c)

    block end_token(i: USize)
        tok : Token                    = Token { kind: TokenKind.End, value: 0, pos: i, end: i }
        r   : Result<Token, CalcError> = .Success(tok)
        return(r)

    block classify(i: USize, c: Byte)
        digit : Bool = is_digit(c)
        branch digit
            ? digits(i, i, 0)
            : punct(i, c)

    block punct(i: USize, c: Byte)
        when c
            b'+' -> single(i, TokenKind.Plus)
            b'-' -> single(i, TokenKind.Minus)
            b'*' -> single(i, TokenKind.Star)
            b'/' -> single(i, TokenKind.Slash)
            b'%' -> single(i, TokenKind.Percent)
            b'(' -> single(i, TokenKind.LParen)
            b')' -> single(i, TokenKind.RParen)
            else -> single(i, TokenKind.Invalid)

    block single(i: USize, kind: TokenKind)
        end : USize                    = i.add(1)
        tok : Token                    = Token { kind: kind, value: 0, pos: i, end: end }
        r   : Result<Token, CalcError> = .Success(tok)
        return(r)

    // acc is the value of src[start..j) so far.
    block digits(start: USize, j: USize, acc: S64)
        len    : USize = self.len.load()
        at_end : Bool  = j.ge(len)
        branch at_end
            ? number_done(start, j, acc)
            : check_digit(start, j, acc)

    block check_digit(start: USize, j: USize, acc: S64)
        src   : @Byte = self.src.load()
        c     : Byte  = src.stride(j).load()
        digit : Bool  = is_digit(c)
        branch digit
            ? scale(start, j, acc, c)
            : number_done(start, j, acc)

    block scale(start: USize, j: USize, acc: S64, c: Byte)
        scaled : Option<S64> = acc.mul_checked(10)
        when scaled
            .Present(times10) -> add_digit(start, j, times10, c)
            .Absent           -> too_large(start)

    block add_digit(start: USize, j: USize, times10: S64, c: Byte)
        digit_code : U8          = c.to<U8>().sub(b'0'.to<U8>())
        digit      : S64         = digit_code.to<S64>()
        sum        : Option<S64> = times10.add_checked(digit)
        when sum
            .Present(next) -> digits(start, j.add(1), next)
            .Absent        -> too_large(start)

    block too_large(start: USize)
        e : CalcError                = CalcError { message: "number too large", pos: start }
        r : Result<Token, CalcError> = .Failure(e)
        return(r)

    block number_done(start: USize, j: USize, acc: S64)
        tok : Token                    = Token { kind: TokenKind.Number, value: acc, pos: start,
            end: j }
        r   : Result<Token, CalcError> = .Success(tok)
        return(r)

routine Parser.advance(self: @Self, tok: Token) -> Void
    block entry()
        end : USize = tok.end
        self.pos.store(end)
        return()

// ── Parser ────────────────────────────────────────────────────────────────────

/// The binary operator kind stands for at precedence level
/// (0: + -, 1: * / %), or Absent when it isn't one.
routine operator_at(kind: TokenKind, level: S64) -> Option<ExprKind>
    block entry()
        additive : Bool = level.eq(0)
        branch additive
            ? additive()
            : multiplicative()

    block additive()
        when kind
            TokenKind.Plus  -> found(ExprKind.Add)
            TokenKind.Minus -> found(ExprKind.Sub)
            else            -> not_found()

    block multiplicative()
        when kind
            TokenKind.Star    -> found(ExprKind.Mul)
            TokenKind.Slash   -> found(ExprKind.Div)
            TokenKind.Percent -> found(ExprKind.Rem)
            else              -> not_found()

    block found(op: ExprKind)
        r : Option<ExprKind> = .Present(op)
        return(r)

    block not_found()
        r : Option<ExprKind> = .Absent
        return(r)

/// An operand of a level-level operator: the next level down, or a primary.
routine Parser.parse_operand(self: @Self, level: S64) -> Result<@Expr, CalcError>
    block entry()
        lowest : Bool = level.eq(0)
        branch lowest
            ? term()
            : primary()

    block term()
        r : Result<@Expr, CalcError> = self.parse_binary(1)
        return(r)

    block primary()
        r : Result<@Expr, CalcError> = self.parse_primary()
        return(r)

/// operand (op operand)* at one precedence level, folded to the left.
routine Parser.parse_binary(self: @Self, level: S64) -> Result<@Expr, CalcError>
    block entry()
        first : Result<@Expr, CalcError> = self.parse_operand(level)
        when first
            .Success(lhs) -> next_op(lhs)
            .Failure      -> return(first)

    block next_op(lhs: @Expr)
        peeked : Result<Token, CalcError> = self.peek()
        when peeked
            .Success(tok)   -> check_op(lhs, tok)
            .Failure(error) -> abandon(lhs, error)

    block check_op(lhs: @Expr, tok: Token)
        tok_kind : TokenKind                = tok.kind
        op       : Option<ExprKind>         = operator_at(tok_kind, level)
        done     : Result<@Expr, CalcError> = .Success(lhs)
        when op
            .Present(kind) -> parse_rhs(lhs, tok, kind)
            .Absent        -> return(done)

    block parse_rhs(lhs: @Expr, tok: Token, kind: ExprKind)
        self.advance(tok)
        rhs : Result<@Expr, CalcError> = self.parse_operand(level)
        pos : USize                    = tok.pos
        when rhs
            .Success(right) -> combine(lhs, right, kind, pos)
            .Failure(error) -> abandon(lhs, error)

    block combine(lhs: @Expr, right: @Expr, kind: ExprKind, pos: USize)
        alloc : @Allocator = self.alloc.load()
        node  : Expr       = Expr { kind: kind, value: 0, lhs: lhs, rhs: right, pos: pos }
        tree  : @Expr      = new_expr(alloc, node)
        jump next_op(tree)

    // The left side parsed but what follows didn't: free it before failing.
    block abandon(lhs: @Expr, error: CalcError)
        alloc : @Allocator = self.alloc.load()
        free_expr(lhs, alloc)
        r : Result<@Expr, CalcError> = .Failure(error)
        return(r)

routine Parser.parse_primary(self: @Self) -> Result<@Expr, CalcError>
    block entry()
        peeked : Result<Token, CalcError> = self.peek()
        when peeked
            .Success(tok)   -> dispatch(tok)
            .Failure(error) -> fail(error)

    block dispatch(tok: Token)
        kind : TokenKind = tok.kind
        pos  : USize     = tok.pos
        when kind
            TokenKind.Number  -> number(tok)
            TokenKind.LParen  -> group(tok)
            TokenKind.Minus   -> negate(tok)
            TokenKind.End     -> fail_at("unexpected end of input", pos)
            TokenKind.Invalid -> fail_at("unexpected character", pos)
            else              -> fail_at("expected a number or '('", pos)

    block number(tok: Token)
        self.advance(tok)
        alloc : @Allocator               = self.alloc.load()
        value : S64                      = tok.value
        pos   : USize                    = tok.pos
        node  : Expr                     = Expr { kind: ExprKind.Num, value: value, lhs: null,
            rhs: null, pos: pos }
        leaf  : @Expr                    = new_expr(alloc, node)
        r     : Result<@Expr, CalcError> = .Success(leaf)
        return(r)

    block negate(tok: Token)
        self.advance(tok)
        inner : Result<@Expr, CalcError> = self.parse_primary()
        pos   : USize                    = tok.pos
        when inner
            .Success(operand) -> wrap_neg(operand, pos)
            .Failure          -> return(inner)

    block wrap_neg(operand: @Expr, pos: USize)
        alloc : @Allocator               = self.alloc.load()
        node  : Expr                     = Expr { kind: ExprKind.Neg, value: 0, lhs: operand,
            rhs: null, pos: pos }
        tree  : @Expr                    = new_expr(alloc, node)
        r     : Result<@Expr, CalcError> = .Success(tree)
        return(r)

    // "(" expr ")"
    block group(open: Token)
        self.advance(open)
        inner : Result<@Expr, CalcError> = self.parse_binary(0)
        when inner
            .Success(tree) -> expect_close(tree)
            .Failure       -> return(inner)

    block expect_close(tree: @Expr)
        peeked : Result<Token, CalcError> = self.peek()
        when peeked
            .Success(close) -> check_close(tree, close)
            .Failure(error) -> abandon(tree, error)

    block check_close(tree: @Expr, close: Token)
        kind   : TokenKind = close.kind
        closed : Bool      = kind.eq(TokenKind.RParen)
        pos    : USize     = close.pos
        e      : CalcError = CalcError { message: "expected ')'", pos: pos }
        branch closed
            ? close(tree, close)
            : abandon(tree, e)

    block close(tree: @Expr, close: Token)
        self.advance(close)
        r : Result<@Expr, CalcError> = .Success(tree)
        return(r)

    block abandon(tree: @Expr, error: CalcError)
        alloc : @Allocator = self.alloc.load()
        free_expr(tree, alloc)
        jump fail(error)

    block fail_at(message: @Byte, pos: USize)
        e : CalcError = CalcError { message: message, pos: pos }
        jump fail(e)

    block fail(error: CalcError)
        r : Result<@Expr, CalcError> = .Failure(error)
        return(r)

/// Parses all of source; anything left after the expression is an error.
routine parse(source: Bytes, alloc: @Allocator) -> Result<@Expr, CalcError>
    block entry()
        src : @Byte = source.data
        len : USize = source.length
        claim self : @Parser <- Parser { src: src, len: len, pos: 0, alloc: alloc }
        parsed : Result<@Expr, CalcError> = self.parse_binary(0)
        when parsed
            .Success(tree) -> expect_end(self, tree)
            .Failure       -> return(parsed)

    block expect_end(self: @Parser, tree: @Expr)
        peeked : Result<Token, CalcError> = self.peek()
        // a lex error here is still "something after the expression"
        when peeked
            .Success(tok)   -> check_end(tree, tok)
            .Failure(error) -> trailing(tree, error.pos)

    block check_end(tree: @Expr, tok: Token)
        kind   : TokenKind                = tok.kind
        at_end : Bool                     = kind.eq(TokenKind.End)
        done   : Result<@Expr, CalcError> = .Success(tree)
        branch at_end
            ? return(done)
            : trailing(tree, tok.pos)

    block trailing(tree: @Expr, pos: USize)
        free_expr(tree, alloc)
        e : CalcError                = CalcError { message: "unexpected input after expression",
            pos: pos }
        r : Result<@Expr, CalcError> = .Failure(e)
        return(r)

// ── Evaluator ─────────────────────────────────────────────────────────────────

routine eval(e: @Expr) -> Result<S64, CalcError>
    block entry()
        kind : ExprKind = e.kind.load()
        pos  : USize    = e.pos.load()
        when kind
            ExprKind.Num                                                         -> number()
            ExprKind.Neg                                                         -> negate(pos)
            ExprKind.Add, ExprKind.Sub, ExprKind.Mul, ExprKind.Div, ExprKind.Rem -> binary(kind,
                pos)

    block number()
        value : S64                    = e.value.load()
        r     : Result<S64, CalcError> = .Success(value)
        return(r)

    block negate(pos: USize)
        operand : @Expr                  = e.lhs.load()
        inner   : Result<S64, CalcError> = eval(operand)
        when inner
            .Success(x) -> checked(x.neg_checked(), pos)
            .Failure    -> return(inner)

    block binary(kind: ExprKind, pos: USize)
        lhs  : @Expr                  = e.lhs.load()
        left : Result<S64, CalcError> = eval(lhs)
        when left
            .Success(a) -> eval_rhs(kind, pos, a)
            .Failure    -> return(left)

    block eval_rhs(kind: ExprKind, pos: USize, a: S64)
        rhs   : @Expr                  = e.rhs.load()
        right : Result<S64, CalcError> = eval(rhs)
        when right
            .Success(b) -> apply(kind, pos, a, b)
            .Failure    -> return(right)

    block apply(kind: ExprKind, pos: USize, a: S64, b: S64)
        zero_divisor : Bool = b.eq(0)
        when kind
            ExprKind.Add -> checked(a.add_checked(b), pos)
            ExprKind.Sub -> checked(a.sub_checked(b), pos)
            ExprKind.Mul -> checked(a.mul_checked(b), pos)
            ExprKind.Div -> divide(pos, a, b, zero_divisor)
            ExprKind.Rem -> remainder(pos, a, b, zero_divisor)
            else         -> unreachable  // binary() only ever passes the five binary kinds

    block divide(pos: USize, a: S64, b: S64, zero_divisor: Bool)
        quotient : Option<S64> = a.div_checked(b)
        branch zero_divisor
            ? division_by_zero(pos)
            : checked(quotient, pos)

    block remainder(pos: USize, a: S64, b: S64, zero_divisor: Bool)
        rest : Option<S64> = a.mod_checked(b)
        branch zero_divisor
            ? division_by_zero(pos)
            : checked(rest, pos)

    // None from a checked operation with a nonzero divisor means overflow.
    block checked(result: Option<S64>, pos: USize)
        error : CalcError              = CalcError { message: "overflow", pos: pos }
        fail  : Result<S64, CalcError> = .Failure(error)
        when result
            .Present(value) -> return(.Success(value))
            .Absent         -> return(fail)

    block division_by_zero(pos: USize)
        error : CalcError              = CalcError { message: "division by zero", pos: pos }
        r     : Result<S64, CalcError> = .Failure(error)
        return(r)

// ── Driver ────────────────────────────────────────────────────────────────────

routine calculate(source: Bytes, alloc: @Allocator) -> Void
    block entry()
        src : @Byte = source.data
        c_printf("%-34s ", src)
        parsed : Result<@Expr, CalcError> = parse(source, alloc)
        when parsed
            .Success(tree)  -> evaluate(tree)
            .Failure(error) -> report(error)

    block evaluate(tree: @Expr)
        result : Result<S64, CalcError> = eval(tree)
        free_expr(tree, alloc)
        when result
            .Success(value) -> show(value)
            .Failure(error) -> report(error)

    block show(value: S64)
        c_printf("= %lld\n", value)
        return()

    block report(error: CalcError)
        pos     : USize = error.pos
        message : @Byte = error.message
        c_printf("error at column %zu: %s\n", pos.add(1), message)
        return()

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        calculate("1 + 2 * 3", alloc)
        calculate("(1 + 2) * 3", alloc)
        calculate("-(4 - 10) % 4", alloc)
        calculate("2 * (3 + 4) * 5 - 100 / 7", alloc)
        calculate("--7", alloc)
        calculate("((((42))))", alloc)
        calculate("9223372036854775807", alloc)

        calculate("7 / (3 - 3)", alloc)
        calculate("9223372036854775807 + 1", alloc)
        calculate("-9223372036854775807 - 1 - 1", alloc)
        calculate("99999999999999999999", alloc)
        calculate("1 + * 2", alloc)
        calculate("(1 + 2", alloc)
        calculate("1 + 2)", alloc)
        calculate("3 $ 4", alloc)
        calculate("", alloc)
        return(0)
