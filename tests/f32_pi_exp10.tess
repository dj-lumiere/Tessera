// F32's sin_pi, cos_pi, tan_pi and exp10: CORE-MATH ports, correctly rounded, so the same bits on every target.
// Each line is an input and the four results, as bits. The expected values come from mpmath (the exact value,
// rounded to F32 to nearest, ties to even): signed zeros and infinities, NaNs, integers, half-integers and
// quarters (exact, with the sign rules of IEEE 754 sinPi, cosPi and tanPi), subnormals, huge arguments, the
// thresholds of the code, the arguments it lists, inputs that reach its accurate phases, and ordinary ones.

import Standard::Format
import Standard::Os

preset INPUTS: @Array<U32, 84> <- { 0x00000000, 0x80000000, 0x7F800000, 0xFF800000, 0x7FC00000,
    0xFFC00005, 0x7F800001, 0x3F800000, 0xBF800000, 0x40000000, 0xC0000000, 0x40400000, 0xC0400000,
    0x3F000000, 0xBF000000, 0x3FC00000, 0xBFC00000, 0x40200000, 0xC0200000, 0x3E800000, 0xBE800000,
    0x3F400000, 0xBF400000, 0x3FA00000, 0xBFA00000, 0x3C800000, 0xBC800000, 0x3CC00000, 0xBCC00000,
    0x48000000, 0x47FFFFFF, 0x4B000000, 0x4AFFFFFF, 0x4B000001, 0x4B800000, 0x4B7FFFFF, 0x7F7FFFFF,
    0xFF7FFFFF, 0x3E933802, 0xBE933802, 0x38F26685, 0xB8F26685, 0x38000000, 0x37FFFFFF, 0x00800000,
    0x00000001, 0x80000001, 0x007FFFFF, 0x0019F030, 0x0019F02F, 0x3DCCCCCD, 0xBDCCCCCD, 0x3EAAAAAB,
    0xBEAAAAAB, 0x3F333333, 0xBF333333, 0x42F6E979, 0xC2F6E979, 0x3C23D70A, 0xBC23D70A, 0x1E3CE508,
    0x9E3CE508, 0x38800000, 0xB8800000, 0x3727C5AC, 0xB727C5AC, 0x41200000, 0xC1200000, 0x41300000,
    0xC1300000, 0x40E00000, 0xC0E00000, 0x421A0000, 0xC21A0000, 0x421A1EB8, 0xC21A1EB8, 0x421A28F6,
    0xC21A28F6, 0x42340000, 0xC2340000, 0x4217999A, 0xC217999A, 0x42336666, 0xC2336666 }

routine hex(out: @Out, v: U32) -> Void
    block entry()
        out.write(" 0x")
        v.to<U64>().represent_hex_into(out, 8)
        return()

routine start() -> Void
    shared out : @Out = Out.writer()

    block entry()
        jump each(0)

    block each(i: USize)
        done : Bool = i.eq(84)
        branch done
            ? return()
            : continue
        u : U32 = INPUTS.getitem(i)
        x : F32 = .from_bits(u)
        out.write("0x")
        u.to<U64>().represent_hex_into(out, 8)
        hex(out, x.sin_pi().bits())
        hex(out, x.cos_pi().bits())
        hex(out, x.tan_pi().bits())
        hex(out, x.exp10().bits())
        out.write("\n")
        jump each(i.add(1))
