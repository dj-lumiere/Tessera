# A destruct that fetches another pooled entity while the pool ends sees it as ended, whatever the order the entities
# end in: every stamp is stale before the first destruct runs.

import Hosted

### An entity with a link to a friend.
entity Friend
    name: S64
    friend: Stamped[Friend]?

### Makes a friend.
### :param name: Its number.
### :param friend: The one it knows.
### :returns: The entity.
common routine Friend.construct(name: S64, friend: Stamped[Friend]?) -> Me
    return Me(name, friend)

### Ends the entity and tries to reach its friend.
routine @Friend.destruct() -> None
    when me.friend.peek()
        is Stamped[Friend] as s =>
            when try s.fetch()
                is @Friend => Console.show("{me.name.peek()}: friend still there")
                is None => Console.show("{me.name.peek()}: friend already ended")
        is None => Console.show("{me.name.peek()}: no friend")
    return

### Ends a pool of friends who look at each other.
routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    one: Stamped[Friend] = PoolManager.add(Friend.construct(name: 1, friend: None()))
    two: Stamped[Friend] = PoolManager.add(Friend.construct(name: 2, friend: one))
    three: Stamped[Friend] = PoolManager.add(Friend.construct(name: 3, friend: two))
    one.fetch().friend.poke(three)
    drop pool
    return
