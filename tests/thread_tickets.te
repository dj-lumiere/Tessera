# Thread tickets: put_work with no argument up to four (a tuple), a result retrieve waits for, the same ticket taking a
# second piece of work, a Thread[None], waitfor(1ms).retrieve() that runs out before slow work finishes, cancel that
# the work sees through cancel_requested() and retrieve reports, a @threadlocal global back at its
# starting value for the next ticket on a reused thread, and a fiber that waits for a thread ticket while the other
# fibers of its manager go on.

import Standard/Fiber
import Standard/Os

@threadlocal
global SEEN: &U64 <- 7

record Log
    steps: U64

routine forty_two() -> S64
    return 42

routine twice(n: S64) -> S64
    return n * 2

routine sum3(a: S64, b: S64, c: S64) -> S64
    return a + b + c

routine sum4(a: S64, b: S64, c: S64, d: S64) -> S64
    return a + b + c + d

routine pair(a: S64, b: Bool) -> S64
    if b
        return a
    else
        return -a

### Leaves a mark in this thread's SEEN, and returns what was there.
routine mark(value: U64) -> U64
    before: U64 = SEEN.peek()
    SEEN.poke(value)
    return before

### Sleeps until cancelled, a millisecond at a time, and says how many naps it took.
routine nap_until_cancelled(limit: U64) -> U64
    until cancel_requested() or (n >= limit) with n: U64 = 0
        waitfor(1ms)
        continue with n: n + 1
    then
        return n

routine slow(ns: U64) -> U64
    waitfor(Duration.from_nanoseconds(ns.to[S64]()))
    return ns

### Thread work that ends once the stepping fiber has taken all five steps, or after 10 s: it ends early only while
### the fiber keeps running, so the count does not depend on how finely the platform sleeps.
### :param log: The steps the fiber took.
### :returns: The steps seen at the end.
routine until_five_steps(log: @Log) -> U64
    deadline: Duration = Clock.monotonic() + 10s
    until log.steps.peek_unbroken() == 5 or not (Clock.monotonic() < deadline)
        waitfor(100us)
    then
        return log.steps.peek_unbroken()

### A fiber that waits for a thread ticket: only it waits.
routine waits_for_thread(log: @Log) -> S64
    t: Thread[U64] <- get_thread[U64]()
    work_t: Work[U64] = until_five_steps.to[Work](log: log)
    t.put_work(work_t)
    t.retrieve()
    drop t
    return log.steps.peek().to[S64]()

### A fiber that keeps stepping while the other waits.
routine steps(log: @Log) -> S64
    until i == 5 with i: U64 = 0
        log.steps.poke_unbroken(i + 1)
        FIBERS.waitfor(200us)
        continue with i: i + 1
    then
        return 5

### Cancels work that naps until it is, and reports what retrieve_result says.
### :param out: Where the line goes.
routine cancelled(out: @ConsoleOutput) -> None
    k: Thread[U64] <- get_thread[U64]()

    work_k: Work[U64] = nap_until_cancelled.to[Work](limit: 100000)
    k.put_work(work_k)
    if (try k.waitfor(3ms).retrieve()).is_absent()
        k.cancel()
        when check k.retrieve()
            is U64 => nothing
            is CancelRequested =>
                out.write("cancelled\n")
                drop k
                return
    out.write("not cancelled\n")
    drop k
    return

routine start() -> None
    out: @ConsoleOutput = Console.output()
    t: Thread[S64] <- get_thread[S64]()
    work_t: Work[S64] = forty_two.to[Work]()
    t.put_work(work_t)
    a: S64 = t.retrieve()
    work_t_2: Work[S64] = twice.to[Work](n: a)
    t.put_work(work_t_2)
    b: S64 = t.retrieve()
    work_t_3: Work[S64] = pair.to[Work](a: b, b: false)
    t.put_work(work_t_3)
    c: S64 = t.retrieve()
    work_t_4: Work[S64] = sum3.to[Work](a: 1, b: 2, c: 3)
    t.put_work(work_t_4)
    d: S64 = t.retrieve()
    work_t_5: Work[S64] = sum4.to[Work](a: 1, b: 2, c: 3, d: 4)
    t.put_work(work_t_5)
    e: S64 = t.retrieve()
    out.write("results: {a} {b} {c} {d} {e}, finished: {t.check_finished()}\n")
    drop t

    m: Thread[U64] <- get_thread[U64]()
    work_m: Work[U64] = mark.to[Work](value: 99)
    m.put_work(work_m)
    first: U64 = m.retrieve()
    work_m_2: Work[U64] = mark.to[Work](value: 5)
    m.put_work(work_m_2)
    second: U64 = m.retrieve()
    out.write("thread-local at the start of each work: {first} {second}\n")
    drop m

    s: Thread[U64] <- get_thread[U64]()
    work_s: Work[U64] = slow.to[Work](ns: 200000000)
    s.put_work(work_s)
    in_time: Bool = (try s.waitfor(1ms).retrieve()).is_present()
    out.write("slow work finished in 1 ms: {in_time}, running: {not s.check_finished()}\n")
    s.retrieve()
    drop s

    cancelled(out)

    log: &Log <- Log(steps: 0)
    w: Fiber[S64] <- FIBERS.get_fiber[S64]()
    work_w: Work[S64] = waits_for_thread.to[Work](log: log)
    w.put_work(work_w)
    x: Fiber[S64] <- FIBERS.get_fiber[S64]()
    work_x: Work[S64] = steps.to[Work](log: log)
    x.put_work(work_x)
    FIBERS.run()
    out.write("steps the other fiber took while one waited for a thread: {w.retrieve()} of {x.retrieve()}\n")
    drop w
    drop x
    drop FIBERS
    return
