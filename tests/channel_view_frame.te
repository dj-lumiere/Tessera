# A view of a frame place can't go into a channel either, even one of the routine's own: the receiver on another
# thread or fiber could read it after the routine gives the place back.

import Hosted

### Transmits a view of a frame place.
routine start() -> None
    ch: &SharedChannel[@[Byte]] <- .construct(capacity: 4)
    line: &[Byte] <- [b'a', b'b']
    ch.transmit(line.getview())
    drop ch
    return
