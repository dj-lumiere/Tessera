// x86-64 segment registers as operands: one is read as its selector, whose low two bits are the privilege level the
// program runs at, 3 (user mode) on every OS.

import Standard::Format
import Standard::Os

#[target(arch: "x86_64"), external("asm")]
routine selectors() -> (U16, U16)
    block entry()
        mov<U16>(R0, CS)  // mov ax, cs
        mov<U16>(R1, SS)  // mov cx, ss
        return({ R0, R1 })

routine start() -> Void
    block entry()
        code, stack = selectors()
        Out.write("cs ring {code.bitand(3)}, ss ring {stack.bitand(3)}\n")
        return()
