# A MemoryManager hands out blocks at the alignment asked for, HEAP is a heap without pages, and PAGES handles pages:
# reserve, commit, protect, release. A manager without pages says so, and calling its reserve crashes with NotImplementedError.

import Standard/Os

### A memory manager that hands out the default heap's blocks and doesn't handle pages.
record Plain

obeys MemoryManageable[Plain]

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash on stdout and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("crashed: {name}")
    exit(3)

### Whether `at` is a multiple of `align`.
### :param at: The address.
### :param align: The alignment.
### :returns: True when aligned.
routine aligned(at: Addr, align: U64) -> Bool
    return ptrtoint[Addr, U64](at) & align - 1 == 0

### The default heap's allocation.
### :param size: The size in bytes.
### :param align: The alignment.
### :returns: The block, or null.
routine @Plain.alloc(size: U64, align: U64) -> Addr
    return HEAP.alloc(size, align)

### The default heap's reallocation.
### :param at: The block.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The block, or null.
@reshaping(at)
routine @Plain.realloc(at: Addr, size: U64, align: U64) -> Addr
    return HEAP.realloc(at, size, align)

### The default heap's free.
### :param at: The block.
routine @Plain.free(at: Addr) -> None
    HEAP.free(at)
    return

routine start() -> None
    local heap: @MemoryManager <- HEAP.peek()
    local blocks_only: @Plain <- .hollow()
    local plain: @MemoryManager <- blocks_only.to[MemoryManager]()

    wide: Addr = heap.alloc(size: 100, align: 256)
    Console.show("aligned 256: {aligned(at: wide, align: 256)}")
    grown: Addr = heap.realloc(at: wide, size: 5000, align: 256)
    Console.show("still aligned: {aligned(at: grown, align: 256)}")
    heap.free(grown)
    Console.show("heap pages: {heap.has_pages()}, pages: {PAGES.has_pages()} {PAGES.has_protect()}")
    page: U64 = page_size().bytes()
    space: Addr = PAGES.reserve(page * 4)
    committed: Bool = PAGES.commit(at: space, size: page * 2)
    42.poke_into(space.to[@U64]())
    closed: Bool = PAGES.protect(at: space.offset(page.to[S64]()), size: page,
        access: PageAccess.READ)
    Console.show("committed {committed}, protected {closed}, read {space.to[@U64]().peek()}")
    PAGES.release(at: space, size: page * 4)
    chunk: Addr = PAGES.alloc(size: 100, align: 64)
    7.poke_into(chunk.to[@U64]())
    bigger: Addr = PAGES.realloc(at: chunk, size: page * 3, align: 64)
    Console.show("page block kept {bigger.to[@U64]().peek()}, page aligned {aligned(at: bigger, align: page)}")
    PAGES.free(bigger)
    Console.show("plain pages: {plain.has_pages()}")
    nothing: Addr = plain.reserve(page)
    Console.show("not reached {nothing}")
    return
