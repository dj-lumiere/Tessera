# A MemoryManager hands out blocks at the alignment asked for, and DEFAULT_HEAP handles pages: reserve, commit,
# protect, release. A manager without pages says so, and calling its reserve crashes with NotImplementedError.

import Standard/Alloc
import Standard/Format
import Standard/Os

### A memory manager that hands out the default heap's blocks and doesn't handle pages.
record Plain

obeys MemoryManageable[Plain]

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash on stdout and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Out.write("crashed: {name}\n")
    exit(3)

### Whether `at` is a multiple of `align`.
### :param at: The address.
### :param align: The alignment.
### :returns: True when aligned.
routine aligned(at: Addr, align: U64) -> Bool
    return ptrtoint[Addr, U64](at) & align - 1 == 0

### The default heap's allocation.
### :param size: The size in bytes.
### :param align: The alignment.
### :returns: The block, or null.
routine Plain.alloc(me: @Me, size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.alloc(size, align)

### The default heap's reallocation.
### :param at: The block.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The block, or null.
@reshaping(at)
routine Plain.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.realloc(at, size, align)

### The default heap's free.
### :param at: The block.
routine Plain.free(me: @Me, at: Addr) -> None
    DEFAULT_HEAP.free(at)
    return

routine start() -> None
    local heap: @MemoryManager <- DEFAULT_HEAP.peek()
    local blocks_only: @Plain <- .hollow()
    local plain: @MemoryManager <- blocks_only.to[MemoryManager]()

    wide: Addr = heap.alloc(size: 100, align: 256)
    Out.write("aligned 256: {aligned(at: wide, align: 256)}\n")
    grown: Addr = heap.realloc(at: wide, size: 5000, align: 256)
    Out.write("still aligned: {aligned(at: grown, align: 256)}\n")
    heap.free(grown)
    Out.write("pages: {heap.has_pages()} {heap.has_protect()}\n")
    page: U64 = page_size().bytes()
    space: Addr = heap.reserve(page * 4)
    committed: Bool = heap.commit(at: space, size: page * 2)
    42.poke_into(space.to[@U64]())
    closed: Bool = heap.protect(at: space.offset(page.to[S64]()), size: page,
        access: PageAccess.READ)
    Out.write("committed {committed}, protected {closed}, read {space.to[@U64]().peek()}\n")
    heap.release(at: space, size: page * 4)
    Out.write("plain pages: {plain.has_pages()}\n")
    nothing: Addr = plain.reserve(page)
    Out.write("not reached {nothing}\n")
    return
