### Free routines of one name that differ in their parameter types: a call picks the one its arguments' types are,
### exactly.
import Standard/Format
import Standard/Os

routine describe(n: S64) -> @[Byte]
    return "an S64"

routine describe(text: @[Byte]) -> @[Byte]
    return "some text"

routine describe(flag: Bool) -> @[Byte]
    return "a Bool"

routine describe(at: @S64) -> @[Byte]
    return "a pointer to an S64"

routine describe(at: Addr) -> @[Byte]
    return "an address"

routine describe(n: S64, times: U64) -> @[Byte]
    return "an S64 and a count"

routine start() -> None
    n: S64 = 7
    local slot: @S64 <- n
    greeting: @[Byte] = "hello"
    address: Addr = slot
    Out.write("{describe(n)}\n")
    Out.write("{describe(greeting)}\n")
    Out.write("{describe(true)}\n")
    Out.write("{describe(slot)}\n")
    Out.write("{describe(address)}\n")
    Out.write("{describe(n, times: 3)}\n")
    return
