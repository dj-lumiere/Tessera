### Free routines of one name that differ in their parameter types: a call picks the one its arguments' types are,
### exactly.
import Hosted

routine describe(n: S64) -> @[Byte]
    return "an S64"

routine describe(text: @[Byte]) -> @[Byte]
    return "some text"

routine describe(flag: Bool) -> @[Byte]
    return "a Bool"

routine describe(at: @S64) -> @[Byte]
    return "a pointer to an S64"

routine describe(at: Addr) -> @[Byte]
    return "an address"

routine describe(n: S64, times: U64) -> @[Byte]
    return "an S64 and a count"

routine start() -> None
    n: S64 = 7
    slot: &S64 <- n
    greeting: @[Byte] = "hello"
    address: Addr = slot
    Console.show("{describe(n)}")
    Console.show("{describe(greeting)}")
    Console.show("{describe(true)}")
    Console.show("{describe(slot)}")
    Console.show("{describe(address)}")
    Console.show("{describe(n, times: 3)}")
    return
