# A leading '.' calls a typewise routine of the type the value goes to: a binding's type, a parameter's, a
# block parameter's, or the routine's return type.

import Collections
import Hosted

routine find(target: S64) -> Maybe[U64]
    if target == 7
        return 3
    else
        return None()

routine count(o: Maybe[U64]) -> U64
    when o
        is U64 as total => return total
        is None => return 0

routine start() -> None
    manager: @MemoryManager = HEAP
    list: &List[S64] <- .construct(manager)

    list.add_last(5)

    none: Maybe[U64] = None()
    grid: Items[S64, 3] = [1, 2, 3]
    found: Maybe[U64] = find(7)
    Console.show("{count(found)}{count(none)}{count(9)}")

    carried: Maybe[U64] = 4
    Console.show("{count(carried)}")
    drop list
    return
