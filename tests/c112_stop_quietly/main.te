# stop_quietly in the Crash service's slot: a crash stops the program and reports nothing.

import Unhosted

### Readies the managers and chooses to stop without a report.
routine when_power_on() -> None
    prepare_core()
    Crash.report_with(stop_quietly.to[Callable]())
    return

### Writes a line on the serial port, then crashes.
routine start() -> None
    port: &Pl011 <- .construct(base: 0x09000000)
    port.write("before\n")
    big: U8 = 200
    port.write("{big + 100}\n")
    return
