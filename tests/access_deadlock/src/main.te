# Two threads take two accesses in opposite orders and end up waiting on each other. With the deadlock check on (a
# debug build, or this test's manifest in every mode), the one that closes the cycle stops the program with
# DeadlockError instead of waiting forever.

import Standard/Os

record Pair
    first: ExclusiveAccess
    second: ExclusiveAccess

routine forward(pair: @Pair) -> None
    pair.first.lock()
    waitfor(50ms)
    pair.second.lock()
    pair.second.unlock()
    pair.first.unlock()
    return

routine backward(pair: @Pair) -> None
    pair.second.lock()
    waitfor(50ms)
    pair.first.lock()
    pair.first.unlock()
    pair.second.unlock()
    return

routine start() -> None
    local pair: @Pair <- Pair(first: .construct(), second: .construct())

    Console.show("starting")
    a: Thread[None] = get_thread[None]()
    b: Thread[None] = get_thread[None]()
    a.put_work(entry: forward.to[Callable](), args: pair)
    b.put_work(entry: backward.to[Callable](), args: pair)
    a.wait_finished()
    b.wait_finished()
    a.give_back()
    b.give_back()
    Console.show("not reached")
    return
