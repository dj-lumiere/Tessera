# Two threads take exclusive access to two elements of one BorrowedSlice in opposite orders and end up waiting on each
# other. With the deadlock check on (a debug build, or this test's manifest in every mode), the one that closes the
# cycle stops the program with DeadlockError instead of waiting forever.

import Standard/Os

routine forward(m: @BorrowedSlice[U64]) -> None
    first: Authorized[U64] <- m.getslot(0).get_exclusive_access()
    waitfor(50ms)
    second: Authorized[U64] <- m.getslot(1).get_exclusive_access()
    drop second
    drop first
    return

routine backward(m: @BorrowedSlice[U64]) -> None
    second: Authorized[U64] <- m.getslot(1).get_exclusive_access()
    waitfor(50ms)
    first: Authorized[U64] <- m.getslot(0).get_exclusive_access()
    drop first
    drop second
    return

routine start() -> None
    m: &[U64] <- [0] * 2 from HEAP

    Console.show("starting")
    a: Thread[None] <- get_thread[None]()
    b: Thread[None] <- get_thread[None]()
    work_a: Work[None] = forward.to[Work](m: m)
    a.put_work(work_a)
    work_b: Work[None] = backward.to[Work](m: m)
    b.put_work(work_b)
    a.retrieve()
    b.retrieve()
    drop a
    drop b
    Console.show("not reached")
    drop m
    return
