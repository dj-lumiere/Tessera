# Operators come from protocols: compare gives < <= > >= <=>, eq gives == and != (not eq), the floats keep their own
# lt / le / gt / ge so a NaN compares false, a generic routine writes + under Addable[T], and indexing is
# ViewingIndexable / ModifyingIndexable.

import Standard/Format
import Standard/Os

routine start() -> None
    old: Version = Version(major: 1, minor: 4)
    new: Version = Version(major: 1, minor: 10)
    Console.show("{old < new} {old <= new} {old > new} {old >= new} {old <=> new} {old == new} {old != new}")
    x: B64 = 1.5
    n: B64 = B64.NAN
    Console.show("{x < n} {x <= n} {x > n} {x >= n} {n == n} {n != n} {x != x}")
    a: S64 = 2
    b: S64 = 3
    p: B64 = 0.5
    Console.show("{total(first: a, second: b)} {total(first: x, second: p)}")
    local row: @Row <- Row(cells: [1, 2, 3])
    row[1] = 20
    now: Row = row.peek()
    Console.show("{now[0] + now[1] + now[2]}")
    return

### Adds two values of any type that has `+`.
### :param first: The first value.
### :param second: The second value.
### :returns: The sum.
routine total[T](first: T, second: T) -> T
needs T: typename, Addable[T]
    return first + second

### A release number.
record Version
obeys Equatable[Version], Comparable[Version]
    major: S64
    minor: S64

### Whether both parts are equal.
### :param other: The version to compare with.
### :returns: True when they are the same version.
routine Version.eq(other: Me) -> Bool
    return me.major == other.major and me.minor == other.minor

### Orders by major, then minor.
### :param other: The version to compare with.
### :returns: -1, 0 or 1.
routine Version.compare(other: Me) -> S32
    if me.major != other.major
        return me.major.compare(other.major)
    return me.minor.compare(other.minor)

### Three numbers read and written by position.
record Row
obeys ViewingIndexable[Row, S64], ModifyingIndexable[Row, S64]
    cells: Array[S64, 3]

### The number at `index`.
### :param index: The position.
### :returns: The number.
routine Row.getitem(index: U64) -> S64
    return me.cells.getitem(index)

### Stores `value` at `index`.
### :param index: The position.
### :param value: The number to store.
routine @Row.setitem(index: U64, value: S64) -> None
    me.cells.setitem(index, value)
    return
