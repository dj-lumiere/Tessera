// FiberPool: a sum over a million numbers splits itself in halves on more jobs until a part is small, on four
// threads. A job that waits for its half parks, its thread goes on with other jobs, and the thread that finishes the
// half wakes it.

import Standard/Fiber
import Standard/Format
import Standard/Os

/// The sum of lo ..< hi, split in halves on more jobs until a part is small.
routine sum_range(pool: @FiberPool, lo: U64, hi: U64) -> U64
    if hi - lo <= 1000
        each i in lo til hi with total: U64 = 0
            continue with total: total + i
        then
            return total
    else
        mid: U64 = lo + (hi - lo) / 2
        left: Job[U64] = pool.get_job[U64]()
        left.put_work(entry: sum_range.to[Callable](), args: (pool, lo, mid))
        right: U64 = sum_range(pool, lo: mid, hi)
        left.wait_finished()
        l: U64 = left.retrieve()
        left.give_back()
        return l + right

routine start() -> Void
    out: @Out = Out.writer()
    local pool: @FiberPool <- .construct(threads: 4)
    j: Job[U64] = pool.get_job[U64]()
    j.put_work(entry: sum_range.to[Callable](), args: (pool, 0, 1000000))
    j.wait_finished()
    out.write("{j.retrieve()}\n")
    j.give_back()
    pool.destruct()
    return
