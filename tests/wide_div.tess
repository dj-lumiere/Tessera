routine show(%out: Ptr<FdWriter>, %r: Div3By2) -> Void
    block entry():
        %r.quotient.represent_hex(%out)
        write(%out, " ")
        %r.remainder.represent_hex(%out)
        return()

routine main() -> S32
    block entry():
        %out_val : FdWriter = .stdout()
        claim %out : Ptr<FdWriter>
        %out.store(%out_val)
        jump loop(0, %out)

    block loop(%i: USize, %out: Ptr<FdWriter>):
        %done : Bool = %i.ge(310)
        branch %done ? return(0) : one(%i, %out)

    block one(%i: USize, %out: Ptr<FdWriter>):
        %u2 : U64 = U2.get(%i)
        %u1 : U64 = U1.get(%i)
        %u0 : U64 = U0.get(%i)
        %d1 : U64 = D1.get(%i)
        %d0 : U64 = D0.get(%i)
        show(%out, div_3by2_divq(%u2, %u1, %u0, %d1, %d0))
        write(%out, " ")
        %v : U64 = reciprocal_3by2(%d1, %d0)
        show(%out, div_3by2_mg(%u2, %u1, %u0, %d1, %d0, %v))
        write(%out, "\n")
        jump loop(%i.add(1), %out)
