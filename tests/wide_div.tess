routine show(#out: Ptr<FdWriter>, %r: Div3By2) -> Void
    block entry():
        %r.quotient.format_hex(#out)
        write_str(#out, " ")
        %r.remainder.format_hex(#out)
        return()

routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        jump loop(0, #out)

    block loop(%i: I64, #out: Ptr<FdWriter>):
        %done: Bool = %i.sge(310)
        branch %done ? return(0) : one(%i, #out)

    block one(%i: I64, #out: Ptr<FdWriter>):
        %u2: I64 := U2[%i]
        %u1: I64 := U1[%i]
        %u0: I64 := U0[%i]
        %d1: I64 := D1[%i]
        %d0: I64 := D0[%i]
        show(#out, div_3by2_divq(%u2, %u1, %u0, %d1, %d0))
        write_str(#out, " ")
        %v: I64 = reciprocal_3by2(%d1, %d0)
        show(#out, div_3by2_mg(%u2, %u1, %u0, %d1, %d0, %v))
        write_line(#out)
        jump loop(%i.add(1), #out)
