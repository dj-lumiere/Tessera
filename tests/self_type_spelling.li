# The type a routine is on is written Me.

record Point
    x: S64

### Makes a `Point` from its fields.
### :param x: Its `x`.
### :returns: The new value.
common routine Point.construct(x: S64) -> Me
    return(Me(x))

### Releases nothing: a `Point` holds no memory of its own.
routine @Point.destruct() -> None
    return()

common routine Point.origin() -> Self
    return(Me(x: 0))

routine start() -> None
    return()
