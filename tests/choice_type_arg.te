# A value type parameter whose type is a choice takes a member, bare (RELAXED) or with the choice (Order.RELAXED). In the
# body it is a value of the choice, and a when or an if on it goes straight to the side its member takes.
import Hosted

### The order a program uses when it names none.
preset USUAL: Order = Order.SEQ_CST

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE
    ### Earlier writes stay before.
    RELEASE
    ### One order for every thread.
    SEQ_CST

### A cell with an order.
### :typeparam O: The order.
record Cell[O]
needs Order O
    v: U64

### The rank of O: a when over every member.
### :typeparam O: The order.
### :returns: 0 to 3.
routine rank[O]() -> U64
needs Order O
    when O
        Order.RELAXED => return 0
        Order.ACQUIRE => return 1
        Order.RELEASE => return 2
        Order.SEQ_CST => return 3

### Whether O acquires: an if on it.
### :typeparam O: The order.
### :returns: True for ACQUIRE and SEQ_CST.
routine acquires[O]() -> Bool
needs Order O
    if O == Order.ACQUIRE or O == Order.SEQ_CST
        return true
    return false

### What O is for: a condition when on it.
### :typeparam O: The order.
### :returns: 10 for a counter, 20 for a pair, 30 for a fence.
routine purpose[O]() -> U64
needs Order O
    when
        O == Order.RELAXED => return 10
        O != Order.SEQ_CST => return 20
        else => return 30

### Passes O on, written as a type argument.
### :typeparam O: The order.
### :param x: Added to the rank.
### :returns: The rank plus x.
routine passing[O](x: U64) -> U64
needs Order O
    return rank[O]() + x

### O as a value, handed to a routine that takes an Order.
### :param o: The order.
### :returns: Its rank.
routine rank_of(o: Order) -> U64
    return when o
        Order.RELAXED => 0
        Order.ACQUIRE => 1
        Order.RELEASE => 2
        else => 3

### O handed on as a value.
### :typeparam O: The order.
### :returns: Its rank.
routine as_value[O]() -> U64
needs Order O
    o: Order = O
    return rank_of(o)

### The order of a cell, inferred from its type.
### :typeparam O: The order.
### :param c: The cell.
### :returns: The rank of its order.
routine order_of[O](c: Cell[O]) -> U64
needs Order O
    return rank[O]()

### Cell[RELAXED] and Cell[ACQUIRE] are two types, so these two are two routines.
### :param c: The cell.
### :returns: 1.
routine which(c: Cell[RELAXED]) -> U64
    return 1

### The other one.
### :param c: The cell.
### :returns: 2.
routine which(c: Cell[ACQUIRE]) -> U64
    return 2

### Prints them.
routine start() -> None
    Console.show("{rank[RELAXED]()} {rank[ACQUIRE]()} {rank[RELEASE]()} {rank[SEQ_CST]()}")
    Console.show("{rank[Order.RELAXED]()} {rank[USUAL]()}")
    Console.show("{acquires[RELAXED]()} {acquires[ACQUIRE]()} {acquires[RELEASE]()} {acquires[SEQ_CST]()}")
    Console.show("{purpose[RELAXED]()} {purpose[ACQUIRE]()} {purpose[SEQ_CST]()}")
    Console.show("{passing[RELEASE](5)} {as_value[ACQUIRE]()}")
    relaxed: Cell[RELAXED]
    acquiring: Cell[Order.ACQUIRE]
    Console.show("{order_of(relaxed)} {order_of(acquiring)} {which(relaxed)} {which(acquiring)}")
    Console.show("{type_name[Cell[RELEASE]]()}")
    return
