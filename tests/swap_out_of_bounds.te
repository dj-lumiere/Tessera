# swap checks both indices against the count before it moves anything: an index past the end crashes with
# IndexOutOfBoundsError at the caller's line (swap is @track_caller), and the list is left as it was.

import Standard/Collections
import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\nat line {place.line.peek()}\n")
    exit(3)

routine start() -> None
    local xs: @List[S64] <- .construct()

    xs.add_last(10)
    xs.add_last(20)
    xs.swap(first: 0, second: 1)
    Out.write("swapped {xs[0]} {xs[1]}\n")
    xs.swap(first: 0, second: 2)
    Out.write("not reached\n")
    drop xs
    return
