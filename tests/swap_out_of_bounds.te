# swap checks both indices against the count before it moves anything: an index past the end crashes with
# IndexOutOfBoundsError at the caller's line (swap is @track_caller), and the list is left as it was.

import Standard/Collections
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    xs: &List[S64] <- .construct()

    Crash.report_with(on_crash.to[Callable]())
    xs.add_last(10)
    xs.add_last(20)
    xs.swap(first: 0, second: 1)
    Console.show("swapped {xs[0]} {xs[1]}")
    xs.swap(first: 0, second: 2)
    Console.show("not reached")
    drop xs
    return
