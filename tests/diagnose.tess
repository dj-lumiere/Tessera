// diagnose writes values as Tessera source; represent writes them as output text. #derive asks the builder
// to write either one for a record or choice.

import Standard::Format
import Standard::Os

#derive(Represent, Diagnose)
record Point
    x : S64
    y : S64

#derive(Represent, Diagnose)
record Box<T>
require T: typename
    value : T
    items : Array<U8, 3>

#derive(Represent, Diagnose)
choice Color: U8
    Red
    Green

#derive(Diagnose)
record Tagged
    color : Color
    where : Option<Point>

/// Declares its own, so the builder writes none.
record Secret
conform Diagnose<Secret>
    code : U32

routine Secret.diagnose<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(out, "Secret { ... }")
        return()

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()
        text : Bytes = "tab\there \"quoted\" back\\slash\n\x01 é"
        text.represent(out)
        write_line(out)
        text.diagnose(out)
        write_line(out)
        b'A'.diagnose(out)
        write_str(out, " ")
        b'\''.diagnose(out)
        write_str(out, " ")
        b'\n'.diagnose(out)
        write_str(out, " ")
        del : Byte = 0x7F
        del.diagnose(out)
        write_str(out, " ")
        high : Byte = 0xE9
        high.diagnose(out)
        write_line(out)
        'A'.diagnose(out)
        write_str(out, " ")
        '\\'.diagnose(out)
        write_str(out, " ")
        '\0'.diagnose(out)
        write_str(out, " ")
        'é'.diagnose(out)
        write_line(out)
        n : S64 = -42
        n.diagnose(out)
        write_str(out, " ")
        u : U8 = 255
        u.diagnose(out)
        write_str(out, " ")
        f : F64 = 1.0
        f.diagnose(out)
        write_str(out, " ")
        true.diagnose(out)
        write_line(out)
        some : Option<Bytes> = .Present("hi")
        some.diagnose(out)
        write_str(out, " ")
        none : Option<S32> = .Absent
        none.diagnose(out)
        write_line(out)
        ok : Result<S32, Bytes> = .Success(7)
        ok.diagnose(out)
        write_str(out, " ")
        err : Result<S32, Bytes> = .Failure("no")
        err.diagnose(out)
        write_line(out)
        write(out, "{some} {none} {ok} {err}\n")
        p : Point = Point { x: 1, y: -2 }
        p.diagnose(out)
        write_line(out)
        items : Array<U8, 3> = Array<U8, 3> { 1, 2, 3 }
        box   : Box<Bytes>   = Box<Bytes> { value: "in", items: items }
        box.diagnose(out)
        write_line(out)
        write(out, "{box} {p} {Color.Red}\n")
        tagged : Tagged = Tagged { color: Color.Green, where: .Present(p) }
        tagged.diagnose(out)
        write_line(out)
        secret : Secret = Secret { code: 1234 }
        secret.diagnose(out)
        write_line(out)
        return(0)
