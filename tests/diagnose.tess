// diagnose writes values as Tessera source, and represent writes them as output text. #derive asks the builder
// to write either one for a record or choice.

import Standard::Format
import Standard::Os

#derive(Representable, Diagnosable)
record Point
    x : S64
    y : S64

#derive(Representable, Diagnosable)
record Box<T>
require T: typename
    value : T
    items : Array<U8, 3>

#derive(Representable, Diagnosable)
choice Color: U8
    Red
    Green

#derive(Diagnosable)
record Tagged
    color : Color
    where : Option<Point>

/// Declares its own, so the builder writes none.
record Secret
conform Diagnosable<Secret>
    code : U32

routine Secret.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        write_str(out, "Secret { ... }")
        return()

routine main() -> S32
    block entry()
        out  : @Out  = Out.shared()
        text : Bytes = "tab\there \"quoted\" back\\slash\n\x01 é"
        text.represent_into(out)
        write_line(out)
        text.diagnose_into(out)
        write_line(out)
        b'A'.diagnose_into(out)
        write_str(out, " ")
        b'\''.diagnose_into(out)
        write_str(out, " ")
        b'\n'.diagnose_into(out)
        write_str(out, " ")
        del : Byte = 0x7F
        del.diagnose_into(out)
        write_str(out, " ")
        high : Byte = 0xE9
        high.diagnose_into(out)
        write_line(out)
        'A'.diagnose_into(out)
        write_str(out, " ")
        '\\'.diagnose_into(out)
        write_str(out, " ")
        '\0'.diagnose_into(out)
        write_str(out, " ")
        'é'.diagnose_into(out)
        write_line(out)
        n : S64 = -42
        n.diagnose_into(out)
        write_str(out, " ")
        u : U8 = 255
        u.diagnose_into(out)
        write_str(out, " ")
        f : F64 = 1.0
        f.diagnose_into(out)
        write_str(out, " ")
        true.diagnose_into(out)
        write_line(out)
        some : Option<Bytes> = .Present("hi")
        some.diagnose_into(out)
        write_str(out, " ")
        none : Option<S32> = .Absent
        none.diagnose_into(out)
        write_line(out)
        ok : Result<S32, Bytes> = .Success(7)
        ok.diagnose_into(out)
        write_str(out, " ")
        err : Result<S32, Bytes> = .Failure("no")
        err.diagnose_into(out)
        write_line(out)
        out.write("{some} {none} {ok} {err}\n")
        p : Point = Point { x: 1, y: -2 }
        p.diagnose_into(out)
        write_line(out)
        items : Array<U8, 3> = Array<U8, 3> { 1, 2, 3 }
        box   : Box<Bytes>   = Box<Bytes> { value: "in", items: items }
        box.diagnose_into(out)
        write_line(out)
        out.write("{box} {p} {Color.Red}\n")
        tagged : Tagged = Tagged { color: Color.Green, where: .Present(p) }
        tagged.diagnose_into(out)
        write_line(out)
        secret : Secret = Secret { code: 1234 }
        secret.diagnose_into(out)
        write_line(out)
        return(0)
