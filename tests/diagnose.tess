// diagnose writes values as Tessera source, and represent writes them as output text. #derive asks the builder
// to write either one for a record or choice.

import Standard/Format
import Standard/Os

@derive(Representable, Diagnosable)
record Point
    x: S64
    y: S64

@derive(Representable, Diagnosable)
record Box[T]
needs T: typename
    value: T
    items: Array[U8, 3]

@derive(Representable, Diagnosable)
choice Color: U8
    RED
    GREEN

@derive(Diagnosable)
record Tagged
    color: Color
    where: Maybe[Point]

/// Declares its own, so the builder writes none.
record Secret
obeys Diagnosable[Secret]
    code: U32

/// Makes a `Box` from its fields.
/// :param value: Its `value`.
/// :param items: Its `items`.
/// :returns: The new value.
routine Box[T].construct(value: T, items: Array[U8, 3]) -> Me
needs T: typename
    return Me(value, items)

/// Releases nothing: a `Box` holds no memory of its own.
routine Box[T].destruct(me: @Me) -> Void
needs T: typename
    return

routine Secret.diagnose_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    write_str(out, text: "Secret(...)")
    return

routine start() -> Void
    out: @Out = Out.writer()
    text: Span[Byte] = "tab\there \"quoted\" back\\slash\n é"
    text.represent_into(out)
    write_line(out)
    text.diagnose_into(out)
    write_line(out)
    b'A'.diagnose_into(out)
    write_str(out, text: " ")
    b'\''.diagnose_into(out)
    write_str(out, text: " ")
    b'\n'.diagnose_into(out)
    write_str(out, text: " ")
    del: Byte = 0x7F
    del.diagnose_into(out)
    write_str(out, text: " ")
    high: Byte = 0xE9
    high.diagnose_into(out)
    write_line(out)
    'A'.diagnose_into(out)
    write_str(out, text: " ")
    '\\'.diagnose_into(out)
    write_str(out, text: " ")
    '\0'.diagnose_into(out)
    write_str(out, text: " ")
    '\u0000E9'.diagnose_into(out)
    write_line(out)
    n: S64 = -42
    n.diagnose_into(out)
    write_str(out, text: " ")
    u: U8 = 255
    u.diagnose_into(out)
    write_str(out, text: " ")
    f: B64 = 1.0
    f.diagnose_into(out)
    write_str(out, text: " ")
    true.diagnose_into(out)
    write_line(out)
    some: Maybe[Span[Byte]] = "hi"
    some.diagnose_into(out)
    write_str(out, text: " ")
    none: Maybe[S32] = Unit()
    none.diagnose_into(out)
    write_line(out)
    ok: Result[S32, Span[Byte]] = 7
    ok.diagnose_into(out)
    write_str(out, text: " ")
    err: Result[S32, Span[Byte]] = "no"
    err.diagnose_into(out)
    write_line(out)
    out.write("{some} {none} {ok} {err}\n")
    p: Point = Point(x: 1, y: -2)
    p.diagnose_into(out)
    write_line(out)
    items: Array[U8, 3] = [1, 2, 3]
    box: Box[Span[Byte]] = Box[Span[Byte]](value: "in", items: items)
    box.diagnose_into(out)
    write_line(out)
    out.write("{box} {p} {Color.RED}\n")
    tagged: Tagged = Tagged(color: Color.GREEN, where: p)
    tagged.diagnose_into(out)
    write_line(out)
    secret: Secret = Secret(code: 1234)
    secret.diagnose_into(out)
    write_line(out)
    return
