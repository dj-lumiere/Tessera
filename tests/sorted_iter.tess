// The sorted-collection iterators walk the tree with a stack. On trees several levels deep, after inserts and removes
// that split, borrow, and merge nodes, each must yield exactly get_by_rank(0), get_by_rank(1), ... and then stop, and
// eq (which walks two iterators side by side) must see a copy as equal and a changed copy as different.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

preset COUNT: S64 = 3000

// ── SortedDict ───────────────────────────────────────────────────────────────

routine fill_dict(map: @SortedDict<S64, S64>) -> Void
    block entry()
        jump put(0)

    block put(i: S64)
        done : Bool = i.ge(COUNT)
        branch done
            ? remove(0)
            : continue
        map.put(i.mul(7919).mod(10007), i)
        jump put(i.add(1))

    block remove(i: S64)
        done : Bool = i.ge(COUNT)
        branch done
            ? return()
            : continue
        spread : S64 = i.mul(3).mul(7919)
        map.remove(spread.mod(10007))
        jump remove(i.add(1))

/// Walks the iterator and counts the entries that differ from get_by_rank, or -1 if it yields too many or too few.
routine check_dict(map: @SortedDict<S64, S64>) -> S64
    shared iter_val : SortedDictIter<S64, S64>  = .construct(map)
    shared iter     : @SortedDictIter<S64, S64> <- iter_val
    shared bad      : @S64                      <- 0

    block entry()
        jump next(0)

    block next(rank: USize)
        item : Option<KVPair<S64, S64>> = iter.next()
        when item
            .Present(got) -> compare(rank, got)
            .Absent       -> verdict(rank)

    block compare(rank: USize, got: KVPair<S64, S64>)
        past_end : Bool = rank.ge(map.count())
        branch past_end
            ? return(-1)
            : continue
        want       : KVPair<S64, S64> = map.get_by_rank(rank)
        key_same   : Bool             = want.key.eq(got.key)
        value_same : Bool             = want.value.eq(got.value)
        same       : Bool             = key_same.bitand(value_same)
        wrong      : S64              = same
            ? 0
            : 1
        bad.load().add(wrong).store_into(bad)
        jump next(rank.add(1))

    block verdict(rank: USize)
        all : Bool = rank.eq(map.count())
        branch all
            ? return(bad.load())
            : return(-1)

// ── SortedSet ────────────────────────────────────────────────────────────────

routine fill_set(set: @SortedSet<S64>) -> Void
    block entry()
        jump add(0)

    block add(i: S64)
        done : Bool = i.ge(COUNT)
        branch done
            ? remove(0)
            : continue
        set.add(i.mul(7919).mod(10007))
        jump add(i.add(1))

    block remove(i: S64)
        done : Bool = i.ge(COUNT)
        branch done
            ? return()
            : continue
        spread : S64 = i.mul(3).mul(7919)
        set.remove(spread.mod(10007))
        jump remove(i.add(1))

routine check_set(set: @SortedSet<S64>) -> S64
    shared iter_val : SortedSetIter<S64>  = .construct(set)
    shared iter     : @SortedSetIter<S64> <- iter_val
    shared bad      : @S64                <- 0

    block entry()
        jump next(0)

    block next(rank: USize)
        item : Option<S64> = iter.next()
        when item
            .Present(got) -> compare(rank, got)
            .Absent       -> verdict(rank)

    block compare(rank: USize, got: S64)
        past_end : Bool = rank.ge(set.count())
        branch past_end
            ? return(-1)
            : continue
        expected : S64  = set.get_by_rank(rank)
        same     : Bool = expected.eq(got)
        wrong    : S64  = same
            ? 0
            : 1
        bad.load().add(wrong).store_into(bad)
        jump next(rank.add(1))

    block verdict(rank: USize)
        all : Bool = rank.eq(set.count())
        branch all
            ? return(bad.load())
            : return(-1)

// ── SortedList ───────────────────────────────────────────────────────────────

/// Pushes scattered values, then removes every third position counted from the front.
routine fill_list(list: @SortedList<S64>) -> Void
    block entry()
        jump push(0)

    block push(i: S64)
        done : Bool = i.ge(COUNT)
        branch done
            ? remove(0)
            : continue
        list.push(i.mul(37).mod(101))
        jump push(i.add(1))

    block remove(at: USize)
        done : Bool = at.ge(list.count())
        branch done
            ? return()
            : continue
        list.remove(at)
        jump remove(at.add(2))

routine check_list(list: @SortedList<S64>) -> S64
    shared iter_val : SortedListIter<S64>  = .construct(list)
    shared iter     : @SortedListIter<S64> <- iter_val
    shared bad      : @S64                 <- 0

    block entry()
        jump next(0)

    block next(rank: USize)
        item : Option<S64> = iter.next()
        when item
            .Present(got) -> compare(rank, got)
            .Absent       -> verdict(rank)

    block compare(rank: USize, got: S64)
        past_end : Bool = rank.ge(list.count())
        branch past_end
            ? return(-1)
            : continue
        expected : S64  = list.getitem(rank)
        same     : Bool = expected.eq(got)
        wrong    : S64  = same
            ? 0
            : 1
        bad.load().add(wrong).store_into(bad)
        jump next(rank.add(1))

    block verdict(rank: USize)
        all : Bool = rank.eq(list.count())
        branch all
            ? return(bad.load())
            : return(-1)

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        map_val : SortedDict<S64, S64> = .construct(alloc)
        claim map  : @SortedDict<S64, S64> <- map_val
        claim twin : @SortedDict<S64, S64> <- map_val
        fill_dict(map)
        fill_dict(twin)
        Out.write("dict: {map.count()} entries, {check_dict(map)} wrong, copy equal {map.load().eq(twin.load())}\n")
        twin_count : USize            = twin.count()
        last       : KVPair<S64, S64> = twin.get_by_rank(twin_count.sub(1))
        twin.put(last.key, last.value.add(1))
        Out.write("dict: changed copy equal {map.load().eq(twin.load())}\n")

        set_val : SortedSet<S64> = .construct(alloc)
        claim set      : @SortedSet<S64> <- set_val
        claim set_copy : @SortedSet<S64> <- set_val
        fill_set(set)
        fill_set(set_copy)
        Out.write("set: {set.count()} keys, {check_set(set)} wrong, copy equal {set.load().eq(set_copy.load())}\n")
        set_copy.remove(set_copy.get_by_rank(0))
        set_copy.add(-1)
        Out.write("set: changed copy equal {set.load().eq(set_copy.load())}\n")

        list_val : SortedList<S64> = .construct(alloc)
        claim list      : @SortedList<S64> <- list_val
        claim list_copy : @SortedList<S64> <- list_val
        fill_list(list)
        fill_list(list_copy)
        Out.write("list: {list.count()} values, {check_list(list)} wrong, copy equal {list.load().eq(list_copy.load())}\n")
        list_copy.remove(0)
        list_copy.push(-1)
        Out.write("list: changed copy equal {list.load().eq(list_copy.load())}\n")

        claim empty : @SortedDict<S64, S64> <- .construct(alloc)
        Out.write("empty: {check_dict(empty)} wrong\n")

        map.destruct()
        twin.destruct()
        set.destruct()
        set_copy.destruct()
        list.destruct()
        list_copy.destruct()
        return(0)
