// The sorted-collection iterators walk the tree with a stack. On trees several levels deep, after inserts and removes
// that split, borrow, and merge nodes, each must yield exactly get_by_rank(0), get_by_rank(1), ... and then stop, and
// eq (which walks two iterators side by side) must see a copy as equal and a changed copy as different.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

preset COUNT: S64 = 3000

// ── SortedDict ───────────────────────────────────────────────────────────────

@reshaping(map)
routine fill_dict(map: @SortedDict[S64, S64]) -> None
    each i in 0 til COUNT
        map[i * 7919 % 10007] = i

    each i in 0 til COUNT
        spread: S64 = i * 3 * 7919
        map.remove(spread % 10007)
    then
        return

/// Walks the iterator and counts the entries that differ from get_by_rank, or -1 if it yields too many or too few.
routine check_dict(map: @SortedDict[S64, S64]) -> S64
    local iter_val: SortedDictIter[S64, S64] = .construct(map)
    local iter: @SortedDictIter[S64, S64] <- iter_val
    local bad: @S64 <- 0

    while true with rank: USize = 0
        item2: Maybe[KVPair[S64, S64]] = iter.emit_checked()
        when item2
            is KVPair[S64, S64] as got =>
                if rank >= map.count()
                    return -1
                want: KVPair[S64, S64] = map.get_by_rank(rank)
                key_same: Bool = want.key == got.key
                value_same: Bool = want.value == got.value
                same: Bool = key_same and value_same
                wrong: S64 = when
                    same => 0
                    else => 1
                (bad.peek() + wrong).poke_into(bad)
                continue with rank: rank + 1
            is None =>
                if rank == map.count()
                    return bad.peek()
                else
                    return -1

// ── SortedSet ────────────────────────────────────────────────────────────────

@reshaping(set)
routine fill_set(set: @SortedSet[S64]) -> None
    each i in 0 til COUNT
        set.add(i * 7919 % 10007)

    each i in 0 til COUNT
        spread: S64 = i * 3 * 7919
        set.remove(spread % 10007)
    then
        return

routine check_set(set: @SortedSet[S64]) -> S64
    local iter_val: SortedSetIter[S64] = .construct(set)
    local iter: @SortedSetIter[S64] <- iter_val
    local bad: @S64 <- 0

    while true with rank: USize = 0
        item2: Maybe[S64] = iter.emit_checked()
        when item2
            is S64 as got =>
                if rank >= set.count()
                    return -1
                expected: S64 = set.get_by_rank(rank)
                same: Bool = expected == got
                wrong: S64 = when
                    same => 0
                    else => 1
                (bad.peek() + wrong).poke_into(bad)
                continue with rank: rank + 1
            is None =>
                if rank == set.count()
                    return bad.peek()
                else
                    return -1

// ── SortedList ───────────────────────────────────────────────────────────────

/// Pushes scattered values, then removes every third position counted from the front.
@reshaping(list)
routine fill_list(list: @SortedList[S64]) -> None
    each i in 0 til COUNT
        list.add(i * 37 % 101)

    while at < list.count() with at: USize = 0
        list.remove(at)
        continue with at: at + 2
    then
        return

routine check_list(list: @SortedList[S64]) -> S64
    local iter_val: SortedListIter[S64] = .construct(list)
    local iter: @SortedListIter[S64] <- iter_val
    local bad: @S64 <- 0

    while true with rank: USize = 0
        item2: Maybe[S64] = iter.emit_checked()
        when item2
            is S64 as got =>
                if rank >= list.count()
                    return -1
                expected: S64 = list[rank]
                same: Bool = expected == got
                wrong: S64 = when
                    same => 0
                    else => 1
                (bad.peek() + wrong).poke_into(bad)
                continue with rank: rank + 1
            is None =>
                if rank == list.count()
                    return bad.peek()
                else
                    return -1

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()

    map_val: SortedDict[S64, S64] = .construct(alloc)
    local map: @SortedDict[S64, S64] <- map_val
    local twin: @SortedDict[S64, S64] <- map_val
    fill_dict(map)
    fill_dict(twin)
    Out.write("dict: {map.count()} entries, {check_dict(map)} wrong, copy equal {map.peek().eq(twin.peek())}\n")
    twin_count: USize = twin.count()
    last: KVPair[S64, S64] = twin.get_by_rank(twin_count - 1)
    twin[last.key] = last.value + 1
    Out.write("dict: changed copy equal {map.peek().eq(twin.peek())}\n")

    set_val: SortedSet[S64] = .construct(alloc)
    local set: @SortedSet[S64] <- set_val
    local set_copy: @SortedSet[S64] <- set_val
    fill_set(set)
    fill_set(set_copy)
    Out.write("set: {set.count()} keys, {check_set(set)} wrong, copy equal {set.peek().eq(set_copy.peek())}\n")
    set_copy.remove(set_copy.get_by_rank(0))
    set_copy.add(-1)
    Out.write("set: changed copy equal {set.peek().eq(set_copy.peek())}\n")

    list_val: SortedList[S64] = .construct(alloc)
    local list: @SortedList[S64] <- list_val
    local list_copy: @SortedList[S64] <- list_val
    fill_list(list)
    fill_list(list_copy)
    Out.write("list: {list.count()} values, {check_list(list)} wrong, copy equal {list.peek().eq(list_copy.peek())}\n")
    list_copy.remove(0)
    list_copy.add(-1)
    Out.write("list: changed copy equal {list.peek().eq(list_copy.peek())}\n")

    local empty: @SortedDict[S64, S64] <- .construct(alloc)
    Out.write("empty: {check_dict(empty)} wrong\n")

    drop map
    drop twin
    drop set
    drop set_copy
    drop list
    drop list_copy
    return
