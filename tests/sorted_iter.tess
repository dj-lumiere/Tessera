// The sorted-collection iterators walk the tree with a stack. On trees several levels deep, after inserts and removes
// that split, borrow, and merge nodes, each must yield exactly get_by_rank(0), get_by_rank(1), ... and then stop, and
// eq (which walks two iterators side by side) must see a copy as equal and a changed copy as different.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

preset COUNT: S64 = 3000

// ── SortedDict ───────────────────────────────────────────────────────────────

routine fill_dict(%map: @SortedDict<S64, S64>) -> Void
    block entry():
        jump put(0)

    block put(%i: S64):
        %done : Bool = %i.ge(COUNT)
        branch %done ? remove(0) : continue
        %map.put(%i.mul(7919).mod(10007), %i)
        jump put(%i.add(1))

    block remove(%i: S64):
        %done : Bool = %i.ge(COUNT)
        branch %done ? return() : continue
        %map.remove(%i.mul(3).mul(7919).mod(10007))
        jump remove(%i.add(1))

/// Walks the iterator and counts the entries that differ from get_by_rank; -1 if it yields too many or too few.
routine check_dict(%map: @SortedDict<S64, S64>) -> S64
    block entry():
        %iter_val : SortedDictIter<S64, S64> = .construct(%map)
        claim %iter : @SortedDictIter<S64, S64> <- %iter_val
        jump next(%iter, 0, 0)

    block next(%iter: @SortedDictIter<S64, S64>, %rank: USize, %bad: S64):
        %item : Option<KVPair<S64, S64>> = %iter.next()
        when %item:
            .Present(%got) -> compare(%iter, %rank, %bad, %got)
            .Absent        -> finish(%rank, %bad)

    block compare(%iter: @SortedDictIter<S64, S64>, %rank: USize, %bad: S64,
            %got: KVPair<S64, S64>):
        %past_end : Bool = %rank.ge(%map.load().length())
        branch %past_end ? return(-1) : continue
        %want       : KVPair<S64, S64> = %map.load().get_by_rank(%rank)
        %key_same   : Bool             = %want.key.eq(%got.key)
        %value_same : Bool             = %want.value.eq(%got.value)
        %same       : Bool             = %key_same.bitand(%value_same)
        %wrong      : S64              = %same ? 0 : 1
        jump next(%iter, %rank.add(1), %bad.add(%wrong))

    block finish(%rank: USize, %bad: S64):
        %all : Bool = %rank.eq(%map.load().length())
        branch %all ? return(%bad) : return(-1)

// ── SortedSet ────────────────────────────────────────────────────────────────

routine fill_set(%set: @SortedSet<S64>) -> Void
    block entry():
        jump add(0)

    block add(%i: S64):
        %done : Bool = %i.ge(COUNT)
        branch %done ? remove(0) : continue
        %set.add(%i.mul(7919).mod(10007))
        jump add(%i.add(1))

    block remove(%i: S64):
        %done : Bool = %i.ge(COUNT)
        branch %done ? return() : continue
        %set.remove(%i.mul(3).mul(7919).mod(10007))
        jump remove(%i.add(1))

routine check_set(%set: @SortedSet<S64>) -> S64
    block entry():
        %iter_val : SortedSetIter<S64> = .construct(%set)
        claim %iter : @SortedSetIter<S64> <- %iter_val
        jump next(%iter, 0, 0)

    block next(%iter: @SortedSetIter<S64>, %rank: USize, %bad: S64):
        %item : Option<S64> = %iter.next()
        when %item:
            .Present(%got) -> compare(%iter, %rank, %bad, %got)
            .Absent        -> finish(%rank, %bad)

    block compare(%iter: @SortedSetIter<S64>, %rank: USize, %bad: S64, %got: S64):
        %past_end : Bool = %rank.ge(%set.load().length())
        branch %past_end ? return(-1) : continue
        %same  : Bool = %set.load().get_by_rank(%rank).eq(%got)
        %wrong : S64  = %same ? 0 : 1
        jump next(%iter, %rank.add(1), %bad.add(%wrong))

    block finish(%rank: USize, %bad: S64):
        %all : Bool = %rank.eq(%set.load().length())
        branch %all ? return(%bad) : return(-1)

// ── SortedList ───────────────────────────────────────────────────────────────

/// Pushes scattered values, then removes every third position counted from the front.
routine fill_list(%list: @SortedList<S64>) -> Void
    block entry():
        jump push(0)

    block push(%i: S64):
        %done : Bool = %i.ge(COUNT)
        branch %done ? remove(0) : continue
        %list.push(%i.mul(37).mod(101))
        jump push(%i.add(1))

    block remove(%at: USize):
        %done : Bool = %at.ge(%list.load().length())
        branch %done ? return() : continue
        %list.remove(%at)
        jump remove(%at.add(2))

routine check_list(%list: @SortedList<S64>) -> S64
    block entry():
        %iter_val : SortedListIter<S64> = .construct(%list)
        claim %iter : @SortedListIter<S64> <- %iter_val
        jump next(%iter, 0, 0)

    block next(%iter: @SortedListIter<S64>, %rank: USize, %bad: S64):
        %item : Option<S64> = %iter.next()
        when %item:
            .Present(%got) -> compare(%iter, %rank, %bad, %got)
            .Absent        -> finish(%rank, %bad)

    block compare(%iter: @SortedListIter<S64>, %rank: USize, %bad: S64, %got: S64):
        %past_end : Bool = %rank.ge(%list.load().length())
        branch %past_end ? return(-1) : continue
        %same  : Bool = %list.load().get(%rank).eq(%got)
        %wrong : S64  = %same ? 0 : 1
        jump next(%iter, %rank.add(1), %bad.add(%wrong))

    block finish(%rank: USize, %bad: S64):
        %all : Bool = %rank.eq(%list.load().length())
        branch %all ? return(%bad) : return(-1)

routine main() -> S32
    block entry():
        claim %alloc : @Allocator <- make_heap_allocator()

        %map_val : SortedDict<S64, S64> = .construct(%alloc)
        claim %map  : @SortedDict<S64, S64> <- %map_val
        claim %twin : @SortedDict<S64, S64> <- %map_val
        fill_dict(%map)
        fill_dict(%twin)
        print("dict: {%map.load().length()} entries, {check_dict(%map)} wrong, copy equal {%map.load().eq(%twin.load())}\n")
        %last : KVPair<S64, S64> = %twin.load().get_by_rank(%twin.load().length().sub(1))
        %twin.put(%last.key, %last.value.add(1))
        print("dict: changed copy equal {%map.load().eq(%twin.load())}\n")

        %set_val : SortedSet<S64> = .construct(%alloc)
        claim %set      : @SortedSet<S64> <- %set_val
        claim %set_copy : @SortedSet<S64> <- %set_val
        fill_set(%set)
        fill_set(%set_copy)
        print("set: {%set.load().length()} keys, {check_set(%set)} wrong, copy equal {%set.load().eq(%set_copy.load())}\n")
        %set_copy.remove(%set_copy.load().get_by_rank(0))
        %set_copy.add(-1)
        print("set: changed copy equal {%set.load().eq(%set_copy.load())}\n")

        %list_val : SortedList<S64> = .construct(%alloc)
        claim %list      : @SortedList<S64> <- %list_val
        claim %list_copy : @SortedList<S64> <- %list_val
        fill_list(%list)
        fill_list(%list_copy)
        print("list: {%list.load().length()} values, {check_list(%list)} wrong, copy equal {%list.load().eq(%list_copy.load())}\n")
        %list_copy.remove(0)
        %list_copy.push(-1)
        print("list: changed copy equal {%list.load().eq(%list_copy.load())}\n")

        claim %empty : @SortedDict<S64, S64> <- .construct(%alloc)
        print("empty: {check_dict(%empty)} wrong\n")

        %map.destruct()
        %twin.destruct()
        %set.destruct()
        %set_copy.destruct()
        %list.destruct()
        %list_copy.destruct()
        return(0)
