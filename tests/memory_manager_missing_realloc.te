# A type used as a memory manager has every routine MemoryManageable asks for: this one has no realloc.

import Standard/Alloc
import Standard/Os

entity Half
    calls: U64

obeys MemoryManageable[Half]

common routine Half.construct() -> Me
    return Me(calls: 0)

routine @Half.destruct() -> None
    return

routine @Half.alloc(size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.alloc(size, align)

routine @Half.free(at: Addr) -> None
    DEFAULT_HEAP.free(at)
    return

routine start() -> None
    local half: @Half <- .construct()
    local table: @MemoryManager <- half.to[MemoryManager]()

    taken: Addr = table.alloc(size: 8, align: 8)
    table.free(taken)
    drop half
    return
