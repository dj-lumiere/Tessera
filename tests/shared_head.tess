// The head's shared lines run once when the routine starts, before entry: a value and a slot every block sees
// without passing them along. `jump entry()` runs entry again, never the head, so the counter shows one call.

import Standard::Format
import Standard::Os

global CALLS: @S64 <- 0

routine next_call() -> S64
    block entry()
        n : S64 = CALLS.load().add(1)
        n.store_into(CALLS)
        return(n)

routine sum_to(limit: S64) -> S64
    shared first : S64  = next_call()
    shared total : @S64 <- 0
    shared step  : @S64 <- uninit

    block entry()
        first.store_into(step)
        sum : S64 = total.load().add(step.load())
        sum.store_into(total)
        branch sum.ge(limit)
            ? done()
            : entry()

    block done()
        return(total.load())

// The values the head shares reach every block, with the routine's parameters, and claims there are slots of their own.
routine scale(values: @Array<S64, 4>, factor: S64) -> S64
    shared count : USize = 4
    shared sum   : @S64  <- 0

    block entry()
        jump add(0)

    block add(i: USize)
        branch i.lt(count)
            ? one(i)
            : return(sum.load())

    block one(i: USize)
        value : S64 = values.getitem(i)
        grown : S64 = sum.load().add(value.mul(factor))
        grown.store_into(sum)
        jump add(i.add(1))

routine main() -> S32
    block entry()
        claim values : @Array<S64, 4> <- { 1, 2, 3, 4 }
        total : S64 = sum_to(5)
        Out.write("total {total}, calls {CALLS.load()}\n")
        scaled : S64 = scale(values, 3)
        Out.write("scaled {scaled}\n")
        return(0)
