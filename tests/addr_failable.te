# A failable routine's address can't go to C: C has no way to receive its failure.

crashable NopeError
    nothing

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine NopeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("nope")
    return

### Fails for a negative n.
failable routine parse_count(n: S64) -> S64
    if n < 0
        throw NopeError()
    return n

routine start() -> None
    a: Addr = parse_count.addr()
    return
