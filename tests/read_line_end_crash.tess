# In.read_line() crashes at the end of the input with AbsentValueError, at the line of the call. A blank line is ""
# and not the end. Standard input is "one\n\n". read_line_checked() is the form for reading to the end. This handler
# prints the crash and exits with status 3.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\nat line {place.line.peek()}\n")
    exit(3)

routine start() -> None
    local line: @Memory[Byte] <- In.read_line()
    Out.write("[{line.peek()}]\n")
    drop line
    local blank: @Memory[Byte] <- In.read_line()
    Out.write("[{blank.peek()}] count {blank.count()}\n")
    drop blank
    local past: @Memory[Byte] <- In.read_line()
    Out.write("not reached [{past.peek()}]\n")
    drop past
    return
