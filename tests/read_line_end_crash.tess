// In.read_line() crashes at the end of the input with AbsentValueError, at the line of the call. A blank line is ""
// and not the end. Standard input is "one\n\n". read_line_checked() is the form for reading to the end. This handler
// prints the crash and exits with status 3.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat line {place.line.load()}\n")
        exit(3)

routine start() -> Void
    block entry()
        claim line : @Bytes <- In.read_line()
        Out.write("[{line.load()}]\n")
        line.destruct()
        claim blank : @Bytes <- In.read_line()
        Out.write("[{blank.load()}] count {blank.count()}\n")
        blank.destruct()
        claim past : @Bytes <- In.read_line()
        Out.write("not reached [{past.load()}]\n")
        return()
