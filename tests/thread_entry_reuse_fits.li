# A ticket takes more work after retrieve(): its type took the list of its first work's routine, and the routine of
# later work may throw only what that list holds, which retrieve() throws the same way.

import Hosted

crashable BadInputError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### Half of an even number, failing for an odd one.
### :param n: The number.
### :returns: Half of it.
routine half(n: S64) -> S64
    if n % 2 != 0
        throw BadInputError(value: n)
    return n // 2

### n plus one, failing for a negative n: it throws only what half can.
### :param n: The number.
### :returns: n plus one.
routine next_of(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    return n +% 1

### Shows what a retrieve gave.
### :param got: The value or the failure.
routine show_result(got: Check[S64]) -> None
    when got
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        is Crashables as e => Console.show("failed with {e.name()}")
    return

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(half.to[Work](n: 10))
    show_result(check t.retrieve())
    t.put_callable(entry: next_of.to[Callable](), args: -1)
    show_result(check t.retrieve())
    t.put_work(next_of.to[Work](n: 41))
    show_result(check t.retrieve())
    drop t
    return
