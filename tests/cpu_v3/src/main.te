# Built for x86-64-v3 (see config.toml): #feature finds AVX2, and mul_add is the FMA instruction, with the same
# single rounding as the software path.

import Standard/Format
import Standard/Os

@feature("sse2")
routine sse2() -> Span[Byte]
    return "sse2"

@feature(not "sse2")
routine sse2() -> Span[Byte]
    return "no sse2"

@feature("avx2")
routine avx2() -> Span[Byte]
    return "avx2"

@feature(not "avx2")
routine avx2() -> Span[Byte]
    return "no avx2"

routine start() -> None
    r: B64 = B64.from_bits(0x3FF0000000000001).mul_add(a: B64.from_bits(0x3FEFFFFFFFFFFFFF),
        b: -1.0)
    Out.write("{sse2()} {avx2()} {r.bits()}\n")
    return
