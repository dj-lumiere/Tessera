# U64 and S64: the target's pointer width, types of their own with the integer methods.

import Hosted

routine start() -> None
    n: U64 = 10
    big: U64 = n * n + 5
    back: S64 = -3
    moved: S64 = back - 4
    Console.show("{big} {big.div_trunc(7)} {big.mod_trunc(7)} {n.pow(3)} {n.shift_left(2)}")
    Console.show("{moved} {moved.abs()} {moved.abs_diff(back)}")
    Console.show("{n.lt(big)} {n.compare(big)} {n.max(big)} {big.is_power_of_two()}")
    Console.show("{big.to[U64]()} {moved.to[S64]()} {big.to[U8]()} {(try moved.to[U64]()).is_present()}")
    Console.show("{U32.MAX.to[U64]()} {S16.MIN.to[S64]()} {n.to[S64]().neg()} {back.to_clamp[U64]()}")
    Console.show("{(try n.sub(big)).is_present()} {n.sub_clamp(big)} {(try n.to[U32]()).unwrap()}")
    Console.show("{n.hash().eq(n.to[S64]().hash())}")
    return
