# A plain global changed by work on four threads, with no atomic access and no exclusive access, reached through an
# Addr the build doesn't follow: the race check stops the program at the first race, with the crash exit status.

import Standard/Os

global COUNT: &S64 <- 0

### The work.
routine work(n: S64) -> S64
    each i: U64 in 0 til 100000
        count: @S64 = COUNT.to[Addr]().to[@S64]()
        count.peek().add(1).poke_into(count)
    return n

routine start() -> None
    t1: Thread[S64] = get_thread[S64]()
    t2: Thread[S64] = get_thread[S64]()
    t3: Thread[S64] = get_thread[S64]()
    t4: Thread[S64] = get_thread[S64]()

    t1.put_work(entry: work.to[Callable](), args: 1)
    t2.put_work(entry: work.to[Callable](), args: 1)
    t3.put_work(entry: work.to[Callable](), args: 1)
    t4.put_work(entry: work.to[Callable](), args: 1)
    t1.wait_finished()
    t2.wait_finished()
    t3.wait_finished()
    t4.wait_finished()
    t1.give_back()
    t2.give_back()
    t3.give_back()
    t4.give_back()
    Console.show("count {COUNT.peek()} (expected 400000)")
    return
