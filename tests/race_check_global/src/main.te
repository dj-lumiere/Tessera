# A plain global changed by work on four threads, with no unbroken access and no exclusive access, reached through an
# Addr the build doesn't follow: the race check stops the program at the first race, with the crash exit status.

import Hosted

global COUNT: &S64 <- 0
### How many workers are ready: each waits until all four are, so their adds overlap. Without it an optimized build
### makes the loop one add, and a worker may end before the next starts, ordered after it through the thread pool.
global READY: &Unbroken[U64]

### The work.
routine work(n: S64) -> S64
    READY.fetch_add(1)
    until READY.peek() >= 4
        waitfor(1ms)
    for i: U64 in 0 til 100000
        count: @S64 = COUNT.to[Addr]().to[@S64]()
        count.peek().add(1).poke_into(count)
    return n

routine start() -> None
    t1: Thread[S64] <- get_thread[S64]()
    t2: Thread[S64] <- get_thread[S64]()
    t3: Thread[S64] <- get_thread[S64]()
    t4: Thread[S64] <- get_thread[S64]()

    work_t1: Work[S64] = work.to[Work](n: 1)
    t1.put_work(work_t1)
    work_t2: Work[S64] = work.to[Work](n: 1)
    t2.put_work(work_t2)
    work_t3: Work[S64] = work.to[Work](n: 1)
    t3.put_work(work_t3)
    work_t4: Work[S64] = work.to[Work](n: 1)
    t4.put_work(work_t4)
    t1.retrieve()
    t2.retrieve()
    t3.retrieve()
    t4.retrieve()
    drop t1
    drop t2
    drop t3
    drop t4
    Console.show("count {COUNT.peek()} (expected 400000)")
    return
