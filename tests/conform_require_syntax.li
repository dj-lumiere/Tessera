### Conditions on a conformance are written with `when`.
record Box[T]
obeys Equatable[Box[T]] require T: typename, Equatable[T]
    value: T

### Makes a `Box` from its fields.
### :param value: Its `value`.
### :returns: The new value.
common routine Box[T].construct(value: T) -> Me
    return(Me(value))

### Releases nothing: a `Box` holds no memory of its own.
routine @Box[T].destruct() -> None
    return()

routine start() -> None
    return()
