# A view of memory in an entity's field, the entity dropped after the memory.
import Standard/Os

### Holds a span.
entity Q
    held: @[Byte]

### Makes one.
### :returns: The holder.
common routine Q.construct() -> Me
    return Me(held: .hollow())

### Reads what it holds.
routine @Q.destruct() -> None
    s: @[Byte] = me.held.peek()
    Console.show("{s.count}")
    return

routine start() -> None
    local m: @Memory[Byte] <- [b'h'] * 8 from HEAP
    local q: @Q <- .construct()

    q.held.poke(m.getslice())
    drop m
    drop q
    return
