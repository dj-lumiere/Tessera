# A range's step held in a value that is 0 crashes before the first round with RangeStepZeroError, as RazorForge's
# ranges do, instead of a loop that never ends.

import Hosted

### Walks a range by `step`.
routine walk(step: S64) -> None
    each i in 0 til 10 by step
        Console.show("{i}")
    return

routine start() -> None
    Console.show("before")
    walk(step: 0)
    Console.show("not reached")
    return
