# A store can't acquire: an Unbroken[T]'s poke[ACQ_REL] is a build error at the call, naming the orders it takes.

import Hosted

record Flags
    ready: Unbroken[U32]

routine start() -> None
    f: &Flags <- Flags(ready: Unbroken[U32](value: 0))
    f.ready.poke[ACQ_REL](1)
    Console.show("{f.ready.peek()}")
    return
