# A call names a value type argument as a number, a value parameter in scope or a preset.
import Hosted

### The number of limbs.
preset LIMBS: U64 = 4

### A box.
### :typeparam L: The value.
record Box[L]
needs L: U64
    v: U64

### The first limb.
### :typeparam K: The count.
### :param x: The array.
### :returns: x[0].
routine first[K](x: Array[U64, K]) -> U64
needs K: U64
    return x[0]

### K itself.
### :typeparam K: The value.
### :returns: K.
routine count[K]() -> U64
needs K: U64
    return K

### Passes its own K on.
### :typeparam K: The count.
### :param x: The array.
### :returns: x[0] plus K.
routine passing[K](x: Array[U64, K]) -> U64
needs K: U64
    return first[K](x) + count[K]()

### L times K.
### :typeparam K: The factor.
### :returns: The product.
routine Box[L].times[K]() -> U64
needs L: U64, K: U64
    return L * K

### Prints them.
routine start() -> None
    a: Array[U64, 4] = [1, 2, 3, 4]
    Console.show("{first[4](a)} {first[LIMBS](a)} {passing[4](a)} {count[2 + 3]()}")
    b: Box[6] = .hollow()
    Console.show("{b.times[7]()}")
    return
