# A @[T] is a view of values that live somewhere else: an array on the stack, a list, memory from a manager, the
# bytes of a text. Its getslot(i) is the checked address, and every access through it is @T's own (peek, poke,
# volatile, unbroken). getitem and setitem are the value shortcuts, `try` on getitem gives a Maybe, and getslice is a
# checked range view.

import Standard/Collections
import Standard/Os

### Sums whatever the span shows: the same routine reads an array, a list, and memory from the heap.
routine total(values: @[U32]) -> U64
    sum: &U64 <- 0

    each i in 0 til values.count()
        value: U32 = values[i]
        (sum.load() + value.to[U64]()).poke_into(sum)
    then
        return sum.load()

routine from_array() -> None
    digits: &Array[U32, 5] <- [1, 2, 3, 4, 5]

    view: @[U32] = digits.getview()
    tail: @[U32] = digits.getslice(start: 2, count: 3)
    Console.show("array: count {view.count()}, total {total(view)}, last three {total(tail)}")
    view.getslot(0).poke(10)
    Console.show(
        "array after setitem: {digits.getitem(0)}, getitem_checked(4) {try view.getitem(4)}",
        end: "")
    Console.show(", getitem_checked(5) {try view.getitem(5)}")
    return

routine from_list() -> None
    primes: &List[U32] <- .construct(HEAP)

    primes.add_last(2)
    primes.add_last(3)
    primes.add_last(5)
    primes.add_last(7)
    view: @[U32] = primes.getview()
    middle: @[U32] = primes.getslice(start: 1, count: 2)
    Console.show("list: {primes}, count {primes.count()}, total {total(view)}, middle {total(middle)}")
    empty: @[U32] = primes.getslice(start: 4, count: 0)
    Console.show("an empty view at the end: count {empty.count()}")
    drop primes
    return

routine from_managed() -> None
    squares: &[U32] <- .construct(count: 4, manager: HEAP)

    each i in 0 til squares.count()
        v: U32 = i.to[U32]()
        squares.getslot(i).poke(v * v)
    view: @[U32] = squares.getslice()
    first: @U32 = view.to[@U32]()
    Console.show("managed: total {total(view)}, squares[3] {squares[3]}, through the address {first.stride(2).peek()}")
    drop squares
    return

routine from_bytes() -> None
    text: @[Byte] = "Tessera"
    whole: @[Byte] = text.getview()
    part: @[Byte] = text.getslice(start: 1, count: 3)
    Console.show(
        "bytes: count {whole.count()}, first {whole.getitem(0).diagnose()}, part count {part.count()}",
        end: "")
    Console.show(", part starts with {part.getitem(0).diagnose()}")
    return

### The whole @T vocabulary through getslot(): nothing is redefined on PointedSlice.
routine through_at() -> None
    counters: &Array[U32, 3] <- [0, 0, 0]

    view: @[U32] = counters.getview()
    before: U32 = view.getslot(1).unbroken_fetch_add(5)
    after: U32 = view.getslot(1).peek_unbroken()
    view.getslot(2).poke_volatile(9)
    register: U32 = view.getslot(2).peek_volatile()
    view.getslot(0).poke(4)
    Console.show("atomic: was {before}, now {after}. volatile: {register}. plain: {view.getslot(0).peek()}")
    return

routine start() -> None
    from_array()
    from_list()
    from_managed()
    from_bytes()
    through_at()
    return
