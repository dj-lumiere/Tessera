// Choices: implicit member values, the default S32 underlying type, eq / ne, and switches that name every member
// instead of a '_' arm.

/// Implicit values count up from the previous member.
choice Level: S8
    Low
    Mid
    High : 10
    Max

/// No underlying type: S32.
choice Shape: U8
    Circle
    Square

#[external("c"), symbol("printf"), variadic]
routine c_printf_d(%fmt: @Byte) -> S32

routine level_value(%l: Level) -> S64
    block entry():
        %raw  : S8  = bitcast<Level, S8>(%l)
        %wide : S64 = %raw.to_s64()
        return(%wide)

/// Every member is named, so no '_' arm is needed.
routine level_rank(%l: Level) -> S64
    block entry():
        when %l:
            Level.Low  -> return(1)
            Level.Mid  -> return(2)
            Level.High -> return(3)
            Level.Max  -> return(4)

routine shape_sides(%s: Shape) -> S64
    block entry():
        %circle : Bool = %s.eq(Shape.Circle)
        branch %circle ? return(0) : return(4)

routine main() -> S32
    block entry():
        c_printf_d("%lld\n", level_value(Level.Low))
        c_printf_d("%lld\n", level_value(Level.Mid))
        c_printf_d("%lld\n", level_value(Level.High))
        c_printf_d("%lld\n", level_value(Level.Max))
        c_printf_d("%lld\n", level_rank(Level.High))
        c_printf_d("%lld\n", shape_sides(Shape.Circle))
        c_printf_d("%lld\n", shape_sides(Shape.Square))
        %l       : Level = Level.Mid
        %same    : Bool  = %l.eq(Level.Mid)
        %differs : Bool  = %l.ne(Level.Mid)
        c_printf_d("%lld\n", %same.to_s64())
        c_printf_d("%lld\n", %differs.to_s64())
        return(0)
