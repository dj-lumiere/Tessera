# Me is the type a routine is on, so no type parameter takes that name.

record Box[Me]
    value: S64

### Makes a `Box` from its fields.
### :param value: Its `value`.
### :returns: The new value.
routine Box[Me].construct(value: S64) -> Me
    return(Me(value))

### Releases nothing: a `Box` holds no memory of its own.
routine Box[Me].destruct(me: @Me) -> None
    return()

routine start() -> None
    return()
