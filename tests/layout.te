# Buildtime sizeof / alignof must match what LLVM lays out at run time. Probe[T] copies T's layout from the
# buildtime values (an @aligned field over a byte array). The runtime sizeof / alignof of both must agree.

preset LARGER: S64 = max(sizeof[S32](), sizeof[S16]())

record Probe[T]
needs T: typename
    @aligned(alignof[T]())
    bytes: Array[Byte, sizeof[T]()]

record Mixed
    a: S8
    b: S64
    c: S16

record Nested
    tag: S8
    inner: Mixed

record Wide
    tag: S8
    value: S128

choice Level: S8
    LOW
    HIGH

@layout(align: 32)
record Aligned32
    x: S8

record FieldAligned
    a: S8
    @aligned(16)
    b: S8

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

routine check[T](name: @Byte) -> None
needs T: typename
    local size: U64 = sizeof[T]()
    local align: U64 = alignof[T]()
    local probe_size: U64 = sizeof[Probe[T]]()
    local probe_align: U64 = alignof[Probe[T]]()

    size_ok: Bool = size == probe_size
    align_ok: Bool = align == probe_align
    if size_ok and align_ok
        c_printf("%s ok\n", name)
        return
    else
        c_printf("%s: runtime %llu/%llu, compile time %llu/%llu\n", name, size, align, probe_size,
            probe_align)
        return

routine start() -> None
    check[S8]("S8")
    check[S16]("S16")
    check[S32]("S32")
    check[S64]("S64")
    check[S128]("S128")
    check[B16]("B16")
    check[BF16]("BF16")
    check[B32]("B32")
    check[B64]("B64")
    check[Bool]("Bool")
    check[@Byte]("Ptr")
    check[Array[S16, 3]]("Array")
    check[Mixed]("Mixed")
    check[Nested]("Nested")
    check[Wide]("Wide")
    check[Level]("Level")
    check[Aligned32]("Aligned32")
    check[FieldAligned]("FieldAligned")

    # @aligned really moves things: Aligned32 is one byte padded to 32, FieldAligned.b sits at offset 16.
    a32_size: U64 = sizeof[Aligned32]()
    a32_align: U64 = alignof[Aligned32]()
    fa_size: U64 = sizeof[FieldAligned]()
    larger: U64 = sizeof[Array[S8, LARGER]]()
    c_printf("%llu %llu %llu %llu\n", a32_size, a32_align, fa_size, larger)
    return
