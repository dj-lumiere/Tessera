# A crash names the caller's place: the stdlib's add is @track_caller, so is check below, and check passes on the
# place it was called from. The handler prints it and exits with status 3.

import Standard/Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("track_caller.te")
    Console.show("crashed: {name} at {place.line.peek()}:{place.column.peek()}, this file {here}")
    exit(3)

### Adds one, which overflows at S64.MAX: the place is check's caller.
@track_caller
routine check(x: S64) -> S64
    y: S64 = x + 1
    return y

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    a: S64 = check(1)
    Console.show("{a}")
    b: S64 = check(S64.MAX)
    Console.show("not reached {b}")
    return
