# An iterator hands out values with emit / emit_checked and, over elements in memory, their slots with next /
# next_checked. emit past the end crashes with AbsentValueError at the caller's line.

import Standard/Collections
import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    file: Span[Byte] = place.file.peek()
    here: Bool = file.has_suffix("iterator_emit_next.tess")
    Out.write("crashed: {name} at this file {here}, line {place.line.peek()}\n")
    exit(3)

routine start() -> None
    local list: @List[S64] <- .construct()
    local slots: @ListIter[S64] <- .hollow()
    local values: @ListIter[S64] <- .hollow()

    list.add_last(1)
    list.add_last(2)
    list.add_last(3)
    ListIter[S64].construct(list).poke_into(slots)

    while true
        slot: Maybe[@S64] = slots.next_checked()
        when slot
            is @S64 as p =>
                (p.peek() * 2).poke_into(p)
                continue
            is None => break
    ListIter[S64].construct(list).poke_into(values)
    first: S64 = values.emit()
    rest: Maybe[S64] = values.emit_checked()
    Out.write("{first} {rest.diagnose()} {values.next().peek()}\n")
    last: Maybe[S64] = values.emit_checked()
    Out.write("{last.diagnose()}\n")
    past: S64 = values.emit()
    Out.write("not reached {past}\n")
    drop list
    return
