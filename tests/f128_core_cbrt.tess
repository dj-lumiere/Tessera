routine main() -> S32
    block entry():
        %out_val : FdWriter = .stdout()
        claim #out : Ptr<FdWriter>
        #out.store(%out_val)
        jump loop(#out, 0, 0)

    block loop(#out: Ptr<FdWriter>, %i: U64, %passed: U64):
        %done : Bool = %i.eq(3319)
        branch %done ? report(#out, %passed) : check(#out, %i, %passed)

    block check(#out: Ptr<FdWriter>, %i: U64, %passed: U64):
        #inputs : Ptr<U128> = CBRT_INPUT.to_ptr()
        #wants  : Ptr<U128> = CBRT_WANT.to_ptr()
        %x      : U128      = #inputs[%i].load()
        %want   : U128      = #wants[%i].load()
        %root   : F128      = f128_cm_cbrt(f128_of(%x))
        %got    : U128      = %root.bits()
        %ok     : Bool      = %got.eq(%want)
        branch %ok
            ? loop(#out, %i.add(1), %passed.add(1))
            : mismatch(#out, %i, %passed, %x, %got, %want)

    block mismatch(#out: Ptr<FdWriter>, %i: U64, %passed: U64, %x: U128, %got: U128, %want: U128):
        write(#out, "cbrt ")
        %x.represent_hex(#out)
        write(#out, " = ")
        %got.represent_hex(#out)
        write(#out, " not ")
        %want.represent_hex(#out)
        write(#out, "\n")
        jump loop(#out, %i.add(1), %passed)

    block report(#out: Ptr<FdWriter>, %passed: U64):
        write(#out, "{%passed} ok\n")
        return(0)
