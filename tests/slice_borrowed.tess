// The allocator a Slice[T] or a Bytes carries says whether destruct() gives memory back. A null allocator means
// borrowed, and destruct() does nothing: a string literal, getview(), getslice, a sub-text, to[Slice[Byte]]() of a text.
// Memory from an allocator goes back on the first destruct(), which leaves the value empty (null data, count 0, null
// allocator), so a second destruct() does nothing. A counting allocator shows every block.

import Standard/Alloc
import Standard/Format
import Standard/Os

record Counts
    live: S64

routine counting_alloc(state: Addr, size: USize, align: USize) -> Addr
    block entry()
        counts: @Counts = state.to[@Counts]()
        more: S64 = counts.live.peek().add(1)
        more.poke_into(counts.live)
        malloc: Callable[(Addr, USize, USize), Addr] = DEFAULT_HEAP.alloc_fn.peek()
        return(malloc.call(null, size, align))

routine counting_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    block entry()
        realloc: Callable[(Addr, Addr, USize, USize), Addr] = DEFAULT_HEAP.realloc_fn.peek()
        return(realloc.call(null, old, size, align))

routine counting_free(state: Addr, memory: Addr) -> Void
    block entry()
        counts: @Counts = state.to[@Counts]()
        fewer: S64 = counts.live.peek().sub(1)
        fewer.poke_into(counts.live)
        free: Callable[(Addr, Addr), Void] = DEFAULT_HEAP.free_fn.peek()
        free.call(null, memory)
        return()

routine literal() -> Void
    block entry()
        claim text: @Bytes <- "a literal"
        text.destruct()
        Out.write("literal after destruct: [{text.peek()}], borrowed {text.alloc.peek().is_null()}\n")
        return()

routine text(counts: @Counts, alloc: @MemoryManager) -> Void
    block entry()
        claim joined: @Bytes <- Bytes.concat(a: "Tes", b: "sera", alloc)
        Out.write("concat: [{joined.peek()}], live {counts.live.peek()}\n")
        claim view: @Bytes <- joined.getview()
        view.destruct()
        claim part: @Bytes <- joined.slice(start: 1, end: 4)
        part.destruct()
        claim bytes: @Slice[Byte] <- joined.peek().to[Slice[Byte]]()
        bytes.destruct()
        Out.write("views destructed: [{view.peek()}] [{part.peek()}] {bytes.count()}, live {counts.live.peek()}\n")
        copy: Bytes = joined.peek()
        joined.destruct()
        empty: Bool = joined.data.peek().is_null()
        Out.write("concat destructed: live {counts.live.peek()}, empty {empty}, count {joined.count()}")
        Out.write(", borrowed {joined.alloc.peek().is_null()}, the copy kept its allocator {copy.alloc.is_not_null()}\n")
        joined.destruct()
        Out.write("second destruct: live {counts.live.peek()}\n")
        return()

routine values(counts: @Counts, alloc: @MemoryManager) -> Void
    block entry()
        claim squares: @Slice[U32] <- .construct(count: 4, alloc)
        squares.setitem(index: 3, value: 9)
        claim view: @Slice[U32] <- squares.getview()
        view.destruct()
        claim part: @Slice[U32] <- squares.getslice(start: 2, count: 2)
        part.destruct()
        Out.write("slice views destructed: {view.getitem(3)} {part.getitem(1)}, live {counts.live.peek()}\n")
        squares.resize(8)
        Out.write("resized: count {squares.count()}, kept {squares.getitem(3)}, live {counts.live.peek()}\n")
        squares.destruct()
        Out.write("slice destructed: live {counts.live.peek()}, count {squares.count()}")
        Out.write(", borrowed {squares.alloc.peek().is_null()}\n")
        squares.destruct()
        return()

routine start() -> Void
    block entry()
        claim counts: @Counts <- (live: 0)
        counting: MemoryManager = MemoryManager(alloc_fn: counting_alloc.to[Callable](),
            realloc_fn: counting_realloc.to[Callable](), free_fn: counting_free.to[Callable](),
            reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: counts)
        claim alloc: @MemoryManager <- counting
        literal()
        text(counts, alloc)
        values(counts, alloc)
        Out.write("in the end: live {counts.live.peek()}\n")
        return()
