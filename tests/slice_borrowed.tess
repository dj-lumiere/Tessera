// A Span[T] is a view and releases nothing: a string literal, getview(), getslice, a sub-text. A Memory[T] from a
// manager goes back on drop(), which leaves it hollow (null data, count 0), so a second drop() does nothing. A
// counting manager shows every block.

import Standard/Alloc
import Standard/Format
import Standard/Os

record Counts
    live: S64

routine counting_alloc(state: Addr, size: USize, align: USize) -> Addr
    counts: @Counts = state.to[@Counts]()
    more: S64 = counts.live.peek().add(1)
    more.poke_into(counts.live)
    malloc: Callable[(Addr, USize, USize), Addr] = DEFAULT_HEAP.alloc_fn.peek()
    return(malloc.call(null, size, align))

routine counting_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    realloc: Callable[(Addr, Addr, USize, USize), Addr] = DEFAULT_HEAP.realloc_fn.peek()
    return(realloc.call(null, old, size, align))

routine counting_free(state: Addr, memory: Addr) -> Void
    counts: @Counts = state.to[@Counts]()
    fewer: S64 = counts.live.peek().sub(1)
    fewer.poke_into(counts.live)
    free: Callable[(Addr, Addr), Void] = DEFAULT_HEAP.free_fn.peek()
    free.call(null, memory)
    return()

routine literal() -> Void
    claim text: @Span[Byte] <- "a literal"
    text.destruct()
    Out.write("literal after destruct: [{text.peek()}]\n")
    return()

routine text(counts: @Counts, alloc: @MemoryManager) -> Void
    claim joined: @Memory[Byte] <- Span[Byte].concat(a: "Tes", b: "sera", alloc)
    Out.write("concat: [{joined.getview()}], live {counts.live.peek()}\n")
    claim view: @Span[Byte] <- joined.getview()
    view.destruct()
    claim part: @Span[Byte] <- joined.slice(start: 1, end: 4)
    part.destruct()
    Out.write("views destructed: [{view.peek()}] [{part.peek()}], live {counts.live.peek()}\n")
    joined.drop()
    empty: Bool = joined.data.peek().is_null()
    Out.write("concat dropped: live {counts.live.peek()}, empty {empty}, count {joined.count()}\n")
    joined.drop()
    Out.write("second drop: live {counts.live.peek()}\n")
    return()

routine values(counts: @Counts, alloc: @MemoryManager) -> Void
    claim squares: @Memory[U32] <- .construct(count: 4, manager: alloc)
    squares.store(index: 3, value: 9)
    claim view: @Span[U32] <- squares.getview()
    view.destruct()
    claim part: @Span[U32] <- squares.getslice(start: 2, count: 2)
    part.destruct()
    Out.write("views destructed: {view.getitem(3)} {part.getitem(1)}, live {counts.live.peek()}\n")
    squares.resize(8)
    Out.write("resized: count {squares.count()}, kept {squares.load(3)}, live {counts.live.peek()}\n")
    squares.drop()
    Out.write("memory dropped: live {counts.live.peek()}, count {squares.count()}\n")
    squares.drop()
    return()

routine start() -> Void
    claim counts: @Counts <- (live: 0)
    counting: MemoryManager = MemoryManager(alloc_fn: counting_alloc.to[Callable](),
        realloc_fn: counting_realloc.to[Callable](), free_fn: counting_free.to[Callable](),
        reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: counts)
    claim alloc: @MemoryManager <- counting
    literal()
    text(counts, alloc)
    values(counts, alloc)
    Out.write("in the end: live {counts.live.peek()}\n")
    return()
