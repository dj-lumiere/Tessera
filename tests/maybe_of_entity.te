# Maybe[E] written with an entity E is Optional[E]: the name says the value holds an entity or nothing.

### A counter.
entity Counter
    n: S64

### Makes one.
### :returns: The new value.
common routine Counter.construct() -> Me
    return Counter(n: 0)

### Ends it.
routine @Counter.destruct() -> None
    return

### Nothing to find.
### :returns: None.
routine find() -> Maybe[Counter]
    return None()

routine start() -> None
    r: &Optional[Counter] <- find()
    drop r
    return
