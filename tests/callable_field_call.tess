// A Callable stored in a field is loaded, then called with .call: calling the field would hide the load.
routine twice(%x: S64) -> S64
    block entry():
        return(%x.mul(2))

record Ops
    op: Callable<(S64,), S64>

routine main() -> S32
    block entry():
        %ops: Ops = Ops { op: twice }
        #ops: Ptr<Ops> = alloca
        #ops.store(%ops)
        %n: S64 = #ops.op(21)
        return(0)
