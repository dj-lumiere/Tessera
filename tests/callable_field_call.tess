record Ops
    op: Callable[(S64,), S64]

/// Makes a `Ops` from its fields.
/// :param op: Its `op`.
/// :returns: The new value.
routine Ops.construct(op: Callable[(S64,), S64]) -> Me
    return(Me(op))

/// Releases nothing: a `Ops` holds no memory of its own.
routine Ops.destruct(me: @Me) -> Void
    return()

// A Callable stored in a field is loaded, then called with .call: calling the field would hide the load.
routine twice(x: S64) -> S64
    return(x.mul(2))

routine start() -> Void
    claim ops: @Ops <- Ops(op: twice.to[Callable]())
    n: S64 = ops.op(21)
    return()
