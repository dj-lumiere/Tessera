# ProcessManager.create_process_result and create_shell_process_result report an allocator that fails as OutOfMemory: one that gives nothing (the
# run can't even build its command line, which Windows used to report as InvalidArgument), and one that can't grow a
# capture past its first block, which used to hand back the first part of the output as if that were all. The same
# command with the default heap captures everything. The command prints 200 lines of 48 x's, over several reads.

import Standard/Os

### The bytes the command prints at least (200 lines of 48 x's and a line ending).
preset LONG_COUNT: U64 = 9800

### A memory manager that gives nothing.
record Refusing

### A memory manager that gives blocks from the default heap (it gives any alignment, the C heap only malloc's own) and
### never grows one.
record NoGrow

obeys MemoryManageable[Refusing]
obeys MemoryManageable[NoGrow]

### Always fails.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine @Refusing.alloc(size: U64, align: U64) -> Addr
    return .hollow()

### Always fails, leaving the block as it was.
### :param at: Unused.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine @Refusing.realloc(at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

### The default heap's free.
### :param at: The block.
routine @Refusing.free(at: Addr) -> None
    HEAP.free(at)
    return

### The default heap's allocation.
### :param size: The size in bytes.
### :param align: The alignment.
### :returns: The block, or null.
routine @NoGrow.alloc(size: U64, align: U64) -> Addr
    return HEAP.alloc(size, align)

### Always fails, leaving the block as it was.
### :param at: Unused.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine @NoGrow.realloc(at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

### The default heap's free.
### :param at: The block.
routine @NoGrow.free(at: Addr) -> None
    HEAP.free(at)
    return

### The command that prints the 200 lines, through cmd.exe.
### :returns: The command line.
@target(os: "windows")
routine long_echo() -> @[Byte]
    return "for /L %i in (1,1,200) do @echo xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

### The command that prints the 200 lines, through sh.
### :returns: The command line.
@target(os: ("linux", "macos"))
routine long_echo() -> @[Byte]
    return "i=0; while [ $i -lt 200 ]; do echo xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx; i=$((i+1)); done"

### The name of a run's failure.
### :param e: The failure.
### :returns: Its name.
routine error_name(e: ProcessError) -> @[Byte]
    return e.name()

### Runs the long echo with `alloc` and says how it went.
### :param label: What the allocator is.
### :param alloc: The allocator for the run.
routine run(label: @[Byte], alloc: @MemoryManager) -> None
    when check ProcessManager.create_shell_process(command: long_echo(),
        options: ProcessOptions.default(), alloc)
        is ProcessOutput as output =>
            whole: Bool = output.stdout.count() >= LONG_COUNT
            Console.show("{label}: captured all of it {whole}")
            drop output
            return
        is ProcessError as e =>
            Console.show("{label}: {error_name(e)}")
            return

routine start() -> None
    local refusing: @Refusing <- .hollow()
    local no_growing: @NoGrow <- .hollow()
    local nothing: @MemoryManager <- refusing.to[MemoryManager]()
    local no_grow: @MemoryManager <- no_growing.to[MemoryManager]()

    run(label: "an allocator that gives nothing", alloc: nothing)
    run(label: "an allocator that can't grow a capture", alloc: no_grow)
    run(label: "the default heap", alloc: HEAP)
    return
