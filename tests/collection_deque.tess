; Deque<I64> against a model. An LCG drives random pushes and pops at both ends, get / set, and a rare clear, in five
; phases: balanced, front-heavy, back-heavy, a queue (push_back / pop_front), and a reversed queue (push_front /
; pop_back). Every 500 operations a checkpoint prints the length, the capacity (a queue must not grow it without
; bound), a running checksum of every result, and a hash of the DequeIter sequence. Then eq.
; The expected output is generated by scripts/gen_collection_seq.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Percentages of each push and pop; get and set take 10 each.
struct Mix
    push_back:  I64
    push_front: I64
    pop_back:   I64
    pop_front:  I64

; Folds every element front to back.
routine iteration_hash(#deque: Ptr<Deque<I64>>) -> I64
    block entry():
        %iter_val: DequeIter<I64> = DequeIter<I64>.new(#deque)
        #iter: Ptr<DequeIter<I64>> = alloca<DequeIter<I64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<DequeIter<I64>>, %hash: I64):
        %item: Option<I64> = #iter.next()
        %more: Bool = %item.tag
        %value: I64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #deque: Ptr<Deque<I64>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #deque.length())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#deque))
        %capacity: I64 := #deque.capacity
        labeled(#out, "capacity", %capacity)
        write_line(#out)
        return()

; Runs %ops random operations weighted by %mix. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #deque: Ptr<Deque<I64>>, #rng: Ptr<Rng>,
        %phase: I64, %ops: I64, %mix: Mix, %results: I64) -> I64
    block entry():
        %push_back_end:  I64 = %mix.push_back.mul(10)
        %push_front_end: I64 = %push_back_end.add(%mix.push_front.mul(10))
        %pop_back_end:   I64 = %push_front_end.add(%mix.pop_back.mul(10))
        %pop_front_end:  I64 = %pop_back_end.add(%mix.pop_front.mul(10))
        jump next(0, %results, %push_back_end, %push_front_end, %pop_back_end, %pop_front_end)

    block next(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results, %pbe, %pfe, %obe, %ofe)

    block pick(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %kind: I64 = #rng.below(1000)
        %is_push_back:  Bool = %kind.slt(%pbe)
        %is_push_front: Bool = %kind.slt(%pfe)
        %is_pop_back:   Bool = %kind.slt(%obe)
        %is_pop_front:  Bool = %kind.slt(%ofe)
        %is_get:        Bool = %kind.slt(%ofe.add(100))
        %is_clear:      Bool = %kind.eq(999)
        select:
            %is_push_back -> push_back(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_push_front -> push_front(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_pop_back -> pop_back(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_pop_front -> pop_front(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_get -> get(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_clear -> clear(%op, %results, %pbe, %pfe, %obe, %ofe)
            _ -> set(%op, %results, %pbe, %pfe, %obe, %ofe)

    block push_back(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %value: I64 = #rng.below(1000000)
        #deque.push_back(%value)
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block push_front(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %value: I64 = #rng.below(1000000)
        #deque.push_front(%value)
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block pop_back(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %empty: Bool = #deque.is_empty()
        branch %empty
            ? record(%op, %results, -1, %pbe, %pfe, %obe, %ofe)
            : record(%op, %results, #deque.pop_back(), %pbe, %pfe, %obe, %ofe)

    block pop_front(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %empty: Bool = #deque.is_empty()
        branch %empty ? record(%op, %results, -1, %pbe, %pfe, %obe, %ofe) : pop_front_one(%op, %results, %pbe, %pfe, %obe, %ofe)

    block pop_front_one(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %value: I64 = #deque.pop_front()
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block get(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %empty: Bool = #deque.is_empty()
        branch %empty ? record(%op, %results, -2, %pbe, %pfe, %obe, %ofe) : get_one(%op, %results, %pbe, %pfe, %obe, %ofe)

    block get_one(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %index: I64 = #rng.below(#deque.length())
        %value: I64 = #deque.get(%index)
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block set(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %empty: Bool = #deque.is_empty()
        branch %empty ? record(%op, %results, -3, %pbe, %pfe, %obe, %ofe) : set_one(%op, %results, %pbe, %pfe, %obe, %ofe)

    block set_one(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %index: I64 = #rng.below(#deque.length())
        %value: I64 = #rng.below(1000000)
        #deque.set(%index, %value)
        jump record(%op, %results, %index, %pbe, %pfe, %obe, %ofe)

    block clear(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        #deque.clear()
        jump record(%op, %results, -4, %pbe, %pfe, %obe, %ofe)

    block record(%op: I64, %results: I64, %result: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed, %pbe, %pfe, %obe, %ofe) : next(%op_next, %mixed, %pbe, %pfe, %obe, %ofe)

    block report(%op: I64, %results: I64, %pbe: I64, %pfe: I64, %obe: I64, %ofe: I64):
        checkpoint(#out, #deque, %phase, %op, %results)
        jump next(%op, %results, %pbe, %pfe, %obe, %ofe)

; Copies #from into #to by pushing each element at the front, back to front, so #to has a different start.
routine copy_reversed_pushes(#from: Ptr<Deque<I64>>, #to: Ptr<Deque<I64>>) -> Void
    block entry():
        %length: I64 = #from.length()
        jump next(%length)

    block next(%index: I64):
        %done: Bool = %index.sle(0)
        branch %done ? return() : copy(%index.sub(1))

    block copy(%index: I64):
        #to.push_front(#from.get(%index))
        jump next(%index)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 3 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %deque_val: Deque<I64> = Deque<I64>.new(#alloc)
        #deque: Ptr<Deque<I64>> = alloca<Deque<I64>>([%deque_val])

        %balanced:       Mix = Mix { push_back: 25, push_front: 25, pop_back: 15, pop_front: 15 }
        %front_heavy:    Mix = Mix { push_back: 5, push_front: 45, pop_back: 20, pop_front: 10 }
        %back_heavy:     Mix = Mix { push_back: 45, push_front: 5, pop_back: 10, pop_front: 20 }
        %queue:          Mix = Mix { push_back: 40, push_front: 0, pop_back: 0, pop_front: 40 }
        %reversed_queue: Mix = Mix { push_back: 0, push_front: 40, pop_back: 40, pop_front: 0 }
        %r1: I64 = run_phase(#out, #deque, #rng, 1, 3000, %balanced, 0)
        %r2: I64 = run_phase(#out, #deque, #rng, 2, 3000, %front_heavy, %r1)
        %r3: I64 = run_phase(#out, #deque, #rng, 3, 3000, %back_heavy, %r2)
        %r4: I64 = run_phase(#out, #deque, #rng, 4, 8000, %queue, %r3)
        %r5: I64 = run_phase(#out, #deque, #rng, 5, 8000, %reversed_queue, %r4)

        %copy_val: Deque<I64> = Deque<I64>.new(#alloc)
        #copy: Ptr<Deque<I64>> = alloca<Deque<I64>>([%copy_val])
        report_eq(#out, "empty copy equal", #deque.eq(#copy))
        copy_reversed_pushes(#deque, #copy)
        report_eq(#out, "copy equal", #deque.eq(#copy))
        %front: I64 = #copy.get(0)
        #copy.set(0, %front.add(1))
        report_eq(#out, "changed front equal", #deque.eq(#copy))
        #copy.set(0, %front)
        #copy.push_front(%front)
        report_eq(#out, "longer equal", #deque.eq(#copy))
        #copy.pop_front()
        report_eq(#out, "restored equal", #deque.eq(#copy))
        #copy.clear()
        report_eq(#out, "cleared is empty", #copy.is_empty())
        #copy.free()
        #deque.free()
        report_eq(#out, "freed is empty", #deque.is_empty())
        #out.flush()
        return(0)
