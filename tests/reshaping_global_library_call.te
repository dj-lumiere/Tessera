# A standard library routine imports no module of the program, so a call to one that takes no routine value can't
# reach a global: a view of what the global holds stays.

import Collections
import Hosted

lateinit global NUMBERS: &List[S64]

routine start() -> None
    NUMBERS.poke(List[S64].construct(manager: HEAP))
    NUMBERS.add_last(5)
    s: @[S64] = NUMBERS.getview()
    Console.show("count {NUMBERS.count()}")
    Console.show(s.getslot(0).peek())
    return
