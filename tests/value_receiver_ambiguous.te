# Two routines that each name a different value argument of the receiver are equally specific for a Pair[2, 3]:
# the call is ambiguous.
import Hosted

### A pair.
### :typeparam A: The first.
### :typeparam B: The second.
record Pair[A, B]
needs A: U64, B: U64
    v: U64

### For A = 2.
### :returns: 2.
routine Pair[2, B].get() -> U64
needs B: U64
    return 2

### For B = 3.
### :returns: 3.
routine Pair[A, 3].get() -> U64
needs A: U64
    return 3

### Runs.
routine start() -> None
    p: Pair[2, 3] = .hollow()
    Console.show("{p.get()}")
    return
