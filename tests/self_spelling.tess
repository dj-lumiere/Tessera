// The receiver is written me.

record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> None
    return()

routine Point.x_of(self: Me) -> S64
    return(self.x)

routine start() -> None
    return()
