// F16's special functions, erf, erfc, gamma and ln_gamma: CORE-MATH ports, correctly rounded, so the same bits on
// every target. Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer is NaN, ln_gamma has +inf
// at 0 and the negative integers.

import Standard::Format
import Standard::Os

routine show(name: Bytes, v: F16) -> Void
    block entry()
        Out.write("{name} {v} {v.bits()}\n")
        return()

routine start() -> Void
    block entry()
        show("erf(0.5)", F16.erf(0.5))
        show("erf(-4)", F16.erf(-4.0))
        show("erfc(3)", F16.erfc(3.0))
        show("erfc(10)", F16.erfc(10.0))
        show("erfc(-1)", F16.erfc(-1.0))
        show("gamma(5)", F16.gamma(5.0))
        show("gamma(0.5)", F16.gamma(0.5))
        show("gamma(-2.5)", F16.gamma(-2.5))
        show("gamma(35.5)", F16.gamma(35.5))
        show("gamma(-0)", F16.gamma(-0.0))
        show("gamma(-2)", F16.gamma(-2.0))
        show("ln_gamma(1)", F16.ln_gamma(1.0))
        show("ln_gamma(2)", F16.ln_gamma(2.0))
        show("ln_gamma(0.5)", F16.ln_gamma(0.5))
        show("ln_gamma(-2.5)", F16.ln_gamma(-2.5))
        show("ln_gamma(100)", F16.ln_gamma(100.0))
        show("ln_gamma(-3)", F16.ln_gamma(-3.0))
        return()
