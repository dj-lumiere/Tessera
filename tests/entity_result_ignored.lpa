# A call that hands back an entity can't be a bare line: what the entity holds would be lost.
import Hosted

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine @Counter.destruct() -> None
    return

### Makes a counter.
### :returns: The counter.
routine make() -> Counter
    return Counter.construct()

### Leaves the counter make gives on the floor.
routine start() -> None
    make()
    Console.show("done")
    return
