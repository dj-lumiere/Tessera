# @[T] in static memory and in the frame, and memory from a manager written as `... at manager`.

import Standard/Os

global BY_LETTER: @[U64] <- [0] * 26

preset STOPWORDS: @[@[Byte]] <- ["the", "a", "an"]

record Node
    value: S64
    next: @Node

routine sum(xs: @[S64]) -> S64
    each i in 0 til xs.count with total: S64 = 0
        continue with total: total + xs[i]
    then
        return total

routine start() -> None
    out: @ConsoleOutput = Console.output()
    local lower: @[Byte] <- [b'\x00'] * 64
    local words: @Memory[S64] <- [1, 2] * 3 from HEAP
    local one: @Box[Node] <- (value: 7, next: .hollow()) from HEAP
    lower.getslot(3).poke(b'\x41')
    BY_LETTER.getslot(2).poke(9)
    word: @[Byte] = STOPWORDS.getitem(2)
    out.write("{STOPWORDS.count()} {word} {lower.count()} {lower.getitem(3).to[U8]()} {BY_LETTER.getitem(2)} {BY_LETTER.count()}\n")
    total: S64 = sum(words.getslice())
    literal: S64 = sum([4, 5, 6])
    node: Node = one.load()
    out.write("{total} {words.count()} {literal} {node.value}\n")
    drop words
    drop one
    return
