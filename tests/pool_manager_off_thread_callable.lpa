# A work that calls a routine value builds when no routine the program turns into a routine value uses the pool.

import Hosted

### Shows a number.
### :param n: The number.
routine show_it(n: S64) -> None
    Console.show("called {n}")
    return

global HOOK: &Callable[(S64,), None] <- idle.to[Callable[(S64,), None]]()

### Does nothing.
### :param n: Unused.
routine idle(n: S64) -> None
    return

### The work: it calls the routine value kept in a global, which the build can't name the routine of.
routine run() -> None
    hook: Callable[(S64,), None] = HOOK.load()
    hook.call(1)
    return

routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    t: Thread[None] <- get_thread[None]()
    HOOK.store(show_it.to[Callable[(S64,), None]]())
    w: Work[None] = run.to[Work]()
    t.put_work(w)
    t.retrieve()
    drop t
    drop pool
    return
