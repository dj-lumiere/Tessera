# A field of a global record is a place: loaded, stored, and the target of store_into.
import Standard/Hosted

global ROOTS: &HeaderBuffer

record HeaderBuffer
    items: @Addr
    count: U64
    capacity: U64

routine reset() -> None
    ROOTS.count.poke(0)
    return

routine set(n: U64) -> None
    n.poke_into(ROOTS.count)
    return

routine get() -> U64
    c: U64 = ROOTS.count.peek()
    return c

routine start() -> None
    set(5)
    Console.show("{get()}")
    reset()
    Console.show("{get()}")
    return
