# Work whose arguments have nothing to give back (numbers, a view) is a value: put_work(work) copies it, so one piece
# of work goes on several tickets, and work no ticket takes leaves nothing behind.

import Collections
import Hosted

routine square(n: S64) -> S64
    return n * n

### The value a view points at.
### :param at: The view.
### :returns: The value.
routine read(at: @S64) -> S64
    return at.peek()

routine start() -> None
    work: Work[S64] = square.to[Work](n: 7)
    unused: Work[S64] = square.to[Work](n: 8)
    ts: &List[Thread[S64]] <- .construct(manager: HEAP)
    each i in 0 til 3
        t: Thread[S64] <- get_thread[S64]()
        t.put_work(work)
        ts.add_last(steal t)
    results: &List[S64] <- ts.retrieve_all()
    Console.show("{results}")
    drop results
    ts.give_back_all()
    drop ts
    cell: &S64 <- 5
    reading: Work[S64] = read.to[Work](at: cell)
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(reading)
    first: S64 = t.retrieve()
    t.put_work(steal reading)
    Console.show("{first} {t.retrieve()}")
    drop t
    return
