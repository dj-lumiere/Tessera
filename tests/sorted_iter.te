# The sorted-collection iterators walk the tree with a stack. On trees several levels deep, after inserts and removes
# that split, borrow, and merge nodes, each must yield exactly get_by_rank(0), get_by_rank(1), ... and then stop, and
# eq (which walks two iterators side by side) must see a copy as equal and a changed copy as different.

import Collections
import Hosted

preset COUNT: S64 = 3000

# ── SortedDict ───────────────────────────────────────────────────────────────

@reshaping(map)
routine fill_dict(map: @SortedDict[S64, S64]) -> None
    each i in 0 til COUNT
        map[i * 7919 % 10007] = i

    each i in 0 til COUNT
        spread: S64 = i * 3 * 7919
        map.remove(spread.mod_trunc(10007))
    then
        return

### Walks the iterator and counts the entries that differ from get_by_rank, or -1 if it yields too many or too few.
routine check_dict(map: @SortedDict[S64, S64]) -> S64
    iter_val: SortedDictIter[S64, S64] = .construct(map)
    iter: &SortedDictIter[S64, S64] <- iter_val
    bad: &S64 <- 0

    loop with rank: U64 = 0
        item2: Maybe[KVPair[S64, S64]] = try iter.emit()
        when item2
            is KVPair[S64, S64] as got =>
                if rank >= map.count()
                    return -1
                want: KVPair[S64, S64] = map.get_by_rank(rank)
                key_same: Bool = want.key == got.key
                value_same: Bool = want.value == got.value
                same: Bool = key_same and value_same
                wrong: S64 = when
                    same => 0
                    else => 1
                (bad.load() + wrong).poke_into(bad)
                continue with rank: rank + 1
            is None =>
                if rank == map.count()
                    return bad.load()
                else
                    return -1

# ── SortedSet ────────────────────────────────────────────────────────────────

@reshaping(set)
routine fill_set(set: @SortedSet[S64]) -> None
    each i in 0 til COUNT
        set.add(i * 7919 % 10007)

    each i in 0 til COUNT
        spread: S64 = i * 3 * 7919
        set.remove(spread.mod_trunc(10007))
    then
        return

routine check_set(set: @SortedSet[S64]) -> S64
    iter_val: SortedSetIter[S64] = .construct(set)
    iter: &SortedSetIter[S64] <- iter_val
    bad: &S64 <- 0

    loop with rank: U64 = 0
        item2: Maybe[S64] = try iter.emit()
        when item2
            is S64 as got =>
                if rank >= set.count()
                    return -1
                expected: S64 = set.get_by_rank(rank)
                same: Bool = expected == got
                wrong: S64 = when
                    same => 0
                    else => 1
                (bad.load() + wrong).poke_into(bad)
                continue with rank: rank + 1
            is None =>
                if rank == set.count()
                    return bad.load()
                else
                    return -1

# ── SortedList ───────────────────────────────────────────────────────────────

### Pushes scattered values, then removes every third position counted from the front.
@reshaping(list)
routine fill_list(list: @SortedList[S64]) -> None
    each i in 0 til COUNT
        list.add(i * 37 % 101)

    until at >= list.count() with at: U64 = 0
        list.remove(at)
        continue with at: at + 2
    then
        return

routine check_list(list: @SortedList[S64]) -> S64
    iter_val: SortedListIter[S64] = .construct(list)
    iter: &SortedListIter[S64] <- iter_val
    bad: &S64 <- 0

    loop with rank: U64 = 0
        item2: Maybe[S64] = try iter.emit()
        when item2
            is S64 as got =>
                if rank >= list.count()
                    return -1
                expected: S64 = list[rank]
                same: Bool = expected == got
                wrong: S64 = when
                    same => 0
                    else => 1
                (bad.load() + wrong).poke_into(bad)
                continue with rank: rank + 1
            is None =>
                if rank == list.count()
                    return bad.load()
                else
                    return -1

routine start() -> None
    manager: @MemoryManager = HEAP
    map: &SortedDict[S64, S64] <- .construct(manager)
    twin: &SortedDict[S64, S64] <- .construct(manager)

    fill_dict(map)
    fill_dict(twin)
    Console.show("dict: {map.count()} entries, {check_dict(map)} wrong, copy equal {map.eq(twin)}")
    twin_count: U64 = twin.count()
    last: KVPair[S64, S64] = twin.get_by_rank(twin_count - 1)
    twin[last.key] = last.value + 1
    Console.show("dict: changed copy equal {map.eq(twin)}")

    set: &SortedSet[S64] <- .construct(manager)
    set_copy: &SortedSet[S64] <- .construct(manager)
    fill_set(set)
    fill_set(set_copy)
    Console.show("set: {set.count()} keys, {check_set(set)} wrong, copy equal {set.eq(set_copy)}")
    set_copy.remove(set_copy.get_by_rank(0))
    set_copy.add(-1)
    Console.show("set: changed copy equal {set.eq(set_copy)}")

    list: &SortedList[S64] <- .construct(manager)
    list_copy: &SortedList[S64] <- .construct(manager)
    fill_list(list)
    fill_list(list_copy)
    Console.show("list: {list.count()} values, {check_list(list)} wrong, copy equal {list.eq(list_copy)}")
    list_copy.remove(0)
    list_copy.add(-1)
    Console.show("list: changed copy equal {list.eq(list_copy)}")

    empty: &SortedDict[S64, S64] <- .construct(manager)
    Console.show("empty: {check_dict(empty)} wrong")

    drop map
    drop twin
    drop set
    drop set_copy
    drop list
    drop list_copy
    drop empty
    return
