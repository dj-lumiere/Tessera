# Memory[T].getslot on memory from the default heap checks the index: an address past the end crashes with
# IndexOutOfBoundsError at the caller's line, through the pointer receiver too.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("{name}: {message}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    local values: @Memory[S64] <- .construct(2)

    values.getslot(1).poke(7)
    Console.show("values[1] = {values.getslot(1).peek()}")
    values.getslot(2).poke(8)
    Console.show("not reached")
    drop values
    return
