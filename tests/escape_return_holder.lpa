# A routine returns an entity that holds the address of its frame slot.

import Hosted

### Holds an address.
entity Q
    ### The address.
    held: @S64

### Makes one.
### :param held: The address.
### :returns: The holder.
common routine Q.construct(held: @S64) -> Me
    return Me(held)

### Gives the holder back.
routine @Q.destruct() -> None
    return

### Makes a holder of a frame slot.
### :returns: The holder.
routine make() -> Q
    l: &S64 <- 5
    q: &Q <- .construct(held: l)

    return q

### Runs.
routine start() -> None
    q: &Q <- make()

    drop q
    return
