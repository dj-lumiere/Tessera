# A global is a `&T` place: load() reads it, store(v) and `<-` write it, and a routine of `@T` takes its view.

import Hosted

global COUNT: &S32 <- 0
global TOTAL: &S64 <- 10

routine bump(cell: @S64) -> None
    cell.poke(cell.peek() + 1)
    return

routine start() -> None
    COUNT <- COUNT.load() + 1
    COUNT.store(COUNT.load() + 1)
    (COUNT.load() + 1).store_into(COUNT)
    bump(TOTAL)
    Console.show("{COUNT.load()} {TOTAL.load()}")
    return
