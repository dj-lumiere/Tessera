// Loads and stores are methods: plain, through fields and elements, pointer fields, presets, Addr, volatile.

import Standard/Alloc
import Standard/Format
import Standard/Os

preset TABLE: @Array[U32, 3] <- [10, 20, 30]

record Point
    x: B64
    y: S64

record Node
    value: S64
    next: @Node

/// Makes a `Node` from its fields.
/// :param value: Its `value`.
/// :param next: Its `next`.
/// :returns: The new value.
routine Node.construct(value: S64, next: @Me) -> Me
    return Me(value, next)

/// Releases nothing: a `Node` holds no memory of its own.
routine Node.destruct(me: @Me) -> None
    return

routine start() -> None
    local p: @S64 <- 1
    sum: S64 = p.peek() + 41
    sum.poke_into(p)
    b: S64 = p.peek()
    Out.write("{b}\n")

    local pt: @Point <- (x: 1.5, y: 2)
    pt.y.poke(7)
    y: S64 = pt.y.peek()
    Out.write("{y}\n")
    whole: Point = pt.peek()
    Out.write("{whole.y}\n")

    local alloc: @MemoryManager <- make_heap_memory()
    local buf: @Memory[U64] <- .construct(count: 4, manager: alloc)
    buf.getslot(2).poke(99)
    e: U64 = buf.getslot(2).peek()
    Out.write("{e}\n")
    drop buf

    local n2: @Node <- (value: 2, next: null)
    local n1: @Node <- (value: 1, next: n2)
    second: @Node = n1.next.peek()
    v2: S64 = second.value.peek()
    Out.write("{v2}\n")

    t: U32 = TABLE.getitem(1)
    Out.write("{t.to[U64]()}\n")

    local slot: @Addr <- p
    back: Addr = slot.peek()
    via: S64 = back.to[@S64]().peek()
    Out.write("{via}\n")
    back.to[@S64]().poke_volatile(5)
    vol: S64 = back.to[@S64]().peek_volatile()
    Out.write("{vol}\n")
    return
