// Loads and stores are methods: plain, through fields and elements, pointer fields, presets, Addr, volatile.

import Standard::Alloc
import Standard::Format

record Point
    x : F64
    y : S64

record Node
    value : S64
    next  : Ptr<Node>

preset TABLE: Array<U32, 3> = [10, 20, 30]

routine main() -> S32
    block entry():
        claim p : Ptr<S64>
        p.store(1)
        p.load().add(41).store_into(p)
        b : S64 = p.load()
        print("{b}\n")

        claim pt : Ptr<Point>
        pt.store(Point { x: 1.5, y: 2 })
        pt.y.store(7)
        y : S64 = pt.y.load()
        print("{y}\n")
        whole : Point = pt.load()
        print("{whole.y}\n")

        heap : Allocator = make_heap_allocator()
        claim alloc : Ptr<Allocator>
        alloc.store(heap)
        buf : Ptr<U64> = allocate<U64>(alloc, 4)
        buf[2].store(99)
        e : U64 = buf[2].load()
        print("{e}\n")

        claim n2 : Ptr<Node>
        n2.store(Node { value: 2, next: null })
        claim n1 : Ptr<Node>
        n1.store(Node { value: 1, next: n2 })
        second : Ptr<Node> = n1.next.load()
        v2     : S64       = second.value.load()
        print("{v2}\n")

        t : U32 = TABLE.get(1)
        print("{t.to_u64()}\n")

        claim slot : Ptr<Addr>
        slot.store(p)
        back : Addr = slot.load()
        via  : S64  = back.load<S64>()
        print("{via}\n")
        back.volatile_store<S64>(5)
        vol : S64 = back.volatile_load<S64>()
        print("{vol}\n")
        return(0)
