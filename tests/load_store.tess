// Loads and stores are methods: plain, through fields and elements, pointer fields, presets, Addr, volatile.

import Standard::Alloc
import Standard::Format
import Standard::Os

record Point
    x : F64
    y : S64

record Node
    value : S64
    next  : @Node

preset TABLE: @Array<U32, 3> <- { 10, 20, 30 }

routine main() -> S32
    block entry():
        claim %p : @S64 <- 1
        %p.load().add(41).store_into(%p)
        %b : S64 = %p.load()
        print("{%b}\n")

        claim %pt : @Point <- { x: 1.5, y: 2 }
        %pt.y.store(7)
        %y : S64 = %pt.y.load()
        print("{%y}\n")
        %whole : Point = %pt.load()
        print("{%whole.y}\n")

        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator <- %heap
        %buf : @U64 = allocate<U64>(%alloc, 4)
        %buf.stride(2).store(99)
        %e : U64 = %buf.stride(2).load()
        print("{%e}\n")

        claim %n2 : @Node <- { value: 2, next: null }
        claim %n1 : @Node <- { value: 1, next: %n2 }
        %second : @Node = %n1.next.load()
        %v2     : S64   = %second.value.load()
        print("{%v2}\n")

        %t : U32 = TABLE.get(1)
        print("{%t.to_u64()}\n")

        claim %slot : @Addr <- %p
        %back : Addr = %slot.load()
        %via  : S64  = %back.cast<S64>().load()
        print("{%via}\n")
        %back.cast<S64>().volatile_store(5)
        %vol : S64 = %back.cast<S64>().volatile_load()
        print("{%vol}\n")
        return(0)
