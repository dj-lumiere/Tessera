// Loads and stores are methods: plain, through fields and elements, pointer fields, presets, Addr, volatile.
record Point
    x: F64
    y: S64

record Node
    value: S64
    next: Ptr<Node>

preset TABLE: Array<U32, 3> = [10, 20, 30]

routine main() -> S32
    block entry():
        #p: Ptr<S64> = alloca<S64>([1])
        %a: S64 = #p.load()
        #p.store(%a.add(41))
        %b: S64 = #p.load()
        print_int(%b)
        println_slice("")

        #pt: Ptr<Point> = alloca<Point>([Point { x: 1.5, y: 2 }])
        #pt.y.store(7)
        %y: S64 = #pt.y.load()
        print_int(%y)
        println_slice("")
        %whole: Point = #pt.load()
        print_int(%whole.y)
        println_slice("")

        %heap: Allocator = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        #buf: Ptr<U64> = alloc<U64>(#alloc, 4)
        #buf[2].store(99)
        %e: U64 = #buf[2].load()
        print_uint(%e)
        println_slice("")

        #n2: Ptr<Node> = alloca<Node>([Node { value: 2, next: null }])
        #n1: Ptr<Node> = alloca<Node>([Node { value: 1, next: #n2 }])
        #second: Ptr<Node> = #n1.next.load()
        %v2: S64 = #second.value.load()
        print_int(%v2)
        println_slice("")

        %t: U32 = TABLE[1].load()
        print_uint(%t.to_u64())
        println_slice("")

        #slot: Ptr<Addr> = alloca<Addr>([#p])
        #back: Addr = #slot.load()
        %via: S64 = #back.load<S64>()
        print_int(%via)
        println_slice("")
        #back.volatile_store<S64>(5)
        %vol: S64 = #back.volatile_load<S64>()
        print_int(%vol)
        println_slice("")
        return(0)
