# A type merely named Stamped is no way to change an entity: without @entity_link it is copied out of a shared read
# access like any record.

import Hosted

### A record named like the pool's stamp, with no mark.
record Stamped
    at: U64

### A record that keeps one.
record Link
    target: Stamped

routine start() -> None
    link: &Link <- Link(target: Stamped(at: 7))
    reading: ReadAuthorized[Link] <- link.get_shared_read_access()
    view: @Link = reading.getview()
    copy: Link = view.peek()
    Console.show("{copy.target.at}")
    drop reading
    return
