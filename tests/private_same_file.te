### private fields and routines are fully usable inside their own module.
import Standard/Format
import Standard/Os

record Counter
    private hits: U64

private routine bump(c: Counter) -> Counter
    r: Counter = Counter(hits: c.hits + 1)
    return r

routine start() -> None
    c: Counter = bump(bump(Counter(hits: 0)))
    Out.write("{c.hits}")
    return
