### secret fields and routines are fully usable inside their own module.
import Standard/Hosted

record Counter
    secret hits: U64

secret routine bump(c: Counter) -> Counter
    r: Counter = Counter(hits: c.hits + 1)
    return r

routine start() -> None
    c: Counter = bump(bump(Counter(hits: 0)))
    Console.show("{c.hits}", end: "")
    return
