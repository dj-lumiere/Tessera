import Hosted

### Where `target` is in a 3 by 3 grid, as row * 10 + column, or -1.
### :param target: The number to find.
### :returns: Its place.
routine find(target: S64) -> S64
    for y in 0 til 3 as rows with found: S64 = -1
        for x in 0 til 3 with seen: S64 = 0
            if y * 3 + x + 1 == target
                Console.show("found {target}")
                break to rows
            continue with seen: seen + 1
        then
            Console.show("row {y} done")
        continue with found: found
    then
        Console.show("rows over")
        return found

### Counts with continue to.
### :returns: A tally.
routine tally() -> S64
    for y in 0 til 4 as rows with total: S64 = 0
        for x in 0 til 4 as cols
            if x == 2
                continue to rows with total: total + 100
            if y == 3
                break to cols
        then
            Console.show("inner then {y}")
        continue with total: total + 1
    then
        return total

find(5)
find(99)
Console.show("{tally()}")
