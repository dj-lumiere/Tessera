# A callee stores the address it is handed into a global.

import Standard/Os

global KEPT: @@S64 <- .hollow()

### Keeps an address.
### :param p: The address.
routine stash(p: @S64) -> None
    KEPT.poke(p)
    return

### The local lives in this frame.
routine fill() -> None
    local l: @S64 <- 1234567

    stash(p: l)
    return

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    local junk: @[S64] <- [0] * 64
    local sum: @S64 <- 0

    each i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    each j: U64 in 0 til 64
        sum.peek().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.peek()

### Runs.
routine start() -> None
    fill()
    s: S64 = scribble(seed: 6666666)
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
