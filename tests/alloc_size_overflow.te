# A count whose size in bytes doesn't fit in U64 is more memory than any manager has: the allocation throws
# OutOfMemoryError, which check receives, and the collection or memory is left as it was.

import Standard/Collections
import Standard/Hosted

routine start() -> None
    huge: U64 = U64.MAX // 4 + 1

    when check BorrowedSlice[S64].construct(count: huge, manager: HEAP)
        is BorrowedSlice[S64] as memory =>
            Console.show("construct: got memory")
            drop memory
        is OutOfMemoryError => Console.show("construct: OutOfMemoryError")

    list: &List[S64] <- List[S64].construct(HEAP)
    list.add_last(1)
    when check list.reserve(capacity: huge)
        is None => Console.show("reserve: grew")
        is OutOfMemoryError => Console.show("reserve: OutOfMemoryError, still {list}")
    drop list

    values: &[S64] <- [1, 2]
    when check BorrowedSlice[S64].construct(values: values, times: U64.MAX, manager: HEAP)
        is BorrowedSlice[S64] as memory =>
            Console.show("repeat: got memory")
            drop memory
        is OutOfMemoryError => Console.show("repeat: OutOfMemoryError")
    return
