# FormatSpec padding (width, fill, alignment, zeros after the sign), the Hex / Fixed views,
# and BufWriter: output only appears at flush, and a write of 4 KiB or more goes straight through.

import Standard/Format
import Standard/Os

routine row[T](out: @BufWriter[ConsoleOutput], value: T, spec: FormatSpec) -> None
needs T: typename, Representable[T]
    out.write("[")
    represent_with_into(out, value, spec)
    out.write("]\n")
    return

routine fill_bytes(data: @Byte, count: U64) -> None
    each i in 0 til count
        data.stride(i).poke(b'y')
    then
        return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    local out: @BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    pi: B64 = 3.14159
    pi.represent_fixed_into(out, digits: 2)
    out.write("\n")
    tie: B64 = 0.125
    tie.represent_fixed_into(out, digits: 2)
    out.write("\n")
    big_val: B64 = 1e20
    big_val.represent_fixed_into(out, digits: 0)
    out.write("\n")
    neg: B64 = -0.001
    neg.represent_fixed_into(out, digits: 2)
    out.write("\n")
    tiny: B64 = 5e-324
    tiny.represent_fixed_into(out, digits: 330)
    out.write("\n")
    n: S64 = -42
    s: @[Byte] = "hé"
    row(out, value: n, spec: FormatSpec.construct(6))
    row(out, value: n, spec: FormatSpec.zero_padded(6))
    row(out, value: n, spec: FormatSpec.construct(6).with_align(Align.LEFT))
    centered: FormatSpec = FormatSpec.construct(6).with_align(Align.CENTER)
    row(out, value: s, spec: centered.with_fill("*"))
    h: Hex[U32] = Hex[U32](value: 48879)
    row(out, value: h, spec: FormatSpec.zero_padded(8))
    fx: Fixed[B64] = Fixed[B64](value: pi, digits: 3)
    row(out, value: fx, spec: FormatSpec.construct(10))
    u: U32 = U32.MAX
    row(out, value: u, spec: FormatSpec.construct(12))
    e: @[Byte] = ""
    row(out, value: e, spec: FormatSpec.construct(3).with_fill("─"))
    wide: S64 = 1234567
    row(out, value: wide, spec: FormatSpec.construct(3))
    fd.write("before flush\n")
    out.flush()
    local big: @Array[Byte, 5000] <- .hollow()
    data: @Byte = big.to[@Byte]()
    fill_bytes(data, count: 5000)
    out.write("x")
    out.write_bytes(data, count: 5000)
    out.write("\n")
    out.flush()
    return
