# BigNat.sub crashes with IntegerOverflowError when the number subtracted is larger, instead of wrapping.
# 9 - 5 works first.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and the caller's line on stdout, where the golden test sees them, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Out.write("crashed: {name} at line {place.line.peek()}\n")
    exit(3)

routine start() -> None
    local a: @BigNat[4] <- .hollow()
    local b: @BigNat[4] <- .hollow()

    five: U64 = 5
    nine: U64 = 9
    a.set(nine)
    b.set(five)
    a.sub(b)
    Out.write("9 - 5 = {a.limbs.getitem(0)}\n")
    b.set(nine)
    a.sub(b)
    Out.write("not reached {a.limbs.getitem(0)}\n")
    return
