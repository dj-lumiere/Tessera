# BigNat.sub crashes with IntegerOverflowError when the number subtracted is larger, instead of wrapping.
# 9 - 5 works first.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and the caller's line on stdout, where the golden test sees them, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("crashed: {name} at line {place.line.peek()}")
    exit(3)

routine start() -> None
    a: &BigNat[4] <- .hollow()
    b: &BigNat[4] <- .hollow()

    Crash.report_with(on_crash.to[Callable]())
    five: U64 = 5
    nine: U64 = 9
    a.set(nine)
    b.set(five)
    a.sub(b)
    Console.show("9 - 5 = {a.limbs.getitem(0)}")
    b.set(nine)
    a.sub(b)
    Console.show("not reached {a.limbs.getitem(0)}")
    return
