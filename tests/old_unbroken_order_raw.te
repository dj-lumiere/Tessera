# The memory order is a type argument: a _raw name with its order in front of _raw says the new form.

import Hosted

routine start() -> None
    count: &U64 <- 0
    found: &U64 <- 0
    swapped: Bool = count.getview().compare_exchange_unbroken_acquire_raw(expected: 0, new: 1,
        previous: found)
    Console.show("{swapped}")
    return
