// set_exit_code sets the status the program ends with when start returns: the last store wins, exit_code reads it
// back, and a routine named main is an ordinary routine.

import Standard::Format
import Standard::Os

/// An ordinary routine that happens to be named main.
routine main() -> S32
    block entry()
        return(40)

routine start() -> Void
    block entry()
        Out.write("before: {exit_code()}\n")
        set_exit_code(7)
        set_exit_code(main().add(2))
        Out.write("after: {exit_code()}\n")
        return()
