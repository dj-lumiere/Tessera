# A program's own type named Unit is that type: the hint that the type with one value is None is for a Unit nobody
# declared.
import Hosted

choice Unit: U8
    YEAR
    MONTH

### The number of the unit.
### :param unit: The unit.
### :returns: Its number.
routine number_of(unit: Unit) -> S64
    when unit
        Unit.YEAR => return 1
        Unit.MONTH => return 2

Console.show("{number_of(Unit.MONTH)} {number_of(Unit.YEAR)}")
