# A `throw` arm in a value `when` of a routine that isn't failable stops the program on the throw's line.

import Standard/Hosted

crashable BadCodeError
    code: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadCodeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("bad code {me.code}")
    return

### Doubles the value code 1 stands for.
### :param n: The code.
### :returns: Twice the value.
routine pick(n: S64) -> S64
    value: S64 = when n
        1 => 10
        else => throw BadCodeError(code: n)
    return value * 2

### Calls it with a good code, then a bad one.
routine start() -> None
    Console.show("{pick(n: 1)}")
    Console.show("{pick(n: 2)}")
    return
