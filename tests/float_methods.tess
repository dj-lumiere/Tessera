            %top.ne(0) -> three(%top.to_i64(), %mid, %low)
            %mid.ne(0) -> two(%mid, %low)
            _ -> one(%low)

    block one(%low: I64):
        c_printf("%s %s%llu\n", #label, sign_text(%v.slt(0)), %low)
        return()

    block two(%mid: I64, %low: I64):
