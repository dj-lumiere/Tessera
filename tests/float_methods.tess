routine c_printf(#fmt: Ptr<I8>) -> CInt

routine show_f(#label: Ptr<I8>, %v: F64) -> Void
    block entry():
        %nan: Bool = %v.is_nan()
        branch %nan ? nan() : number()

    block nan():
        c_printf("%s NaN\n", #label)
        return()

    block number():
        c_printf("%s %.17g\n", #label, %v)
        return()

routine show_f6(#label: Ptr<I8>, %v: F64) -> Void
