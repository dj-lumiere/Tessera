# A frame slot's address in a local entity's field, which the entity's destruct moves into a global.

import Hosted

lateinit global KEPT: &@S64

### Holds an address.
entity Q
    held: @S64

### Makes one holding nothing.
### :returns: The holder.
common routine Q.construct() -> Me
    return Me(held: dangling[S64]())

### Puts what it holds into the global.
routine @Q.destruct() -> None
    p: @S64 = me.held.peek()
    KEPT.poke(p)
    return

### The local lives in this frame, the holder too.
routine fill() -> None
    l: &S64 <- 1234567
    q: &Q <- .construct()

    q.held.poke(l)
    drop q
    return

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    for i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    for j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    fill()
    s: S64 = scribble(seed: 6666666)
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
