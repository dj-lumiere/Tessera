// run_process_result and run_shell_result report an allocator that fails as OutOfMemory: one that gives nothing (the
// run can't even build its command line, which Windows used to report as InvalidArgument), and one that can't grow a
// capture past its first block, which used to hand back the first part of the output as if that were all. The same
// command with the default heap captures everything. The command prints 200 lines of 48 x's, over several reads.

import Standard/Alloc
import Standard/Format
import Standard/Os

/// The bytes the command prints at least (200 lines of 48 x's and a line ending).
preset LONG_COUNT: USize = 9800

/// An allocator call that always fails.
/// :param state: Unused.
/// :param size: Unused.
/// :returns: Null.
routine refuse_alloc(state: Addr, size: USize, align: USize) -> Addr
    return null

/// A reallocation that always fails, leaving the block as it was.
/// :param state: Unused.
/// :param old: Unused.
/// :param size: Unused.
/// :returns: Null.
routine refuse_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    return null

/// The C heap's allocation, for an allocator that only refuses to grow.
/// :param state: Unused.
/// :param size: The size in bytes.
/// :returns: The block, or null.
routine heap_alloc(state: Addr, size: USize, align: USize) -> Addr
    heap: MemoryManager = make_c_heap_memory()
    fn: Callable[(Addr, USize, USize), Addr] = heap.alloc_fn
    return fn.call(heap.state, size, align)

/// The C heap's free.
/// :param state: Unused.
/// :param ptr: The block.
routine heap_free(state: Addr, ptr: Addr) -> None
    heap: MemoryManager = make_c_heap_memory()
    fn: Callable[(Addr, Addr), None] = heap.free_fn
    fn.call(heap.state, ptr)
    return

/// The command that prints the 200 lines, through cmd.exe.
/// :returns: The command line.
@target(os: "windows")
routine long_echo() -> Span[Byte]
    return "for /L %i in (1,1,200) do @echo xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

/// The command that prints the 200 lines, through sh.
/// :returns: The command line.
@target(os: ("linux", "macos"))
routine long_echo() -> Span[Byte]
    return "i=0; while [ $i -lt 200 ]; do echo xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx; i=$((i+1)); done"

/// The name of a run's failure.
/// :param e: The failure.
/// :returns: Its name.
routine error_name(e: ProcessError) -> Span[Byte]
    when e
        ProcessError.NOT_FOUND => return "NotFound"
        ProcessError.PERMISSION_DENIED => return "PermissionDenied"
        ProcessError.INVALID_ARGUMENT => return "InvalidArgument"
        ProcessError.OUT_OF_MEMORY => return "OutOfMemory"
        ProcessError.OTHER => return "Other"

/// Runs the long echo with `alloc` and says how it went.
/// :param label: What the allocator is.
/// :param alloc: The allocator for the run.
routine run(label: Span[Byte], alloc: @MemoryManager) -> None
    r: Result[ProcessOutput, ProcessError] = run_shell_result(command: long_echo(), options: ProcessOptions.default(), alloc)
    when r
        is ProcessOutput as output =>
            local held: @ProcessOutput <- output
            whole: Bool = held.stdout.peek().count() >= LONG_COUNT
            Out.write("{label}: captured all of it {whole}\n")
            drop held
            return
        is ProcessError as e =>
            Out.write("{label}: {error_name(e)}\n")
            return

routine start() -> None
    local nothing: @MemoryManager <- (alloc_fn: refuse_alloc.to[Callable](), realloc_fn: refuse_realloc.to[Callable](), free_fn: heap_free.to[Callable](), reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: null)
    local no_grow: @MemoryManager <- (alloc_fn: heap_alloc.to[Callable](), realloc_fn: refuse_realloc.to[Callable](), free_fn: heap_free.to[Callable](), reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: null)

    run(label: "an allocator that gives nothing", alloc: nothing)
    run(label: "an allocator that can't grow a capture", alloc: no_grow)
    run(label: "the default heap", alloc: DEFAULT_HEAP)
    return
