; Formats %x into a stack buffer, parses it back, and prints the bits.
routine round_trip(#out: Ptr<FdWriter>, %x: F128) -> Void
    block entry():
        #buf:    Ptr<Array<I8, 128>> = alloca<Array<I8, 128>>
        %writer: SliceWriter         = SliceWriter.new(#buf.cast<I8>(), 128)
        #text:   Ptr<SliceWriter>    = alloca<SliceWriter>([%writer])
        %x.format(#text)
        %s:      String = #text.as_string()
        %parsed: Result<F128, ParseFloatError> = F128.parse(%s)
        %back:   F128 = %parsed.value
        %back.bits.format_hex(#out)
        write_line(#out)
        return()
