routine parse_line(#out: Ptr<FdWriter>, %text: String) -> Void
    block entry():
        %parsed: Result<F128, ParseFloatError> = F128.parse(%text)
        %value:  F128 = %parsed.value
        %value.bits.format_hex(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        jump loop(0, #out)

    block loop(%i: I64, #out: Ptr<FdWriter>):
        %done: Bool = %i.sge(72)
        branch %done ? strings(#out) : one(%i, #out)

    block one(%i: I64, #out: Ptr<FdWriter>):
        %bits: I128 := F128_VALUES[%i]
        %x: F128 = F128.from_bits(%bits)
        %x.format(#out)
        write_str(#out, " ")
        round_trip(#out, %x)
        jump loop(%i.add(1), #out)

