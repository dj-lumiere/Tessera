# A type argument may be a buildtime integer expression, and so may a preset: the operators are the routines they stand
# for, as in a body. `(BITS + 7) // 8` bytes hold BITS bits.

import Hosted

preset BITS_PER_WORD: U64 = 8 * 8
preset WORDS: U64 = (100 + BITS_PER_WORD - 1) // BITS_PER_WORD

### BITS bits packed into bytes.
record Packed[BITS]
needs U64 BITS
    bytes: Items[Byte, (BITS + 7) // 8]

### How many bytes hold the bits.
### :returns: The byte count.
common routine Packed[BITS].byte_count() -> U64
needs U64 BITS
    return Items[Byte, (BITS + 7) // 8].count()

### Shows the sizes.
routine start() -> None
    p: Packed[20] = Packed[20](bytes: [0x01, 0x02, 0x03])
    Console.show("{WORDS} {Packed[20].byte_count()} {Packed[64].byte_count()} {Packed[65].byte_count()}")
    Console.show("{sizeof[Packed[9]]()} {sizeof[Items[U16, 2 * 3]]()} {p.bytes.getitem(2).to[U8]()}")
    return
