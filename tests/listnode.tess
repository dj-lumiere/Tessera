// Tessera doubly-linked list
//
// Generic doubly-linked list with O(1) push/pop at both ends.
// Nodes are heap-allocated via an explicit MemoryManager.
//
// Layout:
//   ListNode[T]    heap node — value, prev, next
//   LinkedList[T]  list head — head ptr, tail ptr, count
//
// Operations:
//   push_front / push_back   O(1) insert
//   pop_front  / pop_back    O(1) remove, returns Maybe[T]
//   peek_front / peek_back   O(1) read-only, returns Maybe[T]
//   count / is_empty         O(1)
//   iter                     forward iterator (head → tail)
//   free                     frees all nodes

import Standard/Alloc
import Standard/Format
import Standard/Os

// ── Node ──────────────────────────────────────────────────────────────────────

record ListNode[T]
require T: typename
    value: T
    prev: @ListNode[T]
    next: @ListNode[T]

/// Makes a `ListNode` from its fields.
/// :param value: Its `value`.
/// :param prev: Its `prev`.
/// :param next: Its `next`.
/// :returns: The new value.
routine ListNode[T].construct(value: T, prev: @Me, next: @Me) -> Me
require T: typename
    return(Me(value, prev, next))

/// Releases nothing: a `ListNode` holds no memory of its own.
routine ListNode[T].destruct(me: @Me) -> Void
require T: typename
    return()

// ── List ──────────────────────────────────────────────────────────────────────

record LinkedList[T]
require T: typename
    head: @ListNode[T]
    tail: @ListNode[T]
    count: S64

// ── Iterator ──────────────────────────────────────────────────────────────────

record LinkedListIter[T]
require T: typename
    current: @ListNode[T]

/// Makes a `LinkedListIter` from its fields.
/// :param current: Its `current`.
/// :returns: The new value.
routine LinkedListIter[T].construct(current: @ListNode[T]) -> Me
require T: typename
    return(Me(current))

/// Releases nothing: a `LinkedListIter` holds no memory of its own.
routine LinkedListIter[T].destruct(me: @Me) -> Void
require T: typename
    return()

// ── Construction ──────────────────────────────────────────────────────────────

routine LinkedList[T].construct() -> Me
    list: Me = Me(head: null, tail: null, count: 0)
    return(list)

// ── Queries ───────────────────────────────────────────────────────────────────

routine LinkedList[T].count(me: @Me) -> S64
    len: S64 = me.count.peek()
    return(len)

routine LinkedList[T].is_empty(me: @Me) -> Bool
    len: S64 = me.count.peek()
    empty: Bool = len.eq(0)
    return(empty)

routine LinkedList[T].peek_front(me: @Me) -> Maybe[T]
    local head: @ListNode[T] = me.head.peek()

    empty: Bool = head.is_null()
    branch empty
        ? return_none()
        : return_val()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block return_val()
        val: T = head.value.peek()
        some: Maybe[T] = val
        return(some)

routine LinkedList[T].peek_back(me: @Me) -> Maybe[T]
    local tail: @ListNode[T] = me.tail.peek()

    empty: Bool = tail.is_null()
    branch empty
        ? return_none()
        : return_val()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block return_val()
        val: T = tail.value.peek()
        some: Maybe[T] = val
        return(some)

// ── Insert ────────────────────────────────────────────────────────────────────

routine LinkedList[T].add_first(me: @Me, val: T, alloc: @MemoryManager) -> Void
    local node: @ListNode[T] = allocate[ListNode[T]](count: 1, alloc)

    alloc_failed: Bool = node.is_null()
    branch alloc_failed
        ? crash_allocation()
        : continue
    node.value.poke(val)
    node.prev.poke(null)
    head: @ListNode[T] = me.head.peek()
    node.next.poke(head)
    was_empty: Bool = head.is_null()
    branch was_empty
        ? set_tail()
        : link_old_head(head)

    block set_tail()
        me.tail.poke(node)
        jump finish()

    block link_old_head(head: @ListNode[T])
        head.prev.poke(node)
        jump finish()

    block finish()
        me.head.poke(node)
        next_count: S64 = me.count.peek().add(1)
        next_count.poke_into(me.count)
        return()

routine LinkedList[T].add_last(me: @Me, val: T, alloc: @MemoryManager) -> Void
    local node: @ListNode[T] = allocate[ListNode[T]](count: 1, alloc)

    alloc_failed: Bool = node.is_null()
    branch alloc_failed
        ? crash_allocation()
        : continue
    node.value.poke(val)
    node.next.poke(null)
    tail: @ListNode[T] = me.tail.peek()
    node.prev.poke(tail)
    was_empty: Bool = tail.is_null()
    branch was_empty
        ? set_head()
        : link_old_tail(tail)

    block set_head()
        me.head.poke(node)
        jump finish()

    block link_old_tail(tail: @ListNode[T])
        tail.next.poke(node)
        jump finish()

    block finish()
        me.tail.poke(node)
        next_count: S64 = me.count.peek().add(1)
        next_count.poke_into(me.count)
        return()

// ── Remove ────────────────────────────────────────────────────────────────────

routine LinkedList[T].remove_first(me: @Me, alloc: @MemoryManager) -> Maybe[T]
    local head: @ListNode[T] = me.head.peek()

    empty: Bool = head.is_null()
    branch empty
        ? return_none()
        : extract()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block extract()
        val: T = head.value.peek()
        next: @ListNode[T] = head.next.peek()
        me.head.poke(next)
        new_empty: Bool = next.is_null()
        branch new_empty
            ? clear_tail(val)
            : unlink_next(next, val)

    block clear_tail(val: T)
        me.tail.poke(null)
        jump unlink(val)

    block unlink_next(next: @ListNode[T], val: T)
        next.prev.poke(null)
        jump unlink(val)

    block unlink(val: T)
        next_count: S64 = me.count.peek().sub(1)
        next_count.poke_into(me.count)
        deallocate(data: head, alloc)
        some: Maybe[T] = val
        return(some)

routine LinkedList[T].remove_last(me: @Me, alloc: @MemoryManager) -> Maybe[T]
    local tail: @ListNode[T] = me.tail.peek()

    empty: Bool = tail.is_null()
    branch empty
        ? return_none()
        : extract()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block extract()
        val: T = tail.value.peek()
        prev: @ListNode[T] = tail.prev.peek()
        me.tail.poke(prev)
        new_empty: Bool = prev.is_null()
        branch new_empty
            ? clear_head(val)
            : unlink_prev(prev, val)

    block clear_head(val: T)
        me.head.poke(null)
        jump unlink(val)

    block unlink_prev(prev: @ListNode[T], val: T)
        prev.next.poke(null)
        jump unlink(val)

    block unlink(val: T)
        next_count: S64 = me.count.peek().sub(1)
        next_count.poke_into(me.count)
        deallocate(data: tail, alloc)
        some: Maybe[T] = val
        return(some)

// ── Iterator ──────────────────────────────────────────────────────────────────

routine LinkedList[T].iter(me: @Me) -> LinkedListIter[T]
    head: @ListNode[T] = me.head.peek()
    iter: LinkedListIter[T] = LinkedListIter[T](current: head)
    return(iter)

/// satisfies Iterator[T, LinkedListIter[T]]
routine LinkedListIter[T].emit_checked(me: @Me) -> Maybe[T]
    local cur: @ListNode[T] = me.current.peek()

    done: Bool = cur.is_null()
    branch done
        ? return_none()
        : return_val()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block return_val()
        val: T = cur.value.peek()
        next: @ListNode[T] = cur.next.peek()
        me.current.poke(next)
        some: Maybe[T] = val
        return(some)

// ── Free ──────────────────────────────────────────────────────────────────────

routine LinkedList[T].destruct(me: @Me, alloc: @MemoryManager) -> Void
    cur: @ListNode[T] = me.head.peek()
    jump loop(cur)

    block loop(cur: @ListNode[T])
        done: Bool = cur.is_null()
        branch done
            ? reset()
            : free_node(cur)

    block free_node(cur: @ListNode[T])
        next: @ListNode[T] = cur.next.peek()
        deallocate(data: cur, alloc)
        jump loop(next)

    block reset()
        me.head.poke(null)
        me.tail.poke(null)
        me.count.poke(0)
        return()

// ── Demo ──────────────────────────────────────────────────────────────────────

routine print_list(out: @BufWriter[Out], list: @LinkedList[S64]) -> Void
    local iter: @LinkedListIter[S64] <- .hollow()

    out.write("list [")
    iter.poke(list.iter())
    jump next(true)

    block next(first: Bool)
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as value => continue
            is Unit => finish()
        branch first
            ? show_item(value)
            : separate(value)

    block separate(value: S64)
        out.write(", ")
        jump show_item(value)

    block show_item(value: S64)
        value.represent_into(out)
        jump next(false)

    block finish()
        out.write("] length {list.count()}\n")
        return()

/// Prints "<label> <value>" when the value is present, "<label> none" when it's absent.
routine print_option(out: @BufWriter[Out], label: Span[Byte], item: Maybe[S64]) -> Void
    out.write("{label} ")
    when item
        is S64 as value => present(value)
        is Unit => absent()

    block present(value: S64)
        out.write("{value}\n")
        return()

    block absent()
        out.write("none\n")
        return()

routine start() -> Void
    fd: @Out = Out.writer()
    claim out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    claim alloc: @MemoryManager <- make_heap_memory()
    claim list: @LinkedList[S64] <- .construct()

    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    list.add_last(val: 1, alloc)
    list.add_last(val: 2, alloc)
    list.add_last(val: 3, alloc)
    list.add_first(val: 0, alloc)
    list.add_first(val: -1, alloc)
    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    print_option(out, label: "peek_back", item: list.peek_back())
    print_option(out, label: "pop_front", item: list.remove_first(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_list(out, list)
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_list(out, list)
    list.add_first(val: 7, alloc)
    print_option(out, label: "peek_back", item: list.peek_back())
    list.add_last(val: 8, alloc)
    print_list(out, list)
    list.destruct(alloc)
    print_list(out, list)
    out.flush()
    return()
