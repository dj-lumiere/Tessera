// Tessera doubly-linked list
//
// Generic doubly-linked list with O(1) push/pop at both ends.
// Nodes are heap-allocated via an explicit Allocator.
//
// Layout:
//   ListNode<T>    heap node — value, prev, next
//   LinkedList<T>  list head — head ptr, tail ptr, length
//
// Operations:
//   push_front / push_back   O(1) insert
//   pop_front  / pop_back    O(1) remove, returns Option<T>
//   peek_front / peek_back   O(1) read-only, returns Option<T>
//   length / is_empty        O(1)
//   iter                     forward iterator (head → tail)
//   free                     frees all nodes

import Standard::Alloc
import Standard::Format
import Standard::Os

// ── Node ──────────────────────────────────────────────────────────────────────

record ListNode<T>
require T: typename
    value : T
    prev  : @ListNode<T>
    next  : @ListNode<T>

// ── List ──────────────────────────────────────────────────────────────────────

record LinkedList<T>
require T: typename
    head   : @ListNode<T>
    tail   : @ListNode<T>
    length : S64

// ── Iterator ──────────────────────────────────────────────────────────────────

record LinkedListIter<T>
require T: typename
    current : @ListNode<T>

// ── Construction ──────────────────────────────────────────────────────────────

routine LinkedList<T>.construct() -> Self
    block entry():
        %list : Self = Self { head: null, tail: null, length: 0 }
        return(%list)

// ── Queries ───────────────────────────────────────────────────────────────────

routine LinkedList<T>.length(%self: @Self) -> S64
    block entry():
        %len : S64 = %self.length.load()
        return(%len)

routine LinkedList<T>.is_empty(%self: @Self) -> Bool
    block entry():
        %len   : S64  = %self.length.load()
        %empty : Bool = %len.eq(0)
        return(%empty)

routine LinkedList<T>.peek_front(%self: @Self) -> Option<T>
    block entry():
        %head  : @ListNode<T> = %self.head.load()
        %empty : Bool         = %head.is_null()
        branch %empty ? return_none() : return_val(%head)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block return_val(%head: @ListNode<T>):
        %val  : T         = %head.value.load()
        %some : Option<T> = .Present(%val)
        return(%some)

routine LinkedList<T>.peek_back(%self: @Self) -> Option<T>
    block entry():
        %tail  : @ListNode<T> = %self.tail.load()
        %empty : Bool         = %tail.is_null()
        branch %empty ? return_none() : return_val(%tail)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block return_val(%tail: @ListNode<T>):
        %val  : T         = %tail.value.load()
        %some : Option<T> = .Present(%val)
        return(%some)

// ── Insert ────────────────────────────────────────────────────────────────────

routine LinkedList<T>.push_front(%self: @Self, %val: T, %alloc: @Allocator) -> Void
    block entry():
        %node         : @ListNode<T> = allocate<ListNode<T>>(%alloc, 1)
        %alloc_failed : Bool         = %node.is_null()
        branch %alloc_failed ? panic(TrapCode.AllocFailed) : continue
        %node.value.store(%val)
        %node.prev.store(null)
        %head : @ListNode<T> = %self.head.load()
        %node.next.store(%head)
        %was_empty : Bool = %head.is_null()
        branch %was_empty ? set_tail(%node) : link_old_head(%node, %head)

    block set_tail(%node: @ListNode<T>):
        %self.tail.store(%node)
        jump finish(%node)

    block link_old_head(%node: @ListNode<T>, %head: @ListNode<T>):
        %head.prev.store(%node)
        jump finish(%node)

    block finish(%node: @ListNode<T>):
        %self.head.store(%node)
        %self.length.load().add(1).store_into(%self.length)
        return()

routine LinkedList<T>.push_back(%self: @Self, %val: T, %alloc: @Allocator) -> Void
    block entry():
        %node         : @ListNode<T> = allocate<ListNode<T>>(%alloc, 1)
        %alloc_failed : Bool         = %node.is_null()
        branch %alloc_failed ? panic(TrapCode.AllocFailed) : continue
        %node.value.store(%val)
        %node.next.store(null)
        %tail : @ListNode<T> = %self.tail.load()
        %node.prev.store(%tail)
        %was_empty : Bool = %tail.is_null()
        branch %was_empty ? set_head(%node) : link_old_tail(%node, %tail)

    block set_head(%node: @ListNode<T>):
        %self.head.store(%node)
        jump finish(%node)

    block link_old_tail(%node: @ListNode<T>, %tail: @ListNode<T>):
        %tail.next.store(%node)
        jump finish(%node)

    block finish(%node: @ListNode<T>):
        %self.tail.store(%node)
        %self.length.load().add(1).store_into(%self.length)
        return()

// ── Remove ────────────────────────────────────────────────────────────────────

routine LinkedList<T>.pop_front(%self: @Self, %alloc: @Allocator) -> Option<T>
    block entry():
        %head  : @ListNode<T> = %self.head.load()
        %empty : Bool         = %head.is_null()
        branch %empty ? return_none() : extract(%head)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block extract(%head: @ListNode<T>):
        %val  : T            = %head.value.load()
        %next : @ListNode<T> = %head.next.load()
        %self.head.store(%next)
        %new_empty : Bool = %next.is_null()
        branch %new_empty ? clear_tail(%head, %val) : unlink_next(%next, %head, %val)

    block clear_tail(%head: @ListNode<T>, %val: T):
        %self.tail.store(null)
        jump finish(%head, %val)

    block unlink_next(%next: @ListNode<T>, %head: @ListNode<T>, %val: T):
        %next.prev.store(null)
        jump finish(%head, %val)

    block finish(%head: @ListNode<T>, %val: T):
        %self.length.load().sub(1).store_into(%self.length)
        %head.free(%alloc)
        %some : Option<T> = .Present(%val)
        return(%some)

routine LinkedList<T>.pop_back(%self: @Self, %alloc: @Allocator) -> Option<T>
    block entry():
        %tail  : @ListNode<T> = %self.tail.load()
        %empty : Bool         = %tail.is_null()
        branch %empty ? return_none() : extract(%tail)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block extract(%tail: @ListNode<T>):
        %val  : T            = %tail.value.load()
        %prev : @ListNode<T> = %tail.prev.load()
        %self.tail.store(%prev)
        %new_empty : Bool = %prev.is_null()
        branch %new_empty ? clear_head(%tail, %val) : unlink_prev(%prev, %tail, %val)

    block clear_head(%tail: @ListNode<T>, %val: T):
        %self.head.store(null)
        jump finish(%tail, %val)

    block unlink_prev(%prev: @ListNode<T>, %tail: @ListNode<T>, %val: T):
        %prev.next.store(null)
        jump finish(%tail, %val)

    block finish(%tail: @ListNode<T>, %val: T):
        %self.length.load().sub(1).store_into(%self.length)
        %tail.free(%alloc)
        %some : Option<T> = .Present(%val)
        return(%some)

// ── Iterator ──────────────────────────────────────────────────────────────────

routine LinkedList<T>.iter(%self: @Self) -> LinkedListIter<T>
    block entry():
        %head : @ListNode<T>      = %self.head.load()
        %iter : LinkedListIter<T> = LinkedListIter<T> { current: %head }
        return(%iter)

/// satisfies Iterator<T, LinkedListIter<T>>
routine LinkedListIter<T>.next(%self: @Self) -> Option<T>
    block entry():
        %cur  : @ListNode<T> = %self.current.load()
        %done : Bool         = %cur.is_null()
        branch %done ? return_none() : return_val(%cur)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block return_val(%cur: @ListNode<T>):
        %val  : T            = %cur.value.load()
        %next : @ListNode<T> = %cur.next.load()
        %self.current.store(%next)
        %some : Option<T> = .Present(%val)
        return(%some)

// ── Free ──────────────────────────────────────────────────────────────────────

routine LinkedList<T>.destruct(%self: @Self, %alloc: @Allocator) -> Void
    block entry():
        %cur : @ListNode<T> = %self.head.load()
        jump loop(%cur)

    block loop(%cur: @ListNode<T>):
        %done : Bool = %cur.is_null()
        branch %done ? reset() : free_node(%cur)

    block free_node(%cur: @ListNode<T>):
        %next : @ListNode<T> = %cur.next.load()
        %cur.free(%alloc)
        jump loop(%next)

    block reset():
        %self.head.store(null)
        %self.tail.store(null)
        %self.length.store(0)
        return()

// ── Demo ──────────────────────────────────────────────────────────────────────

routine print_list(%out: @BufWriter<FdWriter>, %list: @LinkedList<S64>) -> Void
    block entry():
        write(%out, "list [")
        claim %iter : @LinkedListIter<S64> <- %list.iter()
        jump next(%iter, true)

    block next(%iter: @LinkedListIter<S64>, %first: Bool):
        %item : Option<S64> = %iter.next()
        when %item:
            .Present(%value) -> item(%iter, %first, %value)
            .Absent          -> finish()

    block item(%iter: @LinkedListIter<S64>, %first: Bool, %value: S64):
        branch %first ? show_item(%iter, %value) : separate(%iter, %value)

    block separate(%iter: @LinkedListIter<S64>, %value: S64):
        write(%out, ", ")
        jump show_item(%iter, %value)

    block show_item(%iter: @LinkedListIter<S64>, %value: S64):
        %value.represent(%out)
        jump next(%iter, false)

    block finish():
        write(%out, "] length {%list.length()}\n")
        return()

/// Prints "<label> <value>" when the value is present, "<label> none" when it's absent.
routine print_option(%out: @BufWriter<FdWriter>, %label: Bytes, %item: Option<S64>) -> Void
    block entry():
        write(%out, "{%label} ")
        when %item:
            .Present(%value) -> present(%value)
            .Absent          -> absent()

    block present(%value: S64):
        write(%out, "{%value}\n")
        return()

    block absent():
        write(%out, "none\n")
        return()

routine main() -> S32
    block entry():
        claim %fd  : @FdWriter            <- .stdout()
        claim %out : @BufWriter<FdWriter> <- uninit
        %out.construct(%fd)
        claim %alloc : @Allocator       <- make_heap_allocator()
        claim %list  : @LinkedList<S64> <- .construct()

        print_list(%out, %list)
        print_option(%out, "peek_front", %list.peek_front())
        %list.push_back(1, %alloc)
        %list.push_back(2, %alloc)
        %list.push_back(3, %alloc)
        %list.push_front(0, %alloc)
        %list.push_front(-1, %alloc)
        print_list(%out, %list)
        print_option(%out, "peek_front", %list.peek_front())
        print_option(%out, "peek_back", %list.peek_back())
        print_option(%out, "pop_front", %list.pop_front(%alloc))
        print_option(%out, "pop_back", %list.pop_back(%alloc))
        print_list(%out, %list)
        print_option(%out, "pop_back", %list.pop_back(%alloc))
        print_option(%out, "pop_back", %list.pop_back(%alloc))
        print_option(%out, "pop_back", %list.pop_back(%alloc))
        print_option(%out, "pop_back", %list.pop_back(%alloc))
        print_list(%out, %list)
        %list.push_front(7, %alloc)
        print_option(%out, "peek_back", %list.peek_back())
        %list.push_back(8, %alloc)
        print_list(%out, %list)
        %list.destruct(%alloc)
        print_list(%out, %list)
        %out.flush()
        return(0)
