// Tessera doubly-linked list
//
// Generic doubly-linked list with O(1) push/pop at both ends.
// Nodes are heap-allocated via an explicit Allocator.
//
// Layout:
//   ListNode<T>    heap node — value, prev, next
//   LinkedList<T>  list head — head ptr, tail ptr, count
//
// Operations:
//   push_front / push_back   O(1) insert
//   pop_front  / pop_back    O(1) remove, returns Option<T>
//   peek_front / peek_back   O(1) read-only, returns Option<T>
//   count / is_empty         O(1)
//   iter                     forward iterator (head → tail)
//   free                     frees all nodes

import Standard::Alloc
import Standard::Format
import Standard::Os

// ── Node ──────────────────────────────────────────────────────────────────────

record ListNode<T>
require T: typename
    value : T
    prev  : @ListNode<T>
    next  : @ListNode<T>

// ── List ──────────────────────────────────────────────────────────────────────

record LinkedList<T>
require T: typename
    head  : @ListNode<T>
    tail  : @ListNode<T>
    count : S64

// ── Iterator ──────────────────────────────────────────────────────────────────

record LinkedListIter<T>
require T: typename
    current : @ListNode<T>

// ── Construction ──────────────────────────────────────────────────────────────

routine LinkedList<T>.construct() -> Self
    block entry()
        list : Self = Self { head: null, tail: null, count: 0 }
        return(list)

// ── Queries ───────────────────────────────────────────────────────────────────

routine LinkedList<T>.count(self: @Self) -> S64
    block entry()
        len : S64 = self.count.load()
        return(len)

routine LinkedList<T>.is_empty(self: @Self) -> Bool
    block entry()
        len   : S64  = self.count.load()
        empty : Bool = len.eq(0)
        return(empty)

routine LinkedList<T>.peek_front(self: @Self) -> Option<T>
    shared head : @ListNode<T> = self.head.load()

    block entry()
        empty : Bool = head.is_null()
        branch empty
            ? return_none()
            : return_val()

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block return_val()
        val  : T         = head.value.load()
        some : Option<T> = .Present(val)
        return(some)

routine LinkedList<T>.peek_back(self: @Self) -> Option<T>
    shared tail : @ListNode<T> = self.tail.load()

    block entry()
        empty : Bool = tail.is_null()
        branch empty
            ? return_none()
            : return_val()

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block return_val()
        val  : T         = tail.value.load()
        some : Option<T> = .Present(val)
        return(some)

// ── Insert ────────────────────────────────────────────────────────────────────

routine LinkedList<T>.push_front(self: @Self, val: T, alloc: @Allocator) -> Void
    shared node : @ListNode<T> = allocate<ListNode<T>>(1, alloc)

    block entry()
        alloc_failed : Bool = node.is_null()
        branch alloc_failed
            ? crash_allocation()
            : continue
        node.value.store(val)
        node.prev.store(null)
        head : @ListNode<T> = self.head.load()
        node.next.store(head)
        was_empty : Bool = head.is_null()
        branch was_empty
            ? set_tail()
            : link_old_head(head)

    block set_tail()
        self.tail.store(node)
        jump finish()

    block link_old_head(head: @ListNode<T>)
        head.prev.store(node)
        jump finish()

    block finish()
        self.head.store(node)
        next_count : S64 = self.count.load().add(1)
        next_count.store_into(self.count)
        return()

routine LinkedList<T>.push_back(self: @Self, val: T, alloc: @Allocator) -> Void
    shared node : @ListNode<T> = allocate<ListNode<T>>(1, alloc)

    block entry()
        alloc_failed : Bool = node.is_null()
        branch alloc_failed
            ? crash_allocation()
            : continue
        node.value.store(val)
        node.next.store(null)
        tail : @ListNode<T> = self.tail.load()
        node.prev.store(tail)
        was_empty : Bool = tail.is_null()
        branch was_empty
            ? set_head()
            : link_old_tail(tail)

    block set_head()
        self.head.store(node)
        jump finish()

    block link_old_tail(tail: @ListNode<T>)
        tail.next.store(node)
        jump finish()

    block finish()
        self.tail.store(node)
        next_count : S64 = self.count.load().add(1)
        next_count.store_into(self.count)
        return()

// ── Remove ────────────────────────────────────────────────────────────────────

routine LinkedList<T>.pop_front(self: @Self, alloc: @Allocator) -> Option<T>
    shared head : @ListNode<T> = self.head.load()

    block entry()
        empty : Bool = head.is_null()
        branch empty
            ? return_none()
            : extract()

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block extract()
        val  : T            = head.value.load()
        next : @ListNode<T> = head.next.load()
        self.head.store(next)
        new_empty : Bool = next.is_null()
        branch new_empty
            ? clear_tail(val)
            : unlink_next(next, val)

    block clear_tail(val: T)
        self.tail.store(null)
        jump unlink(val)

    block unlink_next(next: @ListNode<T>, val: T)
        next.prev.store(null)
        jump unlink(val)

    block unlink(val: T)
        next_count : S64 = self.count.load().sub(1)
        next_count.store_into(self.count)
        deallocate(head, alloc)
        some : Option<T> = .Present(val)
        return(some)

routine LinkedList<T>.pop_back(self: @Self, alloc: @Allocator) -> Option<T>
    shared tail : @ListNode<T> = self.tail.load()

    block entry()
        empty : Bool = tail.is_null()
        branch empty
            ? return_none()
            : extract()

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block extract()
        val  : T            = tail.value.load()
        prev : @ListNode<T> = tail.prev.load()
        self.tail.store(prev)
        new_empty : Bool = prev.is_null()
        branch new_empty
            ? clear_head(val)
            : unlink_prev(prev, val)

    block clear_head(val: T)
        self.head.store(null)
        jump unlink(val)

    block unlink_prev(prev: @ListNode<T>, val: T)
        prev.next.store(null)
        jump unlink(val)

    block unlink(val: T)
        next_count : S64 = self.count.load().sub(1)
        next_count.store_into(self.count)
        deallocate(tail, alloc)
        some : Option<T> = .Present(val)
        return(some)

// ── Iterator ──────────────────────────────────────────────────────────────────

routine LinkedList<T>.iter(self: @Self) -> LinkedListIter<T>
    block entry()
        head : @ListNode<T>      = self.head.load()
        iter : LinkedListIter<T> = LinkedListIter<T> { current: head }
        return(iter)

/// satisfies Iterator<T, LinkedListIter<T>>
routine LinkedListIter<T>.next(self: @Self) -> Option<T>
    shared cur : @ListNode<T> = self.current.load()

    block entry()
        done : Bool = cur.is_null()
        branch done
            ? return_none()
            : return_val()

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block return_val()
        val  : T            = cur.value.load()
        next : @ListNode<T> = cur.next.load()
        self.current.store(next)
        some : Option<T> = .Present(val)
        return(some)

// ── Free ──────────────────────────────────────────────────────────────────────

routine LinkedList<T>.destruct(self: @Self, alloc: @Allocator) -> Void
    block entry()
        cur : @ListNode<T> = self.head.load()
        jump loop(cur)

    block loop(cur: @ListNode<T>)
        done : Bool = cur.is_null()
        branch done
            ? reset()
            : free_node(cur)

    block free_node(cur: @ListNode<T>)
        next : @ListNode<T> = cur.next.load()
        deallocate(cur, alloc)
        jump loop(next)

    block reset()
        self.head.store(null)
        self.tail.store(null)
        self.count.store(0)
        return()

// ── Demo ──────────────────────────────────────────────────────────────────────

routine print_list(out: @BufWriter<Out>, list: @LinkedList<S64>) -> Void
    shared iter : @LinkedListIter<S64> <- uninit

    block entry()
        out.write("list [")
        iter.store(list.iter())
        jump next(true)

    block next(first: Bool)
        item : Option<S64> = iter.next()
        when item
            .Present(value) -> continue
            .Absent         -> finish()
        branch first
            ? show_item(value)
            : separate(value)

    block separate(value: S64)
        out.write(", ")
        jump show_item(value)

    block show_item(value: S64)
        value.represent_into(out)
        jump next(false)

    block finish()
        out.write("] length {list.count()}\n")
        return()

/// Prints "<label> <value>" when the value is present, "<label> none" when it's absent.
routine print_option(out: @BufWriter<Out>, label: Bytes, item: Option<S64>) -> Void
    block entry()
        out.write("{label} ")
        when item
            .Present(value) -> present(value)
            .Absent         -> absent()

    block present(value: S64)
        out.write("{value}\n")
        return()

    block absent()
        out.write("none\n")
        return()

routine start() -> Void
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc : @Allocator       <- make_heap_allocator()
        claim list  : @LinkedList<S64> <- .construct()

        print_list(out, list)
        print_option(out, "peek_front", list.peek_front())
        list.push_back(1, alloc)
        list.push_back(2, alloc)
        list.push_back(3, alloc)
        list.push_front(0, alloc)
        list.push_front(-1, alloc)
        print_list(out, list)
        print_option(out, "peek_front", list.peek_front())
        print_option(out, "peek_back", list.peek_back())
        print_option(out, "pop_front", list.pop_front(alloc))
        print_option(out, "pop_back", list.pop_back(alloc))
        print_list(out, list)
        print_option(out, "pop_back", list.pop_back(alloc))
        print_option(out, "pop_back", list.pop_back(alloc))
        print_option(out, "pop_back", list.pop_back(alloc))
        print_option(out, "pop_back", list.pop_back(alloc))
        print_list(out, list)
        list.push_front(7, alloc)
        print_option(out, "peek_back", list.peek_back())
        list.push_back(8, alloc)
        print_list(out, list)
        list.destruct(alloc)
        print_list(out, list)
        out.flush()
        return()
