// Tessera doubly-linked list
//
// Generic doubly-linked list with O(1) push/pop at both ends.
// Nodes are heap-allocated via an explicit MemoryManager.
//
// Layout:
//   ListNode[T]    heap node — value, prev, next
//   LinkedList[T]  list head — head ptr, tail ptr, count
//
// Operations:
//   push_front / push_back   O(1) insert
//   pop_front  / pop_back    O(1) remove, returns Maybe[T]
//   peek_front / peek_back   O(1) read-only, returns Maybe[T]
//   count / is_empty         O(1)
//   iter                     forward iterator (head → tail)
//   free                     frees all nodes

import Standard/Alloc
import Standard/Format
import Standard/Os

// ── Node ──────────────────────────────────────────────────────────────────────

record ListNode[T]
needs T: typename
    value: T
    prev: @ListNode[T]
    next: @ListNode[T]

/// Makes a `ListNode` from its fields.
/// :param value: Its `value`.
/// :param prev: Its `prev`.
/// :param next: Its `next`.
/// :returns: The new value.
routine ListNode[T].construct(value: T, prev: @Me, next: @Me) -> Me
needs T: typename
    return Me(value, prev, next)

/// Releases nothing: a `ListNode` holds no memory of its own.
routine ListNode[T].destruct(me: @Me) -> Void
needs T: typename
    return

// ── List ──────────────────────────────────────────────────────────────────────

record LinkedList[T]
needs T: typename
    head: @ListNode[T]
    tail: @ListNode[T]
    count: S64

// ── Iterator ──────────────────────────────────────────────────────────────────

record LinkedListIter[T]
needs T: typename
    current: @ListNode[T]

/// Makes a `LinkedListIter` from its fields.
/// :param current: Its `current`.
/// :returns: The new value.
routine LinkedListIter[T].construct(current: @ListNode[T]) -> Me
needs T: typename
    return Me(current)

/// Releases nothing: a `LinkedListIter` holds no memory of its own.
routine LinkedListIter[T].destruct(me: @Me) -> Void
needs T: typename
    return

// ── Construction ──────────────────────────────────────────────────────────────

routine LinkedList[T].construct() -> Me
    list: Me = Me(head: null, tail: null, count: 0)
    return list

// ── Queries ───────────────────────────────────────────────────────────────────

routine LinkedList[T].count(me: @Me) -> S64
    len: S64 = me.count.peek()
    return len

routine LinkedList[T].is_empty(me: @Me) -> Bool
    len: S64 = me.count.peek()
    return len == 0

routine LinkedList[T].peek_front(me: @Me) -> Maybe[T]
    local head: @ListNode[T] = me.head.peek()

    if head.is_null()
        none: Maybe[T] = Unit()
        return none
    else
        val: T = head.value.peek()
        some: Maybe[T] = val
        return some

routine LinkedList[T].peek_back(me: @Me) -> Maybe[T]
    local tail: @ListNode[T] = me.tail.peek()

    if tail.is_null()
        none: Maybe[T] = Unit()
        return none
    else
        val: T = tail.value.peek()
        some: Maybe[T] = val
        return some

// ── Insert ────────────────────────────────────────────────────────────────────

routine LinkedList[T].add_first(me: @Me, val: T, alloc: @MemoryManager) -> Void
    local node: @ListNode[T] = allocate[ListNode[T]](count: 1, alloc)

    if node.is_null()
        crash_allocation()
    node.value.poke(val)
    node.prev.poke(null)
    head: @ListNode[T] = me.head.peek()
    node.next.poke(head)
    if head.is_null()
        me.tail.poke(node)
    else
        head.prev.poke(node)
    me.head.poke(node)
    next_count: S64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

routine LinkedList[T].add_last(me: @Me, val: T, alloc: @MemoryManager) -> Void
    local node: @ListNode[T] = allocate[ListNode[T]](count: 1, alloc)

    if node.is_null()
        crash_allocation()
    node.value.poke(val)
    node.next.poke(null)
    tail: @ListNode[T] = me.tail.peek()
    node.prev.poke(tail)
    if tail.is_null()
        me.head.poke(node)
    else
        tail.next.poke(node)
    me.tail.poke(node)
    next_count: S64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

// ── Remove ────────────────────────────────────────────────────────────────────

routine LinkedList[T].remove_first(me: @Me, alloc: @MemoryManager) -> Maybe[T]
    local head: @ListNode[T] = me.head.peek()

    empty: Bool = head.is_null()
    val: T = when
        empty =>
            none: Maybe[T] = Unit()
            return none
        else =>
            val: T = head.value.peek()
            next: @ListNode[T] = head.next.peek()
            me.head.poke(next)
            if next.is_null()
                me.tail.poke(null)
                becomes val
            else
                next.prev.poke(null)
                becomes val
    next_count: S64 = me.count.peek() - 1
    next_count.poke_into(me.count)
    deallocate(data: head, alloc)
    some: Maybe[T] = val
    return some

routine LinkedList[T].remove_last(me: @Me, alloc: @MemoryManager) -> Maybe[T]
    local tail: @ListNode[T] = me.tail.peek()

    empty: Bool = tail.is_null()
    val: T = when
        empty =>
            none: Maybe[T] = Unit()
            return none
        else =>
            val: T = tail.value.peek()
            prev: @ListNode[T] = tail.prev.peek()
            me.tail.poke(prev)
            if prev.is_null()
                me.head.poke(null)
                becomes val
            else
                prev.next.poke(null)
                becomes val
    next_count: S64 = me.count.peek() - 1
    next_count.poke_into(me.count)
    deallocate(data: tail, alloc)
    some: Maybe[T] = val
    return some

// ── Iterator ──────────────────────────────────────────────────────────────────

routine LinkedList[T].iter(me: @Me) -> LinkedListIter[T]
    head: @ListNode[T] = me.head.peek()
    iter: LinkedListIter[T] = LinkedListIter[T](current: head)
    return iter

/// satisfies Iterator[T, LinkedListIter[T]]
routine LinkedListIter[T].emit_checked(me: @Me) -> Maybe[T]
    local cur: @ListNode[T] = me.current.peek()

    if cur.is_null()
        none: Maybe[T] = Unit()
        return none
    else
        val: T = cur.value.peek()
        next: @ListNode[T] = cur.next.peek()
        me.current.poke(next)
        some: Maybe[T] = val
        return some

// ── Free ──────────────────────────────────────────────────────────────────────

routine LinkedList[T].destruct(me: @Me, alloc: @MemoryManager) -> Void
    until cur.is_null() with cur: @ListNode[T] = me.head.peek()
        next: @ListNode[T] = cur.next.peek()
        deallocate(data: cur, alloc)
        continue with cur: next
    me.head.poke(null)
    me.tail.poke(null)
    me.count.poke(0)
    return

// ── Demo ──────────────────────────────────────────────────────────────────────

routine print_list(out: @BufWriter[Out], list: @LinkedList[S64]) -> Void
    local iter: @LinkedListIter[S64] <- .hollow()

    out.write("list [")
    iter.poke(list.iter())

    while true with first: Bool = true
        item: Maybe[S64] = iter.emit_checked()
        value: S64 = when item
            is S64 as value => value
            is Unit => break
        if not first
            out.write(", ")
        value.represent_into(out)
        continue with first: false
    out.write("] length {list.count()}\n")
    return

/// Prints "<label> <value>" when the value is present, "<label> none" when it's absent.
routine print_option(out: @BufWriter[Out], label: Span[Byte], item: Maybe[S64]) -> Void
    out.write("{label} ")
    when item
        is S64 as value =>
            out.write("{value}\n")
            return
        is Unit =>
            out.write("none\n")
            return

routine start() -> Void
    fd: @Out = Out.writer()
    local out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    local alloc: @MemoryManager <- make_heap_memory()
    local list: @LinkedList[S64] <- .construct()

    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    list.add_last(val: 1, alloc)
    list.add_last(val: 2, alloc)
    list.add_last(val: 3, alloc)
    list.add_first(val: 0, alloc)
    list.add_first(val: -1, alloc)
    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    print_option(out, label: "peek_back", item: list.peek_back())
    print_option(out, label: "pop_front", item: list.remove_first(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_list(out, list)
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_list(out, list)
    list.add_first(val: 7, alloc)
    print_option(out, label: "peek_back", item: list.peek_back())
    list.add_last(val: 8, alloc)
    print_list(out, list)
    list.destruct(alloc)
    print_list(out, list)
    out.flush()
    return
