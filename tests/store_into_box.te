# `v.store_into(x)` writes v into the box x, the `&T` twin of `poke_into`: a read-modify-write is one chain
# (`x.load().add(1).store_into(x)`) whether x is a STACK place or a box from a memory manager.

import Standard/Os

### Adds `step` to the box `total` 1000 times.
### :param total: The box to add to.
### :param step: What each round adds.
routine add_up(total: @&B64, step: B64) -> None
    each i: S64 in 1 to 1000
        (total.load() + step).store_into(total)
    return

### Writes into a STACK place, a box from the heap, and a box passed by its address.
routine start() -> None
    x: &B64 <- 0.0
    each i: S64 in 1 to 1_048_576
        (x.load() + 123456789123.0).store_into(x)
    Console.show("{x.load()}")

    count: &U64 <- 0 from HEAP
    count.load().add(41).store_into(count)
    count.load().add(1).store_into(count)
    Console.show("{count.load()}")
    drop count

    sum: &B64 <- 0.5 from HEAP
    add_up(total: sum, step: 0.25)
    Console.show("{sum.load()}")
    drop sum
    return
