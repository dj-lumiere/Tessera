# rsqrt of zero has an infinite result and crashes with NumericOverflowError, like the other checked float math:
# rsqrt_unchecked gives +inf for +0 and -inf for -0, and +inf has the reciprocal square root +0.

import Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("float_crash_rsqrt_zero.te")
    Console.show("crashed: {name}: {message.text()} (this file {here}, line {place.line.peek()})")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    zero: B64 = 0.0
    big: B64 = inf
    four: B64 = 4.0
    Console.show("{zero.rsqrt_unchecked()} {(-zero).rsqrt_unchecked()} {big.rsqrt()} {four.rsqrt()}")
    r: B64 = zero.rsqrt()
    Console.show("not reached {r}")
    return
