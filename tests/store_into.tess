// store_into writes a value to memory from the value's side: %v.store_into(#p) is #p.store(%v).
// A literal receiver takes its type from the pointer: 7.store_into(#point.y) stores an S64.

import Standard::Format

record Point
    x : S64
    y : S64

routine main() -> S32
    block entry():
        claim #sum   : Ptr<S64>
        claim #point : Ptr<Point>
        claim #flag  : Ptr<Bool>
        %a : S64 = 40
        %a.add(2).store_into(#sum)
        Point { x: 3, y: 4 }.store_into(#point)
        true.store_into(#flag)
        7.store_into(#point.y)
        %total : S64   = #sum.load()
        %p     : Point = #point.load()
        %f     : Bool  = #flag.load()
        print("{%total} {%p.x} {%p.y} {%f}\n")
        return(0)
