# store_into writes a value to memory from the value's side: v.poke_into(p) is p.poke(v).
# A literal receiver takes its type from the pointer: 7.poke_into(point.y) stores an S64.

import Standard/Format
import Standard/Os

record Point
    x: S64
    y: S64

routine start() -> None
    local sum: @S64 <- .hollow()
    local point: @Point <- .hollow()
    local flag: @Bool <- .hollow()
    a: S64 = 40
    (a + 2).poke_into(sum)
    Point(x: 3, y: 4).poke_into(point)
    true.poke_into(flag)
    7.poke_into(point.y)
    total: S64 = sum.peek()
    p: Point = point.peek()
    f: Bool = flag.peek()
    Out.write("{total} {p.x} {p.y} {f}\n")
    return
