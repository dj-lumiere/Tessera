; private fields and routines are fully usable inside their own file.
record Counter
    private hits: U64

private routine bump(%c: Counter) -> Counter
    block entry():
        %r: Counter = Counter { hits: %c.hits.add(1) }
        return(%r)

routine main() -> S32
    block entry():
        %c: Counter = bump(bump(Counter { hits: 0 }))
        print_uint(%c.hits)
        return(0)
