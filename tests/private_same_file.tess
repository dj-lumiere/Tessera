/// private fields and routines are fully usable inside their own file.
import Standard/Format
import Standard/Os

record Counter
    private hits: U64

/// Makes a `Counter` from its fields.
/// :param hits: Its `hits`.
/// :returns: The new value.
routine Counter.construct(hits: U64) -> Me
    return(Me(hits))

/// Releases nothing: a `Counter` holds no memory of its own.
routine Counter.destruct(me: @Me) -> Void
    return()

private routine bump(c: Counter) -> Counter
    r: Counter = Counter(hits: c.hits.add(1))
    return(r)

routine start() -> Void
    c: Counter = bump(bump(Counter(hits: 0)))
    Out.write("{c.hits}")
    return()
