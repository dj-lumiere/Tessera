# A one-line when arm fills a field that holds an E? from HEAP (or with a place it already holds), as a block arm does.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

### Says which node ends, then ends the rest of the list.
routine @Node.destruct() -> None
    Console.show("end {me.value.peek()}")
    drop me.next
    return

### Puts a node with the value after this one when it has none, and says it already has one otherwise.
### :param value: The value of the new node.
routine @Node.grow(value: S64) -> None
    when me.next
        is None => me.next <- Me.construct(value) from HEAP
        is Me as next => Console.show("{me.value.peek()} has {next.value.peek()} already")
    return

### Puts a node it made after this one when it has none.
### :param value: The value of the new node.
routine @Node.grow_with_place(value: S64) -> None
    fresh: &Me <- Me.construct(value) from HEAP
    when me.next
        is None => me.next <- steal fresh
        else =>
            drop fresh
    return

routine start() -> None
    first: &Node <- Node.construct(1)
    first.grow(2)
    first.grow(3)
    when first.next
        is Node as second =>
            second.grow_with_place(4)
            second.grow_with_place(5)
        is None => Console.show("none")
    drop first
    Console.show("done")
    return
