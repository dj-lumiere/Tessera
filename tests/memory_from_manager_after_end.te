# Memory taken through a manager's table, used after the manager ended.

import Standard/Os

### A manager that hands out blocks from the C heap and counts them.
entity Counting
    taken: U64

obeys MemoryManageable[Counting]

### A manager with no blocks taken.
### :returns: The manager.
common routine Counting.construct() -> Me
    return Me(taken: 0)

### A block of `size` bytes.
### :param size: The number of bytes.
### :param align: The alignment.
### :returns: The block.
routine @Counting.alloc(size: U64, align: U64) -> Addr
    me.taken.peek().add(1).poke_into(me.taken)
    return C_HEAP.alloc(size, align)

### Resizes a block.
### :param at: The block.
### :param size: The new size.
### :param align: The alignment.
### :returns: The block.
@reshaping(at)
routine @Counting.realloc(at: Addr, size: U64, align: U64) -> Addr
    return C_HEAP.realloc(at, size, align)

### Gives a block back.
### :param at: The block.
routine @Counting.free(at: Addr) -> None
    C_HEAP.free(at)
    return

### Nothing to give back.
routine @Counting.destruct() -> None
    return

routine start() -> None
    local counting: @Counting <- .construct()
    local table: @MemoryManager <- counting.to[MemoryManager]()
    local m: @Memory[S64] <- [7] * 4 at table

    drop table
    drop counting
    Console.show("{m.load(0)}")
    drop m
    return
