# Memory taken through a manager's table, used after the manager ended.

import Standard/Hosted

### A manager that hands out blocks from the C heap and counts them.
entity Counting
    taken: U64

obeys MemoryManageable[Counting]

### A manager with no blocks taken.
### :returns: The manager.
common routine Counting.construct() -> Me
    return Me(taken: 0)

### A block of `size` bytes.
### :param size: The number of bytes.
### :param align: The alignment.
### :returns: The block.
routine @Counting.borrow(size: U64, align: U64) -> Addr
    me.taken.peek().add(1).poke_into(me.taken)
    return C_HEAP.borrow(size, align)

### Resizes a block.
### :param at: The block.
### :param size: The new size.
### :param align: The alignment.
### :returns: The block.
@reshaping(at)
routine @Counting.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return C_HEAP.reborrow(at, size, align)

### Gives a block back.
### :param at: The block.
routine @Counting.give_back(at: Addr) -> None
    C_HEAP.give_back(at)
    return

### Nothing to give back.
routine @Counting.destruct() -> None
    return

routine start() -> None
    counting: &Counting <- .construct()
    table: &MemoryManager <- counting.to[MemoryManager]()
    m: &[S64] <- [7] * 4 from table

    drop table
    drop counting
    Console.show("{m[0]}")
    drop m
    return
