// Only a routine whose first parameter is self is a method; one without is called by its type.

record Point
    x : S64
    y : S64

routine Point.shifted(p: Self, by: S64) -> Self
    block entry()
        return(Self { x: p.x.add(by), y: p.y })

routine main() -> S32
    block entry()
        p : Point = Point { x: 1, y: 2 }
        q : Point = p.shifted(1)
        return(0)
