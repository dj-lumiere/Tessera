# getslot gives the address of an element, checked like getitem (a stop past the end or for a missing key), and
# `try` in front of it gives None instead: a place to read or update in place. Items, List, and RotatableList take an index. Dict and
# SortedDict take a key and give the value's address only, since changing a key in place would lose it.

import Collections
import Hosted

routine start() -> None
    lateinit ring: &RotatableList[S64]
    manager: @MemoryManager = HEAP
    arr: &Items[S64, 3]

    arr.zeroinit(1)
    arr.getslot(1).poke(5)
    Console.show("Items {arr.getitem(0)} {arr.getitem(1)}")

    list: &List[S64] <- .construct(manager)
    list.add_last(10)
    list.add_last(20)
    list.add_last(30)
    slot: @S64 = list.getslot(1)
    slot.poke(slot.peek() + 5)
    past: Optional[@S64] = try list.getslot(3)
    Console.show("List {list.getitem(1)} {past.is_absent()}")
    drop list

    ring.store(.construct(manager))
    ring.add_last(1)
    ring.add_last(2)
    ring.add_first(0)
    third: @S64 = ring.getslot(2)
    third.poke(9)
    front: Optional[@S64] = try ring.getslot(0)
    p: @S64 = when front
        is @S64 as p => p
        is None => unreachable
    Console.show("CircularList {p.peek()} {ring.getitem(2)}")

    dict: &Dict[S64, S64] <- .construct(manager)
    dict[7] = 1
    count: @S64 = dict.getslot(7)
    count.poke(count.peek() + 1)
    count.poke(count.peek() + 1)
    missing: Optional[@S64] = try dict.getslot(8)
    Console.show("Dict {dict.getitem(7)} {missing.is_absent()}")

    sorted: &SortedDict[S64, S64] <- .construct(manager)
    sorted[3] = 30
    sorted[1] = 10
    sorted[2] = 20
    two: @S64 = sorted.getslot(2)
    two.poke(two.peek() * 2)
    none: Optional[@S64] = try sorted.getslot(4)
    Console.show("SortedDict {sorted.getitem(2)} {none.is_absent()}")

    drop ring
    drop dict
    drop sorted
    return
