# An #inline routine that calls itself, here through another routine, can't be inlined at every call.

@inline
routine is_even(n: U64) -> Bool
    if n == 0
        return true
    else
        return is_odd(n - 1)

routine is_odd(n: U64) -> Bool
    if n == 0
        return false
    else
        return is_even(n - 1)

routine start() -> None
    e: Bool = is_even(10)
    return
