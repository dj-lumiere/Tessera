# A routine's parameters are there in every block, so a block parameter can't take one's name: a counter that
# starts from `n` and changes is another value, with a name of its own.
routine count_down(n: S64) -> S64
    jump loop(n)

    block loop(n: S64)
        branch n.eq(0)
            ? return(n)
            : loop(n.sub(1))

routine start() -> None
    count_down(3)
    return()
