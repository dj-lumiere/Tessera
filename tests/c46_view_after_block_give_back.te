# The view of a List's element, taken in an if body and kept in a place outside it, read after the body gave the List
# back (Rust's reference to a value of an inner block, used after the block, in Tessera).

import Collections
import Hosted

### Reads an element of a list that is gone.
routine start() -> None
    lateinit p: &@S64
    if true
        xs: &List[S64] <- .construct(HEAP)
        xs.add_last(1234567)
        p.store(xs.getslot(0))
    q: @S64 = p.load()
    Console.show("kept: {q.peek()}")
    return
