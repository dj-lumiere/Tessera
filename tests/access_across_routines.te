# An access is followed across routines like memory: a routine may take one and return it (the caller gives it back),
# or be handed one and give it back (the caller's ends at the call).

import Standard/Os

global COUNTER: &U64

### Takes exclusive access to the counter and hands it to the caller.
### :returns: The access.
routine open_counter() -> Authorized[U64]
    return COUNTER.get_exclusive_access()

### Adds one through the access, then gives it back.
### :param held: An exclusive access.
routine bump_and_close(held: Authorized[U64]) -> None
    view: @U64 = held.getview()
    view.poke(view.peek() + 1)
    drop held
    return

routine start() -> None
    held: Authorized[U64] <- open_counter()
    bump_and_close(held)
    again: Authorized[U64] <- open_counter()
    view: @U64 = again.getview()
    view.poke(view.peek() + 1)
    drop again
    Console.show("{COUNTER.peek()}, held: {AccessManager.held_count()}")
    return
