# drop ends a list: it ends each element (a plain S64 gives nothing back) and gives its memory back.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

### Fills a list of plain values and drops it.
routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local l: @List[S64] <- .construct(alloc)

    l.add_last(1)
    l.add_last(2)
    Out.write("{l}\n")
    drop l
    Out.write("dropped\n")
    return
