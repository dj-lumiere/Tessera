// A pointer isn't Representable or Diagnosable, but a record with a pointer field still derives both: the derived
// routines write the field's address, through to<Addr>(). A variant's pointer payload does the same without asking.
// Only null addresses are printed, since a real one changes from run to run.

import Standard::Format
import Standard::Os

#derive(Representable, Diagnosable)
record Node
    value : S64
    next  : @Node

variant Link
    End
    To : @Node

routine main() -> S32
    block entry()
        claim tail : @Node <- Node { value: 2, next: null }
        node : Node = tail.load()
        Out.write("{node}\n")
        Out.write("{node.diagnose()}\n")
        link : Link = .To(null)
        end  : Link = .End
        Out.write("{link} {end}\n")
        Out.write("{link.diagnose()}\n")
        return(0)
