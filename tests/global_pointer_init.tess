// A global holding a pointer starts as null or as the address of another global or preset in memory: both are
// known when the program is linked. Its own name is the address of that pointer, so its type is @@T.

import Standard::Format
import Standard::Os

global CELL: @U64 <- 5
global HEAD: @@U64 <- CELL
global ANY: @Addr <- CELL
global NOTHING: @@U64 <- null
global TABLE: @@Array<U64, 3> <- PRIMES

preset PRIMES: @Array<U64, 3> <- { 2, 3, 5 }

routine main() -> S32
    block entry():
        head : @U64 = HEAD.load()
        Out.write("{head.load()}\n")
        any : Addr = ANY.load()
        Out.write("{any.to<@U64>().load()}\n")
        none : Bool = NOTHING.load().is_null()
        Out.write("{none}\n")
        table : @Array<U64, 3> = TABLE.load()
        Out.write("{table.get(2)}\n")
        return(0)
