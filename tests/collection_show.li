# Every collection shows itself with Console.show("{c}") and diagnose_into, held as a &T place or as an @T pointer.
# Lists and arrays write [a, b], sets {a, b}, maps {key: value}, the empty set {} and the empty map {:}. Sorted
# collections write their elements in order, and a PriorityQueue writes its `priority: element` pairs in the order
# they come out, without changing the heap.

import Collections
import Hosted

### Shows a map it is handed as a pointer.
### :param d: The map.
routine show_held(d: @Dict[S64, S64]) -> None
    Console.show("held {d} ", end: "")
    d.diagnose_into(Console.output())
    Console.show("")
    return

routine start() -> None
    d: &Dict[S64, S64] <- Dict[S64, S64].of(values: [(2, 20), (1, 10)], manager: HEAP)
    empty_map: &Dict[S64, S64] <- .construct(HEAP)
    empty_sorted_map: &SortedDict[S64, S64] <- .construct(HEAP)
    empty_set: &Set[S64] <- .construct(HEAP)
    empty_sorted_set: &SortedSet[S64] <- .construct(HEAP)
    empty_queue: &PriorityQueue[S64, S64] <- .construct(HEAP)
    Console.show("{d} {empty_map} {empty_sorted_map} {empty_set} {empty_sorted_set} {empty_queue}")
    empty_map.diagnose_into(Console.output())
    Console.show(" ", end: "")
    empty_sorted_map.diagnose_into(Console.output())
    Console.show("")
    show_held(d)

    sets: &List[Dict[S64, S64]] <- List[Dict[S64, S64]].of(
        values: [Dict[S64, S64].of(values: [(1, 10), (2, 5)], manager: HEAP), Dict[S64, S64].construct(HEAP)],
        manager: HEAP)
    Console.show("{sets}")

    sorted: &SortedDict[@[Byte], S64] <- SortedDict[@[Byte], S64].of(
        values: [("pear", 2), ("apple", 1)], manager: HEAP)
    Console.show("{sorted}")

    queue: &PriorityQueue[S64, @[Byte]] <- PriorityQueue[S64, @[Byte]].of(
        values: [(4, "d"), (1, "a"), (3, "c"), (2, "b"), (5, "e")], manager: HEAP)
    Console.show("{queue} ", end: "")
    queue.diagnose_into(Console.output())
    Console.show(" {queue.count()}")

    bits: Bits[3] = Bits[3].zero()
    numbers: Items[S64, 3] = [1, 2, 3]
    Console.show("{bits} {numbers}")

    drop queue
    drop sorted
    drop sets
    drop empty_queue
    drop empty_sorted_set
    drop empty_set
    drop empty_sorted_map
    drop empty_map
    drop d
    return
