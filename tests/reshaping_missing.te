# A routine that may move a parameter's memory says so with #reshaping.

import Collections
import Hosted

routine grow(items: @List[S64]) -> None
    items.add_last(1)
    return

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)

    xs.add_last(5)
    first: @S64 = xs.getslot(0)
    grow(xs)
    v: S64 = first.peek()
    drop xs
    return
