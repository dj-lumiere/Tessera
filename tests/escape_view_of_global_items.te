# A view made with `getview()` of a global's slots outlives the routine, so the address of a STACK slot poked through
# it is a build error.

import Hosted

global KEPT: &Items[@S32, 2] <- .hollow()

### Pokes the address of a local through a view of the global.
routine keep() -> None
    a: &S32 <- 10

    elems: @[@S32] = KEPT.getview()
    elems.getslot(0).poke(a)
    return

routine start() -> None
    keep()
    return
