# A fill on every branch, one through a call that takes the place and one with <-, leaves it filled.
import Hosted

### Fills the place.
### :param out: The place.
routine fill(out: @S64) -> None
    out.poke(4)
    return

routine start() -> None
    lateinit n: &S64
    if Clock.monotonic() > Duration.MAX
        fill(out: n)
    else
        n <- 9
    first: S64 = n.load()
    Console.show("{first}")
    lateinit m: &S64
    loop
        m.store(2)
        break
    second: S64 = m.load()
    Console.show("{second}")
    return
