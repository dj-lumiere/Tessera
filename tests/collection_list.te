# List[S64] against a model. An LCG drives random push / pop / get / set, with a rare clear or reserve, in three
# phases (growing, steady, shrinking). Every 500 operations a checkpoint prints the length, a running checksum of
# every result, and a hash of the ListIter sequence. Then eq, which takes the lists by value.
# The expected output comes from an independent Python model of the collection.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[Out]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: U64
    ### How many operations the phase runs.
    ops: U64
    ### The percentage of operations that push. Pop takes the next 25.
    push: U64

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: U64
    ### The operations run so far in the phase.
    op: U64
    ### The checksum of every result so far.
    results: S64

### Makes a `Harness` from its fields.
### :param out: Its `out`.
### :param rng: Its `rng`.
### :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng) -> Me
    return Me(out, rng)

### Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> None
    return

routine Rng.below(me: @Me, bound: U64) -> U64
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: U64 = bucket.to[U64]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: Span[Byte], value: S64) -> None
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

# Folds every element in iteration order.
routine iteration_hash(list: @List[S64]) -> S64
    local iter: @ListIter[S64] <- .construct(list)

    while true with hash: S64 = 0
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as value => continue with hash: mix(hash, value)
            is None => return hash

routine checkpoint(out: @BufWriter[Out], list: @List[S64], at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: U64 = list.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(list))
    out.write("\n")
    return

# Runs ops random operations: push is the percentage of pushes, pop takes the next 25. Returns the updated results
# checksum.
@reshaping(list)
routine run_phase(harness: Harness, list: @List[S64], phase: Phase, results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: U64 = phase.ops
    local push: U64 = phase.push

    while op < ops with op: U64 = 0, checksum: S64 = results
        kind: U64 = rng.below(1000)
        pop_end: U64 = (push + 25) * 10
        is_push: Bool = kind < push * 10
        is_pop: Bool = kind < pop_end
        is_get: Bool = kind < pop_end + 200
        is_clear: Bool = kind == 999
        is_reserve: Bool = kind == 998
        result: S64 = when
            is_push =>
                value: S64 = rng.below(1000000).to[S64]()
                list.add_last(value)
                becomes value
            is_pop =>
                if list.is_empty()
                    becomes -1
                else
                    becomes list.remove_last()
            is_get =>
                if list.is_empty()
                    becomes -2
                else
                    index: U64 = rng.below(list.count())
                    becomes list[index]
            is_clear =>
                list.clear()
                becomes -4
            is_reserve =>
                extra: U64 = rng.below(3000)
                size: U64 = list.count()
                list.reserve(size + extra)
                becomes extra.to[S64]()
            else =>
                if list.is_empty()
                    becomes -3
                else
                    index: U64 = rng.below(list.count())
                    value: S64 = rng.below(1000000).to[S64]()
                    list[index] = value
                    becomes index.to[S64]()
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: U64 = op + 1
        if op_next % 500 == 0
            checkpoint(out: harness.out, list,
                at: Checkpoint(phase: phase.number, op: op_next, results: mixed))
        continue with op: op_next, checksum: mixed
    then
        return checksum

# Pushes every element of from onto to.
@reshaping(to)
routine copy_into(from: @List[S64], to: @List[S64]) -> None
    local count: U64 = from.count()

    each index in 0 til count
        to.add_last(from[index])
    then
        return

routine report_eq(out: @BufWriter[Out], label: Span[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @Out = Out.writer()
    local out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    local alloc: @MemoryManager <- make_heap_memory()
    local rng: @Rng <- Rng(state: 2)
    local list: @List[S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, list, phase: Phase(number: 1, ops: 4000, push: 50), results: 0)
    r2: S64 = run_phase(harness, list, phase: Phase(number: 2, ops: 4000, push: 25), results: r1)
    r3: S64 = run_phase(harness, list, phase: Phase(number: 3, ops: 3000, push: 15), results: r2)
    r4: S64 = run_phase(harness, list, phase: Phase(number: 4, ops: 3000, push: 45), results: r3)

    local copied: @List[S64] <- .construct(alloc)
    report_eq(out, label: "empty copy equal", equal: list.eq(copied))
    copy_into(from: list, to: copied)
    report_eq(out, label: "copy equal", equal: list.eq(copied))
    copied_count: U64 = copied.count()
    last_index: U64 = copied_count - 1
    last: S64 = copied[last_index]
    copied[last_index] = last + 1
    report_eq(out, label: "changed last equal", equal: list.eq(copied))
    copied[last_index] = last
    copied.add_last(0)
    report_eq(out, label: "longer equal", equal: list.eq(copied))
    copied.remove_last()
    report_eq(out, label: "restored equal", equal: list.eq(copied))
    drop copied
    drop list
    out.flush()
    return
