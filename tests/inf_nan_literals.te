# inf and nan are float literals typed by where they go, like 1.5: every binary float takes them, -inf is - on inf,
# and a preset folds them.

import Standard/Os

preset TOP: B64 = inf
preset LOW: B16 = -inf
preset QUAD: B128 = -inf
preset HOLE: B32 = nan
preset HALF_MAX: B16 = B64.to[B16](65504.0)
preset OVER: B16 = B64.to_unchecked[B16](1.0e10)

### Whether `x` is larger than every finite B64.
### :param x: The value tested.
### :returns: True for positive infinity.
routine above_all(x: B64) -> Bool
    return x > B64.MAX

routine start() -> None
    a: B16 = inf
    b: BF16 = -inf
    c: B32 = nan
    d: B64 = -inf
    e: B128 = nan
    f: B128 = inf
    Console.show("{a} {b} {c} {d} {e} {f}")
    Console.show("{TOP} {LOW} {QUAD} {HOLE} {HALF_MAX} {OVER}")
    Console.show("{above_all(inf)} {above_all(1.0)} {d < 0.0} {c == c} {c.is_nan()} {f.is_infinite()}")
    Console.show("{d == -inf} {TOP == inf} {e.is_nan()}")
    lanes: Vector[B32, 4] = [1.0, inf, -inf, nan]
    Console.show("{lanes.getitem(1)} {lanes.getitem(2)} {lanes.getitem(3)}")
    return
