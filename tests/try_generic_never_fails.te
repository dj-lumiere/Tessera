# A failable protocol requirement may be met by a routine that never fails: S64's add throws IntegerOverflowError,
# B64's add never throws. A generic routine's `try a + b` gives None for the S64 overflow and always the value for B64.

import Hosted

### The sum, or None when it doesn't fit.
### :typeparam T: The type added.
### :param a: One value.
### :param b: The other.
### :returns: The sum or None.
routine sum_or_none[T](a: T, b: T) -> Optional[T]
needs T: typename, Addable[T]
    return try a + b

routine start() -> None
    big: S64 = S64.MAX
    one: S64 = 1
    half: B64 = 0.5
    Console.show("{sum_or_none(big, one)} {sum_or_none(one, one)} {sum_or_none(half, half)}")
    return
