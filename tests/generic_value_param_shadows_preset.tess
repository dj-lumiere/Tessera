/// A value generic parameter shadows a preset of the same name inside the record and routines that declare it:
/// `Buffer<T, COUNT>` reads its own `COUNT`, and outside it `COUNT` is the preset.
import Standard::Format
import Standard::Os

/// A preset that happens to share its name with a value parameter.
preset COUNT : USize = 100

/// A fixed number of values.
record Buffer<T, COUNT>
require T: typename, COUNT: USize
    items : Array<T, COUNT>

/// The number of values the buffer holds.
/// :returns: The buffer's own `COUNT`.
routine Buffer<T, COUNT>.capacity(me: Me) -> USize
    block entry()
        return(COUNT)

/// Shows the parameter and the preset staying apart.
routine start() -> Void
    block entry()
        three : Buffer<S64, 3> = Buffer<S64, 3> { items: Array<S64, 3> { 1, 2, 3 } }
        two   : Buffer<S64, 2> = Buffer<S64, 2> { items: Array<S64, 2> { 4, 5 } }
        Out.write("{three.capacity()} {two.capacity()} {COUNT}\n")
        return()
