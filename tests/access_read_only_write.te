# The view of a shared read access reads only: a write through it is a build error.

import Standard/Os

global COUNTER: @U64

routine start() -> None
    reading: ReadAuthorized[U64] = COUNTER.get_shared_read_access()
    view: @U64 = reading.getview()
    view.poke(view.peek() + 1)
    drop reading
    return
