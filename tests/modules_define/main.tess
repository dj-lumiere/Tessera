// define names a module (Fmt/write_str), a built-in type (Int), a generic type that takes the use's arguments
// (Map[K, V]), or a type from another module. Sides comes from Shapes through its import.

import Shapes
import Standard/Alloc
import Standard/Os

define Fmt = Standard/Format
define Int = Standard/Core/S64
define Map = Standard/Collections/Dict
define Tile = Shapes/Square

routine total(sides: Sides) -> Int
    local sum: @Int <- 0

    jump add(0)

    block add(i: USize)
        done: Bool = i.ge(sides.count())
        branch done
            ? return(sum.peek())
            : continue
        sum.peek().add(sides.getitem(i)).poke_into(sum)
        jump add(i.add(1))

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    out: @Out = Out.writer()

    tile: Tile = Tile(side: 3)
    sides_val: Sides = tile.sides(alloc)
    claim sides: @Sides <- sides_val
    perimeter: Int = total(sides_val)
    Fmt/write_str(out, text: "perimeter ")
    Fmt/represent_with_into(out, value: perimeter, spec: Fmt/FormatSpec.construct(0))
    Fmt/write_line(out)

    claim map: @Map[Int, Int] <- .construct(alloc)
    map.setitem(key: perimeter, value: 1)
    Fmt/write_str(out, text: "map ")
    Fmt/represent_with_into(out, value: map.peek(), spec: Fmt/FormatSpec.construct(0))
    Fmt/write_line(out)
    map.destruct()
    sides.destruct()
    return()
