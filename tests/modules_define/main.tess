// define names a module (Fmt::write_str), a built-in type (Int), a generic type that takes the use's arguments
// (Map<K, V>), or a type from another module; Sides comes from Shapes through its import.

import Standard::Alloc
import Shapes
import Standard::Os

define Fmt = Standard::Format
define Int = Standard::Core::S64
define Map = Standard::Collections::Dict
define Tile = Shapes::Square

routine total(%sides: Sides) -> Int
    block entry():
        jump add(%sides, 0, 0)

    block add(%sides: Sides, %i: USize, %sum: Int):
        %done : Bool = %i.ge(%sides.length())
        branch %done ? return(%sum) : add(%sides, %i.add(1), %sum.add(%sides.get(%i)))

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %out : Ptr<StdoutWriter> = StdoutWriter.shared()

        %tile      : Tile  = Tile { side: 3 }
        %sides_val : Sides = %tile.sides(%alloc)
        claim %sides : Ptr<Sides>
        %sides.store(%sides_val)
        %perimeter : Int = total(%sides_val)
        Fmt::write_str(%out, "perimeter ")
        Fmt::represent_with(%out, %perimeter, Fmt::FormatSpec.construct(0))
        Fmt::write_line(%out)

        %map_val : Map<Int, Int> = .construct(%alloc)
        claim %map : Ptr<Map<Int, Int>>
        %map.store(%map_val)
        %map.put(%perimeter, 1)
        Fmt::write_str(%out, "map ")
        Fmt::represent_with(%out, %map.load(), Fmt::FormatSpec.construct(0))
        Fmt::write_line(%out)
        %map.destruct()
        %sides.destruct()
        return(0)
