// define names a module (Fmt::write_str), a built-in type (Int), a generic type that takes the use's arguments
// (Map<K, V>), or a type from another module. Sides comes from Shapes through its import.

import Shapes
import Standard::Alloc
import Standard::Os

define Fmt = Standard::Format
define Int = Standard::Core::S64
define Map = Standard::Collections::Dict
define Tile = Shapes::Square

routine total(sides: Sides) -> Int
    block entry()
        jump add(0, 0)

    block add(i: USize, sum: Int)
        done : Bool = i.ge(sides.count())
        branch done
            ? return(sum)
            : add(i.add(1), sum.add(sides.getitem(i)))

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        out : @Out = Out.shared()

        tile      : Tile  = Tile { side: 3 }
        sides_val : Sides = tile.sides(alloc)
        claim sides : @Sides <- sides_val
        perimeter : Int = total(sides_val)
        Fmt::write_str(out, "perimeter ")
        Fmt::represent_with_into(out, perimeter, Fmt::FormatSpec.construct(0))
        Fmt::write_line(out)

        claim map : @Map<Int, Int> <- .construct(alloc)
        map.put(perimeter, 1)
        Fmt::write_str(out, "map ")
        Fmt::represent_with_into(out, map.load(), Fmt::FormatSpec.construct(0))
        Fmt::write_line(out)
        map.destruct()
        sides.destruct()
        return(0)
