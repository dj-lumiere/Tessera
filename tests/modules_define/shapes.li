# Shapes defines a name for an instantiated List, so importers get the name too.

module Shapes

import Collections

define Sides = Collections/List[S64]

record Square
    side: S64

routine Square.sides(manager: @System/Memory/MemoryManager) -> Sides
    sides: &Sides <- .construct(manager)

    sides.add_last(me.side)
    sides.add_last(me.side)
    sides.add_last(me.side)
    sides.add_last(me.side)
    return sides
