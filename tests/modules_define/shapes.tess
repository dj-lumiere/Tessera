// Shapes defines a name for an instantiated List, so importers get the name too.

module Shapes

import Standard/Collections

define Sides = Standard/Collections/List[S64]

record Square
    side: S64

/// Makes a `Square` from its fields.
/// :param side: Its `side`.
/// :returns: The new value.
routine Square.construct(side: S64) -> Me
    return(Me(side))

/// Releases nothing: a `Square` holds no memory of its own.
routine Square.destruct(me: @Me) -> Void
    return()

routine Square.sides(me: Me, alloc: @Standard/Alloc/MemoryManager) -> Sides
    claim sides: @Sides <- .construct(alloc)
    sides.add_last(me.side)
    sides.add_last(me.side)
    sides.add_last(me.side)
    sides.add_last(me.side)
    return(sides.peek())
