// Shapes defines a name for an instantiated List, so importers get the name too.

module Shapes

import Standard::Collections

define Sides = Standard::Collections::List<S64>

record Square
    side : S64

routine Square.sides(me: Me, alloc: @Standard::Alloc::Allocator) -> Sides
    block entry()
        claim sides : @Sides <- .construct(alloc)
        sides.push(me.side)
        sides.push(me.side)
        sides.push(me.side)
        sides.push(me.side)
        return(sides.load())
