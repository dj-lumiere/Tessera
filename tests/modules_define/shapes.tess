// Shapes defines a name for an instantiated List, so importers get the name too.

module Shapes

import Standard/Collections

define Sides = Standard/Collections/List[S64]

record Square
    side: S64

routine Square.sides(me: Me, alloc: @Standard/Alloc/MemoryManager) -> Sides
    local sides: @Sides <- .construct(alloc)
    sides.add_last(me.side)
    sides.add_last(me.side)
    sides.add_last(me.side)
    sides.add_last(me.side)
    return sides.peek()
