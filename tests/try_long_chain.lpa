# A long chain of calls under one `try` builds in time that grows with the chain, not with a power of it: each link used
# to be inferred again by every link above it, so twelve links took minutes. The chains are written one call per line.

import Hosted

### A node.
entity Blossom
    slot: S64
    up: Stamped[Blossom]?
    lfrom: Stamped[Blossom]?

### Makes a node.
### :param slot: Its slot.
### :returns: The node.
common routine Blossom.construct(slot: S64) -> Me
    return Me(slot, up: None(), lfrom: None())

### Walks a chain of twelve links under one `try`: each link used to be inferred again by every link above it, so a chain this long took minutes to build.
routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    a: Stamped[Blossom] = PoolManager.add(Blossom.construct(slot: 1))
    b: Stamped[Blossom] = PoolManager.add(Blossom.construct(slot: 2))
    a.fetch().up.poke(b)
    b.fetch().up.poke(a)
    c: Stamped[Blossom]? = try a.fetch().up.peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
    d: Stamped[Blossom]? = try a.fetch().up.peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
        .fetch()
        .lfrom
        .peek()
        .unwrap()
        .fetch()
        .up
        .peek()
        .unwrap()
    Console.show("{c.is_present()} {d.is_present()}")
    drop pool
    return
