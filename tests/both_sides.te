# A file for both kinds of target imports both sides of the standard library, and the target keeps one: here the
# CpuEventManager and Console are Hosted's.

import Hosted
import Unhosted

### Does nothing with the event.
### :param event: The event.
routine ignore(event: CpuEvent) -> None
    return

routine start() -> None
    before: Callable[(CpuEvent,), None] = CpuEventManager.when_terminated(ignore.to[Callable]())
    ours: Callable[(CpuEvent,), None] = CpuEventManager.when_terminated(before)
    if ours.addr() === ignore.to[Callable]().addr()
        Console.show("both sides")
    return
