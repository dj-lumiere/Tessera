# when as a value: one-line arms, arms with lines ending in becomes, arms that return.

import Standard/Format
import Standard/Os

choice Size: U8
    SMALL
    MEDIUM
    LARGE

routine classify(n: S64) -> Size
    size: Size = when
        n < 10 => Size.SMALL
        n < 100 =>
            # the middle band, with a line of its own
            doubled: S64 = n * 2
            becomes when
                doubled < 150 => Size.MEDIUM
                else => Size.LARGE
        else => return Size.LARGE
    return size

routine name_of(size: Size) -> @[Byte]
    return when size
        Size.SMALL => "small"
        Size.MEDIUM => "medium"
        Size.LARGE => "large"

routine describe(found: Maybe[S64]) -> S64
    value: S64 = when found
        is S64 as n => n
        is None => return -1
    return value * 10

routine start() -> None
    out: @ConsoleOutput = Console.output()
    out.write("{name_of(classify(5))} {name_of(classify(50))} {name_of(classify(80))} {name_of(classify(500))}\n")
    out.write("{describe(7)} {describe(None())}\n")
    return
