// stride takes a USize, or an SSize to move back. An index of another integer type is converted first.

routine main() -> S32
    block entry()
        claim nums : @Array<S64, 4> <- uninit
        nums.zeroinit(1)
        k    : U64  = 2
        elem : @S64 = nums.to<@S64>().stride(k)
        return(0)
