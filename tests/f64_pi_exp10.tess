// F64's sin_pi, cos_pi, tan_pi and exp10: CORE-MATH ports, correctly rounded, so the same bits on every target.
// Each line is an input and the four results, as bits. The expected values come from mpmath (the exact value,
// rounded to F64 to nearest, ties to even): signed zeros and infinities, NaNs, integers, half-integers and
// quarters (exact, with the sign rules of IEEE 754 sinPi, cosPi and tanPi), subnormals, huge arguments, the
// thresholds of the code, the arguments it lists, inputs that reach its accurate phases, and ordinary ones.

import Standard::Format
import Standard::Os

preset INPUTS: @Array<U64, 121> <- { 0x0000000000000000, 0x8000000000000000, 0x7FF0000000000000,
    0xFFF0000000000000, 0x7FF8000000000000, 0xFFF8000000000007, 0x7FF0000000000001,
    0x3FF0000000000000, 0xBFF0000000000000, 0x4000000000000000, 0xC000000000000000,
    0x4008000000000000, 0xC008000000000000, 0x3FE0000000000000, 0xBFE0000000000000,
    0x3FF8000000000000, 0xBFF8000000000000, 0x4004000000000000, 0xC004000000000000,
    0x3FD0000000000000, 0xBFD0000000000000, 0x3FE8000000000000, 0xBFE8000000000000,
    0x3FF4000000000000, 0xBFF4000000000000, 0x3F40000000000000, 0xBF40000000000000,
    0x3F48000000000000, 0xBF48000000000000, 0x3FA4000000000000, 0xBFA4000000000000,
    0x4280000000000000, 0xC280000000000000, 0x4280000000000200, 0xC280000000000200,
    0x42D0000000000020, 0xC2D0000000000020, 0x42D0000000000001, 0xC2D0000000000001,
    0x4330000000000001, 0xC330000000000001, 0x4340000000000000, 0xC340000000000000,
    0x432FFFFFFFFFFFFF, 0xC32FFFFFFFFFFFFF, 0x42C0000000000060, 0xC2C0000000000060,
    0x7FEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF, 0x3FA2000000000000, 0xBFA2000000000000,
    0x3FA2000000000001, 0xBFA2000000000001, 0x3F30000000000000, 0xBF30000000000000,
    0x3F2FFFFFFFFFFFFE, 0xBF2FFFFFFFFFFFFE, 0x3C90000000000000, 0xBC90000000000000,
    0x3CA0000000000000, 0xBCA0000000000000, 0x06B0000000000000, 0x86B0000000000000,
    0x0350000000000000, 0x8350000000000000, 0x01A56E1FC2F8F359, 0x81A56E1FC2F8F359,
    0x0000000000000001, 0x8000000000000001, 0x000FFFFFFFFFFFFF, 0x0010000000000000,
    0x3E2CCF6429BE6621, 0x3E2CCF6429BE6622, 0x3FB999999999999A, 0xBFB999999999999A,
    0x3FD5555555555555, 0xBFD5555555555555, 0x3FE6666666666666, 0xBFE6666666666666,
    0x405EDD2F1A9FBE77, 0xC05EDD2F1A9FBE77, 0x3F847AE147AE147B, 0xBF847AE147AE147B,
    0x401D000000000000, 0xC01D000000000000, 0x4036000000000000, 0xC036000000000000,
    0x4037000000000000, 0xC037000000000000, 0x4073440000000000, 0xC073440000000000,
    0x40734428F5C28F5C, 0xC0734428F5C28F5C, 0x4073500000000000, 0xC073500000000000,
    0x4073300000000000, 0xC073300000000000, 0x4074300000000000, 0xC074300000000000,
    0x4074380000000000, 0xC074380000000000, 0x4074400000000000, 0xC074400000000000,
    0x4074A00000000000, 0xC074A00000000000, 0x3F4821E0F2AFB970, 0xC05DA5B10D8689FD,
    0x3FD8B9BE647E02A9, 0x3C8B44453E2404E7, 0x3E8A5BDF2B61615B, 0x3F2C0F3ACC7FA2F6,
    0x3F29D17F640DC866, 0x3F21259F9C9F2F7E, 0x3FA0C73D931DF716, 0x3FA069DF2796B9A2,
    0x3F9F26F34FDF2129, 0x3F1B2FEAEC4806E2, 0x3F25364B186C4786, 0xBFDE129B65119370,
    0x400B2844328C59D0, 0xBFFFF307243ADA70 }

routine hex(out: @Out, v: U64) -> Void
    block entry()
        out.write(" 0x")
        v.to<U64>().represent_hex_into(out, 16)
        return()

routine start() -> Void
    shared out : @Out = Out.writer()

    block entry()
        jump each(0)

    block each(i: USize)
        done : Bool = i.eq(121)
        branch done
            ? return()
            : continue
        u : U64 = INPUTS.getitem(i)
        x : F64 = .from_bits(u)
        out.write("0x")
        u.to<U64>().represent_hex_into(out, 16)
        hex(out, x.sin_pi().bits())
        hex(out, x.cos_pi().bits())
        hex(out, x.tan_pi().bits())
        hex(out, x.exp10().bits())
        out.write("\n")
        jump each(i.add(1))
