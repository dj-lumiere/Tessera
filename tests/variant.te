# A variant is a value of one of its branch types and a tag that says which (the type's ID). `when` on it observes
# the branch: `is T as x` names the value for the arm's target. A value of a branch type goes where the variant is
# expected as it is.

import Standard/Os

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record BinaryExpr
    left: S64
    right: S64

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Empty
    nothing

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
variant Expr
    S64
    BinaryExpr
    @[Byte]
    Empty

@derive(Representable, Diagnosable, Equatable)
record Nothing
    nothing

@derive(Representable, Equatable)
variant Perhaps[T]
needs T: typename
    T
    Nothing

### Releases nothing: a `Expr` holds no memory of its own.
routine @Expr.destruct() -> None
    return

### Releases nothing: a `Perhaps` holds no memory of its own.
routine @Perhaps[T].destruct() -> None
needs T: typename
    return

routine eval(e: Expr) -> S64
    when e
        is S64 as n => return n
        is BinaryExpr as b =>
            r: S64 = b.left + b.right
            return r
        is @[Byte] as s => return s.count.to[S64]()
        is Empty => return 0

routine describe(e: Expr) -> @[Byte]
    when e
        is S64, is BinaryExpr => return "math"
        else => return "other"

routine unwrap_or[T](m: Perhaps[T], default: T) -> T
needs T: typename
    when m
        is T as value => return value
        is Nothing => return default

routine start() -> None
    a: Expr = 40
    b: Expr = BinaryExpr(left: 1, right: 2)
    c: Expr = "four"
    d: Expr = Empty()
    Console.show("{eval(a)} {eval(b)} {eval(c)} {eval(d)}")
    Console.show("{describe(a)} {describe(b)} {describe(c)} {describe(d)}")
    just: Perhaps[B64] = 2.5
    missing: Perhaps[B64] = Nothing()
    Console.show("{unwrap_or(m: just, default: 0.0)} {unwrap_or(m: missing, default: -1.0)}")
    # the tag (a 64-bit type ID, 8 bytes), then the largest branch (@[Byte] on 64-bit targets, BinaryExpr on 32-bit
    # ones), the whole rounded up to the alignment, which is U64's (8 on 64-bit targets, 4 on 32-bit x86)
    largest: U64 = sizeof[BinaryExpr]().max(sizeof[@[Byte]]())
    size: Bool = sizeof[Expr]() == (8 + largest).next_multiple_of(alignof[Expr]())
    align: Bool = alignof[Expr]() == alignof[U64]()
    tagged_byte: U64 = 9
    small: Bool = sizeof[Perhaps[U8]]() == tagged_byte.next_multiple_of(alignof[U64]())
    Console.show("{size} {align} {small}")
    Console.show("{a} {b} {c} {d} {just} {missing}")
    b.diagnose_into(Console.output())
    Console.show(" ", end: "")
    d.diagnose_into(Console.output())
    Console.show("")
    a2: Expr = 40
    a3: Expr = 41
    empty: Expr = Empty()
    Console.show("{a.eq(a2)} {a.eq(a3)} {a.eq(d)} {d.eq(empty)} {just.eq(missing)}")
    Console.show("{a.compare(a3)} {a.compare(b)} {d.compare(a)} {b.compare(b)}")
    Console.show("{a.hash().eq(a2.hash())} {a.hash().eq(a3.hash())} {d.hash().eq(empty.hash())}")
    return
