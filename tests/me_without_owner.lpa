# me is never written among the parameters, a free routine's included.

record Point
    x: S64

### Makes a `Point` from its fields.
### :param x: Its `x`.
### :returns: The new value.
common routine Point.construct(x: S64) -> Me
    return Me(x)

### Releases nothing: a `Point` holds no memory of its own.
routine @Point.destruct() -> None
    return

routine x_of(me: Point) -> S64
    return me.x

routine start() -> None
    return
