# An entity's destruct gives its Memory field back twice.

import Standard/Os

### Holds memory.
entity Q
    m: Memory[S64]

### An empty one.
### :returns: It.
common routine Q.construct() -> Me
    return Me(m: .hollow())

### Gives the field back twice.
routine @Q.destruct() -> None
    drop me.m
    drop me.m
    return

routine start() -> None
    q: &Q <- .construct()

    q.m.replace(value: Memory[S64].construct(values: [7], times: 4, manager: HEAP))
    drop q
    Console.show("done")
    return
