### Byte shifts by 8 or more shift every bit out (see Operations, Bitwise and Shifts).
import Standard/Hosted

routine show(b: Byte) -> None
    Console.show("{b.to[U8]().to[U64]()}")
    return

routine start() -> None
    b: Byte = 0xB5
    show(b << 0x01)
    show(b >> 0x03)
    show(b << 0x08)
    show(b >> 0x08)
    show(b >> 0xFF)
    return
