routine print_f64(#out: Ptr<FdWriter>) -> Void
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %done: Bool = %i.sge(179)
        branch %done ? return() : one(%i)

    block one(%i: I64):
        %bits:  I64 := F64_CASES[%i]
        %value: F64 = F64.from_bits(%bits)
        %value.format(#out)
        write_line(#out)
        jump loop(%i.add(1))

