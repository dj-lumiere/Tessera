routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        print_f64(#out)
        print_f32(#out)
        print_f16(#out)
        print_bf16(#out)
        return(0)
