# Hex float literals: hex digits scaled by a power of two (the p exponent is decimal and required), exactly a B64.

import Standard/Format
import Standard/Os

routine show(v: B64) -> None
    Out.write("{v.bits()}\n")
    return

routine start() -> None
    show(1.4426950408889634)  # log2(e)
    show(105553116266496.0)
    show(5e-324)  # the smallest subnormal
    show(1.7976931348623157e308)  # B64.MAX
    show(-3.141592653589793)  # -pi
    show(1.0)  # 1.0
    show(10.734375)  # 171.75 / 16
    show(0.0)
    f: B32 = 1.7014118346046923e38
    Out.write("{f.bits()}\n")
    # Without a p exponent it is an integer, and `.add` a method call.
    n: U32 = 0x10 + 1
    Out.write("{n}\n")
    return
