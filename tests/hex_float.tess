// Hex float literals: hex digits scaled by a power of two (the p exponent is decimal and required), exactly an F64.

import Standard::Format
import Standard::Os

routine show(v: F64) -> Void
    block entry():
        Out.write("{v.bits()}\n")
        return()

routine main() -> S32
    block entry():
        show(0x1.71547652b82fep+0)  // log2(e)
        show(0x1.8p+46)
        show(0x1p-1074)  // the smallest subnormal
        show(0x1.fffffffffffffp+1023)  // F64.MAX
        show(-0x1.921fb54442d18p+1)  // -pi
        show(0x0.8p+1)  // 1.0
        show(0xA_B.Cp-4)  // 171.75 / 16
        show(0x0p+0)
        f : F32 = 0x1p+127
        Out.write("{f.bits()}\n")
        // Without a p exponent it is an integer, and `.add` a method call.
        n : U32 = 0x10.add(1)
        Out.write("{n}\n")
        return(0)
