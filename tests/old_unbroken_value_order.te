# An Unbroken[T] routine takes its memory order as a type argument: peek_acquire says peek[ACQUIRE].

import Hosted

record Counters
    hits: Unbroken[U64]

routine start() -> None
    c: &Counters <- Counters(hits: Unbroken[U64](value: 0))
    seen: U64 = c.hits.peek_acquire()
    Console.show("{seen}")
    return
