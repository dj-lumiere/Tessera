// RISC-V assembly: F registers for floats, a dotted mnemonic between backticks, offset(n) as n(reg), and branches that
// compare two registers.

import Standard::Format
import Standard::Os

#[target(arch: "riscv64"), external("asm"), pure]
routine fma(a: F64, b: F64, c: F64) -> F64
    block entry()
        `fmadd.d`<F64, F64, F64, F64>(F10, a, b, c)
        return(F10)

#[target(arch: "riscv64"), external("asm"), readonly]
routine third(p: @U64) -> U64
    block entry()
        ld<U64, U64>(R10, p.offset(16))
        fld<F64, F64>(F11, p.offset(8))
        return(R10)

#[target(arch: "riscv64"), external("asm")]
routine count(n: U64) -> U64
    block entry()
        li<U64>(R10, 0)
        jump check()

    block check()
        branch eq<U64>(n, ZERO)
            ? done()
            : body()

    block body()
        addi<U64, U64>(R10, R10, 1)
        addi<U64, U64>(n, n, -1)
        jump check()

    block done()
        `fence.i`()
        return(R10)

routine main() -> S32
    block entry()
        f : F64 = fma(2.0, 3.0, 0.5)
        claim cells : @Array<U64, 4> <- { 1, 2, 3, 4 }
        t : U64 = third(cells.to<@U64>())
        n : U64 = count(5)
        Out.write("fma {f} third {t} count {n}\n")
        return(0)
