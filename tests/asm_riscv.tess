// RISC-V assembly: FREG for floats, a dotted mnemonic between backticks, offset(n) as n(reg), and branches that
// compare two registers.

import Standard::Format

#[target(arch: "riscv64"), external("asm"), pure]
routine fma(%a: F64, %b: F64, %c: F64) -> F64
    block entry():
        FREG10.`fmadd.d`<F64, F64, F64, F64>(%a, %b, %c)
        return(FREG10)

#[target(arch: "riscv64"), external("asm"), readonly]
routine third(%p: @U64) -> U64
    block entry():
        REG10.ld<U64, U64>(%p.offset(16))
        FREG11.fld<F64, F64>(%p.offset(8))
        return(REG10)

#[target(arch: "riscv64"), external("asm")]
routine count(%n: U64) -> U64
    block entry():
        REG10.li<U64>(0)
        jump check()

    block check():
        branch %n.eq<U64>(ZERO)
            ? done()
            : body()

    block body():
        REG10.addi<U64, U64>(REG10, 1)
        %n.addi<U64, U64>(%n, -1)
        jump check()

    block done():
        `fence.i`()
        return(REG10)

routine main() -> S32
    block entry():
        %f : F64 = fma(2.0, 3.0, 0.5)
        claim %cells : @Array<U64, 4> <- { 1, 2, 3, 4 }
        %t : U64 = third(%cells.cast<U64>())
        %n : U64 = count(5)
        print("fma {%f} third {%t} count {%n}\n")
        return(0)
