; Correctly rounded float parsing, printed back as F64 F32 F16 BF16. Generated by
; scripts/gen_float_parse_tests.py; do not edit.

routine show<T>(#out: Ptr<FdWriter>, %parsed: Result<T, ParseFloatError>) -> Void
require T: typename
    block entry():
        %ok: Bool = %parsed.tag
        branch %ok ? value(%parsed.value) : error()

    block value(%v: T):
        %v.format(#out)
        return()

    block error():
        write_str(#out, "error")
        return()

routine check(#out: Ptr<FdWriter>, %text: String) -> Void
    block entry():
        show(#out, F64.parse(%text))
        write_str(#out, " ")
        show(#out, F32.parse(%text))
        write_str(#out, " ")
        show(#out, F16.parse(%text))
        write_str(#out, " ")
        show(#out, BF16.parse(%text))
        write_line(#out)
        return()

