# A steal out of a place that keeps a Box? gives a Box? again: the place may have held None, so the line that
# uses it as a Box looks with `when` first. Handing it on with steal or ending it with drop needs no look.

import Collections
import Hosted

### A box.
entity Box
    n: U64

### Makes a box.
### :param n: Its number.
### :returns: The box.
common routine Box.construct(n: U64) -> Me
    return Me(n)

### Takes the box out of a slot and says what it held.
### :param slots: The list of slots.
### :param at: The slot's index.
routine empty_slot(slots: @List[Box?], at: U64) -> None
    steal slots.getslot(at) as kid inject None()
    when kid
        is None =>
            Console.show("slot {at}: none")
        is Box as b =>
            Console.show("slot {at}: n = {b.n.peek()}")
    drop kid
    return

### Moves a slot's box to the end of the list without looking at it.
### :param slots: The list of slots.
### :param at: The slot's index.
routine move_to_end(slots: @List[Box?], at: U64) -> None
    steal slots.getslot(at) as kid inject None()
    slots.add_last(steal kid)
    return

### Runs the steals.
routine start() -> None
    slots: &List[Box?] <- .construct(HEAP)
    slots.add_last(None())
    fresh: &Box <- Box.construct(n: 7) from HEAP
    slots.add_last(steal fresh)
    empty_slot(slots, 0)
    empty_slot(slots, 1)
    move_to_end(slots, 0)
    Console.show("count: {slots.count()}")
    drop slots
    return
