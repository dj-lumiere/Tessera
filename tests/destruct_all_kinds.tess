// destruct_all instantiates for the other collections that hold owned elements.

import Standard::Alloc
import Standard::Collections
import Standard::Format

/// A SortedList element that owns memory: ordered by rank, destructs its list.
record Owned
conform Compare<Owned>, Destruct<Owned>
    rank  : S64
    items : List<S64>

routine Owned.compare(%a: Self, %b: Self) -> S32
    block entry():
        %r : S32 = %a.rank.compare(%b.rank)
        return(%r)

routine Owned.destruct(#self: Ptr<Self>) -> Void
    block entry():
        #self.items.destruct()
        return()

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim #alloc : Ptr<Allocator>
        #alloc.store(%heap)
        %c_val : CircularList<List<S64>> = .construct(#alloc)
        claim #c : Ptr<CircularList<List<S64>>>
        #c.store(%c_val)
        %inner : List<S64> = .construct(#alloc)
        #c.push_back(%inner)
        #c.destruct_all()
        %s_val : SortedList<Owned> = .construct(#alloc)
        claim #s : Ptr<SortedList<Owned>>
        #s.store(%s_val)
        %owned_items : List<S64> = .construct(#alloc)
        #s.push(Owned { rank: 1, items: %owned_items })
        #s.destruct_all()
        %t_val : SortedDict<S64, List<S64>> = .construct(#alloc)
        claim #t : Ptr<SortedDict<S64, List<S64>>>
        #t.store(%t_val)
        #t.destruct_all_values()
        print("ok\n")
        return(0)
