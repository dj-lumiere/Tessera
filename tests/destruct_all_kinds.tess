# drop ends the elements of the other owning collections too: a CircularList of lists and a List of sets.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

### Drops collections that own collections.
routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local c: @CircularList[List[S64]] <- .construct(alloc)

    c.add_last(List[S64].construct(alloc))
    c.add_first(List[S64].construct(alloc))
    c.getslot(0).add_last(4)
    Out.write("{c}\n")
    drop c
    local s: @List[Set[S64]] <- .construct(alloc)
    s.add_last(Set[S64].construct(alloc))
    s.getslot(0).add(9)
    Out.write("{s}\n")
    drop s
    Out.write("ok\n")
    return
