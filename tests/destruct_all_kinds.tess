// destruct_all instantiates for the other collections that hold owned elements.
routine main() -> S32
    block entry():
        %heap: Allocator = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %c_val: CircularList<List<S64>> = CircularList<List<S64>>.construct(#alloc)
        #c: Ptr<CircularList<List<S64>>> = alloca<CircularList<List<S64>>>([%c_val])
        %inner: List<S64> = List<S64>.construct(#alloc)
        #c.push_back(%inner)
        #c.destruct_all()
        %s_val: SortedList<List<S64>> = SortedList<List<S64>>.construct(#alloc)
        #s: Ptr<SortedList<List<S64>>> = alloca<SortedList<List<S64>>>([%s_val])
        #s.destruct_all()
        %t_val: SortedDict<S64, List<S64>> = SortedDict<S64, List<S64>>.construct(#alloc)
        #t: Ptr<SortedDict<S64, List<S64>>> = alloca<SortedDict<S64, List<S64>>>([%t_val])
        #t.destruct_all_values()
        println_slice("ok")
        return(0)
