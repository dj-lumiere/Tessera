// destruct_all instantiates for the other collections that hold owned elements.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

/// A SortedList element that owns memory: ordered by rank, destructs its list.
record Owned
conform Comparable<Owned>, Destructible<Owned>
    rank  : S64
    items : List<S64>

routine Owned.compare(me: Me, other: Me) -> S32
    block entry()
        r : S32 = me.rank.compare(other.rank)
        return(r)

routine Owned.destruct(me: @Me) -> Void
    block entry()
        me.items.destruct()
        return()

routine start() -> Void
    block entry()
        claim alloc : @Allocator               <- make_heap_allocator()
        claim c     : @CircularList<List<S64>> <- .construct(alloc)
        inner : List<S64> = .construct(alloc)
        c.push_back(inner)
        c.destruct_all()
        claim s : @SortedList<Owned> <- .construct(alloc)
        owned_items : List<S64> = .construct(alloc)
        s.push(Owned { rank: 1, items: owned_items })
        s.destruct_all()
        claim t : @SortedDict<S64, List<S64>> <- .construct(alloc)
        t.destruct_all_values()
        Out.write("ok\n")
        return()
