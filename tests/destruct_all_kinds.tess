// destruct_all instantiates for the other collections that hold owned elements.
routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim #alloc : Ptr<Allocator>
        #alloc.store(%heap)
        %c_val : CircularList<List<S64>> = .construct(#alloc)
        claim #c : Ptr<CircularList<List<S64>>>
        #c.store(%c_val)
        %inner : List<S64> = .construct(#alloc)
        #c.push_back(%inner)
        #c.destruct_all()
        %s_val : SortedList<List<S64>> = .construct(#alloc)
        claim #s : Ptr<SortedList<List<S64>>>
        #s.store(%s_val)
        #s.destruct_all()
        %t_val : SortedDict<S64, List<S64>> = .construct(#alloc)
        claim #t : Ptr<SortedDict<S64, List<S64>>>
        #t.store(%t_val)
        #t.destruct_all_values()
        print("ok\n")
        return(0)
