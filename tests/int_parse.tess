// text.to_result<T>() reads a decimal integer: a sign, then digits. Each type's ends read, one past them is OutOfRange,
// and empty text, a lone sign, and other characters fail. text.to<T>() is the same conversion that crashes instead.

import Standard::Format
import Standard::Os

routine error_name(e: ParseError) -> Bytes
    block entry()
        when e
            ParseError.Empty      -> return("Empty")
            ParseError.Invalid    -> return("Invalid")
            ParseError.OutOfRange -> return("OutOfRange")

routine s32(text: Bytes) -> Void
    block entry()
        r : Result<S32, ParseError> = text.to_result<S32>()
        when r
            .Success(v)     -> ok(v)
            .Failure(error) -> failed(error)

    block ok(v: S32)
        Out.write("S32 \"{text}\": {v}\n")
        return()

    block failed(error: ParseError)
        Out.write("S32 \"{text}\": {error_name(error)}\n")
        return()

routine s8(text: Bytes) -> Void
    block entry()
        r : Result<S8, ParseError> = text.to_result<S8>()
        when r
            .Success(v)     -> ok(v)
            .Failure(error) -> failed(error)

    block ok(v: S8)
        Out.write("S8 \"{text}\": {v}\n")
        return()

    block failed(error: ParseError)
        Out.write("S8 \"{text}\": {error_name(error)}\n")
        return()

routine u32(text: Bytes) -> Void
    block entry()
        r : Result<U32, ParseError> = text.to_result<U32>()
        when r
            .Success(v)     -> ok(v)
            .Failure(error) -> failed(error)

    block ok(v: U32)
        Out.write("U32 \"{text}\": {v}\n")
        return()

    block failed(error: ParseError)
        Out.write("U32 \"{text}\": {error_name(error)}\n")
        return()

routine main() -> S32
    block entry()
        s32("42")
        s32("-42")
        s32("+7")
        s32("2147483647")
        s32("-2147483648")
        s32("2147483648")
        s32("-2147483649")
        s32("")
        s32("-")
        s32("12a")
        s32(" 1")
        s8("-128")
        s8("127")
        s8("128")
        u32("4294967295")
        u32("4294967296")
        u32("-0")
        u32("-1")
        max_text : Bytes = "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        big      : U256  = max_text.to<U256>()
        Out.write("U256 max: {big}\n")
        over_text : Bytes                    = "115792089237316195423570985008687907853269984665640564039457584007913129639936"
        over      : Result<U256, ParseError> = over_text.to_result<U256>()
        Out.write("U256 max + 1: {error_name(over.unwrap_failure())}\n")
        least_text : Bytes = "-57896044618658097711785492504343953926634992332820282019728792003956564819968"
        least      : S256  = least_text.to<S256>()
        Out.write("S256 min: {least}\n")
        count_text : Bytes = "123"
        n          : USize = count_text.to<USize>()
        Out.write("USize: {n}\n")
        return(0)
