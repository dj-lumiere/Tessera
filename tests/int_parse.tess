// T.parse reads a decimal integer: a sign, then digits. Each type's ends read, one past them is OutOfRange, and empty
// text, a lone sign, and other characters fail.

import Standard::Format
import Standard::Os

routine error_name(e: ParseIntError) -> Bytes
    block entry():
        when e:
            ParseIntError.Empty      -> return("Empty")
            ParseIntError.Invalid    -> return("Invalid")
            ParseIntError.OutOfRange -> return("OutOfRange")

routine s32(text: Bytes) -> Void
    block entry():
        r : Result<S32, ParseIntError> = S32.parse(text)
        when r:
            .Success(v)     -> ok(v)
            .Failure(error) -> failed(error)

    block ok(v: S32):
        Out.write("S32 \"{text}\": {v}\n")
        return()

    block failed(error: ParseIntError):
        Out.write("S32 \"{text}\": {error_name(error)}\n")
        return()

routine s8(text: Bytes) -> Void
    block entry():
        r : Result<S8, ParseIntError> = S8.parse(text)
        when r:
            .Success(v)     -> ok(v)
            .Failure(error) -> failed(error)

    block ok(v: S8):
        Out.write("S8 \"{text}\": {v}\n")
        return()

    block failed(error: ParseIntError):
        Out.write("S8 \"{text}\": {error_name(error)}\n")
        return()

routine u32(text: Bytes) -> Void
    block entry():
        r : Result<U32, ParseIntError> = U32.parse(text)
        when r:
            .Success(v)     -> ok(v)
            .Failure(error) -> failed(error)

    block ok(v: U32):
        Out.write("U32 \"{text}\": {v}\n")
        return()

    block failed(error: ParseIntError):
        Out.write("U32 \"{text}\": {error_name(error)}\n")
        return()

routine main() -> S32
    block entry():
        s32("42")
        s32("-42")
        s32("+7")
        s32("2147483647")
        s32("-2147483648")
        s32("2147483648")
        s32("-2147483649")
        s32("")
        s32("-")
        s32("12a")
        s32(" 1")
        s8("-128")
        s8("127")
        s8("128")
        u32("4294967295")
        u32("4294967296")
        u32("-0")
        u32("-1")
        big : U256 = U256.parse("115792089237316195423570985008687907853269984665640564039457584007913129639935").unwrap()
        Out.write("U256 max: {big}\n")
        over : Result<U256, ParseIntError> = U256.parse("115792089237316195423570985008687907853269984665640564039457584007913129639936")
        Out.write("U256 max + 1: {error_name(over.unwrap_failure())}\n")
        least : S256 = S256.parse("-57896044618658097711785492504343953926634992332820282019728792003956564819968").unwrap()
        Out.write("S256 min: {least}\n")
        n : USize = USize.parse("123").unwrap()
        Out.write("USize: {n}\n")
        return(0)
