// The extended-precision intermediates of the F64 pow and trig kernels round to an F64 that keeps their sign when
// they overflow or underflow: a negative base with an odd exponent can land there.

import Standard::Format
import Standard::Os

routine main() -> S32
    shared top : U128 = U128.shl(1, 127)

    block entry()
        p_over  : F64 = CmF64PowDint { r: top, ex: 1100, sgn: 1 }.to<F64>()
        p_under : F64 = CmF64PowDint { r: top, ex: -1100, sgn: 1 }.to<F64>()
        p_pos   : F64 = CmF64PowDint { r: top, ex: 1100, sgn: 0 }.to<F64>()
        q_over  : F64 = CmF64PowQint { rh: top, rl: 0, ex: 1100, sgn: 1 }.to<F64>()
        q_under : F64 = CmF64PowQint { rh: top, rl: 0, ex: -1100, sgn: 1 }.to<F64>()
        q_pos   : F64 = CmF64PowQint { rh: top, rl: 0, ex: -1100, sgn: 0 }.to<F64>()
        t_over  : F64 = CmF64TrigDint { r: top, ex: 1100, sgn: 1 }.to<F64>()
        t_under : F64 = CmF64TrigDint { r: top, ex: -1100, sgn: 1 }.to<F64>()
        t_pos   : F64 = CmF64TrigDint { r: top, ex: -1100, sgn: 0 }.to<F64>()
        Out.write("pow dint: {p_over.diagnose()} {p_under.diagnose()} {p_pos.diagnose()}\n")
        Out.write("pow qint: {q_over.diagnose()} {q_under.diagnose()} {q_pos.diagnose()}\n")
        Out.write("trig dint: {t_over.diagnose()} {t_under.diagnose()} {t_pos.diagnose()}\n")
        return(0)
