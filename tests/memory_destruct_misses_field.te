# An entity's destruct never gives back its Memory field.

import Standard/Os

### Holds memory.
entity Q
    m: Memory[S64]

### An empty one.
### :returns: It.
common routine Q.construct() -> Me
    return Me(m: .hollow())

### Gives back nothing.
routine @Q.destruct() -> None
    return

routine start() -> None
    q: &Q <- .construct()

    q.m.replace(value: Memory[S64].construct(values: [7], times: 4, manager: HEAP))
    drop q
    Console.show("done")
    return
