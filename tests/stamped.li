# Stamped: a link to an entity that sees when the entity has ended. A stamp fetches the entity while it lives, wherever
# it moves, and fails (StaleStampError, received with try) once it is dropped, given back with its STACK place, or
# written over. A slot freed by one entity goes to the next with a newer generation, so the old stamp still fails.

import Collections
import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### What a stamp holds now: its node's value, or -1 when it is stale.
### :param s: The stamp.
### :returns: The value or -1.
routine value_of(s: Stamped[Node]?) -> S64
    when try s.fetch()
        is @Node as n => return n.value.peek()
        is None => return -1

### A stamp of a node that is given back with this routine's STACK place.
### :returns: The stamp, stale once this returns.
routine stamp_of_local() -> Stamped[Node]
    n: &Node <- Node.construct(value: 5)
    return n.stamp()

### Hands a node out of a STACK place: it leaves the place's address.
### :param out: The stamp of the node before it leaves.
### :returns: The node.
routine hand_out(out: @(Stamped[Node]?)) -> Node
    n: &Node <- Node.construct(value: 6)
    out.poke(n.stamp())
    return n

### Shows what each stamp fetches as its node ends, moves, or stays.
routine start() -> None
    PoolManager.set_up(memory: HEAP)
    a: &Node <- Node.construct(value: 1) from HEAP
    s: Stamped[Node] = a.stamp()
    again: Stamped[Node] = a.stamp()
    Console.show("fetch: {value_of(s)}, same slot: {s === again}")
    a.value.poke(10)
    Console.show("after a change: {value_of(s)}")
    drop a
    Console.show("after drop: {value_of(s)}")

    # The freed slot goes to the next node, a generation later: the old stamp still fails.
    b: &Node <- Node.construct(value: 2) from HEAP
    t: Stamped[Node] = b.stamp()
    Console.show("old: {value_of(s)}, new: {value_of(t)}, other entity: {s !== t}")

    # A STACK place given back ends its node.
    Console.show("local after return: {value_of(stamp_of_local())}")

    # Written over: the old node ends, and the new one has no stamp yet.
    c: &Node <- Node.construct(value: 3)
    u: Stamped[Node] = c.stamp()
    c <- Node.construct(value: 4)
    Console.show("written over: {value_of(u)}, place: {c.value.peek()}")

    # Moved to HEAP from STACK: the stamp follows the node to its new address.
    d: &Node <- Node.construct(value: 7)
    v: Stamped[Node] = d.stamp()
    moved: &Node <- steal d from HEAP
    Console.show("moved to HEAP: {value_of(v)}, there: {value_of(moved.stamp())}")
    drop moved

    # Returned from a STACK place: the node and its stamp move to the caller's place.
    w: &(Stamped[Node]?) <- None()
    e: &Node <- hand_out(out: w)
    Console.show("handed out: {value_of(w.load())}, value: {e.value.peek()}")

    # steal a as b keeps the stamp: the node moves along with it.
    f: &Node <- Node.construct(value: 8) from HEAP
    x: Stamped[Node] = f.stamp()
    steal f as g
    Console.show("steal as (HEAP): {value_of(x)}")
    drop g
    h: &Node <- Node.construct(value: 9)
    y: Stamped[Node] = h.stamp()
    steal h as k
    Console.show("steal as (STACK): {value_of(y)}")
    drop k
    Console.show("after drop: {value_of(y)}")

    # A List that grows moves its elements: their stamps follow.
    xs: &List[Node] <- .construct(HEAP)
    xs.add_last(Node.construct(value: 11))
    z: Stamped[Node] = xs.getslot(0).stamp()
    Console.show("in a list: {value_of(z)}")
    for i in 0 til 100
        xs.add_last(Node.construct(value: i))
    Console.show("after it grew: {value_of(z)}, still there: {xs.getslot(0).value.peek()}")
    drop xs

    # A bare fetch of a stale stamp stops the program.
    Console.show("bare fetch: {s.fetch().value.peek()}")
    drop b
    return
