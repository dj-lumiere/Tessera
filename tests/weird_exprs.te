### Expressions that are legal but stack features the way a real program does, in the spirit of rustc's
### weird-exprs and its RazorForge and Suflae twins. Each line is a combination worth keeping working.
import Hosted

### A single value.
record Box[T]
needs RecordType T
    value: T

### Makes a `Box` from its fields.
### :param value: Its `value`.
### :returns: The new value.
common routine Box[T].construct(value: T) -> Me
    return Me(value)

### Releases nothing: a `Box` holds no memory of its own.
routine @Box[T].destruct() -> None
    return

### Puts a value in a box.
### :param x: The value.
### :returns: The box.
routine wrap[T](x: T) -> Box[T]
needs RecordType T
    return Box[T](value: x)

### Adds up 1 to `last`, skipping multiples of 3, with the running state carried by block arguments and the
### choice made by a `when` terminator.
### :param last: The last number.
### :returns: The sum.
routine skip_threes(last: S64) -> S64
    for i in 1 to last with sum: S64 = 0
        when
            i % 3 == 0 => continue with sum: sum
            else => continue with sum: sum + i
    then
        return sum

### Shows each combination on its own line.
routine start() -> None
    a: S64 = 3
    b: S64 = 8

    # A value select whose two sides are method chains.
    m: S64 = when
        a < b => (a + b) * 2
        else => b - a
    Console.show("select_chains: {m}")

    # A generic call nested in a generic call, read through two fields inside a format hole.
    Console.show("nested_generic_in_hole: {wrap[Box[S64]](wrap[S64](5)).value.value}")

    # Load, act, store through a pointer, then read it back in a hole.
    p: &S64 <- 5
    (p.load() + 1).poke_into(p)
    (p.load() * 3).poke_into(p)
    Console.show("pointer_chain: {p.load()}")

    # Conversions chained with arithmetic on both sides.
    n: S32 = 41
    w: S64 = (n.to[U64]() + 1).to[S64]()
    Console.show("conversion_chain: {w} {w.to_wrap[U8]()}")

    # A record built from a select, its field read through a generic box.
    larger: S64 = when
        b > a => b
        else => a
    boxed: Box[S64] = wrap[S64](larger)
    Console.show("select_into_generic: {boxed.value}")

    # A loop with block arguments and a when terminator.
    Console.show("skip_threes: {skip_threes(10)}")
    return
