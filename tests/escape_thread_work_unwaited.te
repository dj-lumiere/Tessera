# Work handed the address of a local, and the routine returns without waiting for it.

import Standard/Os

global TICKET: &Thread[S64] <- .hollow()

### Reads an address.
### :param p: The address.
### :returns: What it holds.
routine read(p: @S64) -> S64
    return p.peek()

### Starts the work and keeps the ticket for later.
routine fill() -> None
    l: &S64 <- 1234567

    t: Thread[S64] <- get_thread[S64]()
    work_t: Work[S64] <- read.to[Work](p: l)
    t.put_work(work_t)
    drop work_t
    TICKET.poke(t)
    return

routine start() -> None
    fill()
    t: Thread[S64] <- TICKET.peek()
    t.wait_finished()
    Console.show("{t.retrieve()}")
    drop t
    return
