# A &[Byte] is a collection: shown, it writes its list, as an Items[Byte, N] does. Only the view @[Byte] writes text.
import Hosted

routine start() -> None
    stack: &[Byte] <- "Lu"
    heap: &[Byte] <- [0x4C, 0x75] from HEAP
    view: @[Byte] = "Lu"
    items: Items[Byte, 2] = [0x4C, 0x75]
    one: Byte = 0x4C
    Console.show("{stack} {heap} {items}")
    Console.show("{view} {stack.getview()} {heap.getslice()}")
    Console.show("{one} {one.diagnose()}")
    drop heap
    return
