# \xXX is one byte as it is, \uXXXXXX a character in UTF-8, so "\u01F600" and "\xF0\x9F\x98\x80" are the same four
# bytes. @[Byte].is_utf8 rejects malformed sequences (overlong forms and surrogates included), chars() reads each as
# U+FFFD, is_char_boundary finds where characters start, and diagnose writes bytes that read back the same.

import Standard/Os

routine count_chars(text: @[Byte]) -> U64
    iter: &BytesCharsIter <- text.chars()

    loop with count: U64 = 0
        c: Maybe[Char] = try iter.emit()
        when c
            is Char as char => continue with count: count + 1
            is None => return count

routine start() -> None
    emoji: @[Byte] = "😀"
    raw: @[Byte] = "\xF0\x9F\x98\x80"
    Console.show("same: {emoji.eq(raw)} {emoji.count()} {raw.count()} {count_chars(raw)}")
    e_char: @[Byte] = "é"
    e_byte: @[Byte] = "\xE9"
    Console.show("e: {e_char.count()} {e_char.is_utf8()} {e_byte.count()} {e_byte.is_utf8()}")
    c: Char = '\u0000E9'
    b: Byte = b'\xE9'
    Console.show("literals: {c.to[U32]()} {b.to[U8]()}")
    hangul: @[Byte] = "안녕"
    overlong: @[Byte] = "\xC0\x80"
    surrogate: @[Byte] = "\xED\xA0\x80"
    truncated: @[Byte] = "\xE2\x82"
    too_big: @[Byte] = "\xF4\x90\x80\x80"
    Console.show("is_utf8: {hangul.is_utf8()} {overlong.is_utf8()} {surrogate.is_utf8()} {truncated.is_utf8()} {too_big.is_utf8()}")
    Console.show("chars: {count_chars(hangul)} {count_chars(overlong)} {count_chars(surrogate)}")
    mixed: @[Byte] = "a안"
    Console.show("boundary: {mixed.is_char_boundary(0)} {mixed.is_char_boundary(1)} {mixed.is_char_boundary(2)} {mixed.is_char_boundary(3)} {mixed.is_char_boundary(4)} {mixed.is_char_boundary(5)}")
    odd: @[Byte] = "a\xFF안"
    ctl: Char = '\u000001'
    out: @ConsoleOutput = Console.output()
    odd.diagnose_into(out)
    write_str(out, text: " ")
    ctl.diagnose_into(out)
    write_line(out)
    return
