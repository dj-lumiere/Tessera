# A routine that keeps what it is handed in a plain global, handed the address of a @threadlocal, is a build error.
module C84/ThreadlocalThroughCallee
import Hosted

@threadlocal
global COUNTER: &S64 <- 1234567

lateinit global KEPT: &@S64

### Keeps the address in a plain global.
### :param p: The address.
routine stash(p: @S64) -> None
    KEPT.poke(p)
    return

### The running thread's counter address.
### :returns: The address.
routine where_is() -> @S64
    return COUNTER

### Runs the example.
routine start() -> None
    stash(where_is())
    Console.show("kept: {KEPT.peek().peek()}")
    return
