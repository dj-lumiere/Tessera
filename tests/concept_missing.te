### A generic routine's concept constraint needs a declared conformance.
record Point
    x: S64

routine Point.eq(other: Me) -> Bool
    return true

routine same[T](a: T, b: T) -> Bool
needs T obeys Equatable
    return a == b

routine start() -> None
    p: Point = Point(x: 1)
    s: Bool = same(a: p, b: p)
    return
