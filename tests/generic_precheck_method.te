### A generic body is checked against its own constraints before anything instantiates it: `a.compare(b)` needs
### Comparable[T], which `largest` doesn't say, so it is an error at `largest` though nothing calls it.
routine largest[T](a: T, b: T) -> T
needs T: typename
    order: S32 = a.compare(b)
    first: Bool = order >= 0
    r: T = when
        first => a
        else => b
    return r

routine start() -> None
    return
