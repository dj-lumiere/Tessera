# Tuples: (A, B) to (A, B, C, D) as types, (a, b) as values, and the one binding that takes a value apart,
# q, r = .... They compare, hash, and print item by item, and they go wherever a type does: returns, generic
# arguments, collections, and Callable signatures, where the first parenthesized list is still the parameters.

import Standard/Collections
import Standard/Os

routine div_rem(a: U64, b: U64) -> (U64, U64)
    return (a // b, a % b)

routine swap[TFirst, TSecond](pair: (TFirst, TSecond)) -> (TSecond, TFirst)
needs TFirst: typename, TSecond: typename
    first, second = pair
    return (second, first)

routine apply(f: Callable[(S64, S64), (S64, S64)], a: S64, b: S64) -> (S64, S64)
    return f.call(a, b)

routine sum_and_difference(a: S64, b: S64) -> (S64, S64)
    return (a + b, a - b)

routine start() -> None
    q, r = div_rem(a: 17, b: 5)
    Console.show("17 = 5 * {q} + {r}")

    named: (@[Byte], S64) = ("seven", 7)
    swapped: (S64, @[Byte]) = swap[@[Byte], S64](named)
    Console.show("{named} swapped is {swapped}")

    s, d = apply(f: sum_and_difference.to[Callable](), a: 10, b: 3)
    Console.show("sum {s}, difference {d}")

    four: (Bool, U8, Char, @[Byte]) = (true, 255, 'x', "end")
    flag, byte, char, text = four
    Console.show("{four}: {flag} {byte} {char} {text}")

    a: (S64, S64) = (1, 2)
    b: (S64, S64) = (1, 3)
    Console.show("eq {a.eq(a)} {a.eq(b)}, compare {a.compare(b)} {b.compare(a)}, ", end: "")
    c: (S64, S64) = (1, 2)
    Console.show("same hash {a.hash().eq(c.hash())}")

    local alloc: @MemoryManager <- HEAP.peek()
    local scores: @Dict[(@[Byte], S64), Bool] <- .construct(alloc)
    scores[("ada", 1)] = true
    scores[("bob", 2)] = false
    scores[("ada", 1)] = false
    Console.show("dict {scores} has (bob, 2): {scores.has_key((\"bob\", 2))}")
    drop scores
    return
