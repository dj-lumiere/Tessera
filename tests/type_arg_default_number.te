# A default is a value its parameter takes: a number where a choice member goes is a build error.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### One order for every thread.
    SEQ_CST

### The rank of O.
### :typeparam O: The order.
### :returns: 0 or 1.
routine rank[O]() -> U64
needs O: Order = 1
    return when O
        Order.RELAXED => 0
        Order.SEQ_CST => 1

### Runs.
routine start() -> None
    return
