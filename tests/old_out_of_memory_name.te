# A manager with no memory to give throws OutOfMemoryError: the old name says the new one.

import Standard/Collections
import Standard/Os

routine start() -> None
    list: &List[S64] <- List[S64].construct(HEAP)
    when check list.reserve(capacity: 4)
        is None => Console.show("grew")
        is MemoryAllocationError => Console.show("no memory")
    drop list
    return
