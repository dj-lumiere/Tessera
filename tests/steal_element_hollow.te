# steal out of an element's place leaves it hollow, like a field's: reading it before a value is put back is a build
# error, followed by the place's spelling.

import Standard/Alloc
import Standard/Collections
import Standard/Os

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n)

### Ends it.
routine @Counter.destruct() -> None
    return

routine start() -> None
    local xs: @List[Counter] <- .construct(DEFAULT_HEAP)

    xs.add_last(Counter.construct(1))
    local c: @Counter <- steal xs.getslot(0)
    n: S64 = xs.getslot(0).n.peek()
    drop c
    drop xs
    return
