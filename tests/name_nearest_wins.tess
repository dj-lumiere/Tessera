// A bare name is the nearest value: a local named like a preset or a type is that local in its block, a call still
// names the routine, and a value named like a keyword is written between backticks.

import Standard::Format
import Standard::Os

preset LIMIT: S64 = 10

routine twice(x: S64) -> S64
    block entry():
        return(x.mul(2))

routine main() -> S32
    block entry():
        before : S64 = LIMIT
        LIMIT  : S64 = 3
        twice  : S64 = twice(LIMIT)
        `block` : S64 = twice.add(before)
        Out.write("{before} {LIMIT} {twice} {`block`}\n")
        jump next(`block`)

    block next(`return`: S64):
        Out.write("{`return`}\n")
        return(0)
