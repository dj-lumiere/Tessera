# The builder writes this destruct for entity Tower (tests/destruct_shown.te:11).
### Gives back what the value holds, the last field first: the builder's walk over its fields.
@derived(implicit)
routine @Tower.destruct() -> None
    drop me.second
    drop me.first
    return

# The builder writes this destruct for variant MaybeBell (tests/destruct_shown.te:17).
### Gives back what the value holds, the last field first: the builder's walk over its fields.
@derived(implicit)
routine @MaybeBell.destruct() -> None
    when steal me.stride(0)
        is Bell as held =>
            drop held
        is None => nothing
    me.stride(0).poke(.hollow())
    return
