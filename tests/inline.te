# @inline asks LLVM to inline a routine at every call (alwaysinline). The program means the same either way.

import Standard/Format
import Standard/Os

@inline
routine mix(h: U64, v: U64) -> U64
    return (h ^ v) *% 0x100000001B3

routine start() -> None
    h: U64 = mix(h: mix(h: 0xCBF29CE484222325, v: 1), v: 2)
    Out.write("{h}\n")
    return
