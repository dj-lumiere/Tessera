# The Crash service has one slot for the reporting routine: report_with puts a routine in it and gives back the one it
# held (hollow for the default), so a routine can be put back. A crash then reports with the routine in the slot, which
# here writes on standard output and exits with status 3.

import Hosted

### The program's configuration is missing.
crashable ConfigurationError
    nothing

### Writes `The configuration file is missing.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine ConfigurationError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The configuration file is missing.")
    return

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports with "first".
@untraced
routine first(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("first: {name}: {message.text()}")
    exit(3)

### Reports with "second", and the line.
@untraced
routine second(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    line: U32 = place.line.peek()
    Console.show("second: {name}: {message.text()} (line {line})")
    exit(3)

routine start() -> None
    was: Callable[(@[Byte], @CrashMessage, @SourceLocation), None]? = Crash.report_with(first.to[Callable]())
    Console.show("default before: {was.is_absent()}")
    back: Callable[(@[Byte], @CrashMessage, @SourceLocation), None] = Crash.report_with(second.to[Callable]()).unwrap()
    Console.show("first came back: {back.addr() === first.addr()}")
    held: Callable[(@[Byte], @CrashMessage, @SourceLocation), None] = Crash.reporter().unwrap()
    Console.show("second is held: {held.addr() === second.addr()}")
    throw ConfigurationError()
