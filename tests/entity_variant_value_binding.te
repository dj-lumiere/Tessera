# A variant that holds an entity holds one, so it lives in a place like one: a value binding would copy it.
import Standard/Os

define Opened = Counter | ParseFailed

### Counts things.
entity Counter
    count: S64

### Why no counter was made.
record ParseFailed
    at: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing: a Counter holds no memory.
routine @Counter.destruct() -> None
    return

### A counter, or why not.
### :param n: Fails when negative.
### :returns: The counter, or the failure.
routine open(n: S64) -> Opened
    if n < 0
        return ParseFailed(at: n)
    return Counter.construct()

### Observes one.
routine start() -> None
    r: Opened = open(1)
    return
