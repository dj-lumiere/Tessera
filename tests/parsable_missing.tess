// A conformance to Parsable<T> needs the conversion Bytes.to_result<T>: one defined for another type doesn't count.

import Standard::Format

record Celsius
conform Parsable<Celsius>
    degrees : S32

record Fahrenheit
    degrees : S32

routine Bytes.to_result<Fahrenheit>(self: Self) -> Result<Fahrenheit, ParseError>
    block entry()
        return(.Failure(ParseError.Invalid))

routine start() -> Void
    block entry()
        return()
