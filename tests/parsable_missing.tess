// A conformance to Parsable[T] needs the conversion Bytes.to_result[T]: one defined for another type doesn't count.

import Standard/Format

record Celsius
conform Parsable[Celsius]
    degrees: S32

record Fahrenheit
    degrees: S32

/// Makes a `Celsius` from its fields.
/// :param degrees: Its `degrees`.
/// :returns: The new value.
routine Celsius.construct(degrees: S32) -> Me
    return(Me(degrees))

/// Releases nothing: a `Celsius` holds no memory of its own.
routine Celsius.destruct(me: @Me) -> Void
    return()

/// Makes a `Fahrenheit` from its fields.
/// :param degrees: Its `degrees`.
/// :returns: The new value.
routine Fahrenheit.construct(degrees: S32) -> Me
    return(Me(degrees))

/// Releases nothing: a `Fahrenheit` holds no memory of its own.
routine Fahrenheit.destruct(me: @Me) -> Void
    return()

routine Bytes.to_result[Fahrenheit](me: Me) -> Result[Fahrenheit, ParseError]
    return(ParseError.INVALID)

routine start() -> Void
    return()
