# An access is taken from the AccessManager, so it is given back on every path: a path that returns while it is held
# is a build error.

import Standard/Os

global COUNTER: &U64

routine bump(by: U64) -> None
    held: Authorized[U64] <- COUNTER.get_exclusive_access()
    if by == 0
        return
    held.getview().poke(held.getview().peek() + by)
    drop held
    return

routine start() -> None
    bump(1)
    return
