// F128Big, the 448-bit exact tier of F128's math functions (stdlib/f128_big.tess): each result's sign, exponent,
// and mantissa in hex. Every one was checked against mpmath to within 2^-430 relative.

import Standard::Format

#[external("c"), symbol("printf"), variadic]
routine c_printf(%fmt: @Byte) -> CInt

routine show(%name: @Byte, %v: F128Big) -> Void
    block entry():
        claim %m : @BigNat<16>
        %m.store(%v.mant)
        %length : USize = %m.length.load()
        c_printf("%s %d %lld ", %name, %v.negative.to_s32(), %v.exponent)
        jump loop(%length, %m)

    block loop(%left: USize, %m: @BigNat<16>):
        %done : Bool = %left.eq(0)
        branch %done ? finish() : one(%left.sub(1), %m)

    block one(%i: USize, %m: @BigNat<16>):
        %limb : U64 = %m.limbs.get(%i)
        c_printf("%016llx", %limb)
        jump loop(%i, %m)

    block finish():
        c_printf("\n")
        return()

routine f(%x: F64) -> F128Big
    block entry():
        %r : F128Big = big_from_f128(%x.to_f128())
        return(%r)

routine main() -> S32
    block entry():
        show("exp(1)", big_exp(f(1.0)))
        show("exp(-100.3)", big_exp(f(-100.3)))
        show("exp(11000.5)", big_exp(f(11000.5)))
        show("expm1(2^-30)", big_exp_m1(f(0x1p-30)))
        show("expm1(-0.001)", big_exp_m1(f(-0.001)))
        show("ln(3)", big_ln(f(3.0)))
        show("ln(1e-300)", big_ln(f(1e-300)))
        show("ln(1+2^-40)", big_ln(f(1.0).add(f(0x1p-40))))
        show("ln(0.75)", big_ln(f(0.75)))
        show("ln1p(0.3)", big_ln_1p(f(0.3)))
        show("ln1p(-2^-25)", big_ln_1p(f(-0x1p-25)))
        show("sin(0.7)", big_sin_core(f(0.7)))
        show("cos(0.7)", big_cos_core(f(0.7)))
        show("recip(3)", f(3.0).recip())
        show("sqrt(2)", f(2.0).sqrt())
        show("div(1,7)", f(1.0).div(f(7.0)))
        show("sub", f(1.0).sub(f(0x1.fffffffffffffp-1)))
        show("theta(1e30)", big_reduce(F64.to_f128(1e30)).theta)
        show("qtheta(1e30)",
                big_from_u128(false, big_reduce(F64.to_f128(1e30)).quadrant.to_u128(), 0))
        show("theta(1e900)",
                big_reduce(F64.to_f128(1e300).mul(F64.to_f128(1e300)).mul(F64.to_f128(1e300))).theta)
        show("qtheta(1e900)",
                big_from_u128(false, big_reduce(F64.to_f128(1e300).mul(F64.to_f128(1e300)).mul(F64.to_f128(1e300))).quadrant.to_u128(), 0))
        show("theta(MAX)", big_reduce(F128.MAX).theta)
        show("qtheta(MAX)", big_from_u128(false, big_reduce(F128.MAX).quadrant.to_u128(), 0))
        show("theta(2.5)", big_reduce(F64.to_f128(2.5)).theta)
        show("qtheta(2.5)",
                big_from_u128(false, big_reduce(F64.to_f128(2.5)).quadrant.to_u128(), 0))
        show("theta(0.3)", big_reduce(F64.to_f128(0.3)).theta)
        show("qtheta(0.3)",
                big_from_u128(false, big_reduce(F64.to_f128(0.3)).quadrant.to_u128(), 0))
        return(0)
