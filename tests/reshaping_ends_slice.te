# A view of what a list holds (its getslice) ends at a #reshaping call on the list: the elements may move.

import Collections
import Hosted

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)
    xs.add_last(5)
    s: @[S64] = xs.getslice(start: 0, count: 1)
    xs.add_last(6)
    Console.show(s.getslot(0).peek())
    drop xs
    return
