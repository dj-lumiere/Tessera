# A call that leaves out an argument without a default is a build error that says how many the routine takes.
import Hosted

### N times M.
### :typeparam N: The first.
### :typeparam M: The second.
### :returns: The product.
routine product[N, M]() -> U64
needs N: U64, M: U64 = 3
    return N * M

### Runs.
routine start() -> None
    Console.show("{product[2, 3, 4]()}")
    return
