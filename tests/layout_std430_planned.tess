/// The std140 and std430 layouts are planned (Roadmap #56).
#layout(std430)
record Header
    tag: U8
    length: U32

/// Makes a `Header` from its fields.
/// :param tag: Its `tag`.
/// :param length: Its `length`.
/// :returns: The new value.
routine Header.construct(tag: U8, length: U32) -> Me
    return(Me(tag, length))

/// Releases nothing: a `Header` holds no memory of its own.
routine Header.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    s: USize = sizeof[Header]()
    return()
