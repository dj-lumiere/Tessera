# Collections conform to Equatable, so a collection of collections compares element by element.

import Standard/Collections
import Standard/Os

routine set_of(a: S64, b: S64, manager: @MemoryManager) -> Set[S64]
    local set: @Set[S64] <- .construct(manager)

    set.add(a)
    set.add(b)
    return set

routine start() -> None
    local manager: @MemoryManager <- HEAP.peek()
    local left: @List[Set[S64]] <- .construct(manager)

    left.add_last(set_of(a: 1, b: 2, manager))
    left.add_last(set_of(a: 3, b: 4, manager))

    local right: @List[Set[S64]] <- .construct(manager)
    right.add_last(set_of(a: 2, b: 1, manager))  # same elements, other insertion order
    right.add_last(set_of(a: 4, b: 3, manager))
    Console.show("sets in lists equal: {left.eq(right)}")

    right.add_last(set_of(a: 5, b: 6, manager))
    Console.show("after a push: {left.eq(right)}")

    grid_a: Array[Array[S64, 2], 2] = [[1, 2], [3, 4]]
    grid_b: Array[Array[S64, 2], 2] = [[1, 2], [3, 5]]
    Console.show("grids equal: {grid_a.eq(grid_a)} {grid_a.eq(grid_b)}")
    drop left
    drop right
    return
