# Hosted files and directories through OsFileManager, in a directory of its own under the temporary directory:
# directories made and deleted, files made (and not made on the side), written (bytes and formatted text through a
# FileHandle), read, appended, sized, copied, and renamed, listings (a non-ASCII name too), the working directory,
# path text, and file storage.

import Hosted

routine error_name(e: FsError) -> @[Byte]
    return e.name()

routine report(what: @[Byte], r: Check[None]) -> None
    when r
        is None =>
            Console.show("{what}: ok")
            return
        is FsError as error =>
            Console.show("{what}: {error_name(error)}")
            return

### The file's text, or the error's name.
routine contents(f: @File, manager: @MemoryManager) -> BorrowedSlice[Byte]
    when check OsFileManager.read_all(at: f, manager)
        is BorrowedSlice[Byte] as text => return text
        is FsError as error => return @[Byte].concat(a: error_name(error), b: "", manager)

### Writes the file's text, or the error's name, after `what`.
routine show_contents(what: @[Byte], f: @File, manager: @MemoryManager) -> None
    text: &[Byte] <- contents(f, manager)

    Console.show("{what}{text.getslice()}", end: "")
    drop text
    return

routine size_of(f: @File) -> U64
    m: Check[Metadata] = check OsFileManager.metadata(at: f)
    when m
        is Metadata as info => return info.size
        is FsError => return U64.MAX

### The name of what a check holds: `ok`, or the failure's name.
routine failure_name[T](c: Check[T]) -> @[Byte]
    when c
        is T => return "ok"
        is Crashables as e => return e.name()

### What mapping `f` gives: "ok", or the name of the failure.
routine map_failure_name(f: @File) -> @[Byte]
    when check OsFileManager.storage[Byte](at: f, write: true, start: 0, count: U64.MAX)
        is FileStorage[Byte] as mapped =>
            drop mapped
            return "ok"
        is Crashables as e => return e.name()

routine start() -> None
    manager: @MemoryManager = HEAP
    tmp: &Directory <- OsEnvironment.temp_directory(manager)
    root: &Directory <- tmp.go_to(name: "tessera_fs_basic", manager)
    iter: &DirEmitter
    count: &U64
    dirs: &U64
    korean: &Bool

    try OsFileManager.delete_all(at: root, manager)
    deep: &Directory <- root.go_to(name: "a/b/c", manager)
    report(what: "make_directory without parents",
        r: check OsFileManager.make_directory(at: deep, parents: false))
    report(what: "make_directory with parents",
        r: check OsFileManager.make_directory(at: deep, parents: true))
    report(what: "make_directory with parents again",
        r: check OsFileManager.make_directory(at: deep, parents: true))
    report(what: "make_directory again",
        r: check OsFileManager.make_directory(at: deep, parents: false))
    as_file: Bool = OsFileManager.is_file(at: File.at(deep.path.peek()))
    Console.show("directory exists: {OsFileManager.is_directory(at: deep)}, is a file: {as_file}")
    a: &Directory <- root.go_to(name: "a", manager)
    hello: &File <- a.file(name: "hello.txt", manager)
    report(what: "write_all before make_file",
        r: check OsFileManager.write_all(at: hello, data: "x"))
    early: Check[FileHandle] = check OsFileManager.open_write(at: hello)
    Console.show("open_write before make_file: {failure_name(early)}")
    early_append: Check[FileHandle] = check OsFileManager.open_append(at: hello)
    Console.show("open_append before make_file: {failure_name(early_append)}")
    Console.show("map before make_file: {map_failure_name(f: hello)}")
    report(what: "set_size before make_file", r: check OsFileManager.set_size(at: hello, size: 4))
    Console.show("still missing: {not OsFileManager.is_present(at: hello)}")
    report(what: "make_file", r: check OsFileManager.make_file(at: hello, replacing: false))
    report(what: "write_all", r: check OsFileManager.write_all(at: hello, data: "hello, 세계\n"))
    show_contents(what: "read_all: ", f: hello, manager)
    report(what: "make_file again", r: check OsFileManager.make_file(at: hello, replacing: false))
    Console.show("size: {size_of(hello)}")
    appended: &FileHandle <- OsFileManager.open_append(at: hello)
    appended.write("more")
    Console.show("formatted write failed: {appended.has_failed()}")
    appended.close()
    Console.show("size after append: {size_of(hello)}")
    both: &FileHandle <- OsFileManager.open_read_write(at: hello)
    at: U64 = both.seek(offset: -4, from: SeekFrom.END)
    Console.show("seek to end - 4: {at}")
    tail: &Items[Byte, 8]
    got: U64 = both.read_bytes(buffer: tail.getview().to[@Byte](), count: 8)
    back: @[Byte] = @[Byte].construct(data: tail.getview().to[@Byte](), count: got)
    Console.show("read back: {back}")
    report(what: "set_size 5", r: check both.set_size(5))
    size: U64 = both.size()
    Console.show("size: {size}")
    both.close()
    copied: &File <- a.file(name: "copy.txt", manager)
    renamed: &File <- a.file(name: "renamed.txt", manager)
    bytes: U64 = OsFileManager.copy(from: hello, to: copied, replacing: false)
    Console.show("copy: {bytes} bytes, ", end: "")
    show_contents(what: "", f: copied, manager)
    Console.show("")
    again: Check[U64] = check OsFileManager.copy(from: hello, to: copied, replacing: false)
    Console.show("copy onto a file: {failure_name(again)}")
    replaced: U64 = OsFileManager.copy(from: hello, to: copied, replacing: true)
    Console.show("copy replacing a file: {replaced} bytes")
    report(what: "rename",
        r: check OsFileManager.rename(at: copied, to: "renamed.txt", replacing: false))
    old_there: Bool = OsFileManager.is_present(at: copied)
    Console.show("old there: {old_there}, new there: {OsFileManager.is_present(at: renamed)}")
    report(what: "rename onto a file",
        r: check OsFileManager.rename(at: renamed, to: "hello.txt", replacing: false))
    missing: Check[FileHandle] = check OsFileManager.open_read(at: a.file(name: "missing.txt",
        manager))
    Console.show("open missing: {failure_name(missing)}")
    report(what: "set_readonly", r: check OsFileManager.set_readonly(at: renamed, readonly: true))
    ro: Bool = OsFileManager.metadata(at: renamed).readonly
    Console.show("readonly: {ro}")
    report(what: "set_readonly off",
        r: check OsFileManager.set_readonly(at: renamed, readonly: false))
    rw: Bool = OsFileManager.metadata(at: renamed).readonly
    Console.show("readonly: {rw}")
    report(what: "make_file replacing",
        r: check OsFileManager.make_file(at: renamed, replacing: true))
    Console.show("emptied: size {size_of(renamed)}")
    made: &File <- a.file(name: "파일.txt", manager)
    report(what: "make_file 파일.txt", r: check OsFileManager.make_file(at: made, replacing: false))
    Console.show("made: {OsFileManager.is_file(at: made)}, size {size_of(made)}")
    report(what: "set_size 3", r: check OsFileManager.set_size(at: made, size: 3))
    Console.show("size: {size_of(made)}")
    report(what: "open listing", r: check OsFileManager.list(at: a, iter))
    0.poke_into(count)
    0.poke_into(dirs)
    false.poke_into(korean)

    loop
        e: Optional[DirEntry] = try iter.emit()
        when e
            is DirEntry as d =>
                is_d: Bool = d.kind == FileKind.DIRECTORY
                found: Bool = korean.load() or (d.name == "파일.txt")
                (count.load() + 1).poke_into(count)
                (dirs.load() + is_d.to[U64]()).poke_into(dirs)
                found.poke_into(korean)
                continue
            is None => break
    iter.close()
    Console.show("entries: {count.load()}, directories: {dirs.load()}, Korean name listed: {korean.load()}")
    f: &File <- File.at("/a/b/archive.tar.gz")
    parent: &Directory <- f.parent()

    Console.show("name {f.name()}, stem {f.stem()}, extension {f.extension()}, parent {parent.path.peek()}")
    d1: &Directory <- File.at("a/b").parent()
    d2: &Directory <- File.at("file.txt").parent()
    d3: &Directory <- Directory.at("/").parent()
    d4: &Directory <- Directory.at("/a").parent()
    Console.show("parent: [{d1.path.peek()}] [{d2.path.peek()}] [{d3.path.peek()}] [{d4.path.peek()}]")
    hidden: &File <- File.at(".hidden")
    plain: &File <- File.at("file")
    Console.show("hidden: stem [{hidden.stem()}], extension [{hidden.extension()}], no extension: [{plain.extension()}]")
    cwd: &Directory <- OsEnvironment.working_directory(manager)
    canonical: &Directory <- OsFileManager.canonical(at: root, manager)
    absolute: &File <- OsFileManager.absolute(at: File.at("x.txt"), manager)
    cwd_ok: Bool = not cwd.path.peek().is_empty()
    canonical_ok: Bool = canonical.name() == "tessera_fs_basic"
    absolute_ok: Bool = absolute.name() == "x.txt"
    Console.show("names right: working {cwd_ok}, canonical {canonical_ok}, absolute {absolute_ok}")
    whole: FileStorage[Byte] <- OsFileManager.storage[Byte](at: hello, write: false, start: 0,
        count: U64.MAX)
    w: @[Byte] = @[Byte].construct(data: whole.data(), count: whole.count())
    Console.show("map: {w}")
    drop whole
    part: FileStorage[Byte] <- OsFileManager.storage[Byte](at: hello, write: false, start: 1,
        count: 3)
    p: @[Byte] = @[Byte].construct(data: part.data(), count: part.count())
    Console.show("map 1..4: {p}")
    drop part
    past: FileStorage[Byte] <- OsFileManager.storage[Byte](at: hello, write: false, start: 100,
        count: 3)
    Console.show("map past the end: {past.count()}")
    drop past
    rw2: FileStorage[Byte] <- OsFileManager.storage[Byte](at: hello, write: true, start: 0,
        count: U64.MAX)
    rw2.data().poke(b'J')
    drop rw2
    show_contents(what: "after a mapped store: ", f: hello, manager)
    Console.show("")
    report(what: "delete a non-empty directory", r: check OsFileManager.delete(at: a))
    report(what: "delete_all", r: check OsFileManager.delete_all(at: root, manager))
    Console.show("root there: {OsFileManager.is_present(at: root)}")
    drop cwd
    drop canonical
    drop absolute
    drop plain
    drop hidden
    drop d4
    drop d3
    drop d2
    drop d1
    drop parent
    drop f
    drop made
    drop renamed
    drop copied
    drop hello
    drop a
    drop deep
    drop root
    drop tmp
    return
