# Standard/Os files and directories through OsFileManager, in a directory of its own under the temporary directory:
# directories made and deleted, files made (and not made on the side), written (bytes and formatted text through a
# FileHandle), read, appended, sized, copied, and renamed, listings (a non-ASCII name too), the working directory,
# path text, and file storage.

import Standard/Os

routine error_name(e: FsError) -> @[Byte]
    when e
        FsError.NOT_FOUND => return "NotFound"
        FsError.PERMISSION_DENIED => return "PermissionDenied"
        FsError.ALREADY_EXISTS => return "AlreadyExists"
        FsError.NOT_A_DIRECTORY => return "NotADirectory"
        FsError.IS_A_DIRECTORY => return "IsADirectory"
        FsError.DIRECTORY_NOT_EMPTY => return "DirectoryNotEmpty"
        FsError.CROSS_DEVICE => return "CrossDevice"
        FsError.NAME_TOO_LONG => return "NameTooLong"
        FsError.INVALID_PATH => return "InvalidPath"
        FsError.NO_SPACE => return "NoSpace"
        FsError.READ_ONLY => return "ReadOnly"
        FsError.BUSY => return "Busy"
        FsError.STORAGE_FAULT => return "StorageFault"
        FsError.OUT_OF_MEMORY => return "OutOfMemory"
        FsError.OTHER => return "Other"

routine report(what: @[Byte], r: Result[None, FsError]) -> None
    when r
        is None =>
            Console.show("{what}: ok")
            return
        is FsError as error =>
            Console.show("{what}: {error_name(error)}")
            return

### The file's text, or the error's name.
routine contents(f: @File, alloc: @MemoryManager) -> Memory[Byte]
    when OsFileManager.read_all_result(at: f, alloc)
        is Memory[Byte] as text => return text
        is FsError as error => return @[Byte].concat(a: error_name(error), b: "", alloc)

### Writes the file's text, or the error's name, after `what`.
routine show_contents(what: @[Byte], f: @File, alloc: @MemoryManager) -> None
    local text: @Memory[Byte] <- contents(f, alloc)

    Console.show("{what}{text}", end: "")
    drop text
    return

routine size_of(f: @File) -> U64
    m: Result[Metadata, FsError] = OsFileManager.metadata_result(at: f)
    when m
        is Metadata as info => return info.size
        is FsError => return U64.MAX

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local tmp: @Directory <- OsEnvironment.temp_directory_result(alloc).unwrap()
    local root: @Directory <- tmp.go_to(name: "tessera_fs_basic", alloc)
    local iter: @DirIter <- .hollow()
    local count: @U64 <- .hollow()
    local dirs: @U64 <- .hollow()
    local korean: @Bool <- .hollow()

    OsFileManager.delete_all_result(at: root, alloc)
    local deep: @Directory <- root.go_to(name: "a/b/c", alloc)
    report(what: "make_directory without parents",
        r: OsFileManager.make_directory_result(at: deep, parents: false))
    report(what: "make_directory with parents",
        r: OsFileManager.make_directory_result(at: deep, parents: true))
    report(what: "make_directory with parents again",
        r: OsFileManager.make_directory_result(at: deep, parents: true))
    report(what: "make_directory again",
        r: OsFileManager.make_directory_result(at: deep, parents: false))
    as_file: Bool = OsFileManager.is_file(at: File.at(deep.path.peek()))
    Console.show("directory exists: {OsFileManager.is_directory(at: deep)}, is a file: {as_file}")
    local a: @Directory <- root.go_to(name: "a", alloc)
    local hello: @File <- a.file(name: "hello.txt", alloc)
    report(what: "write_all before make_file",
        r: OsFileManager.write_all_result(at: hello, data: "x"))
    early: Result[FileHandle, FsError] = OsFileManager.open_write_result(at: hello)
    Console.show("open_write before make_file: {error_name(early.unwrap_failure())}")
    early_append: Result[FileHandle, FsError] = OsFileManager.open_append_result(at: hello)
    Console.show("open_append before make_file: {error_name(early_append.unwrap_failure())}")
    early_map: Result[FileStorage[Byte], FsError] = OsFileManager.storage_result[Byte](at: hello, write: true,
        start: 0, count: U64.MAX)
    Console.show("map before make_file: {error_name(early_map.unwrap_failure())}")
    report(what: "set_size before make_file", r: OsFileManager.set_size_result(at: hello, size: 4))
    Console.show("still missing: {not OsFileManager.is_present(at: hello)}")
    report(what: "make_file", r: OsFileManager.make_file_result(at: hello, replacing: false))
    report(what: "write_all", r: OsFileManager.write_all_result(at: hello, data: "hello, 세계\n"))
    show_contents(what: "read_all: ", f: hello, alloc)
    report(what: "make_file again", r: OsFileManager.make_file_result(at: hello, replacing: false))
    Console.show("size: {size_of(hello)}")
    local appended: @FileHandle <- OsFileManager.open_append_result(at: hello).unwrap()
    appended.write("more")
    Console.show("formatted write failed: {appended.has_failed()}")
    appended.close()
    Console.show("size after append: {size_of(hello)}")
    local both: @FileHandle <- OsFileManager.open_read_write_result(at: hello).unwrap()
    at: U64 = both.seek_result(offset: -4, from: SeekFrom.END).unwrap()
    Console.show("seek to end - 4: {at}")
    local tail: @Array[Byte, 8] <- .hollow()
    got: U64 = both.read_bytes_result(buffer: tail.to[@Byte](), count: 8).unwrap()
    back: @[Byte] = @[Byte].construct(data: tail.to[@Byte](), count: got)
    Console.show("read back: {back}")
    report(what: "set_size 5", r: both.set_size_result(5))
    size: U64 = both.size_result().unwrap()
    Console.show("size: {size}")
    both.close()
    local copied: @File <- a.file(name: "copy.txt", alloc)
    local renamed: @File <- a.file(name: "renamed.txt", alloc)
    bytes: U64 = OsFileManager.copy_result(from: hello, to: copied, replacing: false).unwrap()
    Console.show("copy: {bytes} bytes, ", end: "")
    show_contents(what: "", f: copied, alloc)
    Console.show("")
    again: Result[U64, FsError] = OsFileManager.copy_result(from: hello, to: copied, replacing: false)
    Console.show("copy onto a file: {error_name(again.unwrap_failure())}")
    replaced: U64 = OsFileManager.copy_result(from: hello, to: copied, replacing: true).unwrap()
    Console.show("copy replacing a file: {replaced} bytes")
    report(what: "rename", r: OsFileManager.rename_result(at: copied, to: "renamed.txt", replacing: false))
    old_there: Bool = OsFileManager.is_present(at: copied)
    Console.show("old there: {old_there}, new there: {OsFileManager.is_present(at: renamed)}")
    report(what: "rename onto a file",
        r: OsFileManager.rename_result(at: renamed, to: "hello.txt", replacing: false))
    missing: Result[FileHandle, FsError] = OsFileManager.open_read_result(at: a.file(
        name: "missing.txt", alloc))
    Console.show("open missing: {error_name(missing.unwrap_failure())}")
    report(what: "set_readonly", r: OsFileManager.set_readonly_result(at: renamed, readonly: true))
    ro: Bool = OsFileManager.metadata_result(at: renamed).unwrap().readonly
    Console.show("readonly: {ro}")
    report(what: "set_readonly off",
        r: OsFileManager.set_readonly_result(at: renamed, readonly: false))
    rw: Bool = OsFileManager.metadata_result(at: renamed).unwrap().readonly
    Console.show("readonly: {rw}")
    report(what: "make_file replacing",
        r: OsFileManager.make_file_result(at: renamed, replacing: true))
    Console.show("emptied: size {size_of(renamed)}")
    local made: @File <- a.file(name: "파일.txt", alloc)
    report(what: "make_file 파일.txt", r: OsFileManager.make_file_result(at: made, replacing: false))
    Console.show("made: {OsFileManager.is_file(at: made)}, size {size_of(made)}")
    report(what: "set_size 3", r: OsFileManager.set_size_result(at: made, size: 3))
    Console.show("size: {size_of(made)}")
    report(what: "open listing", r: OsFileManager.list_result(at: a, iter))
    0.poke_into(count)
    0.poke_into(dirs)
    false.poke_into(korean)

    while true
        e: Maybe[DirEntry] = iter.emit_checked()
        when e
            is DirEntry as d =>
                is_d: Bool = d.kind == FileKind.DIRECTORY
                found: Bool = korean.peek() or (d.name == "파일.txt")
                (count.peek() + 1).poke_into(count)
                (dirs.peek() + is_d.to[U64]()).poke_into(dirs)
                found.poke_into(korean)
                continue
            is None => break
    iter.close()
    Console.show("entries: {count.peek()}, directories: {dirs.peek()}, Korean name listed: {korean.peek()}")
    local f: @File <- File.at("/a/b/archive.tar.gz")
    local parent: @Directory <- f.parent()

    Console.show("name {f.name()}, stem {f.stem()}, extension {f.extension()}, parent {parent.path.peek()}")
    local d1: @Directory <- File.at("a/b").parent()
    local d2: @Directory <- File.at("file.txt").parent()
    local d3: @Directory <- Directory.at("/").parent()
    local d4: @Directory <- Directory.at("/a").parent()
    Console.show("parent: [{d1.path.peek()}] [{d2.path.peek()}] [{d3.path.peek()}] [{d4.path.peek()}]")
    local hidden: @File <- File.at(".hidden")
    local plain: @File <- File.at("file")
    Console.show("hidden: stem [{hidden.stem()}], extension [{hidden.extension()}], no extension: [{plain.extension()}]")
    local cwd: @Directory <- OsEnvironment.working_directory_result(alloc).unwrap()
    local canonical: @Directory <- OsFileManager.canonical_result(at: root, alloc).unwrap()
    local absolute: @File <- OsFileManager.absolute_result(at: File.at("x.txt"), alloc).unwrap()
    cwd_ok: Bool = not cwd.path.peek().is_empty()
    canonical_ok: Bool = canonical.name() == "tessera_fs_basic"
    absolute_ok: Bool = absolute.name() == "x.txt"
    Console.show("names right: working {cwd_ok}, canonical {canonical_ok}, absolute {absolute_ok}")
    whole: FileStorage[Byte] = OsFileManager.storage_result[Byte](at: hello, write: false, start: 0,
        count: U64.MAX).unwrap()
    w: @[Byte] = @[Byte].construct(data: whole.data(), count: whole.count())
    Console.show("map: {w}")
    whole.unmap()
    part: FileStorage[Byte] = OsFileManager.storage_result[Byte](at: hello, write: false, start: 1,
        count: 3).unwrap()
    p: @[Byte] = @[Byte].construct(data: part.data(), count: part.count())
    Console.show("map 1..4: {p}")
    part.unmap()
    past: FileStorage[Byte] = OsFileManager.storage_result[Byte](at: hello, write: false, start: 100,
        count: 3).unwrap()
    Console.show("map past the end: {past.count()}")
    rw2: FileStorage[Byte] = OsFileManager.storage_result[Byte](at: hello, write: true, start: 0,
        count: U64.MAX).unwrap()
    rw2.data().poke(b'J')
    rw2.unmap()
    show_contents(what: "after a mapped store: ", f: hello, alloc)
    Console.show("")
    report(what: "delete a non-empty directory", r: OsFileManager.delete_result(at: a))
    report(what: "delete_all", r: OsFileManager.delete_all_result(at: root, alloc))
    Console.show("root there: {OsFileManager.is_present(at: root)}")
    drop cwd
    drop canonical
    drop absolute
    drop plain
    drop hidden
    drop d4
    drop d3
    drop d2
    drop d1
    drop parent
    drop f
    drop made
    drop renamed
    drop copied
    drop hello
    drop a
    drop deep
    drop root
    drop tmp
    return
