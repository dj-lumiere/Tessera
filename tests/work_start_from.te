# A piece of work is a routine and its arguments, f.to[Work](name: value). start_from(manager) starts it on a worker the
# manager lends (a thread, a fiber), and its retrieve() waits, gives the result, and gives back the worker and the access
# borrowed in its arguments. put_work(work) starts it on a ticket held, whose retrieve() gives the result.

import Standard/Collections
import Standard/Fiber
import Standard/Os

### A count of entries.
record Ledger
    entries: U64

### Adds entries through the access it is handed.
### :param book: The access to the ledger.
### :param count: How many.
### :returns: The ledger's entries after.
routine write_entries(book: Authorized[Ledger], count: U64) -> U64
    view: @Ledger = book.getview()
    (view.entries.peek() + count).poke_into(view.entries)
    return view.entries.peek()

### Sums 1 to n.
### :param n: The last number.
### :returns: The sum.
routine sum_to(n: U64) -> U64
    each i in 1 to n with total: U64 = 0
        continue with total: total + i
    then
        return total

### Runs the work three ways.
routine start() -> None
    book: &Ledger <- Ledger(entries: 1)

    job: Work[U64] <- write_entries.to[Work](book: book.get_exclusive_access(), count: 4)
    job.start_from(DEFAULT_THREADS)
    written: U64 = job.retrieve()
    drop job
    t: Thread[U64] <- get_thread[U64]()
    sum: Work[U64] <- sum_to.to[Work](n: 10)
    t.put_work(sum)
    t.wait_finished()
    Console.show("{written} {t.retrieve()} {book.load().entries}")
    drop t
    drop sum
    fibers: &FiberManager <- .construct(stack_size: 64kib, stack_manager: PAGES, manager: HEAP)
    on_fiber: Work[U64] <- sum_to.to[Work](n: 4)
    on_fiber.start_from(fibers)
    Console.show("{on_fiber.retrieve()}")
    drop on_fiber
    return
