routine print_f64(#out: Ptr<FdWriter>) -> Void
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %done: Bool = %i.sge(68)
        branch %done ? return() : one(%i)

    block one(%i: I64):
        %bits:   I64 := F64_BITS[%i]
        %digits: I64 := F64_DIGITS[%i]
        %value:  F64 = F64.from_bits(%bits)
        %value.format_fixed(#out, %digits)
        write_line(#out)
        jump loop(%i.add(1))

