routine print_f64(#out: Ptr<FdWriter>) -> Void
    block entry():
        jump loop(0)

    block loop(%i: U64):
        %done: Bool = %i.ge(68)
        branch %done ? return() : one(%i)

    block one(%i: U64):
        %bits:   U64 = F64_BITS.get(%i)
        %digits: U64 = F64_DIGITS.get(%i)
        %value:  F64 = F64.from_bits(%bits.bits())
        %value.format_fixed(#out, %digits)
        write_line(#out)
        jump loop(%i.add(1))

