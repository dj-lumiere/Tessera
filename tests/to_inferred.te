# A conversion without its type takes the type its value goes to: a binding's, an argument's, a return's.

import Standard/Hosted

routine widen(x: S64) -> S64
    return x + 1

routine start() -> None
    arr: &Array[@S32, 2] <- [.hollow(), .hollow()]

    elems: @@S32 = arr.to()
    same: Bool = elems === arr.to[@@S32]()
    small: S32 = 41
    wide: S64 = small.to()
    big: U16 = 300
    byte: U8 = big.to_wrap()
    Console.show("{same} {widen(small.to())} {wide} {byte}")
    set_exit_code((small - 41).to())
    return
