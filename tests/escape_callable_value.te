# A routine value bound to a name and called on the address of a local: the call is a call to that routine.

import Hosted

global KEPT: &@S64 <- .hollow()

### Keeps an address.
### :param p: The address.
routine keep(p: @S64) -> None
    KEPT.poke(p)
    return

### Reads an address.
### :param p: The address.
routine look(p: @S64) -> None
    Console.show("{p.peek()}")
    return

### Calls both on the address of a local.
routine fill() -> None
    l: &S64 <- 1234567

    reader: Callable[(@S64), None] = look.to[Callable]()
    reader.call(l)
    keeper: Callable[(@S64), None] = keep.to[Callable]()
    keeper.call(l)
    return

routine start() -> None
    fill()
    return
