# The first hash in a process draws its key. Four threads hash at once before anything else has, so they race to
# draw it: one draws and the others wait for it, and all four get the same hash, the one the main thread gets
# afterwards.

import Standard/Os

### What one thread hashed.
record Slot
    value: U64

routine hash_once(slot: Authorized[Slot]) -> None
    n: U64 = 0x5EED
    n.hash().poke_into(slot.getview().value)
    return

routine start() -> None
    local a: @Slot <- Slot(value: 0)
    local b: @Slot <- Slot(value: 0)
    local c: @Slot <- Slot(value: 0)
    local d: @Slot <- Slot(value: 0)

    # Each thread writes its own slot through the view of an exclusive access handed to it.
    va: Authorized[Slot] = a.get_exclusive_access()
    vb: Authorized[Slot] = b.get_exclusive_access()
    vc: Authorized[Slot] = c.get_exclusive_access()
    vd: Authorized[Slot] = d.get_exclusive_access()

    t1: Thread[None] = get_thread[None]()
    t1.put_work(entry: hash_once.to[Callable](), args: va)
    t2: Thread[None] = get_thread[None]()
    t2.put_work(entry: hash_once.to[Callable](), args: vb)
    t3: Thread[None] = get_thread[None]()
    t3.put_work(entry: hash_once.to[Callable](), args: vc)
    t4: Thread[None] = get_thread[None]()
    t4.put_work(entry: hash_once.to[Callable](), args: vd)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    t3.wait_finished()
    t3.give_back()
    t4.wait_finished()
    t4.give_back()
    drop va
    drop vb
    drop vc
    drop vd
    n: U64 = 0x5EED
    mine: U64 = n.hash()
    ab: Bool = a.value.peek() == b.value.peek()
    cd: Bool = c.value.peek() == d.value.peek()
    ac: Bool = a.value.peek() == c.value.peek()
    am: Bool = a.value.peek() == mine
    Console.show("same key in every thread: {ab and cd and ac and am}")
    return
