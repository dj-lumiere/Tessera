# B32 / B64 <-> S128 / U128 conversions at the rounding edges. On a 64-bit target they run through compiler-rt, on
# a 32-bit target through the stdlib's own copies (Standard/SoftFloat's integer-only conversions, which
# Standard/SoftFloat/Exports.te exports there), and both must print the same.

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

routine show_u128(label: @Byte, v: U128) -> None
    hi: U64 = (v >> 64).to_wrap[U64]()
    lo: U64 = v.to_wrap[U64]()
    c_printf("%s %016llx%016llx\n", label, hi, lo)
    return

routine show_s128(label: @Byte, v: S128) -> None
    show_u128(label, v: v.to_wrap[U128]())
    return

routine show_b64(label: @Byte, v: B64) -> None
    c_printf("%s %016llx\n", label, v.bits())
    return

routine show_b32(label: @Byte, v: B32) -> None
    c_printf("%s %08x\n", label, v.bits())
    return

routine start() -> None
    # float to integer: truncation, the exact top of the range, clamping
    show_u128(label: "b64 0.9 ->u", v: B64.to_clamp[U128](0.9))
    show_u128(label: "b64 2^53+2 ->u", v: B64.to_clamp[U128](9007199254740994.0))
    show_u128(label: "b64 1e20 ->u", v: B64.to_clamp[U128](100000000000000000000.0))
    show_u128(label: "b64 2^127 ->u",
        v: B64.to_clamp[U128](170141183460469231731687303715884105728.0))
    show_u128(label: "b64 2^128 ->u",
        v: B64.to_clamp[U128](340282366920938463463374607431768211456.0))
    show_u128(label: "b64 -1.5 ->u", v: B64.to_clamp[U128](-1.5))
    show_s128(label: "b64 -1.5 ->s", v: B64.to_clamp[S128](-1.5))
    show_s128(label: "b64 -1e30 ->s", v: B64.to_clamp[S128](-1000000000000000000000000000000.0))
    show_s128(label: "b64 -2^127 ->s",
        v: B64.to_clamp[S128](-170141183460469231731687303715884105728.0))
    show_s128(label: "b64 2^127 ->s",
        v: B64.to_clamp[S128](170141183460469231731687303715884105728.0))
    show_u128(label: "b32 3.4e38 ->u",
        v: B32.to_clamp[U128](340282346638528859811704183484516925440.0))
    show_s128(label: "b32 -1e20 ->s", v: B32.to_clamp[S128](-100000000000000000000.0))

    # integer to float: exact, round down, round up through the sticky bit, ties to even
    show_b64(label: "u 2^64-1 ->b64", v: U128.to[B64](18446744073709551615))
    show_b64(label: "u 2^64+2^11 ->b64", v: U128.to[B64](18446744073709553664))
    show_b64(label: "u 2^64+2^11+1 ->b64", v: U128.to[B64](18446744073709553665))
    show_b64(label: "u 2^64+3*2^11 ->b64", v: U128.to[B64](18446744073709557760))
    show_b64(label: "u max ->b64", v: U128.to[B64](340282366920938463463374607431768211455))
    show_b64(label: "s min ->b64", v: S128.to[B64](-170141183460469231731687303715884105728))
    show_b64(label: "s -(2^64+2^11+1) ->b64", v: S128.to[B64](-18446744073709553665))
    show_b32(label: "u 2^32+2^8 ->b32", v: U128.to[B32](4294967552))
    show_b32(label: "u 2^32+2^8+1 ->b32", v: U128.to[B32](4294967553))
    show_b32(label: "u 2^100+1 ->b32", v: U128.to[B32](1267650600228229401496703205377))
    show_b32(label: "u max ->b32", v: U128.to[B32](340282366920938463463374607431768211455))
    show_b32(label: "s -(2^40+1) ->b32", v: S128.to[B32](-1099511627777))
    return
