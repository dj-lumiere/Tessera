// Array[S64, 16] against a model. An LCG drives random get / set (on this array or a second one), shift_left,
// shift_right, copy (from the second array or overlapping within the first), eq, and reads through to[@T]. Every 100
// operations a checkpoint prints a running checksum of every result and a hash of the ArrayIter sequence.
// shift_right(start, end) moves [start, end) up by one, so it writes index end, and shift_left(start, end) moves
// [start + 1, end) down by one.
// The expected output comes from an independent Python model of the collection.

import Standard/Format
import Standard/Os

preset N: USize = 16

record Rng
    state: U64

/// What the run works with besides the arrays.
record Harness
    /// Where checkpoints are written.
    out: @BufWriter[Out]
    /// The generator that picks each operation.
    rng: @Rng

/// Makes a `Harness` from its fields.
/// :param out: Its `out`.
/// :param rng: Its `rng`.
/// :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng) -> Me
    return Me(out, rng)

/// Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> Void
    return

routine Rng.below(me: @Me, bound: USize) -> USize
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: USize = bucket.to[USize]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: Span[Byte], value: S64) -> Void
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

// Folds every element in index order.
routine iteration_hash(array: @Array[S64, 16]) -> S64
    local iter: @ArrayIter[S64, 16] <- .construct(array)

    while true with hash: S64 = 0
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as value => continue with hash: mix(hash, value)
            is Unit => return hash

// Sets element i to base + i.
routine fill(array: @Array[S64, 16], base: S64) -> Void
    each index in 0 til N
        array[index] = base + index.to[S64]()
    then
        return

routine checkpoint(out: @BufWriter[Out], array: @Array[S64, 16], op: USize, results: S64) -> Void
    out.write("op {op}")
    labeled(out, label: "length", value: Array[S64, 16].count().to[S64]())
    labeled(out, label: "results", value: results)
    labeled(out, label: "iteration", value: iteration_hash(array))
    out.write("\n")
    return

routine run(harness: Harness, array: @Array[S64, 16], other: @Array[S64, 16], ops: USize) -> Void
    local rng: @Rng = harness.rng

    jump next(0, 0)

    block next(op: USize, results: S64)
        if op >= ops
            return
        else
            jump pick(op, results)

    block pick(op: USize, results: S64)
        kind: USize = rng.below(100)
        is_set: Bool = kind < 20
        is_set_other: Bool = kind < 30
        is_get: Bool = kind < 45
        is_shift_right: Bool = kind < 57
        is_shift_left: Bool = kind < 69
        is_copy: Bool = kind < 79
        is_copy_self: Bool = kind < 85
        when
            is_set => jump set(op, results, array)
            is_set_other => jump set(op, results, other)
            is_get => jump get(op, results)
            is_shift_right => jump shift_right(op, results)
            is_shift_left => jump shift_left(op, results)
            is_copy => jump copy(op, results, other)
            is_copy_self => jump copy(op, results, array)
            kind < 92 => jump eq(op, results)
            else => jump read_raw(op, results)

    block set(op: USize, results: S64, target: @Array[S64, 16])
        index: USize = rng.below(N)
        value: S64 = rng.below(1000).to[S64]()
        target[index] = value
        jump record(op, results, value)

    block get(op: USize, results: S64)
        index: USize = rng.below(N)
        jump record(op, results, array[index])

    block shift_right(op: USize, results: S64)
        start: USize = rng.below(N)
        end: USize = start + rng.below(N.sub(start))
        array.shift_right(start, end)
        jump record(op, results, end.to[S64]())

    block shift_left(op: USize, results: S64)
        start: USize = rng.below(N)
        end: USize = start + 1 + rng.below(N.sub(start))
        array.shift_left(start, end)
        jump record(op, results, end.to[S64]())

    block copy(op: USize, results: S64, source: @Array[S64, 16])
        count: USize = rng.below(N.add(1))
        room: USize = N.sub(count) + 1
        dst: USize = rng.below(room)
        src: USize = rng.below(room)
        array.copy(dst_start: dst, src: source, src_start: src, count)
        jump record(op, results, count.to[S64]())

    block eq(op: USize, results: S64)
        equal: Bool = array.peek() == other.peek()
        jump record(op, results, equal.to[S64]())

    block read_raw(op: USize, results: S64)
        data: @S64 = array.to[@S64]()
        index: USize = rng.below(N)
        jump record(op, results, data.stride(index).peek())

    block record(op: USize, results: S64, result: S64)
        mixed: S64 = mix(hash: results, value: result)
        op_next: USize = op + 1
        if op_next % 100 == 0
            jump report(op_next, mixed)
        else
            jump next(op_next, mixed)

    block report(op: USize, results: S64)
        checkpoint(out: harness.out, array, op, results)
        jump next(op, results)

routine start() -> Void
    fd: @Out = Out.writer()
    local out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    local rng: @Rng <- Rng(state: 5)
    local array: @Array[S64, 16] <- .hollow()
    local other: @Array[S64, 16] <- .hollow()
    fill(array, base: 0)
    fill(array: other, base: 0)
    out.write("same fill equal {array.peek().eq(other.peek())}\n")
    fill(array: other, base: 100)
    harness: Harness = Harness(out: out, rng: rng)
    run(harness, array, other, ops: 2000)
    other.copy(dst_start: 0, src: array, src_start: 0, count: N)
    out.write("full copy equal {array.peek().eq(other.peek())}\n")
    out.flush()
    return
