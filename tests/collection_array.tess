// Array<S64, 16> against a model. An LCG drives random get / set (on this array or a second one), shift_left,
// shift_right, copy (from the second array or overlapping within the first), eq, and reads through to_ptr. Every 100
// operations a checkpoint prints a running checksum of every result and a hash of the ArrayIter sequence.
// shift_right(start, end) moves [start, end) up by one, so it writes index end; shift_left(start, end) moves
// [start + 1, end) down by one.
// The expected output is generated by scripts/gen_collection_seq.py.

preset N: U64 = 16

record Rng
    state: U64

routine Rng.below(#self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state: U64 = #self.state.load()
        %next:  U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        #self.state.store(%next)
        %value: U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed: S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

// Folds every element in index order.
routine iteration_hash(#array: Ptr<Array<S64, 16>>) -> S64
    block entry():
        %iter_val: ArrayIter<S64, 16> = ArrayIter<S64, 16>.construct(#array)
        #iter: Ptr<ArrayIter<S64, 16>> = alloca<ArrayIter<S64, 16>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<ArrayIter<S64, 16>>, %hash: S64):
        %item: Option<S64> = #iter.next()
        %more: Bool = %item.tag
        %value: S64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

// Sets element i to %base + i.
routine fill(#array: Ptr<Array<S64, 16>>, %base: S64) -> Void
    block entry():
        jump next(0)

    block next(%index: U64):
        %done: Bool = %index.ge(N)
        branch %done ? return() : store(%index)

    block store(%index: U64):
        #array.set(%index, %base.add(%index.to_s64()))
        jump next(%index.add(1))

routine checkpoint(#out: Ptr<BufWriter<FdWriter>>, #array: Ptr<Array<S64, 16>>, %op: U64, %results: S64) -> Void
    block entry():
        write_str(#out, "op ")
        %op.format(#out)
        labeled(#out, "length", Array<S64, 16>.length().to_s64())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#array))
        write_line(#out)
        return()

routine run(
        #out: Ptr<BufWriter<FdWriter>>, #array: Ptr<Array<S64, 16>>, #other: Ptr<Array<S64, 16>>, #rng: Ptr<Rng>,
        %ops: U64) -> Void
    block entry():
        jump next(0, 0)

    block next(%op: U64, %results: S64):
        %done: Bool = %op.ge(%ops)
        branch %done ? return() : pick(%op, %results)

    block pick(%op: U64, %results: S64):
        %kind:           U64  = #rng.below(100)
        %is_set:         Bool = %kind.lt(20)
        %is_set_other:   Bool = %kind.lt(30)
        %is_get:         Bool = %kind.lt(45)
        %is_shift_right: Bool = %kind.lt(57)
        %is_shift_left:  Bool = %kind.lt(69)
        %is_copy:        Bool = %kind.lt(79)
        %is_copy_self:   Bool = %kind.lt(85)
        %is_eq:          Bool = %kind.lt(92)
        select:
            %is_set -> set(%op, %results, #array)
            %is_set_other -> set(%op, %results, #other)
            %is_get -> get(%op, %results)
            %is_shift_right -> shift_right(%op, %results)
            %is_shift_left -> shift_left(%op, %results)
            %is_copy -> copy(%op, %results, #other)
            %is_copy_self -> copy(%op, %results, #array)
            %is_eq -> eq(%op, %results)
            _ -> read_raw(%op, %results)

    block set(%op: U64, %results: S64, #target: Ptr<Array<S64, 16>>):
        %index: U64 = #rng.below(N)
        %value: S64 = #rng.below(1000).to_s64()
        #target.set(%index, %value)
        jump record(%op, %results, %value)

    block get(%op: U64, %results: S64):
        %index: U64 = #rng.below(N)
        jump record(%op, %results, #array.get(%index))

    block shift_right(%op: U64, %results: S64):
        %start: U64 = #rng.below(N)
        %end:   U64 = %start.add(#rng.below(N.sub(%start)))
        #array.shift_right(%start, %end)
        jump record(%op, %results, %end.to_s64())

    block shift_left(%op: U64, %results: S64):
        %start: U64 = #rng.below(N)
        %end:   U64 = %start.add(1).add(#rng.below(N.sub(%start)))
        #array.shift_left(%start, %end)
        jump record(%op, %results, %end.to_s64())

    block copy(%op: U64, %results: S64, #source: Ptr<Array<S64, 16>>):
        %count: U64 = #rng.below(N.add(1))
        %room:  U64 = N.sub(%count).add(1)
        %dst:   U64 = #rng.below(%room)
        %src:   U64 = #rng.below(%room)
        #array.copy(%dst, #source, %src, %count)
        jump record(%op, %results, %count.to_s64())

    block eq(%op: U64, %results: S64):
        %equal: Bool = #array.eq(#other)
        jump record(%op, %results, %equal.to_s64())

    block read_raw(%op: U64, %results: S64):
        #data:  Ptr<S64> = #array.to_ptr()
        %index: U64 = #rng.below(N)
        %value: S64 = #data[%index].load()
        jump record(%op, %results, %value)

    block record(%op: U64, %results: S64, %result: S64):
        %mixed:   S64  = mix(%results, %result)
        %op_next: U64  = %op.add(1)
        %report:  Bool = %op_next.rem(100).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: U64, %results: S64):
        checkpoint(#out, #array, %op, %results)
        jump next(%op, %results)

routine main() -> S32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.construct(#fd)
        %rng_val: Rng      = Rng { state: 5 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        #array: Ptr<Array<S64, 16>> = alloca<Array<S64, 16>>
        #other: Ptr<Array<S64, 16>> = alloca<Array<S64, 16>>
        fill(#array, 0)
        fill(#other, 0)
        write_str(#out, "same fill equal ")
        #array.eq(#other).format(#out)
        write_line(#out)
        fill(#other, 100)
        run(#out, #array, #other, #rng, 2000)
        #other.copy(0, #array, 0, N)
        write_str(#out, "full copy equal ")
        #array.eq(#other).format(#out)
        write_line(#out)
        #out.flush()
        return(0)
