; Array<I64, 16> against a model. An LCG drives random get / set (on this array or a second one), shift_left,
; shift_right, copy (from the second array or overlapping within the first), eq, and reads through as_ptr. Every 100
; operations a checkpoint prints a running checksum of every result and a hash of the ArrayIter sequence.
; shift_right(start, end) moves [start, end) up by one, so it writes index end; shift_left(start, end) moves
; [start + 1, end) down by one.
; The expected output is generated by scripts/gen_collection_seq.py.

const N: I64 = 16

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every element in index order.
routine iteration_hash(#array: Ptr<Array<I64, 16>>) -> I64
    block entry():
        %iter_val: ArrayIter<I64, 16> = ArrayIter<I64, 16>.new(#array)
        #iter: Ptr<ArrayIter<I64, 16>> = alloca<ArrayIter<I64, 16>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<ArrayIter<I64, 16>>, %hash: I64):
        %item: Option<I64> = #iter.next()
        %more: Bool = %item.tag
        %value: I64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

; Sets element i to %base + i.
routine fill(#array: Ptr<Array<I64, 16>>, %base: I64) -> Void
    block entry():
        jump next(0)

    block next(%index: I64):
        %done: Bool = %index.sge(N)
        branch %done ? return() : store(%index)

    block store(%index: I64):
        #array.set(%index, %base.add(%index))
        jump next(%index.add(1))

routine checkpoint(#out: Ptr<BufWriter<FdWriter>>, #array: Ptr<Array<I64, 16>>, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "op ")
        %op.format(#out)
        labeled(#out, "length", Array<I64, 16>.length())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#array))
        write_line(#out)
        return()

routine run(
        #out: Ptr<BufWriter<FdWriter>>, #array: Ptr<Array<I64, 16>>, #other: Ptr<Array<I64, 16>>, #rng: Ptr<Rng>,
        %ops: I64) -> Void
    block entry():
        jump next(0, 0)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return() : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %kind:           I64  = #rng.below(100)
        %is_set:         Bool = %kind.slt(20)
        %is_set_other:   Bool = %kind.slt(30)
        %is_get:         Bool = %kind.slt(45)
        %is_shift_right: Bool = %kind.slt(57)
        %is_shift_left:  Bool = %kind.slt(69)
        %is_copy:        Bool = %kind.slt(79)
        %is_copy_self:   Bool = %kind.slt(85)
        %is_eq:          Bool = %kind.slt(92)
        select:
            %is_set -> set(%op, %results, #array)
            %is_set_other -> set(%op, %results, #other)
            %is_get -> get(%op, %results)
            %is_shift_right -> shift_right(%op, %results)
            %is_shift_left -> shift_left(%op, %results)
            %is_copy -> copy(%op, %results, #other)
            %is_copy_self -> copy(%op, %results, #array)
            %is_eq -> eq(%op, %results)
            _ -> read_raw(%op, %results)

    block set(%op: I64, %results: I64, #target: Ptr<Array<I64, 16>>):
        %index: I64 = #rng.below(N)
        %value: I64 = #rng.below(1000)
        #target.set(%index, %value)
        jump record(%op, %results, %value)

    block get(%op: I64, %results: I64):
        %index: I64 = #rng.below(N)
        jump record(%op, %results, #array.get(%index))

    block shift_right(%op: I64, %results: I64):
        %start: I64 = #rng.below(N)
        %end:   I64 = %start.add(#rng.below(N.sub(%start)))
        #array.shift_right(%start, %end)
        jump record(%op, %results, %end)

    block shift_left(%op: I64, %results: I64):
        %start: I64 = #rng.below(N)
        %end:   I64 = %start.add(1).add(#rng.below(N.sub(%start)))
        #array.shift_left(%start, %end)
        jump record(%op, %results, %end)

    block copy(%op: I64, %results: I64, #source: Ptr<Array<I64, 16>>):
        %count: I64 = #rng.below(N.add(1))
        %room:  I64 = N.sub(%count).add(1)
        %dst:   I64 = #rng.below(%room)
        %src:   I64 = #rng.below(%room)
        #array.copy(%dst, #source, %src, %count)
        jump record(%op, %results, %count)

    block eq(%op: I64, %results: I64):
        %equal: Bool = #array.eq(#other)
        jump record(%op, %results, %equal.to_i64())

    block read_raw(%op: I64, %results: I64):
        #data:  Ptr<I64> = #array.as_ptr()
        %index: I64 = #rng.below(N)
        %value: I64 := #data[%index]
        jump record(%op, %results, %value)

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(100).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #array, %op, %results)
        jump next(%op, %results)

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %rng_val: Rng      = Rng { state: 5 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        #array: Ptr<Array<I64, 16>> = alloca<Array<I64, 16>>
        #other: Ptr<Array<I64, 16>> = alloca<Array<I64, 16>>
        fill(#array, 0)
        fill(#other, 0)
        write_str(#out, "same fill equal ")
        #array.eq(#other).format(#out)
        write_line(#out)
        fill(#other, 100)
        run(#out, #array, #other, #rng, 2000)
        #other.copy(0, #array, 0, N)
        write_str(#out, "full copy equal ")
        #array.eq(#other).format(#out)
        write_line(#out)
        #out.flush()
        return(0)
