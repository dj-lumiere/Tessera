// Span[T].getslice checks the whole range: a view that would run one past the end crashes with
// IndexOutOfBoundsError, while one that ends exactly at the end (even an empty one) is fine.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> Void

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    Out.write("{name}: {message}\nat line {place.line.peek()}\n")
    exit(3)

routine start() -> Void
    text: Span[Byte] = "span"
    view: Span[Byte] = text.getview()
    tail: Span[Byte] = view.getslice(start: 2, count: 2)
    none: Span[Byte] = view.getslice(start: 4, count: 0)
    Out.write("tail {tail.count()}, none {none.count()}\n")
    past: Span[Byte] = view.getslice(start: 3, count: 2)
    Out.write("not reached {past.count()}\n")
    return
