// %self is the receiver, so it can only be the first parameter.

record Point
    x : S64

routine Point.scaled(%by: S64, %self: Self) -> Self
    block entry():
        return(Point { x: %self.x.mul(%by) })

routine main() -> S32
    block entry():
        %p : Point = Point.scaled(2, Point { x: 1 })
        return(0)
