// A variant written inline, `A | B`, needs no declaration: its branches are in the order of their types' names, so
// `ParseError | IoError` is `IoError | ParseError`. A value of a branch type goes into it, an `A | B` goes into an
// `A | B | C`, and inside another variant (a Result's error) its branches are that variant's own: `is IoError as e`
// observes one, `is IoError | ParseError as e` several, and `else as rest` names what is left as the union of it.

import Standard/Format
import Standard/Os

define ConfigError = IoError | ParseError

#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record IoError
    code: S32

/// Makes a `IoError` from its fields.
/// :param code: Its `code`.
/// :returns: The new value.
routine IoError.construct(code: S32) -> Me
    return(Me(code))

/// Releases nothing: a `IoError` holds no memory of its own.
routine IoError.destruct(me: @Me) -> Void
    return()

/// A number, or the I/O error that kept it from being read.
/// :param n: The number, negative for an error.
/// :returns: `n`, or an IoError.
routine read(n: S64) -> S64 | IoError
    branch n.lt(0)
        ? return(IoError(code: 5))
        : return(n)

/// The number read, or why there is none.
/// :param n: The number, negative for an I/O error, 0 for a parse error.
/// :returns: The number, or the error.
routine load(n: S64) -> Result[S64, ConfigError]
    branch n.eq(0)
        ? return(ParseError.INVALID)
        : continue
    r: S64 | IoError = read(n)
    when r
        is S64 as v => return(v)
        is IoError as e => return(e)

/// The error, in a wider variant.
/// :param x: The error.
/// :returns: The same error.
routine widen(x: IoError | ParseError) -> Bool | IoError | ParseError
    return(x)

/// What a load gave, in words.
/// :param r: What load returned.
/// :returns: A word for it.
routine describe(r: Result[S64, ConfigError]) -> Span[Byte]
    when r
        is S64 => return("number")
        is IoError => return("io")
        is ParseError => return("parse")

/// Whether the load failed, read through else as.
/// :param r: What load returned.
/// :returns: The error, or false.
routine failure(r: Result[S64, ConfigError]) -> Bool | ConfigError
    when r
        is S64 => return(false)
        else as e => return(e)

routine start() -> Void
    a: Result[S64, ConfigError] = load(3)
    b: Result[S64, ConfigError] = load(-1)
    c: Result[S64, ConfigError] = load(0)
    Out.write("{a} {b} {c}\n")
    Out.write("{describe(a)} {describe(b)} {describe(c)}\n")
    Out.write("{failure(a)} {failure(b)} {failure(c)}\n")
    p: ParseError | IoError = ParseError.EMPTY
    q: IoError | ParseError = p
    w: Bool | IoError | ParseError = widen(q)
    Out.write("{p.eq(q)} {w.diagnose()}\n")
    when b
        is IoError | ParseError as error => show(error)
        is S64 => return()

    block show(error: ConfigError)
        Out.write("error {error}\n")
        return()
