// A Vector can't cross the C ABI yet: C passes vectors by rules that depend on the CPU's features.

#[external("c"), symbol("take_vector")]
routine take_vector(v: Vector<F32, 4>) -> Void

routine start() -> Void
    block entry()
        v : Vector<F32, 4> = .splat(1.0)
        take_vector(v)
        return()
