### A generic type the body forms must have its record's constraints met by the ones in force: a Set[T] needs
### HashEquatable[T], and `count_distinct` has only Equatable[T].
import Collections

routine count_distinct[T](values: @[T], manager: @MemoryManager) -> U64
needs T obeys Equatable
    seen: &Set[T] <- .construct(manager)

    n: U64 = seen.count()
    drop seen
    return n

routine start() -> None
    return
