# A value type parameter is a value in expressions, the receiver of a call included.
import Hosted

### A box.
### :typeparam L: The value.
record Box[L]
needs U64 L
    v: U64

### A modulus as a value.
### :typeparam P: The modulus.
record Field[P]
needs U256 P
    v: U256

### The trailing zeros of L.
### :returns: The count.
routine Box[L].twos() -> U64
needs U64 L
    return L.trailing_zeros()

### L as an S64, plus one.
### :returns: L + 1.
routine Box[L].signed() -> S64
needs U64 L
    return L.to[S64]() + 1

### The low limb of P.
### :returns: P's low 64 bits.
routine Field[P].low() -> U64
needs U256 P
    return P.to_wrap[U64]()

### Prints them.
routine start() -> None
    b: Box[8]
    Console.show("{b.twos()} {b.signed()}")
    f: Field[18446744073709551621]
    Console.show("{f.low()}")
    return
