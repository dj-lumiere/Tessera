# A flags type: members combine with `and`, `has` asks for all of them, `has_any` for at least one, `lacks` for none.

import Hosted

preset EMPTY_MARKS: CellMarks = none
preset BLANK: &Cell <- Cell(marks: none, adjacent_mines: 0)
preset MINED: &Cell <- Cell(marks: CellMarks.MINE and FLAGGED, adjacent_mines: 6)
preset BOTH: Small = LOW and HIGH

### What is true of a cell.
flags CellMarks
    ### The cell holds a mine.
    MINE
    ### The cell is open.
    REVEALED
    ### The cell carries a flag.
    FLAGGED

### A flags type that states its width and its members' bits.
flags Small: U8
    LOW: 0
    HIGH: 7

### One square of the board.
record Cell
    marks: CellMarks
    adjacent_mines: S64

### Whether a cell can be opened.
### :param marks: The cell's marks.
### :returns: `true` when it is neither open nor flagged.
routine can_open(marks: CellMarks) -> Bool
    return marks.lacks(REVEALED and FLAGGED)

routine start() -> None
    marks: CellMarks = CellMarks.MINE and CellMarks.FLAGGED
    Console.show("has(MINE and FLAGGED): {marks.has(MINE and FLAGGED)}")
    Console.show("has(MINE and REVEALED): {marks.has(MINE and REVEALED)}")
    Console.show("has_any(MINE and REVEALED): {marks.has_any(MINE and REVEALED)}")
    Console.show("has_any(REVEALED): {marks.has_any(REVEALED)}")
    Console.show("lacks(REVEALED and FLAGGED): {marks.lacks(REVEALED and FLAGGED)}")
    Console.show("lacks(REVEALED): {marks.lacks(REVEALED)}")
    Console.show("marks: {marks}, diagnosed: {marks.diagnose()}")
    empty: CellMarks = none
    Console.show("empty: {empty}, diagnosed: {empty.diagnose()}")
    Console.show("empty == none: {empty == none}, none == empty: {none == empty}, marks != none: {marks != none}")
    Console.show("without(FLAGGED): {marks.without(FLAGGED)}, without(MINE and FLAGGED): {marks.without(MINE and FLAGGED)}")
    more: CellMarks = marks and REVEALED
    Console.show("and REVEALED: {more}, == all three: {more == (CellMarks.MINE and CellMarks.REVEALED and CellMarks.FLAGGED)}")
    Console.show("bitmask: {more.to[U64]()}, hash equal: {marks.hash() == (CellMarks.FLAGGED and CellMarks.MINE).hash()}")
    Console.show("EMPTY_MARKS: {EMPTY_MARKS}, BLANK: {BLANK.marks.peek()}, MINED: {MINED.marks.peek()} {MINED.adjacent_mines.peek()}")
    Console.show("can_open(none): {can_open(none)}, can_open(REVEALED): {can_open(REVEALED)}, can_open(MINE): {can_open(MINE)}")
    Console.show("Small: {BOTH}, {BOTH.to[U8]()}, {BOTH.to[U64]()}, size {sizeof[Small]()}, CellMarks size {sizeof[CellMarks]()}")
    return
