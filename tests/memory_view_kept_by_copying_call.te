# A routine that copies the values a view shows keeps no view: the memory may go before the list is used.

import Standard/Collections
import Standard/Os

routine start() -> None
    local m: @Memory[S64] <- [1, 2, 3] * 1 from HEAP
    local xs: @List[S64] <- .construct()

    each i in 0 til m.count()
        xs.add_last(m[i].load())
    drop m
    Console.show("{xs[2]}")
    drop xs
    return
