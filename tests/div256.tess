routine report(out: @FdWriter, name: Bytes, count: USize, wrong: U64) -> Void
    block entry():
        write(out, "{name}: {count} cases, {wrong} wrong\n")
        return()

routine check_unsigned(out: @FdWriter) -> U64
    block entry():
        jump loop(0, 0)

    block loop(i: USize, wrong: U64):
        done : Bool = i.eq(U_COUNT)
        branch done
            ? return(wrong)
            : test(i, wrong)

    block test(i: USize, wrong: U64):
        u      : U256 = U_A.get(i)
        d      : U256 = U_B.get(i)
        q_want : U256 = U_Q.get(i)
        r_want : U256 = U_R.get(i)
        q      : U256 = u.div(d)
        r      : U256 = u.mod(d)
        ok     : Bool = q.eq(q_want).bitand(r.eq(r_want))
        branch ok
            ? loop(i.add(1), wrong)
            : fail(i, wrong, u, d, q, r)

    block fail(i: USize, wrong: U64, u: U256, d: U256, q: U256, r: U256):
        write(out, "U256 ")
        u.represent_hex(out)
        write(out, " / ")
        d.represent_hex(out)
        write(out, " gave ")
        q.represent_hex(out)
        write(out, " rem ")
        r.represent_hex(out)
        write(out, "\n")
        jump loop(i.add(1), wrong.add(1))

routine check_signed(out: @FdWriter) -> U64
    block entry():
        jump loop(0, 0)

    block loop(i: USize, wrong: U64):
        done : Bool = i.eq(S_COUNT)
        branch done
            ? return(wrong)
            : test(i, wrong)

    block test(i: USize, wrong: U64):
        u      : S256 = S_A.get(i)
        d      : S256 = S_B.get(i)
        q_want : S256 = S_Q.get(i)
        r_want : S256 = S_R.get(i)
        q      : S256 = u.div(d)
        r      : S256 = u.mod(d)
        ok     : Bool = q.eq(q_want).bitand(r.eq(r_want))
        branch ok
            ? loop(i.add(1), wrong)
            : fail(i, wrong, u, d, q, r)

    block fail(i: USize, wrong: U64, u: S256, d: S256, q: S256, r: S256):
        write(out, "S256 {u} / {d} gave {q} rem {r}\n")
        jump loop(i.add(1), wrong.add(1))

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()
        u_wrong : U64 = check_unsigned(out)
        report(out, "U256", U_COUNT, u_wrong)
        s_wrong : U64 = check_signed(out)
        report(out, "S256", S_COUNT, s_wrong)
        return(0)
