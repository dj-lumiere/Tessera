# get_thread crashes with MemoryAllocationError, at the caller's line, when its manager's allocator can't give the
# thread's worker.

import Standard/Alloc
import Standard/Format
import Standard/Os

### A memory manager that gives nothing.
record Refusing

obeys MemoryManageable[Refusing]

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and the caller's line on stdout, where the golden test sees them, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("crashed: {name} at line {place.line.peek()}")
    exit(3)

### Always fails.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine Refusing.alloc(me: @Me, size: U64, align: U64) -> Addr
    return .hollow()

### Always fails, leaving the block as it was.
### :param at: Unused.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine Refusing.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

### Nothing to give back.
### :param at: Unused.
routine Refusing.free(me: @Me, at: Addr) -> None
    return

### The thread's work, never run.
### :param count: Unused.
routine work(count: @U32) -> None
    return

routine start() -> None
    local count: @U32 <- 0
    local refusing: @Refusing <- .hollow()
    local nothing: @MemoryManager <- refusing.to[MemoryManager]()
    local threads: @ThreadManager <- .construct(alloc: nothing)

    t: Thread[None] = get_thread[None](manager: threads)
    t.put_work(entry: work.to[Callable](), args: count)
    t.wait_finished()
    t.give_back()
    Console.show("not reached")
    return
