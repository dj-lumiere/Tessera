# get_thread crashes with MemoryAllocationError, at the caller's line, when the memory manager its thread manager
# holds can't give the thread's worker.

import Standard/Os

### A memory manager that gives nothing.
record Refusing
    nothing

obeys MemoryManageable[Refusing]

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and the caller's line on stdout, where the golden test sees them, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("crashed: {name} at line {place.line.peek()}")
    exit(3)

### Always fails.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine @Refusing.borrow(size: U64, align: U64) -> Addr
    return .hollow()

### Always fails, leaving the block as it was.
### :param at: Unused.
### :param size: Unused.
### :param align: Unused.
### :returns: Null.
routine @Refusing.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

### Nothing to give back.
### :param at: Unused.
routine @Refusing.give_back(at: Addr) -> None
    return

### The thread's work, never run.
### :param count: Unused.
routine work(count: @U32) -> None
    return

routine start() -> None
    count: &U32 <- 0
    refusing: &Refusing <- .hollow()
    empty_manager: &MemoryManager <- refusing.to[MemoryManager]()
    threads: &ThreadManager <- .construct(manager: empty_manager)

    Crash.report_with(on_crash.to[Callable]())
    t: Thread[None] <- get_thread[None](manager: threads)
    work_t: Work[None] = work.to[Work](count: count)
    t.put_work(work_t)
    t.retrieve()
    drop t
    Console.show("not reached")
    drop threads
    drop empty_manager
    return
