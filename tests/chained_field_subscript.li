# The middle of a chained comparison may be a field or a subscript, also of a call's result.

import Hosted

record Point
    x: S64
    y: S64

### Shows that it ran, and makes a point.
### :param x: Its x.
### :param y: Its y.
### :returns: The point.
routine made(x: S64, y: S64) -> Point
    Console.show("made {x} {y}")
    return Point(x: x, y: y)

routine start() -> None
    p: Point = Point(x: 3, y: 8)
    Console.show("{0 < p.x < 5} {0 < p.y < 5}")
    Console.show("{1 <= made(x: 2, y: 9).x <= 2}")
    xs: &[S64] <- [4, 5, 6]
    Console.show("{4 < xs[1] < 6} {xs[0] < xs[1] < xs[2]} {xs[2] < xs[1] < xs[0]}")
    return
