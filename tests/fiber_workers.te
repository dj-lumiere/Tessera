# Fibers on four threads: four thread tickets each run 16 fibers on their own thread's FIBERS, and every fiber adds
# 1000 to a shared total, yielding between steps. Fibers never move between threads, the total comes out exact, and
# each thread's FIBERS goes when its work is over.

import Standard/Fiber
import Standard/Hosted

record Shared
    total: U64

routine add_steps(state: @Shared) -> None
    until i == 1000 with i: U64 = 0
        state.total.unbroken_fetch_add(1)
        FIBERS.yield()
        continue with i: i + 1
    then
        return

### One thread's work: 16 fibers on its FIBERS, run until all have finished.
routine run_fibers(state: @Shared) -> None
    fibers: &Array[Fiber[None], 16] <- .hollow()

    each i: U64 in 0 til 16
        f: Fiber[None] <- FIBERS.get_fiber[None]()
        work_f: Work[None] = add_steps.to[Work](state: state)
        f.put_work(work_f)
        fibers[i] = f
    FIBERS.run()

    each i: U64 in 0 til 16
        drop fibers.getslot(i)
    then
        return

routine start() -> None
    state: &Shared <- Shared(total: 0)
    threads: &Array[Thread[None], 4] <- .hollow()

    each i: U64 in 0 til 4
        t: Thread[None] <- get_thread[None]()
        work_t: Work[None] = run_fibers.to[Work](state: state)
        t.put_work(work_t)
        threads[i] = t

    each i: U64 in 0 til 4
        t: Thread[None] <- steal threads.getslot(i)
        t.retrieve()
        drop t
    Console.show("{state.total.peek()}")
    return
