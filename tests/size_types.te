# U64 and S64: the target's pointer width, types of their own with the integer methods.

import Standard/Format
import Standard/Os

routine start() -> None
    n: U64 = 10
    big: U64 = n * n + 5
    back: S64 = -3
    moved: S64 = back - 4
    Out.write("{big} {big.div_trunc(7)} {big.mod_trunc(7)} {n.pow(3)} {n.shl(2)}\n")
    Out.write("{moved} {moved.abs()} {moved.abs_diff(back)}\n")
    Out.write("{n.lt(big)} {n.compare(big)} {n.max(big)} {big.is_power_of_two()}\n")
    Out.write("{big.to[U64]()} {moved.to[S64]()} {big.to[U8]()} {moved.to_checked[U64]().is_present()}\n")
    Out.write("{U32.MAX.to[U64]()} {S16.MIN.to[S64]()} {n.to[S64]().neg()} {back.to_clamp[U64]()}\n")
    Out.write("{n.sub_checked(big).is_present()} {n.sub_clamp(big)} {n.to_checked[U32]().unwrap()}\n")
    Out.write("{n.hash().eq(n.to[S64]().hash())}\n")
    return
