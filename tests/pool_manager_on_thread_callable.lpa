# A work that calls a routine value counts as using whatever a routine the program turns into a routine value uses: the
# build can't name which one, so a pool user among them is the pool used on another thread.

import Hosted

### Tidies the pool.
### :param n: Unused.
routine tidy(n: S64) -> None
    PoolManager.sweep()
    return

global HOOK: &Callable[(S64,), None] <- idle.to[Callable[(S64,), None]]()

### Does nothing.
### :param n: Unused.
routine idle(n: S64) -> None
    return

### The work: it calls the routine value kept in a global, which the build can't name the routine of.
routine run() -> None
    hook: Callable[(S64,), None] = HOOK.load()
    hook.call(1)
    return

routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    t: Thread[None] <- get_thread[None]()
    HOOK.store(tidy.to[Callable[(S64,), None]]())
    w: Work[None] = run.to[Work]()
    t.put_work(w)
    t.retrieve()
    drop t
    drop pool
    return
