// An #external("asm") routine's body is put in place at each call: registers, parameters placed by the
// builder or in a register (hi: U64 = R2), tuples of results, blocks and branches on the flags, memory
// operands, #asm_prefix, and a branch whose other arm is continue (one conditional jump, no new block).

import Standard::Format

#[target(arch: "x86_64"), external("asm"), clobbers(FLAGS), pure]
routine add_in_place(a: U64, b: U64) -> U64
    block entry():
        add<U64, U64>(a, b)
        return(a)

#[target(arch: "x86_64"), external("asm"), clobbers(FLAGS)]
routine udivrem_128_64(hi: U64 = R2, lo: U64 = R0, d: U64) -> (U64, U64)
    block entry():
        div<U64>(d)
        return({ R0, R2 })

#[target(arch: "x86_64"), external("asm")]
routine cpuid(leaf: U32 = R0, subleaf: U32 = R1) -> (U32, U32, U32, U32)
    block entry():
        cpuid()
        return({ R0, R3, R1, R2 })

#[target(arch: "x86_64"), external("asm"), clobbers(FLAGS)]
routine count_down(count: U64 = R1) -> U64
    block entry():
        xor<U32, U32>(R0, R0)
        jump check()

    block check():
        test<U64, U64>(R1, R1)
        branch eq
            ? done()
            : body()

    block body():
        pause()
        inc<U64>(R0)
        dec<U64>(R1)
        jump check()

    block done():
        return(R0)

#[target(arch: "x86_64"), external("asm"), pure]
routine carries(a: U64, b: U64) -> Bool
    block entry():
        add<U64, U64>(a, b)
        branch FLAGS.Carry
            ? yes()
            : no()

    block yes():
        mov<U32>(R0, 1)
        return(R0)

    block no():
        xor<U32, U32>(R0, R0)
        return(R0)

#[target(arch: "x86_64"), external("asm"), clobbers(FLAGS)]
routine count_down_inline(count: U64 = R1) -> U64
    block entry():
        xor<U32, U32>(R0, R0)
        jump check()

    block check():
        test<U64, U64>(R1, R1)
        branch eq
            ? done()
            : continue
        inc<U64>(R0)
        dec<U64>(R1)
        jump check()

    block done():
        return(R0)

#[target(arch: "x86_64"), external("asm"), pure]
routine carries_inline(a: U64, b: U64) -> Bool
    block entry():
        add<U64, U64>(a, b)
        branch FLAGS.Carry
            ? continue
            : no()
        mov<U32>(R0, 1)
        return(R0)

    block no():
        xor<U32, U32>(R0, R0)
        return(R0)

#[target(arch: "x86_64"), external("asm"), pure]
routine int_to_f64(x: S64) -> F64
    block entry():
        cvtsi2sd<F64, S64>(V0, x)
        return(V0)

#[target(arch: "x86_64"), external("asm"), pure]
routine low_byte(x: U64) -> U32
    block entry():
        movzx<U32, U8>(R0, x)
        return(R0)

#[target(arch: "x86_64"), external("asm"), clobbers(FLAGS)]
routine cas(p: @U64, expected: U64 = R0, new: U64) -> U64
    block entry():
        #asm_prefix("lock")
        cmpxchg<U64, U64>(p.offset(0), new)
        return(expected)

#[target(arch: "x86_64"), external("asm"), readonly]
routine load_at(p: @U64, i: U64) -> U64
    block entry():
        mov<U64, U64>(R0, p.index(i, 8).offset(8))
        return(R0)

routine main() -> S32
    block entry():
        s : U64 = add_in_place(40, 2)
        print("add {s}\n")
        q, r = udivrem_128_64(1, 5, 7)
        print("divrem {q} {r}\n")
        a, b, c, d = cpuid(0, 0)
        print("cpuid max leaf > 0: {a.gt(0)}\n")
        n : U64 = count_down(5)
        print("count {n}\n")
        c1 : Bool = carries(U64.MAX, 1)
        c2 : Bool = carries(1, 1)
        print("carry {c1} {c2}\n")
        n2 : U64  = count_down_inline(3)
        c3 : Bool = carries_inline(U64.MAX, 1)
        c4 : Bool = carries_inline(1, 1)
        print("inline {n2} {c3} {c4}\n")
        f : F64 = int_to_f64(-3)
        print("f64 {f}\n")
        lb : U32 = low_byte(0x1234)
        print("low {lb}\n")
        claim cell : @U64 <- 10
        old : U64 = cas(cell, 10, 20)
        now : U64 = cell.load()
        print("cas {old} {now}\n")
        claim arr : @Array<U64, 4> <- { 1, 2, 3, 4 }
        x : U64 = load_at(arr.to<@U64>(), 2)
        print("load {x}\n")
        return(0)
