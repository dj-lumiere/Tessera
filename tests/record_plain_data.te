# A record of plain data holds nothing to release, so it declares neither construct nor destruct: its literal makes
# it, and nothing releases it.

import Hosted

record Moment
    seconds: S64
    nanos: U32

record Span2
    from: Moment
    to: Moment

routine start() -> None
    out: @ConsoleOutput = Console.output()
    span: Span2 = Span2(from: Moment(seconds: 1, nanos: 0), to: Moment(seconds: 3, nanos: 500))
    out.write("{span.to.seconds.sub(span.from.seconds)}\n")
    return
