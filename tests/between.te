# between is the closed interval [lo, hi], in_range the half-open [lo, end). Both are false for an empty or
# reversed interval, and for a NaN.

import Standard/Format
import Standard/Os

routine start() -> None
    five: S64 = 5
    digit: Byte = b'7'
    letter: Char = 'q'
    quiet_nan: B64 = nan
    half: B64 = 0.5
    Console.show("{1 <= five <= 5} {6 <= five <= 9} {5 <= five <= 1}")
    Console.show("{0 <= five < 5} {5 <= five < 6} {5 <= five < 5}")
    Console.show("{b'0' <= digit <= b'9'} {'a' <= letter < 'z'}")
    Console.show("{0.0 <= half <= 1.0} {0.0 <= quiet_nan <= 1.0}")
    return
