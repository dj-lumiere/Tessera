# A second each over an emitter the first each walked to its end runs zero times: a build error.

import Collections
import Hosted

routine start() -> None
    points: &List[S64] <- .construct(HEAP)
    points.add_last(1)
    walk: &ListEmitter[S64] <- points.emitter()
    each point in walk
        Console.show(point)
    each point in walk
        Console.show(point)
    return
