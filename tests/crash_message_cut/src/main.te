# The message buffer here is 32 bytes (config.toml), so the long message is cut, before a character that wouldn't
# fit whole, and ends in an ellipsis.

import Standard/Os

### A failure with a long message.
crashable LongError
    nothing

### Writes `This message runs on and on, well past the room the buffer gives it: 세계.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine LongError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("This message runs on and on, well past the room the buffer gives it: 세계.")
    return

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Writes the message as the buffer holds it.
@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    text: @[Byte] = message.text()
    Console.show("{name}: [{text}] {text.count()} bytes")
    exit(3)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    throw LongError()
