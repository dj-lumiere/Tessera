// when v:, when:, value select, and inline terminators. The exit code encodes the result.

routine classify(%x: S64) -> S64
    block entry():
        when:
            %x.lt(0)    -> return(-1)
            %x.eq(0)    -> return(0)
            %x.gt(1000) -> big()
            else        -> return(1)

    block big():
        return(2)

routine op(%code: S64, %a: S64, %b: S64) -> S64
    block entry():
        when %code:
            1    -> add()
            2    -> sub()
            3    -> return(%a.mul(%b))
            else -> unreachable

    block add():
        return(%a.add(%b))

    block sub():
        return(%a.sub(%b))

routine main() -> S32
    block entry():
        %c1 : S64 = classify(-5)
        %c2 : S64 = classify(0)
        %c3 : S64 = classify(7)
        %c4 : S64 = classify(5000)
        // -1 + 0 + 1 + 2 = 2
        %cs : S64 = %c1.add(%c2).add(%c3).add(%c4)
        // (6 + 4) * (6 - 4) * 3 = 60 ... computed through op
        %s     : S64  = op(1, 6, 4)
        %d     : S64  = op(2, 6, 4)
        %p     : S64  = op(3, %s, %d)
        %m     : S64  = op(3, %p, 3)
        %neg   : Bool = %m.lt(0)
        %abs   : S64  = %neg ? 0 : %m
        %total : S64  = %abs.add(%cs)
        return(%total.to_s32_wrap())
