; switch, select, value select, and inline terminators. The exit code encodes the result.

routine classify(%x: I64) -> I64
    block entry():
        select:
            %x.slt(0) -> return(-1)
            %x.eq(0) -> return(0)
            %x.sgt(1000) -> big()
            _ -> return(1)

    block big():
        return(2)

routine op(%code: I64, %a: I64, %b: I64) -> I64
    block entry():
        switch %code:
            1 -> add()
            2 -> sub()
            3 -> return(%a.mul(%b))
            _ -> unreachable

    block add():
        return(%a.add(%b))

    block sub():
        return(%a.sub(%b))

routine main() -> I32
    block entry():
        %c1: I64 = classify(-5)
        %c2: I64 = classify(0)
        %c3: I64 = classify(7)
        %c4: I64 = classify(5000)
        ; -1 + 0 + 1 + 2 = 2
        %cs: I64 = %c1.add(%c2).add(%c3).add(%c4)
        ; (6 + 4) * (6 - 4) * 3 = 60 ... computed through op
        %s: I64 = op(1, 6, 4)
        %d: I64 = op(2, 6, 4)
        %p: I64 = op(3, %s, %d)
        %m: I64 = op(3, %p, 3)
        %neg: Bool = %m.slt(0)
        %abs: I64 = %neg ? 0 : %m
        %total: I64 = %abs.add(%cs)
        return(%total.to_i32())
