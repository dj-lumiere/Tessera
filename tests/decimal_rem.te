# Decimal from Ingrid/Decimal: `rem` is the Euclidean remainder, exact and never negative (0 <= r < |b|), beside S64's
# `%` on the same integers, which gives the same numbers. A zero divisor
# throws DivisionByZeroError, and a remainder that needs more than 34 digits throws NumericOverflowError.

import Ingrid/Decimal
import Hosted

### Reads `text` as a Decimal.
### :param text: The text.
### :returns: The decimal.
routine dec(text: @[Byte]) -> Decimal
    return text.to[Decimal]()

### Shows `a rem b` for Decimal next to `a % b` for S64.
### :param a: The dividend.
### :param b: The divisor.
routine side_by_side(a: S64, b: S64) -> None
    x: Decimal = a.to[Decimal]()
    y: Decimal = b.to[Decimal]()
    Console.show("{a} rem {b}: Decimal {x.rem(y)}, S64 % {a % b}")
    return

### Shows what `a rem b` gives for two Decimals read from text.
### :param a: The dividend.
### :param b: The divisor.
routine show_rem(a: @[Byte], b: @[Byte]) -> None
    when check dec(a).rem(dec(b))
        is Decimal as r => Console.show("{a} rem {b}: {r}")
        is Crashables as e => Console.show("{a} rem {b}: {e.name()}")
    return

routine start() -> None
    side_by_side(7, 2)
    side_by_side(-7, 2)
    side_by_side(7, -2)
    side_by_side(-7, -2)
    side_by_side(6, -3)
    show_rem("5.5", "2")
    show_rem("-5.5", "2")
    show_rem("5.5", "-2")
    show_rem("-5.5", "-2")
    show_rem("1E+30", "7")
    show_rem("-1E+30", "7")
    show_rem("-4", "2")
    show_rem("0.3", "0.1")
    show_rem("-1e-30", "7")
    show_rem("-1e-40", "7")
    show_rem("7", "0")
    return
