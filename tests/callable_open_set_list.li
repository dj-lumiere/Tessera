# A Callable kept as an element of a list is open to any failure, as one in a field is: a routine value that may fail goes
# there, also through a name it was bound to, and a call through the element passes the failure to the caller.

import Collections
import Hosted

crashable BadInputError
    value: S64

crashable TooBigError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine TooBigError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("too big {me.value}")
    return

### n, failing for a negative or a large n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    if n > 100
        throw TooBigError(value: n)
    return n

### Twice n and it never fails.
### :param n: The number.
### :returns: Twice n.
infallible routine twice(n: S64) -> S64
    return n * 2

### Runs the example.
routine start() -> None
    steps: &List[Callable[(S64,), S64]] <- .construct(manager: HEAP)
    bound: Callable[(S64,), S64] = checked.to[Callable]()
    steps.add_last(bound)
    steps.add_last(twice.to[Callable]())
    steps.add_last((n) => n + 1)
    for i in 0 til steps.count().to[S64]()
        step: Callable[(S64,), S64] = steps[i.to[U64]()]
        Console.show("step {i}: {step.call(7)}")
    first: Callable[(S64,), S64] = steps[0]
    Console.show("try {try first.call(-1)}")
    when check first.call(500)
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        else as other => Console.show("another failure: {other.name()}")
    drop steps
    return
