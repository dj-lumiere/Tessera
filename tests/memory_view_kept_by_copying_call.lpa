# A routine that copies the values a view shows keeps no view: the memory may go before the list is used.

import Collections
import Hosted

routine start() -> None
    m: &[S64] <- [1, 2, 3] * 1 from HEAP
    xs: &List[S64] <- .construct(HEAP)

    for i in 0 til m.count()
        xs.add_last(m[i])
    drop m
    Console.show("{xs[2]}")
    drop xs
    return
