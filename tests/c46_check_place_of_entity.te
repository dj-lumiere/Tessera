# A place of a Check that holds an entity, written Check[T] without its list of crashables, holds the Check the check
# gives (its list included): the builder made IR that clang refused before.

import Standard/Os

### Borrows memory through a check and reads what came back.
routine start() -> None
    m: &Check[BorrowedSlice[S64]] <- check BorrowedSlice[S64].construct(count: 4, manager: HEAP)
    when steal m
        is BorrowedSlice[S64] as got =>
            Console.show("got {got.count()}")
            drop got
        is Crashables as e => Console.show("refused")
    return
