# S128.MIN / -1 overflows (the quotient, 2^127, isn't an S128) and crashes with IntegerOverflowError, on 64-bit
# and 32-bit targets alike, and div_wrap and div_checked are the forms that don't (div128_edges.te).

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash on stdout, where the golden test sees it, and exits with status 3.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("crashed: {name}: {message}")
    exit(3)

routine start() -> None
    min: S128 = S128.MIN
    minus_one: S128 = -1
    Console.show("before")
    q: S128 = min.div_trunc(minus_one)
    Console.show("not reached {q}")
    return
