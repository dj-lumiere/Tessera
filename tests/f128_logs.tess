// F128 ln_1p, log2 and log10 (stdlib/f128_logs.tess), correctly rounded: special cases, exact cases, results
// the fast F128Extended tier keeps, and hard cases whose fast result fails the band test, so the F128Big tier
// decides them (each hard case also runs the exact tier alone). Every value was checked against mpmath at 2000
// bits, rounded to binary128.

import Standard::Format
import Standard::Os

routine compute(%kind: U64, %x: F128, %exact: Bool) -> F128
    block entry():
        when %kind:
            0    -> return(f128_ln_1p(%x, %exact))
            1    -> return(f128_log2(%x, %exact))
            else -> return(f128_log10(%x, %exact))

routine kind_of(%kind: U64) -> LogKind
    block entry():
        when %kind:
            0    -> return(LogKind.Ln1p)
            1    -> return(LogKind.Log2)
            else -> return(LogKind.Log10)

routine show(%out: Ptr<FdWriter>, %name: Bytes, %kind: U64, %x: F128) -> Void
    block entry():
        %r : F128 = compute(%kind, %x, false)
        write(%out, "{%name} = {%r} ")
        %r.bits().represent_hex(%out)
        write_line(%out)
        return()

/// A case the fast tier rejects: the result, the exact tier's alone, and whether the band test failed.
routine hard(%out: Ptr<FdWriter>, %name: Bytes, %kind: U64, %x: F128) -> Void
    block entry():
        %r        : F128         = compute(%kind, %x, false)
        %e        : F128         = compute(%kind, %x, true)
        %w        : F128Extended = wide_log_kind(%x, kind_of(%kind))
        %rounded  : WideRounding = wide_round_within(%w, f128_log_band(kind_of(%kind)))
        %rejected : Bool         = %rounded.ok.bitnot()
        %same     : Bool         = %r.bits().eq(%e.bits())
        write(%out, "{%name} = {%r} ")
        %r.bits().represent_hex(%out)
        write(%out, " rejected {%rejected} exact tier agrees {%same}\n")
        return()

routine main() -> S32
    block entry():
        claim %out : Ptr<FdWriter>
        FdWriter.stdout().store_into(%out)
        write(%out, "-- special\n")
        show(%out, "ln_1p(NaN)", 0, f128_of(0x7FFF8000000000000000000000000000))
        show(%out, "ln_1p(sNaN)", 0, f128_of(0x7FFF0000000000000000000000000001))
        show(%out, "ln_1p(+0)", 0, f128_of(0x0))
        show(%out, "ln_1p(-0)", 0, f128_of(0x80000000000000000000000000000000))
        show(%out, "ln_1p(-1)", 0, f128_of(0xBFFF0000000000000000000000000000))
        show(%out, "ln_1p(-2)", 0, f128_of(0xC0000000000000000000000000000000))
        show(%out, "ln_1p(-inf)", 0, f128_of(0xFFFF0000000000000000000000000000))
        show(%out, "ln_1p(+inf)", 0, f128_of(0x7FFF0000000000000000000000000000))
        show(%out, "log2(NaN)", 1, f128_of(0x7FFF8000000000000000000000000000))
        show(%out, "log2(-NaN sNaN)", 1, f128_of(0xFFFF0000000000000000000000000001))
        show(%out, "log2(+0)", 1, f128_of(0x0))
        show(%out, "log2(-0)", 1, f128_of(0x80000000000000000000000000000000))
        show(%out, "log2(-1)", 1, f128_of(0xBFFF0000000000000000000000000000))
        show(%out, "log2(-min subnormal)", 1, f128_of(0x80000000000000000000000000000001))
        show(%out, "log2(-inf)", 1, f128_of(0xFFFF0000000000000000000000000000))
        show(%out, "log2(+inf)", 1, f128_of(0x7FFF0000000000000000000000000000))
        show(%out, "log10(NaN)", 2, f128_of(0x7FFF8000000000000000000000000000))
        show(%out, "log10(+0)", 2, f128_of(0x0))
        show(%out, "log10(-0)", 2, f128_of(0x80000000000000000000000000000000))
        show(%out, "log10(-10)", 2, f128_of(0xC0024000000000000000000000000000))
        show(%out, "log10(-inf)", 2, f128_of(0xFFFF0000000000000000000000000000))
        show(%out, "log10(+inf)", 2, f128_of(0x7FFF0000000000000000000000000000))
        write(%out, "-- exact\n")
        show(%out, "log2(1)", 1, f128_of(0x3FFF0000000000000000000000000000))
        show(%out, "log2(2)", 1, f128_of(0x40000000000000000000000000000000))
        show(%out, "log2(0.5)", 1, f128_of(0x3FFE0000000000000000000000000000))
        show(%out, "log2(2^16383)", 1, f128_of(0x7FFE0000000000000000000000000000))
        show(%out, "log2(2^-16382)", 1, f128_of(0x10000000000000000000000000000))
        show(%out, "log2(2^-16400)", 1, f128_of(0x400000000000000000000000))
        show(%out, "log2(2^-16494)", 1, f128_of(0x1))
        show(%out, "log10(1)", 2, f128_of(0x3FFF0000000000000000000000000000))
        show(%out, "log10(10)", 2, f128_of(0x40024000000000000000000000000000))
        show(%out, "log10(100)", 2, f128_of(0x40059000000000000000000000000000))
        show(%out, "log10(10^27)", 2, f128_of(0x40589D971E4FE8401E74000000000000))
        show(%out, "log10(10^48)", 2, f128_of(0x409E5E531A0A1C872BAD2CE16256FE82))
        show(%out, "log10(10^48 + ulp)", 2, f128_of(0x409E5E531A0A1C872BAD2CE16256FE83))
        show(%out, "log10(10^49 rounded)", 2, f128_of(0x40A1B5E7E08CA3A8F6987819BAECBE22))
        show(%out, "log10(0.1 rounded)", 2, f128_of(0x3FFB999999999999999999999999999A))
        show(%out, "log10(0.001 rounded)", 2, f128_of(0x3FF50624DD2F1A9FBE76C8B439581062))
        write(%out, "-- fast\n")
        show(%out, "ln_1p(0.5)", 0, f128_of(0x3FFE0000000000000000000000000000))
        show(%out, "ln_1p(1)", 0, f128_of(0x3FFF0000000000000000000000000000))
        show(%out, "ln_1p(-0.5)", 0, f128_of(0xBFFE0000000000000000000000000000))
        show(%out, "ln_1p(2^-60)", 0, f128_of(0x3FC30000000000000000000000000000))
        show(%out, "ln_1p(-2^-60)", 0, f128_of(0xBFC30000000000000000000000000000))
        show(%out, "ln_1p(min subnormal)", 0, f128_of(0x1))
        show(%out, "ln_1p(-min subnormal)", 0, f128_of(0x80000000000000000000000000000001))
        show(%out, "ln_1p(max)", 0, f128_of(0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
        show(%out, "ln_1p(-1 + 2^-113)", 0, f128_of(0xBFFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
        show(%out, "ln_1p(1e30 rounded)", 0, f128_of(0x406293E5939A08CE9DBD480000000000))
        show(%out, "log2(3)", 1, f128_of(0x40008000000000000000000000000000))
        show(%out, "log2(1 + 2^-112)", 1, f128_of(0x3FFF0000000000000000000000000001))
        show(%out, "log2(1 - 2^-113)", 1, f128_of(0x3FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
        show(%out, "log2(max)", 1, f128_of(0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
        show(%out, "log2(3 min subnormals)", 1, f128_of(0x3))
        show(%out, "log2(sqrt 2 rounded)", 1, f128_of(0x3FFF6A09E667F3BCC908B2FB1366EA95))
        show(%out, "log10(2)", 2, f128_of(0x40000000000000000000000000000000))
        show(%out, "log10(7)", 2, f128_of(0x4001C000000000000000000000000000))
        show(%out, "log10(1 + 2^-112)", 2, f128_of(0x3FFF0000000000000000000000000001))
        show(%out, "log10(max)", 2, f128_of(0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
        show(%out, "log10(min subnormal)", 2, f128_of(0x1))
        write(%out, "-- hard\n")
        hard(%out, "ln_1p(2^-112 (1 + 1 2^-112))", 0, f128_of(0x3F8F0000000000000000000000000001))
        hard(%out, "ln_1p(2^-112 (1 + 2 2^-112))", 0, f128_of(0x3F8F0000000000000000000000000002))
        hard(%out, "ln_1p(2^-112 (1 + 3 2^-112))", 0, f128_of(0x3F8F0000000000000000000000000003))
        hard(%out, "ln_1p(2^-112 (1 + 5 2^-112))", 0, f128_of(0x3F8F0000000000000000000000000005))
        hard(%out, "ln_1p(-2^-112 (1 + 1 2^-112))", 0, f128_of(0xBF8F0000000000000000000000000001))
        hard(%out, "ln_1p(-2^-112 (1 + 2 2^-112))", 0, f128_of(0xBF8F0000000000000000000000000002))
        hard(%out, "ln_1p(-2^-112 (1 + 3 2^-112))", 0, f128_of(0xBF8F0000000000000000000000000003))
        hard(%out, "ln_1p(-2^-112 (1 + 5 2^-112))", 0, f128_of(0xBF8F0000000000000000000000000005))
        hard(%out, "ln_1p(0x6d071b62cf5a30df138e13cbd8e0c574)", 0,
                f128_of(0x6D071B62CF5A30DF138E13CBD8E0C574))
        hard(%out, "ln_1p(0x7b1a0b7bcad7b66cda3ee7aa7df3e678)", 0,
                f128_of(0x7B1A0B7BCAD7B66CDA3EE7AA7DF3E678))
        hard(%out, "ln_1p(0x400000b6468f02506e89864bef25962a)", 0,
                f128_of(0x400000B6468F02506E89864BEF25962A))
        hard(%out, "ln_1p(0x404ae877ea8ec35374fe9b35703bfc52)", 0,
                f128_of(0x404AE877EA8EC35374FE9B35703BFC52))
        hard(%out, "log2(0x2cd2ffffffffffffffffadb3c50eebd0)", 1,
                f128_of(0x2CD2FFFFFFFFFFFFFFFFADB3C50EEBD0))
        hard(%out, "log2(0x3fff00000000073602245f09a7e2bf2c)", 1,
                f128_of(0x3FFF00000000073602245F09A7E2BF2C))
        hard(%out, "log2(0x43e70000000000000000000000036a0f)", 1,
                f128_of(0x43E70000000000000000000000036A0F))
        hard(%out, "log2(0x3ff62d6b3e8246cca635b92b33d0dfd3)", 1,
                f128_of(0x3FF62D6B3E8246CCA635B92B33D0DFD3))
        hard(%out, "log10(0x3fff0003512feb35ad540f0d7f542d66)", 2,
                f128_of(0x3FFF0003512FEB35AD540F0D7F542D66))
        hard(%out, "log10(0x404ea784379d99db9709f3631889e4f0)", 2,
                f128_of(0x404EA784379D99DB9709F3631889E4F0))
        hard(%out, "log10(0x3fff0071ad51cb462572d8789b234f0c)", 2,
                f128_of(0x3FFF0071AD51CB462572D8789B234F0C))
        hard(%out, "log10(0x4001e3d7aac378664e1bad78acc7929c)", 2,
                f128_of(0x4001E3D7AAC378664E1BAD78ACC7929C))
        return(0)
