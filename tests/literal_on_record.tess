// Only an Array or a Vector takes its elements in order. A record literal names its fields.

record Point
    x: S32
    y: S32

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S32, y: S32) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    p: Point = Point(1, 2)
    return()
