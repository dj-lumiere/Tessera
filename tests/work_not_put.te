# Work handed an entity that no ticket takes is a build error that names the argument: only its ticket would end it.

import Standard/Os

### A value with nothing in it but its number.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Token) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

routine start() -> None
    a: &Token <- Token.construct(1)
    work: Work[S64] = look.to[Work](item: steal a)
    Console.show("made")
    return
