# A piece of work that no ticket takes is a build error: its arguments (an entity here) would never end.

import Standard/Os

### A value with nothing in it.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Ends what it was handed.
### :param item: What it was handed.
routine keep(item: Token) -> None
    drop item
    return

routine start() -> None
    a: &Token <- Token.construct(1)
    work: Work[None] = keep.to[Work](item: steal a)
    Console.show("made")
    return
