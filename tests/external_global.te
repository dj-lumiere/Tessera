# A C variable the program links against: #[external("c"), symbol(...)] on a global declares it (C's extern) and
# reads it through its pointer type. POSIX's environ, and on Windows the C runtime's stack-protector cookie (the
# C runtime there has no environ variable, only __p__environ()).

import Standard/Format
import Standard/Os

@external("c")
@symbol("environ")
@target(os: not "windows")
global ENVIRON: @@@Byte

@external("c")
@symbol("__security_cookie")
@target(os: "windows")
global COOKIE: @USize

@target(os: not "windows")
routine is_linked() -> Bool
    env: @@Byte = ENVIRON.peek()
    return env.peek().is_not_null()

@target(os: "windows")
routine is_linked() -> Bool
    return COOKIE.peek() != 0

routine start() -> None
    Out.write("{is_linked()}\n")
    return
