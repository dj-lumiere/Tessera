// claim p : @T <- value claims the slot and stores the value in it, where the claim stands.

import Standard::Format
import Standard::Os

record Point
    x : S64
    y : S64

routine main() -> S32
    block entry()
        x : S64 = 4
        claim n : @S64           <- x.add(1)
        claim p : @Point         <- { x: 1, y: n.load() }
        claim a : @Array<S64, 3> <- { 7, 8, 9 }
        Out.write("{n.load()} {p.y.load()} {a.getitem(2)}\n")
        return(0)
