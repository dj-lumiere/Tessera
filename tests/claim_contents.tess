// claim p : @T <- value claims the slot and stores the value in it, where the claim stands.

import Standard/Format
import Standard/Os

record Point
    x: S64
    y: S64

routine start() -> None
    x: S64 = 4
    local n: @S64 <- x + 1
    local p: @Point <- (x: 1, y: n.peek())
    local a: @Array[S64, 3] <- [7, 8, 9]
    Out.write("{n.peek()} {p.y.peek()} {a.getitem(2)}\n")
    return
