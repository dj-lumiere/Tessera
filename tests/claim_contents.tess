// claim p : @T <- value claims the slot and stores the value in it, where the claim stands.

import Standard/Format
import Standard/Os

record Point
    x: S64
    y: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    x: S64 = 4
    claim n: @S64 <- x.add(1)
    claim p: @Point <- (x: 1, y: n.peek())
    claim a: @Array[S64, 3] <- [7, 8, 9]
    Out.write("{n.peek()} {p.y.peek()} {a.getitem(2)}\n")
    return()
