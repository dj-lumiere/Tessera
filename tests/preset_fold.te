# A preset is folded by the builder: literals, other presets, integer and Bool arithmetic and conversions (with
# the stdlib routines' meaning), B32/B64 add/sub/mul/truediv/neg, max/min, sizeof/alignof, and T.from_bits(...).

import Standard/Os

preset BASE: U64 = 40
preset NEXT: U64 = BASE.add(2)
preset TOP_BIT: U128 = U64.MAX.to[U128]().add(1)
preset MASK: U32 = 1.shift_left(31).bitor(0xFF)
preset OUT: U32 = MASK.shift_left(32)  # a shift by the width or more shifts every bit out
preset SIGN_FILL: S32 = S32.arith_shift_right(-8, 40)
preset LOW: U8 = TOP_BIT.sub(1).to_wrap[U8]()
preset SIGNED: S64 = NEXT.to[S64]().neg().div_trunc(4)
preset LEFT: S64 = S64.mod_trunc(-7, 2)
preset WIDEST: U64 = max(sizeof[S32](), sizeof[S16](), alignof[S16]())
preset FLAGS: Bool = not (true and false)
preset THIRD: B64 = B64.truediv(1.0, 3.0)
preset NEG_TENTH: B32 = B32.neg(0.1)
preset INF16: B16 = B16.from_bits(0x7C00)
preset TWO: B128 = B128.from_bits(0x40000000000000000000000000000000)
preset TABLE: &Array[U64, 3] <- [BASE, NEXT, BASE.mul(NEXT)]

routine start() -> None
    Console.show("{NEXT} {TOP_BIT} {MASK} {OUT} {SIGN_FILL} {LOW} {SIGNED} {LEFT} {WIDEST} {FLAGS}")
    Console.show("{THIRD} {NEG_TENTH} {INF16} {TWO}")
    Console.show("{TABLE.getitem(0)} {TABLE.getitem(1)} {TABLE.getitem(2)}")
    return
