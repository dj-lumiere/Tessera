# In show and templates only a view writes text: @[Byte] and @[Char] (each character goes into the output in UTF-8,
# with no memory taken). A collection of Chars, an Items or a &[Char], writes its list, and its getview() (getslice()
# for memory from a manager) writes the text.

import Hosted

routine start() -> None
    view: @[Char] = "héllo 루미"
    items: Items[Char, 2] = "hi"
    placed: &Items[Char, 2] <- "hi"
    stacked: &[Char] <- "hi"
    lent: &[Char] <- ['h', 'i'] from HEAP
    Console.show("{view}")
    Console.show(view)
    Console.show("{items} {stacked} {lent}")
    Console.show("{stacked.getview()} {lent.getslice()} {placed.getview()}")
    drop lent
    return
