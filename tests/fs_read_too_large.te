# FileManager.read_all_result on a 32-bit target turns down a file of 4 GiB or more with OutOfMemory, without
# allocating: it can't fit in the address space. It used to crash with IntegerOverflowError converting the size.
# The file is sparse (set_size_result), so making it writes nothing, and it is deleted after.

import Standard/Alloc
import Standard/Format
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local tmp: @Directory <- FileManager.temp_directory_result(alloc).unwrap()
    local big: @File <- tmp.file(name: "tessera_fs_read_too_large.bin", alloc)

    discard_made: Result[None, FsError] = FileManager.make_file_result(at: big, replacing: true)
    four_gib: U64 = U64.shl(1, 32)
    sized: Result[None, FsError] = FileManager.set_size_result(at: big, size: four_gib)
    Out.write("made a 4 GiB file: {sized.is_success()}\n")
    when FileManager.read_all_result(at: big, alloc)
        is Memory[Byte] as text =>
            Out.write("read it all: {text.count()} bytes\n")
            drop text
        is FsError as e =>
            out_of_memory: Bool = e == FsError.OUT_OF_MEMORY
            Out.write("turned down as out of memory: {out_of_memory}\n")
    discard_gone: Result[None, FsError] = FileManager.delete_result(at: big)
    drop big
    drop tmp
    return
