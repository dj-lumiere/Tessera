# OsFileManager.read_all_result on a 32-bit target turns down a file of 4 GiB or more with OutOfMemory, without
# allocating: it can't fit in the address space. It used to crash with IntegerOverflowError converting the size.
# The file is sparse (set_size_result), so making it writes nothing, and it is deleted after.

import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local tmp: @Directory <- OsEnvironment.temp_directory(alloc)
    local big: @File <- tmp.file(name: "tessera_fs_read_too_large.bin", alloc)

    discard_made: Check[None] = check OsFileManager.make_file(at: big, replacing: true)
    four_gib: U64 = U64.shift_left(1, 32)
    sized: Bool = try OsFileManager.set_size(at: big, size: four_gib)
    Console.show("made a 4 GiB file: {sized}")
    when check OsFileManager.read_all(at: big, alloc)
        is Memory[Byte] as text =>
            Console.show("read it all: {text.count()} bytes")
            drop text
        is FsError as e =>
            out_of_memory: Bool = e == MemoryAllocationError()
            Console.show("turned down as out of memory: {out_of_memory}")
    discard_gone: Check[None] = check OsFileManager.delete(at: big)
    drop big
    drop tmp
    return
