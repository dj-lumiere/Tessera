# OsFileManager.read_all on a 32-bit target turns down a file of 4 GiB or more with OutOfMemory, without
# allocating: it can't fit in the address space. It used to crash with IntegerOverflowError converting the size.
# The file is sparse (set_size), so making it writes nothing, and it is deleted after.

import Standard/Os

routine start() -> None
    manager: @MemoryManager = HEAP
    tmp: &Directory <- OsEnvironment.temp_directory(manager)
    big: &File <- tmp.file(name: "tessera_fs_read_too_large.bin", manager)

    discard_made: Check[None] = check OsFileManager.make_file(at: big, replacing: true)
    four_gib: U64 = U64.shift_left(1, 32)
    sized: Bool = try OsFileManager.set_size(at: big, size: four_gib)
    Console.show("made a 4 GiB file: {sized}")
    when check OsFileManager.read_all(at: big, manager)
        is BorrowedSlice[Byte] as text =>
            Console.show("read it all: {text.count()} bytes")
            drop text
        is MemoryAllocationError => Console.show("turned down as out of memory: true")
        else => Console.show("turned down as out of memory: false")
    discard_gone: Check[None] = check OsFileManager.delete(at: big)
    drop big
    drop tmp
    return
