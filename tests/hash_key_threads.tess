// The first hash in a process draws its key. Four threads hash at once before anything else has, so they race to
// draw it: one draws and the others wait for it, and all four get the same hash, the one the main thread gets
// afterwards.

import Standard::Format
import Standard::Os

/// What one thread hashed.
record Slot
    value : U64

routine hash_once(slot: @Slot) -> Void
    block entry()
        n : U64 = 0x5EED
        n.hash().store_into(slot.value)
        return()

routine main() -> S32
    block entry()
        claim a : @Slot <- Slot { value: 0 }
        claim b : @Slot <- Slot { value: 0 }
        claim c : @Slot <- Slot { value: 0 }
        claim d : @Slot <- Slot { value: 0 }
        t1 : Thread = Thread.spawn(hash_once.to<Callable>(), a)
        t2 : Thread = Thread.spawn(hash_once.to<Callable>(), b)
        t3 : Thread = Thread.spawn(hash_once.to<Callable>(), c)
        t4 : Thread = Thread.spawn(hash_once.to<Callable>(), d)
        t1.join()
        t2.join()
        t3.join()
        t4.join()
        n    : U64  = 0x5EED
        mine : U64  = n.hash()
        ab   : Bool = a.value.load().eq(b.value.load())
        cd   : Bool = c.value.load().eq(d.value.load())
        ac   : Bool = a.value.load().eq(c.value.load())
        am   : Bool = a.value.load().eq(mine)
        Out.write("same key in every thread: {ab.bitand(cd).bitand(ac).bitand(am)}\n")
        return(0)
