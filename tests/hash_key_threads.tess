// The first hash in a process draws its key. Four threads hash at once before anything else has, so they race to
// draw it: one draws and the others wait for it, and all four get the same hash, the one the main thread gets
// afterwards.

import Standard/Format
import Standard/Os

/// What one thread hashed.
record Slot
    value: U64

/// Makes a `Slot` from its fields.
/// :param value: Its `value`.
/// :returns: The new value.
routine Slot.construct(value: U64) -> Me
    return(Me(value))

/// Releases nothing: a `Slot` holds no memory of its own.
routine Slot.destruct(me: @Me) -> Void
    return()

routine hash_once(slot: @Slot) -> Void
    n: U64 = 0x5EED
    n.hash().poke_into(slot.value)
    return()

routine start() -> Void
    claim a: @Slot <- Slot(value: 0)
    claim b: @Slot <- Slot(value: 0)
    claim c: @Slot <- Slot(value: 0)
    claim d: @Slot <- Slot(value: 0)
    t1: Thread = Thread.spawn(entry: hash_once.to[Callable](), arg: a)
    t2: Thread = Thread.spawn(entry: hash_once.to[Callable](), arg: b)
    t3: Thread = Thread.spawn(entry: hash_once.to[Callable](), arg: c)
    t4: Thread = Thread.spawn(entry: hash_once.to[Callable](), arg: d)
    t1.join()
    t2.join()
    t3.join()
    t4.join()
    n: U64 = 0x5EED
    mine: U64 = n.hash()
    ab: Bool = a.value.peek().eq(b.value.peek())
    cd: Bool = c.value.peek().eq(d.value.peek())
    ac: Bool = a.value.peek().eq(c.value.peek())
    am: Bool = a.value.peek().eq(mine)
    Out.write("same key in every thread: {ab.bitand(cd).bitand(ac).bitand(am)}\n")
    return()
