# SignalCaster across threads. A producer hands values to the main thread through a one-value mailbox, waiting for room
# on one SignalCaster while the main thread waits for a value on another: every value arrives, in order. Four threads
# wait at a gate for a token: each wake_one with one token lets exactly one through, and none is lost though all
# four were waiting. Four threads wait at a closed gate: one wake_all lets every one through. Waiters with a
# deadline under contention, while another thread takes the access and wakes everyone over and over: those whose
# condition never comes true give up at their deadline (the spurious wakes don't extend it), and those whose
# condition comes true return in time.
#
# Every waiter checks its condition again after each wait, so the output doesn't depend on when the threads run.

import Standard/Os

### The values the producer hands over.
preset ROUNDS: U64 = 10000
### The threads at the gate.
preset GATE_THREADS: U64 = 4
### The waiters of each kind in the deadline test.
preset TIMED_THREADS: U64 = 3
### How long a waiter whose condition never comes true waits.
preset SHORT: Duration = 20ms
### The deadline of a waiter whose condition comes true, far enough away never to be reached.
preset LONG: Duration = 10s

### A one-value mailbox between the producer thread and the main thread.
record Mailbox
    lock: ExclusiveAccess
    not_full: SignalCaster  # the producer waits here for room
    not_empty: SignalCaster  # the main thread waits here for a value
    full: Bool
    value: U64

### Where the gate threads wait: for a token (wake_one) or for the gate to open (wake_all).
record Gate
    lock: ExclusiveAccess
    cond: SignalCaster  # the gate threads wait here
    progress: SignalCaster  # the main thread waits here for the gate threads
    waiting: U64  # gate threads that have reached the gate
    tokens: U64  # passes not yet taken
    passed: U64  # gate threads through the gate
    open: Bool

### The deadline test: waiters for a condition that never comes true and for one that does, and a thread that takes
### the access and wakes everyone until told to stop.
record Timed
    lock: ExclusiveAccess
    cond: SignalCaster  # the waiters wait here
    progress: SignalCaster  # the main thread waits here for the waiters
    waiting: U64
    ready: Bool  # what the in-time waiters wait for
    stop: Bool  # tells the waking thread to stop
    timed_out: U64  # waiters that gave up at their deadline, not before
    in_time: U64  # waiters that saw ready before their deadline
    wrong: U64  # waiters that did neither

# -- the mailbox ---------------------------------------------------------------------

### The producer: hands over 1 to ROUNDS, waiting for room before each.
routine produce(box: @Mailbox) -> None
    each n in 1 to ROUNDS
        box.lock.lock()

        while box.full.peek()
            box.not_full.wait(box.lock)
        then
            box.value.poke(n)
            box.full.poke(true)
            box.not_empty.cast_one()
            box.lock.unlock()
            continue
    then
        return

### The main thread's side: takes ROUNDS values.
### :returns: Their sum, and whether they came in order.
routine consume(box: @Mailbox) -> (U64, Bool)
    local sum: @U64 <- 0
    local in_order: @Bool <- true

    each expected in 1 to ROUNDS
        box.lock.lock()

        until box.full.peek()
            box.not_empty.wait(box.lock)
        then
            value: U64 = box.value.peek()
            box.full.poke(false)
            box.not_full.cast_one()
            box.lock.unlock()
            (sum.peek() + value).poke_into(sum)
            (in_order.peek() and (value == expected)).poke_into(in_order)
            continue
    then
        return (sum.peek(), in_order.peek())

# -- the gate ------------------------------------------------------------------------

### Counts the calling thread in at the gate, with the lock held.
routine arrive(gate: @Gate) -> None
    arrived: U64 = gate.waiting.peek() + 1
    arrived.poke_into(gate.waiting)
    gate.progress.cast_all()
    return

### A gate thread that waits for a token and takes it.
routine take_token(gate: @Gate) -> None
    gate.lock.lock()
    arrive(gate)

    while true
        left2: U64 = gate.tokens.peek()
        if left2 > 0
            gate.tokens.poke(left2 - 1)
            through: U64 = gate.passed.peek() + 1
            through.poke_into(gate.passed)
            gate.progress.cast_all()
            gate.lock.unlock()
            return
        else
            gate.cond.wait(gate.lock)
            continue

### A gate thread that waits for the gate to open and goes through.
routine pass_open(gate: @Gate) -> None
    gate.lock.lock()
    arrive(gate)

    until gate.open.peek()
        gate.cond.wait(gate.lock)
    through: U64 = gate.passed.peek() + 1
    through.poke_into(gate.passed)
    gate.lock.unlock()
    return

### Waits, with the gate's lock held, until `count` gate threads have reached the gate. Each holds the lock from
### arriving until its wait releases it, so all of them are waiting by then.
routine await_waiting(gate: @Gate, count: U64) -> None
    while gate.waiting.peek() < count
        gate.progress.wait(gate.lock)
    then
        return

### Waits, with the gate's lock held, until `count` gate threads are through.
routine await_passed(gate: @Gate, count: U64) -> None
    while gate.passed.peek() < count
        gate.progress.wait(gate.lock)
    then
        return

### Gives the waiting gate threads one token at a time, each with one wake_one, and waits for one to go through.
### :returns: Whether each token let exactly one through.
routine hand_tokens(gate: @Gate) -> Bool
    local exact: @Bool <- true

    gate.lock.lock()
    await_waiting(gate, count: GATE_THREADS)

    each round in 1 to GATE_THREADS
        gate.tokens.poke(1)
        gate.cond.cast_one()
        await_passed(gate, count: round)
        through: U64 = gate.passed.peek()
        one: Bool = through == round and gate.tokens.peek() == 0
        (exact.peek() and one).poke_into(exact)
    gate.lock.unlock()
    return exact.peek()

### Opens the gate once every gate thread waits at it, with one wake_all.
routine open_gate(gate: @Gate) -> None
    gate.lock.lock()
    await_waiting(gate, count: GATE_THREADS)
    gate.open.poke(true)
    gate.cond.cast_all()
    gate.lock.unlock()
    return

# -- the deadlines -------------------------------------------------------------------

### Counts the calling thread in, with the lock held.
routine arrive_timed(timed: @Timed) -> None
    arrived: U64 = timed.waiting.peek() + 1
    arrived.poke_into(timed.waiting)
    timed.progress.cast_all()
    return

### Adds one to `counter`, with the lock held.
routine count_in(counter: @U64) -> None
    next_count: U64 = counter.peek() + 1
    next_count.poke_into(counter)
    return

### Waits SHORT for something that never comes true, again after every wake, until the deadline passes.
routine wait_never(timed: @Timed) -> None
    timed.lock.lock()
    arrive_timed(timed)

    deadline: Duration = Clock.monotonic() + SHORT

    while timed.cond.wait_until(access: timed.lock, deadline)
        pass
    then
        if Clock.monotonic() >= deadline
            count_in(timed.timed_out)
            timed.lock.unlock()
            return
        else
            count_in(timed.wrong)
            timed.lock.unlock()
            return

### Waits for ready, with a deadline it should never reach.
@generated
routine wait_ready(timed: @Timed) -> None
    timed.lock.lock()
    arrive_timed(timed)
    jump look(Clock.monotonic() + LONG)

    block look(deadline: Duration)
        if timed.ready.peek()
            jump seen()
        else
            jump wait(deadline)

    block wait(deadline: Duration)
        if timed.cond.wait_until(access: timed.lock, deadline)
            jump look(deadline)
        else
            jump late()

    block seen()
        count_in(timed.in_time)
        timed.lock.unlock()
        return

    block late()
        count_in(timed.wrong)
        timed.lock.unlock()
        return

### Takes the access and wakes every waiter, over and over, until stop.
routine wake_everyone(timed: @Timed) -> None
    while true
        timed.lock.lock()
        stop2: Bool = timed.stop.peek()
        timed.cond.cast_all()
        timed.lock.unlock()
        if stop2
            return
        else
            continue

### Sets ready once every waiter waits, and wakes them all.
routine make_ready(timed: @Timed) -> None
    timed.lock.lock()

    while timed.waiting.peek() < TIMED_THREADS.mul(2)
        timed.progress.wait(timed.lock)
    timed.ready.poke(true)
    timed.cond.cast_all()
    timed.lock.unlock()
    return

# -- threads -------------------------------------------------------------------------

### A run of slots in a thread array: `count` of them from `first` on.
record ThreadSlots
    ### The array the threads go into.
    threads: @Array[Thread[None], 8]
    ### The first slot of the run.
    first: U64
    ### How many slots the run has.
    count: U64

### Makes a `ThreadSlots` from its fields.
### :param threads: Its `threads`.
### :param first: Its `first`.
### :param count: Its `count`.
### :returns: The new value.
common routine ThreadSlots.construct(threads: @Array[Thread[None], 8], first: U64, count: U64) -> Me
    return Me(threads, first, count)

### Releases nothing: a `ThreadSlots` holds no memory of its own.
routine @ThreadSlots.destruct() -> None
    return

### Starts a thread in each of `slots`, each running `body` on `state`.
routine spawn_many[T](body: Callable[(@T,), None], state: @T, slots: ThreadSlots) -> None
needs T: typename
    local threads: @Array[Thread[None], 8] = slots.threads
    local end: U64 = slots.first + slots.count

    each i in slots.first til end
        t: Thread[None] = get_thread[None]()
        t.put_work(entry: body, args: state)
        threads[i] = t
    then
        return

### Joins the threads in `threads` below `count`.
routine join_many(threads: @Array[Thread[None], 8], count: U64) -> None
    each i in 0 til count
        t: Thread[None] = threads[i]
        t.wait_finished()
        t.give_back()
    then
        return

routine start() -> None
    local threads: @Array[Thread[None], 8] <- .hollow()
    local box: @Mailbox <- Mailbox(lock: .construct(), not_full: .construct(),
        not_empty: .construct(), full: false, value: 0)

    producer: Thread[None] = get_thread[None]()
    producer.put_work(entry: produce.to[Callable](), args: box)
    sum, in_order = consume(box)
    producer.wait_finished()
    producer.give_back()
    Console.show("handoff: {ROUNDS} values, sum {sum}, in order {in_order}")
    local tokens: @Gate <- Gate(lock: .construct(), cond: .construct(), progress: .construct(),
        waiting: 0, tokens: 0, passed: 0, open: false)
    spawn_many(body: take_token.to[Callable](), state: tokens,
        slots: ThreadSlots(threads: threads, first: 0, count: GATE_THREADS))
    exact: Bool = hand_tokens(tokens)
    join_many(threads, count: GATE_THREADS)
    Console.show("wake_one: {GATE_THREADS} tokens, one thread through for each: {exact}")
    local gate: @Gate <- Gate(lock: .construct(), cond: .construct(), progress: .construct(),
        waiting: 0, tokens: 0, passed: 0, open: false)
    spawn_many(body: pass_open.to[Callable](), state: gate,
        slots: ThreadSlots(threads: threads, first: 0, count: GATE_THREADS))
    open_gate(gate)
    join_many(threads, count: GATE_THREADS)
    Console.show("wake_all: {gate.passed.peek()} of {GATE_THREADS} through after one wake")
    local timed: @Timed <- Timed(lock: .construct(), cond: .construct(), progress: .construct(),
        waiting: 0, ready: false, stop: false, timed_out: 0, in_time: 0, wrong: 0)
    waker: Thread[None] = get_thread[None]()
    waker.put_work(entry: wake_everyone.to[Callable](), args: timed)
    spawn_many(body: wait_never.to[Callable](), state: timed,
        slots: ThreadSlots(threads: threads, first: 0, count: TIMED_THREADS))
    spawn_many(body: wait_ready.to[Callable](), state: timed,
        slots: ThreadSlots(threads: threads, first: TIMED_THREADS, count: TIMED_THREADS))
    make_ready(timed)
    join_many(threads, count: TIMED_THREADS.mul(2))
    timed.lock.lock()
    timed.stop.poke(true)
    timed.lock.unlock()
    waker.wait_finished()
    waker.give_back()
    Console.show("deadlines under contention: {timed.timed_out.peek()} gave up at the deadline, ", end: "")
    Console.show("{timed.in_time.peek()} woken in time, {timed.wrong.peek()} wrong")
    return
