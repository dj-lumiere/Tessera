// put_work takes the arguments its entry takes: an entry on an @S64 can't be handed a @U8, on a fiber as on a thread.

import Standard/Fiber
import Standard/Os

routine count_up(n: @S64) -> Void
    (n.peek() + 1).poke_into(n)
    return

routine start() -> Void
    local small: @U8 <- 0
    f: Fiber[Void] = FIBERS.get_fiber[Void]()
    f.put_work(entry: count_up.to[Callable](), args: small)
    f.wait_finished()
    f.give_back()
    return
