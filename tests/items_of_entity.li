# An Items is a record, so its elements hold nothing with a release duty: entities go in a Slots.

### A counter.
entity Counter
    n: S64

### Makes one.
### :returns: The new value.
common routine Counter.construct() -> Me
    return Me(n: 0)

### Ends it.
routine @Counter.destruct() -> None
    return

routine start() -> None
    xs: &Items[Counter, 2] <- [Counter.construct(), Counter.construct()]
    return
