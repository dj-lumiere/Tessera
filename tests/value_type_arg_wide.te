# A value type argument keeps every bit of the type its parameter is declared with: a U64 at or above 2^63, a U256, and
# a negative S64 all read back as written, and two U256 values that differ only above bit 63 are two types.
import Hosted

### A number modulo P.
### :typeparam P: The modulus.
record Field[P]
needs U256 P
    v: U256

### A U64 parameter.
### :typeparam N: The value.
record Wide[N]
needs U64 N
    v: U64

### A signed parameter.
### :typeparam D: The offset.
record Offset[D]
needs S64 D
    v: S64

### The modulus.
### :returns: P.
routine Field[P].modulus() -> U256
needs U256 P
    return P

### The value.
### :returns: N.
routine Wide[N].value() -> U64
needs U64 N
    return N

### The offset.
### :returns: D.
routine Offset[D].value() -> S64
needs S64 D
    return D

### Prints each value.
routine start() -> None
    w: Wide[18446744073709551557] = .hollow()
    Console.show("{w.value()}")
    big: Field[115792089237316195423570985008687907853269984665640564039457584007913129639747] = .hollow()
    Console.show("{big.modulus()}")
    low: Field[1] = .hollow()
    high: Field[18446744073709551617] = .hollow()
    Console.show("{low.modulus()} {high.modulus()}")
    o: Offset[-5] = .hollow()
    Console.show("{o.value()}")
    return
