# A view whose place may be given back can't be kept in a field of an entity that is already made: the entity is
# reached from other routines later, and the build can't compare those uses with the give back.

import Hosted

### Keeps a view.
entity Holder
    v: @S64?

### Makes a holder.
### :param v: The view it starts with.
### :returns: The holder.
common routine Holder.construct(v: @S64?) -> Me
    return Me(v)

### Keeps `v` in the holder.
### :param v: The view.
routine @Holder.keep(v: @S64) -> None
    me.v.poke(v)
    return

### Hands the holder a view of memory it gives back.
routine start() -> None
    x: &S64 <- 5 from HEAP
    h: &Holder <- Holder.construct(v: None())
    h.keep(v: x)
    drop x
    return
