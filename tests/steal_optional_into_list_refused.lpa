# A Box? taken out of a List[Box?] slot is handed into a List[Box]: the build refuses it, since the slot may have been empty.
# The hollow Box it would keep stops the program later, far from the mistake.

import Collections
import Hosted

### A box.
entity Box
    n: U64

### Makes a box.
### :param n: Its number.
### :returns: The box.
common routine Box.construct(n: U64) -> Me
    return Me(n)

### Moves the empty slot into a list of boxes and reads it.
routine start() -> None
    slots: &List[Box?] <- .construct(HEAP)
    slots.add_last(None())
    packed: &List[Box] <- .construct(HEAP)
    steal slots.getslot(0) as taken inject None()
    packed.add_last(steal taken)
    Console.show("count {packed.count()}")
    Console.show("n = {packed.getslot(0).n.peek()}")
    drop packed
    drop slots
    return
