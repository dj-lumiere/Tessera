# A bare @reshaping says the routine may move the memory of every field of me (a move the builder can not see), so it is not allowed while one of them is walked.

import Collections
import Hosted

### A box with two lists.
entity Box
    rows: List[List[U64]]
    log: List[U64]

### A box with empty lists.
### :returns: The box.
common routine Box.construct() -> Me
    return Me(rows: .construct(HEAP), log: .construct(HEAP))

### Adds to the log.
### :param x: The value.
@reshaping
routine @Box.note(x: U64) -> None
    me.log.add_last(x)
    return

routine start() -> None
    b: &Box <- .construct()
    row: &List[U64] <- .construct(HEAP)
    row.add_last(1)
    b.rows.add_last(steal row)
    for x in b.rows.getslot(0).emitter()
        b.note(x)
    Console.show(b.log.count())
    return
