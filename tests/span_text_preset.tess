// A Span[Byte] preset of a string literal, and a Span preset of text Spans that names it.

import Standard/Format
import Standard/Os

preset GREETING: Span[Byte] <- "hello"
preset WORDS: Span[Span[Byte]] <- [GREETING, "world"]

routine start() -> Void
    out: @Out = Out.writer()
    w: Span[Byte] = WORDS.getitem(1)
    out.write("{GREETING} {GREETING.count()} {WORDS.getitem(0)} {w}\n")
    return
