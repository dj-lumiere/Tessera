# SipHash-2-4 against the reference: the paper's 64 test vectors (key 00..0f, messages 00, 00 01, ..., 00..3e),
# each printed as the U64 it is (the paper lists its bytes, little-endian). Then the 8- and 16-byte fast paths
# against the byte path, and the stdlib hash() against SipHash under the process key.

import Hosted

routine start() -> None
    message: &Items[Byte, 64]
    key: SipKey = (k0: 0x0706050403020100, k1: 0x0F0E0D0C0B0A0908)

    for at: U64 in 0 til 64
        message[at] = at.to[U8]().bits()

    for count: U64 in 0 til 64
        h: U64 = siphash24(data: message.getview().to[@Byte](), count, key)
        h.represent_hex_into(out: Console.output(), min_digits: 16)
        Console.show("")
    bytes: @Byte = message.getview().to[@Byte]()
    low: U64 = bytes.to[@U64]().peek_unaligned()
    high: U64 = bytes.stride(8).to[@U64]().peek_unaligned()
    one: Bool = siphash24(value: low, key) == siphash24(data: bytes, count: 8, key)
    two: Bool = siphash24(low, high, key) == siphash24(data: bytes, count: 16, key)
    Console.show("8-byte path matches: {one}\n16-byte path matches: {two}")
    n: U64 = 0x123456789ABCDEF0
    keyed: Bool = n.hash() == siphash24(value: n, key: hash_key())
    same: Bool = n.hash() == n.hash()
    wide: U128 = U128.shift_left(1, 100)
    wide_ok: Bool = wide.hash() == siphash24(low: 0, high: (wide >> 64).to[U64](), key: hash_key())
    text: @[Byte] = "siphash"
    text_ok: Bool = text.hash() == siphash24(data: text.data, count: text.count, key: hash_key())
    Console.show("hash() is keyed SipHash: {keyed}, stable: {same}, U128: {wide_ok}, Bytes: {text_ok}")
    return
