# Two tickets whose work's routines fail differently: each ticket's type carries the list of its own work's routine, so
# each retrieve() throws only that list: the arm for the other ticket's crashable never runs.

import Hosted

crashable EmptyNameError
    nothing

crashable NegativeCountError
    count: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine EmptyNameError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("the name is empty")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine NegativeCountError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("the count {me.count} is negative")
    return

### The length of a name, failing for an empty one.
### :param name: The name.
### :returns: Its length.
routine name_length(name: @[Byte]) -> U64
    if name.count() == 0
        throw EmptyNameError()
    return name.count()

### The count, failing for a negative one.
### :param count: The count.
### :returns: It.
routine counted(count: S64) -> S64
    if count < 0
        throw NegativeCountError(count)
    return count

### Runs the example.
routine start() -> None
    names: Thread[U64] <- get_thread[U64]()
    counts: Thread[S64] <- get_thread[S64]()
    names.put_work(name_length.to[Work](name: ""))
    counts.put_work(counted.to[Work](count: -2))
    when check names.retrieve()
        is U64 as n => Console.show("length {n}")
        is EmptyNameError => Console.show("names: the name is empty")
        is NegativeCountError => Console.show("names: never")
        is Crashables as e => Console.show("names: {e.name()}")
    when check counts.retrieve()
        is S64 as n => Console.show("count {n}")
        is NegativeCountError as e => Console.show("counts: {e.count} is negative")
        is EmptyNameError => Console.show("counts: never")
        is Crashables as e => Console.show("counts: {e.name()}")
    drop names
    drop counts
    return
