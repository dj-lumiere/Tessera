// A bare { ... } literal takes its type from where the value goes: a preset, a global, a typed binding,
// a nested element, a record binding, a routine argument, or the pointer a literal receiver is stored into.

import Standard::Format
import Standard::Os

global ORIGIN: @Array<S64, 2> <- { 10, 20 }

preset SORTED: @Array<S64, 5> <- { -8, -3, 0, 2, 7 }
preset GRID: @Array<Array<S16, 2>, 2> <- { { 1, 2 }, { 3, 4 } }

record Point
    x : S64
    y : S64

routine sum2(a: Array<S64, 2>) -> S64
    block entry()
        claim slot : @Array<S64, 2> <- a
        return(slot.getitem(0).add(slot.getitem(1)))

routine start() -> Void
    block entry()
        Out.write("{SORTED.getitem(0)} {SORTED.getitem(4)}\n")
        claim row : @Array<S16, 2> <- GRID.getitem(1)
        Out.write("{row.getitem(0).to<S64>()}\n")
        Out.write("{ORIGIN.getitem(1)}\n")

        x    : S64           = 5
        pair : Array<S64, 2> = { x, 6 }
        Out.write("{sum2(pair)}\n")
        Out.write("{sum2({ 7, 8 })}\n")

        claim slot : @Array<S64, 2> <- { 3, 4 }
        Out.write("{slot.getitem(1)}\n")

        p : Point = { x: 1, y: x }
        Out.write("{p.x} {p.y}\n")
        return()
