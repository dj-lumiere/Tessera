// A one-field record has its field's representation, and its debug type is a typedef of the field's type. When the
// field points back at the record, the typedef would be its own base type through the pointer, which crashed clang's
// debug-information writer. Such a record's debug type is a structure of its one member instead. Reached from the
// pointer side (a global holding @@Node) and from the record side (a Node binding).

import Standard/Format
import Standard/Os

global FIRST: @Node <- (prev: null)
global SECOND: @Node <- (prev: FIRST)
global TOP: @@Node <- SECOND

record Node
    prev: @Node

/// Two one-field records that point at each other.
record Even
    next: @Odd

record Odd
    next: @Even

/// Makes a `Node` from its fields.
/// :param prev: Its `prev`.
/// :returns: The new value.
routine Node.construct(prev: @Me) -> Me
    return Me(prev)

/// Releases nothing: a `Node` holds no memory of its own.
routine Node.destruct(me: @Me) -> Void
    return

/// Makes a `Even` from its fields.
/// :param next: Its `next`.
/// :returns: The new value.
routine Even.construct(next: @Odd) -> Me
    return Me(next)

/// Releases nothing: a `Even` holds no memory of its own.
routine Even.destruct(me: @Me) -> Void
    return

/// Makes a `Odd` from its fields.
/// :param next: Its `next`.
/// :returns: The new value.
routine Odd.construct(next: @Even) -> Me
    return Me(next)

/// Releases nothing: a `Odd` holds no memory of its own.
routine Odd.destruct(me: @Me) -> Void
    return

routine depth(node: @Node) -> S64
    local count: @S64 <- 0

    until at.is_null() with at: @Node = node
        local here: @Node <- at.peek()
        (count.peek() + 1).poke_into(count)
        continue with at: here.prev.peek()
    then
        return count.peek()

routine start() -> Void
    local odd: @Odd <- Odd(next: null)
    local even: @Even <- Even(next: odd)
    linked: Bool = even.next.peek().is_not_null()
    Out.write("depth {depth(TOP.peek())}, linked {linked}\n")
    return
