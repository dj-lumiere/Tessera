// A one-field record has its field's representation, and its debug type is a typedef of the field's type. When the
// field points back at the record, the typedef would be its own base type through the pointer, which crashed clang's
// debug-information writer. Such a record's debug type is a structure of its one member instead. Reached from the
// pointer side (a global holding @@Node) and from the record side (a Node binding).

import Standard::Format
import Standard::Os

global TOP : @@Node <- null

record Node
    prev : @Node

/// Two one-field records that point at each other.
record Even
    next : @Odd

record Odd
    next : @Even

routine depth(node: @Node) -> S64
    block entry()
        jump walk(node, 0)

    block walk(at: @Node, count: S64)
        branch at.is_null()
            ? return(count)
            : continue
        claim here : @Node <- at.load()
        jump walk(here.prev.load(), count.add(1))

routine main() -> S32
    block entry()
        claim first  : @Node <- Node { prev: null }
        claim second : @Node <- Node { prev: first }
        TOP.store(second)
        claim odd  : @Odd  <- Odd { next: null }
        claim even : @Even <- Even { next: odd }
        linked : Bool = even.next.load().is_not_null()
        Out.write("depth {depth(TOP.load())}, linked {linked}\n")
        return(0)
