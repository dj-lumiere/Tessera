# A view of memory handed to a routine after the memory is given back.
import Standard/Os

### Reads.
### :param v: The bytes.
### :returns: The count.
routine count_of(v: @[Byte]) -> U64
    return v.count

routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP

    v: @[Byte] = m.getslice()
    drop m
    n: U64 = count_of(v: v)
    return
