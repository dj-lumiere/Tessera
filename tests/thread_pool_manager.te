# ThreadPoolManager: a sum over a million numbers splits itself in halves on more jobs until a part is small, on four
# threads. A job that waits for its half parks, its thread goes on with other jobs, and the thread that finishes the
# half wakes it.

import Standard/Fiber
import Standard/Os

### The sum of lo ..< hi, split in halves on more jobs until a part is small.
routine sum_range(pool: @ThreadPoolManager, lo: U64, hi: U64) -> U64
    if hi - lo <= 1000
        each i in lo til hi with total: U64 = 0
            continue with total: total + i
        then
            return total
    else
        mid: U64 = lo + (hi - lo) // 2
        left: Job[U64] <- pool.get_job[U64]()
        work_left: Work[U64] <- sum_range.to[Work](pool: pool, lo: lo, hi: mid)
        left.put_work(work_left)
        drop work_left
        right: U64 = sum_range(pool, lo: mid, hi)
        left.wait_finished()
        l: U64 = left.retrieve()
        drop left
        return l + right

routine start() -> None
    out: @ConsoleOutput = Console.output()
    pool: &ThreadPoolManager <- .construct(threads: 4)
    j: Job[U64] <- pool.get_job[U64]()
    work_j: Work[U64] <- sum_range.to[Work](pool: pool, lo: 0, hi: 1000000)
    j.put_work(work_j)
    drop work_j
    j.wait_finished()
    out.write("{j.retrieve()}\n")
    drop j
    drop pool
    return
