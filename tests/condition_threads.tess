// SignalCaster across threads. A producer hands values to the main thread through a one-value mailbox, waiting for room
// on one SignalCaster while the main thread waits for a value on another: every value arrives, in order. Four threads
// wait at a gate for a token: each wake_one with one token lets exactly one through, and none is lost though all
// four were waiting. Four threads wait at a closed gate: one wake_all lets every one through. Waiters with a
// deadline under contention, while another thread takes the mutex and wakes everyone over and over: those whose
// condition never comes true give up at their deadline (the spurious wakes don't extend it), and those whose
// condition comes true return in time.
//
// Every waiter checks its condition again after each wait, so the output doesn't depend on when the threads run.

import Standard/Alloc
import Standard/Format
import Standard/Os

/// The values the producer hands over.
preset ROUNDS: U64 = 10000
/// The threads at the gate.
preset GATE_THREADS: USize = 4
/// The waiters of each kind in the deadline test.
preset TIMED_THREADS: USize = 3
/// How long a waiter whose condition never comes true waits.
preset SHORT_NS: U64 = 20000000
/// The deadline of a waiter whose condition comes true, far enough away never to be reached.
preset LONG_NS: U64 = 10000000000

/// A one-value mailbox between the producer thread and the main thread.
record Mailbox
    lock: ExclusiveLock
    not_full: SignalCaster  // the producer waits here for room
    not_empty: SignalCaster  // the main thread waits here for a value
    full: Bool
    value: U64

/// Where the gate threads wait: for a token (wake_one) or for the gate to open (wake_all).
record Gate
    lock: ExclusiveLock
    cond: SignalCaster  // the gate threads wait here
    progress: SignalCaster  // the main thread waits here for the gate threads
    waiting: USize  // gate threads that have reached the gate
    tokens: USize  // passes not yet taken
    passed: USize  // gate threads through the gate
    open: Bool

/// The deadline test: waiters for a condition that never comes true and for one that does, and a thread that takes
/// the mutex and wakes everyone until told to stop.
record Timed
    lock: ExclusiveLock
    cond: SignalCaster  // the waiters wait here
    progress: SignalCaster  // the main thread waits here for the waiters
    waiting: USize
    ready: Bool  // what the in-time waiters wait for
    stop: Bool  // tells the waking thread to stop
    timed_out: USize  // waiters that gave up at their deadline, not before
    in_time: USize  // waiters that saw ready before their deadline
    wrong: USize  // waiters that did neither

/// Makes a `Mailbox` from its fields.
/// :param lock: Its `lock`.
/// :param not_full: Its `not_full`.
/// :param not_empty: Its `not_empty`.
/// :param full: Its `full`.
/// :param value: Its `value`.
/// :returns: The new value.
routine Mailbox.construct(lock: ExclusiveLock, not_full: SignalCaster, not_empty: SignalCaster,
    full: Bool, value: U64) -> Me
    return(Me(lock, not_full, not_empty, full, value))

/// Releases nothing: a `Mailbox` holds no memory of its own.
routine Mailbox.destruct(me: @Me) -> Void
    return()

/// Makes a `Gate` from its fields.
/// :param lock: Its `lock`.
/// :param cond: Its `cond`.
/// :param progress: Its `progress`.
/// :param waiting: Its `waiting`.
/// :param tokens: Its `tokens`.
/// :param passed: Its `passed`.
/// :param open: Its `open`.
/// :returns: The new value.
routine Gate.construct(lock: ExclusiveLock, cond: SignalCaster, progress: SignalCaster,
    waiting: USize, tokens: USize, passed: USize, open: Bool) -> Me
    return(Me(lock, cond, progress, waiting, tokens, passed, open))

/// Releases nothing: a `Gate` holds no memory of its own.
routine Gate.destruct(me: @Me) -> Void
    return()

/// Makes a `Timed` from its fields.
/// :param lock: Its `lock`.
/// :param cond: Its `cond`.
/// :param progress: Its `progress`.
/// :param waiting: Its `waiting`.
/// :param ready: Its `ready`.
/// :param stop: Its `stop`.
/// :param timed_out: Its `timed_out`.
/// :param in_time: Its `in_time`.
/// :param wrong: Its `wrong`.
/// :returns: The new value.
routine Timed.construct(lock: ExclusiveLock, cond: SignalCaster, progress: SignalCaster,
    waiting: USize, ready: Bool, stop: Bool, timed_out: USize, in_time: USize, wrong: USize) -> Me
    return(Me(lock, cond, progress, waiting, ready, stop, timed_out, in_time, wrong))

/// Releases nothing: a `Timed` holds no memory of its own.
routine Timed.destruct(me: @Me) -> Void
    return()

// -- the mailbox ---------------------------------------------------------------------

/// The producer: hands over 1 to ROUNDS, waiting for room before each.
routine produce(box: @Mailbox) -> Void
    jump next(1)

    block next(n: U64)
        branch n.gt(ROUNDS)
            ? return()
            : continue
        box.lock.lock()
        jump room(n)

    block room(n: U64)
        full: Bool = box.full.peek()
        branch full
            ? wait(n)
            : put(n)

    block wait(n: U64)
        box.not_full.wait(box.lock)
        jump room(n)

    block put(n: U64)
        box.value.poke(n)
        box.full.poke(true)
        box.not_empty.cast_one()
        box.lock.unlock()
        jump next(n.add(1))

/// The main thread's side: takes ROUNDS values.
/// :returns: Their sum, and whether they came in order.
routine consume(box: @Mailbox) -> (U64, Bool)
    local sum: @U64 <- 0
    local in_order: @Bool <- true

    jump next(1)

    block next(expected: U64)
        branch expected.gt(ROUNDS)
            ? return((sum.peek(), in_order.peek()))
            : continue
        box.lock.lock()
        jump item(expected)

    block item(expected: U64)
        full: Bool = box.full.peek()
        branch full
            ? take(expected)
            : wait(expected)

    block wait(expected: U64)
        box.not_empty.wait(box.lock)
        jump item(expected)

    block take(expected: U64)
        value: U64 = box.value.peek()
        box.full.poke(false)
        box.not_full.cast_one()
        box.lock.unlock()
        sum.peek().add(value).poke_into(sum)
        in_order.peek().bitand(value.eq(expected)).poke_into(in_order)
        jump next(expected.add(1))

// -- the gate ------------------------------------------------------------------------

/// Counts the calling thread in at the gate, with the lock held.
routine arrive(gate: @Gate) -> Void
    arrived: USize = gate.waiting.peek().add(1)
    arrived.poke_into(gate.waiting)
    gate.progress.cast_all()
    return()

/// A gate thread that waits for a token and takes it.
routine take_token(gate: @Gate) -> Void
    gate.lock.lock()
    arrive(gate)
    jump look()

    block look()
        left: USize = gate.tokens.peek()
        branch left.gt(0)
            ? take(left)
            : wait()

    block wait()
        gate.cond.wait(gate.lock)
        jump look()

    block take(left: USize)
        gate.tokens.poke(left.sub(1))
        through: USize = gate.passed.peek().add(1)
        through.poke_into(gate.passed)
        gate.progress.cast_all()
        gate.lock.unlock()
        return()

/// A gate thread that waits for the gate to open and goes through.
routine pass_open(gate: @Gate) -> Void
    gate.lock.lock()
    arrive(gate)
    jump look()

    block look()
        open: Bool = gate.open.peek()
        branch open
            ? pass()
            : wait()

    block wait()
        gate.cond.wait(gate.lock)
        jump look()

    block pass()
        through: USize = gate.passed.peek().add(1)
        through.poke_into(gate.passed)
        gate.lock.unlock()
        return()

/// Waits, with the gate's lock held, until `count` gate threads have reached the gate. Each holds the lock from
/// arriving until its wait releases it, so all of them are waiting by then.
routine await_waiting(gate: @Gate, count: USize) -> Void
    jump look()

    block look()
        arrived: USize = gate.waiting.peek()
        branch arrived.ge(count)
            ? return()
            : wait()

    block wait()
        gate.progress.wait(gate.lock)
        jump look()

/// Waits, with the gate's lock held, until `count` gate threads are through.
routine await_passed(gate: @Gate, count: USize) -> Void
    jump look()

    block look()
        through: USize = gate.passed.peek()
        branch through.ge(count)
            ? return()
            : wait()

    block wait()
        gate.progress.wait(gate.lock)
        jump look()

/// Gives the waiting gate threads one token at a time, each with one wake_one, and waits for one to go through.
/// :returns: Whether each token let exactly one through.
routine hand_tokens(gate: @Gate) -> Bool
    local exact: @Bool <- true

    gate.lock.lock()
    await_waiting(gate, count: GATE_THREADS)
    jump give(1)

    block give(round: USize)
        branch round.gt(GATE_THREADS)
            ? done()
            : continue
        gate.tokens.poke(1)
        gate.cond.cast_one()
        await_passed(gate, count: round)
        through: USize = gate.passed.peek()
        one: Bool = through.eq(round).bitand(gate.tokens.peek().eq(0))
        exact.peek().bitand(one).poke_into(exact)
        jump give(round.add(1))

    block done()
        gate.lock.unlock()
        return(exact.peek())

/// Opens the gate once every gate thread waits at it, with one wake_all.
routine open_gate(gate: @Gate) -> Void
    gate.lock.lock()
    await_waiting(gate, count: GATE_THREADS)
    gate.open.poke(true)
    gate.cond.cast_all()
    gate.lock.unlock()
    return()

// -- the deadlines -------------------------------------------------------------------

/// Counts the calling thread in, with the lock held.
routine arrive_timed(timed: @Timed) -> Void
    arrived: USize = timed.waiting.peek().add(1)
    arrived.poke_into(timed.waiting)
    timed.progress.cast_all()
    return()

/// Adds one to `counter`, with the lock held.
routine count_in(counter: @USize) -> Void
    next_count: USize = counter.peek().add(1)
    next_count.poke_into(counter)
    return()

/// Waits SHORT_NS for something that never comes true, again after every wake, until the deadline passes.
routine wait_never(timed: @Timed) -> Void
    timed.lock.lock()
    arrive_timed(timed)
    deadline: U64 = monotonic_ns().add(SHORT_NS)
    jump again(deadline)

    block again(deadline: U64)
        in_time: Bool = timed.cond.wait_until(mutex: timed.lock, deadline_ns: deadline)
        branch in_time
            ? again(deadline)
            : over(deadline)

    block over(deadline: U64)
        passed: Bool = monotonic_ns().ge(deadline)
        branch passed
            ? gave_up()
            : early()

    block gave_up()
        count_in(timed.timed_out)
        timed.lock.unlock()
        return()

    block early()
        count_in(timed.wrong)
        timed.lock.unlock()
        return()

/// Waits for ready, with a deadline it should never reach.
routine wait_ready(timed: @Timed) -> Void
    timed.lock.lock()
    arrive_timed(timed)
    deadline: U64 = monotonic_ns().add(LONG_NS)
    jump look(deadline)

    block look(deadline: U64)
        ready: Bool = timed.ready.peek()
        branch ready
            ? seen()
            : wait(deadline)

    block wait(deadline: U64)
        in_time: Bool = timed.cond.wait_until(mutex: timed.lock, deadline_ns: deadline)
        branch in_time
            ? look(deadline)
            : late()

    block seen()
        count_in(timed.in_time)
        timed.lock.unlock()
        return()

    block late()
        count_in(timed.wrong)
        timed.lock.unlock()
        return()

/// Takes the mutex and wakes every waiter, over and over, until stop.
routine wake_everyone(timed: @Timed) -> Void
    jump again()

    block again()
        timed.lock.lock()
        stop: Bool = timed.stop.peek()
        timed.cond.cast_all()
        timed.lock.unlock()
        branch stop
            ? return()
            : again()

/// Sets ready once every waiter waits, and wakes them all.
routine make_ready(timed: @Timed) -> Void
    timed.lock.lock()
    jump look()

    block look()
        arrived: USize = timed.waiting.peek()
        branch arrived.ge(TIMED_THREADS.mul(2))
            ? go()
            : wait()

    block wait()
        timed.progress.wait(timed.lock)
        jump look()

    block go()
        timed.ready.poke(true)
        timed.cond.cast_all()
        timed.lock.unlock()
        return()

// -- threads -------------------------------------------------------------------------

/// A run of slots in a thread array: `count` of them from `first` on.
record ThreadSlots
    /// The array the threads go into.
    threads: @Array[Thread[Void], 8]
    /// The first slot of the run.
    first: USize
    /// How many slots the run has.
    count: USize

/// Makes a `ThreadSlots` from its fields.
/// :param threads: Its `threads`.
/// :param first: Its `first`.
/// :param count: Its `count`.
/// :returns: The new value.
routine ThreadSlots.construct(threads: @Array[Thread[Void], 8], first: USize, count: USize) -> Me
    return(Me(threads, first, count))

/// Releases nothing: a `ThreadSlots` holds no memory of its own.
routine ThreadSlots.destruct(me: @Me) -> Void
    return()

/// Starts a thread in each of `slots`, each running `body` on `state`.
routine spawn_many[T](body: Callable[(@T,), Void], state: @T, slots: ThreadSlots,
    alloc: @MemoryManager) -> Void
require T: typename
    local threads: @Array[Thread[Void], 8] = slots.threads
    local end: USize = slots.first.add(slots.count)

    jump next(slots.first)

    block next(i: USize)
        branch i.ge(end)
            ? return()
            : continue
        t: Thread[Void] = get_thread[Void]()
        t.put_work(entry: body, args: state)
        threads.setitem(index: i, value: t)
        jump next(i.add(1))

/// Joins the threads in `threads` below `count`.
routine join_many(threads: @Array[Thread[Void], 8], count: USize) -> Void
    jump next(0)

    block next(i: USize)
        branch i.ge(count)
            ? return()
            : continue
        t: Thread[Void] = threads.getitem(i)
        t.wait_finished()
        t.give_back()
        jump next(i.add(1))

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    claim threads: @Array[Thread[Void], 8] <- .hollow()
    claim box: @Mailbox <- Mailbox(lock: .construct(), not_full: .construct(),
        not_empty: .construct(), full: false, value: 0)
    producer: Thread[Void] = get_thread[Void]()
    producer.put_work(entry: produce.to[Callable](), args: box)
    sum, in_order = consume(box)
    producer.wait_finished()
    producer.give_back()
    Out.write("handoff: {ROUNDS} values, sum {sum}, in order {in_order}\n")
    claim tokens: @Gate <- Gate(lock: .construct(), cond: .construct(), progress: .construct(),
        waiting: 0, tokens: 0, passed: 0, open: false)
    spawn_many(body: take_token.to[Callable](), state: tokens,
        slots: ThreadSlots(threads: threads, first: 0, count: GATE_THREADS), alloc)
    exact: Bool = hand_tokens(tokens)
    join_many(threads, count: GATE_THREADS)
    Out.write("wake_one: {GATE_THREADS} tokens, one thread through for each: {exact}\n")
    claim gate: @Gate <- Gate(lock: .construct(), cond: .construct(), progress: .construct(),
        waiting: 0, tokens: 0, passed: 0, open: false)
    spawn_many(body: pass_open.to[Callable](), state: gate,
        slots: ThreadSlots(threads: threads, first: 0, count: GATE_THREADS), alloc)
    open_gate(gate)
    join_many(threads, count: GATE_THREADS)
    Out.write("wake_all: {gate.passed.peek()} of {GATE_THREADS} through after one wake\n")
    claim timed: @Timed <- Timed(lock: .construct(), cond: .construct(), progress: .construct(),
        waiting: 0, ready: false, stop: false, timed_out: 0, in_time: 0, wrong: 0)
    waker: Thread[Void] = get_thread[Void]()
    waker.put_work(entry: wake_everyone.to[Callable](), args: timed)
    spawn_many(body: wait_never.to[Callable](), state: timed,
        slots: ThreadSlots(threads: threads, first: 0, count: TIMED_THREADS), alloc)
    spawn_many(body: wait_ready.to[Callable](), state: timed,
        slots: ThreadSlots(threads: threads, first: TIMED_THREADS, count: TIMED_THREADS), alloc)
    make_ready(timed)
    join_many(threads, count: TIMED_THREADS.mul(2))
    timed.lock.lock()
    timed.stop.poke(true)
    timed.lock.unlock()
    waker.wait_finished()
    waker.give_back()
    Out.write("deadlines under contention: {timed.timed_out.peek()} gave up at the deadline, ")
    Out.write("{timed.in_time.peek()} woken in time, {timed.wrong.peek()} wrong\n")
    return()
