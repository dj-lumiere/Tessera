// A crash names the caller's place: the stdlib's add is #track_caller, so is check below, and check passes on the
// place it was called from. The handler prints it and exits with status 3.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        file : Bytes = place.file.load()
        here : Bool  = file.has_suffix("track_caller.tess")
        Out.write("crashed: {name} at {place.line.load()}:{place.column.load()}, this file {here}\n")
        exit(3)

/// Adds one, which overflows at S64.MAX: the place is check's caller.
#track_caller
routine check(x: S64) -> S64
    block entry()
        y : S64 = x.add(1)
        return(y)

routine start() -> Void
    block entry()
        a : S64 = check(1)
        Out.write("{a}\n")
        b : S64 = check(S64.MAX)
        Out.write("not reached {b}\n")
        return()
