# An array literal [a, b, ...] makes an array value where an Items[T, COUNT] goes, a load through a pointer of the array type reads one from
# memory, and a local array slot is filled with a store like every other slot.

import Hosted

routine sum3(a: Items[S64, 3]) -> S64
    slot: &Items[S64, 3] <- a

    first_two: S64 = slot[0] + slot[1]
    s: S64 = first_two + slot[2]
    return s

routine start() -> None
    x: S64 = 7
    a: Items[S64, 3] = [1, 2, x]
    Console.show("{sum3(a)}")

    grid_val: Items[Items[S16, 3], 2] = [[1, 2, 3], [4, 5, 6]]
    grid: &Items[Items[S16, 3], 2] <- grid_val
    row: &Items[S16, 3] <- grid[1]
    Console.show("{row.getitem(2).to[S64]()}")

    # a load through @Items[S64, 3] copies 3 values out of memory
    wide: &Items[S64, 5] <- [10, 20, 30, 40, 50]
    middle: @S64 = wide.to[@[S64]]().to[@S64]().stride(1)
    b: Items[S64, 3] = middle.to[@Items[S64, 3]]().peek()
    Console.show("{sum3(b)}")
    return
