// A 128-bit fetch_add and compare_exchange through cmpxchg16b, carrying across the low 64 bits.

import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        claim wide : @U128 <- uninit
        wide.atomic_store(0xFFFFFFFFFFFFFFFF)
        old : U128               = wide.atomic_fetch_add(1)
        won : Result<U128, U128> = wide.atomic_compare_exchange(0x10000000000000000, 5)
        Out.write("{old} {won} {wide.atomic_load()}\n")
        return()
