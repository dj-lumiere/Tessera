// A 128-bit fetch_add and compare_exchange through cmpxchg16b, carrying across the low 64 bits.

import Standard/Format
import Standard/Os

routine start() -> Void
    claim wide: @U128 <- .hollow()
    wide.poke_atomic(0xFFFFFFFFFFFFFFFF)
    old: U128 = wide.atomic_fetch_add(1)
    won: Result[Unit, U128] = wide.atomic_compare_exchange(expected: 0x10000000000000000, new: 5)
    Out.write("{old} {won} {wide.peek_atomic()}\n")
    return()
