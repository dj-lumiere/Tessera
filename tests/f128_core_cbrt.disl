routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        jump loop(#out, 0, 0)

    block loop(#out: Ptr<FdWriter>, %i: I64, %passed: I64):
        %done: Bool = %i.eq(3319)
        branch %done ? report(#out, %passed) : check(#out, %i, %passed)

    block check(#out: Ptr<FdWriter>, %i: I64, %passed: I64):
        #inputs: Ptr<I128> = CBRT_INPUT.as_ptr()
        #wants:  Ptr<I128> = CBRT_WANT.as_ptr()
        %x:      I128     := #inputs[%i]
        %want:   I128     := #wants[%i]
        %root:   F128      = f128_cm_cbrt(F128.from_bits(%x))
        %got:    I128      = %root.bits
        %ok:     Bool      = %got.eq(%want)
        branch %ok ? loop(#out, %i.add(1), %passed.add(1)) : mismatch(#out, %i, %passed, %x, %got, %want)

    block mismatch(#out: Ptr<FdWriter>, %i: I64, %passed: I64, %x: I128, %got: I128, %want: I128):
        write_str(#out, "cbrt ")
        %x.format_hex(#out)
        write_str(#out, " = ")
        %got.format_hex(#out)
        write_str(#out, " not ")
        %want.format_hex(#out)
        write_line(#out)
        jump loop(#out, %i.add(1), %passed)

    block report(#out: Ptr<FdWriter>, %passed: I64):
        %passed.format(#out)
        write_str(#out, " ok")
        write_line(#out)
        return(0)
