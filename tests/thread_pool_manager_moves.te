# A ThreadPoolManager goes on with a waiting passable fiber on whichever of its threads is free: the passable fiber
# waits for a child on the second thread while a passable fiber that never waits holds its own, so the second thread
# goes on with it once the child is done.

import Standard/Fiber
import Standard/Hosted

### Spins until `release` is 1: work that keeps its thread without waiting.
### :param release: Set to 1 to end it.
routine hold(release: @U32) -> None
    until release.peek_unbroken() != 0
        continue
    return

### Says it started, then spins for 50 ms without waiting.
### :param started: Set to 1 when it starts.
routine child(started: @U32) -> None
    started.poke_unbroken(1)
    deadline: Duration = Clock.monotonic() +^ 50ms
    until Clock.monotonic() >= deadline
        continue
    return

### The manager running the code that calls it: each thread of the pool has its own.
### :returns: The manager, as an address.
routine running_manager() -> Addr
    return current_waiter().manager

### Waits for `child` on the second thread while `hold` keeps this thread, and says whether it went on on another
### thread.
### :param pool: The pool.
### :returns: True when it went on on another thread than the one it waited on.
routine watch(pool: @ThreadPoolManager) -> Bool
    started: &U32 <- 0
    release: &U32 <- 0

    c: PassableFiber[None] <- pool.get_passable_fiber[None]()
    work_c: Work[None] = child.to[Work](started: started)
    c.put_work(work_c)
    # The child runs on the other thread: this one is busy here until this passable fiber waits.
    until started.peek_unbroken() != 0
        continue
    h: PassableFiber[None] <- pool.get_passable_fiber[None]()
    work_h: Work[None] = hold.to[Work](release: release)
    h.put_work(work_h)
    before: Addr = running_manager()
    # The wait frees this thread, which takes `hold`, the only passable fiber left in the queue.
    c.retrieve()
    after: Addr = running_manager()
    release.poke_unbroken(1)
    h.retrieve()
    drop c
    drop h
    return before.notsame(after)

### Runs `watch` on a pool of two threads.
routine start() -> None
    pool: &ThreadPoolManager <- .construct(threads: 2)

    j: PassableFiber[Bool] <- pool.get_passable_fiber[Bool]()
    work_j: Work[Bool] = watch.to[Work](pool: pool)
    j.put_work(work_j)
    Console.show("went on on another thread: {j.retrieve()}")
    drop j
    drop pool
    return
