# A view of memory added to a list, the memory given back, the view read through the list.

import Standard/Collections
import Standard/Os

routine start() -> None
    local m: @Memory[S64] <- [1234567] * 4 from HEAP
    local xs: @List[@[S64]] <- .construct()

    xs.add_last(m.getslice())
    drop m
    v: @[S64] = xs[0]
    Console.show("{v.getitem(0)}")
    drop xs
    return
