// stride moves a @T by whole Ts, where offset counts bytes.
import Standard::Os

routine start() -> Void
    shared buf   : @Array<S32, 4> <- Array<S32, 4> { 10, 20, 30, 40 }
    shared first : @S32           = buf.to<@S32>()
    shared third : @S32           = first.stride(2)
    shared back  : @S32           = third.stride(-1)

    block entry()
        same : Bool = third.ptr_eq(first.offset(8))
        branch same
            ? sum()
            : wrong()

    block sum()
        a : S32 = third.load()
        b : S32 = back.load()
        r : S32 = a.add(b)
        set_exit_code(r)
        return()

    block wrong()
        set_exit_code(1)
        return()
