// stride moves a Ptr<T> by whole Ts, where offset counts bytes.
routine main() -> S32
    block entry():
        %values : Array<S32, 4> = Array<S32, 4> { 10, 20, 30, 40 }
        claim %buf : Ptr<Array<S32, 4>>
        %buf.store(%values)
        %first : Ptr<S32> = %buf.cast<S32>()
        %third : Ptr<S32> = %first.stride(2)
        %back  : Ptr<S32> = %third.stride(-1)
        %same  : Bool     = %third.ptr_eq(%first.offset(8))
        branch %same ? sum(%third, %back) : wrong()

    block sum(%third: Ptr<S32>, %back: Ptr<S32>):
        %a : S32 = %third.load()
        %b : S32 = %back.load()
        %r : S32 = %a.add(%b)
        return(%r)

    block wrong():
        return(1)
