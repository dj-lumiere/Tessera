# stride moves a @T by whole Ts, where offset counts bytes.
import Standard/Os

routine start() -> None
    local buf: @Array[S32, 4] <- [10, 20, 30, 40]
    local first: @S32 = buf.to[@S32]()
    local third: @S32 = first.stride(2)
    local back: @S32 = third.stride(-1)

    if third.ptr_eq(first.offset(8))
        a: S32 = third.peek()
        b: S32 = back.peek()
        r: S32 = a + b
        set_exit_code(r)
        return
    else
        set_exit_code(1)
        return
