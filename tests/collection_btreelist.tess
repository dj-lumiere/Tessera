; BTreeList<I64> against a model. An LCG drives random push / insert / remove / set / get at random indices in three
; phases (small, growing to thousands of elements, then shrinking to empty so borrows and merges run). Every 500
; operations a checkpoint prints the length, a running checksum of every result, and a hash of the iteration
; sequence. Then eq.
; The expected output is generated by scripts/gen_collection_btree.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every element in iteration order.
routine iteration_hash(#list: Ptr<BTreeList<I64>>) -> I64
    block entry():
        %iter_val: BTreeListIter<I64> = BTreeListIter<I64>.new(#list)
        #iter: Ptr<BTreeListIter<I64>> = alloca<BTreeListIter<I64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<BTreeListIter<I64>>, %hash: I64):
        %item:  Option<I64> = #iter.next()
        %more:  Bool = %item.tag
        %value: I64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<BTreeList<I64>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #list.length())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#list))
        write_line(#out)
        return()

; Runs %ops random operations. An operation kind is drawn below 10: below %pushes it's a push, below %inserts an
; insert at a random index (the end included), below %removes a remove, below %sets a set, otherwise a get. Remove,
; set, and get on an empty list record -1. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<BTreeList<I64>>, #rng: Ptr<Rng>,
        %phase: I64, %ops: I64, %pushes: I64, %inserts: I64, %removes: I64, %sets: I64, %results: I64) -> I64
    block entry():
        jump next(0, %results)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %kind:      I64  = #rng.below(10)
        %is_push:   Bool = %kind.slt(%pushes)
        %is_insert: Bool = %kind.slt(%inserts)
        %empty:     Bool = #list.is_empty()
        select:
            %is_push -> push(%op, %results)
            %is_insert -> insert(%op, %results)
            %empty -> record(%op, %results, -1)
            _ -> pick_indexed(%op, %results, %kind)

    block pick_indexed(%op: I64, %results: I64, %kind: I64):
        %index:     I64  = #rng.below(#list.length())
        %is_remove: Bool = %kind.slt(%removes)
        %is_set:    Bool = %kind.slt(%sets)
        select:
            %is_remove -> remove(%op, %results, %index)
            %is_set -> set(%op, %results, %index)
            _ -> get(%op, %results, %index)

    block push(%op: I64, %results: I64):
        %value: I64 = #rng.below(1000000)
        #list.push(%value)
        jump record(%op, %results, %value)

    block insert(%op: I64, %results: I64):
        %index: I64 = #rng.below(#list.length().add(1))
        %value: I64 = #rng.below(1000000)
        #list.insert(%index, %value)
        jump record(%op, %results, mix(%index, %value))

    block remove(%op: I64, %results: I64, %index: I64):
        %value: I64 = #list.remove(%index)
        jump record(%op, %results, %value)

    block set(%op: I64, %results: I64, %index: I64):
        %value: I64 = #rng.below(1000000)
        #list.set(%index, %value)
        jump record(%op, %results, mix(%index, %value))

    block get(%op: I64, %results: I64, %index: I64):
        %value: I64 = #list.get(%index)
        jump record(%op, %results, %value)

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #list, %phase, %op, %results)
        jump next(%op, %results)

; Pushes every element of #from onto #to, in iteration order.
routine copy_all(#from: Ptr<BTreeList<I64>>, #to: Ptr<BTreeList<I64>>) -> Void
    block entry():
        %iter_val: BTreeListIter<I64> = BTreeListIter<I64>.new(#from)
        #iter: Ptr<BTreeListIter<I64>> = alloca<BTreeListIter<I64>>([%iter_val])
        jump next(#iter)

    block next(#iter: Ptr<BTreeListIter<I64>>):
        %item:  Option<I64> = #iter.next()
        %more:  Bool = %item.tag
        %value: I64 = %item.value
        branch %more ? copy(#iter, %value) : return()

    block copy(#iter: Ptr<BTreeListIter<I64>>, %value: I64):
        #to.push(%value)
        jump next(#iter)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 1 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %list_val: BTreeList<I64> = BTreeList<I64>.new(#alloc)
        #list: Ptr<BTreeList<I64>> = alloca<BTreeList<I64>>([%list_val])

        %r1: I64 = run_phase(#out, #list, #rng, 1, 3000, 3, 5, 7, 8, 0)
        %r2: I64 = run_phase(#out, #list, #rng, 2, 10000, 3, 7, 8, 9, %r1)

        %copy_val: BTreeList<I64> = BTreeList<I64>.new(#alloc)
        #copy: Ptr<BTreeList<I64>> = alloca<BTreeList<I64>>([%copy_val])
        report_eq(#out, "empty copy equal", #list.eq(#copy))
        copy_all(#list, #copy)
        report_eq(#out, "copy equal", #list.eq(#copy))
        %middle: I64 = #list.length().sdiv(2)
        %old:    I64 = #copy.get(%middle)
        #copy.set(%middle, %old.add(1))
        report_eq(#out, "changed element equal", #list.eq(#copy))
        #copy.set(%middle, %old)
        report_eq(#out, "restored element equal", #list.eq(#copy))
        #copy.push(0)
        report_eq(#out, "extra element equal", #list.eq(#copy))
        #copy.free()

        %r3: I64 = run_phase(#out, #list, #rng, 3, 19000, 1, 2, 8, 9, %r2)
        #list.free()
        report_eq(#out, "freed is empty", #list.is_empty())
        #out.flush()
        return(0)
