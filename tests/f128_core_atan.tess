        wrong2_1 : U64 = check_atan2(out, "atan2 accurate", ATAN2_Y.to<@U128>(),
            ATAN2_X.to<@U128>(), ATAN2_W.to<@U128>(), 2505, 1)
        report(out, "atan2 accurate", 2505, wrong2_1)
        wrong2_2 : U64 = check_atan2(out, "atan2 hard", ATAN2_HARD_Y.to<@U128>(),
            ATAN2_HARD_X.to<@U128>(), ATAN2_HARD_W.to<@U128>(), 100, 0)
        report(out, "atan2 hard", 100, wrong2_2)
        wrong2_3 : U64 = check_atan2(out, "atan2 hard accurate", ATAN2_HARD_Y.to<@U128>(),
