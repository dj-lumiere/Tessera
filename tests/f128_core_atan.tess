routine report(out: @Out, name: Bytes, count: USize, wrong: U64) -> Void
    block entry()
        out.write("{name}: {count} cases, {wrong} wrong\n")
        return()

routine mismatch(out: @Out, name: Bytes, y: U128, x: U128, got: U128, want: U128) -> Void
    block entry()
        out.write("{name} ")
        y.represent_hex_into(out)
        out.write(" ")
        x.represent_hex_into(out)
        out.write(" got ")
        got.represent_hex_into(out)
        out.write(" want ")
        want.represent_hex_into(out)
        out.write("\n")
        return()

// mode 0: F128.atan, 1: the accurate path alone, for the inputs that reach the reduction
routine atan_of(x: U128, mode: U64) -> U128
    block entry()
        exponent_field : U128 = x.shr(112).bitand(0x7FFF)
        xn             : U64  = exponent_field.to<U64>()
        reduced        : Bool = xn.between(0x3FC6, 0x4071)
        accurate       : Bool = mode.eq(1).bitand(reduced)
        branch accurate
            ? accurate()
            : full()

    block full()
        r    : F128 = f128_of(x).atan()
        bits : U128 = r.bits()
        return(bits)

    block accurate()
        sign           : U128            = x.bitand(F128_SIGN)
        high_magnitude : U128            = x.shr(64).bitand(0x7FFFFFFFFFFFFFFF)
        hi             : U64             = high_magnitude.to<U64>()
        mant           : U64             = hi.bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        red            : CmAtanReduction = cm_atan_reduce(mant, x.to_wrap<U64>(), hi.shr(48))
        r              : F128            = cm_atan_accurate(red, sign)
        bits           : U128            = r.bits()
        return(bits)

// mode 0: F128.atan2, 1: the accurate path alone, for finite nonzero coordinates
routine atan2_of(y: U128, x: U128, mode: U64) -> U128
    block entry()
        magnitude      : U128 = F128_SIGN.bitnot()
        xa             : U128 = x.bitand(magnitude)
        ya             : U128 = y.bitand(magnitude)
        finite         : Bool = xa.lt(F128_INF).bitand(ya.lt(F128_INF))
        nonzero        : Bool = xa.ne(0).bitand(ya.ne(0))
        wants_accurate : Bool = mode.eq(1).bitand(finite)
        accurate       : Bool = wants_accurate.bitand(nonzero)
        branch accurate
            ? accurate()
            : full()

    block full()
        r    : F128 = f128_of(y).atan2(f128_of(x))
        bits : U128 = r.bits()
        return(bits)

    block accurate()
        magnitude : U128            = F128_SIGN.bitnot()
        red       : CmAtanReduction = cm_atan2_reduce(x.bitand(magnitude), y.bitand(magnitude))
        r         : F128            = cm_atan2_accurate(red, f128_is_negative_bits(x),
            y.bitand(F128_SIGN))
        bits      : U128            = r.bits()
        return(bits)

// checks cases [0, count) of one atan group and returns the number wrong
routine check_atan(out: @Out, name: Bytes, xs: @U128, want: @U128, count: USize, mode: U64) -> U64
    block entry()
        jump case(0, 0)

    block case(i: USize, wrong: U64)
        done : Bool = i.ge(count)
        branch done
            ? return(wrong)
            : run(i, wrong)

    block run(i: USize, wrong: U64)
        x    : U128 = xs.stride(i).load()
        w    : U128 = want.stride(i).load()
        got  : U128 = atan_of(x, mode)
        good : Bool = got.eq(w)
        branch good
            ? case(i.add(1), wrong)
            : bad(i, wrong, x, got, w)

    block bad(i: USize, wrong: U64, x: U128, got: U128, w: U128)
        mismatch(out, name, 0, x, got, w)
        jump case(i.add(1), wrong.add(1))

routine check_atan2(out: @Out, name: Bytes, ys: @U128, xs: @U128, want: @U128, count: USize,
    mode: U64) -> U64
    block entry()
        jump case(0, 0)

    block case(i: USize, wrong: U64)
        done : Bool = i.ge(count)
        branch done
            ? return(wrong)
            : run(i, wrong)

    block run(i: USize, wrong: U64)
        y    : U128 = ys.stride(i).load()
        x    : U128 = xs.stride(i).load()
        w    : U128 = want.stride(i).load()
        got  : U128 = atan2_of(y, x, mode)
        good : Bool = got.eq(w)
        branch good
            ? case(i.add(1), wrong)
            : bad(i, wrong, y, x, got, w)

    block bad(i: USize, wrong: U64, y: U128, x: U128, got: U128, w: U128)
        mismatch(out, name, y, x, got, w)
        jump case(i.add(1), wrong.add(1))

routine main() -> S32
    block entry()
        out    : @Out = Out.writer()
        wrong0 : U64  = check_atan(out, "atan", ATAN_X.to<@U128>(), ATAN_W.to<@U128>(), 2756, 0)
        report(out, "atan", 2756, wrong0)
        wrong1 : U64 = check_atan(out, "atan accurate", ATAN_X.to<@U128>(), ATAN_W.to<@U128>(),
            2756, 1)
        report(out, "atan accurate", 2756, wrong1)
        wrong2 : U64 = check_atan(out, "atan hard", ATAN_HARD_X.to<@U128>(),
            ATAN_HARD_W.to<@U128>(), 100, 0)
