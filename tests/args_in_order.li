# Arguments without a label fill the parameters in order from the first, however many there are.

import Hosted

routine volume(width: S32, height: S32, depth: S32) -> S32
    return width * height * depth

routine move(count: S32, from: Char, tmp: Char, to: Char) -> None
    Console.show("{count}: {from} {tmp} {to}")
    return

routine start() -> None
    width: S32 = 2
    height: S32 = 3
    Console.show("{volume(width, height, 4)}")
    Console.show("{volume(2, 3, 4)}")
    from: Char = 'a'
    tmp: Char = 'b'
    to: Char = 'c'
    move(1, from, tmp, to)
    move(2, from, tmp: to, to: tmp)
    return
