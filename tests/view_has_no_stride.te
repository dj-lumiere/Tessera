# A view (`@[T]`) has no `stride`: the error says it is read with `elems[i]`, and that `to[@T]()` gives the pointer
# that `stride` steps.

import Hosted

routine start() -> None
    arr: &Items[S32, 3] <- [1, 2, 3]

    elems: @[S32] = arr.getview()
    Console.show("{elems.stride(1).peek()}")
    return
