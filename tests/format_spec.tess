; FormatSpec padding (width, fill, alignment, zeros after the sign), the Hex / Unsigned / Fixed views,
; and BufWriter: output only appears at flush, and a write of 4 KiB or more goes straight through.

routine row<T>(#out: Ptr<BufWriter<FdWriter>>, %value: T, %spec: FormatSpec) -> Void
require T: typename, Format<T>
    block entry():
        write_str(#out, "[")
        format_with(#out, %value, %spec)
        write_str(#out, "]")
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %pi: F64 = 3.14159
        %pi.format_fixed(#out, 2)
        write_line(#out)
        %tie: F64 = 0.125
        %tie.format_fixed(#out, 2)
        write_line(#out)
        %big: F64 = 1e20
        %big.format_fixed(#out, 0)
        write_line(#out)
        %neg: F64 = -0.001
        %neg.format_fixed(#out, 2)
        write_line(#out)
        %tiny: F64 = 5e-324
        %tiny.format_fixed(#out, 330)
        write_line(#out)
        %n: I64 = -42
        %s: String = "hé"
        row(#out, %n, FormatSpec.new(6))
        row(#out, %n, FormatSpec.zero_padded(6))
        row(#out, %n, FormatSpec.new(6).with_align(Align.Left))
        row(#out, %s, FormatSpec.new(6).with_align(Align.Center).with_fill("*"))
        %h: Hex<I32> = Hex<I32> { value: 48879 }
        row(#out, %h, FormatSpec.zero_padded(8))
        %fx: Fixed<F64> = Fixed<F64> { value: %pi, digits: 3 }
        row(#out, %fx, FormatSpec.new(10))
        %m1: I32 = -1
        %u: Unsigned<I32> = Unsigned<I32> { value: %m1 }
        row(#out, %u, FormatSpec.new(12))
        %e: String = ""
        row(#out, %e, FormatSpec.new(3).with_fill("─"))
        %wide: I64 = 1234567
        row(#out, %wide, FormatSpec.new(3))
        write_str(#fd, "before flush")
        write_line(#fd)
        #out.flush()
        #big:  Ptr<Array<I8, 5000>> = alloca<Array<I8, 5000>>
        #data: Ptr<I8> = #big.cast<I8>()
        fill_bytes(#data, 5000)
        write_str(#out, "x")
        #out.write_bytes(#data, 5000)
        write_line(#out)
        #out.flush()
        return(0)

routine fill_bytes(#data: Ptr<I8>, %count: I64) -> Void
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %done: Bool = %i.sge(%count)
        branch %done ? return() : one(%i)

    block one(%i: I64):
        #data[%i] = 121
        jump loop(%i.add(1))
