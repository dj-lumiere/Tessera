// FormatSpec padding (width, fill, alignment, zeros after the sign), the Hex / Fixed views,
// and BufWriter: output only appears at flush, and a write of 4 KiB or more goes straight through.

import Standard::Format
import Standard::Os

routine row<T>(%out: @BufWriter<FdWriter>, %value: T, %spec: FormatSpec) -> Void
require T: typename, Represent<T>
    block entry():
        write(%out, "[")
        represent_with(%out, %value, %spec)
        write(%out, "]\n")
        return()

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim %fd : @FdWriter
        %fd.store(%fd_val)
        claim %out : @BufWriter<FdWriter>
        %out.construct(%fd)
        %pi : F64 = 3.14159
        %pi.represent_fixed(%out, 2)
        write(%out, "\n")
        %tie : F64 = 0.125
        %tie.represent_fixed(%out, 2)
        write(%out, "\n")
        %big_val : F64 = 1e20
        %big_val.represent_fixed(%out, 0)
        write(%out, "\n")
        %neg : F64 = -0.001
        %neg.represent_fixed(%out, 2)
        write(%out, "\n")
        %tiny : F64 = 5e-324
        %tiny.represent_fixed(%out, 330)
        write(%out, "\n")
        %n : S64   = -42
        %s : Bytes = "hé"
        row(%out, %n, FormatSpec.construct(6))
        row(%out, %n, FormatSpec.zero_padded(6))
        row(%out, %n, FormatSpec.construct(6).with_align(Align.Left))
        row(%out, %s, FormatSpec.construct(6).with_align(Align.Center).with_fill("*"))
        %h : Hex<U32> = Hex<U32> { value: 48879 }
        row(%out, %h, FormatSpec.zero_padded(8))
        %fx : Fixed<F64> = Fixed<F64> { value: %pi, digits: 3 }
        row(%out, %fx, FormatSpec.construct(10))
        %u : U32 = U32.MAX
        row(%out, %u, FormatSpec.construct(12))
        %e : Bytes = ""
        row(%out, %e, FormatSpec.construct(3).with_fill("─"))
        %wide : S64 = 1234567
        row(%out, %wide, FormatSpec.construct(3))
        write(%fd, "before flush\n")
        %out.flush()
        claim %big : @Array<Byte, 5000>
        %data : @Byte = %big.cast<Byte>()
        fill_bytes(%data, 5000)
        write(%out, "x")
        %out.write_bytes(%data, 5000)
        write(%out, "\n")
        %out.flush()
        return(0)

routine fill_bytes(%data: @Byte, %count: USize) -> Void
    block entry():
        jump loop(0)

    block loop(%i: USize):
        %done : Bool = %i.ge(%count)
        branch %done ? return() : one(%i)

    block one(%i: USize):
        %data.stride(%i).store(b'y')
        jump loop(%i.add(1))
