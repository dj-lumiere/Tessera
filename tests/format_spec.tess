// FormatSpec padding (width, fill, alignment, zeros after the sign), the Hex / Fixed views,
// and BufWriter: output only appears at flush, and a write of 4 KiB or more goes straight through.

import Standard::Format
import Standard::Os

routine row<T>(out: @BufWriter<Out>, value: T, spec: FormatSpec) -> Void
require T: typename, Representable<T>
    block entry()
        out.write("[")
        represent_with_into(out, value, spec)
        out.write("]\n")
        return()

routine fill_bytes(data: @Byte, count: USize) -> Void
    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? return()
            : one(i)

    block one(i: USize)
        data.stride(i).store(b'y')
        jump loop(i.add(1))

routine main() -> S32
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        pi : F64 = 3.14159
        pi.represent_fixed_into(out, 2)
        out.write("\n")
        tie : F64 = 0.125
        tie.represent_fixed_into(out, 2)
        out.write("\n")
        big_val : F64 = 1e20
        big_val.represent_fixed_into(out, 0)
        out.write("\n")
        neg : F64 = -0.001
        neg.represent_fixed_into(out, 2)
        out.write("\n")
        tiny : F64 = 5e-324
        tiny.represent_fixed_into(out, 330)
        out.write("\n")
        n : S64   = -42
        s : Bytes = "hé"
        row(out, n, FormatSpec.construct(6))
        row(out, n, FormatSpec.zero_padded(6))
        row(out, n, FormatSpec.construct(6).with_align(Align.Left))
        centered : FormatSpec = FormatSpec.construct(6).with_align(Align.Center)
        row(out, s, centered.with_fill("*"))
        h : Hex<U32> = Hex<U32> { value: 48879 }
        row(out, h, FormatSpec.zero_padded(8))
        fx : Fixed<F64> = Fixed<F64> { value: pi, digits: 3 }
        row(out, fx, FormatSpec.construct(10))
        u : U32 = U32.MAX
        row(out, u, FormatSpec.construct(12))
        e : Bytes = ""
        row(out, e, FormatSpec.construct(3).with_fill("─"))
        wide : S64 = 1234567
        row(out, wide, FormatSpec.construct(3))
        fd.write("before flush\n")
        out.flush()
        claim big : @Array<Byte, 5000> <- uninit
        data : @Byte = big.to<@Byte>()
        fill_bytes(data, 5000)
        out.write("x")
        out.write_bytes(data, 5000)
        out.write("\n")
        out.flush()
        return(0)
