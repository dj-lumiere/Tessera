// FormatSpec padding (width, fill, alignment, zeros after the sign), the Hex / Fixed views,
// and BufWriter: output only appears at flush, and a write of 4 KiB or more goes straight through.

routine row<T>(#out: Ptr<BufWriter<FdWriter>>, %value: T, %spec: FormatSpec) -> Void
require T: typename, Format<T>
    block entry():
        write(#out, "[")
        format_with(#out, %value, %spec)
        write(#out, "]\n")
        return()

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim #fd : Ptr<FdWriter>
        #fd.store(%fd_val)
        claim #out : Ptr<BufWriter<FdWriter>>
        #out.construct(#fd)
        %pi : F64 = 3.14159
        %pi.format_fixed(#out, 2)
        write(#out, "\n")
        %tie : F64 = 0.125
        %tie.format_fixed(#out, 2)
        write(#out, "\n")
        %big : F64 = 1e20
        %big.format_fixed(#out, 0)
        write(#out, "\n")
        %neg : F64 = -0.001
        %neg.format_fixed(#out, 2)
        write(#out, "\n")
        %tiny : F64 = 5e-324
        %tiny.format_fixed(#out, 330)
        write(#out, "\n")
        %n : S64    = -42
        %s : String = "hé"
        row(#out, %n, FormatSpec.construct(6))
        row(#out, %n, FormatSpec.zero_padded(6))
        row(#out, %n, FormatSpec.construct(6).with_align(Align.Left))
        row(#out, %s, FormatSpec.construct(6).with_align(Align.Center).with_fill("*"))
        %h : Hex<U32> = Hex<U32> { value: 48879 }
        row(#out, %h, FormatSpec.zero_padded(8))
        %fx : Fixed<F64> = Fixed<F64> { value: %pi, digits: 3 }
        row(#out, %fx, FormatSpec.construct(10))
        %u : U32 = U32.MAX
        row(#out, %u, FormatSpec.construct(12))
        %e : String = ""
        row(#out, %e, FormatSpec.construct(3).with_fill("─"))
        %wide : S64 = 1234567
        row(#out, %wide, FormatSpec.construct(3))
        write(#fd, "before flush\n")
        #out.flush()
        claim #big : Ptr<Array<Byte, 5000>>
        #data : Ptr<Byte> = #big.cast<Byte>()
        fill_bytes(#data, 5000)
        write(#out, "x")
        #out.write_bytes(#data, 5000)
        write(#out, "\n")
        #out.flush()
        return(0)

routine fill_bytes(#data: Ptr<Byte>, %count: U64) -> Void
    block entry():
        jump loop(0)

    block loop(%i: U64):
        %done : Bool = %i.ge(%count)
        branch %done ? return() : one(%i)

    block one(%i: U64):
        #data[%i].store(b'y')
        jump loop(%i.add(1))
