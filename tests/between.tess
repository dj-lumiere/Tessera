// between is the closed interval [lo, hi]; in_range is the half-open [lo, end). Both are false for an empty or
// reversed interval, and for a NaN.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        five   : S64  = 5
        digit  : Byte = b'7'
        letter : Char = 'q'
        nan    : F64  = F64.NAN
        half   : F64  = 0.5
        Out.write("{five.between(1, 5)} {five.between(6, 9)} {five.between(5, 1)}\n")
        Out.write("{five.in_range(0, 5)} {five.in_range(5, 6)} {five.in_range(5, 5)}\n")
        Out.write("{digit.between(b'0', b'9')} {letter.in_range('a', 'z')}\n")
        Out.write("{half.between(0.0, 1.0)} {nan.between(0.0, 1.0)}\n")
        return(0)
