// between is the closed interval [lo, hi], in_range the half-open [lo, end). Both are false for an empty or
// reversed interval, and for a NaN.

import Standard/Format
import Standard/Os

routine start() -> Void
    block entry()
        five: S64 = 5
        digit: Byte = b'7'
        letter: Char = 'q'
        nan: B64 = B64.NAN
        half: B64 = 0.5
        Out.write("{five.between(lo: 1, hi: 5)} {five.between(lo: 6, hi: 9)} {five.between(lo: 5, hi: 1)}\n")
        Out.write("{five.in_range(lo: 0, end: 5)} {five.in_range(lo: 5, end: 6)} {five.in_range(lo: 5, end: 5)}\n")
        Out.write("{digit.between(lo: b'0', hi: b'9')} {letter.in_range(lo: 'a', end: 'z')}\n")
        Out.write("{half.between(lo: 0.0, hi: 1.0)} {nan.between(lo: 0.0, hi: 1.0)}\n")
        return()
