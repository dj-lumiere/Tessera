# A pointer isn't Representable: its address is written through to[Addr](), and its target through load().
# Addresses vary from run to run, so only the shape and null are checked here.

import Hosted

routine start() -> None
    out: @ConsoleOutput = Console.output()

    lateinit none: @S64
    out.write("{none.to[Addr]()}\n")
    raw: Addr
    out.write("{raw}\n")

    # a real address: at least one digit after 0x, and it's what the slot's address is
    slot: &S64 <- 42
    seen: U64 = ptrtoint[@S64, U64](slot)
    nonzero: Bool = seen != 0
    out.write("{nonzero} {slot.load()}\n")
    return
