# add_last, called bare, stops the program when the memory manager fails: stdout keeps what came before, and the
# exit status is 101.

import Collections
import Hosted

# A memory manager that never has memory to give.
record Refusing
    nothing

obeys MemoryManageable[Refusing]

routine @Refusing.borrow(size: U64, align: U64) -> Addr
    return Addr.zero()

routine @Refusing.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return Addr.zero()

routine @Refusing.give_back(at: Addr) -> None
    return

routine start() -> None
    refusing: &Refusing
    manager: &MemoryManager <- refusing.to[MemoryManager]()
    list: &List[S64] <- .construct(manager)

    pushed: Bool = try list.add_last(1)
    Console.show("push_result: {pushed}")
    list.add_last(1)
    Console.show("not reached")
    drop list
    drop manager
    return
