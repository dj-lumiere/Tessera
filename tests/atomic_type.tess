// Atomic[T]: fields of a shared record that three threads add to, a compare_exchange that writes once and then finds
// the new value, a swap, and the alignment of an Atomic[U64], 8 on every target.

import Standard/Format
import Standard/Os

record Counters
    hits: Atomic[U64]
    flag: Atomic[U32]
    total: Atomic[B64]

routine Counters.construct(hits: Atomic[U64], flag: Atomic[U32], total: Atomic[B64]) -> Me
    return(Me(hits, flag, total))

routine Counters.destruct(me: @Me) -> Void
    return()

routine bump(c: @Counters) -> Void
    jump step(0)

    block step(i: U64)
        branch i.eq(10000)
            ? return()
            : continue
        c.hits.fetch_add_relaxed(1)
        c.total.fetch_fadd(0.5)
        jump step(i.add(1))

routine start() -> Void
    out: @Out = Out.writer()
    claim c: @Counters <- Counters(hits: Atomic[U64](value: 0), flag: Atomic[U32](value: 0),
        total: Atomic[B64](value: 0.0))
    t1: Thread[Void] = get_thread[Void]()
    t1.put_work(entry: bump.to[Callable](), args: c)
    t2: Thread[Void] = get_thread[Void]()
    t2.put_work(entry: bump.to[Callable](), args: c)
    bump(c)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    swapped: Bool = c.flag.compare_exchange(expected: 0, new: 1).is_success()
    again: Bool = c.flag.compare_exchange(expected: 0, new: 2).is_success()
    old: U32 = c.flag.swap(7)
    out.write("{c.hits.peek()} {c.total.peek()} {swapped} {again} {old} {c.flag.peek_acquire()} {alignof[Atomic[U64]]()}\n")
    return()
