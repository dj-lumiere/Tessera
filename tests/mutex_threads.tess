// Four threads add to one counter under a ExclusiveLock, so no increment is lost: the ExclusiveLock is atomics plus wait_on /
// wake_one, the same on every operating system.

import Standard/Alloc
import Standard/Format
import Standard/Os

record Shared
    lock: ExclusiveLock
    count: U64

/// Makes a `Shared` from its fields.
/// :param lock: Its `lock`.
/// :param count: Its `count`.
/// :returns: The new value.
routine Shared.construct(lock: ExclusiveLock, count: U64) -> Me
    return(Me(lock, count))

/// Releases nothing: a `Shared` holds no memory of its own.
routine Shared.destruct(me: @Me) -> Void
    return()

routine add_many(state: @Shared) -> Void
    jump step(0)

    block step(i: U64)
        done: Bool = i.eq(100000)
        branch done
            ? return()
            : add(i)

    block add(i: U64)
        state.lock.lock()
        next_count: U64 = state.count.peek().add(1)
        next_count.poke_into(state.count)
        state.lock.unlock()
        jump step(i.add(1))

routine start() -> Void
    claim state: @Shared <- Shared(lock: .construct(), count: 0)
    t1: Thread = Thread.spawn(entry: add_many.to[Callable](), arg: state)
    t2: Thread = Thread.spawn(entry: add_many.to[Callable](), arg: state)
    t3: Thread = Thread.spawn(entry: add_many.to[Callable](), arg: state)
    t4: Thread = Thread.spawn(entry: add_many.to[Callable](), arg: state)
    t1.join()
    t2.join()
    t3.join()
    t4.join()
    Out.write("{state.count.peek()}\n")
    Out.write("cpus: {cpu_count().gt(0)}\n")
    first: Bool = state.lock.try_lock()
    second: Bool = state.lock.try_lock()
    state.lock.unlock()
    Out.write("try_lock: {first} then {second}\n")
    return()
