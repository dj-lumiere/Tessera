// Four threads add to one counter under a Mutex, so no increment is lost: the Mutex is atomics plus wait_on /
// wake_one, the same on every operating system.

import Standard::Alloc
import Standard::Format
import Standard::Os

record Shared
    lock  : Mutex
    count : U64

routine add_many(raw: Addr) -> Void
    shared state : @Shared = raw.to<@Shared>()

    block entry()
        jump step(0)

    block step(i: U64)
        done : Bool = i.eq(100000)
        branch done
            ? return()
            : add(i)

    block add(i: U64)
        state.lock.lock()
        next_count : U64 = state.count.load().add(1)
        next_count.store_into(state.count)
        state.lock.unlock()
        jump step(i.add(1))

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        claim state : @Shared    <- Shared { lock: .construct(), count: 0 }
        t1 : Thread = Thread.spawn(add_many.to<Callable>(), state, alloc)
        t2 : Thread = Thread.spawn(add_many.to<Callable>(), state, alloc)
        t3 : Thread = Thread.spawn(add_many.to<Callable>(), state, alloc)
        t4 : Thread = Thread.spawn(add_many.to<Callable>(), state, alloc)
        t1.join()
        t2.join()
        t3.join()
        t4.join()
        Out.write("{state.count.load()}\n")
        Out.write("cpus: {cpu_count().gt(0)}\n")
        first  : Bool = state.lock.try_lock()
        second : Bool = state.lock.try_lock()
        state.lock.unlock()
        Out.write("try_lock: {first} then {second}\n")
        return(0)
