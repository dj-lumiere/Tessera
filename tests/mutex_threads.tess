// Four threads add to one counter under a Mutex, so no increment is lost: the Mutex is atomics plus wait_on /
// wake_one, the same on every operating system.

import Standard::Alloc
import Standard::Format
import Standard::Os

record Shared
    lock  : Mutex
    count : U64

routine add_many(%raw: Addr) -> Void
    block entry():
        %shared : @Shared = %raw.to<@Shared>()
        jump step(%shared, 0)

    block step(%shared: @Shared, %i: U64):
        %done : Bool = %i.eq(100000)
        branch %done
            ? return()
            : add(%shared, %i)

    block add(%shared: @Shared, %i: U64):
        %shared.lock.lock()
        %shared.count.load().add(1).store_into(%shared.count)
        %shared.lock.unlock()
        jump step(%shared, %i.add(1))

routine main() -> S32
    block entry():
        claim %alloc  : @Allocator <- make_heap_allocator()
        claim %shared : @Shared    <- Shared { lock: .construct(), count: 0 }
        %t1 : Thread = Thread.spawn(add_many, %shared, %alloc)
        %t2 : Thread = Thread.spawn(add_many, %shared, %alloc)
        %t3 : Thread = Thread.spawn(add_many, %shared, %alloc)
        %t4 : Thread = Thread.spawn(add_many, %shared, %alloc)
        %t1.join()
        %t2.join()
        %t3.join()
        %t4.join()
        print("{%shared.count.load()}\n")
        print("cpus: {cpu_count().gt(0)}\n")
        %first  : Bool = %shared.lock.try_lock()
        %second : Bool = %shared.lock.try_lock()
        %shared.lock.unlock()
        print("try_lock: {%first} then {%second}\n")
        return(0)
