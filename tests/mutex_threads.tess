# Four threads add to one counter under a ExclusiveLock, so no increment is lost: the ExclusiveLock is atomics plus wait_on /
# wake_one, the same on every operating system.

import Standard/Alloc
import Standard/Format
import Standard/Os

record Shared
    lock: ExclusiveLock
    count: U64

routine add_many(state: @Shared) -> None
    while i != 100000 with i: U64 = 0
        state.lock.lock()
        next_count: U64 = state.count.peek() + 1
        next_count.poke_into(state.count)
        state.lock.unlock()
        continue with i: i + 1
    then
        return

routine start() -> None
    local state: @Shared <- Shared(lock: .construct(), count: 0)

    t1: Thread[None] = get_thread[None]()
    t1.put_work(entry: add_many.to[Callable](), args: state)
    t2: Thread[None] = get_thread[None]()
    t2.put_work(entry: add_many.to[Callable](), args: state)
    t3: Thread[None] = get_thread[None]()
    t3.put_work(entry: add_many.to[Callable](), args: state)
    t4: Thread[None] = get_thread[None]()
    t4.put_work(entry: add_many.to[Callable](), args: state)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    t3.wait_finished()
    t3.give_back()
    t4.wait_finished()
    t4.give_back()
    Out.write("{state.count.peek()}\n")
    Out.write("cpus: {cpu_count().gt(0)}\n")
    first: Bool = state.lock.try_lock()
    second: Bool = state.lock.try_lock()
    state.lock.unlock()
    Out.write("try_lock: {first} then {second}\n")
    return
