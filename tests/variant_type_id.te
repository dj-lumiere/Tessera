# A variant's tag is its branch type's ID, the same number in every variant that has the type: a Maybe[S64] and an
# S64 | Bool holding an S64 have equal tags, and an all-zero (hollow) variant holds no branch, so a when
# on it crashes instead of taking an arm.

import Standard/Os

define Number = S64 | Bool

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash on stdout and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("crashed: {name}: {message.text()}")
    exit(3)

routine start() -> None
    local maybe: @Maybe[S64] <- 7
    local result: @Number <- 9
    local hollow: @Maybe[S64] <- .hollow()

    Crash.report_with(on_crash.to[Callable]())
    a: U64 = maybe.to[@U64]().peek()
    b: U64 = result.to[@U64]().peek()
    Console.show("same tag {a.eq(b)}, nonzero {a.ne(0)}")
    value: Maybe[S64] = hollow.peek()
    when value
        is S64 as n => return
        is None => return
