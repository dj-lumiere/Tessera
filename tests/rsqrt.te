### One step of the checksum.
### :param acc: The checksum so far.
### :param value: The next word.
### :returns: The new checksum.
routine mix(acc: U64, value: U64) -> U64
    return (acc *% 0x100000001B3) ^ value

### The checksum of B16 1 / sqrt over every bit pattern.
### :returns: The checksum.
routine sum_b16() -> U64
    loop with u: U64 = 0, acc: U64 = 0xCBF29CE484222325
        if u == 0x10000
            return acc
        r: B16 = B16.from_bits(u.to_wrap[U16]()).rsqrt_unchecked()
        nan_bits: U16 = 0x7FFF
        bits: U16 = when
            r.is_nan() => nan_bits
            else => r.bits()
        continue with u: u + 1, acc: mix(acc, value: bits.to[U64]())

### The checksum of BF16 1 / sqrt over every bit pattern.
### :returns: The checksum.
routine sum_bf16() -> U64
    loop with u: U64 = 0, acc: U64 = 0xCBF29CE484222325
        if u == 0x10000
            return acc
        r: BF16 = BF16.from_bits(u.to_wrap[U16]()).rsqrt_unchecked()
        nan_bits: U16 = 0x7FFF
        bits: U16 = when
            r.is_nan() => nan_bits
            else => r.bits()
        continue with u: u + 1, acc: mix(acc, value: bits.to[U64]())

### The checksum of B32 1 / sqrt of one bit pattern, folded into acc.
### :param acc: The checksum so far.
### :param u: The bit pattern.
### :returns: The new checksum.
routine mix_b32(acc: U64, u: U32) -> U64
    r: B32 = B32.from_bits(u).rsqrt_unchecked()
    nan_bits: U32 = 0x7FFFFFFF
    bits: U32 = when
        r.is_nan() => nan_bits
        else => r.bits()
    return mix(acc, value: bits.to[U64]())

### The checksum of B32 1 / sqrt over the sampled patterns.
### :returns: The checksum.
routine sum_b32_sampled() -> U64
    loop with k: U32 = 0, acc: U64 = 0xCBF29CE484222325
        if k == 1048576
            return acc
        continue with k: k + 1, acc: mix_b32(acc, u: k *% 4093)

### The checksum of B32 1 / sqrt over the sampled patterns, then the listed ones.
### :returns: The checksum.
routine sum_b32() -> U64
    loop with i: U64 = 0, acc: U64 = sum_b32_sampled()
        if i == 2778
            return acc
        continue with i: i + 1, acc: mix_b32(acc, u: B32_INPUTS.getitem(i))

### The checksum of B64 1 / sqrt over the listed patterns.
### :returns: The checksum.
routine sum_b64() -> U64
    loop with i: U64 = 0, acc: U64 = 0xCBF29CE484222325
        if i == 13725
            return acc
        r: B64 = B64.from_bits(B64_INPUTS.getitem(i)).rsqrt_unchecked()
        nan_bits: U64 = 0x7FFFFFFFFFFFFFFF
        bits: U64 = when
            r.is_nan() => nan_bits
            else => r.bits()
        continue with i: i + 1, acc: mix(acc, value: bits)

### The checksum of B128 1 / sqrt over the listed patterns, the low word of each result first.
### :returns: The checksum.
routine sum_b128() -> U64
    loop with i: U64 = 0, acc: U64 = 0xCBF29CE484222325
        if i == 6147
            return acc
        r: B128 = B128.from_bits(B128_INPUTS.getitem(i)).rsqrt_unchecked()
        nan_bits: U128 = 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
        bits: U128 = when
            r.is_nan() => nan_bits
            else => r.bits()
        low: U64 = bits.to_wrap[U64]()
        high: U64 = (bits >> 64).to_wrap[U64]()
        continue with i: i + 1, acc: mix(acc: mix(acc, value: low), value: high)

### Prints each type's checksum.
### :returns: Nothing.
routine start() -> None
    Console.show("b16 {sum_b16()}")
    Console.show("bf16 {sum_bf16()}")
    Console.show("b32 {sum_b32()}")
    Console.show("b64 {sum_b64()}")
    Console.show("b128 {sum_b128()}")
    return
