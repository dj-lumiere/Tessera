# A steal out of a place that keeps a Box? gives a Box?: reading it as a Box without a `when` first is a build error,
# because the place may have held None.

import Collections
import Hosted

### A box.
entity Box
    n: U64

### Makes a box.
### :param n: Its number.
### :returns: The box.
common routine Box.construct(n: U64) -> Me
    return Me(n)

### Takes the box out of the first slot and reads it.
routine start() -> None
    slots: &List[Box?] <- .construct(HEAP)
    slots.add_last(None())
    steal slots.getslot(0) as kid inject None()
    Console.show("n = {kid.n.peek()}")
    drop kid
    drop slots
    return
