# A FileStorage mapped without write crashes on a cell write with InvalidValueError, at the caller's line, instead of
# the write faulting on a read-only page.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("fs_storage_read_only.te")
    Console.show("crashed: {name} at this file {here}")
    exit(3)

routine start() -> None
    local tmp: @Directory <- OsEnvironment.temp_directory_result().unwrap()
    local f: @File <- tmp.file(name: "tessera_fs_storage_read_only.bin")

    OsFileManager.make_file_result(at: f, replacing: true).unwrap()
    OsFileManager.write_all_result(at: f, data: "abc").unwrap()
    local s: @FileStorage[Byte] <- OsFileManager.storage_result[Byte](at: f, write: false, start: 0,
        count: U64.MAX).unwrap()
    Console.show("read: {s[0].to[U8]()}")
    s[0] = b'x'
    Console.show("not reached")
    drop f
    drop tmp
    return
