import Standard/Format
import Standard/Os

# `key: (...)` matches when the target's value is any of those listed, `key: not (...)` when it is none of them.

### Every architecture the builder knows is listed, so this one is chosen.
@target(arch: ("x86_64", "x86", "aarch64", "arm", "riscv64", "riscv32", "powerpc64le", "mipsel",
    "wasm32", "wasm64"))
routine arch_listed() -> Span[Byte]
    return "listed"

### The same list negated never matches.
@target(arch: not ("x86_64", "x86", "aarch64", "arm", "riscv64", "riscv32", "powerpc64le", "mipsel",
    "wasm32", "wasm64"))
routine arch_listed() -> Span[Byte]
    return "not listed"

### A list of one is a single value.
@target(os: ("none"))
routine os_kind() -> Span[Byte]
    return "none"

@target(os: not ("none"))
routine os_kind() -> Span[Byte]
    return "hosted"

routine start() -> None
    arch: Span[Byte] = arch_listed()
    os: Span[Byte] = os_kind()
    Out.write("arch: {arch}\nos: {os}\n")
    return
