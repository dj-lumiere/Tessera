# `to`, `til` and `by` are keywords only inside a range. Everywhere else they are names: parameters, labels, fields,
# bindings taken from a tuple.

import Hosted

record Step
    from: S32
    to: S32
    by: S32
    til: S32

routine hop(n: S32, to: Char, by: S32, til: S32) -> S32
    return n + by + til

routine pair() -> (S32, S32, S32, S32)
    return (1, 2, 3, 4)

routine start() -> None
    n, from, tmp, to = pair()
    step: Step = Step(from: 1, to: 2, by: 3, til: 4)
    Console.show("{step.to} {step.by} {step.til} {hop(n: 1, to: 'c', by: 2, til: 3)}")
    by: S64 = 2
    til: S64 = 9
    Console.show("{n + from + tmp + to} {by} {til}")
    total: &S64 <- 0
    for i in 0 til 6 by by
        total <- total.load() + i
    Console.show("{total.load()}")
    return
