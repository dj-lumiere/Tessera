# A string literal and an array literal of constants are read-only data, so a view of them may be taken with =.
# An Items[T, _] takes its count from its literal, as a value or in a place.

import Hosted

preset LIMIT: S64 = 9

routine start() -> None
    a: S64 = 2
    numbers: @[S64] = [1, 2, LIMIT]
    pair: @Items[S32, _] = [5, 6]
    values: Items[S64, _] = [a, a * 2, a * 3]
    slots: &Items[S64, _] <- [a] * 4
    bytes: Items[Byte, _] = "루미"
    chars: Items[Char, _] = "루미"
    slots.getslot(1).poke(7)
    Console.show("{numbers[2]} {numbers.count()} {pair.getitem(1)} {values} {slots.getitem(1)} {bytes.count()} {chars.count()}")
    return
