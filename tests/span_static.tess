// Span[T] in static memory and in the frame, and memory from a manager written as `... at manager`.

import Standard/Format
import Standard/Os

global BY_LETTER: Span[U64] <- [0] x 26

preset STOPWORDS: Span[Span[Byte]] <- ["the", "a", "an"]

record Node
    value: S64
    next: @Node

routine Node.construct(value: S64, next: @Me) -> Me
    return(Me(value, next))

routine Node.destruct(me: @Me) -> Void
    return()

routine sum(xs: Span[S64]) -> S64
    jump each(0, 0)

    block each(i: USize, total: S64)
        branch i.ge(xs.count)
            ? done(total)
            : continue
        jump each(i.add(1), total.add(xs.getitem(i)))

    block done(total: S64)
        return(total)

routine start() -> Void
    out: @Out = Out.writer()
    claim lower: Span[Byte] <- [0x00] x 64
    claim words: Memory[S64] <- [1, 2] x 3 at DEFAULT_HEAP
    claim one: Box[Node] <- (value: 7, next: null) at DEFAULT_HEAP
    lower.setitem(index: 3, value: 0x41)
    BY_LETTER.setitem(index: 2, value: 9)
    word: Span[Byte] = STOPWORDS.getitem(2)
    out.write("{STOPWORDS.count()} {word} {lower.count()} {lower.getitem(3).to[U8]()} {BY_LETTER.getitem(2)} {BY_LETTER.count()}\n")
    total: S64 = sum(words)
    literal: S64 = sum([4, 5, 6])
    node: Node = one.load()
    out.write("{total} {words.count()} {literal} {node.value}\n")
    words.drop()
    one.drop()
    return()
