# Entity keys and elements in the keyed collections: Set and Dict keys, PriorityQueue priorities and elements, and the
# sorted collections' elements are entities here. Hash, eq, and compare read them through their places, they move in
# with steal, a duplicate that doesn't go in ends at once, and remove, a replaced value, and destruct end each one.

import Standard/Collections
import Standard/Format
import Standard/Os

### A key that ends loudly.
entity Key
obeys HashEquatable[Key], Comparable[Key], Diagnosable[Key]
    n: S64

### Makes one.
### :param n: The value.
### :returns: The key.
routine Key.construct(n: S64) -> Me
    return Me(n)

### Ends it.
routine Key.destruct(me: @Me) -> None
    Out.write("~{me.n.peek()} ")
    return

### Equal when the values are.
### :param other: The other key.
### :returns: Whether they are equal.
routine Key.eq(me: @Me, other: @Me) -> Bool
    return me.n.peek() == other.n.peek()

### The value's hash.
### :returns: The hash.
routine Key.hash(me: @Me) -> U64
    return me.n.peek().hash()

### Orders by value.
### :param other: The other key.
### :returns: -1, 0 or 1.
routine Key.compare(me: @Me, other: @Me) -> S32
    return me.n.peek().compare(other.n.peek())

### Writes the value.
### :typeparam TWriter: The writer type.
### :param out: The writer.
routine Key.diagnose_into[TWriter](me: @Me, out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    write_str(out, text: "k")
    me.n.peek().diagnose_into(out)
    return

### Runs.
routine start() -> None
    local sl: @SortedList[Key] <- .construct(DEFAULT_HEAP)
    local ss: @SortedSet[Key] <- .construct(DEFAULT_HEAP)
    local sd: @SortedDict[Key, Key] <- .construct(DEFAULT_HEAP)
    local pq: @PriorityQueue[Key, Key] <- .construct(DEFAULT_HEAP)
    local d: @Dict[Key, Key] <- .construct(DEFAULT_HEAP)
    local s: @Set[Key] <- .construct(DEFAULT_HEAP)

    each i in 0 til 20
        n: S64 = (i * 7 % 20).to[S64]()
        sl.add(Key.construct(n))
        ss.add(Key.construct(n))
        sd.setitem(key: Key.construct(n), value: Key.construct(n * 10))
        pq.add(priority: Key.construct(n), element: Key.construct(n * 10))
        d.setitem(key: Key.construct(n), value: Key.construct(n * 10))
        s.add(Key.construct(n))
    Out.write("\n-- filled\n")
    ss.add(Key.construct(3))
    sd.setitem(key: Key.construct(3), value: Key.construct(33))
    d.setitem(key: Key.construct(3), value: Key.construct(33))
    s.add(Key.construct(3))
    Out.write("\n-- duplicates\n")
    Out.write("has {sl.has(Key.construct(5))} {ss.has(Key.construct(5))} {sd.has_key(Key.construct(5))} {d.has_key(Key.construct(25))}\n")
    each j in 0 til 12
        i: S64 = j.to[S64]()
        ss.remove(Key.construct(i))
        sd.remove(Key.construct(i))
        d.remove(Key.construct(i))
        s.remove(Key.construct(i))
        local top: @Key <- pq.remove()
        drop top
        local first: @Key <- sl.remove(0)
        drop first
    Out.write("\n-- removed\n")
    sl.diagnose_into(Out.writer())
    Out.write("\n")
    ss.diagnose_into(Out.writer())
    Out.write("\n")
    sd.diagnose_into(Out.writer())
    Out.write("\n")
    pq.diagnose_into(Out.writer())
    Out.write("\n")
    d.diagnose_into(Out.writer())
    Out.write("\n")
    s.diagnose_into(Out.writer())
    Out.write("\n")
    Out.write("{sd.getslot(Key.construct(15)).n.peek()} {d.getslot(Key.construct(15)).n.peek()}\n")
    drop sl
    Out.write("\n")
    drop ss
    Out.write("\n")
    drop sd
    Out.write("\n")
    drop pq
    Out.write("\n")
    drop d
    Out.write("\n")
    drop s
    Out.write("\n")
    return
