# A routine on a type declares its own type parameters on a needs line: a name in its [...] that no needs line declares
# and no type has is a build error, so a type declared later under that name can't change what the routine means.
import Hosted

record Box
    value: S64

### The box's value, given back as it is.
### :typeparam A: Unused.
### :returns: The value.
routine Box.get[A]() -> S64
    return me.value

routine start() -> None
    b: Box = Box(value: 3)
    Console.show("{b.get[S64]()}")
    return
