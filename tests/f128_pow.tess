        0xBFFF0000000000000000000000000000, 0xBFFF0000000000000000000000000000,
        0x3FFF0000000000000000000000000000, 0xBFFF0000000000000000000000000000,
        0xBFFF0000000000000000000000000000, 0xBFFF0000000000000000000000000000,
        0x3FFF0000000000000000000000000000, 0x3FFF0000000000000000000000000000, 0x1,
        0x7FFF0000000000000000000000000000, 0, 0, 0x7FFF0000000000000000000000000000, 0,
        0x7FFF0000000000000000000000000000 }

routine compute(%id: U64, %x: F128, %y: F128, %n: S64) -> U128
    block entry():
        when %id:
            0    -> pow()
            1    -> pow()
            2    -> pow()
            3    -> pow()
            4    -> pow()
            5    -> pow()
            6    -> fast_ok()
            7    -> pow()
            8    -> pow()
            9    -> fast_ok()
            10   -> pow_exact()
            11   -> powi()
            else -> return(0)

    block pow():
        %r : U128 = %x.powf(%y).bits()
        return(%r)

    block pow_exact():
        %r : U128 = f128_pow(%x, %y, true).bits()
        return(%r)

    // whether the fast tier keeps its own value (x > 0 here)
    block fast_ok():
        %w : WideRounding = wide_round_within(wide_pow(%x.abs(), %y), F128_POW_BAND)
        %r : U128         = %w.ok.to_u128()
        return(%r)

    block powi():
        %r : U128 = %x.powi(%n.to_s32()).bits()
        return(%r)

routine name(%out: Ptr<FdWriter>, %id: U64) -> Void
    block entry():
        when %id:
            0    -> n0()
            1    -> n1()
            2    -> n2()
            3    -> n3()
            4    -> n4()
            5    -> n5()
            6    -> n6()
            7    -> n7()
            8    -> n8()
            9    -> n9()
            10   -> n10()
            11   -> n11()
            else -> return()

    block n0():
        write(%out, "special")
        return()

    block n1():
        write(%out, "integer_y_exact")
        return()

    block n2():
        write(%out, "root_y_exact")
        return()

    block n3():
        write(%out, "subnormal_exact")
        return()

    block n4():
        write(%out, "power_of_two_x")
        return()

    block n5():
        write(%out, "fast_tier")
        return()

    block n6():
        write(%out, "fast_tier_kept")
        return()

    block n7():
        write(%out, "overflow_underflow")
        return()

    block n8():
        write(%out, "near_midpoint")
        return()

    block n9():
        write(%out, "near_midpoint_rejected")
        return()

    block n10():
        write(%out, "exact_tier")
        return()

    block n11():
        write(%out, "powi")
        return()

// "name: count ok", or how many of the count were wrong
routine summary(%out: Ptr<FdWriter>, %id: U64, %count: USize, %bad: U64) -> Void
    block entry():
        name(%out, %id)
        write(%out, ": {%count}")
        %clean : Bool = %bad.eq(0)
        branch %clean ? ok() : failed()

    block ok():
        write(%out, " ok\n")
        return()

    block failed():
        write(%out, " run, {%bad} wrong\n")
        return()

routine mismatch(%out: Ptr<FdWriter>, %row: USize, %got: U128, %want: U128) -> Void
    block entry():
        write(%out, "row {%row}: got ")
        %got.represent_hex(%out)
        write(%out, " want ")
        %want.represent_hex(%out)
        write(%out, "\n")
        return()

// "label = value (bits)"
routine show(%out: Ptr<FdWriter>, %label: Bytes, %x: F128, %y: F128) -> Void
    block entry():
        %r : F128 = %x.powf(%y)
        write(%out, "{%label} = {%r} (")
        %r.bits().represent_hex(%out)
        write(%out, ")\n")
        return()

routine main() -> S32
    block entry():
        %out_val : FdWriter = .stdout()
        claim %out : Ptr<FdWriter>
        %out.store(%out_val)
        show(%out, "2.25^1.5", f128_of(0x40002000000000000000000000000000),
                f128_of(0x3FFF8000000000000000000000000000))
        show(%out, "2^0.5", f128_of(0x40000000000000000000000000000000),
                f128_of(0x3FFE0000000000000000000000000000))
        show(%out, "10^-2", f128_of(0x40024000000000000000000000000000),
                f128_of(0xC0000000000000000000000000000000))
        show(%out, "3^-2", f128_of(0x40008000000000000000000000000000),
                f128_of(0xC0000000000000000000000000000000))
        show(%out, "(-2)^3", f128_of(0xC0000000000000000000000000000000),
                f128_of(0x40008000000000000000000000000000))
        show(%out, "(-8)^(1/3)", f128_of(0xC0020000000000000000000000000000),
                f128_of(0x3FFD5555555555555555555555555555))
        show(%out, "(1 + 2^-112)^0.5", f128_of(0x3FFF0000000000000000000000000001),
                f128_of(0x3FFE0000000000000000000000000000))
        show(%out, "(1 + 2^-112)^(2^20 + 0.5)", f128_of(0x3FFF0000000000000000000000000001),
                f128_of(0x40130000080000000000000000000000))
        show(%out, "(1 - 3 2^-113)^-5", f128_of(0x3FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFD),
                f128_of(0xC0014000000000000000000000000000))
        show(%out, "MAX^0.5", f128_of(0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF),
                f128_of(0x3FFE0000000000000000000000000000))
        show(%out, "(3 2^-3299)^5", f128_of(0x331D8000000000000000000000000000),
                f128_of(0x40014000000000000000000000000000))
        show(%out, "0.5^16494", f128_of(0x3FFE0000000000000000000000000000),
                f128_of(0x400D01B8000000000000000000000000))
        show(%out, "0.5^16495", f128_of(0x3FFE0000000000000000000000000000),
                f128_of(0x400D01BC000000000000000000000000))
        show(%out, "2^16384", f128_of(0x40000000000000000000000000000000),
                f128_of(0x400D0000000000000000000000000000))
        show(%out, "1.0001^100000000", f128_of(0x3FFF00068DB8BAC710CB295E9E1B089A),
                f128_of(0x40197D78400000000000000000000000))
        show(%out, "0.9^100000", f128_of(0x3FFECCCCCCCCCCCCCCCCCCCCCCCCCCCD),
                f128_of(0x400F86A0000000000000000000000000))
        show(%out, "(-0)^-3", f128_of(0x80000000000000000000000000000000),
                f128_of(0xC0008000000000000000000000000000))
        show(%out, "(-1)^inf", f128_of(0xBFFF0000000000000000000000000000),
                f128_of(0x7FFF0000000000000000000000000000))
        jump row(0, 0, 0, 0, %out)

    block row(%i: USize, %id: U64, %count: USize, %bad: U64, %out: Ptr<FdWriter>):
        %done : Bool = %i.ge(2505)
        branch %done ? last(%id, %count, %bad, %out) : load(%i, %id, %count, %bad, %out)

    block last(%id: U64, %count: USize, %bad: U64, %out: Ptr<FdWriter>):
        summary(%out, %id, %count, %bad)
        return(0)

    block load(%i: USize, %id: U64, %count: USize, %bad: U64, %out: Ptr<FdWriter>):
        %row_id   : U64  = POW_ID.get(%i)
        %new_func : Bool = %row_id.ne(%id)
        branch %new_func
            ? next_function(%i, %row_id, %id, %count, %bad, %out)
            : check(%i, %id, %count, %bad, %out)

    block next_function(%i: USize, %row_id: U64, %id: U64, %count: USize, %bad: U64,
            %out: Ptr<FdWriter>):
        summary(%out, %id, %count, %bad)
        jump check(%i, %row_id, 0, 0, %out)

    block check(%i: USize, %id: U64, %count: USize, %bad: U64, %out: Ptr<FdWriter>):
        %x     : F128 = f128_of(POW_X.get(%i))
        %y     : F128 = f128_of(POW_Y.get(%i))
        %n     : S64  = POW_N.get(%i)
        %want  : U128 = POW_WANT.get(%i)
        %got   : U128 = compute(%id, %x, %y, %n)
        %right : Bool = %got.eq(%want)
        branch %right
            ? next_row(%i, %id, %count, %bad, %out)
            : report(%i, %id, %count, %bad, %got, %want, %out)

    block report(%i: USize, %id: U64, %count: USize, %bad: U64, %got: U128, %want: U128,
            %out: Ptr<FdWriter>):
        mismatch(%out, %i, %got, %want)
        jump next_row(%i, %id, %count, %bad.add(1), %out)

    block next_row(%i: USize, %id: U64, %count: USize, %bad: U64, %out: Ptr<FdWriter>):
        jump row(%i.add(1), %id, %count.add(1), %bad, %out)
