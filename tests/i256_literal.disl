; Integer literals wider than 128 bits: decimal and hex I256 values, with hex magnitudes above the signed range
; read as two's-complement bit patterns, as for every narrower type.

; The four 64-bit limbs, most significant first.
routine show(#out: Ptr<FdWriter>, %x: I256) -> Void
    block entry():
        %l3: I64 = trunc<I256, I64>(lshr<I256>(%x, 192))
        %l2: I64 = trunc<I256, I64>(lshr<I256>(%x, 128))
        %l1: I64 = trunc<I256, I64>(lshr<I256>(%x, 64))
        %l0: I64 = trunc<I256, I64>(%x)
        %l3.format_hex(#out)
        write_str(#out, " ")
        %l2.format_hex(#out)
        write_str(#out, " ")
        %l1.format_hex(#out)
        write_str(#out, " ")
        %l0.format_hex(#out)
        write_line(#out)
        return()

routine show_bool(#out: Ptr<FdWriter>, %b: Bool) -> Void
    block entry():
        %b.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])

        %max:     I256 = 57896044618658097711785492504343953926634992332820282019728792003956564819967
        %min:     I256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
        %ones:    I256 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
        %top_bit: I256 = 0x8000000000000000_0000000000000000_0000000000000000_0000000000000000
        %mixed:   I256 = 0x0123456789ABCDEF_FEDCBA9876543210_DEADBEEFCAFEBABE_0000000100000002
        %small:   I256 = -2
        %over128: I256 = 340282366920938463463374607431768211456    ; 2^128
        show(#out, %max)
        show(#out, %min)
        show(#out, %ones)
        show(#out, %top_bit)
        show(#out, %mixed)
        show(#out, %small)
        show(#out, %over128)

        ; The bit patterns agree with the signed spellings.
        show_bool(#out, ieq<I256>(%ones, -1))
        show_bool(#out, ieq<I256>(%top_bit, %min))
        show_bool(#out, ieq<I256>(%max, 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF))

        ; Narrower types keep their own bit-pattern reading.
        %ones128: I128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
        %ones64:  I64  = 0xFFFFFFFFFFFFFFFF
        show_bool(#out, %ones128.eq(-1))
        show_bool(#out, %ones64.eq(-1))
        return(0)
