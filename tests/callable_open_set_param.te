# A Callable parameter that a routine keeps (writes into a record) is open to any failure, like the field it goes to: a
# routine value that may fail, one that never fails and a lambda are all handed to it as they are. A name bound to a
# routine value in the same routine goes too.

import Hosted

crashable BadInputError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### n, failing for a negative n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    return n

### Twice n and it never fails.
### :param n: The number.
### :returns: Twice n.
infallible routine twice(n: S64) -> S64
    return n * 2

### An action kept to run later.
record Handler
    action: Callable[(S64,), S64]

### Makes a handler from its action.
### :param action: The action.
### :returns: The handler.
common routine Handler.construct(action: Callable[(S64,), S64]) -> Me
    return Me(action)

### Runs the handler's action.
### :param h: The handler.
### :param n: The argument.
### :returns: What the action gave.
routine run(h: Handler, n: S64) -> S64
    act: Callable[(S64,), S64] = h.action
    return act.call(n)

### Runs the example.
routine start() -> None
    strict: Handler = Handler.construct(action: checked.to[Callable]())
    plain: Handler = Handler.construct(action: twice.to[Callable]())
    lambda: Handler = Handler.construct(action: (n) => n + 1)
    named: Callable[(S64,), S64] = twice.to[Callable]()
    bound: Handler = Handler.construct(action: named)
    Console.show("strict {run(strict, 5)} plain {run(plain, 5)} lambda {run(lambda, 5)} bound {run(bound, 5)}")
    Console.show("try {try run(strict, -2)}")
    when check run(strict, -3)
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        else as other => Console.show("another failure: {other.name()}")
    return
