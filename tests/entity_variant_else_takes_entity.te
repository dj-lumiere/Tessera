# else would take the Counter without naming it: an entity branch gets an arm of its own.
import Standard/Os

### Counts things.
entity Counter
    count: S64

### Why no counter was made.
record ParseFailed
    at: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing: a Counter holds no memory.
routine @Counter.destruct() -> None
    return

### A counter, or why not.
### :param n: Fails when negative.
### :returns: The counter, or the failure.
routine open(n: S64) -> Result[Counter, ParseFailed]
    if n < 0
        return ParseFailed(at: n)
    return Counter.construct()

### Observes one.
routine start() -> None
    when open(1)
        is ParseFailed => Console.show("failed")
        else => Console.show("something")
    return
