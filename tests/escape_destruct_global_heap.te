# A view of held memory in a local entity's field, which the entity's destruct moves into a global.

import Standard/Hosted

global KEPT: &@[Byte] <- .hollow()

### Holds a span.
entity Q
    held: @[Byte]

### Makes one holding nothing.
### :returns: The holder.
common routine Q.construct() -> Me
    return Me(held: .hollow())

### Puts what it holds into the global.
routine @Q.destruct() -> None
    KEPT.poke(me.held.peek())
    return

### The text lives in this frame, the holder too.
routine fill() -> None
    m: &[Byte] <- [b'h'] * 32 from HEAP
    q: &Q <- .construct()

    q.held.poke(m.getslice())
    drop q
    drop m
    return

### Writes over the stack.
### :param seed: The byte to write.
### :returns: The count written.
routine scribble(seed: Byte) -> U64
    junk: &[Byte] <- [seed] * 32 from HEAP

    n: U64 = junk.count()
    drop junk
    return n

### Runs.
routine start() -> None
    fill()
    n: U64 = scribble(seed: b'X')
    s: @[Byte] = KEPT.peek()
    out: &[Byte] <- [b'.'] * 32
    each i: U64 in 0 til 32
        out.getslot(i).poke(s.getitem(i))
    Console.show("kept {s.count} bytes, first byte {s.getitem(0).to[U8]()} (expected 104 'h', scribble {n})")
    return
