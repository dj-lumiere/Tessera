### An untyped integer literal prefers S64 when several overloads could take it. A typed argument picks its own
### overload.
import Standard/Format
import Standard/Os

routine size(n: U64) -> Span[Byte]
    return "U64"

routine size(n: U8) -> Span[Byte]
    return "U8"

routine size(n: S64) -> Span[Byte]
    return "S64"

routine start() -> None
    small: U8 = 3
    Out.write("{size(3)} {size(-3)} {size(small)}\n")
    return
