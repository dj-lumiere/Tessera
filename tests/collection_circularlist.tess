// CircularList<S64> against a model. An LCG drives random pushes and pops at both ends, get / set, and a rare clear, in five
// phases: balanced, front-heavy, back-heavy, a queue (push_back / pop_front), and a reversed queue (push_front /
// pop_back). Every 500 operations a checkpoint prints the length, the capacity (a queue must not grow it without
// bound), a running checksum of every result, and a hash of the CircularListIter sequence. Then eq.
// The expected output is generated by scripts/gen_collection_seq.py.

import Standard::Alloc
import Standard::Collections
import Standard::Format

record Rng
    state : U64

routine Rng.below(%self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state : U64 = %self.state.load()
        %next  : U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        %self.state.store(%next)
        %value : U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed : S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(%out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write(%out, " {%label} {%value}")
        return()

// Percentages of each push and pop; get and set take 10 each.
record Mix
    push_back  : U64
    push_front : U64
    pop_back   : U64
    pop_front  : U64

// Folds every element front to back.
routine iteration_hash(%circular_list: Ptr<CircularList<S64>>) -> S64
    block entry():
        %iter_val : CircularListIter<S64> = .construct(%circular_list)
        claim %iter : Ptr<CircularListIter<S64>>
        %iter.store(%iter_val)
        jump next(%iter, 0)

    block next(%iter: Ptr<CircularListIter<S64>>, %hash: S64):
        %item : Option<S64> = %iter.next()
        when %item:
            .Present(%value) -> next(%iter, mix(%hash, %value))
            .Absent          -> return(%hash)

routine checkpoint(%out: Ptr<BufWriter<FdWriter>>, %circular_list: Ptr<CircularList<S64>>,
        %phase: U64, %op: U64, %results: S64) -> Void
    block entry():
        write(%out, "phase {%phase}")
        labeled(%out, "op", %op.to_s64())
        labeled(%out, "length", %circular_list.length().to_s64())
        labeled(%out, "results", %results)
        labeled(%out, "iteration", iteration_hash(%circular_list))
        %capacity : U64 = %circular_list.capacity.load()
        labeled(%out, "capacity", %capacity.to_s64())
        write(%out, "\n")
        return()

// Runs ops random operations weighted by op_mix. Returns the updated results checksum.
routine run_phase(%out: Ptr<BufWriter<FdWriter>>, %circular_list: Ptr<CircularList<S64>>,
        %rng: Ptr<Rng>, %phase: U64, %ops: U64, %op_mix: Mix, %results: S64) -> S64
    block entry():
        %push_back_end  : U64 = %op_mix.push_back.mul(10)
        %push_front_end : U64 = %push_back_end.add(%op_mix.push_front.mul(10))
        %pop_back_end   : U64 = %push_front_end.add(%op_mix.pop_back.mul(10))
        %pop_front_end  : U64 = %pop_back_end.add(%op_mix.pop_front.mul(10))
        jump next(0, %results, %push_back_end, %push_front_end, %pop_back_end, %pop_front_end)

    block next(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %done : Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results, %pbe, %pfe, %obe, %ofe)

    block pick(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %kind          : U64  = %rng.below(1000)
        %is_push_back  : Bool = %kind.lt(%pbe)
        %is_push_front : Bool = %kind.lt(%pfe)
        %is_pop_back   : Bool = %kind.lt(%obe)
        %is_pop_front  : Bool = %kind.lt(%ofe)
        %is_get        : Bool = %kind.lt(%ofe.add(100))
        %is_clear      : Bool = %kind.eq(999)
        when:
            %is_push_back  -> push_back(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_push_front -> push_front(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_pop_back   -> pop_back(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_pop_front  -> pop_front(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_get        -> get(%op, %results, %pbe, %pfe, %obe, %ofe)
            %is_clear      -> clear(%op, %results, %pbe, %pfe, %obe, %ofe)
            else           -> set(%op, %results, %pbe, %pfe, %obe, %ofe)

    block push_back(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %value : S64 = %rng.below(1000000).to_s64()
        %circular_list.push_back(%value)
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block push_front(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %value : S64 = %rng.below(1000000).to_s64()
        %circular_list.push_front(%value)
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block pop_back(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %empty : Bool = %circular_list.is_empty()
        branch %empty
            ? record(%op, %results, -1, %pbe, %pfe, %obe, %ofe)
            : record(%op, %results, %circular_list.pop_back(), %pbe, %pfe, %obe, %ofe)

    block pop_front(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %empty : Bool = %circular_list.is_empty()
        branch %empty
            ? record(%op, %results, -1, %pbe, %pfe, %obe, %ofe)
            : pop_front_one(%op, %results, %pbe, %pfe, %obe, %ofe)

    block pop_front_one(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %value : S64 = %circular_list.pop_front()
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block get(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %empty : Bool = %circular_list.is_empty()
        branch %empty
            ? record(%op, %results, -2, %pbe, %pfe, %obe, %ofe)
            : get_one(%op, %results, %pbe, %pfe, %obe, %ofe)

    block get_one(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %index : U64 = %rng.below(%circular_list.length())
        %value : S64 = %circular_list.get(%index)
        jump record(%op, %results, %value, %pbe, %pfe, %obe, %ofe)

    block set(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %empty : Bool = %circular_list.is_empty()
        branch %empty
            ? record(%op, %results, -3, %pbe, %pfe, %obe, %ofe)
            : set_one(%op, %results, %pbe, %pfe, %obe, %ofe)

    block set_one(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %index : U64 = %rng.below(%circular_list.length())
        %value : S64 = %rng.below(1000000).to_s64()
        %circular_list.set(%index, %value)
        jump record(%op, %results, %index.to_s64(), %pbe, %pfe, %obe, %ofe)

    block clear(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %circular_list.clear()
        jump record(%op, %results, -4, %pbe, %pfe, %obe, %ofe)

    block record(%op: U64, %results: S64, %result: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        %mixed   : S64  = mix(%results, %result)
        %op_next : U64  = %op.add(1)
        %report  : Bool = %op_next.rem(500).eq(0)
        branch %report
            ? report(%op_next, %mixed, %pbe, %pfe, %obe, %ofe)
            : next(%op_next, %mixed, %pbe, %pfe, %obe, %ofe)

    block report(%op: U64, %results: S64, %pbe: U64, %pfe: U64, %obe: U64, %ofe: U64):
        checkpoint(%out, %circular_list, %phase, %op, %results)
        jump next(%op, %results, %pbe, %pfe, %obe, %ofe)

// Copies from into to by pushing each element at the front, back to front, so to has a different start.
routine copy_reversed_pushes(%from: Ptr<CircularList<S64>>, %to: Ptr<CircularList<S64>>) -> Void
    block entry():
        %length : U64 = %from.length()
        jump next(%length)

    block next(%index: U64):
        %done : Bool = %index.eq(0)
        branch %done ? return() : copy(%index.sub(1))

    block copy(%index: U64):
        %to.push_front(%from.get(%index))
        jump next(%index)

routine report_eq(%out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write(%out, "{%label} {%equal}\n")
        return()

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim %fd : Ptr<FdWriter>
        %fd.store(%fd_val)
        claim %out : Ptr<BufWriter<FdWriter>>
        %out.construct(%fd)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %rng_val : Rng = Rng { state: 3 }
        claim %rng : Ptr<Rng>
        %rng.store(%rng_val)
        %circular_list_val : CircularList<S64> = .construct(%alloc)
        claim %circular_list : Ptr<CircularList<S64>>
        %circular_list.store(%circular_list_val)

        %balanced       : Mix = Mix { push_back: 25, push_front: 25, pop_back: 15, pop_front: 15 }
        %front_heavy    : Mix = Mix { push_back: 5, push_front: 45, pop_back: 20, pop_front: 10 }
        %back_heavy     : Mix = Mix { push_back: 45, push_front: 5, pop_back: 10, pop_front: 20 }
        %queue          : Mix = Mix { push_back: 40, push_front: 0, pop_back: 0, pop_front: 40 }
        %reversed_queue : Mix = Mix { push_back: 0, push_front: 40, pop_back: 40, pop_front: 0 }
        %r1             : S64 = run_phase(%out, %circular_list, %rng, 1, 3000, %balanced, 0)
        %r2             : S64 = run_phase(%out, %circular_list, %rng, 2, 3000, %front_heavy, %r1)
        %r3             : S64 = run_phase(%out, %circular_list, %rng, 3, 3000, %back_heavy, %r2)
        %r4             : S64 = run_phase(%out, %circular_list, %rng, 4, 8000, %queue, %r3)
        %r5             : S64 = run_phase(%out, %circular_list, %rng, 5, 8000, %reversed_queue, %r4)

        %copied_val : CircularList<S64> = .construct(%alloc)
        claim %copied : Ptr<CircularList<S64>>
        %copied.store(%copied_val)
        report_eq(%out, "empty copy equal", %circular_list.eq(%copied))
        copy_reversed_pushes(%circular_list, %copied)
        report_eq(%out, "copy equal", %circular_list.eq(%copied))
        %front : S64 = %copied.get(0)
        %copied.set(0, %front.add(1))
        report_eq(%out, "changed front equal", %circular_list.eq(%copied))
        %copied.set(0, %front)
        %copied.push_front(%front)
        report_eq(%out, "longer equal", %circular_list.eq(%copied))
        %copied.pop_front()
        report_eq(%out, "restored equal", %circular_list.eq(%copied))
        %copied.clear()
        report_eq(%out, "cleared is empty", %copied.is_empty())
        %copied.destruct()
        %circular_list.destruct()
        report_eq(%out, "freed is empty", %circular_list.is_empty())
        %out.flush()
        return(0)
