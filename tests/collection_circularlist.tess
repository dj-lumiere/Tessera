// CircularList<S64> against a model. An LCG drives random pushes and pops at both ends, get / set, and a rare clear, in five
// phases: balanced, front-heavy, back-heavy, a queue (push_back / pop_front), and a reversed queue (push_front /
// pop_back). Every 500 operations a checkpoint prints the length, the capacity (a queue must not grow it without
// bound), a running checksum of every result, and a hash of the CircularListIter sequence. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

/// What every phase works with besides the collection.
record Harness
    /// Where checkpoints are written.
    out : @BufWriter<Out>
    /// The generator that picks each operation.
    rng : @Rng

/// One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    /// The phase's number, as checkpoints print it.
    number : USize
    /// How many operations the phase runs.
    ops : USize
    /// The percentages of each push and pop.
    op_mix : Mix

/// Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    /// The phase's number.
    phase : USize
    /// The operations run so far in the phase.
    op : USize
    /// The checksum of every result so far.
    results : S64

// Percentages of each push and pop. Get and set take 10 each.
record Mix
    push_back  : USize
    push_front : USize
    pop_back   : USize
    pop_front  : USize

routine Rng.below(me: @Me, bound: USize) -> USize
    block entry()
        state : U64 = me.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        me.state.store(next)
        bucket : U64   = next.shr(33).mod(bound.to<U64>())
        value  : USize = bucket.to<USize>()
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry()
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<T>(out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer<T>
    block entry()
        out.write(" {label} {value}")
        return()

// Folds every element front to back.
routine iteration_hash(circular_list: @CircularList<S64>) -> S64
    shared iter : @CircularListIter<S64> <- .construct(circular_list)

    block entry()
        jump next(0)

    block next(hash: S64)
        item : Option<S64> = iter.next()
        when item
            .Present(value) -> next(mix(hash, value))
            .Absent         -> return(hash)

routine checkpoint(out: @BufWriter<Out>, circular_list: @CircularList<S64>, at: Checkpoint) -> Void
    block entry()
        out.write("phase {at.phase}")
        labeled(out, "op", at.op.to<S64>())
        size : USize = circular_list.count()
        labeled(out, "length", size.to<S64>())
        labeled(out, "results", at.results)
        labeled(out, "iteration", iteration_hash(circular_list))
        capacity : USize = circular_list.storage.count.load()
        labeled(out, "capacity", capacity.to<S64>())
        out.write("\n")
        return()

// Runs ops random operations weighted by op_mix. Returns the updated results checksum.
routine run_phase(harness: Harness, circular_list: @CircularList<S64>, phase: Phase,
    results: S64) -> S64
    shared rng            : @Rng  = harness.rng
    shared ops            : USize = phase.ops
    shared op_mix         : Mix   = phase.op_mix
    shared push_back_end  : USize = op_mix.push_back.mul(10)
    shared push_front_end : USize = push_back_end.add(op_mix.push_front.mul(10))
    shared pop_back_end   : USize = push_front_end.add(op_mix.pop_back.mul(10))
    shared pop_front_end  : USize = pop_back_end.add(op_mix.pop_front.mul(10))

    block entry()
        jump next(0, results)

    block next(op: USize, checksum: S64)
        done : Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        kind          : USize = rng.below(1000)
        is_push_back  : Bool  = kind.lt(push_back_end)
        is_push_front : Bool  = kind.lt(push_front_end)
        is_pop_back   : Bool  = kind.lt(pop_back_end)
        is_pop_front  : Bool  = kind.lt(pop_front_end)
        is_get        : Bool  = kind.lt(pop_front_end.add(100))
        is_clear      : Bool  = kind.eq(999)
        when
            is_push_back  -> push_back(op, checksum)
            is_push_front -> push_front(op, checksum)
            is_pop_back   -> pop_back(op, checksum)
            is_pop_front  -> pop_front(op, checksum)
            is_get        -> get(op, checksum)
            is_clear      -> clear(op, checksum)
            else          -> set(op, checksum)

    block push_back(op: USize, checksum: S64)
        value : S64 = rng.below(1000000).to<S64>()
        circular_list.push_back(value)
        jump record(op, checksum, value)

    block push_front(op: USize, checksum: S64)
        value : S64 = rng.below(1000000).to<S64>()
        circular_list.push_front(value)
        jump record(op, checksum, value)

    block pop_back(op: USize, checksum: S64)
        empty : Bool = circular_list.is_empty()
        branch empty
            ? record(op, checksum, -1)
            : record(op, checksum, circular_list.pop_back())

    block pop_front(op: USize, checksum: S64)
        empty : Bool = circular_list.is_empty()
        branch empty
            ? record(op, checksum, -1)
            : pop_front_one(op, checksum)

    block pop_front_one(op: USize, checksum: S64)
        value : S64 = circular_list.pop_front()
        jump record(op, checksum, value)

    block get(op: USize, checksum: S64)
        empty : Bool = circular_list.is_empty()
        branch empty
            ? record(op, checksum, -2)
            : get_one(op, checksum)

    block get_one(op: USize, checksum: S64)
        index : USize = rng.below(circular_list.count())
        value : S64   = circular_list.getitem(index)
        jump record(op, checksum, value)

    block set(op: USize, checksum: S64)
        empty : Bool = circular_list.is_empty()
        branch empty
            ? record(op, checksum, -3)
            : set_one(op, checksum)

    block set_one(op: USize, checksum: S64)
        index : USize = rng.below(circular_list.count())
        value : S64   = rng.below(1000000).to<S64>()
        circular_list.setitem(index, value)
        jump record(op, checksum, index.to<S64>())

    block clear(op: USize, checksum: S64)
        circular_list.clear()
        jump record(op, checksum, -4)

    block record(op: USize, checksum: S64, result: S64)
        mixed   : S64   = mix(checksum, result)
        op_next : USize = op.add(1)
        report  : Bool  = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(harness.out, circular_list,
            Checkpoint { phase: phase.number, op: op, results: checksum })
        jump next(op, checksum)

// Copies from into to by pushing each element at the front, back to front, so to has a different start.
routine copy_reversed_pushes(from: @CircularList<S64>, to: @CircularList<S64>) -> Void
    block entry()
        count : USize = from.count()
        jump next(count)

    block next(index: USize)
        done : Bool = index.eq(0)
        branch done
            ? return()
            : copy(index.sub(1))

    block copy(index: USize)
        to.push_front(from.getitem(index))
        jump next(index)

routine report_eq(out: @BufWriter<Out>, label: Bytes, equal: Bool) -> Void
    block entry()
        out.write("{label} {equal}\n")
        return()

routine start() -> Void
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc         : @Allocator         <- make_heap_allocator()
        claim rng           : @Rng               <- Rng { state: 3 }
        claim circular_list : @CircularList<S64> <- .construct(alloc)

        balanced       : Mix     = Mix { push_back: 25, push_front: 25, pop_back: 15,
            pop_front: 15 }
        front_heavy    : Mix     = Mix { push_back: 5, push_front: 45, pop_back: 20, pop_front: 10 }
        back_heavy     : Mix     = Mix { push_back: 45, push_front: 5, pop_back: 10, pop_front: 20 }
        queue          : Mix     = Mix { push_back: 40, push_front: 0, pop_back: 0, pop_front: 40 }
        reversed_queue : Mix     = Mix { push_back: 0, push_front: 40, pop_back: 40, pop_front: 0 }
        harness        : Harness = Harness { out: out, rng: rng }
        r1             : S64     = run_phase(harness, circular_list,
            Phase { number: 1, ops: 3000, op_mix: balanced }, 0)
        r2             : S64     = run_phase(harness, circular_list,
            Phase { number: 2, ops: 3000, op_mix: front_heavy }, r1)
        r3             : S64     = run_phase(harness, circular_list,
            Phase { number: 3, ops: 3000, op_mix: back_heavy }, r2)
        r4             : S64     = run_phase(harness, circular_list,
            Phase { number: 4, ops: 8000, op_mix: queue }, r3)
        r5             : S64     = run_phase(harness, circular_list,
            Phase { number: 5, ops: 8000, op_mix: reversed_queue }, r4)

        claim copied : @CircularList<S64> <- .construct(alloc)
        report_eq(out, "empty copy equal", circular_list.load().eq(copied.load()))
        copy_reversed_pushes(circular_list, copied)
        report_eq(out, "copy equal", circular_list.load().eq(copied.load()))
        front : S64 = copied.getitem(0)
        copied.setitem(0, front.add(1))
        report_eq(out, "changed front equal", circular_list.load().eq(copied.load()))
        copied.setitem(0, front)
        copied.push_front(front)
        report_eq(out, "longer equal", circular_list.load().eq(copied.load()))
        copied.pop_front()
        report_eq(out, "restored equal", circular_list.load().eq(copied.load()))
        copied.clear()
        report_eq(out, "cleared is empty", copied.is_empty())
        copied.destruct()
        circular_list.destruct()
        report_eq(out, "freed is empty", circular_list.is_empty())
        out.flush()
        return()
