# p.stride(n) is the address n Ts past p: a U64, or an S64 to move back (a negative literal is one). It's a
# place like a field, so it chains: points.stride(i).y. Array and Vector literals,
# [a, b, ...], take their type from where they go.

import Standard/Format
import Standard/Os

record Point
    x: S32
    y: S32

routine start() -> None
    local nums: @Array[S64, 4] <- [10, 20, 30, 40]

    first: @S64 = nums.to[@S64]()
    third: @S64 = first.stride(2)
    back: @S64 = third.stride(-1)
    step: S64 = -2
    again: @S64 = third.stride(step)
    Out.write("{third.peek()} {back.peek()} {again.peek()}\n")

    local points: @Array[Point, 3] <- .hollow()
    points.zeroinit(1)
    base: @Point = points.to[@Point]()
    i: U64 = 1
    base.stride(i).y.poke(7)
    base.stride(2).x.poke(-3)
    Out.write("{base.stride(1).y.peek()} {base.stride(2).x.peek()} {points.getitem(1).y}\n")

    grid: Array[Array[S16, 2], 2] = [[1, 2], [3, 4]]
    local cells: @Array[Array[S16, 2], 2] <- grid
    row: @Array[S16, 2] = cells.to[@Array[S16, 2]]().stride(1)
    Out.write("{row.getitem(0)} {row.getitem(1)}\n")

    v: Vector[S32, 4] = [1, -2, 3, i.to[S32]()]
    Out.write("{v.getitem(1)} {v.getitem(3)} {v.sum()}\n")
    return
