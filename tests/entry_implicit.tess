// The lines after a routine's head, before its first block, are its entry block: no 'block entry()' needed.
import Standard/Format
import Standard/Os

/// Whether a year has 366 days.
/// :param year: The year.
/// :returns: 366 or 365.
routine days_in_year(year: S64) -> S64
    leap: Bool = year.mod(4).eq(0)
    branch leap
        ? return(366)
        : return(365)

/// Sums 1..n.
/// :param n: The last number.
/// :returns: The sum.
routine sum_to(n: S64) -> S64
    local total: @S64 <- 0

    jump loop(1)

    block loop(i: S64)
        branch i.gt(n)
            ? return(total.peek())
            : continue
        total.peek().add(i).poke_into(total)
        jump loop(i.add(1))

routine start() -> Void
    Out.write("{days_in_year(2024)} {sum_to(10)}\n")
    return()
