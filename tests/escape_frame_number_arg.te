# The address of a local as a number, handed to another routine.

import Standard/Os

global KEPT: @@S64 <- .hollow()

### Turns a number back into an address and keeps it.
### :param n: The address as a number.
routine keep(n: U64) -> None
    KEPT.poke(inttoptr[U64, Addr](n).to[@S64]())
    return

### Hands the address of a local on as a number.
routine fill() -> None
    local l: @S64 <- 1234567

    keep(ptrtoint[@S64, U64](l) + 0)
    return

routine start() -> None
    fill()
    return
