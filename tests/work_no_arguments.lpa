# A routine with no parameters and no result is a Work[None] too: to[Work]() with no arguments.

import Hosted

### Says hello.
routine hello() -> None
    Console.show("hello")
    return

### Runs the work on a thread.
routine start() -> None
    t: Thread[None] <- get_thread[None]()
    work: Work[None] = hello.to[Work]()
    t.put_work(work)
    t.retrieve()
    drop t
    return
