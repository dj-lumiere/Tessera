// A place is an address, also as a call argument: memory is never read implicitly.
routine take(%b: Byte) -> U8
    block entry():
        return(%b.to_u8())

routine main() -> S32
    block entry():
        claim %buf : Ptr<Byte>
        %buf.store(b'A')
        %v : U8 = take(%buf[0])
        return(0)
