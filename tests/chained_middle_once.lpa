# Each operand of a chained comparison is evaluated once, left to right: the middle is read by both comparisons and
# evaluated only once.

import Hosted

### Shows a name and a value, and gives the value back.
### :param name: What is shown first.
### :param value: The value shown and given back.
### :returns: value.
routine seen(name: @[Byte], value: S64) -> S64
    Console.show("{name} {value}")
    return value

routine start() -> None
    ok: Bool = seen("a", 1) < seen("b", 2) < seen("c", 3)
    Console.show("{ok}")
    same: Bool = 2 == seen("middle", 2) == 2
    Console.show("{same}")
    down: Bool = 9 >= seen("down", 4) > 3
    Console.show("{down}")
    return
