import Hosted

preset LSR: S8 = S8.logical_shift_right(-128, 1)
preset LSR_OUT: S16 = S16.logical_shift_right(-1, 16)

routine start() -> None
    x: U8 = 0x80
    y: S8 = -128
    z: S64 = -1
    b: Byte = 0xF0
    w: U256 = 1
    Console.show("{x >>> 3} {y >>> 1} {y >> 1} {z >>> 60} {z >>> 64} {b >>> 0x04} {(w << 255) >>> 255}")
    v: Vector[S32, 4] = Vector[S32, 4].splat(-16)
    sh: Vector[S32, 4] = Vector[S32, 4].splat(28)
    r: Vector[S32, 4] = v >>> sh
    Console.show("{r[0]}")
    Console.show("{LSR} {LSR_OUT}")
    return
