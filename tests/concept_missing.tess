/// A generic routine's concept constraint needs a declared conformance.
record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.eq(me: Me, other: Me) -> Bool
    return(true)

routine same[T](a: T, b: T) -> Bool
require T: typename, Equatable[T]
    r: Bool = a.eq(b)
    return(r)

routine start() -> Void
    p: Point = Point(x: 1)
    s: Bool = same(a: p, b: p)
    return()
