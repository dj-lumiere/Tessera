/// A generic routine's concept constraint needs a declared conformance.
record Point
    x : S64

routine Point.eq(self: Self, other: Self) -> Bool
    block entry()
        return(true)

routine same<T>(a: T, b: T) -> Bool
require T: typename, Equal<T>
    block entry()
        r : Bool = a.eq(b)
        return(r)

routine main() -> S32
    block entry()
        p : Point = Point { x: 1 }
        s : Bool  = same(p, p)
        return(0)
