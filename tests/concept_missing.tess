/// A generic routine's concept constraint needs a declared conformance.
record Point
    x: S64

routine Point.eq(me: Me, other: Me) -> Bool
    return(true)

routine same[T](a: T, b: T) -> Bool
require T: typename, Equatable[T]
    r: Bool = a.eq(b)
    return(r)

routine start() -> Void
    p: Point = Point(x: 1)
    s: Bool = same(a: p, b: p)
    return()
