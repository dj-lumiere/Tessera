; An out-of-bounds List.get panics: stdout keeps what came before, and the exit status is 101.

routine main() -> I32
    block entry():
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %empty: List<I64>      = List<I64>.new(#alloc)
        #list:  Ptr<List<I64>> = alloca<List<I64>>([%empty])
        #list.push(10)
        %first: I64 = #list.get(0)
        print_int(%first)
        println_slice("")
        %missing: I64 = #list.get(3)
        println_slice("not reached")
        return(0)
