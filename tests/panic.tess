// An out-of-bounds List.get panics: stdout keeps what came before, and the exit status is 101.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        claim alloc : @Allocator <- make_heap_allocator()
        claim list  : @List<S64> <- .construct(alloc)
        list.push(10)
        first : S64 = list.load().get(0)
        Out.write("{first}\n")
        missing : S64 = list.load().get(3)
        Out.write("not reached\n")
        return(0)
