// An out-of-bounds List.get panics: stdout keeps what came before, and the exit status is 101.

routine main() -> S32
    block entry():
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca
        #alloc.store(%heap)
        %empty: List<S64>      = List<S64>.construct(#alloc)
        #list:  Ptr<List<S64>> = alloca
        #list.store(%empty)
        #list.push(10)
        %first: S64 = #list.get(0)
        print_int(%first)
        println_slice("")
        %missing: S64 = #list.get(3)
        println_slice("not reached")
        return(0)
