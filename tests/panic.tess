// An out-of-bounds List.get panics: stdout keeps what came before, and the exit status is 101.

import Standard::Alloc
import Standard::Collections
import Standard::Format

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %empty : List<S64> = .construct(%alloc)
        claim %list : Ptr<List<S64>>
        %list.store(%empty)
        %list.push(10)
        %first : S64 = %list.get(0)
        print("{%first}\n")
        %missing : S64 = %list.get(3)
        print("not reached\n")
        return(0)
