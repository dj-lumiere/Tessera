# A pointer isn't Representable: its address is written through to[Addr](), and its target through load().
# Addresses vary from run to run, so only the shape and null are checked here. An address is the whole pointer width in
# uppercase hex, in groups of four digits joined by `_` (this test is the 32-bit form, format_address the 64-bit one).

import Hosted

preset KNOWN: U64 = 0x7FFD1A40

routine start() -> None
    out: @ConsoleOutput = Console.output()

    lateinit none: @S64
    out.write("{none.to[Addr]()}\n")
    raw: Addr
    out.write("{raw}\n")
    known: Addr = inttoptr[U64, Addr](KNOWN)
    out.write("{known}\n")

    # a real address: at least one digit after 0x, and it's what the slot's address is
    slot: &S64 <- 42
    seen: U64 = ptrtoint[@S64, U64](slot)
    nonzero: Bool = seen != 0
    out.write("{nonzero} {slot.load()}\n")
    return
