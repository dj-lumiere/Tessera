# The pool belongs to one thread: a routine that a work runs on another thread, or a routine that one calls, can't use it.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### Reads a node's value.
### :param s: The stamp.
### :returns: The value.
routine read(s: Stamped[Node]) -> S64
    return s.fetch().value.peek()

### The work: it reads through the stamp, one routine down.
### :param s: The stamp.
routine work(s: Stamped[Node]) -> None
    Console.show("{read(s)}")
    return

routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    s: Stamped[Node] = PoolManager.add(Node.construct(value: 1))
    t: Thread[None] <- get_thread[None]()
    w: Work[None] = work.to[Work](s: s)
    t.put_work(w)
    t.retrieve()
    drop t
    drop pool
    return
