# A #reshaping call on a list ends the views of what it holds, not the views of the list itself: the list's place is
# still there. A view of the elements taken again after the call sees them where they are now.

import Collections
import Hosted

### The view of `items` itself.
### :param items: A list.
### :returns: `items`.
routine same(items: @List[S64]) -> @List[S64]
    return items

### Adds to `items` through a second name of it and reads the count through the first.
### :param items: A list.
@reshaping(items)
routine grow(items: @List[S64]) -> None
    other: @List[S64] = items
    other.add_last(7)
    Console.show(items.count())
    return

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)
    xs.add_last(5)
    whole: @List[S64] = same(xs)
    xs.add_last(6)
    Console.show(whole.count())
    grow(whole)
    s: @[S64] = xs.getview()
    Console.show(s.getslot(2).peek())
    xs.add_last(8)
    again: @[S64] = xs.getview()
    Console.show(again.count())
    drop xs
    return
