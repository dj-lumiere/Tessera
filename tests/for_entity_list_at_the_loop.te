# A for over a list of entities is reported at the loop, with the way to walk it, not inside the emitter's own body.

import Hosted
import Collections

entity Box
    v: U64

common routine Box.construct(v: U64) -> Me
    return Me(v)

routine @Box.destruct() -> None
    return

routine start() -> None
    boxes: &List[Box] <- .construct(manager: HEAP)
    for b in boxes.emitter()
        Console.show("{b.v.peek()}")
    drop boxes
    return
