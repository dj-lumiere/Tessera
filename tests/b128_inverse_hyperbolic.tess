// B128 asinh, acosh, and atanh are correctly rounded (Standard/B128InverseHyperbolic.tess): each line is the
// result, its bits, which tier gave it, and the exact tier's own bits when they differ (never). Every result was
// checked against mpmath at 2000 bits, rounded to binary128. The hard cases lie within 2^-39 ulp of a midpoint,
// where the quick tier's gate and the fast tier's band test fail and the exact tier decides.

import Standard/Format
import Standard/Os

choice Fn: U8
    ASINH
    ACOSH
    ATANH

routine compute(f: Fn, x: B128, exact: Bool) -> B128
    block entry()
        when f
            Fn.ASINH => return(b128_asinh(x, exact))
            Fn.ACOSH => return(b128_acosh(x, exact))
            Fn.ATANH => return(b128_atanh(x, exact))

/// Whether the quick tier gives a result (x finite and not a special case).
routine quick_gives(f: Fn, x: B128) -> Bool
    block entry()
        when f
            Fn.ASINH => return(cm_asinh_quick(x.abs()).is_present())
            Fn.ACOSH => return(cm_acosh_quick(x).is_present())
            Fn.ATANH => return(cm_atanh_quick(x.abs()).is_present())

/// Whether the fast tier keeps its result (x finite and not a special case).
routine fast_keeps(f: Fn, x: B128) -> Bool
    block entry()
        when f
            Fn.ASINH => return(wide_round_within(wide_asinh(B128.to[B128Extended](x.abs())),
                B128_ASINH_BAND).ok)
            Fn.ACOSH => return(wide_round_within(wide_acosh(x), B128_ACOSH_BAND).ok)
            Fn.ATANH => return(wide_round_within(wide_atanh(x.abs()), B128_ATANH_BAND).ok)

routine value(out: @Out, name: Bytes, r: B128) -> Void
    block entry()
        out.write("{name} = {r} ")
        r.bits().represent_hex_into(out)
        return()

/// A special case: answered before either tier.
routine special(out: @Out, name: Bytes, f: Fn, bits: U128) -> Void
    block entry()
        value(out, name, compute(f, b128_of(bits), false))
        out.write("\n")
        return()

/// A general case: the result, the tier that gave it, and the exact tier on its own.
routine tiered(out: @Out, name: Bytes, f: Fn, bits: U128) -> Void
    local x     : B128 = b128_of(bits)
    local r     : B128 = compute(f, x, false)
    local exact : B128 = compute(f, x, true)

    block entry()
        quick : Bool = quick_gives(f, x)
        fast  : Bool = fast_keeps(f, x)
        value(out, name, r)
        later : Bytes = fast
            ? " fast"
            : " exact"
        tier : Bytes = quick
            ? " quick"
            : later
        write_str(out, tier)
        agree : Bool = exact.bits().eq(r.bits())
        branch agree
            ? done()
            : differ()

    block differ()
        out.write(" but the exact tier gives ")
        exact.bits().represent_hex_into(out)
        jump done()

    block done()
        out.write("\n")
        return()

routine start() -> Void
    block entry()
        out : @Out = Out.writer()
        out.write("-- special cases\n")
        special(out, "asinh(+0)", Fn.ASINH, 0)
        special(out, "asinh(-0)", Fn.ASINH, 0x80000000000000000000000000000000)
        special(out, "asinh(+inf)", Fn.ASINH, 0x7FFF0000000000000000000000000000)
        special(out, "asinh(-inf)", Fn.ASINH, 0xFFFF0000000000000000000000000000)
        special(out, "asinh(nan)", Fn.ASINH, 0x7FFF8000000000000000000000000000)
        special(out, "asinh(snan)", Fn.ASINH, 0x7FFF0000000000000000000000000001)
        special(out, "acosh(1)", Fn.ACOSH, 0x3FFF0000000000000000000000000000)
        special(out, "acosh(+inf)", Fn.ACOSH, 0x7FFF0000000000000000000000000000)
        special(out, "acosh(-inf)", Fn.ACOSH, 0xFFFF0000000000000000000000000000)
        special(out, "acosh(+0)", Fn.ACOSH, 0)
        special(out, "acosh(-0)", Fn.ACOSH, 0x80000000000000000000000000000000)
        special(out, "acosh(1 - 2^-113)", Fn.ACOSH, 0x3FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        special(out, "acosh(-2)", Fn.ACOSH, 0xC0000000000000000000000000000000)
        special(out, "acosh(-nan)", Fn.ACOSH, 0xFFFF8000000000000000000000000000)
        special(out, "atanh(+0)", Fn.ATANH, 0)
        special(out, "atanh(-0)", Fn.ATANH, 0x80000000000000000000000000000000)
        special(out, "atanh(1)", Fn.ATANH, 0x3FFF0000000000000000000000000000)
        special(out, "atanh(-1)", Fn.ATANH, 0xBFFF0000000000000000000000000000)
        special(out, "atanh(1 + 2^-112)", Fn.ATANH, 0x3FFF0000000000000000000000000001)
        special(out, "atanh(-2)", Fn.ATANH, 0xC0000000000000000000000000000000)
        special(out, "atanh(+inf)", Fn.ATANH, 0x7FFF0000000000000000000000000000)
        special(out, "atanh(snan)", Fn.ATANH, 0x7FFF0000000000000000000000000001)
        out.write("-- asinh\n")
        tiered(out, "asinh(1)", Fn.ASINH, 0x3FFF0000000000000000000000000000)
        tiered(out, "asinh(-0.5)", Fn.ASINH, 0xBFFE0000000000000000000000000000)
        tiered(out, "asinh(0.5 - 2^-114)", Fn.ASINH, 0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        tiered(out, "asinh(3)", Fn.ASINH, 0x40008000000000000000000000000000)
        tiered(out, "asinh(2^-60)", Fn.ASINH, 0x3FC30000000000000000000000000000)
        tiered(out, "asinh(1e-30)", Fn.ASINH, 0x3F9B4484BFEEBC29F863424B06F3529A)
        tiered(out, "asinh(min subnormal)", Fn.ASINH, 1)
        tiered(out, "asinh(-min normal)", Fn.ASINH, 0x80010000000000000000000000000000)
        tiered(out, "asinh(1e100)", Fn.ASINH, 0x414B249AD2594C37CEB0B2784C4CE0BF)
        tiered(out, "asinh(-max)", Fn.ASINH, 0xFFFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        out.write("-- acosh\n")
        tiered(out, "acosh(1 + 2^-112)", Fn.ACOSH, 0x3FFF0000000000000000000000000001)
        tiered(out, "acosh(1 + 2^-60)", Fn.ACOSH, 0x3FFF0000000000000010000000000000)
        tiered(out, "acosh(1.5)", Fn.ACOSH, 0x3FFF8000000000000000000000000000)
        tiered(out, "acosh(1.5 - 2^-112)", Fn.ACOSH, 0x3FFF7FFFFFFFFFFFFFFFFFFFFFFFFFFF)
        tiered(out, "acosh(2)", Fn.ACOSH, 0x40000000000000000000000000000000)
        tiered(out, "acosh(10)", Fn.ACOSH, 0x40024000000000000000000000000000)
        tiered(out, "acosh(2^100)", Fn.ACOSH, 0x40630000000000000000000000000000)
        tiered(out, "acosh(max)", Fn.ACOSH, 0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        out.write("-- atanh\n")
        tiered(out, "atanh(0.5)", Fn.ATANH, 0x3FFE0000000000000000000000000000)
        tiered(out, "atanh(-0.25)", Fn.ATANH, 0xBFFD0000000000000000000000000000)
        tiered(out, "atanh(1/9)", Fn.ATANH, 0x3FFBC71C71C71C71C71C71C71C71C71C)
        tiered(out, "atanh(1 - 2^-113)", Fn.ATANH, 0x3FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        tiered(out, "atanh(-1 + 2^-60)", Fn.ATANH, 0xBFFEFFFFFFFFFFFFFFE0000000000000)
        tiered(out, "atanh(2^-70)", Fn.ATANH, 0x3FB90000000000000000000000000000)
        tiered(out, "atanh(-min subnormal)", Fn.ATANH, 0x80000000000000000000000000000001)
        out.write("-- near a midpoint\n")
        tiered(out, "asinh(a)", Fn.ASINH, 0x3FC77137449123EF65CDDE7F16C56E33)
        tiered(out, "asinh(b)", Fn.ASINH, 0xBFD059DF4020FC31070880EE6A67CB9B)
        tiered(out, "asinh(c)", Fn.ASINH, 0x5730F0A2980210DD4C882FE62AF99148)
        tiered(out, "acosh(1 + 14112 2^-112)", Fn.ACOSH, 0x3FFF0000000000000000000000003720)
        tiered(out, "acosh(1 + 23328 2^-112)", Fn.ACOSH, 0x3FFF0000000000000000000000005B20)
        tiered(out, "acosh(1 + 549084930048 2^-112)", Fn.ACOSH, 0x3FFF0000000000000000007FD8032000)
        tiered(out, "atanh(a)", Fn.ATANH, 0x3FC6D12ED0AF1A27EF3DABAE134C2DA3)
        tiered(out, "atanh(b)", Fn.ATANH, 0xBFC87FFFFFFFFFFFFFFFFFFFFFFFFFFD)
        tiered(out, "atanh(c)", Fn.ATANH, 0x3FFEFFFFFFFFFA821DFB43C1666679BB)
        return()
