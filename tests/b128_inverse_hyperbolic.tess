// B128 asinh, acosh, and atanh are correctly rounded (Standard/B128InverseHyperbolic.tess): each line is the
// result, its bits, which tier gave it, and the exact tier's own bits when they differ (never). Every result was
// checked against mpmath at 2000 bits, rounded to binary128. The hard cases lie within 2^-39 ulp of a midpoint,
// where the quick tier's gate and the fast tier's band test fail and the exact tier decides.

import Standard/Format
import Standard/Os

choice Fn: U8
    ASINH
    ACOSH
    ATANH

routine compute(f: Fn, x: B128, exact: Bool) -> B128
    when f
        Fn.ASINH => return b128_asinh(x, exact)
        Fn.ACOSH => return b128_acosh(x, exact)
        Fn.ATANH => return b128_atanh(x, exact)

/// Whether the quick tier gives a result (x finite and not a special case).
routine quick_gives(f: Fn, x: B128) -> Bool
    when f
        Fn.ASINH => return cm_asinh_quick(x.abs()).is_present()
        Fn.ACOSH => return cm_acosh_quick(x).is_present()
        Fn.ATANH => return cm_atanh_quick(x.abs()).is_present()

/// Whether the fast tier keeps its result (x finite and not a special case).
routine fast_keeps(f: Fn, x: B128) -> Bool
    when f
        Fn.ASINH => return wide_round_within(u: wide_asinh(B128.to[B128Extended](x.abs())), k: B128_ASINH_BAND).ok
        Fn.ACOSH => return wide_round_within(u: wide_acosh(x), k: B128_ACOSH_BAND).ok
        Fn.ATANH => return wide_round_within(u: wide_atanh(x.abs()), k: B128_ATANH_BAND).ok

routine value(out: @Out, name: Span[Byte], r: B128) -> Void
    out.write("{name} = {r} ")
    r.bits().represent_hex_into(out)
    return

/// A special case: answered before either tier.
routine special(out: @Out, name: Span[Byte], f: Fn, bits: U128) -> Void
    value(out, name, r: compute(f, x: b128_of(bits), exact: false))
    out.write("\n")
    return

/// A general case: the result, the tier that gave it, and the exact tier on its own.
routine tiered(out: @Out, name: Span[Byte], f: Fn, bits: U128) -> Void
    local x: B128 = b128_of(bits)
    local r: B128 = compute(f, x, exact: false)
    local exact: B128 = compute(f, x, exact: true)

    quick: Bool = quick_gives(f, x)
    fast: Bool = fast_keeps(f, x)
    value(out, name, r)
    later: Span[Byte] = when
        fast => " fast"
        else => " exact"
    tier: Span[Byte] = when
        quick => " quick"
        else => later
    write_str(out, text: tier)
    if not (exact.bits() == r.bits())
        out.write(" but the exact tier gives ")
        exact.bits().represent_hex_into(out)
    out.write("\n")
    return

routine start() -> Void
    out: @Out = Out.writer()
    out.write("-- special cases\n")
    special(out, name: "asinh(+0)", f: Fn.ASINH, bits: 0)
    special(out, name: "asinh(-0)", f: Fn.ASINH, bits: 0x80000000000000000000000000000000)
    special(out, name: "asinh(+inf)", f: Fn.ASINH, bits: 0x7FFF0000000000000000000000000000)
    special(out, name: "asinh(-inf)", f: Fn.ASINH, bits: 0xFFFF0000000000000000000000000000)
    special(out, name: "asinh(nan)", f: Fn.ASINH, bits: 0x7FFF8000000000000000000000000000)
    special(out, name: "asinh(snan)", f: Fn.ASINH, bits: 0x7FFF0000000000000000000000000001)
    special(out, name: "acosh(1)", f: Fn.ACOSH, bits: 0x3FFF0000000000000000000000000000)
    special(out, name: "acosh(+inf)", f: Fn.ACOSH, bits: 0x7FFF0000000000000000000000000000)
    special(out, name: "acosh(-inf)", f: Fn.ACOSH, bits: 0xFFFF0000000000000000000000000000)
    special(out, name: "acosh(+0)", f: Fn.ACOSH, bits: 0)
    special(out, name: "acosh(-0)", f: Fn.ACOSH, bits: 0x80000000000000000000000000000000)
    special(out, name: "acosh(1 - 2^-113)", f: Fn.ACOSH, bits: 0x3FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
    special(out, name: "acosh(-2)", f: Fn.ACOSH, bits: 0xC0000000000000000000000000000000)
    special(out, name: "acosh(-nan)", f: Fn.ACOSH, bits: 0xFFFF8000000000000000000000000000)
    special(out, name: "atanh(+0)", f: Fn.ATANH, bits: 0)
    special(out, name: "atanh(-0)", f: Fn.ATANH, bits: 0x80000000000000000000000000000000)
    special(out, name: "atanh(1)", f: Fn.ATANH, bits: 0x3FFF0000000000000000000000000000)
    special(out, name: "atanh(-1)", f: Fn.ATANH, bits: 0xBFFF0000000000000000000000000000)
    special(out, name: "atanh(1 + 2^-112)", f: Fn.ATANH, bits: 0x3FFF0000000000000000000000000001)
    special(out, name: "atanh(-2)", f: Fn.ATANH, bits: 0xC0000000000000000000000000000000)
    special(out, name: "atanh(+inf)", f: Fn.ATANH, bits: 0x7FFF0000000000000000000000000000)
    special(out, name: "atanh(snan)", f: Fn.ATANH, bits: 0x7FFF0000000000000000000000000001)
    out.write("-- asinh\n")
    tiered(out, name: "asinh(1)", f: Fn.ASINH, bits: 0x3FFF0000000000000000000000000000)
    tiered(out, name: "asinh(-0.5)", f: Fn.ASINH, bits: 0xBFFE0000000000000000000000000000)
    tiered(out, name: "asinh(0.5 - 2^-114)", f: Fn.ASINH, bits: 0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
    tiered(out, name: "asinh(3)", f: Fn.ASINH, bits: 0x40008000000000000000000000000000)
    tiered(out, name: "asinh(2^-60)", f: Fn.ASINH, bits: 0x3FC30000000000000000000000000000)
    tiered(out, name: "asinh(1e-30)", f: Fn.ASINH, bits: 0x3F9B4484BFEEBC29F863424B06F3529A)
    tiered(out, name: "asinh(min subnormal)", f: Fn.ASINH, bits: 1)
    tiered(out, name: "asinh(-min normal)", f: Fn.ASINH, bits: 0x80010000000000000000000000000000)
    tiered(out, name: "asinh(1e100)", f: Fn.ASINH, bits: 0x414B249AD2594C37CEB0B2784C4CE0BF)
    tiered(out, name: "asinh(-max)", f: Fn.ASINH, bits: 0xFFFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
    out.write("-- acosh\n")
    tiered(out, name: "acosh(1 + 2^-112)", f: Fn.ACOSH, bits: 0x3FFF0000000000000000000000000001)
    tiered(out, name: "acosh(1 + 2^-60)", f: Fn.ACOSH, bits: 0x3FFF0000000000000010000000000000)
    tiered(out, name: "acosh(1.5)", f: Fn.ACOSH, bits: 0x3FFF8000000000000000000000000000)
    tiered(out, name: "acosh(1.5 - 2^-112)", f: Fn.ACOSH, bits: 0x3FFF7FFFFFFFFFFFFFFFFFFFFFFFFFFF)
    tiered(out, name: "acosh(2)", f: Fn.ACOSH, bits: 0x40000000000000000000000000000000)
    tiered(out, name: "acosh(10)", f: Fn.ACOSH, bits: 0x40024000000000000000000000000000)
    tiered(out, name: "acosh(2^100)", f: Fn.ACOSH, bits: 0x40630000000000000000000000000000)
    tiered(out, name: "acosh(max)", f: Fn.ACOSH, bits: 0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
    out.write("-- atanh\n")
    tiered(out, name: "atanh(0.5)", f: Fn.ATANH, bits: 0x3FFE0000000000000000000000000000)
    tiered(out, name: "atanh(-0.25)", f: Fn.ATANH, bits: 0xBFFD0000000000000000000000000000)
    tiered(out, name: "atanh(1/9)", f: Fn.ATANH, bits: 0x3FFBC71C71C71C71C71C71C71C71C71C)
    tiered(out, name: "atanh(1 - 2^-113)", f: Fn.ATANH, bits: 0x3FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
    tiered(out, name: "atanh(-1 + 2^-60)", f: Fn.ATANH, bits: 0xBFFEFFFFFFFFFFFFFFE0000000000000)
    tiered(out, name: "atanh(2^-70)", f: Fn.ATANH, bits: 0x3FB90000000000000000000000000000)
    tiered(out, name: "atanh(-min subnormal)", f: Fn.ATANH, bits: 0x80000000000000000000000000000001)
    out.write("-- near a midpoint\n")
    tiered(out, name: "asinh(a)", f: Fn.ASINH, bits: 0x3FC77137449123EF65CDDE7F16C56E33)
    tiered(out, name: "asinh(b)", f: Fn.ASINH, bits: 0xBFD059DF4020FC31070880EE6A67CB9B)
    tiered(out, name: "asinh(c)", f: Fn.ASINH, bits: 0x5730F0A2980210DD4C882FE62AF99148)
    tiered(out, name: "acosh(1 + 14112 2^-112)", f: Fn.ACOSH, bits: 0x3FFF0000000000000000000000003720)
    tiered(out, name: "acosh(1 + 23328 2^-112)", f: Fn.ACOSH, bits: 0x3FFF0000000000000000000000005B20)
    tiered(out, name: "acosh(1 + 549084930048 2^-112)", f: Fn.ACOSH, bits: 0x3FFF0000000000000000007FD8032000)
    tiered(out, name: "atanh(a)", f: Fn.ATANH, bits: 0x3FC6D12ED0AF1A27EF3DABAE134C2DA3)
    tiered(out, name: "atanh(b)", f: Fn.ATANH, bits: 0xBFC87FFFFFFFFFFFFFFFFFFFFFFFFFFD)
    tiered(out, name: "atanh(c)", f: Fn.ATANH, bits: 0x3FFEFFFFFFFFFA821DFB43C1666679BB)
    return
