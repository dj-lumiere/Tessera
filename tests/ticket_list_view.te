# Tickets whose work was handed views of memory go in a List[Thread[S64]]: the list holds the tickets, and the
# views their work reads, until the memory is given back.

import Collections
import Hosted

### The sum of the values.
### :param part: The values.
### :returns: Their sum.
routine total(part: @[S64]) -> S64
    each i in 0 til part.count() with sum: S64 = 0
        continue with sum: sum + part[i]
    then
        return sum

### Sums each half of four numbers on a thread of its own, keeping the tickets in a list.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3, 4] * 1 from HEAP
    ts: &List[Thread[S64]] <- .construct(HEAP)
    view: @[S64] = numbers.getslice()

    each half: U64 in 0 til 2
        t: Thread[S64] <- get_thread[S64]()
        work: Work[S64] = total.to[Work](part: view.getslice(start: half * 2, count: 2))
        t.put_work(work)
        ts.add_last(steal t)
    sums: &List[S64] <- ts.retrieve_all()
    ts.give_back_all()
    Console.show("{sums[0]} {sums[1]}")
    drop numbers
    return
