# at gives the address of an element, checked like get (a crash past the end or for a missing key), and at_checked
# returns None instead: a place to read or update in place. Array, List, and CircularList take an index. Dict and
# SortedDict take a key and give the value's address only, since changing a key in place would lose it.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> None
    local ring: @CircularList[S64] <- .hollow()

    heap: MemoryManager = make_heap_memory()
    local alloc: @MemoryManager <- heap

    local arr: @Array[S64, 3] <- .hollow()
    arr.zeroinit(1)
    arr.getslot(1).poke(5)
    Console.show("Array {arr.getitem(0)} {arr.getitem(1)}")

    local list: @List[S64] <- .construct(alloc)
    list.add_last(10)
    list.add_last(20)
    list.add_last(30)
    slot: @S64 = list.getslot(1)
    slot.poke(slot.peek() + 5)
    past: Maybe[@S64] = list.getslot_checked(3)
    Console.show("List {list.getitem(1)} {past.is_absent()}")
    drop list

    ring.poke(.construct(alloc))
    ring.add_last(1)
    ring.add_last(2)
    ring.add_first(0)
    third: @S64 = ring.getslot(2)
    third.poke(9)
    front: Maybe[@S64] = ring.getslot_checked(0)
    p: @S64 = when front
        is @S64 as p => p
        is None => unreachable
    Console.show("CircularList {p.peek()} {ring.getitem(2)}")

    local dict: @Dict[S64, S64] <- .construct(alloc)
    dict[7] = 1
    count: @S64 = dict.getslot(7)
    count.poke(count.peek() + 1)
    count.poke(count.peek() + 1)
    missing: Maybe[@S64] = dict.getslot_checked(8)
    Console.show("Dict {dict.getitem(7)} {missing.is_absent()}")

    local sorted: @SortedDict[S64, S64] <- .construct(alloc)
    sorted[3] = 30
    sorted[1] = 10
    sorted[2] = 20
    two: @S64 = sorted.getslot(2)
    two.poke(two.peek() * 2)
    none: Maybe[@S64] = sorted.getslot_checked(4)
    Console.show("SortedDict {sorted.getitem(2)} {none.is_absent()}")

    drop ring
    drop dict
    drop sorted
    return
