# One list handed to work on four threads that add to it with no lock.

import Standard/Collections
import Standard/Os

@reshaping(xs)
### The work.
routine work(xs: @List[S64]) -> S64
    each i: U64 in 0 til 10000
        xs.add_last(1)
    return 0

routine start() -> None
    local xs: @List[S64] <- .construct()

    t1: Thread[S64] = get_thread[S64]()
    t2: Thread[S64] = get_thread[S64]()
    t3: Thread[S64] = get_thread[S64]()
    t4: Thread[S64] = get_thread[S64]()

    t1.put_work(entry: work.to[Callable](), args: xs)
    t2.put_work(entry: work.to[Callable](), args: xs)
    t3.put_work(entry: work.to[Callable](), args: xs)
    t4.put_work(entry: work.to[Callable](), args: xs)
    t1.wait_finished()
    t2.wait_finished()
    t3.wait_finished()
    t4.wait_finished()
    t1.give_back()
    t2.give_back()
    t3.give_back()
    t4.give_back()
    Console.show("count {xs.count()} (expected 40000)")
    drop xs
    return
