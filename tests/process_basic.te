# Standard/Os subprocesses: output and error captured, exit codes, arguments quoted for the child, environment
# overrides merged in, the working directory, a missing program, and env_var. The commands differ between cmd.exe
# and sh, so each OS gets its own. What is printed is the same.

import Standard/Alloc
import Standard/Format
import Standard/Os

### text without the line ending a shell's echo adds ("\n", or "\r\n" on Windows).
routine line(text: @[Byte]) -> @[Byte]
    if text.has_suffix("\r\n")
        return text.slice(start: 0, end: text.count() - 2)
    if text.has_suffix("\n")
        return text.slice(start: 0, end: text.count() - 1)
    else
        return text

routine error_name(e: ProcessError) -> @[Byte]
    when e
        ProcessError.NOT_FOUND => return "NotFound"
        ProcessError.PERMISSION_DENIED => return "PermissionDenied"
        ProcessError.INVALID_ARGUMENT => return "InvalidArgument"
        ProcessError.OUT_OF_MEMORY => return "OutOfMemory"
        ProcessError.OTHER => return "Other"

@target(os: "windows")
routine show_var() -> @[Byte]
    return "echo %TESSERA_PROBE%"

@target(os: not "windows")
routine show_var() -> @[Byte]
    return "echo \"$TESSERA_PROBE\""

@target(os: "windows")
routine show_dir() -> @[Byte]
    return "cd"

@target(os: not "windows")
routine show_dir() -> @[Byte]
    return "pwd"

### Runs a program that prints its arguments back, given "a b", c"d, and "": whether they arrived as given.
@target(os: "windows")
routine quoting_ok(alloc: @MemoryManager) -> Bool
    # cmd's echo prints its command line as it is, so the quoting itself shows
    local args: @Array[@[Byte], 5] <- ["/c", "echo", "a b", "c\"d", ""]
    local r: @ProcessOutput <- run_process_result(program: "cmd.exe", args: args.getview(),
        options: ProcessOptions.default(), alloc).unwrap()

    ok: Bool = line(r.stdout.getview()) == "\"a b\" \"c\\\"d\" \"\""
    drop r
    return ok

@target(os: not "windows")
routine quoting_ok(alloc: @MemoryManager) -> Bool
    local args: @Array[@[Byte], 6] <- ["-c", "printf '%s|' \"$@\"", "sh", "a b", "c\"d", ""]
    local r: @ProcessOutput <- run_process_result(program: "/bin/sh", args: args.getview(),
        options: ProcessOptions.default(), alloc).unwrap()

    ok: Bool = r.stdout.getview() == "a b|c\"d||"
    drop r
    return ok

routine options() -> ProcessOptions
    return ProcessOptions.default()

### Whether the variable `name` is set, its value read and dropped.
routine is_set(name: @[Byte], alloc: @MemoryManager) -> Bool
    when env_var(name, alloc)
        is Memory[Byte] as value =>
            drop value
            return true
        is None => return false

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()

    options: ProcessOptions = ProcessOptions.default()
    local hello: @ProcessOutput <- run_shell_result(command: "echo hello", options, alloc).unwrap()
    hello_status: ExitStatus = hello.status.peek()
    Out.write("echo: [{line(hello.stdout.getview())}], status {hello_status.code()}, success {hello_status.is_success()}\n")
    local three: @ProcessOutput <- run_shell_result(command: "exit 3", options, alloc).unwrap()
    three_status: ExitStatus = three.status.peek()
    Out.write("exit 3: status {three_status.code()}, success {three_status.is_success()}\n")
    local oops: @ProcessOutput <- run_shell_result(command: "echo oops>&2", options, alloc).unwrap()
    Out.write("stderr: [{line(oops.stderr.getview())}], stdout empty {oops.stdout.count() == 0}\n")
    Out.write("arguments as given: {quoting_ok(alloc)}\n")
    local vars: @Array[EnvVar, 1] <- [EnvVar(name: "TESSERA_PROBE", value: "a value, with commas")]
    with_env: ProcessOptions = ProcessOptions(directory: None(), env: vars.to[@EnvVar](),
        env_count: 1, stdin: InputMode.NULL, stdout: OutputMode.CAPTURE, stderr: OutputMode.CAPTURE)
    local r: @ProcessOutput <- run_shell_result(command: show_var(), options: with_env,
        alloc).unwrap()
    Out.write("override: [{line(r.stdout.getview())}]\n")
    path_set: Bool = is_set(name: "PATH", alloc)
    unset: Bool = not is_set(name: "TESSERA_NO_SUCH_VARIABLE", alloc)
    Out.write("PATH set: {path_set}, unset: {unset}\n")
    local tmp_dir: @Directory <- Directory.temp_result(alloc).unwrap()
    tmp: @[Byte] = tmp_dir.path.peek()
    name: @[Byte] = file_name(tmp)
    in_tmp: ProcessOptions = ProcessOptions(directory: tmp, env: null, env_count: 0,
        stdin: InputMode.NULL, stdout: OutputMode.CAPTURE, stderr: OutputMode.CAPTURE)
    local r2: @ProcessOutput <- run_shell_result(command: show_dir(), options: in_tmp,
        alloc).unwrap()
    here: Bool = line(r2.stdout.getview()).has_suffix(name)
    Out.write("directory: {here}\n")
    quiet: ProcessOptions = ProcessOptions(directory: None(), env: null, env_count: 0,
        stdin: InputMode.NULL, stdout: OutputMode.NULL, stderr: OutputMode.CAPTURE)
    local q: @ProcessOutput <- run_shell_result(command: "echo dropped", options: quiet,
        alloc).unwrap()
    Out.write("discarded output: empty {q.stdout.count() == 0}, status {q.status.peek().code()}\n")
    missing: ProcessError = run_process_result(program: "tessera-no-such-program", args: .hollow(),
        options: options(), alloc).unwrap_failure()
    Out.write("missing program: {error_name(missing)}\n")
    drop q
    drop r2
    drop tmp_dir
    drop r
    drop oops
    drop three
    drop hello
    return
