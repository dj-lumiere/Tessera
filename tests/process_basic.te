# Standard/Os subprocesses: output and error captured, exit codes, arguments quoted for the child, environment
# overrides merged in, the working directory, a missing program, and env_var. The commands differ between cmd.exe
# and sh, so each OS gets its own. What is printed is the same.

import Standard/Os

### text without the line ending a shell's echo adds ("\n", or "\r\n" on Windows).
routine line(text: @[Byte]) -> @[Byte]
    if text.has_suffix("\r\n")
        return text.slice(start: 0, end: text.count() - 2)
    if text.has_suffix("\n")
        return text.slice(start: 0, end: text.count() - 1)
    else
        return text

routine error_name(e: ProcessError) -> @[Byte]
    return e.name()

@target(os: "windows")
routine show_var() -> @[Byte]
    return "echo %TESSERA_PROBE%"

@target(os: not "windows")
routine show_var() -> @[Byte]
    return "echo \"$TESSERA_PROBE\""

@target(os: "windows")
routine show_dir() -> @[Byte]
    return "cd"

@target(os: not "windows")
routine show_dir() -> @[Byte]
    return "pwd"

### Runs a program that prints its arguments back, given "a b", c"d, and "": whether they arrived as given.
@target(os: "windows")
routine quoting_ok(alloc: @MemoryManager) -> Bool
    # cmd's echo prints its command line as it is, so the quoting itself shows
    local args: @Array[@[Byte], 5] <- ["/c", "echo", "a b", "c\"d", ""]
    local r: @ProcessOutput <- ProcessManager.create_process(program: "cmd.exe",
        args: args.getview(), options: ProcessOptions.default(), alloc)

    ok: Bool = line(r.stdout.getview()) == "\"a b\" \"c\\\"d\" \"\""
    drop r
    return ok

@target(os: not "windows")
routine quoting_ok(alloc: @MemoryManager) -> Bool
    local args: @Array[@[Byte], 6] <- ["-c", "printf '%s|' \"$@\"", "sh", "a b", "c\"d", ""]
    local r: @ProcessOutput <- ProcessManager.create_process(program: "/bin/sh",
        args: args.getview(), options: ProcessOptions.default(), alloc)

    ok: Bool = r.stdout.getview() == "a b|c\"d||"
    drop r
    return ok

routine options() -> ProcessOptions
    return ProcessOptions.default()

### Whether the variable `name` is set, its value read and dropped.
routine is_set(name: @[Byte], alloc: @MemoryManager) -> Bool
    when OsEnvironment.variable(name, alloc)
        is Memory[Byte] as value =>
            drop value
            return true
        is None => return false

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()

    options: ProcessOptions = ProcessOptions.default()
    local hello: @ProcessOutput <- ProcessManager.create_shell_process(command: "echo hello",
        options, alloc)
    hello_status: ExitStatus = hello.status.peek()
    Console.show("echo: [{line(hello.stdout.getview())}], status {hello_status.code()}, success {hello_status.is_success()}")
    local three: @ProcessOutput <- ProcessManager.create_shell_process(command: "exit 3", options,
        alloc)
    three_status: ExitStatus = three.status.peek()
    Console.show("exit 3: status {three_status.code()}, success {three_status.is_success()}")
    local oops: @ProcessOutput <- ProcessManager.create_shell_process(command: "echo oops>&2",
        options, alloc)
    Console.show("stderr: [{line(oops.stderr.getview())}], stdout empty {oops.stdout.count() == 0}")
    Console.show("arguments as given: {quoting_ok(alloc)}")
    local vars: @Array[EnvVar, 1] <- [EnvVar(name: "TESSERA_PROBE", value: "a value, with commas")]
    with_env: ProcessOptions = ProcessOptions(directory: None(), env: vars.to[@EnvVar](),
        env_count: 1, stdin: InputMode.NULL, stdout: OutputMode.CAPTURE, stderr: OutputMode.CAPTURE)
    local r: @ProcessOutput <- ProcessManager.create_shell_process(command: show_var(),
        options: with_env, alloc)
    Console.show("override: [{line(r.stdout.getview())}]")
    path_set: Bool = is_set(name: "PATH", alloc)
    unset: Bool = not is_set(name: "TESSERA_NO_SUCH_VARIABLE", alloc)
    Console.show("PATH set: {path_set}, unset: {unset}")
    local tmp_dir: @Directory <- OsEnvironment.temp_directory(alloc)
    tmp: @[Byte] = tmp_dir.path.peek()
    name: @[Byte] = tmp_dir.name()
    in_tmp: ProcessOptions = ProcessOptions(directory: tmp, env: .hollow(), env_count: 0,
        stdin: InputMode.NULL, stdout: OutputMode.CAPTURE, stderr: OutputMode.CAPTURE)
    local r2: @ProcessOutput <- ProcessManager.create_shell_process(command: show_dir(),
        options: in_tmp, alloc)
    here: Bool = line(r2.stdout.getview()).has_suffix(name)
    Console.show("directory: {here}")
    quiet: ProcessOptions = ProcessOptions(directory: None(), env: .hollow(), env_count: 0,
        stdin: InputMode.NULL, stdout: OutputMode.NULL, stderr: OutputMode.CAPTURE)
    local q: @ProcessOutput <- ProcessManager.create_shell_process(command: "echo dropped",
        options: quiet, alloc)
    Console.show("discarded output: empty {q.stdout.count() == 0}, status {q.status.peek().code()}")
    when check ProcessManager.create_process(program: "tessera-no-such-program", args: .hollow(),
        options: options(), alloc)
        is ProcessOutput as ran =>
            Console.show("missing program: ran")
            drop ran
        is ProcessError as missing => Console.show("missing program: {error_name(missing)}")
    drop q
    drop r2
    drop tmp_dir
    drop r
    drop oops
    drop three
    drop hello
    return
