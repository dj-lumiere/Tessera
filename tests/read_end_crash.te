# Console.ask[T]() stops the program at the end of the input with EndOfInputError, at the line of the call. Standard
# input is "5". try Console.ask[T]() and check Console.ask[T]() are the forms for reading to the end. This handler
# prints the crash and exits with status 3.

import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    first: S32 = Console.ask[S32]()
    Console.show("first: {first}")
    second: S32 = Console.ask[S32]()
    Console.show("second: {second}")
    return
