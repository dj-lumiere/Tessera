// Me is the type a routine is on, so no record takes that name.

record Me
    x: S64

/// Makes a `Me` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Me.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Me` holds no memory of its own.
routine Me.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    return()
