// 128-bit atomics need cmpxchg16b, which x86-64 has from v2 (--cpu x86-64-v2); the default CPU of every target
// here lacks a lock-free 128-bit atomic, so it is a build error, not a hidden libatomic lock.

routine main() -> S32
    block entry():
        claim %wide : @U128 <- uninit
        %old : U128 = %wide.atomic_fetch_add(1)
        return(0)
