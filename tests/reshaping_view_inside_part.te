# Changing the shape of a value held in a list slot moves that value's own memory: a view taken from inside it no
# longer sees it.

import Standard/Collections
import Standard/Os

### Takes a view of an element of the list in slot 0, then adds to that list.
routine start() -> None
    rows: &List[List[S64]] <- List[List[S64]].of(values: [List[S64].of(values: [1, 2])])
    row: @List[S64] = rows.getslot(0)
    cell: @S64 = row.getslot(0)
    row.add_last(3)
    v: S64 = cell.peek()
    Console.show("{v}")
    return
