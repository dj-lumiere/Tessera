// me is the type the routine is on, or a pointer to it.

record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.from_x(me: S64) -> Me
    return(Me(x: me))

routine start() -> Void
    p: Point = Point.from_x(3)
    return()
