// An #export definition and an #external declaration of the same C name are one routine: a call through the
// declaration, reached first, runs the definition.

import Standard::Format
import Standard::Os

#[external("c"), symbol("tess_twice")]
routine twice_c(x: S64) -> S64

#export("tess_twice")
routine twice(x: S64) -> S64
    block entry():
        return(x.mul(2))

routine main() -> S32
    block entry():
        a : S64 = twice_c(20)
        b : S64 = twice(a)
        Out.write("{a} {b}\n")
        return(0)
