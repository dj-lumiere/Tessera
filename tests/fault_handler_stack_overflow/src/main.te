# A fault handler set with CpuEventManager.when_faulted is told the address a memory fault touched, and
# CpuEvent.ran_out_of_stack tells a stack that ran out from other faults. This handler says so and ends the process
# itself with status 7.

import Hosted

### Calls itself, each frame holding a little memory.
### :param depth: How deep it is.
### :returns: Never.
routine deeper(depth: U64) -> U64
    frame: &Items[U64, 64] <- .hollow()

    frame.getslot(depth % 64).poke(depth)
    return deeper(depth + 1) + frame[0]

### Says whether the stack ran out, then ends the process with status 7.
### :param event: The fault.
routine on_fault(event: CpuEvent) -> None
    Console.show("fault: {event.kind == CpuEventKind.FAULT}, address given: {event.address.is_not_hollow()}, stack ran out: {event.ran_out_of_stack()}")
    ProcessManager.exit_process(7)

routine start() -> None
    before: Callable[(CpuEvent,), None] = CpuEventManager.when_faulted(on_fault.to[Callable]())
    Console.show("{deeper(0)}")
    return
