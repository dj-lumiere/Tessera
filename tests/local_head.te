# The head's shared lines run once when the routine starts, before entry: a value and a slot every block sees
# without passing them along. `jump entry()` runs entry again, never the head, so the counter shows one call.

import Standard/Os

global CALLS: @S64 <- 0

routine next_call() -> S64
    n: S64 = CALLS.peek() + 1
    n.poke_into(CALLS)
    return n

@generated
routine sum_to(limit: S64) -> S64
    local first: S64 = next_call()
    local total: @S64 <- 0
    local step: @S64 <- .hollow()

    first.poke_into(step)
    sum: S64 = total.peek() + step.peek()
    sum.poke_into(total)
    if sum >= limit
        jump done()
    else
        jump entry()

    block done()
        return total.peek()

# The values the head shares reach every block, with the routine's parameters, and claims there are slots of their own.
routine scale(values: @Array[S64, 4], factor: S64) -> S64
    local count: U64 = 4
    local sum: @S64 <- 0

    each i in 0 til count
        value: S64 = values[i]
        grown: S64 = sum.peek() + value * factor
        grown.poke_into(sum)
    then
        return sum.peek()

routine start() -> None
    local values: @Array[S64, 4] <- [1, 2, 3, 4]

    total: S64 = sum_to(5)
    Console.show("total {total}, calls {CALLS.peek()}")
    scaled: S64 = scale(values, factor: 3)
    Console.show("scaled {scaled}")
    return
