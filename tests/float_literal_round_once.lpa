# A decimal float literal goes into a B32 rounded once from its exact value. The first is just past the halfway point
# between 1.0 and the next B32, so it rounds up. Rounding through a B64 first lands on the halfway point and rounds
# down to 1.0. The second is exactly the halfway point and rounds to the even neighbour, 1.0.

import Hosted

routine start() -> None
    above: B32 = 1.0000000596046447753906251
    halfway: B32 = 1.000000059604644775390625
    Console.show("{above.bits()} {halfway.bits()}")
    return
