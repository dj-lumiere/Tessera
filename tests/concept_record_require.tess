/// A record's require clause is checked when its type is formed: PriorityQueue<T> needs Ordered<T>.
import Standard::Alloc
import Standard::Collections
import Standard::Os

record Job
    rank : U64

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        q : PriorityQueue<Job> = .construct(alloc)
        return(0)
