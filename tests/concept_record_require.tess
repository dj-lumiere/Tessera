/// A record's require clause is checked when its type is formed: PriorityQueue[TPriority, TElement] needs Comparable[TPriority].
import Standard/Alloc
import Standard/Collections
import Standard/Os

record Job
    rank: U64

/// Makes a `Job` from its fields.
/// :param rank: Its `rank`.
/// :returns: The new value.
routine Job.construct(rank: U64) -> Me
    return(Me(rank))

/// Releases nothing: a `Job` holds no memory of its own.
routine Job.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    q: PriorityQueue[Job, U64] = .construct(alloc)
    return()
