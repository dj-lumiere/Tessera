/// A record's require clause is checked when its type is formed: PriorityQueue<TPriority, TElement> needs Comparable<TPriority>.
import Standard::Alloc
import Standard::Collections
import Standard::Os

record Job
    rank : U64

routine start() -> Void
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        q : PriorityQueue<Job, U64> = .construct(alloc)
        return()
