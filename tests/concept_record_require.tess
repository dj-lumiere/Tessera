; A record's require clause is checked when its type is formed: PriorityQueue<T> needs Priority<T>.
record Job
    rank: U64

routine main() -> S32
    block entry():
        %heap: Allocator = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %q: PriorityQueue<Job> = PriorityQueue<Job>.new(#alloc)
        return(0)
