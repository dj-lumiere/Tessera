/// A record's require clause is checked when its type is formed: PriorityQueue<T> needs Priority<T>.
import Standard::Alloc
import Standard::Collections

record Job
    rank : U64

routine main() -> S32
    block entry():
        heap : Allocator = make_heap_allocator()
        claim alloc : Ptr<Allocator>
        alloc.store(heap)
        q : PriorityQueue<Job> = .construct(alloc)
        return(0)
