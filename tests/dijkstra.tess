// Dijkstra's shortest path
//
// Finds single-source shortest distances on a directed weighted graph.
//
// Stdlib used:
//   PriorityQueue[S64, USize]      min-heap of nodes keyed by tentative distance
//   List[Edge]                     per-node adjacency list
//
// Control flow highlights:
//   block-parameter loops for dist initialisation, edge relaxation, printing
//   inline branch terminator to drop stale priority-queue entries
//   pop_entry for the distance and the node together

import Standard/Alloc
import Standard/Collections
import Standard/Os

// ── C FFI ─────────────────────────────────────────────────────────────────────

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

// ── Types ─────────────────────────────────────────────────────────────────────

preset INF: S64 = S64.MAX  // the sentinel for "unreachable"

record Edge
    to: USize
    weight: S64

/// adj[u] is a separately heap-allocated List[Edge] reached through a pointer
/// slot.  Storing @List[Edge] (not List[Edge]) means loading adj[u] gives a
/// callable method receiver directly — no address-of-element operation needed.
record Graph
    adj: @List[@List[Edge]]
    num_nodes: USize

/// Makes a `Edge` from its fields.
/// :param to: Its `to`.
/// :param weight: Its `weight`.
/// :returns: The new value.
routine Edge.construct(to: USize, weight: S64) -> Me
    return(Me(to, weight))

/// Releases nothing: a `Edge` holds no memory of its own.
routine Edge.destruct(me: @Me) -> Void
    return()

// ── Graph ─────────────────────────────────────────────────────────────────────

routine Graph.construct(num_nodes: USize, alloc: @MemoryManager) -> Me
    local adj: @List[@List[Edge]] = allocate[List[@List[Edge]]](count: 1, alloc)

    adj_null: Bool = adj.is_null()
    branch adj_null
        ? crash_allocation()
        : continue
    adj_val: List[@List[Edge]] = .construct(alloc)
    adj.poke(adj_val)
    jump init_loop(0)

    block init_loop(i: USize)
        done: Bool = i.ge(num_nodes)
        branch done
            ? build()
            : make_list(i)

    block make_list(i: USize)
        list: @List[Edge] = allocate[List[Edge]](count: 1, alloc)
        list_null: Bool = list.is_null()
        branch list_null
            ? crash_allocation()
            : continue
        empty: List[Edge] = .construct(alloc)
        list.poke(empty)
        adj.add_last(list)
        jump init_loop(i.add(1))

    block build()
        g: Me = Me(adj: adj, num_nodes: num_nodes)
        return(g)

routine Graph.add_edge(me: @Me, from: USize, to: USize, weight: S64) -> Void
    adj: @List[@List[Edge]] = me.adj.peek()
    list: @List[Edge] = adj.getitem(from)
    edge: Edge = Edge(to: to, weight: weight)
    list.add_last(edge)
    return()

routine Graph.destruct(me: @Me, alloc: @MemoryManager) -> Void
    local n: USize = me.num_nodes.peek()
    local adj: @List[@List[Edge]] = me.adj.peek()

    jump free_loop(0)

    block free_loop(i: USize)
        done: Bool = i.ge(n)
        branch done
            ? free_outer()
            : free_one(i)

    block free_one(i: USize)
        list: @List[Edge] = adj.getitem(i)
        list.destruct()
        deallocate(data: list, alloc)
        jump free_loop(i.add(1))

    block free_outer()
        adj.destruct()
        deallocate(data: adj, alloc)
        return()

// ── Dijkstra ─────────────────────────────────────────────────────────────────
//
// dist must be caller-allocated with num_nodes elements.
// Fills it with shortest distances from source (INF where unreachable).
// Owns and frees the priority queue before returning.

routine dijkstra(graph:  @Graph, source: USize, dist:   @S64, alloc:  @MemoryManager) -> Void
    local n: USize = graph.num_nodes.peek()
    local pq: @PriorityQueue[S64, USize] <- .construct(alloc)

    jump fill_inf(0)

    // Phase 1 — initialise every distance slot to INF.
    block fill_inf(i: USize)
        done: Bool = i.ge(n)
        branch done
            ? seed()
            : write_inf(i)

    block write_inf(i: USize)
        dist.stride(i).poke(INF)
        jump fill_inf(i.add(1))

    // Phase 2 — set the source distance to 0 and seed the queue.
    block seed()
        dist.stride(source).poke(0)
        pq.add(priority: 0, element: source)
        jump main_loop()

    // Phase 3 — drain the queue, relaxing edges on each settled node.
    block main_loop()
        empty: Bool = pq.is_empty()
        branch empty
            ? done()
            : dequeue()

    block dequeue()
        top: PriorityEntry[S64, USize] = pq.remove_entry()
        d: S64 = top.priority
        u: USize = top.element
        best: S64 = dist.stride(u).peek()
        stale: Bool = d.gt(best)
        // re-push instead of decrease-key produces stale entries — drop them.
        branch stale
            ? main_loop()
            : scan(u, d)

    block scan(u: USize, d: S64)
        adj: @List[@List[Edge]] = graph.adj.peek()
        list: @List[Edge] = adj.getitem(u)
        len: USize = list.count()
        jump edge_loop(0, len, d, list)

    block edge_loop(i: USize, len: USize, d: S64, list: @List[Edge])
        done: Bool = i.ge(len)
        branch done
            ? main_loop()
            : relax(i, len, d, list)

    block relax(i: USize, len: USize, d: S64, list: @List[Edge])
        edge: Edge = list.getitem(i)
        v: USize = edge.to
        w: S64 = edge.weight
        new_dist: S64 = d.add(w)
        best: S64 = dist.stride(v).peek()
        better: Bool = new_dist.lt(best)
        branch better
            ? improve(i, len, d, list, v, new_dist) \
            : edge_loop(i.add(1), len, d, list)

    block improve(i: USize, len: USize, d: S64, list: @List[Edge], v: USize, new_dist: S64)
        dist.stride(v).poke(new_dist)
        pq.add(priority: new_dist, element: v)
        jump edge_loop(i.add(1), len, d, list)

    block done()
        pq.destruct()
        return()

// ── start ────────────────────────────────────────────────────────────────────
//
// Classic 6-node directed weighted graph:
//
//       7        10       11        6
//   0 ───> 1 ───> 2 ───> 3 ───> 4
//   |      |      |              |
//   | 9    | 15   | 2            | 9
//   v      v      v              v
//   2      3      5 <─────────── 5
//   |             ^
//   └─────14──────┘   (0 ──14──> 5)
//
// Expected shortest distances from node 0:
//   node 0:  0    (source)
//   node 1:  7    (0→1)
//   node 2:  9    (0→2)
//   node 3: 20    (0→2→3)
//   node 4: 26    (0→2→3→4)
//   node 5: 11    (0→2→5)

routine start() -> Void
    local alloc: @MemoryManager <- make_heap_memory()
    local g: Graph = .construct(num_nodes: 6, alloc)
    local graph: @Graph <- g
    local distances: @Slice[S64] <- .hollow()

    graph.add_edge(from: 0, to: 1,  weight: 7)
    graph.add_edge(from: 0, to: 2,  weight: 9)
    graph.add_edge(from: 0, to: 5, weight: 14)
    graph.add_edge(from: 1, to: 2, weight: 10)
    graph.add_edge(from: 1, to: 3, weight: 15)
    graph.add_edge(from: 2, to: 3, weight: 11)
    graph.add_edge(from: 2, to: 5,  weight: 2)
    graph.add_edge(from: 3, to: 4,  weight: 6)
    graph.add_edge(from: 4, to: 5,  weight: 9)

    distances.poke(.construct(count: 6, alloc))
    dist: @S64 = distances.to[@S64]()
    dijkstra(graph, source: 0, dist, alloc)

    c_printf("Shortest distances from node 0:\n")
    jump print_loop(0)

    block print_loop(i: USize)
        done: Bool = i.ge(6)
        branch done
            ? cleanup()
            : print_one(i)

    block print_one(i: USize)
        d: S64 = distances.getitem(i)
        c_printf("  node %zu  dist %lld\n", i, d)
        jump print_loop(i.add(1))

    block cleanup()
        graph.destruct(alloc)
        distances.destruct()
        return()
