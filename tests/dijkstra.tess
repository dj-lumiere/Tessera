// Dijkstra's shortest path
//
// Finds single-source shortest distances on a directed weighted graph.
//
// Stdlib used:
//   PriorityQueue<DijkstraEntry>   min-heap keyed by tentative distance
//   List<Edge>                     per-node adjacency list
//
// Control flow highlights:
//   block-parameter loops for dist initialisation, edge relaxation, printing
//   inline branch terminator to drop stale priority-queue entries
//   Priority<DijkstraEntry> concept for the min-heap ordering

import Standard::Alloc
import Standard::Collections
import Standard::Os

// ── C FFI ─────────────────────────────────────────────────────────────────────

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

// ── Types ─────────────────────────────────────────────────────────────────────

preset INF: S64 = S64.MAX  // the sentinel for "unreachable"

record Edge
    to     : USize
    weight : S64

/// adj[u] is a separately heap-allocated List<Edge> reached through a pointer
/// slot.  Storing @List<Edge> (not List<Edge>) means loading adj[u] gives a
/// callable method receiver directly — no address-of-element operation needed.
record Graph
    adj       : @List<@List<Edge>>
    num_nodes : USize

record DijkstraEntry
conform Priority<DijkstraEntry>
    dist : S64
    node : USize

// ── Priority<DijkstraEntry> ───────────────────────────────────────────────────

/// Lower distance = higher priority.
routine DijkstraEntry.less(self: Self, other: Self) -> Bool
    block entry()
        a_dist : S64  = self.dist
        b_dist : S64  = other.dist
        result : Bool = a_dist.lt(b_dist)
        return(result)

// ── Graph ─────────────────────────────────────────────────────────────────────

routine Graph.construct(num_nodes: USize, alloc: @Allocator) -> Self
    block entry()
        adj      : @List<@List<Edge>> = allocate<List<@List<Edge>>>(alloc, 1)
        adj_null : Bool               = adj.is_null()
        branch adj_null
            ? panic_allocation()
            : continue
        adj_val : List<@List<Edge>> = .construct(alloc)
        adj.store(adj_val)
        jump init_loop(0, adj)

    block init_loop(i: USize, adj: @List<@List<Edge>>)
        done : Bool = i.ge(num_nodes)
        branch done
            ? build(adj)
            : make_list(i, adj)

    block make_list(i: USize, adj: @List<@List<Edge>>)
        list      : @List<Edge> = allocate<List<Edge>>(alloc, 1)
        list_null : Bool        = list.is_null()
        branch list_null
            ? panic_allocation()
            : continue
        empty : List<Edge> = .construct(alloc)
        list.store(empty)
        adj.push(list)
        jump init_loop(i.add(1), adj)

    block build(adj: @List<@List<Edge>>)
        g : Self = Self { adj: adj, num_nodes: num_nodes }
        return(g)

routine Graph.add_edge(self: @Self, from: USize, to: USize, weight: S64) -> Void
    block entry()
        adj  : @List<@List<Edge>> = self.adj.load()
        list : @List<Edge>        = adj.load().get(from)
        edge : Edge               = Edge { to: to, weight: weight }
        list.push(edge)
        return()

routine Graph.destruct(self: @Self, alloc: @Allocator) -> Void
    block entry()
        n   : USize              = self.num_nodes.load()
        adj : @List<@List<Edge>> = self.adj.load()
        jump free_loop(0, n, adj)

    block free_loop(i: USize, n: USize, adj: @List<@List<Edge>>)
        done : Bool = i.ge(n)
        branch done
            ? free_outer(adj)
            : free_one(i, n, adj)

    block free_one(i: USize, n: USize, adj: @List<@List<Edge>>)
        list : @List<Edge> = adj.load().get(i)
        list.destruct()
        list.free(alloc)
        jump free_loop(i.add(1), n, adj)

    block free_outer(adj: @List<@List<Edge>>)
        adj.destruct()
        adj.free(alloc)
        return()

// ── Dijkstra ─────────────────────────────────────────────────────────────────
//
// dist must be caller-allocated with num_nodes elements.
// Fills it with shortest distances from source (INF where unreachable).
// Owns and frees the priority queue before returning.

routine dijkstra(graph:  @Graph, source: USize, dist:   @S64, alloc:  @Allocator) -> Void
    block entry()
        n : USize = graph.num_nodes.load()
        claim pq : @PriorityQueue<DijkstraEntry> <- .construct(alloc)
        jump fill_inf(0, n, pq)

    // Phase 1 — initialise every distance slot to INF.
    block fill_inf(i: USize, n: USize, pq: @PriorityQueue<DijkstraEntry>)
        done : Bool = i.ge(n)
        branch done
            ? seed(pq)
            : write_inf(i, n, pq)

    block write_inf(i: USize, n: USize, pq: @PriorityQueue<DijkstraEntry>)
        dist.stride(i).store(INF)
        jump fill_inf(i.add(1), n, pq)

    // Phase 2 — set the source distance to 0 and seed the queue.
    block seed(pq: @PriorityQueue<DijkstraEntry>)
        dist.stride(source).store(0)
        first : DijkstraEntry = DijkstraEntry { dist: 0, node: source }
        pq.push(first)
        jump main_loop(pq)

    // Phase 3 — drain the queue, relaxing edges on each settled node.
    block main_loop(pq: @PriorityQueue<DijkstraEntry>)
        empty : Bool = pq.load().is_empty()
        branch empty
            ? done(pq)
            : dequeue(pq)

    block dequeue(pq: @PriorityQueue<DijkstraEntry>)
        entry : DijkstraEntry = pq.pop()
        d     : S64           = entry.dist
        u     : USize         = entry.node
        best  : S64           = dist.stride(u).load()
        stale : Bool          = d.gt(best)
        // re-push instead of decrease-key produces stale entries — drop them.
        branch stale
            ? main_loop(pq)
            : scan(u, d, pq)

    block scan(u: USize, d: S64, pq: @PriorityQueue<DijkstraEntry>)
        adj  : @List<@List<Edge>> = graph.adj.load()
        list : @List<Edge>        = adj.load().get(u)
        len  : USize              = list.load().length()
        jump edge_loop(0, len, d, list, pq)

    block edge_loop(i: USize, len: USize, d: S64, list: @List<Edge>,
        pq: @PriorityQueue<DijkstraEntry>)
        done : Bool = i.ge(len)
        branch done
            ? main_loop(pq)
            : relax(i, len, d, list, pq)

    block relax(i: USize, len: USize, d: S64, list: @List<Edge>, pq: @PriorityQueue<DijkstraEntry>)
        edge     : Edge  = list.load().get(i)
        v        : USize = edge.to
        w        : S64   = edge.weight
        new_dist : S64   = d.add(w)
        best     : S64   = dist.stride(v).load()
        better   : Bool  = new_dist.lt(best)
        branch better
            ? improve(i, len, d, list, pq, v, new_dist) \
            : edge_loop(i.add(1), len, d, list, pq)

    block improve(i: USize, len: USize, d: S64, list: @List<Edge>,
        pq:   @PriorityQueue<DijkstraEntry>, v: USize, new_dist: S64)
        dist.stride(v).store(new_dist)
        entry : DijkstraEntry = DijkstraEntry { dist: new_dist, node: v }
        pq.push(entry)
        jump edge_loop(i.add(1), len, d, list, pq)

    block done(pq: @PriorityQueue<DijkstraEntry>)
        pq.destruct()
        return()

// ── main ─────────────────────────────────────────────────────────────────────
//
// Classic 6-node directed weighted graph:
//
//       7        10       11        6
//   0 ───> 1 ───> 2 ───> 3 ───> 4
//   |      |      |              |
//   | 9    | 15   | 2            | 9
//   v      v      v              v
//   2      3      5 <─────────── 5
//   |             ^
//   └─────14──────┘   (0 ──14──> 5)
//
// Expected shortest distances from node 0:
//   node 0:  0    (source)
//   node 1:  7    (0→1)
//   node 2:  9    (0→2)
//   node 3: 20    (0→2→3)
//   node 4: 26    (0→2→3→4)
//   node 5: 11    (0→2→5)

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        g : Graph = .construct(6, alloc)
        claim graph : @Graph <- g

        graph.add_edge(0, 1,  7)
        graph.add_edge(0, 2,  9)
        graph.add_edge(0, 5, 14)
        graph.add_edge(1, 2, 10)
        graph.add_edge(1, 3, 15)
        graph.add_edge(2, 3, 11)
        graph.add_edge(2, 5,  2)
        graph.add_edge(3, 4,  6)
        graph.add_edge(4, 5,  9)

        dist : @S64 = allocate<S64>(alloc, 6)
        dijkstra(graph, 0, dist, alloc)

        c_printf("Shortest distances from node 0:\n")
        jump print_loop(0, dist, graph, alloc)

    block print_loop(i: USize, dist: @S64, graph: @Graph, alloc: @Allocator)
        done : Bool = i.ge(6)
        branch done
            ? cleanup(dist, graph, alloc)
            : print_one(i, dist, graph, alloc)

    block print_one(i: USize, dist: @S64, graph: @Graph, alloc: @Allocator)
        d : S64 = dist.stride(i).load()
        c_printf("  node %zu  dist %lld\n", i, d)
        jump print_loop(i.add(1), dist, graph, alloc)

    block cleanup(dist: @S64, graph: @Graph, alloc: @Allocator)
        graph.destruct(alloc)
        dist.free(alloc)
        return(0)
