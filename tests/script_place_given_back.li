# A script's places borrowed from STACK are given back at the end of the file, its return. A `<-` line may follow a
# declaration directly.

import Collections
import Hosted

### A pair.
record Pair
    left: S64
    right: S64

list: &List[S64] <- .construct(HEAP)
list.add_last(1)
pair: &Pair <- Pair(left: 2, right: 3)
Console.show("{list} {pair.load().right}")
