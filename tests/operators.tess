// Operators: precedence, chained comparisons, and / or that stop early, overflow forms, indexing.

import Standard/Format
import Standard/Os

global CALLS: @S64 <- 0

routine noted(value: Bool) -> Bool
    (CALLS.peek() + 1).poke_into(CALLS)
    return value

routine start() -> None
    out: @Out = Out.writer()
    a: S64 = 7
    b: S64 = 3
    out.write("{a + b * 2} {(a + b) * 2} {a - b - 1} {2 ** 3 ** 2} {-a ** 2} {a % b} {a / b}\n")
    out.write("{a > b and b > 1} {a < b or b < 1} {not a < b} {1 < b < a} {1 < b <= 3 < a}\n")
    x: U8 = 250
    out.write("{x +% 10} {x +^ 10} {x *% 2} {x *^ 2} {(x -% 251)}\n")
    out.write("{0xF0 & 0x3C} {0xF0 | 0x0F} {0xF0 ^ 0xFF} {1 << 4} {-16 >> 2} {(1 & 1) == 1}\n")
    local data: Span[S64] <- [10, 20, 30]
    data[1] = 25
    out.write("{data[0] + data[1] + data[2]}\n")
    // the right side of `or` runs only when the left side is false
    first: Bool = noted(true) or noted(true)
    second: Bool = noted(false) and noted(true)
    out.write("{first} {second} {CALLS.peek()}\n")
    out.write("{a <=> b} {b <=> a} {a <=> a}\n")
    return
