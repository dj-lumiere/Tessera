# An argument's name picks among overloads before a literal argument takes its type: `pad(width: 2)` can only be
# `pad(width: U8)`, though the literal fits `pad(count: U16)` too.
import Ingrid/Decimal
import Standard/Os

### Pads to a width.
### :param width: The width.
### :returns: A tag for this overload.
routine pad(width: U8) -> U8
    return width

### Pads by a count.
### :param count: The count.
### :returns: A tag for this overload.
routine pad(count: U16) -> U8
    return 100

### A size to grow by.
record Size
    n: U64

### Grows by a step.
### :param step: The step.
### :returns: A tag for this overload.
routine Size.grow(step: U32) -> U64
    return me.n + 1

### Grows by a factor.
### :param factor: The factor.
### :returns: A tag for this overload.
routine Size.grow(factor: U64) -> U64
    return me.n * 10

routine start() -> None
    width: U8 = 2
    count: U16 = 3
    Console.show("{pad(width: 2)} {pad(count: 3)} {pad(width: width)} {pad(count: count)} {pad(width)} {pad(count)}")
    s: Size = Size(n: 5)
    factor: U64 = 3
    Console.show("{s.grow(step: 1)} {s.grow(factor: 3)} {s.grow(factor: factor)}")
    price: Decimal = "2.675".to[Decimal]()
    Console.show("{price.round(places: 2)} {price.round(rule: RoundingRule.TRUNC)}")
    return
