### Conformances that hold: a record's own, a conditional one, a concept that only groups others (HashEquatable,
### which Dict needs), a marker concept with no routines, and a top-level conform for a type declared elsewhere.
import Collections
import Hosted

record Point
obeys Equatable[Point], Hashable[Point]
    x: S64
    y: S64

protocol Sendable[T]

obeys Sendable[U64]

routine Point.eq(other: Me) -> Bool
    return me.x == other.x and me.y == other.y

routine Point.hash() -> U64
    r: U64 = me.x.hash() ^ me.y.hash()
    return r

routine same[T](a: T, b: T) -> Bool
needs T obeys Equatable
    return a == b

routine send[T](v: T) -> T
needs T obeys Sendable
    return v

routine show(b: Bool) -> None
    Console.show("{b.to[U64]()}")
    return

routine start() -> None
    p: Point = Point(x: 1, y: 2)
    q: Point = Point(x: 1, y: 3)
    show(same(a: p, b: p))
    show(same(a: p, b: q))
    some: Optional[Point] = p
    show(same(a: some, b: some))
    manager: @MemoryManager = HEAP
    d: &Dict[Point, U64] <- .construct(manager)
    d[p] = 7
    show(d.has_key(p))
    drop d
    v: U64 = send(9)
    Console.show("{v}")
    return
