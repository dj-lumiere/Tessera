# Many entities of two types fill several chunks and cross the committed pages: every other one is removed and swept,
# the freed slots are reused, and the stamps still read what was stored.

import Collections
import Hosted

### A node that keeps a number.
entity Node
    value: S64

### Makes a node.
### :param value: Its number.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### A bigger second type.
record Wide
    a: S64
    b: S64
    c: S64
    d: S64

### Adds, removes, sweeps and adds again.
routine start() -> None
    pool: &EntityPool <- EntityPool.set_up(memory: PAGES)
    nodes: &List[PoolStamp[Node]] <- .construct(HEAP)
    wides: &List[PoolStamp[Wide]] <- .construct(HEAP)
    for i in 0 til 20000
        nodes.add_last(EntityPool.add(Node.construct(value: i.to[S64]())))
        if i % 4 == 0
            wides.add_last(EntityPool.add(Wide(a: i.to[S64](), b: 1, c: 2, d: 3)))
    for i in 0 til 20000
        if i % 2 == 0
            EntityPool.remove(nodes[i.to[U64]()])
    EntityPool.sweep()
    for i in 0 til 10000
        nodes.add_last(EntityPool.add(Node.construct(value: 100000 + i.to[S64]())))
    for i in 0 til nodes.count() with live: U64 = 0, sum: S64 = 0
        when try nodes[i].fetch()
            is @Node as n => continue with live: live + 1, sum: sum + n.value.peek()
            is None => continue with live: live, sum: sum
    then
        Console.show("live {live} sum {sum}")
    for i in 0 til wides.count() with total: S64 = 0
        continue with total: total + wides[i].fetch().a.peek() + wides[i].fetch().d.peek()
    then
        Console.show("wide {total}")
    drop nodes
    drop wides
    drop pool
    return
