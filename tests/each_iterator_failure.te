# each takes an emitter's end, its AbsentValueError, and nothing else: another failure of emit stops the program on
# the each line, the way a bare call of emit would.

import Hosted

### A failure partway through.
crashable SensorError
    reading: U64

### Hands out readings 0, 1, 2, and fails on the third.
record Readings
obeys Emitter[U64, Readings]
    next: U64

### Writes which reading failed.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine SensorError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("Reading {me.reading} failed.")
    return

### The next reading.
### :returns: The reading.
### :throws: Throws `SensorError` on reading 3, and `AbsentValueError` after reading 5.
failable routine @Readings.emit() -> U64
    at: U64 = me.next.peek()
    if at == 3
        throw SensorError(reading: at)
    if at > 5
        throw AbsentValueError()
    me.next.poke(at + 1)
    return at

routine start() -> None
    readings: &Readings <- Readings(next: 0)

    each r in readings
        Console.show("reading {r}")
    then
        Console.show("not reached")
    return
