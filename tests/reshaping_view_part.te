# Changing the shape of a value held in a list slot moves only that value's own memory: a view of the slot, and views
# of the other slots, still see their memory. A list literal broken over lines may end with a comma.

import Collections
import Hosted

### Adds to the dict in slot 0 through one view of the slot, then reads the dict in slot 1 through a view taken first.
routine start() -> None
    sets: &List[Dict[S32, S32]] <- List[Dict[S32, S32]].of(values: [
        Dict[S32, S32].of(values: [(1, 10)], manager: HEAP),
        Dict[S32, S32].of(values: [(2, 20), (3, 30)], manager: HEAP),
    ], manager: HEAP)
    other: @Dict[S32, S32] = sets.getslot(1)
    first: @Dict[S32, S32] = sets.getslot(0)
    low: S32 = 4
    high: S32 = 40
    each key in low til high
        first.setitem(key: key, value: key)
    Console.show("{first.count()} {other.count()} {other.getitem(2)}")
    rows: &List[List[S64]] <- List[List[S64]].of(values: [
        List[S64].of(values: [1, 2], manager: HEAP),
        List[S64].of(values: [3], manager: HEAP),
    ], manager: HEAP)
    row: @List[S64] = rows.getslot(0)
    second: @List[S64] = rows.getslot(1)
    each n in 0 til 20
        row.add_last(n)
    Console.show("{row.count()} {second.count()} {second.getitem(0)}")
    return
