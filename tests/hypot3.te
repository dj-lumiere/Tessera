        y: 0x7FE5BF78078E2649, z: 0x7FDFD6BD463DA4DE)
    show_b64(name: "just above the overflow threshold", x: 0x7FE2EE125EAC335C,
        y: 0x7FE1FC41FD25AF7D, z: 0x7FE27F882E608E3D)
    show_b64(name: "three subnormals", x: 0x80035ACF3DAB50B8, y: 0x80086CDBDB0102DE,
        z: 0x000CAABA36165514)
    show_b64(name: "MAX, smallest subnormal, 1", x: 0x7FEFFFFFFFFFFFFF, y: 0x0000000000000001,
        z: 0x3FF0000000000000)
    show_b64(name: "-0, +0, -0", x: 0x8000000000000000, y: 0x0000000000000000,
        z: 0x8000000000000000)
    show_b64(name: "1, -inf, qNaN", x: 0x3FF0000000000000, y: 0xFFF0000000000000,
