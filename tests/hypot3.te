# The three-leg hypot sqrt(x^2 + y^2 + z^2), correctly rounded, for every binary float format: an exact result,
# an exact midpoint (ties to even), a midpoint that a tiny third leg pushes up, both sides of the overflow threshold,
# subnormal legs, mixed extremes, signed zeros, and the NaN and infinity rules (an infinite leg wins over a quiet NaN,
# a signaling NaN wins over an infinite leg, a NaN result is the first NaN leg quieted). Every answer was checked
# against an exact integer oracle. BF16 leaves out the signaling NaN beside an infinite leg: a debug build on x86_64
# passes a BF16 signaling NaN between routines quieted.

import Standard/Hosted

### Writes `name` and the bits of hypot(`x`, `y`, `z`) for the B16 legs with bits `x`, `y` and `z`, in hex.
### :param name: The case.
### :param x: The first leg's bits.
### :param y: The second leg's bits.
### :param z: The third leg's bits.
routine show_b16(name: @[Byte], x: U16, y: U16, z: U16) -> None
    r: B16 = hypot_unchecked(x: B16.from_bits(x), y: B16.from_bits(y), z: B16.from_bits(z))
    Console.show("  {name}: ", end: "")
    r.bits().represent_hex_into(Console.output())
    Console.show("")
    return

### Writes `name` and the bits of hypot(`x`, `y`, `z`) for the BF16 legs with bits `x`, `y` and `z`, in hex.
### :param name: The case.
### :param x: The first leg's bits.
### :param y: The second leg's bits.
### :param z: The third leg's bits.
routine show_bf16(name: @[Byte], x: U16, y: U16, z: U16) -> None
    r: BF16 = hypot_unchecked(x: BF16.from_bits(x), y: BF16.from_bits(y), z: BF16.from_bits(z))
    Console.show("  {name}: ", end: "")
    r.bits().represent_hex_into(Console.output())
    Console.show("")
    return

