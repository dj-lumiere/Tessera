    show_b64(name: "midpoint tie", x: 0x43054716A2DC6074, y: 0x42F836ABE05856CC,
        z: 0xC2F2D13720C0A01B)
    show_b64(name: "midpoint, no third leg", x: 0x49347461D6158450, y: 0x48FCA2C020C28F38,
        z: 0x0000000000000000)
    show_b64(name: "midpoint, smallest third leg", x: 0x49347461D6158450, y: 0x48FCA2C020C28F38,
