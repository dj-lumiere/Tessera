    Console.show("B128")
    show_b128(name: "3, -4, 12", x: 0x40008000000000000000000000000000,
        y: 0xC0010000000000000000000000000000, z: 0x40028000000000000000000000000000)
    show_b128(name: "midpoint tie", x: 0x5A7D7B443A739C569F6DE83BBB5C2B02,
        y: 0x5A7E4C3C9AD659B6A34948CFEBBCA1D7, z: 0x5A7D2247F68E7C11B6175782B6756175)
    show_b128(name: "midpoint, no third leg", x: 0x56B2B0442B82CD565355D4E18CFC41C8,
        y: 0x56B222470AD757303D1C57F419A6E147, z: 0x00000000000000000000000000000000)
    show_b128(name: "midpoint, smallest third leg", x: 0x56B2B0442B82CD565355D4E18CFC41C8,
        y: 0x56B222470AD757303D1C57F419A6E147, z: 0x00000000000000000000000000000001)
    show_b128(name: "just below the overflow threshold", x: 0x7FFDFE4451E0D7DA376B9DC52F83B200,
        y: 0xFFFE39EC7A65E4E4A981DDF8EEC88DFE, z: 0x7FFE39DA0104A2FF208E7C041148DA6A)
    show_b128(name: "just above the overflow threshold", x: 0xFFFEA69EAA2939CFB13CE642DE1CFB0A,
        y: 0x7FFCD6B867F15E63334BE8B4A9DBC044, z: 0x7FFE07FC14947B78F131EE04BFF2A933)
    show_b128(name: "three subnormals", x: 0x0000DD9A58FE9057437EF300B19037A2,
