### Writes `name` and the bits of hypot(`x`, `y`, `z`) for the B64 legs with bits `x`, `y` and `z`, in hex.
### :param name: The case.
### :param x: The first leg's bits.
### :param y: The second leg's bits.
### :param z: The third leg's bits.
routine show_b64(name: @[Byte], x: U64, y: U64, z: U64) -> None
    r: B64 = hypot_unchecked(x: B64.from_bits(x), y: B64.from_bits(y), z: B64.from_bits(z))
    Console.show("  {name}: ", end: "")
    r.bits().represent_hex_into(Console.output())
    Console.show("")
    return

### Writes `name` and the bits of hypot(`x`, `y`, `z`) for the B128 legs with bits `x`, `y` and `z`, in hex.
### :param name: The case.
### :param x: The first leg's bits.
### :param y: The second leg's bits.
### :param z: The third leg's bits.
routine show_b128(name: @[Byte], x: U128, y: U128, z: U128) -> None
    r: B128 = hypot_unchecked(x: b128_of(x), y: b128_of(y), z: b128_of(z))
    Console.show("  {name}: ", end: "")
    r.bits().represent_hex_into(Console.output())
    Console.show("")
    return

routine start() -> None
    Console.show("B16")
    show_b16(name: "3, -4, 12", x: 0x4200, y: 0xC400, z: 0x4A00)
    show_b16(name: "midpoint tie", x: 0xCF7B, y: 0xCEF2, z: 0x4C6A)
    show_b16(name: "midpoint, no third leg", x: 0x7536, y: 0x70FB, z: 0x0000)
    show_b16(name: "midpoint, smallest third leg", x: 0x7536, y: 0x70FB, z: 0x0001)
    show_b16(name: "just below the overflow threshold", x: 0xF8D2, y: 0xF6E0, z: 0x7960)
    show_b16(name: "just above the overflow threshold", x: 0xF782, y: 0xFAE1, z: 0x7268)
    show_b16(name: "three subnormals", x: 0x8353, y: 0x01D4, z: 0x8064)
    show_b16(name: "MAX, smallest subnormal, 1", x: 0x7BFF, y: 0x0001, z: 0x3C00)
    show_b16(name: "-0, +0, -0", x: 0x8000, y: 0x0000, z: 0x8000)
    show_b16(name: "1, -inf, qNaN", x: 0x3C00, y: 0xFC00, z: 0x7E05)
    show_b16(name: "1, qNaN, -qNaN", x: 0x3C00, y: 0x7E05, z: 0xFE09)
    show_b16(name: "inf, 1, sNaN", x: 0x7C00, y: 0x3C00, z: 0x7C03)
    show_b16(name: "sNaN, qNaN, 1", x: 0x7C03, y: 0x7E05, z: 0x3C00)

    Console.show("BF16")
    show_bf16(name: "3, -4, 12", x: 0x4040, y: 0xC080, z: 0x4140)
    show_bf16(name: "midpoint tie", x: 0xDF60, y: 0xDF01, z: 0x5F7C)
    show_bf16(name: "midpoint, no third leg", x: 0x2CA2, y: 0x2C73, z: 0x0000)
    show_bf16(name: "midpoint, smallest third leg", x: 0x2CA2, y: 0x2C73, z: 0x0001)
    show_bf16(name: "just below the overflow threshold", x: 0x7F0D, y: 0xFF11, z: 0xFF1B)
    show_bf16(name: "just above the overflow threshold", x: 0xFF01, y: 0xFF58, z: 0x7E34)
    show_bf16(name: "three subnormals", x: 0x0029, y: 0x8038, z: 0x0065)
    show_bf16(name: "MAX, smallest subnormal, 1", x: 0x7F7F, y: 0x0001, z: 0x3F80)
    show_bf16(name: "-0, +0, -0", x: 0x8000, y: 0x0000, z: 0x8000)
    show_bf16(name: "1, -inf, qNaN", x: 0x3F80, y: 0xFF80, z: 0x7FC5)
    show_bf16(name: "1, qNaN, -qNaN", x: 0x3F80, y: 0x7FC5, z: 0xFFC9)
    show_bf16(name: "sNaN, qNaN, 1", x: 0x7F83, y: 0x7FC5, z: 0x3F80)

    Console.show("B32")
    show_b32(name: "3, -4, 12", x: 0x40400000, y: 0xC0800000, z: 0x41400000)
    show_b32(name: "midpoint tie", x: 0x556AF978, y: 0xD42128B4, z: 0x55865864)
    show_b32(name: "midpoint, no third leg", x: 0x434FFCCC, y: 0x431A05FB, z: 0x00000000)
    show_b32(name: "midpoint, smallest third leg", x: 0x434FFCCC, y: 0x431A05FB, z: 0x00000001)
    show_b32(name: "just below the overflow threshold", x: 0x7F59ADB5, y: 0xFED7DF7C, z: 0xFEA14456)
    show_b32(name: "just above the overflow threshold", x: 0xFF4FEBEC, y: 0x7E406978, z: 0x7F0D6378)
    show_b32(name: "three subnormals", x: 0x8065CE90, y: 0x801616DD, z: 0x002FB7B5)
    show_b32(name: "MAX, smallest subnormal, 1", x: 0x7F7FFFFF, y: 0x00000001, z: 0x3F800000)
    show_b32(name: "-0, +0, -0", x: 0x80000000, y: 0x00000000, z: 0x80000000)
    show_b32(name: "1, -inf, qNaN", x: 0x3F800000, y: 0xFF800000, z: 0x7FC00005)
    show_b32(name: "1, qNaN, -qNaN", x: 0x3F800000, y: 0x7FC00005, z: 0xFFC00009)
    show_b32(name: "inf, 1, sNaN", x: 0x7F800000, y: 0x3F800000, z: 0x7F800003)
    show_b32(name: "sNaN, qNaN, 1", x: 0x7F800003, y: 0x7FC00005, z: 0x3F800000)

    Console.show("B64")
