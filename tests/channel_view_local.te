# A channel hands its values to another thread or fiber, so a view of memory that ends in the routine can't go in:
# the receiver could read it after the memory is given back. The error points to handing the memory over with steal.

import Hosted

### Transmits a view of a line from the heap.
routine start() -> None
    ch: &Channel[@[Byte]] <- .construct(capacity: 4)
    line: &[Byte] <- [b'a', b'b'] from HEAP
    ch.transmit(line.getslice())
    drop line
    drop ch
    return
