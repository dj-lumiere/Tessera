# A routine returns an entity that holds the address of its frame slot.

import Standard/Os

### Holds an address.
entity Q
    ### The address.
    held: @S64

### Makes one.
### :returns: The holder.
common routine Q.construct() -> Me
    return Me(held: .hollow())

### Gives the holder back.
routine @Q.destruct() -> None
    return

### Makes a holder of a frame slot.
### :returns: The holder.
routine make() -> Q
    l: &S64 <- 5
    q: &Q <- .construct()

    q.held.poke(l)
    return q

### Runs.
routine start() -> None
    q: &Q <- make()

    drop q
    return
