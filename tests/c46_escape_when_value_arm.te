# A value when whose arm gives a frame slot's address, returned (Rust #46557 in Tessera).

import Hosted

### Gives the address of a local, or the address it is handed.
### :param q: An address.
### :param flag: Whether to give the local's.
### :returns: One of the two addresses.
routine choose(q: @S64, flag: Bool) -> @S64
    l: &S64 <- 1234567

    return when
        flag => l.getview()
        else => q

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    each i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    each j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    other: &S64 <- 1
    p: @S64 = choose(q: other, flag: true)
    s: S64 = scribble(seed: 6666666)
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
