# Keeping the address of a @threadlocal in a plain global is a build error: every thread reaches the global, and the
# address is one thread's copy, gone once that thread ends.
module C84/ThreadlocalInGlobal
import Standard/Hosted

@threadlocal
global COUNTER: &S64 <- 1234567

global KEPT: &@S64 <- .hollow()

### Keeps the thread's own counter address in a plain global.
### :param n: Unused.
### :returns: 0.
routine keep(n: S64) -> S64
    KEPT.poke(COUNTER)
    return 0

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    work_t: Work[S64] = keep.to[Work](n: 0)
    t.put_work(work_t)
    t.retrieve()
    drop t
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, the thread is gone)")
    return
