# A program replaces the default crash handler by exporting its own under the handler's name. This one reports the
# name and message on stdout and exits with status 3 instead of 101.

import Standard/Collections
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("crashed: {name}: {message.text()}")
    exit(3)

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local list: @List[S64] <- .construct(alloc)

    Crash.report_with(on_crash.to[Callable]())
    Console.show("before")
    missing: S64 = list.remove_last()
    Console.show("not reached")
    drop list
    return
