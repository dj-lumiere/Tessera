// Tuples nest: a tuple of tuples types, builds, compares, and prints item by item, and it comes apart one level
// at a time.

import Standard::Format
import Standard::Os

routine corners() -> ((S64, S64), (S64, S64))
    block entry()
        return({ { 0, 0 }, { 3, 4 } })

routine start() -> Void
    block entry()
        box : ((S64, S64), (S64, S64)) = corners()
        low, high = box
        x, y = high
        deep : (((S64, Bool), Bytes), U8) = { { { 1, true }, "a" }, 9 }
        same : Bool                       = box.eq(corners())
        Out.write("{box} -> {low} {high} -> {x},{y}; {deep}; eq {same}; cmp {box.compare({ { 0, 0 }, { 3, 5 } })}\n")
        return()
