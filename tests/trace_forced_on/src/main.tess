// [debug] trace = true keeps the crash trace in release-space, which leaves it out by default. The trace is there
// outside a crash too: a routine reads its own frame and its caller's.

import Standard::Format
import Standard::Os

/// Writes the trace from the innermost frame out.
routine report() -> Void
    shared depth : USize = trace_depth()

    block entry()
        Out.write("depth {depth}\n")
        jump frame(0)

    block frame(back: USize)
        done : Bool = back.ge(depth)
        branch done
            ? return()
            : continue
        at    : TraceFrame = trace_frame(back)
        label : Bytes      = at.name.to<Bytes>()
        line  : U32        = at.line
        Out.write("  {back}: {label} line {line}\n")
        jump frame(back.add(1))

/// One frame between report and start.
routine middle() -> Void
    block entry()
        report()
        return()

routine start() -> Void
    block entry()
        middle()
        return()
