# [debug] trace = true keeps the crash trace in release-space, which leaves it out by default. The trace is there
# outside a crash too: a routine reads its own frame and its caller's.

import Standard/Format
import Standard/Os

### Writes the trace from the innermost frame out.
routine report() -> None
    local depth: U64 = trace_depth()

    Console.show("depth {depth}")

    each back in 0 til depth
        at: TraceFrame = trace_frame(back)
        label: @[Byte] = at.name.getview()
        line: U32 = at.line
        Console.show("  {back}: {label} line {line}")
    then
        return

### One frame between report and start.
routine middle() -> None
    report()
    return

routine start() -> None
    middle()
    return
