/// A generic type the body forms must have its record's constraints met by the ones in force: a Set[T] needs
/// HashEquatable[T], and `count_distinct` has only Equatable[T].
import Standard/Alloc
import Standard/Collections

routine count_distinct[T](values: Span[T], alloc: @MemoryManager) -> USize
needs T: typename, Equatable[T]
    local seen: @Set[T] <- .construct(alloc)

    n: USize = seen.count()
    seen.destruct()
    return n

routine start() -> None
    return
