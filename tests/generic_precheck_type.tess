/// A generic type the body forms must have its record's constraints met by the ones in force: a Set<T> needs
/// HashEquatable<T>, and `count_distinct` has only Equatable<T>.
import Standard::Alloc
import Standard::Collections

routine count_distinct<T>(values: Slice<T>, alloc: @Allocator) -> USize
require T: typename, Equatable<T>
    shared seen : @Set<T> <- .construct(alloc)

    block entry()
        n : USize = seen.count()
        seen.destruct()
        return(n)

routine start() -> Void
    block entry()
        return()
