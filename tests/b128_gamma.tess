// B128 gamma and ln_gamma (Standard/B128Gamma.tess), correctly rounded: each line is a value and its
// bits, then the exact tier's bits alone. Every one was checked against mpmath, rounded to
// binary128. Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer or -inf is
// NaN, ln_gamma is +inf at the poles.

import Standard/Format
import Standard/Os

routine show(name: Bytes, v: B128, exact: B128) -> Void
    block entry()
        Out.write("{name} {v} {v.bits()} {exact.bits()}\n")
        return()

routine start() -> Void
    block entry()
        show("gamma(nan)", b128_of(0x7FFF8000000000000000000000000000).gamma(),
            b128_gamma(b128_of(0x7FFF8000000000000000000000000000), true))
        show("ln_gamma(nan)", b128_of(0x7FFF8000000000000000000000000000).ln_gamma(),
            b128_ln_gamma(b128_of(0x7FFF8000000000000000000000000000), true))
        show("gamma(+0)", b128_of(0x00000000000000000000000000000000).gamma(),
            b128_gamma(b128_of(0x00000000000000000000000000000000), true))
        show("ln_gamma(+0)", b128_of(0x00000000000000000000000000000000).ln_gamma(),
            b128_ln_gamma(b128_of(0x00000000000000000000000000000000), true))
        show("gamma(-0)", b128_of(0x80000000000000000000000000000000).gamma(),
            b128_gamma(b128_of(0x80000000000000000000000000000000), true))
        show("ln_gamma(-0)", b128_of(0x80000000000000000000000000000000).ln_gamma(),
