# The @target forms of one routine agree on failable: a call of it is written once for every target.

### The value as an S32, failing on 32-bit targets only.
### :param n: The value.
### :returns: The value.
@target(size: 64)
routine narrow_on_32(n: S64) -> S64
    return n

### The value as an S32, failing on 32-bit targets only.
### :param n: The value.
### :returns: The value.
@target(size: 32)
failable routine narrow_on_32(n: S64) -> S64
    if n > 2147483647
        throw IntegerOverflowError()
    return n

routine start() -> None
    drop narrow_on_32(1)
    return
