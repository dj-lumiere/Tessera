# An Addr moves by a ByteSize with +% and -%, and b -% a is the distance from a to b in bytes. Both wrap around and
# check no bounds: a block's own addresses stay inside it only because the code keeps them there.

import Standard/Os

routine start() -> None
    local words: @Array[U64, 4] <- [10, 20, 30, 40]

    first: Addr = words.to[Addr]()
    third: Addr = first +% 16b
    Console.show("third word: {third.to[@U64]().peek()}")
    second: Addr = third -% 8b
    Console.show("second word: {second.to[@U64]().peek()}")
    distance: ByteSize = third -% first
    Console.show("from first to third: {distance.bytes()} bytes")
    Console.show("back where it started: {(third -% distance) === first}")
    step: ByteSize = 8b
    last: Addr = first +% step * 3
    Console.show("last word: {last.to[@U64]().peek()}")
    return
