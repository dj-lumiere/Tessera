/// A one-field record is a struct like any other, so its alignment can be raised.
import Standard/Format
import Standard/Os

#layout(align: 16)
record Wide
    x: S8

/// Makes a `Wide` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Wide.construct(x: S8) -> Me
    return(Me(x))

/// Releases nothing: a `Wide` holds no memory of its own.
routine Wide.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    size: USize = sizeof[Wide]()
    align: USize = alignof[Wide]()
    Out.write("{size} {align}\n")
    return()
