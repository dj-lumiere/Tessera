# The address of this thread's @threadlocal handed to work on another thread is a build error: that thread has its own.
module C84/ThreadlocalToWork
import Standard/Os

@threadlocal
global COUNTER: &S64 <- 1234567

### Reads the value at the address.
### :param p: The address.
### :returns: The value.
routine read_it(p: @S64) -> S64
    return p.peek()

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    work_t: Work[S64] = read_it.to[Work](p: COUNTER)
    t.put_work(work_t)
    Console.show("read: {t.retrieve()}")
    drop t
    return
