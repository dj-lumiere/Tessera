# A manager that obeys PageManageable as well gets its page routines in its table: has_pages() and has_protect() are
# true, and reserve, commit, protect, and release reach the manager's own (here the default heap's, counted).

import Standard/Alloc
import Standard/Format
import Standard/Os

entity Paged
    reserves: U64

obeys PageManageable[Paged]

routine Paged.construct() -> Me
    return Me(reserves: 0)

routine Paged.destruct(me: @Me) -> None
    return

routine Paged.alloc(me: @Me, size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.alloc(size, align)

@reshaping(at)
routine Paged.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.realloc(at, size, align)

routine Paged.free(me: @Me, at: Addr) -> None
    DEFAULT_HEAP.free(at)
    return

routine Paged.reserve(me: @Me, size: U64) -> Addr
    me.reserves.peek().add(1).poke_into(me.reserves)
    return DEFAULT_HEAP.reserve(size)

routine Paged.commit(me: @Me, at: Addr, size: U64) -> Bool
    return DEFAULT_HEAP.commit(at, size)

routine Paged.release(me: @Me, at: Addr, size: U64) -> None
    DEFAULT_HEAP.release(at, size)
    return

routine Paged.protect(me: @Me, at: Addr, size: U64, access: PageAccess) -> Bool
    return DEFAULT_HEAP.protect(at, size, access)

routine start() -> None
    local paged: @Paged <- .construct()
    local table: @MemoryManager <- paged.to[MemoryManager]()

    Out.write("pages {table.has_pages()} {table.has_protect()}\n")
    page: U64 = page_size()
    space: Addr = table.reserve(page * 2)
    ok: Bool = table.commit(at: space, size: page)
    7.poke_into(space.to[@U64]())
    closed: Bool = table.protect(at: space, size: page, access: PageAccess.READ)
    Out.write("committed {ok}, protected {closed}, read {space.to[@U64]().peek()}, reserves {paged.reserves.peek()}\n")
    table.release(at: space, size: page * 2)
    drop paged
    return
