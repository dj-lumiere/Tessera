# A manager that obeys PageManageable as well gets its page routines in its table: has_pages() and has_protect() are
# true, and reserve, commit, protect, and release reach the manager's own (here the operating system's pages, counted).

import Standard/Hosted

entity Paged
    reserves: U64

obeys PageManageable[Paged]

common routine Paged.construct() -> Me
    return Me(reserves: 0)

routine @Paged.destruct() -> None
    return

routine @Paged.borrow(size: U64, align: U64) -> Addr
    return HEAP.borrow(size, align)

@reshaping(at)
routine @Paged.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return HEAP.reborrow(at, size, align)

routine @Paged.give_back(at: Addr) -> None
    HEAP.give_back(at)
    return

routine @Paged.reserve(size: U64) -> Addr
    me.reserves.peek().add(1).poke_into(me.reserves)
    return PAGES.reserve(size)

routine @Paged.commit(at: Addr, size: U64) -> Bool
    return PAGES.commit(at, size)

routine @Paged.release(at: Addr, size: U64) -> None
    PAGES.release(at, size)
    return

routine @Paged.protect(at: Addr, size: U64, access: PageAccess) -> Bool
    return PAGES.protect(at, size, access)

routine start() -> None
    paged: &Paged <- .construct()
    table: &MemoryManager <- paged.to[MemoryManager]()

    Console.show("pages {table.has_pages()} {table.has_protect()}")
    page: U64 = page_size().bytes()
    space: Addr = table.reserve(page * 2)
    ok: Bool = table.commit(at: space, size: page)
    7.poke_into(space.to[@U64]())
    closed: Bool = table.protect(at: space, size: page, access: PageAccess.READ)
    Console.show("committed {ok}, protected {closed}, read {space.to[@U64]().peek()}, reserves {paged.reserves.peek()}")
    table.release(at: space, size: page * 2)
    drop table
    drop paged
    return
