# A crash while the reporting routine reports one skips the report and stops: the program ends with the crash status,
# and only the first report's start was written.

import Standard/Os

### Starts a report, then crashes itself.
@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("reporting {name}")
    values: Array[S64, 2] = [1, 2]
    gone: S64 = values.getitem(5)
    Console.show("not reached {gone}")
    return

routine start() -> None
    Crash.report_with(report.to[Callable]())
    crash(name: "FirstError", message: "The first crash.")
