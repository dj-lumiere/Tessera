# A stamp fetched after its pool has ended is a stale stamp (received with try), a remove fails the same way, a second
# pool can be set up after the first ended, and its first stamps don't read the old pool's entities. A second set_up
# while a pool lives is refused.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### What a stamp fetches now: the value, or -1 when it fails.
### :param s: The stamp.
### :returns: The value or -1.
routine value_of(s: PoolStamp[Node]) -> S64
    when try s.fetch()
        is @Node as n => return n.value.peek()
        is None => return -1

### Whether a second pool can be set up.
### :returns: True when it worked.
routine second_pool_works() -> Bool
    when try EntityPool.set_up(memory: PAGES)
        is EntityPool as other =>
            drop other
            return true
        is None => return false

### Shows the stamps before and after the pool ends.
routine start() -> None
    pool: &EntityPool <- EntityPool.set_up(memory: PAGES)
    a: PoolStamp[Node] = EntityPool.add(Node.construct(value: 1))
    Console.show("alive: {value_of(a)}, second pool while one lives: {second_pool_works()}")
    drop pool
    Console.show("after the end: {value_of(a)}")
    again: &EntityPool <- EntityPool.set_up(memory: PAGES)
    b: PoolStamp[Node] = EntityPool.add(Node.construct(value: 2))
    Console.show("new pool: {value_of(b)}, old stamp: {value_of(a)}")
    drop again
    return
