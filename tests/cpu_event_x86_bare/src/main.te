import Standard/Boot

### Halts on a crash.
@export("tessera_crash_handler")
@noreturn
routine halt_on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    while true
        pass

### Does nothing with a fault.
### :param event: The fault.
routine on_fault(event: CpuEvent) -> None
    return

routine start() -> None
    CpuEventManager.when_faulted(on_fault.to[Callable]())
    return
