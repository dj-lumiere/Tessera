### Halts on a crash.
@untraced
routine halt_on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    while true
        pass

### Does nothing with a fault.
### :param event: The fault.
routine on_fault(event: CpuEvent) -> None
    return

routine start() -> None
    Crash.report_with(halt_on_crash.to[Callable]())
    CpuEventManager.when_faulted(on_fault.to[Callable]())
    return
