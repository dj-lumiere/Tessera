        show("cosh(inf)", b128_of(0x7FFF0000000000000000000000000000).cosh())
        show("cosh(-inf)", b128_of(0xFFFF0000000000000000000000000000).cosh())
        show("cosh(nan)", b128_of(0x7FFF8000000000000000000000000000).cosh())
        show("cosh(snan)", b128_of(0x7FFF0000000000000000000000000001).cosh())
        show("cosh(min subnormal)", b128_of(0x00000000000000000000000000000001).cosh())
        show("cosh(2^-57 - ulp)", b128_of(0x3FC5FFFFFFFFFFFFFFFFFFFFFFFFFFFF).cosh())
        show("cosh(2^-57)", b128_of(0x3FC60000000000000000000000000000).cosh())
        show("cosh(2^-57) exact", b128_cosh(b128_of(0x3FC60000000000000000000000000000), true))
        show("cosh(1/2 - ulp)", b128_of(0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF).cosh())
