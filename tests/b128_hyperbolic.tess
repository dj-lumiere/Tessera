// B128 sinh, cosh, tanh (Standard/B128Hyperbolic.tess): correctly rounded, so the same bits on every target.
// Special cases, both cutoffs, the quick and fast tiers, and inputs whose result lies so near a rounding boundary
// that the quick and fast tiers hand them to the exact tier, and "exact" lines run the exact tier alone. Every result
// was checked against mpmath.

import Standard/Format
import Standard/Os

routine show(name: Bytes, v: B128) -> Void
    block entry()
        fd : @Out = Out.writer()
        fd.write("{name} {v} ")
        v.bits().represent_hex_into(fd)
        fd.write("\n")
        return()

routine start() -> Void
    block entry()
        show("sinh(0)", b128_of(0x00000000000000000000000000000000).sinh())
        show("sinh(-0)", b128_of(0x80000000000000000000000000000000).sinh())
        show("sinh(inf)", b128_of(0x7FFF0000000000000000000000000000).sinh())
        show("sinh(-inf)", b128_of(0xFFFF0000000000000000000000000000).sinh())
        show("sinh(nan)", b128_of(0x7FFF8000000000000000000000000000).sinh())
        show("sinh(snan)", b128_of(0x7FFF0000000000000000000000000001).sinh())
        show("sinh(min subnormal)", b128_of(0x00000000000000000000000000000001).sinh())
        show("sinh(2^-57 - ulp)", b128_of(0x3FC5FFFFFFFFFFFFFFFFFFFFFFFFFFFF).sinh())
        show("sinh(2^-57)", b128_of(0x3FC60000000000000000000000000000).sinh())
        show("sinh(2^-57) exact", b128_sinh(b128_of(0x3FC60000000000000000000000000000), true))
        show("sinh(1/2 - ulp)", b128_of(0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF).sinh())
        show("sinh(1/2 - ulp) exact", b128_sinh(b128_of(0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF), true))
        show("sinh(1/2)", b128_of(0x3FFE0000000000000000000000000000).sinh())
        show("sinh(1/2) exact", b128_sinh(b128_of(0x3FFE0000000000000000000000000000), true))
        show("sinh(1/4 - ulp)", b128_of(0x3FFCFFFFFFFFFFFFFFFFFFFFFFFFFFFF).sinh())
        show("sinh(1/4 - ulp) exact", b128_sinh(b128_of(0x3FFCFFFFFFFFFFFFFFFFFFFFFFFFFFFF), true))
        show("sinh(1)", b128_of(0x3FFF0000000000000000000000000000).sinh())
        show("sinh(1) exact", b128_sinh(b128_of(0x3FFF0000000000000000000000000000), true))
        show("sinh(-2.5)", b128_of(0xC0004000000000000000000000000000).sinh())
        show("sinh(-2.5) exact", b128_sinh(b128_of(0xC0004000000000000000000000000000), true))
        show("sinh(10)", b128_of(0x40024000000000000000000000000000).sinh())
        show("sinh(10) exact", b128_sinh(b128_of(0x40024000000000000000000000000000), true))
        show("sinh(0.1)", b128_of(0x3FFB999999999999A000000000000000).sinh())
        show("sinh(0.1) exact", b128_sinh(b128_of(0x3FFB999999999999A000000000000000), true))
        show("sinh(-1e-10)", b128_of(0xBFDDB7CDFD9D7BDBB000000000000000).sinh())
        show("sinh(-1e-10) exact", b128_sinh(b128_of(0xBFDDB7CDFD9D7BDBB000000000000000), true))
