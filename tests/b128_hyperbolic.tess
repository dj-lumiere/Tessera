# B128 sinh, cosh, tanh (Standard/B128Hyperbolic.tess): correctly rounded, so the same bits on every target.
# Special cases, both cutoffs, the quick and fast tiers, and inputs whose result lies so near a rounding boundary
# that the quick and fast tiers hand them to the exact tier, and "exact" lines run the exact tier alone. Every result
# was checked against mpmath.

import Standard/Format
import Standard/Os

routine show(name: Span[Byte], v: B128) -> None
    fd: @Out = Out.writer()
    fd.write("{name} {v} ")
    v.bits().represent_hex_into(fd)
    fd.write("\n")
    return

routine start() -> None
    show(name: "sinh(0)", v: b128_of(0x00000000000000000000000000000000).sinh())
    show(name: "sinh(-0)", v: b128_of(0x80000000000000000000000000000000).sinh())
    show(name: "sinh(inf)", v: b128_of(0x7FFF0000000000000000000000000000).sinh())
    show(name: "sinh(-inf)", v: b128_of(0xFFFF0000000000000000000000000000).sinh())
    show(name: "sinh(nan)", v: b128_of(0x7FFF8000000000000000000000000000).sinh())
    show(name: "sinh(snan)", v: b128_of(0x7FFF0000000000000000000000000001).sinh())
    show(name: "sinh(min subnormal)", v: b128_of(0x00000000000000000000000000000001).sinh())
    show(name: "sinh(2^-57 - ulp)", v: b128_of(0x3FC5FFFFFFFFFFFFFFFFFFFFFFFFFFFF).sinh())
    show(name: "sinh(2^-57)", v: b128_of(0x3FC60000000000000000000000000000).sinh())
    show(name: "sinh(2^-57) exact", v: b128_sinh(x: b128_of(0x3FC60000000000000000000000000000), exact: true))
    show(name: "sinh(1/2 - ulp)", v: b128_of(0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF).sinh())
    show(name: "sinh(1/2 - ulp) exact", v: b128_sinh(x: b128_of(0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF), exact: true))
    show(name: "sinh(1/2)", v: b128_of(0x3FFE0000000000000000000000000000).sinh())
    show(name: "sinh(1/2) exact", v: b128_sinh(x: b128_of(0x3FFE0000000000000000000000000000), exact: true))
    show(name: "sinh(1/4 - ulp)", v: b128_of(0x3FFCFFFFFFFFFFFFFFFFFFFFFFFFFFFF).sinh())
    show(name: "sinh(1/4 - ulp) exact", v: b128_sinh(x: b128_of(0x3FFCFFFFFFFFFFFFFFFFFFFFFFFFFFFF), exact: true))
    show(name: "sinh(1)", v: b128_of(0x3FFF0000000000000000000000000000).sinh())
    show(name: "sinh(1) exact", v: b128_sinh(x: b128_of(0x3FFF0000000000000000000000000000), exact: true))
    show(name: "sinh(-2.5)", v: b128_of(0xC0004000000000000000000000000000).sinh())
    show(name: "sinh(-2.5) exact", v: b128_sinh(x: b128_of(0xC0004000000000000000000000000000), exact: true))
    show(name: "sinh(10)", v: b128_of(0x40024000000000000000000000000000).sinh())
    show(name: "sinh(10) exact", v: b128_sinh(x: b128_of(0x40024000000000000000000000000000), exact: true))
    show(name: "sinh(0.1)", v: b128_of(0x3FFB999999999999A000000000000000).sinh())
    show(name: "sinh(0.1) exact", v: b128_sinh(x: b128_of(0x3FFB999999999999A000000000000000), exact: true))
    show(name: "sinh(-1e-10)", v: b128_of(0xBFDDB7CDFD9D7BDBB000000000000000).sinh())
    show(name: "sinh(-1e-10) exact", v: b128_sinh(x: b128_of(0xBFDDB7CDFD9D7BDBB000000000000000), exact: true))
    show(name: "cosh(0)", v: b128_of(0x00000000000000000000000000000000).cosh())
