// An out-of-bounds List.get crashes: stdout keeps what came before, and the exit status is 101.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local list: @List[S64] <- .construct(alloc)
    list.add_last(10)
    first: S64 = list[0]
    Out.write("{first}\n")
    missing: S64 = list[3]
    Out.write("not reached\n")
    return
