// An out-of-bounds List.get crashes: stdout keeps what came before, and the exit status is 101.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        claim list  : @List<S64> <- .construct(alloc)
        list.push(10)
        first : S64 = list.getitem(0)
        Out.write("{first}\n")
        missing : S64 = list.getitem(3)
        Out.write("not reached\n")
        return()
