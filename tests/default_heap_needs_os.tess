// The construct overloads without an allocator come with Standard::Os, the hosted layer, like Out and Err: a file that
// doesn't import it sees only the ones that take an allocator, and the error says where the other one is.

import Standard::Alloc
import Standard::Collections

routine start() -> Void
    block entry()
        claim list : @List<S64> <- .construct()
        list.destruct()
        return()
