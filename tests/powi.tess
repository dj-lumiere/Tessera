// powi, correctly rounded for every type: x^n rounded once. F64 and F128 call powf with n converted (exact). F32
// does the same for |n| <= 2^24 and goes through the F64 power beyond. F16 and BF16 go through the F64 power. At a
// narrow midpoint the F128 power decides (exhaustively checked: x^n is then exact and ties to even, or, for 53 F32
// pairs, at least 2^-61 away from the midpoint). Expected bits are x^n from exact rationals or mpmath, rounded once.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry()
        f64_power_1 : F64 = F64.from_bits(0x3FF8000000000000).powi(-3)
        Out.write("F64.from_bits(0x3FF8000000000000).powi(-3) {f64_power_1.bits()}\n")
        f64_power_2 : F64 = F64.from_bits(0x4008000000000000).powi(40)
        Out.write("F64.from_bits(0x4008000000000000).powi(40) {f64_power_2.bits()}\n")
        f64_power_3 : F64 = F64.from_bits(0x3FF0000000000001).powi(2147483647)
        Out.write("F64.from_bits(0x3FF0000000000001).powi(2147483647) {f64_power_3.bits()}\n")
        f64_power_4 : F64 = F64.from_bits(0x3FEFFFFFFFFFFFFF).powi(-2147483648)
        Out.write("F64.from_bits(0x3FEFFFFFFFFFFFFF).powi(-2147483648) {f64_power_4.bits()}\n")
        f64_power_5 : F64 = F64.from_bits(0xC008000000000000).powi(33)
        Out.write("F64.from_bits(0xC008000000000000).powi(33) {f64_power_5.bits()}\n")
        f64_power_6 : F64 = F64.from_bits(0x4000000000000000).powi(-1074)
        Out.write("F64.from_bits(0x4000000000000000).powi(-1074) {f64_power_6.bits()}\n")
        f64_power_7 : F64 = F64.from_bits(0x7FF8000000000000).powi(0)
        Out.write("F64.from_bits(0x7FF8000000000000).powi(0) {f64_power_7.bits()}\n")
        f64_power_8 : F64 = F64.from_bits(0x8000000000000000).powi(-3)
        Out.write("F64.from_bits(0x8000000000000000).powi(-3) {f64_power_8.bits()}\n")
        f64_power_9 : F64 = F64.from_bits(0x7FF0000000000000).powi(-2)
        Out.write("F64.from_bits(0x7FF0000000000000).powi(-2) {f64_power_9.bits()}\n")
        f32_power_1 : F32 = F32.from_bits(0x40400000).powi(20)
        Out.write("F32.from_bits(0x40400000).powi(20) {f32_power_1.bits()}\n")
        f32_power_2 : F32 = F32.from_bits(0x3FC00000).powi(-7)
        Out.write("F32.from_bits(0x3FC00000).powi(-7) {f32_power_2.bits()}\n")
        f32_power_3 : F32 = F32.from_bits(0x3F800001).powi(16777216)
        Out.write("F32.from_bits(0x3F800001).powi(16777216) {f32_power_3.bits()}\n")
        f32_power_4 : F32 = F32.from_bits(0x3F800001).powi(16777217)
        Out.write("F32.from_bits(0x3F800001).powi(16777217) {f32_power_4.bits()}\n")
        f32_power_5 : F32 = F32.from_bits(0x3F800001).powi(500000000)
        Out.write("F32.from_bits(0x3F800001).powi(500000000) {f32_power_5.bits()}\n")
        f32_power_6 : F32 = F32.from_bits(0x3F7FFFFF).powi(-700000000)
        Out.write("F32.from_bits(0x3F7FFFFF).powi(-700000000) {f32_power_6.bits()}\n")
        f32_power_7 : F32 = F32.from_bits(0xBF800001).powi(16777219)
        Out.write("F32.from_bits(0xBF800001).powi(16777219) {f32_power_7.bits()}\n")
        f32_power_8 : F32 = F32.from_bits(0x3F80000F).powi(30000000)
        Out.write("F32.from_bits(0x3F80000F).powi(30000000) {f32_power_8.bits()}\n")
        f32_power_9 : F32 = F32.from_bits(0x3F7FFFF0).powi(100000000)
        Out.write("F32.from_bits(0x3F7FFFF0).powi(100000000) {f32_power_9.bits()}\n")
        f32_power_10 : F32 = F32.from_bits(0x3F7FFFFF).powi(-2147483648)
        Out.write("F32.from_bits(0x3F7FFFFF).powi(-2147483648) {f32_power_10.bits()}\n")
        f32_power_11 : F32 = F32.from_bits(0x7FC00000).powi(0)
        Out.write("F32.from_bits(0x7FC00000).powi(0) {f32_power_11.bits()}\n")
        f32_power_12 : F32 = F32.from_bits(0x80000000).powi(-3)
        Out.write("F32.from_bits(0x80000000).powi(-3) {f32_power_12.bits()}\n")
        f32_power_13 : F32 = F32.from_bits(0xFF800000).powi(3)
        Out.write("F32.from_bits(0xFF800000).powi(3) {f32_power_13.bits()}\n")
        // the F64 power lands on an F32 midpoint 2^-61.4 away from x^n: the F128 power decides
        f32_power_14 : F32 = F32.from_bits(0x3F800008).powi(19339151)
        Out.write("F32.from_bits(0x3F800008).powi(19339151) {f32_power_14.bits()}\n")
        f16_power_1 : F16 = F16.from_bits(0x4200).powi(7)
        Out.write("F16.from_bits(0x4200).powi(7) {f16_power_1.bits()}\n")
        f16_power_2 : F16 = F16.from_bits(0x4700).powi(3)
        Out.write("F16.from_bits(0x4700).powi(3) {f16_power_2.bits()}\n")
        f16_power_3 : F16 = F16.from_bits(0x3E00).powi(20)
        Out.write("F16.from_bits(0x3E00).powi(20) {f16_power_3.bits()}\n")
        f16_power_4 : F16 = F16.from_bits(0x3C01).powi(5000)
        Out.write("F16.from_bits(0x3C01).powi(5000) {f16_power_4.bits()}\n")
        f16_power_5 : F16 = F16.from_bits(0x3BFF).powi(-10000)
        Out.write("F16.from_bits(0x3BFF).powi(-10000) {f16_power_5.bits()}\n")
        f16_power_6 : F16 = F16.from_bits(0xC200).powi(9)
        Out.write("F16.from_bits(0xC200).powi(9) {f16_power_6.bits()}\n")
        f16_power_7 : F16 = F16.from_bits(0x0001).powi(-1)
        Out.write("F16.from_bits(0x0001).powi(-1) {f16_power_7.bits()}\n")
        f16_power_8 : F16 = F16.from_bits(0x3800).powi(25)
        Out.write("F16.from_bits(0x3800).powi(25) {f16_power_8.bits()}\n")
        f16_power_9 : F16 = F16.from_bits(0x7E00).powi(0)
        Out.write("F16.from_bits(0x7E00).powi(0) {f16_power_9.bits()}\n")
        f16_power_10 : F16 = F16.from_bits(0x8000).powi(-3)
        Out.write("F16.from_bits(0x8000).powi(-3) {f16_power_10.bits()}\n")
        f16_power_11 : F16 = F16.from_bits(0x7C00).powi(-2)
        Out.write("F16.from_bits(0x7C00).powi(-2) {f16_power_11.bits()}\n")
        bf16_power_1 : BF16 = BF16.from_bits(0x4040).powi(5)
        Out.write("BF16.from_bits(0x4040).powi(5) {bf16_power_1.bits()}\n")
        bf16_power_2 : BF16 = BF16.from_bits(0x40E0).powi(3)
        Out.write("BF16.from_bits(0x40E0).powi(3) {bf16_power_2.bits()}\n")
        bf16_power_3 : BF16 = BF16.from_bits(0x3F81).powi(1000)
        Out.write("BF16.from_bits(0x3F81).powi(1000) {bf16_power_3.bits()}\n")
        bf16_power_4 : BF16 = BF16.from_bits(0x3F7F).powi(-20000)
        Out.write("BF16.from_bits(0x3F7F).powi(-20000) {bf16_power_4.bits()}\n")
        bf16_power_5 : BF16 = BF16.from_bits(0xC040).powi(7)
        Out.write("BF16.from_bits(0xC040).powi(7) {bf16_power_5.bits()}\n")
        bf16_power_6 : BF16 = BF16.from_bits(0x3F00).powi(134)
        Out.write("BF16.from_bits(0x3F00).powi(134) {bf16_power_6.bits()}\n")
        bf16_power_7 : BF16 = BF16.from_bits(0x3FC0).powi(-50)
        Out.write("BF16.from_bits(0x3FC0).powi(-50) {bf16_power_7.bits()}\n")
        bf16_power_8 : BF16 = BF16.from_bits(0x7FC0).powi(0)
        Out.write("BF16.from_bits(0x7FC0).powi(0) {bf16_power_8.bits()}\n")
        bf16_power_9 : BF16 = BF16.from_bits(0x8000).powi(-3)
        Out.write("BF16.from_bits(0x8000).powi(-3) {bf16_power_9.bits()}\n")
        bf16_power_10 : BF16 = BF16.from_bits(0xFF80).powi(2)
        Out.write("BF16.from_bits(0xFF80).powi(2) {bf16_power_10.bits()}\n")
        return(0)
