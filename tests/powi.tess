// powi, correctly rounded for every type: x^n rounded once. F64 and F128 call powf with n converted (exact); F32
// does the same for |n| <= 2^24 and goes through the F64 power beyond; F16 and BF16 go through the F64 power. At a
// narrow midpoint the F128 power decides (exhaustively checked: x^n is then exact and ties to even, or, for 53 F32
// pairs, at least 2^-61 away from the midpoint). Expected bits are x^n from exact rationals or mpmath, rounded once.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        Out.write("F64.from_bits(0x3FF8000000000000).powi(-3) {F64.from_bits(0x3FF8000000000000).powi(-3).bits()}\n")
        Out.write("F64.from_bits(0x4008000000000000).powi(40) {F64.from_bits(0x4008000000000000).powi(40).bits()}\n")
        Out.write("F64.from_bits(0x3FF0000000000001).powi(2147483647) {F64.from_bits(0x3FF0000000000001).powi(2147483647).bits()}\n")
        Out.write("F64.from_bits(0x3FEFFFFFFFFFFFFF).powi(-2147483648) {F64.from_bits(0x3FEFFFFFFFFFFFFF).powi(-2147483648).bits()}\n")
        Out.write("F64.from_bits(0xC008000000000000).powi(33) {F64.from_bits(0xC008000000000000).powi(33).bits()}\n")
        Out.write("F64.from_bits(0x4000000000000000).powi(-1074) {F64.from_bits(0x4000000000000000).powi(-1074).bits()}\n")
        Out.write("F64.from_bits(0x7FF8000000000000).powi(0) {F64.from_bits(0x7FF8000000000000).powi(0).bits()}\n")
        Out.write("F64.from_bits(0x8000000000000000).powi(-3) {F64.from_bits(0x8000000000000000).powi(-3).bits()}\n")
        Out.write("F64.from_bits(0x7FF0000000000000).powi(-2) {F64.from_bits(0x7FF0000000000000).powi(-2).bits()}\n")
        Out.write("F32.from_bits(0x40400000).powi(20) {F32.from_bits(0x40400000).powi(20).bits()}\n")
        Out.write("F32.from_bits(0x3FC00000).powi(-7) {F32.from_bits(0x3FC00000).powi(-7).bits()}\n")
        Out.write("F32.from_bits(0x3F800001).powi(16777216) {F32.from_bits(0x3F800001).powi(16777216).bits()}\n")
        Out.write("F32.from_bits(0x3F800001).powi(16777217) {F32.from_bits(0x3F800001).powi(16777217).bits()}\n")
        Out.write("F32.from_bits(0x3F800001).powi(500000000) {F32.from_bits(0x3F800001).powi(500000000).bits()}\n")
        Out.write("F32.from_bits(0x3F7FFFFF).powi(-700000000) {F32.from_bits(0x3F7FFFFF).powi(-700000000).bits()}\n")
        Out.write("F32.from_bits(0xBF800001).powi(16777219) {F32.from_bits(0xBF800001).powi(16777219).bits()}\n")
        Out.write("F32.from_bits(0x3F80000F).powi(30000000) {F32.from_bits(0x3F80000F).powi(30000000).bits()}\n")
        Out.write("F32.from_bits(0x3F7FFFF0).powi(100000000) {F32.from_bits(0x3F7FFFF0).powi(100000000).bits()}\n")
        Out.write("F32.from_bits(0x3F7FFFFF).powi(-2147483648) {F32.from_bits(0x3F7FFFFF).powi(-2147483648).bits()}\n")
        Out.write("F32.from_bits(0x7FC00000).powi(0) {F32.from_bits(0x7FC00000).powi(0).bits()}\n")
        Out.write("F32.from_bits(0x80000000).powi(-3) {F32.from_bits(0x80000000).powi(-3).bits()}\n")
        Out.write("F32.from_bits(0xFF800000).powi(3) {F32.from_bits(0xFF800000).powi(3).bits()}\n")
        // the F64 power lands on an F32 midpoint 2^-61.4 away from x^n: the F128 power decides
        Out.write("F32.from_bits(0x3F800008).powi(19339151) {F32.from_bits(0x3F800008).powi(19339151).bits()}\n")
        Out.write("F16.from_bits(0x4200).powi(7) {F16.from_bits(0x4200).powi(7).bits()}\n")
        Out.write("F16.from_bits(0x4700).powi(3) {F16.from_bits(0x4700).powi(3).bits()}\n")
        Out.write("F16.from_bits(0x3E00).powi(20) {F16.from_bits(0x3E00).powi(20).bits()}\n")
        Out.write("F16.from_bits(0x3C01).powi(5000) {F16.from_bits(0x3C01).powi(5000).bits()}\n")
        Out.write("F16.from_bits(0x3BFF).powi(-10000) {F16.from_bits(0x3BFF).powi(-10000).bits()}\n")
        Out.write("F16.from_bits(0xC200).powi(9) {F16.from_bits(0xC200).powi(9).bits()}\n")
        Out.write("F16.from_bits(0x0001).powi(-1) {F16.from_bits(0x0001).powi(-1).bits()}\n")
        Out.write("F16.from_bits(0x3800).powi(25) {F16.from_bits(0x3800).powi(25).bits()}\n")
        Out.write("F16.from_bits(0x7E00).powi(0) {F16.from_bits(0x7E00).powi(0).bits()}\n")
        Out.write("F16.from_bits(0x8000).powi(-3) {F16.from_bits(0x8000).powi(-3).bits()}\n")
        Out.write("F16.from_bits(0x7C00).powi(-2) {F16.from_bits(0x7C00).powi(-2).bits()}\n")
        Out.write("BF16.from_bits(0x4040).powi(5) {BF16.from_bits(0x4040).powi(5).bits()}\n")
        Out.write("BF16.from_bits(0x40E0).powi(3) {BF16.from_bits(0x40E0).powi(3).bits()}\n")
        Out.write("BF16.from_bits(0x3F81).powi(1000) {BF16.from_bits(0x3F81).powi(1000).bits()}\n")
        Out.write("BF16.from_bits(0x3F7F).powi(-20000) {BF16.from_bits(0x3F7F).powi(-20000).bits()}\n")
        Out.write("BF16.from_bits(0xC040).powi(7) {BF16.from_bits(0xC040).powi(7).bits()}\n")
        Out.write("BF16.from_bits(0x3F00).powi(134) {BF16.from_bits(0x3F00).powi(134).bits()}\n")
        Out.write("BF16.from_bits(0x3FC0).powi(-50) {BF16.from_bits(0x3FC0).powi(-50).bits()}\n")
        Out.write("BF16.from_bits(0x7FC0).powi(0) {BF16.from_bits(0x7FC0).powi(0).bits()}\n")
        Out.write("BF16.from_bits(0x8000).powi(-3) {BF16.from_bits(0x8000).powi(-3).bits()}\n")
        Out.write("BF16.from_bits(0xFF80).powi(2) {BF16.from_bits(0xFF80).powi(2).bits()}\n")
        return(0)
