// powi, correctly rounded for every type: x^n rounded once. B64 and B128 call powf with n converted (exact). B32
// does the same for |n| <= 2^24 and goes through the B64 power beyond. B16 and BF16 go through the B64 power. At a
// narrow midpoint the B128 power decides (exhaustively checked: x^n is then exact and ties to even, or, for 53 B32
// pairs, at least 2^-61 away from the midpoint). Expected bits are x^n from exact rationals or mpmath, rounded once.

import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        b64_power_1 : B64 = B64.from_bits(0x3FF8000000000000).powi(-3)
        Out.write("B64.from_bits(0x3FF8000000000000).powi(-3) {b64_power_1.bits()}\n")
        b64_power_2 : B64 = B64.from_bits(0x4008000000000000).powi(40)
        Out.write("B64.from_bits(0x4008000000000000).powi(40) {b64_power_2.bits()}\n")
        b64_power_3 : B64 = B64.from_bits(0x3FF0000000000001).powi(2147483647)
        Out.write("B64.from_bits(0x3FF0000000000001).powi(2147483647) {b64_power_3.bits()}\n")
        b64_power_4 : B64 = B64.from_bits(0x3FEFFFFFFFFFFFFF).powi(-2147483648)
        Out.write("B64.from_bits(0x3FEFFFFFFFFFFFFF).powi(-2147483648) {b64_power_4.bits()}\n")
        b64_power_5 : B64 = B64.from_bits(0xC008000000000000).powi(33)
        Out.write("B64.from_bits(0xC008000000000000).powi(33) {b64_power_5.bits()}\n")
        b64_power_6 : B64 = B64.from_bits(0x4000000000000000).powi(-1074)
        Out.write("B64.from_bits(0x4000000000000000).powi(-1074) {b64_power_6.bits()}\n")
        b64_power_7 : B64 = B64.from_bits(0x7FF8000000000000).powi(0)
        Out.write("B64.from_bits(0x7FF8000000000000).powi(0) {b64_power_7.bits()}\n")
        b64_power_8 : B64 = B64.from_bits(0x8000000000000000).powi(-3)
        Out.write("B64.from_bits(0x8000000000000000).powi(-3) {b64_power_8.bits()}\n")
        b64_power_9 : B64 = B64.from_bits(0x7FF0000000000000).powi(-2)
        Out.write("B64.from_bits(0x7FF0000000000000).powi(-2) {b64_power_9.bits()}\n")
        b32_power_1 : B32 = B32.from_bits(0x40400000).powi(20)
        Out.write("B32.from_bits(0x40400000).powi(20) {b32_power_1.bits()}\n")
        b32_power_2 : B32 = B32.from_bits(0x3FC00000).powi(-7)
        Out.write("B32.from_bits(0x3FC00000).powi(-7) {b32_power_2.bits()}\n")
        b32_power_3 : B32 = B32.from_bits(0x3F800001).powi(16777216)
        Out.write("B32.from_bits(0x3F800001).powi(16777216) {b32_power_3.bits()}\n")
        b32_power_4 : B32 = B32.from_bits(0x3F800001).powi(16777217)
        Out.write("B32.from_bits(0x3F800001).powi(16777217) {b32_power_4.bits()}\n")
        b32_power_5 : B32 = B32.from_bits(0x3F800001).powi(500000000)
        Out.write("B32.from_bits(0x3F800001).powi(500000000) {b32_power_5.bits()}\n")
        b32_power_6 : B32 = B32.from_bits(0x3F7FFFFF).powi(-700000000)
        Out.write("B32.from_bits(0x3F7FFFFF).powi(-700000000) {b32_power_6.bits()}\n")
        b32_power_7 : B32 = B32.from_bits(0xBF800001).powi(16777219)
        Out.write("B32.from_bits(0xBF800001).powi(16777219) {b32_power_7.bits()}\n")
        b32_power_8 : B32 = B32.from_bits(0x3F80000F).powi(30000000)
        Out.write("B32.from_bits(0x3F80000F).powi(30000000) {b32_power_8.bits()}\n")
        b32_power_9 : B32 = B32.from_bits(0x3F7FFFF0).powi(100000000)
        Out.write("B32.from_bits(0x3F7FFFF0).powi(100000000) {b32_power_9.bits()}\n")
        b32_power_10 : B32 = B32.from_bits(0x3F7FFFFF).powi(-2147483648)
        Out.write("B32.from_bits(0x3F7FFFFF).powi(-2147483648) {b32_power_10.bits()}\n")
        b32_power_11 : B32 = B32.from_bits(0x7FC00000).powi(0)
        Out.write("B32.from_bits(0x7FC00000).powi(0) {b32_power_11.bits()}\n")
        b32_power_12 : B32 = B32.from_bits(0x80000000).powi(-3)
        Out.write("B32.from_bits(0x80000000).powi(-3) {b32_power_12.bits()}\n")
        b32_power_13 : B32 = B32.from_bits(0xFF800000).powi(3)
        Out.write("B32.from_bits(0xFF800000).powi(3) {b32_power_13.bits()}\n")
        // the B64 power lands on a B32 midpoint 2^-61.4 away from x^n: the B128 power decides
        b32_power_14 : B32 = B32.from_bits(0x3F800008).powi(19339151)
        Out.write("B32.from_bits(0x3F800008).powi(19339151) {b32_power_14.bits()}\n")
        b16_power_1 : B16 = B16.from_bits(0x4200).powi(7)
        Out.write("B16.from_bits(0x4200).powi(7) {b16_power_1.bits()}\n")
        b16_power_2 : B16 = B16.from_bits(0x4700).powi(3)
        Out.write("B16.from_bits(0x4700).powi(3) {b16_power_2.bits()}\n")
        b16_power_3 : B16 = B16.from_bits(0x3E00).powi(20)
        Out.write("B16.from_bits(0x3E00).powi(20) {b16_power_3.bits()}\n")
        b16_power_4 : B16 = B16.from_bits(0x3C01).powi(5000)
        Out.write("B16.from_bits(0x3C01).powi(5000) {b16_power_4.bits()}\n")
        b16_power_5 : B16 = B16.from_bits(0x3BFF).powi(-10000)
        Out.write("B16.from_bits(0x3BFF).powi(-10000) {b16_power_5.bits()}\n")
        b16_power_6 : B16 = B16.from_bits(0xC200).powi(9)
        Out.write("B16.from_bits(0xC200).powi(9) {b16_power_6.bits()}\n")
        b16_power_7 : B16 = B16.from_bits(0x0001).powi(-1)
        Out.write("B16.from_bits(0x0001).powi(-1) {b16_power_7.bits()}\n")
        b16_power_8 : B16 = B16.from_bits(0x3800).powi(25)
        Out.write("B16.from_bits(0x3800).powi(25) {b16_power_8.bits()}\n")
        b16_power_9 : B16 = B16.from_bits(0x7E00).powi(0)
        Out.write("B16.from_bits(0x7E00).powi(0) {b16_power_9.bits()}\n")
        b16_power_10 : B16 = B16.from_bits(0x8000).powi(-3)
        Out.write("B16.from_bits(0x8000).powi(-3) {b16_power_10.bits()}\n")
        b16_power_11 : B16 = B16.from_bits(0x7C00).powi(-2)
        Out.write("B16.from_bits(0x7C00).powi(-2) {b16_power_11.bits()}\n")
        bf16_power_1 : BF16 = BF16.from_bits(0x4040).powi(5)
        Out.write("BF16.from_bits(0x4040).powi(5) {bf16_power_1.bits()}\n")
        bf16_power_2 : BF16 = BF16.from_bits(0x40E0).powi(3)
        Out.write("BF16.from_bits(0x40E0).powi(3) {bf16_power_2.bits()}\n")
        bf16_power_3 : BF16 = BF16.from_bits(0x3F81).powi(1000)
        Out.write("BF16.from_bits(0x3F81).powi(1000) {bf16_power_3.bits()}\n")
        bf16_power_4 : BF16 = BF16.from_bits(0x3F7F).powi(-20000)
        Out.write("BF16.from_bits(0x3F7F).powi(-20000) {bf16_power_4.bits()}\n")
        bf16_power_5 : BF16 = BF16.from_bits(0xC040).powi(7)
        Out.write("BF16.from_bits(0xC040).powi(7) {bf16_power_5.bits()}\n")
        bf16_power_6 : BF16 = BF16.from_bits(0x3F00).powi(134)
        Out.write("BF16.from_bits(0x3F00).powi(134) {bf16_power_6.bits()}\n")
        bf16_power_7 : BF16 = BF16.from_bits(0x3FC0).powi(-50)
        Out.write("BF16.from_bits(0x3FC0).powi(-50) {bf16_power_7.bits()}\n")
        bf16_power_8 : BF16 = BF16.from_bits(0x7FC0).powi(0)
        Out.write("BF16.from_bits(0x7FC0).powi(0) {bf16_power_8.bits()}\n")
        bf16_power_9 : BF16 = BF16.from_bits(0x8000).powi(-3)
        Out.write("BF16.from_bits(0x8000).powi(-3) {bf16_power_9.bits()}\n")
        bf16_power_10 : BF16 = BF16.from_bits(0xFF80).powi(2)
        Out.write("BF16.from_bits(0xFF80).powi(2) {bf16_power_10.bits()}\n")
        return()
