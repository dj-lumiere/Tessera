# A field Node? filled from STACK holds a slot of this routine's frame: its destruct ends the node and gives nothing back.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

### Says which node ends, then ends the rest of the list.
routine @Node.destruct() -> None
    Console.show("end {me.value.peek()}")
    drop me.next
    return

routine start() -> None
    first: &Node <- Node.construct(1)
    first.next <- Node.construct(2) from STACK
    when first.next
        is Node as second =>
            second.next <- Node.construct(3) from STACK
            Console.show("second {second.value.peek()}")
        is None => Console.show("none")
    return
