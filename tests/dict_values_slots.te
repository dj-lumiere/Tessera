# A Dict's values emitter hands out each value's slot in insertion order, so a loop doubles the values in place, and
# emit reads them. It conforms to SlotEmitter, and so to Emitter without saying it.

import Collections
import Hosted

### The sum of what an emitter hands out, through Emitter alone.
### :typeparam TEmitter: The emitter type.
### :param iter: The emitter.
### :returns: The sum.
routine total[TEmitter](iter: @TEmitter) -> S64
needs TEmitter obeys Emitter[S64]
    sum: &S64 <- 0

    loop
        item: Optional[S64] = try iter.emit()
        value: S64 = when item
            is S64 as value => value
            is None => return sum.load()
        (sum.load() + value).poke_into(sum)

routine start() -> None
    scores: &Dict[@[Byte], S64] <- .construct(HEAP)
    slots: &DictValues[@[Byte], S64] <- .hollow()
    values: &DictValues[@[Byte], S64] <- .hollow()

    scores["a"] = 1
    scores["b"] = 2
    scores["c"] = 3
    dropped: Bool = scores.remove("b")
    DictValues[@[Byte], S64].construct(scores).poke_into(slots)

    loop
        slot: Optional[@S64] = try slots.next()
        when slot
            is @S64 as p =>
                (p.peek() * 2).poke_into(p)
                continue
            is None => break
    Console.show("{scores}")
    DictValues[@[Byte], S64].construct(scores).poke_into(values)
    Console.show("total {total(values)}")
    drop scores
    return
