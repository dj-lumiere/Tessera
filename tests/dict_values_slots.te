# A Dict's values iterator hands out each value's slot in insertion order, so a loop doubles the values in place, and
# emit reads them. It conforms to SlotIterator, and so to Iterator without saying it.

import Standard/Collections
import Standard/Os

### The sum of what an iterator hands out, through Iterator alone.
### :typeparam TIter: The iterator type.
### :param iter: The iterator.
### :returns: The sum.
routine total[TIter](iter: @TIter) -> S64
needs TIter: typename, Iterator[S64, TIter]
    local sum: @S64 <- 0

    while true
        item: Maybe[S64] = iter.emit_checked()
        value: S64 = when item
            is S64 as value => value
            is None => return sum.peek()
        (sum.peek() + value).poke_into(sum)

routine start() -> None
    local scores: @Dict[@[Byte], S64] <- .construct()
    local slots: @DictValues[@[Byte], S64] <- .hollow()
    local values: @DictValues[@[Byte], S64] <- .hollow()

    scores["a"] = 1
    scores["b"] = 2
    scores["c"] = 3
    dropped: Bool = scores.remove("b")
    DictValues[@[Byte], S64].construct(scores).poke_into(slots)

    while true
        slot: Maybe[@S64] = slots.next_checked()
        when slot
            is @S64 as p =>
                (p.peek() * 2).poke_into(p)
                continue
            is None => break
    Console.show("{scores}")
    DictValues[@[Byte], S64].construct(scores).poke_into(values)
    Console.show("total {total(values)}")
    drop scores
    return
