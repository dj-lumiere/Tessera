# A routine keeps a view in a value of the caller, and the memory is given back before the value is used.

import Hosted

### Holds a view.
record Holder
    v: @[S64]

### Keeps a view in a holder.
### :param out: Where it goes.
### :param v: The view.
routine keep(out: @Holder, v: @[S64]) -> None
    out.v.poke(v)
    return

routine start() -> None
    m: &[S64] <- [1234567] * 4 from HEAP
    q: &Holder <- (v: .hollow())

    keep(out: q, v: m.getslice())
    drop m
    Console.show("{q.v.peek().getitem(0)}")
    return
