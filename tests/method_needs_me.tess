// Only a routine whose first parameter is me is a method. One without is called by its type.

record Point
    x: S64
    y: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.shifted(p: Me, by: S64) -> Me
    return(Me(x: p.x.add(by), y: p.y))

routine start() -> Void
    p: Point = Point(x: 1, y: 2)
    q: Point = p.shifted(1)
    return()
