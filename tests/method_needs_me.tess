// Only a routine whose first parameter is me is a method. One without is called by its type.

record Point
    x: S64
    y: S64

routine Point.shifted(p: Me, by: S64) -> Me
    return(Me(x: p.x.add(by), y: p.y))

routine start() -> Void
    p: Point = Point(x: 1, y: 2)
    q: Point = p.shifted(1)
    return()
