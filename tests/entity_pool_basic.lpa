# EntityPool: add hands an entity to the pool, the stamp fetches it, a change through the fetched view stays, copies
# of a stamp are the same entity, and the entities of the pool end in tear_down.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### Shows the entity adding, fetching and changing.
routine start() -> None
    EntityPool.set_up(memory: PAGES)
    a: PoolStamp[Node] = EntityPool.add(Node.construct(value: 1))
    b: PoolStamp[Node] = EntityPool.add(Node.construct(value: 2))
    again: PoolStamp[Node] = a
    Console.show("a: {a.fetch().value.peek()}, b: {b.fetch().value.peek()}")
    a.fetch().value.poke(10)
    Console.show("changed: {again.fetch().value.peek()}")
    Console.show("same: {a === again}, other: {a !== b}, differ: {a === b}")
    EntityPool.tear_down()
    return
