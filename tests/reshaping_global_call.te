# A view of what a global holds ends at a call to a routine of the global's module: the routine can reach the global,
# so it may add to it and move what it holds.

import Collections
import Hosted

lateinit global NUMBERS: &List[S64]

routine grow() -> None
    NUMBERS.add_last(6)
    return

routine start() -> None
    NUMBERS.poke(List[S64].construct(manager: HEAP))
    NUMBERS.add_last(5)
    s: @[S64] = NUMBERS.getview()
    grow()
    Console.show(s.getslot(0).peek())
    return
