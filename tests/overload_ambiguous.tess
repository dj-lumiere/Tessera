// A float literal fits both float overloads, and nothing prefers one.

routine half(x: B32) -> B32
    block entry()
        return(x.div(2.0))

routine half(x: B64) -> B32
    block entry()
        return(0.0)

routine start() -> Void
    block entry()
        h : B32 = half(3.0)
        return()
