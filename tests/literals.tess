// Byte literals are Byte, character literals are Char, and hex / binary / octal integer literals take their type
// from context.

@[external("c"), symbol("putchar")]
routine c_putchar(%c: CInt) -> CInt

routine put_byte(%b: Byte) -> Void
    block entry():
        c_putchar(%b.to_u8().to_s32())
        return()

/// Maps a byte to a letter class through a switch on byte literals.
routine class_of(%b: Byte) -> Byte
    block entry():
        switch %b:
            b'a' -> return(b'V')
            b'e' -> return(b'V')
            b'\n' -> return(b'N')
            _ -> return(b'C')

routine main() -> S32
    block entry():
        put_byte(class_of(b'a'))
        put_byte(class_of(b'x'))
        put_byte(class_of(b'\n'))
        put_byte(b'\n')
        %snow: Char = '☃'
        %is_snowman: Bool = %snow.to_u32().eq(0x2603)
        %mask: S64 = 0b1010.bitor(0o5)
        %ok_mask: Bool = %mask.eq(15)
        %big: Byte = 0xFF
        %ok_big: Bool = %big.to_u8().eq(255)
        %all: Bool = %is_snowman.bitand(%ok_mask).bitand(%ok_big)
        %code: S32 = %all ? 0 : 1
        return(%code)
