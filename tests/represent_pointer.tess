// A pointer isn't Representable: `{sum}` on a slot would print where the sum is, not the sum, so the build asks
// for {sum.load()} or {sum.to<Addr>()}.

import Standard::Format
import Standard::Os

routine main() -> S32
    shared sum : @S64 <- 0

    block entry()
        sum.load().add(5).store_into(sum)
        Out.write("total: {sum}\n")
        return(0)
