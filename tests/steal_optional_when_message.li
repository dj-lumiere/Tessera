# `when steal taken` on a Box? names the Box? it is, not the &Box it reads as.

import Collections
import Hosted

### A box.
entity Box
    n: U64

### Makes a box.
### :param n: Its number.
### :returns: The box.
common routine Box.construct(n: U64) -> Me
    return Me(n)

routine start() -> None
    slots: &List[Box?] <- .construct(HEAP)
    fresh: &Box <- Box.construct(n: 7) from HEAP
    slots.add_last(steal fresh)
    packed: &List[Box] <- .construct(HEAP)
    steal slots.getslot(0) as taken inject None()
    when steal taken
        is Box as b => packed.add_last(steal b)
        is None => nothing
    drop packed
    drop slots
    return
