### Routines on one type that differ in their parameter types: methods (the receiver counts too), typewise routines,
### `.name(...)` where the type is known, and routines defined for type arguments (`to[B64]`) with different parameters.
import Standard/Format
import Standard/Os

record Celsius
    degrees: B64

routine Celsius.from(degrees: B64) -> Me
    return Me(degrees: degrees)

routine Celsius.from(tenths: S64) -> Me
    d: B64 = tenths.to[B64]() / 10.0
    return Me(degrees: d)

routine Celsius.warmer(me: Me, by: B64) -> Me
    d: B64 = me.degrees + by
    return Me(degrees: d)

routine Celsius.warmer(me: Me, by: Me) -> Me
    d: B64 = me.degrees + by.degrees
    return Me(degrees: d)

routine Celsius.warm(me: @Me, by: B64) -> None
    d: B64 = me.degrees.peek() + by
    d.poke_into(me.degrees)
    return

routine Celsius.warm(me: Me, by: B64) -> Me
    d: B64 = me.degrees + by
    return Me(degrees: d)

routine Celsius.to[B64](me: Me) -> B64
    return me.degrees

routine Celsius.to[B64](me: Me, offset: B64) -> B64
    return me.degrees + offset

routine start() -> None
    a: Celsius = Celsius.from(20.5)
    b: Celsius = .from(215)
    c: Celsius = a.warmer(1.0)
    d: Celsius = a.warmer(b)
    e: Celsius = a.warm(2.0)
    local f: @Celsius <- a
    f.warm(3.0)
    Console.show("{a.degrees} {b.degrees} {c.degrees} {d.degrees}")
    Console.show("{e.degrees} {f.degrees.peek()}")
    Console.show("{a.to[B64]()} {a.to[B64](273.15)}")
    return
