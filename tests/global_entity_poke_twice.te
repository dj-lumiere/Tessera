# A global that holds an entity, filled with poke, is poked again only after its value is taken out: a second poke
# would overwrite the first value without ending it.
import Hosted

entity Noisy
    n: S64

common routine Noisy.construct(n: S64) -> Me
    return Me(n)

routine @Noisy.destruct() -> None
    Console.show("destruct {me.n}")
    return

global G: &Noisy <- .hollow()

routine start() -> None
    G.poke(Noisy.construct(n: 1))
    G.poke(Noisy.construct(n: 2))
    return
