# A poke into a global that holds an entity ends the value it held first: the second poke runs the first value's
# destruct, here and from another routine, and a poke into a hollow global ends nothing.
import Hosted

global G: &Noisy

entity Noisy
    n: S64

common routine Noisy.construct(n: S64) -> Me
    return Me(n)

routine @Noisy.destruct() -> None
    Console.show("destruct {me.n.peek()}")
    return

routine refill() -> None
    G.poke(Noisy.construct(n: 3))
    return

routine start() -> None
    G.poke(Noisy.construct(n: 1))
    Console.show("filled")
    G.poke(Noisy.construct(n: 2))
    Console.show("poked again")
    refill()
    Console.show("holds {G.n.peek()}")
    return
