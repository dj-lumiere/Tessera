// CStr and CWStr are pointers to terminated C text. A literal becomes one where one is expected. Bytes.to<OwnedCStr> /
// to<OwnedCWStr> copy through an allocator into an owner that lends the C text and is released with destruct(), and
// List<Byte>.to<CStr> ends the buffer with a NUL. C's own strlen / wcslen agree.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

#[external("c"), symbol("strlen")]
routine c_strlen(s: CStr) -> USize

#[external("c"), symbol("wcslen")]
routine c_wcslen(s: CWStr) -> USize

routine start() -> Void
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        // literals
        hello : CStr = "hello"
        Out.write("{hello.count()} {c_strlen(hello)} {hello.to<Bytes>()}\n")
        wide : CWStr = "héllo"
        Out.write("{wide.count()} {c_wcslen(wide)}\n")

        // a Bytes view copied into a C string
        text : Bytes = "Tessera language"
        word : Bytes = text.slice(0, 7)
        claim owned_c : @OwnedCStr <- word.to<OwnedCStr>(alloc)
        word_c : CStr = owned_c.to<CStr>()
        Out.write("{word_c.to<Bytes>()} {c_strlen(word_c)}\n")
        owned_c.destruct()

        // a non-BMP character: 2 UTF-16 units on Windows, 1 UTF-32 unit elsewhere
        emoji : Bytes = "a😀b"
        claim owned_w : @OwnedCWStr <- emoji.to<OwnedCWStr>(alloc)
        emoji_w  : CWStr = owned_w.to<CWStr>()
        units    : USize = c_wcslen(emoji_w)
        expected : Bool  = units.between(3, 4)
        Out.write("{expected} {emoji_w.count().eq(units)}\n")
        owned_w.destruct()

        // a List<Byte> built with write, handed to C
        claim buf : @List<Byte> <- .construct(alloc)
        n : S64 = 42
        buf.write("answer = {n}")
        answer : CStr = buf.to<CStr>()
        Out.write("{answer.to<Bytes>()} {c_strlen(answer).to<U64>()} {buf.count()}\n")
        buf.destruct()
        return()
