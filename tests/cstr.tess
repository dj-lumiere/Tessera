// CStr and CWStr are pointers to terminated C text. A literal becomes one where one is expected; Bytes.to_cstr /
// to_cwstr copy through an allocator; List<Byte>.to_cstr ends the buffer with a NUL. C's own strlen / wcslen agree.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

#[external("c"), symbol("strlen")]
routine c_strlen(%s: CStr) -> USize

#[external("c"), symbol("wcslen")]
routine c_wcslen(%s: CWStr) -> USize

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator
        %alloc.store(%heap)

        // literals
        %hello : CStr = "hello"
        print("{%hello.length()} {c_strlen(%hello)} {%hello.to_bytes()}\n")
        %wide : CWStr = "héllo"
        print("{%wide.length()} {c_wcslen(%wide)}\n")

        // a Bytes view copied into a C string
        %text   : Bytes = "Tessera language"
        %word   : Bytes = %text.slice(0, 7)
        %word_c : CStr  = %word.to_cstr(%alloc)
        print("{%word_c.to_bytes()} {c_strlen(%word_c)}\n")
        %word_c.to_ptr().free(%alloc)

        // a non-BMP character: 2 UTF-16 units on Windows, 1 UTF-32 unit elsewhere
        %emoji    : Bytes = "a😀b"
        %emoji_w  : CWStr = %emoji.to_cwstr(%alloc)
        %units    : USize = c_wcslen(%emoji_w)
        %expected : Bool  = %units.between(3, 4)
        print("{%expected} {%emoji_w.length().eq(%units)}\n")
        %emoji_w.to_ptr().free(%alloc)

        // a List<Byte> built with write, handed to C
        %buf_val : List<Byte> = .construct(%alloc)
        claim %buf : @List<Byte>
        %buf.store(%buf_val)
        %n : S64 = 42
        write(%buf, "answer = {%n}")
        %answer : CStr = %buf.to_cstr()
        print("{%answer.to_bytes()} {c_strlen(%answer).to_u64()} {%buf.load().length()}\n")
        %buf.destruct()
        return(0)
