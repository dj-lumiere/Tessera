// BF16's special functions, erf, erfc, gamma and ln_gamma: CORE-MATH ports, correctly rounded, so the same bits on
// every target (BF16 rounds F32's result, recomputing powf, hypot and atan2 in F64 at a BF16 midpoint). Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer is NaN, ln_gamma has +inf
// at 0 and the negative integers.

import Standard::Format
import Standard::Os

routine show(%name: Bytes, %v: BF16) -> Void
    block entry():
        print("{%name} {%v} {%v.bits()}\n")
        return()

routine main() -> S32
    block entry():
        show("erf(0.5)", BF16.erf(0.5))
        show("erf(-4)", BF16.erf(-4.0))
        show("erfc(3)", BF16.erfc(3.0))
        show("erfc(10)", BF16.erfc(10.0))
        show("erfc(-1)", BF16.erfc(-1.0))
        show("gamma(5)", BF16.gamma(5.0))
        show("gamma(0.5)", BF16.gamma(0.5))
        show("gamma(-2.5)", BF16.gamma(-2.5))
        show("gamma(35.5)", BF16.gamma(35.5))
        show("gamma(-0)", BF16.gamma(-0.0))
        show("gamma(-2)", BF16.gamma(-2.0))
        show("ln_gamma(1)", BF16.ln_gamma(1.0))
        show("ln_gamma(2)", BF16.ln_gamma(2.0))
        show("ln_gamma(0.5)", BF16.ln_gamma(0.5))
        show("ln_gamma(-2.5)", BF16.ln_gamma(-2.5))
        show("ln_gamma(100)", BF16.ln_gamma(100.0))
        show("ln_gamma(-3)", BF16.ln_gamma(-3.0))
        // atan2 with a tiny ratio: y / x lands on a BF16 midpoint in F32 and F64 alike, and the true value lies
        // just inside it, so it rounds toward zero.
        show("atan2(0x0003, 2)", BF16.from_bits(0x0003).atan2(2.0))
        show("atan2(0x0007, 2)", BF16.from_bits(0x0007).atan2(2.0))
        // exact midpoints tie to even
        show("hypot(3, 4)", BF16.hypot(3.0, 4.0))
        show("powf(3, 5)", BF16.powf(3.0, 5.0))
        return(0)
