# Thread work that changes a global without an exclusive access to it is a build error: other threads reach a global
# too.

import Standard/Os

global COUNTER: @U64

### Adds `rounds` to the counter.
### :param rounds: How many.
routine bump(rounds: U64) -> None
    each i in 0 til rounds
        COUNTER.poke(COUNTER.peek() + 1)
    then
        return

routine start() -> None
    t: Thread[None] = get_thread[None]()
    t.put_work(entry: bump.to[Callable](), args: 1000)
    t.wait_finished()
    t.give_back()
    return
