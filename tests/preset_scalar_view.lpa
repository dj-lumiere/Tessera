# A number, Bool or choice preset is folded where it is read, and gives a read-only address where one is taken:
# bound with =, passed to a @T parameter, or through getview().

import Hosted

preset LIMIT: U64 = 41
preset ON: Bool = true

routine next_after(at: @U64) -> U64
    return at.peek() + 1

routine start() -> None
    limit: @U64 = LIMIT
    view: @U64 = LIMIT.getview()
    on: @Bool = ON
    Console.show("{LIMIT + 1} {limit.peek()} {next_after(LIMIT)} {view.peek()} {on.peek()}")
    return
