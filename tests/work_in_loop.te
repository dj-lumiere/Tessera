# A piece of work made in a loop's body is put on a ticket in the same pass: every pass makes its own and hands it
# over with steal.

import Standard/Os

routine square(n: S64) -> S64
    return n * n

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    each i in 0 til 4
        work: Work[S64] = square.to[Work](n: i)
        t.put_work(steal work)
        Console.show("{t.retrieve()}")
    drop t
    return
