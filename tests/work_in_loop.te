# Work handed an entity runs once, so a loop makes one in each pass and puts it on the ticket with steal in the same
# pass.

import Standard/Hosted

### A value with nothing in it but its number.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Token) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    each i in 0 til 4
        a: &Token <- Token.construct(i * i)
        work: Work[S64] = look.to[Work](item: steal a)
        t.put_work(steal work)
        Console.show("{t.retrieve()}")
    drop t
    return
