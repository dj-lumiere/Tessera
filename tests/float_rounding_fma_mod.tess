// floor, ceil, trunc, round, round_ties_even, mul_add and mod at their edges. Off AArch64 these work on the bits
// instead of calling libm, and AArch64 uses its instructions. Both give these bits. A NaN prints without its bits,
// whose sign and payload differ between targets.

import Standard/Format
import Standard/Os

routine show(name: Bytes, v: B64) -> Void
    nan: Bool = v.is_nan()
    branch nan
        ? nan()
        : number()

    block nan()
        Out.write("{name} NaN\n")
        return()

    block number()
        Out.write("{name} {v} {v.bits()}\n")
        return()

routine show32(name: Bytes, v: B32) -> Void
    nan: Bool = v.is_nan()
    branch nan
        ? nan()
        : number()

    block nan()
        Out.write("{name} NaN\n")
        return()

    block number()
        Out.write("{name} {v} {v.bits()}\n")
        return()

routine rounding() -> Void
    show(name: "floor(-0.0)", v: B64.floor(-0.0))
    show(name: "floor(-0.5)", v: B64.floor(-0.5))
    show(name: "floor(0x1p-1074)", v: B64.floor(0x1p-1074))
    show(name: "floor(-0x1p-1074)", v: B64.floor(-0x1p-1074))
    show(name: "floor(-4503599627370495.5)", v: B64.floor(-4503599627370495.5))
    show(name: "floor(-inf)", v: B64.floor(B64.NEG_INFINITY))
    show(name: "floor(NaN)", v: B64.floor(B64.NAN))
    show(name: "ceil(-0.5)", v: B64.ceil(-0.5))
    show(name: "ceil(0x1p-1074)", v: B64.ceil(0x1p-1074))
    show(name: "ceil(4503599627370495.5)", v: B64.ceil(4503599627370495.5))
    show(name: "trunc(-1.9999999999999998)", v: B64.trunc(-1.9999999999999998))
    show(name: "trunc(0x1.fffffffffffffp+51)", v: B64.trunc(0x1.fffffffffffffp+51))
    show(name: "round(0.49999999999999994)", v: B64.round(0.49999999999999994))
    show(name: "round(-0.5)", v: B64.round(-0.5))
    show(name: "round(-0.3)", v: B64.round(-0.3))
    show(name: "round(2.5)", v: B64.round(2.5))
    show(name: "round(4503599627370495.5)", v: B64.round(4503599627370495.5))
    show(name: "round_ties_even(2.5)", v: B64.round_ties_even(2.5))
    show(name: "round_ties_even(-3.5)", v: B64.round_ties_even(-3.5))
    show(name: "round_ties_even(-0.5)", v: B64.round_ties_even(-0.5))
    show(name: "round_ties_even(4503599627370495.5)", v: B64.round_ties_even(4503599627370495.5))
    show(name: "round_ties_even(0x1p+52)", v: B64.round_ties_even(0x1p+52))
    show32(name: "B32 floor(-0.5)", v: B32.floor(-0.5))
    show32(name: "B32 ceil(8388607.5)", v: B32.ceil(8388607.5))
    show32(name: "B32 round(0.49999997)", v: B32.round(0.49999997))
    show32(name: "B32 round(-8388607.5)", v: B32.round(-8388607.5))
    show32(name: "B32 round_ties_even(8388606.5)", v: B32.round_ties_even(8388606.5))
    show32(name: "B32 trunc(-0x1p-149)", v: B32.trunc(-0x1p-149))
    return()

routine fma() -> Void
    // a product that cancels c to its last bits, one whose rounding alone would lose c, and results that
    // round into the subnormals or overflow
    x: B64 = 1.0000000000000002
    show(name: "fma(x, x, -1)", v: x.mul_add(a: x, b: -1.0))
    show(name: "fma(x, x, -(x*x))", v: x.mul_add(a: x, b: x.mul(x).neg()))
    show(name: "fma(1+2^-52, 1-2^-53, -1)",
        v: B64.mul_add(1.0000000000000002, a: 0.99999999999999989, b: -1.0))
    show(name: "fma(0x1p-537, 0x1p-537, 0)", v: B64.mul_add(0x1p-537, a: 0x1p-537, b: 0.0))
    show(name: "fma(0x1.8p-538, 0x1p-537, 0)", v: B64.mul_add(0x1.8p-538, a: 0x1p-537, b: 0.0))
    show(name: "fma(0x1p-1074, 0.5, 0)", v: B64.mul_add(0x1p-1074, a: 0.5, b: 0.0))
    show(name: "fma(0x1p-1074, 0.5, -0)", v: B64.mul_add(0x1p-1074, a: 0.5, b: -0.0))
    show(name: "fma(-0x1p-1074, 0.5, 0)", v: B64.mul_add(-0x1p-1074, a: 0.5, b: 0.0))
    show(name: "fma(0x1p-1074, 0x1p-1074, 0x1p-1074)",
        v: B64.mul_add(0x1p-1074, a: 0x1p-1074, b: 0x1p-1074))
    show(name: "fma(0x1p-1074, -0x1p-1074, 0x1p-1074)",
        v: B64.mul_add(0x1p-1074, a: -0x1p-1074, b: 0x1p-1074))
    show(name: "fma(MAX, 2, -MAX)", v: B64.mul_add(B64.MAX, a: 2.0, b: B64.MAX.neg()))
    show(name: "fma(MAX, 2, 0)", v: B64.mul_add(B64.MAX, a: 2.0, b: 0.0))
    show(name: "fma(1, 1, -1)", v: B64.mul_add(1.0, a: 1.0, b: -1.0))
    show(name: "fma(-0, 1, -0)", v: B64.mul_add(-0.0, a: 1.0, b: -0.0))
    show(name: "fma(inf, 0, 1)", v: B64.mul_add(B64.INFINITY, a: 0.0, b: 1.0))
    show(name: "fma(inf, 1, -inf)", v: B64.mul_add(B64.INFINITY, a: 1.0, b: B64.NEG_INFINITY))
    show(name: "fma(2, 3, inf)", v: B64.mul_add(2.0, a: 3.0, b: B64.INFINITY))
    show(name: "fma(0x1p+1000, 0x1p+1000, -inf)",
        v: B64.mul_add(0x1p+1000, a: 0x1p+1000, b: B64.NEG_INFINITY))
    // B32: x*y is a B32 midpoint and z tips it up. The B64 sum rounded to nearest would sit on the midpoint
    show32(name: "B32 fma(1+2^-12, 1+2^-12, 2^-70)",
        v: B32.mul_add(0x1.001p+0, a: 0x1.001p+0, b: 0x1p-70))
    show32(name: "B32 fma(0x1p-75, 0x1p-75, 0)", v: B32.mul_add(0x1p-75, a: 0x1p-75, b: 0.0))
    show32(name: "B32 fma(0x1.8p-76, 0x1p-74, 0)", v: B32.mul_add(0x1.8p-76, a: 0x1p-74, b: 0.0))
    return()

routine remainders() -> Void
    show(name: "mod(5.5, 2)", v: B64.mod(5.5, 2.0))
    show(name: "mod(-5.5, 2)", v: B64.mod(-5.5, 2.0))
    show(name: "mod(-4, 2)", v: B64.mod(-4.0, 2.0))
    show(name: "mod(MAX, 0x1p-1074)", v: B64.mod(B64.MAX, 0x1p-1074))
    show(name: "mod(MAX, 3)", v: B64.mod(B64.MAX, 3.0))
    show(name: "mod(0x1p-1022, 0x1.8p-1073)", v: B64.mod(0x1p-1022, 0x1.8p-1073))
    show(name: "mod(1, 0.1)", v: B64.mod(1.0, 0.1))
    show(name: "mod(0.1, 1)", v: B64.mod(0.1, 1.0))
    show(name: "mod(-0, 1)", v: B64.mod(-0.0, 1.0))
    show(name: "mod(3, inf)", v: B64.mod(3.0, B64.INFINITY))
    show(name: "mod(inf, 3)", v: B64.mod(B64.INFINITY, 3.0))
    show(name: "mod(3, 0)", v: B64.mod(3.0, 0.0))
    show32(name: "B32 mod(1e30, 7)", v: B32.mod(1e30, 7.0))
    show32(name: "B32 mod(-0x1p-149, 0x1p-149)", v: B32.mod(-0x1p-149, 0x1p-149))
    return()

routine start() -> Void
    rounding()
    fma()
    remainders()
    return()
