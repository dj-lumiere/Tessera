/// Routines on one type that differ in their parameter types: methods (the receiver counts too), typewise routines,
/// `.name(...)` where the type is known, and routines defined for type arguments (`to<F64>`) with different parameters.
import Standard::Format
import Standard::Os

record Celsius
    degrees : F64

routine Celsius.from(degrees: F64) -> Me
    block entry()
        return(Me { degrees: degrees })

routine Celsius.from(tenths: S64) -> Me
    block entry()
        d : F64 = tenths.to<F64>().div(10.0)
        return(Me { degrees: d })

routine Celsius.warmer(me: Me, by: F64) -> Me
    block entry()
        d : F64 = me.degrees.add(by)
        return(Me { degrees: d })

routine Celsius.warmer(me: Me, by: Me) -> Me
    block entry()
        d : F64 = me.degrees.add(by.degrees)
        return(Me { degrees: d })

routine Celsius.warm(me: @Me, by: F64) -> Void
    block entry()
        d : F64 = me.degrees.load().add(by)
        d.store_into(me.degrees)
        return()

routine Celsius.warm(me: Me, by: F64) -> Me
    block entry()
        d : F64 = me.degrees.add(by)
        return(Me { degrees: d })

routine Celsius.to<F64>(me: Me) -> F64
    block entry()
        return(me.degrees)

routine Celsius.to<F64>(me: Me, offset: F64) -> F64
    block entry()
        return(me.degrees.add(offset))

routine start() -> Void
    block entry()
        a : Celsius = Celsius.from(20.5)
        b : Celsius = .from(215)
        c : Celsius = a.warmer(1.0)
        d : Celsius = a.warmer(b)
        e : Celsius = a.warm(2.0)
        claim f : @Celsius <- a
        f.warm(3.0)
        Out.write("{a.degrees} {b.degrees} {c.degrees} {d.degrees}\n")
        Out.write("{e.degrees} {f.degrees.load()}\n")
        Out.write("{a.to<F64>()} {a.to<F64>(273.15)}\n")
        return()
