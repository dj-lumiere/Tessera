/// Routines on one type that differ in their parameter types: methods (the receiver counts too), typewise routines,
/// `.name(...)` where the type is known, and routines defined for type arguments (`to[B64]`) with different parameters.
import Standard/Format
import Standard/Os

record Celsius
    degrees: B64

routine Celsius.from(degrees: B64) -> Me
    block entry()
        return(Me(degrees: degrees))

routine Celsius.from(tenths: S64) -> Me
    block entry()
        d: B64 = tenths.to[B64]().div(10.0)
        return(Me(degrees: d))

routine Celsius.warmer(me: Me, by: B64) -> Me
    block entry()
        d: B64 = me.degrees.add(by)
        return(Me(degrees: d))

routine Celsius.warmer(me: Me, by: Me) -> Me
    block entry()
        d: B64 = me.degrees.add(by.degrees)
        return(Me(degrees: d))

routine Celsius.warm(me: @Me, by: B64) -> Void
    block entry()
        d: B64 = me.degrees.load().add(by)
        d.store_into(me.degrees)
        return()

routine Celsius.warm(me: Me, by: B64) -> Me
    block entry()
        d: B64 = me.degrees.add(by)
        return(Me(degrees: d))

routine Celsius.to[B64](me: Me) -> B64
    block entry()
        return(me.degrees)

routine Celsius.to[B64](me: Me, offset: B64) -> B64
    block entry()
        return(me.degrees.add(offset))

routine start() -> Void
    block entry()
        a: Celsius = Celsius.from(20.5)
        b: Celsius = .from(215)
        c: Celsius = a.warmer(1.0)
        d: Celsius = a.warmer(b)
        e: Celsius = a.warm(2.0)
        claim f: @Celsius <- a
        f.warm(3.0)
        Out.write("{a.degrees} {b.degrees} {c.degrees} {d.degrees}\n")
        Out.write("{e.degrees} {f.degrees.load()}\n")
        Out.write("{a.to[B64]()} {a.to[B64](273.15)}\n")
        return()
