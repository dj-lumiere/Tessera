/// Routines on one type that differ in their parameter types: methods (the receiver counts too), typewise routines,
/// `.name(...)` where the type is known, and routines defined for type arguments (`to<F64>`) with different parameters.
import Standard::Format
import Standard::Os

record Celsius
    degrees : F64

routine Celsius.from(degrees: F64) -> Self
    block entry()
        return(Self { degrees: degrees })

routine Celsius.from(tenths: S64) -> Self
    block entry()
        d : F64 = tenths.to<F64>().div(10.0)
        return(Self { degrees: d })

routine Celsius.warmer(self: Self, by: F64) -> Self
    block entry()
        d : F64 = self.degrees.add(by)
        return(Self { degrees: d })

routine Celsius.warmer(self: Self, by: Self) -> Self
    block entry()
        d : F64 = self.degrees.add(by.degrees)
        return(Self { degrees: d })

routine Celsius.warm(self: @Self, by: F64) -> Void
    block entry()
        d : F64 = self.degrees.load().add(by)
        d.store_into(self.degrees)
        return()

routine Celsius.warm(self: Self, by: F64) -> Self
    block entry()
        d : F64 = self.degrees.add(by)
        return(Self { degrees: d })

routine Celsius.to<F64>(self: Self) -> F64
    block entry()
        return(self.degrees)

routine Celsius.to<F64>(self: Self, offset: F64) -> F64
    block entry()
        return(self.degrees.add(offset))

routine main() -> S32
    block entry()
        a : Celsius = Celsius.from(20.5)
        b : Celsius = .from(215)
        c : Celsius = a.warmer(1.0)
        d : Celsius = a.warmer(b)
        e : Celsius = a.warm(2.0)
        claim f : @Celsius <- a
        f.warm(3.0)
        Out.write("{a.degrees} {b.degrees} {c.degrees} {d.degrees}\n")
        Out.write("{e.degrees} {f.degrees.load()}\n")
        Out.write("{a.to<F64>()} {a.to<F64>(273.15)}\n")
        return(0)
