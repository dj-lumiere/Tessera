// A preset is folded by the compiler: literals, other presets, integer and Bool arithmetic and conversions (with
// the stdlib routines' meaning), F32/F64 add/sub/mul/div/neg, max/min, sizeof/alignof, and T.from_bits(...).

import Standard::Format
import Standard::Os

preset BASE: U64 = 40
preset NEXT: U64 = BASE.add(2)
preset TOP_BIT: U128 = U64.MAX.to_u128().add(1)
preset MASK: U32 = 1.shl(31).bitor(0xFF)
preset OUT: U32 = MASK.shl(32)  // a shift by the width or more shifts every bit out
preset SIGN_FILL: S32 = S32.shr(-8, 40)
preset LOW: U8 = TOP_BIT.sub(1).to_u8_wrap()
preset SIGNED: S64 = NEXT.to_s64().neg().div(4)
preset LEFT: S64 = S64.mod(-7, 2)
preset WIDEST: USize = max(sizeof<S32>(), sizeof<S16>(), alignof<S16>())
preset FLAGS: Bool = true.bitand(false).bitnot()
preset THIRD: F64 = F64.div(1.0, 3.0)
preset NEG_TENTH: F32 = F32.neg(0.1)
preset INF16: F16 = F16.from_bits(0x7C00)
preset TWO: F128 = F128.from_bits(0x40000000000000000000000000000000)
preset TABLE: Array<U64, 3> = Array<U64, 3> { BASE, NEXT, BASE.mul(NEXT) }

routine main() -> S32
    block entry():
        print("{NEXT} {TOP_BIT} {MASK} {OUT} {SIGN_FILL} {LOW} {SIGNED} {LEFT} {WIDEST} {FLAGS}\n")
        print("{THIRD} {NEG_TENTH} {INF16} {TWO}\n")
        print("{TABLE.get(0)} {TABLE.get(1)} {TABLE.get(2)}\n")
        return(0)
