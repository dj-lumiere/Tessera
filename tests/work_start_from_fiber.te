# start_from(manager) starts a piece of work on a fiber a FiberManager lends, and its retrieve() waits, gives the
# result, and gives back the fiber. Fibers switch stacks, which only the targets in work_start_from_fiber.arch do.

import Standard/Fiber
import Standard/Os

### Sums 1 to n.
### :param n: The last number.
### :returns: The sum.
routine sum_to(n: U64) -> U64
    each i in 1 to n with total: U64 = 0
        continue with total: total + i
    then
        return total

### Runs the work on a fiber.
routine start() -> None
    fibers: &FiberManager <- .construct(stack_size: 64kib, stack_manager: PAGES, manager: HEAP)
    on_fiber: Work[U64] <- sum_to.to[Work](n: 4)
    on_fiber.start_from(fibers)
    Console.show("{on_fiber.retrieve()}")
    drop on_fiber
    return
