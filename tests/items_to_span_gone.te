# An Items's or a Slots's view of every element is getview(): to[@[T]]() is a build error that says so.

import Hosted

routine start() -> None
    xs: Items[S64, 3] = [1, 2, 3]
    place: &Items[S64, 3] <- xs
    whole: @[S64] = place.to[@[S64]]()
    Console.show(whole.count())
    drop place
    return
