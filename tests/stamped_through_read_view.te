# A stamp read through the view of a shared read access gives a view that reads only: the entity's value can't be
# changed through the link of a record the read access reaches.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### A link to a node, kept by stamp.
record Link
    target: Stamped[Node]

routine start() -> None
    PoolManager.set_up(memory: HEAP)
    node: &Node <- Node.construct(value: 1) from HEAP
    link: &Link <- Link(target: node.stamp())
    reading: ReadAuthorized[Link] <- link.get_shared_read_access()
    view: @Link = reading.getview()
    view.target.peek().fetch().value.poke(5)
    drop reading
    drop node
    return
