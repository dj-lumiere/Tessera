// put_work takes the arguments its entry takes: an entry on an @S64 can't be handed a @U8.

import Standard/Os

routine count_up(n: @S64) -> Void
    (n.peek() + 1).poke_into(n)
    return

routine start() -> Void
    local small: @U8 <- 0
    t: Thread[Void] = get_thread[Void]()
    t.put_work(entry: count_up.to[Callable](), args: small)
    t.wait_finished()
    t.give_back()
    return
