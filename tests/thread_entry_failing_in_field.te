# A field can't say what a ticket's work throws, so a ticket kept in one fails nothing: a ticket whose work's routine
# can fail doesn't go there, and the build error says to receive the failures inside the routine.

import Hosted

crashable BadInputError
    value: S64

### A worker and the ticket it runs on.
entity Worker
    ### The ticket.
    ticket: Thread[S64]

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### n, failing for a negative n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    return n

### Makes a worker from its ticket.
### :param ticket: Its ticket.
### :returns: The worker.
common routine Worker.construct(ticket: Thread[S64]) -> Me
    return Me(ticket: steal ticket)

### Gives the ticket back.
routine @Worker.destruct() -> None
    drop me.ticket
    return

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(checked.to[Work](n: -1))
    worker: &Worker <- Worker.construct(ticket: steal t)
    Console.show("{worker.ticket.retrieve()}")
    drop worker
    return
