# Work handed an entity goes to a ticket on every path: put on one branch of an if and not on the other is a build
# error.

import Standard/Os

### A value with nothing in it but its number.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Token) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

### Runs the work only when asked.
### :param run: Whether to run it.
routine maybe(run: Bool) -> None
    a: &Token <- Token.construct(1)
    work: Work[S64] = look.to[Work](item: steal a)
    if run
        t: Thread[S64] <- get_thread[S64]()
        t.put_work(steal work)
        Console.show("{t.retrieve()}")
        drop t
    return

routine start() -> None
    maybe(true)
    return
