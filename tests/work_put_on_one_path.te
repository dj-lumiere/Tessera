# Every path hands a piece of work to a ticket: put on one branch of an if and not on the other is a build error.

import Standard/Os

routine seven() -> S64
    return 7

### Runs the work only when asked.
### :param run: Whether to run it.
routine maybe(run: Bool) -> None
    work: Work[S64] = seven.to[Work]()
    if run
        t: Thread[S64] <- get_thread[S64]()
        t.put_work(steal work)
        Console.show("{t.retrieve()}")
        drop t
    return

routine start() -> None
    maybe(true)
    return
