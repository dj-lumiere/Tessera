### A backtick name holding a space, a dash and a non-ASCII letter names a local value and a parameter.
import Hosted

routine bump(`step size`: S64) -> S64
    return `step size` + 1

routine start() -> None
    `first place`: S64 = 3
    `second-place`: S64 = bump(`step size`: `first place`)
    `größe`: S64 = `second-place` * 2
    Console.show("{`first place`} {`second-place`} {`größe`}")
    return
