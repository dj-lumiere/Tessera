// Fibers on four threads: four thread tickets each run 16 fibers on their own thread's FIBERS, and every fiber adds
// 1000 to a shared total, yielding between steps. Fibers never move between threads, the total comes out exact, and
// each thread's FIBERS goes when its work is over.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

record Shared
    total: U64

/// Makes a `Shared` from its fields.
/// :param total: Its `total`.
/// :returns: The new value.
routine Shared.construct(total: U64) -> Me
    return(Me(total))

/// Releases nothing: a `Shared` holds no memory of its own.
routine Shared.destruct(me: @Me) -> Void
    return()

routine add_steps(state: @Shared) -> Void
    jump step(0)

    block step(i: U64)
        done: Bool = i.eq(1000)
        branch done
            ? return()
            : add(i)

    block add(i: U64)
        state.total.atomic_fetch_add(1)
        FIBERS.yield()
        jump step(i.add(1))

/// One thread's work: 16 fibers on its FIBERS, run until all have finished.
routine run_fibers(state: @Shared) -> Void
    local fibers: @Array[Fiber[Void], 16] <- .hollow()

    jump start(0)

    block start(i: USize)
        branch i.eq(16)
            ? run()
            : continue
        f: Fiber[Void] = FIBERS.get_fiber[Void]()
        f.put_work(entry: add_steps.to[Callable](), args: state)
        fibers.setitem(index: i, value: f)
        jump start(i.add(1))

    block run()
        FIBERS.run()
        jump give(0)

    block give(i: USize)
        branch i.eq(16)
            ? return()
            : continue
        fibers.getitem(i).give_back()
        jump give(i.add(1))

routine start() -> Void
    local state: @Shared <- Shared(total: 0)
    local threads: @Array[Thread[Void], 4] <- .hollow()

    jump spawn(0)

    block spawn(i: USize)
        branch i.eq(4)
            ? collect(0)
            : continue
        t: Thread[Void] = get_thread[Void]()
        t.put_work(entry: run_fibers.to[Callable](), args: state)
        threads.setitem(index: i, value: t)
        jump spawn(i.add(1))

    block collect(i: USize)
        branch i.eq(4)
            ? report()
            : continue
        t: Thread[Void] = threads.getitem(i)
        t.wait_finished()
        t.give_back()
        jump collect(i.add(1))

    block report()
        Out.write("{state.total.peek()}\n")
        return()
