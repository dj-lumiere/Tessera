// Fibers over four worker threads: 64 fibers each add 1000 to a shared total, yielding between steps, so they move
// between workers as idle ones take them. The total comes out exact, and run returns once every fiber has.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

record Shared
    sched: @FiberManager
    total: U64

routine add_steps(state: @Shared) -> Void
    block entry()
        jump step(0)

    block step(i: U64)
        done: Bool = i.eq(1000)
        branch done
            ? return()
            : add(i)

    block add(i: U64)
        state.total.atomic_fetch_add(1)
        state.sched.peek().yield()
        jump step(i.add(1))

routine start() -> Void
    local alloc: @MemoryManager <- make_heap_memory()
    local stacks: @MemoryManager <- make_stack_memory()
    local sched: @FiberManager <- .construct(4, stacks, alloc)
    local state: @Shared <- Shared(sched: sched, total: 0)

    block entry()
        jump spawn(0)

    block spawn(i: U64)
        done: Bool = i.eq(64)
        branch done
            ? go()
            : one(i)

    block one(i: U64)
        sched.spawn(add_steps.to[Callable](), state, 65536)
        jump spawn(i.add(1))

    block go()
        sched.run()
        Out.write("{state.total.peek()}\n")
        sched.destruct()
        return()
