// Fibers over four worker threads: 64 fibers each add 1000 to a shared total, yielding between steps, so they move
// between workers as idle ones take them. The total comes out exact, and run returns once every fiber has.

import Standard::Alloc
import Standard::Fiber
import Standard::Format
import Standard::Os

record Shared
    sched : @Scheduler
    total : U64

routine add_steps(raw: Addr) -> Void
    block entry():
        shared : @Shared = raw.to<@Shared>()
        jump step(shared, 0)

    block step(shared: @Shared, i: U64):
        done : Bool = i.eq(1000)
        branch done
            ? return()
            : add(shared, i)

    block add(shared: @Shared, i: U64):
        shared.total.atomic_fetch_add(1)
        shared.sched.load().yield()
        jump step(shared, i.add(1))

routine main() -> S32
    block entry():
        claim alloc  : @Allocator <- make_heap_allocator()
        claim stacks : @Allocator <- make_stack_allocator()
        claim sched  : @Scheduler <- .construct(alloc, stacks, 4)
        claim shared : @Shared    <- Shared { sched: sched, total: 0 }
        jump spawn(sched, shared, 0)

    block spawn(sched: @Scheduler, shared: @Shared, i: U64):
        done : Bool = i.eq(64)
        branch done
            ? go(sched, shared)
            : one(sched, shared, i)

    block one(sched: @Scheduler, shared: @Shared, i: U64):
        sched.spawn(add_steps.to<Callable>(), shared, 65536)
        jump spawn(sched, shared, i.add(1))

    block go(sched: @Scheduler, shared: @Shared):
        sched.run()
        Out.write("{shared.total.load()}\n")
        sched.destruct()
        return(0)
