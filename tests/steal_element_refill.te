# steal out of an element's place moves the entity out and leaves the place hollow at run time too: no second holder.
# A value put back with poke makes the place readable again, and the list ends every element once.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

### A counter that says when it ends.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
routine Counter.construct(n: S64) -> Me
    return Me(n)

### Says that it ends.
routine Counter.destruct(me: @Me) -> None
    Console.show("end {me.n.peek()}")
    return

### Writes what the list holds and when each counter ends.
routine start() -> None
    local xs: @List[Counter] <- .construct(DEFAULT_HEAP)

    xs.add_last(Counter.construct(1))
    xs.add_last(Counter.construct(2))
    local taken: @Counter <- steal xs.getslot(0)
    Console.show("taken {taken.n.peek()}")
    xs.getslot(0).poke(Counter.construct(3))
    Console.show("put back {xs.getslot(0).n.peek()}")
    drop taken
    drop xs
    return
