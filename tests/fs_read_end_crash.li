# FileHandle.read_line stops the program at the end of the file with EndOfInputError, at the line of the call, as
# Console.ask_line does at the end of standard input. try h.read_line(manager) and check h.read_line(manager) are the
# forms for reading to the end. This handler prints the crash and exits with status 3.

import Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

routine start() -> None
    manager: @MemoryManager = HEAP
    Crash.report_with(on_crash.to[Callable]())
    tmp: &Directory <- OsEnvironment.temp_directory(manager)
    f: &File <- tmp.file(name: "lapila_fs_read_end_crash.txt", manager)
    OsFileManager.make_file(at: f, replacing: true)
    OsFileManager.write_all(at: f, data: "only line\n")
    h: &FileHandle <- OsFileManager.open_read(at: f)
    first: &[Byte] <- h.read_line(manager)
    Console.show("first: {first.getslice()}")
    drop first
    second: &[Byte] <- h.read_line(manager)
    Console.show("second: {second.getslice()}")
    drop second
    return
