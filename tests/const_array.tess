; Const arrays are read-only static data. K[i] is a place you load from, K alone is its address, and the
; Array methods work through that address.

@[external("c"), callconv("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<I8>) -> I32

const PRIMES: Array<I64, 5> = [2, 3, 5, 7, 11]

; Past the signed range, a literal is a bit pattern (as in SHA-256's round constants).
const WORDS: Array<I32, 3> = [0x428a2f98, 0xb5c0fbcf, -1]

const GRID: Array<Array<I16, 3>, 2> = [[1, 2, 3], [4, 5, 6]]

const HALVES: Array<F64, 2> = [0.5, -2.25]

const FLAGS: Array<Bool, 2> = [true, false]

routine sum_primes() -> I64
    block entry():
        jump loop(0, 0)

    block loop(%i: I64, %acc: I64):
        %done: Bool = %i.sge(5)
        branch %done ? return(%acc) : add(%i, %acc)

    block add(%i: I64, %acc: I64):
        %p: I64 := PRIMES[%i]
        jump loop(%i.add(1), %acc.add(%p))

routine main() -> I32
    block entry():
        c_printf("%lld\n", sum_primes())

        %w1: I32 := WORDS[1]
        %w2: I32 := WORDS[2]
        c_printf("%08x %d\n", %w1, %w2)

        %g: I16 := GRID[1][2]
        c_printf("%d\n", %g.to_i32())

        %h: F64 := HALVES[1]
        c_printf("%g\n", %h)

        %flag: Bool := FLAGS[0]
        c_printf("%d\n", %flag.to_i32())

        ; the bare name is the address
        #table: Ptr<Array<I64, 5>> = PRIMES
        %third: I64 = #table.get(2)
        #first: Ptr<I64> = PRIMES.as_ptr()
        %two:   I64 := #first
        c_printf("%lld %lld\n", %third, %two)

        #elem: Ptr<I64> = PRIMES[4]
        %last: I64 := #elem
        c_printf("%lld\n", %last)
        return(0)
