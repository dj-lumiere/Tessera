// B128.ln where the crude log2 of the CORE-MATH reduction overshoots an index boundary: significands just
// below 2^(k / 2^20) for k = 29, 256, 285, in every binade (subnormals included). There m * r falls below
// 1 and CORE-MATH's logq.c is off by about 2^-20. Each case prints the bits of ln x. The expected values
// are mpmath's ln rounded to nearest-even binary128. "last + 1 ulp" and the last two inputs are outside
// the ranges.

import Standard/Format
import Standard/Os

routine check(out: @Out, name: Span[Byte], x: U128) -> Void
    r: B128 = B128.from_bits(x).ln()
    write_str(out, text: name)
    write_str(out, text: ": ")
    r.bits().represent_hex_into(out)
    write_line(out)
    return()

routine start() -> Void
    out: @Out = Out.writer()
    check(out, name: "B64 0x3FF0001419F90FEC widened", x: 0x3FFF0001419F90FEC000000000000000)
    check(out, name: "k = 29, first", x: 0x3FFF0001419F90000000000000000000)
    check(out, name: "k = 29, middle", x: 0x3FFF0001419F9207CC927853EB477DCF)
    check(out, name: "k = 29, last", x: 0x3FFF0001419F940F9924F0A7D68EFB9F)
    check(out, name: "k = 29, last + 1 ulp", x: 0x3FFF0001419F940F9924F0A7D68EFBA0)
    check(out, name: "k = 29, middle * 2", x: 0x40000001419F9207CC927853EB477DCF)
    check(out, name: "k = 29, middle / 2", x: 0x3FFE0001419F9207CC927853EB477DCF)
    check(out, name: "k = 29, middle * 2^1000", x: 0x43E70001419F9207CC927853EB477DCF)
    check(out, name: "k = 29, middle * 2^-16000", x: 0x017F0001419F9207CC927853EB477DCF)
    check(out, name: "k = 29, middle, subnormal", x: 0x000000000000010001419F9207CC9278)
    check(out, name: "k = 256, first", x: 0x3FFF000B175EF8000000000000000000)
    check(out, name: "k = 256, middle", x: 0x3FFF000B175EFB7BF795D51F8A1D7539)
    check(out, name: "k = 256, last", x: 0x3FFF000B175EFEF7EF2BAA3F143AEA73)
    check(out, name: "k = 256, last + 1 ulp", x: 0x3FFF000B175EFEF7EF2BAA3F143AEA74)
    check(out, name: "k = 256, middle * 2", x: 0x4000000B175EFB7BF795D51F8A1D7539)
    check(out, name: "k = 256, middle / 2", x: 0x3FFE000B175EFB7BF795D51F8A1D7539)
    check(out, name: "k = 256, middle * 2^1000", x: 0x43E7000B175EFB7BF795D51F8A1D7539)
    check(out, name: "k = 256, middle * 2^-16000", x: 0x017F000B175EFB7BF795D51F8A1D7539)
    check(out, name: "k = 256, middle, subnormal", x: 0x00000000000001000B175EFB7BF795D5)
    check(out, name: "k = 285, first", x: 0x3FFF000C590C80000000000000000000)
    check(out, name: "k = 285, middle", x: 0x3FFF000C590C811FCA1AE329FD8D5012)
    check(out, name: "k = 285, last", x: 0x3FFF000C590C823F9435C653FB1AA024)
    check(out, name: "k = 285, last + 1 ulp", x: 0x3FFF000C590C823F9435C653FB1AA025)
    check(out, name: "k = 285, middle * 2", x: 0x4000000C590C811FCA1AE329FD8D5012)
    check(out, name: "k = 285, middle / 2", x: 0x3FFE000C590C811FCA1AE329FD8D5012)
    check(out, name: "k = 285, middle * 2^1000", x: 0x43E7000C590C811FCA1AE329FD8D5012)
    check(out, name: "k = 285, middle * 2^-16000", x: 0x017F000C590C811FCA1AE329FD8D5012)
    check(out, name: "k = 285, middle, subnormal", x: 0x00000000000001000C590C811FCA1AE3)
    check(out, name: "1 + 2^-16", x: 0x3FFF0001000000000000000000000000)
    check(out, name: "1.5", x: 0x3FFF8000000000000000000000000000)
    return()
