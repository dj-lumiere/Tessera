// A value of an overloaded routine says which overload by its Callable type, but .addr() gives an Addr, which doesn't.

routine step(n: S64) -> S64
    block entry()
        return(n.add(1))

routine step(n: U64) -> U64
    block entry()
        return(n.add(1))

routine main() -> S32
    block entry()
        code : Addr = step.addr()
        return(0)
