### One module's overloads may sit in different files. A private overload is in the module's set in every file of
### the module and in no other module's.
module Geometry

routine area(side: S64) -> S64
    return side * side

private routine area(radius: B64) -> B64
    return radius * radius * 3.0

routine scaled_here(n: S64, x: B64) -> B64
    small: B64 = scale(n).to[B64]()
    return small + scale(x)
