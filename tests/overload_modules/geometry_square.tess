/// One module's overloads may sit in different files. A private routine shares its name with the module's in other
/// files, and in its own file it hides the one with the same parameter types.
module Geometry

routine area(side: S64) -> S64
    block entry()
        return(side.mul(side))

internal routine area(radius: F64) -> F64
    block entry()
        return(radius.mul(radius).mul(3.0))

private routine scale(n: S64) -> S64
    block entry()
        return(n.mul(100))

routine scaled_here(n: S64, x: F64) -> F64
    block entry()
        small : F64 = scale(n).to<F64>()
        return(small.add(scale(x)))
