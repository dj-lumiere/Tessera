/// An import brings a module's overload set. A qualified path reaches it too.
import Geometry
import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        side : S64 = 3
        r    : F64 = 1.0
        Out.write("{area(side)} {area(side, 5)} {Geometry::area(4)}\n")
        Out.write("{scale(side)} {scale(r)} {scaled_here(side, r)} {round_area(r)}\n")
        return()
