/// An import brings a module's overload set. A qualified path reaches it too.
import Geometry
import Standard/Format
import Standard/Os

routine start() -> Void
    side: S64 = 3
    r: B64 = 1.0
    Out.write("{area(side)} {area(width: side, height: 5)} {Geometry/area(4)}\n")
    Out.write("{scale(side)} {scale(r)} {scaled_here(n: side, x: r)} {round_area(r)}\n")
    return()
