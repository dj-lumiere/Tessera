module Geometry

routine area(width: S64, height: S64) -> S64
    return width * height

routine scale(n: S64) -> S64
    return n * 2

routine scale(x: B64) -> B64
    return x * 2.0

### The internal overload is visible inside its module.
routine round_area(radius: B64) -> B64
    return area(radius)
