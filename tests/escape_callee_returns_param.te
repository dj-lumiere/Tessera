# A callee hands back the address it is handed, and the caller stores the result into a global.

import Hosted

lateinit global KEPT: &@S64

### Hands the address back.
### :param p: The address.
### :returns: The same address.
routine same(p: @S64) -> @S64
    return p

### The local lives in this frame.
routine fill() -> None
    l: &S64 <- 1234567

    KEPT.poke(same(p: l))
    return

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    for i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    for j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    fill()
    s: S64 = scribble(seed: 6666666)
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
