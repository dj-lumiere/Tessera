# claimed stack slots, heap buffers through libc malloc, indexed loads and stores.

import Standard/Os

@external("c")
@symbol("malloc")
routine c_malloc(size: CSize) -> Addr

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

### Fills data[i] = i * i for i in 0..len, then sums it through a stack slot.
routine sum_of_squares(len: U64) -> U64
    total: &U64 <- 0

    bytes: U64 = len * 8
    raw: Addr = c_malloc(bytes.to[CSize]())
    if raw.is_hollow()
        throw MemoryAllocationError()
    else
        data: @U64 = raw.to[@U64]()

        each i in 0 til len
            data.stride(i).poke((i * i).to[U64]())
        then
            each i2 in 0 til len
                x: U64 = data.stride(i2).peek()
                running: U64 = total.load() + x
                running.poke_into(total)
            then
                c_free(data)
                result: U64 = total.load()
                return result

routine start() -> None
    s: U64 = sum_of_squares(10)
    ok: Bool = s == 285
    code: S32 = when
        ok => 0
        else => 1
    set_exit_code(code)
    return
