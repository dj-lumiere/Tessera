# One C routine declared twice with different types (Rust #46188 in Tessera): the second call would hand C arguments it
# doesn't read and read a result it doesn't give.

import Hosted

### C's abs, as C declares it.
### :param x: A number.
### :returns: Its size.
@external("c")
@symbol("abs")
routine abs_int(x: CInt) -> CInt

### C's abs again, with other types.
### :param x: A number.
### :param y: Another.
### :returns: Something else.
@external("c")
@symbol("abs")
routine abs_wide(x: S64, y: S64) -> B64

### Calls both.
routine start() -> None
    a: CInt = abs_int(-3)
    b: B64 = abs_wide(x: -5, y: 9)
    Console.show("{a} {b}")
    return
