# A throw in a routine that isn't failable stops the program there, with the crashable's name and message, even
# when a try waits further up: the routine between is a wall a failure doesn't pass.

import Standard/Os

crashable NopeError
    nothing

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine NopeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("nope")
    return

### Not failable: its throw stops the program on its line.
### :returns: Never.
routine refuse() -> S64
    throw NopeError()

### Failable, but the failure of refuse never reaches it.
### :returns: Never.
failable routine outer() -> S64
    return refuse() + 1

routine start() -> None
    Console.show("before")
    got: Maybe[S64] = try outer()
    when got
        is S64 as v => Console.show("not reached: {v}")
        is None => Console.show("not reached: none")
    return
