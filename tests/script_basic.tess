# A file's top-level lines are its start: local lines first, routines between the lines, the end of the file returns.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

local alloc: @MemoryManager <- make_heap_memory()
local list: @List[S64] <- .construct(alloc)

list.add_last(twice(n: 21))
first: S64 = list[0]

routine twice(n: S64) -> S64
    return n * 2

Out.write("first: {first}, count: {list.count()}\n")
if first > 40
    Out.write("big\n")
drop list
