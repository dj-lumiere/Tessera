# A view of heap memory the caller passed outlives the routine, so the address of a STACK slot poked through it is a
# build error.

import Hosted

### Pokes the address of a local into the caller's heap memory.
### :param slots: The caller's memory.
routine keep(slots: @[@S32]) -> None
    a: &S32 <- 10

    part: @[@S32] = slots.getslice(0, 1)
    part.getslot(0).poke(a)
    return

routine start() -> None
    held: &[@S32] <- [.hollow()] * 2 from HEAP

    keep(slots: held)
    drop held
    return
