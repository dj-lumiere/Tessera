# Work handed views of memory, its tickets kept in a table that a later loop waits for: allowed.

import Hosted

### Reads a value and keeps it doubled.
### :param slot: The value.
routine double(slot: @S64) -> None
    held: Authorized[S64] <- slot.get_exclusive_access()
    value: @S64 = held.getview()
    value.poke(value.peek() * 2)
    drop held
    return

routine start() -> None
    manager: @MemoryManager = HEAP
    value_memory: &[S64] <- .construct(count: 4, manager: manager)
    ticket_memory: &[Thread[None]] <- .construct(count: 4, manager: manager)
    values: @S64 = value_memory.to[@S64]()
    tickets: @Thread[None] = ticket_memory.to[@Thread[None]]()

    for at in 0 til 4
        slot: @S64 = values.stride(at.to[U64]())
        slot.poke(at.to[S64]() + 1)
        ticket: Thread[None] <- get_thread[None]()
        work_ticket: Work[None] = double.to[Work](slot: slot)
        ticket.put_work(work_ticket)
        tickets.stride(at.to[U64]()).poke(steal ticket)

    for at in 0 til 4
        steal tickets.stride(at.to[U64]()) as ticket inject .hollow()
        ticket.retrieve()
        drop ticket

    for at in 0 til 4
        Console.show("{values.stride(at.to[U64]()).peek()}")
    drop ticket_memory
    drop value_memory
    return
