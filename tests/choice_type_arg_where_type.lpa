# A choice member where a type goes is a build error.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE

### The rank of O.
### :typeparam O: The order.
### :returns: 0 or 1.
routine rank[O]() -> U64
needs Order O
    when O
        Order.RELAXED => return 0
        Order.ACQUIRE => return 1

### Its argument.
### :typeparam T: The type.
### :param x: The value.
### :returns: x.
routine same[T](x: T) -> T
    return x

### Runs.
routine start() -> None
    Console.show("{same[Order.ACQUIRE](1)}")
    return
