# A leading '.' calls a typewise routine of the type the value goes to: a binding's type, a parameter's, a
# block parameter's, or the routine's return type.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine find(target: S64) -> Maybe[U64]
    if target == 7
        return 3
    else
        return None()

routine count(o: Maybe[U64]) -> U64
    when o
        is U64 as total => return total
        is None => return 0

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()

    local list: @List[S64] <- .construct(alloc)
    list.add_last(5)

    none: Maybe[U64] = None()
    grid: Array[S64, 3] = [1, 2, 3]
    found: Maybe[U64] = find(7)
    Out.write("{count(found)}{count(none)}{count(9)}\n")

    carried: Maybe[U64] = 4
    Out.write("{count(carried)}\n")
    return
