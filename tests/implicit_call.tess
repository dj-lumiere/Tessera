// A leading '.' calls a typewise routine of the type the value goes to: a binding's type, a parameter's, a
// block parameter's, or the routine's return type.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine find(target: S64) -> Option<U64>
    block entry():
        hit : Bool = target.eq(7)
        branch hit
            ? return(.Present(3))
            : return(.Absent)

routine count(o: Option<U64>) -> U64
    block entry():
        when o:
            .Present(total) -> return(total)
            .Absent         -> return(0)

routine main() -> S32
    block entry():
        claim alloc : @Allocator <- make_heap_allocator()

        claim list : @List<S64> <- .construct(alloc)
        list.push(5)

        none  : Option<U64>   = .Absent
        grid  : Array<S64, 3> = Array<S64, 3> { 1, 2, 3 }
        found : Option<U64>   = find(7)
        Out.write("{count(found)}{count(none)}{count(.Present(9))}\n")
        jump next(.Present(4))

    block next(carried: Option<U64>):
        Out.write("{count(carried)}\n")
        return(0)
