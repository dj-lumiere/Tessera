// A leading '.' calls a typewise routine of the type the value goes to: a binding's type, a parameter's, a
// block parameter's, or the routine's return type.
routine find(%target: S64) -> Option<U64>
    block entry():
        %hit: Bool = %target.eq(7)
        branch %hit ? return(.some(3)) : return(.none())

routine count(%o: Option<U64>) -> U64
    block entry():
        %has: Bool = %o.tag
        branch %has ? return(%o.value) : return(0)

routine main() -> S32
    block entry():
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = claim
        #alloc.store(%heap)

        %list_val: List<S64> = .construct(#alloc)
        #list: Ptr<List<S64>> = claim
        #list.store(%list_val)
        #list.push(5)

        %none: Option<U64> = .none()
        %grid: Array<S64, 3> = .from([1, 2, 3])
        %found: Option<U64> = find(7)
        print_uint(count(%found))
        print_uint(count(%none))
        print_uint(count(.some(9)))
        println_slice("")
        jump next(.some(4))

    block next(%carried: Option<U64>):
        print_uint(count(%carried))
        println_slice("")
        return(0)
