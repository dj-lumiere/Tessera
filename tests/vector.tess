// Vector[T, N]: lane-wise arithmetic, compares into a mask, select, reductions, and memory. Integer lanes keep the
// scalar rules (add crashes on overflow, _wrap and _clamp don't, and a shift by the lane width shifts everything out),
// and float min and max return the other lane when one is NaN.

import Standard/Format
import Standard/Os

routine show_b32(label: Bytes, v: Vector[B32, 4]) -> Void
    block entry()
        Out.write("{label} {v.getitem(0)} {v.getitem(1)} {v.getitem(2)} {v.getitem(3)}\n")
        return()

routine show_s32(label: Bytes, v: Vector[S32, 4]) -> Void
    block entry()
        Out.write("{label} {v.getitem(0)} {v.getitem(1)} {v.getitem(2)} {v.getitem(3)}\n")
        return()

routine show_mask(label: Bytes, m: Vector[Bool, 4]) -> Void
    block entry()
        Out.write("{label} {m.getitem(0)} {m.getitem(1)} {m.getitem(2)} {m.getitem(3)}\n")
        return()

routine start() -> Void
    block entry()
        a: Vector[B32, 4] = [1.5, -2.0, 4.0, 9.0]
        b: Vector[B32, 4] = .splat(2.0)
        show_b32(label: "add", v: a.add(b))
        show_b32(label: "sub", v: a.sub(b))
        show_b32(label: "mul", v: a.mul(b))
        show_b32(label: "div", v: a.div(b))
        show_b32(label: "neg", v: a.neg())
        show_b32(label: "abs", v: a.abs())
        show_b32(label: "sqrt", v: a.abs().sqrt())
        nan: B32 = B32.NAN
        with: Vector[B32, 4] = a.with(index: 1, x: nan)
        show_b32(label: "min", v: with.min(b))
        show_b32(label: "max", v: with.max(b))
        Out.write("sum {a.sum()} min {a.reduce_min()} max {a.reduce_max()}\n")

        lt: Vector[Bool, 4] = a.lt(b)
        show_mask(label: "lt", m: lt)
        Out.write("all {lt.is_all_true()} any {lt.is_any_true()} none {lt.is_none_true()} count {lt.count_true()}\n")
        show_b32(label: "select", v: lt.select(if_true: a, if_false: b))

        i: Vector[S32, 4] = [1, -8, 2147483647, 40]
        one: Vector[S32, 4] = .splat(1)
        show_s32(label: "add_wrap", v: i.add_wrap(one))
        show_s32(label: "add_clamp", v: i.add_clamp(one))
        show_s32(label: "mul_wrap", v: i.mul_wrap(one.add(one)))
        shift: Vector[S32, 4] = [1, 2, 32, -1]
        show_s32(label: "shl", v: i.shl(shift))
        show_s32(label: "shr", v: i.shr(shift))
        show_s32(label: "bitand", v: i.bitand(Vector[S32, 4].splat(15)))
        show_s32(label: "bitnot", v: i.bitnot())
        show_s32(label: "min", v: i.min(one))
        show_mask(label: "ge", m: i.ge(one))

        u: Vector[U8, 4] = [250, 1, 2, 3]
        u_sum: Vector[U8, 4] = u.add_clamp(Vector[U8, 4].splat(10))
        Out.write("u8 clamp {u_sum.getitem(0)} {u_sum.getitem(1)} min {u.reduce_min()} max {u.reduce_max()}\n")

        claim buf: @Array[S64, 6] <- [10, 20, 30, 40, 50, 60]
        first: @S64 = buf.getslot(1)
        mid: Vector[S64, 4] = .peek_at(first)
        twice: Vector[S64, 4] = mid.add(mid)
        twice.poke_at(first)
        Out.write("memory {buf.getitem(0)} {buf.getitem(1)} {buf.getitem(4)} {buf.getitem(5)} sum {mid.sum()}\n")

        claim slot: @Array[S32, 4] <- i.to[Array[S32, 4]]()
        Out.write("to<Array> {slot.getitem(2)} length {Vector[S32, 4].count()}\n")
        Out.write("sizes {sizeof[Vector[B32, 3]]()} {sizeof[Vector[Bool, 8]]()} {sizeof[Vector[S64, 2]]()}\n")
        return()
