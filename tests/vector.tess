// Vector<T, N>: lane-wise arithmetic, compares into a mask, select, reductions, and memory. Integer lanes keep the
// scalar rules (add crashes on overflow, _wrap and _clamp don't, and a shift by the lane width shifts everything out),
// and float min and max return the other lane when one is NaN.

import Standard::Format
import Standard::Os

routine show_f32(label: Bytes, v: Vector<F32, 4>) -> Void
    block entry()
        Out.write("{label} {v.getitem(0)} {v.getitem(1)} {v.getitem(2)} {v.getitem(3)}\n")
        return()

routine show_s32(label: Bytes, v: Vector<S32, 4>) -> Void
    block entry()
        Out.write("{label} {v.getitem(0)} {v.getitem(1)} {v.getitem(2)} {v.getitem(3)}\n")
        return()

routine show_mask(label: Bytes, m: Vector<Bool, 4>) -> Void
    block entry()
        Out.write("{label} {m.getitem(0)} {m.getitem(1)} {m.getitem(2)} {m.getitem(3)}\n")
        return()

routine main() -> S32
    block entry()
        a : Vector<F32, 4> = Array<F32, 4> { 1.5, -2.0, 4.0, 9.0 }.to<Vector<F32, 4>>()
        b : Vector<F32, 4> = .splat(2.0)
        show_f32("add", a.add(b))
        show_f32("sub", a.sub(b))
        show_f32("mul", a.mul(b))
        show_f32("div", a.div(b))
        show_f32("neg", a.neg())
        show_f32("abs", a.abs())
        show_f32("sqrt", a.abs().sqrt())
        nan  : F32            = F32.NAN
        with : Vector<F32, 4> = a.with(1, nan)
        show_f32("min", with.min(b))
        show_f32("max", with.max(b))
        Out.write("sum {a.sum()} min {a.reduce_min()} max {a.reduce_max()}\n")

        lt : Vector<Bool, 4> = a.lt(b)
        show_mask("lt", lt)
        Out.write("all {lt.all()} any {lt.any()} none {lt.none()} count {lt.count_true()}\n")
        show_f32("select", lt.select(a, b))

        i   : Vector<S32, 4> = Array<S32, 4> { 1, -8, 2147483647, 40 }.to<Vector<S32, 4>>()
        one : Vector<S32, 4> = .splat(1)
        show_s32("add_wrap", i.add_wrap(one))
        show_s32("add_clamp", i.add_clamp(one))
        show_s32("mul_wrap", i.mul_wrap(one.add(one)))
        shift : Vector<S32, 4> = Array<S32, 4> { 1, 2, 32, -1 }.to<Vector<S32, 4>>()
        show_s32("shl", i.shl(shift))
        show_s32("shr", i.shr(shift))
        show_s32("bitand", i.bitand(Vector<S32, 4>.splat(15)))
        show_s32("bitnot", i.bitnot())
        show_s32("min", i.min(one))
        show_mask("ge", i.ge(one))

        u     : Vector<U8, 4> = Array<U8, 4> { 250, 1, 2, 3 }.to<Vector<U8, 4>>()
        u_sum : Vector<U8, 4> = u.add_clamp(Vector<U8, 4>.splat(10))
        Out.write("u8 clamp {u_sum.getitem(0)} {u_sum.getitem(1)} min {u.reduce_min()} max {u.reduce_max()}\n")

        claim buf : @Array<S64, 6> <- { 10, 20, 30, 40, 50, 60 }
        first : @S64           = buf.at(1)
        mid   : Vector<S64, 4> = .load_from(first)
        twice : Vector<S64, 4> = mid.add(mid)
        twice.store_to(first)
        Out.write("memory {buf.getitem(0)} {buf.getitem(1)} {buf.getitem(4)} {buf.getitem(5)} sum {mid.sum()}\n")

        claim slot : @Array<S32, 4> <- i.to<Array<S32, 4>>()
        Out.write("to<Array> {slot.getitem(2)} length {Vector<S32, 4>.count()}\n")
        Out.write("sizes {sizeof<Vector<F32, 3>>()} {sizeof<Vector<Bool, 8>>()} {sizeof<Vector<S64, 2>>()}\n")
        return(0)
