# drop ends a collection and every element it owns first: a counting allocator shows that every block, the inner
# lists' included, is handed back.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Counts
    live: S64

routine counting_alloc(state: Addr, size: USize, align: USize) -> Addr
    counts: @Counts = state.to[@Counts]()
    next_live: S64 = counts.live.peek() + 1
    next_live.poke_into(counts.live)
    heap: MemoryManager = make_heap_memory()
    r: Addr = heap.alloc_fn.call(null, size, align)
    return r

routine counting_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    if old.is_null()
        counts: @Counts = state.to[@Counts]()
        next_live: S64 = counts.live.peek() + 1
        next_live.poke_into(counts.live)
    heap: MemoryManager = make_heap_memory()
    r: Addr = heap.realloc_fn.call(null, old, size, align)
    return r

routine counting_free(state: Addr, memory: Addr) -> None
    if memory.is_null()
        return
    else
        counts: @Counts = state.to[@Counts]()
        remaining_live: S64 = counts.live.peek() - 1
        remaining_live.poke_into(counts.live)
        heap: MemoryManager = make_heap_memory()
        heap.free_fn.call(null, memory)
        return

routine show(label: Span[Byte], counts: @Counts) -> None
    Out.write("{label}")
    live: S64 = counts.live.peek()
    Out.write("{live}\n")
    return

# A list of three inner lists, each with a few elements.
@reshaping(outer)
routine fill(outer: @List[List[S64]], alloc: @MemoryManager) -> None
    each i in 0 til 3
        local inner: @List[S64] <- .construct(alloc)
        inner.add_last(i.to[S64]())
        inner.add_last(7)
        outer.add_last(steal inner)
    then
        return

routine start() -> None
    local counts: @Counts <- (live: 0)

    counting: MemoryManager = MemoryManager(alloc_fn: counting_alloc.to[Callable](),
        realloc_fn: counting_realloc.to[Callable](), free_fn: counting_free.to[Callable](),
        reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null,
        state: counts.to[@Byte]())
    local alloc: @MemoryManager <- counting

    local a: @List[List[S64]] <- .construct(alloc)
    fill(outer: a, alloc)
    show(label: "filled: ", counts)
    drop a
    show(label: "after drop: ", counts)

    counts.live.poke(0)
    local d: @Dict[S64, List[S64]] <- .construct(alloc)
    local v: @List[S64] <- .construct(alloc)
    v.add_last(1)
    d[5] = steal v
    drop d
    show(label: "dict after drop: ", counts)
    return
