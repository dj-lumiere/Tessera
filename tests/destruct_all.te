# drop ends a collection and every element it owns first: a counting memory manager shows that every block, the inner
# lists' included, is handed back.

import Standard/Collections
import Standard/Hosted

record Counts
    live: S64

obeys MemoryManageable[Counts]

routine @Counts.borrow(size: U64, align: U64) -> Addr
    next_live: S64 = me.live.peek() + 1
    next_live.poke_into(me.live)
    return HEAP.borrow(size, align)

@reshaping(at)
routine @Counts.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if at.is_hollow()
        next_live: S64 = me.live.peek() + 1
        next_live.poke_into(me.live)
    return HEAP.reborrow(at, size, align)

routine @Counts.give_back(at: Addr) -> None
    if at.is_hollow()
        return
    else
        remaining_live: S64 = me.live.peek() - 1
        remaining_live.poke_into(me.live)
        HEAP.give_back(at)
        return

routine show(label: @[Byte], counts: @Counts) -> None
    Console.show("{label}", end: "")
    live: S64 = counts.live.peek()
    Console.show("{live}")
    return

# A list of three inner lists, each with a few elements.
@reshaping(outer)
routine fill(outer: @List[List[S64]], manager: @MemoryManager) -> None
    each i: U64 in 0 til 3
        inner: &List[S64] <- .construct(manager)
        inner.add_last(i.to[S64]())
        inner.add_last(7)
        outer.add_last(steal inner)
    then
        return

routine start() -> None
    counts: &Counts <- (live: 0)
    manager: &MemoryManager <- counts.to[MemoryManager]()
    a: &List[List[S64]] <- .construct(manager)

    fill(outer: a, manager)
    show(label: "filled: ", counts)
    drop a
    show(label: "after drop: ", counts)

    counts.live.poke(0)
    d: &Dict[S64, List[S64]] <- .construct(manager)
    v: &List[S64] <- .construct(manager)
    v.add_last(1)
    d[5] = steal v
    drop d
    show(label: "dict after drop: ", counts)
    drop manager
    return
