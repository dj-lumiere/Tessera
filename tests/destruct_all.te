# drop ends a collection and every element it owns first: a counting allocator shows that every block, the inner
# lists' included, is handed back.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Counts
    live: S64

obeys MemoryManageable[Counts]

routine Counts.alloc(me: @Me, size: U64, align: U64) -> Addr
    next_live: S64 = me.live.peek() + 1
    next_live.poke_into(me.live)
    return DEFAULT_HEAP.alloc(size, align)

@reshaping(at)
routine Counts.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    if at.is_null()
        next_live: S64 = me.live.peek() + 1
        next_live.poke_into(me.live)
    return DEFAULT_HEAP.realloc(at, size, align)

routine Counts.free(me: @Me, at: Addr) -> None
    if at.is_null()
        return
    else
        remaining_live: S64 = me.live.peek() - 1
        remaining_live.poke_into(me.live)
        DEFAULT_HEAP.free(at)
        return

routine show(label: Span[Byte], counts: @Counts) -> None
    Out.write("{label}")
    live: S64 = counts.live.peek()
    Out.write("{live}\n")
    return

# A list of three inner lists, each with a few elements.
@reshaping(outer)
routine fill(outer: @List[List[S64]], alloc: @MemoryManager) -> None
    each i: U64 in 0 til 3
        local inner: @List[S64] <- .construct(alloc)
        inner.add_last(i.to[S64]())
        inner.add_last(7)
        outer.add_last(steal inner)
    then
        return

routine start() -> None
    local counts: @Counts <- (live: 0)
    local alloc: @MemoryManager <- counts.to[MemoryManager]()
    local a: @List[List[S64]] <- .construct(alloc)

    fill(outer: a, alloc)
    show(label: "filled: ", counts)
    drop a
    show(label: "after drop: ", counts)

    counts.live.poke(0)
    local d: @Dict[S64, List[S64]] <- .construct(alloc)
    local v: @List[S64] <- .construct(alloc)
    v.add_last(1)
    d[5] = steal v
    drop d
    show(label: "dict after drop: ", counts)
    return
