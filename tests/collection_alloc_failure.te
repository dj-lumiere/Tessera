# The failable forms, received with check, against an allocator that fails after a budget of calls, and the `_checked` forms on empty
# collections and missing keys. Each case inserts 0, 1, 2, ... until the allocator fails, checks that the collection
# still holds exactly what went in, then grants more budget and inserts once more. The budgets reach every failure
# point: a partial Dict / Set rehash, a B-tree leaf split during descent, and a root split whose sibling fails.

import Standard/Collections
import Standard/Os

@external("c")
@symbol("malloc")
routine c_malloc(size: CSize) -> Addr

@external("c")
@symbol("realloc")
routine c_realloc(ptr: Addr, size: CSize) -> Addr

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

# -- the budgeted allocator: a manager that allows `left` more calls, then fails -----------------------------------

record Budget
    left: U64

obeys MemoryManageable[Budget]

routine @Budget.take() -> Bool
    left: U64 = me.left.peek()
    if left == 0
        return false
    (left - 1).poke_into(me.left)
    return true

routine @Budget.alloc(size: U64, align: U64) -> Addr
    if me.take()
        return c_malloc(size.to[CSize]())
    else
        return .hollow()

routine @Budget.realloc(at: Addr, size: U64, align: U64) -> Addr
    if me.take()
        return c_realloc(at, size.to[CSize]())
    else
        return .hollow()

routine @Budget.free(at: Addr) -> None
    c_free(at)
    return

# -- sequences ------------------------------------------------------------------------------------------------------

routine list_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local list: @List[S64] <- .hollow()

    budget.poke(grant)
    list.poke(List[S64].construct(alloc))

    while true with i: S64 = 0
        pushed: Check[None] = check list.add_last(i)
        when pushed
            is None => continue with i: i + 1
            is MemoryAllocationError => break
    Console.show("List, budget {grant}: {list}")
    budget.poke(1)
    list.add_last(99)
    Console.show("  then push: {list}")
    drop list
    return

routine circular_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local deque: @CircularList[S64] <- .hollow()

    budget.poke(grant)
    deque.poke(CircularList[S64].construct(alloc))

    # Alternates ends, so both add_first and add_last reach the allocator.
    while true with i: S64 = 0
        front: Bool = i.mod_trunc(2) == 1
        pushed: Bool = when
            front => try deque.add_first(i)
            else => try deque.add_last(i)
        if pushed
            continue with i: i + 1
        break
    Console.show("CircularList, budget {grant}: {deque}")
    budget.poke(1)
    deque.add_first(99)
    Console.show("  then push_front: {deque}")
    drop deque
    return

routine queue_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local queue: @PriorityQueue[S64, S64] <- .hollow()

    # A queue keeps its priorities and its elements in two arrays, so each growth takes two allocations.
    budget.poke(grant * 2)
    queue.poke(PriorityQueue[S64, S64].construct(alloc))

    # Pushes 100, 99, 98, ..., so each push sifts to the top.
    while true with i: S64 = 0
        value: S64 = S64.sub(100, i)
        pushed: Check[None] = check queue.add(priority: value, element: value)
        when pushed
            is None => continue with i: i + 1
            is MemoryAllocationError => break
    Console.show("PriorityQueue, budget {grant}: {queue.count()} elements, top {queue.first_checked()}")
    budget.poke(2)
    queue.add(priority: 0, element: 0)
    Console.show("  then push: top {queue.remove()}, next {queue.remove_checked()}")
    drop queue
    return

# -- hash collections -----------------------------------------------------------------------------------------------

# Every key below count maps to ten times itself.
routine is_dict_intact(map: @Dict[S64, S64], count: S64) -> Bool
    size: U64 = map.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            value: S64 = map[i]
            if value == i * 10
                continue
            else
                return false
        then
            return true
    else
        return false

routine dict_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local map: @Dict[S64, S64] <- .hollow()

    budget.poke(grant)
    map.poke(Dict[S64, S64].construct(alloc))

    while true with i: S64 = 0
        put: Check[None] = check map.setitem(key: i, value: i * 10)
        when put
            is None => continue with i: i + 1
            is MemoryAllocationError =>
                count: S64 = i
                Console.show(
                    "Dict, budget {grant}: {count} entries, intact {is_dict_intact(map, count)}",
                    end: "")
                budget.poke(5)
                map[count] = count * 10
                Console.show(", then put: intact {is_dict_intact(map, count: count.add(1))}")
                drop map
                return

routine is_set_intact(set: @Set[S64], count: S64) -> Bool
    size: U64 = set.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            if set.has(i)
                continue
            else
                return false
        then
            return true
    else
        return false

routine set_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local set: @Set[S64] <- .hollow()

    budget.poke(grant)
    set.poke(Set[S64].construct(alloc))

    while true with i: S64 = 0
        added: Check[Bool] = check set.add(i)
        when added
            is Bool => continue with i: i + 1
            is MemoryAllocationError =>
                count: S64 = i
                Console.show(
                    "Set, budget {grant}: {count} keys, intact {is_set_intact(set, count)}",
                    end: "")
                budget.poke(4)
                added2: Bool = set.add(count)
                again: Bool = set.add(count)
                Console.show(", then add: {added2}, again {again}, intact {is_set_intact(set, count: count.add(1))}")
                drop set
                return

# -- B-trees --------------------------------------------------------------------------------------------------------

# Rank i holds key i and value ten times i, and get finds each key.
routine is_sorted_dict_intact(map: @SortedDict[S64, S64], count: S64) -> Bool
    size: U64 = map.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            pair: KVPair[S64, S64] = map.get_by_rank(i.to[U64]())
            key: S64 = pair.key
            value: S64 = pair.value
            found: S64 = map[i]
            tens: S64 = i * 10
            pair_right: Bool = key == i and value == tens
            if pair_right and found == tens
                continue
            else
                return false
        then
            return true
    else
        return false

routine sorted_dict_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local map: @SortedDict[S64, S64] <- .hollow()

    budget.poke(grant)
    map.poke(SortedDict[S64, S64].construct(alloc))

    while true with i: S64 = 0
        put: Check[None] = check map.setitem(key: i, value: i * 10)
        when put
            is None => continue with i: i + 1
            is MemoryAllocationError =>
                count: S64 = i
                Console.show(
                    "SortedDict, budget {grant}: {count} entries, intact {is_sorted_dict_intact(map, count)}",
                    end: "")
                budget.poke(3)
                map[count] = count * 10
                Console.show(", then put: intact {is_sorted_dict_intact(map, count: count.add(1))}")
                drop map
                return

routine is_sorted_set_intact(set: @SortedSet[S64], count: S64) -> Bool
    size: U64 = set.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            key: S64 = set.get_by_rank(i.to[U64]())
            if (key == i) and set.has(i)
                continue
            else
                return false
        then
            return true
    else
        return false

routine sorted_set_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local set: @SortedSet[S64] <- .hollow()

    budget.poke(grant)
    set.poke(SortedSet[S64].construct(alloc))

    while true with i: S64 = 0
        added: Check[Bool] = check set.add(i)
        when added
            is Bool => continue with i: i + 1
            is MemoryAllocationError =>
                count: S64 = i
                Console.show(
                    "SortedSet, budget {grant}: {count} keys, intact {is_sorted_set_intact(set, count)}",
                    end: "")
                budget.poke(3)
                added2: Bool = set.add(count)
                Console.show(", then add: {added2}, intact {is_sorted_set_intact(set, count: count.add(1))}")
                drop set
                return

routine is_sorted_list_intact(list: @SortedList[S64], count: S64) -> Bool
    size: U64 = list.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            value: S64 = list[i.to[U64]()]
            position: U64 = list.rank(i)
            rank: S64 = position.to[S64]()
            if value == i and rank == i
                continue
            else
                return false
        then
            return true
    else
        return false

routine sorted_list_case(budget: @U64, grant: U64, alloc: @MemoryManager) -> None
    local list: @SortedList[S64] <- .hollow()

    budget.poke(grant)
    list.poke(SortedList[S64].construct(alloc))

    while true with i: S64 = 0
        pushed: Check[None] = check list.add(i)
        when pushed
            is None => continue with i: i + 1
            is MemoryAllocationError =>
                count: S64 = i
                Console.show(
                    "SortedList, budget {grant}: {count} elements, intact {is_sorted_list_intact(list, count)}",
                    end: "")
                budget.poke(3)
                list.add(count)
                Console.show(", then push: intact {is_sorted_list_intact(list, count: count.add(1))}")
                drop list
                return

# -- the _checked forms -----------------------------------------------------------------------------------------------

routine checked_forms(budget: @U64, alloc: @MemoryManager) -> None
    budget.poke(100)
    local list: @List[S64] <- .construct(alloc)
    Console.show("List: pop_checked {list.remove_last_checked()}", end: "")
    list.add_last(7)
    Console.show(
        ", get_checked(0) {list.getitem_checked(0)}, get_checked(1) {list.getitem_checked(1)}",
        end: "")
    Console.show(", pop_checked {list.remove_last_checked()}")
    drop list

    local deque: @CircularList[S64] <- .construct(alloc)
    Console.show("CircularList: pop_front_checked {deque.remove_first_checked()}", end: "")
    Console.show(", pop_back_checked {deque.remove_last_checked()}", end: "")
    deque.add_last(1)
    deque.add_last(2)
    Console.show(
        ", get_checked(1) {deque.getitem_checked(1)}, get_checked(2) {deque.getitem_checked(2)}",
        end: "")
    Console.show(", pop_front_checked {deque.remove_first_checked()}, pop_checked {deque.remove_last_checked()}")
    drop deque

    local queue: @PriorityQueue[S64, S64] <- .construct(alloc)
    Console.show(
        "PriorityQueue: peek_checked {queue.first_checked()}, pop_checked {queue.remove_checked()}",
        end: "")
    queue.add(priority: 5, element: 5)
    queue.add(priority: 3, element: 3)
    Console.show(", peek_checked {queue.first_checked()}, pop_checked {queue.remove_checked()}")
    drop queue

    local map: @Dict[S64, S64] <- .construct(alloc)
    Console.show("Dict: get_checked(1) {map.getitem_checked(1)}", end: "")
    map[1] = 10
    Console.show(", after put {map.getitem_checked(1)}, get_checked(2) {map.getitem_checked(2)}")
    drop map

    local sorted: @SortedDict[S64, S64] <- .construct(alloc)
    Console.show("SortedDict: get_checked(1) {sorted.getitem_checked(1)}", end: "")
    sorted[1] = 10
    Console.show(", after put {sorted.getitem_checked(1)}, get_checked(2) {sorted.getitem_checked(2)}")
    drop sorted

    local ordered: @SortedList[S64] <- .construct(alloc)
    Console.show("SortedList: get_checked(0) {ordered.getitem_checked(0)}", end: "")
    ordered.add(4)
    Console.show(", after push {ordered.getitem_checked(0)}")
    drop ordered
    return

routine start() -> None
    local manager: @Budget <- (left: 0)
    local alloc: @MemoryManager <- manager.to[MemoryManager]()

    budget: @U64 = manager.left

    each grant: U64 in 0 to 2
        list_case(budget, grant, alloc)
        circular_case(budget, grant, alloc)
        queue_case(budget, grant, alloc)

    # Dict rehashes into 5 arrays and Set into 4, so the budgets stop partway through a rehash too.
    each grant: U64 in 0 to 12
        dict_case(budget, grant, alloc)
        set_case(budget, grant, alloc)

    # Ascending keys fill a root leaf (1 node), split it (2 more), add leaves until the root is full (6 more), then
    # split the root again (2) above one more leaf split: budgets up to 12 fail at each of those steps.
    each grant: U64 in 0 to 12
        sorted_dict_case(budget, grant, alloc)
        sorted_set_case(budget, grant, alloc)
        sorted_list_case(budget, grant, alloc)
    checked_forms(budget, alloc)
    return
