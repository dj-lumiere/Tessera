# each over an emitter in memory: every element until emit throws AbsentValueError, and then.

import Collections
import Hosted

routine start() -> None
    out: @ConsoleOutput = Console.output()
    manager: @MemoryManager = HEAP
    xs: &List[S64] <- .construct(manager)
    xs.add_last(4)
    xs.add_last(9)
    xs.add_last(16)
    it: &ListEmitter[S64] <- xs.emitter()
    each x in it with sum: S64 = 0
        out.write("{x} ")
        continue with sum: sum + x
    then
        out.write("sum {sum}\n")
    drop xs
    return
