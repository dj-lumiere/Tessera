# each over an iterator in memory: every element until emit throws AbsentValueError, and then.

import Standard/Collections
import Standard/Os

routine start() -> None
    out: @ConsoleOutput = Console.output()
    manager: @MemoryManager = HEAP
    local xs: @List[S64] <- .construct(manager)
    xs.add_last(4)
    xs.add_last(9)
    xs.add_last(16)
    local it: @ListIter[S64] <- .construct(xs)
    each x in it with sum: S64 = 0
        out.write("{x} ")
        continue with sum: sum + x
    then
        out.write("sum {sum}\n")
    drop xs
    return
