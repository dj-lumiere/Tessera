# The idle thread on a board without an operating system: both threads of a ThreadManagerByRoundRobin sleep, and the
# flow of run waits for them, so no thread is ready. The core waits for an interrupt (wfi) on the idle thread until the
# timer wakes a sleeper. With nothing left to sleep or wait for, the timer is off.

import Unhosted

global GIC: &InterruptManagerByGic
lateinit global THREADS: &ThreadManagerByRoundRobin
### The threads' slots: 64 KiB, four slots of 16 KiB.
global STACKS: &Items[U64, 8192]

### The serial port of QEMU's virt machine.
### :returns: The port.
routine serial() -> Pl011
    return Pl011.construct(base: 0x09000000)

### Writes the crash's name and place on the serial port and turns the machine off.
### :param name: The crashable's name.
### :param message: Its message.
### :param place: Where it was thrown.
@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    port: &Pl011 <- serial()
    port.write("crash: {name}\n")
    psci_power_off()
    return

### Turns the virt machine's GIC on and makes the thread manager over STACKS, with a slice of 1 ms.
routine prepare_threads() -> None
    GIC.poke(InterruptManagerByGic.construct(distributor: 0x08000000, cpu_interface: 0x08010000))
    GIC.start()
    THREADS.poke(ThreadManagerByRoundRobin.construct(region: STACKS, size: 64kib, stack_size: 16kib,
        slice: Duration.from_milliseconds(1), interrupts: GIC))
    return

### Sleeps twice, 100 ms for napper 0 and 150 ms for napper 1, printing after each. The wakes are 50 ms apart at least,
### so one napper's line is out before the other wakes, on a slow emulator too.
### :param arg: Its number, as an address.
routine nap(arg: Addr) -> None
    number: U64 = ptrtoint[Addr, U64](arg)
    port: &Pl011 <- serial()
    for i in 0 til 2
        THREADS.sleep(Duration.from_milliseconds((100 + number * 50).to[S64]()))
        port.write("napper {number}: nap {i} over\n")
    return

### Turns the managers on and puts the reporting routine in the Crash service's slot.
routine when_power_on() -> None
    prepare_core()
    Crash.report_with(report.to[Callable]())
    return

### Starts the two nappers, runs them, and says whether the idle thread waited for interrupts.
routine start() -> None
    port: &Pl011 <- serial()
    prepare_threads()
    THREADS.launch(entry: nap.to[Callable](), arg: 0)
    THREADS.launch(entry: nap.to[Callable](), arg: 1)
    THREADS.run()
    idled: Bool = THREADS.idle_wakes() >= 4
    port.write("idle woke: {idled}\n")
    psci_power_off()
    return
