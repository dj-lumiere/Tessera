// USize and SSize: the target's pointer width, types of their own with the integer methods.

import Standard::Format

routine main() -> S32
    block entry():
        %n     : USize = 10
        %big   : USize = %n.mul(%n).add(5)
        %back  : SSize = -3
        %moved : SSize = %back.sub(4)
        print("{%big} {%big.div(7)} {%big.mod(7)} {%n.pow(3)} {%n.shl(2)}\n")
        print("{%moved} {%moved.abs()} {%moved.abs_diff(%back)}\n")
        print("{%n.lt(%big)} {%n.compare(%big)} {%n.max(%big)} {%big.is_power_of_two()}\n")
        print("{%big.to_u64()} {%moved.to_s64()} {%big.to_u8()} {%moved.to_usize_checked().is_present()}\n")
        print("{U32.MAX.to_usize()} {S16.MIN.to_ssize()} {%n.to_ssize().neg()} {%back.to_usize_clamp()}\n")
        print("{%n.sub_checked(%big).is_present()} {%n.sub_clamp(%big)} {%n.to_u32_checked().unwrap()}\n")
        print("{%n.hash().eq(%n.to_ssize().hash())}\n")
        return(0)
