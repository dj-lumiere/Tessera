// USize and SSize: the target's pointer width, types of their own with the integer methods.

import Standard::Format

routine main() -> S32
    block entry():
        %n     : USize = 10
        %big   : USize = %n.mul(%n).add(5)
        %back  : SSize = -3
        %moved : SSize = %back.sub(4)
        print("{%big} {%big.div(7)} {%big.mod(7)} {%n.pow(3)} {%n.shl(2)}\n")
        print("{%moved} {%moved.abs()} {%moved.abs_diff(%back)}\n")
        print("{%n.lt(%big)} {%n.compare(%big)} {%n.max(%big)} {%big.is_power_of_two()}\n")
        print("{%big.to<U64>()} {%moved.to<S64>()} {%big.to<U8>()} {%moved.to_checked<USize>().is_present()}\n")
        print("{U32.MAX.to<USize>()} {S16.MIN.to<SSize>()} {%n.to<SSize>().neg()} {%back.to_clamp<USize>()}\n")
        print("{%n.sub_checked(%big).is_present()} {%n.sub_clamp(%big)} {%n.to_checked<U32>().unwrap()}\n")
        print("{%n.hash().eq(%n.to<SSize>().hash())}\n")
        return(0)
