# claim p : @T <- value claims the slot and stores the value in it, where the claim stands.

import Standard/Os

record Point
    x: S64
    y: S64

routine start() -> None
    x: S64 = 4
    n: &S64 <- x + 1
    p: &Point <- (x: 1, y: n.load())
    a: &Array[S64, 3] <- [7, 8, 9]
    Console.show("{n.load()} {p.y.peek()} {a.getitem(2)}")
    return
