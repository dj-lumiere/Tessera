# A float conversion that turns a finite value into an infinity crashes with NumericOverflowError at the caller's
# line: to[T]() is @track_caller. to_unchecked[T]() gives the infinity, an infinity or NaN input passes through both
# forms, and a value in range is the same in both.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("float_crash_narrow.te")
    Console.show("crashed: {name}: {message} (this file {here}, line {place.line.peek()})")
    exit(3)

routine start() -> None
    big: B64 = 1.0e300
    wide: B32 = 1.0e30
    huge: B128 = B64.to[B128](1.0e300)
    tall: BF16 = 1.0e30
    most: U128 = U128.MAX
    Console.show("{big.to_unchecked[B32]()} {(-big).to_unchecked[B16]()} {big.to_unchecked[BF16]()}")
    Console.show("{wide.to_unchecked[B16]()} {wide.to_unchecked[BF16]()} {tall.to_unchecked[B16]()}")
    Console.show("{huge.to_unchecked[B64]()} {huge.to_unchecked[B32]()} {huge.to_unchecked[B16]()} {huge.to_unchecked[BF16]()}")
    Console.show("{most.to_unchecked[B32]()} {most.to[B64]()}")
    top: B64 = inf
    hole: B64 = nan
    Console.show("{top.to[B32]()} {(-top).to[B16]()} {hole.to[B32]()} {hole.to[BF16]()}")
    Console.show("{B64.to[B32](0.1) == B64.to_unchecked[B32](0.1)} {B64.to[B16](65504.0)}")
    r: B16 = big.to[B16]()
    Console.show("not reached {r}")
    return
