# A standard library routine handed a routine value can reach what that routine reaches: the view of what the global
# holds ends at the call that hands `grow` to a thread.

import Collections
import Hosted

lateinit global NUMBERS: &List[S64]

routine grow() -> None
    NUMBERS.add_last(6)
    return

routine start() -> None
    NUMBERS.poke(List[S64].construct(manager: HEAP))
    NUMBERS.add_last(5)
    t: Thread[None] <- get_thread[None]()
    s: @[S64] = NUMBERS.getview()
    t.put_callable(entry: grow.to[Callable]())
    Console.show(s.getslot(0).peek())
    t.retrieve()
    drop t
    return
