### Optional[T] is Equatable only when T is: `conform Equatable[Optional[T]] when T: typename, Equatable[T]`.
record Point
    x: S64

routine same[T](a: T, b: T) -> Bool
needs T: typename, Equatable[T]
    return a == b

routine start() -> None
    p: Optional[Point] = None()
    s: Bool = same(a: p, b: p)
    return
