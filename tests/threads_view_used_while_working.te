# The view of an exclusive access handed to thread work is the work's until it is waited for: the routine that handed
# it neither uses nor gives it back before the wait.

import Standard/Os

### Doubles the value.
### :param value: An exclusive access to it.
routine double(value: Authorized[U64]) -> None
    at: @U64 = value.getview()
    at.poke(at.peek() * 2)
    return

routine start() -> None
    n: &U64 <- 21

    view: Authorized[U64] <- n.get_exclusive_access()
    t: Thread[None] <- get_thread[None]()
    work_t: Work[None] = double.to[Work](value: view)
    t.put_work(work_t)
    view.getview().poke(1)
    t.retrieve()
    drop t
    drop view
    return
