# A field Node? is given back once: a destruct that drops it twice is a build error.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

### Ends the rest of the list, twice.
routine @Node.destruct() -> None
    drop me.next
    drop me.next
    return

routine start() -> None
    first: &Node <- Node.construct(1)
    return
