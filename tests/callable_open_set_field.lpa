# A Callable kept in a field is open to any failure: a routine value that may fail goes there, and a call through it passes
# the failure to the caller. try gives None, and a check needs an else arm for the failures it doesn't name.

import Hosted

crashable BadInputError
    value: S64

crashable TooBigError
    value: S64

### A handler kept in a field.
record Handler
    action: Callable[(S64,), S64]

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine TooBigError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("too big {me.value}")
    return

### n, failing for a negative or a large n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    if n > 100
        throw TooBigError(value: n)
    return n

### Twice n and it never fails.
### :param n: The number.
### :returns: Twice n.
infallible routine twice(n: S64) -> S64
    return n * 2

### Runs the example.
routine start() -> None
    strict: Handler = Handler(action: checked.to[Callable]())
    plain: Handler = Handler(action: twice.to[Callable]())
    lambda: Handler = Handler(action: (n) => n + 1)
    Console.show("ok {strict.action.call(7)}")
    Console.show("plain {plain.action.call(7)}")
    Console.show("lambda {lambda.action.call(7)}")
    Console.show("try {try strict.action.call(-1)}")
    Console.show("try ok {try strict.action.call(8)}")
    when check strict.action.call(500)
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        else as other => Console.show("another failure: {other.name()}")
    when check strict.action.call(-3)
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        else as other => Console.show("another failure: {other.name()}")
    return
