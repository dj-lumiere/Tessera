# until runs its body until its condition holds, tested before each round, and carries values like any loop. Its
# then runs once the loop is left.
import Standard/Hosted

routine start() -> None
    until n == 1 with n: U64 = 27, steps: U64 = 0
        if n % 2 == 0
            continue with n: n // 2, steps: steps + 1
        continue with n: 3 * n + 1, steps: steps + 1
    then
        Console.show("27 reaches 1 in {steps} steps")
    return
