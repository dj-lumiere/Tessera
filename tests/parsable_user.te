# A type of a program's own becomes Parsable by defining the conversion from text, failable @[Byte].to[Celsius], and
# conforming: text.to[Celsius]() and Console.ask[Celsius]() then work for it as for the built-in numbers. The stdlib's
# own to[...] conversions on @[Byte] (to[@[Byte]]) still pick their concrete routine.

import Standard/Os

record Celsius
obeys Parsable[Celsius]
    degrees: S32

### A temperature written as a number followed by "C": "21C".
failable routine @[Byte].to[Celsius]() -> Celsius
    if not me.has_suffix("C")
        throw InvalidValueError(text: me, target: "Celsius")
    digits: Me = me.slice(start: 0, end: me.count() - 1)
    d: S32 = when check digits.to[S32]()
        is S32 as degrees => degrees
    return Celsius(degrees: d)

routine start() -> None
    text: @[Byte] = "21C"
    t: Celsius = text.to[Celsius]()
    Console.show("{t.degrees}")
    wrong: @[Byte] = "21F"
    when check wrong.to[Celsius]()
        is Celsius => Console.show("read")
        is Crashables as error => Console.show("{error}")
    span: @[Byte] = text.getview()
    Console.show("{span.count()}")
    return
