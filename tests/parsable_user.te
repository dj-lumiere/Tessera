# A type of a program's own becomes Parsable by defining the conversion from text, Span[Byte].to_result[Celsius], and
# conforming: text.to[Celsius]() and In.read[Celsius]() then work for it as for the built-in numbers. The stdlib's
# own to[...] conversions on Span[Byte] (to[Span[Byte]]) still pick their concrete routine.

import Standard/Format
import Standard/Os

record Celsius
obeys Parsable[Celsius]
    degrees: S32

### A temperature written as a number followed by "C": "21C".
routine Span[Byte].to_result[Celsius](me: Me) -> Result[Celsius, ParseError]
    if me.has_suffix("C")
        digits: Me = me.slice(start: 0, end: me.count() - 1)
        n: Result[S32, ParseError] = digits.to_result[S32]()
        when n
            is S32 as d => return Celsius(degrees: d)
            is ParseError as error => return error
    else
        return ParseError.INVALID

routine start() -> None
    text: Span[Byte] = "21C"
    t: Celsius = text.to[Celsius]()
    Out.write("{t.degrees}\n")
    wrong: Span[Byte] = "21F"
    r: Result[Celsius, ParseError] = wrong.to_result[Celsius]()
    Out.write("{r.unwrap_failure().diagnose()}\n")
    span: Span[Byte] = text.getview()
    Out.write("{span.count()}\n")
    return
