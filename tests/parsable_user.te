# A type of a program's own becomes Parsable by defining the conversion from text, @[Byte].to_result[Celsius], and
# conforming: text.to[Celsius]() and Console.ask[Celsius]() then work for it as for the built-in numbers. The stdlib's
# own to[...] conversions on @[Byte] (to[@[Byte]]) still pick their concrete routine.

import Standard/Format
import Standard/Os

record Celsius
obeys Parsable[Celsius]
    degrees: S32

### A temperature written as a number followed by "C": "21C".
routine @[Byte].to_result[Celsius](me: Me) -> Result[Celsius, ParseError]
    if me.has_suffix("C")
        digits: Me = me.slice(start: 0, end: me.count() - 1)
        n: Result[S32, ParseError] = digits.to_result[S32]()
        when n
            is S32 as d => return Celsius(degrees: d)
            is ParseError as error => return error
    else
        return ParseError.INVALID

routine start() -> None
    text: @[Byte] = "21C"
    t: Celsius = text.to[Celsius]()
    Console.show("{t.degrees}")
    wrong: @[Byte] = "21F"
    r: Result[Celsius, ParseError] = wrong.to_result[Celsius]()
    Console.show("{r.unwrap_failure().diagnose()}")
    span: @[Byte] = text.getview()
    Console.show("{span.count()}")
    return
