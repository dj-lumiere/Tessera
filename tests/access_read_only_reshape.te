# The view of a shared read access reads only: handing it to a routine that may move its memory (@reshaping) is a
# build error.

import Standard/Collections
import Standard/Hosted

routine start() -> None
    xs: &List[S64] <- .construct(HEAP)

    reading: ReadAuthorized[List[S64]] <- xs.get_shared_read_access()
    reading.getview().add_last(1)
    drop reading
    drop xs
    return
