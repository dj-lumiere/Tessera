# A lambda, `(a, b) => a.add(b)`, is a routine written where its value goes: one expression on one line, its
# parameter types those of the Callable it becomes. It uses its parameters, presets, globals, and routines.

import Collections
import Hosted

preset OFFSET: S64 = 100

### Applies `f` to `a` and `b`.
### :param f: The routine.
### :param a: The first value.
### :param b: The second value.
### :returns: What `f` returns.
routine apply(f: Callable[(S64, S64), S64], a: S64, b: S64) -> S64
    return f.call(a, b)

### Folds `f` over 1, 2, 3.
### :typeparam T: The value type.
### :param f: The step.
### :param start: The first value.
### :returns: The folded value.
routine fold[T](f: Callable[(T, S64), T], start: T) -> T
needs T: typename
    one: T = f.call(start, 1)
    two: T = f.call(one, 2)
    return f.call(two, 3)

routine start() -> None
    sum: S64 = apply(f: (a, b) => a + b, a: 2, b: 3)
    far: S64 = apply(f: (a, b) => a * b + OFFSET, a: 2, b: 3)
    double: Callable[(S64,), S64] = (x) => x * 2
    none: Callable[(), S64] = () => 7
    say: Callable[(S64,), None] = (n) => Console.show("said {n}")
    total: B64 = fold(f: (acc, n) => acc + n.to[B64](), start: 0.5)
    Console.show("{sum} {far} {double.call(21)} {none.call()} {total}")
    say.call(5)
    return
