// A choice's and a variant's derived represent needs no import of Standard/Format: print writes them as they are.

import Standard/Os

choice Direction: U8
    NORTH
    SOUTH

variant Move
    Step: Direction
    Stay

routine start() -> Void
    block entry()
        d: Direction = Direction.SOUTH
        m: Move = .Step(Direction.NORTH)
        Out.write("{d} {m} {Move.Stay}\n")
        return()
