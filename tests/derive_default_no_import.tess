// A choice's and a variant's derived represent needs no import of Standard/Format: print writes them as they are.

import Standard/Os

choice Direction: U8
    NORTH
    SOUTH

#derive(Representable, Diagnosable)
record Stay

variant Move
    Direction
    Stay

/// Makes a `Stay` from its fields.
/// :returns: The new value.
routine Stay.construct() -> Me
    return(Me())

/// Releases nothing: a `Stay` holds no memory of its own.
routine Stay.destruct(me: @Me) -> Void
    return()

/// Releases nothing: a `Move` holds no memory of its own.
routine Move.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    d: Direction = Direction.SOUTH
    m: Move = Direction.NORTH
    rest: Move = Stay()
    Out.write("{d} {m} {rest}\n")
    return()
