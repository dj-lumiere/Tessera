// text.to<T>() crashes on text that isn't a T, with InvalidValueError and a message naming the text and the type, at
// the line of the call (to<T> is #track_caller). This handler prints them and exits with status 3.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    block entry()
        good : Bytes = "300"
        n    : U16   = good.to<U16>()
        Out.write("{n}\n")
        bad : Bytes = "300"
        m   : U8    = bad.to<U8>()
        Out.write("{m}\n")
        return(0)
