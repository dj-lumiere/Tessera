# List.swap exchanges two elements in place: record elements trade places, and the same index twice changes nothing.

import Standard/Collections
import Standard/Os

### A point on the plane.
record Point
    x: S64
    y: S64

### Writes the points in order.
### :param points: The list to write.
routine show(points: @List[Point]) -> None
    each i in 0 til points.count()
        point: Point = points[i]
        Console.show("({point.x}, {point.y}) ", end: "")
    Console.show("")
    return

### Swaps a few pairs and writes the list after each.
routine start() -> None
    points: &List[Point] <- .construct()

    points.add_last(Point(x: 1, y: 2))
    points.add_last(Point(x: 3, y: 4))
    points.add_last(Point(x: 5, y: 6))
    show(points)
    points.swap(first: 0, second: 2)
    show(points)
    points.swap(first: 1, second: 1)
    show(points)
    points.swap(first: 2, second: 1)
    show(points)
    drop points
    return
