// Dict<S64, S64> against a model. An LCG drives random put / remove / contains / get in three phases (few keys,
// many keys to force rehashing, then a small key range on the large map). Every 500 operations a checkpoint prints the length, a running
// checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

routine Rng.below(self: @Self, bound: USize) -> USize
    block entry()
        state : U64 = self.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        self.state.store(next)
        bucket : U64   = next.shr(33).mod(bound.to<U64>())
        value  : USize = bucket.to<USize>()
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry()
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<W>(out: @W, label: Bytes, value: S64) -> Void
require W: typename, Writer<W>
    block entry()
        out.write(" {label} {value}")
        return()

// Folds every (key, value) pair in iteration order.
routine iteration_hash(map: @Dict<S64, S64>) -> S64
    block entry()
        iter_val : DictIter<S64, S64> = .construct(map)
        claim iter : @DictIter<S64, S64> <- iter_val
        jump next(iter, 0)

    block next(iter: @DictIter<S64, S64>, hash: S64)
        item : Option<KVPair<S64, S64>> = iter.next()
        when item
            .Present(pair) -> fold(iter, hash, pair)
            .Absent        -> return(hash)

    block fold(iter: @DictIter<S64, S64>, hash: S64, pair: KVPair<S64, S64>)
        key   : S64 = pair.key
        value : S64 = pair.value
        jump next(iter, mix(mix(hash, key), value))

routine checkpoint(out: @BufWriter<Out>, map: @Dict<S64, S64>, phase: USize, op: USize,
    results: S64) -> Void
    block entry()
        out.write("phase {phase}")
        labeled(out, "op", op.to<S64>())
        size : USize = map.load().count()
        labeled(out, "length", size.to<S64>())
        labeled(out, "results", results)
        labeled(out, "iteration", iteration_hash(map))
        out.write("\n")
        return()

// Runs ops random operations on keys below keys. Returns the updated results checksum.
routine run_phase(out: @BufWriter<Out>, map: @Dict<S64, S64>, rng: @Rng, phase: USize, ops: USize,
    keys: USize, results: S64) -> S64
    block entry()
        jump next(0, results)

    block next(op: USize, checksum: S64)
        done : Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        key       : S64   = rng.below(keys).to<S64>()
        kind      : USize = rng.below(10)
        is_put    : Bool  = kind.lt(5)
        is_remove : Bool  = kind.lt(7)
        when
            is_put    -> put(op, checksum, key)
            is_remove -> remove(op, checksum, key)
            else      -> lookup(op, checksum, key)

    block put(op: USize, checksum: S64, key: S64)
        value : S64 = rng.below(1000000).to<S64>()
        map.put(key, value)
        jump record(op, checksum, value)

    block remove(op: USize, checksum: S64, key: S64)
        removed : Bool = map.remove(key)
        jump record(op, checksum, removed.to<S64>())

    block lookup(op: USize, checksum: S64, key: S64)
        found : Bool = map.load().contains(key)
        branch found
            ? get(op, checksum, key)
            : record(op, checksum, -1)

    block get(op: USize, checksum: S64, key: S64)
        value : S64 = map.load().getitem(key)
        jump record(op, checksum, value)

    block record(op: USize, checksum: S64, result: S64)
        mixed   : S64   = mix(checksum, result)
        op_next : USize = op.add(1)
        report  : Bool  = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out, map, phase, op, checksum)
        jump next(op, checksum)

// Copies from into to in iteration order, but starting from its second half, so the two maps hold the same pairs in
// a different insertion order.
routine copy_rotated(from: @Dict<S64, S64>, to: @Dict<S64, S64>) -> Void
    block entry()
        size : USize = from.load().count()
        half : USize = size.div(2)
        jump pass(0, half, true)

    block pass(pass: USize, half: USize, second: Bool)
        done     : Bool               = pass.eq(2)
        iter_val : DictIter<S64, S64> = .construct(from)
        claim iter : @DictIter<S64, S64> <- iter_val
        branch done
            ? return()
            : next(pass, half, second, iter, 0)

    block next(pass: USize, half: USize, second: Bool, iter: @DictIter<S64, S64>, index: USize)
        item : Option<KVPair<S64, S64>> = iter.next()
        when item
            .Present(pair) -> consider(pass, half, second, iter, index, pair)
            .Absent        -> pass(pass.add(1), half, second.bitnot())

    block consider(pass: USize, half: USize, second: Bool, iter: @DictIter<S64, S64>, index: USize,
        pair: KVPair<S64, S64>)
        in_second : Bool = index.ge(half)
        wanted    : Bool = in_second.eq(second)
        branch wanted
            ? copy(pass, half, second, iter, index, pair)
            : next(pass, half, second, iter, index.add(1))

    block copy(pass: USize, half: USize, second: Bool, iter: @DictIter<S64, S64>, index: USize,
        pair: KVPair<S64, S64>)
        to.put(pair.key, pair.value)
        jump next(pass, half, second, iter, index.add(1))

routine report_eq(out: @BufWriter<Out>, label: Bytes, equal: Bool) -> Void
    block entry()
        out.write("{label} {equal}\n")
        return()

routine main() -> S32
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc : @Allocator      <- make_heap_allocator()
        claim rng   : @Rng            <- Rng { state: 1 }
        claim map   : @Dict<S64, S64> <- .construct(alloc)

        r1 : S64 = run_phase(out, map, rng, 1, 3000, 64, 0)
        r2 : S64 = run_phase(out, map, rng, 2, 8000, 5000, r1)
        r3 : S64 = run_phase(out, map, rng, 3, 4000, 300, r2)

        claim copied : @Dict<S64, S64> <- .construct(alloc)
        report_eq(out, "empty copy equal", map.load().eq(copied.load()))
        copy_rotated(map, copied)
        report_eq(out, "rotated copy equal", map.load().eq(copied.load()))
        report_eq(out, "rotated copy same order", iteration_hash(map).eq(iteration_hash(copied)))
        copied.put(-1, 0)
        report_eq(out, "extra key equal", map.load().eq(copied.load()))
        copied.remove(-1)
        report_eq(out, "extra key removed equal", map.load().eq(copied.load()))
        iter_val : DictIter<S64, S64> = .construct(map)
        claim iter : @DictIter<S64, S64> <- iter_val
        first : KVPair<S64, S64> = iter.next().unwrap()
        copied.put(first.key, first.value.add(1))
        report_eq(out, "changed value equal", map.load().eq(copied.load()))
        copied.destruct()
        map.destruct()
        report_eq(out, "freed is empty", map.load().is_empty())
        out.flush()
        return(0)
