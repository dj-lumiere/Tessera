; Dict<S64, S64> against a model. An LCG drives random put / remove / contains / get in three phases (few keys,
; many keys to force rehashing, then a small key range on the large map). Every 500 operations a checkpoint prints the length, a running
; checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
; The expected output is generated by scripts/gen_collection_tests.py.

record Rng
    state: U64

routine Rng.below(#self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state: U64 := #self.state
        %next:  U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        #self.state = %next
        %value: U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed: S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every (key, value) pair in iteration order.
routine iteration_hash(#map: Ptr<Dict<S64, S64>>) -> S64
    block entry():
        %iter_val: DictIter<S64, S64> = DictIter<S64, S64>.new(#map)
        #iter: Ptr<DictIter<S64, S64>> = alloca<DictIter<S64, S64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<DictIter<S64, S64>>, %hash: S64):
        %item: Option<KVPair<S64, S64>> = #iter.next()
        %more: Bool = %item.tag
        %pair: KVPair<S64, S64> = %item.value
        branch %more ? fold(#iter, %hash, %pair) : return(%hash)

    block fold(#iter: Ptr<DictIter<S64, S64>>, %hash: S64, %pair: KVPair<S64, S64>):
        %key:   S64 = %pair.key
        %value: S64 = %pair.value
        jump next(#iter, mix(mix(%hash, %key), %value))

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #map: Ptr<Dict<S64, S64>>, %phase: U64, %op: U64, %results: S64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op.to_s64())
        labeled(#out, "length", #map.length().to_s64())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#map))
        write_line(#out)
        return()

; Runs %ops random operations on keys below %keys. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #map: Ptr<Dict<S64, S64>>, #rng: Ptr<Rng>,
        %phase: U64, %ops: U64, %keys: U64, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: U64, %results: S64):
        %done: Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: U64, %results: S64):
        %key:       S64  = #rng.below(%keys).to_s64()
        %kind:      U64  = #rng.below(10)
        %is_put:    Bool = %kind.lt(5)
        %is_remove: Bool = %kind.lt(7)
        select:
            %is_put -> put(%op, %results, %key)
            %is_remove -> remove(%op, %results, %key)
            _ -> lookup(%op, %results, %key)

    block put(%op: U64, %results: S64, %key: S64):
        %value: S64 = #rng.below(1000000).to_s64()
        #map.put(%key, %value)
        jump record(%op, %results, %value)

    block remove(%op: U64, %results: S64, %key: S64):
        %removed: Bool = #map.remove(%key)
        jump record(%op, %results, %removed.to_s64())

    block lookup(%op: U64, %results: S64, %key: S64):
        %found: Bool = #map.contains(%key)
        branch %found ? get(%op, %results, %key) : record(%op, %results, -1)

    block get(%op: U64, %results: S64, %key: S64):
        %value: S64 = #map.get(%key)
        jump record(%op, %results, %value)

    block record(%op: U64, %results: S64, %result: S64):
        %mixed:   S64  = mix(%results, %result)
        %op_next: U64  = %op.add(1)
        %report:  Bool = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: U64, %results: S64):
        checkpoint(#out, #map, %phase, %op, %results)
        jump next(%op, %results)

; Copies #from into #to in iteration order, but starting from its second half, so the two maps hold the same pairs in
; a different insertion order.
routine copy_rotated(#from: Ptr<Dict<S64, S64>>, #to: Ptr<Dict<S64, S64>>) -> Void
    block entry():
        %half: U64 = #from.length().div(2)
        jump pass(0, %half, true)

    block pass(%pass: U64, %half: U64, %second: Bool):
        %done: Bool = %pass.eq(2)
        %iter_val: DictIter<S64, S64> = DictIter<S64, S64>.new(#from)
        #iter: Ptr<DictIter<S64, S64>> = alloca<DictIter<S64, S64>>([%iter_val])
        branch %done ? return() : next(%pass, %half, %second, #iter, 0)

    block next(%pass: U64, %half: U64, %second: Bool, #iter: Ptr<DictIter<S64, S64>>, %index: U64):
        %item: Option<KVPair<S64, S64>> = #iter.next()
        %more: Bool = %item.tag
        %pair: KVPair<S64, S64> = %item.value
        branch %more ? consider(%pass, %half, %second, #iter, %index, %pair) : pass(%pass.add(1), %half, %second.bitnot())

    block consider(
            %pass: U64, %half: U64, %second: Bool, #iter: Ptr<DictIter<S64, S64>>, %index: U64,
            %pair: KVPair<S64, S64>):
        %in_second: Bool = %index.ge(%half)
        %wanted:    Bool = %in_second.eq(%second)
        branch %wanted ? copy(%pass, %half, %second, #iter, %index, %pair) : next(%pass, %half, %second, #iter, %index.add(1))

    block copy(
            %pass: U64, %half: U64, %second: Bool, #iter: Ptr<DictIter<S64, S64>>, %index: U64,
            %pair: KVPair<S64, S64>):
        #to.put(%pair.key, %pair.value)
        jump next(%pass, %half, %second, #iter, %index.add(1))

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> S32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 1 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %map_val: Dict<S64, S64> = Dict<S64, S64>.new(#alloc)
        #map: Ptr<Dict<S64, S64>> = alloca<Dict<S64, S64>>([%map_val])

        %r1: S64 = run_phase(#out, #map, #rng, 1, 3000, 64, 0)
        %r2: S64 = run_phase(#out, #map, #rng, 2, 8000, 5000, %r1)
        %r3: S64 = run_phase(#out, #map, #rng, 3, 4000, 300, %r2)

        %copy_val: Dict<S64, S64> = Dict<S64, S64>.new(#alloc)
        #copy: Ptr<Dict<S64, S64>> = alloca<Dict<S64, S64>>([%copy_val])
        report_eq(#out, "empty copy equal", #map.eq(#copy))
        copy_rotated(#map, #copy)
        report_eq(#out, "rotated copy equal", #map.eq(#copy))
        report_eq(#out, "rotated copy same order", iteration_hash(#map).eq(iteration_hash(#copy)))
        #copy.put(-1, 0)
        report_eq(#out, "extra key equal", #map.eq(#copy))
        #copy.remove(-1)
        report_eq(#out, "extra key removed equal", #map.eq(#copy))
        %iter_val: DictIter<S64, S64> = DictIter<S64, S64>.new(#map)
        #iter: Ptr<DictIter<S64, S64>> = alloca<DictIter<S64, S64>>([%iter_val])
        %first: KVPair<S64, S64> = #iter.next().value
        #copy.put(%first.key, %first.value.add(1))
        report_eq(#out, "changed value equal", #map.eq(#copy))
        #copy.free()
        #map.free()
        report_eq(#out, "freed is empty", #map.is_empty())
        #out.flush()
        return(0)
