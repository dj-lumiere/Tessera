# Dict[S64, S64] against a model. An LCG drives random put / remove / has_key / get in three phases (few keys,
# many keys to force rehashing, then a small key range on the large map). Every 500 operations a checkpoint prints the length, a running
# checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
# The expected output comes from an independent Python model of the collection.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[Out]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: USize
    ### How many operations the phase runs.
    ops: USize
    ### How many distinct keys the operations draw from.
    keys: USize

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: USize
    ### The operations run so far in the phase.
    op: USize
    ### The checksum of every result so far.
    results: S64

### Makes a `Harness` from its fields.
### :param out: Its `out`.
### :param rng: Its `rng`.
### :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng) -> Me
    return Me(out, rng)

### Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> None
    return

routine Rng.below(me: @Me, bound: USize) -> USize
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: USize = bucket.to[USize]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: Span[Byte], value: S64) -> None
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

# Folds every (key, value) pair in iteration order.
routine iteration_hash(map: @Dict[S64, S64]) -> S64
    local iter_val: DictIter[S64, S64] = .construct(map)
    local iter: @DictIter[S64, S64] <- iter_val
    local hash: @S64 <- 0

    while true
        item: Maybe[KVPair[S64, S64]] = iter.emit_checked()
        pair: KVPair[S64, S64] = when item
            is KVPair[S64, S64] as pair => pair
            is None => return hash.peek()
        key: S64 = pair.key
        value: S64 = pair.value
        mix(hash: mix(hash: hash.peek(), value: key), value).poke_into(hash)

routine checkpoint(out: @BufWriter[Out], map: @Dict[S64, S64], at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: USize = map.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(map))
    out.write("\n")
    return

# Runs ops random operations on keys below keys. Returns the updated results checksum.
@reshaping(map)
routine run_phase(harness: Harness, map: @Dict[S64, S64], phase: Phase, results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: USize = phase.ops
    local keys: USize = phase.keys

    while op < ops with op: USize = 0, checksum: S64 = results
        key: S64 = rng.below(keys).to[S64]()
        kind: USize = rng.below(10)
        is_put: Bool = kind < 5
        is_remove: Bool = kind < 7
        result: S64 = when
            is_put =>
                value: S64 = rng.below(1000000).to[S64]()
                map[key] = value
                becomes value
            is_remove =>
                removed: Bool = map.remove(key)
                becomes removed.to[S64]()
            else =>
                if map.has_key(key)
                    becomes map[key]
                else
                    becomes -1
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: USize = op + 1
        if op_next % 500 == 0
            checkpoint(out: harness.out, map,
                at: Checkpoint(phase: phase.number, op: op_next, results: mixed))
        continue with op: op_next, checksum: mixed
    then
        return checksum

# Copies from into to in iteration order, but starting from its second half, so the two maps hold the same pairs in
# a different insertion order.
@reshaping(to)
routine copy_rotated(from: @Dict[S64, S64], to: @Dict[S64, S64]) -> None
    local size: USize = from.count()
    local half: USize = size // 2
    local iter: @DictIter[S64, S64] <- .hollow()

    while true with round: USize = 0, second: Bool = true
        done2: Bool = round == 2
        iter_val2: DictIter[S64, S64] = .construct(from)
        iter.poke(iter_val2)
        if done2
            return
        else
            while true with index: USize = 0
                item: Maybe[KVPair[S64, S64]] = iter.emit_checked()
                when item
                    is KVPair[S64, S64] as pair =>
                        in_second: Bool = index >= half
                        if not (in_second == second)
                            continue with index: index + 1
                        else
                            to[pair.key] = pair.value
                            continue with index: index + 1
                    is None => break

            continue with round: round + 1, second: not second

routine report_eq(out: @BufWriter[Out], label: Span[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @Out = Out.writer()
    local out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    local alloc: @MemoryManager <- make_heap_memory()
    local rng: @Rng <- Rng(state: 1)
    local map: @Dict[S64, S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, map, phase: Phase(number: 1, ops: 3000, keys: 64), results: 0)
    r2: S64 = run_phase(harness, map, phase: Phase(number: 2, ops: 8000, keys: 5000), results: r1)
    r3: S64 = run_phase(harness, map, phase: Phase(number: 3, ops: 4000, keys: 300), results: r2)

    local copied: @Dict[S64, S64] <- .construct(alloc)
    report_eq(out, label: "empty copy equal", equal: map.eq(copied))
    copy_rotated(from: map, to: copied)
    report_eq(out, label: "rotated copy equal", equal: map.eq(copied))
    report_eq(out, label: "rotated copy same order",
        equal: iteration_hash(map) == iteration_hash(copied))
    copied[-1] = 0
    report_eq(out, label: "extra key equal", equal: map.eq(copied))
    copied.remove(-1)
    report_eq(out, label: "extra key removed equal", equal: map.eq(copied))
    iter_val: DictIter[S64, S64] = .construct(map)
    local iter: @DictIter[S64, S64] <- iter_val
    first: KVPair[S64, S64] = iter.emit_checked().unwrap()
    copied[first.key] = first.value + 1
    report_eq(out, label: "changed value equal", equal: map.eq(copied))
    drop copied
    drop map
    report_eq(out, label: "freed is empty", equal: map.is_empty())
    out.flush()
    return
