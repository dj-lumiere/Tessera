// Dict[S64, S64] against a model. An LCG drives random put / remove / has_key / get in three phases (few keys,
// many keys to force rehashing, then a small key range on the large map). Every 500 operations a checkpoint prints the length, a running
// checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Rng
    state: U64

/// What every phase works with besides the collection.
record Harness
    /// Where checkpoints are written.
    out: @BufWriter[Out]
    /// The generator that picks each operation.
    rng: @Rng

/// One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    /// The phase's number, as checkpoints print it.
    number: USize
    /// How many operations the phase runs.
    ops: USize
    /// How many distinct keys the operations draw from.
    keys: USize

/// Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    /// The phase's number.
    phase: USize
    /// The operations run so far in the phase.
    op: USize
    /// The checksum of every result so far.
    results: S64

/// Makes a `Rng` from its fields.
/// :param state: Its `state`.
/// :returns: The new value.
routine Rng.construct(state: U64) -> Me
    return(Me(state))

/// Releases nothing: a `Rng` holds no memory of its own.
routine Rng.destruct(me: @Me) -> Void
    return()

/// Makes a `Harness` from its fields.
/// :param out: Its `out`.
/// :param rng: Its `rng`.
/// :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng) -> Me
    return(Me(out, rng))

/// Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> Void
    return()

/// Makes a `Phase` from its fields.
/// :param number: Its `number`.
/// :param ops: Its `ops`.
/// :param keys: Its `keys`.
/// :returns: The new value.
routine Phase.construct(number: USize, ops: USize, keys: USize) -> Me
    return(Me(number, ops, keys))

/// Releases nothing: a `Phase` holds no memory of its own.
routine Phase.destruct(me: @Me) -> Void
    return()

/// Makes a `Checkpoint` from its fields.
/// :param phase: Its `phase`.
/// :param op: Its `op`.
/// :param results: Its `results`.
/// :returns: The new value.
routine Checkpoint.construct(phase: USize, op: USize, results: S64) -> Me
    return(Me(phase, op, results))

/// Releases nothing: a `Checkpoint` holds no memory of its own.
routine Checkpoint.destruct(me: @Me) -> Void
    return()

routine Rng.below(me: @Me, bound: USize) -> USize
    state: U64 = me.state.peek()
    next: U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
    me.state.poke(next)
    bucket: U64 = next.shr(33).mod(bound.to[U64]())
    value: USize = bucket.to[USize]()
    return(value)

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash.mul_wrap(1000003).add_wrap(value)
    return(mixed)

routine labeled[T](out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer[T]
    out.write(" {label} {value}")
    return()

// Folds every (key, value) pair in iteration order.
routine iteration_hash(map: @Dict[S64, S64]) -> S64
    local iter_val: DictIter[S64, S64] = .construct(map)
    local iter: @DictIter[S64, S64] <- iter_val
    local hash: @S64 <- 0

    jump next()

    block next()
        item: Maybe[KVPair[S64, S64]] = iter.emit_checked()
        when item
            is KVPair[S64, S64] as pair => continue
            is Unit => return(hash.peek())
        key: S64 = pair.key
        value: S64 = pair.value
        mix(hash: mix(hash: hash.peek(), value: key), value).poke_into(hash)
        jump next()

routine checkpoint(out: @BufWriter[Out], map: @Dict[S64, S64], at: Checkpoint) -> Void
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: USize = map.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(map))
    out.write("\n")
    return()

// Runs ops random operations on keys below keys. Returns the updated results checksum.
routine run_phase(harness: Harness, map: @Dict[S64, S64], phase: Phase, results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: USize = phase.ops
    local keys: USize = phase.keys

    jump next(0, results)

    block next(op: USize, checksum: S64)
        done: Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        key: S64 = rng.below(keys).to[S64]()
        kind: USize = rng.below(10)
        is_put: Bool = kind.lt(5)
        is_remove: Bool = kind.lt(7)
        when
            is_put => put(op, checksum, key)
            is_remove => remove(op, checksum, key)
            else => lookup(op, checksum, key)

    block put(op: USize, checksum: S64, key: S64)
        value: S64 = rng.below(1000000).to[S64]()
        map.setitem(key, value)
        jump record(op, checksum, value)

    block remove(op: USize, checksum: S64, key: S64)
        removed: Bool = map.remove(key)
        jump record(op, checksum, removed.to[S64]())

    block lookup(op: USize, checksum: S64, key: S64)
        found: Bool = map.has_key(key)
        branch found
            ? get(op, checksum, key)
            : record(op, checksum, -1)

    block get(op: USize, checksum: S64, key: S64)
        value: S64 = map.getitem(key)
        jump record(op, checksum, value)

    block record(op: USize, checksum: S64, result: S64)
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: USize = op.add(1)
        report: Bool = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out: harness.out, map,
            at: Checkpoint(phase: phase.number, op: op, results: checksum))
        jump next(op, checksum)

// Copies from into to in iteration order, but starting from its second half, so the two maps hold the same pairs in
// a different insertion order.
routine copy_rotated(from: @Dict[S64, S64], to: @Dict[S64, S64]) -> Void
    local size: USize = from.count()
    local half: USize = size.div(2)
    local iter: @DictIter[S64, S64] <- .hollow()

    jump pass(0, true)

    block pass(pass: USize, second: Bool)
        done: Bool = pass.eq(2)
        iter_val: DictIter[S64, S64] = .construct(from)
        iter.poke(iter_val)
        branch done
            ? return()
            : next(pass, second, 0)

    block next(pass: USize, second: Bool, index: USize)
        item: Maybe[KVPair[S64, S64]] = iter.emit_checked()
        when item
            is KVPair[S64, S64] as pair => continue
            is Unit => pass(pass.add(1), second.bitnot())
        in_second: Bool = index.ge(half)
        wanted: Bool = in_second.eq(second)
        branch wanted
            ? continue
            : next(pass, second, index.add(1))
        to.setitem(key: pair.key, value: pair.value)
        jump next(pass, second, index.add(1))

routine report_eq(out: @BufWriter[Out], label: Bytes, equal: Bool) -> Void
    out.write("{label} {equal}\n")
    return()

routine start() -> Void
    fd: @Out = Out.writer()
    claim out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    claim alloc: @MemoryManager <- make_heap_memory()
    claim rng: @Rng <- Rng(state: 1)
    claim map: @Dict[S64, S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, map, phase: Phase(number: 1, ops: 3000, keys: 64), results: 0)
    r2: S64 = run_phase(harness, map, phase: Phase(number: 2, ops: 8000, keys: 5000), results: r1)
    r3: S64 = run_phase(harness, map, phase: Phase(number: 3, ops: 4000, keys: 300), results: r2)

    claim copied: @Dict[S64, S64] <- .construct(alloc)
    report_eq(out, label: "empty copy equal", equal: map.peek().eq(copied.peek()))
    copy_rotated(from: map, to: copied)
    report_eq(out, label: "rotated copy equal", equal: map.peek().eq(copied.peek()))
    report_eq(out, label: "rotated copy same order",
        equal: iteration_hash(map).eq(iteration_hash(copied)))
    copied.setitem(key: -1, value: 0)
    report_eq(out, label: "extra key equal", equal: map.peek().eq(copied.peek()))
    copied.remove(-1)
    report_eq(out, label: "extra key removed equal", equal: map.peek().eq(copied.peek()))
    iter_val: DictIter[S64, S64] = .construct(map)
    claim iter: @DictIter[S64, S64] <- iter_val
    first: KVPair[S64, S64] = iter.emit_checked().unwrap()
    copied.setitem(key: first.key, value: first.value.add(1))
    report_eq(out, label: "changed value equal", equal: map.peek().eq(copied.peek()))
    copied.destruct()
    map.destruct()
    report_eq(out, label: "freed is empty", equal: map.is_empty())
    out.flush()
    return()
