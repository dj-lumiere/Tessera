// Dict<S64, S64> against a model. An LCG drives random put / remove / contains / get in three phases (few keys,
// many keys to force rehashing, then a small key range on the large map). Every 500 operations a checkpoint prints the length, a running
// checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
// The expected output is generated by scripts/gen_collection_tests.py.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

routine Rng.below(%self: Ptr<Self>, %bound: USize) -> USize
    block entry():
        %state : U64 = %self.state.load()
        %next  : U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        %self.state.store(%next)
        %value : USize = %next.shr(33).rem(%bound.to_u64()).to_usize()
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed : S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(%out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write(%out, " {%label} {%value}")
        return()

// Folds every (key, value) pair in iteration order.
routine iteration_hash(%map: Ptr<Dict<S64, S64>>) -> S64
    block entry():
        %iter_val : DictIter<S64, S64> = .construct(%map)
        claim %iter : Ptr<DictIter<S64, S64>>
        %iter.store(%iter_val)
        jump next(%iter, 0)

    block next(%iter: Ptr<DictIter<S64, S64>>, %hash: S64):
        %item : Option<KVPair<S64, S64>> = %iter.next()
        when %item:
            .Present(%pair) -> fold(%iter, %hash, %pair)
            .Absent         -> return(%hash)

    block fold(%iter: Ptr<DictIter<S64, S64>>, %hash: S64, %pair: KVPair<S64, S64>):
        %key   : S64 = %pair.key
        %value : S64 = %pair.value
        jump next(%iter, mix(mix(%hash, %key), %value))

routine checkpoint(%out: Ptr<BufWriter<FdWriter>>, %map: Ptr<Dict<S64, S64>>, %phase: USize,
        %op: USize, %results: S64) -> Void
    block entry():
        write(%out, "phase {%phase}")
        labeled(%out, "op", %op.to_s64())
        labeled(%out, "length", %map.load().length().to_s64())
        labeled(%out, "results", %results)
        labeled(%out, "iteration", iteration_hash(%map))
        write(%out, "\n")
        return()

// Runs ops random operations on keys below keys. Returns the updated results checksum.
routine run_phase(%out: Ptr<BufWriter<FdWriter>>, %map: Ptr<Dict<S64, S64>>, %rng: Ptr<Rng>,
        %phase: USize, %ops: USize, %keys: USize, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: USize, %results: S64):
        %done : Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: USize, %results: S64):
        %key       : S64   = %rng.below(%keys).to_s64()
        %kind      : USize = %rng.below(10)
        %is_put    : Bool  = %kind.lt(5)
        %is_remove : Bool  = %kind.lt(7)
        when:
            %is_put    -> put(%op, %results, %key)
            %is_remove -> remove(%op, %results, %key)
            else       -> lookup(%op, %results, %key)

    block put(%op: USize, %results: S64, %key: S64):
        %value : S64 = %rng.below(1000000).to_s64()
        %map.put(%key, %value)
        jump record(%op, %results, %value)

    block remove(%op: USize, %results: S64, %key: S64):
        %removed : Bool = %map.remove(%key)
        jump record(%op, %results, %removed.to_s64())

    block lookup(%op: USize, %results: S64, %key: S64):
        %found : Bool = %map.load().contains(%key)
        branch %found ? get(%op, %results, %key) : record(%op, %results, -1)

    block get(%op: USize, %results: S64, %key: S64):
        %value : S64 = %map.load().get(%key)
        jump record(%op, %results, %value)

    block record(%op: USize, %results: S64, %result: S64):
        %mixed   : S64   = mix(%results, %result)
        %op_next : USize = %op.add(1)
        %report  : Bool  = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: USize, %results: S64):
        checkpoint(%out, %map, %phase, %op, %results)
        jump next(%op, %results)

// Copies from into to in iteration order, but starting from its second half, so the two maps hold the same pairs in
// a different insertion order.
routine copy_rotated(%from: Ptr<Dict<S64, S64>>, %to: Ptr<Dict<S64, S64>>) -> Void
    block entry():
        %half : USize = %from.load().length().div(2)
        jump pass(0, %half, true)

    block pass(%pass: USize, %half: USize, %second: Bool):
        %done     : Bool               = %pass.eq(2)
        %iter_val : DictIter<S64, S64> = .construct(%from)
        claim %iter : Ptr<DictIter<S64, S64>>
        %iter.store(%iter_val)
        branch %done ? return() : next(%pass, %half, %second, %iter, 0)

    block next(%pass: USize, %half: USize, %second: Bool, %iter: Ptr<DictIter<S64, S64>>,
            %index: USize):
        %item : Option<KVPair<S64, S64>> = %iter.next()
        when %item:
            .Present(%pair) -> consider(%pass, %half, %second, %iter, %index, %pair)
            .Absent         -> pass(%pass.add(1), %half, %second.bitnot())

    block consider(%pass: USize, %half: USize, %second: Bool, %iter: Ptr<DictIter<S64, S64>>,
            %index: USize, %pair: KVPair<S64, S64>):
        %in_second : Bool = %index.ge(%half)
        %wanted    : Bool = %in_second.eq(%second)
        branch %wanted
            ? copy(%pass, %half, %second, %iter, %index, %pair)
            : next(%pass, %half, %second, %iter, %index.add(1))

    block copy(%pass: USize, %half: USize, %second: Bool, %iter: Ptr<DictIter<S64, S64>>,
            %index: USize, %pair: KVPair<S64, S64>):
        %to.put(%pair.key, %pair.value)
        jump next(%pass, %half, %second, %iter, %index.add(1))

routine report_eq(%out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write(%out, "{%label} {%equal}\n")
        return()

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim %fd : Ptr<FdWriter>
        %fd.store(%fd_val)
        claim %out : Ptr<BufWriter<FdWriter>>
        %out.construct(%fd)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %rng_val : Rng = Rng { state: 1 }
        claim %rng : Ptr<Rng>
        %rng.store(%rng_val)
        %map_val : Dict<S64, S64> = .construct(%alloc)
        claim %map : Ptr<Dict<S64, S64>>
        %map.store(%map_val)

        %r1 : S64 = run_phase(%out, %map, %rng, 1, 3000, 64, 0)
        %r2 : S64 = run_phase(%out, %map, %rng, 2, 8000, 5000, %r1)
        %r3 : S64 = run_phase(%out, %map, %rng, 3, 4000, 300, %r2)

        %copied_val : Dict<S64, S64> = .construct(%alloc)
        claim %copied : Ptr<Dict<S64, S64>>
        %copied.store(%copied_val)
        report_eq(%out, "empty copy equal", %map.load().eq(%copied.load()))
        copy_rotated(%map, %copied)
        report_eq(%out, "rotated copy equal", %map.load().eq(%copied.load()))
        report_eq(%out, "rotated copy same order", iteration_hash(%map).eq(iteration_hash(%copied)))
        %copied.put(-1, 0)
        report_eq(%out, "extra key equal", %map.load().eq(%copied.load()))
        %copied.remove(-1)
        report_eq(%out, "extra key removed equal", %map.load().eq(%copied.load()))
        %iter_val : DictIter<S64, S64> = .construct(%map)
        claim %iter : Ptr<DictIter<S64, S64>>
        %iter.store(%iter_val)
        %first : KVPair<S64, S64> = %iter.next().unwrap()
        %copied.put(%first.key, %first.value.add(1))
        report_eq(%out, "changed value equal", %map.load().eq(%copied.load()))
        %copied.destruct()
        %map.destruct()
        report_eq(%out, "freed is empty", %map.load().is_empty())
        %out.flush()
        return(0)
