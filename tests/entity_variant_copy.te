# Reading a variant that holds an entity out of its slot copies it: hand it over with steal instead.
import Standard/Os

define Opened = Counter | ParseFailed

### Counts things.
entity Counter
    count: S64

### Why no counter was made.
record ParseFailed
    at: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing: a Counter holds no memory.
routine @Counter.destruct() -> None
    return

### A counter, or why not.
### :param n: Fails when negative.
### :returns: The counter, or the failure.
routine open(n: S64) -> Opened
    if n < 0
        return ParseFailed(at: n)
    return Counter.construct()

### Takes a result over.
### :param r: The result.
routine finish(r: Opened) -> None
    when steal r
        is Counter as c =>
            drop c
        is ParseFailed => nothing
    return

### Hands a copy on.
routine start() -> None
    kept: &Opened <- open(1)

    finish(r: kept.load())
    finish(r: steal kept)
    return
