# Reading a variant that holds an entity out of its slot copies it: hand it over with steal instead.
import Standard/Os

### Counts things.
entity Counter
    count: S64

### Why no counter was made.
record ParseFailed
    at: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing: a Counter holds no memory.
routine @Counter.destruct() -> None
    return

### A counter, or why not.
### :param n: Fails when negative.
### :returns: The counter, or the failure.
routine open(n: S64) -> Result[Counter, ParseFailed]
    if n < 0
        return ParseFailed(at: n)
    return Counter.construct()

### Takes a result over.
### :param r: The result.
routine finish(r: Result[Counter, ParseFailed]) -> None
    when steal r
        is Counter as c =>
            drop c
        is ParseFailed => pass
    return

### Hands a copy on.
routine start() -> None
    local kept: @Result[Counter, ParseFailed] <- open(1)

    finish(r: kept.peek())
    finish(r: steal kept)
    return
