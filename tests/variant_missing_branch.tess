// A when on a variant without an else arm must observe every branch.

record Empty

variant Shape
    B64
    Empty

/// Makes a `Empty` from its fields.
/// :returns: The new value.
routine Empty.construct() -> Me
    return(Me())

/// Releases nothing: a `Empty` holds no memory of its own.
routine Empty.destruct(me: @Me) -> Void
    return()

/// Releases nothing: a `Shape` holds no memory of its own.
routine Shape.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    s: Shape = Empty()
    when s
        is B64 as r => return()
