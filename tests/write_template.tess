// write expands its string at build time into write_str and .format calls on the writer, in order. print
// and eprint do the same on stdout and stderr. A brace holds one expression, loads and chains included.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        claim %out : @FdWriter <- .stdout()

        %x    : S64   = 7
        %half : F64   = 2.5
        %name : Bytes = "Tessera"
        claim %slot : @U8 <- 40
        write(%out, "x = {%x}, half = {%half}, name = {%name}\n")
        write(%out, "next = {%x.add(1)}, loaded = {%slot.load().add(2)}, flag = {%x.gt(5)}\n")
        write(%out, "{{literal braces}} and {%x}{%x}\n")

        print("stdout: {%x}\n")
        eprint("stderr is not in the expected output\n")
        print("no values\n")
        return(0)
