// A write template expands its string at build time into write_str and .represent calls on a writer, in order:
// out.write("...") on a value pointing at one (Out.writer(), a List<Byte> building text), and Out.write / Err.write
// on the console's stateless writers. A brace holds one expression, loads and chains included. The writer is
// evaluated once, however many pieces the string has.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

global FETCHES: @U32

/// The console writer, counting how many times it was asked for.
routine counted_out() -> @Out
    block entry()
        fetches : U32 = FETCHES.load().add(1)
        fetches.store_into(FETCHES)
        out : @Out = Out.writer()
        return(out)

routine main() -> S32
    block entry()
        out : @Out = Out.writer()

        x    : S64   = 7
        half : F64   = 2.5
        name : Bytes = "Tessera"
        claim slot : @U8 <- 40
        out.write("x = {x}, half = {half}, name = {name}\n")
        out.write("next = {x.add(1)}, loaded = {slot.load().add(2)}, flag = {x.gt(5)}\n")
        out.write("{{literal braces}} and {x}{x}\n")

        claim alloc : @Allocator  <- make_heap_allocator()
        claim text  : @List<Byte> <- .construct(alloc)
        text.write("built in a List<Byte>: {x} and {half}")
        built : Bytes = text.load().to<Bytes>()
        Out.write("{built}\n")
        text.destruct()

        Out.write("stdout: {x}\n")
        Err.write("stderr is not in the expected output\n")
        Out.write("no values\n")

        counted_out().write("one writer for {x}, {half} and {x}\n")
        fetched : U32 = FETCHES.load()
        Out.write("the writer was fetched {fetched} time\n")
        return(0)
