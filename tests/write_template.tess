// write expands its string at compile time into write_str and .format calls on the writer, in order. print
// and eprint do the same on stdout and stderr. A brace holds one expression, loads and chains included.

import Standard::Format

routine main() -> S32
    block entry():
        %stdout : FdWriter = .stdout()
        claim #out : Ptr<FdWriter>
        #out.store(%stdout)

        %x    : S64    = 7
        %half : F64    = 2.5
        %name : String = "Tessera"
        claim #slot : Ptr<U8>
        #slot.store(40)
        write(#out, "x = {%x}, half = {%half}, name = {%name}\n")
        write(#out, "next = {%x.add(1)}, loaded = {#slot.load().add(2)}, flag = {%x.gt(5)}\n")
        write(#out, "{{literal braces}} and {%x}{%x}\n")

        print("stdout: {%x}\n")
        eprint("stderr is not in the expected output\n")
        print("no values\n")
        return(0)
