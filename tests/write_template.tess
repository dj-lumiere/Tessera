// A write template expands its string at build time into write_str and .represent calls on a writer, in order:
// write(out, "...") with a named writer, out.write("...") on a value pointing at one (an FdWriter, a List<Byte>
// building text), and Out.write / Err.write on the console's stateless writers. A brace holds one expression, loads
// and chains included.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()

        x    : S64   = 7
        half : F64   = 2.5
        name : Bytes = "Tessera"
        claim slot : @U8 <- 40
        write(out, "x = {x}, half = {half}, name = {name}\n")
        out.write("next = {x.add(1)}, loaded = {slot.load().add(2)}, flag = {x.gt(5)}\n")
        write(out, "{{literal braces}} and {x}{x}\n")

        claim alloc : @Allocator  <- make_heap_allocator()
        claim text  : @List<Byte> <- .construct(alloc)
        text.write("built in a List<Byte>: {x} and {half}")
        built : Bytes = text.load().to_bytes()
        Out.write("{built}\n")
        text.destruct()

        Out.write("stdout: {x}\n")
        Err.write("stderr is not in the expected output\n")
        Out.write("no values\n")
        return(0)
