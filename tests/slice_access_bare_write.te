# Work on another thread that changes a bare @[T] it is handed is a build error that names the run's
# exclusive access to hand it instead.

import Hosted

### Doubles every value of the run.
### :param part: The values.
routine double_all(part: @[S64]) -> None
    for i in 0 til part.count()
        part.getslot(i).poke(part[i] * 2)
    return

### Hands a bare view to work on another thread, which changes it.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3, 4] * 1 from HEAP
    t: Thread[None] <- get_thread[None]()
    work: Work[None] = double_all.to[Work](part: numbers.getslice())
    t.put_work(work)
    t.retrieve()
    drop t
    drop numbers
    return
