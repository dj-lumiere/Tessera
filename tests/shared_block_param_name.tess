// A block parameter can't take the name of a value the head shares: every block already sees it.
routine count_down(n: S64) -> S64
    shared start : S64 = n.add(1)

    block entry()
        jump loop(start)

    block loop(start: S64)
        branch start.eq(0)
            ? return(start)
            : loop(start.sub(1))

routine main() -> S32
    block entry()
        r : S64 = count_down(3)
        return(r.to<S32>())
