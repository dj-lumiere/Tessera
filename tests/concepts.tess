/// Conformances that hold: a record's own, a conditional one, a concept that only groups others (HashEqual,
/// which Dict needs), a marker concept with no routines, and a top-level conform for a type declared elsewhere.
concept Sendable<T>
require T: typename

conform Sendable<U64>

record Point
conform Equal<Point>, Hash<Point>
    x : S64
    y : S64

routine Point.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = %self.x.eq(%other.x).bitand(%self.y.eq(%other.y))
        return(%r)

routine Point.hash(%self: Self) -> U64
    block entry():
        %r : U64 = %self.x.hash().bitxor(%self.y.hash())
        return(%r)

routine same<T>(%a: T, %b: T) -> Bool
require T: typename, Equal<T>
    block entry():
        %r : Bool = %a.eq(%b)
        return(%r)

routine send<T>(%v: T) -> T
require T: typename, Sendable<T>
    block entry():
        return(%v)

routine show(%b: Bool) -> Void
    block entry():
        print("{%b.to_u64()}\n")
        return()

routine main() -> S32
    block entry():
        %p : Point = Point { x: 1, y: 2 }
        %q : Point = Point { x: 1, y: 3 }
        show(same(%p, %p))
        show(same(%p, %q))
        %some : Option<Point> = .Present(%p)
        show(same(%some, %some))
        %heap : Allocator = make_heap_allocator()
        claim #alloc : Ptr<Allocator>
        #alloc.store(%heap)
        %d_val : Dict<Point, U64> = .construct(#alloc)
        claim #d : Ptr<Dict<Point, U64>>
        #d.store(%d_val)
        #d.put(%p, 7)
        show(#d.contains(%p))
        #d.destruct()
        %v : U64 = send(9)
        print("{%v}\n")
        return(0)
