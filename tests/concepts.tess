/// Conformances that hold: a record's own, a conditional one, a concept that only groups others (HashEquatable,
/// which Dict needs), a marker concept with no routines, and a top-level conform for a type declared elsewhere.
import Standard/Alloc

import Standard/Collections
import Standard/Format
import Standard/Os

record Point
conform Equatable[Point], Hashable[Point]
    x: S64
    y: S64

concept Sendable[T]
require T: typename

conform Sendable[U64]

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.eq(me: Me, other: Me) -> Bool
    r: Bool = me.x.eq(other.x).bitand(me.y.eq(other.y))
    return(r)

routine Point.hash(me: Me) -> U64
    r: U64 = me.x.hash().bitxor(me.y.hash())
    return(r)

routine same[T](a: T, b: T) -> Bool
require T: typename, Equatable[T]
    r: Bool = a.eq(b)
    return(r)

routine send[T](v: T) -> T
require T: typename, Sendable[T]
    return(v)

routine show(b: Bool) -> Void
    Out.write("{b.to[U64]()}\n")
    return()

routine start() -> Void
    p: Point = Point(x: 1, y: 2)
    q: Point = Point(x: 1, y: 3)
    show(same(a: p, b: p))
    show(same(a: p, b: q))
    some: Maybe[Point] = p
    show(same(a: some, b: some))
    claim alloc: @MemoryManager <- make_heap_memory()
    claim d: @Dict[Point, U64] <- .construct(alloc)
    d.setitem(key: p, value: 7)
    show(d.has_key(p))
    d.destruct()
    v: U64 = send(9)
    Out.write("{v}\n")
    return()
