/// Conformances that hold: a record's own, a conditional one, a concept that only groups others (HashEquatable,
/// which Dict needs), a marker concept with no routines, and a top-level conform for a type declared elsewhere.
import Standard/Alloc

import Standard/Collections
import Standard/Format
import Standard/Os

record Point
obeys Equatable[Point], Hashable[Point]
    x: S64
    y: S64

protocol Sendable[T]
needs T: typename

obeys Sendable[U64]

routine Point.eq(me: Me, other: Me) -> Bool
    return me.x == other.x and me.y == other.y

routine Point.hash(me: Me) -> U64
    r: U64 = me.x.hash() ^ me.y.hash()
    return r

routine same[T](a: T, b: T) -> Bool
needs T: typename, Equatable[T]
    return a == b

routine send[T](v: T) -> T
needs T: typename, Sendable[T]
    return v

routine show(b: Bool) -> Void
    Out.write("{b.to[U64]()}\n")
    return

routine start() -> Void
    p: Point = Point(x: 1, y: 2)
    q: Point = Point(x: 1, y: 3)
    show(same(a: p, b: p))
    show(same(a: p, b: q))
    some: Maybe[Point] = p
    show(same(a: some, b: some))
    local alloc: @MemoryManager <- make_heap_memory()
    local d: @Dict[Point, U64] <- .construct(alloc)
    d[p] = 7
    show(d.has_key(p))
    d.destruct()
    v: U64 = send(9)
    Out.write("{v}\n")
    return
