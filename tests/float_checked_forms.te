# The checked float routines give the same bits as their _unchecked forms whenever the result is finite: the checked
# form calls the unchecked one and only adds the crash. This runs every pair of each float type on arguments with a
# finite result and counts the routines whose bits differ.

import Standard/Os

### The number of B16 routines whose checked and unchecked bits differ on the sample arguments.
### :returns: The count of differences.
routine check_b16() -> U64
    two: B16 = 2.0
    three: B16 = 3.0
    local differ: @U64 <- 0
    x_add_0: B16 = 0.25
    if x_add_0.add(three).bits() != x_add_0.add_unchecked(three).bits()
        Console.show("B16.add(0.25) differs")
        differ.peek().add(1).poke_into(differ)
    x_add_1: B16 = 0.5
    if x_add_1.add(three).bits() != x_add_1.add_unchecked(three).bits()
        Console.show("B16.add(0.5) differs")
        differ.peek().add(1).poke_into(differ)
    x_add_2: B16 = 0.75
    if x_add_2.add(three).bits() != x_add_2.add_unchecked(three).bits()
        Console.show("B16.add(0.75) differs")
        differ.peek().add(1).poke_into(differ)
    x_add_3: B16 = 0.875
    if x_add_3.add(three).bits() != x_add_3.add_unchecked(three).bits()
        Console.show("B16.add(0.875) differs")
        differ.peek().add(1).poke_into(differ)
    x_sub_0: B16 = 0.25
    if x_sub_0.sub(three).bits() != x_sub_0.sub_unchecked(three).bits()
        Console.show("B16.sub(0.25) differs")
        differ.peek().add(1).poke_into(differ)
    x_sub_1: B16 = 0.5
    if x_sub_1.sub(three).bits() != x_sub_1.sub_unchecked(three).bits()
        Console.show("B16.sub(0.5) differs")
        differ.peek().add(1).poke_into(differ)
    x_sub_2: B16 = 0.75
    if x_sub_2.sub(three).bits() != x_sub_2.sub_unchecked(three).bits()
        Console.show("B16.sub(0.75) differs")
        differ.peek().add(1).poke_into(differ)
    x_sub_3: B16 = 0.875
    if x_sub_3.sub(three).bits() != x_sub_3.sub_unchecked(three).bits()
        Console.show("B16.sub(0.875) differs")
        differ.peek().add(1).poke_into(differ)
    x_mul_0: B16 = 0.25
    if x_mul_0.mul(three).bits() != x_mul_0.mul_unchecked(three).bits()
        Console.show("B16.mul(0.25) differs")
        differ.peek().add(1).poke_into(differ)
    x_mul_1: B16 = 0.5
    if x_mul_1.mul(three).bits() != x_mul_1.mul_unchecked(three).bits()
        Console.show("B16.mul(0.5) differs")
        differ.peek().add(1).poke_into(differ)
    x_mul_2: B16 = 0.75
    if x_mul_2.mul(three).bits() != x_mul_2.mul_unchecked(three).bits()
        Console.show("B16.mul(0.75) differs")
        differ.peek().add(1).poke_into(differ)
    x_mul_3: B16 = 0.875
