### The number of B32 routines whose checked and unchecked bits differ on the sample arguments.
### :returns: The count of differences.
routine check_b32() -> U64
    two: B32 = 2.0
    three: B32 = 3.0
    local differ: @U64 <- 0
    x_add_0: B32 = 0.25
    if x_add_0.add(three).bits() != x_add_0.add_unchecked(three).bits()
        Console.show("B32.add(0.25) differs")
        differ.peek().add(1).poke_into(differ)
    x_add_1: B32 = 0.5
