### The number of B64 routines whose checked and unchecked bits differ on the sample arguments.
### :returns: The count of differences.
routine check_b64() -> U64
    two: B64 = 2.0
    three: B64 = 3.0
    local differ: @U64 <- 0
    x_add_0: B64 = 0.25
    if x_add_0.add(three).bits() != x_add_0.add_unchecked(three).bits()
        Console.show("B64.add(0.25) differs")
        differ.peek().add(1).poke_into(differ)
    x_add_1: B64 = 0.5
    if x_add_1.add(three).bits() != x_add_1.add_unchecked(three).bits()
