routine start() -> None
    Console.show("B16: {check_b16()} differ")
    Console.show("BF16: {check_bf16()} differ")
    Console.show("B32: {check_b32()} differ")
    Console.show("B64: {check_b64()} differ")
    Console.show("B128: {check_b128()} differ")
    return
