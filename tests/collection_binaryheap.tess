; BinaryHeap<Job> against a model. Jobs order by priority, then by sequence number, so every pop is determined. An
; LCG drives random push / pop / peek and a rare clear in three phases (filling, steady, draining), with a checkpoint
; every 500 operations (length and a running checksum of every result). Then the heap is drained and must come out
; sorted.
; The expected output is generated by scripts/gen_collection_seq.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

struct Job
conform Priority<Job>
    priority: I64
    sequence: I64

; Lower priority first; equal priorities in push order.
routine Job.less(%a: Job, %b: Job) -> Bool
    block entry():
        %pa: I64 = %a.priority
        %pb: I64 = %b.priority
        %before: Bool = %pa.slt(%pb)
        %tied:   Bool = %pa.eq(%pb)
        %sa: I64 = %a.sequence
        %sb: I64 = %b.sequence
        %earlier: Bool = %sa.slt(%sb)
        %result:  Bool = %before.bitor(%tied.bitand(%earlier))
        return(%result)

; One number per job for the checksum. Sequence numbers stay below a million.
routine Job.key(%self: Job) -> I64
    block entry():
        %priority: I64 = %self.priority
        %sequence: I64 = %self.sequence
        %key: I64 = %priority.mul(1000000).add(%sequence)
        return(%key)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #heap: Ptr<BinaryHeap<Job>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #heap.length())
        labeled(#out, "results", %results)
        write_line(#out)
        return()

; Runs %ops random operations; %push is the percentage of pushes, pop takes the next 30 and peek the rest. Priorities
; are below %priorities, so small bounds make many ties. #sequence counts pushes. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #heap: Ptr<BinaryHeap<Job>>, #rng: Ptr<Rng>, #sequence: Ptr<I64>,
        %phase: I64, %ops: I64, %push: I64, %priorities: I64, %results: I64) -> I64
    block entry():
        jump next(0, %results)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %kind:     I64  = #rng.below(1000)
        %is_push:  Bool = %kind.slt(%push.mul(10))
        %is_pop:   Bool = %kind.slt(%push.add(30).mul(10))
        %is_clear: Bool = %kind.eq(999)
        select:
            %is_push -> push(%op, %results)
            %is_pop -> pop(%op, %results)
            %is_clear -> clear(%op, %results)
            _ -> peek(%op, %results)

    block push(%op: I64, %results: I64):
        %priority: I64 = #rng.below(%priorities)
        %sequence: I64 := #sequence
        #sequence = %sequence.add(1)
        %job: Job = Job { priority: %priority, sequence: %sequence }
        #heap.push(%job)
        jump record(%op, %results, %job.key())

    block pop(%op: I64, %results: I64):
        %empty: Bool = #heap.is_empty()
        branch %empty ? record(%op, %results, -1) : pop_one(%op, %results)

    block pop_one(%op: I64, %results: I64):
        %job: Job = #heap.pop()
        jump record(%op, %results, %job.key())

    block peek(%op: I64, %results: I64):
        %empty: Bool = #heap.is_empty()
        branch %empty ? record(%op, %results, -2) : peek_one(%op, %results)

    block peek_one(%op: I64, %results: I64):
        %job: Job = #heap.peek()
        jump record(%op, %results, %job.key())

    block clear(%op: I64, %results: I64):
        #heap.clear()
        jump record(%op, %results, -3)

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #heap, %phase, %op, %results)
        jump next(%op, %results)

; Pops everything, printing the count, a hash of the pop order, and whether each pop was no smaller than the last.
routine drain(#out: Ptr<BufWriter<FdWriter>>, #heap: Ptr<BinaryHeap<Job>>) -> Void
    block entry():
        jump next(0, 0, -1, true)

    block next(%count: I64, %hash: I64, %last: I64, %sorted: Bool):
        %empty: Bool = #heap.is_empty()
        branch %empty ? done(%count, %hash, %sorted) : pop(%count, %hash, %last, %sorted)

    block pop(%count: I64, %hash: I64, %last: I64, %sorted: Bool):
        %job: Job = #heap.pop()
        %key: I64 = %job.key()
        %in_order: Bool = %key.sgt(%last)
        jump next(%count.add(1), mix(%hash, %key), %key, %sorted.bitand(%in_order))

    block done(%count: I64, %hash: I64, %sorted: Bool):
        write_str(#out, "drained")
        labeled(#out, "count", %count)
        labeled(#out, "hash", %hash)
        write_str(#out, " sorted ")
        %sorted.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap_alloc: Allocator      = make_heap_allocator()
        #alloc:      Ptr<Allocator> = alloca<Allocator>([%heap_alloc])
        %rng_val: Rng      = Rng { state: 4 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        #sequence: Ptr<I64> = alloca<I64>([0])
        %heap_val: BinaryHeap<Job> = BinaryHeap<Job>.new(#alloc)
        #heap: Ptr<BinaryHeap<Job>> = alloca<BinaryHeap<Job>>([%heap_val])

        %r1: I64 = run_phase(#out, #heap, #rng, #sequence, 1, 4000, 55, 1000000, 0)
        %r2: I64 = run_phase(#out, #heap, #rng, #sequence, 2, 4000, 40, 20, %r1)
        %r3: I64 = run_phase(#out, #heap, #rng, #sequence, 3, 3000, 25, 1000, %r2)
        %r4: I64 = run_phase(#out, #heap, #rng, #sequence, 4, 3000, 60, 5, %r3)
        drain(#out, #heap)
        #heap.free()
        write_str(#out, "freed is empty ")
        #heap.is_empty().format(#out)
        write_line(#out)
        #out.flush()
        return(0)
