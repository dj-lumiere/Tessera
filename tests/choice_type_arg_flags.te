# A flags type can't be a value type parameter's kind: a value of one has any set of its members on.
import Hosted

### What is true of a cell.
flags Marks
    ### A mine.
    MINE
    ### Open.
    OPEN

### A board.
### :typeparam M: The marks.
record Board[M]
needs M: Marks
    v: U64

### Runs.
routine start() -> None
    return
