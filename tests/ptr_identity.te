# === and !== compare two addresses, == and != compare values: two slots holding 7 are equal values at different addresses.

import Standard/Format
import Standard/Os

routine start() -> None
    out: @ConsoleOutput = Console.output()
    local a: @S64 <- 7
    local b: @S64 <- 7
    same_slot: @S64 = a
    out.write("{a === same_slot} {a === b} {a !== b} {a.peek() == b.peek()}\n")
    if a !== b and not (a === b)
        out.write("different slots\n")
    return
