// write_f expands its string at compile time into write_str and .format calls on the writer, in order. print_f
// and eprint_f do the same on stdout and stderr. A brace holds one expression, loads and chains included.
routine main() -> S32
    block entry():
        %stdout: FdWriter      = .stdout()
        #out:    Ptr<FdWriter> = claim
        #out.store(%stdout)

        %x: S64 = 7
        %half: F64 = 2.5
        %name: String = "Tessera"
        #slot: Ptr<U8> = claim
        #slot.store(40)
        write_f(#out, "x = {%x}, half = {%half}, name = {%name}\n")
        write_f(#out, "next = {%x.add(1)}, loaded = {#slot.load().add(2)}, flag = {%x.gt(5)}\n")
        write_f(#out, "{{literal braces}} and {%x}{%x}\n")

        print_f("stdout: {%x}\n")
        eprint_f("stderr is not in the expected output\n")
        print_f("no values\n")
        return(0)
