# T? is Optional[T]. For a T whose values hold nothing to give back it is laid out as { i1, T }: the present flag, then
# the value, so .hollow() is None. For an entity T it is one address of the place the entity lives in (null
# for None): the place is in the frame of the routine whose call made it, which a routine returning T? is given by its
# caller. Both are read with when, made by try, and written as T? or Optional[T].

import Hosted

### A counter that says when it ends.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### Says it ends.
routine @Counter.destruct() -> None
    Console.show("end {me.n.peek()}")
    return

### Half of an even number.
### :param n: The number.
### :returns: Half of it.
### :throws: Throws `UnacceptedValueError` for an odd number.
failable routine half(n: S64) -> S64
    if n % 2 == 0
        return n // 2
    throw UnacceptedValueError(description: "odd")

### A counter for a positive count, or nothing.
### :param n: The count.
### :returns: The counter, or None.
routine counter_for(n: S64) -> Counter?
    if n > 0
        made: &Counter <- .construct(n)
        return made
    return None()

### Hands on what counter_for gives: the counter moves into this routine's caller's place.
### :param n: The count.
### :returns: The counter, or None.
routine passed_on(n: S64) -> Counter?
    got: &Optional[Counter] <- counter_for(n)
    return got

### Makes a counter, or fails.
### :param n: The count.
### :returns: The new counter.
### :throws: Throws `UnacceptedValueError` for a negative count.
failable routine make(n: S64) -> Counter
    if n < 0
        throw UnacceptedValueError(description: "negative")
    return Counter.construct(n)

### Reads an Optional.
### :param m: The value or None.
### :returns: The text.
routine describe(m: S64?) -> S64
    return when m
        is S64 as v => v
        is None => -1

routine start() -> None
    a: S64? = 7
    b: Optional[S64] = None()
    c: Optional[S64] = .hollow()
    Console.show("{describe(a)} {describe(b)} {describe(c)} {a.is_present()} {c.is_absent()}")
    # S64 is aligned to 8 bytes on most targets and to 4 on 32-bit x86 Linux, and the flag takes one alignment step.
    flag_and_value: Bool = sizeof[S64?]() == alignof[S64]() + sizeof[S64]()
    Console.show("sizes {flag_and_value} {sizeof[Optional[U8]]()} {sizeof[Optional[Bool]]()} {alignof[S64?]() == alignof[S64]()}")
    tried: S64? = try half(10)
    failed: S64? = try half(3)
    Console.show("{tried} {failed} {tried.unwrap_or(0)} {failed.unwrap_or(0)}")
    when counter_for(3)
        is Counter as made =>
            Console.show("made {made.n.peek()}")
            drop made
        is None => Console.show("none")
    kept: &Optional[Counter] <- counter_for(0)
    when steal kept
        is Counter as made =>
            drop made
        is None => Console.show("none for 0")
    handed: &Optional[Counter] <- passed_on(4)
    when steal handed
        is Counter as made =>
            Console.show("handed {made.n.peek()}")
            drop made
        is None => Console.show("none")
    made_one: &Optional[Counter] <- try make(5)
    made_none: &Optional[Counter] <- try make(-1)
    Console.show("one address: {sizeof[Counter?]() == sizeof[Addr]()}")
    drop made_none
    drop made_one
    return
