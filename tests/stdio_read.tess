// In.read<T>() reads the next word of standard input as a T, in place in the input buffer: numbers across lines and
// of several types, a word that isn't a T through read_result<T>(), Absent at the end, and a number that runs past
// the end of the first 8192 bytes read (its start is moved to the front of the buffer and the rest read after it).

import Standard::Format
import Standard::Os

/// Adds every remaining word of standard input, read as an S64.
routine sum_rest() -> S64
    block entry()
        jump add(0)

    block add(total: S64)
        next : Option<S64> = In.read<S64>()
        when next
            .Present(n) -> add(total.add(n))
            .Absent     -> return(total)

routine main() -> S32
    block entry()
        a : S32 = In.read<S32>().unwrap()
        b : S32 = In.read<S32>().unwrap()
        Out.write("a + b = {a.add(b)}\n")
        x : F64 = In.read<F64>().unwrap()
        Out.write("x = {x}\n")
        word : Option<Result<S32, ParseError>> = In.read_result<S32>()
        when word
            .Present(r) -> converted(r)
            .Absent     -> return(1)

    block converted(r: Result<S32, ParseError>)
        when r
            .Success(n)     -> return(n)
            .Failure(error) -> failed(error)

    block failed(error: ParseError)
        Out.write("abc as S32: {error.diagnose()}\n")
        total : S64 = sum_rest()
        Out.write("sum of the rest: {total}\n")
        last : Option<S32> = In.read<S32>()
        Out.write("after the end: {last.diagnose()}\n")
        return(0)
