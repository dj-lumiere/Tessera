// In.read[T]() reads the next word of standard input as a T, in place in the input buffer: numbers across lines and
// of several types, a word that isn't a T through read_result[T](), the _checked form to the end of the input, and a
// number that runs past the end of the first 8192 bytes read (its start is moved to the front of the buffer and the
// rest read after it). At the end, read_checked[T]() is Unit and read_result[T]() a Empty.

import Standard/Format
import Standard/Os

/// Adds every remaining word of standard input, read as an S64.
routine sum_rest() -> S64
    while true with total: S64 = 0
        next: Maybe[S64] = In.read_checked[S64]()
        when next
            is S64 as n => continue with total: total + n
            is Unit => return total

routine start() -> Void
    a: S32 = In.read[S32]()
    b: S32 = In.read[S32]()
    Out.write("a + b = {a.add(b)}\n")
    x: B64 = In.read[B64]()
    Out.write("x = {x}\n")
    word: Result[S32, ParseError] = In.read_result[S32]()
    when word
        is S32 as n =>
            set_exit_code(n)
            return
        is ParseError as error =>
            Out.write("abc as S32: {error.diagnose()}\n")
            total: S64 = sum_rest()
            Out.write("sum of the rest: {total}\n")
            last: Maybe[S32] = In.read_checked[S32]()
            Out.write("after the end: {last.diagnose()}\n")
            ended: Result[S32, ParseError] = In.read_result[S32]()
            Out.write("read_result after the end: {ended.diagnose()}\n")
            return
