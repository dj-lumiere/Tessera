# The places a routine borrows with <-: from STACK (no manager named) a frame slot, from HEAP memory the program gives
# back. A &T reads and writes with load and store, getview gives its @T, and a routine of @T called on it works on that
# view. A routine the value's own type declares under one of those names is the value's (a List's getview). A &[T]
# reaches its elements like a @[T]. Returning a STACK place hands its value out.

import Collections
import Hosted

global TABLE: &[U64] <- [1, 2, 3]
lateinit global CACHE: &[Byte]

### Adds one through a view.
### :param at: The value to change.
routine bump(at: @S64) -> None
    (at.peek() + 1).poke_into(at)
    return

### A list made in a STACK place and handed out.
### :returns: The list.
routine made() -> List[S64]
    list: &List[S64] <- List[S64].of(values: [4, 5], manager: HEAP)
    list.add_last(6)
    return list

routine start() -> None
    count: &S64 <- 1
    words: &[U64] <- [0] * 3
    heap: &[U64] <- [7] * 2 from HEAP
    list: &List[S64] <- made()

    count.store(count.load() + 1)
    bump(count)
    count.getview().poke(count.peek() * 10)
    words.getslot(1).poke(9)
    view: @[S64] = list.getview()
    CACHE.replace(value: [b'o', b'k'] * 1 from HEAP)
    Console.show("{count.load()} {words[1]} {words.count()} {heap[1]} {view.count} {list} {TABLE[2]}")
    Console.show("{CACHE.getslice()}")
    drop heap
    return
