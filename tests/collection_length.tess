; length and is_empty on every collection, before and after adding one element. String.length counts bytes.

@[external("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<I8>) -> I32

routine report(#name: Ptr<I8>, %was_empty: Bool, %length: I64, %now_empty: Bool) -> Void
    block entry():
        c_printf("%s %d %lld %d\n", #name, %was_empty.to_i32(), %length, %now_empty.to_i32())
        return()

routine main() -> I32
    block entry():
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])

        %hs_val: Set<I64> = Set<I64>.new(#alloc)
        #hs: Ptr<Set<I64>> = alloca<Set<I64>>([%hs_val])
        %hs_was: Bool = #hs.is_empty()
        #hs.add(7)
        report("Set", %hs_was, #hs.length(), #hs.is_empty())
        #hs.free()

        %hm_val: Dict<I64, I64> = Dict<I64, I64>.new(#alloc)
        #hm: Ptr<Dict<I64, I64>> = alloca<Dict<I64, I64>>([%hm_val])
        %hm_was: Bool = #hm.is_empty()
        #hm.put(1, 2)
        report("Dict", %hm_was, #hm.length(), #hm.is_empty())
        #hm.free()

        %bs_val: SortedSet<I64> = SortedSet<I64>.new(#alloc)
        #bs: Ptr<SortedSet<I64>> = alloca<SortedSet<I64>>([%bs_val])
        %bs_was: Bool = #bs.is_empty()
        #bs.add(3)
        report("SortedSet", %bs_was, #bs.length(), #bs.is_empty())
        #bs.free()

        %bl_val: SortedList<I64> = SortedList<I64>.new(#alloc)
        #bl: Ptr<SortedList<I64>> = alloca<SortedList<I64>>([%bl_val])
        %bl_was: Bool = #bl.is_empty()
        #bl.push(4)
        report("SortedList", %bl_was, #bl.length(), #bl.is_empty())
        #bl.free()

        %bm_val: SortedDict<I64, I64> = SortedDict<I64, I64>.new(#alloc)
        #bm: Ptr<SortedDict<I64, I64>> = alloca<SortedDict<I64, I64>>([%bm_val])
        %bm_was: Bool = #bm.is_empty()
        #bm.put(5, 6)
        report("SortedDict", %bm_was, #bm.length(), #bm.is_empty())
        #bm.free()

        %text_val: String = "한글"
        #text: Ptr<String> = alloca<String>([%text_val])
        c_printf("String %lld %d\n", #text.length(), #text.is_empty().to_i32())
        return(0)
