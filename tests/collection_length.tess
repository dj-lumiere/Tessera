// count and is_empty on every collection, before and after adding one element. Bytes.count counts bytes.

import Standard::Alloc
import Standard::Collections
import Standard::Os

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

routine report(name: @Byte, was_empty: Bool, count: USize, now_empty: Bool) -> Void
    block entry()
        c_printf("%s %d %zu %d\n", name, was_empty.to<S32>(), count, now_empty.to<S32>())
        return()

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        claim hs : @Set<S64> <- .construct(alloc)
        hs_was : Bool = hs.load().is_empty()
        hs.add(7)
        report("Set", hs_was, hs.load().count(), hs.load().is_empty())
        hs.destruct()

        claim hm : @Dict<S64, S64> <- .construct(alloc)
        hm_was : Bool = hm.load().is_empty()
        hm.put(1, 2)
        report("Dict", hm_was, hm.load().count(), hm.load().is_empty())
        hm.destruct()

        claim bs : @SortedSet<S64> <- .construct(alloc)
        bs_was : Bool = bs.load().is_empty()
        bs.add(3)
        report("SortedSet", bs_was, bs.load().count(), bs.load().is_empty())
        bs.destruct()

        claim bl : @SortedList<S64> <- .construct(alloc)
        bl_was : Bool = bl.load().is_empty()
        bl.push(4)
        report("SortedList", bl_was, bl.load().count(), bl.load().is_empty())
        bl.destruct()

        claim bm : @SortedDict<S64, S64> <- .construct(alloc)
        bm_was : Bool = bm.load().is_empty()
        bm.put(5, 6)
        report("SortedDict", bm_was, bm.load().count(), bm.load().is_empty())
        bm.destruct()

        text_val : Bytes = "한글"
        c_printf("String %zu %d\n", text_val.count(), text_val.is_empty().to<S32>())
        return(0)
