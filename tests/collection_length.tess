// count and is_empty on every collection, before and after adding one element. Span[Byte].count counts bytes.

import Standard/Alloc
import Standard/Collections
import Standard/Os

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

routine report(name: @Byte, was_empty: Bool, count: USize, now_empty: Bool) -> Void
    c_printf("%s %d %zu %d\n", name, was_empty.to[S32](), count, now_empty.to[S32]())
    return()

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()

    claim hs: @Set[S64] <- .construct(alloc)
    hs_was: Bool = hs.is_empty()
    hs.add(7)
    report(name: "Set", was_empty: hs_was, count: hs.count(), now_empty: hs.is_empty())
    hs.destruct()

    claim hm: @Dict[S64, S64] <- .construct(alloc)
    hm_was: Bool = hm.is_empty()
    hm.setitem(key: 1, value: 2)
    report(name: "Dict", was_empty: hm_was, count: hm.count(), now_empty: hm.is_empty())
    hm.destruct()

    claim bs: @SortedSet[S64] <- .construct(alloc)
    bs_was: Bool = bs.is_empty()
    bs.add(3)
    report(name: "SortedSet", was_empty: bs_was, count: bs.count(), now_empty: bs.is_empty())
    bs.destruct()

    claim bl: @SortedList[S64] <- .construct(alloc)
    bl_was: Bool = bl.is_empty()
    bl.add(4)
    report(name: "SortedList", was_empty: bl_was, count: bl.count(), now_empty: bl.is_empty())
    bl.destruct()

    claim bm: @SortedDict[S64, S64] <- .construct(alloc)
    bm_was: Bool = bm.is_empty()
    bm.setitem(key: 5, value: 6)
    report(name: "SortedDict", was_empty: bm_was, count: bm.count(), now_empty: bm.is_empty())
    bm.destruct()

    text_val: Span[Byte] = "한글"
    c_printf("String %zu %d\n", text_val.count(), text_val.is_empty().to[S32]())
    return()
