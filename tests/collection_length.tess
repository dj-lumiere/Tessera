// length and is_empty on every collection, before and after adding one element. String.length counts bytes.

@[external("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<Byte>) -> S32

routine report(#name: Ptr<Byte>, %was_empty: Bool, %length: U64, %now_empty: Bool) -> Void
    block entry():
        c_printf("%s %d %lld %d\n", #name, %was_empty.to_s32(), %length, %now_empty.to_s32())
        return()

routine main() -> S32
    block entry():
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = claim
        #alloc.store(%heap)

        %hs_val: Set<S64> = .construct(#alloc)
        #hs: Ptr<Set<S64>> = claim
        #hs.store(%hs_val)
        %hs_was: Bool = #hs.is_empty()
        #hs.add(7)
        report("Set", %hs_was, #hs.length(), #hs.is_empty())
        #hs.destruct()

        %hm_val: Dict<S64, S64> = .construct(#alloc)
        #hm: Ptr<Dict<S64, S64>> = claim
        #hm.store(%hm_val)
        %hm_was: Bool = #hm.is_empty()
        #hm.put(1, 2)
        report("Dict", %hm_was, #hm.length(), #hm.is_empty())
        #hm.destruct()

        %bs_val: SortedSet<S64> = .construct(#alloc)
        #bs: Ptr<SortedSet<S64>> = claim
        #bs.store(%bs_val)
        %bs_was: Bool = #bs.is_empty()
        #bs.add(3)
        report("SortedSet", %bs_was, #bs.length(), #bs.is_empty())
        #bs.destruct()

        %bl_val: SortedList<S64> = .construct(#alloc)
        #bl: Ptr<SortedList<S64>> = claim
        #bl.store(%bl_val)
        %bl_was: Bool = #bl.is_empty()
        #bl.push(4)
        report("SortedList", %bl_was, #bl.length(), #bl.is_empty())
        #bl.destruct()

        %bm_val: SortedDict<S64, S64> = .construct(#alloc)
        #bm: Ptr<SortedDict<S64, S64>> = claim
        #bm.store(%bm_val)
        %bm_was: Bool = #bm.is_empty()
        #bm.put(5, 6)
        report("SortedDict", %bm_was, #bm.length(), #bm.is_empty())
        #bm.destruct()

        %text_val: String = "한글"
        #text: Ptr<String> = claim
        #text.store(%text_val)
        c_printf("String %lld %d\n", #text.length(), #text.is_empty().to_s32())
        return(0)
