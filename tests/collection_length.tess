; length and is_empty on every collection, before and after adding one element. String.length counts bytes.

@[external("c"), callconv("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<I8>) -> I32

routine report(#name: Ptr<I8>, %was_empty: Bool, %length: I64, %now_empty: Bool) -> Void
    block entry():
        c_printf("%s %d %lld %d\n", #name, %was_empty.to_i32(), %length, %now_empty.to_i32())
        return()

routine main() -> I32
    block entry():
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])

        %hs_val: HashSet<I64> = HashSet<I64>.new(#alloc)
        #hs: Ptr<HashSet<I64>> = alloca<HashSet<I64>>([%hs_val])
        %hs_was: Bool = #hs.is_empty()
        #hs.add(7)
        report("HashSet", %hs_was, #hs.length(), #hs.is_empty())
        #hs.free()

        %hm_val: HashMap<I64, I64> = HashMap<I64, I64>.new(#alloc)
        #hm: Ptr<HashMap<I64, I64>> = alloca<HashMap<I64, I64>>([%hm_val])
        %hm_was: Bool = #hm.is_empty()
        #hm.put(1, 2)
        report("HashMap", %hm_was, #hm.length(), #hm.is_empty())
        #hm.free()

        %bs_val: BTreeSet<I64> = BTreeSet<I64>.new(#alloc)
        #bs: Ptr<BTreeSet<I64>> = alloca<BTreeSet<I64>>([%bs_val])
        %bs_was: Bool = #bs.is_empty()
        #bs.add(3)
        report("BTreeSet", %bs_was, #bs.length(), #bs.is_empty())
        #bs.free()

        %bl_val: BTreeList<I64> = BTreeList<I64>.new(#alloc)
        #bl: Ptr<BTreeList<I64>> = alloca<BTreeList<I64>>([%bl_val])
        %bl_was: Bool = #bl.is_empty()
        #bl.push(4)
        report("BTreeList", %bl_was, #bl.length(), #bl.is_empty())
        #bl.free()

        %bm_val: BTreeMap<I64, I64> = BTreeMap<I64, I64>.new(#alloc)
        #bm: Ptr<BTreeMap<I64, I64>> = alloca<BTreeMap<I64, I64>>([%bm_val])
        %bm_was: Bool = #bm.is_empty()
        #bm.put(5, 6)
        report("BTreeMap", %bm_was, #bm.length(), #bm.is_empty())
        #bm.free()

        %text_val: String = "한글"
        #text: Ptr<String> = alloca<String>([%text_val])
        c_printf("String %lld %d\n", #text.length(), #text.is_empty().to_i32())
        return(0)
