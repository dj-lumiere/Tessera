// length and is_empty on every collection, before and after adding one element. Bytes.length counts bytes.

import Standard::Alloc
import Standard::Collections
import Standard::Os

#[external("c"), symbol("printf"), variadic]
routine c_printf(%fmt: @Byte) -> S32

routine report(%name: @Byte, %was_empty: Bool, %length: USize, %now_empty: Bool) -> Void
    block entry():
        c_printf("%s %d %zu %d\n", %name, %was_empty.to_s32(), %length, %now_empty.to_s32())
        return()

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator
        %alloc.store(%heap)

        %hs_val : Set<S64> = .construct(%alloc)
        claim %hs : @Set<S64>
        %hs.store(%hs_val)
        %hs_was : Bool = %hs.load().is_empty()
        %hs.add(7)
        report("Set", %hs_was, %hs.load().length(), %hs.load().is_empty())
        %hs.destruct()

        %hm_val : Dict<S64, S64> = .construct(%alloc)
        claim %hm : @Dict<S64, S64>
        %hm.store(%hm_val)
        %hm_was : Bool = %hm.load().is_empty()
        %hm.put(1, 2)
        report("Dict", %hm_was, %hm.load().length(), %hm.load().is_empty())
        %hm.destruct()

        %bs_val : SortedSet<S64> = .construct(%alloc)
        claim %bs : @SortedSet<S64>
        %bs.store(%bs_val)
        %bs_was : Bool = %bs.load().is_empty()
        %bs.add(3)
        report("SortedSet", %bs_was, %bs.load().length(), %bs.load().is_empty())
        %bs.destruct()

        %bl_val : SortedList<S64> = .construct(%alloc)
        claim %bl : @SortedList<S64>
        %bl.store(%bl_val)
        %bl_was : Bool = %bl.load().is_empty()
        %bl.push(4)
        report("SortedList", %bl_was, %bl.load().length(), %bl.load().is_empty())
        %bl.destruct()

        %bm_val : SortedDict<S64, S64> = .construct(%alloc)
        claim %bm : @SortedDict<S64, S64>
        %bm.store(%bm_val)
        %bm_was : Bool = %bm.load().is_empty()
        %bm.put(5, 6)
        report("SortedDict", %bm_was, %bm.load().length(), %bm.load().is_empty())
        %bm.destruct()

        %text_val : Bytes = "한글"
        c_printf("String %zu %d\n", %text_val.length(), %text_val.is_empty().to_s32())
        return(0)
