# A callee that only reads what a local entity holds may be handed the entity.

import Hosted

### Holds an address.
entity Q
    ### The address.
    held: @S64

### Makes one.
### :returns: The holder.
common routine Q.construct() -> Me
    return Me(held: dangling[S64]())

### Gives the holder back.
routine @Q.destruct() -> None
    return

### Reads what q holds, the only thing done with it.
### :param q: The holder.
### :returns: The value.
routine look(q: @Q) -> S64
    return q.held.peek().peek()

### Runs.
routine start() -> None
    l: &S64 <- 5
    q: &Q <- .construct()

    q.held.poke(l)
    n: S64 = look(q)
    drop q
    Console.show("{n}")
    return
