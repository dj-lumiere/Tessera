# Work may return an entity: retrieve() moves it out of the ticket.

import Standard/Collections
import Standard/Hosted

### The squares of the numbers from `from` up to `to`.
### :param from: The first number.
### :param to: One past the last.
### :returns: The squares, in a list from HEAP.
routine squares(from: S64, to: S64) -> List[S64]
    out: &List[S64] <- .construct(HEAP)

    each i in from til to
        out.add_last(i * i)
    return out

### Works the squares out on a thread and shows how many there are.
routine start() -> None
    t: Thread[List[S64]] <- get_thread[List[S64]]()
    work: Work[List[S64]] = squares.to[Work](from: 0, to: 4)
    t.put_work(work)
    result: &List[S64] <- t.retrieve()
    drop t
    Console.show("{result.count()}")
    return
