# `routine @Cell.read` and `routine Ptr[Cell].read` are both what `p.read()` means on a `@Cell`, neither more specific
# than the other: one of them takes another name.

record Cell
    v: S64

routine @Cell.read() -> S64
    return me.v.peek()

routine Ptr[Cell].read() -> S64
    return me.v.peek()

routine start() -> None
    local c: @Cell <- Cell(v: 1)

    n: S64 = c.read()
    return
