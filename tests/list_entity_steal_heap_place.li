# A place borrowed from HEAP (`x: &Box <- ... from HEAP`) stolen into a List of the entity moves the value into the list and
# gives the place's memory back. A List of the optional entity takes the place itself.

import Collections
import Hosted

### A box with a number.
entity Box
    n: U64

### Makes a box.
### :param n: The number.
### :returns: The box.
common routine Box.construct(n: U64) -> Me
    return Me(n)

### Puts boxes in two lists, one of values and one of places.
routine start() -> None
    values: &List[Box] <- .construct(HEAP)
    places: &List[Box?] <- .construct(HEAP)
    first: &Box <- Box.construct(3) from HEAP
    second: &Box <- Box.construct(4) from HEAP
    third: &Box <- Box.construct(5)
    values.add_last(steal first)
    places.add_last(steal second)
    values.add_last(steal third)
    Console.show(values.count())
    Console.show(values.getslot(0).n.peek())
    Console.show(values.getslot(1).n.peek())
    Console.show(places.count())
    drop values
    drop places
    return
