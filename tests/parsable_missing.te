# A conformance to Parsable[T] needs the conversion @[Byte].to[T]: one defined for another type doesn't count.

record Celsius
obeys Parsable[Celsius]
    degrees: S32

record Fahrenheit
    degrees: S32

failable routine @[Byte].to[Fahrenheit]() -> Fahrenheit
    throw InvalidValueError(text: me, target: "Fahrenheit")

routine start() -> None
    return
