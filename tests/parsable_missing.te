# A conformance to Parsable[T] needs the conversion @[Byte].to_result[T]: one defined for another type doesn't count.

record Celsius
obeys Parsable[Celsius]
    degrees: S32

record Fahrenheit
    degrees: S32

routine @[Byte].to_result[Fahrenheit]() -> Result[Fahrenheit, ParseError]
    return ParseError.INVALID

routine start() -> None
    return
