# setitem past the end throws IndexOutOfBoundsError, which check receives, and leaves the collection as it was. An
# index in range replaces the element.

import Collections
import Hosted

routine start() -> None
    list: &List[S64] <- List[S64].construct(HEAP)
    list.add_last(1)
    list.add_last(2)
    when check list.setitem(index: 1, value: 20)
        is None => Console.show("list 1: {list}")
        is IndexOutOfBoundsError as e => Console.show("list 1: {e}")
    when check list.setitem(index: 2, value: 30)
        is None => Console.show("list 2: set")
        is IndexOutOfBoundsError as e => Console.show("list 2: {e}, still {list}")
    drop list

    ring: &RotatableList[S64] <- RotatableList[S64].construct(HEAP)
    ring.add_last(5)
    ring.add_first(4)
    when check ring.setitem(index: 0, value: 40)
        is None => Console.show("ring 0: {ring}")
        is IndexOutOfBoundsError as e => Console.show("ring 0: {e}")
    when check ring.setitem(index: 7, value: 70)
        is None => Console.show("ring 7: set")
        is IndexOutOfBoundsError as e => Console.show("ring 7: {e}, still {ring}")
    drop ring

    bits: &BitList <- BitList.construct(HEAP)
    bits.add_last(false)
    when check bits.setitem(index: 0, value: true)
        is None => Console.show("bits 0: {bits}")
        is IndexOutOfBoundsError as e => Console.show("bits 0: {e}")
    when check bits.setitem(index: 3, value: true)
        is None => Console.show("bits 3: set")
        is IndexOutOfBoundsError as e => Console.show("bits 3: {e}, still {bits}")
    drop bits
    return
