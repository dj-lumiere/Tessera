# An owning container may take an entity as its type argument: Shelf[Counter] holds its Counters in memory it owns,
# takes one in with steal, lends one with getslot (a @Counter), and its destruct ends each Counter before the memory.
# steal on a record is the value itself, so generic code that moves a T with steal takes either.

import Standard/Hosted

### Counts things, and says when it ends.
entity Counter
obeys Destructible[Counter]
    count: S64

### Values in order, the memory and each value its own.
### :typeparam T: The value type: an entity or a record.
entity Shelf[T]
needs T: typename, Destructible[T]
    items: BorrowedSlice[T]
    count: U64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Says its count as it ends.
routine @Counter.destruct() -> None
    Console.show("ending {me.count.peek()}")
    return

### Counts one more.
routine @Counter.bump() -> None
    (me.count.peek() + 1).poke_into(me.count)
    return

### An empty shelf with room for `capacity` values.
### :param capacity: How many values fit.
### :param manager: Where the memory comes from.
### :returns: The shelf.
common routine Shelf[T].construct(capacity: U64, manager: @MemoryManager) -> Me
needs T: typename, Destructible[T]
    return Me(items: .construct(count: capacity, manager), count: 0)

### Ends every value, then gives the memory back.
routine @Shelf[T].destruct() -> None
needs T: typename, Destructible[T]
    each i in 0 til me.count.peek()
        drop me.items.getslot(i)
    drop me.items
    return

### Takes `value` in at the end.
### :param value: The value, handed over.
routine @Shelf[T].add(value: T) -> None
needs T: typename, Destructible[T]
    me.items.getslot(me.count.peek()).poke(steal value)
    (me.count.peek() + 1).poke_into(me.count)
    return

### The place of the value at `index`.
### :param index: Which value.
### :returns: Its place.
routine @Shelf[T].at(index: U64) -> @T
needs T: typename, Destructible[T]
    return me.items.getslot(index)

### `value` handed back: a move for an entity, the value itself for a record.
### :param value: The value, handed over.
### :returns: The same value.
routine handed_back[T](value: T) -> T
needs T: typename
    return steal value

### Fills a shelf of counters and ends it, and moves a plain count the same way a Counter moves.
routine start() -> None
    manager: @MemoryManager = HEAP
    shelf: &Shelf[Counter] <- .construct(capacity: 3, manager: manager)
    first: &Counter <- .construct()

    first.bump()
    shelf.add(value: steal first)
    shelf.add(value: Counter.construct())
    shelf.at(1).bump()
    shelf.at(1).bump()
    Console.show("counters: {shelf.count.peek()}")
    drop shelf
    n: S64 = handed_back(7)
    last: &Counter <- handed_back(Counter.construct())

    Console.show("handed back: {n}")
    drop last
    return
