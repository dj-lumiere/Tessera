### A private declaration doesn't claim its name outside its module: the stdlib's private SORTED_SET_NODE_KEYS
### (Standard/Collections) and U256Division (Standard/Core) leave these names free.
import Standard/Format
import Standard/Os

preset SORTED_SET_NODE_KEYS: U64 = 3

record U256Division
    parts: U64

routine start() -> None
    d: U256Division = U256Division(parts: SORTED_SET_NODE_KEYS)
    Out.write("{d.parts}\n")
    return
