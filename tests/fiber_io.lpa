# A fiber reading a pipe doesn't stop the others: the reader waits for data while the writer, a fiber of the same
# manager on the same thread, runs, yields, and writes it. The read and the write run on thread tickets. If the read
# blocked the manager's thread, the writer would never run.

import Fiber
import Hosted

record Pipe
    sched: @CoroutineManager
    fds: Items[CInt, 2]  # the read end, then the write end

### Makes a `Pipe` from its fields.
### :param sched: Its `sched`.
### :param fds: Its `fds`.
### :returns: The new value.
common routine Pipe.construct(sched: @CoroutineManager, fds: Items[CInt, 2]) -> Me
    return Me(sched, fds)

### Releases nothing: a `Pipe` holds no memory of its own.
routine @Pipe.destruct() -> None
    return

@external("c")
@symbol("pipe")
@target(os: not "windows")
routine c_pipe(fds: @CInt) -> CInt

@external("c")
@symbol("_pipe")
@target(os: "windows")
routine c_win_pipe(fds: @CInt, size: U32, mode: CInt) -> CInt

@target(os: not "windows")
routine make_pipe(fds: @CInt) -> None
    c_pipe(fds)
    return

### _O_BINARY, so the bytes go through as they are.
@target(os: "windows")
routine make_pipe(fds: @CInt) -> None
    c_win_pipe(fds, 4096, 0x8000)
    return

routine reader(pipe: @Pipe) -> None
    sched: @CoroutineManager = pipe.sched.peek()
    buf: &Items[Byte, 16]
    Console.show("reader: waiting")
    n: S64 = sched.read(fd: pipe.fds[0], buf: buf.getview().to[@Byte](), count: 16)
    text: @[Byte] = @[Byte].construct(data: buf.getview().to[@Byte](), count: n.to[U64]())
    Console.show("reader: got {text}")
    return

routine writer(pipe: @Pipe) -> None
    sched: @CoroutineManager = pipe.sched.peek()
    Console.show("writer: step 1")
    sched.yield()
    Console.show("writer: step 2")
    sched.yield()
    Console.show("writer: writing")
    hello: @[Byte] = "hello"
    sched.write(fd: pipe.fds[1], buf: hello.data, count: hello.count)
    return

routine start() -> None
    manager: @MemoryManager = HEAP
    stack_manager: @MemoryManager = PAGES
    sched: &CoroutineManager <- .construct(stack_size: 64kib, stack_manager, manager)
    fds: &Items[CInt, 2]

    make_pipe(fds.getview().to[@CInt]())
    pipe: &Pipe <- Pipe(sched: sched, fds: fds.load())
    r: Fiber[None] <- sched.get_fiber[None]()
    work_r: Work[None] = reader.to[Work](pipe: pipe)
    r.put_work(work_r)
    w: Fiber[None] <- sched.get_fiber[None]()
    work_w: Work[None] = writer.to[Work](pipe: pipe)
    w.put_work(work_w)
    sched.run()
    drop r
    drop w
    Console.show("all done")
    drop sched
    return
