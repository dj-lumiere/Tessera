# --show-destructs prints the destruct routines the builder writes, as Tessera source: one for each of the program's
# types that holds something to release and writes none. A type that writes its own destruct (Bell) gets none.

import Standard/Hosted

### Says its name when it ends.
entity Bell
    name: @[Byte]

### Two bells and a number: no destruct of its own.
entity Tower
    first: Bell
    count: S64
    second: Bell

### A bell or nothing.
variant MaybeBell
    Bell
    None

### A bell called `name`.
### :param name: Its name.
### :returns: The bell.
common routine Bell.construct(name: @[Byte]) -> Me
    return Me(name)

### Rings: says its name.
routine @Bell.destruct() -> None
    Console.show("ends {me.name.peek()}")
    return

### Makes a `Tower` from its fields.
### :param first: Its `first`.
### :param count: Its `count`.
### :param second: Its `second`.
### :returns: The new value.
common routine Tower.construct(first: Bell, count: S64, second: Bell) -> Me
    return Me(first: steal first, count, second: steal second)

routine start() -> None
    tower: &Tower <- .construct(first: .construct(name: "low"), count: 2, second: .construct(name: "high"))
    drop tower
    maybe: &MaybeBell <- Bell.construct(name: "spare")
    drop maybe
    return
