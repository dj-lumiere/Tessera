// FiberManager.spawn takes the state its entry takes: an entry on an @S64 can't be handed a @U8.

import Standard/Alloc
import Standard/Fiber
import Standard/Os

routine count_up(n: @S64) -> Void
    block entry()
        n.peek().add(1).poke_into(n)
        return()

routine start() -> Void
    block entry()
        claim stacks: @MemoryManager <- make_stack_memory()
        claim sched: @FiberManager <- .construct(1, stacks, DEFAULT_HEAP)
        claim small: @U8 <- 0
        sched.spawn(count_up.to[Callable](), small, 65536)
        sched.run()
        sched.destruct()
        return()
