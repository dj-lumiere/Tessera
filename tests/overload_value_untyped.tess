// Where the value goes doesn't name a Callable, so which overload is meant is unsaid.

routine step(n: S64) -> S64
    block entry()
        return(n.add(1))

routine step(n: U64) -> U64
    block entry()
        return(n.add(1))

routine take(code: Addr) -> Void
    block entry()
        return()

routine start() -> Void
    block entry()
        take(step.to<Callable>())
        return()
