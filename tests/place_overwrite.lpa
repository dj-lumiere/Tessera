# y <- value writes over a place that holds a value: a number is written in, and an entity's old value is ended with
# its destruct once the new one is made, on a frame place and on a place from a manager. Nothing new is borrowed.
import Hosted

entity Noisy
    n: S64

common routine Noisy.construct(n: S64) -> Me
    return Me(n)

routine @Noisy.destruct() -> None
    Console.show("destruct {me.n.peek()}")
    return

routine start() -> None
    y: &B32 <- 1.5
    y <- 2.5
    y <- y.load() * 2.0
    Console.show("y = {y.load()}")
    local: &Noisy <- Noisy.construct(n: 1)
    local <- Noisy.construct(n: 2)
    Console.show("local holds {local.n.peek()}")
    boxed: &Noisy <- Noisy.construct(n: 3) from HEAP
    boxed <- Noisy.construct(n: 4)
    Console.show("boxed holds {boxed.getview().n.peek()}")
    spare: &Noisy <- Noisy.construct(n: 5)
    boxed <- steal spare
    Console.show("boxed holds {boxed.getview().n.peek()}")
    drop boxed
    Console.show("end")
    return
