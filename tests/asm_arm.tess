// 32-bit ARM assembly: registers by Tessera's names, a condition in the mnemonic (an `it` block before it on Thumb),
// the four kinds of address, register lists, the VFP's S and D views, a system register, and a loop branching on a
// signed comparison.

import Standard::Format
import Standard::Os

/// The larger of two unsigned values: a compare, then a move that runs only when a is lower.
#[target(arch: "arm"), external("asm"), clobbers(FLAGS), pure]
routine max_u32(a: U32, b: U32) -> U32
    block entry()
        cmp<U32, U32>(a, b)
        movlo<U32, U32>(a, b)
        return(a)

/// 1 when a equals b, 0 when not: a move on each side of the condition.
#[target(arch: "arm"), external("asm"), clobbers(FLAGS), pure]
routine is_equal(a: U32, b: U32) -> U32
    block entry()
        cmp<U32, U32>(a, b)
        moveq<U32>(R0, 1)
        movne<U32>(R0, 0)
        return(R0)

/// Reads p[2], p[0], p[2] again and p[2 + 1] through the four kinds of address, and adds them up.
#[target(arch: "arm"), external("asm"), readonly]
routine addresses(p: @U32) -> U32
    block entry()
        ldr<U32, U32>(R2, p.offset(8))  // 3
        ldr<U32, U32>(R3, p.after_offset(4))  // 1, then p is at element 1
        ldr<U32, U32>(R4, p.offset(4).update())  // 3, and p is at element 2
        ldr<U32, U32>(R5, p.index(R3, 4))  // element 2 + 1: 4
        add<U32, U32, U32>(R0, R2, R3)
        add<U32, U32, U32>(R0, R0, R4)
        add<U32, U32, U32>(R0, R0, R5)
        return(R0)

/// Swaps two values through the stack with a register list.
#[target(arch: "arm"), external("asm")]
routine swap_through_stack(a: U32 = R4, b: U32 = R5) -> (U32, U32)
    block entry()
        push<U32>({ R4, R5 })
        pop<U32>({ R6 })
        pop<U32>({ R3 })
        mov<U32, U32>(R0, R3)
        mov<U32, U32>(R1, R6)
        return({ R0, R1 })

/// a * b + c in the VFP's double registers.
#[target(arch: "arm"), external("asm"), pure]
routine mul_add(a: F64, b: F64, c: F64) -> F64
    block entry()
        `vmla.f64`<F64, F64, F64>(c, a, b)
        return(c)

/// The bits of an F32, moved from an S register to a general one.
#[target(arch: "arm"), external("asm"), pure]
routine bits_of(x: F32 = S2) -> U32
    block entry()
        vmov<U32, F32>(R0, S2)
        return(R0)

/// The VFP's status and control register.
#[target(arch: "arm"), external("asm")]
routine fpscr() -> U32
    block entry()
        vmrs<U32>(R0, FPSCR)
        return(R0)

/// The sum 1 + 2 + ... + count, counting down while count is above zero.
#[target(arch: "arm"), external("asm"), clobbers(FLAGS)]
routine sum_down(count: S32 = R1) -> U32
    block entry()
        mov<U32>(R0, 0)
        jump check()

    block check()
        cmp<U32>(R1, 0)
        branch le<S32>
            ? done()
            : continue
        add<U32, U32, U32>(R0, R0, R1)
        sub<U32, U32>(R1, R1, 1)
        jump check()

    block done()
        return(R0)

routine start() -> Void
    block entry()
        claim values : @Array<U32, 5> <- { 1, 2, 3, 4, 5 }
        swapped : (U32, U32) = swap_through_stack(7, 8)
        x       : F32        = 1.0
        Out.write("max {max_u32(3, 9)} {max_u32(9, 3)}\n")
        Out.write("equal {is_equal(4, 4)} {is_equal(4, 5)}\n")
        Out.write("addresses {addresses(values.to<@U32>())}\n")
        Out.write("swapped {swapped.item0} {swapped.item1}\n")
        Out.write("mul_add {mul_add(1.5, 2.0, 0.25)}\n")
        Out.write("bits {bits_of(x)}\n")
        fpscr()
        Out.write("fpscr read\n")
        Out.write("sum {sum_down(10)}\n")
        return()
