# A thread that holds shared read access to a value and asks to read it again stops the program with
# ReenterDuringAccessError: the second read could wait behind a writer that waits for the first.

import Hosted

routine start() -> None
    counter: &U64 <- 0

    held: ReadAuthorized[U64] <- counter.get_shared_read_access()
    Console.show("reading")
    same: @U64 = counter.stride(0)
    again: ReadAuthorized[U64] <- same.get_shared_read_access()
    Console.show("not reached")
    drop again
    drop held
    return
