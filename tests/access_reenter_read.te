# A thread that reads through a MultiReadAccess and asks to read again stops the program with
# ReenterDuringAccessError: the second read could wait behind a writer that waits for the first.

import Standard/Os

routine start() -> None
    local access: @MultiReadAccess <- .construct()

    access.lock_read()
    Console.show("reading")
    access.lock_read()
    Console.show("not reached")
    return
