### A conformance with type parameters is checked against the routines that meet it: Pair[T].eq requires
### Equatable[T], so `conform Equatable[Pair[T]]` must say it in its when, or it claims every Pair is Equatable.
record Pair[T]
needs RecordType T
obeys Equatable[Pair[T]]
    first: T
    second: T

### Makes a `Pair` from its fields.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
common routine Pair[T].construct(first: T, second: T) -> Me
    return Me(first, second)

### Releases nothing: a `Pair` holds no memory of its own.
routine @Pair[T].destruct() -> None
    return

routine Pair[T].eq(other: Me) -> Bool
needs T obeys Equatable
    if me.first == other.first
        return me.second == other.second
    else
        return false

routine start() -> None
    return
