# `&(@T?)` is a place holding an `@T?`: it starts as None, takes a view, and is taken apart with when.
import Hosted

global SEEN: &(@S64?)
global VALUE: &S64 <- 7

### Shows what SEEN holds.
routine report() -> None
    when SEEN.peek()
        is @S64 as p => Console.show("holds {p.peek()}")
        is None => Console.show("holds nothing")
    return

### Runs the case.
routine start() -> None
    report()
    SEEN.poke(VALUE)
    report()
    SEEN.poke(None())
    report()
    return
