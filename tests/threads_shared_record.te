# A global record handed to work on four threads that change its field with no atomic access and no lock.

import Standard/Os

global STATS: @Stats <- (hits: 0)

record Stats
    hits: S64

### The work.
routine work(s: @Stats) -> S64
    each i: U64 in 0 til 100000
        s.hits.peek().add(1).poke_into(s.hits)
    return 0

routine start() -> None
    t1: Thread[S64] = get_thread[S64]()
    t2: Thread[S64] = get_thread[S64]()
    t3: Thread[S64] = get_thread[S64]()
    t4: Thread[S64] = get_thread[S64]()

    t1.put_work(entry: work.to[Callable](), args: STATS)
    t2.put_work(entry: work.to[Callable](), args: STATS)
    t3.put_work(entry: work.to[Callable](), args: STATS)
    t4.put_work(entry: work.to[Callable](), args: STATS)
    t1.wait_finished()
    t2.wait_finished()
    t3.wait_finished()
    t4.wait_finished()
    t1.give_back()
    t2.give_back()
    t3.give_back()
    t4.give_back()
    Console.show("count {STATS.hits.peek()} (expected 400000)")
    return
