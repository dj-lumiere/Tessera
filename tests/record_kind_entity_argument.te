# A type parameter declared T: record takes a type whose values hold nothing with a release duty: an entity argument
# is a build error that says to keep it in an entity.

import Collections

### A value and its weight.
record Weighted[T]
needs RecordType T
    value: T
    weight: U64

routine start() -> None
    w: Weighted[List[S64]] = .hollow()
    return
