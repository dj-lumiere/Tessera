### A concept requirement matches a routine by its whole signature, so a type conforms through one overload of a
### name: Money is Equatable through `eq(me, other: Me)`, and also compares with a plain amount.
import Standard/Format
import Standard/Os

record Money
obeys Equatable[Money]
    cents: S64

routine Money.eq(me: Me, cents: S64) -> Bool
    return me.cents == cents

routine Money.eq(me: Me, other: Me) -> Bool
    return me.cents == other.cents

routine same[T](a: T, b: T) -> Bool
needs T: typename, Equatable[T]
    return a == b

routine start() -> None
    price: Money = Money(cents: 250)
    other: Money = Money(cents: 300)
    cents: S64 = 250
    Out.write("{same(a: price, b: price)} {same(a: price, b: other)} {price.eq(cents)}\n")
    return
