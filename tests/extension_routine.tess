/// Routines can be added to a type from another file: U64 and String are declared in the stdlib.
routine U64.double(%self: Self) -> Self
    block entry():
        %r: Self = %self.mul(2)
        return(%r)

routine String.shout(%self: Self) -> Void
    block entry():
        print("{%self}!\n")
        return()

routine main() -> S32
    block entry():
        %x: U64 = 21
        print("{%x.double()}\n")
        %s: String = "hello"
        %s.shout()
        return(0)
