/// Routines can be added to a type from another file: U64 and Span[Byte] are declared in the stdlib.
import Standard/Format
import Standard/Os

routine U64.double(me: Me) -> Me
    r: Me = me * 2
    return r

routine Span[Byte].shout(me: Me) -> None
    Out.write("{me}!\n")
    return

routine start() -> None
    x: U64 = 21
    Out.write("{x.double()}\n")
    s: Span[Byte] = "hello"
    s.shout()
    return
