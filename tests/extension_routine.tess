/// Routines can be added to a type from another file: U64 and Bytes are declared in the stdlib.
import Standard::Format
import Standard::Os

routine U64.double(self: Self) -> Self
    block entry()
        r : Self = self.mul(2)
        return(r)

routine Bytes.shout(self: Self) -> Void
    block entry()
        Out.write("{self}!\n")
        return()

routine start() -> Void
    block entry()
        x : U64 = 21
        Out.write("{x.double()}\n")
        s : Bytes = "hello"
        s.shout()
        return()
