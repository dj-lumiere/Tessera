/// Routines can be added to a type from another file: U64 and Bytes are declared in the stdlib.
import Standard::Format
import Standard::Os

routine U64.double(me: Me) -> Me
    block entry()
        r : Me = me.mul(2)
        return(r)

routine Bytes.shout(me: Me) -> Void
    block entry()
        Out.write("{me}!\n")
        return()

routine start() -> Void
    block entry()
        x : U64 = 21
        Out.write("{x.double()}\n")
        s : Bytes = "hello"
        s.shout()
        return()
