import Standard/Os

### Counts things.
entity Counter
    count: S64

### Two counters.
entity Pair
    left: Counter
    right: Counter

### A counter at zero.
### :returns: The counter.
routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine Counter.destruct(me: @Me) -> None
    return

### Takes a counter over and ends it.
### :param c: The counter.
routine finish(c: Counter) -> None
    drop c
    return

### Two counters at zero.
### :returns: The pair.
routine Pair.construct() -> Me
    return Me(left: .construct(), right: .construct())

### Ends both counters.
routine Pair.destruct(me: @Me) -> None
    drop me.left
    drop me.right
    return

routine start() -> None
    local p: @Pair <- .construct()

    steal p.left as old inject Counter.construct()
    finish(c: steal old)
    drop p
    return
