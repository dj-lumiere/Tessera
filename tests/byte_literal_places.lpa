# A character literal is a Byte where a Byte goes and a Char everywhere else. A '\xHH' escape is a byte, Byte('x') is a
# Byte anywhere.

import Hosted

record Pair
    first: Byte
    second: Char

### A Byte from a character literal at a return.
### :returns: The byte for z.
routine give() -> Byte
    return 'z'

### The value of a byte.
### :param b: The byte.
### :returns: Its value.
routine take(b: Byte) -> U8
    return b.to[U8]()

routine start() -> None
    a: Byte = 'a'
    b: Byte = '\xE9'
    c: Char = 'x'
    e: Byte = Byte('k')
    f: Byte = Byte('\xFF')
    p: Pair = Pair(first: 'm', second: 'n')
    xs: Items[Byte, 3] = ['a', 'b', '\xFF']
    Console.show("{take('A')} {take(a)} {take(b)} {take(e)} {take(f)} {take(give())} {take(p.first)} {take(xs[2])}")
    Console.show("{a == 'a'} {'a' == a} {a == 'b'} {c == 'x'} {'x' == c}")
    Console.show("{c} {a} {b} {p.second}")
    return
