/// #aligned raises a field's alignment. A record's own is #layout(align: N).
#aligned(16)
record Block
    a: U64
    b: U64

/// Makes a `Block` from its fields.
/// :param a: Its `a`.
/// :param b: Its `b`.
/// :returns: The new value.
routine Block.construct(a: U64, b: U64) -> Me
    return(Me(a, b))

/// Releases nothing: a `Block` holds no memory of its own.
routine Block.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    s: USize = sizeof[Block]()
    return()
