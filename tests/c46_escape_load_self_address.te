# A record that holds the address of its own field, read out of its frame slot with load and returned (the Pin
# issues of Rust in Tessera: a value that points into itself moves).

import Hosted

### Holds a value and the address of it.
record Knot
    value: S64
    at: @S64

### Makes a knot whose address points at its own value.
### :returns: The knot.
routine make() -> Knot
    k: &Knot <- (value: 1234567, at: .hollow())

    k.at.poke(k.value)
    return k.load()

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    for i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    for j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    k: Knot = make()
    s: S64 = scribble(seed: 6666666)
    Console.show("through the address: {k.at.peek()} (expected 1234567, scribble sum {s})")
    return
