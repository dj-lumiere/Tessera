# A STACK place filled with .hollow() and then a poke holds that entity: a second poke would overwrite it without
# ending it, as it would after a place filled with the entity at once.
import Hosted

entity Noisy
    n: S64

common routine Noisy.construct(n: S64) -> Me
    return Me(n)

routine @Noisy.destruct() -> None
    Console.show("destruct {me.n.peek()}")
    return

routine start() -> None
    x: &Noisy <- .hollow()
    x.poke(Noisy.construct(n: 1))
    x.poke(Noisy.construct(n: 2))
    return
