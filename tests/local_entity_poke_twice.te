# A poke into a STACK place that holds an entity ends the value it held first, whether a <- line or a poke put it
# there. After drop or steal the place is hollow, so the next poke ends nothing, and nothing is ended twice.
import Hosted

entity Noisy
    n: S64

common routine Noisy.construct(n: S64) -> Me
    return Me(n)

routine @Noisy.destruct() -> None
    Console.show("destruct {me.n.peek()}")
    return

routine start() -> None
    x: &Noisy <- .hollow()
    x.poke(Noisy.construct(n: 1))
    x.poke(Noisy.construct(n: 2))
    drop x
    x.poke(Noisy.construct(n: 3))
    steal x as old
    drop old
    x.poke(Noisy.construct(n: 4))
    y: &Noisy <- Noisy.construct(n: 5)
    y.poke(Noisy.construct(n: 6))
    Console.show("end")
    return
