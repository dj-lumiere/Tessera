# Tessera doubly-linked list
#
# Generic doubly-linked list with O(1) push/pop at both ends.
# Nodes are heap-allocated via an explicit MemoryManager.
#
# Layout:
#   ListNode[T]    heap node — value, prev, next
#   LinkedList[T]  list head — head ptr, tail ptr, count
#
# Operations:
#   push_front / push_back   O(1) insert
#   pop_front  / pop_back    O(1) remove, returns Optional[T]
#   peek_front / peek_back   O(1) read-only, returns Optional[T]
#   count / is_empty         O(1)
#   iter                     forward emitter (head → tail)
#   free                     frees all nodes

import Hosted

# ── Node ──────────────────────────────────────────────────────────────────────

record ListNode[T]
needs RecordType T
    value: T
    prev: @ListNode[T]?
    next: @ListNode[T]?

### Makes a `ListNode` from its fields.
### :param value: Its `value`.
### :param prev: Its `prev`.
### :param next: Its `next`.
### :returns: The new value.
common routine ListNode[T].construct(value: T, prev: @Me?, next: @Me?) -> Me
    return Me(value, prev, next)

### Releases nothing: a `ListNode` holds no memory of its own.
routine @ListNode[T].destruct() -> None
    return

# ── List ──────────────────────────────────────────────────────────────────────

record LinkedList[T]
needs RecordType T
    head: @ListNode[T]?
    tail: @ListNode[T]?
    count: S64

# ── Emitter ──────────────────────────────────────────────────────────────────

record LinkedListEmitter[T]
needs RecordType T
    current: @ListNode[T]?

# ── Construction ──────────────────────────────────────────────────────────────

common routine LinkedList[T].construct() -> Me
    list: Me = Me(head: None(), tail: None(), count: 0)
    return list

# ── Queries ───────────────────────────────────────────────────────────────────

routine @LinkedList[T].count() -> S64
    len: S64 = me.count.peek()
    return len

routine @LinkedList[T].is_empty() -> Bool
    len: S64 = me.count.peek()
    return len == 0

routine @LinkedList[T].peek_front() -> Optional[T]
    head_or_none: @ListNode[T]? = me.head.peek()

    if head_or_none.is_absent()
        none: Optional[T] = None()
        return none
    else
        head: @ListNode[T] = head_or_none.unwrap()
        val: T = head.value.peek()
        some: Optional[T] = val
        return some

routine @LinkedList[T].peek_back() -> Optional[T]
    tail_or_none: @ListNode[T]? = me.tail.peek()

    if tail_or_none.is_absent()
        none: Optional[T] = None()
        return none
    else
        tail: @ListNode[T] = tail_or_none.unwrap()
        val: T = tail.value.peek()
        some: Optional[T] = val
        return some

# ── Insert ────────────────────────────────────────────────────────────────────

routine @LinkedList[T].add_first(val: T, manager: @MemoryManager) -> None
    node_at: Addr = allocate[ListNode[T]](count: 1, manager)
    if node_at.is_hollow()
        throw OutOfMemoryError()
    node: @ListNode[T] = node_at.to[@ListNode[T]]()
    node.value.poke(val)
    node.prev.poke(None())
    head_or_none: @ListNode[T]? = me.head.peek()
    node.next.poke(head_or_none)
    when head_or_none
        is @ListNode[T] as head => head.prev.poke(node)
        is None => me.tail.poke(node)
    me.head.poke(node)
    next_count: S64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

routine @LinkedList[T].add_last(val: T, manager: @MemoryManager) -> None
    node_at: Addr = allocate[ListNode[T]](count: 1, manager)
    if node_at.is_hollow()
        throw OutOfMemoryError()
    node: @ListNode[T] = node_at.to[@ListNode[T]]()
    node.value.poke(val)
    node.next.poke(None())
    tail_or_none: @ListNode[T]? = me.tail.peek()
    node.prev.poke(tail_or_none)
    when tail_or_none
        is @ListNode[T] as tail => tail.next.poke(node)
        is None => me.head.poke(node)
    me.tail.poke(node)
    next_count: S64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

# ── Remove ────────────────────────────────────────────────────────────────────

routine @LinkedList[T].remove_first(manager: @MemoryManager) -> Optional[T]
    head_or_none: @ListNode[T]? = me.head.peek()

    if head_or_none.is_absent()
        none: Optional[T] = None()
        return none
    else
        head: @ListNode[T] = head_or_none.unwrap()
        val: T = head.value.peek()
        next: @ListNode[T]? = head.next.peek()
        me.head.poke(next)
        when next
            is @ListNode[T] as after => after.prev.poke(None())
            is None => me.tail.poke(None())
        next_count: S64 = me.count.peek() - 1
        next_count.poke_into(me.count)
        deallocate(data: head, manager)
        some: Optional[T] = val
        return some

routine @LinkedList[T].remove_last(manager: @MemoryManager) -> Optional[T]
    tail_or_none: @ListNode[T]? = me.tail.peek()

    if tail_or_none.is_absent()
        none: Optional[T] = None()
        return none
    else
        tail: @ListNode[T] = tail_or_none.unwrap()
        val: T = tail.value.peek()
        prev: @ListNode[T]? = tail.prev.peek()
        me.tail.poke(prev)
        when prev
            is @ListNode[T] as before => before.next.poke(None())
            is None => me.head.poke(None())
        next_count: S64 = me.count.peek() - 1
        next_count.poke_into(me.count)
        deallocate(data: tail, manager)
        some: Optional[T] = val
        return some

# ── Emitter ──────────────────────────────────────────────────────────────────

routine @LinkedList[T].iter() -> LinkedListEmitter[T]
    iter: LinkedListEmitter[T] = LinkedListEmitter[T](current: me.head.peek())
    return iter

### satisfies Emitter[LinkedListEmitter[T], T]
failable routine @LinkedListEmitter[T].emit() -> T
    current: @ListNode[T]? = me.current.peek()

    if current.is_absent()
        throw AbsentValueError()
    cur: @ListNode[T] = current.unwrap()
    val: T = cur.value.peek()
    me.current.poke(cur.next.peek())
    return val

# ── Free ──────────────────────────────────────────────────────────────────────

routine @LinkedList[T].free_all(manager: @MemoryManager) -> None
    until at.is_absent() with at: @ListNode[T]? = me.head.peek()
        cur: @ListNode[T] = at.unwrap()
        next: @ListNode[T]? = cur.next.peek()
        deallocate(data: cur, manager)
        continue with at: next
    me.head.poke(None())
    me.tail.poke(None())
    me.count.poke(0)
    return

# ── Demo ──────────────────────────────────────────────────────────────────────

routine print_list(out: @BufWriter[ConsoleOutput], list: @LinkedList[S64]) -> None
    iter: &LinkedListEmitter[S64]

    out.write("list [")
    iter.store(list.iter())

    loop with first: Bool = true
        item: Optional[S64] = try iter.emit()
        when item
            is S64 as value =>
                if not first
                    out.write(", ")
                value.represent_into(out)
                continue with first: false
            is None => break
    out.write("] length {list.count()}\n")
    return

### Prints "<label> <value>" when the value is present, "<label> none" when it's absent.
routine print_option(out: @BufWriter[ConsoleOutput], label: @[Byte], item: Optional[S64]) -> None
    out.write("{label} ")
    when item
        is S64 as value =>
            out.write("{value}\n")
            return
        is None =>
            out.write("none\n")
            return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    lateinit out: &BufWriter[ConsoleOutput]
    out.construct(fd)
    manager: @MemoryManager = HEAP
    list: &LinkedList[S64] <- .construct()

    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    list.add_last(val: 1, manager)
    list.add_last(val: 2, manager)
    list.add_last(val: 3, manager)
    list.add_first(val: 0, manager)
    list.add_first(val: -1, manager)
    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    print_option(out, label: "peek_back", item: list.peek_back())
    print_option(out, label: "pop_front", item: list.remove_first(manager))
    print_option(out, label: "pop_back", item: list.remove_last(manager))
    print_list(out, list)
    print_option(out, label: "pop_back", item: list.remove_last(manager))
    print_option(out, label: "pop_back", item: list.remove_last(manager))
    print_option(out, label: "pop_back", item: list.remove_last(manager))
    print_option(out, label: "pop_back", item: list.remove_last(manager))
    print_list(out, list)
    list.add_first(val: 7, manager)
    print_option(out, label: "peek_back", item: list.peek_back())
    list.add_last(val: 8, manager)
    print_list(out, list)
    list.free_all(manager)
    print_list(out, list)
    out.flush()
    return
