# Tessera doubly-linked list
#
# Generic doubly-linked list with O(1) push/pop at both ends.
# Nodes are heap-allocated via an explicit MemoryManager.
#
# Layout:
#   ListNode[T]    heap node — value, prev, next
#   LinkedList[T]  list head — head ptr, tail ptr, count
#
# Operations:
#   push_front / push_back   O(1) insert
#   pop_front  / pop_back    O(1) remove, returns Maybe[T]
#   peek_front / peek_back   O(1) read-only, returns Maybe[T]
#   count / is_empty         O(1)
#   iter                     forward iterator (head → tail)
#   free                     frees all nodes

import Standard/Os

# ── Node ──────────────────────────────────────────────────────────────────────

record ListNode[T]
needs T: typename
    value: T
    prev: @ListNode[T]
    next: @ListNode[T]

### Makes a `ListNode` from its fields.
### :param value: Its `value`.
### :param prev: Its `prev`.
### :param next: Its `next`.
### :returns: The new value.
common routine ListNode[T].construct(value: T, prev: @Me, next: @Me) -> Me
needs T: typename
    return Me(value, prev, next)

### Releases nothing: a `ListNode` holds no memory of its own.
routine @ListNode[T].destruct() -> None
needs T: typename
    return

# ── List ──────────────────────────────────────────────────────────────────────

record LinkedList[T]
needs T: typename
    head: @ListNode[T]
    tail: @ListNode[T]
    count: S64

# ── Iterator ──────────────────────────────────────────────────────────────────

record LinkedListIter[T]
needs T: typename
    current: @ListNode[T]

### Makes a `LinkedListIter` from its fields.
### :param current: Its `current`.
### :returns: The new value.
common routine LinkedListIter[T].construct(current: @ListNode[T]) -> Me
needs T: typename
    return Me(current)

### Releases nothing: a `LinkedListIter` holds no memory of its own.
routine @LinkedListIter[T].destruct() -> None
needs T: typename
    return

# ── Construction ──────────────────────────────────────────────────────────────

common routine LinkedList[T].construct() -> Me
    list: Me = Me(head: .hollow(), tail: .hollow(), count: 0)
    return list

# ── Queries ───────────────────────────────────────────────────────────────────

routine @LinkedList[T].count() -> S64
    len: S64 = me.count.peek()
    return len

routine @LinkedList[T].is_empty() -> Bool
    len: S64 = me.count.peek()
    return len == 0

routine @LinkedList[T].peek_front() -> Maybe[T]
    local head: @ListNode[T] = me.head.peek()

    if head.is_hollow()
        none: Maybe[T] = None()
        return none
    else
        val: T = head.value.peek()
        some: Maybe[T] = val
        return some

routine @LinkedList[T].peek_back() -> Maybe[T]
    local tail: @ListNode[T] = me.tail.peek()

    if tail.is_hollow()
        none: Maybe[T] = None()
        return none
    else
        val: T = tail.value.peek()
        some: Maybe[T] = val
        return some

# ── Insert ────────────────────────────────────────────────────────────────────

routine @LinkedList[T].add_first(val: T, alloc: @MemoryManager) -> None
    local node: @ListNode[T] = allocate[ListNode[T]](count: 1, alloc)

    if node.is_hollow()
        crash_allocation()
    node.value.poke(val)
    node.prev.poke(.hollow())
    head: @ListNode[T] = me.head.peek()
    node.next.poke(head)
    if head.is_hollow()
        me.tail.poke(node)
    else
        head.prev.poke(node)
    me.head.poke(node)
    next_count: S64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

routine @LinkedList[T].add_last(val: T, alloc: @MemoryManager) -> None
    local node: @ListNode[T] = allocate[ListNode[T]](count: 1, alloc)

    if node.is_hollow()
        crash_allocation()
    node.value.poke(val)
    node.next.poke(.hollow())
    tail: @ListNode[T] = me.tail.peek()
    node.prev.poke(tail)
    if tail.is_hollow()
        me.head.poke(node)
    else
        tail.next.poke(node)
    me.tail.poke(node)
    next_count: S64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

# ── Remove ────────────────────────────────────────────────────────────────────

routine @LinkedList[T].remove_first(alloc: @MemoryManager) -> Maybe[T]
    local head: @ListNode[T] = me.head.peek()

    if head.is_hollow()
        none: Maybe[T] = None()
        return none
    else
        val: T = head.value.peek()
        next: @ListNode[T] = head.next.peek()
        me.head.poke(next)
        if next.is_hollow()
            me.tail.poke(.hollow())
        else
            next.prev.poke(.hollow())
        next_count: S64 = me.count.peek() - 1
        next_count.poke_into(me.count)
        deallocate(data: head, alloc)
        some: Maybe[T] = val
        return some

routine @LinkedList[T].remove_last(alloc: @MemoryManager) -> Maybe[T]
    local tail: @ListNode[T] = me.tail.peek()

    if tail.is_hollow()
        none: Maybe[T] = None()
        return none
    else
        val: T = tail.value.peek()
        prev: @ListNode[T] = tail.prev.peek()
        me.tail.poke(prev)
        if prev.is_hollow()
            me.head.poke(.hollow())
        else
            prev.next.poke(.hollow())
        next_count: S64 = me.count.peek() - 1
        next_count.poke_into(me.count)
        deallocate(data: tail, alloc)
        some: Maybe[T] = val
        return some

# ── Iterator ──────────────────────────────────────────────────────────────────

routine @LinkedList[T].iter() -> LinkedListIter[T]
    head: @ListNode[T] = me.head.peek()
    iter: LinkedListIter[T] = LinkedListIter[T](current: head)
    return iter

### satisfies Iterator[T, LinkedListIter[T]]
routine @LinkedListIter[T].emit_checked() -> Maybe[T]
    local cur: @ListNode[T] = me.current.peek()

    if cur.is_hollow()
        none: Maybe[T] = None()
        return none
    else
        val: T = cur.value.peek()
        next: @ListNode[T] = cur.next.peek()
        me.current.poke(next)
        some: Maybe[T] = val
        return some

# ── Free ──────────────────────────────────────────────────────────────────────

routine @LinkedList[T].destruct(alloc: @MemoryManager) -> None
    until cur.is_hollow() with cur: @ListNode[T] = me.head.peek()
        next: @ListNode[T] = cur.next.peek()
        deallocate(data: cur, alloc)
        continue with cur: next
    me.head.poke(.hollow())
    me.tail.poke(.hollow())
    me.count.poke(0)
    return

# ── Demo ──────────────────────────────────────────────────────────────────────

routine print_list(out: @BufWriter[ConsoleOutput], list: @LinkedList[S64]) -> None
    local iter: @LinkedListIter[S64] <- .hollow()

    out.write("list [")
    iter.poke(list.iter())

    while true with first: Bool = true
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as value =>
                if not first
                    out.write(", ")
                value.represent_into(out)
                continue with first: false
            is None => break
    out.write("] length {list.count()}\n")
    return

### Prints "<label> <value>" when the value is present, "<label> none" when it's absent.
routine print_option(out: @BufWriter[ConsoleOutput], label: @[Byte], item: Maybe[S64]) -> None
    out.write("{label} ")
    when item
        is S64 as value =>
            out.write("{value}\n")
            return
        is None =>
            out.write("none\n")
            return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    local out: @BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    local alloc: @MemoryManager <- HEAP.peek()
    local list: @LinkedList[S64] <- .construct()

    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    list.add_last(val: 1, alloc)
    list.add_last(val: 2, alloc)
    list.add_last(val: 3, alloc)
    list.add_first(val: 0, alloc)
    list.add_first(val: -1, alloc)
    print_list(out, list)
    print_option(out, label: "peek_front", item: list.peek_front())
    print_option(out, label: "peek_back", item: list.peek_back())
    print_option(out, label: "pop_front", item: list.remove_first(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_list(out, list)
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_option(out, label: "pop_back", item: list.remove_last(alloc))
    print_list(out, list)
    list.add_first(val: 7, alloc)
    print_option(out, label: "peek_back", item: list.peek_back())
    list.add_last(val: 8, alloc)
    print_list(out, list)
    list.destruct(alloc)
    print_list(out, list)
    out.flush()
    return
