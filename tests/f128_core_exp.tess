// Runs F128.exp over its table: prints each mismatch, then the summary line.
routine check_exp(out: @FdWriter) -> Void
    block entry():
        jump loop(0, 0)

    block loop(i: USize, bad: U64):
        done : Bool = i.ge(2120)
        branch done
            ? summary(bad)
            : case(i, bad)

    block case(i: USize, bad: U64):
        x    : U128 = EXP_INPUTS.get(i)
        want : U128 = EXP_WANTS.get(i)
        got  : U128 = f128_of(x).exp().bits()
        ok   : Bool = got.eq(want)
        branch ok
            ? loop(i.add(1), bad)
            : report(i, bad, x, got, want)

    block report(i: USize, bad: U64, x: U128, got: U128, want: U128):
        write(out, "exp ")
        x.represent_hex(out)
        write(out, " got ")
        got.represent_hex(out)
        write(out, " want ")
        want.represent_hex(out)
        write(out, "\n")
        jump loop(i.add(1), bad.add(1))

    block summary(bad: U64):
        total : U64 = 2120
        good  : U64 = total.sub(bad)
        write(out, "exp: {good} of {total} correctly rounded\n")
        return()

// Runs F128.exp2 over its table: prints each mismatch, then the summary line.
routine check_exp2(out: @FdWriter) -> Void
    block entry():
        jump loop(0, 0)

    block loop(i: USize, bad: U64):
        done : Bool = i.ge(2120)
        branch done
            ? summary(bad)
            : case(i, bad)

    block case(i: USize, bad: U64):
        x    : U128 = EXP2_INPUTS.get(i)
        want : U128 = EXP2_WANTS.get(i)
        got  : U128 = f128_of(x).exp2().bits()
        ok   : Bool = got.eq(want)
        branch ok
            ? loop(i.add(1), bad)
            : report(i, bad, x, got, want)

    block report(i: USize, bad: U64, x: U128, got: U128, want: U128):
        write(out, "exp2 ")
        x.represent_hex(out)
        write(out, " got ")
        got.represent_hex(out)
        write(out, " want ")
        want.represent_hex(out)
        write(out, "\n")
        jump loop(i.add(1), bad.add(1))

    block summary(bad: U64):
        total : U64 = 2120
        good  : U64 = total.sub(bad)
        write(out, "exp2: {good} of {total} correctly rounded\n")
        return()

// Runs F128.exp10 over its table: prints each mismatch, then the summary line.
routine check_exp10(out: @FdWriter) -> Void
    block entry():
        jump loop(0, 0)

    block loop(i: USize, bad: U64):
        done : Bool = i.ge(2178)
        branch done
            ? summary(bad)
            : case(i, bad)

    block case(i: USize, bad: U64):
        x    : U128 = EXP10_INPUTS.get(i)
        want : U128 = EXP10_WANTS.get(i)
        got  : U128 = f128_of(x).exp10().bits()
        ok   : Bool = got.eq(want)
        branch ok
            ? loop(i.add(1), bad)
            : report(i, bad, x, got, want)

    block report(i: USize, bad: U64, x: U128, got: U128, want: U128):
        write(out, "exp10 ")
        x.represent_hex(out)
        write(out, " got ")
        got.represent_hex(out)
        write(out, " want ")
        want.represent_hex(out)
        write(out, "\n")
        jump loop(i.add(1), bad.add(1))

    block summary(bad: U64):
        total : U64 = 2178
        good  : U64 = total.sub(bad)
        write(out, "exp10: {good} of {total} correctly rounded\n")
        return()

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()
        check_exp(out)
        check_exp2(out)
        check_exp10(out)
        return(0)
