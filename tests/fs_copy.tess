# File.copy_to_result reports the bytes it copied (an empty file, a small one, and one of several chunks), each copy
# the same size as its source, and a copy that fails (the source is a directory) leaves nothing at the destination:
# on Linux and macOS the destination used to stay behind, made and empty, after the read failed.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

### The size of a file, or U64.MAX when it can't be read.
### :param f: The file.
### :returns: Its size in bytes.
routine size_of(f: File) -> U64
    m: Result[Metadata, FsError] = f.metadata_result()
    when m
        is Metadata as info => return info.size
        is FsError => return U64.MAX

### Writes `count` bytes to a file in `root`, copies it, and prints what the copy reported.
### :param root: The test's directory.
### :param count: The file's size.
### :param alloc: The allocator for the paths and the text.
routine copy_of(root: Directory, count: USize, alloc: @MemoryManager) -> None
    local text: @List[Byte] <- .construct(alloc)

    each i in 0 til count
        letter: U8 = (i % 26).to[U8]() + 97
        text.add_last(letter.bits())
    local source_path: @Memory[Byte] <- root.join(name: "source.txt", alloc)
    local target_path: @Memory[Byte] <- root.join(name: "target.txt", alloc)
    source: File = File.at(source_path.getview())
    target: File = File.at(target_path.getview())
    discard_written: Result[None, FsError] = source.write_all_result(text.getview())
    r: Result[U64, FsError] = source.copy_to_result(target)
    when r
        is U64 as n =>
            same: Bool = size_of(target) == n
            Out.write("{count} bytes: copied {n}, the copy has as many {same}\n")
        is FsError => Out.write("{count} bytes: failed\n")
    drop target_path
    drop source_path
    drop text
    return

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local tmp_path: @Memory[Byte] <- Directory.temp_result(alloc).unwrap()
    local root_path: @Memory[Byte] <- Directory.at(tmp_path.getview()).join(name: "tessera_fs_copy",
        alloc)

    root: Directory = Directory.at(root_path.getview())

    discard_old: Result[None, FsError] = root.delete_all_result(alloc)
    discard_made: Result[None, FsError] = root.create_all_result()
    copy_of(root, count: 0, alloc)
    copy_of(root, count: 5, alloc)
    copy_of(root, count: 100000, alloc)
    local inner_path: @Memory[Byte] <- root.join(name: "inner", alloc)
    local target_path: @Memory[Byte] <- root.join(name: "from_directory.txt", alloc)
    inner: Directory = Directory.at(inner_path.getview())
    target: File = File.at(target_path.getview())
    discard_inner: Result[None, FsError] = inner.create_result()
    r: Result[U64, FsError] = File.at(inner.path).copy_to_result(target)
    Out.write("copying a directory fails: {r.is_failure()}, leaves a file behind: {target.is_present()}\n")
    discard_gone: Result[None, FsError] = root.delete_all_result(alloc)
    drop target_path
    drop inner_path
    drop root_path
    drop tmp_path
    return
