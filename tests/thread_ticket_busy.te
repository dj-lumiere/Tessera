# A ticket runs one piece of work at a time: put_work on a ticket whose work hasn't finished crashes with
# TicketBusyError instead of losing the first piece.

import Standard/Os

routine slow(ns: U64) -> U64
    local deadline: Duration = Clock.monotonic() + Duration.from_nanoseconds(ns.to[S64]())

    until Clock.monotonic() >= deadline
        nothing
    then
        return ns

routine start() -> None
    t: Thread[U64] = get_thread[U64]()
    t.put_work(entry: slow.to[Callable](), args: 100000000)
    t.put_work(entry: slow.to[Callable](), args: 1)
    t.wait_finished()
    t.give_back()
    return
