# A callee given a local record stores the record's field into a global.

import Hosted

lateinit global KEPT: &@S64

### Holds an address.
record R
    held: @S64

### Keeps what the record holds.
### :param r: The record.
routine keep_field(r: @R) -> None
    KEPT.poke(r.held.peek())
    return

### The local and the record live in this frame.
routine fill() -> None
    l: &S64 <- 1234567
    r: &R <- R(held: dangling[S64]())

    r.held.poke(l)
    keep_field(r: r)
    return

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    for i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    for j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    fill()
    s: S64 = scribble(seed: 6666666)
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
