// Calling through a Callable: load it from memory, then .call it. A Callable value in SSA (a record field read
// with =, or a routine name) is called the same way.

import Standard::Format
import Standard::Os

record Ops
    op : Callable<(S64,), S64>

routine twice(x: S64) -> S64
    block entry():
        return(x.mul(2))

routine main() -> S32
    block entry():
        ops_val : Ops = Ops { op: twice.to<Callable>() }
        claim ops : @Ops <- ops_val
        loaded : Callable<(S64,), S64> = ops.op.load()
        a      : S64                   = loaded.call(21)
        field  : Callable<(S64,), S64> = ops_val.op
        b      : S64                   = field.call(a)
        Out.write("{b}\n")
        return(0)
