# A type that declares same and notsame gets === and !==: here a handle that is the same when its number is.

import Hosted

### A handle named by a number.
record Handle
    number: U32

### Whether two handles have the same number.
### :param other: The other handle.
### :returns: True for the same number.
routine Handle.same(other: Me) -> Bool
    return me.number == other.number

### Whether two handles have different numbers.
### :param other: The other handle.
### :returns: True for different numbers.
routine Handle.notsame(other: Me) -> Bool
    return me.number != other.number

### Compares handles with === and !==.
routine start() -> None
    a: Handle = Handle(number: 1)
    b: Handle = Handle(number: 1)
    c: Handle = Handle(number: 2)
    Console.show("{a === b} {a === c} {a !== c} {a !== b}")
    return
