# A piece of work goes to its ticket with steal: t.put_work(steal work). The work here is handed an entity, which its
# routine ends once it has run. The Noisy says when it ends, and holds memory from HEAP, which the heap check would
# catch given back twice.

import Standard/Os

### A value that says when it ends.
entity Noisy
    n: S64
    cell: &S64

### Makes one, with a cell from HEAP.
### :param n: Its number.
### :returns: The new value.
common routine Noisy.construct(n: S64) -> Me
    cell: &S64 <- n from HEAP
    return Me(n, cell: steal cell)

### Says that it ends, and gives the cell back.
routine @Noisy.destruct() -> None
    Console.show("end {me.n.peek()}")
    drop me.cell
    return

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Noisy) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

routine start() -> None
    a: &Noisy <- Noisy.construct(5)
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = look.to[Work](item: steal a)
    t.put_work(steal work)
    n: S64 = t.retrieve()
    Console.show("looked at {n}")
    drop t
    return
