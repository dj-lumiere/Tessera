// Thread.spawn takes the state its entry takes: an entry on an @S64 can't be handed a @U8.

import Standard::Os

routine count_up(n: @S64) -> Void
    block entry()
        n.load().add(1).store_into(n)
        return()

routine main() -> S32
    block entry()
        claim small : @U8 <- 0
        t : Thread = Thread.spawn(count_up.to<Callable>(), small)
        t.join()
        return(0)
