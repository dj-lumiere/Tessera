// Thread.spawn takes the state its entry takes: an entry on an @S64 can't be handed a @U8.

import Standard/Os

routine count_up(n: @S64) -> Void
    block entry()
        n.peek().add(1).poke_into(n)
        return()

routine start() -> Void
    block entry()
        claim small: @U8 <- 0
        t: Thread = Thread.spawn(entry: count_up.to[Callable](), arg: small)
        t.join()
        return()
