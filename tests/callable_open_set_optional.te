# A `Callable?` kept in a field is open to any failure: a plain Callable or a plain `Callable?` parameter goes in as it is,
# None stays None, an all-zero field is None, and a `when` arm written with the plain Callable observes it.

import Hosted

### A hook kept in a field.
record Hook
    action: Callable[(S64,), S64]?

### Triple n.
### :param n: The number.
### :returns: Thrice n.
infallible routine thrice(n: S64) -> S64
    return n * 3

### Keeps the hook it is given.
### :param given: A hook or None.
### :returns: The record.
routine keep(given: Callable[(S64,), S64]?) -> Hook
    return Hook(action: given)

### Says what a hook does for 5.
### :param hook: The hook.
routine show_hook(hook: Hook) -> None
    when hook.action
        is Callable[(S64,), S64] as run => Console.show("runs {run.call(5)}")
        is None => Console.show("none")
    return

### Runs the example.
routine start() -> None
    show_hook(keep(thrice.to[Callable]()))
    show_hook(keep(None()))
    show_hook(Hook(action: thrice.to[Callable]()))
    return
