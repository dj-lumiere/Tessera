# A failable routine value handed to a parameter written as a plain Callable is a build error: that routine has no way
# to pass the failure on.

import Standard/Os

crashable OddError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine OddError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("{me.value} is odd")
    return

### Half of an even n.
### :param n: The number.
### :returns: Its half.
failable routine half(n: S64) -> S64
    if n % 2 != 0
        throw OddError(value: n)
    return n // 2

### f of x.
### :param f: The routine.
### :param x: Its argument.
### :returns: f(x).
routine apply(f: Callable[(S64,), S64], x: S64) -> S64
    return f.call(x)

routine start() -> None
    got: S64 = apply(f: half.to[Callable](), x: 8)
    set_exit_code(got.to[S32]())
    return
