# B128's math functions pass a NaN through quieted, its payload kept, as add and mul do: one-argument functions,
# and atan2, hypot and powf (which used to give the default NaN), the first operand's NaN first. A signaling NaN
# wins over the C99 cases that ignore a quiet one (powf(1, sNaN), powf(sNaN, 0), hypot(inf, sNaN)), and a quiet
# NaN doesn't (powf(1, qNaN) = 1, hypot(inf, qNaN) = inf). The edge results the cleanup touched stay: asin and acos
# at ±1, atan past 2^115, ln at 0, -1 and inf.

import Standard/Format
import Standard/Os

### Writes `name` and the bits of `v` in hex.
### :param name: What was computed.
### :param v: The result.
routine show(name: @[Byte], v: B128) -> None
    Console.show("{name}: ", end: "")
    v.bits().represent_hex_into(Console.output())
    Console.show("")
    return

routine start() -> None
    local q: B128 = B128.from_bits(0x7FFF8000000000000000000000001234)
    local s: B128 = B128.from_bits(0x7FFF0000000000000000000000005678)
    local one: B128 = B128.from_bits(0x3FFF0000000000000000000000000000)
    local zero: B128 = B128.from_bits(0)
    local inf: B128 = B128.INFINITY
    local huge: B128 = B128.from_bits(0xC0800000000000000000000000000000)

    show(name: "ln q", v: q.ln_unchecked())
    show(name: "ln s", v: s.ln_unchecked())
    show(name: "atan s", v: s.atan())
    show(name: "asin q", v: q.asin_unchecked())
    show(name: "acos s", v: s.acos_unchecked())
    show(name: "exp_m1 s", v: s.exp_m1_unchecked())
    show(name: "atan2 q,1", v: atan2(y: q, x: one))
    show(name: "atan2 1,s", v: atan2(y: one, x: s))
    show(name: "atan2 s,q", v: atan2(y: s, x: q))
    show(name: "hypot q,1", v: hypot_unchecked(x: q, y: one))
    show(name: "hypot 1,q", v: hypot_unchecked(x: one, y: q))
    show(name: "hypot q,s", v: hypot_unchecked(x: q, y: s))
    show(name: "hypot inf,q", v: hypot_unchecked(x: inf, y: q))
    show(name: "hypot inf,s", v: hypot_unchecked(x: inf, y: s))
    show(name: "powf q,1", v: q.powf_unchecked(one))
    show(name: "powf 1,q", v: one.powf_unchecked(q))
    show(name: "powf q,0", v: q.powf_unchecked(zero))
    show(name: "powf 1,s", v: one.powf_unchecked(s))
    show(name: "powf s,0", v: s.powf_unchecked(zero))
    show(name: "powf q,s", v: q.powf_unchecked(s))
    show(name: "asin 1", v: one.asin_unchecked())
    show(name: "asin -1", v: (-one).asin_unchecked())
    show(name: "acos 1", v: one.acos_unchecked())
    show(name: "acos -1", v: (-one).acos_unchecked())
    show(name: "atan -2^129", v: huge.atan())
    show(name: "atan inf", v: inf.atan())
    show(name: "ln 0", v: zero.ln_unchecked())
    show(name: "ln -1", v: (-one).ln_unchecked())
    show(name: "ln inf", v: inf.ln_unchecked())
    show(name: "ln 1", v: one.ln_unchecked())
    return
