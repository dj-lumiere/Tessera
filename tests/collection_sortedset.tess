// SortedSet[S64] against a model. An LCG drives random add / remove / has in three phases: few keys, then enough
// keys for a B-tree at least four levels deep, then a phase that removes by random rank until most keys are gone, so borrows
// and merges run. Every 500 operations a checkpoint prints the length, a running checksum of every result, the
// elements at a few ranks, and a hash of the (ascending) iteration sequence. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Rng
    state: U64

/// What every phase works with besides the collection.
record Harness
    /// Where checkpoints are written.
    out: @BufWriter[Out]
    /// The generator that picks each operation.
    rng: @Rng

/// One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    /// The phase's number, as checkpoints print it.
    number: USize
    /// How many operations the phase runs.
    ops: USize
    /// How many distinct keys the operations draw from.
    keys: USize
    /// The weight of add among the operations.
    adds: USize
    /// Whether removes go by rank instead of by key.
    by_rank: Bool

/// Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    /// The phase's number.
    phase: USize
    /// The operations run so far in the phase.
    op: USize
    /// The checksum of every result so far.
    results: S64

/// Makes a `Rng` from its fields.
/// :param state: Its `state`.
/// :returns: The new value.
routine Rng.construct(state: U64) -> Me
    return(Me(state))

/// Releases nothing: a `Rng` holds no memory of its own.
routine Rng.destruct(me: @Me) -> Void
    return()

/// Makes a `Harness` from its fields.
/// :param out: Its `out`.
/// :param rng: Its `rng`.
/// :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng) -> Me
    return(Me(out, rng))

/// Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> Void
    return()

/// Makes a `Phase` from its fields.
/// :param number: Its `number`.
/// :param ops: Its `ops`.
/// :param keys: Its `keys`.
/// :param adds: Its `adds`.
/// :param by_rank: Its `by_rank`.
/// :returns: The new value.
routine Phase.construct(number: USize, ops: USize, keys: USize, adds: USize, by_rank: Bool) -> Me
    return(Me(number, ops, keys, adds, by_rank))

/// Releases nothing: a `Phase` holds no memory of its own.
routine Phase.destruct(me: @Me) -> Void
    return()

/// Makes a `Checkpoint` from its fields.
/// :param phase: Its `phase`.
/// :param op: Its `op`.
/// :param results: Its `results`.
/// :returns: The new value.
routine Checkpoint.construct(phase: USize, op: USize, results: S64) -> Me
    return(Me(phase, op, results))

/// Releases nothing: a `Checkpoint` holds no memory of its own.
routine Checkpoint.destruct(me: @Me) -> Void
    return()

routine Rng.below(me: @Me, bound: USize) -> USize
    state: U64 = me.state.peek()
    next: U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
    me.state.poke(next)
    bucket: U64 = next.shr(33).mod(bound.to[U64]())
    value: USize = bucket.to[USize]()
    return(value)

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash.mul_wrap(1000003).add_wrap(value)
    return(mixed)

routine labeled[T](out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer[T]
    out.write(" {label} {value}")
    return()

// Folds every element in iteration order.
routine iteration_hash(set: @SortedSet[S64]) -> S64
    local iter: @SortedSetIter[S64] <- .construct(set)

    jump next(0)

    block next(hash: S64)
        item: Maybe[S64] = iter.emit_checked()
        when item
            is S64 as key => next(mix(hash, value: key))
            is Unit => return(hash)

// Folds the elements at ranks 0, count / 3, count / 2, and count - 1 (0 for an empty set).
routine rank_hash(set: @SortedSet[S64]) -> S64
    local count: USize = set.count()

    empty: Bool = count.eq(0)
    branch empty
        ? return(0)
        : fold()

    block fold()
        first: S64 = set.get_by_rank(0)
        third: S64 = set.get_by_rank(count.div(3))
        half: S64 = set.get_by_rank(count.div(2))
        last: S64 = set.get_by_rank(count.sub(1))
        hash: S64 = mix(
            hash: mix(hash: mix(hash: mix(hash: 0, value: first), value: third), value: half),
            value: last)
        return(hash)

routine checkpoint(out: @BufWriter[Out], set: @SortedSet[S64], at: Checkpoint) -> Void
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: USize = set.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "ranks", value: rank_hash(set))
    labeled(out, label: "iteration", value: iteration_hash(set))
    out.write("\n")
    return()

// Runs ops random operations on keys below keys: an add when the kind (0..9) is below adds, a remove below 7, and
// a has otherwise. With by_rank, a remove takes the element at a random rank instead of a random key.
// Returns the updated results checksum.
routine run_phase(harness: Harness, set: @SortedSet[S64], phase: Phase, results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: USize = phase.ops
    local keys: USize = phase.keys
    local adds: USize = phase.adds
    local by_rank: Bool = phase.by_rank

    jump next(0, results)

    block next(op: USize, checksum: S64)
        done: Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        key: S64 = rng.below(keys).to[S64]()
        kind: USize = rng.below(10)
        is_add: Bool = kind.lt(adds)
        is_remove: Bool = kind.lt(7)
        when
            is_add => add(op, checksum, key)
            is_remove => remove(op, checksum, key)
            else => lookup(op, checksum, key)

    block add(op: USize, checksum: S64, key: S64)
        added: Bool = set.add(key)
        jump record(op, checksum, added.to[S64]())

    block remove(op: USize, checksum: S64, key: S64)
        empty: Bool = set.is_empty()
        nonempty: Bool = empty.bitnot()
        rank_remove: Bool = by_rank.bitand(nonempty)
        branch rank_remove
            ? remove_rank(op, checksum)
            : remove_key(op, checksum, key)

    block remove_rank(op: USize, checksum: S64)
        rank: USize = rng.below(set.count())
        key: S64 = set.get_by_rank(rank)
        jump remove_key(op, checksum, key)

    block remove_key(op: USize, checksum: S64, key: S64)
        removed: Bool = set.remove(key)
        jump record(op, checksum, mix(hash: key, value: removed.to[S64]()))

    block lookup(op: USize, checksum: S64, key: S64)
        found: Bool = set.has(key)
        jump record(op, checksum, found.to[S64]())

    block record(op: USize, checksum: S64, result: S64)
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: USize = op.add(1)
        report: Bool = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out: harness.out, set,
            at: Checkpoint(phase: phase.number, op: op, results: checksum))
        jump next(op, checksum)

// Adds from's elements to to by rank, starting from the middle, so to is built in a different order.
routine copy_rotated(from: @SortedSet[S64], to: @SortedSet[S64]) -> Void
    local count: USize = from.count()
    local half: USize = count.div(2)

    jump next(0)

    block next(i: USize)
        done: Bool = i.ge(count)
        branch done
            ? return()
            : copy(i)

    block copy(i: USize)
        rank: USize = i.add(half).mod(count)
        to.add(from.get_by_rank(rank))
        jump next(i.add(1))

routine report_eq(out: @BufWriter[Out], label: Bytes, equal: Bool) -> Void
    out.write("{label} {equal}\n")
    return()

routine start() -> Void
    fd: @Out = Out.writer()
    claim out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    claim alloc: @MemoryManager <- make_heap_memory()
    claim rng: @Rng <- Rng(state: 1)
    claim set: @SortedSet[S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, set,
        phase: Phase(number: 1, ops: 3000, keys: 64, adds: 5, by_rank: false), results: 0)
    r2: S64 = run_phase(harness, set,
        phase: Phase(number: 2, ops: 12000, keys: 20000, adds: 5, by_rank: false), results: r1)
    r3: S64 = run_phase(harness, set,
        phase: Phase(number: 3, ops: 9000, keys: 20000, adds: 1, by_rank: true), results: r2)

    claim copied: @SortedSet[S64] <- .construct(alloc)
    report_eq(out, label: "empty copy equal", equal: set.peek().eq(copied.peek()))
    copy_rotated(from: set, to: copied)
    report_eq(out, label: "rotated copy equal", equal: set.peek().eq(copied.peek()))
    report_eq(out, label: "rotated copy same order",
        equal: iteration_hash(set).eq(iteration_hash(copied)))
    copied.add(-1)
    report_eq(out, label: "extra element equal", equal: set.peek().eq(copied.peek()))
    copied.remove(-1)
    report_eq(out, label: "extra element removed equal", equal: set.peek().eq(copied.peek()))
    size: USize = set.count()
    last: S64 = set.get_by_rank(size.sub(1))
    copied.remove(last)
    copied.add(last.add(1))
    report_eq(out, label: "changed element equal", equal: set.peek().eq(copied.peek()))
    copied.destruct()
    set.destruct()
    report_eq(out, label: "freed is empty", equal: set.is_empty())
    out.flush()
    return()
