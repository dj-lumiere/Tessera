// SortedSet<S64> against a model. An LCG drives random add / remove / contains in three phases: few keys, then enough
// keys for a B-tree at least four levels deep, then a phase that removes by random rank until most keys are gone, so borrows
// and merges run. Every 500 operations a checkpoint prints the length, a running checksum of every result, the
// elements at a few ranks, and a hash of the (ascending) iteration sequence. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

routine Rng.below(self: @Self, bound: USize) -> USize
    block entry()
        state : U64 = self.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        self.state.store(next)
        bucket : U64   = next.shr(33).mod(bound.to<U64>())
        value  : USize = bucket.to<USize>()
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry()
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<W>(out: @W, label: Bytes, value: S64) -> Void
require W: typename, Writer<W>
    block entry()
        out.write(" {label} {value}")
        return()

// Folds every element in iteration order.
routine iteration_hash(set: @SortedSet<S64>) -> S64
    shared iter : @SortedSetIter<S64> <- .construct(set)

    block entry()
        jump next(0)

    block next(hash: S64)
        item : Option<S64> = iter.next()
        when item
            .Present(key) -> next(mix(hash, key))
            .Absent       -> return(hash)

// Folds the elements at ranks 0, count / 3, count / 2, and count - 1 (0 for an empty set).
routine rank_hash(set: @SortedSet<S64>) -> S64
    shared count : USize = set.load().count()

    block entry()
        empty : Bool = count.eq(0)
        branch empty
            ? return(0)
            : fold()

    block fold()
        first : S64 = set.load().get_by_rank(0)
        third : S64 = set.load().get_by_rank(count.div(3))
        half  : S64 = set.load().get_by_rank(count.div(2))
        last  : S64 = set.load().get_by_rank(count.sub(1))
        hash  : S64 = mix(mix(mix(mix(0, first), third), half), last)
        return(hash)

routine checkpoint(out: @BufWriter<Out>, set: @SortedSet<S64>, phase: USize, op: USize,
    results: S64) -> Void
    block entry()
        out.write("phase {phase}")
        labeled(out, "op", op.to<S64>())
        size : USize = set.load().count()
        labeled(out, "length", size.to<S64>())
        labeled(out, "results", results)
        labeled(out, "ranks", rank_hash(set))
        labeled(out, "iteration", iteration_hash(set))
        out.write("\n")
        return()

// Runs ops random operations on keys below keys: an add when the kind (0..9) is below adds, a remove below 7, and
// a contains otherwise. With by_rank, a remove takes the element at a random rank instead of a random key.
// Returns the updated results checksum.
routine run_phase(out: @BufWriter<Out>, set: @SortedSet<S64>, rng: @Rng, phase: USize, ops: USize,
    keys: USize, adds: USize, by_rank: Bool, results: S64) -> S64
    block entry()
        jump next(0, results)

    block next(op: USize, checksum: S64)
        done : Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        key       : S64   = rng.below(keys).to<S64>()
        kind      : USize = rng.below(10)
        is_add    : Bool  = kind.lt(adds)
        is_remove : Bool  = kind.lt(7)
        when
            is_add    -> add(op, checksum, key)
            is_remove -> remove(op, checksum, key)
            else      -> lookup(op, checksum, key)

    block add(op: USize, checksum: S64, key: S64)
        added : Bool = set.add(key)
        jump record(op, checksum, added.to<S64>())

    block remove(op: USize, checksum: S64, key: S64)
        empty       : Bool = set.load().is_empty()
        nonempty    : Bool = empty.bitnot()
        rank_remove : Bool = by_rank.bitand(nonempty)
        branch rank_remove
            ? remove_rank(op, checksum)
            : remove_key(op, checksum, key)

    block remove_rank(op: USize, checksum: S64)
        rank : USize = rng.below(set.load().count())
        key  : S64   = set.load().get_by_rank(rank)
        jump remove_key(op, checksum, key)

    block remove_key(op: USize, checksum: S64, key: S64)
        removed : Bool = set.remove(key)
        jump record(op, checksum, mix(key, removed.to<S64>()))

    block lookup(op: USize, checksum: S64, key: S64)
        found : Bool = set.load().contains(key)
        jump record(op, checksum, found.to<S64>())

    block record(op: USize, checksum: S64, result: S64)
        mixed   : S64   = mix(checksum, result)
        op_next : USize = op.add(1)
        report  : Bool  = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out, set, phase, op, checksum)
        jump next(op, checksum)

// Adds from's elements to to by rank, starting from the middle, so to is built in a different order.
routine copy_rotated(from: @SortedSet<S64>, to: @SortedSet<S64>) -> Void
    shared count : USize = from.load().count()
    shared half  : USize = count.div(2)

    block entry()
        jump next(0)

    block next(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? return()
            : copy(i)

    block copy(i: USize)
        rank : USize = i.add(half).mod(count)
        to.add(from.load().get_by_rank(rank))
        jump next(i.add(1))

routine report_eq(out: @BufWriter<Out>, label: Bytes, equal: Bool) -> Void
    block entry()
        out.write("{label} {equal}\n")
        return()

routine main() -> S32
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc : @Allocator      <- make_heap_allocator()
        claim rng   : @Rng            <- Rng { state: 1 }
        claim set   : @SortedSet<S64> <- .construct(alloc)

        r1 : S64 = run_phase(out, set, rng, 1, 3000, 64, 5, false, 0)
        r2 : S64 = run_phase(out, set, rng, 2, 12000, 20000, 5, false, r1)
        r3 : S64 = run_phase(out, set, rng, 3, 9000, 20000, 1, true, r2)

        claim copied : @SortedSet<S64> <- .construct(alloc)
        report_eq(out, "empty copy equal", set.load().eq(copied.load()))
        copy_rotated(set, copied)
        report_eq(out, "rotated copy equal", set.load().eq(copied.load()))
        report_eq(out, "rotated copy same order", iteration_hash(set).eq(iteration_hash(copied)))
        copied.add(-1)
        report_eq(out, "extra element equal", set.load().eq(copied.load()))
        copied.remove(-1)
        report_eq(out, "extra element removed equal", set.load().eq(copied.load()))
        size : USize = set.load().count()
        last : S64   = set.load().get_by_rank(size.sub(1))
        copied.remove(last)
        copied.add(last.add(1))
        report_eq(out, "changed element equal", set.load().eq(copied.load()))
        copied.destruct()
        set.destruct()
        report_eq(out, "freed is empty", set.load().is_empty())
        out.flush()
        return(0)
