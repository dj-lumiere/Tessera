# Work that keeps the address it is handed in a thread's global, waited for: the address outlives the routine anyway.

import Standard/Os

@threadlocal
global KEPT: &@S64 <- .hollow()

### Keeps an address.
### :param p: The address.
### :returns: 0.
routine keep(p: @S64) -> S64
    KEPT.poke(p)
    return 0

### Hands the address of a local to the work, and waits for it.
routine fill() -> None
    l: &S64 <- 1234567

    t: Thread[S64] <- get_thread[S64]()
    work_t: Work[S64] = keep.to[Work](p: l)
    t.put_work(steal work_t)
    t.retrieve()
    drop t
    return

routine start() -> None
    fill()
    return
