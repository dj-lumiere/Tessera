// JSON strings (Standard::Json): every ASCII code point between two letters through the code-point path, in the form
// RazorForge's JSON encoder printed before it called these (`34: "a\"z"`), then UTF-8 text through the Writer path
// (escapes, multi-byte characters, DEL, a stray continuation byte, the empty text), and the two paths and the
// widths agreeing on every code point up to U+10FFFF.

import Standard::Collections
import Standard::Format
import Standard::Json
import Standard::Os

/// Quotes `a`, `c`, `z` through the code-point path and writes the result, which is ASCII here.
routine ascii_line(c: U32) -> Void
    shared chars   : @Array<U32, 3>  <- { 0x61, c, 0x7A }
    shared quoted  : @Array<U32, 16> <- uninit
    shared text    : Slice<U32>      = chars.to<Slice<U32>>()
    shared count   : USize           = text.json_quoted_count()
    shared written : USize           = text.json_quote_into(quoted.to<Slice<U32>>())

    block entry()
        same : Bool = count.eq(written)
        branch same
            ? continue
            : crash_logic_breached()
        Out.write("{c}: ")
        jump each(0)

    block each(i: USize)
        branch i.ge(written)
            ? done()
            : continue
        byte : Byte = quoted.getitem(i).to<U8>().bits()
        claim one : @Array<Byte, 1> <- { byte }
        Out.writer().write_bytes(one.to<@Byte>(), 1)
        jump each(i.add(1))

    block done()
        Out.write("\n")
        return()

/// Quotes UTF-8 text through the Writer path.
routine quote_line(text: Bytes) -> Void
    shared buffer : @List<Byte> <- .construct()

    block entry()
        text.json_quote_into(buffer)
        Out.write("{buffer.to<Bytes>()}\n")
        buffer.destruct()
        return()

/// Checks every code point up to U+10FFFF: the code-point path's length is the sum of the widths, a character that
/// needs no escape comes out as itself, and the escape bytes are the ones the Writer path writes for the same ASCII.
routine agree() -> Void
    shared chars  : @Array<U32, 1> <- { 0 }
    shared quoted : @Array<U32, 8> <- uninit
    shared bytes  : @List<Byte>    <- .construct()

    block entry()
        jump each(0, 0)

    block each(c: U32, bad: U32)
        branch c.gt(0x10FFFF)
            ? report(bad)
            : continue
        chars.setitem(0, c)
        text    : Slice<U32> = chars.to<Slice<U32>>()
        written : USize      = text.json_quote_into(quoted.to<Slice<U32>>())
        width   : USize      = c.json_escaped_width()
        fits    : Bool       = written.eq(width.add(2))
        plain   : Bool       = width.eq(1)
        branch plain
            ? itself(c, bad, fits)
            : escaped(c, bad, fits, written)

    block itself(c: U32, bad: U32, fits: Bool)
        same : Bool = quoted.getitem(1).eq(c)
        good : Bool = fits.bitand(same)
        jump each(c.add(1), good ? bad : bad.add(1))

    block escaped(c: U32, bad: U32, fits: Bool, written: USize)
        byte : Byte = c.to<U8>().bits()
        claim one : @Array<Byte, 1> <- { byte }
        bytes.clear()
        single : Bytes = Bytes.from_ptr(one.to<@Byte>(), 1)
        single.json_quote_into(bytes)
        jump compare(c, bad, fits, written, 0)

    block compare(c: U32, bad: U32, fits: Bool, written: USize, i: USize)
        branch i.ge(written)
            ? each(c.add(1), fits ? bad : bad.add(1))
            : continue
        from_bytes : U32  = bytes.getitem(i).to<U8>().to<U32>()
        same       : Bool = quoted.getitem(i).eq(from_bytes)
        branch same
            ? compare(c, bad, fits, written, i.add(1))
            : each(c.add(1), bad.add(1))

    block report(bad: U32)
        Out.write("code points where the paths or widths disagree: {bad}\n")
        bytes.destruct()
        return()

routine main() -> S32
    block entry()
        jump ascii(0)

    block ascii(c: U32)
        branch c.ge(0x80)
            ? text()
            : continue
        ascii_line(c)
        jump ascii(c.add(1))

    block text()
        quote_line("")
        quote_line("plain")
        quote_line("q\"\\\n\t\x01\x1F end")
        quote_line("\x08\x0C\x0D\x0B\x7F")
        quote_line("caf\xC3\xA9 \xE2\x82\xAC \xF0\x9F\x98\x80")
        quote_line("stray \x80 byte")
        claim empty : @Array<U32, 1> <- { 0 }
        none : Slice<U32> = empty.to<Slice<U32>>().getslice(0, 0)
        Out.write("empty count: {none.json_quoted_count()}\n")
        agree()
        return(0)
