// JSON strings (Standard/Json): every ASCII code point between two letters through the code-point path, in the form
// RazorForge's JSON encoder printed before it called these (`34: "a\"z"`), then UTF-8 text through the Writer path
// (escapes, multi-byte characters, DEL, a stray continuation byte, the empty text), and the two paths and the
// widths agreeing on every code point up to U+10FFFF.

import Standard/Collections
import Standard/Format
import Standard/Json
import Standard/Os

/// Quotes `a`, `c`, `z` through the code-point path and writes the result, which is ASCII here.
routine ascii_line(c: U32) -> None
    local chars: @Array[U32, 3] <- [0x61, c, 0x7A]
    local quoted: @Array[U32, 16] <- .hollow()
    local text: Span[U32] = chars.getview()
    local count: USize = text.json_quoted_count()
    local written: USize = text.json_quote_into(quoted.getview())

    if not (count == written)
        crash_logic_breached()
    Out.write("{c}: ")

    each i in 0 til written
        byte: Byte = quoted[i].to[U8]().bits()
        local one: @Array[Byte, 1] <- [byte]
        Out.writer().write_bytes(data: one.to[@Byte](), count: 1)
    Out.write("\n")
    return

/// Quotes UTF-8 text through the Writer path.
routine quote_line(text: Span[Byte]) -> None
    local buffer: @List[Byte] <- .construct()

    text.json_quote_into(buffer)
    Out.write("{buffer.getview()}\n")
    buffer.destruct()
    return

/// Checks every code point up to U+10FFFF: the code-point path's length is the sum of the widths, a character that
/// needs no escape comes out as itself, and the escape bytes are the ones the Writer path writes for the same ASCII.
routine agree() -> None
    local chars: @Array[U32, 1] <- [0]
    local quoted: @Array[U32, 8] <- .hollow()
    local bytes: @List[Byte] <- .construct()

    while c <= 0x10FFFF with c: U32 = 0, bad: U32 = 0
        chars[0] = c
        text: Span[U32] = chars.getview()
        written: USize = text.json_quote_into(quoted.getview())
        width: USize = c.json_escaped_width()
        fits: Bool = written == width + 2
        if width == 1
            same: Bool = quoted[1] == c
            good: Bool = fits and same
            bad_after: U32 = when
                good => bad
                else => bad + 1
            continue with c: c + 1, bad: bad_after
        else
            byte: Byte = c.to[U8]().bits()
            local one: @Array[Byte, 1] <- [byte]
            bytes.clear()
            single: Span[Byte] = Span[Byte].construct(data: one.to[@Byte](), count: 1)
            single.json_quote_into(bytes)

            each i in 0 til written
                bad_after: U32 = when
                    fits => bad
                    else => bad + 1
                from_bytes: U32 = bytes[i].to[U8]().to[U32]()
                if quoted[i] == from_bytes
                    continue
                else
                    break
            then
                continue with c: c + 1, bad: bad_after

            continue with c: c + 1, bad: bad + 1
    then
        Out.write("code points where the paths or widths disagree: {bad}\n")
        bytes.destruct()
        return

routine start() -> None
    while c < 0x80 with c: U32 = 0
        ascii_line(c)
        continue with c: c + 1
    quote_line("")
    quote_line("plain")
    quote_line("q\"\\\n\t end")
    quote_line("\r")
    quote_line("caf\xC3\xA9 \xE2\x82\xAC \xF0\x9F\x98\x80")
    quote_line("stray \x80 byte")
    local empty: @Array[U32, 1] <- [0]
    none: Span[U32] = empty.getview().getslice(start: 0, count: 0)
    Out.write("empty count: {none.json_quoted_count()}\n")
    agree()
    return
