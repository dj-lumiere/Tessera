// A value bound in another block is out of reach there too when the use is a field: it is passed as a block
// argument.
record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    p: Point = Point(x: 1)
    jump next()

    block next()
        x: S64 = p.x
        return()
