# An @export routine returns a T or a Result[T, TErrorCode]: C can't take a variant apart.

### Half of `n`, when it is even.
### :param n: The number.
### :returns: Half, or None.
@export("half_or_none")
routine half_or_none(n: S64) -> Optional[S64]
    if n % 2 == 0
        return n // 2
    return None()
