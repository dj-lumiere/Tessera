# A Stamped[T]? is the stamp itself, 8 bytes: the all-zero stamp is None. when, try, is_absent, unwrap and a
# field of that type work as on any Optional.

import Hosted

### A node with a link that may be missing.
entity Node
    value: S64
    next: Stamped[Node]?

### Makes a node.
### :param value: Its value.
### :param next: The node after it, if any.
### :returns: The node.
common routine Node.construct(value: S64, next: Stamped[Me]?) -> Me
    return Me(value, next)

### What a link names: its value, -1 for none, -2 for an ended node.
### :param link: The link.
### :returns: The value.
routine describe(link: Stamped[Node]?) -> S64
    when link
        is Stamped[Node] as s =>
            when try s.fetch()
                is @Node as n => return n.value.peek()
                is None => return -2
        is None => return -1

### Shows the layout and the four ways to read it.
routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    Console.show("sizes: {sizeof[Stamped[Node]]()} {sizeof[Stamped[Node]?]()}")
    last: Stamped[Node] = PoolManager.add(Node.construct(value: 3, next: None()))
    first: Stamped[Node] = PoolManager.add(Node.construct(value: 1, next: last))
    none: Stamped[Node]? = None()
    some: Stamped[Node]? = first
    Console.show("describe: {describe(none)} {describe(some)} {describe(first.fetch().next.peek())}")
    Console.show("absent: {none.is_absent()} {some.is_absent()} {first.fetch().next.peek().is_absent()} {last.fetch().next.peek().is_absent()}")
    Console.show("same: {some.unwrap() === first}")
    via_try: S64 = when try some.unwrap().fetch()
        is @Node as n => n.value.peek()
        is None => -9
    Console.show("try: {via_try}")
    PoolManager.remove(last)
    Console.show("after remove: {describe(first.fetch().next.peek())}")
    drop pool
    return
