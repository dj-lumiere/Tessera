# BF16's special functions, erf, erfc, gamma and ln_gamma: CORE-MATH ports, correctly rounded, so the same bits on
# every target (BF16 rounds B32's result, recomputing powf, hypot and atan2 in B64 at a BF16 midpoint). Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer is NaN, ln_gamma has +inf
# at 0 and the negative integers.

import Standard/Format
import Standard/Os

routine show(name: @[Byte], v: BF16) -> None
    Console.show("{name} {v} {v.bits()}")
    return

routine start() -> None
    show(name: "erf(0.5)", v: BF16.erf(0.5))
    show(name: "erf(-4)", v: BF16.erf(-4.0))
    show(name: "erfc(3)", v: BF16.erfc(3.0))
    show(name: "erfc(10)", v: BF16.erfc(10.0))
    show(name: "erfc(-1)", v: BF16.erfc(-1.0))
    show(name: "gamma(5)", v: BF16.gamma_unchecked(5.0))
    show(name: "gamma(0.5)", v: BF16.gamma_unchecked(0.5))
    show(name: "gamma(-2.5)", v: BF16.gamma_unchecked(-2.5))
    show(name: "gamma(35.5)", v: BF16.gamma_unchecked(35.5))
    show(name: "gamma(-0)", v: BF16.gamma_unchecked(-0.0))
    show(name: "gamma(-2)", v: BF16.gamma_unchecked(-2.0))
    show(name: "ln_gamma(1)", v: BF16.ln_gamma_unchecked(1.0))
    show(name: "ln_gamma(2)", v: BF16.ln_gamma_unchecked(2.0))
    show(name: "ln_gamma(0.5)", v: BF16.ln_gamma_unchecked(0.5))
    show(name: "ln_gamma(-2.5)", v: BF16.ln_gamma_unchecked(-2.5))
    show(name: "ln_gamma(100)", v: BF16.ln_gamma_unchecked(100.0))
    show(name: "ln_gamma(-3)", v: BF16.ln_gamma_unchecked(-3.0))
    # atan2 with a tiny ratio: y / x lands on a BF16 midpoint in B32 and B64 alike, and the true value lies
    # just inside it, so it rounds toward zero.
    show(name: "atan2(0x0003, 2)", v: atan2(y: BF16.from_bits(0x0003), x: 2.0))
    show(name: "atan2(0x0007, 2)", v: atan2(y: BF16.from_bits(0x0007), x: 2.0))
    # exact midpoints tie to even
    show(name: "hypot(3, 4)", v: hypot_unchecked(x: BF16.from_bits(0x4040), y: BF16.from_bits(0x4080)))
    show(name: "powf(3, 5)", v: BF16.powf_unchecked(3.0, 5.0))
    return
