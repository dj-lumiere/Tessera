# Giving back the exclusive access whose view is handed to thread work before the work is waited for is a build error:
# the work would go on through a view of an access no one holds.

import Hosted

### Doubles the value.
### :param value: An exclusive access to it.
routine double(value: Authorized[U64]) -> None
    at: @U64 = value.getview()
    at.poke(at.peek() * 2)
    return

routine start() -> None
    n: &U64 <- 21

    view: Authorized[U64] <- n.get_exclusive_access()
    t: Thread[None] <- get_thread[None]()
    work_t: Work[None] = double.to[Work](value: view)
    t.put_work(steal work_t)
    drop view
    t.retrieve()
    drop t
    return
