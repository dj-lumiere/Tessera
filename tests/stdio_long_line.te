# Console.ask_line over lines longer than standard input's buffer (8192 bytes), lines that end right at its edge, a
# blank line, a "\r\n" line end, and a last line with no line end: each comes out whole, with its count.

import Hosted

### Shows each line's count and first byte.
routine start() -> None
    loop with count: U64 = 0
        when try Console.ask_line(HEAP)
            is BorrowedSlice[Byte] as line =>
                n: U64 = line.count()
                first: @[Byte] = line.getslice(start: 0, count: n.min(4))
                Console.show("{n} {first}")
                drop line
                continue with count: count + 1
            is None =>
                Console.show("{count} lines")
                return
