# A hex literal is an address where an Addr goes: a local, an argument, a global's first value, a record field.
import Hosted

global UART: &Addr <- 0x09000000

record Device
    base: Addr
    size: U64

### The address a device sits at, as the routine gets it.
### :param at: The address.
### :returns: The address as a number.
routine number_of(at: Addr) -> U64
    return ptrtoint[Addr, U64](at)

routine start() -> None
    base: Addr = 0x30010000
    device: &Device <- Device(base: 0x8, size: 4)
    next: Addr = base +% 16b
    Console.show("{number_of(base)} {number_of(UART.peek())} {number_of(0x1FF)} {number_of(0x1000)} {number_of(device.base.peek())} {number_of(next)}")
    return
