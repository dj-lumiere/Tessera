/// A concept requirement matches a routine by its whole signature, so a type conforms through one overload of a
/// name: Money is Equatable through `eq(self, other: Self)`, and also compares with a plain amount.
import Standard::Format
import Standard::Os

record Money
conform Equatable<Money>
    cents : S64

routine Money.eq(self: Self, cents: S64) -> Bool
    block entry()
        return(self.cents.eq(cents))

routine Money.eq(self: Self, other: Self) -> Bool
    block entry()
        return(self.cents.eq(other.cents))

routine same<T>(a: T, b: T) -> Bool
require T: typename, Equatable<T>
    block entry()
        return(a.eq(b))

routine main() -> S32
    block entry()
        price : Money = Money { cents: 250 }
        other : Money = Money { cents: 300 }
        cents : S64   = 250
        Out.write("{same(price, price)} {same(price, other)} {price.eq(cents)}\n")
        return(0)
