/// A concept requirement matches a routine by its whole signature, so a type conforms through one overload of a
/// name: Money is Equatable through `eq(me, other: Me)`, and also compares with a plain amount.
import Standard/Format
import Standard/Os

record Money
conform Equatable[Money]
    cents: S64

/// Makes a `Money` from its fields.
/// :param cents: Its `cents`.
/// :returns: The new value.
routine Money.construct(cents: S64) -> Me
    return(Me(cents))

/// Releases nothing: a `Money` holds no memory of its own.
routine Money.destruct(me: @Me) -> Void
    return()

routine Money.eq(me: Me, cents: S64) -> Bool
    return(me.cents.eq(cents))

routine Money.eq(me: Me, other: Me) -> Bool
    return(me.cents.eq(other.cents))

routine same[T](a: T, b: T) -> Bool
require T: typename, Equatable[T]
    return(a.eq(b))

routine start() -> Void
    price: Money = Money(cents: 250)
    other: Money = Money(cents: 300)
    cents: S64 = 250
    Out.write("{same(a: price, b: price)} {same(a: price, b: other)} {price.eq(cents)}\n")
    return()
