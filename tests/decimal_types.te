# D32, D64, and D128 from Ingrid/Decimal: arithmetic rounded once to each width (a tie to the even one), the text that
# keeps a value's exponent, reading text, comparison, and the conversions to and from integers and between widths.

import Ingrid/Decimal
import Standard/Hosted

### Shows a D64 read from text, with a label.
### :param label: What the line says first.
### :param text: The text read.
routine show(label: @[Byte], text: @[Byte]) -> None
    d: D64 = text.to[D64]()
    Console.show("{label}: {d}")
    return

### Shows the arithmetic.
routine arithmetic() -> None
    a: D64 = "0.1".to[D64]()
    b: D64 = "0.2".to[D64]()
    sum: D64 = a + b
    tenths: D64 = "0.3".to[D64]()
    Console.show("0.1 + 0.2 = {sum}, == 0.3: {sum == tenths}")
    one32: D32 = S64.to[D32](1)
    three32: D32 = S64.to[D32](3)
    one64: D64 = S64.to[D64](1)
    three64: D64 = S64.to[D64](3)
    one128: D128 = S64.to[D128](1)
    three128: D128 = S64.to[D128](3)
    Console.show("1 / 3: D32 {one32 / three32}, D64 {one64 / three64}, D128 {one128 / three128}")
    two32: D32 = S64.to[D32](2)
    Console.show("2 / 3 as D32: {two32 / three32}")
    half: D64 = "2.50".to[D64]()
    two: D64 = S64.to[D64](2)
    one_point: D64 = "1.0".to[D64]()
    one_points: D64 = "1.00".to[D64]()
    Console.show("2.50 keeps its zero: {half}, times 2: {half * two}, 1.0 == 1.00: {one_point == one_points}")
    Console.show("neg/abs/sqrt: {-a}, {half.neg().abs()}, {two.sqrt()}, {(two * two).sqrt()}")
    return

### Shows the text of a few values.
routine text() -> None
    show("1e20", "1e20")
    show("123e-10", "123e-10")
    show("0.000001", "0.000001")
    show("0.0000001", "0.0000001")
    show("-0", "-0")
    show("tie at 16 digits, 1.0000000000000005", "1.0000000000000005")
    show("tie at 16 digits, 1.0000000000000015", "1.0000000000000015")
    show("tie at 16 digits, 12345678901234565", "12345678901234565")
    show("inf", "inf")
    show("-Infinity", "-Infinity")
    show("nan", "nan")
    price: D64 = "2.675".to[D64]()
    tiny: D64 = "-0.004".to[D64]()
    Console.show("fixed: {Fixed[D64](value: price, digits: 2)}, {Fixed[D64](value: tiny, digits: 2)}")
    one_half: D64 = "1.5".to[D64]()
    seven: D32 = S64.to[D32](7)
    minus_two: D128 = S64.to[D128](-2)
    Console.show("diagnose: {one_half.diagnose()}, {seven.diagnose()}, {minus_two.diagnose()}")
    return

### Shows the comparisons and the roundings.
routine comparison() -> None
    a: D64 = "0.1".to[D64]()
    b: D64 = "0.2".to[D64]()
    five: D64 = S64.to[D64](5)
    quiet: D64 = D64.quiet_nan()
    Console.show("compare: {a < b}, {b <= a}, {a.compare(b)}, {quiet < a}, {quiet == quiet}, {quiet.is_nan()}")
    Console.show("min/max/clamp: {a.min(b)}, {a.max(b)}, {five.clamp(lo: a, hi: b)}, {quiet.min(a)}")
    x: D64 = "-2.5".to[D64]()
    y: D64 = "2.5".to[D64]()
    z: D64 = "3.5".to[D64]()
    Console.show("rounding: {x.trunc()} {x.floor()} {x.ceil()} {x.round()} {y.round(rule: RoundingRule.HALF_EVEN)} {z.round(rule: RoundingRule.HALF_AWAY)}")
    return

### Shows the conversions.
routine conversions() -> None
    a: D64 = "-7.9".to[D64]()
    b: D64 = "255.99".to[D64]()
    c: D64 = "1e30".to[D64]()
    Console.show("to integers: {a.to[S64]()}, {b.to[U8]()}, {c.to[S128]()}")
    over: D64 = S64.to[D64](256)
    minus: D64 = S64.to[D64](-1)
    endless: D64 = D64.infinity(negative: false)
    Console.show("try 256 as U8: {try over.to[U8]()}, try -1 as U64: {try minus.to[U64]()}, try inf: {try endless.to[S32]()}")
    big: U64 = 18446744073709551615
    small: S64 = -123456789
    low: S128 = -170141183460469231731687303715884105728
    Console.show("from integers: {big.to[D64]()}, {small.to[D32]()}, {low.to[D128]()}")
    one: D32 = S64.to[D32](1)
    digits: D64 = "1.23456789".to[D64]()
    half: D64 = "1.50".to[D64]()
    Console.show("widths: {one.to[D64]()}, {digits.to[D32]()}, {half.to[D32]()}")
    huge: D64 = "1e300".to[D64]()
    Console.show("try 1e300 as D32: {try huge.to[D32]()}, unchecked: {huge.to_unchecked[D32]()}")
    bits: U64 = S64.to[D64](1).bits()
    Console.show("bits: {Hex[U64](value: bits)}, from_bits: {D64.from_bits(0x31C0000000000001)}")
    zero: D64 = D64.zero()
    top: D64 = "9.999999999999999e384".to[D64]()
    ten: D64 = S64.to[D64](10)
    Console.show("unchecked: {ten.truediv_unchecked(zero)}, {zero.truediv_unchecked(zero)}, {top.mul_unchecked(ten)}")
    return

### Shows what reading bad text gives.
routine bad_text() -> None
    when check "1.2.3".to[D64]()
        is D64 as d => Console.show("read {d}")
        is InvalidValueError as e => Console.show("{e}")
        is EmptyTextError as e => Console.show("{e}")
    empty: Maybe[D64] = try "".to[D64]()
    sign: Maybe[D64] = try "-".to[D64]()
    Console.show("try empty: {empty}, try sign: {sign}")
    long: D128 = "1234567890123456789012345678901234567".to[D128]()
    Console.show("D128 from 37 digits: {long}")
    return

routine start() -> None
    arithmetic()
    text()
    comparison()
    conversions()
    bad_text()
    return
