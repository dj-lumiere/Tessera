import Standard/Collections
import Standard/Format

### Every destruct leaves a hollow value alone: a slot that starts as .hollow() is safe to release unfilled.
import Standard/Os

routine start() -> None
    local l: @List[S64] <- .hollow()

    drop l
    local d: @Dict[S64, S64] <- .hollow()
    drop d
    local st: @Set[S64] <- .hollow()
    drop st
    local b: @@[Byte] <- .hollow()
    drop b
    local s: @@[U8] <- .hollow()
    drop s
    local c: @CircularList[S64] <- .hollow()
    drop c
    local sd: @SortedDict[S64, S64] <- .hollow()
    drop sd
    local pq: @PriorityQueue[S64, S64] <- .hollow()
    drop pq
    Out.write("ok\n")
    return
