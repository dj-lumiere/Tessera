import Collections

### Every destruct leaves a hollow value alone: a slot that starts as .hollow() is safe to release unfilled.
import Hosted

routine start() -> None
    l: &List[S64] <- .hollow()

    drop l
    d: &Dict[S64, S64] <- .hollow()
    drop d
    st: &Set[S64] <- .hollow()
    drop st
    b: &@[Byte] <- .hollow()
    drop b
    s: &@[U8] <- .hollow()
    drop s
    c: &RotatableList[S64] <- .hollow()
    drop c
    sd: &SortedDict[S64, S64] <- .hollow()
    drop sd
    pq: &PriorityQueue[S64, S64] <- .hollow()
    drop pq
    Console.show("ok")
    return
