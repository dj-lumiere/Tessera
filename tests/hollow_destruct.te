import Collections

### Every destruct leaves a hollow value alone: a slot that starts as .hollow() is safe to release unfilled.
import Hosted

routine start() -> None
    lateinit l: &List[S64]

    drop l
    lateinit d: &Dict[S64, S64]
    drop d
    lateinit st: &Set[S64]
    drop st
    lateinit b: &@[Byte]
    drop b
    lateinit s: &@[U8]
    drop s
    lateinit c: &RotatableList[S64]
    drop c
    lateinit sd: &SortedDict[S64, S64]
    drop sd
    lateinit pq: &PriorityQueue[S64, S64]
    drop pq
    Console.show("ok")
    return
