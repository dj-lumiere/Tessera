import Standard/Hosted

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine @Counter.destruct() -> None
    return

### Takes a counter over and ends it.
### :param c: The counter.
routine finish(c: Counter) -> None
    drop c
    return

routine start() -> None
    x: Counter = Counter.construct()
    return
