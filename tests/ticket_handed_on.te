# A ticket handed to a routine that takes it is that routine's to give back: the caller owes no drop.

import Standard/Os

### Gives the ticket back.
routine give_back(t: Thread[None]) -> None
    drop t
    return

routine start() -> None
    first: Thread[None] <- get_thread[None]()
    second: Thread[None] <- get_thread[None]()
    give_back(t: first)
    give_back(t: second)
    Console.show("2 tickets given back")
    return
