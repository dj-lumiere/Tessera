# A conversion names the type it goes to, so generic code converts once its type parameter is known, and a
# pointer's to[@U] binds U from the call.

import Standard/Os

routine widen[T](x: S32) -> T
needs T: typename
    r: T = x.to[T]()
    return r

routine start() -> None
    a: S64 = widen[S64](-5)
    b: B64 = widen[B64](3)
    Console.show("{a} {b}")
    local slot: @U64 <- 0x3FF0000000000000
    f: B64 = slot.to[@B64]().peek()
    big: S64 = 300
    Console.show("{f} {a.to_wrap[U8]()} {big.to_clamp[U8]()}")
    return
