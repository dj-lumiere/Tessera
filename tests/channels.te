# Channels: a thread transmits 1 to 1000 through room for 4 to a receiver that adds them up, then closes, and the
# receiver gets ChannelClosedError after the last value. Three threads share the receiving end of a SharedChannel and
# each value reaches one of them. Fibers of one thread pass values to each other, parking instead of holding up the
# thread. transmit_if_room fails when the room is full, a receiver that closes makes the transmitters get
# ChannelClosedError, and a receiver waiting on an empty channel gets CancelRequested when its ticket is cancelled.

import Fiber
import Hosted

routine produce(ch: @Channel[U64]) -> None
    until i > 1000 with i: U64 = 1
        try ch.transmit(i)
        continue with i: i + 1
    ch.close_transmitting()
    return

routine sum_all(ch: @Channel[U64]) -> U64
    loop with total: U64 = 0
        when check ch.receive()
            is U64 as v => continue with total: total + v
            is ChannelClosedError => return total
            is CancelRequested => return 0

routine shared_produce(ch: @SharedChannel[U64]) -> None
    until i > 3000 with i: U64 = 1
        try ch.transmit(i)
        continue with i: i + 1
    ch.close_transmitting()
    return

routine shared_sum(ch: @SharedChannel[U64]) -> U64
    loop with total: U64 = 0
        when check ch.receive()
            is U64 as v => continue with total: total + v
            is ChannelClosedError => return total
            is CancelRequested => return 0

routine fiber_produce(ch: @Channel[U64]) -> U64
    until i > 100 with i: U64 = 1
        try ch.transmit(i)
        continue with i: i + 1
    ch.close_transmitting()
    return 100

### Waits for a value that never comes, and says in `got` how the wait ended: 1 closed, 2 cancelled.
routine wait_forever(ch: @Channel[U64], got: @Authorized[U64]) -> None
    code: U64 = when check ch.receive()
        is U64 as v => v
        is ChannelClosedError => 1
        is CancelRequested => 2
    got.getview().poke(code)
    return

routine start() -> None
    out: @ConsoleOutput = Console.output()
    ch: &Channel[U64] <- .construct(capacity: 4)
    p: Thread[None] <- get_thread[None]()
    work_p: Work[None] = produce.to[Work](ch: ch)
    p.put_work(work_p)
    total: U64 = sum_all(ch)
    p.retrieve()
    drop p
    out.write("one receiver: {total}\n")
    drop ch

    shared: &SharedChannel[U64] <- .construct(capacity: 8)
    shared.add_receiver()
    shared.add_receiver()
    r1: Thread[U64] <- get_thread[U64]()
    work_r1: Work[U64] = shared_sum.to[Work](ch: shared)
    r1.put_work(work_r1)
    r2: Thread[U64] <- get_thread[U64]()
    work_r2: Work[U64] = shared_sum.to[Work](ch: shared)
    r2.put_work(work_r2)
    r3: Thread[U64] <- get_thread[U64]()
    work_r3: Work[U64] = shared_sum.to[Work](ch: shared)
    r3.put_work(work_r3)
    shared_produce(shared)
    all: U64 = r1.retrieve() + r2.retrieve() + r3.retrieve()
    out.write("three receivers: {all}\n")
    drop r1
    drop r2
    drop r3
    drop shared

    between: &Channel[U64] <- .construct(capacity: 1)
    f: Fiber[U64] <- FIBERS.get_fiber[U64]()
    work_f: Work[U64] = fiber_produce.to[Work](ch: between)
    f.put_work(work_f)
    g: Fiber[U64] <- FIBERS.get_fiber[U64]()
    work_g: Work[U64] = sum_all.to[Work](ch: between)
    g.put_work(work_g)
    out.write("fibers: {g.retrieve()}\n")
    drop f
    drop g
    drop between

    small: &Channel[U64] <- .construct(capacity: 2)
    first: Bool = small.transmit_if_room(1)
    second: Bool = small.transmit_if_room(2)
    third: Bool = small.transmit_if_room(3)
    small.close_receiving()
    after: Bool = try small.transmit(4)
    out.write("transmit_if_room: {first} {second} {third}, after the receiver closed: {after}\n")
    drop small

    empty: &Channel[U64] <- .construct(capacity: 1)
    got: &U64 <- 0
    result: Authorized[U64] <- got.get_exclusive_access()
    w: Thread[None] <- get_thread[None]()
    work_w: Work[None] = wait_forever.to[Work](ch: empty, got: result)
    w.put_work(steal work_w)
    early: Bool = try w.waitfor(2ms).retrieve()
    w.cancel()
    try w.retrieve()
    drop result
    out.write("finished before the cancel: {early}, the wait ended with {got.load()}\n")
    drop w
    drop empty
    drop FIBERS
    return
