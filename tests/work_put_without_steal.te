# put_work takes the work over, so the work is handed with steal: put_work(work) without it is a build error that shows
# the steal form.

import Standard/Os

routine seven() -> S64
    return 7

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = seven.to[Work]()
    t.put_work(work)
    Console.show("{t.retrieve()}")
    drop t
    return
