# A pointer isn't Representable or Diagnosable, but a record with a pointer field still derives both: the derived
# routines write the field's address, through to[Addr](). Only the zero address is printed, since a real one changes from
# run to run.
import Hosted

@derive(Representable, Diagnosable)
record Node
    value: S64
    next: Addr

routine start() -> None
    tail: &Node <- Node(value: 2, next: Addr.zero())

    node: Node = tail.load()
    Console.show("{node}")
    Console.show("{node.diagnose()}")
    return
