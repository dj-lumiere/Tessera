/// Free routines of one name that differ in their parameter types: a call picks the one its arguments' types are,
/// exactly.
import Standard::Format
import Standard::Os

routine describe(n: S64) -> Bytes
    block entry()
        return("an S64")

routine describe(text: Bytes) -> Bytes
    block entry()
        return("some text")

routine describe(flag: Bool) -> Bytes
    block entry()
        return("a Bool")

routine describe(at: @S64) -> Bytes
    block entry()
        return("a pointer to an S64")

routine describe(at: Addr) -> Bytes
    block entry()
        return("an address")

routine describe(n: S64, times: USize) -> Bytes
    block entry()
        return("an S64 and a count")

routine main() -> S32
    block entry()
        n : S64 = 7
        claim slot : @S64 <- n
        greeting : Bytes = "hello"
        address  : Addr  = slot
        Out.write("{describe(n)}\n")
        Out.write("{describe(greeting)}\n")
        Out.write("{describe(true)}\n")
        Out.write("{describe(slot)}\n")
        Out.write("{describe(address)}\n")
        Out.write("{describe(n, 3)}\n")
        return(0)
