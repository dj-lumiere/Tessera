# An entity ends once: dropping its slot a second time is a build error, though the first drop left the slot empty.

import Standard/Os

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n)

### Ends it.
routine @Counter.destruct() -> None
    return

routine start() -> None
    c: &Counter <- .construct(1)

    drop c
    drop c
    return
