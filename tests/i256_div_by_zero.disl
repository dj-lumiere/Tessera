; I256 division by zero panics with TrapCode.DivByZero: exit status 101.

routine main() -> I32
    block entry():
        %big:  I256 = 0x1_0000000000000000_0000000000000000_0000000000000000
        %zero: I256 = 0
        println_slice("before")
        %q: I256 = %big.udiv(%zero)
        println_slice("not reached")
        return(0)
