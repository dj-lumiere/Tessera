import Standard/Os

### Counts things.
entity Counter
    count: S64

record Holder
    c: Counter

### Makes a `Holder` from its fields.
### :param c: Its `c`.
### :returns: The new value.
common routine Holder.construct(c: Counter) -> Me
    return Me(c)

### Releases nothing: a `Holder` holds no memory of its own.
routine @Holder.destruct() -> None
    return

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine @Counter.destruct() -> None
    return

### Takes a counter over and ends it.
### :param c: The counter.
routine finish(c: Counter) -> None
    slot: &Counter <- steal c

    drop slot
    return

routine start() -> None
    h: Holder = (c: .construct())
    return
