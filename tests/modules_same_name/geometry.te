# Geometry and Physics each declare a Point, a Point.weight, a describe, a preset LIMIT, and a global CALLS.

module Geometry

global CALLS: &S64

preset LIMIT: S64 = 100

record Point
    x: S64
    y: S64

common routine Point.make(x: S64, y: S64) -> Me
    return Me(x: x, y: y)

### The taxicab length.
routine Point.weight() -> S64
    return me.x.abs() + me.y.abs()

routine describe() -> S64
    next_calls: S64 = CALLS.peek() + 1
    next_calls.poke_into(CALLS)
    return LIMIT

routine calls() -> S64
    return CALLS.peek()
