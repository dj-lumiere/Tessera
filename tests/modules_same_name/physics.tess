module Physics

global CALLS: @S64

preset LIMIT: S64 = 7

record Point
    mass: S64

routine Point.make(mass: S64) -> Me
    return(Me(mass: mass))

routine Point.weight(me: Me) -> S64
    return(me.mass.mul(10))

routine describe() -> S64
    next_calls: S64 = CALLS.peek().add(1)
    next_calls.poke_into(CALLS)
    return(LIMIT)

routine calls() -> S64
    return(CALLS.peek())
