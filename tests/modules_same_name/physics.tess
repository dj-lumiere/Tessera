module Physics

record Point
    mass : S64

preset LIMIT: S64 = 7

global CALLS: S64

routine Point.make(%mass: S64) -> Self
    block entry():
        return(Self { mass: %mass })

routine Point.weight(%self: Self) -> S64
    block entry():
        return(%self.mass.mul(10))

routine describe() -> S64
    block entry():
        CALLS.load().add(1).store_into(CALLS)
        return(LIMIT)

routine calls() -> S64
    block entry():
        return(CALLS.load())
