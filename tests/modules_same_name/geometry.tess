// Geometry and Physics each declare a Point, a Point.weight, a describe, a preset LIMIT, and a global CALLS.

module Geometry

global CALLS: @S64

preset LIMIT: S64 = 100

record Point
    x : S64
    y : S64

routine Point.make(x: S64, y: S64) -> Self
    block entry():
        return(Self { x: x, y: y })

/// The taxicab length.
routine Point.weight(self: Self) -> S64
    block entry():
        return(self.x.abs().add(self.y.abs()))

routine describe() -> S64
    block entry():
        next_calls : S64 = CALLS.load().add(1)
        next_calls.store_into(CALLS)
        return(LIMIT)

routine calls() -> S64
    block entry():
        return(CALLS.load())
