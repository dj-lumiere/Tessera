// The root module imports Geometry, so its names come unqualified; Physics is reached by its path. Each module's
// routines and globals are separate symbols.

import Geometry
import Standard::Format

routine main() -> S32
    block entry():
        %a : Point          = Point.make(3, -4)
        %b : Physics::Point = Physics::Point.make(2)
        print("Geometry weight {%a.weight()}, Physics weight {%b.weight()}\n")
        print("describe {describe()} and {Physics::describe()}, again {Physics::describe()}\n")
        print("calls {calls()} and {Physics::calls()}\n")
        print("LIMIT {LIMIT}, Physics::LIMIT {Physics::LIMIT}\n")
        return(0)
