# The root module imports Geometry, so its names come unqualified. Physics is reached by its path. Each module's
# routines and globals are separate symbols.

import Geometry
import Standard/Format
import Standard/Os

routine start() -> None
    a: Point = Point.make(x: 3, y: -4)
    b: Physics/Point = Physics/Point.make(2)
    Console.show("Geometry weight {a.weight()}, Physics weight {b.weight()}")
    Console.show("describe {describe()} and {Physics/describe()}, again {Physics/describe()}")
    Console.show("calls {calls()} and {Physics/calls()}")
    Console.show("LIMIT {LIMIT}, Physics::LIMIT {Physics/LIMIT}")
    return
