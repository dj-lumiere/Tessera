# The element routines of BorrowedSlice[T], BorrowedCell[T], and @[T]. A BorrowedSlice reaches its elements like a @[T]: m[i] is the value,
# getslot(i) its place as a @T (an entity element comes out with steal m.getslot(i)), getslice a run of them as a @[T].
# A BorrowedCell[T] is read and written with load and store, its value as a @T with getview. A scalar literal goes into a
# BorrowedCell with `from`, and `from STACK` is a slot of the frame.

import Standard/Collections
import Standard/Os

routine start() -> None
    m: &[S64] <- [1, 2, 3, 4] * 1 from HEAP
    b: &S64 <- 10 from HEAP
    frame: &S64 <- 5 from STACK
    lists: &[List[S64]] <- BorrowedSlice[List[S64]].construct(count: 2, manager: HEAP)

    m.getslot(0).poke(m[1] + m[2])
    m.getslot(3).poke(m.getslot(3).peek() * 10)
    run: @[S64] = m.getslice(start: 1, count: 2)
    Console.show("{m[0]} {run[0]} {run.getslot(1).peek()} {m.getslot(3).peek()} {m.count()}")
    m.swap(first: 0, second: 3)
    Console.show("swapped: {m[0]} {m[3]}")
    b.store(b.load() + frame.load())
    Console.show("box: {b.load()} {b.getview().peek()}")
    each i: U64 in 0 til 2
        lists.getslot(i).poke(List[S64].construct(HEAP))
    lists.getslot(1).add_last(7)
    taken: &List[S64] <- steal lists.getslot(1)
    Console.show("taken: {taken.count()}")
    drop taken
    lists.destruct_all()
    drop b
    drop m
    return
