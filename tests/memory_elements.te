# The element routines of Memory[T], Box[T], and @[T]. An element of a Memory is a Box[T] (m[i]), read with load and
# written with store, its value moved out with take. getview(i) is the element as a @T, getslice a run of them as a
# @[T]. A Box[T] is read and written with load and store, its value as a @T with getview. A scalar literal goes into a
# Box with `from`, and `from STACK` is a slot of the frame.

import Standard/Collections
import Standard/Os

routine start() -> None
    local m: @Memory[S64] <- [1, 2, 3, 4] * 1 from HEAP
    local b: @Box[S64] <- 10 from HEAP
    local frame: @S64 <- 5 from STACK
    local lists: @Memory[List[S64]] <- Memory[List[S64]].construct(count: 2, manager: HEAP)

    m[0].store(m[1].load() + m[2].load())
    m.getview(3).poke(m.getview(3).peek() * 10)
    run: @[S64] = m.getslice(start: 1, count: 2)
    Console.show("{m[0].load()} {run[0]} {run.getslot(1).peek()} {m.getview(3).peek()} {m.count()}")
    m.swap(first: 0, second: 3)
    Console.show("swapped: {m[0].load()} {m[3].load()}")
    b.store(b.load() + frame.peek())
    Console.show("box: {b.load()} {b.getview().peek()}")
    each i: U64 in 0 til 2
        lists.getview(i).poke(List[S64].construct(HEAP))
    lists[1].getview().add_last(7)
    local taken: @List[S64] <- lists[1].take()
    Console.show("taken: {taken.count()}, left: {lists.getview(1).is_empty()}")
    drop taken
    lists.destruct_all()
    drop b
    drop m
    return
