# split(separator:) gives the pieces between the separators (an empty one between two in a row, one character each for an
# empty separator), words() the runs between white space. Each piece is a view of the text, the list comes from a manager.

import Standard/Hosted

### Shows each piece between brackets.
### :param pieces: The pieces.
routine show_all(pieces: @BorrowedSlice[@[Byte]]) -> None
    Console.show("{pieces.count()} pieces")
    each i in 0 til pieces.count()
        piece: @[Byte] = pieces[i]
        Console.show("[{piece}]")
    return

### Splits a few texts and shows the pieces.
routine start() -> None
    parts: &[@[Byte]] <- "a,b,,c".split(separator: ",", manager: HEAP)

    show_all(parts)
    none_found: &[@[Byte]] <- "abc".split(separator: "--", manager: HEAP)
    show_all(none_found)
    long_sep: &[@[Byte]] <- "x--y--".split(separator: "--", manager: HEAP)
    show_all(long_sep)
    letters: &[@[Byte]] <- "añb".split(separator: "", manager: HEAP)
    show_all(letters)
    words: &[@[Byte]] <- "  hello \t world\n again ".words(manager: HEAP)
    show_all(words)
    empty: &[@[Byte]] <- "   ".words(manager: HEAP)
    show_all(empty)
    drop parts
    drop none_found
    drop long_sep
    drop letters
    drop words
    drop empty
    return
