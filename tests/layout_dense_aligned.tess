// A dense record has no padding, so a field's #aligned has nothing to do.

#layout(dense)
record Packet
    tag: U8
    #aligned(4)
    value: U32

/// Makes a `Packet` from its fields.
/// :param tag: Its `tag`.
/// :param value: Its `value`.
/// :returns: The new value.
routine Packet.construct(tag: U8, value: U32) -> Me
    return(Me(tag, value))

/// Releases nothing: a `Packet` holds no memory of its own.
routine Packet.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    s: USize = sizeof[Packet]()
    return()
