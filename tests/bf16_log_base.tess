routine start() -> Void
    shared wrong : @USize <- 0

    block entry()
        jump case(0)

    block case(i: USize)
        done : Bool = i.ge(3529)
        branch done
            ? report()
            : continue
        x    : BF16 = BF16.from_bits(LOG_X.getitem(i))
        b    : BF16 = BF16.from_bits(LOG_B.getitem(i))
        got  : U16  = x.log(b).bits()
        good : Bool = got.eq(LOG_WANT.getitem(i))
        branch good
            ? case(i.add(1))
            : bad(i)

    block bad(i: USize)
        wrong.load().add(1).store_into(wrong)
        jump case(i.add(1))

    block report()
        Out.write("3529 pairs, {wrong.load()} wrong\n")
        return()
