# C calls an exported routine, and C has no failure to receive: an @export routine isn't failable.

crashable NopeError

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine NopeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("nope")
    return

@export("tessera_parse_count")
failable routine parse_count(n: S64) -> S64
    if n < 0
        throw NopeError()
    return n

routine start() -> None
    return
