# SortedSet[S64] against a model. An LCG drives random add / remove / has in three phases: few keys, then enough
# keys for a B-tree at least four levels deep, then a phase that removes by random rank until most keys are gone, so borrows
# and merges run. Every 500 operations a checkpoint prints the length, a running checksum of every result, the
# elements at a few ranks, and a hash of the (ascending) iteration sequence. Then eq.
# The expected output comes from an independent Python model of the collection.

import Collections
import Hosted

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[ConsoleOutput]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: U64
    ### How many operations the phase runs.
    ops: U64
    ### How many distinct keys the operations draw from.
    keys: U64
    ### The weight of add among the operations.
    adds: U64
    ### Whether removes go by rank instead of by key.
    by_rank: Bool

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: U64
    ### The operations run so far in the phase.
    op: U64
    ### The checksum of every result so far.
    results: S64

routine @Rng.below(bound: U64) -> U64
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: U64 = bucket.to[U64]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: @[Byte], value: S64) -> None
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

# Folds every element in iteration order.
routine iteration_hash(set: @SortedSet[S64]) -> S64
    iter: &SortedSetEmitter[S64] <- set.emitter()

    loop with hash: S64 = 0
        item: Optional[S64] = try iter.emit()
        when item
            is S64 as key => continue with hash: mix(hash, value: key)
            is None => return hash

# Folds the elements at ranks 0, count / 3, count / 2, and count - 1 (0 for an empty set).
routine rank_hash(set: @SortedSet[S64]) -> S64
    count: U64 = set.count()

    if count == 0
        return 0
    else
        first: S64 = set.get_by_rank(0)
        third: S64 = set.get_by_rank(count // 3)
        half: S64 = set.get_by_rank(count // 2)
        last: S64 = set.get_by_rank(count - 1)
        hash: S64 = mix(
            hash: mix(hash: mix(hash: mix(hash: 0, value: first), value: third), value: half),
            value: last)
        return hash

routine checkpoint(out: @BufWriter[ConsoleOutput], set: @SortedSet[S64], at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: U64 = set.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "ranks", value: rank_hash(set))
    labeled(out, label: "iteration", value: iteration_hash(set))
    out.write("\n")
    return

# Runs ops random operations on keys below keys: an add when the kind (0..9) is below adds, a remove below 7, and
# a has otherwise. With by_rank, a remove takes the element at a random rank instead of a random key.
# Returns the updated results checksum.
@reshaping(set)
@generated
routine run_phase(harness: Harness, set: @SortedSet[S64], phase: Phase, results: S64) -> S64
    rng: @Rng = harness.rng
    ops: U64 = phase.ops
    keys: U64 = phase.keys
    adds: U64 = phase.adds
    by_rank: Bool = phase.by_rank

    block entry()
        jump next(0, results)

    block next(op: U64, checksum: S64)
        if op >= ops
            return checksum
        else
            jump pick(op, checksum)

    block pick(op: U64, checksum: S64)
        key: S64 = rng.below(keys).to[S64]()
        kind: U64 = rng.below(10)
        is_add: Bool = kind < adds
        when
            is_add => jump add(op, checksum, key)
            kind < 7 => jump remove(op, checksum, key)
            else => jump lookup(op, checksum, key)

    block add(op: U64, checksum: S64, key: S64)
        added: Bool = set.add(key)
        jump record(op, checksum, added.to[S64]())

    block remove(op: U64, checksum: S64, key: S64)
        empty: Bool = set.is_empty()
        nonempty: Bool = not empty
        if by_rank and nonempty
            jump remove_rank(op, checksum)
        else
            jump remove_key(op, checksum, key)

    block remove_rank(op: U64, checksum: S64)
        rank: U64 = rng.below(set.count())
        jump remove_key(op, checksum, set.get_by_rank(rank))

    block remove_key(op: U64, checksum: S64, key: S64)
        removed: Bool = set.remove(key)
        jump record(op, checksum, mix(hash: key, value: removed.to[S64]()))

    block lookup(op: U64, checksum: S64, key: S64)
        found: Bool = set.has(key)
        jump record(op, checksum, found.to[S64]())

    block record(op: U64, checksum: S64, result: S64)
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: U64 = op + 1
        if op_next % 500 == 0
            jump report(op_next, mixed)
        else
            jump next(op_next, mixed)

    block report(op: U64, checksum: S64)
        checkpoint(out: harness.out, set,
            at: Checkpoint(phase: phase.number, op: op, results: checksum))
        jump next(op, checksum)

# Adds from's elements to to by rank, starting from the middle, so to is built in a different order.
@reshaping(to)
routine copy_rotated(from: @SortedSet[S64], to: @SortedSet[S64]) -> None
    count: U64 = from.count()
    half: U64 = count // 2

    each i in 0 til count
        rank: U64 = (i + half) % count
        to.add(from.get_by_rank(rank))
    then
        return

routine report_eq(out: @BufWriter[ConsoleOutput], label: @[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    out: &BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    manager: @MemoryManager = HEAP
    rng: &Rng <- Rng(state: 1)
    set: &SortedSet[S64] <- .construct(manager)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, set,
        phase: Phase(number: 1, ops: 3000, keys: 64, adds: 5, by_rank: false), results: 0)
    r2: S64 = run_phase(harness, set,
        phase: Phase(number: 2, ops: 12000, keys: 20000, adds: 5, by_rank: false), results: r1)
    r3: S64 = run_phase(harness, set,
        phase: Phase(number: 3, ops: 9000, keys: 20000, adds: 1, by_rank: true), results: r2)

    copied: &SortedSet[S64] <- .construct(manager)
    report_eq(out, label: "empty copy equal", equal: set.eq(copied))
    copy_rotated(from: set, to: copied)
    report_eq(out, label: "rotated copy equal", equal: set.eq(copied))
    report_eq(out, label: "rotated copy same order",
        equal: iteration_hash(set) == iteration_hash(copied))
    copied.add(-1)
    report_eq(out, label: "extra element equal", equal: set.eq(copied))
    copied.remove(-1)
    report_eq(out, label: "extra element removed equal", equal: set.eq(copied))
    size: U64 = set.count()
    last: S64 = set.get_by_rank(size - 1)
    copied.remove(last)
    copied.add(last + 1)
    report_eq(out, label: "changed element equal", equal: set.eq(copied))
    drop copied
    drop set
    out.flush()
    return
