# getitem gives a copy of an element, which an entity element can't be: its place is getslot's.
import Hosted

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine @Counter.destruct() -> None
    return

### Copies an element out.
routine start() -> None
    manager: @MemoryManager = HEAP
    m: &[Counter] <- .construct(count: 1, manager: manager)

    m.getslot(0).poke(Counter.construct())
    c: &Counter <- m.getslice()[0]

    drop c
    drop m.getslot(0)
    drop m
    return
