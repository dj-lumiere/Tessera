# getitem gives a copy of an element, which an entity element can't be: its place is getslot's.
import Standard/Alloc
import Standard/Os

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine @Counter.destruct() -> None
    return

### Copies an element out.
routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local m: @Memory[Counter] <- .construct(count: 1, manager: alloc)

    m.getslot(0).poke(Counter.construct())
    local c: @Counter <- m.getview()[0]

    drop c
    drop m.getslot(0)
    drop m
    return
