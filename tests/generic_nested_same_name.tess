/// A type argument that mentions a parameter of the same name is substituted once: `wrap<T>` called with
/// `T = Box<S64>` gives a `Box<Box<S64>>`, not a `Box<Box<Box<S64>>>`, and a routine's `T` is its own even when
/// the routine it calls also names its parameter `T`.
import Standard::Format
import Standard::Os

/// A single value.
record Box<T>
require T: typename
    value : T

/// Puts a value in a box.
/// :param x: The value.
/// :returns: The box.
routine wrap<T>(x: T) -> Box<T>
require T: typename
    block entry()
        return(Box<T> { value: x })

/// Puts a value in a box, and that box in another.
/// :param x: The value.
/// :returns: The outer box.
routine wrap_twice<T>(x: T) -> Box<Box<T>>
require T: typename
    block entry()
        inner : Box<T>      = wrap<T>(x)
        outer : Box<Box<T>> = wrap<Box<T>>(inner)
        return(outer)

/// Unwraps the two levels again.
/// :returns: 0.
routine main() -> S32
    block entry()
        b  : Box<Box<S64>> = wrap_twice<S64>(7)
        bb : Box<S64>      = b.value
        Out.write("{bb.value}\n")
        return(0)
