# A BorrowedSlice field emptied with steal, then poked: allowed, the field held nothing.

import Hosted

### Holds memory.
entity Q
    m: BorrowedSlice[S64]

### An empty one.
### :returns: It.
common routine Q.construct() -> Me
    return Me(m: .hollow())

### Gives the field back.
routine @Q.destruct() -> None
    drop me.m
    return

routine start() -> None
    q: &Q <- .construct()

    q.m.replace(value: BorrowedSlice[S64].construct(values: [7], times: 4, manager: HEAP))
    steal q.m as old
    drop old
    q.m.poke(BorrowedSlice[S64].construct(values: [8], times: 4, manager: HEAP))
    Console.show("{q.m[0]}")
    drop q
    return
