/// The cases are (input, expected) pairs of F128 bits.
routine report_wrong(out: @FdWriter, name: Bytes, x: U128, got: U128, want: U128) -> Void
    block entry():
        write(out, "{name} ")
        x.represent_hex(out)
        write(out, " got ")
        got.represent_hex(out)
        write(out, " want ")
        want.represent_hex(out)
        write(out, "\n")
        return()

routine report_total(out: @FdWriter, name: Bytes, count: USize, wrong: U64) -> Void
    block entry():
        write(out, "{name}: {count} cases, {wrong} wrong\n")
        return()

routine check_log(out: @FdWriter) -> Void
    block entry():
        cases : @U128 = LOG_CASES.to<@U128>()
        jump next(cases, 0, 0)

    block next(cases: @U128, i: USize, wrong: U64):
        done : Bool = i.ge(LOG_COUNT)
        branch done
            ? finish(wrong)
            : test(cases, i, wrong)

    block test(cases: @U128, i: USize, wrong: U64):
        x    : U128 = cases.stride(i.mul(2)).load()
        want : U128 = cases.stride(i.mul(2).add(1)).load()
        r    : F128 = f128_of(x).ln()
        got  : U128 = r.bits()
        ok   : Bool = got.eq(want)
        branch ok
            ? next(cases, i.add(1), wrong)
            : bad(cases, i, wrong, x, got, want)

    block bad(cases: @U128, i: USize, wrong: U64, x: U128, got: U128, want: U128):
        report_wrong(out, "log", x, got, want)
        jump next(cases, i.add(1), wrong.add(1))

    block finish(wrong: U64):
        report_total(out, "log", LOG_COUNT, wrong)
        return()

routine check_expm1(out: @FdWriter) -> Void
    block entry():
        cases : @U128 = EXPM1_CASES.to<@U128>()
        jump next(cases, 0, 0)

    block next(cases: @U128, i: USize, wrong: U64):
        done : Bool = i.ge(EXPM1_COUNT)
        branch done
            ? finish(wrong)
            : test(cases, i, wrong)

    block test(cases: @U128, i: USize, wrong: U64):
        x    : U128 = cases.stride(i.mul(2)).load()
        want : U128 = cases.stride(i.mul(2).add(1)).load()
        r    : F128 = f128_of(x).exp_m1()
        got  : U128 = r.bits()
        ok   : Bool = got.eq(want)
        branch ok
            ? next(cases, i.add(1), wrong)
            : bad(cases, i, wrong, x, got, want)

    block bad(cases: @U128, i: USize, wrong: U64, x: U128, got: U128, want: U128):
        report_wrong(out, "expm1", x, got, want)
        jump next(cases, i.add(1), wrong.add(1))

    block finish(wrong: U64):
        report_total(out, "expm1", EXPM1_COUNT, wrong)
        return()

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()
        check_log(out)
        check_expm1(out)
        return(0)
