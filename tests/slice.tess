// A borrowed Slice<T> (a null allocator) lends values that live somewhere else: an array on the stack, a list, a
// slice from an allocator, the bytes of a text. Its at(i) is the checked address, and every access through it is @T's
// own (load, store, volatile, atomic). getitem and setitem are the value shortcuts, getitem_checked returns an Option,
// and getslice is a checked range view.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

/// Sums whatever the slice lends: the same routine reads an array, a list, and a slice from the heap.
routine total(values: Slice<U32>) -> U64
    shared sum : @U64 <- 0

    block entry()
        jump add(0)

    block add(i: USize)
        done : Bool = i.ge(values.count())
        branch done
            ? return(sum.load())
            : continue
        value : U32 = values.getitem(i)
        sum.load().add(value.to<U64>()).store_into(sum)
        jump add(i.add(1))

routine from_array() -> Void
    block entry()
        claim digits : @Array<U32, 5> <- { 1, 2, 3, 4, 5 }
        view : Slice<U32> = digits.to<Slice<U32>>()
        tail : Slice<U32> = digits.getslice(2, 3)
        Out.write("array: count {view.count()}, total {total(view)}, last three {total(tail)}\n")
        view.setitem(0, 10)
        Out.write("array after setitem: {digits.getitem(0)}, getitem_checked(4) {view.getitem_checked(4)}")
        Out.write(", getitem_checked(5) {view.getitem_checked(5)}\n")
        return()

routine from_list() -> Void
    block entry()
        claim primes : @List<U32> <- .construct()
        primes.push(2)
        primes.push(3)
        primes.push(5)
        primes.push(7)
        view   : Slice<U32> = primes.to<Slice<U32>>()
        middle : Slice<U32> = primes.getslice(1, 2)
        Out.write("list: {primes.load()}, count {primes.count()}, total {total(view)}, middle {total(middle)}\n")
        empty : Slice<U32> = primes.getslice(4, 0)
        Out.write("an empty view at the end: count {empty.count()}\n")
        primes.destruct()
        return()

routine from_owned() -> Void
    shared squares : @Slice<U32> <- .construct(4)

    block entry()
        jump fill(0)

    block fill(i: USize)
        done : Bool = i.ge(squares.count())
        branch done
            ? show()
            : continue
        v : U32 = i.to<U32>()
        squares.setitem(i, v.mul(v))
        jump fill(i.add(1))

    block show()
        view  : Slice<U32> = squares.getview()
        first : @U32       = view.to<@U32>()
        Out.write("owned: total {total(view)}, squares[3] {squares.getitem(3)}, through the address {first.stride(2).load()}\n")
        squares.destruct()
        return()

routine from_bytes() -> Void
    block entry()
        text  : Bytes       = "Tessera"
        whole : Slice<Byte> = text.to<Slice<Byte>>()
        part  : Slice<Byte> = text.getslice(1, 3)
        Out.write("bytes: count {whole.count()}, first {whole.getitem(0).diagnose()}, part count {part.count()}")
        Out.write(", part starts with {part.getitem(0).diagnose()}\n")
        return()

/// The whole @T vocabulary through at(): nothing is redefined on Slice.
routine through_at() -> Void
    block entry()
        claim counters : @Array<U32, 3> <- { 0, 0, 0 }
        view   : Slice<U32> = counters.to<Slice<U32>>()
        before : U32        = view.at(1).atomic_fetch_add(5)
        after  : U32        = view.at(1).atomic_load()
        view.at(2).volatile_store(9)
        register : U32 = view.at(2).volatile_load()
        view.at(0).store(4)
        Out.write("atomic: was {before}, now {after}. volatile: {register}. plain: {view.at(0).load()}\n")
        return()

routine start() -> Void
    block entry()
        from_array()
        from_list()
        from_owned()
        from_bytes()
        through_at()
        return()
