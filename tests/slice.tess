// A Span[T] is a view of values that live somewhere else: an array on the stack, a list, memory from a manager, the
// bytes of a text. Its getslot(i) is the checked address, and every access through it is @T's own (peek, poke,
// volatile, atomic). getitem and setitem are the value shortcuts, getitem_checked returns a Maybe, and getslice is a
// checked range view.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

/// Sums whatever the span shows: the same routine reads an array, a list, and memory from the heap.
routine total(values: Span[U32]) -> U64
    local sum: @U64 <- 0

    each i in 0 til values.count()
        value: U32 = values[i]
        (sum.peek() + value.to[U64]()).poke_into(sum)
    then
        return sum.peek()

routine from_array() -> None
    local digits: @Array[U32, 5] <- [1, 2, 3, 4, 5]
    view: Span[U32] = digits.getview()
    tail: Span[U32] = digits.getslice(start: 2, count: 3)
    Out.write("array: count {view.count()}, total {total(view)}, last three {total(tail)}\n")
    view[0] = 10
    Out.write("array after setitem: {digits.getitem(0)}, getitem_checked(4) {view.getitem_checked(4)}")
    Out.write(", getitem_checked(5) {view.getitem_checked(5)}\n")
    return

routine from_list() -> None
    local primes: @List[U32] <- .construct()
    primes.add_last(2)
    primes.add_last(3)
    primes.add_last(5)
    primes.add_last(7)
    view: Span[U32] = primes.getview()
    middle: Span[U32] = primes.getslice(start: 1, count: 2)
    Out.write("list: {primes.peek()}, count {primes.count()}, total {total(view)}, middle {total(middle)}\n")
    empty: Span[U32] = primes.getslice(start: 4, count: 0)
    Out.write("an empty view at the end: count {empty.count()}\n")
    drop primes
    return

routine from_owned() -> None
    local squares: @Memory[U32] <- .construct(4)

    each i in 0 til squares.count()
        v: U32 = i.to[U32]()
        squares[i] = v * v
    view: Span[U32] = squares.getview()
    first: @U32 = view.to[@U32]()
    Out.write("owned: total {total(view)}, squares[3] {squares.getitem(3)}, through the address {first.stride(2).peek()}\n")
    drop squares
    return

routine from_bytes() -> None
    text: Span[Byte] = "Tessera"
    whole: Span[Byte] = text.getview()
    part: Span[Byte] = text.getslice(start: 1, count: 3)
    Out.write("bytes: count {whole.count()}, first {whole.getitem(0).diagnose()}, part count {part.count()}")
    Out.write(", part starts with {part.getitem(0).diagnose()}\n")
    return

/// The whole @T vocabulary through getslot(): nothing is redefined on Span.
routine through_at() -> None
    local counters: @Array[U32, 3] <- [0, 0, 0]
    view: Span[U32] = counters.getview()
    before: U32 = view.getslot(1).atomic_fetch_add(5)
    after: U32 = view.getslot(1).peek_atomic()
    view.getslot(2).poke_volatile(9)
    register: U32 = view.getslot(2).peek_volatile()
    view.getslot(0).poke(4)
    Out.write("atomic: was {before}, now {after}. volatile: {register}. plain: {view.getslot(0).peek()}\n")
    return

routine start() -> None
    from_array()
    from_list()
    from_owned()
    from_bytes()
    through_at()
    return
