// F128 gamma and ln_gamma (stdlib/f128_gamma.tess), correctly rounded: each line is a value and its
// bits, then the exact tier's bits alone. Every one was checked against mpmath, rounded to
// binary128. Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer or -inf is
// NaN, ln_gamma is +inf at the poles. Generated by a local script; regenerate rather than edit.

import Standard::Format
import Standard::Os

routine show(name: Bytes, v: F128, exact: F128) -> Void
    block entry():
        Out.write("{name} {v} {v.bits()} {exact.bits()}\n")
        return()

routine main() -> S32
    block entry():
        show("gamma(nan)", f128_of(0x7FFF8000000000000000000000000000).gamma(),
            f128_gamma(f128_of(0x7FFF8000000000000000000000000000), true))
        show("ln_gamma(nan)", f128_of(0x7FFF8000000000000000000000000000).ln_gamma(),
            f128_ln_gamma(f128_of(0x7FFF8000000000000000000000000000), true))
