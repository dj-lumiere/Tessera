# A place with no value starts all zero, for a type whose zero bytes are a value: numbers, Bool, an optional pointer, a
# record of those. lateinit marks a place a routine fills before it reads it, and a global needs its value or lateinit.
import Hosted

record Pair
    left: S64
    right: Bool
    next: @S64?

lateinit global LATE: &@S64

### Fills a place the caller declared without a value.
### :param out: The place to fill.
routine fill(out: @S64) -> None
    out.poke(7)
    return

routine start() -> None
    count: &U64
    flag: Bool
    pair: &Pair
    lateinit made: &@S64
    cell: &S64
    made.store(cell)
    fill(made.load())
    Console.show("{count.load()} {flag} {pair.left.peek()} {pair.right.peek()} {pair.next.peek().is_absent()} {cell.load()}")
    return
