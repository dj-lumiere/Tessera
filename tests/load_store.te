# Loads and stores are methods: plain, through fields and elements, pointer fields, presets, Addr, volatile.

import Standard/Os

preset TABLE: @Array[U32, 3] <- [10, 20, 30]

record Point
    x: B64
    y: S64

record Node
    value: S64
    next: @Node

### Makes a `Node` from its fields.
### :param value: Its `value`.
### :param next: Its `next`.
### :returns: The new value.
common routine Node.construct(value: S64, next: @Me) -> Me
    return Me(value, next)

### Releases nothing: a `Node` holds no memory of its own.
routine @Node.destruct() -> None
    return

routine start() -> None
    local p: @S64 <- 1

    sum: S64 = p.peek() + 41
    sum.poke_into(p)
    b: S64 = p.peek()
    Console.show("{b}")

    local pt: @Point <- (x: 1.5, y: 2)
    pt.y.poke(7)
    y: S64 = pt.y.peek()
    Console.show("{y}")
    whole: Point = pt.peek()
    Console.show("{whole.y}")

    local alloc: @MemoryManager <- HEAP.peek()
    local buf: @Memory[U64] <- .construct(count: 4, manager: alloc)
    buf.getslot(2).poke(99)
    e: U64 = buf.getslot(2).peek()
    Console.show("{e}")
    drop buf

    local n2: @Node <- (value: 2, next: .hollow())
    local n1: @Node <- (value: 1, next: n2)
    second: @Node = n1.next.peek()
    v2: S64 = second.value.peek()
    Console.show("{v2}")

    t: U32 = TABLE.getitem(1)
    Console.show("{t.to[U64]()}")

    local slot: @Addr <- p
    back: Addr = slot.peek()
    via: S64 = back.to[@S64]().peek()
    Console.show("{via}")
    back.to[@S64]().poke_volatile(5)
    vol: S64 = back.to[@S64]().peek_volatile()
    Console.show("{vol}")
    return
