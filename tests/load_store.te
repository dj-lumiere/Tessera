# Loads and stores are methods: plain, through fields and elements, pointer fields, presets, Addr, volatile.

import Standard/Hosted

preset TABLE: &Array[U32, 3] <- [10, 20, 30]

record Point
    x: B64
    y: S64

record Node
    value: S64
    next: @Node

routine start() -> None
    p: &S64 <- 1

    sum: S64 = p.load() + 41
    sum.poke_into(p)
    b: S64 = p.load()
    Console.show("{b}")

    pt: &Point <- (x: 1.5, y: 2)
    pt.y.poke(7)
    y: S64 = pt.y.peek()
    Console.show("{y}")
    whole: Point = pt.load()
    Console.show("{whole.y}")

    manager: @MemoryManager = HEAP
    buf: &[U64] <- .construct(count: 4, manager: manager)
    buf.getslot(2).poke(99)
    e: U64 = buf.getslot(2).peek()
    Console.show("{e}")
    drop buf

    n2: &Node <- (value: 2, next: .hollow())
    n1: &Node <- (value: 1, next: n2)
    second: @Node = n1.next.peek()
    v2: S64 = second.value.peek()
    Console.show("{v2}")

    t: U32 = TABLE.getitem(1)
    Console.show("{t.to[U64]()}")

    slot: &Addr <- p
    back: Addr = slot.load()
    via: S64 = back.to[@S64]().peek()
    Console.show("{via}")
    back.to[@S64]().poke_volatile(5)
    vol: S64 = back.to[@S64]().peek_volatile()
    Console.show("{vol}")
    return
