# CStrView and CWStrView are pointers to terminated C text. A literal becomes one where one is expected. @[Byte].to[CStr] /
# to[CWStr] copy through a memory manager into an owner that lends the C text and is released with destruct(), and
# List[Byte].to[CStrView] ends the buffer with a NUL. C's own strlen / wcslen agree.

import Standard/Collections
import Standard/Os

@external("c")
@symbol("strlen")
routine c_strlen(s: CStrView) -> CSize

@external("c")
@symbol("wcslen")
routine c_wcslen(s: CWStrView) -> CSize

routine start() -> None
    manager: @MemoryManager = HEAP

    # literals
    hello: CStrView = "hello"
    Console.show("{hello.count()} {c_strlen(hello)} {hello.getview()}")
    wide: CWStrView = "héllo"
    Console.show("{wide.count()} {c_wcslen(wide)}")

    # a @[Byte] view copied into a C string
    text: @[Byte] = "Tessera language"
    word: @[Byte] = text.slice(start: 0, end: 7)
    managed_c: &CStr <- word.to[CStr](manager)
    word_c: CStrView = managed_c.to[CStrView]()
    Console.show("{word_c.getview()} {c_strlen(word_c)}")
    drop managed_c

    # a non-BMP character: 2 UTF-16 units on Windows, 1 UTF-32 unit elsewhere
    emoji: @[Byte] = "a😀b"
    managed_w: &CWStr <- emoji.to[CWStr](manager)
    emoji_w: CWStrView = managed_w.to[CWStrView]()
    units: U64 = c_wcslen(emoji_w).to[U64]()
    expected: Bool = 3 <= units <= 4
    Console.show("{expected} {emoji_w.count().eq(units)}")
    drop managed_w

    # a List[Byte] built with write, handed to C
    buf: &List[Byte] <- .construct(manager)
    n: S64 = 42
    buf.write("answer = {n}")
    answer: CStrView = buf.to[CStrView]()
    Console.show("{answer.getview()} {c_strlen(answer).to[U64]()} {buf.count()}")
    drop buf
    return
