# CStr and CWStr are pointers to terminated C text. A literal becomes one where one is expected. @[Byte].to[OwnedCStr] /
# to[OwnedCWStr] copy through an allocator into an owner that lends the C text and is released with destruct(), and
# List[Byte].to[CStr] ends the buffer with a NUL. C's own strlen / wcslen agree.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

@external("c")
@symbol("strlen")
routine c_strlen(s: CStr) -> CSize

@external("c")
@symbol("wcslen")
routine c_wcslen(s: CWStr) -> CSize

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()

    # literals
    hello: CStr = "hello"
    Console.show("{hello.count()} {c_strlen(hello)} {hello.getview()}")
    wide: CWStr = "héllo"
    Console.show("{wide.count()} {c_wcslen(wide)}")

    # a @[Byte] view copied into a C string
    text: @[Byte] = "Tessera language"
    word: @[Byte] = text.slice(start: 0, end: 7)
    local owned_c: @OwnedCStr <- word.to[OwnedCStr](alloc)
    word_c: CStr = owned_c.to[CStr]()
    Console.show("{word_c.getview()} {c_strlen(word_c)}")
    drop owned_c

    # a non-BMP character: 2 UTF-16 units on Windows, 1 UTF-32 unit elsewhere
    emoji: @[Byte] = "a😀b"
    local owned_w: @OwnedCWStr <- emoji.to[OwnedCWStr](alloc)
    emoji_w: CWStr = owned_w.to[CWStr]()
    units: U64 = c_wcslen(emoji_w).to[U64]()
    expected: Bool = units.between(lo: 3, hi: 4)
    Console.show("{expected} {emoji_w.count().eq(units)}")
    drop owned_w

    # a List[Byte] built with write, handed to C
    local buf: @List[Byte] <- .construct(alloc)
    n: S64 = 42
    buf.write("answer = {n}")
    answer: CStr = buf.to[CStr]()
    Console.show("{answer.getview()} {c_strlen(answer).to[U64]()} {buf.count()}")
    drop buf
    return
