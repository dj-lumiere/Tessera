# A routine on a receiver with its value type argument named (Box[2].get) beats the one for any value (Box[L].get),
# and a generic body calls the one its instance's value picks.
import Hosted

### A box.
### :typeparam L: The value.
record Box[L]
needs U64 L
    v: U64

### The generic one.
### :returns: 1.
routine Box[L].get() -> U64
needs U64 L
    return 1

### The one for two.
### :returns: 2.
routine Box[2].get() -> U64
    return 2

### Calls get on any box.
### :typeparam L: The value.
### :param b: The box.
### :returns: What get gives.
routine through[L](b: Box[L]) -> U64
needs U64 L
    return b.get()

### Runs.
routine start() -> None
    two: Box[2] = .hollow()
    three: Box[3] = .hollow()
    Console.show("{two.get()} {three.get()} {through(two)} {through(three)}")
    return
