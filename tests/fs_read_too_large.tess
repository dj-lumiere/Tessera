# File.read_all_result on a 32-bit target turns down a file of 4 GiB or more with OutOfMemory, without
# allocating: it can't fit in the address space. It used to crash with IntegerOverflowError converting the size.
# The file is sparse (set_size_result), so making it writes nothing, and it is deleted after.

import Standard/Alloc
import Standard/Format
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local tmp: Directory = Directory.temp_result(alloc).unwrap()
    local big: File = tmp.file(name: "tessera_fs_read_too_large.bin", alloc)
    local h: @FileHandle <- .empty()

    opened: Result[FileHandle, FsError] = big.open_write_result()
    h.poke(opened.unwrap())
    four_gib: U64 = U64.shl(1, 32)
    sized: Result[None, FsError] = h.set_size_result(four_gib)
    h.close()
    Out.write("made a 4 GiB file: {sized.is_success()}\n")
    r: Result[Span[Byte], FsError] = big.read_all_result(alloc)
    when r
        is Span[Byte] as text =>
            local held: @Span[Byte] <- text
            Out.write("read it all: {held.count()} bytes\n")
            drop held
        is FsError as e =>
            out_of_memory: Bool = e == FsError.OUT_OF_MEMORY
            Out.write("turned down as out of memory: {out_of_memory}\n")
    discard_gone: Result[None, FsError] = big.delete_result()
    return
