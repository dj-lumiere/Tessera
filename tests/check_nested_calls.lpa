# A failing call in an argument of a failing call, under one `check`: the failure of the argument and the failure of
# the callee each arrive by their own error type.

import Hosted

crashable EndOfLinesError
    value: S64

crashable BadWordError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine EndOfLinesError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("no line {me.value}")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadWordError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad word {me.value}")
    return

### The line at an index: 0 and 1 have one, any other does not.
### :param index: Which line.
### :returns: The line's number.
routine next_line(index: S64) -> S64
    if index > 1
        throw EndOfLinesError(value: index)
    return index

### The word a line holds: line 1 holds none.
### :param line: The line's number.
### :returns: The word's length.
routine to_word(line: S64) -> S64
    if line == 1
        throw BadWordError(value: line)
    return line + 10

### Reads the line at an index and the word in it, and shows what came of both.
### :param index: Which line.
routine run(index: S64) -> None
    when check to_word(line: next_line(index: index))
        is S64 as word => Console.show("word {word}")
        is BadWordError as e => Console.show("bad word: {e.value}")
        is EndOfLinesError as e => Console.show("end: {e.value}")
    return

routine start() -> None
    run(index: 0)
    run(index: 1)
    run(index: 2)
    return
