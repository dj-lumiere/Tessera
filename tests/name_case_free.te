# The parser never reads a name's case. What [...] after a name is (a type's arguments or an index) and what an
# unspaced / is (a module path or a division) follow what the name is: a type, a value, or a module this file knows.

import Hosted

preset POINTS: &Array[Point, 3] <- [Point(x: 1, y: 2), Point(x: 3, y: 4), Point(x: 5, y: 6)]

record Point
    x: S64
    y: S64

### Writes what each spelling meant.
routine start() -> None
    # an all-capitals preset indexed, then a field and a call on the item
    a: S64 = POINTS[1].x
    b: S64 = POINTS[2].y.add(1)
    # a type's arguments before a call on the type
    n: U64 = Array[Point, 3].count()
    # a capitalized value divides, unspaced: it is no module
    Total: B64 = 84.0
    half: B64 = Total/2.0
    # a module path, which Hosted starts
    Hosted/Console.show("{a} {b} {n} {half}")
    return
