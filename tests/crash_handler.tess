// A program replaces the default crash handler by exporting its own under the handler's name. This one reports the
// name and message on stdout and exits with status 3 instead of 101.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    Out.write("crashed: {name}: {message}\n")
    exit(3)

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    claim list: @List[S64] <- .construct(alloc)
    Out.write("before\n")
    missing: S64 = list.remove_last()
    Out.write("not reached\n")
    return()
