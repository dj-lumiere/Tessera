# A BorrowedSlice reads and writes nothing itself: m.load(i) is a build error that names the forms that turn an element into
# something that reads, m[i] and m.getslot(i).peek().

import Standard/Os

routine start() -> None
    m: &[S64] <- [0] * 4 from HEAP

    v: S64 = m.load(1)
    drop m
    return
