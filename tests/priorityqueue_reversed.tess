// A PriorityQueue is a min-heap on its priorities: the smallest priority by compare comes out first. Reversed[S64]
// priorities flip compare, so the same pushes come out largest first. The elements only ride along.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

// Pushes the same five tasks into both queues.
routine fill(smallest: @PriorityQueue[S64, Span[Byte]],
    largest: @PriorityQueue[Reversed[S64], Span[Byte]]) -> Void
    smallest.add(priority: 3, element: "write")
    smallest.add(priority: 1, element: "plan")
    smallest.add(priority: 5, element: "ship")
    smallest.add(priority: 2, element: "build")
    smallest.add(priority: 4, element: "test")
    largest.add(priority: Reversed[S64].construct(3), element: "write")
    largest.add(priority: Reversed[S64].construct(1), element: "plan")
    largest.add(priority: Reversed[S64].construct(5), element: "ship")
    largest.add(priority: Reversed[S64].construct(2), element: "build")
    largest.add(priority: Reversed[S64].construct(4), element: "test")
    return()

// Pops the smallest-first queue to the end, writing each priority and element.
routine drain_smallest(queue: @PriorityQueue[S64, Span[Byte]]) -> Void
    Out.write("smallest first:")
    jump next()

    block next()
        top: Maybe[PriorityEntry[S64, Span[Byte]]] = queue.remove_entry_checked()
        when top
            is PriorityEntry[S64, Span[Byte]] as item => continue
            is Unit => end_line()
        Out.write(" {item.priority} {item.element}")
        jump next()

    block end_line()
        Out.write("\n")
        return()

// Pops the largest-first queue to the end, writing each priority and element.
routine drain_largest(queue: @PriorityQueue[Reversed[S64], Span[Byte]]) -> Void
    Out.write("largest first:")
    jump next()

    block next()
        top: Maybe[PriorityEntry[Reversed[S64], Span[Byte]]] = queue.remove_entry_checked()
        when top
            is PriorityEntry[Reversed[S64], Span[Byte]] as item => continue
            is Unit => end_line()
        Out.write(" {item.priority} {item.element}")
        jump next()

    block end_line()
        Out.write("\n")
        return()

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    claim smallest: @PriorityQueue[S64, Span[Byte]] <- .construct(alloc)
    claim largest: @PriorityQueue[Reversed[S64], Span[Byte]] <- .construct(alloc)
    fill(smallest, largest)

    Out.write("peek: {smallest.first()} at {smallest.first_entry().priority}, ")
    Out.write("{largest.first()} at {largest.first_entry().priority}\n")
    Out.write("pop: {smallest.remove()}, {largest.remove()}\n")
    Out.write("count: {smallest.count()}, {largest.count()}\n")
    drain_smallest(smallest)
    drain_largest(largest)
    Out.write("empty: {smallest.remove_checked().diagnose()}, {largest.first_checked().diagnose()}\n")

    one: Reversed[S64] = Reversed[S64].construct(1)
    two: Reversed[S64] = Reversed[S64].construct(2)
    Out.write("Reversed: 1 vs 2 {one.compare(two)}, eq {one.eq(one)}, {one.diagnose()}\n")

    smallest.destruct()
    largest.destruct()
    return()
