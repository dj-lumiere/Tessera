// A PriorityQueue is a min-heap on its priorities: the smallest priority by compare comes out first. Reversed<S64>
// priorities flip compare, so the same pushes come out largest first. The elements only ride along.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

// Pushes the same five tasks into both queues.
routine fill(smallest: @PriorityQueue<S64, Bytes>,
    largest: @PriorityQueue<Reversed<S64>, Bytes>) -> Void
    block entry()
        smallest.push(3, "write")
        smallest.push(1, "plan")
        smallest.push(5, "ship")
        smallest.push(2, "build")
        smallest.push(4, "test")
        largest.push(Reversed<S64>.construct(3), "write")
        largest.push(Reversed<S64>.construct(1), "plan")
        largest.push(Reversed<S64>.construct(5), "ship")
        largest.push(Reversed<S64>.construct(2), "build")
        largest.push(Reversed<S64>.construct(4), "test")
        return()

// Pops the smallest-first queue to the end, writing each priority and element.
routine drain_smallest(queue: @PriorityQueue<S64, Bytes>) -> Void
    block entry()
        Out.write("smallest first:")
        jump next()

    block next()
        top : Option<PriorityEntry<S64, Bytes>> = queue.pop_entry_checked()
        when top
            .Present(item) -> continue
            .Absent        -> end_line()
        Out.write(" {item.priority} {item.element}")
        jump next()

    block end_line()
        Out.write("\n")
        return()

// Pops the largest-first queue to the end, writing each priority and element.
routine drain_largest(queue: @PriorityQueue<Reversed<S64>, Bytes>) -> Void
    block entry()
        Out.write("largest first:")
        jump next()

    block next()
        top : Option<PriorityEntry<Reversed<S64>, Bytes>> = queue.pop_entry_checked()
        when top
            .Present(item) -> continue
            .Absent        -> end_line()
        Out.write(" {item.priority} {item.element}")
        jump next()

    block end_line()
        Out.write("\n")
        return()

routine start() -> Void
    block entry()
        claim alloc    : @Allocator                           <- make_heap_allocator()
        claim smallest : @PriorityQueue<S64, Bytes>           <- .construct(alloc)
        claim largest  : @PriorityQueue<Reversed<S64>, Bytes> <- .construct(alloc)
        fill(smallest, largest)

        Out.write("peek: {smallest.peek()} at {smallest.peek_entry().priority}, ")
        Out.write("{largest.peek()} at {largest.peek_entry().priority}\n")
        Out.write("pop: {smallest.pop()}, {largest.pop()}\n")
        Out.write("count: {smallest.count()}, {largest.count()}\n")
        drain_smallest(smallest)
        drain_largest(largest)
        Out.write("empty: {smallest.pop_checked().diagnose()}, {largest.peek_checked().diagnose()}\n")

        one : Reversed<S64> = Reversed<S64>.construct(1)
        two : Reversed<S64> = Reversed<S64>.construct(2)
        Out.write("Reversed: 1 vs 2 {one.compare(two)}, eq {one.eq(one)}, {one.diagnose()}\n")

        smallest.destruct()
        largest.destruct()
        return()
