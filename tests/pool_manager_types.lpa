# One PoolManager keeps entities of two types (and a record), each type in chunks of its own. A link that may be missing
# is a Stamped[T]? and is taken with try. Entities left in the pool end when the pool is dropped, each once, through their own type.

import Hosted

### A node of a list, with a link that may be missing.
entity Item
    value: S64
    next: Stamped[Item]?

### Makes an item.
### :param value: Its value.
### :param next: The item after it, if any.
### :returns: The item.
common routine Item.construct(value: S64, next: Stamped[Item]?) -> Me
    return Me(value, next)

### Ends an item.
routine @Item.destruct() -> None
    Console.show("item {me.value.peek()} ends")
    return

### A second type in the same pool.
entity Label
    text: S64

### Makes a label.
### :param text: Its number.
### :returns: The label.
common routine Label.construct(text: S64) -> Me
    return Me(text)

### Ends a label.
routine @Label.destruct() -> None
    Console.show("label {me.text.peek()} ends")
    return

### A record kept by the pool.
record Point
    x: S64
    y: S64

### The value after following a link, or -1 for no link or an ended item.
### :param link: The link.
### :returns: The value.
routine follow(link: Stamped[Item]?) -> S64
    when try link.fetch()
        is @Item as item => return item.value.peek()
        is None => return -1

### Shows two types, a record and the links.
routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    last: Stamped[Item] = PoolManager.add(Item.construct(value: 3, next: None()))
    first: Stamped[Item] = PoolManager.add(Item.construct(value: 1, next: last))
    label: Stamped[Label] = PoolManager.add(Label.construct(text: 7))
    spot: Stamped[Point] = PoolManager.add(Point(x: 4, y: 5))
    missing: Stamped[Item]? = None()
    Console.show("follow: {follow(first.fetch().next.peek())}, none: {follow(missing)}")
    Console.show("label: {label.fetch().text.peek()}, point: {spot.fetch().x.peek()},{spot.fetch().y.peek()}")
    PoolManager.remove(last)
    Console.show("after remove: {follow(first.fetch().next.peek())}")
    drop pool
    return
