# A program's own crash names its kind and says what happened. The handler gets the name, the message, and the place
# of the throw. This one prints all three and exits with status 3.

import Standard/Hosted

### The program's configuration is missing.
crashable ConfigurationError
    nothing

### Writes `The configuration file is missing.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine ConfigurationError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("The configuration file is missing.")
    return

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("crash_named.te")
    Console.show("{name}: {message.text()}\nat {place.line.peek()}:{place.column.peek()}, this file {here}")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    Console.show("before")
    throw ConfigurationError()
