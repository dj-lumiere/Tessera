# A generic routine takes memory into a local and never gives it back.

import Standard/Os

### Counts the values of memory it takes.
### :param v: The value to fill with.
### :returns: The count.
routine count_of[T](v: T) -> U64
    local m: @Memory[T] <- [v] * 4 from HEAP

    return m.count()

routine start() -> None
    Console.show("{count_of[S64](v: 1)}")
    return
