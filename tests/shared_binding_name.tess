// A block can't bind a name the head shares: a name is bound once.
routine twice(n: S64) -> S64
    shared doubled : S64 = n.mul(2)

    block entry()
        jump done()

    block done()
        doubled : S64 = doubled.add(1)
        return(doubled)

routine main() -> S32
    block entry()
        r : S64 = twice(3)
        return(r.to<S32>())
