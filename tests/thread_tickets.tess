// Thread tickets: put_work with no argument up to four (a tuple), a result retrieved after wait_finished, the same
// ticket taking a second piece of work, a Thread[Void], wait_finished_for that runs out before slow work finishes,
// cancel that the work sees through cancel_requested() and retrieve_result reports, a #threadlocal global back at its
// starting value for the next ticket on a reused thread, and a fiber that waits for a thread ticket while the other
// fibers of its manager go on.

import Standard/Fiber
import Standard/Format
import Standard/Os

@threadlocal
global SEEN: @U64 <- 7

record Log
    steps: U64

routine forty_two() -> S64
    return 42

routine twice(n: S64) -> S64
    return n * 2

routine sum3(a: S64, b: S64, c: S64) -> S64
    return a + b + c

routine sum4(a: S64, b: S64, c: S64, d: S64) -> S64
    return a + b + c + d

routine pair(a: S64, b: Bool) -> S64
    if b
        return a
    else
        return -a

/// Leaves a mark in this thread's SEEN, and returns what was there.
routine mark(value: U64) -> U64
    before: U64 = SEEN.peek()
    SEEN.poke(value)
    return before

/// Sleeps until cancelled, a millisecond at a time, and says how many naps it took.
routine nap_until_cancelled(limit: U64) -> U64
    until cancel_requested() | (n >= limit) with n: U64 = 0
        sleep_for(1000000)
        continue with n: n + 1
    then
        return n

routine slow(ns: U64) -> U64
    sleep_for(ns)
    return ns

/// A fiber that waits for a thread ticket: only it waits.
routine waits_for_thread(log: @Log) -> S64
    t: Thread[U64] = get_thread[U64]()
    t.put_work(entry: slow.to[Callable](), args: 5000000)
    t.wait_finished()
    t.give_back()
    return log.steps.peek().to[S64]()

/// A fiber that keeps stepping while the other waits.
routine steps(log: @Log) -> S64
    while i != 5 with i: U64 = 0
        log.steps.poke(i + 1)
        FIBERS.sleep(200000)
        continue with i: i + 1
    then
        return 5

/// Cancels work that naps until it is, and reports what retrieve_result says.
/// :param out: Where the line goes.
routine cancelled(out: @Out) -> Void
    local k: Thread[U64] = get_thread[U64]()

    k.put_work(entry: nap_until_cancelled.to[Callable](), args: 100000)
    if not k.wait_finished_for(3000000)
        k.cancel()
        k.wait_finished()
        when k.retrieve_result()
            is U64 => pass
            is CancelRequested =>
                out.write("cancelled\n")
                k.give_back()
                return
    out.write("not cancelled\n")
    k.give_back()
    return

routine start() -> Void
    out: @Out = Out.writer()
    t: Thread[S64] = get_thread[S64]()
    t.put_work(entry: forty_two.to[Callable]())
    t.wait_finished()
    a: S64 = t.retrieve()
    t.put_work(entry: twice.to[Callable](), args: a)
    t.wait_finished()
    b: S64 = t.retrieve()
    t.put_work(entry: pair.to[Callable](), args: (b, false))
    t.wait_finished()
    c: S64 = t.retrieve()
    t.put_work(entry: sum3.to[Callable](), args: (1, 2, 3))
    t.wait_finished()
    d: S64 = t.retrieve()
    t.put_work(entry: sum4.to[Callable](), args: (1, 2, 3, 4))
    t.wait_finished()
    e: S64 = t.retrieve()
    out.write("results: {a} {b} {c} {d} {e}, finished: {t.check_finished()}\n")
    t.give_back()

    m: Thread[U64] = get_thread[U64]()
    m.put_work(entry: mark.to[Callable](), args: 99)
    m.wait_finished()
    first: U64 = m.retrieve()
    m.put_work(entry: mark.to[Callable](), args: 5)
    m.wait_finished()
    second: U64 = m.retrieve()
    out.write("thread-local at the start of each work: {first} {second}\n")
    m.give_back()

    s: Thread[U64] = get_thread[U64]()
    s.put_work(entry: slow.to[Callable](), args: 200000000)
    in_time: Bool = s.wait_finished_for(1000000)
    out.write("slow work finished in 1 ms: {in_time}, running: {s.check_finished().bitnot()}\n")
    s.wait_finished()
    s.give_back()

    cancelled(out)

    local log: @Log <- Log(steps: 0)
    w: Fiber[S64] = FIBERS.get_fiber[S64]()
    w.put_work(entry: waits_for_thread.to[Callable](), args: log)
    x: Fiber[S64] = FIBERS.get_fiber[S64]()
    x.put_work(entry: steps.to[Callable](), args: log)
    FIBERS.run()
    out.write("steps the other fiber took while one waited for a thread: {w.retrieve()} of {x.retrieve()}\n")
    w.give_back()
    x.give_back()
    FIBERS.destruct()
    return
