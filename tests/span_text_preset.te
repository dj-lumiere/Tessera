# A @[Byte] preset of a string literal, and a Span preset of text Spans that names it.

import Standard/Os

preset GREETING: &[Byte] <- "hello"
preset WORDS: &[@[Byte]] <- [GREETING, "world"]

routine start() -> None
    out: @ConsoleOutput = Console.output()
    w: @[Byte] = WORDS.getitem(1)
    out.write("{GREETING} {GREETING.count()} {WORDS.getitem(0)} {w}\n")
    return
