# A text preset is an Items[Byte, _] value, viewed as text with v: @[Byte] = NAME. A global run of text views
# may name it.

import Hosted

global WORDS: &[@[Byte]] <- [GREETING, "world"]

preset GREETING: Items[Byte, _] = "hello"

routine start() -> None
    out: @ConsoleOutput = Console.output()
    greeting: @[Byte] = GREETING
    w: @[Byte] = WORDS.getitem(1)
    out.write("{greeting} {greeting.count()} {WORDS.getitem(0)} {w}\n")
    return
