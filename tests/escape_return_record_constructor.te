# A record holding a frame slot's address returned through its constructor.

import Hosted

lateinit global KEPT: &@S64

### Holds an address.
record R
    held: @S64

### Returns a record that holds a frame address.
### :returns: The record.
routine make() -> R
    l: &S64 <- 1234567

    return R(held: l)

### Keeps what make returns.
routine fill() -> None
    r: R = make()
    KEPT.poke(r.held)
    return

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    for i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    for j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    fill()
    s: S64 = scribble(seed: 6666666)
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
