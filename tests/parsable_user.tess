// A type of a program's own becomes Parsable by defining the conversion from text, Bytes.to_result<Celsius>, and
// conforming: text.to<Celsius>() and In.read<Celsius>() then work for it as for the built-in numbers. The stdlib's
// own to<...> conversions on Bytes (to<Span<Byte>>) still pick their concrete routine.

import Standard::Format
import Standard::Os

record Celsius
conform Parsable<Celsius>
    degrees : S32

/// A temperature written as a number followed by "C": "21C".
routine Bytes.to_result<Celsius>(self: Self) -> Result<Celsius, ParseError>
    block entry()
        branch self.ends_with("C")
            ? number()
            : return(.Failure(ParseError.Invalid))

    block number()
        digits : Self                    = self.slice(0, self.count().sub(1))
        n      : Result<S32, ParseError> = digits.to_result<S32>()
        when n
            .Success(d)     -> return(.Success(Celsius { degrees: d }))
            .Failure(error) -> return(.Failure(error))

routine main() -> S32
    block entry()
        text : Bytes   = "21C"
        t    : Celsius = text.to<Celsius>()
        Out.write("{t.degrees}\n")
        wrong : Bytes                       = "21F"
        r     : Result<Celsius, ParseError> = wrong.to_result<Celsius>()
        Out.write("{r.unwrap_failure().diagnose()}\n")
        span : Span<Byte> = text.to<Span<Byte>>()
        Out.write("{span.count()}\n")
        return(0)
