# Two spans are the same (===) when they view the same memory: the same first address and the same count.

import Hosted

### Shows which views are the same.
routine start() -> None
    values: &Array[S64, 4] <- [1, 2, 3, 4]

    whole: @[S64] = values.getview()
    again: @[S64] = values.getview()
    head: @[S64] = whole.getslice(start: 0, count: 2)
    tail: @[S64] = whole.getslice(start: 2, count: 2)
    Console.show("{whole === again} {whole === head} {head !== tail} {whole.data === head.data}")
    return
