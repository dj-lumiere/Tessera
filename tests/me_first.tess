// me is the receiver, so it can only be the first parameter.

record Point
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.scaled(by: S64, me: Me) -> Me
    return(Me(x: me.x.mul(by)))

routine start() -> Void
    p: Point = Point.scaled(2, Point(x: 1))
    return()
