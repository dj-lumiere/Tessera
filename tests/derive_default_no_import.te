# A choice's and a variant's derived represent needs no import of Standard/Format: print writes them as they are.

import Standard/Os

choice Direction: U8
    NORTH
    SOUTH

@derive(Representable, Diagnosable)
record Stay

variant Move
    Direction
    Stay

routine start() -> None
    d: Direction = Direction.SOUTH
    m: Move = Direction.NORTH
    rest: Move = Stay()
    Out.write("{d} {m} {rest}\n")
    return
