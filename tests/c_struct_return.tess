// Records cross the C ABI by value: libc's div returns an 8-byte div_t (in a register on x86-64, AArch64, and 32-bit
// Windows; through sret on 32-bit Linux), lldiv a 16-byte lldiv_t (two registers on x86-64 System V and AArch64;
// sret on Win64 and 32-bit x86).

import Standard::Format
import Standard::Os

record DivT
    quot : CInt
    rem  : CInt

record LldivT
    quot : S64
    rem  : S64

#[external("c"), symbol("div")]
routine c_div(%numer: CInt, %denom: CInt) -> DivT

#[external("c"), symbol("lldiv")]
routine c_lldiv(%numer: S64, %denom: S64) -> LldivT

routine main() -> S32
    block entry():
        %d : DivT   = c_div(-7, 2)
        %l : LldivT = c_lldiv(1000000000000007, 1000)
        print("div {%d.quot} {%d.rem}\n")
        print("lldiv {%l.quot} {%l.rem}\n")
        return(0)
