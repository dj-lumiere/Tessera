# An Optional stays in the frame its entity lives in: this is a build error that says what to write.
import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### A counter for a positive count, or nothing.
### :param n: The count.
### :returns: The counter, or None.
routine counter_for(n: S64) -> Counter?
    if n > 0
        made: &Counter <- .construct(n)
        return made
    return None()

### Holds one.
entity Holder
    kept: Counter?

### Makes one.
### :returns: The new value.
common routine Holder.construct() -> Me
    return Me(kept: None())

routine start() -> None
    h: &Holder <- .construct()
    drop h
    return
