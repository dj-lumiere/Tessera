# A List of a record with no member variables grows, walks, and shrinks (Rust #42789 in Tessera): a block of values
# of no size is still a block.

import Collections
import Hosted

### Nothing.
record Empty
    nothing

### Fills a list of empty records.
routine start() -> None
    xs: &List[Empty] <- .construct(HEAP)
    for i: U64 in 0 til 5
        xs.add_last(Empty())
    seen: &U64 <- 0
    for j: U64 in 0 til xs.count()
        e: Empty = xs[j]
        (seen.load() + 1).store_into(seen)
    gone: Empty = xs.remove_last()
    xs.reserve(100)
    Console.show("count {xs.count()}, walked {seen.load()}")
    drop xs
    return
