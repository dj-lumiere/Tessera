; HashMap<I64, I64> against a model. An LCG drives random put / remove / contains / get in three phases (few keys,
; many keys to force rehashing, then a small key range on the large map). Every 500 operations a checkpoint prints the length, a running
; checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
; The expected output is generated by scripts/gen_collection_tests.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every (key, value) pair in iteration order.
routine iteration_hash(#map: Ptr<HashMap<I64, I64>>) -> I64
    block entry():
        %iter_val: HashMapIter<I64, I64> = HashMapIter<I64, I64>.new(#map)
        #iter: Ptr<HashMapIter<I64, I64>> = alloca<HashMapIter<I64, I64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<HashMapIter<I64, I64>>, %hash: I64):
        %item: Option<KVPair<I64, I64>> = #iter.next()
        %more: Bool = %item.tag
        %pair: KVPair<I64, I64> = %item.value
        branch %more ? fold(#iter, %hash, %pair) : return(%hash)

    block fold(#iter: Ptr<HashMapIter<I64, I64>>, %hash: I64, %pair: KVPair<I64, I64>):
        %key:   I64 = %pair.key
        %value: I64 = %pair.value
        jump next(#iter, mix(mix(%hash, %key), %value))

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #map: Ptr<HashMap<I64, I64>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #map.length())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#map))
        write_line(#out)
        return()

; Runs %ops random operations on keys below %keys. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #map: Ptr<HashMap<I64, I64>>, #rng: Ptr<Rng>,
        %phase: I64, %ops: I64, %keys: I64, %results: I64) -> I64
    block entry():
        jump next(0, %results)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %key:       I64  = #rng.below(%keys)
        %kind:      I64  = #rng.below(10)
        %is_put:    Bool = %kind.slt(5)
        %is_remove: Bool = %kind.slt(7)
        select:
            %is_put -> put(%op, %results, %key)
            %is_remove -> remove(%op, %results, %key)
            _ -> lookup(%op, %results, %key)

    block put(%op: I64, %results: I64, %key: I64):
        %value: I64 = #rng.below(1000000)
        #map.put(%key, %value)
        jump record(%op, %results, %value)

    block remove(%op: I64, %results: I64, %key: I64):
        %removed: Bool = #map.remove(%key)
        jump record(%op, %results, %removed.to_i64())

    block lookup(%op: I64, %results: I64, %key: I64):
        %found: Bool = #map.contains(%key)
        branch %found ? get(%op, %results, %key) : record(%op, %results, -1)

    block get(%op: I64, %results: I64, %key: I64):
        %value: I64 = #map.get(%key)
        jump record(%op, %results, %value)

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #map, %phase, %op, %results)
        jump next(%op, %results)

; Copies #from into #to in iteration order, but starting from its second half, so the two maps hold the same pairs in
; a different insertion order.
routine copy_rotated(#from: Ptr<HashMap<I64, I64>>, #to: Ptr<HashMap<I64, I64>>) -> Void
    block entry():
        %half: I64 = #from.length().sdiv(2)
        jump pass(0, %half, true)

    block pass(%pass: I64, %half: I64, %second: Bool):
        %done: Bool = %pass.eq(2)
        %iter_val: HashMapIter<I64, I64> = HashMapIter<I64, I64>.new(#from)
        #iter: Ptr<HashMapIter<I64, I64>> = alloca<HashMapIter<I64, I64>>([%iter_val])
        branch %done ? return() : next(%pass, %half, %second, #iter, 0)

    block next(%pass: I64, %half: I64, %second: Bool, #iter: Ptr<HashMapIter<I64, I64>>, %index: I64):
        %item: Option<KVPair<I64, I64>> = #iter.next()
        %more: Bool = %item.tag
        %pair: KVPair<I64, I64> = %item.value
        branch %more ? consider(%pass, %half, %second, #iter, %index, %pair) : pass(%pass.add(1), %half, %second.bitnot())

    block consider(
            %pass: I64, %half: I64, %second: Bool, #iter: Ptr<HashMapIter<I64, I64>>, %index: I64,
            %pair: KVPair<I64, I64>):
        %in_second: Bool = %index.sge(%half)
        %wanted:    Bool = %in_second.eq(%second)
        branch %wanted ? copy(%pass, %half, %second, #iter, %index, %pair) : next(%pass, %half, %second, #iter, %index.add(1))

    block copy(
            %pass: I64, %half: I64, %second: Bool, #iter: Ptr<HashMapIter<I64, I64>>, %index: I64,
            %pair: KVPair<I64, I64>):
        #to.put(%pair.key, %pair.value)
        jump next(%pass, %half, %second, #iter, %index.add(1))

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 1 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %map_val: HashMap<I64, I64> = HashMap<I64, I64>.new(#alloc)
        #map: Ptr<HashMap<I64, I64>> = alloca<HashMap<I64, I64>>([%map_val])

        %r1: I64 = run_phase(#out, #map, #rng, 1, 3000, 64, 0)
        %r2: I64 = run_phase(#out, #map, #rng, 2, 8000, 5000, %r1)
        %r3: I64 = run_phase(#out, #map, #rng, 3, 4000, 300, %r2)

        %copy_val: HashMap<I64, I64> = HashMap<I64, I64>.new(#alloc)
        #copy: Ptr<HashMap<I64, I64>> = alloca<HashMap<I64, I64>>([%copy_val])
        report_eq(#out, "empty copy equal", #map.eq(#copy))
        copy_rotated(#map, #copy)
        report_eq(#out, "rotated copy equal", #map.eq(#copy))
        report_eq(#out, "rotated copy same order", iteration_hash(#map).eq(iteration_hash(#copy)))
        #copy.put(-1, 0)
        report_eq(#out, "extra key equal", #map.eq(#copy))
        #copy.remove(-1)
        report_eq(#out, "extra key removed equal", #map.eq(#copy))
        %iter_val: HashMapIter<I64, I64> = HashMapIter<I64, I64>.new(#map)
        #iter: Ptr<HashMapIter<I64, I64>> = alloca<HashMapIter<I64, I64>>([%iter_val])
        %first: KVPair<I64, I64> = #iter.next().value
        #copy.put(%first.key, %first.value.add(1))
        report_eq(#out, "changed value equal", #map.eq(#copy))
        #copy.free()
        #map.free()
        report_eq(#out, "freed is empty", #map.is_empty())
        #out.flush()
        return(0)
