// In.read<T>() reads a word longer than the 8192-byte input buffer: a valid number can be any length (a float with
// thousands of digits, an integer with a long run of leading zeros). A word that fits is read in place in the buffer.
// A longer one is copied into memory from the default heap, converted, and given back. Standard input holds
// 10000-zero runs: "0...01.5", "2.50...0", "0...042", "0...07x", "10...0e-10000", and "9".

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry()
        a : F64 = In.read<F64>()
        b : F64 = In.read<F64>()
        c : S32 = In.read<S32>()
        Out.write("{a} {b} {c}\n")
        bad : Result<S32, ParseError> = In.read_result<S32>()
        Out.write("a long word that isn't an S32: {bad.is_failure()}\n")
        one : Option<F64> = In.read_checked<F64>()
        Out.write("{one.diagnose()}\n")
        last : S64 = In.read<S64>()
        Out.write("then a short one: {last}\n")
        return(0)
