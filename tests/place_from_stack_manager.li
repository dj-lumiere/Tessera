# A place from the running flow's StackManager, named by STACK or by StackManager.current(), is a frame slot like one
# with no manager named, and the builder gives it back.

import Hosted

routine start() -> None
    words: &[U64] <- [0] * 4 from StackManager.current()
    count: &S64 <- 5 from STACK

    words.getslot(2).poke(7)
    Console.show("{words[2]} {count.load()}")
    return
