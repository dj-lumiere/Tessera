# Hex float literals: hex digits scaled by a power of two (the p exponent is decimal and required), exactly a B64.

import Hosted

routine show(v: B64) -> None
    Console.show("{v.bits()}")
    return

routine start() -> None
    show(0x1.71547652b82fep+0)  # log2(e)
    show(0x1.8p+46)
    show(0x1p-1074)  # the smallest subnormal
    show(0x1.fffffffffffffp+1023)  # B64.MAX
    show(-0x1.921fb54442d18p+1)  # -pi
    show(0x0.8p+1)  # 1.0
    show(0xA_B.Cp-4)  # 171.75 / 16
    show(0x0p+0)
    f: B32 = 0x1p+127
    Console.show("{f.bits()}")
    # Without a p exponent it is an integer, and `.add` a method call.
    n: U32 = 0x10 + 1
    Console.show("{n}")
    return
