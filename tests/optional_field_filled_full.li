# A fill the build can't follow (a field reached through a parameter) checks while running: one that holds a node stops.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

### Gives the node a next one.
### :param node: The node.
### :param value: The next one's value.
routine attach(node: @Node, value: S64) -> None
    node.next <- Node.construct(value) from HEAP
    return

routine start() -> None
    first: &Node <- Node.construct(1)
    attach(node: first, value: 2)
    Console.show("attached 2")
    attach(node: first, value: 3)
    Console.show("attached 3")
    return
