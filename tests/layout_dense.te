# @layout(dense) packs a record's fields with no padding and alignment 1, as a wire format or a packed register
# block needs. With align: N it keeps the packing but aligns the whole record. A dense record inside a C-layout one
# sits at any byte. A field at an unaligned offset is read and written in place with the alignment it has. A Ptr taken
# from it assumes its type's alignment (the author's to keep), so it reads with load_unaligned / store_unaligned.

import Standard/Os

@layout(dense)
record Packet
    tag: U8
    value: U32
    count: U16

@layout(dense, align: 8)
record Padded
    tag: U8
    value: U32

record Outer
    first: U8
    packet: Packet
    last: U8

routine start() -> None
    Console.show("{sizeof[Packet]()} {alignof[Packet]()} {sizeof[Padded]()} {alignof[Padded]()} {sizeof[Outer]()}")
    p: &Packet <- .hollow()
    p.tag.poke(0xAB)
    p.value.poke(0x11223344)
    p.count.poke(0x5566)
    bytes: @U8 = p.to[@U8]()
    Console.show("{bytes.stride(0).peek()} {bytes.stride(1).peek()} {bytes.stride(4).peek()} {bytes.stride(5).peek()} {bytes.stride(6).peek()}")
    Console.show("{p.value.peek()} {p.count.peek()}")
    o: &Outer <- .hollow()
    o.first.poke(1)
    o.packet.value.poke(7)
    o.last.poke(9)
    whole: Packet = o.packet.peek()
    Console.show("{o.packet.value.peek()} {whole.value} {o.last.peek()}")
    # bytes 1..4 of the packet hold value. Read them back through a plain pointer
    at: @U32 = bytes.stride(1).to[@U32]()
    Console.show("{at.peek_unaligned()}")
    at.poke_unaligned(0x0A0B0C0D)
    Console.show("{p.value.peek()}")
    field: @U32 = p.value
    Console.show("{field.peek_unaligned()}")
    return
