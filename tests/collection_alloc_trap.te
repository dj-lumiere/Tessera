# push, the crashing form of push_result, crashes when the allocator fails: stdout keeps what came before, and the
# exit status is 101.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

# A memory manager that never has memory to give.
record Refusing

obeys MemoryManageable[Refusing]

routine Refusing.alloc(me: @Me, size: U64, align: U64) -> Addr
    return .hollow()

routine Refusing.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

routine Refusing.free(me: @Me, at: Addr) -> None
    return

routine start() -> None
    local refusing: @Refusing <- .hollow()
    local alloc: @MemoryManager <- refusing.to[MemoryManager]()
    local list: @List[S64] <- .construct(alloc)

    pushed: Result[None, AllocFailed] = list.add_last_result(1)
    Out.write("push_result: {pushed}\n")
    list.add_last(1)
    Out.write("not reached\n")
    drop list
    return
