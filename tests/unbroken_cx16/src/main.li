# A 128-bit fetch_add and compare_exchange through cmpxchg16b, carrying across the low 64 bits.

import Hosted

routine start() -> None
    wide: &U128

    wide.poke_unbroken(0xFFFFFFFFFFFFFFFF)
    old: U128 = wide.fetch_add_unbroken(1)
    won: Optional[U128] = wide.compare_exchange_unbroken(expected: 0x10000000000000000, new: 5)
    Console.show("{old} {won} {wide.peek_unbroken()}")
    return
