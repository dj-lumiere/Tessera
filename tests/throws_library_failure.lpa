# A routine whose @throws leaves out a failure it passes on from a library routine is refused, though no try or
# check above reaches it: the list is checked against the routine's recovering form.
import Hosted

crashable LevelError
    level: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine LevelError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.level} is not between 0 and 10")
    return

### A volume level from text.
### :param text: The level as text.
### :returns: The level.
@throws([LevelError])
routine volume(text: @[Byte]) -> S64
    level: S64 = text.to[S64]()
    if level < 0 or level > 10
        throw LevelError(level)
    return level

level: S64 = volume("7")
Console.show("{level}")
