# Every integer type converts to itself with to_wrap and to_clamp, so one generic routine that converts with
# to_wrap[T]() or to_clamp[T]() takes the type it starts from as T too.
import Hosted

### v as a T, keeping the low bits.
### :typeparam T: The type.
### :param v: The value.
### :returns: The value, wrapped.
routine narrow[T](v: U64) -> T
    return v.to_wrap[T]()

### v as a T, saturating.
### :typeparam T: The type.
### :param v: The value.
### :returns: The value, clamped.
routine clamp_to[T](v: U256) -> T
    return v.to_clamp[T]()

### Runs.
routine start() -> None
    a: U32 = narrow[U32](5)
    b: U64 = narrow[U64](18446744073709551615)
    c: U256 = clamp_to[U256](115792089237316195423570985008687907853269984665640564039457584007913129639935)
    d: U8 = clamp_to[U8](300)
    e: S8 = -5
    f: S8 = e.to_wrap[S8]()
    g: CSize = 7
    h: CSize = g.to_clamp[CSize]()
    i: U8 = b.to_wrap[U8]()
    Console.show("{a} {b} {c} {d} {f} {h} {i}")
    return
