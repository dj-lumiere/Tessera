import Standard/Os

record Pair
    first: ExclusiveAccess
    second: ExclusiveAccess

routine start() -> None
    local pair: @Pair <- Pair(first: .construct(), second: .construct())

    pair.first.lock()
    pair.second.lock()
    pair.second.unlock()
    pair.first.unlock()
    Console.show("first, then second")
    pair.second.lock()
    pair.first.lock()
    Console.show("not reached")
    return
