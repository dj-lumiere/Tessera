# With the access-order check on, taking two accesses in the opposite order of an earlier pair stops the program with
# AccessOrderError, before two threads doing both could wait on each other.

import Standard/Os

record Pair
    first: U64
    second: U64

routine start() -> None
    pair: &Pair <- Pair(first: 0, second: 0)

    a: Authorized[U64] <- pair.first.get_exclusive_access()
    b: Authorized[U64] <- pair.second.get_exclusive_access()
    drop b
    drop a
    Console.show("first, then second")
    c: Authorized[U64] <- pair.second.get_exclusive_access()
    d: Authorized[U64] <- pair.first.get_exclusive_access()
    Console.show("not reached")
    drop d
    drop c
    return
