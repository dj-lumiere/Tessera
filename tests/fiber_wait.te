# Fibers that wait without holding up their thread: two fibers hand a turn back and forth a thousand times with park
# and wake, eight fibers sleep until different times and wake in that order, and a fiber starts ten others and waits
# for each. Outside a fiber, waitfor waits the thread, and retrieve of a fiber whose work is done returns at once.

import Fiber
import Hosted

preset ROUNDS: U64 = 1000

record PingPong
    sched: @CoroutineManager
    turn: U32  # 0: ping's, 1: pong's
    ping: @FiberState?
    pong: @FiberState?
    handoffs: U64

record Sleepers
    sched: @CoroutineManager
    order: Items[U64, 8]  # the sleepers' numbers in the order they woke
    next: U64
    short: U64  # sleepers that woke too early
    base: Duration  # the time their wake-up times count from, in Clock.monotonic() time

record Sleeper
    all: @Sleepers
    id: U64

entity Family
    sched: @CoroutineManager
    sum: U64
    children: Slots[Fiber[None], 10]

### Makes a family with no children yet.
### :param sched: The manager the fibers run on.
### :returns: The new value.
common routine Family.construct(sched: @CoroutineManager) -> Me
    lateinit none: &Slots[Fiber[None], 10]
    return Me(sched, sum: 0, children: steal none)

### One side of the ping-pong: waits for mine, hands the turn to the other, ROUNDS times.
routine play(game: @PingPong, mine: U32, own: @(@FiberState?), other: @(@FiberState?)) -> None
    sched: @CoroutineManager = game.sched.peek()

    own.poke_unbroken(sched.current())

    for i in 0 til ROUNDS
        # park may return without a wake, so the turn is checked again.
        until game.turn.peek_unbroken() == mine
            sched.park()
        then
            # The other side may not have its handle in yet: then it hasn't checked the turn either, and will see it.
            game.handoffs.fetch_add_unbroken(1)
            game.turn.poke_unbroken(mine ^ 1)
            when other.peek_unbroken()
                is @FiberState as peer =>
                    sched.wake(peer)
                    continue
                is None => continue
    then
        return

routine ping(game: @PingPong) -> None
    play(game, mine: 0, own: game.ping, other: game.pong)
    return

routine pong(game: @PingPong) -> None
    play(game, mine: 1, own: game.pong, other: game.ping)
    return

### Sleeper n sleeps until (8 - n) * 30 ms after the base, so they wake from the last to the first. The times are
### far enough apart for a coarse system timer (15.6 ms on Windows by default).
routine sleeper(s: @Sleeper) -> None
    all: @Sleepers = s.all.peek()

    id: U64 = s.id.peek()
    delay: Duration = 30ms * (8 - id).to[S64]()
    wake_at: Duration = delay + all.base.peek()
    all.sched.peek().waitfor(wake_at -^ Clock.monotonic())
    early: Bool = Clock.monotonic() < wake_at
    slot: U64 = all.next.fetch_add_unbroken(1)
    order_slots: @U64 = all.order.getview().to[@U64]()
    order_slots.stride(slot).poke(id)
    if early
        all.short.fetch_add_unbroken(1)
        return
    else
        return

### A child adds its share, sleeping and yielding on the way so the parent waits on children still running.
routine child(family: @Family) -> None
    sched: @CoroutineManager = family.sched.peek()
    sched.waitfor(1ms)
    family.sum.fetch_add_unbroken(1)
    sched.yield()
    family.sum.fetch_add_unbroken(9)
    return

routine parent(family: @Family) -> None
    sched: @CoroutineManager = family.sched.peek()
    kids: @Fiber[None] = family.children.getview().to[@Fiber[None]]()

    for i: U64 in 0 til 10
        kid: Fiber[None] <- sched.get_fiber[None]()
        work_kid: Work[None] = child.to[Work](family: family)
        kid.put_work(work_kid)
        kids.stride(i).poke(steal kid)

    for i: U64 in 0 til 10
        steal kids.stride(i) as kid inject lateinit
        kid.retrieve()
        drop kid
    Console.show("joined: sum {family.sum.peek_unbroken()}")
    return

routine start() -> None
    manager: @MemoryManager = HEAP
    stack_manager: @MemoryManager = PAGES
    sched: &CoroutineManager <- .construct(stack_size: 64kib, stack_manager, manager)
    game: &PingPong <- PingPong(sched: sched, turn: 0, ping: None(), pong: None(), handoffs: 0)
    lateinit sleepers: &Sleepers
    lateinit sleeper_slots: &Items[Sleeper, 8]
    sleeper_at: @Sleeper = sleeper_slots.getview().to[@Sleeper]()
    sleeper_fibers: &Slots[Fiber[None], 8]
    players: &Slots[Fiber[None], 2]

    # Outside a fiber, sleep waits the thread.
    before: Duration = Clock.monotonic()
    sched.waitfor(5ms)
    elapsed: Duration = Clock.monotonic() - before
    waited: Bool = elapsed >= 5ms
    Console.show("thread slept: {waited}")

    pinger: Fiber[None] <- sched.get_fiber[None]()
    work_pinger: Work[None] = ping.to[Work](game: game)
    pinger.put_work(work_pinger)
    players.getslot(0).poke(steal pinger)
    ponger: Fiber[None] <- sched.get_fiber[None]()
    work_ponger: Work[None] = pong.to[Work](game: game)
    ponger.put_work(work_ponger)
    players.getslot(1).poke(steal ponger)

    sleepers.store(Sleepers(sched: sched, order: [0, 0, 0, 0, 0, 0, 0, 0], next: 0, short: 0,
        base: Clock.monotonic()))

    for i: U64 in 0 til 8
        s: @Sleeper = sleeper_at.stride(i)
        s.poke(Sleeper(all: sleepers, id: i.to[U64]()))
        f: Fiber[None] <- sched.get_fiber[None]()
        work_f: Work[None] = sleeper.to[Work](s: s)
        f.put_work(work_f)
        sleeper_fibers.getslot(i).poke(steal f)
    family: &Family <- .construct(sched)
    elder: Fiber[None] <- sched.get_fiber[None]()
    work_elder: Work[None] = parent.to[Work](family: family)
    elder.put_work(work_elder)
    alone: &Family <- .construct(sched)
    lone: Fiber[None] <- sched.get_fiber[None]()
    work_lone: Work[None] = child.to[Work](family: alone)
    lone.put_work(work_lone)
    sched.run()
    drop elder
    Console.show("handoffs: {game.handoffs.peek()}")

    for i: U64 in 0 til 8
        order_slots: @U64 = sleepers.order.getview().to[@U64]()
        Console.show("{order_slots.stride(i).peek()} ", end: "")
    then
        # The lone child finished during run: retrieve returns at once.
        Console.show("\nwoke early: {sleepers.short.peek()}")
        lone.retrieve()
        drop lone
        Console.show("lone joined")

        for i2: U64 in 0 til 8
            drop sleeper_fibers.getslot(i2)
        drop players.getslot(0)
        drop players.getslot(1)
        drop sched
        return
