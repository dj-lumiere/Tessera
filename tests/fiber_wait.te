# Fibers that wait without holding up their thread: two fibers hand a turn back and forth a thousand times with park
# and wake, eight fibers sleep until different times and wake in that order, and a fiber starts ten others and waits
# for each. Outside a fiber, waitfor waits the thread, and wait_finished of a fiber whose work is done returns at once.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

preset ROUNDS: U64 = 1000

record PingPong
    sched: @FiberManager
    turn: U32  # 0: ping's, 1: pong's
    ping: @FiberState
    pong: @FiberState
    handoffs: U64

record Sleepers
    sched: @FiberManager
    order: Array[U64, 8]  # the sleepers' numbers in the order they woke
    next: U64
    short: U64  # sleepers that woke too early
    base: Duration  # the time their wake-up times count from, in monotonic_now time

record Sleeper
    all: @Sleepers
    id: U64

record Family
    sched: @FiberManager
    sum: U64
    children: Array[Fiber[None], 10]

### Makes a `PingPong` from its fields.
### :param sched: Its `sched`.
### :param turn: Its `turn`.
### :param ping: Its `ping`.
### :param pong: Its `pong`.
### :param handoffs: Its `handoffs`.
### :returns: The new value.
routine PingPong.construct(sched: @FiberManager, turn: U32, ping: @FiberState, pong: @FiberState,
    handoffs: U64) -> Me
    return Me(sched, turn, ping, pong, handoffs)

### Releases nothing: a `PingPong` holds no memory of its own.
routine PingPong.destruct(me: @Me) -> None
    return

### Makes a `Sleepers` from its fields.
### :param sched: Its `sched`.
### :param order: Its `order`.
### :param next: Its `next`.
### :param short: Its `short`.
### :param base: Its `base`.
### :returns: The new value.
routine Sleepers.construct(sched: @FiberManager, order: Array[U64, 8], next: U64, short: U64,
    base: Duration) -> Me
    return Me(sched, order, next, short, base)

### Releases nothing: a `Sleepers` holds no memory of its own.
routine Sleepers.destruct(me: @Me) -> None
    return

### Makes a `Sleeper` from its fields.
### :param all: Its `all`.
### :param id: Its `id`.
### :returns: The new value.
routine Sleeper.construct(all: @Sleepers, id: U64) -> Me
    return Me(all, id)

### Releases nothing: a `Sleeper` holds no memory of its own.
routine Sleeper.destruct(me: @Me) -> None
    return

### Makes a `Family` from its fields.
### :param sched: Its `sched`.
### :param sum: Its `sum`.
### :param children: Its `children`.
### :returns: The new value.
routine Family.construct(sched: @FiberManager, sum: U64, children: Array[Fiber[None], 10]) -> Me
    return Me(sched, sum, children)

### Releases nothing: a `Family` holds no memory of its own.
routine Family.destruct(me: @Me) -> None
    return

### One side of the ping-pong: waits for mine, hands the turn to the other, ROUNDS times.
routine play(game: @PingPong, mine: U32, own: @@FiberState, other: @@FiberState) -> None
    local sched: @FiberManager = game.sched.peek()

    own.poke_atomic(sched.current())

    each i in 0 til ROUNDS
        # park may return without a wake, so the turn is checked again.
        while game.turn.peek_atomic() != mine
            sched.park()
        then
            # The other side may not have its handle in yet: then it hasn't checked the turn either, and will see it.
            game.handoffs.atomic_fetch_add(1)
            game.turn.poke_atomic(mine ^ 1)
            peer: @FiberState = other.peek_atomic()
            if peer.is_hollow()
                continue
            else
                sched.wake(peer)
                continue
    then
        return

routine ping(game: @PingPong) -> None
    play(game, mine: 0, own: game.ping, other: game.pong)
    return

routine pong(game: @PingPong) -> None
    play(game, mine: 1, own: game.pong, other: game.ping)
    return

### Sleeper n sleeps until (8 - n) * 30 ms after the base, so they wake from the last to the first. The times are
### far enough apart for a coarse system timer (15.6 ms on Windows by default).
routine sleeper(s: @Sleeper) -> None
    local all: @Sleepers = s.all.peek()

    id: U64 = s.id.peek()
    delay: Duration = 30ms * (8 - id)
    wake_at: Duration = delay + all.base.peek()
    all.sched.peek().waitfor(wake_at -^ monotonic_now())
    early: Bool = monotonic_now() < wake_at
    slot: U64 = all.next.atomic_fetch_add(1)
    order_slots: @U64 = all.order.to[@U64]()
    order_slots.stride(slot).poke(id)
    if early
        all.short.atomic_fetch_add(1)
        return
    else
        return

### A child adds its share, sleeping and yielding on the way so the parent waits on children still running.
routine child(family: @Family) -> None
    sched: @FiberManager = family.sched.peek()
    sched.waitfor(1ms)
    family.sum.atomic_fetch_add(1)
    sched.yield()
    family.sum.atomic_fetch_add(9)
    return

routine parent(family: @Family) -> None
    local sched: @FiberManager = family.sched.peek()
    local kids: @Fiber[None] = family.children.to[@Fiber[None]]()

    each i: U64 in 0 til 10
        kid: Fiber[None] = sched.get_fiber[None]()
        kid.put_work(entry: child.to[Callable](), args: family)
        kids.stride(i).poke(kid)

    each i: U64 in 0 til 10
        kid: Fiber[None] = kids.stride(i).peek()
        kid.wait_finished()
        kid.give_back()
    Out.write("joined: sum {family.sum.peek_atomic()}\n")
    return

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()
    local stacks: @MemoryManager <- make_stack_memory()
    local sched: @FiberManager <- .construct(stack_size: 64kib, stacks, alloc)
    local game: @PingPong <- PingPong(sched: sched, turn: 0, ping: .hollow(), pong: .hollow(),
        handoffs: 0)
    local sleepers: @Sleepers <- .hollow()
    local sleeper_slots: @Array[Sleeper, 8] <- .hollow()
    local sleeper_at: @Sleeper = sleeper_slots.to[@Sleeper]()
    local sleeper_fibers: @Array[Fiber[None], 8] <- .hollow()
    local players: @Array[Fiber[None], 2] <- .hollow()

    # Outside a fiber, sleep waits the thread.
    before: Duration = monotonic_now()
    sched.waitfor(5ms)
    elapsed: Duration = monotonic_now() - before
    waited: Bool = elapsed >= 5ms
    Out.write("thread slept: {waited}\n")

    pinger: Fiber[None] = sched.get_fiber[None]()
    pinger.put_work(entry: ping.to[Callable](), args: game)
    players[0] = pinger
    ponger: Fiber[None] = sched.get_fiber[None]()
    ponger.put_work(entry: pong.to[Callable](), args: game)
    players[1] = ponger

    sleepers.poke(Sleepers(sched: sched, order: [0, 0, 0, 0, 0, 0, 0, 0], next: 0, short: 0,
        base: monotonic_now()))

    each i: U64 in 0 til 8
        s: @Sleeper = sleeper_at.stride(i)
        s.poke(Sleeper(all: sleepers, id: i.to[U64]()))
        f: Fiber[None] = sched.get_fiber[None]()
        f.put_work(entry: sleeper.to[Callable](), args: s)
        sleeper_fibers[i] = f
    local family: @Family <- Family(sched: sched, sum: 0, children: .hollow())
    elder: Fiber[None] = sched.get_fiber[None]()
    elder.put_work(entry: parent.to[Callable](), args: family)
    local alone: @Family <- Family(sched: sched, sum: 0, children: .hollow())
    lone: Fiber[None] = sched.get_fiber[None]()
    lone.put_work(entry: child.to[Callable](), args: alone)
    sched.run()
    elder.give_back()
    Out.write("handoffs: {game.handoffs.peek()}\n")

    each i: U64 in 0 til 8
        order_slots: @U64 = sleepers.order.to[@U64]()
        Out.write("{order_slots.stride(i).peek()} ")
    then
        # The lone child finished during run: wait_finished returns at once.
        Out.write("\nwoke early: {sleepers.short.peek()}\n")
        lone.wait_finished()
        lone.give_back()
        Out.write("lone joined\n")

        each i2: U64 in 0 til 8
            sleeper_fibers[i2].give_back()
        players[0].give_back()
        players[1].give_back()
        drop sched
        return
