# Thread work that changes memory it was handed without steal, and without an exclusive access, is a build error, even
# when the routine that hands it waits for the work: that memory isn't the work's alone.

import Collections
import Hosted

### Adds a value.
### :param xs: The list.
@reshaping(xs)
routine fill(xs: @List[S64]) -> None
    xs.add_last(1)
    return

routine start() -> None
    list: &List[S64] <- .construct(HEAP)

    t: Thread[None] <- get_thread[None]()
    work_t: Work[None] = fill.to[Work](xs: list)
    t.put_work(work_t)
    t.retrieve()
    drop t
    drop list
    return
