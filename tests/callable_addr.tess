// A Callable's code address as an Addr, for C code that takes a function as void*: .addr() on a routine name (typed
// by the routine's own signature) and on a Callable value give the same address.

import Standard::Format

routine twice(x: S64) -> S64
    block entry():
        return(x.mul(2))

routine main() -> S32
    block entry():
        direct  : Addr                  = twice.to<Callable>().addr()
        fn      : Callable<(S64,), S64> = twice.to<Callable>()
        via     : Addr                  = fn.addr()
        d       : U64                   = ptrtoint<Addr, U64>(direct)
        v       : U64                   = ptrtoint<Addr, U64>(via)
        same    : Bool                  = d.eq(v)
        is_null : Bool                  = d.eq(0)
        print("same: {same}, null: {is_null}, call: {fn.call(21)}\n")
        return(0)
