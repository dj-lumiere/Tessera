# A plain Callable that arrives from elsewhere (a call result, a parameter, a C routine) goes into a place open to any
# failure as it is: the place holds its address with its kind, a call through it gives a plain one's value as a success,
# and a failing one in the same list is received.
import Hosted
import Collections

crashable BadInputError
    value: S64

crashable TooBigError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine TooBigError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("too big {me.value}")
    return

### n, failing for a negative or a large n.
### n, failing for a negative or a large n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    if n > 100
        throw TooBigError(value: n)
    return n

### C's absolute value.
### :param x: A number.
### :returns: Its absolute value.
@external("c")
@symbol("llabs")
routine c_abs(x: S64) -> S64

### The plain routine a call gives back.
### :param n: The number.
### :returns: Thrice n.
infallible routine thrice(n: S64) -> S64
    return n * 3

### A Callable given back as a plain value.
### :returns: The Callable.
routine pick() -> Callable[(S64,), S64]
    return thrice.to[Callable]()

### A handler kept in a field.
record Handler
    action: Callable[(S64,), S64]

### Keeps the Callable it is given in a field, as it was given.
### :param given: A Callable only called elsewhere.
### :returns: The handler.
routine hold(given: Callable[(S64,), S64]) -> Handler
    return Handler(action: given)

### Calls a Callable and does nothing else with it.
### :param only_called: The Callable.
### :returns: Its result for 5.
routine run_five(only_called: Callable[(S64,), S64]) -> S64
    return only_called.call(5)

### Runs the example.
routine start() -> None
    from_call: Handler = Handler(action: pick())
    Console.show("call result {from_call.action.call(7)}")
    plain: Callable[(S64,), S64] = pick()
    from_param: Handler = hold(plain)
    Console.show("parameter {from_param.action.call(8)}")
    Console.show("only called {run_five(plain)}")
    steps: &List[Callable[(S64,), S64]] <- .construct(manager: HEAP)
    steps.add_last(plain)
    steps.add_last(c_abs.to[Callable]())
    steps.add_last(checked.to[Callable]())
    steps.add_last(pick())
    for i in 0 til steps.count().to[S64]()
        step: Callable[(S64,), S64] = steps[i.to[U64]()]
        Console.show("step {i}: {try step.call(-4)}")
    c_one: Callable[(S64,), S64] = steps[1]
    Console.show("c routine {c_one.call(-9)}")
    failing: Callable[(S64,), S64] = steps[2]
    when check failing.call(500)
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        else as other => Console.show("another failure: {other.name()}")
    when check failing.call(-3)
        is S64 as v => Console.show("got {v}")
        is BadInputError as e => Console.show("bad input {e.value}")
        else as other => Console.show("another failure: {other.name()}")
    Console.show("ok {failing.call(9)}")
    drop steps
    return
