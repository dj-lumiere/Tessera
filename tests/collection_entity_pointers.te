# A collection of pointers to entities (T is @Thing) keeps the pointers: adding one and taking it out again gives the
# same address, and the entity stays in its own slot.

import Standard/Collections
import Standard/Os

### A thing with a number.
entity Thing
    n: U64

### Makes it.
### :param n: The number.
### :returns: The thing.
common routine Thing.construct(n: U64) -> Me
    return Me(n)

### Releases nothing.
routine @Thing.destruct() -> None
    return

### Shows the thing's number and whether it is the one at `at`.
### :param t: The thing.
### :param at: The address it should have.
routine show_thing(t: @Thing, at: Addr) -> None
    Console.show("same: {t.to[Addr]() === at}, n: {t.n.peek()}")
    return

a: &Thing <- .construct(n: 7)
q: &CircularList[@Thing] <- .construct(manager: HEAP)
q.add_last(a)
show_thing(t: q.getitem(0), at: a.to[Addr]())
show_thing(t: q.remove_first(), at: a.to[Addr]())
drop q
drop a
