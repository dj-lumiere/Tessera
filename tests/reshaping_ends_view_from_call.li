# A view a routine gives of an element of the list it is handed sees what the list holds, so it ends at a #reshaping
# call on the list.

import Collections
import Hosted

### The first element of `items`.
### :param items: A list with an element.
### :returns: The view of its first element.
routine first(items: @List[S64]) -> @S64
    return items.getslot(0)

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)
    xs.add_last(5)
    f: @S64 = first(xs)
    xs.add_last(6)
    Console.show(f.peek())
    drop xs
    return
