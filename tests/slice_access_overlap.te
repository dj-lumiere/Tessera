# Taking an element's access while the same path holds the access of the run around it would wait for
# itself: a build error.

import Standard/Hosted

### Takes an element's access while the run's is held.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3] * 1 from HEAP
    whole: AuthorizedSlice[S64] <- numbers.get_exclusive_access()
    one: Authorized[S64] <- numbers.getslot(1).get_exclusive_access()
    drop one
    drop whole
    drop numbers
    return
