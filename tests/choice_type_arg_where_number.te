# A choice member where a number goes is a build error.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE

### The rank of O.
### :typeparam O: The order.
### :returns: 0 or 1.
routine rank[O]() -> U64
needs Order O
    when O
        Order.RELAXED => return 0
        Order.ACQUIRE => return 1

### K itself.
### :typeparam K: The value.
### :returns: K.
routine count[K]() -> U64
needs U64 K
    return K

### Runs.
routine start() -> None
    Console.show("{count[Order.ACQUIRE]()}")
    return
