; Generated by scripts/gen_int_tests.py: every Rust-level integer method on I8..I128, checked against a
; Python model of Rust's semantics. Regenerate instead of editing.

@[external("c"), callconv("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<I8>) -> CInt

routine show(#label: Ptr<I8>, %v: I128) -> Void
    block entry():
        show_suffixed(#label, %v, "")
        return()

; I128 has no printf conversion, so print a sign and the magnitude in base-10^18 limbs.
routine show_suffixed(#label: Ptr<I8>, %v: I128, #suffix: Ptr<I8>) -> Void
    block entry():
        #sign: Ptr<I8> = sign_text(%v.slt(0))
        %mag: I128 = %v.abs()
        %top: I128 = %mag.udiv(1000000000000000000000000000000000000)
        %rest: I128 = %mag.urem(1000000000000000000000000000000000000)
        %mid: I64 = %rest.udiv(1000000000000000000).to_i64()
        %low: I64 = %rest.urem(1000000000000000000).to_i64()
        select:
            %top.ne(0) -> three(%top.to_i64(), %mid, %low)
            %mid.ne(0) -> two(%mid, %low)
            _ -> one(%low)

    block one(%low: I64):
        c_printf("%s %s%llu%s\n", #label, sign_text(%v.slt(0)), %low, #suffix)
        return()

    block two(%mid: I64, %low: I64):
        c_printf("%s %s%llu%018llu%s\n", #label, sign_text(%v.slt(0)), %mid, %low, #suffix)
        return()

    block three(%top: I64, %mid: I64, %low: I64):
        c_printf("%s %s%llu%018llu%018llu%s\n", #label, sign_text(%v.slt(0)), %top, %mid, %low, #suffix)
        return()

routine sign_text(%negative: Bool) -> Ptr<I8>
    block entry():
        branch %negative ? return("-") : return("")

routine show_bool(#label: Ptr<I8>, %v: Bool) -> Void
    block entry():
        c_printf("%s %d\n", #label, %v.to_i32())
        return()

routine show_opt<T>(#label: Ptr<I8>, %o: Option<T>) -> Void
require T: typename
    block entry():
        %present: Bool = %o.tag
        branch %present ? some() : none()

    block some():
        %v: T = %o.value
        show(#label, %v.to_i128())
        return()

    block none():
        c_printf("%s none\n", #label)
        return()

routine show_ovf<T>(#label: Ptr<I8>, %o: Overflowing<T>) -> Void
require T: typename
    block entry():
        %v: T = %o.value
        %flag: Bool = %o.overflow
        branch %flag ? print(%v, " 1") : print(%v, " 0")

    block print(%v: T, #suffix: Ptr<I8>):
        show_suffixed(#label, %v.to_i128(), #suffix)
        return()

