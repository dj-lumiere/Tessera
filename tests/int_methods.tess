// Every integer method on S8 .. S256 and U8 .. U256, checked against a Python model.

import Standard::Format
import Standard::Os

routine show<T>(out: @BufWriter<Out>, label: Bytes, v: T) -> Void
require T: typename, Representable<T>
    block entry()
        out.write("{label} {v}\n")
        return()

routine show_bool(out: @BufWriter<Out>, label: Bytes, v: Bool) -> Void
    block entry()
        show(out, label, v)
        return()

routine show_opt<T>(out: @BufWriter<Out>, label: Bytes, o: Option<T>) -> Void
require T: typename, Representable<T>
    block entry()
        when o
            .Present(value) -> some(value)
            .Absent         -> none()

    block some(value: T)
        show(out, label, value)
        return()

    block none()
        none : Bytes = "none"
        show(out, label, none)
        return()

routine part0(out: @BufWriter<Out>) -> Void
    block entry()
        c0 : S8 = 0
        show(out, "S8.count_ones(0)", c0.count_ones())
