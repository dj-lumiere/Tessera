; Generated by scripts/gen_int_tests.py: every integer method on S8 .. S256 and U8 .. U256, checked against a
; Python model. Regenerate instead of editing.

routine show<T>(#out: Ptr<BufWriter<FdWriter>>, %label: String, %v: T) -> Void
require T: typename, Format<T>
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %v.format(#out)
        write_line(#out)
        return()

routine show_bool(#out: Ptr<BufWriter<FdWriter>>, %label: String, %v: Bool) -> Void
    block entry():
        show(#out, %label, %v)
        return()

routine show_opt<T>(#out: Ptr<BufWriter<FdWriter>>, %label: String, %o: Option<T>) -> Void
require T: typename, Format<T>
    block entry():
        %present: Bool = %o.tag
        branch %present ? some() : none()

    block some():
        show(#out, %label, %o.value)
        return()

    block none():
        %none: String = "none"
        show(#out, %label, %none)
        return()

