# A literal without its type goes into a variant through the one branch of its shape: a tuple, an array, a record
# literal, or a number.

import Hosted

@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Point
    x: S64
    y: S64

### Prints each value.
routine start() -> None
    pair: Optional[(S64, S64)] = (1, 2)
    three: Optional[Items[S64, 3]] = [7, 8, 9]
    point: Point | Bool = (x: 3, y: 4)
    number: Optional[U8] = 5
    Console.show("{pair.diagnose()} {three.diagnose()} {point} {number}")
    return
