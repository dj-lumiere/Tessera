# A record that holds something to release (here a value of a type parameter) says how it is made and released: one
# without a destruct is an error. A record of plain data, addresses included, needs neither (record_plain_data).

record Owner[T]
needs T: typename
    name: T

### Makes an `Owner` from its fields.
### :param name: Its `name`.
### :returns: The new value.
common routine Owner[T].construct(name: T) -> Me
needs T: typename
    return Me(name)

routine start() -> None
    return
