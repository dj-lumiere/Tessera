# A record that holds something to release (here an address) says how it is made and released: one without a
# destruct is an error. A record of plain data needs neither (record_plain_data).

record Owner
    name: @Byte

### Makes an `Owner` from its fields.
### :param name: Its `name`.
### :returns: The new value.
common routine Owner.construct(name: @Byte) -> Me
    return Me(name)

routine start() -> None
    return
