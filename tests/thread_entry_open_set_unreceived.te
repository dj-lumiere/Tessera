# A failure of a ticket's work that nothing receives stops the program with the failure's message, also when the ticket
# was passed to a routine that can't name its work's routine.

import Hosted

crashable BadInputError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad input {me.value}")
    return

### n, failing for a negative n.
### :param n: The number.
### :returns: It.
routine checked(n: S64) -> S64
    if n < 0
        throw BadInputError(value: n)
    return n

### Shows what the ticket's work gave.
### :param t: The ticket.
routine show_it(t: @Thread[S64]) -> None
    Console.show("{t.retrieve()}")
    return

### Runs the example.
routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(checked.to[Work](n: -4))
    show_it(t)
    drop t
    return
