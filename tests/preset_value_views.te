# A preset is a value in read-only data: an Items whose count comes from its literal, text as Bytes or Chars, and a
# record. A routine reads it in place, views it with =, or copies it.

import Hosted

preset PRIMES: Items[U64, _] = [2, 3, 5, 7, 11]
preset GREETING: Items[Byte, _] = "hello"
preset NAME: Items[Char, _] = "루미"
preset ORIGIN: Point = (x: 3, y: 4)

record Point
    x: S64
    y: S64

routine total(values: @[U64]) -> U64
    for i in 0 til values.count() with sum: U64 = 0
        continue with sum: sum + values[i]
    then
        return sum

routine first[T](values: @[T]) -> T
    return values[0]

routine start() -> None
    i: U64 = 3
    view: @[U64] = PRIMES
    place: @Items[U64, 5] = PRIMES
    copy: Items[U64, 5] = PRIMES
    text: @[Byte] = GREETING
    chars: @[Char] = NAME
    Console.show("{PRIMES[i]} {PRIMES.getitem(4)} {total(PRIMES)} {first(PRIMES)} {view.count()} {place.getitem(1)} {copy}")
    Console.show("{text} {text.count()} {chars.count()} {ORIGIN.x + ORIGIN.y}")
    return
