# An address rounds up or down to an alignment, given as a buildtime value (`align_up[16]()`) or one known only while
# the program runs (`align_up(by: n)`). An aligned address stays where it is.
import Hosted

routine start() -> None
    a: Addr = 0x1003
    aligned: Addr = 0x2000
    out: @ConsoleOutput = Console.output()
    out.write("{a.align_up[16]()} {a.align_down[16]()} {a.is_aligned[16]()}\n")
    out.write("{aligned.align_up[4096]()} {aligned.align_down[4096]()} {aligned.is_aligned[4096]()}\n")
    out.write("{a.align_up[1]()} {a.is_aligned[1]()}\n")

    by: ByteSize = 8b
    out.write("{a.align_up(by)} {a.align_down(by)} {a.is_aligned(by)} {aligned.is_aligned(by)}\n")

    # an alignment that is not a power of two
    odd: ByteSize = 12b
    when try a.align_up(by: odd)
        is None => out.write("12 is not an alignment\n")
        else => out.write("aligned to 12\n")

    # past the end of the address space
    last: Addr = 0xFFFFFFFFFFFFFFF9
    when try last.align_up[16]()
        is None => out.write("no aligned address after the last one\n")
        else => out.write("aligned past the end\n")
    return
