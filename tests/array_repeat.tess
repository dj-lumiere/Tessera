/// `[0] x 256` repeats the elements: in a value, a preset, and a global, with the count a literal or a preset.
import Standard/Format

import Standard/Os

global ROW: @Array[S64, WIDTH] <- [7] x WIDTH

preset WIDTH: USize = 4
preset ZEROS: @Array[U8, 8] <- [0] x 8
preset PAIRS: @Array[S32, 6] <- [1, 2] x 3

/// Prints an array of S32 on one line.
/// :param a: The array.
routine show_six(a: Array[S32, 6]) -> None
    Out.write("{a.getitem(0)} {a.getitem(1)} {a.getitem(2)} {a.getitem(3)} {a.getitem(4)} {a.getitem(5)}\n")
    return

routine start() -> None
    twice: Array[S32, 6] = [5, 6, 9] x 2
    show_six(twice)
    show_six(PAIRS.peek())
    Out.write("{ZEROS.getitem(7)} {ROW.getitem(3)}\n")
    filled: Array[B64, 3] = [0.5] x 3
    Out.write("{filled.getitem(2)}\n")
    return
