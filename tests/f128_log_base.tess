/// Writes `name = ` and log base `base` of `x`.
/// :param out: The writer.
/// :param name: The case.
/// :param x: The argument.
/// :param base: The base.
routine show(out: @Out, name: Bytes, x: U128, base: U128) -> Void
    block entry()
        r : F128 = f128_of(x).log(f128_of(base))
        out.write("{name} = {r}\n")
        return()

/// Checks every pair of PAIR_* through F128.log, and every pair of HARD_* through F128.log and the F128Big tier alone.
/// :returns: 0.
routine main() -> S32
    shared wrong : @USize <- 0

    block entry()
        show(Out.writer(), "log(NaN, 2)", 0x7FFF8000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(2, NaN)", 0x40000000000000000000000000000000,
            0x7FFF8000000000000000000000000000)
        show(Out.writer(), "log(-1, 2)", 0xBFFF0000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(2, -2)", 0x40000000000000000000000000000000,
            0xC0000000000000000000000000000000)
        show(Out.writer(), "log(+0, 2)", 0x00000000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(-0, 2)", 0x80000000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(+0, 0.5)", 0x00000000000000000000000000000000,
            0x3FFE0000000000000000000000000000)
        show(Out.writer(), "log(+inf, 2)", 0x7FFF0000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(+inf, 0.5)", 0x7FFF0000000000000000000000000000,
            0x3FFE0000000000000000000000000000)
        show(Out.writer(), "log(1, 2)", 0x3FFF0000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(1, 0.5)", 0x3FFF0000000000000000000000000000,
            0x3FFE0000000000000000000000000000)
        show(Out.writer(), "log(2, 1)", 0x40000000000000000000000000000000,
            0x3FFF0000000000000000000000000000)
        show(Out.writer(), "log(0.5, 1)", 0x3FFE0000000000000000000000000000,
            0x3FFF0000000000000000000000000000)
        show(Out.writer(), "log(1, 1)", 0x3FFF0000000000000000000000000000,
            0x3FFF0000000000000000000000000000)
        show(Out.writer(), "log(2, +0)", 0x40000000000000000000000000000000,
            0x00000000000000000000000000000000)
        show(Out.writer(), "log(0.5, +0)", 0x3FFE0000000000000000000000000000,
            0x00000000000000000000000000000000)
        show(Out.writer(), "log(2, +inf)", 0x40000000000000000000000000000000,
            0x7FFF0000000000000000000000000000)
        show(Out.writer(), "log(0.5, +inf)", 0x3FFE0000000000000000000000000000,
            0x7FFF0000000000000000000000000000)
        show(Out.writer(), "log(+0, +0)", 0x00000000000000000000000000000000,
            0x00000000000000000000000000000000)
        show(Out.writer(), "log(+inf, +inf)", 0x7FFF0000000000000000000000000000,
            0x7FFF0000000000000000000000000000)
        show(Out.writer(), "log(+0, +inf)", 0x00000000000000000000000000000000,
            0x7FFF0000000000000000000000000000)
        show(Out.writer(), "log(8, 2)", 0x40020000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(9, 3)", 0x40022000000000000000000000000000,
            0x40008000000000000000000000000000)
        show(Out.writer(), "log(2, 4)", 0x40000000000000000000000000000000,
            0x40010000000000000000000000000000)
        show(Out.writer(), "log(8, 4)", 0x40020000000000000000000000000000,
            0x40010000000000000000000000000000)
        show(Out.writer(), "log(0.5, 2)", 0x3FFE0000000000000000000000000000,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(min subnormal, 2)", 0x00000000000000000000000000000001,
            0x40000000000000000000000000000000)
        show(Out.writer(), "log(10, 10)", 0x40024000000000000000000000000000,
            0x40024000000000000000000000000000)
        show(Out.writer(), "log(10^30, 10)", 0x406293E5939A08CE9DBD480000000000,
            0x40024000000000000000000000000000)
        jump pairs(0)

    block pairs(i: USize)
        done : Bool = i.ge(1672)
        branch done
            ? pairs_done()
            : continue
        x    : F128 = f128_of(PAIR_X.getitem(i))
        b    : F128 = f128_of(PAIR_BASE.getitem(i))
        got  : U128 = x.log(b).bits()
        want : U128 = PAIR_WANT.getitem(i)
        branch got.eq(want)
            ? pairs(i.add(1))
            : pairs_bad(i, got)

    block pairs_bad(i: USize, got: U128)
        Out.write("wrong: log({PAIR_X.getitem(i)}, {PAIR_BASE.getitem(i)}) gave {got}\n")
        wrong.load().add(1).store_into(wrong)
        jump pairs(i.add(1))

    block pairs_done()
        Out.write("F128.log: 1672 pairs, {wrong.load()} wrong\n")
        0.store_into(wrong)
        jump hard(0)

    block hard(i: USize)
        done : Bool = i.ge(392)
        branch done
            ? hard_done()
            : continue
        x     : F128 = f128_of(HARD_X.getitem(i))
        b     : F128 = f128_of(HARD_BASE.getitem(i))
        full  : U128 = x.log(b).bits()
        exact : U128 = f128_log_base(x, b, true).bits()
        want  : U128 = HARD_WANT.getitem(i)
        good  : Bool = full.eq(want).bitand(exact.eq(want))
        branch good
            ? hard(i.add(1))
            : hard_bad(i)

    block hard_bad(i: USize)
        Out.write("wrong: hard log({HARD_X.getitem(i)}, {HARD_BASE.getitem(i)})\n")
        wrong.load().add(1).store_into(wrong)
        jump hard(i.add(1))

    block hard_done()
        Out.write("F128.log and the F128Big tier alone: 392 hard pairs, {wrong.load()} wrong\n")
        return(0)
