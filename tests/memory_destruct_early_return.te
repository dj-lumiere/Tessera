# A destruct that returns early when its field is hollow, and gives it back otherwise: allowed.

import Standard/Os

### Holds memory.
entity Q
    m: BorrowedSlice[S64]

### An empty one.
### :returns: It.
common routine Q.construct() -> Me
    return Me(m: .hollow())

### Gives the field back when there is one.
routine @Q.destruct() -> None
    if me.m.count() == 0
        return
    drop me.m
    return

routine start() -> None
    q: &Q <- .construct()

    q.m.replace(value: BorrowedSlice[S64].construct(values: [7], times: 4, manager: HEAP))
    Console.show("{q.m.count()}")
    drop q
    return
