// F16 and BF16 mul_add round once. Computing a*b + c as an F32 fma and then narrowing rounds twice, and these
// inputs came out one ulp off that way (the expected bits are the exact result rounded to nearest, ties to even).

import Standard::Format
import Standard::Os

routine f16(a: U16, b: U16, c: U16) -> Void
    block entry():
        r : F16 = F16.from_bits(a).mul_add(F16.from_bits(b), F16.from_bits(c))
        print("F16 {r.bits()}\n")
        return()

routine bf16(a: U16, b: U16, c: U16) -> Void
    block entry():
        r : BF16 = BF16.from_bits(a).mul_add(BF16.from_bits(b), BF16.from_bits(c))
        print("BF16 {r.bits()}\n")
        return()

routine main() -> S32
    block entry():
        f16(0x4240, 0x73D0, 0x1206)  // 0x7A1B
        f16(0x4A00, 0xE18E, 0x8EED)  // 0xF02B
        f16(0x665E, 0xCD00, 0x02C4)  // 0xF7F5
        f16(0xE780, 0xCD68, 0x869C)  // 0x7911
        bf16(0x730C, 0x9630, 0x88C2)  // 0xC9C1
        bf16(0x5408, 0x8B48, 0x89C6)  // 0x9FD5
        bf16(0x14C0, 0xF93E, 0x8E76)  // 0xCE8F
        bf16(0x51C0, 0x06CA, 0x82DC)  // 0x1917
        // an exact cancellation gives +0, and a finite product plus an infinity is that infinity
        f16(0x3C00, 0x3C00, 0xBC00)  // 1 * 1 - 1 = +0
        f16(0x3C00, 0x3C00, 0xFC00)  // -inf
        return(0)
