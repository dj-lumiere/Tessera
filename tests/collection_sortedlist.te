# SortedList[S64] against a model. An LCG drives random push / rank / has / remove / get in three phases (small,
# growing to thousands of elements, then shrinking to empty so borrows and merges run). Every 500
# operations a checkpoint prints the length, a running checksum of every result, and a hash of the iteration
# sequence. Then eq.
# The expected output comes from an independent Python model of the collection.

import Standard/Collections
import Standard/Os

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[ConsoleOutput]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: U64
    ### How many operations the phase runs.
    ops: U64
    ### The weight of push among the operations.
    pushes: U64
    ### The weight of reading by rank.
    ranks: U64
    ### The weight of the has check.
    contains: U64
    ### The weight of remove.
    removes: U64

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: U64
    ### The operations run so far in the phase.
    op: U64
    ### The checksum of every result so far.
    results: S64

### Makes a `Harness` from its fields.
### :param out: Its `out`.
### :param rng: Its `rng`.
### :returns: The new value.
common routine Harness.construct(out: @BufWriter[ConsoleOutput], rng: @Rng) -> Me
    return Me(out, rng)

### Releases nothing: a `Harness` holds no memory of its own.
routine @Harness.destruct() -> None
    return

routine @Rng.below(bound: U64) -> U64
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: U64 = bucket.to[U64]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: @[Byte], value: S64) -> None
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

# Folds every element in iteration order.
routine iteration_hash(list: @SortedList[S64]) -> S64
    local iter_val: SortedListIter[S64] = .construct(list)
    local iter: @SortedListIter[S64] <- iter_val

    while true with hash: S64 = 0
        item: Maybe[S64] = try iter.emit()
        when item
            is S64 as value => continue with hash: mix(hash, value)
            is None => return hash

routine checkpoint(out: @BufWriter[ConsoleOutput], list: @SortedList[S64], at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: U64 = list.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(list))
    out.write("\n")
    return

# Runs ops random operations. An operation kind is drawn below 10: below pushes it's a push, below ranks a rank,
# below contains a has (both of a random value), below removes a remove at a random index, otherwise a get.
# Values are below 1000, so duplicates are common. Remove and get on an empty list record -1. Returns the updated
# results checksum.
@reshaping(list)
routine run_phase(harness: Harness, list: @SortedList[S64], phase: Phase, results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: U64 = phase.ops
    local pushes: U64 = phase.pushes
    local ranks: U64 = phase.ranks
    local contains: U64 = phase.contains
    local removes: U64 = phase.removes

    while op < ops with op: U64 = 0, checksum: S64 = results
        kind: U64 = rng.below(10)
        is_push: Bool = kind < pushes
        is_rank: Bool = kind < ranks
        is_contains: Bool = kind < contains
        empty: Bool = list.is_empty()
        result: S64 = when
            is_push =>
                value: S64 = rng.below(1000).to[S64]()
                list.add(value)
                becomes value
            is_rank =>
                value: S64 = rng.below(1000).to[S64]()
                rank: U64 = list.rank(value)
                becomes rank.to[S64]()
            is_contains =>
                value: S64 = rng.below(1000).to[S64]()
                found: Bool = list.has(value)
                becomes found.to[S64]()
            empty => -1
            else =>
                index: U64 = rng.below(list.count())
                if kind < removes
                    becomes list.remove(index)
                else
                    becomes list[index]
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: U64 = op + 1
        if op_next % 500 == 0
            checkpoint(out: harness.out, list,
                at: Checkpoint(phase: phase.number, op: op_next, results: mixed))
        continue with op: op_next, checksum: mixed
    then
        return checksum

# Pushes every element of from onto to, in iteration order.
@reshaping(to)
routine copy_all(from: @SortedList[S64], to: @SortedList[S64]) -> None
    local iter_val: SortedListIter[S64] = .construct(from)
    local iter: @SortedListIter[S64] <- iter_val

    while true
        item: Maybe[S64] = try iter.emit()
        value: S64 = when item
            is S64 as value => value
            is None => return
        to.add(value)

routine report_eq(out: @BufWriter[ConsoleOutput], label: @[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    local out: @BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    local alloc: @MemoryManager <- HEAP.peek()
    local rng: @Rng <- Rng(state: 1)
    local list: @SortedList[S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, list,
        phase: Phase(number: 1, ops: 3000, pushes: 4, ranks: 5, contains: 6, removes: 8),
        results: 0)
    r2: S64 = run_phase(harness, list,
        phase: Phase(number: 2, ops: 10000, pushes: 5, ranks: 6, contains: 7, removes: 8),
        results: r1)

    local copied: @SortedList[S64] <- .construct(alloc)
    report_eq(out, label: "empty copy equal", equal: list.eq(copied))
    copy_all(from: list, to: copied)
    report_eq(out, label: "copy equal", equal: list.eq(copied))
    size: U64 = list.count()
    middle: U64 = size // 2
    old: S64 = copied.remove(middle)
    report_eq(out, label: "removed element equal", equal: list.eq(copied))
    copied.add(old)
    report_eq(out, label: "restored element equal", equal: list.eq(copied))
    copied.add(0)
    report_eq(out, label: "extra element equal", equal: list.eq(copied))
    drop copied

    r3: S64 = run_phase(harness, list,
        phase: Phase(number: 3, ops: 19000, pushes: 1, ranks: 2, contains: 3, removes: 9),
        results: r2)
    drop list
    out.flush()
    return
