# A name that is no member of the choice is a build error that lists its members.
import Hosted

### The order of a memory operation.
choice Order: U8
    ### No order.
    RELAXED
    ### Later reads stay after.
    ACQUIRE

### The rank of O.
### :typeparam O: The order.
### :returns: 0 or 1.
routine rank[O]() -> U64
needs Order O
    when O
        Order.RELAXED => return 0
        Order.ACQUIRE => return 1

### Runs.
routine start() -> None
    Console.show("{rank[RELEASE]()}")
    return
