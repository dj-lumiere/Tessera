# An emitter made outside a loop and walked to its end by an each inside it is empty on every later pass: a build error.

import Collections
import Hosted

routine start() -> None
    points: &List[S64] <- .construct(HEAP)
    points.add_last(1)
    points.add_last(5)
    point_emitter: &ListEmitter[S64] <- points.emitter()
    each query in 0 til 3
        each point in point_emitter
            if point > query
                Console.show(point)
    return
