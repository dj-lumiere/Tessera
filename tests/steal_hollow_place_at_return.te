# A routine that leaves a place it reached through a parameter hollow (steal with nothing put back) doesn't build:
# the caller would find no value there after the call.

import Collections
import Hosted

### Merges the smaller of `sets[a]` and `sets[1]` into the larger, keeping the larger value of a key both hold.
### `sets[a]` ends up with the result and `sets[1]` empty.
### :param sets: The dicts, two of which are merged.
### :param a: The position of the dict that keeps the result.
@reshaping(sets)
routine merge_set(sets: @List[Dict[S32, S32]], a: U64) -> None
    if sets.getslot(a).count() < sets.getslot(1).count()
        sets.swap(first: a, second: 1)
    adding: &Dict[S32, S32] <- steal sets.getslot(1)
    result: @Dict[S32, S32] = sets.getslot(a)
    pairs: &DictEmitter[S32, S32] <- adding.emitter()

    for pair in pairs
        old: Optional[S32] = try result.getitem(pair.key)
        when old
            is S32 as value => result.setitem(key: pair.key, value: value.max(pair.value))
            is None => result.setitem(key: pair.key, value: pair.value)
    then
        drop adding
        return

### Merges two dicts, then one dict with itself.
routine start() -> None
    sets: &List[Dict[S32, S32]] <- .construct(HEAP)
    first: &Dict[S32, S32] <- .construct(HEAP)
    second: &Dict[S32, S32] <- .construct(HEAP)

    first.setitem(key: 1, value: 10)
    first.setitem(key: 2, value: 20)
    second.setitem(key: 2, value: 25)
    second.setitem(key: 3, value: 30)
    second.setitem(key: 4, value: 40)
    sets.add_last(steal first)
    sets.add_last(steal second)
    merge_set(sets, a: 0)
    Console.show("merged: {sets.getslot(0)}, emptied: {sets.getslot(1)}")
    drop sets
    return
