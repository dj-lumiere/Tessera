# A routine that leaves a place it reached through a parameter hollow (steal with nothing put back) doesn't build:
# the caller would find no value there after the call.

import Standard/Collections
import Standard/Format
import Standard/Os

### Merges the smaller of `sets[a]` and `sets[b]` into the larger, keeping the larger value of a key both hold.
### `sets[a]` ends up with the result and `sets[b]` empty.
### :param sets: The dicts, two of which are merged.
### :param a: The position of the dict that keeps the result.
### :param b: The position of the dict that ends up empty.
@reshaping(sets)
routine merge_set(sets: @List[Dict[S32, S32]], a: USize, b: USize) -> None
    if sets.getslot(a).count() < sets.getslot(b).count()
        sets.swap(first: a, second: b)
    local adding: @Dict[S32, S32] <- steal sets.getslot(b)
    result: @Dict[S32, S32] = sets.getslot(a)
    local pairs: @DictIter[S32, S32] <- .construct(adding)

    each pair in pairs
        old: Maybe[S32] = result.getitem_checked(pair.key)
        when old
            is S32 as value => result.setitem(key: pair.key, value: value.max(pair.value))
            is None => result.setitem(key: pair.key, value: pair.value)
    then
        drop adding
        return

### Merges two dicts, then one dict with itself.
routine start() -> None
    local sets: @List[Dict[S32, S32]] <- .construct()
    local first: @Dict[S32, S32] <- .construct()
    local second: @Dict[S32, S32] <- .construct()

    first.setitem(key: 1, value: 10)
    first.setitem(key: 2, value: 20)
    second.setitem(key: 2, value: 25)
    second.setitem(key: 3, value: 30)
    second.setitem(key: 4, value: 40)
    sets.add_last(steal first)
    sets.add_last(steal second)
    merge_set(sets, a: 0, b: 1)
    Out.write("merged: {sets.getslot(0)}, emptied: {sets.getslot(1)}\n")
    merge_set(sets, a: 0, b: 0)
    Out.write("same place: {sets.getslot(0)}\n")
    drop sets
    return
