# A field of the value a &T holds is a place through its view: p.value is p.getview().value.

import Hosted

### A box.
entity Box
    value: S64

### Makes a box.
### :param value: The value to hold.
### :returns: The box.
common routine Box.construct(value: S64) -> Me
    return Me(value)

### Writes and reads a field through a STACK place and a HEAP place.
routine start() -> None
    here: &Box <- Box.construct(value: 1)
    here.value.poke(here.value.peek() + 1)
    there: &Box <- Box.construct(value: 8) from HEAP
    there.value.poke(9)
    Console.show("{here.value.peek()} {there.value.peek()}")
    drop there
    return
