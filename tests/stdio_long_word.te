# Console.ask[T]() reads a word longer than the 8192-byte input buffer: a valid number can be any length (a float with
# thousands of digits, an integer with a long run of leading zeros). A word that fits is read in place in the buffer.
# A longer one is copied into memory from the default heap, converted, and given back. Standard input holds
# 10000-zero runs: "0...01.5", "2.50...0", "0...042", "0...07x", "10...0e-10000", and "9".

import Standard/Os

routine start() -> None
    a: B64 = Console.ask[B64]()
    b: B64 = Console.ask[B64]()
    c: S32 = Console.ask[S32]()
    Console.show("{a} {b} {c}")
    bad: Result[S32, ParseError] = Console.ask_result[S32]()
    Console.show("a long word that isn't an S32: {bad.is_failure()}")
    one: Maybe[B64] = Console.ask_checked[B64]()
    Console.show("{one.diagnose()}")
    last: S64 = Console.ask[S64]()
    Console.show("then a short one: {last}")
    return
