# Items[T, COUNT] is a record of COUNT values, Slots[T, COUNT] an entity with the same [COUNT x T] layout that takes
# any T. A literal is an Items when its elements hold nothing to give back and a Slots when they are entities, so the
# two of(values:) overloads of a collection take each. to[@[T]]() is the view of every element.

import Collections
import Hosted

### A counter that says when it ends.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Counter(n: n)

### Says it ends.
routine @Counter.destruct() -> None
    Console.show("end {me.n.peek()}")
    return

### Adds the values a view shows.
### :param values: The values.
### :returns: Their sum.
routine total(values: @[S64]) -> S64
    each i: U64 in 0 til values.count() with sum: S64 = 0
        continue with sum: sum + values.getitem(i)
    then
        return sum

routine start() -> None
    primes: Items[S64, 4] = [2, 3, 5, 7]
    copy: Items[S64, 4] = primes
    Console.show("{primes} {copy.getitem(3)} {sizeof[Items[S64, 4]]()}")
    place: &Items[S64, 4] <- primes
    Console.show("total {total(place.to[@[S64]]())}, first {place.to[@[S64]]().to[@S64]().peek()}")
    Console.show("same view {place.getview().count()} {place.to[@[S64]]().count()}")

    counters: &Slots[Counter, 2] <- [Counter.construct(n: 1), Counter.construct(n: 2)]
    Console.show("slots {sizeof[Slots[Counter, 2]]()}, second {counters.getslot(1).n.peek()}")
    counters.swap(0, 1)
    Console.show("swapped {counters.to[@[Counter]]().getslot(0).n.peek()}")

    numbers: &List[S64] <- List[S64].of(values: [4, 5, 6], manager: HEAP)
    owned: &List[Counter] <- List[Counter].of(values: [Counter.construct(n: 10), Counter.construct(n: 20)], manager: HEAP)
    Console.show("lists {numbers} {owned.count()} {owned.getslot(1).n.peek()}")
    drop owned
    Console.show("done")
    return
