# compare_exchange's failure order can't be stronger than its success order: ACQUIRE with SEQ_CST is a build error.

import Hosted

routine start() -> None
    n: &U32 <- 5
    found: &U32 <- 0
    swapped: Bool = n.getview().compare_exchange_weak_unbroken_raw[ACQUIRE, SEQ_CST](expected: 5,
        new: 6, previous: found)
    Console.show("{swapped}")
    return
