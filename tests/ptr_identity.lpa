# === and !== compare two addresses, == and != compare values: two slots holding 7 are equal values at different addresses.

import Hosted

routine start() -> None
    out: @ConsoleOutput = Console.output()
    a: &S64 <- 7
    b: &S64 <- 7
    same_slot: @S64 = a
    out.write("{a === same_slot} {a === b} {a !== b} {a.load() == b.load()}\n")
    if a !== b and not (a === b)
        out.write("different slots\n")
    return
