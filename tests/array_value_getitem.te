# getitem reads an array value directly, a literal included: the index is a runtime value, and the read is bounds
# checked like the pointer form.

import Hosted

### The element at `i` of a table written as a literal.
### :param i: The index, below 5.
### :returns: The element at `i`.
routine table(i: U64) -> U64
    table: Array[U64, 5] = [2, 10, 16, 36, 64]
    value: U64 = table[i]
    return value

routine start() -> None
    each i: U64 in 0 til 5
        Console.show("{table(i)}")
    a: Array[S64, 3] = [-1, 0, 1]
    Console.show("{a.getitem(2)}")
    return
