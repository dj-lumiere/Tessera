# Declaring add is not enough for +: the type has to obey Addable.

routine start() -> None
    near: Meters = Meters(value: 3) + Meters(value: 4)
    return

### A distance in meters.
record Meters
    value: S64

### The sum of two distances.
### :param other: The distance to add.
### :returns: The total.
routine Meters.add(other: Me) -> Me
    return Meters(value: me.value + other.value)
