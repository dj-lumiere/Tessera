// F16's sin_pi, cos_pi, tan_pi and exp10: CORE-MATH ports, correctly rounded, so the same bits on every target.
// Each line is an input and the four results, as bits. The expected values come from mpmath (the exact value,
// rounded to F16 to nearest, ties to even): signed zeros and infinities, NaNs, integers, half-integers and
// quarters (exact, with the sign rules of IEEE 754 sinPi, cosPi and tanPi), subnormals, huge arguments, the
// thresholds of the code, the arguments it lists, inputs that reach its accurate phases, and ordinary ones.

import Standard::Format
import Standard::Os

preset INPUTS: @Array<U16, 71> <- { 0x0000, 0x8000, 0x7C00, 0xFC00, 0x7E00, 0xFE01, 0x7D01, 0x3C00,
    0xBC00, 0x4000, 0xC000, 0x4200, 0xC200, 0x3800, 0xB800, 0x3E00, 0xBE00, 0x4100, 0xC100, 0x3400,
    0xB400, 0x3A00, 0xBA00, 0x3D00, 0xBD00, 0x5FFE, 0xDFFE, 0x6001, 0xE001, 0x63FE, 0xE3FE, 0x6400,
    0xE400, 0x67FF, 0xE7FF, 0x6800, 0xE800, 0x7BFF, 0xFBFF, 0x3BF7, 0xBBF7, 0x0001, 0x8001, 0x03FF,
    0x0400, 0x1F34, 0x1F35, 0x2E66, 0xAE66, 0x3555, 0xB555, 0x399A, 0xB99A, 0x4248, 0xC248, 0x5645,
    0xD645, 0x211F, 0xA11F, 0x4400, 0xC400, 0x44CF, 0xC4CF, 0x44D2, 0xC4D2, 0x4500, 0xC500, 0x4700,
    0xC700, 0x4800, 0xC800 }

routine hex(out: @Out, v: U16) -> Void
    block entry()
        out.write(" 0x")
        v.to<U64>().represent_hex_into(out, 4)
        return()

routine main() -> S32
    shared out : @Out = Out.writer()

    block entry()
        jump each(0)

    block each(i: USize)
        done : Bool = i.eq(71)
        branch done
            ? return(0)
            : continue
        u : U16 = INPUTS.getitem(i)
        x : F16 = .from_bits(u)
        out.write("0x")
        u.to<U64>().represent_hex_into(out, 4)
        hex(out, x.sin_pi().bits())
        hex(out, x.cos_pi().bits())
        hex(out, x.tan_pi().bits())
        hex(out, x.exp10().bits())
        out.write("\n")
        jump each(i.add(1))
