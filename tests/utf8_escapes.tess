// \xXX is one byte as it is, \uXXXXXX a character in UTF-8, so "\u01F600" and "\xF0\x9F\x98\x80" are the same four
// bytes. Span[Byte].is_utf8 rejects malformed sequences (overlong forms and surrogates included), chars() reads each as
// U+FFFD, is_char_boundary finds where characters start, and diagnose writes bytes that read back the same.

import Standard/Format
import Standard/Os

routine count_chars(text: Span[Byte]) -> USize
    local iter: @BytesCharsIter <- text.chars()

    while true with count: USize = 0
        c: Maybe[Char] = iter.emit_checked()
        when c
            is Char as char => continue with count: count + 1
            is None => return count

routine start() -> None
    emoji: Span[Byte] = "😀"
    raw: Span[Byte] = "\xF0\x9F\x98\x80"
    Out.write("same: {emoji.eq(raw)} {emoji.count()} {raw.count()} {count_chars(raw)}\n")
    e_char: Span[Byte] = "é"
    e_byte: Span[Byte] = "\xE9"
    Out.write("e: {e_char.count()} {e_char.is_utf8()} {e_byte.count()} {e_byte.is_utf8()}\n")
    c: Char = '\u0000E9'
    b: Byte = b'\xE9'
    Out.write("literals: {c.to[U32]()} {b.to[U8]()}\n")
    hangul: Span[Byte] = "안녕"
    overlong: Span[Byte] = "\xC0\x80"
    surrogate: Span[Byte] = "\xED\xA0\x80"
    truncated: Span[Byte] = "\xE2\x82"
    too_big: Span[Byte] = "\xF4\x90\x80\x80"
    Out.write("is_utf8: {hangul.is_utf8()} {overlong.is_utf8()} {surrogate.is_utf8()} {truncated.is_utf8()} {too_big.is_utf8()}\n")
    Out.write("chars: {count_chars(hangul)} {count_chars(overlong)} {count_chars(surrogate)}\n")
    mixed: Span[Byte] = "a안"
    Out.write("boundary: {mixed.is_char_boundary(0)} {mixed.is_char_boundary(1)} {mixed.is_char_boundary(2)} {mixed.is_char_boundary(3)} {mixed.is_char_boundary(4)} {mixed.is_char_boundary(5)}\n")
    odd: Span[Byte] = "a\xFF안"
    ctl: Char = '\u000001'
    out: @Out = Out.writer()
    odd.diagnose_into(out)
    write_str(out, text: " ")
    ctl.diagnose_into(out)
    write_line(out)
    return
