// \xXX is one byte as it is, \uXXXXXX a character in UTF-8, so "\u01F600" and "\xF0\x9F\x98\x80" are the same four
// bytes. Bytes.is_utf8 rejects malformed sequences (overlong forms and surrogates included), chars() reads each as
// U+FFFD, is_char_boundary finds where characters start, and diagnose writes bytes that read back the same.

import Standard::Format
import Standard::Os

routine count_chars(%text: Bytes) -> USize
    block entry():
        %iter_val : BytesCharsIter = %text.chars()
        claim %iter : @BytesCharsIter
        %iter.store(%iter_val)
        jump next(%iter, 0)

    block next(%iter: @BytesCharsIter, %count: USize):
        %c : Option<Char> = %iter.next()
        when %c:
            .Present(%char) -> next(%iter, %count.add(1))
            .Absent         -> return(%count)

routine main() -> S32
    block entry():
        %emoji : Bytes = "\u01F600"
        %raw   : Bytes = "\xF0\x9F\x98\x80"
        print("same: {%emoji.eq(%raw)} {%emoji.length()} {%raw.length()} {count_chars(%raw)}\n")
        %e_char : Bytes = "\u0000E9"
        %e_byte : Bytes = "\xE9"
        print("e: {%e_char.length()} {%e_char.is_utf8()} {%e_byte.length()} {%e_byte.is_utf8()}\n")
        %c : Char = '\u0000E9'
        %b : Byte = b'\xE9'
        print("literals: {%c.to_u32()} {%b.to_u8()}\n")
        %hangul    : Bytes = "안녕"
        %overlong  : Bytes = "\xC0\x80"
        %surrogate : Bytes = "\xED\xA0\x80"
        %truncated : Bytes = "\xE2\x82"
        %too_big   : Bytes = "\xF4\x90\x80\x80"
        print("is_utf8: {%hangul.is_utf8()} {%overlong.is_utf8()} {%surrogate.is_utf8()} {%truncated.is_utf8()} {%too_big.is_utf8()}\n")
        print("chars: {count_chars(%hangul)} {count_chars(%overlong)} {count_chars(%surrogate)}\n")
        %mixed : Bytes = "a안"
        print("boundary: {%mixed.is_char_boundary(0)} {%mixed.is_char_boundary(1)} {%mixed.is_char_boundary(2)} {%mixed.is_char_boundary(3)} {%mixed.is_char_boundary(4)} {%mixed.is_char_boundary(5)}\n")
        %odd     : Bytes    = "a\xFF안\x01"
        %ctl     : Char     = '\u000001'
        %out_val : FdWriter = .stdout()
        claim %out : @FdWriter
        %out.store(%out_val)
        %odd.diagnose(%out)
        write_str(%out, " ")
        %ctl.diagnose(%out)
        write_line(%out)
        return(0)
