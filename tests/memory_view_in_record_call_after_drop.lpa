# A record built by a call with a view among its arguments holds that view's source: using it after the source is given
# back is a build error.

import Hosted

### A view and a number.
record Pair
    a: @S64
    b: S64

### Builds a pair with a view, then reads it after the view's memory is given back.
routine start() -> None
    x: &S64 <- 5 from HEAP
    p: Pair = Pair(a: x.getview(), b: 1)
    drop x
    Console.show("{p.a.peek()}")
    return
