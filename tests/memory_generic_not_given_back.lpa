# A generic routine takes memory over and never gives it back.

import Hosted

### Takes `x` over.
### :param x: The value.
routine keep[T](x: T) -> None
    return

routine start() -> None
    m: &[S64] <- [1] * 4 from HEAP

    keep[BorrowedSlice[S64]](x: steal m)
    Console.show("done")
    return
