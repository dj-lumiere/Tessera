# A preset may compute an infinity or NaN with the unchecked operators, which give the raw IEEE 754 value.

import Hosted

preset HUGE: B64 = 1.0e308 *! 10.0
preset NOTHING: B32 = B32.sub_unchecked(inf, inf)
preset THIRD: B64 = 1.0 / 3.0

routine start() -> None
    Console.show("{HUGE} {NOTHING} {THIRD}")
    return
