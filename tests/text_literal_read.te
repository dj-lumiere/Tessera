# A text literal is a place whose memory is never given back: it is read, viewed in parts, handed to routines that
# read, kept in a global and in an entity, and copied into a place to be changed.

import Hosted

global GREETING: &@[Byte] <- "hello"

### Text kept for later.
entity Note
    text: @[Byte]

### A note.
### :param text: Its text.
### :returns: The note.
common routine Note.construct(text: @[Byte]) -> Me
    return Me(text)

### The number of bytes `text` has.
### :param text: Some text.
### :returns: Its count.
routine length(text: @[Byte]) -> U64
    return text.count()

routine start() -> None
    s: @[Byte] = "hello, world"
    head: @[Byte] = s.getslice(start: 0, count: 5)
    Console.show(head)
    Console.show(length("four"))
    Console.show(GREETING.peek())
    GREETING.poke("bye")
    Console.show(GREETING.peek())
    note: &Note <- Note.construct(text: "kept")
    note.text.poke("changed")
    Console.show(note.text.peek())
    copy: &[Byte] <- "jello"
    copy.getslot(0).poke(b'h')
    Console.show(copy.getslice(start: 0, count: 5))
    return
