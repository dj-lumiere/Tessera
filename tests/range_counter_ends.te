# A range that ends at the top of its type walks its last value and stops there: the index is compared with the end
# before it steps, so it never wraps. `continue` and `break` inside go on to the next index and leave the loop.

import Hosted

### Counts the rounds of ranges that end at their type's largest value.
routine start() -> None
    count: &U64 <- 0
    each i: U8 in 250 to U8.MAX
        (count.load() + 1).store_into(count)
    Console.show("U8 250 to MAX: {count.load()}")
    0.store_into(count)
    each k: S64 in S64.MAX - 2 to S64.MAX
        if k == S64.MAX - 1
            continue
        (count.load() + 1).store_into(count)
    Console.show("S64 MAX-2 to MAX, one skipped: {count.load()}")
    0.store_into(count)
    each m: U64 in U64.MAX - 9 til U64.MAX
        if m == U64.MAX - 5
            break
        (count.load() + 1).store_into(count)
    Console.show("U64 til MAX, stopped at MAX-5: {count.load()}")
    return
