# A bare { ... } literal takes its type from where the value goes: a preset, a global, a typed binding,
# a nested element, a record binding, a routine argument, or the pointer a literal receiver is stored into.

import Hosted

global ORIGIN: &Items[S64, 2] <- [10, 20]

preset SORTED: &Items[S64, 5] <- [-8, -3, 0, 2, 7]
preset GRID: &Items[Items[S16, 2], 2] <- [[1, 2], [3, 4]]

record Point
    x: S64
    y: S64

routine sum2(a: Items[S64, 2]) -> S64
    slot: &Items[S64, 2] <- a

    return slot[0] + slot[1]

routine start() -> None
    Console.show("{SORTED.getitem(0)} {SORTED.getitem(4)}")
    row: &Items[S16, 2] <- GRID.getitem(1)
    Console.show("{row.getitem(0).to[S64]()}")
    Console.show("{ORIGIN.getitem(1)}")

    x: S64 = 5
    pair: Items[S64, 2] = [x, 6]
    Console.show("{sum2(pair)}")
    Console.show("{sum2([7, 8])}")

    slot: &Items[S64, 2] <- [3, 4]
    Console.show("{slot.getitem(1)}")

    p: Point = (x: 1, y: x)
    Console.show("{p.x} {p.y}")
    return
