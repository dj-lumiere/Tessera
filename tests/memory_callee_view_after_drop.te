# A pointer a routine gave back from memory, used after the memory is given back.
import Standard/Os

### The first byte's slot.
### :param m: The memory.
### :returns: The slot.
routine first(m: @BorrowedSlice[Byte]) -> @Byte
    return m.getslot(0)

routine start() -> None
    m: &[Byte] <- [b'h'] * 8 from HEAP

    b: @Byte = first(m: m)
    drop m
    Console.show("{b.peek().to[U8]()}")
    return
