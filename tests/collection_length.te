# count and is_empty on every collection, before and after adding one element. @[Byte].count counts bytes.

import Standard/Collections
import Standard/Hosted

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

routine report(name: @Byte, was_empty: Bool, count: U64, now_empty: Bool) -> None
    c_printf("%s %d %llu %d\n", name, was_empty.to[S32](), count, now_empty.to[S32]())
    return

routine start() -> None
    manager: @MemoryManager = HEAP
    hs: &Set[S64] <- .construct(manager)

    hs_was: Bool = hs.is_empty()
    hs.add(7)
    report(name: "Set", was_empty: hs_was, count: hs.count(), now_empty: hs.is_empty())
    drop hs

    hm: &Dict[S64, S64] <- .construct(manager)
    hm_was: Bool = hm.is_empty()
    hm[1] = 2
    report(name: "Dict", was_empty: hm_was, count: hm.count(), now_empty: hm.is_empty())
    drop hm

    bs: &SortedSet[S64] <- .construct(manager)
    bs_was: Bool = bs.is_empty()
    bs.add(3)
    report(name: "SortedSet", was_empty: bs_was, count: bs.count(), now_empty: bs.is_empty())
    drop bs

    bl: &SortedList[S64] <- .construct(manager)
    bl_was: Bool = bl.is_empty()
    bl.add(4)
    report(name: "SortedList", was_empty: bl_was, count: bl.count(), now_empty: bl.is_empty())
    drop bl

    bm: &SortedDict[S64, S64] <- .construct(manager)
    bm_was: Bool = bm.is_empty()
    bm[5] = 6
    report(name: "SortedDict", was_empty: bm_was, count: bm.count(), now_empty: bm.is_empty())
    drop bm

    text_val: @[Byte] = "한글"
    c_printf("String %llu %d\n", text_val.count(), text_val.is_empty().to[S32]())
    return
