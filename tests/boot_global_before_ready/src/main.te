global COUNT: @U32 <- 1

### Halts on a crash: there's nowhere to print.
@untraced
routine halt(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    while true
        pass

routine when_power_on() -> None
    COUNT.poke(2)
    prepare_core()
    return

routine start() -> None
    Crash.report_with(halt.to[Callable]())
    return
