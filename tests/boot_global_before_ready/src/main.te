import Standard/Boot

global COUNT: @U32 <- 1

### Halts on a crash: there's nowhere to print.
@export("tessera_crash_handler")
@noreturn
routine halt(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    while true
        pass

routine when_booted() -> None
    COUNT.poke(2)
    prepare_core()
    return

routine start() -> None
    return
