# A view whose place may be given back can't be kept in a global, which every routine reaches.

import Hosted

### The view kept.
global KEPT: &(@S64?)

### Keeps `v` in KEPT.
### :param v: The view.
routine keep(v: @S64) -> None
    KEPT.poke(v)
    return

### Hands keep a view of memory it gives back.
routine start() -> None
    x: &S64 <- 5 from HEAP
    keep(v: x)
    drop x
    return
