// Span[T].getitem checks the index against the count: one past the end crashes with IndexOutOfBoundsError at the
// caller's line (getitem is #track_caller), after what came before reached stdout.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> Void

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    Out.write("{name}: {message}\nat line {place.line.peek()}\n")
    exit(3)

routine start() -> Void
    local digits: @Array[U32, 3] <- [1, 2, 3]
    view: Span[U32] = digits.getview()
    Out.write("last: {view.getitem(2)}\n")
    past: U32 = view[3]
    Out.write("not reached {past}\n")
    return
