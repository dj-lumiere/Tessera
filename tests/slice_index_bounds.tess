// Slice<T>.getitem checks the index against the count: one past the end crashes with IndexOutOfBoundsError at the
// caller's line (getitem is #track_caller), after what came before reached stdout.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    block entry()
        claim digits : @Array<U32, 3> <- { 1, 2, 3 }
        view : Slice<U32> = digits.to<Slice<U32>>()
        Out.write("last: {view.getitem(2)}\n")
        past : U32 = view.getitem(3)
        Out.write("not reached {past}\n")
        return(0)
