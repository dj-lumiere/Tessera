// App imports Lib and declares its own describe and Point: a module's own names come before its imports, and the
// imported ones stay reachable by path.

module App

import Lib
import Standard::Format

record Point
    x : S64
    y : S64

routine describe() -> S64
    block entry():
        return(2)

routine main() -> S32
    block entry():
        %own : Point      = Point { x: 3, y: 4 }
        %lib : Lib::Point = origin()
        print("describe {describe()}, Lib::describe {Lib::describe()}\n")
        print("App Point {%own.x},{%own.y}, Lib Point {%lib.x}\n")
        return(0)
