// App imports Lib and declares its own describe and Point: a module's own names come before its imports, and the
// imported ones stay reachable by path.

module App

import Lib
import Standard/Format
import Standard/Os

record Point
    x: S64
    y: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine describe() -> S64
    return(2)

routine start() -> Void
    own: Point = Point(x: 3, y: 4)
    lib: Lib/Point = origin()
    Out.write("describe {describe()}, Lib::describe {Lib/describe()}\n")
    Out.write("App Point {own.x},{own.y}, Lib Point {lib.x}\n")
    return()
