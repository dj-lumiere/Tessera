// MultiReadLock: four threads read a pair of counters that must always be equal while two threads write them, each
// reader under lock_read and each writer under lock_write. No reader ever sees them differ, and the writers' updates
// all land. try_lock_write fails while a reader holds the lock, and try_lock_read while a writer does.

import Standard/Format
import Standard/Os

record Pair
    lock: MultiReadLock
    a: U64
    b: U64
    torn: Atomic[U64]

routine read_many(pair: @Pair) -> Void
    each i in 0 til 20000
        pair.lock.lock_read()
        same: Bool = pair.a.peek() == pair.b.peek()
        pair.lock.unlock_read()
        if not same
            pair.torn.fetch_add(1)
    then
        return

routine write_many(pair: @Pair) -> Void
    each i in 0 til 10000
        pair.lock.lock_write()
        pair.a.poke(pair.a.peek() + 1)
        pair.b.poke(pair.b.peek() + 1)
        pair.lock.unlock_write()
    then
        return

routine start() -> Void
    local pair: @Pair <- Pair(lock: .construct(), a: 0, b: 0, torn: Atomic[U64](value: 0))
    local threads: @Array[Thread[Void], 6] <- .hollow()

    each i in 0 til 6
        t: Thread[Void] = get_thread[Void]()
        if i < 4
            t.put_work(entry: read_many.to[Callable](), args: pair)
            threads[i] = t
        else
            t.put_work(entry: write_many.to[Callable](), args: pair)
            threads[i] = t

    each i in 0 til 6
        t: Thread[Void] = threads[i]
        t.wait_finished()
        t.give_back()
    Out.write("a {pair.a.peek()}, b {pair.b.peek()}, torn reads {pair.torn.peek()}\n")
    pair.lock.lock_read()
    write_while_read: Bool = pair.lock.try_lock_write()
    pair.lock.unlock_read()
    pair.lock.lock_write()
    read_while_written: Bool = pair.lock.try_lock_read()
    pair.lock.unlock_write()
    Out.write("try_lock_write while read: {write_while_read}, try_lock_read while written: {read_while_written}\n")
    return
