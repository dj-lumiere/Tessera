// A program replaces the default panic handler by exporting its own under the handler's name. This one reports the
// code on stdout and exits with status 3 instead of 101.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

@[external("c"), symbol("exit"), noreturn]
routine exit(%status: CInt) -> Void

@[export("tessera_panic_handler"), noreturn]
routine on_panic(%code: TrapCode, %message: String) -> Void
    block entry():
        print("panicked: {%code.description()} [{%message}]\n")
        exit(3)

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %empty : List<S64> = .construct(%alloc)
        claim %list : Ptr<List<S64>>
        %list.store(%empty)
        print("before\n")
        %missing : S64 = %list.pop()
        print("not reached\n")
        return(0)
