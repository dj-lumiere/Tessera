// A program replaces the default panic handler by exporting its own under the handler's name. This one reports the
// name and message on stdout and exits with status 3 instead of 101.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_panic_handler"), noreturn]
routine on_panic(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("panicked: {name}: {message}\n")
        exit(3)

routine main() -> S32
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()
        claim list  : @List<S64> <- .construct(alloc)
        Out.write("before\n")
        missing : S64 = list.pop()
        Out.write("not reached\n")
        return(0)
