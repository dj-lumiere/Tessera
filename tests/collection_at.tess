// at gives the address of an element, checked like get (a crash past the end or for a missing key), and at_checked
// returns Absent instead: a place to read or update in place. Array, List, and CircularList take an index. Dict and
// SortedDict take a key and give the value's address only, since changing a key in place would lose it.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine start() -> Void
    shared ring : @CircularList<S64> <- uninit

    block entry()
        heap : Allocator = make_heap_allocator()
        claim alloc : @Allocator <- heap

        claim arr : @Array<S64, 3> <- uninit
        arr.zeroinit(1)
        arr.at(1).store(5)
        Out.write("Array {arr.getitem(0)} {arr.getitem(1)}\n")

        claim list : @List<S64> <- .construct(alloc)
        list.push(10)
        list.push(20)
        list.push(30)
        slot : @S64 = list.at(1)
        slot.store(slot.load().add(5))
        past : Option<@S64> = list.at_checked(3)
        Out.write("List {list.getitem(1)} {past.is_absent()}\n")
        list.destruct()

        ring.store(.construct(alloc))
        ring.push_back(1)
        ring.push_back(2)
        ring.push_front(0)
        third : @S64 = ring.at(2)
        third.store(9)
        front : Option<@S64> = ring.at_checked(0)
        when front
            .Present(p) -> continue
            .Absent     -> unreachable
        Out.write("CircularList {p.load()} {ring.getitem(2)}\n")

        claim dict : @Dict<S64, S64> <- .construct(alloc)
        dict.put(7, 1)
        count : @S64 = dict.at(7)
        count.store(count.load().add(1))
        count.store(count.load().add(1))
        missing : Option<@S64> = dict.at_checked(8)
        Out.write("Dict {dict.getitem(7)} {missing.is_absent()}\n")

        claim sorted : @SortedDict<S64, S64> <- .construct(alloc)
        sorted.put(3, 30)
        sorted.put(1, 10)
        sorted.put(2, 20)
        two : @S64 = sorted.at(2)
        two.store(two.load().mul(2))
        none : Option<@S64> = sorted.at_checked(4)
        Out.write("SortedDict {sorted.getitem(2)} {none.is_absent()}\n")

        ring.destruct()
        dict.destruct()
        sorted.destruct()
        return()
