// at gives the address of an element, checked like get (a crash past the end or for a missing key), and at_checked
// returns Absent instead: a place to read or update in place. Array, List, and CircularList take an index. Dict and
// SortedDict take a key and give the value's address only, since changing a key in place would lose it.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> Void
    local ring: @CircularList[S64] <- .hollow()

    block entry()
        heap: MemoryManager = make_heap_memory()
        claim alloc: @MemoryManager <- heap

        claim arr: @Array[S64, 3] <- .hollow()
        arr.zeroinit(1)
        arr.getslot(1).poke(5)
        Out.write("Array {arr.getitem(0)} {arr.getitem(1)}\n")

        claim list: @List[S64] <- .construct(alloc)
        list.add_last(10)
        list.add_last(20)
        list.add_last(30)
        slot: @S64 = list.getslot(1)
        slot.poke(slot.peek().add(5))
        past: Option[@S64] = list.getslot_checked(3)
        Out.write("List {list.getitem(1)} {past.is_absent()}\n")
        list.destruct()

        ring.poke(.construct(alloc))
        ring.add_last(1)
        ring.add_last(2)
        ring.add_first(0)
        third: @S64 = ring.getslot(2)
        third.poke(9)
        front: Option[@S64] = ring.getslot_checked(0)
        when front
            .Present(p) => continue
            .Absent => unreachable
        Out.write("CircularList {p.peek()} {ring.getitem(2)}\n")

        claim dict: @Dict[S64, S64] <- .construct(alloc)
        dict.setitem(7, 1)
        count: @S64 = dict.getslot(7)
        count.poke(count.peek().add(1))
        count.poke(count.peek().add(1))
        missing: Option[@S64] = dict.getslot_checked(8)
        Out.write("Dict {dict.getitem(7)} {missing.is_absent()}\n")

        claim sorted: @SortedDict[S64, S64] <- .construct(alloc)
        sorted.setitem(3, 30)
        sorted.setitem(1, 10)
        sorted.setitem(2, 20)
        two: @S64 = sorted.getslot(2)
        two.poke(two.peek().mul(2))
        none: Option[@S64] = sorted.getslot_checked(4)
        Out.write("SortedDict {sorted.getitem(2)} {none.is_absent()}\n")

        ring.destruct()
        dict.destruct()
        sorted.destruct()
        return()
