// at gives the address of an element, checked like get (a panic past the end or for a missing key), and at_checked
// returns Absent instead: a place to read or update in place. Array, List, and CircularList take an index; Dict and
// SortedDict a key, and give the value's address only, since changing a key in place would lose it.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator
        %alloc.store(%heap)

        claim %arr : @Array<S64, 3>
        %arr.zeroinit(1)
        %arr.at(1).store(5)
        print("Array {%arr.get(0)} {%arr.get(1)}\n")

        %list_val : List<S64> = .construct(%alloc)
        claim %list : @List<S64>
        %list.store(%list_val)
        %list.push(10)
        %list.push(20)
        %list.push(30)
        %slot : @S64 = %list.load().at(1)
        %slot.store(%slot.load().add(5))
        %past : Option<@S64> = %list.load().at_checked(3)
        print("List {%list.load().get(1)} {%past.is_absent()}\n")
        %list.destruct()

        %ring_val : CircularList<S64> = .construct(%alloc)
        claim %ring : @CircularList<S64>
        %ring.store(%ring_val)
        %ring.push_back(1)
        %ring.push_back(2)
        %ring.push_front(0)
        %ring.load().at(2).store(9)
        %front : Option<@S64> = %ring.load().at_checked(0)
        when %front:
            .Present(%p) -> ring_front(%p, %ring)
            .Absent      -> unreachable

    block ring_front(%p: @S64, %ring: @CircularList<S64>):
        print("CircularList {%p.load()} {%ring.load().get(2)}\n")
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator
        %alloc.store(%heap)

        %dict_val : Dict<S64, S64> = .construct(%alloc)
        claim %dict : @Dict<S64, S64>
        %dict.store(%dict_val)
        %dict.put(7, 1)
        %count : @S64 = %dict.load().at(7)
        %count.store(%count.load().add(1))
        %count.store(%count.load().add(1))
        %missing : Option<@S64> = %dict.load().at_checked(8)
        print("Dict {%dict.load().get(7)} {%missing.is_absent()}\n")

        %sorted_val : SortedDict<S64, S64> = .construct(%alloc)
        claim %sorted : @SortedDict<S64, S64>
        %sorted.store(%sorted_val)
        %sorted.put(3, 30)
        %sorted.put(1, 10)
        %sorted.put(2, 20)
        %two : @S64 = %sorted.load().at(2)
        %two.store(%two.load().mul(2))
        %none : Option<@S64> = %sorted.load().at_checked(4)
        print("SortedDict {%sorted.load().get(2)} {%none.is_absent()}\n")

        %ring.destruct()
        %dict.destruct()
        %sorted.destruct()
        return(0)
