# A for loop over an emitter views the list it walks until the loop ends, so the body may not grow that list.

import Collections
import Hosted

routine start() -> None
    list: &List[S64] <- .construct(HEAP)
    list.add_last(1)
    list.add_last(2)
    for x in list.emitter()
        list.add_last(x)
    Console.show("count {list.count()}")
    drop list
    return
