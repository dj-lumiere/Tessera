// A pointer formats as its address, never as its target. Addresses vary from run to run, so only the shape and
// null are checked here.
routine main() -> S32
    block entry():
        %stdout : FdWriter = .stdout()
        claim #out : Ptr<FdWriter>
        #out.store(%stdout)

        #none : Ptr<S64> = null
        write(#out, "{#none}\n")
        #raw : Addr = null
        write(#out, "{#raw}\n")

        // a real address: at least one digit after 0x, and it's what the slot's address is
        claim #slot : Ptr<S64>
        #slot.store(42)
        %seen    : U64  = ptrtoint<Ptr<S64>, U64>(#slot)
        %nonzero : Bool = %seen.ne(0)
        write(#out, "{%nonzero}\n")
        return(0)
