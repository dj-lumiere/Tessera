# retrieve_all on a List[Thread[None]]: each ticket's retrieve returns nothing, and its None goes into the list of
# results, one per ticket. A call that returns nothing gives the None record where a T bound to None is taken.

import Collections
import Hosted

### Adds 1 to the total.
### :param tally: The total, shared by every thread.
routine add_one(tally: @Tally) -> None
    tally.total.fetch_add(1)
    return

### Keeps the value it is handed.
### :param value: The value kept.
### :returns: The value.
routine keep[T](value: T) -> T
needs T: typename
    return value

### Returns nothing.
routine nothing() -> None
    return

routine start() -> None
    out: @ConsoleOutput = Console.output()
    tally: &Tally <- Tally(total: .construct(value: 0))
    threads: &List[Thread[None]] <- .construct(manager: HEAP)
    adding: Work[None] = add_one.to[Work](tally: tally)
    each i in 1 to 4
        t: Thread[None] <- get_thread[None]()
        t.put_work(adding)
        threads.add_last(t)
    results: &List[None] <- threads.retrieve_all()
    out.write("total {tally.total.peek()}, results {results.count()}\n")
    drop results
    threads.give_back_all()
    each i in 1 to 2
        t: Thread[None] <- get_thread[None]()
        t.put_work(adding)
        threads.add_last(t)
    drop threads.retrieve_all()
    out.write("total {tally.total.peek()}\n")
    threads.give_back_all()
    drop threads
    nones: &List[None] <- .construct(manager: HEAP)
    nones.add_last(nothing())
    nones.add_last(keep[None](nothing()))
    out.write("nones {nones.count()}\n")
    drop nones
    return

### A total that every thread adds to.
record Tally
    total: Unbroken[U64]
