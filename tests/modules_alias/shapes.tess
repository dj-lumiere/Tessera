// Shapes exports an alias for an instantiated List, so importers get the name too.

module Shapes

import Standard::Collections

alias Standard::Collections::List<S64> as Sides

record Square
    side : S64

routine Square.sides(%self: Self, %alloc: Ptr<Standard::Alloc::Allocator>) -> Sides
    block entry():
        %sides_val : Sides = .construct(%alloc)
        claim %sides : Ptr<Sides>
        %sides.store(%sides_val)
        %sides.push(%self.side)
        %sides.push(%self.side)
        %sides.push(%self.side)
        %sides.push(%self.side)
        return(%sides.load())
