# A view made with `getview()` of slots the caller passed outlives the routine, so the address of a STACK slot poked
# through it is a build error.

import Hosted

### Pokes the address of a local through a view of the caller's slots.
### :param slots: The caller's slots.
routine keep(slots: @Items[@S32, 2]) -> None
    a: &S32 <- 10

    elems: @[@S32] = slots.getview()
    elems.getslot(0).poke(a)
    return

routine start() -> None
    arr: &Items[@S32, 2] <- .hollow()

    keep(slots: arr)
    return
