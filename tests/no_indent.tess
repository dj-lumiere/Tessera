; Layout is not significant: the same program with no indentation at all.
@[external("c"), symbol("putchar")]
routine c_putchar(%c: CInt) -> CInt
routine sum_to(%n: I64) -> I64
block entry():
jump loop(0, 0)
block loop(%i: I64, %acc: I64):
%done: Bool = %i.sgt(%n)
branch %done ? return(%acc) : body(%i, %acc)
block body(%i: I64, %acc: I64):
jump loop(%i.add(1), %acc.add(%i))
routine main() -> I32
block entry():
%s: I64 = sum_to(100)
%ok: Bool = %s.eq(5050)
select:
%ok -> yes()
_ -> no()
block yes():
c_putchar(b'Y'.to_i32())
c_putchar(10)
return(0)
block no():
c_putchar(b'N'.to_i32())
c_putchar(10)
return(1)
