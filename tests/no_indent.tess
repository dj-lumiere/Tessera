/// Layout is not significant: the same program with no indentation at all.
#[external("c"), symbol("putchar")]
routine c_putchar(c: CInt) -> CInt

routine sum_to(n: S64) -> S64
    shared acc : @S64 <- 0

block entry()
jump loop(0)
block loop(i: S64)
done : Bool = i.gt(n)
branch done
    ? return(acc.load())
    : body(i)

block body(i: S64)
acc.load().add(i).store_into(acc)
jump loop(i.add(1))
routine start() -> Void
block entry()
s  : S64  = sum_to(100)
ok : Bool = s.eq(5050)
when
ok -> yes()
else -> no()
block yes()
c_putchar(b'Y'.to<U8>().to<S32>())
c_putchar(10)
return()
block no()
c_putchar(b'N'.to<U8>().to<S32>())
c_putchar(10)
return()
