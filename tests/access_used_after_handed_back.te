# A routine that gives back the access it is handed ends the caller's: the caller's access is not used after the
# call.

import Standard/Os

global COUNTER: @U64

### Gives the access back.
### :param held: An exclusive access.
routine close(held: Authorized[U64]) -> None
    drop held
    return

routine start() -> None
    held: Authorized[U64] = COUNTER.get_exclusive_access()
    close(held)
    held.getview().poke(4)
    return
