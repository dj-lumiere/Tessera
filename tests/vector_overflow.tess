// An integer Vector's add panics when any lane overflows, like the scalar add: here only lane 2 does.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(%status: CInt) -> Void

#[export("tessera_panic_handler"), noreturn]
routine on_panic(%code: TrapCode, %message: Bytes) -> Void
    block entry():
        print("panicked: {%code.description()}\n")
        exit(3)

routine main() -> S32
    block entry():
        %a   : Vector<S16, 4> = .from_array(Array<S16, 4> { 1, 2, 32767, 4 })
        %one : Vector<S16, 4> = .splat(1)
        %ok  : Vector<S16, 4> = %a.add_wrap(%one)
        print("wrapped {%ok.get(2)}\n")
        %bad : Vector<S16, 4> = %a.add(%one)
        print("not reached {%bad.get(0)}\n")
        return(0)
