// An integer Vector's add crashes when any lane overflows, like the scalar add: here only lane 2 does.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("crashed: {name}\n")
        exit(3)

routine main() -> S32
    block entry()
        a   : Vector<S16, 4> = Array<S16, 4> { 1, 2, 32767, 4 }.to<Vector<S16, 4>>()
        one : Vector<S16, 4> = .splat(1)
        ok  : Vector<S16, 4> = a.add_wrap(one)
        Out.write("wrapped {ok.get(2)}\n")
        bad : Vector<S16, 4> = a.add(one)
        Out.write("not reached {bad.get(0)}\n")
        return(0)
