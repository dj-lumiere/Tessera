; List<I64> against a model. An LCG drives random push / pop / get / set, with a rare clear or reserve, in three
; phases (growing, steady, shrinking). Every 500 operations a checkpoint prints the length, a running checksum of
; every result, and a hash of the ListIter sequence. Then eq, which takes the lists by value.
; The expected output is generated by scripts/gen_collection_seq.py.

struct Rng
    state: I64

routine Rng.below(#self: Ptr<Self>, %bound: I64) -> I64
    block entry():
        %state: I64 := #self.state
        %next:  I64 = %state.mul(6364136223846793005).add(1442695040888963407)
        #self.state = %next
        %value: I64 = %next.lshr(33).urem(%bound)
        return(%value)

routine mix(%hash: I64, %value: I64) -> I64
    block entry():
        %mixed: I64 = %hash.mul(1000003).add(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: I64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every element in iteration order.
routine iteration_hash(#list: Ptr<List<I64>>) -> I64
    block entry():
        %iter_val: ListIter<I64> = ListIter<I64>.new(#list)
        #iter: Ptr<ListIter<I64>> = alloca<ListIter<I64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<ListIter<I64>>, %hash: I64):
        %item: Option<I64> = #iter.next()
        %more: Bool = %item.tag
        %value: I64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<List<I64>>, %phase: I64, %op: I64, %results: I64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op)
        labeled(#out, "length", #list.length())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#list))
        write_line(#out)
        return()

; Runs %ops random operations; %push is the percentage of pushes, pop takes the next 25. Returns the updated results
; checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<List<I64>>, #rng: Ptr<Rng>,
        %phase: I64, %ops: I64, %push: I64, %results: I64) -> I64
    block entry():
        jump next(0, %results)

    block next(%op: I64, %results: I64):
        %done: Bool = %op.sge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: I64, %results: I64):
        %kind:       I64  = #rng.below(1000)
        %pop_end:    I64  = %push.add(25).mul(10)
        %is_push:    Bool = %kind.slt(%push.mul(10))
        %is_pop:     Bool = %kind.slt(%pop_end)
        %is_get:     Bool = %kind.slt(%pop_end.add(200))
        %is_clear:   Bool = %kind.eq(999)
        %is_reserve: Bool = %kind.eq(998)
        select:
            %is_push -> push(%op, %results)
            %is_pop -> pop(%op, %results)
            %is_get -> get(%op, %results)
            %is_clear -> clear(%op, %results)
            %is_reserve -> reserve(%op, %results)
            _ -> set(%op, %results)

    block push(%op: I64, %results: I64):
        %value: I64 = #rng.below(1000000)
        #list.push(%value)
        jump record(%op, %results, %value)

    block pop(%op: I64, %results: I64):
        %empty: Bool = #list.is_empty()
        branch %empty ? record(%op, %results, -1) : pop_one(%op, %results)

    block pop_one(%op: I64, %results: I64):
        %value: I64 = #list.pop()
        jump record(%op, %results, %value)

    block get(%op: I64, %results: I64):
        %empty: Bool = #list.is_empty()
        branch %empty ? record(%op, %results, -2) : get_one(%op, %results)

    block get_one(%op: I64, %results: I64):
        %index: I64 = #rng.below(#list.length())
        %value: I64 = #list.get(%index)
        jump record(%op, %results, %value)

    block set(%op: I64, %results: I64):
        %empty: Bool = #list.is_empty()
        branch %empty ? record(%op, %results, -3) : set_one(%op, %results)

    block set_one(%op: I64, %results: I64):
        %index: I64 = #rng.below(#list.length())
        %value: I64 = #rng.below(1000000)
        #list.set(%index, %value)
        jump record(%op, %results, %index)

    block clear(%op: I64, %results: I64):
        #list.clear()
        jump record(%op, %results, -4)

    block reserve(%op: I64, %results: I64):
        %extra: I64 = #rng.below(3000)
        #list.reserve(#list.length().add(%extra))
        jump record(%op, %results, %extra)

    block record(%op: I64, %results: I64, %result: I64):
        %mixed:   I64  = mix(%results, %result)
        %op_next: I64  = %op.add(1)
        %report:  Bool = %op_next.urem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: I64, %results: I64):
        checkpoint(#out, #list, %phase, %op, %results)
        jump next(%op, %results)

; Pushes every element of #from onto #to.
routine copy_into(#from: Ptr<List<I64>>, #to: Ptr<List<I64>>) -> Void
    block entry():
        %length: I64 = #from.length()
        jump next(0, %length)

    block next(%index: I64, %length: I64):
        %done: Bool = %index.sge(%length)
        branch %done ? return() : copy(%index, %length)

    block copy(%index: I64, %length: I64):
        #to.push(#from.get(%index))
        jump next(%index.add(1), %length)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 2 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %list_val: List<I64> = List<I64>.new(#alloc)
        #list: Ptr<List<I64>> = alloca<List<I64>>([%list_val])

        %r1: I64 = run_phase(#out, #list, #rng, 1, 4000, 50, 0)
        %r2: I64 = run_phase(#out, #list, #rng, 2, 4000, 25, %r1)
        %r3: I64 = run_phase(#out, #list, #rng, 3, 3000, 15, %r2)
        %r4: I64 = run_phase(#out, #list, #rng, 4, 3000, 45, %r3)

        %copy_val: List<I64> = List<I64>.new(#alloc)
        #copy: Ptr<List<I64>> = alloca<List<I64>>([%copy_val])
        %empty_copy: List<I64> := #copy
        %full:       List<I64> := #list
        report_eq(#out, "empty copy equal", %full.eq(%empty_copy))
        copy_into(#list, #copy)
        %same: List<I64> := #copy
        report_eq(#out, "copy equal", %full.eq(%same))
        %last_index: I64 = #copy.length().sub(1)
        %last:       I64 = #copy.get(%last_index)
        #copy.set(%last_index, %last.add(1))
        %changed: List<I64> := #copy
        report_eq(#out, "changed last equal", %full.eq(%changed))
        #copy.set(%last_index, %last)
        #copy.push(0)
        %longer: List<I64> := #copy
        report_eq(#out, "longer equal", %full.eq(%longer))
        #copy.pop()
        %restored: List<I64> := #copy
        report_eq(#out, "restored equal", %full.eq(%restored))
        #copy.free()
        #list.free()
        report_eq(#out, "freed is empty", #list.is_empty())
        #out.flush()
        return(0)
