// List<S64> against a model. An LCG drives random push / pop / get / set, with a rare clear or reserve, in three
// phases (growing, steady, shrinking). Every 500 operations a checkpoint prints the length, a running checksum of
// every result, and a hash of the ListIter sequence. Then eq, which takes the lists by value.
// The expected output is generated by scripts/gen_collection_seq.py.

record Rng
    state: U64

routine Rng.below(#self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state: U64 = #self.state.load()
        %next:  U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        #self.state.store(%next)
        %value: U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed: S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

// Folds every element in iteration order.
routine iteration_hash(#list: Ptr<List<S64>>) -> S64
    block entry():
        %iter_val: ListIter<S64> = .construct(#list)
        #iter: Ptr<ListIter<S64>> = claim
        #iter.store(%iter_val)
        jump next(#iter, 0)

    block next(#iter: Ptr<ListIter<S64>>, %hash: S64):
        %item: Option<S64> = #iter.next()
        %more: Bool = %item.tag
        %value: S64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<List<S64>>, %phase: U64, %op: U64, %results: S64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op.to_s64())
        labeled(#out, "length", #list.length().to_s64())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#list))
        write_line(#out)
        return()

// Runs %ops random operations; %push is the percentage of pushes, pop takes the next 25. Returns the updated results
// checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<List<S64>>, #rng: Ptr<Rng>,
        %phase: U64, %ops: U64, %push: U64, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: U64, %results: S64):
        %done: Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: U64, %results: S64):
        %kind:       U64  = #rng.below(1000)
        %pop_end:    U64  = %push.add(25).mul(10)
        %is_push:    Bool = %kind.lt(%push.mul(10))
        %is_pop:     Bool = %kind.lt(%pop_end)
        %is_get:     Bool = %kind.lt(%pop_end.add(200))
        %is_clear:   Bool = %kind.eq(999)
        %is_reserve: Bool = %kind.eq(998)
        select:
            %is_push -> push(%op, %results)
            %is_pop -> pop(%op, %results)
            %is_get -> get(%op, %results)
            %is_clear -> clear(%op, %results)
            %is_reserve -> reserve(%op, %results)
            _ -> set(%op, %results)

    block push(%op: U64, %results: S64):
        %value: S64 = #rng.below(1000000).to_s64()
        #list.push(%value)
        jump record(%op, %results, %value)

    block pop(%op: U64, %results: S64):
        %empty: Bool = #list.is_empty()
        branch %empty ? record(%op, %results, -1) : pop_one(%op, %results)

    block pop_one(%op: U64, %results: S64):
        %value: S64 = #list.pop()
        jump record(%op, %results, %value)

    block get(%op: U64, %results: S64):
        %empty: Bool = #list.is_empty()
        branch %empty ? record(%op, %results, -2) : get_one(%op, %results)

    block get_one(%op: U64, %results: S64):
        %index: U64 = #rng.below(#list.length())
        %value: S64 = #list.get(%index)
        jump record(%op, %results, %value)

    block set(%op: U64, %results: S64):
        %empty: Bool = #list.is_empty()
        branch %empty ? record(%op, %results, -3) : set_one(%op, %results)

    block set_one(%op: U64, %results: S64):
        %index: U64 = #rng.below(#list.length())
        %value: S64 = #rng.below(1000000).to_s64()
        #list.set(%index, %value)
        jump record(%op, %results, %index.to_s64())

    block clear(%op: U64, %results: S64):
        #list.clear()
        jump record(%op, %results, -4)

    block reserve(%op: U64, %results: S64):
        %extra: U64 = #rng.below(3000)
        #list.reserve(#list.length().add(%extra))
        jump record(%op, %results, %extra.to_s64())

    block record(%op: U64, %results: S64, %result: S64):
        %mixed:   S64  = mix(%results, %result)
        %op_next: U64  = %op.add(1)
        %report:  Bool = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: U64, %results: S64):
        checkpoint(#out, #list, %phase, %op, %results)
        jump next(%op, %results)

// Pushes every element of #from onto #to.
routine copy_into(#from: Ptr<List<S64>>, #to: Ptr<List<S64>>) -> Void
    block entry():
        %length: U64 = #from.length()
        jump next(0, %length)

    block next(%index: U64, %length: U64):
        %done: Bool = %index.ge(%length)
        branch %done ? return() : copy(%index, %length)

    block copy(%index: U64, %length: U64):
        #to.push(#from.get(%index))
        jump next(%index.add(1), %length)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> S32
    block entry():
        %fd_val: FdWriter      = .stdout()
        #fd:     Ptr<FdWriter> = claim
        #fd.store(%fd_val)
        #out: Ptr<BufWriter<FdWriter>> = claim
        #out.construct(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = claim
        #alloc.store(%heap)
        %rng_val: Rng      = Rng { state: 2 }
        #rng:     Ptr<Rng> = claim
        #rng.store(%rng_val)
        %list_val: List<S64> = .construct(#alloc)
        #list: Ptr<List<S64>> = claim
        #list.store(%list_val)

        %r1: S64 = run_phase(#out, #list, #rng, 1, 4000, 50, 0)
        %r2: S64 = run_phase(#out, #list, #rng, 2, 4000, 25, %r1)
        %r3: S64 = run_phase(#out, #list, #rng, 3, 3000, 15, %r2)
        %r4: S64 = run_phase(#out, #list, #rng, 4, 3000, 45, %r3)

        %copy_val: List<S64> = .construct(#alloc)
        #copy: Ptr<List<S64>> = claim
        #copy.store(%copy_val)
        %empty_copy: List<S64> = #copy.load()
        %full:       List<S64> = #list.load()
        report_eq(#out, "empty copy equal", %full.eq(%empty_copy))
        copy_into(#list, #copy)
        %same: List<S64> = #copy.load()
        report_eq(#out, "copy equal", %full.eq(%same))
        %last_index: U64 = #copy.length().sub(1)
        %last:       S64 = #copy.get(%last_index)
        #copy.set(%last_index, %last.add(1))
        %changed: List<S64> = #copy.load()
        report_eq(#out, "changed last equal", %full.eq(%changed))
        #copy.set(%last_index, %last)
        #copy.push(0)
        %longer: List<S64> = #copy.load()
        report_eq(#out, "longer equal", %full.eq(%longer))
        #copy.pop()
        %restored: List<S64> = #copy.load()
        report_eq(#out, "restored equal", %full.eq(%restored))
        #copy.destruct()
        #list.destruct()
        report_eq(#out, "freed is empty", #list.is_empty())
        #out.flush()
        return(0)
