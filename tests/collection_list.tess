// List<S64> against a model. An LCG drives random push / pop / get / set, with a rare clear or reserve, in three
// phases (growing, steady, shrinking). Every 500 operations a checkpoint prints the length, a running checksum of
// every result, and a hash of the ListIter sequence. Then eq, which takes the lists by value.
// The expected output comes from an independent Python model of the collection.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

routine Rng.below(me: @Me, bound: USize) -> USize
    block entry()
        state : U64 = me.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        me.state.store(next)
        bucket : U64   = next.shr(33).mod(bound.to<U64>())
        value  : USize = bucket.to<USize>()
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry()
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<T>(out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer<T>
    block entry()
        out.write(" {label} {value}")
        return()

// Folds every element in iteration order.
routine iteration_hash(list: @List<S64>) -> S64
    shared iter : @ListIter<S64> <- .construct(list)

    block entry()
        jump next(0)

    block next(hash: S64)
        item : Option<S64> = iter.next()
        when item
            .Present(value) -> next(mix(hash, value))
            .Absent         -> return(hash)

routine checkpoint(out: @BufWriter<Out>, list: @List<S64>, phase: USize, op: USize,
    results: S64) -> Void
    block entry()
        out.write("phase {phase}")
        labeled(out, "op", op.to<S64>())
        size : USize = list.count()
        labeled(out, "length", size.to<S64>())
        labeled(out, "results", results)
        labeled(out, "iteration", iteration_hash(list))
        out.write("\n")
        return()

// Runs ops random operations: push is the percentage of pushes, pop takes the next 25. Returns the updated results
// checksum.
routine run_phase(out: @BufWriter<Out>, list: @List<S64>, rng: @Rng, phase: USize, ops: USize,
    push: USize, results: S64) -> S64
    block entry()
        jump next(0, results)

    block next(op: USize, checksum: S64)
        done : Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        kind       : USize = rng.below(1000)
        pop_end    : USize = push.add(25).mul(10)
        is_push    : Bool  = kind.lt(push.mul(10))
        is_pop     : Bool  = kind.lt(pop_end)
        is_get     : Bool  = kind.lt(pop_end.add(200))
        is_clear   : Bool  = kind.eq(999)
        is_reserve : Bool  = kind.eq(998)
        when
            is_push    -> push(op, checksum)
            is_pop     -> pop(op, checksum)
            is_get     -> get(op, checksum)
            is_clear   -> clear(op, checksum)
            is_reserve -> reserve(op, checksum)
            else       -> set(op, checksum)

    block push(op: USize, checksum: S64)
        value : S64 = rng.below(1000000).to<S64>()
        list.push(value)
        jump record(op, checksum, value)

    block pop(op: USize, checksum: S64)
        empty : Bool = list.is_empty()
        branch empty
            ? record(op, checksum, -1)
            : pop_one(op, checksum)

    block pop_one(op: USize, checksum: S64)
        value : S64 = list.pop()
        jump record(op, checksum, value)

    block get(op: USize, checksum: S64)
        empty : Bool = list.is_empty()
        branch empty
            ? record(op, checksum, -2)
            : get_one(op, checksum)

    block get_one(op: USize, checksum: S64)
        index : USize = rng.below(list.count())
        value : S64   = list.getitem(index)
        jump record(op, checksum, value)

    block set(op: USize, checksum: S64)
        empty : Bool = list.is_empty()
        branch empty
            ? record(op, checksum, -3)
            : set_one(op, checksum)

    block set_one(op: USize, checksum: S64)
        index : USize = rng.below(list.count())
        value : S64   = rng.below(1000000).to<S64>()
        list.setitem(index, value)
        jump record(op, checksum, index.to<S64>())

    block clear(op: USize, checksum: S64)
        list.clear()
        jump record(op, checksum, -4)

    block reserve(op: USize, checksum: S64)
        extra : USize = rng.below(3000)
        size  : USize = list.count()
        list.reserve(size.add(extra))
        jump record(op, checksum, extra.to<S64>())

    block record(op: USize, checksum: S64, result: S64)
        mixed   : S64   = mix(checksum, result)
        op_next : USize = op.add(1)
        report  : Bool  = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out, list, phase, op, checksum)
        jump next(op, checksum)

// Pushes every element of from onto to.
routine copy_into(from: @List<S64>, to: @List<S64>) -> Void
    shared count : USize = from.count()

    block entry()
        jump next(0)

    block next(index: USize)
        done : Bool = index.ge(count)
        branch done
            ? return()
            : copy(index)

    block copy(index: USize)
        to.push(from.getitem(index))
        jump next(index.add(1))

routine report_eq(out: @BufWriter<Out>, label: Bytes, equal: Bool) -> Void
    block entry()
        out.write("{label} {equal}\n")
        return()

routine start() -> Void
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc : @Allocator <- make_heap_allocator()
        claim rng   : @Rng       <- Rng { state: 2 }
        claim list  : @List<S64> <- .construct(alloc)

        r1 : S64 = run_phase(out, list, rng, 1, 4000, 50, 0)
        r2 : S64 = run_phase(out, list, rng, 2, 4000, 25, r1)
        r3 : S64 = run_phase(out, list, rng, 3, 3000, 15, r2)
        r4 : S64 = run_phase(out, list, rng, 4, 3000, 45, r3)

        claim copied : @List<S64> <- .construct(alloc)
        empty_copy : List<S64> = copied.load()
        full       : List<S64> = list.load()
        report_eq(out, "empty copy equal", full.eq(empty_copy))
        copy_into(list, copied)
        same : List<S64> = copied.load()
        report_eq(out, "copy equal", full.eq(same))
        copied_count : USize = copied.count()
        last_index   : USize = copied_count.sub(1)
        last         : S64   = copied.getitem(last_index)
        copied.setitem(last_index, last.add(1))
        changed : List<S64> = copied.load()
        report_eq(out, "changed last equal", full.eq(changed))
        copied.setitem(last_index, last)
        copied.push(0)
        longer : List<S64> = copied.load()
        report_eq(out, "longer equal", full.eq(longer))
        copied.pop()
        restored : List<S64> = copied.load()
        report_eq(out, "restored equal", full.eq(restored))
        copied.destruct()
        list.destruct()
        report_eq(out, "freed is empty", list.is_empty())
        out.flush()
        return()
