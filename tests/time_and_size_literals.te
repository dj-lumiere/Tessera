# A whole number with a time unit is a Duration (w d h m s ms us ns), with a size unit a ByteSize (b kb mb gb kib mib
# gib). A Duration is S64 seconds and U32 nanoseconds and may be negative, a ByteSize a U64 count of bytes. The arithmetic, the comparisons, presets and globals of them, and
# how they write themselves.

import Standard/Format
import Standard/Os

### How long all the waits took, as a global.
global TOTAL: @Duration <- 1s

### Half a second.
preset HALF: Duration = 500ms
### A page as most systems have it.
preset PAGE: ByteSize = 4kib

### A record holding a Duration, whose fields are secret to Core: a `when` over a Maybe of it still builds.
record Timer
    at: Duration
    id: U64

routine start() -> None
    long: Duration = 1d + 2h + 3m + 4s + 5ms + 6us + 7ns
    Console.show("{long} | {long.diagnose()} | {long.nanoseconds()}")
    Console.show("{HALF} {HALF.diagnose()} {HALF.milliseconds()} {(HALF * 3).seconds()} {(HALF // 4).diagnose()}")
    Console.show("{(3s // 1s)} {(5s % 2s)} {(1s -^ 2s)} {(Duration.MAX +^ 1ns) == Duration.MAX} {0s} {1w.diagnose()}")
    Console.show("{1s < 1001ms} {60s == 1m} {(2h).compare(1h)} {HALF.min(1s)} {HALF.max(1s)}")
    Console.show("{Duration.from_milliseconds(1500)} {Duration.from_seconds(90).diagnose()} {TOTAL.peek()}")
    Console.show("{-1500ms} {(-1500ms).diagnose()} {(0s - 1ns).seconds()} {(0s - 1ns).subsecond_nanoseconds()} {(-3s).abs()}")
    Console.show("{Duration.MAX.diagnose()} {(Duration.MAX +^ 1s) == Duration.MAX} {(0s - Duration.MAX -^ 1s).seconds()}")
    epoch: Moment = Moment.epoch()
    later: Moment = Moment.from_timestamp(1760862600) + 250ms
    Console.show("{epoch} {later} {later.diagnose()} {(later - epoch).seconds()} {later.day_of_week()}")
    Console.show("{Moment.from_timestamp(-1)} {Moment.from_timestamp(951782400)} {epoch < later} {epoch - 1ns}")
    timer: Maybe[Timer] = Timer(at: 5s, id: 1)
    when timer
        is Timer as t => Console.show("timer {t.id} at {t.at}")
        is None => Console.show("no timer")
    Console.show("{PAGE} {PAGE.bytes()} {PAGE.diagnose()} {(1536mib)} {(1536mib).diagnose()} {0b} {1_000b.diagnose()}")
    Console.show("{(PAGE * 3).bytes()} {(1gib // PAGE)} {(1gb - 1mb).diagnose()} {ByteSize.construct(bytes: 1500)}")
    return
