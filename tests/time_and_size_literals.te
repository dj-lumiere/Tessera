# A whole number with a time unit is a Duration (w d h m s ms us ns), with a size unit a ByteSize (b kb mb gb kib mib
# gib). Both count in a U64: nanoseconds and bytes. The arithmetic, the comparisons, presets and globals of them, and
# how they write themselves.

import Standard/Format
import Standard/Os

### How long all the waits took, as a global.
global TOTAL: @Duration <- 1s

### Half a second.
preset HALF: Duration = 500ms
### A page as most systems have it.
preset PAGE: ByteSize = 4kib

routine start() -> None
    long: Duration = 1d + 2h + 3m + 4s + 5ms + 6us + 7ns
    Out.write("{long} | {long.diagnose()} | {long.nanoseconds()}\n")
    Out.write("{HALF} {HALF.diagnose()} {HALF.milliseconds()} {(HALF * 3).seconds()} {(HALF // 4).diagnose()}\n")
    Out.write("{(3s // 1s)} {(5s % 2s)} {(1s -^ 2s)} {(Duration.MAX +^ 1ns) == Duration.MAX} {0s} {1w.diagnose()}\n")
    Out.write("{1s < 1001ms} {60s == 1m} {(2h).compare(1h)} {HALF.min(1s)} {HALF.max(1s)}\n")
    Out.write("{Duration.from_milliseconds(1500)} {Duration.from_seconds(90).diagnose()} {TOTAL.peek()}\n")
    Out.write("{PAGE} {PAGE.bytes()} {PAGE.diagnose()} {(1536mib)} {(1536mib).diagnose()} {0b} {1_000b.diagnose()}\n")
    Out.write("{(PAGE * 3).bytes()} {(1gib // PAGE)} {(1gb - 1mb).diagnose()} {ByteSize.construct(bytes: 1500)}\n")
    return
