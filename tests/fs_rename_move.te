# OsFileManager.rename and move, in a directory of its own under the temporary directory: a file renamed
# in its directory, a name that isn't one name (a separator, "..", empty), a rename onto a file with and without
# replacing, a file moved into another directory (its name kept), a move onto a file of the same name with and without
# replacing, and a directory renamed and moved with what is in it. A Directory's go_to names the directories.

import Standard/Os

routine report(what: @[Byte], r: Check[None]) -> None
    when r
        is None => Console.show("{what}: ok")
        is Crashables as error => Console.show("{what}: {error.name()}")
    return

### Makes the file with the text.
routine make(f: @File, text: @[Byte]) -> None
    OsFileManager.make_file(at: f, replacing: true)
    OsFileManager.write_all(at: f, data: text)
    return

### The file's text.
routine text_of(f: @File) -> BorrowedSlice[Byte]
    return OsFileManager.read_all(at: f, manager: HEAP)

routine start() -> None
    tmp: &Directory <- OsEnvironment.temp_directory(HEAP)
    root: &Directory <- tmp.go_to(name: "tessera_fs_rename_move", manager: HEAP)

    try OsFileManager.delete_all(at: root, manager: HEAP)
    a: &Directory <- root.go_to(name: "a", manager: HEAP)
    b: &Directory <- root.go_to(name: "b", manager: HEAP)
    OsFileManager.make_directory(at: a, parents: true)
    OsFileManager.make_directory(at: b, parents: true)
    x: &File <- a.file(name: "x.txt", manager: HEAP)
    y: &File <- a.file(name: "y.txt", manager: HEAP)
    z: &File <- a.file(name: "z.txt", manager: HEAP)
    make(f: x, text: "first")
    make(f: z, text: "other")

    report(what: "rename x.txt to y.txt",
        r: check OsFileManager.rename(at: x, to: "y.txt", replacing: false))
    Console.show("x there: {OsFileManager.is_present(at: x)}, y there: {OsFileManager.is_present(at: y)}")
    report(what: "rename to a name with a separator",
        r: check OsFileManager.rename(at: y, to: "c/w.txt", replacing: false))
    report(what: "rename to ..", r: check OsFileManager.rename(at: y, to: "..", replacing: false))
    report(what: "rename to an empty name",
        r: check OsFileManager.rename(at: y, to: "", replacing: false))
    report(what: "rename onto z.txt",
        r: check OsFileManager.rename(at: y, to: "z.txt", replacing: false))
    report(what: "rename onto z.txt replacing",
        r: check OsFileManager.rename(at: y, to: "z.txt", replacing: true))
    moved: &[Byte] <- text_of(f: z)
    Console.show("z.txt now holds: {moved.getslice()}")
    drop moved

    bz: &File <- b.file(name: "z.txt", manager: HEAP)
    report(what: "move z.txt into b", r: check OsFileManager.move(at: z, into: b, replacing: false, manager: HEAP))
    Console.show("a/z.txt there: {OsFileManager.is_present(at: z)}, b/z.txt there: {OsFileManager.is_present(at: bz)}")
    make(f: z, text: "second")
    report(what: "move another z.txt into b",
        r: check OsFileManager.move(at: z, into: b, replacing: false, manager: HEAP))
    report(what: "move it replacing", r: check OsFileManager.move(at: z, into: b, replacing: true, manager: HEAP))
    second: &[Byte] <- text_of(f: bz)
    Console.show("b/z.txt now holds: {second.getslice()}")
    drop second

    inner: &Directory <- a.go_to(name: "inner", manager: HEAP)
    kept: &File <- inner.file(name: "kept.txt", manager: HEAP)
    OsFileManager.make_directory(at: inner, parents: false)
    make(f: kept, text: "inside")
    renamed: &Directory <- a.go_to(name: "renamed", manager: HEAP)
    report(what: "rename the directory inner to renamed",
        r: check OsFileManager.rename(at: inner, to: "renamed", replacing: false))
    report(what: "move the directory renamed into b",
        r: check OsFileManager.move(at: renamed, into: b, replacing: false, manager: HEAP))
    there: &Directory <- b.go_to(name: "renamed", manager: HEAP)
    inside: &File <- there.file(name: "kept.txt", manager: HEAP)
    kept_text: &[Byte] <- text_of(f: inside)
    Console.show("b/renamed/kept.txt holds: {kept_text.getslice()}, a/renamed there: {OsFileManager.is_present(at: renamed)}")
    drop kept_text

    report(what: "delete_all", r: check OsFileManager.delete_all(at: root, manager: HEAP))
    drop inside
    drop there
    drop renamed
    drop kept
    drop inner
    drop bz
    drop z
    drop y
    drop x
    drop b
    drop a
    drop root
    drop tmp
    return
