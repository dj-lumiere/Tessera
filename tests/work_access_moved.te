# An access lent to thread work is reached by the work through the place it was lent from: moving it into a list
# while the work runs is a build error.

import Collections
import Hosted

### The sum of the values the access covers.
### :param part: The shared read access to the values.
### :returns: Their sum.
routine total(part: @ReadAuthorizedSlice[S64]) -> S64
    view: @[S64] = part.getview()

    each i in 0 til view.count() with sum: S64 = 0
        continue with sum: sum + view[i]
    then
        return sum

routine start() -> None
    numbers: &[S64] <- [1, 2, 3, 4] * 1 from HEAP
    reads: &List[ReadAuthorizedSlice[S64]] <- .construct(HEAP)
    held: ReadAuthorizedSlice[S64] <- numbers.getslice().get_shared_read_access()
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = total.to[Work](part: held)
    t.put_work(steal work)
    reads.add_last(steal held)
    Console.show("{t.retrieve()}")
    drop t
    drop reads
    drop numbers
    return
