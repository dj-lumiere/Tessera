# @threadlocal gives each thread its own copy of a global, starting from the declared value: a second thread sees
# that value, not what the first thread stored, while a plain global is shared. The worker starts through the OS
# (pthread_create, or CreateThread with @callconv("stdcall") on Windows).

import Hosted

@threadlocal
global COUNTER: &U64 <- 100

global SHARED: &U64

### What the worker saw, written back through its argument.
record Seen
    counter: U64
    after: U64
    shared: U64

routine work(seen: @Seen) -> None
    seen.counter.poke(COUNTER.peek())
    next_counter: U64 = COUNTER.peek() + 5
    next_counter.poke_into(COUNTER)
    seen.after.poke(COUNTER.peek())
    seen.shared.poke(SHARED.peek())
    return

@target(os: not "windows")
@external("c")
@symbol("pthread_create")
routine pthread_create(thread: @Addr, attr: Addr, start: Callable[(Addr,), Addr], arg: Addr) -> CInt

@target(os: not "windows")
@external("c")
@symbol("pthread_join")
routine pthread_join(thread: Addr, result: Addr) -> CInt

@target(os: not "windows")
routine posix_worker(arg: Addr) -> Addr
    work(arg.to[@Seen]())
    return Addr.zero()

@target(os: not "windows")
routine run_worker(seen: @Seen) -> None
    thread: &Addr

    created: CInt = pthread_create(thread, Addr.zero(), posix_worker.to[Callable](), seen)
    joined: CInt = pthread_join(thread.load(), Addr.zero())
    return

@target(os: "windows")
@external("c")
@symbol("CreateThread")
@callconv("stdcall")
routine create_thread(attrs: Addr, stack: CSize,
    start: Callable[@callconv("stdcall"), (Addr,), U32], arg: Addr, flags: U32, id: Addr) -> Addr

@target(os: "windows")
@external("c")
@symbol("WaitForSingleObject")
@callconv("stdcall")
routine wait_for_single_object(handle: Addr, millis: U32) -> U32

@target(os: "windows")
@external("c")
@symbol("CloseHandle")
@callconv("stdcall")
routine close_handle(handle: Addr) -> S32

@target(os: "windows")
@callconv("stdcall")
routine windows_worker(arg: Addr) -> U32
    work(arg.to[@Seen]())
    return 0

@target(os: "windows")
routine run_worker(seen: @Seen) -> None
    thread: Addr = create_thread(.hollow(), 0, windows_worker.to[Callable](), seen, 0, .hollow())
    waited: U32 = wait_for_single_object(thread, U32.MAX)
    closed: S32 = close_handle(thread)
    return

routine start() -> None
    1.poke_into(COUNTER)
    7.poke_into(SHARED)
    seen: &Seen <- (counter: 0, after: 0, shared: 0)
    run_worker(seen)
    Console.show("worker saw COUNTER {seen.counter.peek()}, left it at {seen.after.peek()}")
    Console.show("worker saw SHARED {seen.shared.peek()}")
    Console.show("main still has COUNTER {COUNTER.peek()}")
    return
