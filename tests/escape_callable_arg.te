# A routine that keeps its parameter in a global, called through a Callable value.

import Hosted

global KEPT: &@S64 <- .hollow()

### Keeps an address.
### :param p: The address.
routine keep(p: @S64) -> None
    KEPT.poke(p)
    return

### Calls `f` on `p`.
### :param f: The routine.
### :param p: Its argument.
routine apply(f: Callable[(@S64), None], p: @S64) -> None
    f.call(p)
    return

### Hands the address of a local to `keep` through `apply`.
routine fill() -> None
    l: &S64 <- 1234567

    apply(f: keep.to[Callable](), p: l)
    return

routine start() -> None
    fill()
    Console.show("{KEPT.peek().peek()}")
    return
