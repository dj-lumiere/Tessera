# A fetch of a removed entity's stamp without try stops the program with the stale stamp failure.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### Fetches after the remove.
routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    a: Stamped[Node] = PoolManager.add(Node.construct(value: 1))
    PoolManager.remove(a)
    Console.show("fetching")
    Console.show("{a.fetch().value.peek()}")
    return
