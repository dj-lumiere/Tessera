// A variant is a tag and one case's payload. `when` on it switches on the case; `Case(x)` binds the payload for the
// arm's target. Cases without a payload are values on their own.

import Standard::Format
import Standard::Os

#derive(Diagnose, Equal, Hash, Compare)
record BinaryExpr
    left  : S64
    right : S64

#derive(Represent, Diagnose, Equal, Hash, Compare)
variant Expr
    Number : S64
    Add    : BinaryExpr
    Name   : Bytes
    Empty

#derive(Represent, Equal)
variant Maybe<T>
require T: typename
    Just : T
    Nothing

routine eval(e: Expr) -> S64
    block entry():
        when e:
            Expr.Number(n) -> return(n)
            Expr.Add(b)    -> add(b)
            Expr.Name(s)   -> return(s.length.to<S64>())
            Expr.Empty     -> return(0)

    block add(b: BinaryExpr):
        r : S64 = b.left.add(b.right)
        return(r)

routine describe(e: Expr) -> Bytes
    block entry():
        when e:
            Expr.Number, Expr.Add -> return("math")
            else                  -> return("other")

routine unwrap_or<T>(m: Maybe<T>, default: T) -> T
require T: typename
    block entry():
        when m:
            .Just(value) -> return(value)
            .Nothing     -> return(default)

routine main() -> S32
    block entry():
        a : Expr = Expr.Number(40)
        b : Expr = .Add(BinaryExpr { left: 1, right: 2 })
        c : Expr = Expr.Name("four")
        d : Expr = Expr.Empty
        Out.write("{eval(a)} {eval(b)} {eval(c)} {eval(d)}\n")
        Out.write("{describe(a)} {describe(b)} {describe(c)} {describe(d)}\n")
        just    : Maybe<F64> = .Just(2.5)
        nothing : Maybe<F64> = Maybe<F64>.Nothing
        Out.write("{unwrap_or(just, 0.0)} {unwrap_or(nothing, -1.0)}\n")
        // the tag, padded to S64's alignment (4 on 32-bit Linux, 8 elsewhere), then the largest payload
        size  : Bool = sizeof<Expr>().eq(alignof<S64>().add(sizeof<BinaryExpr>()))
        align : Bool = alignof<Expr>().eq(alignof<S64>())
        Out.write("{size} {align} {sizeof<Maybe<U8>>()}\n")
        Out.write("{a} {b} {c} {d} {just} {nothing}\n")
        b.diagnose_into(Out.shared())
        Out.write(" ")
        d.diagnose_into(Out.shared())
        Out.write("\n")
        a2 : Expr = Expr.Number(40)
        a3 : Expr = Expr.Number(41)
        Out.write("{a.eq(a2)} {a.eq(a3)} {a.eq(d)} {d.eq(Expr.Empty)} {just.eq(nothing)}\n")
        Out.write("{a.compare(a3)} {a.compare(b)} {d.compare(a)} {b.compare(b)}\n")
        Out.write("{a.hash().eq(a2.hash())} {a.hash().eq(a3.hash())} {d.hash().eq(Expr.Empty.hash())}\n")
        return(0)
