// A variant is a tag and one case's payload. `when` on it switches on the case; `Case(%x)` binds the payload for the
// arm's target. Cases without a payload are values on their own.

@derive(Diagnose, Equal, Hash, Compare)
record BinaryExpr
    left  : S64
    right : S64

@derive(Represent, Diagnose, Equal, Hash, Compare)
variant Expr
    Number : S64
    Add    : BinaryExpr
    Name   : String
    Empty

@derive(Represent, Equal)
variant Maybe<T>
require T: typename
    Just : T
    Nothing

routine eval(%e: Expr) -> S64
    block entry():
        when %e:
            Expr.Number(%n) -> return(%n)
            Expr.Add(%b)    -> add(%b)
            Expr.Name(%s)   -> return(%s.length.to_s64())
            Expr.Empty      -> return(0)

    block add(%b: BinaryExpr):
        %r : S64 = %b.left.add(%b.right)
        return(%r)

routine describe(%e: Expr) -> String
    block entry():
        when %e:
            Expr.Number, Expr.Add -> return("math")
            _                     -> return("other")

routine unwrap_or<T>(%m: Maybe<T>, %default: T) -> T
require T: typename
    block entry():
        when %m:
            .Just(%value) -> return(%value)
            .Nothing      -> return(%default)

routine main() -> S32
    block entry():
        %a : Expr = Expr.Number(40)
        %b : Expr = .Add(BinaryExpr { left: 1, right: 2 })
        %c : Expr = Expr.Name("four")
        %d : Expr = Expr.Empty
        print("{eval(%a)} {eval(%b)} {eval(%c)} {eval(%d)}\n")
        print("{describe(%a)} {describe(%b)} {describe(%c)} {describe(%d)}\n")
        %just    : Maybe<F64> = .Just(2.5)
        %nothing : Maybe<F64> = Maybe<F64>.Nothing
        print("{unwrap_or(%just, 0.0)} {unwrap_or(%nothing, -1.0)}\n")
        print("{sizeof<Expr>()} {alignof<Expr>()} {sizeof<Maybe<U8>>()}\n")
        print("{%a} {%b} {%c} {%d} {%just} {%nothing}\n")
        %b.diagnose(StdoutWriter.shared())
        print(" ")
        %d.diagnose(StdoutWriter.shared())
        print("\n")
        %a2 : Expr = Expr.Number(40)
        %a3 : Expr = Expr.Number(41)
        print("{%a.eq(%a2)} {%a.eq(%a3)} {%a.eq(%d)} {%d.eq(Expr.Empty)} {%just.eq(%nothing)}\n")
        print("{%a.compare(%a3)} {%a.compare(%b)} {%d.compare(%a)} {%b.compare(%b)}\n")
        print("{%a.hash().eq(%a2.hash())} {%a.hash().eq(%a3.hash())} {%d.hash().eq(Expr.Empty.hash())}\n")
        return(0)
