// A variant is a value of one of its branch types and a tag that says which (the type's ID). `when` on it observes
// the branch: `is T as x` names the value for the arm's target. A value of a branch type goes where the variant is
// expected as it is.

import Standard/Format
import Standard/Os

#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record BinaryExpr
    left: S64
    right: S64

#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Empty

#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
variant Expr
    S64
    BinaryExpr
    Span[Byte]
    Empty

#derive(Representable, Diagnosable, Equatable)
record Nothing

#derive(Representable, Equatable)
variant Perhaps[T]
require T: typename
    T
    Nothing

/// Makes a `BinaryExpr` from its fields.
/// :param left: Its `left`.
/// :param right: Its `right`.
/// :returns: The new value.
routine BinaryExpr.construct(left: S64, right: S64) -> Me
    return(Me(left, right))

/// Releases nothing: a `BinaryExpr` holds no memory of its own.
routine BinaryExpr.destruct(me: @Me) -> Void
    return()

/// Makes a `Empty` from its fields.
/// :returns: The new value.
routine Empty.construct() -> Me
    return(Me())

/// Releases nothing: a `Empty` holds no memory of its own.
routine Empty.destruct(me: @Me) -> Void
    return()

/// Releases nothing: a `Expr` holds no memory of its own.
routine Expr.destruct(me: @Me) -> Void
    return()

/// Makes a `Nothing` from its fields.
/// :returns: The new value.
routine Nothing.construct() -> Me
    return(Me())

/// Releases nothing: a `Nothing` holds no memory of its own.
routine Nothing.destruct(me: @Me) -> Void
    return()

/// Releases nothing: a `Perhaps` holds no memory of its own.
routine Perhaps[T].destruct(me: @Me) -> Void
require T: typename
    return()

routine eval(e: Expr) -> S64
    when e
        is S64 as n => return(n)
        is BinaryExpr as b => add(b)
        is Span[Byte] as s => return(s.count.to[S64]())
        is Empty => return(0)

    block add(b: BinaryExpr)
        r: S64 = b.left.add(b.right)
        return(r)

routine describe(e: Expr) -> Span[Byte]
    when e
        is S64, is BinaryExpr => return("math")
        else => return("other")

routine unwrap_or[T](m: Perhaps[T], default: T) -> T
require T: typename
    when m
        is T as value => return(value)
        is Nothing => return(default)

routine start() -> Void
    a: Expr = 40
    b: Expr = BinaryExpr(left: 1, right: 2)
    c: Expr = "four"
    d: Expr = Empty()
    Out.write("{eval(a)} {eval(b)} {eval(c)} {eval(d)}\n")
    Out.write("{describe(a)} {describe(b)} {describe(c)} {describe(d)}\n")
    just: Perhaps[B64] = 2.5
    nothing: Perhaps[B64] = Nothing()
    Out.write("{unwrap_or(m: just, default: 0.0)} {unwrap_or(m: nothing, default: -1.0)}\n")
    // the tag (a 64-bit type ID), padded to the largest branch's alignment, then the largest branch (Span[Byte] on
    // 64-bit targets, BinaryExpr on 32-bit ones)
    largest: USize = sizeof[BinaryExpr]().max(sizeof[Span[Byte]]())
    size: Bool = sizeof[Expr]().eq(alignof[U64]().max(alignof[S64]()).add(largest))
    align: Bool = alignof[Expr]().eq(alignof[U64]())
    Out.write("{size} {align} {sizeof[Perhaps[U8]]()}\n")
    Out.write("{a} {b} {c} {d} {just} {nothing}\n")
    b.diagnose_into(Out.writer())
    Out.write(" ")
    d.diagnose_into(Out.writer())
    Out.write("\n")
    a2: Expr = 40
    a3: Expr = 41
    empty: Expr = Empty()
    Out.write("{a.eq(a2)} {a.eq(a3)} {a.eq(d)} {d.eq(empty)} {just.eq(nothing)}\n")
    Out.write("{a.compare(a3)} {a.compare(b)} {d.compare(a)} {b.compare(b)}\n")
    Out.write("{a.hash().eq(a2.hash())} {a.hash().eq(a3.hash())} {d.hash().eq(empty.hash())}\n")
    return()
