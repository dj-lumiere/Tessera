# Console.show(x) and Console.alert(x) with a value are Console.show("{x}") and Console.alert("{x}"): the value's
# represent_into writes it, a &T box shows the value it holds, and end: works as with a template.

import Standard/Collections
import Standard/Os

### Shows a STACK box, a heap box, a number, an expression, and a collection.
routine start() -> None
    x: &B64 <- 1.5
    Console.show(x)
    Console.show("{x}")
    h: &S64 <- 3 from HEAP
    Console.show(h, end: "")
    Console.show(" after")
    drop h
    n: S64 = 42
    Console.alert(n)
    Console.show(n + 1)
    words: &List[S64] <- List[S64].of(values: [1, 2], manager: HEAP)
    Console.show(words)
    return
