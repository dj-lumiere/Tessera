# Console.show(x) and Console.alert(x) with a value are Console.show("{x}") and Console.alert("{x}"): the value's
# represent_into writes it, and end: works as with a template. A box is read with load(), and a box of an entity shows
# the entity.

import Standard/Collections
import Standard/Hosted

### Shows a STACK box's value, a heap box's value, a number, an expression, and a collection.
routine start() -> None
    x: &B64 <- 1.5
    Console.show(x.load())
    Console.show("{x.load()}")
    h: &S64 <- 3 from HEAP
    Console.show(h.load(), end: "")
    Console.show(" after")
    drop h
    n: S64 = 42
    Console.alert(n)
    Console.show(n + 1)
    words: &List[S64] <- List[S64].of(values: [1, 2], manager: HEAP)
    Console.show(words)
    return
