# A routine that calls itself without end runs its stack out: the fault on the closed page below the stack is reported
# as StackOverflowError.

import Hosted

### Calls itself, each frame holding a little memory.
### :param depth: How deep it is.
### :returns: Never.
routine deeper(depth: U64) -> U64
    frame: &Array[U64, 64] <- .hollow()

    frame.getslot(depth % 64).poke(depth)
    return deeper(depth + 1) + frame[0]

### Calls deeper until the stack runs out.
routine start() -> None
    Console.show("{deeper(0)}")
    return
