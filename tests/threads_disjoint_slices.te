# Work on two threads, each handed its own part of one buffer. A span can't be taken at once: each element is changed
# under exclusive access to it, taken one at a time.

import Standard/Os

### Fills a part with its first index.
### :param part: The part.
### :returns: 0.
routine fill(part: @[S64]) -> S64
    each i in 0 til part.count
        element: Authorized[S64] <- part.getslot(i).get_exclusive_access()
        element.getview().poke(7)
        drop element
    return 0

routine start() -> None
    m: &[S64] <- [0] * 8 from HEAP

    view: @[S64] = m.getslice()

    t1: Thread[S64] <- get_thread[S64]()
    t2: Thread[S64] <- get_thread[S64]()
    work_t1: Work[S64] <- fill.to[Work](part: view.getslice(0, 4))
    t1.put_work(work_t1)
    work_t2: Work[S64] <- fill.to[Work](part: view.getslice(4, 4))
    t2.put_work(work_t2)
    t1.wait_finished()
    t2.wait_finished()
    drop t1
    drop t2
    Console.show("{m[0] + m[7]}")
    drop m
    return
