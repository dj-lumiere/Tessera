# Work on four threads, each handed its own part of one buffer: allowed, no two change the same values.

import Standard/Os

### Fills a part with its first index.
### :param part: The part.
### :returns: 0.
routine fill(part: @[S64]) -> S64
    each i in 0 til part.count
        part.setitem(i, 7)
    return 0

routine start() -> None
    local m: @Memory[S64] <- [0] * 8 at HEAP

    view: @[S64] = m.getview()

    t1: Thread[S64] = get_thread[S64]()
    t2: Thread[S64] = get_thread[S64]()
    t1.put_work(entry: fill.to[Callable](), args: view.getslice(0, 4))
    t2.put_work(entry: fill.to[Callable](), args: view.getslice(4, 4))
    t1.wait_finished()
    t2.wait_finished()
    t1.give_back()
    t2.give_back()
    Console.show("{m.load(0) + m.load(7)}")
    drop m
    return
