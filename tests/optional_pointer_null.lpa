# `@T?` and `Callable?` are one address each, null for None: found and missing values, a routine value or none, and their size.
import Hosted

### The place of the first even element of `xs`.
### :param xs: The elements.
### :returns: Its place, or None when every element is odd.
routine first_even(xs: @[S64]) -> @S64?
    for i in 0 til xs.count()
        if xs.getitem(i) % 2 == 0
            return xs.getslot(i)
    return None()

### Doubles `x`.
### :param x: The number.
### :returns: Twice `x`.
routine twice(x: S64) -> S64
    return x * 2

### Calls `f` with `x`, or gives `x` back when there is no routine.
### :param f: The routine, if any.
### :param x: The number.
### :returns: What `f` gives, else `x`.
routine apply(f: Callable[(S64,), S64]?, x: S64) -> S64
    when f
        is Callable[(S64,), S64] as g => return g.call(x)
        is None => return x

### Runs the cases.
routine start() -> None
    a: &Items[S64, 3] <- [1, 4, 5]
    b: &Items[S64, 2] <- [1, 3]
    when first_even(a.getview())
        is @S64 as p => Console.show("found {p.peek()}")
        is None => Console.show("none")
    when first_even(b.getview())
        is @S64 as p => Console.show("found {p.peek()}")
        is None => Console.show("none")
    Console.show("{apply(f: twice.to[Callable](), x: 21)} {apply(f: None(), x: 7)}")
    # The size of one address, which is 4 on a 32-bit target and 8 on a 64-bit one.
    address: U64 = sizeof[Addr]()
    Console.show("one address {sizeof[@S64?]() == address} {sizeof[Callable[(S64,), S64]?]() == address}")
    return
