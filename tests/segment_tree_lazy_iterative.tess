// Tessera stdlib algorithm: iterative lazy segment tree
//
// TValue and TLazy must satisfy LazySegmentOps<TValue, TLazy>.
// Ranges are half-open: [left, right).
//
// Layout:
//   data[1..size)      internal aggregate nodes
//   data[size..2*size) leaves
//   lazy[1..size)      pending internal lazy tags
//
// The bit routines below hide the heap-index arithmetic. They are compact on
// purpose, but callers use names that describe the tree operation.

import Standard::Alloc
import Standard::Format
import Standard::Os

record LazySegmentTree<TValue, TLazy>
require TValue: typename, TLazy: typename, LazySegmentOps<TValue, TLazy>
    nodes  : Slice<TValue>
    tags   : Slice<TLazy>
    count  : USize
    size   : USize
    height : USize

concept Monoid<T>
require T: typename
    routine Me.identity() -> Me
    routine Me.combine(me: Me, right: Me) -> Me

concept Group<T>
conform Monoid<T>
require T: typename
    routine Me.inverse(me: Me) -> Me

/// Constrains two types at once, so there is no single conforming Me —
/// required routines name their owner (TValue or TLazy) explicitly.
concept LazySegmentOps<TValue, TLazy>
require TValue: typename, TLazy: typename
    /// Aggregate two child values.
    routine TValue.combine(me: Me, right: Me) -> Me

    /// Apply one lazy tag to an aggregate value over a segment of length.
    routine TValue.apply(me: Me, lazy: TLazy, count: USize) -> Me

    /// Compose tags so the returned tag represents newer after older.
    routine TLazy.compose(me: Me, older: Me) -> Me

    routine TValue.identity() -> Me
    routine TLazy.identity() -> Me
    routine TLazy.is_identity_lazy(me: Me) -> Bool

routine LazySegmentTree<T, L>.parent(me: @Me, node: USize) -> USize
    block entry()
        parent : USize = node.shr(1)
        return(parent)

routine LazySegmentTree<T, L>.left_child(me: @Me, node: USize) -> USize
    block entry()
        child : USize = node.shl(1)
        return(child)

routine LazySegmentTree<T, L>.right_child(me: @Me, node: USize) -> USize
    block entry()
        right_child : USize = node.shl(1).bitor(1)
        return(right_child)

routine LazySegmentTree<T, L>.is_right_child(me: @Me, node: USize) -> Bool
    block entry()
        is_right : Bool = node.bitand(1).ne(0)
        return(is_right)

routine LazySegmentTree<T, L>.leaf(me: @Me, index: USize) -> USize
    block entry()
        size : USize = me.size.load()
        leaf : USize = index.bitor(size)
        return(leaf)

routine LazySegmentTree<T, L>.cover_width(me: @Me, height: USize) -> USize
    block entry()
        width : USize = 1.shl(height)
        return(width)

routine LazySegmentTree<T, L>.cover_mask(me: @Me, height: USize) -> USize
    block entry()
        mask : USize = me.cover_width(height).sub(1)
        return(mask)

routine LazySegmentTree<T, L>.is_aligned_to_cover(me: @Me, node: USize, height: USize) -> Bool
    block entry()
        mask    : USize = me.cover_mask(height)
        aligned : Bool  = node.bitand(mask).eq(0)
        return(aligned)

routine LazySegmentTree<T, L>.construct(count: USize, alloc: @Allocator) -> Me
    shared height : @USize <- 0

    block entry()
        invalid : Bool = count.le(0)
        branch invalid
            ? crash_invalid_value()
            : choose_size(1)

    block choose_size(size: USize)
        done : Bool = size.ge(count)
        branch done
            ? allocate(size)
            : grow(size)

    block grow(size: USize)
        height.load().add(1).store_into(height)
        jump choose_size(size.shl(1))

    block allocate(size: USize)
        data_count : USize    = size.shl(1)
        nodes      : Slice<T> = Slice<T>.construct(data_count, alloc)
        tags       : Slice<L> = Slice<L>.construct(size, alloc)
        jump data_loop(0, nodes, tags, size)

    block data_loop(i: USize, nodes: Slice<T>, tags: Slice<L>, size: USize)
        done : Bool = i.ge(nodes.count)
        branch done
            ? init_lazy(0, nodes, tags, size)
            : data_one(i, nodes, tags, size)

    block data_one(i: USize, nodes: Slice<T>, tags: Slice<L>, size: USize)
        identity : T = .identity()
        nodes.setitem(i, identity)
        jump data_loop(i.add(1), nodes, tags, size)

    block init_lazy(i: USize, nodes: Slice<T>, tags: Slice<L>, size: USize)
        done : Bool = i.ge(size)
        branch done
            ? finish(nodes, tags, size)
            : lazy_one(i, nodes, tags, size)

    block lazy_one(i: USize, nodes: Slice<T>, tags: Slice<L>, size: USize)
        identity : L = .identity()
        tags.setitem(i, identity)
        jump init_lazy(i.add(1), nodes, tags, size)

    block finish(nodes: Slice<T>, tags: Slice<L>, size: USize)
        tree : Me = Me { nodes: nodes, tags: tags, count: count, size: size, height: height.load() }
        return(tree)

routine LazySegmentTree<T, L>.count(me: @Me) -> USize
    block entry()
        count : USize = me.count.load()
        return(count)

routine LazySegmentTree<T, L>.build_from(me: @Me, values: @T) -> Void
    block entry()
        jump copy_loop(0)

    block copy_loop(i: USize)
        count : USize = me.count.load()
        done  : Bool  = i.ge(count)
        branch done
            ? reset_lazy(0)
            : copy_one(i)

    block copy_one(i: USize)
        data  : @T    = me.nodes.to<@T>()
        leaf  : USize = me.leaf(i)
        value : T     = values.stride(i).load()
        data.stride(leaf).store(value)
        jump copy_loop(i.add(1))

    block reset_lazy(i: USize)
        size : USize = me.size.load()
        done : Bool  = i.ge(size)
        branch done
            ? pull_all()
            : reset_one(i)

    block reset_one(i: USize)
        lazy     : @L = me.tags.to<@L>()
        identity : L  = .identity()
        lazy.stride(i).store(identity)
        jump reset_lazy(i.add(1))

    block pull_all()
        size  : USize = me.size.load()
        start : USize = size.sub(1)
        jump pull_loop(start)

    block pull_loop(node: USize)
        done : Bool = node.le(0)
        branch done
            ? return()
            : continue
        me.pull_node(node)
        jump pull_loop(node.sub(1))

routine LazySegmentTree<T, L>.pull_node(me: @Me, node: USize) -> Void
    block entry()
        data        : @T    = me.nodes.to<@T>()
        left        : USize = me.left_child(node)
        right       : USize = me.right_child(node)
        left_value  : T     = data.stride(left).load()
        right_value : T     = data.stride(right).load()
        value       : T     = left_value.combine(right_value)
        data.stride(node).store(value)
        return()

routine LazySegmentTree<T, L>.apply_node(me: @Me, node: USize, tag: L, width: USize) -> Void
    block entry()
        data       : @T = me.nodes.to<@T>()
        node_value : T  = data.stride(node).load()
        node_value.apply(tag, width).store_into(data.stride(node))
        size        : USize = me.size.load()
        is_internal : Bool  = node.lt(size)
        branch is_internal
            ? continue
            : return()
        lazy : @L = me.tags.to<@L>()
        old  : L  = lazy.stride(node).load()
        next : L  = tag.compose(old)
        lazy.stride(node).store(next)
        return()

routine LazySegmentTree<T, L>.push_node(me: @Me, node: USize, width: USize) -> Void
    shared lazy : @L = me.tags.to<@L>()
    shared tag  : L  = lazy.stride(node).load()

    block entry()
        clean : Bool = tag.is_identity_lazy()
        branch clean
            ? return()
            : spread()

    block spread()
        child_width : USize = width.shr(1)
        left        : USize = me.left_child(node)
        right       : USize = me.right_child(node)
        me.apply_node(left, tag, child_width)
        me.apply_node(right, tag, child_width)
        identity : L = .identity()
        lazy.stride(node).store(identity)
        return()

routine LazySegmentTree<T, L>.push_path(me: @Me, node: USize) -> Void
    block entry()
        height : USize = me.height.load()
        jump loop(height)

    block loop(level: USize)
        done : Bool = level.le(0)
        branch done
            ? return()
            : continue
        ancestor : USize = node.shr(level)
        width    : USize = me.cover_width(level)
        me.push_node(ancestor, width)
        jump loop(level.sub(1))

routine LazySegmentTree<T, L>.rebuild_path(me: @Me, node: USize) -> Void
    block entry()
        parent : USize = me.parent(node)
        jump loop(parent)

    block loop(ancestor: USize)
        done : Bool = ancestor.le(0)
        branch done
            ? return()
            : continue
        me.pull_node(ancestor)
        parent : USize = me.parent(ancestor)
        jump loop(parent)

routine LazySegmentTree<T, L>.rebuild_left_boundary(me: @Me, node: USize) -> Void
    block entry()
        jump loop(1)

    block loop(level: USize)
        height : USize = me.height.load()
        done   : Bool  = level.gt(height)
        branch done
            ? return()
            : continue
        aligned : Bool = me.is_aligned_to_cover(node, level)
        branch aligned
            ? next(level)
            : pull(level)

    block pull(level: USize)
        ancestor : USize = node.shr(level)
        me.pull_node(ancestor)
        jump next(level)

    block next(level: USize)
        jump loop(level.add(1))

routine LazySegmentTree<T, L>.rebuild_right_boundary(me: @Me, exclusive: USize) -> Void
    block entry()
        jump loop(1)

    block loop(level: USize)
        height : USize = me.height.load()
        done   : Bool  = level.gt(height)
        branch done
            ? return()
            : continue
        aligned : Bool = me.is_aligned_to_cover(exclusive, level)
        branch aligned
            ? next(level)
            : pull(level)

    block pull(level: USize)
        ancestor : USize = exclusive.sub(1).shr(level)
        me.pull_node(ancestor)
        jump next(level)

    block next(level: USize)
        jump loop(level.add(1))

routine LazySegmentTree<T, L>.setitem(me: @Me, index: USize, value: T) -> Void
    block entry()
        count        : USize = me.count.load()
        not_negative : Bool  = index.ge(0)
        before_end   : Bool  = index.lt(count)
        in_bounds    : Bool  = not_negative.bitand(before_end)
        branch in_bounds
            ? continue
            : crash_out_of_bounds()
        node : USize = me.leaf(index)
        me.push_path(node)
        data : @T = me.nodes.to<@T>()
        data.stride(node).store(value)
        me.rebuild_path(node)
        return()

routine LazySegmentTree<T, L>.getitem(me: @Me, index: USize) -> T
    block entry()
        count        : USize = me.count.load()
        not_negative : Bool  = index.ge(0)
        before_end   : Bool  = index.lt(count)
        in_bounds    : Bool  = not_negative.bitand(before_end)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        node : USize = me.leaf(index)
        me.push_path(node)
        data  : @T = me.nodes.to<@T>()
        value : T  = data.stride(node).load()
        return(value)

routine LazySegmentTree<T, L>.range_apply(me: @Me, left: USize, right: USize, tag: L) -> Void
    shared width : @USize <- 1

    block entry()
        valid_left  : Bool  = left.ge(0)
        valid_order : Bool  = left.le(right)
        count       : USize = me.count.load()
        valid_right : Bool  = right.le(count)
        valid_a     : Bool  = valid_left.bitand(valid_order)
        valid       : Bool  = valid_a.bitand(valid_right)
        branch valid
            ? continue
            : crash_out_of_bounds()
        empty : Bool = left.eq(right)
        branch empty
            ? return()
            : continue
        l0   : USize = me.leaf(left)
        r0   : USize = me.leaf(right.sub(1))
        rex0 : USize = r0.add(1)
        me.push_path(l0)
        me.push_path(r0)
        jump loop(l0, rex0, l0, rex0)

    block loop(l: USize, r: USize, l0: USize, rex0: USize)
        done : Bool = l.ge(r)
        branch done
            ? rebuild(l0, rex0)
            : apply_left(l, r, l0, rex0)

    block apply_left(l: USize, r: USize, l0: USize, rex0: USize)
        take_left : Bool = me.is_right_child(l)
        branch take_left
            ? take_left(l, r, l0, rex0)
            : apply_right(l, r, l0, rex0)

    block take_left(l: USize, r: USize, l0: USize, rex0: USize)
        me.apply_node(l, tag, width.load())
        jump apply_right(l.add(1), r, l0, rex0)

    block apply_right(l: USize, r: USize, l0: USize, rex0: USize)
        take_right : Bool = me.is_right_child(r)
        branch take_right
            ? take_right(l, r, l0, rex0)
            : climb(l, r, l0, rex0)

    block take_right(l: USize, r: USize, l0: USize, rex0: USize)
        node : USize = r.sub(1)
        me.apply_node(node, tag, width.load())
        jump climb(l, node, l0, rex0)

    block climb(l: USize, r: USize, l0: USize, rex0: USize)
        next_l     : USize = me.parent(l)
        next_r     : USize = me.parent(r)
        next_width : USize = width.load().shl(1)
        next_width.store_into(width)
        jump loop(next_l, next_r, l0, rex0)

    block rebuild(l0: USize, rex0: USize)
        me.rebuild_left_boundary(l0)
        me.rebuild_right_boundary(rex0)
        return()

routine LazySegmentTree<T, L>.range_query(me: @Me, left: USize, right: USize) -> T
    shared left_acc  : @T <- uninit
    shared right_acc : @T <- uninit

    block entry()
        valid_left  : Bool  = left.ge(0)
        valid_order : Bool  = left.le(right)
        count       : USize = me.count.load()
        valid_right : Bool  = right.le(count)
        valid_a     : Bool  = valid_left.bitand(valid_order)
        valid       : Bool  = valid_a.bitand(valid_right)
        branch valid
            ? continue
            : crash_out_of_bounds()
        empty : Bool = left.eq(right)
        branch empty
            ? empty()
            : prepare()

    block empty()
        identity : T = .identity()
        return(identity)

    block prepare()
        l : USize = me.leaf(left)
        r : USize = me.leaf(right.sub(1))
        me.push_path(l)
        me.push_path(r)
        left_identity  : T = .identity()
        right_identity : T = .identity()
        left_identity.store_into(left_acc)
        right_identity.store_into(right_acc)
        jump loop(l, r.add(1))

    block loop(l: USize, r: USize)
        done : Bool = l.ge(r)
        branch done
            ? combine()
            : take_left(l, r)

    block take_left(l: USize, r: USize)
        use_left : Bool = me.is_right_child(l)
        branch use_left
            ? use_left(l, r)
            : take_right(l, r)

    block use_left(l: USize, r: USize)
        data      : @T = me.nodes.to<@T>()
        value     : T  = data.stride(l).load()
        next_left : T  = left_acc.load().combine(value)
        next_left.store_into(left_acc)
        jump take_right(l.add(1), r)

    block take_right(l: USize, r: USize)
        use_right : Bool = me.is_right_child(r)
        branch use_right
            ? use_right(l, r)
            : climb(l, r)

    block use_right(l: USize, r: USize)
        node       : USize = r.sub(1)
        data       : @T    = me.nodes.to<@T>()
        value      : T     = data.stride(node).load()
        next_right : T     = value.combine(right_acc.load())
        next_right.store_into(right_acc)
        jump climb(l, node)

    block climb(l: USize, r: USize)
        next_l : USize = me.parent(l)
        next_r : USize = me.parent(r)
        jump loop(next_l, next_r)

    block combine()
        value : T = left_acc.load().combine(right_acc.load())
        return(value)

routine LazySegmentTree<T, L>.destruct(me: @Me) -> Void
    block entry()
        me.nodes.destruct()
        me.tags.destruct()
        me.count.store(0)
        me.size.store(0)
        me.height.store(0)
        return()

// ── Demo: range add, range sum ────────────────────────────────────────────────

/// A segment's sum. Applying an add of delta to length elements adds delta * length.
record RangeSum
    sum : S64

/// A pending add over every element of a segment.
record RangeAdd
    delta : S64

/// LazySegmentOps constrains two types at once, so the conformance is its own declaration.
conform LazySegmentOps<RangeSum, RangeAdd>

routine RangeSum.identity() -> Me
    block entry()
        zero : Me = Me { sum: 0 }
        return(zero)

routine RangeSum.combine(me: Me, right: Me) -> Me
    block entry()
        total : Me = Me { sum: me.sum.add(right.sum) }
        return(total)

routine RangeSum.apply(me: Me, lazy: RangeAdd, count: USize) -> Me
    block entry()
        added  : S64 = lazy.delta.mul(count.to<S64>())
        result : Me  = Me { sum: me.sum.add(added) }
        return(result)

routine RangeAdd.identity() -> Me
    block entry()
        none : Me = Me { delta: 0 }
        return(none)

routine RangeAdd.compose(me: Me, older: Me) -> Me
    block entry()
        both : Me = Me { delta: me.delta.add(older.delta) }
        return(both)

routine RangeAdd.is_identity_lazy(me: Me) -> Bool
    block entry()
        none : Bool = me.delta.eq(0)
        return(none)

routine print_sum(out: @BufWriter<Out>, tree: @LazySegmentTree<RangeSum, RangeAdd>, left: USize,
    right: USize) -> Void
    block entry()
        total : RangeSum = tree.range_query(left, right)
        out.write("sum [{left}, {right}) = {total.sum}\n")
        return()

routine print_get(out: @BufWriter<Out>, tree: @LazySegmentTree<RangeSum, RangeAdd>,
    index: USize) -> Void
    block entry()
        value : RangeSum = tree.getitem(index)
        out.write("get {index} = {value.sum}\n")
        return()

routine print_add(out: @BufWriter<Out>, left: USize, right: USize, delta: S64) -> Void
    block entry()
        out.write("add {delta} to [{left}, {right})\n")
        return()

/// Fills count leaves with i * 7 mod 10: 0 7 4 1 8 5 2 9 6 3.
routine fill_values(values: @RangeSum, count: USize) -> Void
    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? return()
            : store(i)

    block store(i: USize)
        scrambled : USize    = i.mul(7).mod(10)
        leaf      : RangeSum = RangeSum { sum: scrambled.to<S64>() }
        values.stride(i).store(leaf)
        jump loop(i.add(1))

routine start() -> Void
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc  : @Allocator       <- make_heap_allocator()
        claim values : @Slice<RangeSum> <- .construct(10, alloc)
        first : @RangeSum = values.to<@RangeSum>()
        fill_values(first, 10)
        claim tree : @LazySegmentTree<RangeSum, RangeAdd> <- .construct(10, alloc)
        tree.build_from(first)
        values.destruct()
        print_sum(out, tree, 0, 10)
        print_sum(out, tree, 3, 8)

        print_add(out, 2, 7, 10)
        tree.range_apply(2, 7, RangeAdd { delta: 10 })
        print_sum(out, tree, 0, 10)
        print_sum(out, tree, 3, 5)
        print_sum(out, tree, 6, 9)

        print_add(out, 0, 4, -3)
        tree.range_apply(0, 4, RangeAdd { delta: -3 })
        print_sum(out, tree, 0, 4)
        print_sum(out, tree, 1, 8)
        print_get(out, tree, 3)

        tree.setitem(5, RangeSum { sum: 100 })
        print_get(out, tree, 5)
        print_sum(out, tree, 4, 7)
        print_sum(out, tree, 4, 4)
        print_sum(out, tree, 0, 10)
        tree.destruct()
        out.flush()
        return()
