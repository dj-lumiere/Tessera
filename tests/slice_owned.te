# A Memory[T] from construct(count, manager) is memory from a manager: an address, a count, the manager, and a
# generation. drop() gives the memory back to that manager, destruct_all() destructs the values first, resize
# reallocates, and the _result forms return an error instead of crashing. A counting manager shows every block coming
# back, and a refusing one the failures.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Counts
    live: S64
    calls: S64

# A memory manager that refuses everything.
record Refusing

obeys MemoryManageable[Counts]
obeys MemoryManageable[Refusing]

routine bump(place: @S64, by: S64) -> None
    next: S64 = place.peek() + by
    place.poke(next)
    return

routine Counts.alloc(me: @Me, size: U64, align: U64) -> Addr
    bump(place: me.live, by: 1)
    bump(place: me.calls, by: 1)
    return DEFAULT_HEAP.alloc(size, align)

@reshaping(at)
routine Counts.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    bump(place: me.calls, by: 1)
    if at.is_null()
        bump(place: me.live, by: 1)
    return DEFAULT_HEAP.realloc(at, size, align)

routine Counts.free(me: @Me, at: Addr) -> None
    bump(place: me.live, by: -1)
    DEFAULT_HEAP.free(at)
    return

routine Refusing.alloc(me: @Me, size: U64, align: U64) -> Addr
    return null

routine Refusing.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    return null

routine Refusing.free(me: @Me, at: Addr) -> None
    DEFAULT_HEAP.free(at)
    return

routine show(label: @[Byte], counts: @Counts) -> None
    Out.write("{label}: live {counts.live.peek()}, allocator calls {counts.calls.peek()}\n")
    return

### Reading and writing through both receivers, and resizing.
routine values(counts: @Counts, alloc: @MemoryManager) -> None
    local owned: @Memory[S64] <- .construct(count: 3, manager: alloc)

    owned[0] = 10
    owned[1] = 20
    owned.getslot(2).poke(30)
    copy: @[S64] = owned.getview()
    Out.write("count {owned.count()} and {copy.count()}, values {owned.getitem(0)} {copy.getitem(1)} {owned.getslot(2).peek()}\n")
    Out.write("getitem_checked(2) {owned.getitem_checked(2)}, getitem_checked(3) {copy.getitem_checked(3)}\n")
    tail: @[S64] = owned.getslice(start: 1, count: 2)
    Out.write("getslice(1, 2): {tail.getitem(0)} {tail.getitem(1)}, first by address {owned.to[@S64]().peek()}\n")
    owned.resize(5)
    owned[4] = 50
    Out.write("after resize(5): count {owned.count()}, kept {owned.getitem(2)}, new {owned.getitem(4)}\n")
    show(label: "  one block", counts)
    owned.resize(0)
    Out.write("after resize(0): count {owned.count()}\n")
    show(label: "  given back", counts)
    drop owned
    return

### A count of 0 allocates nothing, and its drop gives nothing back.
routine empty(counts: @Counts, alloc: @MemoryManager) -> None
    local nothing: @Memory[U8] <- .construct(count: 0, manager: alloc)

    Out.write("empty: count {nothing.count()}, getitem_checked(0) {nothing.getitem_checked(0)}\n")
    drop nothing
    show(label: "  after the drop", counts)
    return

### destruct_all releases what each value owns, then the memory itself.
routine nested(counts: @Counts, alloc: @MemoryManager) -> None
    local rows: @Memory[List[S64]] <- .construct(count: 2, manager: alloc)

    rows[0] = List[S64].construct(alloc)
    rows[1] = List[S64].construct(alloc)
    rows.getslot(0).add_last(1)
    rows.getslot(1).add_last(2)
    rows.getslot(1).add_last(3)
    Out.write("rows: {rows.getslot(0)} {rows.getslot(1)}\n")
    show(label: "  three blocks", counts)
    rows.destruct_all()
    show(label: "  after destruct_all", counts)
    return

### Text in a Memory[Byte].
routine text(alloc: @MemoryManager) -> None
    local bytes: @Memory[Byte] <- .construct(count: 2, manager: alloc)

    bytes[0] = b'o'
    bytes[1] = b'k'
    copy: @[Byte] = bytes.getview()
    Out.write("text: {bytes.getview()} {copy.getview().count()}\n")
    drop bytes
    return

### The _result forms against an allocator that refuses everything.
routine refused() -> None
    local refusing: @Refusing <- .hollow()
    local alloc: @MemoryManager <- refusing.to[MemoryManager]()

    when Memory[U8].construct_result(count: 4, manager: alloc)
        is Memory[U8] as made =>
            Out.write("construct_result: failed false\n")
            drop made
        is AllocFailed as failure => Out.write("construct_result: failed true, {failure}\n")
    local none: @Memory[U8] <- .construct(count: 0, manager: alloc)
    resized: Result[None, AllocFailed] = none.resize_result(4)
    Out.write("resize_result: {resized}, count still {none.count()}\n")
    drop none
    return

routine start() -> None
    local counts: @Counts <- (live: 0, calls: 0)
    local alloc: @MemoryManager <- counts.to[MemoryManager]()

    values(counts, alloc)
    empty(counts, alloc)
    nested(counts, alloc)
    text(alloc)
    show(label: "in the end", counts)
    refused()
    return
