# Two threads add to one plain U64 without an exclusive access: a data race the race check stops. The work gets the
# record as an Addr, which the build doesn't follow.

import Standard/Os

record Shared
    plain: U64

routine bump(at: Addr) -> None
    s: @Shared = at.to[@Shared]()
    until i == 1000 with i: U64 = 0
        s.plain.poke(s.plain.peek() + 1)
        continue with i: i + 1
    then
        return

routine start() -> None
    s: &Shared <- Shared(plain: 0)

    t: Thread[None] = get_thread[None]()
    t.put_work(entry: bump.to[Callable](), args: s.to[Addr]())
    bump(s.to[Addr]())
    t.wait_finished()
    t.give_back()
    Console.show("done")
    return
