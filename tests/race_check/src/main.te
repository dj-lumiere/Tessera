# Two threads add to one plain U64 without a lock: a data race the race check stops.

import Standard/Os

record Shared
    plain: U64

routine bump(s: @Shared) -> None
    until i == 1000 with i: U64 = 0
        s.plain.poke(s.plain.peek() + 1)
        continue with i: i + 1
    then
        return

routine start() -> None
    local s: @Shared <- Shared(plain: 0)

    t: Thread[None] = get_thread[None]()
    t.put_work(entry: bump.to[Callable](), args: s)
    bump(s)
    t.wait_finished()
    t.give_back()
    Console.show("done")
    return
