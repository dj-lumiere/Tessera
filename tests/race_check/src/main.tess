// Two threads add to one plain U64 without a lock: a data race the race check stops.

import Standard/Format
import Standard/Os

record Shared
    plain: U64

routine bump(s: @Shared) -> Void
    each i in 0 til 1000
        s.plain.poke(s.plain.peek() + 1)
    then
        return

routine start() -> Void
    local s: @Shared <- Shared(plain: 0)
    t: Thread[Void] = get_thread[Void]()
    t.put_work(entry: bump.to[Callable](), args: s)
    bump(s)
    t.wait_finished()
    t.give_back()
    Out.write("done\n")
    return
