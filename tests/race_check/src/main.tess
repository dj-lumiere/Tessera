// Two threads add to one plain U64 without a lock: a data race the race check stops.

import Standard/Format
import Standard/Os

record Shared
    plain: U64

routine Shared.construct(plain: U64) -> Me
    return(Me(plain))

routine Shared.destruct(me: @Me) -> Void
    return()

routine bump(s: @Shared) -> Void
    jump step(0)

    block step(i: U64)
        branch i.eq(1000)
            ? return()
            : continue
        s.plain.poke(s.plain.peek().add(1))
        jump step(i.add(1))

routine start() -> Void
    claim s: @Shared <- Shared(plain: 0)
    t: Thread[Void] = get_thread[Void]()
    t.put_work(entry: bump.to[Callable](), args: s)
    bump(s)
    t.wait_finished()
    t.give_back()
    Out.write("done\n")
    return()
