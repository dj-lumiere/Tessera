# A link kept where it outlives the place it views is an Addr: the build follows no lifetime through it, and the view
# made back from it has no source. Views of memory that is never given back (a global, a string literal) have no
# source either, and go anywhere.

import Hosted

### The total of a global.
global TOTAL: &S64
### Where the last name went.
global LAST_NAME: &(@[Byte]) <- "none"

### A node of a list whose links are addresses.
entity Node
    value: S64
    next: Addr
    name: @[Byte]

### Makes a node.
### :param value: Its value.
### :param name: Its name, text that lasts as long as the program.
### :returns: The node.
common routine Node.construct(value: S64, name: @[Byte]) -> Me
    return Me(value, next: Addr.zero(), name)

### Links two nodes through an address and walks them.
routine start() -> None
    first: &Node <- Node.construct(value: 1, name: "first") from HEAP
    second: &Node <- Node.construct(value: 2, name: "second") from HEAP
    first.next.poke(second.getview().to[Addr]())
    first.name.poke("one")
    LAST_NAME.poke(first.name.peek())
    total: @S64 = TOTAL
    when first.next.peek().to[@Node?]()
        is @Node as next => total.poke(first.value.peek() + next.value.peek())
        is None => nothing
    drop second
    drop first
    Console.show("{TOTAL.peek()} {LAST_NAME.peek()}")
    return
