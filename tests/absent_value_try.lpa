# A routine with nothing to give throws AbsentValueError, and its caller takes the T? with try. An unreceived throw stops the
# program with its message.

import Hosted

routine position_of(values: @[S64], wanted: S64) -> U64
    until i >= values.count() with i: U64 = 0
        if values.getitem(i) == wanted
            return i
        continue with i: i + 1
    then
        throw AbsentValueError()

routine start() -> None
    values: @[S64] = [5, 7, 9]
    found: Optional[U64] = try position_of(values, wanted: 9)
    when found
        is U64 as at => Console.show("9 is at {at}")
        is None => Console.show("9 is missing")
    missing: Optional[U64] = try position_of(values, wanted: 4)
    when missing
        is U64 as at => Console.show("4 is at {at}")
        is None => Console.show("4 is missing")
    return
