# An @export under a C name no linked library uses builds, and C reaches it by that name.
module C84/ExportOwnName
import Hosted

### Always 42.
### :param x: Unused.
### :returns: 42.
@export("c84_export_own_abs")
routine my_abs(x: CInt) -> CInt
    return 42

@external("c")
@symbol("abs")
routine c_abs(x: CInt) -> CInt

@external("c")
@symbol("c84_export_own_abs")
routine through_c(x: CInt) -> CInt

### Runs the example.
routine start() -> None
    Console.show("abs(-3) = {c_abs(-3)}, mine: {through_c(-3)}")
    return
