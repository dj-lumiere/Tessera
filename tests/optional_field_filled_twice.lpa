# A field Node? filled on one line holds its node until a drop or a steal: a second fill would lose it, a build error.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

routine start() -> None
    first: &Node <- Node.construct(1)
    first.next <- Node.construct(2) from HEAP
    first.next <- Node.construct(3) from HEAP
    return
