// Fibers on one worker thread: two workers take turns through yield, one spawns a third from inside, and run returns when
// all three have. The stacks come from the stack allocator, with a guard page below each.

import Standard::Alloc
import Standard::Fiber
import Standard::Format
import Standard::Os

/// A worker's state: its name, how many steps it takes, and the scheduler it yields to.
record Worker
    name  : Bytes
    steps : S64
    sched : @Scheduler

routine worker(state: @Worker) -> Void
    block entry()
        jump step(1)

    block step(i: S64)
        done : Bool = i.gt(state.steps.load())
        branch done
            ? finish()
            : work(i)

    block work(i: S64)
        Out.write("{state.name.load()} {i}\n")
        state.sched.load().yield()
        jump step(i.add(1))

    block finish()
        Out.write("{state.name.load()} done\n")
        return()

/// Spawns a late worker from inside a fiber, then returns.
routine spawner(late: @Worker) -> Void
    block entry()
        sched : @Scheduler = late.sched.load()
        Out.write("spawner\n")
        sched.spawn(worker.to<Callable>(), late, 65536)
        return()

routine main() -> S32
    block entry()
        claim alloc  : @Allocator <- make_heap_allocator()
        claim stacks : @Allocator <- make_stack_allocator()
        claim sched  : @Scheduler <- .construct(alloc, stacks, 1)
        claim a      : @Worker    <- Worker { name: "a", steps: 3, sched: sched }
        claim b      : @Worker    <- Worker { name: "b", steps: 2, sched: sched }
        claim c      : @Worker    <- Worker { name: "c", steps: 1, sched: sched }
        sched.spawn(worker.to<Callable>(), a, 65536)
        sched.spawn(worker.to<Callable>(), b, 65536)
        sched.spawn(spawner.to<Callable>(), c, 65536)
        sched.run()
        Out.write("all done\n")
        sched.destruct()
        return(0)
