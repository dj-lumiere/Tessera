// Fibers of one manager: two workers take turns through yield, a third starts a fourth from inside and waits for it,
// and run returns when all have finished. The stacks come from the stack allocator, with a guard page below each.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

/// A worker's state: its name, how many steps it takes, and the manager it yields to.
record Worker
    name: Span[Byte]
    steps: S64
    sched: @FiberManager

/// Makes a `Worker` from its fields.
/// :param name: Its `name`.
/// :param steps: Its `steps`.
/// :param sched: Its `sched`.
/// :returns: The new value.
routine Worker.construct(name: Span[Byte], steps: S64, sched: @FiberManager) -> Me
    return(Me(name, steps, sched))

/// Releases the memory its `name` holds.
routine Worker.destruct(me: @Me) -> Void
    me.name.destruct()
    return()

routine worker(state: @Worker) -> Void
    jump step(1)

    block step(i: S64)
        done: Bool = i.gt(state.steps.peek())
        branch done
            ? finish()
            : work(i)

    block work(i: S64)
        Out.write("{state.name.peek()} {i}\n")
        state.sched.peek().yield()
        jump step(i.add(1))

    block finish()
        Out.write("{state.name.peek()} done\n")
        return()

/// Starts a late worker from inside a fiber, and waits for it before it returns: only this fiber waits, and the
/// others go on.
routine spawner(late: @Worker) -> Void
    sched: @FiberManager = late.sched.peek()
    Out.write("spawner\n")
    f: Fiber[Void] = sched.get_fiber[Void]()
    f.put_work(entry: worker.to[Callable](), args: late)
    f.wait_finished()
    f.give_back()
    return()

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    claim stacks: @MemoryManager <- make_stack_memory()
    claim sched: @FiberManager <- .construct(stack_size: 65536, stacks, alloc)
    claim a: @Worker <- Worker(name: "a", steps: 3, sched: sched)
    claim b: @Worker <- Worker(name: "b", steps: 2, sched: sched)
    claim c: @Worker <- Worker(name: "c", steps: 1, sched: sched)
    fa: Fiber[Void] = sched.get_fiber[Void]()
    fa.put_work(entry: worker.to[Callable](), args: a)
    fb: Fiber[Void] = sched.get_fiber[Void]()
    fb.put_work(entry: worker.to[Callable](), args: b)
    fc: Fiber[Void] = sched.get_fiber[Void]()
    fc.put_work(entry: spawner.to[Callable](), args: c)
    sched.run()
    fa.give_back()
    fb.give_back()
    fc.give_back()
    Out.write("all done\n")
    sched.destruct()
    return()
