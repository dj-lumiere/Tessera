// Fibers on one worker thread: two workers take turns through yield, one spawns a third from inside, and run returns when
// all three have. The stacks come from the stack allocator, with a guard page below each.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

/// A worker's state: its name, how many steps it takes, and the scheduler it yields to.
record Worker
    name: Bytes
    steps: S64
    sched: @FiberManager

routine worker(state: @Worker) -> Void
    jump step(1)

    block step(i: S64)
        done: Bool = i.gt(state.steps.peek())
        branch done
            ? finish()
            : work(i)

    block work(i: S64)
        Out.write("{state.name.peek()} {i}\n")
        state.sched.peek().yield()
        jump step(i.add(1))

    block finish()
        Out.write("{state.name.peek()} done\n")
        return()

/// Spawns a late worker from inside a fiber, then returns.
routine spawner(late: @Worker) -> Void
    sched: @FiberManager = late.sched.peek()
    Out.write("spawner\n")
    sched.spawn(entry: worker.to[Callable](), arg: late, stack_size: 65536)
    return()

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    claim stacks: @MemoryManager <- make_stack_memory()
    claim sched: @FiberManager <- .construct(workers: 1, stacks, alloc)
    claim a: @Worker <- Worker(name: "a", steps: 3, sched: sched)
    claim b: @Worker <- Worker(name: "b", steps: 2, sched: sched)
    claim c: @Worker <- Worker(name: "c", steps: 1, sched: sched)
    sched.spawn(entry: worker.to[Callable](), arg: a, stack_size: 65536)
    sched.spawn(entry: worker.to[Callable](), arg: b, stack_size: 65536)
    sched.spawn(entry: spawner.to[Callable](), arg: c, stack_size: 65536)
    sched.run()
    Out.write("all done\n")
    sched.destruct()
    return()
