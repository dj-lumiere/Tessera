# A routine that may fail handed to put_callable under check: the mismatch the build reports says that the two Callable
# types differ in whether they may fail, instead of printing the same type twice.

import Hosted

crashable BadWorkError
    code: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadWorkError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad work {me.code}")
    return

### Work that fails when it is given a negative number.
### :param n: The number.
routine check_positive(n: S64) -> None
    if n < 0
        throw BadWorkError(code: n)
    return

### Runs the example.
routine start() -> None
    t: Thread[None] <- get_thread[None]()
    when check t.put_callable(entry: check_positive.to[Callable](), args: -4)
        is None => Console.show("started")
        else as e => Console.show("start failed")
    drop t
    return
