        OUT_U64.volatile_store(u64_a.mul(u64_b))
        OUT_U64.volatile_store(u64_a.mul_wrap(u64_b))
        OUT_U64.volatile_store(u64_a.shl(u64_b))
        OUT_U64.volatile_store(u64_a.shr(u64_b))
        OUT_U64.volatile_store(u64_a.rotl(u64_b))
        OUT_U64.volatile_store(u64_a.min(u64_b))
        OUT_U64.volatile_store(u64_a.max(u64_b))
