        OUT_U128.volatile_store(u128_a.count_ones())
        OUT_F32.volatile_store(u128_a.to<F32>())
        OUT_F64.volatile_store(u128_a.to<F64>())
        OUT_F128.volatile_store(u128_a.to<F128>())
        return()

routine start() -> Void
    block entry()
        use_f16()
        use_bf16()
        use_f32()
        use_f64()
        use_f128()
        use_integers()
        return()
