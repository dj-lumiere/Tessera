        OUT_F128.volatile_store(u64_a.to<F128>())
        u128_inputs : @U128 = IN_U128.to<@U128>()
        u128_a      : U128  = u128_inputs.stride(0).volatile_load()
        u128_b      : U128  = u128_inputs.stride(1).volatile_load()
        OUT_U128.volatile_store(u128_a.div(u128_b))
        OUT_U128.volatile_store(u128_a.mod(u128_b))
        OUT_U128.volatile_store(u128_a.mul(u128_b))
        OUT_U128.volatile_store(u128_a.mul_wrap(u128_b))
        OUT_U128.volatile_store(u128_a.shl(u128_b))
        OUT_U128.volatile_store(u128_a.shr(u128_b))
        OUT_U128.volatile_store(u128_a.rotl(u128_b))
        OUT_U128.volatile_store(u128_a.min(u128_b))
