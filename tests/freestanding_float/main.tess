        u16_inputs : @U16 = IN_U16.to<@U16>()
        u16_a      : U16  = u16_inputs.stride(0).volatile_load()
        u16_b      : U16  = u16_inputs.stride(1).volatile_load()
        OUT_U16.volatile_store(u16_a.div(u16_b))
        OUT_U16.volatile_store(u16_a.mod(u16_b))
        OUT_U16.volatile_store(u16_a.mul(u16_b))
        OUT_U16.volatile_store(u16_a.mul_wrap(u16_b))
        OUT_U16.volatile_store(u16_a.shl(u16_b))
        OUT_U16.volatile_store(u16_a.shr(u16_b))
        OUT_U16.volatile_store(u16_a.rotl(u16_b))
        OUT_U16.volatile_store(u16_a.min(u16_b))
        OUT_U16.volatile_store(u16_a.max(u16_b))
        OUT_U16.volatile_store(u16_a.leading_zeros())
        OUT_U16.volatile_store(u16_a.trailing_zeros())
        OUT_U16.volatile_store(u16_a.count_ones())
        OUT_F32.volatile_store(u16_a.to<F32>())
        OUT_F64.volatile_store(u16_a.to<F64>())
        u32_inputs : @U32 = IN_U32.to<@U32>()
        u32_a      : U32  = u32_inputs.stride(0).volatile_load()
        u32_b      : U32  = u32_inputs.stride(1).volatile_load()
        OUT_U32.volatile_store(u32_a.div(u32_b))
        OUT_U32.volatile_store(u32_a.mod(u32_b))
        OUT_U32.volatile_store(u32_a.mul(u32_b))
        OUT_U32.volatile_store(u32_a.mul_wrap(u32_b))
        OUT_U32.volatile_store(u32_a.shl(u32_b))
