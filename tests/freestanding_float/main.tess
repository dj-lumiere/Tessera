        OUT_BOOL.volatile_store(a.eq(b))
        OUT_BOOL.volatile_store(a.ne(b))
        OUT_BOOL.volatile_store(a.is_nan())
        OUT_BOOL.volatile_store(a.is_infinite())
        OUT_BOOL.volatile_store(a.is_finite())
        OUT_BOOL.volatile_store(a.is_normal())
        OUT_BOOL.volatile_store(a.is_subnormal())
        OUT_BOOL.volatile_store(a.is_sign_negative())
        OUT_BOOL.volatile_store(a.is_sign_positive())
        OUT_BOOL.volatile_store(a.between(c, d))
        OUT_BOOL.volatile_store(a.in_range(c, d))
        OUT_S32.volatile_store(a.compare(b))
        OUT_S32.volatile_store(a.total_compare(b))
        OUT_U64.volatile_store(a.hash())
        OUT_F16.volatile_store(a.to<F16>())
        OUT_BF16.volatile_store(a.to<BF16>())
        OUT_F32.volatile_store(a.to<F32>())
        OUT_F128.volatile_store(a.to<F128>())
        OUT_S8.volatile_store(a.to<S8>())
        OUT_S8.volatile_store(a.to_clamp<S8>())
        OUT_S16.volatile_store(a.to<S16>())
        OUT_S16.volatile_store(a.to_clamp<S16>())
        OUT_S32.volatile_store(a.to<S32>())
        OUT_S32.volatile_store(a.to_clamp<S32>())
        OUT_S64.volatile_store(a.to<S64>())
        OUT_S64.volatile_store(a.to_clamp<S64>())
        OUT_S128.volatile_store(a.to<S128>())
        OUT_S128.volatile_store(a.to_clamp<S128>())
        OUT_U8.volatile_store(a.to<U8>())
        OUT_U8.volatile_store(a.to_clamp<U8>())
        OUT_U16.volatile_store(a.to<U16>())
        OUT_U16.volatile_store(a.to_clamp<U16>())
        OUT_U32.volatile_store(a.to<U32>())
        OUT_U32.volatile_store(a.to_clamp<U32>())
        OUT_U64.volatile_store(a.to<U64>())
        OUT_U64.volatile_store(a.to_clamp<U64>())
        OUT_U128.volatile_store(a.to<U128>())
        OUT_U128.volatile_store(a.to_clamp<U128>())
        return()

/// Every F128 operation and conversion.
routine use_f128() -> Void
    block entry()
        inputs : @F128 = IN_F128.to<@F128>()
        a      : F128  = inputs.stride(0).volatile_load()
        b      : F128  = inputs.stride(1).volatile_load()
        c      : F128  = inputs.stride(2).volatile_load()
        d      : F128  = inputs.stride(3).volatile_load()
        n      : S32   = IN_S32.to<@S32>().volatile_load()
        OUT_F128.volatile_store(a.add(b))
        OUT_F128.volatile_store(a.sub(b))
        OUT_F128.volatile_store(a.mul(b))
        OUT_F128.volatile_store(a.div(b))
        OUT_F128.volatile_store(a.mod(b))
        OUT_F128.volatile_store(a.min(b))
        OUT_F128.volatile_store(a.max(b))
        OUT_F128.volatile_store(a.minimum(b))
        OUT_F128.volatile_store(a.maximum(b))
        OUT_F128.volatile_store(a.copysign(b))
        OUT_F128.volatile_store(a.div_euclid(b))
        OUT_F128.volatile_store(a.mod_euclid(b))
        OUT_F128.volatile_store(a.powf(b))
        OUT_F128.volatile_store(a.hypot(b))
        OUT_F128.volatile_store(a.atan2(b))
        OUT_F128.volatile_store(a.neg())
        OUT_F128.volatile_store(a.abs())
        OUT_F128.volatile_store(a.recip())
        OUT_F128.volatile_store(a.floor())
        OUT_F128.volatile_store(a.ceil())
        OUT_F128.volatile_store(a.round())
        OUT_F128.volatile_store(a.round_ties_even())
        OUT_F128.volatile_store(a.trunc())
        OUT_F128.volatile_store(a.fract())
        OUT_F128.volatile_store(a.sqrt())
        OUT_F128.volatile_store(a.signum())
        OUT_F128.volatile_store(a.cbrt())
        OUT_F128.volatile_store(a.exp())
        OUT_F128.volatile_store(a.exp2())
        OUT_F128.volatile_store(a.exp_m1())
        OUT_F128.volatile_store(a.ln())
        OUT_F128.volatile_store(a.ln_1p())
        OUT_F128.volatile_store(a.log2())
        OUT_F128.volatile_store(a.log10())
        OUT_F128.volatile_store(a.sin())
        OUT_F128.volatile_store(a.cos())
        OUT_F128.volatile_store(a.tan())
        OUT_F128.volatile_store(a.asin())
        OUT_F128.volatile_store(a.acos())
        OUT_F128.volatile_store(a.atan())
        OUT_F128.volatile_store(a.sinh())
        OUT_F128.volatile_store(a.cosh())
        OUT_F128.volatile_store(a.tanh())
        OUT_F128.volatile_store(a.asinh())
        OUT_F128.volatile_store(a.acosh())
        OUT_F128.volatile_store(a.atanh())
        OUT_F128.volatile_store(a.erf())
        OUT_F128.volatile_store(a.erfc())
        OUT_F128.volatile_store(a.gamma())
        OUT_F128.volatile_store(a.ln_gamma())
        OUT_F128.volatile_store(a.to_degrees())
        OUT_F128.volatile_store(a.to_radians())
        OUT_F128.volatile_store(a.mul_add(b, c))
        OUT_F128.volatile_store(a.clamp(c, d))
        OUT_F128.volatile_store(a.log(b))
        OUT_F128.volatile_store(a.powi(n))
        OUT_BOOL.volatile_store(a.lt(b))
        OUT_BOOL.volatile_store(a.le(b))
        OUT_BOOL.volatile_store(a.gt(b))
        OUT_BOOL.volatile_store(a.ge(b))
        OUT_BOOL.volatile_store(a.eq(b))
        OUT_BOOL.volatile_store(a.ne(b))
        OUT_BOOL.volatile_store(a.is_nan())
        OUT_BOOL.volatile_store(a.is_infinite())
        OUT_BOOL.volatile_store(a.is_finite())
        OUT_BOOL.volatile_store(a.is_normal())
        OUT_BOOL.volatile_store(a.is_subnormal())
        OUT_BOOL.volatile_store(a.is_sign_negative())
        OUT_BOOL.volatile_store(a.is_sign_positive())
        OUT_BOOL.volatile_store(a.between(c, d))
        OUT_BOOL.volatile_store(a.in_range(c, d))
        OUT_S32.volatile_store(a.compare(b))
        OUT_S32.volatile_store(a.total_compare(b))
        OUT_U64.volatile_store(a.hash())
        OUT_F16.volatile_store(a.to<F16>())
        OUT_BF16.volatile_store(a.to<BF16>())
        OUT_F32.volatile_store(a.to<F32>())
        OUT_F64.volatile_store(a.to<F64>())
        OUT_S32.volatile_store(a.to<S32>())
        OUT_S32.volatile_store(a.to_clamp<S32>())
        OUT_S64.volatile_store(a.to<S64>())
        OUT_S64.volatile_store(a.to_clamp<S64>())
        OUT_S128.volatile_store(a.to<S128>())
        OUT_S128.volatile_store(a.to_clamp<S128>())
        OUT_U32.volatile_store(a.to<U32>())
        OUT_U32.volatile_store(a.to_clamp<U32>())
        OUT_U64.volatile_store(a.to<U64>())
        OUT_U64.volatile_store(a.to_clamp<U64>())
        OUT_U128.volatile_store(a.to<U128>())
        OUT_U128.volatile_store(a.to_clamp<U128>())
        return()

/// Every integer division, the multiplications and shifts LLVM may make calls of, and every integer to float.
routine use_integers() -> Void
    block entry()
        s8_inputs : @S8 = IN_S8.to<@S8>()
        s8_a      : S8  = s8_inputs.stride(0).volatile_load()
        s8_b      : S8  = s8_inputs.stride(1).volatile_load()
        OUT_S8.volatile_store(s8_a.div(s8_b))
        OUT_S8.volatile_store(s8_a.mod(s8_b))
        OUT_S8.volatile_store(s8_a.mul(s8_b))
        OUT_S8.volatile_store(s8_a.mul_wrap(s8_b))
        OUT_S8.volatile_store(s8_a.shl(s8_b))
        OUT_S8.volatile_store(s8_a.shr(s8_b))
        OUT_S8.volatile_store(s8_a.rotl(s8_b))
        OUT_S8.volatile_store(s8_a.min(s8_b))
        OUT_S8.volatile_store(s8_a.max(s8_b))
        OUT_S8.volatile_store(s8_a.div_euclid(s8_b))
        OUT_S8.volatile_store(s8_a.mod_euclid(s8_b))
        OUT_S8.volatile_store(s8_a.leading_zeros())
        OUT_S8.volatile_store(s8_a.trailing_zeros())
        OUT_S8.volatile_store(s8_a.count_ones())
        OUT_F32.volatile_store(s8_a.to<F32>())
        OUT_F64.volatile_store(s8_a.to<F64>())
        s16_inputs : @S16 = IN_S16.to<@S16>()
        s16_a      : S16  = s16_inputs.stride(0).volatile_load()
        s16_b      : S16  = s16_inputs.stride(1).volatile_load()
        OUT_S16.volatile_store(s16_a.div(s16_b))
        OUT_S16.volatile_store(s16_a.mod(s16_b))
        OUT_S16.volatile_store(s16_a.mul(s16_b))
        OUT_S16.volatile_store(s16_a.mul_wrap(s16_b))
        OUT_S16.volatile_store(s16_a.shl(s16_b))
        OUT_S16.volatile_store(s16_a.shr(s16_b))
        OUT_S16.volatile_store(s16_a.rotl(s16_b))
        OUT_S16.volatile_store(s16_a.min(s16_b))
        OUT_S16.volatile_store(s16_a.max(s16_b))
        OUT_S16.volatile_store(s16_a.div_euclid(s16_b))
        OUT_S16.volatile_store(s16_a.mod_euclid(s16_b))
        OUT_S16.volatile_store(s16_a.leading_zeros())
        OUT_S16.volatile_store(s16_a.trailing_zeros())
        OUT_S16.volatile_store(s16_a.count_ones())
        OUT_F32.volatile_store(s16_a.to<F32>())
        OUT_F64.volatile_store(s16_a.to<F64>())
        s32_inputs : @S32 = IN_S32.to<@S32>()
        s32_a      : S32  = s32_inputs.stride(0).volatile_load()
        s32_b      : S32  = s32_inputs.stride(1).volatile_load()
        OUT_S32.volatile_store(s32_a.div(s32_b))
        OUT_S32.volatile_store(s32_a.mod(s32_b))
        OUT_S32.volatile_store(s32_a.mul(s32_b))
        OUT_S32.volatile_store(s32_a.mul_wrap(s32_b))
        OUT_S32.volatile_store(s32_a.shl(s32_b))
        OUT_S32.volatile_store(s32_a.shr(s32_b))
        OUT_S32.volatile_store(s32_a.rotl(s32_b))
        OUT_S32.volatile_store(s32_a.min(s32_b))
        OUT_S32.volatile_store(s32_a.max(s32_b))
        OUT_S32.volatile_store(s32_a.div_euclid(s32_b))
        OUT_S32.volatile_store(s32_a.mod_euclid(s32_b))
        OUT_S32.volatile_store(s32_a.leading_zeros())
        OUT_S32.volatile_store(s32_a.trailing_zeros())
        OUT_S32.volatile_store(s32_a.count_ones())
        OUT_F32.volatile_store(s32_a.to<F32>())
        OUT_F64.volatile_store(s32_a.to<F64>())
        OUT_F128.volatile_store(s32_a.to<F128>())
        s64_inputs : @S64 = IN_S64.to<@S64>()
        s64_a      : S64  = s64_inputs.stride(0).volatile_load()
        s64_b      : S64  = s64_inputs.stride(1).volatile_load()
        OUT_S64.volatile_store(s64_a.div(s64_b))
        OUT_S64.volatile_store(s64_a.mod(s64_b))
        OUT_S64.volatile_store(s64_a.mul(s64_b))
        OUT_S64.volatile_store(s64_a.mul_wrap(s64_b))
        OUT_S64.volatile_store(s64_a.shl(s64_b))
        OUT_S64.volatile_store(s64_a.shr(s64_b))
        OUT_S64.volatile_store(s64_a.rotl(s64_b))
        OUT_S64.volatile_store(s64_a.min(s64_b))
        OUT_S64.volatile_store(s64_a.max(s64_b))
        OUT_S64.volatile_store(s64_a.div_euclid(s64_b))
        OUT_S64.volatile_store(s64_a.mod_euclid(s64_b))
        OUT_S64.volatile_store(s64_a.leading_zeros())
        OUT_S64.volatile_store(s64_a.trailing_zeros())
        OUT_S64.volatile_store(s64_a.count_ones())
        OUT_F32.volatile_store(s64_a.to<F32>())
        OUT_F64.volatile_store(s64_a.to<F64>())
        OUT_F128.volatile_store(s64_a.to<F128>())
        s128_inputs : @S128 = IN_S128.to<@S128>()
        s128_a      : S128  = s128_inputs.stride(0).volatile_load()
        s128_b      : S128  = s128_inputs.stride(1).volatile_load()
        OUT_S128.volatile_store(s128_a.div(s128_b))
        OUT_S128.volatile_store(s128_a.mod(s128_b))
        OUT_S128.volatile_store(s128_a.mul(s128_b))
        OUT_S128.volatile_store(s128_a.mul_wrap(s128_b))
        OUT_S128.volatile_store(s128_a.shl(s128_b))
        OUT_S128.volatile_store(s128_a.shr(s128_b))
        OUT_S128.volatile_store(s128_a.rotl(s128_b))
        OUT_S128.volatile_store(s128_a.min(s128_b))
        OUT_S128.volatile_store(s128_a.max(s128_b))
        OUT_S128.volatile_store(s128_a.div_euclid(s128_b))
        OUT_S128.volatile_store(s128_a.mod_euclid(s128_b))
        OUT_S128.volatile_store(s128_a.leading_zeros())
        OUT_S128.volatile_store(s128_a.trailing_zeros())
        OUT_S128.volatile_store(s128_a.count_ones())
        OUT_F32.volatile_store(s128_a.to<F32>())
        OUT_F64.volatile_store(s128_a.to<F64>())
        OUT_F128.volatile_store(s128_a.to<F128>())
        u8_inputs : @U8 = IN_U8.to<@U8>()
        u8_a      : U8  = u8_inputs.stride(0).volatile_load()
        u8_b      : U8  = u8_inputs.stride(1).volatile_load()
        OUT_U8.volatile_store(u8_a.div(u8_b))
        OUT_U8.volatile_store(u8_a.mod(u8_b))
        OUT_U8.volatile_store(u8_a.mul(u8_b))
        OUT_U8.volatile_store(u8_a.mul_wrap(u8_b))
        OUT_U8.volatile_store(u8_a.shl(u8_b))
        OUT_U8.volatile_store(u8_a.shr(u8_b))
        OUT_U8.volatile_store(u8_a.rotl(u8_b))
        OUT_U8.volatile_store(u8_a.min(u8_b))
        OUT_U8.volatile_store(u8_a.max(u8_b))
