// A program for a target without an operating system that uses every operation of every float type and every
// integer division: CI's freestanding job builds it for each such target and requires that nothing is left
// undefined. On a target without a floating-point unit LLVM turns each float operation into a call (__aeabi_fadd,
// __divdf3, __truncsfhf2, ...), and on 32-bit targets and without a divide instruction each wide division too. The
// stdlib supplies every one of them there (Standard/SoftFloat). It reads its operands from volatile globals and
// writes every result to one, so none of it folds away. Its hashes need the hash key, which it exports itself from
// the board's random number generator, as a target without an OS and without a random number instruction must.
// Like tests/freestanding, it gets the builder's entry (start, without a board step), CI links it with
// tests/freestanding's link scripts, and it never runs here (freestanding_float.arch).

global IN_F16: @Array<F16, 4>
global IN_BF16: @Array<BF16, 4>
global IN_F32: @Array<F32, 4>
global IN_F64: @Array<F64, 4>
global IN_F128: @Array<F128, 4>
global IN_S8: @Array<S8, 4>
global IN_S16: @Array<S16, 4>
global IN_S32: @Array<S32, 4>
global IN_S64: @Array<S64, 4>
global IN_S128: @Array<S128, 4>
global IN_U8: @Array<U8, 4>
global IN_U16: @Array<U16, 4>
global IN_U32: @Array<U32, 4>
global IN_U64: @Array<U64, 4>
global IN_U128: @Array<U128, 4>
global IN_BOOL: @Array<Bool, 4>
global OUT_F16: @F16
global OUT_BF16: @BF16
global OUT_F32: @F32
global OUT_F64: @F64
global OUT_F128: @F128
global OUT_S8: @S8
global OUT_S16: @S16
global OUT_S32: @S32
global OUT_S64: @S64
global OUT_S128: @S128
global OUT_U8: @U8
global OUT_U16: @U16
global OUT_U32: @U32
global OUT_U64: @U64
global OUT_U128: @U128
global OUT_BOOL: @Bool

/// Stands for the data register of the board's true random number generator (a real board reads its memory-mapped
/// register here, at the address its reference manual gives).
global TRNG_DATA: @U32

/// Halts on a crash: there's nowhere to print and nothing to exit to.
#[export("tessera_crash_handler"), noreturn]
routine halt(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        jump spin()

    block spin()
        jump spin()

/// The hash key every `hash()` below uses: the default CPUs of these targets have no random number instruction, so
/// the program supplies it, 128 bits from the board's generator, 32 at a time.
#[export("tessera_hash_key")]
routine board_hash_key(key: @SipKey) -> Void
    block entry()
        a : U64 = TRNG_DATA.volatile_load().to<U64>()
        b : U64 = TRNG_DATA.volatile_load().to<U64>()
        c : U64 = TRNG_DATA.volatile_load().to<U64>()
        d : U64 = TRNG_DATA.volatile_load().to<U64>()
        a.shl(32).bitor(b).store_into(key.k0)
        c.shl(32).bitor(d).store_into(key.k1)
        return()

/// Every F16 operation and conversion.
routine use_f16() -> Void
    block entry()
        inputs : @F16 = IN_F16.to<@F16>()
        a      : F16  = inputs.stride(0).volatile_load()
        b      : F16  = inputs.stride(1).volatile_load()
        c      : F16  = inputs.stride(2).volatile_load()
        d      : F16  = inputs.stride(3).volatile_load()
        n      : S32  = IN_S32.to<@S32>().volatile_load()
        OUT_F16.volatile_store(a.add(b))
        OUT_F16.volatile_store(a.sub(b))
        OUT_F16.volatile_store(a.mul(b))
        OUT_F16.volatile_store(a.div(b))
        OUT_F16.volatile_store(a.mod(b))
        OUT_F16.volatile_store(a.min(b))
        OUT_F16.volatile_store(a.max(b))
        OUT_F16.volatile_store(a.minimum(b))
        OUT_F16.volatile_store(a.maximum(b))
        OUT_F16.volatile_store(a.copysign(b))
        OUT_F16.volatile_store(a.div_euclid(b))
        OUT_F16.volatile_store(a.mod_euclid(b))
        OUT_F16.volatile_store(a.powf(b))
        OUT_F16.volatile_store(a.hypot(b))
        OUT_F16.volatile_store(a.atan2(b))
        OUT_F16.volatile_store(a.neg())
        OUT_F16.volatile_store(a.abs())
        OUT_F16.volatile_store(a.recip())
        OUT_F16.volatile_store(a.floor())
        OUT_F16.volatile_store(a.ceil())
        OUT_F16.volatile_store(a.round())
        OUT_F16.volatile_store(a.round_ties_even())
        OUT_F16.volatile_store(a.trunc())
        OUT_F16.volatile_store(a.fract())
        OUT_F16.volatile_store(a.sqrt())
        OUT_F16.volatile_store(a.signum())
        OUT_F16.volatile_store(a.cbrt())
        OUT_F16.volatile_store(a.exp())
        OUT_F16.volatile_store(a.exp2())
        OUT_F16.volatile_store(a.exp_m1())
        OUT_F16.volatile_store(a.ln())
        OUT_F16.volatile_store(a.ln_1p())
        OUT_F16.volatile_store(a.log2())
        OUT_F16.volatile_store(a.log10())
        OUT_F16.volatile_store(a.sin())
        OUT_F16.volatile_store(a.cos())
        OUT_F16.volatile_store(a.tan())
        OUT_F16.volatile_store(a.asin())
        OUT_F16.volatile_store(a.acos())
        OUT_F16.volatile_store(a.atan())
        OUT_F16.volatile_store(a.sinh())
        OUT_F16.volatile_store(a.cosh())
        OUT_F16.volatile_store(a.tanh())
        OUT_F16.volatile_store(a.asinh())
        OUT_F16.volatile_store(a.acosh())
        OUT_F16.volatile_store(a.atanh())
        OUT_F16.volatile_store(a.erf())
        OUT_F16.volatile_store(a.erfc())
        OUT_F16.volatile_store(a.gamma())
        OUT_F16.volatile_store(a.ln_gamma())
        OUT_F16.volatile_store(a.to_degrees())
        OUT_F16.volatile_store(a.to_radians())
        OUT_F16.volatile_store(a.mul_add(b, c))
        OUT_F16.volatile_store(a.clamp(c, d))
        OUT_F16.volatile_store(a.log(b))
        OUT_F16.volatile_store(a.powi(n))
        OUT_BOOL.volatile_store(a.lt(b))
        OUT_BOOL.volatile_store(a.le(b))
        OUT_BOOL.volatile_store(a.gt(b))
        OUT_BOOL.volatile_store(a.ge(b))
        OUT_BOOL.volatile_store(a.eq(b))
        OUT_BOOL.volatile_store(a.ne(b))
        OUT_BOOL.volatile_store(a.is_nan())
        OUT_BOOL.volatile_store(a.is_infinite())
        OUT_BOOL.volatile_store(a.is_finite())
        OUT_BOOL.volatile_store(a.is_normal())
        OUT_BOOL.volatile_store(a.is_subnormal())
        OUT_BOOL.volatile_store(a.is_sign_negative())
        OUT_BOOL.volatile_store(a.is_sign_positive())
        OUT_BOOL.volatile_store(a.between(c, d))
        OUT_BOOL.volatile_store(a.in_range(c, d))
        OUT_S32.volatile_store(a.compare(b))
        OUT_S32.volatile_store(a.total_compare(b))
        OUT_U64.volatile_store(a.hash())
        OUT_BF16.volatile_store(a.to<BF16>())
        OUT_F32.volatile_store(a.to<F32>())
        OUT_F64.volatile_store(a.to<F64>())
        OUT_F128.volatile_store(a.to<F128>())
        OUT_S8.volatile_store(a.to<S8>())
        OUT_S8.volatile_store(a.to_clamp<S8>())
        OUT_S16.volatile_store(a.to<S16>())
        OUT_S16.volatile_store(a.to_clamp<S16>())
        OUT_S32.volatile_store(a.to<S32>())
        OUT_S32.volatile_store(a.to_clamp<S32>())
        OUT_S64.volatile_store(a.to<S64>())
        OUT_S64.volatile_store(a.to_clamp<S64>())
        OUT_S128.volatile_store(a.to<S128>())
        OUT_S128.volatile_store(a.to_clamp<S128>())
        OUT_U8.volatile_store(a.to<U8>())
        OUT_U8.volatile_store(a.to_clamp<U8>())
        OUT_U16.volatile_store(a.to<U16>())
        OUT_U16.volatile_store(a.to_clamp<U16>())
        OUT_U32.volatile_store(a.to<U32>())
        OUT_U32.volatile_store(a.to_clamp<U32>())
        OUT_U64.volatile_store(a.to<U64>())
        OUT_U64.volatile_store(a.to_clamp<U64>())
        OUT_U128.volatile_store(a.to<U128>())
        OUT_U128.volatile_store(a.to_clamp<U128>())
        return()

