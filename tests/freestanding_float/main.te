    OUT_S32.poke_volatile(s32_a.mod_trunc(s32_b))
    OUT_S32.poke_volatile(s32_a * s32_b)
    OUT_S32.poke_volatile(s32_a *% s32_b)
    OUT_S32.poke_volatile(s32_a << s32_b)
    OUT_S32.poke_volatile(s32_a >> s32_b)
    OUT_S32.poke_volatile(s32_a.rotl(s32_b))
    OUT_S32.poke_volatile(s32_a.min(s32_b))
    OUT_S32.poke_volatile(s32_a.max(s32_b))
    OUT_S32.poke_volatile(s32_a.floordiv(s32_b))
