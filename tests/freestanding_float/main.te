    OUT_B64.poke_volatile(a.ln_gamma())
    OUT_B64.poke_volatile(a.to_degrees())
    OUT_B64.poke_volatile(a.to_radians())
    OUT_B64.poke_volatile(a.mul_add(a: b, b: c))
    OUT_B64.poke_volatile(a.clamp(lo: c, hi: d))
    OUT_B64.poke_volatile(a.log(b))
    OUT_B64.poke_volatile(a.powi(n))
    OUT_BOOL.poke_volatile(a < b)
    OUT_BOOL.poke_volatile(a <= b)
    OUT_BOOL.poke_volatile(a > b)
    OUT_BOOL.poke_volatile(a >= b)
    OUT_BOOL.poke_volatile(a == b)
    OUT_BOOL.poke_volatile(a != b)
    OUT_BOOL.poke_volatile(a.is_nan())
    OUT_BOOL.poke_volatile(a.is_infinite())
    OUT_BOOL.poke_volatile(a.is_finite())
    OUT_BOOL.poke_volatile(a.is_normal())
    OUT_BOOL.poke_volatile(a.is_subnormal())
    OUT_BOOL.poke_volatile(a.is_sign_negative())
    OUT_BOOL.poke_volatile(a.is_sign_positive())
    OUT_BOOL.poke_volatile(c <= a <= d)
    OUT_BOOL.poke_volatile(c <= a < d)
    OUT_S32.poke_volatile(a.compare(b))
    OUT_S32.poke_volatile(a.total_compare(b))
    OUT_U64.poke_volatile(a.hash())
    OUT_B16.poke_volatile(a.to[B16]())
    OUT_BF16.poke_volatile(a.to[BF16]())
    OUT_B32.poke_volatile(a.to[B32]())
    OUT_B128.poke_volatile(a.to[B128]())
    OUT_S8.poke_volatile(a.to[S8]())
    OUT_S8.poke_volatile(a.to_clamp[S8]())
    OUT_S16.poke_volatile(a.to[S16]())
    OUT_S16.poke_volatile(a.to_clamp[S16]())
    OUT_S32.poke_volatile(a.to[S32]())
    OUT_S32.poke_volatile(a.to_clamp[S32]())
    OUT_S64.poke_volatile(a.to[S64]())
    OUT_S64.poke_volatile(a.to_clamp[S64]())
    OUT_S128.poke_volatile(a.to[S128]())
    OUT_S128.poke_volatile(a.to_clamp[S128]())
    OUT_U8.poke_volatile(a.to[U8]())
    OUT_U8.poke_volatile(a.to_clamp[U8]())
    OUT_U16.poke_volatile(a.to[U16]())
    OUT_U16.poke_volatile(a.to_clamp[U16]())
    OUT_U32.poke_volatile(a.to[U32]())
    OUT_U32.poke_volatile(a.to_clamp[U32]())
    OUT_U64.poke_volatile(a.to[U64]())
    OUT_U64.poke_volatile(a.to_clamp[U64]())
    OUT_U128.poke_volatile(a.to[U128]())
    OUT_U128.poke_volatile(a.to_clamp[U128]())
    return

### Every B128 operation and conversion.
routine use_b128() -> None
    inputs: @B128 = IN_B128.to[@B128]()
    a: B128 = inputs.stride(0).peek_volatile()
    b: B128 = inputs.stride(1).peek_volatile()
    c: B128 = inputs.stride(2).peek_volatile()
    d: B128 = inputs.stride(3).peek_volatile()
    n: S32 = IN_S32.to[@S32]().peek_volatile()
    OUT_B128.poke_volatile(a + b)
    OUT_B128.poke_volatile(a - b)
    OUT_B128.poke_volatile(a * b)
    OUT_B128.poke_volatile(a / b)
    OUT_B128.poke_volatile(a.mod_trunc(b))
    OUT_B128.poke_volatile(a.min(b))
    OUT_B128.poke_volatile(a.max(b))
    OUT_B128.poke_volatile(a.minimum(b))
    OUT_B128.poke_volatile(a.maximum(b))
    OUT_B128.poke_volatile(a.copysign(b))
    OUT_B128.poke_volatile(a.floordiv(b))
    OUT_B128.poke_volatile(a.mod(b))
    OUT_B128.poke_volatile(a.powf(b))
    OUT_B128.poke_volatile(hypot(x: a, y: b))
    OUT_B128.poke_volatile(atan2(y: a, x: b))
    OUT_B128.poke_volatile(-a)
    OUT_B128.poke_volatile(a.abs())
    OUT_B128.poke_volatile(a.recip())
    OUT_B128.poke_volatile(a.floor())
    OUT_B128.poke_volatile(a.ceil())
    OUT_B128.poke_volatile(a.round())
    OUT_B128.poke_volatile(a.round_ties_even())
    OUT_B128.poke_volatile(a.trunc())
    OUT_B128.poke_volatile(a.fract())
    OUT_B128.poke_volatile(a.sqrt())
    OUT_B128.poke_volatile(a.signum())
    OUT_B128.poke_volatile(a.cbrt())
    OUT_B128.poke_volatile(a.exp())
    OUT_B128.poke_volatile(a.exp2())
    OUT_B128.poke_volatile(a.exp_m1())
    OUT_B128.poke_volatile(a.ln())
    OUT_B128.poke_volatile(a.ln_1p())
    OUT_B128.poke_volatile(a.log2())
    OUT_B128.poke_volatile(a.log10())
    OUT_B128.poke_volatile(a.sin())
    OUT_B128.poke_volatile(a.cos())
    OUT_B128.poke_volatile(a.tan())
    OUT_B128.poke_volatile(a.asin())
    OUT_B128.poke_volatile(a.acos())
    OUT_B128.poke_volatile(a.atan())
    OUT_B128.poke_volatile(a.sinh())
    OUT_B128.poke_volatile(a.cosh())
    OUT_B128.poke_volatile(a.tanh())
    OUT_B128.poke_volatile(a.asinh())
    OUT_B128.poke_volatile(a.acosh())
    OUT_B128.poke_volatile(a.atanh())
    OUT_B128.poke_volatile(a.erf())
    OUT_B128.poke_volatile(a.erfc())
    OUT_B128.poke_volatile(a.gamma())
    OUT_B128.poke_volatile(a.ln_gamma())
    OUT_B128.poke_volatile(a.to_degrees())
    OUT_B128.poke_volatile(a.to_radians())
    OUT_B128.poke_volatile(a.mul_add(a: b, b: c))
    OUT_B128.poke_volatile(a.clamp(lo: c, hi: d))
    OUT_B128.poke_volatile(a.log(b))
    OUT_B128.poke_volatile(a.powi(n))
    OUT_BOOL.poke_volatile(a < b)
    OUT_BOOL.poke_volatile(a <= b)
    OUT_BOOL.poke_volatile(a > b)
    OUT_BOOL.poke_volatile(a >= b)
    OUT_BOOL.poke_volatile(a == b)
    OUT_BOOL.poke_volatile(a != b)
    OUT_BOOL.poke_volatile(a.is_nan())
    OUT_BOOL.poke_volatile(a.is_infinite())
    OUT_BOOL.poke_volatile(a.is_finite())
    OUT_BOOL.poke_volatile(a.is_normal())
    OUT_BOOL.poke_volatile(a.is_subnormal())
    OUT_BOOL.poke_volatile(a.is_sign_negative())
    OUT_BOOL.poke_volatile(a.is_sign_positive())
    OUT_BOOL.poke_volatile(c <= a <= d)
    OUT_BOOL.poke_volatile(c <= a < d)
    OUT_S32.poke_volatile(a.compare(b))
    OUT_S32.poke_volatile(a.total_compare(b))
    OUT_U64.poke_volatile(a.hash())
    OUT_B16.poke_volatile(a.to[B16]())
    OUT_BF16.poke_volatile(a.to[BF16]())
    OUT_B32.poke_volatile(a.to[B32]())
    OUT_B64.poke_volatile(a.to[B64]())
    OUT_S32.poke_volatile(a.to[S32]())
    OUT_S32.poke_volatile(a.to_clamp[S32]())
    OUT_S64.poke_volatile(a.to[S64]())
    OUT_S64.poke_volatile(a.to_clamp[S64]())
    OUT_S128.poke_volatile(a.to[S128]())
    OUT_S128.poke_volatile(a.to_clamp[S128]())
    OUT_U32.poke_volatile(a.to[U32]())
    OUT_U32.poke_volatile(a.to_clamp[U32]())
    OUT_U64.poke_volatile(a.to[U64]())
    OUT_U64.poke_volatile(a.to_clamp[U64]())
    OUT_U128.poke_volatile(a.to[U128]())
    OUT_U128.poke_volatile(a.to_clamp[U128]())
    return

### Every integer division, the multiplications and shifts LLVM may make calls of, and every integer to float.
routine use_integers() -> None
    s8_inputs: @S8 = IN_S8.to[@S8]()
    s8_a: S8 = s8_inputs.stride(0).peek_volatile()
    s8_b: S8 = s8_inputs.stride(1).peek_volatile()
    OUT_S8.poke_volatile(s8_a.div_trunc(s8_b))
    OUT_S8.poke_volatile(s8_a.mod_trunc(s8_b))
    OUT_S8.poke_volatile(s8_a * s8_b)
    OUT_S8.poke_volatile(s8_a *% s8_b)
    OUT_S8.poke_volatile(s8_a << s8_b)
    OUT_S8.poke_volatile(s8_a >> s8_b)
    OUT_S8.poke_volatile(s8_a.rotl(s8_b))
    OUT_S8.poke_volatile(s8_a.min(s8_b))
    OUT_S8.poke_volatile(s8_a.max(s8_b))
    OUT_S8.poke_volatile(s8_a.floordiv(s8_b))
    OUT_S8.poke_volatile(s8_a.mod(s8_b))
    OUT_S8.poke_volatile(s8_a.leading_zeros())
    OUT_S8.poke_volatile(s8_a.trailing_zeros())
    OUT_S8.poke_volatile(s8_a.count_ones())
    OUT_B32.poke_volatile(s8_a.to[B32]())
    OUT_B64.poke_volatile(s8_a.to[B64]())
    s16_inputs: @S16 = IN_S16.to[@S16]()
