    OUT_B64.poke_volatile(s16_a.to[B64]())
    s32_inputs: @S32 = IN_S32.to[@S32]()
    s32_a: S32 = s32_inputs.stride(0).peek_volatile()
    s32_b: S32 = s32_inputs.stride(1).peek_volatile()
