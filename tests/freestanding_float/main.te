# A program for a target without an operating system that uses every operation of every float type and every
# integer division: CI's freestanding job builds it for each such target and requires that nothing is left
# undefined. On a target without a floating-point unit LLVM turns each float operation into a call (__aeabi_fadd,
# __divdf3, __truncsfhf2, ...), and on 32-bit targets and without a divide instruction each wide division too. The
# stdlib supplies every one of them there (Standard/SoftFloat). It reads its operands from volatile globals and
# writes every result to one, so none of it folds away. Its hashes need the hash key, which it exports itself from
# the board's random number generator, as a target without an OS and without a random number instruction must.
# Like tests/freestanding, it gets the builder's entry (start, without a board step), CI links it with
# tests/freestanding's link scripts, and it never runs here (freestanding_float.arch).

global IN_B16: @Array[B16, 4]
global IN_BF16: @Array[BF16, 4]
global IN_B32: @Array[B32, 4]
global IN_B64: @Array[B64, 4]
global IN_B128: @Array[B128, 4]
global IN_S8: @Array[S8, 4]
global IN_S16: @Array[S16, 4]
global IN_S32: @Array[S32, 4]
global IN_S64: @Array[S64, 4]
global IN_S128: @Array[S128, 4]
global IN_U8: @Array[U8, 4]
global IN_U16: @Array[U16, 4]
global IN_U32: @Array[U32, 4]
global IN_U64: @Array[U64, 4]
global IN_U128: @Array[U128, 4]
global IN_BOOL: @Array[Bool, 4]
global OUT_B16: @B16
global OUT_BF16: @BF16
global OUT_B32: @B32
global OUT_B64: @B64
global OUT_B128: @B128
global OUT_S8: @S8
global OUT_S16: @S16
global OUT_S32: @S32
global OUT_S64: @S64
global OUT_S128: @S128
global OUT_U8: @U8
global OUT_U16: @U16
global OUT_U32: @U32
global OUT_U64: @U64
global OUT_U128: @U128
global OUT_BOOL: @Bool

### Stands for the data register of the board's true random number generator (a real board reads its memory-mapped
### register here, at the address its reference manual gives).
global TRNG_DATA: @U32

### Halts on a crash: there's nowhere to print and nothing to exit to.
@untraced
routine halt(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    while true
        pass

### The hash key every `hash()` below uses: the default CPUs of these targets have no random number instruction, so
### the program supplies it, 128 bits from the board's generator, 32 at a time.
@export("tessera_hash_key")
routine board_hash_key(key: @SipKey) -> None
    a: U64 = TRNG_DATA.peek_volatile().to[U64]()
    b: U64 = TRNG_DATA.peek_volatile().to[U64]()
    c: U64 = TRNG_DATA.peek_volatile().to[U64]()
    d: U64 = TRNG_DATA.peek_volatile().to[U64]()
    ((a << 32) | b).poke_into(key.k0)
    ((c << 32) | d).poke_into(key.k1)
    return

### Every B16 operation and conversion.
routine use_b16() -> None
    inputs: @B16 = IN_B16.to[@B16]()
    a: B16 = inputs.stride(0).peek_volatile()
    b: B16 = inputs.stride(1).peek_volatile()
    c: B16 = inputs.stride(2).peek_volatile()
    d: B16 = inputs.stride(3).peek_volatile()
    n: S32 = IN_S32.to[@S32]().peek_volatile()
    OUT_B16.poke_volatile(a + b)
    OUT_B16.poke_volatile(a - b)
    OUT_B16.poke_volatile(a * b)
    OUT_B16.poke_volatile(a / b)
    OUT_B16.poke_volatile(a.mod_trunc(b))
    OUT_B16.poke_volatile(a.min(b))
    OUT_B16.poke_volatile(a.max(b))
    OUT_B16.poke_volatile(a.minimum(b))
    OUT_B16.poke_volatile(a.maximum(b))
    OUT_B16.poke_volatile(a.copysign(b))
    OUT_B16.poke_volatile(a.floordiv(b))
    OUT_B16.poke_volatile(a.mod(b))
    OUT_B16.poke_volatile(a.powf(b))
    OUT_B16.poke_volatile(hypot(x: a, y: b))
    OUT_B16.poke_volatile(atan2(y: a, x: b))
    OUT_B16.poke_volatile(-a)
    OUT_B16.poke_volatile(a.abs())
    OUT_B16.poke_volatile(a.recip())
    OUT_B16.poke_volatile(a.floor())
    OUT_B16.poke_volatile(a.ceil())
    OUT_B16.poke_volatile(a.round())
    OUT_B16.poke_volatile(a.round_ties_even())
    OUT_B16.poke_volatile(a.trunc())
    OUT_B16.poke_volatile(a.fract())
    OUT_B16.poke_volatile(a.sqrt())
    OUT_B16.poke_volatile(a.signum())
    OUT_B16.poke_volatile(a.cbrt())
    OUT_B16.poke_volatile(a.exp())
    OUT_B16.poke_volatile(a.exp2())
    OUT_B16.poke_volatile(a.exp_m1())
    OUT_B16.poke_volatile(a.ln())
    OUT_B16.poke_volatile(a.ln_1p())
    OUT_B16.poke_volatile(a.log2())
    OUT_B16.poke_volatile(a.log10())
    OUT_B16.poke_volatile(a.sin())
    OUT_B16.poke_volatile(a.cos())
    OUT_B16.poke_volatile(a.tan())
    OUT_B16.poke_volatile(a.asin())
    OUT_B16.poke_volatile(a.acos())
    OUT_B16.poke_volatile(a.atan())
    OUT_B16.poke_volatile(a.sinh())
    OUT_B16.poke_volatile(a.cosh())
    OUT_B16.poke_volatile(a.tanh())
    OUT_B16.poke_volatile(a.asinh())
    OUT_B16.poke_volatile(a.acosh())
    OUT_B16.poke_volatile(a.atanh())
    OUT_B16.poke_volatile(a.erf())
    OUT_B16.poke_volatile(a.erfc())
    OUT_B16.poke_volatile(a.gamma())
    OUT_B16.poke_volatile(a.ln_gamma())
    OUT_B16.poke_volatile(a.to_degrees())
    OUT_B16.poke_volatile(a.to_radians())
    OUT_B16.poke_volatile(a.mul_add(a: b, b: c))
    OUT_B16.poke_volatile(a.clamp(lo: c, hi: d))
    OUT_B16.poke_volatile(a.log(b))
    OUT_B16.poke_volatile(a.powi(n))
    OUT_BOOL.poke_volatile(a < b)
    OUT_BOOL.poke_volatile(a <= b)
    OUT_BOOL.poke_volatile(a > b)
    OUT_BOOL.poke_volatile(a >= b)
    OUT_BOOL.poke_volatile(a == b)
    OUT_BOOL.poke_volatile(a != b)
    OUT_BOOL.poke_volatile(a.is_nan())
    OUT_BOOL.poke_volatile(a.is_infinite())
    OUT_BOOL.poke_volatile(a.is_finite())
    OUT_BOOL.poke_volatile(a.is_normal())
    OUT_BOOL.poke_volatile(a.is_subnormal())
    OUT_BOOL.poke_volatile(a.is_sign_negative())
    OUT_BOOL.poke_volatile(a.is_sign_positive())
    OUT_BOOL.poke_volatile(c <= a <= d)
    OUT_BOOL.poke_volatile(c <= a < d)
    OUT_S32.poke_volatile(a.compare(b))
    OUT_S32.poke_volatile(a.total_compare(b))
    OUT_U64.poke_volatile(a.hash())
    OUT_BF16.poke_volatile(a.to[BF16]())
    OUT_B32.poke_volatile(a.to[B32]())
    OUT_B64.poke_volatile(a.to[B64]())
    OUT_B128.poke_volatile(a.to[B128]())
    OUT_S8.poke_volatile(a.to[S8]())
    OUT_S8.poke_volatile(a.to_clamp[S8]())
    OUT_S16.poke_volatile(a.to[S16]())
    OUT_S16.poke_volatile(a.to_clamp[S16]())
    OUT_S32.poke_volatile(a.to[S32]())
    OUT_S32.poke_volatile(a.to_clamp[S32]())
    OUT_S64.poke_volatile(a.to[S64]())
    OUT_S64.poke_volatile(a.to_clamp[S64]())
    OUT_S128.poke_volatile(a.to[S128]())
    OUT_S128.poke_volatile(a.to_clamp[S128]())
    OUT_U8.poke_volatile(a.to[U8]())
    OUT_U8.poke_volatile(a.to_clamp[U8]())
    OUT_U16.poke_volatile(a.to[U16]())
    OUT_U16.poke_volatile(a.to_clamp[U16]())
    OUT_U32.poke_volatile(a.to[U32]())
    OUT_U32.poke_volatile(a.to_clamp[U32]())
    OUT_U64.poke_volatile(a.to[U64]())
    OUT_U64.poke_volatile(a.to_clamp[U64]())
    OUT_U128.poke_volatile(a.to[U128]())
    OUT_U128.poke_volatile(a.to_clamp[U128]())
    return

