// mod_euclid stays below |other|: a tiny negative remainder plus |other| rounds up to |other| itself, and the largest
// value below |other| comes back instead (it used to return |other|). An ordinary negative remainder is unchanged,
// and an infinite divisor leaves the sum as it is.

import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        h : B16  = B16.mod_euclid(-0.0001, 1.0)
        b : BF16 = BF16.mod_euclid(-0.0001, 1.0)
        s : B32  = B32.mod_euclid(-1.0e-20, 1.0)
        d : B64  = B64.mod_euclid(-1.0e-30, 1.0)
        q : B128 = B128.mod_euclid(b128_of(0xBF000000000000000000000000000000),
            b128_of(0x3FFF0000000000000000000000000000))
        Out.write("B16 {h.bits().to[U64]().lt(0x3C00)} BF16 {b.bits().to[U64]().lt(0x3F80)}\n")
        Out.write("B32 {s.lt(1.0)} B64 {d.lt(1.0)} B128 {q.lt(b128_of(0x3FFF0000000000000000000000000000))}\n")
        Out.write("B64 {d.diagnose()}, -1 mod 3 = {B64.mod_euclid(-1.0, 3.0)}, -1 mod -3 = {B64.mod_euclid(-1.0, -3.0)}\n")
        Out.write("-1 mod inf = {B64.mod_euclid(-1.0, B64.INFINITY)}\n")
        return()
