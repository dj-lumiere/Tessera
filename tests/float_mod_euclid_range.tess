// mod_euclid stays below |other|: a tiny negative remainder plus |other| rounds up to |other| itself, and the largest
// value below |other| comes back instead (it used to return |other|). An ordinary negative remainder is unchanged,
// and an infinite divisor leaves the sum as it is.

import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        h : F16  = F16.mod_euclid(-0.0001, 1.0)
        b : BF16 = BF16.mod_euclid(-0.0001, 1.0)
        s : F32  = F32.mod_euclid(-1.0e-20, 1.0)
        d : F64  = F64.mod_euclid(-1.0e-30, 1.0)
        q : F128 = F128.mod_euclid(f128_of(0xBF000000000000000000000000000000),
            f128_of(0x3FFF0000000000000000000000000000))
        Out.write("F16 {h.bits().to<U64>().lt(0x3C00)} BF16 {b.bits().to<U64>().lt(0x3F80)}\n")
        Out.write("F32 {s.lt(1.0)} F64 {d.lt(1.0)} F128 {q.lt(f128_of(0x3FFF0000000000000000000000000000))}\n")
        Out.write("F64 {d.diagnose()}, -1 mod 3 = {F64.mod_euclid(-1.0, 3.0)}, -1 mod -3 = {F64.mod_euclid(-1.0, -3.0)}\n")
        Out.write("-1 mod inf = {F64.mod_euclid(-1.0, F64.INFINITY)}\n")
        return()
