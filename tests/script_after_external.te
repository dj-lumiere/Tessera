# Script mode: a top-level line after a routine declared without a body (@external) is the script's, not the routine's.
import Standard/Hosted

### C's abs.
### :param x: The number.
### :returns: Its distance from 0.
@external("c")
@symbol("abs")
routine c_abs(x: S32) -> S32
n: S32 = -3
Console.show("{c_abs(n)}")
