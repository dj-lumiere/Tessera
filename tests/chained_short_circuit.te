# A chained comparison stops at the first comparison that is false: the operands after it are not evaluated.

import Hosted

### Shows a name and a value, and gives the value back.
### :param name: What is shown first.
### :param value: The value shown and given back.
### :returns: value.
routine seen(name: @[Byte], value: S64) -> S64
    Console.show("{name} {value}")
    return value

routine start() -> None
    first: Bool = 5 < seen("b", 2) < seen("c", 9)
    Console.show("first {first}")
    second: Bool = 1 < seen("b", 2) < seen("c", 1) < seen("d", 9)
    Console.show("second {second}")
    if 0 <= seen("index", 7) < 5
        Console.show("inside")
    else
        Console.show("outside")
    return
