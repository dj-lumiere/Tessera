# An Optional stays in the frame its entity lives in: this is a build error that says what to write.
import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### A counter for a positive count.
### :param n: The count.
### :returns: The counter.
### :throws: Throws `AbsentValueError` when the count isn't positive.
routine counter_for(n: S64) -> Counter
    if n > 0
        made: &Counter <- .construct(n)
        return made
    throw AbsentValueError()

routine start() -> None
    kept: &Optional[Counter] <- None() from HEAP
    drop kept
    return
