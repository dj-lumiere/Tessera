# An entity may be a branch of a variant: Opened and Maybe[Counter] hold one, so they move like
# one. A routine returns one (a new Counter, or return c from its slot), a when observes it and moves the Counter into
# the arm's own slot, which ends there, and a variant slot is observed with when steal.
import Hosted

define Opened = Counter | ParseFailed

### Counts things.
entity Counter
    count: S64

### Why no counter was made.
record ParseFailed
    at: S64

### A counter at `n`.
### :param n: Where it starts.
### :returns: The counter.
common routine Counter.construct(n: S64) -> Me
    return Me(count: n)

### Releases nothing: a Counter holds no memory.
routine @Counter.destruct() -> None
    return

### Counts one more.
routine @Counter.bump() -> None
    (me.count.peek() + 1).poke_into(me.count)
    return

### The count so far.
### :returns: The count.
routine @Counter.read() -> S64
    n: S64 = me.count.peek()
    return n

### A counter at `n`, or why not: a negative `n` fails.
### :param n: Where it starts.
### :returns: The counter, or the failure.
routine open(n: S64) -> Opened
    if n < 0
        return ParseFailed(at: n)
    c: &Counter <- .construct(n)

    c.bump()
    return c

### A counter at `n` when `n` is even.
### :param n: Where it starts.
### :returns: The counter, or nothing.
routine even(n: S64) -> Maybe[Counter]
    if n % 2 == 0
        return Counter.construct(n)
    return None()

### Takes a result over and reads it.
### :param r: The result, handed over: inside, its slot.
### :returns: The count, or -1 for a failure.
routine read(r: Opened) -> S64
    when steal r
        is Counter as c =>
            n: S64 = c.read()
            drop c
            return n
        is ParseFailed => return -1

### Writes what each made.
routine start() -> None
    when open(3)
        is Counter as c =>
            c.bump()
            Console.show("opened at {c.read()}")
            drop c
        is ParseFailed as e => Console.show("failed at {e.at}")
    when open(-2)
        is Counter as c =>
            Console.show("opened at {c.read()}")
            drop c
        is ParseFailed as e => Console.show("failed at {e.at}")
    kept: &Opened <- open(10)

    Console.show("handed over: {read(r: steal kept)}")
    each n: U64 in 0 til 3
        when even(n.to[S64]())
            is Counter as c =>
                Console.show("even {c.read()}")
                drop c
            is None => Console.show("odd {n}")
    return
