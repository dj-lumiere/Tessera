# What a failable routine throws stays inside the list its @throws writes.

crashable ListedError
    nothing

crashable OtherError
    nothing

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine ListedError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("listed")
    return

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine OtherError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("other")
    return

@throws([ListedError])
failable routine pick(n: S64) -> S64
    if n == 1
        throw ListedError()
    if n == 2
        throw OtherError()
    return n

routine start() -> None
    when check pick(3)
        is S64 => return
        is Crashables => return
