# The same two threads with the deadlock check off: each takes one element and gives up on the other after a while
# (AccessManager.take with a deadline), so the program ends, and neither got its second access.

import Hosted

record Pair
    first: U64
    second: U64
    ready: Unbroken[U64]
    done: Unbroken[U64]

routine take_second(at: @U64) -> Bool
    lateinit place: &SourceLocation

    deadline: Duration = Clock.monotonic() +^ 100ms
    got: Bool = AccessManager.take(request: AccessRequest(at, size: 8, mode: ACCESS_WRITE),
        deadline, place)
    if got
        AccessManager.give_back(at)
    return got

routine meet(pair: @Pair, count: @Unbroken[U64]) -> None
    count.fetch_add(1)
    until count.peek() >= 2
        waitfor(1ms)
    then
        return

routine forward(pair: @Pair) -> Bool
    first: Authorized[U64] <- pair.first.get_exclusive_access()
    meet(pair, count: pair.ready)
    got: Bool = take_second(pair.second)
    meet(pair, count: pair.done)
    drop first
    return got

routine backward(pair: @Pair) -> Bool
    second: Authorized[U64] <- pair.second.get_exclusive_access()
    meet(pair, count: pair.ready)
    got: Bool = take_second(pair.first)
    meet(pair, count: pair.done)
    drop second
    return got

routine start() -> None
    pair: &Pair <- Pair(first: 0, second: 0, ready: .construct(value: 0),
        done: .construct(value: 0))

    a: Thread[Bool] <- get_thread[Bool]()
    b: Thread[Bool] <- get_thread[Bool]()
    work_a: Work[Bool] = forward.to[Work](pair: pair)
    a.put_work(work_a)
    work_b: Work[Bool] = backward.to[Work](pair: pair)
    b.put_work(work_b)
    either: Bool = a.retrieve() or b.retrieve()
    drop a
    drop b
    Console.show("one of them got its second access: {either}")
    return
