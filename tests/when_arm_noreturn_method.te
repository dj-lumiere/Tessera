# A value when's arm that calls a routine on a type that never returns (Crash.stop) fits a value of any type.

import Hosted

### Picks the value for `k`, and stops for any other.
### :param k: The key.
### :returns: The value.
routine pick(k: S64) -> S64
    v: S64 = when k
        1 => 10
        else => Crash.stop()
    return v

routine start() -> None
    Console.show("{pick(1)}")
    return
