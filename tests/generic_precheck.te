# What a generic body may call, checked before any instantiation: the record's require holds in every routine on
# it, a refining concept gives what it refines, a conform's when gives the routines that meet it, and a conversion
# picked by a type parameter (`x.to[T]()`) waits for the instance.

import Hosted

### The largest value offered so far. Every routine on it may compare values, since the record requires it.
record Best[T]
needs RecordType T, T obeys Comparable
    value: T

record Pair[T]
needs RecordType T
obeys Equatable[Pair[T]] when T obeys Equatable
    first: T
    second: T

### Makes a `Best` from its fields.
### :param value: Its `value`.
### :returns: The new value.
common routine Best[T].construct(value: T) -> Me
    return Me(value)

### Releases nothing: a `Best` holds no memory of its own.
routine @Best[T].destruct() -> None
    return

### Makes a `Pair` from its fields.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
common routine Pair[T].construct(first: T, second: T) -> Me
    return Me(first, second)

### Releases nothing: a `Pair` holds no memory of its own.
routine @Pair[T].destruct() -> None
    return

routine @Best[T].offer(x: T) -> None
    current: T = me.value.peek()
    order: S32 = x.compare(current)
    if order > 0
        me.value.poke(x)
        return
    else
        return

### HashEquatable[T] refines Equatable[T] and Hashable[T], so both eq and hash are in force.
routine same_hash[T](a: T, b: T) -> Bool
needs T obeys HashEquatable
    if a == b
        ha: U64 = a.hash()
        hb: U64 = b.hash()
        return ha == hb
    else
        return false

routine Pair[T].eq(other: Me) -> Bool
needs T obeys Equatable
    if me.first == other.first
        return me.second == other.second
    else
        return false

### Equatable[Pair[T]] holds when Equatable[T] does, which `same` has.
routine same[T](a: Pair[T], b: Pair[T]) -> Bool
needs RecordType T, T obeys Equatable
    return a == b

routine halve[T](x: S64) -> T
    half: S64 = x.div_trunc(2)
    r: T = half.to[T]()
    return r

routine start() -> None
    best: &Best[S64] <- (value: 3)

    seven: S64 = 7
    best.offer(seven)
    two: S64 = 2
    best.offer(two)
    top: S64 = best.value.peek()
    word: U64 = 41
    hash: Bool = same_hash(a: word, b: word)
    p: Pair[S64] = (first: 1, second: 2)
    q: Pair[S64] = (first: 1, second: 3)
    pp: Bool = same(a: p, b: p)
    pq: Bool = same(a: p, b: q)
    h: B64 = halve[B64](top)
    Console.show("{top} {hash} {pp} {pq} {h}")
    return
