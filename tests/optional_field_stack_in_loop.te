# A loop body that fills a field Node? from STACK would put every pass's node in the same frame slot: a build error.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

routine start() -> None
    first: &Node <- Node.construct(1)
    each i in 0 til 2
        drop first.next
        first.next <- Node.construct(2) from STACK
    return
