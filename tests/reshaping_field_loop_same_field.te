# A routine that moves the memory of the field being walked is not allowed in the loop, even when it names the field.

import Collections
import Hosted

### A box with two lists.
entity Box
    rows: List[List[U64]]
    log: List[U64]

### A box with empty lists.
### :returns: The box.
common routine Box.construct() -> Me
    return Me(rows: .construct(HEAP), log: .construct(HEAP))

### Adds to the rows.
### :param x: The value.
@reshaping(me.rows)
routine @Box.grow(x: U64) -> None
    row: &List[U64] <- .construct(HEAP)
    row.add_last(x)
    me.rows.add_last(steal row)
    return

routine start() -> None
    b: &Box <- .construct()
    row: &List[U64] <- .construct(HEAP)
    row.add_last(1)
    b.rows.add_last(steal row)
    for x in b.rows.getslot(0).emitter()
        b.grow(x)
    Console.show(b.rows.count())
    return
