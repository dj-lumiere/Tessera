# The view of a List borrowed in a loop body, kept from the first pass and read after the loop: the body gives the
# List back on every pass.

import Standard/Os
import Standard/Collections

### Reads a list that is gone.
routine start() -> None
    p: &@[S64] <- .hollow()
    each i: S64 in 0 til 3
        xs: &List[S64] <- .construct(HEAP)
        xs.add_last(i + 1234567)
        if i == 0
            p.store(xs.getview())
    q: @[S64] = p.load()
    Console.show("kept: {q[0]}")
    return
