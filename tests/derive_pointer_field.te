# A pointer isn't Representable or Diagnosable, but a record with a pointer field still derives both: the derived
# routines write the field's address, through to[Addr](). A variant's pointer branch does the same without asking.
# Only hollow addresses are printed, since a real one changes from run to run.

import Standard/Format
import Standard/Os

@derive(Representable, Diagnosable)
record Node
    value: S64
    next: @Node

variant Link
    None
    @Node

### Makes a `Node` from its fields.
### :param value: Its `value`.
### :param next: Its `next`.
### :returns: The new value.
routine Node.construct(value: S64, next: @Me) -> Me
    return Me(value, next)

### Releases nothing: a `Node` holds no memory of its own.
routine Node.destruct(me: @Me) -> None
    return

### Releases nothing: a `Link` holds no memory of its own.
routine Link.destruct(me: @Me) -> None
    return

routine start() -> None
    local tail: @Node <- Node(value: 2, next: .hollow())

    node: Node = tail.peek()
    Out.write("{node}\n")
    Out.write("{node.diagnose()}\n")
    link: Link = Ptr[Node].hollow()
    end: Link = None()
    Out.write("{link} {end}\n")
    Out.write("{link.diagnose()}\n")
    return
