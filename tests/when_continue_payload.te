# `continue` on the one arm of a `when` that doesn't leave the block keeps the value that arm names: the lines after
# the when see it as a binding of the block, the let-else shape. A variant of three records, a Maybe in a loop, and a
# Result whose failure leaves through a finish block.

import Standard/Collections
import Standard/Os

record Circle
    radius: S64

record Square
    side: S64

record Empty
    nothing

variant Shape
    Circle
    Square
    Empty

### The area of a circle (3 for pi), and 0 for anything else.
routine circle_area(shape: Shape) -> S64
    circle: Circle = when shape
        is Circle as circle => circle
        is Square => return 0
        is Empty => return 0
    squared: S64 = circle.radius * circle.radius
    return squared * 3

### The sum of the list, read through its iterator until it runs out.
routine sum(list: @List[S64]) -> S64
    iter: &ListIter[S64] <- .construct(list)
    total: &S64 <- 0

    loop
        item: Maybe[S64] = try iter.emit()
        value: S64 = when item
            is S64 as value => value
            is None => return total.load()
        (total.load() + value).poke_into(total)

### The text as a number, or -1 when it isn't one.
routine number_or_minus_one(text: @[Byte]) -> S64
    parsed: Check[S64] = check text.to[S64]()
    result: S64 = when parsed
        is S64 as number =>
            doubled: S64 = number * 2
            becomes doubled.div_trunc(2)
        is Crashables => -1
    return result

routine start() -> None
    a: S64 = circle_area(Circle(radius: 4))
    b: S64 = circle_area(Square(side: 4))
    Console.show("areas {a} {b}")
    list: &List[S64] <- .construct()
    list.add_last(5)
    list.add_last(7)
    list.add_last(30)
    total: S64 = sum(list)
    Console.show("sum {total}")
    drop list
    good: S64 = number_or_minus_one("42")
    bad: S64 = number_or_minus_one("x")
    Console.show("parsed {good} {bad}")
    return
