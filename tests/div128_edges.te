# U128 / S128 division and remainder at the edges. A 64-bit target divides with Knuth's algorithm D on U64 limbs
# (Div128.te), a 32-bit one with the same algorithm on 32-bit limbs (Div256.te), and both must print the same:
# divisors at every limb boundary, divisors larger than the dividend, steps that need Knuth's add-back, and S128.MIN
# against 1, MAX, and itself. Each line also checks quotient * divisor + remainder = dividend and that the remainder
# is smaller than the divisor (with the dividend's sign). The crashes, a zero divisor and MIN / -1, are
# div128_by_zero.te, div128_signed_by_zero.te, and div128_min_neg_one.te.

import Standard/Format
import Standard/Os

routine verdict(ok: Bool) -> @[Byte]
    if ok
        return "ok"
    else
        return "WRONG"

routine unsigned(label: @[Byte], u: U128, d: U128) -> None
    q: U128 = u // d
    r: U128 = u % d
    back: U128 = q *% d +% r
    ok: Bool = back == u and r < d
    Console.show("{label}: {q} rem {r} {verdict(ok)}")
    return

routine signed(label: @[Byte], u: S128, d: S128) -> None
    q: S128 = u.div_trunc(d)
    r: S128 = u.mod_trunc(d)
    back: S128 = q *% d +% r
    smaller: Bool = r.abs_diff(0) < d.abs_diff(0)
    r_sign: Bool = (r < 0) == (u < 0)
    same: Bool = r_sign or r == 0
    exact: Bool = back == u and smaller
    ok: Bool = exact and same
    Console.show("{label}: {q} rem {r} {verdict(ok)}")
    return

routine start() -> None
    unsigned(label: "max / 1", u: 340282366920938463463374607431768211455, d: 1)
    unsigned(label: "max / max", u: 340282366920938463463374607431768211455,
        d: 340282366920938463463374607431768211455)
    unsigned(label: "max / 2", u: 340282366920938463463374607431768211455, d: 2)
    unsigned(label: "max / 3", u: 340282366920938463463374607431768211455, d: 3)
    unsigned(label: "max / (2^32 - 1)", u: 340282366920938463463374607431768211455, d: 4294967295)
    unsigned(label: "max / 2^32", u: 340282366920938463463374607431768211455, d: 4294967296)
    unsigned(label: "max / (2^32 + 1)", u: 340282366920938463463374607431768211455, d: 4294967297)
    unsigned(label: "max / (2^64 - 1)", u: 340282366920938463463374607431768211455,
        d: 18446744073709551615)
    unsigned(label: "max / 2^64", u: 340282366920938463463374607431768211455,
        d: 18446744073709551616)
    unsigned(label: "max / (2^64 + 1)", u: 340282366920938463463374607431768211455,
        d: 18446744073709551617)
    unsigned(label: "max / (2^96 + 12345)", u: 340282366920938463463374607431768211455,
        d: 79228162514264337593543962681)
    unsigned(label: "max / (2^127 + 1)", u: 340282366920938463463374607431768211455,
        d: 170141183460469231731687303715884105729)
    unsigned(label: "2^127 / (2^127 - 1)", u: 170141183460469231731687303715884105728,
        d: 170141183460469231731687303715884105727)
    unsigned(label: "2^96 / (2^64 - 1)", u: 79228162514264337593543950336, d: 18446744073709551615)
    unsigned(label: "(2^64 + 5) / 7", u: 18446744073709551621, d: 7)
    unsigned(label: "2^64 / (2^64 + 1)", u: 18446744073709551616, d: 18446744073709551617)
    unsigned(label: "5 / 7", u: 5, d: 7)
    unsigned(label: "0 / 7", u: 0, d: 7)
    unsigned(label: "(2^128 - 2^64) / (2^64 + 2^32)", u: 340282366920938463444927863358058659840,
        d: 18446744078004518912)
    unsigned(label: "add-back, three-limb divisor", u: 170141183420855150474555134919112130560,
        d: 39614081257132168796771975169)
    unsigned(label: "add-back, shifted", u: 170141183460469231731687303715884105731,
        d: 9903520314283042199192993793)
    unsigned(label: "knuth q-hat high", u: 340282366920938463426481119284349108224,
        d: 79228162514264337593543950335)
    signed(label: "min / 1", u: -170141183460469231731687303715884105728, d: 1)
    signed(label: "min / min", u: -170141183460469231731687303715884105728,
        d: -170141183460469231731687303715884105728)
    signed(label: "min / max", u: -170141183460469231731687303715884105728,
        d: 170141183460469231731687303715884105727)
    signed(label: "max / min", u: 170141183460469231731687303715884105727,
        d: -170141183460469231731687303715884105728)
    signed(label: "min / 2", u: -170141183460469231731687303715884105728, d: 2)
    signed(label: "min / -2", u: -170141183460469231731687303715884105728, d: -2)
    signed(label: "min / 3", u: -170141183460469231731687303715884105728, d: 3)
    signed(label: "min / -7", u: -170141183460469231731687303715884105728, d: -7)
    signed(label: "-7 / 2", u: -7, d: 2)
    signed(label: "7 / -2", u: 7, d: -2)
    signed(label: "-7 / -2", u: -7, d: -2)
    signed(label: "max / -1", u: 170141183460469231731687303715884105727, d: -1)
    signed(label: "-(2^64) / (2^64 + 1)", u: -18446744073709551616, d: 18446744073709551617)
    signed(label: "-2^100 / 2^33", u: -1267650600228229401496703205376, d: 8589934592)

    # The forms that don't crash: None for a zero divisor or MIN / -1, and the wrapping quotient.
    max: U128 = U128.MAX
    min: S128 = S128.MIN
    zero: U128 = 0
    Console.show("max.floordiv_checked(0): {max.floordiv_checked(zero).diagnose()}")
    Console.show("min.floordiv_checked(-1): {min.floordiv_checked(-1).diagnose()}")
    Console.show("min.mod_checked(-1): {min.mod_checked(-1).diagnose()}")
    Console.show("min.floordiv_wrap(-1): {min.floordiv_wrap(-1)}")
    Console.show("min.mod_wrap(-1): {min.mod_wrap(-1)}")
    return
