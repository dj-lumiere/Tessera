# A ticket destructed before it is given back crashes with TicketNotGivenBackError: its thread would be lost.

import Standard/Os

routine one() -> U64
    return 1

routine start() -> None
    t: &Thread[U64] <- get_thread[U64]()

    t.load().put_work(entry: one.to[Callable]())
    t.load().wait_finished()
    drop t
    return
