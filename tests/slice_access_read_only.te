# The view of a run's shared read access reads only: a poke through it is a build error.

import Standard/Os

### Writes through the view of a shared read access to a run.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3] * 1 from HEAP
    reading: ReadAuthorizedSlice[S64] <- numbers.get_shared_read_access()
    view: @[S64] = reading.getview()
    view.getslot(0).poke(9)
    drop reading
    drop numbers
    return
