# A parameter written `failable Callable[...]` takes a failable routine value: the call that hands one over fails the
# way the value does, so try and check in front of it receive the value's failure. Handed a plain value, the same
# routine never fails.

import Hosted

crashable OddError
    value: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine OddError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.value} is odd")
    return

### Half of an even n.
### :param n: The number.
### :returns: Its half.
failable routine half(n: S64) -> S64
    if n % 2 != 0
        throw OddError(value: n)
    return n // 2

### n plus one.
### :param n: The number.
### :returns: n + 1.
routine next(n: S64) -> S64
    return n + 1

### f of x, plus 100: f's failure goes on to the caller.
### :param f: The routine.
### :param x: Its argument.
### :returns: f(x) + 100.
routine apply(f: failable Callable[(S64,), S64], x: S64) -> S64
    y: S64 = when check f.call(x)
        is S64 as v => v
    return y + 100

### What a Check holds, in words.
### :param c: The Check.
### :returns: The words.
routine said(c: Check[S64]) -> @[Byte]
    when c
        is S64 => return "a value"
        is OddError => return "OddError"

routine start() -> None
    Console.show("plain: {apply(f: next.to[Callable](), x: 1)}")
    when check apply(f: half.to[Callable](), x: 8)
        is S64 as v => Console.show("half of 8: {v}")
        is OddError as e => Console.show("half of 8 failed: {e.value}")
    when check apply(f: half.to[Callable](), x: 7)
        is S64 as v => Console.show("half of 7: {v}")
        is OddError as e => Console.show("half of 7 failed: {e.value} is odd")
    when try apply(f: (x) => 10 // x, x: 0)
        is S64 as v => Console.show("10 // 0: {v}")
        is None => Console.show("10 // 0: none")
    when try apply(f: (x) => 10 // x, x: 5)
        is S64 as v => Console.show("10 // 5: {v}")
        is None => Console.show("10 // 5: none")
    Console.show("then: {said(check apply(f: half.to[Callable](), x: 3))}")
    return
