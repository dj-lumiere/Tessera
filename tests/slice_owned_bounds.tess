// Memory[T].getslot on memory from the default heap checks the index: an address past the end crashes with
// IndexOutOfBoundsError at the caller's line, through the pointer receiver too.

import Standard/Alloc
import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\nat line {place.line.peek()}\n")
    exit(3)

routine start() -> None
    local values: @Memory[S64] <- .construct(2)
    values.getslot(1).poke(7)
    Out.write("values[1] = {values.getslot(1).peek()}\n")
    values.getslot(2).poke(8)
    Out.write("not reached\n")
    drop values
    return
