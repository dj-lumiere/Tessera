routine hex(out: @FdWriter, x: F128) -> Void
    block entry():
        x.bits().represent_hex(out)
        write(out, " ")
        return()

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()
        jump loop(0, out)

    block loop(i: USize, out: @FdWriter):
        done : Bool = i.ge(204)
        branch done
            ? return(0)
            : one(i, out)

    block one(i: USize, out: @FdWriter):
        a_bits : U128 = ROUND_A.get(i)
        b_bits : U128 = ROUND_B.get(i)
        a      : F128 = f128_of(a_bits)
        b      : F128 = f128_of(b_bits)
        hex(out, a.trunc())
        hex(out, a.floor())
        hex(out, a.ceil())
        hex(out, a.round())
        hex(out, a.round_ties_even())
        hex(out, a.fract())
        hex(out, a.min(b))
        larger : F128 = a.max(b)
        larger.bits().represent_hex(out)
        write(out, "\n")
        jump loop(i.add(1), out)
