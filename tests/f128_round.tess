routine hex(#out: Ptr<FdWriter>, %x: F128) -> Void
    block entry():
        %x.bits.format_hex(#out)
        write_str(#out, " ")
        return()

routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        jump loop(0, #out)

    block loop(%i: I64, #out: Ptr<FdWriter>):
        %done: Bool = %i.sge(204)
        branch %done ? return(0) : one(%i, #out)

    block one(%i: I64, #out: Ptr<FdWriter>):
        %a_bits: I128 := ROUND_A[%i]
        %b_bits: I128 := ROUND_B[%i]
        %a: F128 = F128.from_bits(%a_bits)
        %b: F128 = F128.from_bits(%b_bits)
        hex(#out, %a.trunc())
        hex(#out, %a.floor())
        hex(#out, %a.ceil())
        hex(#out, %a.round())
        hex(#out, %a.round_ties_even())
        hex(#out, %a.fract())
        hex(#out, %a.min(%b))
        %a.max(%b).bits.format_hex(#out)
        write_line(#out)
        jump loop(%i.add(1), #out)
