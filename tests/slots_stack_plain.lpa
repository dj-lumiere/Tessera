# A STACK Slots of plain values is given back at the end of its body like any STACK place: its elements have nothing
# to give back.
import Hosted

routine start() -> None
    letters: &Slots[Char, 2] <- ['h', 'i']
    numbers: &Slots[S64, 3] <- [1, 2, 3]
    Console.show("{letters} {numbers}")
    if numbers.getslot(0).peek() == 1
        inner: &Slots[Byte, 2] <- [0x4C, 0x75]
        Console.show("{inner}")
    return
