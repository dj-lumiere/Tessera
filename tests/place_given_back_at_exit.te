# A place borrowed from STACK (x: &T <- value) is given back by the builder at every exit of the body it is in, the
# last one borrowed first, and the value's destruct runs then. A place the program dropped early isn't given back again.

import Standard/Hosted

### Says when it ends.
entity Noisy
    name: @[Byte]

### A Noisy named `name`.
### :param name: The name it says.
### :returns: The value.
common routine Noisy.construct(name: @[Byte]) -> Me
    return Me(name)

### Says its name.
routine @Noisy.destruct() -> None
    Console.show("end {me.name.peek()}")
    return

### Returns early or late, and leaves a loop with break.
### :param early: Whether it returns before the second place.
routine run(early: Bool) -> None
    a: &Noisy <- .construct("a")
    if early
        return
    b: &Noisy <- .construct("b")
    each i in 0 til 3
        inner: &Noisy <- .construct("inner")
        if i == 1
            break
    c: &Noisy <- .construct("c")
    drop c
    Console.show("after drop")
    return

routine start() -> None
    run(early: true)
    Console.show("--")
    run(early: false)
    return
