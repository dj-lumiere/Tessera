// #layout(dense) packs a record's fields with no padding and alignment 1, as a wire format or a packed register
// block needs. With align: N it keeps the packing but aligns the whole record. A dense record inside a C-layout one
// sits at any byte. A field at an unaligned offset is read and written in place with the alignment it has. A Ptr taken
// from it assumes its type's alignment (the author's to keep), so it reads with load_unaligned / store_unaligned.

import Standard::Format
import Standard::Os

#layout(dense)
record Packet
    tag   : U8
    value : U32
    count : U16

#layout(dense, align: 8)
record Padded
    tag   : U8
    value : U32

record Outer
    first  : U8
    packet : Packet
    last   : U8

routine start() -> Void
    block entry()
        Out.write("{sizeof<Packet>()} {alignof<Packet>()} {sizeof<Padded>()} {alignof<Padded>()} {sizeof<Outer>()}\n")
        claim p : @Packet <- uninit
        p.tag.store(0xAB)
        p.value.store(0x11223344)
        p.count.store(0x5566)
        bytes : @U8 = p.to<@U8>()
        Out.write("{bytes.stride(0).load()} {bytes.stride(1).load()} {bytes.stride(4).load()} {bytes.stride(5).load()} {bytes.stride(6).load()}\n")
        Out.write("{p.value.load()} {p.count.load()}\n")
        claim o : @Outer <- uninit
        o.first.store(1)
        o.packet.value.store(7)
        o.last.store(9)
        whole : Packet = o.packet.load()
        Out.write("{o.packet.value.load()} {whole.value} {o.last.load()}\n")
        // bytes 1..4 of the packet hold value. Read them back through a plain pointer
        at : @U32 = bytes.stride(1).to<@U32>()
        Out.write("{at.load_unaligned()}\n")
        at.store_unaligned(0x0A0B0C0D)
        Out.write("{p.value.load()}\n")
        field : @U32 = p.value
        Out.write("{field.load_unaligned()}\n")
        return()
