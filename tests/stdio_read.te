# Console.ask[T]() reads the next word of standard input as a T, in place in the input buffer: numbers across lines and
# of several types, a word that isn't a T received with check, the _checked form to the end of the input, and a
# number that runs past the end of the first 8192 bytes read (its start is moved to the front of the buffer and the
# rest read after it). At the end, ask_checked[T]() is None and check ask[T]() holds an EndOfInputError.

import Standard/Os

### Adds every remaining word of standard input, read as an S64.
routine sum_rest() -> S64
    while true with total: S64 = 0
        next: Maybe[S64] = Console.ask_checked[S64]()
        when next
            is S64 as n => continue with total: total + n
            is None => return total

routine start() -> None
    a: S32 = Console.ask[S32]()
    b: S32 = Console.ask[S32]()
    Console.show("a + b = {a.add(b)}")
    x: B64 = Console.ask[B64]()
    Console.show("x = {x}")
    word: Check[S32] = check Console.ask[S32]()
    when word
        is S32 as n =>
            set_exit_code(n)
            return
        is Crashables as error =>
            Console.show("abc as S32: {error.name()}")
            total: S64 = sum_rest()
            Console.show("sum of the rest: {total}")
            last: Maybe[S32] = Console.ask_checked[S32]()
            Console.show("after the end: {last.diagnose()}")
            when check Console.ask[S32]()
                is S32 => Console.show("read after the end: a number")
                is Crashables as ended => Console.show("read after the end: {ended.name()}")
            return
