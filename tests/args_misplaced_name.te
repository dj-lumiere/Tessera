# A value called like another parameter, in a slot that isn't its own, needs a label.

import Hosted

routine move(count: S32, from: Char, tmp: Char, to: Char) -> None
    Console.show("{count}: {from} {tmp} {to}")
    return

routine start() -> None
    from: Char = 'a'
    tmp: Char = 'b'
    to: Char = 'c'
    move(1, from, to, tmp)
    return
