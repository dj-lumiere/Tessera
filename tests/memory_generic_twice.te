# A generic routine gives the same memory back twice.

import Standard/Os

### Gives `x` back twice.
### :param x: The value.
routine twice[T](x: T) -> None
    drop x
    drop x
    return

routine start() -> None
    local m: @Memory[S64] <- [1] * 4 at HEAP

    twice[Memory[S64]](x: steal m)
    Console.show("done")
    return
