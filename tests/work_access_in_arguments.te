# An access borrowed right in the arguments of to[Work] has no name that gives it back: it is borrowed in a name first,
# and dropped after the ticket's retrieve.

import Hosted

global COUNT: &U64 <- 0

### Adds one.
### :param count: The access to the count.
routine bump(count: Authorized[U64]) -> None
    view: @U64 = count.getview()
    (view.peek() + 1).poke_into(view)
    return

routine start() -> None
    t: Thread[None] <- get_thread[None]()
    work: Work[None] = bump.to[Work](count: COUNT.get_exclusive_access())

    t.put_work(work)
    t.retrieve()
    drop t
    return
