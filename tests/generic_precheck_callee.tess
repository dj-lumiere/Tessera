/// A call to another generic routine must have that routine's constraints met by the ones in force: `smaller` requires
/// Comparable<T>, and `pick` has only Equatable<T>.
routine smaller<T>(a: T, b: T) -> T
require T: typename, Comparable<T>
    block entry()
        order : S32  = a.compare(b)
        first : Bool = order.le(0)
        r     : T    = first
            ? a
            : b
        return(r)

routine pick<T>(a: T, b: T) -> T
require T: typename, Equatable<T>
    block entry()
        r : T = smaller(a, b)
        return(r)

routine start() -> Void
    block entry()
        a : S64 = 3
        b : S64 = 4
        x : S64 = pick(a, b)
        return()
