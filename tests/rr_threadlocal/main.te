# Thread-locals on a board without an operating system: two threads of a ThreadManagerByRoundRobin each count to their
# own number in the same @threadlocal global, yielding between steps so the other runs in the middle, and each sees only
# its own count. The flow of run keeps its own copy, which the threads don't change, and each thread starts from the
# global's starting value.

import Standard/Unhosted

global GIC: &InterruptManagerByGic <- .hollow()
global THREADS: &ThreadManagerByRoundRobin <- .hollow()
### The threads' slots: 64 KiB, four slots of 16 KiB.
global STACKS: &Array[U64, 8192]
### Each thread's own count.
@threadlocal
global COUNT: &U64 <- 100

### The serial port of QEMU's virt machine.
### :returns: The port.
routine serial() -> Pl011
    return Pl011.construct(base: inttoptr[U64, Addr](0x09000000))

### Writes the crash's name and place on the serial port and turns the machine off.
### :param name: The crashable's name.
### :param message: Its message.
### :param place: Where it was thrown.
@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    port: &Pl011 <- serial()
    port.write("crash: {name}\n")
    psci_power_off()
    return

### Turns the virt machine's GIC on and makes the thread manager over STACKS, with a slice of 1 ms.
routine prepare_threads() -> None
    GIC.poke(InterruptManagerByGic.construct(distributor: inttoptr[U64, Addr](0x08000000),
        cpu_interface: inttoptr[U64, Addr](0x08010000)))
    GIC.start()
    THREADS.poke(ThreadManagerByRoundRobin.construct(region: STACKS, size: 64kib, stack_size: 16kib,
        slice: Duration.from_milliseconds(1), interrupts: GIC))
    return

### Counts its own COUNT up from 100 by 1 for each step, yielding after each step, then prints it.
### :param arg: How many steps, as an address.
routine counter(arg: Addr) -> None
    steps: U64 = ptrtoint[Addr, U64](arg)
    port: &Pl011 <- serial()
    each i in 0 til steps
        COUNT.poke(COUNT.peek() + 1)
        THREADS.yield_now()
    port.write("thread {THREADS.current_number()}: {COUNT.peek()}\n")
    return

### Turns the managers on and puts the reporting routine in the Crash service's slot.
routine when_power_on() -> None
    prepare_core()
    Crash.report_with(report.to[Callable]())
    return

### Sets the flow's own COUNT, runs two counters of 3 and 5 steps, and prints the flow's COUNT after them.
routine start() -> None
    port: &Pl011 <- serial()
    COUNT.poke(7)
    prepare_threads()
    THREADS.launch(entry: counter.to[Callable](), arg: inttoptr[U64, Addr](3))
    THREADS.launch(entry: counter.to[Callable](), arg: inttoptr[U64, Addr](5))
    THREADS.run()
    port.write("run's flow: {COUNT.peek()}\n")
    psci_power_off()
    return
