# A global holding a pointer starts as null, as the address of another global, or as the address of a preset (its
# read-only data): all known when the program is linked. Its own name is the address of that pointer, so its type is @@T.

import Hosted

global CELL: &U64 <- 5
global HEAD: &@U64 <- CELL
global ANY: &Addr <- CELL
global NOTHING: &@U64 <- .hollow()
global TABLE: &@Items[U64, 3] <- PRIMES

preset PRIMES: Items[U64, 3] = [2, 3, 5]

routine start() -> None
    head: @U64 = HEAD.peek()
    Console.show("{head.peek()}")
    any: Addr = ANY.peek()
    Console.show("{any.to[@U64]().peek()}")
    none: Bool = NOTHING.peek().is_hollow()
    Console.show("{none}")
    table: @Items[U64, 3] = TABLE.peek()
    Console.show("{table.getitem(2)}")
    return
