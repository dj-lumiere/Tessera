# The long check of the soft-float routines (Standard/SoftFloat), which tests/soft_float samples: every B32 bit
# pattern through square root and every conversion out of B32, every S32 and U32 into B32 and B64, every B16, and
# 2^23 random operand pairs for each B32 and B64 operation and operand mix, 2^26 random B64 values through the B64
# unary operations, and 2^24 random integers through the integer helpers and the integer-to-float conversions.
#
# The references are the host's: its B32 / B64 instructions, and LLVM's own conversions, which become instructions
# or calls to the C runtime's routines (compiler-rt or libgcc on Linux: __truncsfhf2, __truncsfbf2, __floattisf, and
# so on). A NaN result is checked against compiler-rt's rule, as tests/soft_float does, and so is a widened NaN (the
# hardware quiets a signaling one) and an out-of-range float-to-integer conversion (LLVM leaves it undefined).
# CI runs it on x86_64 Linux in release mode on every core (the soft-float-exhaustive job). The golden run skips it
# (soft_float_exhaustive.arch). Each line counts the mismatches and names the first input that had one.

import Standard/Os

### The number of checks, one mismatch counter each.
preset CHECKS: U64 = 24

### Jobs: 256 chunks of 2^24 B32 bit patterns, all B16 values, 168 chunks of 2^21 random pairs (2 widths × 7
### operations × 3 mixes × 4), 32 chunks of 2^21 random B64 values, and 8 chunks of 2^21 random integers.
preset JOBS: U64 = 465

### One thread's share: the jobs it takes (index, index + threads, ...), its random state, and its counts.
record Worker
    index: U64
    threads: U64
    seed: U64
    fails: Array[U64, CHECKS]
    firsts: Array[U64, CHECKS]

# -- operands ------------------------------------------------------------------

### splitmix64.
routine random(state: @U64) -> U64
    s: U64 = state.peek() +% 0x9E3779B97F4A7C15
    s.poke_into(state)
    z1: U64 = (s ^ (s >> 30)) *% 0xBF58476D1CE4E5B9
    z2: U64 = (z1 ^ (z1 >> 27)) *% 0x94D049BB133111EB
    r: U64 = z2 ^ (z2 >> 31)
    return r

### Two B32 operands' bits, `a` in the high half: any bits (mix 0), `b` a few exponents from `a` (1), or two tiny
### values (2).
routine operands32(state: @U64, mix: U64) -> U64
    bits: U64 = random(state)
    a: U32 = (bits >> 32).to_wrap[U32]()
    b: U32 = bits.to_wrap[U32]()
    when mix
        1 => return pack32(a, b: a ^ (b & 0x87FFFFFF))
        2 => return pack32(a: a & 0x80FFFFFF, b: b & 0x80FFFFFF)
        else => return bits

### {operands32} for B64: the second operand goes to `second`.
routine operands64(state: @U64, mix: U64, second: @U64) -> U64
    a: U64 = random(state)
    b: U64 = random(state)
    tiny: Bool = mix == 2
    low: U64 = b & 0x801FFFFFFFFFFFFF
    near: U64 = when
        mix == 1 => low ^ a
        else => b
    other: U64 = when
        tiny => low
        else => near
    other.poke_into(second)
    r: U64 = when
        tiny => a & 0x801FFFFFFFFFFFFF
        else => a
    return r

routine pack32(a: U32, b: U32) -> U64
    high: U64 = a.to[U64]() << 32
    r: U64 = high | b.to[U64]()
    return r

routine pack64(a: U64, b: U64) -> U128
    high: U128 = a.to[U128]() << 64
    r: U128 = high | b.to[U128]()
    return r

# -- B32 -----------------------------------------------------------------------

routine is_nan32(x: U32) -> Bool
    return x & 0x7FFFFFFF > 0x7F800000

### The NaN compiler-rt gives for a binary operation: the first NaN operand, quieted, or else the default NaN.
routine crt_nan32(a: U32, b: U32) -> U32
    when
        is_nan32(a) => return a | 0x00400000
        is_nan32(b) => return b | 0x00400000
        else => return 0x7FC00000

routine agree32(soft: U32, hard: U32, nan_bits: U32) -> Bool
    if is_nan32(hard)
        return soft == nan_bits
    else
        return soft == hard

### One B32 binary operation: 0 add, 1 sub, 2 mul, 3 div, 4 mod, 5 the comparisons, 6 powi.
routine check32(op: U64, a: U32, b: U32) -> Bool
    x: B32 = .from_bits(a)
    y: B32 = .from_bits(b)

    when op
        0 => return agree32(soft: soft_b32_add(a, b), hard: (x +! y).bits(),
            nan_bits: crt_nan32(a, b))
        1 => return agree32(soft: soft_b32_sub(a, b), hard: (x -! y).bits(),
            nan_bits: crt_nan32(a, b: b ^ 0x80000000))
        2 => return agree32(soft: soft_b32_mul(a, b), hard: (x *! y).bits(),
            nan_bits: crt_nan32(a, b))
        3 => return agree32(soft: soft_b32_div(a, b), hard: (x /! y).bits(),
            nan_bits: crt_nan32(a, b))
        4 => return agree32(soft: soft_b32_mod(a, b), hard: frem[B32](x, y).bits(),
            nan_bits: crt_nan32(a, b))
        5 =>
            unordered: Bool = x.is_nan() or y.is_nan()
            order: S32 = x.compare(y)
            le_want: S32 = when
                unordered => 1
                else => order
            ge_want: S32 = when
                unordered => -1
                else => order
            le_ok: Bool = soft_b32_le(a, b) == le_want
            ge_ok: Bool = soft_b32_ge(a, b) == ge_want
            un_ok: Bool = soft_b32_unordered(a, b) == unordered
            return le_ok and ge_ok and un_ok
        else =>
            low: S32 = (b & 0x3F).to_wrap[S32]()
            n: S32 = low - 32
            want: B32 = powi_model32(x, n)
            return agree32(soft: soft_b32_powi(a, n), hard: want.bits(), nan_bits: a | 0x00400000)

### compiler-rt's repeated squaring, on the hardware. A NaN result comes from a NaN base, which compiler-rt passes
### on quieted (the hardware may pass on either operand of a product of two NaNs).
routine powi_model32(x: B32, n: S32) -> B32
    loop with base: B32 = x, left: U32 = n.abs_diff(0), result: B32 = 1.0
        odd2: Bool = left & 1 == 1
        next2: B32 = when
            odd2 => result *! base
            else => result
        rest2: U32 = left >> 1
        if rest2 == 0
            if n < 0
                return 1.0 /! next2
            else
                return next2
        else
            continue with base: base *! base, left: rest2, result: next2

### Widening keeps a NaN's payload as it is, quiet or not, where the hardware quiets it.
routine widen_ok(a: U32) -> Bool
    widened: B64 = bitcast[U32, B32](a).soft_to[B64]()
    soft: U64 = widened.bits()
    if not is_nan32(a)
        return soft == fpext[B32, B64](B32.from_bits(a)).bits()
    sign: U64 = (a & 0x80000000).to[U64]()
    fraction: U64 = (a & 0x007FFFFF).to[U64]()
    signed: U64 = (sign << 32) | 0x7FF0000000000000
    want: U64 = signed | (fraction << 29)
    return soft == want

### compiler-rt's float-to-integer result as `width` bits (see tests/soft_float).
routine fix_model(x: B64, width: U32, signed: Bool) -> U128
    mask: U128 = U128.MAX >> U32.sub(128, width).to[U128]()
    negative: Bool = x.is_sign_negative()

    field: U64 = (width + 1023).to[U64]()
    limit: B64 = B64.from_bits(field << 52)
    huge: Bool = x.is_nan() or x.abs() >= limit
    when
        not signed and negative => return 0
        huge and not signed => return mask
        huge => return if negative then (mask >> 1) + 1 else mask >> 1
        else =>
            magnitude: U128 = x.abs().to_clamp[U128]()
            value: U128 = when
                negative => U128.sub_wrap(0, magnitude)
                else => magnitude
            return value & mask

routine from_s32(x: S32) -> U128
    r: U128 = x.to_wrap[U32]().to[U128]()
    return r

routine from_s64(x: S64) -> U128
    r: U128 = x.to_wrap[U64]().to[U128]()
    return r

routine from_u32(x: U32) -> U128
    r: U128 = x.to[U128]()
    return r

routine from_u64(x: U64) -> U128
    r: U128 = x.to[U128]()
    return r

routine from_s128(x: S128) -> U128
    r: U128 = x.to_wrap[U128]()
    return r

routine fix_ok32(a: U32, x: B64) -> Bool
    s32_soft: S32 = bitcast[U32, B32](a).soft_to[S32]()
    s32: Bool = from_s32(s32_soft) == fix_model(x, width: 32, signed: true)
    u32_soft: U32 = bitcast[U32, B32](a).soft_to[U32]()
    u32: Bool = from_u32(u32_soft) == fix_model(x, width: 32, signed: false)
    s64_soft: S64 = bitcast[U32, B32](a).soft_to[S64]()
    s64: Bool = from_s64(s64_soft) == fix_model(x, width: 64, signed: true)
    u64_soft: U64 = bitcast[U32, B32](a).soft_to[U64]()
    u64: Bool = from_u64(u64_soft) == fix_model(x, width: 64, signed: false)
    s128_soft: S128 = bitcast[U32, B32](a).soft_to[S128]()
    s128: Bool = from_s128(s128_soft) == fix_model(x, width: 128, signed: true)
    u128_soft: U128 = bitcast[U32, B32](a).soft_to[U128]()
    u128: Bool = u128_soft == fix_model(x, width: 128, signed: false)
    low: Bool = s32 and u32 and s64
    high: Bool = u64 and s128 and u128
    return low and high

### The checks on one B32 bit pattern, by number: 0 square root, 1 widening, 2 to B16, 3 to BF16, 4 to the
### integers, 5 the bit pattern as an S32 and a U32 into B32 and B64.
routine unary32(worker: @Worker, a: U32) -> None
    x: B32 = .from_bits(a)
    input: U64 = a.to[U64]()
    root: Bool = agree32(soft: soft_b32_sqrt(a), hard: x.sqrt_unchecked().bits(),
        nan_bits: crt_nan32(a, b: a))
    half_soft: B16 = bitcast[U32, B32](a).soft_to[B16]()
    half: Bool = half_soft.bits() == fptrunc[B32, B16](x).bits()
    brain_soft: BF16 = bitcast[U32, B32](a).soft_to[BF16]()
    brain: Bool = brain_soft.bits() == fptrunc[B32, BF16](x).bits()
    tally(worker, check: 0, ok: root, input)
    tally(worker, check: 1, ok: widen_ok(a), input)
    tally(worker, check: 2, ok: half, input)
    tally(worker, check: 3, ok: brain, input)
    tally(worker, check: 4, ok: fix_ok32(a, x: x.to[B64]()), input)
    tally(worker, check: 5, ok: from_int32(a), input)
    return

routine from_int32(a: U32) -> Bool
    s: S32 = a.to_wrap[S32]()
    f_s32_soft: B32 = s.soft_to[B32]()
    f_s32: Bool = f_s32_soft.bits() == s.to[B32]().bits()
    f_u32_soft: B32 = a.soft_to[B32]()
    f_u32: Bool = f_u32_soft.bits() == a.to[B32]().bits()
    d_s32_soft: B64 = s.soft_to[B64]()
    d_s32: Bool = d_s32_soft.bits() == s.to[B64]().bits()
    d_u32_soft: B64 = a.soft_to[B64]()
    d_u32: Bool = d_u32_soft.bits() == a.to[B64]().bits()
    return f_s32 and f_u32 and (d_s32 and d_u32)

# -- B16 -----------------------------------------------------------------------

### A B16 widened by the host, as B32 bits, a NaN by compiler-rt's rule (its payload kept as it is).
routine b16_widened(h: U16) -> U32
    x: B16 = .from_bits(h)
    if not x.is_nan()
        return fpext[B16, B32](x).bits()
    bits: U32 = h.to[U32]()
    sign: U32 = (bits & 0x8000) << 16
    payload: U32 = (bits & 0x03FF) << 13
    r: U32 = sign | 0x7F800000 | payload
    return r

### Check 6: every B16 widened, and every finite one to S128 and U128.
routine b16_all(worker: @Worker) -> None
    until bits == 0x10000 with bits: U32 = 0
        h: U16 = bits.to_wrap[U16]()
        x: B16 = .from_bits(h)
        wide_soft: B32 = bitcast[U16, B16](h).soft_to[B32]()
        wide: Bool = wide_soft.bits() == b16_widened(h)
        s128_soft: S128 = bitcast[U16, B16](h).soft_to[S128]()
        s128: Bool = s128_soft == fptosi[B16, S128](x)
        u128_soft: U128 = bitcast[U16, B16](h).soft_to[U128]()
        u128: Bool = u128_soft == b16_unsigned(x)
        finite: Bool = x.is_finite()
        ints: Bool = not finite or (s128 and u128)
        tally(worker, check: 6, ok: wide and ints, input: bits.to[U64]())
        continue with bits: bits + 1
    then
        return

### The host's B16 to U128, 0 for a negative value (where LLVM's conversion is undefined).
routine b16_unsigned(x: B16) -> U128
    if x.is_sign_negative()
        return 0
    else
        return fptoui[B16, U128](x)

# -- B64 -----------------------------------------------------------------------

routine is_nan64(x: U64) -> Bool
    return x & 0x7FFFFFFFFFFFFFFF > 0x7FF0000000000000

routine crt_nan64(a: U64, b: U64) -> U64
    when
        is_nan64(a) => return a | 0x0008000000000000
        is_nan64(b) => return b | 0x0008000000000000
        else => return 0x7FF8000000000000

routine agree64(soft: U64, hard: U64, nan_bits: U64) -> Bool
    if is_nan64(hard)
        return soft == nan_bits
    else
        return soft == hard

routine check64(op: U64, a: U64, b: U64) -> Bool
    x: B64 = .from_bits(a)
    y: B64 = .from_bits(b)

    when op
        0 => return agree64(soft: soft_b64_add(a, b), hard: (x +! y).bits(),
            nan_bits: crt_nan64(a, b))
        1 => return agree64(soft: soft_b64_sub(a, b), hard: (x -! y).bits(),
            nan_bits: crt_nan64(a, b: b ^ 0x8000000000000000))
        2 => return agree64(soft: soft_b64_mul(a, b), hard: (x *! y).bits(),
            nan_bits: crt_nan64(a, b))
        3 => return agree64(soft: soft_b64_div(a, b), hard: (x /! y).bits(),
            nan_bits: crt_nan64(a, b))
        4 => return agree64(soft: soft_b64_mod(a, b), hard: frem[B64](x, y).bits(),
            nan_bits: crt_nan64(a, b))
        5 =>
            unordered: Bool = x.is_nan() or y.is_nan()
            order: S32 = x.compare(y)
            le_want: S32 = when
                unordered => 1
                else => order
            ge_want: S32 = when
                unordered => -1
                else => order
            le_ok: Bool = soft_b64_le(a, b) == le_want
            ge_ok: Bool = soft_b64_ge(a, b) == ge_want
            un_ok: Bool = soft_b64_unordered(a, b) == unordered
            return le_ok and ge_ok and un_ok
        else =>
            low: S32 = (b & 0x3F).to_wrap[S32]()
            n: S32 = low - 32
            want: B64 = powi_model64(x, n)
            return agree64(soft: soft_b64_powi(a, n), hard: want.bits(),
                nan_bits: a | 0x0008000000000000)

routine powi_model64(x: B64, n: S32) -> B64
    loop with base: B64 = x, left: U32 = n.abs_diff(0), result: B64 = 1.0
        odd2: Bool = left & 1 == 1
        next2: B64 = when
            odd2 => result *! base
            else => result
        rest2: U32 = left >> 1
        if rest2 == 0
            if n < 0
                return 1.0 /! next2
            else
                return next2
        else
            continue with base: base *! base, left: rest2, result: next2

routine fix_ok64(a: U64, x: B64) -> Bool
    s32_soft: S32 = bitcast[U64, B64](a).soft_to[S32]()
    s32: Bool = from_s32(s32_soft) == fix_model(x, width: 32, signed: true)
    u32_soft: U32 = bitcast[U64, B64](a).soft_to[U32]()
    u32: Bool = from_u32(u32_soft) == fix_model(x, width: 32, signed: false)
    s64_soft: S64 = bitcast[U64, B64](a).soft_to[S64]()
    s64: Bool = from_s64(s64_soft) == fix_model(x, width: 64, signed: true)
    u64_soft: U64 = bitcast[U64, B64](a).soft_to[U64]()
    u64: Bool = from_u64(u64_soft) == fix_model(x, width: 64, signed: false)
    s128_soft: S128 = bitcast[U64, B64](a).soft_to[S128]()
    s128: Bool = from_s128(s128_soft) == fix_model(x, width: 128, signed: true)
    u128_soft: U128 = bitcast[U64, B64](a).soft_to[U128]()
    u128: Bool = u128_soft == fix_model(x, width: 128, signed: false)
    low: Bool = s32 and u32 and s64
    high: Bool = u64 and s128 and u128
    return low and high

### Check 21: one B64 through square root, the narrowing conversions, and the integer conversions.
routine unary64(a: U64) -> Bool
    x: B64 = .from_bits(a)
    root: Bool = agree64(soft: soft_b64_sqrt(a), hard: x.sqrt_unchecked().bits(),
        nan_bits: crt_nan64(a, b: a))
    narrow_soft: B32 = bitcast[U64, B64](a).soft_to[B32]()
    narrow: Bool = narrow_soft.bits() == fptrunc[B64, B32](x).bits()
    half_soft: B16 = bitcast[U64, B64](a).soft_to[B16]()
    half: Bool = half_soft.bits() == fptrunc[B64, B16](x).bits()
    brain_soft: BF16 = bitcast[U64, B64](a).soft_to[BF16]()
    brain: Bool = brain_soft.bits() == fptrunc[B64, BF16](x).bits()
    ints: Bool = fix_ok64(a, x)
    floats: Bool = root and narrow and half
    return floats and brain and ints

# -- integers ------------------------------------------------------------------

### Check 22: the 64- and 128-bit integers into B32, B64, and B16, against the host's conversions.
routine from_wide(bits: U64, more: U64) -> Bool
    s64: S64 = bits.to_wrap[S64]()
    wide: U128 = pack64(a: bits, b: more)
    s128: S128 = wide.to_wrap[S128]()
    f_s64_soft: B32 = s64.soft_to[B32]()
    f_s64: Bool = f_s64_soft.bits() == s64.to[B32]().bits()
    f_u64_soft: B32 = bits.soft_to[B32]()
    f_u64: Bool = f_u64_soft.bits() == bits.to[B32]().bits()
    d_s64_soft: B64 = s64.soft_to[B64]()
    d_s64: Bool = d_s64_soft.bits() == s64.to[B64]().bits()
    d_u64_soft: B64 = bits.soft_to[B64]()
    d_u64: Bool = d_u64_soft.bits() == bits.to[B64]().bits()
    f_s_soft: B32 = s128.soft_to[B32]()
    f_s: Bool = f_s_soft.bits() == s128.to[B32]().bits()
    f_u_soft: B32 = wide.soft_to[B32]()
    f_u: Bool = f_u_soft.bits() == wide.to_unchecked[B32]().bits()
    d_s_soft: B64 = s128.soft_to[B64]()
    d_s: Bool = d_s_soft.bits() == s128.to[B64]().bits()
    d_u_soft: B64 = wide.soft_to[B64]()
    d_u: Bool = d_u_soft.bits() == wide.to[B64]().bits()
    h_s_soft: B16 = s128.soft_to[B16]()
    h_s: Bool = h_s_soft.bits() == sitofp[S128, B16](s128).bits()
    h_u_soft: B16 = wide.soft_to[B16]()
    h_u: Bool = h_u_soft.bits() == uitofp[U128, B16](wide).bits()
    narrow: Bool = f_s64 and f_u64 and d_s64
    middle: Bool = d_u64 and f_s and f_u
    widest: Bool = d_s and d_u and (h_s and h_u)
    return narrow and middle and widest

### Check 23: division, multiplication, shifts, and the leading-zero count, as tests/soft_float checks them.
routine integer_ops(a: U64, b: U64, c: U64) -> Bool
    keep: U64 = c & 63
    divisor: U64 = (b >> keep) | 1
    d32: U32 = divisor.to_wrap[U32]() | 1
    wide_n: U128 = pack64(a, b: c)
    lift: U128 = (c & 64).to[U128]()
    wide_d: U128 = divisor.to[U128]() << lift
    u32_ok: Bool = divmod32(n: a.to_wrap[U32](), d: d32)
    u64_ok: Bool = divmod64(n: a, d: divisor)
    u128_ok: Bool = divmod128(n: wide_n, d: wide_d)
    mul_ok: Bool = mul_shift(a, b, n: (c & 127).to_wrap[U32]())
    return u32_ok and u64_ok and (u128_ok and mul_ok)

routine divmod32(n: U32, d: U32) -> Bool
    q, r = soft_divmod(n, d)
    sn: S32 = n.to_wrap[S32]()
    sd: S32 = d.to_wrap[S32]()
    sq, sr = soft_divmod(n: sn, d: sd)
    overflow: Bool = sn == S32.MIN and sd == -1
    unsigned: Bool = q == n // d and r == n % d
    if overflow
        return unsigned
    signed: Bool = sq == sn.div_trunc(sd) and sr == sn.mod_trunc(sd)
    return unsigned and signed

routine divmod64(n: U64, d: U64) -> Bool
    q, r = soft_divmod(n, d)
    sn: S64 = n.to_wrap[S64]()
    sd: S64 = d.to_wrap[S64]()
    sq, sr = soft_divmod(n: sn, d: sd)
    overflow: Bool = sn == S64.MIN and sd == -1
    unsigned: Bool = q == n // d and r == n % d
    if overflow
        return unsigned
    signed: Bool = sq == sn.div_trunc(sd) and sr == sn.mod_trunc(sd)
    return unsigned and signed

routine divmod128(n: U128, d: U128) -> Bool
    q, r = soft_divmod(n, d)
    sn: S128 = n.to_wrap[S128]()
    sd: S128 = d.to_wrap[S128]()
    sq, sr = soft_divmod(n: sn, d: sd)
    overflow: Bool = sn == S128.MIN and sd == -1
    unsigned: Bool = q == n // d and r == n % d
    if overflow
        return unsigned
    signed: Bool = sq == sn.div_trunc(sd) and sr == sn.mod_trunc(sd)
    return unsigned and signed

routine mul_shift(a: U64, b: U64, n: U32) -> Bool
    a32: U32 = a.to_wrap[U32]()
    b32: U32 = b.to_wrap[U32]()
    mul32: Bool = soft_mul(a: a32, b: b32) == a32 *% b32
    mul64: Bool = soft_mul(a, b) == a *% b
    amount: U64 = n.to[U64]()
    shl: Bool = soft_shl(x: a, n) == a << amount
    shr: Bool = soft_shr(x: a, n) == a >> amount
    signed: S64 = a.to_wrap[S64]()
    sar: Bool = soft_shr(x: signed, n) == signed >> amount.to_wrap[S64]()
    lead: U32 = a32 >> (n & 31)
    clz: Bool = soft_u32_leading_zeros(lead) == lead.leading_zeros()
    return mul32 and mul64 and (shl and shr and (sar and clz))

# -- the jobs ------------------------------------------------------------------

### Counts a check's result, keeping the first input that failed it.
routine tally(worker: @Worker, check: U64, ok: Bool, input: U64) -> None
    if ok
        return
    fails: U64 = worker.fails[check]
    if fails == 0
        worker.firsts[check] = input
    worker.fails[check] = fails + 1
    return

### One job: a chunk of B32 bit patterns, every B16, random pairs for one operation and mix, random B64 values, or
### random integers.
routine run_job(worker: @Worker, job: U64) -> None
    start: U64 = job << 24

    seed: U64 = job *% 0x9E3779B97F4A7C15
    seed.poke_into(worker.seed)
    when
        job < 256 =>
            until at == 0x1000000 with at: U64 = 0
                bits: U32 = (start + at).to_wrap[U32]()
                unary32(worker, a: bits)
                continue with at: at + 1
            then
                return
        job == 256 =>
            b16_all(worker)
            return
        job < 425 =>
            # 84 jobs a width: 7 operations × 3 mixes × 4 chunks of 2^21 pairs
            k: U64 = job - 257
            width: U64 = k // 84
            rest: U64 = k % 84
            op: U64 = rest // 12
            mix: U64 = rest % 12 // 4
            if width == 0
                until at == 0x200000 with at: U64 = 0
                    pair: U64 = operands32(state: worker.seed, mix)
                    a: U32 = (pair >> 32).to_wrap[U32]()
                    ok: Bool = check32(op, a, b: pair.to_wrap[U32]())
                    tally(worker, check: (op + 7).to[U64](), ok, input: pair)
                    continue with at: at + 1
                then
                    return
            else
                until at == 0x200000 with at: U64 = 0
                    second: &U64 <- 0
                    a: U64 = operands64(state: worker.seed, mix, second)
                    ok: Bool = check64(op, a, b: second.load())
                    tally(worker, check: (op + 14).to[U64](), ok, input: a)
                    continue with at: at + 1
                then
                    return
        job < 457 =>
            until at == 0x200000 with at: U64 = 0
                second: &U64 <- 0
                a: U64 = operands64(state: worker.seed, mix: at % 3, second)
                tally(worker, check: 21, ok: unary64(a), input: a)
                continue with at: at + 1
            then
                return
        else =>
            until at == 0x200000 with at: U64 = 0
                a: U64 = random(worker.seed)
                b: U64 = random(worker.seed)
                c: U64 = random(worker.seed)
                short: U64 = a >> (c & 63)
                tally(worker, check: 22, ok: from_wide(bits: short, more: b), input: a)
                tally(worker, check: 23, ok: integer_ops(a, b, c), input: a)
                continue with at: at + 1
            then
                return

### A thread's body: its jobs, index, index + threads, and so on. Each thread changes its own worker, through the
### exclusive access it takes for the run.
routine work(slot: @Worker) -> None
    held: Authorized[Worker] <- slot.get_exclusive_access()
    worker: @Worker = held.getview()
    until job >= JOBS with job: U64 = worker.index.peek()
        run_job(worker, job)
        continue with job: job + worker.threads.peek()
    then
        drop held
        return

routine check_name(check: U64) -> @[Byte]
    when check
        0 => return "every B32: square root"
        1 => return "every B32: to B64"
        2 => return "every B32: to B16"
        3 => return "every B32: to BF16"
        4 => return "every B32: to S32, U32, S64, U64, S128, U128"
        5 => return "every S32 and U32: to B32 and B64"
        6 => return "every B16: to B32, S128, U128"
        7 => return "B32 add, 3 x 2^23 pairs"
        8 => return "B32 sub, 3 x 2^23 pairs"
        9 => return "B32 mul, 3 x 2^23 pairs"
        10 => return "B32 div, 3 x 2^23 pairs"
        11 => return "B32 mod, 3 x 2^23 pairs"
        12 => return "B32 comparisons, 3 x 2^23 pairs"
        13 => return "B32 powi, 3 x 2^23 pairs"
        14 => return "B64 add, 3 x 2^23 pairs"
        15 => return "B64 sub, 3 x 2^23 pairs"
        16 => return "B64 mul, 3 x 2^23 pairs"
        17 => return "B64 div, 3 x 2^23 pairs"
        18 => return "B64 mod, 3 x 2^23 pairs"
        19 => return "B64 comparisons, 3 x 2^23 pairs"
        20 => return "B64 powi, 3 x 2^23 pairs"
        21 => return "2^26 B64: square root, to B32 / B16 / BF16, to the integers"
        22 => return "2^24 S64 / U64 / S128 / U128: to B32, B64, B16"
        else => return "2^24 integer divisions, products, shifts, leading zeros"

### A check's mismatches over every worker, and the first failing input any of them kept.
routine sum_fails(workers: @Worker, threads: U64, check: U64, first: @U64) -> U64
    each at in 0 til threads with total: U64 = 0
        worker: @Worker = workers.stride(at.to[U64]())
        fails: U64 = worker.fails[check]
        if fails != 0 and total == 0
            input: U64 = worker.firsts[check]
            input.poke_into(first)
        continue with total: total + fails
    then
        return total

routine start() -> None
    manager: @MemoryManager = HEAP
    threads: U64 = cpu_count().to[U64]()
    worker_memory: &[Worker] <- .construct(count: threads.to[U64](), manager: manager)
    handle_memory: &[Thread[None]] <- .construct(count: threads.to[U64](), manager: manager)
    workers: @Worker = worker_memory.to[@Worker]()
    handles: @Thread[None] = handle_memory.to[@Thread[None]]()

    Console.show("{threads} threads")

    each at in 0 til threads
        worker: @Worker = workers.stride(at.to[U64]())
        worker.zeroinit(1)
        at.poke_into(worker.index)
        threads.poke_into(worker.threads)
        handle: Thread[None] <- get_thread[None]()
        work_handle: Work[None] = work.to[Work](slot: worker)
        handle.put_work(work_handle)
        handles.stride(at.to[U64]()).poke(handle)

    each at in 0 til threads
        handle: Thread[None] <- handles.stride(at.to[U64]()).peek()
        handle.retrieve()
        drop handle

    each check in 0 til CHECKS with total: U64 = 0
        first: &U64 <- 0
        fails: U64 = sum_fails(workers, threads, check, first)
        name: @[Byte] = check_name(check)
        Console.show("{name}: {fails} mismatches", end: "")
        total2: U64 = when
            fails == 0 => total
            else =>
                input: U64 = first.load()
                Console.show(", first at input 0x", end: "")
                input.represent_hex_into(Console.output())
                becomes total + fails
        Console.show("")
        continue with total: total2
    then
        drop handle_memory
        drop worker_memory
        if total != 0
            set_exit_code(1)
        return
