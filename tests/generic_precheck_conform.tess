/// A conformance with type parameters is checked against the routines that meet it: Pair<T>.eq requires
/// Equatable<T>, so `conform Equatable<Pair<T>>` must say it in its when, or it claims every Pair is Equatable.
record Pair<T>
require T: typename
conform Equatable<Pair<T>>
    first  : T
    second : T

routine Pair<T>.eq(me: Me, other: Me) -> Bool
require T: typename, Equatable<T>
    block entry()
        same_first : Bool = me.first.eq(other.first)
        branch same_first
            ? second()
            : return(false)

    block second()
        r : Bool = me.second.eq(other.second)
        return(r)

routine start() -> Void
    block entry()
        return()
