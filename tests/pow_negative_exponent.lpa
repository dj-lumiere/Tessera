# An integer power takes its exponent in the base's own type: a negative one gives no whole number, so `try a ** n`
# gives None and a bare pow stops with NegativeExponentError (exit status 82).

import Hosted

routine start() -> None
    base: S64 = 3
    two: S64 = 2
    down: S64 = -1
    Console.show("{base ** two} {try base.pow(two)} {try base.pow(down)} {base.pow_wrap(two)}")
    r: S64 = base ** down
    Console.show("not reached {r}")
    return
