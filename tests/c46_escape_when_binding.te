# A when's arm name read out of an Optional holding a frame slot's address, kept in a global (Rust #144312 in Tessera).

import Hosted

lateinit global KEPT: &@S64

### Keeps the address of a local, through an Optional and a when.
routine fill() -> None
    l: &S64 <- 1234567
    m: Optional[@S64] = l.getview()

    when m
        is None => nothing
        is @S64 as p => KEPT.poke(p)
    return

### Writes over the stack.
### :param seed: The value to write.
### :returns: The sum.
routine scribble(seed: S64) -> S64
    junk: &[S64] <- [0] * 64
    sum: &S64 <- 0

    for i: U64 in 0 til 64
        junk.getslot(i).poke(seed)
    for j: U64 in 0 til 64
        sum.load().add(junk.getslot(j).peek()).poke_into(sum)
    return sum.load()

### Runs.
routine start() -> None
    fill()
    s: S64 = scribble(seed: 6666666)
    p: @S64 = KEPT.peek()
    Console.show("kept: {p.peek()} (expected 1234567, scribble sum {s})")
    return
