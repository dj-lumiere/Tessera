# Unbroken values on @T: load and store, swap, the fetch_ operations (each returns the value it replaced), strong and weak
# compare_exchange (the previous value, or the one found), the memory-order suffixes,
# several widths and kinds of T, and the fences. One thread, so the values are fixed. What's checked is that each
# operation does what it says and compiles to valid unbroken IR.

import Standard/Os

### Adds one with a weak compare-and-exchange, retrying on any failure, spurious or not.
routine increment(counter: @U32) -> U32
    loop with seen: U32 = counter.peek_unbroken_relaxed()
        next: U32 = seen + 1
        result: Maybe[U32] = counter.unbroken_compare_exchange_weak_acq_rel(expected: seen,
            new: next)
        when result
            is None => return next
            is U32 as actual => continue with seen: actual

routine start() -> None
    n: &U32 <- .hollow()

    n.poke_unbroken(5)
    a: U32 = n.unbroken_fetch_add(3)
    b: U32 = n.unbroken_fetch_sub_relaxed(1)
    c: U32 = n.unbroken_fetch_or_acq_rel(0x10)
    d: U32 = n.unbroken_fetch_and(0x1F)
    e: U32 = n.unbroken_fetch_xor_release(1)
    f: U32 = n.unbroken_swap_acquire(100)
    g: U32 = n.peek_unbroken_acquire()
    Console.show("U32 {a} {b} {c} {d} {e} {f} {g}")
    won: Maybe[U32] = n.unbroken_compare_exchange(expected: 100, new: 7)
    lost: Maybe[U32] = n.unbroken_compare_exchange(expected: 100, new: 9)
    now: U32 = n.peek_unbroken()
    Console.show("cas {won} {lost} {now}")
    bumped: U32 = increment(n)
    Console.show("weak {bumped} {n.peek_unbroken()}")

    s: &S64 <- .hollow()
    s.poke_unbroken_release(-5)
    s_old: S64 = s.unbroken_fetch_add(-10)
    Console.show("S64 {s_old} {s.peek_unbroken()}")

    small: &U8 <- .hollow()
    small.poke_unbroken(250)
    wrapped: U8 = small.unbroken_fetch_add(10)
    half: &S16 <- .hollow()
    half.poke_unbroken_relaxed(-1)
    h_old: S16 = half.unbroken_fetch_sub(32767)
    Console.show("narrow {wrapped} {small.peek_unbroken()} {h_old} {half.peek_unbroken()}")

    bits: &Byte <- .hollow()
    bits.poke_unbroken(0x0F)
    bits_old: Byte = bits.unbroken_fetch_or(0xF0)
    Console.show("Byte {bits_old.to[U8]()} {bits.peek_unbroken().to[U8]()}")

    other: &U32 <- .hollow()
    slot: &@U32 <- .hollow()
    slot.poke_unbroken(n)
    was: @U32 = slot.unbroken_swap(other)
    back: Maybe[@U32] = slot.unbroken_compare_exchange(expected: other, new: was)
    Console.show("Ptr {back.is_absent()} {slot.peek_unbroken().peek()}")

    x: &B64 <- .hollow()
    x.poke_unbroken(1.5)
    x_add: B64 = x.unbroken_fetch_fadd(2.25)
    x_sub: B64 = x.unbroken_fetch_fsub_relaxed(0.75)
    Console.show("B64 {x_add} {x_sub} {x.peek_unbroken()}")

    fence()
    fence_acquire()
    fence_release()
    compiler_fence_acq_rel()
    return
