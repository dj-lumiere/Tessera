// Each overload is its own C routine, so two can't export one C name.

#export("scale")
routine scale(n: S64) -> S64
    block entry()
        return(n.mul(2))

#export("scale")
routine scale(n: S32) -> S32
    block entry()
        return(n.mul(2))

routine main() -> S32
    block entry()
        return(0)
