# A generic routine takes memory over and never gives it back.

import Standard/Os

### Takes `x` over.
### :param x: The value.
routine keep[T](x: T) -> None
    return

routine start() -> None
    local m: @Memory[S64] <- [1] * 4 from HEAP

    keep[Memory[S64]](x: steal m)
    Console.show("done")
    return
