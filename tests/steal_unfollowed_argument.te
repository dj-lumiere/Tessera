# steal out of an element at an index that is not a constant, handed on as an argument, doesn't build either: the
# value comes out on its own line with inject.

import Collections
import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Counter(n: n)

### Ends it.
routine @Counter.destruct() -> None
    return

### Shows a counter and ends it.
### :param c: The counter, taken over.
routine show_counter(c: Counter) -> None
    Console.show(c.n)
    drop c
    return

routine start() -> None
    xs: &List[Counter] <- .construct(HEAP)
    xs.add_last(Counter.construct(n: 1))
    i: U64 = 0
    show_counter(c: steal xs.getslot(i))
    drop xs
    return
