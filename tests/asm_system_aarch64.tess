// AArch64 system registers and the words some instructions take as operands: the virtual counter by its name and by
// its generic encoding, the counter's frequency, and a prefetch and a barrier before a store.

import Standard::Format
import Standard::Os

#[target(arch: "aarch64"), external("asm")]
routine counter() -> U64
    block entry()
        isb()  // isb: the counter is read after everything before it
        mrs<U64>(R0, CNTVCT_EL0)  // mrs x0, CNTVCT_EL0
        return(R0)

#[target(arch: "aarch64"), external("asm")]
routine counter_by_encoding() -> U64
    block entry()
        isb()  // isb
        mrs<U64>(R0, S3_3_C14_C0_2)  // mrs x0, CNTVCT_EL0, by op0, op1, CRn, CRm and op2
        return(R0)

#[target(arch: "aarch64"), external("asm")]
routine frequency() -> U64
    block entry()
        mrs<U64>(R0, CNTFRQ_EL0)  // mrs x0, CNTFRQ_EL0
        return(R0)

#[target(arch: "aarch64"), external("asm")]
routine publish(cell: @U64, value: U64) -> Void
    block entry()
        prfm<U64>(PSTL1KEEP, cell.offset(0))  // prfm pstl1keep, [<cell's register>]
        dmb(ISH)  // dmb ish
        str<U64, U64>(value, cell.offset(0))  // str <value's register>, [<cell's register>]
        return()

routine start() -> Void
    block entry()
        first  : U64 = counter()
        second : U64 = counter_by_encoding()
        third  : U64 = counter()
        Out.write("counter advances: {second.ge(first)} {third.ge(second)}\n")
        ticks : U64 = frequency()
        Out.write("frequency set: {ticks.gt(0)}\n")
        claim cell : @U64 <- 0
        publish(cell, 42)
        Out.write("published {cell.load()}\n")
        return()
