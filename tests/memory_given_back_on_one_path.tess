// Memory is given back on every path: here one branch drops it and the other returns without.

import Standard/Os

routine start() -> Void
    local m: Memory[Byte] <- [0x00] x 4 at DEFAULT_HEAP

    branch m.count().eq(4)
        ? a()
        : b()

    block a()
        m.drop()
        return()

    block b()
        return()
