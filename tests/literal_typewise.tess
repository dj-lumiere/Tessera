// A method called through its type names the type of literal operands: S64.eq(0, 1) is 0.eq(1) as S64s.

import Standard::Format

routine main() -> S32
    block entry():
        %same   : Bool = S64.eq(0, 1)
        %big    : U128 = U128.shl(1, 100)
        %sum    : U8   = U8.add_wrap(200, 100)
        %shifts : U64  = 1.shl(40)  // the result's type is the literal's: shl returns Self
        print("{%same} {%big} {%sum} {%shifts}\n")
        return(0)
