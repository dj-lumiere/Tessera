# A longer chain, a < f() <= g() < d: each call runs once, in order, and the last comparison decides.

import Hosted

### Shows a name and a value, and gives the value back.
### :param name: What is shown first.
### :param value: The value shown and given back.
### :returns: value.
routine seen(name: @[Byte], value: S64) -> S64
    Console.show("{name} {value}")
    return value

routine start() -> None
    a: S64 = 1
    d: S64 = 10
    yes: Bool = a < seen("f", 3) <= seen("g", 3) < d
    Console.show("yes {yes}")
    no: Bool = a < seen("f", 3) <= seen("g", 12) < d
    Console.show("no {no}")
    eq: Bool = seen("p", 4) == seen("q", 4) <= seen("r", 5) < seen("s", 6) == 6
    Console.show("eq {eq}")
    return
