# BitList: growth across byte boundaries, the clear high bits of the last byte after remove_last, set_all and
# flip_all, counting, searching, combining in place, iteration, and the checked forms.

import Standard/Collections
import Standard/Os

### Writes the positions of the set bits, found with first_true and next_true.
### :param bits: The list to search.
routine show_set(bits: @BitList) -> None
    Console.show("set at:", end: "")
    loop with found: Maybe[U64] = bits.first_true()
        when found
            is U64 as at =>
                Console.show(" {at}", end: "")
                continue with found: bits.next_true(after: at)
            is None => break
    Console.show("")
    return

### Counts the true bits by walking a BitListIter.
### :param bits: The list to walk.
### :returns: The number of true bits the iterator yields.
routine count_by_iter(bits: @BitList) -> U64
    iter: &BitListIter <- .construct(bits)

    each bit in iter with total: U64 = 0
        if bit
            continue with total: total + 1
        continue with total: total
    then
        return total

routine start() -> None
    manager: @MemoryManager = HEAP
    bits: &BitList <- .construct(manager)
    other: &BitList <- .construct(manager)

    Console.show("empty: {bits.is_empty()} {bits.count()} {bits.capacity()} {bits}")
    Console.show("empty checks: {bits.is_any_true()} {bits.is_all_true()} {bits.is_none_true()} {bits.has(true)}")

    # Every third bit set, across three bytes.
    each i: U64 in 0 til 20
        bits.add_last(i % 3 == 0)
    Console.show("20 bits: {bits.count()} cap {bits.capacity()}")
    Console.show("{bits}")
    Console.show("ones {bits.count_trues()} zeros {bits.count_falses()}")
    Console.show("[0] {bits[0]} [1] {bits[1]} [18] {bits[18]} [19] {bits[19]}")
    show_set(bits)
    Console.show("by iterator: {count_by_iter(bits)}")

    # Growing past the first 8 bytes.
    each i: U64 in 0 til 60
        bits.add_last(true)
    Console.show("80 bits: {bits.count()} cap {bits.capacity()} ones {bits.count_trues()}")
    each i: U64 in 0 til 60
        bits.remove_last()
    Console.show("back to {bits.count()}: ones {bits.count_trues()} {bits}")

    # set_all, then remove_last: the removed bits are cleared, so adding false reads false.
    bits.set_all(true)
    Console.show("set_all: ones {bits.count_trues()} all {bits.is_all_true()}")
    last: Bool = bits.remove_last()
    Console.show("removed {last}, ones {bits.count_trues()} of {bits.count()}")
    bits.add_last(false)
    Console.show("added false: [19] {bits[19]} ones {bits.count_trues()} all {bits.is_all_true()}")

    # flip_all on 19 bits keeps the five spare bits of the last byte clear.
    bits.remove_last()
    bits.flip_all()
    Console.show("flip_all on {bits.count()}: ones {bits.count_trues()} none {bits.is_none_true()}")
    bits.flip_all()
    Console.show("flip_all again: ones {bits.count_trues()} all {bits.is_all_true()}")

    # Single bits.
    bits.setitem(index: 4, value: false)
    bits.flip(10)
    bits.flip(10)
    bits.flip(17)
    Console.show("after set/flip: {bits}")
    Console.show("has false {bits.has(false)} lacks true {bits.lacks(true)} first_true {bits.first_true()}")
    Console.show("next_true after 17: {bits.next_true(after: 17)} after 99: {bits.next_true(after: 99)}")

    # Equality: the same bits from another history compare equal.
    each i: U64 in 0 til 19
        other.add_last(true)
    other.setitem(index: 4, value: false)
    other.setitem(index: 17, value: false)
    Console.show("eq {bits.eq(other)}")
    other.add_last(true)
    Console.show("eq with one more {bits.eq(other)}")
    other.remove_last()

    # Combining in place.
    other.set_all(false)
    each i: U64 in 0 til 19 by 2
        other.setitem(index: i, value: true)
    bits.and_with(other)
    Console.show("and  {bits}")
    bits.or_with(other)
    bits.xor_with(other)
    Console.show("xor  {bits} ones {bits.count_trues()}")
    other.flip_all()
    bits.or_with(other)
    Console.show("or   {bits} ones {bits.count_trues()}")

    # Checked forms.
    Console.show("checked: {try bits.getitem(18)} {try bits.getitem(19)}")
    bits.clear()
    Console.show("cleared: {bits.count()} cap {bits.capacity()} {try bits.remove_last()}")
    bits.reserve(200)
    Console.show("reserved: cap {bits.capacity()}")
    bits.add_last(true)
    Console.show("after clear: {bits} first_true {bits.first_true()}")

    # Searching for false: the spare high bits of the last byte are never found.
    bits.set_all(true)
    Console.show("false: first {bits.first_false()}")
    bits.setitem(index: 0, value: false)
    Console.show("false: first {bits.first_false()} next after 0 {bits.next_false(after: 0)}")
    drop other
    drop bits
    return
