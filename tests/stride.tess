// p.stride(n) is the address n Ts past p: a USize, or an SSize to move back (a negative literal is one). It's a
// place like a field, so it chains: points.stride(i).y. Literals name their type, Array<T, N> { ... } and
// Vector<T, N> { ... }, the way a record literal does.

import Standard::Format
import Standard::Os

record Point
    x : S32
    y : S32

routine main() -> S32
    block entry()
        claim nums : @Array<S64, 4> <- { 10, 20, 30, 40 }
        first : @S64  = nums.to<@S64>()
        third : @S64  = first.stride(2)
        back  : @S64  = third.stride(-1)
        step  : SSize = -2
        again : @S64  = third.stride(step)
        Out.write("{third.load()} {back.load()} {again.load()}\n")

        claim points : @Array<Point, 3> <- uninit
        points.zeroinit(1)
        base : @Point = points.to<@Point>()
        i    : USize  = 1
        base.stride(i).y.store(7)
        base.stride(2).x.store(-3)
        Out.write("{base.stride(1).y.load()} {base.stride(2).x.load()} {points.get(1).y}\n")

        grid : Array<Array<S16, 2>, 2> = Array<Array<S16, 2>, 2> { Array<S16, 2> { 1, 2 },
            Array<S16, 2> { 3, 4 } }
        claim cells : @Array<Array<S16, 2>, 2> <- grid
        row : @Array<S16, 2> = cells.to<@Array<S16, 2>>().stride(1)
        Out.write("{row.get(0)} {row.get(1)}\n")

        v : Vector<S32, 4> = Vector<S32, 4> { 1, -2, 3, i.to<S32>() }
        Out.write("{v.get(1)} {v.get(3)} {v.sum()}\n")
        return(0)
