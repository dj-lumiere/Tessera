# A protocol constraint names its parameter first: needs T obeys Equatable, not needs Equatable[T].
import Hosted

### Whether the two are equal.
### :typeparam T: The values' type.
### :param a: One value.
### :param b: The other.
### :returns: Whether they are equal.
routine equal[T](a: T, b: T) -> Bool
needs Equatable[T]
    return a == b

routine start() -> None
    Console.show("{equal(1, 1)}")
    return
