// BF16 across call boundaries. At -O0, LLVM's x86 backend took a bfloat returned from a call for a promoted b32
// and truncated it again, so Tessera routines pass BF16 as its i16 bits: directly, inside records, in Maybe, and
// through a Callable.

import Standard/Format
import Standard/Os

record Pair
    a: BF16
    b: BF16

record Ops
    op: Callable[(BF16,), BF16]

/// Makes a `Pair` from its fields.
/// :param a: Its `a`.
/// :param b: Its `b`.
/// :returns: The new value.
routine Pair.construct(a: BF16, b: BF16) -> Me
    return(Me(a, b))

/// Releases nothing: a `Pair` holds no memory of its own.
routine Pair.destruct(me: @Me) -> Void
    return()

/// Makes a `Ops` from its fields.
/// :param op: Its `op`.
/// :returns: The new value.
routine Ops.construct(op: Callable[(BF16,), BF16]) -> Me
    return(Me(op))

/// Releases nothing: a `Ops` holds no memory of its own.
routine Ops.destruct(me: @Me) -> Void
    return()

routine make_pair(x: U16, y: U16) -> Pair
    p: Pair = Pair(a: BF16.from_bits(x), b: BF16.from_bits(y))
    return(p)

routine maybe(x: U16) -> Maybe[BF16]
    v: BF16 = .from_bits(x)
    r: Maybe[BF16] = v
    return(r)

routine first_bits(p: Pair) -> U16
    a: BF16 = p.a
    r: U16 = a.bits()
    return(r)

routine negate(x: BF16) -> BF16
    r: BF16 = x.neg()
    return(r)

routine start() -> Void
    out: @Out = Out.writer()
    p: Pair = make_pair(x: 0xBF80, y: 0x3FC0)
    b: BF16 = p.b
    out.write("{b} ")
    first_bits(p).represent_hex_into(out)
    out.write(" ")
    o: Maybe[BF16] = maybe(0xBFC0)
    v: BF16 = o.unwrap()
    out.write("{v} ")
    claim ops: @Ops <- Ops(op: negate.to[Callable]())
    op: Callable[(BF16,), BF16] = ops.op.peek()
    n: BF16 = op.call(v)
    out.write("{n}\n")
    return()
