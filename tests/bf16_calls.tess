// BF16 across call boundaries. At -O0, LLVM's x86 backend took a bfloat returned from a call for a promoted f32
// and truncated it again, so Tessera routines pass BF16 as its i16 bits: directly, inside records, in Option, and
// through a Callable.

record Pair
    a: BF16
    b: BF16

routine make_pair(%x: S16, %y: S16) -> Pair
    block entry():
        %p: Pair = Pair { a: BF16.from_bits(%x.bits()), b: BF16.from_bits(%y.bits()) }
        return(%p)

routine maybe(%x: S16) -> Option<BF16>
    block entry():
        %v: BF16 = BF16.from_bits(%x.bits())
        %r: Option<BF16> = Option<BF16>.some(%v)
        return(%r)

routine first_bits(%p: Pair) -> S16
    block entry():
        %a: BF16 = %p.a
        %r: S16 = S16.from_bits(%a.bits())
        return(%r)

routine negate(%x: BF16) -> BF16
    block entry():
        %r: BF16 = %x.neg()
        return(%r)

record Ops
    op: Callable<(BF16,), BF16>

routine main() -> S32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = claim
        #out.store(%out_val)
        %p: Pair = make_pair(-16512, 16320)
        %b: BF16 = %p.b
        %b.format(#out)
        write_str(#out, " ")
        first_bits(%p).format_hex(#out)
        write_str(#out, " ")
        %o: Option<BF16> = maybe(-16448)
        %v: BF16 = %o.value
        %v.format(#out)
        write_str(#out, " ")
        %ops: Ops = Ops { op: negate }
        #ops: Ptr<Ops> = claim
        #ops.store(%ops)
        %op: Callable<(BF16,), BF16> = #ops.op.load()
        %n: BF16 = %op.call(%v)
        %n.format(#out)
        write_line(#out)
        return(0)
