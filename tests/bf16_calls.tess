// BF16 across call boundaries. At -O0, LLVM's x86 backend took a bfloat returned from a call for a promoted f32
// and truncated it again, so Tessera routines pass BF16 as its i16 bits: directly, inside records, in Option, and
// through a Callable.

import Standard::Format
import Standard::Os

record Pair
    a : BF16
    b : BF16

record Ops
    op : Callable<(BF16,), BF16>

routine make_pair(%x: U16, %y: U16) -> Pair
    block entry():
        %p : Pair = Pair { a: BF16.from_bits(%x), b: BF16.from_bits(%y) }
        return(%p)

routine maybe(%x: U16) -> Option<BF16>
    block entry():
        %v : BF16         = .from_bits(%x)
        %r : Option<BF16> = .Present(%v)
        return(%r)

routine first_bits(%p: Pair) -> U16
    block entry():
        %a : BF16 = %p.a
        %r : U16  = %a.bits()
        return(%r)

routine negate(%x: BF16) -> BF16
    block entry():
        %r : BF16 = %x.neg()
        return(%r)

routine main() -> S32
    block entry():
        claim %out : @FdWriter <- .stdout()
        %p : Pair = make_pair(0xBF80, 0x3FC0)
        %b : BF16 = %p.b
        write(%out, "{%b} ")
        first_bits(%p).represent_hex(%out)
        write(%out, " ")
        %o : Option<BF16> = maybe(0xBFC0)
        %v : BF16         = %o.unwrap()
        write(%out, "{%v} ")
        claim %ops : @Ops <- Ops { op: negate }
        %op : Callable<(BF16,), BF16> = %ops.op.load()
        %n  : BF16                    = %op.call(%v)
        write(%out, "{%n}\n")
        return(0)
