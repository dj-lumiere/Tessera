# A view of memory isn't used after a #reshaping call that may have moved it.

import Standard/Collections
import Standard/Os

@reshaping(items)
routine grow(items: @List[S64]) -> None
    items.add_last(1)
    return

routine start() -> None
    xs: &List[S64] <- .construct(manager: HEAP)

    xs.add_last(5)
    first: @S64 = xs.getslot(0)
    grow(xs)
    v: S64 = first.peek()
    drop xs
    return
