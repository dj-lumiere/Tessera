# A swept slot is reused by the next entity of its type with a higher generation: the old stamp fails, the new one
# reads the new entity, and removing a stale stamp again fails.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### What a stamp fetches now: the value, or -1 when it fails.
### :param s: The stamp.
### :returns: The value or -1.
routine value_of(s: Stamped[Node]) -> S64
    when try s.fetch()
        is @Node as n => return n.value.peek()
        is None => return -1

### Whether removing a stamp worked.
### :param s: The stamp.
### :returns: False when the stamp was stale.
routine removed(s: Stamped[Node]) -> Bool
    when check PoolManager.remove(s)
        is None => return true
        is StaleStampError => return false

### Shows the reuse.
routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    a: Stamped[Node] = PoolManager.add(Node.construct(value: 1))
    where_a: Addr = a.fetch().to[Addr]()
    Console.show("removed: {removed(a)}, again: {removed(a)}")
    PoolManager.sweep()
    b: Stamped[Node] = PoolManager.add(Node.construct(value: 2))
    Console.show("old: {value_of(a)}, new: {value_of(b)}, same entity: {a === b}")
    Console.show("slot reused: {where_a === b.fetch().to[Addr]()}")
    Console.show("removing the old stamp: {removed(a)}")
    Console.show("new one still: {value_of(b)}")
    drop pool
    return
