// A record gets no represent_into (or diagnose_into) unless it conforms to Representable (or Diagnosable).

import Standard/Os

record Point
    x: S64
    y: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    p: Point = Point(x: 1, y: 2)
    Out.write("{p}\n")
    return()
