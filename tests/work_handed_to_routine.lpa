# A routine of the program may take a piece of work as a Work[T] parameter (handed over with steal) and put it on a
# ticket.

import Hosted

routine seven() -> S64
    return 7

### Runs the work on a thread of its own and gives the result.
### :param work: The work.
### :returns: Its result.
routine run_on_thread(work: Work[S64]) -> S64
    t: Thread[S64] <- get_thread[S64]()
    t.put_work(steal work)
    result: S64 = t.retrieve()
    drop t
    return result

routine start() -> None
    work: Work[S64] = seven.to[Work]()
    Console.show("{run_on_thread(work: steal work)}")
    return
