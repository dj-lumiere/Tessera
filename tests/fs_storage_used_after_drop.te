# A FileStorage given back with drop is unmapped: using it afterwards is a build error.

import Standard/Os

routine start() -> None
    s: FileStorage[Byte] <- OsFileManager.storage[Byte](at: File.at("data.bin"), write: false,
        start: 0, count: U64.MAX)
    drop s
    Console.show("{s.count()}")
    return
