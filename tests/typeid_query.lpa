# typeid[T]() is a U32 the builder computes from the type's name: the same each time, different for different types,
# never 0, usable in a preset and from a generic routine.

import Collections
import Hosted

preset POINT_ID: U32 = typeid[Point]()

### A record to ask about.
record Point
    x: S64

### The type id of a type parameter's instance.
### :typeparam T: The type.
### :returns: Its type id.
routine id_of[T]() -> U32
needs AnyType T
    return typeid[T]()

### Compares type ids.
routine start() -> None
    Console.show("{typeid[Point]() == POINT_ID} {id_of[Point]() == POINT_ID}")
    Console.show("{typeid[Point]() != typeid[S64]()} {typeid[List[S64]]() != typeid[List[S32]]()}")
    Console.show("{typeid[S64]() != 0} {typeid[S64]() == id_of[S64]()}")
    return
