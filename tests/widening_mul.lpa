# Widening multiplication on every width: mul_wide (one double-width value), widening_mul ((low, high)) and
# carrying_mul ((low, high) of the product plus a carry). The expected output was computed beforehand in Python.

import Hosted

routine run_u8(out: @ConsoleOutput, a: U8, b: U8) -> None
    p: (U8, U8) = a.widening_mul(b)
    out.write("U8 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: U16 = a.mul_wide(b)
    out.write("U8 {a} * {b}: wide {w}\n")
    return

routine carry_u8(out: @ConsoleOutput, a: U8, b: U8, c: U8) -> None
    p: (U8, U8) = a.carrying_mul(b, c)
    out.write("U8 {a} * {b} + {c}: low {p.item0} high {p.item1}\n")
    return

routine run_u16(out: @ConsoleOutput, a: U16, b: U16) -> None
    p: (U16, U16) = a.widening_mul(b)
    out.write("U16 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: U32 = a.mul_wide(b)
    out.write("U16 {a} * {b}: wide {w}\n")
    return

routine carry_u16(out: @ConsoleOutput, a: U16, b: U16, c: U16) -> None
    p: (U16, U16) = a.carrying_mul(b, c)
    out.write("U16 {a} * {b} + {c}: low {p.item0} high {p.item1}\n")
    return

routine run_u32(out: @ConsoleOutput, a: U32, b: U32) -> None
    p: (U32, U32) = a.widening_mul(b)
    out.write("U32 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: U64 = a.mul_wide(b)
    out.write("U32 {a} * {b}: wide {w}\n")
    return

routine carry_u32(out: @ConsoleOutput, a: U32, b: U32, c: U32) -> None
    p: (U32, U32) = a.carrying_mul(b, c)
    out.write("U32 {a} * {b} + {c}: low {p.item0} high {p.item1}\n")
    return

routine run_u64(out: @ConsoleOutput, a: U64, b: U64) -> None
    p: (U64, U64) = a.widening_mul(b)
    out.write("U64 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: U128 = a.mul_wide(b)
    out.write("U64 {a} * {b}: wide {w}\n")
    return

routine carry_u64(out: @ConsoleOutput, a: U64, b: U64, c: U64) -> None
    p: (U64, U64) = a.carrying_mul(b, c)
    out.write("U64 {a} * {b} + {c}: low {p.item0} high {p.item1}\n")
    return

routine run_u128(out: @ConsoleOutput, a: U128, b: U128) -> None
    p: (U128, U128) = a.widening_mul(b)
    out.write("U128 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: U256 = a.mul_wide(b)
    out.write("U128 {a} * {b}: wide {w}\n")
    return

routine carry_u128(out: @ConsoleOutput, a: U128, b: U128, c: U128) -> None
    p: (U128, U128) = a.carrying_mul(b, c)
    out.write("U128 {a} * {b} + {c}: low {p.item0} high {p.item1}\n")
    return

routine run_u256(out: @ConsoleOutput, a: U256, b: U256) -> None
    p: (U256, U256) = a.widening_mul(b)
    out.write("U256 {a} * {b}: low {p.item0} high {p.item1}\n")
    return

routine carry_u256(out: @ConsoleOutput, a: U256, b: U256, c: U256) -> None
    p: (U256, U256) = a.carrying_mul(b, c)
    out.write("U256 {a} * {b} + {c}: low {p.item0} high {p.item1}\n")
    return

routine run_s8(out: @ConsoleOutput, a: S8, b: S8) -> None
    p: (U8, S8) = a.widening_mul(b)
    out.write("S8 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: S16 = a.mul_wide(b)
    out.write("S8 {a} * {b}: wide {w}\n")
    return

routine run_s16(out: @ConsoleOutput, a: S16, b: S16) -> None
    p: (U16, S16) = a.widening_mul(b)
    out.write("S16 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: S32 = a.mul_wide(b)
    out.write("S16 {a} * {b}: wide {w}\n")
    return

routine run_s32(out: @ConsoleOutput, a: S32, b: S32) -> None
    p: (U32, S32) = a.widening_mul(b)
    out.write("S32 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: S64 = a.mul_wide(b)
    out.write("S32 {a} * {b}: wide {w}\n")
    return

routine run_s64(out: @ConsoleOutput, a: S64, b: S64) -> None
    p: (U64, S64) = a.widening_mul(b)
    out.write("S64 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: S128 = a.mul_wide(b)
    out.write("S64 {a} * {b}: wide {w}\n")
    return

routine run_s128(out: @ConsoleOutput, a: S128, b: S128) -> None
    p: (U128, S128) = a.widening_mul(b)
    out.write("S128 {a} * {b}: low {p.item0} high {p.item1}\n")
    w: S256 = a.mul_wide(b)
    out.write("S128 {a} * {b}: wide {w}\n")
    return

routine run_s256(out: @ConsoleOutput, a: S256, b: S256) -> None
    p: (U256, S256) = a.widening_mul(b)
    out.write("S256 {a} * {b}: low {p.item0} high {p.item1}\n")
    return

routine start() -> None
    out: @ConsoleOutput = Console.output()
    run_u8(out, a: U8.MAX, b: U8.MAX)
    run_u8(out, a: 0, b: U8.MAX)
    run_u8(out, a: 1, b: U8.MAX)
    run_u8(out, a: 3, b: 128)
    run_u8(out, a: 21, b: 177)
    carry_u8(out, a: U8.MAX, b: U8.MAX, c: U8.MAX)
    carry_u8(out, a: 0, b: 0, c: U8.MAX)
    carry_u8(out, a: 1, b: 1, c: 5)
    carry_u8(out, a: U8.MAX, b: 1, c: U8.MAX)
    carry_u8(out, a: 128, b: 2, c: 1)
    run_u16(out, a: U16.MAX, b: U16.MAX)
    run_u16(out, a: 0, b: U16.MAX)
    run_u16(out, a: 1, b: U16.MAX)
    run_u16(out, a: 3, b: 32768)
    run_u16(out, a: 52501, b: 26801)
    carry_u16(out, a: U16.MAX, b: U16.MAX, c: U16.MAX)
    carry_u16(out, a: 0, b: 0, c: U16.MAX)
    carry_u16(out, a: 1, b: 1, c: 5)
    carry_u16(out, a: U16.MAX, b: 1, c: U16.MAX)
    carry_u16(out, a: 32768, b: 2, c: 1)
    run_u32(out, a: U32.MAX, b: U32.MAX)
    run_u32(out, a: 0, b: U32.MAX)
    run_u32(out, a: 1, b: U32.MAX)
    run_u32(out, a: 3, b: 2147483648)
    run_u32(out, a: 123456789, b: 987654321)
    carry_u32(out, a: U32.MAX, b: U32.MAX, c: U32.MAX)
    carry_u32(out, a: 0, b: 0, c: U32.MAX)
    carry_u32(out, a: 1, b: 1, c: 5)
    carry_u32(out, a: U32.MAX, b: 1, c: U32.MAX)
    carry_u32(out, a: 2147483648, b: 2, c: 1)
    run_u64(out, a: U64.MAX, b: U64.MAX)
    run_u64(out, a: 0, b: U64.MAX)
    run_u64(out, a: 1, b: U64.MAX)
    run_u64(out, a: 3, b: 9223372036854775808)
    run_u64(out, a: 123456789, b: 987654321)
    carry_u64(out, a: U64.MAX, b: U64.MAX, c: U64.MAX)
    carry_u64(out, a: 0, b: 0, c: U64.MAX)
    carry_u64(out, a: 1, b: 1, c: 5)
    carry_u64(out, a: U64.MAX, b: 1, c: U64.MAX)
    carry_u64(out, a: 9223372036854775808, b: 2, c: 1)
    run_u128(out, a: U128.MAX, b: U128.MAX)
    run_u128(out, a: 0, b: U128.MAX)
    run_u128(out, a: 1, b: U128.MAX)
    run_u128(out, a: 3, b: 170141183460469231731687303715884105728)
    run_u128(out, a: 123456789, b: 987654321)
    carry_u128(out, a: U128.MAX, b: U128.MAX, c: U128.MAX)
    carry_u128(out, a: 0, b: 0, c: U128.MAX)
    carry_u128(out, a: 1, b: 1, c: 5)
    carry_u128(out, a: U128.MAX, b: 1, c: U128.MAX)
    carry_u128(out, a: 170141183460469231731687303715884105728, b: 2, c: 1)
    run_u256(out, a: U256.MAX, b: U256.MAX)
    run_u256(out, a: 0, b: U256.MAX)
    run_u256(out, a: 1, b: U256.MAX)
    run_u256(out, a: 3,
        b: 57896044618658097711785492504343953926634992332820282019728792003956564819968)
    run_u256(out, a: 123456789, b: 987654321)
    carry_u256(out, a: U256.MAX, b: U256.MAX, c: U256.MAX)
    carry_u256(out, a: 0, b: 0, c: U256.MAX)
    carry_u256(out, a: 1, b: 1, c: 5)
    carry_u256(out, a: U256.MAX, b: 1, c: U256.MAX)
    carry_u256(out,
        a: 57896044618658097711785492504343953926634992332820282019728792003956564819968, b: 2,
        c: 1)
    run_s8(out, a: S8.MIN, b: S8.MIN)
    run_s8(out, a: S8.MIN, b: S8.MAX)
    run_s8(out, a: S8.MAX, b: S8.MAX)
    run_s8(out, a: -1, b: 1)
    run_s8(out, a: -1, b: -1)
    run_s8(out, a: S8.MIN, b: -1)
    run_s8(out, a: 7, b: -3)
    run_s8(out, a: 0, b: S8.MIN)
    run_s16(out, a: S16.MIN, b: S16.MIN)
    run_s16(out, a: S16.MIN, b: S16.MAX)
    run_s16(out, a: S16.MAX, b: S16.MAX)
    run_s16(out, a: -1, b: 1)
    run_s16(out, a: -1, b: -1)
    run_s16(out, a: S16.MIN, b: -1)
    run_s16(out, a: 7, b: -3)
    run_s16(out, a: 0, b: S16.MIN)
    run_s32(out, a: S32.MIN, b: S32.MIN)
    run_s32(out, a: S32.MIN, b: S32.MAX)
    run_s32(out, a: S32.MAX, b: S32.MAX)
    run_s32(out, a: -1, b: 1)
    run_s32(out, a: -1, b: -1)
    run_s32(out, a: S32.MIN, b: -1)
    run_s32(out, a: 7, b: -3)
    run_s32(out, a: 0, b: S32.MIN)
    run_s64(out, a: S64.MIN, b: S64.MIN)
    run_s64(out, a: S64.MIN, b: S64.MAX)
    run_s64(out, a: S64.MAX, b: S64.MAX)
    run_s64(out, a: -1, b: 1)
    run_s64(out, a: -1, b: -1)
    run_s64(out, a: S64.MIN, b: -1)
    run_s64(out, a: 7, b: -3)
    run_s64(out, a: 0, b: S64.MIN)
    run_s128(out, a: S128.MIN, b: S128.MIN)
    run_s128(out, a: S128.MIN, b: S128.MAX)
    run_s128(out, a: S128.MAX, b: S128.MAX)
    run_s128(out, a: -1, b: 1)
    run_s128(out, a: -1, b: -1)
    run_s128(out, a: S128.MIN, b: -1)
    run_s128(out, a: 7, b: -3)
    run_s128(out, a: 0, b: S128.MIN)
    run_s256(out, a: S256.MIN, b: S256.MIN)
    run_s256(out, a: S256.MIN, b: S256.MAX)
    run_s256(out, a: S256.MAX, b: S256.MAX)
    run_s256(out, a: -1, b: 1)
    run_s256(out, a: -1, b: -1)
    run_s256(out, a: S256.MIN, b: -1)
    run_s256(out, a: 7, b: -3)
    run_s256(out, a: 0, b: S256.MIN)
    return
