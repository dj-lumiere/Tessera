# Taking exclusive access again from the thread that holds it stops the program with ReenterDuringAccessError, instead
# of waiting for itself forever. The second take goes through another name for the same value, which the build doesn't
# follow.

import Hosted

routine start() -> None
    counter: &U64 <- 0

    held: Authorized[U64] <- counter.get_exclusive_access()
    Console.show("holding it")
    same: @U64 = counter.stride(0)
    again: Authorized[U64] <- same.get_exclusive_access()
    Console.show("not reached")
    drop again
    drop held
    return
