# A whole number written in base 10 goes into a binary float place, typed by where it goes.

import Standard/Hosted

routine half(x: B64) -> B64
    return x / 2

routine start() -> None
    x: &B64 <- 0
    y: B32 = 3
    z: B16 = -2
    big: B64 = 9007199254740993
    x.store(x.load() + 5)
    Console.show("{x.load()} {y} {z} {half(7)} {big}")
    w: B128 = 12
    Console.show("{w.to[B64]()}")
    return
