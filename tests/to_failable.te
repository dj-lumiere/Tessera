# A numeric to[T] that can lose the value is failable: it throws IntegerOverflowError when the value doesn't fit, so
# `try x.to[U8]()` gives None and a bare call stops on its line. A widening to[T] never fails, and in a generic routine
# `try` over it is just the value.

import Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}\nat line {place.line.peek()}")
    exit(3)

### The value as a T, or None when it doesn't fit.
### :typeparam T: The type converted to.
### :param x: The value.
### :returns: The value or None.
routine narrow_or_none[T](x: S64) -> Optional[T]
needs T: typename
    return try x.to[T]()

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    small: S64 = 200
    big: S64 = 300
    negative: S64 = -1
    Console.show("{try small.to[U8]()} {try big.to[U8]()} {try negative.to[U64]()}")
    Console.show("{narrow_or_none[U8](small)} {narrow_or_none[U8](big)} {narrow_or_none[S128](big)}")
    missing: B64 = nan
    half: B64 = 2.5
    Console.show("{try missing.to[S32]()} {try half.to[S32]()}")
    huge: B64 = 1e300
    Console.show("{try huge.to[B32]()}")
    code: U32 = 0xD800
    letter: U32 = 0x41
    Console.show("{try code.to[Char]()} {try letter.to[Char]()}")
    Console.show("{big.to[U8]()}")
    return
