# A float operation whose result is infinite crashes with NumericOverflowError at the caller's line: the checked
# forms are @track_caller. The unchecked operator *! gives the raw IEEE 754 value, and a finite result is the same in
# both forms.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("float_crash_overflow.te")
    Console.show("crashed: {name}: {message} (this file {here}, line {place.line.peek()})")
    exit(3)

routine start() -> None
    big: B64 = B64.MAX
    two: B64 = 2.0
    Console.show("{big *! two} {big -! big *! two} {B64.MIN_POSITIVE * two == B64.MIN_POSITIVE *! two}")
    r: B64 = big * two
    Console.show("not reached {r}")
    return
