; 1 when got differs from want (and the difference is printed), else 0.
routine report(#out: Ptr<FdWriter>, %name: String, %i: I64, %got: I128, %want: I128) -> I64
    block entry():
        %ok: Bool = %got.eq(%want)
        branch %ok ? return(0) : bad(#out, %name, %i, %got, %want)

    block bad(#out: Ptr<FdWriter>, %name: String, %i: I64, %got: I128, %want: I128):
        write_str(#out, %name)
        write_str(#out, " #")
        %i.format(#out)
        write_str(#out, ": ")
        %got.format_hex(#out)
        write_str(#out, " want ")
        %want.format_hex(#out)
        write_line(#out)
        return(1)

routine summary(#out: Ptr<FdWriter>, %name: String, %failures: I64) -> Void
    block entry():
        write_str(#out, %name)
        write_str(#out, ": ")
        %total:  I64 = 2521
        %passed: I64 = %total.sub(%failures)
        %passed.format(#out)
        write_str(#out, " / 2521")
        write_line(#out)
        return()

routine main() -> I32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = alloca<FdWriter>([%out_val])
        jump next(0, 0, 0, 0, #out)

    block next(%i: I64, %sin_bad: I64, %cos_bad: I64, %pair_bad: I64, #out: Ptr<FdWriter>):
        %done: Bool = %i.sge(2521)
        branch %done ? finish(%sin_bad, %cos_bad, %pair_bad, #out)
                     : check(%i, %sin_bad, %cos_bad, %pair_bad, #out)

    block check(%i: I64, %sin_bad: I64, %cos_bad: I64, %pair_bad: I64, #out: Ptr<FdWriter>):
        %bits:     I128 := INPUTS[%i]
        %sin_want: I128 := SIN_WANT[%i]
        %cos_want: I128 := COS_WANT[%i]
        %x:        F128       = F128.from_bits(%bits)
        %sin:      F128       = f128_cm_sin(%x)
        %cos:      F128       = f128_cm_cos(%x)
        %pair:     F128SinCos = f128_cm_sin_cos(%x)
        %pair_sin: F128       = %pair.sin
        %pair_cos: F128       = %pair.cos
        %sin_miss:  I64 = report(#out, "sin", %i, %sin.bits, %sin_want)
        %cos_miss:  I64 = report(#out, "cos", %i, %cos.bits, %cos_want)
        %ps_miss:   I64 = report(#out, "sin_cos.sin", %i, %pair_sin.bits, %sin_want)
        %pc_miss:   I64 = report(#out, "sin_cos.cos", %i, %pair_cos.bits, %cos_want)
        %pair_miss: I64 = %ps_miss.bitor(%pc_miss)
        %sin_next:  I64 = %sin_bad.add(%sin_miss)
        %cos_next:  I64 = %cos_bad.add(%cos_miss)
        %pair_next: I64 = %pair_bad.add(%pair_miss)
        jump next(%i.add(1), %sin_next, %cos_next, %pair_next, #out)

    block finish(%sin_bad: I64, %cos_bad: I64, %pair_bad: I64, #out: Ptr<FdWriter>):
        summary(#out, "sin", %sin_bad)
        summary(#out, "cos", %cos_bad)
        summary(#out, "sin_cos", %pair_bad)
        return(0)
