/// An added routine sees only the public fields (BufWriter.count is private to Format.tess).
import Standard::Format
import Standard::Os

routine BufWriter<T>.buffered(self: @Self) -> USize
require T: typename
    block entry()
        return(self.count.load())

routine start() -> Void
    block entry()
        claim out : @BufWriter<Out> <- uninit
        out.construct(Out.writer())
        buffered : USize = out.buffered()
        return()
