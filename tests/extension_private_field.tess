### An added routine sees only the public fields (BufWriter.count is private to Format.tess).
import Standard/Format
import Standard/Os

routine BufWriter[T].buffered(me: @Me) -> USize
needs T: typename
    return me.count.peek()

routine start() -> None
    local out: @BufWriter[Out] <- .hollow()
    out.construct(Out.writer())
    buffered: USize = out.buffered()
    return
