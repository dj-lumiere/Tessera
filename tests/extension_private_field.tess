/// An added routine sees only the public fields (BufWriter.length is private to Format.tess).
import Standard::Format
import Standard::Os

routine BufWriter<W>.buffered(self: @Self) -> USize
require W: typename
    block entry()
        return(self.length.load())

routine main() -> S32
    block entry()
        claim out : @BufWriter<Out> <- uninit
        out.construct(Out.shared())
        buffered : USize = out.buffered()
        return(0)
