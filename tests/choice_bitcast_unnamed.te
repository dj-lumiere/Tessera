# A choice value no member has (one a bitcast made) writes its number in the choice's form, never a member's name.
import Hosted

choice Status: U8
    OK
    NOT_FOUND

choice Light
    RED: 4
    GREEN: -2

routine start() -> None
    raw: U8 = 7
    s: Status = raw.bitcast[Status]()
    Console.show("{s} {s.diagnose()} {s == Status.NOT_FOUND}")
    ok: Status = Status.NOT_FOUND
    Console.show("{ok} {ok.diagnose()}")
    n: S32 = -9
    l: Light = n.bitcast[Light]()
    Console.show("{l} {l.diagnose()} {Light.GREEN}")
    return
