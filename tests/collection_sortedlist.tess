// SortedList<S64> against a model. An LCG drives random push / rank / contains / remove / get in three phases (small,
// growing to thousands of elements, then shrinking to empty so borrows and merges run). Every 500
// operations a checkpoint prints the length, a running checksum of every result, and a hash of the iteration
// sequence. Then eq.
// The expected output is generated by scripts/gen_collection_btree.py.

import Standard::Alloc
import Standard::Collections
import Standard::Format

record Rng
    state : U64

routine Rng.below(self: Ptr<Self>, bound: U64) -> U64
    block entry():
        state : U64 = self.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        self.state.store(next)
        value : U64 = next.shr(33).rem(bound)
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry():
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<W>(out: Ptr<W>, label: String, value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write(out, " {label} {value}")
        return()

// Folds every element in iteration order.
routine iteration_hash(list: Ptr<SortedList<S64>>) -> S64
    block entry():
        iter_val : SortedListIter<S64> = .construct(list)
        claim iter : Ptr<SortedListIter<S64>>
        iter.store(iter_val)
        jump next(iter, 0)

    block next(iter: Ptr<SortedListIter<S64>>, hash: S64):
        item : Option<S64> = iter.next()
        when item:
            .Present(value) -> next(iter, mix(hash, value))
            .Absent         -> return(hash)

routine checkpoint(out: Ptr<BufWriter<FdWriter>>, list: Ptr<SortedList<S64>>, phase: U64, op: U64,
        results: S64) -> Void
    block entry():
        write(out, "phase {phase}")
        labeled(out, "op", op.to_s64())
        labeled(out, "length", list.length().to_s64())
        labeled(out, "results", results)
        labeled(out, "iteration", iteration_hash(list))
        write(out, "\n")
        return()

// Runs ops random operations. An operation kind is drawn below 10: below pushes it's a push, below ranks a rank,
// below contains a contains (both of a random value), below removes a remove at a random index, otherwise a get.
// Values are below 1000, so duplicates are common. Remove and get on an empty list record -1. Returns the updated
// results checksum.
routine run_phase(out: Ptr<BufWriter<FdWriter>>, list: Ptr<SortedList<S64>>, rng: Ptr<Rng>,
        phase: U64, ops: U64, pushes: U64, ranks: U64, contains: U64, removes: U64,
        results: S64) -> S64
    block entry():
        jump next(0, results)

    block next(op: U64, results: S64):
        done : Bool = op.ge(ops)
        branch done ? return(results) : pick(op, results)

    block pick(op: U64, results: S64):
        kind        : U64  = rng.below(10)
        is_push     : Bool = kind.lt(pushes)
        is_rank     : Bool = kind.lt(ranks)
        is_contains : Bool = kind.lt(contains)
        empty       : Bool = list.is_empty()
        when:
            is_push     -> push(op, results)
            is_rank     -> rank(op, results)
            is_contains -> contains(op, results)
            empty       -> record(op, results, -1)
            _           -> pick_indexed(op, results, kind)

    block pick_indexed(op: U64, results: S64, kind: U64):
        index     : U64  = rng.below(list.length())
        is_remove : Bool = kind.lt(removes)
        branch is_remove ? remove(op, results, index) : get(op, results, index)

    block push(op: U64, results: S64):
        value : S64 = rng.below(1000).to_s64()
        list.push(value)
        jump record(op, results, value)

    block rank(op: U64, results: S64):
        value : S64 = rng.below(1000).to_s64()
        rank  : U64 = list.rank(value)
        jump record(op, results, rank.to_s64())

    block contains(op: U64, results: S64):
        value : S64  = rng.below(1000).to_s64()
        found : Bool = list.contains(value)
        jump record(op, results, found.to_s64())

    block remove(op: U64, results: S64, index: U64):
        value : S64 = list.remove(index)
        jump record(op, results, value)

    block get(op: U64, results: S64, index: U64):
        value : S64 = list.get(index)
        jump record(op, results, value)

    block record(op: U64, results: S64, result: S64):
        mixed   : S64  = mix(results, result)
        op_next : U64  = op.add(1)
        report  : Bool = op_next.rem(500).eq(0)
        branch report ? report(op_next, mixed) : next(op_next, mixed)

    block report(op: U64, results: S64):
        checkpoint(out, list, phase, op, results)
        jump next(op, results)

// Pushes every element of from onto to, in iteration order.
routine copy_all(from: Ptr<SortedList<S64>>, to: Ptr<SortedList<S64>>) -> Void
    block entry():
        iter_val : SortedListIter<S64> = .construct(from)
        claim iter : Ptr<SortedListIter<S64>>
        iter.store(iter_val)
        jump next(iter)

    block next(iter: Ptr<SortedListIter<S64>>):
        item : Option<S64> = iter.next()
        when item:
            .Present(value) -> copy(iter, value)
            .Absent         -> return()

    block copy(iter: Ptr<SortedListIter<S64>>, value: S64):
        to.push(value)
        jump next(iter)

routine report_eq(out: Ptr<BufWriter<FdWriter>>, label: String, equal: Bool) -> Void
    block entry():
        write(out, "{label} {equal}\n")
        return()

routine main() -> S32
    block entry():
        fd_val : FdWriter = .stdout()
        claim fd : Ptr<FdWriter>
        fd.store(fd_val)
        claim out : Ptr<BufWriter<FdWriter>>
        out.construct(fd)
        heap : Allocator = make_heap_allocator()
        claim alloc : Ptr<Allocator>
        alloc.store(heap)
        rng_val : Rng = Rng { state: 1 }
        claim rng : Ptr<Rng>
        rng.store(rng_val)
        list_val : SortedList<S64> = .construct(alloc)
        claim list : Ptr<SortedList<S64>>
        list.store(list_val)

        r1 : S64 = run_phase(out, list, rng, 1, 3000, 4, 5, 6, 8, 0)
        r2 : S64 = run_phase(out, list, rng, 2, 10000, 5, 6, 7, 8, r1)

        copied_val : SortedList<S64> = .construct(alloc)
        claim copied : Ptr<SortedList<S64>>
        copied.store(copied_val)
        report_eq(out, "empty copy equal", list.eq(copied))
        copy_all(list, copied)
        report_eq(out, "copy equal", list.eq(copied))
        middle : U64 = list.length().div(2)
        old    : S64 = copied.remove(middle)
        report_eq(out, "removed element equal", list.eq(copied))
        copied.push(old)
        report_eq(out, "restored element equal", list.eq(copied))
        copied.push(0)
        report_eq(out, "extra element equal", list.eq(copied))
        copied.destruct()

        r3 : S64 = run_phase(out, list, rng, 3, 19000, 1, 2, 3, 9, r2)
        list.destruct()
        report_eq(out, "freed is empty", list.is_empty())
        out.flush()
        return(0)
