; SortedList<S64> against a model. An LCG drives random push / insert / remove / set / get at random indices in three
; phases (small, growing to thousands of elements, then shrinking to empty so borrows and merges run). Every 500
; operations a checkpoint prints the length, a running checksum of every result, and a hash of the iteration
; sequence. Then eq.
; The expected output is generated by scripts/gen_collection_btree.py.

record Rng
    state: U64

routine Rng.below(#self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state: U64 := #self.state
        %next:  U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        #self.state = %next
        %value: U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed: S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(#out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, " ")
        write_str(#out, %label)
        write_str(#out, " ")
        %value.format(#out)
        return()

; Folds every element in iteration order.
routine iteration_hash(#list: Ptr<SortedList<S64>>) -> S64
    block entry():
        %iter_val: SortedListIter<S64> = SortedListIter<S64>.new(#list)
        #iter: Ptr<SortedListIter<S64>> = alloca<SortedListIter<S64>>([%iter_val])
        jump next(#iter, 0)

    block next(#iter: Ptr<SortedListIter<S64>>, %hash: S64):
        %item:  Option<S64> = #iter.next()
        %more:  Bool = %item.tag
        %value: S64 = %item.value
        branch %more ? next(#iter, mix(%hash, %value)) : return(%hash)

routine checkpoint(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<SortedList<S64>>, %phase: U64, %op: U64, %results: S64) -> Void
    block entry():
        write_str(#out, "phase ")
        %phase.format(#out)
        labeled(#out, "op", %op.to_s64())
        labeled(#out, "length", #list.length().to_s64())
        labeled(#out, "results", %results)
        labeled(#out, "iteration", iteration_hash(#list))
        write_line(#out)
        return()

; Runs %ops random operations. An operation kind is drawn below 10: below %pushes it's a push, below %inserts an
; insert at a random index (the end included), below %removes a remove, below %sets a set, otherwise a get. Remove,
; set, and get on an empty list record -1. Returns the updated results checksum.
routine run_phase(
        #out: Ptr<BufWriter<FdWriter>>, #list: Ptr<SortedList<S64>>, #rng: Ptr<Rng>,
        %phase: U64, %ops: U64, %pushes: U64, %inserts: U64, %removes: U64, %sets: U64, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: U64, %results: S64):
        %done: Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: U64, %results: S64):
        %kind:      U64  = #rng.below(10)
        %is_push:   Bool = %kind.lt(%pushes)
        %is_insert: Bool = %kind.lt(%inserts)
        %empty:     Bool = #list.is_empty()
        select:
            %is_push -> push(%op, %results)
            %is_insert -> insert(%op, %results)
            %empty -> record(%op, %results, -1)
            _ -> pick_indexed(%op, %results, %kind)

    block pick_indexed(%op: U64, %results: S64, %kind: U64):
        %index:     U64  = #rng.below(#list.length())
        %is_remove: Bool = %kind.lt(%removes)
        %is_set:    Bool = %kind.lt(%sets)
        select:
            %is_remove -> remove(%op, %results, %index)
            %is_set -> set(%op, %results, %index)
            _ -> get(%op, %results, %index)

    block push(%op: U64, %results: S64):
        %value: S64 = #rng.below(1000000).to_s64()
        #list.push(%value)
        jump record(%op, %results, %value)

    block insert(%op: U64, %results: S64):
        %index: U64 = #rng.below(#list.length().add(1))
        %value: S64 = #rng.below(1000000).to_s64()
        #list.insert(%index, %value)
        jump record(%op, %results, mix(%index.to_s64(), %value))

    block remove(%op: U64, %results: S64, %index: U64):
        %value: S64 = #list.remove(%index)
        jump record(%op, %results, %value)

    block set(%op: U64, %results: S64, %index: U64):
        %value: S64 = #rng.below(1000000).to_s64()
        #list.set(%index, %value)
        jump record(%op, %results, mix(%index.to_s64(), %value))

    block get(%op: U64, %results: S64, %index: U64):
        %value: S64 = #list.get(%index)
        jump record(%op, %results, %value)

    block record(%op: U64, %results: S64, %result: S64):
        %mixed:   S64  = mix(%results, %result)
        %op_next: U64  = %op.add(1)
        %report:  Bool = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: U64, %results: S64):
        checkpoint(#out, #list, %phase, %op, %results)
        jump next(%op, %results)

; Pushes every element of #from onto #to, in iteration order.
routine copy_all(#from: Ptr<SortedList<S64>>, #to: Ptr<SortedList<S64>>) -> Void
    block entry():
        %iter_val: SortedListIter<S64> = SortedListIter<S64>.new(#from)
        #iter: Ptr<SortedListIter<S64>> = alloca<SortedListIter<S64>>([%iter_val])
        jump next(#iter)

    block next(#iter: Ptr<SortedListIter<S64>>):
        %item:  Option<S64> = #iter.next()
        %more:  Bool = %item.tag
        %value: S64 = %item.value
        branch %more ? copy(#iter, %value) : return()

    block copy(#iter: Ptr<SortedListIter<S64>>, %value: S64):
        #to.push(%value)
        jump next(#iter)

routine report_eq(#out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write_str(#out, %label)
        write_str(#out, " ")
        %equal.format(#out)
        write_line(#out)
        return()

routine main() -> S32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        %rng_val: Rng      = Rng { state: 1 }
        #rng:     Ptr<Rng> = alloca<Rng>([%rng_val])
        %list_val: SortedList<S64> = SortedList<S64>.new(#alloc)
        #list: Ptr<SortedList<S64>> = alloca<SortedList<S64>>([%list_val])

        %r1: S64 = run_phase(#out, #list, #rng, 1, 3000, 3, 5, 7, 8, 0)
        %r2: S64 = run_phase(#out, #list, #rng, 2, 10000, 3, 7, 8, 9, %r1)

        %copy_val: SortedList<S64> = SortedList<S64>.new(#alloc)
        #copy: Ptr<SortedList<S64>> = alloca<SortedList<S64>>([%copy_val])
        report_eq(#out, "empty copy equal", #list.eq(#copy))
        copy_all(#list, #copy)
        report_eq(#out, "copy equal", #list.eq(#copy))
        %middle: U64 = #list.length().div(2)
        %old:    S64 = #copy.get(%middle)
        #copy.set(%middle, %old.add(1))
        report_eq(#out, "changed element equal", #list.eq(#copy))
        #copy.set(%middle, %old)
        report_eq(#out, "restored element equal", #list.eq(#copy))
        #copy.push(0)
        report_eq(#out, "extra element equal", #list.eq(#copy))
        #copy.free()

        %r3: S64 = run_phase(#out, #list, #rng, 3, 19000, 1, 2, 8, 9, %r2)
        #list.free()
        report_eq(#out, "freed is empty", #list.is_empty())
        #out.flush()
        return(0)
