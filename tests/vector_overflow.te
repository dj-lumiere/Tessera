# An integer Vector's add crashes when any lane overflows, like the scalar add: here only lane 2 does.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("crashed: {name}")
    exit(3)

routine start() -> None
    a: Vector[S16, 4] = [1, 2, 32767, 4]
    one: Vector[S16, 4] = .splat(1)
    ok: Vector[S16, 4] = a +% one
    Console.show("wrapped {ok.getitem(2)}")
    bad: Vector[S16, 4] = a + one
    Console.show("not reached {bad.getitem(0)}")
    return
