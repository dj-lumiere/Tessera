// A C variable the program links against: #[external("c"), symbol(...)] on a global declares it (C's extern) and
// reads it through its pointer type. POSIX's environ, and on Windows the C runtime's stack-protector cookie (the
// C runtime there has no environ variable, only __p__environ()).

import Standard::Format
import Standard::Os

#[external("c"), symbol("environ"), target(os: not "windows")]
global ENVIRON: @@@Byte

#[external("c"), symbol("__security_cookie"), target(os: "windows")]
global COOKIE: @USize

#target(os: not "windows")
routine linked() -> Bool
    block entry():
        env : @@Byte = ENVIRON.load()
        return(env.load().is_not_null())

#target(os: "windows")
routine linked() -> Bool
    block entry():
        return(COOKIE.load().ne(0))

routine main() -> S32
    block entry():
        Out.write("{linked()}\n")
        return(0)
