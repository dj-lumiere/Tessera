# A run's access is given back like a value's: a missing drop is a build error.

import Standard/Os

### Takes a run's access and doesn't give it back.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3] * 1 from HEAP
    whole: AuthorizedSlice[S64] <- numbers.get_exclusive_access()
    whole.getview().getslot(0).poke(4)
    drop numbers
    return
