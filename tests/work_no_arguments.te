# A routine with no parameters and no result is a Work[None] too: to[Work]() with no arguments.

import Standard/Os

### Says hello.
routine hello() -> None
    Console.show("hello")
    return

### Runs the work on a lent thread.
routine start() -> None
    work: Work[None] <- hello.to[Work]()
    work.start_from(DEFAULT_THREADS)
    work.retrieve()
    drop work
    return
