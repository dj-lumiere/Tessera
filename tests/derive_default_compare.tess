// A variant derives Comparable only when its payloads compare: Point doesn't, so Label has no compare.

#derive(Equatable)
record Point
    x : S64
    y : S64

variant Label
    At : Point
    None

routine main() -> S32
    block entry()
        l     : Label = .None
        order : S32   = l.compare(Label.None)
        return(0)
