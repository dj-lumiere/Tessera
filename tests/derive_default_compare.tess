// A variant derives Compare only when its payloads compare: Point doesn't, so Label has no compare.

@derive(Equal)
record Point
    x : S64
    y : S64

variant Label
    At : Point
    None

routine main() -> S32
    block entry():
        %l     : Label = .None
        %order : S32   = %l.compare(Label.None)
        return(0)
