// A variant derives Comparable only when its branches compare: Point doesn't, so Label has no compare.

#derive(Equatable)
record Point
    x: S64
    y: S64

variant Label
    Point
    Unit

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :param y: Its `y`.
/// :returns: The new value.
routine Point.construct(x: S64, y: S64) -> Me
    return(Me(x, y))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

/// Releases nothing: a `Label` holds no memory of its own.
routine Label.destruct(me: @Me) -> Void
    return()

routine start() -> Void
    l: Label = Unit()
    order: S32 = l.compare(l)
    return()
