# In generic code steal and drop are written once for any T: for an entity T they move and end it, for a record T
# (S64 here) steal is the value and drop does nothing.
import Standard/Os

### Counts things, and says when it ends.
entity Counter
obeys Destructible[Counter]
    count: S64

### A counter at `n`.
### :param n: The starting count.
### :returns: The counter.
common routine Counter.construct(n: S64) -> Me
    return Me(count: n)

### Says its count as it ends.
routine @Counter.destruct() -> None
    Console.show("ending {me.count.peek()}")
    return

### Hands `value` on.
### :typeparam T: Any type.
### :param value: The value.
### :returns: The value.
routine pass_on[T](value: T) -> T
needs T: typename
    return steal value

### Ends `value`.
### :typeparam T: Any type.
### :param value: The value.
routine finish[T](value: T) -> None
needs T: typename
    drop value
    return

### Moves and ends a number and a counter the same way.
routine start() -> None
    n: S64 = pass_on(value: 7)
    finish(value: n)
    Console.show("number {n}")
    local c: @Counter <- .construct(n: 3)
    local d: @Counter <- pass_on(value: steal c)
    finish(value: steal d)
    Console.show("done")
    return
