// A record with one field is a struct holding that field, as every record is a struct: the field's size and
// alignment, and it passes, stores, and reads like any other record.

import Standard/Os

record Meters
    value: B64

record Wrapped
    inner: Meters

/// Makes a `Meters` from its fields.
/// :param value: Its `value`.
/// :returns: The new value.
routine Meters.construct(value: B64) -> Me
    return(Me(value))

/// Releases nothing: a `Meters` holds no memory of its own.
routine Meters.destruct(me: @Me) -> Void
    return()

/// Makes a `Wrapped` from its fields.
/// :param inner: Its `inner`.
/// :returns: The new value.
routine Wrapped.construct(inner: Meters) -> Me
    return(Me(inner))

/// Releases nothing: a `Wrapped` holds no memory of its own.
routine Wrapped.destruct(me: @Me) -> Void
    return()

routine double(m: Meters) -> Meters
    v: B64 = m.value
    r: Meters = Meters(value: v.mul(2.0))
    return(r)

routine start() -> Void
    m: Meters = Meters(value: 1.5)
    d: Meters = double(m)
    claim slot: @Wrapped <- .hollow()
    slot.inner.poke(d)
    w: Wrapped = slot.peek()
    inner: Meters = w.inner
    same_size: Bool = sizeof[Wrapped]().eq(sizeof[B64]())
    same_align: Bool = alignof[Meters]().eq(alignof[B64]())
    three: Bool = inner.value.eq(3.0)
    ok: Bool = same_size.bitand(same_align).bitand(three)
    branch ok
        ? return()
        : failed()

    block failed()
        set_exit_code(1)
        return()
