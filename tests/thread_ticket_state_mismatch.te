# put_work takes the arguments its entry takes: an entry on an @S64 can't be handed a @U8.

import Standard/Os

routine count_up(n: @S64) -> None
    (n.peek() + 1).poke_into(n)
    return

routine start() -> None
    small: &U8 <- 0

    t: Thread[None] <- get_thread[None]()
    work_t: Work[None] = count_up.to[Work](n: small)
    t.put_work(steal work_t)
    t.retrieve()
    drop t
    return
