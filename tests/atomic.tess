// Atomics on @T: load and store, swap, the fetch_ operations (each returns the value it replaced), strong and weak
// compare_exchange (the previous value, or the one found), the memory-order suffixes,
// several widths and kinds of T, and the fences. One thread, so the values are fixed. What's checked is that each
// operation does what it says and compiles to valid atomic IR.

import Standard/Format
import Standard/Os

/// Adds one with a weak compare-and-exchange, retrying on any failure, spurious or not.
routine increment(counter: @U32) -> U32
    while true with seen: U32 = counter.peek_atomic_relaxed()
        next: U32 = seen + 1
        result: Result[Unit, U32] = counter.atomic_compare_exchange_weak_acq_rel(expected: seen, new: next)
        when result
            is Unit => return next
            is U32 as actual => continue with seen: actual

routine start() -> Void
    local n: @U32 <- .hollow()
    n.poke_atomic(5)
    a: U32 = n.atomic_fetch_add(3)
    b: U32 = n.atomic_fetch_sub_relaxed(1)
    c: U32 = n.atomic_fetch_or_acq_rel(0x10)
    d: U32 = n.atomic_fetch_and(0x1F)
    e: U32 = n.atomic_fetch_xor_release(1)
    f: U32 = n.atomic_swap_acquire(100)
    g: U32 = n.peek_atomic_acquire()
    Out.write("U32 {a} {b} {c} {d} {e} {f} {g}\n")
    won: Result[Unit, U32] = n.atomic_compare_exchange(expected: 100, new: 7)
    lost: Result[Unit, U32] = n.atomic_compare_exchange(expected: 100, new: 9)
    now: U32 = n.peek_atomic()
    Out.write("cas {won} {lost} {now}\n")
    bumped: U32 = increment(n)
    Out.write("weak {bumped} {n.peek_atomic()}\n")

    local s: @S64 <- .hollow()
    s.poke_atomic_release(-5)
    s_old: S64 = s.atomic_fetch_add(-10)
    Out.write("S64 {s_old} {s.peek_atomic()}\n")

    local small: @U8 <- .hollow()
    small.poke_atomic(250)
    wrapped: U8 = small.atomic_fetch_add(10)
    local half: @S16 <- .hollow()
    half.poke_atomic_relaxed(-1)
    h_old: S16 = half.atomic_fetch_sub(32767)
    Out.write("narrow {wrapped} {small.peek_atomic()} {h_old} {half.peek_atomic()}\n")

    local bits: @Byte <- .hollow()
    bits.poke_atomic(0x0F)
    bits_old: Byte = bits.atomic_fetch_or(0xF0)
    Out.write("Byte {bits_old.to[U8]()} {bits.peek_atomic().to[U8]()}\n")

    local other: @U32 <- .hollow()
    local slot: @@U32 <- .hollow()
    slot.poke_atomic(n)
    was: @U32 = slot.atomic_swap(other)
    back: Result[Unit, @U32] = slot.atomic_compare_exchange(expected: other, new: was)
    Out.write("Ptr {back.is_success()} {slot.peek_atomic().peek()}\n")

    local x: @B64 <- .hollow()
    x.poke_atomic(1.5)
    x_add: B64 = x.atomic_fetch_fadd(2.25)
    x_sub: B64 = x.atomic_fetch_fsub_relaxed(0.75)
    Out.write("B64 {x_add} {x_sub} {x.peek_atomic()}\n")

    fence()
    fence_acquire()
    fence_release()
    compiler_fence_acq_rel()
    return
