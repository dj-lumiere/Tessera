# An emitter left with break goes on where it stopped, one made inside the loop starts again on each pass, and one made
# again after its list grew hands out every item.

import Collections
import Hosted

routine start() -> None
    points: &List[S64] <- .construct(HEAP)
    points.add_last(1)
    points.add_last(2)
    points.add_last(3)
    walk: &ListEmitter[S64] <- points.emitter()
    for point in walk
        if point == 2
            break
    for point in walk
        Console.show(point)
    for query in 0 til 2
        fresh: &ListEmitter[S64] <- points.emitter()
        for point in fresh
            Console.show(point + query)
    rest: &ListEmitter[S64] <- points.emitter()
    for point in rest
        Console.show(point)
    points.add_last(4)
    again: &ListEmitter[S64] <- points.emitter()
    for point in again
        Console.show(point)
    return
