# Loops over inclusive ranges inside each other: each keeps its own hidden end flag, so the inner loop's last round
# doesn't end the outer one.

import Standard/Os

### Sums a 3 x 3 grid of index pairs, skipping the diagonal in the innermost loop.
routine start() -> None
    local total: @S64 <- 0
    local rounds: @S64 <- 0

    each a in 0 to 2
        each b in 0 to 2
            (rounds.peek() + 1).poke_into(rounds)
            if a == b
                continue
            each c in 1 to 1
                (total.peek() + a * 10 + b * c).poke_into(total)
    Console.show("{total.peek()} {rounds.peek()}")
    return
