# SHA-256 (FIPS 180-4)
#
# Hashes the standard NIST test vectors and prints each digest in hex.
#
# What this program stresses:
#   * no operators: every rotate, xor, and add of the round function is a
#     method call, so one line of the spec becomes several named values
#   * modular arithmetic: SHA-256 adds words modulo 2^32, so every sum is
#     add_wrap on U32 (a plain add crashes on overflow)
#   * loop-carried state: the eight working variables a..h ride through the
#     round loop as one record value (Working) instead of eight block params
#   * static data: the 64 round constants and the initial hash are preset
#     arrays, read-only globals that the rounds load from (K[t])
#
# Expected output:
#   empty     e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
#   abc       ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
#   448-bit   248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
#   million-a cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0

import Standard/Alloc
import Standard/Os

# ── C FFI ─────────────────────────────────────────────────────────────────────

@external("c")
@symbol("printf")
@variadic
routine c_printf(fmt: @Byte) -> S32

# ── Types ─────────────────────────────────────────────────────────────────────

preset MILLION: USize = 1000000

### K[0..64): the first 32 bits of the fractional parts of the cube roots of the
### first 64 primes.
preset K: @Array[U32, 64] <- [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b,
    0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74,
    0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,
    0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3,
    0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354,
    0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
    0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3,
    0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa,
    0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

### H(0): the first 32 bits of the fractional parts of the square roots of the
### first 8 primes.
preset H0: @Array[U32, 8] <- [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f,
    0x9b05688c, 0x1f83d9ab, 0x5be0cd19]

### The eight working variables of one compression. The round loop carries them
### as a single SSA value, so each jump passes one argument instead of eight.
record Working
    a: U32
    b: U32
    c: U32
    d: U32
    e: U32
    f: U32
    g: U32
    h: U32

# ── Round functions (FIPS 180-4 §4.1.2) ──────────────────────────────────────

### Σ0(x) = ROTR²(x) ⊕ ROTR¹³(x) ⊕ ROTR²²(x)
routine big_sigma0(x: U32) -> U32
    r2: U32 = x.rotr(2)
    r13: U32 = x.rotr(13)
    r22: U32 = x.rotr(22)
    result: U32 = r2 ^ r13 ^ r22
    return result

### Σ1(x) = ROTR⁶(x) ⊕ ROTR¹¹(x) ⊕ ROTR²⁵(x)
routine big_sigma1(x: U32) -> U32
    r6: U32 = x.rotr(6)
    r11: U32 = x.rotr(11)
    r25: U32 = x.rotr(25)
    result: U32 = r6 ^ r11 ^ r25
    return result

### σ0(x) = ROTR⁷(x) ⊕ ROTR¹⁸(x) ⊕ SHR³(x)
routine small_sigma0(x: U32) -> U32
    r7: U32 = x.rotr(7)
    r18: U32 = x.rotr(18)
    s3: U32 = x >> 3
    result: U32 = r7 ^ r18 ^ s3
    return result

### σ1(x) = ROTR¹⁷(x) ⊕ ROTR¹⁹(x) ⊕ SHR¹⁰(x)
routine small_sigma1(x: U32) -> U32
    r17: U32 = x.rotr(17)
    r19: U32 = x.rotr(19)
    s10: U32 = x >> 10
    result: U32 = r17 ^ r19 ^ s10
    return result

### Ch(e, f, g) = (e ∧ f) ⊕ (¬e ∧ g): each bit of e picks f or g.
routine choose(e: U32, f: U32, g: U32) -> U32
    from_f: U32 = e & f
    from_g: U32 = ~e & g
    result: U32 = from_f ^ from_g
    return result

### Maj(a, b, c) = (a ∧ b) ⊕ (a ∧ c) ⊕ (b ∧ c): the bitwise majority vote.
routine majority(a: U32, b: U32, c: U32) -> U32
    ab: U32 = a & b
    ac: U32 = a & c
    bc: U32 = b & c
    result: U32 = ab ^ ac ^ bc
    return result

### One round:
###   T1 = h + Σ1(e) + Ch(e, f, g) + K[t] + W[t]
###   T2 = Σ0(a) + Maj(a, b, c)
###   (a, b, c, d, e, f, g, h) ← (T1 + T2, a, b, c, d + T1, e, f, g)
routine sha256_round(v: Working, k: U32, w: U32) -> Working
    a: U32 = v.a
    b: U32 = v.b
    c: U32 = v.c
    d: U32 = v.d
    e: U32 = v.e
    f: U32 = v.f
    g: U32 = v.g
    h: U32 = v.h

    sigma1: U32 = big_sigma1(e)
    ch: U32 = choose(e, f, g)
    h_sigma_ch: U32 = h +% sigma1 +% ch
    t1: U32 = h_sigma_ch +% k +% w
    sigma0: U32 = big_sigma0(a)
    maj: U32 = majority(a, b, c)
    t2: U32 = sigma0 +% maj

    new_a: U32 = t1 +% t2
    new_e: U32 = d +% t1
    next: Working = Working(a: new_a, b: a, c: b, d: c, e: new_e, f: e, g: f, h: g)
    return next

# ── Byte order ────────────────────────────────────────────────────────────────

### Reads 4 bytes as a big-endian word. Byte loads, so p needs no alignment.
routine load_be32(p: @Byte) -> U32
    b0: Byte = p.stride(0).peek()
    b1: Byte = p.stride(1).peek()
    b2: Byte = p.stride(2).peek()
    b3: Byte = p.stride(3).peek()
    octet0: U8 = b0.to[U8]()
    w0: U32 = octet0.to[U32]() << 24
    octet1: U8 = b1.to[U8]()
    w1: U32 = octet1.to[U32]() << 16
    octet2: U8 = b2.to[U8]()
    w2: U32 = octet2.to[U32]() << 8
    w3: U32 = b3.to[U8]().to[U32]()
    high_half: U32 = w0 | w1
    result: U32 = high_half | w2 | w3
    return result

### Writes value as 8 big-endian bytes.
routine store_be64(p: @Byte, value: U64) -> None
    each i in 0 til 8
        shift: U64 = 56 - i.to[U64]() * 8
        shifted: U64 = value >> shift
        byte: Byte = shifted.to_wrap[U8]().bits()
        p.stride(i).poke(byte)
    then
        return

# ── Compression ───────────────────────────────────────────────────────────────

### Mixes one 64-byte block into the 8-word state.
routine sha256_compress(state: @U32, chunk: @Byte) -> None
    local schedule: @Array[U32, 64] <- .hollow()
    local w: @U32 = schedule.to[@U32]()
    local v: @Working <- .hollow()

    # W[0..16) — the block's own words.
    each t in 0 til 16
        offset: USize = t * 4
        src: @Byte = chunk.stride(offset)
        word: U32 = load_be32(src)
        w.stride(t).poke(word)

    # W[16..64) — W[t] = σ1(W[t-2]) + W[t-7] + σ0(W[t-15]) + W[t-16]
    each t in 16 til 64
        w2: U32 = w.stride(t - 2).peek()
        w7: U32 = w.stride(t - 7).peek()
        w15: U32 = w.stride(t - 15).peek()
        w16: U32 = w.stride(t - 16).peek()
        s1: U32 = small_sigma1(w2)
        s0: U32 = small_sigma0(w15)
        partial_word: U32 = s1 +% w7 +% s0
        w.stride(t).poke(partial_word +% w16)
    a: U32 = state.stride(0).peek()
    b: U32 = state.stride(1).peek()
    c: U32 = state.stride(2).peek()
    d: U32 = state.stride(3).peek()
    e: U32 = state.stride(4).peek()
    f: U32 = state.stride(5).peek()
    g: U32 = state.stride(6).peek()
    h: U32 = state.stride(7).peek()
    start: Working = Working(a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h)
    start.poke_into(v)

    each t in 0 til 64
        k_t: U32 = K.getitem(t)
        w_t: U32 = w.stride(t).peek()
        next: Working = sha256_round(v: v.peek(), k: k_t, w: w_t)
        next.poke_into(v)

    # H[i] += working variable i
    h0: U32 = state.stride(0).peek()
    h1: U32 = state.stride(1).peek()
    h2: U32 = state.stride(2).peek()
    h3: U32 = state.stride(3).peek()
    h4: U32 = state.stride(4).peek()
    h5: U32 = state.stride(5).peek()
    h6: U32 = state.stride(6).peek()
    h7: U32 = state.stride(7).peek()
    state.stride(0).poke(h0 +% v.peek().a)
    state.stride(1).poke(h1 +% v.peek().b)
    state.stride(2).poke(h2 +% v.peek().c)
    state.stride(3).poke(h3 +% v.peek().d)
    state.stride(4).poke(h4 +% v.peek().e)
    state.stride(5).poke(h5 +% v.peek().f)
    state.stride(6).poke(h6 +% v.peek().g)
    state.stride(7).poke(h7 +% v.peek().h)
    return

# ── One-shot hash ─────────────────────────────────────────────────────────────

### Hashes data[0..len) and writes the 8-word digest to digest.
routine sha256(data: @Byte, len: USize, digest: @U32) -> None
    h0: @U32 = H0.to[@U32]()
    digest.copy(src: h0, count: 8)

    # Every complete 64-byte block is compressed straight from data.
    full_blocks: USize = len // 64
    each i in 0 til full_blocks
        offset: USize = i * 64
        src: @Byte = data.stride(offset)
        sha256_compress(state: digest, chunk: src)
    then
        # The tail: leftover bytes, then 0x80, zeros, and the message length in
        # bits as a big-endian U64. That fits one block when fewer than 56 bytes
        # are left over, and takes two otherwise.
        rest_start: USize = full_blocks * 64
        rest_len: USize = len - rest_start

        local tail_buf: @Array[Byte, 128] <- .hollow()
        tail: @Byte = tail_buf.to[@Byte]()
        tail.zeroinit(128)
        rest: @Byte = data.stride(rest_start)
        tail.copy(src: rest, count: rest_len)
        tail.stride(rest_len).poke(b'\x80')

        one_block: Bool = rest_len < 56
        tail_len: USize = when
            one_block => 64
            else => 128
        len_at: USize = tail_len - 8
        bits: U64 = len.to[U64]() << 3
        len_dst: @Byte = tail.stride(len_at)
        store_be64(p: len_dst, value: bits)

        sha256_compress(state: digest, chunk: tail)
        if one_block
            return
        second: @Byte = tail.stride(64)
        sha256_compress(state: digest, chunk: second)
        return

# ── Output ────────────────────────────────────────────────────────────────────

routine print_digest(label: @Byte, digest: @U32) -> None
    c_printf("%-9s ", label)

    each i in 0 til 8
        word: U32 = digest.stride(i).peek()
        c_printf("%08x", word)
    c_printf("\n")
    return

routine hash_and_print(label: @Byte, data: @Byte, len: USize) -> None
    local digest_buf: @Array[U32, 8] <- .hollow()
    digest: @U32 = digest_buf.to[@U32]()
    sha256(data, len, digest)
    print_digest(label, digest)
    return

routine hash_string(label: @Byte, message: Span[Byte]) -> None
    data: @Byte = message.data
    len: USize = message.count
    hash_and_print(label, data, len)
    return

# ── start ─────────────────────────────────────────────────────────────────────

routine start() -> None
    local many: @Memory[Byte] <- .hollow()

    hash_string(label: "empty", message: "")
    hash_string(label: "abc", message: "abc")
    hash_string(label: "448-bit", message: "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")

    # One million 'a' bytes: 15,625 full blocks plus a two-block tail.
    local alloc: @MemoryManager <- make_heap_memory()
    many.poke(.construct(count: MILLION, manager: alloc))

    each i in 0 til MILLION
        many[i] = b'a'
    hash_and_print(label: "million-a", data: many.to[@Byte](), len: MILLION)
    drop many
    return
