// SHA-256 (FIPS 180-4)
//
// Hashes the standard NIST test vectors and prints each digest in hex.
//
// What this program stresses:
//   * no operators: every rotate, xor, and add of the round function is a
//     method call, so one line of the spec becomes several named values
//   * modular arithmetic: SHA-256 adds words modulo 2^32, so every sum is
//     add_wrap on U32 (a plain add panics on overflow)
//   * loop-carried state: the eight working variables a..h ride through the
//     round loop as one record value (Working) instead of eight block params
//   * static data: the 64 round constants and the initial hash are preset
//     arrays, read-only globals that the rounds load from (K[t])
//
// Expected output:
//   empty     e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
//   abc       ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//   448-bit   248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
//   million-a cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0

import Standard::Alloc
import Standard::Os

// ── C FFI ─────────────────────────────────────────────────────────────────────

#[external("c"), symbol("printf"), variadic]
routine c_printf(fmt: @Byte) -> S32

// ── Types ─────────────────────────────────────────────────────────────────────

preset MILLION: USize = 1000000

/// K[0..64): the first 32 bits of the fractional parts of the cube roots of the
/// first 64 primes.
preset K: @Array<U32, 64> <- { 0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b,
        0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6,
        0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d,
        0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85,
        0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585,
        0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
        0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa,
        0xa4506ceb, 0xbef9a3f7, 0xc67178f2 }

/// H(0): the first 32 bits of the fractional parts of the square roots of the
/// first 8 primes.
preset H0: @Array<U32, 8> <- { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f,
        0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }

/// The eight working variables of one compression. The round loop carries them
/// as a single SSA value, so each jump passes one argument instead of eight.
record Working
    a : U32
    b : U32
    c : U32
    d : U32
    e : U32
    f : U32
    g : U32
    h : U32

// ── Round functions (FIPS 180-4 §4.1.2) ──────────────────────────────────────

/// Σ0(x) = ROTR²(x) ⊕ ROTR¹³(x) ⊕ ROTR²²(x)
routine big_sigma0(x: U32) -> U32
    block entry():
        r2     : U32 = x.rotr(2)
        r13    : U32 = x.rotr(13)
        r22    : U32 = x.rotr(22)
        result : U32 = r2.bitxor(r13).bitxor(r22)
        return(result)

/// Σ1(x) = ROTR⁶(x) ⊕ ROTR¹¹(x) ⊕ ROTR²⁵(x)
routine big_sigma1(x: U32) -> U32
    block entry():
        r6     : U32 = x.rotr(6)
        r11    : U32 = x.rotr(11)
        r25    : U32 = x.rotr(25)
        result : U32 = r6.bitxor(r11).bitxor(r25)
        return(result)

/// σ0(x) = ROTR⁷(x) ⊕ ROTR¹⁸(x) ⊕ SHR³(x)
routine small_sigma0(x: U32) -> U32
    block entry():
        r7     : U32 = x.rotr(7)
        r18    : U32 = x.rotr(18)
        s3     : U32 = x.shr(3)
        result : U32 = r7.bitxor(r18).bitxor(s3)
        return(result)

/// σ1(x) = ROTR¹⁷(x) ⊕ ROTR¹⁹(x) ⊕ SHR¹⁰(x)
routine small_sigma1(x: U32) -> U32
    block entry():
        r17    : U32 = x.rotr(17)
        r19    : U32 = x.rotr(19)
        s10    : U32 = x.shr(10)
        result : U32 = r17.bitxor(r19).bitxor(s10)
        return(result)

/// Ch(e, f, g) = (e ∧ f) ⊕ (¬e ∧ g): each bit of e picks f or g.
routine choose(e: U32, f: U32, g: U32) -> U32
    block entry():
        from_f : U32 = e.bitand(f)
        from_g : U32 = e.bitnot().bitand(g)
        result : U32 = from_f.bitxor(from_g)
        return(result)

/// Maj(a, b, c) = (a ∧ b) ⊕ (a ∧ c) ⊕ (b ∧ c): the bitwise majority vote.
routine majority(a: U32, b: U32, c: U32) -> U32
    block entry():
        ab     : U32 = a.bitand(b)
        ac     : U32 = a.bitand(c)
        bc     : U32 = b.bitand(c)
        result : U32 = ab.bitxor(ac).bitxor(bc)
        return(result)

/// One round:
///   T1 = h + Σ1(e) + Ch(e, f, g) + K[t] + W[t]
///   T2 = Σ0(a) + Maj(a, b, c)
///   (a, b, c, d, e, f, g, h) ← (T1 + T2, a, b, c, d + T1, e, f, g)
routine sha256_round(v: Working, k: U32, w: U32) -> Working
    block entry():
        a : U32 = v.a
        b : U32 = v.b
        c : U32 = v.c
        d : U32 = v.d
        e : U32 = v.e
        f : U32 = v.f
        g : U32 = v.g
        h : U32 = v.h

        sigma1 : U32 = big_sigma1(e)
        ch     : U32 = choose(e, f, g)
        t1     : U32 = h.add_wrap(sigma1).add_wrap(ch).add_wrap(k).add_wrap(w)
        sigma0 : U32 = big_sigma0(a)
        maj    : U32 = majority(a, b, c)
        t2     : U32 = sigma0.add_wrap(maj)

        new_a : U32     = t1.add_wrap(t2)
        new_e : U32     = d.add_wrap(t1)
        next  : Working = Working { a: new_a, b: a, c: b, d: c, e: new_e, f: e, g: f, h: g}
        return(next)

// ── Byte order ────────────────────────────────────────────────────────────────

/// Reads 4 bytes as a big-endian word. Byte loads, so p needs no alignment.
routine load_be32(p: @Byte) -> U32
    block entry():
        b0     : Byte = p.stride(0).load()
        b1     : Byte = p.stride(1).load()
        b2     : Byte = p.stride(2).load()
        b3     : Byte = p.stride(3).load()
        w0     : U32  = b0.to<U8>().to<U32>().shl(24)
        w1     : U32  = b1.to<U8>().to<U32>().shl(16)
        w2     : U32  = b2.to<U8>().to<U32>().shl(8)
        w3     : U32  = b3.to<U8>().to<U32>()
        result : U32  = w0.bitor(w1).bitor(w2).bitor(w3)
        return(result)

/// Writes value as 8 big-endian bytes.
routine store_be64(p: @Byte, value: U64) -> Void
    block entry():
        jump byte_loop(0)

    block byte_loop(i: USize):
        done : Bool = i.ge(8)
        branch done
            ? return()
            : continue
        shift : U64  = 56.sub(i.to<U64>().mul(8))
        byte  : Byte = value.shr(shift).to_wrap<U8>().bits()
        p.stride(i).store(byte)
        jump byte_loop(i.add(1))

// ── Compression ───────────────────────────────────────────────────────────────

/// Mixes one 64-byte block into the 8-word state.
routine sha256_compress(state: @U32, chunk: @Byte) -> Void
    block entry():
        claim schedule : @Array<U32, 64> <- uninit
        w : @U32 = schedule.to<@U32>()
        jump load_words(0, w)

    // W[0..16) — the block's own words.
    block load_words(t: USize, w: @U32):
        done : Bool = t.ge(16)
        branch done
            ? extend(16, w)
            : load_word(t, w)

    block load_word(t: USize, w: @U32):
        offset : USize = t.mul(4)
        src    : @Byte = chunk.stride(offset)
        word   : U32   = load_be32(src)
        w.stride(t).store(word)
        jump load_words(t.add(1), w)

    // W[16..64) — W[t] = σ1(W[t-2]) + W[t-7] + σ0(W[t-15]) + W[t-16]
    block extend(t: USize, w: @U32):
        done : Bool = t.ge(64)
        branch done
            ? rounds(w)
            : extend_word(t, w)

    block extend_word(t: USize, w: @U32):
        w2  : U32 = w.stride(t.sub(2)).load()
        w7  : U32 = w.stride(t.sub(7)).load()
        w15 : U32 = w.stride(t.sub(15)).load()
        w16 : U32 = w.stride(t.sub(16)).load()
        s1  : U32 = small_sigma1(w2)
        s0  : U32 = small_sigma0(w15)
        w.stride(t).store(s1.add_wrap(w7).add_wrap(s0).add_wrap(w16))
        jump extend(t.add(1), w)

    block rounds(w: @U32):
        a     : U32     = state.stride(0).load()
        b     : U32     = state.stride(1).load()
        c     : U32     = state.stride(2).load()
        d     : U32     = state.stride(3).load()
        e     : U32     = state.stride(4).load()
        f     : U32     = state.stride(5).load()
        g     : U32     = state.stride(6).load()
        h     : U32     = state.stride(7).load()
        start : Working = Working { a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h }
        jump round_loop(0, start, w)

    block round_loop(t: USize, v: Working, w: @U32):
        done : Bool = t.ge(64)
        branch done
            ? finish(v)
            : round(t, v, w)

    block round(t: USize, v: Working, w: @U32):
        k_t  : U32     = K.get(t)
        w_t  : U32     = w.stride(t).load()
        next : Working = sha256_round(v, k_t, w_t)
        jump round_loop(t.add(1), next, w)

    // H[i] += working variable i
    block finish(v: Working):
        h0 : U32 = state.stride(0).load()
        h1 : U32 = state.stride(1).load()
        h2 : U32 = state.stride(2).load()
        h3 : U32 = state.stride(3).load()
        h4 : U32 = state.stride(4).load()
        h5 : U32 = state.stride(5).load()
        h6 : U32 = state.stride(6).load()
        h7 : U32 = state.stride(7).load()
        state.stride(0).store(h0.add_wrap(v.a))
        state.stride(1).store(h1.add_wrap(v.b))
        state.stride(2).store(h2.add_wrap(v.c))
        state.stride(3).store(h3.add_wrap(v.d))
        state.stride(4).store(h4.add_wrap(v.e))
        state.stride(5).store(h5.add_wrap(v.f))
        state.stride(6).store(h6.add_wrap(v.g))
        state.stride(7).store(h7.add_wrap(v.h))
        return()

// ── One-shot hash ─────────────────────────────────────────────────────────────

/// Hashes data[0..len) and writes the 8-word digest to digest.
routine sha256(data: @Byte, len: USize, digest: @U32) -> Void
    block entry():
        h0 : @U32 = H0.to<@U32>()
        copy<U32>(digest, h0, 8)
        full_blocks : USize = len.div(64)
        jump block_loop(0, full_blocks)

    // Every complete 64-byte block is compressed straight from data.
    block block_loop(i: USize, full_blocks: USize):
        done : Bool = i.ge(full_blocks)
        branch done
            ? pad(full_blocks)
            : compress_block(i, full_blocks)

    block compress_block(i: USize, full_blocks: USize):
        offset : USize = i.mul(64)
        src    : @Byte = data.stride(offset)
        sha256_compress(digest, src)
        jump block_loop(i.add(1), full_blocks)

    // The tail: leftover bytes, then 0x80, zeros, and the message length in
    // bits as a big-endian U64. That fits one block when fewer than 56 bytes
    // are left over, and takes two otherwise.
    block pad(full_blocks: USize):
        rest_start : USize = full_blocks.mul(64)
        rest_len   : USize = len.sub(rest_start)

        claim tail_buf : @Array<Byte, 128> <- uninit
        tail : @Byte = tail_buf.to<@Byte>()
        tail.zeroinit(128)
        rest : @Byte = data.stride(rest_start)
        copy<Byte>(tail, rest, rest_len)
        tail.stride(rest_len).store(b'\x80')

        one_block : Bool  = rest_len.lt(56)
        tail_len  : USize = one_block
            ? 64
            : 128
        len_at  : USize = tail_len.sub(8)
        bits    : U64   = len.to<U64>().shl(3)
        len_dst : @Byte = tail.stride(len_at)
        store_be64(len_dst, bits)

        sha256_compress(digest, tail)
        branch one_block
            ? return()
            : continue
        second : @Byte = tail.stride(64)
        sha256_compress(digest, second)
        return()

// ── Output ────────────────────────────────────────────────────────────────────

routine print_digest(label: @Byte, digest: @U32) -> Void
    block entry():
        c_printf("%-9s ", label)
        jump word_loop(0)

    block word_loop(i: USize):
        done : Bool = i.ge(8)
        branch done
            ? end_line()
            : print_word(i)

    block print_word(i: USize):
        word : U32 = digest.stride(i).load()
        c_printf("%08x", word)
        jump word_loop(i.add(1))

    block end_line():
        c_printf("\n")
        return()

routine hash_and_print(label: @Byte, data: @Byte, len: USize) -> Void
    block entry():
        claim digest_buf : @Array<U32, 8> <- uninit
        digest : @U32 = digest_buf.to<@U32>()
        sha256(data, len, digest)
        print_digest(label, digest)
        return()

routine hash_string(label: @Byte, message: Bytes) -> Void
    block entry():
        data : @Byte = message.data
        len  : USize = message.length
        hash_and_print(label, data, len)
        return()

// ── main ──────────────────────────────────────────────────────────────────────

routine main() -> S32
    block entry():
        hash_string("empty", "")
        hash_string("abc", "abc")
        hash_string("448-bit", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")

        // One million 'a' bytes: 15,625 full blocks plus a two-block tail.
        claim alloc : @Allocator <- make_heap_allocator()
        many   : @Byte = allocate<Byte>(alloc, MILLION)
        failed : Bool  = many.is_null()
        branch failed
            ? panic(TrapCode.AllocFailed)
            : fill_loop(0, alloc, many)

    block fill_loop(i: USize, alloc: @Allocator, many: @Byte):
        done : Bool = i.ge(MILLION)
        branch done
            ? hash_many(alloc, many)
            : fill_byte(i, alloc, many)

    block fill_byte(i: USize, alloc: @Allocator, many: @Byte):
        many.stride(i).store(b'a')
        jump fill_loop(i.add(1), alloc, many)

    block hash_many(alloc: @Allocator, many: @Byte):
        hash_and_print("million-a", many, MILLION)
        many.free(alloc)
        return(0)
