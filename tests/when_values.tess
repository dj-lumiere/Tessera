// A when v arm may list several values. They share the arm, a value in two arms is an error, and a choice is
// still checked for every member. Ranges aren't a when pattern use between / in_range in when.

import Standard::Format
import Standard::Os

choice Shape: U8
    Circle   : 0
    Square   : 1
    Triangle : 2
    Hexagon  : 3

routine kind(c: Byte) -> S64
    block entry()
        when c
            b'+', b'-'         -> return(1)
            b' ', b'\t', b'\n' -> return(2)
            else               -> continue
        when
            c.between(b'0', b'9') -> return(3)
            else                  -> return(0)

routine corners(s: Shape) -> S64
    block entry()
        when s
            Shape.Circle                -> return(0)
            Shape.Square, Shape.Hexagon -> return(4)
            Shape.Triangle              -> return(3)

routine is_small(n: U64) -> Bool
    block entry()
        when n
            0, 1, 2, 3 -> return(true)
            else       -> return(false)

routine main() -> S32
    block entry()
        Out.write("{kind(b'+')} {kind(b'-')} {kind(b' ')} {kind(b'\n')} {kind(b'7')} {kind(b'x')}\n")
        Out.write("{corners(Shape.Circle)} {corners(Shape.Hexagon)} {corners(Shape.Triangle)}\n")
        Out.write("{is_small(2)} {is_small(4)}\n")
        return(0)
