# A read the OS refuses throws IoError from read_line, where the console reads a failure as the end of the input. A
# directory opens for reading on Linux, and reading it fails.

import Hosted

### Writes what reading a line from the open file gave: a line, or the name of the failure.
routine show_line(h: @FileHandle, manager: @MemoryManager) -> None
    when check h.read_line(manager)
        is BorrowedSlice[Byte] as text =>
            drop text
            Console.show("read_line on a directory: a line")
        is Crashables as e => Console.show("read_line on a directory: {e.name()}")
    return

routine show_value(h: @FileHandle) -> None
    when check h.read[S32]()
        is S32 => Console.show("read[S32] on a directory: a number")
        is Crashables as e => Console.show("read[S32] on a directory: {e.name()}")
    return

routine show_rest(h: @FileHandle, manager: @MemoryManager) -> None
    when check h.read_all(manager)
        is BorrowedSlice[Byte] as rest =>
            drop rest
            Console.show("read_all on a directory: bytes")
        is Crashables as e => Console.show("read_all on a directory: {e.name()}")
    return

routine start() -> None
    manager: @MemoryManager = HEAP
    tmp: &Directory <- OsEnvironment.temp_directory(manager)
    as_file: &File <- File.at(tmp.path.peek())
    opened: &FileHandle <- OsFileManager.open_read(at: as_file)
    show_line(opened, manager)
    show_value(opened)
    show_rest(opened, manager)
    opened.close()
    drop as_file
    drop tmp
    return
