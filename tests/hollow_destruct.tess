/// Every destruct leaves a hollow value alone: a slot that starts as .hollow() is safe to release unfilled.
import Standard/Os
import Standard/Collections
import Standard/Format

routine start() -> Void
    block entry()
        claim l : @List[S64] <- .hollow()
        l.destruct()
        claim d : @Dict[S64, S64] <- .hollow()
        d.destruct()
        claim st : @Set[S64] <- .hollow()
        st.destruct()
        claim b : @Bytes <- .hollow()
        b.destruct()
        claim s : @Slice[U8] <- .hollow()
        s.destruct()
        claim c : @CircularList[S64] <- .hollow()
        c.destruct()
        claim sd : @SortedDict[S64, S64] <- .hollow()
        sd.destruct()
        claim pq : @PriorityQueue[S64, S64] <- .hollow()
        pq.destruct()
        Out.write("ok\n")
        return()
