# A tuple is a record, copied with =, so it never holds an entity: a pair of a Counter and a count is an entity of its
# own, or holds the Counter through a pointer.
import Standard/Os

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
common routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine @Counter.destruct() -> None
    return

### Takes a counter over and ends it.
### :param c: The counter.
routine finish(c: Counter) -> None
    slot: &Counter <- steal c

    drop slot
    return

routine start() -> None
    pair: (Counter, S64) = (Counter.construct(), 1)

    return
