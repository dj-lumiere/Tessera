/// A conformance is checked against the concept's routine signatures, even if nothing uses it.
record Point
conform Equatable[Point]
    x: S64

/// Makes a `Point` from its fields.
/// :param x: Its `x`.
/// :returns: The new value.
routine Point.construct(x: S64) -> Me
    return(Me(x))

/// Releases nothing: a `Point` holds no memory of its own.
routine Point.destruct(me: @Me) -> Void
    return()

routine Point.eq(me: Me, other: Me) -> S64
    return(0)

routine start() -> Void
    return()
