# A D64 operation whose result is infinite stops the program with NumericOverflowError.

import Ingrid/Decimal
import Hosted

routine start() -> None
    top: D64 = "9.999999999999999e384".to[D64]()
    ten: D64 = S64.to[D64](10)
    Console.show("before")
    Console.show("{top * ten}")
    return
