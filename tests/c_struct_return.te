# Records cross the C ABI by value: libc's div returns an 8-byte div_t (in a register on x86-64, AArch64, and 32-bit
# Windows, via sret on 32-bit Linux), lldiv a 16-byte lldiv_t (two registers on x86-64 System V and AArch64,
# sret on Win64 and 32-bit x86).

import Standard/Format
import Standard/Os

record DivT
    quot: CInt
    rem: CInt

record LldivT
    quot: S64
    rem: S64

### Makes a `DivT` from its fields.
### :param quot: Its `quot`.
### :param rem: Its `rem`.
### :returns: The new value.
routine DivT.construct(quot: CInt, rem: CInt) -> Me
    return Me(quot, rem)

### Releases nothing: a `DivT` holds no memory of its own.
routine DivT.destruct(me: @Me) -> None
    return

@external("c")
@symbol("div")
routine c_div(numer: CInt, denom: CInt) -> DivT

@external("c")
@symbol("lldiv")
routine c_lldiv(numer: S64, denom: S64) -> LldivT

routine start() -> None
    d: DivT = c_div(-7, 2)
    l: LldivT = c_lldiv(1000000000000007, 1000)
    Console.show("div {d.quot} {d.rem}")
    Console.show("lldiv {l.quot} {l.rem}")
    return
