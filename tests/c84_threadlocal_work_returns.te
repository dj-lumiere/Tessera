# Work on another thread returning the address of its own @threadlocal is a build error: the thread that waits for
# the work would read the other thread's copy, gone once that thread ends.
module C84/ThreadlocalWorkReturns
import Standard/Hosted

@threadlocal
global COUNTER: &S64 <- 1234567

### The running thread's counter address.
### :param n: Unused.
### :returns: The address.
routine where_is(n: S64) -> @S64
    return COUNTER

### Runs the example.
routine start() -> None
    t: Thread[@S64] <- get_thread[@S64]()
    work_t: Work[@S64] = where_is.to[Work](n: 0)
    t.put_work(work_t)
    p: @S64 = t.retrieve()
    drop t
    Console.show("kept: {p.peek()} (expected 1234567, the thread is gone)")
    return
