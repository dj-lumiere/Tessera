# A piece of work goes only to a ticket (or a routine of the program that takes a Work[T] and puts it on one): handed
# into a list, no ticket would run it, a build error.

import Standard/Collections
import Standard/Os

routine seven() -> S64
    return 7

routine start() -> None
    works: &List[Work[S64]] <- .construct(manager: HEAP)
    work: Work[S64] = seven.to[Work]()
    works.add_last(steal work)
    return
