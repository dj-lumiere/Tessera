# Work handed an entity goes only to a ticket (or a routine of the program that takes a Work[T] and puts it on one):
# handed into a list, no ticket would run it, a build error.

import Standard/Collections
import Standard/Os

### A value with nothing in it but its number.
entity Token
    n: S64

### Makes one.
### :param n: Its number.
### :returns: The new value.
common routine Token.construct(n: S64) -> Me
    return Me(n)

### Reads the number and ends what it was handed.
### :param item: What it was handed.
### :returns: Its number.
routine look(item: Token) -> S64
    n: S64 = item.n.peek()
    drop item
    return n

routine start() -> None
    works: &List[Work[S64]] <- .construct(manager: HEAP)
    a: &Token <- Token.construct(1)
    work: Work[S64] = look.to[Work](item: steal a)
    works.add_last(steal work)
    return
