# A global that holds memory lives as long as the program: start doesn't drop it, and the program's end gives it back.

import Standard/Alloc
import Standard/Format
import Standard/Os

global CACHE: @Memory[Byte]

routine start() -> None
    CACHE.replace(Memory[Byte].construct(count: 8, manager: DEFAULT_HEAP))
    Out.write("{CACHE.count()}\n")
    return
