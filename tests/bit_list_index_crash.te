# BitList.getitem past the count crashes with IndexOutOfBoundsError at the caller's line, also when the
# byte holding that bit is allocated.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("bit_list_index_crash.te")
    Console.show("crashed: {name}: {message} at this file {here}, line {place.line.peek()}")
    exit(3)

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local bits: @BitList <- .construct(alloc)

    bits.add_last(true)
    bits.add_last(false)
    Console.show("{bits[1]}")
    gone: Bool = bits[2]
    Console.show("not reached {gone}")
    drop bits
    return
