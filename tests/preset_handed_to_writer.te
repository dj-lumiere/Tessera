# A preset handed to a routine that writes through the view it takes is a build error, as a write into it is.

preset TABLE: Items[U8, _] = [1, 2, 3]

### Puts 9 first in `values`.
### :param values: The values to change.
routine mark(values: @[U8]) -> None
    values.getslot(0).poke(9)
    return

routine start() -> None
    mark(TABLE)
    return
