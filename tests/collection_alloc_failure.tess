# The `_result` forms against an allocator that fails after a budget of calls, and the `_checked` forms on empty
# collections and missing keys. Each case inserts 0, 1, 2, ... until the allocator fails, checks that the collection
# still holds exactly what went in, then grants more budget and inserts once more. The budgets reach every failure
# point: a partial Dict / Set rehash, a B-tree leaf split during descent, and a root split whose sibling fails.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

@external("c")
@symbol("malloc")
routine c_malloc(size: USize) -> Addr

@external("c")
@symbol("realloc")
routine c_realloc(ptr: Addr, size: USize) -> Addr

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

# -- the budgeted allocator: state points at the number of calls still allowed --------------------------------------

routine take_budget(state: Addr) -> Bool
    budget: @USize = state.to[@USize]()
    left: USize = budget.peek()
    if left == 0
        return false
    (left - 1).poke_into(budget)
    return true

routine budget_alloc(state: Addr, size: USize, align: USize) -> Addr
    if take_budget(state)
        return c_malloc(size)
    else
        return null

routine budget_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    if take_budget(state)
        return c_realloc(old, size)
    else
        return null

routine budget_free(state: Addr, ptr: Addr) -> None
    c_free(ptr)
    return

# -- sequences ------------------------------------------------------------------------------------------------------

routine list_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local list: @List[S64] <- .hollow()

    budget.poke(grant)
    list_val: List[S64] = .construct(alloc)
    list.poke(list_val)

    while true with i: S64 = 0
        pushed: Result[None, AllocFailed] = list.add_last_result(i)
        when pushed
            is None => continue with i: i + 1
            is AllocFailed => break
    Out.write("List, budget {grant}: {list.peek()}\n")
    budget.poke(1)
    list.add_last(99)
    Out.write("  then push: {list.peek()}\n")
    drop list
    return

routine circular_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local deque: @CircularList[S64] <- .hollow()

    budget.poke(grant)
    deque_val: CircularList[S64] = .construct(alloc)
    deque.poke(deque_val)

    # Alternates ends, so both push_front_result and push_back_result reach the allocator.
    while true with i: S64 = 0
        front: Bool = i.mod_trunc(2) == 1
        pushed: Result[None, AllocFailed] = when
            front => deque.add_first_result(i)
            else => deque.add_last_result(i)
        when pushed
            is None => continue with i: i + 1
            is AllocFailed => break
    Out.write("CircularList, budget {grant}: {deque.peek()}\n")
    budget.poke(1)
    deque.add_first(99)
    Out.write("  then push_front: {deque.peek()}\n")
    drop deque
    return

routine queue_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local queue: @PriorityQueue[S64, S64] <- .hollow()

    budget.poke(grant)
    queue_val: PriorityQueue[S64, S64] = .construct(alloc)
    queue.poke(queue_val)

    # Pushes 100, 99, 98, ..., so each push sifts to the top.
    while true with i: S64 = 0
        value: S64 = S64.sub(100, i)
        pushed: Result[None, AllocFailed] = queue.add_result(priority: value, element: value)
        when pushed
            is None => continue with i: i + 1
            is AllocFailed => break
    Out.write("PriorityQueue, budget {grant}: {queue.count()} elements, top {queue.first_checked()}\n")
    budget.poke(1)
    queue.add(priority: 0, element: 0)
    Out.write("  then push: top {queue.remove()}, next {queue.remove_checked()}\n")
    drop queue
    return

# -- hash collections -----------------------------------------------------------------------------------------------

# Every key below count maps to ten times itself.
routine is_dict_intact(map: @Dict[S64, S64], count: S64) -> Bool
    size: USize = map.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            value: S64 = map[i]
            if value == i * 10
                continue
            else
                return false
        then
            return true
    else
        return false

routine dict_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local map: @Dict[S64, S64] <- .hollow()

    budget.poke(grant)
    map_val: Dict[S64, S64] = .construct(alloc)
    map.poke(map_val)

    while true with i: S64 = 0
        put: Result[None, AllocFailed] = map.setitem_result(key: i, value: i * 10)
        when put
            is None => continue with i: i + 1
            is AllocFailed =>
                count: S64 = i
                Out.write("Dict, budget {grant}: {count} entries, intact {is_dict_intact(map, count)}")
                budget.poke(5)
                map[count] = count * 10
                Out.write(", then put: intact {is_dict_intact(map, count: count.add(1))}\n")
                drop map
                return

routine is_set_intact(set: @Set[S64], count: S64) -> Bool
    size: USize = set.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            if set.has(i)
                continue
            else
                return false
        then
            return true
    else
        return false

routine set_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local set: @Set[S64] <- .hollow()

    budget.poke(grant)
    set_val: Set[S64] = .construct(alloc)
    set.poke(set_val)

    while true with i: S64 = 0
        added: Result[Bool, AllocFailed] = set.add_result(i)
        when added
            is Bool => continue with i: i + 1
            is AllocFailed =>
                count: S64 = i
                Out.write("Set, budget {grant}: {count} keys, intact {is_set_intact(set, count)}")
                budget.poke(4)
                added2: Bool = set + count
                again: Result[Bool, AllocFailed] = set.add_result(count)
                Out.write(", then add: {added2}, again {again}, intact {is_set_intact(set, count: count.add(1))}\n")
                drop set
                return

# -- B-trees --------------------------------------------------------------------------------------------------------

# Rank i holds key i and value ten times i, and get finds each key.
routine is_sorted_dict_intact(map: @SortedDict[S64, S64], count: S64) -> Bool
    size: USize = map.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            pair: KVPair[S64, S64] = map.get_by_rank(i.to[USize]())
            key: S64 = pair.key
            value: S64 = pair.value
            found: S64 = map[i]
            tens: S64 = i * 10
            pair_right: Bool = key == i and value == tens
            if pair_right and found == tens
                continue
            else
                return false
        then
            return true
    else
        return false

routine sorted_dict_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local map: @SortedDict[S64, S64] <- .hollow()

    budget.poke(grant)
    map_val: SortedDict[S64, S64] = .construct(alloc)
    map.poke(map_val)

    while true with i: S64 = 0
        put: Result[None, AllocFailed] = map.setitem_result(key: i, value: i * 10)
        when put
            is None => continue with i: i + 1
            is AllocFailed =>
                count: S64 = i
                Out.write("SortedDict, budget {grant}: {count} entries, intact {is_sorted_dict_intact(map, count)}")
                budget.poke(3)
                map[count] = count * 10
                Out.write(", then put: intact {is_sorted_dict_intact(map, count: count.add(1))}\n")
                drop map
                return

routine is_sorted_set_intact(set: @SortedSet[S64], count: S64) -> Bool
    size: USize = set.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            key: S64 = set.get_by_rank(i.to[USize]())
            if (key == i) & set.has(i)
                continue
            else
                return false
        then
            return true
    else
        return false

routine sorted_set_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local set: @SortedSet[S64] <- .hollow()

    budget.poke(grant)
    set_val: SortedSet[S64] = .construct(alloc)
    set.poke(set_val)

    while true with i: S64 = 0
        added: Result[Bool, AllocFailed] = set.add_result(i)
        when added
            is Bool => continue with i: i + 1
            is AllocFailed =>
                count: S64 = i
                Out.write("SortedSet, budget {grant}: {count} keys, intact {is_sorted_set_intact(set, count)}")
                budget.poke(3)
                added2: Bool = set + count
                Out.write(", then add: {added2}, intact {is_sorted_set_intact(set, count: count.add(1))}\n")
                drop set
                return

routine is_sorted_list_intact(list: @SortedList[S64], count: S64) -> Bool
    size: USize = list.count()
    held: S64 = size.to[S64]()
    if held == count
        each i in 0 til count
            value: S64 = list[i.to[USize]()]
            position: USize = list.rank(i)
            rank: S64 = position.to[S64]()
            if value == i and rank == i
                continue
            else
                return false
        then
            return true
    else
        return false

routine sorted_list_case(budget: @USize, grant: USize, alloc: @MemoryManager) -> None
    local list: @SortedList[S64] <- .hollow()

    budget.poke(grant)
    list_val: SortedList[S64] = .construct(alloc)
    list.poke(list_val)

    while true with i: S64 = 0
        pushed: Result[None, AllocFailed] = list.add_result(i)
        when pushed
            is None => continue with i: i + 1
            is AllocFailed =>
                count: S64 = i
                Out.write("SortedList, budget {grant}: {count} elements, intact {is_sorted_list_intact(list, count)}")
                budget.poke(3)
                list.add(count)
                Out.write(", then push: intact {is_sorted_list_intact(list, count: count.add(1))}\n")
                drop list
                return

# -- the _checked forms -----------------------------------------------------------------------------------------------

routine checked_forms(budget: @USize, alloc: @MemoryManager) -> None
    budget.poke(100)
    list_val: List[S64] = .construct(alloc)
    local list: @List[S64] <- list_val
    Out.write("List: pop_checked {list.remove_last_checked()}")
    list.add_last(7)
    Out.write(", get_checked(0) {list.getitem_checked(0)}, get_checked(1) {list.getitem_checked(1)}")
    Out.write(", pop_checked {list.remove_last_checked()}\n")
    drop list

    deque_val: CircularList[S64] = .construct(alloc)
    local deque: @CircularList[S64] <- deque_val
    Out.write("CircularList: pop_front_checked {deque.remove_first_checked()}")
    Out.write(", pop_back_checked {deque.remove_last_checked()}")
    deque.add_last(1)
    deque.add_last(2)
    Out.write(", get_checked(1) {deque.getitem_checked(1)}, get_checked(2) {deque.getitem_checked(2)}")
    Out.write(", pop_front_checked {deque.remove_first_checked()}, pop_checked {deque.remove_last_checked()}\n")
    drop deque

    queue_val: PriorityQueue[S64, S64] = .construct(alloc)
    local queue: @PriorityQueue[S64, S64] <- queue_val
    Out.write("PriorityQueue: peek_checked {queue.first_checked()}, pop_checked {queue.remove_checked()}")
    queue.add(priority: 5, element: 5)
    queue.add(priority: 3, element: 3)
    Out.write(", peek_checked {queue.first_checked()}, pop_checked {queue.remove_checked()}\n")
    drop queue

    map_val: Dict[S64, S64] = .construct(alloc)
    local map: @Dict[S64, S64] <- map_val
    Out.write("Dict: get_checked(1) {map.getitem_checked(1)}")
    map[1] = 10
    Out.write(", after put {map.getitem_checked(1)}, get_checked(2) {map.getitem_checked(2)}\n")
    drop map

    local sorted: @SortedDict[S64, S64] <- .construct(alloc)
    Out.write("SortedDict: get_checked(1) {sorted.getitem_checked(1)}")
    sorted[1] = 10
    Out.write(", after put {sorted.getitem_checked(1)}, get_checked(2) {sorted.getitem_checked(2)}\n")
    drop sorted

    local ordered: @SortedList[S64] <- .construct(alloc)
    Out.write("SortedList: get_checked(0) {ordered.getitem_checked(0)}")
    ordered.add(4)
    Out.write(", after push {ordered.getitem_checked(0)}\n")
    drop ordered
    return

routine start() -> None
    local budget: @USize <- 0
    local budgeted: MemoryManager = MemoryManager(alloc_fn: budget_alloc.to[Callable](),
        realloc_fn: budget_realloc.to[Callable](), free_fn: budget_free.to[Callable](),
        reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: budget)
    local alloc: @MemoryManager <- budgeted

    each grant in 0 to 2
        list_case(budget, grant, alloc)
        circular_case(budget, grant, alloc)
        queue_case(budget, grant, alloc)

    # Dict rehashes into 5 arrays and Set into 4, so the budgets stop partway through a rehash too.
    each grant in 0 to 12
        dict_case(budget, grant, alloc)
        set_case(budget, grant, alloc)

    # Ascending keys fill a root leaf (1 node), split it (2 more), add leaves until the root is full (6 more), then
    # split the root again (2) above one more leaf split: budgets up to 12 fail at each of those steps.
    each grant in 0 to 12
        sorted_dict_case(budget, grant, alloc)
        sorted_set_case(budget, grant, alloc)
        sorted_list_case(budget, grant, alloc)
    checked_forms(budget, alloc)
    return
