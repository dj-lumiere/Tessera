// The `_result` forms against an allocator that fails after a budget of calls, and the `_checked` forms on empty
// collections and missing keys. Each case inserts 0, 1, 2, ... until the allocator fails, checks that the collection
// still holds exactly what went in, then grants more budget and inserts once more. The budgets reach every failure
// point: a partial Dict / Set rehash, a B-tree leaf split during descent, and a root split whose sibling fails.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

#[external("c"), symbol("malloc")]
routine c_malloc(size: USize) -> Addr

#[external("c"), symbol("realloc")]
routine c_realloc(ptr: Addr, size: USize) -> Addr

#[external("c"), symbol("free")]
routine c_free(ptr: Addr) -> Void

// -- the budgeted allocator: state points at the number of calls still allowed --------------------------------------

routine take_budget(state: Addr) -> Bool
    block entry()
        budget : @USize = state.to<@USize>()
        left   : USize  = budget.load()
        spent  : Bool   = left.eq(0)
        branch spent
            ? return(false)
            : continue
        left.sub(1).store_into(budget)
        return(true)

routine budget_alloc(state: Addr, size: USize) -> Addr
    block entry()
        allowed : Bool = take_budget(state)
        branch allowed
            ? return(c_malloc(size))
            : return(null)

routine budget_realloc(state: Addr, old: Addr, size: USize) -> Addr
    block entry()
        allowed : Bool = take_budget(state)
        branch allowed
            ? return(c_realloc(old, size))
            : return(null)

routine budget_free(state: Addr, ptr: Addr) -> Void
    block entry()
        c_free(ptr)
        return()

// -- sequences ------------------------------------------------------------------------------------------------------

routine list_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared list : @List<S64> <- uninit

    block entry()
        budget.store(grant)
        list_val : List<S64> = .construct(alloc)
        list.store(list_val)
        jump fill(0)

    block fill(i: S64)
        pushed : Result<Unit, AllocFailed> = list.push_result(i)
        when pushed
            .Success -> fill(i.add(1))
            .Failure -> failed()

    block failed()
        Out.write("List, budget {grant}: {list.load()}\n")
        budget.store(1)
        list.push(99)
        Out.write("  then push: {list.load()}\n")
        list.destruct()
        return()

routine circular_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared deque : @CircularList<S64> <- uninit

    block entry()
        budget.store(grant)
        deque_val : CircularList<S64> = .construct(alloc)
        deque.store(deque_val)
        jump fill(0)

    // Alternates ends, so both push_front_result and push_back_result reach the allocator.
    block fill(i: S64)
        front : Bool = i.mod(2).eq(1)
        branch front
            ? push_front(i)
            : push_back(i)

    block push_front(i: S64)
        pushed : Result<Unit, AllocFailed> = deque.push_front_result(i)
        jump pushed(i, pushed)

    block push_back(i: S64)
        pushed : Result<Unit, AllocFailed> = deque.push_back_result(i)
        jump pushed(i, pushed)

    block pushed(i: S64, pushed: Result<Unit, AllocFailed>)
        when pushed
            .Success -> fill(i.add(1))
            .Failure -> failed()

    block failed()
        Out.write("CircularList, budget {grant}: {deque.load()}\n")
        budget.store(1)
        deque.push_front(99)
        Out.write("  then push_front: {deque.load()}\n")
        deque.destruct()
        return()

routine queue_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared queue : @PriorityQueue<S64, S64> <- uninit

    block entry()
        budget.store(grant)
        queue_val : PriorityQueue<S64, S64> = .construct(alloc)
        queue.store(queue_val)
        jump fill(0)

    // Pushes 100, 99, 98, ..., so each push sifts to the top.
    block fill(i: S64)
        value  : S64                       = S64.sub(100, i)
        pushed : Result<Unit, AllocFailed> = queue.push_result(value, value)
        when pushed
            .Success -> fill(i.add(1))
            .Failure -> failed()

    block failed()
        Out.write("PriorityQueue, budget {grant}: {queue.count()} elements, top {queue.peek_checked()}\n")
        budget.store(1)
        queue.push(0, 0)
        Out.write("  then push: top {queue.pop()}, next {queue.pop_checked()}\n")
        queue.destruct()
        return()

// -- hash collections -----------------------------------------------------------------------------------------------

// Every key below count maps to ten times itself.
routine is_dict_intact(map: @Dict<S64, S64>, count: S64) -> Bool
    block entry()
        size : USize = map.count()
        held : S64   = size.to<S64>()
        same : Bool  = held.eq(count)
        branch same
            ? check(0)
            : return(false)

    block check(i: S64)
        done : Bool = i.ge(count)
        branch done
            ? return(true)
            : continue
        value : S64  = map.getitem(i)
        right : Bool = value.eq(i.mul(10))
        branch right
            ? check(i.add(1))
            : return(false)

routine dict_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared map : @Dict<S64, S64> <- uninit

    block entry()
        budget.store(grant)
        map_val : Dict<S64, S64> = .construct(alloc)
        map.store(map_val)
        jump fill(0)

    block fill(i: S64)
        put : Result<Unit, AllocFailed> = map.put_result(i, i.mul(10))
        when put
            .Success -> fill(i.add(1))
            .Failure -> failed(i)

    block failed(count: S64)
        Out.write("Dict, budget {grant}: {count} entries, intact {is_dict_intact(map, count)}")
        budget.store(5)
        map.put(count, count.mul(10))
        Out.write(", then put: intact {is_dict_intact(map, count.add(1))}\n")
        map.destruct()
        return()

routine is_set_intact(set: @Set<S64>, count: S64) -> Bool
    block entry()
        size : USize = set.count()
        held : S64   = size.to<S64>()
        same : Bool  = held.eq(count)
        branch same
            ? check(0)
            : return(false)

    block check(i: S64)
        done : Bool = i.ge(count)
        branch done
            ? return(true)
            : continue
        has : Bool = set.has(i)
        branch has
            ? check(i.add(1))
            : return(false)

routine set_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared set : @Set<S64> <- uninit

    block entry()
        budget.store(grant)
        set_val : Set<S64> = .construct(alloc)
        set.store(set_val)
        jump fill(0)

    block fill(i: S64)
        added : Result<Bool, AllocFailed> = set.add_result(i)
        when added
            .Success -> fill(i.add(1))
            .Failure -> failed(i)

    block failed(count: S64)
        Out.write("Set, budget {grant}: {count} keys, intact {is_set_intact(set, count)}")
        budget.store(4)
        added : Bool                      = set.add(count)
        again : Result<Bool, AllocFailed> = set.add_result(count)
        Out.write(", then add: {added}, again {again}, intact {is_set_intact(set, count.add(1))}\n")
        set.destruct()
        return()

// -- B-trees --------------------------------------------------------------------------------------------------------

// Rank i holds key i and value ten times i, and get finds each key.
routine is_sorted_dict_intact(map: @SortedDict<S64, S64>, count: S64) -> Bool
    block entry()
        size : USize = map.count()
        held : S64   = size.to<S64>()
        same : Bool  = held.eq(count)
        branch same
            ? check(0)
            : return(false)

    block check(i: S64)
        done : Bool = i.ge(count)
        branch done
            ? return(true)
            : continue
        pair       : KVPair<S64, S64> = map.get_by_rank(i.to<USize>())
        key        : S64              = pair.key
        value      : S64              = pair.value
        found      : S64              = map.getitem(i)
        tens       : S64              = i.mul(10)
        pair_right : Bool             = key.eq(i).bitand(value.eq(tens))
        right      : Bool             = pair_right.bitand(found.eq(tens))
        branch right
            ? check(i.add(1))
            : return(false)

routine sorted_dict_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared map : @SortedDict<S64, S64> <- uninit

    block entry()
        budget.store(grant)
        map_val : SortedDict<S64, S64> = .construct(alloc)
        map.store(map_val)
        jump fill(0)

    block fill(i: S64)
        put : Result<Unit, AllocFailed> = map.put_result(i, i.mul(10))
        when put
            .Success -> fill(i.add(1))
            .Failure -> failed(i)

    block failed(count: S64)
        Out.write("SortedDict, budget {grant}: {count} entries, intact {is_sorted_dict_intact(map, count)}")
        budget.store(3)
        map.put(count, count.mul(10))
        Out.write(", then put: intact {is_sorted_dict_intact(map, count.add(1))}\n")
        map.destruct()
        return()

routine is_sorted_set_intact(set: @SortedSet<S64>, count: S64) -> Bool
    block entry()
        size : USize = set.count()
        held : S64   = size.to<S64>()
        same : Bool  = held.eq(count)
        branch same
            ? check(0)
            : return(false)

    block check(i: S64)
        done : Bool = i.ge(count)
        branch done
            ? return(true)
            : continue
        key   : S64  = set.get_by_rank(i.to<USize>())
        right : Bool = key.eq(i).bitand(set.has(i))
        branch right
            ? check(i.add(1))
            : return(false)

routine sorted_set_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared set : @SortedSet<S64> <- uninit

    block entry()
        budget.store(grant)
        set_val : SortedSet<S64> = .construct(alloc)
        set.store(set_val)
        jump fill(0)

    block fill(i: S64)
        added : Result<Bool, AllocFailed> = set.add_result(i)
        when added
            .Success -> fill(i.add(1))
            .Failure -> failed(i)

    block failed(count: S64)
        Out.write("SortedSet, budget {grant}: {count} keys, intact {is_sorted_set_intact(set, count)}")
        budget.store(3)
        added : Bool = set.add(count)
        Out.write(", then add: {added}, intact {is_sorted_set_intact(set, count.add(1))}\n")
        set.destruct()
        return()

routine is_sorted_list_intact(list: @SortedList<S64>, count: S64) -> Bool
    block entry()
        size : USize = list.count()
        held : S64   = size.to<S64>()
        same : Bool  = held.eq(count)
        branch same
            ? check(0)
            : return(false)

    block check(i: S64)
        done : Bool = i.ge(count)
        branch done
            ? return(true)
            : continue
        value    : S64   = list.getitem(i.to<USize>())
        position : USize = list.rank(i)
        rank     : S64   = position.to<S64>()
        right    : Bool  = value.eq(i).bitand(rank.eq(i))
        branch right
            ? check(i.add(1))
            : return(false)

routine sorted_list_case(budget: @USize, grant: USize, alloc: @Allocator) -> Void
    shared list : @SortedList<S64> <- uninit

    block entry()
        budget.store(grant)
        list_val : SortedList<S64> = .construct(alloc)
        list.store(list_val)
        jump fill(0)

    block fill(i: S64)
        pushed : Result<Unit, AllocFailed> = list.push_result(i)
        when pushed
            .Success -> fill(i.add(1))
            .Failure -> failed(i)

    block failed(count: S64)
        Out.write("SortedList, budget {grant}: {count} elements, intact {is_sorted_list_intact(list, count)}")
        budget.store(3)
        list.push(count)
        Out.write(", then push: intact {is_sorted_list_intact(list, count.add(1))}\n")
        list.destruct()
        return()

// -- the _checked forms -----------------------------------------------------------------------------------------------

routine checked_forms(budget: @USize, alloc: @Allocator) -> Void
    block entry()
        budget.store(100)
        list_val : List<S64> = .construct(alloc)
        claim list : @List<S64> <- list_val
        Out.write("List: pop_checked {list.pop_checked()}")
        list.push(7)
        Out.write(", get_checked(0) {list.getitem_checked(0)}, get_checked(1) {list.getitem_checked(1)}")
        Out.write(", pop_checked {list.pop_checked()}\n")
        list.destruct()

        deque_val : CircularList<S64> = .construct(alloc)
        claim deque : @CircularList<S64> <- deque_val
        Out.write("CircularList: pop_front_checked {deque.pop_front_checked()}")
        Out.write(", pop_back_checked {deque.pop_back_checked()}")
        deque.push_back(1)
        deque.push_back(2)
        Out.write(", get_checked(1) {deque.getitem_checked(1)}, get_checked(2) {deque.getitem_checked(2)}")
        Out.write(", pop_front_checked {deque.pop_front_checked()}, pop_checked {deque.pop_checked()}\n")
        deque.destruct()

        queue_val : PriorityQueue<S64, S64> = .construct(alloc)
        claim queue : @PriorityQueue<S64, S64> <- queue_val
        Out.write("PriorityQueue: peek_checked {queue.peek_checked()}, pop_checked {queue.pop_checked()}")
        queue.push(5, 5)
        queue.push(3, 3)
        Out.write(", peek_checked {queue.peek_checked()}, pop_checked {queue.pop_checked()}\n")
        queue.destruct()

        map_val : Dict<S64, S64> = .construct(alloc)
        claim map : @Dict<S64, S64> <- map_val
        Out.write("Dict: get_checked(1) {map.getitem_checked(1)}")
        map.put(1, 10)
        Out.write(", after put {map.getitem_checked(1)}, get_checked(2) {map.getitem_checked(2)}\n")
        map.destruct()

        claim sorted : @SortedDict<S64, S64> <- .construct(alloc)
        Out.write("SortedDict: get_checked(1) {sorted.getitem_checked(1)}")
        sorted.put(1, 10)
        Out.write(", after put {sorted.getitem_checked(1)}, get_checked(2) {sorted.getitem_checked(2)}\n")
        sorted.destruct()

        claim ordered : @SortedList<S64> <- .construct(alloc)
        Out.write("SortedList: get_checked(0) {ordered.getitem_checked(0)}")
        ordered.push(4)
        Out.write(", after push {ordered.getitem_checked(0)}\n")
        ordered.destruct()
        return()

routine start() -> Void
    shared budget   : @USize     <- 0
    shared budgeted : Allocator  = Allocator { alloc_fn: budget_alloc.to<Callable>(),
        realloc_fn: budget_realloc.to<Callable>(), free_fn: budget_free.to<Callable>(),
        state: budget }
    shared alloc    : @Allocator <- budgeted

    block entry()
        jump sequences(0)

    block sequences(grant: USize)
        done : Bool = grant.gt(2)
        branch done
            ? hashes(0)
            : continue
        list_case(budget, grant, alloc)
        circular_case(budget, grant, alloc)
        queue_case(budget, grant, alloc)
        jump sequences(grant.add(1))

    // Dict rehashes into 5 arrays and Set into 4, so the budgets stop partway through a rehash too.
    block hashes(grant: USize)
        done : Bool = grant.gt(12)
        branch done
            ? trees(0)
            : continue
        dict_case(budget, grant, alloc)
        set_case(budget, grant, alloc)
        jump hashes(grant.add(1))

    // Ascending keys fill a root leaf (1 node), split it (2 more), add leaves until the root is full (6 more), then
    // split the root again (2) above one more leaf split: budgets up to 12 fail at each of those steps.
    block trees(grant: USize)
        done : Bool = grant.gt(12)
        branch done
            ? checked()
            : continue
        sorted_dict_case(budget, grant, alloc)
        sorted_set_case(budget, grant, alloc)
        sorted_list_case(budget, grant, alloc)
        jump trees(grant.add(1))

    block checked()
        checked_forms(budget, alloc)
        return()
