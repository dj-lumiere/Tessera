# A search tree whose children are fields Tree?, each from HEAP, ended children first.
import Hosted

### A search tree of values.
entity Tree
    value: S64
    left: Tree?
    right: Tree?

### A tree of one value.
### :param value: The value.
### :returns: The tree.
common routine Tree.construct(value: S64) -> Me
    return Me(value, left: None(), right: None())

### Ends the children, then says which node ends.
routine @Tree.destruct() -> None
    drop me.right
    drop me.left
    Console.show("end {me.value.peek()}")
    return

### Puts a value where it goes.
### :param value: The value.
routine @Tree.insert(value: S64) -> None
    if value < me.value.peek()
        when me.left
            is Tree as left => left.insert(value)
            is None =>
                me.left <- Tree.construct(value) from HEAP
    else
        when me.right
            is Tree as right => right.insert(value)
            is None =>
                me.right <- Tree.construct(value) from HEAP
    return

### Shows the values in order.
routine @Tree.show_in_order() -> None
    when me.left
        is Tree as left => left.show_in_order()
        is None => nothing
    Console.show("{me.value.peek()}")
    when me.right
        is Tree as right => right.show_in_order()
        is None => nothing
    return

### The number of levels.
### :returns: The depth.
routine @Tree.depth() -> S64
    left: S64 = when me.left
        is Tree as l => l.depth()
        is None => 0
    right: S64 = when me.right
        is Tree as r => r.depth()
        is None => 0
    return left.max(right) + 1

routine start() -> None
    root: &Tree <- Tree.construct(5)
    root.insert(3)
    root.insert(8)
    root.insert(1)
    root.insert(4)
    root.insert(9)
    root.show_in_order()
    Console.show("depth {root.depth()}")
    return
