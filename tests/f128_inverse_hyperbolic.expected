asinh(nan) = NaN 7fff8000000000000000000000000000
asinh(snan) = NaN 7fff8000000000000000000000000001
acosh(1) = 0.0 0
acosh(+inf) = inf 7fff0000000000000000000000000000
acosh(-inf) = NaN 7fff8000000000000000000000000000
