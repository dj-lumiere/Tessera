// S32.MIN.abs() crashes with IntegerOverflowError at the caller's line: abs is #track_caller like the rest of the
// integer routines that crash on their caller's input (div_euclid, mod_euclid, div_ceil, next_multiple_of too).

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

/// Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
/// :param name: The crash kind.
/// :param message: The crash message.
/// :param place: Where the crash was raised.
#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        file : Bytes = place.file.load()
        here : Bool  = file.has_suffix("abs_min_crash.tess")
        Out.write("crashed: {name} at this file {here}, line {place.line.load()}\n")
        exit(3)

routine main() -> S32
    shared min : S32 = S32.MIN

    block entry()
        Out.write("{S32.abs(-5)}\n")
        a : S32 = min.abs()
        Out.write("not reached {a}\n")
        return(0)
