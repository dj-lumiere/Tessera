// Set<S64> against a model. An LCG drives random add / remove / contains in three phases (few keys, many keys to
// force rehashing, then a small key range on the large set). Every 500 operations a checkpoint prints the length, a
// running checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
// The expected output is generated by scripts/gen_collection_sets.py.

import Standard::Alloc
import Standard::Collections
import Standard::Format

record Rng
    state : U64

routine Rng.below(%self: Ptr<Self>, %bound: U64) -> U64
    block entry():
        %state : U64 = %self.state.load()
        %next  : U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        %self.state.store(%next)
        %value : U64 = %next.shr(33).rem(%bound)
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed : S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(%out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write(%out, " {%label} {%value}")
        return()

// Folds every element in iteration order.
routine iteration_hash(%set: Ptr<Set<S64>>) -> S64
    block entry():
        %iter_val : SetIter<S64> = .construct(%set)
        claim %iter : Ptr<SetIter<S64>>
        %iter.store(%iter_val)
        jump next(%iter, 0)

    block next(%iter: Ptr<SetIter<S64>>, %hash: S64):
        %item : Option<S64> = %iter.next()
        when %item:
            .Present(%key) -> next(%iter, mix(%hash, %key))
            .Absent        -> return(%hash)

routine checkpoint(%out: Ptr<BufWriter<FdWriter>>, %set: Ptr<Set<S64>>, %phase: U64, %op: U64,
        %results: S64) -> Void
    block entry():
        write(%out, "phase {%phase}")
        labeled(%out, "op", %op.to_s64())
        labeled(%out, "length", %set.length().to_s64())
        labeled(%out, "results", %results)
        labeled(%out, "iteration", iteration_hash(%set))
        write(%out, "\n")
        return()

// Runs ops random operations on keys below keys. Returns the updated results checksum.
routine run_phase(%out: Ptr<BufWriter<FdWriter>>, %set: Ptr<Set<S64>>, %rng: Ptr<Rng>, %phase: U64,
        %ops: U64, %keys: U64, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: U64, %results: S64):
        %done : Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: U64, %results: S64):
        %key       : S64  = %rng.below(%keys).to_s64()
        %kind      : U64  = %rng.below(10)
        %is_add    : Bool = %kind.lt(5)
        %is_remove : Bool = %kind.lt(7)
        when:
            %is_add    -> add(%op, %results, %key)
            %is_remove -> remove(%op, %results, %key)
            else       -> lookup(%op, %results, %key)

    block add(%op: U64, %results: S64, %key: S64):
        %added : Bool = %set.add(%key)
        jump record(%op, %results, %added.to_s64())

    block remove(%op: U64, %results: S64, %key: S64):
        %removed : Bool = %set.remove(%key)
        jump record(%op, %results, %removed.to_s64())

    block lookup(%op: U64, %results: S64, %key: S64):
        %found : Bool = %set.contains(%key)
        jump record(%op, %results, %found.to_s64())

    block record(%op: U64, %results: S64, %result: S64):
        %mixed   : S64  = mix(%results, %result)
        %op_next : U64  = %op.add(1)
        %report  : Bool = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: U64, %results: S64):
        checkpoint(%out, %set, %phase, %op, %results)
        jump next(%op, %results)

// Copies from into to in iteration order, but starting from its second half, so the two sets hold the same elements
// in a different insertion order.
routine copy_rotated(%from: Ptr<Set<S64>>, %to: Ptr<Set<S64>>) -> Void
    block entry():
        %half : U64 = %from.length().div(2)
        jump pass(0, %half, true)

    block pass(%pass: U64, %half: U64, %second: Bool):
        %done     : Bool         = %pass.eq(2)
        %iter_val : SetIter<S64> = .construct(%from)
        claim %iter : Ptr<SetIter<S64>>
        %iter.store(%iter_val)
        branch %done ? return() : next(%pass, %half, %second, %iter, 0)

    block next(%pass: U64, %half: U64, %second: Bool, %iter: Ptr<SetIter<S64>>, %index: U64):
        %item : Option<S64> = %iter.next()
        when %item:
            .Present(%key) -> consider(%pass, %half, %second, %iter, %index, %key)
            .Absent        -> pass(%pass.add(1), %half, %second.bitnot())

    block consider(%pass: U64, %half: U64, %second: Bool, %iter: Ptr<SetIter<S64>>, %index: U64,
            %key: S64):
        %in_second : Bool = %index.ge(%half)
        %wanted    : Bool = %in_second.eq(%second)
        branch %wanted
            ? copy(%pass, %half, %second, %iter, %index, %key)
            : next(%pass, %half, %second, %iter, %index.add(1))

    block copy(%pass: U64, %half: U64, %second: Bool, %iter: Ptr<SetIter<S64>>, %index: U64,
            %key: S64):
        %to.add(%key)
        jump next(%pass, %half, %second, %iter, %index.add(1))

routine report_eq(%out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write(%out, "{%label} {%equal}\n")
        return()

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim %fd : Ptr<FdWriter>
        %fd.store(%fd_val)
        claim %out : Ptr<BufWriter<FdWriter>>
        %out.construct(%fd)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %rng_val : Rng = Rng { state: 1 }
        claim %rng : Ptr<Rng>
        %rng.store(%rng_val)
        %set_val : Set<S64> = .construct(%alloc)
        claim %set : Ptr<Set<S64>>
        %set.store(%set_val)

        %r1 : S64 = run_phase(%out, %set, %rng, 1, 3000, 64, 0)
        %r2 : S64 = run_phase(%out, %set, %rng, 2, 8000, 5000, %r1)
        %r3 : S64 = run_phase(%out, %set, %rng, 3, 4000, 300, %r2)

        %copied_val : Set<S64> = .construct(%alloc)
        claim %copied : Ptr<Set<S64>>
        %copied.store(%copied_val)
        report_eq(%out, "empty copy equal", %set.eq(%copied))
        copy_rotated(%set, %copied)
        report_eq(%out, "rotated copy equal", %set.eq(%copied))
        report_eq(%out, "rotated copy same order", iteration_hash(%set).eq(iteration_hash(%copied)))
        %copied.add(-1)
        report_eq(%out, "extra element equal", %set.eq(%copied))
        %copied.remove(-1)
        report_eq(%out, "extra element removed equal", %set.eq(%copied))
        %iter_val : SetIter<S64> = .construct(%set)
        claim %iter : Ptr<SetIter<S64>>
        %iter.store(%iter_val)
        %first : S64 = %iter.next().unwrap()
        %copied.remove(%first)
        report_eq(%out, "missing element equal", %set.eq(%copied))
        report_eq(%out, "missing element equal reversed", %copied.eq(%set))
        %copied.add(%first)
        report_eq(%out, "re-added element equal", %set.eq(%copied))
        report_eq(%out, "re-added element same order",
                iteration_hash(%set).eq(iteration_hash(%copied)))
        %copied.destruct()
        %set.destruct()
        report_eq(%out, "freed is empty", %set.is_empty())
        %out.flush()
        return(0)
