// Set<S64> against a model. An LCG drives random add / remove / has in three phases (few keys, many keys to
// force rehashing, then a small key range on the large set). Every 500 operations a checkpoint prints the length, a
// running checksum of every result, and a hash of the iteration sequence, so insertion order is checked too. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

/// What every phase works with besides the collection.
record Harness
    /// Where checkpoints are written.
    out : @BufWriter<Out>
    /// The generator that picks each operation.
    rng : @Rng

/// One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    /// The phase's number, as checkpoints print it.
    number : USize
    /// How many operations the phase runs.
    ops : USize
    /// How many distinct keys the operations draw from.
    keys : USize

/// Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    /// The phase's number.
    phase : USize
    /// The operations run so far in the phase.
    op : USize
    /// The checksum of every result so far.
    results : S64

routine Rng.below(me: @Me, bound: USize) -> USize
    block entry()
        state : U64 = me.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        me.state.store(next)
        bucket : U64   = next.shr(33).mod(bound.to<U64>())
        value  : USize = bucket.to<USize>()
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry()
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<T>(out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer<T>
    block entry()
        out.write(" {label} {value}")
        return()

// Folds every element in iteration order.
routine iteration_hash(set: @Set<S64>) -> S64
    shared iter_val : SetIter<S64>  = .construct(set)
    shared iter     : @SetIter<S64> <- iter_val

    block entry()
        jump next(0)

    block next(hash: S64)
        item : Option<S64> = iter.next()
        when item
            .Present(key) -> next(mix(hash, key))
            .Absent       -> return(hash)

routine checkpoint(out: @BufWriter<Out>, set: @Set<S64>, at: Checkpoint) -> Void
    block entry()
        out.write("phase {at.phase}")
        labeled(out, "op", at.op.to<S64>())
        size : USize = set.count()
        labeled(out, "length", size.to<S64>())
        labeled(out, "results", at.results)
        labeled(out, "iteration", iteration_hash(set))
        out.write("\n")
        return()

// Runs ops random operations on keys below keys. Returns the updated results checksum.
routine run_phase(harness: Harness, set: @Set<S64>, phase: Phase, results: S64) -> S64
    shared rng  : @Rng  = harness.rng
    shared ops  : USize = phase.ops
    shared keys : USize = phase.keys

    block entry()
        jump next(0, results)

    block next(op: USize, checksum: S64)
        done : Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        key       : S64   = rng.below(keys).to<S64>()
        kind      : USize = rng.below(10)
        is_add    : Bool  = kind.lt(5)
        is_remove : Bool  = kind.lt(7)
        when
            is_add    -> add(op, checksum, key)
            is_remove -> remove(op, checksum, key)
            else      -> lookup(op, checksum, key)

    block add(op: USize, checksum: S64, key: S64)
        added : Bool = set.add(key)
        jump record(op, checksum, added.to<S64>())

    block remove(op: USize, checksum: S64, key: S64)
        removed : Bool = set.remove(key)
        jump record(op, checksum, removed.to<S64>())

    block lookup(op: USize, checksum: S64, key: S64)
        found : Bool = set.has(key)
        jump record(op, checksum, found.to<S64>())

    block record(op: USize, checksum: S64, result: S64)
        mixed   : S64   = mix(checksum, result)
        op_next : USize = op.add(1)
        report  : Bool  = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(harness.out, set, Checkpoint { phase: phase.number, op: op, results: checksum })
        jump next(op, checksum)

// Copies from into to in iteration order, but starting from its second half, so the two sets hold the same elements
// in a different insertion order.
routine copy_rotated(from: @Set<S64>, to: @Set<S64>) -> Void
    shared size : USize         = from.count()
    shared half : USize         = size.div(2)
    shared iter : @SetIter<S64> <- uninit

    block entry()
        jump pass(0, true)

    block pass(pass: USize, second: Bool)
        done     : Bool         = pass.eq(2)
        iter_val : SetIter<S64> = .construct(from)
        iter.store(iter_val)
        branch done
            ? return()
            : next(pass, second, 0)

    block next(pass: USize, second: Bool, index: USize)
        item : Option<S64> = iter.next()
        when item
            .Present(key) -> continue
            .Absent       -> pass(pass.add(1), second.bitnot())
        in_second : Bool = index.ge(half)
        wanted    : Bool = in_second.eq(second)
        branch wanted
            ? continue
            : next(pass, second, index.add(1))
        to.add(key)
        jump next(pass, second, index.add(1))

routine report_eq(out: @BufWriter<Out>, label: Bytes, equal: Bool) -> Void
    block entry()
        out.write("{label} {equal}\n")
        return()

routine start() -> Void
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc : @Allocator <- make_heap_allocator()
        claim rng   : @Rng       <- Rng { state: 1 }
        claim set   : @Set<S64>  <- .construct(alloc)

        harness : Harness = Harness { out: out, rng: rng }
        r1      : S64     = run_phase(harness, set, Phase { number: 1, ops: 3000, keys: 64 }, 0)
        r2      : S64     = run_phase(harness, set, Phase { number: 2, ops: 8000, keys: 5000 }, r1)
        r3      : S64     = run_phase(harness, set, Phase { number: 3, ops: 4000, keys: 300 }, r2)

        claim copied : @Set<S64> <- .construct(alloc)
        report_eq(out, "empty copy equal", set.load().eq(copied.load()))
        copy_rotated(set, copied)
        report_eq(out, "rotated copy equal", set.load().eq(copied.load()))
        report_eq(out, "rotated copy same order", iteration_hash(set).eq(iteration_hash(copied)))
        copied.add(-1)
        report_eq(out, "extra element equal", set.load().eq(copied.load()))
        copied.remove(-1)
        report_eq(out, "extra element removed equal", set.load().eq(copied.load()))
        iter_val : SetIter<S64> = .construct(set)
        claim iter : @SetIter<S64> <- iter_val
        first : S64 = iter.next().unwrap()
        copied.remove(first)
        report_eq(out, "missing element equal", set.load().eq(copied.load()))
        report_eq(out, "missing element equal reversed", copied.load().eq(set.load()))
        copied.add(first)
        report_eq(out, "re-added element equal", set.load().eq(copied.load()))
        report_eq(out, "re-added element same order",
            iteration_hash(set).eq(iteration_hash(copied)))
        copied.destruct()
        set.destruct()
        report_eq(out, "freed is empty", set.is_empty())
        out.flush()
        return()
