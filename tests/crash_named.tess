// A program's own crash names its kind and says what happened. The handler gets the name, the message, and the place
// of the call (crash is #track_caller). This one prints all three and exits with status 3.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        file : Bytes = place.file.load()
        here : Bool  = file.has_suffix("crash_named.tess")
        Out.write("{name}: {message}\nat {place.line.load()}:{place.column.load()}, this file {here}\n")
        exit(3)

routine start() -> Void
    block entry()
        Out.write("before\n")
        crash("ConfigurationError", "The configuration file is missing.")
