// A program's own crash names its kind and says what happened. The handler gets the name, the message, and the place
// of the call (crash is #track_caller). This one prints all three and exits with status 3.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> Void

@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    file: Span[Byte] = place.file.peek()
    here: Bool = file.has_suffix("crash_named.tess")
    Out.write("{name}: {message}\nat {place.line.peek()}:{place.column.peek()}, this file {here}\n")
    exit(3)

routine start() -> Void
    Out.write("before\n")
    crash(name: "ConfigurationError", message: "The configuration file is missing.")
