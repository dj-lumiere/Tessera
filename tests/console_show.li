# Console.show writes a line to standard output and Console.alert one to standard error (which the expected output
# leaves out). end: gives another line end, written as it is: a brace in it is a brace.

import Hosted

### Shows lines with and without their end.
routine start() -> None
    done: U64 = 3
    Console.show("{done} of 4")
    Console.show("loading", end: "")
    Console.show("...", end: " {ok}\n")
    Console.alert("not in the expected output")
    out: @ConsoleOutput = Console.output()
    out.write("through the writer\n")
    return
