# A record and the elements its buffer holds are separate memory: one flow holds exclusive access to a List (its
# count, its capacity, its data pointer) and to its first element at the same time, and the two don't overlap.

import Standard/Collections
import Standard/Os

routine start() -> None
    xs: &List[S64] <- .construct(HEAP)

    xs.add_last(7)
    xs.add_last(8)
    list: Authorized[List[S64]] <- xs.get_exclusive_access()
    first: Authorized[S64] <- xs.getslot(0).get_exclusive_access()
    Console.show("held: {AccessManager.held_count()}")
    first.getview().poke(first.getview().peek() + list.getview().count().to[S64]())
    drop first
    drop list
    Console.show("first: {xs[0]}, held: {AccessManager.held_count()}")
    drop xs
    return
