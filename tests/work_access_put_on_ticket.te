# An access borrowed in the arguments of to[Work] goes back through the work's own retrieve, after start_from: a ticket's
# put_work doesn't give it back.

import Standard/Os

global COUNT: &U64 <- 0

### Adds one.
### :param count: The access to the count.
routine bump(count: Authorized[U64]) -> None
    view: @U64 = count.getview()
    (view.peek() + 1).poke_into(view)
    return

routine start() -> None
    t: Thread[None] <- get_thread[None]()
    work: Work[None] <- bump.to[Work](count: COUNT.get_exclusive_access())

    t.put_work(work)
    drop work
    t.wait_finished()
    drop t
    return
