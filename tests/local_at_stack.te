# A local slot is a block of the running flow's stack, so `from STACK` is the same slot as writing no `from`: it stays
# in its routine and isn't given back.

import Standard/Hosted

record Point
    x: S64
    y: S64

routine start() -> None
    p: &Point <- (x: 1, y: 2) from STACK
    q: &Point <- (x: 3, y: 4)

    Console.show("{p.x.peek() + q.y.peek()}")
    return
