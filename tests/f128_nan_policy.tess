// F128's math functions pass a NaN through quieted, its payload kept, as add and mul do: one-argument functions,
// and atan2, hypot and powf (which used to give the default NaN), the first operand's NaN first. A signaling NaN
// wins over the C99 cases that ignore a quiet one (powf(1, sNaN), powf(sNaN, 0), hypot(inf, sNaN)), and a quiet
// NaN doesn't (powf(1, qNaN) = 1, hypot(inf, qNaN) = inf). The edge results the cleanup touched stay: asin and acos
// at ±1, atan past 2^115, ln at 0, -1 and inf.

import Standard::Format
import Standard::Os

/// Writes `name` and the bits of `v` in hex.
/// :param name: What was computed.
/// :param v: The result.
routine show(name: Bytes, v: F128) -> Void
    block entry()
        Out.write("{name}: ")
        v.bits().represent_hex_into(Out.writer())
        Out.write("\n")
        return()

routine main() -> S32
    shared q    : F128 = F128.from_bits(0x7FFF8000000000000000000000001234)
    shared s    : F128 = F128.from_bits(0x7FFF0000000000000000000000005678)
    shared one  : F128 = F128.from_bits(0x3FFF0000000000000000000000000000)
    shared zero : F128 = F128.from_bits(0)
    shared inf  : F128 = F128.INFINITY
    shared huge : F128 = F128.from_bits(0xC0800000000000000000000000000000)

    block entry()
        show("ln q", q.ln())
        show("ln s", s.ln())
        show("atan s", s.atan())
        show("asin q", q.asin())
        show("acos s", s.acos())
        show("exp_m1 s", s.exp_m1())
        show("atan2 q,1", q.atan2(one))
        show("atan2 1,s", one.atan2(s))
        show("atan2 s,q", s.atan2(q))
        show("hypot q,1", q.hypot(one))
        show("hypot 1,q", one.hypot(q))
        show("hypot q,s", q.hypot(s))
        show("hypot inf,q", inf.hypot(q))
        show("hypot inf,s", inf.hypot(s))
        show("powf q,1", q.powf(one))
        show("powf 1,q", one.powf(q))
        show("powf q,0", q.powf(zero))
        show("powf 1,s", one.powf(s))
        show("powf s,0", s.powf(zero))
        show("powf q,s", q.powf(s))
        show("asin 1", one.asin())
        show("asin -1", one.neg().asin())
        show("acos 1", one.acos())
        show("acos -1", one.neg().acos())
        show("atan -2^129", huge.atan())
        show("atan inf", inf.atan())
        show("ln 0", zero.ln())
        show("ln -1", one.neg().ln())
        show("ln inf", inf.ln())
        show("ln 1", one.ln())
        return(0)
