# A top-level line right after a variant's or a choice's member lines starts the script's code: the member lines are
# indented, so a line at column 1 ends them.

import Standard/Hosted

### A reading as a whole number or a float.
variant Reading
    S64
    B64

r: Reading = 5
when r
    is S64 as n => Console.show("whole {n}")
    is B64 as x => Console.show("float {x}")

### A direction.
choice Dir: U8
    UP
    DOWN

d: Dir = Dir.DOWN
Console.show("{d}")
