# B128 takes a hex float exactly: its 113-bit significand, its subnormals, in a binding and in a preset.
import Standard/Format
import Standard/Os

preset HALF: B128 = 0x1p-1

### Writes v's bits in hex on a line.
routine show(out: @ConsoleOutput, v: B128) -> None
    v.bits().represent_hex_into(out)
    out.write("\n")
    return

routine start() -> None
    a: B128 = 0x1p-25
    b: B128 = 0x1.ffffffffffffffffffffffffffffp0
    c: B128 = -0x1.8p3
    tiny: B128 = 0x1p-16494
    sum: B128 = a + HALF
    out: @ConsoleOutput = Console.output()
    show(out, v: a)
    show(out, v: b)
    show(out, v: c)
    show(out, v: tiny)
    show(out, v: sum)
    show(out, v: HALF)
    return
