# Membership: has / lacks for an element or a piece of text, has_key / lacks_key for a dict's key.

import Standard/Collections
import Standard/Hosted

### Prints each membership test.
routine start() -> None
    s: &Set[S64] <- .construct(HEAP)
    d: &Dict[S64, S64] <- .construct(HEAP)

    s.add(1)
    d[2] = 3
    t: @[Byte] = "hello"
    needle: @[Byte] = "ell"
    Console.show("{s.has(1)} {s.lacks(1)} {s.lacks(5)} {d.has_key(2)} {d.lacks_key(2)} {t.has(needle)} {t.lacks(needle)}")
    drop s
    drop d
    return
