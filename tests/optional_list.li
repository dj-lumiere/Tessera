# A List[Counter?] keeps each element as a place from a manager, hollow for None: observed with when, ended by the list.
import Collections
import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### Says which counter ends.
routine @Counter.destruct() -> None
    Console.show("end {me.n.peek()}")
    return

routine start() -> None
    xs: &List[Counter?] <- .construct(HEAP)
    one: &Counter <- Counter.construct(n: 1) from HEAP
    xs.add_last(steal one)
    xs.add_last(None())
    two: &Counter <- Counter.construct(n: 2) from HEAP
    xs.add_last(steal two)
    for i in 0 til xs.count()
        when xs.getslot(i)
            is Counter as c => Console.show("{i}: {c.n.peek()}")
            is None => Console.show("{i}: none")
    return
