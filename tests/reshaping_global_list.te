# A global's place never ends, but what it holds may move: a view of a global list's elements ends at a #reshaping
# call on it.

import Collections
import Hosted

lateinit global NUMBERS: &List[S64]

routine start() -> None
    NUMBERS.poke(List[S64].construct(manager: HEAP))
    NUMBERS.add_last(5)
    s: @[S64] = NUMBERS.getview()
    NUMBERS.add_last(6)
    Console.show(s.getslot(0).peek())
    return
