// Parentheses around one value group nothing in a language without operators: (x) is x. fmt drops them from code,
// so this test keeps them inside template holes, which fmt leaves alone.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        x : S64 = 4
        Out.write("{(x).add((1))} {((x.mul(2)))}\n")
        return(0)
