# A ticket is given back with drop, which hands its thread back to its manager. A ticket whose work still runs can't
# go back: the drop crashes with TicketBusyError.

import Standard/Hosted

### Waits a while, then gives 1.
### :returns: 1.
routine slow() -> U64
    waitfor(200ms)
    return 1

routine start() -> None
    t: Thread[U64] <- get_thread[U64]()
    work: Work[U64] = slow.to[Work]()

    t.put_work(work)
    drop t
    return
