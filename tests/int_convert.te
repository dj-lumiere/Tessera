# text.to[T]() reads a decimal integer: a sign, then digits. Each type's ends read, one past them throws
# OutOfRangeError, and empty text, a lone sign, and other characters fail. check receives the failure.

import Standard/Os

routine s32(text: @[Byte]) -> None
    r: Check[S32] = check text.to[S32]()
    when r
        is S32 as v =>
            Console.show("S32 \"{text}\": {v}")
            return
        is Crashables as error =>
            Console.show("S32 \"{text}\": {error.name()}")
            return

routine s8(text: @[Byte]) -> None
    r: Check[S8] = check text.to[S8]()
    when r
        is S8 as v =>
            Console.show("S8 \"{text}\": {v}")
            return
        is Crashables as error =>
            Console.show("S8 \"{text}\": {error.name()}")
            return

routine u32(text: @[Byte]) -> None
    r: Check[U32] = check text.to[U32]()
    when r
        is U32 as v =>
            Console.show("U32 \"{text}\": {v}")
            return
        is Crashables as error =>
            Console.show("U32 \"{text}\": {error.name()}")
            return

routine start() -> None
    s32("42")
    s32("-42")
    s32("+7")
    s32("2147483647")
    s32("-2147483648")
    s32("2147483648")
    s32("-2147483649")
    s32("")
    s32("-")
    s32("12a")
    s32(" 1")
    s8("-128")
    s8("127")
    s8("128")
    u32("4294967295")
    u32("4294967296")
    u32("-0")
    u32("-1")
    max_text: @[Byte] = "115792089237316195423570985008687907853269984665640564039457584007913129639935"
    big: U256 = max_text.to[U256]()
    Console.show("U256 max: {big}")
    over_text: @[Byte] = "115792089237316195423570985008687907853269984665640564039457584007913129639936"
    when check over_text.to[U256]()
        is U256 => Console.show("U256 max + 1: read")
        is Crashables as error => Console.show("U256 max + 1: {error.name()}")
    least_text: @[Byte] = "-57896044618658097711785492504343953926634992332820282019728792003956564819968"
    least: S256 = least_text.to[S256]()
    Console.show("S256 min: {least}")
    count_text: @[Byte] = "123"
    n: CSize = count_text.to[CSize]()
    Console.show("CSize: {n}")
    return
