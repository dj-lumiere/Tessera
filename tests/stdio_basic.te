# Standard/Os console streams. Out: bytes written as they are (here to a pipe, so no "\r\n" added and the UTF-8
# unchanged), a character split across two writes too, and a pipe isn't a terminal. In, fed stdio_basic.input
# through one shared buffer: lines (a "\r\n" one, and a last one with no "\n"), words, a count of bytes, the rest.
# Each comes back as a Memory[Byte] from its allocator, dropped when done. At the end of the input the
# _checked forms return None.

import Standard/Alloc
import Standard/Format
import Standard/Os

### Writes the text and gives it back.
routine show(what: @[Byte], text: Memory[Byte]) -> None
    Out.write("{what}: [{text.getview()}]\n")
    drop text
    return

### Writes the text if there is some, else says there's none.
routine show_checked(what: @[Byte], text: Maybe[Memory[Byte]]) -> None
    when steal text
        is Memory[Byte] as t =>
            show(what, text: steal t)
            return
        is None =>
            Out.write("{what}: none\n")
            return

routine start() -> None
    text: @[Byte] = "standard output: 한글\n"
    Out.write_all_result(data: text.data, count: text.count())
    han: @[Byte] = "한"
    Out.write_all_result(data: han.data, count: 1)
    Out.write_all_result(data: han.data.stride(1), count: 2)
    Out.write("\n")
    Out.write("output is a terminal: {Out.is_terminal()}, input: {In.is_terminal()}\n")
    local alloc: @MemoryManager <- make_heap_memory()
    show(what: "line", text: In.read_line(alloc))
    show(what: "line", text: In.read_line())
    show(what: "word", text: In.read_word(alloc))
    show(what: "word", text: In.read_word())
    show(what: "count 3", text: In.read_count(3))
    show(what: "line", text: In.read_line(alloc))
    show(what: "all", text: In.read_all())
    show_checked(what: "line at the end", text: In.read_line_checked(alloc))
    show_checked(what: "word at the end", text: In.read_word_checked(alloc))
    show_checked(what: "line at the end, default heap", text: In.read_line_checked())
    show_checked(what: "word at the end, default heap", text: In.read_word_checked())
    return
