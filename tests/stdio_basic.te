# Standard/Os console streams. Out: bytes written as they are (here to a pipe, so no "\r\n" added and the UTF-8
# unchanged), a character split across two writes too, and a pipe isn't a terminal. In, fed stdio_basic.input
# through one shared buffer: lines (a "\r\n" one, and a last one with no "\n"), words, a count of bytes, the rest.
# Each comes back as a BorrowedSlice[Byte] from its memory manager, dropped when done. At the end of the input `try` in front of
# the call gives None.

import Standard/Os

### Writes the text and gives it back.
routine show(what: @[Byte], text: BorrowedSlice[Byte]) -> None
    Console.show("{what}: [{text.getslice()}]")
    drop text
    return

### Writes the text if there is some, else says there's none.
routine show_checked(what: @[Byte], text: Maybe[BorrowedSlice[Byte]]) -> None
    when steal text
        is BorrowedSlice[Byte] as t =>
            show(what, text: steal t)
            return
        is None =>
            Console.show("{what}: none")
            return

routine start() -> None
    text: @[Byte] = "standard output: 한글\n"
    Console.output().write_all(data: text.data, count: text.count())
    han: @[Byte] = "한"
    Console.output().write_all(data: han.data, count: 1)
    Console.output().write_all(data: han.data.stride(1), count: 2)
    Console.show("")
    Console.show("output is a terminal: {Console.output().is_terminal()}, input: {Console.input().is_terminal()}")
    manager: @MemoryManager = HEAP
    show(what: "line", text: Console.ask_line(manager))
    show(what: "line", text: Console.ask_line())
    show(what: "word", text: Console.ask_word(manager))
    show(what: "word", text: Console.ask_word())
    show(what: "count 3", text: Console.ask_bytes(3))
    show(what: "line", text: Console.ask_line(manager))
    show(what: "all", text: Console.ask_all())
    show_checked(what: "line at the end", text: try Console.ask_line(manager))
    show_checked(what: "word at the end", text: try Console.ask_word(manager))
    show_checked(what: "line at the end, default heap", text: try Console.ask_line())
    show_checked(what: "word at the end, default heap", text: try Console.ask_word())
    return
