# U128 division by zero crashes with DivisionByZeroError, on 64-bit and 32-bit targets alike (div128_edges.te
# has the results that don't crash).

import Standard/Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash on stdout, where the golden test sees it, and exits with status 3.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("crashed: {name}: {message.text()}")
    exit(3)

routine start() -> None
    Crash.report_with(on_crash.to[Callable]())
    big: U128 = 0xFFFFFFFF000000000000000000000001
    zero: U128 = 0
    Console.show("before")
    q: U128 = big // zero
    Console.show("not reached {q}")
    return
