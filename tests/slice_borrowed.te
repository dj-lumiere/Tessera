# A Span[T] is a view and releases nothing: a string literal, getview(), getslice, a sub-text. A Memory[T] from a
# manager goes back on drop, once. A counting manager shows every block.

import Standard/Alloc
import Standard/Format
import Standard/Os

record Counts
    live: S64

obeys MemoryManageable[Counts]

routine Counts.alloc(me: @Me, size: USize, align: USize) -> Addr
    more: S64 = me.live.peek() + 1
    more.poke_into(me.live)
    return DEFAULT_HEAP.alloc(size, align)

@reshaping(at)
routine Counts.realloc(me: @Me, at: Addr, size: USize, align: USize) -> Addr
    return DEFAULT_HEAP.realloc(at, size, align)

routine Counts.free(me: @Me, at: Addr) -> None
    fewer: S64 = me.live.peek() - 1
    fewer.poke_into(me.live)
    DEFAULT_HEAP.free(at)
    return

routine literal() -> None
    local text: @Span[Byte] <- "a literal"

    drop text
    Out.write("literal after destruct: [{text.peek()}]\n")
    return

routine text(counts: @Counts, alloc: @MemoryManager) -> None
    local joined: @Memory[Byte] <- Span[Byte].concat(a: "Tes", b: "sera", alloc)

    Out.write("concat: [{joined.getview()}], live {counts.live.peek()}\n")
    local view: @Span[Byte] <- joined.getview()
    drop view
    local part: @Span[Byte] <- joined.slice(start: 1, end: 4)
    drop part
    Out.write("views destructed: [{view.peek()}] [{part.peek()}], live {counts.live.peek()}\n")
    drop joined
    Out.write("concat dropped: live {counts.live.peek()}\n")
    return

routine values(counts: @Counts, alloc: @MemoryManager) -> None
    local squares: @Memory[U32] <- .construct(count: 4, manager: alloc)

    squares.store(index: 3, value: 9)
    local view: @Span[U32] <- squares.getview()
    drop view
    local part: @Span[U32] <- squares.getslice(start: 2, count: 2)
    drop part
    Out.write("views destructed: {view.getitem(3)} {part.getitem(1)}, live {counts.live.peek()}\n")
    squares.resize(8)
    Out.write("resized: count {squares.count()}, kept {squares.load(3)}, live {counts.live.peek()}\n")
    drop squares
    Out.write("memory dropped: live {counts.live.peek()}\n")
    return

routine start() -> None
    local counts: @Counts <- (live: 0)
    local alloc: @MemoryManager <- counts.to[MemoryManager]()

    literal()
    text(counts, alloc)
    values(counts, alloc)
    Out.write("in the end: live {counts.live.peek()}\n")
    return
