# A @[T] is a view and releases nothing: a string literal, getview(), getslice, a sub-text. A BorrowedSlice[T] from a
# manager goes back on drop, once. A counting manager shows every block.

import Standard/Hosted

record Counts
    live: S64

obeys MemoryManageable[Counts]

routine @Counts.borrow(size: U64, align: U64) -> Addr
    more: S64 = me.live.peek() + 1
    more.poke_into(me.live)
    return HEAP.borrow(size, align)

@reshaping(at)
routine @Counts.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return HEAP.reborrow(at, size, align)

routine @Counts.give_back(at: Addr) -> None
    fewer: S64 = me.live.peek() - 1
    fewer.poke_into(me.live)
    HEAP.give_back(at)
    return

routine literal() -> None
    text: &@[Byte] <- "a literal"

    drop text
    Console.show("literal after destruct: [{text.load()}]")
    return

routine text(counts: @Counts, manager: @MemoryManager) -> None
    joined: &[Byte] <- @[Byte].concat(a: "Tes", b: "sera", manager)

    Console.show("concat: [{joined.getslice()}], live {counts.live.peek()}")
    view: &@[Byte] <- joined.getslice()
    drop view
    part: &@[Byte] <- joined.slice(start: 1, end: 4)
    drop part
    Console.show("views destructed: [{view.load()}] [{part.load()}], live {counts.live.peek()}")
    drop joined
    Console.show("concat dropped: live {counts.live.peek()}")
    return

routine values(counts: @Counts, manager: @MemoryManager) -> None
    squares: &[U32] <- .construct(count: 4, manager: manager)

    squares.getslot(3).poke(9)
    view: &@[U32] <- squares.getslice()
    drop view
    part: &@[U32] <- squares.getslice(start: 2, count: 2)
    drop part
    Console.show("views destructed: {view.getitem(3)} {part.getitem(1)}, live {counts.live.peek()}")
    squares.resize(8)
    Console.show("resized: count {squares.count()}, kept {squares[3]}, live {counts.live.peek()}")
    drop squares
    Console.show("memory dropped: live {counts.live.peek()}")
    return

routine start() -> None
    counts: &Counts <- (live: 0)
    manager: &MemoryManager <- counts.to[MemoryManager]()

    literal()
    text(counts, manager)
    values(counts, manager)
    Console.show("in the end: live {counts.live.peek()}")
    drop manager
    return
