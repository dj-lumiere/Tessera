# A @[T] is a view and releases nothing: a string literal, getview(), getslice, a sub-text. A Memory[T] from a
# manager goes back on drop, once. A counting manager shows every block.

import Standard/Alloc
import Standard/Format
import Standard/Os

record Counts
    live: S64

obeys MemoryManageable[Counts]

routine @Counts.alloc(size: U64, align: U64) -> Addr
    more: S64 = me.live.peek() + 1
    more.poke_into(me.live)
    return DEFAULT_HEAP.alloc(size, align)

@reshaping(at)
routine @Counts.realloc(at: Addr, size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.realloc(at, size, align)

routine @Counts.free(at: Addr) -> None
    fewer: S64 = me.live.peek() - 1
    fewer.poke_into(me.live)
    DEFAULT_HEAP.free(at)
    return

routine literal() -> None
    local text: @@[Byte] <- "a literal"

    drop text
    Console.show("literal after destruct: [{text.peek()}]")
    return

routine text(counts: @Counts, alloc: @MemoryManager) -> None
    local joined: @Memory[Byte] <- @[Byte].concat(a: "Tes", b: "sera", alloc)

    Console.show("concat: [{joined.getview()}], live {counts.live.peek()}")
    local view: @@[Byte] <- joined.getview()
    drop view
    local part: @@[Byte] <- joined.slice(start: 1, end: 4)
    drop part
    Console.show("views destructed: [{view.peek()}] [{part.peek()}], live {counts.live.peek()}")
    drop joined
    Console.show("concat dropped: live {counts.live.peek()}")
    return

routine values(counts: @Counts, alloc: @MemoryManager) -> None
    local squares: @Memory[U32] <- .construct(count: 4, manager: alloc)

    squares.store(index: 3, value: 9)
    local view: @@[U32] <- squares.getview()
    drop view
    local part: @@[U32] <- squares.getslice(start: 2, count: 2)
    drop part
    Console.show("views destructed: {view.getitem(3)} {part.getitem(1)}, live {counts.live.peek()}")
    squares.resize(8)
    Console.show("resized: count {squares.count()}, kept {squares.load(3)}, live {counts.live.peek()}")
    drop squares
    Console.show("memory dropped: live {counts.live.peek()}")
    return

routine start() -> None
    local counts: @Counts <- (live: 0)
    local alloc: @MemoryManager <- counts.to[MemoryManager]()

    literal()
    text(counts, alloc)
    values(counts, alloc)
    Console.show("in the end: live {counts.live.peek()}")
    return
