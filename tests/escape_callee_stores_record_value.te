# A record value holding a frame slot's address handed to a callee that stores its field.

import Standard/Os

global KEPT: &@S64 <- .hollow()

### Holds an address.
record R
    ### The address.
    held: @S64

### Keeps the field.
### :param r: The record.
routine keep(r: R) -> None
    KEPT.poke(r.held)
    return

### Reads the field.
### :param r: The record.
### :returns: The value.
routine read(r: R) -> S64
    return r.held.peek()

### Runs.
routine start() -> None
    l: &S64 <- 5

    r: R = R(held: l)
    n: S64 = read(r)
    keep(r)
    Console.show("{n}")
    return
