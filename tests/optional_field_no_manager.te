# A field Node? keeps its node in memory from a manager, so the line that fills it names one: a build error.
import Hosted

### A node of a list.
entity Node
    value: S64
    next: Node?

### A node with no next one.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, next: None())

routine start() -> None
    first: &Node <- Node.construct(1)
    first.next <- Node.construct(2)
    return
