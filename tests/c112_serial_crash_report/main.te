# A crash with no reporting routine in the Crash service's slot, on a board whose file names its serial port: the
# default report goes to that port.

import Unhosted

### The element past the end of three.
### :param at: The index asked for.
### :returns: Never.
routine pick(at: U64) -> U64
    values: &Items[U64, 3] <- [1, 2, 3]
    return values[at]

### Readies the managers and leaves the Crash service's slot empty.
routine when_power_on() -> None
    prepare_core()
    return

### Writes a line on the serial port, then crashes.
routine start() -> None
    port: &Pl011 <- .construct(base: 0x09000000)
    port.write("before\n")
    port.write("{pick(at: 5)}\n")
    return
