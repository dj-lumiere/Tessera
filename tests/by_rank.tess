// get_by_rank reads the rank-th element of the sorted collections: a KVPair copy from a SortedDict, the element from
// a SortedSet or SortedList. value_ptr_by_rank changes a SortedDict value in place.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator
        %alloc.store(%heap)

        %map_val : SortedDict<S64, S64> = .construct(%alloc)
        claim %map : @SortedDict<S64, S64>
        %map.store(%map_val)
        %map.put(30, 300)
        %map.put(10, 100)
        %map.put(20, 200)
        %first : KVPair<S64, S64> = %map.load().get_by_rank(0)
        %last  : KVPair<S64, S64> = %map.load().get_by_rank(2)
        print("{%first.key}={%first.value} {%last.key}={%last.value}\n")
        %middle : @S64 = %map.load().value_ptr_by_rank(1)
        %middle.load().add(5).store_into(%middle)
        print("{%map.load().get(20)}\n")

        %set_val : SortedSet<S64> = .construct(%alloc)
        claim %set : @SortedSet<S64>
        %set.store(%set_val)
        %set.add(7)
        %set.add(3)
        %set.add(5)
        print("{%set.load().get_by_rank(0)} {%set.load().get_by_rank(1)} {%set.load().get_by_rank(2)}\n")

        %list_val : SortedList<S64> = .construct(%alloc)
        claim %list : @SortedList<S64>
        %list.store(%list_val)
        %list.push(9)
        %list.push(4)
        print("{%list.load().get_by_rank(0)} {%list.load().get_by_rank(1)}\n")

        %map.destruct()
        %set.destruct()
        %list.destruct()
        return(0)
