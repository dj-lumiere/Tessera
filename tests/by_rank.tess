// get_by_rank reads the rank-th element of the sorted collections: a KVPair copy from a SortedDict, the element from
// a SortedSet or SortedList. value_ptr_by_rank changes a SortedDict value in place.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

routine start() -> Void
    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        claim map : @SortedDict<S64, S64> <- .construct(alloc)
        map.put(30, 300)
        map.put(10, 100)
        map.put(20, 200)
        first : KVPair<S64, S64> = map.get_by_rank(0)
        last  : KVPair<S64, S64> = map.get_by_rank(2)
        Out.write("{first.key}={first.value} {last.key}={last.value}\n")
        middle     : @S64 = map.value_ptr_by_rank(1)
        next_value : S64  = middle.load().add(5)
        next_value.store_into(middle)
        Out.write("{map.getitem(20)}\n")

        claim set : @SortedSet<S64> <- .construct(alloc)
        set.add(7)
        set.add(3)
        set.add(5)
        Out.write("{set.get_by_rank(0)} {set.get_by_rank(1)} {set.get_by_rank(2)}\n")

        claim list : @SortedList<S64> <- .construct(alloc)
        list.push(9)
        list.push(4)
        Out.write("{list.get_by_rank(0)} {list.get_by_rank(1)}\n")

        map.destruct()
        set.destruct()
        list.destruct()
        return()
