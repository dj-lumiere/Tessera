# Swapping entity elements moves each one, never copies it: no element ends during the swap, the same index twice
# leaves its element in place, and the list ends every element exactly once.

import Standard/Collections
import Standard/Os

### A counter that says when it ends.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n)

### Says that it ends.
routine @Counter.destruct() -> None
    Console.show("end {me.n.peek()}")
    return

### Writes the counters in order, read through their places.
### :param counters: The list to write.
routine show(counters: @List[Counter]) -> None
    each i in 0 til counters.count()
        Console.show("{counters.getslot(i).n.peek()} ", end: "")
    Console.show("")
    return

### Swaps counters and writes the list after each swap.
routine start() -> None
    local counters: @List[Counter] <- .construct()

    counters.add_last(Counter.construct(1))
    counters.add_last(Counter.construct(2))
    counters.add_last(Counter.construct(3))
    counters.swap(first: 0, second: 2)
    show(counters)
    counters.swap(first: 0, second: 0)
    show(counters)
    counters.swap(first: 1, second: 0)
    show(counters)
    drop counters
    return
