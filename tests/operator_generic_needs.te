# A generic body has the operators of its constraints only: + on a T needs Addable[T].

routine start() -> None
    a: S64 = total(first: 2, second: 3)
    return

### Adds two values.
### :param first: The first value.
### :param second: The second value.
### :returns: The sum.
routine total[T](first: T, second: T) -> T
needs T: typename
    return first + second
