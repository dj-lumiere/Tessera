# A record with one field is a struct holding that field, as every record is a struct: the field's size and
# alignment, and it passes, stores, and reads like any other record.

import Hosted

record Meters
    value: B64

record Wrapped
    inner: Meters

routine double(m: Meters) -> Meters
    v: B64 = m.value
    r: Meters = Meters(value: v * 2.0)
    return r

routine start() -> None
    m: Meters = Meters(value: 1.5)
    d: Meters = double(m)
    slot: &Wrapped <- .hollow()
    slot.inner.poke(d)
    w: Wrapped = slot.load()
    inner: Meters = w.inner
    same_size: Bool = sizeof[Wrapped]() == sizeof[B64]()
    same_align: Bool = alignof[Meters]() == alignof[B64]()
    three: Bool = inner.value == 3.0
    if same_size and same_align and three
        return
    else
        set_exit_code(1)
        return
