# The view of a run's access is used only while the access is held.

import Standard/Hosted

### Reads through the view of a run's access after giving it back.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3] * 1 from HEAP
    reading: ReadAuthorizedSlice[S64] <- numbers.get_shared_read_access()
    view: @[S64] = reading.getview()
    drop reading
    Console.show("{view[0]}")
    drop numbers
    return
