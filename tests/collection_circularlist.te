# CircularList[S64] against a model. An LCG drives random pushes and pops at both ends, get / set, and a rare clear, in five
# phases: balanced, front-heavy, back-heavy, a queue (push_back / pop_front), and a reversed queue (push_front /
# pop_back). Every 500 operations a checkpoint prints the length, the capacity (a queue must not grow it without
# bound), a running checksum of every result, and a hash of the CircularListIter sequence. Then eq.
# The expected output comes from an independent Python model of the collection.

import Standard/Collections
import Standard/Os

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[ConsoleOutput]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: U64
    ### How many operations the phase runs.
    ops: U64
    ### The percentages of each push and pop.
    op_mix: Mix

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: U64
    ### The operations run so far in the phase.
    op: U64
    ### The checksum of every result so far.
    results: S64

# Percentages of each push and pop. Get and set take 10 each.
record Mix
    push_back: U64
    push_front: U64
    pop_back: U64
    pop_front: U64

routine @Rng.below(bound: U64) -> U64
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: U64 = bucket.to[U64]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: @[Byte], value: S64) -> None
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

# Folds every element front to back.
routine iteration_hash(circular_list: @CircularList[S64]) -> S64
    local iter: @CircularListIter[S64] <- .construct(circular_list)

    loop with hash: S64 = 0
        item: Maybe[S64] = try iter.emit()
        when item
            is S64 as value => continue with hash: mix(hash, value)
            is None => return hash

routine checkpoint(out: @BufWriter[ConsoleOutput], circular_list: @CircularList[S64],
    at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: U64 = circular_list.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(circular_list))
    capacity: U64 = circular_list.storage.count.peek()
    labeled(out, label: "capacity", value: capacity.to[S64]())
    out.write("\n")
    return

# Runs ops random operations weighted by op_mix. Returns the updated results checksum.
@reshaping(circular_list)
routine run_phase(harness: Harness, circular_list: @CircularList[S64], phase: Phase,
    results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: U64 = phase.ops
    local op_mix: Mix = phase.op_mix
    local push_back_end: U64 = op_mix.push_back * 10
    local push_front_end: U64 = push_back_end + op_mix.push_front * 10
    local pop_back_end: U64 = push_front_end + op_mix.pop_back * 10
    local pop_front_end: U64 = pop_back_end + op_mix.pop_front * 10

    until op >= ops with op: U64 = 0, checksum: S64 = results
        kind: U64 = rng.below(1000)
        is_push_back: Bool = kind < push_back_end
        is_push_front: Bool = kind < push_front_end
        is_pop_back: Bool = kind < pop_back_end
        is_pop_front: Bool = kind < pop_front_end
        is_get: Bool = kind < pop_front_end + 100
        is_clear: Bool = kind == 999
        result: S64 = when
            is_push_back =>
                value: S64 = rng.below(1000000).to[S64]()
                circular_list.add_last(value)
                becomes value
            is_push_front =>
                value: S64 = rng.below(1000000).to[S64]()
                circular_list.add_first(value)
                becomes value
            is_pop_back =>
                if circular_list.is_empty()
                    becomes -1
                else
                    becomes circular_list.remove_last()
            is_pop_front =>
                if circular_list.is_empty()
                    becomes -1
                else
                    becomes circular_list.remove_first()
            is_get =>
                if circular_list.is_empty()
                    becomes -2
                else
                    index: U64 = rng.below(circular_list.count())
                    becomes circular_list[index]
            is_clear =>
                circular_list.clear()
                becomes -4
            else =>
                if circular_list.is_empty()
                    becomes -3
                else
                    index: U64 = rng.below(circular_list.count())
                    value: S64 = rng.below(1000000).to[S64]()
                    circular_list[index] = value
                    becomes index.to[S64]()
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: U64 = op + 1
        if op_next % 500 == 0
            checkpoint(out: harness.out, circular_list,
                at: Checkpoint(phase: phase.number, op: op_next, results: mixed))
        continue with op: op_next, checksum: mixed
    then
        return checksum

# Copies from into to by pushing each element at the front, back to front, so to has a different start.
@reshaping(to)
routine copy_reversed_pushes(from: @CircularList[S64], to: @CircularList[S64]) -> None
    until index == 0 with index: U64 = from.count()
        index2: U64 = index - 1
        to.add_first(from[index2])
        continue with index: index2
    then
        return

routine report_eq(out: @BufWriter[ConsoleOutput], label: @[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    local out: @BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    manager: @MemoryManager = HEAP
    local rng: @Rng <- Rng(state: 3)
    local circular_list: @CircularList[S64] <- .construct(manager)

    balanced: Mix = Mix(push_back: 25, push_front: 25, pop_back: 15, pop_front: 15)
    front_heavy: Mix = Mix(push_back: 5, push_front: 45, pop_back: 20, pop_front: 10)
    back_heavy: Mix = Mix(push_back: 45, push_front: 5, pop_back: 10, pop_front: 20)
    queue: Mix = Mix(push_back: 40, push_front: 0, pop_back: 0, pop_front: 40)
    reversed_queue: Mix = Mix(push_back: 0, push_front: 40, pop_back: 40, pop_front: 0)
    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, circular_list,
        phase: Phase(number: 1, ops: 3000, op_mix: balanced), results: 0)
    r2: S64 = run_phase(harness, circular_list,
        phase: Phase(number: 2, ops: 3000, op_mix: front_heavy), results: r1)
    r3: S64 = run_phase(harness, circular_list,
        phase: Phase(number: 3, ops: 3000, op_mix: back_heavy), results: r2)
    r4: S64 = run_phase(harness, circular_list, phase: Phase(number: 4, ops: 8000, op_mix: queue),
        results: r3)
    r5: S64 = run_phase(harness, circular_list,
        phase: Phase(number: 5, ops: 8000, op_mix: reversed_queue), results: r4)

    local copied: @CircularList[S64] <- .construct(manager)
    report_eq(out, label: "empty copy equal", equal: circular_list.eq(copied))
    copy_reversed_pushes(from: circular_list, to: copied)
    report_eq(out, label: "copy equal", equal: circular_list.eq(copied))
    front: S64 = copied[0]
    copied[0] = front + 1
    report_eq(out, label: "changed front equal", equal: circular_list.eq(copied))
    copied[0] = front
    copied.add_first(front)
    report_eq(out, label: "longer equal", equal: circular_list.eq(copied))
    copied.remove_first()
    report_eq(out, label: "restored equal", equal: circular_list.eq(copied))
    copied.clear()
    report_eq(out, label: "cleared is empty", equal: copied.is_empty())
    drop copied
    drop circular_list
    out.flush()
    return
