# An arm of a value `when` may be `throw ...` in a failable routine: the arm gives no value, so the other arms decide
# the value, and `try` / `check` at the call receives the failure.

import Hosted

crashable BadCodeError
    code: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadCodeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("bad code {me.code}")
    return

### Doubles the value code 1 stands for.
### :param n: The code.
### :returns: Twice the value.
### :throws: BadCodeError for any code but 1.
failable routine pick(n: S64) -> S64
    value: S64 = when n
        1 => 10
        else => throw BadCodeError(code: n)
    return value * 2

### The size a number stands for.
### :param n: The number.
### :returns: 100 for zero, 200 above it.
### :throws: BadCodeError for a negative number.
failable routine label(n: S64) -> S64
    return when
        n < 0 => throw BadCodeError(code: n)
        n == 0 => 100
        else => 200

### Shows a value or `none`.
### :param m: The value.
routine report(m: Optional[S64]) -> None
    when m
        is S64 as v => Console.show("{v}")
        is None => Console.show("none")
    return

### Calls each routine with a value it takes and one it throws for.
routine start() -> None
    report(m: try pick(n: 1))
    report(m: try pick(n: 3))
    report(m: try label(n: 0))
    report(m: try label(n: -1))
    when check pick(n: 7)
        is S64 as v => Console.show("{v}")
        is BadCodeError as e => Console.show("caught {e.code}")
    return
