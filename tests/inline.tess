// #inline asks LLVM to inline a routine at every call (alwaysinline); the program means the same either way.

import Standard::Format
import Standard::Os

#inline
routine mix(h: U64, v: U64) -> U64
    block entry():
        return(h.bitxor(v).mul_wrap(0x100000001B3))

routine main() -> S32
    block entry():
        h : U64 = mix(mix(0xCBF29CE484222325, 1), 2)
        Out.write("{h}\n")
        return(0)
