# @T and &T take a record or an entity alike. A record may hold an address (@Counter), and an entity holds the &T
# places, whose give back is a release duty.

import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Counter(n: n)

### Ends it.
routine @Counter.destruct() -> None
    return

### A point.
record Point
    x: S64
    y: S64

### Where to look: the address of a counter and of a point, no release duty.
record Lookup
    counter: @Counter
    point: @Point

### Two places from the heap.
entity Holder
    counter: &Counter
    point: &Point

### Gives back both places.
routine @Holder.destruct() -> None
    drop me.counter
    drop me.point
    return

### Makes one.
### :param counter: The counter's place, taken over.
### :param point: The point's place, taken over.
### :returns: The new value.
common routine Holder.construct(counter: &Counter, point: &Point) -> Me
    return Holder(counter: steal counter, point: steal point)

routine start() -> None
    c: &Counter <- Counter.construct(n: 4) from HEAP
    p: &Point <- Point(x: 1, y: 2) from HEAP
    look: Lookup = Lookup(counter: c.getview(), point: p.getview())
    counter: @Counter = look.counter
    point: @Point = look.point
    Console.show("{counter.n.peek()} {point.y.peek()}")
    h: &Holder <- Holder.construct(counter: steal c, point: steal p)
    held: @Counter = h.counter.getview()
    Console.show("{held.n.peek()}")
    return
