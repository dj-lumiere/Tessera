// A variant's tag is its branch type's ID, the same number in every variant that has the type: a Maybe[S64] and a
// Result[S64, ParseError] holding an S64 have equal tags, and an all-zero (hollow) variant holds no branch, so a when
// on it crashes instead of taking an arm.

import Standard/Format
import Standard/Os

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

/// Reports the crash on stdout and exits with status 3.
/// :param name: The crash kind.
/// :param message: The crash message.
/// :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("crashed: {name}: {message}\n")
    exit(3)

routine start() -> None
    local maybe: @Maybe[S64] <- 7
    local result: @Result[S64, ParseError] <- 9
    local hollow: @Maybe[S64] <- .hollow()

    a: U64 = maybe.to[@U64]().peek()
    b: U64 = result.to[@U64]().peek()
    Out.write("same tag {a.eq(b)}, nonzero {a.ne(0)}\n")
    value: Maybe[S64] = hollow.peek()
    when value
        is S64 as n => return
        is None => return
