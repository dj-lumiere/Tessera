# wait_all_finished on the three lists of tickets: it waits until every piece of work has finished and takes no
# results, which stay in the tickets until give_back_all ends them. A List[Thread[None]] waits the same way, and a
# List[Fiber[U64]] on the thread that drives FIBERS runs the fibers until their work is done.

import Collections
import Fiber
import Hosted

### A total that every piece of work adds to.
record Tally
    total: Unbroken[U64]

### Adds 1 to the total after a short nap.
### :param tally: The total, shared by every thread.
routine add_one(tally: @Tally) -> None
    waitfor(5ms)
    tally.total.fetch_add(1)
    return

### Adds 1 to the total after a short nap, and gives the step it was handed.
### :param tally: The total, shared by every thread.
### :param step: The value given back.
### :returns: `step`.
routine add_one_and_give(tally: @Tally, step: U64) -> U64
    waitfor(2ms)
    tally.total.fetch_add(1)
    return step

routine start() -> None
    tally: &Tally <- Tally(total: .construct(value: 0))
    threads: &List[Thread[None]] <- .construct(manager: HEAP)
    adding: Work[None] = add_one.to[Work](tally: tally)
    each i in 1 to 4
        t: Thread[None] <- get_thread[None]()
        t.put_work(adding)
        threads.add_last(t)
    threads.wait_all_finished()
    Console.show("threads: total {tally.total.peek()}, tickets {threads.count()}")
    threads.give_back_all()
    threads.wait_all_finished()
    Console.show("empty list: total {tally.total.peek()}")
    drop threads

    counted: &List[Thread[U64]] <- .construct(manager: HEAP)
    each i in 1 to 3 with step: U64 = 1
        t: Thread[U64] <- get_thread[U64]()
        work: Work[U64] = add_one_and_give.to[Work](tally: tally, step: step)
        t.put_work(work)
        counted.add_last(t)
        continue with step: step + 1
    counted.wait_all_finished()
    Console.show("threads with results: total {tally.total.peek()}, finished {counted[2].check_finished()}")
    counted.give_back_all()
    drop counted

    fibers: &List[Fiber[U64]] <- .construct(manager: HEAP)
    each i in 1 to 3 with step: U64 = 1
        f: Fiber[U64] <- FIBERS.get_fiber[U64]()
        work: Work[U64] = add_one_and_give.to[Work](tally: tally, step: step)
        f.put_work(work)
        fibers.add_last(f)
        continue with step: step + 1
    fibers.wait_all_finished()
    Console.show("fibers: total {tally.total.peek()}, finished {fibers[0].check_finished()}")
    fibers.give_back_all()
    drop fibers

    pool: &ThreadPoolManager <- .construct(threads: 2)
    passing: &List[PassableFiber[None]] <- .construct(manager: HEAP)
    each i in 1 to 3
        j: PassableFiber[None] <- pool.get_passable_fiber[None]()
        j.put_work(adding)
        passing.add_last(j)
    passing.wait_all_finished()
    Console.show("passable fibers: total {tally.total.peek()}")
    passing.give_back_all()
    drop passing
    return
