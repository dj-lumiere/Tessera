# A field Counter? keeps its counter in memory from a manager: a counter given to it as a value has none, a build error.
import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### Keeps a counter or none.
entity Holder
    kept: Counter?

### Makes one with a counter.
### :returns: The new value.
common routine Holder.construct() -> Me
    return Me(kept: Counter.construct(n: 1))

routine start() -> None
    holder: &Holder <- Holder.construct()
    return
