# A write template expands its string at build time into write_str and .represent calls on a writer, in order:
# out.write("...") on a value pointing at one (Console.output(), a List[Byte] building text), and Out.write / Err.write
# on the console's stateless writers. A brace holds one expression, loads and chains included. The writer is
# evaluated once, however many pieces the string has.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

global FETCHES: @U32

### The console writer, counting how many times it was asked for.
routine counted_out() -> @ConsoleOutput
    fetches: U32 = FETCHES.peek() + 1
    fetches.poke_into(FETCHES)
    out: @ConsoleOutput = Console.output()
    return out

routine start() -> None
    out: @ConsoleOutput = Console.output()

    x: S64 = 7
    half: B64 = 2.5
    name: @[Byte] = "Tessera"
    local slot: @U8 <- 40
    out.write("x = {x}, half = {half}, name = {name}\n")
    out.write("next = {x.add(1)}, loaded = {slot.peek().add(2)}, flag = {x.gt(5)}\n")
    out.write("{{literal braces}} and {x}{x}\n")

    local alloc: @MemoryManager <- make_heap_memory()
    local text: @List[Byte] <- .construct(alloc)
    text.write("built in a List<Byte>: {x} and {half}")
    built: @[Byte] = text.getview()
    Console.show("{built}")
    drop text

    Console.show("stdout: {x}")
    Console.alert("stderr is not in the expected output")
    Console.show("no values")

    counted_out().write("one writer for {x}, {half} and {x}\n")
    fetched: U32 = FETCHES.peek()
    Console.show("the writer was fetched {fetched} time")
    return
