# Slots that start as .hollow() and are filled before they are read: one a routine fills through its address, one
# filled field by field, one every path stores into, and one a loop fills element by element.
import Hosted

record Point
    x: S64
    y: S64

### Stores 5 into the slot.
### :param out: the slot to fill
routine fill(out: @S64) -> None
    out.poke(5)
    return

### Picks 1 or 2 by `flag`, storing the choice into a head slot on both paths before reading it.
### :param flag: which value to pick
### :returns: 1 when flag holds, else 2
routine pick(flag: Bool) -> S64
    result: &S64 <- .hollow()

    if flag
        1.poke_into(result)
    else
        2.poke_into(result)
    return result.load()

### The squares of 0, 1, and 2, stored element by element in a loop and loaded once the loop is left.
### :returns: the array { 0, 1, 4 }
routine squares() -> Items[S64, 3]
    values: &Items[S64, 3] <- .hollow()

    for i: U64 in 0 til 3
        n: S64 = i.to[S64]()
        values[i] = n * n
    return values.load()

routine start() -> None
    filled: &S64 <- .hollow()

    fill(filled)
    a: S64 = filled.load()
    point: &Point <- .hollow()
    point.x.poke(3)
    point.y.poke(4)
    p: Point = point.load()
    b: S64 = pick(false)
    sq: Items[S64, 3] = squares()
    last: S64 = sq[2]
    Console.show("{a} {p.x} {p.y} {b} {last}")
    return
