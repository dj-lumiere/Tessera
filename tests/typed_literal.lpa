# A number type's name called with one number literal types it: in a template hole, in Console.show, as an
# argument, and as a receiver.
import Hosted

### Twice `n`.
### :param n: The number.
### :returns: Twice it.
routine twice(n: S64) -> S64
    return n * 2

routine start() -> None
    Console.show("{S64(7)} {B64(6.022e23)} {U8(200)} {S8(-128)} {U16(0xFF)}")
    Console.show(S64(-3))
    Console.show("{twice(n: S64(21))} {S64(7).add(1)}")
    a: B32 = B32(1.5)
    Console.show("{a}")
    return
