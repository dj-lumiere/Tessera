# get_by_rank reads the rank-th element of the sorted collections: a KVPair copy from a SortedDict, the element from
# a SortedSet or SortedList. value_ptr_by_rank changes a SortedDict value in place.

import Standard/Collections
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- HEAP.peek()
    local map: @SortedDict[S64, S64] <- .construct(alloc)

    map[30] = 300
    map[10] = 100
    map[20] = 200
    first: KVPair[S64, S64] = map.get_by_rank(0)
    last: KVPair[S64, S64] = map.get_by_rank(2)
    Console.show("{first.key}={first.value} {last.key}={last.value}")
    middle: @S64 = map.value_ptr_by_rank(1)
    next_value: S64 = middle.peek() + 5
    next_value.poke_into(middle)
    Console.show("{map.getitem(20)}")

    local set: @SortedSet[S64] <- .construct(alloc)
    set.add(7)
    set.add(3)
    set.add(5)
    Console.show("{set.get_by_rank(0)} {set.get_by_rank(1)} {set.get_by_rank(2)}")

    local list: @SortedList[S64] <- .construct(alloc)
    list.add(9)
    list.add(4)
    Console.show("{list.get_by_rank(0)} {list.get_by_rank(1)}")

    drop map
    drop set
    drop list
    return
