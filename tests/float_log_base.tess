routine start() -> Void
    shared wrong : @USize <- 0

    block entry()
        jump half(0)

    block half(i: USize)
        done : Bool = i.ge(2092)
        branch done
            ? half_done()
            : continue
        x     : F16  = F16.from_bits(F16_X.getitem(i))
        b     : F16  = F16.from_bits(F16_BASE.getitem(i))
        got   : U16  = x.log(b).bits()
        want  : U16  = F16_WANT.getitem(i)
        zeros : Bool = got.bitor(want).eq(0x8000)
        good  : Bool = got.eq(want).bitor(zeros)
        branch good
            ? half(i.add(1))
            : half_bad(i)

    block half_bad(i: USize)
        wrong.load().add(1).store_into(wrong)
        jump half(i.add(1))

    block half_done()
        Out.write("F16: 2092 pairs, {wrong.load()} wrong\n")
        0.store_into(wrong)
        jump single(0)

    block single(i: USize)
        done : Bool = i.ge(2092)
        branch done
            ? single_done()
            : continue
        x     : F32  = F32.from_bits(F32_X.getitem(i))
        b     : F32  = F32.from_bits(F32_BASE.getitem(i))
        got   : U32  = x.log(b).bits()
        want  : U32  = F32_WANT.getitem(i)
        zeros : Bool = got.bitor(want).eq(0x80000000)
        good  : Bool = got.eq(want).bitor(zeros)
        branch good
            ? single(i.add(1))
            : single_bad(i)

    block single_bad(i: USize)
        wrong.load().add(1).store_into(wrong)
        jump single(i.add(1))

    block single_done()
        Out.write("F32: 2092 pairs, {wrong.load()} wrong\n")
        0.store_into(wrong)
        jump double(0)

    block double(i: USize)
        done : Bool = i.ge(2092)
        branch done
            ? double_done()
            : continue
        x     : F64  = F64.from_bits(F64_X.getitem(i))
        b     : F64  = F64.from_bits(F64_BASE.getitem(i))
        got   : U64  = x.log(b).bits()
        want  : U64  = F64_WANT.getitem(i)
        zeros : Bool = got.bitor(want).eq(0x8000000000000000)
        good  : Bool = got.eq(want).bitor(zeros)
        branch good
            ? double(i.add(1))
            : double_bad(i)

    block double_bad(i: USize)
        wrong.load().add(1).store_into(wrong)
        jump double(i.add(1))

    block double_done()
        Out.write("F64: 2092 pairs, {wrong.load()} wrong\n")
        return()
