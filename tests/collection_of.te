# Each collection is made from an array value with of(values:, manager:). The array is taken over, so entity values go
# into the collection.

import Standard/Collections
import Standard/Hosted

routine start() -> None
    xs: &List[S64] <- List[S64].of(values: [3, 1, 2], manager: HEAP)
    nested: &List[List[S64]] <- List[List[S64]].of(
        values: [List[S64].of(values: [7], manager: HEAP), List[S64].construct(HEAP)],
        manager: HEAP)
    c: &RotatableList[S64] <- RotatableList[S64].of(values: [3, 1, 2], manager: HEAP)
    sl: &SortedList[S64] <- SortedList[S64].of(values: [3, 1, 2], manager: HEAP)
    st: &Set[S64] <- Set[S64].of(values: [3, 1, 3], manager: HEAP)
    ss: &SortedSet[S64] <- SortedSet[S64].of(values: [3, 1, 3], manager: HEAP)
    pq: &PriorityQueue[S64, S64] <- PriorityQueue[S64, S64].of(values: [(2, 20), (1, 10)],
        manager: HEAP)
    d: &Dict[S64, S64] <- Dict[S64, S64].of(values: [(1, 10), (2, 20), (1, 11)], manager: HEAP)
    sd: &SortedDict[S64, S64] <- SortedDict[S64, S64].of(values: [(2, 20), (1, 10)], manager: HEAP)
    bits: &BitList <- BitList.of(values: [true, false, true], manager: HEAP)

    Console.show("{xs} {nested.count()} {nested.getslot(0).count()} {c} {sl} {st} {ss}")
    Console.show("{pq.count()} {d} {sd} {bits}")
    drop bits
    drop sd
    drop d
    drop pq
    drop ss
    drop st
    drop sl
    drop c
    drop nested
    drop xs
    return
