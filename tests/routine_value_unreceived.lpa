# A plain call through a routine value that was bound to a name passes the failure on, and with nothing above to receive
# it the program stops with the failure's message.

import Hosted

crashable BadWorkError
    code: S64

### Writes the message.
### :typeparam TWriter: The Writer.
### :param out: Where it goes.
routine BadWorkError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("bad work {me.code}")
    return

### Twice n, failing for a negative n.
### :param n: The number.
### :returns: Twice n.
routine twice(n: S64) -> S64
    if n < 0
        throw BadWorkError(code: n)
    return n * 2

### Runs the example.
routine start() -> None
    c: Callable[(S64,), S64] = twice.to[Callable]()
    Console.show("{c.call(4)}")
    Console.show("{c.call(-6)}")
    return
