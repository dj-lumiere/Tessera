# build_error on a side a value type parameter rules out is never reached: only the instance that reaches it is an
# error, reported at the call that made it, with the parameter's value in its text.

import Hosted

### A width.
choice Width: U8
    ### 8 bits.
    NARROW
    ### 64 bits.
    WIDE

### The bits of W.
### :typeparam W: The width.
### :typeparam N: The count, at most 4.
### :returns: The bits times N.
routine bits[W, N]() -> U64
needs Width W, U64 N
    if N > 4
        build_error("you gave bits the count {N} with {W}: give it 4 or less")
    when W
        Width.NARROW => return 8 * N
        Width.WIDE => return 64 * N

routine start() -> None
    Console.show("{bits[NARROW, 2]()} {bits[WIDE, 4]()}")
    Console.show("{bits[WIDE, 5]()}")
    return
