# An order handed on through a generic routine is checked where the program's own line wrote it.

import Hosted

### Reads x with the order O.
### :typeparam O: The order.
### :param x: The place.
### :returns: The value.
routine read[O](x: @U64) -> U64
needs MemoryOrder O
    return x.peek_unbroken[O]()

routine start() -> None
    n: &U64 <- 5
    Console.show("{read[ACQUIRE](n)}")
    Console.show("{read[ACQ_REL](n)}")
    return
