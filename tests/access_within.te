# AccessManager.take waits for an access at most until a deadline: another thread gives up while the access is held,
# and gets it once the holder gives it back. The AccessManager lists what a thread holds.

import Standard/Os

record Shared
    value: U64
    readers: U64

routine try_briefly(at: @U64, mode: U8) -> Bool
    place: &SourceLocation <- .hollow()

    deadline: Duration = Clock.monotonic() +^ 20ms
    taken: Bool = AccessManager.take(at, size: 8, mode, deadline, place)
    if taken
        AccessManager.give_back(at)
    return taken

routine elsewhere(at: @U64, mode: U8) -> Bool
    t: Thread[Bool] <- get_thread[Bool]()
    work_t: Work[Bool] <- try_briefly.to[Work](at: at, mode: mode)
    t.put_work(work_t)
    drop work_t
    t.wait_finished()
    taken: Bool = t.retrieve()
    drop t
    return taken

routine start() -> None
    shared: &Shared <- Shared(value: 0, readers: 0)

    value: Authorized[U64] <- shared.value.get_exclusive_access()
    readers: ReadAuthorized[U64] <- shared.readers.get_shared_read_access()
    Console.show("held: {AccessManager.held_count()}")
    late: Bool = elsewhere(at: shared.value, mode: ACCESS_WRITE)
    blocked: Bool = elsewhere(at: shared.readers, mode: ACCESS_WRITE)
    Console.show("while held: {late} {blocked}")
    started: Duration = Clock.monotonic()
    again: Bool = elsewhere(at: shared.value, mode: ACCESS_READ)
    waited: Bool = Clock.monotonic() - started >= 20ms
    drop value
    drop readers
    Console.show("held: {AccessManager.held_count()}")
    free: Bool = elsewhere(at: shared.value, mode: ACCESS_WRITE)
    open: Bool = elsewhere(at: shared.readers, mode: ACCESS_WRITE)
    Console.show("once free: {free} {open}")
    Console.show("gave up after 20ms: {again} {waited}")
    return
