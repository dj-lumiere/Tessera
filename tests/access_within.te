# lock_within waits for an access at most a given time: another thread gives up while the access is held, and gets it
# once the holder lets go. The access counts the waits, and the AccessManager lists what a thread holds.

import Standard/Os

record Shared
    access: ExclusiveAccess
    readers: MultiReadAccess

routine try_briefly(shared: @Shared) -> Bool
    taken: Bool = shared.access.lock_within(20ms)
    if taken
        shared.access.unlock()
    return taken

routine write_briefly(shared: @Shared) -> Bool
    taken: Bool = shared.readers.lock_write_within(20ms)
    if taken
        shared.readers.unlock_write()
    return taken

routine elsewhere(entry: Callable[(@Shared,), Bool], shared: @Shared) -> Bool
    t: Thread[Bool] = get_thread[Bool]()
    t.put_work(entry, args: shared)
    t.wait_finished()
    taken: Bool = t.retrieve()
    t.give_back()
    return taken

routine start() -> None
    local shared: @Shared <- Shared(access: .construct(), readers: .construct())

    shared.access.lock()
    shared.readers.lock_read()
    Console.show("held: {AccessManager.held_count()}")
    late: Bool = elsewhere(entry: try_briefly.to[Callable](), shared)
    blocked: Bool = elsewhere(entry: write_briefly.to[Callable](), shared)
    Console.show("while held: {late} {blocked}")
    shared.access.unlock()
    shared.readers.unlock_read()
    Console.show("held: {AccessManager.held_count()}")
    free: Bool = elsewhere(entry: try_briefly.to[Callable](), shared)
    open: Bool = elsewhere(entry: write_briefly.to[Callable](), shared)
    Console.show("once free: {free} {open}")
    Console.show("waits: {shared.access.wait_count()} {shared.readers.wait_count()}")
    Console.show("waited at least 20ms: {shared.access.waited() >= 20ms}")
    return
