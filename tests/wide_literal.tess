// Integer literals wider than 128 bits: decimal and hex S256 and U256 values. A literal must lie in its type's range,
// so an all-ones pattern is a U256; its bits read as an S256 are -1.

import Standard::Format
import Standard::Os

routine show<T>(%out: @FdWriter, %x: T) -> Void
require T: typename, Represent<T>
    block entry():
        %x.represent_hex(%out)
        write(%out, "\n")
        return()

routine show_bool(%out: @FdWriter, %b: Bool) -> Void
    block entry():
        write(%out, "{%b}\n")
        return()

routine main() -> S32
    block entry():
        %out_val : FdWriter = .stdout()
        claim %out : @FdWriter
        %out.store(%out_val)

        %max     : S256 = 57896044618658097711785492504343953926634992332820282019728792003956564819967
        %min     : S256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
        %ones    : U256 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
        %top_bit : U256 = 0x8000000000000000_0000000000000000_0000000000000000_0000000000000000
        %mixed   : U256 = 0x0123456789ABCDEF_FEDCBA9876543210_DEADBEEFCAFEBABE_0000000100000002
        %small   : S256 = -2
        %over128 : U256 = 340282366920938463463374607431768211456  // 2^128
        show(%out, %max)
        show(%out, %min)
        show(%out, %ones)
        show(%out, %top_bit)
        show(%out, %mixed)
        show(%out, %small)
        show(%out, %over128)

        // The unsigned bit patterns agree with the signed values.
        show_bool(%out, %ones.to_s256_wrap().eq(-1))
        show_bool(%out, %top_bit.to_s256_wrap().eq(%min))
        show_bool(%out,
                %max.to_u256_wrap().eq(0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF))

        // Narrower types read the same way.
        %ones128 : U128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
        %ones64  : U64  = 0xFFFFFFFFFFFFFFFF
        show_bool(%out, %ones128.to_s128_wrap().eq(-1))
        show_bool(%out, %ones64.to_s64_wrap().eq(-1))
        return(0)
