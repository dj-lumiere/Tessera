# A loop that never ends by itself is left only through its break: memory dropped on the way to that break has ended
# when the routine goes on after the loop.
import Collections
import Hosted

routine start() -> None
    xs: &List[U64] <- .construct(HEAP)

    loop with i: U64 = 0
        if i < 3
            xs.add_last(i)
            continue with i: i + 1
        Console.show("held {xs.count()}")
        drop xs
        break
    Console.show("done")
    return
