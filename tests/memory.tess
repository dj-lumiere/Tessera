// claimed stack slots, heap buffers through libc malloc, indexed loads and stores.

import Standard::Os

#[external("c"), symbol("malloc")]
routine c_malloc(size: USize) -> Addr

#[external("c"), symbol("free")]
routine c_free(ptr: Addr) -> Void

/// Fills data[i] = i * i for i in 0..len, then sums it through a stack slot.
routine sum_of_squares(len: USize) -> U64
    shared total : @U64 <- 0

    block entry()
        bytes  : USize = len.mul(8)
        raw    : Addr  = c_malloc(bytes)
        failed : Bool  = raw.is_null()
        branch failed
            ? crash_allocation()
            : ready(raw.to<@U64>())

    block ready(data: @U64)
        jump fill(data, 0)

    block fill(data: @U64, i: USize)
        done : Bool = i.ge(len)
        branch done
            ? start_sum(data)
            : store(data, i)

    block store(data: @U64, i: USize)
        data.stride(i).store(i.mul(i).to<U64>())
        jump fill(data, i.add(1))

    block start_sum(data: @U64)
        jump sum(data, 0)

    block sum(data: @U64, i: USize)
        done : Bool = i.ge(len)
        branch done
            ? finish(data)
            : add(data, i)

    block add(data: @U64, i: USize)
        x       : U64 = data.stride(i).load()
        running : U64 = total.load().add(x)
        running.store_into(total)
        jump sum(data, i.add(1))

    block finish(data: @U64)
        c_free(data)
        result : U64 = total.load()
        return(result)

routine start() -> Void
    block entry()
        s    : U64  = sum_of_squares(10)
        ok   : Bool = s.eq(285)
        code : S32  = ok
            ? 0
            : 1
        set_exit_code(code)
        return()
