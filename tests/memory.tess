// alloca slots, heap buffers through libc malloc, indexed loads and stores.

@[external("c"), symbol("malloc")]
routine c_malloc(%size: CSize) -> Addr

@[external("c"), symbol("free")]
routine c_free(#ptr: Addr) -> Void

/// Fills data[i] = i * i for i in 0..len, then sums it through a stack slot.
routine sum_of_squares(%len: U64) -> U64
    block entry():
        %bytes: U64 = %len.mul(8)
        #raw: Addr = c_malloc(%bytes)
        %failed: Bool = #raw.is_null()
        branch %failed ? trap() : ready(#raw.cast<U64>())

    block ready(#data: Ptr<U64>):
        jump fill(#data, 0)

    block fill(#data: Ptr<U64>, %i: U64):
        %done: Bool = %i.ge(%len)
        branch %done ? start_sum(#data) : store(#data, %i)

    block store(#data: Ptr<U64>, %i: U64):
        #data[%i].store(%i.mul(%i))
        jump fill(#data, %i.add(1))

    block start_sum(#data: Ptr<U64>):
        #total: Ptr<U64> = alloca
        #total.store(0)
        jump sum(#data, #total, 0)

    block sum(#data: Ptr<U64>, #total: Ptr<U64>, %i: U64):
        %done: Bool = %i.ge(%len)
        branch %done ? finish(#data, #total) : add(#data, #total, %i)

    block add(#data: Ptr<U64>, #total: Ptr<U64>, %i: U64):
        %x: U64 = #data[%i].load()
        %cur: U64 = #total.load()
        #total.store(%cur.add(%x))
        jump sum(#data, #total, %i.add(1))

    block finish(#data: Ptr<U64>, #total: Ptr<U64>):
        c_free(#data)
        %result: U64 = #total.load()
        return(%result)

routine main() -> S32
    block entry():
        %s: U64 = sum_of_squares(10)
        %ok: Bool = %s.eq(285)
        %code: S32 = %ok ? 0 : 1
        return(%code)
