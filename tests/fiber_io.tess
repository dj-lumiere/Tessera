// A fiber reading a pipe doesn't stop the others: with one worker thread, the reader waits for data while the
// writer, a fiber on the same worker, runs, yields, and writes it. The read and the write run on the scheduler's
// I/O threads. If the read blocked the worker, the writer would never run.

import Standard/Alloc
import Standard/Fiber
import Standard/Format
import Standard/Os

record Pipe
    sched: @FiberManager
    fds: Array[CInt, 2]  // the read end, then the write end

/// Makes a `Pipe` from its fields.
/// :param sched: Its `sched`.
/// :param fds: Its `fds`.
/// :returns: The new value.
routine Pipe.construct(sched: @FiberManager, fds: Array[CInt, 2]) -> Me
    return(Me(sched, fds))

/// Releases nothing: a `Pipe` holds no memory of its own.
routine Pipe.destruct(me: @Me) -> Void
    return()

#[external("c"), symbol("pipe"), target(os: not "windows")]
routine c_pipe(fds: @CInt) -> CInt

#[external("c"), symbol("_pipe"), target(os: "windows")]
routine c_win_pipe(fds: @CInt, size: U32, mode: CInt) -> CInt

#target(os: not "windows")
routine make_pipe(fds: @CInt) -> Void
    c_pipe(fds)
    return()

/// _O_BINARY, so the bytes go through as they are.
#target(os: "windows")
routine make_pipe(fds: @CInt) -> Void
    c_win_pipe(fds, 4096, 0x8000)
    return()

routine reader(pipe: @Pipe) -> Void
    sched: @FiberManager = pipe.sched.peek()
    claim buf: @Array[Byte, 16] <- .hollow()
    Out.write("reader: waiting\n")
    n: SSize = sched.read(fd: pipe.fds.getitem(0), buf: buf.to[@Byte](), count: 16)
    text: Span[Byte] = Span[Byte].construct(data: buf.to[@Byte](), count: n.to[USize]())
    Out.write("reader: got {text}\n")
    return()

routine writer(pipe: @Pipe) -> Void
    sched: @FiberManager = pipe.sched.peek()
    Out.write("writer: step 1\n")
    sched.yield()
    Out.write("writer: step 2\n")
    sched.yield()
    Out.write("writer: writing\n")
    hello: Span[Byte] = "hello"
    sched.write(fd: pipe.fds.getitem(1), buf: hello.data, count: hello.count)
    return()

routine start() -> Void
    claim alloc: @MemoryManager <- make_heap_memory()
    claim stacks: @MemoryManager <- make_stack_memory()
    claim sched: @FiberManager <- .construct(workers: 1, stacks, alloc)
    claim fds: @Array[CInt, 2] <- .hollow()
    make_pipe(fds.to[@CInt]())
    claim pipe: @Pipe <- Pipe(sched: sched, fds: fds.peek())
    sched.spawn(entry: reader.to[Callable](), arg: pipe, stack_size: 65536)
    sched.spawn(entry: writer.to[Callable](), arg: pipe, stack_size: 65536)
    sched.run()
    Out.write("all done\n")
    sched.destruct()
    return()
