// What a generic body may call, checked before any instantiation: the record's require holds in every routine on
// it, a refining concept gives what it refines, a conform's when gives the routines that meet it, and a conversion
// picked by a type parameter (`x.to<T>()`) waits for the instance.

import Standard::Format
import Standard::Os

/// The largest value offered so far. Every routine on it may compare values, since the record requires it.
record Best<T>
require T: typename, Comparable<T>
    value : T

record Pair<T>
require T: typename
conform Equatable<Pair<T>> when T: typename, Equatable<T>
    first  : T
    second : T

routine Best<T>.offer(me: @Me, x: T) -> Void
require T: typename
    block entry()
        current : T    = me.value.load()
        order   : S32  = x.compare(current)
        better  : Bool = order.gt(0)
        branch better
            ? keep()
            : return()

    block keep()
        me.value.store(x)
        return()

/// HashEquatable<T> refines Equatable<T> and Hashable<T>, so both eq and hash are in force.
routine same_hash<T>(a: T, b: T) -> Bool
require T: typename, HashEquatable<T>
    block entry()
        equal : Bool = a.eq(b)
        branch equal
            ? hashes()
            : return(false)

    block hashes()
        ha : U64  = a.hash()
        hb : U64  = b.hash()
        r  : Bool = ha.eq(hb)
        return(r)

routine Pair<T>.eq(me: Me, other: Me) -> Bool
require T: typename, Equatable<T>
    block entry()
        same_first : Bool = me.first.eq(other.first)
        branch same_first
            ? second()
            : return(false)

    block second()
        r : Bool = me.second.eq(other.second)
        return(r)

/// Equatable<Pair<T>> holds when Equatable<T> does, which `same` has.
routine same<T>(a: Pair<T>, b: Pair<T>) -> Bool
require T: typename, Equatable<T>
    block entry()
        r : Bool = a.eq(b)
        return(r)

routine halve<T>(x: S64) -> T
require T: typename
    block entry()
        half : S64 = x.div(2)
        r    : T   = half.to<T>()
        return(r)

routine start() -> Void
    block entry()
        claim best : @Best<S64> <- { value: 3 }
        seven : S64 = 7
        best.offer(seven)
        two : S64 = 2
        best.offer(two)
        top  : S64       = best.value.load()
        word : U64       = 41
        hash : Bool      = same_hash(word, word)
        p    : Pair<S64> = { first: 1, second: 2 }
        q    : Pair<S64> = { first: 1, second: 3 }
        pp   : Bool      = same(p, p)
        pq   : Bool      = same(p, q)
        h    : F64       = halve<F64>(top)
        Out.write("{top} {hash} {pp} {pq} {h}\n")
        return()
