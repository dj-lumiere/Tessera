# Tessera stdlib algorithm: iterative lazy segment tree
#
# TValue and TLazy must satisfy LazySegmentOps[TValue, TLazy].
# Ranges are half-open: [left, right).
#
# Layout:
#   data[1..size)      internal aggregate nodes
#   data[size..2*size) leaves
#   lazy[1..size)      pending internal lazy tags
#
# The bit routines below hide the heap-index arithmetic. They are compact on
# purpose, but callers use names that describe the tree operation.

import Standard/Os

entity LazySegmentTree[TValue, TLazy]
needs TValue: typename, TLazy: typename, LazySegmentOps[TValue, TLazy]
obeys ViewingIndexable[LazySegmentTree[TValue, TLazy], TValue], ModifyingIndexable[LazySegmentTree[TValue, TLazy], TValue]
    nodes: Memory[TValue]
    tags: Memory[TLazy]
    count: U64
    size: U64
    height: U64

protocol Monoid[T]
needs T: typename
    common routine Me.identity() -> Me
    routine Me.combine(right: Me) -> Me

protocol Group[T]
obeys Monoid[T]
needs T: typename
    routine Me.inverse() -> Me

### Constrains two types at once, so there is no single conforming Me —
### required routines name their owner (TValue or TLazy) explicitly.
protocol LazySegmentOps[TValue, TLazy]
needs TValue: typename, TLazy: typename
    ### Aggregate two child values.
    routine TValue.combine(right: Me) -> Me

    ### Apply one lazy tag to an aggregate value over a segment of length.
    routine TValue.apply(lazy: TLazy, count: U64) -> Me

    ### Compose tags so the returned tag represents newer after older.
    routine TLazy.compose(older: Me) -> Me

    common routine TValue.identity() -> Me
    common routine TLazy.identity() -> Me
    routine TLazy.is_identity_lazy() -> Bool

routine @LazySegmentTree[T, L].parent(node: U64) -> U64
    parent: U64 = node >> 1
    return parent

routine @LazySegmentTree[T, L].left_child(node: U64) -> U64
    child: U64 = node << 1
    return child

routine @LazySegmentTree[T, L].right_child(node: U64) -> U64
    right_child: U64 = (node << 1) | 1
    return right_child

routine @LazySegmentTree[T, L].is_right_child(node: U64) -> Bool
    return node & 1 != 0

routine @LazySegmentTree[T, L].leaf(index: U64) -> U64
    size: U64 = me.size.peek()
    leaf: U64 = index | size
    return leaf

routine @LazySegmentTree[T, L].cover_width(height: U64) -> U64
    width: U64 = 1 << height
    return width

routine @LazySegmentTree[T, L].cover_mask(height: U64) -> U64
    mask: U64 = me.cover_width(height) - 1
    return mask

routine @LazySegmentTree[T, L].is_aligned_to_cover(node: U64, height: U64) -> Bool
    mask: U64 = me.cover_mask(height)
    return node & mask == 0

common routine LazySegmentTree[T, L].construct(count: U64, manager: @MemoryManager) -> Me
    local height: @U64 <- 0

    if count <= 0
        crash_invalid_value()
    else
        until size >= count with size: U64 = 1
            (height.peek() + 1).poke_into(height)
            continue with size: size << 1
        then
            data_count: U64 = size << 1
            local nodes: @Memory[T] <- Memory[T].construct(count: data_count, manager: manager)

            local tags: @Memory[L] <- Memory[L].construct(count: size, manager: manager)

            each i in 0 til nodes.count()
                identity: T = .identity()
                nodes.getslot(i).poke(identity)
            then
                each i2 in 0 til size
                    identity: L = .identity()
                    tags.getslot(i2).poke(identity)
                then
                    return Me(nodes: steal nodes, tags: steal tags, count: count, size: size,
                        height: height.peek())

routine @LazySegmentTree[T, L].count() -> U64
    count: U64 = me.count.peek()
    return count

routine @LazySegmentTree[T, L].build_from(values: @T) -> None
    each i in 0 til me.count.peek()
        data: @T = me.nodes.to[@T]()
        leaf: U64 = me.leaf(i)
        value: T = values.stride(i).peek()
        data.stride(leaf).poke(value)

    each i in 0 til me.size.peek()
        lazy: @L = me.tags.to[@L]()
        identity: L = .identity()
        lazy.stride(i).poke(identity)
    size: U64 = me.size.peek()

    until node <= 0 with node: U64 = size - 1
        me.pull_node(node)
        continue with node: node - 1
    then
        return

routine @LazySegmentTree[T, L].pull_node(node: U64) -> None
    data: @T = me.nodes.to[@T]()
    left: U64 = me.left_child(node)
    right: U64 = me.right_child(node)
    left_value: T = data.stride(left).peek()
    right_value: T = data.stride(right).peek()
    value: T = left_value.combine(right_value)
    data.stride(node).poke(value)
    return

routine @LazySegmentTree[T, L].apply_node(node: U64, tag: L, width: U64) -> None
    data: @T = me.nodes.to[@T]()
    node_value: T = data.stride(node).peek()
    node_value.apply(lazy: tag, count: width).poke_into(data.stride(node))
    size: U64 = me.size.peek()
    if not (node < size)
        return
    lazy: @L = me.tags.to[@L]()
    old: L = lazy.stride(node).peek()
    next: L = tag.compose(old)
    lazy.stride(node).poke(next)
    return

routine @LazySegmentTree[T, L].push_node(node: U64, width: U64) -> None
    local lazy: @L = me.tags.to[@L]()
    local tag: L = lazy.stride(node).peek()

    if tag.is_identity_lazy()
        return
    else
        child_width: U64 = width >> 1
        left: U64 = me.left_child(node)
        right: U64 = me.right_child(node)
        me.apply_node(node: left, tag, width: child_width)
        me.apply_node(node: right, tag, width: child_width)
        identity: L = .identity()
        lazy.stride(node).poke(identity)
        return

routine @LazySegmentTree[T, L].push_path(node: U64) -> None
    until level <= 0 with level: U64 = me.height.peek()
        ancestor: U64 = node >> level
        width: U64 = me.cover_width(level)
        me.push_node(node: ancestor, width)
        continue with level: level - 1
    then
        return

routine @LazySegmentTree[T, L].rebuild_path(node: U64) -> None
    until ancestor <= 0 with ancestor: U64 = me.parent(node)
        me.pull_node(ancestor)
        continue with ancestor: me.parent(ancestor)
    then
        return

routine @LazySegmentTree[T, L].rebuild_left_boundary(node: U64) -> None
    each level in 1 to me.height.peek()
        if not me.is_aligned_to_cover(node, height: level)
            ancestor: U64 = node >> level
            me.pull_node(ancestor)
    then
        return

routine @LazySegmentTree[T, L].rebuild_right_boundary(exclusive: U64) -> None
    each level in 1 to me.height.peek()
        if not me.is_aligned_to_cover(node: exclusive, height: level)
            ancestor: U64 = exclusive - 1 >> level
            me.pull_node(ancestor)
    then
        return

routine @LazySegmentTree[T, L].setitem(index: U64, value: T) -> None
    count: U64 = me.count.peek()
    not_negative: Bool = index >= 0
    before_end: Bool = index < count
    if not (not_negative and before_end)
        crash_out_of_bounds()
    node: U64 = me.leaf(index)
    me.push_path(node)
    data: @T = me.nodes.to[@T]()
    data.stride(node).poke(value)
    me.rebuild_path(node)
    return

routine @LazySegmentTree[T, L].getitem(index: U64) -> T
    count: U64 = me.count.peek()
    not_negative: Bool = index >= 0
    before_end: Bool = index < count
    if not_negative and before_end
        node: U64 = me.leaf(index)
        me.push_path(node)
        data: @T = me.nodes.to[@T]()
        value: T = data.stride(node).peek()
        return value
    else
        crash_out_of_bounds()

routine @LazySegmentTree[T, L].range_apply(left: U64, right: U64, tag: L) -> None
    local width: @U64 <- 1

    valid_left: Bool = left >= 0
    valid_order: Bool = left <= right
    count: U64 = me.count.peek()
    valid_right: Bool = right <= count
    valid_a: Bool = valid_left and valid_order
    if not (valid_a and valid_right)
        crash_out_of_bounds()
    if left == right
        return
    l0: U64 = me.leaf(left)
    r0: U64 = me.leaf(right - 1)
    rex0: U64 = r0 + 1
    me.push_path(l0)
    me.push_path(r0)

    until l >= r with l: U64 = l0, r: U64 = rex0
        take_left: Bool = me.is_right_child(l)
        l2: U64 = when
            take_left =>
                me.apply_node(node: l, tag, width: width.peek())
                becomes l + 1
            else => l
        take_right: Bool = me.is_right_child(r)
        r2: U64 = when
            take_right =>
                node: U64 = r - 1
                me.apply_node(node, tag, width: width.peek())
                becomes node
            else => r
        next_l: U64 = me.parent(l2)
        next_r: U64 = me.parent(r2)
        next_width: U64 = width.peek() << 1
        next_width.poke_into(width)
        continue with l: next_l, r: next_r
    then
        me.rebuild_left_boundary(l0)
        me.rebuild_right_boundary(rex0)
        return

routine @LazySegmentTree[T, L].range_query(left: U64, right: U64) -> T
    local left_acc: @T <- .hollow()
    local right_acc: @T <- .hollow()

    valid_left: Bool = left >= 0
    valid_order: Bool = left <= right
    count: U64 = me.count.peek()
    valid_right: Bool = right <= count
    valid_a: Bool = valid_left and valid_order
    if not (valid_a and valid_right)
        crash_out_of_bounds()
    if left == right
        identity: T = .identity()
        return identity
    else
        l: U64 = me.leaf(left)
        r: U64 = me.leaf(right - 1)
        me.push_path(l)
        me.push_path(r)
        left_identity: T = .identity()
        right_identity: T = .identity()
        left_identity.poke_into(left_acc)
        right_identity.poke_into(right_acc)

        until l2 >= r2 with l2: U64 = l, r2: U64 = r + 1
            use_left: Bool = me.is_right_child(l2)
            l3: U64 = when
                use_left =>
                    data: @T = me.nodes.to[@T]()
                    value: T = data.stride(l2).peek()
                    next_left: T = left_acc.peek().combine(value)
                    next_left.poke_into(left_acc)
                    becomes l2 + 1
                else => l2
            use_right: Bool = me.is_right_child(r2)
            r3: U64 = when
                use_right =>
                    node: U64 = r2 - 1
                    data: @T = me.nodes.to[@T]()
                    value: T = data.stride(node).peek()
                    next_right: T = value.combine(right_acc.peek())
                    next_right.poke_into(right_acc)
                    becomes node
                else => r2
            next_l: U64 = me.parent(l3)
            continue with l2: next_l, r2: me.parent(r3)
        value: T = left_acc.peek().combine(right_acc.peek())
        return value

routine @LazySegmentTree[T, L].destruct() -> None
    drop me.nodes
    drop me.tags
    me.count.poke(0)
    me.size.poke(0)
    me.height.poke(0)
    return

# ── Demo: range add, range sum ────────────────────────────────────────────────

### A segment's sum. Applying an add of delta to length elements adds delta * length.
record RangeSum
    sum: S64

### A pending add over every element of a segment.
record RangeAdd
    delta: S64

### LazySegmentOps constrains two types at once, so the conformance is its own declaration.
obeys LazySegmentOps[RangeSum, RangeAdd]

common routine RangeSum.identity() -> Me
    zero: Me = Me(sum: 0)
    return zero

routine RangeSum.combine(right: Me) -> Me
    total: Me = Me(sum: me.sum + right.sum)
    return total

routine RangeSum.apply(lazy: RangeAdd, count: U64) -> Me
    added: S64 = lazy.delta * count.to[S64]()
    result: Me = Me(sum: me.sum + added)
    return result

common routine RangeAdd.identity() -> Me
    none: Me = Me(delta: 0)
    return none

routine RangeAdd.compose(older: Me) -> Me
    both: Me = Me(delta: me.delta + older.delta)
    return both

routine RangeAdd.is_identity_lazy() -> Bool
    return me.delta == 0

routine print_sum(out: @BufWriter[ConsoleOutput], tree: @LazySegmentTree[RangeSum, RangeAdd],
    left: U64, right: U64) -> None
    total: RangeSum = tree.range_query(left, right)
    out.write("sum [{left}, {right}) = {total.sum}\n")
    return

routine print_get(out: @BufWriter[ConsoleOutput], tree: @LazySegmentTree[RangeSum, RangeAdd],
    index: U64) -> None
    value: RangeSum = tree[index]
    out.write("get {index} = {value.sum}\n")
    return

routine print_add(out: @BufWriter[ConsoleOutput], left: U64, right: U64, delta: S64) -> None
    out.write("add {delta} to [{left}, {right})\n")
    return

### Fills count leaves with i * 7 mod 10: 0 7 4 1 8 5 2 9 6 3.
routine fill_values(values: @RangeSum, count: U64) -> None
    each i in 0 til count
        scrambled: U64 = i * 7 % 10
        leaf: RangeSum = RangeSum(sum: scrambled.to[S64]())
        values.stride(i).poke(leaf)
    then
        return

routine start() -> None
    fd: @ConsoleOutput = Console.output()
    local out: @BufWriter[ConsoleOutput] <- .hollow()
    out.construct(fd)
    manager: @MemoryManager = HEAP
    local values: @Memory[RangeSum] <- .construct(count: 10, manager: manager)
    first: @RangeSum = values.to[@RangeSum]()
    fill_values(values: first, count: 10)
    local tree: @LazySegmentTree[RangeSum, RangeAdd] <- .construct(count: 10, manager)
    tree.build_from(first)
    drop values
    print_sum(out, tree, left: 0, right: 10)
    print_sum(out, tree, left: 3, right: 8)

    print_add(out, left: 2, right: 7, delta: 10)
    tree.range_apply(left: 2, right: 7, tag: RangeAdd(delta: 10))
    print_sum(out, tree, left: 0, right: 10)
    print_sum(out, tree, left: 3, right: 5)
    print_sum(out, tree, left: 6, right: 9)

    print_add(out, left: 0, right: 4, delta: -3)
    tree.range_apply(left: 0, right: 4, tag: RangeAdd(delta: -3))
    print_sum(out, tree, left: 0, right: 4)
    print_sum(out, tree, left: 1, right: 8)
    print_get(out, tree, index: 3)

    tree[5] = RangeSum(sum: 100)
    print_get(out, tree, index: 5)
    print_sum(out, tree, left: 4, right: 7)
    print_sum(out, tree, left: 4, right: 4)
    print_sum(out, tree, left: 0, right: 10)
    drop tree
    out.flush()
    return
