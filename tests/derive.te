# @derive(Equatable, Hashable, Comparable): field by field, in declaration order. A choice compares as its underlying integer.

import Hosted

@derive(Equatable, Hashable, Comparable, Diagnosable)
record Version
    major: U32
    minor: U32

@derive(Equatable, Hashable, Comparable)
record Pair[T]
needs T: record
    first: T
    second: T

@derive(Equatable, Hashable, Comparable, Representable)
choice Level: U8
    LOW
    HIGH

@derive(Equatable)
record Empty
    nothing

### Makes a `Pair` from its fields.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
common routine Pair[T].construct(first: T, second: T) -> Me
needs T: typename
    return Me(first, second)

### Releases nothing: a `Pair` holds no memory of its own.
routine @Pair[T].destruct() -> None
needs T: typename
    return

routine start() -> None
    a: Version = Version(major: 1, minor: 2)
    b: Version = Version(major: 1, minor: 3)
    c: Version = Version(major: 1, minor: 2)
    Console.show("{a.eq(c)} {a.eq(b)} {a.hash().eq(c.hash())} {a.hash().eq(b.hash())}")
    Console.show("{a.compare(b)} {b.compare(a)} {a.compare(c)}")
    p: Pair[@[Byte]] = Pair[@[Byte]](first: "x", second: "b")
    q: Pair[@[Byte]] = Pair[@[Byte]](first: "x", second: "a")
    Console.show("{p.eq(q)} {p.compare(q)} {p.hash().eq(q.hash())}")
    low: Level = Level.LOW
    high: Level = Level.HIGH
    Console.show("{low} {low.eq(high)} {low.compare(high)} {high.hash().eq(high.hash())}")
    some: Optional[Version] = a
    other: Optional[Version] = c
    Console.show("{some.eq(other)}")
    e: Empty = Empty()
    Console.show("{e.eq(e)}")
    b.diagnose_into(Console.output())
    Console.show("")
    return
