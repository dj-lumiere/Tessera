# A List[Byte] is a Writer: write appends to it, growing through its memory manager, and to_string views the result.

import Collections
import Hosted

routine start() -> None
    manager: @MemoryManager = HEAP
    buf: &List[Byte] <- .construct(manager)

    name: @[Byte] = "Tessera"
    count: U64 = 3
    buf.write("Hello, {name}! You have {count} messages.")
    buf.write("")

    # many appends force several reallocations
    for i: U64 in 0 til 20
        buf.write(" {i}")
    text: @[Byte] = buf.getview()
    Console.show("{text}")
    Console.show("{buf.count()} bytes")
    drop buf
    return
