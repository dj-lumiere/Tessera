# A generic routine reads a view after its memory was given back.

import Standard/Os

### Reads the first value after giving the memory back.
### :param v0: The value to fill with.
### :returns: The first value.
routine read_after[T](v0: T) -> T
    local m: @Memory[T] <- [v0] * 4 from HEAP

    v: @[T] = m.getslice()

    drop m
    return v.getitem(0)

routine start() -> None
    Console.show("{read_after[S64](v0: 1234567)}")
    return
