# A stamp read where it is in the view of a shared read access gives a view that reads: the entity's value is read
# through it, and a write through the same link under exclusive access is fine.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### A link to a node, kept by stamp in the pool.
record Link
    target: Stamped[Node]

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

routine start() -> None
    pool: &PoolManager <- PoolManager.set_up(memory: PAGES)
    node: Stamped[Node] = PoolManager.add(Node.construct(value: 1))
    link: &Link <- Link(target: node)
    reading: ReadAuthorized[Link] <- link.get_shared_read_access()
    view: @Link = reading.getview()
    seen: @Node = view.target.peek().fetch()
    Console.show("read: {seen.value.peek()}")
    drop reading
    writing: Authorized[Link] <- link.get_exclusive_access()
    held: @Link = writing.getview()
    held.target.peek().fetch().value.poke(7)
    drop writing
    Console.show("after write: {node.fetch().value.peek()}")
    drop pool
    return
