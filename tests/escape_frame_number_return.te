# The address of a local turned into a number and back, and returned.

import Standard/Os

### The address of a local, through a U64.
### :returns: The address.
routine make() -> @S64
    local l: @S64 <- 1234567

    a: Addr = l
    n: U64 = ptrtoint[Addr, U64](a)
    return inttoptr[U64, Addr](n).to[@S64]()

routine start() -> None
    Console.show("{make().peek()}")
    return
