// B16's special functions, erf, erfc, gamma and ln_gamma: CORE-MATH ports, correctly rounded, so the same bits on
// every target. Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer is NaN, ln_gamma has +inf
// at 0 and the negative integers.

import Standard/Format
import Standard/Os

routine show(name: Bytes, v: B16) -> Void
    block entry()
        Out.write("{name} {v} {v.bits()}\n")
        return()

routine start() -> Void
    block entry()
        show(name: "erf(0.5)", v: B16.erf(0.5))
        show(name: "erf(-4)", v: B16.erf(-4.0))
        show(name: "erfc(3)", v: B16.erfc(3.0))
        show(name: "erfc(10)", v: B16.erfc(10.0))
        show(name: "erfc(-1)", v: B16.erfc(-1.0))
        show(name: "gamma(5)", v: B16.gamma(5.0))
        show(name: "gamma(0.5)", v: B16.gamma(0.5))
        show(name: "gamma(-2.5)", v: B16.gamma(-2.5))
        show(name: "gamma(35.5)", v: B16.gamma(35.5))
        show(name: "gamma(-0)", v: B16.gamma(-0.0))
        show(name: "gamma(-2)", v: B16.gamma(-2.0))
        show(name: "ln_gamma(1)", v: B16.ln_gamma(1.0))
        show(name: "ln_gamma(2)", v: B16.ln_gamma(2.0))
        show(name: "ln_gamma(0.5)", v: B16.ln_gamma(0.5))
        show(name: "ln_gamma(-2.5)", v: B16.ln_gamma(-2.5))
        show(name: "ln_gamma(100)", v: B16.ln_gamma(100.0))
        show(name: "ln_gamma(-3)", v: B16.ln_gamma(-3.0))
        return()
