# What the memory rules allow: a global that holds memory, changed with replace and given back in start's finish
# block, a copy of its own made with duplicate() and handed over on every pass of a loop, a slot dropped once, memory
# handed to a routine that takes it over, and a view used before a #reshaping call, then taken again after it.

import Standard/Collections
import Standard/Os

global CACHE: &[Byte]

### Takes `m` over and gives it back.
### :param m: The memory.
### :returns: How many bytes it held.
routine consume(m: Memory[Byte]) -> U64
    n: U64 = m.count()
    drop m
    return n

@reshaping(items)
routine grow(items: @List[S64]) -> None
    items.add_last(2)
    return

routine start() -> None
    out: @ConsoleOutput = Console.output()
    base: &[Byte] <- [b'\x41', b'\x42'] * 3 from HEAP
    xs: &List[S64] <- .construct(manager: HEAP)

    CACHE.replace(Memory[Byte].construct(count: 4, manager: HEAP))
    CACHE.replace(base.duplicate())

    each i: U64 in 0 til 3 with total: U64 = 0
        continue with total: total + consume(base.duplicate())
    then
        slot: &[Byte] <- steal base
        drop slot
        xs.add_last(1)
        first: @S64 = xs.getslot(0)
        before: S64 = first.peek()
        grow(xs)
        again: @S64 = xs.getslot(0)
        out.write("{total} {CACHE.count()} {before} {again.peek()} {xs.count()}\n")
        drop xs
        drop CACHE
        return
