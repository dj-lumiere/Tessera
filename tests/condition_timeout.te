# A SignalCaster on one thread, where nothing wakes it. A wait with a timeout gives up and says so (false), and only
# once the time is up: the loop that waits, as every waiter does, ends at the timeout. A deadline that has already
# passed returns false at once. A wake with nobody waiting is not kept for a later wait, which times out too. The
# access is held again after every wait.

import Hosted

preset TIMEOUT: Duration = 2ms

### Waits until `deadline`, again after every return before it (nothing changes the condition here, so any return
### before the deadline is one without a wake).
### :returns: Whether the last wait returned in time: false once the deadline has passed.
routine wait_out(cond: @SignalCaster, held: Authorized[U8], deadline: Duration) -> Bool
    loop
        in_time2: Bool = cond.wait_until(access: held, deadline)
        if in_time2
            continue
        else
            return in_time2

### Waits with wait_for for TIMEOUT from `start`, and on until then after every return before it.
### :returns: Whether the last wait returned in time: false once the time is up.
routine wait_for_out(cond: @SignalCaster, held: Authorized[U8], start: Duration) -> Bool
    in_time: Bool = cond.wait_for(access: held, timeout: TIMEOUT)
    if in_time
        return wait_out(cond, held, deadline: start + TIMEOUT)
    else
        return in_time

### Says whether the calling thread holds the access again, as the AccessManager lists it.
routine report_held() -> None
    held: U64 = AccessManager.held_count()
    Console.show("access held again: {held == 1}")
    return

routine start() -> None
    guard: &U8 <- 0
    cond: &SignalCaster <- .construct()

    held: Authorized[U8] <- guard.get_exclusive_access()
    start: Duration = Clock.monotonic()
    deadline: Duration = start + TIMEOUT
    in_time: Bool = wait_out(cond, held, deadline)
    elapsed: Duration = Clock.monotonic() - start
    Console.show("wait until 2 ms: in time {in_time}, waited the timeout {elapsed >= TIMEOUT}")
    report_held()
    late: Bool = cond.wait_until(access: held, deadline: start)
    Console.show("wait until a passed deadline: in time {late}")
    report_held()
    cond.cast_one()
    cond.cast_all()
    before: Duration = Clock.monotonic()
    timed: Bool = wait_for_out(cond, held, start: before)
    waited: Duration = Clock.monotonic() - before
    enough: Bool = waited >= TIMEOUT
    Console.show("wait for 2 ms after an earlier wake: in time {timed}, waited the timeout {enough}")
    report_held()
    drop held
    return
