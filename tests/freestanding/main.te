# A program for a target without an operating system: no C library, no Standard/Os. It brings its own crash
# handler and its entry, when_power_on: the reset lands there with the stack set, it readies the core and memory with
# prepare_core (.bss zeroed, .data copied where the code runs from flash, the FPU on), then does the board's part, and
# start runs after it. Its copies and fills reach the stdlib's memcpy and memset. CI builds it for each target
# without an OS, links it with the link script for that target here (<target>.ld, which defines the symbols the entry uses), and checks that nothing it
# needs is left undefined (see freestanding.arch: it never runs here).

import Standard/Alloc
import Standard/Boot

global CURRENT: @Frame
global PREVIOUS: @Frame
global TOTAL: @U32
global READINGS: @U64 <- 16

### A sensor reading, large enough that copying one is a memcpy.
record Frame
    samples: Array[U32, 64]
    count: U64

### Halts on a crash: there's nowhere to print and nothing to exit to.
@export("tessera_crash_handler")
@noreturn
routine halt(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    while true
        pass

### Records `n` readings, keeping the frame before them.
routine record_readings(n: U64) -> U32
    local total: @U32 <- 0

    PREVIOUS.copy(src: CURRENT, count: 1)
    CURRENT.zeroinit(1)

    each at in 0 til n
        reading: U32 = at.to[U32]() * 3
        CURRENT.samples[at] = reading
        (total.peek() + reading).poke_into(total)
    then
        return total.peek()

### The entry: the core and memory first, then what a board would set up (clocks, a serial port). This one only picks
### the number of readings.
routine when_power_on() -> None
    prepare_core()
    (READINGS.peek() + 0).poke_into(READINGS)
    return

### Records the readings and keeps their total.
routine start() -> None
    record_readings(READINGS.peek()).poke_into(TOTAL)
    return
