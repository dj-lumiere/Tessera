// A program for a target without an operating system: no C library, no Standard::Os. It brings its own crash
// handler, and its copies and fills reach the stdlib's memcpy and memset. CI builds it for arm-none-eabi and
// riscv32-none-elf and checks that nothing it needs is left undefined (see freestanding.arch: it never runs here).

import Standard::Alloc

global CURRENT: @Frame
global PREVIOUS: @Frame

/// A sensor reading, large enough that copying one is a memcpy.
record Frame
    samples : Array<U32, 64>
    count   : USize

/// Halts on a crash: there's nowhere to print and nothing to exit to.
#[export("tessera_crash_handler"), noreturn]
routine halt(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        jump spin()

    block spin()
        jump spin()

/// Records `n` readings, keeping the frame before them.
routine record_readings(n: USize) -> U32
    block entry()
        copy<Frame>(PREVIOUS, CURRENT, 1)
        CURRENT.zeroinit(1)
        jump fill(0, 0)

    block fill(at: USize, total: U32)
        done : Bool = at.ge(n)
        branch done
            ? return(total)
            : continue
        reading : U32 = at.to<U32>().mul(3)
        CURRENT.samples.setitem(at, reading)
        jump fill(at.add(1), total.add(reading))

routine main() -> S32
    block entry()
        total : U32 = record_readings(16)
        return(total.to<S32>())
