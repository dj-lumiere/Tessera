# A program for a target without an operating system: no C library, no Standard/Os. It brings its own crash
# handler and its board step (when_booted), the builder writes its entry (_start, which sets the stack, zeroes .bss,
# copies .data where the code runs from flash, turns the FPU on, then runs when_booted and start), and its copies and
# fills reach the stdlib's memcpy and memset. CI builds it for each target without an OS, links it with the link
# script for that target here (<target>.ld, which defines the symbols the entry uses), and checks that nothing it
# needs is left undefined (see freestanding.arch: it never runs here).

import Standard/Alloc

global CURRENT: @Frame
global PREVIOUS: @Frame
global TOTAL: @U32
global READINGS: @USize <- 16

### A sensor reading, large enough that copying one is a memcpy.
record Frame
    samples: Array[U32, 64]
    count: USize

### Halts on a crash: there's nowhere to print and nothing to exit to.
@export("tessera_crash_handler")
@noreturn
routine halt(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    while true
        pass

### Records `n` readings, keeping the frame before them.
routine record_readings(n: USize) -> U32
    local total: @U32 <- 0

    PREVIOUS.copy(src: CURRENT, count: 1)
    CURRENT.zeroinit(1)

    each at in 0 til n
        reading: U32 = at.to[U32]() * 3
        CURRENT.samples[at] = reading
        (total.peek() + reading).poke_into(total)
    then
        return total.peek()

### The board step: a board would set its clocks and serial port up here. This one only picks the number of readings.
routine when_booted() -> None
    (READINGS.peek() + 0).poke_into(READINGS)
    return

### Records the readings and keeps their total.
routine start() -> None
    record_readings(READINGS.peek()).poke_into(TOTAL)
    return
