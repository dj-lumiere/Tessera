// A Callable in a global's memory starts as a routine whose signature is the Callable's: one that takes something
// else is a build error naming the routines of that name.

global ON: @Callable<(S64,), S64> <- twice.to<Callable>()

routine twice(n: S32) -> S32
    block entry()
        return(n.mul(2))

routine start() -> Void
    block entry()
        return()
