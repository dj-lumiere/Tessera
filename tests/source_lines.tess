// #source on the line before a routine, a block, a statement, or a terminator names the place in a generator's input
// it came from. Debug information and build errors use it, and the program runs the same.

import Standard::Format
import Standard::Os

#source("count.mini", 1, 1)
routine count_down(n: S64) -> S64
    shared steps : @S64 <- 0

    block entry()
        #source("count.mini", 2, 5)
        jump loop(n)

    #source("count.mini", 3, 5)
    block loop(i: S64)
        #source("count.mini", 3, 11)
        done : Bool = i.le(0)
        #source("count.mini", 3, 5)
        branch done
            ? return(steps.load())
            : continue
        #source("count.mini", 4, 9)
        next : S64 = i.sub(1)
        #source("count.mini", 5, 9)
        steps.load().add(1).store_into(steps)
        jump loop(next)

routine main() -> S32
    block entry()
        #source("count.mini", 9, 5)
        Out.write("{count_down(5)}\n")
        return(0)
