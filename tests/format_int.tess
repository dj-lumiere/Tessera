// Integer formatting through FdWriter: decimal (signed for S types, unsigned for U types) and hex of the bits, for
// every width, including the extremes. The same bits read as the other type print both ways.

routine main() -> S32
    block entry():
        %out_val: FdWriter      = FdWriter.stdout()
        #out:     Ptr<FdWriter> = claim
        #out.store(%out_val)

        %s8_min: S8 = S8.MIN
        %s8_min.format(#out)
        write_str(#out, " ")
        U8.from_byte(%s8_min.bits()).format(#out)
        write_str(#out, " ")
        %s8_min.format_hex(#out)
        write_line(#out)

        %s16: S16 = -1234
        %s16.format(#out)
        write_str(#out, " ")
        U16.from_bits(%s16.bits()).format(#out)
        write_line(#out)

        %s32_max: S32 = S32.MAX
        %s32_max.format(#out)
        write_str(#out, " ")
        %s32_max.format_hex(#out)
        write_line(#out)

        %zero: S64 = 0
        %zero.format(#out)
        write_str(#out, " ")
        %zero.format_hex(#out)
        write_line(#out)

        %s64_min: S64 = S64.MIN
        %s64_min.format(#out)
        write_str(#out, " ")
        U64.from_bits(%s64_min.bits()).format(#out)
        write_line(#out)

        %u64_max: U64 = U64.MAX
        %u64_max.format(#out)
        write_str(#out, " ")
        %u64_max.format_hex(#out)
        write_line(#out)

        %s128_min: S128 = S128.MIN
        %s128_min.format(#out)
        write_line(#out)

        %s128_max: S128 = S128.MAX
        %s128_max.format(#out)
        write_str(#out, " ")
        %s128_max.format_hex(#out)
        write_line(#out)

        %u128_max: U128 = U128.MAX
        %u128_max.format(#out)
        write_line(#out)

        // a chunk boundary: 10^19 has a zero-padded low chunk
        %ten_19: U128 = 10000000000000000000
        %ten_19.format(#out)
        write_str(#out, " ")
        %ten_19.format_hex(#out)
        write_line(#out)

        // three chunks, the middle and low ones all padding
        %three_chunks: S128 = 100000000000000000000000000000000000005
        %three_chunks.format(#out)
        write_line(#out)

        %flag: Bool = true
        %flag.format(#out)
        write_str(#out, " ")
        %text: String = "done"
        %text.format(#out)
        write_line(#out)

        %failed: Bool = #out.has_failed()
        %code: S32 = %failed ? 1 : 0
        return(%code)
