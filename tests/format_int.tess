// Integer formatting through FdWriter: decimal (signed for S types, unsigned for U types) and hex of the bits, for
// every width, including the extremes. The same bits read as the other type print both ways.

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry()
        claim out : @FdWriter <- .stdout()

        s8_min : S8 = S8.MIN
        out.write("{s8_min} {U8.from_byte(s8_min.bits())} ")
        s8_min.represent_hex(out)
        out.write("\n")

        s16 : S16 = -1234
        out.write("{s16} {s16.to_wrap<U16>()}\n")

        s32_max : S32 = S32.MAX
        out.write("{s32_max} ")
        s32_max.represent_hex(out)
        out.write("\n")

        zero : S64 = 0
        out.write("{zero} ")
        zero.represent_hex(out)
        out.write("\n")

        s64_min : S64 = S64.MIN
        out.write("{s64_min} {s64_min.to_wrap<U64>()}\n")

        u64_max : U64 = U64.MAX
        out.write("{u64_max} ")
        u64_max.represent_hex(out)
        out.write("\n")

        s128_min : S128 = S128.MIN
        out.write("{s128_min}\n")

        s128_max : S128 = S128.MAX
        out.write("{s128_max} ")
        s128_max.represent_hex(out)
        out.write("\n")

        u128_max : U128 = U128.MAX
        out.write("{u128_max}\n")

        // a chunk boundary: 10^19 has a zero-padded low chunk
        ten_19 : U128 = 10000000000000000000
        out.write("{ten_19} ")
        ten_19.represent_hex(out)
        out.write("\n")

        // three chunks, the middle and low ones all padding
        three_chunks : S128 = 100000000000000000000000000000000000005
        out.write("{three_chunks}\n")

        flag : Bool = true
        out.write("{flag} ")
        text : Bytes = "done"
        out.write("{text}\n")

        failed : Bool = out.load().has_failed()
        code   : S32  = failed
            ? 1
            : 0
        return(code)
