// Integer formatting through FdWriter: decimal (signed for S types, unsigned for U types) and hex of the bits, for
// every width, including the extremes. The same bits read as the other type print both ways.

import Standard::Format

routine main() -> S32
    block entry():
        out_val : FdWriter = .stdout()
        claim out : Ptr<FdWriter>
        out.store(out_val)

        s8_min : S8 = S8.MIN
        write(out, "{s8_min} {U8.from_byte(s8_min.bits())} ")
        s8_min.represent_hex(out)
        write(out, "\n")

        s16 : S16 = -1234
        write(out, "{s16} {s16.to_u16_wrap()}\n")

        s32_max : S32 = S32.MAX
        write(out, "{s32_max} ")
        s32_max.represent_hex(out)
        write(out, "\n")

        zero : S64 = 0
        write(out, "{zero} ")
        zero.represent_hex(out)
        write(out, "\n")

        s64_min : S64 = S64.MIN
        write(out, "{s64_min} {s64_min.to_u64_wrap()}\n")

        u64_max : U64 = U64.MAX
        write(out, "{u64_max} ")
        u64_max.represent_hex(out)
        write(out, "\n")

        s128_min : S128 = S128.MIN
        write(out, "{s128_min}\n")

        s128_max : S128 = S128.MAX
        write(out, "{s128_max} ")
        s128_max.represent_hex(out)
        write(out, "\n")

        u128_max : U128 = U128.MAX
        write(out, "{u128_max}\n")

        // a chunk boundary: 10^19 has a zero-padded low chunk
        ten_19 : U128 = 10000000000000000000
        write(out, "{ten_19} ")
        ten_19.represent_hex(out)
        write(out, "\n")

        // three chunks, the middle and low ones all padding
        three_chunks : S128 = 100000000000000000000000000000000000005
        write(out, "{three_chunks}\n")

        flag : Bool = true
        write(out, "{flag} ")
        text : String = "done"
        write(out, "{text}\n")

        failed : Bool = out.has_failed()
        code   : S32  = failed ? 1 : 0
        return(code)
