### Optional[T] is Equatable only when T is: `obeys Equatable[Optional[T]] when T obeys Equatable`.
record Point
    x: S64

routine same[T](a: T, b: T) -> Bool
needs T obeys Equatable
    return a == b

routine start() -> None
    p: Optional[Point] = None()
    s: Bool = same(a: p, b: p)
    return
