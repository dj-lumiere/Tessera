# steal out of an element at an index that is not a constant, with no inject, doesn't build: another index with the
# same value (j = i) reaches the same place, and the builder can't follow that, so a read through it would find the
# place hollow.

import Hosted

### A counter.
entity Counter
    n: S64

### Makes one.
### :param n: The count.
### :returns: The new value.
common routine Counter.construct(n: S64) -> Me
    return Me(n: n)

### Ends it.
routine @Counter.destruct() -> None
    return

routine start() -> None
    a: &Slots[Counter, 2] <- [Counter.construct(n: 1), Counter.construct(n: 2)]
    i: U64 = 0
    steal a.getslot(i) as taken
    Console.show(taken.n.peek())
    j: U64 = i
    Console.show(a.getslot(j).n.peek())
    drop taken
    return
