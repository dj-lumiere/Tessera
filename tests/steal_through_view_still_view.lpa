# A view taken of an entity is still a view of it after the entity is handed on: once it is handed on, that view
# reads memory the entity's new holder may give back, which is a build error.

import Hosted

### A node with two children.
entity Node
    value: S64
    left: Node?
    right: Node?

### A node with no children.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value, left: None(), right: None())

### Hands a node on, then reads it through a view taken before.
### :param keeper: Where the node goes.
routine move(keeper: @Node) -> None
    taken: &Node <- Node.construct(value: 2) from HEAP
    seen: @Node = taken.getview()
    keeper.right <- steal taken
    Console.show("{seen.value.peek()}")
    return

### Runs the move.
routine start() -> None
    keeper: &Node <- Node.construct(value: 9) from HEAP
    move(keeper)
    drop keeper
    return
