# A stamp is a way to change an entity, so it is read where it is in the view of a shared read access, never copied out
# of it.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### A link to a node, kept by stamp.
record Link
    target: Stamped[Node]

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

routine start() -> None
    PoolManager.set_up(memory: HEAP)
    node: &Node <- Node.construct(value: 1) from HEAP
    link: &Link <- Link(target: node.stamp())
    reading: ReadAuthorized[Link] <- link.get_shared_read_access()
    view: @Link = reading.getview()
    copy: Link = view.peek()
    copy.target.fetch().value.poke(5)
    drop reading
    drop node
    return
