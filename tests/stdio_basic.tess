// Standard::Os console streams. Out: bytes written as they are (here to a pipe, so no "\r\n" added and the UTF-8
// unchanged), a character split across two writes too, and a pipe isn't a terminal. In, fed stdio_basic.input
// through one shared buffer: lines (a "\r\n" one, and a last one with no "\n"), words, a count of bytes, the rest.

import Standard::Alloc
import Standard::Format
import Standard::Os

routine show(what: Bytes, line: Option<Bytes>) -> Void
    block entry()
        when line
            .Present(text) -> present(text)
            .Absent        -> absent()

    block present(text: Bytes)
        Out.write("{what}: [{text}]\n")
        return()

    block absent()
        Out.write("{what}: none\n")
        return()

routine main() -> S32
    block entry()
        text : Bytes = "standard output: 한글\n"
        Out.write_all(text.data, text.length())
        han : Bytes = "한"
        Out.write_all(han.data, 1)
        Out.write_all(han.data.stride(1), 2)
        Out.write("\n")
        Out.write("output is a terminal: {Out.is_terminal()}, input: {In.is_terminal()}\n")
        claim alloc : @Allocator <- make_heap_allocator()
        show("line", In.read_line(alloc))
        show("line", In.read_line(alloc))
        show("word", In.read_word(alloc))
        show("word", In.read_word(alloc))
        three : Bytes = In.read_count(3, alloc)
        Out.write("count 3: [{three}]\n")
        show("line", In.read_line(alloc))
        rest : Bytes = In.read_all(alloc)
        Out.write("all: [{rest}]\n")
        show("line at the end", In.read_line(alloc))
        show("word at the end", In.read_word(alloc))
        return(0)
