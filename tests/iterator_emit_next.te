# An iterator hands out values with emit and, over elements in memory, their slots with next, and `try` in front of
# either gives None past the end. A bare emit past the end stops with AbsentValueError at the caller's line.

import Collections
import Hosted

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the crash and whether it names this file's line, on stdout, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@untraced
routine on_crash(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    file: @[Byte] = place.file.peek()
    here: Bool = file.has_suffix("iterator_emit_next.te")
    Console.show("crashed: {name} at this file {here}, line {place.line.peek()}")
    exit(3)

routine start() -> None
    list: &List[S64] <- .construct(HEAP)
    slots: &ListIter[S64] <- .hollow()
    values: &ListIter[S64] <- .hollow()

    Crash.report_with(on_crash.to[Callable]())
    list.add_last(1)
    list.add_last(2)
    list.add_last(3)
    ListIter[S64].construct(list).poke_into(slots)

    loop
        slot: Maybe[@S64] = try slots.next()
        when slot
            is @S64 as p =>
                (p.peek() * 2).poke_into(p)
                continue
            is None => break
    ListIter[S64].construct(list).poke_into(values)
    first: S64 = values.emit()
    rest: Maybe[S64] = try values.emit()
    Console.show("{first} {rest.diagnose()} {values.next().peek()}")
    last: Maybe[S64] = try values.emit()
    Console.show("{last.diagnose()}")
    past: S64 = values.emit()
    Console.show("not reached {past}")
    drop list
    return
