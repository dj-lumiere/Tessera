// xoshiro256** (Standard/Random) against a Python model of the reference C code: the reference's own start state
// (1, 2, 3, 4, whose first outputs are 11520, 0, 1509978240, 1215971899390074240), then three seeds through the
// splitmix64 chain, each draw kind, Lemire's bounded draw, and a checksum of 100000 more draws. The model also
// reproduces RazorForge's Random streams, which this file's routines now compute.

import Standard/Format
import Standard/Os
import Standard/Random

/// Writes a U64 as 16 hex digits.
routine hex(value: U64) -> Void
    value.represent_hex_into(out: Out.writer(), min_digits: 16)
    return

/// Writes `count` 64-bit draws, a space before each.
routine draws(rng: @Xoshiro256, count: USize) -> Void
    each i in 0 til count
        Out.write(" ")
        hex(rng.next())
    then
        return

/// Writes four draws of each kind and the bounded draws from a seed.
routine seeded(seed: U64) -> Void
    local rng: @Xoshiro256 <- .from_seed(seed)
    local h: @U64 <- .hollow()

    state: Xoshiro256 = rng.peek()
    Out.write("seed ")
    hex(seed)
    Out.write(" state: ")
    hex(state.s0)
    Out.write(" ")
    hex(state.s1)
    Out.write(" ")
    hex(state.s2)
    Out.write(" ")
    hex(state.s3)
    Out.write("\nseed ")
    hex(seed)
    Out.write(" u64:")
    draws(rng, count: 4)
    Out.write("\nseed ")
    hex(seed)
    Out.write(" u32:")

    each i in 0 til 4
        Out.write(" ")
        value: U64 = rng.next_u32().to[U64]()
        value.represent_hex_into(out: Out.writer(), min_digits: 8)
    then
        while i2 < 5 with i2: USize = 0
            if i2 == 0
                Out.write("\nseed ")
                hex(seed)
                Out.write(" b64:")
                continue with i2: 1
            Out.write(" ")
            hex(rng.next_b64().bits())
            continue with i2: i2 + 1
        Out.write("\nseed ")
        hex(seed)
        Out.write(" below 6:")

        while true with i2: USize = 0, bound: U64 = 6, count: USize = 12
            if i2 >= count
                when
                    bound == 6 =>
                        Out.write("\nseed ")
                        hex(seed)
                        Out.write(" below 2^63+1:")
                        continue with i2: 0, bound: U64.shl(1, 63) + 1, count: 4
                    bound == 1 => break
                    else =>
                        Out.write("\nseed ")
                        hex(seed)
                        Out.write(" below 1:")
                        continue with i2: 0, bound: 1, count: 3
            Out.write(" {rng.below(bound)}")
            continue with i2: i2 + 1, bound: bound, count: count
        Out.write("\nseed ")
        hex(seed)
        Out.write(" 100000 more: ")
        14695981039346656037.poke_into(h)

        each i2 in 0 til 100000
            mixed: U64 = (h.peek() ^ rng.next()) *% 1099511628211
            mixed.poke_into(h)
        hex(h.peek())
        Out.write("\n")
        return

    while i < 5 with i: USize = 0
        if i == 0
            Out.write("\nseed ")
            hex(seed)
            Out.write(" b64:")
            continue with i: 1
        Out.write(" ")
        hex(rng.next_b64().bits())
        continue with i: i + 1
    Out.write("\nseed ")
    hex(seed)
    Out.write(" below 6:")

    while true with i: USize = 0, bound: U64 = 6, count: USize = 12
        if i >= count
            when
                bound == 6 =>
                    Out.write("\nseed ")
                    hex(seed)
                    Out.write(" below 2^63+1:")
                    continue with i: 0, bound: U64.shl(1, 63) + 1, count: 4
                bound == 1 => break
                else =>
                    Out.write("\nseed ")
                    hex(seed)
                    Out.write(" below 1:")
                    continue with i: 0, bound: 1, count: 3
        Out.write(" {rng.below(bound)}")
        continue with i: i + 1, bound: bound, count: count
    Out.write("\nseed ")
    hex(seed)
    Out.write(" 100000 more: ")
    14695981039346656037.poke_into(h)

    each i in 0 til 100000
        mixed: U64 = (h.peek() ^ rng.next()) *% 1099511628211
        mixed.poke_into(h)
    hex(h.peek())
    Out.write("\n")
    return

routine start() -> Void
    local reference: @Xoshiro256 <- .from_state(s0: 1, s1: 2, s2: 3, s3: 4)

    Out.write("state 1 2 3 4:")
    draws(rng: reference, count: 6)
    Out.write("\n")
    seeded(0)
    seeded(12345)
    seeded(U64.MAX)
    top: U64 = U64.MAX
    bottom: U64 = 0
    Out.write("unit 0: ")
    hex(unit_b64(bottom).bits())
    Out.write(", unit max: ")
    hex(unit_b64(top).bits())
    Out.write("\n")
    local first: @Xoshiro256 <- .from_entropy()
    local second: @Xoshiro256 <- .from_entropy()
    differ: Bool = first.next() != second.next()
    Out.write("two entropy seeds differ: {differ}\n")
    return
