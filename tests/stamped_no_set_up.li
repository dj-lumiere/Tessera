# Stamped: the PoolManager is a service the program sets up in start. A stamp before PoolManager.set_up stops the
# program and says what to call.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### Stamps a node with no PoolManager set up.
routine start() -> None
    a: &Node <- Node.construct(value: 1) from HEAP
    s: Stamped[Node] = a.stamp()
    Console.show("stamped: {s === s}")
    drop a
    return
