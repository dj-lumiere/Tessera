// An overload set is one module's: the file's own module has an `area`, so the imported ones aren't in the set
// (write Geometry::area to reach them).
import Geometry

routine area(text: Bytes) -> S64
    block entry()
        return(0)

routine main() -> S32
    block entry()
        side : S64 = 3
        a    : S64 = area(side)
        return(0)
