// The head's shared lines run once when the routine starts, before entry: a value and a slot every block sees
// without passing them along. `jump entry()` runs entry again, never the head, so the counter shows one call.

import Standard/Format
import Standard/Os

global CALLS: @S64 <- 0

routine next_call() -> S64
    n: S64 = CALLS.peek().add(1)
    n.poke_into(CALLS)
    return(n)

routine sum_to(limit: S64) -> S64
    local first: S64 = next_call()
    local total: @S64 <- 0
    local step: @S64 <- .hollow()

    block entry()
        first.poke_into(step)
        sum: S64 = total.peek().add(step.peek())
        sum.poke_into(total)
        branch sum.ge(limit)
            ? done()
            : entry()

    block done()
        return(total.peek())

// The values the head shares reach every block, with the routine's parameters, and claims there are slots of their own.
routine scale(values: @Array[S64, 4], factor: S64) -> S64
    local count: USize = 4
    local sum: @S64 <- 0

    jump add(0)

    block add(i: USize)
        branch i.lt(count)
            ? one(i)
            : return(sum.peek())

    block one(i: USize)
        value: S64 = values.getitem(i)
        grown: S64 = sum.peek().add(value.mul(factor))
        grown.poke_into(sum)
        jump add(i.add(1))

routine start() -> Void
    claim values: @Array[S64, 4] <- [1, 2, 3, 4]
    total: S64 = sum_to(5)
    Out.write("total {total}, calls {CALLS.peek()}\n")
    scaled: S64 = scale(values, factor: 3)
    Out.write("scaled {scaled}\n")
    return()
