# A Memory[T] from construct(count, manager) is memory from a manager: an address, a count, and the manager. drop()
# gives the memory back to that manager, destruct_all() destructs the values first, resize
# reallocates, and check receives the failure instead of the program stopping. A counting manager shows every block coming
# back, and a refusing one the failures.

import Standard/Collections
import Standard/Os

record Counts
    live: S64
    calls: S64

# A memory manager that refuses everything.
record Refusing
    nothing

obeys MemoryManageable[Counts]
obeys MemoryManageable[Refusing]

routine bump(place: @S64, by: S64) -> None
    next: S64 = place.peek() + by
    place.poke(next)
    return

routine @Counts.borrow(size: U64, align: U64) -> Addr
    bump(place: me.live, by: 1)
    bump(place: me.calls, by: 1)
    return HEAP.borrow(size, align)

@reshaping(at)
routine @Counts.reborrow(at: Addr, size: U64, align: U64) -> Addr
    bump(place: me.calls, by: 1)
    if at.is_hollow()
        bump(place: me.live, by: 1)
    return HEAP.reborrow(at, size, align)

routine @Counts.give_back(at: Addr) -> None
    bump(place: me.live, by: -1)
    HEAP.give_back(at)
    return

routine @Refusing.borrow(size: U64, align: U64) -> Addr
    return .hollow()

routine @Refusing.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return .hollow()

routine @Refusing.give_back(at: Addr) -> None
    HEAP.give_back(at)
    return

routine show(label: @[Byte], counts: @Counts) -> None
    Console.show("{label}: live {counts.live.peek()}, memory manager calls {counts.calls.peek()}")
    return

### Reading and writing through both receivers, and resizing.
routine values(counts: @Counts, manager: @MemoryManager) -> None
    local managed: @Memory[S64] <- .construct(count: 3, manager: manager)

    managed[0].store(10)
    managed[1].store(20)
    managed.getview(2).poke(30)
    copy: @[S64] = managed.getslice()
    Console.show("count {managed.count()} and {copy.count()}, values {managed[0].load()} {copy.getitem(1)} {managed.getview(2).peek()}")
    Console.show("getitem_checked(2) {try copy.getitem(2)}, getitem_checked(3) {try copy.getitem(3)}")
    tail: @[S64] = managed.getslice(start: 1, count: 2)
    Console.show("getslice(1, 2): {tail.getitem(0)} {tail.getitem(1)}, first by address {managed.to[@S64]().peek()}")
    managed.resize(5)
    managed[4].store(50)
    Console.show("after resize(5): count {managed.count()}, kept {managed[2].load()}, new {managed[4].load()}")
    show(label: "  one block", counts)
    managed.resize(0)
    Console.show("after resize(0): count {managed.count()}")
    show(label: "  given back", counts)
    drop managed
    return

### A count of 0 allocates nothing, and its drop gives nothing back.
routine empty(counts: @Counts, manager: @MemoryManager) -> None
    local empty_memory: @Memory[U8] <- .construct(count: 0, manager: manager)

    Console.show("empty: count {empty_memory.count()}, getitem_checked(0) {try empty_memory.getslice().getitem(0)}")
    drop empty_memory
    show(label: "  after the drop", counts)
    return

### destruct_all releases what each value owns, then the memory itself.
routine nested(counts: @Counts, manager: @MemoryManager) -> None
    local rows: @Memory[List[S64]] <- .construct(count: 2, manager: manager)

    rows[0].store(List[S64].construct(manager))
    rows[1].store(List[S64].construct(manager))
    rows.getview(0).add_last(1)
    rows.getview(1).add_last(2)
    rows.getview(1).add_last(3)
    Console.show("rows: {rows.getview(0)} {rows.getview(1)}")
    show(label: "  three blocks", counts)
    rows.destruct_all()
    show(label: "  after destruct_all", counts)
    return

### Text in a Memory[Byte].
routine text(manager: @MemoryManager) -> None
    local bytes: @Memory[Byte] <- .construct(count: 2, manager: manager)

    bytes[0].store(b'o')
    bytes[1].store(b'k')
    copy: @[Byte] = bytes.getslice()
    Console.show("text: {bytes.getslice()} {copy.getview().count()}")
    drop bytes
    return

### The failable forms, received with check, against a memory manager that refuses everything.
routine refused() -> None
    local refusing: @Refusing <- .hollow()
    local manager: @MemoryManager <- refusing.to[MemoryManager]()

    when check Memory[U8].construct(count: 4, manager: manager)
        is Memory[U8] as made =>
            Console.show("construct_result: failed false")
            drop made
        is MemoryAllocationError as failure => Console.show("construct_result: failed true, {failure}")
    local none: @Memory[U8] <- .construct(count: 0, manager: manager)
    resized: Bool = try none.resize(4)
    Console.show("resize_result: {resized}, count still {none.count()}")
    drop none
    drop manager
    return

routine start() -> None
    local counts: @Counts <- (live: 0, calls: 0)
    local manager: @MemoryManager <- counts.to[MemoryManager]()

    values(counts, manager)
    empty(counts, manager)
    nested(counts, manager)
    text(manager)
    show(label: "in the end", counts)
    refused()
    drop manager
    return
