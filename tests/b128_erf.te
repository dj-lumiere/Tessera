# B128 erf and erfc, correctly rounded (Standard/B128Erf.te): each input with its result's value and bits,
# the tier that decided it (fast: B128Extended passed the band test, exact: B128Big), and whether the exact tier
# alone gives the same bits. Every result was checked against mpmath at 2000 bits, rounded once. The "near"
# inputs put the result within 2^-165 to 2^-229 of a rounding boundary (see the header of b128_erf.te). At
# erf(8.7334...) just below B128_ERF_ONE and erfc(-8.6939...) the fast tier alone would round the wrong way.

import Standard/Format
import Standard/Os

### One input's result, with the tier that decided it and the exact tier's result to compare.
record Outcome
    name: Span[Byte]  # the function, erf or erfc
    label: Span[Byte]  # what kind of input it is
    x: B128  # the input
    value: B128  # the function's result
    exact: B128  # the exact tier's result alone
    tier: Span[Byte]  # the tier that decided the result

### Makes a `Outcome` from its fields.
### :param name: Its `name`.
### :param label: Its `label`.
### :param x: Its `x`.
### :param value: Its `value`.
### :param exact: Its `exact`.
### :param tier: Its `tier`.
### :returns: The new value.
routine Outcome.construct(name: Span[Byte], label: Span[Byte], x: B128, value: B128, exact: B128,
    tier: Span[Byte]) -> Me
    return Me(name, label, x, value, exact, tier)

### Releases the memory its `name` and `label` and `tier` hold.
routine Outcome.destruct(me: @Me) -> None
    me.name.destruct()
    me.label.destruct()
    me.tier.destruct()
    return

### Which tier decides erf x: "fast" when the B128Extended value passes the band test, else "exact".
routine erf_tier(x: B128) -> Span[Byte]
    a: B128 = x.abs()
    zero: Bool = b128_is_zero_bits(x.bits())
    if a < B128_ERF_ONE and not zero
        return band(wide_erf(a))
    else
        return "special"

routine erfc_tier(x: B128) -> Span[Byte]
    zero: Bool = b128_is_zero_bits(x.bits())
    between_bounds: Bool = x < B128_ERFC_ZERO and x > B128_ERFC_TWO.neg()
    if between_bounds and not zero
        return band(wide_erfc(x))
    else
        return "special"

routine band(w: B128Extended) -> Span[Byte]
    ok: Bool = wide_round_within(u: w, k: B128_ERF_BAND).ok
    r: Span[Byte] = when
        ok => "fast"
        else => "exact"
    return r

routine erf_case(out: @Out, label: Span[Byte], x: B128) -> None
    outcome: Outcome = (name: "erf", label: label, x: x, value: x.erf(), exact: b128_erf(x, exact: true), tier: erf_tier(x))
    report(out, o: outcome)
    return

routine erfc_case(out: @Out, label: Span[Byte], x: B128) -> None
    outcome: Outcome = (name: "erfc", label: label, x: x, value: x.erfc(), exact: b128_erfc(x, exact: true), tier: erfc_tier(x))
    report(out, o: outcome)
    return

routine report(out: @Out, o: Outcome) -> None
    same: Bool = o.value.bits() == o.exact.bits()
    out.write("{o.name}({o.x}) {o.label}: {o.value} ")
    o.value.bits().represent_hex_into(out)
    out.write(" {o.tier}, exact tier agrees: {same}\n")
    return

routine start() -> None
    out: @Out = Out.writer()

    erf_case(out, label: "special", x: b128_of(0x00000000000000000000000000000000))
    erf_case(out, label: "special", x: b128_of(0x80000000000000000000000000000000))
    erf_case(out, label: "special", x: b128_of(0x7FFF0000000000000000000000000000))
    erf_case(out, label: "special", x: b128_of(0xFFFF0000000000000000000000000000))
    erf_case(out, label: "special", x: b128_of(0x7FFF8000000000000000000000000000))
    erf_case(out, label: "special", x: b128_of(0x7FFF0000000000000000000000000001))
    erf_case(out, label: "special", x: b128_of(0xFFFF8000000000000000000000000005))
    erf_case(out, label: "special", x: b128_of(0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
    erf_case(out, label: "special", x: b128_of(0xFFFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
    erfc_case(out, label: "special", x: b128_of(0x00000000000000000000000000000000))
    erfc_case(out, label: "special", x: b128_of(0x80000000000000000000000000000000))
    erfc_case(out, label: "special", x: b128_of(0x7FFF0000000000000000000000000000))
    erfc_case(out, label: "special", x: b128_of(0xFFFF0000000000000000000000000000))
    erfc_case(out, label: "special", x: b128_of(0x7FFF0000000000000000000000000001))
    erfc_case(out, label: "special", x: b128_of(0x7FFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
    erfc_case(out, label: "special", x: b128_of(0xFFFEFFFFFFFFFFFFFFFFFFFFFFFFFFFF))
    erf_case(out, label: "plain", x: b128_of(0x00000000000000000000000000000001))
    erf_case(out, label: "plain", x: b128_of(0x80000000000000000000000000000001))
    erf_case(out, label: "plain", x: b128_of(0x0C17387AE70C9E700B8049732D11A23D))
