# The kind comes before the name on a needs line: the old `T: typename` is a build error that names the line to write.
import Hosted

### The value given.
### :typeparam T: The value's type.
### :param x: The value.
### :returns: x.
routine same[T](x: T) -> T
needs T: typename
    return x

routine start() -> None
    Console.show("{same(1)}")
    return
