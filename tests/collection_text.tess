// Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
// {key: value} for maps. A PriorityQueue writes its heap array, the top first, as [priority: element].

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> Void
    block entry()
        claim alloc: @MemoryManager <- make_heap_memory()

        claim list: @List[Bytes] <- .construct(alloc)
        list.add_last("a")
        list.add_last("b\n")
        list_loaded: List[Bytes] = list.peek()
        Out.write("{list_loaded} ")
        list_loaded.diagnose_into(Out.writer())
        Out.write("\n")

        empty_val: List[S64] = .construct(alloc)
        Out.write("{empty_val} ")
        empty_val.diagnose_into(Out.writer())
        Out.write("\n")

        claim sorted: @SortedList[S64] <- .construct(alloc)
        sorted.add(3)
        sorted.add(1)
        sorted.add(2)
        Out.write("{sorted.peek()}\n")

        claim ring: @CircularList[Char] <- .construct(alloc)
        ring.add_last('b')
        ring.add_first('a')
        ring_loaded: CircularList[Char] = ring.peek()
        Out.write("{ring_loaded} ")
        ring_loaded.diagnose_into(Out.writer())
        Out.write("\n")

        claim set: @Set[S64] <- .construct(alloc)
        set.add(7)
        set.add(5)
        Out.write("{set.peek()}\n")

        claim tree: @SortedSet[Bytes] <- .construct(alloc)
        tree.add("pear")
        tree.add("apple")
        tree_loaded: SortedSet[Bytes] = tree.peek()
        Out.write("{tree_loaded} ")
        tree_loaded.diagnose_into(Out.writer())
        Out.write("\n")

        claim map: @Dict[Bytes, S64] <- .construct(alloc)
        map.setitem("one", 1)
        map.setitem("two", 2)
        map_loaded: Dict[Bytes, S64] = map.peek()
        Out.write("{map_loaded} ")
        map_loaded.diagnose_into(Out.writer())
        Out.write("\n")

        claim index: @SortedDict[S64, Option[S64]] <- .construct(alloc)
        index.setitem(2, .Absent)
        index.setitem(1, .Present(10))
        index_loaded: SortedDict[S64, Option[S64]] = index.peek()
        index_loaded.diagnose_into(Out.writer())
        Out.write("\n")

        claim queue: @PriorityQueue[S64, Bytes] <- .construct(alloc)
        queue.add(2, "b")
        queue.add(1, "a")
        queue_loaded: PriorityQueue[S64, Bytes] = queue.peek()
        Out.write("{queue_loaded}\n")
        queue_loaded.diagnose_into(Out.writer())
        Out.write("\n")

        list.destruct()
        sorted.destruct()
        ring.destruct()
        set.destruct()
        tree.destruct()
        map.destruct()
        index.destruct()
        queue.destruct()
        return()
