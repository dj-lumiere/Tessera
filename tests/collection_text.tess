// Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
// {key: value} for maps. A PriorityQueue writes its heap array, the top first.

import Standard::Alloc
import Standard::Collections
import Standard::Format

@derive(Represent, Diagnose)
record Job
conform Priority<Job>
    rank : S64
    name : String

routine Job.less(%a: Self, %b: Self) -> Bool
    block entry():
        %r : Bool = %a.rank.lt(%b.rank)
        return(%r)

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)

        %list_val : List<String> = .construct(%alloc)
        claim %list : Ptr<List<String>>
        %list.store(%list_val)
        %list.push("a")
        %list.push("b\n")
        %list_loaded : List<String> = %list.load()
        print("{%list_loaded} ")
        %list_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        %empty_val : List<S64> = .construct(%alloc)
        print("{%empty_val} ")
        %empty_val.diagnose(StdoutWriter.shared())
        print("\n")

        %sorted_val : SortedList<S64> = .construct(%alloc)
        claim %sorted : Ptr<SortedList<S64>>
        %sorted.store(%sorted_val)
        %sorted.push(3)
        %sorted.push(1)
        %sorted.push(2)
        print("{%sorted.load()}\n")

        %ring_val : CircularList<Char> = .construct(%alloc)
        claim %ring : Ptr<CircularList<Char>>
        %ring.store(%ring_val)
        %ring.push_back('b')
        %ring.push_front('a')
        %ring_loaded : CircularList<Char> = %ring.load()
        print("{%ring_loaded} ")
        %ring_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        %set_val : Set<S64> = .construct(%alloc)
        claim %set : Ptr<Set<S64>>
        %set.store(%set_val)
        %set.add(7)
        %set.add(5)
        print("{%set.load()}\n")

        %tree_val : SortedSet<String> = .construct(%alloc)
        claim %tree : Ptr<SortedSet<String>>
        %tree.store(%tree_val)
        %tree.add("pear")
        %tree.add("apple")
        %tree_loaded : SortedSet<String> = %tree.load()
        print("{%tree_loaded} ")
        %tree_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        %map_val : Dict<String, S64> = .construct(%alloc)
        claim %map : Ptr<Dict<String, S64>>
        %map.store(%map_val)
        %map.put("one", 1)
        %map.put("two", 2)
        %map_loaded : Dict<String, S64> = %map.load()
        print("{%map_loaded} ")
        %map_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        %index_val : SortedDict<S64, Option<S64>> = .construct(%alloc)
        claim %index : Ptr<SortedDict<S64, Option<S64>>>
        %index.store(%index_val)
        %index.put(2, .Absent)
        %index.put(1, .Present(10))
        %index_loaded : SortedDict<S64, Option<S64>> = %index.load()
        %index_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        %queue_val : PriorityQueue<Job> = .construct(%alloc)
        claim %queue : Ptr<PriorityQueue<Job>>
        %queue.store(%queue_val)
        %queue.push(Job { rank: 2, name: "b" })
        %queue.push(Job { rank: 1, name: "a" })
        %queue_loaded : PriorityQueue<Job> = %queue.load()
        print("{%queue_loaded}\n")
        %queue_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        %list.destruct()
        %sorted.destruct()
        %ring.destruct()
        %set.destruct()
        %tree.destruct()
        %map.destruct()
        %index.destruct()
        %queue.destruct()
        return(0)
