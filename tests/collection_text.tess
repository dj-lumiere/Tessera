// Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
// {key: value} for maps. A PriorityQueue writes its heap array, the top first.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

#derive(Represent, Diagnose)
record Job
conform Priority<Job>
    rank : S64
    name : Bytes

routine Job.less(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = self.rank.lt(other.rank)
        return(r)

routine main() -> S32
    block entry():
        claim alloc : @Allocator <- make_heap_allocator()

        claim list : @List<Bytes> <- .construct(alloc)
        list.push("a")
        list.push("b\n")
        list_loaded : List<Bytes> = list.load()
        print("{list_loaded} ")
        list_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        empty_val : List<S64> = .construct(alloc)
        print("{empty_val} ")
        empty_val.diagnose(StdoutWriter.shared())
        print("\n")

        claim sorted : @SortedList<S64> <- .construct(alloc)
        sorted.push(3)
        sorted.push(1)
        sorted.push(2)
        print("{sorted.load()}\n")

        claim ring : @CircularList<Char> <- .construct(alloc)
        ring.push_back('b')
        ring.push_front('a')
        ring_loaded : CircularList<Char> = ring.load()
        print("{ring_loaded} ")
        ring_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        claim set : @Set<S64> <- .construct(alloc)
        set.add(7)
        set.add(5)
        print("{set.load()}\n")

        claim tree : @SortedSet<Bytes> <- .construct(alloc)
        tree.add("pear")
        tree.add("apple")
        tree_loaded : SortedSet<Bytes> = tree.load()
        print("{tree_loaded} ")
        tree_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        claim map : @Dict<Bytes, S64> <- .construct(alloc)
        map.put("one", 1)
        map.put("two", 2)
        map_loaded : Dict<Bytes, S64> = map.load()
        print("{map_loaded} ")
        map_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        claim index : @SortedDict<S64, Option<S64>> <- .construct(alloc)
        index.put(2, .Absent)
        index.put(1, .Present(10))
        index_loaded : SortedDict<S64, Option<S64>> = index.load()
        index_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        claim queue : @PriorityQueue<Job> <- .construct(alloc)
        queue.push(Job { rank: 2, name: "b" })
        queue.push(Job { rank: 1, name: "a" })
        queue_loaded : PriorityQueue<Job> = queue.load()
        print("{queue_loaded}\n")
        queue_loaded.diagnose(StdoutWriter.shared())
        print("\n")

        list.destruct()
        sorted.destruct()
        ring.destruct()
        set.destruct()
        tree.destruct()
        map.destruct()
        index.destruct()
        queue.destruct()
        return(0)
