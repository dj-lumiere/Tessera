// Every collection represents and diagnoses its elements in iteration order: [..] for lists, {..} for sets, and
// {key: value} for maps. A PriorityQueue writes its heap array, the top first, as [priority: element].

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

routine start() -> None
    local alloc: @MemoryManager <- make_heap_memory()

    local list: @List[Span[Byte]] <- .construct(alloc)
    list.add_last("a")
    list.add_last("b\n")
    list_loaded: List[Span[Byte]] = list.peek()
    Out.write("{list_loaded} ")
    list_loaded.diagnose_into(Out.writer())
    Out.write("\n")

    empty_val: List[S64] = .construct(alloc)
    Out.write("{empty_val} ")
    empty_val.diagnose_into(Out.writer())
    Out.write("\n")

    local sorted: @SortedList[S64] <- .construct(alloc)
    sorted.add(3)
    sorted.add(1)
    sorted.add(2)
    Out.write("{sorted.peek()}\n")

    local ring: @CircularList[Char] <- .construct(alloc)
    ring.add_last('b')
    ring.add_first('a')
    ring_loaded: CircularList[Char] = ring.peek()
    Out.write("{ring_loaded} ")
    ring_loaded.diagnose_into(Out.writer())
    Out.write("\n")

    local set: @Set[S64] <- .construct(alloc)
    set.add(7)
    set.add(5)
    Out.write("{set.peek()}\n")

    local tree: @SortedSet[Span[Byte]] <- .construct(alloc)
    tree.add("pear")
    tree.add("apple")
    tree_loaded: SortedSet[Span[Byte]] = tree.peek()
    Out.write("{tree_loaded} ")
    tree_loaded.diagnose_into(Out.writer())
    Out.write("\n")

    local map: @Dict[Span[Byte], S64] <- .construct(alloc)
    map["one"] = 1
    map["two"] = 2
    map_loaded: Dict[Span[Byte], S64] = map.peek()
    Out.write("{map_loaded} ")
    map_loaded.diagnose_into(Out.writer())
    Out.write("\n")

    local index: @SortedDict[S64, Maybe[S64]] <- .construct(alloc)
    index[2] = None()
    index[1] = 10
    index_loaded: SortedDict[S64, Maybe[S64]] = index.peek()
    index_loaded.diagnose_into(Out.writer())
    Out.write("\n")

    local queue: @PriorityQueue[S64, Span[Byte]] <- .construct(alloc)
    queue.add(priority: 2, element: "b")
    queue.add(priority: 1, element: "a")
    queue_loaded: PriorityQueue[S64, Span[Byte]] = queue.peek()
    Out.write("{queue_loaded}\n")
    queue_loaded.diagnose_into(Out.writer())
    Out.write("\n")

    list.destruct()
    sorted.destruct()
    ring.destruct()
    set.destruct()
    tree.destruct()
    map.destruct()
    index.destruct()
    queue.destruct()
    return
