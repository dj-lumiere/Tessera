# Every routine passes its failures to its caller: a try or check above a call receives a failure from any depth below
# it, through plain calls. An overflowing + and an index past the end are failures like a throw, told apart by their
# error type. A lambda handed to a routine that calls it passes its failure on to the try above that call.

import Hosted

### A tree evaluator that calls itself plainly, dividing at the bottom.
### :param depth: How far down the division is.
### :param divisor: What the bottom divides by.
### :returns: The quotient plus the depth.
routine eval(depth: S64, divisor: S64) -> S64
    if depth == 0
        return 100 // divisor
    below: S64 = eval(depth - 1, divisor)
    return below + 1

### Adds past the top of S64 when a is positive.
### :param a: The first value.
### :returns: The sum.
routine big(a: S64) -> S64
    return a + S64.MAX

### Reads one of three values.
### :param i: The index.
### :returns: The value.
routine pick(i: U64) -> U32
    digits: &Items[U32, 3] <- [10, 20, 30]
    view: @[U32] = digits.getview()
    return view[i]

### Calls f on x.
### :param f: The routine to call.
### :param x: Its argument.
### :returns: What f gives.
routine apply(f: Callable[(S64,), S64], x: S64) -> S64
    return f.call(x)

### Tells what a check of eval received.
### :param label: The line's name.
### :param depth: How deep.
### :param divisor: The bottom's divisor.
routine show_eval(label: @[Byte], depth: S64, divisor: S64) -> None
    when check eval(depth, divisor)
        is S64 as v => Console.show("{label}: {v}")
        is DivisionByZeroError => Console.show("{label}: division by zero")
        is Crashables as e => Console.show("{label}: {e.name()}")
    return

routine start() -> None
    show_eval(label: "ok", depth: 3, divisor: 5)
    show_eval(label: "deep", depth: 6, divisor: 0)
    when check big(1)
        is S64 as v => Console.show("big: {v}")
        is IntegerOverflowError => Console.show("big: overflow")
        is Crashables as e => Console.show("big: {e.name()}")
    when check pick(1)
        is U32 as v => Console.show("pick 1: {v}")
        is Crashables as e => Console.show("pick 1: {e.name()}")
    when check pick(7)
        is U32 as v => Console.show("pick 7: {v}")
        is IndexOutOfBoundsError => Console.show("pick 7: out of range")
        is Crashables as e => Console.show("pick 7: {e.name()}")
    tried: S64? = try eval(4, 0)
    when tried
        is S64 as v => Console.show("try: {v}")
        is None => Console.show("try: none")
    lambda: S64? = try apply((x) => 10 // x, 0)
    when lambda
        is S64 as v => Console.show("lambda: {v}")
        is None => Console.show("lambda: none")
    fine: S64? = try apply((x) => x + 1, 41)
    when fine
        is S64 as v => Console.show("lambda value: {v}")
        is None => Console.show("lambda value: none")
    Console.show("bare: {eval(2, 1)}")
    return
