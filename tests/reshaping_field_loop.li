# A routine that moves the memory of one field (the builder finds which from its body) is called while another field is walked: the walked list stays where it is.

import Collections
import Hosted

### A box with two lists.
entity Box
    rows: List[List[U64]]
    log: List[U64]

### A box with empty lists.
### :returns: The box.
common routine Box.construct() -> Me
    return Me(rows: .construct(HEAP), log: .construct(HEAP))

### Adds to the log, which is another field than the rows.
### :param x: The value.
routine @Box.note(x: U64) -> None
    me.log.add_last(x)
    return

routine start() -> None
    b: &Box <- .construct()
    row: &List[U64] <- .construct(HEAP)
    row.add_last(1)
    row.add_last(2)
    b.rows.add_last(steal row)
    first: @List[U64] = b.rows.getslot(0)
    for x in b.rows.getslot(0).emitter()
        b.note(x)
        b.log.add_last(x * 10)
    Console.show(b.log.count())
    Console.show(first.count())
    return
