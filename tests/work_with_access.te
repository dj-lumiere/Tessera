# A piece of work is a routine and its arguments, f.to[Work](name: value), a plain value bound with =. put_work(work)
# starts it on a ticket, whose retrieve() waits for it and gives the result. An access the work is handed is borrowed
# in a name first and dropped after the retrieve, and one ticket runs one piece of work after another.

import Collections
import Hosted

### A count of entries.
record Ledger
    entries: U64

### Adds entries through the access it is handed.
### :param book: The access to the ledger.
### :param count: How many.
### :returns: The ledger's entries after.
routine write_entries(book: @Authorized[Ledger], count: U64) -> U64
    view: @Ledger = book.getview()
    (view.entries.peek() + count).poke_into(view.entries)
    return view.entries.peek()

### Sums 1 to n.
### :param n: The last number.
### :returns: The sum.
routine sum_to(n: U64) -> U64
    each i in 1 to n with total: U64 = 0
        continue with total: total + i
    then
        return total

### Runs two pieces of work on one ticket.
routine start() -> None
    book: &Ledger <- Ledger(entries: 1)

    t: Thread[U64] <- get_thread[U64]()
    held: Authorized[Ledger] <- book.get_exclusive_access()
    writing: Work[U64] = write_entries.to[Work](book: held, count: 4)
    t.put_work(steal writing)
    written: U64 = t.retrieve()
    drop held
    sum: Work[U64] = sum_to.to[Work](n: 10)
    t.put_work(sum)
    Console.show("{written} {t.retrieve()} {book.load().entries}")
    drop t
    return
