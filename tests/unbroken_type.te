# Unbroken[T]: fields of a shared record that three threads add to, a compare_exchange that writes once and then finds
# the new value, a swap, and the alignment of an Unbroken[U64], 8 on every target.

import Standard/Os

record Counters
    hits: Unbroken[U64]
    flag: Unbroken[U32]
    total: Unbroken[B64]

routine bump(c: @Counters) -> None
    until i == 10000 with i: U64 = 0
        c.hits.fetch_add_relaxed(1)
        c.total.fetch_fadd(0.5)
        continue with i: i + 1
    then
        return

routine start() -> None
    out: @ConsoleOutput = Console.output()
    c: &Counters <- Counters(hits: Unbroken[U64](value: 0), flag: Unbroken[U32](value: 0),
        total: Unbroken[B64](value: 0.0))
    t1: Thread[None] <- get_thread[None]()
    work_t1: Work[None] = bump.to[Work](c: c)
    t1.put_work(steal work_t1)
    t2: Thread[None] <- get_thread[None]()
    work_t2: Work[None] = bump.to[Work](c: c)
    t2.put_work(steal work_t2)
    bump(c)
    t1.retrieve()
    drop t1
    t2.retrieve()
    drop t2
    swapped: Bool = c.flag.compare_exchange(expected: 0, new: 1).is_absent()
    again: Bool = c.flag.compare_exchange(expected: 0, new: 2).is_absent()
    old: U32 = c.flag.swap(7)
    out.write("{c.hits.peek()} {c.total.peek()} {swapped} {again} {old} {c.flag.peek_acquire()} {alignof[Unbroken[U64]]()}\n")
    return
