// In.read<T>() crashes at the end of the input with AbsentValueError, at the line of the call (read<T> is
// #track_caller). Standard input is "5". read_checked<T>() and read_result<T>() are the forms for reading to the end.
// This handler prints the crash and exits with status 3.

import Standard::Format
import Standard::Os

#[external("c"), symbol("exit"), noreturn]
routine exit(status: CInt) -> Void

#[export("tessera_crash_handler"), noreturn]
routine on_crash(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\nat line {place.line.load()}\n")
        exit(3)

routine start() -> Void
    block entry()
        first : S32 = In.read<S32>()
        Out.write("first: {first}\n")
        second : S32 = In.read<S32>()
        Out.write("second: {second}\n")
        return()
