/// Conditions on a conformance are written with `when`.
record Box[T]
conform Equatable[Box[T]] require T: typename, Equatable[T]
require T: typename
    value: T

/// Makes a `Box` from its fields.
/// :param value: Its `value`.
/// :returns: The new value.
routine Box[T].construct(value: T) -> Me
require T: typename
    return(Me(value))

/// Releases nothing: a `Box` holds no memory of its own.
routine Box[T].destruct(me: @Me) -> Void
require T: typename
    return()

routine start() -> Void
    return()
