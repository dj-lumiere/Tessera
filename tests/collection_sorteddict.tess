# SortedDict[S64, S64] against a model. An LCG drives random put / remove / has_key / get in three phases (few keys,
# many keys for a deep tree, then a drain that removes keys picked by rank so borrows and merges run). Every 500
# operations a checkpoint prints the length, a running checksum of every result, a hash of the ascending iteration
# sequence, and get_by_rank at the first, middle, and last rank. Then eq.
# The expected output comes from an independent Python model of the collection.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Rng
    state: U64

### What every phase works with besides the collection.
record Harness
    ### Where checkpoints are written.
    out: @BufWriter[Out]
    ### The generator that picks each operation.
    rng: @Rng

### One phase of the run: its number and how many operations of which kinds it makes.
record Phase
    ### The phase's number, as checkpoints print it.
    number: USize
    ### How many operations the phase runs.
    ops: USize
    ### How many distinct keys the operations draw from.
    keys: USize
    ### The weight of put among the operations.
    puts: USize
    ### The weight of remove by key.
    removes: USize
    ### The weight of remove by rank.
    rank_removes: USize

### Where a checkpoint is taken: the phase, the operations so far, and the running results checksum.
record Checkpoint
    ### The phase's number.
    phase: USize
    ### The operations run so far in the phase.
    op: USize
    ### The checksum of every result so far.
    results: S64

### Makes a `Harness` from its fields.
### :param out: Its `out`.
### :param rng: Its `rng`.
### :returns: The new value.
routine Harness.construct(out: @BufWriter[Out], rng: @Rng) -> Me
    return Me(out, rng)

### Releases nothing: a `Harness` holds no memory of its own.
routine Harness.destruct(me: @Me) -> None
    return

routine Rng.below(me: @Me, bound: USize) -> USize
    state: U64 = me.state.peek()
    next: U64 = state *% 6364136223846793005 +% 1442695040888963407
    me.state.poke(next)
    bucket: U64 = (next >> 33) % bound.to[U64]()
    value: USize = bucket.to[USize]()
    return value

routine mix(hash: S64, value: S64) -> S64
    mixed: S64 = hash *% 1000003 +% value
    return mixed

routine labeled[T](out: @T, label: Span[Byte], value: S64) -> None
needs T: typename, Writer[T]
    out.write(" {label} {value}")
    return

# Folds every (key, value) pair in iteration order.
routine iteration_hash(map: @SortedDict[S64, S64]) -> S64
    local iter: @SortedDictIter[S64, S64] <- .construct(map)
    local hash: @S64 <- 0

    while true
        item: Maybe[KVPair[S64, S64]] = iter.emit_checked()
        pair: KVPair[S64, S64] = when item
            is KVPair[S64, S64] as pair => pair
            is None => return hash.peek()
        key: S64 = pair.key
        value: S64 = pair.value
        mix(hash: mix(hash: hash.peek(), value: key), value).poke_into(hash)

routine rank_hash_at(map: @SortedDict[S64, S64], hash: S64, rank: USize) -> S64
    key: S64 = map.get_by_rank(rank).key
    value: S64 = map.get_by_rank(rank).value
    return mix(hash: mix(hash, value: key), value)

# Folds get_by_rank at the first, middle, and last rank, or 0 for an empty map.
routine rank_hash(map: @SortedDict[S64, S64]) -> S64
    local count: USize = map.count()

    if count == 0
        return 0
    else
        first: S64 = rank_hash_at(map, hash: 0, rank: 0)
        middle: S64 = rank_hash_at(map, hash: first, rank: count // 2)
        last: S64 = rank_hash_at(map, hash: middle, rank: count - 1)
        return last

routine checkpoint(out: @BufWriter[Out], map: @SortedDict[S64, S64], at: Checkpoint) -> None
    out.write("phase {at.phase}")
    labeled(out, label: "op", value: at.op.to[S64]())
    size: USize = map.count()
    labeled(out, label: "length", value: size.to[S64]())
    labeled(out, label: "results", value: at.results)
    labeled(out, label: "iteration", value: iteration_hash(map))
    labeled(out, label: "ranks", value: rank_hash(map))
    out.write("\n")
    return

# Runs ops random operations on keys below keys. An operation kind is drawn below 10: below puts it's a put, below
# removes a remove of a random key, below rank_removes a remove of the key at a random rank, otherwise a lookup.
# Returns the updated results checksum.
@reshaping(map)
routine run_phase(harness: Harness, map: @SortedDict[S64, S64], phase: Phase, results: S64) -> S64
    local rng: @Rng = harness.rng
    local ops: USize = phase.ops
    local keys: USize = phase.keys
    local puts: USize = phase.puts
    local removes: USize = phase.removes
    local rank_removes: USize = phase.rank_removes

    while op < ops with op: USize = 0, checksum: S64 = results
        key: S64 = rng.below(keys).to[S64]()
        kind: USize = rng.below(10)
        is_put: Bool = kind < puts
        is_remove: Bool = kind < removes
        is_rank_remove: Bool = kind < rank_removes
        result: S64 = when
            is_put =>
                value: S64 = rng.below(1000000).to[S64]()
                map[key] = value
                becomes value
            is_remove =>
                removed: Bool = map.remove(key)
                becomes removed.to[S64]()
            is_rank_remove =>
                count: USize = map.count()
                if count == 0
                    becomes -2
                else
                    rank: USize = rng.below(count)
                    key2: S64 = map.get_by_rank(rank).key
                    removed: Bool = map.remove(key2)
                    becomes mix(hash: key2, value: removed.to[S64]())
            else =>
                if map.has_key(key)
                    becomes map[key]
                else
                    becomes -1
        mixed: S64 = mix(hash: checksum, value: result)
        op_next: USize = op + 1
        if op_next % 500 == 0
            checkpoint(out: harness.out, map,
                at: Checkpoint(phase: phase.number, op: op_next, results: mixed))
        continue with op: op_next, checksum: mixed
    then
        return checksum

# Copies from into to from the largest key down, so the two trees are built by a different insertion order.
@reshaping(to)
routine copy_reversed(from: @SortedDict[S64, S64], to: @SortedDict[S64, S64]) -> None
    while rank_end != 0 with rank_end: USize = from.count()
        rank: USize = rank_end - 1
        to[from.get_by_rank(rank).key] = from.get_by_rank(rank).value
        continue with rank_end: rank
    then
        return

routine report_eq(out: @BufWriter[Out], label: Span[Byte], equal: Bool) -> None
    out.write("{label} {equal}\n")
    return

routine start() -> None
    fd: @Out = Out.writer()
    local out: @BufWriter[Out] <- .hollow()
    out.construct(fd)
    local alloc: @MemoryManager <- make_heap_memory()
    local rng: @Rng <- Rng(state: 1)
    local map: @SortedDict[S64, S64] <- .construct(alloc)

    harness: Harness = Harness(out: out, rng: rng)
    r1: S64 = run_phase(harness, map,
        phase: Phase(number: 1, ops: 3000, keys: 64, puts: 5, removes: 7, rank_removes: 7),
        results: 0)
    r2: S64 = run_phase(harness, map,
        phase: Phase(number: 2, ops: 10000, keys: 20000, puts: 6, removes: 7, rank_removes: 7),
        results: r1)

    local copied: @SortedDict[S64, S64] <- .construct(alloc)
    report_eq(out, label: "empty copy equal", equal: map.eq(copied))
    copy_reversed(from: map, to: copied)
    report_eq(out, label: "reversed copy equal", equal: map.eq(copied))
    report_eq(out, label: "reversed copy same order",
        equal: iteration_hash(map) == iteration_hash(copied))
    copied[-1] = 0
    report_eq(out, label: "extra key equal", equal: map.eq(copied))
    copied.remove(-1)
    report_eq(out, label: "extra key removed equal", equal: map.eq(copied))
    key: S64 = map.get_by_rank(0).key
    old_value: S64 = map[key]
    copied[key] = old_value + 1
    report_eq(out, label: "changed value equal", equal: map.eq(copied))
    drop copied

    r3: S64 = run_phase(harness, map,
        phase: Phase(number: 3, ops: 14000, keys: 20000, puts: 1, removes: 3, rank_removes: 8),
        results: r2)
    drop map
    out.flush()
    return
