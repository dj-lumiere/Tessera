// SortedDict<S64, S64> against a model. An LCG drives random put / remove / has_key / get in three phases (few keys,
// many keys for a deep tree, then a drain that removes keys picked by rank so borrows and merges run). Every 500
// operations a checkpoint prints the length, a running checksum of every result, a hash of the ascending iteration
// sequence, and get_by_rank at the first, middle, and last rank. Then eq.
// The expected output comes from an independent Python model of the collection.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

routine Rng.below(self: @Self, bound: USize) -> USize
    block entry()
        state : U64 = self.state.load()
        next  : U64 = state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        self.state.store(next)
        bucket : U64   = next.shr(33).mod(bound.to<U64>())
        value  : USize = bucket.to<USize>()
        return(value)

routine mix(hash: S64, value: S64) -> S64
    block entry()
        mixed : S64 = hash.mul_wrap(1000003).add_wrap(value)
        return(mixed)

routine labeled<T>(out: @T, label: Bytes, value: S64) -> Void
require T: typename, Writer<T>
    block entry()
        out.write(" {label} {value}")
        return()

// Folds every (key, value) pair in iteration order.
routine iteration_hash(map: @SortedDict<S64, S64>) -> S64
    shared iter : @SortedDictIter<S64, S64> <- .construct(map)
    shared hash : @S64                      <- 0

    block entry()
        jump next()

    block next()
        item : Option<KVPair<S64, S64>> = iter.next()
        when item
            .Present(pair) -> continue
            .Absent        -> return(hash.load())
        key   : S64 = pair.key
        value : S64 = pair.value
        mix(mix(hash.load(), key), value).store_into(hash)
        jump next()

routine rank_hash_at(map: @SortedDict<S64, S64>, hash: S64, rank: USize) -> S64
    block entry()
        key   : S64 = map.get_by_rank(rank).key
        value : S64 = map.get_by_rank(rank).value
        return(mix(mix(hash, key), value))

// Folds get_by_rank at the first, middle, and last rank, or 0 for an empty map.
routine rank_hash(map: @SortedDict<S64, S64>) -> S64
    shared count : USize = map.count()

    block entry()
        empty : Bool = count.eq(0)
        branch empty
            ? return(0)
            : ranks()

    block ranks()
        first  : S64 = rank_hash_at(map, 0, 0)
        middle : S64 = rank_hash_at(map, first, count.div(2))
        last   : S64 = rank_hash_at(map, middle, count.sub(1))
        return(last)

routine checkpoint(out: @BufWriter<Out>, map: @SortedDict<S64, S64>, phase: USize, op: USize,
    results: S64) -> Void
    block entry()
        out.write("phase {phase}")
        labeled(out, "op", op.to<S64>())
        size : USize = map.count()
        labeled(out, "length", size.to<S64>())
        labeled(out, "results", results)
        labeled(out, "iteration", iteration_hash(map))
        labeled(out, "ranks", rank_hash(map))
        out.write("\n")
        return()

// Runs ops random operations on keys below keys. An operation kind is drawn below 10: below puts it's a put, below
// removes a remove of a random key, below rank_removes a remove of the key at a random rank, otherwise a lookup.
// Returns the updated results checksum.
routine run_phase(out: @BufWriter<Out>, map: @SortedDict<S64, S64>, rng: @Rng, phase: USize,
    ops: USize, keys: USize, puts: USize, removes: USize, rank_removes: USize, results: S64) -> S64
    block entry()
        jump next(0, results)

    block next(op: USize, checksum: S64)
        done : Bool = op.ge(ops)
        branch done
            ? return(checksum)
            : pick(op, checksum)

    block pick(op: USize, checksum: S64)
        key            : S64   = rng.below(keys).to<S64>()
        kind           : USize = rng.below(10)
        is_put         : Bool  = kind.lt(puts)
        is_remove      : Bool  = kind.lt(removes)
        is_rank_remove : Bool  = kind.lt(rank_removes)
        when
            is_put         -> put(op, checksum, key)
            is_remove      -> remove(op, checksum, key)
            is_rank_remove -> remove_ranked(op, checksum)
            else           -> lookup(op, checksum, key)

    block put(op: USize, checksum: S64, key: S64)
        value : S64 = rng.below(1000000).to<S64>()
        map.put(key, value)
        jump record(op, checksum, value)

    block remove(op: USize, checksum: S64, key: S64)
        removed : Bool = map.remove(key)
        jump record(op, checksum, removed.to<S64>())

    block remove_ranked(op: USize, checksum: S64)
        count : USize = map.count()
        empty : Bool  = count.eq(0)
        branch empty
            ? record(op, checksum, -2)
            : remove_at(op, checksum, count)

    block remove_at(op: USize, checksum: S64, count: USize)
        rank    : USize = rng.below(count)
        key     : S64   = map.get_by_rank(rank).key
        removed : Bool  = map.remove(key)
        jump record(op, checksum, mix(key, removed.to<S64>()))

    block lookup(op: USize, checksum: S64, key: S64)
        found : Bool = map.has_key(key)
        branch found
            ? get(op, checksum, key)
            : record(op, checksum, -1)

    block get(op: USize, checksum: S64, key: S64)
        value : S64 = map.getitem(key)
        jump record(op, checksum, value)

    block record(op: USize, checksum: S64, result: S64)
        mixed   : S64   = mix(checksum, result)
        op_next : USize = op.add(1)
        report  : Bool  = op_next.mod(500).eq(0)
        branch report
            ? report(op_next, mixed)
            : next(op_next, mixed)

    block report(op: USize, checksum: S64)
        checkpoint(out, map, phase, op, checksum)
        jump next(op, checksum)

// Copies from into to from the largest key down, so the two trees are built by a different insertion order.
routine copy_reversed(from: @SortedDict<S64, S64>, to: @SortedDict<S64, S64>) -> Void
    block entry()
        jump next(from.count())

    block next(rank_end: USize)
        done : Bool = rank_end.eq(0)
        branch done
            ? return()
            : copy(rank_end.sub(1))

    block copy(rank: USize)
        to.put(from.get_by_rank(rank).key, from.get_by_rank(rank).value)
        jump next(rank)

routine report_eq(out: @BufWriter<Out>, label: Bytes, equal: Bool) -> Void
    block entry()
        out.write("{label} {equal}\n")
        return()

routine main() -> S32
    block entry()
        fd : @Out = Out.writer()
        claim out : @BufWriter<Out> <- uninit
        out.construct(fd)
        claim alloc : @Allocator            <- make_heap_allocator()
        claim rng   : @Rng                  <- Rng { state: 1 }
        claim map   : @SortedDict<S64, S64> <- .construct(alloc)

        r1 : S64 = run_phase(out, map, rng, 1, 3000, 64, 5, 7, 7, 0)
        r2 : S64 = run_phase(out, map, rng, 2, 10000, 20000, 6, 7, 7, r1)

        claim copied : @SortedDict<S64, S64> <- .construct(alloc)
        report_eq(out, "empty copy equal", map.load().eq(copied.load()))
        copy_reversed(map, copied)
        report_eq(out, "reversed copy equal", map.load().eq(copied.load()))
        report_eq(out, "reversed copy same order", iteration_hash(map).eq(iteration_hash(copied)))
        copied.put(-1, 0)
        report_eq(out, "extra key equal", map.load().eq(copied.load()))
        copied.remove(-1)
        report_eq(out, "extra key removed equal", map.load().eq(copied.load()))
        key       : S64 = map.get_by_rank(0).key
        old_value : S64 = map.getitem(key)
        copied.put(key, old_value.add(1))
        report_eq(out, "changed value equal", map.load().eq(copied.load()))
        copied.destruct()

        r3 : S64 = run_phase(out, map, rng, 3, 14000, 20000, 1, 3, 8, r2)
        map.destruct()
        report_eq(out, "freed is empty", map.is_empty())
        out.flush()
        return(0)
