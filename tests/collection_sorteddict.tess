// SortedDict<S64, S64> against a model. An LCG drives random put / remove / contains / get in three phases (few keys,
// many keys for a deep tree, then a drain that removes keys picked by rank so borrows and merges run). Every 500
// operations a checkpoint prints the length, a running checksum of every result, a hash of the ascending iteration
// sequence, and get_by_rank at the first, middle, and last rank. Then eq.
// The expected output is generated by scripts/gen_collection_btree.py.

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

record Rng
    state : U64

routine Rng.below(%self: Ptr<Self>, %bound: USize) -> USize
    block entry():
        %state : U64 = %self.state.load()
        %next  : U64 = %state.mul_wrap(6364136223846793005).add_wrap(1442695040888963407)
        %self.state.store(%next)
        %value : USize = %next.shr(33).rem(%bound.to_u64()).to_usize()
        return(%value)

routine mix(%hash: S64, %value: S64) -> S64
    block entry():
        %mixed : S64 = %hash.mul_wrap(1000003).add_wrap(%value)
        return(%mixed)

routine labeled<W>(%out: Ptr<W>, %label: String, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        write(%out, " {%label} {%value}")
        return()

// Folds every (key, value) pair in iteration order.
routine iteration_hash(%map: Ptr<SortedDict<S64, S64>>) -> S64
    block entry():
        %iter_val : SortedDictIter<S64, S64> = .construct(%map)
        claim %iter : Ptr<SortedDictIter<S64, S64>>
        %iter.store(%iter_val)
        jump next(%iter, 0)

    block next(%iter: Ptr<SortedDictIter<S64, S64>>, %hash: S64):
        %item : Option<KVPair<S64, S64>> = %iter.next()
        when %item:
            .Present(%pair) -> fold(%iter, %hash, %pair)
            .Absent         -> return(%hash)

    block fold(%iter: Ptr<SortedDictIter<S64, S64>>, %hash: S64, %pair: KVPair<S64, S64>):
        %key   : S64 = %pair.key
        %value : S64 = %pair.value
        jump next(%iter, mix(mix(%hash, %key), %value))

routine rank_hash_at(%map: Ptr<SortedDict<S64, S64>>, %hash: S64, %rank: USize) -> S64
    block entry():
        %key   : S64 = %map.load().get_by_rank(%rank).key
        %value : S64 = %map.load().get_by_rank(%rank).value
        return(mix(mix(%hash, %key), %value))

// Folds get_by_rank at the first, middle, and last rank; 0 for an empty map.
routine rank_hash(%map: Ptr<SortedDict<S64, S64>>) -> S64
    block entry():
        %length : USize = %map.load().length()
        %empty  : Bool  = %length.eq(0)
        branch %empty ? return(0) : ranks(%length)

    block ranks(%length: USize):
        %first  : S64 = rank_hash_at(%map, 0, 0)
        %middle : S64 = rank_hash_at(%map, %first, %length.div(2))
        %last   : S64 = rank_hash_at(%map, %middle, %length.sub(1))
        return(%last)

routine checkpoint(%out: Ptr<BufWriter<FdWriter>>, %map: Ptr<SortedDict<S64, S64>>, %phase: USize,
        %op: USize, %results: S64) -> Void
    block entry():
        write(%out, "phase {%phase}")
        labeled(%out, "op", %op.to_s64())
        labeled(%out, "length", %map.load().length().to_s64())
        labeled(%out, "results", %results)
        labeled(%out, "iteration", iteration_hash(%map))
        labeled(%out, "ranks", rank_hash(%map))
        write(%out, "\n")
        return()

// Runs ops random operations on keys below keys. An operation kind is drawn below 10: below puts it's a put, below
// removes a remove of a random key, below rank_removes a remove of the key at a random rank, otherwise a lookup.
// Returns the updated results checksum.
routine run_phase(%out: Ptr<BufWriter<FdWriter>>, %map: Ptr<SortedDict<S64, S64>>, %rng: Ptr<Rng>,
        %phase: USize, %ops: USize, %keys: USize, %puts: USize, %removes: USize,
        %rank_removes: USize, %results: S64) -> S64
    block entry():
        jump next(0, %results)

    block next(%op: USize, %results: S64):
        %done : Bool = %op.ge(%ops)
        branch %done ? return(%results) : pick(%op, %results)

    block pick(%op: USize, %results: S64):
        %key            : S64   = %rng.below(%keys).to_s64()
        %kind           : USize = %rng.below(10)
        %is_put         : Bool  = %kind.lt(%puts)
        %is_remove      : Bool  = %kind.lt(%removes)
        %is_rank_remove : Bool  = %kind.lt(%rank_removes)
        when:
            %is_put         -> put(%op, %results, %key)
            %is_remove      -> remove(%op, %results, %key)
            %is_rank_remove -> remove_ranked(%op, %results)
            else            -> lookup(%op, %results, %key)

    block put(%op: USize, %results: S64, %key: S64):
        %value : S64 = %rng.below(1000000).to_s64()
        %map.put(%key, %value)
        jump record(%op, %results, %value)

    block remove(%op: USize, %results: S64, %key: S64):
        %removed : Bool = %map.remove(%key)
        jump record(%op, %results, %removed.to_s64())

    block remove_ranked(%op: USize, %results: S64):
        %length : USize = %map.load().length()
        %empty  : Bool  = %length.eq(0)
        branch %empty ? record(%op, %results, -2) : remove_at(%op, %results, %length)

    block remove_at(%op: USize, %results: S64, %length: USize):
        %rank    : USize = %rng.below(%length)
        %key     : S64   = %map.load().get_by_rank(%rank).key
        %removed : Bool  = %map.remove(%key)
        jump record(%op, %results, mix(%key, %removed.to_s64()))

    block lookup(%op: USize, %results: S64, %key: S64):
        %found : Bool = %map.load().contains(%key)
        branch %found ? get(%op, %results, %key) : record(%op, %results, -1)

    block get(%op: USize, %results: S64, %key: S64):
        %value : S64 = %map.load().get(%key)
        jump record(%op, %results, %value)

    block record(%op: USize, %results: S64, %result: S64):
        %mixed   : S64   = mix(%results, %result)
        %op_next : USize = %op.add(1)
        %report  : Bool  = %op_next.rem(500).eq(0)
        branch %report ? report(%op_next, %mixed) : next(%op_next, %mixed)

    block report(%op: USize, %results: S64):
        checkpoint(%out, %map, %phase, %op, %results)
        jump next(%op, %results)

// Copies from into to from the largest key down, so the two trees are built by a different insertion order.
routine copy_reversed(%from: Ptr<SortedDict<S64, S64>>, %to: Ptr<SortedDict<S64, S64>>) -> Void
    block entry():
        jump next(%from.load().length())

    block next(%rank_end: USize):
        %done : Bool = %rank_end.eq(0)
        branch %done ? return() : copy(%rank_end.sub(1))

    block copy(%rank: USize):
        %to.put(%from.load().get_by_rank(%rank).key, %from.load().get_by_rank(%rank).value)
        jump next(%rank)

routine report_eq(%out: Ptr<BufWriter<FdWriter>>, %label: String, %equal: Bool) -> Void
    block entry():
        write(%out, "{%label} {%equal}\n")
        return()

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim %fd : Ptr<FdWriter>
        %fd.store(%fd_val)
        claim %out : Ptr<BufWriter<FdWriter>>
        %out.construct(%fd)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %rng_val : Rng = Rng { state: 1 }
        claim %rng : Ptr<Rng>
        %rng.store(%rng_val)
        %map_val : SortedDict<S64, S64> = .construct(%alloc)
        claim %map : Ptr<SortedDict<S64, S64>>
        %map.store(%map_val)

        %r1 : S64 = run_phase(%out, %map, %rng, 1, 3000, 64, 5, 7, 7, 0)
        %r2 : S64 = run_phase(%out, %map, %rng, 2, 10000, 20000, 6, 7, 7, %r1)

        %copied_val : SortedDict<S64, S64> = .construct(%alloc)
        claim %copied : Ptr<SortedDict<S64, S64>>
        %copied.store(%copied_val)
        report_eq(%out, "empty copy equal", %map.load().eq(%copied.load()))
        copy_reversed(%map, %copied)
        report_eq(%out, "reversed copy equal", %map.load().eq(%copied.load()))
        report_eq(%out, "reversed copy same order",
                iteration_hash(%map).eq(iteration_hash(%copied)))
        %copied.put(-1, 0)
        report_eq(%out, "extra key equal", %map.load().eq(%copied.load()))
        %copied.remove(-1)
        report_eq(%out, "extra key removed equal", %map.load().eq(%copied.load()))
        %key : S64 = %map.load().get_by_rank(0).key
        %copied.put(%key, %map.load().get(%key).add(1))
        report_eq(%out, "changed value equal", %map.load().eq(%copied.load()))
        %copied.destruct()

        %r3 : S64 = run_phase(%out, %map, %rng, 3, 14000, 20000, 1, 3, 8, %r2)
        %map.destruct()
        report_eq(%out, "freed is empty", %map.load().is_empty())
        %out.flush()
        return(0)
