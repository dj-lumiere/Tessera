# A when v arm may list several values. They share the arm, a value in two arms is an error, and a choice is
# still checked for every member. Ranges aren't a when pattern use between / in_range in when.

import Hosted

choice Shape: U8
    CIRCLE: 0
    SQUARE: 1
    TRIANGLE: 2
    HEXAGON: 3

routine kind(c: Byte) -> S64
    when c
        b'+', b'-' => return 1
        b' ', b'\t', b'\n' => return 2
        else => nothing
    when
        b'0' <= c <= b'9' => return 3
        else => return 0

routine corners(s: Shape) -> S64
    when s
        Shape.CIRCLE => return 0
        Shape.SQUARE, Shape.HEXAGON => return 4
        Shape.TRIANGLE => return 3

routine is_small(n: U64) -> Bool
    when n
        0, 1, 2, 3 => return true
        else => return false

routine start() -> None
    Console.show("{kind(b'+')} {kind(b'-')} {kind(b' ')} {kind(b'\n')} {kind(b'7')} {kind(b'x')}")
    Console.show("{corners(Shape.CIRCLE)} {corners(Shape.HEXAGON)} {corners(Shape.TRIANGLE)}")
    Console.show("{is_small(2)} {is_small(4)}")
    return
