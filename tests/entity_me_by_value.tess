import Standard/Os

### Counts things.
entity Counter
    count: S64

### A counter at zero.
### :returns: The counter.
routine Counter.construct() -> Me
    return Me(count: 0)

### Releases nothing.
routine Counter.destruct(me: @Me) -> None
    return

### Takes a counter over and ends it.
### :param c: The counter.
routine finish(c: Counter) -> None
    local slot: @Counter <- steal c

    drop slot
    return

routine Counter.read(me: Me) -> S64
    return 0

routine start() -> None
    local a: @Counter <- .construct()

    n: S64 = a.read()
    drop a
    return
