### A generic parameter is its position, not its name: two definitions that differ only in what they call their
### parameters behave the same, so renaming one changes nothing.
import Standard/Format

import Standard/Os

### A pair written with role names.
record PairA[TFirst, TSecond]
needs TFirst: typename, TSecond: typename
    first: TFirst
    second: TSecond

### The same pair written with other names.
record PairB[TLeft, TRight]
needs TLeft: typename, TRight: typename
    first: TLeft
    second: TRight

### Makes a `PairA` from its fields.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
routine PairA[TFirst, TSecond].construct(first: TFirst, second: TSecond) -> Me
needs TFirst: typename, TSecond: typename
    return Me(first, second)

### Releases nothing: a `PairA` holds no memory of its own.
routine PairA[TFirst, TSecond].destruct(me: @Me) -> None
needs TFirst: typename, TSecond: typename
    return

### Makes a `PairB` from its fields.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
routine PairB[TLeft, TRight].construct(first: TLeft, second: TRight) -> Me
needs TLeft: typename, TRight: typename
    return Me(first, second)

### Releases nothing: a `PairB` holds no memory of its own.
routine PairB[TLeft, TRight].destruct(me: @Me) -> None
needs TLeft: typename, TRight: typename
    return

### Swaps the two values.
### :returns: A pair with the values swapped.
routine PairA[TFirst, TSecond].swapped(me: Me) -> PairA[TSecond, TFirst]
    return PairA[TSecond, TFirst](first: me.second, second: me.first)

### Swaps the two values.
### :returns: A pair with the values swapped.
routine PairB[TLeft, TRight].swapped(me: Me) -> PairB[TRight, TLeft]
    return PairB[TRight, TLeft](first: me.second, second: me.first)

### Shows that both definitions swap the same way.
routine start() -> None
    a: PairA[S64, Span[Byte]] = PairA[S64, Span[Byte]](first: 1, second: "one")
    b: PairB[S64, Span[Byte]] = PairB[S64, Span[Byte]](first: 1, second: "one")
    sa: PairA[Span[Byte], S64] = a.swapped()
    sb: PairB[Span[Byte], S64] = b.swapped()
    Out.write("{sa.first} {sa.second} {sb.first} {sb.second}\n")
    return
