// An #inline routine that calls itself, here through another routine, can't be inlined at every call.

#inline
routine is_even(n: U64) -> Bool
    block entry():
        zero : Bool = n.eq(0)
        branch zero
            ? return(true)
            : odd(n)

    block odd(n: U64):
        return(is_odd(n.sub(1)))

routine is_odd(n: U64) -> Bool
    block entry():
        zero : Bool = n.eq(0)
        branch zero
            ? return(false)
            : even(n)

    block even(n: U64):
        return(is_even(n.sub(1)))

routine main() -> S32
    block entry():
        e : Bool = is_even(10)
        return(0)
