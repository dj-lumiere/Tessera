// getitem reads an array value directly, a literal included: the index is a runtime value, and the read is bounds
// checked like the pointer form.

import Standard::Format
import Standard::Os

/// The element at `i` of a table written as a literal.
/// :param i: The index, below 5.
/// :returns: The element at `i`.
routine table(i: USize) -> U64
    block entry()
        value : U64 = Array<U64, 5> { 2, 10, 16, 36, 64 }.getitem(i)
        return(value)

routine start() -> Void
    block entry()
        jump each(0)

    block each(i: USize)
        done : Bool = i.eq(5)
        branch done
            ? last()
            : show(i)

    block show(i: USize)
        Out.write("{table(i)}\n")
        jump each(i.add(1))

    block last()
        a : Array<S64, 3> = Array<S64, 3> { -1, 0, 1 }
        Out.write("{a.getitem(2)}\n")
        return()
