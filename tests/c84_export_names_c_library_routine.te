# An @export under a name a C library the build links already defines (libc's abs) is a build error: the program's
# routine would replace the library's for every C caller in the program.
module C84/ExportNamesCLibraryRoutine
import Hosted

### Always 42.
### :param x: Unused.
### :returns: 42.
@export("abs")
routine my_abs(x: CInt) -> CInt
    return 42

@external("c")
@symbol("abs")
routine c_abs(x: CInt) -> CInt

### Runs the example.
routine start() -> None
    a: CInt = c_abs(-3)
    Console.show("abs(-3) = {a}")
    return
