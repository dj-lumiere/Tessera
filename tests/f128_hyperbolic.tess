        show("cosh(11357)", f128_of(0x400C62E8000000000000000000000000).cosh())
        show("cosh(11357) exact", f128_cosh(f128_of(0x400C62E8000000000000000000000000), true))
        show("tanh(last below 1)", f128_of(0x40043ED903114D00CEA0AEC526B52718).tanh())
