        show("tanh(2^-57 - ulp)", f128_of(0x3FC5FFFFFFFFFFFFFFFFFFFFFFFFFFFF).tanh())
        show("tanh(2^-57)", f128_of(0x3FC60000000000000000000000000000).tanh())
