        show("cosh(inf)", f128_of(0x7FFF0000000000000000000000000000).cosh())
        show("cosh(-inf)", f128_of(0xFFFF0000000000000000000000000000).cosh())
        show("cosh(nan)", f128_of(0x7FFF8000000000000000000000000000).cosh())
        show("cosh(snan)", f128_of(0x7FFF0000000000000000000000000001).cosh())
        show("cosh(min subnormal)", f128_of(0x00000000000000000000000000000001).cosh())
        show("cosh(2^-57 - ulp)", f128_of(0x3FC5FFFFFFFFFFFFFFFFFFFFFFFFFFFF).cosh())
        show("cosh(2^-57)", f128_of(0x3FC60000000000000000000000000000).cosh())
        show("cosh(2^-57) exact", f128_cosh(f128_of(0x3FC60000000000000000000000000000), true))
        show("cosh(1/2 - ulp)", f128_of(0x3FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF).cosh())
