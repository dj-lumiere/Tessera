# Thread work changes shared memory through an exclusive access it is handed: the routine that puts the work takes the
# access before put_work, hands the Authorized[T] to the work, waits for it, and gives the access back. Work
# that takes an exclusive access itself (each round, to one counter) builds too, and four threads lose nothing.

import Standard/Collections
import Standard/Os

global COUNTER: &U64

### Adds `rounds` values to the list it is handed exclusive access to.
### :param list: The exclusive access to the list.
### :param rounds: How many.
@reshaping(list)
routine fill(list: Authorized[List[U64]], rounds: U64) -> None
    each i in 0 til rounds
        list.getview().add_last(i)
    then
        return

### Adds `rounds` to the counter, each under exclusive access to it.
### :param rounds: How many.
routine bump(rounds: U64) -> None
    each i in 0 til rounds
        counter: Authorized[U64] <- COUNTER.get_exclusive_access()
        counter.getview().poke(counter.getview().peek() + 1)
        drop counter
    then
        return

routine start() -> None
    xs: &List[U64] <- .construct(HEAP)
    threads: &Array[Thread[None], 4] <- .hollow()

    list: Authorized[List[U64]] <- xs.get_exclusive_access()
    t: Thread[None] <- get_thread[None]()
    work_t: Work[None] <- fill.to[Work](list: list, rounds: 1000)
    t.put_work(work_t)
    drop work_t
    t.wait_finished()
    drop t
    drop list
    each i: U64 in 0 til 4
        u: Thread[None] <- get_thread[None]()
        work_u: Work[None] <- bump.to[Work](rounds: 1000)
        u.put_work(work_u)
        drop work_u
        threads[i] = u
    each i: U64 in 0 til 4
        u: Thread[None] <- steal threads.getslot(i)
        u.wait_finished()
        drop u
    Console.show("{COUNTER.peek()} {xs.count()}")
    drop xs
    return
