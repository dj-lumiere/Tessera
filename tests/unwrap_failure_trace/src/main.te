# unwrap of a failure says what the failure holds and where it was made: load's failure wraps the one parse made, and
# the message has both traces, the wrapping one first. This handler prints the message and exits with status 3.

import Standard/Format
import Standard/Os

record ParseFailed
    at: U64

@derive(Diagnosable)
choice Problem: U8
    BAD_INPUT

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Prints the crash's name and message, where the golden test sees them, and exits with status 3.
### :param name: The crash kind.
### :param message: The crash message.
### :param place: Where the crash was raised.
@export("tessera_crash_handler")
@noreturn
routine on_crash(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\n")
    exit(3)

routine parse(n: S64) -> Result[S64, ParseFailed]
    if n < 0
        return ParseFailed(at: 3)
    else
        return n

routine load(n: S64) -> Result[S64, Problem]
    when parse(n)
        is S64 as v => return v
        is ParseFailed => return Problem.BAD_INPUT

routine start() -> None
    v: S64 = load(-1).unwrap()
    return
