// A Memory[T] from construct(count, manager) is memory from a manager: an address, a count, the manager, and a
// generation. drop() gives the memory back to that manager, destruct_all() destructs the values first, resize
// reallocates, and the _result forms return an error instead of crashing. A counting manager shows every block coming
// back, and a refusing one the failures.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Counts
    live: S64
    calls: S64

routine bump(place: @S64, by: S64) -> Void
    next: S64 = place.peek() + by
    place.poke(next)
    return

routine counting_alloc(state: Addr, size: USize, align: USize) -> Addr
    counts: @Counts = state.to[@Counts]()
    bump(place: counts.live, by: 1)
    bump(place: counts.calls, by: 1)
    malloc: Callable[(Addr, USize, USize), Addr] = DEFAULT_HEAP.alloc_fn.peek()
    return malloc.call(null, size, align)

routine counting_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    local counts: @Counts = state.to[@Counts]()

    bump(place: counts.calls, by: 1)
    if old.is_null()
        bump(place: counts.live, by: 1)
    realloc: Callable[(Addr, Addr, USize, USize), Addr] = DEFAULT_HEAP.realloc_fn.peek()
    return realloc.call(null, old, size, align)

routine counting_free(state: Addr, memory: Addr) -> Void
    counts: @Counts = state.to[@Counts]()
    bump(place: counts.live, by: -1)
    free: Callable[(Addr, Addr), Void] = DEFAULT_HEAP.free_fn.peek()
    free.call(null, memory)
    return

routine refuse_alloc(state: Addr, size: USize, align: USize) -> Addr
    return null

routine refuse_realloc(state: Addr, old: Addr, size: USize, align: USize) -> Addr
    return null

routine show(label: Span[Byte], counts: @Counts) -> Void
    Out.write("{label}: live {counts.live.peek()}, allocator calls {counts.calls.peek()}\n")
    return

/// Reading and writing through both receivers, and resizing.
routine values(counts: @Counts, alloc: @MemoryManager) -> Void
    local owned: @Memory[S64] <- .construct(count: 3, manager: alloc)
    owned[0] = 10
    owned[1] = 20
    owned.getslot(2).poke(30)
    copy: Span[S64] = owned.getview()
    Out.write("count {owned.count()} and {copy.count()}, values {owned.getitem(0)} {copy.getitem(1)} {owned.getslot(2).peek()}\n")
    Out.write("getitem_checked(2) {owned.getitem_checked(2)}, getitem_checked(3) {copy.getitem_checked(3)}\n")
    tail: Span[S64] = owned.getslice(start: 1, count: 2)
    Out.write("getslice(1, 2): {tail.getitem(0)} {tail.getitem(1)}, first by address {owned.to[@S64]().peek()}\n")
    owned.resize(5)
    owned[4] = 50
    Out.write("after resize(5): count {owned.count()}, kept {owned.getitem(2)}, new {owned.getitem(4)}\n")
    show(label: "  one block", counts)
    owned.resize(0)
    Out.write("after resize(0): count {owned.count()}\n")
    show(label: "  given back", counts)
    owned.drop()
    return

/// A count of 0 allocates nothing, and drop on empty memory gives nothing back.
routine empty(counts: @Counts, alloc: @MemoryManager) -> Void
    local nothing: @Memory[U8] <- .construct(count: 0, manager: alloc)
    Out.write("empty: count {nothing.count()}, getitem_checked(0) {nothing.getitem_checked(0)}\n")
    nothing.drop()
    nothing.drop()
    show(label: "  after two drops", counts)
    return

/// destruct_all releases what each value owns, then the memory itself.
routine nested(counts: @Counts, alloc: @MemoryManager) -> Void
    local rows: @Memory[List[S64]] <- .construct(count: 2, manager: alloc)
    rows[0] = List[S64].construct(alloc)
    rows[1] = List[S64].construct(alloc)
    rows.getslot(0).add_last(1)
    rows.getslot(1).add_last(2)
    rows.getslot(1).add_last(3)
    Out.write("rows: {rows.getitem(0)} {rows.getitem(1)}\n")
    show(label: "  three blocks", counts)
    rows.destruct_all()
    show(label: "  after destruct_all", counts)
    return

/// Text in a Memory[Byte].
routine text(alloc: @MemoryManager) -> Void
    local bytes: @Memory[Byte] <- .construct(count: 2, manager: alloc)
    bytes[0] = b'o'
    bytes[1] = b'k'
    copy: Span[Byte] = bytes.getview()
    Out.write("text: {bytes.getview()} {copy.getview().count()}\n")
    bytes.drop()
    return

/// The _result forms against an allocator that refuses everything.
routine refused() -> Void
    refusing: MemoryManager = MemoryManager(alloc_fn: refuse_alloc.to[Callable](), realloc_fn: refuse_realloc.to[Callable](), free_fn: DEFAULT_HEAP.free_fn.peek(), reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: null)
    local alloc: @MemoryManager <- refusing
    made: Result[Memory[U8], AllocFailed] = Memory[U8].construct_result(count: 4, manager: alloc)
    Out.write("construct_result: failed {made.is_failure()}, {made.unwrap_failure()}\n")
    local none: @Memory[U8] <- .construct(count: 0, manager: alloc)
    resized: Result[Unit, AllocFailed] = none.resize_result(4)
    Out.write("resize_result: {resized}, count still {none.count()}\n")
    none.drop()
    return

routine start() -> Void
    local counts: @Counts <- (live: 0, calls: 0)
    counting: MemoryManager = MemoryManager(alloc_fn: counting_alloc.to[Callable](), realloc_fn: counting_realloc.to[Callable](), free_fn: counting_free.to[Callable](), reserve_fn: null, commit_fn: null, release_fn: null, protect_fn: null, state: counts)
    local alloc: @MemoryManager <- counting
    values(counts, alloc)
    empty(counts, alloc)
    nested(counts, alloc)
    text(alloc)
    show(label: "in the end", counts)
    refused()
    return
