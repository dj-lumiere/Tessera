// A Slice[T] from construct(count, alloc) owns heap memory: an address, a count, and the allocator it came from.
// destruct() gives the memory back to that allocator, destruct_all() destructs the values first, resize reallocates,
// and the _result forms return a Failure instead of crashing. A counting allocator shows every block coming back,
// and a refusing one the failures.

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

record Counts
    live: S64
    calls: S64

routine bump(place: @S64, by: S64) -> Void
    block entry()
        next: S64 = place.peek().add(by)
        place.poke(next)
        return()

routine counting_alloc(state: Addr, size: USize) -> Addr
    block entry()
        counts: @Counts = state.to[@Counts]()
        bump(counts.live, 1)
        bump(counts.calls, 1)
        malloc: Callable[(Addr, USize), Addr] = DEFAULT_HEAP.alloc_fn.peek()
        return(malloc.call(null, size))

routine counting_realloc(state: Addr, old: Addr, size: USize) -> Addr
    local counts: @Counts = state.to[@Counts]()

    block entry()
        bump(counts.calls, 1)
        branch old.is_null()
            ? fresh()
            : resize()

    block fresh()
        bump(counts.live, 1)
        jump resize()

    block resize()
        realloc: Callable[(Addr, Addr, USize), Addr] = DEFAULT_HEAP.realloc_fn.peek()
        return(realloc.call(null, old, size))

routine counting_free(state: Addr, memory: Addr) -> Void
    block entry()
        counts: @Counts = state.to[@Counts]()
        bump(counts.live, -1)
        free: Callable[(Addr, Addr), Void] = DEFAULT_HEAP.free_fn.peek()
        free.call(null, memory)
        return()

routine refuse_alloc(state: Addr, size: USize) -> Addr
    block entry()
        return(null)

routine refuse_realloc(state: Addr, old: Addr, size: USize) -> Addr
    block entry()
        return(null)

routine show(label: Bytes, counts: @Counts) -> Void
    block entry()
        Out.write("{label}: live {counts.live.peek()}, allocator calls {counts.calls.peek()}\n")
        return()

/// Reading and writing through both receivers, and resizing.
routine values(counts: @Counts, alloc: @MemoryManager) -> Void
    block entry()
        claim owned: @Slice[S64] <- .construct(3, alloc)
        owned.setitem(0, 10)
        owned.setitem(1, 20)
        owned.getslot(2).poke(30)
        copy: Slice[S64] = owned.peek()
        Out.write("count {owned.count()} and {copy.count()}, values {owned.getitem(0)} {copy.getitem(1)} {owned.getslot(2).peek()}\n")
        Out.write("getitem_checked(2) {owned.getitem_checked(2)}, getitem_checked(3) {copy.getitem_checked(3)}\n")
        tail: Slice[S64] = owned.getslice(1, 2)
        Out.write("getslice(1, 2): {tail.getitem(0)} {tail.getitem(1)}, first by address {owned.to[@S64]().peek()}\n")
        owned.resize(5)
        owned.setitem(4, 50)
        Out.write("after resize(5): count {owned.count()}, kept {owned.getitem(2)}, new {owned.getitem(4)}\n")
        show("  one block", counts)
        owned.resize(0)
        Out.write("after resize(0): count {owned.count()}\n")
        show("  given back", counts)
        owned.destruct()
        return()

/// A count of 0 allocates nothing, and destruct on an empty slice gives nothing back.
routine empty(counts: @Counts, alloc: @MemoryManager) -> Void
    block entry()
        claim nothing: @Slice[U8] <- .construct(0, alloc)
        Out.write("empty: count {nothing.count()}, getitem_checked(0) {nothing.getitem_checked(0)}\n")
        nothing.destruct()
        nothing.destruct()
        show("  after two destructs", counts)
        return()

/// destruct_all releases what each value owns, then the slice itself.
routine nested(counts: @Counts, alloc: @MemoryManager) -> Void
    block entry()
        claim rows: @Slice[List[S64]] <- .construct(2, alloc)
        rows.setitem(0, List[S64].construct(alloc))
        rows.setitem(1, List[S64].construct(alloc))
        rows.getslot(0).add_last(1)
        rows.getslot(1).add_last(2)
        rows.getslot(1).add_last(3)
        Out.write("rows: {rows.getitem(0)} {rows.getitem(1)}\n")
        show("  three blocks", counts)
        rows.destruct_all()
        show("  after destruct_all", counts)
        return()

/// Text from a Slice[Byte].
routine text(alloc: @MemoryManager) -> Void
    block entry()
        claim bytes: @Slice[Byte] <- .construct(2, alloc)
        bytes.setitem(0, b'o')
        bytes.setitem(1, b'k')
        copy: Slice[Byte] = bytes.peek()
        Out.write("text: {bytes.to[Bytes]()} {copy.to[Bytes]().count()}\n")
        bytes.destruct()
        return()

/// The _result forms against an allocator that refuses everything.
routine refused() -> Void
    block entry()
        refusing: MemoryManager = MemoryManager(alloc_fn: refuse_alloc.to[Callable](),
            realloc_fn: refuse_realloc.to[Callable](), free_fn: DEFAULT_HEAP.free_fn.peek(),
            state: null)
        claim alloc: @MemoryManager <- refusing
        made: Result[Slice[U8], AllocFailed] = Slice[U8].construct_result(4, alloc)
        Out.write("construct_result: failed {made.is_failure()}, {made.unwrap_failure()}\n")
        claim none: @Slice[U8] <- .construct(0, alloc)
        resized: Result[Unit, AllocFailed] = none.resize_result(4)
        Out.write("resize_result: {resized}, count still {none.count()}\n")
        return()

routine start() -> Void
    block entry()
        claim counts: @Counts <- (live: 0, calls: 0)
        counting: MemoryManager = MemoryManager(alloc_fn: counting_alloc.to[Callable](),
            realloc_fn: counting_realloc.to[Callable](), free_fn: counting_free.to[Callable](),
            state: counts)
        claim alloc: @MemoryManager <- counting
        values(counts, alloc)
        empty(counts, alloc)
        nested(counts, alloc)
        text(alloc)
        show("in the end", counts)
        refused()
        return()
