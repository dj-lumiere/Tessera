# A manager's table holds the manager's address: using it after the manager was dropped is a build error.

import Standard/Alloc
import Standard/Os

entity Counter
    calls: U64

obeys MemoryManageable[Counter]

common routine Counter.construct() -> Me
    return Me(calls: 0)

routine @Counter.destruct() -> None
    return

routine @Counter.alloc(size: U64, align: U64) -> Addr
    me.calls.peek().add(1).poke_into(me.calls)
    return HEAP.alloc(size, align)

@reshaping(at)
routine @Counter.realloc(at: Addr, size: U64, align: U64) -> Addr
    return HEAP.realloc(at, size, align)

routine @Counter.free(at: Addr) -> None
    HEAP.free(at)
    return

routine start() -> None
    local counter: @Counter <- .construct()
    local table: @MemoryManager <- counter.to[MemoryManager]()

    drop counter
    taken: Addr = table.alloc(size: 8, align: 8)
    HEAP.free(taken)
    return
