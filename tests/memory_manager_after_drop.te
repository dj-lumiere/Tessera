# A manager's table holds the manager's address: using it after the manager was dropped is a build error.

import Hosted

entity Counter
    calls: U64

obeys MemoryManageable[Counter]

common routine Counter.construct() -> Me
    return Me(calls: 0)

routine @Counter.destruct() -> None
    return

routine @Counter.borrow(size: U64, align: U64) -> Addr
    me.calls.peek().add(1).poke_into(me.calls)
    return HEAP.borrow(size, align)

@reshaping(at)
routine @Counter.reborrow(at: Addr, size: U64, align: U64) -> Addr
    return HEAP.reborrow(at, size, align)

routine @Counter.give_back(at: Addr) -> None
    HEAP.give_back(at)
    return

routine start() -> None
    counter: &Counter <- .construct()
    table: &MemoryManager <- counter.to[MemoryManager]()

    drop counter
    taken: Addr = table.borrow(size: 8, align: 8)
    HEAP.give_back(taken)
    return
