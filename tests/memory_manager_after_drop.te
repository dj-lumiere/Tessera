# A manager's table holds the manager's address: using it after the manager was dropped is a build error.

import Standard/Alloc
import Standard/Os

entity Counter
    calls: U64

obeys MemoryManageable[Counter]

routine Counter.construct() -> Me
    return Me(calls: 0)

routine Counter.destruct(me: @Me) -> None
    return

routine Counter.alloc(me: @Me, size: U64, align: U64) -> Addr
    me.calls.peek().add(1).poke_into(me.calls)
    return DEFAULT_HEAP.alloc(size, align)

@reshaping(at)
routine Counter.realloc(me: @Me, at: Addr, size: U64, align: U64) -> Addr
    return DEFAULT_HEAP.realloc(at, size, align)

routine Counter.free(me: @Me, at: Addr) -> None
    DEFAULT_HEAP.free(at)
    return

routine start() -> None
    local counter: @Counter <- .construct()
    local table: @MemoryManager <- counter.to[MemoryManager]()

    drop counter
    taken: Addr = table.alloc(size: 8, align: 8)
    DEFAULT_HEAP.free(taken)
    return
