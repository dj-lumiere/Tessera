# B128 gamma and ln_gamma (Standard/B128Gamma.te), correctly rounded: each line is a value and its
# bits, then the exact tier's bits alone. Every one was checked against mpmath, rounded to
# binary128. Poles and signs follow C: gamma(-0) = -inf, gamma of a negative integer or -inf is
# NaN, ln_gamma is +inf at the poles.

import Standard/Format
import Standard/Os

routine show(name: @[Byte], v: B128, exact: B128) -> None
    Console.show("{name} {v} {v.bits()} {exact.bits()}")
    return

routine start() -> None
    show(name: "gamma(nan)", v: b128_of(0x7FFF8000000000000000000000000000).gamma_unchecked(),
        exact: b128_gamma(x: b128_of(0x7FFF8000000000000000000000000000), exact: true))
    show(name: "ln_gamma(nan)", v: b128_of(0x7FFF8000000000000000000000000000).ln_gamma_unchecked(),
        exact: b128_ln_gamma(x: b128_of(0x7FFF8000000000000000000000000000), exact: true))
    show(name: "gamma(+0)", v: b128_of(0x00000000000000000000000000000000).gamma_unchecked(),
        exact: b128_gamma(x: b128_of(0x00000000000000000000000000000000), exact: true))
    show(name: "ln_gamma(+0)", v: b128_of(0x00000000000000000000000000000000).ln_gamma_unchecked(),
        exact: b128_ln_gamma(x: b128_of(0x00000000000000000000000000000000), exact: true))
    show(name: "gamma(-0)", v: b128_of(0x80000000000000000000000000000000).gamma_unchecked(),
        exact: b128_gamma(x: b128_of(0x80000000000000000000000000000000), exact: true))
    show(name: "ln_gamma(-0)", v: b128_of(0x80000000000000000000000000000000).ln_gamma_unchecked(),
        exact: b128_ln_gamma(x: b128_of(0x80000000000000000000000000000000), exact: true))
    show(name: "gamma(+inf)", v: b128_of(0x7FFF0000000000000000000000000000).gamma_unchecked(),
        exact: b128_gamma(x: b128_of(0x7FFF0000000000000000000000000000), exact: true))
    show(name: "ln_gamma(+inf)", v: b128_of(0x7FFF0000000000000000000000000000).ln_gamma_unchecked(),
        exact: b128_ln_gamma(x: b128_of(0x7FFF0000000000000000000000000000), exact: true))
    show(name: "gamma(-inf)", v: b128_of(0xFFFF0000000000000000000000000000).gamma_unchecked(),
        exact: b128_gamma(x: b128_of(0xFFFF0000000000000000000000000000), exact: true))
    show(name: "ln_gamma(-inf)", v: b128_of(0xFFFF0000000000000000000000000000).ln_gamma_unchecked(),
        exact: b128_ln_gamma(x: b128_of(0xFFFF0000000000000000000000000000), exact: true))
    show(name: "gamma(-1)", v: b128_of(0xBFFF0000000000000000000000000000).gamma_unchecked(),
        exact: b128_gamma(x: b128_of(0xBFFF0000000000000000000000000000), exact: true))
    show(name: "ln_gamma(-1)", v: b128_of(0xBFFF0000000000000000000000000000).ln_gamma_unchecked(),
