<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Lapila</string>
    <key>scopeName</key>
    <string>source.lpa</string>
    <key>fileTypes</key>
    <array>
        <string>lpa</string>
    </array>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comment</string></dict>
        <dict><key>include</key><string>#annotation</string></dict>
        <dict><key>include</key><string>#string</string></dict>
        <dict><key>include</key><string>#char</string></dict>
        <dict><key>include</key><string>#number</string></dict>
        <dict><key>include</key><string>#module-decl</string></dict>
        <dict><key>include</key><string>#routine-decl</string></dict>
        <dict><key>include</key><string>#block-decl</string></dict>
        <dict><key>include</key><string>#record-decl</string></dict>
        <dict><key>include</key><string>#member-decl</string></dict>
        <dict><key>include</key><string>#concept-decl</string></dict>
        <dict><key>include</key><string>#preset-decl</string></dict>
        <dict><key>include</key><string>#expression</string></dict>
    </array>
    <key>repository</key>
    <dict>

        <!-- ### doc comment (Markdown, so `code` spans stand out) and # line comment -->
        <key>comment</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>comment.line.documentation.lpa</string>
                    <key>begin</key>
                    <string>###</string>
                    <key>end</key>
                    <string>$</string>
                    <key>patterns</key>
                    <array>
                        <dict>
                            <key>name</key>
                            <string>markup.inline.raw.lpa</string>
                            <key>match</key>
                            <string>`[^`]*`</string>
                        </dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key>
                    <string>comment.line.number-sign.lpa</string>
                    <key>match</key>
                    <string>#.*$</string>
                </dict>
            </array>
        </dict>

        <!-- @[key("val"), key], bare @word, and @word(args) annotations, such as @derive(Equatable, Hashable). A grammar sees
             no structure, so a list is told from a span type (@[Byte]) by its lowercase names; the language server's
             colors, which follow where the line stands, replace these once a check has run. -->
        <key>annotation</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>meta.annotation.lpa</string>
                    <key>begin</key>
                    <string>@\[(?=[a-z_])</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>variable.parameter.sigil.annotation.lpa</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\]</string>
                    <key>endCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>variable.parameter.sigil.annotation.lpa</string></dict>
                    </dict>
                    <key>patterns</key>
                    <array>
                        <dict>
                            <key>match</key>
                            <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\(|,|\])</string>
                            <key>captures</key>
                            <dict>
                                <key>1</key>
                                <dict><key>name</key><string>entity.other.attribute-name.lpa</string></dict>
                            </dict>
                        </dict>
                        <dict><key>include</key><string>#annotation-args</string></dict>
                        <dict><key>include</key><string>#string</string></dict>
                        <dict><key>include</key><string>#number</string></dict>
                        <dict><key>include</key><string>#comment</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key>
                    <string>meta.annotation.lpa</string>
                    <key>begin</key>
                    <string>(@)([a-z_][a-zA-Z0-9_]*)\s*(\()</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.parameter.sigil.annotation.lpa</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.other.attribute-name.lpa</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\)</string>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#annotation-arg-body</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(@)([a-z_][a-zA-Z0-9_]*)\b</string>
                    <key>name</key>
                    <string>meta.annotation.lpa</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.parameter.sigil.annotation.lpa</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.other.attribute-name.lpa</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- (...) argument list of an annotation, with nested parentheses -->
        <key>annotation-args</key>
        <dict>
            <key>begin</key>
            <string>\(</string>
            <key>end</key>
            <string>\)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#annotation-arg-body</string></dict>
            </array>
        </dict>

        <key>annotation-arg-body</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#annotation-args</string></dict>
                <dict><key>include</key><string>#string</string></dict>
                <dict><key>include</key><string>#char</string></dict>
                <dict><key>include</key><string>#number</string></dict>
                <dict><key>include</key><string>#comment</string></dict>
                <dict>
                    <key>match</key>
                    <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)(?!:)</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.parameter.annotation.lpa</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#types</string></dict>
            </array>
        </dict>

        <!-- "strings", with escapes and write/print template holes: "x = {x}, {{literal}}" -->
        <key>string</key>
        <dict>
            <key>name</key>
            <string>string.quoted.double.lpa</string>
            <key>begin</key>
            <string>"</string>
            <key>end</key>
            <string>"</string>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.character.escape.lpa</string>
                    <key>match</key>
                    <string>\\(?:[ntr0\\"']|x[0-9a-fA-F]{2})</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.character.escape.lpa</string>
                    <key>match</key>
                    <string>\{\{|\}\}</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>meta.embedded.expression.lpa</string>
                    <key>begin</key>
                    <string>\{</string>
                    <key>beginCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.section.embedded.begin.lpa</string></dict>
                    </dict>
                    <key>end</key>
                    <string>\}</string>
                    <key>endCaptures</key>
                    <dict>
                        <key>0</key>
                        <dict><key>name</key><string>punctuation.section.embedded.end.lpa</string></dict>
                    </dict>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#char</string></dict>
                        <dict><key>include</key><string>#number</string></dict>
                        <dict><key>include</key><string>#expression</string></dict>
                    </array>
                </dict>
            </array>
        </dict>

        <!-- b'A' b'\x7f' (Byte) and 'A' '\n' (Char) literals -->
        <key>char</key>
        <dict>
            <key>name</key>
            <string>string.quoted.single.lpa</string>
            <key>match</key>
            <string>b?'(?:\\(?:[ntr0\\"']|x[0-9a-fA-F]{2})|[^\\'])'</string>
        </dict>

        <!-- numbers: 0xFF 0b1010 0o17 1_000 -5 3.14 1.5e10 2e-3 0x1.8p+46 -->
        <key>number</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.float.hex.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0x[0-9a-fA-F_]*(?:\.[0-9a-fA-F_]*)?[pP][+-]?[0-9]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.hex.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0x[0-9a-fA-F_]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.binary.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0b[01_]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.octal.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?0o[0-7_]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.unit.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])[0-9][0-9_]*(?:ns|us|ms|s|m|h|d|w|b|kb|mb|gb|kib|mib|gib)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.float.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?[0-9][0-9_]*(?:\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.integer.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![\w.])-?[0-9][0-9_]*\b</string>
                </dict>
            </array>
        </dict>

        <!-- module System, import Hosted -->
        <key>module-decl</key>
        <dict>
            <key>match</key>
            <string>^(module|import)\s+([A-Z][A-Za-z0-9_]*(?:/[A-Z][A-Za-z0-9_]*)*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.namespace.lpa</string></dict>
            </dict>
        </dict>

        <!-- [secret] [common] routine [@]Foo[T].bar(...) or routine foo[T](...) -->
        <key>routine-decl</key>
        <dict>
            <key>match</key>
            <string>^\s*(?:(secret)\s+)?(?:(common)\s+)?(routine)\s+@?(?:([A-Za-z_][A-Za-z0-9_]*(?:\[[^\](]*\])?)(\.))?([A-Za-z_][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>storage.modifier.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>storage.modifier.lpa</string></dict>
                <key>3</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>4</key>
                <dict><key>name</key><string>entity.name.type.lpa</string></dict>
                <key>6</key>
                <dict><key>name</key><string>entity.name.function.lpa</string></dict>
            </dict>
        </dict>

        <!-- block entry() or block loop(i: U64) -->
        <key>block-decl</key>
        <dict>
            <key>match</key>
            <string>\b(block)\s+([a-zA-Z_][a-zA-Z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.label.lpa</string></dict>
            </dict>
        </dict>

        <!-- record Foo<T>, then its require / conform lines and its fields -->
        <key>record-decl</key>
        <dict>
            <key>begin</key>
            <string>^(?:(secret)\s+)?(record|entity)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>beginCaptures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>storage.modifier.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>3</key>
                <dict><key>name</key><string>entity.name.type.lpa</string></dict>
            </dict>
            <key>end</key>
            <string>^(?=\S)(?!require\b|conform\b)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#comment</string></dict>
                <dict><key>include</key><string>#annotation</string></dict>
                <dict>
                    <key>match</key>
                    <string>^\s+(?:(secret)\s+)?([a-z_][A-Za-z0-9_]*)\s*(?=:)</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>storage.modifier.lpa</string></dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.property.lpa</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#expression</string></dict>
            </array>
        </dict>

        <!-- choice Color: U8, flags CellMarks and variant Expr, then their members and cases -->
        <key>member-decl</key>
        <dict>
            <key>begin</key>
            <string>^(?:(secret)\s+)?(choice|flags|variant)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>beginCaptures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>storage.modifier.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>3</key>
                <dict><key>name</key><string>entity.name.type.lpa</string></dict>
            </dict>
            <key>end</key>
            <string>^(?=\S)(?!require\b|conform\b)</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#comment</string></dict>
                <dict>
                    <key>match</key>
                    <string>^\s+([A-Z][A-Za-z0-9_]*)\b</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>variable.other.enummember.lpa</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#number</string></dict>
                <dict><key>include</key><string>#expression</string></dict>
            </array>
        </dict>

        <!-- concept Equatable<T> -->
        <key>concept-decl</key>
        <dict>
            <key>match</key>
            <string>\b(concept)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.lpa</string></dict>
            </dict>
        </dict>

        <!-- preset PI: B64 = ..., preset B64.MAX: B64 = ..., preset K: &Array[U32, 4] <- [ ... ], global TICKS: &U32 -->
        <key>preset-decl</key>
        <dict>
            <key>match</key>
            <string>\b(preset|global)\s+(?:([A-Z][A-Za-z0-9_]*)(\.))?([A-Z_][A-Za-z0-9_]*)\b</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.lpa</string></dict>
                <key>4</key>
                <dict><key>name</key><string>variable.other.constant.lpa</string></dict>
            </dict>
        </dict>

        <!-- everything that can appear in a routine body or a type position -->
        <key>expression</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#jump-target</string></dict>
                <dict><key>include</key><string>#keywords</string></dict>
                <dict><key>include</key><string>#values</string></dict>
                <dict><key>include</key><string>#namespace</string></dict>
                <dict><key>include</key><string>#calls</string></dict>
                <dict><key>include</key><string>#members</string></dict>
                <dict><key>include</key><string>#types</string></dict>
                <dict><key>include</key><string>#punctuation</string></dict>
            </array>
        </dict>

        <!-- jump loop(...): the block it goes to -->
        <key>jump-target</key>
        <dict>
            <key>match</key>
            <string>\b(jump)\s+([a-z_][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.control.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.label.lpa</string></dict>
            </dict>
        </dict>

        <key>keywords</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>comment</key>
                    <string>A named jump: break to rows, continue to rows, and a loop named with loop as rows</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(break|continue)\s+(to)\s+([A-Za-z_]\w*)|(?&lt;![#\w`.])(loop)\s+(as)\s+([A-Za-z_]\w*)</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key><dict><key>name</key><string>keyword.control.lpa</string></dict>
                        <key>2</key><dict><key>name</key><string>keyword.control.lpa</string></dict>
                        <key>3</key><dict><key>name</key><string>entity.name.label.lpa</string></dict>
                        <key>4</key><dict><key>name</key><string>keyword.control.lpa</string></dict>
                        <key>5</key><dict><key>name</key><string>keyword.control.lpa</string></dict>
                        <key>6</key><dict><key>name</key><string>entity.name.label.lpa</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.control.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(branch|jump|return|throw|try|check|unreachable|when|if|elseif|else|for|until|loop|then|with|break|continue|nothing|todo)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.other.declaration.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(routine|failable|crashable|block|record|entity|choice|variant|concept|conform|preset|global|module|import|define|shared|steal)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>storage.modifier.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(secret)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.other.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(require|needs|obeys|AnyType|RecordType|uninit|drop|and|or|is|as)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.language.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(true|false)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.float.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![#\w`.])(inf|nan)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.other.me.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![.\w`])Me\b</string>
                </dict>
            </array>
        </dict>

        <!-- a value: a lowercase name that isn't called, a field, or a path; me colors like the Me keyword -->
        <key>values</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>keyword.other.me.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![.\w`])me\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>variable.parameter.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![.\w`#@])[a-z_][A-Za-z0-9_]*\b(?!\s*[(\[]|/(?!/))</string>
                </dict>
            </array>
        </dict>

        <!-- Standard/Collections/ in a qualified path -->
        <key>namespace</key>
        <dict>
            <key>match</key>
            <string>\b([A-Z][A-Za-z0-9_]*)(/)(?!/)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>entity.name.namespace.lpa</string></dict>
                <key>2</key>
                <dict><key>name</key><string>punctuation.separator.namespace.lpa</string></dict>
            </dict>
        </dict>

        <!-- x.method(...), routine(...), routine<T>(...), and a block called from branch / when -->
        <key>calls</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>match</key>
                    <string>(\.)([a-z_][A-Za-z0-9_]*)(?=\s*[(\[])</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>entity.name.function.method.lpa</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(?&lt;![#`\w.])([a-z_][A-Za-z0-9_]*)(?=\s*[(\[])</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>entity.name.function.call.lpa</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- .field, .CONSTANT, and .Case / Color.Red after a dot -->
        <key>members</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>match</key>
                    <string>(\.)([A-Z][A-Z0-9_]+)\b(?![a-z])</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.constant.lpa</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(\.)([A-Z][A-Za-z0-9_]*)\b</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.enummember.lpa</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>match</key>
                    <string>(\.)([a-z_][A-Za-z0-9_]*)\b</string>
                    <key>captures</key>
                    <dict>
                        <key>2</key>
                        <dict><key>name</key><string>variable.other.property.lpa</string></dict>
                    </dict>
                </dict>
            </array>
        </dict>

        <!-- built-in types, presets (UPPER_CASE), and other types (PascalCase, T) -->
        <key>types</key>
        <dict>
            <key>patterns</key>
            <array>
                <!-- @T is PointedCell[T]; the @ is a sigil, colored like a value -->
                <dict>
                    <key>name</key>
                    <string>variable.parameter.sigil.pointer.lpa</string>
                    <key>match</key>
                    <string>@+</string>
                </dict>
                <!-- &T is BorrowedCell[T] and &[T] is BorrowedSlice[T], borrowed from a manager: a sigil of its own, apart from @'s view.
                     Only in front of a type, so the operator & stays an operator. -->
                <dict>
                    <key>name</key>
                    <string>storage.modifier.sigil.borrowed.lpa</string>
                    <key>match</key>
                    <string>&amp;+(?=[\[A-Z@])</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>support.type.primitive.lpa</string>
                    <key>match</key>
                    <string>\b(S8|S16|S32|S64|S128|S256|U8|U16|U32|U64|U128|U256|CSize|CSSize|Byte|Char|B16|BF16|B32|B64|B128|Bool|Void|Unit|CInt|CLong|CWChar|PointedCell|Addr|Array|Callable)\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>variable.other.constant.lpa</string>
                    <key>match</key>
                    <string>\b[A-Z][A-Z0-9]*_[A-Z0-9_]*\b|\b[A-Z]{2,}\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>entity.name.type.lpa</string>
                    <key>match</key>
                    <string>\b[A-Z][A-Za-z0-9_]*\b</string>
                </dict>
            </array>
        </dict>

        <!-- no operators: only the arrows (-> and the <- that borrows a place), the select / branch marks, binding, and paths -->
        <key>punctuation</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>keyword.operator.arrow.lpa</string>
                    <key>match</key>
                    <string>-&gt;|=&gt;|&lt;-(?!\d)</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.operator.ternary.lpa</string>
                    <key>match</key>
                    <string>\?</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>keyword.operator.assignment.lpa</string>
                    <key>match</key>
                    <string>(?&lt;![=!&lt;&gt;])=(?![=&gt;])</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>punctuation.separator.namespace.lpa</string>
                    <key>match</key>
                    <string>(?&lt;=\w)/(?=[A-Z])</string>
                </dict>
            </array>
        </dict>

    </dict>
</dict>
</plist>
