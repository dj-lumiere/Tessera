# Collatz sequences: which start below 1000 takes the most steps to reach 1?
#
# Introduces:
#   a nested loop split into two routines instead of one tangled block graph
#   carrying the best-so-far through the outer loop's block parameters

import Standard/Format
import Standard/Os

### Counts the steps from `start` to 1, where a step takes `n` to `n / 2` if `n` is even and to `3n + 1` if odd.
### :param start: The first number of the sequence.
### :returns: The number of steps, 0 when `start` is 0 or 1.
### :throws: Crashes with `IntegerOverflowError` when some `3n + 1` along the way doesn't fit in a U64.
routine collatz_steps(start: U64) -> U64
    local steps: @U64 <- 0

    until n <= 1 with n: U64 = start
        is_even: Bool = n % 2 == 0
        halved: U64 = n // 2
        tripled: U64 = n * 3 + 1
        after: U64 = when
            is_even => halved
            else => tripled
        (steps.peek() + 1).poke_into(steps)
        continue with n: after
    then
        return steps.peek()

### Prints the steps for 27, then finds the start below 1000 with the most steps (the first one, on a tie) and prints
### it.
routine start() -> None
    local out: @ConsoleOutput = Console.output()

    out.write("steps(27) = {collatz_steps(27)}\n")

    while start < 1000 with start: U64 = 1, best_start: U64 = 1, best_steps: U64 = 0
        steps: U64 = collatz_steps(start)
        if steps > best_steps
            continue with start: start + 1, best_start: start, best_steps: steps
        else
            continue with start: start + 1, best_start: best_start, best_steps: best_steps
    then
        out.write("longest below 1000: {best_start} with {best_steps} steps\n")
        return
