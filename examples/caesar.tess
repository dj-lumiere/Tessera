// The Caesar cipher: shift each letter by a fixed amount, wrapping around the alphabet.
//
// Introduces:
//   Byte for raw text: compared with byte literals, converted to U8 for arithmetic
//   a stack buffer: a claimed Array<Byte, 64> that starts <- uninit, filled through its @Byte
//   Bytes.from_ptr to view bytes as a Bytes

import Standard::Format
import Standard::Os

/// shift is in 0 ..< 26. Letters keep their case; everything else passes through.
routine shift_letter(c: Byte, shift: U8) -> Byte
    block entry():
        is_upper : Bool = c.between(b'A', b'Z')
        is_lower : Bool = c.between(b'a', b'z')
        when:
            is_upper -> rotate(b'A')
            is_lower -> rotate(b'a')
            else     -> return(c)

    block rotate(base: Byte):
        offset  : U8 = c.to<U8>().sub(base.to<U8>())
        shifted : U8 = offset.add(shift).mod(26)
        return(shifted.add(base.to<U8>()).bits())

/// Writes length shifted bytes of text to result.
routine caesar(text: @Byte, length: USize, shift: U8, result: @Byte) -> Void
    block entry():
        jump loop(0)

    block loop(i: USize):
        done : Bool = i.ge(length)
        branch done
            ? return()
            : continue
        c : Byte = text.stride(i).load()
        result.stride(i).store(shift_letter(c, shift))
        jump loop(i.add(1))

routine main() -> S32
    block entry():
        claim out : @FdWriter <- .stdout()

        plain  : Bytes = "Veni, vidi, vici. Zebra!"
        length : USize = plain.length
        claim secret_buf : @Array<Byte, 64> <- uninit
        claim back_buf   : @Array<Byte, 64> <- uninit
        secret : @Byte = secret_buf.to<@Byte>()
        back   : @Byte = back_buf.to<@Byte>()

        caesar(plain.data, length, 3, secret)
        caesar(secret, length, 23, back)  // 3 + 23 = 26, a full turn

        write(out,
                "plain:  {plain}\nsecret: {Bytes.from_ptr(secret, length)}\nback:   {Bytes.from_ptr(back, length)}\n")
        return(0)
