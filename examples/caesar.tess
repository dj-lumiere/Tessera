// The Caesar cipher: shift each letter by a fixed amount, wrapping around the alphabet.
//
// Introduces:
//   Byte for raw text: compared with byte literals, converted to U8 for arithmetic
//   a stack buffer: a claimed Array[Byte, 64] that starts <- uninit, filled through its @Byte
//   Span[Byte].from_ptr to view bytes as a Span[Byte]

import Standard/Format
import Standard/Os

/// Shifts one ASCII letter `shift` places forward in the alphabet, wrapping from `z` back to `a`. Letters keep their
/// case. Everything else passes through unchanged.
/// :param c: The byte to shift.
/// :param shift: How far to shift, in 0 ..< 26.
/// :returns: The shifted letter, or `c` itself when it isn't a letter.
/// :throws: Crashes with `IntegerOverflowError` when `shift` is so large (above 230) that the letter's offset plus
///     `shift` doesn't fit in a U8.
routine shift_letter(c: Byte, shift: U8) -> Byte
    is_upper: Bool = c.between(lo: b'A', hi: b'Z')
    when
        is_upper =>
            base: Byte = b'A'
            offset: U8 = c.to[U8]() - base.to[U8]()
            shifted: U8 = (offset + shift) % 26
            return (shifted + base.to[U8]()).bits()
        c.between(lo: b'a', hi: b'z') =>
            base: Byte = b'a'
            offset: U8 = c.to[U8]() - base.to[U8]()
            shifted: U8 = (offset + shift) % 26
            return (shifted + base.to[U8]()).bits()
        else => return c

/// Writes the first `count` bytes of `text` to `result`, each letter shifted by `shift` with `shift_letter`.
/// :param text: The bytes to encrypt.
/// :param count: How many bytes to encrypt.
/// :param shift: How far to shift each letter, in 0 ..< 26.
/// :param result: Where the shifted bytes go, with room for `count` bytes.
routine caesar(text: @Byte, count: USize, shift: U8, result: @Byte) -> None
    each i in 0 til count
        c: Byte = text.stride(i).peek()
        result.stride(i).poke(shift_letter(c, shift))
    then
        return

/// Encrypts a sentence with a shift of 3, decrypts it with a shift of 23 (a full turn of 26 in all), and prints all
/// three versions.
routine start() -> None
    out: @Out = Out.writer()

    plain: Span[Byte] = "Veni, vidi, vici. Zebra!"
    count: USize = plain.count
    local secret_buf: @Array[Byte, 64] <- .hollow()
    local back_buf: @Array[Byte, 64] <- .hollow()
    secret: @Byte = secret_buf.to[@Byte]()
    back: @Byte = back_buf.to[@Byte]()

    caesar(text: plain.data, count, shift: 3, result: secret)
    caesar(text: secret, count, shift: 23, result: back)  // 3 + 23 = 26, a full turn

    out.write("plain:  {plain}\nsecret: {Span[Byte].construct(data: secret, count)}\nback:   {Span[Byte].construct(data: back, count)}\n")
    return
