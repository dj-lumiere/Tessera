# Insertion sort on a fixed-size array, then the same data sorted by List.sort.
#
# Introduces:
#   Items[T, N] on the stack: a place borrowed with <- a preset's contents, then bounds-checked getitem / getslot
#   a nested loop written as two routines: sort (outer) and insert (inner)
#   generic code from the stdlib: List[S64].sort

import Collections
import Hosted

preset INPUT: Items[S64, 8] = [31, -4, 15, 9, 0, 26, -4, 5]

### Moves `data[i]` left past every larger value before it, so `data[0 ..= i]` is sorted when `data[0 ..< i]` already
### was.
### :param data: The array being sorted.
### :param i: The index of the value to move into place.
### :throws: Crashes with `IndexOutOfBoundsError` when `i` is 8 or more.
routine insert(data: @Items[S64, 8], i: U64) -> None
    value: S64 = data[i]

    ### Everything right of hole is larger than value and has already moved one step right.
    until hole == 0 with hole: U64 = i
        left: U64 = hole - 1
        neighbor: S64 = data[left]
        if neighbor > value
            data[hole] = neighbor
            continue with hole: hole - 1
        else
            data[hole] = value
            return
    then
        data[hole] = value
        return

### Sorts `data` ascending in place by inserting each value, left to right, into the sorted part before it.
### :param data: The array to sort.
routine insertion_sort(data: @Items[S64, 8]) -> None
    for i in 1 til Items[S64, 8].count()
        insert(data, i)
    then
        return

### Writes the values of `data`, each after a space, and ends the line.
### :param out: Where the line goes.
### :param data: The array to write.
routine print_array(out: @ConsoleOutput, data: @Items[S64, 8]) -> None
    for i in 0 til Items[S64, 8].count()
        out.write(" {data.getitem(i)}")
    out.write("\n")
    return

### Writes the values of `list`, each after a space, and ends the line.
### :param out: Where the line goes.
### :param list: The list to write.
routine print_list(out: @ConsoleOutput, list: @List[S64]) -> None
    count: U64 = list.count()

    for i in 0 til count
        out.write(" {list.getitem(i)}")
    out.write("\n")
    return

### Sorts a copy of `INPUT` with `insertion_sort`, then the same values in a `List` with `List.sort`, and prints
### the array before and after and the sorted list.
routine start() -> None
    out: @ConsoleOutput = Console.output()
    list: &List[S64] <- .hollow()
    manager: @MemoryManager = HEAP
    # Copy the read-only preset into a stack array we can sort.
    data: &Items[S64, 8] <- INPUT

    out.write("before:")
    print_array(out, data)
    insertion_sort(data)
    out.write("after: ")
    print_array(out, data)

    list.store(.construct(manager))

    for i in 0 til Items[S64, 8].count()
        list.add_last(INPUT.getitem(i))
    list.sort()
    out.write("List:  ")
    print_list(out, list)
    drop list
    return
