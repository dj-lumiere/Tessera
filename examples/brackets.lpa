# Check that (), [], and {} are balanced, using a List[Byte] as a stack.
#
# Introduces:
#   List[T] as a stack: push, pop, is_empty
#   a choice as the result of a check, and a when that lists every member
#   the finish convention: every exit jumps to one block named finish, which destructs the stack once

import Collections
import Hosted

choice Balance: U8
    BALANCED: 0
    MISMATCHED: 1
    UNCLOSED: 2

### The closing bracket that matches an opening one.
### :param open: An opening bracket: `(`, `[`, or `{`.
### :returns: `)` for `(`, `]` for `[`, and `}` for anything else.
routine closer_of(open: Byte) -> Byte
    when
        open == b'(' => return b')'
        open == b'[' => return b']'
        else => return b'}'

### Checks that every `(`, `[`, and `{` in `text` is closed by its own kind of bracket, in the right order. Other
### bytes are skipped.
### :param text: The text to check.
### :param manager: The memory manager for the stack of expected closers.
### :returns: `Balanced`, `Mismatched` when a closer has no opener or closes the wrong kind, or `Unclosed` when the
###     text ends with brackets still open.
### :throws: Crashes with `OutOfMemoryError` when the stack can't grow.
routine check_balance(text: @[Byte], manager: @MemoryManager) -> Balance
    stack: &List[Byte] <- .construct(manager)

    ### stack holds the closers still expected, the innermost last.
    for i in 0 til text.count
        data: @Byte = text.data
        c: Byte = data.stride(i).peek()
        round_or_square_open: Bool = c == b'(' or c == b'['
        opens: Bool = round_or_square_open or c == b'{'
        round_or_square_close: Bool = c == b')' or c == b']'
        when
            opens =>
                stack.add_last(closer_of(c))
                continue
            round_or_square_close or c == b'}' =>
                if stack.is_empty()
                    ### Every exit comes here, so the stack is destructed exactly once.
                    drop stack
                    return Balance.MISMATCHED
                else
                    expected: Byte = stack.remove_last()
                    if expected == c
                        continue
                    else
                        drop stack
                        return Balance.MISMATCHED
            else => continue
    if stack.is_empty()
        drop stack
        return Balance.BALANCED
    else
        drop stack
        return Balance.UNCLOSED

### Writes `text` and its verdict from `check_balance`: balanced, mismatched, or unclosed.
### :param out: Where the line goes.
### :param text: The text to check.
### :param manager: The memory manager `check_balance` uses for its stack.
routine report(out: @ConsoleOutput, text: @[Byte], manager: @MemoryManager) -> None
    out.write("{text}  ->  ")
    result: Balance = check_balance(text, manager)
    verdict: @[Byte] = when result
        Balance.BALANCED => "balanced"
        Balance.MISMATCHED => "mismatched"
        Balance.UNCLOSED => "unclosed"
    out.write("{verdict}\n")
    return

### Checks five strings, one for each outcome plus one without brackets, and prints the verdicts.
routine start() -> None
    out: @ConsoleOutput = Console.output()
    manager: @MemoryManager = HEAP

    report(out, text: "f(a[i], {b: (c)})", manager)
    report(out, text: "(]", manager)
    report(out, text: "((x)", manager)
    report(out, text: "x)", manager)
    report(out, text: "no brackets", manager)
    return
