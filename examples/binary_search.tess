// Binary search over a sorted preset array.
//
// Introduces:
//   preset arrays: read-only static data, read with get, turned into a Ptr<T> with to_ptr
//   returning Option<U64> for "found at index" or "not there"
//   a three-way when: as the loop's decision

preset SORTED: Array<S64, 10> = [-8, -3, 0, 2, 7, 11, 19, 23, 42, 57]

/// Searches #data[0 ..< %length], which must be sorted ascending.
routine binary_search(#data: Ptr<S64>, %length: U64, %target: S64) -> Option<U64>
    block entry():
        jump narrow(0, %length)

    /// The target, if present, is in [%lo, %hi).
    block narrow(%lo: U64, %hi: U64):
        %empty : Bool = %lo.ge(%hi)
        branch %empty ? return(Option<U64>.Absent) : continue
        %mid   : U64 = %lo.add(%hi.sub(%lo).div(2))
        %value : S64 = #data[%mid].load()
        when:
            %value.eq(%target) -> return(Option<U64>.Present(%mid))
            %value.lt(%target) -> narrow(%mid.add(1), %hi)
            _                  -> narrow(%lo, %mid)

routine report(#out: Ptr<FdWriter>, %target: S64) -> Void
    block entry():
        %found : Option<U64> = binary_search(SORTED.to_ptr(), Array<S64, 10>.length(), %target)
        %target.represent(#out)
        when %found:
            .Present(%index) -> at_index(%index)
            .Absent          -> missing()

    block at_index(%index: U64):
        write(#out, " is at index {%index}\n")
        return()

    block missing():
        write(#out, " is not in the array\n")
        return()

routine main() -> S32
    block entry():
        %stdout : FdWriter = .stdout()
        claim #out : Ptr<FdWriter>
        #out.store(%stdout)
        report(#out, 23)
        report(#out, -8)
        report(#out, 57)
        report(#out, 5)
        report(#out, 100)
        return(0)
