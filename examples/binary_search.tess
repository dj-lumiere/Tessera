# Binary search over a sorted preset array.
#
# Introduces:
#   a preset Span: read-only static data, declared Span[T] and filled with <- [ ... ], its count the literal's,
#   read with getitem
#   returning Maybe[USize] for "found at index" or "not there"
#   a three-way when as the loop's decision

import Standard/Format
import Standard/Os

preset SORTED: Span[S64] <- [-8, -3, 0, 2, 7, 11, 19, 23, 42, 57]

### Looks for `target` in `data` by halving the range still to search.
### :param data: The values to search, sorted ascending.
### :param target: The value to look for.
### :returns: `index` of a value equal to `target`, or `Unit` when no value equals it.
routine binary_search(data: Span[S64], target: S64) -> Maybe[USize]
    ### The target, if present, is in [lo, hi).
    while lo < hi with lo: USize = 0, hi: USize = data.count
        mid: USize = lo + (hi - lo) // 2
        value: S64 = data[mid]
        when
            value == target => return mid
            value < target => continue with lo: mid + 1, hi: hi
            else => continue with lo: lo, hi: mid
    then
        return None()

### Writes `target` and where `binary_search` finds it in `SORTED`, or that it is not there.
### :param out: Where the line goes.
### :param target: The value to look for.
routine report(out: @Out, target: S64) -> None
    found: Maybe[USize] = binary_search(data: SORTED, target)
    target.represent_into(out)
    when found
        is USize as index =>
            out.write(" is at index {index}\n")
            return
        is None =>
            out.write(" is not in the array\n")
            return

### Searches `SORTED` for five values (first, last, middle, and two that are missing) and prints each result.
routine start() -> None
    out: @Out = Out.writer()
    report(out, target: 23)
    report(out, target: -8)
    report(out, target: 57)
    report(out, target: 5)
    report(out, target: 100)
    return
