// Binary search over a sorted preset array.
//
// Introduces:
//   a preset in memory: read-only static data, declared @Array<T, N> and filled with <- { ... },
//   read with get, turned into a @T with to<@T>
//   returning Option<USize> for "found at index" or "not there"
//   a three-way when as the loop's decision

import Standard::Format
import Standard::Os

preset SORTED: @Array<S64, 10> <- { -8, -3, 0, 2, 7, 11, 19, 23, 42, 57 }

/// Looks for `target` in `data[0 ..< count]` by halving the range still to search.
/// :param data: The first of the values to search, sorted ascending.
/// :param count: How many values there are.
/// :param target: The value to look for.
/// :returns: `Present(index)` of a value equal to `target`, or `Absent` when no value equals it.
routine binary_search(data: @S64, count: USize, target: S64) -> Option<USize>
    block entry()
        jump narrow(0, count)

    /// The target, if present, is in [lo, hi).
    block narrow(lo: USize, hi: USize)
        empty : Bool = lo.ge(hi)
        branch empty
            ? return(Option<USize>.Absent)
            : continue
        mid   : USize = lo.add(hi.sub(lo).div(2))
        value : S64   = data.stride(mid).load()
        when
            value.eq(target) -> return(Option<USize>.Present(mid))
            value.lt(target) -> narrow(mid.add(1), hi)
            else             -> narrow(lo, mid)

/// Writes `target` and where `binary_search` finds it in `SORTED`, or that it is not there.
/// :param out: Where the line goes.
/// :param target: The value to look for.
routine report(out: @Out, target: S64) -> Void
    block entry()
        found : Option<USize> = binary_search(SORTED.to<@S64>(), Array<S64, 10>.count(), target)
        target.represent_into(out)
        when found
            .Present(index) -> at_index(index)
            .Absent         -> missing()

    block at_index(index: USize)
        out.write(" is at index {index}\n")
        return()

    block missing()
        out.write(" is not in the array\n")
        return()

/// Searches `SORTED` for five values (first, last, middle, and two that are missing) and prints each result.
routine start() -> Void
    block entry()
        out : @Out = Out.writer()
        report(out, 23)
        report(out, -8)
        report(out, 57)
        report(out, 5)
        report(out, 100)
        return()
