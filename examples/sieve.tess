// The sieve of Eratosthenes: every prime up to 50, and how many there are below 10,000.
//
// Introduces:
//   heap memory through an Allocator: allocate<T>, zeroinit, free
//   raw element access with stride (address arithmetic), load and store
//   a routine that owns its memory and frees it before returning

import Standard::Alloc
import Standard::Format
import Standard::Os

/// Returns a table of limit + 1 flags where table[n] is true when n is composite (0 and 1 count as composite).
/// The caller frees it.
routine sieve(limit: USize, alloc: @Allocator) -> @Bool
    block entry():
        slots     : USize = limit.add(1)
        composite : @Bool = allocate<Bool>(alloc, slots)
        failed    : Bool  = composite.is_null()
        branch failed
            ? panic(TrapCode.AllocFailed)
            : clear(composite)

    block clear(composite: @Bool):
        composite.zeroinit(limit.add(1))
        composite.stride(0).store(true)
        composite.stride(1).store(true)
        jump outer(composite, 2)

    /// Only factors up to sqrt(limit) need crossing out.
    block outer(composite: @Bool, p: USize):
        past_root : Bool = p.mul(p).gt(limit)
        branch past_root
            ? return(composite)
            : continue
        crossed : Bool = composite.stride(p).load()
        branch crossed
            ? outer(composite, p.add(1))
            : cross_out(composite, p, p.mul(p))

    block cross_out(composite: @Bool, p: USize, multiple: USize):
        done : Bool = multiple.gt(limit)
        branch done
            ? outer(composite, p.add(1))
            : mark(composite, p, multiple)

    block mark(composite: @Bool, p: USize, multiple: USize):
        composite.stride(multiple).store(true)
        jump cross_out(composite, p, multiple.add(p))

routine print_primes(out: @FdWriter, limit: USize, alloc: @Allocator) -> Void
    block entry():
        composite : @Bool = sieve(limit, alloc)
        write(out, "primes up to {limit}:")
        jump loop(composite, 2)

    block loop(composite: @Bool, n: USize):
        done : Bool = n.gt(limit)
        branch done
            ? finish(composite)
            : check(composite, n)

    block check(composite: @Bool, n: USize):
        crossed : Bool = composite.stride(n).load()
        branch crossed
            ? loop(composite, n.add(1))
            : print_one(composite, n)

    block print_one(composite: @Bool, n: USize):
        write(out, " {n}")
        jump loop(composite, n.add(1))

    block finish(composite: @Bool):
        write(out, "\n")
        composite.free(alloc)
        return()

routine count_primes(limit: USize, alloc: @Allocator) -> USize
    block entry():
        composite : @Bool = sieve(limit, alloc)
        jump loop(composite, 0, 0)

    block loop(composite: @Bool, n: USize, count: USize):
        done : Bool = n.gt(limit)
        branch done
            ? finish(composite, count)
            : tally(composite, n, count)

    block tally(composite: @Bool, n: USize, count: USize):
        crossed  : Bool  = composite.stride(n).load()
        is_prime : USize = crossed.bitnot().to<USize>()
        jump loop(composite, n.add(1), count.add(is_prime))

    block finish(composite: @Bool, count: USize):
        composite.free(alloc)
        return(count)

routine main() -> S32
    block entry():
        claim out   : @FdWriter  <- .stdout()
        claim alloc : @Allocator <- make_heap_allocator()

        print_primes(out, 50, alloc)
        write(out, "primes below 10000: {count_primes(9999, alloc)}\n")
        return(0)
