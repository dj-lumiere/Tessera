// The sieve of Eratosthenes: every prime up to 50, and how many there are below 10,000.
//
// Introduces:
//   claim: a slot in memory for a value whose methods take a pointer, filled with <- where it's claimed
//   heap memory through an Allocator: a Slice<T> from construct(count, alloc) gives it back with destruct()
//   a borrowed view of it (getview(), a null allocator) lent to a routine that reads and writes the values,
//   getitem and setitem
//   raw element access with stride (address arithmetic), load and store
//   a routine that owns its memory and releases it before returning

import Standard::Alloc
import Standard::Format
import Standard::Os

/// Marks every composite number below the slice's count: composite.getitem(n) is true when n is composite (0 and 1
/// count as composite). The slice is a borrowed view: whoever allocated the memory releases it.
routine sieve(composite: Slice<Bool>) -> Void
    block entry()
        flags : @Bool = composite.to<@Bool>()
        flags.zeroinit(composite.count)
        composite.setitem(0, true)
        composite.setitem(1, true)
        limit : USize = composite.count.sub(1)
        jump outer(flags, limit, 2)

    /// Only factors up to sqrt(limit) need crossing out.
    block outer(flags: @Bool, limit: USize, p: USize)
        past_root : Bool = p.mul(p).gt(limit)
        branch past_root
            ? return()
            : continue
        crossed : Bool = flags.stride(p).load()
        branch crossed
            ? outer(flags, limit, p.add(1))
            : cross_out(flags, limit, p, p.mul(p))

    block cross_out(flags: @Bool, limit: USize, p: USize, multiple: USize)
        done : Bool = multiple.gt(limit)
        branch done
            ? outer(flags, limit, p.add(1))
            : mark(flags, limit, p, multiple)

    block mark(flags: @Bool, limit: USize, p: USize, multiple: USize)
        flags.stride(multiple).store(true)
        jump cross_out(flags, limit, p, multiple.add(p))

routine print_primes(out: @Out, limit: USize, alloc: @Allocator) -> Void
    block entry()
        claim composite : @Slice<Bool> <- .construct(limit.add(1), alloc)
        sieve(composite.getview())
        out.write("primes up to {limit}:")
        jump loop(composite, 2)

    block loop(composite: @Slice<Bool>, n: USize)
        done : Bool = n.gt(limit)
        branch done
            ? finish(composite)
            : check(composite, n)

    block check(composite: @Slice<Bool>, n: USize)
        crossed : Bool = composite.getitem(n)
        branch crossed
            ? loop(composite, n.add(1))
            : print_one(composite, n)

    block print_one(composite: @Slice<Bool>, n: USize)
        out.write(" {n}")
        jump loop(composite, n.add(1))

    block finish(composite: @Slice<Bool>)
        out.write("\n")
        composite.destruct()
        return()

routine count_primes(limit: USize, alloc: @Allocator) -> USize
    block entry()
        claim composite : @Slice<Bool> <- .construct(limit.add(1), alloc)
        sieve(composite.getview())
        jump loop(composite, 0, 0)

    block loop(composite: @Slice<Bool>, n: USize, count: USize)
        done : Bool = n.gt(limit)
        branch done
            ? finish(composite, count)
            : tally(composite, n, count)

    block tally(composite: @Slice<Bool>, n: USize, count: USize)
        crossed  : Bool  = composite.getitem(n)
        is_prime : USize = crossed.bitnot().to<USize>()
        jump loop(composite, n.add(1), count.add(is_prime))

    block finish(composite: @Slice<Bool>, count: USize)
        composite.destruct()
        return(count)

routine main() -> S32
    block entry()
        out : @Out = Out.shared()
        claim alloc : @Allocator <- make_heap_allocator()

        print_primes(out, 50, alloc)
        out.write("primes below 10000: {count_primes(9999, alloc)}\n")
        return(0)
