// Greatest common divisor by Euclid's algorithm, and the least common multiple built on it.
//
// Introduces:
//   helper routines that return a value
//   a loop whose state (dividend, divisor) lives entirely in block parameters, starting from the routine's a and b
//   ordering operations to avoid overflow: lcm divides before it multiplies

import Standard::Format
import Standard::Os

routine gcd(a: U64, b: U64) -> U64
    block entry()
        jump step(a, b)

    /// gcd(a, b) = gcd(b, a mod b), and gcd(a, 0) = a.
    block step(dividend: U64, divisor: U64)
        finished : Bool = divisor.eq(0)
        branch finished
            ? return(dividend)
            : step(divisor, dividend.mod(divisor))

/// lcm(0, x) is 0.
routine lcm(a: U64, b: U64) -> U64
    block entry()
        either_zero : Bool = a.eq(0).bitor(b.eq(0))
        branch either_zero
            ? return(0)
            : continue
        divisor : U64 = gcd(a, b)
        result  : U64 = a.div(divisor).mul(b)
        return(result)

routine show(out: @Out, a: U64, b: U64) -> Void
    block entry()
        out.write("gcd({a}, {b}) = {gcd(a, b)}, lcm = {lcm(a, b)}\n")
        return()

routine main() -> S32
    block entry()
        out : @Out = Out.shared()
        show(out, 48, 18)
        show(out, 17, 5)
        show(out, 0, 9)
        show(out, 1071, 462)
        return(0)
