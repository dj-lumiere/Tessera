// Greatest common divisor by Euclid's algorithm, and the least common multiple built on it.
//
// Introduces:
//   helper routines that return a value
//   a loop whose state (%a, %b) lives entirely in block parameters
//   ordering operations to avoid overflow: lcm divides before it multiplies

routine gcd(%a: U64, %b: U64) -> U64
    block entry():
        jump step(%a, %b)

    /// gcd(a, b) = gcd(b, a mod b), and gcd(a, 0) = a.
    block step(%a: U64, %b: U64):
        %finished: Bool = %b.eq(0)
        branch %finished ? return(%a) : step(%b, %a.rem(%b))

/// lcm(0, x) is 0.
routine lcm(%a: U64, %b: U64) -> U64
    block entry():
        %either_zero: Bool = %a.eq(0).bitor(%b.eq(0))
        branch %either_zero ? return(0) : compute()

    block compute():
        %divisor: U64 = gcd(%a, %b)
        %result:  U64 = %a.div(%divisor).mul(%b)
        return(%result)

routine show(#out: Ptr<FdWriter>, %a: U64, %b: U64) -> Void
    block entry():
        write_str(#out, "gcd(")
        %a.format(#out)
        write_str(#out, ", ")
        %b.format(#out)
        write_str(#out, ") = ")
        gcd(%a, %b).format(#out)
        write_str(#out, ", lcm = ")
        lcm(%a, %b).format(#out)
        write_line(#out)
        return()

routine main() -> S32
    block entry():
        %stdout: FdWriter      = FdWriter.stdout()
        #out:    Ptr<FdWriter> = alloca<FdWriter>([%stdout])
        show(#out, 48, 18)
        show(#out, 17, 5)
        show(#out, 0, 9)
        show(#out, 1071, 462)
        return(0)
