// Count how often each word appears in a sentence.
//
// Introduces:
//   Bytes views: length, byte_at, and slice share the original bytes (no copies)
//   Dict<Bytes, USize>, which iterates in insertion order
//   DictIter and Option<KVPair> for walking a collection
//   construct / destruct: the dictionary's storage is released explicitly

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

/// Adds one to the count of word.
routine tally(%counts: @Dict<Bytes, USize>, %word: Bytes) -> Void
    block entry():
        %seen : Bool = %counts.load().contains(%word)
        branch %seen ? bump() : first_time()

    block bump():
        %count : USize = %counts.load().get(%word)
        %counts.put(%word, %count.add(1))
        return()

    block first_time():
        %counts.put(%word, 1)
        return()

/// Splits text on single spaces and tallies every word.
routine count_words(%text: Bytes, %counts: @Dict<Bytes, USize>) -> Void
    block entry():
        %length : USize = %text.length()
        jump scan(0, 0, %length)

    /// The current word started at start; i is the next byte to look at.
    block scan(%start: USize, %i: USize, %length: USize):
        %at_end : Bool = %i.ge(%length)
        branch %at_end ? last_word(%start, %length) : look(%start, %i, %length)

    block look(%start: USize, %i: USize, %length: USize):
        %is_space : Bool = %text.byte_at(%i).eq(b' '.to_u8())
        branch %is_space ? end_word(%start, %i, %length) : scan(%start, %i.add(1), %length)

    block end_word(%start: USize, %i: USize, %length: USize):
        tally(%counts, %text.slice(%start, %i))
        jump scan(%i.add(1), %i.add(1), %length)

    block last_word(%start: USize, %length: USize):
        tally(%counts, %text.slice(%start, %length))
        return()

routine print_counts(%out: @FdWriter, %counts: @Dict<Bytes, USize>) -> Void
    block entry():
        %iter_val : DictIter<Bytes, USize> = .construct(%counts)
        claim %iter : @DictIter<Bytes, USize>
        %iter.store(%iter_val)
        jump next(%iter)

    block next(%iter: @DictIter<Bytes, USize>):
        %item : Option<KVPair<Bytes, USize>> = %iter.next()
        when %item:
            .Present(%entry) -> print_entry(%iter, %entry)
            .Absent          -> return()

    block print_entry(%iter: @DictIter<Bytes, USize>, %entry: KVPair<Bytes, USize>):
        write(%out, "{%entry.key}: {%entry.value}\n")
        jump next(%iter)

routine main() -> S32
    block entry():
        %stdout : FdWriter = .stdout()
        claim %out : @FdWriter
        %out.store(%stdout)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator
        %alloc.store(%heap)

        %text : Bytes = "the cat saw the dog and the dog saw a bird"

        %counts_val : Dict<Bytes, USize> = .construct(%alloc)
        claim %counts : @Dict<Bytes, USize>
        %counts.store(%counts_val)
        count_words(%text, %counts)
        print_counts(%out, %counts)
        %counts.destruct()
        return(0)
