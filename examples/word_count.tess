// Count how often each word appears in a sentence.
//
// Introduces:
//   Bytes views: count, byte_at, and slice share the original bytes (no copies)
//   Dict<Bytes, USize>, which iterates in insertion order
//   DictIter and Option<KVPair> for walking a collection
//   construct / destruct: the dictionary is built in its slot (claim ... <- .construct(alloc)) and its storage is
//   released explicitly

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

/// Adds one to the count of word.
routine tally(counts: @Dict<Bytes, USize>, word: Bytes) -> Void
    block entry()
        seen : Bool = counts.contains(word)
        branch seen
            ? bump()
            : first_time()

    block bump()
        count : USize = counts.getitem(word)
        counts.put(word, count.add(1))
        return()

    block first_time()
        counts.put(word, 1)
        return()

/// Splits text on single spaces and tallies every word.
routine count_words(text: Bytes, counts: @Dict<Bytes, USize>) -> Void
    shared count : USize  = text.count()
    shared start : @USize <- 0

    block entry()
        jump scan(0)

    /// The current word started at start, and i is the next byte to look at.
    block scan(i: USize)
        at_end : Bool = i.ge(count)
        branch at_end
            ? last_word()
            : look(i)

    block look(i: USize)
        is_space : Bool = text.byte_at(i).eq(b' '.to<U8>())
        branch is_space
            ? end_word(i)
            : scan(i.add(1))

    block end_word(i: USize)
        tally(counts, text.slice(start.load(), i))
        i.add(1).store_into(start)
        jump scan(i.add(1))

    block last_word()
        tally(counts, text.slice(start.load(), count))
        return()

routine print_counts(out: @Out, counts: @Dict<Bytes, USize>) -> Void
    shared iter : @DictIter<Bytes, USize> <- .construct(counts)

    block entry()
        jump next()

    block next()
        item : Option<KVPair<Bytes, USize>> = iter.next()
        when item
            .Present(entry) -> continue
            .Absent         -> return()
        out.write("{entry.key}: {entry.value}\n")
        jump next()

routine main() -> S32
    block entry()
        out : @Out = Out.writer()
        claim alloc : @Allocator <- make_heap_allocator()

        text : Bytes = "the cat saw the dog and the dog saw a bird"

        claim counts : @Dict<Bytes, USize> <- .construct(alloc)
        count_words(text, counts)
        print_counts(out, counts)
        counts.destruct()
        return(0)
