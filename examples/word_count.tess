// Count how often each word appears in a sentence.
//
// Introduces:
//   String views: length, byte_at, and slice share the original bytes (no copies)
//   Dict<String, U64>, which iterates in insertion order
//   DictIter and Option<KVPair> for walking a collection
//   construct / destruct: the dictionary's storage is released explicitly

import Standard::Alloc
import Standard::Collections
import Standard::Format

/// Adds one to the count of word.
routine tally(counts: Ptr<Dict<String, U64>>, word: String) -> Void
    block entry():
        seen : Bool = counts.contains(word)
        branch seen ? bump() : first_time()

    block bump():
        count : U64 = counts.get(word)
        counts.put(word, count.add(1))
        return()

    block first_time():
        counts.put(word, 1)
        return()

/// Splits text on single spaces and tallies every word.
routine count_words(text: Ptr<String>, counts: Ptr<Dict<String, U64>>) -> Void
    block entry():
        length : U64 = text.length()
        jump scan(0, 0, length)

    /// The current word started at start; i is the next byte to look at.
    block scan(start: U64, i: U64, length: U64):
        at_end : Bool = i.ge(length)
        branch at_end ? last_word(start, length) : look(start, i, length)

    block look(start: U64, i: U64, length: U64):
        is_space : Bool = text.byte_at(i).eq(b' '.to_u8())
        branch is_space ? end_word(start, i, length) : scan(start, i.add(1), length)

    block end_word(start: U64, i: U64, length: U64):
        tally(counts, text.slice(start, i))
        jump scan(i.add(1), i.add(1), length)

    block last_word(start: U64, length: U64):
        tally(counts, text.slice(start, length))
        return()

routine print_counts(out: Ptr<FdWriter>, counts: Ptr<Dict<String, U64>>) -> Void
    block entry():
        iter_val : DictIter<String, U64> = .construct(counts)
        claim iter : Ptr<DictIter<String, U64>>
        iter.store(iter_val)
        jump next(iter)

    block next(iter: Ptr<DictIter<String, U64>>):
        item : Option<KVPair<String, U64>> = iter.next()
        when item:
            .Present(entry) -> print_entry(iter, entry)
            .Absent         -> return()

    block print_entry(iter: Ptr<DictIter<String, U64>>, entry: KVPair<String, U64>):
        write(out, "{entry.key}: {entry.value}\n")
        jump next(iter)

routine main() -> S32
    block entry():
        stdout : FdWriter = .stdout()
        claim out : Ptr<FdWriter>
        out.store(stdout)
        heap : Allocator = make_heap_allocator()
        claim alloc : Ptr<Allocator>
        alloc.store(heap)

        text_val : String = "the cat saw the dog and the dog saw a bird"
        claim text : Ptr<String>
        text.store(text_val)

        counts_val : Dict<String, U64> = .construct(alloc)
        claim counts : Ptr<Dict<String, U64>>
        counts.store(counts_val)
        count_words(text, counts)
        print_counts(out, counts)
        counts.destruct()
        return(0)
