# Greatest common divisor by Euclid's algorithm, and the least common multiple built on it.
#
# Introduces:
#   helper routines that return a value
#   a loop whose state (dividend, divisor) lives entirely in block parameters, starting from the routine's a and b
#   ordering operations to avoid overflow: lcm divides before it multiplies

import Standard/Os

### The greatest common divisor of `a` and `b`, by Euclid's algorithm.
### :param a: The first number.
### :param b: The second number.
### :returns: The largest number that divides both, or the other number when one of them is 0 (0 when both are).
routine gcd(a: U64, b: U64) -> U64
    ### gcd(a, b) = gcd(b, a mod b), and gcd(a, 0) = a.
    while divisor != 0 with dividend: U64 = a, divisor: U64 = b
        continue with dividend: divisor, divisor: dividend % divisor
    then
        return dividend

### The least common multiple of `a` and `b`, the smallest number both divide. It divides by the gcd before it
### multiplies, so the intermediate value is never larger than the result.
### :param a: The first number.
### :param b: The second number.
### :returns: The least common multiple, or 0 when either number is 0.
### :throws: Crashes with `IntegerOverflowError` when the result doesn't fit in a U64.
routine lcm(a: U64, b: U64) -> U64
    if a == 0 or b == 0
        return 0
    divisor: U64 = gcd(a, b)
    result: U64 = a // divisor * b
    return result

### Writes one line with the gcd and the lcm of `a` and `b`.
### :param out: Where the line goes.
### :param a: The first number.
### :param b: The second number.
routine show(out: @ConsoleOutput, a: U64, b: U64) -> None
    out.write("gcd({a}, {b}) = {gcd(a, b)}, lcm = {lcm(a, b)}\n")
    return

### Prints the gcd and the lcm of four pairs of numbers.
routine start() -> None
    out: @ConsoleOutput = Console.output()
    show(out, a: 48, b: 18)
    show(out, a: 17, b: 5)
    show(out, a: 0, b: 9)
    show(out, a: 1071, b: 462)
    return
