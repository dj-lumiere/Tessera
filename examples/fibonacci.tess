// Fibonacci numbers until the next one no longer fits in a U64.
//
// Introduces:
//   overflow: plain add crashes, add_checked returns Option<U64>
//   reading an Option with when .Present(x) binds the value for that arm's target,
//   .Absent is the other case

import Standard::Format
import Standard::Os

/// Writes one line `F(n) = f`.
/// :param out: Where the line goes.
/// :param n: The index of the Fibonacci number.
/// :param f: The Fibonacci number itself.
routine show(out: @Out, n: U64, f: U64) -> Void
    block entry()
        out.write("F({n}) = {f}\n")
        return()

/// Prints F(0) .. F(9), skips to F(90), prints on up to the last one that fits in a U64, and then names the first
/// one that doesn't.
/// :param out: Where the lines go.
routine print_fibonacci(out: @Out) -> Void
    block entry()
        jump loop(0, 0, 1)

    /// a is F(n) and b is F(n + 1).
    block loop(n: U64, a: U64, b: U64)
        shown : Bool = n.lt(10).bitor(n.ge(90))
        branch shown
            ? print_it(n, a, b)
            : advance(n, a, b)

    block print_it(n: U64, a: U64, b: U64)
        show(out, n, a)
        jump advance(n, a, b)

    block advance(n: U64, a: U64, b: U64)
        next : Option<U64> = a.add_checked(b)
        when next
            .Present(sum) -> loop(n.add(1), b, sum)
            .Absent       -> overflowed(n, b)

    block overflowed(n: U64, b: U64)
        show(out, n.add(1), b)
        out.write("F({n.add(2)}) overflows U64\n")
        return()

/// Prints the Fibonacci numbers with `print_fibonacci`.
routine start() -> Void
    block entry()
        out : @Out = Out.writer()
        print_fibonacci(out)
        return()
