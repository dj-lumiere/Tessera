// Fibonacci numbers until the next one no longer fits in a U64.
//
// Introduces:
//   overflow: plain add panics, add_checked returns Option<U64>
//   reading an Option: .tag says whether a value is there, .value is the value

routine show(#out: Ptr<FdWriter>, %n: U64, %f: U64) -> Void
    block entry():
        write_str(#out, "F(")
        %n.format(#out)
        write_str(#out, ") = ")
        %f.format(#out)
        write_line(#out)
        return()

/// Prints F(0) .. F(9), skips to F(90), and stops at the first F(n) past U64.MAX.
routine print_fibonacci(#out: Ptr<FdWriter>) -> Void
    block entry():
        jump loop(0, 0, 1)

    /// %a is F(%n) and %b is F(%n + 1).
    block loop(%n: U64, %a: U64, %b: U64):
        %shown: Bool = %n.lt(10).bitor(%n.ge(90))
        branch %shown ? print_it(%n, %a, %b) : advance(%n, %a, %b)

    block print_it(%n: U64, %a: U64, %b: U64):
        show(#out, %n, %a)
        jump advance(%n, %a, %b)

    block advance(%n: U64, %a: U64, %b: U64):
        %next: Option<U64> = %a.add_checked(%b)
        %fits: Bool        = %next.tag
        branch %fits ? loop(%n.add(1), %b, %next.value) : overflowed(%n, %b)

    block overflowed(%n: U64, %b: U64):
        show(#out, %n.add(1), %b)
        write_str(#out, "F(")
        %n.add(2).format(#out)
        write_str(#out, ") overflows U64")
        write_line(#out)
        return()

routine main() -> S32
    block entry():
        %stdout: FdWriter      = FdWriter.stdout()
        #out:    Ptr<FdWriter> = alloca<FdWriter>([%stdout])
        print_fibonacci(#out)
        return(0)
