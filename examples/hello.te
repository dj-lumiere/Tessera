# Hello, world: the smallest program, then the same line through a Writer.
#
# Introduces:
#   routine start() -> None, the entry point, and block entry()
#   Console.show for a quick line
#   Console.output(): standard output as a pointer to a Writer, what every later example prints through

import Standard/Hosted

### Prints `Hello, world!`, then a second line through a writer to standard output.
routine start() -> None
    Console.show("Hello, world!")

    # A writer's methods take a pointer: Console.output() is the one to standard output.
    year: U64 = 2026
    out: @ConsoleOutput = Console.output()
    out.write("Hello again, {year}!\n")
    return
