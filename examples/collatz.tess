// Collatz sequences: which start below 1000 takes the most steps to reach 1?
//
// Introduces:
//   a nested loop split into two routines instead of one tangled block graph
//   carrying the best-so-far through the outer loop's block parameters

import Standard::Format
import Standard::Os

/// Steps from start to 1: n -> n / 2 if n is even, 3n + 1 if odd.
routine collatz_steps(%start: U64) -> U64
    block entry():
        jump step(%start, 0)

    block step(%n: U64, %steps: U64):
        %reached_one : Bool = %n.le(1)
        branch %reached_one
            ? return(%steps)
            : continue
        %is_even : Bool = %n.mod(2).eq(0)
        %halved  : U64  = %n.div(2)
        %tripled : U64  = %n.mul(3).add(1)
        %after   : U64  = %is_even
            ? %halved
            : %tripled
        jump step(%after, %steps.add(1))

routine main() -> S32
    block entry():
        claim %out : @FdWriter <- .stdout()
        write(%out, "steps(27) = {collatz_steps(27)}\n")
        jump search(%out, 1, 1, 0)

    block search(%out: @FdWriter, %start: U64, %best_start: U64, %best_steps: U64):
        %done : Bool = %start.ge(1000)
        branch %done
            ? report(%out, %best_start, %best_steps)
            : try_start(%out, %start, %best_start, %best_steps)

    block try_start(%out: @FdWriter, %start: U64, %best_start: U64, %best_steps: U64):
        %steps  : U64  = collatz_steps(%start)
        %longer : Bool = %steps.gt(%best_steps)
        branch %longer
            ? search(%out, %start.add(1), %start, %steps)
            : search(%out, %start.add(1), %best_start, %best_steps)

    block report(%out: @FdWriter, %best_start: U64, %best_steps: U64):
        write(%out, "longest below 1000: {%best_start} with {%best_steps} steps\n")
        return(0)
