// Collatz sequences: which start below 1000 takes the most steps to reach 1?
//
// Introduces:
//   a nested loop split into two routines instead of one tangled block graph
//   carrying the best-so-far through the outer loop's block parameters

/// Steps from %start to 1: n -> n / 2 if n is even, 3n + 1 if odd.
routine collatz_steps(%start: U64) -> U64
    block entry():
        jump step(%start, 0)

    block step(%n: U64, %steps: U64):
        %reached_one: Bool = %n.le(1)
        branch %reached_one ? return(%steps) : next(%n, %steps)

    block next(%n: U64, %steps: U64):
        %is_even: Bool = %n.rem(2).eq(0)
        %halved:  U64  = %n.div(2)
        %tripled: U64  = %n.mul(3).add(1)
        %after:   U64  = %is_even ? %halved : %tripled
        jump step(%after, %steps.add(1))

routine main() -> S32
    block entry():
        %stdout: FdWriter      = FdWriter.stdout()
        #out:    Ptr<FdWriter> = alloca
        #out.store(%stdout)
        write_str(#out, "steps(27) = ")
        collatz_steps(27).format(#out)
        write_line(#out)
        jump search(#out, 1, 1, 0)

    block search(#out: Ptr<FdWriter>, %start: U64, %best_start: U64, %best_steps: U64):
        %done: Bool = %start.ge(1000)
        branch %done ? report(#out, %best_start, %best_steps) : try_start(#out, %start, %best_start, %best_steps)

    block try_start(#out: Ptr<FdWriter>, %start: U64, %best_start: U64, %best_steps: U64):
        %steps:  U64  = collatz_steps(%start)
        %longer: Bool = %steps.gt(%best_steps)
        branch %longer ? search(#out, %start.add(1), %start, %steps)
                       : search(#out, %start.add(1), %best_start, %best_steps)

    block report(#out: Ptr<FdWriter>, %best_start: U64, %best_steps: U64):
        write_str(#out, "longest below 1000: ")
        %best_start.format(#out)
        write_str(#out, " with ")
        %best_steps.format(#out)
        write_str(#out, " steps")
        write_line(#out)
        return(0)
