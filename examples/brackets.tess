// Check that (), [], and {} are balanced, using a List<Byte> as a stack.
//
// Introduces:
//   List<T> as a stack: push, pop, is_empty
//   a choice as the result of a check, and a when that lists every member
//   one cleanup block that every exit goes through, so the stack is destructed once

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

choice Balance: U8
    Balanced   : 0
    Mismatched : 1
    Unclosed   : 2

routine closer_of(%open: Byte) -> Byte
    block entry():
        when:
            %open.eq(b'(') -> return(b')')
            %open.eq(b'[') -> return(b']')
            else           -> return(b'}')

routine check_balance(%text: Bytes, %alloc: @Allocator) -> Balance
    block entry():
        %stack_val : List<Byte> = .construct(%alloc)
        claim %stack : @List<Byte> <- %stack_val
        jump scan(%stack, 0)

    /// stack holds the closers still expected, the innermost last.
    block scan(%stack: @List<Byte>, %i: USize):
        %at_end : Bool = %i.ge(%text.length)
        branch %at_end ? finish(%stack) : classify(%stack, %i)

    block classify(%stack: @List<Byte>, %i: USize):
        %data   : @Byte = %text.data
        %c      : Byte  = %data.stride(%i).load()
        %opens  : Bool  = %c.eq(b'(').bitor(%c.eq(b'[')).bitor(%c.eq(b'{'))
        %closes : Bool  = %c.eq(b')').bitor(%c.eq(b']')).bitor(%c.eq(b'}'))
        when:
            %opens  -> open(%stack, %i, %c)
            %closes -> close(%stack, %i, %c)
            else    -> scan(%stack, %i.add(1))

    block open(%stack: @List<Byte>, %i: USize, %c: Byte):
        %stack.push(closer_of(%c))
        jump scan(%stack, %i.add(1))

    block close(%stack: @List<Byte>, %i: USize, %c: Byte):
        %nothing_open : Bool = %stack.load().is_empty()
        branch %nothing_open ? leave(%stack, Balance.Mismatched) : match(%stack, %i, %c)

    block match(%stack: @List<Byte>, %i: USize, %c: Byte):
        %expected : Byte = %stack.pop()
        %matches  : Bool = %expected.eq(%c)
        branch %matches ? scan(%stack, %i.add(1)) : leave(%stack, Balance.Mismatched)

    block finish(%stack: @List<Byte>):
        %all_closed : Bool = %stack.load().is_empty()
        branch %all_closed ? leave(%stack, Balance.Balanced) : leave(%stack, Balance.Unclosed)

    /// Every exit comes here, so the stack is destructed exactly once.
    block leave(%stack: @List<Byte>, %result: Balance):
        %stack.destruct()
        return(%result)

routine report(%out: @FdWriter, %text: Bytes, %alloc: @Allocator) -> Void
    block entry():
        write(%out, "{%text}  ->  ")
        %result : Balance = check_balance(%text, %alloc)
        when %result:
            Balance.Balanced   -> say("balanced")
            Balance.Mismatched -> say("mismatched")
            Balance.Unclosed   -> say("unclosed")

    block say(%verdict: Bytes):
        write(%out, "{%verdict}\n")
        return()

routine main() -> S32
    block entry():
        %stdout : FdWriter = .stdout()
        claim %out : @FdWriter <- %stdout
        %heap : Allocator = make_heap_allocator()
        claim %alloc : @Allocator <- %heap

        report(%out, "f(a[i], {b: (c)})", %alloc)
        report(%out, "(]", %alloc)
        report(%out, "((x)", %alloc)
        report(%out, "x)", %alloc)
        report(%out, "no brackets", %alloc)
        return(0)
