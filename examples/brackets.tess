// Check that (), [], and {} are balanced, using a List<Byte> as a stack.
//
// Introduces:
//   List<T> as a stack: push, pop, is_empty
//   a choice as the result of a check, and a when that lists every member
//   the finish convention: every exit jumps to one block named finish, which destructs the stack once

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

choice Balance: U8
    Balanced   : 0
    Mismatched : 1
    Unclosed   : 2

/// The closing bracket that matches an opening one.
/// :param open: An opening bracket: `(`, `[`, or `{`.
/// :returns: `)` for `(`, `]` for `[`, and `}` for anything else.
routine closer_of(open: Byte) -> Byte
    block entry()
        when
            open.eq(b'(') -> return(b')')
            open.eq(b'[') -> return(b']')
            else          -> return(b'}')

/// Checks that every `(`, `[`, and `{` in `text` is closed by its own kind of bracket, in the right order. Other
/// bytes are skipped.
/// :param text: The text to check.
/// :param alloc: The allocator for the stack of expected closers.
/// :returns: `Balanced`, `Mismatched` when a closer has no opener or closes the wrong kind, or `Unclosed` when the
///     text ends with brackets still open.
/// :throws: Crashes with `MemoryAllocationError` when the stack can't grow.
routine check_balance(text: Bytes, alloc: @Allocator) -> Balance
    shared stack : @List<Byte> <- .construct(alloc)

    block entry()
        jump scan(0)

    /// stack holds the closers still expected, the innermost last.
    block scan(i: USize)
        at_end : Bool = i.ge(text.count)
        branch at_end
            ? at_end_of_text()
            : classify(i)

    block classify(i: USize)
        data                  : @Byte = text.data
        c                     : Byte  = data.stride(i).load()
        round_or_square_open  : Bool  = c.eq(b'(').bitor(c.eq(b'['))
        opens                 : Bool  = round_or_square_open.bitor(c.eq(b'{'))
        round_or_square_close : Bool  = c.eq(b')').bitor(c.eq(b']'))
        closes                : Bool  = round_or_square_close.bitor(c.eq(b'}'))
        when
            opens  -> open(i, c)
            closes -> close(i, c)
            else   -> scan(i.add(1))

    block open(i: USize, c: Byte)
        stack.push(closer_of(c))
        jump scan(i.add(1))

    block close(i: USize, c: Byte)
        nothing_open : Bool = stack.is_empty()
        branch nothing_open
            ? finish(Balance.Mismatched)
            : match(i, c)

    block match(i: USize, c: Byte)
        expected : Byte = stack.pop()
        matches  : Bool = expected.eq(c)
        branch matches
            ? scan(i.add(1))
            : finish(Balance.Mismatched)

    block at_end_of_text()
        all_closed : Bool = stack.is_empty()
        branch all_closed
            ? finish(Balance.Balanced)
            : finish(Balance.Unclosed)

    /// Every exit comes here, so the stack is destructed exactly once.
    block finish(result: Balance)
        stack.destruct()
        return(result)

/// Writes `text` and its verdict from `check_balance`: balanced, mismatched, or unclosed.
/// :param out: Where the line goes.
/// :param text: The text to check.
/// :param alloc: The allocator `check_balance` uses for its stack.
routine report(out: @Out, text: Bytes, alloc: @Allocator) -> Void
    block entry()
        out.write("{text}  ->  ")
        result : Balance = check_balance(text, alloc)
        when result
            Balance.Balanced   -> say("balanced")
            Balance.Mismatched -> say("mismatched")
            Balance.Unclosed   -> say("unclosed")

    block say(verdict: Bytes)
        out.write("{verdict}\n")
        return()

/// Checks five strings, one for each outcome plus one without brackets, and prints the verdicts.
/// :returns: 0, the program's exit code.
routine main() -> S32
    block entry()
        out : @Out = Out.writer()
        claim alloc : @Allocator <- make_heap_allocator()

        report(out, "f(a[i], {b: (c)})", alloc)
        report(out, "(]", alloc)
        report(out, "((x)", alloc)
        report(out, "x)", alloc)
        report(out, "no brackets", alloc)
        return(0)
