# Fibonacci numbers until the next one no longer fits in a U64.
#
# Introduces:
#   overflow: plain add crashes, add_checked returns Maybe[U64]
#   reading an Maybe with when x binds the value for that arm's target,
#   None() is the other case

import Standard/Format
import Standard/Os

### Writes one line `F(n) = f`.
### :param out: Where the line goes.
### :param n: The index of the Fibonacci number.
### :param f: The Fibonacci number itself.
routine show(out: @Out, n: U64, f: U64) -> None
    out.write("F({n}) = {f}\n")
    return

### Prints F(0) .. F(9), skips to F(90), prints on up to the last one that fits in a U64, and then names the first
### one that doesn't.
### :param out: Where the lines go.
routine print_fibonacci(out: @Out) -> None
    ### a is F(n) and b is F(n + 1).
    while true with n: U64 = 0, a: U64 = 0, b: U64 = 1
        if n < 10 or n >= 90
            show(out, n, f: a)
        next: Maybe[U64] = a.add_checked(b)
        when next
            is U64 as sum => continue with n: n + 1, a: b, b: sum
            is None =>
                show(out, n: n + 1, f: b)
                out.write("F({n.add(2)}) overflows U64\n")
                return

### Prints the Fibonacci numbers with `print_fibonacci`.
routine start() -> None
    out: @Out = Out.writer()
    print_fibonacci(out)
    return
