// Insertion sort on a fixed-size array, then the same data sorted by List.sort.
//
// Introduces:
//   Array<T, N> on the stack: bounds-checked get / set through its pointer
//   a nested loop written as two routines: sort (outer) and insert (inner)
//   generic code from the stdlib: List<S64>.sort

import Standard::Alloc
import Standard::Collections
import Standard::Format

preset INPUT: Array<S64, 8> = [31, -4, 15, 9, 0, 26, -4, 5]

/// Moves data[i] left until the prefix data[0 ..= i] is sorted.
routine insert(%data: Ptr<Array<S64, 8>>, %i: USize) -> Void
    block entry():
        %value : S64 = %data.get(%i)
        jump find_slot(%i, %value)

    /// Everything right of hole is larger than value and has already moved one step right.
    block find_slot(%hole: USize, %value: S64):
        %at_front : Bool = %hole.eq(0)
        branch %at_front ? place(%hole, %value) : compare(%hole, %value)

    block compare(%hole: USize, %value: S64):
        %left     : USize = %hole.sub(1)
        %neighbor : S64   = %data.get(%left)
        %bigger   : Bool  = %neighbor.gt(%value)
        branch %bigger ? shift(%hole, %value, %neighbor) : place(%hole, %value)

    block shift(%hole: USize, %value: S64, %neighbor: S64):
        %data.set(%hole, %neighbor)
        jump find_slot(%hole.sub(1), %value)

    block place(%hole: USize, %value: S64):
        %data.set(%hole, %value)
        return()

routine insertion_sort(%data: Ptr<Array<S64, 8>>) -> Void
    block entry():
        jump loop(1)

    block loop(%i: USize):
        %done : Bool = %i.ge(Array<S64, 8>.length())
        branch %done ? return() : continue
        insert(%data, %i)
        jump loop(%i.add(1))

routine print_array(%out: Ptr<FdWriter>, %data: Ptr<Array<S64, 8>>) -> Void
    block entry():
        jump loop(0)

    block loop(%i: USize):
        %done : Bool = %i.ge(Array<S64, 8>.length())
        branch %done ? finish() : print_one(%i)

    block print_one(%i: USize):
        write(%out, " {%data.get(%i)}")
        jump loop(%i.add(1))

    block finish():
        write(%out, "\n")
        return()

routine print_list(%out: Ptr<FdWriter>, %list: Ptr<List<S64>>) -> Void
    block entry():
        %length : USize = %list.length()
        jump loop(0, %length)

    block loop(%i: USize, %length: USize):
        %done : Bool = %i.ge(%length)
        branch %done ? finish() : print_one(%i, %length)

    block print_one(%i: USize, %length: USize):
        write(%out, " {%list.get(%i)}")
        jump loop(%i.add(1), %length)

    block finish():
        write(%out, "\n")
        return()

routine main() -> S32
    block entry():
        %stdout : FdWriter = .stdout()
        claim %out : Ptr<FdWriter>
        %out.store(%stdout)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)

        // Copy the read-only preset into a stack array we can sort.
        %input : Array<S64, 8> = INPUT.load()
        claim %data : Ptr<Array<S64, 8>>
        %data.store(%input)
        write(%out, "before:")
        print_array(%out, %data)
        insertion_sort(%data)
        write(%out, "after: ")
        print_array(%out, %data)

        %list_val : List<S64> = .construct(%alloc)
        claim %list : Ptr<List<S64>>
        %list.store(%list_val)
        jump fill(%out, %list, 0)

    block fill(%out: Ptr<FdWriter>, %list: Ptr<List<S64>>, %i: USize):
        %done : Bool = %i.ge(Array<S64, 8>.length())
        branch %done ? sort_list(%out, %list) : push(%out, %list, %i)

    block push(%out: Ptr<FdWriter>, %list: Ptr<List<S64>>, %i: USize):
        %list.push(INPUT.get(%i))
        jump fill(%out, %list, %i.add(1))

    block sort_list(%out: Ptr<FdWriter>, %list: Ptr<List<S64>>):
        %list.sort()
        write(%out, "List:  ")
        print_list(%out, %list)
        %list.destruct()
        return(0)
