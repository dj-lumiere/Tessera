// Insertion sort on a fixed-size array, then the same data sorted by List.sort.
//
// Introduces:
//   Array<T, N> on the stack: claimed <- a preset's contents, then bounds-checked get / set through its pointer
//   a nested loop written as two routines: sort (outer) and insert (inner)
//   generic code from the stdlib: List<S64>.sort

import Standard::Alloc
import Standard::Collections
import Standard::Format
import Standard::Os

preset INPUT: @Array<S64, 8> <- { 31, -4, 15, 9, 0, 26, -4, 5 }

/// Moves data[i] left until the prefix data[0 ..= i] is sorted.
routine insert(data: @Array<S64, 8>, i: USize) -> Void
    shared value : S64 = data.getitem(i)

    block entry()
        jump find_slot(i)

    /// Everything right of hole is larger than value and has already moved one step right.
    block find_slot(hole: USize)
        at_front : Bool = hole.eq(0)
        branch at_front
            ? place(hole)
            : compare(hole)

    block compare(hole: USize)
        left     : USize = hole.sub(1)
        neighbor : S64   = data.getitem(left)
        bigger   : Bool  = neighbor.gt(value)
        branch bigger
            ? shift(hole, neighbor)
            : place(hole)

    block shift(hole: USize, neighbor: S64)
        data.setitem(hole, neighbor)
        jump find_slot(hole.sub(1))

    block place(hole: USize)
        data.setitem(hole, value)
        return()

routine insertion_sort(data: @Array<S64, 8>) -> Void
    block entry()
        jump loop(1)

    block loop(i: USize)
        done : Bool = i.ge(Array<S64, 8>.count())
        branch done
            ? return()
            : continue
        insert(data, i)
        jump loop(i.add(1))

routine print_array(out: @Out, data: @Array<S64, 8>) -> Void
    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(Array<S64, 8>.count())
        branch done
            ? finish()
            : print_one(i)

    block print_one(i: USize)
        out.write(" {data.getitem(i)}")
        jump loop(i.add(1))

    block finish()
        out.write("\n")
        return()

routine print_list(out: @Out, list: @List<S64>) -> Void
    shared count : USize = list.count()

    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish()
            : print_one(i)

    block print_one(i: USize)
        out.write(" {list.getitem(i)}")
        jump loop(i.add(1))

    block finish()
        out.write("\n")
        return()

routine main() -> S32
    shared out  : @Out       = Out.writer()
    shared list : @List<S64> <- uninit

    block entry()
        claim alloc : @Allocator <- make_heap_allocator()

        // Copy the read-only preset into a stack array we can sort.
        claim data : @Array<S64, 8> <- INPUT.load()
        out.write("before:")
        print_array(out, data)
        insertion_sort(data)
        out.write("after: ")
        print_array(out, data)

        list.store(.construct(alloc))
        jump fill(0)

    block fill(i: USize)
        done : Bool = i.ge(Array<S64, 8>.count())
        branch done
            ? sort_list()
            : push(i)

    block push(i: USize)
        list.push(INPUT.getitem(i))
        jump fill(i.add(1))

    block sort_list()
        list.sort()
        out.write("List:  ")
        print_list(out, list)
        list.destruct()
        return(0)
