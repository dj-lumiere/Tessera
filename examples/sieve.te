# The sieve of Eratosthenes: every prime up to 50, and how many there are below 10,000.
#
# Introduces:
#   claim: a slot in memory for a value whose methods take a pointer, filled with <- where it's claimed
#   heap memory through an MemoryManager: a @[T] from construct(count, manager) gives it back with destruct()
#   a borrowed view of it (getview(), a null memory manager) lent to a routine that reads and writes the values,
#   getitem and setitem
#   raw element access with stride (address arithmetic), load and store
#   a routine that owns its memory and releases it before returning

import Standard/Os

### Marks every composite number below the slice's count: composite.getitem(n) is true when n is composite (0 and 1
### count as composite). The slice is a borrowed view: whoever allocated the memory releases it.
### :param composite: The flags to fill, one per number from 0 to its count minus 1.
### :throws: Crashes with `IndexOutOfBoundsError` when the slice holds fewer than 2 flags.
routine sieve(composite: @[Bool]) -> None
    local flags: @Bool = composite.to[@Bool]()

    flags.zeroinit(composite.count)
    composite[0] = true
    composite[1] = true

    ### Only factors up to sqrt(limit) need crossing out.
    limit: U64 = composite.count - 1
    until p * p > limit with p: U64 = 2
        if flags.stride(p).peek()
            continue with p: p + 1
        else
            until multiple > limit with multiple: U64 = p * p
                flags.stride(multiple).poke(true)
                continue with multiple: multiple + p
            then
                continue with p: p + 1
    then
        return

### Writes every prime from 2 to `limit` on one line, using a sieve in memory it allocates and gives back.
### :param out: Where the line goes.
### :param limit: The largest number to consider. At least 1.
### :param manager: The memory manager for the sieve's flags.
### :throws: Crashes with `MemoryAllocationError` when the flags can't be allocated, and with
###     `IndexOutOfBoundsError` when `limit` is 0.
routine print_primes(out: @ConsoleOutput, limit: U64, manager: @MemoryManager) -> None
    local composite: @Memory[Bool] <- .construct(count: limit + 1, manager: manager)

    sieve(composite.getview())
    out.write("primes up to {limit}:")

    each n in 2 to limit
        if not composite[n]
            out.write(" {n}")
    out.write("\n")
    drop composite
    return

### Counts the primes from 2 to `limit`, using a sieve in memory it allocates and gives back.
### :param limit: The largest number to consider. At least 1.
### :param manager: The memory manager for the sieve's flags.
### :returns: The number of primes up to and including `limit`.
### :throws: Crashes with `MemoryAllocationError` when the flags can't be allocated, and with
###     `IndexOutOfBoundsError` when `limit` is 0.
routine count_primes(limit: U64, manager: @MemoryManager) -> U64
    local composite: @Memory[Bool] <- .construct(count: limit + 1, manager: manager)
    local count: @U64 <- 0

    sieve(composite.getview())

    each n in 0 to limit
        crossed: Bool = composite[n]
        is_prime: U64 = (not crossed).to[U64]()
        (count.peek() + is_prime).poke_into(count)
    drop composite
    return count.peek()

### Prints the primes up to 50 and how many primes there are below 10,000.
routine start() -> None
    out: @ConsoleOutput = Console.output()
    local manager: @MemoryManager <- HEAP.peek()

    print_primes(out, limit: 50, manager)
    out.write("primes below 10000: {count_primes(limit: 9999, manager)}\n")
    return
