// A Celsius-to-Fahrenheit table, and the mean of a few readings.
//
// Introduces:
//   F64 arithmetic: floats have methods like integers (mul, div, add), and no overflow crashes
//   converting between integers and floats: to_f64, and round then to_s64 on the way back
//   write (represent) for the shortest exact text, represent_fixed_into for a set number of digits

import Standard::Format
import Standard::Os

preset READINGS: @Array<F64, 6> <- { 21.5, 23.25, 19.0, 22.75, 20.1, 18.4 }

/// Converts a temperature from degrees Celsius to degrees Fahrenheit: `c × 9 / 5 + 32`.
/// :param c: The temperature in degrees Celsius.
/// :returns: The same temperature in degrees Fahrenheit.
routine celsius_to_fahrenheit(c: F64) -> F64
    block entry()
        scaled : F64 = c.mul(9.0).div(5.0)
        f      : F64 = scaled.add(32.0)
        return(f)

/// Writes a conversion table, one line every 20 degrees Celsius from -40 to 100.
/// :param out: Where the table goes.
routine print_table(out: @Out) -> Void
    block entry()
        jump row(-40)

    /// One row every 20 degrees, from -40 to 100.
    block row(c: S64)
        done : Bool = c.gt(100)
        branch done
            ? return()
            : continue
        f : F64 = celsius_to_fahrenheit(c.to<F64>())
        out.write("{c} C = {f} F\n")
        jump row(c.add(20))

/// The mean of the values in `READINGS`.
/// :returns: Their sum divided by their count.
routine mean_reading() -> F64
    shared sum : @F64 <- 0.0

    block entry()
        jump loop(0)

    block loop(i: USize)
        count : USize = Array<F64, 6>.count()
        done  : Bool  = i.ge(count)
        branch done
            ? finish(count)
            : accumulate(i)

    block accumulate(i: USize)
        sum.load().add(READINGS.getitem(i)).store_into(sum)
        jump loop(i.add(1))

    block finish(count: USize)
        return(sum.load().div(count.to<F64>()))

/// Prints the Celsius-to-Fahrenheit table, then the mean reading exactly, to 2 decimal places, and rounded.
/// :returns: 0, the program's exit code.
routine main() -> S32
    block entry()
        out : @Out = Out.writer()
        print_table(out)

        mean : F64 = mean_reading()
        out.write("mean reading: {mean} C, about ")
        mean.represent_fixed_into(out, 2)
        out.write(", rounded {mean.round().to<S64>()}\n")
        return(0)
