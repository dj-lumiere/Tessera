// A Celsius-to-Fahrenheit table, and the mean of a few readings.
//
// Introduces:
//   F64 arithmetic: floats have methods like integers (mul, div, add), and no overflow panics
//   converting between integers and floats: to_f64, and round then to_s64 on the way back
//   format for the shortest exact text, format_fixed for a set number of digits

routine celsius_to_fahrenheit(%c: F64) -> F64
    block entry():
        %f : F64 = %c.mul(9.0).div(5.0).add(32.0)
        return(%f)

routine print_table(#out: Ptr<FdWriter>) -> Void
    block entry():
        jump row(-40)

    /// One row every 20 degrees, from -40 to 100.
    block row(%c: S64):
        %done : Bool = %c.gt(100)
        branch %done ? return() : continue
        %f : F64 = celsius_to_fahrenheit(%c.to_f64())
        write(#out, "{%c} C = {%f} F\n")
        jump row(%c.add(20))

preset READINGS: Array<F64, 6> = [21.5, 23.25, 19.0, 22.75, 20.1, 18.4]

routine mean_reading() -> F64
    block entry():
        jump loop(0, 0.0)

    block loop(%i: U64, %sum: F64):
        %count : U64  = Array<F64, 6>.length()
        %done  : Bool = %i.ge(%count)
        branch %done ? finish(%sum, %count) : accumulate(%i, %sum)

    block accumulate(%i: U64, %sum: F64):
        jump loop(%i.add(1), %sum.add(READINGS.get(%i)))

    block finish(%sum: F64, %count: U64):
        return(%sum.div(%count.to_f64()))

routine main() -> S32
    block entry():
        %stdout : FdWriter      = .stdout()
        #out    : Ptr<FdWriter> = claim
        #out.store(%stdout)
        print_table(#out)

        %mean : F64 = mean_reading()
        write(#out, "mean reading: {%mean} C, about ")
        %mean.format_fixed(#out, 2)
        write(#out, ", rounded {%mean.round().to_s64()}\n")
        return(0)
