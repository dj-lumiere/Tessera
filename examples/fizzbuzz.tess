// FizzBuzz from 1 to 15.
//
// Introduces:
//   a counted loop: a block that jumps back to itself with the next i
//   when:, which picks the first arm whose condition holds
//   write, which writes text and values to a writer in one line
//   routine parameters (out, last) are visible in every block; values made in entry are not

import Standard::Format

routine fizzbuzz(out: Ptr<FdWriter>, last: U64) -> Void
    block entry():
        jump loop(1)

    block loop(i: U64):
        done : Bool = i.gt(last)
        branch done ? return() : continue
        by_3  : Bool = i.rem(3).eq(0)
        by_5  : Bool = i.rem(5).eq(0)
        by_15 : Bool = by_3.bitand(by_5)
        when:
            by_15 -> say(i, "FizzBuzz")
            by_3  -> say(i, "Fizz")
            by_5  -> say(i, "Buzz")
            _     -> say_number(i)

    block say(i: U64, word: String):
        write(out, "{word}\n")
        jump loop(i.add(1))

    block say_number(i: U64):
        write(out, "{i}\n")
        jump loop(i.add(1))

routine main() -> S32
    block entry():
        // A writer lives in memory (claim a slot for it), because its methods take a pointer.
        stdout : FdWriter = .stdout()
        claim out : Ptr<FdWriter>
        out.store(stdout)
        fizzbuzz(out, 15)
        return(0)
