// FizzBuzz from 1 to 15.
//
// Introduces:
//   a counted loop: a block that jumps back to itself with the next %i
//   select, which picks the first arm whose condition holds
//   routine parameters (#out, %last) are visible in every block; values made in entry are not

routine fizzbuzz(#out: Ptr<FdWriter>, %last: U64) -> Void
    block entry():
        jump loop(1)

    block loop(%i: U64):
        %done: Bool = %i.gt(%last)
        branch %done ? return() : classify(%i)

    block classify(%i: U64):
        %by_3:  Bool = %i.rem(3).eq(0)
        %by_5:  Bool = %i.rem(5).eq(0)
        %by_15: Bool = %by_3.bitand(%by_5)
        select:
            %by_15 -> say(%i, "FizzBuzz")
            %by_3  -> say(%i, "Fizz")
            %by_5  -> say(%i, "Buzz")
            _      -> say_number(%i)

    block say(%i: U64, %word: String):
        write_str(#out, %word)
        write_line(#out)
        jump loop(%i.add(1))

    block say_number(%i: U64):
        %i.format(#out)
        write_line(#out)
        jump loop(%i.add(1))

routine main() -> S32
    block entry():
        // A writer lives in memory (alloca), because its methods take a pointer.
        %stdout: FdWriter      = FdWriter.stdout()
        #out:    Ptr<FdWriter> = alloca
        #out.store(%stdout)
        fizzbuzz(#out, 15)
        return(0)
