// Hello, world: the smallest program, then the same line through a Writer.
//
// Introduces:
//   routine main() -> S32 and block entry()
//   print for a quick line
//   claim: a slot in memory for a value whose methods take a pointer, filled with <- where it's claimed
//   FdWriter, the unbuffered writer every later example prints through

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry():
        Out.write("Hello, world!\n")

        // A writer lives in memory (claim a slot for it), because its methods take a pointer.
        claim out : @FdWriter <- .stdout()
        write(out, "Hello again, ")
        year : U64 = 2026
        write(out, "{year}!\n")
        return(0)
