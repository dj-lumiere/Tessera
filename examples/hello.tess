// Hello, world: the smallest program, then the same line through a Writer.
//
// Introduces:
//   routine main() -> S32 and block entry()
//   Out.write for a quick line
//   Out.writer(): standard output as a pointer to a Writer, what every later example prints through

import Standard::Format
import Standard::Os

routine main() -> S32
    block entry()
        Out.write("Hello, world!\n")

        // A writer's methods take a pointer: Out.writer() is the one to standard output.
        year : U64  = 2026
        out  : @Out = Out.writer()
        out.write("Hello again, {year}!\n")
        return(0)
