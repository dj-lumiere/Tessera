// Hello, world: the smallest program, then the same line through a Writer.
//
// Introduces:
//   routine main() -> S32 and block entry()
//   println_slice for a quick line
//   FdWriter, the unbuffered writer every later example prints through

routine main() -> S32
    block entry():
        println_slice("Hello, world!")

        // A writer lives in memory (alloca), because its methods take a pointer.
        %stdout: FdWriter      = FdWriter.stdout()
        #out:    Ptr<FdWriter> = alloca<FdWriter>([%stdout])
        write_str(#out, "Hello again, ")
        %year: U64 = 2026
        %year.format(#out)
        write_str(#out, "!")
        write_line(#out)
        return(0)
