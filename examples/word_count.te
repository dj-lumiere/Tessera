# Count how often each word appears in a sentence.
#
# Introduces:
#   @[Byte] views: count, byte_at, and slice share the original bytes (no copies)
#   Dict[@[Byte], U64], which iterates in insertion order
#   DictEmitter and Optional[KVPair] for walking a collection
#   construct / destruct: the dictionary is built in a place borrowed with <- (.construct(manager)) and its storage is
#   released explicitly

import Collections
import Hosted

### Adds one to the count of `word`, starting it at 1 the first time `word` is seen.
### :param counts: The count of each word seen so far.
### :param word: The word to count.
### :throws: Crashes with `OutOfMemoryError` when the dictionary can't grow.
@reshaping(counts)
routine tally(counts: @Dict[@[Byte], U64], word: @[Byte]) -> None
    if counts.has_key(word)
        count: U64 = counts[word]
        counts[word] = count + 1
        return
    else
        counts[word] = 1
        return

### Splits `text` on single spaces and tallies every word into `counts`. Two spaces in a row count an empty word.
### :param text: The text to split.
### :param counts: The dictionary the counts are added to.
### :throws: Crashes with `OutOfMemoryError` when the dictionary can't grow.
@reshaping(counts)
routine count_words(text: @[Byte], counts: @Dict[@[Byte], U64]) -> None
    count: U64 = text.count()
    start: &U64 <- 0

    ### The current word started at start, and i is the next byte to look at.
    for i in 0 til count
        if text.byte_at(i) == b' '.to[U8]()
            tally(counts, word: text.slice(start: start.load(), end: i))
            (i + 1).poke_into(start)
    tally(counts, word: text.slice(start: start.load(), end: count))
    return

### Writes one line `word: count` for each word in `counts`, in the order the words were first added.
### :param out: Where the lines go.
### :param counts: The words and their counts.
routine print_counts(out: @ConsoleOutput, counts: @Dict[@[Byte], U64]) -> None
    iter: &DictEmitter[@[Byte], U64] <- .construct(counts)

    loop
        item: Optional[KVPair[@[Byte], U64]] = try iter.emit()
        entry: KVPair[@[Byte], U64] = when item
            is KVPair[@[Byte], U64] as entry => entry
            is None => return
        out.write("{entry.key}: {entry.value}\n")

### Counts the words of one sentence and prints each word with its count.
routine start() -> None
    out: @ConsoleOutput = Console.output()
    manager: @MemoryManager = HEAP

    text: @[Byte] = "the cat saw the dog and the dog saw a bird"

    counts: &Dict[@[Byte], U64] <- .construct(manager)
    count_words(text, counts)
    print_counts(out, counts)
    drop counts
    return
