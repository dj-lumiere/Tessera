# Count how often each word appears in a sentence.
#
# Introduces:
#   Span[Byte] views: count, byte_at, and slice share the original bytes (no copies)
#   Dict[Span[Byte], USize], which iterates in insertion order
#   DictIter and Maybe[KVPair] for walking a collection
#   construct / destruct: the dictionary is built in its slot (claim ... <- .construct(alloc)) and its storage is
#   released explicitly

import Standard/Alloc
import Standard/Collections
import Standard/Format
import Standard/Os

### Adds one to the count of `word`, starting it at 1 the first time `word` is seen.
### :param counts: The count of each word seen so far.
### :param word: The word to count.
### :throws: Crashes with `MemoryAllocationError` when the dictionary can't grow.
@reshaping(counts)
routine tally(counts: @Dict[Span[Byte], USize], word: Span[Byte]) -> None
    if counts.has_key(word)
        count: USize = counts[word]
        counts[word] = count + 1
        return
    else
        counts[word] = 1
        return

### Splits `text` on single spaces and tallies every word into `counts`. Two spaces in a row count an empty word.
### :param text: The text to split.
### :param counts: The dictionary the counts are added to.
### :throws: Crashes with `MemoryAllocationError` when the dictionary can't grow.
@reshaping(counts)
routine count_words(text: Span[Byte], counts: @Dict[Span[Byte], USize]) -> None
    local count: USize = text.count()
    local start: @USize <- 0

    ### The current word started at start, and i is the next byte to look at.
    each i in 0 til count
        if text.byte_at(i) == b' '.to[U8]()
            tally(counts, word: text.slice(start: start.peek(), end: i))
            (i + 1).poke_into(start)
    tally(counts, word: text.slice(start: start.peek(), end: count))
    return

### Writes one line `word: count` for each word in `counts`, in the order the words were first added.
### :param out: Where the lines go.
### :param counts: The words and their counts.
routine print_counts(out: @Out, counts: @Dict[Span[Byte], USize]) -> None
    local iter: @DictIter[Span[Byte], USize] <- .construct(counts)

    while true
        item: Maybe[KVPair[Span[Byte], USize]] = iter.emit_checked()
        entry: KVPair[Span[Byte], USize] = when item
            is KVPair[Span[Byte], USize] as entry => entry
            is None => return
        out.write("{entry.key}: {entry.value}\n")

### Counts the words of one sentence and prints each word with its count.
routine start() -> None
    out: @Out = Out.writer()
    local alloc: @MemoryManager <- make_heap_memory()

    text: Span[Byte] = "the cat saw the dog and the dog saw a bird"

    local counts: @Dict[Span[Byte], USize] <- .construct(alloc)
    count_words(text, counts)
    print_counts(out, counts)
    drop counts
    return
