// An else-if chain becomes one select. Later conditions run only if earlier ones failed, so n / d is never
// evaluated when d is 0 (it would panic).
fn classify(n, d) {
    if d == 0 {
        return -1;
    } else if n / d > 10 {
        return 2;
    } else if n / d > 0 {
        return 1;
    } else {
        return 0;
    }
}

fn main() {
    print classify(50, 0);
    print classify(50, 2);
    print classify(5, 2);
    print classify(1, 2);
}
