// The longest Collatz chain below 1000: nested loops, a boolean variable, and a best-so-far pair.
fn steps(n) {
    let count = 0;
    while n != 1 {
        let even = n % 2 == 0;
        if even {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    return count;
}

fn main() {
    let best = 1;
    let best_steps = 0;
    let start = 1;
    while start < 1000 {
        let s = steps(start);
        if s > best_steps && start > 0 {
            best = start;
            best_steps = s;
        }
        start = start + 1;
    }
    print best;
    print best_steps;
}
