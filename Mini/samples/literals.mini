// Literals in every position: as a receiver, on both sides, negative, and returned from main.
fn countdown(n) {
    return 10 - n;
}

fn main() {
    let a = 3 * countdown(4);
    let b = 2 + 3;
    let c = -5 * a;
    let yes = true && a > 0;
    if yes {
        print a;
        print b;
        print c;
    }
    if a > 100 {
        return 1;
    }
    return a - 18;
}
