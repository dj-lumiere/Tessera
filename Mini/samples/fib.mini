// Recursion, and a loop that keeps two values in step.
fn fib_rec(n) {
    if n < 2 {
        return n;
    }
    return fib_rec(n - 1) + fib_rec(n - 2);
}

fn fib_loop(n) {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return a;
}

fn main() {
    print fib_rec(20);
    print fib_loop(90);
}
