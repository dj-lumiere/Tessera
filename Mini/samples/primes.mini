// Trial division: a loop with an early return inside it, called from another loop.
fn is_prime(n) {
    if n < 2 {
        return 0;
    }
    let d = 2;
    while d * d <= n {
        if n % d == 0 {
            return 0;
        }
        d = d + 1;
    }
    return 1;
}

fn main() {
    let n = 2;
    let count = 0;
    while n < 100 {
        if is_prime(n) == 1 {
            count = count + 1;
        }
        n = n + 1;
    }
    print count;
    print is_prime(97);
    print is_prime(91);
}
