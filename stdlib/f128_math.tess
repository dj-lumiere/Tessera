// -- erf, erfc (TLFloat's continued fractions) ----------------------------------

routine wide_special(%i: U64) -> F128Extended
    block entry():
        %w: F128Extended = wide_table(WIDE_SPECIAL_CONST_HI.to_ptr(), WIDE_SPECIAL_CONST_LO.to_ptr(), WIDE_SPECIAL_CONST_EXP.to_ptr(), %i)
        return(%w)

/// erf z = 2/sqrt(pi) × z e^(-z²) × d/n, from the continued fraction evaluated
/// backward over %levels levels (even), two per step.
routine wide_erf_cf(%z: F128Extended, %levels: S64) -> F128Extended
    block entry():
        %zz: F128Extended = %z.mul(%z)
        %n0: F128Extended = wide_from_i64(%levels.mul(2).add(1))
        jump level(%levels, %n0, wide_one(), %zz)

    block level(%i: S64, %n: F128Extended, %d: F128Extended, %zz: F128Extended):
        %done: Bool = %i.le(0)
        branch %done ? finish(%n, %d, %zz) : step(%i, %n, %d, %zz)

    block step(%i: S64, %n: F128Extended, %d: F128Extended, %zz: F128Extended):
        %i2: S64  = %i.mul(2)
        %n1: F128Extended = %n.mul(wide_from_i64(%i2.sub(1))).add(%zz.mul(wide_from_i64(%i2)).mul(%d))
        %n2: F128Extended = %n1.mul(wide_from_i64(%i2.sub(3))).sub(%zz.mul(wide_from_i64(%i2.sub(2))).mul(%n))
        jump level(%i.sub(2), %n2, %n1, %zz)

    block finish(%n: F128Extended, %d: F128Extended, %zz: F128Extended):
        %scale: F128Extended = %z.mul(wide_special(0)).mul(wide_exp(%zz.neg()))
        %r:     F128Extended = %scale.mul(%d.ldexp(1).div(%n))
        return(%r)

/// erfc z = 1/sqrt(pi) × z e^(-z²) × d/n, for the tail |z| >= 3.125.
routine wide_erfc_cf(%z: F128Extended, %levels: S64) -> F128Extended
    block entry():
        %zz: F128Extended = %z.mul(%z)
        jump level(%levels, wide_one(), wide_one(), %zz)

    block level(%i: S64, %n: F128Extended, %d: F128Extended, %zz: F128Extended):
        %done: Bool = %i.le(0)
        branch %done ? finish(%n, %d, %zz) : step(%i, %n, %d, %zz)

    block step(%i: S64, %n: F128Extended, %d: F128Extended, %zz: F128Extended):
        %n1: F128Extended = %n.add(wide_from_i64(%i).ldexp(-1).mul(%d))
        %n2: F128Extended = %zz.mul(%n1).add(wide_from_i64(%i.sub(1)).ldexp(-1).mul(%n))
        jump level(%i.sub(2), %n2, %n1, %zz)

    block finish(%n: F128Extended, %d: F128Extended, %zz: F128Extended):
        %scale: F128Extended = %z.mul(wide_special(0)).mul(wide_exp(%zz.neg()))
        %r:     F128Extended = %scale.mul(%d.div(%n))
        return(%r)

preset F128_ERF_SPLIT: F128 = F128 { bits: 0x40009000000000000000000000000000 }   // 3.125
preset F128_ERF_FLAT:  F128 = F128 { bits: 0x4005E000000000000000000000000000 }   // 120

routine F128.erf(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %zero: Bool = f128_is_zero_bits(%self.bits)
        %a:    Self = %self.abs()
        %flat: Bool = %a.gt(F128_ERF_FLAT).bitor(%self.is_infinite())
        %tail: Bool = %a.ge(F128_ERF_SPLIT)
        %quiet: Self = f128_of(f128_quiet(%self.bits))
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %flat -> one()
            %tail -> tail(%a)
            _ -> middle()

    block one():
        %r: Self = f128_of(0x3FFF0000000000000000000000000000).copysign(%self)
        return(%r)

    block tail(%a: Self):
        %c: F128Extended = wide_erfc_cf(wide_from_f128(%a), 120)
        %r: Self = wide_one().sub(%c).to_f128().copysign(%self)
        return(%r)

    block middle():
        %r: Self = wide_erf_cf(wide_from_f128(%self), 72).to_f128()
        return(%r)

routine F128.erfc(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %neg:   Bool = f128_is_negative_bits(%self.bits)
        %a:     Self = %self.abs()
        %flat:  Bool = %a.gt(F128_ERF_FLAT).bitor(%self.is_infinite())
        %tail:  Bool = %a.ge(F128_ERF_SPLIT)
        %quiet: Self = f128_of(f128_quiet(%self.bits))
        select:
            %nan -> return(%quiet)
            %flat -> flat(%neg)
            %tail -> tail(%a, %neg)
            _ -> middle()

    // erfc(+big) underflows to +0; erfc(-big) is 2
    block flat(%neg: Bool):
        %two:  Self = f128_of(0x40000000000000000000000000000000)
        %zero: Self = f128_of(0)
        branch %neg ? return(%two) : return(%zero)

    block tail(%a: Self, %neg: Bool):
        %c:   F128Extended = wide_erfc_cf(wide_from_f128(%a), 120)
        %two: F128Extended = wide_from_i64(2)
        %v:   F128Extended = %neg ? %two.sub(%c) : %c
        %r:   Self = %v.to_f128()
        return(%r)

    block middle():
        %r: Self = wide_one().sub(wide_erf_cf(wide_from_f128(%self), 72)).to_f128()
        return(%r)

// -- gamma, ln_gamma (Stirling with argument shift and reflection) ---------------

routine wide_gamma_coef(%i: U64) -> F128Extended
    block entry():
        %w:   F128Extended = wide_table(WIDE_GAMMA_COEF_HI.to_ptr(), WIDE_GAMMA_COEF_LO.to_ptr(), WIDE_GAMMA_COEF_EXP.to_ptr(), %i)
        %neg: Bool = WIDE_GAMMA_COEF_NEG.get(%i)
        %r:   F128Extended = %neg ? %w.neg() : %w
        return(%r)

/// sin(π f) for |f| <= 1/2, keeping the series argument within π/4.
routine wide_sin_pi(%f: F128Extended) -> F128Extended
    block entry():
        %pi:    F128Extended = wide_special(3)
        %a:     F128Extended = %f.abs()
        %far:   Bool = %a.exp.ge(-2).bitand(%a.ldexp(2).above_one())    // |f| > 1/4
        %near_v: F128Extended = wide_sin_core(%pi.mul(%f))
        %rest:  F128Extended = wide_from_i64(1).ldexp(-1).sub(%a)                 // 1/2 - |f|
        %far_v0: F128Extended = wide_cos_core(%pi.mul(%rest))
        %far_v: F128Extended = %f.negative ? %far_v0.neg() : %far_v0
        %r:     F128Extended = %far ? %far_v : %near_v
        return(%r)

record LnGamma
    negative: Bool      // the sign of Γ(x)
    ln:       F128Extended      // ln |Γ(x)|

/// ln |Γ(x)| and Γ's sign for finite x, not a pole. Below -1, reflection:
/// ln|Γ(x)| = ln π - ln|sin(π f)| - ln Γ(1 - x). Below 20, the recurrence
/// Γ(a) = Γ(a + 20 - k) / (a (a + 1) …) lifts a to 20 + f first, where the
/// Stirling series (36 terms in 1/a²) is accurate far past F128.
routine wide_ln_gamma(%x: F128Extended) -> LnGamma
    block entry():
        %one:     F128Extended = wide_one()
        %reflect: Bool = %x.negative.bitand(%x.above_one())
        %a:       F128Extended = %reflect ? %one.sub(%x) : %x
        // the nearest integer stays an F128: for x near -2^70 it doesn't fit an S64
        %rint:    F128 = %a.to_f128().round_ties_even()
        %odd:     Bool = f128_is_odd_integer(%rint)
        %fr:      F128Extended = %a.sub(wide_from_f128(%rint))
        %small:   Bool = %rint.lt(f128_of(0x40034000000000000000000000000000))   // 20
        branch %small ? lift(%rint.to_s64_clamp(), %fr, %one, %odd, %reflect) : stirling(%a, %one, %fr, %odd, %reflect)

    // w = (inv + fr)(inv + 1 + fr) … (19 + fr), and a becomes 20 + fr
    block lift(%k: S64, %fr: F128Extended, %w: F128Extended, %odd: Bool, %reflect: Bool):
        %done: Bool = %k.ge(20)
        branch %done ? lifted(%fr, %w, %odd, %reflect) : factor(%k, %fr, %w, %odd, %reflect)

    block factor(%k: S64, %fr: F128Extended, %w: F128Extended, %odd: Bool, %reflect: Bool):
        %term: F128Extended = wide_from_i64(%k).add(%fr)
        jump lift(%k.add(1), %fr, %w.mul(%term), %odd, %reflect)

    block lifted(%fr: F128Extended, %w: F128Extended, %odd: Bool, %reflect: Bool):
        %a: F128Extended = wide_from_i64(20).add(%fr)
        jump stirling(%a, %w, %fr, %odd, %reflect)

    // series(1/a²)/a + (a - 1/2) ln a - a + ln(2π)/2 - ln|w|
    block stirling(%a: F128Extended, %w: F128Extended, %fr: F128Extended, %odd: Bool, %reflect: Bool):
        %inv_aa: F128Extended = wide_one().div(%a.mul(%a))
        %last:   F128Extended = wide_gamma_coef(35)
        jump series(34, %last, %a, %w, %fr, %odd, %reflect, %inv_aa)

    block series(%i: S64, %s: F128Extended, %a: F128Extended, %w: F128Extended, %fr: F128Extended, %odd: Bool, %reflect: Bool, %inv_aa: F128Extended):
        %done: Bool = %i.lt(0)
        branch %done ? assemble(%s, %a, %w, %fr, %odd, %reflect)
                     : term(%i, %s, %a, %w, %fr, %odd, %reflect, %inv_aa)

    block term(%i: S64, %s: F128Extended, %a: F128Extended, %w: F128Extended, %fr: F128Extended, %odd: Bool, %reflect: Bool, %inv_aa: F128Extended):
        %next: F128Extended = %s.mul(%inv_aa).add(wide_gamma_coef(%i.to_u64()))
        jump series(%i.sub(1), %next, %a, %w, %fr, %odd, %reflect, %inv_aa)

    block assemble(%s: F128Extended, %a: F128Extended, %w: F128Extended, %fr: F128Extended, %odd: Bool, %reflect: Bool):
        %half:  F128Extended = wide_one().ldexp(-1)
        %y0:    F128Extended = %s.div(%a).add(%a.sub(%half).mul(wide_log(%a))).sub(%a).add(%half.mul(wide_special(1)))
        %y:     F128Extended = %y0.sub(wide_log(%w.abs()))
        %w_neg: Bool = %w.negative
        branch %reflect ? reflected(%y, %fr, %odd) : plain(%y, %w_neg)

    block plain(%y: F128Extended, %negative: Bool):
        %r: LnGamma = LnGamma { negative: %negative, ln: %y }
        return(%r)

    // the sign: Γ(x) < 0 exactly when sin(π f) < 0 and the rounded 1 - x is even, or neither
    block reflected(%y: F128Extended, %fr: F128Extended, %odd: Bool):
        %s:      F128Extended = wide_sin_pi(%fr)
        %ln:     F128Extended = wide_special(2).sub(wide_log(%s.abs())).sub(%y)
        %even:   Bool = %odd.bitnot()
        %negative: Bool = %s.negative.eq(%even)
        %r: LnGamma = LnGamma { negative: %negative, ln: %ln }
        return(%r)

/// ln |Γ(x)|: +inf at the poles (0 and the negative integers) and at ±inf.
/// Exact +0 at 1 and 2; near those points and near its other zeros the result
/// keeps an absolute error around 2^-180, not a relative one.
routine F128.ln_gamma(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %zero:  Bool = f128_is_zero_bits(%self.bits)
        %inf:   Bool = %self.is_infinite()
        %pole:  Bool = f128_is_negative_bits(%self.bits).bitand(f128_is_integer(%self))
        %one:   Bool = %self.eq(f128_of(0x3FFF0000000000000000000000000000))
        %two:   Bool = %self.eq(f128_of(0x40000000000000000000000000000000))
        %quiet: Self = f128_of(f128_quiet(%self.bits))
        %infinity: Self = Self.INFINITY
        %plus_zero: Self = f128_of(0)
        %blows_up: Bool = %zero.bitor(%inf).bitor(%pole)
        %exact: Bool = %one.bitor(%two)
        select:
            %nan -> return(%quiet)
            %blows_up -> return(%infinity)
            %exact -> return(%plus_zero)
            _ -> compute()

    block compute():
        %g: LnGamma = wide_ln_gamma(wide_from_f128(%self))
        %r: Self = %g.ln.to_f128()
        return(%r)

/// Γ(x): ±inf at ±0, NaN at the negative integers and -inf.
routine F128.gamma(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %zero:  Bool = f128_is_zero_bits(%self.bits)
        %neg:   Bool = f128_is_negative_bits(%self.bits)
        %pole:  Bool = %neg.bitand(f128_is_integer(%self)).bitor(%self.eq(Self.NEG_INFINITY))
        %big:   Bool = %self.gt(f128_of(0x4009C200000000000000000000000000))     // 1800
        %quiet: Self = f128_of(f128_quiet(%self.bits))
        %invalid: Self = Self.NAN
        %infinity: Self = Self.INFINITY
        select:
            %nan -> return(%quiet)
            %zero -> signed_inf()
            %pole -> return(%invalid)
            %big -> return(%infinity)
            _ -> compute()

    block signed_inf():
        %r: Self = Self.INFINITY.copysign(%self)
        return(%r)

    // e^ln|Γ|, clamped where it certainly over- or underflows
    block compute():
        %g:     LnGamma = wide_ln_gamma(wide_from_f128(%self))
        %ln_f:  Self = %g.ln.to_f128()
        %over:  Bool = %ln_f.gt(f128_of(0x400C6300000000000000000000000000))     // 11360
        %under: Bool = %ln_f.lt(f128_of(0xC00C6700000000000000000000000000))     // -11488
        %huge:  Self = Self.INFINITY
        %tiny:  Self = f128_of(0)
        select:
            %over -> signed(%huge, %g.negative)
            %under -> signed(%tiny, %g.negative)
            _ -> finite(%g)

    block finite(%g: LnGamma):
        %r: Self = wide_exp(%g.ln).to_f128()
        jump signed(%r, %g.negative)

    block signed(%r: Self, %negative: Bool):
        %s: Self = %negative ? %r.neg() : %r
        return(%s)
