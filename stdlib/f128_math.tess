; -- argument reduction (Payne-Hanek) ------------------------------------------

; x = k × π/2 + θ with k taken mod 4 and |θ| <= π/4.
record Reduced
    quadrant: I64
    theta:    Wide

; 64 bits of the little-endian limbs at #p starting at bit %pos (pos >= 0).
routine limbs_bits64(#p: Ptr<I64>, %pos: I64) -> I64
    block entry():
        %i:   I64 = %pos.ashr(6)
        %off: I64 = %pos.bitand(63)
        %low: I64 := #p[%i]
        %aligned: Bool = %off.eq(0)
        branch %aligned ? return(%low) : join(%i, %off, %low)

    block join(%i: I64, %off: I64, %low: I64):
        %j:    I64 = %i.add(1)
        %high: I64 := #p[%j]
        %r:    I64 = %low.lshr(%off).bitor(%high.shl(64.sub(%off)))
        return(%r)

; Reduces |x| (finite, nonzero). With x = m × 2^(e - 112), x × 2/π keeps only
; the bits of 2/π that land below 4: a 512-bit window W of them, so x × 2/π
; mod 4 = m × W × 2^-sh. The product's bits above sh give the quadrant and the
; ones below it the fraction f, which stays accurate to about 2^-330 absolute:
; enough even where x sits right next to a multiple of π/2.
routine f128_reduce(%x: F128) -> Reduced
    block entry():
        %p: F128Parts = f128_unpack(%x.bits)
        %small: Bool = %p.exp.slt(-1)                      ; |x| < 0.5 < π/4
        branch %small ? near_zero() : window(%p)

    block near_zero():
        %r: Reduced = Reduced { quadrant: 0, theta: wide_from_f128(%x.abs()) }
        return(%r)

    block window(%p: F128Parts):
        %start: I64 = %p.exp.sub(114).max(0).sdiv(64)       ; first 2/π limb used
        %sh:    I64 = %start.add(8).mul(64).sub(%p.exp).add(112)
        #prod:  Ptr<Array<I64, 12>> = alloca<Array<I64, 12>>
        #limbs: Ptr<I64> = #prod.cast<I64>()
        zero<I64>(#limbs, 12)
        %m0: I128 = %p.sig.bitand(0xFFFFFFFFFFFFFFFF)
        %m1: I128 = %p.sig.lshr(64)
        jump multiply(0, %start, %sh, %m0, %m1, #limbs)

    ; limb k of W (little-endian) is TWO_OVER_PI[start + 7 - k]; add m × w_k at limb k
    block multiply(%k: I64, %start: I64, %sh: I64, %m0: I128, %m1: I128, #limbs: Ptr<I64>):
        %done: Bool = %k.sge(8)
        branch %done ? extract(%sh, #limbs) : term(%k, %start, %sh, %m0, %m1, #limbs)

    block term(%k: I64, %start: I64, %sh: I64, %m0: I128, %m1: I128, #limbs: Ptr<I64>):
        %index: I64  = %start.add(7).sub(%k)
        %w:     I64  := TWO_OVER_PI[%index]
        %wide:  I128 = %w.to_u128()
        %lo_p:  I128 = %m0.mul(%wide)
        %hi_p:  I128 = %m1.mul(%wide)
        %k1:    I64  = %k.add(1)
        %k2:    I64  = %k.add(2)
        %r0:    I64  := #limbs[%k]
        %r1:    I64  := #limbs[%k1]
        %r2:    I64  := #limbs[%k2]
        ; limb k gets lo_p's low half; limb k+1 lo_p's high half and hi_p's low; k+2 the rest
        %s0:    I128 = %r0.to_u128().add(%lo_p.bitand(0xFFFFFFFFFFFFFFFF))
        %s1:    I128 = %r1.to_u128().add(%lo_p.lshr(64)).add(%hi_p.bitand(0xFFFFFFFFFFFFFFFF)).add(%s0.lshr(64))
        %s2:    I128 = %r2.to_u128().add(%hi_p.lshr(64)).add(%s1.lshr(64))
        #limbs[%k] = %s0.to_i64()
        #limbs[%k1] = %s1.to_i64()
        #limbs[%k2] = %s2.to_i64()
        %carry: I64  = %s2.lshr(64).to_i64()
        jump spill(%k.add(3), %carry, %k, %start, %sh, %m0, %m1, #limbs)

    ; carry on up the limbs
    block spill(%j: I64, %carry: I64, %k: I64, %start: I64, %sh: I64, %m0: I128, %m1: I128, #limbs: Ptr<I64>):
        %none: Bool = %carry.eq(0).bitor(%j.sge(12))
        branch %none ? multiply(%k.add(1), %start, %sh, %m0, %m1, #limbs)
                     : spill_one(%j, %carry, %k, %start, %sh, %m0, %m1, #limbs)

    block spill_one(%j: I64, %carry: I64, %k: I64, %start: I64, %sh: I64, %m0: I128, %m1: I128, #limbs: Ptr<I64>):
        %r: I64  := #limbs[%j]
        %s: I128 = %r.to_u128().add(%carry.to_u128())
        #limbs[%j] = %s.to_i64()
        jump spill(%j.add(1), %s.lshr(64).to_i64(), %k, %start, %sh, %m0, %m1, #limbs)

    ; quadrant: bits sh and sh+1; fraction: the 256 bits under sh, normalized
    block extract(%sh: I64, #limbs: Ptr<I64>):
        %q:  I64  = limbs_bits64(#limbs, %sh).bitand(3)
        %a:  I64  = limbs_bits64(#limbs, %sh.sub(64))
        %b:  I64  = limbs_bits64(#limbs, %sh.sub(128))
        %c:  I64  = limbs_bits64(#limbs, %sh.sub(192))
        %d:  I64  = limbs_bits64(#limbs, %sh.sub(256))
        %x_hi: I128 = %a.to_u128().shl(64).bitor(%b.to_u128())
        %x_lo: I128 = %c.to_u128().shl(64).bitor(%d.to_u128())
        ; f = X × 2^-256 in [0, 1). Past 1/2, count the next quadrant and use
        ; f - 1 = -(2^256 - X) × 2^-256, complemented on all 256 bits before
        ; normalizing: f can be 1 - 2^-120, and f - 1 taken after cutting f to
        ; 192 bits would keep only its last 72.
        %past_half: Bool = %a.slt(0)
        %neg_lo: I128 = 0.sub(%x_lo)
        %borrow: I128 = %x_lo.ne(0).to_i128()
        %neg_hi: I128 = 0.sub(%x_hi).sub(%borrow)
        %use_hi: I128 = %past_half ? %neg_hi : %x_hi
        %use_lo: I128 = %past_half ? %neg_lo : %x_lo
        %magnitude: Wide = wide_from_256(%use_hi, %use_lo)
        %g:    Wide = %past_half ? %magnitude.neg() : %magnitude
        %k:    I64  = %past_half ? %q.add(1).bitand(3) : %q
        %theta: Wide = %g.mul(wide_table(WIDE_HALF_PI_HI.as_ptr(), WIDE_HALF_PI_LO.as_ptr(), WIDE_HALF_PI_EXP.as_ptr(), 0))
        %r: Reduced = Reduced { quadrant: %k, theta: %theta }
        return(%r)

; (hi × 2^128 + lo) × 2^-256 as a Wide, keeping its top 192 bits.
routine wide_from_256(%hi: I128, %lo: I128) -> Wide
    block entry():
        jump shift(%hi, %lo, -1)

    block shift(%hi: I128, %lo: I128, %exp: I64):
        %empty: Bool = %hi.eq(0)
        %all:   Bool = %empty.bitand(%lo.eq(0))
        %nothing: Wide = wide_zero()
        select:
            %all -> return(%nothing)
            %empty -> shift(%lo, 0, %exp.sub(128))
            _ -> bits(%hi, %lo, %exp)

    block bits(%hi: I128, %lo: I128, %exp: I64):
        %s:      I64  = %hi.leading_zeros().to_i64()
        %some:   Bool = %s.sgt(0)
        %carry:  I128 = %some ? %lo.lshr(128.sub(%s).to_i128()) : 0
        %new_hi: I128 = %hi.shl(%s.to_i128()).bitor(%carry)
        %new_lo: I128 = %lo.shl(%s.to_i128())
        %w: Wide = Wide { negative: false, exp: %exp.sub(%s), hi: %new_hi, lo: %new_lo.lshr(64).to_i64() }
        return(%w)

; -- sin, cos, tan -------------------------------------------------------------

; sin θ = θ Σ (-θ²)^k / (2k+1)!  and  cos θ = Σ (-θ²)^k / (2k)!, 18 terms each,
; for |θ| <= π/4 (the first dropped term is below 2^-139).
routine wide_sin_core(%t: Wide) -> Wide
    block entry():
        %u:    Wide = %t.mul(%t).neg()
        %last: Wide = wide_table(WIDE_SIN_COEF_HI.as_ptr(), WIDE_SIN_COEF_LO.as_ptr(), WIDE_SIN_COEF_EXP.as_ptr(), 17)
        jump horner(16, %last, %u, %t)

    block horner(%i: I64, %s: Wide, %u: Wide, %t: Wide):
        %done: Bool = %i.slt(0)
        %r:    Wide = %s.mul(%t)
        branch %done ? return(%r) : step(%i, %s, %u, %t)

    block step(%i: I64, %s: Wide, %u: Wide, %t: Wide):
        %c: Wide = wide_table(WIDE_SIN_COEF_HI.as_ptr(), WIDE_SIN_COEF_LO.as_ptr(), WIDE_SIN_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%u).add(%c), %u, %t)

routine wide_cos_core(%t: Wide) -> Wide
    block entry():
        %u:    Wide = %t.mul(%t).neg()
        %last: Wide = wide_table(WIDE_COS_COEF_HI.as_ptr(), WIDE_COS_COEF_LO.as_ptr(), WIDE_COS_COEF_EXP.as_ptr(), 17)
        jump horner(16, %last, %u)

    block horner(%i: I64, %s: Wide, %u: Wide):
        %done: Bool = %i.slt(0)
        branch %done ? return(%s) : step(%i, %s, %u)

    block step(%i: I64, %s: Wide, %u: Wide):
        %c: Wide = wide_table(WIDE_COS_COEF_HI.as_ptr(), WIDE_COS_COEF_LO.as_ptr(), WIDE_COS_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%u).add(%c), %u)

choice TrigKind
    Sin
    Cos
    Tan

; sin, cos, or tan of a finite nonzero x, before the final rounding.
routine wide_trig(%x: F128, %kind: TrigKind) -> Wide
    block entry():
        %red: Reduced = f128_reduce(%x)
        %k:   I64  = %red.quadrant
        %s:   Wide = wide_sin_core(%red.theta)
        %c:   Wide = wide_cos_core(%red.theta)
        %odd: Bool = %k.bitand(1).eq(1)
        ; sin(kπ/2 + θ) = sin θ, cos θ, -sin θ, -cos θ for k = 0, 1, 2, 3; cos is sin one quadrant on
        %sin_base: Wide = %odd ? %c : %s
        %sin_neg:  Bool = %k.sge(2)
        %cos_base: Wide = %odd ? %s : %c
        %cos_neg:  Bool = %k.eq(1).bitor(%k.eq(2))
        %sin_v: Wide = %sin_neg ? %sin_base.neg() : %sin_base
        %cos_v: Wide = %cos_neg ? %cos_base.neg() : %cos_base
        ; sin is odd in x, cos even
        %x_neg: Bool = %x.bits.slt(0)
        %sin_r: Wide = %x_neg ? %sin_v.neg() : %sin_v
        switch %kind:
            TrigKind.Sin -> return(%sin_r)
            TrigKind.Cos -> return(%cos_v)
            TrigKind.Tan -> tan(%sin_r, %cos_v)

    block tan(%sin: Wide, %cos: Wide):
        %r: Wide = %sin.div(%cos)
        return(%r)

; NaN for NaN and infinities; sin and tan keep a zero's sign, cos(0) is 1.
routine f128_trig(%x: F128, %kind: TrigKind) -> F128
    block entry():
        %finite: Bool = %x.is_finite()
        %zero:   Bool = f128_is_zero_bits(%x.bits)
        %nan:    F128 = F128.NAN
        %quiet:  F128 = F128.from_bits(f128_quiet(%x.bits))
        %is_nan: Bool = %x.is_nan()
        %infinite: Bool = %finite.bitnot()
        select:
            %is_nan -> return(%quiet)
            %infinite -> return(%nan)
            %zero -> at_zero()
            _ -> compute()

    block at_zero():
        %one_bits: F128 = F128.from_bits(0x3FFF0000000000000000000000000000)
        %is_cos:   Bool = %kind.eq(TrigKind.Cos)
        branch %is_cos ? return(%one_bits) : return(%x)

    block compute():
        %r: F128 = wide_trig(%x, %kind).to_f128()
        return(%r)

; sin and cos are CORE-MATH ports (f128_core/); NaN and infinities keep
; f128_trig's answers.
routine F128.sin(%self: Self) -> Self
    block entry():
        %finite: Bool = %self.is_finite()
        branch %finite ? compute() : special()

    block compute():
        %r: Self = f128_cm_sin(%self)
        return(%r)

    block special():
        %r: Self = f128_trig(%self, TrigKind.Sin)
        return(%r)

routine F128.cos(%self: Self) -> Self
    block entry():
        %finite: Bool = %self.is_finite()
        branch %finite ? compute() : special()

    block compute():
        %r: Self = f128_cm_cos(%self)
        return(%r)

    block special():
        %r: Self = f128_trig(%self, TrigKind.Cos)
        return(%r)

; sin and cos together, sharing one argument reduction
routine F128.sin_cos(%self: Self) -> F128SinCos
    block entry():
        %finite: Bool = %self.is_finite()
        branch %finite ? compute() : special()

    block compute():
        %r: F128SinCos = f128_cm_sin_cos(%self)
        return(%r)

    block special():
        %r: F128SinCos = F128SinCos { sin: %self.sin(), cos: %self.cos() }
        return(%r)

routine F128.tan(%self: Self) -> Self
    block entry():
        %r: Self = f128_trig(%self, TrigKind.Tan)
        return(%r)

; -- more Wide -----------------------------------------------------------------

routine Wide.abs(%self: Self) -> Self
    block entry():
        %r: Self = Self { negative: false, exp: %self.exp, hi: %self.hi, lo: %self.lo }
        return(%r)

; sqrt for self > 0: Newton's method on 1/sqrt, y ← y (3 - a y²) / 2, from an
; F64 seed (53 bits → 106 → 212), then × a.
routine Wide.sqrt(%self: Self) -> Self
    block entry():
        %zero: Bool = %self.is_zero()
        branch %zero ? return(%self) : root()

    block root():
        %half_e: I64  = %self.exp.ashr(1)                        ; floor(e / 2)
        %unit:   Wide = %self.ldexp(0.sub(%half_e).mul(2))        ; in [1, 4)
        %seed64: F64  = %unit.to_f128().to_f64().sqrt()
        %one64:  F64  = 1.0
        %y0:     Wide = wide_from_f128(%one64.fdiv(%seed64).to_f128())
        %three:  Wide = wide_from_i64(3)
        %y1:     Wide = %y0.mul(%three.sub(%unit.mul(%y0).mul(%y0))).ldexp(-1)
        %y2:     Wide = %y1.mul(%three.sub(%unit.mul(%y1).mul(%y1))).ldexp(-1)
        %r:      Wide = %unit.mul(%y2).ldexp(%half_e)
        return(%r)

; |self| > 1?
routine Wide.above_one(%self: Self) -> Bool
    block entry():
        %big:   Bool = %self.exp.sgt(0)
        %one_e: Bool = %self.exp.eq(0)
        %more:  Bool = %self.hi.ne(F128_SIGN).bitor(%self.lo.ne(0))
        %zero:  Bool = %self.is_zero()
        %r:     Bool = %big.bitor(%one_e.bitand(%more)).bitand(%zero.bitnot())
        return(%r)

routine wide_one() -> Wide
    block entry():
        %r: Wide = wide_from_i64(1)
        return(%r)

routine wide_half_pi() -> Wide
    block entry():
        %r: Wide = wide_table(WIDE_HALF_PI_HI.as_ptr(), WIDE_HALF_PI_LO.as_ptr(), WIDE_HALF_PI_EXP.as_ptr(), 0)
        return(%r)

; -- exp_m1, ln_1p ---------------------------------------------------------------

; e^x - 1 without cancellation: below |x| = 1/2 the series x Σ x^j / (j+1)!
; (35 terms, the first dropped one under 2^-150 relative), else e^x - 1.
routine wide_exp_m1(%x: Wide) -> Wide
    block entry():
        %small: Bool = %x.exp.slt(-1)
        branch %small ? series(%x) : direct(%x)

    block direct(%x: Wide):
        %r: Wide = wide_exp(%x).sub(wide_one())
        return(%r)

    block series(%x: Wide):
        %last: Wide = wide_table(WIDE_EXP_COEF_HI.as_ptr(), WIDE_EXP_COEF_LO.as_ptr(), WIDE_EXP_COEF_EXP.as_ptr(), 35)
        jump horner(34, %last, %x)

    block horner(%i: I64, %s: Wide, %x: Wide):
        %done: Bool = %i.slt(1)
        %r:    Wide = %s.mul(%x)
        branch %done ? return(%r) : step(%i, %s, %x)

    block step(%i: I64, %s: Wide, %x: Wide):
        %c: Wide = wide_table(WIDE_EXP_COEF_HI.as_ptr(), WIDE_EXP_COEF_LO.as_ptr(), WIDE_EXP_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%x).add(%c), %x)

; ln(1 + x) for x > -1: below |x| = 1/4, 2 atanh(t) with t = x / (2 + x)
; (|t| < 0.143, inside the log series' reach); else ln of 1 + x, which is exact.
routine wide_ln_1p(%x: Wide) -> Wide
    block entry():
        %small: Bool = %x.exp.slt(-2)
        branch %small ? series(%x) : direct(%x)

    block direct(%x: Wide):
        %r: Wide = wide_log(%x.add(wide_one()))
        return(%r)

    block series(%x: Wide):
        %t:    Wide = %x.div(%x.add(wide_from_i64(2)))
        %tt:   Wide = %t.mul(%t)
        %last: Wide = wide_table(WIDE_LOG_COEF_HI.as_ptr(), WIDE_LOG_COEF_LO.as_ptr(), WIDE_LOG_COEF_EXP.as_ptr(), 25)
        jump horner(24, %last, %tt, %t)

    block horner(%i: I64, %s: Wide, %tt: Wide, %t: Wide):
        %done: Bool = %i.slt(0)
        %r:    Wide = %s.mul(%t).ldexp(1)
        branch %done ? return(%r) : step(%i, %s, %tt, %t)

    block step(%i: I64, %s: Wide, %tt: Wide, %t: Wide):
        %c: Wide = wide_table(WIDE_LOG_COEF_HI.as_ptr(), WIDE_LOG_COEF_LO.as_ptr(), WIDE_LOG_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%tt).add(%c), %tt, %t)

; -- atan ----------------------------------------------------------------------

; atan x = x Σ (-x²)^k / (2k+1), 26 terms, for |x| < 0.1.
routine wide_atan_series(%x: Wide) -> Wide
    block entry():
        %u:    Wide = %x.mul(%x).neg()
        %last: Wide = wide_table(WIDE_LOG_COEF_HI.as_ptr(), WIDE_LOG_COEF_LO.as_ptr(), WIDE_LOG_COEF_EXP.as_ptr(), 25)
        jump horner(24, %last, %u, %x)

    block horner(%i: I64, %s: Wide, %u: Wide, %x: Wide):
        %done: Bool = %i.slt(0)
        %r:    Wide = %s.mul(%x)
        branch %done ? return(%r) : step(%i, %s, %u, %x)

    block step(%i: I64, %s: Wide, %u: Wide, %x: Wide):
        %c: Wide = wide_table(WIDE_LOG_COEF_HI.as_ptr(), WIDE_LOG_COEF_LO.as_ptr(), WIDE_LOG_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%u).add(%c), %u, %x)

; atan x for any finite x: past |x| = 1, π/2 - atan(1/|x|); then three
; half-angle steps x ← x / (1 + sqrt(1 + x²)) bring |x| <= 1 under 0.1.
routine wide_atan(%x: Wide) -> Wide
    block entry():
        %a:      Wide = %x.abs()
        %big:    Bool = %a.above_one()
        %inv:    Wide = wide_one().div(%a)
        %small:  Wide = %big ? %inv : %a
        jump halve(0, %small, %big)

    block halve(%n: I64, %t: Wide, %big: Bool):
        %done: Bool = %n.sge(3)
        branch %done ? finish(%t, %big) : step(%n, %t, %big)

    block step(%n: I64, %t: Wide, %big: Bool):
        %one:  Wide = wide_one()
        %next: Wide = %t.div(%one.add(%one.add(%t.mul(%t)).sqrt()))
        jump halve(%n.add(1), %next, %big)

    block finish(%t: Wide, %big: Bool):
        %r0:  Wide = wide_atan_series(%t).ldexp(3)
        %r1:  Wide = %big ? wide_half_pi().sub(%r0) : %r0
        %r:   Wide = %x.negative ? %r1.neg() : %r1
        return(%r)

; -- F128 wrappers -------------------------------------------------------------

; Most functions below share the same frame: NaN in, NaN out; a few fixed
; answers for infinities and zeros; otherwise compute in Wide and round once.

; atan, asin, acos, and atan2 are CORE-MATH ports (f128_core/); NaN in and
; outside the domain keep F128's own NaNs.
routine F128.atan(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        branch %nan ? return(%quiet) : compute()

    block compute():
        %r: Self = f128_cm_atan(%self)
        return(%r)

routine F128.asin(%self: Self) -> Self
    block entry():
        %nan:     Bool = %self.is_nan()
        %outside: Bool = %self.abs().gt(F128.from_bits(0x3FFF0000000000000000000000000000))
        %quiet:   Self = Self.from_bits(f128_quiet(%self.bits))
        %invalid: Self = Self.NAN
        select:
            %nan -> return(%quiet)
            %outside -> return(%invalid)
            _ -> compute()

    block compute():
        %r: Self = f128_cm_asin(%self)
        return(%r)

routine F128.acos(%self: Self) -> Self
    block entry():
        %nan:     Bool = %self.is_nan()
        %outside: Bool = %self.abs().gt(F128.from_bits(0x3FFF0000000000000000000000000000))
        %quiet:   Self = Self.from_bits(f128_quiet(%self.bits))
        %invalid: Self = Self.NAN
        select:
            %nan -> return(%quiet)
            %outside -> return(%invalid)
            _ -> compute()

    block compute():
        %r: Self = f128_cm_acos(%self)
        return(%r)

; atan2(y, x), the angle of (x, y), with IEEE's rules for zeros and infinities.
routine F128.atan2(%self: Self, %x: Self) -> Self
    block entry():
        %nan: Bool = %self.is_nan().bitor(%x.is_nan())
        %quiet: Self = Self.NAN
        branch %nan ? return(%quiet) : compute()

    block compute():
        %r: Self = f128_cm_atan2(%self, %x)
        return(%r)

; -- hyperbolic ----------------------------------------------------------------

routine F128.sinh(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %zero: Bool = f128_is_zero_bits(%self.bits)
        %inf:  Bool = %self.is_infinite()
        %big:  Bool = %self.abs().gt(F128.from_bits(0x400C6400000000000000000000000000))  ; 11392
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %inf -> return(%self)
            %big -> huge()
            _ -> compute()

    block huge():
        %r: Self = Self.INFINITY.copysign(%self)
        return(%r)

    ; sinh a = (e^a - e^-a) / 2; below 1/2 from m = e^a - 1: (m + m / (m + 1)) / 2
    block compute():
        %a:     Wide = wide_from_f128(%self.abs())
        %small: Bool = %a.exp.slt(-1)
        %m:     Wide = wide_exp_m1(%a)
        %via_m: Wide = %m.add(%m.div(%m.add(wide_one()))).ldexp(-1)
        %e:     Wide = wide_exp(%a)
        %via_e: Wide = %e.sub(wide_one().div(%e)).ldexp(-1)
        %s:     Wide = %small ? %via_m : %via_e
        %r:     Self = %s.to_f128().copysign(%self)
        return(%r)

routine F128.cosh(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %inf:  Bool = %self.is_infinite()
        %big:  Bool = %self.abs().gt(F128.from_bits(0x400C6400000000000000000000000000))
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        %infinity: Self = Self.INFINITY
        %over: Bool = %inf.bitor(%big)
        select:
            %nan -> return(%quiet)
            %over -> return(%infinity)
            _ -> compute()

    block compute():
        %e: Wide = wide_exp(wide_from_f128(%self.abs()))
        %r: Self = %e.add(wide_one().div(%e)).ldexp(-1).to_f128()
        return(%r)

; tanh a = m / (m + 2) with m = e^(2a) - 1; ±1 past |x| = 64.
routine F128.tanh(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %zero: Bool = f128_is_zero_bits(%self.bits)
        %flat: Bool = %self.abs().gt(F128.from_bits(0x40050000000000000000000000000000))  ; 64
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %flat -> one()
            _ -> compute()

    block one():
        %r: Self = Self.from_bits(0x3FFF0000000000000000000000000000).copysign(%self)
        return(%r)

    block compute():
        %m: Wide = wide_exp_m1(wide_from_f128(%self.abs()).ldexp(1))
        %t: Wide = %m.div(%m.add(wide_from_i64(2)))
        %r: Self = %t.to_f128().copysign(%self)
        return(%r)

; asinh a = ln_1p(a + a² / (1 + sqrt(1 + a²))) below 1/2, else ln(a + sqrt(a² + 1)).
routine F128.asinh(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %zero: Bool = f128_is_zero_bits(%self.bits)
        %inf:  Bool = %self.is_infinite()
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %inf -> return(%self)
            _ -> compute()

    block compute():
        %a:     Wide = wide_from_f128(%self.abs())
        %one:   Wide = wide_one()
        %aa:    Wide = %a.mul(%a)
        %root:  Wide = %aa.add(%one).sqrt()
        %small: Bool = %a.exp.slt(-1)
        %near:  Wide = wide_ln_1p(%a.add(%aa.div(%one.add(%root))))
        %far:   Wide = wide_log(%a.add(%root))
        %s:     Wide = %small ? %near : %far
        %r:     Self = %s.to_f128().copysign(%self)
        return(%r)

; acosh x for x >= 1: with y = x - 1, ln_1p(y + sqrt(y (y + 2))) below y = 1/2,
; else ln(x + sqrt(x² - 1)).
routine F128.acosh(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %below: Bool = %self.lt(F128.from_bits(0x3FFF0000000000000000000000000000))
        %inf:   Bool = %self.is_infinite()
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        %invalid: Self = Self.NAN
        select:
            %nan -> return(%quiet)
            %below -> return(%invalid)
            %inf -> return(%self)
            _ -> compute()

    block compute():
        %x:     Wide = wide_from_f128(%self)
        %one:   Wide = wide_one()
        %y:     Wide = %x.sub(%one)
        %small: Bool = %y.exp.slt(-1)
        %near:  Wide = wide_ln_1p(%y.add(%y.mul(%y.add(wide_from_i64(2))).sqrt()))
        %far:   Wide = wide_log(%x.add(%x.mul(%x).sub(%one).sqrt()))
        %s:     Wide = %small ? %near : %far
        %r:     Self = %s.to_f128()
        return(%r)

; atanh a = ln_1p(2a / (1 - a)) / 2; ±inf at ±1, NaN beyond.
routine F128.atanh(%self: Self) -> Self
    block entry():
        %nan:    Bool = %self.is_nan()
        %zero:   Bool = f128_is_zero_bits(%self.bits)
        %a:      Self = %self.abs()
        %one:    Self = Self.from_bits(0x3FFF0000000000000000000000000000)
        %at_one: Bool = %a.eq(%one)
        %beyond: Bool = %a.gt(%one)
        %quiet:  Self = Self.from_bits(f128_quiet(%self.bits))
        %invalid: Self = Self.NAN
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %beyond -> return(%invalid)
            %at_one -> pole()
            _ -> compute(%a)

    block pole():
        %r: Self = Self.INFINITY.copysign(%self)
        return(%r)

    block compute(%a: Self):
        %w:   Wide = wide_from_f128(%a)
        %arg: Wide = %w.ldexp(1).div(wide_one().sub(%w))
        %r:   Self = wide_ln_1p(%arg).ldexp(-1).to_f128().copysign(%self)
        return(%r)

; -- exponentials and logarithms -----------------------------------------------

routine F128.exp_m1(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %zero:  Bool = f128_is_zero_bits(%self.bits)
        %over:  Bool = %self.gt(F128.from_bits(0x400C6300000000000000000000000000))   ; 11360
        %under: Bool = %self.lt(F128.from_bits(0xC0050000000000000000000000000000))   ; -64: -1 after rounding
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        %infinity: Self = Self.INFINITY
        %minus_one: Self = Self.from_bits(0xBFFF0000000000000000000000000000)
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %over -> return(%infinity)
            %under -> return(%minus_one)
            _ -> compute()

    block compute():
        %r: Self = f128_cm_expm1(%self)
        return(%r)

routine F128.exp2(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %over:  Bool = %self.gt(F128.from_bits(0x400D0008000000000000000000000000))   ; 16386
        %under: Bool = %self.lt(F128.from_bits(0xC00D0300000000000000000000000000))   ; -16576
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        %infinity: Self = Self.INFINITY
        %plus_zero: Self = Self.from_bits(0)
        select:
            %nan -> return(%quiet)
            %over -> return(%infinity)
            %under -> return(%plus_zero)
            _ -> compute()

    block compute():
        %r: Self = f128_cm_exp2(%self)
        return(%r)

; 10^x, a CORE-MATH port (f128_core/exp10.tess); exact for integer powers
routine F128.exp10(%self: Self) -> Self
    block entry():
        %nan:   Bool = %self.is_nan()
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        branch %nan ? return(%quiet) : compute()

    block compute():
        %r: Self = f128_cm_exp10(%self)
        return(%r)

routine F128.ln_1p(%self: Self) -> Self
    block entry():
        %nan:    Bool = %self.is_nan()
        %zero:   Bool = f128_is_zero_bits(%self.bits)
        %minus_one: Self = Self.from_bits(0xBFFF0000000000000000000000000000)
        %pole:   Bool = %self.eq(%minus_one)
        %below:  Bool = %self.lt(%minus_one)
        %inf:    Bool = %self.eq(Self.INFINITY)
        %quiet:  Self = Self.from_bits(f128_quiet(%self.bits))
        %invalid: Self = Self.NAN
        %minus_inf: Self = Self.NEG_INFINITY
        select:
            %nan -> return(%quiet)
            %zero -> return(%self)
            %pole -> return(%minus_inf)
            %below -> return(%invalid)
            %inf -> return(%self)
            _ -> compute()

    block compute():
        %r: Self = wide_ln_1p(wide_from_f128(%self)).to_f128()
        return(%r)

; ln x scaled by a constant (1/ln 2, 1/ln 10) before the single rounding.
routine f128_log_scaled(%x: F128, %scale: I64) -> F128
    block entry():
        %scaled: F128 = %x.ln()
        %finite: Bool = %scaled.is_finite().bitand(%x.is_nan().bitnot())
        %zero:   Bool = f128_is_zero_bits(%scaled.bits)
        %special: Bool = %finite.bitnot().bitor(%zero)
        branch %special ? return(%scaled) : compute()

    block compute():
        %r: F128 = wide_log(wide_from_f128(%x)).mul(wide_const(%scale)).to_f128()
        return(%r)

routine F128.log2(%self: Self) -> Self
    block entry():
        %r: Self = f128_log_scaled(%self, 1)
        return(%r)

routine F128.log10(%self: Self) -> Self
    block entry():
        %r: Self = f128_log_scaled(%self, 3)
        return(%r)

; log of self to the given base: ln self / ln base
routine F128.log(%self: Self, %base: Self) -> Self
    block entry():
        %num: Self = %self.ln()
        %den: Self = %base.ln()
        %plain: Bool = %num.is_finite().bitand(%den.is_finite()).bitand(f128_is_zero_bits(%num.bits).bitnot())
        %div0:  Bool = f128_is_zero_bits(%den.bits)
        %naive: Self = %num.div(%den)
        branch %plain ? exact(%div0, %naive) : return(%naive)

    block exact(%div0: Bool, %naive: Self):
        branch %div0 ? return(%naive) : compute()

    block compute():
        %r: Self = wide_log(wide_from_f128(%self)).div(wide_log(wide_from_f128(%base))).to_f128()
        return(%r)

; -- powers and roots ----------------------------------------------------------

; Is x an integer, and if so an odd one? (|x| >= 2^113 is always even.)
routine f128_is_integer(%x: F128) -> Bool
    block entry():
        %r: Bool = %x.trunc().eq(%x).bitand(%x.is_finite())
        return(%r)

routine f128_is_odd_integer(%x: F128) -> Bool
    block entry():
        %int:  Bool = f128_is_integer(%x)
        %big:  Bool = %x.abs().ge(F128.from_bits(0x40700000000000000000000000000000))   ; 2^113
        %odd:  Bool = %x.to_i128().bitand(1).eq(1)
        %r:    Bool = %int.bitand(%big.bitnot()).bitand(%odd)
        return(%r)

; x^y with the special cases of IEEE 754 / C99 Annex F.
routine F128.powf(%self: Self, %y: Self) -> Self
    block entry():
        %x: Self = %self
        %one: Self = Self.from_bits(0x3FFF0000000000000000000000000000)
        %y_zero: Bool = f128_is_zero_bits(%y.bits)
        %x_one:  Bool = %x.eq(%one)
        %nan:    Bool = %x.is_nan().bitor(%y.is_nan())
        %quiet:  Self = Self.NAN
        select:
            %y_zero -> return(%one)
            %x_one -> return(%one)
            %nan -> return(%quiet)
            _ -> cases(%x)

    block cases(%x: Self):
        %one:     Self = Self.from_bits(0x3FFF0000000000000000000000000000)
        %x_zero:  Bool = f128_is_zero_bits(%x.bits)
        %x_inf:   Bool = %x.is_infinite()
        %y_inf:   Bool = %y.is_infinite()
        %y_neg:   Bool = %y.bits.slt(0)
        %odd:     Bool = f128_is_odd_integer(%y)
        %int:     Bool = f128_is_integer(%y)
        %x_neg:   Bool = %x.bits.slt(0)
        %big_x:   Bool = %x.abs().gt(%one)
        %minus_one: Bool = %x.eq(%one.neg())
        %zero:    Self = Self.from_bits(0)
        %infinity: Self = Self.INFINITY
        ; x = ±0: a pole for y < 0, zero for y > 0; odd integers keep x's sign
        %at_zero:  Self = %y_neg ? %infinity : %zero
        %zero_r:   Self = %odd ? %at_zero.copysign(%x) : %at_zero
        ; y = ±inf: |x| > 1 grows for +inf, |x| < 1 grows for -inf
        %grows:    Bool = %big_x.bitxor(%y_neg)
        %growth:   Self = %grows ? %infinity : %zero
        %inf_r:    Self = %minus_one ? %one : %growth
        ; x = ±inf: like 1/0 for y < 0; odd integers keep x's sign
        %x_inf_r0: Self = %y_neg ? %zero : %infinity
        %x_inf_r:  Self = %odd ? %x_inf_r0.copysign(%x) : %x_inf_r0
        %bad:      Bool = %x_neg.bitand(%int.bitnot())
        %invalid:  Self = Self.NAN
        select:
            %x_zero -> return(%zero_r)
            %y_inf -> return(%inf_r)
            %x_inf -> return(%x_inf_r)
            %bad -> return(%invalid)
            _ -> general(%x, %odd)

    ; e^(y ln|x|), negated for a negative x and an odd integer y
    block general(%x: Self, %odd: Bool):
        %z:     Wide = wide_from_f128(%y).mul(wide_log(wide_from_f128(%x.abs())))
        %z_f:   Self = %z.to_f128()
        %over:  Bool = %z_f.gt(F128.from_bits(0x400C6300000000000000000000000000))
        %under: Bool = %z_f.lt(F128.from_bits(0xC00C6700000000000000000000000000))
        %flip:  Bool = %odd.bitand(%x.bits.slt(0))
        %r_inf: Self = Self.INFINITY
        %r_zero: Self = Self.from_bits(0)
        select:
            %over -> signed(%r_inf, %flip)
            %under -> signed(%r_zero, %flip)
            _ -> finite(%z, %flip)

    block finite(%z: Wide, %flip: Bool):
        %r: Self = wide_exp(%z).to_f128()
        jump signed(%r, %flip)

    block signed(%r: Self, %flip: Bool):
        %s: Self = %flip ? %r.neg() : %r
        return(%s)

routine F128.powi(%self: Self, %n: I32) -> Self
    block entry():
        %r: Self = %self.powf(%n.to_f128())
        return(%r)

; cube root, a CORE-MATH port (f128_core/cbrt.tess)
routine F128.cbrt(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %quiet: Self = Self.from_bits(f128_quiet(%self.bits))
        branch %nan ? return(%quiet) : compute()

    block compute():
        %r: Self = f128_cm_cbrt(%self)
        return(%r)

; sqrt(x² + y²) without overflow or underflow; inf if either is infinite.
routine F128.hypot(%self: Self, %other: Self) -> Self
    block entry():
        %inf: Bool = %self.is_infinite().bitor(%other.is_infinite())
        %nan: Bool = %self.is_nan().bitor(%other.is_nan())
        %infinity: Self = Self.INFINITY
        %quiet: Self = Self.NAN
        select:
            %inf -> return(%infinity)
            %nan -> return(%quiet)
            _ -> compute()

    block compute():
        %r: Self = f128_cm_hypot(%self, %other)
        return(%r)

; -- angles --------------------------------------------------------------------

routine f128_scale_angle(%x: F128, %which: I64) -> F128
    block entry():
        %keep: Bool = f128_is_zero_bits(%x.bits).bitor(%x.is_finite().bitnot())
        branch %keep ? return(%x) : compute()

    block compute():
        %r: F128 = wide_from_f128(%x).mul(wide_const(%which)).to_f128()
        return(%r)

routine F128.to_degrees(%self: Self) -> Self
    block entry():
        %r: Self = f128_scale_angle(%self, 4)
        return(%r)

routine F128.to_radians(%self: Self) -> Self
    block entry():
        %r: Self = f128_scale_angle(%self, 5)
        return(%r)

; 1/sqrt(pi), ln(2 pi), ln(pi), pi
