/// ln x for finite x > 0: x = fr × 2^e with fr in [sqrt(1/2), sqrt(2)); then
/// ln fr = 2 atanh(t) = 2 (t + t^3/3 + t^5/5 + …) with t = (fr - 1) / (fr + 1),
/// |t| <= 0.172, 26 terms (the first dropped one is below 2^-135).
routine wide_log(%x: F128Extended) -> F128Extended
    block entry():
        %sqrt_half : F128Extended = wide_const(2)
        %fr0       : F128Extended = %x.ldexp(0.sub(%x.exponent))  // in [1, 2)
        %low       : Bool         = %fr0.hi.lt(%sqrt_half.ldexp(1).hi)  // below sqrt(2)?
        %fr        : F128Extended = %low
            ? %fr0
            : %fr0.ldexp(-1)
        %e : S64 = %low
            ? %x.exponent
            : %x.exponent.add(1)
        %one  : F128Extended = wide_from_i64(1)
        %t    : F128Extended = %fr.sub(%one).div(%fr.add(%one))
        %tt   : F128Extended = %t.mul(%t)
        %last : F128Extended = wide_table(WIDE_LOG_COEF_HI.to<@U128>(), WIDE_LOG_COEF_LO.to<@U64>(),
                WIDE_LOG_COEF_EXP.to<@S64>(), 25)
        jump horner(24, %last, %tt, %t, %e)

    block horner(%i: S64, %s: F128Extended, %tt: F128Extended, %t: F128Extended, %e: S64):
        %done : Bool = %i.lt(0)
        branch %done
            ? finish(%s, %t, %e)
            : step(%i, %s, %tt, %t, %e)

    block step(%i: S64, %s: F128Extended, %tt: F128Extended, %t: F128Extended, %e: S64):
        %c : F128Extended = wide_table(WIDE_LOG_COEF_HI.to<@U128>(), WIDE_LOG_COEF_LO.to<@U64>(),
                WIDE_LOG_COEF_EXP.to<@S64>(), %i.to<USize>())
        jump horner(%i.sub(1), %s.mul(%tt).add(%c), %tt, %t, %e)

    block finish(%s: F128Extended, %t: F128Extended, %e: S64):
        %ln_fr : F128Extended = %s.mul(%t).ldexp(1)
        %r     : F128Extended = wide_from_i64(%e).mul(wide_const(0)).add(%ln_fr)
        return(%r)

// -- argument reduction (Payne-Hanek) ------------------------------------------

/// x = k × π/2 + θ with k taken mod 4 and |θ| <= π/4.
record Reduced
    quadrant : U64
    theta    : F128Extended

/// 64 bits of the little-endian limbs at %p starting at bit %pos (pos >= 0).
routine limbs_bits64(%p: @U64, %pos: S64) -> U64
    block entry():
        %i       : USize = %pos.shr(6).to<USize>()
        %off     : S64   = %pos.bitand(63)
        %low     : U64   = %p.stride(%i).load()
        %aligned : Bool  = %off.eq(0)
        branch %aligned
            ? return(%low)
            : continue
        %j    : USize = %i.add(1)
        %high : U64   = %p.stride(%j).load()
        %r    : U64   = %low.shr(%off.to<U64>()).bitor(%high.shl(64.sub(%off).to<U64>()))
        return(%r)

/// Reduces |x| (finite, nonzero). With x = m × 2^(e - 112), x × 2/π keeps only
/// the bits of 2/π that land below 4: a 512-bit window W of them, so x × 2/π
/// mod 4 = m × W × 2^-sh. The product's bits above sh give the quadrant and the
/// ones below it the fraction f. The window is good to about 2^-330, but f keeps
/// only the 256 bits under sh, so θ is good to about 2^-256 absolute: relative
/// 2^-133 at worst, where x sits closest to a multiple of π/2 (|θ| = 2^-123.3),
/// which is why tan sends |θ| < 2^-90 to its exact tier (f128_tan.tess).
routine f128_reduce(%x: F128) -> Reduced
    block entry():
        %p     : F128Parts = f128_unpack(%x.bits())
        %small : Bool      = %p.exponent.lt(-1)  // |x| < 0.5 < π/4
        branch %small
            ? near_zero()
            : window(%p)

    block near_zero():
        %r : Reduced = Reduced { quadrant: 0, theta: wide_from_f128(%x.abs()) }
        return(%r)

    block window(%p: F128Parts):
        %start : S64 = %p.exponent.sub(114).max(0).div(64)  // first 2/π limb used
        %sh    : S64 = %start.add(8).mul(64).sub(%p.exponent).add(112)
        claim %prod : @Array<S64, 12> <- uninit
        %limbs : @U64 = %prod.to<@U64>()
        %limbs.zeroinit(12)
        %m0 : U128 = %p.sig.bitand(0xFFFFFFFFFFFFFFFF)
        %m1 : U128 = %p.sig.shr(64)
        jump multiply(0, %start, %sh, %m0, %m1, %limbs)

    // limb k of W (little-endian) is TWO_OVER_PI[start + 7 - k]; add m × w_k at limb k
    block multiply(%k: USize, %start: S64, %sh: S64, %m0: U128, %m1: U128, %limbs: @U64):
        %done : Bool = %k.ge(8)
        branch %done
            ? extract(%sh, %limbs)
            : term(%k, %start.to<USize>(), %sh, %m0, %m1, %limbs)

    block term(%k: USize, %start: USize, %sh: S64, %m0: U128, %m1: U128, %limbs: @U64):
        %index : USize = %start.add(7).sub(%k)
        %w     : U64   = TWO_OVER_PI.get(%index)
        %wide  : U128  = %w.to<U128>()
        %lo_p  : U128  = %m0.mul_wrap(%wide)
        %hi_p  : U128  = %m1.mul_wrap(%wide)
        %k1    : USize = %k.add(1)
        %k2    : USize = %k.add(2)
        %r0    : U64   = %limbs.stride(%k).load()
        %r1    : U64   = %limbs.stride(%k1).load()
        %r2    : U64   = %limbs.stride(%k2).load()
        // limb k gets lo_p's low half; limb k+1 lo_p's high half and hi_p's low; k+2 the rest
        %s0 : U128 = %r0.to<U128>().add(%lo_p.bitand(0xFFFFFFFFFFFFFFFF))
        %s1 : U128 = %r1.to<U128>().add(%lo_p.shr(64)).add(%hi_p.bitand(0xFFFFFFFFFFFFFFFF)).add(%s0.shr(64))
        %s2 : U128 = %r2.to<U128>().add(%hi_p.shr(64)).add(%s1.shr(64))
        %limbs.stride(%k).store(%s0.to_wrap<U64>())
        %limbs.stride(%k1).store(%s1.to_wrap<U64>())
        %limbs.stride(%k2).store(%s2.to<U64>())
        %carry : U64 = %s2.shr(64).to<U64>()
        jump spill(%k.add(3), %carry, %k, %start, %sh, %m0, %m1, %limbs)

    // carry on up the limbs
    block spill(%j: USize, %carry: U64, %k: USize, %start: USize, %sh: S64, %m0: U128, %m1: U128,
            %limbs: @U64):
        %none : Bool = %carry.eq(0).bitor(%j.ge(12))
        branch %none
            ? multiply(%k.add(1), %start.to<S64>(), %sh, %m0, %m1, %limbs)
            : spill_one(%j, %carry, %k, %start, %sh, %m0, %m1, %limbs)

    block spill_one(%j: USize, %carry: U64, %k: USize, %start: USize, %sh: S64, %m0: U128,
            %m1: U128, %limbs: @U64):
        %r : U64  = %limbs.stride(%j).load()
        %s : U128 = %r.to<U128>().add_wrap(%carry.to<U128>())
        %limbs.stride(%j).store(%s.to_wrap<U64>())
        jump spill(%j.add_wrap(1), %s.shr(64).to<U64>(), %k, %start, %sh, %m0, %m1, %limbs)

    // quadrant: bits sh and sh+1; fraction: the 256 bits under sh, normalized
    block extract(%sh: S64, %limbs: @U64):
        %q    : U64  = limbs_bits64(%limbs, %sh).bitand(3)
        %a    : U64  = limbs_bits64(%limbs, %sh.sub(64))
        %b    : U64  = limbs_bits64(%limbs, %sh.sub(128))
        %c    : U64  = limbs_bits64(%limbs, %sh.sub(192))
        %d    : U64  = limbs_bits64(%limbs, %sh.sub(256))
        %x_hi : U128 = %a.to<U128>().shl(64).bitor(%b.to<U128>())
        %x_lo : U128 = %c.to<U128>().shl(64).bitor(%d.to<U128>())
        // f = X × 2^-256 in [0, 1). Past 1/2, count the next quadrant and use
        // f - 1 = -(2^256 - X) × 2^-256, complemented on all 256 bits before
        // normalizing: f can be 1 - 2^-120, and f - 1 taken after cutting f to
        // 192 bits would keep only its last 72.
        %past_half : Bool = %a.shr(63).eq(1)
        %neg_lo    : U128 = 0.sub_wrap(%x_lo)
        %borrow    : U128 = %x_lo.ne(0).to<U128>()
        %neg_hi    : U128 = 0.sub_wrap(%x_hi).sub_wrap(%borrow)
        %use_hi    : U128 = %past_half
            ? %neg_hi
            : %x_hi
        %use_lo : U128 = %past_half
            ? %neg_lo
            : %x_lo
        %magnitude : F128Extended = wide_from_256(%use_hi, %use_lo)
        %g         : F128Extended = %past_half
            ? %magnitude.neg()
            : %magnitude
        %k : U64 = %past_half
            ? %q.add_wrap(1).bitand(3)
            : %q
        %theta : F128Extended = %g.mul(wide_table(WIDE_HALF_PI_HI.to<@U128>(),
                WIDE_HALF_PI_LO.to<@U64>(), WIDE_HALF_PI_EXP.to<@S64>(), 0))
        %r     : Reduced      = Reduced { quadrant: %k, theta: %theta }
        return(%r)

/// (hi × 2^128 + lo) × 2^-256 as a F128Extended, keeping its top 192 bits.
routine wide_from_256(%hi: U128, %lo: U128) -> F128Extended
    block entry():
        jump shift(%hi, %lo, -1)

    block shift(%hi: U128, %lo: U128, %exponent: S64):
        %empty   : Bool         = %hi.eq(0)
        %all     : Bool         = %empty.bitand(%lo.eq(0))
        %nothing : F128Extended = wide_zero()
        when:
            %all   -> return(%nothing)
            %empty -> shift(%lo, 0, %exponent.sub_wrap(128))
            else   -> bits(%hi, %lo, %exponent)

    block bits(%hi: U128, %lo: U128, %exponent: S64):
        %s     : S64  = %hi.leading_zeros().to<S64>()
        %some  : Bool = %s.gt(0)
        %carry : U128 = %some
            ? %lo.shr(128.sub(%s).to<U128>())
            : 0
        %new_hi : U128         = %hi.shl(%s.to<U128>()).bitor(%carry)
        %new_lo : U128         = %lo.shl(%s.to<U128>())
        %w      : F128Extended = F128Extended { negative: false, exponent: %exponent.sub(%s),
                hi: %new_hi, lo: %new_lo.shr(64).to<U64>() }
        return(%w)

// -- sin, cos, tan -------------------------------------------------------------

choice TrigKind: U8
    Sin
    Cos
    Tan

/// sin θ = θ Σ (-θ²)^k / (2k+1)!  and  cos θ = Σ (-θ²)^k / (2k)!, 18 terms each,
/// for |θ| <= π/4 (the first dropped term is below 2^-139).
routine wide_sin_core(%t: F128Extended) -> F128Extended
    block entry():
        %u    : F128Extended = %t.mul(%t).neg()
        %last : F128Extended = wide_table(WIDE_SIN_COEF_HI.to<@U128>(), WIDE_SIN_COEF_LO.to<@U64>(),
                WIDE_SIN_COEF_EXP.to<@S64>(), 17)
        jump horner(16, %last, %u, %t)

    block horner(%i: S64, %s: F128Extended, %u: F128Extended, %t: F128Extended):
        %done : Bool         = %i.lt(0)
        %r    : F128Extended = %s.mul(%t)
        branch %done
            ? return(%r)
            : continue
        %c : F128Extended = wide_table(WIDE_SIN_COEF_HI.to<@U128>(), WIDE_SIN_COEF_LO.to<@U64>(),
                WIDE_SIN_COEF_EXP.to<@S64>(), %i.to<USize>())
        jump horner(%i.sub(1), %s.mul(%u).add(%c), %u, %t)

routine wide_cos_core(%t: F128Extended) -> F128Extended
    block entry():
        %u    : F128Extended = %t.mul(%t).neg()
        %last : F128Extended = wide_table(WIDE_COS_COEF_HI.to<@U128>(), WIDE_COS_COEF_LO.to<@U64>(),
                WIDE_COS_COEF_EXP.to<@S64>(), 17)
        jump horner(16, %last, %u)

    block horner(%i: S64, %s: F128Extended, %u: F128Extended):
        %done : Bool = %i.lt(0)
        branch %done
            ? return(%s)
            : continue
        %c : F128Extended = wide_table(WIDE_COS_COEF_HI.to<@U128>(), WIDE_COS_COEF_LO.to<@U64>(),
                WIDE_COS_COEF_EXP.to<@S64>(), %i.to<USize>())
        jump horner(%i.sub(1), %s.mul(%u).add(%c), %u)

/// sin and cos of NaN (a quiet NaN) and of the infinities (NaN).
routine f128_trig_nonfinite(%x: F128) -> F128
    block entry():
        %is_nan : Bool = %x.is_nan()
        %quiet  : F128 = f128_of(f128_quiet(%x.bits()))
        %r      : F128 = %is_nan
            ? %quiet
            : F128.NAN
        return(%r)

// -- more F128Extended -----------------------------------------------------------------

routine F128Extended.abs(%self: Self) -> Self
    block entry():
        %r : Self = Self { negative: false, exponent: %self.exponent, hi: %self.hi, lo: %self.lo }
        return(%r)

/// sqrt for self > 0: Newton's method on 1/sqrt, y ← y (3 - a y²) / 2, from an
/// F64 seed (53 bits → 106 → 212), then × a.
routine F128Extended.sqrt(%self: Self) -> Self
    block entry():
        %zero : Bool = %self.is_zero()
        branch %zero
            ? return(%self)
            : continue
        %half_e : S64  = %self.exponent.shr(1)  // floor(e / 2)
        %unit   : Self = %self.ldexp(0.sub(%half_e).mul(2))  // in [1, 4)
        %seed64 : F64  = %unit.to<F128>().to<F64>().sqrt()
        %one64  : F64  = 1.0
        %y0     : Self = wide_from_f128(%one64.div(%seed64).to<F128>())
        %three  : Self = wide_from_i64(3)
        %y1     : Self = %y0.mul(%three.sub(%unit.mul(%y0).mul(%y0))).ldexp(-1)
        %y2     : Self = %y1.mul(%three.sub(%unit.mul(%y1).mul(%y1))).ldexp(-1)
        %r      : Self = %unit.mul(%y2).ldexp(%half_e)
        return(%r)

/// |self| > 1?
routine F128Extended.above_one(%self: Self) -> Bool
    block entry():
        %big   : Bool = %self.exponent.gt(0)
        %one_e : Bool = %self.exponent.eq(0)
        %more  : Bool = %self.hi.ne(F128_SIGN).bitor(%self.lo.ne(0))
        %zero  : Bool = %self.is_zero()
        %r     : Bool = %big.bitor(%one_e.bitand(%more)).bitand(%zero.bitnot())
        return(%r)

routine wide_one() -> F128Extended
    block entry():
        %r : F128Extended = wide_from_i64(1)
        return(%r)

routine wide_half_pi() -> F128Extended
    block entry():
        %r : F128Extended = wide_table(WIDE_HALF_PI_HI.to<@U128>(), WIDE_HALF_PI_LO.to<@U64>(),
                WIDE_HALF_PI_EXP.to<@S64>(), 0)
        return(%r)

// -- exp_m1, ln_1p ---------------------------------------------------------------

/// e^x - 1 without cancellation: below |x| = 1/2 the series x Σ x^j / (j+1)!
/// (35 terms, the first dropped one under 2^-150 relative), else e^x - 1.
routine wide_exp_m1(%x: F128Extended) -> F128Extended
    block entry():
        %small : Bool = %x.exponent.lt(-1)
        branch %small
            ? series(%x)
            : direct(%x)

    block direct(%x: F128Extended):
        %r : F128Extended = wide_exp(%x).sub(wide_one())
        return(%r)

    block series(%x: F128Extended):
        %last : F128Extended = wide_table(WIDE_EXP_COEF_HI.to<@U128>(), WIDE_EXP_COEF_LO.to<@U64>(),
                WIDE_EXP_COEF_EXP.to<@S64>(), 35)
        jump horner(34, %last, %x)

    block horner(%i: USize, %s: F128Extended, %x: F128Extended):
        %done : Bool         = %i.lt(1)
        %r    : F128Extended = %s.mul(%x)
        branch %done
            ? return(%r)
            : continue
        %c : F128Extended = wide_table(WIDE_EXP_COEF_HI.to<@U128>(), WIDE_EXP_COEF_LO.to<@U64>(),
                WIDE_EXP_COEF_EXP.to<@S64>(), %i)
        jump horner(%i.sub(1), %s.mul(%x).add(%c), %x)

/// ln(1 + x) for x > -1: below |x| = 1/4, 2 atanh(t) with t = x / (2 + x)
/// (|t| < 0.143, inside the log series' reach); else ln of 1 + x, which is exact.
routine wide_ln_1p(%x: F128Extended) -> F128Extended
    block entry():
        %small : Bool = %x.exponent.lt(-2)
        branch %small
            ? series(%x)
            : direct(%x)

    block direct(%x: F128Extended):
        %r : F128Extended = wide_log(%x.add(wide_one()))
        return(%r)

    block series(%x: F128Extended):
        %t    : F128Extended = %x.div(%x.add(wide_from_i64(2)))
        %tt   : F128Extended = %t.mul(%t)
        %last : F128Extended = wide_table(WIDE_LOG_COEF_HI.to<@U128>(), WIDE_LOG_COEF_LO.to<@U64>(),
                WIDE_LOG_COEF_EXP.to<@S64>(), 25)
        jump horner(24, %last, %tt, %t)

    block horner(%i: S64, %s: F128Extended, %tt: F128Extended, %t: F128Extended):
        %done : Bool         = %i.lt(0)
        %r    : F128Extended = %s.mul(%t).ldexp(1)
        branch %done
            ? return(%r)
            : continue
        %c : F128Extended = wide_table(WIDE_LOG_COEF_HI.to<@U128>(), WIDE_LOG_COEF_LO.to<@U64>(),
                WIDE_LOG_COEF_EXP.to<@S64>(), %i.to<USize>())
        jump horner(%i.sub(1), %s.mul(%tt).add(%c), %tt, %t)

// -- atan ----------------------------------------------------------------------

/// atan x = x Σ (-x²)^k / (2k+1), 26 terms, for |x| < 0.1.
routine wide_atan_series(%x: F128Extended) -> F128Extended
    block entry():
        %u    : F128Extended = %x.mul(%x).neg()
        %last : F128Extended = wide_table(WIDE_LOG_COEF_HI.to<@U128>(), WIDE_LOG_COEF_LO.to<@U64>(),
                WIDE_LOG_COEF_EXP.to<@S64>(), 25)
        jump horner(24, %last, %u, %x)

    block horner(%i: S64, %s: F128Extended, %u: F128Extended, %x: F128Extended):
        %done : Bool         = %i.lt(0)
        %r    : F128Extended = %s.mul(%x)
        branch %done
            ? return(%r)
            : continue
        %c : F128Extended = wide_table(WIDE_LOG_COEF_HI.to<@U128>(), WIDE_LOG_COEF_LO.to<@U64>(),
                WIDE_LOG_COEF_EXP.to<@S64>(), %i.to<USize>())
        jump horner(%i.sub_wrap(1), %s.mul(%u).add(%c), %u, %x)

/// atan x for any finite x: past |x| = 1, π/2 - atan(1/|x|); then three
/// half-angle steps x ← x / (1 + sqrt(1 + x²)) bring |x| <= 1 under 0.1.
routine wide_atan(%x: F128Extended) -> F128Extended
    block entry():
        %a     : F128Extended = %x.abs()
        %big   : Bool         = %a.above_one()
        %inv   : F128Extended = wide_one().div(%a)
        %small : F128Extended = %big
            ? %inv
            : %a
        jump halve(0, %small, %big)

    block halve(%n: S64, %t: F128Extended, %big: Bool):
        %done : Bool = %n.ge(3)
        branch %done
            ? finish(%t, %big)
            : step(%n, %t, %big)

    block step(%n: S64, %t: F128Extended, %big: Bool):
        %one  : F128Extended = wide_one()
        %next : F128Extended = %t.div(%one.add(%one.add(%t.mul(%t)).sqrt()))
        jump halve(%n.add_wrap(1), %next, %big)

    block finish(%t: F128Extended, %big: Bool):
        %r0 : F128Extended = wide_atan_series(%t).ldexp(3)
        %r1 : F128Extended = %big
            ? wide_half_pi().sub(%r0)
            : %r0
        %r : F128Extended = %x.negative
            ? %r1.neg()
            : %r1
        return(%r)

// -- F128 methods --------------------------------------------------------------

// sinh, cosh, and tanh, correctly rounded, are in f128_hyperbolic.tess.

// -- exponentials and logarithms -----------------------------------------------

/// log of self to the given base: ln self / ln base
routine F128.log(%self: Self, %base: Self) -> Self
    block entry():
        %num   : Self = %self.ln()
        %den   : Self = %base.ln()
        %plain : Bool = %num.is_finite().bitand(%den.is_finite()).bitand(f128_is_zero_bits(%num.bits()).bitnot())
        %div0  : Bool = f128_is_zero_bits(%den.bits())
        %naive : Self = %num.div(%den)
        branch %plain
            ? continue
            : return(%naive)
        branch %div0
            ? return(%naive)
            : continue
        %r : Self = wide_log(wide_from_f128(%self)).div(wide_log(wide_from_f128(%base))).to<Self>()
        return(%r)

// -- powers and roots ----------------------------------------------------------

/// Is x an integer, and if so an odd one? (|x| >= 2^113 is always even.)
routine f128_is_integer(%x: F128) -> Bool
    block entry():
        %r : Bool = %x.trunc().eq(%x).bitand(%x.is_finite())
        return(%r)

routine f128_is_odd_integer(%x: F128) -> Bool
    block entry():
        %int : Bool = f128_is_integer(%x)
        %big : Bool = %x.abs().ge(f128_of(0x40700000000000000000000000000000))  // 2^113
        %odd : Bool = %x.to_clamp<S128>().bitand(1).eq(1)
        %r   : Bool = %int.bitand(%big.bitnot()).bitand(%odd)
        return(%r)

// -- angles --------------------------------------------------------------------

/// 1/sqrt(pi), ln(2 pi), ln(pi), pi
preset WIDE_SPECIAL_CONST_HI: @Array<U128, 4> <- { 0x906EBA8214DB688D71D48A7F6BFEC344,
        0xEB3F8E4325F5A53494BC900144192023, 0x928682473D0DE85EAFCAB635421FA4CC,
        0xC90FDAA22168C234C4C6628B80DC1CD1 }

preset WIDE_SPECIAL_CONST_LO: @Array<U64, 4> <- { 1443862089616487703, 0xCFB08F8D13458B4E,
        3402168225884614711, 2955010104097229940 }

preset WIDE_SPECIAL_CONST_EXP: @Array<S64, 4> <- { -1, 0, 0, 1 }

routine f128_scale_angle(%x: F128, %which: USize) -> F128
    block entry():
        %keep : Bool = f128_is_zero_bits(%x.bits()).bitor(%x.is_finite().bitnot())
        branch %keep
            ? return(%x)
            : continue
        %r : F128 = wide_from_f128(%x).mul(wide_const(%which)).to<F128>()
        return(%r)

routine F128.to_degrees(%self: Self) -> Self
    block entry():
        %r : Self = f128_scale_angle(%self, 4)
        return(%r)

routine F128.to_radians(%self: Self) -> Self
    block entry():
        %r : Self = f128_scale_angle(%self, 5)
        return(%r)

// -- constants of erf and gamma -------------------------------------------------

routine wide_special(%i: USize) -> F128Extended
    block entry():
        %w : F128Extended = wide_table(WIDE_SPECIAL_CONST_HI.to<@U128>(),
                WIDE_SPECIAL_CONST_LO.to<@U64>(), WIDE_SPECIAL_CONST_EXP.to<@S64>(), %i)
        return(%w)
