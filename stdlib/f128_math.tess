// -- F128Extended ----------------------------------------------------------------------

routine wide_zero() -> F128Extended
    block entry():
        %w: F128Extended = F128Extended { negative: false, exp: 0, hi: 0, lo: 0 }
        return(%w)

routine F128Extended.is_zero(%self: Self) -> Bool
    block entry():
        %r: Bool = %self.hi.eq(0).bitand(%self.lo.eq(0))
        return(%r)

routine F128Extended.neg(%self: Self) -> Self
    block entry():
        %r: Self = Self { negative: %self.negative.bitnot(), exp: %self.exp, hi: %self.hi, lo: %self.lo }
        return(%r)

routine F128Extended.ldexp(%self: Self, %k: S64) -> Self
    block entry():
        %r: Self = Self { negative: %self.negative, exp: %self.exp.add(%k), hi: %self.hi, lo: %self.lo }
        return(%r)

/// Entry %i of one of the constant tables.
routine wide_table(#hi: Ptr<U128>, #lo: Ptr<U64>, #exp: Ptr<S64>, %i: U64) -> F128Extended
    block entry():
        %h: U128 = #hi[%i].load()
        %l: U64  = #lo[%i].load()
        %e: S64  = #exp[%i].load()
        %w: F128Extended = F128Extended { negative: false, exp: %e, hi: %h, lo: %l }
        return(%w)

routine wide_const(%i: U64) -> F128Extended
    block entry():
        %w: F128Extended = wide_table(WIDE_CONST_HI.to_ptr(), WIDE_CONST_LO.to_ptr(), WIDE_CONST_EXP.to_ptr(), %i)
        return(%w)

/// Shifts the mantissa up until bit 191 is set.
routine wide_normalize(%negative: Bool, %exp: S64, %hi: U128, %lo: U64) -> F128Extended
    block entry():
        %zero: Bool = %hi.eq(0).bitand(%lo.eq(0))
        %nothing: F128Extended = wide_zero()
        branch %zero ? return(%nothing) : count(%exp, %hi, %lo)

    // a whole empty top limb moves in 64 bits at a time
    block count(%exp: S64, %hi: U128, %lo: U64):
        %empty: Bool = %hi.shr(64).eq(0)
        branch %empty ? limb(%exp, %hi, %lo) : bits(%exp, %hi, %lo)

    block limb(%exp: S64, %hi: U128, %lo: U64):
        %new_hi: U128 = %hi.shl(64).bitor(%lo.to_u128())
        jump count(%exp.sub(64), %new_hi, 0)

    block bits(%exp: S64, %hi: U128, %lo: U64):
        %s:      S64  = %hi.leading_zeros().to_s64()
        %some:   Bool = %s.gt(0)
        %carry:  U128 = %some ? %lo.to_u128().shr(64.sub(%s).to_u128()) : 0
        %new_hi: U128 = %hi.shl(%s.to_u128()).bitor(%carry)
        %new_lo: U64  = %lo.shl(%s.to_u64())
        %w: F128Extended = F128Extended { negative: %negative, exp: %exp.sub(%s), hi: %new_hi, lo: %new_lo }
        return(%w)

routine wide_from_f128(%x: F128) -> F128Extended
    block entry():
        %zero: Bool = f128_is_zero_bits(%x.bits)
        %nothing: F128Extended = wide_zero()
        branch %zero ? return(%nothing) : finite()

    block finite():
        %p: F128Parts = f128_unpack(%x.bits)
        %w: F128Extended = F128Extended { negative: f128_is_negative_bits(%x.bits), exp: %p.exp, hi: %p.sig.shl(15), lo: 0 }
        return(%w)

routine wide_from_i64(%n: S64) -> F128Extended
    block entry():
        %w: F128Extended = wide_from_f128(%n.to_f128())
        return(%w)

/// Rounds once to F128 (overflow, subnormals, and underflow included).
routine F128Extended.to_f128(%self: Self) -> F128
    block entry():
        %zero: Bool = %self.is_zero()
        %plus_zero: F128 = f128_of(0)
        branch %zero ? return(%plus_zero) : round()

    // value ~ hi × 2^(exp - 127): f128_round_pack wants sig × 2^(biased - 16383 - 115)
    block round():
        %sticky: U128 = %self.lo.ne(0).to_u128()
        %sig:    U128 = %self.hi.bitor(%sticky)
        %bits:   U128 = f128_round_pack(%self.negative, %self.exp.add(16371), %sig)
        %r:      F128 = f128_of(%bits)
        return(%r)

/// mantissa >> n (bits shifted out are dropped)
routine wide_shift_right(%hi: U128, %lo: U64, %n: S64) -> F128Extended
    block entry():
        %none:  Bool = %n.eq(0)
        %small: Bool = %n.lt(64)
        %mid:   Bool = %n.lt(192)
        select:
            %none -> done(%hi, %lo)
            %small -> small()
            %mid -> big()
            _ -> done(0, 0)

    block small():
        %new_lo: U64  = %lo.shr(%n.to_u64()).bitor(%hi.to_u64_wrap().shl(64.sub(%n).to_u64()))
        %new_hi: U128 = %hi.shr(%n.to_u128())
        jump done(%new_hi, %new_lo)

    // 64 <= n < 192: lo comes from hi, and hi keeps what's left above bit 128 + n - 64
    block big():
        %new_lo: U64  = %hi.shr(%n.sub(64).to_u128()).to_u64_wrap()
        %new_hi: U128 = %n.ge(128) ? 0 : %hi.shr(%n.min(127).to_u128())
        jump done(%new_hi, %new_lo)

    block done(%h: U128, %l: U64):
        %w: F128Extended = F128Extended { negative: false, exp: 0, hi: %h, lo: %l }
        return(%w)

routine F128Extended.add(%self: Self, %other: Self) -> Self
    block entry():
        %a_zero: Bool = %self.is_zero()
        %b_zero: Bool = %other.is_zero()
        select:
            %a_zero -> return(%other)
            %b_zero -> return(%self)
            _ -> order()

    // big has the larger magnitude: larger exponent, or the same and a larger mantissa
    block order():
        %a_hi_more: Bool = %self.hi.gt(%other.hi).bitor(%self.hi.eq(%other.hi).bitand(%self.lo.ge(%other.lo)))
        %a_first:   Bool = %self.exp.gt(%other.exp).bitor(%self.exp.eq(%other.exp).bitand(%a_hi_more))
        %big:   F128Extended = %a_first ? %self : %other
        %small: F128Extended = %a_first ? %other : %self
        %aligned: F128Extended = wide_shift_right(%small.hi, %small.lo, %big.exp.sub(%small.exp))
        %same: Bool = %big.negative.eq(%small.negative)
        branch %same ? sum(%big, %aligned) : difference(%big, %aligned)

    block sum(%big: F128Extended, %s: F128Extended):
        %lo:       U64  = %big.lo.add_wrap(%s.lo)
        %c0:       U128 = %lo.lt(%big.lo).to_u128()
        %hi_part:  U128 = %big.hi.add_wrap(%s.hi)
        %c1:       Bool = %hi_part.lt(%big.hi)
        %hi:       U128 = %hi_part.add_wrap(%c0)
        %c2:       Bool = %hi.lt(%hi_part)
        %carry:    Bool = %c1.bitor(%c2)
        branch %carry ? overflow(%big, %hi, %lo) : done(%big.negative, %big.exp, %hi, %lo)

    // the 193rd bit: shift right once, the carry becoming bit 191
    block overflow(%big: F128Extended, %hi: U128, %lo: U64):
        %new_lo: U64  = %lo.shr(1).bitor(%hi.to_u64_wrap().shl(63))
        %new_hi: U128 = %hi.shr(1).bitor(F128_SIGN)
        jump done(%big.negative, %big.exp.add(1), %new_hi, %new_lo)

    block difference(%big: F128Extended, %s: F128Extended):
        %lo:     U64  = %big.lo.sub_wrap(%s.lo)
        %borrow: U128 = %big.lo.lt(%s.lo).to_u128()
        %hi:     U128 = %big.hi.sub_wrap(%s.hi).sub_wrap(%borrow)
        %r: F128Extended = wide_normalize(%big.negative, %big.exp, %hi, %lo)
        return(%r)

    block done(%negative: Bool, %exp: S64, %hi: U128, %lo: U64):
        %r: F128Extended = F128Extended { negative: %negative, exp: %exp, hi: %hi, lo: %lo }
        return(%r)

routine F128Extended.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = %self.add(%other.neg())
        return(%r)

/// The top 192 bits of the 384-bit product (the rest dropped).
routine F128Extended.mul(%self: Self, %other: Self) -> Self
    block entry():
        %a_zero: Bool = %self.is_zero()
        %b_zero: Bool = %other.is_zero()
        %zero:   Bool = %a_zero.bitor(%b_zero)
        %nothing: F128Extended = wide_zero()
        branch %zero ? return(%nothing) : product()

    block product():
        %a2: U128 = %self.hi.shr(64)
        %a1: U128 = %self.hi.bitand(0xFFFFFFFFFFFFFFFF)
        %a0: U128 = %self.lo.to_u128()
        %b2: U128 = %other.hi.shr(64)
        %b1: U128 = %other.hi.bitand(0xFFFFFFFFFFFFFFFF)
        %b0: U128 = %other.lo.to_u128()
        // columns 1..5 of the schoolbook product; column 0 only feeds carries into 1
        %c0:  U128 = %a0.mul_wrap(%b0).shr(64)
        %t1:  U128 = %a0.mul_wrap(%b1)
        %t1b: U128 = %a1.mul_wrap(%b0)
        %s1:  U128 = %c0.add(%t1.bitand(0xFFFFFFFFFFFFFFFF)).add(%t1b.bitand(0xFFFFFFFFFFFFFFFF))
        %k1:  U128 = %s1.shr(64).add(%t1.shr(64)).add(%t1b.shr(64))
        %t2a: U128 = %a0.mul_wrap(%b2)
        %t2b: U128 = %a1.mul_wrap(%b1)
        %t2c: U128 = %a2.mul_wrap(%b0)
        %s2:  U128 = %k1.add(%t2a.bitand(0xFFFFFFFFFFFFFFFF)).add(%t2b.bitand(0xFFFFFFFFFFFFFFFF)).add(%t2c.bitand(0xFFFFFFFFFFFFFFFF))
        %k2:  U128 = %s2.shr(64).add(%t2a.shr(64)).add(%t2b.shr(64)).add(%t2c.shr(64))
        %t3a: U128 = %a1.mul_wrap(%b2)
        %t3b: U128 = %a2.mul_wrap(%b1)
        %s3:  U128 = %k2.add(%t3a.bitand(0xFFFFFFFFFFFFFFFF)).add(%t3b.bitand(0xFFFFFFFFFFFFFFFF))
        %k3:  U128 = %s3.shr(64).add(%t3a.shr(64)).add(%t3b.shr(64))
        %t4:  U128 = %a2.mul_wrap(%b2)
        %s4:  U128 = %k3.add(%t4.bitand(0xFFFFFFFFFFFFFFFF))
        %k4:  U128 = %s4.shr(64).add(%t4.shr(64))
        // limbs r5 r4 r3 (and r2 for the shift): product = r5..r0 × 2^(64 i)
        %r2: U64 = %s2.to_u64_wrap()
        %r3: U64 = %s3.to_u64_wrap()
        %r4: U64 = %s4.to_u64_wrap()
        %r5: U64 = %k4.to_s64_wrap().to_u64_wrap()
        %top: Bool = %r5.shr(63).eq(1)                           // bit 383 set
        %hi_full: U128 = %r5.to_u128().shl(64).bitor(%r4.to_u128())
        %hi:  U128 = %top ? %hi_full : %hi_full.shl(1).bitor(%r3.to_u128().shr(63))
        %lo:  U64  = %top ? %r3 : %r3.shl(1).bitor(%r2.shr(63))
        %exp: S64  = %self.exp.add(%other.exp).add(%top.to_s64())
        %negative: Bool = %self.negative.bitxor(%other.negative)
        %r: F128Extended = F128Extended { negative: %negative, exp: %exp, hi: %hi, lo: %lo }
        return(%r)

/// self / other by Newton's method on the reciprocal: y ← y + y(1 - other·y),
/// from an F64 seed (53 bits → 106 → 212).
routine F128Extended.div(%self: Self, %other: Self) -> Self
    block entry():
        %e:     S64  = %other.exp
        %unit:  F128Extended = %other.ldexp(0.sub(%e))                // in [1, 2)
        %seed:  F64  = %unit.to_f128().to_f64()
        %one64: F64  = 1.0
        %y0:    F128Extended = wide_from_f128(%one64.div(%seed).to_f128())
        %one:   F128Extended = wide_from_i64(1)
        %y1:    F128Extended = %y0.add(%y0.mul(%one.sub(%unit.mul(%y0))))
        %y2:    F128Extended = %y1.add(%y1.mul(%one.sub(%unit.mul(%y1))))
        %r:     F128Extended = %self.mul(%y2).ldexp(0.sub(%e))
        return(%r)

/// round to the nearest integer, for |self| < 2^62
routine F128Extended.to_i64_nearest(%self: Self) -> S64
    block entry():
        %r: S64 = %self.to_f128().round_ties_even().to_s64_clamp()
        return(%r)

// -- exp -----------------------------------------------------------------------

/// e^x for finite x with |x| below the overflow range (the caller clamps).
/// x = q ln2 + d with |d| <= ln2/2, e^d by its Taylor series (27th degree; the
/// first dropped term is below 2^-141), then × 2^q.
routine wide_exp(%x: F128Extended) -> F128Extended
    block entry():
        %ln2:     F128Extended = wide_const(0)
        %inv_ln2: F128Extended = wide_const(1)
        %q:       S64  = %x.mul(%inv_ln2).to_i64_nearest()
        %d:       F128Extended = %x.sub(wide_from_i64(%q).mul(%ln2))
        %last:    F128Extended = wide_table(WIDE_EXP_COEF_HI.to_ptr(), WIDE_EXP_COEF_LO.to_ptr(), WIDE_EXP_COEF_EXP.to_ptr(), 27)
        jump horner(26, %last, %d, %q)

    block horner(%i: S64, %s: F128Extended, %d: F128Extended, %q: S64):
        %done:   Bool = %i.lt(0)
        %scaled: F128Extended = %s.ldexp(%q)
        branch %done ? return(%scaled) : step(%i, %s, %d, %q)

    block step(%i: S64, %s: F128Extended, %d: F128Extended, %q: S64):
        %c: F128Extended = wide_table(WIDE_EXP_COEF_HI.to_ptr(), WIDE_EXP_COEF_LO.to_ptr(), WIDE_EXP_COEF_EXP.to_ptr(), %i.to_u64())
        jump horner(%i.sub(1), %s.mul(%d).add(%c), %d, %q)

routine F128.exp(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %bits: S128 = %self.bits.to_s128_wrap()
        %negative: Bool = %bits.lt(0)
        // e^x overflows past x = 11356.52 and is below half the smallest subnormal
        // before x = -11433.4; beyond those the answer needs no series.
        %big: F128 = f128_of(0x400C6300000000000000000000000000)     // 11360
        %small: F128 = f128_of(0xC00C6700000000000000000000000000)   // -11488
        %over:  Bool = %self.gt(%big)
        %under: Bool = %self.lt(%small)
        %quiet:     F128 = f128_of(f128_quiet(%bits.to_u128_wrap()))
        %infinity:  F128 = F128.INFINITY
        %plus_zero: F128 = f128_of(0)
        select:
            %nan -> return(%quiet)
            %over -> return(%infinity)
            %under -> return(%plus_zero)
            _ -> compute()

    block compute():
        %r: F128 = f128_cm_exp(%self)
        return(%r)

// -- log -----------------------------------------------------------------------

/// ln x for finite x > 0: x = fr × 2^e with fr in [sqrt(1/2), sqrt(2)); then
/// ln fr = 2 atanh(t) = 2 (t + t^3/3 + t^5/5 + …) with t = (fr - 1) / (fr + 1),
/// |t| <= 0.172, 26 terms (the first dropped one is below 2^-135).
routine wide_log(%x: F128Extended) -> F128Extended
    block entry():
        %sqrt_half: F128Extended = wide_const(2)
        %fr0:  F128Extended = %x.ldexp(0.sub(%x.exp))                 // in [1, 2)
        %low:  Bool = %fr0.hi.lt(%sqrt_half.ldexp(1).hi)     // below sqrt(2)?
        %fr:   F128Extended = %low ? %fr0 : %fr0.ldexp(-1)
        %e:    S64  = %low ? %x.exp : %x.exp.add(1)
        %one:  F128Extended = wide_from_i64(1)
        %t:    F128Extended = %fr.sub(%one).div(%fr.add(%one))
        %tt:   F128Extended = %t.mul(%t)
        %last: F128Extended = wide_table(WIDE_LOG_COEF_HI.to_ptr(), WIDE_LOG_COEF_LO.to_ptr(), WIDE_LOG_COEF_EXP.to_ptr(), 25)
        jump horner(24, %last, %tt, %t, %e)

    block horner(%i: S64, %s: F128Extended, %tt: F128Extended, %t: F128Extended, %e: S64):
        %done: Bool = %i.lt(0)
        branch %done ? finish(%s, %t, %e) : step(%i, %s, %tt, %t, %e)

    block step(%i: S64, %s: F128Extended, %tt: F128Extended, %t: F128Extended, %e: S64):
        %c: F128Extended = wide_table(WIDE_LOG_COEF_HI.to_ptr(), WIDE_LOG_COEF_LO.to_ptr(), WIDE_LOG_COEF_EXP.to_ptr(), %i.to_u64())
        jump horner(%i.sub(1), %s.mul(%tt).add(%c), %tt, %t, %e)

    block finish(%s: F128Extended, %t: F128Extended, %e: S64):
        %ln_fr: F128Extended = %s.mul(%t).ldexp(1)
        %r:     F128Extended = wide_from_i64(%e).mul(wide_const(0)).add(%ln_fr)
        return(%r)

/// ln x: NaN for x < 0, -inf at ±0, +inf at +inf.
routine F128.ln(%self: Self) -> Self
    block entry():
        %bits:     S128 = %self.bits.to_s128_wrap()
        %nan:      Bool = %self.is_nan()
        %zero:     Bool = f128_is_zero_bits(%bits.to_u128_wrap())
        %negative: Bool = %bits.lt(0)
        %inf:      Bool = %self.is_infinite()
        %quiet:    F128 = f128_of(f128_quiet(%bits.to_u128_wrap()))
        %minus_inf: F128 = F128.NEG_INFINITY
        %invalid:  F128 = F128.NAN
        select:
            %nan -> return(%quiet)
            %zero -> return(%minus_inf)
            %negative -> return(%invalid)
            %inf -> return(%self)
            _ -> compute()

    block compute():
        %r: F128 = f128_cm_log(%self)
        return(%r)

