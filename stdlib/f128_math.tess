; -- Wide ----------------------------------------------------------------------

routine wide_zero() -> Wide
    block entry():
        %w: Wide = Wide { negative: false, exp: 0, hi: 0, lo: 0 }
        return(%w)

routine Wide.is_zero(%self: Self) -> Bool
    block entry():
        %r: Bool = %self.hi.eq(0).bitand(%self.lo.eq(0))
        return(%r)

routine Wide.neg(%self: Self) -> Self
    block entry():
        %r: Self = Self { negative: %self.negative.bitnot(), exp: %self.exp, hi: %self.hi, lo: %self.lo }
        return(%r)

routine Wide.ldexp(%self: Self, %k: I64) -> Self
    block entry():
        %r: Self = Self { negative: %self.negative, exp: %self.exp.add(%k), hi: %self.hi, lo: %self.lo }
        return(%r)

; Entry %i of one of the constant tables.
routine wide_table(#hi: Ptr<I128>, #lo: Ptr<I64>, #exp: Ptr<I64>, %i: I64) -> Wide
    block entry():
        %h: I128 := #hi[%i]
        %l: I64  := #lo[%i]
        %e: I64  := #exp[%i]
        %w: Wide = Wide { negative: false, exp: %e, hi: %h, lo: %l }
        return(%w)

routine wide_const(%i: I64) -> Wide
    block entry():
        %w: Wide = wide_table(WIDE_CONST_HI.as_ptr(), WIDE_CONST_LO.as_ptr(), WIDE_CONST_EXP.as_ptr(), %i)
        return(%w)

; Shifts the mantissa up until bit 191 is set.
routine wide_normalize(%negative: Bool, %exp: I64, %hi: I128, %lo: I64) -> Wide
    block entry():
        %zero: Bool = %hi.eq(0).bitand(%lo.eq(0))
        %nothing: Wide = wide_zero()
        branch %zero ? return(%nothing) : count(%exp, %hi, %lo)

    ; a whole empty top limb moves in 64 bits at a time
    block count(%exp: I64, %hi: I128, %lo: I64):
        %empty: Bool = %hi.lshr(64).eq(0)
        branch %empty ? limb(%exp, %hi, %lo) : bits(%exp, %hi, %lo)

    block limb(%exp: I64, %hi: I128, %lo: I64):
        %new_hi: I128 = %hi.shl(64).bitor(%lo.to_u128())
        jump count(%exp.sub(64), %new_hi, 0)

    block bits(%exp: I64, %hi: I128, %lo: I64):
        %s:      I64  = %hi.leading_zeros().to_i64()
        %some:   Bool = %s.sgt(0)
        %carry:  I128 = %some ? %lo.to_u128().lshr(64.sub(%s).to_i128()) : 0
        %new_hi: I128 = %hi.shl(%s.to_i128()).bitor(%carry)
        %new_lo: I64  = %lo.shl(%s)
        %w: Wide = Wide { negative: %negative, exp: %exp.sub(%s), hi: %new_hi, lo: %new_lo }
        return(%w)

routine wide_from_f128(%x: F128) -> Wide
    block entry():
        %zero: Bool = f128_is_zero_bits(%x.bits)
        %nothing: Wide = wide_zero()
        branch %zero ? return(%nothing) : finite()

    block finite():
        %p: F128Parts = f128_unpack(%x.bits)
        %w: Wide = Wide { negative: %x.bits.slt(0), exp: %p.exp, hi: %p.sig.shl(15), lo: 0 }
        return(%w)

routine wide_from_i64(%n: I64) -> Wide
    block entry():
        %w: Wide = wide_from_f128(%n.to_f128())
        return(%w)

; Rounds once to F128 (overflow, subnormals, and underflow included).
routine Wide.to_f128(%self: Self) -> F128
    block entry():
        %zero: Bool = %self.is_zero()
        %plus_zero: F128 = F128.from_bits(0)
        branch %zero ? return(%plus_zero) : round()

    ; value ~ hi × 2^(exp - 127): f128_round_pack wants sig × 2^(biased - 16383 - 115)
    block round():
        %sticky: I128 = %self.lo.ne(0).to_i128()
        %sig:    I128 = %self.hi.bitor(%sticky)
        %bits:   I128 = f128_round_pack(%self.negative, %self.exp.add(16371), %sig)
        %r:      F128 = F128.from_bits(%bits)
        return(%r)

; mantissa >> n (bits shifted out are dropped)
routine wide_shift_right(%hi: I128, %lo: I64, %n: I64) -> Wide
    block entry():
        %none:  Bool = %n.eq(0)
        %small: Bool = %n.slt(64)
        %mid:   Bool = %n.slt(192)
        select:
            %none -> done(%hi, %lo)
            %small -> small()
            %mid -> big()
            _ -> done(0, 0)

    block small():
        %new_lo: I64  = %lo.lshr(%n).bitor(%hi.to_i64().shl(64.sub(%n)))
        %new_hi: I128 = %hi.lshr(%n.to_i128())
        jump done(%new_hi, %new_lo)

    ; 64 <= n < 192: lo comes from hi, and hi keeps what's left above bit 128 + n - 64
    block big():
        %new_lo: I64  = %hi.lshr(%n.sub(64).to_i128()).to_i64()
        %new_hi: I128 = %n.sge(128) ? 0 : %hi.lshr(%n.min(127).to_i128())
        jump done(%new_hi, %new_lo)

    block done(%h: I128, %l: I64):
        %w: Wide = Wide { negative: false, exp: 0, hi: %h, lo: %l }
        return(%w)

routine Wide.add(%self: Self, %other: Self) -> Self
    block entry():
        %a_zero: Bool = %self.is_zero()
        %b_zero: Bool = %other.is_zero()
        select:
            %a_zero -> return(%other)
            %b_zero -> return(%self)
            _ -> order()

    ; big has the larger magnitude: larger exponent, or the same and a larger mantissa
    block order():
        %a_hi_more: Bool = %self.hi.ugt(%other.hi).bitor(%self.hi.eq(%other.hi).bitand(%self.lo.uge(%other.lo)))
        %a_first:   Bool = %self.exp.sgt(%other.exp).bitor(%self.exp.eq(%other.exp).bitand(%a_hi_more))
        %big:   Wide = %a_first ? %self : %other
        %small: Wide = %a_first ? %other : %self
        %aligned: Wide = wide_shift_right(%small.hi, %small.lo, %big.exp.sub(%small.exp))
        %same: Bool = %big.negative.eq(%small.negative)
        branch %same ? sum(%big, %aligned) : difference(%big, %aligned)

    block sum(%big: Wide, %s: Wide):
        %lo:       I64  = %big.lo.add(%s.lo)
        %c0:       I128 = %lo.ult(%big.lo).to_i128()
        %hi_part:  I128 = %big.hi.add(%s.hi)
        %c1:       Bool = %hi_part.ult(%big.hi)
        %hi:       I128 = %hi_part.add(%c0)
        %c2:       Bool = %hi.ult(%hi_part)
        %carry:    Bool = %c1.bitor(%c2)
        branch %carry ? overflow(%big, %hi, %lo) : done(%big.negative, %big.exp, %hi, %lo)

    ; the 193rd bit: shift right once, the carry becoming bit 191
    block overflow(%big: Wide, %hi: I128, %lo: I64):
        %new_lo: I64  = %lo.lshr(1).bitor(%hi.to_i64().shl(63))
        %new_hi: I128 = %hi.lshr(1).bitor(F128_SIGN)
        jump done(%big.negative, %big.exp.add(1), %new_hi, %new_lo)

    block difference(%big: Wide, %s: Wide):
        %lo:     I64  = %big.lo.sub(%s.lo)
        %borrow: I128 = %big.lo.ult(%s.lo).to_i128()
        %hi:     I128 = %big.hi.sub(%s.hi).sub(%borrow)
        %r: Wide = wide_normalize(%big.negative, %big.exp, %hi, %lo)
        return(%r)

    block done(%negative: Bool, %exp: I64, %hi: I128, %lo: I64):
        %r: Wide = Wide { negative: %negative, exp: %exp, hi: %hi, lo: %lo }
        return(%r)

routine Wide.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = %self.add(%other.neg())
        return(%r)

; The top 192 bits of the 384-bit product (the rest dropped).
routine Wide.mul(%self: Self, %other: Self) -> Self
    block entry():
        %a_zero: Bool = %self.is_zero()
        %b_zero: Bool = %other.is_zero()
        %zero:   Bool = %a_zero.bitor(%b_zero)
        %nothing: Wide = wide_zero()
        branch %zero ? return(%nothing) : product()

    block product():
        %a2: I128 = %self.hi.lshr(64)
        %a1: I128 = %self.hi.bitand(0xFFFFFFFFFFFFFFFF)
        %a0: I128 = %self.lo.to_u128()
        %b2: I128 = %other.hi.lshr(64)
        %b1: I128 = %other.hi.bitand(0xFFFFFFFFFFFFFFFF)
        %b0: I128 = %other.lo.to_u128()
        ; columns 1..5 of the schoolbook product; column 0 only feeds carries into 1
        %c0:  I128 = %a0.mul(%b0).lshr(64)
        %t1:  I128 = %a0.mul(%b1)
        %t1b: I128 = %a1.mul(%b0)
        %s1:  I128 = %c0.add(%t1.bitand(0xFFFFFFFFFFFFFFFF)).add(%t1b.bitand(0xFFFFFFFFFFFFFFFF))
        %k1:  I128 = %s1.lshr(64).add(%t1.lshr(64)).add(%t1b.lshr(64))
        %t2a: I128 = %a0.mul(%b2)
        %t2b: I128 = %a1.mul(%b1)
        %t2c: I128 = %a2.mul(%b0)
        %s2:  I128 = %k1.add(%t2a.bitand(0xFFFFFFFFFFFFFFFF)).add(%t2b.bitand(0xFFFFFFFFFFFFFFFF)).add(%t2c.bitand(0xFFFFFFFFFFFFFFFF))
        %k2:  I128 = %s2.lshr(64).add(%t2a.lshr(64)).add(%t2b.lshr(64)).add(%t2c.lshr(64))
        %t3a: I128 = %a1.mul(%b2)
        %t3b: I128 = %a2.mul(%b1)
        %s3:  I128 = %k2.add(%t3a.bitand(0xFFFFFFFFFFFFFFFF)).add(%t3b.bitand(0xFFFFFFFFFFFFFFFF))
        %k3:  I128 = %s3.lshr(64).add(%t3a.lshr(64)).add(%t3b.lshr(64))
        %t4:  I128 = %a2.mul(%b2)
        %s4:  I128 = %k3.add(%t4.bitand(0xFFFFFFFFFFFFFFFF))
        %k4:  I128 = %s4.lshr(64).add(%t4.lshr(64))
        ; limbs r5 r4 r3 (and r2 for the shift): product = r5..r0 × 2^(64 i)
        %r2: I64 = %s2.to_i64()
        %r3: I64 = %s3.to_i64()
        %r4: I64 = %s4.to_i64()
        %r5: I64 = %k4.to_i64()
        %top: Bool = %r5.slt(0)                                  ; bit 383 set
        %hi_full: I128 = %r5.to_u128().shl(64).bitor(%r4.to_u128())
        %hi:  I128 = %top ? %hi_full : %hi_full.shl(1).bitor(%r3.to_u128().lshr(63))
        %lo:  I64  = %top ? %r3 : %r3.shl(1).bitor(%r2.lshr(63))
        %exp: I64  = %self.exp.add(%other.exp).add(%top.to_i64())
        %negative: Bool = %self.negative.bitxor(%other.negative)
        %r: Wide = Wide { negative: %negative, exp: %exp, hi: %hi, lo: %lo }
        return(%r)

; self / other by Newton's method on the reciprocal: y ← y + y(1 - other·y),
; from an F64 seed (53 bits → 106 → 212).
routine Wide.div(%self: Self, %other: Self) -> Self
    block entry():
        %e:     I64  = %other.exp
        %unit:  Wide = %other.ldexp(0.sub(%e))                ; in [1, 2)
        %seed:  F64  = %unit.to_f128().to_f64()
        %one64: F64  = 1.0
        %y0:    Wide = wide_from_f128(%one64.fdiv(%seed).to_f128())
        %one:   Wide = wide_from_i64(1)
        %y1:    Wide = %y0.add(%y0.mul(%one.sub(%unit.mul(%y0))))
        %y2:    Wide = %y1.add(%y1.mul(%one.sub(%unit.mul(%y1))))
        %r:     Wide = %self.mul(%y2).ldexp(0.sub(%e))
        return(%r)

; round to the nearest integer, for |self| < 2^62
routine Wide.to_i64_nearest(%self: Self) -> I64
    block entry():
        %r: I64 = %self.to_f128().round_ties_even().to_i64()
        return(%r)

; -- exp -----------------------------------------------------------------------

; e^x for finite x with |x| below the overflow range (the caller clamps).
; x = q ln2 + d with |d| <= ln2/2, e^d by its Taylor series (27th degree; the
; first dropped term is below 2^-141), then × 2^q.
routine wide_exp(%x: Wide) -> Wide
    block entry():
        %ln2:     Wide = wide_const(0)
        %inv_ln2: Wide = wide_const(1)
        %q:       I64  = %x.mul(%inv_ln2).to_i64_nearest()
        %d:       Wide = %x.sub(wide_from_i64(%q).mul(%ln2))
        %last:    Wide = wide_table(WIDE_EXP_COEF_HI.as_ptr(), WIDE_EXP_COEF_LO.as_ptr(), WIDE_EXP_COEF_EXP.as_ptr(), 27)
        jump horner(26, %last, %d, %q)

    block horner(%i: I64, %s: Wide, %d: Wide, %q: I64):
        %done:   Bool = %i.slt(0)
        %scaled: Wide = %s.ldexp(%q)
        branch %done ? return(%scaled) : step(%i, %s, %d, %q)

    block step(%i: I64, %s: Wide, %d: Wide, %q: I64):
        %c: Wide = wide_table(WIDE_EXP_COEF_HI.as_ptr(), WIDE_EXP_COEF_LO.as_ptr(), WIDE_EXP_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%d).add(%c), %d, %q)

routine F128.exp(%self: Self) -> Self
    block entry():
        %nan:  Bool = %self.is_nan()
        %bits: I128 = %self.bits
        %negative: Bool = %bits.slt(0)
        ; e^x overflows past x = 11356.52 and is below half the smallest subnormal
        ; before x = -11433.4; beyond those the answer needs no series.
        %big: F128 = F128.from_bits(0x400C6300000000000000000000000000)     ; 11360
        %small: F128 = F128.from_bits(0xC00C6700000000000000000000000000)   ; -11488
        %over:  Bool = %self.gt(%big)
        %under: Bool = %self.lt(%small)
        %quiet:     F128 = F128.from_bits(f128_quiet(%bits))
        %infinity:  F128 = F128.INFINITY
        %plus_zero: F128 = F128.from_bits(0)
        select:
            %nan -> return(%quiet)
            %over -> return(%infinity)
            %under -> return(%plus_zero)
            _ -> compute()

    block compute():
        %r: F128 = f128_cm_exp(%self)
        return(%r)

; -- log -----------------------------------------------------------------------

; ln x for finite x > 0: x = fr × 2^e with fr in [sqrt(1/2), sqrt(2)); then
; ln fr = 2 atanh(t) = 2 (t + t^3/3 + t^5/5 + …) with t = (fr - 1) / (fr + 1),
; |t| <= 0.172, 26 terms (the first dropped one is below 2^-135).
routine wide_log(%x: Wide) -> Wide
    block entry():
        %sqrt_half: Wide = wide_const(2)
        %fr0:  Wide = %x.ldexp(0.sub(%x.exp))                 ; in [1, 2)
        %low:  Bool = %fr0.hi.ult(%sqrt_half.ldexp(1).hi)     ; below sqrt(2)?
        %fr:   Wide = %low ? %fr0 : %fr0.ldexp(-1)
        %e:    I64  = %low ? %x.exp : %x.exp.add(1)
        %one:  Wide = wide_from_i64(1)
        %t:    Wide = %fr.sub(%one).div(%fr.add(%one))
        %tt:   Wide = %t.mul(%t)
        %last: Wide = wide_table(WIDE_LOG_COEF_HI.as_ptr(), WIDE_LOG_COEF_LO.as_ptr(), WIDE_LOG_COEF_EXP.as_ptr(), 25)
        jump horner(24, %last, %tt, %t, %e)

    block horner(%i: I64, %s: Wide, %tt: Wide, %t: Wide, %e: I64):
        %done: Bool = %i.slt(0)
        branch %done ? finish(%s, %t, %e) : step(%i, %s, %tt, %t, %e)

    block step(%i: I64, %s: Wide, %tt: Wide, %t: Wide, %e: I64):
        %c: Wide = wide_table(WIDE_LOG_COEF_HI.as_ptr(), WIDE_LOG_COEF_LO.as_ptr(), WIDE_LOG_COEF_EXP.as_ptr(), %i)
        jump horner(%i.sub(1), %s.mul(%tt).add(%c), %tt, %t, %e)

    block finish(%s: Wide, %t: Wide, %e: I64):
        %ln_fr: Wide = %s.mul(%t).ldexp(1)
        %r:     Wide = wide_from_i64(%e).mul(wide_const(0)).add(%ln_fr)
        return(%r)

; ln x: NaN for x < 0, -inf at ±0, +inf at +inf.
routine F128.ln(%self: Self) -> Self
    block entry():
        %bits:     I128 = %self.bits
        %nan:      Bool = %self.is_nan()
        %zero:     Bool = f128_is_zero_bits(%bits)
        %negative: Bool = %bits.slt(0)
        %inf:      Bool = %self.is_infinite()
        %quiet:    F128 = F128.from_bits(f128_quiet(%bits))
        %minus_inf: F128 = F128.NEG_INFINITY
        %invalid:  F128 = F128.NAN
        select:
            %nan -> return(%quiet)
            %zero -> return(%minus_inf)
            %negative -> return(%invalid)
            %inf -> return(%self)
            _ -> compute()

    block compute():
        %r: F128 = f128_cm_log(%self)
        return(%r)

