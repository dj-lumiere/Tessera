/// A finite float mant × 2^(exponent - 191) with the mantissa's top bit (191) set;
/// zero has a zero mantissa. The mantissa is hi (bits 191..64) and lo (63..0).
record F128Extended
    negative : Bool
    exponent : S64
    hi       : U128
    lo       : U64

// -- F128Extended ----------------------------------------------------------------------

routine wide_zero() -> F128Extended
    block entry():
        %w : F128Extended = F128Extended { negative: false, exponent: 0, hi: 0, lo: 0 }
        return(%w)

routine F128Extended.is_zero(%self: Self) -> Bool
    block entry():
        %r : Bool = %self.hi.eq(0).bitand(%self.lo.eq(0))
        return(%r)

routine F128Extended.neg(%self: Self) -> Self
    block entry():
        %r : Self = Self { negative: %self.negative.bitnot(), exponent: %self.exponent,
                hi: %self.hi, lo: %self.lo }
        return(%r)

routine F128Extended.ldexp(%self: Self, %k: S64) -> Self
    block entry():
        %r : Self = Self { negative: %self.negative, exponent: %self.exponent.add(%k), hi: %self.hi,
                lo: %self.lo }
        return(%r)

/// Entry %i of one of the constant tables.
routine wide_table(%hi: @U128, %lo: @U64, %exponent: @S64, %i: USize) -> F128Extended
    block entry():
        %h : U128         = %hi.stride(%i).load()
        %l : U64          = %lo.stride(%i).load()
        %e : S64          = %exponent.stride(%i).load()
        %w : F128Extended = F128Extended { negative: false, exponent: %e, hi: %h, lo: %l }
        return(%w)

routine wide_const(%i: USize) -> F128Extended
    block entry():
        %w : F128Extended = wide_table(WIDE_CONST_HI.to<@U128>(), WIDE_CONST_LO.to<@U64>(),
                WIDE_CONST_EXP.to<@S64>(), %i)
        return(%w)

/// Shifts the mantissa up until bit 191 is set.
routine wide_normalize(%negative: Bool, %exponent: S64, %hi: U128, %lo: U64) -> F128Extended
    block entry():
        %zero    : Bool         = %hi.eq(0).bitand(%lo.eq(0))
        %nothing : F128Extended = wide_zero()
        branch %zero
            ? return(%nothing)
            : count(%exponent, %hi, %lo)

    // a whole empty top limb moves in 64 bits at a time
    block count(%exponent: S64, %hi: U128, %lo: U64):
        %empty : Bool = %hi.shr(64).eq(0)
        branch %empty
            ? limb(%exponent, %hi, %lo)
            : bits(%exponent, %hi, %lo)

    block limb(%exponent: S64, %hi: U128, %lo: U64):
        %new_hi : U128 = %hi.shl(64).bitor(%lo.to<U128>())
        jump count(%exponent.sub(64), %new_hi, 0)

    block bits(%exponent: S64, %hi: U128, %lo: U64):
        %s     : S64  = %hi.leading_zeros().to<S64>()
        %some  : Bool = %s.gt(0)
        %carry : U128 = %some
            ? %lo.to<U128>().shr(64.sub(%s).to<U128>())
            : 0
        %new_hi : U128         = %hi.shl(%s.to<U128>()).bitor(%carry)
        %new_lo : U64          = %lo.shl(%s.to<U64>())
        %w      : F128Extended = F128Extended { negative: %negative, exponent: %exponent.sub(%s),
                hi: %new_hi, lo: %new_lo }
        return(%w)

routine wide_from_f128(%x: F128) -> F128Extended
    block entry():
        %zero    : Bool         = f128_is_zero_bits(%x.bits())
        %nothing : F128Extended = wide_zero()
        branch %zero
            ? return(%nothing)
            : continue
        %p : F128Parts    = f128_unpack(%x.bits())
        %w : F128Extended = F128Extended { negative: f128_is_negative_bits(%x.bits()),
                exponent: %p.exponent, hi: %p.sig.shl(15), lo: 0 }
        return(%w)

routine wide_from_i64(%n: S64) -> F128Extended
    block entry():
        %w : F128Extended = wide_from_f128(%n.to<F128>())
        return(%w)

/// Rounds once to F128 (overflow, subnormals, and underflow included).
routine F128Extended.to<F128>(%self: Self) -> F128
    block entry():
        %zero      : Bool = %self.is_zero()
        %plus_zero : F128 = f128_of(0)
        branch %zero
            ? return(%plus_zero)
            : round()

    // value ~ hi × 2^(exponent - 127): f128_round_pack wants sig × 2^(biased - 16383 - 115)
    block round():
        %sticky : U128 = %self.lo.ne(0).to<U128>()
        %sig    : U128 = %self.hi.bitor(%sticky)
        %bits   : U128 = f128_round_pack(%self.negative, %self.exponent.add(16371), %sig)
        %r      : F128 = f128_of(%bits)
        return(%r)

/// mantissa >> n (bits shifted out are dropped)
routine wide_shift_right(%hi: U128, %lo: U64, %n: S64) -> F128Extended
    block entry():
        %none  : Bool = %n.eq(0)
        %small : Bool = %n.lt(64)
        %mid   : Bool = %n.lt(192)
        when:
            %none  -> done(%hi, %lo)
            %small -> small()
            %mid   -> big()
            else   -> done(0, 0)

    block small():
        %new_lo : U64  = %lo.shr(%n.to<U64>()).bitor(%hi.to_wrap<U64>().shl(64.sub(%n).to<U64>()))
        %new_hi : U128 = %hi.shr(%n.to<U128>())
        jump done(%new_hi, %new_lo)

    // 64 <= n < 192: lo comes from hi, and hi keeps what's left above bit 128 + n - 64
    block big():
        %new_lo : U64  = %hi.shr(%n.sub(64).to<U128>()).to_wrap<U64>()
        %new_hi : U128 = %n.ge(128)
            ? 0
            : %hi.shr(%n.min(127).to<U128>())
        jump done(%new_hi, %new_lo)

    block done(%h: U128, %l: U64):
        %w : F128Extended = F128Extended { negative: false, exponent: 0, hi: %h, lo: %l }
        return(%w)

routine F128Extended.add(%self: Self, %other: Self) -> Self
    block entry():
        %a_zero : Bool = %self.is_zero()
        %b_zero : Bool = %other.is_zero()
        when:
            %a_zero -> return(%other)
            %b_zero -> return(%self)
            else    -> order()

    // big has the larger magnitude: larger exponent, or the same and a larger mantissa
    block order():
        %a_hi_more : Bool = %self.hi.gt(%other.hi).bitor(%self.hi.eq(%other.hi).bitand(%self.lo.ge(%other.lo)))
        %a_first   : Bool = %self.exponent.gt(%other.exponent).bitor(%self.exponent.eq(%other.exponent).bitand(%a_hi_more))
        %big       : Self = %a_first
            ? %self
            : %other
        %small : Self = %a_first
            ? %other
            : %self
        %aligned : Self = wide_shift_right(%small.hi, %small.lo, %big.exponent.sub(%small.exponent))
        %same    : Bool = %big.negative.eq(%small.negative)
        branch %same
            ? sum(%big, %aligned)
            : difference(%big, %aligned)

    block sum(%big: Self, %s: Self):
        %lo      : U64  = %big.lo.add_wrap(%s.lo)
        %c0      : U128 = %lo.lt(%big.lo).to<U128>()
        %hi_part : U128 = %big.hi.add_wrap(%s.hi)
        %c1      : Bool = %hi_part.lt(%big.hi)
        %hi      : U128 = %hi_part.add_wrap(%c0)
        %c2      : Bool = %hi.lt(%hi_part)
        %carry   : Bool = %c1.bitor(%c2)
        branch %carry
            ? overflow(%big, %hi, %lo)
            : done(%big.negative, %big.exponent, %hi, %lo)

    // the 193rd bit: shift right once, the carry becoming bit 191
    block overflow(%big: Self, %hi: U128, %lo: U64):
        %new_lo : U64  = %lo.shr(1).bitor(%hi.to_wrap<U64>().shl(63))
        %new_hi : U128 = %hi.shr(1).bitor(F128_SIGN)
        jump done(%big.negative, %big.exponent.add(1), %new_hi, %new_lo)

    block difference(%big: Self, %s: Self):
        %lo     : U64  = %big.lo.sub_wrap(%s.lo)
        %borrow : U128 = %big.lo.lt(%s.lo).to<U128>()
        %hi     : U128 = %big.hi.sub_wrap(%s.hi).sub_wrap(%borrow)
        %r      : Self = wide_normalize(%big.negative, %big.exponent, %hi, %lo)
        return(%r)

    block done(%negative: Bool, %exponent: S64, %hi: U128, %lo: U64):
        %r : Self = Self { negative: %negative, exponent: %exponent, hi: %hi, lo: %lo }
        return(%r)

routine F128Extended.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = %self.add(%other.neg())
        return(%r)

/// The top 192 bits of the 384-bit product (the rest dropped).
routine F128Extended.mul(%self: Self, %other: Self) -> Self
    block entry():
        %a_zero  : Bool = %self.is_zero()
        %b_zero  : Bool = %other.is_zero()
        %zero    : Bool = %a_zero.bitor(%b_zero)
        %nothing : Self = wide_zero()
        branch %zero
            ? return(%nothing)
            : product()

    block product():
        %a2 : U128 = %self.hi.shr(64)
        %a1 : U128 = %self.hi.bitand(0xFFFFFFFFFFFFFFFF)
        %a0 : U128 = %self.lo.to<U128>()
        %b2 : U128 = %other.hi.shr(64)
        %b1 : U128 = %other.hi.bitand(0xFFFFFFFFFFFFFFFF)
        %b0 : U128 = %other.lo.to<U128>()
        // columns 1..5 of the schoolbook product; column 0 only feeds carries into 1
        %c0  : U128 = %a0.mul_wrap(%b0).shr(64)
        %t1  : U128 = %a0.mul_wrap(%b1)
        %t1b : U128 = %a1.mul_wrap(%b0)
        %s1  : U128 = %c0.add(%t1.bitand(0xFFFFFFFFFFFFFFFF)).add(%t1b.bitand(0xFFFFFFFFFFFFFFFF))
        %k1  : U128 = %s1.shr(64).add(%t1.shr(64)).add(%t1b.shr(64))
        %t2a : U128 = %a0.mul_wrap(%b2)
        %t2b : U128 = %a1.mul_wrap(%b1)
        %t2c : U128 = %a2.mul_wrap(%b0)
        %s2  : U128 = %k1.add(%t2a.bitand(0xFFFFFFFFFFFFFFFF)).add(%t2b.bitand(0xFFFFFFFFFFFFFFFF)).add(%t2c.bitand(0xFFFFFFFFFFFFFFFF))
        %k2  : U128 = %s2.shr(64).add(%t2a.shr(64)).add(%t2b.shr(64)).add(%t2c.shr(64))
        %t3a : U128 = %a1.mul_wrap(%b2)
        %t3b : U128 = %a2.mul_wrap(%b1)
        %s3  : U128 = %k2.add(%t3a.bitand(0xFFFFFFFFFFFFFFFF)).add(%t3b.bitand(0xFFFFFFFFFFFFFFFF))
        %k3  : U128 = %s3.shr(64).add(%t3a.shr(64)).add(%t3b.shr(64))
        %t4  : U128 = %a2.mul_wrap(%b2)
        %s4  : U128 = %k3.add(%t4.bitand(0xFFFFFFFFFFFFFFFF))
        %k4  : U128 = %s4.shr(64).add(%t4.shr(64))
        // limbs r5 r4 r3 (and r2 for the shift): product = r5..r0 × 2^(64 i)
        %r2      : U64  = %s2.to_wrap<U64>()
        %r3      : U64  = %s3.to_wrap<U64>()
        %r4      : U64  = %s4.to_wrap<U64>()
        %r5      : U64  = %k4.to_wrap<S64>().to_wrap<U64>()
        %top     : Bool = %r5.shr(63).eq(1)  // bit 383 set
        %hi_full : U128 = %r5.to<U128>().shl(64).bitor(%r4.to<U128>())
        %hi      : U128 = %top
            ? %hi_full
            : %hi_full.shl(1).bitor(%r3.to<U128>().shr(63))
        %lo : U64 = %top
            ? %r3
            : %r3.shl(1).bitor(%r2.shr(63))
        %exponent : S64  = %self.exponent.add(%other.exponent).add(%top.to<S64>())
        %negative : Bool = %self.negative.bitxor(%other.negative)
        %r        : Self = Self { negative: %negative, exponent: %exponent, hi: %hi, lo: %lo }
        return(%r)

/// self / other by Newton's method on the reciprocal: y ← y + y(1 - other·y),
/// from an F64 seed (53 bits → 106 → 212).
routine F128Extended.div(%self: Self, %other: Self) -> Self
    block entry():
        %e     : S64  = %other.exponent
        %unit  : Self = %other.ldexp(0.sub(%e))  // in [1, 2)
        %seed  : F64  = %unit.to<F128>().to<F64>()
        %one64 : F64  = 1.0
        %y0    : Self = wide_from_f128(%one64.div(%seed).to<F128>())
        %one   : Self = wide_from_i64(1)
        %y1    : Self = %y0.add(%y0.mul(%one.sub(%unit.mul(%y0))))
        %y2    : Self = %y1.add(%y1.mul(%one.sub(%unit.mul(%y1))))
        %r     : Self = %self.mul(%y2).ldexp(0.sub(%e))
        return(%r)

/// round to the nearest integer, for |self| < 2^62
routine F128Extended.to_i64_nearest(%self: Self) -> S64
    block entry():
        %r : S64 = %self.to<F128>().round_ties_even().to_clamp<S64>()
        return(%r)

// -- exponent -----------------------------------------------------------------------

/// e^x for finite x with |x| below the overflow range (the caller clamps).
/// x = q ln2 + d with |d| <= ln2/2, e^d by its Taylor series (27th degree; the
/// first dropped term is below 2^-141), then × 2^q.
routine wide_exp(%x: F128Extended) -> F128Extended
    block entry():
        %ln2     : F128Extended = wide_const(0)
        %inv_ln2 : F128Extended = wide_const(1)
        %q       : S64          = %x.mul(%inv_ln2).to_i64_nearest()
        %d       : F128Extended = %x.sub(wide_from_i64(%q).mul(%ln2))
        %last    : F128Extended = wide_table(WIDE_EXP_COEF_HI.to<@U128>(),
                WIDE_EXP_COEF_LO.to<@U64>(), WIDE_EXP_COEF_EXP.to<@S64>(), 27)
        jump horner(26, %last, %d, %q)

    block horner(%i: S64, %s: F128Extended, %d: F128Extended, %q: S64):
        %done   : Bool         = %i.lt(0)
        %scaled : F128Extended = %s.ldexp(%q)
        branch %done
            ? return(%scaled)
            : continue
        %c : F128Extended = wide_table(WIDE_EXP_COEF_HI.to<@U128>(), WIDE_EXP_COEF_LO.to<@U64>(),
                WIDE_EXP_COEF_EXP.to<@S64>(), %i.to<USize>())
        jump horner(%i.sub(1), %s.mul(%d).add(%c), %d, %q)

// -- log -----------------------------------------------------------------------

/// bits of 2/pi after the point, 64 per entry, most significant first (17280 bits)
preset TWO_OVER_PI: @Array<U64, 270> <- { 0xA2F9836E4E441529, 0xFC2757D1F534DDC0,
        0xDB6295993C439041, 0xFE5163ABDEBBC561, 0xB7246E3A424DD2E0, 452944820249399836,
