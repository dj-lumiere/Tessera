// Tessera stdlib: fibers
//
// A Scheduler runs fibers on a number of worker threads: the thread that calls
// run is the first, and run starts the others. Each fiber has a stack of its
// own, from the stack Allocator the scheduler was given, and runs until it
// yields or returns: nothing preempts it. run returns when every fiber has.
//
//     claim stacks : @Allocator <- make_stack_allocator()   // guard pages
//     claim sched  : @Scheduler <- .construct(alloc, stacks, 0)   // 0: a worker per processor
//     sched.spawn(worker, state, 65536)
//     sched.run()
//     sched.destruct()
//
// A fiber's routine takes one Addr, the state it works on (the state record is
// the capture list, as for a thread), and that state must outlive the fiber.
// Inside, sched.yield() lets other fibers run first. A fiber may go on on a
// different thread after it yields, so a #threadlocal global read on both
// sides of a yield may be two threads' copies.
//
// A fiber waits for something without holding up its worker in one of four
// ways, and the worker goes on with other fibers meanwhile:
//
// - park() until another fiber or thread calls wake() with its handle (from
//   current()). A wake that comes first isn't lost: the next park returns at
//   once. park may also return without a wake, so a fiber checks what it waits
//   for again in a loop, as with wait_on.
// - sleep(ns) until that many nanoseconds have passed.
// - join() a fiber started with spawn_joinable, until it has returned.
// - run_blocking() a call that may block the thread it runs on (reading a pipe,
//   a socket, a file): one of the scheduler's I/O threads runs it, and the
//   fiber goes on once it returns. read and write (stdlib/fiber/io.tess) are
//   built on it. The same on every operating system: the call itself runs as
//   it would anywhere, on a thread of its own.
//
// Outside a fiber (on the thread that called run, before it, or on any other
// thread) sleep and join wait the thread itself, run_blocking just calls, and
// park returns.
//
// Each worker keeps the fibers ready to go on in a queue of its own and takes
// them from its front, so a yielding fiber waits behind the others there. A
// fiber spawned or woken inside a fiber goes in that worker's queue, and one
// spawned or woken outside in the workers' queues in turn. A worker with an
// empty queue takes from the back of another's, and with nothing anywhere
// waits until a fiber is spawned or woken, or a sleeping one is due. Every
// switch goes through the worker's own stack: a fiber that stops returns to its
// worker, which puts it where it waits (a queue, the timers, a join) once it is
// off its stack, so nothing resumes a fiber that is still on it.

module Standard::Fiber

import Standard::Alloc
import Standard::Collections
import Standard::Os

/// The worker whose loop or fiber runs on this thread, or null.
#[threadlocal, target(os: not "none")]
global WORKER: @@Worker

// A fiber's wake_state. A wake turns RUNNING or PARKING into NOTIFIED, and PARKED back into RUNNING (and queues the
// fiber). park turns RUNNING into PARKING (or takes a NOTIFIED back to RUNNING and returns), and its worker, once the
// fiber is off its stack, turns PARKING into PARKED, or finds NOTIFIED and queues it again.
private preset FIBER_RUNNING:  U32 = 0

private preset FIBER_NOTIFIED: U32 = 1
private preset FIBER_PARKING:  U32 = 2
private preset FIBER_PARKED:   U32 = 3

/// One fiber, from spawn until it returns. A pointer to it is the fiber's handle (see current and wake).
record FiberState
    sp          : Addr  // its stack pointer while it isn't running
    stack       : Addr  // the bottom of its stack, from the scheduler's stack allocator
    entry       : Callable<(Addr,), Void>
    arg         : Addr
    finished    : Bool
    then        : Callable<(@Worker,
            @FiberState), Void>  // where its worker puts it once it is off its stack
    wake_state  : U32  // FIBER_RUNNING, FIBER_NOTIFIED, FIBER_PARKING or FIBER_PARKED
    deadline    : U64  // when it is due while it sleeps, in monotonic_ns
    join        : @Join  // its Join from spawn_joinable, or null
    waiting_for : @Join  // the Join it waits on in join
    work        : Callable<(Addr,), Void>  // its blocking call, on an I/O thread
    work_arg    : Addr

/// A fiber from spawn_joinable, until join returns.
record Join
    lock   : Mutex
    done   : U32  // 1 once the fiber has returned
    waiter : @FiberState  // a fiber waiting in join, or null

/// A sleeping fiber in the timers, earliest first, and in the order they went to sleep when they are due together.
private record TimerEntry
conform Priority<TimerEntry>
    deadline : U64
    seq      : U64
    fiber    : @FiberState

/// A worker thread of a Scheduler.
record Worker
    sched   : @Scheduler
    index   : USize
    home    : Addr  // the worker loop's stack pointer while a fiber runs
    current : @FiberState  // the fiber running, or null in the worker loop
    lock    : Mutex
    queue   : CircularList<@FiberState>
    thread  : Thread  // for every worker but the first, which is run's own thread

record Scheduler
    alloc       : @Allocator  // FiberState records, the workers, and the queues
    stacks      : @Allocator  // the fibers' stacks
    count       : USize  // workers
    workers     : @Worker
    next        : USize  // the worker the next fiber spawned outside a fiber goes to
    live        : U64  // fibers spawned and not yet returned
    epoch       : U32  // changes when there is work to look for, or none left; idle workers wait on it
    sleepers    : U32  // workers waiting on epoch
    timer_lock  : Mutex
    timers      : PriorityQueue<TimerEntry>  // the sleeping fibers
    timer_seq   : U64
    timer_count : U64  // entries in timers, read without the lock so a worker skips it when there are none
    io_threads  : @Thread  // IO_THREADS threads running the fibers' blocking calls
    io_lock     : Mutex
    io_queue    : CircularList<@FiberState>  // parked fibers whose call hasn't started
    io_epoch    : U32  // changes when a call is queued or the I/O threads should stop; they wait on it
    io_stop     : U32  // 1 once run is over

routine TimerEntry.less(self: Self, other: Self) -> Bool
    block entry():
        same : Bool = self.deadline.eq(other.deadline)
        branch same
            ? return(self.seq.lt(other.seq))
            : return(self.deadline.lt(other.deadline))

/// This thread's worker, read again at every call: a fiber may be on another thread after it yields, and a
/// thread-local address kept across the switch would be the old thread's.
#[noinline, target(os: not "none")]
private routine current_worker() -> @Worker
    block entry():
        w : @Worker = WORKER.load()
        return(w)

/// A scheduler with workers worker threads, or one per processor for 0.
#target(os: not "none")
routine Scheduler.construct(alloc: @Allocator, stacks: @Allocator, workers: USize) -> Self
    block entry():
        none : Bool = workers.eq(0)
        branch none
            ? make(alloc, stacks, cpu_count())
            : make(alloc, stacks, workers)

    block make(alloc: @Allocator, stacks: @Allocator, count: USize):
        array : @Worker = allocate<Worker>(alloc, count)
        jump init(alloc, stacks, count, array, 0)

    block init(alloc: @Allocator, stacks: @Allocator, count: USize, array: @Worker, i: USize):
        done : Bool = i.eq(count)
        branch done
            ? finish(alloc, stacks, count, array)
            : one(alloc, stacks, count, array, i)

    block one(alloc: @Allocator, stacks: @Allocator, count: USize, array: @Worker, i: USize):
        queue : CircularList<@FiberState> = .construct(alloc)
        array.stride(i).store(Worker { sched: null, index: i, home: null, current: null,
                lock: .construct(), queue: queue, thread: Thread { handle: null } })
        jump init(alloc, stacks, count, array, i.add(1))

    block finish(alloc: @Allocator, stacks: @Allocator, count: USize, array: @Worker):
        timers     : PriorityQueue<TimerEntry> = .construct(alloc)
        io_threads : @Thread                   = allocate<Thread>(alloc, IO_THREADS)
        io_queue   : CircularList<@FiberState> = .construct(alloc)
        s          : Self                      = Self { alloc: alloc, stacks: stacks, count: count,
                workers: array, next: 0, live: 0, epoch: 0, sleepers: 0, timer_lock: .construct(),
                timers: timers, timer_seq: 0, timer_count: 0, io_threads: io_threads,
                io_lock: .construct(), io_queue: io_queue, io_epoch: 0, io_stop: 0 }
        return(s)

/// Starts entry(arg) on a stack of stack_size bytes, from inside a fiber or out. From inside one of this
/// scheduler's fibers it goes in that worker's queue, else in the workers' queues in turn.
#target(os: not "none")
routine Scheduler.spawn(self: @Self, entry: Callable<(Addr,), Void>, arg: Addr,
        stack_size: USize) -> Void
    block entry():
        start_fiber(self, entry, arg, stack_size, null)
        return()

/// spawn, and a Join to wait for the fiber with: join(j) returns once it has returned, and frees the Join. Every
/// Join is joined once.
#target(os: not "none")
routine Scheduler.spawn_joinable(self: @Self, entry: Callable<(Addr,), Void>, arg: Addr,
        stack_size: USize) -> @Join
    block entry():
        j : @Join = allocate<Join>(self.alloc.load(), 1)
        j.store(Join { lock: .construct(), done: 0, waiter: null })
        start_fiber(self, entry, arg, stack_size, j)
        return(j)

/// The fiber running this code, if it is one of this scheduler's, or null: its handle for wake.
#target(os: not "none")
routine Scheduler.current(self: @Self) -> @FiberState
    block entry():
        w       : @Worker = current_worker()
        outside : Bool    = w.is_null()
        branch outside
            ? return(null)
            : check(w)

    block check(w: @Worker):
        ours : Bool = w.sched.load().ptr_eq(self)
        branch ours
            ? return(w.current.load())
            : return(null)

/// Inside a fiber: lets other fibers run first, then goes on, maybe on another thread. Outside one it does
/// nothing.
#target(os: not "none")
routine Scheduler.yield(self: @Self) -> Void
    block entry():
        w       : @Worker = current_worker()
        outside : Bool    = w.is_null()
        branch outside
            ? return()
            : inside(w)

    block inside(w: @Worker):
        fiber : @FiberState = w.current.load()
        loop  : Bool        = fiber.is_null()
        branch loop
            ? return()
            : give_way(w, fiber)

    // The worker queues the fiber once it is back on its own stack (see resume).
    block give_way(w: @Worker, fiber: @FiberState):
        switch_stack(fiber.sp, w.home.load())
        return()

/// Inside a fiber: waits until wake is called with its handle, or returns at once for a wake that came since the
/// last park. It may also return without one, so a fiber checks what it waits for again. Outside a fiber it returns.
#target(os: not "none")
routine Scheduler.park(self: @Self) -> Void
    block entry():
        fiber : @FiberState = self.current()
        none  : Bool        = fiber.is_null()
        branch none
            ? return()
            : inside(fiber)

    block inside(fiber: @FiberState):
        parking : Bool = compare_exchange(fiber.wake_state, FIBER_RUNNING, FIBER_PARKING)
        branch parking
            ? stop(fiber)
            : notified(fiber)

    // A wake came first: this park is over before it starts.
    block notified(fiber: @FiberState):
        fiber.wake_state.atomic_store(FIBER_RUNNING)
        return()

    // The worker decides, once the fiber is off its stack, whether a wake came meanwhile (see commit_park).
    block stop(fiber: @FiberState):
        fiber.then.store(commit_park.to<Callable>())
        switch_stack(fiber.sp, current_worker().home.load())
        return()

/// Lets fiber, a fiber of this scheduler that hasn't returned, go on: if it is parked it is queued, and if not its
/// next park returns at once. From any thread, inside a fiber or out.
#target(os: not "none")
routine Scheduler.wake(self: @Self, fiber: @FiberState) -> Void
    block entry():
        jump look()

    block look():
        state  : U32  = fiber.wake_state.atomic_load()
        parked : Bool = state.eq(FIBER_PARKED)
        branch parked
            ? unpark()
            : mark(state)

    block mark(state: U32):
        already : Bool = state.eq(FIBER_NOTIFIED)
        branch already
            ? return()
            : continue
        marked : Bool = compare_exchange(fiber.wake_state, state, FIBER_NOTIFIED)
        branch marked
            ? return()
            : look()

    block unpark():
        ours : Bool = compare_exchange(fiber.wake_state, FIBER_PARKED, FIBER_RUNNING)
        branch ours
            ? queue()
            : look()

    block queue():
        place_ready(self, fiber)
        return()

/// Inside a fiber: waits at least ns nanoseconds while the worker goes on with other fibers. Outside one the
/// thread waits.
#target(os: not "none")
routine Scheduler.sleep(self: @Self, ns: U64) -> Void
    block entry():
        deadline : U64         = monotonic_ns().add_clamp(ns)
        fiber    : @FiberState = self.current()
        none     : Bool        = fiber.is_null()
        branch none
            ? thread(deadline)
            : inside(fiber, deadline)

    block thread(deadline: U64):
        sleep_thread(deadline)
        return()

    // The worker puts it in the timers once it is off its stack (see to_timers).
    block inside(fiber: @FiberState, deadline: U64):
        fiber.deadline.store(deadline)
        fiber.then.store(to_timers.to<Callable>())
        switch_stack(fiber.sp, current_worker().home.load())
        return()

/// Waits until the fiber of j, from spawn_joinable, has returned, then frees j. Inside a fiber the worker goes on
/// with other fibers meanwhile, and outside one the thread waits.
#target(os: not "none")
routine Scheduler.join(self: @Self, j: @Join) -> Void
    block entry():
        fiber : @FiberState = self.current()
        none  : Bool        = fiber.is_null()
        branch none
            ? thread()
            : inside(fiber)

    // The worker decides, once the fiber is off its stack, whether to wait (see commit_join).
    block inside(fiber: @FiberState):
        fiber.waiting_for.store(j)
        fiber.then.store(commit_join.to<Callable>())
        switch_stack(fiber.sp, current_worker().home.load())
        jump free_join()

    block thread():
        done : Bool = j.done.atomic_load().eq(1)
        branch done
            ? settled()
            : continue
        wait_on(j.done, 0)
        jump thread()

    // The fiber's worker sets done and wakes this thread while it holds the lock: taking it once is waiting until
    // the worker is done with j.
    block settled():
        j.lock.lock()
        j.lock.unlock()
        jump free_join()

    block free_join():
        j.free(self.alloc.load())
        return()

/// Runs the fibers, and those they spawn, on the workers until every one has returned. This thread is the first
/// worker.
#target(os: not "none")
routine Scheduler.run(self: @Self) -> Void
    block entry():
        self.io_stop.atomic_store(0)
        jump io_start(0)

    block io_start(i: USize):
        done : Bool = i.eq(IO_THREADS)
        branch done
            ? start(1)
            : io_one(i)

    block io_one(i: USize):
        self.io_threads.load().stride(i).store(Thread.spawn(io_main.to<Callable>(), self,
                self.alloc.load()))
        jump io_start(i.add(1))

    block start(i: USize):
        done : Bool = i.ge(self.count.load())
        branch done
            ? own()
            : one(i)

    block one(i: USize):
        w : @Worker = self.workers.load().stride(i)
        w.sched.store(self)
        w.thread.store(Thread.spawn(worker_main.to<Callable>(), w, self.alloc.load()))
        jump start(i.add(1))

    block own():
        w     : @Worker = self.workers.load()
        outer : @Worker = WORKER.load()
        w.sched.store(self)
        worker_loop(w)
        WORKER.store(outer)
        jump join(1)

    block join(i: USize):
        done : Bool = i.ge(self.count.load())
        branch done
            ? io_stop()
            : wait_for(i)

    block wait_for(i: USize):
        self.workers.load().stride(i).thread.load().join()
        jump join(i.add(1))

    // Every fiber has returned, so no call is left: the I/O threads stop.
    block io_stop():
        self.io_stop.atomic_store(1)
        self.io_epoch.atomic_fetch_add(1)
        wake_all(self.io_epoch)
        jump io_join(0)

    block io_join(i: USize):
        done : Bool = i.eq(IO_THREADS)
        branch done
            ? return()
            : io_wait_for(i)

    block io_wait_for(i: USize):
        self.io_threads.load().stride(i).load().join()
        jump io_join(i.add(1))

/// Frees the fibers that never got to return, the queues, and the workers.
#target(os: not "none")
routine Scheduler.destruct(self: @Self) -> Void
    block entry():
        jump worker(0)

    block worker(i: USize):
        done : Bool = i.eq(self.count.load())
        branch done
            ? timers()
            : one(i)

    block one(i: USize):
        w : @Worker = self.workers.load().stride(i)
        drain(self, w.queue)
        w.queue.destruct()
        jump worker(i.add(1))

    block timers():
        empty : Bool = self.timers.load().is_empty()
        branch empty
            ? finish()
            : continue
        entry : TimerEntry = self.timers.pop()
        free_fiber(self, entry.fiber)
        jump timers()

    block finish():
        self.timers.destruct()
        drain(self, self.io_queue)
        self.io_queue.destruct()
        self.io_threads.load().free(self.alloc.load())
        self.workers.load().free(self.alloc.load())
        return()

/// Runs work(arg), a call that may block the thread it runs on, without stopping the other fibers: inside a fiber
/// it runs on one of the scheduler's I/O threads while the fiber waits, and the fiber goes on once it returns,
/// maybe on another worker. Outside a fiber it is just called. arg may point into the fiber's stack: the fiber
/// waits until the call is over.
#target(os: not "none")
routine Scheduler.run_blocking(self: @Self, work: Callable<(Addr,), Void>, arg: Addr) -> Void
    block entry():
        fiber : @FiberState = self.current()
        none  : Bool        = fiber.is_null()
        branch none
            ? direct()
            : park(fiber)

    block direct():
        work.call(arg)
        return()

    // The worker hands the fiber to the I/O threads once it is back on its own stack (see to_io).
    block park(fiber: @FiberState):
        fiber.work.store(work)
        fiber.work_arg.store(arg)
        fiber.then.store(to_io.to<Callable>())
        switch_stack(fiber.sp, current_worker().home.load())
        return()

// -- where a stopped fiber goes ------------------------------------------------------
//
// Each of these runs on the worker's stack, after the fiber has switched away from its own, so the fiber can be
// queued or resumed elsewhere at once.

/// A yield: behind the others in this worker's queue.
#target(os: not "none")
private routine requeue(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        push_ready(w, fiber)
        notify(w.sched.load())
        return()

/// A park: parked, unless a wake came while it stopped.
#target(os: not "none")
private routine commit_park(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        parked : Bool = compare_exchange(fiber.wake_state, FIBER_PARKING, FIBER_PARKED)
        branch parked
            ? return()
            : notified()

    block notified():
        fiber.wake_state.atomic_store(FIBER_RUNNING)
        requeue(w, fiber)
        return()

/// A sleep: in the timers, and a waiting worker looks again, since its wait may now be too long.
#target(os: not "none")
private routine to_timers(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        sched : @Scheduler = w.sched.load()
        sched.timer_lock.lock()
        seq : U64 = sched.timer_seq.load()
        seq.add(1).store_into(sched.timer_seq)
        sched.timers.push(TimerEntry { deadline: fiber.deadline.load(), seq: seq, fiber: fiber })
        sched.timer_count.atomic_fetch_add(1)
        sched.timer_lock.unlock()
        notify(sched)
        return()

/// A join: queued again if the fiber it waits for has returned, else that fiber's worker queues it when it does.
#target(os: not "none")
private routine commit_join(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        j : @Join = fiber.waiting_for.load()
        j.lock.lock()
        done : Bool = j.done.atomic_load().eq(1)
        branch done
            ? ready(j)
            : wait(j)

    block ready(j: @Join):
        j.lock.unlock()
        requeue(w, fiber)
        return()

    block wait(j: @Join):
        j.waiter.store(fiber)
        j.lock.unlock()
        return()

/// A blocking call: to the I/O threads. Not before the fiber is off its stack: its call may finish at once, and the
/// fiber must not be resumed while it still runs.
#target(os: not "none")
private routine to_io(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        sched : @Scheduler = w.sched.load()
        sched.io_lock.lock()
        sched.io_queue.push_back(fiber)
        sched.io_lock.unlock()
        sched.io_epoch.atomic_fetch_add(1)
        wake_one(sched.io_epoch)
        return()

// -- the I/O threads -----------------------------------------------------------------

/// How many I/O threads run blocking calls.
preset IO_THREADS: USize = 4

#target(os: not "none")
private routine io_main(raw: Addr) -> Void
    block entry():
        sched : @Scheduler = raw.to<@Scheduler>()
        jump look(sched)

    // Reads the epoch before looking, so a call queued in between changes it and the wait returns.
    block look(sched: @Scheduler):
        seen  : U32         = sched.io_epoch.atomic_load()
        fiber : @FiberState = pop_front_locked(sched.io_lock, sched.io_queue)
        none  : Bool        = fiber.is_null()
        branch none
            ? idle(sched, seen)
            : call(sched, fiber)

    block idle(sched: @Scheduler, seen: U32):
        stop : Bool = sched.io_stop.atomic_load().eq(1)
        branch stop
            ? return()
            : sleep(sched, seen)

    block sleep(sched: @Scheduler, seen: U32):
        wait_on(sched.io_epoch, seen)
        jump look(sched)

    // The call is over: the fiber is ready again, in the workers' queues in turn.
    block call(sched: @Scheduler, fiber: @FiberState):
        work : Callable<(Addr,), Void> = fiber.work.load()
        work.call(fiber.work_arg.load())
        place_ready(sched, fiber)
        jump look(sched)

// -- the workers ---------------------------------------------------------------------

#target(os: not "none")
private routine worker_main(raw: Addr) -> Void
    block entry():
        worker_loop(raw.to<@Worker>())
        return()

/// A worker's loop: resumes ready fibers until none is left anywhere.
#target(os: not "none")
private routine worker_loop(w: @Worker) -> Void
    block entry():
        WORKER.store(w)
        jump look()

    block look():
        fiber : @FiberState = find_work(w)
        none  : Bool        = fiber.is_null()
        branch none
            ? idle()
            : run_one(fiber)

    block run_one(fiber: @FiberState):
        resume(w, fiber)
        jump look()

    // Reads the epoch before looking again, so work that arrives in between changes it and the wait returns.
    block idle():
        sched : @Scheduler = w.sched.load()
        over  : Bool       = sched.live.atomic_load().eq(0)
        branch over
            ? return()
            : recheck(sched, sched.epoch.atomic_load())

    block recheck(sched: @Scheduler, seen: U32):
        fiber : @FiberState = find_work(w)
        none  : Bool        = fiber.is_null()
        branch none
            ? sleep(sched, seen)
            : run_one(fiber)

    // Waits for work, or until the earliest sleeping fiber is due.
    block sleep(sched: @Scheduler, seen: U32):
        over : Bool = sched.live.atomic_load().eq(0)
        branch over
            ? return()
            : continue
        sched.sleepers.atomic_fetch_add(1)
        wait    : U64  = timer_wait(sched)
        forever : Bool = wait.eq(U64.MAX)
        branch forever
            ? wait_long(sched, seen)
            : wait_short(sched, seen, wait)

    block wait_long(sched: @Scheduler, seen: U32):
        wait_on(sched.epoch, seen)
        jump woke(sched)

    block wait_short(sched: @Scheduler, seen: U32, wait: U64):
        wait_on_for(sched.epoch, seen, wait)
        jump woke(sched)

    block woke(sched: @Scheduler):
        sched.sleepers.atomic_fetch_sub(1)
        jump look()

/// The next fiber for w: a sleeping fiber that is due goes in its queue first, then the front of its own queue,
/// else the back of another worker's.
#target(os: not "none")
private routine find_work(w: @Worker) -> @FiberState
    block entry():
        fire_timers(w)
        own   : @FiberState = pop_front_locked(w.lock, w.queue)
        found : Bool        = own.is_not_null()
        branch found
            ? return(own)
            : steal(w.sched.load(), 1)

    block steal(sched: @Scheduler, k: USize):
        count : USize = sched.count.load()
        done  : Bool  = k.ge(count)
        branch done
            ? return(null)
            : victim(sched, k, count)

    block victim(sched: @Scheduler, k: USize, count: USize):
        other : @Worker     = sched.workers.load().stride(w.index.load().add(k).mod(count))
        fiber : @FiberState = pop_back_locked(other.lock, other.queue)
        found : Bool        = fiber.is_not_null()
        branch found
            ? return(fiber)
            : steal(sched, k.add(1))

/// Moves the sleeping fibers that are due into w's queue.
#target(os: not "none")
private routine fire_timers(w: @Worker) -> Void
    block entry():
        sched : @Scheduler = w.sched.load()
        any   : Bool       = sched.timer_count.atomic_load().ne(0)
        branch any
            ? check(sched)
            : return()

    block check(sched: @Scheduler):
        now : U64 = monotonic_ns()
        sched.timer_lock.lock()
        jump next(sched, now, false)

    block next(sched: @Scheduler, now: U64, fired: Bool):
        empty : Bool = sched.timers.load().is_empty()
        branch empty
            ? done(sched, fired)
            : continue
        due : Bool = sched.timers.load().peek().deadline.le(now)
        branch due
            ? fire(sched, now)
            : done(sched, fired)

    block fire(sched: @Scheduler, now: U64):
        entry : TimerEntry = sched.timers.pop()
        sched.timer_count.atomic_fetch_sub(1)
        push_ready(w, entry.fiber)
        jump next(sched, now, true)

    // Others may take what this worker can't get to first.
    block done(sched: @Scheduler, fired: Bool):
        sched.timer_lock.unlock()
        branch fired
            ? continue
            : return()
        notify(sched)
        return()

/// How long an idle worker may wait: until the earliest sleeping fiber is due, or U64.MAX for no limit.
#target(os: not "none")
private routine timer_wait(sched: @Scheduler) -> U64
    block entry():
        any : Bool = sched.timer_count.atomic_load().ne(0)
        branch any
            ? check()
            : return(U64.MAX)

    block check():
        sched.timer_lock.lock()
        empty : Bool = sched.timers.load().is_empty()
        branch empty
            ? none()
            : earliest()

    block none():
        sched.timer_lock.unlock()
        return(U64.MAX)

    block earliest():
        deadline : U64 = sched.timers.load().peek().deadline
        sched.timer_lock.unlock()
        wait : U64 = deadline.sub_clamp(monotonic_ns())
        return(wait)

/// Runs fiber on w until it stops or returns. One that stopped goes where it waits (its then); one that returned is
/// freed here, on the worker's stack, since it can't free the one it runs on.
#target(os: not "none")
private routine resume(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        w.current.store(fiber)
        switch_stack(w.home, fiber.sp.load())
        w.current.store(null)
        done : Bool = fiber.finished.load()
        branch done
            ? finished()
            : stopped()

    // then goes back to requeue before it runs: the fiber may be resumed elsewhere as soon as it is placed.
    block stopped():
        then : Callable<(@Worker, @FiberState), Void> = fiber.then.load()
        fiber.then.store(requeue.to<Callable>())
        then.call(w, fiber)
        return()

    block finished():
        sched : @Scheduler = w.sched.load()
        j     : @Join      = fiber.join.load()
        free_fiber(sched, fiber)
        finish_join(w, j)
        left : U64  = sched.live.atomic_fetch_sub(1)
        last : Bool = left.eq(1)
        branch last
            ? wake_everyone(sched)
            : return()

    // The last fiber returned: every waiting worker looks once more and finds there's nothing left.
    block wake_everyone(sched: @Scheduler):
        sched.epoch.atomic_fetch_add(1)
        wake_all(sched.epoch)
        return()

/// A joinable fiber returned: marks j done, wakes a thread waiting on it, and queues a fiber waiting in join.
#target(os: not "none")
private routine finish_join(w: @Worker, j: @Join) -> Void
    block entry():
        none : Bool = j.is_null()
        branch none
            ? return()
            : continue
        j.lock.lock()
        j.done.atomic_store(1)
        waiter : @FiberState = j.waiter.load()
        wake_all(j.done)
        j.lock.unlock()
        alone : Bool = waiter.is_null()
        branch alone
            ? return()
            : continue
        requeue(w, waiter)
        return()

/// fiber is ready: in this worker's queue if this runs in one of the scheduler's fibers or workers, else in the
/// workers' queues in turn.
#target(os: not "none")
private routine place_ready(sched: @Scheduler, fiber: @FiberState) -> Void
    block entry():
        w       : @Worker = current_worker()
        outside : Bool    = w.is_null()
        branch outside
            ? shared()
            : check(w)

    block check(w: @Worker):
        ours : Bool = w.sched.load().ptr_eq(sched)
        branch ours
            ? local(w)
            : shared()

    block local(w: @Worker):
        push_ready(w, fiber)
        notify(sched)
        return()

    block shared():
        turn : USize   = sched.next.atomic_fetch_add(1)
        w    : @Worker = sched.workers.load().stride(turn.mod(sched.count.load()))
        push_ready(w, fiber)
        notify(sched)
        return()

/// A new fiber, ready to run.
#target(os: not "none")
private routine start_fiber(sched: @Scheduler, entry: Callable<(Addr,), Void>, arg: Addr,
        stack_size: USize, j: @Join) -> Void
    block entry():
        stack : @Byte       = allocate<Byte>(sched.stacks.load(), stack_size)
        sp    : Addr        = initial_stack(stack, stack_size, fiber_start.addr())
        fiber : @FiberState = allocate<FiberState>(sched.alloc.load(), 1)
        fiber.store(FiberState { sp: sp, stack: stack, entry: entry, arg: arg, finished: false,
                then: requeue.to<Callable>(), wake_state: FIBER_RUNNING, deadline: 0, join: j,
                waiting_for: null, work: no_work.to<Callable>(), work_arg: null })
        sched.live.atomic_fetch_add(1)
        place_ready(sched, fiber)
        return()

/// There is a fiber to look for: a waiting worker, if any, looks.
#target(os: not "none")
private routine notify(sched: @Scheduler) -> Void
    block entry():
        sched.epoch.atomic_fetch_add(1)
        waiting : Bool = sched.sleepers.atomic_load().ne(0)
        branch waiting
            ? wake()
            : return()

    block wake():
        wake_one(sched.epoch)
        return()

/// A thread outside a fiber waits until deadline.
#target(os: not "none")
private routine sleep_thread(deadline: U64) -> Void
    block entry():
        claim never : @U32 <- 0
        jump look(never)

    block look(never: @U32):
        now  : U64  = monotonic_ns()
        done : Bool = now.ge(deadline)
        branch done
            ? return()
            : continue
        wait_on_for(never, 0, deadline.sub(now))
        jump look(never)

/// Writes new at at if expected is there, and says whether it did.
#target(os: not "none")
private routine compare_exchange(at: @U32, expected: U32, new: U32) -> Bool
    block entry():
        claim previous : @U32 <- 0
        swapped : Bool = at.atomic_compare_exchange_raw(expected, new, previous)
        return(swapped)

/// The work of a fiber that has none.
#target(os: not "none")
private routine no_work(arg: Addr) -> Void
    block entry():
        return()

#target(os: not "none")
private routine push_ready(w: @Worker, fiber: @FiberState) -> Void
    block entry():
        w.lock.lock()
        w.queue.push_back(fiber)
        w.lock.unlock()
        return()

#target(os: not "none")
private routine pop_front_locked(lock: @Mutex, queue: @CircularList<@FiberState>) -> @FiberState
    block entry():
        lock.lock()
        empty : Bool = queue.load().is_empty()
        branch empty
            ? none(lock)
            : take(lock, queue)

    block none(lock: @Mutex):
        lock.unlock()
        return(null)

    block take(lock: @Mutex, queue: @CircularList<@FiberState>):
        fiber : @FiberState = queue.pop_front()
        lock.unlock()
        return(fiber)

#target(os: not "none")
private routine pop_back_locked(lock: @Mutex, queue: @CircularList<@FiberState>) -> @FiberState
    block entry():
        lock.lock()
        empty : Bool = queue.load().is_empty()
        branch empty
            ? none(lock)
            : take(lock, queue)

    block none(lock: @Mutex):
        lock.unlock()
        return(null)

    block take(lock: @Mutex, queue: @CircularList<@FiberState>):
        fiber : @FiberState = queue.pop_back()
        lock.unlock()
        return(fiber)

#target(os: not "none")
private routine drain(sched: @Scheduler, queue: @CircularList<@FiberState>) -> Void
    block entry():
        jump next()

    block next():
        empty : Bool = queue.load().is_empty()
        branch empty
            ? return()
            : drop()

    block drop():
        free_fiber(sched, queue.pop_front())
        jump next()

#target(os: not "none")
private routine free_fiber(sched: @Scheduler, fiber: @FiberState) -> Void
    block entry():
        stack : @Byte = fiber.stack.load().to<@Byte>()
        stack.free(sched.stacks.load())
        fiber.free(sched.alloc.load())
        return()

/// A new fiber's first routine: switch_stack returns into it on the fiber's new stack. It runs the fiber's routine,
/// marks it finished, and goes back to the worker it is on now, for the last time.
#[noreturn, target(os: not "none")]
private routine fiber_start() -> Void
    block entry():
        fiber : @FiberState             = current_worker().current.load()
        entry : Callable<(Addr,), Void> = fiber.entry.load()
        entry.call(fiber.arg.load())
        fiber.finished.store(true)
        w : @Worker = current_worker()
        switch_stack(fiber.sp, w.home.load())
        unreachable
