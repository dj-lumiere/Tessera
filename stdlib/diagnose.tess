// Tessera stdlib: diagnosing
//
// Diagnose writes a value the way a programmer reads it: as Tessera source
// where there is a literal for it. Represent is for the program's own output,
// so a Bytes represents as its text but diagnoses in quotes with escapes:
//
//     %name.represent(%out)  // Ada
//     %name.diagnose(%out)   // "Ada"
//
// Numbers and Bool read the same both ways. Char diagnoses as 'A', Byte as b'A'
// (b'\x7f' when it isn't printable ASCII), and an Array as [1, 2, 3]. Pointers
// diagnose as their address.
//
// A record, choice, or variant gets a diagnose from the compiler with
// #derive(Diagnose): Point { x: 1, y: 2 }, Color.Red, Option.Present(3).
// #derive(Represent) writes the same record text (fields are diagnosed inside
// any aggregate), a choice member as Red, and a variant case as Present(3).

module Standard::Format

concept Diagnose<T>
require T: typename
    routine Self.diagnose<W>(%self: Self, %out: @W) -> Void

conform Diagnose<S8>, Diagnose<S16>, Diagnose<S32>, Diagnose<S64>, Diagnose<S128>, Diagnose<S256>
conform Diagnose<U8>, Diagnose<U16>, Diagnose<U32>, Diagnose<U64>, Diagnose<U128>, Diagnose<U256>
conform Diagnose<USize>, Diagnose<SSize>
conform Diagnose<F16>, Diagnose<BF16>, Diagnose<F32>, Diagnose<F64>, Diagnose<F128>
conform Diagnose<Bool>, Diagnose<Char>, Diagnose<Byte>, Diagnose<Bytes>, Diagnose<Unit>, Diagnose<Addr>
conform Diagnose<@T>          when T: typename
conform Diagnose<Array<T, N>> when T: typename, N: USize, Diagnose<T>

// -- text ----------------------------------------------------------------------

/// One byte inside a quoted literal: an escape (\n, \t, \r, \0, \\, or the
/// quote), the byte itself when it's printable ASCII, and otherwise \xHH, or
/// \u0000HH when %as_char (a character literal takes no \x).
routine write_escaped_byte<W>(%out: @W, %byte: Byte, %quote: Byte, %as_char: Bool) -> Void
require W: typename, Writer<W>
    block entry():
        %is_quote : Bool = %byte.eq(%quote)
        branch %is_quote
            ? escaped()
            : named()

    block escaped():
        write_str(%out, "\\")
        jump raw()

    block named():
        when %byte:
            b'\n' -> escape("\\n")
            b'\t' -> escape("\\t")
            b'\r' -> escape("\\r")
            b'\0' -> escape("\\0")
            b'\\' -> escape("\\\\")
            else  -> other()

    block escape(%text: Bytes):
        write_str(%out, %text)
        return()

    block other():
        %printable : Bool = %byte.between(0x20, 0x7E)
        branch %printable
            ? raw()
            : hex()

    block raw():
        claim %slot : @Byte <- %byte
        %out.write_bytes(%slot, 1)
        return()

    block hex():
        branch %as_char
            ? char_hex()
            : byte_hex()

    block byte_hex():
        write_str(%out, "\\x")
        write_hex_u64(%out, %byte.to_u8().to_u64(), 2)
        return()

    block char_hex():
        write_str(%out, "\\u")
        write_hex_u64(%out, %byte.to_u8().to_u64(), 6)
        return()

/// In quotes: ASCII through the byte escapes, a well-formed UTF-8 character as
/// it is, and each byte of a malformed sequence as \xHH, so the text reads back
/// as the same bytes.
routine Bytes.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(%out, "\"")
        jump walk(0)

    block walk(%at: USize):
        %length : USize = %self.length
        %more   : Bool  = %at.lt(%length)
        branch %more
            ? step(%at)
            : close()

    block step(%at: USize):
        %data  : @Byte = %self.data
        %byte  : Byte  = %data.stride(%at).load()
        %ascii : Bool  = %byte.lt(0x80)
        branch %ascii
            ? ascii(%at, %byte)
            : wide(%at, %byte)

    block ascii(%at: USize, %byte: Byte):
        write_escaped_byte(%out, %byte, b'"', false)
        jump walk(%at.add(1))

    block wide(%at: USize, %byte: Byte):
        %data : @Byte       = %self.data
        %d    : Utf8Decoded = utf8_decode(%data, %at, %self.length)
        branch %d.ok
            ? character(%at, %d.next_pos)
            : malformed(%at, %byte)

    block character(%at: USize, %next: USize):
        %data : @Byte = %self.data
        %out.write_bytes(%data.stride(%at), %next.sub(%at))
        jump walk(%next)

    block malformed(%at: USize, %byte: Byte):
        write_escaped_byte(%out, %byte, b'"', false)
        jump walk(%at.add(1))

    block close():
        write_str(%out, "\"")
        return()

routine Byte.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(%out, "b'")
        write_escaped_byte(%out, %self, b'\'', false)
        write_str(%out, "'")
        return()

/// ASCII goes through the byte escapes; any other character is written as its
/// UTF-8.
routine Char.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(%out, "'")
        %code  : U32  = %self.to_u32()
        %ascii : Bool = %code.lt(128)
        branch %ascii
            ? ascii(%code)
            : wide()

    block ascii(%code: U32):
        %byte : Byte = %code.to_u8().bits()
        write_escaped_byte(%out, %byte, b'\'', true)
        jump close()

    block wide():
        %self.represent(%out)
        jump close()

    block close():
        write_str(%out, "'")
        return()

// -- values that read the same both ways ---------------------------------------

routine Bool.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(%out)
        return()

routine Unit.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(%out, "Unit")
        return()

routine Addr.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(%out)
        return()

routine Ptr<T>.diagnose<W>(%self: Self, %out: @W) -> Void
require T: typename, W: typename, Writer<W>
    block entry():
        %self.represent(%out)
        return()

// -- arrays --------------------------------------------------------------------

routine Array<T, N>.diagnose<W>(%self: Self, %out: @W) -> Void
require T: typename, N: USize, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim %slot : @Self <- %self
        write_str(%out, "[")
        jump walk(0, %slot)

    block walk(%at: USize, %slot: @Self):
        %more : Bool = %at.lt(N)
        branch %more
            ? item(%at, %slot)
            : close()

    block item(%at: USize, %slot: @Self):
        %first : Bool = %at.eq(0)
        branch %first
            ? element(%at, %slot)
            : separate(%at, %slot)

    block separate(%at: USize, %slot: @Self):
        write_str(%out, ", ")
        jump element(%at, %slot)

    block element(%at: USize, %slot: @Self):
        %value : T = %slot.get(%at)
        %value.diagnose(%out)
        jump walk(%at.add(1), %slot)

    block close():
        write_str(%out, "]")
        return()

// -- numbers -------------------------------------------------------------------
//
// A number's decimal text is already its literal (floats keep a .0 or an
// exponent), so diagnose is represent.

routine S8.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(%out)
        return()

routine S16.diagnose<W>(%self: Self, %out: @W) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(%out)
        return()

