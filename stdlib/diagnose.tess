// Tessera stdlib: diagnosing
//
// Diagnose writes a value the way a programmer reads it: as Tessera source
// where there is a literal for it. Represent is for the program's own output,
// so a String represents as its text but diagnoses in quotes with escapes:
//
//     %name.represent(#out)  // Ada
//     %name.diagnose(#out)   // "Ada"
//
// Numbers and Bool read the same both ways. Char diagnoses as 'A', Byte as b'A'
// (b'\x7f' when it isn't printable ASCII), Option as .present(3) or .absent, Result
// as .success(3) or .failure(...), and an Array as [1, 2, 3]. Pointers diagnose as their
// address.
//
// A record or choice gets a diagnose from the compiler with @derive(Diagnose):
// Point { x: 1, y: 2 }, Color.Red. @derive(Represent) writes the same record
// text (fields are diagnosed inside any aggregate) and a choice member as Red.

module Standard::Format

concept Diagnose<T>
require T: typename
    routine Self.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void

conform Diagnose<S8>, Diagnose<S16>, Diagnose<S32>, Diagnose<S64>, Diagnose<S128>, Diagnose<S256>
conform Diagnose<U8>, Diagnose<U16>, Diagnose<U32>, Diagnose<U64>, Diagnose<U128>, Diagnose<U256>
conform Diagnose<F16>, Diagnose<BF16>, Diagnose<F32>, Diagnose<F64>, Diagnose<F128>
conform Diagnose<Bool>, Diagnose<Char>, Diagnose<Byte>, Diagnose<String>, Diagnose<Unit>, Diagnose<Addr>
conform Diagnose<Ptr<T>> when T: typename
conform Diagnose<Option<T>> when T: typename, Diagnose<T>
conform Diagnose<Result<T, E>> when T: typename, Diagnose<T>, E: typename, Diagnose<E>
conform Diagnose<Array<T, N>> when T: typename, N: U64, Diagnose<T>

// -- text ----------------------------------------------------------------------

/// One byte inside a quoted literal: an escape (\n, \t, \r, \0, \\, or the
/// quote), the byte itself when it's printable ASCII, and otherwise \xHH. With
/// %raw_high, bytes from 0x80 up are written as they are, so a String's UTF-8
/// stays readable.
routine write_escaped_byte<W>(#out: Ptr<W>, %byte: Byte, %quote: Byte, %raw_high: Bool) -> Void
require W: typename, Writer<W>
    block entry():
        %is_quote : Bool = %byte.eq(%quote)
        branch %is_quote ? escaped() : named()

    block escaped():
        write_str(#out, "\\")
        jump raw()

    block named():
        when %byte:
            b'\n' -> escape("\\n")
            b'\t' -> escape("\\t")
            b'\r' -> escape("\\r")
            b'\0' -> escape("\\0")
            b'\\' -> escape("\\\\")
            _     -> other()

    block escape(%text: String):
        write_str(#out, %text)
        return()

    block other():
        %printable : Bool = %byte.between(0x20, 0x7E)
        %high      : Bool = %byte.ge(0x80).bitand(%raw_high)
        %as_is     : Bool = %printable.bitor(%high)
        branch %as_is ? raw() : hex()

    block raw():
        claim #slot : Ptr<Byte>
        #slot.store(%byte)
        #out.write_bytes(#slot, 1)
        return()

    block hex():
        write_str(#out, "\\x")
        write_hex_u64(#out, %byte.to_u8().to_u64(), 2)
        return()

routine String.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, "\"")
        jump walk(0)

    block walk(%at: U64):
        %length : U64  = %self.length
        %more   : Bool = %at.lt(%length)
        branch %more ? step(%at) : close()

    block step(%at: U64):
        #data : Ptr<Byte> = %self.data
        %byte : Byte      = #data[%at].load()
        write_escaped_byte(#out, %byte, b'"', true)
        jump walk(%at.add(1))

    block close():
        write_str(#out, "\"")
        return()

routine Byte.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, "b'")
        write_escaped_byte(#out, %self, b'\'', false)
        write_str(#out, "'")
        return()

/// ASCII goes through the byte escapes; any other character is written as its
/// UTF-8.
routine Char.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, "'")
        %code  : U32  = %self.to_u32()
        %ascii : Bool = %code.lt(128)
        branch %ascii ? ascii(%code) : wide()

    block ascii(%code: U32):
        %byte : Byte = %code.to_u8().bits()
        write_escaped_byte(#out, %byte, b'\'', false)
        jump close()

    block wide():
        %self.represent(#out)
        jump close()

    block close():
        write_str(#out, "'")
        return()

// -- values that read the same both ways ---------------------------------------

routine Bool.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(#out)
        return()

routine Unit.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, "Unit")
        return()

routine Addr.diagnose<W>(#self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        #self.represent(#out)
        return()

routine Ptr<T>.diagnose<W>(#self: Self, #out: Ptr<W>) -> Void
require T: typename, W: typename, Writer<W>
    block entry():
        #self.represent(#out)
        return()

// -- Option and Result ---------------------------------------------------------

routine Option<T>.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry():
        %tag : Bool = %self.tag
        branch %tag ? present() : absent()

    block present():
        write_str(#out, ".present(")
        %value : T = %self.value
        %value.diagnose(#out)
        write_str(#out, ")")
        return()

    block absent():
        write_str(#out, ".absent")
        return()

routine Result<T, E>.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require T: typename, Diagnose<T>, E: typename, Diagnose<E>, W: typename, Writer<W>
    block entry():
        %tag : Bool = %self.tag
        branch %tag ? success() : failure()

    block success():
        write_str(#out, ".success(")
        %value : T = %self.value
        %value.diagnose(#out)
        write_str(#out, ")")
        return()

    block failure():
        write_str(#out, ".failure(")
        %error : E = %self.error
        %error.diagnose(#out)
        write_str(#out, ")")
        return()

// -- arrays --------------------------------------------------------------------

routine Array<T, N>.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require T: typename, N: U64, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim #slot : Ptr<Self>
        #slot.store(%self)
        write_str(#out, "[")
        jump walk(0, #slot)

    block walk(%at: U64, #slot: Ptr<Self>):
        %more : Bool = %at.lt(N)
        branch %more ? item(%at, #slot) : close()

    block item(%at: U64, #slot: Ptr<Self>):
        %first : Bool = %at.eq(0)
        branch %first ? element(%at, #slot) : separate(%at, #slot)

    block separate(%at: U64, #slot: Ptr<Self>):
        write_str(#out, ", ")
        jump element(%at, #slot)

    block element(%at: U64, #slot: Ptr<Self>):
        %value : T = #slot.get(%at)
        %value.diagnose(#out)
        jump walk(%at.add(1), #slot)

    block close():
        write_str(#out, "]")
        return()

// -- numbers -------------------------------------------------------------------
//
// A number's decimal text is already its literal (floats keep a .0 or an
// exponent), so diagnose is represent.

routine S8.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(#out)
        return()

routine S16.diagnose<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %self.represent(#out)
        return()

