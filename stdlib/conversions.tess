// Tessera stdlib: generic IR operation member methods
//
// Only truly type-agnostic casts live here. Integer comparisons/arithmetic
// and float comparisons/arithmetic are type-specific and live on their
// respective types.

module Standard::Core

// -- casts ---------------------------------------------------------------------

routine T.bitcast<U>(%self: T) -> U
require T: typename, U: typename
    block entry():
        %r : U = bitcast<T, U>(%self)
        return(%r)

routine T.trunc<U>(%self: T) -> U
require T: typename, U: typename
    block entry():
        %r : U = trunc<T, U>(%self)
        return(%r)
