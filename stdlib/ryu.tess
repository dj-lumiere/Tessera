; Tessera stdlib: Ryu shortest float-to-decimal
;
; A port of Ryu (Ulf Adams, https://github.com/ulfjack/ryu, Apache 2.0 or
; Boost 1.0). For a binary float it finds the decimal with the fewest digits
; that reads back to the same float, and of those the one closest to the exact
; value. The result is FloatDecimal: value = digits × 10^exponent.
;
;   ryu_double_decimal  F64 (d2s.c): 128-bit multipliers
;   ryu_float_decimal   F32, and F16 / BF16 through the same code (f2s.c):
;                       64-bit multipliers taken from the high words of the
;                       F64 tables, with the format's mantissa bits and bias
;                       passed in. Every F16 and BF16 value is an F32 value, so
;                       their exponents stay inside the F32 table range.
;
; Both take the IEEE fields of a finite, nonzero value; zero, infinity, and NaN
; are the caller's job. All arithmetic is on nonnegative I64 values below 2^63,
; so signed and unsigned operations agree except where noted.

struct FloatDecimal
    digits:   I64
    exponent: I64

; The state of digit removal: the scaled value vr and the interval ends vp, vm.
struct RyuDigits
    vr:       I64
    vp:       I64
    vm:       I64
    removed:  I64
    last:     I64       ; the last digit removed from vr
    vm_zeros: Bool      ; everything removed from vm so far was 0
    vr_zeros: Bool      ; everything removed from vr before `last` was 0

; -- helpers -------------------------------------------------------------------

; floor(log2(5^e)) + 1, for 0 <= e <= 3528
routine ryu_pow5bits(%e: I64) -> I64
    block entry():
        %r: I64 = %e.mul(1217359).lshr(19).add(1)
        return(%r)

; floor(log10(2^e)), for 0 <= e <= 1650
routine ryu_log10_pow2(%e: I64) -> I64
    block entry():
        %r: I64 = %e.mul(78913).lshr(18)
        return(%r)

; floor(log10(5^e)), for 0 <= e <= 2620
routine ryu_log10_pow5(%e: I64) -> I64
    block entry():
        %r: I64 = %e.mul(732923).lshr(20)
        return(%r)

; Is %value (nonzero) divisible by 5^p?
routine ryu_multiple_of_pow5(%value: I64, %p: I64) -> Bool
    block entry():
        jump count(%value, 0)

    block count(%rest: I64, %found: I64):
        %enough: Bool = %found.sge(%p)
        %divides: Bool = %rest.urem(5).eq(0)
        %go_on: Bool = %divides.bitand(%enough.bitnot())
        branch %go_on ? count(%rest.udiv(5), %found.add(1)) : return(%enough)

; Is %value divisible by 2^p (p < 63)?
routine ryu_multiple_of_pow2(%value: I64, %p: I64) -> Bool
    block entry():
        %mask: I64  = 1.shl(%p).sub(1)
        %r:    Bool = %value.bitand(%mask).eq(0)
        return(%r)

; floor(m × factor / 2^shift), with factor read as unsigned 64-bit and m < 2^32
routine ryu_mul_shift32(%m: I64, %factor: I64, %shift: I64) -> I64
    block entry():
        %product: I128 = %m.to_u128().mul(%factor.to_u128())
        %r:       I64  = %product.lshr(%shift.to_i128()).to_i64()
        return(%r)

; floor(m × W / 2^shift) for the 128-bit W = high:low, with m < 2^55 and shift > 64
routine ryu_mul_shift64(%m: I64, %low: I64, %high: I64, %shift: I64) -> I64
    block entry():
        %wide: I128 = %m.to_u128()
        %b0:   I128 = %wide.mul(%low.to_u128())
        %b2:   I128 = %wide.mul(%high.to_u128())
        %sum:  I128 = %b0.lshr(64).add(%b2)
        %r:    I64  = %sum.lshr(%shift.sub(64).to_i128()).to_i64()
        return(%r)

; -- digit removal -------------------------------------------------------------

; Can one more digit go? Only while the interval still holds a shorter number,
; and never past the last digit of vr: Ryu would round a lone 0 up to 1 at the
; next power of ten, which is no shorter than vr and can be farther from the
; value (BF16's smallest subnormal, 9.18e-41, would print as 1e-40, not 9e-41).
; Stopping there changes no F32 or F64 output; F16 and BF16 were checked
; exhaustively.
routine ryu_can_remove(%vr: I64, %vp: I64, %vm: I64) -> Bool
    block entry():
        %shorter:  Bool = %vp.udiv(10).ugt(%vm.udiv(10))
        %two_plus: Bool = %vr.uge(10)
        %r:        Bool = %shorter.bitand(%two_plus)
        return(%r)

; Removes digits while the interval [vm, vp] still holds a shorter number,
; then rounds vr. %accept says whether the interval ends themselves read back
; to the float (they do when its mantissa is even).
routine ryu_shorten(%start: RyuDigits, %accept: Bool, %e10: I64) -> FloatDecimal
    block entry():
        %vm_zeros: Bool = %start.vm_zeros
        %vr_zeros: Bool = %start.vr_zeros
        %careful:  Bool = %vm_zeros.bitor(%vr_zeros)
        branch %careful ? careful(%start) : fast(%start)

    ; The usual case: no trailing zeros to track, round on the last removed digit.
    block fast(%s: RyuDigits):
        %vr: I64  = %s.vr
        %vp: I64  = %s.vp
        %vm: I64  = %s.vm
        %more: Bool = ryu_can_remove(%vr, %vp, %vm)
        branch %more ? fast_step(%s) : fast_done(%s)

    block fast_step(%s: RyuDigits):
        %vr: I64 = %s.vr
        %vp: I64 = %s.vp
        %vm: I64 = %s.vm
        %removed: I64 = %s.removed
        %next: RyuDigits = RyuDigits {
            vr: %vr.udiv(10), vp: %vp.udiv(10), vm: %vm.udiv(10), removed: %removed.add(1),
            last: %vr.urem(10), vm_zeros: false, vr_zeros: false
        }
        jump fast(%next)

    block fast_done(%s: RyuDigits):
        %vr:   I64  = %s.vr
        %vm:   I64  = %s.vm
        %last: I64  = %s.last
        %at_low:   Bool = %vr.eq(%vm)
        %round_up: Bool = %last.sge(5)
        %bump:     Bool = %at_low.bitor(%round_up)
        jump finish(%vr.add(%bump.to_i64()), %s.removed)

    ; Some removed digits may all be zero: track that, so an exact tie rounds to
    ; even and vm may be used when it is exactly representable.
    block careful(%s: RyuDigits):
        %vr: I64 = %s.vr
        %vp: I64 = %s.vp
        %vm: I64 = %s.vm
        %more: Bool = ryu_can_remove(%vr, %vp, %vm)
        branch %more ? careful_step(%s) : trim_vm(%s)

    block careful_step(%s: RyuDigits):
        %vr: I64 = %s.vr
        %vp: I64 = %s.vp
        %vm: I64 = %s.vm
        %last:     I64  = %s.last
        %removed:  I64  = %s.removed
        %vm_digit: I64  = %vm.urem(10)
        %vm_zeros: Bool = %s.vm_zeros
        %vr_zeros: Bool = %s.vr_zeros
        %next: RyuDigits = RyuDigits {
            vr: %vr.udiv(10), vp: %vp.udiv(10), vm: %vm.udiv(10), removed: %removed.add(1),
            last: %vr.urem(10),
            vm_zeros: %vm_zeros.bitand(%vm_digit.eq(0)),
            vr_zeros: %vr_zeros.bitand(%last.eq(0))
        }
        jump careful(%next)

    ; vm ends in zeros that can go too, as long as it is exactly representable.
    block trim_vm(%s: RyuDigits):
        %vm_zeros: Bool = %s.vm_zeros
        branch %vm_zeros ? trim_check(%s) : careful_done(%s)

    block trim_check(%s: RyuDigits):
        %vm: I64 = %s.vm
        %zero: Bool = %vm.urem(10).eq(0)
        branch %zero ? trim_step(%s) : careful_done(%s)

    block trim_step(%s: RyuDigits):
        %vr: I64 = %s.vr
        %vp: I64 = %s.vp
        %vm: I64 = %s.vm
        %last:     I64  = %s.last
        %removed:  I64  = %s.removed
        %vr_zeros: Bool = %s.vr_zeros
        %next: RyuDigits = RyuDigits {
            vr: %vr.udiv(10), vp: %vp.udiv(10), vm: %vm.udiv(10), removed: %removed.add(1),
            last: %vr.urem(10), vm_zeros: true, vr_zeros: %vr_zeros.bitand(%last.eq(0))
        }
        jump trim_check(%next)

    block careful_done(%s: RyuDigits):
        %vr:       I64  = %s.vr
        %vm:       I64  = %s.vm
        %last:     I64  = %s.last
        %vm_zeros: Bool = %s.vm_zeros
        %vr_zeros: Bool = %s.vr_zeros
        ; exactly halfway (…5000…): round to even
        %half:      Bool = %vr_zeros.bitand(%last.eq(5))
        %vr_even:   Bool = %vr.bitand(1).eq(0)
        %tie_down:  Bool = %half.bitand(%vr_even)
        %rounding:  I64  = %tie_down ? 4 : %last
        ; vr sits on vm but vm itself doesn't read back: step up
        %vm_usable: Bool = %accept.bitand(%vm_zeros)
        %at_low:    Bool = %vr.eq(%vm).bitand(%vm_usable.bitnot())
        %round_up:  Bool = %rounding.sge(5)
        %bump:      Bool = %at_low.bitor(%round_up)
        jump finish(%vr.add(%bump.to_i64()), %s.removed)

    ; Rounding 9 up gives 10: write it as 1 at the next exponent.
    block finish(%digits: I64, %removed: I64):
        %carry:    Bool = %digits.eq(10)
        %shortest: I64  = %carry ? 1 : %digits
        %exponent: I64  = %e10.add(%removed).add(%carry.to_i64())
        %r: FloatDecimal = FloatDecimal { digits: %shortest, exponent: %exponent }
        return(%r)

; -- F64 (d2s) -----------------------------------------------------------------

; %mantissa and %exponent are the raw IEEE fields of a finite, nonzero F64.
routine ryu_double_decimal(%mantissa: I64, %exponent: I64) -> FloatDecimal
    block entry():
        %subnormal: Bool = %exponent.eq(0)
        %normal_m2: I64  = %mantissa.bitor(4503599627370496)        ; 2^52
        %m2:        I64  = %subnormal ? %mantissa : %normal_m2
        %biased:    I64  = %subnormal ? 1 : %exponent
        %e2:        I64  = %biased.sub(1023).sub(52).sub(2)
        %accept:    Bool = %m2.bitand(1).eq(0)
        %mv:        I64  = %m2.mul(4)
        ; the gap below is half as wide at the bottom of a binade
        %mm_shift_b: Bool = %mantissa.ne(0).bitor(%exponent.sle(1))
        %mm_shift:   I64  = %mm_shift_b.to_i64()
        %nonneg: Bool = %e2.sge(0)
        branch %nonneg ? scale_down(%e2, %mv, %mm_shift, %accept) : scale_up(%e2, %mv, %mm_shift, %accept)

    ; e2 >= 0: multiply by 2^e2 / 10^q through the inverse table.
    block scale_down(%e2: I64, %mv: I64, %mm_shift: I64, %accept: Bool):
        %above3: Bool = %e2.sgt(3)
        %q:      I64  = ryu_log10_pow2(%e2).sub(%above3.to_i64())
        %k:      I64  = 125.add(ryu_pow5bits(%q)).sub(1)
        %i:      I64  = %q.add(%k).sub(%e2)
        %lo_at:  I64  = %q.mul(2)
        %hi_at:  I64  = %lo_at.add(1)
        %lo:     I64  := RYU_POW5_INV[%lo_at]
        %hi:     I64  := RYU_POW5_INV[%hi_at]
        %mp:     I64  = %mv.add(2)
        %mm:     I64  = %mv.sub(1).sub(%mm_shift)
        %vr:     I64  = ryu_mul_shift64(%mv, %lo, %hi, %i)
        %vp:     I64  = ryu_mul_shift64(%mp, %lo, %hi, %i)
        %vm:     I64  = ryu_mul_shift64(%mm, %lo, %hi, %i)
        ; For small q, the scaled values may be exact: check for 5^q factors.
        %small:    Bool = %q.sle(21)
        %mv_by_5:  Bool = %mv.urem(5).eq(0)
        %not_by_5: Bool = %mv_by_5.bitnot()
        %vr_exact: Bool = %small.bitand(%mv_by_5).bitand(ryu_multiple_of_pow5(%mv, %q))
        %mm_case:  Bool = %small.bitand(%not_by_5).bitand(%accept)
        %vm_exact: Bool = %mm_case.bitand(ryu_multiple_of_pow5(%mm, %q))
        %mp_case:  Bool = %small.bitand(%not_by_5).bitand(%accept.bitnot())
        %vp_exact: Bool = %mp_case.bitand(ryu_multiple_of_pow5(%mp, %q))
        %vp_fixed: I64  = %vp.sub(%vp_exact.to_i64())
        %digits: RyuDigits = RyuDigits {
            vr: %vr, vp: %vp_fixed, vm: %vm, removed: 0, last: 0, vm_zeros: %vm_exact, vr_zeros: %vr_exact
        }
        %r: FloatDecimal = ryu_shorten(%digits, %accept, %q)
        return(%r)

    ; e2 < 0: multiply by 5^-e2 / 2^j through the power table.
    block scale_up(%e2: I64, %mv: I64, %mm_shift: I64, %accept: Bool):
        %neg_e2: I64  = 0.sub(%e2)
        %above1: Bool = %neg_e2.sgt(1)
        %q:      I64  = ryu_log10_pow5(%neg_e2).sub(%above1.to_i64())
        %e10:    I64  = %q.add(%e2)
        %i:      I64  = %neg_e2.sub(%q)
        %k:      I64  = ryu_pow5bits(%i).sub(125)
        %j:      I64  = %q.sub(%k)
        %lo_at:  I64  = %i.mul(2)
        %hi_at:  I64  = %lo_at.add(1)
        %lo:     I64  := RYU_POW5[%lo_at]
        %hi:     I64  := RYU_POW5[%hi_at]
        %mp:     I64  = %mv.add(2)
        %mm:     I64  = %mv.sub(1).sub(%mm_shift)
        %vr:     I64  = ryu_mul_shift64(%mv, %lo, %hi, %j)
        %vp:     I64  = ryu_mul_shift64(%mp, %lo, %hi, %j)
        %vm:     I64  = ryu_mul_shift64(%mm, %lo, %hi, %j)
        %tiny:   Bool = %q.sle(1)
        branch %tiny ? tiny_q(%vr, %vp, %vm, %e10, %mm_shift, %accept)
                     : wide_q(%vr, %vp, %vm, %e10, %mv, %q, %accept)

    ; q <= 1: vr is exact; vm is exact when the gap below is a full one.
    block tiny_q(%vr: I64, %vp: I64, %vm: I64, %e10: I64, %mm_shift: I64, %accept: Bool):
        %vm_exact: Bool = %accept.bitand(%mm_shift.eq(1))
        %vp_fixed: I64  = %accept ? %vp : %vp.sub(1)
        %digits: RyuDigits = RyuDigits {
            vr: %vr, vp: %vp_fixed, vm: %vm, removed: 0, last: 0, vm_zeros: %vm_exact, vr_zeros: true
        }
        %r: FloatDecimal = ryu_shorten(%digits, %accept, %e10)
        return(%r)

    ; vr is exact when mv has at least q trailing zero bits.
    block wide_q(%vr: I64, %vp: I64, %vm: I64, %e10: I64, %mv: I64, %q: I64, %accept: Bool):
        %checkable: Bool = %q.slt(63)
        %shift:     I64  = %q.min(62)
        %vr_exact:  Bool = %checkable.bitand(ryu_multiple_of_pow2(%mv, %shift))
        %digits: RyuDigits = RyuDigits {
            vr: %vr, vp: %vp, vm: %vm, removed: 0, last: 0, vm_zeros: false, vr_zeros: %vr_exact
        }
        %r: FloatDecimal = ryu_shorten(%digits, %accept, %e10)
        return(%r)

; -- F32, F16, BF16 (f2s) ------------------------------------------------------

; %mantissa and %exponent are the raw IEEE fields of a finite, nonzero value of
; a format with %mantissa_bits stored mantissa bits and exponent bias %bias.
routine ryu_float_decimal(%mantissa: I64, %exponent: I64, %mantissa_bits: I64, %bias: I64) -> FloatDecimal
    block entry():
        %subnormal: Bool = %exponent.eq(0)
        %hidden:    I64  = 1.shl(%mantissa_bits)
        %normal_m2: I64  = %mantissa.bitor(%hidden)
        %m2:        I64  = %subnormal ? %mantissa : %normal_m2
        %biased:    I64  = %subnormal ? 1 : %exponent
        %e2:        I64  = %biased.sub(%bias).sub(%mantissa_bits).sub(2)
        %accept:    Bool = %m2.bitand(1).eq(0)
        %mv:        I64  = %m2.mul(4)
        %mm_shift_b: Bool = %mantissa.ne(0).bitor(%exponent.sle(1))
        %mm_shift:   I64  = %mm_shift_b.to_i64()
        %nonneg: Bool = %e2.sge(0)
        branch %nonneg ? scale_down(%e2, %mv, %mm_shift, %accept) : scale_up(%e2, %mv, %mm_shift, %accept)

    block scale_down(%e2: I64, %mv: I64, %mm_shift: I64, %accept: Bool):
        %q:      I64  = ryu_log10_pow2(%e2)
        %k:      I64  = 61.add(ryu_pow5bits(%q)).sub(1)
        %i:      I64  = %q.add(%k).sub(%e2)
        %hi_at:  I64  = %q.mul(2).add(1)
        %hi:     I64  := RYU_POW5_INV[%hi_at]
        %factor: I64  = %hi.add(1)
        %mp:     I64  = %mv.add(2)
        %mm:     I64  = %mv.sub(1).sub(%mm_shift)
        %vr:     I64  = ryu_mul_shift32(%mv, %factor, %i)
        %vp:     I64  = ryu_mul_shift32(%mp, %factor, %i)
        %vm:     I64  = ryu_mul_shift32(%mm, %factor, %i)
        %small:    Bool = %q.sle(9)
        %mv_by_5:  Bool = %mv.urem(5).eq(0)
        %not_by_5: Bool = %mv_by_5.bitnot()
        %vr_exact: Bool = %small.bitand(%mv_by_5).bitand(ryu_multiple_of_pow5(%mv, %q))
        %mm_case:  Bool = %small.bitand(%not_by_5).bitand(%accept)
        %vm_exact: Bool = %mm_case.bitand(ryu_multiple_of_pow5(%mm, %q))
        %mp_case:  Bool = %small.bitand(%not_by_5).bitand(%accept.bitnot())
        %vp_exact: Bool = %mp_case.bitand(ryu_multiple_of_pow5(%mp, %q))
        %vp_fixed: I64  = %vp.sub(%vp_exact.to_i64())
        ; f2s also needs the digit just below vr, in case nothing gets removed
        %narrow: Bool = %q.ne(0).bitand(%vp.sub(1).udiv(10).ule(%vm.udiv(10)))
        branch %narrow ? down_digit(%vr, %vp_fixed, %vm, %q, %e2, %mv, %vm_exact, %vr_exact, %accept)
                       : shorten(%vr, %vp_fixed, %vm, %q, 0, %vm_exact, %vr_exact, %accept)

    block down_digit(
        %vr: I64, %vp: I64, %vm: I64, %q: I64, %e2: I64, %mv: I64,
        %vm_exact: Bool, %vr_exact: Bool, %accept: Bool
    ):
        %q1:     I64 = %q.sub(1)
        %l:      I64 = 61.add(ryu_pow5bits(%q1)).sub(1)
        %hi_at:  I64 = %q1.mul(2).add(1)
        %hi:     I64 := RYU_POW5_INV[%hi_at]
        %shift:  I64 = %q1.add(%l).sub(%e2)
        %digit:  I64 = ryu_mul_shift32(%mv, %hi.add(1), %shift).urem(10)
        jump shorten(%vr, %vp, %vm, %q, %digit, %vm_exact, %vr_exact, %accept)

    block scale_up(%e2: I64, %mv: I64, %mm_shift: I64, %accept: Bool):
        %neg_e2: I64 = 0.sub(%e2)
        %q:      I64 = ryu_log10_pow5(%neg_e2)
        %e10:    I64 = %q.add(%e2)
        %i:      I64 = %neg_e2.sub(%q)
        %k:      I64 = ryu_pow5bits(%i).sub(61)
        %j:      I64 = %q.sub(%k)
        %hi_at:  I64 = %i.mul(2).add(1)
        %factor: I64 := RYU_POW5[%hi_at]
        %mp:     I64 = %mv.add(2)
        %mm:     I64 = %mv.sub(1).sub(%mm_shift)
        %vr:     I64 = ryu_mul_shift32(%mv, %factor, %j)
        %vp:     I64 = ryu_mul_shift32(%mp, %factor, %j)
        %vm:     I64 = ryu_mul_shift32(%mm, %factor, %j)
        %narrow: Bool = %q.ne(0).bitand(%vp.sub(1).udiv(10).ule(%vm.udiv(10)))
        branch %narrow ? up_digit(%vr, %vp, %vm, %q, %e10, %i, %mv, %mm_shift, %accept)
                       : up_zeros(%vr, %vp, %vm, %q, %e10, 0, %mv, %mm_shift, %accept)

    block up_digit(
        %vr: I64, %vp: I64, %vm: I64, %q: I64, %e10: I64, %i: I64, %mv: I64,
        %mm_shift: I64, %accept: Bool
    ):
        %i1:     I64 = %i.add(1)
        %shift:  I64 = %q.sub(1).sub(ryu_pow5bits(%i1).sub(61))
        %hi_at:  I64 = %i1.mul(2).add(1)
        %factor: I64 := RYU_POW5[%hi_at]
        %digit:  I64 = ryu_mul_shift32(%mv, %factor, %shift).urem(10)
        jump up_zeros(%vr, %vp, %vm, %q, %e10, %digit, %mv, %mm_shift, %accept)

    block up_zeros(
        %vr: I64, %vp: I64, %vm: I64, %q: I64, %e10: I64, %digit: I64, %mv: I64,
        %mm_shift: I64, %accept: Bool
    ):
        %tiny:      Bool = %q.sle(1)
        %vm_exact:  Bool = %tiny.bitand(%accept).bitand(%mm_shift.eq(1))
        %vp_down:   Bool = %tiny.bitand(%accept.bitnot())
        %vp_fixed:  I64  = %vp.sub(%vp_down.to_i64())
        %checkable: Bool = %tiny.bitnot().bitand(%q.slt(31))
        %shift:     I64  = %q.sub(1).max(0)
        %by_2:      Bool = %checkable.bitand(ryu_multiple_of_pow2(%mv, %shift))
        %vr_exact:  Bool = %tiny.bitor(%by_2)
        jump shorten(%vr, %vp_fixed, %vm, %e10, %digit, %vm_exact, %vr_exact, %accept)

    block shorten(
        %vr: I64, %vp: I64, %vm: I64, %e10: I64, %digit: I64,
        %vm_exact: Bool, %vr_exact: Bool, %accept: Bool
    ):
        %digits: RyuDigits = RyuDigits {
            vr: %vr, vp: %vp, vm: %vm, removed: 0, last: %digit, vm_zeros: %vm_exact, vr_zeros: %vr_exact
        }
        %r: FloatDecimal = ryu_shorten(%digits, %accept, %e10)
        return(%r)
