/// Whether self, rounded toward zero, lies in [%lo, %hi). False for NaN.
routine F32.fits_int(%self: Self, %lo: Self, %hi: Self) -> Bool
    block entry():
        %whole : Self = ftrunc<Self>(%self)
        %r     : Bool = %whole.in_range(%lo, %hi)
        return(%r)
