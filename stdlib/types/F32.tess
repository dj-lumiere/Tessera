// Tessera stdlib: F32 — 32-bit IEEE 754 floating-point
//
// Maps to LLVM IR float.

module Standard::Core

#llvm("float")
record F32
conform Equal<F32>, Compare<F32>, Hash<F32>

// -- constants -----------------------------------------------------------------

preset F32.INFINITY:     F32 = F32.from_bits(0x7F800000)  // +inf bits
preset F32.NEG_INFINITY: F32 = F32.from_bits(0xFF800000)  // -inf bits
preset F32.NAN:          F32 = F32.from_bits(0x7FC00000)  // canonical quiet NaN bits

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine F32.abs(%self: Self) -> Self
    block entry():
        %r : Self = fabs<Self>(%self)
        return(%r)

/// The smaller value; if one operand is NaN, the other one.
routine F32.min(%self: Self, %other: Self) -> Self
    block entry():
        %self_nan  : Bool = %self.is_nan()
        %other_nan : Bool = %other.is_nan()
        %both      : Bool = %self_nan.bitand(%other_nan)
        when:
            %both      -> return(%self.add(%other))
            %self_nan  -> return(%other)
            %other_nan -> return(%self)
            else       -> compare()

    // no minnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare():
        %pick : Bool = %self.le(%other)
        %r    : Self = %pick
            ? %self
            : %other
        return(%r)

/// The larger value; if one operand is NaN, the other one.
routine F32.max(%self: Self, %other: Self) -> Self
    block entry():
        %self_nan  : Bool = %self.is_nan()
        %other_nan : Bool = %other.is_nan()
        %both      : Bool = %self_nan.bitand(%other_nan)
        when:
            %both      -> return(%self.add(%other))
            %self_nan  -> return(%other)
            %other_nan -> return(%self)
            else       -> compare()

    // no maxnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare():
        %pick : Bool = %self.ge(%other)
        %r    : Self = %pick
            ? %self
            : %other
        return(%r)

routine F32.add(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fadd<Self>(%self, %other)
        return(%r)

routine F32.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fsub<Self>(%self, %other)
        return(%r)

routine F32.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fmul<Self>(%self, %other)
        return(%r)

// -- comparisons ---------------------------------------------------------------

routine F32.lt(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = flt<Self>(%self, %other)
        return(%r)

routine F32.le(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fle<Self>(%self, %other)
        return(%r)

routine F32.gt(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fgt<Self>(%self, %other)
        return(%r)

routine F32.ge(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fge<Self>(%self, %other)
        return(%r)

// -- division ------------------------------------------------------------------

routine F32.div(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fdiv<Self>(%self, %other)
        return(%r)

// -- equality, ordering, hashing -----------------------------------------------

routine F32.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = feq<Self>(%self, %other)
        return(%r)

routine F32.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fne<Self>(%self, %other)
        return(%r)

routine F32.compare(%self: Self, %other: Self) -> S32
    block entry():
        %lt : Bool = %self.lt(%other)
        branch %lt
            ? return(-1)
            : continue
        %gt : Bool = %self.gt(%other)
        branch %gt
            ? return(1)
            : return(0)

routine F32.hash(%self: Self) -> U64
    block entry():
        %h : U64 = xxh64_hash_u64(%self.bits().to_u64(), 0)
        return(%h)

// -- named widening conversion -------------------------------------------------

routine F32.to_f64(%self: Self) -> F64
    block entry():
        %result : F64 = fpext<Self, F64>(%self)
        return(%result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

preset F32.MAX:          F32 = F32.from_bits(0x7F7FFFFF)  // largest finite value
preset F32.MIN:          F32 = F32.from_bits(0xFF7FFFFF)  // most negative finite value
preset F32.MIN_POSITIVE: F32 = F32.from_bits(0x00800000)  // smallest positive normal value
preset F32.EPSILON:      F32 = F32.from_bits(0x34000000)  // the gap between 1.0 and the next value

preset F32.PI: F32 = 3.14159265358979323846264338327950288  // pi
preset F32.TAU: F32 = 6.28318530717958647692528676655900577  // 2 pi
preset F32.E: F32 = 2.71828182845904523536028747135266250  // Euler's number
preset F32.FRAC_PI_2: F32 = 1.57079632679489661923132169163975144  // pi / 2
preset F32.FRAC_PI_4: F32 = 0.785398163397448309615660845819875721  // pi / 4
preset F32.FRAC_1_PI: F32 = 0.318309886183790671537767526745028724  // 1 / pi
preset F32.SQRT_2: F32 = 1.41421356237309504880168872420969808  // sqrt(2)
preset F32.FRAC_1_SQRT_2: F32 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
preset F32.LN_2: F32 = 0.693147180559945309417232121458176568  // ln(2)
preset F32.LN_10: F32 = 2.30258509299404568401799145468436421  // ln(10)
preset F32.LOG2_E: F32 = 1.44269504088896340735992468100189214  // log2(e)
preset F32.LOG10_E: F32 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

routine F32.neg(%self: Self) -> Self
    block entry():
        %r : Self = fneg<Self>(%self)
        return(%r)

/// The magnitude of self with the sign of %sign.
routine F32.copysign(%self: Self, %sign: Self) -> Self
    block entry():
        %r : Self = copysign<Self>(%self, %sign)
        return(%r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine F32.signum(%self: Self) -> Self
    block entry():
        %nan  : Bool = %self.is_nan()
        %unit : Self = copysign<Self>(1.0, %self)
        %r    : Self = %nan
            ? %self
            : %unit
        return(%r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine F32.is_sign_positive(%self: Self) -> Bool
    block entry():
        %bits : S32  = %self.bits().to_s32_wrap()
        %r    : Bool = %bits.ge(0)
        return(%r)

routine F32.is_sign_negative(%self: Self) -> Bool
    block entry():
        %bits : S32  = %self.bits().to_s32_wrap()
        %r    : Bool = %bits.lt(0)
        return(%r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of self / other, with the sign of self (C fmod; Rust's %). Exact: F64's remainder of the
/// same values is an F32.
routine F32.mod(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = %self.to_f64().mod(%other.to_f64()).to_f32()
        return(%r)

routine F32.recip(%self: Self) -> Self
    block entry():
        %r : Self = fdiv<Self>(1.0, %self)
        return(%r)

/// self * a + b with a single rounding: the FMA instruction where the CPU has one (every AArch64, x86 with the
/// fma feature, as in --cpu x86-64-v3), mul_add_soft elsewhere.
#target(arch: "aarch64")
routine F32.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r : Self = fma<Self>(%self, %a, %b)
        return(%r)

#[target(arch: "x86_64"), feature("fma")]
routine F32.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r : Self = fma<Self>(%self, %a, %b)
        return(%r)

#[target(arch: "x86_64"), feature(not "fma")]
routine F32.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r : Self = %self.mul_add_soft(%a, %b)
        return(%r)

#target(arch: not "aarch64", arch: not "x86_64")
routine F32.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r : Self = %self.mul_add_soft(%a, %b)
        return(%r)

/// self * a + b with a single rounding, without an FMA instruction.
///
/// Without one LLVM calls libm's fmaf, so this adds the exact F64 product with round-to-odd
/// (f64_add_round_to_odd) and narrows once, as F16's mul_add does.
private routine F32.mul_add_soft(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %product : F64  = %self.to_f64().mul(%a.to_f64())
        %sum     : F64  = f64_add_round_to_odd(%product, %b.to_f64())
        %r       : Self = %sum.to_f32()
        return(%r)

/// The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine F32.div_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %q            : Self = %self.div(%other).trunc()
        %rem          : Self = %self.mod(%other)
        %rem_negative : Bool = %rem.lt(0.0)
        branch %rem_negative
            ? continue
            : return(%q)
        %positive_divisor : Bool = %other.gt(0.0)
        %down             : Self = %q.sub(1.0)
        %up               : Self = %q.add(1.0)
        %r                : Self = %positive_divisor
            ? %down
            : %up
        return(%r)

/// The least non-negative remainder of self / other.
routine F32.mod_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %rem          : Self = %self.mod(%other)
        %rem_negative : Bool = %rem.lt(0.0)
        branch %rem_negative
            ? continue
            : return(%rem)
        %magnitude : Self = %other.abs()
        %r         : Self = %rem.add(%magnitude)
        return(%r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine F32.minimum(%self: Self, %other: Self) -> Self
    block entry():
        %nan : Bool = %self.is_nan().bitor(%other.is_nan())
        branch %nan
            ? return(%self.add(%other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        %equal : Bool = %self.eq(%other)
        branch %equal
            ? return(Self.from_bits(%self.bits().bitor(%other.bits())))
            : continue
        %pick : Bool = %self.lt(%other)
        %r    : Self = %pick
            ? %self
            : %other
        return(%r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine F32.maximum(%self: Self, %other: Self) -> Self
    block entry():
        %nan : Bool = %self.is_nan().bitor(%other.is_nan())
        branch %nan
            ? return(%self.add(%other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        %equal : Bool = %self.eq(%other)
        branch %equal
            ? return(Self.from_bits(%self.bits().bitand(%other.bits())))
            : continue
        %pick : Bool = %self.gt(%other)
        %r    : Self = %pick
            ? %self
            : %other
        return(%r)

/// Restricts self to %lo ..= %hi; NaN stays NaN. Traps unless %lo <= %hi.
routine F32.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid : Bool = %lo.le(%hi)
        branch %valid
            ? clamp()
            : panic(TrapCode.InvalidArgument)

    block clamp():
        %below : Bool = %self.lt(%lo)
        %above : Bool = %self.gt(%hi)
        %upper : Self = %above
            ? %hi
            : %self
        %r : Self = %below
            ? %lo
            : %upper
        return(%r)

/// %self in [%lo, %hi], both ends included. False when %lo > %hi.
routine F32.between(%self: Self, %lo: Self, %hi: Self) -> Bool
    block entry():
        %r : Bool = %self.ge(%lo).bitand(%self.le(%hi))
        return(%r)

/// %self in [%lo, %end): %lo included, %end not. False when %lo >= %end.
routine F32.in_range(%self: Self, %lo: Self, %end: Self) -> Bool
    block entry():
        %r : Bool = %self.ge(%lo).bitand(%self.lt(%end))
        return(%r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine F32.total_compare(%self: Self, %other: Self) -> S32
    block entry():
        %a : S32 = %self.bits().to_s32_wrap()
        %b : S32 = %other.bits().to_s32_wrap()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        %a_key : S32 = %a.bitxor(%a.shr(31).bitand(S32.MAX))
        %b_key : S32 = %b.bitxor(%b.shr(31).bitand(S32.MAX))
        %r     : S32 = %a_key.compare(%b_key)
        return(%r)

// -- rounding ------------------------------------------------------------------

// AArch64 has an instruction for each; elsewhere LLVM calls libm (x86 before SSE4.1 has none), so the other
// targets work on the bits: trunc clears the fraction bits, and the rest adjust its result, all exactly.

#target(arch: "aarch64")
routine F32.floor(%self: Self) -> Self
    block entry():
        %r : Self = floor<Self>(%self)
        return(%r)

#target(arch: not "aarch64")
routine F32.floor(%self: Self) -> Self
    block entry():
        %t    : Self = %self.trunc()
        %down : Bool = %t.gt(%self)
        %r    : Self = %down
            ? %t.sub(1.0)
            : %t
        return(%r)

#target(arch: "aarch64")
routine F32.ceil(%self: Self) -> Self
    block entry():
        %r : Self = ceil<Self>(%self)
        return(%r)

#target(arch: not "aarch64")
routine F32.ceil(%self: Self) -> Self
    block entry():
        %t  : Self = %self.trunc()
        %up : Bool = %t.lt(%self)
        %r  : Self = %up
            ? %t.add(1.0)
            : %t
        return(%r)

/// Rounds half-way cases away from zero.
#target(arch: "aarch64")
routine F32.round(%self: Self) -> Self
    block entry():
        %r : Self = round<Self>(%self)
        return(%r)

/// Rounds half-way cases away from zero.
#target(arch: not "aarch64")
routine F32.round(%self: Self) -> Self
    block entry():
        %t        : Self = %self.trunc()
        %fraction : Self = %self.sub(%t)
        %half     : Bool = %fraction.abs().ge(0.5)
        %away     : Self = %t.add(Self.copysign(1.0, %self))
        %r        : Self = %half
            ? %away
            : %t
        return(%r)

/// Rounds half-way cases to the even neighbor.
#target(arch: "aarch64")
routine F32.round_ties_even(%self: Self) -> Self
    block entry():
        %r : Self = rint<Self>(%self)
        return(%r)

/// Rounds half-way cases to the even neighbor.
///
/// Below 2^23, adding and subtracting 2^23 leaves the magnitude rounded to an integer by the addition.
#target(arch: not "aarch64")
routine F32.round_ties_even(%self: Self) -> Self
    block entry():
        %magnitude : Self = %self.abs()
        %integral  : Bool = %magnitude.ge(8388608.0)
        branch %integral
            ? return(%self)
            : continue
        %rounded : Self = %magnitude.add(8388608.0).sub(8388608.0)
        %r       : Self = %rounded.copysign(%self)
        return(%r)

/// Rounds toward zero.
#target(arch: "aarch64")
routine F32.trunc(%self: Self) -> Self
    block entry():
        %r : Self = ftrunc<Self>(%self)
        return(%r)

/// Rounds toward zero.
#target(arch: not "aarch64")
routine F32.trunc(%self: Self) -> Self
    block entry():
        %bits      : U32  = %self.bits()
        %field     : U32  = %bits.shr(23).bitand(0xFF)
        %special   : Bool = %field.eq(0xFF)
        %integral  : Bool = %field.ge(150)
        %below_one : Bool = %field.lt(127)
        when:
            %special   -> return(%self.add(%self))
            %integral  -> return(%self)
            %below_one -> return(Self.from_bits(%bits.bitand(0x80000000)))
            else       -> fraction(%bits, %field)

    // 1 <= |self| < 2^23: the lowest 150 - field bits are the fraction
    block fraction(%bits: U32, %field: U32):
        %mask : U32  = 1.shl(U32.sub(150, %field)).sub(1)
        %r    : Self = Self.from_bits(%bits.bitand(%mask.bitnot()))
        return(%r)

/// self minus its integer part, with the sign of self.
routine F32.fract(%self: Self) -> Self
    block entry():
        %whole : Self = %self.trunc()
        %r     : Self = %self.sub(%whole)
        return(%r)

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in stdlib/f32_core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// NaN for negative values (other than -0.0).
routine F32.sqrt(%self: Self) -> Self
    block entry():
        %r : Self = sqrt<Self>(%self)
        return(%r)

/// self raised to an integer power, correctly rounded. An n of at most 2^24 in magnitude converts to F32
/// exactly and goes to powf. A larger one goes through the F64 power, whose rounding to F32 is correct unless it
/// lands exactly on an F32 midpoint; there the F128 power decides (checked for every x and n that reach it).
routine F32.powi(%self: Self, %n: S32) -> Self
    block entry():
        %small : Bool = %n.abs_diff(0).le(0x1000000)
        branch %small
            ? continue
            : wide()
        %r : Self = %self.powf(%n.to_f32())
        return(%r)

    block wide():
        %r   : F64  = %self.to_f64().powf(%n.to_f64())
        %tie : Bool = f32_on_midpoint_f64(%r)
        branch %tie
            ? exact()
            : return(%r.to_f32())

    block exact():
        %r : F128 = %self.to_f128().powf(%n.to_f128())
        return(%r.to_f32())

/// Whether %r lies exactly between two F32 values.
private routine f32_on_midpoint_f64(%r: F64) -> Bool
    block entry():
        %a   : F64  = %r.abs()
        %sub : Bool = %a.lt(0x1p-126)
        branch %sub
            ? subnormal(%a)
            : normal(%a)

    // F32 keeps 23 fraction bits: a midpoint has bit 28 set and nothing below it.
    block normal(%a: F64):
        %low : U64  = %a.bits().bitand(0x1FFFFFFF)
        %mid : Bool = %a.is_finite().bitand(%low.eq(0x10000000))
        return(%mid)

    // Below 2^-126 F32's quantum is 2^-149: a midpoint is an odd multiple of 2^-150.
    block subnormal(%a: F64):
        %t     : F64  = %a.mul(0x1p150)
        %whole : Bool = %t.trunc().eq(%t)
        %odd   : Bool = %t.mod(2.0).eq(1.0)
        return(%whole.bitand(%odd))

/// The logarithm with an arbitrary base.
routine F32.log(%self: Self, %base: Self) -> Self
    block entry():
        %num : Self = %self.ln()
        %den : Self = %base.ln()
        %r   : Self = %num.div(%den)
        return(%r)

// -- special functions ---------------------------------------------------------

routine F32.to_degrees(%self: Self) -> Self
    block entry():
        %r : Self = %self.mul(57.2957795130823208767981548141051703)
        return(%r)

routine F32.to_radians(%self: Self) -> Self
    block entry():
        %r : Self = %self.mul(0.0174532925199432957692369076848861271)
        return(%r)

// -- classification ------------------------------------------------------------

routine F32.is_nan(%self: Self) -> Bool
    block entry():
        %r : Bool = funo<Self>(%self, %self)
        return(%r)

routine F32.is_infinite(%self: Self) -> Bool
    block entry():
        %magnitude : Self = fabs<Self>(%self)
        %r         : Bool = %magnitude.eq(Self.INFINITY)
        return(%r)

/// Neither infinite nor NaN.
routine F32.is_finite(%self: Self) -> Bool
    block entry():
        %magnitude : Self = fabs<Self>(%self)
        %r         : Bool = %magnitude.lt(Self.INFINITY)
        return(%r)

/// Not zero, subnormal, infinite, or NaN.
routine F32.is_normal(%self: Self) -> Bool
    block entry():
        %exponent : U32  = %self.bits().bitand(0x7F800000)
        %r        : Bool = %exponent.ne(0).bitand(%exponent.ne(0x7F800000))
        return(%r)

routine F32.is_subnormal(%self: Self) -> Bool
    block entry():
        %bits     : U32  = %self.bits()
        %exponent : U32  = %bits.bitand(0x7F800000)
        %mantissa : U32  = %bits.bitand(0x007FFFFF)
        %r        : Bool = %exponent.eq(0).bitand(%mantissa.ne(0))
        return(%r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
routine F32.bits(%self: Self) -> U32
    block entry():
        %r : U32 = bitcast<Self, U32>(%self)
        return(%r)

routine F32.from_bits(%bits: U32) -> Self
    block entry():
        %r : Self = bitcast<U32, Self>(%bits)
        return(%r)

// -- float conversions -----------------------------------------------------------

/// Rounds to nearest, ties to even. Written with integer operations instead of
/// fptrunc, which calls compiler-rt's __truncsfhf2 (see F16's runtime support).
routine F32.to_f16(%self: Self) -> F16
    block entry():
        %bits      : U32 = %self.bits()
        %sign      : U16 = %bits.shr(16).to_u16().bitand(0x8000)
        %magnitude : U32 = %bits.bitand(0x7FFFFFFF)
        when:
            %magnitude.ge(0x7F800000) -> special(%sign, %magnitude)
            %magnitude.ge(0x477FF000) -> overflow(%sign)
            %magnitude.lt(0x38800000) -> subnormal(%sign, %magnitude)
            else                      -> normal(%sign, %magnitude)

    block overflow(%sign: U16):
        %r : F16 = .from_bits(%sign.bitor(0x7C00))
        return(%r)

    // Infinity stays infinity; NaN keeps its top payload bits and is made quiet.
    block special(%sign: U16, %magnitude: U32):
        %payload  : U16  = %magnitude.bitand(0x7FFFFF).shr(13).to_u16()
        %is_nan   : Bool = %magnitude.gt(0x7F800000)
        %nan_bits : U16  = %payload.bitor(0x7E00)
        %body     : U16  = %is_nan
            ? %nan_bits
            : 0x7C00
        %r : F16 = .from_bits(%sign.bitor(%body))
        return(%r)

    // Below F16's smallest normal: scale so one F16 subnormal step is 1.0, and
    // round to an integer (exact in F32, ties to even). 0x400 carries into the
    // smallest normal, which is the right encoding.
    block subnormal(%sign: U16, %magnitude: U32):
        %scaled : Self = Self.from_bits(%magnitude).mul(16777216.0)
        %steps  : U16  = %scaled.round_ties_even().to_u16()
        %r      : F16  = .from_bits(%sign.bitor(%steps))
        return(%r)

    // Round the 13 dropped mantissa bits to even, then rebias the exponent from
    // 127 to 15. A carry out of the mantissa bumps the exponent, as it should.
    block normal(%sign: U16, %magnitude: U32):
        %lowest_kept : U32 = %magnitude.shr(13).bitand(1)
        %rounded     : U32 = %magnitude.add(0xFFF).add(%lowest_kept)
        %rebiased    : U32 = %rounded.shr(13).sub(0x1C000)
        %r           : F16 = .from_bits(%sign.bitor(%rebiased.to_u16()))
        return(%r)

/// Rounds to nearest, ties to even, by adding a bias below the kept 16 bits.
/// Written out because the Windows compiler-rt has no __truncsfbf2.
routine F32.to_bf16(%self: Self) -> BF16
    block entry():
        %bits : U32  = %self.bits()
        %nan  : Bool = %self.is_nan()
        branch %nan
            ? quiet_nan(%bits)
            : round(%bits)

    // Keep the sign and top payload bits, and force the quiet bit.
    block quiet_nan(%bits: U32):
        %top : U16  = %bits.shr(16).to_u16().bitor(0x0040)
        %r   : BF16 = .from_bits(%top)
        return(%r)

    block round(%bits: U32):
        %lowest_kept : U32  = %bits.shr(16).bitand(1)
        %bias        : U32  = %lowest_kept.add(0x7FFF)
        %top         : U16  = %bits.add(%bias).shr(16).to_u16()
        %r           : BF16 = .from_bits(%top)
        return(%r)

routine F32.to_f32(%self: Self) -> Self
    block entry():
        return(%self)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and panics on NaN or a value out of the integer's
// range; to_<int>_checked returns None instead, and to_<int>_clamp saturates
// (NaN gives 0).

routine F32.to_s8(%self: Self) -> S8
    block entry():
        %fits : Bool = %self.fits_int(-128.0, 128.0)
        branch %fits
            ? continue
            : panic(TrapCode.Overflow)
        %r : S8 = fptosi_sat<Self, S8>(%self)
        return(%r)

routine F32.to_s8_checked(%self: Self) -> Option<S8>
    block entry():
        %fits  : Bool       = %self.fits_int(-128.0, 128.0)
        %value : S8         = fptosi_sat<Self, S8>(%self)
        %r     : Option<S8> = %fits.then_present(%value)
        return(%r)

routine F32.to_s8_clamp(%self: Self) -> S8
    block entry():
        %r : S8 = fptosi_sat<Self, S8>(%self)
        return(%r)

routine F32.to_s16(%self: Self) -> S16
