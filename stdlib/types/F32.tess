; Tessera stdlib: F32 — 32-bit IEEE 754 floating-point
;
; Maps to LLVM IR float.

@llvm("float")
struct F32
conform Equal<F32>, Compare<F32>, Hash<F32>

; -- constants -----------------------------------------------------------------

const F32.INFINITY:     F32 = 0x7F800000  ; +inf bits
const F32.NEG_INFINITY: F32 = 0xFF800000  ; -inf bits
const F32.NAN:          F32 = 0x7FC00000  ; canonical quiet NaN bits

; -- arithmetic ----------------------------------------------------------------

; Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine F32.abs(%self: Self) -> Self
    block entry():
        %r: Self = fabs<Self>(%self)
        return(%r)

; The smaller value; if one operand is NaN, the other one.
routine F32.min(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = minnum<Self>(%self, %other)
        return(%r)

; The larger value; if one operand is NaN, the other one.
routine F32.max(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = maxnum<Self>(%self, %other)
        return(%r)

routine F32.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fadd<Self>(%self, %other)
        return(%r)

routine F32.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fsub<Self>(%self, %other)
        return(%r)

routine F32.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fmul<Self>(%self, %other)
        return(%r)

; -- comparisons ---------------------------------------------------------------

routine F32.lt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = flt<Self>(%self, %other)
        return(%r)

routine F32.le(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fle<Self>(%self, %other)
        return(%r)

routine F32.gt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fgt<Self>(%self, %other)
        return(%r)

routine F32.ge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fge<Self>(%self, %other)
        return(%r)

; -- division ------------------------------------------------------------------

routine F32.fdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fdiv<Self>(%self, %other)
        return(%r)

; -- equality, ordering, hashing -----------------------------------------------

routine F32.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = feq<Self>(%self, %other)
        return(%r)

routine F32.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fne<Self>(%self, %other)
        return(%r)

routine F32.compare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.lt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.gt(%other)
        branch %gt ? return(1) : return(0)

routine F32.hash(%self: Self) -> I64
    block entry():
        %h: I64 = xxh64_hash_i64(bitcast<Self, I32>(%self).to_u64(), 0)
        return(%h)

; -- named widening conversion -------------------------------------------------

routine F32.to_f64(%self: Self) -> F64
    block entry():
        %result: F64 = fpext<Self, F64>(%self)
        return(%result)

routine F32.to_i32(%self: Self) -> I32
    block entry():
        %r: I32 = fptosi_sat<Self, I32>(%self)
        return(%r)

routine F32.to_i64(%self: Self) -> I64
    block entry():
        %r: I64 = fptosi_sat<Self, I64>(%self)
        return(%r)

; ============================================================
; Rust-level operations
; ============================================================

; -- constants ------------------------------------------------------------------

const F32.MAX:          F32 = 0x7F7FFFFF  ; largest finite value
const F32.MIN:          F32 = 0xFF7FFFFF  ; most negative finite value
const F32.MIN_POSITIVE: F32 = 0x00800000  ; smallest positive normal value
const F32.EPSILON:      F32 = 0x34000000  ; the gap between 1.0 and the next value

const F32.PI: F32 = 3.14159265358979323846264338327950288  ; pi
const F32.TAU: F32 = 6.28318530717958647692528676655900577  ; 2 pi
const F32.E: F32 = 2.71828182845904523536028747135266250  ; Euler's number
const F32.FRAC_PI_2: F32 = 1.57079632679489661923132169163975144  ; pi / 2
const F32.FRAC_PI_4: F32 = 0.785398163397448309615660845819875721  ; pi / 4
const F32.FRAC_1_PI: F32 = 0.318309886183790671537767526745028724  ; 1 / pi
const F32.SQRT_2: F32 = 1.41421356237309504880168872420969808  ; sqrt(2)
const F32.FRAC_1_SQRT_2: F32 = 0.707106781186547524400844362104849039  ; 1 / sqrt(2)
const F32.LN_2: F32 = 0.693147180559945309417232121458176568  ; ln(2)
const F32.LN_10: F32 = 2.30258509299404568401799145468436421  ; ln(10)
const F32.LOG2_E: F32 = 1.44269504088896340735992468100189214  ; log2(e)
const F32.LOG10_E: F32 = 0.434294481903251827651128918916605082  ; log10(e)

; -- C math library -----------------------------------------------------------

@[external("c"), symbol("cbrtf")]
routine c_cbrtf(%x: F32) -> F32

@[external("c"), symbol("expm1f")]
routine c_expm1f(%x: F32) -> F32

@[external("c"), symbol("log1pf")]
routine c_log1pf(%x: F32) -> F32

@[external("c"), symbol("hypotf")]
routine c_hypotf(%x: F32, %y: F32) -> F32

@[external("c"), symbol("asinhf")]
routine c_asinhf(%x: F32) -> F32

@[external("c"), symbol("acoshf")]
routine c_acoshf(%x: F32) -> F32

@[external("c"), symbol("atanhf")]
routine c_atanhf(%x: F32) -> F32

; -- sign ----------------------------------------------------------------------

routine F32.neg(%self: Self) -> Self
    block entry():
        %r: Self = fneg<Self>(%self)
        return(%r)

; The magnitude of self with the sign of %sign.
routine F32.copysign(%self: Self, %sign: Self) -> Self
    block entry():
        %r: Self = copysign<Self>(%self, %sign)
        return(%r)

; 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine F32.signum(%self: Self) -> Self
    block entry():
        %nan: Bool = %self.is_nan()
        %unit: Self = copysign<Self>(1.0, %self)
        %r: Self = %nan ? %self : %unit
        return(%r)

; Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine F32.is_sign_positive(%self: Self) -> Bool
    block entry():
        %bits: I32 = %self.to_bits()
        %r: Bool = %bits.sge(0)
        return(%r)

routine F32.is_sign_negative(%self: Self) -> Bool
    block entry():
        %bits: I32 = %self.to_bits()
        %r: Bool = %bits.slt(0)
        return(%r)

; -- arithmetic ----------------------------------------------------------------

; The remainder of self / other, with the sign of self (C fmod; Rust's %).
routine F32.frem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = frem<Self>(%self, %other)
        return(%r)

routine F32.recip(%self: Self) -> Self
    block entry():
        %r: Self = fdiv<Self>(1.0, %self)
        return(%r)

; self * a + b with a single rounding.
routine F32.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r: Self = fma<Self>(%self, %a, %b)
        return(%r)

; The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine F32.div_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %q: Self = %self.fdiv(%other).trunc()
        %rem: Self = frem<Self>(%self, %other)
        %rem_negative: Bool = %rem.lt(0.0)
        branch %rem_negative ? adjust(%q) : return(%q)

    block adjust(%q: Self):
        %positive_divisor: Bool = %other.gt(0.0)
        %down: Self = %q.sub(1.0)
        %up: Self = %q.add(1.0)
        %r: Self = %positive_divisor ? %down : %up
        return(%r)

; The least non-negative remainder of self / other.
routine F32.rem_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %rem: Self = frem<Self>(%self, %other)
        %rem_negative: Bool = %rem.lt(0.0)
        branch %rem_negative ? adjust(%rem) : return(%rem)

    block adjust(%rem: Self):
        %magnitude: Self = %other.abs()
        %r: Self = %rem.add(%magnitude)
        return(%r)

; -- ordering ------------------------------------------------------------------

; The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine F32.minimum(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = minimum<Self>(%self, %other)
        return(%r)

; The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine F32.maximum(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = maximum<Self>(%self, %other)
        return(%r)

; Restricts self to %lo ..= %hi; NaN stays NaN. Traps unless %lo <= %hi.
routine F32.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid: Bool = %lo.le(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %below: Bool = %self.lt(%lo)
        %above: Bool = %self.gt(%hi)
        %upper: Self = %above ? %hi : %self
        %r: Self = %below ? %lo : %upper
        return(%r)

; IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine F32.total_compare(%self: Self, %other: Self) -> I32
    block entry():
        %a: I32 = %self.to_bits()
        %b: I32 = %other.to_bits()
        ; Flipping every bit but the sign of negative values makes the bits order like signed integers.
        %a_key: I32 = %a.bitxor(%a.ashr(31).lshr(1))
        %b_key: I32 = %b.bitxor(%b.ashr(31).lshr(1))
        %r: I32 = %a_key.compare(%b_key)
        return(%r)

; -- rounding ------------------------------------------------------------------

routine F32.floor(%self: Self) -> Self
    block entry():
        %r: Self = floor<Self>(%self)
        return(%r)

routine F32.ceil(%self: Self) -> Self
    block entry():
        %r: Self = ceil<Self>(%self)
        return(%r)

; Rounds half-way cases away from zero.
routine F32.round(%self: Self) -> Self
    block entry():
        %r: Self = round<Self>(%self)
        return(%r)

; Rounds half-way cases to the even neighbor.
routine F32.round_ties_even(%self: Self) -> Self
    block entry():
        %r: Self = rint<Self>(%self)
        return(%r)

; Rounds toward zero.
routine F32.trunc(%self: Self) -> Self
    block entry():
        %r: Self = ftrunc<Self>(%self)
        return(%r)

; self minus its integer part, with the sign of self.
routine F32.fract(%self: Self) -> Self
    block entry():
        %whole: Self = %self.trunc()
        %r: Self = %self.sub(%whole)
        return(%r)

; -- powers --------------------------------------------------------------------

; NaN for negative values (other than -0.0).
routine F32.sqrt(%self: Self) -> Self
    block entry():
        %r: Self = sqrt<Self>(%self)
        return(%r)

routine F32.cbrt(%self: Self) -> Self
    block entry():
        %r: Self = c_cbrtf(%self)
        return(%r)

; self raised to an integer power, by repeated squaring.
routine F32.powi(%self: Self, %n: I32) -> Self
    block entry():
        %negative: Bool = %n.slt(0)
        %magnitude: I32 = %n.abs()
        jump loop(%self, %magnitude, 1.0, %negative)

    ; %exp is read as unsigned, so I32.MIN's magnitude (which wraps) still works.
    block loop(%base: Self, %exp: I32, %acc: Self, %negative: Bool):
        %done: Bool = %exp.eq(0)
        branch %done ? finish(%acc, %negative) : step(%base, %exp, %acc, %negative)

    block step(%base: Self, %exp: I32, %acc: Self, %negative: Bool):
        %odd: Bool = %exp.bitand(1).ne(0)
        %with_base: Self = %acc.mul(%base)
        %next_acc: Self = %odd ? %with_base : %acc
        jump loop(%base.mul(%base), %exp.lshr(1), %next_acc, %negative)

    block finish(%acc: Self, %negative: Bool):
        %inverse: Self = %acc.recip()
        %r: Self = %negative ? %inverse : %acc
        return(%r)

routine F32.powf(%self: Self, %exp: Self) -> Self
    block entry():
        %r: Self = pow<Self>(%self, %exp)
        return(%r)

; e^self
routine F32.exp(%self: Self) -> Self
    block entry():
        %r: Self = exp<Self>(%self)
        return(%r)

; 2^self
routine F32.exp2(%self: Self) -> Self
    block entry():
        %r: Self = exp2<Self>(%self)
        return(%r)

; e^self - 1, accurate near 0.
routine F32.exp_m1(%self: Self) -> Self
    block entry():
        %r: Self = c_expm1f(%self)
        return(%r)

; The natural logarithm.
routine F32.ln(%self: Self) -> Self
    block entry():
        %r: Self = log<Self>(%self)
        return(%r)

routine F32.log2(%self: Self) -> Self
    block entry():
        %r: Self = log2<Self>(%self)
        return(%r)

routine F32.log10(%self: Self) -> Self
    block entry():
        %r: Self = log10<Self>(%self)
        return(%r)

; ln(1 + self), accurate near 0.
routine F32.ln_1p(%self: Self) -> Self
    block entry():
        %r: Self = c_log1pf(%self)
        return(%r)

; The logarithm with an arbitrary base.
routine F32.log(%self: Self, %base: Self) -> Self
    block entry():
        %num: Self = %self.ln()
        %den: Self = %base.ln()
        %r: Self = %num.fdiv(%den)
        return(%r)

; sqrt(self^2 + other^2) without intermediate overflow.
routine F32.hypot(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = c_hypotf(%self, %other)
        return(%r)

; -- trigonometry --------------------------------------------------------------

; In radians.
routine F32.sin(%self: Self) -> Self
    block entry():
        %r: Self = sin<Self>(%self)
        return(%r)

; In radians.
routine F32.cos(%self: Self) -> Self
    block entry():
        %r: Self = cos<Self>(%self)
        return(%r)

; In radians.
routine F32.tan(%self: Self) -> Self
    block entry():
        %r: Self = tan<Self>(%self)
        return(%r)

routine F32.asin(%self: Self) -> Self
    block entry():
        %r: Self = asin<Self>(%self)
        return(%r)

routine F32.acos(%self: Self) -> Self
    block entry():
        %r: Self = acos<Self>(%self)
        return(%r)

routine F32.atan(%self: Self) -> Self
    block entry():
        %r: Self = atan<Self>(%self)
        return(%r)

routine F32.sinh(%self: Self) -> Self
    block entry():
        %r: Self = sinh<Self>(%self)
        return(%r)

routine F32.cosh(%self: Self) -> Self
    block entry():
        %r: Self = cosh<Self>(%self)
        return(%r)

routine F32.tanh(%self: Self) -> Self
    block entry():
        %r: Self = tanh<Self>(%self)
        return(%r)

routine F32.asinh(%self: Self) -> Self
    block entry():
        %r: Self = c_asinhf(%self)
        return(%r)

routine F32.acosh(%self: Self) -> Self
    block entry():
        %r: Self = c_acoshf(%self)
        return(%r)

routine F32.atanh(%self: Self) -> Self
    block entry():
        %r: Self = c_atanhf(%self)
        return(%r)

; The angle of the point (other, self): self is y and %other is x.
routine F32.atan2(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = atan2<Self>(%self, %other)
        return(%r)

routine F32.to_degrees(%self: Self) -> Self
    block entry():
        %r: Self = %self.mul(57.2957795130823208767981548141051703)
        return(%r)

routine F32.to_radians(%self: Self) -> Self
    block entry():
        %r: Self = %self.mul(0.0174532925199432957692369076848861271)
        return(%r)

; -- classification ------------------------------------------------------------

routine F32.is_nan(%self: Self) -> Bool
    block entry():
        %r: Bool = funo<Self>(%self, %self)
        return(%r)

routine F32.is_infinite(%self: Self) -> Bool
    block entry():
        %magnitude: Self = fabs<Self>(%self)
        %r: Bool = %magnitude.eq(Self.INFINITY)
        return(%r)

; Neither infinite nor NaN.
routine F32.is_finite(%self: Self) -> Bool
    block entry():
        %magnitude: Self = fabs<Self>(%self)
        %r: Bool = %magnitude.lt(Self.INFINITY)
        return(%r)

; Not zero, subnormal, infinite, or NaN.
routine F32.is_normal(%self: Self) -> Bool
    block entry():
        %exponent: I32 = %self.to_bits().bitand(0x7F800000)
        %r: Bool = %exponent.ne(0).bitand(%exponent.ne(0x7F800000))
        return(%r)

routine F32.is_subnormal(%self: Self) -> Bool
    block entry():
        %bits: I32 = %self.to_bits()
        %exponent: I32 = %bits.bitand(0x7F800000)
        %mantissa: I32 = %bits.bitand(0x007FFFFF)
        %r: Bool = %exponent.eq(0).bitand(%mantissa.ne(0))
        return(%r)

; -- bits ----------------------------------------------------------------------

; The raw IEEE 754 bits.
routine F32.to_bits(%self: Self) -> I32
    block entry():
        %r: I32 = bitcast<Self, I32>(%self)
        return(%r)

routine F32.from_bits(%bits: I32) -> Self
    block entry():
        %r: Self = bitcast<I32, Self>(%bits)
        return(%r)

; -- conversions (float to integer saturates, NaN gives 0) --------------------

; Rounds to nearest, ties to even. Written with integer operations instead of
; fptrunc, which calls compiler-rt's __truncsfhf2 (see F16's runtime support).
routine F32.to_f16(%self: Self) -> F16
    block entry():
        %bits: I32 = %self.to_bits()
        %sign: I16 = %bits.lshr(16).to_i16().bitand(-32768)
        %magnitude: I32 = %bits.bitand(0x7FFFFFFF)
        select:
            %magnitude.uge(0x7F800000) -> special(%sign, %magnitude)
            %magnitude.uge(0x477FF000) -> return(F16.from_bits(%sign.bitor(0x7C00)))
            %magnitude.ult(0x38800000) -> subnormal(%sign, %magnitude)
            _ -> normal(%sign, %magnitude)

    ; Infinity stays infinity; NaN keeps its top payload bits and is made quiet.
    block special(%sign: I16, %magnitude: I32):
        %payload: I16 = %magnitude.bitand(0x7FFFFF).lshr(13).to_i16()
        %is_nan: Bool = %magnitude.ugt(0x7F800000)
        %nan_bits: I16 = %payload.bitor(0x7E00)
        %body: I16 = %is_nan ? %nan_bits : 0x7C00
        %r: F16 = F16.from_bits(%sign.bitor(%body))
        return(%r)

    ; Below F16's smallest normal: scale so one F16 subnormal step is 1.0, and
    ; round to an integer (exact in F32, ties to even). 0x400 carries into the
    ; smallest normal, which is the right encoding.
    block subnormal(%sign: I16, %magnitude: I32):
        %scaled: F32 = F32.from_bits(%magnitude).mul(16777216.0)
        %steps: I16 = rint<F32>(%scaled).to_i16()
        %r: F16 = F16.from_bits(%sign.bitor(%steps))
        return(%r)

    ; Round the 13 dropped mantissa bits to even, then rebias the exponent from
    ; 127 to 15. A carry out of the mantissa bumps the exponent, as it should.
    block normal(%sign: I16, %magnitude: I32):
        %lowest_kept: I32 = %magnitude.lshr(13).bitand(1)
        %rounded: I32 = %magnitude.add(0xFFF).add(%lowest_kept)
        %rebiased: I32 = %rounded.lshr(13).sub(0x1C000)
        %r: F16 = F16.from_bits(%sign.bitor(%rebiased.to_i16()))
        return(%r)

; Rounds to nearest, ties to even, by adding a bias below the kept 16 bits.
; Written out because the Windows compiler-rt has no __truncsfbf2.
routine F32.to_bf16(%self: Self) -> BF16
    block entry():
        %bits: I32 = %self.to_bits()
        %nan: Bool = %self.is_nan()
        branch %nan ? quiet_nan(%bits) : round(%bits)

    ; Keep the sign and top payload bits, and force the quiet bit.
    block quiet_nan(%bits: I32):
        %top: I16 = %bits.lshr(16).to_i16().bitor(0x0040)
        %r: BF16 = BF16.from_bits(%top)
        return(%r)

    block round(%bits: I32):
        %lowest_kept: I32 = %bits.lshr(16).bitand(1)
        %bias: I32 = %lowest_kept.add(0x7FFF)
        %top: I16 = %bits.add(%bias).lshr(16).to_i16()
        %r: BF16 = BF16.from_bits(%top)
        return(%r)

routine F32.to_f32(%self: Self) -> F32
    block entry():
        return(%self)

routine F32.to_i8(%self: Self) -> I8
    block entry():
        %r: I8 = fptosi_sat<Self, I8>(%self)
        return(%r)

routine F32.to_u8(%self: Self) -> I8
    block entry():
        %r: I8 = fptoui_sat<Self, I8>(%self)
        return(%r)

routine F32.to_i16(%self: Self) -> I16
    block entry():
        %r: I16 = fptosi_sat<Self, I16>(%self)
        return(%r)

routine F32.to_u16(%self: Self) -> I16
    block entry():
        %r: I16 = fptoui_sat<Self, I16>(%self)
        return(%r)

routine F32.to_u32(%self: Self) -> I32
    block entry():
        %r: I32 = fptoui_sat<Self, I32>(%self)
        return(%r)

routine F32.to_u64(%self: Self) -> I64
    block entry():
        %r: I64 = fptoui_sat<Self, I64>(%self)
        return(%r)

routine F32.to_i128(%self: Self) -> I128
    block entry():
        %r: I128 = fptosi_sat<Self, I128>(%self)
        return(%r)

routine F32.to_u128(%self: Self) -> I128
    block entry():
        %r: I128 = fptoui_sat<Self, I128>(%self)
        return(%r)
