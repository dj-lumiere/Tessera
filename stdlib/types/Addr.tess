// Tessera stdlib: Addr — an address with no pointee type
//
// Maps to LLVM IR ptr, like Ptr<T>. Addr is C's `void*`: what an allocator hands out, a callback's state, a
// hardware register's address. Any Ptr<T> converts to Addr where one is expected; going back takes cast<T>().

module Standard::Core

@llvm("ptr")
record Addr

// -- identity ------------------------------------------------------------------

routine Addr.ptr_eq(#self: Self, #other: Self) -> Bool
    block entry():
        %a: U64 = ptrtoint<Self, U64>(#self)
        %b: U64 = ptrtoint<Self, U64>(#other)
        %r: Bool = ieq<U64>(%a, %b)
        return(%r)

routine Addr.ptr_ne(#self: Self, #other: Self) -> Bool
    block entry():
        %a: U64 = ptrtoint<Self, U64>(#self)
        %b: U64 = ptrtoint<Self, U64>(#other)
        %r: Bool = ine<U64>(%a, %b)
        return(%r)

// -- predicates ----------------------------------------------------------------

routine Addr.is_null(#self: Self) -> Bool
    block entry():
        %a: U64 = ptrtoint<Self, U64>(#self)
        %r: Bool = ieq<U64>(%a, 0)
        return(%r)

routine Addr.is_not_null(#self: Self) -> Bool
    block entry():
        %a: U64 = ptrtoint<Self, U64>(#self)
        %r: Bool = ine<U64>(%a, 0)
        return(%r)

// -- arithmetic and typing -----------------------------------------------------

/// The address %bytes bytes further on. No bounds checking: staying in bounds is the caller's job.
routine Addr.offset(#self: Self, %bytes: S64) -> Self
    block entry():
        #r: Self = addr_offset(#self, %bytes)
        return(#r)

@[external("llvm"), template("{result} = getelementptr i8, ptr {#base}, i64 {%bytes}")]
private routine addr_offset(#base: Addr, %bytes: S64) -> Addr

/// The same address as a pointer to T.
routine Addr.cast<T>(#self: Self) -> Ptr<T>
require T: typename
    block entry():
        #r: Ptr<T> = bitcast<Self, Ptr<T>>(#self)
        return(#r)
