; Tessera stdlib: U64 — 64-bit unsigned integer
;
; Maps to LLVM IR i64. Generated by scripts/gen_int_types.py; every S / U
; width shares the same method set.
;
; add / sub / mul / div / rem / neg / abs / pow and lossy to_<type>
; conversions panic when the result doesn't fit. Each has a _checked form
; that returns Option instead, and add / sub / mul / pow / neg / abs and the
; conversions have _wrap (modular) and _clamp (saturating) forms.

@llvm("i64")
record U64
conform Equal<U64>, Compare<U64>, Hash<U64>
; -- constants -------------------------------------------------------------------
preset U64.MIN: U64 = 0
preset U64.MAX: U64 = 18446744073709551615
preset U64.BITS: U64 = 64
; -- bits ------------------------------------------------------------------------
routine U64.count_ones(%self: Self) -> Self
    block entry():
        %r: Self = popcount<Self>(%self)
        return(%r)
routine U64.leading_zeros(%self: Self) -> Self
    block entry():
        %r: Self = clz<Self>(%self, false)
        return(%r)
routine U64.trailing_zeros(%self: Self) -> Self
    block entry():
        %r: Self = ctz<Self>(%self, false)
        return(%r)
routine U64.reverse_bits(%self: Self) -> Self
    block entry():
        %r: Self = bitreverse<Self>(%self)
        return(%r)
routine U64.count_zeros(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = popcount<Self>(%inverted)
        return(%r)
routine U64.leading_ones(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = clz<Self>(%inverted, false)
        return(%r)
routine U64.trailing_ones(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = ctz<Self>(%inverted, false)
        return(%r)
routine U64.swap_bytes(%self: Self) -> Self
    block entry():
        %r: Self = bswap<Self>(%self)
        return(%r)

routine U64.to_be(%self: Self) -> Self
    block entry():
        %r: Self = %self.swap_bytes()
        return(%r)

routine U64.from_be(%self: Self) -> Self
    block entry():
        %r: Self = %self.swap_bytes()
        return(%r)

routine U64.to_le(%self: Self) -> Self
    block entry():
        return(%self)

routine U64.from_le(%self: Self) -> Self
    block entry():
        return(%self)
; True when exactly one bit is set.
routine U64.is_power_of_two(%self: Self) -> Bool
    block entry():
        %ones: Self = popcount<Self>(%self)
        %r: Bool = %ones.eq(1)
        return(%r)
routine U64.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)
routine U64.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)
routine U64.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)
routine U64.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)
; -- shifts ----------------------------------------------------------------------
; A shift amount outside 0 ..< BITS is poison (Roadmap #8); see shl_checked / shl_wrap.
routine U64.shl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = shl<Self>(%self, %n)
        return(%r)

; Shift right, logical: zeros fill in.
routine U64.shr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = lshr<Self>(%self, %n)
        return(%r)

; Rotates by %n modulo the bit width.
routine U64.rotl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = fshl<Self>(%self, %self, %n)
        return(%r)

routine U64.rotr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = fshr<Self>(%self, %self, %n)
        return(%r)

; None when %n is outside 0 ..< BITS.
routine U64.shl_checked(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range: Bool = %n.lt(Self.BITS)
        branch %in_range ? shift() : return(Option<Self>.none())

    block shift():
        %r: Self = shl<Self>(%self, %n)
        return(Option<Self>.some(%r))

routine U64.shr_checked(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range: Bool = %n.lt(Self.BITS)
        branch %in_range ? shift() : return(Option<Self>.none())

    block shift():
        %r: Self = lshr<Self>(%self, %n)
        return(Option<Self>.some(%r))

; Shifts by %n modulo the bit width.
routine U64.shl_wrap(%self: Self, %n: Self) -> Self
    block entry():
        %amount: Self = band<Self>(%n, 63)
        %r: Self = shl<Self>(%self, %amount)
        return(%r)

routine U64.shr_wrap(%self: Self, %n: Self) -> Self
    block entry():
        %amount: Self = band<Self>(%n, 63)
        %r: Self = lshr<Self>(%self, %amount)
        return(%r)
; -- arithmetic ------------------------------------------------------------------
; Panics on overflow.
routine U64.add(%self: Self, %other: Self) -> Self
    block entry():
        %overflow: Bool = uadd_overflows<Self>(%self, %other)
        branch %overflow ? panic(TrapCode.Overflow) : done()

    block done():
        %r: Self = add<Self>(%self, %other)
        return(%r)

routine U64.add_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = uadd_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = add<Self>(%self, %other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

; Wraps modulo 2^64.
routine U64.add_wrap(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = add<Self>(%self, %other)
        return(%r)
; Saturates at MIN / MAX.
routine U64.add_clamp(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = uadd_sat<Self>(%self, %other)
        return(%r)
; Panics on overflow.
routine U64.sub(%self: Self, %other: Self) -> Self
    block entry():
        %overflow: Bool = usub_overflows<Self>(%self, %other)
        branch %overflow ? panic(TrapCode.Overflow) : done()

    block done():
        %r: Self = sub<Self>(%self, %other)
        return(%r)

routine U64.sub_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = usub_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = sub<Self>(%self, %other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

; Wraps modulo 2^64.
routine U64.sub_wrap(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sub<Self>(%self, %other)
        return(%r)
; Saturates at MIN / MAX.
routine U64.sub_clamp(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = usub_sat<Self>(%self, %other)
        return(%r)
; Panics on overflow.
routine U64.mul(%self: Self, %other: Self) -> Self
    block entry():
        %overflow: Bool = umul_overflows<Self>(%self, %other)
        branch %overflow ? panic(TrapCode.Overflow) : done()

    block done():
        %r: Self = mul<Self>(%self, %other)
        return(%r)

routine U64.mul_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = umul_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = mul<Self>(%self, %other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

; Wraps modulo 2^64.
routine U64.mul_wrap(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = mul<Self>(%self, %other)
        return(%r)
; Saturates at MAX.
routine U64.mul_clamp(%self: Self, %other: Self) -> Self
    block entry():
        %overflow: Bool = %self.mul_overflows(%other)
        %product: Self = mul<Self>(%self, %other)
        %r: Self = %overflow ? Self.MAX : %product
        return(%r)
; Whether the exact product is outside MIN ..= MAX.
routine U64.mul_overflows(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = umul_overflows<Self>(%self, %other)
        return(%r)
; The exact product in twice the width; it never overflows.
routine U64.mul_wide(%self: Self, %other: Self) -> U128
    block entry():
        %r: U128 = %self.to_u128().mul_wrap(%other.to_u128())
        return(%r)
; -- division --------------------------------------------------------------------
; Panics on a zero divisor.
routine U64.div(%self: Self, %other: Self) -> Self
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? panic(TrapCode.DivByZero) : done()

    block done():
        %r: Self = udiv<Self>(%self, %other)
        return(%r)

; Panics on a zero divisor.
routine U64.rem(%self: Self, %other: Self) -> Self
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? panic(TrapCode.DivByZero) : done()

    block done():
        %r: Self = urem<Self>(%self, %other)
        return(%r)

; None on a zero divisor.
routine U64.div_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? return(Option<Self>.none()) : done()

    block done():
        %r: Self = udiv<Self>(%self, %other)
        return(Option<Self>.some(%r))

routine U64.rem_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? return(Option<Self>.none()) : done()

    block done():
        %r: Self = urem<Self>(%self, %other)
        return(Option<Self>.some(%r))

; Division rounding up. Panics on a zero divisor.
routine U64.div_ceil(%self: Self, %other: Self) -> Self
    block entry():
        %q: Self = %self.div(%other)
        %rem: Self = urem<Self>(%self, %other)
        %exact: Bool = %rem.eq(0)
        branch %exact ? return(%q) : up(%q)

    block up(%q: Self):
        %r: Self = add<Self>(%q, 1)
        return(%r)

; The smallest multiple of %other that is >= %self. Panics on a zero %other and
; when the multiple doesn't fit.
routine U64.next_multiple_of(%self: Self, %other: Self) -> Self
    block entry():
        %rem: Self = %self.rem(%other)
        %exact: Bool = %rem.eq(0)
        branch %exact ? return(%self) : up(%rem)

    block up(%rem: Self):
        %gap: Self = sub<Self>(%other, %rem)
        %r: Self = %self.add(%gap)
        return(%r)

; The smallest power of two >= self; 0 and 1 give 1. Panics when it doesn't fit.
routine U64.next_power_of_two(%self: Self) -> Self
    block entry():
        %r: Option<Self> = %self.next_power_of_two_checked()
        %fits: Bool = %r.tag
        branch %fits ? done(%r) : panic(TrapCode.Overflow)

    block done(%r: Option<Self>):
        return(%r.value)

; None when the power of two doesn't fit.
routine U64.next_power_of_two_checked(%self: Self) -> Option<Self>
    block entry():
        %small: Bool = %self.le(1)
        branch %small ? return(Option<Self>.some(1)) : round_up()

    ; A shift by the full width would be poison, so check the amount first.
    block round_up():
        %below: Self = sub<Self>(%self, 1)
        %lz: Self = clz<Self>(%below, true)
        %shift: Self = sub<Self>(Self.BITS, %lz)
        %fits: Bool = %shift.lt(Self.BITS)
        branch %fits ? shift(%shift) : return(Option<Self>.none())

    block shift(%shift: Self):
        %power: Self = shl<Self>(1, %shift)
        return(Option<Self>.some(%power))
; -- powers ----------------------------------------------------------------------
; Panics when the power doesn't fit.
routine U64.pow(%self: Self, %exp: U32) -> Self
    block entry():
        %r: Option<Self> = %self.pow_checked(%exp)
        %fits: Bool = %r.tag
        branch %fits ? done(%r) : panic(TrapCode.Overflow)

    block done(%r: Option<Self>):
        return(%r.value)

; Wrapping power by squaring.
routine U64.pow_wrap(%self: Self, %exp: U32) -> Self
    block entry():
        jump loop(%self, %exp, 1)

    block loop(%base: Self, %exp: U32, %acc: Self):
        %done: Bool = %exp.eq(0)
        branch %done ? return(%acc) : step(%base, %exp, %acc)

    block step(%base: Self, %exp: U32, %acc: Self):
        %odd: Bool = %exp.bitand(1).ne(0)
        %with_base: Self = mul<Self>(%acc, %base)
        %next_acc: Self = %odd ? %with_base : %acc
        jump loop(mul<Self>(%base, %base), %exp.shr(1), %next_acc)

; None if any step overflows.
routine U64.pow_checked(%self: Self, %exp: U32) -> Option<Self>
    block entry():
        jump loop(%self, %exp, 1, false)

    block loop(%base: Self, %exp: U32, %acc: Self, %overflow: Bool):
        %done: Bool = %exp.eq(0)
        branch %done ? finish(%acc, %overflow) : step(%base, %exp, %acc, %overflow)

    ; The accumulator only multiplies on odd bits, and the base only needs
    ; squaring while bits remain, so only those overflows count.
    block step(%base: Self, %exp: U32, %acc: Self, %overflow: Bool):
        %odd: Bool = %exp.bitand(1).ne(0)
        %acc_overflow: Bool = umul_overflows<Self>(%acc, %base).bitand(%odd)
        %with_base: Self = mul<Self>(%acc, %base)
        %next_acc: Self = %odd ? %with_base : %acc
        %rest: U32 = %exp.shr(1)
        %more: Bool = %rest.ne(0)
        %base_overflow: Bool = umul_overflows<Self>(%base, %base).bitand(%more)
        %any: Bool = %overflow.bitor(%acc_overflow).bitor(%base_overflow)
        jump loop(mul<Self>(%base, %base), %rest, %next_acc, %any)

    block finish(%acc: Self, %overflow: Bool):
        %fits: Bool = %overflow.bitnot()
        %r: Option<Self> = %fits.then_some(%acc)
        return(%r)
; MAX on overflow.
routine U64.pow_clamp(%self: Self, %exp: U32) -> Self
    block entry():
        %checked: Option<Self> = %self.pow_checked(%exp)
        %r: Self = %checked.unwrap_or(Self.MAX)
        return(%r)
; -- equality and ordering -------------------------------------------------------
routine U64.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine U64.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)
routine U64.lt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ult<Self>(%self, %other)
        return(%r)
routine U64.le(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ule<Self>(%self, %other)
        return(%r)
routine U64.gt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ugt<Self>(%self, %other)
        return(%r)
routine U64.ge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = uge<Self>(%self, %other)
        return(%r)
; -1, 0, or 1.
routine U64.compare(%self: Self, %other: Self) -> S32
    block entry():
        %lt: Bool = %self.lt(%other)
        branch %lt ? return(-1) : maybe_gt()

    block maybe_gt():
        %gt: Bool = %self.gt(%other)
        branch %gt ? return(1) : return(0)

routine U64.min(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = umin<Self>(%self, %other)
        return(%r)

routine U64.max(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = umax<Self>(%self, %other)
        return(%r)

; Panics if %lo > %hi.
routine U64.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid: Bool = %lo.le(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %at_least_lo: Self = umax<Self>(%self, %lo)
        %r: Self = umin<Self>(%at_least_lo, %hi)
        return(%r)
; -- hash ------------------------------------------------------------------------
; xxh64 of the bits, the same hash for S64 and U64.
routine U64.hash(%self: Self) -> U64
    block entry():
        %bits: U64 = bitcast<Self, U64>(%self)
        %h: U64 = xxh64_hash_u64(%bits, 0)
        return(%h)
; -- differences, midpoints, logarithms, roots -----------------------------------
; |self - other|, which always fits in U64.
routine U64.abs_diff(%self: Self, %other: Self) -> U64
    block entry():
        %hi: Self = umax<Self>(%self, %other)
        %lo: Self = umin<Self>(%self, %other)
        %diff: Self = sub<Self>(%hi, %lo)
        %r: U64 = bitcast<Self, U64>(%diff)
        return(%r)
; floor((self + other) / 2) without overflow.
routine U64.midpoint(%self: Self, %other: Self) -> Self
    block entry():
        %common: Self = %self.bitand(%other)
        %half_diff: Self = %self.bitxor(%other).shr(1)
        %r: Self = add<Self>(%common, %half_diff)
        return(%r)

; floor(log2(self)). Panics on 0.
routine U64.ilog2(%self: Self) -> Self
    block entry():
        %zero: Bool = %self.eq(0)
        branch %zero ? panic(TrapCode.InvalidArgument) : log()

    block log():
        %lz: Self = clz<Self>(%self, true)
        %r: Self = sub<Self>(Self.BITS.sub(1), %lz)
        return(%r)

; floor(log10(self)). Panics on 0.
routine U64.ilog10(%self: Self) -> Self
    block entry():
        %zero: Bool = %self.eq(0)
        branch %zero ? panic(TrapCode.InvalidArgument) : loop(%self, 0)

    block loop(%rest: Self, %digits: Self):
        %last: Bool = %rest.lt(10)
        branch %last ? return(%digits) : next(%rest, %digits)

    block next(%rest: Self, %digits: Self):
        jump loop(%rest.div(10), %digits.add(1))

; floor(sqrt(self)), computed one result bit at a time.
routine U64.isqrt(%self: Self) -> Self
    block entry():
        %top_bit: Self = shl<Self>(1, Self.BITS.sub(2))
        jump align(%top_bit)

    ; Start from the highest power of four that is <= self.
    block align(%bit: Self):
        %too_big: Bool = %bit.gt(%self)
        branch %too_big ? align(%bit.shr(2)) : loop(%self, 0, %bit)

    block loop(%rest: Self, %root: Self, %bit: Self):
        %done: Bool = %bit.eq(0)
        branch %done ? return(%root) : step(%rest, %root, %bit)

    block step(%rest: Self, %root: Self, %bit: Self):
        %trial: Self = add<Self>(%root, %bit)
        %fits: Bool = %rest.ge(%trial)
        %half_root: Self = %root.shr(1)
        %next_bit: Self = %bit.shr(2)
        branch %fits ? take(%rest, %trial, %half_root, %bit, %next_bit) \
                     : loop(%rest, %half_root, %next_bit)

    block take(%rest: Self, %trial: Self, %half_root: Self, %bit: Self, %next_bit: Self):
        jump loop(sub<Self>(%rest, %trial), add<Self>(%half_root, %bit), %next_bit)
; -- conversions -----------------------------------------------------------------
; to_<type> returns the same value in another integer type. A conversion that
; can't lose the value returns it directly; one that can panics when the value
; doesn't fit, and has _checked (Option), _wrap (keep the low bits), and _clamp
; (saturate) forms.
; Panics when the value doesn't fit in S8.
routine U64.to_s8(%self: Self) -> S8
    block entry():
        %fits: Bool = %self.le(127)
        branch %fits ? done() : panic(TrapCode.Overflow)

    block done():
        %r: S8 = trunc<Self, S8>(%self)
        return(%r)

routine U64.to_s8_checked(%self: Self) -> Option<S8>
    block entry():
        %fits: Bool = %self.le(127)
        %value: S8 = trunc<Self, S8>(%self)
        %r: Option<S8> = %fits.then_some(%value)
        return(%r)

; Keeps the low 8 bits (modulo 2^8).
routine U64.to_s8_wrap(%self: Self) -> S8
    block entry():
        %r: S8 = trunc<Self, S8>(%self)
        return(%r)

; Saturates at S8's range.
routine U64.to_s8_clamp(%self: Self) -> S8
    block entry():
        %at_most: Self = umin<Self>(%self, 127)
        %r: S8 = trunc<Self, S8>(%at_most)
        return(%r)
; Panics when the value doesn't fit in S16.
routine U64.to_s16(%self: Self) -> S16
    block entry():
        %fits: Bool = %self.le(32767)
        branch %fits ? done() : panic(TrapCode.Overflow)

    block done():
        %r: S16 = trunc<Self, S16>(%self)
        return(%r)

routine U64.to_s16_checked(%self: Self) -> Option<S16>
    block entry():
        %fits: Bool = %self.le(32767)
        %value: S16 = trunc<Self, S16>(%self)
        %r: Option<S16> = %fits.then_some(%value)
        return(%r)

; Keeps the low 16 bits (modulo 2^16).
routine U64.to_s16_wrap(%self: Self) -> S16
    block entry():
        %r: S16 = trunc<Self, S16>(%self)
        return(%r)

; Saturates at S16's range.
routine U64.to_s16_clamp(%self: Self) -> S16
    block entry():
        %at_most: Self = umin<Self>(%self, 32767)
        %r: S16 = trunc<Self, S16>(%at_most)
        return(%r)
; Panics when the value doesn't fit in S32.
routine U64.to_s32(%self: Self) -> S32
    block entry():
        %fits: Bool = %self.le(2147483647)
        branch %fits ? done() : panic(TrapCode.Overflow)

    block done():
        %r: S32 = trunc<Self, S32>(%self)
        return(%r)

routine U64.to_s32_checked(%self: Self) -> Option<S32>
    block entry():
        %fits: Bool = %self.le(2147483647)
        %value: S32 = trunc<Self, S32>(%self)
        %r: Option<S32> = %fits.then_some(%value)
        return(%r)

; Keeps the low 32 bits (modulo 2^32).
routine U64.to_s32_wrap(%self: Self) -> S32
    block entry():
        %r: S32 = trunc<Self, S32>(%self)
        return(%r)

; Saturates at S32's range.
routine U64.to_s32_clamp(%self: Self) -> S32
    block entry():
        %at_most: Self = umin<Self>(%self, 2147483647)
        %r: S32 = trunc<Self, S32>(%at_most)
        return(%r)
; Panics when the value doesn't fit in S64.
routine U64.to_s64(%self: Self) -> S64
    block entry():
        %fits: Bool = %self.le(9223372036854775807)
        branch %fits ? done() : panic(TrapCode.Overflow)

    block done():
        %r: S64 = bitcast<Self, S64>(%self)
        return(%r)

routine U64.to_s64_checked(%self: Self) -> Option<S64>
    block entry():
        %fits: Bool = %self.le(9223372036854775807)
        %value: S64 = bitcast<Self, S64>(%self)
        %r: Option<S64> = %fits.then_some(%value)
        return(%r)

; Keeps the low 64 bits (modulo 2^64).
routine U64.to_s64_wrap(%self: Self) -> S64
    block entry():
        %r: S64 = bitcast<Self, S64>(%self)
        return(%r)

; Saturates at S64's range.
routine U64.to_s64_clamp(%self: Self) -> S64
    block entry():
        %at_most: Self = umin<Self>(%self, 9223372036854775807)
        %r: S64 = bitcast<Self, S64>(%at_most)
        return(%r)
routine U64.to_s128(%self: Self) -> S128
    block entry():
        %r: S128 = zext<Self, S128>(%self)
        return(%r)
routine U64.to_s256(%self: Self) -> S256
    block entry():
        %r: S256 = zext<Self, S256>(%self)
        return(%r)
; Panics when the value doesn't fit in U8.
routine U64.to_u8(%self: Self) -> U8
    block entry():
        %fits: Bool = %self.le(255)
        branch %fits ? done() : panic(TrapCode.Overflow)

    block done():
        %r: U8 = trunc<Self, U8>(%self)
        return(%r)

routine U64.to_u8_checked(%self: Self) -> Option<U8>
    block entry():
        %fits: Bool = %self.le(255)
        %value: U8 = trunc<Self, U8>(%self)
        %r: Option<U8> = %fits.then_some(%value)
        return(%r)

; Keeps the low 8 bits (modulo 2^8).
routine U64.to_u8_wrap(%self: Self) -> U8
    block entry():
        %r: U8 = trunc<Self, U8>(%self)
        return(%r)

; Saturates at U8's range.
routine U64.to_u8_clamp(%self: Self) -> U8
    block entry():
        %at_most: Self = umin<Self>(%self, 255)
        %r: U8 = trunc<Self, U8>(%at_most)
        return(%r)
