        %r: U32 = trunc<Self, U32>(%at_most)
        return(%r)
routine U64.to_u64(%self: Self) -> U64
    block entry():
        return(%self)
routine U64.to_u128(%self: Self) -> U128
    block entry():
        %r: U128 = zext<Self, U128>(%self)
        return(%r)
routine U64.to_u256(%self: Self) -> U256
    block entry():
        %r: U256 = zext<Self, U256>(%self)
        return(%r)
; Rounds to nearest, ties to even.
routine U64.to_f32(%self: Self) -> F32
    block entry():
        %r: F32 = uitofp<Self, F32>(%self)
        return(%r)
; Rounds to nearest, ties to even.
routine U64.to_f64(%self: Self) -> F64
    block entry():
        %r: F64 = uitofp<Self, F64>(%self)
        return(%r)
; -- raw bits --------------------------------------------------------------------
; The bits, with no meaning attached.
routine U64.bits(%self: Self) -> Bits64
    block entry():
        %r: Bits64 = bitcast<Self, Bits64>(%self)
        return(%r)
; The bits read as a U64.
routine U64.from_bits(%bits: Bits64) -> U64
    block entry():
        %r: U64 = bitcast<Bits64, U64>(%bits)
        return(%r)
