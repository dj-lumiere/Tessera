// Tessera stdlib: U32 — 32-bit unsigned integer
//
// Maps to LLVM IR i32. Generated by scripts/gen_int_types.py; every S / U
// width shares the same method set.
//
// add / sub / mul / div / rem / neg / abs / pow and lossy to_<type>
// conversions panic when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

@llvm("i32")
record U32
conform Equal<U32>, Compare<U32>, Hash<U32>

// -- constants -------------------------------------------------------------------

preset U32.MIN: U32 = 0
preset U32.MAX: U32 = 4294967295
preset U32.BITS: U32 = 32

// -- bits ------------------------------------------------------------------------

routine U32.count_ones(%self: Self) -> Self
    block entry():
        %r : Self = popcount<Self>(%self)
        return(%r)

routine U32.leading_zeros(%self: Self) -> Self
    block entry():
        %r : Self = clz<Self>(%self, false)
        return(%r)

routine U32.trailing_zeros(%self: Self) -> Self
    block entry():
        %r : Self = ctz<Self>(%self, false)
        return(%r)

routine U32.reverse_bits(%self: Self) -> Self
    block entry():
        %r : Self = bitreverse<Self>(%self)
        return(%r)

routine U32.count_zeros(%self: Self) -> Self
    block entry():
        %inverted : Self = %self.bitnot()
        %r        : Self = popcount<Self>(%inverted)
        return(%r)

routine U32.leading_ones(%self: Self) -> Self
    block entry():
        %inverted : Self = %self.bitnot()
        %r        : Self = clz<Self>(%inverted, false)
        return(%r)

routine U32.trailing_ones(%self: Self) -> Self
    block entry():
        %inverted : Self = %self.bitnot()
        %r        : Self = ctz<Self>(%inverted, false)
        return(%r)

routine U32.swap_bytes(%self: Self) -> Self
    block entry():
        %r : Self = bswap<Self>(%self)
        return(%r)

routine U32.to_be(%self: Self) -> Self
    block entry():
        %r : Self = %self.swap_bytes()
        return(%r)

routine U32.from_be(%self: Self) -> Self
    block entry():
        %r : Self = %self.swap_bytes()
        return(%r)

routine U32.to_le(%self: Self) -> Self
    block entry():
        return(%self)

routine U32.from_le(%self: Self) -> Self
    block entry():
        return(%self)

/// True when exactly one bit is set.
routine U32.is_power_of_two(%self: Self) -> Bool
    block entry():
        %ones : Self = popcount<Self>(%self)
        %r    : Bool = %ones.eq(1)
        return(%r)

routine U32.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = band<Self>(%self, %other)
        return(%r)

routine U32.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = bor<Self>(%self, %other)
        return(%r)

routine U32.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = bxor<Self>(%self, %other)
        return(%r)

routine U32.bitnot(%self: Self) -> Self
    block entry():
        %r : Self = bnot<Self>(%self)
        return(%r)

// -- shifts ----------------------------------------------------------------------

/// A shift by BITS or more shifts every bit out: the result is 0 (see Operations, Bitwise and Shifts).
/// The raw shift is poison then, and the select never picks it.
routine U32.shl(%self: Self, %n: Self) -> Self
    block entry():
        %in_range : Bool = %n.lt(Self.BITS)
        %shifted  : Self = shl<Self>(%self, %n)
        %r        : Self = %in_range ? %shifted : 0
        return(%r)

/// Shift right, logical: zeros fill in. A shift by BITS or more gives 0.
routine U32.shr(%self: Self, %n: Self) -> Self
    block entry():
        %in_range : Bool = %n.lt(Self.BITS)
        %shifted  : Self = lshr<Self>(%self, %n)
        %out      : Self = 0
        %r        : Self = %in_range ? %shifted : %out
        return(%r)

/// Rotates by n modulo the bit width.
routine U32.rotl(%self: Self, %n: Self) -> Self
    block entry():
        %r : Self = fshl<Self>(%self, %self, %n)
        return(%r)

routine U32.rotr(%self: Self, %n: Self) -> Self
    block entry():
        %r : Self = fshr<Self>(%self, %self, %n)
        return(%r)

/// None when n is outside 0 ..< BITS.
routine U32.shl_checked(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range : Bool = %n.lt(Self.BITS)
        branch %in_range ? continue : return(Option<Self>.Absent)
        %r : Self = shl<Self>(%self, %n)
        return(Option<Self>.Present(%r))

routine U32.shr_checked(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range : Bool = %n.lt(Self.BITS)
        branch %in_range ? continue : return(Option<Self>.Absent)
        %r : Self = lshr<Self>(%self, %n)
        return(Option<Self>.Present(%r))

/// Shifts by n modulo the bit width.
routine U32.shl_wrap(%self: Self, %n: Self) -> Self
    block entry():
        %amount : Self = band<Self>(%n, 31)
        %r      : Self = shl<Self>(%self, %amount)
        return(%r)

routine U32.shr_wrap(%self: Self, %n: Self) -> Self
    block entry():
        %amount : Self = band<Self>(%n, 31)
        %r      : Self = lshr<Self>(%self, %amount)
        return(%r)

// -- arithmetic ------------------------------------------------------------------

/// Panics on overflow.
routine U32.add(%self: Self, %other: Self) -> Self
    block entry():
        %overflow : Bool = uadd_overflows<Self>(%self, %other)
        branch %overflow ? panic(TrapCode.Overflow) : continue
        %r : Self = add<Self>(%self, %other)
        return(%r)

routine U32.add_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow : Bool         = uadd_overflows<Self>(%self, %other)
        %fits     : Bool         = %overflow.bitnot()
        %result   : Self         = add<Self>(%self, %other)
        %r        : Option<Self> = %fits.then_present(%result)
        return(%r)

/// Wraps modulo 2^32.
routine U32.add_wrap(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = add<Self>(%self, %other)
        return(%r)

/// Saturates at MIN / MAX.
routine U32.add_clamp(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = uadd_sat<Self>(%self, %other)
        return(%r)

/// Panics on overflow.
routine U32.sub(%self: Self, %other: Self) -> Self
    block entry():
        %overflow : Bool = usub_overflows<Self>(%self, %other)
        branch %overflow ? panic(TrapCode.Overflow) : continue
        %r : Self = sub<Self>(%self, %other)
        return(%r)

routine U32.sub_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow : Bool         = usub_overflows<Self>(%self, %other)
        %fits     : Bool         = %overflow.bitnot()
        %result   : Self         = sub<Self>(%self, %other)
        %r        : Option<Self> = %fits.then_present(%result)
        return(%r)

/// Wraps modulo 2^32.
routine U32.sub_wrap(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = sub<Self>(%self, %other)
        return(%r)

/// Saturates at MIN / MAX.
routine U32.sub_clamp(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = usub_sat<Self>(%self, %other)
        return(%r)

/// Panics on overflow.
routine U32.mul(%self: Self, %other: Self) -> Self
    block entry():
        %overflow : Bool = umul_overflows<Self>(%self, %other)
        branch %overflow ? panic(TrapCode.Overflow) : continue
        %r : Self = mul<Self>(%self, %other)
        return(%r)

routine U32.mul_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow : Bool         = umul_overflows<Self>(%self, %other)
        %fits     : Bool         = %overflow.bitnot()
        %result   : Self         = mul<Self>(%self, %other)
        %r        : Option<Self> = %fits.then_present(%result)
        return(%r)

/// Wraps modulo 2^32.
routine U32.mul_wrap(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = mul<Self>(%self, %other)
        return(%r)

/// Saturates at MAX.
routine U32.mul_clamp(%self: Self, %other: Self) -> Self
    block entry():
        %overflow : Bool = %self.mul_overflows(%other)
        %product  : Self = mul<Self>(%self, %other)
        %r        : Self = %overflow ? Self.MAX : %product
        return(%r)

/// Whether the exact product is outside MIN ..= MAX.
routine U32.mul_overflows(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = umul_overflows<Self>(%self, %other)
        return(%r)

/// The exact product in twice the width; it never overflows.
routine U32.mul_wide(%self: Self, %other: Self) -> U64
    block entry():
        %r : U64 = %self.to_u64().mul_wrap(%other.to_u64())
        return(%r)

// -- division --------------------------------------------------------------------

/// Panics on a zero divisor.
routine U32.div(%self: Self, %other: Self) -> Self
    block entry():
        %by_zero : Bool = %other.eq(0)
        branch %by_zero ? panic(TrapCode.DivByZero) : continue
        %r : Self = udiv<Self>(%self, %other)
        return(%r)

/// Panics on a zero divisor.
routine U32.rem(%self: Self, %other: Self) -> Self
    block entry():
        %by_zero : Bool = %other.eq(0)
        branch %by_zero ? panic(TrapCode.DivByZero) : continue
        %r : Self = urem<Self>(%self, %other)
        return(%r)

/// None on a zero divisor.
routine U32.div_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero : Bool = %other.eq(0)
        branch %by_zero ? return(Option<Self>.Absent) : continue
        %r : Self = udiv<Self>(%self, %other)
        return(Option<Self>.Present(%r))

routine U32.rem_checked(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero : Bool = %other.eq(0)
        branch %by_zero ? return(Option<Self>.Absent) : continue
        %r : Self = urem<Self>(%self, %other)
        return(Option<Self>.Present(%r))

/// Division rounding up. Panics on a zero divisor.
routine U32.div_ceil(%self: Self, %other: Self) -> Self
    block entry():
        %q     : Self = %self.div(%other)
        %rem   : Self = urem<Self>(%self, %other)
        %exact : Bool = %rem.eq(0)
        branch %exact ? return(%q) : continue
        %r : Self = add<Self>(%q, 1)
        return(%r)

/// The smallest multiple of other that is >= self. Panics on a zero other and
/// when the multiple doesn't fit.
routine U32.next_multiple_of(%self: Self, %other: Self) -> Self
    block entry():
        %rem   : Self = %self.rem(%other)
        %exact : Bool = %rem.eq(0)
        branch %exact ? return(%self) : continue
        %gap : Self = sub<Self>(%other, %rem)
        %r   : Self = %self.add(%gap)
        return(%r)

/// The smallest power of two >= self; 0 and 1 give 1. Panics when it doesn't fit.
routine U32.next_power_of_two(%self: Self) -> Self
    block entry():
        %r : Option<Self> = %self.next_power_of_two_checked()
        when %r:
            .Present(%value) -> return(%value)
            .Absent          -> panic(TrapCode.Overflow)

/// None when the power of two doesn't fit.
routine U32.next_power_of_two_checked(%self: Self) -> Option<Self>
    block entry():
        %small : Bool = %self.le(1)
        branch %small ? return(Option<Self>.Present(1)) : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up():
        %below : Self = sub<Self>(%self, 1)
        %lz    : Self = clz<Self>(%below, true)
        %shift : Self = sub<Self>(Self.BITS, %lz)
        %fits  : Bool = %shift.lt(Self.BITS)
        branch %fits ? continue : return(Option<Self>.Absent)
        %power : Self = shl<Self>(1, %shift)
        return(Option<Self>.Present(%power))

// -- powers ----------------------------------------------------------------------

/// Panics when the power doesn't fit.
routine U32.pow(%self: Self, %exponent: Self) -> Self
    block entry():
        %r : Option<Self> = %self.pow_checked(%exponent)
        when %r:
            .Present(%value) -> return(%value)
            .Absent          -> panic(TrapCode.Overflow)

/// Wrapping power by squaring.
routine U32.pow_wrap(%self: Self, %exponent: Self) -> Self
    block entry():
        jump loop(%self, %exponent, 1)

    block loop(%base: Self, %exponent: Self, %acc: Self):
        %done : Bool = %exponent.eq(0)
        branch %done ? return(%acc) : continue
        %odd       : Bool = %exponent.bitand(1).ne(0)
        %with_base : Self = mul<Self>(%acc, %base)
        %next_acc  : Self = %odd ? %with_base : %acc
        jump loop(mul<Self>(%base, %base), %exponent.shr(1), %next_acc)

/// None if any step overflows.
routine U32.pow_checked(%self: Self, %exponent: Self) -> Option<Self>
    block entry():
        jump loop(%self, %exponent, 1, false)

    block loop(%base: Self, %exponent: Self, %acc: Self, %overflow: Bool):
        %done : Bool = %exponent.eq(0)
        branch %done ? finish(%acc, %overflow) : step(%base, %exponent, %acc, %overflow)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(%base: Self, %exponent: Self, %acc: Self, %overflow: Bool):
        %odd           : Bool = %exponent.bitand(1).ne(0)
        %acc_overflow  : Bool = umul_overflows<Self>(%acc, %base).bitand(%odd)
        %with_base     : Self = mul<Self>(%acc, %base)
        %next_acc      : Self = %odd ? %with_base : %acc
        %rest          : Self = %exponent.shr(1)
        %more          : Bool = %rest.ne(0)
        %base_overflow : Bool = umul_overflows<Self>(%base, %base).bitand(%more)
        %any           : Bool = %overflow.bitor(%acc_overflow).bitor(%base_overflow)
        jump loop(mul<Self>(%base, %base), %rest, %next_acc, %any)

    block finish(%acc: Self, %overflow: Bool):
        %fits : Bool         = %overflow.bitnot()
        %r    : Option<Self> = %fits.then_present(%acc)
        return(%r)

/// MAX on overflow.
routine U32.pow_clamp(%self: Self, %exponent: Self) -> Self
    block entry():
        %checked : Option<Self> = %self.pow_checked(%exponent)
        %r       : Self         = %checked.unwrap_or(Self.MAX)
        return(%r)

// -- equality and ordering -------------------------------------------------------

routine U32.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = ieq<Self>(%self, %other)
        return(%r)

routine U32.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = ine<Self>(%self, %other)
        return(%r)

@[external("llvm"), template("{result} = icmp ult i32 {%self}, {%other}")]
routine U32.lt(%self: Self, %other: Self) -> Bool

@[external("llvm"), template("{result} = icmp ule i32 {%self}, {%other}")]
routine U32.le(%self: Self, %other: Self) -> Bool

@[external("llvm"), template("{result} = icmp ugt i32 {%self}, {%other}")]
routine U32.gt(%self: Self, %other: Self) -> Bool

@[external("llvm"), template("{result} = icmp uge i32 {%self}, {%other}")]
routine U32.ge(%self: Self, %other: Self) -> Bool

/// -1, 0, or 1.
routine U32.compare(%self: Self, %other: Self) -> S32
    block entry():
        %lt : Bool = %self.lt(%other)
        branch %lt ? return(-1) : continue
        %gt : Bool = %self.gt(%other)
        branch %gt ? return(1) : return(0)

routine U32.min(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = umin<Self>(%self, %other)
        return(%r)

routine U32.max(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = umax<Self>(%self, %other)
        return(%r)

/// Panics if lo > hi.
routine U32.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid : Bool = %lo.le(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %at_least_lo : Self = umax<Self>(%self, %lo)
        %r           : Self = umin<Self>(%at_least_lo, %hi)
        return(%r)

/// self in [lo, hi], both ends included. False when lo > hi.
routine U32.between(%self: Self, %lo: Self, %hi: Self) -> Bool
    block entry():
        %r : Bool = %self.ge(%lo).bitand(%self.le(%hi))
        return(%r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine U32.in_range(%self: Self, %lo: Self, %end: Self) -> Bool
    block entry():
        %r : Bool = %self.ge(%lo).bitand(%self.lt(%end))
        return(%r)

// -- hash ------------------------------------------------------------------------

/// xxh64 of the bits, the same hash for S32 and U32.
routine U32.hash(%self: Self) -> U64
    block entry():
        %bits : Self = bitcast<Self, Self>(%self)
        %h    : U64  = xxh64_hash_u64(%bits.to_u64(), 0)
        return(%h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// |self - other|, which always fits in U32.
routine U32.abs_diff(%self: Self, %other: Self) -> Self
    block entry():
        %hi   : Self = umax<Self>(%self, %other)
        %lo   : Self = umin<Self>(%self, %other)
        %diff : Self = sub<Self>(%hi, %lo)
        %r    : Self = bitcast<Self, Self>(%diff)
        return(%r)

/// floor((self + other) / 2) without overflow.
routine U32.midpoint(%self: Self, %other: Self) -> Self
    block entry():
        %common    : Self = %self.bitand(%other)
        %half_diff : Self = %self.bitxor(%other).shr(1)
        %r         : Self = add<Self>(%common, %half_diff)
        return(%r)

/// floor(log2(self)). Panics on 0.
routine U32.ilog2(%self: Self) -> Self
    block entry():
        %zero : Bool = %self.eq(0)
        branch %zero ? panic(TrapCode.InvalidArgument) : continue
        %lz : Self = clz<Self>(%self, true)
        %r  : Self = sub<Self>(Self.BITS.sub(1), %lz)
        return(%r)

/// floor(log10(self)). Panics on 0.
routine U32.ilog10(%self: Self) -> Self
    block entry():
        %zero : Bool = %self.eq(0)
        branch %zero ? panic(TrapCode.InvalidArgument) : loop(%self, 0)

    block loop(%rest: Self, %digits: Self):
        %last : Bool = %rest.lt(10)
        branch %last ? return(%digits) : continue
        jump loop(%rest.div(10), %digits.add(1))

/// floor(sqrt(self)), computed one result bit at a time.
routine U32.isqrt(%self: Self) -> Self
    block entry():
        %top_bit : Self = shl<Self>(1, Self.BITS.sub(2))
        jump align(%top_bit)

    // Start from the highest power of four that is <= self.
    block align(%bit: Self):
        %too_big : Bool = %bit.gt(%self)
        branch %too_big ? align(%bit.shr(2)) : loop(%self, 0, %bit)

    block loop(%rest: Self, %root: Self, %bit: Self):
        %done : Bool = %bit.eq(0)
        branch %done ? return(%root) : continue
        %trial     : Self = add<Self>(%root, %bit)
        %fits      : Bool = %rest.ge(%trial)
        %half_root : Self = %root.shr(1)
        %next_bit  : Self = %bit.shr(2)
        branch %fits ? take(%rest, %trial, %half_root, %bit, %next_bit) \
                     : loop(%rest, %half_root, %next_bit)

    block take(%rest: Self, %trial: Self, %half_root: Self, %bit: Self, %next_bit: Self):
        jump loop(sub<Self>(%rest, %trial), add<Self>(%half_root, %bit), %next_bit)

// -- conversions -----------------------------------------------------------------

/// to_<type> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly; one that can panics when the value
/// doesn't fit, and has _checked (Option), _wrap (keep the low bits), and _clamp
/// (saturate) forms.
/// Panics when the value doesn't fit in S8.
routine U32.to_s8(%self: Self) -> S8
    block entry():
        %fits : Bool = %self.le(127)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : S8 = trunc<Self, S8>(%self)
        return(%r)

routine U32.to_s8_checked(%self: Self) -> Option<S8>
    block entry():
        %fits  : Bool       = %self.le(127)
        %value : S8         = trunc<Self, S8>(%self)
        %r     : Option<S8> = %fits.then_present(%value)
        return(%r)

/// Keeps the low 8 bits (modulo 2^8).
routine U32.to_s8_wrap(%self: Self) -> S8
    block entry():
        %r : S8 = trunc<Self, S8>(%self)
        return(%r)

/// Saturates at S8's range.
routine U32.to_s8_clamp(%self: Self) -> S8
    block entry():
        %at_most : Self = umin<Self>(%self, 127)
        %r       : S8   = trunc<Self, S8>(%at_most)
        return(%r)

/// Panics when the value doesn't fit in S16.
routine U32.to_s16(%self: Self) -> S16
    block entry():
        %fits : Bool = %self.le(32767)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : S16 = trunc<Self, S16>(%self)
        return(%r)

routine U32.to_s16_checked(%self: Self) -> Option<S16>
    block entry():
        %fits  : Bool        = %self.le(32767)
        %value : S16         = trunc<Self, S16>(%self)
        %r     : Option<S16> = %fits.then_present(%value)
        return(%r)

/// Keeps the low 16 bits (modulo 2^16).
routine U32.to_s16_wrap(%self: Self) -> S16
    block entry():
        %r : S16 = trunc<Self, S16>(%self)
        return(%r)

/// Saturates at S16's range.
routine U32.to_s16_clamp(%self: Self) -> S16
    block entry():
        %at_most : Self = umin<Self>(%self, 32767)
        %r       : S16  = trunc<Self, S16>(%at_most)
        return(%r)

/// Panics when the value doesn't fit in S32.
routine U32.to_s32(%self: Self) -> S32
    block entry():
        %fits : Bool = %self.le(2147483647)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : S32 = bitcast<Self, S32>(%self)
        return(%r)

routine U32.to_s32_checked(%self: Self) -> Option<S32>
    block entry():
        %fits  : Bool        = %self.le(2147483647)
        %value : S32         = bitcast<Self, S32>(%self)
        %r     : Option<S32> = %fits.then_present(%value)
        return(%r)

/// Keeps the low 32 bits (modulo 2^32).
routine U32.to_s32_wrap(%self: Self) -> S32
    block entry():
        %r : S32 = bitcast<Self, S32>(%self)
        return(%r)

/// Saturates at S32's range.
routine U32.to_s32_clamp(%self: Self) -> S32
    block entry():
        %at_most : Self = umin<Self>(%self, 2147483647)
        %r       : S32  = bitcast<Self, S32>(%at_most)
        return(%r)

routine U32.to_s64(%self: Self) -> S64
    block entry():
        %r : S64 = zext<Self, S64>(%self)
        return(%r)

routine U32.to_s128(%self: Self) -> S128
    block entry():
        %r : S128 = zext<Self, S128>(%self)
        return(%r)

routine U32.to_s256(%self: Self) -> S256
    block entry():
        %r : S256 = zext<Self, S256>(%self)
        return(%r)

/// Panics when the value doesn't fit in U8.
routine U32.to_u8(%self: Self) -> U8
    block entry():
        %fits : Bool = %self.le(255)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : U8 = trunc<Self, U8>(%self)
        return(%r)

routine U32.to_u8_checked(%self: Self) -> Option<U8>
    block entry():
        %fits  : Bool       = %self.le(255)
        %value : U8         = trunc<Self, U8>(%self)
        %r     : Option<U8> = %fits.then_present(%value)
        return(%r)

/// Keeps the low 8 bits (modulo 2^8).
routine U32.to_u8_wrap(%self: Self) -> U8
    block entry():
        %r : U8 = trunc<Self, U8>(%self)
        return(%r)

/// Saturates at U8's range.
routine U32.to_u8_clamp(%self: Self) -> U8
    block entry():
        %at_most : Self = umin<Self>(%self, 255)
        %r       : U8   = trunc<Self, U8>(%at_most)
        return(%r)

/// Panics when the value doesn't fit in U16.
routine U32.to_u16(%self: Self) -> U16
    block entry():
        %fits : Bool = %self.le(65535)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : U16 = trunc<Self, U16>(%self)
        return(%r)

routine U32.to_u16_checked(%self: Self) -> Option<U16>
    block entry():
        %fits  : Bool        = %self.le(65535)
        %value : U16         = trunc<Self, U16>(%self)
        %r     : Option<U16> = %fits.then_present(%value)
        return(%r)

/// Keeps the low 16 bits (modulo 2^16).
routine U32.to_u16_wrap(%self: Self) -> U16
    block entry():
        %r : U16 = trunc<Self, U16>(%self)
        return(%r)

/// Saturates at U16's range.
routine U32.to_u16_clamp(%self: Self) -> U16
    block entry():
        %at_most : Self = umin<Self>(%self, 65535)
        %r       : U16  = trunc<Self, U16>(%at_most)
        return(%r)

routine U32.to_u32(%self: Self) -> Self
    block entry():
        return(%self)

routine U32.to_u64(%self: Self) -> U64
    block entry():
        %r : U64 = zext<Self, U64>(%self)
        return(%r)

routine U32.to_u128(%self: Self) -> U128
    block entry():
        %r : U128 = zext<Self, U128>(%self)
        return(%r)

routine U32.to_u256(%self: Self) -> U256
    block entry():
        %r : U256 = zext<Self, U256>(%self)
        return(%r)

/// Rounds to nearest, ties to even.
routine U32.to_f32(%self: Self) -> F32
    block entry():
        %r : F32 = uitofp<Self, F32>(%self)
        return(%r)

/// Rounds to nearest, ties to even.
routine U32.to_f64(%self: Self) -> F64
    block entry():
        %r : F64 = uitofp<Self, F64>(%self)
        return(%r)

// -- characters ------------------------------------------------------------------

/// Panics when the value isn't a Unicode scalar value (above 0x10FFFF, or a
/// surrogate in 0xD800 ..= 0xDFFF).
routine U32.to_char(%self: Self) -> Char
    block entry():
        %r : Option<Char> = %self.to_char_checked()
        when %r:
            .Present(%value) -> return(%value)
            .Absent          -> panic(TrapCode.InvalidArgument)

routine U32.to_char_checked(%self: Self) -> Option<Char>
    block entry():
        %in_range  : Bool         = %self.le(1114111)
        %surrogate : Bool         = %self.between(55296, 57343)
        %valid     : Bool         = %in_range.bitand(%surrogate.bitnot())
        %c         : Char         = bitcast<Self, Char>(%self)
        %r         : Option<Char> = %valid.then_present(%c)
        return(%r)
