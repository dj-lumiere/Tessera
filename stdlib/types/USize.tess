    block entry():
        %fits  : Bool          = %self.between(0, 18446744073709551615)
        %value : USize         = trunc<Self, USize>(%self)
        %r     : Option<USize> = %fits.then_present(%value)
        return(%r)

@target(size: 32)
routine S256.to_usize_checked(%self: Self) -> Option<USize>
    block entry():
        %fits  : Bool          = %self.between(0, 4294967295)
        %value : USize         = trunc<Self, USize>(%self)
        %r     : Option<USize> = %fits.then_present(%value)
        return(%r)

/// Keeps the low 64 bits (modulo 2^64).
@target(size: 64)
routine S256.to_usize_wrap(%self: Self) -> USize
    block entry():
        %r : USize = trunc<Self, USize>(%self)
        return(%r)

/// Keeps the low 32 bits (modulo 2^32).
@target(size: 32)
routine S256.to_usize_wrap(%self: Self) -> USize
    block entry():
        %r : USize = trunc<Self, USize>(%self)
        return(%r)

/// Saturates at USize's range.
@target(size: 64)
routine S256.to_usize_clamp(%self: Self) -> USize
    block entry():
        %at_least : Self  = smax<Self>(%self, 0)
        %at_most  : Self  = smin<Self>(%at_least, 18446744073709551615)
        %r        : USize = trunc<Self, USize>(%at_most)
        return(%r)

/// Saturates at USize's range.
@target(size: 32)
routine S256.to_usize_clamp(%self: Self) -> USize
    block entry():
        %at_least : Self  = smax<Self>(%self, 0)
        %at_most  : Self  = smin<Self>(%at_least, 4294967295)
        %r        : USize = trunc<Self, USize>(%at_most)
        return(%r)

routine U8.to_usize(%self: Self) -> USize
    block entry():
        %r : USize = zext<Self, USize>(%self)
        return(%r)

routine U16.to_usize(%self: Self) -> USize
    block entry():
        %r : USize = zext<Self, USize>(%self)
        return(%r)

@target(size: 64)
routine U32.to_usize(%self: Self) -> USize
    block entry():
        %r : USize = zext<Self, USize>(%self)
        return(%r)

@target(size: 32)
routine U32.to_usize(%self: Self) -> USize
    block entry():
        %r : USize = bitcast<Self, USize>(%self)
        return(%r)

routine U32.to_usize_checked(%self: Self) -> Option<USize>
    block entry():
        %r : USize = %self.to_usize()
        return(Option<USize>.Present(%r))

routine U32.to_usize_wrap(%self: Self) -> USize
    block entry():
        %r : USize = %self.to_usize()
        return(%r)

routine U32.to_usize_clamp(%self: Self) -> USize
    block entry():
        %r : USize = %self.to_usize()
        return(%r)

@target(size: 64)
routine U64.to_usize(%self: Self) -> USize
    block entry():
        %r : USize = bitcast<Self, USize>(%self)
        return(%r)

/// Panics when the value doesn't fit in USize.
@target(size: 32)
routine U64.to_usize(%self: Self) -> USize
    block entry():
        %fits : Bool = %self.le(4294967295)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : USize = trunc<Self, USize>(%self)
        return(%r)

