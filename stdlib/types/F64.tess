// Tessera stdlib: F64 — 64-bit IEEE 754 floating-point
//
// Maps to LLVM IR double.

module Standard::Core

@llvm("double")
record F64
conform Equal<F64>, Compare<F64>, Hash<F64>

// -- constants -----------------------------------------------------------------

preset F64.INFINITY:     F64 = F64.from_bits(0x7FF0000000000000)  // +inf bits
preset F64.NEG_INFINITY: F64 = F64.from_bits(0xFFF0000000000000)  // -inf bits
preset F64.NAN:          F64 = F64.from_bits(0x7FF8000000000000)  // canonical quiet NaN bits

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine F64.abs(%self: Self) -> Self
    block entry():
        %r : Self = fabs<Self>(%self)
        return(%r)

/// The smaller value; if one operand is NaN, the other one.
routine F64.min(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = minnum<Self>(%self, %other)
        return(%r)

/// The larger value; if one operand is NaN, the other one.
routine F64.max(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = maxnum<Self>(%self, %other)
        return(%r)

routine F64.add(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fadd<Self>(%self, %other)
        return(%r)

routine F64.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fsub<Self>(%self, %other)
        return(%r)

routine F64.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fmul<Self>(%self, %other)
        return(%r)

// -- comparisons ---------------------------------------------------------------

routine F64.lt(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = flt<Self>(%self, %other)
        return(%r)

routine F64.le(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fle<Self>(%self, %other)
        return(%r)

routine F64.gt(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fgt<Self>(%self, %other)
        return(%r)

routine F64.ge(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fge<Self>(%self, %other)
        return(%r)

// -- division ------------------------------------------------------------------

routine F64.div(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = fdiv<Self>(%self, %other)
        return(%r)

// -- equality, ordering, hashing -----------------------------------------------

routine F64.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = feq<Self>(%self, %other)
        return(%r)

routine F64.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = fne<Self>(%self, %other)
        return(%r)

routine F64.compare(%self: Self, %other: Self) -> S32
    block entry():
        %lt : Bool = %self.lt(%other)
        branch %lt ? return(-1) : continue
        %gt : Bool = %self.gt(%other)
        branch %gt ? return(1) : return(0)

routine F64.hash(%self: Self) -> U64
    block entry():
        %bits : U64 = %self.bits()
        %h    : U64 = xxh64_hash_u64(%bits, 0)
        return(%h)

// -- generic conversions -------------------------------------------------------

routine F64.fptrunc<To>(%self: Self) -> To
require To: typename
    block entry():
        %r : To = fptrunc<Self, To>(%self)
        return(%r)

routine F64.fptosi<To>(%self: Self) -> To
require To: typename
    block entry():
        %r : To = fptosi<Self, To>(%self)
        return(%r)

// -- named narrowing conversion ------------------------------------------------

routine F64.to_f32(%self: Self) -> F32
    block entry():
        %result : F32 = fptrunc<Self, F32>(%self)
        return(%result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

preset F64.MAX:          F64 = F64.from_bits(0x7FEFFFFFFFFFFFFF)  // largest finite value
preset F64.MIN:          F64 = F64.from_bits(0xFFEFFFFFFFFFFFFF)  // most negative finite value
preset F64.MIN_POSITIVE: F64 = F64.from_bits(0x0010000000000000)  // smallest positive normal value
preset F64.EPSILON:      F64 = F64.from_bits(0x3CB0000000000000)  // the gap between 1.0 and the next value

preset F64.PI: F64 = 3.14159265358979323846264338327950288  // pi
preset F64.TAU: F64 = 6.28318530717958647692528676655900577  // 2 pi
preset F64.E: F64 = 2.71828182845904523536028747135266250  // Euler's number
preset F64.FRAC_PI_2: F64 = 1.57079632679489661923132169163975144  // pi / 2
preset F64.FRAC_PI_4: F64 = 0.785398163397448309615660845819875721  // pi / 4
preset F64.FRAC_1_PI: F64 = 0.318309886183790671537767526745028724  // 1 / pi
preset F64.SQRT_2: F64 = 1.41421356237309504880168872420969808  // sqrt(2)
preset F64.FRAC_1_SQRT_2: F64 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
preset F64.LN_2: F64 = 0.693147180559945309417232121458176568  // ln(2)
preset F64.LN_10: F64 = 2.30258509299404568401799145468436421  // ln(10)
preset F64.LOG2_E: F64 = 1.44269504088896340735992468100189214  // log2(e)
preset F64.LOG10_E: F64 = 0.434294481903251827651128918916605082  // log10(e)

// -- C math library -----------------------------------------------------------

// -- sign ----------------------------------------------------------------------

routine F64.neg(%self: Self) -> Self
    block entry():
        %r : Self = fneg<Self>(%self)
        return(%r)

/// The magnitude of self with the sign of %sign.
routine F64.copysign(%self: Self, %sign: Self) -> Self
    block entry():
        %r : Self = copysign<Self>(%self, %sign)
        return(%r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine F64.signum(%self: Self) -> Self
    block entry():
        %nan  : Bool = %self.is_nan()
        %unit : Self = copysign<Self>(1.0, %self)
        %r    : Self = %nan ? %self : %unit
        return(%r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine F64.is_sign_positive(%self: Self) -> Bool
    block entry():
        %bits : S64  = %self.bits().to_s64_wrap()
        %r    : Bool = %bits.ge(0)
        return(%r)

routine F64.is_sign_negative(%self: Self) -> Bool
    block entry():
        %bits : S64  = %self.bits().to_s64_wrap()
        %r    : Bool = %bits.lt(0)
        return(%r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of self / other, with the sign of self (C fmod; Rust's %).
routine F64.rem(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = frem<Self>(%self, %other)
        return(%r)

routine F64.recip(%self: Self) -> Self
    block entry():
        %r : Self = fdiv<Self>(1.0, %self)
        return(%r)

/// self * a + b with a single rounding.
routine F64.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r : Self = fma<Self>(%self, %a, %b)
        return(%r)

/// The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine F64.div_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %q            : Self = %self.div(%other).trunc()
        %rem          : Self = frem<Self>(%self, %other)
        %rem_negative : Bool = %rem.lt(0.0)
        branch %rem_negative ? continue : return(%q)
        %positive_divisor : Bool = %other.gt(0.0)
        %down             : Self = %q.sub(1.0)
        %up               : Self = %q.add(1.0)
        %r                : Self = %positive_divisor ? %down : %up
        return(%r)

/// The least non-negative remainder of self / other.
routine F64.rem_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %rem          : Self = frem<Self>(%self, %other)
        %rem_negative : Bool = %rem.lt(0.0)
        branch %rem_negative ? continue : return(%rem)
        %magnitude : Self = %other.abs()
        %r         : Self = %rem.add(%magnitude)
        return(%r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine F64.minimum(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = minimum<Self>(%self, %other)
        return(%r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine F64.maximum(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = maximum<Self>(%self, %other)
        return(%r)

/// Restricts self to %lo ..= %hi; NaN stays NaN. Traps unless %lo <= %hi.
routine F64.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid : Bool = %lo.le(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %below : Bool = %self.lt(%lo)
        %above : Bool = %self.gt(%hi)
        %upper : Self = %above ? %hi : %self
        %r     : Self = %below ? %lo : %upper
        return(%r)

/// %self in [%lo, %hi], both ends included. False when %lo > %hi.
routine F64.between(%self: Self, %lo: Self, %hi: Self) -> Bool
    block entry():
        %r : Bool = %self.ge(%lo).bitand(%self.le(%hi))
        return(%r)

/// %self in [%lo, %end): %lo included, %end not. False when %lo >= %end.
routine F64.in_range(%self: Self, %lo: Self, %end: Self) -> Bool
    block entry():
        %r : Bool = %self.ge(%lo).bitand(%self.lt(%end))
        return(%r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine F64.total_compare(%self: Self, %other: Self) -> S32
    block entry():
        %a : S64 = %self.bits().to_s64_wrap()
        %b : S64 = %other.bits().to_s64_wrap()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        %a_key : S64 = %a.bitxor(%a.shr(63).bitand(S64.MAX))
        %b_key : S64 = %b.bitxor(%b.shr(63).bitand(S64.MAX))
        %r     : S32 = %a_key.compare(%b_key)
        return(%r)

// -- rounding ------------------------------------------------------------------

routine F64.floor(%self: Self) -> Self
    block entry():
        %r : Self = floor<Self>(%self)
        return(%r)

routine F64.ceil(%self: Self) -> Self
    block entry():
        %r : Self = ceil<Self>(%self)
        return(%r)

/// Rounds half-way cases away from zero.
routine F64.round(%self: Self) -> Self
    block entry():
        %r : Self = round<Self>(%self)
        return(%r)

/// Rounds half-way cases to the even neighbor.
routine F64.round_ties_even(%self: Self) -> Self
    block entry():
        %r : Self = rint<Self>(%self)
        return(%r)

/// Rounds toward zero.
routine F64.trunc(%self: Self) -> Self
    block entry():
        %r : Self = ftrunc<Self>(%self)
        return(%r)

/// self minus its integer part, with the sign of self.
routine F64.fract(%self: Self) -> Self
    block entry():
        %whole : Self = %self.trunc()
        %r     : Self = %self.sub(%whole)
        return(%r)

// -- powers --------------------------------------------------------------------

/// NaN for negative values (other than -0.0).
routine F64.sqrt(%self: Self) -> Self
    block entry():
        %r : Self = sqrt<Self>(%self)
        return(%r)

routine F64.cbrt(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_cbrt(%self)
        return(%r)

/// self raised to an integer power, by repeated squaring.
routine F64.powi(%self: Self, %n: S32) -> Self
    block entry():
        %negative  : Bool = %n.lt(0)
        %magnitude : U32  = %n.abs_diff(0)
        jump loop(%self, %magnitude, 1.0, %negative)

    block loop(%base: Self, %exponent: U32, %acc: Self, %negative: Bool):
        %done : Bool = %exponent.eq(0)
        branch %done ? finish(%acc, %negative) : step(%base, %exponent, %acc, %negative)

    block step(%base: Self, %exponent: U32, %acc: Self, %negative: Bool):
        %odd       : Bool = %exponent.bitand(1).ne(0)
        %with_base : Self = %acc.mul(%base)
        %next_acc  : Self = %odd ? %with_base : %acc
        jump loop(%base.mul(%base), %exponent.shr(1), %next_acc, %negative)

    block finish(%acc: Self, %negative: Bool):
        %inverse : Self = %acc.recip()
        %r       : Self = %negative ? %inverse : %acc
        return(%r)

routine F64.powf(%self: Self, %exponent: Self) -> Self
    block entry():
        %r : Self = f64_cm_pow(%self, %exponent)
        return(%r)

/// e^self
routine F64.exp(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_exp(%self)
        return(%r)

/// 2^self
routine F64.exp2(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_exp2(%self)
        return(%r)

/// e^self - 1, accurate near 0.
routine F64.exp_m1(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_expm1(%self)
        return(%r)

/// The natural logarithm.
routine F64.ln(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_log(%self)
        return(%r)

routine F64.log2(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_log2(%self)
        return(%r)

routine F64.log10(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_log10(%self)
        return(%r)

/// ln(1 + self), accurate near 0.
routine F64.ln_1p(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_log1p(%self)
        return(%r)

/// The logarithm with an arbitrary base.
routine F64.log(%self: Self, %base: Self) -> Self
    block entry():
        %num : Self = %self.ln()
        %den : Self = %base.ln()
        %r   : Self = %num.div(%den)
        return(%r)

/// sqrt(self^2 + other^2) without intermediate overflow.
routine F64.hypot(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = f64_cm_hypot(%self, %other)
        return(%r)

// -- trigonometry --------------------------------------------------------------

/// In radians.
routine F64.sin(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_sin(%self)
        return(%r)

/// In radians.
routine F64.cos(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_cos(%self)
        return(%r)

/// In radians.
routine F64.tan(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_tan(%self)
        return(%r)

routine F64.asin(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_asin(%self)
        return(%r)

routine F64.acos(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_acos(%self)
        return(%r)

routine F64.atan(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_atan(%self)
        return(%r)

routine F64.sinh(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_sinh(%self)
        return(%r)

routine F64.cosh(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_cosh(%self)
        return(%r)

routine F64.tanh(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_tanh(%self)
        return(%r)

routine F64.asinh(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_asinh(%self)
        return(%r)

routine F64.acosh(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_acosh(%self)
        return(%r)

routine F64.atanh(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_atanh(%self)
        return(%r)

/// The angle of the point (other, self): self is y and %other is x.
routine F64.atan2(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = f64_cm_atan2(%self, %other)
        return(%r)

// -- special functions ---------------------------------------------------------

/// The error function.
routine F64.erf(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_erf(%self)
        return(%r)

/// 1 - erf(self), accurate where erf is near 1.
routine F64.erfc(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_erfc(%self)
        return(%r)

/// Γ(self): ±inf at ±0, NaN at the negative integers and -inf.
routine F64.gamma(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_tgamma(%self)
        return(%r)

/// ln |Γ(self)|: +inf at 0 and the negative integers.
routine F64.ln_gamma(%self: Self) -> Self
    block entry():
        %r : Self = f64_cm_lgamma(%self)
        return(%r)

routine F64.to_degrees(%self: Self) -> Self
    block entry():
        %r : Self = %self.mul(57.2957795130823208767981548141051703)
        return(%r)

routine F64.to_radians(%self: Self) -> Self
    block entry():
        %r : Self = %self.mul(0.0174532925199432957692369076848861271)
        return(%r)

// -- classification ------------------------------------------------------------

routine F64.is_nan(%self: Self) -> Bool
    block entry():
        %r : Bool = funo<Self>(%self, %self)
        return(%r)

routine F64.is_infinite(%self: Self) -> Bool
    block entry():
        %magnitude : Self = fabs<Self>(%self)
        %r         : Bool = %magnitude.eq(Self.INFINITY)
        return(%r)

/// Neither infinite nor NaN.
routine F64.is_finite(%self: Self) -> Bool
    block entry():
        %magnitude : Self = fabs<Self>(%self)
        %r         : Bool = %magnitude.lt(Self.INFINITY)
        return(%r)

/// Not zero, subnormal, infinite, or NaN.
routine F64.is_normal(%self: Self) -> Bool
    block entry():
        %exponent : U64  = %self.bits().bitand(0x7FF0000000000000)
        %r        : Bool = %exponent.ne(0).bitand(%exponent.ne(0x7FF0000000000000))
        return(%r)

routine F64.is_subnormal(%self: Self) -> Bool
    block entry():
        %bits     : U64  = %self.bits()
        %exponent : U64  = %bits.bitand(0x7FF0000000000000)
        %mantissa : U64  = %bits.bitand(0x000FFFFFFFFFFFFF)
        %r        : Bool = %exponent.eq(0).bitand(%mantissa.ne(0))
        return(%r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
routine F64.bits(%self: Self) -> U64
    block entry():
        %r : U64 = bitcast<Self, U64>(%self)
        return(%r)

routine F64.from_bits(%bits: U64) -> Self
    block entry():
        %r : Self = bitcast<U64, Self>(%bits)
        return(%r)

// -- float conversions -----------------------------------------------------------

/// %a + %b rounded to odd: truncated toward zero, with the lowest bit set when the sum is inexact. A narrower
/// format with at most 51 bits rounds it to nearest exactly as it would the true sum, so F16's and BF16's
/// mul_add add their exact F64 product this way and narrow once. Finite inputs; an infinite or NaN sum is
/// returned as the addition gives it.
routine f64_add_round_to_odd(%a: F64, %b: F64) -> F64
    block entry():
        %s      : F64  = %a.add(%b)
        %finite : Bool = %s.is_finite()
        branch %finite ? error(%s) : return(%s)

    // TwoSum: e is exactly (a + b) - s.
    block error(%s: F64):
        %bv      : F64  = %s.sub(%a)
        %av      : F64  = %s.sub(%bv)
        %e       : F64  = %a.sub(%av).add(%b.sub(%bv))
        %inexact : Bool = %e.ne(0.0)
        %even    : Bool = %s.bits().bitand(1).eq(0)
        %bump    : Bool = %inexact.bitand(%even)
        branch %bump ? toward(%s, %e) : return(%s)

    // s rounded to an even neighbour: the odd one is the other neighbour of the true sum, one ulp toward e.
    block toward(%s: F64, %e: F64):
        %outward : Bool = %e.is_sign_negative().eq(%s.is_sign_negative())
        %bits    : U64  = %s.bits()
        %odd     : U64  = %outward ? %bits.add_wrap(1) : %bits.sub_wrap(1)
        return(F64.from_bits(%odd))

/// Narrows to F32 with round-to-odd, then rounds that to F16; F32's 24 bits are
/// enough (2 * 11 + 2) for the second rounding to be exact.
routine F64.to_f16(%self: Self) -> F16
    block entry():
        %narrow  : F32  = fptrunc<Self, F32>(%self)
        %back    : Self = %narrow.to_f64()
        %inexact : Bool = %back.ne(%self)
        %finite  : Bool = %narrow.is_finite()
        %sticky  : Bool = %inexact.bitand(%finite)
        // Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
        %away  : Bool = %sticky.bitand(%back.abs().gt(%self.abs()))
        %trunc : U32  = %narrow.bits().sub(%away.to_u32())
        %bits  : U32  = %trunc.bitor(%sticky.to_u32())
        %odd   : F32  = .from_bits(%bits)
        %r     : F16  = %odd.to_f16()
        return(%r)

/// Narrows to F32 with round-to-odd (an inexact result gets its lowest bit set),
/// then rounds that to BF16. Round-to-odd keeps the second rounding from
/// double-rounding, because F32 has more than twice BF16's precision.
routine F64.to_bf16(%self: Self) -> BF16
    block entry():
        %narrow  : F32  = fptrunc<Self, F32>(%self)
        %back    : Self = %narrow.to_f64()
        %inexact : Bool = %back.ne(%self)
        %finite  : Bool = %narrow.is_finite()
        %sticky  : Bool = %inexact.bitand(%finite)
        // Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
        %away  : Bool = %sticky.bitand(%back.abs().gt(%self.abs()))
        %trunc : U32  = %narrow.bits().sub(%away.to_u32())
        %bits  : U32  = %trunc.bitor(%sticky.to_u32())
        %odd   : F32  = .from_bits(%bits)
        %r     : BF16 = %odd.to_bf16()
        return(%r)

routine F64.to_f64(%self: Self) -> Self
    block entry():
        return(%self)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and panics on NaN or a value out of the integer's
// range; to_<int>_checked returns None instead, and to_<int>_clamp saturates
// (NaN gives 0).

routine F64.to_s8(%self: Self) -> S8
    block entry():
        %fits : Bool = %self.fits_int(-128.0, 128.0)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : S8 = fptosi_sat<Self, S8>(%self)
        return(%r)

routine F64.to_s8_checked(%self: Self) -> Option<S8>
    block entry():
        %fits  : Bool       = %self.fits_int(-128.0, 128.0)
        %value : S8         = fptosi_sat<Self, S8>(%self)
        %r     : Option<S8> = %fits.then_present(%value)
        return(%r)

routine F64.to_s8_clamp(%self: Self) -> S8
    block entry():
        %r : S8 = fptosi_sat<Self, S8>(%self)
        return(%r)

routine F64.to_s16(%self: Self) -> S16
    block entry():
        %fits : Bool = %self.fits_int(-32768.0, 32768.0)
        branch %fits ? continue : panic(TrapCode.Overflow)
        %r : S16 = fptosi_sat<Self, S16>(%self)
        return(%r)

