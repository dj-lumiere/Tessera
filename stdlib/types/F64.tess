; Tessera stdlib: F64 — 64-bit IEEE 754 floating-point
;
; Maps to LLVM IR double.

@llvm("double")
struct F64
conform Equal<F64>, Compare<F64>, Hash<F64>

; -- constants -----------------------------------------------------------------

const F64.INFINITY:     F64 = 0x7FF0000000000000  ; +inf bits
const F64.NEG_INFINITY: F64 = 0xFFF0000000000000  ; -inf bits
const F64.NAN:          F64 = 0x7FF8000000000000  ; canonical quiet NaN bits

; -- arithmetic ----------------------------------------------------------------

; Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine F64.abs(%self: Self) -> Self
    block entry():
        %r: Self = fabs<Self>(%self)
        return(%r)

; The smaller value; if one operand is NaN, the other one.
routine F64.min(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = minnum<Self>(%self, %other)
        return(%r)

; The larger value; if one operand is NaN, the other one.
routine F64.max(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = maxnum<Self>(%self, %other)
        return(%r)

routine F64.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fadd<Self>(%self, %other)
        return(%r)

routine F64.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fsub<Self>(%self, %other)
        return(%r)

routine F64.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fmul<Self>(%self, %other)
        return(%r)

; -- comparisons ---------------------------------------------------------------

routine F64.lt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = flt<Self>(%self, %other)
        return(%r)

routine F64.le(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fle<Self>(%self, %other)
        return(%r)

routine F64.gt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fgt<Self>(%self, %other)
        return(%r)

routine F64.ge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fge<Self>(%self, %other)
        return(%r)

; -- division ------------------------------------------------------------------

routine F64.fdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fdiv<Self>(%self, %other)
        return(%r)

; -- equality, ordering, hashing -----------------------------------------------

routine F64.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = feq<Self>(%self, %other)
        return(%r)

routine F64.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fne<Self>(%self, %other)
        return(%r)

routine F64.compare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.lt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.gt(%other)
        branch %gt ? return(1) : return(0)

routine F64.hash(%self: Self) -> I64
    block entry():
        %bits: I64 = bitcast<Self, I64>(%self)
        %h: I64 = xxh64_hash_i64(%bits, 0)
        return(%h)

; -- generic conversions -------------------------------------------------------

routine F64.fptrunc<To>(%self: Self) -> To
require To: typename
    block entry():
        %r: To = fptrunc<Self, To>(%self)
        return(%r)

routine F64.fptosi<To>(%self: Self) -> To
require To: typename
    block entry():
        %r: To = fptosi<Self, To>(%self)
        return(%r)

; -- named narrowing conversion ------------------------------------------------

routine F64.to_f32(%self: Self) -> F32
    block entry():
        %result: F32 = fptrunc<Self, F32>(%self)
        return(%result)

routine F64.to_i32(%self: Self) -> I32
    block entry():
        %r: I32 = fptosi_sat<Self, I32>(%self)
        return(%r)

routine F64.to_i64(%self: Self) -> I64
    block entry():
        %r: I64 = fptosi_sat<Self, I64>(%self)
        return(%r)

; ============================================================
; Rust-level operations
; ============================================================

; -- constants ------------------------------------------------------------------

const F64.MAX:          F64 = 0x7FEFFFFFFFFFFFFF  ; largest finite value
const F64.MIN:          F64 = 0xFFEFFFFFFFFFFFFF  ; most negative finite value
const F64.MIN_POSITIVE: F64 = 0x0010000000000000  ; smallest positive normal value
const F64.EPSILON:      F64 = 0x3CB0000000000000  ; the gap between 1.0 and the next value

const F64.PI: F64 = 3.14159265358979323846264338327950288  ; pi
const F64.TAU: F64 = 6.28318530717958647692528676655900577  ; 2 pi
const F64.E: F64 = 2.71828182845904523536028747135266250  ; Euler's number
const F64.FRAC_PI_2: F64 = 1.57079632679489661923132169163975144  ; pi / 2
const F64.FRAC_PI_4: F64 = 0.785398163397448309615660845819875721  ; pi / 4
const F64.FRAC_1_PI: F64 = 0.318309886183790671537767526745028724  ; 1 / pi
const F64.SQRT_2: F64 = 1.41421356237309504880168872420969808  ; sqrt(2)
const F64.FRAC_1_SQRT_2: F64 = 0.707106781186547524400844362104849039  ; 1 / sqrt(2)
const F64.LN_2: F64 = 0.693147180559945309417232121458176568  ; ln(2)
const F64.LN_10: F64 = 2.30258509299404568401799145468436421  ; ln(10)
const F64.LOG2_E: F64 = 1.44269504088896340735992468100189214  ; log2(e)
const F64.LOG10_E: F64 = 0.434294481903251827651128918916605082  ; log10(e)

; -- C math library -----------------------------------------------------------

@[external("c"), callconv("c"), symbol("cbrt")]
routine c_cbrt(%x: F64) -> F64

@[external("c"), callconv("c"), symbol("expm1")]
routine c_expm1(%x: F64) -> F64

@[external("c"), callconv("c"), symbol("log1p")]
routine c_log1p(%x: F64) -> F64

@[external("c"), callconv("c"), symbol("hypot")]
routine c_hypot(%x: F64, %y: F64) -> F64

@[external("c"), callconv("c"), symbol("asinh")]
routine c_asinh(%x: F64) -> F64

@[external("c"), callconv("c"), symbol("acosh")]
routine c_acosh(%x: F64) -> F64

@[external("c"), callconv("c"), symbol("atanh")]
routine c_atanh(%x: F64) -> F64

; -- sign ----------------------------------------------------------------------

routine F64.neg(%self: Self) -> Self
    block entry():
        %r: Self = fneg<Self>(%self)
        return(%r)

; The magnitude of self with the sign of %sign.
routine F64.copysign(%self: Self, %sign: Self) -> Self
    block entry():
        %r: Self = copysign<Self>(%self, %sign)
        return(%r)

; 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine F64.signum(%self: Self) -> Self
    block entry():
        %nan: Bool = %self.is_nan()
        %unit: Self = copysign<Self>(1.0, %self)
        %r: Self = %nan ? %self : %unit
        return(%r)

; Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine F64.is_sign_positive(%self: Self) -> Bool
    block entry():
        %bits: I64 = %self.to_bits()
        %r: Bool = %bits.sge(0)
        return(%r)

routine F64.is_sign_negative(%self: Self) -> Bool
    block entry():
        %bits: I64 = %self.to_bits()
        %r: Bool = %bits.slt(0)
        return(%r)

; -- arithmetic ----------------------------------------------------------------

; The remainder of self / other, with the sign of self (C fmod; Rust's %).
routine F64.frem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = frem<Self>(%self, %other)
        return(%r)

routine F64.recip(%self: Self) -> Self
    block entry():
        %r: Self = fdiv<Self>(1.0, %self)
        return(%r)

; self * a + b with a single rounding.
routine F64.mul_add(%self: Self, %a: Self, %b: Self) -> Self
    block entry():
        %r: Self = fma<Self>(%self, %a, %b)
        return(%r)

; The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine F64.div_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %q: Self = %self.fdiv(%other).trunc()
        %rem: Self = frem<Self>(%self, %other)
        %rem_negative: Bool = %rem.lt(0.0)
        branch %rem_negative ? adjust(%q) : return(%q)

    block adjust(%q: Self):
        %positive_divisor: Bool = %other.gt(0.0)
        %down: Self = %q.sub(1.0)
        %up: Self = %q.add(1.0)
        %r: Self = %positive_divisor ? %down : %up
        return(%r)

; The least non-negative remainder of self / other.
routine F64.rem_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %rem: Self = frem<Self>(%self, %other)
        %rem_negative: Bool = %rem.lt(0.0)
        branch %rem_negative ? adjust(%rem) : return(%rem)

    block adjust(%rem: Self):
        %magnitude: Self = %other.abs()
        %r: Self = %rem.add(%magnitude)
        return(%r)

; -- ordering ------------------------------------------------------------------

; The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine F64.minimum(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = minimum<Self>(%self, %other)
        return(%r)

; The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine F64.maximum(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = maximum<Self>(%self, %other)
        return(%r)

; Restricts self to %lo ..= %hi; NaN stays NaN. Traps unless %lo <= %hi.
routine F64.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid: Bool = %lo.le(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %below: Bool = %self.lt(%lo)
        %above: Bool = %self.gt(%hi)
        %upper: Self = %above ? %hi : %self
        %r: Self = %below ? %lo : %upper
        return(%r)

; IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine F64.total_compare(%self: Self, %other: Self) -> I32
    block entry():
        %a: I64 = %self.to_bits()
        %b: I64 = %other.to_bits()
        ; Flipping every bit but the sign of negative values makes the bits order like signed integers.
        %a_key: I64 = %a.bitxor(%a.ashr(63).lshr(1))
        %b_key: I64 = %b.bitxor(%b.ashr(63).lshr(1))
        %r: I32 = %a_key.compare(%b_key)
        return(%r)

; -- rounding ------------------------------------------------------------------

routine F64.floor(%self: Self) -> Self
    block entry():
        %r: Self = floor<Self>(%self)
        return(%r)

routine F64.ceil(%self: Self) -> Self
    block entry():
        %r: Self = ceil<Self>(%self)
        return(%r)

; Rounds half-way cases away from zero.
routine F64.round(%self: Self) -> Self
    block entry():
        %r: Self = round<Self>(%self)
        return(%r)

; Rounds half-way cases to the even neighbor.
routine F64.round_ties_even(%self: Self) -> Self
    block entry():
        %r: Self = rint<Self>(%self)
        return(%r)

; Rounds toward zero.
routine F64.trunc(%self: Self) -> Self
    block entry():
        %r: Self = ftrunc<Self>(%self)
        return(%r)

; self minus its integer part, with the sign of self.
routine F64.fract(%self: Self) -> Self
    block entry():
        %whole: Self = %self.trunc()
        %r: Self = %self.sub(%whole)
        return(%r)

; -- powers --------------------------------------------------------------------

; NaN for negative values (other than -0.0).
routine F64.sqrt(%self: Self) -> Self
    block entry():
        %r: Self = sqrt<Self>(%self)
        return(%r)

routine F64.cbrt(%self: Self) -> Self
    block entry():
        %r: Self = c_cbrt(%self)
        return(%r)

; self raised to an integer power, by repeated squaring.
routine F64.powi(%self: Self, %n: I32) -> Self
    block entry():
        %negative: Bool = %n.slt(0)
        %magnitude: I32 = %n.abs()
        jump loop(%self, %magnitude, 1.0, %negative)

    ; %exp is read as unsigned, so I32.MIN's magnitude (which wraps) still works.
    block loop(%base: Self, %exp: I32, %acc: Self, %negative: Bool):
        %done: Bool = %exp.eq(0)
        branch %done ? finish(%acc, %negative) : step(%base, %exp, %acc, %negative)

    block step(%base: Self, %exp: I32, %acc: Self, %negative: Bool):
        %odd: Bool = %exp.bitand(1).ne(0)
        %with_base: Self = %acc.mul(%base)
        %next_acc: Self = %odd ? %with_base : %acc
        jump loop(%base.mul(%base), %exp.lshr(1), %next_acc, %negative)

    block finish(%acc: Self, %negative: Bool):
        %inverse: Self = %acc.recip()
        %r: Self = %negative ? %inverse : %acc
        return(%r)

routine F64.powf(%self: Self, %exp: Self) -> Self
    block entry():
        %r: Self = pow<Self>(%self, %exp)
        return(%r)

; e^self
routine F64.exp(%self: Self) -> Self
    block entry():
        %r: Self = exp<Self>(%self)
        return(%r)

; 2^self
routine F64.exp2(%self: Self) -> Self
    block entry():
        %r: Self = exp2<Self>(%self)
        return(%r)

; e^self - 1, accurate near 0.
routine F64.exp_m1(%self: Self) -> Self
    block entry():
        %r: Self = c_expm1(%self)
        return(%r)

; The natural logarithm.
routine F64.ln(%self: Self) -> Self
    block entry():
        %r: Self = log<Self>(%self)
        return(%r)

routine F64.log2(%self: Self) -> Self
    block entry():
        %r: Self = log2<Self>(%self)
        return(%r)

routine F64.log10(%self: Self) -> Self
    block entry():
        %r: Self = log10<Self>(%self)
        return(%r)

; ln(1 + self), accurate near 0.
routine F64.ln_1p(%self: Self) -> Self
    block entry():
        %r: Self = c_log1p(%self)
        return(%r)

; The logarithm with an arbitrary base.
routine F64.log(%self: Self, %base: Self) -> Self
    block entry():
        %num: Self = %self.ln()
        %den: Self = %base.ln()
        %r: Self = %num.fdiv(%den)
        return(%r)

; sqrt(self^2 + other^2) without intermediate overflow.
routine F64.hypot(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = c_hypot(%self, %other)
        return(%r)

; -- trigonometry --------------------------------------------------------------

; In radians.
routine F64.sin(%self: Self) -> Self
    block entry():
        %r: Self = sin<Self>(%self)
        return(%r)

; In radians.
routine F64.cos(%self: Self) -> Self
    block entry():
        %r: Self = cos<Self>(%self)
        return(%r)

; In radians.
routine F64.tan(%self: Self) -> Self
    block entry():
        %r: Self = tan<Self>(%self)
        return(%r)

routine F64.asin(%self: Self) -> Self
    block entry():
        %r: Self = asin<Self>(%self)
        return(%r)

routine F64.acos(%self: Self) -> Self
    block entry():
        %r: Self = acos<Self>(%self)
        return(%r)

routine F64.atan(%self: Self) -> Self
    block entry():
        %r: Self = atan<Self>(%self)
        return(%r)

routine F64.sinh(%self: Self) -> Self
    block entry():
        %r: Self = sinh<Self>(%self)
        return(%r)

routine F64.cosh(%self: Self) -> Self
    block entry():
        %r: Self = cosh<Self>(%self)
        return(%r)

routine F64.tanh(%self: Self) -> Self
    block entry():
        %r: Self = tanh<Self>(%self)
        return(%r)

routine F64.asinh(%self: Self) -> Self
    block entry():
        %r: Self = c_asinh(%self)
        return(%r)

routine F64.acosh(%self: Self) -> Self
    block entry():
        %r: Self = c_acosh(%self)
        return(%r)

routine F64.atanh(%self: Self) -> Self
    block entry():
        %r: Self = c_atanh(%self)
        return(%r)

; The angle of the point (other, self): self is y and %other is x.
routine F64.atan2(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = atan2<Self>(%self, %other)
        return(%r)

routine F64.to_degrees(%self: Self) -> Self
    block entry():
        %r: Self = %self.mul(57.2957795130823208767981548141051703)
        return(%r)

routine F64.to_radians(%self: Self) -> Self
    block entry():
        %r: Self = %self.mul(0.0174532925199432957692369076848861271)
        return(%r)

; -- classification ------------------------------------------------------------

routine F64.is_nan(%self: Self) -> Bool
    block entry():
        %r: Bool = funo<Self>(%self, %self)
        return(%r)

routine F64.is_infinite(%self: Self) -> Bool
    block entry():
        %magnitude: Self = fabs<Self>(%self)
        %r: Bool = %magnitude.eq(Self.INFINITY)
        return(%r)

; Neither infinite nor NaN.
routine F64.is_finite(%self: Self) -> Bool
    block entry():
        %magnitude: Self = fabs<Self>(%self)
        %r: Bool = %magnitude.lt(Self.INFINITY)
        return(%r)

; Not zero, subnormal, infinite, or NaN.
routine F64.is_normal(%self: Self) -> Bool
    block entry():
        %exponent: I64 = %self.to_bits().bitand(0x7FF0000000000000)
        %r: Bool = %exponent.ne(0).bitand(%exponent.ne(0x7FF0000000000000))
        return(%r)

routine F64.is_subnormal(%self: Self) -> Bool
    block entry():
        %bits: I64 = %self.to_bits()
        %exponent: I64 = %bits.bitand(0x7FF0000000000000)
        %mantissa: I64 = %bits.bitand(0x000FFFFFFFFFFFFF)
        %r: Bool = %exponent.eq(0).bitand(%mantissa.ne(0))
        return(%r)

; -- bits ----------------------------------------------------------------------

; The raw IEEE 754 bits.
routine F64.to_bits(%self: Self) -> I64
    block entry():
        %r: I64 = bitcast<Self, I64>(%self)
        return(%r)

routine F64.from_bits(%bits: I64) -> Self
    block entry():
        %r: Self = bitcast<I64, Self>(%bits)
        return(%r)

; -- conversions (float to integer saturates, NaN gives 0) --------------------

; Narrows to F32 with round-to-odd, then rounds that to F16; F32's 24 bits are
; enough (2 * 11 + 2) for the second rounding to be exact.
routine F64.to_f16(%self: Self) -> F16
    block entry():
        %narrow: F32 = fptrunc<Self, F32>(%self)
        %back: F64 = %narrow.to_f64()
        %inexact: Bool = %back.ne(%self)
        %finite: Bool = %narrow.is_finite()
        %sticky: Bool = %inexact.bitand(%finite)
        %bits: I32 = %narrow.to_bits().bitor(%sticky.to_i32())
        %odd: F32 = F32.from_bits(%bits)
        %r: F16 = %odd.to_f16()
        return(%r)

; Narrows to F32 with round-to-odd (an inexact result gets its lowest bit set),
; then rounds that to BF16. Round-to-odd keeps the second rounding from
; double-rounding, because F32 has more than twice BF16's precision.
routine F64.to_bf16(%self: Self) -> BF16
    block entry():
        %narrow: F32 = fptrunc<Self, F32>(%self)
        %back: F64 = %narrow.to_f64()
        %inexact: Bool = %back.ne(%self)
        %finite: Bool = %narrow.is_finite()
        %sticky: Bool = %inexact.bitand(%finite)
        %bits: I32 = %narrow.to_bits().bitor(%sticky.to_i32())
        %odd: F32 = F32.from_bits(%bits)
        %r: BF16 = %odd.to_bf16()
        return(%r)

routine F64.to_f64(%self: Self) -> F64
    block entry():
        return(%self)

routine F64.to_i8(%self: Self) -> I8
    block entry():
        %r: I8 = fptosi_sat<Self, I8>(%self)
        return(%r)

routine F64.to_u8(%self: Self) -> I8
    block entry():
        %r: I8 = fptoui_sat<Self, I8>(%self)
        return(%r)

routine F64.to_i16(%self: Self) -> I16
    block entry():
        %r: I16 = fptosi_sat<Self, I16>(%self)
        return(%r)

routine F64.to_u16(%self: Self) -> I16
    block entry():
        %r: I16 = fptoui_sat<Self, I16>(%self)
        return(%r)

routine F64.to_u32(%self: Self) -> I32
    block entry():
        %r: I32 = fptoui_sat<Self, I32>(%self)
        return(%r)

routine F64.to_u64(%self: Self) -> I64
    block entry():
        %r: I64 = fptoui_sat<Self, I64>(%self)
        return(%r)

routine F64.to_i128(%self: Self) -> I128
    block entry():
        %r: I128 = fptosi_sat<Self, I128>(%self)
        return(%r)

routine F64.to_u128(%self: Self) -> I128
    block entry():
        %r: I128 = fptoui_sat<Self, I128>(%self)
        return(%r)
