        %r        : U256 = sext<Self, U256>(%at_least)
        return(%r)

/// Rounds to nearest, ties to even.
routine S16.to_f32(%self: Self) -> F32
    block entry():
        %r : F32 = sitofp<Self, F32>(%self)
        return(%r)

/// Rounds to nearest, ties to even.
routine S16.to_f64(%self: Self) -> F64
    block entry():
        %r : F64 = sitofp<Self, F64>(%self)
        return(%r)
