/// Rounds to nearest, ties to even.
routine S8.to<F32>(self: Self) -> F32
    block entry():
        r : F32 = sitofp<Self, F32>(self)
        return(r)

/// Rounds to nearest, ties to even.
routine S8.to<F64>(self: Self) -> F64
    block entry():
        r : F64 = sitofp<Self, F64>(self)
        return(r)

// -- byte ------------------------------------------------------------------------

/// The bits as a Byte.
routine S8.bits(self: Self) -> Byte
    block entry():
        r : Byte = bitcast<Self, Byte>(self)
        return(r)

/// A byte read as a S8.
routine S8.from_byte(byte: Byte) -> Self
    block entry():
        r : Self = bitcast<Byte, Self>(byte)
        return(r)
