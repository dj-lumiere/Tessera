/// Whether self, rounded toward zero, lies in [lo, hi). False for NaN.
routine BF16.fits_int(self: Self, lo: Self, hi: Self) -> Bool
    block entry():
        whole : Self = self.trunc()
        r     : Bool = whole.in_range(lo, hi)
        return(r)
