/// The items as Tessera source: (1, "a").
routine Tuple4<T0, T1, T2, T3>.diagnose<W>(%self: Self, %out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, T3: typename, Diagnose<T3>, W: typename, Writer<W>
