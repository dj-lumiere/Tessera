// Tessera stdlib: @T — typed pointer
//
// Maps to LLVM IR ptr (opaque pointer).  The type parameter T records the
// pointee type for load/store — it is erased at the IR level.

module Standard::Core

import Standard::Alloc

#llvm("ptr")
record Ptr<T>
require T: typename

// -- pointer identity ----------------------------------------------------------

routine Ptr<T>.ptr_eq(%self: Self, %other: Self) -> Bool
require T: typename
    block entry():
        %a : S64  = ptrtoint<Self, S64>(%self)
        %b : S64  = ptrtoint<Self, S64>(%other)
        %r : Bool = ieq<S64>(%a, %b)
        return(%r)

routine Ptr<T>.ptr_ne(%self: Self, %other: Self) -> Bool
require T: typename
    block entry():
        %a : S64  = ptrtoint<Self, S64>(%self)
        %b : S64  = ptrtoint<Self, S64>(%other)
        %r : Bool = ine<S64>(%a, %b)
        return(%r)

// -- predicates ----------------------------------------------------------------

routine Ptr<T>.is_null(%self: Self) -> Bool
require T: typename
    block entry():
        %a : S64  = ptrtoint<Self, S64>(%self)
        %r : Bool = ieq<S64>(%a, 0)
        return(%r)

routine Ptr<T>.is_not_null(%self: Self) -> Bool
require T: typename
    block entry():
        %a : S64  = ptrtoint<Self, S64>(%self)
        %r : Bool = ine<S64>(%a, 0)
        return(%r)

// -- pointer arithmetic --------------------------------------------------------

/// Returns a pointer offset by %bytes bytes.
/// No bounds checking — caller is responsible for staying in-bounds.
routine Ptr<T>.offset(%self: Self, %bytes: SSize) -> Self
require T: typename
    block entry():
        %raw    : Addr = %self
        %moved  : Addr = %raw.offset(%bytes)
        %result : Self = %moved.cast<T>()
        return(%result)

// `%p.stride(%n)`, the pointer %n Ts further on (`offset` counted in elements rather than bytes; %n a USize, or
// an SSize to move back), is built into the builder: it's a place like a field, so `%p.stride(%i).f` chains and a
// load or store through it keeps a dense record's real alignment. No bounds checking.

// -- casting -------------------------------------------------------------------

/// Reinterprets this pointer as a pointer to a different type.
/// No-op at the IR level — only changes the static type.
routine Ptr<T>.cast<U>(%self: Self) -> @U
require T: typename
    block entry():
        %result : @U = bitcast<Self, @U>(%self)
        return(%result)

// -- memory --------------------------------------------------------------------

/// Reads the T at this address.
#[external("llvm"), template("{result} = load {T}, ptr {%self}")]
routine Ptr<T>.load(%self: Self) -> T
require T: typename

/// Writes %value to this address.
#[external("llvm"), template("store {T} {%value}, ptr {%self}")]
routine Ptr<T>.store(%self: Self, %value: T) -> Void
require T: typename

/// Writes this value to %dest: `%dest.store(%self)` read from the value's side, for a chain that ends in memory
/// (`%a.add(%b).store_into(%sum)`).
#[external("llvm"), template("store {T} {%self}, ptr {%dest}")]
routine T.store_into(%self: T, %dest: @T) -> Void
require T: typename

/// Reads the T at this address, which may not be aligned for T: a wire format, a packed buffer, a field taken out of a
/// #layout(dense) record. Costs nothing extra where the CPU allows unaligned access (x86, AArch64); byte by byte
/// where it doesn't (Cortex-M0, RISC-V without Zicclsm).
#[external("llvm"), template("{result} = load {T}, ptr {%self}, align 1")]
routine Ptr<T>.load_unaligned(%self: Self) -> T
require T: typename

/// Writes %value to this address, which may not be aligned for T.
#[external("llvm"), template("store {T} {%value}, ptr {%self}, align 1")]
routine Ptr<T>.store_unaligned(%self: Self, %value: T) -> Void
require T: typename

/// A read the compiler may not remove, merge, or reorder with other volatile accesses: for memory-mapped registers.
#[external("llvm"), template("{result} = load volatile {T}, ptr {%self}")]
routine Ptr<T>.volatile_load(%self: Self) -> T
require T: typename

/// A write the compiler may not remove, merge, or reorder with other volatile accesses.
#[external("llvm"), template("store volatile {T} {%value}, ptr {%self}")]
routine Ptr<T>.volatile_store(%self: Self, %value: T) -> Void
require T: typename

/// Hands this block back to %alloc, the allocator it came from. Not a destructor: whatever the Ts own is not
/// released (see `destruct`).
routine Ptr<T>.free(%self: Self, %alloc: @Allocator) -> Void
require T: typename
    block entry():
        %raw     : Addr                         = %self
        %free_fn : Callable<(Addr, Addr), Void> = %alloc.free_fn.load()
        %state   : Addr                         = %alloc.state.load()
        %free_fn.call(%state, %raw)
        return()

/// Sets %count Ts from here on to all-zero bytes, padding included.
routine Ptr<T>.zeroinit(%self: Self, %count: USize) -> Void
require T: typename
    block entry():
        %elem_size : USize = sizeof<T>()
        %size      : USize = %elem_size.mul(%count)
        ptr_zero_bytes(%self, %size)
        return()

// llvm.memset, so the core layer needs no libc (a freestanding target supplies memset itself).
#[external("llvm"),
        template("call void @llvm.memset.p0.{USize}(ptr {%dst}, i8 0, {USize} {%bytes}, i1 false)")]
private routine ptr_zero_bytes(%dst: Addr, %bytes: USize) -> Void
