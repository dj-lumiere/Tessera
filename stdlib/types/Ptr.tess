// Tessera stdlib: Ptr<T> — typed pointer
//
// Maps to LLVM IR ptr (opaque pointer).  The type parameter T records the
// pointee type for load/store — it is erased at the IR level.

module Std::Arch

@llvm("ptr")
record Ptr<T>
require T: typename

// -- pointer identity ----------------------------------------------------------

routine Ptr<T>.ptr_eq(#self: Self, #other: Self) -> Bool
require T: typename
    block entry():
        %a: S64 = ptrtoint<Self, S64>(#self)
        %b: S64 = ptrtoint<Self, S64>(#other)
        %r: Bool = ieq<S64>(%a, %b)
        return(%r)

routine Ptr<T>.ptr_ne(#self: Self, #other: Self) -> Bool
require T: typename
    block entry():
        %a: S64 = ptrtoint<Self, S64>(#self)
        %b: S64 = ptrtoint<Self, S64>(#other)
        %r: Bool = ine<S64>(%a, %b)
        return(%r)

// -- predicates ----------------------------------------------------------------

routine Ptr<T>.is_null(#self: Self) -> Bool
require T: typename
    block entry():
        %a: S64 = ptrtoint<Self, S64>(#self)
        %r: Bool = ieq<S64>(%a, 0)
        return(%r)

routine Ptr<T>.is_not_null(#self: Self) -> Bool
require T: typename
    block entry():
        %a: S64 = ptrtoint<Self, S64>(#self)
        %r: Bool = ine<S64>(%a, 0)
        return(%r)

// -- pointer arithmetic --------------------------------------------------------

/// Returns a pointer offset by %bytes bytes.
/// No bounds checking — caller is responsible for staying in-bounds.
routine Ptr<T>.offset(#self: Self, %bytes: S64) -> Self
require T: typename
    block entry():
        %addr: S64 = ptrtoint<Self, S64>(#self)
        %new_addr: S64 = %addr.add(%bytes)
        #result: Self = inttoptr<S64, Self>(%new_addr)
        return(#result)

// -- casting -------------------------------------------------------------------

/// Reinterprets this pointer as a pointer to a different type.
/// No-op at the IR level — only changes the static type.
routine Ptr<T>.cast<U>(#self: Self) -> Ptr<U>
require T: typename
    block entry():
        #result: Ptr<U> = bitcast<Self, Ptr<U>>(#self)
        return(#result)
