// Tessera stdlib: Char — a Unicode scalar value
//
// Maps to LLVM IR i32 and always holds 0 ..= 0x10FFFF outside the surrogates
// 0xD800 ..= 0xDFFF. A literal is written 'A'; U32.to_char() checks a number.
// Generated by scripts/gen_int_types.py.

module Standard::Core

@llvm("i32")
record Char
conform Equal<Char>, Compare<Char>, Hash<Char>

routine Char.to_u32(self: Self) -> U32
    block entry():
        r : U32 = bitcast<Self, U32>(self)
        return(r)

routine Char.hash(self: Self) -> U64
    block entry():
        h : U64 = self.to_u32().hash()
        return(h)

routine Char.eq(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = ieq<Self>(self, other)
        return(r)

routine Char.ne(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = ine<Self>(self, other)
        return(r)

@[external("llvm"), template("{result} = icmp ult i32 {self}, {other}")]
routine Char.lt(self: Self, other: Self) -> Bool

@[external("llvm"), template("{result} = icmp ule i32 {self}, {other}")]
routine Char.le(self: Self, other: Self) -> Bool

@[external("llvm"), template("{result} = icmp ugt i32 {self}, {other}")]
routine Char.gt(self: Self, other: Self) -> Bool

@[external("llvm"), template("{result} = icmp uge i32 {self}, {other}")]
routine Char.ge(self: Self, other: Self) -> Bool

/// self in [lo, hi], both ends included. False when lo > hi.
routine Char.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry():
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine Char.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry():
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

/// -1, 0, or 1, by code point.
routine Char.compare(self: Self, other: Self) -> S32
    block entry():
        r : S32 = self.to_u32().compare(other.to_u32())
        return(r)

routine Char.is_ascii(self: Self) -> Bool
    block entry():
        r : Bool = self.to_u32().lt(128)
        return(r)
