; Tessera stdlib: Byte and Bits16 .. Bits256 — raw bits
;
; Bits with no meaning attached yet: untyped memory, float bit patterns, FFI.
; They have no methods at all. Reading them goes through a static routine on
; the type that gives them a meaning (U64.from_bits, F64.from_bits,
; U8.from_byte), and x.bits() goes the other way. A literal of these types is
; hex with exactly one digit per four bits: 0xFF for Byte, 0x0000 for Bits16.
; Generated by scripts/gen_int_types.py.

@llvm("i8")
record Byte

@llvm("i16")
record Bits16

@llvm("i32")
record Bits32

@llvm("i64")
record Bits64

@llvm("i128")
record Bits128

@llvm("i256")
record Bits256
