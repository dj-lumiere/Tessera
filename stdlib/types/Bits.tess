; Tessera stdlib: Byte and Bits16 .. Bits256 — raw bits
;
; Bits with no meaning attached yet: untyped memory, float bit patterns, FFI.
; Bits16 .. Bits256 have no methods at all. Reading them goes through a static
; routine on the type that gives them a meaning (U64.from_bits,
; F64.from_bits), and x.bits() goes the other way. A literal of these types is
; hex with exactly one digit per four bits: 0xFF for Byte, 0x0000 for Bits16.
;
; Byte is the exception: text is bytes, so a Byte compares (as 0 ..= 255, with
; byte literals like b'0'), hashes, and takes bit operations. It still has no
; arithmetic: to_u8() (or U8.from_byte) gives the number.
; Generated by scripts/gen_int_types.py.

@llvm("i8")
record Byte
conform Equal<Byte>, Compare<Byte>, Hash<Byte>

routine Byte.to_u8(%self: Self) -> U8
    block entry():
        %r: U8 = bitcast<Self, U8>(%self)
        return(%r)

routine Byte.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine Byte.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)

@[external("llvm"), template("{result} = icmp ult i8 {%self}, {%other}")]
routine Byte.lt(%self: Self, %other: Self) -> Bool

@[external("llvm"), template("{result} = icmp ule i8 {%self}, {%other}")]
routine Byte.le(%self: Self, %other: Self) -> Bool

@[external("llvm"), template("{result} = icmp ugt i8 {%self}, {%other}")]
routine Byte.gt(%self: Self, %other: Self) -> Bool

@[external("llvm"), template("{result} = icmp uge i8 {%self}, {%other}")]
routine Byte.ge(%self: Self, %other: Self) -> Bool

; -1, 0, or 1, as 0 ..= 255.
routine Byte.compare(%self: Self, %other: Self) -> S32
    block entry():
        %r: S32 = %self.to_u8().compare(%other.to_u8())
        return(%r)

routine Byte.hash(%self: Self) -> U64
    block entry():
        %r: U64 = %self.to_u8().hash()
        return(%r)

routine Byte.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)

routine Byte.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)

routine Byte.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)

routine Byte.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)

; A shift by 8 or more shifts every bit out (Roadmap #8).
routine Byte.shl(%self: Self, %n: Self) -> Self
    block entry():
        %in_range: Bool = %n.lt(0x08)
        %shifted:  Self = shl<Self>(%self, %n)
        %r: Self = %in_range ? %shifted : 0x00
        return(%r)

; Logical: zeros fill in. A shift by 8 or more gives 0x00.
routine Byte.shr(%self: Self, %n: Self) -> Self
    block entry():
        %in_range: Bool = %n.lt(0x08)
        %shifted:  Self = lshr<Self>(%self, %n)
        %r: Self = %in_range ? %shifted : 0x00
        return(%r)

@llvm("i16")
record Bits16

@llvm("i32")
record Bits32

@llvm("i64")
record Bits64

@llvm("i128")
record Bits128

@llvm("i256")
record Bits256
