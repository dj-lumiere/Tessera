; Tessera stdlib: StringBytesIter
;
; Forward iterator over the raw bytes (I8) of a String.
; next() returns Option<I8>.none() after the last byte.
;
; Satisfies concept Iterator<I8, StringBytesIter>.

record StringBytesIter
conform Iterator<I8, StringBytesIter>
    str:   String
    index: I64

routine StringBytesIter.new(%str: String) -> Self
    block entry():
        %iter: Self = Self { str: %str, index: 0 }
        return(%iter)

routine StringBytesIter.next(#self: Ptr<Self>) -> Option<I8>
    block entry():
        %index: I64 := #self.index
        %str: String := #self.str
        %str_len: I64 = %str.length
        %done: Bool = %index.sge(%str_len)
        branch %done ? return_none() : return_some(%index, %str)

    block return_none():
        %none: Option<I8> = Option<I8>.none()
        return(%none)

    block return_some(%index: I64, %str: String):
        #data: Ptr<I8> = %str.data
        %byte: I8 := #data[%index]
        %index_next: I64 = %index.add(1)
        #self.index = %index_next
        %some: Option<I8> = Option<I8>.some(%byte)
        return(%some)
