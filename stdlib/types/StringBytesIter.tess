// Tessera stdlib: StringBytesIter
//
// Forward iterator over the raw bytes (U8) of a String.
// next() returns Option<U8>.none() after the last byte.
//
// Satisfies concept Iterator<U8, StringBytesIter>.

module Standard::Core

record StringBytesIter
conform Iterator<U8, StringBytesIter>
    str:   String
    index: U64

routine StringBytesIter.construct(%str: String) -> Self
    block entry():
        %iter: Self = Self { str: %str, index: 0 }
        return(%iter)

routine StringBytesIter.next(#self: Ptr<Self>) -> Option<U8>
    block entry():
        %index: U64 = #self.index.load()
        %str: String  = #self.str.load()
        %str_len: U64 = %str.length
        %done: Bool = %index.ge(%str_len)
        branch %done ? return_none() : return_some(%index, %str)

    block return_none():
        %none: Option<U8> = Option<U8>.none()
        return(%none)

    block return_some(%index: U64, %str: String):
        #data: Ptr<Byte> = %str.data
        %byte: U8 = U8.from_byte(#data[%index].load())
        %index_next: U64 = %index.add(1)
        #self.index.store(%index_next)
        %some: Option<U8> = Option<U8>.some(%byte)
        return(%some)
