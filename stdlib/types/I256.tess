; Tessera stdlib: I256 — 256-bit signed integer
;
; Maps to LLVM IR i256. Arithmetic, shifts and comparisons are LLVM's own
; (legalized to 64-bit pieces). Division is not: LLVM expands i256 udiv and
; sdiv into a loop that retires one quotient bit per iteration, so udivrem
; runs Knuth's algorithm D (TAOCP vol. 2, 4.3.1) over 64-bit limbs instead,
; with the digit steps from wide_div.tess.
;
; As for every integer type, signedness lives on the operation: I256 is also
; the 256-bit unsigned integer (udiv, ult, lshr, to_u256).

@llvm("i256")
record I256
conform Equal<I256>, Compare<I256>, Hash<I256>

; -- constants -----------------------------------------------------------------

const I256.MIN: I256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
const I256.MAX: I256 =  57896044618658097711785492504343953926634992332820282019728792003956564819967
const I256.BITS: I256 = 256
const I256.UMAX: I256 = -1   ; all bits set: the largest value read as unsigned

; -- bit operations ------------------------------------------------------------

routine I256.count_ones(%self: Self) -> Self
    block entry():
        %result: Self = popcount<Self>(%self)
        return(%result)

routine I256.leading_zeros(%self: Self) -> Self
    block entry():
        %result: Self = clz<Self>(%self, false)
        return(%result)

routine I256.trailing_zeros(%self: Self) -> Self
    block entry():
        %result: Self = ctz<Self>(%self, false)
        return(%result)

routine I256.swap_bytes(%self: Self) -> Self
    block entry():
        %result: Self = bswap<Self>(%self)
        return(%result)

; -- arithmetic ----------------------------------------------------------------

routine I256.abs(%self: Self) -> Self
    block entry():
        %is_neg: Bool = %self.slt(0)
        %zero: Self = 0
        %neg: Self = %zero.sub(%self)
        %result: Self = %is_neg ? %neg : %self
        return(%result)

routine I256.min(%self: Self, %other: Self) -> Self
    block entry():
        %less: Bool = %self.slt(%other)
        %result: Self = %less ? %self : %other
        return(%result)

routine I256.max(%self: Self, %other: Self) -> Self
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: Self = %more ? %self : %other
        return(%result)

routine I256.umin(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = umin<Self>(%self, %other)
        return(%r)

routine I256.umax(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = umax<Self>(%self, %other)
        return(%r)

; Wrapping negation: MIN.neg() is MIN.
routine I256.neg(%self: Self) -> Self
    block entry():
        %r: Self = 0.sub(%self)
        return(%r)

routine I256.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = add<Self>(%self, %other)
        return(%r)

routine I256.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sub<Self>(%self, %other)
        return(%r)

routine I256.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = mul<Self>(%self, %other)
        return(%r)

; -- bit shifts ----------------------------------------------------------------

routine I256.shl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = shl<Self>(%self, %n)
        return(%r)

routine I256.lshr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = lshr<Self>(%self, %n)
        return(%r)

routine I256.ashr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = ashr<Self>(%self, %n)
        return(%r)

; Rotates by %n modulo the bit width.
routine I256.rotl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = fshl<Self>(%self, %self, %n)
        return(%r)

routine I256.rotr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = fshr<Self>(%self, %self, %n)
        return(%r)

; -- bitwise operations --------------------------------------------------------

routine I256.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)

routine I256.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)

routine I256.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)

routine I256.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)

; -- signed comparisons --------------------------------------------------------

routine I256.slt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = slt<Self>(%self, %other)
        return(%r)

routine I256.sle(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sle<Self>(%self, %other)
        return(%r)

routine I256.sgt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sgt<Self>(%self, %other)
        return(%r)

routine I256.sge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sge<Self>(%self, %other)
        return(%r)

; -- unsigned comparisons ------------------------------------------------------

routine I256.ult(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ult<Self>(%self, %other)
        return(%r)

routine I256.ule(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ule<Self>(%self, %other)
        return(%r)

routine I256.ugt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ugt<Self>(%self, %other)
        return(%r)

routine I256.uge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = uge<Self>(%self, %other)
        return(%r)

; -- equality, ordering, hashing -----------------------------------------------

routine I256.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine I256.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)

routine I256.compare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I256.ucompare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.ult(%other)
        branch %lt ? return(-1) : maybe_gt()

    block maybe_gt():
        %gt: Bool = %self.ugt(%other)
        branch %gt ? return(1) : return(0)

routine I256.hash(%self: Self) -> I64
    block entry():
        %h0:   I64 = xxh64_hash_i64(%self.limb(0), 0)
        %h1:   I64 = xxh64_hash_i64(%self.limb(1), 0)
        %h2:   I64 = xxh64_hash_i64(%self.limb(2), 0)
        %h3:   I64 = xxh64_hash_i64(%self.limb(3), 0)
        %low:  I64 = xxh64_combine2(%h0, %h1, 0)
        %high: I64 = xxh64_combine2(%h2, %h3, 0)
        %h:    I64 = xxh64_combine2(%low, %high, 0)
        return(%h)

; -- limbs ---------------------------------------------------------------------

; The 64-bit limb %index (0 is the least significant), for 0 <= %index < 4.
routine I256.limb(%self: Self, %index: I64) -> I64
    block entry():
        %shift: Self = %index.mul(64).to_i256()
        %r:     I64  = %self.lshr(%shift).to_i64()
        return(%r)

; The integer with limbs (l3, l2, l1, l0), most significant first.
routine I256.from_limbs(%l3: I64, %l2: I64, %l1: I64, %l0: I64) -> I256
    block entry():
        %high: I128 = %l3.to_u128().shl(64).bitor(%l2.to_u128())
        %low:  I128 = %l1.to_u128().shl(64).bitor(%l0.to_u128())
        %r:    I256 = %high.to_u256().shl(128).bitor(%low.to_u256())
        return(%r)

; -- narrowing conversions -----------------------------------------------------

routine I256.to_i8(%self: Self) -> I8
    block entry():
        %r: I8 = trunc<Self, I8>(%self)
        return(%r)

routine I256.to_i16(%self: Self) -> I16
    block entry():
        %r: I16 = trunc<Self, I16>(%self)
        return(%r)

routine I256.to_i32(%self: Self) -> I32
    block entry():
        %r: I32 = trunc<Self, I32>(%self)
        return(%r)

routine I256.to_i64(%self: Self) -> I64
    block entry():
        %r: I64 = trunc<Self, I64>(%self)
        return(%r)

routine I256.to_i128(%self: Self) -> I128
    block entry():
        %r: I128 = trunc<Self, I128>(%self)
        return(%r)

routine I256.to_i256(%self: Self) -> I256
    block entry():
        return(%self)

routine I256.to_u256(%self: Self) -> I256
    block entry():
        return(%self)

; ============================================================
; Division
;
; udivrem is the one real routine; udiv, urem, sdiv, srem and sdivrem read
; its result. Division by zero panics with TrapCode.DivByZero (I128's LLVM
; division leaves it undefined). The signed forms truncate toward zero, and
; MIN.sdiv(-1) wraps to MIN with remainder 0, as I128.wrapping_sdiv does.
; ============================================================

record I256DivRem
    quotient:  I256
    remainder: I256

; Unsigned quotient and remainder.
routine I256.udivrem(%self: Self, %other: Self) -> I256DivRem
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? panic(TrapCode.DivByZero) : compare()

    block compare():
        %below: Bool = %self.ult(%other)
        branch %below ? below() : narrow()

    block below():
        %r: I256DivRem = I256DivRem { quotient: 0, remainder: %self }
        return(%r)

    ; other <= self, so when self fits in 128 bits, both do.
    block narrow():
        %fits: Bool = %self.lshr(128).eq(0)
        branch %fits ? by_i128() : by_limbs()

    block by_i128():
        %a: I128 = %self.to_i128()
        %b: I128 = %other.to_i128()
        %q: I256 = %a.udiv(%b).to_u256()
        %rem: I256 = %a.urem(%b).to_u256()
        %r: I256DivRem = I256DivRem { quotient: %q, remainder: %rem }
        return(%r)

    block by_limbs():
        %one_limb: Bool = %other.lshr(64).eq(0)
        branch %one_limb ? by_one_limb() : by_several_limbs()

    block by_one_limb():
        %r: I256DivRem = i256_divrem_by_limb(%self, %other.to_i64())
        return(%r)

    block by_several_limbs():
        %r: I256DivRem = i256_divrem_knuth(%self, %other)
        return(%r)

routine I256.udiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: I256DivRem = %self.udivrem(%other)
        return(%r.quotient)

routine I256.urem(%self: Self, %other: Self) -> Self
    block entry():
        %r: I256DivRem = %self.udivrem(%other)
        return(%r.remainder)

; Signed quotient (toward zero) and remainder (with the dividend's sign).
routine I256.sdivrem(%self: Self, %other: Self) -> I256DivRem
    block entry():
        %self_negative:  Bool = %self.slt(0)
        %other_negative: Bool = %other.slt(0)
        ; abs(MIN) is MIN, whose bits read as unsigned are the right magnitude.
        %magnitudes: I256DivRem = %self.abs().udivrem(%other.abs())
        %q:          I256 = %magnitudes.quotient
        %rem:        I256 = %magnitudes.remainder
        %q_negative: Bool = %self_negative.bitxor(%other_negative)
        %q_signed:   I256 = %q_negative ? %q.neg() : %q
        %rem_signed: I256 = %self_negative ? %rem.neg() : %rem
        %r: I256DivRem = I256DivRem { quotient: %q_signed, remainder: %rem_signed }
        return(%r)

routine I256.sdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: I256DivRem = %self.sdivrem(%other)
        return(%r.quotient)

routine I256.srem(%self: Self, %other: Self) -> Self
    block entry():
        %r: I256DivRem = %self.sdivrem(%other)
        return(%r.remainder)

; -- one-limb divisor ----------------------------------------------------------

; %u / %d for a nonzero one-limb %d: normalize so d's top bit is set, then one
; 2-by-1 step per dividend limb, most significant first.
routine i256_divrem_by_limb(%u: I256, %d: I64) -> I256DivRem
    block entry():
        %shift:  I64  = %d.leading_zeros()
        %d_norm: I64  = %d.shl(%shift)
        %v:      I64  = div_2by1_prepare(%d_norm)
        %u_norm: I256 = %u.shl(%shift.to_i256())
        ; The bits shifted out of the top; a funnel shift by 0 gives 0, where a
        ; plain lshr by 64 would be poison.
        %u_over: I64  = fshl<I64>(0, %u.limb(3), %shift)
        %s3: Div2By1 = div_2by1(%u_over, %u_norm.limb(3), %d_norm, %v)
        %s2: Div2By1 = div_2by1(%s3.remainder, %u_norm.limb(2), %d_norm, %v)
        %s1: Div2By1 = div_2by1(%s2.remainder, %u_norm.limb(1), %d_norm, %v)
        %s0: Div2By1 = div_2by1(%s1.remainder, %u_norm.limb(0), %d_norm, %v)
        %q:   I256 = I256.from_limbs(%s3.quotient, %s2.quotient, %s1.quotient, %s0.quotient)
        %rem: I64  = %s0.remainder.lshr(%shift)
        %r: I256DivRem = I256DivRem { quotient: %q, remainder: %rem.to_u256() }
        return(%r)

; -- algorithm D ---------------------------------------------------------------

; The working state of algorithm D for an n-limb divisor, 2 <= n <= 4. Both
; operands are shifted left until the divisor's top bit is set; the shifted
; dividend takes a fifth limb. Each step divides the window u[j .. j+n] by v
; and leaves the window's remainder in u[j .. j+n-1], so u ends as the
; (shifted) remainder.
record I256Division
    u:          Array<I64, 5>   ; the normalized dividend, least significant limb first
    v:          Array<I64, 4>   ; the normalized divisor
    n:          I64             ; the divisor's limb count
    reciprocal: I64             ; div_3by2_prepare of v's top two limbs

; %u / %d for a divisor of two or more limbs.
routine i256_divrem_knuth(%u: I256, %d: I256) -> I256DivRem
    block entry():
        %lz:     I64  = %d.leading_zeros().to_i64()
        %n:      I64  = 4.sub(%lz.lshr(6))
        %shift:  I64  = %lz.bitand(63)
        #state:  Ptr<I256Division> = alloca<I256Division>
        #state.init(%u, %d, %n, %shift)
        jump digit(#state, 4.sub(%n), 0)

    ; Quotient digits come out most significant first, from j = 4 - n down to 0.
    block digit(#state: Ptr<I256Division>, %j: I64, %q: I256):
        %q_digit: I64  = #state.step(%j)
        %q_next:  I256 = %q.shl(64).bitor(%q_digit.to_u256())
        %done:    Bool = %j.eq(0)
        branch %done ? finish(#state, %q_next) : digit(#state, %j.sub(1), %q_next)

    block finish(#state: Ptr<I256Division>, %q: I256):
        %l3: I64 := #state.u[3]
        %l2: I64 := #state.u[2]
        %l1: I64 := #state.u[1]
        %l0: I64 := #state.u[0]
        %lz:        I64  = %d.leading_zeros().to_i64()
        %norm:      I64  = %lz.bitand(63)
        %shifted:   I256 = I256.from_limbs(%l3, %l2, %l1, %l0)
        %remainder: I256 = %shifted.lshr(%norm.to_i256())
        %r: I256DivRem = I256DivRem { quotient: %q, remainder: %remainder }
        return(%r)

routine I256Division.init(#self: Ptr<Self>, %u: I256, %d: I256, %n: I64, %shift: I64) -> Void
    block entry():
        %u_norm: I256 = %u.shl(%shift.to_i256())
        %d_norm: I256 = %d.shl(%shift.to_i256())
        ; A funnel shift by 0 gives 0, where a plain lshr by 64 would be poison.
        %u_over: I64  = fshl<I64>(0, %u.limb(3), %shift)
        #self.u[0] = %u_norm.limb(0)
        #self.u[1] = %u_norm.limb(1)
        #self.u[2] = %u_norm.limb(2)
        #self.u[3] = %u_norm.limb(3)
        #self.u[4] = %u_over
        #self.v[0] = %d_norm.limb(0)
        #self.v[1] = %d_norm.limb(1)
        #self.v[2] = %d_norm.limb(2)
        #self.v[3] = %d_norm.limb(3)
        #self.n = %n
        %d1: I64 = %d_norm.limb(%n.sub(1))
        %d0: I64 = %d_norm.limb(%n.sub(2))
        %reciprocal: I64 = div_3by2_prepare(%d1, %d0)
        #self.reciprocal = %reciprocal
        return()

; One step: the quotient digit of the window u[j .. j+n] by v, which
; replaces the window with its remainder.
routine I256Division.step(#self: Ptr<Self>, %j: I64) -> I64
    block entry():
        %n:      I64 := #self.n
        %top_at: I64 = %j.add(%n)
        %d1_at:  I64 = %n.sub(1)
        %d0_at:  I64 = %n.sub(2)
        %u2: I64 := #self.u[%top_at]
        %u1_at:  I64 = %top_at.sub(1)
        %u1: I64 := #self.u[%u1_at]
        %u0_at:  I64 = %top_at.sub(2)
        %u0: I64 := #self.u[%u0_at]
        %d1: I64 := #self.v[%d1_at]
        %d0: I64 := #self.v[%d0_at]
        ; The window's remainder is below v, so its top limb ends as 0.
        #self.u[%top_at] = 0
        ; div_3by2 needs (u2, u1) < (d1, d0). When they are equal the digit is 2^64 - 1 exactly.
        %saturated: Bool = %u2.eq(%d1).bitand(%u1.eq(%d0))
        branch %saturated ? saturated(%n) : estimate(%n, %u2, %u1, %u0, %d1, %d0)

    block saturated(%n: I64):
        #self.submul(%j, %n, -1)
        return(-1)

    ; The top three limbs over the top two divisor limbs give q̂ and the
    ; remainder of those limbs; subtracting q̂ times the lower divisor limbs
    ; finishes the window. q̂ can be one too big for n >= 3: then that
    ; subtraction borrows, and v is added back.
    block estimate(%n: I64, %u2: I64, %u1: I64, %u0: I64, %d1: I64, %d0: I64):
        %v:      I64     := #self.reciprocal
        %top:    Div3By2 = div_3by2(%u2, %u1, %u0, %d1, %d0, %v)
        %q_hat:  I64     = %top.quotient
        %borrow: I64     = #self.submul(%j, %n.sub(2), %q_hat)
        %rhat:   I128    = %top.remainder
        %taken:  I128    = %borrow.to_u128()
        %rest:   I128    = %rhat.sub(%taken)
        %low_at: I64     = %j.add(%n).sub(2)
        %high_at: I64    = %low_at.add(1)
        #self.u[%low_at] = %rest.to_i64()
        #self.u[%high_at] = %rest.lshr(64).to_i64()
        %too_big: Bool = %rhat.ult(%taken)
        branch %too_big ? add_back(%n, %q_hat) : return(%q_hat)

    block add_back(%n: I64, %q_hat: I64):
        #self.add_back(%j, %n)
        return(%q_hat.sub(1))

; u[j .. j+len-1] -= v[0 .. len-1] × m; returns the limb that borrows out of the top.
routine I256Division.submul(#self: Ptr<Self>, %j: I64, %len: I64, %m: I64) -> I64
    block entry():
        jump loop(0, 0)

    block loop(%i: I64, %borrow: I64):
        %done: Bool = %i.eq(%len)
        branch %done ? return(%borrow) : limb(%i, %borrow)

    block limb(%i: I64, %borrow: I64):
        %at:      I64  = %j.add(%i)
        %v_limb:  I64  := #self.v[%i]
        %u_limb:  I64  := #self.u[%at]
        %product: I128 = %v_limb.to_u128().mul(%m.to_u128()).add(%borrow.to_u128())
        %low:     I64  = %product.to_i64()
        %wrapped: Bool = %u_limb.ult(%low)
        #self.u[%at] = %u_limb.sub(%low)
        %high:    I64  = %product.lshr(64).to_i64()
        jump loop(%i.add(1), %high.add(%wrapped.to_i64()))

; u[j .. j+n-1] += v, dropping the carry out of the top: it cancels the borrow
; that made the window negative.
routine I256Division.add_back(#self: Ptr<Self>, %j: I64, %n: I64) -> Void
    block entry():
        jump loop(0, 0)

    block loop(%i: I64, %carry: I64):
        %done: Bool = %i.eq(%n)
        branch %done ? return() : limb(%i, %carry)

    block limb(%i: I64, %carry: I64):
        %at:     I64  = %j.add(%i)
        %v_limb: I64  := #self.v[%i]
        %u_limb: I64  := #self.u[%at]
        %sum:    I128 = %u_limb.to_u128().add(%v_limb.to_u128()).add(%carry.to_u128())
        #self.u[%at] = %sum.to_i64()
        jump loop(%i.add(1), %sum.lshr(64).to_i64())

; ============================================================
; Rust-level operations
; ============================================================

; -- bits ----------------------------------------------------------------------

routine I256.count_zeros(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = popcount<Self>(%inverted)
        return(%r)

routine I256.leading_ones(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = clz<Self>(%inverted, false)
        return(%r)

routine I256.trailing_ones(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = ctz<Self>(%inverted, false)
        return(%r)

routine I256.reverse_bits(%self: Self) -> Self
    block entry():
        %r: Self = bitreverse<Self>(%self)
        return(%r)

; True when exactly one bit is set (so MIN counts: it is 2^255 read as unsigned).
routine I256.is_power_of_two(%self: Self) -> Bool
    block entry():
        %ones: Self = popcount<Self>(%self)
        %r: Bool = %ones.eq(1)
        return(%r)

; -- sign ----------------------------------------------------------------------

; -1, 0, or 1.
routine I256.signum(%self: Self) -> Self
    block entry():
        %negative: Bool = %self.slt(0)
        %positive: Bool = %self.sgt(0)
        %non_negative: Self = %positive ? 1 : 0
        %r: Self = %negative ? -1 : %non_negative
        return(%r)

routine I256.is_negative(%self: Self) -> Bool
    block entry():
        %r: Bool = %self.slt(0)
        return(%r)

routine I256.is_positive(%self: Self) -> Bool
    block entry():
        %r: Bool = %self.sgt(0)
        return(%r)

; -- checked, saturating, overflowing add and sub --------------------------------

routine I256.checked_sadd(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = sadd_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.add(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I256.checked_uadd(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = uadd_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.add(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I256.checked_ssub(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = ssub_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.sub(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I256.checked_usub(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = usub_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.sub(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I256.saturating_sadd(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sadd_sat<Self>(%self, %other)
        return(%r)

routine I256.saturating_uadd(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = uadd_sat<Self>(%self, %other)
        return(%r)

routine I256.saturating_ssub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = ssub_sat<Self>(%self, %other)
        return(%r)

routine I256.saturating_usub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = usub_sat<Self>(%self, %other)
        return(%r)

routine I256.overflowing_sadd(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.add(%other)
        %overflow: Bool = sadd_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I256.overflowing_uadd(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.add(%other)
        %overflow: Bool = uadd_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I256.overflowing_ssub(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.sub(%other)
        %overflow: Bool = ssub_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I256.overflowing_usub(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.sub(%other)
        %overflow: Bool = usub_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)
