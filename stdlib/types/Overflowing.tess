; Tessera stdlib: Overflowing<T> — a wrapped result plus an overflow flag
;
; Returned by the overflowing_* integer methods (Rust's `(T, bool)`).
;
; Layout:
;   value    : T    — the result, wrapped to the type's width
;   overflow : Bool — true if the exact result did not fit

struct Overflowing<T>
require T: typename
    value:    T
    overflow: Bool

routine Overflowing<T>.new(%value: T, %overflow: Bool) -> Self
require T: typename
    block entry():
        %r: Self = Self { value: %value, overflow: %overflow }
        return(%r)
