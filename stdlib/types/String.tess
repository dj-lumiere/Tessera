// Tessera stdlib: String
//
// String is a non-owning immutable view over a UTF-8 byte sequence:
//   data   — Ptr<Byte> to the first byte (a literal's bytes are also NUL-terminated; other views aren't)
//   length — USize byte count (not including the null terminator)
//
// String literal syntax ("hello") desugars directly to a String constant —
// no heap allocation, no allocator needed.
//
// String never owns its bytes.  The caller is responsible for ensuring the
// pointed-to data outlives the String.  To build text on the heap, write into
// a List<Byte> (it's a Writer) and view it with %buf.to_string().
//
// Factory routines (concat) take an explicit Ptr<Allocator> and
// return a String whose data must be freed by the caller with `%data.free(%alloc)`.

module Standard::Core

import Standard::Alloc

record String
conform Equal<String>, Compare<String>, Hash<String>
    data   : Ptr<Byte>
    length : USize

// -- construction --------------------------------------------------------------

routine String.empty() -> Self
    block entry():
        %str : Self = Self { data: null, length: 0 }
        return(%str)

routine String.from_ptr(%data: Ptr<Byte>, %length: USize) -> Self
    block entry():
        %str : Self = Self { data: %data, length: %length }
        return(%str)

// -- predicates ----------------------------------------------------------------

/// The length in bytes of the UTF-8 text, not in characters (count those with chars()).
routine String.length(%self: Self) -> USize
    block entry():
        %length : USize = %self.length
        return(%length)

routine String.is_empty(%self: Self) -> Bool
    block entry():
        %length : USize = %self.length
        %result : Bool  = %length.eq(0)
        return(%result)

// -- element access ------------------------------------------------------------

routine String.byte_at(%self: Self, %index: USize) -> U8
    block entry():
        %length    : USize = %self.length
        %in_bounds : Bool  = %index.lt(%length)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: USize):
        %data : Ptr<Byte> = %self.data
        %byte : U8        = .from_byte(%data[%index].load())
        return(%byte)

// -- slicing -------------------------------------------------------------------

/// Returns a sub-view [start, end).  Traps if range is out of bounds.
routine String.slice(%self: Self, %start: USize, %end: USize) -> Self
    block entry():
        %length      : USize = %self.length
        %valid_end   : Bool  = %end.le(%length)
        %valid_order : Bool  = %start.le(%end)
        %valid       : Bool  = %valid_end.bitand(%valid_order)
        branch %valid ? make(%start, %end) : panic(TrapCode.Bounds)

    block make(%start: USize, %end: USize):
        %base      : Ptr<Byte> = %self.data
        %from      : Ptr<Byte> = %base[%start]
        %length    : USize     = %self.length
        %slice_len : USize     = %end.sub(%start)
        %result    : Self      = Self { data: %from, length: %slice_len }
        return(%result)

// -- heap-allocating operations ------------------------------------------------

/// Allocates a new buffer containing a followed by b.
/// The caller frees the returned String's data with `%data.free(%alloc)`.
routine String.concat(%a: Self, %b: Self, %alloc: Ptr<Allocator>) -> Self
    block entry():
        %la     : USize     = %a.length
        %lb     : USize     = %b.length
        %length : USize     = %la.add(%lb)
        %data   : Ptr<Byte> = allocate<Byte>(%alloc, %length.add(1))
        %failed : Bool      = %data.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : continue
        %src_a : Ptr<Byte> = %a.data
        %len_a : USize     = %a.length
        copy<Byte>(%data, %src_a, %len_a)
        jump copy_b(%data, %len_a)

    block copy_b(%data: Ptr<Byte>, %offset: USize):
        %dst   : Ptr<Byte> = %data[%offset]
        %src_b : Ptr<Byte> = %b.data
        %len_b : USize     = %b.length
        copy<Byte>(%dst, %src_b, %len_b)
        %length : USize = %offset.add(%len_b)
        %data[%length].store(0x00)
        %result : Self = Self { data: %data, length: %length }
        return(%result)

// -- equality, ordering, hashing -----------------------------------------------

routine String.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %la       : USize = %self.length
        %lb       : USize = %other.length
        %same_len : Bool  = %la.eq(%lb)
        branch %same_len ? loop(0, %la, %self.data, %other.data) : return(false)

    block loop(%i: USize, %len: USize, %pa: Ptr<Byte>, %pb: Ptr<Byte>):
        %done : Bool = %i.ge(%len)
        branch %done ? return(true) : continue
        %ba : U8   = .from_byte(%pa[%i].load())
        %bb : U8   = .from_byte(%pb[%i].load())
        %eq : Bool = %ba.eq(%bb)
        branch %eq ? loop(%i.add(1), %len, %pa, %pb) : return(false)

/// Lexicographic byte-wise compare. Returns -1, 0, 1.
/// Bytes are compared as U8, so this matches `memcmp` ordering.
routine String.compare(%self: Self, %other: Self) -> S32
    block entry():
        %la        : USize     = %self.length
        %lb        : USize     = %other.length
        %a_shorter : Bool      = %la.le(%lb)
        %min       : USize     = %a_shorter ? %la : %lb
        %pa        : Ptr<Byte> = %self.data
        %pb        : Ptr<Byte> = %other.data
        jump loop(0, %min, %la, %lb, %pa, %pb)

    block loop(%i: USize, %min: USize, %la: USize, %lb: USize, %pa: Ptr<Byte>, %pb: Ptr<Byte>):
        %done : Bool = %i.ge(%min)
        branch %done ? lengths(%la, %lb) : step(%i, %min, %la, %lb, %pa, %pb)

    block step(%i: USize, %min: USize, %la: USize, %lb: USize, %pa: Ptr<Byte>, %pb: Ptr<Byte>):
        %ba : U8   = .from_byte(%pa[%i].load())
        %bb : U8   = .from_byte(%pb[%i].load())
        %lt : Bool = %ba.lt(%bb)
        branch %lt ? return(-1) : maybe_gt(%i, %min, %la, %lb, %ba, %bb, %pa, %pb)

    block maybe_gt(%i: USize, %min: USize, %la: USize, %lb: USize, %ba: U8, %bb: U8, %pa: Ptr<Byte>,
            %pb: Ptr<Byte>):
        %gt : Bool = %ba.gt(%bb)
        branch %gt ? return(1) : loop(%i.add(1), %min, %la, %lb, %pa, %pb)

    block lengths(%la: USize, %lb: USize):
        %lt : Bool = %la.lt(%lb)
        branch %lt ? return(-1) : continue
        %gt : Bool = %la.gt(%lb)
        branch %gt ? return(1) : return(0)

/// xxHash64 of the byte contents, seeded with 0.
routine String.hash(%self: Self) -> U64
    block entry():
        %data : Ptr<Byte> = %self.data
        %len  : USize     = %self.length
        %h    : U64       = xxh64(%data, %len, 0)
        return(%h)

// -- search --------------------------------------------------------------------

routine String.starts_with(%self: Self, %prefix: Self) -> Bool
    block entry():
        %sl   : USize = %self.length
        %pl   : USize = %prefix.length
        %fits : Bool  = %pl.le(%sl)
        branch %fits ? loop(0, %pl, %self.data, %prefix.data) : return(false)

    block loop(%i: USize, %pl: USize, %sd: Ptr<Byte>, %pd: Ptr<Byte>):
        %done : Bool = %i.ge(%pl)
        branch %done ? return(true) : continue
        %a  : U8   = .from_byte(%sd[%i].load())
        %b  : U8   = .from_byte(%pd[%i].load())
        %eq : Bool = %a.eq(%b)
        branch %eq ? loop(%i.add(1), %pl, %sd, %pd) : return(false)

routine String.ends_with(%self: Self, %suffix: Self) -> Bool
    block entry():
        %sl   : USize = %self.length
        %fl   : USize = %suffix.length
        %fits : Bool  = %fl.le(%sl)
        branch %fits ? loop(0, %fl, %sl.sub(%fl), %self.data, %suffix.data) : return(false)

    block loop(%i: USize, %fl: USize, %off: USize, %sd: Ptr<Byte>, %fd: Ptr<Byte>):
        %done : Bool = %i.ge(%fl)
        branch %done ? return(true) : continue
        %idx : USize = %off.add(%i)
        %a   : U8    = .from_byte(%sd[%idx].load())
        %b   : U8    = .from_byte(%fd[%i].load())
        %eq  : Bool  = %a.eq(%b)
        branch %eq ? loop(%i.add(1), %fl, %off, %sd, %fd) : return(false)

/// Naive O(n*m) substring search. Returns the byte index of the first match,
/// or Option<USize>.Absent when not found. An empty needle matches at 0.
routine String.find(%self: Self, %needle: Self) -> Option<USize>
    block entry():
        %nlen         : USize = %needle.length
        %slen         : USize = %self.length
        %empty_needle : Bool  = %nlen.eq(0)
        branch %empty_needle ? hit(0) : check_fits(%nlen, %slen)

    block check_fits(%nlen: USize, %slen: USize):
        %too_big : Bool = %nlen.gt(%slen)
        branch %too_big ? miss() : start(%nlen, %slen)

    block miss():
        %r : Option<USize> = .Absent
        return(%r)

    block hit(%i: USize):
        %r : Option<USize> = .Present(%i)
        return(%r)

    block start(%nlen: USize, %slen: USize):
        %sd   : Ptr<Byte> = %self.data
        %nd   : Ptr<Byte> = %needle.data
        %last : USize     = %slen.sub(%nlen)
        jump outer(0, %last, %nlen, %sd, %nd)

    block outer(%i: USize, %last: USize, %nlen: USize, %sd: Ptr<Byte>, %nd: Ptr<Byte>):
        %past : Bool = %i.gt(%last)
        branch %past ? miss() : inner(%i, 0, %last, %nlen, %sd, %nd)

    block inner(%i: USize, %j: USize, %last: USize, %nlen: USize, %sd: Ptr<Byte>, %nd: Ptr<Byte>):
        %done : Bool = %j.ge(%nlen)
        branch %done ? hit(%i) : check(%i, %j, %last, %nlen, %sd, %nd)

    block check(%i: USize, %j: USize, %last: USize, %nlen: USize, %sd: Ptr<Byte>, %nd: Ptr<Byte>):
        %idx : USize = %i.add(%j)
        %a   : U8    = .from_byte(%sd[%idx].load())
        %b   : U8    = .from_byte(%nd[%j].load())
        %eq  : Bool  = %a.eq(%b)
        branch %eq
            ? inner(%i, %j.add(1), %last, %nlen, %sd, %nd)
            : outer(%i.add(1), %last, %nlen, %sd, %nd)

routine String.contains(%self: Self, %needle: Self) -> Bool
    block entry():
        %r     : Option<USize> = %self.find(%needle)
        %found : Bool          = %r.is_present()
        return(%found)

// -- iterators -----------------------------------------------------------------

routine String.bytes(%self: Self) -> StringBytesIter
    block entry():
        %iter : StringBytesIter = StringBytesIter { str: %self, index: 0 }
        return(%iter)

routine String.chars(%self: Self) -> StringCharsIter
    block entry():
        %iter : StringCharsIter = StringCharsIter { str: %self, index: 0 }
        return(%iter)
