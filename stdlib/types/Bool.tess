// Tessera stdlib: Bool — 1-bit boolean
//
// Maps to LLVM IR i1.

module Standard::Core

@llvm("i1")
record Bool
conform Equal<Bool>, Hash<Bool>

// -- bitwise operations --------------------------------------------------------

routine Bool.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = band<Self>(%self, %other)
        return(%r)

routine Bool.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = bor<Self>(%self, %other)
        return(%r)

routine Bool.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r : Self = bxor<Self>(%self, %other)
        return(%r)

routine Bool.bitnot(%self: Self) -> Self
    block entry():
        %r : Self = bnot<Self>(%self)
        return(%r)

// -- equality, hashing ---------------------------------------------------------

routine Bool.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = ieq<Self>(%self, %other)
        return(%r)

routine Bool.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r : Bool = ine<Self>(%self, %other)
        return(%r)

routine Bool.hash(%self: Self) -> U64
    block entry():
        %h : U64 = xxh64_hash_u64(%self.to_u64(), 0)
        return(%h)

// -- options ---------------------------------------------------------------------

/// Some(%value) when true, None when false (Rust's bool::then_some).
routine Bool.then_some<T>(%self: Self, %value: T) -> Option<T>
require T: typename
    block entry():
        branch %self ? some() : none()

    block some():
        %r : Option<T> = .some(%value)
        return(%r)

    block none():
        %r : Option<T> = .none()
        return(%r)

// -- generic conversions -------------------------------------------------------

routine Bool.zext<To>(%self: Self) -> To
require To: typename
    block entry():
        %r : To = zext<Self, To>(%self)
        return(%r)

// -- named conversions ---------------------------------------------------------

routine Bool.to_s8(%self: Self) -> S8
    block entry():
        %result : S8 = zext<Self, S8>(%self)
        return(%result)

routine Bool.to_s32(%self: Self) -> S32
    block entry():
        %result : S32 = zext<Self, S32>(%self)
        return(%result)

routine Bool.to_s64(%self: Self) -> S64
    block entry():
        %result : S64 = zext<Self, S64>(%self)
        return(%result)

routine Bool.to_s128(%self: Self) -> S128
    block entry():
        %result : S128 = zext<Self, S128>(%self)
        return(%result)

routine Bool.to_u8(%self: Self) -> U8
    block entry():
        %result : U8 = zext<Self, U8>(%self)
        return(%result)

routine Bool.to_u32(%self: Self) -> U32
    block entry():
        %result : U32 = zext<Self, U32>(%self)
        return(%result)

routine Bool.to_u64(%self: Self) -> U64
    block entry():
        %result : U64 = zext<Self, U64>(%self)
        return(%result)

routine Bool.to_u128(%self: Self) -> U128
    block entry():
        %result : U128 = zext<Self, U128>(%self)
        return(%result)
