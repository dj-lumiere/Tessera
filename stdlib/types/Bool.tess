; Tessera stdlib: Bool — 1-bit boolean
;
; Maps to LLVM IR i1.

@llvm("i1")
record Bool
conform Equal<Bool>, Hash<Bool>

; -- bitwise operations --------------------------------------------------------

routine Bool.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)

routine Bool.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)

routine Bool.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)

routine Bool.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)

; -- equality, hashing ---------------------------------------------------------

routine Bool.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine Bool.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)


routine Bool.hash(%self: Self) -> I64
    block entry():
        %v: I64 = %self.zext<I64>()
        %h: I64 = xxh64_hash_i64(%v, 0)
        return(%h)

; -- options ---------------------------------------------------------------------

; Some(%value) when true, None when false (Rust's bool::then_some).
routine Bool.then_some<T>(%self: Self, %value: T) -> Option<T>
require T: typename
    block entry():
        branch %self ? some() : none()

    block some():
        %r: Option<T> = Option<T>.some(%value)
        return(%r)

    block none():
        %r: Option<T> = Option<T>.none()
        return(%r)

; -- generic conversions -------------------------------------------------------

routine Bool.zext<To>(%self: Self) -> To
require To: typename
    block entry():
        %r: To = zext<Self, To>(%self)
        return(%r)

; -- named conversions ---------------------------------------------------------

routine Bool.to_i8(%self: Self) -> I8
    block entry():
        %result: I8 = zext<Self, I8>(%self)
        return(%result)

routine Bool.to_i32(%self: Self) -> I32
    block entry():
        %result: I32 = zext<Self, I32>(%self)
        return(%result)

routine Bool.to_i64(%self: Self) -> I64
    block entry():
        %result: I64 = zext<Self, I64>(%self)
        return(%result)

routine Bool.to_i128(%self: Self) -> I128
    block entry():
        %result: I128 = zext<Self, I128>(%self)
        return(%result)
