; Tessera stdlib: I32 — 32-bit signed integer
;
; Maps to LLVM IR i32.

@llvm("i32")
record I32
conform Equal<I32>, Compare<I32>, Hash<I32>

; -- constants -----------------------------------------------------------------

const I32.MIN: I32 = -2147483648
const I32.MAX: I32 =  2147483647

; -- bit operations ------------------------------------------------------------

routine I32.count_ones(%self: Self) -> Self
    block entry():
        %result: Self = popcount<Self>(%self)
        return(%result)

routine I32.leading_zeros(%self: Self) -> Self
    block entry():
        %result: Self = clz<Self>(%self, false)
        return(%result)

routine I32.trailing_zeros(%self: Self) -> Self
    block entry():
        %result: Self = ctz<Self>(%self, false)
        return(%result)

routine I32.swap_bytes(%self: Self) -> Self
    block entry():
        %result: Self = bswap<Self>(%self)
        return(%result)

; -- arithmetic ----------------------------------------------------------------

routine I32.abs(%self: Self) -> Self
    block entry():
        %is_neg: Bool = %self.slt(0)
        %neg: Self = 0.sub(%self)
        %result: Self = %is_neg ? %neg : %self
        return(%result)

routine I32.min(%self: Self, %other: Self) -> Self
    block entry():
        %less: Bool = %self.slt(%other)
        %result: Self = %less ? %self : %other
        return(%result)

routine I32.max(%self: Self, %other: Self) -> Self
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: Self = %more ? %self : %other
        return(%result)

routine I32.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = add<Self>(%self, %other)
        return(%r)

routine I32.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sub<Self>(%self, %other)
        return(%r)

routine I32.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = mul<Self>(%self, %other)
        return(%r)

; -- bit shifts ----------------------------------------------------------------

routine I32.shl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = shl<Self>(%self, %n)
        return(%r)

routine I32.lshr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = lshr<Self>(%self, %n)
        return(%r)

routine I32.ashr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = ashr<Self>(%self, %n)
        return(%r)

; Rotates by %n modulo the bit width.
routine I32.rotl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = fshl<Self>(%self, %self, %n)
        return(%r)

routine I32.rotr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = fshr<Self>(%self, %self, %n)
        return(%r)

; -- bitwise operations --------------------------------------------------------

routine I32.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)

routine I32.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)

routine I32.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)

routine I32.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)

; -- signed comparisons --------------------------------------------------------

routine I32.slt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = slt<Self>(%self, %other)
        return(%r)

routine I32.sle(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sle<Self>(%self, %other)
        return(%r)

routine I32.sgt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sgt<Self>(%self, %other)
        return(%r)

routine I32.sge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sge<Self>(%self, %other)
        return(%r)

; -- unsigned comparisons ------------------------------------------------------

routine I32.ult(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ult<Self>(%self, %other)
        return(%r)

routine I32.ule(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ule<Self>(%self, %other)
        return(%r)

routine I32.ugt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ugt<Self>(%self, %other)
        return(%r)

routine I32.uge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = uge<Self>(%self, %other)
        return(%r)

; -- integer division and remainder --------------------------------------------

routine I32.sdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sdiv<Self>(%self, %other)
        return(%r)

routine I32.udiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = udiv<Self>(%self, %other)
        return(%r)

routine I32.srem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = srem<Self>(%self, %other)
        return(%r)

routine I32.urem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = urem<Self>(%self, %other)
        return(%r)

; -- equality, ordering, hashing -----------------------------------------------

routine I32.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine I32.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)

routine I32.compare(%self: Self, %other: Self) -> Self
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I32.hash(%self: Self) -> I64
    block entry():
        %h: I64 = xxh64_hash_i64(%self.to_u64(), 0)
        return(%h)

; -- narrowing conversions -----------------------------------------------------

routine I32.to_i8(%self: Self) -> I8
    block entry():
        %result: I8 = trunc<Self, I8>(%self)
        return(%result)

routine I32.to_i16(%self: Self) -> I16
    block entry():
        %result: I16 = trunc<Self, I16>(%self)
        return(%result)

; -- widening conversions (sign-extending) -------------------------------------

routine I32.to_i64(%self: Self) -> I64
    block entry():
        %result: I64 = sext<Self, I64>(%self)
        return(%result)

routine I32.to_u64(%self: Self) -> I64
    block entry():
        %result: I64 = zext<Self, I64>(%self)
        return(%result)

; -- float conversions ---------------------------------------------------------

routine I32.to_f32(%self: Self) -> F32
    block entry():
        %result: F32 = sitofp<Self, F32>(%self)
        return(%result)

routine I32.to_f64(%self: Self) -> F64
    block entry():
        %result: F64 = sitofp<Self, F64>(%self)
        return(%result)

; ============================================================
; Rust-level operations
;
; Where signed and unsigned readings of the bits differ, the name says which
; with s / u on the operation (checked_sadd, uilog2), as in slt / ult.
; ============================================================

; -- constants ------------------------------------------------------------------

const I32.BITS: I32 = 32
const I32.UMAX: I32 = -1   ; all bits set: the largest value read as unsigned

; -- bits ----------------------------------------------------------------------

routine I32.count_zeros(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = popcount<Self>(%inverted)
        return(%r)

routine I32.leading_ones(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = clz<Self>(%inverted, false)
        return(%r)

routine I32.trailing_ones(%self: Self) -> Self
    block entry():
        %inverted: Self = %self.bitnot()
        %r: Self = ctz<Self>(%inverted, false)
        return(%r)

routine I32.reverse_bits(%self: Self) -> Self
    block entry():
        %r: Self = bitreverse<Self>(%self)
        return(%r)

; True when exactly one bit is set (so I64.MIN counts: it is 2^63 read as unsigned).
routine I32.is_power_of_two(%self: Self) -> Bool
    block entry():
        %ones: Self = popcount<Self>(%self)
        %r: Bool = %ones.eq(1)
        return(%r)

; -- byte order ----------------------------------------------------------------

routine I32.to_be(%self: Self) -> Self
    block entry():
        %r: Self = %self.swap_bytes()
        return(%r)

routine I32.from_be(%self: Self) -> Self
    block entry():
        %r: Self = %self.swap_bytes()
        return(%r)

routine I32.to_le(%self: Self) -> Self
    block entry():
        return(%self)

routine I32.from_le(%self: Self) -> Self
    block entry():
        return(%self)

; -- sign ----------------------------------------------------------------------

; Wrapping negation: MIN.neg() is MIN.
routine I32.neg(%self: Self) -> Self
    block entry():
        %r: Self = 0.sub(%self)
        return(%r)

; -1, 0, or 1.
routine I32.signum(%self: Self) -> Self
    block entry():
        %negative: Bool = %self.slt(0)
        %positive: Bool = %self.sgt(0)
        %non_negative: Self = %positive ? 1 : 0
        %r: Self = %negative ? -1 : %non_negative
        return(%r)

routine I32.is_negative(%self: Self) -> Bool
    block entry():
        %r: Bool = %self.slt(0)
        return(%r)

routine I32.is_positive(%self: Self) -> Bool
    block entry():
        %r: Bool = %self.sgt(0)
        return(%r)

; -- ordering ------------------------------------------------------------------

routine I32.umin(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = umin<Self>(%self, %other)
        return(%r)

routine I32.umax(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = umax<Self>(%self, %other)
        return(%r)

; Signed. Traps if %lo > %hi.
routine I32.clamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid: Bool = %lo.sle(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %at_least_lo: Self = smax<Self>(%self, %lo)
        %r: Self = smin<Self>(%at_least_lo, %hi)
        return(%r)

; Unsigned. Traps if %lo > %hi.
routine I32.uclamp(%self: Self, %lo: Self, %hi: Self) -> Self
    block entry():
        %valid: Bool = %lo.ule(%hi)
        branch %valid ? clamp() : panic(TrapCode.InvalidArgument)

    block clamp():
        %at_least_lo: Self = umax<Self>(%self, %lo)
        %r: Self = umin<Self>(%at_least_lo, %hi)
        return(%r)

routine I32.ucompare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.ult(%other)
        branch %lt ? return(-1) : maybe_gt()

    block maybe_gt():
        %gt: Bool = %self.ugt(%other)
        branch %gt ? return(1) : return(0)

; -- checked -------------------------------------------------------------------

routine I32.checked_sadd(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = sadd_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.add(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I32.checked_uadd(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = uadd_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.add(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I32.checked_ssub(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = ssub_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.sub(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I32.checked_usub(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = usub_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.sub(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I32.checked_smul(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = smul_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.mul(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

routine I32.checked_umul(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %overflow: Bool = umul_overflows<Self>(%self, %other)
        %fits: Bool = %overflow.bitnot()
        %result: Self = %self.mul(%other)
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

; None when %other is 0, or for MIN.sdiv(-1), which overflows.
routine I32.checked_sdiv(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero: Bool = %other.eq(0)
        %overflows: Bool = %self.eq(Self.MIN).bitand(%other.eq(-1))
        %invalid: Bool = %by_zero.bitor(%overflows)
        branch %invalid ? none() : divide()

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

    block divide():
        %result: Self = %self.sdiv(%other)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

; None when %other is 0, or for MIN.srem(-1), which overflows.
routine I32.checked_srem(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero: Bool = %other.eq(0)
        %overflows: Bool = %self.eq(Self.MIN).bitand(%other.eq(-1))
        %invalid: Bool = %by_zero.bitor(%overflows)
        branch %invalid ? none() : divide()

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

    block divide():
        %result: Self = %self.srem(%other)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

; None when %other is 0.
routine I32.checked_udiv(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? none() : divide()

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

    block divide():
        %result: Self = %self.udiv(%other)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

; None when %other is 0.
routine I32.checked_urem(%self: Self, %other: Self) -> Option<Self>
    block entry():
        %by_zero: Bool = %other.eq(0)
        branch %by_zero ? none() : divide()

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

    block divide():
        %result: Self = %self.urem(%other)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

; None for MIN, whose negation overflows.
routine I32.checked_sneg(%self: Self) -> Option<Self>
    block entry():
        %fits: Bool = %self.ne(Self.MIN)
        %result: Self = %self.neg()
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

; Unsigned negation only fits for 0.
routine I32.checked_uneg(%self: Self) -> Option<Self>
    block entry():
        %fits: Bool = %self.eq(0)
        %r: Option<Self> = %fits.then_some(%self)
        return(%r)

; None for MIN, whose absolute value overflows.
routine I32.checked_sabs(%self: Self) -> Option<Self>
    block entry():
        %fits: Bool = %self.ne(Self.MIN)
        %result: Self = %self.abs()
        %r: Option<Self> = %fits.then_some(%result)
        return(%r)

; None when %n is not below the bit width (read as unsigned).
routine I32.checked_shl(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range: Bool = %n.ult(Self.BITS)
        branch %in_range ? shift() : none()

    block shift():
        %result: Self = %self.shl(%n)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

; None when %n is not below the bit width (read as unsigned).
routine I32.checked_lshr(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range: Bool = %n.ult(Self.BITS)
        branch %in_range ? shift() : none()

    block shift():
        %result: Self = %self.lshr(%n)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

; None when %n is not below the bit width (read as unsigned).
routine I32.checked_ashr(%self: Self, %n: Self) -> Option<Self>
    block entry():
        %in_range: Bool = %n.ult(Self.BITS)
        branch %in_range ? shift() : none()

    block shift():
        %result: Self = %self.ashr(%n)
        %r: Option<Self> = Option<Self>.some(%result)
        return(%r)

    block none():
        %r: Option<Self> = Option<Self>.none()
        return(%r)

; -- powers --------------------------------------------------------------------

; Wrapping power by squaring. %exp is read as unsigned.
routine I32.pow(%self: Self, %exp: I32) -> Self
    block entry():
        jump loop(%self, %exp, 1)

    block loop(%base: Self, %exp: I32, %acc: Self):
        %done: Bool = %exp.eq(0)
        branch %done ? return(%acc) : step(%base, %exp, %acc)

    block step(%base: Self, %exp: I32, %acc: Self):
        %odd: Bool = %exp.bitand(1).ne(0)
        %with_base: Self = %acc.mul(%base)
        %next_acc: Self = %odd ? %with_base : %acc
        jump loop(%base.mul(%base), %exp.lshr(1), %next_acc)

; None if any step overflows (signed). %exp is read as unsigned.
routine I32.checked_spow(%self: Self, %exp: I32) -> Option<Self>
    block entry():
        jump loop(%self, %exp, 1, false)

    block loop(%base: Self, %exp: I32, %acc: Self, %overflow: Bool):
        %done: Bool = %exp.eq(0)
        branch %done ? finish(%acc, %overflow) : step(%base, %exp, %acc, %overflow)

    ; The accumulator only multiplies on odd bits, and the base only needs
    ; squaring while bits remain, so only those overflows count.
    block step(%base: Self, %exp: I32, %acc: Self, %overflow: Bool):
        %odd: Bool = %exp.bitand(1).ne(0)
        %acc_overflow: Bool = smul_overflows<Self>(%acc, %base).bitand(%odd)
        %with_base: Self = %acc.mul(%base)
        %next_acc: Self = %odd ? %with_base : %acc
        %rest: I32 = %exp.lshr(1)
        %more: Bool = %rest.ne(0)
        %base_overflow: Bool = smul_overflows<Self>(%base, %base).bitand(%more)
        %any: Bool = %overflow.bitor(%acc_overflow).bitor(%base_overflow)
        jump loop(%base.mul(%base), %rest, %next_acc, %any)

    block finish(%acc: Self, %overflow: Bool):
        %fits: Bool = %overflow.bitnot()
        %r: Option<Self> = %fits.then_some(%acc)
        return(%r)

; None if any step overflows (unsigned). %exp is read as unsigned.
routine I32.checked_upow(%self: Self, %exp: I32) -> Option<Self>
    block entry():
        jump loop(%self, %exp, 1, false)

    block loop(%base: Self, %exp: I32, %acc: Self, %overflow: Bool):
        %done: Bool = %exp.eq(0)
        branch %done ? finish(%acc, %overflow) : step(%base, %exp, %acc, %overflow)

    ; The accumulator only multiplies on odd bits, and the base only needs
    ; squaring while bits remain, so only those overflows count.
    block step(%base: Self, %exp: I32, %acc: Self, %overflow: Bool):
        %odd: Bool = %exp.bitand(1).ne(0)
        %acc_overflow: Bool = umul_overflows<Self>(%acc, %base).bitand(%odd)
        %with_base: Self = %acc.mul(%base)
        %next_acc: Self = %odd ? %with_base : %acc
        %rest: I32 = %exp.lshr(1)
        %more: Bool = %rest.ne(0)
        %base_overflow: Bool = umul_overflows<Self>(%base, %base).bitand(%more)
        %any: Bool = %overflow.bitor(%acc_overflow).bitor(%base_overflow)
        jump loop(%base.mul(%base), %rest, %next_acc, %any)

    block finish(%acc: Self, %overflow: Bool):
        %fits: Bool = %overflow.bitnot()
        %r: Option<Self> = %fits.then_some(%acc)
        return(%r)

; MAX or MIN (by the sign the exact result would have) on overflow.
routine I32.saturating_spow(%self: Self, %exp: I32) -> Self
    block entry():
        %odd_exp: Bool = %exp.bitand(1).ne(0)
        %negative_result: Bool = %self.slt(0).bitand(%odd_exp)
        %limit: Self = %negative_result ? Self.MIN : Self.MAX
        %checked: Option<Self> = %self.checked_spow(%exp)
        %r: Self = %checked.unwrap_or(%limit)
        return(%r)

routine I32.saturating_upow(%self: Self, %exp: I32) -> Self
    block entry():
        %checked: Option<Self> = %self.checked_upow(%exp)
        %r: Self = %checked.unwrap_or(Self.UMAX)
        return(%r)

; -- saturating ----------------------------------------------------------------

routine I32.saturating_sadd(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sadd_sat<Self>(%self, %other)
        return(%r)

routine I32.saturating_uadd(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = uadd_sat<Self>(%self, %other)
        return(%r)

routine I32.saturating_ssub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = ssub_sat<Self>(%self, %other)
        return(%r)

routine I32.saturating_usub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = usub_sat<Self>(%self, %other)
        return(%r)

; MAX or MIN (by the sign of the exact product) on overflow.
routine I32.saturating_smul(%self: Self, %other: Self) -> Self
    block entry():
        %overflow: Bool = smul_overflows<Self>(%self, %other)
        %negative_result: Bool = %self.bitxor(%other).slt(0)
        %limit: Self = %negative_result ? Self.MIN : Self.MAX
        %product: Self = %self.mul(%other)
        %r: Self = %overflow ? %limit : %product
        return(%r)

routine I32.saturating_umul(%self: Self, %other: Self) -> Self
    block entry():
        %overflow: Bool = umul_overflows<Self>(%self, %other)
        %product: Self = %self.mul(%other)
        %r: Self = %overflow ? Self.UMAX : %product
        return(%r)

; MIN saturates to MAX.
routine I32.saturating_sneg(%self: Self) -> Self
    block entry():
        %r: Self = ssub_sat<Self>(0, %self)
        return(%r)

; MIN saturates to MAX.
routine I32.saturating_sabs(%self: Self) -> Self
    block entry():
        %is_min: Bool = %self.eq(Self.MIN)
        %abs: Self = %self.abs()
        %r: Self = %is_min ? Self.MAX : %abs
        return(%r)

; -- wrapping ------------------------------------------------------------------

; MIN.wrapping_sdiv(-1) is MIN. Division by zero is still undefined.
routine I32.wrapping_sdiv(%self: Self, %other: Self) -> Self
    block entry():
        %overflows: Bool = %self.eq(Self.MIN).bitand(%other.eq(-1))
        branch %overflows ? return(Self.MIN) : divide()

    block divide():
        %r: Self = %self.sdiv(%other)
        return(%r)

; MIN.wrapping_srem(-1) is 0. Division by zero is still undefined.
routine I32.wrapping_srem(%self: Self, %other: Self) -> Self
    block entry():
        %overflows: Bool = %self.eq(Self.MIN).bitand(%other.eq(-1))
        branch %overflows ? return(0) : divide()

    block divide():
        %r: Self = %self.srem(%other)
        return(%r)

; Shifts by %n modulo the bit width.
routine I32.wrapping_shl(%self: Self, %n: Self) -> Self
    block entry():
        %amount: Self = %n.bitand(Self.BITS.sub(1))
        %r: Self = %self.shl(%amount)
        return(%r)

; Shifts by %n modulo the bit width.
routine I32.wrapping_lshr(%self: Self, %n: Self) -> Self
    block entry():
        %amount: Self = %n.bitand(Self.BITS.sub(1))
        %r: Self = %self.lshr(%amount)
        return(%r)

; Shifts by %n modulo the bit width.
routine I32.wrapping_ashr(%self: Self, %n: Self) -> Self
    block entry():
        %amount: Self = %n.bitand(Self.BITS.sub(1))
        %r: Self = %self.ashr(%amount)
        return(%r)

; -- overflowing ---------------------------------------------------------------

routine I32.overflowing_sadd(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.add(%other)
        %overflow: Bool = sadd_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I32.overflowing_uadd(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.add(%other)
        %overflow: Bool = uadd_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I32.overflowing_ssub(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.sub(%other)
        %overflow: Bool = ssub_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I32.overflowing_usub(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.sub(%other)
        %overflow: Bool = usub_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I32.overflowing_smul(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.mul(%other)
        %overflow: Bool = smul_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

routine I32.overflowing_umul(%self: Self, %other: Self) -> Overflowing<Self>
    block entry():
        %value: Self = %self.mul(%other)
        %overflow: Bool = umul_overflows<Self>(%self, %other)
        %r: Overflowing<Self> = Overflowing<Self>.new(%value, %overflow)
        return(%r)

; -- division ------------------------------------------------------------------

; Quotient of Euclidean division: the remainder is never negative.
; Division by zero and MIN.sdiv_euclid(-1) are undefined, as for sdiv.
routine I32.sdiv_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %q: Self = %self.sdiv(%other)
        %rem: Self = %self.srem(%other)
        %rem_negative: Bool = %rem.slt(0)
        branch %rem_negative ? adjust(%q) : return(%q)

    block adjust(%q: Self):
        %positive_divisor: Bool = %other.sgt(0)
        %down: Self = %q.sub(1)
        %up: Self = %q.add(1)
        %r: Self = %positive_divisor ? %down : %up
        return(%r)

; Remainder of Euclidean division: always in 0 ..< |other|.
routine I32.srem_euclid(%self: Self, %other: Self) -> Self
    block entry():
        %rem: Self = %self.srem(%other)
        %rem_negative: Bool = %rem.slt(0)
        branch %rem_negative ? adjust(%rem) : return(%rem)

    block adjust(%rem: Self):
        %magnitude: Self = %other.abs()
        %r: Self = %rem.add(%magnitude)
        return(%r)

; Unsigned division rounding up. Division by zero is undefined.
routine I32.udiv_ceil(%self: Self, %other: Self) -> Self
    block entry():
        %q: Self = %self.udiv(%other)
        %rem: Self = %self.urem(%other)
        %exact: Bool = %rem.eq(0)
        %up: Self = %q.add(1)
        %r: Self = %exact ? %q : %up
        return(%r)

; The smallest multiple of %other that is >= %self (unsigned, wrapping).
routine I32.unext_multiple_of(%self: Self, %other: Self) -> Self
    block entry():
        %rem: Self = %self.urem(%other)
        %exact: Bool = %rem.eq(0)
        %gap: Self = %other.sub(%rem)
        %up: Self = %self.add(%gap)
        %r: Self = %exact ? %self : %up
        return(%r)

; |self - other| without overflow, as unsigned bits.
routine I32.sabs_diff(%self: Self, %other: Self) -> Self
    block entry():
        %hi: Self = smax<Self>(%self, %other)
        %lo: Self = smin<Self>(%self, %other)
        %r: Self = %hi.sub(%lo)
        return(%r)

routine I32.uabs_diff(%self: Self, %other: Self) -> Self
    block entry():
        %hi: Self = umax<Self>(%self, %other)
        %lo: Self = umin<Self>(%self, %other)
        %r: Self = %hi.sub(%lo)
        return(%r)

; floor((self + other) / 2) without overflow, unsigned.
routine I32.umidpoint(%self: Self, %other: Self) -> Self
    block entry():
        %common: Self = %self.bitand(%other)
        %half_diff: Self = %self.bitxor(%other).lshr(1)
        %r: Self = %common.add(%half_diff)
        return(%r)

; (self + other) / 2 without overflow, signed, rounded toward zero.
routine I32.smidpoint(%self: Self, %other: Self) -> Self
    block entry():
        %common: Self = %self.bitand(%other)
        %half_diff: Self = %self.bitxor(%other).ashr(1)
        %floor: Self = %common.add(%half_diff)
        %odd_sum: Bool = %self.bitxor(%other).bitand(1).ne(0)
        %round_up: Bool = %odd_sum.bitand(%floor.slt(0))
        %up: Self = %floor.add(1)
        %r: Self = %round_up ? %up : %floor
        return(%r)

; -- logarithms ----------------------------------------------------------------

; floor(log2(self)), unsigned. Traps on 0.
routine I32.uilog2(%self: Self) -> Self
    block entry():
        %zero: Bool = %self.eq(0)
        branch %zero ? panic(TrapCode.InvalidArgument) : log()

    block log():
        %lz: Self = clz<Self>(%self, true)
        %r: Self = Self.BITS.sub(1).sub(%lz)
        return(%r)

; floor(log2(self)), signed. Traps on values <= 0.
routine I32.silog2(%self: Self) -> Self
    block entry():
        %positive: Bool = %self.sgt(0)
        branch %positive ? log() : panic(TrapCode.InvalidArgument)

    block log():
        %r: Self = %self.uilog2()
        return(%r)

; floor(log10(self)), unsigned. Traps on 0.
routine I32.uilog10(%self: Self) -> Self
    block entry():
        %zero: Bool = %self.eq(0)
        branch %zero ? panic(TrapCode.InvalidArgument) : loop(%self, 0)

    block loop(%rest: Self, %digits: Self):
        %last: Bool = %rest.ult(10)
        branch %last ? return(%digits) : next(%rest, %digits)

    block next(%rest: Self, %digits: Self):
        jump loop(%rest.udiv(10), %digits.add(1))

; floor(log10(self)), signed. Traps on values <= 0.
routine I32.silog10(%self: Self) -> Self
    block entry():
        %positive: Bool = %self.sgt(0)
        branch %positive ? log() : panic(TrapCode.InvalidArgument)

    block log():
        %r: Self = %self.uilog10()
        return(%r)

; floor(sqrt(self)), unsigned, computed one result bit at a time.
routine I32.uisqrt(%self: Self) -> Self
    block entry():
        %top_bit: Self = 1.shl(Self.BITS.sub(2))
        jump align(%top_bit)

    ; Start from the highest power of four that is <= self.
    block align(%bit: Self):
        %too_big: Bool = %bit.ugt(%self)
        branch %too_big ? align(%bit.lshr(2)) : loop(%self, 0, %bit)

    block loop(%rest: Self, %root: Self, %bit: Self):
        %done: Bool = %bit.eq(0)
        branch %done ? return(%root) : step(%rest, %root, %bit)

    block step(%rest: Self, %root: Self, %bit: Self):
        %trial: Self = %root.add(%bit)
        %fits: Bool = %rest.uge(%trial)
        %half_root: Self = %root.lshr(1)
        %next_bit: Self = %bit.lshr(2)
        branch %fits ? take(%rest, %trial, %half_root, %bit, %next_bit) \
                     : loop(%rest, %half_root, %next_bit)

    block take(%rest: Self, %trial: Self, %half_root: Self, %bit: Self, %next_bit: Self):
        jump loop(%rest.sub(%trial), %half_root.add(%bit), %next_bit)

; floor(sqrt(self)), signed. Traps on negative values.
routine I32.sisqrt(%self: Self) -> Self
    block entry():
        %negative: Bool = %self.slt(0)
        branch %negative ? panic(TrapCode.InvalidArgument) : root()

    block root():
        %r: Self = %self.uisqrt()
        return(%r)

; The smallest power of two >= self (unsigned); 0 and 1 give 1. Wraps to 0
; when the answer does not fit.
routine I32.unext_power_of_two(%self: Self) -> Self
    block entry():
        %small: Bool = %self.ule(1)
        branch %small ? return(1) : round_up()

    ; A shift by the full width would be poison; select 0 for that case instead.
    block round_up():
        %below: Self = %self.sub(1)
        %lz: Self = clz<Self>(%below, true)
        %shift: Self = Self.BITS.sub(%lz)
        %fits: Bool = %shift.ult(Self.BITS)
        %power: Self = 1.shl(%shift)
        %r: Self = %fits ? %power : 0
        return(%r)

; -- conversions --------------------------------------------------------------

routine I32.to_i32(%self: Self) -> I32
    block entry():
        return(%self)

routine I32.to_i128(%self: Self) -> I128
    block entry():
        %r: I128 = sext<Self, I128>(%self)
        return(%r)

routine I32.to_u32(%self: Self) -> I32
    block entry():
        return(%self)

routine I32.to_u128(%self: Self) -> I128
    block entry():
        %r: I128 = zext<Self, I128>(%self)
        return(%r)

routine I32.to_i256(%self: Self) -> I256
    block entry():
        %r: I256 = sext<Self, I256>(%self)
        return(%r)

routine I32.to_u256(%self: Self) -> I256
    block entry():
        %r: I256 = zext<Self, I256>(%self)
        return(%r)

; Reads the integer as unsigned.
routine I32.uto_f32(%self: Self) -> F32
    block entry():
        %r: F32 = uitofp<Self, F32>(%self)
        return(%r)

; Reads the integer as unsigned.
routine I32.uto_f64(%self: Self) -> F64
    block entry():
        %r: F64 = uitofp<Self, F64>(%self)
        return(%r)
