// Tessera stdlib: StringCharsIter
//
// Forward iterator over the characters (Char) of a UTF-8 String.
// Advances by a variable number of bytes per step via utf8_decode.
// next() returns Option<Char>.Absent after the last character.
// A malformed byte sequence yields U+FFFD (the replacement character) and
// advances past the offending byte, so iteration always terminates.
//
// Satisfies concept Iterator<Char, StringCharsIter>.

module Standard::Core

record StringCharsIter
conform Iterator<Char, StringCharsIter>
    str   : String
    index : U64

routine StringCharsIter.construct(%str: String) -> Self
    block entry():
        %iter : Self = Self { str: %str, index: 0 }
        return(%iter)

routine StringCharsIter.next(%self: Ptr<Self>) -> Option<Char>
    block entry():
        %index   : U64    = %self.index.load()
        %str     : String = %self.str.load()
        %str_len : U64    = %str.length
        %done    : Bool   = %index.ge(%str_len)
        branch %done ? return_none() : decode(%index, %str)

    block return_none():
        %none : Option<Char> = .Absent
        return(%none)

    block decode(%index: U64, %str: String):
        %data    : Ptr<Byte>   = %str.data
        %decoded : Utf8Decoded = utf8_decode(%data, %index, %str.length)
        %ok      : Bool        = %decoded.ok
        // on a decode error next_pos == index; advance by 1 to avoid an infinite loop
        %safe_next : U64 = %index.add(1)
        %advance   : U64 = %ok ? %decoded.next_pos : %safe_next
        %self.index.store(%advance)
        %some : Option<Char> = .Present(%decoded.char)
        return(%some)
