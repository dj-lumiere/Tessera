; Tessera stdlib: StringCharsIter
;
; Forward iterator over the Unicode codepoints (I32) of a UTF-8 String.
; Advances by a variable number of bytes per step via utf8_decode.
; next() returns Option<I32>.none() after the last codepoint.
; Returns Option<I32>.some(-1) for any malformed byte sequence and
; advances past the offending byte so iteration always terminates.
;
; Satisfies concept Iterator<I32, StringCharsIter>.

record StringCharsIter
conform Iterator<I32, StringCharsIter>
    str:   String
    index: I64

routine StringCharsIter.new(%str: String) -> Self
    block entry():
        %iter: Self = Self { str: %str, index: 0 }
        return(%iter)

routine StringCharsIter.next(#self: Ptr<Self>) -> Option<I32>
    block entry():
        %index: I64  := #self.index
        %str: String := #self.str
        %str_len: I64 = %str.length
        %done: Bool = %index.sge(%str_len)
        branch %done ? return_none() : decode(%index, %str)

    block return_none():
        %none: Option<I32> = Option<I32>.none()
        return(%none)

    block decode(%index: I64, %str: String):
        #data: Ptr<I8>      = %str.data
        %decoded: Utf8Decoded = utf8_decode(#data, %index, %str.length)
        %cp: I32   = %decoded.codepoint
        %next: I64 = %decoded.next_pos
        ; on decode error next_pos == index; advance by 1 to avoid infinite loop
        %is_err: Bool  = %cp.eq(-1)
        %safe_next: I64 = %index.add(1)
        %advance: I64  = %is_err ? %safe_next : %next
        #self.index = %advance
        %some: Option<I32> = Option<I32>.some(%cp)
        return(%some)
