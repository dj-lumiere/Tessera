// Tessera stdlib: F128 ln_1p, log2, log10
//
// ln(1 + x), log2 x, and log10 x, correctly rounded. CORE-MATH has no binary128 versions of these, so they run in
// the two tiers of sin_pi (f128_extra.tess):
//
// - fast: the value in F128Extended (stdlib/f128_math.tess: wide_ln_1p, or wide_log times 1/ln 2 or 1/ln 10). It
//   is kept when all of it × (1 ± 2^-BAND) rounds to the same F128.
// - exact: otherwise the same function in F128Big (stdlib/f128_big.tess, within about 2^-430 relative), rounded
//   once.
//
// The bands are measured, not proven. On 120000 random inputs per function (every exponent, subnormals, near 1,
// near powers of 2 and 10, near -1 and 0 for ln_1p, huge ones) the fast tier's worst relative error against mpmath
// was 2^-138.0 for all three, where wide_log's series is weakest: its first dropped term, 2 t^53 / 53 with
// t = (sqrt 2 - 1) / (sqrt 2 + 1), is 2^-139.5 absolute, against a result of ln sqrt 2 (x near sqrt 2 or 1/sqrt 2,
// ln_1p near sqrt 2 - 1). A band of 2^-133 leaves 5 bits. It sends about one random input in a million to the
// exact tier (68 of 60 million), and ln_1p(x) for x near ±2^-112, where x - x^2/2 lies next to a midpoint
// (tests/f128_logs.tess has both kinds).
//
// Exact cases come first, because a result that is exactly an F128 (or a midpoint between two) can sit on the
// band's edge forever and the exact tier's tiny error could round a midpoint either way. There are only these:
//
// - log2 x is rational only at the powers of 2: x^q = 2^p with x rational forces x = 2^(p/q) with q dividing p.
//   Elsewhere it is irrational (transcendental, by Gelfond-Schneider), so never an F128 or a midpoint, which are
//   both rationals. log2(2^k) = k, subnormal powers included.
// - log10 x likewise is rational only at x = 10^k, as 10 is not a perfect power. 10^k is an F128 for 0 <= k <= 48
//   (5^k < 2^113); 10^-k has a factor 5^-k and is never one. log10(10^k) = k.
// - ln(1 + x) for a rational 1 + x other than 1 is transcendental (Lindemann: e^r is transcendental for a nonzero
//   algebraic r), so only ln_1p(±0) = ±0 is exact.

module Standard::Core

preset F128_LN_1P_BAND: S64 = 133
preset F128_LOG2_BAND:  S64 = 133
preset F128_LOG10_BAND: S64 = 133

choice LogKind: U8
    Ln1p
    Log2
    Log10

// -- fast tier: F128Extended ---------------------------------------------------

/// The function of x in F128Extended, for a finite x in its domain that is no exact case.
routine wide_log_kind(x: F128, kind: LogKind) -> F128Extended
    block entry():
        w : F128Extended = wide_from_f128(x)
        when kind:
            LogKind.Ln1p  -> return(wide_ln_1p(w))
            LogKind.Log2  -> return(wide_log(w).mul(wide_const(1)))
            LogKind.Log10 -> return(wide_log(w).mul(wide_const(3)))

routine f128_log_band(kind: LogKind) -> S64
    block entry():
        when kind:
            LogKind.Ln1p  -> return(F128_LN_1P_BAND)
            LogKind.Log2  -> return(F128_LOG2_BAND)
            LogKind.Log10 -> return(F128_LOG10_BAND)

// -- exact tier: F128Big -------------------------------------------------------

/// The function of x in F128Big, rounded once.
routine f128_log_exact(x: F128, kind: LogKind) -> F128
    block entry():
        b : F128Big = big_from_f128(x)
        when kind:
            LogKind.Ln1p  -> return(big_ln_1p(b).to<F128>())
            LogKind.Log2  -> log2_exact(b)
            LogKind.Log10 -> log10_exact(b)

    block log2_exact(b: F128Big):
        log2 : F128Big = big_ln(b).div(big_ln2())
        return(log2.to<F128>())

    block log10_exact(b: F128Big):
        log10 : F128Big = big_ln(b).div(big_ln(big_from_s64(10)))
        return(log10.to<F128>())

// -- the two tiers -------------------------------------------------------------

/// The function of a finite x in its domain that is no exact case. exact skips the fast tier (the tests use it
/// to check the exact tier on its own).
routine f128_log_general(x: F128, kind: LogKind, exact: Bool) -> F128
    block entry():
        branch exact
            ? slow()
            : fast()

    block fast():
        w       : F128Extended = wide_log_kind(x, kind)
        rounded : WideRounding = wide_round_within(w, f128_log_band(kind))
        branch rounded.ok
            ? return(rounded.value)
            : slow()

    block slow():
        r : F128 = f128_log_exact(x, kind)
        return(r)

// -- exact cases ---------------------------------------------------------------

/// k when x = 10^k for 0 <= k <= 48 (x positive and finite), else -1.
routine f128_power_of_ten(x: F128) -> S64
    block entry():
        one      : F128 = f128_of(F128_ONE)
        integer  : Bool = x.trunc().eq(x)
        at_least : Bool = x.ge(one)
        branch integer.bitand(at_least)
            ? search(0, one)
            : return(-1)

    // p = 10^k, exact while k <= 48
    block search(k: S64, p: F128):
        found : Bool = p.eq(x)
        past  : Bool = p.gt(x).bitor(k.ge(48))
        when:
            found -> return(k)
            past  -> return(-1)
            else  -> search(k.add(1), p.mul(f128_of(0x40024000000000000000000000000000)))  // 10

// -- ln_1p, log2, log10 --------------------------------------------------------

/// ln(1 + self), correctly rounded: ±0 at ±0, -inf at -1, NaN below -1, +inf at +inf.
routine F128.ln_1p(self: Self) -> Self
    block entry():
        r : Self = f128_ln_1p(self, false)
        return(r)

/// log2 self, correctly rounded, and exactly k at 2^k: NaN for self < 0, -inf at ±0, +inf at +inf.
routine F128.log2(self: Self) -> Self
    block entry():
        r : Self = f128_log2(self, false)
        return(r)

/// log10 self, correctly rounded, and exactly k at 10^k: NaN for self < 0, -inf at ±0, +inf at +inf.
routine F128.log10(self: Self) -> Self
    block entry():
        r : Self = f128_log10(self, false)
        return(r)

routine f128_ln_1p(x: F128, exact: Bool) -> F128
    block entry():
        bits      : U128 = x.bits()
        nan       : Bool = f128_is_nan_bits(bits)
        zero      : Bool = f128_is_zero_bits(bits)
        minus_one : F128 = f128_of(0xBFFF0000000000000000000000000000)
        pole      : Bool = x.eq(minus_one)
        below     : Bool = x.lt(minus_one)
        inf       : Bool = x.eq(F128.INFINITY)
        when:
            nan   -> return(f128_of(f128_quiet(bits)))
            zero  -> return(x)
            pole  -> return(F128.NEG_INFINITY)
            below -> return(F128.NAN)
            inf   -> return(x)
            else  -> general()

    block general():
        r : F128 = f128_log_general(x, LogKind.Ln1p, exact)
        return(r)

/// The special cases log2 and log10 share: NaN in, NaN for x < 0, -inf at ±0, +inf at +inf. Absent for a finite
/// positive x.
routine f128_log_special(x: F128) -> Option<F128>
    block entry():
        bits     : U128 = x.bits()
        nan      : Bool = f128_is_nan_bits(bits)
        zero     : Bool = f128_is_zero_bits(bits)
        negative : Bool = f128_is_negative_bits(bits)
        inf      : Bool = x.is_infinite()
        when:
            nan      -> return(.Present(f128_of(f128_quiet(bits))))
            zero     -> return(.Present(F128.NEG_INFINITY))
            negative -> return(.Present(F128.NAN))
            inf      -> return(.Present(x))
            else     -> return(.Absent)

routine f128_log2(x: F128, exact: Bool) -> F128
    block entry():
        special : Option<F128> = f128_log_special(x)
        when special:
            .Present(v) -> return(v)
            .Absent     -> finite()

    // 2^k has the bare implicit bit in its unpacked significand, subnormals included
    block finite():
        p     : F128Parts = f128_unpack(x.bits())
        power : Bool      = p.sig.eq(F128_IMPLICIT)
        branch power
            ? return(p.exponent.to<F128>())
            : continue
        r : F128 = f128_log_general(x, LogKind.Log2, exact)
        return(r)

routine f128_log10(x: F128, exact: Bool) -> F128
    block entry():
        special : Option<F128> = f128_log_special(x)
        when special:
            .Present(v) -> return(v)
            .Absent     -> finite()

    block finite():
        k     : S64  = f128_power_of_ten(x)
        power : Bool = k.ge(0)
        branch power
            ? return(k.to<F128>())
            : continue
        r : F128 = f128_log_general(x, LogKind.Log10, exact)
        return(r)
