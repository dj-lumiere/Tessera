    0x9C7CD106D23F3768, 0x8218AF4373FC25EB, 0xDE4357A774D13D5C, 0x822F3C7AB205C89A,
    0x7354F57A2D982491, 0x8245CD9AB2CEC048, 0x336D3FDDC28165AD, 0x825C62A423D13F0C,
    0x3793AA0D08C818FB, 0x8272FB97B2A5894C, 0x517C473948AF9A0C, 0x828998760D01FAF3,
    0x6A3B68FCC424FF9F, 0x82A0393FE0BB0CA8, 0xC87433776C8B975C, 0x82B6DDF5DBC35906
]

; Fast path: 2^(j/32768), j = 0..31, as (low, high) word pairs.
const CM_EXP_R2: Array<I64, 64> = [
    0x0000000000000000, 0x8000000000000000, 0xAA22BEACCA949013, 0x8000B17292F702A3,
    0xE84C2E1A463473DA, 0x800162E61BED4A48, 0xE9B3D4C106428682, 0x8002145A9AE42BF6,
    0xB6566A58C048BE1F, 0x8002C5D00FDCFCB6, 0x2EF8674028829792, 0x800377467AD91193,
    0x0D2893E85AFFCA64, 0x800428BDDBD9BF99, 0xE3429843D1643041, 0x8004DA3632E05BD6,
    0x1C718B38E549CB93, 0x80058BAF7FEE3B5D, 0xFCB28217DF49D908, 0x80063D29C304B33D,
    0xA0D7201492B1D78A, 0x8006EEA4FC25188D, 0xFE8825C385E97278, 0x8007A0212B50C061,
    0xE448009AA78E39CD, 0x8008519E5088FFD2, 0xF9755A75904A13F7, 0x8009031C6BCF2BF9,
    0xBE4DA91D51695528, 0x8009B49B7D2499F2, 0x8BEFBDD3D03567F0, 0x800A661B848A9EDA,
    0x945E54E2AE18F2F0, 0x800B179C82028FD0, 0xE282A52DBD92678A, 0x800BC91E758DC1F5,
    0x5A2EEFC903F9E56B, 0x800C7AA15F2D8A6D, 0xB8210F92481F5ED7, 0x800D2C253EE33E5B,
    0x920508CE2DC5E9B3, 0x800DDDAA14B032E7, 0x567798C8DE012934, 0x800E8F2FE095BD39,
    0x4D08C57A3C79BC3E, 0x800F40B6A295327B, 0x963E6D2DA99D9C76, 0x800FF23E5AAFE7D9,
    0x2B96D62D51C15A07, 0x8010A3C708E73282, 0xDF8B3E7109372044, 0x80115550AD3C67A4,
    0x5D926B50B5606F22, 0x801206DB47B0DC73, 0x2A23393A42BF75CE, 0x8012B866D845E621,
    0xA2B72B6B280CFA61, 0x801369F35EFCD9E3, 0xFDCCFBAD7657BAFD, 0x80141B80DBD70CF1,
    0x4AEB2A187632347D, 0x8014CD0F4ED5D485, 0x72A28CD4D1F3BAE9, 0x80157E9EB7FA85D8
]

; Fast path: 2^(j/1048576), j = 0..31, as (low, high) word pairs.
const CM_EXP_R3: Array<I64, 64> = [
    0x0000000000000000, 0x8000000000000000, 0xECFC487503488BB2, 0x8000058B90DE7E4C,
    0x8307016C1CD4E8B7, 0x80000B1721FA7C18, 0x6C292B5FBF0C0AB5, 0x800010A2B353F965,
    0x526BE456600BDBE5, 0x8000162E44EAF636, 0xDFD867E27AF0ECB1, 0x80001BB9D6BF728D,
    0xBE780F22911E236A, 0x8000214568D16E6E, 0x985450C12B846C01, 0x800026D0FB20E9DB,
    0x1776C0F4DBEA67D6, 0x80002C5C8DADE4D7, 0xE5E911803E341D94, 0x800031E820785F63,
    0xADB511B1F9AAA919, 0x80003773B3805984, 0x18E4AE64C243EB6D, 0x80003CFF46C5D33C,
    0xD181F1FF59EA3AC5, 0x8000428ADA48CC8C, 0x8197047491C4129C, 0x800048166E094579,
    0xD32E2B434B7BC3D3, 0x80004DA202073E04, 0x7051C9767A8724DB, 0x8000532D9642B631,
    0x030C5FA5256F41FE, 0x800058B92ABBAE02, 0x35688BF267180DA2, 0x80005E44BF722579,
    0xB1710A0D700810A8, 0x800063D054661C99, 0x2130B33187B01AD5, 0x8000695BE9979366,
    0x2EB27E260DB2F346, 0x80006EE77F0689E1, 0x84017F3E7B2D08FA, 0x8000747314B3000D,
    0xCB28E85A63FC235F, 0x800079FEAA9CF5ED, 0xAE3408E5780712FB, 0x80007F8A40C46B84,
    0xD72E4DD784856215, 0x80008515D72960D4, 0xF02341B475470578, 0x80008AA16DCBD5E0,
    0xA31E8C8C55FC0D3B, 0x8000902D04ABCAAB, 0x9A2BF3FB537C55A0, 0x800095B89BC93F37,
    0x7F575B29BD0F37F7, 0x80009B4433243387, 0xFCACC2CC05B33B9C, 0x8000A0CFCABCA79D,
    0xBC384922C565C6F3, 0x8000A65B62929B7D, 0x680629FABA6AD083, 0x8000ABE6FAA60F29
]

; Fast path: polynomial coefficients as (low, high) word pairs.
const CM_EXP_C2: Array<I64, 12> = [
    0xFFFFFFFFFFFFFFFF, 0x7FFFFFFFFFFFFFFF, 0x7BCD5E4F1D9CC01F, 0x0000058B90BFBE8E,
    0xFF82C58EA86F16B0, 0x00000000001EBFBD, 0x71AC235C1282FE2C, 0x0000000000000000,
    0x0000013B2AB6FBA4, 0x0000000000000000, 0x000000000002BB10, 0x0000000000000000
]

; Fixed-point log2(10) = ln(10)/ln(2), 7 words, least significant first.
const CM_EXP_ILN102: Array<I64, 7> = [
    0x1435EE480565CA55, 0x3E24BEAB63AD0BD6, 0x06650FDE9DD51F3A, 0x91B6AC8082E7859D,
    0xD96C55FE37B3AD4E, 0x492BF6FF4DAFDB4C, 0xD49A784BCD1B8AFE
]

; -- words -----------------------------------------------------------------------

; Three little-endian words.
struct CmExpWords3
    w0: I64
    w1: I64
    w2: I64

; A fallback path's result: the unbiased exponent and the 2^x significand, in the
; same form the fast path produces.
struct CmExpScaled
    exp: I64
    sig: I128

; A 128-bit value from its high and low words.
routine cm_exp_join(%hi: I64, %lo: I64) -> I128
    block entry():
        %r: I128 = %hi.to_u128().shl(64).bitor(%lo.to_u128())
        return(%r)

; The high word of a 128-bit value.
routine cm_exp_hi(%u: I128) -> I64
    block entry():
        %r: I64 = %u.lshr(64).to_i64()
        return(%r)

; The full 128-bit product of two words.
routine cm_exp_mul(%a: I64, %b: I64) -> I128
    block entry():
        %r: I128 = %a.to_u128().mul(%b.to_u128())
        return(%r)

; The high word of the product of two words.
routine cm_exp_mulhi(%a: I64, %b: I64) -> I64
    block entry():
        %r: I64 = cm_exp_mul(%a, %b).lshr(64).to_i64()
        return(%r)

; The approximate high half of a 128 × 128-bit product: the a0 × b0 word and the
; carries out of the low words are dropped.
routine cm_exp_mulhi128(%a: I128, %b: I128) -> I128
    block entry():
        %a0:    I64  = %a.to_i64()
        %a1:    I64  = cm_exp_hi(%a)
        %b0:    I64  = %b.to_i64()
        %b1:    I64  = cm_exp_hi(%b)
        %cross1: I64 = cm_exp_mulhi(%a1, %b0)
        %cross2: I64 = cm_exp_mulhi(%a0, %b1)
        %r:     I128 = cm_exp_mul(%a1, %b1).add(%cross1.to_u128()).add(%cross2.to_u128())
        return(%r)

; a × b / 2^64 + c for a word a and 128-bit b and c, the low product word truncated.
routine cm_exp_mul_add_hi(%a: I64, %b: I128, %c: I128) -> I128
    block entry():
        %low:  I64  = cm_exp_mulhi(%a, %b.to_i64())
        %high: I128 = cm_exp_mul(%a, cm_exp_hi(%b))
        %r:    I128 = %high.add(%c.add(%low.to_u128()))
        return(%r)

; The low word of (hi, lo) >> n for 0 <= n < 64: a funnel shift.
routine cm_exp_funnel(%hi: I64, %lo: I64, %n: I64) -> I64
    block entry():
        %r: I64 = cm_exp_join(%hi, %lo).lshr(%n.to_i128()).to_i64()
        return(%r)

; The words from position 2 up of the product of the 3-word a and the 2-word b, with
; the a0 × b0 product and the low words of a0 × b1 and a1 × b0 dropped.
routine cm_exp_mul3x2_high(%a0: I64, %a1: I64, %a2: I64, %b: I128) -> CmExpWords3
    block entry():
        %b0:   I64  = %b.to_i64()
        %b1:   I64  = cm_exp_hi(%b)
        %p01:  I128 = cm_exp_mul(%a0, %b1)
        %p10:  I128 = cm_exp_mul(%a1, %b0)
        %p11:  I128 = cm_exp_mul(%a1, %b1)
        %p20:  I128 = cm_exp_mul(%a2, %b0)
        %p21:  I128 = cm_exp_mul(%a2, %b1)
        ; column sums: word 2 of the product, then word 3 with word 2's carry
        %low2:  I128 = %p11.bitand(CM_EXP_LOW).add(%p20.bitand(CM_EXP_LOW))
        %col2:  I128 = %low2.add(%p01.lshr(64)).add(%p10.lshr(64))
        %high3: I128 = %p11.lshr(64).add(%p20.lshr(64)).add(%p21.bitand(CM_EXP_LOW))
        %col3:  I128 = %col2.lshr(64).add(%high3)
        %top:  I64  = cm_exp_hi(%col3).add(cm_exp_hi(%p21))
        %r: CmExpWords3 = CmExpWords3 { w0: %col2.to_i64(), w1: %col3.to_i64(), w2: %top }
        return(%r)

; Every word of w XORed with mask: a one's complement when mask is all ones.
routine cm_exp_flip3(%w: CmExpWords3, %mask: I64) -> CmExpWords3
    block entry():
        %r: CmExpWords3 = CmExpWords3 {
            w0: %w.w0.bitxor(%mask), w1: %w.w1.bitxor(%mask), w2: %w.w2.bitxor(%mask)
        }
        return(%r)

; Arithmetic right shift of the 3-word value by n bits (n < 192).
routine cm_exp_ashr3(%w: CmExpWords3, %n: I64) -> CmExpWords3
    block entry():
        %sign:  I64 = %w.w2.ashr(63)
        %bits:  I64 = %n.bitand(63)
        %words: I64 = %n.lshr(6)
        switch %words:
            0 -> shift_bits(%w.w0, %w.w1, %w.w2, %bits)
            1 -> shift_bits(%w.w1, %w.w2, %sign, %bits)
            _ -> shift_bits(%w.w2, %sign, %sign, %bits)

    block shift_bits(%s0: I64, %s1: I64, %s2: I64, %bits: I64):
        %r0: I64 = cm_exp_funnel(%s1, %s0, %bits)
        %r1: I64 = cm_exp_funnel(%s2, %s1, %bits)
        %r:  CmExpWords3 = CmExpWords3 { w0: %r0, w1: %r1, w2: %s2.ashr(%bits) }
        return(%r)

; -- fast path -------------------------------------------------------------------

; Entry i of a table of (low, high) word pairs.
routine cm_exp_pair(#table: Ptr<I64>, %i: I64) -> I128
    block entry():
        %low_index:  I64 = %i.shl(1)
        %high_index: I64 = %low_index.add(1)
        %low:  I64 := #table[%low_index]
        %high: I64 := #table[%high_index]
        %r: I128 = cm_exp_join(%high, %low)
        return(%r)

; 2^x on 128 bits for the reduced argument fs, its leading bit at 123 (for x in
; [0, 1)): 2^(i0/2^5 + i1/2^10 + i2/2^15 + i3/2^20) from four tables, 2^(w1 × 2^-84)
; by a degree-5 polynomial, and the lowest word as a first-order correction.
routine cm_exp_fast(%fs: CmExpWords3) -> I128
    block entry():
        %z:   I64 = %fs.w1
        %c0:  I64 := CM_EXP_C2[0]
        %c1:  I64 := CM_EXP_C2[1]
        %c2:  I64 := CM_EXP_C2[2]
        %c3:  I64 := CM_EXP_C2[3]
        %c4:  I64 := CM_EXP_C2[4]
        %c5:  I64 := CM_EXP_C2[5]
        %c6:  I64 := CM_EXP_C2[6]
        %c8:  I64 := CM_EXP_C2[8]
        %c10: I64 := CM_EXP_C2[10]
        ; the top terms in single words, the rest by 128-bit Horner steps
        %t4:   I64  = %c8.add(cm_exp_mulhi(%z, %c10))
        %t3:   I64  = %c6.add(cm_exp_mulhi(%z, %t4))
        %t2:   I128 = cm_exp_join(%c5, %c4).add(cm_exp_mulhi(%z, %t3).to_u128())
        %t1:   I128 = cm_exp_mul_add_hi(%z, %t2, cm_exp_join(%c3, %c2))
        %poly: I128 = cm_exp_mul_add_hi(%z, %t1, cm_exp_join(%c1, %c0))
        %i0: I64 = %fs.w2.lshr(15).bitand(31)
        %i1: I64 = %fs.w2.lshr(10).bitand(31)
        %i2: I64 = %fs.w2.lshr(5).bitand(31)
        %i3: I64 = %fs.w2.bitand(31)
        %r0: I128 = cm_exp_pair(CM_EXP_R0.as_ptr(), %i0)
        %r1: I128 = cm_exp_pair(CM_EXP_R1.as_ptr(), %i1)
        %r2: I128 = cm_exp_pair(CM_EXP_R2.as_ptr(), %i2)
        %r3: I128 = cm_exp_pair(CM_EXP_R3.as_ptr(), %i3)
        %table: I128 = cm_exp_mulhi128(cm_exp_mulhi128(%r0, %r1), cm_exp_mulhi128(%r2, %r3))
        ; the lowest word of the argument, times ln(2)
        %low_ln2:    I64  = cm_exp_mulhi(0xB17217F7D1CF79AC, %fs.w0)
        %correction: I128 = cm_exp_mul(cm_exp_hi(%table), %low_ln2).lshr(84)
        %r: I128 = cm_exp_mulhi128(%poly, %table.add(%correction))
        return(%r)

; Finishes exp, exp2, or exp10 from the reduced argument fs: a two's-complement
; fixed-point x × log2(base) whose integer part sits above the 20 low bits of fs.w2.
; x is the input's bits and kind its function, for the fallback paths.
routine cm_exp_finish(%fs: CmExpWords3, %x: I128, %kind: I64) -> F128
    block entry():
        %el:     I64  = %fs.w2.ashr(20)
        %sig:    I128 = cm_exp_fast(%fs)
        %normal: Bool = %el.sge(-16382)
        branch %normal ? normal(%el, %sig, %x, %kind) : subnormal(%el, %sig, %x, %kind)

    ; fall back when the 11 dropped bits are too close to a rounding boundary
    block normal(%el: I64, %sig: I128, %x: I128, %kind: I64):
        %dropped: I64  = %sig.to_i64().add(1030).bitand(0x7FF)
        %close:   Bool = %dropped.ule(6)
        branch %close ? normal_retry(%x, %kind) : normal_round(%el, %sig)

    block normal_retry(%x: I128, %kind: I64):
        %better: CmExpScaled = cm_exp_accurate(%x, %kind)
        jump normal_round(%better.exp, %better.sig)

    ; the leading bit (at 112 after the shift) carries into the exponent field
    block normal_round(%el: I64, %sig: I128):
        %round_bit: I128 = %sig.lshr(10).bitand(1)
        %field:     I128 = %el.add(16382).to_i128().shl(112)
        %bits:      I128 = %sig.lshr(11).add(%field).add(%round_bit)
        %r: F128 = F128.from_bits(%bits)
        return(%r)

    block subnormal(%el: I64, %sig: I128, %x: I128, %kind: I64):
        %some: Bool = %el.sgt(-16499)
        branch %some ? subnormal_check(%el, %sig, %x, %kind) : return(CM_EXP_ZERO)

    block subnormal_check(%el: I64, %sig: I128, %x: I128, %kind: I64):
        %shift: I128 = -16372.sub(%el).to_i128()
        %half:  I128 = 1.shl(%shift)
        %mask:  I128 = 2.shl(%shift).sub(1)
        %close: Bool = %sig.add(%half).add(6).bitand(%mask).ule(6)
        branch %close ? subnormal_retry(%x, %kind) : subnormal_round(%el, %sig)

    block subnormal_retry(%x: I128, %kind: I64):
        %better: CmExpScaled = cm_exp_accurate(%x, %kind)
        jump subnormal_round(%better.exp, %better.sig)

    ; the accurate path may land one binade lower than the fast one, so the shift
    ; can reach 127; the result then rounds from its top bit alone (RF shifted by 128)
    block subnormal_round(%el: I64, %sig: I128):
        %shift:     I128 = -16372.sub(%el).to_i128()
        %vanishes:  Bool = %shift.sgt(127)
        branch %vanishes ? return(CM_EXP_ZERO) : round(%sig, %shift)

    block round(%sig: I128, %shift: I128):
        %round_bit: I128 = %sig.lshr(%shift).bitand(1)
        %bits:      I128 = %sig.lshr(%shift).lshr(1).add(%round_bit)
        %r: F128 = F128.from_bits(%bits)
        return(%r)

; -- multi-word arithmetic -------------------------------------------------------

; Adds word to slot of the (lo, hi) column sums, when 0 <= slot < count.
routine cm_exp_add_column(#lo: Ptr<I64>, #hi: Ptr<I64>, %slot: I64, %count: I64, %word: I64) -> Void
    block entry():
        %in_range: Bool = %slot.sge(0).bitand(%slot.slt(%count))
        branch %in_range ? add(%slot) : return()

    block add(%slot: I64):
        %low:  I64 := #lo[%slot]
        %high: I64 := #hi[%slot]
        %sum:  I128 = %low.to_u128().add(%word.to_u128())
        #lo[%slot] = %sum.to_i64()
        #hi[%slot] = %high.add(cm_exp_hi(%sum))
        return()

; Words out[0 .. count-1] = the words p .. p+count-1 of the product of the na-word a
; and the nb-word b, keeping every partial-product word at a position >= p (lower
; words and their carries are dropped). out may alias a or b.
routine cm_exp_mul_words(#out: Ptr<I64>, #a: Ptr<I64>, %na: I64, #b: Ptr<I64>, %nb: I64, %p: I64, %count: I64) -> Void
    block entry():
        #lo_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #hi_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #lo: Ptr<I64> = #lo_words.cast<I64>()
        #hi: Ptr<I64> = #hi_words.cast<I64>()
        zero<I64>(#lo, 8)
        zero<I64>(#hi, 8)
        jump row(0, #lo, #hi)

    block row(%i: I64, #lo: Ptr<I64>, #hi: Ptr<I64>):
        %done: Bool = %i.sge(%na)
        branch %done ? carry(0, 0, #lo, #hi) : column(%i, 0, #lo, #hi)

    block column(%i: I64, %j: I64, #lo: Ptr<I64>, #hi: Ptr<I64>):
        %row_done: Bool = %j.sge(%nb)
        branch %row_done ? row(%i.add(1), #lo, #hi) : product(%i, %j, #lo, #hi)

    block product(%i: I64, %j: I64, #lo: Ptr<I64>, #hi: Ptr<I64>):
        %ai:   I64  := #a[%i]
        %bj:   I64  := #b[%j]
        %prod: I128 = cm_exp_mul(%ai, %bj)
        %slot: I64  = %i.add(%j).sub(%p)
        cm_exp_add_column(#lo, #hi, %slot, %count, %prod.to_i64())
        cm_exp_add_column(#lo, #hi, %slot.add(1), %count, cm_exp_hi(%prod))
        jump column(%i, %j.add(1), #lo, #hi)

    block carry(%q: I64, %carry: I128, #lo: Ptr<I64>, #hi: Ptr<I64>):
        %done: Bool = %q.sge(%count)
        branch %done ? return() : settle(%q, %carry, #lo, #hi)

    block settle(%q: I64, %carry: I128, #lo: Ptr<I64>, #hi: Ptr<I64>):
        %low:  I64  := #lo[%q]
        %high: I64  := #hi[%q]
        %sum:  I128 = %low.to_u128().add(%carry)
        #out[%q] = %sum.to_i64()
        jump carry(%q.add(1), %sum.lshr(64).add(%high.to_u128()), #lo, #hi)

; out = floor(a × b / 2^64) + c modulo 2^(64n), for a word a and n-word b and c.
; out may alias b or c.
routine cm_exp_mul_add_words(#out: Ptr<I64>, %a: I64, #b: Ptr<I64>, #c: Ptr<I64>, %n: I64) -> Void
    block entry():
        %b0: I64 := #b[0]
        jump step(0, cm_exp_mul(%a, %b0), 0)

    block step(%k: I64, %prev: I128, %carry: I128):
        %done: Bool = %k.sge(%n)
        branch %done ? return() : add(%k, %prev, %carry)

    block add(%k: I64, %prev: I128, %carry: I128):
        %next_k:   I64  = %k.add(1)
        %has_next: Bool = %next_k.slt(%n)
        %index:    I64  = %has_next ? %next_k : %k
        %bn:       I64  := #b[%index]
        %product:  I128 = cm_exp_mul(%a, %bn)
        %next:     I128 = %has_next ? %product : 0
        %ck:       I64  := #c[%k]
        %sum: I128 = %prev.lshr(64).add(%next.bitand(CM_EXP_LOW)).add(%ck.to_u128()).add(%carry)
        #out[%k] = %sum.to_i64()
        jump step(%next_k, %next, %sum.lshr(64))

; dst += src on n words, the carry out of the top dropped.
routine cm_exp_add_words(#dst: Ptr<I64>, #src: Ptr<I64>, %n: I64) -> Void
    block entry():
        jump step(0, 0)

    block step(%k: I64, %carry: I128):
        %done: Bool = %k.sge(%n)
        branch %done ? return() : add(%k, %carry)

    block add(%k: I64, %carry: I128):
        %d:   I64  := #dst[%k]
        %s:   I64  := #src[%k]
        %sum: I128 = %d.to_u128().add(%s.to_u128()).add(%carry)
        #dst[%k] = %sum.to_i64()
        jump step(%k.add(1), %sum.lshr(64))

; Word i of the len-word value at o, or the sign fill past its top.
routine cm_exp_word_or_sign(#o: Ptr<I64>, %i: I64, %len: I64, %sign: I64) -> I64
    block entry():
        %inside: Bool = %i.slt(%len)
        %index:  I64  = %inside ? %i : 0
        %word:   I64  := #o[%index]
        %r:      I64  = %inside ? %word : %sign
        return(%r)

; Arithmetic right shift of the len-word value at o by n bits, in place (n < 64 len).
routine cm_exp_ashr_words(#o: Ptr<I64>, %len: I64, %n: I64) -> Void
    block entry():
        %top_index: I64 = %len.sub(1)
        %top:  I64 := #o[%top_index]
        %sign: I64 = %top.ashr(63)
        jump step(0, %n.lshr(6), %n.bitand(63), %sign)

    ; word j comes from words j + words and the one above it; both are at or above
    ; j, so shifting in place from the bottom up never reads a word already written
    block step(%j: I64, %words: I64, %bits: I64, %sign: I64):
        %done: Bool = %j.sge(%len)
        branch %done ? return() : shift(%j, %words, %bits, %sign)

    block shift(%j: I64, %words: I64, %bits: I64, %sign: I64):
        %from: I64 = %j.add(%words)
        %low:  I64 = cm_exp_word_or_sign(#o, %from, %len, %sign)
        %high: I64 = cm_exp_word_or_sign(#o, %from.add(1), %len, %sign)
        #o[%j] = cm_exp_funnel(%high, %low, %bits)
        jump step(%j.add(1), %words, %bits, %sign)

; -- fallback paths --------------------------------------------------------------

; The fixed-point significand of x (with its implicit bit) times log2(base) in len
; words (4 or 7), before the exponent shift. The sign is applied as a one's
; complement after the product (exp, exp10) or a two's complement (exp2).
routine cm_exp_reduce_wide(#out: Ptr<I64>, %x: I128, %kind: I64, %len: I64) -> Void
    block entry():
        %sign_mask: I64  = cm_exp_hi(%x).ashr(63)
        %sig:       I128 = %x.bitand(F128_FRAC_MASK).bitor(F128_IMPLICIT)
        zero<I64>(#out, %len)
        %is_two: Bool = %kind.eq(CM_EXP_KIND_TWO)
        branch %is_two ? twos_complement(%sign_mask, %sig) : scale(%sign_mask, %sig)

    ; exp2: x itself is the multiple of log2(2)
    block twos_complement(%sign_mask: I64, %sig: I128):
        %mask2:  I128 = cm_exp_join(%sign_mask, %sign_mask)
        %signed: I128 = %sig.bitxor(%mask2).sub(%mask2)
        %low_index:  I64 = %len.sub(2)
        %high_index: I64 = %len.sub(1)
        #out[%low_index] = %signed.to_i64()
        #out[%high_index] = cm_exp_hi(%signed)
        return()

    block scale(%sign_mask: I64, %sig: I128):
        #sig_words: Ptr<Array<I64, 2>> = alloca<Array<I64, 2>>
        #sig_ptr:   Ptr<I64> = #sig_words.cast<I64>()
        #sig_ptr[0] = %sig.to_i64()
        #sig_ptr[1] = cm_exp_hi(%sig)
        %is_e:  Bool = %kind.eq(CM_EXP_KIND_E)
        #table: Ptr<I64> = %is_e ? CM_EXP_ILN2.as_ptr() : CM_EXP_ILN102.as_ptr()
        #coef:  Ptr<I64> = #table.offset(7.sub(%len).mul(8))
        cm_exp_mul_words(#out, #coef, %len, #sig_ptr, 2, 2, %len)
        jump flip(0, %sign_mask)

    block flip(%q: I64, %sign_mask: I64):
        %done: Bool = %q.sge(%len)
        branch %done ? return() : flip_word(%q, %sign_mask)

    block flip_word(%q: I64, %sign_mask: I64):
        %word: I64 := #out[%q]
        #out[%q] = %word.bitxor(%sign_mask)
        jump flip(%q.add(1), %sign_mask)

; The reduced argument of the wide paths: len words (4 or 7) of x × log2(base),
; shifted to put the integer part in the top word.
routine cm_exp_wide_argument(#out: Ptr<I64>, %x: I128, %kind: I64, %len: I64) -> Void
    block entry():
        cm_exp_reduce_wide(#out, %x, %kind, %len)
        %base:     I64 := CM_EXP_WIDE_SHIFT[%kind]
        %exponent: I64 = f128_exponent(%x)
        cm_exp_ashr_words(#out, %len, %base.sub(%exponent))
        return()

; Row i of a flattened table of width-word rows.
routine cm_exp_row(#table: Ptr<I64>, %width: I64, %i: I64) -> Ptr<I64>
    block entry():
        #r: Ptr<I64> = #table.offset(%i.mul(%width).mul(8))
        return(#r)

; poly = the polynomial of the given degree at the word y (as a fraction of 2^64),
; its coefficients the width-word rows of #coefs, by Horner steps.
routine cm_exp_horner(#poly: Ptr<I64>, %y: I64, #coefs: Ptr<I64>, %width: I64, %degree: I64) -> Void
    block entry():
        copy<I64>(#poly, cm_exp_row(#coefs, %width, %degree), %width)
        jump step(%degree)

    block step(%i: I64):
        %done: Bool = %i.eq(0)
        branch %done ? return() : fold(%i.sub(1))

    block fold(%i: I64):
        cm_exp_mul_add_words(#poly, %y, #poly, cm_exp_row(#coefs, %width, %i), %width)
        jump step(%i)

; The accurate path, on 3 words: returns the unbiased exponent and the 2^x
; significand for the finishing step, or defers to the superaccurate path when this
; result is still too close to a rounding boundary.
routine cm_exp_accurate(%x: I128, %kind: I64) -> CmExpScaled
    block entry():
        #arg_words:  Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #tab_words:  Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #poly_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #low_words:  Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #arg:  Ptr<I64> = #arg_words.cast<I64>()
        #tab:  Ptr<I64> = #tab_words.cast<I64>()
        #poly: Ptr<I64> = #poly_words.cast<I64>()
        #low:  Ptr<I64> = #low_words.cast<I64>()
        cm_exp_wide_argument(#arg, %x, %kind, 4)
        %el:  I64 := #arg[3]
        %top: I64 := #arg[2]
        %x0:  I64 := #arg[0]
        %x1:  I64 := #arg[1]
        ; 2^(j0/16) × 2^(j1/256) from the top 8 fraction bits
        %j0:   I64 = %top.lshr(60)
        %j1:   I64 = %top.lshr(56).bitand(15)
        #t0: Ptr<I64> = cm_exp_row(CM_EXP_TBL0.as_ptr(), 3, %j0)
        #t1: Ptr<I64> = cm_exp_row(CM_EXP_TBL1.as_ptr(), 3, %j1)
        cm_exp_mul_words(#tab, #t0, 3, #t1, 3, 3, 3)
        ; a degree-14 polynomial in the rest of the top fraction word
        #c3: Ptr<I64> = CM_EXP_C3.as_ptr()
        %frac: I64 = %top.bitand(0x00FFFFFFFFFFFFFF)
        cm_exp_horner(#poly, %frac, #c3, 3, 14)
        cm_exp_mul_words(#tab, #poly, 3, #tab, 3, 3, 3)
        ; the two low fraction words by a first-order correction
        %c3w2: I64 := #c3[2]
        %c3w4: I64 := #c3[4]
        %c3w5: I64 := #c3[5]
        %c3w8: I64 := #c3[8]
        %slope:  I128 = cm_exp_join(%c3w5, %c3w4).add(cm_exp_mulhi(%c3w8, %x1).to_u128())
        %linear: I128 = cm_exp_mulhi128(cm_exp_join(%x1, %x0), %slope)
        #low[0] = %linear.to_i64()
        #low[1] = cm_exp_hi(%linear)
        #low[2] = %c3w2
        cm_exp_mul_words(#poly, #tab, 3, #low, 3, 3, 3)
        %f0: I64 := #poly[0]
        %f1: I64 := #poly[1]
        %f2: I64 := #poly[2]
        %sig:    I128 = cm_exp_join(%f2.lshr(1), %f1.lshr(1).bitor(%f2.shl(63)))
        %close:  Bool = cm_exp_accurate_is_close(%el, %f0, %f1, %f2)
        %result: CmExpScaled = CmExpScaled { exp: %el, sig: %sig }
        branch %close ? retry() : return(%result)

    block retry():
        %r: CmExpScaled = cm_exp_superaccurate(%x, %kind)
        return(%r)

; Whether the accurate result (f2, f1, f0) is too close to a rounding boundary.
routine cm_exp_accurate_is_close(%el: I64, %f0: I64, %f1: I64, %f2: I64) -> Bool
    block entry():
        %normal: Bool = %el.sge(-16382)
        branch %normal ? normal() : subnormal()

    block normal():
        %low:     I128 = cm_exp_join(%f1, %f0)
        %dropped: I128 = %low.add(8).bitand(0x7FFFFFFFFFFFFFF)       ; 2^59 - 1
        %r: Bool = %dropped.ule(16)
        return(%r)

    ; the bits below the subnormal rounding position, s of them above the low word
    block subnormal():
        %s:       I64  = -16371.sub(%el)
        %low:     I128 = cm_exp_join(%f1, %f0).add(8)
        %wrapped: Bool = %low.ult(8)
        %g0: I64 = %low.to_i64()
        %g1: I64 = cm_exp_hi(%low)
        %g2: I64 = %f2.add(%wrapped.to_i64())
        %in_g1: Bool = %s.ult(64)
        %in_g2: Bool = %s.ult(128)
        select:
            %in_g1 -> mask_g1(%s, %g0, %g1)
            %in_g2 -> mask_g2(%s, %g0, %g1, %g2)
            _ -> decide(%g0, %g1, %g2)

    block mask_g1(%s: I64, %g0: I64, %g1: I64):
        %mask: I64 = 1.shl(%s).sub(1)
        jump decide(%g0, %g1.bitand(%mask), 0)

    block mask_g2(%s: I64, %g0: I64, %g1: I64, %g2: I64):
        %mask: I64 = 1.shl(%s.sub(64)).sub(1)
        jump decide(%g0, %g1, %g2.bitand(%mask))

    block decide(%g0: I64, %g1: I64, %g2: I64):
        %small: Bool = %g0.ule(16)
        %clear: Bool = %g1.bitor(%g2).eq(0)
        %r: Bool = %small.bitand(%clear)
        return(%r)

; The superaccurate path, on 6 words, used when the accurate result is too close to
; a rounding boundary: returns the unbiased exponent and the 2^x significand.
routine cm_exp_superaccurate(%x: I128, %kind: I64) -> CmExpScaled
    block entry():
        #arg_words:  Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #poly_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #next_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #low_words:  Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #arg:  Ptr<I64> = #arg_words.cast<I64>()
        #poly: Ptr<I64> = #poly_words.cast<I64>()
        #next: Ptr<I64> = #next_words.cast<I64>()
        #low:  Ptr<I64> = #low_words.cast<I64>()
        cm_exp_wide_argument(#arg, %x, %kind, 7)
        %el:  I64 := #arg[6]
        %top: I64 := #arg[5]
        ; a degree-36 polynomial in the top fraction word below its 4 table bits
        #c6: Ptr<I64> = CM_EXP_C6.as_ptr()
        %frac: I64 = %top.bitand(0x0FFFFFFFFFFFFFFF)
        cm_exp_horner(#poly, %frac, #c6, 6, 36)
        cm_exp_superaccurate_next(#next, #arg, #c6)
        cm_exp_superaccurate_low(#low, #arg, #c6)
        cm_exp_mul_words(#poly, #poly, 6, #next, 6, 6, 6)
        cm_exp_mul_words(#poly, #poly, 6, #low, 6, 6, 6)
        ; 2^(j/16) from the table bits
        #power: Ptr<I64> = cm_exp_row(CM_EXP_TBL6.as_ptr(), 6, %top.lshr(60))
        cm_exp_mul_words(#poly, #poly, 6, #power, 6, 6, 6)
        %f4: I64 := #poly[4]
        %f5: I64 := #poly[5]
        %sig: I128 = cm_exp_join(%f5.lshr(1), %f4.lshr(1).bitor(%f5.shl(63)))
        %r: CmExpScaled = CmExpScaled { exp: %el, sig: %sig }
        return(%r)

; 2^y for the next fraction word y = arg[4]: the same series, each degree truncated
; to the words it can reach.
routine cm_exp_superaccurate_next(#out: Ptr<I64>, #arg: Ptr<I64>, #c6: Ptr<I64>) -> Void
    block entry():
        #acc_words:  Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #term_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #acc:  Ptr<I64> = #acc_words.cast<I64>()
        #term: Ptr<I64> = #term_words.cast<I64>()
        %y: I64 := #arg[4]
        zero<I64>(#acc, 8)
        jump degree(5, %y, #acc, #term)

    ; degree r keeps the words r .. 5 of its coefficient's row, from its word r up
    block degree(%r: I64, %y: I64, #acc: Ptr<I64>, #term: Ptr<I64>):
        %done: Bool = %r.eq(0)
        branch %done ? constant(%y, #acc) : add_degree(%r, %y, #acc, #term)

    block add_degree(%r: I64, %y: I64, #acc: Ptr<I64>, #term: Ptr<I64>):
        zero<I64>(#term, 8)
        #coef: Ptr<I64> = #c6.offset(%r.mul(7).mul(8))
        copy<I64>(#term, #coef, 6.sub(%r))
        cm_exp_mul_add_words(#acc, %y, #acc, #term, 6)
        jump degree(%r.sub(1), %y, #acc, #term)

    block constant(%y: I64, #acc: Ptr<I64>):
        cm_exp_mul_add_words(#out, %y, #acc, #c6, 6)
        return()

; 2^y for the four low fraction words y = arg[0..3], by a second-order correction:
; 1 + y (c1 + y c2), each product keeping its top words.
routine cm_exp_superaccurate_low(#out: Ptr<I64>, #arg: Ptr<I64>, #c6: Ptr<I64>) -> Void
    block entry():
        #y_words:    Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #prod_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #slope_words: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #y:     Ptr<I64> = #y_words.cast<I64>()
        #prod:  Ptr<I64> = #prod_words.cast<I64>()
        #slope: Ptr<I64> = #slope_words.cast<I64>()
        zero<I64>(#y, 8)
        copy<I64>(#y.offset(16), #arg, 4)
        cm_exp_mul_words(#prod, #y, 6, cm_exp_row(#c6, 6, 2), 6, 6, 6)
        zero<I64>(#slope, 8)
        copy<I64>(#slope, #prod.offset(16), 4)
        cm_exp_add_words(#slope, cm_exp_row(#c6, 6, 1), 6)
        cm_exp_mul_words(#prod, #y, 6, #slope, 6, 6, 6)
        copy<I64>(#out, #prod.offset(16), 4)
        copy<I64>(#out.offset(32), #c6.offset(32), 2)
        return()
