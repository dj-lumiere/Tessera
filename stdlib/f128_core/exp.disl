; Disl stdlib: the correctly rounded exponential e^x of F128
;
; x / ln(2) in 3-word fixed point, then the shared 2^x engine (exp_shared.disl).
; Round to nearest only: overflow gives +inf, underflow a correctly rounded
; subnormal or +0, NaN comes back quiet with its sign and payload.
;
; Ported from CORE-MATH, src/binary128/exp/expq.c via RazorForge's B128Exp.rf.
; Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
; MIT license: see LICENSE-CORE-MATH

; x >= 0x1.62e42fefa39ef35793c7673007e6p+13 overflows
const CM_EXP_E_OVERFLOW:  I128 = 0x400C62E42FEFA39EF35793C7673007E6
; x <= -0x1.654bb3b2c73ebb059fabb506ff34p+13 rounds to +0
const CM_EXP_E_UNDERFLOW: I128 = 0xC00C654BB3B2C73EBB059FABB506FF34

; e^x, correctly rounded.
routine f128_cm_exp(%x: F128) -> F128
    block entry():
        %u:      I128 = %x.bits
        %hi:     I64  = cm_exp_hi(%u)
        %mag_hi: I64  = %hi.bitand(0x7FFFFFFFFFFFFFFF)
        %tiny:   Bool = %mag_hi.ult(0x3F8D000000000000)       ; |x| < 2^-114: e^x rounds to 1
        %large:  Bool = %mag_hi.uge(0x400C62E42FEFA39E)
        select:
            %tiny -> return(CM_EXP_ONE)
            %large -> edge(%u)
            _ -> reduce(%u)

    ; NaN, infinities, and the overflow and underflow thresholds
    block edge(%u: I128):
        %is_nan:    Bool = f128_is_nan_bits(%u)
        %overflow:  Bool = %u.sge(0).bitand(%u.uge(CM_EXP_E_OVERFLOW))
        %underflow: Bool = %u.uge(CM_EXP_E_UNDERFLOW)
        %quiet:     F128 = F128.from_bits(%u.bitor(F128_QUIET_BIT))
        select:
            %is_nan -> return(%quiet)
            %overflow -> return(F128.INFINITY)
            %underflow -> return(CM_EXP_ZERO)
            _ -> reduce(%u)

    ; x / ln(2): the significand times 1/ln(2), one's-complemented for negative x
    block reduce(%u: I128):
        %hi:        I64  = cm_exp_hi(%u)
        %sign_mask: I64  = %hi.ashr(63)
        %sig:       I128 = %u.bitand(F128_FRAC_MASK).bitor(F128_IMPLICIT)
        %k4: I64 := CM_EXP_ILN2[4]
        %k5: I64 := CM_EXP_ILN2[5]
        %k6: I64 := CM_EXP_ILN2[6]
        %scaled:  CmExpWords3 = cm_exp_mul3x2_high(%k4, %k5, %k6, %sig)
        %shift:   I64 = 0x401A.sub(f128_exponent(%u))
        %reduced: CmExpWords3 = cm_exp_ashr3(cm_exp_flip3(%scaled, %sign_mask), %shift)
        %r: F128 = cm_exp_finish(%reduced, %u, CM_EXP_KIND_E)
        return(%r)
