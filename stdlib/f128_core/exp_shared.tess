        0x822F3C7AB205C89A, 0x7354F57A2D982491, 0x8245CD9AB2CEC048, 0x336D3FDDC28165AD,
        0x825C62A423D13F0C, 0x3793AA0D08C818FB, 0x8272FB97B2A5894C, 0x517C473948AF9A0C,
        0x828998760D01FAF3, 0x6A3B68FCC424FF9F, 0x82A0393FE0BB0CA8, 0xC87433776C8B975C,
        0x82B6DDF5DBC35906]

/// Fast path: 2^(j/32768), j = 0..31, as (low, high) word pairs.
