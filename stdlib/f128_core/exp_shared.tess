// Tessera stdlib: the shared engine of the correctly rounded F128 exp, exp2, and exp10
//
// The three functions differ only in how x becomes a fixed-point multiple of log2
// (times 1/ln(2), times 1, times log2(10)); this file finishes all of them. The fast
// path evaluates 2^x on 128-bit words from four 32-entry tables and a short
// polynomial. When its result lies too close to a rounding boundary, the accurate
// path redoes it on 3 words, and past that the superaccurate path on 6. Only round
// to nearest (ties to even) is kept.
//
// Ported from CORE-MATH, src/binary128/exp/expq.c, src/binary128/exp2/exp2q.c, and
// src/binary128/exp10/exp10q.c via RazorForge's B128ExpShared.rf.
// Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// Every word is an unsigned 64-bit limb (U64). Multi-word values are
// little-endian limb arrays behind a Ptr<U64>. The multi-word products keep every
// partial-product word at or above the first output word and propagate all carries,
// exactly like the original carry chains.

module Standard::Core

/// Which reduction a fallback path redoes: e^x, 2^x, or 10^x.
preset CM_EXP_KIND_E:   U64 = 0
preset CM_EXP_KIND_TWO: U64 = 1
preset CM_EXP_KIND_TEN: U64 = 2

preset CM_EXP_ONE:  F128 = F128 { bits: 0x3FFF0000000000000000000000000000 }
preset CM_EXP_ZERO: F128 = F128 { bits: 0 }
preset CM_EXP_LOW:  U128 = 0xFFFFFFFFFFFFFFFF      // the low word of a U128

/// The wide reductions' exponent shift is this minus x's biased exponent, by kind.
preset CM_EXP_WIDE_SHIFT: Array<S64, 3> = [0x402E, 0x402F, 0x402D]

// -- tables ----------------------------------------------------------------------

/// Fixed-point 1/ln(2), 7 words, least significant first.
preset CM_EXP_ILN2: Array<U64, 7> = [0xEA90B9E60C4A90A0, 0x24D92F75C16BE0B3, 0xDE1C43F755176CD6,
        0x8B25166CD1A13247, 0xEB577AA8DD695A58, 0xBE87FED0691D3E88, 0xB8AA3B295C17F0BB]

