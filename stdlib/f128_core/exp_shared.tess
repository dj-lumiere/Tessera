/// Fast path: polynomial coefficients as (low, high) word pairs.
preset CM_EXP_C2: Array<U64, 12> = [0xFFFFFFFFFFFFFFFF, 0x7FFFFFFFFFFFFFFF, 0x7BCD5E4F1D9CC01F,
        0x0000058B90BFBE8E, 0xFF82C58EA86F16B0, 0x00000000001EBFBD, 0x71AC235C1282FE2C,
        0x0000000000000000, 0x0000013B2AB6FBA4, 0x0000000000000000, 0x000000000002BB10,
        0x0000000000000000]

/// Fixed-point log2(10) = ln(10)/ln(2), 7 words, least significant first.
preset CM_EXP_ILN102: Array<U64, 7> = [0x1435EE480565CA55, 0x3E24BEAB63AD0BD6, 0x06650FDE9DD51F3A,
        0x91B6AC8082E7859D, 0xD96C55FE37B3AD4E, 0x492BF6FF4DAFDB4C, 0xD49A784BCD1B8AFE]

// -- words -----------------------------------------------------------------------

/// Three little-endian words.
record CmExpWords3
    w0 : U64
    w1 : U64
    w2 : U64

/// A fallback path's result: the unbiased exponent and the 2^x significand, in the
/// same form the fast path produces.
record CmExpScaled
    exp : S64
    sig : U128

/// A 128-bit value from its high and low words.
routine cm_exp_join(%hi: U64, %lo: U64) -> U128
    block entry():
        %r : U128 = %hi.to_u128().shl(64).bitor(%lo.to_u128())
        return(%r)

/// The high word of a 128-bit value.
routine cm_exp_hi(%u: U128) -> U64
    block entry():
        %r : S64 = %u.shr(64).to_s64_wrap()
        return(%r.to_u64_wrap())

/// The full 128-bit product of two words.
routine cm_exp_mul(%a: U64, %b: U64) -> U128
    block entry():
        %r : U128 = %a.to_u128().mul_wrap(%b.to_u128())
        return(%r)

/// The high word of the product of two words.
routine cm_exp_mulhi(%a: U64, %b: U64) -> U64
    block entry():
        %r : U64 = cm_exp_mul(%a, %b).shr(64).to_u64()
        return(%r)

/// The approximate high half of a 128 × 128-bit product: the a0 × b0 word and the
/// carries out of the low words are dropped.
routine cm_exp_mulhi128(%a: U128, %b: U128) -> U128
    block entry():
        %a0     : U64  = %a.to_u64_wrap()
        %a1     : U64  = cm_exp_hi(%a)
        %b0     : U64  = %b.to_u64_wrap()
        %b1     : U64  = cm_exp_hi(%b)
        %cross1 : U64  = cm_exp_mulhi(%a1, %b0)
        %cross2 : U64  = cm_exp_mulhi(%a0, %b1)
        %r      : U128 = cm_exp_mul(%a1,
                %b1).add_wrap(%cross1.to_u128()).add_wrap(%cross2.to_u128())
        return(%r)

/// a × b / 2^64 + c for a word a and 128-bit b and c, the low product word truncated.
routine cm_exp_mul_add_hi(%a: U64, %b: U128, %c: U128) -> U128
    block entry():
        %low  : U64  = cm_exp_mulhi(%a, %b.to_u64_wrap())
        %high : U128 = cm_exp_mul(%a, cm_exp_hi(%b))
        %r    : U128 = %high.add_wrap(%c.add_wrap(%low.to_u128()))
        return(%r)

/// The low word of (hi, lo) >> n for 0 <= n < 64: a funnel shift.
routine cm_exp_funnel(%hi: U64, %lo: U64, %n: S64) -> S64
    block entry():
        %r : S64 = cm_exp_join(%hi, %lo).shr(%n.to_u128()).to_s64_wrap()
        return(%r)

/// The words from position 2 up of the product of the 3-word a and the 2-word b, with
/// the a0 × b0 product and the low words of a0 × b1 and a1 × b0 dropped.
routine cm_exp_mul3x2_high(%a0: U64, %a1: U64, %a2: U64, %b: U128) -> CmExpWords3
    block entry():
        %b0  : U64  = %b.to_u64_wrap()
        %b1  : U64  = cm_exp_hi(%b)
        %p01 : U128 = cm_exp_mul(%a0, %b1)
        %p10 : U128 = cm_exp_mul(%a1, %b0)
        %p11 : U128 = cm_exp_mul(%a1, %b1)
        %p20 : U128 = cm_exp_mul(%a2, %b0)
        %p21 : U128 = cm_exp_mul(%a2, %b1)
        // column sums: word 2 of the product, then word 3 with word 2's carry
        %low2  : U128        = %p11.bitand(CM_EXP_LOW).add(%p20.bitand(CM_EXP_LOW))
        %col2  : U128        = %low2.add(%p01.shr(64)).add(%p10.shr(64))
        %high3 : U128        = %p11.shr(64).add(%p20.shr(64)).add(%p21.bitand(CM_EXP_LOW))
        %col3  : U128        = %col2.shr(64).add(%high3)
        %top   : U64         = cm_exp_hi(%col3).add_wrap(cm_exp_hi(%p21))
        %r     : CmExpWords3 = CmExpWords3 { w0: %col2.to_s64_wrap().to_u64_wrap(),
                w1: %col3.to_s64_wrap().to_u64_wrap(), w2: %top }
        return(%r)

/// Every word of w XORed with mask: a one's complement when mask is all ones.
routine cm_exp_flip3(%w: CmExpWords3, %mask: U64) -> CmExpWords3
    block entry():
        %r : CmExpWords3 = CmExpWords3 { w0: %w.w0.bitxor(%mask), w1: %w.w1.bitxor(%mask),
                w2: %w.w2.bitxor(%mask) }
        return(%r)

/// Arithmetic right shift of the 3-word value by n bits (n < 192).
routine cm_exp_ashr3(%w: CmExpWords3, %n: U64) -> CmExpWords3
    block entry():
        %sign  : S64 = S64.from_bits(%w.w2.bits()).shr(63)
        %bits  : U64 = %n.bitand(63)
        %words : U64 = %n.shr(6)
        when %words:
            0 -> shift_bits(%w.w0, %w.w1.to_s64_wrap(), %w.w2.to_s64_wrap(), %bits)
            1 -> shift_bits(%w.w1, %w.w2.to_s64_wrap(), %sign, %bits)
            _ -> shift_bits(%w.w2, %sign, %sign, %bits)

    block shift_bits(%s0: U64, %s1: S64, %s2: S64, %bits: U64):
        %r0 : S64         = cm_exp_funnel(%s1.to_u64_wrap(), %s0, %bits.to_s64())
        %r1 : S64         = cm_exp_funnel(%s2.to_u64_wrap(), %s1.to_u64_wrap(), %bits.to_s64())
        %r  : CmExpWords3 = CmExpWords3 { w0: %r0.to_u64_wrap(), w1: %r1.to_u64_wrap(),
                w2: %s2.shr(%bits.to_s64()).to_u64_wrap() }
        return(%r)

// -- fast path -------------------------------------------------------------------

/// Entry i of a table of (low, high) word pairs.
routine cm_exp_pair(#table: Ptr<U64>, %i: U64) -> U128
    block entry():
        %low_index  : U64  = %i.shl(1)
        %high_index : U64  = %low_index.add(1)
        %low        : U64  = #table[%low_index].load()
        %high       : U64  = #table[%high_index].load()
        %r          : U128 = cm_exp_join(%high, %low)
        return(%r)

/// 2^x on 128 bits for the reduced argument fs, its leading bit at 123 (for x in
/// [0, 1)): 2^(i0/2^5 + i1/2^10 + i2/2^15 + i3/2^20) from four tables, 2^(w1 × 2^-84)
/// by a degree-5 polynomial, and the lowest word as a first-order correction.
routine cm_exp_fast(%fs: CmExpWords3) -> U128
    block entry():
        %z   : U64 = %fs.w1
        %c0  : U64 = CM_EXP_C2.get(0)
        %c1  : U64 = CM_EXP_C2.get(1)
        %c2  : U64 = CM_EXP_C2.get(2)
        %c3  : U64 = CM_EXP_C2.get(3)
        %c4  : U64 = CM_EXP_C2.get(4)
        %c5  : U64 = CM_EXP_C2.get(5)
        %c6  : U64 = CM_EXP_C2.get(6)
        %c8  : U64 = CM_EXP_C2.get(8)
        %c10 : U64 = CM_EXP_C2.get(10)
        // the top terms in single words, the rest by 128-bit Horner steps
        %t4    : U64  = %c8.add_wrap(cm_exp_mulhi(%z, %c10))
        %t3    : U64  = %c6.add_wrap(cm_exp_mulhi(%z, %t4))
        %t2    : U128 = cm_exp_join(%c5, %c4).add(cm_exp_mulhi(%z, %t3).to_u128())
        %t1    : U128 = cm_exp_mul_add_hi(%z, %t2, cm_exp_join(%c3, %c2))
        %poly  : U128 = cm_exp_mul_add_hi(%z, %t1, cm_exp_join(%c1, %c0))
        %i0    : U64  = %fs.w2.shr(15).bitand(31)
        %i1    : U64  = %fs.w2.shr(10).bitand(31)
        %i2    : U64  = %fs.w2.shr(5).bitand(31)
        %i3    : U64  = %fs.w2.bitand(31)
        %r0    : U128 = cm_exp_pair(CM_EXP_R0.to_ptr(), %i0)
        %r1    : U128 = cm_exp_pair(CM_EXP_R1.to_ptr(), %i1)
        %r2    : U128 = cm_exp_pair(CM_EXP_R2.to_ptr(), %i2)
        %r3    : U128 = cm_exp_pair(CM_EXP_R3.to_ptr(), %i3)
        %table : U128 = cm_exp_mulhi128(cm_exp_mulhi128(%r0, %r1), cm_exp_mulhi128(%r2, %r3))
        // the lowest word of the argument, times ln(2)
        %low_ln2    : U64  = cm_exp_mulhi(0xB17217F7D1CF79AC, %fs.w0)
        %correction : U128 = cm_exp_mul(cm_exp_hi(%table), %low_ln2).shr(84)
        %r          : U128 = cm_exp_mulhi128(%poly, %table.add_wrap(%correction))
        return(%r)

/// Finishes exp, exp2, or exp10 from the reduced argument fs: a two's-complement
/// fixed-point x × log2(base) whose integer part sits above the 20 low bits of fs.w2.
/// x is the input's bits and kind its function, for the fallback paths.
routine cm_exp_finish(%fs: CmExpWords3, %x: U128, %kind: U64) -> F128
    block entry():
        %el     : S64  = S64.from_bits(%fs.w2.bits()).shr(20)
        %sig    : U128 = cm_exp_fast(%fs)
        %normal : Bool = %el.ge(-16382)
        branch %normal ? normal(%el, %sig, %x, %kind) : subnormal(%el, %sig, %x, %kind)

    // fall back when the 11 dropped bits are too close to a rounding boundary
    block normal(%el: S64, %sig: U128, %x: U128, %kind: U64):
        %dropped : U64  = %sig.to_u64_wrap().add_wrap(1030).bitand(0x7FF)
        %close   : Bool = %dropped.le(6)
        branch %close ? normal_retry(%x, %kind) : normal_round(%el, %sig)

    block normal_retry(%x: U128, %kind: U64):
        %better : CmExpScaled = cm_exp_accurate(%x, %kind)
        jump normal_round(%better.exp, %better.sig)

    // the leading bit (at 112 after the shift) carries into the exponent field
    block normal_round(%el: S64, %sig: U128):
        %round_bit : U128 = %sig.shr(10).bitand(1)
        %field     : U128 = %el.add(16382).to_u128().shl(112)
        %bits      : U128 = %sig.shr(11).add_wrap(%field).add_wrap(%round_bit)
        %r         : F128 = f128_of(%bits)
        return(%r)

    block subnormal(%el: S64, %sig: U128, %x: U128, %kind: U64):
        %some : Bool = %el.gt(-16499)
        branch %some ? continue : return(CM_EXP_ZERO)
        %shift : U128 = -16372.sub(%el).to_u128()
        %half  : U128 = 1.shl(%shift)
        %mask  : U128 = 2.shl(%shift).sub_wrap(1)
        %close : Bool = %sig.add_wrap(%half).add_wrap(6).bitand(%mask).le(6)
        branch %close ? subnormal_retry(%x, %kind) : subnormal_round(%el, %sig)

    block subnormal_retry(%x: U128, %kind: U64):
        %better : CmExpScaled = cm_exp_accurate(%x, %kind)
        jump subnormal_round(%better.exp, %better.sig)

    // the accurate path may land one binade lower than the fast one, so the shift
    // can reach 127; the result then rounds from its top bit alone (RF shifted by 128)
    block subnormal_round(%el: S64, %sig: U128):
        %shift    : S128 = -16372.sub(%el).to_s128()
        %vanishes : Bool = %shift.gt(127)
        branch %vanishes ? return(CM_EXP_ZERO) : continue
        %round_bit : U128 = %sig.shr(%shift.to_u128()).bitand(1)
        %bits      : U128 = %sig.shr(%shift.to_u128()).shr(1).add_wrap(%round_bit)
        %r         : F128 = f128_of(%bits)
        return(%r)

// -- multi-word arithmetic -------------------------------------------------------

/// Adds word to slot of the (lo, hi) column sums, when 0 <= slot < count.
routine cm_exp_add_column(#lo: Ptr<U64>, #hi: Ptr<U64>, %slot: S64, %count: S64, %word: U64) -> Void
    block entry():
        %in_range : Bool = %slot.in_range(0, %count)
        branch %in_range ? add(%slot.to_u64()) : return()

    block add(%slot: U64):
        %low  : U64  = #lo[%slot].load()
        %high : U64  = #hi[%slot].load()
        %sum  : U128 = %low.to_u128().add(%word.to_u128())
        #lo[%slot].store(%sum.to_u64_wrap())
        #hi[%slot].store(%high.add(cm_exp_hi(%sum)))
        return()

/// Words out[0 .. count-1] = the words p .. p+count-1 of the product of the na-word a
/// and the nb-word b, keeping every partial-product word at a position >= p (lower
/// words and their carries are dropped). out may alias a or b.
routine cm_exp_mul_words(#out: Ptr<U64>, #a: Ptr<U64>, %na: U64, #b: Ptr<U64>, %nb: U64, %p: U64,
        %count: S64) -> Void
    block entry():
        #lo_words : Ptr<Array<S64, 8>> = claim
        #hi_words : Ptr<Array<S64, 8>> = claim
        #lo       : Ptr<U64>           = #lo_words.cast<U64>()
        #hi       : Ptr<U64>           = #hi_words.cast<U64>()
        #lo.zeroinit(8)
        #hi.zeroinit(8)
        jump row(0, #lo, #hi)

    block row(%i: U64, #lo: Ptr<U64>, #hi: Ptr<U64>):
        %done : Bool = %i.ge(%na)
        branch %done ? carry(0, 0, #lo, #hi) : column(%i, 0, #lo, #hi)

    block column(%i: U64, %j: U64, #lo: Ptr<U64>, #hi: Ptr<U64>):
        %row_done : Bool = %j.ge(%nb)
        branch %row_done ? row(%i.add(1), #lo, #hi) : product(%i, %j, #lo, #hi)

    block product(%i: U64, %j: U64, #lo: Ptr<U64>, #hi: Ptr<U64>):
        %ai   : U64  = #a[%i].load()
        %bj   : U64  = #b[%j].load()
        %prod : U128 = cm_exp_mul(%ai, %bj)
        %slot : U64  = %i.add(%j).sub_wrap(%p)
        cm_exp_add_column(#lo, #hi, %slot.to_s64_wrap(), %count, %prod.to_u64_wrap())
        cm_exp_add_column(#lo, #hi, %slot.add_wrap(1).to_s64_wrap(), %count, cm_exp_hi(%prod))
        jump column(%i, %j.add(1), #lo, #hi)

    block carry(%q: S64, %carry: U128, #lo: Ptr<U64>, #hi: Ptr<U64>):
        %done : Bool = %q.ge(%count)
        branch %done ? return() : settle(%q.to_u64(), %carry, #lo, #hi)

    block settle(%q: U64, %carry: U128, #lo: Ptr<U64>, #hi: Ptr<U64>):
        %low  : U64  = #lo[%q].load()
        %high : U64  = #hi[%q].load()
        %sum  : U128 = %low.to_u128().add(%carry)
        #out[%q].store(%sum.to_s64_wrap().to_u64_wrap())
        jump carry(%q.add(1).to_s64(), %sum.shr(64).add(%high.to_u128()), #lo, #hi)

/// out = floor(a × b / 2^64) + c modulo 2^(64n), for a word a and n-word b and c.
/// out may alias b or c.
routine cm_exp_mul_add_words(#out: Ptr<U64>, %a: U64, #b: Ptr<U64>, #c: Ptr<U64>, %n: U64) -> Void
    block entry():
        %b0 : U64 = #b[0].load()
        jump step(0, cm_exp_mul(%a, %b0), 0)

    block step(%k: U64, %prev: U128, %carry: U128):
        %done : Bool = %k.ge(%n)
        branch %done ? return() : add(%k, %prev, %carry)

    block add(%k: U64, %prev: U128, %carry: U128):
        %next_k   : U64  = %k.add(1)
        %has_next : Bool = %next_k.lt(%n)
        %index    : U64  = %has_next ? %next_k : %k
        %bn       : U64  = #b[%index].load()
        %product  : U128 = cm_exp_mul(%a, %bn)
        %next     : U128 = %has_next ? %product : 0
        %ck       : U64  = #c[%k].load()
        %sum      : U128 = %prev.shr(64).add(%next.bitand(CM_EXP_LOW)).add(%ck.to_u128()).add(%carry)
        #out[%k].store(%sum.to_s64_wrap().to_u64_wrap())
        jump step(%next_k, %next, %sum.shr(64))

/// dst += src on n words, the carry out of the top dropped.
routine cm_exp_add_words(#dst: Ptr<U64>, #src: Ptr<U64>, %n: U64) -> Void
    block entry():
        jump step(0, 0)

    block step(%k: U64, %carry: U128):
        %done : Bool = %k.ge(%n)
        branch %done ? return() : add(%k, %carry)

    block add(%k: U64, %carry: U128):
        %d   : U64  = #dst[%k].load()
        %s   : U64  = #src[%k].load()
        %sum : U128 = %d.to_u128().add(%s.to_u128()).add(%carry)
        #dst[%k].store(%sum.to_s64_wrap().to_u64_wrap())
        jump step(%k.add(1), %sum.shr(64))

/// Word i of the len-word value at o, or the sign fill past its top.
routine cm_exp_word_or_sign(#o: Ptr<U64>, %i: U64, %len: U64, %sign: U64) -> U64
    block entry():
        %inside : Bool = %i.lt(%len)
        %index  : U64  = %inside ? %i : 0
        %word   : U64  = #o[%index].load()
        %r      : U64  = %inside ? %word : %sign
        return(%r)

/// Arithmetic right shift of the len-word value at o by n bits, in place (n < 64 len).
routine cm_exp_ashr_words(#o: Ptr<U64>, %len: U64, %n: U64) -> Void
    block entry():
        %top_index : U64 = %len.sub(1)
        %top       : U64 = #o[%top_index].load()
        %sign      : S64 = S64.from_bits(%top.bits()).shr(63)
        jump step(0, %n.shr(6), %n.bitand(63), %sign)

    // word j comes from words j + words and the one above it; both are at or above
    // j, so shifting in place from the bottom up never reads a word already written
    block step(%j: U64, %words: U64, %bits: U64, %sign: S64):
        %done : Bool = %j.ge(%len)
        branch %done ? return() : continue
        %from : U64 = %j.add(%words)
        %low  : U64 = cm_exp_word_or_sign(#o, %from, %len, %sign.to_u64_wrap())
        %high : U64 = cm_exp_word_or_sign(#o, %from.add(1), %len, %sign.to_u64_wrap())
        #o[%j].store(cm_exp_funnel(%high, %low, %bits.to_s64()).to_u64_wrap())
        jump step(%j.add(1), %words, %bits, %sign)

// -- fallback paths --------------------------------------------------------------

/// The fixed-point significand of x (with its implicit bit) times log2(base) in len
/// words (4 or 7), before the exponent shift. The sign is applied as a one's
/// complement after the product (exp, exp10) or a two's complement (exp2).
routine cm_exp_reduce_wide(#out: Ptr<U64>, %x: U128, %kind: U64, %len: U64) -> Void
    block entry():
        %sign_mask : U64  = cm_sign_mask64(cm_exp_hi(%x))
        %sig       : U128 = %x.bitand(F128_FRAC_MASK).bitor(F128_IMPLICIT)
        #out.zeroinit(%len)
        %is_two : Bool = %kind.eq(CM_EXP_KIND_TWO)
        branch %is_two ? twos_complement(%sign_mask, %sig) : scale(%sign_mask, %sig)

    // exp2: x itself is the multiple of log2(2)
    block twos_complement(%sign_mask: U64, %sig: U128):
        %mask2      : U128 = cm_exp_join(%sign_mask, %sign_mask)
        %signed     : U128 = %sig.bitxor(%mask2).sub_wrap(%mask2)
        %low_index  : U64  = %len.sub(2)
        %high_index : U64  = %len.sub(1)
        #out[%low_index].store(%signed.to_s64_wrap().to_u64_wrap())
        #out[%high_index].store(cm_exp_hi(%signed))
        return()

    block scale(%sign_mask: U64, %sig: U128):
        #sig_words : Ptr<Array<S64, 2>> = claim
        #sig_ptr   : Ptr<U64>           = #sig_words.cast<U64>()
        #sig_ptr[0].store(%sig.to_s64_wrap().to_u64_wrap())
        #sig_ptr[1].store(cm_exp_hi(%sig))
        %is_e  : Bool     = %kind.eq(CM_EXP_KIND_E)
        #table : Ptr<U64> = %is_e ? CM_EXP_ILN2.to_ptr() : CM_EXP_ILN102.to_ptr()
        #coef  : Ptr<U64> = #table[7.sub(%len)]
        cm_exp_mul_words(#out, #coef, %len, #sig_ptr, 2, 2, %len.to_s64())
        jump flip(0, %sign_mask)

    block flip(%q: U64, %sign_mask: U64):
        %done : Bool = %q.ge(%len)
        branch %done ? return() : continue
        #out[%q].store(#out[%q].load().bitxor(%sign_mask))
        jump flip(%q.add(1), %sign_mask)

/// The reduced argument of the wide paths: len words (4 or 7) of x × log2(base),
/// shifted to put the integer part in the top word.
routine cm_exp_wide_argument(#out: Ptr<U64>, %x: U128, %kind: U64, %len: U64) -> Void
    block entry():
        cm_exp_reduce_wide(#out, %x, %kind, %len)
        %base     : S64 = CM_EXP_WIDE_SHIFT.get(%kind)
        %exponent : S64 = f128_exponent(%x)
        cm_exp_ashr_words(#out, %len, %base.sub(%exponent).to_u64())
        return()

/// Row i of a flattened table of width-word rows.
routine cm_exp_row(#table: Ptr<U64>, %width: U64, %i: U64) -> Ptr<U64>
    block entry():
        #r : Ptr<U64> = #table[%i.mul(%width)]
        return(#r)

/// poly = the polynomial of the given degree at the word y (as a fraction of 2^64),
/// its coefficients the width-word rows of #coefs, by Horner steps.
routine cm_exp_horner(#poly: Ptr<U64>, %y: U64, #coefs: Ptr<U64>, %width: U64, %degree: U64) -> Void
    block entry():
        copy<U64>(#poly, cm_exp_row(#coefs, %width, %degree), %width)
        jump step(%degree)

    block step(%i: U64):
        %done : Bool = %i.eq(0)
        branch %done ? return() : fold(%i.sub(1))

    block fold(%i: U64):
        cm_exp_mul_add_words(#poly, %y, #poly, cm_exp_row(#coefs, %width, %i), %width)
        jump step(%i)

/// The accurate path, on 3 words: returns the unbiased exponent and the 2^x
/// significand for the finishing step, or defers to the superaccurate path when this
/// result is still too close to a rounding boundary.
routine cm_exp_accurate(%x: U128, %kind: U64) -> CmExpScaled
    block entry():
        #arg_words  : Ptr<Array<S64, 8>> = claim
        #tab_words  : Ptr<Array<S64, 8>> = claim
        #poly_words : Ptr<Array<S64, 8>> = claim
        #low_words  : Ptr<Array<S64, 8>> = claim
        #arg        : Ptr<U64>           = #arg_words.cast<U64>()
        #tab        : Ptr<U64>           = #tab_words.cast<U64>()
        #poly       : Ptr<U64>           = #poly_words.cast<U64>()
        #low        : Ptr<U64>           = #low_words.cast<U64>()
        cm_exp_wide_argument(#arg, %x, %kind, 4)
        %el_word : U64 = #arg[3].load()
        %el      : S64 = .from_bits(%el_word.bits())          // the exponent, stored as a word
        %top     : U64 = #arg[2].load()
        %x0      : U64 = #arg[0].load()
        %x1      : U64 = #arg[1].load()
        // 2^(j0/16) × 2^(j1/256) from the top 8 fraction bits
        %j0 : U64      = %top.shr(60)
        %j1 : U64      = %top.shr(56).bitand(15)
        #t0 : Ptr<U64> = cm_exp_row(CM_EXP_TBL0.to_ptr(), 3, %j0)
        #t1 : Ptr<U64> = cm_exp_row(CM_EXP_TBL1.to_ptr(), 3, %j1)
        cm_exp_mul_words(#tab, #t0, 3, #t1, 3, 3, 3)
        // a degree-14 polynomial in the rest of the top fraction word
        #c3   : Ptr<U64> = CM_EXP_C3.to_ptr()
        %frac : U64      = %top.bitand(0x00FFFFFFFFFFFFFF)
        cm_exp_horner(#poly, %frac, #c3, 3, 14)
        cm_exp_mul_words(#tab, #poly, 3, #tab, 3, 3, 3)
        // the two low fraction words by a first-order correction
        %c3w2   : U64  = #c3[2].load()
        %c3w4   : U64  = #c3[4].load()
        %c3w5   : U64  = #c3[5].load()
        %c3w8   : U64  = #c3[8].load()
        %slope  : U128 = cm_exp_join(%c3w5, %c3w4).add_wrap(cm_exp_mulhi(%c3w8, %x1).to_u128())
        %linear : U128 = cm_exp_mulhi128(cm_exp_join(%x1, %x0), %slope)
        #low[0].store(%linear.to_s64_wrap().to_u64_wrap())
        #low[1].store(cm_exp_hi(%linear))
        #low[2].store(%c3w2)
        cm_exp_mul_words(#poly, #tab, 3, #low, 3, 3, 3)
        %f0     : U64         = #poly[0].load()
        %f1     : U64         = #poly[1].load()
        %f2     : U64         = #poly[2].load()
        %sig    : U128        = cm_exp_join(%f2.shr(1), %f1.shr(1).bitor(%f2.shl(63)))
        %close  : Bool        = cm_exp_accurate_is_close(%el, %f0, %f1, %f2)
        %result : CmExpScaled = CmExpScaled { exp: %el, sig: %sig }
        branch %close ? continue : return(%result)
        %r : CmExpScaled = cm_exp_superaccurate(%x, %kind)
        return(%r)

/// Whether the accurate result (f2, f1, f0) is too close to a rounding boundary.
routine cm_exp_accurate_is_close(%el: S64, %f0: U64, %f1: U64, %f2: U64) -> Bool
    block entry():
        %normal : Bool = %el.ge(-16382)
        branch %normal ? normal() : subnormal()

    block normal():
        %low     : U128 = cm_exp_join(%f1, %f0)
        %dropped : U128 = %low.add_wrap(8).bitand(0x7FFFFFFFFFFFFFF)       // 2^59 - 1
        %r       : Bool = %dropped.le(16)
        return(%r)

    // the bits below the subnormal rounding position, s of them above the low word
    block subnormal():
        %s       : U64  = -16371.sub(%el).to_u64()
        %low     : U128 = cm_exp_join(%f1, %f0).add_wrap(8)
        %wrapped : Bool = %low.lt(8)
        %g0      : U64  = %low.to_u64_wrap()
        %g1      : U64  = cm_exp_hi(%low)
        %g2      : U64  = %f2.add_wrap(%wrapped.to_u64())
        %in_g1   : Bool = %s.lt(64)
        %in_g2   : Bool = %s.lt(128)
        when:
            %in_g1 -> mask_g1(%s, %g0, %g1)
            %in_g2 -> mask_g2(%s, %g0, %g1, %g2)
            _      -> decide(%g0, %g1, %g2)

    block mask_g1(%s: U64, %g0: U64, %g1: U64):
        %mask : U64 = 1.shl(%s).sub_wrap(1)
        jump decide(%g0, %g1.bitand(%mask), 0)

    block mask_g2(%s: U64, %g0: U64, %g1: U64, %g2: U64):
        %mask : U64 = 1.shl(%s.sub_wrap(64)).sub_wrap(1)
        jump decide(%g0, %g1, %g2.bitand(%mask))

    block decide(%g0: U64, %g1: U64, %g2: U64):
        %small : Bool = %g0.le(16)
        %clear : Bool = %g1.bitor(%g2).eq(0)
        %r     : Bool = %small.bitand(%clear)
        return(%r)

/// The superaccurate path, on 6 words, used when the accurate result is too close to
/// a rounding boundary: returns the unbiased exponent and the 2^x significand.
routine cm_exp_superaccurate(%x: U128, %kind: U64) -> CmExpScaled
    block entry():
        #arg_words  : Ptr<Array<S64, 8>> = claim
        #poly_words : Ptr<Array<S64, 8>> = claim
        #next_words : Ptr<Array<S64, 8>> = claim
        #low_words  : Ptr<Array<S64, 8>> = claim
        #arg        : Ptr<U64>           = #arg_words.cast<U64>()
        #poly       : Ptr<U64>           = #poly_words.cast<U64>()
        #next       : Ptr<U64>           = #next_words.cast<U64>()
        #low        : Ptr<U64>           = #low_words.cast<U64>()
        cm_exp_wide_argument(#arg, %x, %kind, 7)
        %el_word : U64 = #arg[6].load()
        %el      : S64 = .from_bits(%el_word.bits())          // the exponent, stored as a word
        %top     : U64 = #arg[5].load()
        // a degree-36 polynomial in the top fraction word below its 4 table bits
        #c6   : Ptr<U64> = CM_EXP_C6.to_ptr()
        %frac : U64      = %top.bitand(0x0FFFFFFFFFFFFFFF)
        cm_exp_horner(#poly, %frac, #c6, 6, 36)
        cm_exp_superaccurate_next(#next, #arg, #c6)
        cm_exp_superaccurate_low(#low, #arg, #c6)
        cm_exp_mul_words(#poly, #poly, 6, #next, 6, 6, 6)
        cm_exp_mul_words(#poly, #poly, 6, #low, 6, 6, 6)
        // 2^(j/16) from the table bits
        #power : Ptr<U64> = cm_exp_row(CM_EXP_TBL6.to_ptr(), 6, %top.shr(60))
        cm_exp_mul_words(#poly, #poly, 6, #power, 6, 6, 6)
        %f4  : U64         = #poly[4].load()
        %f5  : U64         = #poly[5].load()
        %sig : U128        = cm_exp_join(%f5.shr(1), %f4.shr(1).bitor(%f5.shl(63)))
        %r   : CmExpScaled = CmExpScaled { exp: %el, sig: %sig }
        return(%r)

/// 2^y for the next fraction word y = arg[4]: the same series, each degree truncated
/// to the words it can reach.
routine cm_exp_superaccurate_next(#out: Ptr<U64>, #arg: Ptr<U64>, #c6: Ptr<U64>) -> Void
    block entry():
        #acc_words  : Ptr<Array<S64, 8>> = claim
        #term_words : Ptr<Array<S64, 8>> = claim
        #acc        : Ptr<U64>           = #acc_words.cast<U64>()
        #term       : Ptr<U64>           = #term_words.cast<U64>()
        %y          : U64                = #arg[4].load()
        #acc.zeroinit(8)
        jump degree(5, %y, #acc, #term)

    // degree r keeps the words r .. 5 of its coefficient's row, from its word r up
    block degree(%r: U64, %y: U64, #acc: Ptr<U64>, #term: Ptr<U64>):
        %done : Bool = %r.eq(0)
        branch %done ? constant(%y, #acc) : add_degree(%r, %y, #acc, #term)

    block add_degree(%r: U64, %y: U64, #acc: Ptr<U64>, #term: Ptr<U64>):
        #term.zeroinit(8)
        #coef : Ptr<U64> = #c6[%r.mul(7)]
        copy<U64>(#term, #coef, 6.sub(%r))
        cm_exp_mul_add_words(#acc, %y, #acc, #term, 6)
        jump degree(%r.sub(1), %y, #acc, #term)

    block constant(%y: U64, #acc: Ptr<U64>):
        cm_exp_mul_add_words(#out, %y, #acc, #c6, 6)
        return()

/// 2^y for the four low fraction words y = arg[0..3], by a second-order correction:
/// 1 + y (c1 + y c2), each product keeping its top words.
routine cm_exp_superaccurate_low(#out: Ptr<U64>, #arg: Ptr<U64>, #c6: Ptr<U64>) -> Void
    block entry():
        #y_words     : Ptr<Array<S64, 8>> = claim
        #prod_words  : Ptr<Array<S64, 8>> = claim
        #slope_words : Ptr<Array<S64, 8>> = claim
        #y           : Ptr<U64>           = #y_words.cast<U64>()
        #prod        : Ptr<U64>           = #prod_words.cast<U64>()
        #slope       : Ptr<U64>           = #slope_words.cast<U64>()
        #y.zeroinit(8)
        copy<U64>(#y.offset(16), #arg, 4)
        cm_exp_mul_words(#prod, #y, 6, cm_exp_row(#c6, 6, 2), 6, 6, 6)
        #slope.zeroinit(8)
        copy<U64>(#slope, #prod.offset(16), 4)
        cm_exp_add_words(#slope, cm_exp_row(#c6, 6, 1), 6)
        cm_exp_mul_words(#prod, #y, 6, #slope, 6, 6, 6)
        copy<U64>(#out, #prod.offset(16), 4)
        copy<U64>(#out.offset(32), #c6.offset(32), 2)
        return()
