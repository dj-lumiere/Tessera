// Tessera stdlib: correctly rounded arc tangent of F128
//
// Ported from CORE-MATH, src/binary128/atan/atanq.c via RazorForge's B128Atan.rf.
// Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// F128.atan(x) is the exact arc tangent rounded to nearest, ties to even. |x| below 2^-57
// returns x and |x| above 2^115 returns ±π/2 (both already correctly rounded). Otherwise |x| (or
// 1/|x| past 1) is reduced against a table angle atan(t) with t = TN[i] / 2^15 to
// (|x| - t) / (1 + |x| t), whose series runs in atan_shared.tess; the table angle is added back
// (and taken from π/2 past 1). NaN in gives NaN out: a quiet NaN unchanged, a signaling one the
// default NaN.

module Standard::Core

/// |x| in [2^-e, 2^-e+1) for e <= 7: the first guess of the table index from the top mantissa bits
preset CM_ATAN_INDL: @Array<U64, 128> <- { 0, 0, 1, 1, 2, 3, 3, 4, 5, 5, 6, 6, 7, 8, 8, 9, 10, 10,
        11, 12, 12, 13, 13, 14, 15, 15, 16, 16, 17, 18, 18, 19, 19, 20, 21, 21, 22, 22, 23, 24, 24,
        25, 25, 26, 26, 27, 28, 28, 29, 29, 30, 30, 31, 31, 32, 33, 33, 34, 34, 35, 35, 36, 36, 37,
        37, 38, 38, 39, 39, 40, 40, 41, 41, 42, 42, 43, 43, 44, 44, 45, 45, 45, 46, 46, 47, 47, 48,
        48, 49, 49, 49, 50, 50, 51, 51, 52, 52, 52, 53, 53, 54, 54, 54, 55, 55, 55, 56, 56, 57, 57,
        57, 58, 58, 58, 59, 59, 59, 60, 60, 61, 61, 61, 62, 62, 62, 63, 63, 63 }

/// |x| in [2^e, 2^e+1) for e <= 6: the first guess from the complemented top mantissa bits
preset CM_ATAN_INDH: @Array<U64, 128> <- { 0, 0, 1, 1, 2, 2, 3, 4, 5, 5, 5, 6, 6, 7, 8, 9, 10, 10,
        10, 11, 11, 11, 12, 12, 13, 14, 14, 15, 16, 16, 17, 18, 19, 20, 20, 20, 21, 21, 21, 22, 22,
        23, 23, 23, 24, 24, 25, 25, 26, 26, 27, 27, 28, 29, 29, 30, 31, 31, 32, 33, 34, 34, 35, 36,
        37, 38, 38, 38, 38, 39, 39, 39, 39, 40, 40, 40, 41, 41, 41, 41, 42, 42, 42, 43, 43, 43, 44,
        44, 44, 45, 45, 46, 46, 46, 47, 47, 47, 48, 48, 49, 49, 49, 50, 50, 51, 51, 52, 52, 53, 53,
        54, 54, 54, 55, 55, 56, 57, 57, 58, 58, 59, 59, 60, 60, 61, 62, 62, 63 }

/// atan, asin, acos, and atan2 are CORE-MATH ports; NaN in and
/// outside the domain keep F128's own NaNs.
routine F128.atan(%self: Self) -> Self
    block entry():
        %nan   : Bool = %self.is_nan()
        %quiet : Self = f128_of(f128_quiet(%self.bits()))
        branch %nan
            ? return(%quiet)
            : continue
        %bits : U128 = %self.bits()
        %sign : U128 = %bits.bitand(F128_SIGN)
        %hi   : U64  = %bits.shr(64).to<U64>().bitand(0x7FFFFFFFFFFFFFFF)
        %lo   : U64  = %bits.to_wrap<U64>()
        %xn   : U64  = %hi.shr(48)
        // for |x| < 2^-57 the difference atan(x) - x is under half an ulp (this covers ±0)
        %tiny : Bool = %xn.lt(0x3FC6)  // 0x3FFF - 57
        %huge : Bool = %xn.gt(0x4071)  // 0x3FFF + 114
        when:
            %tiny -> return(%self)
            %huge -> huge(%hi, %lo, %sign)
            else  -> reduce(%hi, %lo, %xn, %sign)

    // |x| >= 2^115, infinity or NaN
    block huge(%hi: U64, %lo: U64, %sign: U128):
        %class     : S64  = cm_atan_class(%hi, %lo)
        %signaling : Bool = %class.eq(2)
        %quiet     : Bool = %class.eq(3)
        %default   : Self = f128_of(0xFFFF8000000000000000000000000000)
        %half_pi   : U128 = 0x3FFF921FB54442D18469898CC51701B8
        %angle     : Self = f128_of(%half_pi.bitor(%sign))
        when:
            %signaling -> return(%default)
            %quiet     -> return(%self)
            else       -> return(%angle)

    block reduce(%hi: U64, %lo: U64, %xn: U64, %sign: U128):
        %mant  : U64             = %hi.bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        %red   : CmAtanReduction = cm_atan_reduce(%mant, %lo, %xn)
        %kd    : U128            = cm_atan_join(%red.kd2, %red.kd1)
        %f     : U128            = cm_atan_fast_core(%red.kn, %kd, %red.dn)
        %table : Bool            = %red.isct.ne(0).bitor(%red.g)
        branch %table
            ? with_table(%red, %f, %sign)
            : direct(%red, %f, %sign)

    // atan|x| = PHI0[isct] + f, or π/2 - that past 1
    block with_table(%red: CmAtanReduction, %f: U128, %sign: U128):
        %placed    : CmAtanU192 = cm_atan_place(%f, %red.dn.add(1))
        %phi       : CmAtanU192 = cm_atan_row_top(CM_ATAN_PHI0.to<@U64>(), %red.isct)
        %angle     : CmAtanU192 = cm_atan_u192_add(%phi, %placed)
        %half_pi   : CmAtanU192 = cm_atan_row_top(CM_ATAN_QOFF.to<@U64>(), 1)
        %reflected : CmAtanU192 = cm_atan_u192_sub(%half_pi, %angle)
        %final     : CmAtanU192 = %red.g
            ? %reflected
            : %angle
        %rounded : CmAtanRounded = cm_atan_round_fixed(%final)
        %result  : Self          = f128_of(%rounded.bits.bitor(%sign))
        %hard    : Bool          = %rounded.hard
        branch %hard
            ? accurate(%red, %sign)
            : return(%result)

    block direct(%red: CmAtanReduction, %f: U128, %sign: U128):
        %rounded : CmAtanRounded = cm_atan_round_direct(%f, %red.dn)
        %result  : Self          = f128_of(%rounded.bits.bitor(%sign))
        %hard    : Bool          = %rounded.hard
        branch %hard
            ? accurate(%red, %sign)
            : return(%result)

    block accurate(%red: CmAtanReduction, %sign: U128):
        %r : Self = cm_atan_accurate(%red, %sign)
        return(%r)

/// Reduces |x| = mant:lo × 2^(xn - 0x3FFF - 112) (mant carrying the implicit bit) against the
/// table. Far from 1 no table angle is needed: |x| itself, or 1/|x|.
routine cm_atan_reduce(%mant: U64, %lo: U64, %xn: U64) -> CmAtanReduction
    block entry():
        %above : Bool = %xn.ge(0x3FFF)
        branch %above
            ? above_one()
            : below_one()

    block below_one():
        %e   : U64  = 0x3FFF.sub(%xn)
        %far : Bool = %e.gt(7)
        branch %far
            ? small(%e)
            : table_below(%e.to<S64>())

    // |x| < 2^-7: kn / kd = |x| itself
    block small(%e: U64):
        %kn : U128            = cm_atan_join(%mant, %lo).shl(15)
        %r  : CmAtanReduction = CmAtanReduction { zero: false, g: false, isct: 0, dn: %e.to<S64>(),
                kn: %kn, kd0: 0, kd1: 0, kd2: 0x8000000000000000 }
        return(%r)

    // kn = |x| - t, kd = 1 + |x| t
    block table_below(%e: S64):
        %guess_at : USize      = %mant.shr(%e.add(41).to<U64>()).to<USize>()
        %guess    : USize      = CM_ATAN_INDL.get(%guess_at).to<USize>()
        %next_at  : USize      = %guess.add(1)
        %next_tn  : U64        = CM_ATAN_TN.get(%next_at)
        %bump     : Bool       = %next_tn.le(%mant.shr(%e.add(33).to<U64>()))
        %isct     : USize      = %guess.add(%bump.to<USize>())
        %tn       : U64        = CM_ATAN_TN.get(%isct)
        %tt       : U64        = %tn.shl(%e.add(33).to<U64>())
        %norm     : CmAtanNorm = cm_atan_normalize(%mant.sub_wrap(%tt), %lo)
        %xa       : U128       = cm_atan_join(%mant, %lo).mul_wrap(%tn.to<U128>())
        // kd = 1 + xa >> e: the leading one and xa's bits under it
        %kd  : U128            = %xa.shr(%e.to<U128>())
        %kd0 : S64             = %xa.to_wrap<S64>().shl(0.sub(%e).bitand(63))
        %kd2 : U64             = %kd.shr(64).to<U64>().bitor(0x8000000000000000)
        %dn  : S64             = %e.add(%norm.shift).sub(15)
        %r   : CmAtanReduction = CmAtanReduction { zero: false, g: false, isct: %isct, dn: %dn,
                kn: %norm.kn, kd0: %kd0, kd1: %kd.to_wrap<U64>(), kd2: %kd2 }
        return(%r)

    block above_one():
        %e   : U64  = %xn.sub(0x3FFF)
        %far : Bool = %e.gt(6)
        branch %far
            ? large(%e)
            : table_above(%e.to<S64>())

    // |x| >= 2^7: kn / kd = 1 / |x|
    block large(%e: U64):
        %kd  : U128            = cm_atan_join(%mant, %lo).shl(15)
        %one : U128            = 0x80000000000000000000000000000000
        %r   : CmAtanReduction = CmAtanReduction { zero: false, g: true, isct: 0, dn: %e.to<S64>(),
                kn: %one, kd0: 0, kd1: %kd.to_wrap<U64>(), kd2: %kd.shr(64).to<U64>() }
        return(%r)

    // kn = 1 - |x| t, kd = |x| + t, the index guess moved down one when |x| t passes 1
    block table_above(%e: S64):
        %xa       : U128  = cm_atan_join(%mant, %lo)
        %guess_at : USize = %mant.bitxor(0x0000FFFFFFFFFFFF).shr(%e.add(42).to<U64>()).to<USize>()
        %guess    : USize = CM_ATAN_INDH.get(%guess_at).to<USize>()
        %next_at  : USize = %guess.add(1)
        %next_tn  : U64   = CM_ATAN_TN.get(%next_at)
        %limit    : U64   = 1.shl(63.sub(%e)).to_wrap<U64>()
        %bump     : Bool  = %next_tn.mul_wrap(%mant).lt(%limit)
        %first    : USize = %guess.add(%bump.to<USize>())
        %first_tn : U64   = CM_ATAN_TN.get(%first)
        %past     : U128  = %xa.mul_wrap(%first_tn.to<U128>())
        %over     : Bool  = %past.shr(64).to<U64>().bitand(%limit).ne(0)
        %isct     : USize = %over
            ? %first.sub_wrap(1)
            : %first
        %tn : U64  = CM_ATAN_TN.get(%isct)
        %t  : U128 = %xa.mul_wrap(%tn.to<U128>())
        // kn = -(t << e) with its top bit flipped, normalized
        %neg    : U128            = 0.sub_wrap(%t.shl(%e.to<U128>()))
        %knh    : U64             = %neg.shr(64).to<U64>().bitxor(0x8000000000000000)
        %norm   : CmAtanNorm      = cm_atan_normalize(%knh, %neg.to_wrap<U64>())
        %sum_hi : U64             = %mant.add_wrap(%tn.shl(33.sub(%e).to<U64>()))
        %nzd    : S64             = %sum_hi.leading_zeros().to<S64>()
        %spill  : U64             = %lo.shr(0.sub(%nzd).bitand(63).to<U64>())
        %kd2    : U64             = %sum_hi.shl(%nzd.to<U64>()).bitor(%spill)
        %kd1    : U64             = %lo.shl(%nzd.to<U64>())
        %dn     : S64             = %e.add(%norm.shift).sub(%nzd).add(15)
        %r      : CmAtanReduction = CmAtanReduction { zero: false, g: true, isct: %isct, dn: %dn,
                kn: %norm.kn, kd0: 0, kd1: %kd1, kd2: %kd2 }
        return(%r)

/// The accurate path: the same reduction, the series in 6 limbs.
routine cm_atan_accurate(%red: CmAtanReduction, %sign: U128) -> F128
    block entry():
        claim %f_buf : @Array<S64, 8> <- uninit
        %f : @U64 = %f_buf.to<@U64>()
        cm_atan_accurate_core(%red, %f)
        %table : Bool = %red.isct.ne(0).bitor(%red.g)
        branch %table
            ? with_table(%f)
            : finish(%f, %red.dn)

    block with_table(%f: @U64):
        %dn : S64 = %red.dn
        cm_atan_limbs_shr(%f, 6, %dn.add(1))
        %row : USize = %red.isct.mul(6)
        %phi : @U64  = CM_ATAN_PHI0.to<@U64>().stride(%row)
        cm_atan_limbs_add(%f, %phi, %f, 6)
        %inverted : Bool = %red.g
        branch %inverted
            ? reflect(%f)
            : finish(%f, -1)

    // π/2 - f
    block reflect(%f: @U64):
        %half_pi : @U64 = CM_ATAN_QOFF.to<@U64>().offset(48)
        cm_atan_limbs_sub(%f, %half_pi, %f, 6)
        jump finish(%f, -1)

    block finish(%f: @U64, %dn: S64):
        %bits : U128 = cm_atan_round_limbs(%f, %dn)
        %r    : F128 = f128_of(%bits.bitor(%sign))
        return(%r)
