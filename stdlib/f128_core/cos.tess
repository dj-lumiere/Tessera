// Tessera stdlib: correctly rounded F128 cosine
//
// Ported from CORE-MATH, src/binary128/cos/cosq.c via RazorForge's B128Cos.rf.
// Copyright (c) 2026 Chen-Pang He <jdh863@gmail.com>
// MIT license: see LICENSE-CORE-MATH
//
// The result is the exact cosine of the argument (in radians) rounded to the nearest F128, ties to even.
// cos(-x) = cos(x), ±infinity gives the default quiet NaN, and a NaN comes back quieted with its sign and
// payload. The pipeline shared with the sine lives in trig_shared.tess.

module Standard::Core

routine F128.cos(%self: Self) -> Self
    block entry():
        %finite : Bool = %self.is_finite()
        branch %finite
            ? compute()
            : special()

    block compute():
        %bits : U128 = cm_trig(%self.bits(), true)
        %r    : Self = f128_of(%bits)
        return(%r)

    block special():
        %r : Self = f128_trig_nonfinite(%self)
        return(%r)
