// Tessera stdlib: the shared engine of the correctly rounded F128 asin and acos
//
// Ported from CORE-MATH, src/binary128/asin/asinq.c and src/binary128/acos/acosq.c via
// RazorForge's CoreMath/B128AsinFam.rf (https://core-math.gitlabpages.inria.fr/). The two C
// files carry identical copies of these helpers and tables, so they are kept once here and used
// by f128_core/asin.tess and f128_core/acos.tess.
// Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// Only the round-to-nearest path of the original is kept. Everything works on integers (64-bit
// words, carry chains, 64x64->128-bit products), never on F128 arithmetic. A multi-word value is a
// record of words, least significant first (w0). Words are U64; word arithmetic that relies on C's
// wrap-around uses the _wrap forms, and exponents, counts, and shift amounts use the plain
// (overflow-checked) ones. Every variable shift amount is reduced modulo the width first, as the
// C code relies on the hardware doing; an LLVM shift by the full width or more is poison.

module Standard::Core

record CmAsinCarry
    sum   : U64
    carry : U64

record CmAsinW3
    w0 : U64
    w1 : U64
    w2 : U64

record CmAsinW4
    w0 : U64
    w1 : U64
    w2 : U64
    w3 : U64

record CmAsinW5
    w0 : U64
    w1 : U64
    w2 : U64
    w3 : U64
    w4 : U64

record CmAsinW6
    w0 : U64
    w1 : U64
    w2 : U64
    w3 : U64
    w4 : U64
    w5 : U64

/// 1 - x^2 normalized to four words, with its exponent e (the C omx2 results)
record CmAsinNorm
    w0 : U64
    w1 : U64
    w2 : U64
    w3 : U64
    e  : S64

/// sqrt(1 - x^2) to three words (fast path), with the exponent e of 1 - x^2
record CmAsinRoot3
    w0 : U64
    w1 : U64
    w2 : U64
    e  : S64

/// sqrt(1 - x^2) to five words (accurate path), with the exponent e of 1 - x^2
record CmAsinRoot5
    root : CmAsinW5
    e    : S64

// -- words ---------------------------------------------------------------------

/// The full 128-bit product of two unsigned words.
routine cm_asin_mul(%a: U64, %b: U64) -> U128
    block entry():
        %r : U128 = %a.to_u128().mul_wrap(%b.to_u128())
        return(%r)

routine cm_asin_hi(%u: U128) -> U64
    block entry():
        %r : U64 = %u.shr(64).to_u64()
        return(%r)

routine cm_asin_lo(%u: S128) -> U64
    block entry():
        %r : U64 = %u.to_u64_wrap()
        return(%r)

routine cm_asin_join(%hi: U64, %lo: U64) -> U128
    block entry():
        %r : U128 = %hi.to_u128().shl(64).bitor(%lo.to_u128())
        return(%r)

/// The high word of the unsigned product a*b.
routine cm_asin_mhuu(%a: U64, %b: U64) -> U64
    block entry():
        %r : U64 = cm_asin_hi(cm_asin_mul(%a, %b))
        return(%r)

/// The high word of the signed product a*b.
routine cm_asin_mhii(%a: S64, %b: S64) -> S64
    block entry():
        %p     : S64 = cm_asin_mhuu(%a.to_u64_wrap(), %b.to_u64_wrap()).to_s64_wrap()
        %a_fix : S64 = %a.lt(0) ? %b : 0
        %b_fix : S64 = %b.lt(0) ? %a : 0
        %r     : S64 = %p.sub_wrap(%a_fix).sub_wrap(%b_fix)
        return(%r)

/// a + b + c, with the carry out (0, 1 or 2).
routine cm_asin_ac(%a: U64, %b: U64, %c: U64) -> CmAsinCarry
    block entry():
        %s : U128        = %a.to_u128().add(%b.to_u128()).add(%c.to_u128())
        %r : CmAsinCarry = CmAsinCarry { sum: %s.to_u64_wrap(), carry: %s.shr(64).to_u64() }
        return(%r)

/// a - b - c, with the borrow out (0 or 1).
routine cm_asin_sc(%a: U64, %b: U64, %c: U64) -> CmAsinCarry
    block entry():
        %s      : U128        = %a.to_u128().sub_wrap(%b.to_u128()).sub_wrap(%c.to_u128())
        %borrow : U64         = %s.shr(64).to_u64().bitand(1)
        %r      : CmAsinCarry = CmAsinCarry { sum: %s.to_u64_wrap(), carry: %borrow }
        return(%r)

/// A 64-bit shift amount taken modulo 64.
routine cm_asin_sh(%n: S64) -> U64
    block entry():
        %r : S64 = %n.bitand(63)
        return(%r.to_u64())

/// A 128-bit shift amount taken modulo 128.
routine cm_asin_sh7(%n: S64) -> U128
    block entry():
        %r : U128 = %n.bitand(127).to_u128()
        return(%r)

routine cm_asin_add3(%a: CmAsinW3, %b: CmAsinW3) -> CmAsinW3
    block entry():
        %r0 : CmAsinCarry = cm_asin_ac(%a.w0, %b.w0, 0)
        %r1 : CmAsinCarry = cm_asin_ac(%a.w1, %b.w1, %r0.carry)
        %r2 : CmAsinCarry = cm_asin_ac(%a.w2, %b.w2, %r1.carry)
        %r  : CmAsinW3    = CmAsinW3 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum }
        return(%r)

routine cm_asin_sub3(%a: CmAsinW3, %b: CmAsinW3) -> CmAsinW3
    block entry():
        %r0 : CmAsinCarry = cm_asin_sc(%a.w0, %b.w0, 0)
        %r1 : CmAsinCarry = cm_asin_sc(%a.w1, %b.w1, %r0.carry)
        %r2 : CmAsinCarry = cm_asin_sc(%a.w2, %b.w2, %r1.carry)
        %r  : CmAsinW3    = CmAsinW3 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum }
        return(%r)

routine cm_asin_add4(%a: CmAsinW4, %b: CmAsinW4) -> CmAsinW4
    block entry():
        %r0 : CmAsinCarry = cm_asin_ac(%a.w0, %b.w0, 0)
        %r1 : CmAsinCarry = cm_asin_ac(%a.w1, %b.w1, %r0.carry)
        %r2 : CmAsinCarry = cm_asin_ac(%a.w2, %b.w2, %r1.carry)
        %r3 : CmAsinCarry = cm_asin_ac(%a.w3, %b.w3, %r2.carry)
        %r  : CmAsinW4    = CmAsinW4 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum, w3: %r3.sum }
        return(%r)

routine cm_asin_add5(%a: CmAsinW5, %b: CmAsinW5) -> CmAsinW5
    block entry():
        %r0 : CmAsinCarry = cm_asin_ac(%a.w0, %b.w0, 0)
        %r1 : CmAsinCarry = cm_asin_ac(%a.w1, %b.w1, %r0.carry)
        %r2 : CmAsinCarry = cm_asin_ac(%a.w2, %b.w2, %r1.carry)
        %r3 : CmAsinCarry = cm_asin_ac(%a.w3, %b.w3, %r2.carry)
        %r4 : CmAsinCarry = cm_asin_ac(%a.w4, %b.w4, %r3.carry)
        %r  : CmAsinW5    = CmAsinW5 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum, w3: %r3.sum,
                w4: %r4.sum }
        return(%r)

routine cm_asin_sub5(%a: CmAsinW5, %b: CmAsinW5) -> CmAsinW5
    block entry():
        %r0 : CmAsinCarry = cm_asin_sc(%a.w0, %b.w0, 0)
        %r1 : CmAsinCarry = cm_asin_sc(%a.w1, %b.w1, %r0.carry)
        %r2 : CmAsinCarry = cm_asin_sc(%a.w2, %b.w2, %r1.carry)
        %r3 : CmAsinCarry = cm_asin_sc(%a.w3, %b.w3, %r2.carry)
        %r4 : CmAsinCarry = cm_asin_sc(%a.w4, %b.w4, %r3.carry)
        %r  : CmAsinW5    = CmAsinW5 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum, w3: %r3.sum,
                w4: %r4.sum }
        return(%r)

/// Every word of a xor m (m is 0 or all ones: a one's complement when set).
routine cm_asin_xor3(%a: CmAsinW3, %m: U64) -> CmAsinW3
    block entry():
        %w0 : U64      = %a.w0.bitxor(%m)
        %w1 : U64      = %a.w1.bitxor(%m)
        %w2 : U64      = %a.w2.bitxor(%m)
        %r  : CmAsinW3 = CmAsinW3 { w0: %w0, w1: %w1, w2: %w2 }
        return(%r)

routine cm_asin_xor4(%a: CmAsinW4, %m: U64) -> CmAsinW4
    block entry():
        %w0 : U64      = %a.w0.bitxor(%m)
        %w1 : U64      = %a.w1.bitxor(%m)
        %w2 : U64      = %a.w2.bitxor(%m)
        %w3 : U64      = %a.w3.bitxor(%m)
        %r  : CmAsinW4 = CmAsinW4 { w0: %w0, w1: %w1, w2: %w2, w3: %w3 }
        return(%r)

routine cm_asin_xor5(%a: CmAsinW5, %m: U64) -> CmAsinW5
    block entry():
        %w0 : U64      = %a.w0.bitxor(%m)
        %w1 : U64      = %a.w1.bitxor(%m)
        %w2 : U64      = %a.w2.bitxor(%m)
        %w3 : U64      = %a.w3.bitxor(%m)
        %w4 : U64      = %a.w4.bitxor(%m)
        %r  : CmAsinW5 = CmAsinW5 { w0: %w0, w1: %w1, w2: %w2, w3: %w3, w4: %w4 }
        return(%r)

/// Words k, k+1, k+2 of a table.
routine cm_asin_load3(%table: Ptr<U64>, %k: U64) -> CmAsinW3
    block entry():
        %w0 : U64      = %table[%k].load()
        %w1 : U64      = %table[%k.add(1)].load()
        %w2 : U64      = %table[%k.add(2)].load()
        %r  : CmAsinW3 = CmAsinW3 { w0: %w0, w1: %w1, w2: %w2 }
        return(%r)

/// Words k to k+3 of a table.
routine cm_asin_load4(%table: Ptr<U64>, %k: U64) -> CmAsinW4
    block entry():
        %low : CmAsinW3 = cm_asin_load3(%table, %k)
        %w3  : U64      = %table[%k.add(3)].load()
        %r   : CmAsinW4 = CmAsinW4 { w0: %low.w0, w1: %low.w1, w2: %low.w2, w3: %w3 }
        return(%r)

/// Words k to k+4 of a table.
routine cm_asin_load5(%table: Ptr<U64>, %k: U64) -> CmAsinW5
    block entry():
        %low : CmAsinW4 = cm_asin_load4(%table, %k)
        %w4  : U64      = %table[%k.add(4)].load()
        %r   : CmAsinW5 = CmAsinW5 { w0: %low.w0, w1: %low.w1, w2: %low.w2, w3: %low.w3, w4: %w4 }
        return(%r)

// -- 128-bit helpers of the fast path ------------------------------------------

/// Approximate high 128 bits of the unsigned 128x128-bit product (the C mhUU).
routine cm_asin_mhuu128(%a: S128, %b: S128) -> U128
    block entry():
        %a0   : U64  = cm_asin_lo(%a)
        %a1   : U64  = cm_asin_hi(%a.to_u128_wrap())
        %b0   : U64  = cm_asin_lo(%b)
        %b1   : U64  = cm_asin_hi(%b.to_u128_wrap())
        %a1b0 : U128 = cm_asin_mul(%a1, %b0)
        %a0b1 : U128 = cm_asin_mul(%a0, %b1)
        %a1b1 : U128 = cm_asin_mul(%a1, %b1)
        %r    : U128 = %a1b1.add_wrap(%a1b0.shr(64)).add_wrap(%a0b1.shr(64))
        return(%r)

/// Approximate high 128 bits of the square of a 128-bit value (the C sqrhU).
routine cm_asin_sqrhu128(%a: S128) -> U128
    block entry():
        %a0    : U64  = cm_asin_lo(%a)
        %a1    : U64  = cm_asin_hi(%a.to_u128_wrap())
        %cross : U128 = cm_asin_mul(%a1, %a0).shr(63)
        %r     : U128 = cm_asin_mul(%a1, %a1).add_wrap(%cross)
        return(%r)

/// High three words of the product of a word y and a three-word x (the C mhu3uu3).
routine cm_asin_mh3w(%y: U64, %x: CmAsinW3) -> CmAsinW3
    block entry():
        %xy0 : U128        = cm_asin_mul(%x.w0, %y)
        %xy1 : U128        = cm_asin_mul(%x.w1, %y)
        %xy2 : U128        = cm_asin_mul(%x.w2, %y)
        %r0  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%xy1.to_s128_wrap()), cm_asin_hi(%xy0), 0)
        %r1  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%xy2.to_s128_wrap()), cm_asin_hi(%xy1),
                %r0.carry)
        %r2  : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%xy2), %r1.carry)
        %r   : CmAsinW3    = CmAsinW3 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum }
        return(%r)

/// High three words of the product of a two-word y and a three-word x (the C mhu3u2u3).
routine cm_asin_mh3d(%y0: U64, %y1: U64, %x: CmAsinW3) -> CmAsinW3
    block entry():
        %x1y0 : U128        = cm_asin_mul(%x.w1, %y0)
        %x2y0 : U128        = cm_asin_mul(%x.w2, %y0).add_wrap(%x1y0.shr(64))
        %x0y1 : U128        = cm_asin_mul(%x.w0, %y1)
        %x1y1 : U128        = cm_asin_mul(%x.w1, %y1).add_wrap(%x0y1.shr(64))
        %x2y1 : U128        = cm_asin_mul(%x.w2, %y1).add_wrap(%x1y1.shr(64))
        %r0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%x1y1.to_s128_wrap()),
                cm_asin_lo(%x2y0.to_s128_wrap()), 0)
        %r1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%x2y1.to_s128_wrap()), cm_asin_hi(%x2y0),
                %r0.carry)
        %r2   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%x2y1), %r1.carry)
        %r    : CmAsinW3    = CmAsinW3 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum }
        return(%r)

// -- range reduction and 1/sqrt ------------------------------------------------

/// Reciprocal square root of a 64-bit fixed-point m in [1, 2), to almost 64 bits (the C rsqrt9):
/// a cubic from CM_ASIN_RSQRT, then one Newton step r1 = r0 - r0*(r0^2*m - 1)/2.
routine cm_asin_rsqrt9(%m: U64) -> U64
    block entry():
        %rsqrt : Ptr<U64> = CM_ASIN_RSQRT.to_ptr()
        %ix    : U64      = %m.shr(58).shl(2)
        %row   : CmAsinW4 = cm_asin_load4(%rsqrt, %ix)
        %c0    : U64      = %row.w0.shl(31).bitor(0x8000000000000000)
        %c1    : U64      = %row.w1.shl(25)
        %d     : U64      = %m.shl(6).shr(32)
        %d2    : U64      = %d.mul_wrap(%d).shr(32)
        %even  : U64      = %c0.add_wrap(%d2.mul_wrap(%row.w2).shr(13))
        %odd_c : U64      = %c1.add_wrap(%d2.mul_wrap(%row.w3).shr(19))
        %odd   : U64      = %d.mul_wrap(%odd_c.shr(26)).shr(6)
        %r0    : U64      = %even.sub_wrap(%odd)
        %r0_sq : U64      = cm_asin_mhuu(%r0, %r0)
        %h     : U64      = cm_asin_mhuu(%m, %r0_sq).add_wrap(%r0_sq)
        %step  : U64      = cm_asin_mhii(%h.to_s64_wrap(), %r0.shr(1).to_s64()).to_u64_wrap()
        %r1    : U64      = %r0.sub_wrap(%step)
        %r     : U64      = %r1.eq(0) ? U64.MAX : %r1
        return(%r)

/// The table index j of the range reduction, from the high word of 0 < |x| < 1 (the C jget).
routine cm_asin_jget(%x: U64) -> U64
    block entry():
        %z       : U64      = 0x3FFF000000000000.sub_wrap(%x)
        %mz      : U64      = %z.shl(16)
        %e       : S64      = %z.shr(48).to_s64()
        %nz      : U64      = %mz.leading_zeros()
        %e_zero  : Bool     = %e.eq(0)
        %mz_norm : U64      = %e_zero ? %mz.shl(cm_asin_sh(%nz.add(1).to_s64())) : %mz
        %e_norm  : S64      = %e_zero ? %e.sub(%nz.to_s64()) : %e
        %lz_raw  : S64      = %e_norm.mul(16).add(%mz_norm.shr(60).to_s64()).add(161)
        %lz      : U64      = %lz_raw.max(0).to_u64()
        %ind     : Ptr<U64> = CM_ASIN_IND.to_ptr()
        %slot    : U64      = %lz.min(255)
        %listed  : U64      = %ind[%slot].load()
        %j       : U64      = %lz.lt(256) ? %listed : 0
        %tz      : S64      = %e_norm.mul(2048).add(%mz_norm.shr(53).to_s64())
        %sth     : Ptr<S64> = CM_ASIN_STH.to_ptr()
        %bound   : S64      = %sth[%j].load()
        %below   : Bool     = %tz.lt(%bound)
        %r       : U64      = %j.add(%below.to_u64())
        return(%r)

/// The full 256-bit square of a two-word value (the C sqrU).
routine cm_asin_sqru(%x0: U64, %x1: U64) -> CmAsinW4
    block entry():
        %p10     : U128        = cm_asin_mul(%x1, %x0)
        %p10_top : U64         = cm_asin_hi(%p10).shr(63)
        %p10x2   : U128        = %p10.shl(1)
        %p00     : U128        = cm_asin_mul(%x0, %x0)
        %p11     : U128        = cm_asin_mul(%x1, %x1)
        %r1      : CmAsinCarry = cm_asin_ac(cm_asin_hi(%p00), cm_asin_lo(%p10x2.to_s128_wrap()), 0)
        %r2      : CmAsinCarry = cm_asin_ac(cm_asin_hi(%p10x2), cm_asin_lo(%p11.to_s128_wrap()),
                %r1.carry)
        %r3      : CmAsinCarry = cm_asin_ac(cm_asin_hi(%p11), %p10_top, %r2.carry)
        %r       : CmAsinW4    = CmAsinW4 { w0: cm_asin_lo(%p00.to_s128_wrap()), w1: %r1.sum,
                w2: %r2.sum, w3: %r3.sum }
        return(%r)

/// Normalized 1 - x^2 for the two-word x scaled by 2^-s: four words and the exponent e. %mode
/// picks the C variant: 0 = asinq's omx2v2 (one's complement), 1 = acosq's omx2v2 (one's
/// complement, plus one when the top word vanishes), 2 = omx2v3 (exact two's complement).
routine cm_asin_omx2(%s: S64, %x0: U64, %x1: U64, %mode: S64) -> CmAsinNorm
    block entry():
        %q     : CmAsinW4 = cm_asin_sqru(%x0, %x1)
        %ls    : S64      = cm_asin_sh(%s.bitnot()).to_s64()
        %rs    : S64      = cm_asin_sh(%s).to_s64()
        %y0    : U64      = %q.w1.shl(1).shl(%ls.to_u64()).bitor(%q.w0.shr(%rs.to_u64()))
        %y1    : U64      = %q.w2.shl(1).shl(%ls.to_u64()).bitor(%q.w1.shr(%rs.to_u64()))
        %y2    : U64      = %q.w3.shl(1).shl(%ls.to_u64()).bitor(%q.w2.shr(%rs.to_u64()))
        %y3    : U64      = %q.w3.shr(%rs.to_u64())
        %y     : CmAsinW4 = CmAsinW4 { w0: %y0, w1: %y1, w2: %y2, w3: %y3 }
        %exact : Bool     = %mode.eq(2)
        branch %exact ? negate(%y, %mode) : normalize(cm_asin_xor4(%y, U64.MAX), %mode)

    block negate(%y: CmAsinW4, %mode: S64):
        %n0 : CmAsinCarry = cm_asin_sc(0, %y.w0, 0)
        %n1 : CmAsinCarry = cm_asin_sc(0, %y.w1, %n0.carry)
        %n2 : CmAsinCarry = cm_asin_sc(0, %y.w2, %n1.carry)
        %n3 : CmAsinCarry = cm_asin_sc(0, %y.w3, %n2.carry)
        %n  : CmAsinW4    = CmAsinW4 { w0: %n0.sum, w1: %n1.sum, w2: %n2.sum, w3: %n3.sum }
        jump normalize(%n, %mode)

    block normalize(%y: CmAsinW4, %mode: S64):
        %top_set : Bool = %y.w3.ne(0)
        branch %top_set ? shift_top(%y) : shift_low(%y, %mode)

    block shift_top(%y: CmAsinW4):
        %lk : S64        = %y.w3.leading_zeros().to_s64()
        %l  : S64        = cm_asin_sh(%lk).to_s64()
        %r  : S64        = cm_asin_sh(%lk.bitnot()).to_s64()
        %w3 : U64        = %y.w3.shl(%l.to_u64()).bitor(%y.w2.shr(1).shr(%r.to_u64()))
        %w2 : U64        = %y.w2.shl(%l.to_u64()).bitor(%y.w1.shr(1).shr(%r.to_u64()))
        %w1 : U64        = %y.w1.shl(%l.to_u64()).bitor(%y.w0.shr(1).shr(%r.to_u64()))
        %w0 : U64        = %y.w0.shl(%l.to_u64())
        %n  : CmAsinNorm = CmAsinNorm { w0: %w0, w1: %w1, w2: %w2, w3: %w3, e: %lk.add(1) }
        return(%n)

    // the top word vanished: acos's variant adds one first, then everything moves up a word
    block shift_low(%y: CmAsinW4, %mode: S64):
        %inc : U64         = %mode.eq(1).to_u64()
        %i0  : CmAsinCarry = cm_asin_ac(%y.w0, %inc, 0)
        %i1  : CmAsinCarry = cm_asin_ac(%y.w1, 0, %i0.carry)
        %i2  : CmAsinCarry = cm_asin_ac(%y.w2, 0, %i1.carry)
        %lk  : S64         = %i2.sum.leading_zeros().to_s64()
        %l   : S64         = cm_asin_sh(%lk).to_s64()
        %r   : S64         = cm_asin_sh(%lk.bitnot()).to_s64()
        %w3  : U64         = %i2.sum.shl(%l.to_u64()).bitor(%i1.sum.shr(1).shr(%r.to_u64()))
        %w2  : U64         = %i1.sum.shl(%l.to_u64()).bitor(%i0.sum.shr(1).shr(%r.to_u64()))
        %w1  : U64         = %i0.sum.shl(%l.to_u64())
        %n   : CmAsinNorm  = CmAsinNorm { w0: 0, w1: %w1, w2: %w2, w3: %w3, e: %lk.add(65) }
        return(%n)

/// 2^64/sqrt(2)^(e&1): the scale that folds an odd exponent into the reciprocal square root.
routine cm_asin_rsqrt2(%e: S64) -> U64
    block entry():
        %odd : Bool = %e.bitand(1).ne(0)
        %r   : U64  = %odd ? 0xB504F333F9DE6484 : 0xFFFFFFFFFFFFFFFF
        return(%r)

/// The fast path's sqrt(1 - x^2) for the mantissa words x (shifted left by 15) and
/// nz = 0x3fff - exponent; %mode is passed on to cm_asin_omx2.
routine cm_asin_fast_sqrt(%x0: U64, %x1: U64, %nz: S64, %mode: S64) -> CmAsinRoot3
    block entry():
        %q   : CmAsinNorm = cm_asin_omx2(%nz.mul(2).sub(2), %x0, %x1, %mode)
        %e   : S64        = %q.e
        %rx  : U64        = %q.w3.shl(1).bitor(%q.w2.shr(63))
        %r   : U64        = cm_asin_mhuu(cm_asin_rsqrt9(%rx), cm_asin_rsqrt2(%e))
        %qhi : CmAsinW3   = CmAsinW3 { w0: %q.w1, w1: %q.w2, w2: %q.w3 }
        %sx  : CmAsinW3   = cm_asin_mh3w(%r, %qhi)  // sqrt(1 - x^2), first try
        %hq  : CmAsinW3   = cm_asin_mh3w(%r, %sx)
        // the Newton correction: sx - sx*(sx*r - 1)/2 with a cubic term
        %h0   : U64  = %hq.w0.shr(2).bitor(%hq.w1.shl(62))
        %h1   : U64  = %hq.w1.shr(2).bitor(%hq.w2.shl(62))
        %h2sq : U64  = cm_asin_mhii(%h1.to_s64_wrap(), %h1.to_s64_wrap()).to_u64_wrap()
        %h2   : U64  = %h2sq.add_wrap(%h2sq.shr(1))
        %lk   : S64  = %e.bitand(1).add(2)
        %rk   : S64  = cm_asin_sh(64.sub(%lk)).to_s64()
        %cube : U128 = cm_asin_join(%h2.shr(%rk.to_u64()), %h2.shl(%lk.to_u64()))
        %hh   : S128 = cm_asin_join(%h1, %h0).sub_wrap(%cube).to_s128_wrap()
        // d = high part of the (unsigned sx) x (signed hh) product
        %sa   : U128        = cm_asin_join(%sx.w2, %sx.w1)
        %du   : U128        = cm_asin_mhuu128(%sa.to_s128_wrap(), %hh)
        %d    : U128        = %hh.lt(0) ? %du.sub_wrap(%sa) : %du
        %d0   : U64         = cm_asin_lo(%d.to_s128_wrap())
        %d1   : U64         = cm_asin_hi(%d)
        %sign : U64         = cm_sign_mask64(%d1)
        %s2   : U64         = %sign.shl(%lk.to_u64()).bitor(%d1.shr(%rk.to_u64()))
        %s1   : U64         = %d1.shl(%lk.to_u64()).bitor(%d0.shr(%rk.to_u64()))
        %s0   : U64         = %d0.shl(%lk.to_u64())
        %corr : CmAsinW3    = CmAsinW3 { w0: %s0, w1: %s1, w2: %s2 }
        %o    : CmAsinW3    = cm_asin_sub3(%sx, %corr)
        %res  : CmAsinRoot3 = CmAsinRoot3 { w0: %o.w0, w1: %o.w1, w2: %o.w2, e: %e }
        return(%res)

/// The fast path's reduced argument x*sqrt(1 - s_j^2) - s_j*sqrt(1 - x^2) to three words, for the
/// 128-bit mantissa xa, nz = 0x3fff - exponent, the table point j and sqrt(1 - x^2) in %root.
routine cm_asin_reduce3(%xa: U128, %nz: S64, %j: U64, %root: CmAsinRoot3) -> CmAsinW3
    block entry():
        %xs    : U128     = %xa.shr(cm_asin_sh(%nz).to_s64_wrap().to_u128())
        %cth   : Ptr<U64> = CM_ASIN_CTH.to_ptr()
        %cos_j : CmAsinW3 = cm_asin_load3(%cth, %j.mul(5).add(2))
        %p     : CmAsinW3 = cm_asin_mh3d(cm_asin_lo(%xs.to_s128_wrap()), cm_asin_hi(%xs), %cos_j)
        %pth   : Ptr<U64> = CM_ASIN_PTH.to_ptr()
        %sin_j : U64      = %pth[%j].load()
        %sp    : S64      = 43.sub(%root.e.shr(1))
        %root3 : CmAsinW3 = CmAsinW3 { w0: %root.w0, w1: %root.w1, w2: %root.w2 }
        %up    : Bool     = %sp.ge(0)
        branch %up ? scaled_up(%p, %sin_j, %sp, %root3) : scaled_down(%p, %sin_j, %sp, %root3)

    block scaled_up(%p: CmAsinW3, %sin_j: U64, %sp: S64, %root3: CmAsinW3):
        %sx : CmAsinW3 = cm_asin_mh3w(%sin_j.shl(cm_asin_sh(%sp)), %root3)
        %d  : CmAsinW3 = cm_asin_sub3(%p, %sx)
        return(%d)

    block scaled_down(%p: CmAsinW3, %sin_j: U64, %sp: S64, %root3: CmAsinW3):
        %m   : CmAsinW3 = cm_asin_mh3w(%sin_j, %root3)
        %rk  : S64      = cm_asin_sh(0.sub(%sp)).to_s64()
        %lk  : S64      = cm_asin_sh(%sp).to_s64()
        %sx0 : U64      = %m.w0.shr(%rk.to_u64()).bitor(%m.w1.shl(%lk.to_u64()))
        %sx1 : U64      = %m.w1.shr(%rk.to_u64()).bitor(%m.w2.shl(%lk.to_u64()))
        %sx2 : U64      = %m.w2.shr(%rk.to_u64())
        %sx  : CmAsinW3 = CmAsinW3 { w0: %sx0, w1: %sx1, w2: %sx2 }
        %d   : CmAsinW3 = cm_asin_sub3(%p, %sx)
        return(%d)

/// The top 128 bits of a three-word value shifted left by its leading zeros nz (the C code's
/// shift by 0 - nz: nz = 0 would OR the words, as in the original).
routine cm_asin_top128(%d: CmAsinW3, %nz: S64) -> U128
    block entry():
        %l  : S64  = cm_asin_sh(%nz).to_s64()
        %r  : S64  = cm_asin_sh(0.sub(%nz)).to_s64()
        %hi : U64  = %d.w2.shl(%l.to_u64()).bitor(%d.w1.shr(%r.to_u64()))
        %lo : U64  = %d.w1.shl(%l.to_u64()).bitor(%d.w0.shr(%r.to_u64()))
        %t  : U128 = cm_asin_join(%hi, %lo)
        return(%t)

/// The fast path's odd polynomial part t^3*P(t^2) for the normalized t, with the shift s2 that
/// aligns t^2.
routine cm_asin_fast_poly(%t: U128, %s2: S64) -> U128
    block entry():
        %t2_full  : U128     = cm_asin_sqrhu128(%t.to_s128_wrap())
        %t3       : U128     = cm_asin_mhuu128(%t.to_s128_wrap(), %t2_full.to_s128_wrap())
        %in_range : Bool     = %s2.lt(128)
        %t2_shift : U128     = %t2_full.shr(cm_asin_sh7(%s2))
        %t2       : U128     = %in_range ? %t2_shift : 0
        %t2h      : U64      = cm_asin_hi(%t2)
        %c        : Ptr<U64> = CM_ASIN_C.to_ptr()
        %c18      : U64      = %c[18].load()
        %c16      : U64      = %c[16].load()
        %c14      : U64      = %c[14].load()
        %c12      : U64      = %c[12].load()
        %c10      : U64      = %c[10].load()
        %c11      : U64      = %c[11].load()
        // the small high coefficients take one word each
        %f16 : U64  = %c16.add_wrap(cm_asin_mhuu(%t2h, %c18))
        %f14 : U64  = %c14.add_wrap(cm_asin_mhuu(%t2h, %f16))
        %f12 : U64  = %c12.add_wrap(cm_asin_mhuu(%t2h, %f14))
        %f10 : U128 = cm_asin_join(%c11, %c10.add_wrap(cm_asin_mhuu(%t2h, %f12)))
        jump horner(%t2, %t3, %f10, 8)

    // f = C[i] + t^2*f for i = 8, 6, 4, 2, 0, two words per coefficient
    block horner(%t2: U128, %t3: U128, %f: U128, %i: U64):
        %c    : Ptr<U64> = CM_ASIN_C.to_ptr()
        %c_lo : U64      = %c[%i].load()
        %c_hi : U64      = %c[%i.add(1)].load()
        %next : U128     = cm_asin_join(%c_hi,
                %c_lo).add_wrap(cm_asin_mhuu128(%t2.to_s128_wrap(), %f.to_s128_wrap()))
        %done : Bool     = %i.eq(0)
        branch %done ? finish(%t3, %next) : horner(%t2, %t3, %next, %i.sub(2))

    block finish(%t3: U128, %f: U128):
        %r : U128 = cm_asin_mhuu128(%t3.to_s128_wrap(), %f.to_s128_wrap())
        return(%r)

/// A 128-bit f placed as the top two of three words and shifted right by sf (the fast path's
/// alignment of the polynomial part). sf = 0 ORs words, as in the original.
routine cm_asin_shift_poly3(%f: U128, %sf: S64) -> CmAsinW3
    block entry():
        %f2      : U64      = cm_asin_hi(%f)
        %f1      : U64      = cm_asin_lo(%f.to_s128_wrap())
        %s       : S64      = cm_asin_sh(%sf).to_s64()
        %in_word : Bool     = %sf.lt(64)
        %in_one  : Bool     = %sf.lt(128)
        %in_two  : Bool     = %sf.lt(192)
        %gone    : CmAsinW3 = CmAsinW3 { w0: 0, w1: 0, w2: 0 }
        when:
            %in_word -> within_word(%f1, %f2, %s)
            %in_one  -> one_word(%f1, %f2, %s)
            %in_two  -> two_words(%f2, %s)
            else     -> return(%gone)

    block within_word(%f1: U64, %f2: U64, %s: S64):
        %back : S64      = cm_asin_sh(0.sub(%s)).to_s64()
        %w0   : U64      = %f1.shl(%back.to_u64())
        %w1   : U64      = %f1.shr(%s.to_u64()).bitor(%f2.shl(%back.to_u64()))
        %w2   : U64      = %f2.shr(%s.to_u64())
        %r    : CmAsinW3 = CmAsinW3 { w0: %w0, w1: %w1, w2: %w2 }
        return(%r)

    block one_word(%f1: U64, %f2: U64, %s: S64):
        %back : S64      = cm_asin_sh(%s.bitnot()).to_s64()
        %w0   : U64      = %f1.shr(%s.to_u64()).bitor(%f2.shl(1).shl(%back.to_u64()))
        %w1   : U64      = %f2.shr(%s.to_u64())
        %r    : CmAsinW3 = CmAsinW3 { w0: %w0, w1: %w1, w2: 0 }
        return(%r)

    block two_words(%f2: U64, %s: S64):
        %r : CmAsinW3 = CmAsinW3 { w0: %f2.shr(%s.to_u64()), w1: 0, w2: 0 }
        return(%r)

// -- five-word arithmetic of the accurate path ---------------------------------

/// A five-word value shifted right by k bits, or left by -k bits (the C shrn and shln).
routine cm_asin_shift5(%a: CmAsinW5, %k: S64) -> CmAsinW5
    block entry():
        %gone : Bool     = %k.ge(320).bitor(%k.le(-320))
        %zero : CmAsinW5 = CmAsinW5 { w0: 0, w1: 0, w2: 0, w3: 0, w4: 0 }
        branch %gone ? return(%zero) : window(%a, %k)

    // the words sit at 5..9 of a zero-padded buffer; word i of the result is the 64 bits at
    // bit 64*i + k of the value
    block window(%a: CmAsinW5, %k: S64):
        claim %buf : Ptr<Array<S64, 16>>
        %words : Ptr<U64> = %buf.cast<U64>()
        %words.zeroinit(16)
        %words[5].store(%a.w0)
        %words[6].store(%a.w1)
        %words[7].store(%a.w2)
        %words[8].store(%a.w3)
        %words[9].store(%a.w4)
        %base : S64      = %k.add(320)
        %w0   : U64      = limbs_bits64(%words, %base)
        %w1   : U64      = limbs_bits64(%words, %base.add(64))
        %w2   : U64      = limbs_bits64(%words, %base.add(128))
        %w3   : U64      = limbs_bits64(%words, %base.add(192))
        %w4   : U64      = limbs_bits64(%words, %base.add(256))
        %r    : CmAsinW5 = CmAsinW5 { w0: %w0, w1: %w1, w2: %w2, w3: %w3, w4: %w4 }
        return(%r)

/// The leading zeros of a five-word value, or %fallback when it is zero.
routine cm_asin_clz5(%a: CmAsinW5, %fallback: S64) -> S64
    block entry():
        %has4 : Bool = %a.w4.ne(0)
        %has3 : Bool = %a.w3.ne(0)
        %has2 : Bool = %a.w2.ne(0)
        %has1 : Bool = %a.w1.ne(0)
        %has0 : Bool = %a.w0.ne(0)
        %z4   : S64  = %a.w4.leading_zeros().to_s64()
        %z3   : S64  = %a.w3.leading_zeros().to_s64().add(64)
        %z2   : S64  = %a.w2.leading_zeros().to_s64().add(128)
        %z1   : S64  = %a.w1.leading_zeros().to_s64().add(192)
        %z0   : S64  = %a.w0.leading_zeros().to_s64().add(256)
        when:
            %has4 -> return(%z4)
            %has3 -> return(%z3)
            %has2 -> return(%z2)
            %has1 -> return(%z1)
            %has0 -> return(%z0)
            else  -> return(%fallback)

/// Approximate high five words of the five-word product a*b (the C mhu5u5u5(o, b, a)). Two
/// carry chains run side by side: c0 through the row sums t, c1 through the accumulator o.
routine cm_asin_mh5(%b: CmAsinW5, %a: CmAsinW5) -> CmAsinW5
    block entry():
        // row of b1, with the top of a4*b0
        %a4b0 : U128        = cm_asin_mul(%a.w4, %b.w0)
        %a3b1 : U128        = cm_asin_mul(%a.w3, %b.w1)
        %a4b1 : U128        = cm_asin_mul(%a.w4, %b.w1)
        %t1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b1.to_s128_wrap()), cm_asin_hi(%a3b1), 0)
        %o10  : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4b0), %t1.sum, 0)
        %t1b  : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4b1), 0, %t1.carry)
        %o11  : CmAsinCarry = cm_asin_ac(%t1b.sum, 0, %o10.carry)
        // row of b2
        %a2b2 : U128        = cm_asin_mul(%a.w2, %b.w2)
        %a3b2 : U128        = cm_asin_mul(%a.w3, %b.w2)
        %a4b2 : U128        = cm_asin_mul(%a.w4, %b.w2)
        %t2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b2.to_s128_wrap()), cm_asin_hi(%a2b2), 0)
        %o20  : CmAsinCarry = cm_asin_ac(%o10.sum, %t2.sum, 0)
        %t2b  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b2.to_s128_wrap()), cm_asin_hi(%a3b2),
                %t2.carry)
        %o21  : CmAsinCarry = cm_asin_ac(%o11.sum, %t2b.sum, %o20.carry)
        %t2c  : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4b2), 0, %t2b.carry)
        %o22  : CmAsinCarry = cm_asin_ac(%t2c.sum, 0, %o21.carry)
        // row of b3
        %a1b3 : U128        = cm_asin_mul(%a.w1, %b.w3)
        %a2b3 : U128        = cm_asin_mul(%a.w2, %b.w3)
        %a3b3 : U128        = cm_asin_mul(%a.w3, %b.w3)
        %a4b3 : U128        = cm_asin_mul(%a.w4, %b.w3)
        %t3   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b3.to_s128_wrap()), cm_asin_hi(%a1b3), 0)
        %o30  : CmAsinCarry = cm_asin_ac(%o20.sum, %t3.sum, 0)
        %t3b  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b3.to_s128_wrap()), cm_asin_hi(%a2b3),
                %t3.carry)
        %o31  : CmAsinCarry = cm_asin_ac(%o21.sum, %t3b.sum, %o30.carry)
        %t3c  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b3.to_s128_wrap()), cm_asin_hi(%a3b3),
                %t3b.carry)
        %o32  : CmAsinCarry = cm_asin_ac(%o22.sum, %t3c.sum, %o31.carry)
        %t3d  : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4b3), 0, %t3c.carry)
        %o33  : CmAsinCarry = cm_asin_ac(%t3d.sum, 0, %o32.carry)
        // row of b4
        %a0b4 : U128        = cm_asin_mul(%a.w0, %b.w4)
        %a1b4 : U128        = cm_asin_mul(%a.w1, %b.w4)
        %a2b4 : U128        = cm_asin_mul(%a.w2, %b.w4)
        %a3b4 : U128        = cm_asin_mul(%a.w3, %b.w4)
        %a4b4 : U128        = cm_asin_mul(%a.w4, %b.w4)
        %t4   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a1b4.to_s128_wrap()), cm_asin_hi(%a0b4), 0)
        %o40  : CmAsinCarry = cm_asin_ac(%o30.sum, %t4.sum, 0)
        %t4b  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b4.to_s128_wrap()), cm_asin_hi(%a1b4),
                %t4.carry)
        %o41  : CmAsinCarry = cm_asin_ac(%o31.sum, %t4b.sum, %o40.carry)
        %t4c  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b4.to_s128_wrap()), cm_asin_hi(%a2b4),
                %t4b.carry)
        %o42  : CmAsinCarry = cm_asin_ac(%o32.sum, %t4c.sum, %o41.carry)
        %t4d  : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b4.to_s128_wrap()), cm_asin_hi(%a3b4),
                %t4c.carry)
        %o43  : CmAsinCarry = cm_asin_ac(%o33.sum, %t4d.sum, %o42.carry)
        %t4e  : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4b4), 0, %t4d.carry)
        %o44  : CmAsinCarry = cm_asin_ac(%t4e.sum, 0, %o43.carry)
        %r    : CmAsinW5    = CmAsinW5 { w0: %o40.sum, w1: %o41.sum, w2: %o42.sum, w3: %o43.sum,
                w4: %o44.sum }
        return(%r)

/// High five words of the product of a two-word b and a five-word a (the C mhu5u2u5).
routine cm_asin_mh5d(%b0: U64, %b1: U64, %a: CmAsinW5) -> CmAsinW5
    block entry():
        // row of b0
        %a1b0 : U128        = cm_asin_mul(%a.w1, %b0)
        %a2b0 : U128        = cm_asin_mul(%a.w2, %b0)
        %a3b0 : U128        = cm_asin_mul(%a.w3, %b0)
        %a4b0 : U128        = cm_asin_mul(%a.w4, %b0)
        %o0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b0.to_s128_wrap()), cm_asin_hi(%a1b0), 0)
        %o1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b0.to_s128_wrap()), cm_asin_hi(%a2b0),
                %o0.carry)
        %o2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b0.to_s128_wrap()), cm_asin_hi(%a3b0),
                %o1.carry)
        %o3   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a4b0), %o2.carry)
        // row of b1, added in
        %a0b1 : U128        = cm_asin_mul(%a.w0, %b1)
        %a1b1 : U128        = cm_asin_mul(%a.w1, %b1)
        %a2b1 : U128        = cm_asin_mul(%a.w2, %b1)
        %a3b1 : U128        = cm_asin_mul(%a.w3, %b1)
        %a4b1 : U128        = cm_asin_mul(%a.w4, %b1)
        %t0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a1b1.to_s128_wrap()), cm_asin_hi(%a0b1), 0)
        %s0   : CmAsinCarry = cm_asin_ac(%o0.sum, %t0.sum, 0)
        %t1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b1.to_s128_wrap()), cm_asin_hi(%a1b1),
                %t0.carry)
        %s1   : CmAsinCarry = cm_asin_ac(%o1.sum, %t1.sum, %s0.carry)
        %t2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b1.to_s128_wrap()), cm_asin_hi(%a2b1),
                %t1.carry)
        %s2   : CmAsinCarry = cm_asin_ac(%o2.sum, %t2.sum, %s1.carry)
        %t3   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b1.to_s128_wrap()), cm_asin_hi(%a3b1),
                %t2.carry)
        %s3   : CmAsinCarry = cm_asin_ac(%o3.sum, %t3.sum, %s2.carry)
        %t4   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a4b1), %t3.carry)
        %s4   : CmAsinCarry = cm_asin_ac(0, %t4.sum, %s3.carry)
        %r    : CmAsinW5    = CmAsinW5 { w0: %s0.sum, w1: %s1.sum, w2: %s2.sum, w3: %s3.sum,
                w4: %s4.sum }
        return(%r)

/// High five words of the product of a word b0 and a five-word a (the C mhu5u1u5).
routine cm_asin_mh5w(%b0: U64, %a: CmAsinW5) -> CmAsinW5
    block entry():
        %a0b0 : U128        = cm_asin_mul(%a.w0, %b0)
        %a1b0 : U128        = cm_asin_mul(%a.w1, %b0)
        %a2b0 : U128        = cm_asin_mul(%a.w2, %b0)
        %a3b0 : U128        = cm_asin_mul(%a.w3, %b0)
        %a4b0 : U128        = cm_asin_mul(%a.w4, %b0)
        %r0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a1b0.to_s128_wrap()), cm_asin_hi(%a0b0), 0)
        %r1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b0.to_s128_wrap()), cm_asin_hi(%a1b0),
                %r0.carry)
        %r2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b0.to_s128_wrap()), cm_asin_hi(%a2b0),
                %r1.carry)
        %r3   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b0.to_s128_wrap()), cm_asin_hi(%a3b0),
                %r2.carry)
        %r4   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a4b0), %r3.carry)
        %r    : CmAsinW5    = CmAsinW5 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum, w3: %r3.sum,
                w4: %r4.sum }
        return(%r)

/// The full product of a word b0 and a four-word a (the C mu5u1u4).
routine cm_asin_mu5(%b0: U64, %a: CmAsinW4) -> CmAsinW5
    block entry():
        %a0b0 : U128        = cm_asin_mul(%a.w0, %b0)
        %a1b0 : U128        = cm_asin_mul(%a.w1, %b0)
        %a2b0 : U128        = cm_asin_mul(%a.w2, %b0)
        %a3b0 : U128        = cm_asin_mul(%a.w3, %b0)
        %r1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a1b0.to_s128_wrap()), cm_asin_hi(%a0b0), 0)
        %r2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b0.to_s128_wrap()), cm_asin_hi(%a1b0),
                %r1.carry)
        %r3   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b0.to_s128_wrap()), cm_asin_hi(%a2b0),
                %r2.carry)
        %r4   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a3b0), %r3.carry)
        %w0   : U64         = cm_asin_lo(%a0b0.to_s128_wrap())
        %r    : CmAsinW5    = CmAsinW5 { w0: %w0, w1: %r1.sum, w2: %r2.sum, w3: %r3.sum,
                w4: %r4.sum }
        return(%r)

/// The full product of a word b0 and a five-word a (the C mu6u1u5).
routine cm_asin_mu6(%b0: U64, %a: CmAsinW5) -> CmAsinW6
    block entry():
        %a0b0 : U128        = cm_asin_mul(%a.w0, %b0)
        %a1b0 : U128        = cm_asin_mul(%a.w1, %b0)
        %a2b0 : U128        = cm_asin_mul(%a.w2, %b0)
        %a3b0 : U128        = cm_asin_mul(%a.w3, %b0)
        %a4b0 : U128        = cm_asin_mul(%a.w4, %b0)
        %r1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a1b0.to_s128_wrap()), cm_asin_hi(%a0b0), 0)
        %r2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b0.to_s128_wrap()), cm_asin_hi(%a1b0),
                %r1.carry)
        %r3   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3b0.to_s128_wrap()), cm_asin_hi(%a2b0),
                %r2.carry)
        %r4   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4b0.to_s128_wrap()), cm_asin_hi(%a3b0),
                %r3.carry)
        %r5   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a4b0), %r4.carry)
        %w0   : U64         = cm_asin_lo(%a0b0.to_s128_wrap())
        %r    : CmAsinW6    = CmAsinW6 { w0: %w0, w1: %r1.sum, w2: %r2.sum, w3: %r3.sum,
                w4: %r4.sum, w5: %r5.sum }
        return(%r)

/// Approximate high five words of the square of a five-word value (the C sqrhu5).
routine cm_asin_sqrh5(%a: CmAsinW5) -> CmAsinW5
    block entry():
        // the cross products, once
        %a4a0 : U128        = cm_asin_mul(%a.w4, %a.w0)
        %a3a1 : U128        = cm_asin_mul(%a.w3, %a.w1)
        %o0a  : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4a0), cm_asin_hi(%a3a1), 0)
        %a4a1 : U128        = cm_asin_mul(%a.w4, %a.w1)
        %a3a2 : U128        = cm_asin_mul(%a.w3, %a.w2)
        %t0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4a1.to_s128_wrap()),
                cm_asin_lo(%a3a2.to_s128_wrap()), 0)
        %o0b  : CmAsinCarry = cm_asin_ac(%o0a.sum, %t0.sum, %o0a.carry)
        %t1   : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a4a1), cm_asin_hi(%a3a2), %t0.carry)
        %o1a  : CmAsinCarry = cm_asin_ac(%o0a.carry, %t1.sum, %o0b.carry)
        %a4a2 : U128        = cm_asin_mul(%a.w4, %a.w2)
        %o1b  : CmAsinCarry = cm_asin_ac(%o1a.sum, cm_asin_lo(%a4a2.to_s128_wrap()), %o1a.carry)
        %a4a3 : U128        = cm_asin_mul(%a.w4, %a.w3)
        %t2   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a4a3.to_s128_wrap()), cm_asin_hi(%a4a2),
                %t1.carry)
        %o2   : CmAsinCarry = cm_asin_ac(0, %t2.sum, %o1b.carry)
        %o3   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a4a3), %t2.carry)
        // doubled
        %d0 : CmAsinCarry = cm_asin_ac(%o0b.sum, %o0b.sum, 0)
        %d1 : CmAsinCarry = cm_asin_ac(%o1b.sum, %o1b.sum, %d0.carry)
        %d2 : CmAsinCarry = cm_asin_ac(%o2.sum, %o2.sum, %d1.carry)
        %d3 : CmAsinCarry = cm_asin_ac(%o3.sum, %o3.sum, %d2.carry)
        // plus the squares
        %a2a2 : U128        = cm_asin_mul(%a.w2, %a.w2)
        %a3a3 : U128        = cm_asin_mul(%a.w3, %a.w3)
        %a4a4 : U128        = cm_asin_mul(%a.w4, %a.w4)
        %q0   : CmAsinCarry = cm_asin_ac(%d0.sum, cm_asin_hi(%a2a2), 0)
        %q1   : CmAsinCarry = cm_asin_ac(%d1.sum, cm_asin_lo(%a3a3.to_s128_wrap()), %q0.carry)
        %q2   : CmAsinCarry = cm_asin_ac(%d2.sum, cm_asin_hi(%a3a3), %q1.carry)
        %q3   : CmAsinCarry = cm_asin_ac(%d3.sum, cm_asin_lo(%a4a4.to_s128_wrap()), %q2.carry)
        %q4   : CmAsinCarry = cm_asin_ac(%d3.carry, cm_asin_hi(%a4a4), %q3.carry)
        %r    : CmAsinW5    = CmAsinW5 { w0: %q0.sum, w1: %q1.sum, w2: %q2.sum, w3: %q3.sum,
                w4: %q4.sum }
        return(%r)

/// Approximate high four words of the square of a four-word value (the C sqrhu4).
routine cm_asin_sqrh4(%a: CmAsinW4) -> CmAsinW4
    block entry():
        %a2a1 : U128        = cm_asin_mul(%a.w2, %a.w1)
        %a3a0 : U128        = cm_asin_mul(%a.w3, %a.w0)
        %a3a1 : U128        = cm_asin_mul(%a.w3, %a.w1)
        %a3a2 : U128        = cm_asin_mul(%a.w3, %a.w2)
        %r0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3a1.to_s128_wrap()), cm_asin_hi(%a3a0), 0)
        %r1   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a3a2.to_s128_wrap()), cm_asin_hi(%a3a1),
                %r0.carry)
        %r2   : CmAsinCarry = cm_asin_ac(0, cm_asin_hi(%a3a2), %r1.carry)
        %s0   : CmAsinCarry = cm_asin_ac(%r0.sum, cm_asin_hi(%a2a1), 0)
        %s1   : CmAsinCarry = cm_asin_ac(%r1.sum, 0, %s0.carry)
        %s2   : CmAsinCarry = cm_asin_ac(%r2.sum, 0, %s1.carry)
        // doubled
        %d0 : CmAsinCarry = cm_asin_ac(%s0.sum, %s0.sum, 0)
        %d1 : CmAsinCarry = cm_asin_ac(%s1.sum, %s1.sum, %d0.carry)
        %d2 : CmAsinCarry = cm_asin_ac(%s2.sum, %s2.sum, %d1.carry)
        // plus the squares
        %a2a2 : U128        = cm_asin_mul(%a.w2, %a.w2)
        %a3a3 : U128        = cm_asin_mul(%a.w3, %a.w3)
        %q0   : CmAsinCarry = cm_asin_ac(%d0.sum, cm_asin_lo(%a2a2.to_s128_wrap()), 0)
        %q1   : CmAsinCarry = cm_asin_ac(%d1.sum, cm_asin_hi(%a2a2), %q0.carry)
        %q2   : CmAsinCarry = cm_asin_ac(%d2.sum, cm_asin_lo(%a3a3.to_s128_wrap()), %q1.carry)
        %q3   : CmAsinCarry = cm_asin_ac(%d2.carry, cm_asin_hi(%a3a3), %q2.carry)
        %r    : CmAsinW4    = CmAsinW4 { w0: %q0.sum, w1: %q1.sum, w2: %q2.sum, w3: %q3.sum }
        return(%r)

/// Approximate high two words of the two-word product a*b (the C mhu2u2u2(o, b, a)), as a U128.
routine cm_asin_mh2(%b: S128, %a: S128) -> U128
    block entry():
        %b0   : U64         = cm_asin_lo(%b)
        %b1   : U64         = cm_asin_hi(%b.to_u128_wrap())
        %a0   : U64         = cm_asin_lo(%a)
        %a1   : U64         = cm_asin_hi(%a.to_u128_wrap())
        %a1b0 : U128        = cm_asin_mul(%a1, %b0)
        %a0b1 : U128        = cm_asin_mul(%a0, %b1)
        %a1b1 : U128        = cm_asin_mul(%a1, %b1)
        %t0   : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a1b1.to_s128_wrap()), cm_asin_hi(%a0b1), 0)
        %o0   : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a1b0), %t0.sum, 0)
        %t1   : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a1b1), 0, %t0.carry)
        %o1   : CmAsinCarry = cm_asin_ac(%t1.sum, 0, %o0.carry)
        %r    : U128        = cm_asin_join(%o1.sum, %o0.sum)
        return(%r)

/// Approximate high three words of the three-word product a*b (the C mhu3u3u3(o, b, a)).
routine cm_asin_mh3(%b: CmAsinW3, %a: CmAsinW3) -> CmAsinW3
    block entry():
        %a1b1  : U128        = cm_asin_mul(%a.w1, %b.w1)
        %a2b0  : U128        = cm_asin_mul(%a.w2, %b.w0)
        %a0b2  : U128        = cm_asin_mul(%a.w0, %b.w2)
        %a2b1  : U128        = cm_asin_mul(%a.w2, %b.w1).add_wrap(%a2b0.shr(64))
        %a1b2  : U128        = cm_asin_mul(%a.w1, %b.w2).add_wrap(%a0b2.shr(64))
        %a2b2  : U128        = cm_asin_mul(%a.w2, %b.w2)
        %r0    : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a1b1), cm_asin_lo(%a2b1.to_s128_wrap()), 0)
        %r1    : CmAsinCarry = cm_asin_ac(cm_asin_lo(%a2b2.to_s128_wrap()), cm_asin_hi(%a2b1),
                %r0.carry)
        %r2    : CmAsinCarry = cm_asin_ac(cm_asin_hi(%a2b2), 0, %r1.carry)
        %sum   : CmAsinW3    = CmAsinW3 { w0: %r0.sum, w1: %r1.sum, w2: %r2.sum }
        %cross : CmAsinW3    = CmAsinW3 { w0: cm_asin_lo(%a1b2.to_s128_wrap()),
                w1: cm_asin_hi(%a1b2), w2: 0 }
        %r     : CmAsinW3    = cm_asin_add3(%sum, %cross)
        return(%r)

/// Approximate high four words of the four-word product a*b (the C mhu4u4u4(o, b, a)).
routine cm_asin_mh4(%b: CmAsinW4, %a: CmAsinW4) -> CmAsinW4
    block entry():
        %a3b0    : U128     = cm_asin_mul(%a.w3, %b.w0)
        %a3b2    : U128     = cm_asin_mul(%a.w3, %b.w2)
        %a2b1    : U128     = cm_asin_mul(%a.w2, %b.w1)
        %a3b1    : U128     = cm_asin_mul(%a.w3, %b.w1).add_wrap(%a2b1.shr(64))
        %a1b2    : U128     = cm_asin_mul(%a.w1, %b.w2)
        %a2b2    : U128     = cm_asin_mul(%a.w2, %b.w2).add_wrap(%a1b2.shr(64))
        %a0b3    : U128     = cm_asin_mul(%a.w0, %b.w3)
        %a1b3    : U128     = cm_asin_mul(%a.w1, %b.w3)
        %a2b3    : U128     = cm_asin_mul(%a.w2, %b.w3)
        %a3b3    : U128     = cm_asin_mul(%a.w3, %b.w3)
        %hi03    : U64      = cm_asin_hi(%a0b3)
        %hi13    : U64      = cm_asin_hi(%a1b3)
        %hi23    : U64      = cm_asin_hi(%a2b3)
        %hi33    : U64      = cm_asin_hi(%a3b3)
        %lo13    : U64      = cm_asin_lo(%a1b3.to_s128_wrap())
        %lo23    : U64      = cm_asin_lo(%a2b3.to_s128_wrap())
        %lo33    : U64      = cm_asin_lo(%a3b3.to_s128_wrap())
        %row3_hi : CmAsinW4 = CmAsinW4 { w0: %hi03, w1: %hi13, w2: %hi23, w3: %hi33 }
        %row3_lo : CmAsinW4 = CmAsinW4 { w0: %lo13, w1: %lo23, w2: %lo33, w3: 0 }
        %o3      : CmAsinW4 = cm_asin_add4(%row3_hi, %row3_lo)
        %hi30    : U64      = cm_asin_hi(%a3b0)
        %lo32    : U64      = cm_asin_lo(%a3b2.to_s128_wrap())
        %hi32    : U64      = cm_asin_hi(%a3b2)
        %col3    : CmAsinW4 = CmAsinW4 { w0: %hi30, w1: %lo32, w2: %hi32, w3: 0 }
        %o2      : CmAsinW4 = cm_asin_add4(%o3, %col3)
        %m31     : CmAsinW4 = CmAsinW4 { w0: cm_asin_lo(%a3b1.to_s128_wrap()),
                w1: cm_asin_hi(%a3b1), w2: 0, w3: 0 }
        %o1      : CmAsinW4 = cm_asin_add4(%o2, %m31)
        %m22     : CmAsinW4 = CmAsinW4 { w0: cm_asin_lo(%a2b2.to_s128_wrap()),
                w1: cm_asin_hi(%a2b2), w2: 0, w3: 0 }
        %r       : CmAsinW4 = cm_asin_add4(%o1, %m22)
        return(%r)

// -- the accurate path: sqrt(1 - x^2) and the polynomial ------------------------

/// Words 0..4 of a six-word value shifted right by 2 (the C shrn(6, a, 2), whose top word is unused).
routine cm_asin_shr6_by2(%a: CmAsinW6) -> CmAsinW5
    block entry():
        %w0 : U64      = %a.w0.shr(2).bitor(%a.w1.shl(62))
        %w1 : U64      = %a.w1.shr(2).bitor(%a.w2.shl(62))
        %w2 : U64      = %a.w2.shr(2).bitor(%a.w3.shl(62))
        %w3 : U64      = %a.w3.shr(2).bitor(%a.w4.shl(62))
        %w4 : U64      = %a.w4.shr(2).bitor(%a.w5.shl(62))
        %r  : CmAsinW5 = CmAsinW5 { w0: %w0, w1: %w1, w2: %w2, w3: %w3, w4: %w4 }
        return(%r)

/// sqrt(1 - x^2) to five words for the mantissa words x (shifted left by 15) and
/// ex = 0x3fff - exponent, with the exponent e of 1 - x^2 (the C getcos).
routine cm_asin_getcos(%ex: S64, %x0: U64, %x1: U64) -> CmAsinRoot5
    block entry():
        %q  : CmAsinNorm = cm_asin_omx2(%ex.sub(1).mul(2), %x0, %x1, 2)
        %e  : S64        = %q.e
        %eo : S64        = %e.bitand(1)
        %rx : U64        = %q.w3.shl(1).bitor(%q.w2.shr(63))
        %r  : U64        = cm_asin_mhuu(cm_asin_rsqrt9(%rx), cm_asin_rsqrt2(%e))
        %qw : CmAsinW4   = CmAsinW4 { w0: %q.w0, w1: %q.w1, w2: %q.w2, w3: %q.w3 }
        %sq : CmAsinW5   = cm_asin_mu5(%r, %qw)  // sqrt(1 - x^2), first try
        %h6 : CmAsinW5   = cm_asin_shr6_by2(cm_asin_mu6(%r, %sq))
        // h = r*sq - 1 as a small signed value; work on its magnitude
        %msk  : S64      = %h6.w4.to_s64_wrap().shr(63)
        %h    : CmAsinW5 = cm_asin_xor5(%h6, %msk.to_u64_wrap())
        %htop : CmAsinW4 = CmAsinW4 { w0: %h.w1, w1: %h.w2, w2: %h.w3, w3: %h.w4 }
        %h2   : CmAsinW4 = cm_asin_sqrh4(%htop)
        %h4s  : U128     = cm_asin_sqrhu128(cm_asin_join(%h2.w3, %h2.w2).to_s128_wrap())
        %h3b  : CmAsinW3 = CmAsinW3 { w0: %h.w2, w1: %h.w3, w2: %h.w4 }
        %h3a  : CmAsinW3 = CmAsinW3 { w0: %h2.w1, w1: %h2.w2, w2: %h2.w3 }
        %h3   : CmAsinW3 = cm_asin_mh3(%h3b, %h3a)
        // the series terms 1.5*h^2, 1.25*h^3 (up to sign), 35/32*h^4
        %m0  : CmAsinCarry = cm_asin_ac(%h2.w0, %h2.w1.shl(63).bitor(%h2.w0.shr(1)), 0)
        %m1  : CmAsinCarry = cm_asin_ac(%h2.w1, %h2.w2.shl(63).bitor(%h2.w1.shr(1)), %m0.carry)
        %m2  : CmAsinCarry = cm_asin_ac(%h2.w2, %h2.w3.shl(63).bitor(%h2.w2.shr(1)), %m1.carry)
        %m3  : CmAsinCarry = cm_asin_ac(%h2.w3, %h2.w3.shr(1), %m2.carry)
        %n0  : CmAsinCarry = cm_asin_ac(%h3.w0, %h3.w1.shl(62).bitor(%h3.w0.shr(2)), 0)
        %n1  : CmAsinCarry = cm_asin_ac(%h3.w1, %h3.w2.shl(62).bitor(%h3.w1.shr(2)), %n0.carry)
        %n2  : CmAsinCarry = cm_asin_ac(%h3.w2, %h3.w2.shr(2), %n1.carry)
        %t4u : U128        = %h4s.add_wrap(%h4s.mul_wrap(3).shr(5))
        %m   : CmAsinW5    = CmAsinW5 { w0: 0, w1: %m0.sum, w2: %m1.sum, w3: %m2.sum, w4: %m3.sum }
        %n   : CmAsinW5    = CmAsinW5 { w0: 0, w1: 0, w2: %n0.sum, w3: %n1.sum, w4: %n2.sum }
        %t4w : CmAsinW5    = CmAsinW5 { w0: 0, w1: 0, w2: 0, w3: cm_asin_lo(%t4u.to_s128_wrap()),
                w4: cm_asin_hi(%t4u) }
        %h2s : CmAsinW5    = cm_asin_shift5(%m, 62.sub(%eo))
        %h3s : CmAsinW5    = cm_asin_shift5(%n, 123.sub(%eo.mul(2)))
        %t4  : CmAsinW5    = cm_asin_shift5(%t4w, 184.sub(%eo.mul(3)))
        // the series in the magnitude of h, its odd terms flipped when h < 0
        %was_negative : Bool     = %msk.ne(0)
        %neg_1        : CmAsinW5 = cm_asin_add5(%h, %h2s)
        %neg_2        : CmAsinW5 = cm_asin_add5(%neg_1, %h3s)
        %neg_s        : CmAsinW5 = cm_asin_add5(%neg_2, %t4)
        %pos_1        : CmAsinW5 = cm_asin_sub5(%h, %h2s)
        %pos_2        : CmAsinW5 = cm_asin_add5(%pos_1, %h3s)
        %pos_s        : CmAsinW5 = cm_asin_sub5(%pos_2, %t4)
        %s            : CmAsinW5 = %was_negative ? %neg_s : %pos_s
        // sq -/+ (1 - x^2) * r * series
        %g6   : CmAsinW6    = cm_asin_mu6(%r, %s)
        %g    : CmAsinW5    = CmAsinW5 { w0: %g6.w1, w1: %g6.w2, w2: %g6.w3, w3: %g6.w4, w4: %g6.w5}
        %x2l  : CmAsinW5    = CmAsinW5 { w0: 0, w1: %q.w0, w2: %q.w1, w3: %q.w2, w4: %q.w3 }
        %prod : CmAsinW5    = cm_asin_mh5(%g, %x2l)
        %hh   : CmAsinW5    = cm_asin_shift5(%prod, 62.sub(%e.bitand(1)))
        %up   : CmAsinW5    = cm_asin_add5(%sq, %hh)
        %down : CmAsinW5    = cm_asin_sub5(%sq, %hh)
        %root : CmAsinW5    = %was_negative ? %up : %down
        %res  : CmAsinRoot5 = CmAsinRoot5 { root: %root, e: %e }
        return(%res)

/// The accurate path's reduced argument x*sqrt(1 - s_j^2) - s_j*sqrt(1 - x^2) to five words, for
/// the 128-bit mantissa xa, nz = 0x3fff - exponent, the table point j and sqrt(1 - x^2) in %root.
routine cm_asin_reduce5(%xa: U128, %nz: S64, %j: U64, %root: CmAsinRoot5) -> CmAsinW5
    block entry():
        %xs      : U128     = %xa.shr(cm_asin_sh(%nz).to_s64_wrap().to_u128())
        %cth     : Ptr<U64> = CM_ASIN_CTH.to_ptr()
        %cos_j   : CmAsinW5 = cm_asin_load5(%cth, %j.mul(5))
        %xc      : CmAsinW5 = cm_asin_mh5d(cm_asin_lo(%xs.to_s128_wrap()), cm_asin_hi(%xs), %cos_j)
        %pth     : Ptr<U64> = CM_ASIN_PTH.to_ptr()
        %sin_j   : U64      = %pth[%j].load()
        %sp      : S64      = 43.sub(%root.e.shr(1))
        %up      : Bool     = %sp.ge(0)
        %sj      : U64      = %up ? %sin_j.shl(cm_asin_sh(%sp)) : %sin_j
        %sq      : CmAsinW5 = cm_asin_mh5w(%sj, %root.root)
        %sq_down : CmAsinW5 = cm_asin_shift5(%sq, 0.sub(%sp))
        %sx      : CmAsinW5 = %up ? %sq : %sq_down
        %d       : CmAsinW5 = cm_asin_sub5(%xc, %sx)
        return(%d)

/// The accurate path's polynomial P(t^2) to five words (the C evalpoly): Horner's rule with the
/// working width growing from two to five words as the coefficients grow.
routine cm_asin_evalpoly(%t2: CmAsinW5) -> CmAsinW5
    block entry():
        %cp : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %c0 : U64      = %cp[0].load()
        %c1 : U64      = %cp[1].load()
        %c2 : U64      = %cp[2].load()
        %f0 : U64      = %c1.add_wrap(cm_asin_mhuu(%t2.w4, %c0))
        jump two_words(%t2, cm_asin_join(%c2, %f0), 3)

    block two_words(%t2: CmAsinW5, %f: U128, %k: U64):
        %done : Bool = %k.eq(15)
        branch %done ? widen3(%t2, %f) : two_words_step(%t2, %f, %k)

    block two_words_step(%t2: CmAsinW5, %f: U128, %k: U64):
        %cp   : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %c_lo : U64      = %cp[%k].load()
        %c_hi : U64      = %cp[%k.add(1)].load()
        %c    : U128     = cm_asin_join(%c_hi, %c_lo)
        %p    : U128     = cm_asin_mh2(%f.to_s128_wrap(),
                cm_asin_join(%t2.w4, %t2.w3).to_s128_wrap())
        jump two_words(%t2, %c.add_wrap(%p), %k.add(2))

    block widen3(%t2: CmAsinW5, %f: U128):
        %cp  : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %top : U64      = %cp[15].load()
        %f3  : CmAsinW3 = CmAsinW3 { w0: cm_asin_lo(%f.to_s128_wrap()), w1: cm_asin_hi(%f),
                w2: %top }
        jump three_words(%t2, %f3, 16)

    block three_words(%t2: CmAsinW5, %f: CmAsinW3, %k: U64):
        %done : Bool = %k.eq(31)
        branch %done ? widen4(%t2, %f) : three_words_step(%t2, %f, %k)

    block three_words_step(%t2: CmAsinW5, %f: CmAsinW3, %k: U64):
        %cp : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %c  : CmAsinW3 = cm_asin_load3(%cp, %k)
        %a  : CmAsinW3 = CmAsinW3 { w0: %t2.w2, w1: %t2.w3, w2: %t2.w4 }
        %p  : CmAsinW3 = cm_asin_mh3(%f, %a)
        jump three_words(%t2, cm_asin_add3(%c, %p), %k.add(3))

    block widen4(%t2: CmAsinW5, %f: CmAsinW3):
        %cp  : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %top : U64      = %cp[31].load()
        %f4  : CmAsinW4 = CmAsinW4 { w0: %f.w0, w1: %f.w1, w2: %f.w2, w3: %top }
        jump four_words(%t2, %f4, 32)

    block four_words(%t2: CmAsinW5, %f: CmAsinW4, %k: U64):
        %done : Bool = %k.eq(56)
        branch %done ? widen5(%t2, %f) : four_words_step(%t2, %f, %k)

    block four_words_step(%t2: CmAsinW5, %f: CmAsinW4, %k: U64):
        %cp : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %c  : CmAsinW4 = cm_asin_load4(%cp, %k)
        %a  : CmAsinW4 = CmAsinW4 { w0: %t2.w1, w1: %t2.w2, w2: %t2.w3, w3: %t2.w4 }
        %p  : CmAsinW4 = cm_asin_mh4(%f, %a)
        jump four_words(%t2, cm_asin_add4(%c, %p), %k.add(4))

    block widen5(%t2: CmAsinW5, %f: CmAsinW4):
        %cp  : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %top : U64      = %cp[56].load()
        %f5  : CmAsinW5 = CmAsinW5 { w0: %f.w0, w1: %f.w1, w2: %f.w2, w3: %f.w3, w4: %top }
        jump five_words(%t2, %f5, 57)

    block five_words(%t2: CmAsinW5, %f: CmAsinW5, %k: U64):
        %done : Bool = %k.eq(82)
        branch %done ? return(%f) : continue
        %cp : Ptr<U64> = CM_ASIN_CP.to_ptr()
        %c  : CmAsinW5 = cm_asin_load5(%cp, %k)
        %p  : CmAsinW5 = cm_asin_mh5(%f, %t2)
        jump five_words(%t2, cm_asin_add5(%c, %p), %k.add(5))

/// t^3*P(t^2) to five words for the normalized t with nz leading zeros (the accurate path's
/// odd polynomial part, before alignment).
routine cm_asin_poly5(%t: CmAsinW5, %nz: S64) -> CmAsinW5
    block entry():
        %t2_full : CmAsinW5 = cm_asin_sqrh5(%t)
        %t3      : CmAsinW5 = cm_asin_mh5(%t, %t2_full)
        %t2      : CmAsinW5 = cm_asin_shift5(%t2_full, %nz.sub(6).mul(2).sub(1))
        %p       : CmAsinW5 = cm_asin_evalpoly(%t2)
        %r       : CmAsinW5 = cm_asin_mh5(%t3, %p)
        return(%r)

// -- tables --------------------------------------------------------------------
// CM_ASIN_RSQRT: 64 rows of 4 coefficients of the cubic 1/sqrt approximation (rsqrt9)
// CM_ASIN_STH:   rounded sin(pi/2/72*j) in the format of the range reduction
// CM_ASIN_PTH:   rounded sin(pi/2/72*j)
// CM_ASIN_CTH:   sqrt(1 - PTH[j]^2), five words per row
// CM_ASIN_IND:   the table index of the range reduction
// CM_ASIN_C:     the fast polynomial, two words per coefficient
// CM_ASIN_CP:    the accurate polynomial, coefficients of growing width packed back to back

