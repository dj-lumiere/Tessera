// Tessera stdlib: the shared engine of the correctly rounded F128 atan and atan2
//
// Ported from CORE-MATH, src/binary128/atan/atanq.c and src/binary128/atan2/atan2q.c via
// RazorForge's B128AtanShared.rf. The two C files carry identical integer helpers, tables and
// series kernels; they live here once, and atan.tess / atan2.tess keep only their own argument
// reduction and reconstruction.
// Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// Only the round-to-nearest path of the original is kept (no rounding-mode probe, errno or
// exception flags). Everything runs on integers: the reduced argument is kn / kd × 2^-dn, a
// 128-bit numerator over a normalized denominator; the fast path evaluates the arc tangent
// series in 128-bit words, and the accurate path, taken when the fast result lies too close to a
// rounding boundary, in up to 8 64-bit limbs (an Array<S64, 8>, limb 0 least significant). All
// limbs and words are read as unsigned.

module Standard::Core

/// The reduced argument: kn / (kd2:kd1:kd0) × 2^-dn = (b/a - t) / (1 + b/a × t) against the
/// table angle atan(t), t = TN[isct] / 2^15. g says the ratio was inverted (|arg| >= 1), and zero
/// (atan2 only) that one coordinate is zero, so there is nothing to reduce.
record CmAtanReduction
    zero : Bool
    g    : Bool
    isct : USize
    dn   : S64
    kn   : U128
    kd0  : S64
    kd1  : U64
    kd2  : U64

/// A 192-bit fixed-point number: top holds bits 191..128, low bits 127..0.
record CmAtanU192
    top : U64
    low : U128

/// A fast-path result: the magnitude bits of the F128, and whether it lies too close to a
/// rounding boundary to trust (then the accurate path decides).
record CmAtanRounded
    hard : Bool
    bits : U128

/// A 128-bit word normalized so its top bit is set, and the left shift that took.
record CmAtanNorm
    kn    : U128
    shift : S64

// -- word helpers ----------------------------------------------------------------

routine cm_atan_join(hi: U64, lo: U64) -> U128
    block entry():
        r : U128 = hi.to<U128>().shl(64).bitor(lo.to<U128>())
        return(r)

/// the full 64 × 64 -> 128-bit product
routine cm_atan_mul(a: U64, b: U64) -> U128
    block entry():
        r : U128 = a.to<U128>().mul_wrap(b.to<U128>())
        return(r)

/// the high 128 bits of the 64 × 128-bit product y × x
routine cm_atan_mul_high64x128(y: U64, x: U128) -> U128
    block entry():
        xy0 : U128 = cm_atan_mul(x.to_wrap<U64>(), y)
        xy1 : U128 = cm_atan_mul(x.shr(64).to<U64>(), y)
        r   : U128 = xy1.add_wrap(xy0.shr(64))
        return(r)

/// the approximate high 128 bits of a² (the low × low product is dropped)
routine cm_atan_square_high(a: U128) -> U128
    block entry():
        a1    : U64  = a.shr(64).to<U64>()
        cross : U128 = cm_atan_mul(a1, a.to_wrap<U64>()).shr(64)
        r     : U128 = cm_atan_mul(a1, a1).add_wrap(cross).add_wrap(cross)
        return(r)

/// the approximate high 128 bits of the 128 × 128-bit product
routine cm_atan_mul_high256(a: U128, b: U128) -> U128
    block entry():
        a0   : U64  = a.to_wrap<U64>()
        a1   : U64  = a.shr(64).to<U64>()
        b0   : U64  = b.to_wrap<U64>()
        b1   : U64  = b.shr(64).to<U64>()
        a1b0 : U128 = cm_atan_mul(a1, b0).shr(64)
        a0b1 : U128 = cm_atan_mul(a0, b1).shr(64)
        r    : U128 = cm_atan_mul(a1, b1).add_wrap(a1b0).add_wrap(a0b1)
        return(r)

/// 2^255 / kd rounded to 128 bits, for a normalized kd (top bit set): a 64-bit quotient refined
/// by one Newton step.
routine cm_atan_reciprocal(kd: U128) -> U128
    block entry():
        kdh : U64  = kd.shr(64).to<U64>()
        kdl : U128 = kd.bitand(0xFFFFFFFFFFFFFFFF)
        // r = 2^127 / kdh cut to 64 bits: all ones when the quotient is 2^64
        power  : Bool = kdh.eq(0x8000000000000000)
        two127 : U128 = 0x80000000000000000000000000000000
        quot   : U128 = two127.div(kdh.to<U128>())
        r      : U64  = power
            ? U64.MAX
            : quot.to_wrap<U64>()
        rr     : U128 = r.to<U128>()
        hl     : U128 = kdl.mul_wrap(rr)
        hh_raw : S128 = kdh.to<U128>().mul_wrap(rr).add_wrap(hl.shr(64)).to_wrap<S128>()
        hl_top : S128 = hl.to_wrap<U64>().shr(7).to<S128>()
        hh     : S128 = hh_raw.shl(57).bitor(hl_top)
        hh_neg : Bool = hh.shr(92).to<S64>().lt(0)
        corr   : U128 = hh_neg
            ? rr.shl(64)
            : 0
        dr     : U128 = cm_atan_mul_high64x128(r, hh.to_wrap<U128>()).sub_wrap(corr)
        result : U128 = rr.shl(64).sub_wrap(cm_sar128(dr, 56))
        return(result)

/// class of a sign-stripped binary128: 0 a number, 1 infinity, 2 signaling NaN, 3 quiet NaN
routine cm_atan_class(hi: U64, lo: U64) -> S64
    block entry():
        rest  : Bool = hi.shl(32).bitor(lo).ne(0)
        t     : U64  = hi.shr(32).bitor(rest.to<U64>())
        inf   : S64  = t.ge(0x7FFF0000).to<S64>()
        nan   : S64  = t.ge(0x7FFF0001).to<S64>()
        quiet : S64  = t.ge(0x7FFF8000).to<S64>()
        r     : S64  = inf.add(nan).add(quiet)
        return(r)

/// knh:knl shifted left until its top bit is set; 128 for zero
routine cm_atan_normalize(knh: U64, knl: U64) -> CmAtanNorm
    block entry():
        high_set : Bool = knh.ne(0)
        low_set  : Bool = knl.ne(0)
        when:
            high_set -> from_high()
            low_set  -> from_low()
            else     -> zero()

    block from_high():
        nzn   : S64        = knh.leading_zeros().to<S64>()
        spill : U64        = knl.shr(0.sub(nzn).bitand(63).to<U64>())
        h     : U64        = knh.shl(nzn.to<U64>()).bitor(spill)
        kn    : U128       = cm_atan_join(h, knl.shl(nzn.to<U64>()))
        r     : CmAtanNorm = CmAtanNorm { kn: kn, shift: nzn }
        return(r)

    block from_low():
        nzl   : S64        = knl.leading_zeros().to<S64>()
        kn    : U128       = cm_atan_join(knl.shl(nzl.to<U64>()), 0)
        shift : S64        = nzl.add(64)
        r     : CmAtanNorm = CmAtanNorm { kn: kn, shift: shift }
        return(r)

    block zero():
        r : CmAtanNorm = CmAtanNorm { kn: 0, shift: 128 }
        return(r)

// -- 192-bit fixed point ---------------------------------------------------------

routine cm_atan_u192_add(a: CmAtanU192, b: CmAtanU192) -> CmAtanU192
    block entry():
        low   : U128       = a.low.add_wrap(b.low)
        carry : U64        = low.lt(a.low).to<U64>()
        top   : U64        = a.top.add_wrap(b.top).add_wrap(carry)
        r     : CmAtanU192 = CmAtanU192 { top: top, low: low }
        return(r)

routine cm_atan_u192_sub(a: CmAtanU192, b: CmAtanU192) -> CmAtanU192
    block entry():
        borrow : U64        = a.low.lt(b.low).to<U64>()
        top    : U64        = a.top.sub_wrap(b.top).sub_wrap(borrow)
        low    : U128       = a.low.sub_wrap(b.low)
        r      : CmAtanU192 = CmAtanU192 { top: top, low: low }
        return(r)

routine cm_atan_u192_not(a: CmAtanU192) -> CmAtanU192
    block entry():
        top : U64        = a.top.bitnot()
        low : U128       = a.low.bitnot()
        r   : CmAtanU192 = CmAtanU192 { top: top, low: low }
        return(r)

/// the top three limbs of row `row` of a 6-limb table (PHI0 or QOFF)
routine cm_atan_row_top(table: @U64, row: USize) -> CmAtanU192
    block entry():
        base : USize      = row.mul(6)
        l3   : U64        = table.stride(base.add(3)).load()
        l4   : U64        = table.stride(base.add(4)).load()
        l5   : U64        = table.stride(base.add(5)).load()
        r    : CmAtanU192 = CmAtanU192 { top: l5, low: cm_atan_join(l4, l3) }
        return(r)

/// the fast series result f, placed as a fraction under 192 bits: (f × 2^64) >> dn
routine cm_atan_place(f: U128, dn: S64) -> CmAtanU192
    block entry():
        near : Bool = dn.lt(64)
        branch near
            ? near()
            : far()

    block near():
        top : U64        = f.shr(64).to<U64>().shr(dn.to<U64>())
        low : U128       = f.shl(64.sub(dn).to<U128>())
        r   : CmAtanU192 = CmAtanU192 { top: top, low: low }
        return(r)

    block far():
        shift  : S64  = dn.sub(64)
        inside : Bool = shift.lt(128)
        moved  : U128 = f.shr(shift.min(127).to<U128>())
        low    : U128 = inside
            ? moved
            : 0
        r : CmAtanU192 = CmAtanU192 { top: 0, low: low }
        return(r)

// -- fast path -------------------------------------------------------------------

/// Returns the 128-bit fixed-point atan(kn / kd × 2^-dn) × 2^dn, before the table angle is
/// added: t = kn / kd, then t - t³ Σ c_i t^2i in Horner form, the low terms in 64-bit words.
routine cm_atan_fast_core(kn: U128, kd: U128, dn: S64) -> U128
    block entry():
        rcp    : U128 = cm_atan_reciprocal(kd)
        t      : U128 = cm_atan_mul_high256(kn, rcp)
        square : U128 = cm_atan_square_high(t)
        dn2    : S64  = dn.mul(2).sub(12)
        inside : Bool = dn2.lt(128)
        scaled : U128 = square.shr(dn2.min(127).to<U128>())
        t2     : U128 = inside
            ? scaled
            : 0
        t2h  : U64  = t2.shr(64).to<U64>()
        c16  : U64  = CM_ATAN_C.get(16)
        c14  : U64  = CM_ATAN_C.get(14)
        c12  : U64  = CM_ATAN_C.get(12)
        c11  : U64  = CM_ATAN_C.get(11)
        c10  : U64  = CM_ATAN_C.get(10)
        fl14 : U64  = c14.sub_wrap(mul_high64(t2h, c16))
        fl12 : U64  = c12.sub_wrap(mul_high64(t2h, fl14))
        f_lo : U64  = c10.sub_wrap(t2h).sub_wrap(mul_high64(t2h, fl12))
        f    : U128 = cm_atan_join(c11, f_lo)
        jump horner(4, f, t, t2)

    block horner(i: USize, f: U128, t: U128, t2: U128):
        done : Bool = i.lt(1)
        branch done
            ? finish(f, t, t2)
            : term(i, f, t, t2)

    block term(i: USize, f: U128, t: U128, t2: U128):
        lo_at : USize = i.mul(2)
        hi_at : USize = lo_at.add(1)
        c_lo  : U64   = CM_ATAN_C.get(lo_at)
        c_hi  : U64   = CM_ATAN_C.get(hi_at)
        next  : U128  = cm_atan_join(c_hi, c_lo).sub_wrap(cm_atan_mul_high256(t2, f))
        jump horner(i.sub(1), next, t, t2)

    block finish(f: U128, t: U128, t2: U128):
        times_t2 : U128 = cm_atan_mul_high256(t2, f)
        times_t  : U128 = cm_atan_mul_high256(t, times_t2)
        r        : U128 = t.sub_wrap(times_t)
        return(r)

/// Rounds a table-path angle, a 192-bit fixed point with 2 integer bits, to F128 magnitude bits.
/// It is hard when the bits under the rounding bit lie within the error bound of a half ulp.
routine cm_atan_round_fixed(s: CmAtanU192) -> CmAtanRounded
    block entry():
        f2   : U64           = s.top
        f1   : U64           = s.low.shr(64).to<U64>()
        k    : U64           = f2.leading_zeros()
        rnd  : U64           = f1.shr(14.sub(k)).bitand(1)
        t    : U128          = s.low.add_wrap(0x0CA2339C0EBEDFA4)
        mask : U64           = 1.shl(15.sub(k)).sub(1)
        th   : U64           = t.shr(64).to<U64>().bitand(mask).bitxor(1.shl(14.sub(k)))
        hard : Bool          = th.eq(0).bitand(t.to_wrap<U64>().lt(0x194467381D7DBF48))
        xn   : U64           = 0x3FFF.sub(k)
        v0   : U64           = f1.shr(15.sub(k)).bitor(f2.shl(49.add(k)))
        v1   : U64           = f2.shr(15.sub(k))
        bits : U128          = cm_atan_join(v1, v0).add_wrap(cm_atan_join(xn.shl(48), rnd))
        r    : CmAtanRounded = CmAtanRounded { hard: hard, bits: bits }
        return(r)

/// Rounds a direct (no table angle) fast result f × 2^(-dn-128) to F128 magnitude bits, down to
/// the subnormal range (atan2's y/x can underflow; atan's never does).
routine cm_atan_round_direct(f: U128, dn: S64) -> CmAtanRounded
    block entry():
        w0     : U64  = f.to_wrap<U64>()
        w1     : U64  = f.shr(64).to<U64>()
        k      : S64  = w1.leading_zeros().to<S64>()
        xn     : S64  = 0x3FFE.sub(dn).sub(k)
        normal : Bool = xn.gt(0)
        branch normal
            ? normal(w0, w1, k.to<U64>(), xn)
            : subnormal()

    block normal(w0: U64, w1: U64, k: U64, xn: S64):
        ones : U64           = U64.MAX
        mask : U64           = ones.shr(49.add(k))
        tl   : U64           = w0.add_wrap(6).bitand(mask).bitxor(1.shl(14.sub(k)))
        hard : Bool          = tl.le(15)
        rnd  : U64           = w0.shr(14.sub(k)).bitand(1)
        v0   : U64           = w0.shr(15.sub(k)).bitor(w1.shl(49.add(k)))
        v1   : U64           = w1.shr(15.sub(k))
        bits : U128          = cm_atan_join(v1,
                v0).add_wrap(cm_atan_join(xn.shl(48).to_wrap<U64>(), rnd))
        r    : CmAtanRounded = CmAtanRounded { hard: hard, bits: bits }
        return(r)

    block subnormal():
        ks     : S64  = dn.sub(0x3FEF)  // 15 - 0x3FFE + dn
        inside : Bool = ks.lt(128)
        branch inside
            ? partial(ks)
            : gone(ks)

    block partial(ks: S64):
        shift : U128          = ks.to<U128>()
        below : U128          = 1.shl(shift).sub_wrap(1)
        tt    : U128          = f.add_wrap(6).bitand(below).bitxor(1.shl(shift.sub(1)))
        hard  : Bool          = tt.le(15)
        rnd   : U128          = f.shr(shift.sub(1)).bitand(1)
        bits  : U128          = f.shr(shift).add_wrap(rnd)
        r     : CmAtanRounded = CmAtanRounded { hard: hard, bits: bits }
        return(r)

    block gone(ks: S64):
        at_top : Bool = ks.eq(128)
        rnd    : U128 = at_top
            ? f.shr(127)
            : 0
        r : CmAtanRounded = CmAtanRounded { hard: false, bits: rnd }
        return(r)

// -- accurate path: limbs --------------------------------------------------------
//
// Numbers are little-endian 64-bit limbs in 8-limb buffers; n says how many take part.

/// o += v × 2^(64 pos), modulo 2^(64 n)
routine cm_atan_limbs_add_at(o: @U64, pos: USize, v: U128, n: USize) -> Void
    block entry():
        jump carry(pos, v)

    block carry(q: USize, c: U128):
        more : Bool = q.lt(n).bitand(c.ne(0))
        branch more
            ? continue
            : return()
        limb : U64  = o.stride(q).load()
        s    : U128 = limb.to<U128>().add(c.bitand(0xFFFFFFFFFFFFFFFF))
        o.stride(q).store(s.to_wrap<S64>().to_wrap<U64>())
        jump carry(q.add(1), c.shr(64).add(s.shr(64)))

/// dst = a + b modulo 2^(64 n); dst may be a or b
routine cm_atan_limbs_add(dst: @U64, a: @U64, b: @U64, n: USize) -> Void
    block entry():
        jump limb(0, 0)

    block limb(i: USize, carry: U128):
        done : Bool = i.ge(n)
        branch done
            ? return()
            : add(i, carry)

    block add(i: USize, carry: U128):
        ai : U64  = a.stride(i).load()
        bi : U64  = b.stride(i).load()
        s  : U128 = ai.to<U128>().add(bi.to<U128>()).add(carry)
        dst.stride(i).store(s.to_wrap<S64>().to_wrap<U64>())
        jump limb(i.add(1), s.shr(64))

/// dst = a - b modulo 2^(64 n); dst may be a or b
routine cm_atan_limbs_sub(dst: @U64, a: @U64, b: @U64, n: USize) -> Void
    block entry():
        jump limb(0, 0)

    block limb(i: USize, borrow: U128):
        done : Bool = i.ge(n)
        branch done
            ? return()
            : continue
        ai : U64  = a.stride(i).load()
        bi : U64  = b.stride(i).load()
        s  : U128 = ai.to<U128>().sub_wrap(bi.to<U128>()).sub_wrap(borrow)
        dst.stride(i).store(s.to_wrap<S64>().to_wrap<U64>())
        jump limb(i.add(1), s.shr(64).bitand(1))

/// a = ~a on the low n limbs
routine cm_atan_limbs_not(a: @U64, n: USize) -> Void
    block entry():
        jump limb(0)

    block limb(i: USize):
        done : Bool = i.ge(n)
        branch done
            ? return()
            : continue
        a.stride(i).load().bitnot().store_into(a.stride(i))
        jump limb(i.add(1))

/// o = a × b exactly (na + nb limbs); o is neither a nor b
routine cm_atan_limbs_mul(o: @U64, a: @U64, na: USize, b: @U64, nb: USize) -> Void
    block entry():
        o.zeroinit(8)
        jump row(0)

    block row(j: USize):
        done : Bool = j.ge(nb)
        branch done
            ? return()
            : column(j, 0)

    block column(j: USize, i: USize):
        row_done : Bool = i.ge(na)
        branch row_done
            ? row(j.add(1))
            : product(j, i)

    block product(j: USize, i: USize):
        ai : U64 = a.stride(i).load()
        bj : U64 = b.stride(j).load()
        cm_atan_limbs_add_at(o, i.add(j), cm_atan_mul(ai, bj), na.add(nb))
        jump column(j, i.add(1))

/// o = the approximate high n limbs of the product of the n-limb a and b: the partial products of
/// column n-1 add their high words, the columns above add in full (the mhu2u2u2 .. mhu6u6u6 and
/// sqrhu6 helpers of the original). o is neither a nor b.
routine cm_atan_limbs_mul_high(o: @U64, a: @U64, b: @U64, n: USize) -> Void
    block entry():
        o.zeroinit(8)
        jump row(0)

    block row(j: USize):
        done : Bool = j.ge(n)
        branch done
            ? return()
            : column(j, 0)

    block column(j: USize, i: USize):
        row_done : Bool = i.ge(n)
        branch row_done
            ? row(j.add(1))
            : product(j, i)

    block product(j: USize, i: USize):
        s    : USize = i.add(j)
        kept : Bool  = s.add(1).ge(n)
        branch kept
            ? keep(j, i, s)
            : column(j, i.add(1))

    block keep(j: USize, i: USize, s: USize):
        ai    : U64  = a.stride(i).load()
        bj    : U64  = b.stride(j).load()
        p     : U128 = cm_atan_mul(ai, bj)
        edge  : Bool = s.add(1).eq(n)
        value : U128 = edge
            ? p.shr(64)
            : p
        pos : USize = edge
            ? 0
            : s.sub_wrap(n)
        cm_atan_limbs_add_at(o, pos, value, n)
        jump column(j, i.add(1))

/// a <<= k on n limbs, k >= 0
routine cm_atan_limbs_shl_pos(a: @U64, n: USize, k: S64) -> Void
    block entry():
        dst  : SSize = n.to<SSize>().sub(1)
        src  : SSize = dst.sub(k.shr(6).to<SSize>())
        some : Bool  = src.ge(0)
        branch some
            ? first(dst, src.to<USize>())
            : clear(dst)

    block first(dst: SSize, src: USize):
        c : U64 = a.stride(src).load()
        jump move(dst, src.sub(1).to<SSize>(), c.to_wrap<S64>())

    // the limb at dst takes c's bits and the top of the next lower limb
    block move(dst: SSize, src: SSize, c: S64):
        s    : S64  = k.bitand(63)
        more : Bool = src.ge(0)
        branch more
            ? step(dst.to<USize>(), src.to<USize>(), c, s)
            : last(dst.to<USize>(), c, s)

    block step(dst: USize, src: USize, c: S64, s: S64):
        next  : U64 = a.stride(src).load()
        under : S64 = next.shr(1).shr(k.bitnot().bitand(63).to<U64>()).to<S64>()
        a.stride(dst).store(c.shl(s).bitor(under).to_wrap<U64>())
        jump move(dst.sub(1).to<SSize>(), src.sub_wrap(1).to_wrap<SSize>(), next.to_wrap<S64>())

    block last(dst: USize, c: S64, s: S64):
        a.stride(dst).store(c.shl(s).to_wrap<U64>())
        jump clear(dst.sub_wrap(1).to_wrap<SSize>())

    block clear(dst: SSize):
        done : Bool = dst.lt(0)
        branch done
            ? return()
            : clear_one(dst.to<USize>())

    block clear_one(dst: USize):
        zero : S64 = 0
        a.stride(dst).store(zero.to<U64>())
        jump clear(dst.sub_wrap(1).to_wrap<SSize>())

/// a >>= k (logical) on n limbs, k >= 0
routine cm_atan_limbs_shr_pos(a: @U64, n: USize, k: S64) -> Void
    block entry():
        src  : USize = k.shr(6).to<USize>()
        some : Bool  = src.lt(n)
        branch some
            ? first(src)
            : clear(0)

    block first(src: USize):
        c : U64 = a.stride(src).load()
        jump move(0, src.add(1), c)

    // the limb at dst takes c's bits and the bottom of the next higher limb
    block move(dst: USize, src: USize, c: U64):
        s    : S64  = k.bitand(63)
        more : Bool = src.lt(n)
        branch more
            ? step(dst, src, c, s)
            : last(dst, c, s)

    block step(dst: USize, src: USize, c: U64, s: S64):
        next    : U64  = a.stride(src).load()
        aligned : Bool = s.eq(0)
        over    : U64  = next.shl(0.sub(k).bitand(63).to<U64>())
        above   : U64  = aligned
            ? 0
            : over
        a.stride(dst).store(c.shr(s.to<U64>()).bitor(above))
        jump move(dst.add(1), src.add(1), next)

    block last(dst: USize, c: U64, s: S64):
        a.stride(dst).store(c.shr(s.to<U64>()))
        jump clear(dst.add(1))

    block clear(dst: USize):
        done : Bool = dst.ge(n)
        branch done
            ? return()
            : continue
        zero : S64 = 0
        a.stride(dst).store(zero.to<U64>())
        jump clear(dst.add(1))

/// a >>= k (logical), or a <<= -k when k < 0
routine cm_atan_limbs_shr(a: @U64, n: USize, k: S64) -> Void
    block entry():
        left : Bool = k.lt(0)
        branch left
            ? left()
            : right()

    block left():
        cm_atan_limbs_shl_pos(a, n, 0.sub(k))
        return()

    block right():
        cm_atan_limbs_shr_pos(a, n, k)
        return()

/// a >>= k (arithmetic) on n limbs, k >= 0
routine cm_atan_limbs_sar(a: @U64, n: USize, k: S64) -> Void
    block entry():
        src  : USize = k.shr(6).to<USize>()
        some : Bool  = src.lt(n)
        branch some
            ? move(0, src.add(1), a.stride(src).load())
            : beyond()

    block move(dst: USize, src: USize, c: U64):
        s    : S64  = k.bitand(63)
        more : Bool = src.lt(n)
        branch more
            ? step(dst, src, c, s)
            : last(dst, c.to_wrap<S64>(), s)

    block step(dst: USize, src: USize, c: U64, s: S64):
        next  : U64 = a.stride(src).load()
        above : U64 = next.shl(1).shl(k.bitnot().bitand(63).to<U64>())
        a.stride(dst).store(c.shr(s.to<U64>()).bitor(above))
        jump move(dst.add(1), src.add(1), next)

    block last(dst: USize, c: S64, s: S64):
        a.stride(dst).store(c.shr(s).to_wrap<U64>())
        jump fill(dst.add(1), c.shr(63))

    block beyond():
        top_at : USize = n.sub_wrap(1)
        top    : U64   = a.stride(top_at).load()
        jump fill(0, top.to_wrap<S64>().shr(63))

    block fill(dst: USize, sign: S64):
        done : Bool = dst.ge(n)
        branch done
            ? return()
            : continue
        a.stride(dst).store(sign.to_wrap<U64>())
        jump fill(dst.add_wrap(1), sign)

// -- accurate path: kernel -------------------------------------------------------

/// r = 2^447 / (kd2:kd1:kd0) to 6 limbs: the 128-bit fast reciprocal refined by one Newton step
/// with a second-order term, r × (1 - h + h²) for the error h = 1 - r × kd.
routine cm_atan_accurate_reciprocal(kd0: S64, kd1: U64, kd2: U64, r: @U64) -> Void
    block entry():
        claim rcp_buf : @Array<S64, 8> <- uninit
        claim kd_buf  : @Array<S64, 8> <- uninit
        claim h_buf   : @Array<S64, 8> <- uninit
        claim sh_buf  : @Array<S64, 8> <- uninit
        claim h2_buf  : @Array<S64, 8> <- uninit
        claim fix_buf : @Array<S64, 8> <- uninit
        claim dr_buf  : @Array<S64, 8> <- uninit
        rcp   : @U64 = rcp_buf.to<@U64>()
        kd    : @U64 = kd_buf.to<@U64>()
        h     : @U64 = h_buf.to<@U64>()
        sh    : @U64 = sh_buf.to<@U64>()
        h2    : @U64 = h2_buf.to<@U64>()
        fix   : @U64 = fix_buf.to<@U64>()
        dr    : @U64 = dr_buf.to<@U64>()
        first : U128 = cm_atan_reciprocal(cm_atan_join(kd2, kd1))
        r_lo  : S64  = first.to_wrap<S64>()
        r_hi  : S64  = first.shr(64).to_wrap<S64>()
        r.zeroinit(8)
        r.stride(4).store(r_lo.to_wrap<U64>())
        r.stride(5).store(r_hi.to_wrap<U64>())
        rcp.stride(0).store(r_lo.to_wrap<U64>())
        rcp.stride(1).store(r_hi.to_wrap<U64>())
        kd.stride(0).store(kd0.to_wrap<U64>())
        kd.stride(1).store(kd1)
        kd.stride(2).store(kd2)
        // h = r × kd (5 limbs); sh = h >> 58, a signed 3-limb error term
        cm_atan_limbs_mul(h, rcp, 2, kd, 3)
        h0     : U64 = h.stride(0).load()
        h1     : U64 = h.stride(1).load()
        h2_val : U64 = h.stride(2).load()
        h3     : U64 = h.stride(3).load()
        sh0    : U64 = h0.shr(58).bitor(h1.shl(6))
        sh1    : U64 = h1.shr(58).bitor(h2_val.shl(6))
        sh2    : U64 = h2_val.shr(58).bitor(h3.shl(6))
        sh.stride(0).store(sh0)
        sh.stride(1).store(sh1)
        sh.stride(2).store(sh2)
        // h2 = sh² as a signed square: the unsigned square, less 2 sh × 2^192 when sh < 0
        cm_atan_limbs_mul(h2, sh, 3, sh, 3)
        sh_neg : Bool = sh2.shr(63).eq(1)
        fix.zeroinit(8)
        tw3  : S64 = sh0.shl(1).to_wrap<S64>()
        tw4  : S64 = sh1.shl(1).bitor(sh0.shr(63)).to_wrap<S64>()
        tw5  : S64 = sh2.shl(1).bitor(sh1.shr(63)).to_wrap<S64>()
        fix3 : S64 = sh_neg
            ? tw3
            : 0
        fix4 : S64 = sh_neg
            ? tw4
            : 0
        fix5 : S64 = sh_neg
            ? tw5
            : 0
        fix.stride(3).store(fix3.to_wrap<U64>())
        fix.stride(4).store(fix4.to_wrap<U64>())
        fix.stride(5).store(fix5.to_wrap<U64>())
        cm_atan_limbs_sub(h2, h2, fix, 6)
        // h = (h << 75) - h2 >> 128
        cm_atan_limbs_shl_pos(h, 5, 75)
        sq2 : U64 = h2.stride(2).load()
        sq3 : U64 = h2.stride(3).load()
        sq4 : U64 = h2.stride(4).load()
        fix.zeroinit(8)
        fix.stride(0).store(sq2)
        fix.stride(1).store(sq3)
        fix.stride(2).store(sq4)
        cm_atan_limbs_sub(h, h, fix, 5)
        // dr = h × r as a signed product (h is signed), then >> 10
        cm_atan_limbs_mul(dr, h, 5, rcp, 2)
        top_h : U64  = h.stride(4).load()
        h_neg : Bool = top_h.shr(63).eq(1)
        fix.zeroinit(8)
        fix_lo : S64 = h_neg
            ? r_lo
            : 0
        fix_hi : S64 = h_neg
            ? r_hi
            : 0
        fix.stride(5).store(fix_lo.to_wrap<U64>())
        fix.stride(6).store(fix_hi.to_wrap<U64>())
        cm_atan_limbs_sub(dr, dr, fix, 7)
        cm_atan_limbs_sar(dr, 7, 10)
        // r -= dr >> 128, sign-extended to 6 limbs
        d2 : U64 = dr.stride(2).load()
        d3 : U64 = dr.stride(3).load()
        d4 : U64 = dr.stride(4).load()
        d5 : U64 = dr.stride(5).load()
        d6 : U64 = dr.stride(6).load()
        fix.stride(0).store(d2)
        fix.stride(1).store(d3)
        fix.stride(2).store(d4)
        fix.stride(3).store(d5)
        d7 : S64 = d6.to_wrap<S64>().shr(63)
        fix.stride(4).store(d6)
        fix.stride(5).store(d7.to_wrap<U64>())
        cm_atan_limbs_sub(r, r, fix, 6)
        return()

/// f = the 6-limb fixed-point atan(t × 2^-dn) × 2^dn for the 6-limb t: the odd series in 25
/// terms, t - t³ Σ c_k t^2k, the working precision widening from 2 to 6 limbs as the terms grow.
routine cm_atan_accurate_series(t: @U64, dn: S64, f: @U64) -> Void
    block entry():
        claim t2_buf  : @Array<S64, 8> <- uninit
        claim tmp_buf : @Array<S64, 8> <- uninit
        t2  : @U64 = t2_buf.to<@U64>()
        tmp : @U64 = tmp_buf.to<@U64>()
        cm_atan_limbs_mul_high(t2, t, t, 6)
        cm_atan_limbs_shr(t2, 6, dn.mul(2).sub(14))
        c0 : U64 = CM_ATAN_CP.get(0)
        c1 : U64 = CM_ATAN_CP.get(1)
        f.zeroinit(8)
        f.stride(0).store(c0)
        f.stride(1).store(c1)
        jump term(2, 0, 5, t2, tmp)

    // left terms remain at the n-limb precision; the coefficient of the last one began at ck
    block term(n: USize, ck: USize, left: S64, t2: @U64, tmp: @U64):
        stage_done : Bool = left.eq(0)
        branch stage_done
            ? widen(n, ck, t2, tmp)
            : step(n, ck, left, t2, tmp)

    // f = CP[ck..] - f × t2 (the top n limbs of t2)
    block step(n: USize, ck: USize, left: S64, t2: @U64, tmp: @U64):
        next_ck : USize = ck.add(n)
        t2_top  : @U64  = t2.stride(6.sub(n))
        coef    : @U64  = CM_ATAN_CP.to<@U64>().stride(next_ck)
        cm_atan_limbs_mul_high(tmp, f, t2_top, n)
        cm_atan_limbs_sub(f, coef, tmp, n)
        jump term(n, next_ck, left.sub(1), t2, tmp)

    // one more limb on top: CP holds it right after the last coefficient used
    block widen(n: USize, ck: USize, t2: @U64, tmp: @U64):
        full : Bool = n.eq(6)
        branch full
            ? finish(t2, tmp)
            : grow(n, ck, t2, tmp)

    block grow(n: USize, ck: USize, t2: @U64, tmp: @U64):
        top_at : USize = ck.add(n)
        top    : U64   = CM_ATAN_CP.get(top_at)
        f.stride(n).store(top)
        wider : USize = n.add(1)
        last  : Bool  = wider.eq(6)
        terms : S64   = last
            ? 4
            : 5
        jump term(wider, ck, terms, t2, tmp)

    // f = t - t × (f × t2)
    block finish(t2: @U64, tmp: @U64):
        cm_atan_limbs_mul_high(tmp, f, t2, 6)
        cm_atan_limbs_mul_high(t2, t, tmp, 6)
        cm_atan_limbs_sub(f, t, t2, 6)
        return()

/// f = the 6-limb fixed-point atan(kn / kd × 2^-dn) × 2^dn, before the table angle is added
routine cm_atan_accurate_core(red: CmAtanReduction, f: @U64) -> Void
    block entry():
        claim r_buf  : @Array<S64, 8> <- uninit
        claim kn_buf : @Array<S64, 8> <- uninit
        claim t_buf  : @Array<S64, 8> <- uninit
        r  : @U64 = r_buf.to<@U64>()
        kn : @U64 = kn_buf.to<@U64>()
        t  : @U64 = t_buf.to<@U64>()
        cm_atan_accurate_reciprocal(red.kd0, red.kd1, red.kd2, r)
        kn_val : U128 = red.kn
        kn_lo  : S64  = kn_val.to_wrap<S64>()
        kn_hi  : S64  = kn_val.shr(64).to_wrap<S64>()
        kn.stride(0).store(kn_lo.to_wrap<U64>())
        kn.stride(1).store(kn_hi.to_wrap<U64>())
        // t = r × kn >> 128: the reduced argument to 6 limbs (limbs 2..7 of the product)
        cm_atan_limbs_mul(t, r, 6, kn, 2)
        t_top : @U64 = t.offset(16)
        cm_atan_accurate_series(t_top, red.dn, f)
        return()

/// Rounds the 6-limb angle f × 2^(-dn - 384) to F128 magnitude bits, down to the subnormal range.
/// No tie can occur, so the bit under the last kept one decides.
routine cm_atan_round_limbs(f: @U64, dn: S64) -> U128
    block entry():
        f5     : U64  = f.stride(5).load()
        f4     : U64  = f.stride(4).load()
        k      : S64  = f5.leading_zeros().to<S64>()
        v      : U128 = cm_atan_join(f5, f4).shl(k.to<U128>())
        xn     : S64  = 0x3FFE.sub(dn).sub(k)
        normal : Bool = xn.gt(0)
        branch normal
            ? normal(v, xn)
            : subnormal(v, 15.sub(xn))

    block normal(v: U128, xn: S64):
        rnd  : U128 = v.shr(14).bitand(1)
        bits : U128 = v.shr(15).add_wrap(cm_atan_join(xn.shl(48).to_wrap<U64>(), 0)).add_wrap(rnd)
        return(bits)

    block subnormal(v: U128, ks: S64):
        inside : Bool = ks.lt(128)
        branch inside
            ? partial(v, ks.to<S128>())
            : gone(v, ks)

    block partial(v: U128, ks: S128):
        rnd  : U128 = v.shr(ks.sub(1).to<U128>()).bitand(1)
        bits : U128 = v.shr(ks.to<U128>()).add_wrap(rnd)
        return(bits)

    block gone(v: U128, ks: S64):
        at_top : Bool = ks.eq(128)
        rnd    : U128 = at_top
            ? v.shr(127)
            : 0
        return(rnd)

// -- tables ----------------------------------------------------------------------

/// TN[i]: a 15-bit approximation of tan(i π/4 / 64)
preset CM_ATAN_TN: @Array<U64, 65> <- { 0, 402, 804, 1207, 1610, 2013, 2417, 2822, 3227, 3634, 4042,
        4450, 4861, 5272, 5686, 6101, 6518, 6937, 7358, 7782, 8208, 8637, 9068, 9503, 9940, 10381,
        10825, 11273, 11725, 12180, 12640, 13104, 13573, 14046, 14525, 15009, 15498, 15993, 16494,
        17001, 17515, 18035, 18563, 19098, 19640, 20191, 20750, 21318, 21895, 22481, 23078, 23685,
        24302, 24931, 25572, 26226, 26892, 27572, 28266, 28975, 29699, 30440, 31198, 31973, 32768 }

