; Tessera stdlib: correctly rounded two-argument arc tangent of F128
;
; Ported from CORE-MATH, src/binary128/atan2/atan2q.c via RazorForge's B128Atan2.rf.
; Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
; MIT license: see LICENSE-CORE-MATH
;
; f128_cm_atan2(y, x) is the exact angle of the point (x, y), in [-π, π], rounded to nearest,
; ties to even. The ratio b/a of min(|x|, |y|) to max(|x|, |y|) is reduced against a table angle
; atan(t) with t = TN[i] / 2^15, the series runs in atan_shared.tess, and the angle is rebuilt as
; ±(PHI0[i] + f) plus a quadrant offset 0, π/2 or π; y's sign goes on last. Zero and infinite
; coordinates follow C99 Annex F (signed zeros pick 0 or π, infinities the multiples of π/4).
; NaN in gives NaN out: a quiet y, else a quiet x, unchanged; a signaling one the default NaN.

; 0, π, 3π/4, π/4, π/2 as (lo, hi) pairs of fixed point with 2 integer bits
preset CM_ATAN2_RS: Array<U64, 10> = [
    0x0000000000000000, 0x0000000000000000, 0x62633145C06E0E69, 0x6487ED5110B4611A,
    0xC9CA64F450528ACE, 0x4B65F1FCCC8748D3, 0x9898CC51701B839A, 0x1921FB54442D1846,
    0x313198A2E0370734, 0x3243F6A8885A308D
]

; reciprocal estimates of the top mantissa bits of max(|x|, |y|), for the table-index guess
preset CM_ATAN2_RCP: Array<U64, 128> = [
    0, 248, 240, 232, 224, 217, 210, 202, 195, 188, 181, 174, 168,
    161, 155, 148, 142, 135, 129, 123, 117, 111, 105, 100, 94, 88,
    83, 77, 72, 66, 61, 56, 51, 46, 41, 36, 31, 26, 21,
    16, 12, 7, 3, 254, 250, 245, 241, 236, 232, 228, 224, 220,
    216, 212, 208, 204, 200, 196, 192, 188, 185, 181, 177, 174, 170,
    167, 163, 160, 156, 153, 149, 146, 143, 140, 136, 133, 130, 127,
    124, 121, 118, 115, 112, 109, 106, 103, 100, 97, 94, 92, 89,
    86, 83, 81, 78, 75, 73, 70, 67, 65, 62, 60, 57, 55,
    52, 50, 48, 45, 43, 41, 38, 36, 34, 31, 29, 27, 25,
    22, 20, 18, 16, 14, 12, 10, 8, 6, 4, 2
]

; the table index from the estimated ratio min/max × 2^7
preset CM_ATAN2_IND: Array<U64, 129> = [
    0, 0, 1, 1, 2, 3, 3, 4, 5, 5, 6, 6, 7,
    8, 8, 9, 10, 10, 11, 11, 12, 13, 13, 14, 15, 15,
    16, 16, 17, 18, 18, 19, 19, 20, 21, 21, 22, 22, 23,
    23, 24, 25, 25, 26, 26, 27, 27, 28, 29, 29, 30, 30,
    31, 31, 32, 32, 33, 33, 34, 34, 35, 36, 36, 37, 37,
    38, 38, 39, 39, 40, 40, 41, 41, 41, 42, 42, 43, 43,
    44, 44, 45, 45, 46, 46, 47, 47, 47, 48, 48, 49, 49,
    50, 50, 50, 51, 51, 52, 52, 52, 53, 53, 54, 54, 54,
    55, 55, 56, 56, 56, 57, 57, 57, 58, 58, 58, 59, 59,
    60, 60, 60, 61, 61, 61, 62, 62, 62, 63, 63, 63
]

routine f128_cm_atan2(%y: F128, %x: F128) -> F128
    block entry():
        %x_neg:     Bool = f128_is_negative_bits(%x.bits)
        %y_sign:    U128 = %y.bits.bitand(F128_SIGN)
        %magnitude: U128 = F128_SIGN.bitnot()
        %xa:        U128 = %x.bits.bitand(%magnitude)
        %ya:        U128 = %y.bits.bitand(%magnitude)
        %nonfinite: Bool = %xa.ge(F128_INF).bitor(%ya.ge(F128_INF))
        branch %nonfinite ? special() : reduce(%xa, %ya, %x_neg, %y_sign)

    block special():
        %r: F128 = cm_atan2_special(%y, %x)
        return(%r)

    block reduce(%xa: U128, %ya: U128, %x_neg: Bool, %y_sign: U128):
        %red:  CmAtanReduction = cm_atan2_reduce(%xa, %ya)
        %zero: Bool = %red.zero
        branch %zero ? special() : fast(%red, %x_neg, %y_sign)

    block fast(%red: CmAtanReduction, %x_neg: Bool, %y_sign: U128):
        %kd:    U128 = cm_atan_join(%red.kd2, %red.kd1)
        %f:     U128 = cm_atan_fast_core(%red.kn, %kd, %red.dn)
        %table: Bool = %red.isct.ne(0).bitor(%red.g).bitor(%x_neg)
        branch %table ? with_table(%red, %f, %x_neg, %y_sign) : direct(%red, %f, %y_sign)

    ; the angle ±(PHI0[isct] + f) + (0, π/2 or π): negated when exactly one of |x| < |y| and
    ; x < 0 holds
    block with_table(%red: CmAtanReduction, %f: U128, %x_neg: Bool, %y_sign: U128):
        %placed:  CmAtanU192 = cm_atan_place(%f, %red.dn.add(1))
        %phi:     CmAtanU192 = cm_atan_row_top(CM_ATAN_PHI0.as_ptr(), %red.isct)
        %angle:   CmAtanU192 = cm_atan_u192_add(%phi, %placed)
        %flip:    Bool       = %red.g.bitxor(%x_neg)
        %negated: CmAtanU192 = cm_atan_u192_not(%angle)
        %signed:  CmAtanU192 = %flip ? %negated : %angle
        %q:       U64        = cm_atan2_quadrant(%red.g, %x_neg)
        %offset:  CmAtanU192 = cm_atan_row_top(CM_ATAN_QOFF.as_ptr(), %q)
        %final:   CmAtanU192 = cm_atan_u192_add(%offset, %signed)
        %rounded: CmAtanRounded = cm_atan_round_fixed(%final)
        %result:  F128 = F128 { bits: %rounded.bits.bitor(%y_sign) }
        %hard:    Bool = %rounded.hard
        branch %hard ? accurate(%red, %x_neg, %y_sign) : return(%result)

    block direct(%red: CmAtanReduction, %f: U128, %y_sign: U128):
        %rounded: CmAtanRounded = cm_atan_round_direct(%f, %red.dn)
        %result:  F128 = F128 { bits: %rounded.bits.bitor(%y_sign) }
        %hard:    Bool = %rounded.hard
        branch %hard ? accurate(%red, false, %y_sign) : return(%result)

    block accurate(%red: CmAtanReduction, %x_neg: Bool, %y_sign: U128):
        %r: F128 = cm_atan2_accurate(%red, %x_neg, %y_sign)
        return(%r)

; the row of the quadrant offset: 0 (none), 1 (π/2 when |x| < |y|), 2 (π when x < 0, |x| >= |y|)
routine cm_atan2_quadrant(%g: Bool, %x_neg: Bool) -> U64
    block entry():
        %left: U64 = %x_neg ? 2 : 0
        %q:    U64 = %g ? 1 : %left
        return(%q)

; Reduces b/a for a = max(|x|, |y|), b = min(|x|, |y|) (sign-stripped bits) against the table
; angle atan(TN[isct] / 2^15). zero is set when b = 0.
routine cm_atan2_reduce(%xa: U128, %ya: U128) -> CmAtanReduction
    block entry():
        %g:  Bool = %xa.lt(%ya)
        %a:  U128 = %g ? %ya : %xa
        %b:  U128 = %g ? %xa : %ya
        %xn: S64  = %a.shr(112).to_s64()
        %yn: S64  = %b.shr(112).to_s64()
        %b_subnormal: Bool = %yn.eq(0)
        branch %b_subnormal ? scale(%g, %a, %b, %xn) : estimate(%g, %a, %b, %xn, %yn)

    ; subnormal b (or a too): normalize the significand, extending the exponent below 1
    block scale(%g: Bool, %a: U128, %b: U128, %xn: S64):
        %b_zero: Bool = %b.eq(0)
        %none: CmAtanReduction = CmAtanReduction {
            zero: true, g: %g, isct: 0, dn: 0, kn: 0, kd0: 0, kd1: 0, kd2: 0
        }
        %ns_b:   S64  = %b.leading_zeros().to_s64().sub(15)
        %b_norm: U128 = %b.shl(%ns_b.max(0).to_u128())
        %yn:     S64  = 1.sub(%ns_b)
        %a_subnormal: Bool = %xn.eq(0)
        %ns_a:   S64  = %a.leading_zeros().to_s64().sub(15)
        %a_norm: U128 = %a.shl(%ns_a.max(0).to_u128())
        %a_used: U128 = %a_subnormal ? %a_norm : %a
        %xn_used: S64 = %a_subnormal ? 1.sub(%ns_a) : %xn
        branch %b_zero ? return(%none) : estimate(%g, %a_used, %b_norm, %xn_used, %yn)

    ; the table index from b × (1/a) estimated in a few bits, then corrected by one
    block estimate(%g: Bool, %a_raw: U128, %b_raw: U128, %xn: S64, %yn: S64):
        %dn:    S64  = %xn.sub(%yn)
        %ah:    U64  = %a_raw.shr(64).to_u64().bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        %bh:    U64  = %b_raw.shr(64).to_u64().bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        %a:     U128 = cm_atan_join(%ah, %a_raw.to_u64_wrap())
        %b:     U128 = cm_atan_join(%bh, %b_raw.to_u64_wrap())
        %inda:  U64  = %ah.shr(41).bitand(127)
        %rcp:   U64  := CM_ATAN2_RCP[%inda]
        %rsc:   U64  = %inda.eq(0).to_u64().add(%inda.lt(43).to_u64()).add(2)
        %rcpx:  U64  = %rsc.shl(8).bitor(%rcp)
        %ratio: U64  = %bh.shr(10).mul_wrap(%rcpx).shr(41)
        %near:  Bool = %dn.lt(64)
        %scaled: U64 = %ratio.shr(%dn.min(63).to_u64())
        %k:     U64  = %near ? %scaled : 0
        %guess: U64  := CM_ATAN2_IND[%k]
        jump correct(%g, %a, %b, %dn, %near, %guess)

    block correct(%g: Bool, %a: U128, %b: U128, %dn: S64, %near: Bool, %guess: U64):
        %next_at: U64  = %guess.add(1)
        %next_tn: U64  := CM_ATAN_TN[%next_at]
        %ah:      U64  = %a.shr(64).to_u64()
        %bh:      U64  = %b.shr(64).to_u64()
        %below:   Bool = %ah.shr(15).mul_wrap(%next_tn).lt(%bh.shr(%dn.min(63).to_u64()))
        %bump:    Bool = %near.bitand(%below)
        %isct:    U64  = %guess.add(%bump.to_u64())
        %plain:   Bool = %isct.eq(0)
        branch %plain ? plain(%g, %a, %b, %dn) : offset(%g, %a, %b, %dn, %isct.min(63))

    ; b/a itself: kn = b, kd = a
    block plain(%g: Bool, %a: U128, %b: U128, %dn: S64):
        %kn: U128 = %b.shl(15)
        %kd: U128 = %a.shl(15)
        %r: CmAtanReduction = CmAtanReduction {
            zero: false, g: %g, isct: 0, dn: %dn, kn: %kn,
            kd0: 0, kd1: %kd.to_u64_wrap(), kd2: %kd.shr(64).to_u64()
        }
        return(%r)

    ; kn = b - a t, kd = a + b t (scaled), the index moved down one when kn goes negative
    block offset(%g: Bool, %a: U128, %b: U128, %dn: S64, %first: U64):
        %first_tn: U64  := CM_ATAN_TN[%first]
        %shift:    S128 = %dn.to_s128()
        %kn_first: S128 = %b.shl(15).sub_wrap(%a.mul_wrap(%first_tn.to_u128()).shl(%shift.to_u128())).to_s128_wrap()
        %over:     Bool = %kn_first.lt(0)
        %isct:     U64  = %over ? %first.sub(1) : %first
        %tn:       U64  := CM_ATAN_TN[%isct]
        %kn_raw:   U128 = %b.shl(15).sub_wrap(%a.mul_wrap(%tn.to_u128()).shl(%shift.to_u128()))
        %kn_zero:  Bool = %kn_raw.eq(0)
        %nzn_raw:  S64  = %kn_raw.leading_zeros().to_s64()
        %nzn:      S64  = %kn_zero ? 0 : %nzn_raw
        %kn:       U128 = %kn_raw.shl(%nzn.to_u128())
        ; kd = a × 2^(15 + dn) + b t as 192 bits, then normalized
        %sl:       S64  = %dn.add(15)
        %a_top:    U64  = %a.shr(64).to_u64().shr(49.sub(%dn).to_u64())
        %a_shifted: CmAtanU192 = CmAtanU192 { top: %a_top, low: %a.shl(%sl.to_u128()) }
        %bt:       CmAtanU192 = CmAtanU192 { top: 0, low: %b.mul_wrap(%tn.to_u128()) }
        %kd:       CmAtanU192 = cm_atan_u192_add(%a_shifted, %bt)
        jump normalize(%g, %isct, %dn, %kn, %nzn, %kd)

    ; shift kd left until its top bit is set: a whole limb first if the top one is empty
    block normalize(%g: Bool, %isct: U64, %dn: S64, %kn: U128, %nzn: S64, %kd: CmAtanU192):
        %empty:  Bool = %kd.top.eq(0)
        %top0:   U64  = %empty ? %kd.low.shr(64).to_u64() : %kd.top
        %low0:   U128 = %empty ? %kd.low.shl(64) : %kd.low
        %z:      S64  = %top0.leading_zeros().to_s64()
        %under:  U64  = %low0.shr(64).to_u64().shr(1).shr(%z.bitnot().bitand(63).to_u64())
        %kd2:    U64  = %top0.shl(%z.to_u64()).bitor(%under)
        %low:    U128 = %low0.shl(%z.to_u128())
        %nzd:    S64  = %empty.to_s64().mul(64).add(%z)
        %dn_new: S64  = %nzn.sub(%nzd).add(64)
        %r: CmAtanReduction = CmAtanReduction {
            zero: false, g: %g, isct: %isct, dn: %dn_new, kn: %kn,
            kd0: %low.to_s64_wrap(), kd1: %low.shr(64).to_u64(), kd2: %kd2
        }
        return(%r)

; The accurate path: the same reduction, the series and the reconstruction in 6 limbs.
routine cm_atan2_accurate(%red: CmAtanReduction, %x_neg: Bool, %y_sign: U128) -> F128
    block entry():
        #f_buf: Ptr<Array<S64, 8>> = alloca<Array<S64, 8>>
        #f:     Ptr<U64> = #f_buf.cast<U64>()
        cm_atan_accurate_core(%red, #f)
        %table: Bool = %red.isct.ne(0).bitor(%red.g).bitor(%x_neg)
        branch %table ? with_table(#f) : finish(#f, %red.dn)

    block with_table(#f: Ptr<U64>):
        %dn: S64 = %red.dn
        cm_atan_limbs_shr(#f, 6, %dn.add(1))
        %row:    U64 = %red.isct.mul(6)
        #phi:    Ptr<U64> = CM_ATAN_PHI0.as_ptr()[%row]
        cm_atan_limbs_add(#f, #phi, #f, 6)
        %flip:   Bool = %red.g.bitxor(%x_neg)
        branch %flip ? negate(#f) : quadrant(#f)

    block negate(#f: Ptr<U64>):
        cm_atan_limbs_not(#f, 6)
        jump quadrant(#f)

    block quadrant(#f: Ptr<U64>):
        %q:      U64 = cm_atan2_quadrant(%red.g, %x_neg)
        %row:    U64 = %q.mul(6)
        #offset: Ptr<U64> = CM_ATAN_QOFF.as_ptr()[%row]
        cm_atan_limbs_add(#f, #offset, #f, 6)
        jump finish(#f, -1)

    block finish(#f: Ptr<U64>, %dn: S64):
        %bits: U128 = cm_atan_round_limbs(#f, %dn)
        %r:    F128 = F128 { bits: %bits.bitor(%y_sign) }
        return(%r)

; NaN, infinite or zero coordinates
routine cm_atan2_special(%y: F128, %x: F128) -> F128
    block entry():
        %magnitude: U128 = F128_SIGN.bitnot()
        %ix:        U128 = %x.bits.bitand(%magnitude)
        %iy:        U128 = %y.bits.bitand(%magnitude)
        %x_class:   S64  = cm_atan_class(%ix.shr(64).to_u64(), %ix.to_u64_wrap())
        %y_class:   S64  = cm_atan_class(%iy.shr(64).to_u64(), %iy.to_u64_wrap())
        %signaling: Bool = %x_class.eq(2).bitor(%y_class.eq(2))
        %y_nan:     Bool = %y_class.eq(3)
        %x_nan:     Bool = %x_class.eq(3)
        %default:   F128 = F128 { bits: 0xFFFF8000000000000000000000000000 }
        select:
            %signaling -> return(%default)
            %y_nan -> return(%y)
            %x_nan -> return(%x)
            _ -> angle(%x_class, %y_class, %iy)

    ; the angle's row in RS: 0 or π on the x axis, π/4 or 3π/4 for two infinities, else π/2
    block angle(%x_class: S64, %y_class: S64, %iy: U128):
        %xs:      U64  = %x.bits.shr(127).to_u64()
        %x_inf:   Bool = %x_class.eq(1)
        %y_inf:   Bool = %y_class.eq(1)
        %on_axis: U64  = %iy.eq(0) ? %xs : 4
        %steep:   U64  = %y_inf ? 4 : %on_axis
        %flat:    U64  = %x_inf ? %xs : %steep
        %corner:  Bool = %x_inf.bitand(%y_inf)
        %idx:     U64  = %corner ? 3.sub(%xs) : %flat
        %lo_at:   U64  = %idx.mul(2)
        %hi_at:   U64  = %lo_at.add(1)
        %ol:      U64  := CM_ATAN2_RS[%lo_at]
        %oh:      U64  := CM_ATAN2_RS[%hi_at]
        %y_sign:  U128 = %y.bits.bitand(F128_SIGN)
        %zero:    F128 = F128 { bits: %y_sign }
        %is_zero: Bool = %oh.eq(0)
        branch %is_zero ? return(%zero) : round(%ol, %oh, %y_sign)

    block round(%ol: U64, %oh: U64, %y_sign: U128):
        %k:     U64  = %oh.leading_zeros()
        %rnd:   U64  = %ol.shr(14.sub(%k)).bitand(1)
        %frac:  U64  = %ol.shl(49.add(%k))
        %up:    U64  = %frac.eq(0) ? 0 : %rnd
        %xn:    U64  = 0x4000.sub(%k)
        %v0:    U64  = %ol.shr(15.sub(%k)).bitor(%oh.shl(49.add(%k)))
        %v1:    U64  = %oh.shr(15.sub(%k))
        %bits:  U128 = cm_atan_join(%v1, %v0).add_wrap(cm_atan_join(%xn.shl(48), %up))
        %r:     F128 = F128 { bits: %bits.bitor(%y_sign) }
        return(%r)
