// Tessera stdlib: correctly rounded F128 sine, and the sine and cosine together
//
// Ported from CORE-MATH, src/binary128/sin/sinq.c via RazorForge's B128Sin.rf.
// Copyright (c) 2026 Chen-Pang He <jdh863@gmail.com>
// MIT license: see LICENSE-CORE-MATH
//
// The result is the exact sine of the argument (in radians) rounded to the nearest F128, ties to even.
// sin(-x) = -sin(x), ±0 maps to itself, ±infinity gives the default quiet NaN, and a NaN comes back quieted
// with its sign and payload. The pipeline shared with the cosine lives in trig_shared.tess.

module Standard::Core

/// sin(x) and cos(x), each correctly rounded.
record F128SinCos
    sin : F128
    cos : F128

routine f128_cm_sin(x: F128) -> F128
    block entry():
        bits : U128 = cm_trig(x.bits(), false)
        r    : F128 = f128_of(bits)
        return(r)

/// The sine and the cosine, each exactly as f128_cm_sin and f128_cm_cos return them. They share the argument
/// reduction, so the pair costs little more than one of them.
routine f128_cm_sin_cos(x: F128) -> F128SinCos
    block entry():
        r : F128SinCos = cm_trig_both(x.bits())
        return(r)
