; Disl stdlib: correctly rounded arc tangent of F128
;
; Ported from CORE-MATH, src/binary128/atan/atanq.c via RazorForge's B128Atan.rf.
; Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
; MIT license: see LICENSE-CORE-MATH
;
; f128_cm_atan(x) is the exact arc tangent rounded to nearest, ties to even. |x| below 2^-57
; returns x and |x| above 2^115 returns ±π/2 (both already correctly rounded). Otherwise |x| (or
; 1/|x| past 1) is reduced against a table angle atan(t) with t = TN[i] / 2^15 to
; (|x| - t) / (1 + |x| t), whose series runs in atan_shared.disl; the table angle is added back
; (and taken from π/2 past 1). NaN in gives NaN out: a quiet NaN unchanged, a signaling one the
; default NaN.

; |x| in [2^-e, 2^-e+1) for e <= 7: the first guess of the table index from the top mantissa bits
const CM_ATAN_INDL: Array<I64, 128> = [
    0, 0, 1, 1, 2, 3, 3, 4, 5, 5, 6, 6, 7,
    8, 8, 9, 10, 10, 11, 12, 12, 13, 13, 14, 15, 15,
    16, 16, 17, 18, 18, 19, 19, 20, 21, 21, 22, 22, 23,
    24, 24, 25, 25, 26, 26, 27, 28, 28, 29, 29, 30, 30,
    31, 31, 32, 33, 33, 34, 34, 35, 35, 36, 36, 37, 37,
    38, 38, 39, 39, 40, 40, 41, 41, 42, 42, 43, 43, 44,
    44, 45, 45, 45, 46, 46, 47, 47, 48, 48, 49, 49, 49,
    50, 50, 51, 51, 52, 52, 52, 53, 53, 54, 54, 54, 55,
    55, 55, 56, 56, 57, 57, 57, 58, 58, 58, 59, 59, 59,
    60, 60, 61, 61, 61, 62, 62, 62, 63, 63, 63
]

; |x| in [2^e, 2^e+1) for e <= 6: the first guess from the complemented top mantissa bits
const CM_ATAN_INDH: Array<I64, 128> = [
    0, 0, 1, 1, 2, 2, 3, 4, 5, 5, 5, 6, 6,
    7, 8, 9, 10, 10, 10, 11, 11, 11, 12, 12, 13, 14,
    14, 15, 16, 16, 17, 18, 19, 20, 20, 20, 21, 21, 21,
    22, 22, 23, 23, 23, 24, 24, 25, 25, 26, 26, 27, 27,
    28, 29, 29, 30, 31, 31, 32, 33, 34, 34, 35, 36, 37,
    38, 38, 38, 38, 39, 39, 39, 39, 40, 40, 40, 41, 41,
    41, 41, 42, 42, 42, 43, 43, 43, 44, 44, 44, 45, 45,
    46, 46, 46, 47, 47, 47, 48, 48, 49, 49, 49, 50, 50,
    51, 51, 52, 52, 53, 53, 54, 54, 54, 55, 55, 56, 57,
    57, 58, 58, 59, 59, 60, 60, 61, 62, 62, 63
]

routine f128_cm_atan(%x: F128) -> F128
    block entry():
        %bits: I128 = %x.bits
        %sign: I128 = %bits.bitand(F128_SIGN)
        %hi:   I64  = %bits.lshr(64).to_i64().bitand(0x7FFFFFFFFFFFFFFF)
        %lo:   I64  = %bits.to_i64()
        %xn:   I64  = %hi.lshr(48)
        ; for |x| < 2^-57 the difference atan(x) - x is under half an ulp (this covers ±0)
        %tiny: Bool = %xn.slt(0x3FC6)                  ; 0x3FFF - 57
        %huge: Bool = %xn.sgt(0x4071)                  ; 0x3FFF + 114
        select:
            %tiny -> return(%x)
            %huge -> huge(%hi, %lo, %sign)
            _ -> reduce(%hi, %lo, %xn, %sign)

    ; |x| >= 2^115, infinity or NaN
    block huge(%hi: I64, %lo: I64, %sign: I128):
        %class:    I64  = cm_atan_class(%hi, %lo)
        %signaling: Bool = %class.eq(2)
        %quiet:    Bool = %class.eq(3)
        %default:  F128 = F128 { bits: 0xFFFF8000000000000000000000000000 }
        %half_pi:  I128 = 0x3FFF921FB54442D18469898CC51701B8
        %angle:    F128 = F128 { bits: %half_pi.bitor(%sign) }
        select:
            %signaling -> return(%default)
            %quiet -> return(%x)
            _ -> return(%angle)

    block reduce(%hi: I64, %lo: I64, %xn: I64, %sign: I128):
        %mant: I64 = %hi.bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        %red:  CmAtanReduction = cm_atan_reduce(%mant, %lo, %xn)
        %kd:   I128 = cm_atan_join(%red.kd2, %red.kd1)
        %f:    I128 = cm_atan_fast_core(%red.kn, %kd, %red.dn)
        %table: Bool = %red.isct.ne(0).bitor(%red.g)
        branch %table ? with_table(%red, %f, %sign) : direct(%red, %f, %sign)

    ; atan|x| = PHI0[isct] + f, or π/2 - that past 1
    block with_table(%red: CmAtanReduction, %f: I128, %sign: I128):
        %placed:   CmAtanU192 = cm_atan_place(%f, %red.dn.add(1))
        %phi:      CmAtanU192 = cm_atan_row_top(CM_ATAN_PHI0.as_ptr(), %red.isct)
        %angle:    CmAtanU192 = cm_atan_u192_add(%phi, %placed)
        %half_pi:  CmAtanU192 = cm_atan_row_top(CM_ATAN_QOFF.as_ptr(), 1)
        %reflected: CmAtanU192 = cm_atan_u192_sub(%half_pi, %angle)
        %final:    CmAtanU192 = %red.g ? %reflected : %angle
        %rounded:  CmAtanRounded = cm_atan_round_fixed(%final)
        %result:   F128 = F128 { bits: %rounded.bits.bitor(%sign) }
        %hard:     Bool = %rounded.hard
        branch %hard ? accurate(%red, %sign) : return(%result)

    block direct(%red: CmAtanReduction, %f: I128, %sign: I128):
        %rounded: CmAtanRounded = cm_atan_round_direct(%f, %red.dn)
        %result:  F128 = F128 { bits: %rounded.bits.bitor(%sign) }
        %hard:    Bool = %rounded.hard
        branch %hard ? accurate(%red, %sign) : return(%result)

    block accurate(%red: CmAtanReduction, %sign: I128):
        %r: F128 = cm_atan_accurate(%red, %sign)
        return(%r)

; Reduces |x| = mant:lo × 2^(xn - 0x3FFF - 112) (mant carrying the implicit bit) against the
; table. Far from 1 no table angle is needed: |x| itself, or 1/|x|.
routine cm_atan_reduce(%mant: I64, %lo: I64, %xn: I64) -> CmAtanReduction
    block entry():
        %above: Bool = %xn.sge(0x3FFF)
        branch %above ? above_one() : below_one()

    block below_one():
        %e:   I64  = 0x3FFF.sub(%xn)
        %far: Bool = %e.sgt(7)
        branch %far ? small(%e) : table_below(%e)

    ; |x| < 2^-7: kn / kd = |x| itself
    block small(%e: I64):
        %kn: I128 = cm_atan_join(%mant, %lo).shl(15)
        %r: CmAtanReduction = CmAtanReduction {
            zero: false, g: false, isct: 0, dn: %e, kn: %kn, kd0: 0, kd1: 0, kd2: 0x8000000000000000
        }
        return(%r)

    ; kn = |x| - t, kd = 1 + |x| t
    block table_below(%e: I64):
        %guess_at: I64  = %mant.lshr(%e.add(41))
        %guess:    I64  := CM_ATAN_INDL[%guess_at]
        %next_at:  I64  = %guess.add(1)
        %next_tn:  I64  := CM_ATAN_TN[%next_at]
        %bump:     Bool = %next_tn.ule(%mant.lshr(%e.add(33)))
        %isct:     I64  = %guess.add(%bump.to_i64())
        %tn:       I64  := CM_ATAN_TN[%isct]
        %tt:       I64  = %tn.shl(%e.add(33))
        %norm:     CmAtanNorm = cm_atan_normalize(%mant.sub(%tt), %lo)
        %xa:       I128 = cm_atan_join(%mant, %lo).mul(%tn.to_u128())
        ; kd = 1 + xa >> e: the leading one and xa's bits under it
        %kd:       I128 = %xa.lshr(%e.to_i128())
        %kd0:      I64  = %xa.to_i64().shl(0.sub(%e).bitand(63))
        %kd2:      I64  = %kd.lshr(64).to_i64().bitor(0x8000000000000000)
        %dn:       I64  = %e.add(%norm.shift).sub(15)
        %r: CmAtanReduction = CmAtanReduction {
            zero: false, g: false, isct: %isct, dn: %dn, kn: %norm.kn,
            kd0: %kd0, kd1: %kd.to_i64(), kd2: %kd2
        }
        return(%r)

    block above_one():
        %e:   I64  = %xn.sub(0x3FFF)
        %far: Bool = %e.sgt(6)
        branch %far ? large(%e) : table_above(%e)

    ; |x| >= 2^7: kn / kd = 1 / |x|
    block large(%e: I64):
        %kd:  I128 = cm_atan_join(%mant, %lo).shl(15)
        %one: I128 = 0x80000000000000000000000000000000
        %r: CmAtanReduction = CmAtanReduction {
            zero: false, g: true, isct: 0, dn: %e, kn: %one,
            kd0: 0, kd1: %kd.to_i64(), kd2: %kd.lshr(64).to_i64()
        }
        return(%r)

    ; kn = 1 - |x| t, kd = |x| + t, the index guess moved down one when |x| t passes 1
    block table_above(%e: I64):
        %xa:       I128 = cm_atan_join(%mant, %lo)
        %guess_at: I64  = %mant.bitxor(0x0000FFFFFFFFFFFF).lshr(%e.add(42))
        %guess:    I64  := CM_ATAN_INDH[%guess_at]
        %next_at:  I64  = %guess.add(1)
        %next_tn:  I64  := CM_ATAN_TN[%next_at]
        %limit:    I64  = 1.shl(63.sub(%e))
        %bump:     Bool = %next_tn.mul(%mant).ult(%limit)
        %first:    I64  = %guess.add(%bump.to_i64())
        %first_tn: I64  := CM_ATAN_TN[%first]
        %past:     I128 = %xa.mul(%first_tn.to_u128())
        %over:     Bool = %past.lshr(64).to_i64().bitand(%limit).ne(0)
        %isct:     I64  = %over ? %first.sub(1) : %first
        %tn:       I64  := CM_ATAN_TN[%isct]
        %t:        I128 = %xa.mul(%tn.to_u128())
        ; kn = -(t << e) with its top bit flipped, normalized
        %neg:      I128 = 0.sub(%t.shl(%e.to_i128()))
        %knh:      I64  = %neg.lshr(64).to_i64().bitxor(0x8000000000000000)
        %norm:     CmAtanNorm = cm_atan_normalize(%knh, %neg.to_i64())
        %sum_hi:   I64  = %mant.add(%tn.shl(33.sub(%e)))
        %nzd:      I64  = %sum_hi.leading_zeros()
        %spill:    I64  = %lo.lshr(0.sub(%nzd).bitand(63))
        %kd2:      I64  = %sum_hi.shl(%nzd).bitor(%spill)
        %kd1:      I64  = %lo.shl(%nzd)
        %dn:       I64  = %e.add(%norm.shift).sub(%nzd).add(15)
        %r: CmAtanReduction = CmAtanReduction {
            zero: false, g: true, isct: %isct, dn: %dn, kn: %norm.kn, kd0: 0, kd1: %kd1, kd2: %kd2
        }
        return(%r)

; The accurate path: the same reduction, the series in 6 limbs.
routine cm_atan_accurate(%red: CmAtanReduction, %sign: I128) -> F128
    block entry():
        #f_buf: Ptr<Array<I64, 8>> = alloca<Array<I64, 8>>
        #f:     Ptr<I64> = #f_buf.cast<I64>()
        cm_atan_accurate_core(%red, #f)
        %table: Bool = %red.isct.ne(0).bitor(%red.g)
        branch %table ? with_table(#f) : finish(#f, %red.dn)

    block with_table(#f: Ptr<I64>):
        %dn: I64 = %red.dn
        cm_atan_limbs_shr(#f, 6, %dn.add(1))
        %row_at: I64 = %red.isct.mul(48)
        #phi:    Ptr<I64> = CM_ATAN_PHI0.as_ptr().offset(%row_at)
        cm_atan_limbs_add(#f, #phi, #f, 6)
        %inverted: Bool = %red.g
        branch %inverted ? reflect(#f) : finish(#f, -1)

    ; π/2 - f
    block reflect(#f: Ptr<I64>):
        #half_pi: Ptr<I64> = CM_ATAN_QOFF.as_ptr().offset(48)
        cm_atan_limbs_sub(#f, #half_pi, #f, 6)
        jump finish(#f, -1)

    block finish(#f: Ptr<I64>, %dn: I64):
        %bits: I128 = cm_atan_round_limbs(#f, %dn)
        %r:    F128 = F128 { bits: %bits.bitor(%sign) }
        return(%r)
