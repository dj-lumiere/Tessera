; Disl stdlib: the correctly rounded base-10 exponential 10^x of F128
;
; x × log2(10) in 3-word fixed point, then the shared 2^x engine (exp_shared.disl).
; x = 1, 2, ..., 48 give the exact power of ten. Round to nearest only: overflow
; gives +inf, underflow a correctly rounded subnormal or +0, NaN comes back quiet
; with its sign and payload.
;
; Ported from CORE-MATH, src/binary128/exp10/exp10q.c via RazorForge's B128Exp10.rf.
; Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
; MIT license: see LICENSE-CORE-MATH

; x >= 0x1.34413509f79fef311f12b35816fap+12 overflows
const CM_EXP10_OVERFLOW:  I128 = 0x400B34413509F79FEF311F12B35816FA
; x <= -0x1.3657d621f4e96893f84497c723c1p+12 rounds to +0
const CM_EXP10_UNDERFLOW: I128 = 0xC00B3657D621F4E96893F84497C723C1

; 10^x, correctly rounded.
routine f128_cm_exp10(%x: F128) -> F128
    block entry():
        %u:      I128 = %x.bits
        %hi:     I64  = cm_exp_hi(%u)
        %mag_hi: I64  = %hi.bitand(0x7FFFFFFFFFFFFFFF)
        %tiny:   Bool = %mag_hi.ult(0x3F8BBCB7B1526E50)       ; 10^x rounds to 1
        %large:  Bool = %mag_hi.uge(0x400B34413509F79F)
        select:
            %tiny -> return(CM_EXP_ONE)
            %large -> edge(%u)
            _ -> integer_check(%u)

    ; NaN, infinities, and the overflow and underflow thresholds
    block edge(%u: I128):
        %is_nan:    Bool = f128_is_nan_bits(%u)
        %overflow:  Bool = %u.sge(0).bitand(%u.uge(CM_EXP10_OVERFLOW))
        %underflow: Bool = %u.uge(CM_EXP10_UNDERFLOW)
        %quiet:     F128 = F128.from_bits(%u.bitor(F128_QUIET_BIT))
        select:
            %is_nan -> return(%quiet)
            %overflow -> return(F128.INFINITY)
            %underflow -> return(CM_EXP_ZERO)
            _ -> integer_check(%u)

    ; positive x >= 1 with no fraction bits in the low word
    block integer_check(%u: I128):
        %e:         I64  = f128_exponent(%u)
        %positive:  Bool = %u.sge(0)
        %candidate: Bool = %positive.bitand(%e.sge(16383)).bitand(%u.to_i64().eq(0))
        branch %candidate ? integer_test(%u, %e) : reduce(%u)

    ; the high word has 16 sign and exponent bits, then e - 16383 integer bits
    block integer_test(%u: I128, %e: I64):
        %hi:         I64  = cm_exp_hi(%u)
        %fraction:   I64  = %hi.shl(%e.sub(16367))
        %sig_hi:     I64  = %hi.bitand(0xFFFFFFFFFFFF).bitor(0x1000000000000)
        %n:          I64  = %sig_hi.lshr(16431.sub(%e))
        %exact:      Bool = %fraction.eq(0).bitand(%n.ule(48))
        branch %exact ? power(%n) : reduce(%u)

    block power(%n: I64):
        %r: F128 = cm_exp10_exact(%n)
        return(%r)

    ; x × log2(10): the significand times log2(10), one's-complemented for negative x
    block reduce(%u: I128):
        %hi:        I64  = cm_exp_hi(%u)
        %sign_mask: I64  = %hi.ashr(63)
        %sig:       I128 = %u.bitand(F128_FRAC_MASK).bitor(F128_IMPLICIT)
        %k4: I64 := CM_EXP_ILN102[4]
        %k5: I64 := CM_EXP_ILN102[5]
        %k6: I64 := CM_EXP_ILN102[6]
        %scaled:  CmExpWords3 = cm_exp_mul3x2_high(%k4, %k5, %k6, %sig)
        %shift:   I64 = 0x4019.sub(f128_exponent(%u))
        %reduced: CmExpWords3 = cm_exp_ashr3(cm_exp_flip3(%scaled, %sign_mask), %shift)
        %r: F128 = cm_exp_finish(%reduced, %u, CM_EXP_KIND_TEN)
        return(%r)

; 10^n for an integer n in 1..48, exact: 5^n fits 112 bits, so it is normalized to
; the significand and scaled by 2^n.
routine cm_exp10_exact(%n: I64) -> F128
    block entry():
        jump power(0, 1, %n)

    block power(%i: I64, %p: I128, %n: I64):
        %done: Bool = %i.sge(%n)
        branch %done ? pack(%p, %n) : power(%i.add(1), %p.mul(5), %n)

    block pack(%p: I128, %n: I64):
        %lz:       I64  = %p.leading_zeros().to_i64()
        %sig:      I128 = %p.shl(%lz.sub(15).to_i128())
        %exponent: I64  = 16509.sub(%lz).add(%n)
        %bits:     I128 = %sig.add(%exponent.to_i128().shl(112))
        %r: F128 = F128.from_bits(%bits)
        return(%r)
