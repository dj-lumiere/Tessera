// Tessera stdlib: 256-bit division
//
// LLVM expands i256 udiv and sdiv into a loop that retires one quotient bit per
// iteration (hundreds of nanoseconds). u256_divrem runs Knuth's algorithm D
// (TAOCP vol. 2, 4.3.1) over 64-bit limbs instead, with the digit steps from
// wide_div.tess, and U256 / S256 division calls it through u256_div, u256_rem,
// s256_div and s256_rem.
//
// A target narrower than 64 bits has its own u256_divrem over 32-bit limbs (the
// end of this file): there a U64 limb product is a U128, which LLVM spells out
// in 32-bit pieces, and a U128 division is the bit-at-a-time loop. It suits
// 32-bit x86; a target without a 64-by-32 divide (Cortex-M, RV32, AVR) would
// want its own digit step, which is open (Roadmap).
//
// The callers check the divisor first: every routine here assumes a nonzero
// divisor, and the signed ones assume the quotient fits (not MIN / -1).

module Standard::Core

record U256DivRem
    quotient  : U256
    remainder : U256

// -- limbs ---------------------------------------------------------------------

/// The 64-bit limb index of x (0 is the least significant), for index < 4.
private routine u256_limb(x: U256, index: USize) -> U64
    block entry():
        shift : U256 = index.mul(64).to<U256>()
        r     : U64  = x.shr(shift).to_wrap<U64>()
        return(r)

/// The integer with limbs (l3, l2, l1, l0), most significant first.
private routine u256_from_limbs(l3: U64, l2: U64, l1: U64, l0: U64) -> U256
    block entry():
        high : U256 = l3.to<U256>().shl(64).bitor(l2.to<U256>())
        mid  : U256 = high.shl(64).bitor(l1.to<U256>())
        r    : U256 = mid.shl(64).bitor(l0.to<U256>())
        return(r)

// -- entry points --------------------------------------------------------------

/// Unsigned quotient and remainder, for a nonzero d.
#target(size: 64)
routine u256_divrem(u: U256, d: U256) -> U256DivRem
    block entry():
        below : Bool = u.lt(d)
        branch below
            ? return(U256DivRem { quotient: 0, remainder: u })
            : narrow()

    // d <= u, so when u fits in 128 bits, both do.
    block narrow():
        fits : Bool = u.shr(128).eq(0)
        branch fits
            ? by_u128()
            : by_limbs()

    block by_u128():
        a : U128       = u.to<U128>()
        b : U128       = d.to<U128>()
        r : U256DivRem = U256DivRem { quotient: a.div(b).to<U256>(),
                remainder: a.mod(b).to<U256>() }
        return(r)

    block by_limbs():
        one_limb : Bool = d.shr(64).eq(0)
        branch one_limb
            ? by_one_limb()
            : by_several_limbs()

    block by_one_limb():
        r : U256DivRem = u256_divrem_by_limb(u, d.to<U64>())
        return(r)

    block by_several_limbs():
        r : U256DivRem = u256_divrem_knuth(u, d)
        return(r)

routine u256_div(u: U256, d: U256) -> U256
    block entry():
        r : U256DivRem = u256_divrem(u, d)
        return(r.quotient)

routine u256_rem(u: U256, d: U256) -> U256
    block entry():
        r : U256DivRem = u256_divrem(u, d)
        return(r.remainder)

/// Signed division truncates toward zero// the remainder has the dividend's sign.
/// The magnitudes go through u256_divrem: abs_diff(0) is exact even for MIN.
routine s256_div(u: S256, d: S256) -> S256
    block entry():
        magnitudes : U256DivRem = u256_divrem(u.abs_diff(0), d.abs_diff(0))
        quotient   : S256       = magnitudes.quotient.to_wrap<S256>()
        negative   : Bool       = u.is_negative().bitxor(d.is_negative())
        branch negative
            ? return(quotient.neg_wrap())
            : return(quotient)

routine s256_rem(u: S256, d: S256) -> S256
    block entry():
        magnitudes : U256DivRem = u256_divrem(u.abs_diff(0), d.abs_diff(0))
        remainder  : S256       = magnitudes.remainder.to_wrap<S256>()
        negative   : Bool       = u.is_negative()
        branch negative
            ? return(remainder.neg_wrap())
            : return(remainder)

// -- one-limb divisor ----------------------------------------------------------

/// u / d for a nonzero one-limb d: normalize so d's top bit is set, then one
/// 2-by-1 step per dividend limb, most significant first.
private routine u256_divrem_by_limb(u: U256, d: U64) -> U256DivRem
    block entry():
        shift  : U64  = d.leading_zeros()
        d_norm : U64  = d.shl(shift)
        v      : U64  = div_2by1_prepare(d_norm)
        u_norm : U256 = u.shl(shift.to<U256>())
        // The bits shifted out of the top// a funnel shift by 0 gives 0, where a
        // plain shr by 64 would be poison.
        u_over : U64        = fshl<U64>(0, u256_limb(u, 3), shift)
        s3     : Div2By1    = div_2by1(u_over, u256_limb(u_norm, 3), d_norm, v)
        s2     : Div2By1    = div_2by1(s3.remainder, u256_limb(u_norm, 2), d_norm, v)
        s1     : Div2By1    = div_2by1(s2.remainder, u256_limb(u_norm, 1), d_norm, v)
        s0     : Div2By1    = div_2by1(s1.remainder, u256_limb(u_norm, 0), d_norm, v)
        q      : U256       = u256_from_limbs(s3.quotient, s2.quotient, s1.quotient, s0.quotient)
        rem    : U64        = s0.remainder.shr(shift)
        r      : U256DivRem = U256DivRem { quotient: q, remainder: rem.to<U256>() }
        return(r)

// -- algorithm D ---------------------------------------------------------------

/// The working state of algorithm D for an n-limb divisor, 2 <= n <= 4. Both
/// operands are shifted left until the divisor's top bit is set; the shifted
/// dividend takes a fifth limb. Each step divides the window u[j .. j+n] by v
/// and leaves the window's remainder in u[j .. j+n-1], so u ends as the
/// (shifted) remainder.
private record U256Division
    u          : Array<U64, 5>  // the normalized dividend, least significant limb first
    v          : Array<U64, 4>  // the normalized divisor
    n          : USize  // the divisor's limb count
    reciprocal : U64  // div_3by2_prepare of v's top two limbs

/// u / d for a divisor of two or more limbs.
private routine u256_divrem_knuth(u: U256, d: U256) -> U256DivRem
    block entry():
        lz    : U64   = d.leading_zeros().to<U64>()
        n     : USize = 4.sub(lz.shr(6).to<USize>())
        shift : U64   = lz.bitand(63)
        claim state : @U256Division <- uninit
        state.construct(u, d, n, shift)
        jump digit(state, 4.sub(n), 0, shift)

    // Quotient digits come out most significant first, from j = 4 - n down to 0.
    block digit(state: @U256Division, j: USize, q: U256, shift: U64):
        q_digit : U64  = state.step(j)
        q_next  : U256 = q.shl(64).bitor(q_digit.to<U256>())
        done    : Bool = j.eq(0)
        branch done
            ? finish(state, q_next, shift)
            : digit(state, j.sub(1), q_next, shift)

    block finish(state: @U256Division, q: U256, shift: U64):
        l3        : U64        = state.u.get(3)
        l2        : U64        = state.u.get(2)
        l1        : U64        = state.u.get(1)
        l0        : U64        = state.u.get(0)
        shifted   : U256       = u256_from_limbs(l3, l2, l1, l0)
        remainder : U256       = shifted.shr(shift.to<U256>())
        r         : U256DivRem = U256DivRem { quotient: q, remainder: remainder }
        return(r)

routine U256Division.construct(self: @Self, u: U256, d: U256, n: USize, shift: U64) -> Void
    block entry():
        u_norm : U256 = u.shl(shift.to<U256>())
        d_norm : U256 = d.shl(shift.to<U256>())
        // A funnel shift by 0 gives 0, where a plain shr by 64 would be poison.
        u_over : U64 = fshl<U64>(0, u256_limb(u, 3), shift)
        self.u.set(0, u256_limb(u_norm, 0))
        self.u.set(1, u256_limb(u_norm, 1))
        self.u.set(2, u256_limb(u_norm, 2))
        self.u.set(3, u256_limb(u_norm, 3))
        self.u.set(4, u_over)
        self.v.set(0, u256_limb(d_norm, 0))
        self.v.set(1, u256_limb(d_norm, 1))
        self.v.set(2, u256_limb(d_norm, 2))
        self.v.set(3, u256_limb(d_norm, 3))
        self.n.store(n)
        d1         : U64 = u256_limb(d_norm, n.sub(1))
        d0         : U64 = u256_limb(d_norm, n.sub(2))
        reciprocal : U64 = div_3by2_prepare(d1, d0)
        self.reciprocal.store(reciprocal)
        return()

/// One step: the quotient digit of the window u[j .. j+n] by v, which
/// replaces the window with its remainder.
routine U256Division.step(self: @Self, j: USize) -> U64
    block entry():
        n      : USize = self.n.load()
        top_at : USize = j.add(n)
        u2     : U64   = self.u.get(top_at)
        u1     : U64   = self.u.get(top_at.sub(1))
        u0     : U64   = self.u.get(top_at.sub(2))
        d1     : U64   = self.v.get(n.sub(1))
        d0     : U64   = self.v.get(n.sub(2))
        // The window's remainder is below v, so its top limb ends as 0.
        self.u.set(top_at, 0)
        // div_3by2 needs (u2, u1) < (d1, d0). When they are equal the digit is 2^64 - 1 exactly.
        saturated : Bool = u2.eq(d1).bitand(u1.eq(d0))
        branch saturated
            ? saturated(n)
            : estimate(n, u2, u1, u0, d1, d0)

    block saturated(n: USize):
        self.submul(j, n, U64.MAX)
        return(U64.MAX)

    // The top three limbs over the top two divisor limbs give q̂ and the
    // remainder of those limbs// subtracting q̂ times the lower divisor limbs
    // finishes the window. q̂ can be one too big for n >= 3: then that
    // subtraction borrows, and v is added back.
    block estimate(n: USize, u2: U64, u1: U64, u0: U64, d1: U64, d0: U64):
        v      : U64     = self.reciprocal.load()
        top    : Div3By2 = div_3by2(u2, u1, u0, d1, d0, v)
        q_hat  : U64     = top.quotient
        borrow : U64     = self.submul(j, n.sub(2), q_hat)
        rhat   : U128    = top.remainder
        taken  : U128    = borrow.to<U128>()
        rest   : U128    = rhat.sub_wrap(taken)
        low_at : USize   = j.add(n).sub(2)
        self.u.set(low_at, rest.to_wrap<U64>())
        self.u.set(low_at.add(1), rest.shr(64).to<U64>())
        too_big : Bool = rhat.lt(taken)
        branch too_big
            ? add_back(n, q_hat)
            : return(q_hat)

    block add_back(n: USize, q_hat: U64):
        self.add_back(j, n)
        return(q_hat.sub(1))

/// u[j .. j+len-1] -= v[0 .. len-1] × m// returns the limb that borrows out of the top.
routine U256Division.submul(self: @Self, j: USize, len: USize, m: U64) -> U64
    block entry():
        jump loop(0, 0)

    block loop(i: USize, borrow: U64):
        done : Bool = i.eq(len)
        branch done
            ? return(borrow)
            : limb(i, borrow)

    // v × m + borrow < 2^128, and when its high limb is 2^64 - 1 its low limb is 0,
    // so the next borrow fits a limb.
    block limb(i: USize, borrow: U64):
        at      : USize = j.add(i)
        v_limb  : U64   = self.v.get(i)
        u_limb  : U64   = self.u.get(at)
        product : U128  = v_limb.mul_wide(m).add(borrow.to<U128>())
        low     : U64   = product.to_wrap<U64>()
        wrapped : Bool  = u_limb.lt(low)
        self.u.set(at, u_limb.sub_wrap(low))
        high : U64 = product.shr(64).to<U64>()
        jump loop(i.add(1), high.add(wrapped.to<U64>()))

/// u[j .. j+n-1] += v, dropping the carry out of the top: it cancels the borrow
/// that made the window negative.
routine U256Division.add_back(self: @Self, j: USize, n: USize) -> Void
    block entry():
        jump loop(0, 0)

    block loop(i: USize, carry: U64):
        done : Bool = i.eq(n)
        branch done
            ? return()
            : continue
        at     : USize = j.add(i)
        v_limb : U64   = self.v.get(i)
        u_limb : U64   = self.u.get(at)
        sum    : U128  = u_limb.to<U128>().add(v_limb.to<U128>()).add(carry.to<U128>())
        self.u.set(at, sum.to_wrap<U64>())
        jump loop(i.add(1), sum.shr(64).to<U64>())

// -- targets narrower than 64 bits -----------------------------------------------
//
// The same algorithm D over eight 32-bit limbs, the textbook form (Hacker's
// Delight, divmnu): a digit is estimated from the top two dividend limbs over
// the top divisor limb, a U64 by U32 division, and corrected with the next
// divisor limb (Knuth's step D3), which leaves it at most one too big.

/// The working state of algorithm D over 32-bit limbs for an n-limb divisor, 2 <= n <= 8, laid out like
/// U256Division: both operands normalized, the dividend with a ninth limb.
private record U256Division32
    u : Array<U32, 9>  // the normalized dividend, least significant limb first
    v : Array<U32, 8>  // the normalized divisor
    n : USize  // the divisor's limb count

/// Unsigned quotient and remainder, for a nonzero d.
#target(size: not 64)
routine u256_divrem(u: U256, d: U256) -> U256DivRem
    block entry():
        below : Bool = u.lt(d)
        branch below
            ? return(U256DivRem { quotient: 0, remainder: u })
            : narrow()

    // d <= u, so when u fits in 64 bits, both do.
    block narrow():
        fits : Bool = u.shr(64).eq(0)
        branch fits
            ? by_u64()
            : by_words()

    block by_u64():
        a : U64        = u.to<U64>()
        b : U64        = d.to<U64>()
        r : U256DivRem = U256DivRem { quotient: a.div(b).to<U256>(),
                remainder: a.mod(b).to<U256>() }
        return(r)

    block by_words():
        one_word : Bool = d.shr(32).eq(0)
        branch one_word
            ? by_one_word()
            : by_several_words()

    block by_one_word():
        r : U256DivRem = u256_divrem_by_word(u, d.to<U32>())
        return(r)

    block by_several_words():
        r : U256DivRem = u256_divrem_knuth32(u, d)
        return(r)

/// Writes the eight 32-bit limbs of x to dst, least significant first. Targets are little-endian, so the limbs
/// are the U256's own bytes, and reading them costs no 256-bit shifts.
private routine u256_store_words(x: U256, dst: @U32) -> Void
    block entry():
        claim slot : @U256 <- x
        jump word(0, slot.to<@U32>())

    block word(i: USize, src: @U32):
        done : Bool = i.eq(8)
        branch done
            ? return()
            : continue
        src.stride(i).load().store_into(dst.stride(i))
        jump word(i.add(1), src)

/// The U256 whose eight 32-bit limbs are at src, least significant first.
private routine u256_load_words(src: @U32) -> U256
    block entry():
        claim slot : @U256 <- uninit
        jump word(0, slot)

    block word(i: USize, slot: @U256):
        done : Bool = i.eq(8)
        branch done
            ? finish(slot)
            : continue
        src.stride(i).load().store_into(slot.to<@U32>().stride(i))
        jump word(i.add(1), slot)

    block finish(slot: @U256):
        return(slot.load())

/// u / d for a nonzero one-limb d: one U64 by U32 division per dividend limb, most significant first. No
/// normalizing: the U64 division takes any divisor.
private routine u256_divrem_by_word(u: U256, d: U32) -> U256DivRem
    block entry():
        claim words : @Array<U32, 8> <- uninit
        limbs : @U32 = words.to<@U32>()
        u256_store_words(u, limbs)
        jump word(8, 0, 0, limbs)

    block word(i: USize, q: U256, rem: U64, limbs: @U32):
        done : Bool = i.eq(0)
        branch done
            ? finish(q, rem)
            : step(i.sub(1), q, rem, limbs)

    block step(at: USize, q: U256, rem: U64, limbs: @U32):
        divisor : U64  = d.to<U64>()
        window  : U64  = rem.shl(32).bitor(limbs.stride(at).load().to<U64>())
        digit   : U64  = window.div(divisor)
        q_next  : U256 = q.shl(32).bitor(digit.to<U256>())
        jump word(at, q_next, window.sub(digit.mul(divisor)), limbs)

    block finish(q: U256, rem: U64):
        return(U256DivRem { quotient: q, remainder: rem.to<U256>() })

/// u / d for a divisor of two or more 32-bit limbs.
private routine u256_divrem_knuth32(u: U256, d: U256) -> U256DivRem
    block entry():
        lz    : U64   = d.leading_zeros().to<U64>()
        n     : USize = 8.sub(lz.shr(5).to<USize>())
        shift : U32   = lz.bitand(31).to<U32>()
        claim state : @U256Division32 <- uninit
        state.construct(u, d, n, shift)
        jump digit(state, 8.sub(n), 0, shift)

    // Quotient digits come out most significant first, from j = 8 - n down to 0.
    block digit(state: @U256Division32, j: USize, q: U256, shift: U32):
        q_digit : U32  = state.step(j)
        q_next  : U256 = q.shl(32).bitor(q_digit.to<U256>())
        done    : Bool = j.eq(0)
        branch done
            ? finish(state, q_next, shift)
            : digit(state, j.sub(1), q_next, shift)

    block finish(state: @U256Division32, q: U256, shift: U32):
        shifted   : U256 = u256_load_words(state.u.to<@U32>())
        remainder : U256 = shifted.shr(shift.to<U256>())
        return(U256DivRem { quotient: q, remainder: remainder })

routine U256Division32.construct(self: @Self, u: U256, d: U256, n: USize, shift: U32) -> Void
    block entry():
        u_norm : U256 = u.shl(shift.to<U256>())
        d_norm : U256 = d.shl(shift.to<U256>())
        // A funnel shift by 0 gives 0, where a plain shr by 32 would be poison.
        u_over : U32 = fshl<U32>(0, u.shr(224).to_wrap<U32>(), shift)
        u256_store_words(u_norm, self.u.to<@U32>())
        self.u.set(8, u_over)
        u256_store_words(d_norm, self.v.to<@U32>())
        self.n.store(n)
        return()

/// One step: the quotient digit of the window u[j .. j+n] by v, which replaces the window with its remainder.
routine U256Division32.step(self: @Self, j: USize) -> U32
    block entry():
        n      : USize = self.n.load()
        top_at : USize = j.add(n)
        u2     : U32   = self.u.get(top_at)
        u1     : U32   = self.u.get(top_at.sub(1))
        u0     : U32   = self.u.get(top_at.sub(2))
        d1     : U32   = self.v.get(n.sub(1))
        d0     : U32   = self.v.get(n.sub(2))
        // The window's top limb is at most d1, so q̂ < 2^33 and r̂ < d1.
        top   : U64 = u2.to<U64>().shl(32).bitor(u1.to<U64>())
        q_hat : U64 = top.div(d1.to<U64>())
        r_hat : U64 = top.sub(q_hat.mul_wrap(d1.to<U64>()))  // one division: a U64 one is a library call here
        jump refine(q_hat, r_hat, u0, d1, d0, n)

    // Knuth's D3: q̂ is too big while it exceeds a limb or q̂ × d0 exceeds r̂ × 2^32 + u0. Once r̂ reaches 2^32 the
    // test can't fail, and what is left is at most one too big.
    block refine(q_hat: U64, r_hat: U64, u0: U32, d1: U32, d0: U32, n: USize):
        over_limb : Bool = q_hat.gt(0xFFFFFFFF)
        branch over_limb
            ? lower(q_hat, r_hat, u0, d1, d0, n)
            : test(q_hat, r_hat, u0, d1, d0, n)

    block test(q_hat: U64, r_hat: U64, u0: U32, d1: U32, d0: U32, n: USize):
        product : U64  = q_hat.mul(d0.to<U64>())
        window  : U64  = r_hat.shl(32).bitor(u0.to<U64>())
        over    : Bool = product.gt(window)
        branch over
            ? lower(q_hat, r_hat, u0, d1, d0, n)
            : subtract(q_hat.to_wrap<U32>(), n)

    block lower(q_hat: U64, r_hat: U64, u0: U32, d1: U32, d0: U32, n: USize):
        q_less : U64  = q_hat.sub(1)
        r_more : U64  = r_hat.add(d1.to<U64>())
        again  : Bool = r_more.le(0xFFFFFFFF)
        branch again
            ? refine(q_less, r_more, u0, d1, d0, n)
            : subtract(q_less.to_wrap<U32>(), n)

    // Subtract q̂ × v from the window; a borrow out of its top means q̂ was one too big, so v is added back.
    block subtract(q_hat: U32, n: USize):
        borrow : U32   = self.submul(j, n, q_hat)
        top_at : USize = j.add(n)
        top    : U32   = self.u.get(top_at)
        self.u.set(top_at, 0)  // the window's remainder is below v
        too_big : Bool = top.lt(borrow)
        branch too_big
            ? add_back(q_hat, n)
            : return(q_hat)

    block add_back(q_hat: U32, n: USize):
        self.add_back(j, n)
        return(q_hat.sub(1))

/// u[j .. j+len-1] -= v[0 .. len-1] × m; returns the limb that borrows out of the top.
routine U256Division32.submul(self: @Self, j: USize, len: USize, m: U32) -> U32
    block entry():
        jump loop(0, 0)

    block loop(i: USize, borrow: U32):
        done : Bool = i.eq(len)
        branch done
            ? return(borrow)
            : limb(i, borrow)

    // v × m + borrow < 2^64, and when its high limb is 2^32 - 1 its low limb is 0, so the next borrow fits a limb.
    block limb(i: USize, borrow: U32):
        at      : USize = j.add(i)
        v_limb  : U32   = self.v.get(i)
        u_limb  : U32   = self.u.get(at)
        product : U64   = v_limb.mul_wide(m).add(borrow.to<U64>())
        low     : U32   = product.to_wrap<U32>()
        wrapped : Bool  = u_limb.lt(low)
        self.u.set(at, u_limb.sub_wrap(low))
        high : U32 = product.shr(32).to<U32>()
        jump loop(i.add(1), high.add(wrapped.to<U32>()))

/// u[j .. j+n-1] += v, dropping the carry out of the top: it cancels the borrow that made the window negative.
routine U256Division32.add_back(self: @Self, j: USize, n: USize) -> Void
    block entry():
        jump loop(0, 0)

    block loop(i: USize, carry: U32):
        done : Bool = i.eq(n)
        branch done
            ? return()
            : continue
        at     : USize = j.add(i)
        v_limb : U32   = self.v.get(i)
        u_limb : U32   = self.u.get(at)
        sum    : U64   = u_limb.to<U64>().add(v_limb.to<U64>()).add(carry.to<U64>())
        self.u.set(at, sum.to_wrap<U32>())
        jump loop(i.add(1), sum.shr(32).to<U32>())
