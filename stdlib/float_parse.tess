/// A value mant × 2^exp with the mantissa's top bit (127) set.
private record F128Wide
    mant: U128
    exp:  S64

/// The high 128 bits of a × b (both normalized), renormalized: the product of
/// two numbers in [2^127, 2^128) is in [2^254, 2^256).
routine f128_wide_mul(%a: F128Wide, %m: U128, %e: S64) -> F128Wide
    block entry():
        %x:    U128 = %a.mant
        %x0:   U128 = %x.bitand(0xFFFFFFFFFFFFFFFF)
        %x1:   U128 = %x.shr(64)
        %y0:   U128 = %m.bitand(0xFFFFFFFFFFFFFFFF)
        %y1:   U128 = %m.shr(64)
        %p00:  U128 = %x0.mul(%y0)
        %p01:  U128 = %x0.mul(%y1)
        %p10:  U128 = %x1.mul(%y0)
        %p11:  U128 = %x1.mul(%y1)
        %mid:  U128 = %p00.shr(64).add(%p01.bitand(0xFFFFFFFFFFFFFFFF)).add(%p10.bitand(0xFFFFFFFFFFFFFFFF))
        %hi:   U128 = %p11.add(%p01.shr(64)).add(%p10.shr(64)).add(%mid.shr(64))
        %next: U128 = %mid.shr(63).bitand(1)                 // bit 127 of the low half
        %top:  Bool = %hi.shr(127).eq(1)                     // bit 255 set
        %mant: U128 = %top ? %hi : %hi.shl(1).bitor(%next)
        %exp:  S64  = %a.exp.add(%e).add(%top ? 128 : 127)
        %r: F128Wide = F128Wide { mant: %mant, exp: %exp }
        return(%r)

routine F128.parse_faithful(%text: String) -> Result<Self, ParseFloatError>
    block entry():
        #digits: Ptr<BigNat<3>> = alloca<BigNat<3>>
        %parsed: Result<DecimalParts, ParseFloatError> = parse_decimal(%text, #digits, 38)
        %ok:     Bool            = %parsed.tag
        %parts:  DecimalParts    = %parsed.value
        %error:  ParseFloatError = %parsed.error
        %fail:   Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.err(%error)
        branch %ok ? build(%parts, #digits) : return(%fail)

    block build(%parts: DecimalParts, #digits: Ptr<BigNat<3>>):
        %negative: Bool = %parts.negative
        %sign:     U128 = %negative ? F128_SIGN : 0
        %kind:     DecimalKind = %parts.kind
        switch %kind:
            DecimalKind.Infinity -> done(%sign.bitor(F128_INF))
            DecimalKind.NaN -> done(%sign.bitor(F128_QNAN))
            DecimalKind.Finite -> finite(%parts, %negative, %sign, #digits)

    block finite(%parts: DecimalParts, %negative: Bool, %sign: U128, #digits: Ptr<BigNat<3>>):
        %length: U64  = #digits.length.load()
        %low:    U64  = #digits.limbs.get(0)
        %high:   U64  = #digits.limbs.get(1)
        %d_low:  U128 = %length.ge(1) ? %low.to_u128() : 0
        %d_high: U128 = %length.ge(2) ? %high.to_u128().shl(64) : 0
        %d:      U128 = %d_low.bitor(%d_high)
        %kept:      S64  = %parts.kept
        %exponent:  S64  = %parts.exponent
        %magnitude: S64  = %kept.add(%exponent)
        %zero: Bool = %d.eq(0).bitor(%magnitude.lt(-4966))
        %huge: Bool = %magnitude.gt(4933)
        select:
            %zero -> done(%sign)
            %huge -> done(%sign.bitor(F128_INF))
            _ -> scale(%d, %exponent, %negative, %parts.sticky)

    // d × 10^exponent: normalize d, then multiply in 10^(2^i) for every set bit of |exponent|.
    block scale(%d: U128, %exponent: S64, %negative: Bool, %sticky: Bool):
        %shift: U128 = %d.leading_zeros()
        %start: F128Wide = F128Wide { mant: %d.shl(%shift), exp: 0.sub(%shift.to_s64()) }
        %down:  Bool = %exponent.lt(0)
        %left:  U64  = %exponent.abs_diff(0)
        jump power(0, %left, %down, %start, %negative, %sticky)

    block power(%i: U64, %left: U64, %down: Bool, %w: F128Wide, %negative: Bool, %sticky: Bool):
        %done: Bool = %left.eq(0)
        branch %done ? pack(%w, %negative, %sticky) : bit(%i, %left, %down, %w, %negative, %sticky)

    block bit(%i: U64, %left: U64, %down: Bool, %w: F128Wide, %negative: Bool, %sticky: Bool):
        %set: Bool = %left.bitand(1).eq(1)
        branch %set ? times(%i, %left, %down, %w, %negative, %sticky) : power(%i.add(1), %left.shr(1), %down, %w, %negative, %sticky)

    block times(%i: U64, %left: U64, %down: Bool, %w: F128Wide, %negative: Bool, %sticky: Bool):
        %pos_m: U128 = F128_POW10_POS_MANT.get(%i)
        %pos_e: S64  = F128_POW10_POS_EXP.get(%i)
        %neg_m: U128 = F128_POW10_NEG_MANT.get(%i)
        %neg_e: S64  = F128_POW10_NEG_EXP.get(%i)
        %m:     U128 = %down ? %neg_m : %pos_m
        %e:     S64  = %down ? %neg_e : %pos_e
        %next:  F128Wide = f128_wide_mul(%w, %m, %e)
        jump power(%i.add(1), %left.shr(1), %down, %next, %negative, %sticky)

    // value = mant × 2^exp = sig × 2^(biased - 16383 - 115)
    block pack(%w: F128Wide, %negative: Bool, %sticky: Bool):
        %sig:  U128 = %w.mant.bitor(%sticky.to_u128())
        %bits: U128 = f128_round_pack(%negative, %w.exp.add(16383).add(115), %sig)
        jump done(%bits)

    block done(%bits: U128):
        %value: Self = f128_of(%bits)
        %r: Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.ok(%value)
        return(%r)
