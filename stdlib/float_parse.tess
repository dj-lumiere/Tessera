// Tessera stdlib: parsing floats
//
// F64.parse, F32.parse, F16.parse, and BF16.parse read decimal text and round
// it correctly (to nearest, ties to even), however many digits it has.
//
//     [+-] digits [. digits] [(e|E) [+-] digits]      at least one mantissa digit
//     [+-] inf | infinity | nan                        any letter case
//
// "5." and ".5" are accepted; whitespace is not. Errors are ParseFloatError:
// Empty for "", Invalid for anything else that doesn't match.
//
// The method is exact, not fast: the value becomes a fraction N / D of big
// naturals, and a bit-by-bit division gives the significand plus a remainder
// for rounding. Only the first significant digits are kept; later ones only
// record whether any was nonzero, which is enough to break a tie as long as
// every exactly-halfway decimal fits in the kept digits: 767 digits for F64,
// 11,563 for F128. So F64 and the smaller formats keep 800 digits in a
// BigNat<72>, and F128 keeps 11,600 in a BigNat<864> (stdlib/bignat.tess).

module Standard::Format

choice ParseFloatError: U8
    Empty
    Invalid

choice DecimalKind: U8
    Finite
    Infinity
    NaN

/// The parsed text: value = digits × 10^exponent, digits kept in a BigNat.
record DecimalParts
    kind:     DecimalKind
    negative: Bool
    kept:     S64       // significant digits kept
    exponent: S64
    sticky:   Bool      // a nonzero digit was dropped after the kept ones


// -- text ----------------------------------------------------------------------

routine is_ascii_digit(%c: Byte) -> Bool
    block entry():
        %r: Bool = %c.ge(b'0').bitand(%c.le(b'9'))
        return(%r)

/// Is #text[0..length) %word, ignoring ASCII letter case? %word must be lowercase letters.
routine matches_word(#text: Ptr<Byte>, %length: U64, %word: String) -> Bool
    block entry():
        %word_length: U64  = %word.length
        #letters:     Ptr<Byte> = %word.data
        %same_length: Bool = %length.eq(%word_length)
        branch %same_length ? loop(0, #letters) : return(false)

    block loop(%i: U64, #letters: Ptr<Byte>):
        %done: Bool = %i.ge(%length)
        branch %done ? return(true) : step(%i, #letters)

    block step(%i: U64, #letters: Ptr<Byte>):
        %c:      Byte   = #text[%i].load()
        %w:      Byte   = #letters[%i].load()
        %folded: Byte   = %c.bitor(0x20)
        %same:   Bool = %folded.eq(%w)
        branch %same ? loop(%i.add(1), #letters) : return(false)

/// Reads %text into DecimalParts, accumulating the kept digits in #digits.
routine parse_decimal<N>(%text: String, #digits: Ptr<BigNat<N>>, %max_kept: S64) -> Result<DecimalParts, ParseFloatError>
require N: U64
    block entry():
        #digits.set(0)
        %length: U64  = %text.length
        %empty:  Bool = %length.eq(0)
        branch %empty ? fail(ParseFloatError.Empty) : sign()

    block sign():
        #data: Ptr<Byte> = %text.data
        %c:     Byte   = #data[0].load()
        %minus: Bool = %c.eq(b'-')
        %plus:  Bool = %c.eq(b'+')
        %skip:  Bool = %minus.bitor(%plus)
        jump body(%skip.to_u64(), %minus)

    block body(%start: U64, %negative: Bool):
        #data:  Ptr<Byte> = %text.data
        #rest:  Ptr<Byte> = #data[%start]
        %left:  U64     = %text.length.sub(%start)
        %inf:   Bool    = matches_word(#rest, %left, "inf").bitor(matches_word(#rest, %left, "infinity"))
        %nan:   Bool    = matches_word(#rest, %left, "nan")
        select:
            %inf -> special(DecimalKind.Infinity, %negative)
            %nan -> special(DecimalKind.NaN, %negative)
            _ -> int_loop(%start, %negative, 0, 0, false, false)

    block special(%kind: DecimalKind, %negative: Bool):
        %parts: DecimalParts = DecimalParts { kind: %kind, negative: %negative, kept: 0, exponent: 0, sticky: false }
        %r: Result<DecimalParts, ParseFloatError> = Result<DecimalParts, ParseFloatError>.ok(%parts)
        return(%r)

    // Integer digits. Leading zeros are skipped; digits past the cap raise the exponent.
    block int_loop(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %seen: Bool):
        %at_end: Bool = %i.ge(%text.length)
        branch %at_end ? done(%negative, %kept, %exponent, %sticky, %seen)
                       : int_char(%i, %negative, %kept, %exponent, %sticky, %seen)

    block int_char(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %seen: Bool):
        #data:  Ptr<Byte> = %text.data
        %c:     Byte   = #data[%i].load()
        %digit: Bool = is_ascii_digit(%c)
        %point: Bool = %c.eq(b'.')
        select:
            %digit -> int_digit(%i, %negative, %kept, %exponent, %sticky, %c.to_u8().sub(b'0'.to_u8()).to_u64())
            %point -> frac_loop(%i.add(1), %negative, %kept, %exponent, %sticky, %seen)
            _ -> exponent_mark(%i, %negative, %kept, %exponent, %sticky, %seen)

    block int_digit(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %d: U64):
        %leading: Bool = %kept.eq(0).bitand(%d.eq(0))
        %full:    Bool = %kept.ge(%max_kept)
        %next:    U64  = %i.add(1)
        select:
            %leading -> int_loop(%next, %negative, %kept, %exponent, %sticky, true)
            %full -> int_loop(%next, %negative, %kept, %exponent.add(1), %sticky.bitor(%d.ne(0)), true)
            _ -> int_keep(%next, %negative, %kept, %exponent, %sticky, %d)

    block int_keep(%next: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %d: U64):
        #digits.mul_add(10, %d)
        jump int_loop(%next, %negative, %kept.add(1), %exponent, %sticky, true)

    // Fraction digits. Each one kept, or each leading zero, lowers the exponent.
    block frac_loop(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %seen: Bool):
        %at_end: Bool = %i.ge(%text.length)
        branch %at_end ? done(%negative, %kept, %exponent, %sticky, %seen)
                       : frac_char(%i, %negative, %kept, %exponent, %sticky, %seen)

    block frac_char(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %seen: Bool):
        #data:  Ptr<Byte> = %text.data
        %c:     Byte   = #data[%i].load()
        %digit: Bool = is_ascii_digit(%c)
        branch %digit ? frac_digit(%i, %negative, %kept, %exponent, %sticky, %c.to_u8().sub(b'0'.to_u8()).to_u64())
                      : exponent_mark(%i, %negative, %kept, %exponent, %sticky, %seen)

    block frac_digit(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %d: U64):
        %leading: Bool = %kept.eq(0).bitand(%d.eq(0))
        %full:    Bool = %kept.ge(%max_kept)
        %next:    U64  = %i.add(1)
        select:
            %leading -> frac_loop(%next, %negative, %kept, %exponent.sub(1), %sticky, true)
            %full -> frac_loop(%next, %negative, %kept, %exponent, %sticky.bitor(%d.ne(0)), true)
            _ -> frac_keep(%next, %negative, %kept, %exponent, %sticky, %d)

    block frac_keep(%next: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %d: U64):
        #digits.mul_add(10, %d)
        jump frac_loop(%next, %negative, %kept.add(1), %exponent.sub(1), %sticky, true)

    // After the mantissa only an exponent may follow: e or E, a sign, digits.
    block exponent_mark(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %seen: Bool):
        #data:  Ptr<Byte> = %text.data
        %c:     Byte   = #data[%i].load()
        %mark:  Bool = %c.bitor(0x20).eq(b'e')
        %valid: Bool = %mark.bitand(%seen)
        branch %valid ? exponent_sign(%i.add(1), %negative, %kept, %exponent, %sticky) : fail(ParseFloatError.Invalid)

    block exponent_sign(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool):
        %at_end: Bool = %i.ge(%text.length)
        branch %at_end ? fail(ParseFloatError.Invalid) : read_sign(%i, %negative, %kept, %exponent, %sticky)

    block read_sign(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool):
        #data:  Ptr<Byte> = %text.data
        %c:     Byte   = #data[%i].load()
        %minus: Bool = %c.eq(b'-')
        %plus:  Bool = %c.eq(b'+')
        %skip:  U64  = %minus.bitor(%plus).to_u64()
        %first: U64  = %i.add(%skip)
        %has_digit: Bool = %first.lt(%text.length)
        branch %has_digit ? exp_loop(%first, %negative, %kept, %exponent, %sticky, %minus, 0)
                          : fail(ParseFloatError.Invalid)

    // The exponent saturates at 1,000,000, far past any float's range.
    block exp_loop(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %exp_minus: Bool, %value: S64):
        %at_end: Bool = %i.ge(%text.length)
        branch %at_end ? exp_done(%negative, %kept, %exponent, %sticky, %exp_minus, %value)
                       : exp_char(%i, %negative, %kept, %exponent, %sticky, %exp_minus, %value)

    block exp_char(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %exp_minus: Bool, %value: S64):
        #data:  Ptr<Byte> = %text.data
        %c:     Byte   = #data[%i].load()
        %digit: Bool = is_ascii_digit(%c)
        branch %digit ? exp_digit(%i, %negative, %kept, %exponent, %sticky, %exp_minus, %value, %c)
                      : fail(ParseFloatError.Invalid)

    block exp_digit(%i: U64, %negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %exp_minus: Bool, %value: S64, %c: Byte):
        %d:    S64 = %c.to_u8().sub(b'0'.to_u8()).to_s64()
        %next: S64 = %value.mul(10).add(%d).min(1000000)
        jump exp_loop(%i.add(1), %negative, %kept, %exponent, %sticky, %exp_minus, %next)

    block exp_done(%negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %exp_minus: Bool, %value: S64):
        %signed: S64 = %exp_minus ? %value.neg() : %value
        jump done(%negative, %kept, %exponent.add(%signed), %sticky, true)

    block done(%negative: Bool, %kept: S64, %exponent: S64, %sticky: Bool, %seen: Bool):
        %parts: DecimalParts = DecimalParts {
            kind: DecimalKind.Finite, negative: %negative, kept: %kept, exponent: %exponent, sticky: %sticky
        }
        %r: Result<DecimalParts, ParseFloatError> = Result<DecimalParts, ParseFloatError>.ok(%parts)
        branch %seen ? return(%r) : fail(ParseFloatError.Invalid)

    block fail(%error: ParseFloatError):
        %r: Result<DecimalParts, ParseFloatError> = Result<DecimalParts, ParseFloatError>.err(%error)
        return(%r)

// -- rounding ------------------------------------------------------------------

/// The IEEE bits, without the sign, of the float nearest to the parsed value,
/// for a format with %mantissa_bits stored bits, exponent bias %bias, and
/// all-ones exponent %exponent_max.
routine decimal_to_bits<N>(
    #digits: Ptr<BigNat<N>>, %parts: DecimalParts, %mantissa_bits: S64, %bias: S64, %exponent_max: S64,
    %huge_from: S64, %tiny_below: S64
) -> U128
require N: U64
    block entry():
        %infinity: U128 = %exponent_max.to_u128().shl(%mantissa_bits.to_u128())
        %quiet:    U128 = 1.shl(%mantissa_bits.sub(1).to_u128())
        %kind: DecimalKind = %parts.kind
        switch %kind:
            DecimalKind.Infinity -> return(%infinity)
            DecimalKind.NaN -> return(%infinity.bitor(%quiet))
            DecimalKind.Finite -> finite(%infinity)

    // Below 10^tiny_below everything rounds to zero; from 10^huge_from up, to
    // infinity. In between, the numbers stay inside BigNat's capacity.
    block finite(%infinity: U128):
        %zero:      Bool = #digits.is_zero()
        %kept:      S64  = %parts.kept
        %exponent:  S64  = %parts.exponent
        %magnitude: S64  = %kept.add(%exponent)
        %huge:      Bool = %magnitude.gt(%huge_from)
        %tiny:      Bool = %magnitude.lt(%tiny_below)
        select:
            %zero -> return(0)
            %tiny -> return(0)
            %huge -> return(%infinity)
            _ -> scale(%exponent, %infinity)

    // value = n / d exactly
    block scale(%exponent: S64, %infinity: U128):
        #d:       Ptr<BigNat<N>> = alloca<BigNat<N>>
        #d.set(1)
        %up: Bool = %exponent.ge(0)
        branch %up ? scale_up(%exponent, %infinity, #d) : scale_down(%exponent, %infinity, #d)

    block scale_up(%exponent: S64, %infinity: U128, #d: Ptr<BigNat<N>>):
        #digits.mul_pow10(%exponent.to_u64())
        jump estimate(%infinity, #d)

    block scale_down(%exponent: S64, %infinity: U128, #d: Ptr<BigNat<N>>):
        #d.mul_pow10(%exponent.abs_diff(0))
        jump estimate(%infinity, #d)

    // Pick the binary exponent e so that q = floor(value / 2^e) has
    // mantissa_bits + 1 bits, or fewer at the subnormal floor.
    block estimate(%infinity: U128, #d: Ptr<BigNat<N>>):
        %log2:  S64 = #digits.bit_length().to_s64().sub(#d.bit_length().to_s64())
        %floor: S64 = 1.sub(%bias).sub(%mantissa_bits)
        %e:     S64 = %log2.sub(%mantissa_bits).sub(1).max(%floor)
        #a: Ptr<BigNat<N>> = alloca<BigNat<N>>
        #b: Ptr<BigNat<N>> = alloca<BigNat<N>>
        #t: Ptr<BigNat<N>> = alloca<BigNat<N>>
        jump attempt(%e, %infinity, #d, #a, #b, #t)

    // a / b = value / 2^e
    block attempt(%e: S64, %infinity: U128, #d: Ptr<BigNat<N>>, #a: Ptr<BigNat<N>>, #b: Ptr<BigNat<N>>, #t: Ptr<BigNat<N>>):
        #a.copy_from(#digits)
        #b.copy_from(#d)
        %negative_e: Bool = %e.lt(0)
        branch %negative_e ? widen_a(%e, %infinity, #d, #a, #b, #t) : widen_b(%e, %infinity, #d, #a, #b, #t)

    block widen_a(%e: S64, %infinity: U128, #d: Ptr<BigNat<N>>, #a: Ptr<BigNat<N>>, #b: Ptr<BigNat<N>>, #t: Ptr<BigNat<N>>):
        #a.shl(%e.abs_diff(0))
        jump divide(%e, %infinity, #d, #a, #b, #t)

    block widen_b(%e: S64, %infinity: U128, #d: Ptr<BigNat<N>>, #a: Ptr<BigNat<N>>, #b: Ptr<BigNat<N>>, #t: Ptr<BigNat<N>>):
        #b.shl(%e.to_u64())
        jump divide(%e, %infinity, #d, #a, #b, #t)

    // The estimate can be one bit short; then q has a bit too many: try e + 1.
    block divide(%e: S64, %infinity: U128, #d: Ptr<BigNat<N>>, #a: Ptr<BigNat<N>>, #b: Ptr<BigNat<N>>, #t: Ptr<BigNat<N>>):
        %q:       U128 = #a.div_small(#b, #t, %mantissa_bits.add(3).to_u64())
        %limit:   U128 = 1.shl(%mantissa_bits.add(1).to_u128())
        %too_big: Bool = %q.ge(%limit)
        branch %too_big ? attempt(%e.add(1), %infinity, #d, #a, #b, #t) : round(%e, %q, %infinity, #a, #b)

    // Round to nearest, ties to even. The remainder is in a; compare 2a with b.
    block round(%e: S64, %q: U128, %infinity: U128, #a: Ptr<BigNat<N>>, #b: Ptr<BigNat<N>>):
        #a.shl(1)
        %half:   S32  = #a.compare(#b)
        %above:  Bool = %half.gt(0)
        %tie:    Bool = %half.eq(0)
        %sticky: Bool = %parts.sticky
        %odd:    Bool = %q.bitand(1).eq(1)
        %up:     Bool = %above.bitor(%tie.bitand(%sticky.bitor(%odd)))
        %rounded: U128 = %q.add(%up.to_u128())
        // rounding up can carry into a new bit
        %carry:  Bool = %rounded.eq(1.shl(%mantissa_bits.add(1).to_u128()))
        %q2:     U128 = %carry ? %rounded.shr(1) : %rounded
        %e2:     S64  = %e.add(%carry.to_s64())
        %hidden: U128 = 1.shl(%mantissa_bits.to_u128())
        %normal: Bool = %q2.ge(%hidden)
        %biased: S64  = %normal ? %e2.add(%mantissa_bits).add(%bias) : 0
        %overflow: Bool = %biased.ge(%exponent_max)
        %bits:   U128 = %biased.to_u128().shl(%mantissa_bits.to_u128()).bitor(%q2.bitand(%hidden.sub(1)))
        branch %overflow ? return(%infinity) : return(%bits)

// -- parse ---------------------------------------------------------------------

routine F64.parse(%text: String) -> Result<Self, ParseFloatError>
    block entry():
        #digits: Ptr<BigNat<72>> = alloca<BigNat<72>>
        %parsed: Result<DecimalParts, ParseFloatError> = parse_decimal(%text, #digits, 800)
        %ok:     Bool           = %parsed.tag
        %parts:  DecimalParts   = %parsed.value
        %error:  ParseFloatError = %parsed.error
        %fail:   Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.err(%error)
        branch %ok ? build(%parts, #digits) : return(%fail)

    block build(%parts: DecimalParts, #digits: Ptr<BigNat<72>>):
        %magnitude: U64  = decimal_to_bits(#digits, %parts, 52, 1023, 2047, 310, -324).to_u64()
        %negative:  Bool = %parts.negative
        %sign:      U64  = %negative ? 0x8000000000000000 : 0
        %value:     Self = Self.from_bits(%magnitude.bitor(%sign).bits())
        %r: Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.ok(%value)
        return(%r)

routine F32.parse(%text: String) -> Result<Self, ParseFloatError>
    block entry():
        #digits: Ptr<BigNat<72>> = alloca<BigNat<72>>
        %parsed: Result<DecimalParts, ParseFloatError> = parse_decimal(%text, #digits, 800)
        %ok:     Bool           = %parsed.tag
        %parts:  DecimalParts   = %parsed.value
        %error:  ParseFloatError = %parsed.error
        %fail:   Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.err(%error)
        branch %ok ? build(%parts, #digits) : return(%fail)

    block build(%parts: DecimalParts, #digits: Ptr<BigNat<72>>):
        %magnitude: U32  = decimal_to_bits(#digits, %parts, 23, 127, 255, 310, -324).to_u32()
        %negative:  Bool = %parts.negative
        %sign:      U32  = %negative ? 0x80000000 : 0
        %value:     Self = Self.from_bits(%magnitude.bitor(%sign).bits())
        %r: Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.ok(%value)
        return(%r)

routine F16.parse(%text: String) -> Result<Self, ParseFloatError>
    block entry():
        #digits: Ptr<BigNat<72>> = alloca<BigNat<72>>
        %parsed: Result<DecimalParts, ParseFloatError> = parse_decimal(%text, #digits, 800)
        %ok:     Bool           = %parsed.tag
        %parts:  DecimalParts   = %parsed.value
        %error:  ParseFloatError = %parsed.error
        %fail:   Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.err(%error)
        branch %ok ? build(%parts, #digits) : return(%fail)

    block build(%parts: DecimalParts, #digits: Ptr<BigNat<72>>):
        %magnitude: U16  = decimal_to_bits(#digits, %parts, 10, 15, 31, 310, -324).to_u16()
        %negative:  Bool = %parts.negative
        %sign:      U16  = %negative ? 0x8000 : 0
        %value:     Self = Self.from_bits(%magnitude.bitor(%sign).bits())
        %r: Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.ok(%value)
        return(%r)

routine BF16.parse(%text: String) -> Result<Self, ParseFloatError>
    block entry():
        #digits: Ptr<BigNat<72>> = alloca<BigNat<72>>
        %parsed: Result<DecimalParts, ParseFloatError> = parse_decimal(%text, #digits, 800)
        %ok:     Bool           = %parsed.tag
        %parts:  DecimalParts   = %parsed.value
        %error:  ParseFloatError = %parsed.error
        %fail:   Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.err(%error)
        branch %ok ? build(%parts, #digits) : return(%fail)

    block build(%parts: DecimalParts, #digits: Ptr<BigNat<72>>):
        %magnitude: U16  = decimal_to_bits(#digits, %parts, 7, 127, 255, 310, -324).to_u16()
        %negative:  Bool = %parts.negative
        %sign:      U16  = %negative ? 0x8000 : 0
        %value:     Self = Self.from_bits(%magnitude.bitor(%sign).bits())
        %r: Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.ok(%value)
        return(%r)

routine F128.parse(%text: String) -> Result<Self, ParseFloatError>
    block entry():
        #digits: Ptr<BigNat<864>> = alloca<BigNat<864>>
        %parsed: Result<DecimalParts, ParseFloatError> = parse_decimal(%text, #digits, 11600)
        %ok:     Bool           = %parsed.tag
        %parts:  DecimalParts   = %parsed.value
        %error:  ParseFloatError = %parsed.error
        %fail:   Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.err(%error)
        branch %ok ? build(%parts, #digits) : return(%fail)

    // F128's largest value is about 1.19e4932; its smallest subnormal, 6.5e-4966.
    block build(%parts: DecimalParts, #digits: Ptr<BigNat<864>>):
        %magnitude: U128 = decimal_to_bits(#digits, %parts, 112, 16383, 32767, 4933, -4966)
        %negative:  Bool = %parts.negative
        %sign:      U128 = %negative ? F128_SIGN : 0
        %value:     Self = f128_of(%magnitude.bitor(%sign))
        %r: Result<Self, ParseFloatError> = Result<Self, ParseFloatError>.ok(%value)
        return(%r)

// -- F128, faithful ------------------------------------------------------------
//
// F128.parse_faithful trades correct rounding for speed and a small stack: the
// result is one of the two F128 values around the decimal (error below 1 ulp),
// and differs from F128.parse only when the decimal is within about 2^-7 ulp of
// a halfway point. No BigNat: the first 38 significant digits go into a U128,
// and the power of ten is a product of 10^(±2^i) taken from a table of 128-bit
// mantissas (each rounded to nearest), keeping the high 128 bits of every
// product. At most 13 products, 13 table roundings (2^-128 each), 13 dropped
// product halves (under 2^-127 each), and the digits past 38 (under 10^-37)
// add up to less than 2^-120 relative error, which 113-bit rounding turns into
// at most 0.5 + 2^-7 ulp.

preset F128_POW10_POS_MANT: Array<U128, 13> = [
    0xA0000000000000000000000000000000,
    0xC8000000000000000000000000000000,
    0x9C400000000000000000000000000000,
    0xBEBC2000000000000000000000000000,
    0x8E1BC9BF040000000000000000000000,
    0x9DC5ADA82B70B59DF020000000000000,
    0xC2781F49FFCFA6D53CBF6B71C76B25FB,
    0x93BA47C980E98CDFC66F336C36B10137,
    0xAA7EEBFB9DF9DE8DDDBB901B98FEEAB8,
    0xE319A0AEA60E91C6CC655C54BC5058F9,
    0xC976758681750C17650D3D28F18B50CE,
    0x9E8B3B5DC53D5DE4A74D28CE329ACE52,
    0xC46052028A20979AC94C153F804A4A92
]
preset F128_POW10_POS_EXP: Array<S64, 13> = [
    -124, -121, -114, -101, -74, -21, 85, 298, 723, 1573, 3274, 6676, 13479
]
preset F128_POW10_NEG_MANT: Array<U128, 13> = [
