// Tessera stdlib: the correctly rounded arc cosine of F16
//
// Evaluated in F32 on t = |x|: degree-4 minimax polynomials for acos on
// [0, 0.25] and [0.25, 0.5], and for acos(t)/sqrt(1 - t) on [0.5, 1]; a
// negative x uses acos(x) = pi - acos(-x). The coefficients were tuned to
// leave only a few exceptional inputs, handled explicitly. Round to nearest
// only: |x| > 1, +-inf and NaN give the default NaN 0xFE00 (the original's NaN
// test never holds, so a NaN input takes the |x| > 1 path too).
//
// Ported from CORE-MATH, src/binary16/acos/acosf16.c via RazorForge's B16Acos.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// arccos(self), correctly rounded.
routine F16.acos(self: Self) -> Self
    block entry():
        v        : F32  = self.to<F32>()
        u        : U32  = v.bits()
        au       : U32  = u.bitand(0x7FFFFFFF)
        negative : Bool = u.shr(31).eq(1)
        outside  : Bool = au.ge(0x3F800000)  // NaN, infinity or |x| >= 1
        t        : F32  = v.abs()
        tt       : F32  = t.mul(t)
        when:
            outside           -> outside(au, negative)
            au.lt(0x3E800000) -> below_quarter(u, au, negative, t, tt)
            au.lt(0x3F000000) -> below_half(negative, t, tt)
            else              -> above_half(negative, t, tt)

    block outside(au: U32, negative: Bool):
        one : Bool = au.eq(0x3F800000)
        when:
            one.bitand(negative) -> return(F32.to<Self>(0x1.921fb6p+1))
            one                  -> return(Self.from_bits(0))
            else                 -> return(Self.from_bits(0xFE00))

    // |x| < 0.25
    block below_quarter(u: U32, au: U32, negative: Bool, t: F32, tt: F32):
        c1 : F32 = F32.mul_add(-0x1.25e6b8p-10, t, -0x1.fffb44p-1)
        c3 : F32 = F32.mul_add(-0x1.a85b22p-5, t, -0x1.3cc114p-3)
        y  : F32 = c3.mul_add(tt, c1).mul_add(t, 0x1.921fb4p+0)
        branch negative
            ? below_quarter_negative(u, au, y)
            : return(y.to<Self>())

    // pi - acos(-x), except for the inputs the tuned coefficients could not fix
    block below_quarter_negative(u: U32, au: U32, y: F32):
        // x = -0x1.2cp-18, -0x1.3p-18 or -0x1.34p-18
        near_zero : Bool = au.between(0x36960000, 0x369A0000)
        when:
            near_zero        -> return(F32.to<Self>(0x1.922002p+0))
            u.eq(0xBCF80000) -> return(F32.to<Self>(0x1.99e002p+0))  // x = -0x1.fp-6
            u.eq(0xBCFC0000) -> return(F32.to<Self>(0x1.9a0006p+0))  // x = -0x1.f8p-6
            else             -> return(F32.sub(0x1.921fb4p+1, y).to<Self>())

    // 0.25 <= |x| < 0.5
    block below_half(negative: Bool, t: F32, tt: F32):
        c1 : F32 = F32.mul_add(-0x1.bd043ap-4, t, -0x1.f515cap-1)
        c3 : F32 = F32.mul_add(-0x1.190806p-2, t, 0x1.7e2d5ap-4)
        y  : F32 = c3.mul_add(tt, c1).mul_add(t, 0x1.91b678p+0)
        jump finish(negative, y)

    // 0.5 <= |x| < 1: acos(t) = sqrt(1 - t) p(t)
    block above_half(negative: Bool, t: F32, tt: F32):
        c1 : F32 = F32.mul_add(0x1.31640cp-4, t, -0x1.ae5c5ep-3)
        c3 : F32 = F32.mul_add(0x1.251b5p-8, t, -0x1.98038p-6)
        p  : F32 = c3.mul_add(tt, c1).mul_add(t, 0x1.91fa1cp+0)
        jump finish(negative, F32.sub(1.0, t).sqrt().mul(p))

    block finish(negative: Bool, y: F32):
        branch negative
            ? return(F32.sub(0x1.921fb4p+1, y).to<Self>())
            : return(y.to<Self>())
