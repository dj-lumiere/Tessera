/// atanh(self), correctly rounded.
routine F16.atanh(%self: Self) -> Self
    block entry():
        %t       : F32  = %self.to_f32()
        %u       : U32  = %t.bits()
        %au      : U32  = %u.bitand(0x7FFFFFFF)
        %outside : Bool = %au.ge(0x3F800000)
        %s       : F32  = %u.shr(31).eq(1) ? -1.0 : 1.0  // atanh(-x) = -atanh(x)
        %table   : Bool = %au.ge(0x3F000000)
        %tiny    : Bool = %au.le(0x3CE88000)  // for |x| <= 0x1.d1p-6, atanh(x) rounds to x
        when:
            %outside           -> outside(%u, %au)
            %table             -> return(%s.mul(cm_f16_atanh_t1(%au)).to_f16())
            %tiny              -> tiny(%t, %au)
            %au.eq(0x3DA78000) -> return(%s.mul(0x1.4fbffep-4).to_f16())  // |x| = 0x1.4fp-4
            else               -> poly(%t)

    // |x| = 1 is a pole, NaN gives x + x (quiets a signaling NaN), and |x| > 1 has
    // no real result (the default NaN of x86)
    block outside(%u: U32, %au: U32):
        %one : Bool = %au.eq(0x3F800000)
        %nan : Bool = %au.gt(0x7F800000)
        when:
            %one.bitand(%au.eq(%u)) -> return(Self.from_bits(0x7C00))
            %one                    -> return(Self.from_bits(0xFC00))
            %nan                    -> return(%self.add(%self))
            else                    -> return(Self.from_bits(0xFE00))

    block tiny(%t: F32, %au: U32):
        %zero : Bool = %au.eq(0)
        branch %zero ? return(%self) : return(%t.mul_add(0x1p-12, %t).to_f16())

    // an odd degree-11 polynomial approximating atanh(x) on [0, 1/2]
    block poly(%t: F32):
        %tt  : F32 = %t.mul(%t)
        %tt2 : F32 = %tt.mul(%tt)
        %c9  : F32 = F32.mul_add(0x1.43b244p-3, %tt, 0x1.871ffp-4)
        %c5  : F32 = F32.mul_add(0x1.2785fcp-3, %tt, 0x1.997ceep-3)
        %c1  : F32 = F32.mul_add(0x1.55558ep-2, %tt, 0x1.000004p+0)
        %d5  : F32 = %c9.mul_add(%tt2, %c5)
        %d1  : F32 = %d5.mul_add(%tt2, %c1)
        return(%t.mul(%d1).to_f16())

/// The table entry for 1/2 <= |x| < 1, whose F32 bits are au.
private routine cm_f16_atanh_t1(%au: U32) -> F32
    block entry():
        return(F32.from_bits(CM_F16_ATANH_T1.get(%au.sub(0x3F000000).shr(13).to_usize())))
