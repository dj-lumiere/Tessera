/// 2^(i/64) rounded to F64 (bit patterns), for 0 <= i < 64.
preset CM_F16_POW_EXP_TB: Array<U64, 64> = [0x3FF0000000000000, 0x3FF02C9A3E778061,
        0x3FF059B0D3158574, 0x3FF0874518759BC8, 0x3FF0B5586CF9890F, 0x3FF0E3EC32D3D1A2,
