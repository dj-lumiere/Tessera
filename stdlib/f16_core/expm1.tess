// Tessera stdlib: the correctly rounded e^x - 1 of F16
//
// For |x| < 0x1.b4p-6 a degree-3 Taylor polynomial in F32, with the few hard
// cases near 0 listed. Otherwise x = x1 + x2, where x1 keeps the upper 11 bits
// of the encoding and x2 the sign, the exponent and the lower 5 bits:
// e^x - 1 = e^x1 e^x2 - 1, both factors tabulated as F32 values, combined with
// one fused multiply-add. Round to nearest only: overflow gives +inf, large
// negative x gives -1, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary16/expm1/expm1f16.c via RazorForge's B16Expm1.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// e^self - 1, accurate near 0.
routine F16.exp_m1(%self: Self) -> Self
    block entry():
        %u     : U16  = %self.bits()
        %au    : U16  = %u.bitand(0x7FFF)
        %small : Bool = %au.lt(0x26D0)  // |x| < 0x1.b4p-6
        branch %small ? small(%u, %au) : split(%u)

    block small(%u: U16, %au: U16):
        %positive : Bool = %u.eq(%au)
        when:
            %u.eq(0x11A8) -> return(F32.to_f16(0x1.6a2002p-11))  // x = 0x1.6ap-11 is a hard case
            %au.eq(1)     -> tiny(%positive, 0x1.000002p-24, -0x1.fffffep-25)  // |x| = 2^-24
            %au.eq(2)     -> tiny(%positive, 0x1.000002p-23, -0x1.fffffep-24)  // |x| = 2^-23
            %au.eq(0)     -> return(%self)
            else          -> taylor()

    block tiny(%positive: Bool, %up: F32, %down: F32):
        %r : F32 = %positive ? %up : %down
        return(%r.to_f16())

    // x + x^2/2 + x^3/6
    block taylor():
        %t  : F32 = %self.to_f32()
        %c2 : F32 = %t.mul_add(0x1.555556p-3, 0.5)
        %r  : F32 = %c2.mul(%t).mul_add(%t, %t)
        return(%r.to_f16())

    block split(%u: U16):
        %i1     : USize = %u.shr(5).to_usize()
        %i2     : USize = %u.shr(10).shl(5).bitor(%u.bitand(0x1F)).to_usize()
        %t1     : U32   = CM_F16_EXPM1_T1.get(%i1)
        %t2     : U32   = CM_F16_EXPM1_T2.get(%i2)
        %is_nan : Bool  = %self.is_nan()
        // the fused multiply-add of the original yields T2's NaN first
        branch %is_nan ? return(cm_f16_expm1_pick_nan(%t2, %t1)) : continue
        %r : F32 = F32.from_bits(%t1).mul_add(F32.from_bits(%t2), -1.0)
        return(%r.to_f16())

// For a NaN input both table entries may be NaN patterns, so the NaN is picked
// explicitly instead of relying on the platform's NaN propagation: the F32
// pattern first when it is a NaN, else second, quieted and narrowed to F16 by
// truncating its payload, as the x86 reference does.
private routine cm_f16_expm1_pick_nan(%first: U32, %second: U32) -> F16
    block entry():
        %first_nan : Bool = %first.bitand(0x7FFFFFFF).gt(0x7F800000)
        %n         : U32  = %first_nan ? %first : %second
        %quiet     : U32  = %n.bitor(0x00400000)
        %h         : U32  = %quiet.shr(16).bitand(0x8000).bitor(0x7C00).bitor(%quiet.shr(13).bitand(0x3FF))
        return(F16.from_bits(%h.to_u16()))

/// F32 bit patterns of exp(x1), where the F16 encoding of x1 is `i1 * 2^5` (capped to the largest/smallest F32
/// when out of range, NaN patterns for the infinity/NaN encodings).
