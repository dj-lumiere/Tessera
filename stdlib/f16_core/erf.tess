/// The error function.
routine F16.erf(self: Self) -> Self
    block entry():
        xf    : F32  = self.to<F32>()
        ax    : F32  = xf.abs()
        ux    : U32  = ax.bits()
        large : Bool = ux.gt(0x407AD444)  // for |x| > 0x1.f5a888p+1, erf(x) rounds to +-1
        small : Bool = ux.lt(0x3EE00000)  // |x| < 0x1.cp-2
        when:
            large -> large(xf, ux)
            small -> small(xf.to<F64>())
            else  -> table(xf.to<F64>(), ax)

    block large(xf: F32, ux: U32):
        os : F32 = F32.copysign(1.0, xf)
        when:
            ux.gt(0x7F800000) -> return(xf.add(xf).to<Self>())
            ux.eq(0x7F800000) -> return(os.to<Self>())
            else              -> return(os.sub(F32.mul(0x1p-25, os)).to<Self>())

    // an odd polynomial in x
    block small(s: F64):
        z2 : F64 = s.mul(s)
        z4 : F64 = z2.mul(z2)
        z8 : F64 = z4.mul(z4)
        c0 : F64 = z2.mul(-0x1.812746b0375fbp-2).add(0x1.20dd750429b6dp+0)
        c2 : F64 = z2.mul(-0x1.b82ce2cbf0838p-6).add(0x1.ce2f219fd6f45p-4)
        c4 : F64 = z2.mul(-0x1.c025bfc879c94p-11).add(0x1.565bb655adb85p-8)
        c6 : F64 = z2.mul(-0x1.cc67bd88f5867p-17).add(0x1.f81718f61309cp-14)
        d0 : F64 = c0.add(z4.mul(c2))
        d4 : F64 = c4.add(z4.mul(c6))
        e0 : F64 = d0.add(z8.mul(d4))
        return(s.mul(e0).to<Self>())

    // |x| in [i/16, (i+1)/16): a degree-7 polynomial around i/16 + 1/32
    block table(s: F64, ax: F32):
        z0       : F64   = ax.to<F64>()
        v        : F64   = F64.mul(16.0, z0).floor()
        interval : U64   = F32.mul(16.0, ax).to<U64>()
        i        : USize = interval.to<USize>()
        z        : F64   = z0.sub(0.03125).sub(F64.mul(0.0625, v))
        row      : USize = i.sub(7).mul(8)
        zz2      : F64   = z.mul(z)
        zz4      : F64   = zz2.mul(zz2)
        d0       : F64   = cm_f16_erf_c(row, 0).add(z.mul(cm_f16_erf_c(row, 1)))
        d2       : F64   = cm_f16_erf_c(row, 2).add(z.mul(cm_f16_erf_c(row, 3)))
        d4       : F64   = cm_f16_erf_c(row, 4).add(z.mul(cm_f16_erf_c(row, 5)))
        d6       : F64   = cm_f16_erf_c(row, 6).add(z.mul(cm_f16_erf_c(row, 7)))
        e0       : F64   = d0.add(zz2.mul(d2))
        e4       : F64   = d4.add(zz2.mul(d6))
        f        : F64   = e0.add(zz4.mul(e4))
        return(f.copysign(s).to<Self>())

/// Coefficient k of the table row starting at row.
private routine cm_f16_erf_c(row: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F16_ERF_C.get(row.add(k))))
