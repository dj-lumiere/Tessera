// Tessera stdlib: the correctly rounded error function of F16
//
// For |x| < 0x1.cp-2 an odd polynomial in x; up to 0x1.f5a888p+1 a degree-7
// polynomial around i/16 + 1/32 from a table, all in F64. Above that erf(x)
// rounds to +-1. Round to nearest only: +-inf gives +-1, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary16/erf/erff16.c via RazorForge's B16Erf.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca> and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// For 7 <= i < 63, entries 8 (i - 7) .. 8 (i - 7) + 7 are a degree-7 polynomial approximating
