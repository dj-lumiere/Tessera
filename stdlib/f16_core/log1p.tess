// Tessera stdlib: the correctly rounded ln(1 + x) of F16
//
// In F32: for |x| < 2^-5 a degree-3 Taylor polynomial, with the hard cases
// listed; otherwise 1 + x is exact, and its upper bits pick r ~ 1/(1 + x) and
// -ln(r) from a table, leaving ln(1 + z) for a small z = r (1 + x) - 1. Round
// to nearest only: ln_1p(-1) = -inf, x < -1 gives NaN, ln_1p(+inf) = +inf, NaN
// comes back quiet.
//
// Ported from CORE-MATH, src/binary16/log1p/log1pf16.c via RazorForge's B16Log1p.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// ln(1 + x), correctly rounded, accurate near 0.
routine f16_cm_log1p(%x: F16) -> F16
    block entry():
        %v  : F32 = %x.to_f32()
        %u  : U32 = %v.bits()
        %au : U32 = %u.bitand(0x7FFFFFFF)
        when:
            %u.ge(0xBF800000)    -> at_most_minus_one(%u)  // x <= -1, and every negative NaN
            %au.shr(23).eq(0xFF) -> return(%x.add(%x))  // +inf or a positive NaN
            %au.lt(0x3D000000)   -> small(%v, %u, %au)  // |x| < 2^-5
            %u.eq(0x3DEC8000)    -> return(F32.to_f16(0x1.bfa006p-4))  // hard case x = 0x1.d9p-4
            else                 -> reduce(%v)

    block at_most_minus_one(%u: U32):
        %minus_one : Bool = %u.eq(0xBF800000)
        branch %minus_one ? return(F16.NEG_INFINITY) : return(F16.from_bits(0xFE00))

    block small(%v: F32, %u: U32, %au: U32):
        when:
            %u.eq(0xBBBFA000)  -> return(F32.to_f16(-0x1.805ffep-8))  // hard cases
            %u.eq(0xBCFB6000)  -> return(F32.to_f16(-0x1.fea004p-6))
            %u.eq(0x3BC06000)  -> return(F32.to_f16(0x1.7fa002p-8))
            %au.le(0x34000000) -> tiny(%v, %au)  // |x| <= 2^-23
            else               -> return(cm_f16_log1p_small(%v).to_f16())

    block tiny(%v: F32, %au: U32):
        %zero : Bool = %au.eq(0)
        branch %zero ? return(%x) : return(%v.sub(0x1p-45).to_f16())

    // 1 + x is exact
    block reduce(%v: F32):
        %w    : F32   = %v.add(1.0)
        %i    : USize = %w.bits().shr(20).sub(928).to_usize()
        %r    : F32   = F32.from_bits(CM_F16_LOG1P_R.get(%i.mul(2)))
        %logr : F32   = F32.from_bits(CM_F16_LOG1P_R.get(%i.mul(2).add(1)))
        %z    : F32   = %r.mul_add(%w, -1.0)
        return(%logr.add(cm_f16_log1p_small(%z)).to_f16())

// ln(1 + x) for a small F32 x, by its degree-3 Taylor polynomial.
private routine cm_f16_log1p_small(%x: F32) -> F32
    block entry():
        %c3 : F32 = %x.mul_add(-0x1p-2, 0x1.555556p-2)
        %c2 : F32 = %x.mul_add(%c3, -0.5)
        %r  : F32 = %x.mul_add(%x.mul(%c2), %x)
        return(%r)

/// Pairs of F32 bit patterns {r, -log(r)} (flattened), where r approximates 1/x and the index is the upper
/// encoding bits of the F32 value 1 + x, minus 928.
preset CM_F16_LOG1P_R: Array<U32, 448> = [0x44F10C00, 0xC0F20FD5, 0x44D7AC00, 0xC0EE809C,
