// Tessera stdlib: the correctly rounded base-2 logarithm log2(x) of F16
//
// A normal x = 2^e m: log2(2^e) and log2(m) come from two tables of F32 values
// whose sum rounds correctly to F16; subnormals are tabulated directly. Round
// to nearest only: log2(±0) = -inf, a negative x gives NaN, log2(+inf) = +inf, NaN
// comes back quiet.
//
// Ported from CORE-MATH, src/binary16/log2/log2f16.c via RazorForge's B16Log2.rf.
// Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// log2(x), correctly rounded.
routine f16_cm_log2(%x: F16) -> F16
    block entry():
        %u : U16   = %x.bits()
        %e : U16   = %u.shr(10)
        %m : USize = %u.bitand(0x3FF).to_usize()
        when:
            %u.shr(15).ne(0) -> negative(%u)
            %e.eq(0x1F)      -> return(%x.add(%x))  // +inf or NaN
            %e.eq(0)         -> return(F32.from_bits(CM_F16_LOG2_T3.get(%m)).to_f16())  // subnormal or +0
            else             -> normal(%e.to_usize(), %m)

    block normal(%e: USize, %m: USize):
        %r : F32 = F32.from_bits(CM_F16_LOG2_T1.get(%e)).add(F32.from_bits(CM_F16_LOG2_T2.get(%m)))
        return(%r.to_f16())

    // -0 gives -inf, x < 0 gives NaN, a NaN comes back quiet
    block negative(%u: U16):
        when:
            %u.eq(0x8000) -> return(F16.NEG_INFINITY)
            %x.is_nan()   -> return(%x.add(%x))
            else          -> return(F16.from_bits(0x7E01))

/// F32 bit patterns of log2(x1), where the F16 encoding of x1 is `i1 * 2^10` (i1 encodes the exponent).
preset CM_F16_LOG2_T1: Array<U32, 32> = [0x00000000, 0xC1600000, 0xC1500000, 0xC1400000, 0xC1300000,
        0xC1200000, 0xC1100000, 0xC1000000, 0xC0E00000, 0xC0C00000, 0xC0A00000, 0xC0800000,
        0xC0400000, 0xC0000000, 0xBF800000, 0x00000000, 0x3F800000, 0x40000000, 0x40400000,
        0x40800000, 0x40A00000, 0x40C00000, 0x40E00000, 0x41000000, 0x41100000, 0x41200000,
        0x41300000, 0x41400000, 0x41500000, 0x41600000, 0x41700000, 0x00000000]

