// Tessera stdlib: the correctly rounded natural logarithm ln(x) of F16
//
// A normal x = 2^e m: ln(2^e) and ln(m) come from two tables of F32 values
// whose sum rounds correctly to F16; subnormals are tabulated directly. Round
// to nearest only: ln(±0) = -inf, a negative x gives NaN, ln(+inf) = +inf, NaN
// comes back quiet.
//
// Ported from CORE-MATH, src/binary16/log/logf16.c via RazorForge's B16Log.rf.
// Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// The natural logarithm.
routine F16.ln(%self: Self) -> Self
    block entry():
        %u : U16   = %self.bits()
        %e : U16   = %u.shr(10)
        %m : USize = %u.bitand(0x3FF).to_usize()
        when:
            %u.shr(15).ne(0) -> negative(%u)
            %e.eq(0x1F)      -> return(%self.add(%self))  // +inf or NaN
            %e.eq(0)         -> return(F32.from_bits(CM_F16_LOG_T3.get(%m)).to_f16())  // subnormal or +0
            else             -> normal(%e.to_usize(), %m)

    block normal(%e: USize, %m: USize):
        %r : F32 = F32.from_bits(CM_F16_LOG_T1.get(%e)).add(F32.from_bits(CM_F16_LOG_T2.get(%m)))
        return(%r.to_f16())

    // -0 gives -inf, x < 0 gives NaN, a NaN comes back quiet
    block negative(%u: U16):
        when:
            %u.eq(0x8000)  -> return(Self.NEG_INFINITY)
            %self.is_nan() -> return(%self.add(%self))
            else           -> return(Self.from_bits(0x7E01))

/// F32 bit patterns of log(x1), where the F16 encoding of x1 is `i1 * 2^10` (i1 encodes the exponent).
preset CM_F16_LOG_T1: @Array<U32, 32> <- { 0x00000000, 0xC11B43D5, 0xC1102CB3, 0xC1051592,
        0xC0F3FCE1, 0xC0DDCE9E, 0xC0C7A05B, 0xC0B17218, 0xC09B43D5, 0xC0851592, 0xC05DCE9E,
        0xC0317218, 0xC0051592, 0xBFB17218, 0xBF317218, 0x00000000, 0x3F317218, 0x3FB17218,
        0x40051592, 0x40317218, 0x405DCE9E, 0x40851592, 0x409B43D5, 0x40B17218, 0x40C7A05B,
        0x40DDCE9E, 0x40F3FCE1, 0x41051592, 0x41102CB3, 0x411B43D5, 0x41265AF6, 0x00000000 }

