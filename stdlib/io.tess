// Tessera stdlib: I/O
//
// The POSIX write(2) binding that the writers in format.tess use. Printing goes
// through a writer: print_f("x = {%x}\n") for stdout, eprint_f for stderr, and
// write_f(#out, ...) for any other Writer.
//
// C-alias types (CInt, CSize) appear only on the c_write extern; user-facing
// routines take U64 lengths and convert at the FFI boundary.

module Standard::Os

@[external("c"), symbol("write")]
routine c_write(%fd: CInt, #buf: Ptr<Byte>, %count: CSize) -> CSize
