; Tessera stdlib: I/O
;
; Thin wrappers over POSIX write(2) for stdout (fd 1) and stderr (fd 2).
; write_int / write_uint convert an integer to decimal in a stack buffer — no
; allocation.
;
; C-alias types (CInt, CSize) appear only on the c_write extern; user-facing
; routines take U64 lengths and convert at the FFI boundary.

@[external("c"), symbol("write")]
routine c_write(%fd: CInt, #buf: Ptr<Byte>, %count: CSize) -> CSize

; ============================================================
; Basic output
; ============================================================

routine print(#str: Ptr<Byte>, %len: U64) -> Void
    block entry():
        %len_c: CSize = u64_to_csize(%len)
        c_write(1, #str, %len_c)
        return()

routine println(#str: Ptr<Byte>, %len: U64) -> Void
    block entry():
        %len_c: CSize = u64_to_csize(%len)
        c_write(1, #str, %len_c)
        #newline: Ptr<Byte> = alloca<Byte>
        #newline = 0x0A                        ; '\n'
        c_write(1, #newline, u64_to_csize(1))
        return()

routine print_slice(%slice: String) -> Void
    block entry():
        #data:  Ptr<Byte> = %slice.data
        %len:   U64       = %slice.length
        %len_c: CSize     = u64_to_csize(%len)
        c_write(1, #data, %len_c)
        return()

routine println_slice(%slice: String) -> Void
    block entry():
        #data:  Ptr<Byte> = %slice.data
        %len:   U64       = %slice.length
        %len_c: CSize     = u64_to_csize(%len)
        c_write(1, #data, %len_c)
        #newline: Ptr<Byte> = alloca<Byte>
        #newline = 0x0A                        ; '\n'
        c_write(1, #newline, u64_to_csize(1))
        return()

routine eprint_slice(%slice: String) -> Void
    block entry():
        #data:  Ptr<Byte> = %slice.data
        %len:   U64       = %slice.length
        %len_c: CSize     = u64_to_csize(%len)
        c_write(2, #data, %len_c)
        return()

routine eprintln_slice(%slice: String) -> Void
    block entry():
        eprint_slice(%slice)
        eprint_slice("\n")
        return()

; ============================================================
; Integer printing (no heap allocation)
;
; Writes decimal digits into a 20-byte stack buffer (U64.MAX has 20 digits),
; filled from the right, then writes the filled slice.
; ============================================================

routine print_int(%n: S64) -> Void
    block entry():
        write_int(1, %n)
        return()

routine eprint_int(%n: S64) -> Void
    block entry():
        write_int(2, %n)
        return()

routine print_uint(%n: U64) -> Void
    block entry():
        write_uint(1, %n)
        return()

routine eprint_uint(%n: U64) -> Void
    block entry():
        write_uint(2, %n)
        return()

; Writes %n in decimal to file descriptor %fd.
routine write_int(%fd: CInt, %n: S64) -> Void
    block entry():
        %is_neg: Bool = %n.lt(0)
        branch %is_neg ? write_sign(%n) : write_magnitude(%n)

    block write_sign(%n: S64):
        #sign: Ptr<Byte> = alloca<Byte>
        #sign = 0x2D                           ; '-'
        c_write(%fd, #sign, u64_to_csize(1))
        jump write_magnitude(%n)

    ; abs_diff(0) is the magnitude as a U64, so S64.MIN needs no special case.
    block write_magnitude(%n: S64):
        write_uint(%fd, %n.abs_diff(0))
        return()

; Writes %n in decimal to file descriptor %fd.
routine write_uint(%fd: CInt, %n: U64) -> Void
    block entry():
        ; 20-byte buffer: indices 0..19, filled right-to-left from index 19
        #buf:   Ptr<Array<Byte, 20>> = alloca<Array<Byte, 20>>
        #bytes: Ptr<Byte>            = bitcast<Ptr<Array<Byte, 20>>, Ptr<Byte>>(#buf)
        jump digit(20, %n, #bytes)

    ; At least one digit, so 0 prints as "0".
    block digit(%pos: U64, %n: U64, #bytes: Ptr<Byte>):
        %prev:  U64  = %pos.sub(1)
        %ascii: U8   = %n.rem(10).to_u8().add(48)   ; '0' = 48
        #bytes[%prev] = %ascii.bits()
        %rest:  U64  = %n.div(10)
        %done:  Bool = %rest.eq(0)
        branch %done ? write(%prev, #bytes) : digit(%prev, %rest, #bytes)

    block write(%pos: U64, #bytes: Ptr<Byte>):
        %len:   U64       = 20.sub(%pos)
        %len_c: CSize     = u64_to_csize(%len)
        #start: Ptr<Byte> = #bytes[%pos]
        c_write(%fd, #start, %len_c)
        return()
