// Tessera stdlib: I/O
//
// The POSIX write(2) binding that the writers in format.tess use. Printing goes
// through a writer: print("x = {%x}\n") for stdout, eprint for stderr, and
// write(%out, ...) for any other Writer.
//
// CInt and SSize appear only on the c_write extern; lengths are USize.

module Standard::Os

@[external("c"), symbol("write")]
routine c_write(%fd: CInt, %buf: Ptr<Byte>, %count: USize) -> SSize
