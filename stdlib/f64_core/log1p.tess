// Tessera stdlib: the correctly rounded log(1 + x) of F64
//
// Near zero a polynomial in x, as a double-double. Elsewhere 1 + x = t + dt
// exactly, t = 2^e y with a reciprocal rf_j of y from a table: log(1 + x) =
// e log(2) - log(rf_j) + log(rf_j (t + dt)) with a short polynomial. When that
// can't decide the rounding, the accurate path uses a longer polynomial near
// zero, or four levels of reciprocal tables and triple-double arithmetic.
// Round to nearest only: log1p(+-0) is +-0, log1p(-1) is -inf, an input below
// -1 gives NaN, +inf maps to itself, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary64/log1p/log1p.c via RazorForge's B64Log1p.rf.
// Copyright (c) 2024-2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// ln(1 + self), accurate near 0.
routine F64.ln_1p(%self: Self) -> Self
    block entry():
        %ixu   : U64  = %self.bits()
        %ax    : U64  = %ixu.shl(1)
        %small : Bool = %ax.lt(0x7F60000000000000)  // |x| < 0.0625
        branch %small ? small(%ax) : large(%ixu, %ax)

    block small(%ax: U64):
        %tiny : Bool = %ax.lt(0x7940000000000000)  // |x| < 2^-53
        branch %tiny ? return(cm_f64_log1p_tiny(%self)) : continue
        %x2         : Self = %self.mul(%self)
        %very_small : Bool = %ax.lt(0x7E60000000000000)  // |x| < 2^-12
        branch %very_small ? very_small(%ax, %x2) : medium(%x2)

    block very_small(%ax: U64, %x2: Self):
        %eps   : Self = Self.mul(0x1.ap-64, %self)
        %short : Bool = %ax.lt(0x7D43360000000000)  // |x| < 0x1.19bp-21
        branch %short ? continue : longer(%x2, %eps)
        %c01 : Self = %self.mul(0x1.55555555558f7p-2).add(-0x1.00000000001d1p-1)
        jump decide(%self, %x2.mul(%c01), %eps)

    block longer(%x2: Self, %eps: Self):
        %c01 : Self = %self.mul(0x1.5555555555551p-2).add(-0x1.ffffffffffffdp-2)
        %c23 : Self = %self.mul(0x1.99999b442f73fp-3).add(-0x1.000000d5555e1p-2)
        jump decide(%self, %x2.mul(%c01.add(%x2.mul(%c23))), %eps)

    block medium(%x2: Self):
        %x3  : Self = %x2.mul(%self)
        %x4  : Self = %x2.mul(%x2)
        %hx  : Self = Self.mul(-0.5, %self)
        %ln1 : Self = %hx.mul_add(%self, %self)
        %ln0 : Self = %hx.mul_add(%self, %self.sub(%ln1))
        %f0a : Self = %self.mul(-0x1p-2).add(0x1.5555555555555p-2)
        %f0b : Self = %self.mul(-0x1.555555555583bp-3).add(0x1.9999999999b41p-3)
        %f1a : Self = %self.mul(-0x1.fffffffe42e43p-4).add(0x1.24924923f39ep-3)
        %f1b : Self = %self.mul(-0x1.99999de10510fp-4).add(0x1.c71c75511d70bp-4)
        %f2a : Self = %self.mul(-0x1.554fb43e54e0fp-4).add(0x1.7457e81b175f6p-4)
        %f2b : Self = %self.mul(-0x1.28558ad5a7ac4p-4).add(0x1.3ed68744f3d18p-4)
        %f0  : Self = %f0a.add(%x2.mul(%f0b))
        %f1  : Self = %f1a.add(%x2.mul(%f1b))
        %f2  : Self = %f2a.add(%x2.mul(%f2b))
        %f   : Self = %f0.add(%x4.mul(%f1.add(%x4.mul(%f2))))
        jump decide(%ln1, %ln0.add(%x3.mul(%f)), %x3.mul(0x1.b6p-52))

    // |x| >= 0.0625: 1 + x = t + dt
    block large(%ixu: U64, %ax: U64):
        %near    : Bool = %ixu.to_s64_wrap().lt(0x4340000000000000).bitand(%ixu.lt(0xBFF0000000000000))
        %big     : Bool = %ixu.lt(0x4690000000000000)  // 2^53 <= x < 2^106
        %special : Bool = %ixu.ge(0x7FF0000000000000)
        when:
            %near    -> near()  // 0.0625 < x < 2^53 or -1 < x < -0.0625
            %big     -> reduce(%self, 1.0)
            %special -> return(cm_f64_log1p_special(%self))
            else     -> reduce(%self, 0.0)

    block near():
        %s : CmF64LogDd = cm_f64_log1p_fasttwosum(1.0, %self)
        jump reduce(%s.hi, %s.lo)

    block reduce(%tf: Self, %dtf: Self):
        %j   : S64   = %tf.bits().sub_wrap(0x3FE6A00000000000).to_s64_wrap()
        %j1  : USize = %j.shr(46).bitand(0x3F).to_usize()
        %je  : S64   = %j.shr(52)
        %rf  : U64   = CM_F64_LOG1P_RF.get(%j1)
        %low : Bool  = %je.lt(1022)
        branch %low
            ? scaled(%j1, %je, Self.from_bits(%rf.sub_wrap(%je.to_u64_wrap().shl(52))), %tf, %dtf)
            : continue
        // scale t and dt instead of rs, which would become subnormal
        %sc : Self = cm_f64_log1p_scale(%je)
        jump scaled(%j1, %je, Self.from_bits(%rf.sub_wrap(U64.shl(1021, 52))), %tf.mul(%sc),
                %dtf.mul(%sc))

    block scaled(%j1: USize, %je: S64, %rs: Self, %tf: Self, %dtf: Self):
        %dh  : Self       = %rs.mul(%tf)
        %dl  : Self       = %rs.mul_add(%tf, %dh.neg()).add(%rs.mul(%dtf))
        %xs  : CmF64LogDd = cm_f64_log1p_fasttwosum(%dh.sub(1.0), %dl)
        %xh  : Self       = %xs.hi
        %x2  : Self       = %xh.mul(%xh)
        %c01 : Self       = %xh.mul(0x1.5555555554cf5p-2).add(-0x1.000000000003dp-1)
        %c23 : Self       = %xh.mul(0x1.99999a3661724p-3).add(-0x1.ffffffeca2939p-3)
        %c45 : Self       = %xh.mul(0x1.247b887a6e5edp-3).add(-0x1.555d345bfe6fdp-3)
        %xl  : Self       = %xs.lo.add(%x2.mul(%c01.add(%x2.mul(%c23.add(%x2.mul(%c45))))))
        %jed : Self       = %je.to_f64()
        %l1  : Self       = Self.mul(0x1.62e42fefa4p-1, %jed)
        %l0  : Self       = Self.mul(-0x1.8432a1b0e2634p-43, %jed)
        %lfh : Self       = Self.from_bits(CM_F64_LOG1P_LF.get(%j1.mul(2).add(1)))
        %lfl : Self       = Self.from_bits(CM_F64_LOG1P_LF.get(%j1.mul(2)))
        %s   : CmF64LogDd = cm_f64_log1p_fastsum(%lfh.add(%l1), %lfl.add(%l0), %xh, %xl)
        jump decide(%s.hi, %s.lo, 0x1.ap-65)

    block decide(%ln1: Self, %ln0: Self, %eps: Self):
        %lb   : Self = %ln1.add(%ln0.sub(%eps))
        %ub   : Self = %ln1.add(%ln0.add(%eps))
        %sure : Bool = %lb.eq(%ub)
        branch %sure ? return(%lb) : return(cm_f64_log1p_refine(%self, %lb))

/// log1p x for |x| < 2^-53: x - |x| 2^-54 rounds like log1p x (and +-0 stays itself).
private routine cm_f64_log1p_tiny(%x: F64) -> F64
    block entry():
        %zero : Bool = %x.bits().shl(1).eq(0)
        branch %zero ? return(%x) : return(%x.abs().mul_add(-0x1p-54, %x))

/// The factor that scales t and dt when e is 1022, 1023 or 1024.
private routine cm_f64_log1p_scale(%je: S64) -> F64
    block entry():
        %e1022 : Bool = %je.eq(1022)
        %e1023 : Bool = %je.eq(1023)
        when:
            %e1022 -> return(0.5)
            %e1023 -> return(0.25)
            else   -> return(0.125)

/// log1p of NaN (itself, quiet), +inf (itself), -1 (-inf) or an input below -1 (NaN).
private routine cm_f64_log1p_special(%x: F64) -> F64
    block entry():
        %ixu   : U64  = %x.bits()
        %nan   : Bool = %ixu.shl(1).gt(0xFFE0000000000000)
        %inf   : Bool = %ixu.eq(0x7FF0000000000000)
        %minus : Bool = %ixu.eq(0xBFF0000000000000)
        when:
            %nan   -> return(%x.add(%x))
            %inf   -> return(%x)
            %minus -> return(F64.from_bits(0xFFF0000000000000))  // the pole
            else   -> return(F64.from_bits(0xFFF8000000000000))  // the default NaN of 0/0

/// The accurate path of log1p, taken when the fast path can't decide the rounding: a is the fast path's
/// approximation, x is finite and above -1.
private routine cm_f64_log1p_refine(%x: F64, %a: F64) -> F64
    block entry():
        %ax   : U64  = %x.bits().shl(1)
        %tiny : Bool = %ax.lt(0x7940000000000000)
        %near : Bool = %ax.lt(0x7EA0000000000000)
        when:
            %tiny -> return(cm_f64_log1p_tiny(%x))
            %near -> return(cm_f64_log1p_refine_near_zero(%x))
            else  -> return(cm_f64_log1p_refine_table(%x, %a))

/// The accurate path for |x| < 2^-10: a polynomial with double-double coefficients.
private routine cm_f64_log1p_refine_near_zero(%x: F64) -> F64
    block entry():
        %x2h : F64        = %x.mul(%x)
        %x2l : F64        = %x.mul_add(%x, %x2h.neg())
        %x3  : CmF64LogDd = cm_f64_log1p_mulddd(%x, %x2h, %x2l)
        %c01 : F64        = %x.mul(0x1.c71c71c7185aap-4).add(-0x1.fffffffffc555p-4)
        %c23 : F64        = %x.mul(0x1.745d51f1817c7p-4).add(-0x1.9999d44449a31p-4)
        %sl  : F64        = %x.mul(%c01.add(%x2h.mul(%c23)))
        // Horner evaluation of the double-double coefficients cz, in the double x
        %h0 : CmF64LogDd = cm_f64_log1p_fasttwosum(F64.from_bits(CM_F64_LOG1P_CZ.get(8)), %sl)
        jump horner(4, %h0.hi, F64.from_bits(CM_F64_LOG1P_CZ.get(9)).add(%h0.lo), %x2h, %x2l, %x3)

    block horner(%i: USize, %ch: F64, %cl: F64, %x2h: F64, %x2l: F64, %x3: CmF64LogDd):
        %done : Bool = %i.eq(0)
        branch %done ? finish(%ch, %cl, %x2h, %x2l, %x3) : continue
        %k  : USize      = %i.sub(1)
        %m  : CmF64LogDd = cm_f64_log1p_mulddd(%x, %ch, %cl)
        %zh : F64        = F64.from_bits(CM_F64_LOG1P_CZ.get(%k.mul(2)))
        %zl : F64        = F64.from_bits(CM_F64_LOG1P_CZ.get(%k.mul(2).add(1)))
        %t  : CmF64LogDd = cm_f64_log1p_fastsum(%zh, %zl, %m.hi, %m.lo)
        jump horner(%k, %t.hi, %t.lo, %x2h, %x2l, %x3)

    block finish(%ch: F64, %cl: F64, %x2h: F64, %x2l: F64, %x3: CmF64LogDd):
        %p : CmF64LogDd = cm_f64_log1p_muldd(%ch, %cl, %x3.hi, %x3.lo)
        %q : CmF64LogDd = cm_f64_log1p_fastsum(%x2h.mul(-0.5), %x2l.mul(-0.5), %p.hi, %p.lo)
        return(cm_f64_log1p_final(%x, %q.hi, %q.lo))

/// The accurate path for |x| >= 2^-10: four levels of reciprocal tables, indexed by the fast path's approximation
/// a, and a polynomial with double-double coefficients.
private routine cm_f64_log1p_refine_table(%x: F64, %a: F64) -> F64
    block entry():
        %ixu   : U64   = %x.bits()
        %j     : S64   = %a.mul(0x1.71547652b82fep+16).round_ties_even().to_s64()
        %ii    : S64   = %j.add(34952)
        %j1    : USize = %ii.shr(12).bitand(0xF).to_usize()
        %j2    : USize = %ii.shr(8).bitand(0xF).to_usize()
        %j3    : USize = %ii.shr(4).bitand(0xF).to_usize()
        %j4    : USize = %ii.bitand(0xF).to_usize()
        %je    : S64   = %ii.shr(16)
        %k1    : USize = %j1.mul(3)
        %k2    : USize = %j2.add(16).mul(3)
        %k3    : USize = %j3.add(32).mul(3)
        %k4    : USize = %j4.add(48).mul(3)
        %ll0   : F64   = cm_f64_log1p_ln_sum(%k1, %k2, %k3, %k4)
        %ll1   : F64   = cm_f64_log1p_ln_sum(%k1.add(1), %k2.add(1), %k3.add(1), %k4.add(1))
        %ll2   : F64   = cm_f64_log1p_ln_sum(%k1.add(2), %k2.add(2), %k3.add(2), %k4.add(2))
        %t12   : F64   = cm_f64_log1p_rt(%j1, 0).mul(cm_f64_log1p_rt(%j2, 1))
        %t34   : F64   = cm_f64_log1p_rt(%j3, 2).mul(cm_f64_log1p_rt(%j4, 3))
        %th    : F64   = %t12.mul(%t34)
        %tl    : F64   = %t12.mul_add(%t34, %th.neg())
        %below : Bool  = %ixu.to_s64_wrap().lt(0x4690000000000000)
        %split : Bool  = %below.bitand(%ixu.lt(0xBFE0000000000000))
        // 1 + x = t + dt
        when:
            %split -> split(%je, %ll0, %ll1, %ll2, %th, %tl)
            %below -> reduce(%je, %ll0, %ll1, %ll2, %th, %tl, F64.add(1.0, %x), 0)
            else   -> reduce(%je, %ll0, %ll1, %ll2, %th, %tl, %x, 0)

    block split(%je: S64, %ll0: F64, %ll1: F64, %ll2: F64, %th: F64, %tl: F64):
        %s    : CmF64LogDd = cm_f64_log1p_twosum(1.0, %x)
        %dtu  : U64        = %s.lo.bits()
        %zero : Bool       = %dtu.shl(1).eq(0)  // a zero dt of either sign counts as +0
        %dt   : U64        = %zero ? 0 : %dtu
        jump reduce(%je, %ll0, %ll1, %ll2, %th, %tl, %s.hi, %dt)

    block reduce(%je: S64, %ll0: F64, %ll1: F64, %ll2: F64, %th: F64, %tl: F64, %tf: F64,
            %dtu: U64):
        %escale : U64        = %je.to_u64_wrap().shl(52)
        %t      : F64        = F64.from_bits(%tf.bits().sub_wrap(%escale))
        %dh     : F64        = %th.mul(%t)
        %dl     : F64        = %th.mul_add(%t, %dh.neg())
        %sh     : F64        = %tl.mul(%t)
        %sl     : F64        = %tl.mul_add(%t, %sh.neg())
        %xs0    : CmF64LogDd = cm_f64_log1p_fasttwosum(%dh.sub(1.0), %dl)
        %xs     : CmF64LogDd = cm_f64_log1p_fastsum(%xs0.hi, %xs0.lo, %sh, %sl)
        %has_dt : Bool       = %dtu.ne(0)
        branch %has_dt ? continue : poly(%je, %ll0, %ll1, %ll2, %xs.hi, %xs.lo)
        %dt  : F64        = F64.from_bits(%dtu.sub_wrap(%escale))
        %ddh : F64        = %th.mul(%dt)
        %ddl : F64        = %th.mul_add(%dt, %ddh.neg()).add(%tl.mul(%dt))
        %xd  : CmF64LogDd = cm_f64_log1p_fastsum(%xs.hi, %xs.lo, %ddh, %ddl)
        jump poly(%je, %ll0, %ll1, %ll2, %xd.hi, %xd.lo)

    block poly(%je: S64, %ll0: F64, %ll1: F64, %ll2: F64, %xh: F64, %xl: F64):
        %c01 : F64 = %xh.mul(0x1.2492492492492p-3).add(-0x1.5555555555555p-3)
        %c23 : F64 = %xh.mul(0x1.c71c71c802f68p-4).add(-0x1.0000000073334p-3)
        %sl  : F64 = %xh.mul(%c01.add(%xh.mul(%xh).mul(%c23)))
        // Horner evaluation of the double-double coefficients cy, in the double-double (xh, xl)
        %h0     : CmF64LogDd = cm_f64_log1p_fasttwosum(F64.from_bits(CM_F64_LOG1P_CY.get(8)), %sl)
        %cl     : F64        = F64.from_bits(CM_F64_LOG1P_CY.get(9)).add(%h0.lo)
        %c      : CmF64LogDd = cm_f64_log1p_horner_cy(%xh, %xl, %h0.hi, %cl)
        %p      : CmF64LogDd = cm_f64_log1p_muldd(%xh, %xl, %c.hi, %c.lo)
        %scaled : Bool       = %je.ne(0)
        branch %scaled ? continue : combine(%ll2, %ll1, %ll0, %p)
        %jed  : F64        = %je.to_f64()
        %ln22 : F64        = F64.mul(0x1.62e42fefa4p-1, %jed).add(%ll2)
        %ln21 : F64        = F64.mul(-0x1.8432a1b0e28p-43, %jed)
        %ln20 : F64        = F64.mul(0x1.cc01f97b57a08p-87, %jed)
        %q    : CmF64LogDd = cm_f64_log1p_fastsum(%ln21, %ln20, %ll1, %ll0)
        jump combine(%ln22, %q.hi, %q.lo, %p)

    block combine(%ln22: F64, %ln21: F64, %ln20: F64, %p: CmF64LogDd):
        %r : CmF64LogDd = cm_f64_log1p_sum(%ln21, %ln20, %p.hi, %p.lo)
        return(cm_f64_log1p_final(%ln22, %r.hi, %r.lo))

/// The Horner steps of degrees 3 down to 0 over the coefficients cy, in the double-double (xh, xl), from (ch, cl).
private routine cm_f64_log1p_horner_cy(%xh: F64, %xl: F64, %ch: F64, %cl: F64) -> CmF64LogDd
    block entry():
        jump step(4, %ch, %cl)

    block step(%i: USize, %ch: F64, %cl: F64):
        %done : Bool = %i.eq(0)
        branch %done ? return(CmF64LogDd { hi: %ch, lo: %cl }) : continue
        %k  : USize      = %i.sub(1)
        %m  : CmF64LogDd = cm_f64_log1p_muldd(%xh, %xl, %ch, %cl)
        %yh : F64        = F64.from_bits(CM_F64_LOG1P_CY.get(%k.mul(2)))
        %yl : F64        = F64.from_bits(CM_F64_LOG1P_CY.get(%k.mul(2).add(1)))
        %u  : CmF64LogDd = cm_f64_log1p_fastsum(%yh, %yl, %m.hi, %m.lo)
        jump step(%k, %u.hi, %u.lo)

/// Reciprocal j of level k of the accurate path.
private routine cm_f64_log1p_rt(%j: USize, %k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_LOG1P_RT.get(%k.mul(16).add(%j))))

/// The sum of the four entries k1..k4 of CM_F64_LOG1P_LN, grouped as (k1 + k2) + (k3 + k4).
private routine cm_f64_log1p_ln_sum(%k1: USize, %k2: USize, %k3: USize, %k4: USize) -> F64
    block entry():
        %a : F64 = F64.from_bits(CM_F64_LOG1P_LN.get(%k1)).add(F64.from_bits(CM_F64_LOG1P_LN.get(%k2)))
        %b : F64 = F64.from_bits(CM_F64_LOG1P_LN.get(%k3)).add(F64.from_bits(CM_F64_LOG1P_LN.get(%k4)))
        return(%a.add(%b))

/// The triple-double ln22 + ln21 + ln20 rounded: after renormalizing, when the middle word has an all-zero mantissa,
/// it's nudged one ulp toward the low word so that the sum of the top two rounds correctly.
private routine cm_f64_log1p_final(%ln22: F64, %ln21: F64, %ln20: F64) -> F64
    block entry():
        %w0    : CmF64LogDd = cm_f64_log1p_fasttwosum(%ln22, %ln21)
        %w1    : CmF64LogDd = cm_f64_log1p_fasttwosum(%w0.lo, %ln20)
        %tb    : U64        = %w1.hi.bits()
        %power : Bool       = %tb.bitand(0x000FFFFFFFFFFFFF).eq(0)
        branch %power ? continue : return(%w0.hi.add(%w1.hi))
        %opposite : Bool = %w1.lo.bits().bitxor(%tb).shr(63).eq(1)
        %nudged   : U64  = %opposite ? %tb.sub_wrap(1) : %tb.add_wrap(1)
        return(%w0.hi.add(F64.from_bits(%nudged)))

/// Error-free sum of x and y when |x| >= |y|: s = x + y rounded, and s + e = x + y exactly.
private routine cm_f64_log1p_fasttwosum(%x: F64, %y: F64) -> CmF64LogDd
    block entry():
        %s : F64 = %x.add(%y)
        %z : F64 = %s.sub(%x)
        return(CmF64LogDd { hi: %s, lo: %y.sub(%z) })

/// Error-free sum of xh and ch in any order of magnitude.
private routine cm_f64_log1p_twosum(%xh: F64, %ch: F64) -> CmF64LogDd
    block entry():
        %s : F64 = %xh.add(%ch)
        %d : F64 = %s.sub(%xh)
        return(CmF64LogDd { hi: %s, lo: %ch.sub(%d).add(%xh.add(%d.sub(%s))) })

/// The sum of the double-doubles (xh, xl) and (yh, yl) when |xh| >= |yh|.
private routine cm_f64_log1p_fastsum(%xh: F64, %xl: F64, %yh: F64, %yl: F64) -> CmF64LogDd
    block entry():
        %s : CmF64LogDd = cm_f64_log1p_fasttwosum(%xh, %yh)
        return(CmF64LogDd { hi: %s.hi, lo: %xl.add(%yl).add(%s.lo) })

/// The sum of the double-doubles (xh, xl) and (ch, cl) in any order of magnitude.
private routine cm_f64_log1p_sum(%xh: F64, %xl: F64, %ch: F64, %cl: F64) -> CmF64LogDd
    block entry():
        %s : CmF64LogDd = cm_f64_log1p_twosum(%xh, %ch)
        return(CmF64LogDd { hi: %s.hi, lo: %xl.add(%cl).add(%s.lo) })

/// The product of the double-doubles (xh, xl) and (ch, cl).
private routine cm_f64_log1p_muldd(%xh: F64, %xl: F64, %ch: F64, %cl: F64) -> CmF64LogDd
    block entry():
        %ahhh : F64 = %ch.mul(%xh)
        %lo   : F64 = %cl.mul(%xh).add(%ch.mul(%xl)).add(%ch.mul_add(%xh, %ahhh.neg()))
        return(CmF64LogDd { hi: %ahhh, lo: %lo })

/// The product of the double x and the double-double (ch, cl).
private routine cm_f64_log1p_mulddd(%x: F64, %ch: F64, %cl: F64) -> CmF64LogDd
    block entry():
        %ahhh : F64 = %ch.mul(%x)
        return(CmF64LogDd { hi: %ahhh, lo: %cl.mul(%x).add(%ch.mul_add(%x, %ahhh.neg())) })

