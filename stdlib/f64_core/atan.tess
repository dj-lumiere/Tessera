/// A crude piecewise quadratic approximation of atan that picks the table index:
/// constant terms.
preset CM_F64_ATAN_C0: @Array<U64, 31> <- { 419, 500, 582, 745, 908, 1234, 1559, 2210, 2860, 4156,
    5444, 7989, 10476, 15224, 19601, 27105, 33036, 41266, 46469, 52375, 55587, 58906, 60612, 62325,
    63192, 64056, 64491, 64923, 65141, 65358, 65467 }

/// Linear terms of the index quadratic.
preset CM_F64_ATAN_C1: @Array<U64, 31> <- { 81, 81, 163, 163, 326, 326, 651, 650, 1299, 1293, 2569,
    2520, 4917, 4576, 8341, 6648, 10210, 6292, 7926, 4038, 4591, 2172, 2390, 1107, 1207, 556, 605,
    278, 303, 139, 151 }

/// Quadratic terms of the index quadratic (subtracted).
preset CM_F64_ATAN_C2: @Array<U64, 31> <- { 0, 0, 0, 0, 0, 0, 0, 1, 3, 4, 24, 32, 168, 200, 838,
    731, 1998, 1117, 2048, 849, 1291, 479, 688, 247, 349, 124, 175, 62, 88, 31, 44 }

/// The inputs |x| whose arc tangent is too close to a rounding boundary, as F64 bits
/// (two appear twice, as in CORE-MATH; the first match wins).
preset CM_F64_ATAN_DB_X: @Array<U64, 12> <- { 0x3F80DC89A3B55010, 0x3F7E3FB41D2D2260,
    0x3FE7BA49F739829F, 0x3FCA933FE176B375, 0x3F7BB04A79820063, 0x3F7CD30A9499618B,
    0x3F8F44AA37B8E66B, 0x3F7FD2AC95E57EF9, 0x3F96419079BBF601, 0x3FE7BA49F739829F,
    0x3FCD768804487B07, 0x3F7BB04A79820063 }

/// The high parts of their arc tangents, as F64 bits.
preset CM_F64_ATAN_DB_H: @Array<U64, 12> <- { 0x3F80DC70AC228717, 0x3F7E3F9013A852F8,
    0x3FE46AC372243536, 0x3FCA33F32AC5CEB5, 0x3F7BB02ED5C5E956, 0x3F7CD2EB65F92A46,
    0x3F8F440B04187C87, 0x3F7FD2829FEBC03A, 0x3F9640AADE8F5427, 0x3FE46AC372243536,
    0x3FCCF5676F373EC1, 0x3F7BB02ED5C5E956 }

/// The low parts of their arc tangents, as F64 bits.
preset CM_F64_ATAN_DB_L: @Array<U64, 12> <- { 0x3C20000000000000, 0x3C10000000000000,
    0x3920000000000000, 0xB8F0000000000000, 0xB8C0000000000000, 0xB8F0000000000000,
    0xB8F0000000000000, 0xB8F0000000000000, 0x38D0000000000000, 0x3910000000000000,
    0xB910000000000000, 0xB8C0000000000000 }

/// arctan(self), correctly rounded.
routine F64.atan(self: Self) -> Self
    block entry():
        tu    : U64  = self.bits()
        at    : U64  = tu.bitand(0x7FFFFFFFFFFFFFFF)  // |x|
        small : Bool = at.lt(0x3F7B21C475E6362A)  // |x| < 0x1.b21c475e6362ap-8
        large : Bool = at.gt(0x4062DED8E34A9035)  // |x| > 0x1.2ded8e34a9035p+7
        when:
            small -> small(at)
            large -> large(at)
            else  -> table(tu, at)

    block small(at: U64):
        zero : Bool = at.eq(0)
        tiny : Bool = at.lt(0x3E40000000000000)  // |x| < 2^-27
        when:
            zero -> return(self)
            tiny -> return(Self.mul_add(-0x1p-54, self, self))
            else -> series()

    // x + x^3 p(x^2)
    block series():
        x2   : Self = self.mul(self)
        x3   : Self = self.mul(x2)
        x4   : Self = x2.mul(x2)
        a01  : Self = x2.mul(0x1.99999999998c1p-3).add(-0x1.5555555555555p-2)
        a23  : Self = x2.mul(0x1.c711fd121ae8p-4).add(-0x1.249249176aecp-3)
        f    : Self = x3.mul(a01.add(x4.mul(a23)))
        epsp : Self = f.mul(0x1.6p-50)
        epsm : Self = f.mul(0x1.6p-51)
        ub   : Self = f.add(epsp).add(self)
        lb   : Self = f.sub(epsm).add(self)
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(ub)
            : return(cm_f64_atan_accurate(self, ub))

    // sign(x) pi/2 + atan(-1/x); from 0x1.d02967c31cdb5p+53 on just sign(x) pi/2 rounded, or NaN
    block large(at: U64):
        ah     : Self = Self.copysign(0x1.921fb54442d18p+0, self)
        al     : Self = Self.copysign(0x1.1a62633145c07p-54, self)
        nan    : Bool = at.gt(0x7FF0000000000000)
        settle : Bool = at.ge(0x434D02967C31CDB5)
        when:
            nan    -> return(self.add(self))
            settle -> return(ah.add(al))
            else   -> finish(Self.div(-1.0, self), ah, al)

    // 0x1.b21c475e6362ap-8 <= |x| <= 0x1.2ded8e34a9035p+7: reduce by tan(j pi/256), 1 <= i <= 30
    block table(tu: U64, at: U64):
        i   : USize = at.shr(51).sub(2030).to<USize>()
        u   : U64   = tu.bitand(0x0007FFFFFFFFFFFF)
        ut  : U64   = u.shr(35)
        ut2 : U64   = ut.mul_wrap(ut).shr(16)
        j0  : U64   = CM_F64_ATAN_C0.get(i).shl(16).add_wrap(ut.mul_wrap(CM_F64_ATAN_C1.get(i)))
        j   : USize = j0.sub_wrap(ut2.mul_wrap(CM_F64_ATAN_C2.get(i))).shr(25).to<USize>()
        sg  : Self  = Self.copysign(1.0, self)
        ta  : Self  = sg.mul(Self.from_bits(CM_F64_ATAN_AH.get(j)))
        id  : Self  = sg.mul(j.to<U64>().to<Self>())
        al  : Self  = sg.mul(Self.from_bits(CM_F64_ATAN_AL.get(j))).add(Self.mul(
            0x1.8469898cc517p-55, id))
        h   : Self  = self.sub(ta).div(self.mul(ta).add(1.0))
        ah  : Self  = Self.mul(0x1.921fb54442dp-7, id)
        jump finish(h, ah, al)

    // ah + al + atan(h), with the fast path's error bound
    block finish(h: Self, ah: Self, al: Self):
        h2   : Self = h.mul(h)
        h4   : Self = h2.mul(h2)
        a01  : Self = h2.mul(-0x1.555555555552bp-2).add(1.0)
        a23  : Self = h2.mul(-0x1.248d2c8444ac6p-3).add(0x1.9999999069c2p-3)
        fp   : Self = a01.add(h4.mul(a23))
        all  : Self = h.mul_add(fp, al)
        e    : Self = h.mul(0x1.f8p-51)
        ub   : Self = all.add(e).add(ah)
        lb   : Self = all.sub(e).add(ah)
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(ub)
            : return(cm_f64_atan_accurate(self, ub))

/// The accurate path, for the inputs the fast path can't round: atan(x) to about 107
/// bits in double-double, with 2^-27 <= |x|; a is the fast-path approximation.
routine cm_f64_atan_accurate(x: F64, a: F64) -> F64
    block entry():
        phi : F64   = a.abs().mul(0x1.45f306dc9c883p6).add(256.5)
        i   : USize = phi.bits().shr(44).bitand(0xFF).to<USize>()  // 256.5 < phi < 384.5, so 0 <= i <= 128
        inf : Bool  = i.eq(128)
        branch inf
            ? reciprocal(i)
            : reduce(i)

    // h = -1/x
    block reciprocal(i: USize):
        h : F64 = F64.div(-1.0, x)
        jump poly(i, h, F64.mul_add(h, x, 1.0).mul(h))

    // h = (x - ta) / (1 + x ta) with ta = tan(i pi/256)
    block reduce(i: USize):
        ta   : F64 = F64.from_bits(CM_F64_ATAN_AH.get(i)).copysign(x)
        zta  : F64 = x.mul(ta)
        ztal : F64 = x.mul_add(ta, zta.neg())
        zmta : F64 = x.sub(ta)
        v    : F64 = F64.add(1.0, zta)
        d    : F64 = F64.sub(1.0, v)
        ev   : F64 = d.add(zta).sub(d.add(v).sub(1.0)).add(ztal)
        r    : F64 = F64.div(1.0, v)
        rl   : F64 = r.mul_add(v.neg(), 1.0).sub(ev.mul(r)).mul(r)
        h    : F64 = r.mul(zmta)
        hl   : F64 = r.mul_add(zmta, h.neg()).add(rl.mul(zmta))
        jump poly(i, h, hl)

    // atan(h + hl) = h + h^3 q(h^2) in double-double
    block poly(i: USize, h: F64, hl: F64):
        p2  : CmF64InvtrigDD = cm_f64_atan_muldd(h, hl, h, hl)
        h2  : F64            = p2.hi
        h2l : F64            = p2.lo
        h4  : F64            = h2.mul(h2)
        p3  : CmF64InvtrigDD = cm_f64_atan_muldd(h, hl, h2, h2l)
        a01 : F64            = h2.mul(-0x1.745d1745d1265p-4).add(0x1.c71c71c71c71cp-4)
        a23 : F64            = h2.mul(-0x1.1107c41ad3253p-4).add(0x1.3b13b115bcbc4p-4)
        fl  : F64            = h2.mul(a01.add(h4.mul(a23)))
        // the double-double polynomial over ch[0..2], Horner from the top coefficient
        ch3  : F64            = F64.add(-0x1.2492492492492p-3, fl)
        cl3  : F64            = F64.sub(-0x1.2492492492492p-3,
            ch3).add(fl).add(-0x1.249242093c016p-57)
        m2   : CmF64InvtrigDD = cm_f64_atan_muldd(h2, h2l, ch3, cl3)
        th2  : F64            = m2.hi.add(0x1.999999999999ap-3)
        tl2  : F64            = F64.sub(0x1.999999999999ap-3, th2).add(m2.hi)
        cl2  : F64            = m2.lo.add(tl2.add(-0x1.999999999bcb8p-57))
        m1   : CmF64InvtrigDD = cm_f64_atan_muldd(h2, h2l, th2, cl2)
        th1  : F64            = m1.hi.add(-0x1.5555555555555p-2)
        tl1  : F64            = F64.sub(-0x1.5555555555555p-2, th1).add(m1.hi)
        cl1  : F64            = m1.lo.add(tl1.add(-0x1.5555555555555p-56))
        f    : CmF64InvtrigDD = cm_f64_atan_muldd(p3.hi, p3.lo, th1, cl1)
        sg   : F64            = F64.copysign(1.0, x)
        zero : Bool           = i.eq(0)
        branch zero
            ? round(h, f.hi, f.lo, sg)
            : offset(i, h, hl, f, sg)

    // add i pi/256 (three parts) and atan(tan(i pi/256)) - i pi/256
    block offset(i: USize, h: F64, hl: F64, f: CmF64InvtrigDD, sg: F64):
        inner : Bool = i.lt(128)
        df    : F64  = inner
            ? sg.mul(F64.from_bits(CM_F64_ATAN_AL.get(i)))
            : 0.0
        id : F64            = i.to<U64>().to<F64>().copysign(x)
        ah : F64            = F64.mul(0x1.921fb54442dp-7, id)
        al : F64            = F64.mul(0x1.8469898cc518p-55, id)
        at : F64            = F64.mul(-0x1.fc8f8cbb5bf8p-104, id)
        s1 : CmF64InvtrigDD = cm_f64_atan_adddd(al, at, df, 0.0)
        s2 : CmF64InvtrigDD = cm_f64_atan_adddd(s1.hi, s1.lo, h, hl)
        s3 : CmF64InvtrigDD = cm_f64_atan_adddd(s2.hi, s2.lo, f.hi, f.lo)
        jump round(ah, s3.hi, s3.lo, sg)

    // ah + al + at, with the inputs too close to a rounding boundary settled apart
    block round(ah: F64, al: F64, at: F64, sg: F64):
        s0   : CmF64InvtrigDD = cm_f64_invtrig_fasttwosum(ah, al)
        s1   : CmF64InvtrigDD = cm_f64_invtrig_fasttwosum(s0.lo, at)
        v0   : F64            = s0.hi
        v1   : F64            = s1.hi
        t0   : U64            = v0.bits()
        t1   : U64            = v1.bits()
        near : Bool           = t1.add_wrap(1).bitand(0x000FFFFFFFFFFFFF).le(2)
        gap  : Bool           = t0.shr(52).bitand(0x7FF).sub_wrap(t1.shr(52).bitand(0x7FF)).gt(103)
        hard : Bool           = near.bitor(gap)
        branch hard
            ? database(x.abs(), v0, v1, s1.lo, sg, 0)
            : return(v1.add(v0))

    block database(ax: F64, v0: F64, v1: F64, v2: F64, sg: F64, k: USize):
        end : Bool = k.eq(12)
        branch end
            ? nudge(v0, v1, v2)
            : continue
        hit : Bool = ax.eq(F64.from_bits(CM_F64_ATAN_DB_X.get(k)))
        branch hit
            ? found(k, sg)
            : database(ax, v0, v1, v2, sg, k.add(1))

    block found(k: USize, sg: F64):
        rh : F64 = F64.from_bits(CM_F64_ATAN_DB_H.get(k)).copysign(x)
        rl : F64 = sg.mul(F64.from_bits(CM_F64_ATAN_DB_L.get(k)))
        return(rh.add(rl))

    // v1 has an all-zero significand: move it one ulp toward v2
    block nudge(v0: F64, v1: F64, v2: F64):
        t1    : U64  = v1.bits()
        exact : Bool = t1.bitand(0x000FFFFFFFFFFFFF).ne(0)
        branch exact
            ? return(v1.add(v0))
            : continue
        opposite : Bool = v2.bits().bitxor(t1).shr(63).ne(0)
        t        : U64  = opposite
            ? t1.sub_wrap(1)
            : t1.add_wrap(1)
        return(F64.from_bits(t).add(v0))

/// The double-double sum (xh + xl) + (ch + cl), for any operands.
routine cm_f64_atan_adddd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64InvtrigDD
    block entry():
        s : F64 = xh.add(ch)
        d : F64 = s.sub(xh)
        l : F64 = ch.sub(d).add(xh.add(d.sub(s))).add(xl.add(cl))
        return(CmF64InvtrigDD { hi: s, lo: l })

/// The double-double product (xh + xl) (ch + cl), renormalized.
routine cm_f64_atan_muldd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64InvtrigDD
    block entry():
        ahlh : F64 = ch.mul(xl)
        alhh : F64 = cl.mul(xh)
        ahhh : F64 = ch.mul(xh)
        ahhl : F64 = ch.mul_add(xh, ahhh.neg()).add(alhh.add(ahlh))
        return(cm_f64_invtrig_fasttwosum(ahhh, ahhl))
