/// 10^n for 0 <= n <= 22 (the exactly representable powers of ten) as F64 bits, then zeros up to 32 entries.
preset CM_F64_LOG10_POW10: @Array<U64, 32> <- { 0x3FF0000000000000, 0x4024000000000000,
        0x4059000000000000, 0x408F400000000000, 0x40C3880000000000, 0x40F86A0000000000,
        0x412E848000000000, 0x416312D000000000, 0x4197D78400000000, 0x41CDCD6500000000,
        0x4202A05F20000000, 0x42374876E8000000, 0x426D1A94A2000000, 0x42A2309CE5400000,
        0x42D6BCC41E900000, 0x430C6BF526340000, 0x4341C37937E08000, 0x4376345785D8A000,
        0x43ABC16D674EC800, 0x43E158E460913D00, 0x4415AF1D78B58C40, 0x444B1AE4D6E2EF50,
        0x4480F0CF064DD592, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000000 }

/// log10 self, correctly rounded.
routine F64.log10(self: Self) -> Self
    block entry():
        u    : U64  = self.bits()
        e    : S64  = u.shr(52).to<S64>().sub(0x3FF)
        edge : Bool = e.ge(0x400).bitor(e.eq(-0x3FF))
        branch edge
            ? edge(u, e)
            : normal(u, e)

    // x <= 0, NaN, infinity or subnormal
    block edge(u: U64, e: S64):
        nan_inf  : Bool = e.eq(0x400).bitor(e.eq(0xC00).bitand(u.ne(0xFFF0000000000000)))
        negative : Bool = self.lt(0.0)
        zero     : Bool = self.eq(0.0)
        when:
            nan_inf  -> return(self.add(self))  // +inf or NaN of either sign
            negative -> return(Self.from_bits(0xFFF8000000000000))  // the default NaN of 0/0
            zero     -> return(Self.from_bits(0xFFF0000000000000))  // the pole
            else     -> subnormal()

    // scale into the normal range
    block subnormal():
        us : U64 = self.mul(0x1p52).bits()
        jump normal(us, us.shr(52).to<S64>().sub(0x3FF).sub(52))

    block normal(u: U64, e: S64):
        // x = 10^n for 0 <= n <= 22 gives exactly n: n is a guess from the exponent (32-bit wrapping arithmetic)
        n     : U32  = U32.mul_wrap(0x267CFA2, e.to_wrap<U32>().add_wrap(1)).shr(27)
        exact : Bool = u.eq(CM_F64_LOG10_POW10.get(n.to<USize>()))
        branch exact
            ? return(n.to<Self>())
            : continue
        hl    : CmF64LogDd = cm_f64_log10_fast(e, u.bitand(0x000FFFFFFFFFFFFF))
        left  : Self       = hl.hi.add(hl.lo.sub(0x1.04p-69))  // the fast path's maximal absolute error
        right : Self       = hl.hi.add(hl.lo.add(0x1.04p-69))
        sure  : Bool       = left.eq(right)
        branch sure
            ? return(left)
            : accurate()

    // the fast path fails with probability about 2^-11.5: log x in dint arithmetic, times 1/log(10)
    block accurate():
        y        : CmF64LogDint = cm_f64_log_dint_log_of(self)
        inv_ln10 : CmF64LogDint = CmF64LogDint { m: 0xDE5BD8A937287195355BAAAFAD33DC32, ex: -2,
                sgn: 0 }
        return(cm_f64_log_dint_to_f64(cm_f64_log_dint_mul(y, inv_ln10)))

/// The fast path of log10: a double-double approximation of log10(2^e m) with absolute error below 2^-68.98, where
/// m = 1 + mbits/2^52.
private routine cm_f64_log10_fast(e: S64, mbits: U64) -> CmF64LogDd
    block entry():
        em    : U64  = mbits.add(0x0010000000000000)
        large : Bool = mbits.ge(0x6A09E667F3BCD)  // m > sqrt(2): divide it by 2, so y lies in [1/sqrt(2), sqrt(2))
        branch large
            ? reduce(e.add(1), em.shr(44), F64.from_bits(mbits.add(0x3FE0000000000000)))
            : reduce(e, em.shr(43), F64.from_bits(mbits.add(0x3FF0000000000000)))

    block reduce(ee: S64, i: U64, y: F64):
        k  : USize = i.sub(362).to<USize>()
        r  : F64   = F64.from_bits(CM_F64_LOG10_INVERSE.get(k))
        l1 : F64   = F64.from_bits(CM_F64_LOG10_LOG_INV.get(k.mul(2)))
        l2 : F64   = F64.from_bits(CM_F64_LOG10_LOG_INV.get(k.mul(2).add(1)))
        z  : F64   = r.mul_add(y, -1.0)  // exact
        // P(z) - z, for |z| < 0.00212097167968735
        z2  : F64 = z.mul(z)
        p45 : F64 = F64.mul_add(-0x1.55362255e0f63p-3, z, 0x1.999a14758b084p-3)
        p23 : F64 = F64.mul_add(-0x1.0000000537df6p-2, z, 0x1.555555554f4d8p-2)
        ph0 : F64 = p45.mul_add(z2, p23)
        ph1 : F64 = ph0.mul_add(z, -0x1.ffffffffffffap-2)
        ph  : F64 = ph1.mul(z2)
        // add e log(2): log2_h is an integer multiple of 2^-42, so e log2_h + l1 is exact
        eed : F64 = ee.to<F64>()
        hi  : F64 = eed.mul_add(0x1.62e42fefa38p-1, l1)
        h   : F64 = hi.add(z)
        lo0 : F64 = z.sub(h.sub(hi))
        lo1 : F64 = ph.add(lo0.add(l2))
        lo  : F64 = eed.mul_add(0x1.ef35793c7673p-45, lo1)
        // multiply by the double-double 1/log(10), neglecting the low*low term
        ph10 : F64 = h.mul(0x1.bcb7b1526e50ep-2)
        s    : F64 = h.mul_add(0x1.bcb7b1526e50ep-2, ph10.neg())
        t    : F64 = lo.mul_add(0x1.bcb7b1526e50ep-2, s)
        return(CmF64LogDd { hi: ph10, lo: h.mul_add(0x1.95355baaafad3p-57, t) })
