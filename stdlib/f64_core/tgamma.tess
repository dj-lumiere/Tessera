// Tessera stdlib: the correctly rounded gamma function of F64
//
// A double-double fast phase with an error bound: a polynomial for 1/gamma
// near zero, a polynomial around 3.5 + i shifted by the recurrence for
// -3 <= x <= 4, exp(lgamma(x)) from Stirling's series above 4, and the
// reflection formula below -3. When the bound can't decide the rounding, an
// accurate phase redoes it with a triple-double product of powers of the
// reduced argument over nine ranges, and a table settles the hardest inputs.
// Round to nearest only: overflow gives +inf, +-0 gives +-inf, the negative
// integers and -inf give NaN, a result below the subnormals rounds to a zero
// with the true sign, and NaN comes back quiet.
//
// This file also holds the double-double helpers and the logarithm shared with
// the log-gamma port (lgamma.tess).
//
// Ported from CORE-MATH, src/binary64/tgamma/tgamma.c via RazorForge's B64Tgamma.rf.
// Copyright (c) 2024 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Accurate-path ranges of tgamma, by range index: offsets of the double coefficients in
/// CM_F64_TGAMMA_T.
preset CM_F64_TGAMMA_BR_CH: @Array<USize, 9> <- { 235, 317, 397, 474, 551, 623, 693, 762, 828 }

/// The number of double coefficients of each range.
preset CM_F64_TGAMMA_BR_NCH: @Array<USize, 9> <- { 14, 14, 13, 13, 12, 12, 11, 10, 9 }

/// Offsets of each range's double-double coefficient pairs.
preset CM_F64_TGAMMA_BR_CL: @Array<USize, 9> <- { 249, 331, 410, 487, 563, 635, 704, 772, 837 }

/// The number of double-double coefficient pairs of each range.
preset CM_F64_TGAMMA_BR_NCL: @Array<USize, 9> <- { 34, 33, 32, 32, 30, 29, 29, 28, 26 }

/// Each range's reference integer (jm = base - floor(x)).
preset CM_F64_TGAMMA_BR_BASE: @Array<S64, 9> <- { 160, 128, 96, 64, 32, 26, 16, 8, 4 }

/// Each range's result exponent offset.
preset CM_F64_TGAMMA_BR_EOFF: @Array<S64, 9> <- { 942, 713, 495, 293, 115, 86, 42, 14, 3 }

/// The reduction table of the gamma logarithms: c0 (unsigned).
preset CM_F64_GAMMA_LOGD_B0: @Array<U64, 32> <- { 301, 7189, 13383, 18923, 23845, 28184, 31969,
    35231, 37996, 40288, 42129, 43542, 44546, 45160, 45399, 45281, 44821, 44032, 42929, 41522,
    39825, 37848, 35602, 33097, 30341, 27345, 24115, 20661, 16989, 13107, 9022, 4740 }

/// The reduction table of the gamma logarithms: c1 (signed).
preset CM_F64_GAMMA_LOGD_B1: @Array<S64, 32> <- { 27565, 24786, 22167, 19696, 17361, 15150, 13054,
    11064, 9173, 7372, 5657, 4020, 2457, 962, -468, -1838, -3151, -4412, -5622, -6786, -7905, -8982,
    -10020, -11020, -11985, -12916, -13816, -14685, -15526, -16339, -17126, -17889 }

