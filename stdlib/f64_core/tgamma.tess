/// A double-double number hi + lo.
record CmF64GammaDD
    hi : F64
    lo : F64

/// A triple-double number hi + mid + lo.
record CmF64GammaTD
    hi  : F64
    mid : F64
    lo  : F64

/// The fast phase of gamma: gamma(x) within eps 2^sc of (hi + lo) 2^sc. Status
/// 0 is a normal result, 2 a reflection result that would be subnormal, and 1
/// a case the fast phase doesn't cover (settled exactly by the caller).
record CmF64TgammaFast
    status : U64
    hi     : F64
    lo     : F64
    eps    : F64
    sc     : S64

/// e^x as a double-double mantissa and a binary exponent: (hi + lo) 2^e.
record CmF64TgammaExp
    hi : F64
    lo : F64
    e  : S64

/// The reduced argument of the gamma logarithms: x = 2^e tf, with the two
/// table indices of the reciprocal that brings tf close to 1 (ed = e as F64).
record CmF64GammaLogArg
    tf : F64
    ed : F64
    i1 : USize
    i2 : USize

/// Γ(self): ±inf at ±0, NaN at the negative integers and -inf.
routine F64.gamma(self: Self) -> Self
    block entry():
        f  : CmF64TgammaFast = cm_f64_tgamma_dd(self)
        st : U64             = f.status
        when st:
            0    -> fast(f)
            2    -> reflected(f)
            else -> return(cm_f64_tgamma_special(self))

    // the fast phase decides unless the error bound straddles a rounding boundary
    block fast(f: CmF64TgammaFast):
        ub     : Self = f.hi.add(f.lo.add(f.eps))
        lb     : Self = f.hi.add(f.lo.sub(f.eps))
        unsure : Bool = ub.ne(lb)
        branch unsure
            ? return(cm_f64_tgamma_accurate(self))
            : continue
        return(Self.from_bits(ub.bits().add_wrap(f.sc.to_wrap<U64>().shl(52))))

    // reflection whose result may be subnormal: hi + lo is the value times 2^e, e = -sc
    block reflected(f: CmF64TgammaFast):
        e         : S64  = f.sc.neg()
        sign_exp  : U64  = f.hi.bits().shr(52)
        re        : S64  = sign_exp.bitand(0x7FF).to<S64>()
        subnormal : Bool = re.sub(e).le(0)
        branch subnormal
            ? subnormal(f, e, re)
            : normal(f, e)

    // round at the subnormal quantum: add a power of two that fixes the exponent, then strip it
    block subnormal(f: CmF64TgammaFast, e: S64, re: S64):
        shift_exp : S64          = e.sub(re).add(1)
        th        : U64          = f.hi.bits().add_wrap(shift_exp.to_wrap<U64>().shl(52))
        s         : CmF64GammaDD = cm_f64_gamma_fasttwosum(
            Self.from_bits(th.bitand(0xFFF0000000000000)), f.hi)
        rl        : Self         = f.lo.add(s.lo)
        ub        : Self         = s.hi.add(rl.add(f.eps))
        lb        : Self         = s.hi.add(rl.sub(f.eps))
        unsure    : Bool         = ub.ne(lb)
        branch unsure
            ? return(cm_f64_tgamma_accurate(self))
            : return(Self.from_bits(ub.bits().bitand(0x800FFFFFFFFFFFFF)))

    block normal(f: CmF64TgammaFast, e: S64):
        ub     : Self = f.hi.add(f.lo.add(f.eps))
        lb     : Self = f.hi.add(f.lo.sub(f.eps))
        unsure : Bool = ub.ne(lb)
        branch unsure
            ? return(cm_f64_tgamma_accurate(self))
            : return(Self.from_bits(ub.bits().sub_wrap(e.to_wrap<U64>().shl(52))))

/// gamma(x) for the inputs the fast phase leaves out: NaN, infinities, |x| < 2^-112,
/// overflow, integers, and x <= -184.
private routine cm_f64_tgamma_special(x: F64) -> F64
    block entry():
        t  : U64 = x.bits()
        ax : U64 = t.shl(1)
        fx : F64 = x.floor()
        when:
            ax.ge(0xFFE0000000000000)  -> non_finite(t, ax)
            ax.lt(0x71E0000000000000)  -> tiny()
            x.ge(0x1.573fae561f648p+7) -> return(F64.add(0x1.fp+1023, 0x1.fp+1023))
            fx.eq(x)                   -> integer(fx)
            else                       -> under(fx)

    // -inf has no gamma (the default NaN), +inf maps to itself, and x + x quiets a NaN
    block non_finite(t: U64, ax: U64):
        infinite : Bool = ax.eq(0xFFE0000000000000)
        minusinf : Bool = infinite.bitand(t.shr(63).eq(1))
        when:
            minusinf -> return(F64.from_bits(0xFFF8000000000000))
            infinite -> return(x)
            else     -> return(x.add(x))

    // |x| < 2^-112: gamma(x) rounds to 1/x (the C code steps below it for x = 2^k under
    // directed rounding; r - 0.5 is r in round to nearest)
    block tiny():
        edge : Bool = x.eq(0x1p-1024)
        branch edge
            ? return(F64.add(0x1.fffffffffffffp+1023, 0x1p+970))
            : continue
        r    : F64  = F64.div(1.0, x)
        zero : Bool = x.eq(0.0)
        branch zero
            ? return(r)
            : continue
        exact : Bool = r.mul_add(x, -1.0).eq(0.0)
        branch exact
            ? return(r.sub(0.5))
            : return(r)

    // an integer: +-0 is a pole of the sign of x, a negative integer a NaN pole, and k gives (k-1)!
    block integer(fx: F64):
        zero     : Bool = x.eq(0.0)
        negative : Bool = x.lt(0.0)
        when:
            zero     -> return(F64.div(1.0, x))
            negative -> return(F64.from_bits(0xFFF8000000000000))
            else     -> factorial(fx.to<S64>(), 1, 1.0, 0.0, 1.0)

    block factorial(k: S64, i: S64, th: F64, tl: F64, x0: F64):
        more : Bool = i.lt(k)
        branch more
            ? factor(k, i, th, tl, x0)
            : return(th.add(tl))

    block factor(k: S64, i: S64, th: F64, tl: F64, x0: F64):
        m : CmF64GammaDD = cm_f64_gamma_mulddd(x0, th, tl)
        jump factorial(k, i.add(1), m.hi, m.lo, x0.add(1.0))

    // x <= -184, not an integer: |gamma(x)| < 2^-1078 rounds to a zero with the sign of gamma
    block under(fx: F64):
        fits : Bool = fx.ge(-0x1p+62)
        branch fits
            ? parity(fx.to<S64>())
            : parity(0)

    block parity(kk: S64):
        even : Bool = kk.bitand(1).eq(0)
        branch even
            ? return(F64.mul(0x1p-1022, 0x1p-1022))
            : return(F64.mul(0x1p-1022, -0x1p-1022))

/// The double-double fast phase of gamma.
private routine cm_f64_tgamma_dd(x: F64) -> CmF64TgammaFast
    block entry():
        ax   : U64             = x.bits().shl(1)
        none : CmF64TgammaFast = CmF64TgammaFast { status: 1, hi: 0.0, lo: 0.0, eps: 0.0, sc: 0 }
        skip : Bool            = ax.ge(0xFFE0000000000000).bitor(ax.lt(0x71E0000000000000))
        branch skip
            ? return(none)
            : continue
        small : Bool = x.abs().lt(0.25)
        branch small
            ? return(cm_f64_tgamma_small(x))
            : continue
        huge_or_whole : Bool = x.ge(0x1.573fae561f648p+7).bitor(x.floor().eq(x))
        exact         : Bool = huge_or_whole.bitor(x.le(-184.0))
        when:
            exact      -> return(none)
            x.lt(-3.0) -> return(cm_f64_tgamma_reflect(x))
            x.gt(4.0)  -> return(cm_f64_tgamma_stirling(x))
            else       -> return(cm_f64_tgamma_mid(x))

/// Fast phase for |x| < 0.25: gamma(x) = 1/x + P(x).
private routine cm_f64_tgamma_small(x: F64) -> CmF64TgammaFast
    block entry():
        x2        : F64          = x.mul(x)
        x4        : F64          = x2.mul(x2)
        x8        : F64          = x4.mul(x4)
        c0        : F64          = cm_f64_tgamma_pair4(x, x2, 899)
        c4        : F64          = cm_f64_tgamma_pair4(x, x2, 903)
        c8        : F64          = cm_f64_tgamma_pair4(x, x2, 907)
        c12       : F64          = cm_f64_tgamma_pair4(x, x2, 911)
        lo        : F64          = c0.add(x4.mul(c4))
        hi        : F64          = c8.add(x4.mul(c12))
        cl        : F64          = x.mul(lo.add(x8.mul(hi)))
        p         : CmF64GammaDD = cm_f64_tgamma_polyddd(x, 5, 889, cl)
        fh        : F64          = F64.div(1.0, x)
        fl        : F64          = fh.mul_add(x.neg(), 1.0).mul(fh)
        f         : CmF64GammaDD = cm_f64_gamma_fastsum(fh, fl, p.hi, p.lo)
        x6_scaled : F64          = x2.mul(x4).mul(0x1.203af9ee75616p-48)
        eps       : F64          = f.hi.mul(x6_scaled.add(0x1.9d35025bff857p-62))
        return(CmF64TgammaFast { status: 0, hi: f.hi, lo: f.lo, eps: eps, sc: 0 })

/// Fast phase for -184 < x < -3: gamma(x) = pi / (sin(pi x) gamma(1 - x)).
private routine cm_f64_tgamma_reflect(x: F64) -> CmF64TgammaFast
    block entry():
        s   : CmF64GammaDD   = cm_f64_gamma_fasttwosum(x.neg(), 1.0)
        lg  : CmF64GammaDD   = cm_f64_tgamma_lgamma_asym(s.hi, s.lo)
        ex  : CmF64TgammaExp = cm_f64_tgamma_expd(lg.hi, lg.lo)
        ix  : F64            = x.floor()
        ip  : S64            = ix.to<S64>()
        sp  : CmF64GammaDD   = cm_f64_tgamma_sinpid(x.sub(ix))
        m   : CmF64GammaDD   = cm_f64_gamma_muldd(sp.hi, sp.lo, ex.hi, ex.lo)
        rcp : F64            = F64.div(1.0, m.hi)
        rh  : F64            = rcp.mul(0x1.921fb54442d18p+1)
        err : F64            = rh.mul_add(m.hi, -0x1.921fb54442d18p+1)
        rl  : F64            = rcp.mul(F64.sub(0x1.1a62633145c07p-53, m.lo.mul(rh)).sub(err))
        odd : Bool           = ip.bitand(1).ne(0)
        sh  : F64            = odd
            ? rh.neg()
            : rh
        sl : F64 = odd
            ? rl.neg()
            : rl
        eps : F64  = sh.mul(F64.sub(0x1.48ad3caefe280p-67, x.mul(0x1.61019f74442b7p-73)))
        ok  : Bool = ip.ge(-170)
        st  : U64  = ok
            ? 0
            : 2
        return(CmF64TgammaFast { status: st, hi: sh, lo: sl, eps: eps, sc: ex.e.neg() })

/// Fast phase for 4 < x < 0x1.573fae561f648p+7: gamma(x) = exp(lgamma(x)).
private routine cm_f64_tgamma_stirling(x: F64) -> CmF64TgammaFast
    block entry():
        lg  : CmF64GammaDD   = cm_f64_tgamma_lgamma_asym(x, 0.0)
        ex  : CmF64TgammaExp = cm_f64_tgamma_expd(lg.hi, lg.lo)
        eps : F64            = ex.hi.mul(x.mul(0x1.bce27bce24d11p-73).add(0x1.2e3b40a0e9b4fp-69))
        return(CmF64TgammaFast { status: 0, hi: ex.hi, lo: ex.lo, eps: eps, sc: ex.e })

/// Fast phase for -3 <= x <= 4: a polynomial around 3.5 + i, shifted by the
/// recurrence gamma(x + 1) = x gamma(x).
private routine cm_f64_tgamma_mid(x: F64) -> CmF64TgammaFast
    block entry():
        ri   : F64          = x.sub(3.5).round_ties_even()
        d    : F64          = x.sub(ri.add(3.5))
        d2   : F64          = d.mul(d)
        d4   : F64          = d2.mul(d2)
        lo   : F64          = cm_f64_tgamma_pair4(d, d2, 961)
        hi   : F64          = cm_f64_tgamma_pair4(d, d2, 965)
        fl   : F64          = d.mul(lo.add(d4.mul(hi)))
        f    : CmF64GammaDD = cm_f64_tgamma_polyddd(d, 10, 915, fl)
        jm   : S64          = ri.abs().to<S64>()
        none : Bool         = jm.eq(0)
        branch none
            ? finish(f, 1.0, 0.0)
            : product(f, x, 0.0, x, 0.0, jm.sub(1))

    // w = x (x + 1) ... (x + jm - 1) in double-double
    block product(f: CmF64GammaDD, xph: F64, xpl: F64, wh: F64, wl: F64, j: S64):
        done : Bool = j.eq(0)
        branch done
            ? finish(f, wh, wl)
            : factor(f, xph, xpl, wh, wl, j)

    block factor(f: CmF64GammaDD, xph: F64, xpl: F64, wh: F64, wl: F64, j: S64):
        big : Bool         = xph.abs().gt(1.0)
        s   : CmF64GammaDD = big
            ? cm_f64_gamma_fasttwosum(xph, 1.0)
            : cm_f64_gamma_fasttwosum(1.0, xph)
        xpl1 : F64          = xpl.add(s.lo)
        w    : CmF64GammaDD = cm_f64_gamma_muldd(s.hi, xpl1, wh, wl)
        jump product(f, s.hi, xpl1, w.hi, w.lo, j.sub(1))

    block finish(f: CmF64GammaDD, wh: F64, wl: F64):
        rh     : F64          = F64.div(1.0, wh)
        rh_err : F64          = rh.mul_add(wh.neg(), 1.0).sub(wl.mul(rh))
        rl     : F64          = rh_err.mul(rh)
        g      : CmF64GammaDD = cm_f64_gamma_muldd(rh, rl, f.hi, f.lo)
        return(CmF64TgammaFast { status: 0, hi: g.hi, lo: g.lo,
            eps: g.hi.mul(0x1.2e3b40a0e9b4fp-70), sc: 0 })

/// Entry i of CM_F64_TGAMMA_T as an F64.
routine cm_f64_tgamma_t(i: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_TGAMMA_T.get(i)))

/// (c[q] + x c[q+1]) + x2 (c[q+2] + x c[q+3]) for the entries c of CM_F64_TGAMMA_T.
private routine cm_f64_tgamma_pair4(x: F64, x2: F64, q: USize) -> F64
    block entry():
        a : F64 = cm_f64_tgamma_t(q).add(x.mul(cm_f64_tgamma_t(q.add(1))))
        b : F64 = cm_f64_tgamma_t(q.add(2)).add(x.mul(cm_f64_tgamma_t(q.add(3))))
        return(a.add(x2.mul(b)))

/// The correctly rounded gamma of a tabulated hard-to-round x, or f otherwise.
private routine cm_f64_tgamma_database(x: F64, f: F64) -> F64
    block entry():
        jump search(0, 56)

    block search(a: S64, b: S64):
        empty : Bool = a.gt(b)
        branch empty
            ? return(f)
            : probe(a, b)

    block probe(a: S64, b: S64):
        m    : S64   = a.add(b).div(2)
        base : USize = m.mul(3).to<USize>()
        key  : F64   = cm_f64_tgamma_t(base)
        when:
            key.lt(x) -> search(m.add(1), b)
            key.eq(x) -> return(cm_f64_tgamma_t(base.add(1)).add(cm_f64_tgamma_t(base.add(2))))
            else      -> search(a, m.sub(1))

/// The accurate phase of gamma, for a finite non-integer x with -184 < x < 0x1.573fae561f648p+7.
private routine cm_f64_tgamma_accurate(x: F64) -> F64
    block entry():
        small : Bool = x.abs().lt(0.25)
        branch small
            ? return(cm_f64_tgamma_accurate_small(x))
            : continue
        ix   : F64          = x.floor()
        d    : F64          = F64.mul(2.0, x.sub(ix.add(0.5)))
        i    : S64          = ix.to<S64>()
        k    : USize        = cm_f64_tgamma_range(i)
        pf   : CmF64GammaDD = cm_f64_tgamma_poly3(d, CM_F64_TGAMMA_BR_NCH.get(k),
            CM_F64_TGAMMA_BR_CH.get(k), CM_F64_TGAMMA_BR_NCL.get(k), CM_F64_TGAMMA_BR_CL.get(k))
        jm   : S64          = CM_F64_TGAMMA_BR_BASE.get(k).sub(i)
        eoff : S64          = CM_F64_TGAMMA_BR_EOFF.get(k)
        x1   : F64          = x.sub(1.0)
        when:
            jm.gt(0) -> up(pf, jm, eoff, x, 0.0, x, 0.0, jm.sub(1))
            jm.lt(0) -> down(pf, jm, eoff, x1, 0.0, x1, 0.0, S64.sub(-1, jm))
            else     -> finish(pf.hi, pf.lo, jm, eoff)

    // below the range's reference: w = x (x + 1) ... (x + jm - 1), rescaled to stay finite
    block up(pf: CmF64GammaDD, jm: S64, eoff: S64, xph: F64, xpl: F64, wh: F64, wl: F64, j: S64):
        done : Bool = j.eq(0)
        branch done
            ? divide(pf, jm, eoff, wh, wl)
            : up_factor(pf, jm, eoff, xph, xpl, wh, wl, j)

    block up_factor(pf: CmF64GammaDD, jm: S64, eoff: S64, xph: F64, xpl: F64, wh: F64, wl: F64,
        j: S64):
        big : Bool         = xph.abs().gt(1.0)
        s   : CmF64GammaDD = big
            ? cm_f64_gamma_fasttwosum(xph, 1.0)
            : cm_f64_gamma_fasttwosum(1.0, xph)
        n    : CmF64GammaDD = cm_f64_gamma_fasttwosum(s.hi, xpl.add(s.lo))
        w    : CmF64GammaDD = cm_f64_gamma_muldd3(n.hi, n.lo, wh, wl)
        huge : Bool         = w.hi.abs().gt(0x1p+518)
        branch huge
            ? up(pf, jm, eoff.sub(500), n.hi, n.lo, w.hi.mul(0x1p-500), w.lo.mul(0x1p-500),
                j.sub(1))
            : up(pf, jm, eoff, n.hi, n.lo, w.hi, w.lo, j.sub(1))

    block divide(pf: CmF64GammaDD, jm: S64, eoff: S64, wh: F64, wl: F64):
        rh     : F64          = F64.div(1.0, wh)
        rh_err : F64          = rh.mul_add(wh.neg(), 1.0).sub(wl.mul(rh))
        rl     : F64          = rh_err.mul(rh)
        m      : CmF64GammaDD = cm_f64_gamma_muldd3(pf.hi, pf.lo, rh, rl)
        jump finish(m.hi, m.lo, jm, eoff)

    // above the range's reference: w = (x - 1) (x - 2) ... (x + jm)
    block down(pf: CmF64GammaDD, jm: S64, eoff: S64, xph: F64, xpl: F64, wh: F64, wl: F64, j: S64):
        done : Bool = j.eq(0)
        branch done
            ? multiply(pf, jm, eoff, wh, wl)
            : down_factor(pf, jm, eoff, xph, xpl, wh, wl, j)

    block down_factor(pf: CmF64GammaDD, jm: S64, eoff: S64, xph: F64, xpl: F64, wh: F64, wl: F64,
        j: S64):
        s : CmF64GammaDD = cm_f64_gamma_fasttwosum(xph, -1.0)
        n : CmF64GammaDD = cm_f64_gamma_fasttwosum(s.hi, xpl.add(s.lo))
        w : CmF64GammaDD = cm_f64_gamma_muldd3(n.hi, n.lo, wh, wl)
        jump down(pf, jm, eoff, n.hi, n.lo, w.hi, w.lo, j.sub(1))

    block multiply(pf: CmF64GammaDD, jm: S64, eoff: S64, wh: F64, wl: F64):
        m : CmF64GammaDD = cm_f64_gamma_muldd3(pf.hi, pf.lo, wh, wl)
        jump finish(m.hi, m.lo, jm, eoff)

    // a correction term that is zero in round to nearest (the C code needs it under directed rounding)
    block finish(fh: F64, fl: F64, jm: S64, eoff: S64):
        below : Bool = jm.le(0)
        branch below
            ? correct_below(fh, fl, jm, eoff)
            : correct_above(fh, fl, jm, eoff)

    block correct_below(fh: F64, fl: F64, jm: S64, eoff: S64):
        c1  : F64 = F64.add(0x1p-54, 0x1p-107).sub(0x1p-54)
        c2  : F64 = F64.sub(0x1p-53, 0x1p-107).sub(0x1p-53)
        crr : F64 = c1.add(c2)
        jump round(fh, fl.add(fh.mul(jm.to<F64>().mul(crr))), eoff)

    block correct_above(fh: F64, fl: F64, jm: S64, eoff: S64):
        op   : F64  = F64.sub(0x1p-53, 0x1p-107)
        om   : F64  = F64.add(-0x1p-53, 0x1p-107)
        same : Bool = op.eq(om.neg())
        crr  : F64  = same
            ? F64.sub(0x1p-53, op)
            : 0.0
        steps : F64 = jm.sub(5).to<F64>()
        corr  : F64 = steps.mul(crr).mul(0x1.0a3d70a3d70a4p+0)
        jump round(fh, fl.sub(fh.mul(corr)), eoff)

    // (fh + fl) 2^eoff, rounded at the subnormal quantum when it falls there
    block round(fh: F64, fl: F64, eoff: S64):
        eps       : F64  = F64.mul(0x1.ep-103, fh)
        ub        : F64  = fh.add(fl.add(eps))
        lb        : F64  = fh.add(fl.sub(eps))
        res       : U64  = fh.add(fl).bits()
        exp_field : U64  = res.shr(52).bitand(0x7FF)
        re        : S64  = exp_field.to<S64>()
        subnormal : Bool = re.add(eoff).le(0)
        branch subnormal
            ? subnormal(fh, fl, eoff, re, res, ub, lb)
            : done(ub, lb, res.add_wrap(eoff.to_wrap<U64>().shl(52)))

    block subnormal(fh: F64, fl: F64, eoff: S64, re: S64, res: U64, ub: F64, lb: F64):
        fix_exp : S64          = eoff.add(re).sub(1)
        th      : U64          = res.sub_wrap(fix_exp.to_wrap<U64>().shl(52)).bitand(0xFFF0000000000000)
        s       : CmF64GammaDD = cm_f64_gamma_fasttwosum(F64.from_bits(th), fh)
        rounded : F64          = s.hi.add(fl.add(s.lo))
        r       : U64          = rounded.bits().bitand(0x800FFFFFFFFFFFFF)
        jump done(ub, lb, r)

    block done(ub: F64, lb: F64, res: U64):
        unsure : Bool = ub.ne(lb)
        branch unsure
            ? return(cm_f64_tgamma_database(x, F64.from_bits(res)))
            : return(F64.from_bits(res))

/// The accurate-phase range of floor(x) = i: 0 for i > 159 up to 8 for i <= 7.
private routine cm_f64_tgamma_range(i: S64) -> USize
    block entry():
        when:
            i.gt(159) -> return(0)
            i.gt(127) -> return(1)
            i.gt(95)  -> return(2)
            i.gt(63)  -> return(3)
            i.gt(31)  -> return(4)
            i.gt(25)  -> return(5)
            i.gt(15)  -> return(6)
            i.gt(7)   -> return(7)
            else      -> return(8)

/// The accurate phase for |x| < 0.25: gamma(x) = 1/x + P(x) in triple-double.
private routine cm_f64_tgamma_accurate_small(x: F64) -> F64
    block entry():
        x2  : F64          = x.mul(x)
        x4  : F64          = x2.mul(x2)
        c0  : F64          = cm_f64_tgamma_pair4(x, x2, 227)
        c4  : F64          = cm_f64_tgamma_pair4(x, x2, 231)
        c   : F64          = c0.add(x4.mul(c4))
        p   : CmF64GammaDD = cm_f64_tgamma_polyddd(x, 28, 171, x.mul(c))
        fh  : F64          = F64.div(1.0, x)
        dh  : F64          = fh.mul_add(x.neg(), 1.0)
        fl  : F64          = dh.mul(fh)
        fll : F64          = fl.mul_add(x.neg(), dh).mul(fh)
        s   : CmF64GammaDD = cm_f64_gamma_sumdd(fl, fll, p.hi, p.lo)
        s2  : CmF64GammaDD = cm_f64_gamma_twosum(s.hi, s.lo)
        a   : CmF64GammaDD = cm_f64_gamma_fasttwosum(fh, s2.hi)
        b   : CmF64GammaDD = cm_f64_gamma_fasttwosum(a.lo, s2.lo)
        et  : F64          = cm_f64_gamma_fasttwosum(a.hi, F64.mul(2.0, b.hi)).lo
        tie : Bool         = et.eq(0.0)
        branch tie
            ? nudge(a.hi, b.hi, b.lo)
            : return(a.hi.add(b.hi))

    // fh + fl is a rounding midpoint: move fl toward fll
    block nudge(fh: F64, fl: F64, fll: F64):
        sign_product : F64  = F64.copysign(1.0, fl).mul(F64.copysign(1.0, fll))
        same         : Bool = sign_product.gt(0.0)
        branch same
            ? return(fh.add(fl.mul(F64.add(1.0, 0x1p-50))))
            : return(fh.add(fl.mul(F64.sub(1.0, 0x1p-50))))

/// The double-double polynomial c[0] + c[1] x + ... + (c[n-1] + l) x^(n-1) of the
/// (high, low) pairs of CM_F64_TGAMMA_T from base, at a double-double x.
private routine cm_f64_tgamma_polydd(xh: F64, xl: F64, n: USize, base: USize,
    l: F64) -> CmF64GammaDD
    block entry():
        i : USize        = n.sub(1)
        k : USize        = base.add(i.mul(2))
        s : CmF64GammaDD = cm_f64_gamma_fasttwosum(cm_f64_tgamma_t(k), l)
        jump loop(i, s.hi, s.lo.add(cm_f64_tgamma_t(k.add(1))))

    block loop(i: USize, ch: F64, cl: F64):
        done : Bool = i.eq(0)
        branch done
            ? return(CmF64GammaDD { hi: ch, lo: cl })
            : step(i.sub(1), ch, cl)

    block step(i: USize, ch: F64, cl: F64):
        k : USize        = base.add(i.mul(2))
        m : CmF64GammaDD = cm_f64_gamma_muldd(xh, xl, ch, cl)
        a : CmF64GammaDD = cm_f64_gamma_fastsum(cm_f64_tgamma_t(k), cm_f64_tgamma_t(k.add(1)), m.hi,
            m.lo)
        jump loop(i, a.hi, a.lo)

/// The same polynomial at a double x, accumulated with sumdd.
private routine cm_f64_tgamma_polyddd(x: F64, n: USize, base: USize, l: F64) -> CmF64GammaDD
    block entry():
        i : USize        = n.sub(1)
        k : USize        = base.add(i.mul(2))
        s : CmF64GammaDD = cm_f64_gamma_fasttwosum(cm_f64_tgamma_t(k), l)
        jump loop(i, s.hi, s.lo.add(cm_f64_tgamma_t(k.add(1))))

    block loop(i: USize, ch: F64, cl: F64):
        done : Bool = i.eq(0)
        branch done
            ? return(CmF64GammaDD { hi: ch, lo: cl })
            : step(i.sub(1), ch, cl)

    block step(i: USize, ch: F64, cl: F64):
        k : USize        = base.add(i.mul(2))
        m : CmF64GammaDD = cm_f64_gamma_mulddd(x, ch, cl)
        a : CmF64GammaDD = cm_f64_gamma_sumdd(cm_f64_tgamma_t(k), cm_f64_tgamma_t(k.add(1)), m.hi,
            m.lo)
        jump loop(i, a.hi, a.lo)

/// The double polynomial c[0] + c[1] x + ... + c[n-1] x^(n-1) of the high parts of the
/// pairs of CM_F64_TGAMMA_T from base.
private routine cm_f64_tgamma_polyd(x: F64, n: USize, base: USize) -> F64
    block entry():
        i : USize = n.sub(1)
        jump loop(i, cm_f64_tgamma_t(base.add(i.mul(2))))

    block loop(i: USize, ch: F64):
        done : Bool = i.eq(0)
        branch done
            ? return(ch)
            : step(i.sub(1), ch)

    block step(i: USize, ch: F64):
        jump loop(i, cm_f64_tgamma_t(base.add(i.mul(2))).add(x.mul(ch)))

/// x times the triple-double x0 + x1 + x2, as a triple-double.
private routine cm_f64_tgamma_sprod(x: F64, x0: F64, x1: F64, x2: F64) -> CmF64GammaTD
    block entry():
        z0  : F64 = x.mul(x0)
        z0l : F64 = x.mul_add(x0, z0.neg())
        z1  : F64 = x.mul(x1)
        z2  : F64 = x.mul(x2).add(x.mul_add(x1, z1.neg()))
        // split z0 so that ulp(high part) = 2^-25 (exact for |z0| <= 2^26)
        zh : F64          = z0.add(0x1.8p+27).sub(0x1.8p+27)
        e  : F64          = z0.sub(zh)
        s  : CmF64GammaDD = cm_f64_gamma_fasttwosum(e, z0l)
        t  : CmF64GammaDD = cm_f64_gamma_twosum(s.hi, z1)
        return(CmF64GammaTD { hi: zh, mid: t.hi, lo: t.lo.add(s.lo).add(z2) })

/// The accurate-phase polynomial: imax double coefficients at chbase, weighted by
/// triple-double powers of d, plus a double-double tail of jmax pairs at clbase.
private routine cm_f64_tgamma_poly3(d: F64, imax: USize, chbase: USize, jmax: USize,
    clbase: USize) -> CmF64GammaDD
    block entry():
        jump loop(1, 1.0, 0.0, 0.0, cm_f64_tgamma_t(chbase), 0.0, 0.0)

    block loop(i: USize, t0: F64, t1: F64, t2: F64, s0: F64, s1: F64, s2: F64):
        done : Bool = i.ge(imax)
        branch done
            ? tail(s0, s1, s2)
            : term(i, t0, t1, t2, s0, s1, s2)

    block term(i: USize, t0: F64, t1: F64, t2: F64, s0: F64, s1: F64, s2: F64):
        t   : CmF64GammaTD = cm_f64_tgamma_sprod(d, t0, t1, t2)
        chi : F64          = cm_f64_tgamma_t(chbase.add(i))
        f   : CmF64GammaDD = cm_f64_gamma_mulddd(chi, t.mid, t.lo)
        a   : CmF64GammaDD = cm_f64_gamma_sumdd(s1, s2, f.hi, f.lo)
        jump loop(i.add(1), t.hi, t.mid, t.lo, s0.add(t.hi.mul(chi)), a.hi, a.lo)

    block tail(s0: F64, s1: F64, s2: F64):
        p : CmF64GammaDD = cm_f64_tgamma_polyddd(d, jmax, clbase, 0.0)
        a : CmF64GammaDD = cm_f64_gamma_sumdd(s1, s2, p.hi, p.lo)
        b : CmF64GammaDD = cm_f64_gamma_fasttwosum(s0, a.hi)
        c : CmF64GammaDD = cm_f64_gamma_fasttwosum(b.lo, a.lo)
        return(CmF64GammaDD { hi: b.hi, lo: c.hi })

/// sin(pi x) as a double-double, for 0 < x < 1.
private routine cm_f64_tgamma_sinpid(x: F64) -> CmF64GammaDD
    block entry():
        from_half : F64          = x.sub(0.5).abs()
        y         : F64          = from_half.mul(128.0)
        ix        : F64          = y.round_ties_even()
        d         : F64          = ix.sub(y)
        d2        : F64          = d.mul(d)
        ky        : USize        = ix.to<S64>().to<USize>()
        kx        : USize        = USize.sub(64, ky)
        sh        : F64          = cm_f64_tgamma_t(kx.mul(2).add(1170))
        sl        : F64          = cm_f64_tgamma_t(kx.mul(2).add(1169))
        ch        : F64          = cm_f64_tgamma_t(ky.mul(2).add(1170))
        cl        : F64          = cm_f64_tgamma_t(ky.mul(2).add(1169))
        pp_tail   : F64          = d2.mul(0x1.e1f4826790653p-59).add(-0x1.55d3c7e3bd8bfp-42)
        pp        : F64          = d2.mul(d2.mul(pp_tail).add(0x1.03c1f081b5ac4p-26))
        qq_tail   : F64          = d2.mul(-0x1.32d26e446373ap-50).add(0x1.466bc67748efcp-34)
        qq        : F64          = d2.mul(d2.mul(qq_tail).add(-0x1.4abbce625be53p-19))
        q         : CmF64GammaDD = cm_f64_gamma_fasttwosum(0x1.921fb54442d18p-6, qq)
        c         : CmF64GammaDD = cm_f64_gamma_muldd(q.hi, q.lo.add(0x1.1a624b88c9448p-60), ch, cl)
        t0        : CmF64GammaDD = cm_f64_gamma_fasttwosum(-0x1.3bd3cc9be45dep-12, pp)
        th        : CmF64GammaDD = cm_f64_gamma_mulddd(d, t0.hi, t0.lo.add(-0x1.692b66e3cf6e8p-66))
        ph        : CmF64GammaDD = cm_f64_gamma_muldd(th.hi, th.lo, sh, sl)
        c1        : CmF64GammaDD = cm_f64_gamma_fastsum(c.hi, c.lo, ph.hi, ph.lo)
        c2        : CmF64GammaDD = cm_f64_gamma_mulddd(d, c1.hi, c1.lo)
        return(cm_f64_gamma_fastsum(sh, sl, c2.hi, c2.lo))

/// e^(x + l) as (hi + lo) 2^e.
private routine cm_f64_tgamma_expd(x: F64, l: F64) -> CmF64TgammaExp
    block entry():
        m     : CmF64GammaDD = cm_f64_gamma_muldd(x, l, 0x1.71547652b82fep+10,
            0x1.777d0ffda0d24p-46)
        ix    : F64          = m.hi.round_ties_even()
        s     : CmF64GammaDD = cm_f64_gamma_fasttwosum(m.hi.sub(ix), m.lo)
        k     : S64          = ix.to<S64>()
        slot0 : S64          = k.shr(5).bitand(31)
        i0    : USize        = slot0.to<USize>()
        i1    : USize        = k.bitand(31).to<USize>()
        r     : CmF64GammaDD = cm_f64_gamma_muldd(cm_f64_tgamma_t(i0.mul(2).add(1300)),
            cm_f64_tgamma_t(i0.mul(2).add(1299)), cm_f64_tgamma_t(i1.mul(2).add(1364)),
            cm_f64_tgamma_t(i1.mul(2).add(1363)))
        fl    : F64          = s.hi.mul(cm_f64_tgamma_polyd(s.hi, 4, 1429))
        f     : CmF64GammaDD = cm_f64_tgamma_polydd(s.hi, s.lo, 1, 1427, fl)
        g     : CmF64GammaDD = cm_f64_gamma_muldd(s.hi, s.lo, f.hi, f.lo)
        o     : CmF64GammaDD = cm_f64_gamma_fasttwosum(1.0, g.hi)
        h     : CmF64GammaDD = cm_f64_gamma_muldd(r.hi, r.lo, o.hi, g.lo.add(o.lo))
        return(CmF64TgammaExp { hi: h.hi, lo: h.lo, e: k.shr(10) })

/// c[q] + z c[q+2] for the entries c of CM_F64_TGAMMA_T.
private routine cm_f64_tgamma_stride2(z: F64, q: USize) -> F64
    block entry():
        return(cm_f64_tgamma_t(q).add(z.mul(cm_f64_tgamma_t(q.add(2)))))

/// ln(gamma(x)) for x = xh + xl > 3 from Stirling's asymptotic series.
private routine cm_f64_tgamma_lgamma_asym(xh: F64, xl: F64) -> CmF64GammaDD
    block entry():
        zh     : F64          = F64.div(1.0, xh)
        dz     : F64          = xl.mul(zh)
        zh_err : F64          = zh.mul_add(xh.neg(), 1.0).sub(dz)
        zl     : F64          = zh_err.mul(zh)
        lg     : CmF64GammaDD = cm_f64_gamma_logd(xh)
        l      : CmF64GammaDD = cm_f64_gamma_muldd(xh.sub(0.5), xl, lg.hi.sub(1.0), lg.lo.add(dz))
        z2     : CmF64GammaDD = cm_f64_gamma_muldd(zh, zl, zh, zl)
        x2     : F64          = z2.hi.mul(z2.hi)
        big    : Bool         = xh.gt(11.5)
        branch big
            ? large(zh, zl, l, z2, x2)
            : small(zh, zl, l, z2, x2)

    block large(zh: F64, zl: F64, l: CmF64GammaDD, z2: CmF64GammaDD, x2: F64):
        a : CmF64GammaDD = cm_f64_gamma_fastsum(l.hi, l.lo, cm_f64_tgamma_t(1437),
            cm_f64_tgamma_t(1438))
        // the high parts of the pairs 2..7
        q0 : F64 = cm_f64_tgamma_stride2(z2.hi, 1441)
        q2 : F64 = cm_f64_tgamma_stride2(z2.hi, 1445)
        q4 : F64 = cm_f64_tgamma_stride2(z2.hi, 1449)
        fl : F64 = z2.hi.mul(q0.add(x2.mul(q2.add(x2.mul(q4)))))
        jump finish(zh, zl, a, cm_f64_tgamma_polydd(z2.hi, z2.lo, 1, 1439, fl))

    block small(zh: F64, zl: F64, l: CmF64GammaDD, z2: CmF64GammaDD, x2: F64):
        a  : CmF64GammaDD = cm_f64_gamma_fastsum(l.hi, l.lo, cm_f64_tgamma_t(1453),
            cm_f64_tgamma_t(1454))
        x4 : F64          = x2.mul(x2)
        // the high parts of the pairs 3..12
        q0 : F64 = cm_f64_tgamma_stride2(z2.hi, 1459)
        q2 : F64 = cm_f64_tgamma_stride2(z2.hi, 1463)
        q4 : F64 = cm_f64_tgamma_stride2(z2.hi, 1467)
        q6 : F64 = cm_f64_tgamma_stride2(z2.hi, 1471)
        q8 : F64 = cm_f64_tgamma_stride2(z2.hi, 1475)
        hi : F64 = q4.add(x2.mul(q6.add(x2.mul(q8))))
        lo : F64 = q0.add(x2.mul(q2))
        q  : F64 = lo.add(x4.mul(hi))
        jump finish(zh, zl, a, cm_f64_tgamma_polydd(z2.hi, z2.lo, 2, 1455, z2.hi.mul(q)))

    block finish(zh: F64, zl: F64, a: CmF64GammaDD, f: CmF64GammaDD):
        g : CmF64GammaDD = cm_f64_gamma_muldd(zh, zl, f.hi, f.lo)
        return(cm_f64_gamma_fastsum(a.hi, a.lo, g.hi, g.lo))

/// The argument reduction of the gamma logarithms, for a positive finite x (subnormals included).
routine cm_f64_gamma_log_arg(x: F64) -> CmF64GammaLogArg
    block entry():
        t  : U64  = x.bits()
        ex : U64  = t.shr(52)
        sn : Bool = ex.eq(0)
        branch sn
            ? normalize(t)
            : reduce(t, ex.to<S64>())

    block normalize(t: U64):
        k : U64 = t.leading_zeros()
        jump reduce(t.shl(k.sub(11)), S64.sub(12, k.to<S64>()))

    block reduce(t: U64, ex: S64):
        m    : U64   = t.bitand(0x000FFFFFFFFFFFFF)
        i    : USize = m.shr(47).to<USize>()
        d    : U64   = m.bitand(0x00007FFFFFFFFFFF)
        prod : S64   = CM_F64_GAMMA_LOGD_B1.get(i).mul(d.shr(16).to<S64>())
        sum  : U64   = m.add_wrap(CM_F64_GAMMA_LOGD_B0.get(i).shl(33)).add_wrap(prod.to_wrap<U64>())
        j    : U64   = sum.shr(42)
        tf   : F64   = F64.from_bits(m.bitor(0x3FF0000000000000))
        return(CmF64GammaLogArg { tf: tf, ed: ex.sub(0x3FF).to<F64>(), i1: j.shr(5).to<USize>(),
            i2: j.bitand(0x1F).to<USize>() })

/// ln(x) as a double-double, for a positive finite x (subnormals included).
routine cm_f64_gamma_logd(x: F64) -> CmF64GammaDD
    block entry():
        a   : CmF64GammaLogArg = cm_f64_gamma_log_arg(x)
        r   : F64              = cm_f64_tgamma_t(a.i1.add(969)).mul(cm_f64_tgamma_t(a.i2.add(1002)))
        o   : F64              = r.mul(a.tf)
        dxl : F64              = r.mul_add(a.tf, o.neg())
        dxh : F64              = o.sub(1.0)
        dx  : F64              = r.mul_add(a.tf, -1.0)
        dx2 : F64              = dx.mul(dx)
        p0  : F64              = dx.mul(0x1.55555555543d5p-2).add(-0x1.fffffffffffd3p-2)
        p2  : F64              = dx.mul(0x1.999a692c56e4ep-3).add(-0x1.000002bb2d74ep-2)
        f   : F64              = dx2.mul(p0.add(dx2.mul(p2)))
        k1  : USize            = a.i1.mul(2).add(1035)
        k2  : USize            = a.i2.mul(2).add(1101)
        lt0 : F64              = cm_f64_tgamma_t(k1.add(1)).add(cm_f64_tgamma_t(k2.add(1)))
        lt  : F64              = lt0.add(a.ed.mul(0x1.62e42fef8p-1))
        lh  : F64              = lt.add(dxh)
        ll  : F64              = lt.sub(lh).add(dxh)
        lo0 : F64              = cm_f64_tgamma_t(k1).add(cm_f64_tgamma_t(k2))
        lo  : F64              = lo0.add(a.ed.mul(0x1.1cf79abc9e3b4p-36)).add(dxl)
        return(CmF64GammaDD { hi: lh, lo: ll.add(lo).add(f) })

/// x + y and its rounding error, for |x| >= |y| (or x = 0).
routine cm_f64_gamma_fasttwosum(x: F64, y: F64) -> CmF64GammaDD
    block entry():
        s : F64 = x.add(y)
        z : F64 = s.sub(x)
        return(CmF64GammaDD { hi: s, lo: y.sub(z) })

/// x + y and its rounding error, for any magnitudes.
routine cm_f64_gamma_twosum(x: F64, y: F64) -> CmF64GammaDD
    block entry():
        xbig : Bool = x.abs().gt(y.abs())
        branch xbig
            ? return(cm_f64_gamma_fasttwosum(x, y))
            : return(cm_f64_gamma_fasttwosum(y, x))

/// (xh + xl) + (yh + yl), for |xh| >= |yh|.
routine cm_f64_gamma_fastsum(xh: F64, xl: F64, yh: F64, yl: F64) -> CmF64GammaDD
    block entry():
        s : CmF64GammaDD = cm_f64_gamma_fasttwosum(xh, yh)
        return(CmF64GammaDD { hi: s.hi, lo: xl.add(yl).add(s.lo) })

/// (xh + xl) + (yh + yl), for any magnitudes.
routine cm_f64_gamma_sumdd(xh: F64, xl: F64, yh: F64, yl: F64) -> CmF64GammaDD
    block entry():
        xbig : Bool         = xh.abs().gt(yh.abs())
        s    : CmF64GammaDD = xbig
            ? cm_f64_gamma_fasttwosum(xh, yh)
            : cm_f64_gamma_fasttwosum(yh, xh)
        return(CmF64GammaDD { hi: s.hi, lo: xl.add(yl).add(s.lo) })

/// (xh + xl) (ch + cl), not renormalized.
routine cm_f64_gamma_muldd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64GammaDD
    block entry():
        ahhh  : F64 = ch.mul(xh)
        err   : F64 = ch.mul_add(xh, ahhh.neg())
        cross : F64 = ch.mul(xl).add(cl.mul(xh))
        return(CmF64GammaDD { hi: ahhh, lo: cross.add(err) })

/// (xh + xl) (yh + yl), renormalized.
routine cm_f64_gamma_muldd3(xh: F64, xl: F64, yh: F64, yl: F64) -> CmF64GammaDD
    block entry():
        ch  : F64 = xh.mul(yh)
        cl1 : F64 = xh.mul_add(yh, ch.neg())
        tl0 : F64 = xl.mul(yl)
        tl1 : F64 = tl0.add(xh.mul(yl))
        cl2 : F64 = tl1.add(xl.mul(yh))
        return(cm_f64_gamma_fasttwosum(ch, cl1.add(cl2)))

/// x (ch + cl) for a double x.
routine cm_f64_gamma_mulddd(x: F64, ch: F64, cl: F64) -> CmF64GammaDD
    block entry():
        ahhh : F64 = ch.mul(x)
        err  : F64 = ch.mul_add(x, ahhh.neg())
        return(CmF64GammaDD { hi: ahhh, lo: cl.mul(x).add(err) })
