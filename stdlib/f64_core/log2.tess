// Tessera stdlib: the correctly rounded base-2 logarithm of F64
//
// x = 2^e t with t in [1, 2): a corrected 10-bit index picks two reciprocals
// r1 r2 with r1 r2 t close to 1/log(2) scaled, and log2 x = e - log2(r1) -
// log2(r2) + log2(r1 r2 t) with a short polynomial, as a double-double. When
// that can't decide the rounding, the accurate path reduces by four levels
// of reciprocal tables and evaluates in triple-double. Round to nearest only:
// log2(+-0) is -inf, a negative input gives NaN, NaN comes back quiet, and
// log2(2^n) is exactly n.
//
// Ported from CORE-MATH, src/binary64/log2/log2.c via RazorForge's B64Log2.rf.
// Copyright (c) 2023 Alexei Sibidanov
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Index corrections c0 of the fast path: the reduction index is refined by c0 + c1 d.
preset CM_F64_LOG2_B0: @Array<U64, 32> <- { 0x000000000000012D, 0x0000000000001C15,
    0x0000000000003447, 0x00000000000049EB, 0x0000000000005D25, 0x0000000000006E18,
    0x0000000000007CE1, 0x000000000000899F, 0x000000000000946C, 0x0000000000009D60,
    0x000000000000A491, 0x000000000000AA16, 0x000000000000AE02, 0x000000000000B068,
    0x000000000000B157, 0x000000000000B0E1, 0x000000000000AF15, 0x000000000000AC00,
    0x000000000000A7B1, 0x000000000000A232, 0x0000000000009B91, 0x00000000000093D8,
    0x0000000000008B12, 0x0000000000008149, 0x0000000000007685, 0x0000000000006AD1,
