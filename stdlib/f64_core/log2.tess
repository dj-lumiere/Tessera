/// log2 self, correctly rounded.
routine F64.log2(self: Self) -> Self
    block entry():
        tu      : U64  = self.bits()
        ex      : U64  = tu.shr(52)
        e       : S64  = ex.to<S64>().sub(0x3FF)
        small   : Bool = ex.eq(0)
        special : Bool = ex.ge(0x7FF)  // the sign bit is set, or +inf or NaN
        when:
            small   -> small(tu, e)
            special -> special(tu)
            else    -> normal(tu, e)

    // +0 or a subnormal
    block small(tu: U64, e: S64):
        zero : Bool = tu.eq(0)
        branch zero
            ? return(Self.from_bits(0xFFF0000000000000))
            : continue
        // normalize the mantissa
        k : U64 = tu.leading_zeros()
        jump normal(tu.shl(k.sub(11)), e.sub(k.to<S64>().sub(12)))

    block special(tu: U64):
        zero     : Bool = tu.shl(1).eq(0)
        nan      : Bool = tu.shl(1).gt(U64.shl(0x7FF, 53))
        negative : Bool = tu.shr(63).eq(1)
        when:
            zero     -> return(Self.from_bits(0xFFF0000000000000))  // -0: the pole
            nan      -> return(self.add(self))
            negative -> return(Self.from_bits(0xFFF8000000000000))  // the default NaN of 0/0
            else     -> return(self)  // +inf

    block normal(tn: U64, e: S64):
        tu    : U64  = tn.bitand(0x000FFFFFFFFFFFFF)
        power : Bool = tu.eq(0)  // exact powers of two
        branch power
            ? return(e.to<Self>())
            : continue
        ed   : Self  = e.to<Self>()
        i    : USize = tu.shr(47).to<USize>()
        d    : U64   = tu.bitand(0x00007FFFFFFFFFFF)
        corr : S64   = CM_F64_LOG2_B1.get(i).mul(d.shr(16).to<S64>())
        jsum : U64   = tu.add_wrap(CM_F64_LOG2_B0.get(i).shl(33)).add_wrap(corr.to_wrap<U64>())
        j    : U64   = jsum.shr(42)
        tf   : Self  = Self.from_bits(tu.bitor(0x3FF0000000000000))
        i1   : USize = j.shr(5).to<USize>()
        i2   : USize = j.bitand(0x1F).to<USize>()
        r    : Self  = Self.from_bits(CM_F64_LOG2_R1.get(i1)).mul(Self.from_bits(CM_F64_LOG2_R2.get(i2)))
        o    : Self  = r.mul(tf)
        dxl  : Self  = r.mul_add(tf, o.neg())
        dxh  : Self  = o.sub(0x1.71548p+0)  // l2h
        dx   : Self  = dxh.add(dxl)
        dx2  : Self  = dx.mul(dx)
        f01  : Self  = dx.mul(0x1.47fd2632d2d32p-3).add(-0x1.62e41d56c64p-2)
        f23  : Self  = dx.mul(0x1.7a3314c5bef3cp-5).add(-0x1.5504497831ba7p-4)
        f    : Self  = dx2.mul(f01.add(dx2.mul(f23)))
        lt   : Self  = cm_f64_log2_high(i1, i2).add(ed)
        lh   : Self  = lt.add(dxh)
        ll0  : Self  = lt.sub(lh).add(dxh)
        l12  : Self  = cm_f64_log2_low(i1, i2).add(dxl)
        ll1  : Self  = ll0.add(l12.add(dxh.mul(-0x1.ad47a2f472159p-22)))  // l2l
        ll   : Self  = ll1.add(f)
        lb   : Self  = lh.add(ll.sub(2.64e-22))
        ub   : Self  = lh.add(ll.add(2.64e-22))
        sure : Bool  = lb.eq(ub)
        branch sure
            ? return(lb)
            : return(cm_f64_log2_refine(self, ub))

/// The high parts of -log2(r1[i1]) - log2(r2[i2]), summed.
private routine cm_f64_log2_high(i1: USize, i2: USize) -> F64
    block entry():
        a : F64 = F64.from_bits(CM_F64_LOG2_L1.get(i1.mul(2).add(1)))
        b : F64 = F64.from_bits(CM_F64_LOG2_L2.get(i2.mul(2).add(1)))
        return(a.add(b))

/// The low parts of -log2(r1[i1]) - log2(r2[i2]), summed.
private routine cm_f64_log2_low(i1: USize, i2: USize) -> F64
    block entry():
        a : F64 = F64.from_bits(CM_F64_LOG2_L1.get(i1.mul(2)))
        b : F64 = F64.from_bits(CM_F64_LOG2_L2.get(i2.mul(2)))
        return(a.add(b))

/// The accurate path of log2, taken when the fast path can't decide the rounding: a is the fast path's
/// approximation, x is positive and finite.
private routine cm_f64_log2_refine(x: F64, a: F64) -> F64
    block entry():
        tu    : U64  = x.bits()
        ex    : U64  = tu.shr(52)
        e     : S64  = ex.to<S64>().sub(0x3FF)
        small : Bool = ex.eq(0)
        branch small
            ? continue
            : reduce(tu, e)
        k : U64 = tu.leading_zeros()
        jump reduce(tu.shl(k.sub(11)), e.sub(k.to<S64>().sub(12)))

    block reduce(tn: U64, e: S64):
        tf  : F64        = F64.from_bits(tn.bitand(0x000FFFFFFFFFFFFF).bitor(0x3FF0000000000000))
        ed  : F64        = e.to<F64>()
        v   : U64        = a.sub(ed).add(0x1.00008p+0).bits()
        i   : U64        = v.sub_wrap(0x3FF0000000000000).shr(36)
        i1  : USize      = i.shr(12).to<USize>()
        i2  : USize      = i.shr(8).bitand(0xF).to<USize>()
        i3  : USize      = i.shr(4).bitand(0xF).to<USize>()
        i4  : USize      = i.bitand(0xF).to<USize>()
        k1  : USize      = i1.mul(3)
        k2  : USize      = i2.add(17).mul(3)
        k3  : USize      = i3.add(34).mul(3)
        k4  : USize      = i4.add(51).mul(3)
        l0  : F64        = cm_f64_log2_ll_sum(k1, k2, k3, k4).add(ed)
        l1  : F64        = cm_f64_log2_ll_sum(k1.add(1), k2.add(1), k3.add(1), k4.add(1))
        l2  : F64        = cm_f64_log2_ll_sum(k1.add(2), k2.add(2), k3.add(2), k4.add(2))
        t12 : F64        = F64.from_bits(CM_F64_LOG2_T1.get(i1)).mul(F64.from_bits(CM_F64_LOG2_T2.get(i2)))
        t34 : F64        = F64.from_bits(CM_F64_LOG2_T3.get(i3)).mul(F64.from_bits(CM_F64_LOG2_T4.get(i4)))
        th  : F64        = t12.mul(t34)
        tl  : F64        = t12.mul_add(t34, th.neg())
        dh  : F64        = th.mul(tf)
        dl  : F64        = th.mul_add(tf, dh.neg())
        sh  : F64        = tl.mul(tf)
        sl0 : F64        = tl.mul_add(tf, sh.neg())
        xs  : CmF64LogDd = cm_f64_log2_fasttwosum(dh.sub(1.0), dl)
        xa  : CmF64LogDd = cm_f64_log2_adddd(xs.hi, xs.lo, sh, sl0)
        xh  : F64        = xa.hi
        xl  : F64        = xa.lo
        c2  : F64        = xh.mul(-0x1.ec709dc3eca5dp-3).add(0x1.2776c50f1ff14p-2)
        sl  : F64        = xh.mul(xh.mul(c2).add(-0x1.71547652b82fep-2))
        // Horner evaluation with the double-double coefficients (1/log(2), -1/(2 log(2)), 1/(3 log(2))), the low
        // tail sl folded into the top coefficient
        ch3 : F64        = F64.add(0x1.ec709dc3a03fdp-2, sl)
        cl3 : F64        = F64.sub(0x1.ec709dc3a03fdp-2, ch3).add(sl).add(0x1.d27e96be541e5p-56)
        m3  : CmF64LogDd = cm_f64_log2_muldd_acc(xh, xl, ch3, cl3)
        ch2 : F64        = m3.hi.add(-0x1.71547652b82fep-1)
        tl2 : F64        = F64.sub(-0x1.71547652b82fep-1, ch2).add(m3.hi)
        cl2 : F64        = m3.lo.add(tl2.add(-0x1.777d0ffda0d24p-57))
        m2  : CmF64LogDd = cm_f64_log2_muldd_acc(xh, xl, ch2, cl2)
        ch1 : F64        = m2.hi.add(0x1.71547652b82fep+0)
        tl1 : F64        = F64.sub(0x1.71547652b82fep+0, ch1).add(m2.hi)
        cl1 : F64        = m2.lo.add(tl1.add(0x1.777d0ffda0d24p-56))
        m1  : CmF64LogDd = cm_f64_log2_muldd_acc(xh, xl, ch1, cl1)
        s   : CmF64LogDd = cm_f64_log2_adddd(m1.hi, m1.lo, l1, l2)
        w0  : CmF64LogDd = cm_f64_log2_fasttwosum(l0, s.hi)
        w1  : CmF64LogDd = cm_f64_log2_fasttwosum(w0.lo, s.lo)
        return(cm_f64_log2_final(w0.hi, w1.hi, w1.lo))

/// v0 + v1 rounded, where v2 is the tail below v1: when v1 has an all-zero mantissa, it's nudged one ulp toward v2 so
/// that the sum rounds correctly.
private routine cm_f64_log2_final(v0: F64, v1: F64, v2: F64) -> F64
    block entry():
        t     : U64  = v1.bits()
        power : Bool = t.bitand(0x000FFFFFFFFFFFFF).eq(0)
        branch power
            ? continue
            : return(v1.add(v0))
        opposite : Bool = v2.bits().bitxor(t).shr(63).eq(1)
        nudged   : U64  = opposite
            ? t.sub_wrap(1)
            : t.add_wrap(1)
        return(F64.from_bits(nudged).add(v0))

/// The sum of the four entries k1..k4 of CM_F64_LOG2_LL, grouped as (k1 + k2) + (k3 + k4).
private routine cm_f64_log2_ll_sum(k1: USize, k2: USize, k3: USize, k4: USize) -> F64
    block entry():
        a : F64 = F64.from_bits(CM_F64_LOG2_LL.get(k1)).add(F64.from_bits(CM_F64_LOG2_LL.get(k2)))
        b : F64 = F64.from_bits(CM_F64_LOG2_LL.get(k3)).add(F64.from_bits(CM_F64_LOG2_LL.get(k4)))
        return(a.add(b))

/// Error-free sum of x and y when |x| >= |y|: s = x + y rounded, and s + e = x + y exactly.
private routine cm_f64_log2_fasttwosum(x: F64, y: F64) -> CmF64LogDd
    block entry():
        s : F64 = x.add(y)
        z : F64 = s.sub(x)
        return(CmF64LogDd { hi: s, lo: y.sub(z) })

/// The sum of the double-doubles (xh, xl) and (ch, cl).
private routine cm_f64_log2_adddd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64LogDd
    block entry():
        s  : F64 = xh.add(ch)
        d  : F64 = s.sub(xh)
        lo : F64 = ch.sub(d).add(xh.add(d.sub(s))).add(xl.add(cl))
        return(CmF64LogDd { hi: s, lo: lo })

/// The product of the double-doubles (xh, xl) and (ch, cl).
private routine cm_f64_log2_muldd_acc(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64LogDd
    block entry():
        ahlh  : F64 = ch.mul(xl)
        alhh  : F64 = cl.mul(xh)
        ahhh  : F64 = ch.mul(xh)
        ahhl0 : F64 = ch.mul_add(xh, ahhh.neg())
        ahhl  : F64 = ahhl0.add(alhh.add(ahlh))
        return(cm_f64_log2_fasttwosum(ahhh, ahhl))
