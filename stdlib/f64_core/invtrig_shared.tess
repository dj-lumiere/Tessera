/// sin(pi/64 j) for j = 0..32 as double-doubles, row-major (low part, high part), as F64 bits.
preset CM_F64_INVTRIG_ASIN_S: Array<U64, 66> = [0x0000000000000000, 0x0000000000000000,
        0xBC2912BD0D569A90, 0x3FA91F65F10DD814, 0xBC3E2718D26ED688, 0x3FB917A6BC29B42C,
        0x3C513000A89A11E0, 0x3FC2C8106E8E613A, 0xBC626D19B9FF8D82, 0x3FC8F8B83C69A60B,
        0xBC642DEEF11DA2C4, 0x3FCF19F97B215F1B, 0xBC75D28DA2C4612D, 0x3FD294062ED59F06,
        0xBC1EFDC0D58CF620, 0x3FD58F9A75AB1FDD, 0xBC672CEDD3D5A610, 0x3FD87DE2A6AEA963,
        0x3C65B362CB974183, 0x3FDB5D1009E15CC0, 0x3C5E0D891D3C6841, 0x3FDE2B5D3806F63B,
        0xBC8A5A014347406C, 0x3FE073879922FFEE, 0x3C8B25DD267F6600, 0x3FE1C73B39AE68C8,
        0xBC6EFCC626F74A6F, 0x3FE30FF7FCE17035, 0x3C68076A2CFDC6B3, 0x3FE44CF325091DD6,
        0xBC875720992BFBB2, 0x3FE57D69348CECA0, 0xBC8BDD3413B26456, 0x3FE6A09E667F3BCD,
        0xBC70F537ACDF0AD7, 0x3FE7B5DF226AAFAF, 0xBC82C5E12ED1336D, 0x3FE8BC806B151741,
        0xBC830EE286712474, 0x3FE9B3E047F38741, 0x3C39F630E8B6DAC8, 0x3FEA9B66290EA1A3,
        0xBC8BC69F324E6D61, 0x3FEB728345196E3E, 0xBC76E0B1757C8D07, 0x3FEC38B2F180BDB1,
        0xBC5E7B6BB5AB58AE, 0x3FECED7AF43CC773, 0x3C7457E610231AC2, 0x3FED906BCF328D46,
        0xBC8014C76C126527, 0x3FEE212104F686E5, 0x3C8760B1E2E3F81E, 0x3FEE9F4156C62DDA,
        0x3C752C7ADC6B4989, 0x3FEF0A7EFB9230D7, 0x3C7562172A361FD3, 0x3FEF6297CFF75CB0,
        0xBC87A0A8CA13571F, 0x3FEFA7557F08A517, 0xBC887DF6378811C7, 0x3FEFD88DA3D12526,
        0xBC6C57BC2E24AA15, 0x3FEFF621E3796D7E, 0x0000000000000000, 0x3FF0000000000000]

/// A double-double number hi + lo.
record CmF64InvtrigDD
    hi : F64
    lo : F64

/// x + y as a double-double (the rounded sum and its error), assuming |x| >= |y| or x = 0.
routine cm_f64_invtrig_fasttwosum(%x: F64, %y: F64) -> CmF64InvtrigDD
    block entry():
        %s : F64 = %x.add(%y)
        %z : F64 = %s.sub(%x)
        return(CmF64InvtrigDD { hi: %s, lo: %y.sub(%z) })

/// The double-double sum (xh + xl) + (yh + yl), assuming |xh| >= |yh| or xh = 0.
routine cm_f64_invtrig_fastsum(%xh: F64, %xl: F64, %yh: F64, %yl: F64) -> CmF64InvtrigDD
    block entry():
        %s : CmF64InvtrigDD = cm_f64_invtrig_fasttwosum(%xh, %yh)
        return(CmF64InvtrigDD { hi: %s.hi, lo: %xl.add(%yl).add(%s.lo) })

/// The double-double product (xh + xl) (ch + cl), not renormalized.
routine cm_f64_invtrig_muldd(%xh: F64, %xl: F64, %ch: F64, %cl: F64) -> CmF64InvtrigDD
    block entry():
        %ahhh : F64 = %ch.mul(%xh)
        %l    : F64 = %cl.mul(%xh).add(%ch.mul(%xl)).add(%ch.mul_add(%xh, %ahhh.neg()))
        return(CmF64InvtrigDD { hi: %ahhh, lo: %l })

/// cc[j][k] of CM_F64_INVTRIG_ASIN_CC, with j8 = 8 j.
routine cm_f64_invtrig_cc(%j8: USize, %k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_INVTRIG_ASIN_CC.get(%j8.add(%k))))

/// The piecewise polynomial of asin(z + zl), with t = z^2 - j/128 and j8 = 8 j:
/// (z + zl) (cc[j][0] + (cc[j][1] + t P(t))), plus f0h + f0l.
routine cm_f64_invtrig_asin_poly(%z: F64, %zl: F64, %t: F64, %j8: USize, %f0h: F64,
        %f0l: F64) -> CmF64InvtrigDD
    block entry():
        %c2  : F64            = cm_f64_invtrig_cc(%j8, 2)
        %c3  : F64            = cm_f64_invtrig_cc(%j8, 3)
        %c4  : F64            = cm_f64_invtrig_cc(%j8, 4)
        %c5  : F64            = cm_f64_invtrig_cc(%j8, 5)
        %c6  : F64            = cm_f64_invtrig_cc(%j8, 6)
        %c7  : F64            = cm_f64_invtrig_cc(%j8, 7)
        %t2  : F64            = %t.mul(%t)
        %a23 : F64            = %t.mul(%c3).add(%c2)
        %a45 : F64            = %t.mul(%c5).add(%c4)
        %a67 : F64            = %t.mul(%c7).add(%c6)
        %d   : F64            = %t.mul(%a23.add(%t2.mul(%a45.add(%t2.mul(%a67)))))
        %fh  : F64            = cm_f64_invtrig_cc(%j8, 0)
        %fl  : F64            = cm_f64_invtrig_cc(%j8, 1).add(%d)
        %p   : CmF64InvtrigDD = cm_f64_invtrig_muldd(%z, %zl, %fh, %fl)
        return(cm_f64_invtrig_fastsum(%f0h, %f0l, %p.hi, %p.lo))

/// The accurate path's polynomial: with v + dv the small rotated angle's sine and
/// v2 + dv2 its square, asin(v + dv) in double-double.
routine cm_f64_invtrig_asin_dd(%v: F64, %dv: F64, %v2: F64, %dv2: F64) -> CmF64InvtrigDD
    block entry():
        %q2 : F64 = %v2.mul(0x1.ca8355d39bb67p-7).add(0x1.1c4ea7a15c997p-6)
        %q1 : F64 = %v2.mul(%q2).add(0x1.6e8ba2ec8cb69p-6)
        %fl : F64 = %v2.mul(%q1)
        // the double-double polynomial over c[0..4], Horner from the top coefficient
        %h0 : CmF64InvtrigDD = cm_f64_invtrig_fasttwosum(0x1.f1c71c71c6d5bp-6, %fl)
        %m4 : CmF64InvtrigDD = cm_f64_invtrig_muldd(%v2, %dv2, %h0.hi,
                F64.add(0x1.b125bccdcc89ep-60, %h0.lo))
        %s3 : CmF64InvtrigDD = cm_f64_invtrig_fastsum(0x1.6db6db6db6db7p-5, -0x1.cb95ff08658e6p-62,
                %m4.hi, %m4.lo)
        %m3 : CmF64InvtrigDD = cm_f64_invtrig_muldd(%v2, %dv2, %s3.hi, %s3.lo)
        %s2 : CmF64InvtrigDD = cm_f64_invtrig_fastsum(0x1.3333333333333p-4, 0x1.9997e3427441bp-59,
                %m3.hi, %m3.lo)
        %m2 : CmF64InvtrigDD = cm_f64_invtrig_muldd(%v2, %dv2, %s2.hi, %s2.lo)
        %s1 : CmF64InvtrigDD = cm_f64_invtrig_fastsum(0x1.5555555555555p-3, 0x1.5555555623513p-57,
                %m2.hi, %m2.lo)
        %m1 : CmF64InvtrigDD = cm_f64_invtrig_muldd(%v2, %dv2, %s1.hi, %s1.lo)
        %s0 : CmF64InvtrigDD = cm_f64_invtrig_fastsum(1.0, -0x1.fc2c76456515bp-108, %m1.hi, %m1.lo)
        return(cm_f64_invtrig_muldd(%v, %dv, %s0.hi, %s0.lo))

/// The accurate path's rotation: with |x| = sin(phi) and j = jf close to phi 64/pi,
/// sin(phi - j pi/64) = |x| cos(j pi/64) - sqrt(1 - x^2) sin(j pi/64) as a double-double.
routine cm_f64_invtrig_rotate(%x: F64, %jf: USize) -> CmF64InvtrigDD
    block entry():
        %s2  : F64            = %x.mul(%x)
        %dx2 : F64            = %x.mul_add(%x, %s2.neg())  // s2 + dx2 = x^2
        %c2a : CmF64InvtrigDD = cm_f64_invtrig_fasttwosum(1.0, %s2.neg())
        %c2  : CmF64InvtrigDD = cm_f64_invtrig_fasttwosum(%c2a.hi, %c2a.lo.sub(%dx2))  // 1 - x^2
        %ch  : F64            = %c2.hi.sqrt()
        %cl  : F64            = %c2.lo.sub(%ch.mul_add(%ch, %c2.hi.neg())).mul(F64.div(0.5, %ch))
        // the table holds sin(pi/64 j) as double-doubles, the smallest term first
        %ic    : USize = USize.sub(32, %jf).mul(2)
        %is    : USize = %jf.mul(2)
        %bigch : F64   = F64.from_bits(CM_F64_INVTRIG_ASIN_S.get(%ic.add(1)))
        %bigcl : F64   = F64.from_bits(CM_F64_INVTRIG_ASIN_S.get(%ic))
        %bigsh : F64   = F64.from_bits(CM_F64_INVTRIG_ASIN_S.get(%is.add(1)))
        %bigsl : F64   = F64.from_bits(CM_F64_INVTRIG_ASIN_S.get(%is))
        %dsh   : F64   = %x.abs().sub(%bigsh)
        %dsl   : F64   = %bigsl.neg()
        %dch   : F64   = %ch.sub(%bigch)
        %dcl   : F64   = %cl.sub(%bigcl)
        %sc    : F64   = %bigsh.mul_add(%dch, 0x1.8p-4).sub(0x1.8p-4)
        %dsc   : F64   = %bigsh.mul_add(%dch, %sc.neg())
        %cs    : F64   = %bigch.mul_add(%dsh, 0x1.8p-4).sub(0x1.8p-4)
        %dcs   : F64   = %bigch.mul_add(%dsh, %cs.neg())
        %v     : F64   = %cs.sub(%sc)  // exact
        %dv1   : F64   = %bigch.mul(%dsl).add(%bigcl.mul(%dsh))
        %dv2   : F64   = %bigsh.mul(%dcl).add(%bigsl.mul(%dch))
        %dv    : F64   = %dv1.sub(%dv2).sub(%dsc.sub(%dcs))
        return(cm_f64_invtrig_fasttwosum(%v, %dv))
