// Tessera stdlib: tables shared by the F64 asinh, acosh and atanh
//
// All three end in a logarithm. The fast path reduces m in [1, 2) with r = r1[i1] r2[i2] ~ 1/m, picking the
// index from a piecewise linear approximation of log2, and adds -log(r1[i1]) - log(r2[i2]) from double-double
// tables. The accurate path reduces again with four 26-bit tables of 2^(-i/2^4), 2^(-i/2^8), 2^(-i/2^12) and
// 2^(-i/2^16) and adds their logarithms from triple-double tables.
//
// Ported from CORE-MATH, src/binary64/asinh/asinh.c, src/binary64/acosh/acosh.c and src/binary64/atanh/atanh.c
// (which carry identical copies of these tables) via RazorForge's B64ArcHypShared.rf.
// Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Piecewise linear approximation of log2 on [1, 2], 32 subintervals: the constant terms (unsigned 16-bit in
/// the original).
