/// The fast-path reduction index j in 0..1024 for the 52 fraction bits t of m in [1, 2): r1[j >> 5] r2[j & 31]
/// approximates 1/m.
routine cm_f64_archyp_index(%t: U64) -> U64
    block entry():
        %i   : USize = %t.shr(47).to_usize()
        %d   : S64   = %t.bitand(0x00007FFFFFFFFFFF).to_s64()
        %bc0 : U64   = CM_F64_ARCHYP_B_C0.get(%i).to_u64()
        %bc1 : S64   = CM_F64_ARCHYP_B_C1.get(%i).mul(%d.shr(16))
        return(%t.add_wrap(%bc0.shl(33)).add_wrap(%bc1.to_u64_wrap()).shr(42))

/// A triple-double value hi + mid + lo.
record CmF64ArchypTd
    hi  : F64
    mid : F64
    lo  : F64

/// The accurate path's -log(rt1[i1] rt2[i2] rt3[i3] rt4[i4]), summed component by component.
routine cm_f64_archyp_log_table(%i1: USize, %i2: USize, %i3: USize, %i4: USize) -> CmF64ArchypTd
    block entry():
        %k1 : USize = %i2.add(17)
        %k2 : USize = %i3.add(34)
        %k3 : USize = %i4.add(51)
        %h  : F64   = cm_f64_archyp_sum4(CM_F64_ARCHYP_LL0.get(%i1), CM_F64_ARCHYP_LL0.get(%k1),
                CM_F64_ARCHYP_LL0.get(%k2), CM_F64_ARCHYP_LL0.get(%k3))
        %m  : F64   = cm_f64_archyp_sum4(CM_F64_ARCHYP_LL1.get(%i1), CM_F64_ARCHYP_LL1.get(%k1),
                CM_F64_ARCHYP_LL1.get(%k2), CM_F64_ARCHYP_LL1.get(%k3))
        %l  : F64   = cm_f64_archyp_sum4(CM_F64_ARCHYP_LL2.get(%i1), CM_F64_ARCHYP_LL2.get(%k1),
                CM_F64_ARCHYP_LL2.get(%k2), CM_F64_ARCHYP_LL2.get(%k3))
        return(CmF64ArchypTd { hi: %h, mid: %m, lo: %l })

/// (a + b) + (c + d) for four F64 given as bits.
private routine cm_f64_archyp_sum4(%a: U64, %b: U64, %c: U64, %d: U64) -> F64
    block entry():
        %ab : F64 = F64.from_bits(%a).add(F64.from_bits(%b))
        %cd : F64 = F64.from_bits(%c).add(F64.from_bits(%d))
        return(%ab.add(%cd))

/// The accurate path's reduction factor rt1[i1] rt2[i2] rt3[i3] rt4[i4] as an exact double-double.
routine cm_f64_archyp_rt(%i1: USize, %i2: USize, %i3: USize, %i4: USize) -> CmF64HypDd
    block entry():
        %t12 : F64 = F64.from_bits(CM_F64_ARCHYP_RT1.get(%i1)).mul(F64.from_bits(CM_F64_ARCHYP_RT2.get(%i2)))
        %t34 : F64 = F64.from_bits(CM_F64_ARCHYP_RT3.get(%i3)).mul(F64.from_bits(CM_F64_ARCHYP_RT4.get(%i4)))
        %th  : F64 = %t12.mul(%t34)
        return(CmF64HypDd { hi: %th, lo: %t12.mul_add(%t34, %th.neg()) })

/// The fast-path polynomial of log(1 + dx) - dx, divided by dx^2.
routine cm_f64_archyp_log_poly(%dx: F64, %dx2: F64) -> F64
    block entry():
        %a : F64 = %dx.mul(0x1.555555555553p-2).add(-0x1p-1)
        %b : F64 = %dx.mul(0x1.99999e33a6366p-3).add(-0x1.fffffffffffap-3)
