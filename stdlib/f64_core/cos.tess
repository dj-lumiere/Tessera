// Tessera stdlib: the correctly rounded cosine of F64
//
// |x| is reduced to x/(2pi) mod 1 = i/2^11 + X (trig_reduce.tess), folded into [0, pi/4] by the symmetries of
// the cosine, and cos x comes from sin2pi and cos2pi of i/2^11 and X in double-double, with an error bound. When
// the bound can't decide the rounding, the accurate path redoes it in 128-bit floating point; five arguments
// that path still can't round have their results written out. Round to nearest only: infinities give the
// default NaN (sign bit set, as x86's 0/0), a NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary64/cos/cos.c via RazorForge's B64Cos.rf.
// Copyright (c) 2022-2025 Paul Zimmermann and Tom Hubrecht
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// In radians.
routine F64.cos(self: Self) -> Self
    block entry():
        ux      : U64  = self.bits()
        special : Bool = ux.shr(52).bitand(0x7FF).eq(0x7FF)
        branch special
            ? special(ux)
            : continue
        ax : Self = Self.from_bits(ux.bitand(0x7FFFFFFFFFFFFFFF))
        // |x| <= 0x1.6a09e667f3bccp-27: cos(x) rounds like 1 - x^2/2
        tiny : Bool = ax.bits().le(0x3E46A09E667F3BCC)
        branch tiny
            ? return(ax.mul_add(-0x1p-28, 1.0))
            : continue
        f     : CmF64TrigBound = cm_f64_cos_fast(ax)
        left  : Self           = f.hi.add(f.lo.sub(f.err))
        right : Self           = f.hi.add(f.lo.add(f.err))
        done  : Bool           = left.eq(right)
        branch done
            ? return(left)
            : return(cm_f64_cos_accurate(ax))

    // an infinity gives the default NaN of an invalid operation, a NaN comes back quiet
    block special(ux: U64):
        inf : Bool = ux.shl(1).eq(0xFFE0000000000000)
        branch inf
            ? return(Self.from_bits(0xFFF8000000000000))
            : return(self.add(self))

/// The fast path for x > 0x1.6a09e667f3bccp-27: hi + lo with |hi + lo - cos(x)| < err.
private routine cm_f64_cos_fast(x: F64) -> CmF64TrigBound
    block entry():
        red : CmF64TrigFast = cm_f64_trig_reduce_fast(x, false)
        // i >= 2^10: pi <= x <= 2pi, cos(pi + x) = -cos(x)
        neg0 : U64 = red.i.shr(10)
        i0   : U64 = red.i.bitand(0x3FF)
        // i >= 2^9: pi/2 <= x <= pi, cos(pi/2 + x) = -sin(x)
        half   : U64 = i0.shr(9)
        is_cos : U64 = U64.bitxor(1, half)
        neg    : U64 = neg0.bitxor(half)
        i1     : U64 = i0.bitand(0x1FF)
        // i >= 2^8: cos(pi/2 - x) = sin(x), and 2^-11 - h is exact
        mirror : Bool = i1.bitand(0x100).ne(0)
        branch mirror
            ? eval(neg, is_cos.bitxor(1), U64.sub(0x1FF, i1), F64.sub(0x1p-11, red.hi),
                red.lo.neg(), red.err)
            : eval(neg, is_cos, i1, red.hi, red.lo, red.err)

    // the SC table is evaluated at i/2^11 + SC[i][0], and h - SC[i][0] is exact
    block eval(neg: U64, is_cos: U64, i: U64, h0: F64, l: F64, err1: F64):
        k      : USize       = i.to<USize>().mul(3)
        h      : F64         = h0.sub(CM_F64_TRIG_SC.get(k))
        u      : CmF64TrigDD = cm_f64_trig_a_mul(h, h)
        ul     : F64         = h.add(h).mul_add(l, u.lo)
        ps     : CmF64TrigDD = cm_f64_trig_eval_ps_fast(h, l, u.hi, ul)
        pc     : CmF64TrigDD = cm_f64_trig_eval_pc_fast(u.hi, ul)
        sin_i  : F64         = CM_F64_TRIG_SC.get(k.add(1))
        cos_i  : F64         = CM_F64_TRIG_SC.get(k.add(2))
        is_sin : Bool        = is_cos.eq(0)
        branch is_sin
            ? sine(neg, sin_i, cos_i, ps, pc, err1)
            : cosine(neg, sin_i, cos_i, ps, pc, err1)

    // sin2pi(i/2^11 + X) = cos2pi(i/2^11) sin2pi(X) + sin2pi(i/2^11) cos2pi(X)
    block sine(neg: U64, sin_i: F64, cos_i: F64, ps: CmF64TrigDD, pc: CmF64TrigDD, err1: F64):
        s : CmF64TrigDD = cm_f64_trig_s_mul(cos_i, ps)
        c : CmF64TrigDD = cm_f64_trig_s_mul(sin_i, pc)
        t : CmF64TrigDD = cm_f64_trig_fast_two_sum(c.hi, s.hi)
        jump finish(neg, t.hi, t.lo.add(s.lo.add(c.lo)), F64.add(0x1.55p-69, err1))

    // cos2pi(i/2^11 + X) = cos2pi(i/2^11) cos2pi(X) - sin2pi(i/2^11) sin2pi(X)
    block cosine(neg: U64, sin_i: F64, cos_i: F64, ps: CmF64TrigDD, pc: CmF64TrigDD, err1: F64):
        c : CmF64TrigDD = cm_f64_trig_s_mul(cos_i, pc)
        s : CmF64TrigDD = cm_f64_trig_s_mul(sin_i, ps)
        t : CmF64TrigDD = cm_f64_trig_fast_two_sum(c.hi, s.hi.neg())
        jump finish(neg, t.hi, t.lo.add(c.lo.sub(s.lo)), F64.add(0x1.81p-69, err1))

    block finish(neg: U64, h: F64, l: F64, err: F64):
        flip : Bool = neg.ne(0)
        hi   : F64  = flip
            ? h.neg()
            : h
        lo : F64 = flip
            ? l.neg()
            : l
        return(CmF64TrigBound { hi: hi, lo: lo, err: err })

/// The accurate path for x > 0x1.6a09e667f3bccp-27, in 128-bit floating point.
private routine cm_f64_cos_accurate(x: F64) -> F64
    block entry():
        red : CmF64TrigAccurate = cm_f64_trig_accurate_reduce(x)
        i   : U64               = red.i
        q   : U64               = red.quadrant
        // pi <= x < 2pi: cos(x) = -cos(x - pi); pi/2 <= x < pi: cos(x) = -sin(x - pi/2)
        neg    : U64 = q.bitand(1).bitxor(q.shr(1).bitand(1))
        is_cos : U64 = U64.bitxor(1, q.shr(1).bitand(1))
        // pi/4 <= x < pi/2: cos(x) = sin(pi/2 - x)
        is_cos2 : U64  = is_cos.bitxor(q.shr(2).bitand(1))
        is_sin  : Bool = is_cos2.eq(0)
        branch is_sin
            ? sine(neg, i, red)
            : cosine(neg, i, red)

    // sin2pi(R) ~ sin2pi(i/2^11) cos2pi(X) + cos2pi(i/2^11) sin2pi(X)
    block sine(neg: U64, i: U64, red: CmF64TrigAccurate):
        u : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_s(i), red.cos)
        v : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_c(i), red.sin)
        jump finish(neg, cm_f64_trig_dint_add(u, v))

    // cos2pi(R) ~ cos2pi(i/2^11) cos2pi(X) - sin2pi(i/2^11) sin2pi(X)
    block cosine(neg: U64, i: U64, red: CmF64TrigAccurate):
        u : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_c(i), red.cos)
        v : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_s(i), red.sin)
        jump finish(neg, cm_f64_trig_dint_add(u, cm_f64_trig_dint_neg(v)))

    // the total error is below 41 ulps of the low word: check the upper 54 bits are determined
    block finish(neg: U64, u: CmF64TrigDint):
        decided : Bool = cm_f64_trig_rounding_decided(u.r, 41)
        branch decided
            ? round(neg, u)
            : continue
        hard1 : Bool = x.eq(0x1.8000000000009p-23)
        hard2 : Bool = x.eq(0x1.8000000000024p-22)
        hard3 : Bool = x.eq(0x1.800000000009p-21)
        hard4 : Bool = x.eq(0x1.20000000000f3p-20)
        hard5 : Bool = x.eq(0x1.800000000024p-20)
        when:
            hard1 -> return(F64.add(0x1.fffffffffff7p-1, 0x1.b56666666666cp-143))
            hard2 -> return(F64.add(0x1.ffffffffffdcp-1, 0x1.b56666666667ep-137))
            hard3 -> return(F64.add(0x1.ffffffffff7p-1, 0x1.b5666666666c4p-131))
            hard4 -> return(F64.add(0x1.fffffffffebcp-1, 0x1.37642666666fdp-127))
            hard5 -> return(F64.add(0x1.fffffffffdcp-1, 0x1.b5666666667ddp-125))
            else  -> round(neg, u)

    block round(neg: U64, u: CmF64TrigDint):
        flip : Bool = neg.ne(0)
        branch flip
            ? return(cm_f64_trig_dint_to_f64(cm_f64_trig_dint_neg(u)))
            : return(cm_f64_trig_dint_to_f64(u))
