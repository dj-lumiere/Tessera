/// 1 - erf(self), accurate where erf is near 1.
routine F64.erfc(self: Self) -> Self
    block entry():
        tu       : U64  = self.bits()
        at       : U64  = tu.bitand(0x7FFFFFFFFFFFFFFF)
        negative : Bool = tu.ge(0x8000000000000000)
        branch negative
            ? negative(tu)
            : positive(at)

    // x = -NaN or x <= 0, excluding +0
    block negative(tu: U64):
        two : Bool = tu.ge(0xC017744F8F74E94B)  // x <= -0x1.7744f8f74e94bp+2: erfc(x) rounds to 2
        one : Bool = self.ge(-0x1.c5bf891b4ef6ap-54)  // erfc(x) rounds to 1
        when:
            two  -> two(tu)
            one  -> return(self.neg().mul_add(0x1p-54, 1.0))
            else -> general()

    block two(tu: U64):
        infinite : Bool = tu.eq(0xFFF0000000000000)
        nan      : Bool = tu.gt(0xFFF0000000000000)
        when:
            infinite -> return(2.0)
            nan      -> return(self.add(self))
            else     -> return(Self.sub(2.0, 0x1p-54))

    // x = +NaN or x >= 0, excluding -0
    block positive(at: U64):
        zero : Bool = at.ge(0x403B39DC41E48BFD)  // x >= 0x1.b39dc41e48bfdp+4: erfc(x) < 2^-1075 rounds to 0
        one  : Bool = self.le(0x1.c5bf891b4ef6ap-55)  // erfc(x) rounds to 1
        when:
            zero -> zero(at)
            one  -> return(self.neg().mul_add(0x1p-54, 1.0))
            else -> general()

    block zero(at: U64):
        infinite : Bool = at.eq(0x7FF0000000000000)
        nan      : Bool = at.gt(0x7FF0000000000000)
        when:
            infinite -> return(0.0)
            nan      -> return(self.add(self))
            else     -> return(Self.mul(0x1p-1074, 0.25))

    // -0x1.7744f8f74e94bp+2 < x < -0x1.c5bf891b4ef6ap-54 or 0x1.c5bf891b4ef6ap-55 < x < 0x1.b39dc41e48bfdp+4
    block general():
        h, l, err = cm_f64_erfc_fast(self)
        left  : Self = h.add(l.sub(err))
        right : Self = h.add(l.add(err))
        sure  : Bool = left.eq(right)
        branch sure
            ? return(left)
            : return(cm_f64_erfc_accurate(self))

// -- double-double helpers -----------------------------------------------------

/// a (bh + bl) as a double-double.
routine cm_f64_erfc_s_mul(a: F64, bh: F64, bl: F64) -> CmF64ErfDd
    block entry():
        p : CmF64ErfDd = cm_f64_erf_a_mul(a, bh)
        return(CmF64ErfDd { hi: p.hi, lo: a.mul_add(bl, p.lo) })

/// (ah + al) (bh + bl) - al bl as a double-double.
routine cm_f64_erfc_d_mul(ah: F64, al: F64, bh: F64, bl: F64) -> CmF64ErfDd
    block entry():
        p  : CmF64ErfDd = cm_f64_erf_a_mul(ah, bh)
        lo : F64        = ah.mul_add(bl, p.lo)
        return(CmF64ErfDd { hi: p.hi, lo: al.mul_add(bh, lo) })

/// x 2^n with a single rounding (C's ldexp), for -2044 <= n <= 2046.
routine cm_f64_erfc_ldexp(x: F64, n: S64) -> F64
    block entry():
        big : Bool = n.gt(1023)
        y   : F64  = big
            ? x.mul(0x1p1023)
            : x
        k : S64 = big
            ? n.sub(1023)
            : n
        tiny : Bool = k.lt(-1022)
        // scale into the normal range first (exact), so the last multiplication is the only rounding
        branch tiny
            ? return(y.mul(cm_f64_erfc_pow2(k.add(1022))).mul(cm_f64_erfc_pow2(-1022)))
            : return(y.mul(cm_f64_erfc_pow2(k)))

/// 2^k for a normal exponent -1022 <= k <= 1023.
routine cm_f64_erfc_pow2(k: S64) -> F64
    block entry():
        return(F64.from_bits(k.add(1023).to_wrap<U64>().shl(52)))

// -- fast path -----------------------------------------------------------------

/// (h, l, err): h + l approximates erfc(x) with absolute error at most err, for
/// -0x1.7744f8f74e94bp+2 < x < 0x1.b39dc41e48bfdp+4.
routine cm_f64_erfc_fast(x: F64) -> (F64, F64, F64)
    block entry():
        negative : Bool = x.lt(0.0)
        moderate : Bool = x.le(0x1.713786d9c7c09p+1)
        when:
            negative -> negative()
            moderate -> moderate()
            else     -> return(cm_f64_erfc_asympt_fast(x))  // erfc(x) < 0.000046

    // erfc(x) = 1 + erf(-x), with the relative error bound made absolute
    block negative():
        f   : CmF64ErfDd = cm_f64_erf_fast(x.neg())
        err : F64        = cm_f64_erf_fast_err(x.neg()).mul(f.hi)
        s   : CmF64ErfDd = cm_f64_erf_fast_two_sum(1.0, f.hi)
        return({ s.hi, s.lo.add(f.lo), err.add(0x1.4p-102) })

    block moderate():
        f    : CmF64ErfDd = cm_f64_erf_fast(x)
        err  : F64        = cm_f64_erf_fast_err(x).mul(f.hi)
        s    : CmF64ErfDd = cm_f64_erf_fast_two_sum(1.0, f.hi.neg())
        l    : F64        = s.lo.sub(f.lo)
        half : Bool       = x.ge(0x1.e861fbb24c00ap-2)  // erf(x) >= 1/2, so 1 - h is exact
        branch half
            ? return({ s.hi, l, err })
            : return({ s.hi, l, err.add(0x1.4p-104) })

/// The fast path erfc(x) = exp(-x^2) p(1/x) for 0x1.713786d9c7c09p+1 < x < 0x1.b39dc41e48bfdp+4, as
/// (h, l, err).
routine cm_f64_erfc_asympt_fast(x: F64) -> (F64, F64, F64)
    block entry():
        tiny : Bool = x.ge(0x1.9db1bb14e15cap+4)  // erfc(x) < 2^-970: leave it to the accurate path
        branch tiny
            ? return({ 0.0, 0.0, 1.0 })
            : continue
        u : CmF64ErfDd = cm_f64_erf_a_mul(x, x)
        e : CmF64ErfDd = cm_f64_erfc_exp_1(u.hi.neg(), u.lo.neg())
        // 1/x as a double-double (one Newton step)
        yh : F64 = F64.div(1.0, x)
        yl : F64 = yh.mul(x.neg().mul_add(yh, 1.0))
        jump find(e, yh, yl, 0)

    // the interval of yh
    block find(e: CmF64ErfDd, yh: F64, yl: F64, i: USize):
        above : Bool = yh.gt(F64.from_bits(CM_F64_ERFC_ASYMPT_THRESHOLD.get(i)))
        branch above
            ? find(e, yh, yl, i.add(1))
            : poly(e, yh, yl, i.mul(13))

    // p(uh + ul) with u = 1/x^2: degrees 23, 21, 19 in double, then 17 down to 3 in double-double
    block poly(e: CmF64ErfDd, yh: F64, yl: F64, p: USize):
        u  : CmF64ErfDd = cm_f64_erf_a_mul(yh, yh)
        ul : F64        = yh.mul(2.0).mul_add(yl, u.lo)
        z0 : F64        = cm_f64_erfc_t(p, 12)
        z1 : F64        = z0.mul_add(u.hi, cm_f64_erfc_t(p, 11))
        z2 : F64        = z1.mul_add(u.hi, cm_f64_erfc_t(p, 10))
        // degree 17: zh (uh + ul) + T[p+9]
        m   : CmF64ErfDd = cm_f64_erfc_s_mul(z2, u.hi, ul)
        z   : CmF64ErfDd = cm_f64_erf_fast_two_sum(cm_f64_erfc_t(p, 9), m.hi)
        uul : CmF64ErfDd = CmF64ErfDd { hi: u.hi, lo: ul }
        jump horner(e, yh, yl, p, uul, 15, z.hi, z.lo.add(m.lo))

    block horner(e: CmF64ErfDd, yh: F64, yl: F64, p: USize, u: CmF64ErfDd, j: USize, zh: F64,
            zl: F64):
        more : Bool = j.ge(3)
        branch more
            ? step(e, yh, yl, p, u, j, zh, zl)
            : finish(e, yh, yl, p, u, zh, zl)

    block step(e: CmF64ErfDd, yh: F64, yl: F64, p: USize, u: CmF64ErfDd, j: USize, zh: F64,
            zl: F64):
        m : CmF64ErfDd = cm_f64_erfc_d_mul(zh, zl, u.hi, u.lo)
        z : CmF64ErfDd = cm_f64_erf_fast_two_sum(cm_f64_erfc_t(p, j.add(1).div(2)), m.hi)
        jump horner(e, yh, yl, p, u, j.sub(2), z.hi, z.lo.add(m.lo))

    // degree 1: (zh + zl) (uh + ul) + T[p] + T[p+1], then times (yh + yl) and (eh + el)
    block finish(e: CmF64ErfDd, yh: F64, yl: F64, p: USize, u: CmF64ErfDd, zh: F64, zl: F64):
        m   : CmF64ErfDd = cm_f64_erfc_d_mul(zh, zl, u.hi, u.lo)
        z   : CmF64ErfDd = cm_f64_erf_fast_two_sum(cm_f64_erfc_t(p, 0), m.hi)
        zl2 : F64        = z.lo.add(m.lo.add(cm_f64_erfc_t(p, 1)))
        q   : CmF64ErfDd = cm_f64_erfc_d_mul(z.hi, zl2, yh, yl)
        r   : CmF64ErfDd = cm_f64_erfc_d_mul(q.hi, q.lo, e.hi, e.lo)
        // the relative error bound is 2^-67.115 < 0x1.d9p-68, and 0x1.d9p-68 h must not underflow
        normal : Bool = r.hi.ge(0x1.151b9a3fdd5c9p-955)
        branch normal
            ? return({ r.hi, r.lo, r.hi.mul(0x1.d9p-68) })
            : return({ r.hi, r.lo, 0x1p-1022 })

/// exp(xh + xl) as a double-double with relative error below 2^-74.139, for |xl/xh| < 2^-23.89 and
/// |xl| < 2^-14.3486 (the fast exponential of CORE-MATH's pow).
routine cm_f64_erfc_exp_1(xh: F64, xl: F64) -> CmF64ErfDd
    block entry():
        // 0x1.71547652b82fep+12 approximates 2^12/log(2)
        k : F64 = xh.mul(0x1.71547652b82fep+12).round_ties_even()
        // log(2)/2^12 as a double-double
        kk    : CmF64ErfDd = cm_f64_erfc_s_mul(k, 0x1.62e42fefa39efp-13, 0x1.abc9e3b39803fp-68)
        y     : CmF64ErfDd = cm_f64_erf_fast_two_sum(xh.sub(kk.hi), xl)
        yl    : F64        = y.lo.sub(kk.lo)
        bk    : S64        = k.to<S64>()
        ku    : U64        = bk.to_wrap<U64>()
        m     : S64        = bk.shr(12).add(0x3FF)
        i2    : USize      = ku.shr(6).bitand(0x3F).to<USize>()
        i1    : USize      = ku.bitand(0x3F).to<USize>()
        t     : CmF64ErfDd = cm_f64_erfc_d_mul(cm_f64_erfc_t2(i1, 0), cm_f64_erfc_t2(i1, 1),
                cm_f64_erfc_t1(i2, 0), cm_f64_erfc_t1(i2, 1))
        q     : CmF64ErfDd = cm_f64_erfc_q_1(y.hi, yl)
        r     : CmF64ErfDd = cm_f64_erfc_d_mul(t.hi, t.lo, q.hi, q.lo)
        scale : F64        = F64.from_bits(m.to_wrap<U64>().shl(52))
        return(CmF64ErfDd { hi: r.hi.mul(scale), lo: r.lo.mul(scale) })

/// exp(zh + zl) as a double-double for |zh + zl| < 2^-12.88 and |zl| < 2^-42.6 (a degree-4
/// polynomial).
routine cm_f64_erfc_q_1(zh: F64, zl: F64) -> CmF64ErfDd
    block entry():
        z  : F64        = zh.add(zl)
        q0 : F64        = F64.mul_add(0x1.55555558489dcp-5, zh, 0x1.5555555995d37p-3)
        q  : F64        = q0.mul_add(z, 0.5)
        s  : CmF64ErfDd = cm_f64_erf_fast_two_sum(1.0, q.mul(z))
        d  : CmF64ErfDd = cm_f64_erfc_d_mul(zh, zl, s.hi, s.lo)
        r  : CmF64ErfDd = cm_f64_erf_fast_two_sum(1.0, d.hi)
        return(CmF64ErfDd { hi: r.hi, lo: r.lo.add(d.lo) })

// -- accurate path -------------------------------------------------------------

/// The correctly rounded erfc(x) for the inputs the fast path can't round,
/// -0x1.7744f8f74e94bp+2 < x < 0x1.b39dc41e48bfdp+4.
routine cm_f64_erfc_accurate(x: F64) -> F64
    block entry():
        negative : Bool = x.lt(0.0)
        moderate : Bool = x.le(0x1.b59ffb450828cp+0)  // erfc(x) >= 2^-6
        when:
            negative -> negative_scan(0)
            moderate -> positive_scan(0)
            else     -> return(cm_f64_erfc_asympt_accurate(x))

    block negative_scan(k: USize):
        more : Bool = k.lt(17)
        branch more
            ? negative_check(k)
            : negative()

    block negative_check(k: USize):
        hit : Bool = x.eq(cm_f64_erfc_neg_exc(k, 0))
        branch hit
            ? return(cm_f64_erfc_neg_exc(k, 1).add(cm_f64_erfc_neg_exc(k, 2)))
            : negative_scan(k.add(1))

    // erfc(x) = 1 + erf(-x)
    block negative():
        a : CmF64ErfDd = cm_f64_erf_accurate(x.neg())
        s : CmF64ErfDd = cm_f64_erf_fast_two_sum(1.0, a.hi)
        return(s.hi.add(s.lo.add(a.lo)))

    block positive_scan(k: USize):
        more : Bool = k.lt(29)
        branch more
            ? positive_check(k)
            : positive()

    block positive_check(k: USize):
        hit : Bool = x.eq(cm_f64_erfc_pos_exc(k, 0))
        branch hit
            ? return(cm_f64_erfc_pos_exc(k, 1).add(cm_f64_erfc_pos_exc(k, 2)))
            : positive_scan(k.add(1))

    block positive():
        a : CmF64ErfDd = cm_f64_erf_accurate(x)
        s : CmF64ErfDd = cm_f64_erf_fast_two_sum(1.0, a.hi.neg())
        return(s.hi.add(s.lo.sub(a.lo)))

/// The accurate asymptotic path erfc(x) = exp(-x^2) p(1/x), correctly rounded, for
/// 0x1.b59ffb450828cp+0 < x < 0x1.b39dc41e48bfdp+4.
routine cm_f64_erfc_asympt_accurate(x: F64) -> F64
    block entry():
        jump scan(0)

    block scan(k: USize):
        more : Bool = k.lt(22)
        branch more
            ? check(k)
            : special()

    block check(k: USize):
        hit : Bool = x.eq(cm_f64_erfc_asympt_exc(k, 0))
        branch hit
            ? return(cm_f64_erfc_asympt_exc(k, 1).add(cm_f64_erfc_asympt_exc(k, 2)))
            : scan(k.add(1))

    // a hard case with a subnormal result that the table can't hold
    block special():
        hard : Bool = x.eq(0x1.a8f7bfbd15495p+4)
        branch hard
            ? return(F64.mul_add(0x1p-1074, -0.25, 0x1.99ef5883f656cp-1024))
            : continue
        // exp(-x^2) as 2^e (eh + el)
        u  : CmF64ErfDd      = cm_f64_erf_a_mul(x, x)
        ex : (F64, F64, S64) = cm_f64_erfc_exp_accurate(u.hi.neg(), u.lo.neg())
        // 1/x as a double-double (one Newton step)
        yh : F64        = F64.div(1.0, x)
        yl : F64        = yh.mul(x.neg().mul_add(yh, 1.0))
        y  : CmF64ErfDd = CmF64ErfDd { hi: yh, lo: yl }
        jump find(ex, y, 0)

    // 0 <= i <= 9
    block find(ex: (F64, F64, S64), y: CmF64ErfDd, i: USize):
        above : Bool = y.hi.gt(F64.from_bits(CM_F64_ERFC_ACC_THRESHOLD.get(i)))
        branch above
            ? find(ex, y, i.add(1))
            : poly(ex, y, i)

    // the polynomial has degree 29 + 2i, its coefficient of largest degree is Tacc[p + 20 + i]
    block poly(ex: (F64, F64, S64), y: CmF64ErfDd, i: USize):
        p  : USize      = i.mul(30)
        u  : CmF64ErfDd = cm_f64_erf_a_mul(y.hi, y.hi)
        ul : F64        = y.hi.mul(2.0).mul_add(y.lo, u.lo)
        uu : CmF64ErfDd = CmF64ErfDd { hi: u.hi, lo: ul }
        jump high(ex, y, p, uu, i.mul(2).add(27), cm_f64_erfc_tacc(p, i.add(20)), 0.0)

    // degree j: (zh + zl) (uh + ul) + Tacc[p + (j-1)/2 + 6]
    block high(ex: (F64, F64, S64), y: CmF64ErfDd, p: USize, u: CmF64ErfDd, j: USize, zh: F64,
            zl: F64):
        more : Bool = j.ge(13)
        branch more
            ? high_step(ex, y, p, u, j, zh, zl)
            : low(ex, y, p, u, j, zh, zl)

    block high_step(ex: (F64, F64, S64), y: CmF64ErfDd, p: USize, u: CmF64ErfDd, j: USize, zh: F64,
            zl: F64):
        m  : CmF64ErfDd = cm_f64_erf_a_mul(zh, u.hi)
        l0 : F64        = zh.mul_add(u.lo, m.lo)
        l  : F64        = zl.mul_add(u.hi, l0)
        s  : CmF64ErfDd = cm_f64_erf_two_sum(cm_f64_erfc_tacc(p, j.sub(1).div(2).add(6)), m.hi)
        jump high(ex, y, p, u, j.sub(2), s.hi, s.lo.add(l))

    // degrees 11 down to 1 have double-double coefficients Tacc[p+j-1] + Tacc[p+j]
    block low(ex: (F64, F64, S64), y: CmF64ErfDd, p: USize, u: CmF64ErfDd, j: USize, zh: F64,
            zl: F64):
        m    : CmF64ErfDd = cm_f64_erf_a_mul(zh, u.hi)
        l0   : F64        = zh.mul_add(u.lo, m.lo)
        l    : F64        = zl.mul_add(u.hi, l0)
        s    : CmF64ErfDd = cm_f64_erf_two_sum(cm_f64_erfc_tacc(p, j.sub(1)), m.hi)
        zl2  : F64        = s.lo.add(l.add(cm_f64_erfc_tacc(p, j)))
        last : Bool       = j.eq(1)
        branch last
            ? finish(ex, y, s.hi, zl2)
            : low(ex, y, p, u, j.sub(2), s.hi, zl2)

    // times (yh + yl) gives p(1/x) = erfc(x) exp(x^2); normalize, times (eh + el), then 2^e
    block finish(ex: (F64, F64, S64), y: CmF64ErfDd, zh: F64, zl: F64):
        eh, el, e = ex
        q      : CmF64ErfDd = cm_f64_erf_a_mul(zh, y.hi)
        ql0    : F64        = zh.mul_add(y.lo, q.lo)
        ql     : F64        = zl.mul_add(y.hi, ql0)
        n      : CmF64ErfDd = cm_f64_erf_fast_two_sum(q.hi, ql)
        r      : CmF64ErfDd = cm_f64_erf_a_mul(n.hi, eh)
        l0     : F64        = n.hi.mul_add(el, r.lo)
        l      : F64        = n.lo.mul_add(eh, l0)
        res    : F64        = cm_f64_erfc_ldexp(r.hi.add(l), e)
        normal : Bool       = res.ge(0x1p-1022)
        branch normal
            ? return(res)
            : continue
        // a subnormal erfc(x) needs a special rounding
        corr0 : F64 = r.hi.sub(cm_f64_erfc_ldexp(res, e.neg()))
        corr  : F64 = corr0.add(l)
        return(res.add(cm_f64_erfc_ldexp(corr, e)))

/// exp(xh + xl) as 2^e (h + l) with about 104 bits of accuracy, for -742 <= xh + xl <= -2.92.
routine cm_f64_erfc_exp_accurate(xh: F64, xl: F64) -> (F64, F64, S64)
    block entry():
        // xh + xl ~ k log(2) + yh + yl
        kd : F64 = xh.mul(0x1.71547652b82fep+0).round_ties_even()
        k  : S64 = kd.to<S64>()
        // log(2) as 0x1.62e42fefa39efp-1 + 0x1.abc9e3b398p-56 + 0x1.f97b57a079a19p-103: k times the
        // middle part is exact, and yh is exact by Sterbenz
        yh0 : F64        = kd.neg().mul_add(0x1.62e42fefa39efp-1, xh)
        t   : CmF64ErfDd = cm_f64_erf_two_sum(kd.neg().mul(0x1.abc9e3b398p-56), xl)
        y   : CmF64ErfDd = cm_f64_erf_fast_two_sum(yh0, t.hi)
        yh  : F64        = y.hi
        yl  : F64        = kd.neg().mul_add(0x1.f97b57a079a19p-103, y.lo.add(t.lo))
        // degrees 19 down to 16 in double (yl is negligible there)
        h18 : F64 = cm_f64_erfc_e2(27).mul_add(yh, cm_f64_erfc_e2(26))
        h17 : F64 = h18.mul_add(yh, cm_f64_erfc_e2(25))
        h16 : F64 = h17.mul_add(yh, cm_f64_erfc_e2(24))
        // degree 15: h (yh + yl) + E2[23]
        m  : CmF64ErfDd = cm_f64_erf_a_mul(h16, yh)
        tl : F64        = h16.mul_add(yl, m.lo)
        s  : CmF64ErfDd = cm_f64_erf_fast_two_sum(cm_f64_erfc_e2(23), m.hi)
        jump middle(k, yh, yl, 14, s.hi, s.lo.add(tl))

    // degrees 14 down to 8: (h + l) (yh + yl) + E2[i+8]
    block middle(k: S64, yh: F64, yl: F64, i: USize, h: F64, l: F64):
        m    : CmF64ErfDd = cm_f64_erf_a_mul(h, yh)
        tl0  : F64        = h.mul_add(yl, m.lo)
        tl   : F64        = l.mul_add(yh, tl0)
        s    : CmF64ErfDd = cm_f64_erf_fast_two_sum(cm_f64_erfc_e2(i.add(8)), m.hi)
        last : Bool       = i.eq(8)
        branch last
            ? low(k, yh, yl, 8, s.hi, s.lo.add(tl))
            : middle(k, yh, yl, i.sub(1), s.hi, s.lo.add(tl))

    // degrees 7 down to 0 have double-double coefficients E2[2i] + E2[2i+1]
    block low(k: S64, yh: F64, yl: F64, i: USize, h: F64, l: F64):
        done : Bool = i.eq(0)
        branch done
            ? return({ h, l, k })
            : low_step(k, yh, yl, i.sub(1), h, l)

    block low_step(k: S64, yh: F64, yl: F64, i: USize, h: F64, l: F64):
        m   : CmF64ErfDd = cm_f64_erf_a_mul(h, yh)
        tl0 : F64        = h.mul_add(yl, m.lo)
        tl  : F64        = l.mul_add(yh, tl0)
        s   : CmF64ErfDd = cm_f64_erf_fast_two_sum(cm_f64_erfc_e2(i.mul(2)), m.hi)
        cl  : F64        = cm_f64_erfc_e2(i.mul(2).add(1))
        jump low(k, yh, yl, i, s.hi, s.lo.add(tl.add(cl)))

// -- table access --------------------------------------------------------------

/// Entry k of pair i in CM_F64_ERFC_T1.
private routine cm_f64_erfc_t1(i: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_T1.get(i.mul(2).add(k))))

/// Entry k of pair i in CM_F64_ERFC_T2.
private routine cm_f64_erfc_t2(i: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_T2.get(i.mul(2).add(k))))

/// Coefficient k of the row starting at base in CM_F64_ERFC_T.
private routine cm_f64_erfc_t(base: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_T.get(base.add(k))))

/// Coefficient k of the row starting at base in CM_F64_ERFC_TACC.
private routine cm_f64_erfc_tacc(base: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_TACC.get(base.add(k))))

private routine cm_f64_erfc_e2(k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_E2.get(k)))

/// Entry k of triple i in CM_F64_ERFC_ASYMPT_EXC.
private routine cm_f64_erfc_asympt_exc(i: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_ASYMPT_EXC.get(i.mul(3).add(k))))

/// Entry k of triple i in CM_F64_ERFC_NEG_EXC.
private routine cm_f64_erfc_neg_exc(i: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_NEG_EXC.get(i.mul(3).add(k))))

/// Entry k of triple i in CM_F64_ERFC_POS_EXC.
private routine cm_f64_erfc_pos_exc(i: USize, k: USize) -> F64
    block entry():
        return(F64.from_bits(CM_F64_ERFC_POS_EXC.get(i.mul(3).add(k))))
