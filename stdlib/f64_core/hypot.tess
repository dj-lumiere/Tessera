// Tessera stdlib: the correctly rounded Euclidean distance sqrt(x^2 + y^2) of F64
//
// Both legs are scaled so that the larger lies in [1, 2) (a subnormal leg is
// normalized first), x^2 + y^2 is formed as a double-double with FMAs, and
// its square root gets a one-step correction. When the result lies too close
// to a rounding boundary, exact integer arithmetic on the mantissas decides;
// two subnormal legs go through an exact integer square root. Legs more than
// 27 binades apart give x + 2^-27 y. Round to nearest only: no intermediate
// overflow or underflow, overflow of the result gives +inf, an infinite leg
// gives +inf even when the other is a quiet NaN, and otherwise a NaN leg
// gives a quiet NaN.
//
// Ported from CORE-MATH, src/binary64/hypot/hypot.c via RazorForge's B64Hypot.rf.
// Copyright (c) 2022-2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// sqrt(self^2 + other^2) without intermediate overflow.
routine F64.hypot(%self: Self, %other: Self) -> Self
    block entry():
        %xi      : U64  = %self.bits()
        %yi      : U64  = %other.bits()
        %ex      : U64  = %xi.bitand(0x7FF0000000000000)
        %ey      : U64  = %yi.bitand(0x7FF0000000000000)
        %special : Bool = %ex.eq(0x7FF0000000000000).bitor(%ey.eq(0x7FF0000000000000))
        branch %special ? special(%xi, %yi) : order(%self.abs(), %other.abs())

    // x or y is NaN or infinite
    block special(%xi: U64, %yi: U64):
        %wx    : U64  = %xi.shl(1)
        %wy    : U64  = %yi.shl(1)
        %xinf  : Bool = %wx.eq(0xFFE0000000000000)
        %yinf  : Bool = %wy.eq(0xFFE0000000000000)
        %xqnan : Bool = %wx.shr(52).eq(0xFFF)
        %yqnan : Bool = %wy.shr(52).eq(0xFFF)
        // IEEE 754: hypot(±inf, qNaN) = hypot(qNaN, ±inf) = +inf
        %inf : Bool = %xinf.bitxor(%yinf).bitand(%xqnan.bitxor(%yqnan))
        branch %inf
            ? return(Self.INFINITY)
            : return(cm_f64_hypot_nan_add(%self.abs(), %other.abs()))

    // u = max(|x|, |y|), v = min(|x|, |y|)
    block order(%ax: Self, %ay: Self):
        %swap : Bool = %ay.gt(%ax)
        %u    : Self = %swap ? %ay : %ax
        %v    : Self = %swap ? %ax : %ay
        %xd   : U64  = %u.bits()
        %yd   : U64  = %v.bits()
        %ysub : Bool = %yd.shr(52).eq(0)
        branch %ysub ? y_subnormal(%u, %v, %xd, %yd) : scale(%u, %v, %xd, %yd)

    block y_subnormal(%u: Self, %v: Self, %xd: U64, %yd: U64):
        %yzero : Bool = %yd.eq(0)
        %xsub  : Bool = %xd.shr(52).eq(0)
        when:
            %yzero -> return(%u)
            %xsub  -> return(cm_f64_hypot_denorm(%xd, %yd))
            else   -> normalize(%u, %v, %xd, %yd)

    // normalize the subnormal y: its exponent field goes below 0 (modulo 2^64)
    block normalize(%u: Self, %v: Self, %xd: U64, %yd: U64):
        %nz : U64 = %yd.leading_zeros()
        %ey : U64 = %yd.shl(%nz.sub(11)).bitand(0x000FFFFFFFFFFFFF).sub_wrap(%nz.sub(12).shl(52))
        jump scale(%u, %v, %xd, %ey)

    // scale both legs by the power of two that brings u into [1, 2)
    block scale(%u: Self, %v: Self, %xd: U64, %yd: U64):
        %de  : U64  = %xd.sub_wrap(%yd)
        %far : Bool = %de.gt(0x01B0000000000000)
        branch %far ? return(Self.mul_add(0x1p-27, %v, %u)) : continue
        %off   : U64  = U64.sub_wrap(0x3FF0000000000000, %xd.bitand(0x7FF0000000000000))
        %sx    : Self = Self.from_bits(%xd.add_wrap(%off))
        %sy    : Self = Self.from_bits(%yd.add_wrap(%off))
        %x2    : Self = %sx.mul(%sx)
        %dx2   : Self = %sx.mul_add(%sx, %x2.neg())
        %y2    : Self = %sy.mul(%sy)
        %dy2   : Self = %sy.mul_add(%sy, %y2.neg())
        %r2    : Self = %x2.add(%y2)
        %ir2   : Self = Self.div(0.5, %r2)
        %dr2   : Self = %x2.sub(%r2).add(%y2).add(%dx2.add(%dy2))
        %th    : Self = %r2.sqrt()
        %rsqrt : Self = %th.mul(%ir2)
        %dz    : Self = %dr2.sub(%th.mul_add(%th, %r2.neg()))
        %tl    : Self = %rsqrt.mul(%dz)
        %s     : Self = %th.add(%tl)  // fast two-sum of th and tl
        %z     : Self = %s.sub(%th)
        %sl    : Self = %tl.sub(%z)
        %thu   : U64  = %s.bits()
        %aidr  : U64  = %sl.abs().bits().add_wrap(0x3FE0000000000000).sub_wrap(%thu.bitand(0x7FF0000000000000))
        %mid   : U64  = %aidr.sub_wrap(0x3C90000000000000).add_wrap(16).shr(5)
        %midm  : U64  = %aidr.sub_wrap(0x3C80000000000000).add_wrap(16).shr(5)
        %near  : Bool = %mid.eq(0).bitor(%midm.eq(0))
        %odd   : Bool = %aidr.lt(0x39B0000000000000).bitor(%aidr.gt(0x3C9FFFFFFFFFFF80))
        %hard  : Bool = %near.bitor(%odd)
        branch %hard ? unscale(cm_f64_hypot_hard(%sx, %sy).bits(), %off) : unscale(%thu, %off)

    block unscale(%thu: U64, %off: U64):
        %t    : U64  = %thu.sub_wrap(%off)
        %over : Bool = %t.ge(0x7FF0000000000000)  // hypot(x, y) >= 2^1024
        branch %over ? return(Self.INFINITY) : return(Self.from_bits(%t))

/// x + y for non-negative x and y where at least one is NaN or infinite, picking
/// the NaN operand the way x86 SSE addition does (the first NaN, quieted), so
/// the result doesn't depend on how the addition is scheduled.
private routine cm_f64_hypot_nan_add(%x: F64, %y: F64) -> F64
    block entry():
        %xnan : Bool = %x.is_nan()
        %ynan : Bool = %y.is_nan()
        when:
            %xnan -> return(F64.from_bits(%x.bits().bitor(0x0008000000000000)))
            %ynan -> return(F64.from_bits(%y.bits().bitor(0x0008000000000000)))
            else  -> return(%x.add(%y))

/// Both legs subnormal: a and b are their encodings (x = a 2^-1074), with
/// 2^52 > a >= b > 0. The integer square root of a^2 + b^2 is refined exactly
/// and rounded to nearest (a midpoint is impossible here).
private routine cm_f64_hypot_denorm(%a: U64, %b: U64) -> F64
    block entry():
        %af  : F64 = %a.to_f64()
        %bf  : F64 = %b.to_f64()
        %a2  : U64 = %a.shl(1)
        %b2  : U64 = %b.shl(1)
        %rm  : U64 = %af.mul(%af).add(%bf.mul(%bf)).sqrt().to_u64()
        %tmu : U64 = %rm.shl(1)
        // D = a^2 + b^2 - tm^2 (all doubled), exact modulo 2^64 and small in magnitude
        %d : S64 = %a2.mul_wrap(%a2).add_wrap(%b2.mul_wrap(%b2)).sub_wrap(%tmu.mul_wrap(%tmu)).to_s64_wrap()
        jump up(%d, %tmu.to_s64_wrap())

    // tm too small: (tm + 1)^2 = tm^2 + 2 tm + 1
    block up(%d: S64, %tm: S64):
        %small : Bool = %d.gt(%tm.mul(2))
        branch %small ? up(%d.sub(%tm.mul(2).add(1)), %tm.add(1)) : down(%d, %tm)

    // tm too large: (tm - 1)^2 = tm^2 - 2 tm + 1
    block down(%d: S64, %tm: S64):
        %large : Bool = %d.lt(0)
        branch %large ? down(%d.add(%tm.mul(2).sub(1)), %tm.sub(1)) : round(%d, %tm)

    // tm = floor(sqrt(a^2 + b^2)) (doubled) and 0 <= D < 2 tm + 1: round with the low bit of tm
    block round(%d: S64, %tm: S64):
        %tmb     : U64  = %tm.to_u64_wrap()
        %inexact : Bool = %d.ne(0)
        branch %inexact
            ? return(F64.from_bits(%tmb.shr(1).add(%tmb.bitand(1))))
            : return(F64.from_bits(%tmb.shr(1)))

/// Hard-to-round case: the square root is refined with exact integer
/// arithmetic. x in [1, 2) and y <= x are the scaled legs, and x^2 + y^2 is
/// compared with the square of each candidate modulo 2^64 (the differences
/// are small, so the modular results are exact).
private routine cm_f64_hypot_hard(%x: F64, %y: F64) -> F64
    block entry():
        %xu : U64 = %x.bits()
        %yu : U64 = %y.bits()
        %bm : U64 = %xu.bitand(0x000FFFFFFFFFFFFF).bitor(0x0010000000000000)
        %lm : U64 = %yu.bitand(0x000FFFFFFFFFFFFF).bitor(0x0010000000000000)
        %be : S64 = %xu.shr(52).to_s64_wrap()
        %le : S64 = %yu.shr(52).to_s64_wrap()
        %ri : U64 = %x.mul(%x).add(%y.mul(%y)).sqrt().bits()
        %rm : U64 = %ri.bitand(0x000FFFFFFFFFFFFF).bitor(0x0010000000000000)
        %re : S64 = %ri.shr(52).to_s64_wrap().sub(0x3FF)
        %m2 : U64 = cm_f64_hypot_sum_squares(%bm, %lm, %be.sub(%le))
        jump back(0, %rm, %re, %be, %m2)

    // step the candidate three ulps down
    block back(%i: U64, %rm: U64, %re: S64, %be: S64, %m2: U64):
        %done : Bool = %i.eq(3)
        branch %done ? search(%rm, %re, %be, %m2) : continue
        %bottom : Bool = %rm.eq(0x0010000000000000)
        branch %bottom
            ? back(%i.add(1), 0x001FFFFFFFFFFFFF, %re.sub(1), %be, %m2)
            : back(%i.add(1), %rm.sub(1), %re, %be, %m2)

    block search(%rm: U64, %re: S64, %be: S64, %m2: U64):
        %k : U64 = S64.add(2, %re).to_u64_wrap()
        jump step(%rm, %k, %re, %be, %m2)

    // move the candidate up until its square reaches x^2 + y^2
    block step(%rm0: U64, %k: U64, %re: S64, %be: S64, %m2: U64):
        %wide  : Bool = %rm0.ge(0x0020000000000000)
        %rm    : U64  = %wide ? %rm0.add(2) : %rm0.add(1)
        %tm    : U64  = %rm.shl(%k)
        %d     : S64  = %m2.sub_wrap(%tm.mul_wrap(%tm)).to_s64_wrap()
        %above : Bool = %d.le(0)
        branch %above ? found(%rm, %k, %re, %be, %m2, %d) : step(%rm, %k, %re, %be, %m2)

    block found(%rm: U64, %k: U64, %re: S64, %be: S64, %m2: U64, %d: S64):
        %exact : Bool = %d.eq(0)
        branch %exact ? finish(%rm, %re, %be) : continue
        // compare with the midpoint below the candidate
        %narrow : Bool = %rm.le(0x0020000000000000)
        %sh     : U64  = %narrow ? %k.sub(1) : %k
        %tm     : U64  = %rm.shl(%k).sub_wrap(U64.shl(1, %sh))
        %dm     : S64  = %m2.sub_wrap(%tm.mul_wrap(%tm)).to_s64_wrap()
        %tie    : Bool = %dm.eq(0)
        %below  : Bool = %dm.lt(0)
        %bit    : U64  = %narrow ? 1 : 2
        when:
            %tie   -> finish(%rm.sub(%rm.bitand(%bit)), %re, %be)  // round to even
            %below -> finish(%rm.sub(1), %re, %be)
            else   -> finish(%rm, %re, %be)

    block finish(%rm: U64, %re: S64, %be: S64):
        %wide : Bool = %rm.ge(0x0020000000000000)
        %m    : U64  = %wide ? %rm.shr(1) : %rm
        %r    : S64  = %wide ? %re.add(1) : %re
        %e    : S64  = %be.sub(1).add(%r)
        return(F64.from_bits(%e.to_u64_wrap().shl(52).add_wrap(%m)))

/// (4 bm)^2 + (lm 2^(2 - de))^2 modulo 2^64, for the hard case of hypot: bm
/// and lm are the full mantissas of the larger and smaller leg, de >= 0 the
/// difference of their exponents. Bits shifted out of lm^2 are kept sticky.
private routine cm_f64_hypot_sum_squares(%bm: U64, %lm: U64, %de: S64) -> U64
    block entry():
        %b4  : U64  = %bm.shl(2)
        %m2  : U64  = %b4.mul_wrap(%b4)
        %ls  : S64  = S64.sub(2, %de)
        %big : Bool = %ls.ge(0)
        branch %big ? shifted(%m2, %ls) : wide(%m2, %ls)

    block shifted(%m2: U64, %ls: S64):
        %l : U64 = %lm.shl(%ls.to_u64_wrap())
        return(%m2.add_wrap(%l.mul_wrap(%l)))

    block wide(%m2: U64, %ls: S64):
        %l      : U128 = %lm.to_u128()
        %l2     : U128 = %l.mul_wrap(%l)
        %ls2    : S64  = %ls.mul(2)
        %sum    : U64  = %m2.add_wrap(%l2.shr(%ls2.neg().to_u128_wrap()).to_u64_wrap())
        %sticky : Bool = %l2.shl(S64.add(128, %ls2).to_u128_wrap()).ne(0)
        branch %sticky ? return(%sum.bitor(1)) : return(%sum)
