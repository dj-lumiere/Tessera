// Tessera stdlib: the correctly rounded inverse hyperbolic tangent of F64
//
// For |x| < 1/4 an odd polynomial, redone in double-double when its error bound can't decide the rounding.
// Otherwise atanh |x| = log((1 + |x|) / (1 - |x|)) / 2, with the quotient as a double-double and the logarithm
// from the tables of archyp_shared.tess (halved: this file keeps its own -log(r) / 2 tables), checked with an
// error bound; the accurate path computes the logarithm to about 150 bits and looks the two hardest arguments
// up in a table of exact values.
// Round to nearest only: ±1 give ±inf, |x| > 1 gives the default NaN (C's sqrt(-1.0) on x86), ±0 and NaN map
// to themselves (NaN quiet), atanh(-x) = -atanh(x).
//
// Ported from CORE-MATH, src/binary64/atanh/atanh.c via RazorForge's B64Atanh.rf.
// Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Low parts of -log(r1[i]) / 2 as a double-double, as F64 bits.
preset CM_F64_ATANH_L1_LO: @Array<U64, 33> <- { 0x0000000000000000, 0xBE4532C1269E2038,
    0x3E4CE42D81B54E84, 0xBE525826F815EC3D, 0x3E50DB1B1E7CEE11, 0xBE51F3A8C6C95003,
    0xBE5774CD4FB8C30D, 0x3E2452E56C030A0A, 0x3E36B63C4966A79A, 0xBE3B20A21CCB525E,
    0x3E54006CFB3D8F85, 0xBE5CDB026B310C41, 0xBE569124FDC0F16D, 0xBE5084656CDC2727,
    0xBE5376FA8B0357FD, 0x3E3E56AE55A47B4A, 0x3E5070FF8834EEB4, 0x3E5623516109F4FE,
    0xBE2EC656B95FBDAC, 0x3E3F0CA2E729F510, 0xBE57D260A858354A, 0x3E4E7279075503D3,
    0x3E439E1A0A503873, 0x3E5CD86D7B87C3D6, 0x3E5060AB88DE341E, 0x3E320A860D3F9390,
    0xBE4DACEE95FC2F10, 0x3E545DE3A86E0ACA, 0x3E4C164CBFB991AF, 0x3E5D3F66B24225EF,
    0x3E5FC023EFA144BA, 0x3E3086A8AF6F26C0, 0xBE105C610CA86C39 }

/// High parts of -log(r1[i]) / 2, as F64 bits.
preset CM_F64_ATANH_L1_HI: @Array<U64, 33> <- { 0x0000000000000000, 0x3F862E5000000000,
    0x3F962E3C00000000, 0x3FA0A2AC00000000, 0x3FA62E4A00000000, 0x3FABB9DC00000000,
    0x3FB0A2B200000000, 0x3FB3687F00000000, 0x3FB62E4100000000, 0x3FB8F40A00000000,
    0x3FBBB9D100000000, 0x3FBE7F9B00000000, 0x3FC0A2B080000000, 0x3FC2059580000000,
    0x3FC3687C00000000, 0x3FC4CB5E80000000, 0x3FC62E4400000000, 0x3FC7912900000000,
    0x3FC8F40B00000000, 0x3FCA56ED80000000, 0x3FCBB9D680000000, 0x3FCD1CB900000000,
    0x3FCE7F9D00000000, 0x3FCFE27D80000000, 0x3FD0A2B240000000, 0x3FD1542440000000,
    0x3FD2059740000000, 0x3FD2B70700000000, 0x3FD3687B00000000, 0x3FD419EC40000000,
    0x3FD4CB5F80000000, 0x3FD57CD280000000, 0x3FD62E4300000000 }

/// Low parts of -log(r2[j]) / 2 as a double-double, as F64 bits.
preset CM_F64_ATANH_L2_LO: @Array<U64, 33> <- { 0x0000000000000000, 0xBE337E152A129E4E,
    0xBE53F6C916B8BE9C, 0x3E520505936739D5, 0xBE523E2E8CB541BA, 0xBDFACB7983AC4F5E,
    0x3E36F7C7689C63AE, 0x3E1F5CA695B4C58B, 0xBE4C6C18BD953226, 0x3E57A516C34846BD,
    0xBE4F3B83DD8B8530, 0xBE0C3459046E4E57, 0x3D9B5C7E34CB79F6, 0xBE42487E9AF9A692,
    0x3E5F21BBC4AD79CE, 0xBE2550FFC857B731, 0x3E487458EC1B7B34, 0x3E5103D4FE83EE81,
    0x3E4810483D3B398C, 0xBE42085CB340608E, 0x3E512698A119C42F, 0xBE5EDB8C172B4C33,
    0xBE58B55B87A5E238, 0x3E5BE5E17763F78A, 0xBE1C2D496790073E, 0x3E56542F523ABEEC,
    0xBE5B7FDBE5B193F8, 0x3E5FA4D42FE30C7C, 0x3E50D46AD04ADC86, 0xBE51C22D02D17C4C,
    0x3E1A7D1E330DCCCE, 0x3E0187025E656BA3, 0xBE4532C1269E2038 }

/// High parts of -log(r2[j]) / 2, as F64 bits.
preset CM_F64_ATANH_L2_HI: @Array<U64, 33> <- { 0x0000000000000000, 0x3F36320000000000,
    0x3F46300000000000, 0x3F50A24000000000, 0x3F562DC000000000, 0x3F5BBA0000000000,
    0x3F60A2A000000000, 0x3F6368C000000000, 0x3F662E6000000000, 0x3F68F46000000000,
    0x3F6BBA0000000000, 0x3F6E800000000000, 0x3F70A2C000000000, 0x3F7205C000000000,
    0x3F73687000000000, 0x3F74CB7000000000, 0x3F762E2000000000, 0x3F77911000000000,
    0x3F78F44000000000, 0x3F7A573000000000, 0x3F7BB9D000000000, 0x3F7D1CC000000000,
    0x3F7E7FE000000000, 0x3F7FE2B000000000, 0x3F80A2A800000000, 0x3F81541000000000,
    0x3F8205A000000000, 0x3F82B70000000000, 0x3F83688800000000, 0x3F8419F000000000,
    0x3F84CB7000000000, 0x3F857CD000000000, 0x3F862E5000000000 }

/// Hard-to-round arguments |x| (sorted), as F64 bits.
preset CM_F64_ATANH_DB_X: @Array<U64, 2> <- { 0x3FD2DBB7B1C91363, 0x3FDC493DC899E4A5 }

/// The high parts of atanh |x| for those arguments, as F64 bits.
preset CM_F64_ATANH_DB_H: @Array<U64, 2> <- { 0x3FD36F33D51C264D, 0x3FDE611AA58AB608 }

/// The low parts, as F64 bits.
preset CM_F64_ATANH_DB_L: @Array<U64, 2> <- { 0x3C70000000000000, 0xBC70000000000000 }

/// atanh self, correctly rounded.
routine F64.atanh(self: Self) -> Self
    block entry():
        ax      : Self = self.abs()
        aix     : U64  = ax.bits()
        outside : Bool = aix.ge(0x3FF0000000000000)  // |x| >= 1
        small   : Bool = aix.lt(0x3FD0000000000000)  // |x| < 1/4
        when:
            outside -> outside(aix)
            small   -> small(aix)
            else    -> return(cm_f64_atanh_main(self))

    block outside(aix: U64):
        pole : Bool = aix.eq(0x3FF0000000000000)
        nan  : Bool = aix.gt(0x7FF0000000000000)
        when:
            pole -> return(Self.INFINITY.copysign(self))
            nan  -> return(self.add(self))
            else -> return(Self.from_bits(0xFFF8000000000000))

    block small(aix: U64):
        tiny : Bool = aix.lt(0x3E4D12ED0AF1A27F)  // |x| < 0x1.d12ed0af1a27fp-27: atanh x rounds to x
        branch tiny
            ? return(self.mul_add(0x1p-55, self))
            : continue
        // x + (0x1.5555555555555p-2 + 0x1.5555555555555p-56) x^3 + x^5 p(x^2) approximates atanh x with relative
        // error <= 2^-64.377 on [0x1.d12ed0af1a27fp-27, 1/4]
        x2   : Self       = self.mul(self)
        dx2  : Self       = self.mul_add(self, x2.neg())
        x4   : Self       = x2.mul(x2)
        x3   : Self       = x2.mul(self)
        x8   : Self       = x4.mul(x4)
        dx3  : Self       = x2.mul_add(self, x3.neg()).add(dx2.mul(self))
        c5   : Self       = x2.mul(0x1.2492492492244p-3).add(0x1.999999999999ap-3)
        c9   : Self       = x2.mul(0x1.745d16f777723p-4).add(0x1.c71c71c79715fp-4)
        c13  : Self       = x2.mul(0x1.110c9724989bdp-4).add(0x1.3b13ca4174634p-4)
        c17  : Self       = x2.mul(0x1.a0b56308cba0bp-5).add(0x1.e2d17608a5b2ep-5)
        lo   : Self       = x4.mul(c9).add(c5)
        hi0  : Self       = x4.mul(c17).add(c13)
        hi   : Self       = hi0.add(x8.mul(0x1.fb6341208ad2ep-5))
        p    : Self       = lo.add(x8.mul(hi))
        t    : Self       = x2.mul_add(p, 0x1.5555555555555p-56)
        c    : CmF64HypDd = cm_f64_hyp_fasttwosum(0x1.5555555555555p-2, t)
        c3   : CmF64HypDd = cm_f64_atanh_muldd(c.hi, c.lo, x3, dx3)
        s    : CmF64HypDd = cm_f64_hyp_fasttwosum(self, c3.hi)
        pl   : Self       = c3.lo.add(s.lo)
        eps  : Self       = self.mul(x4.mul(0x1.dp-53).add(0x1p-103))
        lb   : Self       = s.hi.add(pl.sub(eps))
        ub   : Self       = s.hi.add(pl.add(eps))
        sure : Bool       = lb.eq(ub)
        branch sure
            ? return(lb)
            : return(cm_f64_atanh_zero(self))

/// atanh x for 1/4 <= |x| < 1: log((1 + |x|) / (1 - |x|)) / 2.
private routine cm_f64_atanh_main(x: F64) -> F64
    block entry():
        ax : F64 = x.abs()
        // th + tl = (ph + pl) / (qh + ql) = (1 + |x|) / (1 - |x|)
        p    : CmF64HypDd = cm_f64_hyp_fasttwosum(1.0, ax)
        q    : CmF64HypDd = cm_f64_atanh_fasttwosub(1.0, ax)
        iqh  : F64        = F64.div(1.0, q.hi)
        th   : F64        = p.hi.mul(iqh)
        rem  : F64        = q.hi.neg().mul_add(iqh, 1.0)
        corr : F64        = rem.sub(q.lo.mul(iqh))
        tl   : F64        = p.hi.mul_add(iqh, th.neg()).add(p.lo.add(p.hi.mul(corr)).mul(iqh))
        tb   : U64        = th.bits()
        eb   : S64        = tb.shr(52).to<S64>()
        e    : S64        = eb.sub(0x3FF)
        tm   : U64        = tb.bitand(0x000FFFFFFFFFFFFF)
        ed   : F64        = e.to<F64>()
        j    : U64        = cm_f64_archyp_index(tm)
        tf   : F64        = F64.from_bits(tm.bitor(0x3FF0000000000000))
        i1   : USize      = j.shr(5).to<USize>()
        i2   : USize      = j.bitand(0x1F).to<USize>()
        r1   : F64        = F64.from_bits(CM_F64_ARCHYP_R1.get(i1))
        r    : F64        = F64.mul(0.5, r1).mul(F64.from_bits(CM_F64_ARCHYP_R2.get(i2)))
        dx   : F64        = r.mul_add(tf, -0.5)
        dx2  : F64        = dx.mul(dx)
        rx   : F64        = r.mul(tf)
        dxl  : F64        = r.mul_add(tf, rx.neg())
        f    : F64        = dx2.mul(cm_f64_atanh_log_poly(dx, dx2))
        // log(2) / 2 as l2h + l2l
        l1h  : F64        = F64.from_bits(CM_F64_ATANH_L1_HI.get(i1))
        l2h  : F64        = F64.from_bits(CM_F64_ATANH_L2_HI.get(i2))
        l1l  : F64        = F64.from_bits(CM_F64_ATANH_L1_LO.get(i1))
        l2l  : F64        = F64.from_bits(CM_F64_ATANH_L2_LO.get(i2))
        lh0  : F64        = l1h.add(l2h).add(F64.mul(0x1.62e42fefa3ap-2, ed))
        ls   : CmF64HypDd = cm_f64_hyp_fasttwosum(lh0, rx.sub(0.5))
        lt0  : F64        = F64.mul(-0x1.0ca86c3898dp-50, ed).add(l1l.add(l2l))
        lt   : F64        = lt0.add(dxl)
        ll0  : F64        = ls.lo.add(lt.add(F64.mul(0.5, tl).div(th)))
        ll1  : F64        = ll0.add(f)
        sgn  : F64        = F64.copysign(1.0, x)
        lh   : F64        = ls.hi.mul(sgn)
        ll   : F64        = ll1.mul(sgn)
        eps  : F64        = dx2.mul(0x1p-49).add(0x1.6f83716782967p-75)  // 38e-24 in the original
        lb   : F64        = lh.add(ll.sub(eps))
        ub   : F64        = lh.add(ll.add(eps))
        sure : Bool       = lb.eq(ub)
        branch sure
            ? return(lb)
            : accurate(th, tl, lh.add(ll))

    block accurate(th: F64, tl: F64, l: F64):
        z : CmF64HypDd = cm_f64_hyp_fasttwosum(th, tl)
        return(cm_f64_atanh_refine(x, z.hi, z.lo, F64.mul(0x1.71547652b82fep+1, l.abs())))

/// The fast-path polynomial of log(1 + 2dx) / 2 - dx, divided by dx^2.
private routine cm_f64_atanh_log_poly(dx: F64, dx2: F64) -> F64
    block entry():
        a : F64 = dx.mul(0x1.555555555553p+0).add(-0x1p+0)
        b : F64 = dx.mul(0x1.99999e33a6366p+1).add(-0x1.fffffffffffap+0)
        c : F64 = dx2.mul(-0x1.555559ef9525fp+2).add(b)
        return(dx2.mul(c).add(a))

/// x - y as hi + lo exactly, when |x| >= |y|.
private routine cm_f64_atanh_fasttwosub(x: F64, y: F64) -> CmF64HypDd
    block entry():
        s : F64 = x.sub(y)
        z : F64 = x.sub(s)
        e : F64 = z.sub(y)
        return(CmF64HypDd { hi: s, lo: e })

/// The double-double sum (xh + xl) + (ch + cl), the high parts with an exact two-sum.
private routine cm_f64_atanh_adddd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64HypDd
    block entry():
        s   : F64 = xh.add(ch)
        d   : F64 = s.sub(xh)
        err : F64 = ch.sub(d).add(xh.add(d.sub(s)))
        l   : F64 = err.add(xl.add(cl))
        return(CmF64HypDd { hi: s, lo: l })

/// The double-double product (xh + xl) (ch + cl), renormalized.
private routine cm_f64_atanh_muldd_acc(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64HypDd
    block entry():
        ahlh : F64 = ch.mul(xl)
        alhh : F64 = cl.mul(xh)
        ahhh : F64 = ch.mul(xh)
        ahhl : F64 = ch.mul_add(xh, ahhh.neg()).add(alhh.add(ahlh))
        return(cm_f64_hyp_fasttwosum(ahhh, ahhl))

/// The double-double product (xh + xl) (ch + cl), not renormalized.
private routine cm_f64_atanh_muldd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64HypDd
    block entry():
        ahlh : F64 = ch.mul(xl)
        alhh : F64 = cl.mul(xh)
        ahhh : F64 = ch.mul(xh)
        l    : F64 = ch.mul_add(xh, ahhh.neg()).add(alhh.add(ahlh))
        return(CmF64HypDd { hi: ahhh, lo: l })

/// One Horner step of a double-double polynomial: (ch + cl) (xh + xl) + (c_hi + c_lo).
private routine cm_f64_atanh_polydd_step(xh: F64, xl: F64, ch: F64, cl: F64, c_hi: F64,
    c_lo: F64) -> CmF64HypDd
    block entry():
        p : CmF64HypDd = cm_f64_atanh_muldd_acc(xh, xl, ch, cl)
        s : CmF64HypDd = cm_f64_hyp_fasttwosum(c_hi, p.hi)
        l : F64        = p.lo.add(s.lo.add(c_lo))
        return(CmF64HypDd { hi: s.hi, lo: l })

/// The accurate path of atanh for 0x1.d12ed0af1a27fp-27 <= |x| < 1/4: a double-double odd polynomial.
private routine cm_f64_atanh_zero(x: F64) -> F64
    block entry():
        x2  : F64        = x.mul(x)
        x2l : F64        = x.mul_add(x, x2.neg())
        c0  : F64        = x2.mul(0x1.99ea5700d53a5p-5).add(0x1.5aca6d6d720d6p-6)
        c1  : F64        = x2.mul(c0).add(0x1.037bed4d7588fp-5)
        c2  : F64        = x2.mul(c1).add(0x1.06dfbb35e7f44p-5)
        y2  : F64        = x2.mul(x2.mul(c2).add(0x1.1a9a91fd692afp-5))
        p27 : CmF64HypDd = cm_f64_hyp_polydd_init(y2, 0x1.2f664d60473f9p-5, 0x1.3adb3e2b7f35ep-61)
        p25 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p27.hi, p27.lo, 0x1.47ae2d205013cp-5,
            -0x1.0c9617e7bcff2p-60)
        p23 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p25.hi, p25.lo, 0x1.642c84aa383ebp-5,
            0x1.632e747641b12p-59)
        p21 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p23.hi, p23.lo, 0x1.8618618c779b6p-5,
            -0x1.ab913de95c3bfp-61)
        p19 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p21.hi, p21.lo, 0x1.af286bc9f90ccp-5,
            0x1.1e51a6e54fde9p-60)
        p17 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p19.hi, p19.lo, 0x1.e1e1e1e1e2678p-5,
            -0x1.f86ea96fb1435p-59)
        p15 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p17.hi, p17.lo, 0x1.1111111111105p-4,
            0x1.4e1afd723ed1fp-59)
        p13 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p15.hi, p15.lo, 0x1.3b13b13b13b14p-4,
            -0x1.b893c3b36052ep-59)
        p11 : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p13.hi, p13.lo, 0x1.745d1745d1746p-4,
            -0x1.7556c4165f4cap-59)
        p9  : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p11.hi, p11.lo, 0x1.c71c71c71c71cp-4,
            0x1.c71cd5c38a112p-58)
        p7  : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p9.hi, p9.lo, 0x1.2492492492492p-3,
            0x1.2492490f76b25p-57)
        p5  : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p7.hi, p7.lo, 0x1.999999999999ap-3,
            -0x1.999999999611cp-57)
        p3  : CmF64HypDd = cm_f64_atanh_polydd_step(x2, x2l, p5.hi, p5.lo, 0x1.5555555555555p-2,
            0x1.5555555555555p-56)
        px  : CmF64HypDd = cm_f64_hyp_mulddd(p3.hi, p3.lo, x)
        p   : CmF64HypDd = cm_f64_atanh_muldd_acc(x2, x2l, px.hi, px.lo)
        s0  : CmF64HypDd = cm_f64_hyp_fasttwosum(x, p.hi)
        s1  : CmF64HypDd = cm_f64_hyp_fasttwosum(s0.lo, p.lo)
        return(s0.hi.add(cm_f64_hyp_nudge(s1.hi, s1.lo)))

/// The accurate path of atanh: log(zh + zl) / 2 to about 150 bits, where zh + zl is (1 + |x|) / (1 - |x|) and
/// a approximates log2(zh + zl).
private routine cm_f64_atanh_refine(x: F64, zh: F64, zl: F64, a: F64) -> F64
    block entry():
        tb  : U64   = zh.bits()
        eb  : S64   = tb.shr(52).to<S64>()
        e   : S64   = eb.sub(0x3FF)
        m   : F64   = F64.from_bits(tb.bitand(0x000FFFFFFFFFFFFF).bitor(0x3FF0000000000000))
        ed  : F64   = e.to<F64>()
        fr  : F64   = a.sub(ed).add(0x1.00008p+0)
        fm  : U64   = fr.bits().sub_wrap(0x3FF0000000000000)
        i   : U64   = fm.shr(36)
        i1  : USize = i.shr(12).to<USize>()
        i2u : U64   = i.shr(8).bitand(0xF)
        i2  : USize = i2u.to<USize>()
        i3u : U64   = i.shr(4).bitand(0xF)
        i3  : USize = i3u.to<USize>()
        i4  : USize = i.bitand(0xF).to<USize>()
        // log(2) / 2 as a triple-double
        el2  : F64           = F64.mul(0x1.f97b57a079ap-104, ed)
        el1  : F64           = F64.mul(-0x1.0ca86c3898dp-50, ed)
        el0  : F64           = F64.mul(0x1.62e42fefa3ap-2, ed)
        big  : CmF64ArchypTd = cm_f64_archyp_log_table(i1, i2, i3, i4)
        big0 : F64           = big.hi.add(el0)
        rt   : CmF64HypDd    = cm_f64_archyp_rt(i1, i2, i3, i4)
        dh   : F64           = rt.hi.mul(m)
        dl   : F64           = rt.hi.mul_add(m, dh.neg())
        sh   : F64           = rt.lo.mul(m)
        sl   : F64           = rt.lo.mul_add(m, sh.neg())
        q    : CmF64HypDd    = cm_f64_hyp_fasttwosum(dh.sub(1.0), dl)
        // zl / 2^e, scaled like m = zh / 2^e
        zs   : F64        = F64.from_bits(zl.bits().sub_wrap(e.to_wrap<U64>().shl(52)))
        xs   : CmF64HypDd = cm_f64_atanh_adddd(q.hi, q.lo.add(rt.hi.mul(zs)), sh, sl)
        xh   : F64        = xs.hi
        c    : F64        = xh.mul(-0x1.55555555c3157p-4).add(0x1.9999999a0754fp-4)
        tail : F64        = xh.mul(xh.mul(c).add(-0x1p-3))
        p3   : CmF64HypDd = cm_f64_hyp_polydd_init(tail, 0x1.5555555555555p-3,
            0x1.55540c15cf91fp-57)
        p2   : CmF64HypDd = cm_f64_atanh_polydd_step(xh, xs.lo, p3.hi, p3.lo, -0x1p-2,
            -0x1.932ce43199a8dp-110)
        p1   : CmF64HypDd = cm_f64_atanh_polydd_step(xh, xs.lo, p2.hi, p2.lo, 0x1p-1,
            0x1.24b67ee516e3bp-111)
        p0   : CmF64HypDd = cm_f64_atanh_muldd_acc(xh, xs.lo, p1.hi, p1.lo)
        pe   : CmF64HypDd = cm_f64_atanh_adddd(p0.hi, p0.lo, el1, el2)
        s    : CmF64HypDd = cm_f64_atanh_adddd(pe.hi, pe.lo, big.mid, big.lo)
        w0   : CmF64HypDd = cm_f64_hyp_fasttwosum(big0, s.hi)
        w1   : CmF64HypDd = cm_f64_hyp_fasttwosum(w0.lo, s.lo)
        // a power-of-two v1 has the sign of the rest: add one ulp of v1 in the direction of its sign
        tu0  : U64  = w1.hi.bits()
        pow2 : Bool = tu0.bitand(0x000FFFFFFFFFFFFF).eq(0)
        tu   : U64  = pow2
            ? tu0.add_wrap(1)
            : tu0
        er     : U64  = tu.add_wrap(1).bitand(0x000FFFFFFFFFFFFF)
        w0_top : U64  = w0.hi.bits().shr(52)
        de     : U64  = w0_top.bitand(0x7FF).sub_wrap(tu.shr(52).bitand(0x7FF))
        sgn    : F64  = F64.copysign(1.0, x)
        res    : F64  = w0.hi.mul(sgn).add(F64.from_bits(tu).mul(sgn))
        hard   : Bool = de.gt(104).bitor(er.lt(3))
        branch hard
            ? return(cm_f64_atanh_database(x, res))
            : return(res)

/// The exact atanh x for the arguments the fast and accurate paths can't round, or f for any other x.
private routine cm_f64_atanh_database(x: F64, f: F64) -> F64
    block entry():
        jump search(0, 1)

    block search(a: S64, b: S64):
        open : Bool = a.le(b)
        branch open
            ? probe(a, b)
            : return(f)

    block probe(a: S64, b: S64):
        m     : S64   = a.add(b).div(2)
        mu    : USize = m.to<USize>()
        key   : F64   = F64.from_bits(CM_F64_ATANH_DB_X.get(mu))
        ax    : F64   = x.abs()
        below : Bool  = key.lt(ax)
        found : Bool  = key.eq(ax)
        when:
            below -> search(m.add(1), b)
            found -> hit(mu)
            else  -> search(a, m.sub(1))

    block hit(mu: USize):
        sgn : F64 = F64.copysign(1.0, x)
        h   : F64 = F64.from_bits(CM_F64_ATANH_DB_H.get(mu))
        l   : F64 = F64.from_bits(CM_F64_ATANH_DB_L.get(mu))
        return(sgn.mul(h).add(sgn.mul(l)))
