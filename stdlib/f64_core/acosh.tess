// Tessera stdlib: the correctly rounded inverse hyperbolic cosine of F64
//
// Near 1, acosh(1 + z) = sqrt(2z) (1 + z P(z)). Elsewhere acosh x = log(x + sqrt(x^2 - 1)), with the argument
// as a double-double below 111.75 and as log(2x) plus a short correction series in 1/x^2 above, and the
// logarithm from the tables of archyp_shared.tess, checked with an error bound; the accurate path computes the
// logarithm to about 150 bits and looks the few hardest arguments up in a table of exact values.
// Round to nearest only: acosh(1) = +0, +inf maps to +inf, NaN comes back quiet, and x < 1 (-inf included)
// gives the default NaN (C's 0.0 / 0.0 on x86).
//
// Ported from CORE-MATH, src/binary64/acosh/acosh.c via RazorForge's B64Acosh.rf.
// Copyright (c) 2023 Alexei Sibidanov.
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Hard-to-round arguments x (sorted), as F64 bits.
preset CM_F64_ACOSH_DB_X: @Array<U64, 7> <- { 0x3FF5BFF041B260FE, 0x3FF9EFDCA62B700A,
        0x3FFA5BF3ACFDE4B2, 0x40645EA160DDC71F, 0x4092A686E4B567CE, 0x40ECB62EEC26BD78,
        0x40F3BF8009648DC0 }

/// The high parts of acosh x for those arguments, as F64 bits.
preset CM_F64_ACOSH_DB_H: @Array<U64, 7> <- { 0x3FEA6031CD5F93BA, 0x3FF104B648F113A1,
        0x3FF1585720F35CD9, 0x401725811DCF6782, 0x401F1C928E7F1E65, 0x402759A2AD4C4D56,
        0x4027FCE95EA5C653 }

/// The low parts, as F64 bits.
preset CM_F64_ACOSH_DB_L: @Array<U64, 7> <- { 0x3C80000000000000, 0x3C90000000000000,
        0xBC90000000000000, 0x3CB0000000000000, 0x3CB0000000000000, 0x3CC0000000000000,
        0xBCA0000000000000 }

/// acosh self, correctly rounded.
routine F64.acosh(%self: Self) -> Self
    block entry():
        %ix       : U64  = %self.bits()
        %special  : Bool = %ix.ge(0x7FF0000000000000)  // x < 0, NaN or +inf
        %upto_one : Bool = %ix.le(0x3FF0000000000000)  // 0 <= x <= 1
        %near_one : Bool = %ix.lt(0x3FF1E83E425AEE63)  // x < 0x1.1e83e425aee63p+0
        %moderate : Bool = %ix.lt(0x405BF00000000000)  // x < 111.75
        %below738 : Bool = %ix.lt(0x4087100000000000)
        %below2e4 : Bool = %ix.lt(0x40E0100000000000)  // x < 32896
        %below2e9 : Bool = %ix.lt(0x41EA000000000000)  // x < 0x1.ap+31
        when:
            %special  -> special(%ix)
            %upto_one -> upto_one(%ix)
            %near_one -> near_one()
            %moderate -> moderate()
            %below738 -> series3()
            %below2e4 -> series2()
            %below2e9 -> series1()
            else      -> log_fast(%ix, 0x3FE, 0.0, 0x1.b2p-63)

    block special(%ix: U64):
        %quiet : Bool = %ix.eq(0x7FF0000000000000).bitor(%ix.shl(1).gt(0xFFE0000000000000))  // +inf or NaN
        branch %quiet
            ? return(%self.add(%self))
            : return(Self.from_bits(0xFFF8000000000000))

    block upto_one(%ix: U64):
        %one : Bool = %ix.eq(0x3FF0000000000000)
        branch %one
            ? return(0.0)
            : return(Self.from_bits(0xFFF8000000000000))

    // 1 < x < 0x1.1e83e425aee63p+0: acosh(1 + z) = sqrt(2z) (1 + z P(z)), with sqrt(2z) = sh + sl
    block near_one():
        %z    : Self = %self.sub(1.0)
        %iz   : Self = Self.div(-0.25, %z)
        %zt   : Self = Self.mul(2.0, %z)
        %sh   : Self = %zt.sqrt()
        %sl   : Self = %sh.mul_add(%sh, %zt.neg()).mul(%sh.mul(%iz))
        %z2   : Self = %z.mul(%z)
        %z4   : Self = %z2.mul(%z2)
        %c2   : Self = %z.mul(-0x1.6db6db6d5534cp-8).add(0x1.3333333332f95p-6)
        %c4   : Self = %z.mul(-0x1.6e8b8e3e40d58p-11).add(0x1.f1c71c1e04356p-10)
        %c6   : Self = %z.mul(-0x1.c9045534e6d9ep-14).add(0x1.1c4ba825ac4fep-12)
        %c8   : Self = %z.mul(-0x1.f1f4f8cc65342p-17).add(0x1.71fedae26a76bp-15)
        %c24  : Self = %z2.mul(%c4).add(%c2)
        %c68  : Self = %z2.mul(%c8).add(%c6)
        %poly : Self = %z.mul(%z4.mul(%c68).add(%c24)).add(-0x1.5555555555555p-4)
        %ds   : Self = %sh.mul(%z).mul_add(%poly, %sl)
        %eps  : Self = %ds.mul(0x1.00p-50).sub(Self.mul(0x1p-104, %sh))
        %lb   : Self = %sh.add(%ds.sub(%eps))
        %ub   : Self = %sh.add(%ds.add(%eps))
        %sure : Bool = %lb.eq(%ub)
        branch %sure
            ? return(%lb)
            : return(cm_f64_acosh_one(%z, %sh, %sl))

    // x < 111.75: th + tl = x + sqrt(x^2 - 1), and log(th + tl) = log(th) + tl/th
    block moderate():
        %x2h : Self       = %self.mul(%self)
        %wh  : Self       = %x2h.sub(1.0)
        %wl  : Self       = %self.mul_add(%self, %x2h.neg())
        %sh  : Self       = %wh.sqrt()
        %ish : Self       = Self.div(0.5, %wh)
        %sl  : Self       = %wl.sub(%sh.mul_add(%sh, %wh.neg())).mul(%sh.mul(%ish))
        %s   : CmF64HypDd = cm_f64_hyp_fasttwosum(%self, %sh)
        %tl  : Self       = %s.lo.add(%sl)
        jump log_fast(%s.hi.bits(), 0x3FF, %tl.div(%s.hi), 0x1.81p-63)

    // 111.75 <= x < 738: log(x + sqrt(x^2 - 1)) = log(2x) + g with g a series in z = 1/x^2
    block series3():
        %z  : Self = Self.div(1.0, %self.mul(%self))
        %c0 : Self = %z.mul(-0x1.aab6691f2bae7p-5).add(-0x1.7fffffebf3e6cp-4)
        %c1 : Self = %z.mul(%c0).add(-0x1.000000000005cp-2)
        jump log_fast(%self.bits(), 0x3FE, %z.mul(%c1).add(0x1.5c4b6148816e2p-66), 0x1.c3p-63)

    // 738 <= x < 32896
    block series2():
        %z  : Self = Self.div(1.0, %self.mul(%self))
        %c0 : Self = %z.mul(-0x1.8000268641bfep-4).add(-0x1.ffffffffff214p-3)
        jump log_fast(%self.bits(), 0x3FE, %z.mul(%c0).add(-0x1.7f77c8429c6c6p-67), 0x1.9ap-63)

    // 32896 <= x < 0x1.ap+31
    block series1():
        %z : Self = Self.div(1.0, %self.mul(%self))
        jump log_fast(%self.bits(), 0x3FE, %z.mul(-0x1.000000017d048p-2).add(0x1.7a0ed2effdd1p-67),
                0x1.99p-63)

    // log(2^(e - off) m) + g for the bits t of 2^e m, from the tables
    block log_fast(%t: U64, %off: S64, %g: Self, %eps: Self):
        %e   : S64   = %t.shr(52).to<S64>().sub(%off)
        %tm  : U64   = %t.bitand(0x000FFFFFFFFFFFFF)
        %ed  : Self  = %e.to<F64>()
        %j   : U64   = cm_f64_archyp_index(%tm)
        %m   : Self  = Self.from_bits(%tm.bitor(0x3FF0000000000000))
        %i1  : USize = %j.shr(5).to<USize>()
        %i2  : USize = %j.bitand(0x1F).to<USize>()
        %r   : Self  = Self.from_bits(CM_F64_ARCHYP_R1.get(%i1)).mul(Self.from_bits(CM_F64_ARCHYP_R2.get(%i2)))
        %dx  : Self  = %r.mul_add(%m, -1.0)
        %dx2 : Self  = %dx.mul(%dx)
        %f   : Self  = %dx2.mul(cm_f64_archyp_log_poly(%dx, %dx2))
        // log(2) as l2h + l2l with l2h on 42 bits, so l2h ed is exact
        %l1h  : Self = Self.from_bits(CM_F64_ARCHYP_L1_HI.get(%i1))
        %l2h  : Self = Self.from_bits(CM_F64_ARCHYP_L2_HI.get(%i2))
        %l1l  : Self = Self.from_bits(CM_F64_ARCHYP_L1_LO.get(%i1))
        %l2l  : Self = Self.from_bits(CM_F64_ARCHYP_L2_LO.get(%i2))
        %lh   : Self = %l1h.add(%l2h).add(Self.mul(0x1.62e42fefa38p-1, %ed))
        %t1   : Self = Self.mul(0x1.ef35793c7673p-45, %ed).add(%l1l.add(%l2l))
        %t2   : Self = %f.add(%t1)
        %t3   : Self = %g.add(%t2)
        %ll   : Self = %dx.add(%t3)
        %lb   : Self = %lh.add(%ll.sub(%eps))
        %ub   : Self = %lh.add(%ll.add(%eps))
        %sure : Bool = %lb.eq(%ub)
        // 0x1.71547652b82fep+0 approximates 1/log(2)
        branch %sure
            ? return(%lb)
            : return(cm_f64_acosh_refine(%self, Self.mul(0x1.71547652b82fep+0, %lb)))

/// The double-double sum (xh + xl) + (ch + cl): an exact two-sum of the high parts plus the low parts.
private routine cm_f64_acosh_adddd(%xh: F64, %xl: F64, %ch: F64, %cl: F64) -> CmF64HypDd
    block entry():
        %s  : F64 = %xh.add(%ch)
        %ap : F64 = %s.sub(%ch)
        %bp : F64 = %s.sub(%ap)
        %da : F64 = %xh.sub(%ap)
        %db : F64 = %ch.sub(%bp)
        return(CmF64HypDd { hi: %s, lo: %da.add(%db).add(%xl.add(%cl)) })

/// The double-double product (xh + xl) (ch + cl), renormalized.
private routine cm_f64_acosh_muldd_acc(%xh: F64, %xl: F64, %ch: F64, %cl: F64) -> CmF64HypDd
    block entry():
        %ahlh : F64 = %ch.mul(%xl)
        %alhh : F64 = %cl.mul(%xh)
        %ahhh : F64 = %ch.mul(%xh)
        %ahhl : F64 = %ch.mul_add(%xh, %ahhh.neg()).add(%alhh.add(%ahlh))
        return(cm_f64_hyp_fasttwosum(%ahhh, %ahhl))

/// The double-double times double product (xh + xl) ch, renormalized.
private routine cm_f64_acosh_mulddd(%xh: F64, %xl: F64, %ch: F64) -> CmF64HypDd
    block entry():
        %ahlh : F64 = %ch.mul(%xl)
        %ahhh : F64 = %ch.mul(%xh)
        %ahhl : F64 = %ch.mul_add(%xh, %ahhh.neg()).add(%ahlh)
        %h    : F64 = %ahhh.add(%ahhl)
        %l    : F64 = %ahhh.sub(%h).add(%ahhl)
        return(CmF64HypDd { hi: %h, lo: %l })

/// One Horner step of a double-double polynomial: (ch + cl) (xh + xl) + (c_hi + c_lo).
private routine cm_f64_acosh_polydd_step(%xh: F64, %xl: F64, %ch: F64, %cl: F64, %c_hi: F64,
        %c_lo: F64) -> CmF64HypDd
    block entry():
        %p : CmF64HypDd = cm_f64_acosh_muldd_acc(%xh, %xl, %ch, %cl)
        %s : CmF64HypDd = cm_f64_hyp_fasttwosum(%c_hi, %p.hi)
        %l : F64        = %p.lo.add(%s.lo.add(%c_lo))
        return(CmF64HypDd { hi: %s.hi, lo: %l })

/// The accurate path of acosh near 1: acosh(1 + z) = sqrt(2z) (1 + z P(z)), with sqrt(2z) = sh + sl.
private routine cm_f64_acosh_one(%z: F64, %sh: F64, %sl: F64) -> F64
    block entry():
        %c0  : F64        = %z.mul(0x1.613229230e255p-25).add(-0x1.1bf173531ee23p-23)
        %c1  : F64        = %z.mul(%c0).add(0x1.4edd2ddb3721fp-22)
        %c2  : F64        = %z.mul(%c1).add(-0x1.77ead7b1ca449p-21)
        %c3  : F64        = %z.mul(%c2).add(0x1.a681d7d2298ebp-20)
        %y2  : F64        = %z.mul(%z.mul(%c3).add(-0x1.df3b9d1296ea9p-19))
        %p10 : CmF64HypDd = cm_f64_hyp_polydd_init(%y2, 0x1.12ef3bf8a0a74p-17,
                0x1.f9c6b51787043p-80)
        %p9  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p10.hi, %p10.lo,
                -0x1.3fde50d0cb4b9p-16, 0x1.0335101403d9dp-72)
        %p8  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p9.hi, %p9.lo, 0x1.7a878787648e2p-15,
                -0x1.1cea281e08012p-69)
        %p7  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p8.hi, %p8.lo,
                -0x1.c99999999914fp-14, 0x1.ee0d9408a2e2ap-68)
        %p6  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p7.hi, %p7.lo, 0x1.1c4ec4ec4ec43p-12,
                0x1.c6791d1cf399ap-66)
        %p5  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p6.hi, %p6.lo,
                -0x1.6e8ba2e8ba2e9p-11, 0x1.6d50ce7188d3dp-65)
        %p4  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p5.hi, %p5.lo, 0x1.f1c71c71c71c7p-10,
                0x1.c56d45e265e2cp-66)
        %p3  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p4.hi, %p4.lo, -0x1.6db6db6db6db7p-8,
                0x1.24929b16ec6b7p-63)
        %p2  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p3.hi, %p3.lo, 0x1.3333333333333p-6,
                0x1.9999998933f0ep-61)
        %p1  : CmF64HypDd = cm_f64_acosh_polydd_step(%z, 0.0, %p2.hi, %p2.lo, -0x1.5555555555555p-4,
                -0x1.5555555554af1p-58)
        %p   : CmF64HypDd = cm_f64_acosh_mulddd(%p1.hi, %p1.lo, %z)
        %s   : CmF64HypDd = cm_f64_hyp_fasttwosum(1.0, %p.hi)
        %q   : CmF64HypDd = cm_f64_acosh_muldd_acc(%s.hi, %s.lo.add(%p.lo), %sh, %sl)
        return(%q.hi.add(%q.lo))

/// The accurate path of acosh: log(x + sqrt(x^2 - 1)) to about 150 bits, where a approximates
/// acosh(x) / log(2).
private routine cm_f64_acosh_refine(%x: F64, %a: F64) -> F64
    block entry():
        %ix       : U64  = %x.bits()
        %moderate : Bool = %ix.lt(0x4190000000000000)  // x < 2^26
        %big      : Bool = %ix.lt(0x4330000000000000)  // x < 2^52
        when:
            %moderate -> moderate()
            %big      -> reduce(F64.mul(2.0, %x), F64.div(-0.5, %x), 0)
            else      -> reduce(%x, 0.0,
                    1)  // 2x could overflow: zh = x, and the exponent gets one more

    // zh + zl = x + sqrt(x^2 - 1)
    block moderate():
        %x2h : F64        = %x.mul(%x)
        %x2l : F64        = %x.mul_add(%x, %x2h.neg())
        %w   : CmF64HypDd = cm_f64_hyp_fasttwosum(%x2h.sub(1.0), %x2l)
        %sh  : F64        = %w.hi.sqrt()
        %sl  : F64        = %w.lo.sub(%sh.mul_add(%sh, %w.hi.neg())).div(F64.mul(2.0, %sh))
        %z0  : CmF64HypDd = cm_f64_hyp_fasttwosum(%x, %sh)
        %z   : CmF64HypDd = cm_f64_hyp_fasttwosum(%z0.hi, %z0.lo.add(%sl))
        jump reduce(%z.hi, %z.lo, 0)

    // zh + zl approximates x + sqrt(x^2 - 1), or half of it when huge = 1
    block reduce(%zh: F64, %zl: F64, %huge: S64):
        %tb   : U64           = %zh.bits()
        %e    : S64           = %tb.shr(52).to<S64>().sub(0x3FF).add(%huge)
        %m    : F64           = F64.from_bits(%tb.bitand(0x000FFFFFFFFFFFFF).bitor(0x3FF0000000000000))
        %ed   : F64           = %e.to<F64>()
        %i    : U64           = %a.sub(%ed).add(0x1.00008p+0).bits().sub_wrap(0x3FF0000000000000).shr(36)
        %i1   : USize         = %i.shr(12).bitand(0x1F).to<USize>()
        %i2   : USize         = %i.shr(8).bitand(0xF).to<USize>()
        %i3   : USize         = %i.shr(4).bitand(0xF).to<USize>()
        %i4   : USize         = %i.bitand(0xF).to<USize>()
        %el2  : F64           = F64.mul(-0x1.9ff0342542fc3p-91, %ed)
        %el1  : F64           = F64.mul(0x1.ef35793c768p-46, %ed)
        %el0  : F64           = F64.mul(0x1.62e42fefa38p-2, %ed)
        %big  : CmF64ArchypTd = cm_f64_archyp_log_table(%i1, %i2, %i3, %i4)
        %big0 : F64           = %big.hi.add(%el0)
        %rt   : CmF64HypDd    = cm_f64_archyp_rt(%i1, %i2, %i3, %i4)
        %dh   : F64           = %rt.hi.mul(%m)
        %dl   : F64           = %rt.hi.mul_add(%m, %dh.neg())
        %sh   : F64           = %rt.lo.mul(%m)
        %sl   : F64           = %rt.lo.mul_add(%m, %sh.neg())
        %q    : CmF64HypDd    = cm_f64_hyp_fasttwosum(%dh.sub(1.0), %dl)
        // zl / 2^e, scaled like m = zh / 2^e
        %zs   : F64  = F64.from_bits(%zl.bits().sub_wrap(%e.to_wrap<U64>().shl(52)))
        %zero : Bool = %zl.eq(0.0)
        %xl   : F64  = %zero
            ? %q.lo
            : %q.lo.add(%rt.hi.mul(%zs))
        %xs   : CmF64HypDd = cm_f64_acosh_adddd(%q.hi, %xl, %sh, %sl)
        %xh   : F64        = %xs.hi
        %c    : F64        = %xh.mul(-0x1.55555555c3157p-4).add(0x1.9999999a0754fp-4)
        %tail : F64        = %xh.mul(%xh.mul(%c).add(-0x1p-3))
        %p3   : CmF64HypDd = cm_f64_hyp_polydd_init(%tail, 0x1.5555555555555p-3,
                0x1.55540c15cf91fp-57)
        %p2   : CmF64HypDd = cm_f64_acosh_polydd_step(%xh, %xs.lo, %p3.hi, %p3.lo, -0x1p-2,
                -0x1.932ce43199a8dp-110)
        %p1   : CmF64HypDd = cm_f64_acosh_polydd_step(%xh, %xs.lo, %p2.hi, %p2.lo, 0x1p-1,
                0x1.24b67ee516e3bp-111)
        %p0   : CmF64HypDd = cm_f64_acosh_muldd_acc(%xh, %xs.lo, %p1.hi, %p1.lo)
        %pe   : CmF64HypDd = cm_f64_acosh_adddd(%p0.hi, %p0.lo, %el1, %el2)
        %s    : CmF64HypDd = cm_f64_acosh_adddd(%pe.hi, %pe.lo, %big.mid, %big.lo)
        %w0   : CmF64HypDd = cm_f64_hyp_fasttwosum(%big0, %s.hi)
        %w1   : CmF64HypDd = cm_f64_hyp_fasttwosum(%w0.lo, %s.lo)
        %v0   : F64        = %w0.hi.mul(2.0)
        %v1   : F64        = cm_f64_hyp_nudge(%w1.hi.mul(2.0), %w1.lo.mul(2.0))
        %tu   : U64        = %v1.bits()
        %er   : U64        = %tu.add_wrap(7).bitand(0x000FFFFFFFFFFFFF)
        %de   : U64        = %v0.bits().shr(52).bitand(0x7FF).sub_wrap(%tu.shr(52).bitand(0x7FF))
        %res  : F64        = %v0.add(%v1)
        %hard : Bool       = %de.gt(102).bitor(%er.lt(15))
        branch %hard
            ? return(cm_f64_acosh_database(%x, %res))
            : return(%res)

/// The exact acosh x for the arguments the fast and accurate paths can't round, or f for any other x.
private routine cm_f64_acosh_database(%x: F64, %f: F64) -> F64
    block entry():
        jump search(0, 6)

    block search(%a: S64, %b: S64):
        %open : Bool = %a.le(%b)
        branch %open
            ? probe(%a, %b)
            : return(%f)

    block probe(%a: S64, %b: S64):
        %m     : S64   = %a.add(%b).div(2)
        %mu    : USize = %m.to<USize>()
        %key   : F64   = F64.from_bits(CM_F64_ACOSH_DB_X.get(%mu))
        %below : Bool  = %key.lt(%x)
        %found : Bool  = %key.eq(%x)
        when:
            %below -> search(%m.add(1), %b)
            %found -> hit(%mu)
            else   -> search(%a, %m.sub(1))

    block hit(%mu: USize):
        %h : F64 = F64.from_bits(CM_F64_ACOSH_DB_H.get(%mu))
        %l : F64 = F64.from_bits(CM_F64_ACOSH_DB_L.get(%mu))
        return(%h.add(%l))
