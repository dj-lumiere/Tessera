/// Subtracts %value and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw fsub ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_fsub(%self: Self, %value: T) -> T
