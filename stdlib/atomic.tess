@[target(arch: "riscv32"), feature("a")]
conform AtomicStore<S8>, AtomicStore<U8>, AtomicStore<S16>, AtomicStore<U16>, AtomicStore<S32>, AtomicStore<U32>, AtomicStore<USize>, AtomicStore<SSize>, AtomicStore<Byte>, AtomicStore<Addr>, AtomicStore<F32>
