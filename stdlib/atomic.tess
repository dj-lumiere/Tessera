        %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_weak_acq_rel_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
