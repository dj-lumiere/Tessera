routine Ptr<T>.atomic_fetch_fsub_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicFloat<T>

// -- compare and exchange --------------------------------------------------------

@[external("llvm"),
        template("{t0} = cmpxchg ptr {%self}, {T} {%expected}, {T} {%new} seq_cst seq_cst, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and sequentially consistent: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
routine Ptr<T>.atomic_compare_exchange(%self: Self, %expected: T, %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg ptr {%self}, {T} {%expected}, {T} {%new} monotonic monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_relaxed_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and relaxed (only atomic): Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
routine Ptr<T>.atomic_compare_exchange_relaxed(%self: Self, %expected: T, %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_relaxed_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg ptr {%self}, {T} {%expected}, {T} {%new} acquire acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_acquire_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and acquire: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
routine Ptr<T>.atomic_compare_exchange_acquire(%self: Self, %expected: T, %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_acquire_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg ptr {%self}, {T} {%expected}, {T} {%new} release monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_release_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and release: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
routine Ptr<T>.atomic_compare_exchange_release(%self: Self, %expected: T, %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_release_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg ptr {%self}, {T} {%expected}, {T} {%new} acq_rel acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_acq_rel_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and acquire and release: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
routine Ptr<T>.atomic_compare_exchange_acq_rel(%self: Self, %expected: T, %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_acq_rel_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg weak ptr {%self}, {T} {%expected}, {T} {%new} seq_cst seq_cst, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_weak_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and sequentially consistent: Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
routine Ptr<T>.atomic_compare_exchange_weak(%self: Self, %expected: T, %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_weak_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg weak ptr {%self}, {T} {%expected}, {T} {%new} monotonic monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_weak_relaxed_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and relaxed (only atomic): Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
routine Ptr<T>.atomic_compare_exchange_weak_relaxed(%self: Self, %expected: T,
        %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_weak_relaxed_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
        branch %swapped ? return(.Success(%value)) : return(.Failure(%value))

@[external("llvm"),
        template("{t0} = cmpxchg weak ptr {%self}, {T} {%expected}, {T} {%new} acquire acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_weak_acquire_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and acquire: Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
routine Ptr<T>.atomic_compare_exchange_weak_acquire(%self: Self, %expected: T,
        %new: T) -> Result<T, T>
require T: typename, AtomicExchange<T>
    block entry():
        claim %previous : Ptr<T>
        %swapped : Bool = %self.atomic_compare_exchange_weak_acquire_raw(%expected, %new, %previous)
        %value   : T    = %previous.load()
