@[external("llvm"),
        template("{t0} = cmpxchg weak ptr {%self}, {T} {%expected}, {T} {%new} acq_rel acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_weak_acq_rel_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and acquire and release: Success with the previous value
