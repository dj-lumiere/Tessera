@[target(arch: "arm"), feature("armv7-a")]
conform AtomicStore<S8>, AtomicStore<U8>, AtomicStore<S16>, AtomicStore<U16>, AtomicStore<S32>, AtomicStore<U32>, AtomicStore<S64>, AtomicStore<U64>, AtomicStore<USize>, AtomicStore<SSize>, AtomicStore<Byte>, AtomicStore<Addr>, AtomicStore<F32>, AtomicStore<F64>
