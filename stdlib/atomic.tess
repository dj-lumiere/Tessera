// Tessera stdlib: atomics
//
// An atomic access is per access, like a volatile one: atomic_* routines on Ptr<T> next to load and store (Roadmap
// #26). The memory order is a name suffix: none is sequentially consistent, _relaxed, _acquire, _release, and
// _acq_rel choose weaker ones, and each operation has only the orders LLVM allows for it (a load can't release, a
// store can't acquire). compare_exchange's failure order follows its success order as C++'s does.
//
// What an atomic can do depends on T and on the target, so each routine requires a marker concept, declared below
// per type and target: AtomicStore (load, store), AtomicExchange (swap, compare_exchange; integers, bytes, and
// pointers, since LLVM's cmpxchg takes no float), AtomicArith (fetch_add, fetch_sub; integers), AtomicBits
// (fetch_and, fetch_or, fetch_xor), and AtomicFloat (fetch_fadd, fetch_fsub; F32, F64). An access wider than the
// target does lock-free is a compile error, never a hidden libatomic call or interrupt masking: bare metal has no
// libatomic, a hosted one may take a lock, and masking interrupts is wrong on a multicore MCU. So 64-bit atomics
// exist on x86, AArch64, A-profile ARM, and riscv64 with A; 32-bit ones on ARMv7-M and riscv32 with A; 128-bit ones
// on x86-64 with cx16 (x86-64-v2 and up); none on Cortex-M0 or RISC-V without A. Bool has none yet: use a U8 flag.
//
// The address must be aligned to T's size, as C's _Atomic and C++'s atomic_ref require; a U64 field of a record has
// alignment 4 on some 32-bit ABIs, so put a 64-bit atomic where it's 8-aligned there.

module Standard::Core

// -- capabilities ----------------------------------------------------------------

/// atomic_load and atomic_store are lock-free for T on the target.
concept AtomicStore<T>
require T: typename

/// atomic_swap and atomic_compare_exchange are lock-free for T on the target.
concept AtomicExchange<T>
require T: typename

/// atomic_fetch_add and atomic_fetch_sub are lock-free for T on the target.
concept AtomicArith<T>
require T: typename

/// atomic_fetch_and, atomic_fetch_or, and atomic_fetch_xor are lock-free for T on the target.
concept AtomicBits<T>
require T: typename

/// atomic_fetch_fadd and atomic_fetch_fsub are lock-free for T on the target.
concept AtomicFloat<T>
require T: typename

// -- what each target does lock-free --------------------------------------------

// 64 bits: x86-64 (lock-prefixed instructions), i686 (cmpxchg8b), AArch64, A-profile ARM from v6K
// (ldrexd), riscv64 with A.
@target(arch: "x86_64")
conform AtomicStore<S8>, AtomicStore<U8>, AtomicStore<S16>, AtomicStore<U16>, AtomicStore<S32>, AtomicStore<U32>, AtomicStore<S64>, AtomicStore<U64>, AtomicStore<USize>, AtomicStore<SSize>, AtomicStore<Byte>, AtomicStore<Addr>, AtomicStore<F32>, AtomicStore<F64>
@target(arch: "x86_64")
conform AtomicStore<Ptr<T>> when T: typename
@target(arch: "x86_64")
conform AtomicExchange<S8>, AtomicExchange<U8>, AtomicExchange<S16>, AtomicExchange<U16>, AtomicExchange<S32>, AtomicExchange<U32>, AtomicExchange<S64>, AtomicExchange<U64>, AtomicExchange<USize>, AtomicExchange<SSize>, AtomicExchange<Byte>, AtomicExchange<Addr>
@target(arch: "x86_64")
conform AtomicExchange<Ptr<T>> when T: typename
@target(arch: "x86_64")
conform AtomicArith<S8>, AtomicArith<U8>, AtomicArith<S16>, AtomicArith<U16>, AtomicArith<S32>, AtomicArith<U32>, AtomicArith<S64>, AtomicArith<U64>, AtomicArith<USize>, AtomicArith<SSize>
@target(arch: "x86_64")
conform AtomicBits<S8>, AtomicBits<U8>, AtomicBits<S16>, AtomicBits<U16>, AtomicBits<S32>, AtomicBits<U32>, AtomicBits<S64>, AtomicBits<U64>, AtomicBits<USize>, AtomicBits<SSize>, AtomicBits<Byte>
@target(arch: "x86_64")
conform AtomicFloat<F32>, AtomicFloat<F64>

@target(arch: "x86")
conform AtomicStore<S8>, AtomicStore<U8>, AtomicStore<S16>, AtomicStore<U16>, AtomicStore<S32>, AtomicStore<U32>, AtomicStore<S64>, AtomicStore<U64>, AtomicStore<USize>, AtomicStore<SSize>, AtomicStore<Byte>, AtomicStore<Addr>, AtomicStore<F32>, AtomicStore<F64>
@target(arch: "x86")
conform AtomicStore<Ptr<T>> when T: typename
@target(arch: "x86")
conform AtomicExchange<S8>, AtomicExchange<U8>, AtomicExchange<S16>, AtomicExchange<U16>, AtomicExchange<S32>, AtomicExchange<U32>, AtomicExchange<S64>, AtomicExchange<U64>, AtomicExchange<USize>, AtomicExchange<SSize>, AtomicExchange<Byte>, AtomicExchange<Addr>
@target(arch: "x86")
conform AtomicExchange<Ptr<T>> when T: typename
@target(arch: "x86")
conform AtomicArith<S8>, AtomicArith<U8>, AtomicArith<S16>, AtomicArith<U16>, AtomicArith<S32>, AtomicArith<U32>, AtomicArith<S64>, AtomicArith<U64>, AtomicArith<USize>, AtomicArith<SSize>
@target(arch: "x86")
conform AtomicBits<S8>, AtomicBits<U8>, AtomicBits<S16>, AtomicBits<U16>, AtomicBits<S32>, AtomicBits<U32>, AtomicBits<S64>, AtomicBits<U64>, AtomicBits<USize>, AtomicBits<SSize>, AtomicBits<Byte>
@target(arch: "x86")
conform AtomicFloat<F32>, AtomicFloat<F64>

@target(arch: "aarch64")
conform AtomicStore<S8>, AtomicStore<U8>, AtomicStore<S16>, AtomicStore<U16>, AtomicStore<S32>, AtomicStore<U32>, AtomicStore<S64>, AtomicStore<U64>, AtomicStore<USize>, AtomicStore<SSize>, AtomicStore<Byte>, AtomicStore<Addr>, AtomicStore<F32>, AtomicStore<F64>
@target(arch: "aarch64")
conform AtomicStore<Ptr<T>> when T: typename
@target(arch: "aarch64")
conform AtomicExchange<S8>, AtomicExchange<U8>, AtomicExchange<S16>, AtomicExchange<U16>, AtomicExchange<S32>, AtomicExchange<U32>, AtomicExchange<S64>, AtomicExchange<U64>, AtomicExchange<USize>, AtomicExchange<SSize>, AtomicExchange<Byte>, AtomicExchange<Addr>
@target(arch: "aarch64")
conform AtomicExchange<Ptr<T>> when T: typename
@target(arch: "aarch64")
conform AtomicArith<S8>, AtomicArith<U8>, AtomicArith<S16>, AtomicArith<U16>, AtomicArith<S32>, AtomicArith<U32>, AtomicArith<S64>, AtomicArith<U64>, AtomicArith<USize>, AtomicArith<SSize>
@target(arch: "aarch64")
conform AtomicBits<S8>, AtomicBits<U8>, AtomicBits<S16>, AtomicBits<U16>, AtomicBits<S32>, AtomicBits<U32>, AtomicBits<S64>, AtomicBits<U64>, AtomicBits<USize>, AtomicBits<SSize>, AtomicBits<Byte>
@target(arch: "aarch64")
conform AtomicFloat<F32>, AtomicFloat<F64>

@[target(arch: "riscv64"), feature("a")]
