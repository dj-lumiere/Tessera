@[external("llvm"),
        template("{result} = atomicrmw xor ptr {%self}, {T} {%value} acq_rel, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_xor_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// Adds %value and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw fadd ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_fadd(%self: Self, %value: T) -> T
require T: typename, AtomicFloat<T>

/// Adds %value and returns what was there, atomically and relaxed (only atomic).
@[external("llvm"),
