@[external("llvm"),
        template("{t0} = cmpxchg weak ptr {%self}, {T} {%expected}, {T} {%new} release monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {%previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
private routine Ptr<T>.atomic_compare_exchange_weak_release_raw(%self: Self, %expected: T, %new: T,
        %previous: Ptr<T>) -> Bool
require T: typename, AtomicExchange<T>

/// Writes %new if the value here is %expected, atomically and release: Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
