conform AtomicExchange<S8>, AtomicExchange<U8>, AtomicExchange<S16>, AtomicExchange<U16>, AtomicExchange<S32>, AtomicExchange<U32>, AtomicExchange<S64>, AtomicExchange<U64>, AtomicExchange<USize>, AtomicExchange<SSize>, AtomicExchange<Byte>, AtomicExchange<Addr>
@[target(arch: "arm"), feature("armv8-a")]
conform AtomicExchange<Ptr<T>> when T: typename
@[target(arch: "arm"), feature("armv8-a")]
