// 128 bits: x86-64 with cmpxchg16b (x86-64-v2 and up).
@[target(arch: "x86_64"), feature("cx16")]
conform AtomicStore<S128>, AtomicStore<U128>
@[target(arch: "x86_64"), feature("cx16")]
conform AtomicExchange<S128>, AtomicExchange<U128>
@[target(arch: "x86_64"), feature("cx16")]
conform AtomicArith<S128>, AtomicArith<U128>
@[target(arch: "x86_64"), feature("cx16")]
conform AtomicBits<S128>, AtomicBits<U128>

// -- load and store --------------------------------------------------------------

/// Reads the T at this address atomically, sequentially consistent.
@[external("llvm"), template("{result} = load atomic {T}, ptr {%self} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_load(%self: Self) -> T
require T: typename, AtomicStore<T>

/// Reads the T at this address atomically, relaxed (only atomic).
@[external("llvm"), template("{result} = load atomic {T}, ptr {%self} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_load_relaxed(%self: Self) -> T
require T: typename, AtomicStore<T>

/// Reads the T at this address atomically, acquire.
@[external("llvm"), template("{result} = load atomic {T}, ptr {%self} acquire, align {sizeof T}")]
routine Ptr<T>.atomic_load_acquire(%self: Self) -> T
require T: typename, AtomicStore<T>

/// Writes %value to this address atomically, sequentially consistent.
@[external("llvm"), template("store atomic {T} {%value}, ptr {%self} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_store(%self: Self, %value: T) -> Void
require T: typename, AtomicStore<T>

/// Writes %value to this address atomically, relaxed (only atomic).
@[external("llvm"), template("store atomic {T} {%value}, ptr {%self} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_store_relaxed(%self: Self, %value: T) -> Void
require T: typename, AtomicStore<T>

/// Writes %value to this address atomically, release.
@[external("llvm"), template("store atomic {T} {%value}, ptr {%self} release, align {sizeof T}")]
routine Ptr<T>.atomic_store_release(%self: Self, %value: T) -> Void
require T: typename, AtomicStore<T>

// -- read-modify-write -----------------------------------------------------------

/// Writes %value and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw xchg ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_swap(%self: Self, %value: T) -> T
require T: typename, AtomicExchange<T>

/// Writes %value and returns what was there, atomically and relaxed (only atomic).
@[external("llvm"),
        template("{result} = atomicrmw xchg ptr {%self}, {T} {%value} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_swap_relaxed(%self: Self, %value: T) -> T
require T: typename, AtomicExchange<T>

/// Writes %value and returns what was there, atomically and acquire.
@[external("llvm"),
        template("{result} = atomicrmw xchg ptr {%self}, {T} {%value} acquire, align {sizeof T}")]
routine Ptr<T>.atomic_swap_acquire(%self: Self, %value: T) -> T
require T: typename, AtomicExchange<T>

/// Writes %value and returns what was there, atomically and release.
@[external("llvm"),
        template("{result} = atomicrmw xchg ptr {%self}, {T} {%value} release, align {sizeof T}")]
routine Ptr<T>.atomic_swap_release(%self: Self, %value: T) -> T
require T: typename, AtomicExchange<T>

/// Writes %value and returns what was there, atomically and acquire and release.
@[external("llvm"),
        template("{result} = atomicrmw xchg ptr {%self}, {T} {%value} acq_rel, align {sizeof T}")]
routine Ptr<T>.atomic_swap_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicExchange<T>

/// Adds %value (wrapping) and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw add ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_add(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Adds %value (wrapping) and returns what was there, atomically and relaxed (only atomic).
@[external("llvm"),
        template("{result} = atomicrmw add ptr {%self}, {T} {%value} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_add_relaxed(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Adds %value (wrapping) and returns what was there, atomically and acquire.
@[external("llvm"),
        template("{result} = atomicrmw add ptr {%self}, {T} {%value} acquire, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_add_acquire(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Adds %value (wrapping) and returns what was there, atomically and release.
@[external("llvm"),
        template("{result} = atomicrmw add ptr {%self}, {T} {%value} release, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_add_release(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Adds %value (wrapping) and returns what was there, atomically and acquire and release.
@[external("llvm"),
        template("{result} = atomicrmw add ptr {%self}, {T} {%value} acq_rel, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_add_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Subtracts %value (wrapping) and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw sub ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_sub(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Subtracts %value (wrapping) and returns what was there, atomically and relaxed (only atomic).
@[external("llvm"),
        template("{result} = atomicrmw sub ptr {%self}, {T} {%value} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_sub_relaxed(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Subtracts %value (wrapping) and returns what was there, atomically and acquire.
@[external("llvm"),
        template("{result} = atomicrmw sub ptr {%self}, {T} {%value} acquire, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_sub_acquire(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Subtracts %value (wrapping) and returns what was there, atomically and release.
@[external("llvm"),
        template("{result} = atomicrmw sub ptr {%self}, {T} {%value} release, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_sub_release(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// Subtracts %value (wrapping) and returns what was there, atomically and acquire and release.
@[external("llvm"),
        template("{result} = atomicrmw sub ptr {%self}, {T} {%value} acq_rel, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_sub_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicArith<T>

/// ANDs in %value and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw and ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_and(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ANDs in %value and returns what was there, atomically and relaxed (only atomic).
@[external("llvm"),
        template("{result} = atomicrmw and ptr {%self}, {T} {%value} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_and_relaxed(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ANDs in %value and returns what was there, atomically and acquire.
@[external("llvm"),
        template("{result} = atomicrmw and ptr {%self}, {T} {%value} acquire, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_and_acquire(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ANDs in %value and returns what was there, atomically and release.
@[external("llvm"),
        template("{result} = atomicrmw and ptr {%self}, {T} {%value} release, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_and_release(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ANDs in %value and returns what was there, atomically and acquire and release.
@[external("llvm"),
        template("{result} = atomicrmw and ptr {%self}, {T} {%value} acq_rel, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_and_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ORs in %value and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw or ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_or(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ORs in %value and returns what was there, atomically and relaxed (only atomic).
@[external("llvm"),
        template("{result} = atomicrmw or ptr {%self}, {T} {%value} monotonic, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_or_relaxed(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ORs in %value and returns what was there, atomically and acquire.
@[external("llvm"),
        template("{result} = atomicrmw or ptr {%self}, {T} {%value} acquire, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_or_acquire(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ORs in %value and returns what was there, atomically and release.
@[external("llvm"),
        template("{result} = atomicrmw or ptr {%self}, {T} {%value} release, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_or_release(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// ORs in %value and returns what was there, atomically and acquire and release.
@[external("llvm"),
        template("{result} = atomicrmw or ptr {%self}, {T} {%value} acq_rel, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_or_acq_rel(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// XORs in %value and returns what was there, atomically and sequentially consistent.
@[external("llvm"),
        template("{result} = atomicrmw xor ptr {%self}, {T} {%value} seq_cst, align {sizeof T}")]
routine Ptr<T>.atomic_fetch_xor(%self: Self, %value: T) -> T
require T: typename, AtomicBits<T>

/// XORs in %value and returns what was there, atomically and relaxed (only atomic).
