@[target(arch: "arm"), feature("armv8-a")]
conform AtomicBits<S8>, AtomicBits<U8>, AtomicBits<S16>, AtomicBits<U16>, AtomicBits<S32>, AtomicBits<U32>, AtomicBits<S64>, AtomicBits<U64>, AtomicBits<USize>, AtomicBits<SSize>, AtomicBits<Byte>
