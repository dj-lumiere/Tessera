// Tessera stdlib: prelude
//
// Compiler-intrinsic operations auto-imported into every translation unit.
// These map directly to LLVM IR instructions and have no runtime cost beyond
// the instruction itself.
//
// All operations are generic over their operand type:
//   integer ops  — T is an integer type (S*, U*, and Byte for the bit operations)
//   float ops    — T is a float type
//   conversions  — From/To unconstrained; caller picks concrete types
//
// Ordered integer comparisons aren't here: signedness belongs to the type, so S*.lt lowers to
// `icmp slt` and U*.lt to `icmp ult` directly (stdlib/types). Shifts are the three LLVM
// instructions shl, ashr, and lshr.

module Standard::Core

// ============================================================
// Division and remainder
// ============================================================

@[external("llvm"), template("{result} = sdiv {T} {%a}, {%b}")]
routine sdiv<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = srem {T} {%a}, {%b}")]
routine srem<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = udiv {T} {%a}, {%b}")]
routine udiv<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = urem {T} {%a}, {%b}")]
routine urem<T>(%a: T, %b: T) -> T
require T: typename

// ============================================================
// Integer arithmetic
// ============================================================

@[external("llvm"), template("{result} = add {T} {%a}, {%b}")]
routine add<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = sub {T} {%a}, {%b}")]
routine sub<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = mul {T} {%a}, {%b}")]
routine mul<T>(%a: T, %b: T) -> T
require T: typename

// ============================================================
// Integer bitwise
// ============================================================

@[external("llvm"), template("{result} = and {T} {%a}, {%b}")]
routine band<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = or {T} {%a}, {%b}")]
routine bor<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = xor {T} {%a}, {%b}")]
routine bxor<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = xor {T} {%val}, -1")]
routine bnot<T>(%val: T) -> T
require T: typename

// ============================================================
// Integer and bool equality
// ============================================================

@[external("llvm"), template("{result} = icmp eq {T} {%a}, {%b}")]
routine ieq<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"), template("{result} = icmp ne {T} {%a}, {%b}")]
routine ine<T>(%a: T, %b: T) -> Bool
require T: typename

// ============================================================
// Bit shifts
// ============================================================

@[external("llvm"), template("{result} = shl {T} {%val}, {%amt}")]
routine shl<T>(%val: T, %amt: T) -> T
require T: typename
@[external("llvm"), template("{result} = ashr {T} {%val}, {%amt}")]
routine ashr<T>(%val: T, %amt: T) -> T  // arithmetic (sign-extend)
require T: typename
@[external("llvm"), template("{result} = lshr {T} {%val}, {%amt}")]
routine lshr<T>(%val: T, %amt: T) -> T  // logical (zero-fill)
require T: typename

// ============================================================
// Floating-point arithmetic
// ============================================================

@[external("llvm"), template("{result} = fadd {T} {%a}, {%b}")]
routine fadd<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = fsub {T} {%a}, {%b}")]
routine fsub<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = fmul {T} {%a}, {%b}")]
routine fmul<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = fdiv {T} {%a}, {%b}")]
routine fdiv<T>(%a: T, %b: T) -> T
require T: typename

// ============================================================
// Floating-point comparisons (ordered — false if either NaN)
// ============================================================

@[external("llvm"), template("{result} = fcmp oeq {T} {%a}, {%b}")]
routine feq<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"), template("{result} = fcmp one {T} {%a}, {%b}")]
routine fne<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"), template("{result} = fcmp olt {T} {%a}, {%b}")]
routine flt<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"), template("{result} = fcmp ogt {T} {%a}, {%b}")]
routine fgt<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"), template("{result} = fcmp ole {T} {%a}, {%b}")]
routine fle<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"), template("{result} = fcmp oge {T} {%a}, {%b}")]
routine fge<T>(%a: T, %b: T) -> Bool
require T: typename

// ============================================================
// Type conversions
// ============================================================

@[external("llvm"), template("{result} = sext {From} {%val} to {To}")]
routine sext<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = zext {From} {%val} to {To}")]
routine zext<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = trunc {From} {%val} to {To}")]
routine trunc<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = bitcast {From} {%val} to {To}")]
routine bitcast<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = fptosi {From} {%val} to {To}")]
routine fptosi<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = sitofp {From} {%val} to {To}")]
routine sitofp<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = fpext {From} {%val} to {To}")]
routine fpext<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = fptrunc {From} {%val} to {To}")]
routine fptrunc<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = ptrtoint {From} {%val} to {To}")]
routine ptrtoint<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = inttoptr {From} {%val} to {To}")]
routine inttoptr<From, To>(%val: From) -> To
    require From: typename
    require To: typename

// ============================================================
// Bit manipulation (LLVM intrinsics)
// ============================================================

@[external("llvm"), template("{result} = call {T} @llvm.ctpop.{T}({T} {%val})")]
routine popcount<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.ctlz.{T}({T} {%val}, i1 {%is_zero_undef})")]
routine clz<T>(%val: T, %is_zero_undef: Bool) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.cttz.{T}({T} {%val}, i1 {%is_zero_undef})")]
routine ctz<T>(%val: T, %is_zero_undef: Bool) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.bswap.{T}({T} {%val})")]
routine bswap<T>(%val: T) -> T
require T: typename

// ============================================================
// Unsigned and saturating conversions
//
// uitofp reads the integer as unsigned. The *_sat forms clamp out-of-range
// floats to the integer range and map NaN to 0 (Rust `as` semantics); the
// plain fptosi / fptoui give poison for out-of-range input.
// ============================================================

@[external("llvm"), template("{result} = uitofp {From} {%val} to {To}")]
routine uitofp<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = fptoui {From} {%val} to {To}")]
routine fptoui<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = call {To} @llvm.fptosi.sat.{To}.{From}({From} {%val})")]
routine fptosi_sat<From, To>(%val: From) -> To
    require From: typename
    require To: typename

@[external("llvm"), template("{result} = call {To} @llvm.fptoui.sat.{To}.{From}({From} {%val})")]
routine fptoui_sat<From, To>(%val: From) -> To
    require From: typename
    require To: typename

// ============================================================
// Overflow detection
//
// Each returns only the overflow flag. The wrapped result is the plain
// add / sub / mul of the same operands.
// ============================================================

@[external("llvm"),
        template("{t0} = call {{ {T}, i1 }} @llvm.sadd.with.overflow.{T}({T} {%a}, {T} {%b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine sadd_overflows<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"),
        template("{t0} = call {{ {T}, i1 }} @llvm.uadd.with.overflow.{T}({T} {%a}, {T} {%b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine uadd_overflows<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"),
        template("{t0} = call {{ {T}, i1 }} @llvm.ssub.with.overflow.{T}({T} {%a}, {T} {%b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine ssub_overflows<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"),
        template("{t0} = call {{ {T}, i1 }} @llvm.usub.with.overflow.{T}({T} {%a}, {T} {%b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine usub_overflows<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"),
        template("{t0} = call {{ {T}, i1 }} @llvm.smul.with.overflow.{T}({T} {%a}, {T} {%b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine smul_overflows<T>(%a: T, %b: T) -> Bool
require T: typename
@[external("llvm"),
        template("{t0} = call {{ {T}, i1 }} @llvm.umul.with.overflow.{T}({T} {%a}, {T} {%b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine umul_overflows<T>(%a: T, %b: T) -> Bool
require T: typename

// ============================================================
// Saturating arithmetic, min / max, funnel shifts, bit reversal
// ============================================================

@[external("llvm"), template("{result} = call {T} @llvm.sadd.sat.{T}({T} {%a}, {T} {%b})")]
routine sadd_sat<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.uadd.sat.{T}({T} {%a}, {T} {%b})")]
routine uadd_sat<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.ssub.sat.{T}({T} {%a}, {T} {%b})")]
routine ssub_sat<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.usub.sat.{T}({T} {%a}, {T} {%b})")]
routine usub_sat<T>(%a: T, %b: T) -> T
require T: typename

@[external("llvm"), template("{result} = call {T} @llvm.smin.{T}({T} {%a}, {T} {%b})")]
routine smin<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.smax.{T}({T} {%a}, {T} {%b})")]
routine smax<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.umin.{T}({T} {%a}, {T} {%b})")]
routine umin<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.umax.{T}({T} {%a}, {T} {%b})")]
routine umax<T>(%a: T, %b: T) -> T
require T: typename

/// Funnel shifts: concatenate %hi:%lo, shift by %amt modulo the bit width, and
/// keep the high (fshl) or low (fshr) half. fshl(x, x, n) rotates left.
@[external("llvm"),
        template("{result} = call {T} @llvm.fshl.{T}({T} {%hi}, {T} {%lo}, {T} {%amt})")]
routine fshl<T>(%hi: T, %lo: T, %amt: T) -> T
require T: typename
@[external("llvm"),
        template("{result} = call {T} @llvm.fshr.{T}({T} {%hi}, {T} {%lo}, {T} {%amt})")]
routine fshr<T>(%hi: T, %lo: T, %amt: T) -> T
require T: typename

@[external("llvm"), template("{result} = call {T} @llvm.bitreverse.{T}({T} {%val})")]
routine bitreverse<T>(%val: T) -> T
require T: typename

// ============================================================
// Floating-point operations
//
// Intrinsic names are written with the LLVM type ({T} = double / float);
// LLVM normalizes them to .f64 / .f32.
// ============================================================

@[external("llvm"), template("{result} = fneg {T} {%val}")]
routine fneg<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = frem {T} {%a}, {%b}")]
routine frem<T>(%a: T, %b: T) -> T
require T: typename
/// Unordered compare: true if either operand is NaN.
@[external("llvm"), template("{result} = fcmp uno {T} {%a}, {%b}")]
routine funo<T>(%a: T, %b: T) -> Bool
require T: typename

@[external("llvm"), template("{result} = call {T} @llvm.fabs.{T}({T} {%val})")]
routine fabs<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.copysign.{T}({T} {%mag}, {T} {%sign})")]
routine copysign<T>(%mag: T, %sign: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.fma.{T}({T} {%a}, {T} {%b}, {T} {%c})")]
routine fma<T>(%a: T, %b: T, %c: T) -> T
require T: typename

@[external("llvm"), template("{result} = call {T} @llvm.floor.{T}({T} {%val})")]
routine floor<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.ceil.{T}({T} {%val})")]
routine ceil<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.trunc.{T}({T} {%val})")]
routine ftrunc<T>(%val: T) -> T
require T: typename
/// Rounds half-way cases away from zero.
@[external("llvm"), template("{result} = call {T} @llvm.round.{T}({T} {%val})")]
routine round<T>(%val: T) -> T
require T: typename
/// Rounds to the nearest integer in the current rounding mode, which is ties to
/// even unless changed. (llvm.roundeven would say so directly, but it lowers to
/// the C23 roundeven, which the Windows C runtime lacks.)
@[external("llvm"), template("{result} = call {T} @llvm.rint.{T}({T} {%val})")]
routine rint<T>(%val: T) -> T
require T: typename

/// minnum / maxnum return the other operand when one is NaN; minimum / maximum
/// propagate NaN and order -0.0 below +0.0.
@[external("llvm"), template("{result} = call {T} @llvm.minnum.{T}({T} {%a}, {T} {%b})")]
routine minnum<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.maxnum.{T}({T} {%a}, {T} {%b})")]
routine maxnum<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.minimum.{T}({T} {%a}, {T} {%b})")]
routine minimum<T>(%a: T, %b: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.maximum.{T}({T} {%a}, {T} {%b})")]
routine maximum<T>(%a: T, %b: T) -> T
require T: typename

@[external("llvm"), template("{result} = call {T} @llvm.sqrt.{T}({T} {%val})")]
routine sqrt<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.pow.{T}({T} {%base}, {T} {%exp})")]
routine pow<T>(%base: T, %exp: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.exp.{T}({T} {%val})")]
routine exp<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.exp2.{T}({T} {%val})")]
routine exp2<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.log.{T}({T} {%val})")]
routine log<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.log2.{T}({T} {%val})")]
routine log2<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.log10.{T}({T} {%val})")]
routine log10<T>(%val: T) -> T
require T: typename

@[external("llvm"), template("{result} = call {T} @llvm.sin.{T}({T} {%val})")]
routine sin<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.cos.{T}({T} {%val})")]
routine cos<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.tan.{T}({T} {%val})")]
routine tan<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.asin.{T}({T} {%val})")]
routine asin<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.acos.{T}({T} {%val})")]
routine acos<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.atan.{T}({T} {%val})")]
routine atan<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.atan2.{T}({T} {%y}, {T} {%x})")]
routine atan2<T>(%y: T, %x: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.sinh.{T}({T} {%val})")]
routine sinh<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.cosh.{T}({T} {%val})")]
routine cosh<T>(%val: T) -> T
require T: typename
@[external("llvm"), template("{result} = call {T} @llvm.tanh.{T}({T} {%val})")]
routine tanh<T>(%val: T) -> T
require T: typename

// ============================================================
// Misc
// ============================================================

@[external("llvm"), template("call void @llvm.trap()"), noreturn]
routine trap() -> Void
