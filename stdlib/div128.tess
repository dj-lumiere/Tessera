// Tessera stdlib: U128 and S128 division
//
// On a 64-bit target, LLVM's 128-bit udiv / urem become calls to compiler-rt's __udivti3 / __umodti3, a general
// shift-and-subtract loop. This divides with two U64 limbs instead (Knuth's algorithm D, which for two limbs is at
// most two steps), each step one hardware divq on x86-64 or Möller and Granlund's multiply-only division elsewhere
// (wide_div.tess):
//   both fit in 64 bits   one U64 divide
//   divisor of one limb   two 2-by-1 steps, the remainder of the first feeding the second
//   divisor of two limbs  one 3-by-2 step (the quotient fits in one limb)
// A 32-bit target keeps LLVM's division, which it expands inline (there is no __udivti3 there).

module Standard::Core

record U128DivRem
    quotient  : U128
    remainder : U128

/// u / d and u % d for d > 0.
#target(size: 64)
routine u128_divrem(u: U128, d: U128) -> U128DivRem
    block entry():
        below : Bool = u.lt(d)
        branch below
            ? return(U128DivRem { quotient: 0, remainder: u })
            : narrow()

    // d <= u, so when u fits in 64 bits, both do.
    block narrow():
        fits : Bool = u.shr(64).eq(0)
        branch fits
            ? by_u64()
            : by_limbs()

    block by_u64():
        a : U64 = u.to_wrap<U64>()
        b : U64 = d.to_wrap<U64>()
        return(U128DivRem { quotient: a.div(b).to<U128>(), remainder: a.mod(b).to<U128>() })

    block by_limbs():
        one_limb : Bool = d.shr(64).eq(0)
        branch one_limb
            ? by_one_limb()
            : by_two_limbs()

    block by_one_limb():
        r : U128DivRem = u128_divrem_by_limb(u, d.to_wrap<U64>())
        return(r)

    block by_two_limbs():
        r : U128DivRem = u128_divrem_by_two_limbs(u, d)
        return(r)

#target(size: not 64)
routine u128_divrem(u: U128, d: U128) -> U128DivRem
    block entry():
        return(U128DivRem { quotient: udiv<U128>(u, d), remainder: urem<U128>(u, d) })

/// u / d for a nonzero one-limb d: normalized so d's top bit is set, then two 2-by-1 steps.
#target(size: 64)
private routine u128_divrem_by_limb(u: U128, d: U64) -> U128DivRem
    block entry():
        shift  : U64  = d.leading_zeros()
        d_norm : U64  = d.shl(shift)
        v      : U64  = div_2by1_prepare(d_norm)
        u_norm : U128 = u.shl(shift.to<U128>())
        // The bits shifted out of the top, below d_norm (a funnel shift by 0 gives 0, where a plain shr by 64 would
        // be poison).
        u_over : U64     = fshl<U64>(0, u.shr(64).to_wrap<U64>(), shift)
        high   : Div2By1 = div_2by1(u_over, u_norm.shr(64).to_wrap<U64>(), d_norm, v)
        low    : Div2By1 = div_2by1(high.remainder, u_norm.to_wrap<U64>(), d_norm, v)
        q      : U128    = high.quotient.to<U128>().shl(64).bitor(low.quotient.to<U128>())
        return(U128DivRem { quotient: q, remainder: low.remainder.shr(shift).to<U128>() })

/// u / d for a two-limb d <= u: normalized so d's top bit is set, then one 3-by-2 step.
#target(size: 64)
private routine u128_divrem_by_two_limbs(u: U128, d: U128) -> U128DivRem
    block entry():
        shift  : U64     = d.shr(64).to_wrap<U64>().leading_zeros()
        d_norm : U128    = d.shl(shift.to<U128>())
        d1     : U64     = d_norm.shr(64).to_wrap<U64>()
        d0     : U64     = d_norm.to_wrap<U64>()
        v      : U64     = div_3by2_prepare(d1, d0)
        u_norm : U128    = u.shl(shift.to<U128>())
        u_over : U64     = fshl<U64>(0, u.shr(64).to_wrap<U64>(), shift)
        step   : Div3By2 = div_3by2(u_over, u_norm.shr(64).to_wrap<U64>(), u_norm.to_wrap<U64>(), d1, d0, v)
        return(U128DivRem { quotient: step.quotient.to<U128>(), remainder: step.remainder.shr(shift.to<U128>()) })

/// |x| as a U128 (MIN's magnitude too).
private routine s128_magnitude(x: S128) -> U128
    block entry():
        u : U128 = bitcast<S128, U128>(x)
        branch x.lt(0)
            ? return(0.sub_wrap(u))
            : return(u)

/// The quotient truncated toward zero, for d != 0 and not MIN / -1.
routine s128_div(u: S128, d: S128) -> S128
    block entry():
        r : U128DivRem = u128_divrem(s128_magnitude(u), s128_magnitude(d))
        q : S128       = bitcast<U128, S128>(r.quotient)
        branch u.lt(0).bitxor(d.lt(0))
            ? return(q.neg_wrap())
            : return(q)

/// The remainder with the dividend's sign, for d != 0 (MIN % -1 is 0).
routine s128_rem(u: S128, d: S128) -> S128
    block entry():
        r   : U128DivRem = u128_divrem(s128_magnitude(u), s128_magnitude(d))
        rem : S128       = bitcast<U128, S128>(r.remainder)
        branch u.lt(0)
            ? return(rem.neg_wrap())
            : return(rem)
