// Tessera stdlib collection: List<T>
//
// Dynamic array. The allocator is stored in the record; callers do not pass it
// to individual operations.

module Standard::Collections

import Standard::Alloc
import Standard::Format

record List<T>
conform Destruct<List<T>>
conform Equal<List<T>>     when T: typename, Equal<T>
conform Represent<List<T>> when T: typename, Diagnose<T>
conform Diagnose<List<T>>  when T: typename, Diagnose<T>
require T: typename
    data     : Ptr<T>
    length   : USize
    capacity : USize
    alloc    : Ptr<Allocator>

routine List<T>.construct(%alloc: Ptr<Allocator>) -> Self
require T: typename
    block entry():
        %list : Self = Self { data: null, length: 0, capacity: 0, alloc: %alloc }
        return(%list)

routine List<T>.length(%self: Self) -> USize
require T: typename
    block entry():
        %length : USize = %self.length
        return(%length)

routine List<T>.is_empty(%self: Self) -> Bool
require T: typename
    block entry():
        %length : USize = %self.length
        %empty  : Bool  = %length.eq(0)
        return(%empty)

routine List<T>.reserve(%self: Ptr<Self>, %capacity: USize) -> Void
require T: typename
    block entry():
        %reserved : Bool = %self.make_capacity(%capacity)
        branch %reserved ? return() : panic(TrapCode.AllocFailed)

/// `reserve`, returning a Failure instead of trapping when the allocator fails.
routine List<T>.reserve_result(%self: Ptr<Self>, %capacity: USize) -> Result<Unit, AllocFailed>
require T: typename
    block entry():
        %reserved : Bool = %self.make_capacity(%capacity)
        branch %reserved ? return(.Success(Unit.value())) : return(.Failure(AllocFailed {}))

/// Grows the buffer to at least %capacity elements. Returns false when the
/// allocator fails, leaving the list as it was.
private routine List<T>.make_capacity(%self: Ptr<Self>, %capacity: USize) -> Bool
require T: typename
    block entry():
        %old_capacity : USize = %self.capacity.load()
        %enough       : Bool  = %old_capacity.ge(%capacity)
        branch %enough ? return(true) : grow(%capacity)

    block grow(%capacity: USize):
        %alloc    : Ptr<Allocator> = %self.alloc.load()
        %old_data : Ptr<T>         = %self.data.load()
        %new_data : Ptr<T>         = reallocate<T>(%alloc, %old_data, %capacity)
        %failed   : Bool           = %new_data.is_null()
        branch %failed ? return(false) : install(%new_data, %capacity)

    block install(%new_data: Ptr<T>, %capacity: USize):
        %self.data.store(%new_data)
        %self.capacity.store(%capacity)
        return(true)

routine List<T>.ensure_capacity(%self: Ptr<Self>, %wanted: USize) -> Void
require T: typename
    block entry():
        %room : Bool = %self.make_room(%wanted)
        branch %room ? return() : panic(TrapCode.AllocFailed)

/// Makes room for %wanted elements, doubling the capacity. Returns false when
/// the allocator fails, leaving the list as it was.
private routine List<T>.make_room(%self: Ptr<Self>, %wanted: USize) -> Bool
require T: typename
    block entry():
        %capacity : USize = %self.capacity.load()
        %enough   : Bool  = %capacity.ge(%wanted)
        branch %enough ? return(true) : choose(%capacity, %wanted)

    block choose(%capacity: USize, %wanted: USize):
        %empty : Bool = %capacity.eq(0)
        branch %empty ? initial(%wanted) : double(%capacity, %wanted)

    block initial(%wanted: USize):
        %base         : USize = 4
        %use_wanted   : Bool  = %wanted.gt(%base)
        %new_capacity : USize = %use_wanted ? %wanted : %base
        return(%self.make_capacity(%new_capacity))

    block double(%capacity: USize, %wanted: USize):
        %next   : USize = %capacity.mul(2)
        %enough : Bool  = %next.ge(%wanted)
        branch %enough ? return(%self.make_capacity(%next)) : double(%next, %wanted)

routine List<T>.push(%self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        %pushed : Result<Unit, AllocFailed> = %self.push_result(%value)
        when %pushed:
            .Success -> return()
            .Failure -> panic(TrapCode.AllocFailed)

/// `push`, returning a Failure instead of trapping when the allocator fails.
routine List<T>.push_result(%self: Ptr<Self>, %value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry():
        %length : USize = %self.length.load()
        %wanted : USize = %length.add(1)
        %room   : Bool  = %self.make_room(%wanted)
        branch %room ? continue : return(.Failure(AllocFailed {}))
        %data : Ptr<T> = %self.data.load()
        %data[%length].store(%value)
        %self.length.store(%wanted)
        return(.Success(Unit.value()))

routine List<T>.pop(%self: Ptr<Self>) -> T
require T: typename
    block entry():
        %popped : Option<T> = %self.pop_checked()
        when %popped:
            .Present(%value) -> return(%value)
            .Absent          -> panic(TrapCode.Empty)

/// `pop`, returning Absent instead of trapping on an empty list.
routine List<T>.pop_checked(%self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        %length : USize = %self.length.load()
        %empty  : Bool  = %length.eq(0)
        branch %empty ? return(.Absent) : pop(%length)

    block pop(%length: USize):
        %index : USize  = %length.sub(1)
        %data  : Ptr<T> = %self.data.load()
        %value : T      = %data[%index].load()
        %self.length.store(%index)
        return(.Present(%value))

routine List<T>.get(%self: Self, %index: USize) -> T
require T: typename
    block entry():
        %length    : USize = %self.length
        %in_bounds : Bool  = %index.lt(%length)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: USize):
        %data  : Ptr<T> = %self.data
        %value : T      = %data[%index].load()
        return(%value)

/// `get`, returning Absent instead of trapping on an index past the end.
routine List<T>.get_checked(%self: Self, %index: USize) -> Option<T>
require T: typename
    block entry():
        %length    : USize = %self.length
        %in_bounds : Bool  = %index.lt(%length)
        branch %in_bounds ? load(%index) : return(.Absent)

    block load(%index: USize):
        %data  : Ptr<T> = %self.data
        %value : T      = %data[%index].load()
        return(.Present(%value))

routine List<T>.set(%self: Ptr<Self>, %index: USize, %value: T) -> Void
require T: typename
    block entry():
        %length    : USize = %self.length.load()
        %in_bounds : Bool  = %index.lt(%length)
        branch %in_bounds ? store(%index, %value) : panic(TrapCode.Bounds)

    block store(%index: USize, %value: T):
        %data : Ptr<T> = %self.data.load()
        %data[%index].store(%value)
        return()

routine List<T>.clear(%self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %self.length.store(0)
        return()

routine List<T>.eq(%self: Self, %other: Self) -> Bool
require T: typename, Equal<T>
    block entry():
        %la       : USize = %self.length
        %lb       : USize = %other.length
        %same_len : Bool  = %la.eq(%lb)
        branch %same_len ? scan(%self, %other, %la) : return(false)

    block scan(%self: Self, %other: Self, %len: USize):
        %pa : Ptr<T> = %self.data
        %pb : Ptr<T> = %other.data
        jump loop(0, %len, %pa, %pb)

    block loop(%i: USize, %len: USize, %pa: Ptr<T>, %pb: Ptr<T>):
        %done : Bool = %i.ge(%len)
        branch %done ? return(true) : step(%i, %len, %pa, %pb)

    block step(%i: USize, %len: USize, %pa: Ptr<T>, %pb: Ptr<T>):
        %x  : T    = %pa[%i].load()
        %y  : T    = %pb[%i].load()
        %eq : Bool = %x.eq(%y)
        branch %eq ? loop(%i.add(1), %len, %pa, %pb) : return(false)

routine List<T>.destruct(%self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %data  : Ptr<T> = %self.data.load()
        %empty : Bool   = %data.is_null()
        branch %empty ? reset() : release(%data)

    block release(%data: Ptr<T>):
        %alloc : Ptr<Allocator> = %self.alloc.load()
        %data.free(%alloc)
        jump reset()

    block reset():
        %self.data.store(null)
        %self.length.store(0)
        %self.capacity.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine List<T>.destruct_all(%self: Ptr<Self>) -> Void
require T: typename, Destruct<T>
    block entry():
        %iter_val : ListIter<T> = .construct(%self)
        claim %iter : Ptr<ListIter<T>>
        %iter.store(%iter_val)
        claim %slot : Ptr<T>
        jump next(%iter, %slot)

    block next(%iter: Ptr<ListIter<T>>, %slot: Ptr<T>):
        %item : Option<T> = %iter.next()
        when %item:
            .Present(%value) -> element(%iter, %slot, %value)
            .Absent          -> finish()

    block element(%iter: Ptr<ListIter<T>>, %slot: Ptr<T>, %value: T):
        %slot.store(%value)
        %slot.destruct()
        jump next(%iter, %slot)

    block finish():
        %self.destruct()
        return()

// -- text ----------------------------------------------------------------------
//
// A List<Byte> is the growable text buffer: it's a Writer, so write(%buf, "...")
// appends to it, and to_string() views what it holds. The list's allocator is
// the only place memory comes from.

conform Writer<List<Byte>>

/// Appends %length bytes, growing through the list's allocator.
routine List<Byte>.write_bytes(%self: Ptr<Self>, %data: Ptr<Byte>, %length: USize) -> Void
    block entry():
        %nothing : Bool = %length.eq(0)
        branch %nothing ? return() : continue
        %old : USize = %self.length.load()
        %new : USize = %old.add(%length)
        %self.ensure_capacity(%new)
        %base : Ptr<Byte> = %self.data.load()
        copy<Byte>(%base[%old], %data, %length)
        %self.length.store(%new)
        return()

/// A view of the bytes written so far, without copying. It's valid until the
/// list next grows or is destructed, and it isn't NUL-terminated.
routine List<Byte>.to_string(%self: Self) -> String
    block entry():
        %data   : Ptr<Byte> = %self.data
        %length : USize     = %self.length
        %text   : String    = .from_ptr(%data, %length)
        return(%text)

/// Ends the bytes with a NUL (not counted in the length) and points at them,
/// for C. Valid until the list next changes or is destructed.
routine List<Byte>.to_cstr(%self: Ptr<Self>) -> CStr
    block entry():
        %length : USize = %self.length.load()
        %self.ensure_capacity(%length.add(1))
        %data : Ptr<Byte> = %self.data.load()
        %data[%length].store(0x00)
        return(.from_ptr(%data))

// -- text -----------------------------------------------------------------------

/// The elements in order, each diagnosed (strings quoted): [1, 2, 3].
routine List<T>.represent<W>(%self: Self, %out: Ptr<W>) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim %whole : Ptr<Self>
        %whole.store(%self)
        %iter_val : ListIter<T> = .construct(%whole)
        claim %iter : Ptr<ListIter<T>>
        %iter.store(%iter_val)
        diagnose_items<T, ListIter<T>, W>(%out, %iter, "[", "]")
        return()

/// The elements in order, each diagnosed: [1, 2, 3].
routine List<T>.diagnose<W>(%self: Self, %out: Ptr<W>) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim %whole : Ptr<Self>
        %whole.store(%self)
        %iter_val : ListIter<T> = .construct(%whole)
        claim %iter : Ptr<ListIter<T>>
        %iter.store(%iter_val)
        diagnose_items<T, ListIter<T>, W>(%out, %iter, "[", "]")
        return()
