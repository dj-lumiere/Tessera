// Tessera stdlib collection: ListIter<T>
//
// Forward iterator over List<T>.  Borrows the list — the list must outlive the
// iterator.  next() returns Option<T>.Absent after the last element.
//
// Satisfies concept Iterator<T, ListIter<T>>.

module Standard::Collections

record ListIter<T>
conform Iterator<T, ListIter<T>>
require T: typename
    list  : Ptr<List<T>>
    index : USize

routine ListIter<T>.construct(%list: Ptr<List<T>>) -> Self
require T: typename
    block entry():
        %iter : Self = Self { list: %list, index: 0 }
        return(%iter)

routine ListIter<T>.next(%self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        %list  : Ptr<List<T>> = %self.list.load()
        %len   : USize        = %list.length()
        %index : USize        = %self.index.load()
        %done  : Bool         = %index.ge(%len)
        branch %done ? return_none() : return_some(%index, %list)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block return_some(%index: USize, %list: Ptr<List<T>>):
        %value : T = %list.get(%index)
        %self.index.store(%index.add(1))
        %some : Option<T> = .Present(%value)
        return(%some)
