; Tessera stdlib collection: ListIter<T>
;
; Forward iterator over List<T>.  Borrows the list — the list must outlive the
; iterator.  next() returns Option<T>.none() after the last element.
;
; Satisfies concept Iterator<T, ListIter<T>>.

record ListIter<T>
conform Iterator<T, ListIter<T>>
require T: typename
    list:  Ptr<List<T>>
    index: I64

routine ListIter<T>.new(#list: Ptr<List<T>>) -> Self
require T: typename
    block entry():
        %iter: Self = Self { list: #list, index: 0 }
        return(%iter)

routine ListIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        #list:  Ptr<List<T>> := #self.list
        %len:   I64          = #list.length()
        %index: I64          := #self.index
        %done:  Bool         = %index.sge(%len)
        branch %done ? return_none() : return_some(%index, #list)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%index: I64, #list: Ptr<List<T>>):
        %value: T = #list.get(%index)
        %index_next: I64 = %index.add(1)
        #self.index = %index_next
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
