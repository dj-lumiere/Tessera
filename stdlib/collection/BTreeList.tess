; Tessera stdlib collection: BTreeList<T>
;
; Sequence tree with a fixed node value capacity of NODE_VALUES. Nodes store
; arrays inline. The allocator is stored in BTreeList; node helpers still
; receive it as a parameter.
;
; Internal nodes use `length` as the child count (no separator keys — navigation
; is purely by subtree_count). Leaf nodes use `length` as the value count.

const NODE_VALUES: I64 = 7
const NODE_CHILDREN: I64 = 8
const NODE_MIN: I64 = 4

struct BTreeListNode<T>
require T: typename
    leaf: Bool
    length: I64
    subtree_count: I64
    values: Array<T, NODE_VALUES>
    children: Array<Ptr<BTreeListNode<T>>, NODE_CHILDREN>

struct BTreeList<T>
conform Equal<BTreeList<T>>
require T: typename, Equal<T>
    root: Ptr<BTreeListNode<T>>
    length: I64
    alloc: Ptr<Allocator>

routine BTreeList<T>.new(#alloc: Ptr<Allocator>) -> Self
require T: typename
    block entry():
        %list: Self = Self {
            root: null,
            length: 0,
            alloc: #alloc
        }
        return(%list)

routine BTreeList<T>.length(#self: Ptr<Self>) -> I64
require T: typename
    block entry():
        %length: I64 := #self.length
        return(%length)

routine BTreeList<T>.is_empty(#self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        return(%empty)

routine BTreeListNode<T>.new(%leaf: Bool, #alloc: Ptr<Allocator>) -> Ptr<BTreeListNode<T>>
require T: typename
    block entry():
        #node: Ptr<BTreeListNode<T>> = alloc<BTreeListNode<T>>(#alloc, 1)
        %failed: Bool = #node.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : init(#node, %leaf)

    block init(#node: Ptr<BTreeListNode<T>>, %leaf: Bool):
        #node.leaf = %leaf
        #node.length = 0
        #node.subtree_count = 0
        return(#node)

routine BTreeListNode<T>.count(#self: Ptr<Self>) -> I64
require T: typename
    block entry():
        %empty: Bool = #self.is_null()
        branch %empty ? return(0) : count(#self)

    block count(#self: Ptr<Self>):
        %count: I64 := #self.subtree_count
        return(%count)

routine BTreeListNode<T>.recount(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        %length: I64 := #self.length
        branch %leaf ? leaf_count(%length) : internal_count(%length)

    block leaf_count(%length: I64):
        #self.subtree_count = %length
        return()

    block internal_count(%length: I64):
        jump loop(0, 0, %length)

    block loop(%i: I64, %sum: I64, %length: I64):
        %done: Bool = %i.sge(%length)
        branch %done ? finish(%sum) : add_child(%i, %sum, %length)

    block add_child(%i: I64, %sum: I64, %length: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        %child_count: I64 = #child.count()
        jump loop(%i.add(1), %sum.add(%child_count), %length)

    block finish(%sum: I64):
        #self.subtree_count = %sum
        return()

routine BTreeList<T>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, Equal<T>
    block entry():
        %la: I64 := #self.length
        %lb: I64 := #other.length
        %same_len: Bool = %la.eq(%lb)
        branch %same_len ? loop(0, %la) : return(false)

    block loop(%i: I64, %len: I64):
        %done: Bool = %i.sge(%len)
        branch %done ? return(true) : step(%i, %len)

    block step(%i: I64, %len: I64):
        %x: T = #self.get(%i)
        %y: T = #other.get(%i)
        %eq: Bool = %x.eq(%y)
        branch %eq ? loop(%i.add(1), %len) : return(false)

routine BTreeList<T>.get(#self: Ptr<Self>, %order: I64) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %order.sge(0).bitand(%order.slt(%length))
        branch %in_bounds ? select_root(%order) : panic(TrapCode.Bounds)

    block select_root(%order: I64):
        #root: Ptr<BTreeListNode<T>> := #self.root
        jump select_node(#root, %order)

    block select_node(#node: Ptr<BTreeListNode<T>>, %order: I64):
        %leaf: Bool := #node.leaf
        branch %leaf ? leaf_get(#node, %order) : internal_get(#node, %order)

    block leaf_get(#node: Ptr<BTreeListNode<T>>, %order: I64):
        %value: T := #node.values[%order]
        return(%value)

    block internal_get(#node: Ptr<BTreeListNode<T>>, %order: I64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<BTreeListNode<T>>, %order: I64, %i: I64):
        #child: Ptr<BTreeListNode<T>> := #node.children[%i]
        %child_count: I64 = #child.count()
        %in_child: Bool = %order.slt(%child_count)
        %remaining: I64 = %order.sub(%child_count)
        branch %in_child ? select_node(#child, %order) : scan(#node, %remaining, %i.add(1))

routine BTreeList<T>.set(#self: Ptr<Self>, %order: I64, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %order.sge(0).bitand(%order.slt(%length))
        branch %in_bounds ? set_root(%order, %value) : panic(TrapCode.Bounds)

    block set_root(%order: I64, %value: T):
        #root: Ptr<BTreeListNode<T>> := #self.root
        jump set_node(#root, %order, %value)

    block set_node(#node: Ptr<BTreeListNode<T>>, %order: I64, %value: T):
        %leaf: Bool := #node.leaf
        branch %leaf ? leaf_set(#node, %order, %value) : internal_set(#node, %order, %value)

    block leaf_set(#node: Ptr<BTreeListNode<T>>, %order: I64, %value: T):
        #node.values[%order] = %value
        return()

    block internal_set(#node: Ptr<BTreeListNode<T>>, %order: I64, %value: T):
        jump scan(#node, %order, %value, 0)

    block scan(#node: Ptr<BTreeListNode<T>>, %order: I64, %value: T, %i: I64):
        #child: Ptr<BTreeListNode<T>> := #node.children[%i]
        %child_count: I64 = #child.count()
        %in_child: Bool = %order.slt(%child_count)
        %remaining: I64 = %order.sub(%child_count)
        branch %in_child
            ? set_node(#child, %order, %value)
            : scan(#node, %remaining, %value, %i.add(1))

routine BTreeList<T>.push(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        #self.insert(%length, %value)
        return()

routine BTreeListNode<T>.split_child(
        #self: Ptr<Self>, %index: I64, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        #left: Ptr<BTreeListNode<T>> := #self.children[%index]
        %leaf: Bool := #left.leaf
        #right: Ptr<BTreeListNode<T>> = BTreeListNode<T>.new(%leaf, #alloc)
        %length: I64 := #left.length
        %mid: I64 = %length.sdiv(2)
        %right_count: I64 = %length.sub(%mid)
        branch %leaf
            ? copy_values(#left, #right, %mid, %right_count)
            : copy_children(#left, #right, %mid, %right_count)

    block copy_values(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        #right.values.copy(0, #left.values, %mid, %right_count)
        jump promote(#left, #right, %mid, %right_count)

    block copy_children(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        jump child_loop(0, #left, #right, %mid, %right_count)

    block child_loop(
            %i: I64, #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        %done: Bool = %i.sge(%right_count)
        branch %done
            ? promote(#left, #right, %mid, %right_count)
            : child_copy(%i, #left, #right, %mid, %right_count)

    block child_copy(
            %i: I64, #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        %src: I64 = %mid.add(%i)
        #child: Ptr<BTreeListNode<T>> := #left.children[%src]
        #right.children[%i] = #child
        jump child_loop(%i.add(1), #left, #right, %mid, %right_count)

    block promote(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        %parent_length: I64 := #self.length
        jump shift_children(%parent_length, #left, #right, %mid, %right_count)

    block shift_children(
            %i: I64, #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        %stop: I64 = %index.add(1)
        %done: Bool = %i.slt(%stop)
        branch %done
            ? install(#left, #right, %mid, %right_count)
            : move_child(%i, #left, #right, %mid, %right_count)

    block move_child(
            %i: I64, #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        #self.children[%i.add(1)] = #child
        jump shift_children(%i.sub(1), #left, #right, %mid, %right_count)

    block install(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %mid: I64, %right_count: I64):
        #self.children[%index.add(1)] = #right
        #left.length = %mid
        #right.length = %right_count
        %parent_length: I64 := #self.length
        #self.length = %parent_length.add(1)
        #left.recount()
        #right.recount()
        #self.recount()
        return()

; Insert variant: an order equal to the rightmost subtree's count means
; "append at the end of that child", so `remaining == count` keeps us in
; the current child rather than overflowing into a non-existent next one.
routine BTreeListNode<T>.find_child(
        #self: Ptr<Self>, %order: I64, #out_local: Ptr<I64>) -> I64
require T: typename
    block entry():
        jump loop(0, %order)

    block loop(%i: I64, %remaining: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        %count: I64 = #child.count()
        %in_child: Bool = %remaining.sle(%count)
        branch %in_child ? found(%i, %remaining) : loop(%i.add(1), %remaining.sub(%count))

    block found(%i: I64, %remaining: I64):
        #out_local = %remaining
        return(%i)

; Remove variant: order must address an existing element, so `remaining`
; must be strictly less than the child's count — at exact subtree
; boundaries the element belongs to the next sibling, not the trailing
; position of this one.
routine BTreeListNode<T>.find_child_strict(
        #self: Ptr<Self>, %order: I64, #out_local: Ptr<I64>) -> I64
require T: typename
    block entry():
        jump loop(0, %order)

    block loop(%i: I64, %remaining: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        %count: I64 = #child.count()
        %in_child: Bool = %remaining.slt(%count)
        branch %in_child ? found(%i, %remaining) : loop(%i.add(1), %remaining.sub(%count))

    block found(%i: I64, %remaining: I64):
        #out_local = %remaining
        return(%i)

routine BTreeListNode<T>.insert_nonfull(
        #self: Ptr<Self>, %order: I64, %value: T, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? insert_leaf(%order, %value) : insert_internal(%order, %value)

    block insert_leaf(%order: I64, %value: T):
        %length: I64 := #self.length
        #self.values.shift_right(%order, %length)
        #self.values[%order] = %value
        %new_length: I64 = %length.add(1)
        #self.length = %new_length
        #self.subtree_count = %new_length
        return()

    block insert_internal(%order: I64, %value: T):
        #local_order: Ptr<I64> = alloca<I64>
        %slot: I64 = #self.find_child(%order, #local_order)
        %local_order: I64 := #local_order
        #child: Ptr<BTreeListNode<T>> := #self.children[%slot]
        %child_length: I64 := #child.length
        %full: Bool = %child_length.eq(NODE_VALUES)
        branch %full
            ? split_then_insert(%slot, %local_order, %value)
            : descend(%slot, #child, %local_order, %value)

    block split_then_insert(%slot: I64, %local_order: I64, %value: T):
        #self.split_child(%slot, #alloc)
        #left: Ptr<BTreeListNode<T>> := #self.children[%slot]
        %left_count: I64 = #left.count()
        %go_right: Bool = %local_order.sgt(%left_count)
        branch %go_right
            ? descend_right(%slot, %local_order, %left_count, %value)
            : descend_left(%slot, %local_order, %value)

    block descend_left(%slot: I64, %local_order: I64, %value: T):
        #child: Ptr<BTreeListNode<T>> := #self.children[%slot]
        jump descend(%slot, #child, %local_order, %value)

    block descend_right(%slot: I64, %local_order: I64, %left_count: I64, %value: T):
        %right_slot: I64 = %slot.add(1)
        %right_order: I64 = %local_order.sub(%left_count)
        #child: Ptr<BTreeListNode<T>> := #self.children[%right_slot]
        jump descend(%right_slot, #child, %right_order, %value)

    block descend(%slot: I64, #child: Ptr<BTreeListNode<T>>, %local_order: I64, %value: T):
        #child.insert_nonfull(%local_order, %value, #alloc)
        #self.recount()
        return()

routine BTreeList<T>.insert(#self: Ptr<Self>, %order: I64, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %order.sge(0).bitand(%order.sle(%length))
        branch %in_bounds ? insert_checked(%order, %value) : panic(TrapCode.Bounds)

    block insert_checked(%order: I64, %value: T):
        #alloc: Ptr<Allocator> := #self.alloc
        #root: Ptr<BTreeListNode<T>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? first_root(%value, #alloc) : insert_root(#root, %order, %value, #alloc)

    block first_root(%value: T, #alloc: Ptr<Allocator>):
        #root: Ptr<BTreeListNode<T>> = BTreeListNode<T>.new(true, #alloc)
        #root.values[0] = %value
        #root.length = 1
        #root.subtree_count = 1
        #self.root = #root
        #self.length = 1
        return()

    block insert_root(#root: Ptr<BTreeListNode<T>>, %order: I64, %value: T, #alloc: Ptr<Allocator>):
        %root_length: I64 := #root.length
        %full: Bool = %root_length.eq(NODE_VALUES)
        branch %full
            ? split_root(#root, %order, %value, #alloc)
            : insert_nonfull(#root, %order, %value, #alloc)

    block split_root(
            #old_root: Ptr<BTreeListNode<T>>, %order: I64, %value: T, #alloc: Ptr<Allocator>):
        #new_root: Ptr<BTreeListNode<T>> = BTreeListNode<T>.new(false, #alloc)
        #new_root.children[0] = #old_root
        #new_root.length = 1
        #self.root = #new_root
        #new_root.split_child(0, #alloc)
        jump insert_nonfull(#new_root, %order, %value, #alloc)

    block insert_nonfull(
            #root: Ptr<BTreeListNode<T>>, %order: I64, %value: T, #alloc: Ptr<Allocator>):
        #root.insert_nonfull(%order, %value, #alloc)
        %length: I64 := #self.length
        #self.length = %length.add(1)
        return()

; Capacity = NODE_VALUES, t = NODE_MIN. Internal-node `length` is the
; child count, so the underflow threshold (length < NODE_MIN) is shared
; with leaves. Helpers below ensure a child has length >= NODE_MIN before
; any deletion descent.

routine BTreeListNode<T>.borrow_from_left(#self: Ptr<Self>, %i: I64) -> Void
require T: typename
    block entry():
        #left: Ptr<BTreeListNode<T>> := #self.children[%i.sub(1)]
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        %left_length: I64 := #left.length
        %child_length: I64 := #child.length
        %leaf: Bool := #child.leaf
        branch %leaf
            ? leaf_borrow(#left, #child, %left_length, %child_length)
            : internal_borrow(#left, #child, %left_length, %child_length)

    block leaf_borrow(
            #left: Ptr<BTreeListNode<T>>, #child: Ptr<BTreeListNode<T>>,
            %left_length: I64, %child_length: I64):
        #child.values.shift_right(0, %child_length)
        %v: T := #left.values[%left_length.sub(1)]
        #child.values[0] = %v
        jump finalize(#left, #child, %left_length, %child_length)

    block internal_borrow(
            #left: Ptr<BTreeListNode<T>>, #child: Ptr<BTreeListNode<T>>,
            %left_length: I64, %child_length: I64):
        #child.children.shift_right(0, %child_length)
        #moved: Ptr<BTreeListNode<T>> := #left.children[%left_length.sub(1)]
        #child.children[0] = #moved
        jump finalize(#left, #child, %left_length, %child_length)

    block finalize(
            #left: Ptr<BTreeListNode<T>>, #child: Ptr<BTreeListNode<T>>,
            %left_length: I64, %child_length: I64):
        #left.length = %left_length.sub(1)
        #child.length = %child_length.add(1)
        #left.recount()
        #child.recount()
        #self.recount()
        return()

routine BTreeListNode<T>.borrow_from_right(#self: Ptr<Self>, %i: I64) -> Void
require T: typename
    block entry():
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        #right: Ptr<BTreeListNode<T>> := #self.children[%i.add(1)]
        %child_length: I64 := #child.length
        %right_length: I64 := #right.length
        %leaf: Bool := #child.leaf
        branch %leaf
            ? leaf_borrow(#child, #right, %child_length, %right_length)
            : internal_borrow(#child, #right, %child_length, %right_length)

    block leaf_borrow(
            #child: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %child_length: I64, %right_length: I64):
        %v: T := #right.values[0]
        #child.values[%child_length] = %v
        #right.values.shift_left(0, %right_length)
        jump finalize(#child, #right, %child_length, %right_length)

    block internal_borrow(
            #child: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %child_length: I64, %right_length: I64):
        #moved: Ptr<BTreeListNode<T>> := #right.children[0]
        #child.children[%child_length] = #moved
        #right.children.shift_left(0, %right_length)
        jump finalize(#child, #right, %child_length, %right_length)

    block finalize(
            #child: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %child_length: I64, %right_length: I64):
        #child.length = %child_length.add(1)
        #right.length = %right_length.sub(1)
        #child.recount()
        #right.recount()
        #self.recount()
        return()

routine BTreeListNode<T>.merge_children(
        #self: Ptr<Self>, %i: I64, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        #left: Ptr<BTreeListNode<T>> := #self.children[%i]
        #right: Ptr<BTreeListNode<T>> := #self.children[%i.add(1)]
        %left_length: I64 := #left.length
        %right_length: I64 := #right.length
        %leaf: Bool := #left.leaf
        branch %leaf
            ? leaf_merge(#left, #right, %left_length, %right_length)
            : internal_merge(#left, #right, %left_length, %right_length)

    block leaf_merge(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %left_length: I64, %right_length: I64):
        #left.values.copy(%left_length, #right.values, 0, %right_length)
        jump finalize(#left, #right, %left_length, %right_length)

    block internal_merge(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %left_length: I64, %right_length: I64):
        #left.children.copy(%left_length, #right.children, 0, %right_length)
        jump finalize(#left, #right, %left_length, %right_length)

    block finalize(
            #left: Ptr<BTreeListNode<T>>, #right: Ptr<BTreeListNode<T>>,
            %left_length: I64, %right_length: I64):
        #left.length = %left_length.add(%right_length)
        %parent_length: I64 := #self.length
        #self.children.shift_left(%i.add(1), %parent_length)
        #self.length = %parent_length.sub(1)
        free<BTreeListNode<T>>(#alloc, #right)
        #left.recount()
        #self.recount()
        return()

; remove descends with rebalancing inlined: when a borrow or merge fires the
; local order index has to be adjusted to account for the entries that moved
; into (or out of) the descent target, so we cannot factor out a generic
; ensure_min the way the keyed B-tree variants do.
routine BTreeListNode<T>.remove(
        #self: Ptr<Self>, %order: I64, #alloc: Ptr<Allocator>) -> T
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? remove_leaf(%order) : remove_internal(%order)

    block remove_leaf(%order: I64):
        %value: T := #self.values[%order]
        %length: I64 := #self.length
        #self.values.shift_left(%order, %length)
        %new_length: I64 = %length.sub(1)
        #self.length = %new_length
        #self.subtree_count = %new_length
        return(%value)

    block remove_internal(%order: I64):
        #local_order_Ptr: Ptr<I64> = alloca<I64>
        %slot: I64 = #self.find_child_strict(%order, #local_order_Ptr)
        %local_order: I64 := #local_order_Ptr
        #child: Ptr<BTreeListNode<T>> := #self.children[%slot]
        %child_length: I64 := #child.length
        %ok: Bool = %child_length.sge(NODE_MIN)
        branch %ok ? descend(%slot, %local_order) : rebalance(%slot, %local_order)

    block descend(%slot: I64, %local_order: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%slot]
        %value: T = #child.remove(%local_order, #alloc)
        #self.recount()
        return(%value)

    block rebalance(%slot: I64, %local_order: I64):
        %has_left: Bool = %slot.sgt(0)
        branch %has_left ? check_left(%slot, %local_order) : right_only(%slot, %local_order)

    block check_left(%slot: I64, %local_order: I64):
        #left: Ptr<BTreeListNode<T>> := #self.children[%slot.sub(1)]
        %left_length: I64 := #left.length
        %left_ok: Bool = %left_length.sge(NODE_MIN)
        branch %left_ok ? do_borrow_left(%slot, %local_order) : right_with_left(%slot, %local_order)

    ; Borrow/merge change the descent target's leading subtree_count, so we
    ; diff #child.count() (= subtree_count) across the operation to recover
    ; the local-order offset. This works uniformly for leaves (where each
    ; moved value contributes 1) and internals (where the moved entry is a
    ; whole child subtree of arbitrary count).
    block do_borrow_left(%slot: I64, %local_order: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%slot]
        %old_count: I64 = #child.count()
        #self.borrow_from_left(%slot)
        %new_local: I64 = %local_order.add(#child.count().sub(%old_count))
        jump descend(%slot, %new_local)

    block right_with_left(%slot: I64, %local_order: I64):
        %parent_length: I64 := #self.length
        %has_right: Bool = %slot.add(1).slt(%parent_length)
        branch %has_right
            ? check_right_after_left(%slot, %local_order)
            : do_merge_left(%slot, %local_order)

    block check_right_after_left(%slot: I64, %local_order: I64):
        #right: Ptr<BTreeListNode<T>> := #self.children[%slot.add(1)]
        %right_length: I64 := #right.length
        %right_ok: Bool = %right_length.sge(NODE_MIN)
        branch %right_ok ? do_borrow_right(%slot, %local_order) : do_merge_left(%slot, %local_order)

    block do_borrow_right(%slot: I64, %local_order: I64):
        #self.borrow_from_right(%slot)
        jump descend(%slot, %local_order)

    block do_merge_left(%slot: I64, %local_order: I64):
        %slot_m1: I64 = %slot.sub(1)
        #left: Ptr<BTreeListNode<T>> := #self.children[%slot_m1]
        %new_local: I64 = #left.count().add(%local_order)
        #self.merge_children(%slot_m1, #alloc)
        jump descend(%slot.sub(1), %new_local)

    block right_only(%slot: I64, %local_order: I64):
        %parent_length: I64 := #self.length
        %has_right: Bool = %slot.add(1).slt(%parent_length)
        branch %has_right ? check_right_only(%slot, %local_order) : panic(TrapCode.Unreachable)

    block check_right_only(%slot: I64, %local_order: I64):
        #right: Ptr<BTreeListNode<T>> := #self.children[%slot.add(1)]
        %right_length: I64 := #right.length
        %right_ok: Bool = %right_length.sge(NODE_MIN)
        branch %right_ok
            ? do_borrow_right(%slot, %local_order)
            : do_merge_right(%slot, %local_order)

    block do_merge_right(%slot: I64, %local_order: I64):
        #self.merge_children(%slot, #alloc)
        jump descend(%slot, %local_order)

routine BTreeList<T>.remove(#self: Ptr<Self>, %order: I64) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %order.sge(0).bitand(%order.slt(%length))
        branch %in_bounds ? remove_root(%order) : panic(TrapCode.Bounds)

    block remove_root(%order: I64):
        #alloc: Ptr<Allocator> := #self.alloc
        #root: Ptr<BTreeListNode<T>> := #self.root
        %value: T = #root.remove(%order, #alloc)
        %length: I64 := #self.length
        #self.length = %length.sub(1)
        %leaf: Bool := #root.leaf
        branch %leaf ? maybe_clear(#root, %value) : maybe_shrink(#root, %value)

    block maybe_clear(#root: Ptr<BTreeListNode<T>>, %value: T):
        %root_length: I64 := #root.length
        %empty: Bool = %root_length.eq(0)
        branch %empty ? clear_root(#root, %value) : return(%value)

    block maybe_shrink(#root: Ptr<BTreeListNode<T>>, %value: T):
        %root_length: I64 := #root.length
        %only_one: Bool = %root_length.eq(1)
        branch %only_one ? shrink(#root, %value) : return(%value)

    block clear_root(#root: Ptr<BTreeListNode<T>>, %value: T):
        #alloc: Ptr<Allocator> := #self.alloc
        free<BTreeListNode<T>>(#alloc, #root)
        #self.root = null
        return(%value)

    block shrink(#root: Ptr<BTreeListNode<T>>, %value: T):
        #alloc: Ptr<Allocator> := #self.alloc
        #new_root: Ptr<BTreeListNode<T>> := #root.children[0]
        free<BTreeListNode<T>>(#alloc, #root)
        #self.root = #new_root
        return(%value)

; Internal nodes use `length` as the child count (indices 0..length-1).
routine BTreeListNode<T>.free_recursive(
        #self: Ptr<Self>, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? free_self() : free_children()

    block free_children():
        %length: I64 := #self.length
        jump child_loop(0, %length)

    block child_loop(%i: I64, %length: I64):
        %done: Bool = %i.sge(%length)
        branch %done ? free_self() : free_child(%i, %length)

    block free_child(%i: I64, %length: I64):
        #child: Ptr<BTreeListNode<T>> := #self.children[%i]
        #child.free_recursive(#alloc)
        jump child_loop(%i.add(1), %length)

    block free_self():
        free<BTreeListNode<T>>(#alloc, #self)
        return()

routine BTreeList<T>.free(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #root: Ptr<BTreeListNode<T>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? reset() : free_root(#root)

    block free_root(#root: Ptr<BTreeListNode<T>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #root.free_recursive(#alloc)
        jump reset()

    block reset():
        #self.root = null
        #self.length = 0
        return()
