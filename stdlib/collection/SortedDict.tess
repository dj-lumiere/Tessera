// Tessera stdlib collection: SortedDict<K, V>
//
// Order-statistic B-tree map with a fixed node key capacity of NODE_KEYS.
// Nodes store keys/values/children inline with fixed arrays.
// The allocator is stored in SortedDict; node helpers still receive it as a parameter.

private preset NODE_KEYS: U64 = 7
private preset NODE_CHILDREN: U64 = 8
private preset NODE_MIN_KEYS: U64 = 4

record SortedDictNode<K, V>
require K: typename, V: typename
    leaf: Bool
    length: U64
    subtree_count: U64
    keys: Array<K, NODE_KEYS>
    values: Array<V, NODE_KEYS>
    children: Array<Ptr<SortedDictNode<K, V>>, NODE_CHILDREN>

record SortedDict<K, V>
require K: typename, V: typename, Compare<K>
    root: Ptr<SortedDictNode<K, V>>
    length: U64
    alloc: Ptr<Allocator>

routine SortedDict<K, V>.new(#alloc: Ptr<Allocator>) -> Self
require K: typename, V: typename, Compare<K>
    block entry():
        %map: Self = Self {
            root: null,
            length: 0,
            alloc: #alloc
        }
        return(%map)

routine SortedDict<K, V>.length(#self: Ptr<Self>) -> U64
require K: typename, V: typename
    block entry():
        %length: U64 := #self.length
        return(%length)

routine SortedDict<K, V>.is_empty(#self: Ptr<Self>) -> Bool
require K: typename, V: typename
    block entry():
        %length: U64 := #self.length
        %empty: Bool = %length.eq(0)
        return(%empty)

routine SortedDictNode<K, V>.new(%leaf: Bool, #alloc: Ptr<Allocator>) -> Ptr<SortedDictNode<K, V>>
require K: typename, V: typename
    block entry():
        #node: Ptr<SortedDictNode<K, V>> = alloc<SortedDictNode<K, V>>(#alloc, 1)
        %failed: Bool = #node.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : init(#node, %leaf)

    block init(#node: Ptr<SortedDictNode<K, V>>, %leaf: Bool):
        #node.leaf = %leaf
        #node.length = 0
        #node.subtree_count = 0
        return(#node)

routine SortedDictNode<K, V>.count(#self: Ptr<Self>) -> U64
require K: typename, V: typename
    block entry():
        %empty: Bool = #self.is_null()
        branch %empty ? return(0) : count(#self)

    block count(#self: Ptr<Self>):
        %count: U64 := #self.subtree_count
        return(%count)

routine SortedDictNode<K, V>.recount(#self: Ptr<Self>) -> Void
require K: typename, V: typename
    block entry():
        %leaf: Bool := #self.leaf
        %length: U64 := #self.length
        branch %leaf ? leaf_count(%length) : internal_count(%length)

    block leaf_count(%length: U64):
        #self.subtree_count = %length
        return()

    block internal_count(%length: U64):
        jump loop(0, 0, %length)

    block loop(%i: U64, %sum: U64, %length: U64):
        %done: Bool = %i.gt(%length)
        branch %done ? finish(%sum) : add_child(%i, %sum, %length)

    block add_child(%i: U64, %sum: U64, %length: U64):
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        %child_count: U64 = #child.count()
        %with_child: U64 = %sum.add(%child_count)
        %has_key: Bool = %i.lt(%length)
        %with_child_p1: U64 = %with_child.add(1)
        %next_sum: U64 = %has_key ? %with_child_p1 : %with_child
        jump loop(%i.add(1), %next_sum, %length)

    block finish(%sum: U64):
        #self.subtree_count = %sum
        return()

routine SortedDict<K, V>.find_index(
        #self: Ptr<Self>, #node: Ptr<SortedDictNode<K, V>>, %key: K) -> U64
require K: typename, V: typename
    block entry():
        jump loop(0)

    block loop(%i: U64):
        %length: U64 := #node.length
        %done: Bool = %i.ge(%length)
        branch %done ? return(%i) : compare(%i)

    block compare(%i: U64):
        %node_key: K := #node.keys[%i]
        %cmp: S32 = %key.compare(%node_key)
        %before_or_equal: Bool = %cmp.le(0)
        branch %before_or_equal ? return(%i) : loop(%i.add(1))

routine SortedDict<K, V>.get(#self: Ptr<Self>, %key: K) -> V
require K: typename, V: typename
    block entry():
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? panic(TrapCode.MissingKey) : search(#root, %key)

    block search(#node: Ptr<SortedDictNode<K, V>>, %key: K):
        %i: U64 = #self.find_index(#node, %key)
        %length: U64 := #node.length
        %inside: Bool = %i.lt(%length)
        branch %inside ? maybe_match(#node, %i, %key) : descend_or_missing(#node, %i, %key)

    block maybe_match(#node: Ptr<SortedDictNode<K, V>>, %i: U64, %key: K):
        %node_key: K := #node.keys[%i]
        %cmp: S32 = %key.compare(%node_key)
        %equal: Bool = %cmp.eq(0)
        branch %equal ? load(#node, %i) : descend_or_missing(#node, %i, %key)

    block descend_or_missing(#node: Ptr<SortedDictNode<K, V>>, %i: U64, %key: K):
        %leaf: Bool := #node.leaf
        branch %leaf ? panic(TrapCode.MissingKey) : descend(#node, %i, %key)

    block descend(#node: Ptr<SortedDictNode<K, V>>, %i: U64, %key: K):
        #child: Ptr<SortedDictNode<K, V>> := #node.children[%i]
        jump search(#child, %key)

    block load(#node: Ptr<SortedDictNode<K, V>>, %i: U64):
        %value: V := #node.values[%i]
        return(%value)

/// SortedDicts are sorted by key, so structural in-order comparison of both
/// keys and values gives map equality.
routine SortedDict<K, V>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require K: typename, V: typename, Compare<K>, Equal<V>
    block entry():
        %la: U64 := #self.length
        %lb: U64 := #other.length
        %same_len: Bool = %la.eq(%lb)
        branch %same_len ? loop(0, %la) : return(false)

    block loop(%i: U64, %len: U64):
        %done: Bool = %i.ge(%len)
        branch %done ? return(true) : step(%i, %len)

    block step(%i: U64, %len: U64):
        %ka: K = #self.key_order(%i)
        %kb: K = #other.key_order(%i)
        %cmp: S32 = %ka.compare(%kb)
        %k_eq: Bool = %cmp.eq(0)
        branch %k_eq ? compare_value(%i, %len) : return(false)

    block compare_value(%i: U64, %len: U64):
        %va: V = #self.get_order(%i)
        %vb: V = #other.get_order(%i)
        %v_eq: Bool = %va.eq(%vb)
        branch %v_eq ? loop(%i.add(1), %len) : return(false)

routine SortedDict<K, V>.contains(#self: Ptr<Self>, %key: K) -> Bool
require K: typename, V: typename
    block entry():
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? return(false) : search(#root, %key)

    block search(#node: Ptr<SortedDictNode<K, V>>, %key: K):
        %i: U64 = #self.find_index(#node, %key)
        %length: U64 := #node.length
        %inside: Bool = %i.lt(%length)
        branch %inside ? maybe_match(#node, %i, %key) : descend_or_missing(#node, %i, %key)

    block maybe_match(#node: Ptr<SortedDictNode<K, V>>, %i: U64, %key: K):
        %node_key: K := #node.keys[%i]
        %cmp: S32 = %key.compare(%node_key)
        %equal: Bool = %cmp.eq(0)
        branch %equal ? return(true) : descend_or_missing(#node, %i, %key)

    block descend_or_missing(#node: Ptr<SortedDictNode<K, V>>, %i: U64, %key: K):
        %leaf: Bool := #node.leaf
        branch %leaf ? return(false) : descend(#node, %i, %key)

    block descend(#node: Ptr<SortedDictNode<K, V>>, %i: U64, %key: K):
        #child: Ptr<SortedDictNode<K, V>> := #node.children[%i]
        jump search(#child, %key)

routine SortedDict<K, V>.get_order(#self: Ptr<Self>, %order: U64) -> V
require K: typename, V: typename
    block entry():
        %length: U64 := #self.length
        %in_bounds: Bool = %order.lt(%length)
        branch %in_bounds ? select_root(%order) : panic(TrapCode.Bounds)

    block select_root(%order: U64):
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        jump select_node(#root, %order)

    block select_node(#node: Ptr<SortedDictNode<K, V>>, %order: U64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %length: U64 := #node.length
        %done: Bool = %i.ge(%length)
        branch %done ? last_child(#node, %order, %i) : check_child(#node, %order, %i)

    block check_child(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %leaf: Bool := #node.leaf
        branch %leaf ? leaf_key(#node, %order, %i) : internal_child(#node, %order, %i)

    block leaf_key(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %match: Bool = %order.eq(%i)
        branch %match ? load_order(#node, %i) : scan(#node, %order, %i.add(1))

    block internal_child(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        #child: Ptr<SortedDictNode<K, V>> := #node.children[%i]
        %child_count: U64 = #child.count()
        %in_child: Bool = %order.lt(%child_count)
        branch %in_child ? select_node(#child, %order) : check_key(#node, %order, %i, %child_count)

    block check_key(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64, %child_count: U64):
        %after_child: U64 = %order.sub(%child_count)
        %is_key: Bool = %after_child.eq(0)
        branch %is_key ? load_order(#node, %i) : scan(#node, %after_child.sub(1), %i.add(1))

    block last_child(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %leaf: Bool := #node.leaf
        branch %leaf ? panic(TrapCode.Unreachable) : descend_last(#node, %order, %i)

    block descend_last(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        #child: Ptr<SortedDictNode<K, V>> := #node.children[%i]
        jump select_node(#child, %order)

    block load_order(#node: Ptr<SortedDictNode<K, V>>, %i: U64):
        %value: V := #node.values[%i]
        return(%value)

routine SortedDict<K, V>.key_order(#self: Ptr<Self>, %order: U64) -> K
require K: typename, V: typename
    block entry():
        %length: U64 := #self.length
        %in_bounds: Bool = %order.lt(%length)
        branch %in_bounds ? select_root(%order) : panic(TrapCode.Bounds)

    block select_root(%order: U64):
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        jump select_node(#root, %order)

    block select_node(#node: Ptr<SortedDictNode<K, V>>, %order: U64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %length: U64 := #node.length
        %done: Bool = %i.ge(%length)
        branch %done ? last_child(#node, %order, %i) : check_child(#node, %order, %i)

    block check_child(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %leaf: Bool := #node.leaf
        branch %leaf ? leaf_key(#node, %order, %i) : internal_child(#node, %order, %i)

    block leaf_key(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %match: Bool = %order.eq(%i)
        branch %match ? load_key(#node, %i) : scan(#node, %order, %i.add(1))

    block internal_child(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        #child: Ptr<SortedDictNode<K, V>> := #node.children[%i]
        %child_count: U64 = #child.count()
        %in_child: Bool = %order.lt(%child_count)
        branch %in_child ? select_node(#child, %order) : check_key(#node, %order, %i, %child_count)

    block check_key(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64, %child_count: U64):
        %after_child: U64 = %order.sub(%child_count)
        %is_key: Bool = %after_child.eq(0)
        branch %is_key ? load_key(#node, %i) : scan(#node, %after_child.sub(1), %i.add(1))

    block last_child(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        %leaf: Bool := #node.leaf
        branch %leaf ? panic(TrapCode.Unreachable) : descend_last(#node, %order, %i)

    block descend_last(#node: Ptr<SortedDictNode<K, V>>, %order: U64, %i: U64):
        #child: Ptr<SortedDictNode<K, V>> := #node.children[%i]
        jump select_node(#child, %order)

    block load_key(#node: Ptr<SortedDictNode<K, V>>, %i: U64):
        %key: K := #node.keys[%i]
        return(%key)

routine SortedDictNode<K, V>.split_child(
        #self: Ptr<Self>, %index: U64, #alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        #left: Ptr<SortedDictNode<K, V>> := #self.children[%index]
        %leaf: Bool := #left.leaf
        #right: Ptr<SortedDictNode<K, V>> = SortedDictNode<K, V>.new(%leaf, #alloc)
        %mid: U64 = NODE_KEYS.div(2)
        %node_keys_m_mid: U64 = NODE_KEYS.sub(%mid)
        %right_count: U64 = %node_keys_m_mid.sub(1)
        %mid_p1: U64 = %mid.add(1)
        #right.keys.copy(0, #left.keys, %mid_p1, %right_count)
        #right.values.copy(0, #left.values, %mid_p1, %right_count)
        #right.length = %right_count
        branch %leaf
            ? promote(#left, #right, %mid)
            : copy_children(#left, #right, %mid, %right_count)

    block copy_children(
            #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %mid: U64, %right_count: U64):
        jump child_loop(0, #left, #right, %mid, %right_count)

    block child_loop(
            %i: U64, #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %mid: U64, %right_count: U64):
        %done: Bool = %i.gt(%right_count)
        branch %done
            ? promote(#left, #right, %mid)
            : child_copy(%i, #left, #right, %mid, %right_count)

    block child_copy(
            %i: U64, #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %mid: U64, %right_count: U64):
        %src: U64 = %mid.add(1).add(%i)
        #child: Ptr<SortedDictNode<K, V>> := #left.children[%src]
        #right.children[%i] = #child
        jump child_loop(%i.add(1), #left, #right, %mid, %right_count)

    block promote(
            #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>, %mid: U64):
        %parent_length: U64 := #self.length
        #self.keys.shift_right(%index, %parent_length)
        #self.values.shift_right(%index, %parent_length)
        jump shift_children(%parent_length, #left, #right, %mid)

    block shift_children(
            %i: U64, #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %mid: U64):
        %stop: U64 = %index.add(1)
        %done: Bool = %i.lt(%stop)
        branch %done ? install(#left, #right, %mid) : move_child(%i, #left, #right, %mid)

    block move_child(
            %i: U64, #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %mid: U64):
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        #self.children[%i.add(1)] = #child
        jump shift_children(%i.sub(1), #left, #right, %mid)

    block install(
            #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>, %mid: U64):
        %middle_key: K := #left.keys[%mid]
        %middle_value: V := #left.values[%mid]
        #self.keys[%index] = %middle_key
        #self.values[%index] = %middle_value
        %index_p1: U64 = %index.add(1)
        #self.children[%index_p1] = #right
        #left.length = %mid
        %parent_length: U64 := #self.length
        #self.length = %parent_length.add(1)
        #left.recount()
        #right.recount()
        #self.recount()
        return()

routine SortedDictNode<K, V>.insert_nonfull(
        #self: Ptr<Self>, #map: Ptr<SortedDict<K, V>>,
        %key: K, %value: V, #alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? insert_leaf() : insert_internal()

    block insert_leaf():
        %slot: U64 = #map.find_index(#self, %key)
        %length: U64 := #self.length
        #self.keys.shift_right(%slot, %length)
        #self.values.shift_right(%slot, %length)
        #self.keys[%slot] = %key
        #self.values[%slot] = %value
        %new_length: U64 = %length.add(1)
        #self.length = %new_length
        #self.subtree_count = %new_length
        return()

    block insert_internal():
        %slot: U64 = #map.find_index(#self, %key)
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%slot]
        %child_length: U64 := #child.length
        %full: Bool = %child_length.eq(NODE_KEYS)
        branch %full ? split_then_insert(%slot, #child) : descend(%slot, #child)

    block split_then_insert(%slot: U64, #child: Ptr<SortedDictNode<K, V>>):
        #self.split_child(%slot, #alloc)
        %pivot: K := #self.keys[%slot]
        %cmp: S32 = %key.compare(%pivot)
        %go_right: Bool = %cmp.gt(0)
        %slot_p1: U64 = %slot.add(1)
        %next_slot: U64 = %go_right ? %slot_p1 : %slot
        #next_child: Ptr<SortedDictNode<K, V>> := #self.children[%next_slot]
        jump descend(%next_slot, #next_child)

    block descend(%slot: U64, #child: Ptr<SortedDictNode<K, V>>):
        #child.insert_nonfull(#map, %key, %value, #alloc)
        #self.recount()
        return()

routine SortedDict<K, V>.put(#self: Ptr<Self>, %key: K, %value: V) -> Void
require K: typename, V: typename
    block entry():
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? first_root() : maybe_replace(#root)

    block first_root():
        #alloc: Ptr<Allocator> := #self.alloc
        #root: Ptr<SortedDictNode<K, V>> = SortedDictNode<K, V>.new(true, #alloc)
        #root.keys[0] = %key
        #root.values[0] = %value
        #root.length = 1
        #root.subtree_count = 1
        #self.root = #root
        #self.length = 1
        return()

    block maybe_replace(#root: Ptr<SortedDictNode<K, V>>):
        %replaced: Bool = #root.replace(#self, %key, %value)
        branch %replaced ? return() : insert_root(#root)

    block insert_root(#root: Ptr<SortedDictNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        %root_length: U64 := #root.length
        %full: Bool = %root_length.eq(NODE_KEYS)
        branch %full ? split_root(#root, #alloc) : insert_nonfull(#root, #alloc)

    block split_root(#old_root: Ptr<SortedDictNode<K, V>>, #alloc: Ptr<Allocator>):
        #new_root: Ptr<SortedDictNode<K, V>> = SortedDictNode<K, V>.new(false, #alloc)
        #new_root.children[0] = #old_root
        #self.root = #new_root
        #new_root.split_child(0, #alloc)
        jump insert_nonfull(#new_root, #alloc)

    block insert_nonfull(#root: Ptr<SortedDictNode<K, V>>, #alloc: Ptr<Allocator>):
        #root.insert_nonfull(#self, %key, %value, #alloc)
        %length: U64 := #self.length
        #self.length = %length.add(1)
        return()

routine SortedDictNode<K, V>.replace(
        #self: Ptr<Self>, #map: Ptr<SortedDict<K, V>>,
        %key: K, %value: V) -> Bool
require K: typename, V: typename
    block entry():
        %slot: U64 = #map.find_index(#self, %key)
        %length: U64 := #self.length
        %inside: Bool = %slot.lt(%length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: U64):
        %node_key: K := #self.keys[%slot]
        %cmp: S32 = %key.compare(%node_key)
        %equal: Bool = %cmp.eq(0)
        branch %equal ? replace(%slot) : descend_or_missing(%slot)

    block replace(%slot: U64):
        #self.values[%slot] = %value
        return(true)

    block descend_or_missing(%slot: U64):
        %leaf: Bool := #self.leaf
        branch %leaf ? return(false): descend(%slot)

    block descend(%slot: U64):
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%slot]
        %replaced: Bool = #child.replace(#map, %key, %value)
        return(%replaced)

routine SortedDictNode<K, V>.remove_leaf_at(#self: Ptr<Self>, %index: U64) -> V
require K: typename, V: typename
    block entry():
        %old: V := #self.values[%index]
        %length: U64 := #self.length
        #self.keys.shift_left(%index, %length)
        #self.values.shift_left(%index, %length)
        %new_length: U64 = %length.sub(1)
        #self.length = %new_length
        #self.subtree_count = %new_length
        return(%old)

// Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
// length >= NODE_MIN_KEYS - 1.
// Helpers below ensure a child has length >= 4 (= t) before any deletion
// descent so the child can absorb a one-key drop without underflowing.

routine SortedDictNode<K, V>.borrow_from_left(#self: Ptr<Self>, %i: U64) -> Void
require K: typename, V: typename
    block entry():
        %i_m1: U64 = %i.sub(1)
        #left: Ptr<SortedDictNode<K, V>> := #self.children[%i_m1]
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        %left_length: U64 := #left.length
        %child_length: U64 := #child.length
        #child.keys.shift_right(0, %child_length)
        #child.values.shift_right(0, %child_length)
        %pivot_key: K := #self.keys[%i_m1]
        %pivot_value: V := #self.values[%i_m1]
        #child.keys[0] = %pivot_key
        #child.values[0] = %pivot_value
        %new_pivot_key: K := #left.keys[%left_length.sub(1)]
        %new_pivot_value: V := #left.values[%left_length.sub(1)]
        #self.keys[%i_m1] = %new_pivot_key
        #self.values[%i_m1] = %new_pivot_value
        %leaf: Bool := #child.leaf
        branch %leaf
            ? finalize(#left, #child, %left_length, %child_length)
            : move_child(#left, #child, %left_length, %child_length)

    block move_child(
            #left: Ptr<SortedDictNode<K, V>>, #child: Ptr<SortedDictNode<K, V>>,
            %left_length: U64, %child_length: U64):
        %child_count: U64 = %child_length.add(1)
        #child.children.shift_right(0, %child_count)
        #moved: Ptr<SortedDictNode<K, V>> := #left.children[%left_length]
        #child.children[0] = #moved
        jump finalize(#left, #child, %left_length, %child_length)

    block finalize(
            #left: Ptr<SortedDictNode<K, V>>, #child: Ptr<SortedDictNode<K, V>>,
            %left_length: U64, %child_length: U64):
        #left.length = %left_length.sub(1)
        #child.length = %child_length.add(1)
        #left.recount()
        #child.recount()
        #self.recount()
        return()

routine SortedDictNode<K, V>.borrow_from_right(#self: Ptr<Self>, %i: U64) -> Void
require K: typename, V: typename
    block entry():
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        #right: Ptr<SortedDictNode<K, V>> := #self.children[%i.add(1)]
        %child_length: U64 := #child.length
        %right_length: U64 := #right.length
        %pivot_key: K := #self.keys[%i]
        %pivot_value: V := #self.values[%i]
        #child.keys[%child_length] = %pivot_key
        #child.values[%child_length] = %pivot_value
        %new_pivot_key: K := #right.keys[0]
        %new_pivot_value: V := #right.values[0]
        #self.keys[%i] = %new_pivot_key
        #self.values[%i] = %new_pivot_value
        #right.keys.shift_left(0, %right_length)
        #right.values.shift_left(0, %right_length)
        %leaf: Bool := #child.leaf
        branch %leaf
            ? finalize(#child, #right, %child_length, %right_length)
            : move_child(#child, #right, %child_length, %right_length)

    block move_child(
            #child: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %child_length: U64, %right_length: U64):
        #moved: Ptr<SortedDictNode<K, V>> := #right.children[0]
        #child.children[%child_length.add(1)] = #moved
        #right.children.shift_left(0, %right_length.add(1))
        jump finalize(#child, #right, %child_length, %right_length)

    block finalize(
            #child: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %child_length: U64, %right_length: U64):
        #child.length = %child_length.add(1)
        #right.length = %right_length.sub(1)
        #child.recount()
        #right.recount()
        #self.recount()
        return()

routine SortedDictNode<K, V>.merge_children(
        #self: Ptr<Self>, %i: U64, #alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %i_p1: U64 = %i.add(1)
        #left: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        #right: Ptr<SortedDictNode<K, V>> := #self.children[%i_p1]
        %left_length: U64 := #left.length
        %right_length: U64 := #right.length
        %pivot_key: K := #self.keys[%i]
        %pivot_value: V := #self.values[%i]
        #left.keys[%left_length] = %pivot_key
        #left.values[%left_length] = %pivot_value
        %dst_start: U64 = %left_length.add(1)
        #left.keys.copy(%dst_start, #right.keys, 0, %right_length)
        #left.values.copy(%dst_start, #right.values, 0, %right_length)
        %leaf: Bool := #left.leaf
        branch %leaf
            ? finalize(#left, #right, %left_length, %right_length)
            : copy_children(#left, #right, %left_length, %right_length)

    block copy_children(
            #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %left_length: U64, %right_length: U64):
        #left.children.copy(%left_length.add(1), #right.children, 0, %right_length.add(1))
        jump finalize(#left, #right, %left_length, %right_length)

    block finalize(
            #left: Ptr<SortedDictNode<K, V>>, #right: Ptr<SortedDictNode<K, V>>,
            %left_length: U64, %right_length: U64):
        #left.length = %left_length.add(1).add(%right_length)
        %parent_length: U64 := #self.length
        #self.keys.shift_left(%i, %parent_length)
        #self.values.shift_left(%i, %parent_length)
        %i_p1: U64 = %i.add(1)
        #self.children.shift_left(%i_p1, %parent_length.add(1))
        #self.length = %parent_length.sub(1)
        free<SortedDictNode<K, V>>(#alloc, #right)
        #left.recount()
        #self.recount()
        return()

routine SortedDictNode<K, V>.ensure_min(
        #self: Ptr<Self>, %i: U64, #alloc: Ptr<Allocator>) -> U64
require K: typename, V: typename
    block entry():
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        %child_length: U64 := #child.length
        %ok: Bool = %child_length.ge(NODE_MIN_KEYS)
        branch %ok ? return(%i): try_left()

    block try_left():
        %has_left: Bool = %i.gt(0)
        branch %has_left ? check_left() : try_right(false)

    block check_left():
        #left: Ptr<SortedDictNode<K, V>> := #self.children[%i.sub(1)]
        %left_length: U64 := #left.length
        %left_ok: Bool = %left_length.ge(NODE_MIN_KEYS)
        branch %left_ok ? do_borrow_left() : try_right(true)

    block do_borrow_left():
        #self.borrow_from_left(%i)
        return(%i)

    block try_right(%has_left: Bool):
        %parent_length: U64 := #self.length
        %has_right: Bool = %i.lt(%parent_length)
        branch %has_right ? check_right(%has_left) : pick_merge_no_right(%has_left)

    block check_right(%has_left: Bool):
        #right: Ptr<SortedDictNode<K, V>> := #self.children[%i.add(1)]
        %right_length: U64 := #right.length
        %right_ok: Bool = %right_length.ge(NODE_MIN_KEYS)
        branch %right_ok ? do_borrow_right() : pick_merge(%has_left)

    block do_borrow_right():
        #self.borrow_from_right(%i)
        return(%i)

    block pick_merge(%has_left: Bool):
        branch %has_left ? merge_with_left() : merge_with_right()

    block pick_merge_no_right(%has_left: Bool):
        branch %has_left ? merge_with_left() : panic(TrapCode.Unreachable)

    block merge_with_left():
        %i_m1: U64 = %i.sub(1)
        #self.merge_children(%i_m1, #alloc)
        return(%i_m1)

    block merge_with_right():
        #self.merge_children(%i, #alloc)
        return(%i)

routine SortedDictNode<K, V>.take_max_key(
        #self: Ptr<Self>, #map: Ptr<SortedDict<K, V>>, #out_value: Ptr<V>) -> K
require K: typename, V: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %length: U64 := #self.length
        %index: U64 = %length.sub(1)
        %key: K := #self.keys[%index]
        %value: V = #self.remove_leaf_at(%index)
        #out_value = %value
        return(%key)

    block descend():
        %length: U64 := #self.length
        #alloc: Ptr<Allocator> := #map.alloc
        %actual: U64 = #self.ensure_min(%length, #alloc)
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%actual]
        %key: K = #child.take_max_key(#map, #out_value)
        #self.recount()
        return(%key)

routine SortedDictNode<K, V>.take_min_key(
        #self: Ptr<Self>, #map: Ptr<SortedDict<K, V>>, #out_value: Ptr<V>) -> K
require K: typename, V: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %key: K := #self.keys[0]
        %value: V = #self.remove_leaf_at(0)
        #out_value = %value
        return(%key)

    block descend():
        #alloc: Ptr<Allocator> := #map.alloc
        %actual: U64 = #self.ensure_min(0, #alloc)
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%actual]
        %key: K = #child.take_min_key(#map, #out_value)
        #self.recount()
        return(%key)

routine SortedDictNode<K, V>.remove(
        #self: Ptr<Self>, #map: Ptr<SortedDict<K, V>>, %key: K) -> Bool
require K: typename, V: typename
    block entry():
        %slot: U64 = #map.find_index(#self, %key)
        %length: U64 := #self.length
        %inside: Bool = %slot.lt(%length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: U64):
        %node_key: K := #self.keys[%slot]
        %cmp: S32 = %key.compare(%node_key)
        %equal: Bool = %cmp.eq(0)
        branch %equal ? remove_here(%slot) : descend_or_missing(%slot)

    block remove_here(%slot: U64):
        %leaf: Bool := #self.leaf
        branch %leaf ? remove_leaf(%slot) : remove_internal(%slot)

    block remove_leaf(%slot: U64):
        #self.remove_leaf_at(%slot)
        return(true)

    block remove_internal(%slot: U64):
        #left: Ptr<SortedDictNode<K, V>> := #self.children[%slot]
        %left_length: U64 := #left.length
        %left_ok: Bool = %left_length.ge(NODE_MIN_KEYS)
        branch %left_ok ? take_pred(%slot) : try_succ(%slot)

    block take_pred(%slot: U64):
        #out: Ptr<V> = alloca<V>
        #left: Ptr<SortedDictNode<K, V>> := #self.children[%slot]
        %replacement_key: K = #left.take_max_key(#map, #out)
        %replacement_value: V := #out
        #self.keys[%slot] = %replacement_key
        #self.values[%slot] = %replacement_value
        #self.recount()
        return(true)

    block try_succ(%slot: U64):
        #right: Ptr<SortedDictNode<K, V>> := #self.children[%slot.add(1)]
        %right_length: U64 := #right.length
        %right_ok: Bool = %right_length.ge(NODE_MIN_KEYS)
        branch %right_ok ? take_succ(%slot) : merge_and_recurse(%slot)

    block take_succ(%slot: U64):
        #out: Ptr<V> = alloca<V>
        #right: Ptr<SortedDictNode<K, V>> := #self.children[%slot.add(1)]
        %replacement_key: K = #right.take_min_key(#map, #out)
        %replacement_value: V := #out
        #self.keys[%slot] = %replacement_key
        #self.values[%slot] = %replacement_value
        #self.recount()
        return(true)

    block merge_and_recurse(%slot: U64):
        #alloc: Ptr<Allocator> := #map.alloc
        #self.merge_children(%slot, #alloc)
        #merged: Ptr<SortedDictNode<K, V>> := #self.children[%slot]
        %removed: Bool = #merged.remove(#map, %key)
        #self.recount()
        return(%removed)

    block descend_or_missing(%slot: U64):
        %leaf: Bool := #self.leaf
        branch %leaf ? return(false): descend(%slot)

    block descend(%slot: U64):
        #alloc: Ptr<Allocator> := #map.alloc
        %actual: U64 = #self.ensure_min(%slot, #alloc)
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%actual]
        %removed: Bool = #child.remove(#map, %key)
        #self.recount()
        return(%removed)

routine SortedDict<K, V>.remove(#self: Ptr<Self>, %key: K) -> Bool
require K: typename, V: typename
    block entry():
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? return(false) : remove_root(#root)

    block remove_root(#root: Ptr<SortedDictNode<K, V>>):
        %removed: Bool = #root.remove(#self, %key)
        branch %removed ? after_remove(#root) : return(false)

    block after_remove(#root: Ptr<SortedDictNode<K, V>>):
        %length: U64 := #self.length
        #self.length = %length.sub(1)
        %root_length: U64 := #root.length
        %empty_root: Bool = %root_length.eq(0)
        branch %empty_root ? maybe_shrink(#root) : return(true)

    block maybe_shrink(#root: Ptr<SortedDictNode<K, V>>):
        %leaf: Bool := #root.leaf
        branch %leaf ? clear_root(#root) : shrink(#root)

    block clear_root(#root: Ptr<SortedDictNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<SortedDictNode<K, V>>(#alloc, #root)
        #self.root = null
        return(true)

    block shrink(#root: Ptr<SortedDictNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #new_root: Ptr<SortedDictNode<K, V>> := #root.children[0]
        free<SortedDictNode<K, V>>(#alloc, #root)
        #self.root = #new_root
        return(true)

/// Internal nodes store `length` separator keys and `length + 1` children.
routine SortedDictNode<K, V>.free_recursive(
        #self: Ptr<Self>, #alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? free_self() : free_children()

    block free_children():
        %length: U64 := #self.length
        jump child_loop(0, %length.add(1))

    block child_loop(%i: U64, %child_count: U64):
        %done: Bool = %i.ge(%child_count)
        branch %done ? free_self() : free_child(%i, %child_count)

    block free_child(%i: U64, %child_count: U64):
        #child: Ptr<SortedDictNode<K, V>> := #self.children[%i]
        #child.free_recursive(#alloc)
        jump child_loop(%i.add(1), %child_count)

    block free_self():
        free<SortedDictNode<K, V>>(#alloc, #self)
        return()

routine SortedDict<K, V>.free(#self: Ptr<Self>) -> Void
require K: typename, V: typename
    block entry():
        #root: Ptr<SortedDictNode<K, V>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? reset() : free_root(#root)

    block free_root(#root: Ptr<SortedDictNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #root.free_recursive(#alloc)
        jump reset()

    block reset():
        #self.root = null
        #self.length = 0
        return()
