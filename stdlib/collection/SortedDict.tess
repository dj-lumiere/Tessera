// Tessera stdlib collection: SortedDict<K, V>
//
// Order-statistic B-tree map with a fixed node key capacity of NODE_KEYS.
// Nodes store keys/values/children inline with fixed arrays.
// The allocator is stored in SortedDict; node helpers still receive it as a parameter.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset NODE_KEYS: USize = 7
private preset NODE_CHILDREN: USize = NODE_KEYS.add(1)
private preset NODE_MIN_KEYS: USize = NODE_KEYS.add(1).div(2)

record SortedDictNode<K, V>
require K: typename, V: typename
    leaf          : Bool
    length        : USize
    subtree_count : USize
    keys          : Array<K, NODE_KEYS>
    values        : Array<V, NODE_KEYS>
    children      : Array<Ptr<SortedDictNode<K, V>>, NODE_CHILDREN>

record SortedDict<K, V>
conform Destruct<SortedDict<K, V>>
conform Represent<SortedDict<K, V>> when K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>
conform Diagnose<SortedDict<K, V>>  when K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>
require K: typename, V: typename, Compare<K>
    root   : Ptr<SortedDictNode<K, V>>
    length : USize
    alloc  : Ptr<Allocator>

routine SortedDict<K, V>.construct(%alloc: Ptr<Allocator>) -> Self
require K: typename, V: typename, Compare<K>
    block entry():
        %map : Self = Self { root: null, length: 0, alloc: %alloc }
        return(%map)

routine SortedDict<K, V>.length(%self: Ptr<Self>) -> USize
require K: typename, V: typename
    block entry():
        %length : USize = %self.length.load()
        return(%length)

routine SortedDict<K, V>.is_empty(%self: Ptr<Self>) -> Bool
require K: typename, V: typename
    block entry():
        %length : USize = %self.length.load()
        %empty  : Bool  = %length.eq(0)
        return(%empty)

routine SortedDictNode<K, V>.construct(%leaf: Bool, %alloc: Ptr<Allocator>) -> Ptr<Self>
require K: typename, V: typename
    block entry():
        %node   : Ptr<Self> = allocate<Self>(%alloc, 1)
        %failed : Bool      = %node.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : init(%node, %leaf)

    block init(%node: Ptr<Self>, %leaf: Bool):
        %node.leaf.store(%leaf)
        %node.length.store(0)
        %node.subtree_count.store(0)
        return(%node)

routine SortedDictNode<K, V>.count(%self: Ptr<Self>) -> USize
require K: typename, V: typename
    block entry():
        %empty : Bool = %self.is_null()
        branch %empty ? return(0) : count(%self)

    block count(%self: Ptr<Self>):
        %count : USize = %self.subtree_count.load()
        return(%count)

routine SortedDictNode<K, V>.recount(%self: Ptr<Self>) -> Void
require K: typename, V: typename
    block entry():
        %leaf   : Bool  = %self.leaf.load()
        %length : USize = %self.length.load()
        branch %leaf ? leaf_count(%length) : internal_count(%length)

    block leaf_count(%length: USize):
        %self.subtree_count.store(%length)
        return()

    block internal_count(%length: USize):
        jump loop(0, 0, %length)

    block loop(%i: USize, %sum: USize, %length: USize):
        %done : Bool = %i.gt(%length)
        branch %done ? finish(%sum) : add_child(%i, %sum, %length)

    block add_child(%i: USize, %sum: USize, %length: USize):
        %child       : Ptr<Self> = %self.children.get(%i)
        %child_count : USize     = %child.count()
        %with_child  : USize     = %sum.add(%child_count)
        %has_key     : Bool      = %i.lt(%length)
        %next_sum    : USize     = %has_key ? %with_child.add(1) : %with_child
        jump loop(%i.add(1), %next_sum, %length)

    block finish(%sum: USize):
        %self.subtree_count.store(%sum)
        return()

routine SortedDictNode<K, V>.find_index(%self: Ptr<Self>, %key: K) -> USize
require K: typename, V: typename
    block entry():
        jump loop(0)

    block loop(%i: USize):
        %length : USize = %self.length.load()
        %done   : Bool  = %i.ge(%length)
        branch %done ? return(%i) : compare(%i)

    block compare(%i: USize):
        %node_key        : K    = %self.keys.get(%i)
        %cmp             : S32  = %key.compare(%node_key)
        %before_or_equal : Bool = %cmp.le(0)
        branch %before_or_equal ? return(%i) : loop(%i.add(1))

routine SortedDict<K, V>.get(%self: Ptr<Self>, %key: K) -> V
require K: typename, V: typename
    block entry():
        %root  : Ptr<SortedDictNode<K, V>> = %self.root.load()
        %empty : Bool                      = %root.is_null()
        branch %empty ? panic(TrapCode.MissingKey) : search(%root, %key)

    block search(%node: Ptr<SortedDictNode<K, V>>, %key: K):
        %i      : USize = %node.find_index(%key)
        %length : USize = %node.length.load()
        %inside : Bool  = %i.lt(%length)
        branch %inside ? maybe_match(%node, %i, %key) : descend_or_missing(%node, %i, %key)

    block maybe_match(%node: Ptr<SortedDictNode<K, V>>, %i: USize, %key: K):
        %node_key : K    = %node.keys.get(%i)
        %cmp      : S32  = %key.compare(%node_key)
        %equal    : Bool = %cmp.eq(0)
        branch %equal ? load(%node, %i) : descend_or_missing(%node, %i, %key)

    block descend_or_missing(%node: Ptr<SortedDictNode<K, V>>, %i: USize, %key: K):
        %leaf : Bool = %node.leaf.load()
        branch %leaf ? panic(TrapCode.MissingKey) : descend(%node, %i, %key)

    block descend(%node: Ptr<SortedDictNode<K, V>>, %i: USize, %key: K):
        %child : Ptr<SortedDictNode<K, V>> = %node.children.get(%i)
        jump search(%child, %key)

    block load(%node: Ptr<SortedDictNode<K, V>>, %i: USize):
        %value : V = %node.values.get(%i)
        return(%value)

/// SortedDicts are sorted by key, so structural in-order comparison of both
/// keys and values gives map equality.
routine SortedDict<K, V>.eq(%self: Ptr<Self>, %other: Ptr<Self>) -> Bool
require K: typename, V: typename, Compare<K>, Equal<V>
    block entry():
        %la       : USize = %self.length.load()
        %lb       : USize = %other.length.load()
        %same_len : Bool  = %la.eq(%lb)
        branch %same_len ? continue : return(false)
        %a_val : SortedDictIter<K, V> = .construct(%self)
        %b_val : SortedDictIter<K, V> = .construct(%other)
        claim %a : Ptr<SortedDictIter<K, V>>
        claim %b : Ptr<SortedDictIter<K, V>>
        %a.store(%a_val)
        %b.store(%b_val)
        jump loop(%a, %b)

    // both have the same length, so both run out together
    block loop(%a: Ptr<SortedDictIter<K, V>>, %b: Ptr<SortedDictIter<K, V>>):
        %x : Option<KVPair<K, V>> = %a.next()
        %y : Option<KVPair<K, V>> = %b.next()
        when %x:
            .Present(%x_item) -> compare(%a, %b, %x_item, %y.unwrap())
            .Absent           -> return(true)

    block compare(%a: Ptr<SortedDictIter<K, V>>, %b: Ptr<SortedDictIter<K, V>>, %x: KVPair<K, V>,
            %y: KVPair<K, V>):
        %cmp  : S32  = %x.key.compare(%y.key)
        %k_eq : Bool = %cmp.eq(0)
        branch %k_eq ? continue : return(false)
        %v_eq : Bool = %x.value.eq(%y.value)
        branch %v_eq ? loop(%a, %b) : return(false)

routine SortedDict<K, V>.contains(%self: Ptr<Self>, %key: K) -> Bool
require K: typename, V: typename
    block entry():
        %root  : Ptr<SortedDictNode<K, V>> = %self.root.load()
        %empty : Bool                      = %root.is_null()
        branch %empty ? return(false) : search(%root, %key)

    block search(%node: Ptr<SortedDictNode<K, V>>, %key: K):
        %i      : USize = %node.find_index(%key)
        %length : USize = %node.length.load()
        %inside : Bool  = %i.lt(%length)
        branch %inside ? maybe_match(%node, %i, %key) : descend_or_missing(%node, %i, %key)

    block maybe_match(%node: Ptr<SortedDictNode<K, V>>, %i: USize, %key: K):
        %node_key : K    = %node.keys.get(%i)
        %cmp      : S32  = %key.compare(%node_key)
        %equal    : Bool = %cmp.eq(0)
        branch %equal ? return(true) : descend_or_missing(%node, %i, %key)

    block descend_or_missing(%node: Ptr<SortedDictNode<K, V>>, %i: USize, %key: K):
        %leaf : Bool = %node.leaf.load()
        branch %leaf ? return(false) : descend(%node, %i, %key)

    block descend(%node: Ptr<SortedDictNode<K, V>>, %i: USize, %key: K):
        %child : Ptr<SortedDictNode<K, V>> = %node.children.get(%i)
        jump search(%child, %key)

/// Where the entry of a rank lives: its node and its index there.
private record SortedDictSpot<K, V>
require K: typename, V: typename
    node  : Ptr<SortedDictNode<K, V>>
    index : USize

/// The node and index of the %rank-th smallest key. Traps if %rank >= length.
private routine SortedDict<K, V>.locate_rank(%self: Ptr<Self>, %rank: USize) -> SortedDictSpot<K, V>
require K: typename, V: typename
    block entry():
        %length    : USize = %self.length.load()
        %in_bounds : Bool  = %rank.lt(%length)
        branch %in_bounds ? select_root(%rank) : panic(TrapCode.Bounds)

    block select_root(%rank: USize):
        %root : Ptr<SortedDictNode<K, V>> = %self.root.load()
        jump select_node(%root, %rank)

    block select_node(%node: Ptr<SortedDictNode<K, V>>, %rank: USize):
        jump scan(%node, %rank, 0)

    block scan(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize):
        %length : USize = %node.length.load()
        %done   : Bool  = %i.ge(%length)
        branch %done ? last_child(%node, %rank, %i) : check_child(%node, %rank, %i)

    block check_child(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize):
        %leaf : Bool = %node.leaf.load()
        branch %leaf ? leaf_key(%node, %rank, %i) : internal_child(%node, %rank, %i)

    block leaf_key(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize):
        %match : Bool = %rank.eq(%i)
        branch %match ? found(%node, %i) : scan(%node, %rank, %i.add(1))

    block internal_child(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize):
        %child       : Ptr<SortedDictNode<K, V>> = %node.children.get(%i)
        %child_count : USize                     = %child.count()
        %in_child    : Bool                      = %rank.lt(%child_count)
        branch %in_child ? select_node(%child, %rank) : check_key(%node, %rank, %i, %child_count)

    block check_key(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize, %child_count: USize):
        %after_child : USize = %rank.sub(%child_count)
        %is_key      : Bool  = %after_child.eq(0)
        branch %is_key ? found(%node, %i) : scan(%node, %after_child.sub(1), %i.add(1))

    block last_child(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize):
        %leaf : Bool = %node.leaf.load()
        branch %leaf ? panic(TrapCode.Unreachable) : descend_last(%node, %rank, %i)

    block descend_last(%node: Ptr<SortedDictNode<K, V>>, %rank: USize, %i: USize):
        %child : Ptr<SortedDictNode<K, V>> = %node.children.get(%i)
        jump select_node(%child, %rank)

    block found(%node: Ptr<SortedDictNode<K, V>>, %i: USize):
        return(SortedDictSpot<K, V> { node: %node, index: %i })

/// The %rank-th smallest key and its value, copied (0 is the smallest). Traps if %rank >= length. A copy, because
/// writing a key through a pointer would break the order.
routine SortedDict<K, V>.get_by_rank(%self: Ptr<Self>, %rank: USize) -> KVPair<K, V>
require K: typename, V: typename
    block entry():
        %spot  : SortedDictSpot<K, V>      = %self.locate_rank(%rank)
        %node  : Ptr<SortedDictNode<K, V>> = %spot.node
        %key   : K                         = %node.keys.get(%spot.index)
        %value : V                         = %node.values.get(%spot.index)
        return(KVPair<K, V> { key: %key, value: %value })

/// A pointer to the value of the %rank-th smallest key, to change it in place. Traps if %rank >= length. Valid until
/// the next put or remove.
routine SortedDict<K, V>.value_ptr_by_rank(%self: Ptr<Self>, %rank: USize) -> Ptr<V>
require K: typename, V: typename
    block entry():
        %spot  : SortedDictSpot<K, V>      = %self.locate_rank(%rank)
        %node  : Ptr<SortedDictNode<K, V>> = %spot.node
        %value : Ptr<V>                    = %node.values.to_ptr()[%spot.index]
        return(%value)

routine SortedDictNode<K, V>.split_child(%self: Ptr<Self>, %index: USize,
        %alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %left        : Ptr<Self> = %self.children.get(%index)
        %leaf        : Bool      = %left.leaf.load()
        %right       : Ptr<Self> = Self.construct(%leaf, %alloc)
        %mid         : USize     = NODE_KEYS.div(2)
        %right_start : USize     = %mid.add(1)
        %right_count : USize     = NODE_KEYS.sub(%right_start)
        %right.keys.copy(0, %left.keys, %right_start, %right_count)
        %right.values.copy(0, %left.values, %right_start, %right_count)
        %right.length.store(%right_count)
        branch %leaf
            ? promote(%left, %right, %mid)
            : copy_children(%left, %right, %mid, %right_count)

    block copy_children(%left: Ptr<Self>, %right: Ptr<Self>, %mid: USize, %right_count: USize):
        jump child_loop(0, %left, %right, %mid, %right_count)

    block child_loop(%i: USize, %left: Ptr<Self>, %right: Ptr<Self>, %mid: USize,
            %right_count: USize):
        %done : Bool = %i.gt(%right_count)
        branch %done
            ? promote(%left, %right, %mid)
            : child_copy(%i, %left, %right, %mid, %right_count)

    block child_copy(%i: USize, %left: Ptr<Self>, %right: Ptr<Self>, %mid: USize,
            %right_count: USize):
        %src   : USize     = %mid.add(1).add(%i)
        %child : Ptr<Self> = %left.children.get(%src)
        %right.children.set(%i, %child)
        jump child_loop(%i.add(1), %left, %right, %mid, %right_count)

    block promote(%left: Ptr<Self>, %right: Ptr<Self>, %mid: USize):
        %parent_length : USize = %self.length.load()
        %self.keys.shift_right(%index, %parent_length)
        %self.values.shift_right(%index, %parent_length)
        jump shift_children(%parent_length, %left, %right, %mid)

    block shift_children(%i: USize, %left: Ptr<Self>, %right: Ptr<Self>, %mid: USize):
        %stop : USize = %index.add(1)
        %done : Bool  = %i.lt(%stop)
        branch %done ? install(%left, %right, %mid) : move_child(%i, %left, %right, %mid)

    block move_child(%i: USize, %left: Ptr<Self>, %right: Ptr<Self>, %mid: USize):
        %child : Ptr<Self> = %self.children.get(%i)
        %self.children.set(%i.add(1), %child)
        jump shift_children(%i.sub(1), %left, %right, %mid)

    block install(%left: Ptr<Self>, %right: Ptr<Self>, %mid: USize):
        %middle_key   : K = %left.keys.get(%mid)
        %middle_value : V = %left.values.get(%mid)
        %self.keys.set(%index, %middle_key)
        %self.values.set(%index, %middle_value)
        %self.children.set(%index.add(1), %right)
        %left.length.store(%mid)
        %self.length.load().add(1).store_into(%self.length)
        %left.recount()
        %right.recount()
        %self.recount()
        return()

routine SortedDictNode<K, V>.insert_nonfull(%self: Ptr<Self>, %key: K, %value: V,
        %alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? insert_leaf() : insert_internal()

    block insert_leaf():
        %slot   : USize = %self.find_index(%key)
        %length : USize = %self.length.load()
        %self.keys.shift_right(%slot, %length)
        %self.values.shift_right(%slot, %length)
        %self.keys.set(%slot, %key)
        %self.values.set(%slot, %value)
        %new_length : USize = %length.add(1)
        %self.length.store(%new_length)
        %self.subtree_count.store(%new_length)
        return()

    block insert_internal():
        %slot         : USize     = %self.find_index(%key)
        %child        : Ptr<Self> = %self.children.get(%slot)
        %child_length : USize     = %child.length.load()
        %full         : Bool      = %child_length.eq(NODE_KEYS)
        branch %full ? split_then_insert(%slot, %child) : descend(%slot, %child)

    block split_then_insert(%slot: USize, %child: Ptr<Self>):
        %self.split_child(%slot, %alloc)
        %pivot      : K         = %self.keys.get(%slot)
        %cmp        : S32       = %key.compare(%pivot)
        %go_right   : Bool      = %cmp.gt(0)
        %next_slot  : USize     = %go_right ? %slot.add(1) : %slot
        %next_child : Ptr<Self> = %self.children.get(%next_slot)
        jump descend(%next_slot, %next_child)

    block descend(%slot: USize, %child: Ptr<Self>):
        %child.insert_nonfull(%key, %value, %alloc)
        %self.recount()
        return()

routine SortedDict<K, V>.put(%self: Ptr<Self>, %key: K, %value: V) -> Void
require K: typename, V: typename
    block entry():
        %root  : Ptr<SortedDictNode<K, V>> = %self.root.load()
        %empty : Bool                      = %root.is_null()
        branch %empty ? first_root() : maybe_replace(%root)

    block first_root():
        %alloc : Ptr<Allocator>            = %self.alloc.load()
        %root  : Ptr<SortedDictNode<K, V>> = SortedDictNode<K, V>.construct(true, %alloc)
        %root.keys.set(0, %key)
        %root.values.set(0, %value)
        %root.length.store(1)
        %root.subtree_count.store(1)
        %self.root.store(%root)
        %self.length.store(1)
        return()

    block maybe_replace(%root: Ptr<SortedDictNode<K, V>>):
        %replaced : Bool = %root.replace(%key, %value)
        branch %replaced ? return() : insert_root(%root)

    block insert_root(%root: Ptr<SortedDictNode<K, V>>):
        %alloc       : Ptr<Allocator> = %self.alloc.load()
        %root_length : USize          = %root.length.load()
        %full        : Bool           = %root_length.eq(NODE_KEYS)
        branch %full ? split_root(%root, %alloc) : insert_nonfull(%root, %alloc)

    block split_root(%old_root: Ptr<SortedDictNode<K, V>>, %alloc: Ptr<Allocator>):
        %new_root : Ptr<SortedDictNode<K, V>> = SortedDictNode<K, V>.construct(false, %alloc)
        %new_root.children.set(0, %old_root)
        %self.root.store(%new_root)
        %new_root.split_child(0, %alloc)
        jump insert_nonfull(%new_root, %alloc)

    block insert_nonfull(%root: Ptr<SortedDictNode<K, V>>, %alloc: Ptr<Allocator>):
        %root.insert_nonfull(%key, %value, %alloc)
        %self.length.load().add(1).store_into(%self.length)
        return()

routine SortedDictNode<K, V>.replace(%self: Ptr<Self>, %key: K, %value: V) -> Bool
require K: typename, V: typename
    block entry():
        %slot   : USize = %self.find_index(%key)
        %length : USize = %self.length.load()
        %inside : Bool  = %slot.lt(%length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: USize):
        %node_key : K    = %self.keys.get(%slot)
        %cmp      : S32  = %key.compare(%node_key)
        %equal    : Bool = %cmp.eq(0)
        branch %equal ? replace(%slot) : descend_or_missing(%slot)

    block replace(%slot: USize):
        %self.values.set(%slot, %value)
        return(true)

    block descend_or_missing(%slot: USize):
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? return(false): descend(%slot)

    block descend(%slot: USize):
        %child    : Ptr<Self> = %self.children.get(%slot)
        %replaced : Bool      = %child.replace(%key, %value)
        return(%replaced)

routine SortedDictNode<K, V>.remove_leaf_at(%self: Ptr<Self>, %index: USize) -> V
require K: typename, V: typename
    block entry():
        %old    : V     = %self.values.get(%index)
        %length : USize = %self.length.load()
        %self.keys.shift_left(%index, %length)
        %self.values.shift_left(%index, %length)
        %new_length : USize = %length.sub(1)
        %self.length.store(%new_length)
        %self.subtree_count.store(%new_length)
        return(%old)

// Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
// length >= NODE_MIN_KEYS - 1.
// Helpers below ensure a child has length >= NODE_MIN_KEYS (= t) before any deletion
// descent so the child can absorb a one-key drop without underflowing.

routine SortedDictNode<K, V>.borrow_from_left(%self: Ptr<Self>, %i: USize) -> Void
require K: typename, V: typename
    block entry():
        %separator    : USize     = %i.sub(1)
        %left         : Ptr<Self> = %self.children.get(%separator)
        %child        : Ptr<Self> = %self.children.get(%i)
        %left_length  : USize     = %left.length.load()
        %child_length : USize     = %child.length.load()
        %child.keys.shift_right(0, %child_length)
        %child.values.shift_right(0, %child_length)
        %pivot_key   : K = %self.keys.get(%separator)
        %pivot_value : V = %self.values.get(%separator)
        %child.keys.set(0, %pivot_key)
        %child.values.set(0, %pivot_value)
        %new_pivot_key   : K = %left.keys.get(%left_length.sub(1))
        %new_pivot_value : V = %left.values.get(%left_length.sub(1))
        %self.keys.set(%separator, %new_pivot_key)
        %self.values.set(%separator, %new_pivot_value)
        %leaf : Bool = %child.leaf.load()
        branch %leaf
            ? finalize(%left, %child, %left_length, %child_length)
            : move_child(%left, %child, %left_length, %child_length)

    block move_child(%left: Ptr<Self>, %child: Ptr<Self>, %left_length: USize,
            %child_length: USize):
        %child_count : USize = %child_length.add(1)
        %child.children.shift_right(0, %child_count)
        %moved : Ptr<Self> = %left.children.get(%left_length)
        %child.children.set(0, %moved)
        jump finalize(%left, %child, %left_length, %child_length)

    block finalize(%left: Ptr<Self>, %child: Ptr<Self>, %left_length: USize, %child_length: USize):
        %left.length.store(%left_length.sub(1))
        %child.length.store(%child_length.add(1))
        %left.recount()
        %child.recount()
        %self.recount()
        return()

routine SortedDictNode<K, V>.borrow_from_right(%self: Ptr<Self>, %i: USize) -> Void
require K: typename, V: typename
    block entry():
        %child        : Ptr<Self> = %self.children.get(%i)
        %right        : Ptr<Self> = %self.children.get(%i.add(1))
        %child_length : USize     = %child.length.load()
        %right_length : USize     = %right.length.load()
        %pivot_key    : K         = %self.keys.get(%i)
        %pivot_value  : V         = %self.values.get(%i)
        %child.keys.set(%child_length, %pivot_key)
        %child.values.set(%child_length, %pivot_value)
        %new_pivot_key   : K = %right.keys.get(0)
        %new_pivot_value : V = %right.values.get(0)
        %self.keys.set(%i, %new_pivot_key)
        %self.values.set(%i, %new_pivot_value)
        %right.keys.shift_left(0, %right_length)
        %right.values.shift_left(0, %right_length)
        %leaf : Bool = %child.leaf.load()
        branch %leaf
            ? finalize(%child, %right, %child_length, %right_length)
            : move_child(%child, %right, %child_length, %right_length)

    block move_child(%child: Ptr<Self>, %right: Ptr<Self>, %child_length: USize,
            %right_length: USize):
        %moved : Ptr<Self> = %right.children.get(0)
        %child.children.set(%child_length.add(1), %moved)
        %right.children.shift_left(0, %right_length.add(1))
        jump finalize(%child, %right, %child_length, %right_length)

    block finalize(%child: Ptr<Self>, %right: Ptr<Self>, %child_length: USize,
            %right_length: USize):
        %child.length.store(%child_length.add(1))
        %right.length.store(%right_length.sub(1))
        %child.recount()
        %right.recount()
        %self.recount()
        return()

routine SortedDictNode<K, V>.merge_children(%self: Ptr<Self>, %i: USize,
        %alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %left         : Ptr<Self> = %self.children.get(%i)
        %right        : Ptr<Self> = %self.children.get(%i.add(1))
        %left_length  : USize     = %left.length.load()
        %right_length : USize     = %right.length.load()
        %pivot_key    : K         = %self.keys.get(%i)
        %pivot_value  : V         = %self.values.get(%i)
        %left.keys.set(%left_length, %pivot_key)
        %left.values.set(%left_length, %pivot_value)
        %dst_start : USize = %left_length.add(1)
        %left.keys.copy(%dst_start, %right.keys, 0, %right_length)
        %left.values.copy(%dst_start, %right.values, 0, %right_length)
        %leaf : Bool = %left.leaf.load()
        branch %leaf
            ? finalize(%left, %right, %left_length, %right_length)
            : copy_children(%left, %right, %left_length, %right_length)

    block copy_children(%left: Ptr<Self>, %right: Ptr<Self>, %left_length: USize,
            %right_length: USize):
        %left.children.copy(%left_length.add(1), %right.children, 0, %right_length.add(1))
        jump finalize(%left, %right, %left_length, %right_length)

    block finalize(%left: Ptr<Self>, %right: Ptr<Self>, %left_length: USize, %right_length: USize):
        %left.length.store(%left_length.add(1).add(%right_length))
        %parent_length : USize = %self.length.load()
        %self.keys.shift_left(%i, %parent_length)
        %self.values.shift_left(%i, %parent_length)
        %self.children.shift_left(%i.add(1), %parent_length.add(1))
        %self.length.store(%parent_length.sub(1))
        %right.free(%alloc)
        %left.recount()
        %self.recount()
        return()

routine SortedDictNode<K, V>.ensure_min(%self: Ptr<Self>, %i: USize,
        %alloc: Ptr<Allocator>) -> USize
require K: typename, V: typename
    block entry():
        %child        : Ptr<Self> = %self.children.get(%i)
        %child_length : USize     = %child.length.load()
        %ok           : Bool      = %child_length.ge(NODE_MIN_KEYS)
        branch %ok ? return(%i): try_left()

    block try_left():
        %has_left : Bool = %i.gt(0)
        branch %has_left ? check_left() : try_right(false)

    block check_left():
        %left        : Ptr<Self> = %self.children.get(%i.sub(1))
        %left_length : USize     = %left.length.load()
        %left_ok     : Bool      = %left_length.ge(NODE_MIN_KEYS)
        branch %left_ok ? do_borrow_left() : try_right(true)

    block do_borrow_left():
        %self.borrow_from_left(%i)
        return(%i)

    block try_right(%has_left: Bool):
        %parent_length : USize = %self.length.load()
        %has_right     : Bool  = %i.lt(%parent_length)
        branch %has_right ? check_right(%has_left) : pick_merge_no_right(%has_left)

    block check_right(%has_left: Bool):
        %right        : Ptr<Self> = %self.children.get(%i.add(1))
        %right_length : USize     = %right.length.load()
        %right_ok     : Bool      = %right_length.ge(NODE_MIN_KEYS)
        branch %right_ok ? do_borrow_right() : pick_merge(%has_left)

    block do_borrow_right():
        %self.borrow_from_right(%i)
        return(%i)

    block pick_merge(%has_left: Bool):
        branch %has_left ? merge_with_left() : merge_with_right()

    block pick_merge_no_right(%has_left: Bool):
        branch %has_left ? merge_with_left() : panic(TrapCode.Unreachable)

    block merge_with_left():
        %merged_at : USize = %i.sub(1)
        %self.merge_children(%merged_at, %alloc)
        return(%merged_at)

    block merge_with_right():
        %self.merge_children(%i, %alloc)
        return(%i)

routine SortedDictNode<K, V>.take_max_key(%self: Ptr<Self>, %out_value: Ptr<V>,
        %alloc: Ptr<Allocator>) -> K
require K: typename, V: typename
    block entry():
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %length : USize = %self.length.load()
        %index  : USize = %length.sub(1)
        %key    : K     = %self.keys.get(%index)
        %value  : V     = %self.remove_leaf_at(%index)
        %out_value.store(%value)
        return(%key)

    block descend():
        %length : USize     = %self.length.load()
        %actual : USize     = %self.ensure_min(%length, %alloc)
        %child  : Ptr<Self> = %self.children.get(%actual)
        %key    : K         = %child.take_max_key(%out_value, %alloc)
        %self.recount()
        return(%key)

routine SortedDictNode<K, V>.take_min_key(%self: Ptr<Self>, %out_value: Ptr<V>,
        %alloc: Ptr<Allocator>) -> K
require K: typename, V: typename
    block entry():
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %key   : K = %self.keys.get(0)
        %value : V = %self.remove_leaf_at(0)
        %out_value.store(%value)
        return(%key)

    block descend():
        %actual : USize     = %self.ensure_min(0, %alloc)
        %child  : Ptr<Self> = %self.children.get(%actual)
        %key    : K         = %child.take_min_key(%out_value, %alloc)
        %self.recount()
        return(%key)

routine SortedDictNode<K, V>.remove(%self: Ptr<Self>, %key: K, %alloc: Ptr<Allocator>) -> Bool
require K: typename, V: typename
    block entry():
        %slot   : USize = %self.find_index(%key)
        %length : USize = %self.length.load()
        %inside : Bool  = %slot.lt(%length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: USize):
        %node_key : K    = %self.keys.get(%slot)
        %cmp      : S32  = %key.compare(%node_key)
        %equal    : Bool = %cmp.eq(0)
        branch %equal ? remove_here(%slot) : descend_or_missing(%slot)

    block remove_here(%slot: USize):
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? remove_leaf(%slot) : remove_internal(%slot)

    block remove_leaf(%slot: USize):
        %self.remove_leaf_at(%slot)
        return(true)

    block remove_internal(%slot: USize):
        %left        : Ptr<Self> = %self.children.get(%slot)
        %left_length : USize     = %left.length.load()
        %left_ok     : Bool      = %left_length.ge(NODE_MIN_KEYS)
        branch %left_ok ? take_pred(%slot) : try_succ(%slot)

    block take_pred(%slot: USize):
        claim %out : Ptr<V>
        %left              : Ptr<Self> = %self.children.get(%slot)
        %replacement_key   : K         = %left.take_max_key(%out, %alloc)
        %replacement_value : V         = %out.load()
        %self.keys.set(%slot, %replacement_key)
        %self.values.set(%slot, %replacement_value)
        %self.recount()
        return(true)

    block try_succ(%slot: USize):
        %right        : Ptr<Self> = %self.children.get(%slot.add(1))
        %right_length : USize     = %right.length.load()
        %right_ok     : Bool      = %right_length.ge(NODE_MIN_KEYS)
        branch %right_ok ? take_succ(%slot) : merge_and_recurse(%slot)

    block take_succ(%slot: USize):
        claim %out : Ptr<V>
        %right             : Ptr<Self> = %self.children.get(%slot.add(1))
        %replacement_key   : K         = %right.take_min_key(%out, %alloc)
        %replacement_value : V         = %out.load()
        %self.keys.set(%slot, %replacement_key)
        %self.values.set(%slot, %replacement_value)
        %self.recount()
        return(true)

    block merge_and_recurse(%slot: USize):
        %self.merge_children(%slot, %alloc)
        %merged  : Ptr<Self> = %self.children.get(%slot)
        %removed : Bool      = %merged.remove(%key, %alloc)
        %self.recount()
        return(%removed)

    block descend_or_missing(%slot: USize):
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? return(false): descend(%slot)

    block descend(%slot: USize):
        %actual  : USize     = %self.ensure_min(%slot, %alloc)
        %child   : Ptr<Self> = %self.children.get(%actual)
        %removed : Bool      = %child.remove(%key, %alloc)
        %self.recount()
        return(%removed)

routine SortedDict<K, V>.remove(%self: Ptr<Self>, %key: K) -> Bool
require K: typename, V: typename
    block entry():
        %root  : Ptr<SortedDictNode<K, V>> = %self.root.load()
        %empty : Bool                      = %root.is_null()
        branch %empty ? return(false) : remove_root(%root)

    block remove_root(%root: Ptr<SortedDictNode<K, V>>):
        %alloc   : Ptr<Allocator> = %self.alloc.load()
        %removed : Bool           = %root.remove(%key, %alloc)
        branch %removed ? after_remove(%root) : return(false)

    block after_remove(%root: Ptr<SortedDictNode<K, V>>):
        %self.length.load().sub(1).store_into(%self.length)
        %root_length : USize = %root.length.load()
        %empty_root  : Bool  = %root_length.eq(0)
        branch %empty_root ? maybe_shrink(%root) : return(true)

    block maybe_shrink(%root: Ptr<SortedDictNode<K, V>>):
        %leaf : Bool = %root.leaf.load()
        branch %leaf ? clear_root(%root) : shrink(%root)

    block clear_root(%root: Ptr<SortedDictNode<K, V>>):
        %alloc : Ptr<Allocator> = %self.alloc.load()
        %root.free(%alloc)
        %self.root.store(null)
        return(true)

    block shrink(%root: Ptr<SortedDictNode<K, V>>):
        %alloc    : Ptr<Allocator>            = %self.alloc.load()
        %new_root : Ptr<SortedDictNode<K, V>> = %root.children.get(0)
        %root.free(%alloc)
        %self.root.store(%new_root)
        return(true)

/// Internal nodes store `length` separator keys and `length + 1` children.
routine SortedDictNode<K, V>.free_recursive(%self: Ptr<Self>, %alloc: Ptr<Allocator>) -> Void
require K: typename, V: typename
    block entry():
        %leaf : Bool = %self.leaf.load()
        branch %leaf ? free_self() : free_children()

    block free_children():
        %length : USize = %self.length.load()
        jump child_loop(0, %length.add(1))

    block child_loop(%i: USize, %child_count: USize):
        %done : Bool = %i.ge(%child_count)
        branch %done ? free_self() : free_child(%i, %child_count)

    block free_child(%i: USize, %child_count: USize):
        %child : Ptr<Self> = %self.children.get(%i)
        %child.free_recursive(%alloc)
        jump child_loop(%i.add(1), %child_count)

    block free_self():
        %self.free(%alloc)
        return()

routine SortedDict<K, V>.destruct(%self: Ptr<Self>) -> Void
require K: typename, V: typename
    block entry():
        %root  : Ptr<SortedDictNode<K, V>> = %self.root.load()
        %empty : Bool                      = %root.is_null()
        branch %empty ? reset() : free_root(%root)

    block free_root(%root: Ptr<SortedDictNode<K, V>>):
        %alloc : Ptr<Allocator> = %self.alloc.load()
        %root.free_recursive(%alloc)
        jump reset()

    block reset():
        %self.root.store(null)
        %self.length.store(0)
        return()

/// Destructs every key and value, then the dictionary itself.
routine SortedDict<K, V>.destruct_all(%self: Ptr<Self>) -> Void
require K: typename, V: typename, Destruct<K>, Destruct<V>
    block entry():
        %iter_val : SortedDictIter<K, V> = .construct(%self)
        claim %iter : Ptr<SortedDictIter<K, V>>
        %iter.store(%iter_val)
        claim %key_slot   : Ptr<K>
        claim %value_slot : Ptr<V>
        jump next(%iter, %key_slot, %value_slot)

    block next(%iter: Ptr<SortedDictIter<K, V>>, %key_slot: Ptr<K>, %value_slot: Ptr<V>):
        %item : Option<KVPair<K, V>> = %iter.next()
        when %item:
            .Present(%entry) -> entry_found(%iter, %key_slot, %value_slot, %entry)
            .Absent          -> finish()

    block entry_found(%iter: Ptr<SortedDictIter<K, V>>, %key_slot: Ptr<K>, %value_slot: Ptr<V>,
            %entry: KVPair<K, V>):
        %key_slot.store(%entry.key)
        %key_slot.destruct()
        %value_slot.store(%entry.value)
        %value_slot.destruct()
        jump next(%iter, %key_slot, %value_slot)

    block finish():
        %self.destruct()
        return()

/// Destructs every value (the keys own nothing), then the dictionary itself.
routine SortedDict<K, V>.destruct_all_values(%self: Ptr<Self>) -> Void
require K: typename, V: typename, Destruct<V>
    block entry():
        %iter_val : SortedDictIter<K, V> = .construct(%self)
        claim %iter : Ptr<SortedDictIter<K, V>>
        %iter.store(%iter_val)
        claim %value_slot : Ptr<V>
        jump next(%iter, %value_slot)

    block next(%iter: Ptr<SortedDictIter<K, V>>, %value_slot: Ptr<V>):
        %item : Option<KVPair<K, V>> = %iter.next()
        when %item:
            .Present(%entry) -> entry_found(%iter, %value_slot, %entry)
            .Absent          -> finish()

    block entry_found(%iter: Ptr<SortedDictIter<K, V>>, %value_slot: Ptr<V>, %entry: KVPair<K, V>):
        %value_slot.store(%entry.value)
        %value_slot.destruct()
        jump next(%iter, %value_slot)

    block finish():
        %self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The entries in key order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
routine SortedDict<K, V>.represent<W>(%self: Self, %out: Ptr<W>) -> Void
require K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>, W: typename, Writer<W>
    block entry():
        claim %whole : Ptr<Self>
        %whole.store(%self)
        %iter_val : SortedDictIter<K, V> = .construct(%whole)
        claim %iter : Ptr<SortedDictIter<K, V>>
        %iter.store(%iter_val)
        diagnose_entries<K, V, SortedDictIter<K, V>, W>(%out, %iter)
        return()

/// The entries in key order, keys and values diagnosed: {"a": 1, "b": 2}.
routine SortedDict<K, V>.diagnose<W>(%self: Self, %out: Ptr<W>) -> Void
require K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>, W: typename, Writer<W>
    block entry():
        claim %whole : Ptr<Self>
        %whole.store(%self)
        %iter_val : SortedDictIter<K, V> = .construct(%whole)
        claim %iter : Ptr<SortedDictIter<K, V>>
        %iter.store(%iter_val)
        diagnose_entries<K, V, SortedDictIter<K, V>, W>(%out, %iter)
        return()
