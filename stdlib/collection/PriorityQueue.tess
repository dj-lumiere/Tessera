; Tessera stdlib collection: PriorityQueue<T>
;
; Binary min-heap ordered by Priority<T>: a.less(b) returns true when a has
; higher priority than b (sits closer to the top). The allocator is stored in
; the record.

record PriorityQueue<T>
require T: typename, Priority<T>
    data: Ptr<T>
    length: I64
    capacity: I64
    alloc: Ptr<Allocator>

routine PriorityQueue<T>.new(#alloc: Ptr<Allocator>) -> Self
require T: typename, Priority<T>
    block entry():
        %queue: Self = Self {
            data: null,
            length: 0,
            capacity: 0,
            alloc: #alloc
        }
        return(%queue)

routine PriorityQueue<T>.length(#self: Ptr<Self>) -> I64
require T: typename
    block entry():
        %length: I64 := #self.length
        return(%length)

routine PriorityQueue<T>.is_empty(#self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        return(%empty)

routine PriorityQueue<T>.reserve(#self: Ptr<Self>, %capacity: I64) -> Void
require T: typename
    block entry():
        %old_capacity: I64 := #self.capacity
        %enough: Bool = %old_capacity.sge(%capacity)
        branch %enough ? return() : grow(%capacity)

    block grow(%capacity: I64):
        #alloc: Ptr<Allocator> := #self.alloc
        #old_data: Ptr<T> := #self.data
        #new_data: Ptr<T> = realloc<T>(#alloc, #old_data, %capacity)
        %failed: Bool = #new_data.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : install(#new_data, %capacity)

    block install(#new_data: Ptr<T>, %capacity: I64):
        #self.data = #new_data
        #self.capacity = %capacity
        return()

routine PriorityQueue<T>.ensure(#self: Ptr<Self>, %wanted: I64) -> Void
require T: typename
    block entry():
        %capacity: I64 := #self.capacity
        %enough: Bool = %capacity.sge(%wanted)
        branch %enough ? return() : choose(%capacity, %wanted)

    block choose(%capacity: I64, %wanted: I64):
        %empty: Bool = %capacity.eq(0)
        branch %empty ? initial(%wanted) : double(%capacity, %wanted)

    block initial(%wanted: I64):
        %base: I64 = 8
        %use_wanted: Bool = %wanted.sgt(%base)
        %new_capacity: I64 = %use_wanted ? %wanted : %base
        #self.reserve(%new_capacity)
        return()

    block double(%capacity: I64, %wanted: I64):
        %next: I64 = %capacity.mul(2)
        %enough: Bool = %next.sge(%wanted)
        branch %enough ? reserve(%next) : double(%next, %wanted)

    block reserve(%new_capacity: I64):
        #self.reserve(%new_capacity)
        return()

routine PriorityQueue<T>.less(#self: Ptr<Self>, %a: T, %b: T) -> Bool
require T: typename, Priority<T>
    block entry():
        %result: Bool = %a.less(%b)
        return(%result)

routine PriorityQueue<T>.push(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %wanted: I64 = %length.add(1)
        #self.ensure(%wanted)
        #data: Ptr<T> := #self.data
        #data[%length] = %value
        #self.length = %wanted
        jump sift_up(%length)

    block sift_up(%index: I64):
        %at_root: Bool = %index.eq(0)
        branch %at_root ? return() : compare_parent(%index)

    block compare_parent(%index: I64):
        %parent: I64 = %index.sub(1).sdiv(2)
        #data: Ptr<T> := #self.data
        %child_value: T := #data[%index]
        %parent_value: T := #data[%parent]
        %less: Bool = #self.less(%child_value, %parent_value)
        branch %less ? swap(%index, %parent, %child_value, %parent_value) : return()

    block swap(%index: I64, %parent: I64, %child_value: T, %parent_value: T):
        #data: Ptr<T> := #self.data
        #data[%parent] = %child_value
        #data[%index] = %parent_value
        jump sift_up(%parent)

routine PriorityQueue<T>.peek(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : load()

    block load():
        #data: Ptr<T> := #self.data
        %value: T := #data[0]
        return(%value)

routine PriorityQueue<T>.pop(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : remove_root(%length)

    block remove_root(%length: I64):
        #data: Ptr<T> := #self.data
        %result: T := #data[0]
        %new_length: I64 = %length.sub(1)
        #self.length = %new_length
        %now_empty: Bool = %new_length.eq(0)
        branch %now_empty ? return(%result): move_last(%result, %new_length)

    block move_last(%result: T, %new_length: I64):
        #data: Ptr<T> := #self.data
        %last: T := #data[%new_length]
        #data[0] = %last
        jump sift_down(0, %result)

    block sift_down(%index: I64, %result: T):
        %length: I64 := #self.length
        %left: I64 = %index.mul(2).add(1)
        %right: I64 = %left.add(1)
        %has_left: Bool = %left.slt(%length)
        branch %has_left ? choose_child(%index, %left, %right, %result) : return(%result)

    block choose_child(%index: I64, %left: I64, %right: I64, %result: T):
        %length: I64 := #self.length
        %has_right: Bool = %right.slt(%length)
        branch %has_right
            ? compare_children(%index, %left, %right, %result)
            : compare_with_child(%index, %left, %result)

    block compare_children(%index: I64, %left: I64, %right: I64, %result: T):
        #data: Ptr<T> := #self.data
        %left_value: T := #data[%left]
        %right_value: T := #data[%right]
        %right_less: Bool = #self.less(%right_value, %left_value)
        %child: I64 = %right_less ? %right : %left
        jump compare_with_child(%index, %child, %result)

    block compare_with_child(%index: I64, %child: I64, %result: T):
        #data: Ptr<T> := #self.data
        %index_value: T := #data[%index]
        %child_value: T := #data[%child]
        %child_less: Bool = #self.less(%child_value, %index_value)
        branch %child_less
            ? swap_down(%index, %child, %index_value, %child_value, %result)
            : return(%result)

    block swap_down(%index: I64, %child: I64, %index_value: T, %child_value: T, %result: T):
        #data: Ptr<T> := #self.data
        #data[%index] = %child_value
        #data[%child] = %index_value
        jump sift_down(%child, %result)

routine PriorityQueue<T>.clear(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #self.length = 0
        return()

routine PriorityQueue<T>.free(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #data: Ptr<T> := #self.data
        %empty: Bool = #data.is_null()
        branch %empty ? reset() : release(#data)

    block release(#data: Ptr<T>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<T>(#alloc, #data)
        jump reset()

    block reset():
        #self.data = null
        #self.length = 0
        #self.capacity = 0
        return()
