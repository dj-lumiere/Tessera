// Tessera stdlib collection: PriorityQueue<T>
//
// Binary min-heap ordered by Priority<T>: a.less(b) returns true when a has
// higher priority than b (sits closer to the top). The allocator is stored in
// the record.

module Standard::Collections

import Standard::Alloc
import Standard::Format

record PriorityQueue<T>
conform Destruct<PriorityQueue<T>>
conform Represent<PriorityQueue<T>> when T: typename, Priority<T>, Diagnose<T>
conform Diagnose<PriorityQueue<T>>  when T: typename, Priority<T>, Diagnose<T>
require T: typename, Priority<T>
    data     : Ptr<T>
    length   : USize
    capacity : USize
    alloc    : Ptr<Allocator>

routine PriorityQueue<T>.construct(%alloc: Ptr<Allocator>) -> Self
require T: typename, Priority<T>
    block entry():
        %queue : Self = Self { data: null, length: 0, capacity: 0, alloc: %alloc }
        return(%queue)

routine PriorityQueue<T>.length(%self: Ptr<Self>) -> USize
require T: typename
    block entry():
        %length : USize = %self.length.load()
        return(%length)

routine PriorityQueue<T>.is_empty(%self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length : USize = %self.length.load()
        %empty  : Bool  = %length.eq(0)
        return(%empty)

routine PriorityQueue<T>.reserve(%self: Ptr<Self>, %capacity: USize) -> Void
require T: typename
    block entry():
        %old_capacity : USize = %self.capacity.load()
        %enough       : Bool  = %old_capacity.ge(%capacity)
        branch %enough ? return() : grow(%capacity)

    block grow(%capacity: USize):
        %alloc    : Ptr<Allocator> = %self.alloc.load()
        %old_data : Ptr<T>         = %self.data.load()
        %new_data : Ptr<T>         = reallocate<T>(%alloc, %old_data, %capacity)
        %failed   : Bool           = %new_data.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : install(%new_data, %capacity)

    block install(%new_data: Ptr<T>, %capacity: USize):
        %self.data.store(%new_data)
        %self.capacity.store(%capacity)
        return()

routine PriorityQueue<T>.ensure(%self: Ptr<Self>, %wanted: USize) -> Void
require T: typename
    block entry():
        %capacity : USize = %self.capacity.load()
        %enough   : Bool  = %capacity.ge(%wanted)
        branch %enough ? return() : choose(%capacity, %wanted)

    block choose(%capacity: USize, %wanted: USize):
        %empty : Bool = %capacity.eq(0)
        branch %empty ? initial(%wanted) : double(%capacity, %wanted)

    block initial(%wanted: USize):
        %base         : USize = 8
        %use_wanted   : Bool  = %wanted.gt(%base)
        %new_capacity : USize = %use_wanted ? %wanted : %base
        %self.reserve(%new_capacity)
        return()

    block double(%capacity: USize, %wanted: USize):
        %next   : USize = %capacity.mul(2)
        %enough : Bool  = %next.ge(%wanted)
        branch %enough ? reserve(%next) : double(%next, %wanted)

    block reserve(%new_capacity: USize):
        %self.reserve(%new_capacity)
        return()

routine PriorityQueue<T>.push(%self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        %length : USize = %self.length.load()
        %wanted : USize = %length.add(1)
        %self.ensure(%wanted)
        %data : Ptr<T> = %self.data.load()
        %data[%length].store(%value)
        %self.length.store(%wanted)
        jump sift_up(%length)

    block sift_up(%index: USize):
        %at_root : Bool = %index.eq(0)
        branch %at_root ? return() : compare_parent(%index)

    block compare_parent(%index: USize):
        %parent       : USize  = %index.sub(1).div(2)
        %data         : Ptr<T> = %self.data.load()
        %child_value  : T      = %data[%index].load()
        %parent_value : T      = %data[%parent].load()
        %less         : Bool   = %child_value.less(%parent_value)
        branch %less ? swap(%index, %parent, %child_value, %parent_value) : return()

    block swap(%index: USize, %parent: USize, %child_value: T, %parent_value: T):
        %data : Ptr<T> = %self.data.load()
        %data[%parent].store(%child_value)
        %data[%index].store(%parent_value)
        jump sift_up(%parent)

routine PriorityQueue<T>.peek(%self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length : USize = %self.length.load()
        %empty  : Bool  = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : load()

    block load():
        %data  : Ptr<T> = %self.data.load()
        %value : T      = %data[0].load()
        return(%value)

routine PriorityQueue<T>.pop(%self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length : USize = %self.length.load()
        %empty  : Bool  = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : remove_root(%length)

    block remove_root(%length: USize):
        %data       : Ptr<T> = %self.data.load()
        %result     : T      = %data[0].load()
        %new_length : USize  = %length.sub(1)
        %self.length.store(%new_length)
        %now_empty : Bool = %new_length.eq(0)
        branch %now_empty ? return(%result): move_last(%result, %new_length)

    block move_last(%result: T, %new_length: USize):
        %data : Ptr<T> = %self.data.load()
        %last : T      = %data[%new_length].load()
        %data[0].store(%last)
        jump sift_down(0, %result)

    block sift_down(%index: USize, %result: T):
        %length   : USize = %self.length.load()
        %left     : USize = %index.mul(2).add(1)
        %right    : USize = %left.add(1)
        %has_left : Bool  = %left.lt(%length)
        branch %has_left ? choose_child(%index, %left, %right, %result) : return(%result)

    block choose_child(%index: USize, %left: USize, %right: USize, %result: T):
        %length    : USize = %self.length.load()
        %has_right : Bool  = %right.lt(%length)
        branch %has_right
            ? compare_children(%index, %left, %right, %result)
            : compare_with_child(%index, %left, %result)

    block compare_children(%index: USize, %left: USize, %right: USize, %result: T):
        %data        : Ptr<T> = %self.data.load()
        %left_value  : T      = %data[%left].load()
        %right_value : T      = %data[%right].load()
        %right_less  : Bool   = %right_value.less(%left_value)
        %child       : USize  = %right_less ? %right : %left
        jump compare_with_child(%index, %child, %result)

    block compare_with_child(%index: USize, %child: USize, %result: T):
        %data        : Ptr<T> = %self.data.load()
        %index_value : T      = %data[%index].load()
        %child_value : T      = %data[%child].load()
        %child_less  : Bool   = %child_value.less(%index_value)
        branch %child_less
            ? swap_down(%index, %child, %index_value, %child_value, %result)
            : return(%result)

    block swap_down(%index: USize, %child: USize, %index_value: T, %child_value: T, %result: T):
        %data : Ptr<T> = %self.data.load()
        %data[%index].store(%child_value)
        %data[%child].store(%index_value)
        jump sift_down(%child, %result)

routine PriorityQueue<T>.clear(%self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %self.length.store(0)
        return()

routine PriorityQueue<T>.destruct(%self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %data  : Ptr<T> = %self.data.load()
        %empty : Bool   = %data.is_null()
        branch %empty ? reset() : release(%data)

    block release(%data: Ptr<T>):
        %alloc : Ptr<Allocator> = %self.alloc.load()
        %data.free(%alloc)
        jump reset()

    block reset():
        %self.data.store(null)
        %self.length.store(0)
        %self.capacity.store(0)
        return()

/// Destructs every element, then the queue itself: for elements the queue owns.
routine PriorityQueue<T>.destruct_all(%self: Ptr<Self>) -> Void
require T: typename, Destruct<T>
    block entry():
        %length : USize  = %self.length.load()
        %data   : Ptr<T> = %self.data.load()
        jump loop(0, %length, %data)

    block loop(%i: USize, %length: USize, %data: Ptr<T>):
        %done : Bool = %i.ge(%length)
        branch %done ? finish() : element(%i, %length, %data)

    block element(%i: USize, %length: USize, %data: Ptr<T>):
        %item : Ptr<T> = %data[%i]
        %item.destruct()
        jump loop(%i.add(1), %length, %data)

    block finish():
        %self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements in heap order (the top first, the rest not sorted), each
/// diagnosed (strings quoted): [1, 4, 2].
routine PriorityQueue<T>.represent<W>(%self: Self, %out: Ptr<W>) -> Void
require T: typename, Priority<T>, Diagnose<T>, W: typename, Writer<W>
    block entry():
        write_str(%out, "[")
        jump walk(0)

    block walk(%at: USize):
        %length : USize = %self.length
        %more   : Bool  = %at.lt(%length)
        branch %more ? item(%at) : close()

    block item(%at: USize):
        %first : Bool = %at.eq(0)
        branch %first ? element(%at) : comma(%at)

    block comma(%at: USize):
        write_str(%out, ", ")
        jump element(%at)

    block element(%at: USize):
        %data  : Ptr<T> = %self.data
        %value : T      = %data[%at].load()
        %value.diagnose(%out)
        jump walk(%at.add(1))

    block close():
        write_str(%out, "]")
        return()

/// The elements in heap order (the top first, the rest not sorted), each
/// diagnosed: [1, 4, 2].
routine PriorityQueue<T>.diagnose<W>(%self: Self, %out: Ptr<W>) -> Void
require T: typename, Priority<T>, Diagnose<T>, W: typename, Writer<W>
    block entry():
        write_str(%out, "[")
        jump walk(0)

    block walk(%at: USize):
        %length : USize = %self.length
        %more   : Bool  = %at.lt(%length)
        branch %more ? item(%at) : close()

    block item(%at: USize):
        %first : Bool = %at.eq(0)
        branch %first ? element(%at) : comma(%at)

    block comma(%at: USize):
        write_str(%out, ", ")
        jump element(%at)

    block element(%at: USize):
        %data  : Ptr<T> = %self.data
        %value : T      = %data[%at].load()
        %value.diagnose(%out)
        jump walk(%at.add(1))

    block close():
        write_str(%out, "]")
        return()
