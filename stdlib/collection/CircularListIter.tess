// Tessera stdlib collection: CircularListIter<T>
//
// Forward iterator over CircularList<T>, yielding elements front-to-back.
// Delegates index-to-physical mapping to CircularList.get, which reads data[start + index].
//
// Satisfies concept Iterator<T, CircularListIter<T>>.

module Standard::Collections

record CircularListIter<T>
conform Iterator<T, CircularListIter<T>>
require T: typename
    circular_list : @CircularList<T>
    index         : USize

routine CircularListIter<T>.construct(%circular_list: @CircularList<T>) -> Self
require T: typename
    block entry():
        %iter : Self = Self { circular_list: %circular_list, index: 0 }
        return(%iter)

routine CircularListIter<T>.next(%self: @Self) -> Option<T>
require T: typename
    block entry():
        %circular_list : @CircularList<T> = %self.circular_list.load()
        %len           : USize            = %circular_list.load().length()
        %index         : USize            = %self.index.load()
        %done          : Bool             = %index.ge(%len)
        branch %done
            ? return_none()
            : return_some(%index, %circular_list)

    block return_none():
        %none : Option<T> = .Absent
        return(%none)

    block return_some(%index: USize, %circular_list: @CircularList<T>):
        %value : T = %circular_list.load().get(%index)
        %self.index.store(%index.add(1))
        %some : Option<T> = .Present(%value)
        return(%some)
