// Tessera stdlib collection: CircularListIter<T>
//
// Forward iterator over CircularList<T>, yielding elements front-to-back.
// Delegates index-to-physical mapping to CircularList.get, which reads data[start + index].
//
// Satisfies concept Iterator<T, CircularListIter<T>>.

module Standard::Collections

record CircularListIter<T>
conform Iterator<T, CircularListIter<T>>
require T: typename
    circular_list: Ptr<CircularList<T>>
    index: U64

routine CircularListIter<T>.construct(#circular_list: Ptr<CircularList<T>>) -> Self
require T: typename
    block entry():
        %iter: Self = Self { circular_list: #circular_list, index: 0 }
        return(%iter)

routine CircularListIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        #circular_list: Ptr<CircularList<T>> = #self.circular_list.load()
        %len:   U64           = #circular_list.length()
        %index: U64           = #self.index.load()
        %done:  Bool          = %index.ge(%len)
        branch %done ? return_none() : return_some(%index, #circular_list)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%index: U64, #circular_list: Ptr<CircularList<T>>):
        %value: T = #circular_list.get(%index)
        %index_next: U64 = %index.add(1)
        #self.index.store(%index_next)
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
