// Tessera stdlib collection: SortedDictIter<K, V>
//
// In-order iterator over SortedDict<K, V>.  Yields KVPair<K, V> with keys in
// ascending sorted order, using the order-statistic routines key_order and
// get_order.  Each next() makes two O(log n) tree walks (one per field).
//
// See SortedSetIter.tess for a note on the O(n log n) vs O(n) tradeoff.
//
// KVPair<K, V> is defined in option.tess.
//
// Satisfies concept Iterator<KVPair<K, V>, SortedDictIter<K, V>>.

module Standard::Collections

record SortedDictIter<K, V>
conform Iterator<KVPair<K, V>, SortedDictIter<K, V>>
require K: typename, V: typename
    map:   Ptr<SortedDict<K, V>>
    order: U64
    total: U64

routine SortedDictIter<K, V>.construct(#map: Ptr<SortedDict<K, V>>) -> Self
require K: typename, V: typename
    block entry():
        %total: U64 = #map.length()
        %iter: Self = Self { map: #map, order: 0, total: %total }
        return(%iter)

routine SortedDictIter<K, V>.next(#self: Ptr<Self>) -> Option<KVPair<K, V>>
require K: typename, V: typename
    block entry():
        %order: U64  = #self.order.load()
        %total: U64  = #self.total.load()
        %done:  Bool = %order.ge(%total)
        branch %done ? return_none() : return_some(%order)

    block return_none():
        %none: Option<KVPair<K, V>> = Option<KVPair<K, V>>.none()
        return(%none)

    block return_some(%order: U64):
        #map:   Ptr<SortedDict<K, V>> = #self.map.load()
        %key:   K                   = #map.key_order(%order)
        %value: V                   = #map.get_order(%order)
        %pair:  KVPair<K, V>        = KVPair<K, V> { key: %key, value: %value }
        %order_next: U64 = %order.add(1)
        #self.order.store(%order_next)
        %some: Option<KVPair<K, V>> = Option<KVPair<K, V>>.some(%pair)
        return(%some)
