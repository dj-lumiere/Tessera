// Tessera stdlib collection: collections as text
//
// A collection represents and diagnoses the same way, with its elements
// diagnosed, so strings keep their quotes: a list as ["a", "b"], a set as
// {1, 2, 3}, and a map as {"a": 1, "b": 2}. The order is the collection's
// iteration order. These helpers walk any iterator; each collection's
// represent and diagnose call them with its own brackets.

module Standard::Collections

import Standard::Format

/// %open, the items %iter yields separated by ", ", then %close; each item diagnosed.
routine diagnose_items<T, I, W>(%out: Ptr<W>, %iter: Ptr<I>, %open: Bytes, %close: Bytes) -> Void
require T: typename, I: typename, W: typename, Iterator<T, I>, Diagnose<T>, Writer<W>
    block entry():
        write_str(%out, %open)
        jump next(true)

    block next(%first: Bool):
        %item : Option<T> = %iter.next()
        when %item:
            .Present(%value) -> separate(%first, %value)
            .Absent          -> close()

    block separate(%first: Bool, %value: T):
        branch %first ? element(%value) : comma(%value)

    block comma(%value: T):
        write_str(%out, ", ")
        jump element(%value)

    block element(%value: T):
        %value.diagnose(%out)
        jump next(false)

    block close():
        write_str(%out, %close)
        return()

/// {key: value, ...} from an iterator over KVPairs, keys and values diagnosed.
routine diagnose_entries<K, V, I, W>(%out: Ptr<W>, %iter: Ptr<I>) -> Void
require K: typename, V: typename, I: typename, W: typename, Iterator<KVPair<K, V>, I>
require Diagnose<K>, Diagnose<V>, Writer<W>
    block entry():
        write_str(%out, "{")
        jump next(true)

    block next(%first: Bool):
        %item : Option<KVPair<K, V>> = %iter.next()
        when %item:
            .Present(%pair) -> separate(%first, %pair)
            .Absent         -> close()

    block separate(%first: Bool, %pair: KVPair<K, V>):
        branch %first ? element(%pair) : comma(%pair)

    block comma(%pair: KVPair<K, V>):
        write_str(%out, ", ")
        jump element(%pair)

    block element(%pair: KVPair<K, V>):
        %key   : K = %pair.key
        %value : V = %pair.value
        %key.diagnose(%out)
        write_str(%out, ": ")
        %value.diagnose(%out)
        jump next(false)

    block close():
        write_str(%out, "}")
        return()
