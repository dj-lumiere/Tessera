// Tessera stdlib collection: collections as text
//
// A collection represents and diagnoses the same way, with its elements
// diagnosed, so strings keep their quotes: a list as ["a", "b"], a set as
// {1, 2, 3}, and a map as {"a": 1, "b": 2}. The order is the collection's
// iteration order. These helpers walk any iterator; each collection's
// represent and diagnose call them with its own brackets.

module Standard::Collections

/// %open, the items #iter yields separated by ", ", then %close; each item diagnosed.
routine diagnose_items<T, I, W>(#out: Ptr<W>, #iter: Ptr<I>, %open: String, %close: String) -> Void
require T: typename, I: typename, W: typename, Iterator<T, I>, Diagnose<T>, Writer<W>
    block entry():
        write_str(#out, %open)
        jump next(true)

    block next(%first: Bool):
        %item : Option<T> = #iter.next()
        %more : Bool      = %item.tag
        branch %more ? separate(%first, %item) : close()

    block separate(%first: Bool, %item: Option<T>):
        branch %first ? element(%item) : comma(%item)

    block comma(%item: Option<T>):
        write_str(#out, ", ")
        jump element(%item)

    block element(%item: Option<T>):
        %value : T = %item.value
        %value.diagnose(#out)
        jump next(false)

    block close():
        write_str(#out, %close)
        return()

/// {key: value, ...} from an iterator over KVPairs, keys and values diagnosed.
routine diagnose_entries<K, V, I, W>(#out: Ptr<W>, #iter: Ptr<I>) -> Void
require K: typename, V: typename, I: typename, W: typename, Iterator<KVPair<K, V>, I>
require Diagnose<K>, Diagnose<V>, Writer<W>
    block entry():
        write_str(#out, "{")
        jump next(true)

    block next(%first: Bool):
        %entry : Option<KVPair<K, V>> = #iter.next()
        %more  : Bool                 = %entry.tag
        branch %more ? separate(%first, %entry) : close()

    block separate(%first: Bool, %entry: Option<KVPair<K, V>>):
        branch %first ? element(%entry) : comma(%entry)

    block comma(%entry: Option<KVPair<K, V>>):
        write_str(#out, ", ")
        jump element(%entry)

    block element(%entry: Option<KVPair<K, V>>):
        %pair  : KVPair<K, V> = %entry.value
        %key   : K            = %pair.key
        %value : V            = %pair.value
        %key.diagnose(#out)
        write_str(#out, ": ")
        %value.diagnose(#out)
        jump next(false)

    block close():
        write_str(#out, "}")
        return()
