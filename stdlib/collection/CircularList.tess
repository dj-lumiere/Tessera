; Tessera stdlib collection: CircularList<T>
;
; Dynamic array with a centered start index — front and back both grow without
; shifting. The allocator is stored in the record.
;
; Logical element i lives at data[start + i]. Front growth consumes spare slots
; before start; when either side runs out the live range is moved back to the
; center of a new buffer, twice as large if the circular_list is more than half full.

record CircularList<T>
conform Equal<CircularList<T>>
require T: typename, Equal<T>
    data: Ptr<T>
    start: I64
    length: I64
    capacity: I64
    alloc: Ptr<Allocator>

routine CircularList<T>.new(#alloc: Ptr<Allocator>) -> Self
require T: typename
    block entry():
        %circular_list: Self = Self {
            data: null,
            start: 0,
            length: 0,
            capacity: 0,
            alloc: #alloc
        }
        return(%circular_list)

routine CircularList<T>.length(#self: Ptr<Self>) -> I64
require T: typename
    block entry():
        %length: I64 := #self.length
        return(%length)

routine CircularList<T>.is_empty(#self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        return(%empty)

routine CircularList<T>.recenter(#self: Ptr<Self>, %new_capacity: I64) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %slack: I64 = %new_capacity.sub(%length)
        %new_start: I64 = %slack.sdiv(2)
        #alloc: Ptr<Allocator> := #self.alloc
        #new_data: Ptr<T> = alloc<T>(#alloc, %new_capacity)
        %failed: Bool = #new_data.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : move(#new_data, %new_start, %length, %new_capacity, #alloc)

    block move(
            #new_data: Ptr<T>, %new_start: I64, %length: I64,
            %new_capacity: I64, #alloc: Ptr<Allocator>):
        #old_data: Ptr<T> := #self.data
        %old_null: Bool = #old_data.is_null()
        branch %old_null
            ? install(#new_data, %new_start, %new_capacity)
            : copy_live(#new_data, %new_start, #old_data, %length, %new_capacity, #alloc)

    block copy_live(
            #new_data: Ptr<T>, %new_start: I64, #old_data: Ptr<T>,
            %length: I64, %new_capacity: I64, #alloc: Ptr<Allocator>):
        %old_start: I64 := #self.start
        #src: Ptr<T> = #old_data[%old_start]
        #dst: Ptr<T> = #new_data[%new_start]
        copy<T>(#dst, #src, %length)
        free<T>(#alloc, #old_data)
        jump install(#new_data, %new_start, %new_capacity)

    block install(#new_data: Ptr<T>, %new_start: I64, %new_capacity: I64):
        #self.data = #new_data
        #self.start = %new_start
        #self.capacity = %new_capacity
        return()

; The capacity to recenter into when one end runs out: double it only when the circular_list is more than half full.
; Otherwise the live range just moves back to the middle, so a queue (push_back / pop_front) keeps a bounded buffer
; instead of doubling each time its window drifts to the end.
routine CircularList<T>.grown_capacity(#self: Ptr<Self>, %capacity: I64) -> I64
require T: typename
    block entry():
        %length: I64 := #self.length
        %crowded: Bool = %length.mul(2).sgt(%capacity)
        %new_capacity: I64 = %crowded ? %capacity.mul(2) : %capacity
        return(%new_capacity)

routine CircularList<T>.ensure_front(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %start: I64 := #self.start
        %has_front_space: Bool = %start.sgt(0)
        branch %has_front_space ? return() : choose()

    block choose():
        %capacity: I64 := #self.capacity
        %empty: Bool = %capacity.eq(0)
        branch %empty ? initial() : grow(%capacity)

    block initial():
        #self.recenter(4)
        return()

    block grow(%capacity: I64):
        #self.recenter(#self.grown_capacity(%capacity))
        return()

routine CircularList<T>.ensure_back(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %start: I64 := #self.start
        %length: I64 := #self.length
        %capacity: I64 := #self.capacity
        %has_back_space: Bool = %start.add(%length).slt(%capacity)
        branch %has_back_space ? return() : choose(%capacity)

    block choose(%capacity: I64):
        %empty: Bool = %capacity.eq(0)
        branch %empty ? initial() : grow(%capacity)

    block initial():
        #self.recenter(4)
        return()

    block grow(%capacity: I64):
        #self.recenter(#self.grown_capacity(%capacity))
        return()

routine CircularList<T>.push_back(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        #self.ensure_back()
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %length: I64 := #self.length
        %index: I64 = %start.add(%length)
        #data[%index] = %value
        %new_length: I64 = %length.add(1)
        #self.length = %new_length
        return()

routine CircularList<T>.push(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        #self.push_back(%value)
        return()

routine CircularList<T>.push_front(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        #self.ensure_front()
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %new_start: I64 = %start.sub(1)
        #data[%new_start] = %value
        #self.start = %new_start
        %length: I64 := #self.length
        %new_length: I64 = %length.add(1)
        #self.length = %new_length
        return()

routine CircularList<T>.pop_back(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : pop(%length)

    block pop(%length: I64):
        %new_length: I64 = %length.sub(1)
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %index: I64 = %start.add(%new_length)
        %value: T := #data[%index]
        #self.length = %new_length
        return(%value)

routine CircularList<T>.pop(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %value: T = #self.pop_back()
        return(%value)

routine CircularList<T>.pop_front(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : pop(%length)

    block pop(%length: I64):
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %value: T := #data[%start]
        #self.start = %start.add(1)
        %new_length: I64 = %length.sub(1)
        #self.length = %new_length
        return(%value)

routine CircularList<T>.get(#self: Ptr<Self>, %index: I64) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %index.sge(0).bitand(%index.slt(%length))
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: I64):
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %value: T := #data[%start.add(%index)]
        return(%value)

routine CircularList<T>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, Equal<T>
    block entry():
        %la: I64 := #self.length
        %lb: I64 := #other.length
        %same_len: Bool = %la.eq(%lb)
        branch %same_len ? scan(%la) : return(false)

    block scan(%len: I64):
        %sa: I64 := #self.start
        %sb: I64 := #other.start
        #pa: Ptr<T> := #self.data
        #pb: Ptr<T> := #other.data
        jump loop(0, %len, %sa, %sb, #pa, #pb)

    block loop(%i: I64, %len: I64, %sa: I64, %sb: I64, #pa: Ptr<T>, #pb: Ptr<T>):
        %done: Bool = %i.sge(%len)
        branch %done ? return(true) : step(%i, %len, %sa, %sb, #pa, #pb)

    block step(%i: I64, %len: I64, %sa: I64, %sb: I64, #pa: Ptr<T>, #pb: Ptr<T>):
        %ia: I64 = %sa.add(%i)
        %ib: I64 = %sb.add(%i)
        %x: T := #pa[%ia]
        %y: T := #pb[%ib]
        %eq: Bool = %x.eq(%y)
        branch %eq ? loop(%i.add(1), %len, %sa, %sb, #pa, #pb) : return(false)

routine CircularList<T>.set(#self: Ptr<Self>, %index: I64, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %index.sge(0).bitand(%index.slt(%length))
        branch %in_bounds ? store(%index, %value) : panic(TrapCode.Bounds)

    block store(%index: I64, %value: T):
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        #data[%start.add(%index)] = %value
        return()

routine CircularList<T>.clear(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %capacity: I64 := #self.capacity
        %start: I64 = %capacity.sdiv(2)
        #self.start = %start
        #self.length = 0
        return()

routine CircularList<T>.free(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #data: Ptr<T> := #self.data
        %empty: Bool = #data.is_null()
        branch %empty ? reset() : release(#data)

    block release(#data: Ptr<T>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<T>(#alloc, #data)
        jump reset()

    block reset():
        #self.data = null
        #self.start = 0
        #self.length = 0
        #self.capacity = 0
        return()
