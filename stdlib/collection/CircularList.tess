// Tessera stdlib collection: CircularList<T>
//
// Dynamic array with a centered start index — front and back both grow without
// shifting. The allocator is stored in the record.
//
// Logical element i lives at data[start + i]. Front growth consumes spare slots
// before start; when either side runs out the live range is moved back to the
// center of a new buffer, twice as large if the circular_list is more than half full.

module Standard::Collections

record CircularList<T>
conform Destruct<CircularList<T>>
require T: typename
    data: Ptr<T>
    start: U64
    length: U64
    capacity: U64
    alloc: Ptr<Allocator>

routine CircularList<T>.construct(#alloc: Ptr<Allocator>) -> Self
require T: typename
    block entry():
        %circular_list: Self = Self {
            data: null,
            start: 0,
            length: 0,
            capacity: 0,
            alloc: #alloc
        }
        return(%circular_list)

routine CircularList<T>.length(#self: Ptr<Self>) -> U64
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        return(%length)

routine CircularList<T>.is_empty(#self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %empty: Bool = %length.eq(0)
        return(%empty)

routine CircularList<T>.recenter(#self: Ptr<Self>, %new_capacity: U64) -> Void
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %slack: U64 = %new_capacity.sub(%length)
        %new_start: U64 = %slack.div(2)
        #alloc: Ptr<Allocator> = #self.alloc.load()
        #new_data: Ptr<T> = alloc<T>(#alloc, %new_capacity)
        %failed: Bool = #new_data.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : move(#new_data, %new_start, %length, %new_capacity, #alloc)

    block move(
            #new_data: Ptr<T>, %new_start: U64, %length: U64,
            %new_capacity: U64, #alloc: Ptr<Allocator>):
        #old_data: Ptr<T> = #self.data.load()
        %old_null: Bool = #old_data.is_null()
        branch %old_null
            ? install(#new_data, %new_start, %new_capacity)
            : copy_live(#new_data, %new_start, #old_data, %length, %new_capacity, #alloc)

    block copy_live(
            #new_data: Ptr<T>, %new_start: U64, #old_data: Ptr<T>,
            %length: U64, %new_capacity: U64, #alloc: Ptr<Allocator>):
        %old_start: U64 = #self.start.load()
        #src: Ptr<T> = #old_data[%old_start]
        #dst: Ptr<T> = #new_data[%new_start]
        copy<T>(#dst, #src, %length)
        #old_data.free(#alloc)
        jump install(#new_data, %new_start, %new_capacity)

    block install(#new_data: Ptr<T>, %new_start: U64, %new_capacity: U64):
        #self.data.store(#new_data)
        #self.start.store(%new_start)
        #self.capacity.store(%new_capacity)
        return()

/// The capacity to recenter into when one end runs out: double it only when the circular_list is more than half full.
/// Otherwise the live range just moves back to the middle, so a queue (push_back / pop_front) keeps a bounded buffer
/// instead of doubling each time its window drifts to the end.
routine CircularList<T>.grown_capacity(#self: Ptr<Self>, %capacity: U64) -> U64
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %crowded: Bool = %length.mul(2).gt(%capacity)
        %new_capacity: U64 = %crowded ? %capacity.mul(2) : %capacity
        return(%new_capacity)

routine CircularList<T>.ensure_front(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %start: U64 = #self.start.load()
        %has_front_space: Bool = %start.gt(0)
        branch %has_front_space ? return() : choose()

    block choose():
        %capacity: U64 = #self.capacity.load()
        %empty: Bool = %capacity.eq(0)
        branch %empty ? initial() : grow(%capacity)

    block initial():
        #self.recenter(4)
        return()

    block grow(%capacity: U64):
        #self.recenter(#self.grown_capacity(%capacity))
        return()

routine CircularList<T>.ensure_back(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %start: U64 = #self.start.load()
        %length: U64 = #self.length.load()
        %capacity: U64 = #self.capacity.load()
        %has_back_space: Bool = %start.add(%length).lt(%capacity)
        branch %has_back_space ? return() : choose(%capacity)

    block choose(%capacity: U64):
        %empty: Bool = %capacity.eq(0)
        branch %empty ? initial() : grow(%capacity)

    block initial():
        #self.recenter(4)
        return()

    block grow(%capacity: U64):
        #self.recenter(#self.grown_capacity(%capacity))
        return()

routine CircularList<T>.push_back(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        #self.ensure_back()
        #data: Ptr<T> = #self.data.load()
        %start: U64 = #self.start.load()
        %length: U64 = #self.length.load()
        %index: U64 = %start.add(%length)
        #data[%index].store(%value)
        %new_length: U64 = %length.add(1)
        #self.length.store(%new_length)
        return()

routine CircularList<T>.push(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        #self.push_back(%value)
        return()

routine CircularList<T>.push_front(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        #self.ensure_front()
        #data: Ptr<T> = #self.data.load()
        %start: U64 = #self.start.load()
        %new_start: U64 = %start.sub(1)
        #data[%new_start].store(%value)
        #self.start.store(%new_start)
        %length: U64 = #self.length.load()
        %new_length: U64 = %length.add(1)
        #self.length.store(%new_length)
        return()

routine CircularList<T>.pop_back(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %empty: Bool = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : pop(%length)

    block pop(%length: U64):
        %new_length: U64 = %length.sub(1)
        #data: Ptr<T> = #self.data.load()
        %start: U64 = #self.start.load()
        %index: U64 = %start.add(%new_length)
        %value: T = #data[%index].load()
        #self.length.store(%new_length)
        return(%value)

routine CircularList<T>.pop(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %value: T = #self.pop_back()
        return(%value)

routine CircularList<T>.pop_front(#self: Ptr<Self>) -> T
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %empty: Bool = %length.eq(0)
        branch %empty ? panic(TrapCode.Empty) : pop(%length)

    block pop(%length: U64):
        #data: Ptr<T> = #self.data.load()
        %start: U64 = #self.start.load()
        %value: T = #data[%start].load()
        #self.start.store(%start.add(1))
        %new_length: U64 = %length.sub(1)
        #self.length.store(%new_length)
        return(%value)

routine CircularList<T>.get(#self: Ptr<Self>, %index: U64) -> T
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %in_bounds: Bool = %index.lt(%length)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: U64):
        #data: Ptr<T> = #self.data.load()
        %start: U64 = #self.start.load()
        %value: T = #data[%start.add(%index)].load()
        return(%value)

routine CircularList<T>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, Equal<T>
    block entry():
        %la: U64 = #self.length.load()
        %lb: U64 = #other.length.load()
        %same_len: Bool = %la.eq(%lb)
        branch %same_len ? scan(%la) : return(false)

    block scan(%len: U64):
        %sa: U64 = #self.start.load()
        %sb: U64 = #other.start.load()
        #pa: Ptr<T> = #self.data.load()
        #pb: Ptr<T> = #other.data.load()
        jump loop(0, %len, %sa, %sb, #pa, #pb)

    block loop(%i: U64, %len: U64, %sa: U64, %sb: U64, #pa: Ptr<T>, #pb: Ptr<T>):
        %done: Bool = %i.ge(%len)
        branch %done ? return(true) : step(%i, %len, %sa, %sb, #pa, #pb)

    block step(%i: U64, %len: U64, %sa: U64, %sb: U64, #pa: Ptr<T>, #pb: Ptr<T>):
        %ia: U64 = %sa.add(%i)
        %ib: U64 = %sb.add(%i)
        %x: T = #pa[%ia].load()
        %y: T = #pb[%ib].load()
        %eq: Bool = %x.eq(%y)
        branch %eq ? loop(%i.add(1), %len, %sa, %sb, #pa, #pb) : return(false)

routine CircularList<T>.set(#self: Ptr<Self>, %index: U64, %value: T) -> Void
require T: typename
    block entry():
        %length: U64 = #self.length.load()
        %in_bounds: Bool = %index.lt(%length)
        branch %in_bounds ? store(%index, %value) : panic(TrapCode.Bounds)

    block store(%index: U64, %value: T):
        #data: Ptr<T> = #self.data.load()
        %start: U64 = #self.start.load()
        #data[%start.add(%index)].store(%value)
        return()

routine CircularList<T>.clear(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %capacity: U64 = #self.capacity.load()
        %start: U64 = %capacity.div(2)
        #self.start.store(%start)
        #self.length.store(0)
        return()

routine CircularList<T>.destruct(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #data: Ptr<T> = #self.data.load()
        %empty: Bool = #data.is_null()
        branch %empty ? reset() : release(#data)

    block release(#data: Ptr<T>):
        #alloc: Ptr<Allocator> = #self.alloc.load()
        #data.free(#alloc)
        jump reset()

    block reset():
        #self.data.store(null)
        #self.start.store(0)
        #self.length.store(0)
        #self.capacity.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine CircularList<T>.destruct_all(#self: Ptr<Self>) -> Void
require T: typename, Destruct<T>
    block entry():
        %iter_val: CircularListIter<T> = CircularListIter<T>.construct(#self)
        #iter:     Ptr<CircularListIter<T>> = alloca
        #iter.store(%iter_val)
        #slot:     Ptr<T> = alloca
        jump next(#iter, #slot)

    block next(#iter: Ptr<CircularListIter<T>>, #slot: Ptr<T>):
        %item: Option<T> = #iter.next()
        %more: Bool = %item.tag
        branch %more ? element(#iter, #slot, %item.value) : finish()

    block element(#iter: Ptr<CircularListIter<T>>, #slot: Ptr<T>, %value: T):
        #slot.store(%value)
        #slot.destruct()
        jump next(#iter, #slot)

    block finish():
        #self.destruct()
        return()
