; Tessera stdlib collection: BTreeSet<T>
;
; Ordered set with its own order-statistic B-tree node and fixed node key
; capacity of NODE_KEYS. The allocator is stored in BTreeSet; node helpers
; still receive it as a parameter.

const NODE_KEYS: I64 = 7
const NODE_CHILDREN: I64 = 8
const NODE_MIN_KEYS: I64 = 4

struct BTreeSetNode<T>
require T: typename
    leaf: Bool
    length: I64
    subtree_count: I64
    keys: Array<T, NODE_KEYS>
    children: Array<Ptr<BTreeSetNode<T>>, NODE_CHILDREN>

struct BTreeSet<T>
conform Equal<BTreeSet<T>>
require T: typename, Compare<T>
    root: Ptr<BTreeSetNode<T>>
    length: I64
    alloc: Ptr<Allocator>

routine BTreeSet<T>.new(#alloc: Ptr<Allocator>) -> Self
require T: typename, Compare<T>
    block entry():
        %set: Self = Self {
            root: null,
            length: 0,
            alloc: #alloc
        }
        return(%set)

routine BTreeSet<T>.length(#self: Ptr<Self>) -> I64
require T: typename
    block entry():
        %length: I64 := #self.length
        return(%length)

routine BTreeSet<T>.is_empty(#self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length.eq(0)
        return(%empty)

routine BTreeSetNode<T>.new(%leaf: Bool, #alloc: Ptr<Allocator>) -> Ptr<BTreeSetNode<T>>
require T: typename
    block entry():
        #node: Ptr<BTreeSetNode<T>> = alloc<BTreeSetNode<T>>(#alloc, 1)
        %failed: Bool = #node.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : init(#node, %leaf)

    block init(#node: Ptr<BTreeSetNode<T>>, %leaf: Bool):
        #node.leaf = %leaf
        #node.length = 0
        #node.subtree_count = 0
        return(#node)

routine BTreeSetNode<T>.count(#self: Ptr<Self>) -> I64
require T: typename
    block entry():
        %empty: Bool = #self.is_null()
        branch %empty ? return(0): count(#self)

    block count(#self: Ptr<Self>):
        %count: I64 := #self.subtree_count
        return(%count)

routine BTreeSetNode<T>.recount(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        %length: I64 := #self.length
        branch %leaf ? leaf_count(%length) : internal_count(%length)

    block leaf_count(%length: I64):
        #self.subtree_count = %length
        return()

    block internal_count(%length: I64):
        jump loop(0, 0, %length)

    block loop(%i: I64, %sum: I64, %length: I64):
        %done: Bool = %i.sgt(%length)
        branch %done ? finish(%sum) : add_child(%i, %sum, %length)

    block add_child(%i: I64, %sum: I64, %length: I64):
        #child: Ptr<BTreeSetNode<T>> := #self.children[%i]
        %child_count: I64 = #child.count()
        %with_child: I64 = %sum.add(%child_count)
        %has_key: Bool = %i.slt(%length)
        %with_child_p1: I64 = %with_child.add(1)
        %next_sum: I64 = %has_key ? %with_child_p1 : %with_child
        jump loop(%i.add(1), %next_sum, %length)

    block finish(%sum: I64):
        #self.subtree_count = %sum
        return()

routine BTreeSet<T>.find_index(#self: Ptr<Self>, #node: Ptr<BTreeSetNode<T>>, %key: T) -> I64
require T: typename
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %length: I64 := #node.length
        %done: Bool = %i.sge(%length)
        branch %done ? return(%i): compare(%i)

    block compare(%i: I64):
        %node_key: T := #node.keys[%i]
        %cmp: I32 = %key.compare(%node_key)
        %before_or_equal: Bool = %cmp.sle(0)
        branch %before_or_equal ? return(%i): loop(%i.add(1))

; BTreeSets are sorted, so structural in-order comparison gives set equality
; without an extra contains() lookup per element.
routine BTreeSet<T>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, Compare<T>
    block entry():
        %la: I64 := #self.length
        %lb: I64 := #other.length
        %same_len: Bool = %la.eq(%lb)
        branch %same_len ? loop(0, %la) : return(false)

    block loop(%i: I64, %len: I64):
        %done: Bool = %i.sge(%len)
        branch %done ? return(true) : step(%i, %len)

    block step(%i: I64, %len: I64):
        %x: T = #self.get_order(%i)
        %y: T = #other.get_order(%i)
        %cmp: I32 = %x.compare(%y)
        %eq: Bool = %cmp.eq(0)
        branch %eq ? loop(%i.add(1), %len) : return(false)

routine BTreeSet<T>.contains(#self: Ptr<Self>, %key: T) -> Bool
require T: typename
    block entry():
        #root: Ptr<BTreeSetNode<T>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? return(false): search(#root, %key)

    block search(#node: Ptr<BTreeSetNode<T>>, %key: T):
        %i: I64 = #self.find_index(#node, %key)
        %length: I64 := #node.length
        %inside: Bool = %i.slt(%length)
        branch %inside ? maybe_match(#node, %i, %key) : descend_or_missing(#node, %i, %key)

    block maybe_match(#node: Ptr<BTreeSetNode<T>>, %i: I64, %key: T):
        %node_key: T := #node.keys[%i]
        %cmp: I32 = %key.compare(%node_key)
        %equal: Bool = %cmp.eq(0)
        branch %equal ? return(true): descend_or_missing(#node, %i, %key)

    block descend_or_missing(#node: Ptr<BTreeSetNode<T>>, %i: I64, %key: T):
        %leaf: Bool := #node.leaf
        branch %leaf ? return(false): descend(#node, %i, %key)

    block descend(#node: Ptr<BTreeSetNode<T>>, %i: I64, %key: T):
        #child: Ptr<BTreeSetNode<T>> := #node.children[%i]
        jump search(#child, %key)

routine BTreeSet<T>.get_order(#self: Ptr<Self>, %order: I64) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %in_bounds: Bool = %order.sge(0).bitand(%order.slt(%length))
        branch %in_bounds ? select_root(%order) : panic(TrapCode.Bounds)

    block select_root(%order: I64):
        #root: Ptr<BTreeSetNode<T>> := #self.root
        jump select_node(#root, %order)

    block select_node(#node: Ptr<BTreeSetNode<T>>, %order: I64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64):
        %length: I64 := #node.length
        %done: Bool = %i.sge(%length)
        branch %done ? last_child(#node, %order, %i) : check_child(#node, %order, %i)

    block check_child(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64):
        %leaf: Bool := #node.leaf
        branch %leaf ? leaf_key(#node, %order, %i) : internal_child(#node, %order, %i)

    block leaf_key(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64):
        %match: Bool = %order.eq(%i)
        branch %match ? load_key(#node, %i) : scan(#node, %order, %i.add(1))

    block internal_child(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64):
        #child: Ptr<BTreeSetNode<T>> := #node.children[%i]
        %child_count: I64 = #child.count()
        %in_child: Bool = %order.slt(%child_count)
        branch %in_child ? select_node(#child, %order) : check_key(#node, %order, %i, %child_count)

    block check_key(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64, %child_count: I64):
        %after_child: I64 = %order.sub(%child_count)
        %is_key: Bool = %after_child.eq(0)
        branch %is_key ? load_key(#node, %i) : scan(#node, %after_child.sub(1), %i.add(1))

    block last_child(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64):
        %leaf: Bool := #node.leaf
        branch %leaf ? panic(TrapCode.Unreachable) : descend_last(#node, %order, %i)

    block descend_last(#node: Ptr<BTreeSetNode<T>>, %order: I64, %i: I64):
        #child: Ptr<BTreeSetNode<T>> := #node.children[%i]
        jump select_node(#child, %order)

    block load_key(#node: Ptr<BTreeSetNode<T>>, %i: I64):
        %key: T := #node.keys[%i]
        return(%key)

routine BTreeSetNode<T>.split_child(
        #self: Ptr<Self>, %index: I64, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        #left: Ptr<BTreeSetNode<T>> := #self.children[%index]
        %leaf: Bool := #left.leaf
        #right: Ptr<BTreeSetNode<T>> = BTreeSetNode<T>.new(%leaf, #alloc)
        %mid: I64 = NODE_KEYS.sdiv(2)
        %node_keys_m_mid: I64 = NODE_KEYS.sub(%mid)
        %right_count: I64 = %node_keys_m_mid.sub(1)
        %mid_p1: I64 = %mid.add(1)
        #right.keys.copy(0, #left.keys, %mid_p1, %right_count)
        #right.length = %right_count
        branch %leaf
            ? promote(#left, #right, %mid)
            : copy_children(#left, #right, %mid, %right_count)

    block copy_children(
            #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %mid: I64, %right_count: I64):
        jump child_loop(0, #left, #right, %mid, %right_count)

    block child_loop(
            %i: I64, #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %mid: I64, %right_count: I64):
        %done: Bool = %i.sgt(%right_count)
        branch %done
            ? promote(#left, #right, %mid)
            : child_copy(%i, #left, #right, %mid, %right_count)

    block child_copy(
            %i: I64, #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %mid: I64, %right_count: I64):
        %src: I64 = %mid.add(1).add(%i)
        #child: Ptr<BTreeSetNode<T>> := #left.children[%src]
        #right.children[%i] = #child
        jump child_loop(%i.add(1), #left, #right, %mid, %right_count)

    block promote(
            #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>, %mid: I64):
        %parent_length: I64 := #self.length
        #self.keys.shift_right(%index, %parent_length)
        jump shift_children(%parent_length, #left, #right, %mid)

    block shift_children(
            %i: I64, #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>, %mid: I64):
        %stop: I64 = %index.add(1)
        %done: Bool = %i.slt(%stop)
        branch %done ? install(#left, #right, %mid) : move_child(%i, #left, #right, %mid)

    block move_child(
            %i: I64, #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>, %mid: I64):
        #child: Ptr<BTreeSetNode<T>> := #self.children[%i]
        #self.children[%i.add(1)] = #child
        jump shift_children(%i.sub(1), #left, #right, %mid)

    block install(
            #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>, %mid: I64):
        %middle_key: T := #left.keys[%mid]
        #self.keys[%index] = %middle_key
        #self.children[%index.add(1)] = #right
        #left.length = %mid
        %parent_length: I64 := #self.length
        #self.length = %parent_length.add(1)
        #left.recount()
        #right.recount()
        #self.recount()
        return()

routine BTreeSetNode<T>.insert_nonfull(
        #self: Ptr<Self>, #set: Ptr<BTreeSet<T>>,
        %key: T, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? insert_leaf() : insert_internal()

    block insert_leaf():
        %slot: I64 = #set.find_index(#self, %key)
        %length: I64 := #self.length
        #self.keys.shift_right(%slot, %length)
        #self.keys[%slot] = %key
        %new_length: I64 = %length.add(1)
        #self.length = %new_length
        #self.subtree_count = %new_length
        return()

    block insert_internal():
        %slot: I64 = #set.find_index(#self, %key)
        #child: Ptr<BTreeSetNode<T>> := #self.children[%slot]
        %child_length: I64 := #child.length
        %full: Bool = %child_length.eq(NODE_KEYS)
        branch %full ? split_then_insert(%slot, #child) : descend(%slot, #child)

    block split_then_insert(%slot: I64, #child: Ptr<BTreeSetNode<T>>):
        #self.split_child(%slot, #alloc)
        %pivot: T := #self.keys[%slot]
        %cmp: I32 = %key.compare(%pivot)
        %go_right: Bool = %cmp.sgt(0)
        %slot_p1: I64 = %slot.add(1)
        %next_slot: I64 = %go_right ? %slot_p1 : %slot
        #next_child: Ptr<BTreeSetNode<T>> := #self.children[%next_slot]
        jump descend(%next_slot, #next_child)

    block descend(%slot: I64, #child: Ptr<BTreeSetNode<T>>):
        #child.insert_nonfull(#set, %key, #alloc)
        #self.recount()
        return()

routine BTreeSet<T>.add(#self: Ptr<Self>, %key: T) -> Bool
require T: typename
    block entry():
        %exists: Bool = #self.contains(%key)
        branch %exists ? return(false): insert()

    block insert():
        #alloc: Ptr<Allocator> := #self.alloc
        #root: Ptr<BTreeSetNode<T>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? first_root(#alloc) : insert_root(#root, #alloc)

    block first_root(#alloc: Ptr<Allocator>):
        #root: Ptr<BTreeSetNode<T>> = BTreeSetNode<T>.new(true, #alloc)
        #root.keys[0] = %key
        #root.length = 1
        #root.subtree_count = 1
        #self.root = #root
        #self.length = 1
        return(true)

    block insert_root(#root: Ptr<BTreeSetNode<T>>, #alloc: Ptr<Allocator>):
        %root_length: I64 := #root.length
        %full: Bool = %root_length.eq(NODE_KEYS)
        branch %full ? split_root(#root, #alloc) : insert_nonfull(#root, #alloc)

    block split_root(#old_root: Ptr<BTreeSetNode<T>>, #alloc: Ptr<Allocator>):
        #new_root: Ptr<BTreeSetNode<T>> = BTreeSetNode<T>.new(false, #alloc)
        #new_root.children[0] = #old_root
        #self.root = #new_root
        #new_root.split_child(0, #alloc)
        jump insert_nonfull(#new_root, #alloc)

    block insert_nonfull(#root: Ptr<BTreeSetNode<T>>, #alloc: Ptr<Allocator>):
        #root.insert_nonfull(#self, %key, #alloc)
        %length: I64 := #self.length
        #self.length = %length.add(1)
        return(true)

routine BTreeSetNode<T>.remove_leaf_at(#self: Ptr<Self>, %index: I64) -> T
require T: typename
    block entry():
        %old: T := #self.keys[%index]
        %length: I64 := #self.length
        #self.keys.shift_left(%index, %length)
        %new_length: I64 = %length.sub(1)
        #self.length = %new_length
        #self.subtree_count = %new_length
        return(%old)

; Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
; length >= NODE_MIN_KEYS - 1.
; Helpers below ensure a child has length >= 4 (= t) before any deletion
; descent so the child can absorb a one-key drop without underflowing.

routine BTreeSetNode<T>.borrow_from_left(#self: Ptr<Self>, %i: I64) -> Void
require T: typename
    block entry():
        %i_m1: I64 = %i.sub(1)
        #left: Ptr<BTreeSetNode<T>> := #self.children[%i_m1]
        #child: Ptr<BTreeSetNode<T>> := #self.children[%i]
        %left_length: I64 := #left.length
        %child_length: I64 := #child.length
        #child.keys.shift_right(0, %child_length)
        %pivot: T := #self.keys[%i_m1]
        #child.keys[0] = %pivot
        %new_pivot: T := #left.keys[%left_length.sub(1)]
        #self.keys[%i_m1] = %new_pivot
        %leaf: Bool := #child.leaf
        branch %leaf
            ? finalize(#left, #child, %left_length, %child_length)
            : move_child(#left, #child, %left_length, %child_length)

    block move_child(
            #left: Ptr<BTreeSetNode<T>>, #child: Ptr<BTreeSetNode<T>>,
            %left_length: I64, %child_length: I64):
        %child_count: I64 = %child_length.add(1)
        #child.children.shift_right(0, %child_count)
        #moved: Ptr<BTreeSetNode<T>> := #left.children[%left_length]
        #child.children[0] = #moved
        jump finalize(#left, #child, %left_length, %child_length)

    block finalize(
            #left: Ptr<BTreeSetNode<T>>, #child: Ptr<BTreeSetNode<T>>,
            %left_length: I64, %child_length: I64):
        #left.length = %left_length.sub(1)
        #child.length = %child_length.add(1)
        #left.recount()
        #child.recount()
        #self.recount()
        return()

routine BTreeSetNode<T>.borrow_from_right(#self: Ptr<Self>, %i: I64) -> Void
require T: typename
    block entry():
        #child: Ptr<BTreeSetNode<T>> := #self.children[%i]
        #right: Ptr<BTreeSetNode<T>> := #self.children[%i.add(1)]
        %child_length: I64 := #child.length
        %right_length: I64 := #right.length
        %pivot: T := #self.keys[%i]
        #child.keys[%child_length] = %pivot
        %new_pivot: T := #right.keys[0]
        #self.keys[%i] = %new_pivot
        #right.keys.shift_left(0, %right_length)
        %leaf: Bool := #child.leaf
        branch %leaf
            ? finalize(#child, #right, %child_length, %right_length)
            : move_child(#child, #right, %child_length, %right_length)

    block move_child(
            #child: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %child_length: I64, %right_length: I64):
        #moved: Ptr<BTreeSetNode<T>> := #right.children[0]
        #child.children[%child_length.add(1)] = #moved
        #right.children.shift_left(0, %right_length.add(1))
        jump finalize(#child, #right, %child_length, %right_length)

    block finalize(
            #child: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %child_length: I64, %right_length: I64):
        #child.length = %child_length.add(1)
        #right.length = %right_length.sub(1)
        #child.recount()
        #right.recount()
        #self.recount()
        return()

routine BTreeSetNode<T>.merge_children(
        #self: Ptr<Self>, %i: I64, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %i_p1: I64 = %i.add(1)
        #left: Ptr<BTreeSetNode<T>> := #self.children[%i]
        #right: Ptr<BTreeSetNode<T>> := #self.children[%i_p1]
        %left_length: I64 := #left.length
        %right_length: I64 := #right.length
        %pivot: T := #self.keys[%i]
        #left.keys[%left_length] = %pivot
        %dst_start: I64 = %left_length.add(1)
        #left.keys.copy(%dst_start, #right.keys, 0, %right_length)
        %leaf: Bool := #left.leaf
        branch %leaf
            ? finalize(#left, #right, %left_length, %right_length)
            : copy_children(#left, #right, %left_length, %right_length)

    block copy_children(
            #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %left_length: I64, %right_length: I64):
        #left.children.copy(%left_length.add(1), #right.children, 0, %right_length.add(1))
        jump finalize(#left, #right, %left_length, %right_length)

    block finalize(
            #left: Ptr<BTreeSetNode<T>>, #right: Ptr<BTreeSetNode<T>>,
            %left_length: I64, %right_length: I64):
        #left.length = %left_length.add(1).add(%right_length)
        %parent_length: I64 := #self.length
        #self.keys.shift_left(%i, %parent_length)
        %i_p1: I64 = %i.add(1)
        #self.children.shift_left(%i_p1, %parent_length.add(1))
        #self.length = %parent_length.sub(1)
        free<BTreeSetNode<T>>(#alloc, #right)
        #left.recount()
        #self.recount()
        return()

routine BTreeSetNode<T>.ensure_min(
        #self: Ptr<Self>, %i: I64, #alloc: Ptr<Allocator>) -> I64
require T: typename
    block entry():
        #child: Ptr<BTreeSetNode<T>> := #self.children[%i]
        %child_length: I64 := #child.length
        %ok: Bool = %child_length.sge(NODE_MIN_KEYS)
        branch %ok ? return(%i): try_left()

    block try_left():
        %has_left: Bool = %i.sgt(0)
        branch %has_left ? check_left() : try_right(false)

    block check_left():
        #left: Ptr<BTreeSetNode<T>> := #self.children[%i.sub(1)]
        %left_length: I64 := #left.length
        %left_ok: Bool = %left_length.sge(NODE_MIN_KEYS)
        branch %left_ok ? do_borrow_left() : try_right(true)

    block do_borrow_left():
        #self.borrow_from_left(%i)
        return(%i)

    block try_right(%has_left: Bool):
        %parent_length: I64 := #self.length
        %has_right: Bool = %i.slt(%parent_length)
        branch %has_right ? check_right(%has_left) : pick_merge_no_right(%has_left)

    block check_right(%has_left: Bool):
        #right: Ptr<BTreeSetNode<T>> := #self.children[%i.add(1)]
        %right_length: I64 := #right.length
        %right_ok: Bool = %right_length.sge(NODE_MIN_KEYS)
        branch %right_ok ? do_borrow_right() : pick_merge(%has_left)

    block do_borrow_right():
        #self.borrow_from_right(%i)
        return(%i)

    block pick_merge(%has_left: Bool):
        branch %has_left ? merge_with_left() : merge_with_right()

    block pick_merge_no_right(%has_left: Bool):
        branch %has_left ? merge_with_left() : panic(TrapCode.Unreachable)

    block merge_with_left():
        %i_m1: I64 = %i.sub(1)
        #self.merge_children(%i_m1, #alloc)
        return(%i_m1)

    block merge_with_right():
        #self.merge_children(%i, #alloc)
        return(%i)

routine BTreeSetNode<T>.take_max(#self: Ptr<Self>, #set: Ptr<BTreeSet<T>>) -> T
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %length: I64 := #self.length
        %index: I64 = %length.sub(1)
        %key: T = #self.remove_leaf_at(%index)
        return(%key)

    block descend():
        %length: I64 := #self.length
        #alloc: Ptr<Allocator> := #set.alloc
        %actual: I64 = #self.ensure_min(%length, #alloc)
        #child: Ptr<BTreeSetNode<T>> := #self.children[%actual]
        %key: T = #child.take_max(#set)
        #self.recount()
        return(%key)

routine BTreeSetNode<T>.take_min(#self: Ptr<Self>, #set: Ptr<BTreeSet<T>>) -> T
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %key: T = #self.remove_leaf_at(0)
        return(%key)

    block descend():
        #alloc: Ptr<Allocator> := #set.alloc
        %actual: I64 = #self.ensure_min(0, #alloc)
        #child: Ptr<BTreeSetNode<T>> := #self.children[%actual]
        %key: T = #child.take_min(#set)
        #self.recount()
        return(%key)

routine BTreeSetNode<T>.remove(#self: Ptr<Self>, #set: Ptr<BTreeSet<T>>, %key: T) -> Bool
require T: typename
    block entry():
        %slot: I64 = #set.find_index(#self, %key)
        %length: I64 := #self.length
        %inside: Bool = %slot.slt(%length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: I64):
        %node_key: T := #self.keys[%slot]
        %cmp: I32 = %key.compare(%node_key)
        %equal: Bool = %cmp.eq(0)
        branch %equal ? remove_here(%slot) : descend_or_missing(%slot)

    block remove_here(%slot: I64):
        %leaf: Bool := #self.leaf
        branch %leaf ? remove_leaf(%slot) : remove_internal(%slot)

    block remove_leaf(%slot: I64):
        #self.remove_leaf_at(%slot)
        return(true)

    block remove_internal(%slot: I64):
        #left: Ptr<BTreeSetNode<T>> := #self.children[%slot]
        %left_length: I64 := #left.length
        %left_ok: Bool = %left_length.sge(NODE_MIN_KEYS)
        branch %left_ok ? take_pred(%slot) : try_succ(%slot)

    block take_pred(%slot: I64):
        #left: Ptr<BTreeSetNode<T>> := #self.children[%slot]
        %replacement: T = #left.take_max(#set)
        #self.keys[%slot] = %replacement
        #self.recount()
        return(true)

    block try_succ(%slot: I64):
        #right: Ptr<BTreeSetNode<T>> := #self.children[%slot.add(1)]
        %right_length: I64 := #right.length
        %right_ok: Bool = %right_length.sge(NODE_MIN_KEYS)
        branch %right_ok ? take_succ(%slot) : merge_and_recurse(%slot)

    block take_succ(%slot: I64):
        #right: Ptr<BTreeSetNode<T>> := #self.children[%slot.add(1)]
        %replacement: T = #right.take_min(#set)
        #self.keys[%slot] = %replacement
        #self.recount()
        return(true)

    block merge_and_recurse(%slot: I64):
        #alloc: Ptr<Allocator> := #set.alloc
        #self.merge_children(%slot, #alloc)
        #merged: Ptr<BTreeSetNode<T>> := #self.children[%slot]
        %removed: Bool = #merged.remove(#set, %key)
        #self.recount()
        return(%removed)

    block descend_or_missing(%slot: I64):
        %leaf: Bool := #self.leaf
        branch %leaf ? return(false): descend(%slot)

    block descend(%slot: I64):
        #alloc: Ptr<Allocator> := #set.alloc
        %actual: I64 = #self.ensure_min(%slot, #alloc)
        #child: Ptr<BTreeSetNode<T>> := #self.children[%actual]
        %removed: Bool = #child.remove(#set, %key)
        #self.recount()
        return(%removed)

routine BTreeSet<T>.remove(#self: Ptr<Self>, %key: T) -> Bool
require T: typename
    block entry():
        #root: Ptr<BTreeSetNode<T>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? return(false) : remove_root(#root)

    block remove_root(#root: Ptr<BTreeSetNode<T>>):
        %removed: Bool = #root.remove(#self, %key)
        branch %removed ? after_remove(#root) : return(false)

    block after_remove(#root: Ptr<BTreeSetNode<T>>):
        %length: I64 := #self.length
        #self.length = %length.sub(1)
        %root_length: I64 := #root.length
        %empty_root: Bool = %root_length.eq(0)
        branch %empty_root ? maybe_shrink(#root) : return(true)

    block maybe_shrink(#root: Ptr<BTreeSetNode<T>>):
        %leaf: Bool := #root.leaf
        branch %leaf ? clear_root(#root) : shrink(#root)

    block clear_root(#root: Ptr<BTreeSetNode<T>>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<BTreeSetNode<T>>(#alloc, #root)
        #self.root = null
        return(true)

    block shrink(#root: Ptr<BTreeSetNode<T>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #new_root: Ptr<BTreeSetNode<T>> := #root.children[0]
        free<BTreeSetNode<T>>(#alloc, #root)
        #self.root = #new_root
        return(true)

; Internal nodes store `length` separator keys and `length + 1` children.
routine BTreeSetNode<T>.free_recursive(#self: Ptr<Self>, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %leaf: Bool := #self.leaf
        branch %leaf ? free_self() : free_children()

    block free_children():
        %length: I64 := #self.length
        jump child_loop(0, %length.add(1))

    block child_loop(%i: I64, %child_count: I64):
        %done: Bool = %i.sge(%child_count)
        branch %done ? free_self() : free_child(%i, %child_count)

    block free_child(%i: I64, %child_count: I64):
        #child: Ptr<BTreeSetNode<T>> := #self.children[%i]
        #child.free_recursive(#alloc)
        jump child_loop(%i.add(1), %child_count)

    block free_self():
        free<BTreeSetNode<T>>(#alloc, #self)
        return()

routine BTreeSet<T>.free(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #root: Ptr<BTreeSetNode<T>> := #self.root
        %empty: Bool = #root.is_null()
        branch %empty ? reset() : free_root(#root)

    block free_root(#root: Ptr<BTreeSetNode<T>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #root.free_recursive(#alloc)
        jump reset()

    block reset():
        #self.root = null
        #self.length = 0
        return()
