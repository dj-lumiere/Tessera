// Tessera stdlib collection: ArrayIter<T, N>
//
// Forward iterator over a fixed-size Array<T, N> held behind a pointer.
// The length N is computed once at construction via sizeof division and stored
// in the record so next() never needs generic arithmetic.
//
// Satisfies concept Iterator<T, ArrayIter<T, N>>.

module Standard::Core

record ArrayIter<T, N>
conform Iterator<T, ArrayIter<T, N>>
require T: typename, N: U64
    data   : Ptr<T>  // bitcast of the original Ptr<Array<T, N>>
    index  : U64
    length : U64  // = N, resolved at monomorphisation

routine ArrayIter<T, N>.construct(#arr: Ptr<Array<T, N>>) -> Self
require T: typename, N: U64
    block entry():
        #data : Ptr<T> = bitcast<Ptr<Array<T, N>>, Ptr<T>>(#arr)
        %iter : Self   = Self { data: #data, index: 0, length: N }
        return(%iter)

routine ArrayIter<T, N>.next(#self: Ptr<Self>) -> Option<T>
require T: typename, N: U64
    block entry():
        %index  : U64  = #self.index.load()
        %length : U64  = #self.length.load()
        %done   : Bool = %index.ge(%length)
        branch %done ? return_none() : return_some(%index)

    block return_none():
        %none : Option<T> = .absent()
        return(%none)

    block return_some(%index: U64):
        #data  : Ptr<T> = #self.data.load()
        %value : T      = #data[%index].load()
        #self.index.store(%index.add(1))
        %some : Option<T> = .present(%value)
        return(%some)
