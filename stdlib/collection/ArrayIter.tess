; Tessera stdlib collection: ArrayIter<T, N>
;
; Forward iterator over a fixed-size Array<T, N> held behind a pointer.
; The length N is computed once at construction via sizeof division and stored
; in the struct so next() never needs generic arithmetic.
;
; Satisfies concept Iterator<T, ArrayIter<T, N>>.

struct ArrayIter<T, N>
conform Iterator<T, ArrayIter<T, N>>
require T: typename, N: I64
    data:   Ptr<T>   ; bitcast of the original Ptr<Array<T, N>>
    index:  I64
    length: I64      ; = N, resolved at monomorphisation

routine ArrayIter<T, N>.new(#arr: Ptr<Array<T, N>>) -> Self
require T: typename, N: I64
    block entry():
        #data:  Ptr<T> = bitcast<Ptr<Array<T, N>>, Ptr<T>>(#arr)
        %arr_size: I64 = sizeof<Array<T, N>>()
        %elem_size: I64 = sizeof<T>()
        %n:     I64    = %arr_size.sdiv(%elem_size)
        %iter:  Self = Self { data: #data, index: 0, length: %n }
        return(%iter)

routine ArrayIter<T, N>.next(#self: Ptr<Self>) -> Option<T>
require T: typename, N: I64
    block entry():
        %index:  I64  := #self.index
        %length: I64  := #self.length
        %done:   Bool = %index.sge(%length)
        branch %done ? return_none() : return_some(%index)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%index: I64):
        #data:  Ptr<T> := #self.data
        %value: T      := #data[%index]
        %index_next: I64 = %index.add(1)
        #self.index = %index_next
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
