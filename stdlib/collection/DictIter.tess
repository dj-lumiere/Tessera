// Tessera stdlib collection: DictIter<K, V>
//
// Walks Dict<K, V> in insertion order. Yields KVPair<K, V> for each live
// entry in the entries arrays, skipping entries marked dead by `remove`.
//
// KVPair<K, V> is defined in option.tess and shared with SortedDictIter.
//
// Mutating the map during iteration produces undefined behaviour.
//
// Satisfies concept Iterator<KVPair<K, V>, DictIter<K, V>>.

module Standard::Collections

record DictIter<K, V>
conform Iterator<KVPair<K, V>, DictIter<K, V>>
require K: typename, V: typename
    map   : @Dict<K, V>
    index : USize

routine DictIter<K, V>.construct(%map: @Dict<K, V>) -> Self
require K: typename, V: typename
    block entry():
        %iter : Self = Self { map: %map, index: 0 }
        return(%iter)

routine DictIter<K, V>.next(%self: @Self) -> Option<KVPair<K, V>>
require K: typename, V: typename
    block entry():
        %map   : @Dict<K, V> = %self.map.load()
        %count : USize       = %map.entries_count.load()
        %index : USize       = %self.index.load()
        jump scan(%index, %count, %map)

    block scan(%index: USize, %count: USize, %map: @Dict<K, V>):
        %exhausted : Bool = %index.ge(%count)
        branch %exhausted ? return_none() : check(%index, %count, %map)

    block check(%index: USize, %count: USize, %map: @Dict<K, V>):
        %entry_states : @U8  = %map.entry_states.load()
        %state        : U8   = %entry_states.stride(%index).load()
        %live         : Bool = %state.eq(1)
        branch %live ? yield(%index, %map) : scan(%index.add(1), %count, %map)

    block return_none():
        %none : Option<KVPair<K, V>> = .Absent
        return(%none)

    block yield(%index: USize, %map: @Dict<K, V>):
        %keys   : @K           = %map.keys.load()
        %values : @V           = %map.values.load()
        %key    : K            = %keys.stride(%index).load()
        %value  : V            = %values.stride(%index).load()
        %pair   : KVPair<K, V> = KVPair<K, V> { key: %key, value: %value }
        %self.index.store(%index.add(1))
        %some : Option<KVPair<K, V>> = .Present(%pair)
        return(%some)
