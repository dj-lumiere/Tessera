; Tessera stdlib collection: DictIter<K, V>
;
; Walks Dict<K, V> in insertion order. Yields KVPair<K, V> for each live
; entry in the entries arrays, skipping entries marked dead by `remove`.
;
; KVPair<K, V> is defined in option.tess and shared with SortedDictIter.
;
; Mutating the map during iteration produces undefined behaviour.
;
; Satisfies concept Iterator<KVPair<K, V>, DictIter<K, V>>.

record DictIter<K, V>
conform Iterator<KVPair<K, V>, DictIter<K, V>>
require K: typename, V: typename
    map:   Ptr<Dict<K, V>>
    index: I64

routine DictIter<K, V>.new(#map: Ptr<Dict<K, V>>) -> Self
require K: typename, V: typename
    block entry():
        %iter: Self = Self { map: #map, index: 0 }
        return(%iter)

routine DictIter<K, V>.next(#self: Ptr<Self>) -> Option<KVPair<K, V>>
require K: typename, V: typename
    block entry():
        #map:   Ptr<Dict<K, V>> := #self.map
        %count: I64                := #map.entries_count
        %index: I64                := #self.index
        jump scan(%index, %count, #map)

    block scan(%index: I64, %count: I64, #map: Ptr<Dict<K, V>>):
        %exhausted: Bool = %index.sge(%count)
        branch %exhausted ? return_none() : check(%index, %count, #map)

    block check(%index: I64, %count: I64, #map: Ptr<Dict<K, V>>):
        #entry_states: Ptr<I8> := #map.entry_states
        %state: I8             := #entry_states[%index]
        %live:  Bool           = %state.eq(1)
        branch %live ? yield(%index, #map) : scan(%index.add(1), %count, #map)

    block return_none():
        %none: Option<KVPair<K, V>> = Option<KVPair<K, V>>.none()
        return(%none)

    block yield(%index: I64, #map: Ptr<Dict<K, V>>):
        #keys:   Ptr<K> := #map.keys
        #values: Ptr<V> := #map.values
        %key:    K      := #keys[%index]
        %value:  V      := #values[%index]
        %pair:   KVPair<K, V> = KVPair<K, V> { key: %key, value: %value }
        #self.index = %index.add(1)
        %some: Option<KVPair<K, V>> = Option<KVPair<K, V>>.some(%pair)
        return(%some)
