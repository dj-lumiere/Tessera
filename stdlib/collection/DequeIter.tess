; Tessera stdlib collection: DequeIter<T>
;
; Forward iterator over Deque<T>, yielding elements front-to-back.
; Delegates index-to-physical mapping to Deque.get, which reads data[start + index].
;
; Satisfies concept Iterator<T, DequeIter<T>>.

record DequeIter<T>
conform Iterator<T, DequeIter<T>>
require T: typename
    deque: Ptr<Deque<T>>
    index: I64

routine DequeIter<T>.new(#deque: Ptr<Deque<T>>) -> Self
require T: typename
    block entry():
        %iter: Self = Self { deque: #deque, index: 0 }
        return(%iter)

routine DequeIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        #deque: Ptr<Deque<T>> := #self.deque
        %len:   I64           = #deque.length()
        %index: I64           := #self.index
        %done:  Bool          = %index.sge(%len)
        branch %done ? return_none() : return_some(%index, #deque)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%index: I64, #deque: Ptr<Deque<T>>):
        %value: T = #deque.get(%index)
        %index_next: I64 = %index.add(1)
        #self.index = %index_next
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
