// Tessera stdlib collection: SetIter<T>
//
// Walks Set<T> in insertion order. Visits each live entry in the entries
// arrays, skipping entries marked dead by `remove`.
//
// Mutating the set during iteration produces undefined behaviour.
//
// Satisfies concept Iterator<T, SetIter<T>>.

module Standard::Collections

record SetIter<T>
conform Iterator<T, SetIter<T>>
require T: typename
    set:   Ptr<Set<T>>
    index: U64

routine SetIter<T>.construct(#set: Ptr<Set<T>>) -> Self
require T: typename
    block entry():
        %iter: Self = Self { set: #set, index: 0 }
        return(%iter)

routine SetIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        #set:   Ptr<Set<T>> = #self.set.load()
        %count: U64             = #set.entries_count.load()
        %index: U64             = #self.index.load()
        jump scan(%index, %count, #set)

    // Advance until we hit a live entry or exhaust the array.
    // index >= count holds at once when the set is empty, so it returns None.
    block scan(%index: U64, %count: U64, #set: Ptr<Set<T>>):
        %exhausted: Bool = %index.ge(%count)
        branch %exhausted ? return_none() : check(%index, %count, #set)

    block check(%index: U64, %count: U64, #set: Ptr<Set<T>>):
        #entry_states: Ptr<U8> = #set.entry_states.load()
        %state: U8             = #entry_states[%index].load()
        %live:  Bool           = %state.eq(1)
        branch %live ? yield(%index, #set) : scan(%index.add(1), %count, #set)

    block return_none():
        %none: Option<T> = .none()
        return(%none)

    block yield(%index: U64, #set: Ptr<Set<T>>):
        #keys: Ptr<T> = #set.keys.load()
        %key:  T      = #keys[%index].load()
        #self.index.store(%index.add(1))
        %some: Option<T> = .some(%key)
        return(%some)
