// Tessera stdlib collection: Array<T, N> — fixed-size inline array
//
// Maps to LLVM IR [N x T].  Stored entirely inline — no heap allocation,
// no pointer indirection.  N is a compile-time constant USize.
//
// The helpers below also operate on Array<T, N> fields inside larger
// structures. The range convention is half-open: [start, end).

module Standard::Core

@llvm("[{N} x {T}]")
record Array<T, N>
conform Equal<Array<T, N>> when T: typename, N: USize, Equal<T>
require T: typename, N: USize

// -- metadata ------------------------------------------------------------------

routine Array<T, N>.length() -> USize
require T: typename, N: USize
    block entry():
        return(N)

// -- construction --------------------------------------------------------------

// `Array<T, N>.from([a, b, ...])` makes an array value from a literal. It's built into the compiler, because a
// literal list can't be a routine parameter.

/// Reads the N values at %first into an array value. %first must point at N initialized Ts.
routine Array<T, N>.from_ptr(%first: Ptr<T>) -> Self
require T: typename, N: USize
    block entry():
        %whole : Ptr<Self> = %first.cast<Self>()
        %value : Self      = %whole.load()
        return(%value)

// -- element access ------------------------------------------------------------

routine Array<T, N>.get(%self: Ptr<Self>, %index: USize) -> T
require T: typename, N: USize
    block entry():
        %in_bounds : Bool = %index.lt(N)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: USize):
        %base  : Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(%self)
        %value : T      = %base[%index].load()
        return(%value)

routine Array<T, N>.set(%self: Ptr<Self>, %index: USize, %value: T) -> Void
require T: typename, N: USize
    block entry():
        %in_bounds : Bool = %index.lt(N)
        branch %in_bounds ? store(%index, %value) : panic(TrapCode.Bounds)

    block store(%index: USize, %value: T):
        %base : Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(%self)
        %base[%index].store(%value)
        return()

/// The address of element %index, checked like get: a place to read or write in place (`%a.at(i).store(v)`).
routine Array<T, N>.at(%self: Ptr<Self>, %index: USize) -> Ptr<T>
require T: typename, N: USize
    block entry():
        %in_bounds : Bool = %index.lt(N)
        branch %in_bounds ? address(%index) : panic(TrapCode.Bounds)

    block address(%index: USize):
        %base    : Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(%self)
        %element : Ptr<T> = %base[%index]
        return(%element)

// -- equality ------------------------------------------------------------------

routine Array<T, N>.eq(%self: Self, %other: Self) -> Bool
require T: typename, N: USize, Equal<T>
    block entry():
        claim %a : Ptr<Self>
        claim %b : Ptr<Self>
        %a.store(%self)
        %b.store(%other)
        %equal : Bool = %a.eq_at(%b)
        return(%equal)

/// eq, through pointers to the two Arrays.
private routine Array<T, N>.eq_at(%self: Ptr<Self>, %other: Ptr<Self>) -> Bool
require T: typename, N: USize, Equal<T>
    block entry():
        %pa : Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(%self)
        %pb : Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(%other)
        jump loop(0, %pa, %pb)

    block loop(%i: USize, %pa: Ptr<T>, %pb: Ptr<T>):
        %done : Bool = %i.ge(N)
        branch %done ? return(true) : step(%i, %pa, %pb)

    block step(%i: USize, %pa: Ptr<T>, %pb: Ptr<T>):
        %x  : T    = %pa[%i].load()
        %y  : T    = %pb[%i].load()
        %eq : Bool = %x.eq(%y)
        branch %eq ? loop(%i.add(1), %pa, %pb) : return(false)

// -- pointer to first element --------------------------------------------------

routine Array<T, N>.to_ptr(%self: Ptr<Self>) -> Ptr<T>
require T: typename, N: USize
    block entry():
        %base : Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(%self)
        return(%base)

/// Tessera stdlib collection: fixed array helpers
///
/// These helpers operate on Array<T, N> fields inside larger structures. The
/// range convention is half-open: [start, end).
/// Moves elements [start, end) one slot right, to [start + 1, end + 1), opening a hole at start. Writes index end.
routine Array<T, N>.shift_right(%self: Ptr<Self>, %start: USize, %end: USize) -> Void
require T: typename, N: USize
    block entry():
        jump loop(%end)

    block loop(%i: USize):
        %done : Bool = %i.le(%start)
        branch %done ? return() : move(%i)

    block move(%i: USize):
        %from  : USize = %i.sub(1)
        %value : T     = %self.get(%from)
        %self.set(%i, %value)
        jump loop(%from)

/// Closes the hole at start: moves elements [start + 1, end) one slot left, to [start, end - 1).
routine Array<T, N>.shift_left(%self: Ptr<Self>, %start: USize, %end: USize) -> Void
require T: typename, N: USize
    block entry():
        jump loop(%start)

    block loop(%i: USize):
        %last : USize = %end.sub(1)
        %done : Bool  = %i.ge(%last)
        branch %done ? return() : move(%i)

    block move(%i: USize):
        %from  : USize = %i.add(1)
        %value : T     = %self.get(%from)
        %self.set(%i, %value)
        jump loop(%from)

routine Array<T, N>.copy(%self: Ptr<Self>, %dst_start: USize, %src: Ptr<Self>, %src_start: USize,
        %count: USize) -> Void
require T: typename, N: USize
    block entry():
        jump loop(0)

    block loop(%i: USize):
        %done : Bool = %i.ge(%count)
        branch %done ? return() : copy_one(%i)

    block copy_one(%i: USize):
        %src_index : USize = %src_start.add(%i)
        %dst_index : USize = %dst_start.add(%i)
        %value     : T     = %src.get(%src_index)
        %self.set(%dst_index, %value)
        jump loop(%i.add(1))
