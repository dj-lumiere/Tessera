; Tessera stdlib collection: Array<T, N> — fixed-size inline array
;
; Maps to LLVM IR [N x T].  Stored entirely inline — no heap allocation,
; no pointer indirection.  N is a compile-time constant I64.
;
; The helpers below also operate on Array<T, N> fields inside larger
; structures. The range convention is half-open: [start, end).

@llvm("[{N} x {T}]")
record Array<T, N>
conform Equal<Array<T, N>>
require T: typename, N: I64, Equal<T>

; -- metadata ------------------------------------------------------------------

routine Array<T, N>.length() -> I64
require T: typename, N: I64
    block entry():
        return(N)

; -- element access ------------------------------------------------------------

routine Array<T, N>.get(#self: Ptr<Self>, %index: I64) -> T
require T: typename, N: I64
    block entry():
        %not_negative: Bool = %index.sge(0)
        %before_end:   Bool = %index.slt(N)
        %in_bounds:    Bool = %not_negative.bitand(%before_end)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: I64):
        #base: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        %value: T := #base[%index]
        return(%value)

routine Array<T, N>.set(#self: Ptr<Self>, %index: I64, %value: T) -> Void
require T: typename, N: I64
    block entry():
        %not_negative: Bool = %index.sge(0)
        %before_end:   Bool = %index.slt(N)
        %in_bounds:    Bool = %not_negative.bitand(%before_end)
        branch %in_bounds ? store(%index, %value) : panic(TrapCode.Bounds)

    block store(%index: I64, %value: T):
        #base: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        #base[%index] = %value
        return()

; -- equality ------------------------------------------------------------------

routine Array<T, N>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, N: I64, Equal<T>
    block entry():
        #pa: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        #pb: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#other)
        jump loop(0, #pa, #pb)

    block loop(%i: I64, #pa: Ptr<T>, #pb: Ptr<T>):
        %done: Bool = %i.sge(N)
        branch %done ? return(true) : step(%i, #pa, #pb)

    block step(%i: I64, #pa: Ptr<T>, #pb: Ptr<T>):
        %x: T := #pa[%i]
        %y: T := #pb[%i]
        %eq: Bool = %x.eq(%y)
        %i_next: I64 = %i.add(1)
        branch %eq ? loop(%i_next, #pa, #pb) : return(false)

; -- pointer to first element --------------------------------------------------

routine Array<T, N>.as_ptr(#self: Ptr<Self>) -> Ptr<T>
require T: typename, N: I64
    block entry():
        #base: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        return(#base)

; Tessera stdlib collection: fixed array helpers
;
; These helpers operate on Array<T, N> fields inside larger structures. The
; range convention is half-open: [start, end).
; Moves elements [start, end) one slot right, to [start + 1, end + 1), opening a hole at start. Writes index end.
routine Array<T, N>.shift_right(#self: Ptr<Self>, %start: I64, %end: I64) -> Void
require T: typename, N: I64
    block entry():
        jump loop(%end)

    block loop(%i: I64):
        %done: Bool = %i.sle(%start)
        branch %done ? return() : move(%i)

    block move(%i: I64):
        %from: I64 = %i.sub(1)
        %value: T := #self[%from]
        #self[%i] = %value
        jump loop(%from)

; Closes the hole at start: moves elements [start + 1, end) one slot left, to [start, end - 1).
routine Array<T, N>.shift_left(#self: Ptr<Self>, %start: I64, %end: I64) -> Void
require T: typename, N: I64
    block entry():
        jump loop(%start)

    block loop(%i: I64):
        %last: I64 = %end.sub(1)
        %done: Bool = %i.sge(%last)
        branch %done ? return() : move(%i)

    block move(%i: I64):
        %from: I64 = %i.add(1)
        %value: T := #self[%from]
        #self[%i] = %value
        jump loop(%from)

routine Array<T, N>.copy(#self: Ptr<Self>, %dst_start: I64, #src: Ptr<Array<T, N>>, %src_start: I64, %count: I64) -> Void
require T: typename, N: I64
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %done: Bool = %i.sge(%count)
        branch %done ? return() : copy_one(%i)

    block copy_one(%i: I64):
        %src_index: I64 = %src_start.add(%i)
        %dst_index: I64 = %dst_start.add(%i)
        %value: T := #src[%src_index]
        #self[%dst_index] = %value
        %i_next: I64 = %i.add(1)
        jump loop(%i_next)
