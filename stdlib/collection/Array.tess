// Tessera stdlib collection: Array<T, N> — fixed-size inline array
//
// Maps to LLVM IR [N x T].  Stored entirely inline — no heap allocation,
// no pointer indirection.  N is a compile-time constant U64.
//
// The helpers below also operate on Array<T, N> fields inside larger
// structures. The range convention is half-open: [start, end).

module Standard::Core

@llvm("[{N} x {T}]")
record Array<T, N>
require T: typename, N: U64

// -- metadata ------------------------------------------------------------------

routine Array<T, N>.length() -> U64
require T: typename, N: U64
    block entry():
        return(N)

// -- element access ------------------------------------------------------------

routine Array<T, N>.get(#self: Ptr<Self>, %index: U64) -> T
require T: typename, N: U64
    block entry():
        %in_bounds:    Bool = %index.lt(N)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: U64):
        #base: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        %value: T := #base[%index]
        return(%value)

routine Array<T, N>.set(#self: Ptr<Self>, %index: U64, %value: T) -> Void
require T: typename, N: U64
    block entry():
        %in_bounds:    Bool = %index.lt(N)
        branch %in_bounds ? store(%index, %value) : panic(TrapCode.Bounds)

    block store(%index: U64, %value: T):
        #base: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        #base[%index] = %value
        return()

// -- equality ------------------------------------------------------------------

routine Array<T, N>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, N: U64, Equal<T>
    block entry():
        #pa: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        #pb: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#other)
        jump loop(0, #pa, #pb)

    block loop(%i: U64, #pa: Ptr<T>, #pb: Ptr<T>):
        %done: Bool = %i.ge(N)
        branch %done ? return(true) : step(%i, #pa, #pb)

    block step(%i: U64, #pa: Ptr<T>, #pb: Ptr<T>):
        %x: T := #pa[%i]
        %y: T := #pb[%i]
        %eq: Bool = %x.eq(%y)
        %i_next: U64 = %i.add(1)
        branch %eq ? loop(%i_next, #pa, #pb) : return(false)

// -- pointer to first element --------------------------------------------------

routine Array<T, N>.as_ptr(#self: Ptr<Self>) -> Ptr<T>
require T: typename, N: U64
    block entry():
        #base: Ptr<T> = bitcast<Ptr<Self>, Ptr<T>>(#self)
        return(#base)

/// Tessera stdlib collection: fixed array helpers
///
/// These helpers operate on Array<T, N> fields inside larger structures. The
/// range convention is half-open: [start, end).
/// Moves elements [start, end) one slot right, to [start + 1, end + 1), opening a hole at start. Writes index end.
routine Array<T, N>.shift_right(#self: Ptr<Self>, %start: U64, %end: U64) -> Void
require T: typename, N: U64
    block entry():
        jump loop(%end)

    block loop(%i: U64):
        %done: Bool = %i.le(%start)
        branch %done ? return() : move(%i)

    block move(%i: U64):
        %from: U64 = %i.sub(1)
        %value: T := #self[%from]
        #self[%i] = %value
        jump loop(%from)

/// Closes the hole at start: moves elements [start + 1, end) one slot left, to [start, end - 1).
routine Array<T, N>.shift_left(#self: Ptr<Self>, %start: U64, %end: U64) -> Void
require T: typename, N: U64
    block entry():
        jump loop(%start)

    block loop(%i: U64):
        %last: U64 = %end.sub(1)
        %done: Bool = %i.ge(%last)
        branch %done ? return() : move(%i)

    block move(%i: U64):
        %from: U64 = %i.add(1)
        %value: T := #self[%from]
        #self[%i] = %value
        jump loop(%from)

routine Array<T, N>.copy(#self: Ptr<Self>, %dst_start: U64, #src: Ptr<Array<T, N>>, %src_start: U64, %count: U64) -> Void
require T: typename, N: U64
    block entry():
        jump loop(0)

    block loop(%i: U64):
        %done: Bool = %i.ge(%count)
        branch %done ? return() : copy_one(%i)

    block copy_one(%i: U64):
        %src_index: U64 = %src_start.add(%i)
        %dst_index: U64 = %dst_start.add(%i)
        %value: T := #src[%src_index]
        #self[%dst_index] = %value
        %i_next: U64 = %i.add(1)
        jump loop(%i_next)
