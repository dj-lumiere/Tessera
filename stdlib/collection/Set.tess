// Tessera stdlib collection: Set<T>
//
// Insertion-ordered open-addressed hash set. Two layers:
//   - Entries arrays (keys/hashes/entry_states) hold live and dead entries in
//     the order they were first inserted. Iteration walks these.
//   - Slots is an index table: each cell is SLOT_EMPTY, SLOT_TOMBSTONE, or an
//     entry index >= 0. Linear probing on the hash mod capacity.
//
// Both layers share `capacity`. Removal marks the entry dead and the slot a
// tombstone; the entry's position in the entries array is retained so the
// insertion order of surviving entries is preserved. Rehash compacts dead
// entries away.
//
// entry_state values: 0 = dead, 1 = live.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset SLOT_EMPTY:     USize = USize.MAX
private preset SLOT_TOMBSTONE: USize = SLOT_EMPTY.sub(1)

record Set<T>
conform Destruct<Set<T>>
conform Represent<Set<T>> when T: typename, HashEqual<T>, Diagnose<T>
conform Diagnose<Set<T>>  when T: typename, HashEqual<T>, Diagnose<T>
conform Equal<Set<T>>     when T: typename, HashEqual<T>
require T: typename, HashEqual<T>
    keys          : @T
    hashes        : @U64
    entry_states  : @U8
    slots         : @USize
    length        : USize
    entries_count : USize
    capacity      : USize
    alloc         : @Allocator

routine Set<T>.construct(%alloc: @Allocator) -> Self
require T: typename, HashEqual<T>
    block entry():
        %set : Self = Self { keys: null, hashes: null, entry_states: null, slots: null, length: 0,
                entries_count: 0, capacity: 0, alloc: %alloc }
        return(%set)

routine Set<T>.length(%self: Self) -> USize
require T: typename
    block entry():
        %length : USize = %self.length
        return(%length)

routine Set<T>.is_empty(%self: Self) -> Bool
require T: typename
    block entry():
        %length : USize = %self.length
        %empty  : Bool  = %length.eq(0)
        return(%empty)

routine Set<T>.slot(%self: Self, %key: T, %hash: U64) -> USize
require T: typename
    block entry():
        %capacity : USize = %self.capacity
        %mask     : USize = %capacity.sub(1)
        %start    : USize = %hash.to_usize_wrap().bitand(%mask)
        jump probe(%start, SLOT_EMPTY)

    block probe(%index: USize, %first_tombstone: USize):
        %slots        : @USize = %self.slots
        %entry_idx    : USize  = %slots.stride(%index).load()
        %is_empty     : Bool   = %entry_idx.eq(SLOT_EMPTY)
        %is_tombstone : Bool   = %entry_idx.eq(SLOT_TOMBSTONE)
        when:
            %is_empty     -> empty_slot(%index, %first_tombstone)
            %is_tombstone -> tombstone_slot(%index, %first_tombstone)
            else          -> occupied_slot(%index, %first_tombstone, %entry_idx)

    block empty_slot(%index: USize, %first_tombstone: USize):
        %has_tombstone : Bool  = %first_tombstone.ne(SLOT_EMPTY)
        %slot          : USize = %has_tombstone
            ? %first_tombstone
            : %index
        return(%slot)

    block tombstone_slot(%index: USize, %first_tombstone: USize):
        %seen           : Bool  = %first_tombstone.ne(SLOT_EMPTY)
        %next_tombstone : USize = %seen
            ? %first_tombstone
            : %index
        %capacity : USize = %self.capacity
        %next     : USize = %index.add(1).bitand(%capacity.sub(1))
        jump probe(%next, %next_tombstone)

    block occupied_slot(%index: USize, %first_tombstone: USize, %entry_idx: USize):
        %hashes     : @U64 = %self.hashes
        %entry_hash : U64  = %hashes.stride(%entry_idx).load()
        %hash_match : Bool = %entry_hash.eq(%hash)
        branch %hash_match
            ? maybe_equal(%index, %first_tombstone, %entry_idx)
            : next(%index, %first_tombstone)

    block maybe_equal(%index: USize, %first_tombstone: USize, %entry_idx: USize):
        %keys      : @T   = %self.keys
        %entry_key : T    = %keys.stride(%entry_idx).load()
        %equal     : Bool = %entry_key.eq(%key)
        branch %equal ? return(%index): next(%index, %first_tombstone)

    block next(%index: USize, %first_tombstone: USize):
        %capacity : USize = %self.capacity
        %next     : USize = %index.add(1).bitand(%capacity.sub(1))
        jump probe(%next, %first_tombstone)

/// Returns the entry index for %key, or SLOT_EMPTY if absent.
routine Set<T>.find(%self: Self, %key: T) -> USize
require T: typename
    block entry():
        %capacity : USize = %self.capacity
        %empty    : Bool  = %capacity.eq(0)
        branch %empty ? return(SLOT_EMPTY): hash()

    block hash():
        %hash      : U64    = %key.hash()
        %slot      : USize  = %self.slot(%key, %hash)
        %slots     : @USize = %self.slots
        %entry_idx : USize  = %slots.stride(%slot).load()
        %found     : Bool   = %entry_idx.lt(SLOT_TOMBSTONE)
        branch %found
            ? return(%entry_idx)
            : return(SLOT_EMPTY)

routine Set<T>.contains(%self: Self, %key: T) -> Bool
require T: typename
    block entry():
        %found : Bool = %self.find(%key).ne(SLOT_EMPTY)
        return(%found)

/// Two Sets are equal when they hold the same elements, regardless of
/// insertion order or internal slot layout. With matching length, "every
/// element of A is in B" is sufficient.
routine Set<T>.eq(%self: Self, %other: Self) -> Bool
require T: typename, HashEqual<T>
    block entry():
        claim %a : @Self <- %self
        claim %b : @Self <- %other
        %equal : Bool = %a.eq_at(%b)
        return(%equal)

/// eq, through pointers to the two Sets.
private routine Set<T>.eq_at(%self: @Self, %other: @Self) -> Bool
require T: typename, HashEqual<T>
    block entry():
        %la       : USize = %self.length.load()
        %lb       : USize = %other.length.load()
        %same_len : Bool  = %la.eq(%lb)
        branch %same_len
            ? scan()
            : return(false)

    block scan():
        %n : USize = %self.entries_count.load()
        jump loop(0, %n)

    block loop(%i: USize, %n: USize):
        %done : Bool = %i.ge(%n)
        branch %done
            ? return(true)
            : check(%i, %n)

    block check(%i: USize, %n: USize):
        %entry_states : @U8  = %self.entry_states.load()
        %s            : U8   = %entry_states.stride(%i).load()
        %live         : Bool = %s.eq(1)
        branch %live
            ? probe(%i, %n)
            : loop(%i.add(1), %n)

    block probe(%i: USize, %n: USize):
        %keys : @T   = %self.keys.load()
        %key  : T    = %keys.stride(%i).load()
        %has  : Bool = %other.load().contains(%key)
        branch %has
            ? loop(%i.add(1), %n)
            : return(false)

/// Moves the live entries into fresh arrays of %new_capacity. Returns false when
/// the allocator fails, leaving the set as it was.
private routine Set<T>.rehash(%self: @Self, %new_capacity: USize) -> Bool
require T: typename
    block entry():
        %alloc            : @Allocator = %self.alloc.load()
        %old_keys         : @T         = %self.keys.load()
        %old_hashes       : @U64       = %self.hashes.load()
        %old_entry_states : @U8        = %self.entry_states.load()
        %old_slots        : @USize     = %self.slots.load()
        %old_count        : USize      = %self.entries_count.load()
        %new_keys         : @T         = allocate<T>(%alloc, %new_capacity)
        %new_hashes       : @U64       = allocate<U64>(%alloc, %new_capacity)
        %new_entry_states : @U8        = allocate<U8>(%alloc, %new_capacity)
        %new_slots        : @USize     = allocate<USize>(%alloc, %new_capacity)
        %a                : Bool       = %new_keys.is_null()
        %b                : Bool       = %new_hashes.is_null()
        %c                : Bool       = %new_entry_states.is_null()
        %d                : Bool       = %new_slots.is_null()
        %f1               : Bool       = %a.bitor(%b)
        %f2               : Bool       = %c.bitor(%d)
        %failed           : Bool       = %f1.bitor(%f2)
        branch %failed
            ? discard(%alloc, %new_keys, %new_hashes, %new_entry_states, %new_slots)
            : clear_loop(0, %old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count,
                    %new_keys, %new_hashes, %new_entry_states, %new_slots, %new_capacity)

    block discard(%alloc: @Allocator, %new_keys: @T, %new_hashes: @U64, %new_entry_states: @U8,
            %new_slots: @USize):
        free_unless_null<T>(%new_keys, %alloc)
        free_unless_null<U64>(%new_hashes, %alloc)
        free_unless_null<U8>(%new_entry_states, %alloc)
        free_unless_null<USize>(%new_slots, %alloc)
        return(false)

    block clear_loop(%i: USize, %old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8,
            %old_slots: @USize, %old_count: USize, %new_keys: @T, %new_hashes: @U64,
            %new_entry_states: @U8, %new_slots: @USize, %new_capacity: USize):
        %done : Bool = %i.ge(%new_capacity)
        branch %done
            ? install(%old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count, %new_keys,
                    %new_hashes, %new_entry_states, %new_slots, %new_capacity)
            : clear_one(%i, %old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count,
                    %new_keys, %new_hashes, %new_entry_states, %new_slots, %new_capacity)

    block clear_one(%i: USize, %old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8,
            %old_slots: @USize, %old_count: USize, %new_keys: @T, %new_hashes: @U64,
            %new_entry_states: @U8, %new_slots: @USize, %new_capacity: USize):
        %new_slots.stride(%i).store(SLOT_EMPTY)
        %new_entry_states.stride(%i).store(0)
        jump clear_loop(%i.add(1), %old_keys, %old_hashes, %old_entry_states, %old_slots,
                %old_count, %new_keys, %new_hashes, %new_entry_states, %new_slots, %new_capacity)

    block install(%old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8, %old_slots: @USize,
            %old_count: USize, %new_keys: @T, %new_hashes: @U64, %new_entry_states: @U8,
            %new_slots: @USize, %new_capacity: USize):
        %self.keys.store(%new_keys)
        %self.hashes.store(%new_hashes)
        %self.entry_states.store(%new_entry_states)
        %self.slots.store(%new_slots)
        %self.length.store(0)
        %self.entries_count.store(0)
        %self.capacity.store(%new_capacity)
        jump move_loop(0, %old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count)

    block move_loop(%i: USize, %old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8,
            %old_slots: @USize, %old_count: USize):
        %done : Bool = %i.ge(%old_count)
        branch %done
            ? release_old(%old_keys, %old_hashes, %old_entry_states, %old_slots)
            : move_one(%i, %old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count)

    block move_one(%i: USize, %old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8,
            %old_slots: @USize, %old_count: USize):
        %s    : U8   = %old_entry_states.stride(%i).load()
        %live : Bool = %s.eq(1)
        branch %live
            ? insert_old(%i, %old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count)
            : move_loop(%i.add(1), %old_keys, %old_hashes, %old_entry_states, %old_slots,
                    %old_count)

    block insert_old(%i: USize, %old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8,
            %old_slots: @USize, %old_count: USize):
        %key  : T   = %old_keys.stride(%i).load()
        %hash : U64 = %old_hashes.stride(%i).load()
        %self.add_direct(%key, %hash)
        jump move_loop(%i.add(1), %old_keys, %old_hashes, %old_entry_states, %old_slots, %old_count)

    block release_old(%old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8, %old_slots: @USize):
        %has_old : Bool = %old_slots.is_not_null()
        branch %has_old
            ? free_old(%old_keys, %old_hashes, %old_entry_states, %old_slots)
            : return(true)

    block free_old(%old_keys: @T, %old_hashes: @U64, %old_entry_states: @U8, %old_slots: @USize):
        %alloc : @Allocator = %self.alloc.load()
        %old_keys.free(%alloc)
        %old_hashes.free(%alloc)
        %old_entry_states.free(%alloc)
        %old_slots.free(%alloc)
        return(true)

/// Makes room for one more entry. Returns false when the allocator fails,
/// leaving the set as it was.
private routine Set<T>.ensure(%self: @Self) -> Bool
require T: typename
    block entry():
        %capacity : USize = %self.capacity.load()
        %empty    : Bool  = %capacity.eq(0)
        branch %empty
            ? first()
            : check(%capacity)

    block first():
        return(%self.rehash(8))

    block check(%capacity: USize):
        %count : USize = %self.entries_count.load()
        %limit : USize = %capacity.mul(3).div(4)
        %full  : Bool  = %count.add(1).ge(%limit)
        branch %full
            ? grow(%capacity)
            : return(true)

    block grow(%capacity: USize):
        return(%self.rehash(%capacity.mul(2)))

/// Insert without growing — used internally by rehash after new arrays are in place.
/// Returns true if a new entry was appended, false if %key already lived. %hash is the key's hash, so rehash can pass
/// the stored one instead of hashing every key again.
routine Set<T>.add_direct(%self: @Self, %key: T, %hash: U64) -> Bool
require T: typename
    block entry():
        %slot      : USize  = %self.load().slot(%key, %hash)
        %slots     : @USize = %self.slots.load()
        %entry_idx : USize  = %slots.stride(%slot).load()
        %exists    : Bool   = %entry_idx.lt(SLOT_TOMBSTONE)
        branch %exists
            ? return(false)
            : add(%slot, %key, %hash)

    block add(%slot: USize, %key: T, %hash: U64):
        %new_idx      : USize  = %self.entries_count.load()
        %keys         : @T     = %self.keys.load()
        %hashes       : @U64   = %self.hashes.load()
        %entry_states : @U8    = %self.entry_states.load()
        %slots        : @USize = %self.slots.load()
        %keys.stride(%new_idx).store(%key)
        %hashes.stride(%new_idx).store(%hash)
        %entry_states.stride(%new_idx).store(1)
        %slots.stride(%slot).store(%new_idx)
        %self.length.load().add(1).store_into(%self.length)
        %self.entries_count.store(%new_idx.add(1))
        return(true)

routine Set<T>.add(%self: @Self, %key: T) -> Bool
require T: typename
    block entry():
        %added : Result<Bool, AllocFailed> = %self.add_result(%key)
        when %added:
            .Success(%is_new) -> return(%is_new)
            .Failure          -> panic(TrapCode.AllocFailed)

/// `add`, returning a Failure instead of trapping when the allocator fails. The
/// Success holds whether %key was new.
routine Set<T>.add_result(%self: @Self, %key: T) -> Result<Bool, AllocFailed>
require T: typename
    block entry():
        %room : Bool = %self.ensure()
        branch %room
            ? continue
            : return(.Failure(AllocFailed {}))
        %added : Bool = %self.add_direct(%key, %key.hash())
        return(.Success(%added))

routine Set<T>.remove(%self: @Self, %key: T) -> Bool
require T: typename
    block entry():
        %capacity : USize = %self.capacity.load()
        %empty    : Bool  = %capacity.eq(0)
        branch %empty
            ? return(false)
            : hash()

    block hash():
        %hash      : U64    = %key.hash()
        %slot      : USize  = %self.load().slot(%key, %hash)
        %slots     : @USize = %self.slots.load()
        %entry_idx : USize  = %slots.stride(%slot).load()
        %found     : Bool   = %entry_idx.lt(SLOT_TOMBSTONE)
        branch %found
            ? remove(%slot, %entry_idx)
            : return(false)

    block remove(%slot: USize, %entry_idx: USize):
        %slots        : @USize = %self.slots.load()
        %entry_states : @U8    = %self.entry_states.load()
        %slots.stride(%slot).store(SLOT_TOMBSTONE)
        %entry_states.stride(%entry_idx).store(0)
        %self.length.load().sub(1).store_into(%self.length)
        return(true)

routine Set<T>.destruct(%self: @Self) -> Void
require T: typename
    block entry():
        %slots : @USize = %self.slots.load()
        %empty : Bool   = %slots.is_null()
        branch %empty
            ? reset()
            : release()

    block release():
        %alloc        : @Allocator = %self.alloc.load()
        %keys         : @T         = %self.keys.load()
        %hashes       : @U64       = %self.hashes.load()
        %entry_states : @U8        = %self.entry_states.load()
        %slots        : @USize     = %self.slots.load()
        %keys.free(%alloc)
        %hashes.free(%alloc)
        %entry_states.free(%alloc)
        %slots.free(%alloc)
        jump reset()

    block reset():
        %self.keys.store(null)
        %self.hashes.store(null)
        %self.entry_states.store(null)
        %self.slots.store(null)
        %self.length.store(0)
        %self.entries_count.store(0)
        %self.capacity.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine Set<T>.destruct_all(%self: @Self) -> Void
require T: typename, HashEqual<T>, Destruct<T>
    block entry():
        %iter_val : SetIter<T> = .construct(%self)
        claim %iter : @SetIter<T> <- %iter_val
        claim %slot : @T          <- uninit
        jump next(%iter, %slot)

    block next(%iter: @SetIter<T>, %slot: @T):
        %item : Option<T> = %iter.next()
        when %item:
            .Present(%value) -> element(%iter, %slot, %value)
            .Absent          -> finish()

    block element(%iter: @SetIter<T>, %slot: @T, %value: T):
        %slot.store(%value)
        %slot.destruct()
        jump next(%iter, %slot)

    block finish():
        %self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements in insertion order, each diagnosed (strings quoted): {1, 2, 3}.
routine Set<T>.represent<W>(%self: Self, %out: @W) -> Void
require T: typename, HashEqual<T>, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim %whole : @Self <- %self
        %iter_val : SetIter<T> = .construct(%whole)
        claim %iter : @SetIter<T> <- %iter_val
        diagnose_items<T, SetIter<T>, W>(%out, %iter, "{", "}")
        return()

/// The elements in insertion order, each diagnosed: {1, 2, 3}.
routine Set<T>.diagnose<W>(%self: Self, %out: @W) -> Void
require T: typename, HashEqual<T>, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim %whole : @Self <- %self
        %iter_val : SetIter<T> = .construct(%whole)
        claim %iter : @SetIter<T> <- %iter_val
        diagnose_items<T, SetIter<T>, W>(%out, %iter, "{", "}")
        return()

/// Frees %ptr unless it is null: a failed rehash releases the arrays it did get.
private routine free_unless_null<T>(%ptr: @T, %alloc: @Allocator) -> Void
require T: typename
    block entry():
        %present : Bool = %ptr.is_not_null()
        branch %present
            ? continue
            : return()
        %ptr.free(%alloc)
        return()
