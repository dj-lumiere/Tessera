// Tessera stdlib collection: SortedSetIter<T>
//
// In-order iterator over SortedSet<T> using the existing get_order
// order-statistic routine.  Yields keys in ascending sorted order.
//
// Each next() call is O(log n) — one root-to-leaf walk.  Total traversal is
// O(n log n).  A fully stateful stack-based traversal would give O(n) total
// but would require heap-allocating a traversal stack inside the iterator;
// the order-statistic approach keeps the iterator record allocation-free.
//
// Satisfies concept Iterator<T, SortedSetIter<T>>.

module Standard::Collections

record SortedSetIter<T>
conform Iterator<T, SortedSetIter<T>>
require T: typename
    set:   Ptr<SortedSet<T>>
    order: U64
    total: U64

routine SortedSetIter<T>.construct(#set: Ptr<SortedSet<T>>) -> Self
require T: typename
    block entry():
        %total: U64 = #set.length()
        %iter: Self = Self { set: #set, order: 0, total: %total }
        return(%iter)

routine SortedSetIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        %order: U64  = #self.order.load()
        %total: U64  = #self.total.load()
        %done:  Bool = %order.ge(%total)
        branch %done ? return_none() : return_some(%order)

    block return_none():
        %none: Option<T> = .none()
        return(%none)

    block return_some(%order: U64):
        #set:   Ptr<SortedSet<T>> = #self.set.load()
        %value: T                = #set.get_order(%order)
        %order_next: U64 = %order.add(1)
        #self.order.store(%order_next)
        %some: Option<T> = .some(%value)
        return(%some)
