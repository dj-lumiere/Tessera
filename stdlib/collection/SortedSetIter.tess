// Tessera stdlib collection: SortedSetIter<T>
//
// In-order iterator over SortedSet<T>. Yields keys in ascending sorted order. It keeps the path from the root to the current node
// on an inline stack, so a full traversal is O(n) and the iterator allocates
// nothing.
//
// Satisfies concept Iterator<T, SortedSetIter<T>>.

module Standard::Collections

/// Every internal node has at least two children, so 2^64 entries fit in 64 levels.
private preset ITER_DEPTH: U64 = 64

/// `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the next key to yield. Every child
/// left of that key has been walked already.
record SortedSetIter<T>
conform Iterator<T, SortedSetIter<T>>
require T: typename
    nodes   : Array<Ptr<SortedSetNode<T>>, ITER_DEPTH>
    indices : Array<U64, ITER_DEPTH>
    depth   : U64

routine SortedSetIter<T>.construct(#set: Ptr<SortedSet<T>>) -> Self
require T: typename
    block entry():
        #iter  : Ptr<Self>             = claim
        #root  : Ptr<SortedSetNode<T>> = #set.root.load()
        %empty : Bool                  = #root.is_null()
        #iter.depth.store(0)
        branch %empty ? finish(#iter) : continue
        #iter.push_leftmost(#root)
        jump finish(#iter)

    block finish(#iter: Ptr<Self>):
        %iter : Self = #iter.load()
        return(%iter)

/// Pushes #node and the first child of each level below it, down to a leaf.
private routine SortedSetIter<T>.push_leftmost(#self: Ptr<Self>,
        #node: Ptr<SortedSetNode<T>>) -> Void
require T: typename
    block entry():
        jump push(#node)

    block push(#node: Ptr<SortedSetNode<T>>):
        %depth : U64  = #self.depth.load()
        %leaf  : Bool = #node.leaf.load()
        #self.nodes.set(%depth, #node)
        #self.indices.set(%depth, 0)
        #self.depth.store(%depth.add(1))
        branch %leaf ? return() : first_child(#node)

    block first_child(#node: Ptr<SortedSetNode<T>>):
        jump push(#node.children.get(0))

routine SortedSetIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        jump top()

    block top():
        %depth : U64  = #self.depth.load()
        %empty : Bool = %depth.eq(0)
        branch %empty ? done() : continue
        %level   : U64                   = %depth.sub(1)
        #node    : Ptr<SortedSetNode<T>> = #self.nodes.get(%level)
        %index   : U64                   = #self.indices.get(%level)
        %length  : U64                   = #node.length.load()
        %has_key : Bool                  = %index.lt(%length)
        branch %has_key ? take(#node, %level, %index) : pop(%level)

    block pop(%level: U64):
        #self.depth.store(%level)
        jump top()

    block take(#node: Ptr<SortedSetNode<T>>, %level: U64, %index: U64):
        %key  : T    = #node.keys.get(%index)
        %leaf : Bool = #node.leaf.load()
        #self.indices.set(%level, %index.add(1))
        branch %leaf ? yield(%key) : continue
        #right : Ptr<SortedSetNode<T>> = #node.children.get(%index.add(1))
        #self.push_leftmost(#right)
        jump yield(%key)

    block yield(%key: T):
        %some : Option<T> = .some(%key)
        return(%some)

    block done():
        %none : Option<T> = .none()
        return(%none)
