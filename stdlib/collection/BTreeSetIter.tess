; Tessera stdlib collection: BTreeSetIter<T>
;
; In-order iterator over BTreeSet<T> using the existing get_order
; order-statistic routine.  Yields keys in ascending sorted order.
;
; Each next() call is O(log n) — one root-to-leaf walk.  Total traversal is
; O(n log n).  A fully stateful stack-based traversal would give O(n) total
; but would require heap-allocating a traversal stack inside the iterator;
; the order-statistic approach keeps the iterator struct allocation-free.
;
; Satisfies concept Iterator<T, BTreeSetIter<T>>.

struct BTreeSetIter<T>
conform Iterator<T, BTreeSetIter<T>>
require T: typename
    set:   Ptr<BTreeSet<T>>
    order: I64
    total: I64

routine BTreeSetIter<T>.new(#set: Ptr<BTreeSet<T>>) -> Self
require T: typename
    block entry():
        %total: I64 = #set.length()
        %iter: Self = Self { set: #set, order: 0, total: %total }
        return(%iter)

routine BTreeSetIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        %order: I64  := #self.order
        %total: I64  := #self.total
        %done:  Bool = %order.sge(%total)
        branch %done ? return_none() : return_some(%order)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%order: I64):
        #set:   Ptr<BTreeSet<T>> := #self.set
        %value: T                = #set.get_order(%order)
        %order_next: I64 = %order.add(1)
        #self.order = %order_next
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
