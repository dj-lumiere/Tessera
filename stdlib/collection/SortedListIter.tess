// Tessera stdlib collection: SortedListIter<T>
//
// In-order iterator over SortedList<T>. Yields elements from index 0 to
// length-1. It keeps the path from the root to the current leaf on an inline
// stack, so a full traversal is O(n) and the iterator allocates nothing.
//
// Satisfies concept Iterator<T, SortedListIter<T>>.

module Standard::Collections

/// Every internal node has at least two children, so 2^64 elements fit in 64 levels.
private preset ITER_DEPTH: U64 = 64

/// `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the child being walked (internal) or
/// the next value to yield (leaf).
record SortedListIter<T>
conform Iterator<T, SortedListIter<T>>
require T: typename
    nodes   : Array<Ptr<SortedListNode<T>>, ITER_DEPTH>
    indices : Array<U64, ITER_DEPTH>
    depth   : U64

routine SortedListIter<T>.construct(%list: Ptr<SortedList<T>>) -> Self
require T: typename
    block entry():
        claim %iter : Ptr<Self>
        %root  : Ptr<SortedListNode<T>> = %list.root.load()
        %empty : Bool                   = %root.is_null()
        %iter.depth.store(0)
        branch %empty ? finish(%iter) : continue
        %iter.push_leftmost(%root)
        jump finish(%iter)

    block finish(%iter: Ptr<Self>):
        %iter_val : Self = %iter.load()
        return(%iter_val)

/// Pushes node and the first child of each level below it, down to a leaf.
private routine SortedListIter<T>.push_leftmost(%self: Ptr<Self>,
        %node: Ptr<SortedListNode<T>>) -> Void
require T: typename
    block entry():
        jump push(%node)

    block push(%node: Ptr<SortedListNode<T>>):
        %depth : U64  = %self.depth.load()
        %leaf  : Bool = %node.leaf.load()
        %self.nodes.set(%depth, %node)
        %self.indices.set(%depth, 0)
        %self.depth.store(%depth.add(1))
        branch %leaf ? return() : first_child(%node)

    block first_child(%node: Ptr<SortedListNode<T>>):
        jump push(%node.children.get(0))

routine SortedListIter<T>.next(%self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        jump top()

    block top():
        %depth : U64  = %self.depth.load()
        %empty : Bool = %depth.eq(0)
        branch %empty ? done() : continue
        %level : U64                    = %depth.sub(1)
        %node  : Ptr<SortedListNode<T>> = %self.nodes.get(%level)
        %index : U64                    = %self.indices.get(%level)
        %leaf  : Bool                   = %node.leaf.load()
        branch %leaf ? take_value(%node, %level, %index) : next_child(%node, %level, %index.add(1))

    block take_value(%node: Ptr<SortedListNode<T>>, %level: U64, %index: U64):
        %length    : U64  = %node.length.load()
        %has_value : Bool = %index.lt(%length)
        branch %has_value ? continue : pop(%level)
        %value : T = %node.values.get(%index)
        %self.indices.set(%level, %index.add(1))
        %some : Option<T> = .Present(%value)
        return(%some)

    // the child at `indices[level]` is done; walk the next one, if there is one
    block next_child(%node: Ptr<SortedListNode<T>>, %level: U64, %index: U64):
        %length    : U64  = %node.length.load()
        %has_child : Bool = %index.lt(%length)
        branch %has_child ? continue : pop(%level)
        %self.indices.set(%level, %index)
        %self.push_leftmost(%node.children.get(%index))
        jump top()

    block pop(%level: U64):
        %self.depth.store(%level)
        jump top()

    block done():
        %none : Option<T> = .Absent
        return(%none)
