; Tessera stdlib collection: SortedListIter<T>
;
; In-order iterator over SortedList<T>.  Yields elements from index 0 to
; length-1 in insertion-order sequence, delegating to SortedList.get for
; each position.  Each next() is O(log n).
;
; See SortedSetIter.tess for a note on the O(n log n) vs O(n) tradeoff.
;
; Satisfies concept Iterator<T, SortedListIter<T>>.

record SortedListIter<T>
conform Iterator<T, SortedListIter<T>>
require T: typename
    list:  Ptr<SortedList<T>>
    order: U64
    total: U64

routine SortedListIter<T>.new(#list: Ptr<SortedList<T>>) -> Self
require T: typename
    block entry():
        %total: U64 = #list.length()
        %iter: Self = Self { list: #list, order: 0, total: %total }
        return(%iter)

routine SortedListIter<T>.next(#self: Ptr<Self>) -> Option<T>
require T: typename
    block entry():
        %order: U64  := #self.order
        %total: U64  := #self.total
        %done:  Bool = %order.ge(%total)
        branch %done ? return_none() : return_some(%order)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%order: U64):
        #list:  Ptr<SortedList<T>> := #self.list
        %value: T                 = #list.get(%order)
        %order_next: U64 = %order.add(1)
        #self.order = %order_next
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
