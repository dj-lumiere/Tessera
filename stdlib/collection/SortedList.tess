// Tessera stdlib collection: SortedList<T>
//
// Sequence tree with a fixed node value capacity of NODE_VALUES. Nodes store
// arrays inline. The allocator is stored in SortedList; node helpers still
// receive it as a parameter.
//
// Internal nodes use `length` as the child count (no separator keys — navigation
// is purely by subtree_count). Leaf nodes use `length` as the value count.

module Standard::Collections

private preset NODE_VALUES: U64 = 7
private preset NODE_CHILDREN: U64 = 8
private preset NODE_MIN: U64 = 4

record SortedListNode<T>
require T: typename
    leaf          : Bool
    length        : U64
    subtree_count : U64
    values        : Array<T, NODE_VALUES>
    children      : Array<Ptr<SortedListNode<T>>, NODE_CHILDREN>

record SortedList<T>
conform Destruct<SortedList<T>>
require T: typename
    root   : Ptr<SortedListNode<T>>
    length : U64
    alloc  : Ptr<Allocator>

routine SortedList<T>.construct(#alloc: Ptr<Allocator>) -> Self
require T: typename
    block entry():
        %list : Self = Self { root: null, length: 0, alloc: #alloc }
        return(%list)

routine SortedList<T>.length(#self: Ptr<Self>) -> U64
require T: typename
    block entry():
        %length : U64 = #self.length.load()
        return(%length)

routine SortedList<T>.is_empty(#self: Ptr<Self>) -> Bool
require T: typename
    block entry():
        %length : U64  = #self.length.load()
        %empty  : Bool = %length.eq(0)
        return(%empty)

routine SortedListNode<T>.construct(%leaf: Bool, #alloc: Ptr<Allocator>) -> Ptr<Self>
require T: typename
    block entry():
        #node   : Ptr<Self> = alloc<Self>(#alloc, 1)
        %failed : Bool      = #node.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : init(#node, %leaf)

    block init(#node: Ptr<Self>, %leaf: Bool):
        #node.leaf.store(%leaf)
        #node.length.store(0)
        #node.subtree_count.store(0)
        return(#node)

routine SortedListNode<T>.count(#self: Ptr<Self>) -> U64
require T: typename
    block entry():
        %empty : Bool = #self.is_null()
        branch %empty ? return(0) : count(#self)

    block count(#self: Ptr<Self>):
        %count : U64 = #self.subtree_count.load()
        return(%count)

routine SortedListNode<T>.recount(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        %leaf   : Bool = #self.leaf.load()
        %length : U64  = #self.length.load()
        branch %leaf ? leaf_count(%length) : internal_count(%length)

    block leaf_count(%length: U64):
        #self.subtree_count.store(%length)
        return()

    block internal_count(%length: U64):
        jump loop(0, 0, %length)

    block loop(%i: U64, %sum: U64, %length: U64):
        %done : Bool = %i.ge(%length)
        branch %done ? finish(%sum) : add_child(%i, %sum, %length)

    block add_child(%i: U64, %sum: U64, %length: U64):
        #child       : Ptr<Self> = #self.children.get(%i)
        %child_count : U64       = #child.count()
        jump loop(%i.add(1), %sum.add(%child_count), %length)

    block finish(%sum: U64):
        #self.subtree_count.store(%sum)
        return()

routine SortedList<T>.eq(#self: Ptr<Self>, #other: Ptr<Self>) -> Bool
require T: typename, Equal<T>
    block entry():
        %la       : U64  = #self.length.load()
        %lb       : U64  = #other.length.load()
        %same_len : Bool = %la.eq(%lb)
        branch %same_len ? loop(0, %la) : return(false)

    block loop(%i: U64, %len: U64):
        %done : Bool = %i.ge(%len)
        branch %done ? return(true) : step(%i, %len)

    block step(%i: U64, %len: U64):
        %x  : T    = #self.get(%i)
        %y  : T    = #other.get(%i)
        %eq : Bool = %x.eq(%y)
        branch %eq ? loop(%i.add(1), %len) : return(false)

routine SortedList<T>.get(#self: Ptr<Self>, %order: U64) -> T
require T: typename
    block entry():
        %length    : U64  = #self.length.load()
        %in_bounds : Bool = %order.lt(%length)
        branch %in_bounds ? select_root(%order) : panic(TrapCode.Bounds)

    block select_root(%order: U64):
        #root : Ptr<SortedListNode<T>> = #self.root.load()
        jump select_node(#root, %order)

    block select_node(#node: Ptr<SortedListNode<T>>, %order: U64):
        %leaf : Bool = #node.leaf.load()
        branch %leaf ? leaf_get(#node, %order) : internal_get(#node, %order)

    block leaf_get(#node: Ptr<SortedListNode<T>>, %order: U64):
        %value : T = #node.values.get(%order)
        return(%value)

    block internal_get(#node: Ptr<SortedListNode<T>>, %order: U64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<SortedListNode<T>>, %order: U64, %i: U64):
        #child       : Ptr<SortedListNode<T>> = #node.children.get(%i)
        %child_count : U64                    = #child.count()
        %in_child    : Bool                   = %order.lt(%child_count)
        branch %in_child ? select_node(#child,
                %order) : scan(#node, %order.sub(%child_count), %i.add(1))

/// The element at %rank, the same as get: a SortedList's rank is its position. Traps if %rank >= length.
routine SortedList<T>.get_by_rank(#self: Ptr<Self>, %rank: U64) -> T
require T: typename
    block entry():
        return(#self.get(%rank))

routine SortedList<T>.set(#self: Ptr<Self>, %order: U64, %value: T) -> Void
require T: typename
    block entry():
        %length    : U64  = #self.length.load()
        %in_bounds : Bool = %order.lt(%length)
        branch %in_bounds ? set_root(%order, %value) : panic(TrapCode.Bounds)

    block set_root(%order: U64, %value: T):
        #root : Ptr<SortedListNode<T>> = #self.root.load()
        jump set_node(#root, %order, %value)

    block set_node(#node: Ptr<SortedListNode<T>>, %order: U64, %value: T):
        %leaf : Bool = #node.leaf.load()
        branch %leaf ? leaf_set(#node, %order, %value) : internal_set(#node, %order, %value)

    block leaf_set(#node: Ptr<SortedListNode<T>>, %order: U64, %value: T):
        #node.values.set(%order, %value)
        return()

    block internal_set(#node: Ptr<SortedListNode<T>>, %order: U64, %value: T):
        jump scan(#node, %order, %value, 0)

    block scan(#node: Ptr<SortedListNode<T>>, %order: U64, %value: T, %i: U64):
        #child       : Ptr<SortedListNode<T>> = #node.children.get(%i)
        %child_count : U64                    = #child.count()
        %in_child    : Bool                   = %order.lt(%child_count)
        branch %in_child
            ? set_node(#child, %order, %value)
            : scan(#node, %order.sub(%child_count), %value, %i.add(1))

routine SortedList<T>.push(#self: Ptr<Self>, %value: T) -> Void
require T: typename
    block entry():
        %length : U64 = #self.length.load()
        #self.insert(%length, %value)
        return()

routine SortedListNode<T>.split_child(#self: Ptr<Self>, %index: U64, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        #left        : Ptr<Self> = #self.children.get(%index)
        %leaf        : Bool      = #left.leaf.load()
        #right       : Ptr<Self> = Self.construct(%leaf, #alloc)
        %length      : U64       = #left.length.load()
        %mid         : U64       = %length.div(2)
        %right_count : U64       = %length.sub(%mid)
        branch %leaf
            ? copy_values(#left, #right, %mid, %right_count)
            : copy_children(#left, #right, %mid, %right_count)

    block copy_values(#left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        #right.values.copy(0, #left.values, %mid, %right_count)
        jump promote(#left, #right, %mid, %right_count)

    block copy_children(#left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        jump child_loop(0, #left, #right, %mid, %right_count)

    block child_loop(%i: U64, #left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        %done : Bool = %i.ge(%right_count)
        branch %done
            ? promote(#left, #right, %mid, %right_count)
            : child_copy(%i, #left, #right, %mid, %right_count)

    block child_copy(%i: U64, #left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        %src   : U64       = %mid.add(%i)
        #child : Ptr<Self> = #left.children.get(%src)
        #right.children.set(%i, #child)
        jump child_loop(%i.add(1), #left, #right, %mid, %right_count)

    block promote(#left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        %parent_length : U64 = #self.length.load()
        jump shift_children(%parent_length, #left, #right, %mid, %right_count)

    block shift_children(%i: U64, #left: Ptr<Self>, #right: Ptr<Self>, %mid: U64,
            %right_count: U64):
        %stop : U64  = %index.add(1)
        %done : Bool = %i.lt(%stop)
        branch %done
            ? install(#left, #right, %mid, %right_count)
            : move_child(%i, #left, #right, %mid, %right_count)

    block move_child(%i: U64, #left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        #child : Ptr<Self> = #self.children.get(%i)
        #self.children.set(%i.add(1), #child)
        jump shift_children(%i.sub(1), #left, #right, %mid, %right_count)

    block install(#left: Ptr<Self>, #right: Ptr<Self>, %mid: U64, %right_count: U64):
        #self.children.set(%index.add(1), #right)
        #left.length.store(%mid)
        #right.length.store(%right_count)
        %parent_length : U64 = #self.length.load()
        #self.length.store(%parent_length.add(1))
        #left.recount()
        #right.recount()
        #self.recount()
        return()

/// Insert variant: an order equal to the rightmost subtree's count means
/// "append at the end of that child", so `remaining == count` keeps us in
/// the current child rather than overflowing into a non-existent next one.
routine SortedListNode<T>.find_child(#self: Ptr<Self>, %order: U64, #out_local: Ptr<U64>) -> U64
require T: typename
    block entry():
        jump loop(0, %order)

    block loop(%i: U64, %remaining: U64):
        #child    : Ptr<Self> = #self.children.get(%i)
        %count    : U64       = #child.count()
        %in_child : Bool      = %remaining.le(%count)
        branch %in_child ? found(%i, %remaining) : loop(%i.add(1), %remaining.sub(%count))

    block found(%i: U64, %remaining: U64):
        #out_local.store(%remaining)
        return(%i)

/// Remove variant: order must address an existing element, so `remaining`
/// must be strictly less than the child's count — at exact subtree
/// boundaries the element belongs to the next sibling, not the trailing
/// position of this one.
routine SortedListNode<T>.find_child_strict(#self: Ptr<Self>, %order: U64,
        #out_local: Ptr<U64>) -> U64
require T: typename
    block entry():
        jump loop(0, %order)

    block loop(%i: U64, %remaining: U64):
        #child    : Ptr<Self> = #self.children.get(%i)
        %count    : U64       = #child.count()
        %in_child : Bool      = %remaining.lt(%count)
        branch %in_child ? found(%i, %remaining) : loop(%i.add(1), %remaining.sub(%count))

    block found(%i: U64, %remaining: U64):
        #out_local.store(%remaining)
        return(%i)

routine SortedListNode<T>.insert_nonfull(#self: Ptr<Self>, %order: U64, %value: T,
        #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %leaf : Bool = #self.leaf.load()
        branch %leaf ? insert_leaf(%order, %value) : insert_internal(%order, %value)

    block insert_leaf(%order: U64, %value: T):
        %length : U64 = #self.length.load()
        #self.values.shift_right(%order, %length)
        #self.values.set(%order, %value)
        %new_length : U64 = %length.add(1)
        #self.length.store(%new_length)
        #self.subtree_count.store(%new_length)
        return()

    block insert_internal(%order: U64, %value: T):
        #local_order  : Ptr<U64>  = claim
        %slot         : U64       = #self.find_child(%order, #local_order)
        %local_order  : U64       = #local_order.load()
        #child        : Ptr<Self> = #self.children.get(%slot)
        %child_length : U64       = #child.length.load()
        %full         : Bool      = %child_length.eq(NODE_VALUES)
        branch %full
            ? split_then_insert(%slot, %local_order, %value)
            : descend(%slot, #child, %local_order, %value)

    block split_then_insert(%slot: U64, %local_order: U64, %value: T):
        #self.split_child(%slot, #alloc)
        #left       : Ptr<Self> = #self.children.get(%slot)
        %left_count : U64       = #left.count()
        %go_right   : Bool      = %local_order.gt(%left_count)
        branch %go_right
            ? descend_right(%slot, %local_order, %left_count, %value)
            : descend_left(%slot, %local_order, %value)

    block descend_left(%slot: U64, %local_order: U64, %value: T):
        #child : Ptr<Self> = #self.children.get(%slot)
        jump descend(%slot, #child, %local_order, %value)

    block descend_right(%slot: U64, %local_order: U64, %left_count: U64, %value: T):
        %right_slot  : U64       = %slot.add(1)
        %right_order : U64       = %local_order.sub(%left_count)
        #child       : Ptr<Self> = #self.children.get(%right_slot)
        jump descend(%right_slot, #child, %right_order, %value)

    block descend(%slot: U64, #child: Ptr<Self>, %local_order: U64, %value: T):
        #child.insert_nonfull(%local_order, %value, #alloc)
        #self.recount()
        return()

routine SortedList<T>.insert(#self: Ptr<Self>, %order: U64, %value: T) -> Void
require T: typename
    block entry():
        %length    : U64  = #self.length.load()
        %in_bounds : Bool = %order.le(%length)
        branch %in_bounds ? insert_checked(%order, %value) : panic(TrapCode.Bounds)

    block insert_checked(%order: U64, %value: T):
        #alloc : Ptr<Allocator>         = #self.alloc.load()
        #root  : Ptr<SortedListNode<T>> = #self.root.load()
        %empty : Bool                   = #root.is_null()
        branch %empty ? first_root(%value, #alloc) : insert_root(#root, %order, %value, #alloc)

    block first_root(%value: T, #alloc: Ptr<Allocator>):
        #root : Ptr<SortedListNode<T>> = SortedListNode<T>.construct(true, #alloc)
        #root.values.set(0, %value)
        #root.length.store(1)
        #root.subtree_count.store(1)
        #self.root.store(#root)
        #self.length.store(1)
        return()

    block insert_root(#root: Ptr<SortedListNode<T>>, %order: U64, %value: T,
            #alloc: Ptr<Allocator>):
        %root_length : U64  = #root.length.load()
        %full        : Bool = %root_length.eq(NODE_VALUES)
        branch %full
            ? split_root(#root, %order, %value, #alloc)
            : insert_nonfull(#root, %order, %value, #alloc)

    block split_root(#old_root: Ptr<SortedListNode<T>>, %order: U64, %value: T,
            #alloc: Ptr<Allocator>):
        #new_root : Ptr<SortedListNode<T>> = SortedListNode<T>.construct(false, #alloc)
        #new_root.children.set(0, #old_root)
        #new_root.length.store(1)
        #self.root.store(#new_root)
        #new_root.split_child(0, #alloc)
        jump insert_nonfull(#new_root, %order, %value, #alloc)

    block insert_nonfull(#root: Ptr<SortedListNode<T>>, %order: U64, %value: T,
            #alloc: Ptr<Allocator>):
        #root.insert_nonfull(%order, %value, #alloc)
        %length : U64 = #self.length.load()
        #self.length.store(%length.add(1))
        return()

// Capacity = NODE_VALUES, t = NODE_MIN. Internal-node `length` is the
// child count, so the underflow threshold (length < NODE_MIN) is shared
// with leaves. Helpers below ensure a child has length >= NODE_MIN before
// any deletion descent.

routine SortedListNode<T>.borrow_from_left(#self: Ptr<Self>, %i: U64) -> Void
require T: typename
    block entry():
        #left         : Ptr<Self> = #self.children.get(%i.sub(1))
        #child        : Ptr<Self> = #self.children.get(%i)
        %left_length  : U64       = #left.length.load()
        %child_length : U64       = #child.length.load()
        %leaf         : Bool      = #child.leaf.load()
        branch %leaf
            ? leaf_borrow(#left, #child, %left_length, %child_length)
            : internal_borrow(#left, #child, %left_length, %child_length)

    block leaf_borrow(#left: Ptr<Self>, #child: Ptr<Self>, %left_length: U64, %child_length: U64):
        #child.values.shift_right(0, %child_length)
        %v : T = #left.values.get(%left_length.sub(1))
        #child.values.set(0, %v)
        jump finalize(#left, #child, %left_length, %child_length)

    block internal_borrow(#left: Ptr<Self>, #child: Ptr<Self>, %left_length: U64,
            %child_length: U64):
        #child.children.shift_right(0, %child_length)
        #moved : Ptr<Self> = #left.children.get(%left_length.sub(1))
        #child.children.set(0, #moved)
        jump finalize(#left, #child, %left_length, %child_length)

    block finalize(#left: Ptr<Self>, #child: Ptr<Self>, %left_length: U64, %child_length: U64):
        #left.length.store(%left_length.sub(1))
        #child.length.store(%child_length.add(1))
        #left.recount()
        #child.recount()
        #self.recount()
        return()

routine SortedListNode<T>.borrow_from_right(#self: Ptr<Self>, %i: U64) -> Void
require T: typename
    block entry():
        #child        : Ptr<Self> = #self.children.get(%i)
        #right        : Ptr<Self> = #self.children.get(%i.add(1))
        %child_length : U64       = #child.length.load()
        %right_length : U64       = #right.length.load()
        %leaf         : Bool      = #child.leaf.load()
        branch %leaf
            ? leaf_borrow(#child, #right, %child_length, %right_length)
            : internal_borrow(#child, #right, %child_length, %right_length)

    block leaf_borrow(#child: Ptr<Self>, #right: Ptr<Self>, %child_length: U64, %right_length: U64):
        %v : T = #right.values.get(0)
        #child.values.set(%child_length, %v)
        #right.values.shift_left(0, %right_length)
        jump finalize(#child, #right, %child_length, %right_length)

    block internal_borrow(#child: Ptr<Self>, #right: Ptr<Self>, %child_length: U64,
            %right_length: U64):
        #moved : Ptr<Self> = #right.children.get(0)
        #child.children.set(%child_length, #moved)
        #right.children.shift_left(0, %right_length)
        jump finalize(#child, #right, %child_length, %right_length)

    block finalize(#child: Ptr<Self>, #right: Ptr<Self>, %child_length: U64, %right_length: U64):
        #child.length.store(%child_length.add(1))
        #right.length.store(%right_length.sub(1))
        #child.recount()
        #right.recount()
        #self.recount()
        return()

routine SortedListNode<T>.merge_children(#self: Ptr<Self>, %i: U64, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        #left         : Ptr<Self> = #self.children.get(%i)
        #right        : Ptr<Self> = #self.children.get(%i.add(1))
        %left_length  : U64       = #left.length.load()
        %right_length : U64       = #right.length.load()
        %leaf         : Bool      = #left.leaf.load()
        branch %leaf
            ? leaf_merge(#left, #right, %left_length, %right_length)
            : internal_merge(#left, #right, %left_length, %right_length)

    block leaf_merge(#left: Ptr<Self>, #right: Ptr<Self>, %left_length: U64, %right_length: U64):
        #left.values.copy(%left_length, #right.values, 0, %right_length)
        jump finalize(#left, #right, %left_length, %right_length)

    block internal_merge(#left: Ptr<Self>, #right: Ptr<Self>, %left_length: U64,
            %right_length: U64):
        #left.children.copy(%left_length, #right.children, 0, %right_length)
        jump finalize(#left, #right, %left_length, %right_length)

    block finalize(#left: Ptr<Self>, #right: Ptr<Self>, %left_length: U64, %right_length: U64):
        #left.length.store(%left_length.add(%right_length))
        %parent_length : U64 = #self.length.load()
        #self.children.shift_left(%i.add(1), %parent_length)
        #self.length.store(%parent_length.sub(1))
        #right.free(#alloc)
        #left.recount()
        #self.recount()
        return()

/// remove descends with rebalancing inlined: when a borrow or merge fires the
/// local order index has to be adjusted to account for the entries that moved
/// into (or out of) the descent target, so we cannot factor out a generic
/// ensure_min the way the keyed B-tree variants do.
routine SortedListNode<T>.remove(#self: Ptr<Self>, %order: U64, #alloc: Ptr<Allocator>) -> T
require T: typename
    block entry():
        %leaf : Bool = #self.leaf.load()
        branch %leaf ? remove_leaf(%order) : remove_internal(%order)

    block remove_leaf(%order: U64):
        %value  : T   = #self.values.get(%order)
        %length : U64 = #self.length.load()
        #self.values.shift_left(%order, %length)
        %new_length : U64 = %length.sub(1)
        #self.length.store(%new_length)
        #self.subtree_count.store(%new_length)
        return(%value)

    block remove_internal(%order: U64):
        #local_order_Ptr : Ptr<U64>  = claim
        %slot            : U64       = #self.find_child_strict(%order, #local_order_Ptr)
        %local_order     : U64       = #local_order_Ptr.load()
        #child           : Ptr<Self> = #self.children.get(%slot)
        %child_length    : U64       = #child.length.load()
        %ok              : Bool      = %child_length.ge(NODE_MIN)
        branch %ok ? descend(%slot, %local_order) : rebalance(%slot, %local_order)

    block descend(%slot: U64, %local_order: U64):
        #child : Ptr<Self> = #self.children.get(%slot)
        %value : T         = #child.remove(%local_order, #alloc)
        #self.recount()
        return(%value)

    block rebalance(%slot: U64, %local_order: U64):
        %has_left : Bool = %slot.gt(0)
        branch %has_left ? check_left(%slot, %local_order) : right_only(%slot, %local_order)

    block check_left(%slot: U64, %local_order: U64):
        #left        : Ptr<Self> = #self.children.get(%slot.sub(1))
        %left_length : U64       = #left.length.load()
        %left_ok     : Bool      = %left_length.ge(NODE_MIN)
        branch %left_ok ? do_borrow_left(%slot, %local_order) : right_with_left(%slot, %local_order)

    // Borrow/merge change the descent target's leading subtree_count, so we
    // diff #child.count() (= subtree_count) across the operation to recover
    // the local-order offset. This works uniformly for leaves (where each
    // moved value contributes 1) and internals (where the moved entry is a
    // whole child subtree of arbitrary count).
    block do_borrow_left(%slot: U64, %local_order: U64):
        #child     : Ptr<Self> = #self.children.get(%slot)
        %old_count : U64       = #child.count()
        #self.borrow_from_left(%slot)
        %new_local : U64 = %local_order.add(#child.count().sub(%old_count))
        jump descend(%slot, %new_local)

    block right_with_left(%slot: U64, %local_order: U64):
        %parent_length : U64  = #self.length.load()
        %has_right     : Bool = %slot.add(1).lt(%parent_length)
        branch %has_right
            ? check_right_after_left(%slot, %local_order)
            : do_merge_left(%slot, %local_order)

    block check_right_after_left(%slot: U64, %local_order: U64):
        #right        : Ptr<Self> = #self.children.get(%slot.add(1))
        %right_length : U64       = #right.length.load()
        %right_ok     : Bool      = %right_length.ge(NODE_MIN)
        branch %right_ok ? do_borrow_right(%slot, %local_order) : do_merge_left(%slot, %local_order)

    block do_borrow_right(%slot: U64, %local_order: U64):
        #self.borrow_from_right(%slot)
        jump descend(%slot, %local_order)

    block do_merge_left(%slot: U64, %local_order: U64):
        %slot_m1   : U64       = %slot.sub(1)
        #left      : Ptr<Self> = #self.children.get(%slot_m1)
        %new_local : U64       = #left.count().add(%local_order)
        #self.merge_children(%slot_m1, #alloc)
        jump descend(%slot.sub(1), %new_local)

    block right_only(%slot: U64, %local_order: U64):
        %parent_length : U64  = #self.length.load()
        %has_right     : Bool = %slot.add(1).lt(%parent_length)
        branch %has_right ? check_right_only(%slot, %local_order) : panic(TrapCode.Unreachable)

    block check_right_only(%slot: U64, %local_order: U64):
        #right        : Ptr<Self> = #self.children.get(%slot.add(1))
        %right_length : U64       = #right.length.load()
        %right_ok     : Bool      = %right_length.ge(NODE_MIN)
        branch %right_ok
            ? do_borrow_right(%slot, %local_order)
            : do_merge_right(%slot, %local_order)

    block do_merge_right(%slot: U64, %local_order: U64):
        #self.merge_children(%slot, #alloc)
        jump descend(%slot, %local_order)

routine SortedList<T>.remove(#self: Ptr<Self>, %order: U64) -> T
require T: typename
    block entry():
        %length    : U64  = #self.length.load()
        %in_bounds : Bool = %order.lt(%length)
        branch %in_bounds ? remove_root(%order) : panic(TrapCode.Bounds)

    block remove_root(%order: U64):
        #alloc  : Ptr<Allocator>         = #self.alloc.load()
        #root   : Ptr<SortedListNode<T>> = #self.root.load()
        %value  : T                      = #root.remove(%order, #alloc)
        %length : U64                    = #self.length.load()
        #self.length.store(%length.sub(1))
        %leaf : Bool = #root.leaf.load()
        branch %leaf ? maybe_clear(#root, %value) : maybe_shrink(#root, %value)

    block maybe_clear(#root: Ptr<SortedListNode<T>>, %value: T):
        %root_length : U64  = #root.length.load()
        %empty       : Bool = %root_length.eq(0)
        branch %empty ? clear_root(#root, %value) : return(%value)

    block maybe_shrink(#root: Ptr<SortedListNode<T>>, %value: T):
        %root_length : U64  = #root.length.load()
        %only_one    : Bool = %root_length.eq(1)
        branch %only_one ? shrink(#root, %value) : return(%value)

    block clear_root(#root: Ptr<SortedListNode<T>>, %value: T):
        #alloc : Ptr<Allocator> = #self.alloc.load()
        #root.free(#alloc)
        #self.root.store(null)
        return(%value)

    block shrink(#root: Ptr<SortedListNode<T>>, %value: T):
        #alloc    : Ptr<Allocator>         = #self.alloc.load()
        #new_root : Ptr<SortedListNode<T>> = #root.children.get(0)
        #root.free(#alloc)
        #self.root.store(#new_root)
        return(%value)

/// Internal nodes use `length` as the child count (indices 0..length-1).
routine SortedListNode<T>.free_recursive(#self: Ptr<Self>, #alloc: Ptr<Allocator>) -> Void
require T: typename
    block entry():
        %leaf : Bool = #self.leaf.load()
        branch %leaf ? free_self() : free_children()

    block free_children():
        %length : U64 = #self.length.load()
        jump child_loop(0, %length)

    block child_loop(%i: U64, %length: U64):
        %done : Bool = %i.ge(%length)
        branch %done ? free_self() : free_child(%i, %length)

    block free_child(%i: U64, %length: U64):
        #child : Ptr<Self> = #self.children.get(%i)
        #child.free_recursive(#alloc)
        jump child_loop(%i.add(1), %length)

    block free_self():
        #self.free(#alloc)
        return()

routine SortedList<T>.destruct(#self: Ptr<Self>) -> Void
require T: typename
    block entry():
        #root  : Ptr<SortedListNode<T>> = #self.root.load()
        %empty : Bool                   = #root.is_null()
        branch %empty ? reset() : free_root(#root)

    block free_root(#root: Ptr<SortedListNode<T>>):
        #alloc : Ptr<Allocator> = #self.alloc.load()
        #root.free_recursive(#alloc)
        jump reset()

    block reset():
        #self.root.store(null)
        #self.length.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine SortedList<T>.destruct_all(#self: Ptr<Self>) -> Void
require T: typename, Destruct<T>
    block entry():
        %iter_val : SortedListIter<T>      = .construct(#self)
        #iter     : Ptr<SortedListIter<T>> = claim
        #iter.store(%iter_val)
        #slot : Ptr<T> = claim
        jump next(#iter, #slot)

    block next(#iter: Ptr<SortedListIter<T>>, #slot: Ptr<T>):
        %item : Option<T> = #iter.next()
        %more : Bool      = %item.tag
        branch %more ? element(#iter, #slot, %item.value) : finish()

    block element(#iter: Ptr<SortedListIter<T>>, #slot: Ptr<T>, %value: T):
        #slot.store(%value)
        #slot.destruct()
        jump next(#iter, #slot)

    block finish():
        #self.destruct()
        return()
