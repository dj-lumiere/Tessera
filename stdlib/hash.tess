; Tessera stdlib: hash (xxHash64)
;
; Reference implementation of xxh64 (Yann Collet, 2014). Bit-for-bit
; compatible with the upstream spec: little-endian byte reads, the same
; five primes, and the same finalization mixer.
;
; Public surface:
;   xxh64(#data, %len, %seed) -> I64    — one-shot byte hash
;   xxh64_hash_i64(%v, %seed) -> I64    — fast path for an 8-byte integer
;
; Both routines treat I64 bit patterns as unsigned: LLVM add/sub/mul are
; bitwise, so signed-overflow wrap matches the reference exactly.

; -- primes --------------------------------------------------------------------
;
; Upstream values; >2^63 primes are written as their two's-complement I64
; equivalents. The bit pattern is what matters — every multiplication here
; uses LLVM `mul`, which doesn't care about signedness.
;
;   P1 = 0x9E3779B185EBCA87 = 11400714785074694791
;   P2 = 0xC2B2AE3D27D4EB4F = 14029467366897019727
;   P3 = 0x165667B19E3779F9 =  1609587929392839161
;   P4 = 0x85EBCA77C2B2AE63 =  9650029242287828579
;   P5 = 0x27D4EB2F165667C5 =  2870177450012600261

const XXH64_P1: I64 = -7046029288634856825
const XXH64_P2: I64 = -4417276706812531889
const XXH64_P3: I64 =  1609587929392839161
const XXH64_P4: I64 = -8796714831421723037
const XXH64_P5: I64 =  2870177450012600261

; -- little-endian byte readers ------------------------------------------------

; Read 8 bytes starting at #data[%off] as a little-endian I64.
; Byte-by-byte so we don't depend on host endianness or alignment.
routine xxh64_read_i64(#data: Ptr<I8>, %off: I64) -> I64
    block entry():
        jump loop(0, 0, 0)

    block loop(%i: I64, %acc: I64, %shift: I64):
        %done: Bool = %i.sge(8)
        branch %done ? return(%acc) : step(%i, %acc, %shift)

    block step(%i: I64, %acc: I64, %shift: I64):
        %idx: I64 = %off.add(%i)
        %b: I8 := #data[%idx]
        %next: I64 = %acc.bitor(%b.to_u64().shl(%shift))
        jump loop(%i.add(1), %next, %shift.add(8))

routine xxh64_read_i32(#data: Ptr<I8>, %off: I64) -> I32
    block entry():
        jump loop(0, 0, 0)

    block loop(%i: I64, %acc: I32, %shift: I32):
        %done: Bool = %i.sge(4)
        branch %done ? return(%acc) : step(%i, %acc, %shift)

    block step(%i: I64, %acc: I32, %shift: I32):
        %idx: I64 = %off.add(%i)
        %b: I8 := #data[%idx]
        %next: I32 = %acc.bitor(%b.to_u32().shl(%shift))
        jump loop(%i.add(1), %next, %shift.add(8))

; -- xxh64 internal mixers -----------------------------------------------------

routine xxh64_round(%acc: I64, %input: I64) -> I64
    block entry():
        %result: I64 = %acc.add(%input.mul(XXH64_P2)).rotl(31).mul(XXH64_P1)
        return(%result)

routine xxh64_merge(%acc: I64, %val: I64) -> I64
    block entry():
        %result: I64 = %acc.bitxor(xxh64_round(0, %val)).mul(XXH64_P1).add(XXH64_P4)
        return(%result)

routine xxh64_finalize(%h: I64) -> I64
    block entry():
        %s1: I64 = %h.lshr(33)
        %x1: I64 = %h.bitxor(%s1)
        %m1: I64 = %x1.mul(XXH64_P2)
        %s2: I64 = %m1.lshr(29)
        %x2: I64 = %m1.bitxor(%s2)
        %m2: I64 = %x2.mul(XXH64_P3)
        %s3: I64 = %m2.lshr(32)
        %result: I64 = %m2.bitxor(%s3)
        return(%result)

; -- one-shot byte hash --------------------------------------------------------
;
; Layout follows the spec exactly:
;   1. If len >= 32, run the 32-byte stripe loop with four 64-bit lanes.
;   2. Add len.
;   3. Drain remaining 8-byte chunks, then a 4-byte chunk, then trailing bytes.
;   4. Apply the finalization mixer.

routine xxh64(#data: Ptr<I8>, %len: I64, %seed: I64) -> I64
    block entry():
        %big: Bool = %len.sge(32)
        branch %big ? big_init() : small_init()

    block small_init():
        %h0: I64 = %seed.add(XXH64_P5)
        jump after_block(%h0, 0)

    block big_init():
        %sp1: I64 = %seed.add(XXH64_P1)
        %v1_0: I64 = %sp1.add(XXH64_P2)
        %v2_0: I64 = %seed.add(XXH64_P2)
        %v3_0: I64 = %seed
        %v4_0: I64 = %seed.sub(XXH64_P1)
        jump big_loop(%v1_0, %v2_0, %v3_0, %v4_0, 0)

    block big_loop(%v1: I64, %v2: I64, %v3: I64, %v4: I64, %off: I64):
        %remaining: I64 = %len.sub(%off)
        %has32: Bool = %remaining.sge(32)
        branch %has32 ? big_step(%v1, %v2, %v3, %v4, %off) : big_finish(%v1, %v2, %v3, %v4, %off)

    block big_step(%v1: I64, %v2: I64, %v3: I64, %v4: I64, %off: I64):
        %o2: I64 = %off.add(8)
        %o3: I64 = %off.add(16)
        %o4: I64 = %off.add(24)
        %k1: I64 = xxh64_read_i64(#data, %off)
        %k2: I64 = xxh64_read_i64(#data, %o2)
        %k3: I64 = xxh64_read_i64(#data, %o3)
        %k4: I64 = xxh64_read_i64(#data, %o4)
        %v1n: I64 = xxh64_round(%v1, %k1)
        %v2n: I64 = xxh64_round(%v2, %k2)
        %v3n: I64 = xxh64_round(%v3, %k3)
        %v4n: I64 = xxh64_round(%v4, %k4)
        jump big_loop(%v1n, %v2n, %v3n, %v4n, %off.add(32))

    block big_finish(%v1: I64, %v2: I64, %v3: I64, %v4: I64, %off: I64):
        %r1: I64 = %v1.rotl( 1)
        %r2: I64 = %v2.rotl( 7)
        %r3: I64 = %v3.rotl(12)
        %r4: I64 = %v4.rotl(18)
        %hsum: I64 = %r1.add(%r2).add(%r3.add(%r4))
        %h1: I64 = xxh64_merge(%hsum, %v1)
        %h2: I64 = xxh64_merge(%h1, %v2)
        %h3: I64 = xxh64_merge(%h2, %v3)
        %h4: I64 = xxh64_merge(%h3, %v4)
        jump after_block(%h4, %off)

    block after_block(%h: I64, %off: I64):
        %h_len: I64 = %h.add(%len)
        jump tail8_loop(%h_len, %off)

    block tail8_loop(%h: I64, %off: I64):
        %rem: I64 = %len.sub(%off)
        %has8: Bool = %rem.sge(8)
        branch %has8 ? tail8_step(%h, %off) : tail4(%h, %off)

    block tail8_step(%h: I64, %off: I64):
        %k: I64 = xxh64_read_i64(#data, %off)
        %h2: I64 = %h.bitxor(xxh64_round(0, %k)).rotl(27).mul(XXH64_P1).add(XXH64_P4)
        jump tail8_loop(%h2, %off.add(8))

    block tail4(%h: I64, %off: I64):
        %rem: I64 = %len.sub(%off)
        %has4: Bool = %rem.sge(4)
        branch %has4 ? tail4_step(%h, %off) : tail1_loop(%h, %off)

    block tail4_step(%h: I64, %off: I64):
        %k32: I32 = xxh64_read_i32(#data, %off)
        %ku: I64 = %k32.to_u64()
        %h2: I64 = %h.bitxor(%ku.mul(XXH64_P1)).rotl(23).mul(XXH64_P2).add(XXH64_P3)
        jump tail1_loop(%h2, %off.add(4))

    block tail1_loop(%h: I64, %off: I64):
        %rem: I64 = %len.sub(%off)
        %has1: Bool = %rem.sge(1)
        branch %has1 ? tail1_step(%h, %off) : finalize(%h)

    block tail1_step(%h: I64, %off: I64):
        %b: I8 := #data[%off]
        %bu: I64 = %b.to_u64()
        %h2: I64 = %h.bitxor(%bu.mul(XXH64_P5)).rotl(11).mul(XXH64_P1)
        jump tail1_loop(%h2, %off.add(1))

    block finalize(%h: I64):
        %result: I64 = xxh64_finalize(%h)
        return(%result)

; -- 8-byte fast path (used by integer primitives) -----------------------------
;
; Equivalent to xxh64 with len=8: skip the big-block path, add 8, run one
; iteration of the 8-byte tail loop, finalize. Primitives smaller than 8 bytes
; zero-extend to I64 and route through here too — slightly different output
; from a "true" len=4 hash, but saves the alloca + memcpy round-trip and the
; behavior is consistent across primitive widths.

routine xxh64_hash_i64(%v: I64, %seed: I64) -> I64
    block entry():
        %h_len: I64 = %seed.add(XXH64_P5).add(8)
        %k: I64 = xxh64_round(0, %v)
        %x: I64 = %h_len.bitxor(%k)
        %h2: I64 = %x.rotl(27).mul(XXH64_P1).add(XXH64_P4)
        %result: I64 = xxh64_finalize(%h2)
        return(%result)

; -- 16-byte combiner (used by composite types) --------------------------------
;
; Folds two precomputed sub-hashes into one. Equivalent to running xxh64
; with len=16 over the concatenation h1 || h2 — two iterations of the
; 8-byte tail path, then finalize.

routine xxh64_combine2(%h1: I64, %h2: I64, %seed: I64) -> I64
    block entry():
        %h_len: I64 = %seed.add(XXH64_P5).add(16)
        %r1: I64 = xxh64_round(0, %h1)
        %x1: I64 = %h_len.bitxor(%r1)
        %a1: I64 = %x1.rotl(27).mul(XXH64_P1).add(XXH64_P4)
        %r2: I64 = xxh64_round(0, %h2)
        %x2: I64 = %a1.bitxor(%r2)
        %a2: I64 = %x2.rotl(27).mul(XXH64_P1).add(XXH64_P4)
        %result: I64 = xxh64_finalize(%a2)
        return(%result)
