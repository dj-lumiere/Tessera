// Tessera stdlib: argument reduction and tables shared by the F32 sine, cosine and tangent
//
// Small and medium arguments reduce modulo pi/16 with a one- or two-part 16/pi in F64; arguments past 2^26
// (2^28 for the tangent) reduce with a 256-bit 2/pi (Payne-Hanek). The result is x * 16/pi = q + z (x * 2/pi
// for the tangent), with |z| <= 1/2 and only the low bits of q meaningful.
//
// Ported from CORE-MATH, src/binary32/sin/sinf.c via RazorForge's B32Sin.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// sin(i pi/16) for i in 0..31, as F64 bits. cos(i pi/16) is entry i + 8.
preset CM_F32_TRIG_SIN_TB: @Array<U64, 32> <- { 0x0000000000000000, 0x3FC8F8B83C69A60B,
    0x3FD87DE2A6AEA963, 0x3FE1C73B39AE68C8, 0x3FE6A09E667F3BCD, 0x3FEA9B66290EA1A3,
    0x3FED906BCF328D46, 0x3FEF6297CFF75CB0, 0x3FF0000000000000, 0x3FEF6297CFF75CB0,
    0x3FED906BCF328D46, 0x3FEA9B66290EA1A3, 0x3FE6A09E667F3BCD, 0x3FE1C73B39AE68C8,
    0x3FD87DE2A6AEA963, 0x3FC8F8B83C69A60B, 0x0000000000000000, 0xBFC8F8B83C69A60B,
    0xBFD87DE2A6AEA963, 0xBFE1C73B39AE68C8, 0xBFE6A09E667F3BCD, 0xBFEA9B66290EA1A3,
    0xBFED906BCF328D46, 0xBFEF6297CFF75CB0, 0xBFF0000000000000, 0xBFEF6297CFF75CB0,
    0xBFED906BCF328D46, 0xBFEA9B66290EA1A3, 0xBFE6A09E667F3BCD, 0xBFE1C73B39AE68C8,
    0xBFD87DE2A6AEA963, 0xBFC8F8B83C69A60B }

/// A reduced argument: x times 16/pi (or 2/pi) is q + z, with |z| <= 1/2. Only the low bits of q matter.
record CmF32TrigReduced
    z : F64
    q : U64

/// sin((i mod 32) pi/16).
routine cm_f32_trig_sin_tb(i: U64) -> F64
    block entry():
        bits : U64 = CM_F32_TRIG_SIN_TB.get(i.bitand(31).to<USize>())
        return(F64.from_bits(bits))

/// The odd part of sin(z pi/16) over z: (a0 + z2 a1) + z4 (a2 + z2 a3).
routine cm_f32_trig_poly_a(z2: F64, z4: F64) -> F64
    block entry():
        lo : F64 = z2.mul(-0x1.4abbce6256a39p-10).add(0x1.921fb54442d17p-3)
        hi : F64 = z2.mul(-0x1.32bdc61074ff6p-29).add(0x1.466bc5a518c16p-19)
        return(z4.mul(hi).add(lo))

/// The even part of 1 - cos(z pi/16) over z^2: (b0 + z2 b1) + z4 (b2 + z2 b3).
routine cm_f32_trig_poly_b(z2: F64, z4: F64) -> F64
    block entry():
        lo : F64 = z2.mul(-0x1.03c1f081b0833p-14).add(0x1.3bd3cc9be45dcp-6)
        hi : F64 = z2.mul(-0x1.e1d3ff281b40dp-35).add(0x1.55d3c6fc9ac1fp-24)
        return(z4.mul(hi).add(lo))

/// Reduces x (|x| below about 0x1.2d97c8p+3) modulo pi/16 with a 53-bit 16/pi.
routine cm_f32_trig_reduce_small(x: F64) -> CmF32TrigReduced
    block entry():
        idh : F64 = x.mul(0x1.45f306dc9c883p+2)
        q   : F64 = idh.add(0x1.8p+52)  // rounds idh to an integer, left in the low mantissa bits
        id  : F64 = q.sub(0x1.8p+52)
        z   : F64 = idh.sub(id)
        return(CmF32TrigReduced { z: z, q: q.bits() })

/// Reduces x (|x| < 2^28) modulo pi/16 with a two-part 16/pi.
routine cm_f32_trig_reduce_medium(x: F64) -> CmF32TrigReduced
    block entry():
        idl : F64 = x.mul(-0x1.b1bbead603d8bp-29)
        idh : F64 = x.mul(0x1.45f306ep+2)
        q   : F64 = idh.add(0x1.8p+52)  // rounds idh to an integer, left in the low mantissa bits
        id  : F64 = q.sub(0x1.8p+52)
        z   : F64 = idh.sub(id).add(idl)
        return(CmF32TrigReduced { z: z, q: q.bits() })

/// Reduces a large finite F32 (bits u, |x| > 2^26) with a 256-bit 2/pi: bias 147 reduces modulo pi/16 (sine,
/// cosine), 150 modulo pi/2 (tangent). z comes in units of the reduction step.
routine cm_f32_trig_reduce_big(u: U32, bias: U64) -> CmF32TrigReduced
    block entry():
        biased_exponent : U32  = u.shr(23).bitand(0xFF)
        e               : U64  = biased_exponent.to<U64>()
        significand     : U32  = u.bitand(0x7FFFFF).bitor(0x800000)
        m               : U64  = significand.to<U64>()
        p0              : U128 = m.mul_wide(0xFE5163ABDEBBC562)
        p1              : U128 = m.mul_wide(0xDB6295993C439041).add_wrap(p0.shr(64))
        p2              : U128 = m.mul_wide(0xFC2757D1F534DDC0).add_wrap(p1.shr(64))
        p3              : U128 = m.mul_wide(0xA2F9836E4E441529).add_wrap(p2.shr(64))
        p3h             : U64  = p3.shr(64).to_wrap<U64>()
        p3l             : U64  = p3.to_wrap<U64>()
        p2l             : U64  = p2.to_wrap<U64>()
        p1l             : U64  = p1.to_wrap<U64>()
        s               : U64  = e.sub(bias)  // e >= 153 here, so s >= 3
        low             : Bool = s.lt(64)
        high            : Bool = s.gt(64)
        when:
            low  -> shift_low(s, p3h, p3l, p2l)
            high -> shift_high(s, p3l, p2l, p1l)
            else -> finish(p3l, p2l)

    // the integer part i and the fraction a straddle p3h:p3l:p2l
    block shift_low(s: U64, p3h: U64, p3l: U64, p2l: U64):
        sr : U64 = U64.sub(64, s)
        i  : U64 = p3h.shl(s).bitor(p3l.shr(sr))
        a  : U64 = p3l.shl(s).bitor(p2l.shr(sr))
        jump finish(i, a)

    // the integer part i and the fraction a straddle p3l:p2l:p1l
    block shift_high(s: U64, p3l: U64, p2l: U64, p1l: U64):
        sl : U64 = s.sub(64)
        sr : U64 = U64.sub(128, s)
        i  : U64 = p3l.shl(sl).bitor(p2l.shr(sr))
        a  : U64 = p2l.shl(sl).bitor(p1l.shr(sr))
        jump finish(i, a)

    block finish(i: U64, a: U64):
        negative : Bool = u.shr(31).eq(1)
        sgn      : U64  = negative
            ? U64.MAX
            : 0
        round_up : U64 = a.shr(63)  // a negative fraction rounds the quotient up
        i_up     : U64 = i.add_wrap(round_up)
        fraction : S64 = a.bitxor(sgn).to_wrap<S64>()
        z        : F64 = fraction.to<F64>().mul(0x1p-64)
        q        : U64 = i_up.bitxor(sgn).sub_wrap(sgn)
        return(CmF32TrigReduced { z: z, q: q })
