; Tessera stdlib algorithm: sort
;
; Hybrid sort for List<T>. T must satisfy Compare<T>.
;
; Strategy:
;   * length <= 32 — straight insertion sort, no allocation.
;   * length  > 32 — insertion-sort initial runs of 32 elements, then merge
;     adjacent runs bottom-up using a scratch buffer the size of the list.
;     Buffers ping-pong between #data and #scratch; if the final pass leaves
;     the result in #scratch, it is copied back to #data before returning.
;
; Stable: equal elements keep their original relative order (the merge step
; takes from the left run on ties).

const SORT_RUN: I64 = 32

; -- insertion sort over a half-open range [lo, hi) ----------------------------

routine sort_insertion<T>(#data: Ptr<T>, %lo: I64, %hi: I64) -> Void
require T: typename, Compare<T>
    block entry():
        %i_start: I64 = %lo.add(1)
        jump outer(%i_start)

    block outer(%i: I64):
        %done: Bool = %i.sge(%hi)
        branch %done ? return() : load(%i)

    block load(%i: I64):
        %x: T := #data[%i]
        jump inner(%i, %i, %x)

    block inner(%i: I64, %j: I64, %x: T):
        %at_start: Bool = %j.sle(%lo)
        branch %at_start ? place(%i, %j, %x) : check(%i, %j, %x)

    block check(%i: I64, %j: I64, %x: T):
        %prev: I64 = %j.sub(1)
        %y: T := #data[%prev]
        %cmp: I32 = %y.compare(%x)
        %greater: Bool = %cmp.sgt(0)
        branch %greater ? shift(%i, %j, %x, %y, %prev) : place(%i, %j, %x)

    block shift(%i: I64, %j: I64, %x: T, %y: T, %prev: I64):
        #data[%j] = %y
        jump inner(%i, %prev, %x)

    block place(%i: I64, %j: I64, %x: T):
        #data[%j] = %x
        %i_next: I64 = %i.add(1)
        jump outer(%i_next)

; -- merge two sorted half-open ranges [lo, mid) and [mid, hi) -----------------
;
; Reads from #src, writes the merged result into #dst[lo..hi). Stable: when
; elements compare equal, the one from the left run is taken first.

routine sort_merge<T>(#src: Ptr<T>, #dst: Ptr<T>, %lo: I64, %mid: I64, %hi: I64) -> Void
require T: typename, Compare<T>
    block entry():
        jump loop(%lo, %mid, %lo)

    block loop(%i: I64, %j: I64, %k: I64):
        %i_done: Bool = %i.sge(%mid)
        branch %i_done ? drain_b(%j, %k) : check_j(%i, %j, %k)

    block check_j(%i: I64, %j: I64, %k: I64):
        %j_done: Bool = %j.sge(%hi)
        branch %j_done ? drain_a(%i, %k) : pick(%i, %j, %k)

    block pick(%i: I64, %j: I64, %k: I64):
        %a: T := #src[%i]
        %b: T := #src[%j]
        %cmp: I32 = %a.compare(%b)
        %take_a: Bool = %cmp.sle(0)
        branch %take_a ? take_a(%i, %j, %k, %a) : take_b(%i, %j, %k, %b)

    block take_a(%i: I64, %j: I64, %k: I64, %a: T):
        #dst[%k] = %a
        %i_next: I64 = %i.add(1)
        %k_next: I64 = %k.add(1)
        jump loop(%i_next, %j, %k_next)

    block take_b(%i: I64, %j: I64, %k: I64, %b: T):
        #dst[%k] = %b
        %j_next: I64 = %j.add(1)
        %k_next: I64 = %k.add(1)
        jump loop(%i, %j_next, %k_next)

    block drain_a(%i: I64, %k: I64):
        %done: Bool = %i.sge(%mid)
        branch %done ? return() : copy_a(%i, %k)

    block copy_a(%i: I64, %k: I64):
        %v: T := #src[%i]
        #dst[%k] = %v
        %i_next: I64 = %i.add(1)
        %k_next: I64 = %k.add(1)
        jump drain_a(%i_next, %k_next)

    block drain_b(%j: I64, %k: I64):
        %done: Bool = %j.sge(%hi)
        branch %done ? return() : copy_b(%j, %k)

    block copy_b(%j: I64, %k: I64):
        %v: T := #src[%j]
        #dst[%k] = %v
        %j_next: I64 = %j.add(1)
        %k_next: I64 = %k.add(1)
        jump drain_b(%j_next, %k_next)

; -- one bottom-up pass merging every pair of width-sized runs -----------------

routine sort_merge_pass<T>(#src: Ptr<T>, #dst: Ptr<T>, %n: I64, %width: I64) -> Void
require T: typename, Compare<T>
    block entry():
        jump loop(0)

    block loop(%lo: I64):
        %done: Bool = %lo.sge(%n)
        branch %done ? return() : run(%lo)

    block run(%lo: I64):
        %mid_raw: I64 = %lo.add(%width)
        %hi_raw: I64 = %mid_raw.add(%width)
        %mid_ok: Bool = %mid_raw.sle(%n)
        %mid: I64 = %mid_ok ? %mid_raw : %n
        %hi_ok: Bool = %hi_raw.sle(%n)
        %hi: I64 = %hi_ok ? %hi_raw : %n
        sort_merge<T>(#src, #dst, %lo, %mid, %hi)
        %step: I64 = %width.mul(2)
        %lo_next: I64 = %lo.add(%step)
        jump loop(%lo_next)

; -- public entry point --------------------------------------------------------

routine List<T>.sort(#self: Ptr<Self>) -> Void
require T: typename, Compare<T>
    block entry():
        %n: I64 := #self.length
        %small: Bool = %n.sle(SORT_RUN)
        branch %small ? small_sort(%n) : big_sort(%n)

    block small_sort(%n: I64):
        #data: Ptr<T> := #self.data
        sort_insertion<T>(#data, 0, %n)
        return()

    block big_sort(%n: I64):
        #data: Ptr<T> := #self.data
        #alloc: Ptr<Allocator> := #self.alloc
        #scratch: Ptr<T> = alloc<T>(#alloc, %n)
        %failed: Bool = #scratch.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : run_loop(0, %n, #data, #scratch, #alloc)

    block run_loop(%lo: I64, %n: I64, #data: Ptr<T>, #scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        %done: Bool = %lo.sge(%n)
        branch %done ? pass_start(%n, #data, #scratch, #alloc) : run_step(%lo, %n, #data, #scratch, #alloc)

    block run_step(%lo: I64, %n: I64, #data: Ptr<T>, #scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        %hi_raw: I64 = %lo.add(SORT_RUN)
        %hi_ok: Bool = %hi_raw.sle(%n)
        %hi: I64 = %hi_ok ? %hi_raw : %n
        sort_insertion<T>(#data, %lo, %hi)
        %lo_next: I64 = %lo.add(SORT_RUN)
        jump run_loop(%lo_next, %n, #data, #scratch, #alloc)

    block pass_start(%n: I64, #data: Ptr<T>, #scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        jump pass_loop(SORT_RUN, #data, #scratch, %n, #data, #scratch, #alloc)

    block pass_loop(%width: I64, #src: Ptr<T>, #dst: Ptr<T>, %n: I64, #data: Ptr<T>, #scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        %done: Bool = %width.sge(%n)
        branch %done ? finish(#src, %n, #data, #scratch, #alloc) : pass(%width, #src, #dst, %n, #data, #scratch, #alloc)

    block pass(%width: I64, #src: Ptr<T>, #dst: Ptr<T>, %n: I64, #data: Ptr<T>, #scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        sort_merge_pass<T>(#src, #dst, %n, %width)
        %width_next: I64 = %width.mul(2)
        jump pass_loop(%width_next, #dst, #src, %n, #data, #scratch, #alloc)

    block finish(#src: Ptr<T>, %n: I64, #data: Ptr<T>, #scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        %in_place: Bool = #src.ptr_eq(#data)
        branch %in_place ? release(#scratch, #alloc) : copy_back(#src, #data, #scratch, %n, #alloc)

    block copy_back(#src: Ptr<T>, #data: Ptr<T>, #scratch: Ptr<T>, %n: I64, #alloc: Ptr<Allocator>):
        copy<T>(#data, #src, %n)
        jump release(#scratch, #alloc)

    block release(#scratch: Ptr<T>, #alloc: Ptr<Allocator>):
        free<T>(#alloc, #scratch)
        return()
