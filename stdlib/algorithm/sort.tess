// Tessera stdlib algorithm: sort
//
// Hybrid sort for List<T>. T must satisfy Compare<T>.
//
// Strategy:
//   * length <= 32 — straight insertion sort, no allocation.
//   * length  > 32 — insertion-sort initial runs of 32 elements, then merge
//     adjacent runs bottom-up using a scratch buffer the size of the list.
//     Buffers ping-pong between data and scratch; if the final pass leaves
//     the result in scratch, it is copied back to data before returning.
//
// Stable: equal elements keep their original relative order (the merge step
// takes from the left run on ties).

module Standard::Core

import Standard::Alloc
import Standard::Collections

preset SORT_RUN: USize = 32

// -- insertion sort over a half-open range [lo, hi) ----------------------------

routine sort_insertion<T>(data: @T, lo: USize, hi: USize) -> Void
require T: typename, Compare<T>
    block entry():
        jump outer(lo.add(1))

    block outer(i: USize):
        done : Bool = i.ge(hi)
        branch done
            ? return()
            : load(i)

    block load(i: USize):
        x : T = data.stride(i).load()
        jump inner(i, i, x)

    block inner(i: USize, j: USize, x: T):
        at_start : Bool = j.le(lo)
        branch at_start
            ? place(i, j, x)
            : check(i, j, x)

    block check(i: USize, j: USize, x: T):
        prev    : USize = j.sub(1)
        y       : T     = data.stride(prev).load()
        cmp     : S32   = y.compare(x)
        greater : Bool  = cmp.gt(0)
        branch greater
            ? shift(i, j, x, y, prev)
            : place(i, j, x)

    block shift(i: USize, j: USize, x: T, y: T, prev: USize):
        data.stride(j).store(y)
        jump inner(i, prev, x)

    block place(i: USize, j: USize, x: T):
        data.stride(j).store(x)
        jump outer(i.add(1))

// -- merge two sorted half-open ranges [lo, mid) and [mid, hi) -----------------
//
// Reads from src, writes the merged result into dst[lo..hi). Stable: when
// elements compare equal, the one from the left run is taken first.

routine sort_merge<T>(src: @T, dst: @T, lo: USize, mid: USize, hi: USize) -> Void
require T: typename, Compare<T>
    block entry():
        jump loop(lo, mid, lo)

    block loop(i: USize, j: USize, k: USize):
        i_done : Bool = i.ge(mid)
        branch i_done
            ? drain_b(j, k)
            : check_j(i, j, k)

    block check_j(i: USize, j: USize, k: USize):
        j_done : Bool = j.ge(hi)
        branch j_done
            ? drain_a(i, k)
            : pick(i, j, k)

    block pick(i: USize, j: USize, k: USize):
        a      : T    = src.stride(i).load()
        b      : T    = src.stride(j).load()
        cmp    : S32  = a.compare(b)
        take_a : Bool = cmp.le(0)
        branch take_a
            ? take_a(i, j, k, a)
            : take_b(i, j, k, b)

    block take_a(i: USize, j: USize, k: USize, a: T):
        dst.stride(k).store(a)
        jump loop(i.add(1), j, k.add(1))

    block take_b(i: USize, j: USize, k: USize, b: T):
        dst.stride(k).store(b)
        jump loop(i, j.add(1), k.add(1))

    block drain_a(i: USize, k: USize):
        done : Bool = i.ge(mid)
        branch done
            ? return()
            : copy_a(i, k)

    block copy_a(i: USize, k: USize):
        v : T = src.stride(i).load()
        dst.stride(k).store(v)
        jump drain_a(i.add(1), k.add(1))

    block drain_b(j: USize, k: USize):
        done : Bool = j.ge(hi)
        branch done
            ? return()
            : copy_b(j, k)

    block copy_b(j: USize, k: USize):
        v : T = src.stride(j).load()
        dst.stride(k).store(v)
        jump drain_b(j.add(1), k.add(1))

// -- one bottom-up pass merging every pair of width-sized runs -----------------

routine sort_merge_pass<T>(src: @T, dst: @T, n: USize, width: USize) -> Void
require T: typename, Compare<T>
    block entry():
        jump loop(0)

    block loop(lo: USize):
        done : Bool = lo.ge(n)
        branch done
            ? return()
            : run(lo)

    block run(lo: USize):
        mid_raw : USize = lo.add(width)
        hi_raw  : USize = mid_raw.add(width)
        mid_ok  : Bool  = mid_raw.le(n)
        mid     : USize = mid_ok
            ? mid_raw
            : n
        hi_ok : Bool  = hi_raw.le(n)
        hi    : USize = hi_ok
            ? hi_raw
            : n
        sort_merge<T>(src, dst, lo, mid, hi)
        jump loop(hi_raw)

// -- public entry point --------------------------------------------------------

#track_caller
routine List<T>.sort(self: @Self) -> Void
require T: typename, Compare<T>
    block entry():
        n     : USize = self.length.load()
        small : Bool  = n.le(SORT_RUN)
        branch small
            ? small_sort(n)
            : big_sort(n)

    block small_sort(n: USize):
        data : @T = self.data.load()
        sort_insertion<T>(data, 0, n)
        return()

    block big_sort(n: USize):
        data    : @T         = self.data.load()
        alloc   : @Allocator = self.alloc.load()
        scratch : @T         = allocate<T>(alloc, n)
        failed  : Bool       = scratch.is_null()
        branch failed
            ? panic(TrapCode.AllocFailed)
            : run_loop(0, n, data, scratch)

    block run_loop(lo: USize, n: USize, data: @T, scratch: @T):
        done : Bool = lo.ge(n)
        branch done
            ? pass_start(n, data, scratch)
            : run_step(lo, n, data, scratch)

    block run_step(lo: USize, n: USize, data: @T, scratch: @T):
        hi_raw : USize = lo.add(SORT_RUN)
        hi_ok  : Bool  = hi_raw.le(n)
        hi     : USize = hi_ok
            ? hi_raw
            : n
        sort_insertion<T>(data, lo, hi)
        jump run_loop(hi_raw, n, data, scratch)

    block pass_start(n: USize, data: @T, scratch: @T):
        jump pass_loop(SORT_RUN, data, scratch, n, data, scratch)

    block pass_loop(width: USize, src: @T, dst: @T, n: USize, data: @T, scratch: @T):
        done : Bool = width.ge(n)
        branch done
            ? finish(src, n, data, scratch)
            : pass(width, src, dst, n, data, scratch)

    block pass(width: USize, src: @T, dst: @T, n: USize, data: @T, scratch: @T):
        sort_merge_pass<T>(src, dst, n, width)
        jump pass_loop(width.mul(2), dst, src, n, data, scratch)

    block finish(src: @T, n: USize, data: @T, scratch: @T):
        in_place : Bool = src.ptr_eq(data)
        branch in_place
            ? release(scratch)
            : copy_back(src, data, scratch, n)

    block copy_back(src: @T, data: @T, scratch: @T, n: USize):
        copy<T>(data, src, n)
        jump release(scratch)

    block release(scratch: @T):
        scratch.free(self.alloc.load())
        return()
