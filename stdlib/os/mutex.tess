// Tessera stdlib: Mutex
//
// A lock in one U32, the same on every operating system: atomics for the
// uncontended case and wait_on / wake_one for the rest (Drepper's three-state
// futex mutex). 0 is free, 1 locked, 2 locked with a thread that may be
// waiting. A Mutex starts free (Mutex { state: 0 }) and needs nothing to free.

module Standard::Os

record Mutex
    state : U32

routine Mutex.construct() -> Self
    block entry():
        m : Self = Self { state: 0 }
        return(m)

routine Mutex.lock(self: @Self) -> Void
    block entry():
        claim found : @U32 <- 0
        took : Bool = self.state.atomic_compare_exchange_acquire_raw(0, 1, found)
        branch took
            ? return()
            : contended()

    // Marks the lock contended; whoever takes it from 0 this way holds it.
    block contended():
        previous : U32  = self.state.atomic_swap_acquire(2)
        took     : Bool = previous.eq(0)
        branch took
            ? return()
            : sleep()

    block sleep():
        wait_on(self.state, 2)
        jump contended()

routine Mutex.unlock(self: @Self) -> Void
    block entry():
        previous : U32  = self.state.atomic_swap_release(0)
        waiting  : Bool = previous.eq(2)
        branch waiting
            ? wake()
            : return()

    block wake():
        wake_one(self.state)
        return()

/// Takes the lock if it is free, without waiting: whether it did.
routine Mutex.try_lock(self: @Self) -> Bool
    block entry():
        claim found : @U32 <- 0
        took : Bool = self.state.atomic_compare_exchange_acquire_raw(0, 1, found)
        return(took)
