// Tessera stdlib: the C runtime calls the hosted layer needs
//
// write(2) for the writers in os/writers.tess, read(2) for the fiber
// scheduler's read, and exit(3) for the default panic handler. Printing goes
// through a writer: print("x = {x}\n") for stdout, eprint for stderr, and
// write(out, ...) for any other Writer.
//
// CInt and SSize appear only on these externs; lengths are USize.

module Standard::Os

#[external("c"), symbol("write")]
routine c_write(fd: CInt, buf: @Byte, count: USize) -> SSize

#[external("c"), symbol("read")]
routine c_read(fd: CInt, buf: @Byte, count: USize) -> SSize

#[external("c"), symbol("exit"), noreturn]
routine c_exit(status: CInt) -> Void
