// Tessera stdlib: formatting
//
// Formatting writes text into a Writer: any type with a write_bytes method.
// Nothing allocates unless the Writer does, nothing parses a format string, and
// every value is written by one visible call:
//
//     %out_val: FdWriter = FdWriter.stdout()
//     #out: Ptr<FdWriter> = alloca<FdWriter>([%out_val])
//     write_str(#out, "x = ")
//     %x.format(#out)
//     write_line(#out)
//
// A type is formattable when it conforms to Format. Integers have two forms:
// format (decimal, signed for S types and unsigned for U types) and format_hex
// (lowercase hex of the bits).

module Standard::Format

concept Writer<W>
require W: typename
    /// Write %length bytes starting at #data.
    routine Self.write_bytes(#self: Ptr<Self>, #data: Ptr<Byte>, %length: U64) -> Void

concept Format<T>
require T: typename
    routine Self.format<W>(%self: Self, #out: Ptr<W>) -> Void

/// The built-in types' format routines are further down.
conform Format<S8>, Format<S16>, Format<S32>, Format<S64>, Format<S128>, Format<S256>
conform Format<U8>, Format<U16>, Format<U32>, Format<U64>, Format<U128>, Format<U256>
conform Format<F16>, Format<BF16>, Format<F32>, Format<F64>, Format<F128>
conform Format<Bool>, Format<Char>, Format<String>

// -- FdWriter ------------------------------------------------------------------

/// Writes straight to a file descriptor with write(2): no buffer, so nothing is
/// lost if the program stops, and every call is a system call. A failed write
/// sets `failed` and drops the rest// check has_failed() when it matters.
record FdWriter
conform Writer<FdWriter>
    private fd:     S32
    private failed: Bool

routine FdWriter.stdout() -> Self
    block entry():
        %w: Self = Self { fd: 1, failed: false }
        return(%w)

routine FdWriter.stderr() -> Self
    block entry():
        %w: Self = Self { fd: 2, failed: false }
        return(%w)

routine FdWriter.has_failed(#self: Ptr<Self>) -> Bool
    block entry():
        %failed: Bool := #self.failed
        return(%failed)

/// write(2) may write fewer bytes than asked, so this loops. Each call asks for
/// at most 2^30 bytes and reads the result as a 32-bit count: the binding in
/// io.tess declares CSize, but the Windows CRT returns int (open question #18).
routine FdWriter.write_bytes(#self: Ptr<Self>, #data: Ptr<Byte>, %length: U64) -> Void
    block entry():
        %fd: S32 := #self.fd
        jump write_loop(#data, %length, %fd)

    block write_loop(#at: Ptr<Byte>, %remaining: U64, %fd: S32):
        %done: Bool = %remaining.eq(0)
        branch %done ? return() : write_some(#at, %remaining, %fd)

    block write_some(#at: Ptr<Byte>, %remaining: U64, %fd: S32):
        %chunk:    U64   = %remaining.min(1073741824)
        %chunk_c:  CSize = u64_to_csize(%chunk)
        %wrote_c:  CSize = c_write(%fd, #at, %chunk_c)
        %wrote_32: S32   = S32.from_bits(csize_to_u64(%wrote_c).to_u32().bits())
        %progress: Bool  = %wrote_32.gt(0)
        branch %progress ? advance(#at, %remaining, %fd, %wrote_32.to_u64()) : fail()

    block advance(#at: Ptr<Byte>, %remaining: U64, %fd: S32, %wrote: U64):
        #next: Ptr<Byte> = #at[%wrote]
        jump write_loop(#next, %remaining.sub(%wrote), %fd)

    block fail():
        #self.failed = true
        return()

// -- SliceWriter ---------------------------------------------------------------

/// Writes into a caller's buffer, for formatting into memory without a heap. What
/// doesn't fit is dropped and sets `overflowed`.
record SliceWriter
conform Writer<SliceWriter>
    data:       Ptr<Byte>
    capacity:   U64
    length:     U64
    overflowed: Bool

routine SliceWriter.new(#data: Ptr<Byte>, %capacity: U64) -> Self
    block entry():
        %w: Self = Self { data: #data, capacity: %capacity, length: 0, overflowed: false }
        return(%w)

/// The text written so far, a view into the buffer.
routine SliceWriter.as_string(#self: Ptr<Self>) -> String
    block entry():
        #data:   Ptr<Byte> := #self.data
        %length: U64       := #self.length
        %s: String = String.from_ptr(#data, %length)
        return(%s)

routine SliceWriter.has_overflowed(#self: Ptr<Self>) -> Bool
    block entry():
        %r: Bool := #self.overflowed
        return(%r)

routine SliceWriter.write_bytes(#self: Ptr<Self>, #bytes: Ptr<Byte>, %count: U64) -> Void
    block entry():
        %length:   U64  := #self.length
        %capacity: U64  := #self.capacity
        %room:     U64  = %capacity.sub(%length)
        %fits:     Bool = %count.le(%room)
        %taken:    U64  = %count.min(%room)
        #data: Ptr<Byte> := #self.data
        #to:   Ptr<Byte> = #data[%length]
        copy<Byte>(#to, #bytes, %taken)
        #self.length = %length.add(%taken)
        branch %fits ? return() : overflow()

    block overflow():
        #self.overflowed = true
        return()

// -- BufWriter -----------------------------------------------------------------

/// Collects writes in a 4 KiB buffer and passes them on to another Writer in
/// large pieces. Nothing reaches the inner Writer until the buffer fills or
/// flush() is called, and nothing flushes by itself: call flush() before the
/// program ends or reads input. Writes of 4 KiB or more skip the buffer.
record BufWriter<W>
require W: typename
conform Writer<BufWriter<W>>
    inner:  Ptr<W>
    length: U64
    data:   Array<Byte, 4096>

routine BufWriter<W>.init(#self: Ptr<Self>, #inner: Ptr<W>) -> Void
require W: typename
    block entry():
        #self.inner = #inner
        #self.length = 0
        return()

/// Writes out the buffered bytes.
routine BufWriter<W>.flush(#self: Ptr<Self>) -> Void
require W: typename, Writer<W>
    block entry():
        %length: U64       := #self.length
        #inner:  Ptr<W>    := #self.inner
        #buffer: Ptr<Array<Byte, 4096>> = #self.data
        #data:   Ptr<Byte> = #buffer.cast<Byte>()
        #self.length = 0
        %empty: Bool = %length.eq(0)
        branch %empty ? return() : pass(#inner, #data, %length)

    block pass(#inner: Ptr<W>, #data: Ptr<Byte>, %length: U64):
        #inner.write_bytes(#data, %length)
        return()

routine BufWriter<W>.write_bytes(#self: Ptr<Self>, #bytes: Ptr<Byte>, %count: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %length: U64  := #self.length
        %fits:   Bool = %length.add(%count).le(4096)
        branch %fits ? append(%length) : make_room()

    block make_room():
        #self.flush()
        %large: Bool = %count.ge(4096)
        branch %large ? direct() : append(0)

    block direct():
        #inner: Ptr<W> := #self.inner
        #inner.write_bytes(#bytes, %count)
        return()

    block append(%length: U64):
        #buffer: Ptr<Array<Byte, 4096>> = #self.data
        #data:   Ptr<Byte> = #buffer.cast<Byte>()
        #to:     Ptr<Byte> = #data[%length]
        copy<Byte>(#to, #bytes, %count)
        #self.length = %length.add(%count)
        return()

// -- CountWriter ---------------------------------------------------------------

/// Writes nothing and counts characters (UTF-8 code points: every byte that
/// isn't a continuation byte), to measure text before laying it out.
record CountWriter
conform Writer<CountWriter>
    count: U64

routine CountWriter.new() -> Self
    block entry():
        %w: Self = Self { count: 0 }
        return(%w)

routine CountWriter.write_bytes(#self: Ptr<Self>, #bytes: Ptr<Byte>, %length: U64) -> Void
    block entry():
        %count: U64 := #self.count
        jump loop(0, %count)

    block loop(%i: U64, %count: U64):
        %done: Bool = %i.ge(%length)
        branch %done ? finish(%count) : step(%i, %count)

    // continuation bytes are 10xxxxxx
    block step(%i: U64, %count: U64):
        %byte:   U8   = U8.from_byte(#bytes[%i])
        %starts: Bool = %byte.bitand(0xC0).ne(0x80)
        jump loop(%i.add(1), %count.add(%starts.to_u64()))

    block finish(%count: U64):
        #self.count = %count
        return()

// -- text ----------------------------------------------------------------------

routine write_str<W>(#out: Ptr<W>, %text: String) -> Void
require W: typename, Writer<W>
    block entry():
        #data:   Ptr<Byte> = %text.data
        %length: U64       = %text.length
        #out.write_bytes(#data, %length)
        return()

routine write_line<W>(#out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, "\n")
        return()

// -- integer digits ------------------------------------------------------------

/// %value in decimal, zero-padded to at least %min_digits digits (at most 20).
routine write_decimal_u64<W>(#out: Ptr<W>, %value: U64, %min_digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        #buf:    Ptr<Array<Byte, 20>> = alloca<Array<Byte, 20>>
        #digits: Ptr<Byte>            = #buf.cast<Byte>()
        jump digit(20, %value, #digits)

    // Fills #digits from the right: at least one digit, then until the value is
    // used up and %min_digits are written.
    block digit(%end: U64, %rest: U64, #digits: Ptr<Byte>):
        %at:    U64 = %end.sub(1)
        %ascii: U8  = %rest.rem(10).to_u8().add(48)          // '0' = 48
        #digits[%at] = %ascii.bits()
        %next:       U64  = %rest.div(10)
        %written:    U64  = 20.sub(%at)
        %more_value: Bool = %next.ne(0)
        %more_width: Bool = %written.lt(%min_digits)
        %more:       Bool = %more_value.bitor(%more_width)
        branch %more ? digit(%at, %next, #digits) : emit(%at, #digits)

    block emit(%start: U64, #digits: Ptr<Byte>):
        #first: Ptr<Byte> = #digits[%start]
        #out.write_bytes(#first, 20.sub(%start))
        return()

/// A minus sign when negative, then the magnitude (which always fits in U64).
routine write_decimal_s64<W>(#out: Ptr<W>, %value: S64) -> Void
require W: typename, Writer<W>
    block entry():
        %negative: Bool = %value.lt(0)
        branch %negative ? minus() : plain()

    block plain():
        write_decimal_u64(#out, %value.abs_diff(0), 0)
        return()

    block minus():
        write_str(#out, "-")
        write_decimal_u64(#out, %value.abs_diff(0), 0)
        return()

/// %value in lowercase hex, zero-padded to at least %min_digits digits (at
/// most 16).
routine write_hex_u64<W>(#out: Ptr<W>, %value: U64, %min_digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        #buf:    Ptr<Array<Byte, 16>> = alloca<Array<Byte, 16>>
        #digits: Ptr<Byte>            = #buf.cast<Byte>()
        jump digit(16, %value, #digits)

    block digit(%end: U64, %rest: U64, #digits: Ptr<Byte>):
        %at:      U64  = %end.sub(1)
        %nibble:  U8   = %rest.bitand(15).to_u8()
        %decimal: Bool = %nibble.lt(10)
        %base:    U8   = %decimal ? 48 : 87            // '0', or 'a' - 10
        #digits[%at] = %base.add(%nibble).bits()
        %next:       U64  = %rest.shr(4)
        %written:    U64  = 16.sub(%at)
        %more_value: Bool = %next.ne(0)
        %more_width: Bool = %written.lt(%min_digits)
        %more:       Bool = %more_value.bitor(%more_width)
        branch %more ? digit(%at, %next, #digits) : emit(%at, #digits)

    block emit(%start: U64, #digits: Ptr<Byte>):
        #first: Ptr<Byte> = #digits[%start]
        #out.write_bytes(#first, 16.sub(%start))
        return()

preset TEN_POW_19: U128 = 10000000000000000000
preset TWO_POW_64: U128 = 18446744073709551616

/// 128-bit values go out in 19-digit chunks, so only the chunking divides U128.
routine write_decimal_u128<W>(#out: Ptr<W>, %value: U128, %min_digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %fits: Bool = %value.lt(TWO_POW_64)
        branch %fits ? low_only() : split()

    block low_only():
        write_decimal_u64(#out, %value.to_u64(), %min_digits)
        return()

    block split():
        %high:     U128 = %value.div(TEN_POW_19)
        %low:      U128 = %value.rem(TEN_POW_19)
        %high_min: U64  = %min_digits.sub_clamp(19)
        write_decimal_u128(#out, %high, %high_min)
        write_decimal_u64(#out, %low.to_u64(), 19)
        return()

routine write_decimal_s128<W>(#out: Ptr<W>, %value: S128) -> Void
require W: typename, Writer<W>
    block entry():
        %negative: Bool = %value.lt(0)
        branch %negative ? minus() : plain()

    block plain():
        write_decimal_u128(#out, %value.abs_diff(0), 0)
        return()

    block minus():
        write_str(#out, "-")
        write_decimal_u128(#out, %value.abs_diff(0), 0)
        return()

routine write_hex_u128<W>(#out: Ptr<W>, %value: U128) -> Void
require W: typename, Writer<W>
    block entry():
        %high: U64  = %value.shr(64).to_u64()
        %low:  U64  = %value.to_u64_wrap()
        %wide: Bool = %high.ne(0)
        branch %wide ? both(%high, %low) : low_only(%low)

    block low_only(%low: U64):
        write_hex_u64(#out, %low, 0)
        return()

    block both(%high: U64, %low: U64):
        write_hex_u64(#out, %high, 0)
        write_hex_u64(#out, %low, 16)
        return()

preset TEN_POW_19_WIDE: U256 = 10000000000000000000

/// 256-bit values go out in 19-digit chunks too, until the rest fits in 128 bits.
routine write_decimal_u256<W>(#out: Ptr<W>, %value: U256, %min_digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %fits: Bool = %value.shr(128).eq(0)
        branch %fits ? narrow() : split()

    block narrow():
        write_decimal_u128(#out, %value.to_u128(), %min_digits)
        return()

    block split():
        %high:     U256 = %value.div(TEN_POW_19_WIDE)
        %low:      U256 = %value.rem(TEN_POW_19_WIDE)
        %high_min: U64  = %min_digits.sub_clamp(19)
        write_decimal_u256(#out, %high, %high_min)
        write_decimal_u64(#out, %low.to_u64(), 19)
        return()

routine write_decimal_s256<W>(#out: Ptr<W>, %value: S256) -> Void
require W: typename, Writer<W>
    block entry():
        %negative: Bool = %value.lt(0)
        branch %negative ? minus() : plain()

    block plain():
        write_decimal_u256(#out, %value.abs_diff(0), 0)
        return()

    block minus():
        write_str(#out, "-")
        write_decimal_u256(#out, %value.abs_diff(0), 0)
        return()

routine write_hex_u256<W>(#out: Ptr<W>, %value: U256) -> Void
require W: typename, Writer<W>
    block entry():
        %high: U128 = %value.shr(128).to_u128()
        %low:  U128 = %value.to_u128_wrap()
        %wide: Bool = %high.ne(0)
        branch %wide ? both(%high, %low) : low_only(%low)

    block low_only(%low: U128):
        write_hex_u128(#out, %low)
        return()

    block both(%high: U128, %low: U128):
        write_hex_u128(#out, %high)
        write_hex_u64(#out, %low.shr(64).to_u64(), 16)
        write_hex_u64(#out, %low.to_u64_wrap(), 16)
        return()

// -- Format --------------------------------------------------------------------
//
// Decimal follows the type (S types signed, U types unsigned)// hex writes the
// bits, so a negative S value shows its two's complement.

routine S8.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_s64(#out, %self.to_s64())
        return()

routine S8.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, U8.from_byte(%self.bits()).to_u64(), 0)
        return()

routine S16.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_s64(#out, %self.to_s64())
        return()

routine S16.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, U16.from_bits(%self.bits()).to_u64(), 0)
        return()

routine S32.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_s64(#out, %self.to_s64())
        return()

routine S32.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, U32.from_bits(%self.bits()).to_u64(), 0)
        return()

routine S64.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_s64(#out, %self)
        return()

routine S64.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, U64.from_bits(%self.bits()), 0)
        return()

routine S128.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_s128(#out, %self)
        return()

routine S128.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u128(#out, U128.from_bits(%self.bits()))
        return()

routine S256.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_s256(#out, %self)
        return()

routine S256.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u256(#out, U256.from_bits(%self.bits()))
        return()

routine U8.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_u64(#out, %self.to_u64(), 0)
        return()

routine U8.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, %self.to_u64(), 0)
        return()

routine U16.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_u64(#out, %self.to_u64(), 0)
        return()

routine U16.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, %self.to_u64(), 0)
        return()

routine U32.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_u64(#out, %self.to_u64(), 0)
        return()

routine U32.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, %self.to_u64(), 0)
        return()

routine U64.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_u64(#out, %self, 0)
        return()

routine U64.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u64(#out, %self, 0)
        return()

routine U128.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_u128(#out, %self, 0)
        return()

routine U128.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u128(#out, %self)
        return()

routine U256.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_decimal_u256(#out, %self, 0)
        return()

routine U256.format_hex<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_hex_u256(#out, %self)
        return()

/// The character's UTF-8 bytes.
routine Char.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        #buf:   Ptr<Array<Byte, 4>> = alloca<Array<Byte, 4>>
        #bytes: Ptr<Byte>           = #buf.cast<Byte>()
        %count: U64 = utf8_encode(%self, #bytes)
        #out.write_bytes(#bytes, %count)
        return()

routine Bool.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        branch %self ? yes() : no()

    block yes():
        write_str(#out, "true")
        return()

    block no():
        write_str(#out, "false")
        return()

routine String.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        write_str(#out, %self)
        return()

// -- floats --------------------------------------------------------------------
//
// Floats print the shortest decimal that reads back to the same value (Ryu,
// stdlib/ryu.tess), laid out like Python's repr: positional when the decimal
// exponent is in -4 .. 15 (0.0001, 1.0, 123.5), scientific otherwise (1e+16,
// 5e-324). Specials are inf, -inf, NaN, and -0.0. Digits are built as ASCII
// codes in U8 buffers and written out as bytes.

/// Writes %count zeros.
routine write_zeros<W>(#out: Ptr<W>, %count: U64) -> Void
require W: typename, Writer<W>
    block entry():
        jump loop(%count)

    block loop(%left: U64):
        %done: Bool = %left.eq(0)
        branch %done ? return() : one(%left)

    block one(%left: U64):
        write_str(#out, "0")
        jump loop(%left.sub(1))

/// Writes %count ASCII digits starting at #first.
routine write_digits<W>(#out: Ptr<W>, #first: Ptr<U8>, %count: U64) -> Void
require W: typename, Writer<W>
    block entry():
        #bytes: Ptr<Byte> = #first.cast<Byte>()
        #out.write_bytes(#bytes, %count)
        return()

/// Writes digits × 10^exponent (digits > 0, at most 19 digits).
routine write_float_decimal<W>(#out: Ptr<W>, %d: FloatDecimal) -> Void
require W: typename, Writer<W>
    block entry():
        #buf:    Ptr<Array<U8, 20>> = alloca<Array<U8, 20>>
        #digits: Ptr<U8>            = #buf.cast<U8>()
        %value:  U64 = %d.digits
        jump fill(20, %value, #digits)

    block fill(%end: U64, %rest: U64, #digits: Ptr<U8>):
        %at: U64 = %end.sub(1)
        #digits[%at] = %rest.rem(10).to_u8().add(48)
        %next: U64  = %rest.div(10)
        %more: Bool = %next.ne(0)
        branch %more ? fill(%at, %next, #digits) : layout(%at, #digits)

    block layout(%start: U64, #digits: Ptr<U8>):
        #first: Ptr<U8> = #digits[%start]
        write_decimal_digits(#out, #first, 20.sub(%start), %d.exponent)
        return()

/// Writes the %n ASCII digits at #first times 10^exponent (no leading zero). The
/// point goes after the first digit at scientific exponent x = n - 1 + exponent.
routine write_decimal_digits<W>(#out: Ptr<W>, #first: Ptr<U8>, %n: U64, %exponent: S64) -> Void
require W: typename, Writer<W>
    block entry():
        %x:          S64  = %n.to_s64().sub(1).add(%exponent)
        %low_ok:     Bool = %x.ge(-4)
        %high_ok:    Bool = %x.lt(16)
        %positional: Bool = %low_ok.bitand(%high_ok)
        branch %positional ? positional(%x) : scientific(%x)

    block positional(%x: S64):
        %whole:    Bool = %exponent.ge(0)
        %fraction: Bool = %x.lt(0)
        select:
            %whole -> integral()
            %fraction -> below_one(%x)
            _ -> split()

    // 1234 × 10^2 → 123400.0
    block integral():
        write_digits(#out, #first, %n)
        write_zeros(#out, %exponent.to_u64())
        write_str(#out, ".0")
        return()

    // 1234 × 10^-6 → 0.001234
    block below_one(%x: S64):
        write_str(#out, "0.")
        write_zeros(#out, %x.abs_diff(0).sub(1))
        write_digits(#out, #first, %n)
        return()

    // 1234 × 10^-2 → 12.34
    block split():
        %tail: U64 = %exponent.abs_diff(0)
        %head: U64 = %n.sub(%tail)
        write_digits(#out, #first, %head)
        write_str(#out, ".")
        #rest: Ptr<U8> = #first[%head]
        write_digits(#out, #rest, %tail)
        return()

    // 1234 × 10^20 → 1.234e+23
    block scientific(%x: S64):
        write_digits(#out, #first, 1)
        %more: Bool = %n.gt(1)
        branch %more ? mantissa_tail(%x) : exponent_part(%x)

    block mantissa_tail(%x: S64):
        write_str(#out, ".")
        #rest: Ptr<U8> = #first[1]
        write_digits(#out, #rest, %n.sub(1))
        jump exponent_part(%x)

    // e+XX / e-XX, at least two digits
    block exponent_part(%x: S64):
        %negative: Bool = %x.lt(0)
        branch %negative ? minus_exponent(%x) : plus_exponent(%x)

    block minus_exponent(%x: S64):
        write_str(#out, "e-")
        write_decimal_u64(#out, %x.abs_diff(0), 2)
        return()

    block plus_exponent(%x: S64):
        write_str(#out, "e+")
        write_decimal_u64(#out, %x.abs_diff(0), 2)
        return()

/// Writes a binary float given its IEEE fields. %exponent_max is the all-ones
/// exponent (infinity / NaN).
routine write_binary_float<W>(
    #out: Ptr<W>, %negative: Bool, %mantissa: U64, %exponent: U64,
    %mantissa_bits: S64, %bias: S64, %exponent_max: U64
) -> Void
require W: typename, Writer<W>
    block entry():
        %special: Bool = %exponent.eq(%exponent_max)
        branch %special ? special() : sign()

    block special():
        %nan: Bool = %mantissa.ne(0)
        branch %nan ? nan() : infinity()

    block nan():
        write_str(#out, "NaN")
        return()

    block infinity():
        branch %negative ? negative_infinity() : positive_infinity()

    block negative_infinity():
        write_str(#out, "-inf")
        return()

    block positive_infinity():
        write_str(#out, "inf")
        return()

    block sign():
        branch %negative ? minus() : magnitude()

    block minus():
        write_str(#out, "-")
        jump magnitude()

    block magnitude():
        %zero: Bool = %mantissa.bitor(%exponent).eq(0)
        branch %zero ? zero() : digits()

    block zero():
        write_str(#out, "0.0")
        return()

    block digits():
        %double: Bool = %mantissa_bits.eq(52)
        branch %double ? double() : narrow()

    block double():
        %d: FloatDecimal = ryu_double_decimal(%mantissa, %exponent.to_s64())
        write_float_decimal(#out, %d)
        return()

    block narrow():
        %d: FloatDecimal = ryu_float_decimal(%mantissa.to_s64(), %exponent.to_s64(), %mantissa_bits, %bias)
        write_float_decimal(#out, %d)
        return()

routine F64.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U64.from_bits(%self.bits())
        %negative: Bool = %bits.shr(63).eq(1)
        %mantissa: U64  = %bits.bitand(0x000FFFFFFFFFFFFF)          // 2^52 - 1
        %exponent: U64  = %bits.shr(52).bitand(2047)
        write_binary_float(#out, %negative, %mantissa, %exponent, 52, 1023, 2047)
        return()

routine F32.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U32.from_bits(%self.bits()).to_u64()
        %negative: Bool = %bits.shr(31).eq(1)
        %mantissa: U64  = %bits.bitand(0x7FFFFF)                    // 2^23 - 1
        %exponent: U64  = %bits.shr(23).bitand(255)
        write_binary_float(#out, %negative, %mantissa, %exponent, 23, 127, 255)
        return()

routine F16.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U16.from_bits(%self.bits()).to_u64()
        %negative: Bool = %bits.shr(15).eq(1)
        %mantissa: U64  = %bits.bitand(0x3FF)                       // 2^10 - 1
        %exponent: U64  = %bits.shr(10).bitand(31)
        write_binary_float(#out, %negative, %mantissa, %exponent, 10, 15, 31)
        return()

routine BF16.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U16.from_bits(%self.bits()).to_u64()
        %negative: Bool = %bits.shr(15).eq(1)
        %mantissa: U64  = %bits.bitand(0x7F)                        // 2^7 - 1
        %exponent: U64  = %bits.shr(7).bitand(255)
        write_binary_float(#out, %negative, %mantissa, %exponent, 7, 127, 255)
        return()

// -- F128 ----------------------------------------------------------------------
//
// F128 needs up to 36 digits, past Ryu's 64-bit tables, so its shortest digits
// come from Burger and Dybvig's exact method ("Printing Floating-Point Numbers
// Quickly and Accurately", 1996) on BigNats. With v = f × 2^e, the value,
// half the gap to the next float, and half the gap to the previous one are
// r / s, m+ / s, and m- / s. Digits come out one at a time until the number so
// far is inside the rounding interval// the last digit is the nearer choice.

/// floor(x × log10(2)), for |x| up to about 10^6
routine floor_log10_pow2(%x: S64) -> S64
    block entry():
        %r: S64 = %x.mul(646456993).shr(31)
        return(%r)

/// Writes f × 2^e (f > 0) as its shortest round-trip decimal. %boundary says the
/// gap below is half the gap above (f is a power of two above the smallest
/// normal)// %even says ties read back as this float (f is even).
routine write_float_exact<W>(#out: Ptr<W>, %f: U128, %e: S64, %boundary: Bool, %even: Bool) -> Void
require W: typename, Writer<W>
    block entry():
        #r:     Ptr<BigNat<320>> = alloca<BigNat<320>>
        #s:     Ptr<BigNat<320>> = alloca<BigNat<320>>
        #plus:  Ptr<BigNat<320>> = alloca<BigNat<320>>
        #minus: Ptr<BigNat<320>> = alloca<BigNat<320>>
        #t:     Ptr<BigNat<320>> = alloca<BigNat<320>>
        #r.set_u128(%f)
        #s.set(1)
        #plus.set(1)
        #minus.set(1)
        // r = 2f (4f at a boundary)// s = 2 (4); m+ = 1 (2); m- = 1; then 2^e
        // goes on r, m+, m- when e >= 0 and on s when e < 0.
        %doubling: U64 = %boundary ? 2 : 1
        #r.shl(%doubling)
        #s.shl(%doubling)
        #plus.shl(%doubling.sub(1))
        %up: Bool = %e.ge(0)
        branch %up ? scale_up(#r, #s, #plus, #minus, #t) : scale_down(#r, #s, #plus, #minus, #t)

    block scale_up(#r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        %up: U64 = %e.to_u64()
        #r.shl(%up)
        #plus.shl(%up)
        #minus.shl(%up)
        jump estimate(#r, #s, #plus, #minus, #t)

    block scale_down(#r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        #s.shl(%e.abs_diff(0))
        jump estimate(#r, #s, #plus, #minus, #t)

    // k = floor((bits(f) - 1 + e) × log10 2) + 1 is at most ceil(log10 v)//
    // divide by 10^k (multiply s, or r and the margins).
    block estimate(#r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        %bits: S64 = 128.sub(%f.leading_zeros().to_s64())
        %k:    S64 = floor_log10_pow2(%bits.sub(1).add(%e)).add(1)
        %positive: Bool = %k.ge(0)
        branch %positive ? divide_s(%k, #r, #s, #plus, #minus, #t) : multiply_r(%k, #r, #s, #plus, #minus, #t)

    block divide_s(%k: S64, #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        #s.mul_pow10(%k.to_u64())
        jump fixup(%k, #r, #s, #plus, #minus, #t)

    block multiply_r(%k: S64, #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        %up: U64 = %k.abs_diff(0)
        #r.mul_pow10(%up)
        #plus.mul_pow10(%up)
        #minus.mul_pow10(%up)
        jump fixup(%k, #r, #s, #plus, #minus, #t)

    // Raise k while the top of the interval reaches 10^k, so every number in it
    // is below 10^k and the first digit is its leading one.
    block fixup(%k: S64, #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        #t.copy_from(#r)
        #t.add(#plus)
        %cmp:  S32  = #t.compare(#s)
        %high: Bool = %even ? %cmp.ge(0) : %cmp.gt(0)
        branch %high ? raise(%k, #r, #s, #plus, #minus, #t) : start(%k, #r, #s, #plus, #minus, #t)

    block raise(%k: S64, #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        #s.mul_add(10, 0)
        jump fixup(%k.add(1), #r, #s, #plus, #minus, #t)

    block start(%k: S64, #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>):
        #buf:    Ptr<Array<U8, 48>> = alloca<Array<U8, 48>>
        #digits: Ptr<U8>            = #buf.cast<U8>()
        jump next_digit(0, %k, #digits, #r, #s, #plus, #minus, #t)

    // d = floor(10r / s), r = 10r mod s, and the margins scale by 10 too.
    block next_digit(
        %n: U64, %k: S64, #digits: Ptr<U8>,
        #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>
    ):
        #r.mul_add(10, 0)
        #plus.mul_add(10, 0)
        #minus.mul_add(10, 0)
        jump take(0, %n, %k, #digits, #r, #s, #plus, #minus, #t)

    block take(
        %d: U8, %n: U64, %k: S64, #digits: Ptr<U8>,
        #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>
    ):
        %more: Bool = #r.compare(#s).ge(0)
        branch %more ? take_one(%d, %n, %k, #digits, #r, #s, #plus, #minus, #t)
                     : judge(%d, %n, %k, #digits, #r, #s, #plus, #minus, #t)

    block take_one(
        %d: U8, %n: U64, %k: S64, #digits: Ptr<U8>,
        #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>
    ):
        #r.sub(#s)
        jump take(%d.add(1), %n, %k, #digits, #r, #s, #plus, #minus, #t)

    // low: the digits so far are already within m- of the value// high: rounding
    // this digit up is within m+. Either one ends the output.
    block judge(
        %d: U8, %n: U64, %k: S64, #digits: Ptr<U8>,
        #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>
    ):
        %low_cmp:  S32  = #r.compare(#minus)
        %low:      Bool = %even ? %low_cmp.le(0) : %low_cmp.lt(0)
        #t.copy_from(#r)
        #t.add(#plus)
        %high_cmp: S32  = #t.compare(#s)
        %high:     Bool = %even ? %high_cmp.ge(0) : %high_cmp.gt(0)
        %either:   Bool = %low.bitor(%high)
        branch %either ? last(%d, %n, %k, %low, %high, #digits, #r, #s, #t)
                       : emit(%d, %n, %k, #digits, #r, #s, #plus, #minus, #t)

    block emit(
        %d: U8, %n: U64, %k: S64, #digits: Ptr<U8>,
        #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #plus: Ptr<BigNat<320>>, #minus: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>
    ):
        #digits[%n] = %d.add(48)
        jump next_digit(%n.add(1), %k, #digits, #r, #s, #plus, #minus, #t)

    // Both ends reachable: the nearer one, and the even digit on an exact tie.
    block last(
        %d: U8, %n: U64, %k: S64, %low: Bool, %high: Bool, #digits: Ptr<U8>,
        #r: Ptr<BigNat<320>>, #s: Ptr<BigNat<320>>, #t: Ptr<BigNat<320>>
    ):
        #t.copy_from(#r)
        #t.shl(1)
        %half:   S32  = #t.compare(#s)
        %d_odd:  Bool = %d.bitand(1).eq(1)
        %nearer: Bool = %half.gt(0).bitor(%half.eq(0).bitand(%d_odd))
        %both:   Bool = %low.bitand(%high)
        %round:  Bool = %both ? %nearer : %high
        %digit:  U8   = %d.add(%round.to_u8())
        #digits[%n] = %digit.add(48)
        %count:  U64  = %n.add(1)
        write_decimal_digits(#out, #digits, %count, %k.sub(%count.to_s64()))
        return()

routine F128.format<W>(%self: Self, #out: Ptr<W>) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U128 = %self.bits
        %negative: Bool = f128_is_negative_bits(%bits)
        %biased:   S64  = f128_exponent(%bits)
        %fraction: U128 = f128_fraction(%bits)
        %special:  Bool = %biased.eq(F128_EXP_MAX)
        branch %special ? special(%negative, %fraction) : sign(%negative, %biased, %fraction)

    block special(%negative: Bool, %fraction: U128):
        %nan: Bool = %fraction.ne(0)
        select:
            %nan -> text("NaN")
            %negative -> text("-inf")
            _ -> text("inf")

    block text(%s: String):
        write_str(#out, %s)
        return()

    block sign(%negative: Bool, %biased: S64, %fraction: U128):
        branch %negative ? minus(%biased, %fraction) : magnitude(%biased, %fraction)

    block minus(%biased: S64, %fraction: U128):
        write_str(#out, "-")
        jump magnitude(%biased, %fraction)

    block magnitude(%biased: S64, %fraction: U128):
        %zero: Bool = %biased.eq(0).bitand(%fraction.eq(0))
        branch %zero ? text("0.0") : digits(%biased, %fraction)

    block digits(%biased: S64, %fraction: U128):
        %subnormal: Bool = %biased.eq(0)
        %f:         U128 = %subnormal ? %fraction : %fraction.bitor(F128_IMPLICIT)
        %e:         S64  = %subnormal ? -16494 : %biased.sub(16383).sub(112)
        %boundary:  Bool = %fraction.eq(0).bitand(%biased.gt(1))
        %even:      Bool = %f.bitand(1).eq(0)
        write_float_exact(#out, %f, %e, %boundary, %even)
        return()

// -- fixed-point floats --------------------------------------------------------
//
// format_fixed(#out, %digits) writes a float with exactly %digits digits after
// the point, like C's %.*f: 3.14159 at 2 is "3.14", 1e20 at 0 is
// "100000000000000000000", -0.001 at 2 is "-0.00". Rounding is correct from the
// exact binary value, ties to even (0.125 at 2 is "0.12", 2.5 at 0 is "2").
// Specials are inf, -inf, and NaN, as in format.

/// Writes f × 2^e (f >= 0, no sign) with %digits digits after the point. A float's
/// own digits end max(0, -e) places after the point, so the rounding works on at
/// most that many and the rest are zeros. Sized for F128: f × 10^16494 needs
/// about 55,000 bits and prints at most 16,530 digits.
routine write_float_fixed<W>(#out: Ptr<W>, %f: U128, %e: S64, %digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        #n: Ptr<BigNat<864>> = alloca<BigNat<864>>
        #n.set_u128(%f)
        %own:    U64  = %e.min(0).abs_diff(0)                 // max(0, -e)
        %places: U64  = %digits.min(%own)
        %up:     Bool = %e.ge(0)
        branch %up ? scale_up(#n, %places) : scale_down(#n, %places)

    block scale_up(#n: Ptr<BigNat<864>>, %places: U64):
        #n.shl(%e.to_u64())
        jump print(#n, %places)

    // round(f × 10^places / 2^-e)
    block scale_down(#n: Ptr<BigNat<864>>, %places: U64):
        #n.mul_pow10(%places)
        #n.shr_round_even(%e.abs_diff(0))
        jump print(#n, %places)

    // The digits of n fill #digits from the right, 19 at a time.
    block print(#n: Ptr<BigNat<864>>, %places: U64):
        #buf:    Ptr<Array<U8, 16640>> = alloca<Array<U8, 16640>>
        #digits: Ptr<U8>               = #buf.cast<U8>()
        jump chunk(#n, #digits, %places, 16640)

    block chunk(#n: Ptr<BigNat<864>>, #digits: Ptr<U8>, %places: U64, %at: U64):
        %done: Bool = #n.is_zero()
        branch %done ? skip_zeros(#digits, %places, %at) : split(#n, #digits, %places, %at)

    block split(#n: Ptr<BigNat<864>>, #digits: Ptr<U8>, %places: U64, %at: U64):
        %low: U64 = #n.div_limb(10000000000000000000)       // 10^19
        jump digit(#n, #digits, %places, %at, %low, 19)

    block digit(#n: Ptr<BigNat<864>>, #digits: Ptr<U8>, %places: U64, %at: U64, %rest: U64, %left: U64):
        %done: Bool = %left.eq(0)
        branch %done ? chunk(#n, #digits, %places, %at) : put(#n, #digits, %places, %at, %rest, %left)

    block put(#n: Ptr<BigNat<864>>, #digits: Ptr<U8>, %places: U64, %at: U64, %rest: U64, %left: U64):
        %to: U64 = %at.sub(1)
        #digits[%to] = %rest.rem(10).to_u8().add(48)
        jump digit(#n, #digits, %places, %to, %rest.div(10), %left.sub(1))

    // the top chunk is zero-padded to 19 digits
    block skip_zeros(#digits: Ptr<U8>, %places: U64, %at: U64):
        %inside: Bool = %at.lt(16640)
        branch %inside ? look(#digits, %places, %at) : lay_out(#digits, %places, %at)

    block look(#digits: Ptr<U8>, %places: U64, %at: U64):
        %ascii: U8   := #digits[%at]
        %zero:  Bool = %ascii.eq(48)
        branch %zero ? skip_zeros(#digits, %places, %at.add(1)) : lay_out(#digits, %places, %at)

    // n has count digits at #digits[first ..]// the last %places of them follow the point
    block lay_out(#digits: Ptr<U8>, %places: U64, %first: U64):
        %count:   U64  = 16640.sub(%first)
        %has_int: Bool = %count.gt(%places)
        branch %has_int ? int_part(#digits, %places, %first, %count.sub(%places)) : zero_int(#digits, %places, %first)

    block int_part(#digits: Ptr<U8>, %places: U64, %first: U64, %int_count: U64):
        #from: Ptr<U8> = #digits[%first]
        write_digits(#out, #from, %int_count)
        jump fraction(#digits, %places, %first.add(%int_count))

    block zero_int(#digits: Ptr<U8>, %places: U64, %first: U64):
        write_str(#out, "0")
        jump fraction(#digits, %places, %first)

    block fraction(#digits: Ptr<U8>, %places: U64, %from: U64):
        %none: Bool = %digits.eq(0)
        branch %none ? return() : point(#digits, %places, %from)

    block point(#digits: Ptr<U8>, %places: U64, %from: U64):
        %count: U64 = 16640.sub(%from)
        write_str(#out, ".")
        write_zeros(#out, %places.sub(%count))
        #start: Ptr<U8> = #digits[%from]
        write_digits(#out, #start, %count)
        write_zeros(#out, %digits.sub(%places))
        return()

/// format_fixed for a binary float given its IEEE fields: %shift is bias +
/// mantissa bits, so a normal value is (1.fraction) × 2^(biased - shift).
routine write_binary_fixed<W>(
    #out: Ptr<W>, %negative: Bool, %fraction: U128, %biased: S64,
    %mantissa_bits: U128, %shift: S64, %exponent_max: S64, %digits: U64
) -> Void
require W: typename, Writer<W>
    block entry():
        %special: Bool = %biased.eq(%exponent_max)
        %nan:     Bool = %special.bitand(%fraction.ne(0))
        select:
            %nan -> text("NaN")
            %special -> infinity()
            %negative -> minus()
            _ -> magnitude()

    block infinity():
        branch %negative ? text("-inf") : text("inf")

    block text(%s: String):
        write_str(#out, %s)
        return()

    block minus():
        write_str(#out, "-")
        jump magnitude()

    block magnitude():
        %subnormal: Bool = %biased.eq(0)
        %implicit:  U128 = 1.shl(%mantissa_bits)
        %f:         U128 = %subnormal ? %fraction : %fraction.bitor(%implicit)
        %e:         S64  = %subnormal ? 1.sub(%shift) : %biased.sub(%shift)
        write_float_fixed(#out, %f, %e, %digits)
        return()

routine F64.format_fixed<W>(%self: Self, #out: Ptr<W>, %digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U64.from_bits(%self.bits())
        %negative: Bool = %bits.shr(63).eq(1)
        %fraction: U128 = %bits.bitand(0x000FFFFFFFFFFFFF).to_u128()   // 2^52 - 1
        %biased:   S64  = %bits.shr(52).bitand(2047).to_s64()
        write_binary_fixed(#out, %negative, %fraction, %biased, 52, 1075, 2047, %digits)
        return()

routine F32.format_fixed<W>(%self: Self, #out: Ptr<W>, %digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U32.from_bits(%self.bits()).to_u64()
        %negative: Bool = %bits.shr(31).eq(1)
        %fraction: U128 = %bits.bitand(0x7FFFFF).to_u128()             // 2^23 - 1
        %biased:   S64  = %bits.shr(23).bitand(255).to_s64()
        write_binary_fixed(#out, %negative, %fraction, %biased, 23, 150, 255, %digits)
        return()

routine F16.format_fixed<W>(%self: Self, #out: Ptr<W>, %digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U16.from_bits(%self.bits()).to_u64()
        %negative: Bool = %bits.shr(15).eq(1)
        %fraction: U128 = %bits.bitand(0x3FF).to_u128()                // 2^10 - 1
        %biased:   S64  = %bits.shr(10).bitand(31).to_s64()
        write_binary_fixed(#out, %negative, %fraction, %biased, 10, 25, 31, %digits)
        return()

routine BF16.format_fixed<W>(%self: Self, #out: Ptr<W>, %digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U64  = U16.from_bits(%self.bits()).to_u64()
        %negative: Bool = %bits.shr(15).eq(1)
        %fraction: U128 = %bits.bitand(0x7F).to_u128()                 // 2^7 - 1
        %biased:   S64  = %bits.shr(7).bitand(255).to_s64()
        write_binary_fixed(#out, %negative, %fraction, %biased, 7, 134, 255, %digits)
        return()

routine F128.format_fixed<W>(%self: Self, #out: Ptr<W>, %digits: U64) -> Void
require W: typename, Writer<W>
    block entry():
        %bits:     U128 = %self.bits
        %negative: Bool = f128_is_negative_bits(%bits)
        %fraction: U128 = f128_fraction(%bits)
        %biased:   S64  = f128_exponent(%bits)
        write_binary_fixed(#out, %negative, %fraction, %biased, 112, 16495, F128_EXP_MAX, %digits)
        return()

// -- views ---------------------------------------------------------------------
//
// A view wraps a value to pick one of its other forms and conforms to Format, so
// it can go where any formattable value goes, format_with included:
//
//     %hex: Hex<U32> = Hex<U32> { value: %bits }
//     format_with(#out, %hex, FormatSpec.zero_padded(8))

/// An integer in lowercase hex (format_hex).
record Hex<T>
require T: typename
conform Format<Hex<T>>
    value: T

routine Hex<T>.format<W>(%self: Self, #out: Ptr<W>) -> Void
require T: typename, W: typename, Writer<W>
    block entry():
        %value: T = %self.value
        %value.format_hex(#out)
        return()

/// A float with a fixed number of digits after the point (format_fixed).
record Fixed<T>
require T: typename
conform Format<Fixed<T>>
    value:  T
    digits: U64

routine Fixed<T>.format<W>(%self: Self, #out: Ptr<W>) -> Void
require T: typename, W: typename, Writer<W>
    block entry():
        %value:  T   = %self.value
        %digits: U64 = %self.digits
        %value.format_fixed(#out, %digits)
        return()

// -- width and alignment -------------------------------------------------------
//
// format_with(#out, %value, %spec) writes any formattable value padded to
// %spec.width characters. It formats the value twice: once into a CountWriter
// to measure it, then for real, so nothing is buffered and any Format type
// works. Width counts code points, not terminal columns.

choice Align: U8
    Left
    Right
    Center
    /// like Right, but the padding goes after a leading - or +: -0042
    AfterSign

record FormatSpec
    width: U64
    fill:  String
    align: Align

/// Right-aligned to %width, padded with spaces.
routine FormatSpec.new(%width: U64) -> Self
    block entry():
        %spec: Self = Self { width: %width, fill: " ", align: Align.Right }
        return(%spec)

/// Padded with zeros after the sign: -7 at 4 is -007.
routine FormatSpec.zero_padded(%width: U64) -> Self
    block entry():
        %spec: Self = Self { width: %width, fill: "0", align: Align.AfterSign }
        return(%spec)

routine FormatSpec.with_align(%self: Self, %align: Align) -> Self
    block entry():
        %spec: Self = Self { width: %self.width, fill: %self.fill, align: %align }
        return(%spec)

/// %fill is one character (any UTF-8 text works, but width counts it as one).
routine FormatSpec.with_fill(%self: Self, %fill: String) -> Self
    block entry():
        %spec: Self = Self { width: %self.width, fill: %fill, align: %self.align }
        return(%spec)

/// Writes %text %count times.
routine write_repeated<W>(#out: Ptr<W>, %text: String, %count: U64) -> Void
require W: typename, Writer<W>
    block entry():
        jump loop(%count)

    block loop(%left: U64):
        %done: Bool = %left.eq(0)
        branch %done ? return() : one(%left)

    block one(%left: U64):
        write_str(#out, %text)
        jump loop(%left.sub(1))

routine format_with<T, W>(#out: Ptr<W>, %value: T, %spec: FormatSpec) -> Void
require T: typename, W: typename, Writer<W>, Format<T>
    block entry():
        %counter_val: CountWriter      = CountWriter.new()
        #counter:     Ptr<CountWriter> = alloca<CountWriter>([%counter_val])
        %value.format(#counter)
        %length: U64    := #counter.count
        %pad:    U64    = %spec.width.sub_clamp(%length)
        %half:   U64    = %pad.div(2)
        %fill:   String = %spec.fill
        %align:  Align  = %spec.align
        switch %align:
            Align.Left -> padded(0, %pad, %fill)
            Align.Right -> padded(%pad, 0, %fill)
            Align.Center -> padded(%half, %pad.sub(%half), %fill)
            Align.AfterSign -> after_sign(%pad, %fill)

    block padded(%before: U64, %after: U64, %fill: String):
        write_repeated(#out, %fill, %before)
        %value.format(#out)
        write_repeated(#out, %fill, %after)
        return()

    block after_sign(%pad: U64, %fill: String):
        %inner_val: SignPadWriter<W>      = SignPadWriter<W> { inner: #out, fill: %fill, pad: %pad }
        #inner:     Ptr<SignPadWriter<W>> = alloca<SignPadWriter<W>>([%inner_val])
        %value.format(#inner)
        return()

/// Passes writes on to #inner, putting %pad copies of %fill before the first
/// byte, or after it when it is - or +.
record SignPadWriter<W>
require W: typename
conform Writer<SignPadWriter<W>>
    inner: Ptr<W>
    fill:  String
    pad:   U64

routine SignPadWriter<W>.write_bytes(#self: Ptr<Self>, #bytes: Ptr<Byte>, %length: U64) -> Void
require W: typename, Writer<W>
    block entry():
        #inner: Ptr<W> := #self.inner
        %pad:   U64    := #self.pad
        %first: Bool   = %pad.gt(0).bitand(%length.gt(0))
        branch %first ? first(#inner, %pad) : pass(#inner, #bytes, %length)

    block first(#inner: Ptr<W>, %pad: U64):
        %fill:   String := #self.fill
        #self.pad = 0
        %byte:   U8     = U8.from_byte(#bytes[0])
        %signed: Bool   = %byte.eq(45).bitor(%byte.eq(43))      // - or +
        branch %signed ? sign(#inner, %pad, %fill) : pad(#inner, %pad, %fill, #bytes, %length)

    block sign(#inner: Ptr<W>, %pad: U64, %fill: String):
        #inner.write_bytes(#bytes, 1)
        #rest: Ptr<Byte> = #bytes[1]
        jump pad(#inner, %pad, %fill, #rest, %length.sub(1))

    block pad(#inner: Ptr<W>, %pad: U64, %fill: String, #from: Ptr<Byte>, %count: U64):
        write_repeated(#inner, %fill, %pad)
        jump pass(#inner, #from, %count)

    block pass(#inner: Ptr<W>, #from: Ptr<Byte>, %count: U64):
        #inner.write_bytes(#from, %count)
        return()
