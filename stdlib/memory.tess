; Tessera stdlib: Allocator pattern and memory routines
;
; The Allocator record is a manual vtable: callers pass Ptr<Allocator> to any
; routine that performs heap allocation.  make_heap_allocator() returns an
; Allocator backed by libc malloc / realloc / free.
;
; Generic routines (alloc, realloc, free, zero, copy) form the prelude memory
; surface used by every collection.  User-facing sizes are U64; C-alias sizes
; (CSize, CInt) appear only at the FFI boundary and immediately convert.

; ============================================================
; FFI integer conversions (U64 ↔ CSize)
;
; Picked per target. On a 64-bit target CSize is U64, so both directions are
; the identity. On a 32-bit target CSize is U32: U64 → CSize panics on a size
; that doesn't fit, and CSize → U64 widens.
; ============================================================

@target(size: 64)
routine u64_to_csize(%n: U64) -> CSize
    block entry():
        return(%n)

@target(size: 32)
routine u64_to_csize(%n: U64) -> CSize
    block entry():
        %r: CSize = %n.to_u32()
        return(%r)

@target(size: 64)
routine csize_to_u64(%n: CSize) -> U64
    block entry():
        return(%n)

@target(size: 32)
routine csize_to_u64(%n: CSize) -> U64
    block entry():
        %r: U64 = %n.to_u64()
        return(%r)

; ============================================================
; C FFI: libc memory
; ============================================================

@[external("c"), symbol("malloc")]
private routine c_malloc(%size: CSize) -> Ptr

@[external("c"), symbol("realloc")]
private routine c_realloc(#ptr: Ptr, %size: CSize) -> Ptr

@[external("c"), symbol("free")]
private routine c_free(#ptr: Ptr) -> Void

@[external("c"), symbol("memcpy")]
private routine c_memcpy(#dst: Ptr, #src: Ptr, %size: CSize) -> Void

@[external("c"), symbol("memset")]
private routine c_memset(#ptr: Ptr, %value: CInt, %size: CSize) -> Void

; ============================================================
; Allocator record
;
; Callbacks use C calling convention and C-alias sizes — they are FFI types.
; ============================================================

record Allocator
    alloc_fn:   Callable<@callconv("c"), (Ptr, CSize), Ptr>
    realloc_fn: Callable<@callconv("c"), (Ptr, Ptr, CSize), Ptr>
    free_fn:    Callable<@callconv("c"), (Ptr, Ptr), Void>
    state: Ptr

; ============================================================
; Heap allocator backend (libc wrappers matching Allocator callbacks)
; ============================================================

@callconv("c")
private routine heap_alloc_fn(#state: Ptr, %size: CSize) -> Ptr
    block entry():
        #result: Ptr = c_malloc(%size)
        return(#result)

@callconv("c")
private routine heap_realloc_fn(#state: Ptr, #old_ptr: Ptr, %size: CSize) -> Ptr
    block entry():
        #result: Ptr = c_realloc(#old_ptr, %size)
        return(#result)

@callconv("c")
private routine heap_free_fn(#state: Ptr, #ptr: Ptr) -> Void
    block entry():
        c_free(#ptr)
        return()

; ============================================================
; Allocator factory
; ============================================================

routine make_heap_allocator() -> Allocator
    block entry():
        %alloc: Allocator = Allocator {
            alloc_fn:   heap_alloc_fn,
            realloc_fn: heap_realloc_fn,
            free_fn:    heap_free_fn,
            state:      null
        }
        return(%alloc)

; ============================================================
; Generic memory routines (prelude surface)
;
; User-facing sizes are U64.  Conversion to CSize happens exactly at the
; allocator-callback boundary.
; ============================================================

routine alloc<T>(#alloc: Ptr<Allocator>, %count: U64) -> Ptr<T>
require T: typename
    block entry():
        %elem_size: U64 = sizeof<T>()
        %size:   U64    = %elem_size.mul(%count)
        %size_c: CSize  = u64_to_csize(%size)
        #raw:    Ptr    = #alloc.alloc_fn(#alloc.state, %size_c)
        #typed:  Ptr<T> = bitcast<Ptr, Ptr<T>>(#raw)
        return(#typed)

routine realloc<T>(#alloc: Ptr<Allocator>, #ptr: Ptr<T>, %new_count: U64) -> Ptr<T>
require T: typename
    block entry():
        %elem_size: U64  = sizeof<T>()
        %size:    U64    = %elem_size.mul(%new_count)
        %size_c:  CSize  = u64_to_csize(%size)
        #raw_old: Ptr    = bitcast<Ptr<T>, Ptr>(#ptr)
        #raw:     Ptr    = #alloc.realloc_fn(#alloc.state, #raw_old, %size_c)
        #typed:   Ptr<T> = bitcast<Ptr, Ptr<T>>(#raw)
        return(#typed)

routine free<T>(#alloc: Ptr<Allocator>, #ptr: Ptr<T>) -> Void
require T: typename
    block entry():
        #raw: Ptr = bitcast<Ptr<T>, Ptr>(#ptr)
        #alloc.free_fn(#alloc.state, #raw)
        return()

routine zero<T>(#ptr: Ptr<T>, %count: U64) -> Void
require T: typename
    block entry():
        %elem_size: U64 = sizeof<T>()
        %size:   U64   = %elem_size.mul(%count)
        %size_c: CSize = u64_to_csize(%size)
        #raw:    Ptr   = bitcast<Ptr<T>, Ptr>(#ptr)
        c_memset(#raw, 0, %size_c)
        return()

routine copy<T>(#dst: Ptr<T>, #src: Ptr<T>, %count: U64) -> Void
require T: typename
    block entry():
        %elem_size: U64 = sizeof<T>()
        %size:    U64   = %elem_size.mul(%count)
        %size_c:  CSize = u64_to_csize(%size)
        #raw_dst: Ptr   = bitcast<Ptr<T>, Ptr>(#dst)
        #raw_src: Ptr   = bitcast<Ptr<T>, Ptr>(#src)
        c_memcpy(#raw_dst, #raw_src, %size_c)
        return()
