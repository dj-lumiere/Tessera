// Tessera stdlib: Allocator pattern and memory routines
//
// The Allocator record is a manual vtable: callers pass Ptr<Allocator> to any
// routine that performs heap allocation.  make_heap_allocator() returns an
// Allocator backed by libc malloc / realloc / free.
//
// Generic routines (alloc, realloc, free, zero, copy) form the prelude memory
// surface used by every collection.  User-facing sizes are U64; C-alias sizes
// (CSize, CInt) appear only at the FFI boundary and immediately convert.

module Standard::Alloc

// ============================================================
// FFI integer conversions (U64 ↔ CSize)
//
// Picked per target. On a 64-bit target CSize is U64, so both directions are
// the identity. On a 32-bit target CSize is U32: U64 → CSize panics on a size
// that doesn't fit, and CSize → U64 widens.
// ============================================================

@target(size: 64)
routine u64_to_csize(%n: U64) -> CSize
    block entry():
        return(%n)

@target(size: 32)
routine u64_to_csize(%n: U64) -> CSize
    block entry():
        %r : CSize = %n.to_u32()
        return(%r)

@target(size: 64)
routine csize_to_u64(%n: CSize) -> U64
    block entry():
        return(%n)

@target(size: 32)
routine csize_to_u64(%n: CSize) -> U64
    block entry():
        %r : U64 = %n.to_u64()
        return(%r)

// ============================================================
// C FFI: libc memory
// ============================================================

@[external("c"), symbol("malloc")]
private routine c_malloc(%size: CSize) -> Addr

@[external("c"), symbol("realloc")]
private routine c_realloc(%ptr: Addr, %size: CSize) -> Addr

@[external("c"), symbol("free")]
private routine c_free(%ptr: Addr) -> Void

@[external("c"), symbol("memcpy")]
private routine c_memcpy(%dst: Addr, %src: Addr, %size: CSize) -> Void

// ============================================================
// Allocator record
//
// Callbacks use C calling convention and C-alias sizes — they are FFI types.
// ============================================================

record Allocator
    alloc_fn   : Callable<(Addr, CSize), Addr>
    realloc_fn : Callable<(Addr, Addr, CSize), Addr>
    free_fn    : Callable<(Addr, Addr), Void>
    state      : Addr

// ============================================================
// Heap allocator backend (libc wrappers matching Allocator callbacks)
// ============================================================

private routine heap_alloc_fn(%state: Addr, %size: CSize) -> Addr
    block entry():
        %result : Addr = c_malloc(%size)
        return(%result)

private routine heap_realloc_fn(%state: Addr, %old_ptr: Addr, %size: CSize) -> Addr
    block entry():
        %result : Addr = c_realloc(%old_ptr, %size)
        return(%result)

private routine heap_free_fn(%state: Addr, %ptr: Addr) -> Void
    block entry():
        c_free(%ptr)
        return()

// ============================================================
// Allocator factory
// ============================================================

routine make_heap_allocator() -> Allocator
    block entry():
        %alloc : Allocator = Allocator { alloc_fn:   heap_alloc_fn, realloc_fn: heap_realloc_fn,
                free_fn:    heap_free_fn, state:      null }
        return(%alloc)

// ============================================================
// Generic memory routines (prelude surface)
//
// User-facing sizes are U64.  Conversion to CSize happens exactly at the
// allocator-callback boundary.
// ============================================================

routine allocate<T>(%alloc: Ptr<Allocator>, %count: U64) -> Ptr<T>
require T: typename
    block entry():
        %elem_size : U64                           = sizeof<T>()
        %size      : U64                           = %elem_size.mul(%count)
        %size_c    : CSize                         = u64_to_csize(%size)
        %alloc_fn  : Callable<(Addr, CSize), Addr> = %alloc.alloc_fn.load()
        %state     : Addr                          = %alloc.state.load()
        %raw       : Addr                          = %alloc_fn.call(%state, %size_c)
        %typed     : Ptr<T>                        = bitcast<Addr, Ptr<T>>(%raw)
        return(%typed)

routine reallocate<T>(%alloc: Ptr<Allocator>, %ptr: Ptr<T>, %new_count: U64) -> Ptr<T>
require T: typename
    block entry():
        %elem_size  : U64                                 = sizeof<T>()
        %size       : U64                                 = %elem_size.mul(%new_count)
        %size_c     : CSize                               = u64_to_csize(%size)
        %raw_old    : Addr                                = bitcast<Ptr<T>, Addr>(%ptr)
        %realloc_fn : Callable<(Addr, Addr, CSize), Addr> = %alloc.realloc_fn.load()
        %state      : Addr                                = %alloc.state.load()
        %raw        : Addr                                = %realloc_fn.call(%state, %raw_old,
                %size_c)
        %typed      : Ptr<T>                              = bitcast<Addr, Ptr<T>>(%raw)
        return(%typed)

routine copy<T>(%dst: Ptr<T>, %src: Ptr<T>, %count: U64) -> Void
require T: typename
    block entry():
        %elem_size : U64   = sizeof<T>()
        %size      : U64   = %elem_size.mul(%count)
        %size_c    : CSize = u64_to_csize(%size)
        %raw_dst   : Addr  = bitcast<Ptr<T>, Addr>(%dst)
        %raw_src   : Addr  = bitcast<Ptr<T>, Addr>(%src)
        c_memcpy(%raw_dst, %raw_src, %size_c)
        return()

// ============================================================
// C strings (types/CStr.tess)
// ============================================================

/// Copies %self into memory from %alloc and ends it with a NUL. Free it with
/// %c.to_ptr().free(%alloc).
routine String.to_cstr(%self: Self, %alloc: Ptr<Allocator>) -> CStr
    block entry():
        %length : U64       = %self.length
        %buffer : Ptr<Byte> = allocate<Byte>(%alloc, %length.add(1))
        %failed : Bool      = %buffer.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : continue
        copy<Byte>(%buffer, %self.data, %length)
        %buffer[%length].store(0x00)
        return(.from_ptr(%buffer))

/// Converts %self to wide characters in memory from %alloc, ending with a 0:
/// UTF-16 on Windows, UTF-32 elsewhere. Free it with %w.to_ptr().free(%alloc).
/// A UTF-8 byte count bounds both unit counts, so one allocation is enough.
routine String.to_cwstr(%self: Self, %alloc: Ptr<Allocator>) -> CWStr
    block entry():
        %units  : Ptr<CWChar> = allocate<CWChar>(%alloc, %self.length.add(1))
        %failed : Bool        = %units.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : continue
        claim %text : Ptr<Self>
        %text.store(%self)
        %iter_val : StringCharsIter = %text.chars()
        claim %iter : Ptr<StringCharsIter>
        %iter.store(%iter_val)
        jump next(%iter, %units, 0)

    block next(%iter: Ptr<StringCharsIter>, %units: Ptr<CWChar>, %n: U64):
        %c : Option<Char> = %iter.next()
        when %c:
            .Present(%char) -> put(%iter, %units, %n, %char)
            .Absent         -> finish(%units, %n)

    block put(%iter: Ptr<StringCharsIter>, %units: Ptr<CWChar>, %n: U64, %char: Char):
        %count : U64 = encode_cwchar(%char, %units[%n])
        jump next(%iter, %units, %n.add(%count))

    block finish(%units: Ptr<CWChar>, %n: U64):
        %units[%n].store(0)
        return(.from_ptr(%units))

/// Writes %char at %out as UTF-16, one unit or a surrogate pair, and returns
/// how many units it wrote.
@target(os: "windows")
private routine encode_cwchar(%char: Char, %out: Ptr<CWChar>) -> U64
    block entry():
        %cp  : U32  = %char.to_u32()
        %bmp : Bool = %cp.lt(0x10000)
        branch %bmp ? single(%cp) : pair(%cp)

    block single(%cp: U32):
        %out.store(%cp.to_u16())
        return(1)

    block pair(%cp: U32):
        %v : U32 = %cp.sub(0x10000)
        %out.store(%v.shr(10).add(0xD800).to_u16())
        %out[1].store(%v.bitand(0x3FF).add(0xDC00).to_u16())
        return(2)

/// Writes %char at %out as one UTF-32 unit.
@target(os: !"windows")
private routine encode_cwchar(%char: Char, %out: Ptr<CWChar>) -> U64
    block entry():
        %out.store(%char.to_u32().to_s32())
        return(1)
