; Tessera stdlib: Allocator pattern and memory routines
;
; The Allocator struct is a manual vtable: callers pass Ptr<Allocator> to any
; routine that performs heap allocation.  make_heap_allocator() returns an
; Allocator backed by libc malloc / realloc / free.
;
; Generic routines (alloc, realloc, free, zero, copy) form the prelude memory
; surface used by every collection.  User-facing sizes are I64; C-alias sizes
; (CSize, CInt) appear only at the FFI boundary and immediately convert.

; ============================================================
; FFI integer conversions (I64 ↔ CSize)
;
; Picked per target.  On a 64-bit target CSize is I64, so the conversion is a
; no-op bitcast.  On a 32-bit target CSize is I32, so the I64→CSize direction
; is a truncation and the CSize→I64 direction is a zero-extension (size_t is
; semantically unsigned).
; ============================================================

@target(size: 64)
routine i64_to_csize(%n: I64) -> CSize
    block entry():
        %r: CSize = bitcast<I64, CSize>(%n)
        return(%r)

@target(size: 32)
routine i64_to_csize(%n: I64) -> CSize
    block entry():
        %r: CSize = trunc<I64, CSize>(%n)
        return(%r)

@target(size: 64)
routine csize_to_i64(%n: CSize) -> I64
    block entry():
        %r: I64 = bitcast<CSize, I64>(%n)
        return(%r)

@target(size: 32)
routine csize_to_i64(%n: CSize) -> I64
    block entry():
        %r: I64 = zext<CSize, I64>(%n)
        return(%r)

; ============================================================
; C FFI: libc memory
; ============================================================

@[external("c"), symbol("malloc")]
routine c_malloc(%size: CSize) -> Ptr

@[external("c"), symbol("realloc")]
routine c_realloc(#Ptr: Ptr, %size: CSize) -> Ptr

@[external("c"), symbol("free")]
routine c_free(#Ptr: Ptr) -> Void

@[external("c"), symbol("memcpy")]
routine c_memcpy(#dst: Ptr, #src: Ptr, %size: CSize) -> Void

@[external("c"), symbol("memset")]
routine c_memset(#Ptr: Ptr, %value: CInt, %size: CSize) -> Void

; ============================================================
; Allocator struct
;
; Callbacks use C calling convention and C-alias sizes — they are FFI types.
; ============================================================

struct Allocator
    alloc_fn:   Callable<@callconv("c"), (Ptr, CSize), Ptr>
    realloc_fn: Callable<@callconv("c"), (Ptr, Ptr, CSize), Ptr>
    free_fn:    Callable<@callconv("c"), (Ptr, Ptr), Void>
    state: Ptr

; ============================================================
; Heap allocator backend (libc wrappers matching Allocator callbacks)
; ============================================================

@callconv("c")
routine heap_alloc_fn(#state: Ptr, %size: CSize) -> Ptr
    block entry():
        #result: Ptr = c_malloc(%size)
        return(#result)

@callconv("c")
routine heap_realloc_fn(#state: Ptr, #old_Ptr: Ptr, %size: CSize) -> Ptr
    block entry():
        #result: Ptr = c_realloc(#old_Ptr, %size)
        return(#result)

@callconv("c")
routine heap_free_fn(#state: Ptr, #Ptr: Ptr) -> Void
    block entry():
        c_free(#Ptr)
        return()

; ============================================================
; Allocator factory
; ============================================================

routine make_heap_allocator() -> Allocator
    block entry():
        %alloc: Allocator = Allocator {
            alloc_fn:   heap_alloc_fn,
            realloc_fn: heap_realloc_fn,
            free_fn:    heap_free_fn,
            state:      null
        }
        return(%alloc)

; ============================================================
; Generic memory routines (prelude surface)
;
; User-facing API stays in I64.  Conversion to CSize happens exactly at the
; allocator-callback boundary.
; ============================================================

routine alloc<T>(#alloc: Ptr<Allocator>, %count: I64) -> Ptr<T>
require T: typename
    block entry():
        %elem_size: I64 = sizeof<T>()
        %size:   I64    = %elem_size.mul(%count)
        %size_c: CSize  = i64_to_csize(%size)
        #raw:    Ptr    = #alloc.alloc_fn(#alloc.state, %size_c)
        #typed:  Ptr<T> = bitcast<Ptr, Ptr<T>>(#raw)
        return(#typed)

routine realloc<T>(#alloc: Ptr<Allocator>, #Ptr: Ptr<T>, %new_count: I64) -> Ptr<T>
require T: typename
    block entry():
        %elem_size: I64  = sizeof<T>()
        %size:    I64    = %elem_size.mul(%new_count)
        %size_c:  CSize  = i64_to_csize(%size)
        #raw_old: Ptr    = bitcast<Ptr<T>, Ptr>(#Ptr)
        #raw:     Ptr    = #alloc.realloc_fn(#alloc.state, #raw_old, %size_c)
        #typed:   Ptr<T> = bitcast<Ptr, Ptr<T>>(#raw)
        return(#typed)

routine free<T>(#alloc: Ptr<Allocator>, #Ptr: Ptr<T>) -> Void
require T: typename
    block entry():
        #raw: Ptr = bitcast<Ptr<T>, Ptr>(#Ptr)
        #alloc.free_fn(#alloc.state, #raw)
        return()

routine zero<T>(#Ptr: Ptr<T>, %count: I64) -> Void
require T: typename
    block entry():
        %elem_size: I64 = sizeof<T>()
        %size:   I64   = %elem_size.mul(%count)
        %size_c: CSize = i64_to_csize(%size)
        #raw:    Ptr   = bitcast<Ptr<T>, Ptr>(#Ptr)
        c_memset(#raw, 0, %size_c)
        return()

routine copy<T>(#dst: Ptr<T>, #src: Ptr<T>, %count: I64) -> Void
require T: typename
    block entry():
        %elem_size: I64 = sizeof<T>()
        %size:    I64   = %elem_size.mul(%count)
        %size_c:  CSize = i64_to_csize(%size)
        #raw_dst: Ptr   = bitcast<Ptr<T>, Ptr>(#dst)
        #raw_src: Ptr   = bitcast<Ptr<T>, Ptr>(#src)
        c_memcpy(#raw_dst, #raw_src, %size_c)
        return()
