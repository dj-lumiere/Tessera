// Tessera stdlib: BigNat, fixed-capacity big naturals
//
// Exact arithmetic for float parsing and printing (float_parse.tess,
// format.tess). Limbs are U64, least significant first; no heap. N is the
// capacity in limbs, so each use sizes its own: F64 parsing needs 72, F128
// printing 320, F128 parsing 864.

module Standard::Format

preset POW10_U64: Array<U64, 20> = [
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000,
    1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000,
    10000000000000000000
]

/// A natural number in U64 limbs, least significant first. `length` limbs are
/// in use and the top one is nonzero (zero has length 0). Fixed capacity:
/// growing past N limbs panics with Overflow.
record BigNat<N>
require N: U64
    limbs:  Array<U64, N>
    length: U64

routine BigNat<N>.set(#self: Ptr<Self>, %value: U64) -> Void
require N: U64
    block entry():
        #self.limbs[0].store(%value)
        #self.length.store(%value.ne(0).to_u64())
        return()

routine BigNat<N>.set_u128(#self: Ptr<Self>, %value: U128) -> Void
require N: U64
    block entry():
        %low:  U64 = %value.to_u64_wrap()
        %high: U64 = %value.shr(64).to_u64()
        #self.limbs[0].store(%low)
        #self.limbs[1].store(%high)
        %two:  Bool = %high.ne(0)
        %one:  Bool = %low.ne(0)
        %used: U64  = %two ? 2 : %one.to_u64()
        #self.length.store(%used)
        return()

routine BigNat<N>.copy_from(#self: Ptr<Self>, #other: Ptr<Self>) -> Void
require N: U64
    block entry():
        %value: Self = #other.load()
        #self.store(%value)
        return()

routine BigNat<N>.is_zero(#self: Ptr<Self>) -> Bool
require N: U64
    block entry():
        %length: U64  = #self.length.load()
        %zero:   Bool = %length.eq(0)
        return(%zero)

routine BigNat<N>.bit_length(#self: Ptr<Self>) -> U64
require N: U64
    block entry():
        %length: U64  = #self.length.load()
        %zero:   Bool = %length.eq(0)
        branch %zero ? return(0) : count(%length)

    block count(%length: U64):
        %top_at: U64  = %length.sub(1)
        %top:    U64  = #self.limbs[%top_at].load()
        %bits:   U64  = %top_at.mul(64).add(64).sub(%top.leading_zeros())
        return(%bits)

/// Appends %limb as the new top limb.
routine BigNat<N>.push_limb(#self: Ptr<Self>, %limb: U64) -> Void
require N: U64
    block entry():
        %length: U64  = #self.length.load()
        %room:   Bool = %length.lt(N)
        branch %room ? store(%length) : panic(TrapCode.Overflow)

    block store(%length: U64):
        #self.limbs[%length].store(%limb)
        #self.length.store(%length.add(1))
        return()

/// Drops zero limbs from the top.
routine BigNat<N>.trim(#self: Ptr<Self>) -> Void
require N: U64
    block entry():
        %length: U64 = #self.length.load()
        jump check(%length)

    block check(%length: U64):
        %empty: Bool = %length.eq(0)
        branch %empty ? store(%length) : look(%length)

    block look(%length: U64):
        %at:   U64  = %length.sub(1)
        %top:  U64  = #self.limbs[%at].load()
        %zero: Bool = %top.eq(0)
        branch %zero ? check(%at) : store(%length)

    block store(%length: U64):
        #self.length.store(%length)
        return()

/// self = self × m + add
routine BigNat<N>.mul_add(#self: Ptr<Self>, %m: U64, %add: U64) -> Void
require N: U64
    block entry():
        %length: U64 = #self.length.load()
        jump loop(0, %add.to_u128(), %length)

    block loop(%i: U64, %carry: U128, %length: U64):
        %done: Bool = %i.ge(%length)
        branch %done ? spill(%carry) : step(%i, %carry, %length)

    // limb × m + carry < 2^128, so the sum can't overflow
    block step(%i: U64, %carry: U128, %length: U64):
        %limb:    U64  = #self.limbs[%i].load()
        %product: U128 = %limb.mul_wide(%m).add(%carry)
        #self.limbs[%i].store(%product.to_u64_wrap())
        jump loop(%i.add(1), %product.shr(64), %length)

    block spill(%carry: U128):
        %high: U64  = %carry.to_u64()
        %none: Bool = %high.eq(0)
        branch %none ? return() : grow(%high)

    block grow(%high: U64):
        #self.push_limb(%high)
        return()

/// self = self × 10^k
routine BigNat<N>.mul_pow10(#self: Ptr<Self>, %k: U64) -> Void
require N: U64
    block entry():
        jump loop(%k)

    block loop(%left: U64):
        %big_step: Bool = %left.ge(19)
        branch %big_step ? chunk(%left) : last(%left)

    block chunk(%left: U64):
        #self.mul_add(10000000000000000000, 0)      // 10^19
        jump loop(%left.sub(19))

    block last(%left: U64):
        %factor: U64 = POW10_U64[%left].load()
        #self.mul_add(%factor, 0)
        return()

/// self = self × 2^bits
routine BigNat<N>.shl(#self: Ptr<Self>, %bits: U64) -> Void
require N: U64
    block entry():
        %limb_shift: U64  = %bits.div(64)
        %bit_shift:  U64  = %bits.rem(64)
        %length:     U64  = #self.length.load()
        %whole:      Bool = %bit_shift.eq(0)
        branch %whole ? move(%limb_shift) : shift_bits(0, 0, %length, %limb_shift, %bit_shift)

    block shift_bits(%i: U64, %carry: U64, %length: U64, %limb_shift: U64, %bit_shift: U64):
        %done: Bool = %i.ge(%length)
        branch %done ? spill(%carry, %limb_shift) : shift_one(%i, %carry, %length, %limb_shift, %bit_shift)

    block shift_one(%i: U64, %carry: U64, %length: U64, %limb_shift: U64, %bit_shift: U64):
        %limb: U64 = #self.limbs[%i].load()
        #self.limbs[%i].store(%limb.shl(%bit_shift).bitor(%carry))
        %out: U64 = %limb.shr(64.sub(%bit_shift))
        jump shift_bits(%i.add(1), %out, %length, %limb_shift, %bit_shift)

    block spill(%carry: U64, %limb_shift: U64):
        %none: Bool = %carry.eq(0)
        branch %none ? move(%limb_shift) : grow(%carry, %limb_shift)

    block grow(%carry: U64, %limb_shift: U64):
        #self.push_limb(%carry)
        jump move(%limb_shift)

    // Whole limbs move up by %limb_shift, top first, and zeros fill the bottom.
    block move(%limb_shift: U64):
        %length:     U64  = #self.length.load()
        %nothing:    Bool = %limb_shift.eq(0).bitor(%length.eq(0))
        %new_length: U64  = %length.add(%limb_shift)
        %room:       Bool = %new_length.le(N)
        select:
            %nothing -> return()
            %room -> move_loop(%length, %limb_shift, %new_length)
            _ -> panic(TrapCode.Overflow)

    // %left limbs are still to move; the next one down is %left - 1
    block move_loop(%left: U64, %limb_shift: U64, %new_length: U64):
        %done: Bool = %left.eq(0)
        branch %done ? zero_fill(0, %limb_shift, %new_length) : move_one(%left.sub(1), %limb_shift, %new_length)

    block move_one(%i: U64, %limb_shift: U64, %new_length: U64):
        %limb: U64 = #self.limbs[%i].load()
        #self.limbs[%i.add(%limb_shift)].store(%limb)
        jump move_loop(%i, %limb_shift, %new_length)

    block zero_fill(%i: U64, %limb_shift: U64, %new_length: U64):
        %done: Bool = %i.ge(%limb_shift)
        branch %done ? finish(%new_length) : zero_one(%i, %limb_shift, %new_length)

    block zero_one(%i: U64, %limb_shift: U64, %new_length: U64):
        #self.limbs[%i].store(0)
        jump zero_fill(%i.add(1), %limb_shift, %new_length)

    block finish(%new_length: U64):
        #self.length.store(%new_length)
        return()

/// self = self / 2, rounding down
routine BigNat<N>.shr1(#self: Ptr<Self>) -> Void
require N: U64
    block entry():
        %length: U64 = #self.length.load()
        jump loop(%length, 0)

    // %left limbs are still to shift, top first
    block loop(%left: U64, %carry: U64):
        %done: Bool = %left.eq(0)
        branch %done ? finish() : step(%left.sub(1), %carry)

    block step(%i: U64, %carry: U64):
        %limb: U64 = #self.limbs[%i].load()
        #self.limbs[%i].store(%limb.shr(1).bitor(%carry.shl(63)))
        jump loop(%i, %limb.bitand(1))

    block finish():
        #self.trim()
        return()

/// -1, 0, or 1 as self is below, equal to, or above other
routine BigNat<N>.compare(#self: Ptr<Self>, #other: Ptr<Self>) -> S32
require N: U64
    block entry():
        %a_length: U64 = #self.length.load()
        %b_length: U64  = #other.length.load()
        %shorter:  Bool = %a_length.lt(%b_length)
        %longer:   Bool = %a_length.gt(%b_length)
        select:
            %shorter -> return(-1)
            %longer -> return(1)
            _ -> loop(%a_length)

    // %left limbs are still to compare, top first
    block loop(%left: U64):
        %done: Bool = %left.eq(0)
        branch %done ? return(0) : step(%left.sub(1))

    block step(%i: U64):
        %a: U64 = #self.limbs[%i].load()
        %b: U64 = #other.limbs[%i].load()
        %below: Bool = %a.lt(%b)
        %above: Bool = %a.gt(%b)
        select:
            %below -> return(-1)
            %above -> return(1)
            _ -> loop(%i)

/// self = self - other, which must not be larger
routine BigNat<N>.sub(#self: Ptr<Self>, #other: Ptr<Self>) -> Void
require N: U64
    block entry():
        %a_length: U64 = #self.length.load()
        %b_length: U64 = #other.length.load()
        jump loop(0, 0, %a_length, %b_length)

    block loop(%i: U64, %borrow: U64, %a_length: U64, %b_length: U64):
        %done: Bool = %i.ge(%a_length)
        branch %done ? finish() : step(%i, %borrow, %a_length, %b_length)

    block step(%i: U64, %borrow: U64, %a_length: U64, %b_length: U64):
        %a:        U64  = #self.limbs[%i].load()
        %b_limb:   U64  = #other.limbs[%i].load()
        %in_b:     Bool = %i.lt(%b_length)
        %b:        U64  = %in_b ? %b_limb : 0
        #self.limbs[%i].store(%a.sub_wrap(%b).sub_wrap(%borrow))
        // a - b - borrow goes negative when a < b, or a == b with a borrow in
        %under:    Bool = %a.lt(%b)
        %even_out: Bool = %a.eq(%b).bitand(%borrow.eq(1))
        %next:     U64  = %under.bitor(%even_out).to_u64()
        jump loop(%i.add(1), %next, %a_length, %b_length)

    block finish():
        #self.trim()
        return()

/// For a quotient below 2^%bits (at most 127): returns floor(rem / divisor) and leaves the
/// remainder in #rem. #scratch holds the shifted divisor.
routine BigNat<N>.div_small(#rem: Ptr<Self>, #divisor: Ptr<Self>, #scratch: Ptr<Self>, %bits: U64) -> U128
require N: U64
    block entry():
        #scratch.copy_from(#divisor)
        #scratch.shl(%bits.sub(1))
        jump loop(%bits, 0)

    // %left quotient bits are still to find, top first
    block loop(%left: U64, %q: U128):
        %done: Bool = %left.eq(0)
        branch %done ? return(%q) : try_bit(%left.sub(1), %q)

    block try_bit(%i: U64, %q: U128):
        %fits: Bool = #rem.compare(#scratch).ge(0)
        branch %fits ? take(%i, %q) : next(%i, %q)

    block take(%i: U64, %q: U128):
        #rem.sub(#scratch)
        jump next(%i, %q.bitor(1.shl(%i.to_u128())))

    block next(%i: U64, %q: U128):
        #scratch.shr1()
        jump loop(%i, %q)

/// self = self + other
routine BigNat<N>.add(#self: Ptr<Self>, #other: Ptr<Self>) -> Void
require N: U64
    block entry():
        %a_length: U64 = #self.length.load()
        %b_length: U64  = #other.length.load()
        %length:   U64  = %a_length.max(%b_length)
        jump loop(0, 0, %a_length, %b_length, %length)

    block loop(%i: U64, %carry: U64, %a_length: U64, %b_length: U64, %length: U64):
        %done: Bool = %i.ge(%length)
        branch %done ? finish(%carry, %length) : step(%i, %carry, %a_length, %b_length, %length)

    block step(%i: U64, %carry: U64, %a_length: U64, %b_length: U64, %length: U64):
        %a_limb: U64  = #self.limbs[%i].load()
        %b_limb: U64  = #other.limbs[%i].load()
        %a:      U64  = %i.lt(%a_length) ? %a_limb : 0
        %b:      U64  = %i.lt(%b_length) ? %b_limb : 0
        %sum:    U128 = %a.to_u128().add(%b.to_u128()).add(%carry.to_u128())
        #self.limbs[%i].store(%sum.to_u64_wrap())
        jump loop(%i.add(1), %sum.shr(64).to_u64(), %a_length, %b_length, %length)

    block finish(%carry: U64, %length: U64):
        #self.length.store(%length)
        %none: Bool = %carry.eq(0)
        branch %none ? return() : grow(%carry)

    block grow(%carry: U64):
        #self.push_limb(%carry)
        return()

/// self = floor(self / d), with d > 0; returns the remainder
routine BigNat<N>.div_limb(#self: Ptr<Self>, %d: U64) -> U64
require N: U64
    block entry():
        %length:  U64  = #self.length.load()
        %divisor: U128 = %d.to_u128()
        jump loop(%length, 0, %divisor)

    // %left limbs are still to divide, top first
    block loop(%left: U64, %rem: U128, %divisor: U128):
        %done: Bool = %left.eq(0)
        branch %done ? finish(%rem) : step(%left.sub(1), %rem, %divisor)

    block step(%i: U64, %rem: U128, %divisor: U128):
        %limb: U64  = #self.limbs[%i].load()
        %cur:  U128 = %rem.shl(64).bitor(%limb.to_u128())
        #self.limbs[%i].store(%cur.div(%divisor).to_u64())
        jump loop(%i, %cur.rem(%divisor), %divisor)

    block finish(%rem: U128):
        #self.trim()
        return(%rem.to_u64())

/// Bit %i of self (0 is the lowest).
routine BigNat<N>.bit(#self: Ptr<Self>, %i: U64) -> Bool
require N: U64
    block entry():
        %length: U64  = #self.length.load()
        %at:     U64  = %i.div(64)
        %inside: Bool = %at.lt(%length)
        branch %inside ? read(%at) : return(false)

    block read(%at: U64):
        %limb: U64  = #self.limbs[%at].load()
        %set:  Bool = %limb.shr(%i.rem(64)).bitand(1).eq(1)
        return(%set)

/// Whether any bit below bit %n is set.
routine BigNat<N>.any_below(#self: Ptr<Self>, %n: U64) -> Bool
require N: U64
    block entry():
        %length: U64 = #self.length.load()
        %whole:  U64 = %n.div(64).min(%length)
        jump loop(0, %whole, %length)

    block loop(%i: U64, %whole: U64, %length: U64):
        %done: Bool = %i.ge(%whole)
        branch %done ? partial(%whole, %length) : step(%i, %whole, %length)

    block step(%i: U64, %whole: U64, %length: U64):
        %limb: U64  = #self.limbs[%i].load()
        %set:  Bool = %limb.ne(0)
        branch %set ? return(true) : loop(%i.add(1), %whole, %length)

    block partial(%whole: U64, %length: U64):
        %inside: Bool = %whole.lt(%length)
        branch %inside ? mask(%whole) : return(false)

    block mask(%at: U64):
        %limb: U64  = #self.limbs[%at].load()
        %low:  U64  = 1.shl(%n.rem(64)).sub(1)
        %set:  Bool = %limb.bitand(%low).ne(0)
        return(%set)

/// self = self / 2^bits (bits > 0), rounded to nearest, ties to even
routine BigNat<N>.shr_round_even(#self: Ptr<Self>, %bits: U64) -> Void
require N: U64
    block entry():
        %half_at:    U64  = %bits.sub(1)
        %half:       Bool = #self.bit(%half_at)
        %sticky:     Bool = #self.any_below(%half_at)
        %limb_shift: U64  = %bits.div(64)
        %bit_shift:  U64  = %bits.rem(64)
        %length:     U64  = #self.length.load()
        %kept:       U64  = %length.sub_clamp(%limb_shift)
        jump loop(0, %kept, %length, %limb_shift, %bit_shift, %half, %sticky)

    // limb i takes the bits of limbs i + shift and i + shift + 1
    block loop(%i: U64, %kept: U64, %length: U64, %limb_shift: U64, %bit_shift: U64, %half: Bool, %sticky: Bool):
        %done: Bool = %i.ge(%kept)
        branch %done ? shifted(%kept, %half, %sticky) : step(%i, %kept, %length, %limb_shift, %bit_shift, %half, %sticky)

    block step(%i: U64, %kept: U64, %length: U64, %limb_shift: U64, %bit_shift: U64, %half: Bool, %sticky: Bool):
        %from:      U64  = %i.add(%limb_shift)
        %low:       U64  = #self.limbs[%from].load()
        %next_at:   U64  = %from.add(1)
        %has_next:  Bool = %next_at.lt(%length)
        %next_limb: U64  = #self.limbs[%next_at.min(%length.sub(1))].load()
        %next:      U64  = %has_next ? %next_limb : 0
        // two shifts, so a zero bit shift never shifts by 64
        %high:      U64  = %next.shl(63.sub(%bit_shift)).shl(1)
        #self.limbs[%i].store(%low.shr(%bit_shift).bitor(%high))
        jump loop(%i.add(1), %kept, %length, %limb_shift, %bit_shift, %half, %sticky)

    block shifted(%kept: U64, %half: Bool, %sticky: Bool):
        #self.length.store(%kept)
        #self.trim()
        %odd:   Bool = #self.bit(0)
        %round: Bool = %half.bitand(%sticky.bitor(%odd))
        branch %round ? bump() : return()

    block bump():
        #self.mul_add(1, 1)
        return()
