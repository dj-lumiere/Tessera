; Tessera stdlib: BigNat, fixed-capacity big naturals
;
; Exact arithmetic for float parsing and printing (float_parse.tess,
; format.tess). Limbs are 64-bit and unsigned, least significant first; no heap.
; N is the capacity in limbs, so each use sizes its own: F64 parsing needs 72,
; F128 printing 320, F128 parsing 864.

const POW10_I64: Array<I64, 19> = [
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000,
    1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000
]

; A natural number in 64-bit limbs, least significant first, read as unsigned.
; `length` limbs are in use and the top one is nonzero (zero has length 0).
; Fixed capacity: growing past N limbs panics with Overflow.
record BigNat<N>
require N: I64
    limbs:  Array<I64, N>
    length: I64

routine BigNat<N>.set(#self: Ptr<Self>, %value: I64) -> Void
require N: I64
    block entry():
        #self.limbs[0] = %value
        #self.length = %value.ne(0).to_i64()
        return()

routine BigNat<N>.copy_from(#self: Ptr<Self>, #other: Ptr<Self>) -> Void
require N: I64
    block entry():
        %value: Self := #other
        #self = %value
        return()

routine BigNat<N>.is_zero(#self: Ptr<Self>) -> Bool
require N: I64
    block entry():
        %length: I64  := #self.length
        %zero:   Bool = %length.eq(0)
        return(%zero)

routine BigNat<N>.bit_length(#self: Ptr<Self>) -> I64
require N: I64
    block entry():
        %length: I64  := #self.length
        %zero:   Bool = %length.eq(0)
        branch %zero ? return(0) : count(%length)

    block count(%length: I64):
        %top_at: I64 = %length.sub(1)
        %top:    I64 := #self.limbs[%top_at]
        %bits:   I64 = %top_at.mul(64).add(64).sub(%top.leading_zeros())
        return(%bits)

; Appends %limb as the new top limb.
routine BigNat<N>.push_limb(#self: Ptr<Self>, %limb: I64) -> Void
require N: I64
    block entry():
        %length: I64  := #self.length
        %room:   Bool = %length.slt(N)
        branch %room ? store(%length) : panic(TrapCode.Overflow)

    block store(%length: I64):
        #self.limbs[%length] = %limb
        #self.length = %length.add(1)
        return()

; Drops zero limbs from the top.
routine BigNat<N>.trim(#self: Ptr<Self>) -> Void
require N: I64
    block entry():
        %length: I64 := #self.length
        jump check(%length)

    block check(%length: I64):
        %empty: Bool = %length.eq(0)
        branch %empty ? store(%length) : look(%length)

    block look(%length: I64):
        %at:     I64  = %length.sub(1)
        %top:    I64  := #self.limbs[%at]
        %zero:   Bool = %top.eq(0)
        branch %zero ? check(%at) : store(%length)

    block store(%length: I64):
        #self.length = %length
        return()

; self = self × m + add, with m and add read as unsigned
routine BigNat<N>.mul_add(#self: Ptr<Self>, %m: I64, %add: I64) -> Void
require N: I64
    block entry():
        %length: I64 := #self.length
        jump loop(0, %add.to_u128(), %length)

    block loop(%i: I64, %carry: I128, %length: I64):
        %done: Bool = %i.sge(%length)
        branch %done ? spill(%carry) : step(%i, %carry, %length)

    block step(%i: I64, %carry: I128, %length: I64):
        %limb:    I64  := #self.limbs[%i]
        %product: I128 = %limb.to_u128().mul(%m.to_u128()).add(%carry)
        #self.limbs[%i] = %product.to_i64()
        jump loop(%i.add(1), %product.lshr(64), %length)

    block spill(%carry: I128):
        %high: I64  = %carry.to_i64()
        %none: Bool = %high.eq(0)
        branch %none ? return() : grow(%high)

    block grow(%high: I64):
        #self.push_limb(%high)
        return()

; self = self × 10^k
routine BigNat<N>.mul_pow10(#self: Ptr<Self>, %k: I64) -> Void
require N: I64
    block entry():
        jump loop(%k)

    block loop(%left: I64):
        %big_step: Bool = %left.sge(19)
        branch %big_step ? chunk(%left) : last(%left)

    block chunk(%left: I64):
        #self.mul_add(-8446744073709551616, 0)      ; 10^19, as an unsigned bit pattern
        jump loop(%left.sub(19))

    block last(%left: I64):
        %factor: I64 := POW10_I64[%left]
        #self.mul_add(%factor, 0)
        return()

; self = self × 2^bits
routine BigNat<N>.shl(#self: Ptr<Self>, %bits: I64) -> Void
require N: I64
    block entry():
        %limb_shift: I64  = %bits.sdiv(64)
        %bit_shift:  I64  = %bits.srem(64)
        %length:     I64  := #self.length
        %whole:      Bool = %bit_shift.eq(0)
        branch %whole ? move(%limb_shift) : shift_bits(0, 0, %length, %limb_shift, %bit_shift)

    block shift_bits(%i: I64, %carry: I64, %length: I64, %limb_shift: I64, %bit_shift: I64):
        %done: Bool = %i.sge(%length)
        branch %done ? spill(%carry, %limb_shift) : shift_one(%i, %carry, %length, %limb_shift, %bit_shift)

    block shift_one(%i: I64, %carry: I64, %length: I64, %limb_shift: I64, %bit_shift: I64):
        %limb: I64 := #self.limbs[%i]
        #self.limbs[%i] = %limb.shl(%bit_shift).bitor(%carry)
        %out: I64 = %limb.lshr(64.sub(%bit_shift))
        jump shift_bits(%i.add(1), %out, %length, %limb_shift, %bit_shift)

    block spill(%carry: I64, %limb_shift: I64):
        %none: Bool = %carry.eq(0)
        branch %none ? move(%limb_shift) : grow(%carry, %limb_shift)

    block grow(%carry: I64, %limb_shift: I64):
        #self.push_limb(%carry)
        jump move(%limb_shift)

    ; Whole limbs move up by %limb_shift, top first, and zeros fill the bottom.
    block move(%limb_shift: I64):
        %length:     I64  := #self.length
        %nothing:    Bool = %limb_shift.eq(0).bitor(%length.eq(0))
        %new_length: I64  = %length.add(%limb_shift)
        %room:       Bool = %new_length.sle(N)
        select:
            %nothing -> return()
            %room -> move_loop(%length.sub(1), %limb_shift, %new_length)
            _ -> panic(TrapCode.Overflow)

    block move_loop(%i: I64, %limb_shift: I64, %new_length: I64):
        %done: Bool = %i.slt(0)
        branch %done ? zero_fill(0, %limb_shift, %new_length) : move_one(%i, %limb_shift, %new_length)

    block move_one(%i: I64, %limb_shift: I64, %new_length: I64):
        %limb: I64 := #self.limbs[%i]
        %to:   I64 = %i.add(%limb_shift)
        #self.limbs[%to] = %limb
        jump move_loop(%i.sub(1), %limb_shift, %new_length)

    block zero_fill(%i: I64, %limb_shift: I64, %new_length: I64):
        %done: Bool = %i.sge(%limb_shift)
        branch %done ? finish(%new_length) : zero_one(%i, %limb_shift, %new_length)

    block zero_one(%i: I64, %limb_shift: I64, %new_length: I64):
        #self.limbs[%i] = 0
        jump zero_fill(%i.add(1), %limb_shift, %new_length)

    block finish(%new_length: I64):
        #self.length = %new_length
        return()

; self = self / 2, rounding down
routine BigNat<N>.shr1(#self: Ptr<Self>) -> Void
require N: I64
    block entry():
        %length: I64 := #self.length
        jump loop(%length.sub(1), 0)

    block loop(%i: I64, %carry: I64):
        %done: Bool = %i.slt(0)
        branch %done ? finish() : step(%i, %carry)

    block step(%i: I64, %carry: I64):
        %limb: I64 := #self.limbs[%i]
        #self.limbs[%i] = %limb.lshr(1).bitor(%carry.shl(63))
        jump loop(%i.sub(1), %limb.bitand(1))

    block finish():
        #self.trim()
        return()

; -1, 0, or 1 as self is below, equal to, or above other
routine BigNat<N>.compare(#self: Ptr<Self>, #other: Ptr<Self>) -> I32
require N: I64
    block entry():
        %a_length: I64 := #self.length
        %b_length: I64 := #other.length
        %shorter:  Bool = %a_length.slt(%b_length)
        %longer:   Bool = %a_length.sgt(%b_length)
        select:
            %shorter -> return(-1)
            %longer -> return(1)
            _ -> loop(%a_length.sub(1))

    block loop(%i: I64):
        %done: Bool = %i.slt(0)
        branch %done ? return(0) : step(%i)

    block step(%i: I64):
        %a: I64 := #self.limbs[%i]
        %b: I64 := #other.limbs[%i]
        %below: Bool = %a.ult(%b)
        %above: Bool = %a.ugt(%b)
        select:
            %below -> return(-1)
            %above -> return(1)
            _ -> loop(%i.sub(1))

; self = self - other, which must not be larger
routine BigNat<N>.sub(#self: Ptr<Self>, #other: Ptr<Self>) -> Void
require N: I64
    block entry():
        %a_length: I64 := #self.length
        %b_length: I64 := #other.length
        jump loop(0, 0, %a_length, %b_length)

    block loop(%i: I64, %borrow: I64, %a_length: I64, %b_length: I64):
        %done: Bool = %i.sge(%a_length)
        branch %done ? finish() : step(%i, %borrow, %a_length, %b_length)

    block step(%i: I64, %borrow: I64, %a_length: I64, %b_length: I64):
        %a:        I64  := #self.limbs[%i]
        %b_limb:   I64  := #other.limbs[%i]
        %in_b:     Bool = %i.slt(%b_length)
        %b:        I64  = %in_b ? %b_limb : 0
        #self.limbs[%i] = %a.sub(%b).sub(%borrow)
        ; a - b - borrow goes negative when a < b, or a == b with a borrow in
        %under:    Bool = %a.ult(%b)
        %even_out: Bool = %a.eq(%b).bitand(%borrow.eq(1))
        %next:     I64  = %under.bitor(%even_out).to_i64()
        jump loop(%i.add(1), %next, %a_length, %b_length)

    block finish():
        #self.trim()
        return()

; For a quotient below 2^%bits (at most 127): returns floor(rem / divisor) and leaves the
; remainder in #rem. #scratch holds the shifted divisor.
routine BigNat<N>.div_small(#rem: Ptr<Self>, #divisor: Ptr<Self>, #scratch: Ptr<Self>, %bits: I64) -> I128
require N: I64
    block entry():
        #scratch.copy_from(#divisor)
        %top: I64 = %bits.sub(1)
        #scratch.shl(%top)
        jump loop(%top, 0)

    block loop(%i: I64, %q: I128):
        %done: Bool = %i.slt(0)
        branch %done ? return(%q) : try_bit(%i, %q)

    block try_bit(%i: I64, %q: I128):
        %fits: Bool = #rem.compare(#scratch).sge(0)
        branch %fits ? take(%i, %q) : next(%i, %q)

    block take(%i: I64, %q: I128):
        #rem.sub(#scratch)
        jump next(%i, %q.bitor(1.shl(%i.to_i128())))

    block next(%i: I64, %q: I128):
        #scratch.shr1()
        jump loop(%i.sub(1), %q)


routine BigNat<N>.set_i128(#self: Ptr<Self>, %value: I128) -> Void
require N: I64
    block entry():
        %low:  I64 = %value.to_i64()
        %high: I64 = %value.lshr(64).to_i64()
        #self.limbs[0] = %low
        #self.limbs[1] = %high
        %two:  Bool = %high.ne(0)
        %one:  Bool = %low.ne(0)
        %used: I64  = %two ? 2 : %one.to_i64()
        #self.length = %used
        return()

; self = self + other
routine BigNat<N>.add(#self: Ptr<Self>, #other: Ptr<Self>) -> Void
require N: I64
    block entry():
        %a_length: I64 := #self.length
        %b_length: I64 := #other.length
        %length:   I64  = %a_length.max(%b_length)
        jump loop(0, 0, %a_length, %b_length, %length)

    block loop(%i: I64, %carry: I64, %a_length: I64, %b_length: I64, %length: I64):
        %done: Bool = %i.sge(%length)
        branch %done ? finish(%carry, %length) : step(%i, %carry, %a_length, %b_length, %length)

    block step(%i: I64, %carry: I64, %a_length: I64, %b_length: I64, %length: I64):
        %a_limb: I64  := #self.limbs[%i]
        %b_limb: I64  := #other.limbs[%i]
        %a:      I64  = %i.slt(%a_length) ? %a_limb : 0
        %b:      I64  = %i.slt(%b_length) ? %b_limb : 0
        %sum:    I128 = %a.to_u128().add(%b.to_u128()).add(%carry.to_u128())
        #self.limbs[%i] = %sum.to_i64()
        jump loop(%i.add(1), %sum.lshr(64).to_i64(), %a_length, %b_length, %length)

    block finish(%carry: I64, %length: I64):
        #self.length = %length
        %none: Bool = %carry.eq(0)
        branch %none ? return() : grow(%carry)

    block grow(%carry: I64):
        #self.push_limb(%carry)
        return()

; self = floor(self / d), with d > 0 read as unsigned; returns the remainder
routine BigNat<N>.div_limb(#self: Ptr<Self>, %d: I64) -> I64
require N: I64
    block entry():
        %length:  I64  := #self.length
        %divisor: I128 = %d.to_u128()
        jump loop(%length.sub(1), 0, %divisor)

    block loop(%i: I64, %rem: I128, %divisor: I128):
        %done: Bool = %i.slt(0)
        branch %done ? finish(%rem) : step(%i, %rem, %divisor)

    block step(%i: I64, %rem: I128, %divisor: I128):
        %limb: I64  := #self.limbs[%i]
        %cur:  I128 = %rem.shl(64).bitor(%limb.to_u128())
        #self.limbs[%i] = %cur.udiv(%divisor).to_i64()
        jump loop(%i.sub(1), %cur.urem(%divisor), %divisor)

    block finish(%rem: I128):
        #self.trim()
        return(%rem.to_i64())

; Bit %i of self (0 is the lowest).
routine BigNat<N>.bit(#self: Ptr<Self>, %i: I64) -> Bool
require N: I64
    block entry():
        %length: I64  := #self.length
        %at:     I64  = %i.sdiv(64)
        %inside: Bool = %at.slt(%length)
        branch %inside ? read(%at) : return(false)

    block read(%at: I64):
        %limb: I64  := #self.limbs[%at]
        %set:  Bool = %limb.lshr(%i.srem(64)).bitand(1).eq(1)
        return(%set)

; Whether any bit below bit %n is set.
routine BigNat<N>.any_below(#self: Ptr<Self>, %n: I64) -> Bool
require N: I64
    block entry():
        %length: I64 := #self.length
        %whole:  I64 = %n.sdiv(64).min(%length)
        jump loop(0, %whole, %length)

    block loop(%i: I64, %whole: I64, %length: I64):
        %done: Bool = %i.sge(%whole)
        branch %done ? partial(%whole, %length) : step(%i, %whole, %length)

    block step(%i: I64, %whole: I64, %length: I64):
        %limb: I64  := #self.limbs[%i]
        %set:  Bool = %limb.ne(0)
        branch %set ? return(true) : loop(%i.add(1), %whole, %length)

    block partial(%whole: I64, %length: I64):
        %inside: Bool = %whole.slt(%length)
        branch %inside ? mask(%whole) : return(false)

    block mask(%at: I64):
        %limb: I64  := #self.limbs[%at]
        %low:  I64  = 1.shl(%n.srem(64)).sub(1)
        %set:  Bool = %limb.bitand(%low).ne(0)
        return(%set)

; self = self / 2^bits (bits > 0), rounded to nearest, ties to even
routine BigNat<N>.shr_round_even(#self: Ptr<Self>, %bits: I64) -> Void
require N: I64
    block entry():
        %half_at:    I64  = %bits.sub(1)
        %half:       Bool = #self.bit(%half_at)
        %sticky:     Bool = #self.any_below(%half_at)
        %limb_shift: I64  = %bits.sdiv(64)
        %bit_shift:  I64  = %bits.srem(64)
        %length:     I64  := #self.length
        %kept:       I64  = %length.sub(%limb_shift).max(0)
        jump loop(0, %kept, %length, %limb_shift, %bit_shift, %half, %sticky)

    ; limb i takes the bits of limbs i + shift and i + shift + 1
    block loop(%i: I64, %kept: I64, %length: I64, %limb_shift: I64, %bit_shift: I64, %half: Bool, %sticky: Bool):
        %done: Bool = %i.sge(%kept)
        branch %done ? shifted(%kept, %half, %sticky) : step(%i, %kept, %length, %limb_shift, %bit_shift, %half, %sticky)

    block step(%i: I64, %kept: I64, %length: I64, %limb_shift: I64, %bit_shift: I64, %half: Bool, %sticky: Bool):
        %from:      I64  = %i.add(%limb_shift)
        %low:       I64  := #self.limbs[%from]
        %next_at:   I64  = %from.add(1)
        %has_next:  Bool = %next_at.slt(%length)
        %next_limb: I64  := #self.limbs[%next_at.min(%length.sub(1))]
        %next:      I64  = %has_next ? %next_limb : 0
        ; two shifts, so a zero bit shift never shifts by 64
        %high:      I64  = %next.shl(63.sub(%bit_shift)).shl(1)
        #self.limbs[%i] = %low.lshr(%bit_shift).bitor(%high)
        jump loop(%i.add(1), %kept, %length, %limb_shift, %bit_shift, %half, %sticky)

    block shifted(%kept: I64, %half: Bool, %sticky: Bool):
        #self.length = %kept
        #self.trim()
        %odd:   Bool = #self.bit(0)
        %round: Bool = %half.bitand(%sticky.bitor(%odd))
        branch %round ? bump() : return()

    block bump():
        #self.mul_add(1, 1)
        return()
