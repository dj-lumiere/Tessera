; Disl stdlib: 3-by-2 and 2-by-1 limb division
;
; div_3by2 divides the 192-bit (u2, u1, u0) by the 128-bit (d1, d0), for a
; normalized divisor (top bit of d1 set) and (u2, u1) < (d1, d0), so the
; quotient fits in 64 bits. It is the step of Knuth's algorithm D with a
; divisor of two or more limbs. div_2by1 divides the 128-bit (u1, u0) by the
; normalized 64-bit d, for u1 < d: the step with a one-limb divisor. All limbs
; are read as unsigned.
;
; Two implementations of each, picked by target:
;   x86_64   divq (128 / 64 in hardware). For 3-by-2 it estimates the
;            quotient from (u2, u1) and d1, then Knuth's test against d0
;            corrects it. With a two-limb divisor that test is exact, so no
;            add-back is needed. For 2-by-1 it is the whole step.
;   others   Möller and Granlund, "Improved division by invariant integers"
;            (2011): multiply by a precomputed reciprocal instead of
;            dividing. ARM64 has no 128 / 64 divide. The code follows intx
;            (Paweł Bylica, Apache 2.0).
; divq beats the reciprocal when only a couple of digits share a divisor, as
; in F128 division. div_3by2_mg and div_2by1_mg are always defined, so they
; can be tested on x86.
;
; Call div_3by2_prepare (div_2by1_prepare) once per divisor and pass its
; result as %v.

struct Div3By2
    quotient:  I64
    remainder: I128

struct Div2By1
    quotient:  I64
    remainder: I64

; 0x7FD00 / (256 + i): 11-bit seeds for the reciprocal
const RECIPROCAL_TABLE: Array<I64, 256> = [
    2045, 2037, 2029, 2021, 2013, 2005, 1998, 1990, 1983, 1975, 1968, 1960, 1953, 1946, 1938, 1931,
    1924, 1917, 1910, 1903, 1896, 1889, 1883, 1876, 1869, 1863, 1856, 1849, 1843, 1836, 1830, 1824,
    1817, 1811, 1805, 1799, 1792, 1786, 1780, 1774, 1768, 1762, 1756, 1750, 1745, 1739, 1733, 1727,
    1722, 1716, 1710, 1705, 1699, 1694, 1688, 1683, 1677, 1672, 1667, 1661, 1656, 1651, 1646, 1641,
    1636, 1630, 1625, 1620, 1615, 1610, 1605, 1600, 1596, 1591, 1586, 1581, 1576, 1572, 1567, 1562,
    1558, 1553, 1548, 1544, 1539, 1535, 1530, 1526, 1521, 1517, 1513, 1508, 1504, 1500, 1495, 1491,
    1487, 1483, 1478, 1474, 1470, 1466, 1462, 1458, 1454, 1450, 1446, 1442, 1438, 1434, 1430, 1426,
    1422, 1418, 1414, 1411, 1407, 1403, 1399, 1396, 1392, 1388, 1384, 1381, 1377, 1374, 1370, 1366,
    1363, 1359, 1356, 1352, 1349, 1345, 1342, 1338, 1335, 1332, 1328, 1325, 1322, 1318, 1315, 1312,
    1308, 1305, 1302, 1299, 1295, 1292, 1289, 1286, 1283, 1280, 1276, 1273, 1270, 1267, 1264, 1261,
    1258, 1255, 1252, 1249, 1246, 1243, 1240, 1237, 1234, 1231, 1228, 1226, 1223, 1220, 1217, 1214,
    1211, 1209, 1206, 1203, 1200, 1197, 1195, 1192, 1189, 1187, 1184, 1181, 1179, 1176, 1173, 1171,
    1168, 1165, 1163, 1160, 1158, 1155, 1153, 1150, 1148, 1145, 1143, 1140, 1138, 1135, 1133, 1130,
    1128, 1125, 1123, 1121, 1118, 1116, 1113, 1111, 1109, 1106, 1104, 1102, 1099, 1097, 1095, 1092,
    1090, 1088, 1086, 1083, 1081, 1079, 1077, 1074, 1072, 1070, 1068, 1066, 1064, 1061, 1059, 1057,
    1055, 1053, 1051, 1049, 1047, 1044, 1042, 1040, 1038, 1036, 1034, 1032, 1030, 1028, 1026, 1024
]

; -- helpers -------------------------------------------------------------------

; The high 64 bits of a × b, both unsigned.
routine mul_high64(%a: I64, %b: I64) -> I64
    block entry():
        %r: I64 = %a.to_u128().mul(%b.to_u128()).lshr(64).to_i64()
        return(%r)

; -- Möller–Granlund -----------------------------------------------------------

; floor((2^128 - 1) / d) - 2^64 for a normalized d (Algorithm 2 of the paper).
routine reciprocal_2by1(%d: I64) -> I64
    block entry():
        %index: I64 = %d.lshr(55).sub(256)
        %v0:    I64 := RECIPROCAL_TABLE[%index]
        %d40:   I64 = %d.lshr(24).add(1)
        %v0_sq: I64 = %v0.mul(%v0).bitand(0xFFFFFFFF)
        %fix1:  I64 = %v0_sq.mul(%d40).lshr(40).bitand(0xFFFFFFFF)
        %v1:    I64 = %v0.shl(11).sub(%fix1).sub(1)
        %gap:   I64 = 0x1000000000000000.sub(%v1.mul(%d40))
        %v2:    I64 = %v1.shl(13).add(%v1.mul(%gap).lshr(47))
        %d0:    I64 = %d.bitand(1)
        %d63:   I64 = %d.lshr(1).add(%d0)                    ; ceil(d / 2)
        %e:     I64 = %v2.lshr(1).bitand(0.sub(%d0)).sub(%v2.mul(%d63))
        %v3:    I64 = mul_high64(%v2, %e).lshr(1).add(%v2.shl(31))
        ; v4 = v3 - high(v3 × d + d) - d
        %p:     I128 = %v3.to_u128().mul(%d.to_u128()).add(%d.to_u128())
        %v4:    I64  = %v3.sub(%p.lshr(64).to_i64()).sub(%d)
        return(%v4)

; floor((2^192 - 1) / d) - 2^64 for the normalized two-limb d = (d1, d0).
routine reciprocal_3by2(%d1: I64, %d0: I64) -> I64
    block entry():
        %v:     I64  = reciprocal_2by1(%d1)
        %p:     I64  = %d1.mul(%v).add(%d0)
        %wrap1: Bool = %p.ult(%d0)
        branch %wrap1 ? step_down(%v, %p) : cross(%v, %p)

    block step_down(%v: I64, %p: I64):
        %twice: Bool = %p.uge(%d1)
        %v2:    I64  = %twice ? %v.sub(2) : %v.sub(1)
        %p2:    I64  = %twice ? %p.sub(%d1).sub(%d1) : %p.sub(%d1)
        jump cross(%v2, %p2)

    block cross(%v: I64, %p: I64):
        %t:     I128 = %v.to_u128().mul(%d0.to_u128())
        %t_lo:  I64  = %t.to_i64()
        %t_hi:  I64  = %t.lshr(64).to_i64()
        %p2:    I64  = %p.add(%t_hi)
        %wrap2: Bool = %p2.ult(%t_hi)
        %over:  Bool = %p2.ugt(%d1).bitor(%t_lo.uge(%d0))
        %again: Bool = %p2.uge(%d1).bitand(%over)
        %down:  I64  = %wrap2.to_i64().add(%wrap2.bitand(%again).to_i64())
        %r:     I64  = %v.sub(%down)
        return(%r)

routine div_3by2_mg(%u2: I64, %u1: I64, %u0: I64, %d1: I64, %d0: I64, %v: I64) -> Div3By2
    block entry():
        %d:     I128 = %d1.to_u128().shl(64).bitor(%d0.to_u128())
        %q:     I128 = %v.to_u128().mul(%u2.to_u128()).add(%u2.to_u128().shl(64).bitor(%u1.to_u128()))
        %q_lo:  I64  = %q.to_i64()
        %q_hi:  I64  = %q.lshr(64).to_i64()
        %r1:    I64  = %u1.sub(%q_hi.mul(%d1))
        %t:     I128 = %d0.to_u128().mul(%q_hi.to_u128())
        %r:     I128 = %r1.to_u128().shl(64).bitor(%u0.to_u128()).sub(%t).sub(%d)
        %r_hi:  I64  = %r.lshr(64).to_i64()
        %qq:    I64  = %q_hi.add(1)
        %back:  Bool = %r_hi.uge(%q_lo)
        %qq2:   I64  = %back ? %qq.sub(1) : %qq
        %rr:    I128 = %back ? %r.add(%d) : %r
        %over:  Bool = %rr.uge(%d)
        %qq3:   I64  = %over ? %qq2.add(1) : %qq2
        %rr2:   I128 = %over ? %rr.sub(%d) : %rr
        %res: Div3By2 = Div3By2 { quotient: %qq3, remainder: %rr2 }
        return(%res)

; (u1, u0) / d with the reciprocal v = reciprocal_2by1(d) (Algorithm 4 of the paper).
routine div_2by1_mg(%u1: I64, %u0: I64, %d: I64, %v: I64) -> Div2By1
    block entry():
        %u:     I128 = %u1.to_u128().shl(64).bitor(%u0.to_u128())
        %q:     I128 = %v.to_u128().mul(%u1.to_u128()).add(%u)
        %q_lo:  I64  = %q.to_i64()
        %q_hi:  I64  = %q.lshr(64).to_i64().add(1)
        %r:     I64  = %u0.sub(%q_hi.mul(%d))
        ; The estimate is at most one too big (r wrapped above q_lo) or one too small (r >= d).
        %back:  Bool = %r.ugt(%q_lo)
        %q2:    I64  = %back ? %q_hi.sub(1) : %q_hi
        %r2:    I64  = %back ? %r.add(%d) : %r
        %over:  Bool = %r2.uge(%d)
        %q3:    I64  = %over ? %q2.add(1) : %q2
        %r3:    I64  = %over ? %r2.sub(%d) : %r2
        %res: Div2By1 = Div2By1 { quotient: %q3, remainder: %r3 }
        return(%res)

; -- divq ----------------------------------------------------------------------

; floor((hi × 2^64 + lo) / d) with x86's divq. Needs hi < d: divq faults when
; the quotient doesn't fit in 64 bits.
@[external("llvm"), target(arch: "x86_64"), template("{t0} = call {{ i64, i64 }} asm \"divq $4\", \"={{ax}},={{dx}},0,1,r,~{{flags}}\"(i64 {%lo}, i64 {%hi}, i64 {%d})\n{result} = extractvalue {{ i64, i64 }} {t0}, 0")]
routine divq_quotient(%hi: I64, %lo: I64, %d: I64) -> I64

@target(arch: "x86_64")
routine div_3by2_divq(%u2: I64, %u1: I64, %u0: I64, %d1: I64, %d0: I64) -> Div3By2
    block entry():
        ; (u2, u1) < (d1, d0) leaves u2 <= d1; when equal, divq would fault.
        %top: Bool = %u2.eq(%d1)
        branch %top ? saturated() : estimate()

    block estimate():
        %q:    I64  = divq_quotient(%u2, %u1, %d1)
        %rhat: I64  = %u1.sub(%q.mul(%d1))
        jump check(%q, %rhat.to_u128())

    ; q = 2^64 - 1, and rhat = (u2, u1) - q × d1 = u1 + d1, which may carry
    block saturated():
        %rhat: I128 = %u1.to_u128().add(%d1.to_u128())
        jump check(-1, %rhat)

    ; Knuth's test: while q × d0 > (rhat, u0), q is one too big. Runs at most twice.
    block check(%q: I64, %rhat: I128):
        %carried: Bool = %rhat.uge(18446744073709551616)       ; 2^64: the test can't fail
        %lhs:     I128 = %q.to_u128().mul(%d0.to_u128())
        %rhs:     I128 = %rhat.shl(64).bitor(%u0.to_u128())
        %too_big: Bool = %carried.bitnot().bitand(%lhs.ugt(%rhs))
        branch %too_big ? check(%q.sub(1), %rhat.add(%d1.to_u128())) : done(%q)

    ; The remainder is below 2^128, so the low 128 bits of the subtraction suffice.
    block done(%q: I64):
        %d:    I128 = %d1.to_u128().shl(64).bitor(%d0.to_u128())
        %low:  I128 = %u1.to_u128().shl(64).bitor(%u0.to_u128())
        %r:    I128 = %low.sub(%d.mul(%q.to_u128()))
        %res: Div3By2 = Div3By2 { quotient: %q, remainder: %r }
        return(%res)

@target(arch: "x86_64")
routine div_2by1_divq(%u1: I64, %u0: I64, %d: I64) -> Div2By1
    block entry():
        %q:   I64 = divq_quotient(%u1, %u0, %d)
        %r:   I64 = %u0.sub(%q.mul(%d))
        %res: Div2By1 = Div2By1 { quotient: %q, remainder: %r }
        return(%res)

; -- by target -----------------------------------------------------------------

@target(arch: "x86_64")
routine div_2by1_prepare(%d: I64) -> I64
    block entry():
        return(0)

@target(arch: !"x86_64")
routine div_2by1_prepare(%d: I64) -> I64
    block entry():
        %v: I64 = reciprocal_2by1(%d)
        return(%v)

@target(arch: "x86_64")
routine div_2by1(%u1: I64, %u0: I64, %d: I64, %v: I64) -> Div2By1
    block entry():
        %r: Div2By1 = div_2by1_divq(%u1, %u0, %d)
        return(%r)

@target(arch: !"x86_64")
routine div_2by1(%u1: I64, %u0: I64, %d: I64, %v: I64) -> Div2By1
    block entry():
        %r: Div2By1 = div_2by1_mg(%u1, %u0, %d, %v)
        return(%r)

@target(arch: "x86_64")
routine div_3by2_prepare(%d1: I64, %d0: I64) -> I64
    block entry():
        return(0)

@target(arch: !"x86_64")
routine div_3by2_prepare(%d1: I64, %d0: I64) -> I64
    block entry():
        %v: I64 = reciprocal_3by2(%d1, %d0)
        return(%v)

@target(arch: "x86_64")
routine div_3by2(%u2: I64, %u1: I64, %u0: I64, %d1: I64, %d0: I64, %v: I64) -> Div3By2
    block entry():
        %r: Div3By2 = div_3by2_divq(%u2, %u1, %u0, %d1, %d0)
        return(%r)

@target(arch: !"x86_64")
routine div_3by2(%u2: I64, %u1: I64, %u0: I64, %d1: I64, %d0: I64, %v: I64) -> Div3By2
    block entry():
        %r: Div3By2 = div_3by2_mg(%u2, %u1, %u0, %d1, %d0, %v)
        return(%r)
