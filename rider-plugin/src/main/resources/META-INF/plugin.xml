<idea-plugin>
    <id>com.lapila.rider</id>
    <name>Lapila</name>
    <vendor email="djminstar573@gmail.com">lapila</vendor>

    <description><![CDATA[
        Lapila (<code>.li</code>) in Rider: syntax highlighting, comment and bracket handling, and the Lapila language
        server (<code>lapila lsp</code>) for the builder's errors and style warnings as you type and Reformat Code.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.lapila.rider.LapilaEditorListener"/>
        <textmate.bundleProvider implementation="com.lapila.rider.LapilaBundleProvider"/>
        <lang.syntaxHighlighterFactory language="lapila" implementationClass="com.lapila.rider.LapilaSyntaxHighlighterFactory"/>
        <fileIconProvider implementation="com.lapila.rider.LapilaIconProvider"/>
        <platform.lsp.integrationProvider implementation="com.lapila.rider.LapilaLanguageServer"/>
        <actionConfigurationCustomizer order="last" implementation="com.lapila.rider.LapilaCleanupActions"/>
        <colorSettingsPage implementation="com.lapila.rider.LapilaColorSettingsPage"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/LapilaDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/LapilaDefault.xml"/>
        <applicationConfigurable
            parentId="language"
            id="com.lapila.rider.settings"
            displayName="Lapila"
            instance="com.lapila.rider.LapilaConfigurable"/>
    </extensions>

    <projectListeners>
        <listener
            class="com.lapila.rider.LapilaFileOpenListener"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
