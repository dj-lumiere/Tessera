<idea-plugin>
    <id>com.tessera.rider</id>
    <name>Tessera</name>
    <vendor email="djminstar573@gmail.com">tessera</vendor>

    <description><![CDATA[
        Tessera (<code>.tess</code>) in Rider: syntax highlighting, comment and bracket handling, and Reformat Code
        through the Tessera builder's formatter (<code>tessera fmt</code>).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="com.tessera.rider.TesseraBundleProvider"/>
        <fileIconProvider implementation="com.tessera.rider.TesseraIconProvider"/>
        <formattingService implementation="com.tessera.rider.TesseraFormatter"/>
        <notificationGroup id="Tessera" displayType="BALLOON"/>
        <applicationConfigurable
            parentId="language"
            id="com.tessera.rider.settings"
            displayName="Tessera"
            instance="com.tessera.rider.TesseraConfigurable"/>
    </extensions>
</idea-plugin>
