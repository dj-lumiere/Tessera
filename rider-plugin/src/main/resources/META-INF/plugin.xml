<idea-plugin>
    <id>com.tessera.rider</id>
    <name>Tessera</name>
    <vendor email="djminstar573@gmail.com">tessera</vendor>

    <description><![CDATA[
        Tessera (<code>.tess</code>) in Rider: syntax highlighting, comment and bracket handling, and the Tessera language
        server (<code>tessera lsp</code>) for the builder's errors and style warnings as you type and Reformat Code.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.tessera.rider.TesseraEditorListener"/>
        <textmate.bundleProvider implementation="com.tessera.rider.TesseraBundleProvider"/>
        <lang.syntaxHighlighterFactory language="tessera" implementationClass="com.tessera.rider.TesseraSyntaxHighlighterFactory"/>
        <fileIconProvider implementation="com.tessera.rider.TesseraIconProvider"/>
        <platform.lsp.integrationProvider implementation="com.tessera.rider.TesseraLanguageServer"/>
        <actionConfigurationCustomizer order="last" implementation="com.tessera.rider.TesseraCleanupActions"/>
        <colorSettingsPage implementation="com.tessera.rider.TesseraColorSettingsPage"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/TesseraDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/TesseraDefault.xml"/>
        <applicationConfigurable
            parentId="language"
            id="com.tessera.rider.settings"
            displayName="Tessera"
            instance="com.tessera.rider.TesseraConfigurable"/>
    </extensions>

    <projectListeners>
        <listener
            class="com.tessera.rider.TesseraFileOpenListener"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
