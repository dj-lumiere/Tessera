{
  "name": "lapila",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "lumifoundry",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "lapila",
        "aliases": [
          "Lapila",
          "lapila"
        ],
        "extensions": [
          ".li"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lapila.svg",
          "dark": "./icons/lapila.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "lapila",
        "scopeName": "source.li",
        "path": "./syntaxes/Lapila.tmLanguage"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "recordType",
        "superType": "struct",
        "description": "%token.recordType%"
      },
      {
        "id": "entityType",
        "superType": "class",
        "description": "%token.entityType%"
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "%token.constant%"
      },
      {
        "id": "block",
        "superType": "label",
        "description": "%token.block%"
      },
      {
        "id": "controlKeyword",
        "superType": "keyword",
        "description": "%token.controlKeyword%"
      },
      {
        "id": "sharedValue",
        "superType": "parameter",
        "description": "%token.sharedValue%"
      },
      {
        "id": "docTag",
        "superType": "keyword",
        "description": "%token.docTag%"
      },
      {
        "id": "docValue",
        "superType": "variable",
        "description": "%token.docValue%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lapila",
        "scopes": {
          "recordType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "constant": [
            "variable.other.constant"
          ],
          "block": [
            "entity.name.label"
          ],
          "controlKeyword": [
            "keyword.control"
          ],
          "sharedValue": [
            "variable.parameter"
          ],
          "docTag": [
            "storage.type.class.jsdoc"
          ],
          "docValue": [
            "variable.other.jsdoc"
          ],
          "entityType": [
            "entity.name.type.class",
            "entity.name.type"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[lapila]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "block:lapila": "#F78FC6",
          "decorator:lapila": "#E5C07B",
          "recordType:lapila": "#4EC9B0",
          "entityType:lapila": "#5CB2FF"
        }
      }
    },
    "configuration": {
      "title": "Lapila",
      "properties": {
        "lapila.builderPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.path%"
        }
      }
    },
    "commands": [
      {
        "command": "lapila.restartServer",
        "title": "%command.restart%",
        "category": "Lapila"
      },
      {
        "command": "lapila.runFile",
        "title": "%command.runFile%",
        "category": "Lapila",
        "icon": "$(play)"
      },
      {
        "command": "lapila.runFolder",
        "title": "%command.runFolder%",
        "category": "Lapila",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lapila.runFile",
          "when": "resourceLangId == lapila",
          "group": "z_commands@1"
        },
        {
          "command": "lapila.runFolder",
          "when": "resourceLangId == lapila",
          "group": "z_commands@2"
        }
      ],
      "explorer/context": [
        {
          "command": "lapila.runFile",
          "when": "resourceLangId == lapila",
          "group": "z_commands@1"
        }
      ],
      "editor/title": [
        {
          "command": "lapila.runFile",
          "when": "resourceLangId == lapila",
          "group": "navigation@1"
        },
        {
          "command": "lapila.runFolder",
          "when": "resourceLangId == lapila",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lapila.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == lapila"
      },
      {
        "command": "lapila.runFolder",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "editorLangId == lapila"
      }
    ]
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "compile": "npm run assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/lapila.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
