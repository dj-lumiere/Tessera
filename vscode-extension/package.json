{
  "name": "tessera",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "lumifoundry",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "tessera",
        "aliases": [
          "Tessera",
          "tessera"
        ],
        "extensions": [
          ".tess"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tessera.svg",
          "dark": "./icons/tessera.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tessera",
        "scopeName": "source.tess",
        "path": "./syntaxes/Tessera.tmLanguage"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "recordType",
        "superType": "struct",
        "description": "%token.recordType%"
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "%token.constant%"
      },
      {
        "id": "block",
        "superType": "label",
        "description": "%token.block%"
      },
      {
        "id": "controlKeyword",
        "superType": "keyword",
        "description": "%token.controlKeyword%"
      },
      {
        "id": "sharedValue",
        "superType": "parameter",
        "description": "%token.sharedValue%"
      },
      {
        "id": "docTag",
        "superType": "keyword",
        "description": "%token.docTag%"
      },
      {
        "id": "docValue",
        "superType": "variable",
        "description": "%token.docValue%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tessera",
        "scopes": {
          "recordType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "constant": [
            "variable.other.constant"
          ],
          "block": [
            "entity.name.label"
          ],
          "controlKeyword": [
            "keyword.control"
          ],
          "sharedValue": [
            "variable.parameter"
          ],
          "docTag": [
            "storage.type.class.jsdoc"
          ],
          "docValue": [
            "variable.other.jsdoc"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[tessera]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "block:tessera": "#F78FC6",
          "decorator:tessera": "#E5C07B"
        }
      }
    },
    "configuration": {
      "title": "Tessera",
      "properties": {
        "tessera.builderPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.path%"
        }
      }
    },
    "commands": [
      {
        "command": "tessera.restartServer",
        "title": "%command.restart%",
        "category": "Tessera"
      }
    ]
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "compile": "npm run assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/tessera.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
