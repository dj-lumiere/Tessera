/// Writes `new` if the value here is `expected`, atomically and release, and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is relaxed.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} release monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_weak_release_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and release: Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_weak_release(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_weak_release_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and acquire and release, and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is acquire.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} acq_rel acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_weak_acq_rel_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and acquire and release: Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_weak_acq_rel(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_weak_acq_rel_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

// -- fences ----------------------------------------------------------------------

/// Orders memory accesses around it across threads and cores, sequentially consistent.
#[external("llvm"), template("fence seq_cst")]
routine fence() -> Void

/// Orders memory accesses around it across threads and cores, acquire.
#[external("llvm"), template("fence acquire")]
routine fence_acquire() -> Void

/// Orders memory accesses around it across threads and cores, release.
#[external("llvm"), template("fence release")]
routine fence_release() -> Void

/// Orders memory accesses around it across threads and cores, acquire and release.
#[external("llvm"), template("fence acq_rel")]
routine fence_acq_rel() -> Void

/// Orders memory accesses around it for the compiler only, sequentially consistent: against an interrupt handler on the same
/// core, with no barrier instruction.
#[external("llvm"), template("fence syncscope(\"singlethread\") seq_cst")]
routine compiler_fence() -> Void

/// Orders memory accesses around it for the compiler only, acquire: against an interrupt handler on the same
/// core, with no barrier instruction.
#[external("llvm"), template("fence syncscope(\"singlethread\") acquire")]
routine compiler_fence_acquire() -> Void

/// Orders memory accesses around it for the compiler only, release: against an interrupt handler on the same
/// core, with no barrier instruction.
#[external("llvm"), template("fence syncscope(\"singlethread\") release")]
routine compiler_fence_release() -> Void

/// Orders memory accesses around it for the compiler only, acquire and release: against an interrupt handler on the same
/// core, with no barrier instruction.
#[external("llvm"), template("fence syncscope(\"singlethread\") acq_rel")]
routine compiler_fence_acq_rel() -> Void
