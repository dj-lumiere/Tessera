#[target(arch: "arm"), feature("armv7-m")]
conform AtomicStorable<S8>, AtomicStorable<U8>, AtomicStorable<S16>, AtomicStorable<U16>, AtomicStorable<S32>, AtomicStorable<U32>, AtomicStorable<USize>, AtomicStorable<SSize>, AtomicStorable<Byte>, AtomicStorable<Addr>, AtomicStorable<F32>
