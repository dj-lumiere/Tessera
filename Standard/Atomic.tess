routine Ptr<T>.atomic_fetch_fsub_acq_rel(me: Me, value: T) -> T
require T: typename, AtomicFloatAddable<T>

// -- compare and exchange --------------------------------------------------------

// The `_raw` forms write new if the value here is expected and return whether they did, storing the value that was
// here in previous either way: the shape of LLVM's cmpxchg, for code that wants the flag and the value side by side.
// The forms without `_raw` wrap them in a Result.

/// Writes `new` if the value here is `expected`, atomically and sequentially consistent, and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is sequentially consistent.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} seq_cst seq_cst, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_raw(me: Me, expected: T, new: T, previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and sequentially consistent: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and relaxed (only atomic), and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is relaxed.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} monotonic monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_relaxed_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and relaxed (only atomic): Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_relaxed(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_relaxed_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and acquire, and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is acquire.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} acquire acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_acquire_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and acquire: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_acquire(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_acquire_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and release, and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is relaxed.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} release monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_release_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and release: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_release(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_release_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and acquire and release, and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is acquire.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} acq_rel acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_acq_rel_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and acquire and release: Success with the previous value
/// if it did, Failure with the value found if not. It fails only when the value differs.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_acq_rel(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_acq_rel_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and sequentially consistent, and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is sequentially consistent.
/// :typeparam T: The pointee type, which must support the operation atomically on the target.
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :param previous: Receives the value that was in memory.
/// :returns: True when the exchange happened.
#[external("llvm"),
    template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} seq_cst seq_cst, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_weak_raw(me: Me, expected: T, new: T, previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and sequentially consistent: Success with the previous value
/// if it did, Failure with the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
/// :param expected: The value the memory is expected to hold.
/// :param new: The value to write when it matches.
/// :returns: `Success` with the previous value when `new` was written, `Failure` with the value found when not.
routine Ptr<T>.atomic_compare_exchange_weak(me: Me, expected: T, new: T) -> Result<T, T>
require T: typename, AtomicExchangeable<T>
    block entry()
        claim previous : @T <- uninit
        swapped : Bool = me.atomic_compare_exchange_weak_raw(expected, new, previous)
        value   : T    = previous.load()
        branch swapped
            ? return(.Success(value))
            : return(.Failure(value))

/// Writes `new` if the value here is `expected`, atomically and relaxed (only atomic), and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is relaxed.
