conform AtomicExchangeable<S8>, AtomicExchangeable<U8>, AtomicExchangeable<S16>, AtomicExchangeable<U16>, AtomicExchangeable<S32>, AtomicExchangeable<U32>, AtomicExchangeable<USize>, AtomicExchangeable<SSize>, AtomicExchangeable<Byte>, AtomicExchangeable<Addr>
#[target(arch: "arm"), feature("armv7e-m")]
conform AtomicExchangeable<@T> when T: typename
