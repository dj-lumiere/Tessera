#[target(arch: "riscv64"), feature("a")]
conform AtomicMaskable<S8>, AtomicMaskable<U8>, AtomicMaskable<S16>, AtomicMaskable<U16>, AtomicMaskable<S32>, AtomicMaskable<U32>, AtomicMaskable<S64>, AtomicMaskable<U64>, AtomicMaskable<USize>, AtomicMaskable<SSize>, AtomicMaskable<Byte>
#[target(arch: "riscv64"), feature("a")]
conform AtomicFloatAddable<F32>, AtomicFloatAddable<F64>

#[target(arch: "arm"), feature("armv6kz")]
conform AtomicStorable<S8>, AtomicStorable<U8>, AtomicStorable<S16>, AtomicStorable<U16>, AtomicStorable<S32>, AtomicStorable<U32>, AtomicStorable<S64>, AtomicStorable<U64>, AtomicStorable<USize>, AtomicStorable<SSize>, AtomicStorable<Byte>, AtomicStorable<Addr>, AtomicStorable<F32>, AtomicStorable<F64>
#[target(arch: "arm"), feature("armv6kz")]
conform AtomicStorable<@T> when T: typename
#[target(arch: "arm"), feature("armv6kz")]
conform AtomicExchangeable<S8>, AtomicExchangeable<U8>, AtomicExchangeable<S16>, AtomicExchangeable<U16>, AtomicExchangeable<S32>, AtomicExchangeable<U32>, AtomicExchangeable<S64>, AtomicExchangeable<U64>, AtomicExchangeable<USize>, AtomicExchangeable<SSize>, AtomicExchangeable<Byte>, AtomicExchangeable<Addr>
#[target(arch: "arm"), feature("armv6kz")]
conform AtomicExchangeable<@T> when T: typename
#[target(arch: "arm"), feature("armv6kz")]
