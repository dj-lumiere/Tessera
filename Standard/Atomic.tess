    template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} monotonic monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine Ptr<T>.atomic_compare_exchange_weak_relaxed_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
require T: typename, AtomicExchangeable<T>

/// Writes new if the value here is expected, atomically and relaxed (only atomic): Success with the previous value
