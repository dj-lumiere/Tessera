conform AtomicExchangeable<S8>, AtomicExchangeable<U8>, AtomicExchangeable<S16>, AtomicExchangeable<U16>, AtomicExchangeable<S32>, AtomicExchangeable<U32>, AtomicExchangeable<USize>, AtomicExchangeable<SSize>, AtomicExchangeable<Byte>, AtomicExchangeable<Addr>
#[target(arch: "arm"), feature("armv7-m")]
conform AtomicExchangeable<@T> when T: typename
#[target(arch: "arm"), feature("armv7-m")]
conform AtomicAddable<S8>, AtomicAddable<U8>, AtomicAddable<S16>, AtomicAddable<U16>, AtomicAddable<S32>, AtomicAddable<U32>, AtomicAddable<USize>, AtomicAddable<SSize>
#[target(arch: "arm"), feature("armv7-m")]
conform AtomicMaskable<S8>, AtomicMaskable<U8>, AtomicMaskable<S16>, AtomicMaskable<U16>, AtomicMaskable<S32>, AtomicMaskable<U32>, AtomicMaskable<USize>, AtomicMaskable<SSize>, AtomicMaskable<Byte>
#[target(arch: "arm"), feature("armv7-m")]
