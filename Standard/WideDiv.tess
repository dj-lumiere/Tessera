// Tessera stdlib: 3-by-2 and 2-by-1 limb division
//
// div_3by2 divides the 192-bit (u2, u1, u0) by the 128-bit (d1, d0), for a
// normalized divisor (top bit of d1 set) and (u2, u1) < (d1, d0), so the
// quotient fits in 64 bits. It is the step of Knuth's algorithm D with a
// divisor of two or more limbs. div_2by1 divides the 128-bit (u1, u0) by the
// normalized 64-bit d, for u1 < d: the step with a one-limb divisor. Limbs are
// U64, and limb arithmetic is modulo 2^64 (_wrap), as the algorithms assume.
//
// Two implementations of each, picked by target:
//   x86_64   divq (128 / 64 in hardware). For 3-by-2 it estimates the
//            quotient from (u2, u1) and d1, then Knuth's test against d0
//            corrects it. With a two-limb divisor that test is exact, so no
//            add-back is needed. For 2-by-1 it is the whole step.
//   others   Möller and Granlund, "Improved division by invariant integers"
//            (2011): multiply by a precomputed reciprocal instead of
//            dividing. ARM64 has no 128 / 64 divide. The code follows intx
//            (Paweł Bylica, Apache 2.0).
// divq beats the reciprocal when only a couple of digits share a divisor, as
// in F128 division. div_3by2_mg and div_2by1_mg are always defined, so they
// can be tested on x86.
//
// Call div_3by2_prepare once per divisor and pass the Divisor3By2 it gives
// to div_3by2. Call div_2by1_prepare once per divisor and pass its result as v.

module Standard::Core

/// 0x7FD00 / (256 + i): 11-bit seeds for the reciprocal
preset RECIPROCAL_TABLE: @Array<U64, 256> <- { 2045, 2037, 2029, 2021, 2013, 2005, 1998, 1990, 1983,
    1975, 1968, 1960, 1953, 1946, 1938, 1931, 1924, 1917, 1910, 1903, 1896, 1889, 1883, 1876, 1869,
    1863, 1856, 1849, 1843, 1836, 1830, 1824, 1817, 1811, 1805, 1799, 1792, 1786, 1780, 1774, 1768,
    1762, 1756, 1750, 1745, 1739, 1733, 1727, 1722, 1716, 1710, 1705, 1699, 1694, 1688, 1683, 1677,
    1672, 1667, 1661, 1656, 1651, 1646, 1641, 1636, 1630, 1625, 1620, 1615, 1610, 1605, 1600, 1596,
    1591, 1586, 1581, 1576, 1572, 1567, 1562, 1558, 1553, 1548, 1544, 1539, 1535, 1530, 1526, 1521,
    1517, 1513, 1508, 1504, 1500, 1495, 1491, 1487, 1483, 1478, 1474, 1470, 1466, 1462, 1458, 1454,
    1450, 1446, 1442, 1438, 1434, 1430, 1426, 1422, 1418, 1414, 1411, 1407, 1403, 1399, 1396, 1392,
    1388, 1384, 1381, 1377, 1374, 1370, 1366, 1363, 1359, 1356, 1352, 1349, 1345, 1342, 1338, 1335,
    1332, 1328, 1325, 1322, 1318, 1315, 1312, 1308, 1305, 1302, 1299, 1295, 1292, 1289, 1286, 1283,
    1280, 1276, 1273, 1270, 1267, 1264, 1261, 1258, 1255, 1252, 1249, 1246, 1243, 1240, 1237, 1234,
    1231, 1228, 1226, 1223, 1220, 1217, 1214, 1211, 1209, 1206, 1203, 1200, 1197, 1195, 1192, 1189,
    1187, 1184, 1181, 1179, 1176, 1173, 1171, 1168, 1165, 1163, 1160, 1158, 1155, 1153, 1150, 1148,
    1145, 1143, 1140, 1138, 1135, 1133, 1130, 1128, 1125, 1123, 1121, 1118, 1116, 1113, 1111, 1109,
    1106, 1104, 1102, 1099, 1097, 1095, 1092, 1090, 1088, 1086, 1083, 1081, 1079, 1077, 1074, 1072,
    1070, 1068, 1066, 1064, 1061, 1059, 1057, 1055, 1053, 1051, 1049, 1047, 1044, 1042, 1040, 1038,
    1036, 1034, 1032, 1030, 1028, 1026, 1024 }

/// The result of a 3-by-2 limb division: a 64-bit quotient and the 128-bit remainder.
record Div3By2
    quotient  : U64
    remainder : U128

/// A normalized two-limb divisor ready for {div_3by2}: its limbs, and the value {div_3by2_prepare} works out from them
/// once so that every division by it reuses it.
record Divisor3By2
    high       : U64  // the high limb, with its top bit set
    low        : U64  // the low limb
    reciprocal : U64  // reciprocal_3by2 of the limbs where div_3by2 multiplies by it, else unused (0 on x86_64)

/// The result of a 2-by-1 limb division: a 64-bit quotient and the 64-bit remainder.
record Div2By1
    quotient  : U64
    remainder : U64

// -- helpers -------------------------------------------------------------------

/// The high 64 bits of the full 128-bit product of `a` and `b`, both unsigned.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: `(a × b) >> 64`.
routine mul_high64(a: U64, b: U64) -> U64
    block entry()
        product : U128 = a.to<U128>().mul_wrap(b.to<U128>())
        r       : U64  = product.shr(64).to<U64>()
        return(r)

// -- Möller–Granlund -----------------------------------------------------------

/// The Moller and Granlund reciprocal of a normalized `d`, floor((2^128 - 1) / d) - 2^64 (Algorithm 2 of the paper).
/// :param d: The divisor, with its top bit set.
/// :returns: The reciprocal, for {div_2by1_mg}.
/// :throws: Crashes with `IntegerOverflowError` when the top bit of `d` is clear.
routine reciprocal_2by1(d: U64) -> U64
    block entry()
        slot     : U64   = d.shr(55).sub(256)
        index    : USize = slot.to<USize>()
        v0       : U64   = RECIPROCAL_TABLE.getitem(index)
        d40      : U64   = d.shr(24).add_wrap(1)
        v0_sq    : U64   = v0.mul_wrap(v0).bitand(0xFFFFFFFF)
        fix_wide : U64   = v0_sq.mul_wrap(d40).shr(40)
        fix1     : U64   = fix_wide.bitand(0xFFFFFFFF)
        v1p1     : U64   = v0.shl(11).sub(fix1)
        v1       : U64   = v1p1.sub(1)
        gap      : U64   = 0x1000000000000000.sub_wrap(v1.mul_wrap(d40))
        v2       : U64   = v1.shl(13).add_wrap(v1.mul_wrap(gap).shr(47))
        d0       : U64   = d.bitand(1)
        d63      : U64   = d.shr(1).add_wrap(d0)  // ceil(d / 2)
        half_v2  : U64   = v2.shr(1).bitand(0.sub_wrap(d0))
        e        : U64   = half_v2.sub_wrap(v2.mul_wrap(d63))
        high_ve  : U64   = mul_high64(v2, e).shr(1)
        v3       : U64   = high_ve.add_wrap(v2.shl(31))
        // v4 = v3 - high(v3 × d + d) - d
        v3d : U128 = v3.to<U128>().mul_wrap(d.to<U128>())
        p   : U128 = v3d.add_wrap(d.to<U128>())
        v4  : U64  = v3.sub_wrap(p.shr(64).to<U64>()).sub_wrap(d)
        return(v4)

/// The Moller and Granlund reciprocal of the normalized two-limb divisor `(d1, d0)`, floor((2^192 - 1) / d) - 2^64.
/// :param d1: The high limb of the divisor, with its top bit set.
/// :param d0: The low limb of the divisor.
/// :returns: The reciprocal, for {div_3by2_mg}.
/// :throws: Crashes with `IntegerOverflowError` when the top bit of `d1` is clear.
routine reciprocal_3by2(d1: U64, d0: U64) -> U64
    shared v : U64 = reciprocal_2by1(d1)
    shared p : U64 = d1.mul_wrap(v).add_wrap(d0)

    block entry()
        wrap1 : Bool = p.lt(d0)
        branch wrap1
            ? step_down()
            : cross(v, p)

    block step_down()
        twice : Bool = p.ge(d1)
        v2    : U64  = twice
            ? v.sub_wrap(2)
            : v.sub_wrap(1)
        p2 : U64 = twice
            ? p.sub_wrap(d1).sub_wrap(d1)
            : p.sub_wrap(d1)
        jump cross(v2, p2)

    block cross(v_fixed: U64, p_fixed: U64)
        t     : U128 = v_fixed.to<U128>().mul_wrap(d0.to<U128>())
        t_lo  : U64  = t.to_wrap<U64>()
        t_hi  : U64  = t.shr(64).to<U64>()
        p2    : U64  = p_fixed.add_wrap(t_hi)
        wrap2 : Bool = p2.lt(t_hi)
        over  : Bool = p2.gt(d1).bitor(t_lo.ge(d0))
        again : Bool = p2.ge(d1).bitand(over)
        down  : U64  = wrap2.to<U64>().add(wrap2.bitand(again).to<U64>())
        r     : U64  = v_fixed.sub_wrap(down)
        return(r)

/// Divides the 192-bit `(u2, u1, u0)` by the normalized 128-bit `divisor` by multiplying with its precomputed reciprocal (Moller and Granlund).
/// :param u2: The top limb of the dividend.
/// :param u1: The middle limb of the dividend.
/// :param u0: The low limb of the dividend.
/// :param divisor: The divisor, its high limb's top bit set, with the reciprocal from `reciprocal_3by2` of its limbs.
/// :returns: The 64-bit quotient and the 128-bit remainder.
/// :note: Needs the divisor's top bit set and `(u2, u1) < divisor`. Defined on every target.
routine div_3by2_mg(u2: U64, u1: U64, u0: U64, divisor: Divisor3By2) -> Div3By2
    block entry()
        d1       : U64  = divisor.high
        d0       : U64  = divisor.low
        v        : U64  = divisor.reciprocal
        d_high   : U128 = d1.to<U128>().shl(64)
        d        : U128 = d_high.bitor(d0.to<U128>())
        vu2      : U128 = v.to<U128>().mul_wrap(u2.to<U128>())
        u2_high  : U128 = u2.to<U128>().shl(64)
        u_top    : U128 = u2_high.bitor(u1.to<U128>())
        q        : U128 = vu2.add_wrap(u_top)
        q_lo     : U64  = q.to_wrap<U64>()
        q_hi     : U64  = q.shr(64).to<U64>()
        r1       : U64  = u1.sub_wrap(q_hi.mul_wrap(d1))
        t        : U128 = d0.to<U128>().mul_wrap(q_hi.to<U128>())
        r1_high  : U128 = r1.to<U128>().shl(64)
        r_window : U128 = r1_high.bitor(u0.to<U128>())
        r        : U128 = r_window.sub_wrap(t).sub_wrap(d)
        r_hi     : U64  = r.shr(64).to<U64>()
        qq       : U64  = q_hi.add_wrap(1)
        back     : Bool = r_hi.ge(q_lo)
        qq2      : U64  = back
            ? qq.sub_wrap(1)
            : qq
        rr : U128 = back
            ? r.add_wrap(d)
            : r
        over : Bool = rr.ge(d)
        qq3  : U64  = over
            ? qq2.add_wrap(1)
            : qq2
        rr2 : U128 = over
            ? rr.sub_wrap(d)
            : rr
        res : Div3By2 = Div3By2 { quotient: qq3, remainder: rr2 }
        return(res)

/// Divides the 128-bit `(u1, u0)` by the normalized 64-bit `d` by multiplying with the precomputed reciprocal `v` (Algorithm 4 of the Moller and Granlund paper).
/// :param u1: The high limb of the dividend, which must be below `d`.
/// :param u0: The low limb of the dividend.
/// :param d: The divisor, with its top bit set.
/// :param v: The reciprocal from `reciprocal_2by1(d)`.
/// :returns: The 64-bit quotient and remainder.
/// :note: Needs `u1 < d`. Defined on every target.
routine div_2by1_mg(u1: U64, u0: U64, d: U64, v: U64) -> Div2By1
    block entry()
        u1_high : U128 = u1.to<U128>().shl(64)
        u       : U128 = u1_high.bitor(u0.to<U128>())
        vu1     : U128 = v.to<U128>().mul_wrap(u1.to<U128>())
        q       : U128 = vu1.add_wrap(u)
        q_lo    : U64  = q.to_wrap<U64>()
        q_top   : U64  = q.shr(64).to<U64>()
        q_hi    : U64  = q_top.add_wrap(1)
        r       : U64  = u0.sub_wrap(q_hi.mul_wrap(d))
        // The estimate is at most one too big (r wrapped above q_lo) or one too small (r >= d).
        back : Bool = r.gt(q_lo)
        q2   : U64  = back
            ? q_hi.sub_wrap(1)
            : q_hi
        r2 : U64 = back
            ? r.add_wrap(d)
            : r
        over : Bool = r2.ge(d)
        q3   : U64  = over
            ? q2.add_wrap(1)
            : q2
        r3 : U64 = over
            ? r2.sub_wrap(d)
            : r2
        res : Div2By1 = Div2By1 { quotient: q3, remainder: r3 }
        return(res)

// -- divq ----------------------------------------------------------------------

/// Divides `hi × 2^64 + lo` by `d` with x86's `divq`, which gives the quotient and the remainder together.
/// :param hi: The high limb of the dividend, which must be below `d`.
/// :param lo: The low limb of the dividend.
/// :param d: The divisor.
/// :returns: The quotient and the remainder, in that order.
/// :note: Needs `hi < d`. `divq` faults (#DE) when the quotient doesn't fit in 64 bits.
/// :note: Not #pure. {div_3by2_divq} guards it with a branch, and a faulting instruction moved ahead of that branch
///     would fault on the path that never runs it.
#[target(arch: "x86_64"), external("asm"), clobbers(FLAGS)]
routine divq(hi: U64 = R2, lo: U64 = R0, d: U64) -> (U64, U64)
    block entry()
        div<U64>(d)  // div <d's register>: RDX:RAX / d
        return({ R0, R2 })  // RAX = quotient, RDX = remainder

/// Divides the 192-bit `(u2, u1, u0)` by the normalized 128-bit `divisor` on x86_64: `divq` estimates the quotient from `(u2, u1)` and the divisor's high limb, and Knuth's test against its low limb corrects it.
/// :param u2: The top limb of the dividend.
/// :param u1: The middle limb of the dividend.
/// :param u0: The low limb of the dividend.
/// :param divisor: The divisor, its high limb's top bit set. Its reciprocal is not used.
/// :returns: The 64-bit quotient and the 128-bit remainder.
/// :note: Same preconditions as {div_3by2_mg}.
#target(arch: "x86_64")
routine div_3by2_divq(u2: U64, u1: U64, u0: U64, divisor: Divisor3By2) -> Div3By2
    shared d1 : U64 = divisor.high
    shared d0 : U64 = divisor.low

    block entry()
        // (u2, u1) < (d1, d0) leaves u2 <= d1. When equal, divq would fault.
        top : Bool = u2.eq(d1)
        branch top
            ? saturated()
            : estimate()

    block estimate()
        // rhat = (u2, u1) - q × d1, the remainder divq gives with q
        q, rhat = divq(u2, u1, d1)
        jump check(q, rhat.to<U128>())

    // q = 2^64 - 1, and rhat = (u2, u1) - q × d1 = u1 + d1, which may carry
    block saturated()
        rhat : U128 = u1.to<U128>().add(d1.to<U128>())
        jump check(U64.MAX, rhat)

    // Knuth's test: while q × d0 > (rhat, u0), q is one too big. Runs at most twice.
    block check(q: U64, rhat: U128)
        carried : Bool = rhat.ge(18446744073709551616)  // 2^64: the test can't fail
        lhs     : U128 = q.to<U128>().mul_wrap(d0.to<U128>())
        rhs     : U128 = rhat.shl(64).bitor(u0.to<U128>())
        too_big : Bool = carried.bitnot().bitand(lhs.gt(rhs))
        branch too_big
            ? check(q.sub_wrap(1), rhat.add(d1.to<U128>()))
            : done(q)

    // The remainder is below 2^128, so the low 128 bits of the subtraction suffice.
    block done(q: U64)
        d_high  : U128    = d1.to<U128>().shl(64)
        d       : U128    = d_high.bitor(d0.to<U128>())
        u1_high : U128    = u1.to<U128>().shl(64)
        low     : U128    = u1_high.bitor(u0.to<U128>())
        r       : U128    = low.sub_wrap(d.mul_wrap(q.to<U128>()))
        res     : Div3By2 = Div3By2 { quotient: q, remainder: r }
        return(res)

/// Divides the 128-bit `(u1, u0)` by the 64-bit `d` with one `divq` on x86_64.
/// :param u1: The high limb of the dividend, which must be below `d`.
/// :param u0: The low limb of the dividend.
/// :param d: The divisor.
/// :returns: The 64-bit quotient and remainder.
/// :note: Needs `u1 < d`, or the instruction faults.
#target(arch: "x86_64")
routine div_2by1_divq(u1: U64, u0: U64, d: U64) -> Div2By1
    block entry()
        q, r = divq(u1, u0, d)
        res : Div2By1 = Div2By1 { quotient: q, remainder: r }
        return(res)

// -- by target -----------------------------------------------------------------

/// The per-divisor value to pass as `v` to `div_2by1` for the normalized divisor `d`: the reciprocal on targets without a 128 / 64 divide, and an unused 0 on x86_64.
/// :param d: The normalized divisor, with its top bit set.
/// :returns: The reciprocal to pass to `div_2by1`, or 0 on x86_64 where it is unused.
#target(arch: "x86_64")
routine div_2by1_prepare(d: U64) -> U64
    block entry()
        return(0)

/// The per-divisor value to pass as `v` to `div_2by1` for the normalized divisor `d`: the reciprocal on targets without a 128 / 64 divide, and an unused 0 on x86_64.
/// :param d: The normalized divisor, with its top bit set.
/// :returns: The reciprocal to pass to `div_2by1`, or 0 on x86_64 where it is unused.
#target(arch: not "x86_64")
routine div_2by1_prepare(d: U64) -> U64
    block entry()
        v : U64 = reciprocal_2by1(d)
        return(v)

/// Divides the 128-bit `(u1, u0)` by the normalized 64-bit `d`, with `v` from `div_2by1_prepare(d)`. Uses `divq` on x86_64 and the reciprocal elsewhere.
/// :param u1: The high limb of the dividend, which must be below `d`.
/// :param u0: The low limb of the dividend.
/// :param d: The normalized divisor, with its top bit set.
/// :param v: The value from `div_2by1_prepare(d)`.
/// :returns: The 64-bit quotient and remainder.
/// :note: Needs `u1 < d`.
#target(arch: "x86_64")
routine div_2by1(u1: U64, u0: U64, d: U64, v: U64) -> Div2By1
    block entry()
        r : Div2By1 = div_2by1_divq(u1, u0, d)
        return(r)

/// Divides the 128-bit `(u1, u0)` by the normalized 64-bit `d`, with `v` from `div_2by1_prepare(d)`. Uses `divq` on x86_64 and the reciprocal elsewhere.
/// :param u1: The high limb of the dividend, which must be below `d`.
/// :param u0: The low limb of the dividend.
/// :param d: The normalized divisor, with its top bit set.
/// :param v: The value from `div_2by1_prepare(d)`.
/// :returns: The 64-bit quotient and remainder.
/// :note: Needs `u1 < d`.
#target(arch: not "x86_64")
routine div_2by1(u1: U64, u0: U64, d: U64, v: U64) -> Div2By1
    block entry()
        r : Div2By1 = div_2by1_mg(u1, u0, d, v)
        return(r)

/// Prepares the normalized divisor `(d1, d0)` for `div_3by2`: its limbs, with the reciprocal on targets without a 128 / 64 divide, and an unused 0 on x86_64.
/// :param d1: The high limb of the divisor, with its top bit set.
/// :param d0: The low limb of the divisor.
/// :returns: The divisor to pass to `div_3by2`, its reciprocal 0 on x86_64 where it is unused.
#target(arch: "x86_64")
routine div_3by2_prepare(d1: U64, d0: U64) -> Divisor3By2
    block entry()
        return(Divisor3By2 { high: d1, low: d0, reciprocal: 0 })

/// Prepares the normalized divisor `(d1, d0)` for `div_3by2`: its limbs, with the reciprocal on targets without a 128 / 64 divide, and an unused 0 on x86_64.
/// :param d1: The high limb of the divisor, with its top bit set.
/// :param d0: The low limb of the divisor.
/// :returns: The divisor to pass to `div_3by2`, with its reciprocal.
#target(arch: not "x86_64")
routine div_3by2_prepare(d1: U64, d0: U64) -> Divisor3By2
    block entry()
        v : U64 = reciprocal_3by2(d1, d0)
        return(Divisor3By2 { high: d1, low: d0, reciprocal: v })

/// Divides the 192-bit `(u2, u1, u0)` by the normalized 128-bit `divisor` from `div_3by2_prepare`. Uses `divq` on x86_64 and the reciprocal elsewhere.
/// :param u2: The top limb of the dividend.
/// :param u1: The middle limb of the dividend.
/// :param u0: The low limb of the dividend.
/// :param divisor: The divisor from `div_3by2_prepare`.
/// :returns: The 64-bit quotient and the 128-bit remainder.
/// :note: Needs the divisor's top bit set and `(u2, u1) < divisor`, so the quotient fits in 64 bits.
#target(arch: "x86_64")
routine div_3by2(u2: U64, u1: U64, u0: U64, divisor: Divisor3By2) -> Div3By2
    block entry()
        r : Div3By2 = div_3by2_divq(u2, u1, u0, divisor)
        return(r)

/// Divides the 192-bit `(u2, u1, u0)` by the normalized 128-bit `divisor` from `div_3by2_prepare`. Uses `divq` on x86_64 and the reciprocal elsewhere.
/// :param u2: The top limb of the dividend.
/// :param u1: The middle limb of the dividend.
/// :param u0: The low limb of the dividend.
/// :param divisor: The divisor from `div_3by2_prepare`.
/// :returns: The 64-bit quotient and the 128-bit remainder.
/// :note: Needs the divisor's top bit set and `(u2, u1) < divisor`, so the quotient fits in 64 bits.
#target(arch: not "x86_64")
routine div_3by2(u2: U64, u1: U64, u0: U64, divisor: Divisor3By2) -> Div3By2
    block entry()
        r : Div3By2 = div_3by2_mg(u2, u1, u0, divisor)
        return(r)
