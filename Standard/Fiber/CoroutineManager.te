### Whether the work has finished, without waiting: true once it has, and for a ticket with no work.
### :returns: True unless the work runs.
@target(os: not "none")
@track_caller
routine Fiber[T].check_finished() -> Bool
needs T: typename
    return me.work_slot().is_finished()

### Makes the next `retrieve()` wait at most `timeout`: `t.waitfor(5s).retrieve()` throws `TaskTimeoutError` when the
### work hasn't finished by then.
### :param timeout: The longest wait, from now.
### :returns: The ticket, for its `retrieve()`.
@target(os: not "none")
@track_caller
routine Fiber[T].waitfor(timeout: Duration) -> Me
needs T: typename
    me.work_slot().set_deadline(timeout)
    return me

### The wait of `retrieve()`, the way a slot's `wait_to_retrieve` waits, except on the thread that drives the manager,
### outside a fiber: there the manager runs its fibers until the work is done or the deadline `waitfor` set has passed.
### :returns: `WAITED_FINISHED`, `WAITED_TIMED_OUT` or `WAITED_CANCELLED`.
@target(os: not "none")
@track_caller
secret routine Fiber[T].wait_to_retrieve() -> U32
needs T: typename
    slot: @WorkSlot = me.work_slot()
    fiber: @FiberState = me.fiber
    manager: @CoroutineManager = fiber.manager.peek()

    if not manager.drives_here()
        return slot.wait_to_retrieve()
    deadline: Duration = slot.deadline.peek()
    slot.deadline.poke(Duration.MAX)
    manager.drive(awaited: slot, deadline, idle_only: false)
    if slot.is_finished()
        return WAITED_FINISHED
    return WAITED_TIMED_OUT

### Waits until the work has finished, and checks that it wasn't cancelled: work with no result. Inside a fiber only
### that fiber waits. Outside one, on the thread that drives the manager, the manager runs its fibers until the work is
### done. On another thread, that thread sleeps.
### :throws: Crashes with `NoWorkError` when there was none. Throws `TaskTimeoutError` when the deadline `waitfor` set
###     passed first, and `CancelRequested` when `cancel()` asked the work to stop before it finished, or asked the
###     work that waits to stop while it waits.
@target(os: not "none")
@track_caller
failable routine Fiber[None].retrieve() -> None
    waited: U32 = me.wait_to_retrieve()
    slot: @WorkSlot = me.work_slot()
    if waited == WAITED_TIMED_OUT
        throw TaskTimeoutError()
    if waited == WAITED_CANCELLED
        throw CancelRequested()
    slot.result_place[Byte]()
    if slot.is_cancelled()
        throw CancelRequested()
    return

### Waits until the work has finished, and gives its result. Inside a fiber only that fiber waits. Outside one, on the
### thread that drives the manager, the manager runs its fibers until the work is done. On another thread, that thread
### sleeps.
### :returns: The result.
### :throws: Crashes with `NoWorkError` when there was none. Throws `TaskTimeoutError` when the deadline `waitfor` set
###     passed first, and `CancelRequested` when `cancel()` asked the work to stop before it finished, or asked the
###     work that waits to stop while it waits.
@target(os: not "none")
@track_caller
failable routine Fiber[T].retrieve() -> T
needs T: typename
    waited: U32 = me.wait_to_retrieve()
    slot: @WorkSlot = me.work_slot()
    if waited == WAITED_TIMED_OUT
        throw TaskTimeoutError()
    if waited == WAITED_CANCELLED
        throw CancelRequested()
    place: @T = slot.result_place[T]()
    if slot.is_cancelled()
        throw CancelRequested()
    return place.peek()

### Asks the work to stop: `cancel_requested()` turns true inside it, and the work stops where it looks.
@target(os: not "none")
@track_caller
routine Fiber[T].cancel() -> None
needs T: typename
    me.work_slot().request_cancel()
    return

# -- driving ----------------------------------------------------------------------------------------------------

### Whether a wait for one of this manager's fibers on this thread should drive the manager: the code isn't a fiber,
### and this is the thread that drives it.
### :returns: True to drive it.
@target(os: not "none")
secret routine @CoroutineManager.drives_here() -> Bool
    if current_waiter().is_fiber()
        return false
    return thread_mark() === me.owner.peek_unbroken()

### Runs the fibers on this thread until `awaited` has finished (when not null), or no fiber has work left (when it is
### null), or `deadline` has passed. With `idle_only` it returns as soon as no fiber is ready.
### :param awaited: The work to run until, or null.
### :param deadline: When to stop, in `Clock.monotonic()` time (`Duration.MAX` for never).
### :param idle_only: True to return once no fiber is ready.
@target(os: not "none")
@reshaping
secret routine @CoroutineManager.drive(awaited: @WorkSlot, deadline: Duration,
    idle_only: Bool) -> None
    me.owner.poke_unbroken(thread_mark())

    loop
        if awaited.is_hollow()
            if me.busy.peek_unbroken() == 0
                return
        elseif awaited.is_finished()
            return
        # Reads the wake word before looking, so a fiber put in the inbox in between changes it and the wait returns.
        seen: U32 = me.wake_word().peek_unbroken()
        me.fire_timers()
        me.take_inbox()
        if me.ready.is_empty()
            if idle_only
                return
            now: Duration = Clock.monotonic()
            if now >= deadline
                return
            wait: Duration = me.timer_wait().min(deadline - now)
            if wait == Duration.MAX
                wait_on(at: me.wake_word(), expected: seen)
                continue
            wait_on_for(at: me.wake_word(), expected: seen, timeout: wait)
            continue
        me.resume(me.ready.remove_first())
        continue

### Runs fiber until it stops. One that stopped goes where it waits (its then): its manager does that on its own
### stack, after the fiber has switched away from its.
### :param fiber: The fiber to run.
@target(os: not "none")
secret routine @CoroutineManager.resume(fiber: @FiberState) -> None
    me.current.poke(fiber)
    outer_fiber: Waiter = RUNNING_FIBER.peek()
    outer_work: @WorkSlot = RUNNING_WORK.peek()
    RUNNING_FIBER.poke(Waiter(fiber, manager: me, park_fn: park_hook.to[Callable](),
        wake_fn: wake_hook.to[Callable]()))
    RUNNING_WORK.poke(fiber.work.peek())
    # The fiber's crash trace depth goes in while it runs and comes back out with it, and the thread's own stays as
    # it was.
    own: U64 = trace_switch(fiber.trace_depth.peek())
    # The AccessManager sees the fiber as the flow running here while it runs.
    outer_flow: @@AccessFlow = AccessManager.switch_flow(fiber.access)
    # The running flow's StackManager is the fiber's while it runs.
    outer_stack: @StackManager = RUNNING_STACK.peek()
    RUNNING_STACK.poke(fiber.stack)
    me.home_race.poke(race_stack_current())
    race_stack_switch(fiber.race.peek())
    # The fiber's stack pointer is the CPU's while it runs, and its switch away writes it back.
    resume_at: Addr = fiber.stack.sp.peek()
    fiber.stack.sp.poke(.hollow())
    switch_stack(from: me.home, to: resume_at)
    RUNNING_STACK.poke(outer_stack)
    trace_switch(own).poke_into(fiber.trace_depth)
    AccessManager.switch_flow(outer_flow)
    RUNNING_FIBER.poke(outer_fiber)
    RUNNING_WORK.poke(outer_work)
    me.current.poke(.hollow())
    then: Callable[(@Me, @FiberState), None] = fiber.then.peek()
    fiber.then.poke(requeue.to[Callable]())
    then.call(me, fiber)
    return

### A fiber's first routine: switch_stack returns into it on the fiber's new stack. It runs each piece of work put on
### its slot, marks it finished, and goes back to its manager until the next.
@noreturn
@target(os: not "none")
secret routine fiber_start() -> None
    # Read once: the routine runs on this one fiber's stack for good, and a pool's fiber may go on on another thread,
    # where this thread's RUNNING_FIBER is another fiber's.
    fiber: @FiberState = current_waiter().fiber.to[@FiberState]()
    loop
        slot: @WorkSlot = fiber.work.peek()
        runner: Callable[(Addr,), None] = slot.runner.peek()
        runner.call(slot.work.peek())
        slot.complete()
        if slot !== fiber.slot
            # A passable fiber's slot: the fiber's own work is over too.
            fiber.work.poke(fiber.slot)
            fiber.slot.complete()
        # Read last: the work and the completes may park, and a pool's fiber may go on on another thread after that.
        manager: @CoroutineManager = fiber.manager.peek()
        manager.busy.unbroken_fetch_sub(1)
        fiber.then.poke(commit_idle.to[Callable]())
        race_stack_switch(manager.home_race.peek())
        switch_stack(from: fiber.stack.sp, to: manager.home.peek())

### fiber is ready: in the ready queue on the manager's thread, else in its inbox, waking the thread. A pool's fiber
### goes to its pool instead, for whichever of the pool's threads is free first.
### :param fiber: The fiber to queue.
@target(os: not "none")
@reshaping
secret routine @CoroutineManager.place_ready(fiber: @FiberState) -> None
    pool: @ThreadPoolManager = fiber.pool.peek()
    if pool.is_not_hollow()
        pool.queue_woken(fiber)
        return
    if thread_mark() === me.owner.peek_unbroken()
        me.ready.add_last(fiber)
        return
    held: Authorized[U8] <- me.inbox_guard.get_exclusive_access()
    me.inbox.add_last(fiber)
    drop held
    word: @U32 = me.wake_word()
    word.unbroken_fetch_add(1)
    wake_all(word)
    return

### Moves the fibers in the inbox to the ready queue.
@target(os: not "none")
@reshaping
secret routine @CoroutineManager.take_inbox() -> None
    held: Authorized[U8] <- me.inbox_guard.get_exclusive_access()

    until me.inbox.is_empty()
        me.ready.add_last(me.inbox.remove_first())
    drop held
    return

### Wakes the fibers whose deadline has come. A timer whose fiber went on before it (its number is no longer the
### fiber's) wakes nothing.
@target(os: not "none")
@reshaping
secret routine @CoroutineManager.fire_timers() -> None
    now: Duration = Clock.monotonic()

    until me.timers.is_empty()
        key: TimerKey = me.timers.first_entry().priority
        if not (key.deadline <= now)
            return
        fiber: @FiberState = me.timers.remove()
        if fiber.timer.peek_unbroken() == key.seq
            me.wake(fiber)
    then
        return

### How long the thread may sleep: until the earliest timer is due, or Duration.MAX for no limit.
### :returns: The time until the earliest deadline (0 when it has passed), or `Duration.MAX`.
@target(os: not "none")
secret routine @CoroutineManager.timer_wait() -> Duration
    if me.timers.is_empty()
        return Duration.MAX
    deadline: Duration = me.timers.first_entry().priority.deadline
    return deadline -^ Clock.monotonic()

# -- where a stopped fiber goes ---------------------------------------------------------------------------------
#
# Each of these runs on the manager's stack, after the fiber has switched away from its own.

### A yield: behind the other ready fibers.
### :param manager: The manager.
### :param fiber: The fiber that stopped.
@target(os: not "none")
@reshaping(manager)
secret routine requeue(manager: @CoroutineManager, fiber: @FiberState) -> None
    manager.ready.add_last(fiber)
    return

### A park: parked, unless a wake came while it stopped.
### :param manager: The manager.
### :param fiber: The fiber that stopped.
@target(os: not "none")
@reshaping(manager)
secret routine commit_park(manager: @CoroutineManager, fiber: @FiberState) -> None
    if compare_exchange(at: fiber.wake_state, expected: FIBER_PARKING, new: FIBER_PARKED)
        return
    fiber.wake_state.poke_unbroken(FIBER_RUNNING)
    requeue(manager, fiber)
    return

### Finished work: the fiber waits for the next, which `put_work` queues it for. A wake meant for the old work is
### dropped.
### :param manager: The manager.
### :param fiber: The fiber that stopped.
@target(os: not "none")
secret routine commit_idle(manager: @CoroutineManager, fiber: @FiberState) -> None
    fiber.wake_state.poke_unbroken(FIBER_RUNNING)
    pool: @ThreadPoolManager = fiber.pool.peek()
    if pool.is_not_hollow()
        pool.keep_fiber(fiber)
    return

### How a Waiter parks a fiber of a manager: until a wake, or a deadline other than Duration.MAX. The fiber parks
### through the manager running it now, which is the Waiter's own unless a pool's fiber went on on another thread.
### :param manager: The manager the Waiter was made with.
### :param deadline: When the fiber goes on without a wake, or `Duration.MAX`.
@target(os: not "none")
@reshaping(manager)
secret routine park_hook(manager: Addr, deadline: Duration) -> None
    fibers: @CoroutineManager = RUNNING_FIBER.peek().manager.to[@CoroutineManager]()

    if deadline == Duration.MAX
        fibers.park()
        return
    fibers.park_until(deadline)
    return

### How a Waiter wakes a fiber of a manager: through the manager running the fiber now, which is the Waiter's own
### unless a pool's fiber went on on another thread.
### :param manager: The manager the Waiter was made with.
### :param fiber: The fiber.
@target(os: not "none")
@reshaping(manager)
secret routine wake_hook(manager: Addr, fiber: Addr) -> None
    state: @FiberState = fiber.to[@FiberState]()
    fibers: @CoroutineManager = state.manager.peek_unbroken()
    fibers.wake(state)
    return

### A thread outside a fiber waits until deadline.
### :param deadline: When to stop waiting, in `Clock.monotonic()` time.
@target(os: not "none")
secret routine sleep_thread(deadline: Duration) -> None
    never: &U32 <- 0

    loop
        now2: Duration = Clock.monotonic()
        if now2 >= deadline
            return
        wait_on_for(at: never, expected: 0, timeout: deadline - now2)

### Writes new at at if expected is there, and says whether it did.
### :param at: The place.
### :param expected: The value it must hold.
### :param new: The value to write.
### :returns: True when it wrote `new`.
@target(os: not "none")
secret routine compare_exchange(at: @U32, expected: U32, new: U32) -> Bool
    previous: &U32 <- 0

    return at.unbroken_compare_exchange_raw(expected, new, previous)
