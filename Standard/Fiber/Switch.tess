// Tessera stdlib: switching between fiber stacks
//
// switch_stack saves the registers the calling convention keeps across a call
// on the current stack, stores the stack pointer through from, loads to,
// restores the registers saved there and returns into that stack. A new stack
// starts with a frame laid out the same way, whose return address is the
// fiber's first routine (initial_stack).
//
// It is written for System V and Windows x86-64 and for AArch64 outside
// Windows. On any other target a program that switches fibers fails to link,
// on tessera_fibers_unsupported_on_this_target.

module Standard::Fiber

/// System V x86-64: from arrives in RDI, to in RSI. RBX, RBP and R12 to R15 are the caller's.
#[target(arch: "x86_64", os: not "windows"), external("asm"), naked]
routine switch_stack(from: @Addr = R7, to: Addr = R6) -> Void
    block entry()
        push<U64>(R5)  // push rbp
        push<U64>(R3)  // push rbx
        push<U64>(R12)  // push r12
        push<U64>(R13)  // push r13
        push<U64>(R14)  // push r14
        push<U64>(R15)  // push r15
        mov<U64, U64>(from.offset(0), SP)  // mov qword ptr [rdi], rsp
        mov<U64, U64>(SP, to)  // mov rsp, rsi
        pop<U64>(R15)  // pop r15
        pop<U64>(R14)  // pop r14
        pop<U64>(R13)  // pop r13
        pop<U64>(R12)  // pop r12
        pop<U64>(R3)  // pop rbx
        pop<U64>(R5)  // pop rbp
        return()  // ret

/// Windows x64: from arrives in RCX, to in RDX. RBX, RBP, RDI, RSI, R12 to R15 and XMM6 to XMM15 are the
/// caller's, and the thread block's stack fields follow the stack: its base and limit (GS:[8], GS:[16]), which
/// probes of a large frame check, and the bottom of its reservation (DeallocationStack, GS:[0x1478]), which Windows
/// checks when the stack grows into its guard page. A pad word keeps the frame's alignment.
#[target(arch: "x86_64", os: "windows"), external("asm"), naked]
routine switch_stack(from: @Addr = R1, to: Addr = R2) -> Void
    block entry()
        push<U64>(R5)  // push rbp
        push<U64>(R3)  // push rbx
        push<U64>(R7)  // push rdi
        push<U64>(R6)  // push rsi
        push<U64>(R12)  // push r12
        push<U64>(R13)  // push r13
        push<U64>(R14)  // push r14
        push<U64>(R15)  // push r15
        mov<U64, U64>(R0, GS.offset(8))  // mov rax, gs:[8]
        push<U64>(R0)  // push rax
        mov<U64, U64>(R0, GS.offset(16))  // mov rax, gs:[16]
        push<U64>(R0)  // push rax
        mov<U64, U64>(R0, GS.offset(0x1478))  // mov rax, gs:[0x1478]
        push<U64>(R0)  // push rax
        push<U64>(R0)  // push rax (the pad)
        sub<U64>(SP, 160)  // sub rsp, 160
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(0), V6)  // movdqu [rsp], xmm6
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(16), V7)  // movdqu [rsp + 16], xmm7
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(32), V8)  // movdqu [rsp + 32], xmm8
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(48), V9)  // movdqu [rsp + 48], xmm9
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(64), V10)  // movdqu [rsp + 64], xmm10
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(80), V11)  // movdqu [rsp + 80], xmm11
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(96), V12)  // movdqu [rsp + 96], xmm12
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(112), V13)  // movdqu [rsp + 112], xmm13
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(128), V14)  // movdqu [rsp + 128], xmm14
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(SP.offset(144), V15)  // movdqu [rsp + 144], xmm15
        mov<U64, U64>(from.offset(0), SP)  // mov qword ptr [rcx], rsp
        mov<U64, U64>(SP, to)  // mov rsp, rdx
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V6, SP.offset(0))  // movdqu xmm6, [rsp]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V7, SP.offset(16))  // movdqu xmm7, [rsp + 16]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V8, SP.offset(32))  // movdqu xmm8, [rsp + 32]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V9, SP.offset(48))  // movdqu xmm9, [rsp + 48]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V10, SP.offset(64))  // movdqu xmm10, [rsp + 64]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V11, SP.offset(80))  // movdqu xmm11, [rsp + 80]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V12, SP.offset(96))  // movdqu xmm12, [rsp + 96]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V13, SP.offset(112))  // movdqu xmm13, [rsp + 112]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V14, SP.offset(128))  // movdqu xmm14, [rsp + 128]
        movdqu<Vector<U8, 16>, Vector<U8, 16>>(V15, SP.offset(144))  // movdqu xmm15, [rsp + 144]
        add<U64>(SP, 160)  // add rsp, 160
        pop<U64>(R0)  // pop rax (the pad)
        pop<U64>(R0)  // pop rax
        mov<U64, U64>(GS.offset(0x1478), R0)  // mov gs:[0x1478], rax
        pop<U64>(R0)  // pop rax
        mov<U64, U64>(GS.offset(16), R0)  // mov gs:[16], rax
        pop<U64>(R0)  // pop rax
        mov<U64, U64>(GS.offset(8), R0)  // mov gs:[8], rax
        pop<U64>(R15)  // pop r15
        pop<U64>(R14)  // pop r14
        pop<U64>(R13)  // pop r13
        pop<U64>(R12)  // pop r12
        pop<U64>(R6)  // pop rsi
        pop<U64>(R7)  // pop rdi
        pop<U64>(R3)  // pop rbx
        pop<U64>(R5)  // pop rbp
        return()  // ret

/// AArch64: from arrives in X0, to in X1. X19 to X28, the frame pointer, the link register (the return address)
/// and D8 to D15 are the caller's.
#[target(arch: "aarch64", os: not "windows"), external("asm"), naked]
routine switch_stack(from: @Addr = R0, to: Addr = R1) -> Void
    block entry()
        stp<F64, F64, U64>(V8, V9, SP.offset(-16).update())  // stp d8, d9, [sp, #-16]!
        stp<F64, F64, U64>(V10, V11, SP.offset(-16).update())  // stp d10, d11, [sp, #-16]!
        stp<F64, F64, U64>(V12, V13, SP.offset(-16).update())  // stp d12, d13, [sp, #-16]!
        stp<F64, F64, U64>(V14, V15, SP.offset(-16).update())  // stp d14, d15, [sp, #-16]!
        stp<U64, U64, U64>(R19, R20, SP.offset(-16).update())  // stp x19, x20, [sp, #-16]!
        stp<U64, U64, U64>(R21, R22, SP.offset(-16).update())  // stp x21, x22, [sp, #-16]!
        stp<U64, U64, U64>(R23, R24, SP.offset(-16).update())  // stp x23, x24, [sp, #-16]!
        stp<U64, U64, U64>(R25, R26, SP.offset(-16).update())  // stp x25, x26, [sp, #-16]!
        stp<U64, U64, U64>(R27, R28, SP.offset(-16).update())  // stp x27, x28, [sp, #-16]!
        stp<U64, U64, U64>(FP, LR, SP.offset(-16).update())  // stp x29, x30, [sp, #-16]!
        mov<U64, U64>(R9, SP)  // mov x9, sp
        str<U64, U64>(R9, from.offset(0))  // str x9, [x0]
        mov<U64, U64>(SP, to)  // mov sp, x1
        ldp<U64, U64, U64>(FP, LR, SP.after_offset(16))  // ldp x29, x30, [sp], #16
        ldp<U64, U64, U64>(R27, R28, SP.after_offset(16))  // ldp x27, x28, [sp], #16
        ldp<U64, U64, U64>(R25, R26, SP.after_offset(16))  // ldp x25, x26, [sp], #16
        ldp<U64, U64, U64>(R23, R24, SP.after_offset(16))  // ldp x23, x24, [sp], #16
        ldp<U64, U64, U64>(R21, R22, SP.after_offset(16))  // ldp x21, x22, [sp], #16
        ldp<U64, U64, U64>(R19, R20, SP.after_offset(16))  // ldp x19, x20, [sp], #16
        ldp<F64, F64, U64>(V14, V15, SP.after_offset(16))  // ldp d14, d15, [sp], #16
        ldp<F64, F64, U64>(V12, V13, SP.after_offset(16))  // ldp d12, d13, [sp], #16
        ldp<F64, F64, U64>(V10, V11, SP.after_offset(16))  // ldp d10, d11, [sp], #16
        ldp<F64, F64, U64>(V8, V9, SP.after_offset(16))  // ldp d8, d9, [sp], #16
        return()  // ret

/// Every other target: a program that switches fibers fails to link, naming why.
#[external("c"), symbol("tessera_fibers_unsupported_on_this_target"),
    target(arch: not ("x86_64", "aarch64"))]
routine switch_stack(from: @Addr, to: Addr) -> Void

/// Declared for a target without fiber support: a program that switches fibers fails to link, naming the unsupported
/// target.
/// :param from: Where the current stack pointer would be saved.
/// :param to: The stack pointer to resume.
#[external("c"), symbol("tessera_fibers_unsupported_on_this_target"),
    target(arch: "aarch64", os: "windows")]
routine switch_stack(from: @Addr, to: Addr) -> Void

// -- a new stack ---------------------------------------------------------------------

/// What VirtualQuery says about a range of pages (MEMORY_BASIC_INFORMATION on 64-bit Windows).
#target(arch: "x86_64", os: "windows")
private record PageRange
    base               : Addr
    allocation_base    : Addr
    allocation_protect : U32
    partition          : U16
    pad                : U16
    size               : USize
    state              : U32
    protect            : U32
    type               : U32
    pad2               : U32

/// The words a new stack starts with, below its 16-byte aligned top, as switch_stack restores them: the saved
/// registers (zero), the fiber's first routine where switch_stack returns, and on x86 the room above a return
/// address that a routine's entry expects (its own return address slot, and Windows' 32-byte home area).
#target(arch: "x86_64", os: not "windows")
private routine frame_words() -> USize
    block entry()
        return(8)

/// How many words the starting frame of a new stack holds on this target.
/// :returns: The number of 8-byte words.
#target(arch: "x86_64", os: "windows")
private routine frame_words() -> USize
    block entry()
        return(38)

/// How many words the starting frame of a new stack holds on this target.
/// :returns: The number of 8-byte words.
#target(arch: not "x86_64")
private routine frame_words() -> USize
    block entry()
        return(20)

/// The word of the frame switch_stack returns through.
#target(arch: "x86_64", os: not "windows")
private routine entry_word() -> USize
    block entry()
        return(6)

/// Which word of the starting frame a new stack's first routine goes in: where switch_stack returns.
/// :returns: The word index from the frame's start.
#target(arch: "x86_64", os: "windows")
private routine entry_word() -> USize
    block entry()
        return(32)

/// Which word of the starting frame a new stack's first routine goes in: where switch_stack returns.
/// :returns: The word index from the frame's start.
#target(arch: not "x86_64")
private routine entry_word() -> USize
    block entry()
        return(1)

/// Binds the Win32 `VirtualQuery` function.
#[external("c"), symbol("VirtualQuery"), callconv("stdcall"), target(arch: "x86_64", os: "windows")]
private routine c_virtual_query(addr: Addr, info: @PageRange, length: USize) -> USize

/// Windows checks a stack against the thread block's fields, which switch_stack restores from the frame: the
/// reservation's bottom (word 21), the limit (word 22), and the base (word 23). The limit is the bottom of the pages
/// committed at the top, which VirtualQuery gives: below it a stack allocator's guard page lets Windows grow the
/// stack, and memory committed all at once (another allocator) reads as one range. Elsewhere nothing follows the
/// stack.
#target(arch: "x86_64", os: "windows")
private routine store_bounds(sp: @U64, limit: U64, base: U64) -> Void
    block entry()
        claim info : @PageRange <- uninit
        c_virtual_query(inttoptr<U64, Addr>(base.sub(1)), info, 48)
        ptrtoint<Addr, U64>(info.allocation_base.load()).store_into(sp.stride(21))
        ptrtoint<Addr, U64>(info.base.load()).store_into(sp.stride(22))
        base.store_into(sp.stride(23))
        return()

/// Stores the stack bounds Windows checks into the starting frame (it does nothing on other targets, where nothing
/// follows the stack).
/// :param sp: The new stack's frame.
/// :param limit: The bottom of the stack.
/// :param base: The top of the stack.
#target(arch: not "x86_64")
private routine store_bounds(sp: @U64, limit: U64, base: U64) -> Void
    block entry()
        return()

/// Stores the stack bounds Windows checks into the starting frame (it does nothing on other targets, where nothing
/// follows the stack).
/// :param sp: The new stack's frame.
/// :param limit: The bottom of the stack.
/// :param base: The top of the stack.
#target(arch: "x86_64", os: not "windows")
private routine store_bounds(sp: @U64, limit: U64, base: U64) -> Void
    block entry()
        return()

/// A new stack of size bytes at stack: the stack pointer to switch to, at a frame that returns into entry.
routine initial_stack(stack: Addr, size: USize, entry: Addr) -> Addr
    shared bottom : U64   = ptrtoint<Addr, U64>(stack)
    shared top    : U64   = bottom.add(size.to<U64>()).bitand(0xFFFFFFFFFFFFFFF0)
    shared frame  : USize = frame_words()
    shared sp     : @U64  = inttoptr<U64, @U64>(top.sub(frame.mul(8).to<U64>()))

    block entry()
        jump clear(0)

    block clear(i: USize)
        done : Bool = i.eq(frame)
        branch done
            ? fill()
            : store_zero(i)

    block store_zero(i: USize)
        sp.stride(i).store(0)
        jump clear(i.add(1))

    block fill()
        sp.stride(entry_word()).store(ptrtoint<Addr, U64>(entry))
        store_bounds(sp, bottom, top)
        at : Addr = sp
        return(at)
