# Tessera stdlib: lists of fiber and job tickets
#
# Work spread over several fibers or ThreadPoolManager jobs keeps their tickets in a List[Fiber[T]] or a List[Job[T]], and
# these routines handle them together: wait for all, take every result, give all back, wait for whichever finishes
# first, cancel all, and take out or give back the ones that have finished.

module Standard/Fiber

import Standard/Collections
import Standard/Os

### Waits until the work of every fiber ticket in the list has finished.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].wait_all_finished() -> None
needs T: typename
    each i in 0 til me.count()
        me[i].wait_finished()
    then
        return

### The results of the fiber tickets' finished work, in the list's order, in a list from `manager`.
### :param manager: Where the list comes from.
### :returns: The results.
### :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].retrieve_all(manager: @MemoryManager) -> List[T]
needs T: typename
    local results: @List[T] <- .construct(manager)

    each i in 0 til me.count()
        results.add_last(me[i].retrieve())
    then
        return results

### The results of the fiber tickets' finished work, in the list's order, in a list from HEAP.
### :returns: The results.
### :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].retrieve_all() -> List[T]
needs T: typename
    return me.retrieve_all(manager: HEAP)

### Gives every fiber ticket in the list back, and empties the list.
### :throws: Crashes as each ticket's `give_back` does, when its work still runs.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].give_back_all() -> None
needs T: typename
    each i in 0 til me.count()
        me[i].give_back()
    me.clear()
    return

### Asks the work of every fiber ticket in the list to stop.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].cancel_all() -> None
needs T: typename
    each i in 0 til me.count()
        me[i].cancel()
    then
        return

### Waits until the work of one of the fiber tickets in the list has finished, and says which: the first in the list
### among those finished when it looks.
### :returns: The position of a ticket whose work has finished.
### :throws: Crashes with `InvalidValueError` for an empty list.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].wait_any_finished() -> U64
needs T: typename
    local waiter: Waiter = current_waiter()

    if me.count() == 0
        crash(name: "InvalidValueError",
            message: "wait_any_finished of an empty list waits for nothing.")
    # Each ticket keeps the waiter, so the first to finish wakes it: then it forgets every one.
    loop with i: U64 = 0
        values2: (U64, U64) = when
            i >= me.count() =>
                waiter.park()
                becomes (0, me.count())
            else =>
                if me[i].work_slot().register(waiter)
                    becomes (0, i)
                else
                    continue with i: i + 1
        k, result = values2

        each k2 in k til me.count()
            me[k2].work_slot().unregister(waiter)
        then
            # After a park, the tickets are looked at again.
            if result < me.count()
                return result
            continue with i: 0

### Takes the fiber tickets whose work has finished out of the list, into a list from `manager`, keeping the others
### in order.
### :param manager: Where the list of finished tickets comes from.
### :returns: The finished tickets, in the order they had.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].take_finished(manager: @MemoryManager) -> Me
needs T: typename
    local finished: @Me <- .construct(manager)

    each i in 0 til me.count() with kept: U64 = 0
        ticket: Fiber[T] = me[i]
        if ticket.check_finished()
            finished.add_last(ticket)
            continue with kept: kept
        me[kept] = ticket
        continue with kept: kept + 1
    then
        until me.count() <= kept
            removed: Fiber[T] = me.remove_last()
        then
            return finished

### Takes the fiber tickets whose work has finished out of the list, into a list from HEAP.
### :returns: The finished tickets, in the order they had.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].take_finished() -> Me
needs T: typename
    return me.take_finished(manager: HEAP)

### Gives back the fiber tickets whose work has finished, and takes them out of the list: for work whose result
### nobody needs.
@target(os: not "none")
@track_caller
routine @List[Fiber[T]].give_back_finished() -> None
needs T: typename
    each i in 0 til me.count() with kept: U64 = 0
        ticket: Fiber[T] = me[i]
        if ticket.check_finished()
            ticket.give_back()
            continue with kept: kept
        me[kept] = ticket
        continue with kept: kept + 1
    then
        until me.count() <= kept
            removed: Fiber[T] = me.remove_last()
        then
            return

### Waits until the work of every job ticket in the list has finished.
@target(os: not "none")
@track_caller
routine @List[Job[T]].wait_all_finished() -> None
needs T: typename
    each i in 0 til me.count()
        me[i].wait_finished()
    then
        return

### The results of the job tickets' finished work, in the list's order, in a list from `manager`.
### :param manager: Where the list comes from.
### :returns: The results.
### :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
@target(os: not "none")
@track_caller
routine @List[Job[T]].retrieve_all(manager: @MemoryManager) -> List[T]
needs T: typename
    local results: @List[T] <- .construct(manager)

    each i in 0 til me.count()
        results.add_last(me[i].retrieve())
    then
        return results

### The results of the job tickets' finished work, in the list's order, in a list from HEAP.
### :returns: The results.
### :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
@target(os: not "none")
@track_caller
routine @List[Job[T]].retrieve_all() -> List[T]
needs T: typename
    return me.retrieve_all(manager: HEAP)

### Gives every job ticket in the list back, and empties the list.
### :throws: Crashes as each ticket's `give_back` does, when its work still runs.
@target(os: not "none")
@track_caller
routine @List[Job[T]].give_back_all() -> None
needs T: typename
    each i in 0 til me.count()
        me[i].give_back()
    me.clear()
    return

### Asks the work of every job ticket in the list to stop.
@target(os: not "none")
@track_caller
routine @List[Job[T]].cancel_all() -> None
needs T: typename
    each i in 0 til me.count()
        me[i].cancel()
    then
        return

### Waits until the work of one of the job tickets in the list has finished, and says which: the first in the list
### among those finished when it looks.
### :returns: The position of a ticket whose work has finished.
### :throws: Crashes with `InvalidValueError` for an empty list.
@target(os: not "none")
@track_caller
routine @List[Job[T]].wait_any_finished() -> U64
needs T: typename
    local waiter: Waiter = current_waiter()

    if me.count() == 0
        crash(name: "InvalidValueError",
            message: "wait_any_finished of an empty list waits for nothing.")
    # Each ticket keeps the waiter, so the first to finish wakes it: then it forgets every one.
    loop with i: U64 = 0
        values2: (U64, U64) = when
            i >= me.count() =>
                waiter.park()
                becomes (0, me.count())
            else =>
                if me[i].work_slot().register(waiter)
                    becomes (0, i)
                else
                    continue with i: i + 1
        k, result = values2

        each k2 in k til me.count()
            me[k2].work_slot().unregister(waiter)
        then
            # After a park, the tickets are looked at again.
            if result < me.count()
                return result
            continue with i: 0

### Takes the job tickets whose work has finished out of the list, into a list from `manager`, keeping the others
### in order.
### :param manager: Where the list of finished tickets comes from.
### :returns: The finished tickets, in the order they had.
@target(os: not "none")
@track_caller
routine @List[Job[T]].take_finished(manager: @MemoryManager) -> Me
needs T: typename
    local finished: @Me <- .construct(manager)

    each i in 0 til me.count() with kept: U64 = 0
        ticket: Job[T] = me[i]
        if ticket.check_finished()
            finished.add_last(ticket)
            continue with kept: kept
        me[kept] = ticket
        continue with kept: kept + 1
    then
        until me.count() <= kept
            removed: Job[T] = me.remove_last()
        then
            return finished

### Takes the job tickets whose work has finished out of the list, into a list from HEAP.
### :returns: The finished tickets, in the order they had.
@target(os: not "none")
@track_caller
routine @List[Job[T]].take_finished() -> Me
needs T: typename
    return me.take_finished(manager: HEAP)

### Gives back the job tickets whose work has finished, and takes them out of the list: for work whose result
### nobody needs.
@target(os: not "none")
@track_caller
routine @List[Job[T]].give_back_finished() -> None
needs T: typename
    each i in 0 til me.count() with kept: U64 = 0
        ticket: Job[T] = me[i]
        if ticket.check_finished()
            ticket.give_back()
            continue with kept: kept
        me[kept] = ticket
        continue with kept: kept + 1
    then
        until me.count() <= kept
            removed: Job[T] = me.remove_last()
        then
            return
