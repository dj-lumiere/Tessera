# Tessera stdlib: ThreadPoolManager, fibers over many threads
#
# A ThreadPoolManager runs work on a number of threads, each with a CoroutineManager of its own (its FIBERS). A
# passable fiber is a fiber the pool's threads hand between them, and its ticket, `PassableFiber[T]`, goes the same
# way as a thread's or a fiber's (Work.te): `pool.get_passable_fiber[T]()`, `put_work`, `retrieve`, `drop`. Work put on
# a passable fiber waits in the pool's queue until a thread of the pool is free, and that thread runs it on a fiber the
# pool keeps. Like any fiber, it runs until it waits, and nothing interrupts it there.
#
# While a passable fiber waits, it belongs to no thread: the wake that ends the wait puts it in the pool's queue of
# woken fibers, and whichever thread of the pool is free first goes on with it (the thread it waited on, or one that had
# nothing to do). A passable fiber therefore may wake on another thread than the one it waited on, so it doesn't rely on
# a `@threadlocal` global across a wait. Fibers a passable fiber makes with FIBERS stay on their thread, as every
# manager's fibers do.
#
# A passable fiber's work may itself put work on more passable fibers and wait for them: the waiting passable fiber
# parks, its thread goes on with other work, and a free thread goes on with it once a child wakes it. That is how work
# splits itself in parts on every core without a thread per part:
#
#     pool: &ThreadPoolManager <- .construct(threads: 0)   # 0: one thread per processor
#     t: PassableFiber[U64] <- pool.get_passable_fiber[U64]()
#     summing: Work[U64] = sum_range.to[Work](pool: pool, from: 0, til: 1000000)
#     t.put_work(summing)
#     total: U64 = t.retrieve()
#     drop t
#
# A thread of the pool sleeps when it has nothing to run, until work or a woken passable fiber is queued, a wake comes
# for one of its own fibers, or one of them is due. The pool's threads start with the first passable fiber and end when
# the pool is destructed.

module Fiber

import Collections
import Hosted

### Runs passable fibers on its threads, each thread's fibers on that thread, and a waiting passable fiber on whichever
### thread is free when it wakes.
entity ThreadPoolManager
    ### The byte whose exclusive access guards the queue, the idle passable fibers, the woken fibers, the kept fibers,
    ### and the threads.
    guard: U8
    ### The passable fibers whose work waits for a thread, in order.
    first: @PassableFiberSlot
    last: @PassableFiberSlot
    ### The passable fibers given back, for the next ticket.
    idle: @PassableFiberSlot
    ### Changes when work is queued, a fiber of a pool thread is woken from another thread, or the pool stops. The
    ### threads sleep on it.
    epoch: U32
    ### 1 once the pool stops: its threads end when they have nothing left.
    stopping: U32
    ### How many threads it runs: 0 until the first passable fiber starts them.
    count: U64
    ### The threads' tickets.
    threads: BorrowedSlice[Thread[None]]
    ### Where the passable fibers, the fibers, and the threads' tickets come from.
    manager: @MemoryManager
    ### The fibers running passable fibers that were woken, for the first free thread to go on with.
    woken: RotatableList[@FiberState]
    ### Every fiber the pool made, through `next_all`.
    fibers: @FiberState
    ### The fibers whose passable fiber is over, waiting for the next, through `next_idle`.
    spare: @FiberState

### One passable fiber of a pool: its work, and its place in the queue or among the idle ones.
secret entity PassableFiberSlot
    slot: WorkSlot
    next: @PassableFiberSlot
    pool: @ThreadPoolManager

### A ticket for a passable fiber of a ThreadPoolManager, from {ThreadPoolManager.get_passable_fiber}: it runs one piece
### of work at a time, whose result is a `T` (`Void` for none), until it is given back with `drop`.
### :typeparam T: The type of the work's result.
record PassableFiber[T]
needs T: typename
    passable: @PassableFiberSlot
    ### The ticket's number: the passable fiber's until the ticket is given back.
    issued: U64

### Makes a `PassableFiberSlot` from its fields.
### :param slot: Its `slot`.
### :param next: Its `next`.
### :param pool: Its `pool`.
### :returns: The new value.
@target(os: not "none")
secret common routine PassableFiberSlot.construct(slot: WorkSlot, next: @Me,
    pool: @ThreadPoolManager) -> Me
    return Me(slot: steal slot, next, pool)

### Gives back the block of its last work.
@target(os: not "none")
secret routine @PassableFiberSlot.destruct() -> None
    me.slot.destruct()
    return

### A pool that will run `threads` threads, or one per processor for 0. They start with the first passable fiber.
### :param threads: How many threads, or 0 for one per processor.
### :returns: The pool, with no threads yet.
@target(os: not "none")
common routine ThreadPoolManager.construct(threads: U64) -> Me
    count: U64 = when
        threads == 0 => cpu_count()
        else => threads
    return Me(guard: 0, first: .hollow(), last: .hollow(), idle: .hollow(), epoch: 0, stopping: 0,
        count, threads: .hollow(), manager: HEAP,
        woken: RotatableList[@FiberState].construct(manager: HEAP), fibers: .hollow(),
        spare: .hollow())

### Stops the pool: its threads finish the work they have, then end, and the idle passable fibers and the fibers go.
### Give every passable fiber back first.
@target(os: not "none")
@track_caller
routine @ThreadPoolManager.destruct() -> None
    threads: @BorrowedSlice[Thread[None]] = me.threads
    started: U64 = threads.count()

    me.stopping.poke_unbroken(1)
    me.epoch.unbroken_fetch_add(1)
    wake_all(me.epoch)

    each i in 0 til started
        t: Thread[None] <- steal threads.getslot(i)
        t.work_slot().wait()
        drop t

    until passable.is_hollow() with passable: @PassableFiberSlot = me.idle.peek()
        next: @PassableFiberSlot = passable.next.peek()
        passable.destruct()
        deallocate(data: passable, manager: me.manager.peek())
        continue with passable: next
    drop me.threads
    me.idle.poke(.hollow())

    until fiber.is_hollow() with fiber: @FiberState = me.fibers.peek()
        next: @FiberState = fiber.next_all.peek()
        fiber.destruct()
        AccessManager.end_flow(fiber.access)
        race_stack_free(fiber.race.peek())
        give_back_stack(stack: fiber.stack, pages: PAGES)
        deallocate(data: fiber, manager: me.manager.peek())
        continue with fiber: next
    me.fibers.poke(.hollow())
    me.spare.poke(.hollow())
    me.woken.destruct()
    return

### Gives the ticket back: hands the passable fiber back to its manager, which keeps it for the next ticket. A ticket
### given back already, or a copy of one, gives nothing back. Written `drop t`.
### A result of its last work that nobody retrieved is destructed first: `drop t` is the ticket's destruct.
### :throws: Crashes with `TicketBusyError` while the work runs.
@target(os: not "none")
@track_caller
routine @PassableFiber[T].destruct() -> None
needs T: typename
    passable: @PassableFiberSlot = me.passable.peek()
    if passable.is_hollow()
        return
    if passable.slot.issued.peek() != me.issued.peek()
        return
    passable.slot.give_back()
    pool: @ThreadPoolManager = passable.pool.peek()
    held: Authorized[U8] <- pool.guard.get_exclusive_access()
    passable.next.poke(pool.idle.peek())
    pool.idle.poke(passable)
    drop held
    return

### A ticket for a passable fiber of the pool: one given back, or a new one. The pool's threads start with the first.
### :typeparam T: The type of the work's result, `Void` for none.
### :returns: The ticket, with no work yet.
### :throws: Crashes with `OutOfMemoryError` when there is no memory for the passable fiber, and with
###     `TaskSpawnError` when the pool's threads can't start.
@target(os: not "none")
@track_caller
routine @ThreadPoolManager.get_passable_fiber[T]() -> PassableFiber[T]
needs T: typename
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    me.start_threads()
    idle: @PassableFiberSlot = me.idle.peek()
    if idle.is_hollow()
        drop held
        manager: @MemoryManager = me.manager.peek()
        passable: @PassableFiberSlot = allocate[PassableFiberSlot](count: 1, manager)
        if passable.is_hollow()
            throw OutOfMemoryError()
        passable.poke(PassableFiberSlot(slot: .construct(manager), next: .hollow(), pool: me))
        return PassableFiber[T](passable, issued: 0)
    me.idle.poke(idle.next.peek())
    drop held
    idle.next.poke(.hollow())
    idle.slot.state.poke_unbroken(TICKET_EMPTY)
    return PassableFiber[T](passable: idle, issued: idle.slot.issued.peek())

### Starts the pool's threads, the first time. The lock is held.
@target(os: not "none")
@track_caller
secret routine @ThreadPoolManager.start_threads() -> None
    count: U64 = me.count.peek()

    threads: @BorrowedSlice[Thread[None]] = me.threads

    if not (threads.count() == 0)
        return
    threads.replace(value: BorrowedSlice[Thread[None]].construct(count, manager: me.manager.peek()))

    each i in 0 til count
        t: Thread[None] <- get_thread[None]()
        t.put_callable(entry: pool_thread.to[Callable](), args: me)
        threads.getslot(i).poke(steal t)
    then
        return

### Puts `passable fiber` behind the others in the queue and wakes the threads.
### :param passable fiber: The passable fiber, with its work put on.
@target(os: not "none")
secret routine @ThreadPoolManager.queue(passable: @PassableFiberSlot) -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    last: @PassableFiberSlot = me.last.peek()
    if last.is_hollow()
        me.first.poke(passable)
    else
        last.next.poke(passable)
    me.last.poke(passable)
    drop held
    me.epoch.unbroken_fetch_add(1)
    wake_all(me.epoch)
    return

### The passable fiber at the front of the queue, taken out, or null.
### :returns: The passable fiber, or null.
@target(os: not "none")
secret routine @ThreadPoolManager.take() -> @PassableFiberSlot
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    passable: @PassableFiberSlot = me.first.peek()
    if passable.is_hollow()
        drop held
        return .hollow()
    next: @PassableFiberSlot = passable.next.peek()
    me.first.poke(next)
    if next.is_hollow()
        me.last.poke(.hollow())
    passable.next.poke(.hollow())
    drop held
    return passable

### Puts `fiber`, a pool's fiber a wake made ready, in the queue of woken fibers and wakes the threads.
### :param fiber: The fiber.
@target(os: not "none")
@reshaping
secret routine @ThreadPoolManager.queue_woken(fiber: @FiberState) -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    me.woken.add_last(fiber)
    drop held
    me.epoch.unbroken_fetch_add(1)
    wake_all(me.epoch)
    return

### The fiber at the front of the queue of woken fibers, taken out, or null.
### :returns: The fiber, or null.
@target(os: not "none")
@reshaping
secret routine @ThreadPoolManager.take_woken() -> @FiberState
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    if me.woken.is_empty()
        drop held
        return .hollow()
    fiber: @FiberState = me.woken.remove_first()
    drop held
    return fiber

### Keeps `fiber`, whose passable fiber is over, for the next passable fiber.
### :param fiber: The fiber.
@target(os: not "none")
secret routine @ThreadPoolManager.keep_fiber(fiber: @FiberState) -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    fiber.next_idle.poke(me.spare.peek())
    me.spare.poke(fiber)
    drop held
    return

### A fiber for a passable fiber: one kept from an earlier passable fiber, or a new one with a stack of its own.
### :returns: The fiber.
### :throws: Crashes with `OutOfMemoryError` when there is no memory for the fiber or its stack.
@target(os: not "none")
@track_caller
secret routine @ThreadPoolManager.take_fiber() -> @FiberState
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    spare: @FiberState = me.spare.peek()
    if spare.is_not_hollow()
        me.spare.poke(spare.next_idle.peek())
        drop held
        spare.next_idle.poke(.hollow())
        # No manager runs it until a thread adopts it, which counts it among that thread's busy fibers.
        spare.manager.poke_unbroken(.hollow())
        return spare
    drop held
    manager: @MemoryManager = me.manager.peek()
    stack: &StackManager <- take_stack(size: DEFAULT_FIBER_STACK, pages: PAGES)
    if stack.top.peek().is_hollow()
        throw OutOfMemoryError()
    fiber: @FiberState = allocate[FiberState](count: 1, manager)
    if fiber.is_hollow()
        throw OutOfMemoryError()
    stack.sp.poke(initial_stack(stack: stack.bottom.peek(), size: stack.size().bytes(),
        entry: fiber_start.addr()))
    fiber.poke(FiberState(stack: steal stack, manager: .hollow(), slot: .construct(manager),
        work: fiber.slot, then: requeue.to[Callable](), wake_state: FIBER_RUNNING, timer: 0,
        trace_depth: 0, access: .hollow(), race: race_stack_new(), next_idle: .hollow(),
        next_all: .hollow(), pool: me, mold: .hollow()))
    held2: Authorized[U8] <- me.guard.get_exclusive_access()
    fiber.next_all.poke(me.fibers.peek())
    me.fibers.poke(fiber)
    drop held2
    return fiber

### Makes `fiber` one of this thread's: it counts among FIBERS' busy fibers instead of its last manager's, and goes in
### FIBERS' ready queue.
### :param fiber: A pool's fiber, ready to run.
@target(os: not "none")
secret routine adopt(fiber: @FiberState) -> None
    from: @CoroutineManager = fiber.manager.peek_unbroken()
    if from !== FIBERS
        FIBERS.busy.unbroken_fetch_add(1)
        fiber.manager.poke_unbroken(FIBERS)
        if from.is_not_hollow()
            from.busy.unbroken_fetch_sub(1)
    FIBERS.ready.add_last(fiber)
    return

### A pool thread's work: runs this thread's fibers until none is ready, goes on with a woken passable fiber or starts
### the next queued one, and sleeps when there is nothing, until the pool stops and its fibers are done.
### :param pool: The pool.
@target(os: not "none")
@reshaping(pool)
secret routine pool_thread(pool: @ThreadPoolManager) -> None
    FIBERS.wake_through(pool.epoch)

    # Reads the epoch before looking, so work or a wake that comes in between changes it and the sleep returns.
    loop
        seen: U32 = pool.epoch.peek_unbroken()
        FIBERS.run_until_idle()
        woken: @FiberState = pool.take_woken()
        if woken.is_not_hollow()
            adopt(woken)
            continue
        passable: @PassableFiberSlot = pool.take()
        if passable.is_hollow()
            if pool.stopping.peek_unbroken() == 1 and FIBERS.busy.peek_unbroken() == 0
                break
            wait: Duration = FIBERS.idle_wait()
            if wait == Duration.MAX
                wait_on(at: pool.epoch, expected: seen)
                continue
            wait_on_for(at: pool.epoch, expected: seen, timeout: wait)
            continue
        fiber: @FiberState = pool.take_fiber()
        fiber.slot.state.poke_unbroken(TICKET_RUNNING)
        fiber.work.poke(passable.slot)
        adopt(fiber)
        continue
    return

# -- the tickets -------------------------------------------------------------------------------------------------

### The slot the ticket's work lives in, for code that waits on several tickets at once.
### :returns: The slot.
### :throws: Crashes with `TicketGivenBackError` for a ticket given back.
@target(os: not "none")
@track_caller
routine PassableFiber[T].work_slot() -> @WorkSlot
needs T: typename
    passable: @PassableFiberSlot = me.passable
    passable.slot.check_ticket(me.issued)
    return passable.slot

### Starts the work in `work`, run by `runner`: it waits in the pool's queue for a free thread.
### :param runner: Runs the work.
### :param discard: Destructs the block, for a result nobody retrieves.
### :param work: Its block.
@target(os: not "none")
@track_caller
secret routine PassableFiber[T].start(runner: Callable[(Addr,), None],
    discard: Callable[(Addr,), None], work: Addr) -> None
needs T: typename
    passable: @PassableFiberSlot = me.passable
    me.work_slot().put(runner, discard, work)
    passable.pool.peek().queue(passable)
    return

### Starts `work` on the ticket at once: it runs from here on, and the ticket's `retrieve()` waits for it and gives its
### result. The ticket runs a copy of the work's block in memory from its manager. Work whose arguments have nothing
### to give back may go on more tickets. Work with an argument that has something to give back (an entity, an access)
### runs once: it is handed over with steal, `t.put_work(steal work)`.
### :param work: The work, made with `f.to[Work](...)`.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket given
###     back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[T].put_work(work: Work[T]) -> None
needs T: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    me.start(runner: work.runner, discard: work.discard, work: work.copy_for(slot))
    return

### Starts `entry` on the ticket. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[T].put_callable(entry: Callable[(), T]) -> None
needs T: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_work0[T](entry, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[T].put_callable[A](entry: Callable[(A,), T], args: A) -> None
needs T: typename, A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_work1[T, A](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[T].put_callable[A, B](entry: Callable[(A, B), T], args: (A, B)) -> None
needs T: typename, A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_work2[T, A, B](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[T].put_callable[A, B, C](entry: Callable[(A, B, C), T],
    args: (A, B, C)) -> None
needs T: typename, A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_work3[T, A, B, C](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[T].put_callable[A, B, C, D](entry: Callable[(A, B, C, D), T],
    args: (A, B, C, D)) -> None
needs T: typename, A: typename, B: typename, C: typename, D: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_work4[T, A, B, C, D](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[None].put_callable(entry: Callable[(), None]) -> None
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_voidwork0(entry, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[None].put_callable[A](entry: Callable[(A,), None], args: A) -> None
needs A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_voidwork1[A](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[None].put_callable[A, B](entry: Callable[(A, B), None], args: (A, B)) -> None
needs A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_voidwork2[A, B](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[None].put_callable[A, B, C](entry: Callable[(A, B, C), None],
    args: (A, B, C)) -> None
needs A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_voidwork3[A, B, C](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `OutOfMemoryError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine PassableFiber[None].put_callable[A, B, C, D](entry: Callable[(A, B, C, D), None],
    args: (A, B, C, D)) -> None
needs A: typename, B: typename, C: typename, D: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, discard, work = make_voidwork4[A, B, C, D](entry, args, manager: slot.manager.peek())
    me.start(runner, discard, work)
    return

### Whether the work has finished, without waiting: true once it has, and for a ticket with no work.
### :returns: True unless the work runs or waits for a thread.
@target(os: not "none")
@track_caller
routine PassableFiber[T].check_finished() -> Bool
needs T: typename
    return me.work_slot().is_finished()

### Makes the next `retrieve()` wait at most `timeout`: `t.waitfor(5s).retrieve()` throws `TaskTimeoutError` when the
### work hasn't finished by then.
### :param timeout: The longest wait, from now.
### :returns: The ticket, for its `retrieve()`.
@target(os: not "none")
@track_caller
routine PassableFiber[T].waitfor(timeout: Duration) -> Me
needs T: typename
    me.work_slot().set_deadline(timeout)
    return me

### Waits until the work has finished, and checks that it wasn't cancelled: work with no result. Inside a fiber only
### that fiber waits, and its thread goes on with other work.
### :throws: Crashes with `NoWorkError` when there was none. Throws `TaskTimeoutError` when the deadline `waitfor` set
###     passed first, and `CancelRequested` when `cancel()` asked the work to stop before it finished, or asked the
###     work that waits to stop while it waits.
@target(os: not "none")
@track_caller
failable routine PassableFiber[None].retrieve() -> None
    slot: @WorkSlot = me.work_slot()
    waited: U32 = slot.wait_to_retrieve()
    if waited == WAITED_TIMED_OUT
        throw TaskTimeoutError()
    if waited == WAITED_CANCELLED
        throw CancelRequested()
    slot.result_place[Byte]()
    if slot.is_cancelled()
        throw CancelRequested()
    return

### Waits until the work has finished, and gives its result. Inside a fiber only that fiber waits, and its thread goes
### on with other work.
### :returns: The result.
### :throws: Crashes with `NoWorkError` when there was none. Throws `TaskTimeoutError` when the deadline `waitfor` set
###     passed first, and `CancelRequested` when `cancel()` asked the work to stop before it finished, or asked the
###     work that waits to stop while it waits.
@target(os: not "none")
@track_caller
failable routine PassableFiber[T].retrieve() -> T
needs T: typename
    slot: @WorkSlot = me.work_slot()
    waited: U32 = slot.wait_to_retrieve()
    if waited == WAITED_TIMED_OUT
        throw TaskTimeoutError()
    if waited == WAITED_CANCELLED
        throw CancelRequested()
    place: @T = slot.result_place[T]()
    if slot.is_cancelled()
        throw CancelRequested()
    taken: &T <- steal place.stride(0)
    slot.result_taken[T]()
    return taken

### Asks the work to stop: `cancel_requested()` turns true inside it, and the work stops where it looks.
@target(os: not "none")
@track_caller
routine PassableFiber[T].cancel() -> None
needs T: typename
    me.work_slot().request_cancel()
    return
