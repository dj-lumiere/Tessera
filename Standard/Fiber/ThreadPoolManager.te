# Tessera stdlib: ThreadPoolManager, fibers over many threads
#
# A ThreadPoolManager runs work on a number of threads, each with a FiberManager of its own (its FIBERS). A job is a
# ticket in the same flow as a thread's or a fiber's (Work.te): `pool.get_job[T]()`, `put_work`, `wait_finished`,
# `retrieve`, `give_back`. Work put on a job waits in the pool's queue until a thread of the pool is free, and that
# thread runs it on a fiber the pool keeps. Like any fiber, it runs until it waits, and nothing interrupts it there.
#
# While a job waits, it belongs to no thread: the wake that ends the wait puts it in the pool's queue of woken fibers,
# and whichever thread of the pool is free first goes on with it (the thread it waited on, or one that had nothing to
# do). A job therefore may wake on another thread than the one it waited on, so it doesn't rely on a `@threadlocal`
# global across a wait. Fibers a job makes with FIBERS stay on their thread, as every manager's fibers do.
#
# A job's work may itself put work on more jobs and wait for them: the waiting job parks, its thread goes on with
# other work, and a free thread goes on with it once a child wakes it. That is how work splits itself in parts on
# every core without a thread per part:
#
#     local pool: @ThreadPoolManager <- .construct(threads: 0)   # 0: one thread per processor
#     j: Job[U64] = pool.get_job[U64]()
#     j.put_work(entry: sum_range.to[Callable](), args: (pool, 0, 1000000))
#     j.wait_finished()
#     total: U64 = j.retrieve()
#     j.give_back()
#     pool.destruct()
#
# A thread of the pool sleeps when it has nothing to run, until work or a woken job is queued, a wake comes for one of
# its own fibers, or one of them is due. The pool's threads start with the first job and end when the pool is
# destructed.

module Standard/Fiber

import Standard/Collections
import Standard/Os

### Runs jobs on its threads, each thread's fibers on that thread, and a waiting job on whichever thread is free when it
### wakes.
entity ThreadPoolManager
    ### Guards the queue, the idle jobs, the woken fibers, the kept fibers, and the threads.
    lock: ExclusiveAccess
    ### The jobs whose work waits for a thread, in order.
    first: @PoolJob
    last: @PoolJob
    ### The jobs given back, for the next ticket.
    idle: @PoolJob
    ### Changes when work is queued, a fiber of a pool thread is woken from another thread, or the pool stops. The
    ### threads sleep on it.
    epoch: U32
    ### 1 once the pool stops: its threads end when they have nothing left.
    stopping: U32
    ### How many threads it runs: 0 until the first job starts them.
    count: U64
    ### The threads' tickets.
    threads: Memory[Thread[None]]
    ### Where the jobs, the fibers, and the threads' tickets come from.
    manager: @MemoryManager
    ### The fibers running jobs that were woken, for the first free thread to go on with.
    woken: CircularList[@FiberState]
    ### Every fiber the pool made, through `next_all`.
    fibers: @FiberState
    ### The fibers whose job is over, waiting for the next, through `next_idle`.
    spare: @FiberState

### One job of a pool: its work, and its place in the queue or among the idle ones.
secret record PoolJob
    slot: WorkSlot
    next: @PoolJob
    pool: @ThreadPoolManager

### A ticket for a job of a ThreadPoolManager, from {ThreadPoolManager.get_job}: it runs one piece of work at a time, whose result is a
### `T` (`Void` for none), until {Job[T].give_back}.
### :typeparam T: The type of the work's result.
record Job[T]
needs T: typename
    job: @PoolJob
    ### The ticket's number: the job's until the ticket is given back.
    issued: U64

### A pool that will run `threads` threads, or one per processor for 0. They start with the first job.
### :param threads: How many threads, or 0 for one per processor.
### :returns: The pool, with no threads yet.
@target(os: not "none")
common routine ThreadPoolManager.construct(threads: U64) -> Me
    count: U64 = when
        threads == 0 => cpu_count()
        else => threads
    return Me(lock: .construct(), first: .hollow(), last: .hollow(), idle: .hollow(), epoch: 0,
        stopping: 0, count, threads: .hollow(), manager: HEAP,
        woken: CircularList[@FiberState].construct(manager: HEAP), fibers: .hollow(),
        spare: .hollow())

### Stops the pool: its threads finish the work they have, then end, and the idle jobs and the fibers go. Give every
### job back first.
@target(os: not "none")
@track_caller
routine @ThreadPoolManager.destruct() -> None
    threads: @Memory[Thread[None]] = me.threads
    started: U64 = threads.count()

    me.stopping.poke_atomic(1)
    me.epoch.atomic_fetch_add(1)
    wake_all(me.epoch)

    each i in 0 til started
        t: Thread[None] = threads.load(index: i)
        t.wait_finished()
        t.give_back()

    until job.is_hollow() with job: @PoolJob = me.idle.peek()
        next: @PoolJob = job.next.peek()
        job.slot.destruct()
        deallocate(data: job, manager: me.manager.peek())
        continue with job: next
    drop me.threads
    me.idle.poke(.hollow())

    until fiber.is_hollow() with fiber: @FiberState = me.fibers.peek()
        next: @FiberState = fiber.next_all.peek()
        fiber.destruct()
        AccessManager.end_flow(fiber.access)
        race_stack_free(fiber.race.peek())
        give_back_stack(stack: fiber.stack, pages: PAGES)
        deallocate(data: fiber, manager: me.manager.peek())
        continue with fiber: next
    me.fibers.poke(.hollow())
    me.spare.poke(.hollow())
    me.woken.destruct()
    return

### Makes a `PoolJob` from its fields.
### :param slot: Its `slot`.
### :param next: Its `next`.
### :param pool: Its `pool`.
### :returns: The new value.
@target(os: not "none")
common routine PoolJob.construct(slot: WorkSlot, next: @Me, pool: @ThreadPoolManager) -> Me
    return Me(slot, next, pool)

### Releases the block of its last work.
@target(os: not "none")
routine @PoolJob.destruct() -> None
    me.slot.destruct()
    return

### Makes a `Job` from its fields.
### :param job: Its `job`.
### :param issued: Its `issued`.
### :returns: The new value.
@target(os: not "none")
common routine Job[T].construct(job: @PoolJob, issued: U64) -> Me
needs T: typename
    return Me(job, issued)

### Crashes when the ticket wasn't given back: its job would be lost, and its work might still run.
### :throws: Crashes with `TicketNotGivenBackError` for a ticket that still holds its job.
@target(os: not "none")
@track_caller
routine @Job[T].destruct() -> None
needs T: typename
    job: @PoolJob = me.job.peek()
    if job.is_hollow()
        return
    if job.slot.issued.peek() == me.issued.peek()
        crash(name: "TicketNotGivenBackError",
            message: "This job ticket was never given back: wait_finished() and give_back() before it goes.")
    return

### A ticket for a job of the pool: one given back, or a new one. The pool's threads start with the first.
### :typeparam T: The type of the work's result, `Void` for none.
### :returns: The ticket, with no work yet.
### :throws: Crashes with `MemoryAllocationError` when there is no memory for the job, and with `TaskSpawnError` when
###     the pool's threads can't start.
@target(os: not "none")
@track_caller
routine @ThreadPoolManager.get_job[T]() -> Job[T]
needs T: typename
    me.lock.lock()
    me.start_threads()
    idle: @PoolJob = me.idle.peek()
    if idle.is_hollow()
        me.lock.unlock()
        manager: @MemoryManager = me.manager.peek()
        job: @PoolJob = allocate[PoolJob](count: 1, manager)
        if job.is_hollow()
            crash_allocation()
        job.poke(PoolJob(slot: .construct(manager), next: .hollow(), pool: me))
        return Job[T](job, issued: 0)
    me.idle.poke(idle.next.peek())
    me.lock.unlock()
    idle.next.poke(.hollow())
    idle.slot.state.poke_atomic(TICKET_EMPTY)
    return Job[T](job: idle, issued: idle.slot.issued.peek())

### Starts the pool's threads, the first time. The lock is held.
@target(os: not "none")
@track_caller
secret routine @ThreadPoolManager.start_threads() -> None
    local count: U64 = me.count.peek()

    threads: @Memory[Thread[None]] = me.threads

    if not (threads.count() == 0)
        return
    threads.replace(value: Memory[Thread[None]].construct(count, manager: me.manager.peek()))

    each i in 0 til count
        t: Thread[None] = get_thread[None]()
        t.put_work(entry: pool_thread.to[Callable](), args: me)
        threads.store(index: i, value: t)
    then
        return

### Puts `job` behind the others in the queue and wakes the threads.
### :param job: The job, with its work put on.
@target(os: not "none")
secret routine @ThreadPoolManager.queue(job: @PoolJob) -> None
    me.lock.lock()
    last: @PoolJob = me.last.peek()
    if last.is_hollow()
        me.first.poke(job)
    else
        last.next.poke(job)
    me.last.poke(job)
    me.lock.unlock()
    me.epoch.atomic_fetch_add(1)
    wake_all(me.epoch)
    return

### The job at the front of the queue, taken out, or null.
### :returns: The job, or null.
@target(os: not "none")
secret routine @ThreadPoolManager.take() -> @PoolJob
    me.lock.lock()
    job: @PoolJob = me.first.peek()
    if job.is_hollow()
        me.lock.unlock()
        return .hollow()
    next: @PoolJob = job.next.peek()
    me.first.poke(next)
    if next.is_hollow()
        me.last.poke(.hollow())
    job.next.poke(.hollow())
    me.lock.unlock()
    return job

### Puts `fiber`, a pool's fiber a wake made ready, in the queue of woken fibers and wakes the threads.
### :param fiber: The fiber.
@target(os: not "none")
@reshaping
secret routine @ThreadPoolManager.queue_woken(fiber: @FiberState) -> None
    me.lock.lock()
    me.woken.add_last(fiber)
    me.lock.unlock()
    me.epoch.atomic_fetch_add(1)
    wake_all(me.epoch)
    return

### The fiber at the front of the queue of woken fibers, taken out, or null.
### :returns: The fiber, or null.
@target(os: not "none")
@reshaping
secret routine @ThreadPoolManager.take_woken() -> @FiberState
    me.lock.lock()
    if me.woken.is_empty()
        me.lock.unlock()
        return .hollow()
    fiber: @FiberState = me.woken.remove_first()
    me.lock.unlock()
    return fiber

### Keeps `fiber`, whose job is over, for the next job.
### :param fiber: The fiber.
@target(os: not "none")
secret routine @ThreadPoolManager.keep_fiber(fiber: @FiberState) -> None
    me.lock.lock()
    fiber.next_idle.poke(me.spare.peek())
    me.spare.poke(fiber)
    me.lock.unlock()
    return

### A fiber for a job: one kept from an earlier job, or a new one with a stack of its own.
### :returns: The fiber.
### :throws: Crashes with `MemoryAllocationError` when there is no memory for the fiber or its stack.
@target(os: not "none")
@track_caller
secret routine @ThreadPoolManager.take_fiber() -> @FiberState
    me.lock.lock()
    spare: @FiberState = me.spare.peek()
    if spare.is_not_hollow()
        me.spare.poke(spare.next_idle.peek())
        me.lock.unlock()
        spare.next_idle.poke(.hollow())
        # No manager runs it until a thread adopts it, which counts it among that thread's busy fibers.
        spare.manager.poke_atomic(.hollow())
        return spare
    me.lock.unlock()
    manager: @MemoryManager = me.manager.peek()
    local stack: @StackManager <- take_stack(size: DEFAULT_FIBER_STACK, pages: PAGES)
    if stack.top.peek().is_hollow()
        crash_allocation()
    fiber: @FiberState = allocate[FiberState](count: 1, manager)
    if fiber.is_hollow()
        crash_allocation()
    sp: Addr = initial_stack(stack: stack.bottom.peek(), size: stack.size().bytes(),
        entry: fiber_start.addr())
    fiber.poke(FiberState(sp, stack: steal stack, manager: .hollow(), slot: .construct(manager),
        work: fiber.slot, then: requeue.to[Callable](), wake_state: FIBER_RUNNING, timer: 0,
        trace_depth: 0, access: .hollow(), race: race_stack_new(), next_idle: .hollow(),
        next_all: .hollow(), pool: me))
    me.lock.lock()
    fiber.next_all.poke(me.fibers.peek())
    me.fibers.poke(fiber)
    me.lock.unlock()
    return fiber

### Makes `fiber` one of this thread's: it counts among FIBERS' busy fibers instead of its last manager's, and goes in
### FIBERS' ready queue.
### :param fiber: A pool's fiber, ready to run.
@target(os: not "none")
secret routine adopt(fiber: @FiberState) -> None
    from: @FiberManager = fiber.manager.peek_atomic()
    if from !== FIBERS
        FIBERS.busy.atomic_fetch_add(1)
        fiber.manager.poke_atomic(FIBERS)
        if from.is_not_hollow()
            from.busy.atomic_fetch_sub(1)
    FIBERS.ready.add_last(fiber)
    return

### A pool thread's work: runs this thread's fibers until none is ready, goes on with a woken job or starts the next
### queued one, and sleeps when there is nothing, until the pool stops and its fibers are done.
### :param pool: The pool.
@target(os: not "none")
@reshaping(pool)
secret routine pool_thread(pool: @ThreadPoolManager) -> None
    FIBERS.wake_through(pool.epoch)

    # Reads the epoch before looking, so work or a wake that comes in between changes it and the sleep returns.
    loop
        seen: U32 = pool.epoch.peek_atomic()
        FIBERS.run_until_idle()
        woken: @FiberState = pool.take_woken()
        if woken.is_not_hollow()
            adopt(woken)
            continue
        job: @PoolJob = pool.take()
        if job.is_hollow()
            if pool.stopping.peek_atomic() == 1 and FIBERS.busy.peek_atomic() == 0
                break
            wait: Duration = FIBERS.idle_wait()
            if wait == Duration.MAX
                wait_on(at: pool.epoch, expected: seen)
                continue
            wait_on_for(at: pool.epoch, expected: seen, timeout: wait)
            continue
        fiber: @FiberState = pool.take_fiber()
        fiber.slot.state.poke_atomic(TICKET_RUNNING)
        fiber.work.poke(job.slot)
        adopt(fiber)
        continue
    return

# -- the tickets -------------------------------------------------------------------------------------------------

### The slot the ticket's work lives in, for code that waits on several tickets at once.
### :returns: The slot.
### :throws: Crashes with `TicketGivenBackError` for a ticket given back.
@target(os: not "none")
@track_caller
routine Job[T].work_slot() -> @WorkSlot
needs T: typename
    job: @PoolJob = me.job
    job.slot.check_ticket(me.issued)
    return job.slot

### Starts the work in `work`, run by `runner`: it waits in the pool's queue for a free thread.
### :param runner: Runs the work.
### :param work: Its block.
@target(os: not "none")
@track_caller
secret routine Job[T].start(runner: Callable[(Addr,), None], work: Addr) -> None
needs T: typename
    job: @PoolJob = me.job
    me.work_slot().put(runner, work)
    job.pool.peek().queue(job)
    return

### Starts `entry` on the ticket. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[T].put_work(entry: Callable[(), T]) -> None
needs T: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work0[T](entry, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[T].put_work[A](entry: Callable[(A,), T], args: A) -> None
needs T: typename, A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work1[T, A](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[T].put_work[A, B](entry: Callable[(A, B), T], args: (A, B)) -> None
needs T: typename, A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work2[T, A, B](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[T].put_work[A, B, C](entry: Callable[(A, B, C), T], args: (A, B, C)) -> None
needs T: typename, A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work3[T, A, B, C](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[T].put_work[A, B, C, D](entry: Callable[(A, B, C, D), T], args: (A, B, C, D)) -> None
needs T: typename, A: typename, B: typename, C: typename, D: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work4[T, A, B, C, D](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[None].put_work(entry: Callable[(), None]) -> None
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork0(entry, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[None].put_work[A](entry: Callable[(A,), None], args: A) -> None
needs A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork1[A](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[None].put_work[A, B](entry: Callable[(A, B), None], args: (A, B)) -> None
needs A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork2[A, B](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[None].put_work[A, B, C](entry: Callable[(A, B, C), None], args: (A, B, C)) -> None
needs A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork3[A, B, C](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Job[None].put_work[A, B, C, D](entry: Callable[(A, B, C, D), None],
    args: (A, B, C, D)) -> None
needs A: typename, B: typename, C: typename, D: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork4[A, B, C, D](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Whether the work has finished, without waiting: true once it has, and for a ticket with no work.
### :returns: True unless the work runs or waits for a thread.
@target(os: not "none")
@track_caller
routine Job[T].check_finished() -> Bool
needs T: typename
    return me.work_slot().is_finished()

### Waits until the work has finished. Inside a fiber only that fiber waits, and its thread goes on with other work.
@target(os: not "none")
@track_caller
routine Job[T].wait_finished() -> None
needs T: typename
    me.work_slot().wait()
    return

### Waits until the work has finished or `timeout` has passed, whichever comes first.
### :param timeout: The longest wait.
### :returns: True when the work has finished, false when the time ran out first.
@target(os: not "none")
@track_caller
routine Job[T].wait_finished_for(timeout: Duration) -> Bool
needs T: typename
    return me.work_slot().wait_until(deadline: Clock.monotonic() +^ timeout, cancellable: false)

### Waits until the work has finished, or until the work that waits is asked to stop with `cancel()`.
### :throws: Throws `CancelRequested` when the waiting work was cancelled first.
@target(os: not "none")
@track_caller
failable routine Job[T].wait_finished_cancellable() -> None
needs T: typename
    if me.work_slot().wait_until(deadline: Duration.MAX, cancellable: true)
        return
    throw CancelRequested()

### Gives nothing: work with no result. It checks that the work has finished and wasn't cancelled.
### :throws: Crashes with `TicketBusyError` while the work runs, and with `NoWorkError` when there was none. Throws
###     `CancelRequested` when `cancel()` asked it to stop before it finished.
@target(os: not "none")
@track_caller
failable routine Job[None].retrieve() -> None
    slot: @WorkSlot = me.work_slot()
    slot.result_place[Byte]()
    if slot.is_cancelled()
        throw CancelRequested()
    return

### The finished work's result.
### :returns: The result.
### :throws: Crashes with `TicketBusyError` while the work runs, and with `NoWorkError` when there was none. Throws
###     `CancelRequested` when `cancel()` asked it to stop before it finished.
@target(os: not "none")
@track_caller
failable routine Job[T].retrieve() -> T
needs T: typename
    slot: @WorkSlot = me.work_slot()
    place: @T = slot.result_place[T]()
    if slot.is_cancelled()
        throw CancelRequested()
    return place.peek()

### Asks the work to stop: `cancel_requested()` turns true inside it, and the work stops where it looks.
@target(os: not "none")
@track_caller
routine Job[T].cancel() -> None
needs T: typename
    me.work_slot().request_cancel()
    return

### Hands the job back to its pool for the next ticket. The ticket is over.
### :throws: Crashes with `TicketBusyError` while the work runs, and with `TicketGivenBackError` for a ticket given
###     back already.
@target(os: not "none")
@track_caller
routine Job[T].give_back() -> None
needs T: typename
    me.work_slot().give_back()
    job: @PoolJob = me.job
    pool: @ThreadPoolManager = job.pool.peek()
    pool.lock.lock()
    job.next.poke(pool.idle.peek())
    pool.idle.poke(job)
    pool.lock.unlock()
    return
