# Tessera stdlib: fibers
#
# A fiber is a ticket a FiberManager hands out, in the same flow as a thread's (Work.te): `get_fiber[T]()` takes
# one, `put_work` starts its work, `check_finished` looks, `wait_finished` waits, `retrieve` takes the result, and
# `give_back` hands the fiber back to its manager, which keeps it, stack and all, for the next ticket.
#
# A manager runs its fibers on one thread, the one that drives it, and never moves them: they take turns, and one runs
# until it yields, parks, sleeps, or its work finishes. (A ThreadPoolManager's jobs are fibers the pool keeps, which a
# wake hands to whichever of its threads is free, see ThreadPoolManager.te.) Nothing cuts in between, so fibers of one manager share
# values without a lock between those points. Each thread has a manager of its own, FIBERS, made on first use. A
# program that wants more cores takes thread tickets and drives a manager on each.
#
#     f: Fiber[S64] = FIBERS.get_fiber[S64]()
#     f.put_work(entry: count.to[Callable](), args: 100)
#     f.wait_finished()   # outside a fiber, on the manager's thread: runs the manager's fibers until f's work is done
#     n: S64 = f.retrieve()
#     f.give_back()
#
# The manager runs its fibers whenever its thread waits for one (`wait_finished` outside a fiber), or in `run()`
# (until no fiber has work left) and `run_until_idle()` (until none is ready to go on, then back). Inside a fiber,
# waiting parks only that fiber, and its thread goes on with the others:
#
# - park() until wake() is called with its handle (from current()), from any thread. A wake that comes first isn't
#   lost: the next park returns at once. park may also return without a wake, so a fiber checks what it waits for
#   again in a loop.
# - waitfor(duration) until that much time has passed.
# - wait_finished() of another ticket, a fiber's or a thread's: the thread that finishes its work wakes the fiber.
# - run_blocking() a call that may block the thread (reading a pipe, a socket, a file): a thread ticket runs it while
#   the fiber waits. read and write (Standard/Fiber/Io.te) are built on it.
#
# A wake from another thread goes in the manager's inbox, and the manager takes it in at its next turn, waking its
# thread if it sleeps. Outside a fiber, sleep waits the thread, run_blocking just calls, and park returns.

module Standard/Fiber

import Standard/Collections
import Standard/Os

### This thread's fiber manager, made on first use with DEFAULT_FIBER_STACK stacks of pages from PAGES.
@threadlocal
@target(os: not "none")
global FIBERS: @FiberManager

# A fiber's wake_state. A wake turns RUNNING or PARKING into NOTIFIED, and PARKED back into RUNNING (and queues the
# fiber). park turns RUNNING into PARKING (or takes a NOTIFIED back to RUNNING and returns), and its manager, once the
# fiber is off its stack, turns PARKING into PARKED, or finds NOTIFIED and queues it again.
secret preset FIBER_RUNNING:  U32 = 0

secret preset FIBER_NOTIFIED: U32 = 1
secret preset FIBER_PARKING:  U32 = 2
secret preset FIBER_PARKED:   U32 = 3
### The stack size of a fiber of FIBERS, the manager each thread makes on first use: 64 KiB.
preset DEFAULT_FIBER_STACK: ByteSize = 64kib

### One fiber: a stack and the work on it, from the first ticket that takes it until its manager goes. A pointer to it
### is the fiber's handle (see current and wake).
record FiberState
    ### Its stack pointer while it isn't running.
    sp: Addr
    ### Its stack, on pages from the manager's page manager.
    stack: StackManager
    ### The manager running it. Only a ThreadPoolManager's fiber changes manager, while it waits.
    manager: @FiberManager
    slot: WorkSlot
    ### The slot whose work it runs: its own, or a ThreadPoolManager job's it was given.
    work: @WorkSlot
    ### Where its manager puts it after it stops.
    then: Callable[(@FiberManager, @FiberState), None]
    ### FIBER_RUNNING, FIBER_NOTIFIED, FIBER_PARKING or FIBER_PARKED.
    wake_state: U32
    ### The number of the timer that wakes it while it waits with a deadline, 0 for none.
    timer: U64
    ### Its crash trace depth while it isn't running (Trace.te).
    trace_depth: U64
    ### What the AccessManager keeps of it: the accesses it holds and what it waits for, made at its first access.
    access: @AccessFlow
    ### Its stack's handle for the data race check, or null without it.
    race: Addr
    ### The next fiber given back, waiting for a ticket.
    next_idle: @FiberState
    ### The next of all the manager's fibers, or of all the pool's for a pool's fiber.
    next_all: @FiberState
    ### The ThreadPoolManager that keeps it and runs it on any of its threads, or null for a fiber of one manager.
    pool: @ThreadPoolManager

### A ticket for a fiber, from {FiberManager.get_fiber}: it runs one piece of work at a time, whose result is a `T`
### (`Void` for none), until {Fiber[T].give_back}.
### :typeparam T: The type of the work's result.
record Fiber[T]
needs T: typename
    fiber: @FiberState
    ### The ticket's number: the fiber's until the ticket is given back.
    issued: U64

### When a fiber waiting with a deadline is due, its priority among the timers: earliest first, and in the order they
### started waiting when they are due together.
secret record TimerKey
obeys Comparable[TimerKey]
    deadline: Duration
    seq: U64

### Runs fibers on one thread, the one that drives it, and hands them out as tickets.
entity FiberManager
    ### The fiber records and the queues.
    manager: @MemoryManager
    ### The page manager the fibers' stacks come from.
    stack_manager: @MemoryManager
    ### The size of each fiber's stack in bytes.
    stack_size: ByteSize
    ### The `thread_mark()` of the thread that drives it.
    owner: Addr
    ### The driving loop's stack pointer while a fiber runs.
    home: Addr
    ### The driving loop's stack's handle for the data race check, while a fiber runs.
    home_race: Addr
    ### The fiber running, or null.
    current: @FiberState
    ### The fibers ready to go on, in order. Only the manager's thread touches it.
    ready: CircularList[@FiberState]
    ### Guards `inbox` and `idle`.
    inbox_lock: ExclusiveAccess
    ### Fibers woken or started from other threads, for the manager's thread to take in.
    inbox: CircularList[@FiberState]
    ### Changes when the inbox gets a fiber. The manager's thread waits on it.
    epoch: U32
    ### The word that changes instead of `epoch`, when a ThreadPoolManager's thread drives the manager and waits on the pool's,
    ### or null.
    alert: @U32
    ### The fibers whose work hasn't finished.
    busy: U64
    ### The fibers given back, waiting for the next ticket.
    idle: @FiberState
    ### Every fiber the manager made.
    all: @FiberState
    ### The fibers waiting with a deadline. Only the manager's thread touches it.
    timers: PriorityQueue[TimerKey, @FiberState]
    timer_seq: U64

### A stack of `size` bytes on pages from `pages`: whole pages, committed, with one more page below them that `protect`
### closes, so a stack that runs out stops the program there instead of writing over what lies below. The
### StackManager runs on the pages above the closed one. Give it back with {give_back_stack}.
### :param size: The stack's size, rounded up to whole pages.
### :param pages: The page manager, such as `PAGES`.
### :returns: The stack's manager, or a hollow one (its `top` null) when the pages can't be had.
### :throws: Crashes with `NotImplementedError` when `pages` doesn't handle pages.
@target(os: not "none")
@track_caller
@expensive("asks for pages")
routine take_stack(size: ByteSize, pages: @MemoryManager) -> StackManager
    local page: U64 = page_size().bytes()
    local usable: U64 = whole_pages(size.bytes())
    local length: U64 = usable + page

    base: Addr = pages.reserve(length)
    if base.is_hollow()
        return .hollow()
    if not pages.commit(at: base, size: length)
        pages.release(at: base, size: length)
        return .hollow()
    if not pages.protect(at: base, size: page, access: PageAccess.NONE)
        pages.release(at: base, size: length)
        return .hollow()
    bottom: Addr = base +% ByteSize.construct(bytes: page)
    return StackManager.construct(bottom, top: bottom +% ByteSize.construct(bytes: usable))

### Gives a stack from {take_stack} back to its page manager, the closed page below it included.
### :param stack: The stack's manager, from {take_stack} with the same `pages`.
### :param pages: The page manager it came from.
@target(os: not "none")
@track_caller
@expensive("gives memory back")
routine give_back_stack(stack: StackManager, pages: @MemoryManager) -> None
    page: U64 = page_size().bytes()
    base: Addr = stack.bottom -% ByteSize.construct(bytes: page)
    pages.release(at: base, size: stack.size().bytes() + page)
    return

### Makes a `FiberState` from its fields.
### :param sp: Its `sp`.
### :param stack: Its `stack`.
### :param manager: Its `manager`.
### :param slot: Its `slot`.
### :param work: Its `work`.
### :param then: Its `then`.
### :param wake_state: Its `wake_state`.
### :param timer: Its `timer`.
### :param trace_depth: Its `trace_depth`.
### :param access: Its `access`.
### :param race: Its `race`.
### :param next_idle: Its `next_idle`.
### :param next_all: Its `next_all`.
### :param pool: Its `pool`.
### :returns: The new value.
@target(os: not "none")
common routine FiberState.construct(sp: Addr, stack: StackManager, manager: @FiberManager,
    slot: WorkSlot, work: @WorkSlot, then: Callable[(@FiberManager, @Me), None], wake_state: U32,
    timer: U64, trace_depth: U64, access: @AccessFlow, race: Addr, next_idle: @Me, next_all: @Me,
    pool: @ThreadPoolManager) -> Me
    return Me(sp, stack, manager, slot, work, then, wake_state, timer, trace_depth, access, race,
        next_idle, next_all, pool)

### Releases the block of its last work. Its stack is its manager's to give back.
@target(os: not "none")
routine @FiberState.destruct() -> None
    me.slot.destruct()
    return

### Makes a `Fiber` from its fields.
### :param fiber: Its `fiber`.
### :param issued: Its `issued`.
### :returns: The new value.
@target(os: not "none")
common routine Fiber[T].construct(fiber: @FiberState, issued: U64) -> Me
needs T: typename
    return Me(fiber, issued)

### Crashes when the ticket wasn't given back: its fiber would be lost, and its work might still run.
### :throws: Crashes with `TicketNotGivenBackError` for a ticket that still holds its fiber.
@target(os: not "none")
@track_caller
routine @Fiber[T].destruct() -> None
needs T: typename
    fiber: @FiberState = me.fiber.peek()
    if fiber.is_hollow()
        return
    if fiber.slot.issued.peek() == me.issued.peek()
        crash(name: "TicketNotGivenBackError",
            message: "This fiber ticket was never given back: wait_finished() and give_back() before it goes.")
    return

### Orders two timer keys by when they are due: the earlier deadline first, and the earlier wait first for the same
### deadline.
### :param other: The key to compare with.
### :returns: -1 when `me` is due first, 0 for the same key, and 1 when `other` is due first.
routine TimerKey.compare(other: Me) -> S32
    if me.deadline == other.deadline
        return me.seq.compare(other.seq)
    return me.deadline.compare(other.deadline)

### A manager whose fibers have stacks of `stack_size` bytes on pages from `stack_manager`, driven by the thread that makes it
### until another drives it. Each stack is whole pages with one more page below it, which `protect` closes: a fiber
### whose stack runs out stops the program there.
### :param stack_size: The size of each fiber's stack.
### :param stack_manager: The page manager the fibers' stacks come from, such as `PAGES`: its table handles pages.
### :param manager: Where the fiber records and the queues come from.
### :returns: The manager, with no fibers.
@target(os: not "none")
common routine FiberManager.construct(stack_size: ByteSize, stack_manager: @MemoryManager,
    manager: @MemoryManager) -> Me
    return Me(manager, stack_manager, stack_size, owner: thread_mark(), home: .hollow(),
        home_race: .hollow(), current: .hollow(),
        ready: CircularList[@FiberState].construct(manager), inbox_lock: .construct(),
        inbox: CircularList[@FiberState].construct(manager), epoch: 0, alert: .hollow(), busy: 0,
        idle: .hollow(), all: .hollow(),
        timers: PriorityQueue[TimerKey, @FiberState].construct(manager), timer_seq: 0)

### Frees every fiber with its stack, and the queues. The fibers whose work never finished are dropped where they
### stand.
@target(os: not "none")
routine @FiberManager.destruct() -> None
    if me.manager.peek().is_hollow()
        return
    until fiber.is_hollow() with fiber: @FiberState = me.all.peek()
        next: @FiberState = fiber.next_all.peek()
        fiber.destruct()
        AccessManager.end_flow(fiber.access)
        race_stack_free(fiber.race.peek())
        give_back_stack(stack: fiber.stack.peek(), pages: me.stack_manager.peek())
        deallocate(data: fiber, manager: me.manager.peek())
        continue with fiber: next
    me.ready.destruct()
    me.inbox.destruct()
    me.timers.destruct()
    me.poke(.hollow())
    return

### Makes the manager on first use, if it is a hollow one (FIBERS starts hollow).
@target(os: not "none")
secret routine @FiberManager.ensure() -> None
    if me.manager.peek().is_hollow()
        # A thread worker releases its FIBERS before it takes the next ticket's work.
        me.poke(Me.construct(stack_size: DEFAULT_FIBER_STACK, stack_manager: PAGES, manager: HEAP))
        if me !== FIBERS
            return
        THREAD_CLEANUP.poke(release_fibers.to[Callable]())
        return
    return

### Releases this thread's FIBERS: what a thread worker calls once a ticket's work is over.
@target(os: not "none")
secret routine release_fibers() -> None
    drop FIBERS
    return

### A ticket for one of the manager's fibers: one given back, or a new one with a stack of its own.
### :typeparam T: The type of the work's result, `Void` for none.
### :returns: The ticket, with no work yet.
### :throws: Crashes with `MemoryAllocationError` when there is no memory for the fiber or its stack.
@target(os: not "none")
@track_caller
routine @FiberManager.get_fiber[T]() -> Fiber[T]
needs T: typename
    me.ensure()
    me.inbox_lock.lock()
    idle: @FiberState = me.idle.peek()
    if idle.is_hollow()
        me.inbox_lock.unlock()
        fiber: @FiberState = me.make_fiber()
        return Fiber[T](fiber, issued: 0)
    me.idle.poke(idle.next_idle.peek())
    me.inbox_lock.unlock()
    idle.next_idle.poke(.hollow())
    idle.slot.state.poke_atomic(TICKET_EMPTY)
    return Fiber[T](fiber: idle, issued: idle.slot.issued.peek())

### A new fiber with a stack of its own, which first runs `fiber_start` once it has work.
### :returns: The fiber.
@target(os: not "none")
@track_caller
secret routine @FiberManager.make_fiber() -> @FiberState
    stack: StackManager = take_stack(size: me.stack_size.peek(), pages: me.stack_manager.peek())
    if stack.top.is_hollow()
        crash_allocation()
    fiber: @FiberState = allocate[FiberState](count: 1, manager: me.manager.peek())
    if fiber.is_hollow()
        crash_allocation()
    sp: Addr = initial_stack(stack: stack.bottom, size: stack.size().bytes(),
        entry: fiber_start.addr())
    fiber.poke(FiberState(sp, stack, manager: me, slot: .construct(manager: me.manager.peek()),
        work: fiber.slot, then: requeue.to[Callable](), wake_state: FIBER_RUNNING, timer: 0,
        trace_depth: 0, access: .hollow(), race: race_stack_new(), next_idle: .hollow(),
        next_all: me.all.peek(), pool: .hollow()))
    me.all.poke(fiber)
    return fiber

### The fiber running this code, if it is one of this manager's, or null: its handle for wake.
### :returns: The running fiber's handle, or null.
@target(os: not "none")
routine @FiberManager.current() -> @FiberState
    waiter: Waiter = current_waiter()
    if waiter.manager === me
        return waiter.fiber.to[@FiberState]()
    return .hollow()

### Inside a fiber: lets the other ready fibers run first, then goes on. Outside one it does nothing.
@target(os: not "none")
routine @FiberManager.yield() -> None
    local fiber: @FiberState = me.current()

    if fiber.is_hollow()
        return
    # The manager queues the fiber once it is back on its own stack (see resume).
    race_stack_switch(me.home_race.peek())
    switch_stack(from: fiber.sp, to: me.home.peek())
    return

### Inside a fiber: waits until wake is called with its handle, or returns at once for a wake that came since the
### last park. It may also return without one, so a fiber checks what it waits for again. Outside a fiber it returns.
@target(os: not "none")
routine @FiberManager.park() -> None
    local fiber: @FiberState = me.current()

    if fiber.is_hollow()
        return
    if compare_exchange(at: fiber.wake_state, expected: FIBER_RUNNING, new: FIBER_PARKING)
        # A wake came first: this park is over before it starts.
        # The manager decides, once the fiber is off its stack, whether a wake came meanwhile (see commit_park).
        fiber.then.poke(commit_park.to[Callable]())
        race_stack_switch(me.home_race.peek())
        switch_stack(from: fiber.sp, to: me.home.peek())
        return
    fiber.wake_state.poke_atomic(FIBER_RUNNING)
    return

### Inside a fiber: park, and a wake comes on its own at `deadline` (in `Clock.monotonic()` time) if none came before.
### Outside a fiber it returns.
### :param deadline: When the fiber goes on without a wake.
@target(os: not "none")
@reshaping
routine @FiberManager.park_until(deadline: Duration) -> None
    local fiber: @FiberState = me.current()

    if fiber.is_hollow()
        return
    seq: U64 = me.timer_seq.peek() + 1
    me.timer_seq.poke(seq)
    # Atomic: a pool's fiber may go on on another thread while this manager's timer still holds it.
    fiber.timer.poke_atomic(seq)
    me.timers.add(priority: TimerKey(deadline, seq), element: fiber)
    me.park()
    fiber.timer.poke_atomic(0)
    return

### Lets fiber, one of this manager's fibers, go on: if it is parked it is queued, and if not its next park returns at
### once. From any thread, inside a fiber or out.
### :param fiber: The handle of the fiber to wake, from {FiberManager.current}.
@target(os: not "none")
@reshaping
routine @FiberManager.wake(fiber: @FiberState) -> None
    while true
        state: U32 = fiber.wake_state.peek_atomic()
        if state == FIBER_PARKED
            if compare_exchange(at: fiber.wake_state, expected: FIBER_PARKED, new: FIBER_RUNNING)
                break
            continue
        if state == FIBER_NOTIFIED
            return
        if compare_exchange(at: fiber.wake_state, expected: state, new: FIBER_NOTIFIED)
            return
        continue
    me.place_ready(fiber)
    return

### Inside a fiber: waits at least `duration` while the thread goes on with the other fibers. Outside one the thread
### waits.
### :param duration: The least time to wait.
@target(os: not "none")
@reshaping
routine @FiberManager.waitfor(duration: Duration) -> None
    local deadline: Duration = Clock.monotonic() +^ duration
    local fiber: @FiberState = me.current()

    if fiber.is_hollow()
        sleep_thread(deadline)
        return
    # A pool's fiber may go on on another thread after a park, so each park goes through the manager running it.
    while Clock.monotonic() < deadline
        fiber.manager.peek().park_until(deadline)
    then
        return

### Runs the fibers until none has work left. The thread that calls it drives the manager from here on.
@target(os: not "none")
@reshaping
routine @FiberManager.run() -> None
    me.ensure()
    me.drive(awaited: .hollow(), deadline: Duration.MAX, idle_only: false)
    return

### Runs the fibers that are ready, and those they make ready, until none is, then returns: for a thread that takes
### other work between turns. The thread that calls it drives the manager from here on.
@target(os: not "none")
@reshaping
routine @FiberManager.run_until_idle() -> None
    me.ensure()
    me.drive(awaited: .hollow(), deadline: Duration.MAX, idle_only: true)
    return

### How long the thread that drives the manager may sleep before a fiber waiting with a deadline is due: for a thread
### that drives it between other work and sleeps on a word of its own (see wake_through).
### :returns: The time until the earliest deadline (0 when it has passed), or `Duration.MAX` for none.
@target(os: not "none")
routine @FiberManager.idle_wait() -> Duration
    me.ensure()
    return me.timer_wait()

### Makes a wake from another thread change `word` and wake whoever sleeps on it, instead of the manager's own word:
### for a thread that drives the manager between other work and sleeps on `word` for both.
### :param word: The word, or null for the manager's own.
@target(os: not "none")
routine @FiberManager.wake_through(word: @U32) -> None
    me.ensure()
    me.alert.poke(word)
    return

### The word a wake from another thread changes.
### :returns: `alert`, or the manager's own `epoch`.
@target(os: not "none")
secret routine @FiberManager.wake_word() -> @U32
    alert: @U32 = me.alert.peek()
    if alert.is_hollow()
        return me.epoch
    return alert

### Runs work(arg), a call that may block the thread it runs on, without stopping the other fibers: inside a fiber a
### thread ticket runs it while the fiber waits, and the fiber goes on once it returns. Outside a fiber it is just
### called. arg may point into the fiber's stack: the fiber waits until the call is over.
### :typeparam T: The type of the state the call works on.
### :param work: The call that may block.
### :param arg: The state it works on.
@target(os: not "none")
routine @FiberManager.run_blocking[T](work: Callable[(@T,), None], arg: @T) -> None
needs T: typename
    if me.current().is_hollow()
        work.call(arg)
        return
    t: Thread[None] = get_thread[None]()
    t.put_work(entry: work, args: arg)
    t.wait_finished()
    t.give_back()
    return

# -- the tickets -------------------------------------------------------------------------------------------------

### The slot the ticket's work lives in, for code that waits on several tickets at once.
### :returns: The slot.
### :throws: Crashes with `TicketGivenBackError` for a ticket given back.
@target(os: not "none")
@track_caller
routine Fiber[T].work_slot() -> @WorkSlot
needs T: typename
    fiber: @FiberState = me.fiber
    fiber.slot.check_ticket(me.issued)
    return fiber.slot

### Starts the work in `work`, run by `runner`, and queues the fiber.
### :param runner: Runs the work.
### :param work: Its block.
@target(os: not "none")
@track_caller
secret routine Fiber[T].start(runner: Callable[(Addr,), None], work: Addr) -> None
needs T: typename
    fiber: @FiberState = me.fiber
    manager: @FiberManager = fiber.manager.peek()
    me.work_slot().put(runner, work)
    manager.busy.atomic_fetch_add(1)
    manager.place_ready(fiber)
    return

### Starts `entry` on the ticket. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Fiber[T].put_work(entry: Callable[(), T]) -> None
needs T: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work0[T](entry, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Fiber[T].put_work[A](entry: Callable[(A,), T], args: A) -> None
needs T: typename, A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work1[T, A](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Fiber[T].put_work[A, B](entry: Callable[(A, B), T], args: (A, B)) -> None
needs T: typename, A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work2[T, A, B](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Fiber[T].put_work[A, B, C](entry: Callable[(A, B, C), T], args: (A, B, C)) -> None
needs T: typename, A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work3[T, A, B, C](entry, args, manager: slot.manager.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@target(os: not "none")
@track_caller
routine Fiber[T].put_work[A, B, C, D](entry: Callable[(A, B, C, D), T], args: (A, B, C, D)) -> None
