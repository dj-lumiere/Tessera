// Tessera stdlib: lists of fiber and job tickets
//
// Work spread over several fibers or FiberPool jobs keeps their tickets in a List[Fiber[T]] or a List[Job[T]], and
// these routines handle them together: wait for all, take every result, give all back, wait for whichever finishes
// first, cancel all, and take out or give back the ones that have finished.

module Standard/Fiber

import Standard/Alloc
import Standard/Collections
import Standard/Os

/// Waits until the work of every fiber ticket in the list has finished.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].wait_all_finished(me: @Me) -> Void
require T: typename
    jump next(0)

    block next(i: USize)
        branch i.ge(me.count())
            ? return()
            : continue
        me.getitem(i).wait_finished()
        jump next(i.add(1))

/// The results of the fiber tickets' finished work, in the list's order, in a list from `alloc`.
/// :param alloc: Where the list comes from.
/// :returns: The results.
/// :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].retrieve_all(me: @Me, alloc: @MemoryManager) -> List[T]
require T: typename
    local results: @List[T] <- .construct(alloc)

    jump next(0)

    block next(i: USize)
        branch i.ge(me.count())
            ? return(results.peek())
            : continue
        results.add_last(me.getitem(i).retrieve())
        jump next(i.add(1))

/// The results of the fiber tickets' finished work, in the list's order, in a list from DEFAULT_HEAP.
/// :returns: The results.
/// :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].retrieve_all(me: @Me) -> List[T]
require T: typename
    return(me.retrieve_all(alloc: DEFAULT_HEAP))

/// Gives every fiber ticket in the list back, and empties the list.
/// :throws: Crashes as each ticket's `give_back` does, when its work still runs.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].give_back_all(me: @Me) -> Void
require T: typename
    jump next(0)

    block next(i: USize)
        branch i.ge(me.count())
            ? done()
            : continue
        me.getitem(i).give_back()
        jump next(i.add(1))

    block done()
        me.clear()
        return()

/// Asks the work of every fiber ticket in the list to stop.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].cancel_all(me: @Me) -> Void
require T: typename
    jump next(0)

    block next(i: USize)
        branch i.ge(me.count())
            ? return()
            : continue
        me.getitem(i).cancel()
        jump next(i.add(1))

/// Waits until the work of one of the fiber tickets in the list has finished, and says which: the first in the list
/// among those finished when it looks.
/// :returns: The position of a ticket whose work has finished.
/// :throws: Crashes with `InvalidValueError` for an empty list.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].wait_any_finished(me: @Me) -> USize
require T: typename
    local waiter: Waiter = current_waiter()

    branch me.count().eq(0)
        ? crash(name: "InvalidValueError",
            message: "wait_any_finished of an empty list waits for nothing.")
        : look(0)

    // Each ticket keeps the waiter, so the first to finish wakes it: then it forgets every one.
    block look(i: USize)
        branch i.ge(me.count())
            ? park()
            : continue
        branch me.getitem(i).work_slot().register(waiter)
            ? found(i)
            : look(i.add(1))

    block park()
        waiter.park()
        jump forget(0, me.count())

    block found(i: USize)
        jump forget(0, i)

    block forget(k: USize, result: USize)
        branch k.ge(me.count())
            ? settle(result)
            : continue
        me.getitem(k).work_slot().unregister(waiter)
        jump forget(k.add(1), result)

    // After a park, the tickets are looked at again.
    block settle(result: USize)
        branch result.lt(me.count())
            ? return(result)
            : look(0)

/// Takes the fiber tickets whose work has finished out of the list, into a list from `alloc`, keeping the others
/// in order.
/// :param alloc: Where the list of finished tickets comes from.
/// :returns: The finished tickets, in the order they had.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].take_finished(me: @Me, alloc: @MemoryManager) -> Me
require T: typename
    local finished: @Me <- .construct(alloc)

    jump next(0, 0)

    block next(i: USize, kept: USize)
        branch i.ge(me.count())
            ? trim(kept)
            : continue
        ticket: Fiber[T] = me.getitem(i)
        branch ticket.check_finished()
            ? take(i, kept, ticket)
            : continue
        me.setitem(index: kept, value: ticket)
        jump next(i.add(1), kept.add(1))

    block take(i: USize, kept: USize, ticket: Fiber[T])
        finished.add_last(ticket)
        jump next(i.add(1), kept)

    block trim(kept: USize)
        branch me.count().gt(kept)
            ? continue
            : return(finished.peek())
        removed: Fiber[T] = me.remove_last()
        jump trim(kept)

/// Takes the fiber tickets whose work has finished out of the list, into a list from DEFAULT_HEAP.
/// :returns: The finished tickets, in the order they had.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].take_finished(me: @Me) -> Me
require T: typename
    return(me.take_finished(alloc: DEFAULT_HEAP))

/// Gives back the fiber tickets whose work has finished, and takes them out of the list: for work whose result
/// nobody needs.
#[target(os: not "none"), track_caller]
routine List[Fiber[T]].give_back_finished(me: @Me) -> Void
require T: typename
    jump next(0, 0)

    block next(i: USize, kept: USize)
        branch i.ge(me.count())
            ? trim(kept)
            : continue
        ticket: Fiber[T] = me.getitem(i)
        branch ticket.check_finished()
            ? give(i, kept, ticket)
            : continue
        me.setitem(index: kept, value: ticket)
        jump next(i.add(1), kept.add(1))

    block give(i: USize, kept: USize, ticket: Fiber[T])
        ticket.give_back()
        jump next(i.add(1), kept)

    block trim(kept: USize)
        branch me.count().gt(kept)
            ? continue
            : return()
        removed: Fiber[T] = me.remove_last()
        jump trim(kept)

/// Waits until the work of every job ticket in the list has finished.
#[target(os: not "none"), track_caller]
routine List[Job[T]].wait_all_finished(me: @Me) -> Void
require T: typename
    jump next(0)

    block next(i: USize)
        branch i.ge(me.count())
            ? return()
            : continue
        me.getitem(i).wait_finished()
        jump next(i.add(1))

