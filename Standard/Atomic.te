    previous: Me) -> Bool
needs T: typename, AtomicExchangeable[T]

### Writes new if the value here is expected, atomically and release: None if it did,
### the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Ptr[T].atomic_compare_exchange_weak_release(me: Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    local previous: @T <- .hollow()

    swapped: Bool = me.atomic_compare_exchange_weak_release_raw(expected, new, previous)
    value: T = previous.peek()
    if swapped
        return None()
    else
        return value

### Writes `new` if the value here is `expected`, atomically and acquire and release, and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is acquire.
### :typeparam T: The pointee type, which must support the operation atomically on the target.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} acq_rel acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine Ptr[T].atomic_compare_exchange_weak_acq_rel_raw(me: Me, expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, AtomicExchangeable[T]

### Writes new if the value here is expected, atomically and acquire and release: None if it did,
### the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Ptr[T].atomic_compare_exchange_weak_acq_rel(me: Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    local previous: @T <- .hollow()

    swapped: Bool = me.atomic_compare_exchange_weak_acq_rel_raw(expected, new, previous)
    value: T = previous.peek()
    if swapped
        return None()
    else
        return value

# -- Atomic[T] -------------------------------------------------------------------

### A value every access to which is atomic: the type says it, where an `@T` says it only at each access. It sits at
### an address aligned to T's size, so a 64-bit one is 8-aligned on 32-bit targets too. Threads share the place
### (`@Atomic[T]`), not copies, which would be other values. The operations and their memory orders are `@T`'s
### `atomic_*` ones without the prefix: `peek`, `poke`, `swap`, `compare_exchange`, `fetch_add`, ..., each with the
### same order suffixes.
### :typeparam T: The value type, which must be atomic on the target.
@layout(align: sizeof[T]())
record Atomic[T]
needs T: typename, AtomicStorable[T]
    value: T

### An atomic holding `value`.
### :param value: The value it starts with.
### :returns: The new value.
routine Atomic[T].construct(value: T) -> Me
needs T: typename, AtomicStorable[T]
    return Me(value)

### Releases nothing: an `Atomic` holds no memory of its own.
routine Atomic[T].destruct(me: @Me) -> None
needs T: typename, AtomicStorable[T]
    return

### Reads the value atomically, sequentially consistent.
### :returns: The value.
routine Atomic[T].peek(me: @Me) -> T
needs T: typename, AtomicStorable[T]
    return me.value.peek_atomic()

### Reads the value atomically, relaxed (only atomic).
### :returns: The value.
routine Atomic[T].peek_relaxed(me: @Me) -> T
needs T: typename, AtomicStorable[T]
    return me.value.peek_atomic_relaxed()

### Reads the value atomically, acquire.
### :returns: The value.
routine Atomic[T].peek_acquire(me: @Me) -> T
needs T: typename, AtomicStorable[T]
    return me.value.peek_atomic_acquire()

### Writes `value` atomically, sequentially consistent.
### :param value: The value to write.
routine Atomic[T].poke(me: @Me, value: T) -> None
needs T: typename, AtomicStorable[T]
    me.value.poke_atomic(value)
    return

### Writes `value` atomically, relaxed (only atomic).
### :param value: The value to write.
routine Atomic[T].poke_relaxed(me: @Me, value: T) -> None
needs T: typename, AtomicStorable[T]
    me.value.poke_atomic_relaxed(value)
    return

### Writes `value` atomically, release.
### :param value: The value to write.
routine Atomic[T].poke_release(me: @Me, value: T) -> None
needs T: typename, AtomicStorable[T]
    me.value.poke_atomic_release(value)
    return

### Writes `value` and returns what was there, atomically and sequentially consistent.
### :param value: The value to write.
### :returns: The value that was there before.
routine Atomic[T].swap(me: @Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_swap(value)

### Writes `value` and returns what was there, atomically and relaxed (only atomic).
### :param value: The value to write.
### :returns: The value that was there before.
routine Atomic[T].swap_relaxed(me: @Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_swap_relaxed(value)

### Writes `value` and returns what was there, atomically and acquire.
### :param value: The value to write.
### :returns: The value that was there before.
routine Atomic[T].swap_acquire(me: @Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_swap_acquire(value)

### Writes `value` and returns what was there, atomically and release.
### :param value: The value to write.
### :returns: The value that was there before.
routine Atomic[T].swap_release(me: @Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_swap_release(value)

### Writes `value` and returns what was there, atomically and acquire and release.
### :param value: The value to write.
### :returns: The value that was there before.
routine Atomic[T].swap_acq_rel(me: @Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_swap_acq_rel(value)

### Writes `new` if the value is `expected`, atomically and sequentially consistent: `Unit` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Atomic[T].compare_exchange(me: @Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_compare_exchange(expected, new)

### Writes `new` if the value is `expected`, atomically and relaxed (only atomic): `Unit` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Atomic[T].compare_exchange_relaxed(me: @Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_compare_exchange_relaxed(expected, new)

### Writes `new` if the value is `expected`, atomically and acquire: `Unit` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Atomic[T].compare_exchange_acquire(me: @Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_compare_exchange_acquire(expected, new)

### Writes `new` if the value is `expected`, atomically and release: `Unit` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Atomic[T].compare_exchange_release(me: @Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_compare_exchange_release(expected, new)

### Writes `new` if the value is `expected`, atomically and acquire and release: `Unit` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Atomic[T].compare_exchange_acq_rel(me: @Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_compare_exchange_acq_rel(expected, new)

### Writes `new` if the value is `expected`, atomically and sequentially consistent: `Unit` if it did, the value found if
### not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `Unit` when `new` was written, the value found (a `T`) when not.
routine Atomic[T].compare_exchange_weak(me: @Me, expected: T, new: T) -> Result[None, T]
needs T: typename, AtomicExchangeable[T]
    return me.value.atomic_compare_exchange_weak(expected, new)

### Writes `new` if the value is `expected`, atomically and relaxed (only atomic): `Unit` if it did, the value found if
### not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop.
