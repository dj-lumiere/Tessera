# Tessera stdlib: atomics
#
# A value whose every access is atomic is an Atomic[T]: the type says it, and its operations are the ones below
# without the atomic_ prefix. Memory whose type the program doesn't choose (from C, shared with another process, a
# futex word) is reached per access instead, like a volatile access: atomic_* routines on @T next to peek and poke.
# The memory order is a name suffix: none is sequentially consistent, _relaxed, _acquire, _release, and
# _acq_rel choose weaker ones, and each operation has only the orders LLVM allows for it (a load can't release, a
# store can't acquire). compare_exchange's failure order follows its success order.
#
# What an atomic can do depends on T and on the target, so each routine requires a marker concept, declared below
# per type and target: AtomicStorable (load, store), AtomicExchangeable (swap, compare_exchange: integers, bytes, and
# pointers, since LLVM's cmpxchg takes no float), AtomicAddable (fetch_add, fetch_sub: integers), AtomicMaskable
# (fetch_and, fetch_or, fetch_xor), and AtomicFloatAddable (fetch_fadd, fetch_fsub: B32, B64). An access wider than the
# target does lock-free is a build error, never a hidden libatomic call or interrupt masking: bare metal has no
# libatomic, a hosted one may take a lock, and masking interrupts is wrong on a multicore MCU. So 64-bit atomics
# exist on x86, AArch64, A-profile ARM, and riscv64 with A, 32-bit ones on ARMv7-M and riscv32 with A, 128-bit ones
# on x86-64 with cx16 (x86-64-v2 and up), and none on Cortex-M0 or RISC-V without A. Bool has none yet: use a U8 flag.
#
# The address must be aligned to T's size. A U64 field of a record has
# alignment 4 on some 32-bit ABIs, so put a 64-bit atomic where it's 8-aligned there.

module Standard/Core

# -- capabilities ----------------------------------------------------------------

### peek_atomic and poke_atomic are lock-free for T on the target.
protocol AtomicStorable[T]
needs T: typename

### atomic_swap and atomic_compare_exchange are lock-free for T on the target.
protocol AtomicExchangeable[T]
needs T: typename

### atomic_fetch_add and atomic_fetch_sub are lock-free for T on the target.
protocol AtomicAddable[T]
needs T: typename

### atomic_fetch_and, atomic_fetch_or, and atomic_fetch_xor are lock-free for T on the target.
protocol AtomicMaskable[T]
needs T: typename

### atomic_fetch_fadd and atomic_fetch_fsub are lock-free for T on the target.
protocol AtomicFloatAddable[T]
needs T: typename

# -- what each target does lock-free --------------------------------------------

# 64 bits: x86-64 (lock-prefixed instructions), i686 (cmpxchg8b), AArch64, A-profile ARM from v6K
# (ldrexd), riscv64 with A.
@target(arch: "x86_64")
obeys AtomicStorable[S8], AtomicStorable[U8], AtomicStorable[S16], AtomicStorable[U16], AtomicStorable[S32], AtomicStorable[U32], AtomicStorable[S64], AtomicStorable[U64], AtomicStorable[USize], AtomicStorable[SSize], AtomicStorable[Byte], AtomicStorable[Addr], AtomicStorable[B32], AtomicStorable[B64]
@target(arch: "x86_64")
obeys AtomicStorable[@T] when T: typename
@target(arch: "x86_64")
obeys AtomicExchangeable[S8], AtomicExchangeable[U8], AtomicExchangeable[S16], AtomicExchangeable[U16], AtomicExchangeable[S32], AtomicExchangeable[U32], AtomicExchangeable[S64], AtomicExchangeable[U64], AtomicExchangeable[USize], AtomicExchangeable[SSize], AtomicExchangeable[Byte], AtomicExchangeable[Addr]
@target(arch: "x86_64")
obeys AtomicExchangeable[@T] when T: typename
@target(arch: "x86_64")
obeys AtomicAddable[S8], AtomicAddable[U8], AtomicAddable[S16], AtomicAddable[U16], AtomicAddable[S32], AtomicAddable[U32], AtomicAddable[S64], AtomicAddable[U64], AtomicAddable[USize], AtomicAddable[SSize]
@target(arch: "x86_64")
obeys AtomicMaskable[S8], AtomicMaskable[U8], AtomicMaskable[S16], AtomicMaskable[U16], AtomicMaskable[S32], AtomicMaskable[U32], AtomicMaskable[S64], AtomicMaskable[U64], AtomicMaskable[USize], AtomicMaskable[SSize], AtomicMaskable[Byte]
@target(arch: "x86_64")
obeys AtomicFloatAddable[B32], AtomicFloatAddable[B64]

