# -- fences ----------------------------------------------------------------------

### Orders memory accesses around it across threads and cores, sequentially consistent.
@external("llvm")
@template("fence seq_cst")
routine fence() -> None

### Orders memory accesses around it across threads and cores, acquire.
@external("llvm")
@template("fence acquire")
routine fence_acquire() -> None

### Orders memory accesses around it across threads and cores, release.
@external("llvm")
@template("fence release")
routine fence_release() -> None

### Orders memory accesses around it across threads and cores, acquire and release.
@external("llvm")
@template("fence acq_rel")
routine fence_acq_rel() -> None

### Orders memory accesses around it for the compiler only, sequentially consistent: against an interrupt handler on the same
### core, with no barrier instruction.
@external("llvm")
@template("fence syncscope(\"singlethread\") seq_cst")
routine compiler_fence() -> None

### Orders memory accesses around it for the compiler only, acquire: against an interrupt handler on the same
### core, with no barrier instruction.
@external("llvm")
@template("fence syncscope(\"singlethread\") acquire")
routine compiler_fence_acquire() -> None

### Orders memory accesses around it for the compiler only, release: against an interrupt handler on the same
### core, with no barrier instruction.
@external("llvm")
@template("fence syncscope(\"singlethread\") release")
routine compiler_fence_release() -> None

### Orders memory accesses around it for the compiler only, acquire and release: against an interrupt handler on the same
### core, with no barrier instruction.
@external("llvm")
@template("fence syncscope(\"singlethread\") acq_rel")
routine compiler_fence_acq_rel() -> None
