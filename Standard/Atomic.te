# -- load and store --------------------------------------------------------------

### Reads the T at this address atomically, sequentially consistent.
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} seq_cst, align {sizeof T}")
routine Ptr[T].peek_atomic(me: Me) -> T
needs T: typename, AtomicStorable[T]

### Reads the T at this address atomically, relaxed (only atomic).
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} monotonic, align {sizeof T}")
routine Ptr[T].peek_atomic_relaxed(me: Me) -> T
needs T: typename, AtomicStorable[T]

### Reads the T at this address atomically, acquire.
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} acquire, align {sizeof T}")
routine Ptr[T].peek_atomic_acquire(me: Me) -> T
needs T: typename, AtomicStorable[T]

### Writes value to this address atomically, sequentially consistent.
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} seq_cst, align {sizeof T}")
routine Ptr[T].poke_atomic(me: Me, value: T) -> None
needs T: typename, AtomicStorable[T]

### Writes value to this address atomically, relaxed (only atomic).
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} monotonic, align {sizeof T}")
routine Ptr[T].poke_atomic_relaxed(me: Me, value: T) -> None
needs T: typename, AtomicStorable[T]

### Writes value to this address atomically, release.
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} release, align {sizeof T}")
routine Ptr[T].poke_atomic_release(me: Me, value: T) -> None
needs T: typename, AtomicStorable[T]

# -- read-modify-write -----------------------------------------------------------

### Writes value and returns what was there, atomically and sequentially consistent.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} seq_cst, align {sizeof T}")
routine Ptr[T].atomic_swap(me: Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]

### Writes value and returns what was there, atomically and relaxed (only atomic).
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} monotonic, align {sizeof T}")
routine Ptr[T].atomic_swap_relaxed(me: Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]

### Writes value and returns what was there, atomically and acquire.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} acquire, align {sizeof T}")
routine Ptr[T].atomic_swap_acquire(me: Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]

### Writes value and returns what was there, atomically and release.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} release, align {sizeof T}")
routine Ptr[T].atomic_swap_release(me: Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]

### Writes value and returns what was there, atomically and acquire and release.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} acq_rel, align {sizeof T}")
routine Ptr[T].atomic_swap_acq_rel(me: Me, value: T) -> T
needs T: typename, AtomicExchangeable[T]

### Adds value (wrapping) and returns what was there, atomically and sequentially consistent.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} seq_cst, align {sizeof T}")
routine Ptr[T].atomic_fetch_add(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Adds value (wrapping) and returns what was there, atomically and relaxed (only atomic).
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} monotonic, align {sizeof T}")
routine Ptr[T].atomic_fetch_add_relaxed(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Adds value (wrapping) and returns what was there, atomically and acquire.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} acquire, align {sizeof T}")
routine Ptr[T].atomic_fetch_add_acquire(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Adds value (wrapping) and returns what was there, atomically and release.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} release, align {sizeof T}")
routine Ptr[T].atomic_fetch_add_release(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Adds value (wrapping) and returns what was there, atomically and acquire and release.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} acq_rel, align {sizeof T}")
routine Ptr[T].atomic_fetch_add_acq_rel(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Subtracts value (wrapping) and returns what was there, atomically and sequentially consistent.
### :param value: The value to subtract.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw sub ptr {me}, {T} {value} seq_cst, align {sizeof T}")
routine Ptr[T].atomic_fetch_sub(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Subtracts value (wrapping) and returns what was there, atomically and relaxed (only atomic).
### :param value: The value to subtract.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw sub ptr {me}, {T} {value} monotonic, align {sizeof T}")
routine Ptr[T].atomic_fetch_sub_relaxed(me: Me, value: T) -> T
needs T: typename, AtomicAddable[T]

### Subtracts value (wrapping) and returns what was there, atomically and acquire.
### :param value: The value to subtract.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw sub ptr {me}, {T} {value} acquire, align {sizeof T}")
routine Ptr[T].atomic_fetch_sub_acquire(me: Me, value: T) -> T
