// Tessera stdlib: parsing floats
//
// F64.parse, F32.parse, F16.parse, and BF16.parse read decimal text and round
// it correctly (to nearest, ties to even), however many digits it has.
//
//     [+-] digits [. digits] [(e|E) [+-] digits]      at least one mantissa digit
//     [+-] inf | infinity | nan                        any letter case
//
// "5." and ".5" are accepted; whitespace is not. Errors are ParseFloatError:
// Empty for "", Invalid for anything else that doesn't match.
//
// The method is exact, not fast: the value becomes a fraction N / D of big
// naturals, and a bit-by-bit division gives the significand plus a remainder
// for rounding. Only the first significant digits are kept; later ones only
// record whether any was nonzero, which is enough to break a tie as long as
// every exactly-halfway decimal fits in the kept digits: 767 digits for F64,
// 11,563 for F128. So F64 and the smaller formats keep 800 digits in a
// BigNat<72>, and F128 keeps 11,600 in a BigNat<864> (Standard/BigNat.tess).

module Standard::Format

/// Why parsing float text failed: `Empty` for an empty string, `Invalid` for anything else that does not match the float grammar.
choice ParseFloatError: U8
    Empty
    Invalid

/// What kind of value a parsed decimal text denotes: an ordinary number, an infinity, or a NaN.
choice DecimalKind: U8
    Finite
    Infinity
    Nan

/// The parsed text: value = digits × 10^exponent, digits kept in a BigNat.
record DecimalParts
    kind     : DecimalKind
    negative : Bool
    kept     : S64  // significant digits kept
    exponent : S64
    sticky   : Bool  // a nonzero digit was dropped after the kept ones

// -- text ----------------------------------------------------------------------

/// True when the byte is an ASCII digit `0` to `9`.
/// :param c: The byte to test.
/// :returns: True when the byte is between `0` and `9`.
routine is_ascii_digit(c: Byte) -> Bool
    block entry()
        r : Bool = c.between(b'0', b'9')
        return(r)

/// Is text[0..count) word, ignoring ASCII letter case? word must be lowercase letters.
routine matches_word(text: @Byte, count: USize, word: Bytes) -> Bool
    block entry()
        word_count : USize = word.count
        letters    : @Byte = word.data
        same_count : Bool  = count.eq(word_count)
        branch same_count
            ? loop(0, letters)
            : return(false)

    block loop(i: USize, letters: @Byte)
        done : Bool = i.ge(count)
        branch done
            ? return(true)
            : continue
        c      : Byte = text.stride(i).load()
        w      : Byte = letters.stride(i).load()
        folded : Byte = c.bitor(0x20)
        same   : Bool = folded.eq(w)
        branch same
            ? loop(i.add(1), letters)
            : return(false)

/// Reads text into DecimalParts, accumulating the kept digits in digits.
routine parse_decimal<N>(text: Bytes, digits: @BigNat<N>,
    max_kept: S64) -> Result<DecimalParts, ParseFloatError>
require N: USize
    block entry()
        digits.set(U64.MIN)
        count : USize = text.count
        empty : Bool  = count.eq(0)
        branch empty
            ? fail(ParseFloatError.Empty)
            : sign()

    block sign()
        data  : @Byte = text.data
        c     : Byte  = data.stride(0).load()
        minus : Bool  = c.eq(b'-')
        plus  : Bool  = c.eq(b'+')
        skip  : Bool  = minus.bitor(plus)
        jump body(skip.to<USize>(), minus)

    block body(start: USize, negative: Bool)
        data : @Byte = text.data
        rest : @Byte = data.stride(start)
        left : USize = text.count.sub(start)
        inf  : Bool  = matches_word(rest, left, "inf").bitor(matches_word(rest, left, "infinity"))
        nan  : Bool  = matches_word(rest, left, "nan")
        when
            inf  -> special(DecimalKind.Infinity, negative)
            nan  -> special(DecimalKind.Nan, negative)
            else -> int_loop(start, negative, 0, 0, false, false)

    block special(kind: DecimalKind, negative: Bool)
        parts : DecimalParts                          = DecimalParts { kind: kind,
            negative: negative, kept: 0, exponent: 0, sticky: false }
        r     : Result<DecimalParts, ParseFloatError> = .Success(parts)
        return(r)

    // Integer digits. Leading zeros are skipped; digits past the cap raise the exponent.
    block int_loop(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, seen: Bool)
        at_end : Bool = i.ge(text.count)
        branch at_end
            ? done(negative, kept, exponent, sticky, seen)
            : int_char(i, negative, kept, exponent, sticky, seen)

    block int_char(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, seen: Bool)
        data  : @Byte = text.data
        c     : Byte  = data.stride(i).load()
        code  : U8    = c.to<U8>()
        digit : Bool  = is_ascii_digit(c)
        point : Bool  = c.eq(b'.')
        when
            digit -> int_digit(i, negative, kept, exponent, sticky,
                code.sub(b'0'.to<U8>()).to<U64>())
            point -> frac_loop(i.add(1), negative, kept, exponent, sticky, seen)
            else  -> exponent_mark(i, negative, kept, exponent, sticky, seen)

    block int_digit(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, d: U64)
        leading : Bool  = kept.eq(0).bitand(d.eq(0))
        full    : Bool  = kept.ge(max_kept)
        next    : USize = i.add(1)
        when
            leading -> int_loop(next, negative, kept, exponent, sticky, true)
            full    -> int_loop(next, negative, kept, exponent.add(1), sticky.bitor(d.ne(0)), true)
            else    -> int_keep(next, negative, kept, exponent, sticky, d)

    block int_keep(next: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, d: U64)
        digits.mul_add(10, d)
        jump int_loop(next, negative, kept.add(1), exponent, sticky, true)

    // Fraction digits. Each one kept, or each leading zero, lowers the exponent.
    block frac_loop(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, seen: Bool)
        at_end : Bool = i.ge(text.count)
        branch at_end
            ? done(negative, kept, exponent, sticky, seen)
            : frac_char(i, negative, kept, exponent, sticky, seen)

    block frac_char(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, seen: Bool)
        data  : @Byte = text.data
        c     : Byte  = data.stride(i).load()
        code  : U8    = c.to<U8>()
        digit : Bool  = is_ascii_digit(c)
        branch digit
            ? frac_digit(i, negative, kept, exponent, sticky, code.sub(b'0'.to<U8>()).to<U64>())
            : exponent_mark(i, negative, kept, exponent, sticky, seen)

    block frac_digit(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, d: U64)
        leading : Bool  = kept.eq(0).bitand(d.eq(0))
        full    : Bool  = kept.ge(max_kept)
        next    : USize = i.add(1)
        when
            leading -> frac_loop(next, negative, kept, exponent.sub(1), sticky, true)
            full    -> frac_loop(next, negative, kept, exponent, sticky.bitor(d.ne(0)), true)
            else    -> frac_keep(next, negative, kept, exponent, sticky, d)

    block frac_keep(next: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool, d: U64)
        digits.mul_add(10, d)
        jump frac_loop(next, negative, kept.add(1), exponent.sub(1), sticky, true)

    // After the mantissa only an exponent may follow: e or E, a sign, digits.
    block exponent_mark(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool,
        seen: Bool)
        data  : @Byte = text.data
        c     : Byte  = data.stride(i).load()
        mark  : Bool  = c.bitor(0x20).eq(b'e')
        valid : Bool  = mark.bitand(seen)
        branch valid
            ? exponent_sign(i.add(1), negative, kept, exponent, sticky)
            : fail(ParseFloatError.Invalid)

    block exponent_sign(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool)
        at_end : Bool = i.ge(text.count)
        branch at_end
            ? fail(ParseFloatError.Invalid)
            : read_sign(i, negative, kept, exponent, sticky)

    block read_sign(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool)
        data      : @Byte = text.data
        c         : Byte  = data.stride(i).load()
        minus     : Bool  = c.eq(b'-')
        plus      : Bool  = c.eq(b'+')
        skip      : USize = minus.bitor(plus).to<USize>()
        first     : USize = i.add(skip)
        has_digit : Bool  = first.lt(text.count)
        branch has_digit
            ? exp_loop(first, negative, kept, exponent, sticky, minus, 0)
            : fail(ParseFloatError.Invalid)

    // The exponent saturates at 1,000,000, far past any float's range.
    block exp_loop(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool,
        exp_minus: Bool, value: S64)
        at_end : Bool = i.ge(text.count)
        branch at_end
            ? exp_done(negative, kept, exponent, sticky, exp_minus, value)
            : exp_char(i, negative, kept, exponent, sticky, exp_minus, value)

    block exp_char(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool,
        exp_minus: Bool, value: S64)
        data  : @Byte = text.data
        c     : Byte  = data.stride(i).load()
        digit : Bool  = is_ascii_digit(c)
        branch digit
            ? exp_digit(i, negative, kept, exponent, sticky, exp_minus, value, c)
            : fail(ParseFloatError.Invalid)

    block exp_digit(i: USize, negative: Bool, kept: S64, exponent: S64, sticky: Bool,
        exp_minus: Bool, value: S64, c: Byte)
        code     : U8  = c.to<U8>()
        d        : S64 = code.sub(b'0'.to<U8>()).to<S64>()
        appended : S64 = value.mul(10).add(d)
        next     : S64 = appended.min(1000000)
        jump exp_loop(i.add(1), negative, kept, exponent, sticky, exp_minus, next)

    block exp_done(negative: Bool, kept: S64, exponent: S64, sticky: Bool, exp_minus: Bool,
        value: S64)
        signed : S64 = exp_minus
            ? value.neg()
            : value
        jump done(negative, kept, exponent.add(signed), sticky, true)

    block done(negative: Bool, kept: S64, exponent: S64, sticky: Bool, seen: Bool)
        parts : DecimalParts                          = DecimalParts { kind: DecimalKind.Finite,
            negative: negative, kept: kept, exponent: exponent, sticky: sticky }
        r     : Result<DecimalParts, ParseFloatError> = .Success(parts)
        branch seen
            ? return(r)
            : fail(ParseFloatError.Invalid)

    block fail(error: ParseFloatError)
        r : Result<DecimalParts, ParseFloatError> = .Failure(error)
        return(r)

// -- rounding ------------------------------------------------------------------

/// The IEEE bits, without the sign, of the float nearest to the parsed value,
/// for a format with mantissa_bits stored bits, exponent bias bias, and
/// all-ones exponent exponent_max.
routine decimal_to_bits<N>(digits: @BigNat<N>, parts: DecimalParts, mantissa_bits: S64, bias: S64,
    exponent_max: S64, huge_from: S64, tiny_below: S64) -> U128
require N: USize
    block entry()
        infinity : U128        = exponent_max.to<U128>().shl(mantissa_bits.to<U128>())
        quiet    : U128        = 1.shl(mantissa_bits.sub(1).to<U128>())
        kind     : DecimalKind = parts.kind
        when kind
            DecimalKind.Infinity -> return(infinity)
            DecimalKind.Nan      -> return(infinity.bitor(quiet))
            DecimalKind.Finite   -> finite(infinity)

    // Below 10^tiny_below everything rounds to zero; from 10^huge_from up, to
    // infinity. In between, the numbers stay inside BigNat's capacity.
    block finite(infinity: U128)
        zero      : Bool = digits.is_zero()
        kept      : S64  = parts.kept
        exponent  : S64  = parts.exponent
        magnitude : S64  = kept.add(exponent)
        huge      : Bool = magnitude.gt(huge_from)
        tiny      : Bool = magnitude.lt(tiny_below)
        when
            zero -> return(0)
            tiny -> return(0)
            huge -> return(infinity)
            else -> scale(exponent, infinity)

    // value = n / d exactly
    block scale(exponent: S64, infinity: U128)
        claim d : @BigNat<N> <- uninit
        one : U64 = 1
        d.set(one)
        up : Bool = exponent.ge(0)
        branch up
            ? scale_up(exponent, infinity, d)
            : scale_down(exponent, infinity, d)

    block scale_up(exponent: S64, infinity: U128, d: @BigNat<N>)
        digits.mul_pow10(exponent.to<USize>())
        jump estimate(infinity, d)

    block scale_down(exponent: S64, infinity: U128, d: @BigNat<N>)
        d.mul_pow10(exponent.abs_diff(0).to<USize>())
        jump estimate(infinity, d)

    // Pick the binary exponent e so that q = floor(value / 2^e) has
    // mantissa_bits + 1 bits, or fewer at the subnormal floor.
    block estimate(infinity: U128, d: @BigNat<N>)
        num_bits  : S64 = digits.bit_length().to<S64>()
        log2      : S64 = num_bits.sub(d.bit_length().to<S64>())
        floor     : S64 = 1.sub(bias).sub(mantissa_bits)
        unclamped : S64 = log2.sub(mantissa_bits).sub(1)
        e         : S64 = unclamped.max(floor)
        claim a : @BigNat<N> <- uninit
        claim b : @BigNat<N> <- uninit
        claim t : @BigNat<N> <- uninit
        jump attempt(e, infinity, d, a, b, t)

    // a / b = value / 2^e
    block attempt(e: S64, infinity: U128, d: @BigNat<N>, a: @BigNat<N>, b: @BigNat<N>,
        t: @BigNat<N>)
        a.copy_from(digits)
        b.copy_from(d)
        negative_e : Bool = e.lt(0)
        branch negative_e
            ? widen_a(e, infinity, d, a, b, t)
            : widen_b(e, infinity, d, a, b, t)

    block widen_a(e: S64, infinity: U128, d: @BigNat<N>, a: @BigNat<N>, b: @BigNat<N>,
        t: @BigNat<N>)
        a.shl(e.abs_diff(0).to<USize>())
        jump divide(e, infinity, d, a, b, t)

    block widen_b(e: S64, infinity: U128, d: @BigNat<N>, a: @BigNat<N>, b: @BigNat<N>,
        t: @BigNat<N>)
        b.shl(e.to<USize>())
        jump divide(e, infinity, d, a, b, t)

    // The estimate can be one bit short; then q has a bit too many: try e + 1.
    block divide(e: S64, infinity: U128, d: @BigNat<N>, a: @BigNat<N>, b: @BigNat<N>, t: @BigNat<N>)
        q       : U128 = a.div_small(b, t, mantissa_bits.add(3).to<USize>())
        limit   : U128 = 1.shl(mantissa_bits.add(1).to<U128>())
        too_big : Bool = q.ge(limit)
        branch too_big
            ? attempt(e.add(1), infinity, d, a, b, t)
            : round(e, q, infinity, a, b)

    // Round to nearest, ties to even. The remainder is in a; compare 2a with b.
    block round(e: S64, q: U128, infinity: U128, a: @BigNat<N>, b: @BigNat<N>)
        a.shl(1)
        half    : S32  = a.compare(b)
        above   : Bool = half.gt(0)
        tie     : Bool = half.eq(0)
        sticky  : Bool = parts.sticky
        odd     : Bool = q.bitand(1).eq(1)
        up      : Bool = above.bitor(tie.bitand(sticky.bitor(odd)))
        rounded : U128 = q.add(up.to<U128>())
        // rounding up can carry into a new bit
        carry : Bool = rounded.eq(1.shl(mantissa_bits.add(1).to<U128>()))
        q2    : U128 = carry
            ? rounded.shr(1)
            : rounded
        e2     : S64  = e.add(carry.to<S64>())
        hidden : U128 = 1.shl(mantissa_bits.to<U128>())
        normal : Bool = q2.ge(hidden)
        biased : S64  = normal
            ? e2.add(mantissa_bits).add(bias)
            : 0
        overflow       : Bool = biased.ge(exponent_max)
        exponent_field : U128 = biased.to<U128>().shl(mantissa_bits.to<U128>())
        bits           : U128 = exponent_field.bitor(q2.bitand(hidden.sub(1)))
        branch overflow
            ? return(infinity)
            : return(bits)

// -- parse ---------------------------------------------------------------------

/// Parses decimal text into an F64, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
/// :param text: The text to parse.
/// :returns: `Success` with the nearest float, or `Failure` with the reason the text did not match.
/// :throws: Returns `Failure(ParseFloatError.Empty)` for an empty string and `Failure(ParseFloatError.Invalid)` for anything else that does not match.
/// :note: Overflow gives an infinity and underflow gives zero.
routine F64.parse(text: Bytes) -> Result<Self, ParseFloatError>
    block entry()
        claim digits : @BigNat<72> <- uninit
        parsed : Result<DecimalParts, ParseFloatError> = parse_decimal(text, digits, 800)
        when parsed
            .Success(parts) -> build(parts, digits)
            .Failure(error) -> fail(error)

    block build(parts: DecimalParts, digits: @BigNat<72>)
        magnitude : U64  = decimal_to_bits(digits, parts, 52, 1023, 2047, 310, -324).to<U64>()
        negative  : Bool = parts.negative
        sign      : U64  = negative
            ? 0x8000000000000000
            : 0
        value : Self                          = .from_bits(magnitude.bitor(sign))
        r     : Result<Self, ParseFloatError> = .Success(value)
        return(r)

    block fail(error: ParseFloatError)
        failed : Result<Self, ParseFloatError> = .Failure(error)
        return(failed)

/// Parses decimal text into an F32, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
/// :param text: The text to parse.
/// :returns: `Success` with the nearest float, or `Failure` with the reason the text did not match.
/// :throws: Returns `Failure(ParseFloatError.Empty)` for an empty string and `Failure(ParseFloatError.Invalid)` for anything else that does not match.
/// :note: Overflow gives an infinity and underflow gives zero.
routine F32.parse(text: Bytes) -> Result<Self, ParseFloatError>
    block entry()
        claim digits : @BigNat<72> <- uninit
        parsed : Result<DecimalParts, ParseFloatError> = parse_decimal(text, digits, 800)
        when parsed
            .Success(parts) -> build(parts, digits)
            .Failure(error) -> fail(error)

    block build(parts: DecimalParts, digits: @BigNat<72>)
        magnitude : U32  = decimal_to_bits(digits, parts, 23, 127, 255, 310, -324).to<U32>()
        negative  : Bool = parts.negative
        sign      : U32  = negative
            ? 0x80000000
            : 0
        value : Self                          = .from_bits(magnitude.bitor(sign))
        r     : Result<Self, ParseFloatError> = .Success(value)
        return(r)

    block fail(error: ParseFloatError)
        failed : Result<Self, ParseFloatError> = .Failure(error)
        return(failed)

/// Parses decimal text into an F16, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
/// :param text: The text to parse.
/// :returns: `Success` with the nearest float, or `Failure` with the reason the text did not match.
/// :throws: Returns `Failure(ParseFloatError.Empty)` for an empty string and `Failure(ParseFloatError.Invalid)` for anything else that does not match.
/// :note: Overflow gives an infinity and underflow gives zero.
routine F16.parse(text: Bytes) -> Result<Self, ParseFloatError>
    block entry()
        claim digits : @BigNat<72> <- uninit
        parsed : Result<DecimalParts, ParseFloatError> = parse_decimal(text, digits, 800)
        when parsed
            .Success(parts) -> build(parts, digits)
            .Failure(error) -> fail(error)

    block build(parts: DecimalParts, digits: @BigNat<72>)
        magnitude : U16  = decimal_to_bits(digits, parts, 10, 15, 31, 310, -324).to<U16>()
        negative  : Bool = parts.negative
        sign      : U16  = negative
            ? 0x8000
            : 0
        value : Self                          = .from_bits(magnitude.bitor(sign))
        r     : Result<Self, ParseFloatError> = .Success(value)
        return(r)

    block fail(error: ParseFloatError)
        failed : Result<Self, ParseFloatError> = .Failure(error)
        return(failed)

/// Parses decimal text into a BF16, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
/// :param text: The text to parse.
/// :returns: `Success` with the nearest float, or `Failure` with the reason the text did not match.
/// :throws: Returns `Failure(ParseFloatError.Empty)` for an empty string and `Failure(ParseFloatError.Invalid)` for anything else that does not match.
/// :note: Overflow gives an infinity and underflow gives zero.
routine BF16.parse(text: Bytes) -> Result<Self, ParseFloatError>
    block entry()
        claim digits : @BigNat<72> <- uninit
        parsed : Result<DecimalParts, ParseFloatError> = parse_decimal(text, digits, 800)
        when parsed
            .Success(parts) -> build(parts, digits)
            .Failure(error) -> fail(error)

    block build(parts: DecimalParts, digits: @BigNat<72>)
        magnitude : U16  = decimal_to_bits(digits, parts, 7, 127, 255, 310, -324).to<U16>()
        negative  : Bool = parts.negative
        sign      : U16  = negative
            ? 0x8000
            : 0
        value : Self                          = .from_bits(magnitude.bitor(sign))
        r     : Result<Self, ParseFloatError> = .Success(value)
        return(r)

    block fail(error: ParseFloatError)
        failed : Result<Self, ParseFloatError> = .Failure(error)
        return(failed)

/// Parses decimal text into an F128, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
/// :param text: The text to parse.
/// :returns: `Success` with the nearest float, or `Failure` with the reason the text did not match.
/// :throws: Returns `Failure(ParseFloatError.Empty)` for an empty string and `Failure(ParseFloatError.Invalid)` for anything else that does not match.
/// :note: Overflow gives an infinity and underflow gives zero.
routine F128.parse(text: Bytes) -> Result<Self, ParseFloatError>
    block entry()
        claim digits : @BigNat<864> <- uninit
        parsed : Result<DecimalParts, ParseFloatError> = parse_decimal(text, digits, 11600)
        when parsed
            .Success(parts) -> build(parts, digits)
            .Failure(error) -> fail(error)

    // F128's largest value is about 1.19e4932; its smallest subnormal, 6.5e-4966.
    block build(parts: DecimalParts, digits: @BigNat<864>)
        magnitude : U128 = decimal_to_bits(digits, parts, 112, 16383, 32767, 4933, -4966)
        negative  : Bool = parts.negative
        sign      : U128 = negative
            ? F128_SIGN
            : 0
        value : Self                          = f128_of(magnitude.bitor(sign))
        r     : Result<Self, ParseFloatError> = .Success(value)
        return(r)

    block fail(error: ParseFloatError)
        failed : Result<Self, ParseFloatError> = .Failure(error)
        return(failed)

// -- F128, faithful ------------------------------------------------------------
//
// F128.parse_faithful trades correct rounding for speed and a small stack: the
// result is one of the two F128 values around the decimal (error below 1 ulp),
// and differs from F128.parse only when the decimal is within about 2^-7 ulp of
// a halfway point. No BigNat: the first 38 significant digits go into a U128,
// and the power of ten is a product of 10^(±2^i) taken from a table of 128-bit
// mantissas (each rounded to nearest), keeping the high 128 bits of every
// product. At most 13 products, 13 table roundings (2^-128 each), 13 dropped
// product halves (under 2^-127 each), and the digits past 38 (under 10^-37)
// add up to less than 2^-120 relative error, which 113-bit rounding turns into
// at most 0.5 + 2^-7 ulp.

/// 128-bit mantissas of 10^(2^i) for i = 0 to 12, each normalized with its top bit set and rounded to nearest. Paired with `F128_POW10_POS_EXP`.
preset F128_POW10_POS_MANT: @Array<U128, 13> <- { 0xA0000000000000000000000000000000,
    0xC8000000000000000000000000000000, 0x9C400000000000000000000000000000,
    0xBEBC2000000000000000000000000000, 0x8E1BC9BF040000000000000000000000,
    0x9DC5ADA82B70B59DF020000000000000, 0xC2781F49FFCFA6D53CBF6B71C76B25FB,
    0x93BA47C980E98CDFC66F336C36B10137, 0xAA7EEBFB9DF9DE8DDDBB901B98FEEAB8,
    0xE319A0AEA60E91C6CC655C54BC5058F9, 0xC976758681750C17650D3D28F18B50CE,
    0x9E8B3B5DC53D5DE4A74D28CE329ACE52, 0xC46052028A20979AC94C153F804A4A92 }
/// The binary exponents for `F128_POW10_POS_MANT`: 10^(2^i) is about mantissa × 2^exponent.
preset F128_POW10_POS_EXP: @Array<S64, 13> <- { -124, -121, -114, -101, -74, -21, 85, 298, 723,
    1573, 3274, 6676, 13479 }
/// 128-bit mantissas of 10^-(2^i) for i = 0 to 12, each normalized with its top bit set and rounded to nearest. Paired with `F128_POW10_NEG_EXP`.
preset F128_POW10_NEG_MANT: @Array<U128, 13> <- { 0xCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCD,
    0xA3D70A3D70A3D70A3D70A3D70A3D70A4, 0xD1B71758E219652BD3C36113404EA4A9,
    0xABCC77118461CEFCFDC20D2B36BA7C3D, 0xE69594BEC44DE15B4C2EBE687989A9B4,
    0xCFB11EAD453994BA67DE18EDA5814AF2, 0xA87FEA27A539E9A53F2398D747B36224,
    0xDDD0467C64BCE4A0AC7CB3F6D05DDBDF, 0xC0314325637A1939FA911155FEFB5309,
    0x9049EE32DB23D21C7132D332E3F204D5, 0xA2A682A5DA57C0BD87A601586BD3F699,
    0xCEAE534F34362DE4492512D4F2EAD2CC, 0xA6DD04C8D2CE9FDE2DE38123A1C3CFFC }
/// The binary exponents for `F128_POW10_NEG_MANT`: 10^-(2^i) is about mantissa × 2^exponent.
preset F128_POW10_NEG_EXP: @Array<S64, 13> <- { -131, -134, -141, -154, -181, -234, -340, -553,
    -978, -1828, -3529, -6931, -13734 }

/// A value mant × 2^exponent with the mantissa's top bit (127) set.
private record F128Wide
    mant     : U128
    exponent : S64

/// The high 128 bits of a × b (both normalized), renormalized: the product of
/// two numbers in [2^127, 2^128) is in [2^254, 2^256).
routine f128_wide_mul(a: F128Wide, m: U128, e: S64) -> F128Wide
    block entry()
        x      : U128 = a.mant
        x0     : U128 = x.bitand(0xFFFFFFFFFFFFFFFF)
        x1     : U128 = x.shr(64)
        y0     : U128 = m.bitand(0xFFFFFFFFFFFFFFFF)
        y1     : U128 = m.shr(64)
        p00    : U128 = x0.mul(y0)
        p01    : U128 = x0.mul(y1)
        p10    : U128 = x1.mul(y0)
        p11    : U128 = x1.mul(y1)
        carry0 : U128 = p00.shr(64)
        mid    : U128 = carry0.add(p01.bitand(0xFFFFFFFFFFFFFFFF)).add(p10.bitand(0xFFFFFFFFFFFFFFFF))
        hi_p   : U128 = p11.add(p01.shr(64)).add(p10.shr(64))
        hi     : U128 = hi_p.add(mid.shr(64))
        next   : U128 = mid.shr(63).bitand(1)  // bit 127 of the low half
        top    : Bool = hi.shr(127).eq(1)  // bit 255 set
        mant   : U128 = top
            ? hi
            : hi.shl(1).bitor(next)
        exponent : S64      = a.exponent.add(e).add(top ? 128 : 127)
        r        : F128Wide = F128Wide { mant: mant, exponent: exponent }
        return(r)

/// Parses decimal text into an F128 quickly and with little stack, accepting the same text as `F128.parse`. The result is one of the two F128 values around the decimal (error under 1 ulp), and differs from `F128.parse` only when the text lies within about 2^-7 ulp of a halfway point. Only the first 38 significant digits are used.
/// :param text: The text to parse.
/// :returns: `Success` with a float within 1 ulp of the decimal, or `Failure` with the reason the text did not match.
/// :note: Overflow gives an infinity and underflow gives zero.
routine F128.parse_faithful(text: Bytes) -> Result<Self, ParseFloatError>
    block entry()
        claim digits : @BigNat<3> <- uninit
        parsed : Result<DecimalParts, ParseFloatError> = parse_decimal(text, digits, 38)
        when parsed
            .Success(parts) -> build(parts, digits)
            .Failure(error) -> fail(error)

    block build(parts: DecimalParts, digits: @BigNat<3>)
        negative : Bool = parts.negative
        sign     : U128 = negative
            ? F128_SIGN
            : 0
        kind : DecimalKind = parts.kind
        when kind
            DecimalKind.Infinity -> done(sign.bitor(F128_INF))
            DecimalKind.Nan      -> done(sign.bitor(F128_QNAN))
            DecimalKind.Finite   -> finite(parts, negative, sign, digits)

    block finite(parts: DecimalParts, negative: Bool, sign: U128, digits: @BigNat<3>)
        count : USize = digits.count.load()
        low   : U64   = digits.limbs.get(0)
        high  : U64   = digits.limbs.get(1)
        d_low : U128  = count.ge(1)
            ? low.to<U128>()
            : 0
        d_high : U128 = count.ge(2)
            ? high.to<U128>().shl(64)
            : 0
        d         : U128 = d_low.bitor(d_high)
        kept      : S64  = parts.kept
        exponent  : S64  = parts.exponent
        magnitude : S64  = kept.add(exponent)
        zero      : Bool = d.eq(0).bitor(magnitude.lt(-4966))
        huge      : Bool = magnitude.gt(4933)
        when
            zero -> done(sign)
            huge -> done(sign.bitor(F128_INF))
            else -> scale(d, exponent, negative, parts.sticky)

    // d × 10^exponent: normalize d, then multiply in 10^(2^i) for every set bit of |exponent|.
    block scale(d: U128, exponent: S64, negative: Bool, sticky: Bool)
        shift : U128     = d.leading_zeros()
        start : F128Wide = F128Wide { mant: d.shl(shift), exponent: 0.sub(shift.to<S64>()) }
        down  : Bool     = exponent.lt(0)
        left  : U64      = exponent.abs_diff(0)
        jump power(0, left, down, start, negative, sticky)

    block power(i: USize, left: U64, down: Bool, w: F128Wide, negative: Bool, sticky: Bool)
        done : Bool = left.eq(0)
        branch done
            ? pack(w, negative, sticky)
            : bit(i, left, down, w, negative, sticky)

    block bit(i: USize, left: U64, down: Bool, w: F128Wide, negative: Bool, sticky: Bool)
        set : Bool = left.bitand(1).eq(1)
        branch set
            ? times(i, left, down, w, negative, sticky)
            : power(i.add(1), left.shr(1), down, w, negative, sticky)

    block times(i: USize, left: U64, down: Bool, w: F128Wide, negative: Bool, sticky: Bool)
        pos_m : U128 = F128_POW10_POS_MANT.get(i)
        pos_e : S64  = F128_POW10_POS_EXP.get(i)
        neg_m : U128 = F128_POW10_NEG_MANT.get(i)
        neg_e : S64  = F128_POW10_NEG_EXP.get(i)
        m     : U128 = down
            ? neg_m
            : pos_m
        e : S64 = down
            ? neg_e
            : pos_e
        next : F128Wide = f128_wide_mul(w, m, e)
        jump power(i.add(1), left.shr(1), down, next, negative, sticky)

    // value = mant × 2^exponent = sig × 2^(biased - 16383 - 115)
    block pack(w: F128Wide, negative: Bool, sticky: Bool)
        sig  : U128 = w.mant.bitor(sticky.to<U128>())
        bits : U128 = f128_round_pack(negative, w.exponent.add(16383).add(115), sig)
        jump done(bits)

    block done(bits: U128)
        value : Self                          = f128_of(bits)
        r     : Result<Self, ParseFloatError> = .Success(value)
        return(r)

    block fail(error: ParseFloatError)
        failed : Result<Self, ParseFloatError> = .Failure(error)
        return(failed)
