# Tessera stdlib: B128 powf and powi
#
# x^y, correctly rounded (to nearest, ties to even). CORE-MATH has no binary128 pow, so this uses sin_pi's two
# tiers (B128Extra.te) behind a check for the results no approximation can round:
#
# - exact and midpoint cases: x^y exactly representable, or exactly halfway between two B128s, is found and
#   computed with integers first (b128_pow_dyadic, which says why the check is complete).
# - fast: ln|x| and e^(y ln|x|) in B128Extended (192 bits). ln x = e ln 2 + ln f with f in [sqrt(1/2), sqrt(2)),
#   ln f by ln_1p's 2 atanh series, directly for |f - 1| < 1/8 and else as 2 ln sqrt(f), so its first dropped
#   term stays near 2^-190 or below. e^z = 2^q e^d with |d| <= ln 2 / 2 and e^d = 1 + expm1(d) by the 35-term
#   series. The result is kept when all of it × (1 ± 2^-B128_POW_BAND) rounds to the same B128.
# - exact tier: otherwise ln, y ln x, and exp in B128Big (448 bits, Standard/B128Big.te), rounded once. With
#   |y ln x| < 2^14 the result is off by under about 2^-415 relative.
#
# The band is measured, not proven. Over 489391 (x, y) pairs, 449558 of which reached the fast tier (random over
# the whole domain, x near 1 with |y| up to 2^100, results near overflow and in the subnormals, dyadic y
# (integer, half, quarter, and finer), powers of two, and 120000 with f on the 2 ln sqrt(f) path and |y ln x| in
# [10000, 11356]), the fast tier's worst relative error against mpmath was 2^-172.8: y ln x off by about 2^-186
# relative (f just past the 1 ± 1/8 switch), times |y ln x| near 2^13.5. So 2^-168 leaves about 5 bits. Values
# that close to a midpoint without being one do occur: x = 1 + a 2^-112 and y = n / 2 (a n odd) give
# 1 + a n 2^-113 + O(a² n² 2^-227), next to a midpoint, and the fast tier alone rounds some of those the wrong
# way (tests/b128_pow.te has them). The exact tier has no rounding test of its own: it is within about 2^-415 of
# x^y, while the 2^256 inputs, over 2^113 rounding intervals, are expected to come within about 2^-(113 + 256) of
# a midpoint at the closest. No hard-to-round bound is known for binary128 pow.

module Standard/Core

preset B128_POW_BAND: S64 = 168

# e^z overflows past z = 11356.52 and is below half the smallest subnormal before z = -11433.4. Beyond these two
# there is nothing to compute
preset B128_POW_OVER:  B128 = B128.from_bits(0x400C6300000000000000000000000000)  # 11360

preset B128_POW_UNDER: B128 = B128.from_bits(0xC00C6700000000000000000000000000)  # -11488

# -- powf, powi ----------------------------------------------------------------

### x^y, correctly rounded, with the special cases of IEEE 754 and C99 Annex F: x^±0 = 1 and 1^y = 1 (a quiet NaN
### included), a zero or infinite base by the sign of y, (-1)^±inf = 1, NaN for a negative base and a
### non-integer y, and a negative base with an odd integer y keeps the minus sign. A signaling NaN operand, or any
### other NaN, comes back quieted (`me` first), the payload kept, as in every B128 operation.
### :param y: The exponent.
### :returns: `me`^y.
routine B128.powf(me: Me, y: Me) -> Me
    r: Me = b128_pow(x: me, y, exact: false)
    return r

### me^n, the same as powf with n converted.
### :param n: The integer exponent.
### :returns: `me`^n.
routine B128.powi(me: Me, n: S32) -> Me
    r: Me = me.powf(n.to[Me]())
    return r

### x^y, correctly rounded, as {B128.powf}.
### :param x: The base.
### :param y: The exponent.
### :param exact: True skips the fast tier (the tests use it to check the exact tier on its own).
### :returns: x^y.
routine b128_pow(x: B128, y: B128, exact: Bool) -> B128
    one: B128 = b128_of(B128_ONE)
    signaling: Bool = b128_is_signaling(x) | b128_is_signaling(y)
    y_zero: Bool = b128_is_zero_bits(y.bits())
    x_one: Bool = x == one
    when
        signaling => return b128_nan_of(a: x, b: y)
        y_zero => return one
        x_one => return one
        x.is_nan() or y.is_nan() => return b128_nan_of(a: x, b: y)
        else =>
            one2: B128 = b128_of(B128_ONE)
            x_zero: Bool = b128_is_zero_bits(x.bits())
            x_inf: Bool = x.is_infinite()
            y_inf: Bool = y.is_infinite()
            y_neg: Bool = b128_is_negative_bits(y.bits())
            odd: Bool = b128_is_odd_integer(y)
            int: Bool = b128_is_integer(y)
            x_neg: Bool = b128_is_negative_bits(x.bits())
            big_x: Bool = x.abs() > one2
            minus_one: Bool = x == -one2
            zero: B128 = b128_of(0)
            infinity: B128 = B128.INFINITY
            # x = ±0: a pole for y < 0, zero for y > 0. Odd integers keep x's sign
            at_zero: B128 = when
                y_neg => infinity
                else => zero
            zero_r: B128 = when
                odd => at_zero.copysign(x)
                else => at_zero
            # y = ±inf: |x| > 1 grows for +inf, |x| < 1 grows for -inf
            grows: Bool = big_x ^ y_neg
            growth: B128 = when
                grows => infinity
                else => zero
            inf_r: B128 = when
                minus_one => one2
                else => growth
            # x = ±inf: like 1/0 for y < 0. Odd integers keep x's sign
            x_inf_r0: B128 = when
                y_neg => zero
                else => infinity
            x_inf_r: B128 = when
                odd => x_inf_r0.copysign(x)
                else => x_inf_r0
            bad: Bool = x_neg and not int
            # x = -1 and an integer y: ±1
            unit: B128 = when
                odd => -one2
                else => one2
            when
                x_zero => return zero_r
                y_inf => return inf_r
                x_inf => return x_inf_r
                bad => return B128.NAN
                minus_one => return unit
                else =>
                    # |x|^y, negated for a negative x and an odd integer y
                    magnitude: B128 = b128_pow_positive(x: x.abs(), y, exact)
                    flip: Bool = odd & b128_is_negative_bits(x.bits())
                    r: B128 = when
                        flip => -magnitude
                        else => magnitude
                    return r

### x^y for a finite x > 0 other than 1 and a finite nonzero y: the exact and midpoint cases first, then the two
### tiers.
### :param x: The base.
### :param y: The exponent.
### :param exact: True skips the fast tier.
### :returns: x^y, correctly rounded.
routine b128_pow_positive(x: B128, y: B128, exact: Bool) -> B128
    d: PowDyadic = b128_pow_dyadic(x, y)
    if d.found
        return d.value
    if not exact
        z: B128Extended = y.to[B128Extended]() * wide_pow_ln(x)
        zf: B128 = z.to[B128]()
        over: Bool = zf > B128_POW_OVER
        when
            over => return B128.INFINITY
            zf < B128_POW_UNDER => return b128_of(0)
            else =>
                rounded: WideRounding = wide_round_within(u: wide_pow_exp(z), k: B128_POW_BAND)
                if rounded.ok
                    return rounded.value
    r: B128 = b128_pow_big(x, y)
    return r

# -- the exact and midpoint cases ----------------------------------------------

### x^y when the check below finds it, rounded once.
record PowDyadic
    found: Bool
    value: B128

### A finite nonzero B128 as ±odd × 2^shift.
secret record OddScaled
    odd: U128
    shift: S64

### A finite nonzero B128's magnitude as odd × 2^shift.
### :param x: The value.
### :returns: The odd part and the shift.
secret routine b128_odd_scaled(x: B128) -> OddScaled
    p: B128Parts = b128_unpack(x.bits())
    zeros: U128 = p.sig.trailing_zeros()
    r: OddScaled = OddScaled(odd: p.sig >> zeros, shift: p.exponent - 112 + zeros.to[S64]())
    return r

### x^y exactly, when it is w × 2^f with w an odd integer below 2^128 (x > 0 finite and not 1, y finite and
### nonzero). Every B128, and every midpoint between two, is such a number with w < 2^114, so this finds every
### result the tiers can't round. With x = m 2^E and y = ±n 2^j (m and n odd):
###
### - x^y is a dyadic rational only as follows. For an integer y (j >= 0), x^y = m^y 2^(E y), which for y < 0 has
###   the odd factor m^|y| in its denominator unless m = 1. For y = ±n / 2^k (k = -j >= 1), if x^y = r is dyadic
###   then r^(2^k) = x^(±n). With m > 1 that needs y > 0 and 2^k dividing n times each prime's exponent in m, so
###   (n odd) m = a^(2^k) and 2^k divides E, and x^y = a^n 2^(E n / 2^k). With m = 1, x^y = 2^(E y) is dyadic
###   exactly when E y is an integer, that is when 2^k divides E.
### - Bounds: m^y < 2^128 with m >= 3 needs y < 81, a >= 3 with a^(2^k) = m < 2^113 needs 2^k <= 71, so k <= 6,
###   and a^n < 2^128 needs n < 81. So an integer y >= 128, k > 6, or n >= 128 rules the case out at once.
###
### For a power of two, |E y| >= 2^20 overflows or underflows whatever it is. It is clamped to ±2^30, which
### b128_round_pack turns into inf or +0 as the real one would.
### :param x: The base.
### :param y: The exponent.
### :returns: The rounded x^y with `found` true, or `found` false when x^y is no such number.
routine b128_pow_dyadic(x: B128, y: B128) -> PowDyadic
    local bx: OddScaled = b128_odd_scaled(x)
    local by: OddScaled = b128_odd_scaled(y)
    local y_negative: Bool = b128_is_negative_bits(y.bits())
    local e: S64 = bx.shift

    two_power: Bool = bx.odd == 1
    when
        two_power =>
            # x = 2^E: 2^(E y) when E y is an integer, and then |E y| >= n 2^max(j, 0)
            j: S64 = by.shift
            k: S64 = 0 - j
            mask: S64 = S64.shl(1, k.min(62)) - 1
            whole: Bool = j >= 0 or (k < 15 and e & mask == 0)
            huge: Bool = j >= 20 or by.odd >= 0x100000
            down: Bool = (e < 0) ^ y_negative
            clamp: S64 = when
                down => -1073741824
                else => 0x40000000
            when
                not whole => return pow_dyadic_none()
                huge => return pow_dyadic_place(w: 1, f: clamp)
                else =>
                    n: S64 = by.odd.to[S64]()
                    scaled: S64 = when
                        j >= 0 => e << j
                        else => e >> 0 - j
                    f: S64 = scaled * n
                    signed: S64 = when
                        y_negative => -f
                        else => f
                    return pow_dyadic_place(w: 1, f: signed)
        y_negative => return pow_dyadic_none()
        by.shift >= 0 =>
            # y = n 2^j > 0: m^y 2^(E y)
            if not (by.shift < 7 and by.odd < 128)
                return pow_dyadic_none()
            power: S64 = by.odd.to[S64]() << by.shift
            if power >= 128
                return pow_dyadic_none()
            w: Maybe[U128] = u128_power_checked(base: bx.odd, n: power)
            when w
                is U128 as value => return pow_dyadic_place(w: value, f: bx.shift * power)
                is None => return pow_dyadic_none()
        else =>
            # y = n / 2^k > 0: a^n 2^(E n / 2^k) with m = a^(2^k)
            k: S64 = 0 - by.shift
            mask: S64 = S64.shl(1, k.min(62)) - 1
            small_root: Bool = k <= 6 and by.odd < 128
            if not (small_root and bx.shift & mask == 0)
                return pow_dyadic_none()
            root: Maybe[U128] = u128_root_two_power(m: bx.odd, k)
            a: U128 = when root
                is U128 as a => a
                is None => return pow_dyadic_none()
            n: S64 = by.odd.to[S64]()
            w: Maybe[U128] = u128_power_checked(base: a, n)
            when w
                is U128 as value => return pow_dyadic_place(w: value, f: (bx.shift >> k) * n)
                is None => return pow_dyadic_none()

### The "not found" answer of {b128_pow_dyadic}.
### :returns: A PowDyadic with `found` false.
secret routine pow_dyadic_none() -> PowDyadic
    r: PowDyadic = PowDyadic(found: false, value: b128_of(0))
    return r

### w × 2^f, rounded once (overflow, subnormals, and underflow included).
### :param w: The integer part.
### :param f: The power of two.
### :returns: The rounded value with `found` true.
secret routine pow_dyadic_place(w: U128, f: S64) -> PowDyadic
    bits: U128 = b128_round_pack(negative: false, exponent: f + B128_BIAS + 115, sig: w)
    r: PowDyadic = PowDyadic(found: true, value: b128_of(bits))
    return r

### base^n for 0 <= n.
### :param base: The base.
### :param n: The exponent, at least 0.
### :returns: The power.
### :absent: When the power doesn't fit in a U128.
secret routine u128_power_checked(base: U128, n: S64) -> Maybe[U128]
    while left != 0 with acc: U128 = 1, left: S64 = n
        next: Maybe[U128] = acc.mul_checked(base)
        when next
            is U128 as v => continue with acc: v, left: left - 1
            is None => return None()
    then
        return acc

### The 2^k-th root of m when m is a perfect 2^k-th power, by k exact square roots.
### :param m: The value.
### :param k: How many square roots, at least 0.
### :returns: The root.
### :absent: When some square root along the way is not exact.
secret routine u128_root_two_power(m: U128, k: S64) -> Maybe[U128]
    while left != 0 with a: U128 = m, left: S64 = k
        r: U128 = a.isqrt()
        if r * r == a
            continue with a: r, left: left - 1
        else
            return None()
    then
        return a

# -- fast tier: B128Extended ---------------------------------------------------

### ln x for a finite x > 0, to about 2^-186 relative: x = f 2^e with f in [sqrt(1/2), sqrt(2)), and ln f from
### ln_1p's series, directly for |f - 1| < 1/8 (f - 1 is exact, and the series' argument is under 0.067) and
### else as 2 ln sqrt(f), which brings the argument under 0.087.
### :param x: The argument, positive.
### :returns: ln x at 192 bits.
routine wide_pow_ln(x: B128) -> B128Extended
    local w: B128Extended = x.to[B128Extended]()
    local f0: B128Extended = w.ldexp(0 - w.exponent)
    # in [1, 2)
    local sqrt_half: B128Extended = wide_const(2)
    local low: Bool = f0.hi < sqrt_half.hi
    # below sqrt(2): the same mantissa
    local f: B128Extended = when

        low => f0
        else => f0.ldexp(-1)
    local e: S64 = when
        low => w.exponent
        else => w.exponent + 1

    u: B128Extended = f - wide_one()  # exact
    near: Bool = u.is_zero() or u.exponent < -3
    ln_f: B128Extended = when
        near => wide_ln_1p(u)
        else =>
            root: B128Extended = f.sqrt()
            becomes wide_ln_1p(root - wide_one()).ldexp(1)
    e_ln2: B128Extended = e.to[B128Extended]() * wide_const(0)
    r: B128Extended = e_ln2 + ln_f
    return r

### e^z for |z| < 2^14: z = q ln 2 + d, and e^d = 1 + expm1(d) by its series (|d| < 1/2).
### :param z: The exponent.
### :returns: e^z at 192 bits.
routine wide_pow_exp(z: B128Extended) -> B128Extended
    q: S64 = (z * wide_const(1)).to_nearest[S64]()
    d: B128Extended = z - q.to[B128Extended]() * wide_const(0)
    exp_d: B128Extended = wide_one() + wide_exp_m1(d)
    r: B128Extended = exp_d.ldexp(q)
    return r

### The fast tier's x^y (x > 0, y ln x in range), before rounding.
### :param x: The base.
### :param y: The exponent.
### :returns: x^y at 192 bits.
routine wide_pow(x: B128, y: B128) -> B128Extended
    z: B128Extended = y.to[B128Extended]() * wide_pow_ln(x)
    r: B128Extended = wide_pow_exp(z)
    return r

# -- exact tier: B128Big -------------------------------------------------------

### x^y in B128Big, rounded once, for x > 0 finite and not 1 and y finite and nonzero.
### :param x: The base.
### :param y: The exponent.
### :returns: x^y, with inf past overflow and +0 past underflow.
routine b128_pow_big(x: B128, y: B128) -> B128
    z: B128Big = big_ln(x.to[B128Big]()) * y.to[B128Big]()
    zf: B128 = z.to[B128]()
    over: Bool = zf > B128_POW_OVER
    when
        over => return B128.INFINITY
        zf < B128_POW_UNDER => return b128_of(0)
        else => return big_exp(z).to[B128]()
