    0x9BA9DA6C, 0x85101C05, 0x40826C88, 0x22262D7B, 0x99999999, 0x83126D70, 0x3EE8AF07, 0x20F97CD2,
    0x97913630, 0x81215480, 0x3D5D0922, 0x1FD9F714, 0x95907EB8, 0x7F3C62EF, 0x3BDEDCE0, 0x1EC6E994,
    0x93974369, 0x7D632F45, 0x3A6D94A9, 0x1DBFACBB, 0x91A55615, 0x7B955498, 0x3908A2BE, 0x1CC3A33B,
    0x8FBA8A1C, 0x79D2724E, 0x37AF80BF, 0x1BD23960, 0x8DD6B456, 0x781A2BE4, 0x3661AF39, 0x1AEAE458,
    0x8BF9AB07, 0x766C28BA, 0x351EB539, 0x1A0D21A2, 0x8A2345CC, 0x74C813DD, 0x33E61FEB, 0x19387676,
