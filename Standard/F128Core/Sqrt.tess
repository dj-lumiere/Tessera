    0x745D1746, 0x6279F081, 0x2710061D, 0x10F8E6DA, 0x72D59C46, 0x61449E06, 0x26445F86, 0x107E05AC,
    0x7152E9F4, 0x601591BE, 0x257E7B4D, 0x10079327, 0x6FD4E793, 0x5EEC9E6B, 0x24BE2445, 0x0F955DA9,
    0x6E5B7D16, 0x5DC9986E, 0x24032795, 0x0F273620, 0x6CE6931D, 0x5CAC55B7, 0x234D5496, 0x0EBCEFDB,
    0x6B7612EC, 0x5B94ADB2, 0x229C7CBC, 0x0E56606E }

// -- sqrt ----------------------------------------------------------------------

/// The square root of `self`, correctly rounded to nearest with ties to even (a CORE-MATH port).
/// NaN and negatives keep F128's own NaNs (CORE-MATH's default NaN has its sign bit set). ±0 maps to itself.
/// :returns: sqrt(`self`).
routine F128.sqrt(self: Self) -> Self
    shared bits : U128 = self.bits()

    block entry()
        nan      : Bool = self.is_nan()
        negative : Bool = f128_is_negative_bits(self.bits()).bitand(f128_is_zero_bits(self.bits()).bitnot())
        special  : Bool = nan.bitor(negative)
        branch special
            ? special()
            : compute()

    block special()
        r : Self = f128_of(f128_sqrt_bits(self.bits()))
        return(r)

    block compute()
        top     : S64  = bits.shr(112).to<S64>()  // sign and biased exponent
        tiny    : Bool = top.eq(0)  // +0 or positive subnormal
        special : Bool = top.ge(0x7FFF)  // negative, infinite, or NaN
        when
            tiny    -> subnormal()
            special -> return(cm_sqrt_special(self))
            else    -> root(bits, top)

    block subnormal()
        zero : Bool = bits.eq(0)
        branch zero
            ? return(self)
            : normalize()

    // Moves the leading bit up to the implicit bit's place. The exponent drops below 1 to match.
    block normalize()
        lz    : U128 = bits.leading_zeros()
        shift : S64  = lz.to<S64>().sub(15)
        jump root(bits.shl(shift.to<U128>()), 1.sub(shift))

    // x = 1.frac × 2^(exponent - 16383). The root's biased exponent is floor((exponent + 1) / 2) + 8191:
    // the field gets one less, since the significand's leading bit lands on bit 112 and adds 1.
    block root(norm_bits: U128, exponent: S64)
        exp1            : S64  = exponent.add(1)
        odd             : S64  = exp1.bitand(1)
        biased_exponent : S64  = exp1.shr(1).add(8190)
        exp_field       : U128 = biased_exponent.to<U128>().shl(112)
        frac            : U128 = norm_bits.shl(16)  // the fraction alone, at the top
        radicand        : U128 = cm_sqrt_radicand(frac, odd)
        approx          : U128 = cm_sqrt_approx(frac, radicand, odd)
        slack           : S16  = approx.shl(2).to_wrap<S16>()  // the bits under the rounding point
        close           : Bool = slack.between(-37, 13)
        branch close
            ? settle(approx, radicand, exp_field)
            : round(approx, exp_field)

    // approx is at most one unit (of its bit 14) off: square the candidate, compare it with the
    // radicand, and leave bit 0 saying which way the true root lies.
    block settle(approx: U128, radicand: U128, exp_field: U128)
        candidate   : U128 = approx.add_wrap(0x2000)
        m           : U128 = candidate.shr(14)
        excess_bits : U128 = m.mul_wrap(m).sub_wrap(radicand.shl(100))
        excess      : S128 = excess_bits.to_wrap<S128>()
        above       : U128 = excess.gt(0).to<U128>()
        below       : U128 = excess.lt(0).to<U128>()
        cleared     : U128 = candidate.bitand(0x3FFF.bitnot())
        v           : U128 = cleared.sub_wrap(above).add_wrap(below)
        jump round(v, exp_field)

    // Bit 14 is the round bit. A sqrt is never exactly halfway, so rounding it up is to nearest.
    block round(v: U128, exp_field: U128)
        round_bit : U128 = v.shr(14).bitand(1)
        sig       : U128 = v.shr(15).add_wrap(round_bit)
        r         : Self = f128_of(sig.add_wrap(exp_field))
        return(r)

/// The square root of a negative, infinite, or NaN `x` (sign and exponent at least 0x7FFF): -0 and +inf are
/// their own roots, other negatives give the default NaN, and a NaN is quieted.
/// :param x: The argument, with its top 16 bits at least 0x7FFF.
/// :returns: The special-case root.
routine cm_sqrt_special(x: F128) -> F128
    block entry()
        bits      : U128 = x.bits()
        neg_zero  : Bool = bits.shl(1).eq(0)
        infinite  : Bool = bits.eq(F128_INF)
        neg_most  : Bool = bits.le(0xFFFF0000000000000000000000000000)
        neg_least : Bool = bits.gt(0x80000000000000000000000000000000)
        negative  : Bool = neg_most.bitand(neg_least)
        nan       : F128 = f128_of(CM_SQRT_DEFAULT_NAN)
        quieted   : F128 = f128_of(bits.bitor(F128_QUIET_BIT))
        when
            neg_zero -> return(x)
            infinite -> return(x)
            negative -> return(nan)
            else     -> return(quieted)

// -- shared with hypot ---------------------------------------------------------

/// The fixed-point radicand: `frac` shifted down two places (one for an odd exponent) under its restored
/// leading bit.
/// :param frac: The fraction at the top of the word, implicit bit dropped.
/// :param odd: 1 when the exponent is odd, else 0.
/// :returns: The radicand.
routine cm_sqrt_radicand(frac: U128, odd: S64) -> U128
    block entry()
        one     : U128 = 1
        shifted : U128 = frac.shr(2.sub(odd).to<U128>())
        leading : U128 = one.shl(126.add(odd).to<U128>())
        r       : U128 = shifted.bitor(leading)
        return(r)

/// The square root of the radicand, scaled so its leading bit is bit 127 and accurate to a few units of bit 14:
/// the seed r ≈ 1/sqrt, then sx = r·x and one correction v = 2 sx - sx·h, with h = r·sx·4 - 2 the (signed)
/// residual.
/// :param frac: The fraction at the top of the word, implicit bit dropped (its top 64 bits pick the seed).
/// :param radicand: The radicand from {cm_sqrt_radicand}.
/// :param odd: 1 when the exponent is odd, else 0.
/// :returns: The approximate root.
routine cm_sqrt_approx(frac: U128, radicand: U128, odd: S64) -> U128
    block entry()
        seed     : U64  = cm_sqrt_rsqrt9(frac.shr(64).to<U64>())
        odd_exp  : Bool = odd.ne(0)
        all_ones : U64  = U64.MAX
        scale    : U64  = odd_exp
            ? CM_SQRT_RSQRT2
            : all_ones
        product : U128 = seed.to<U128>().mul_wrap(scale.to<U128>())
        r       : U64  = product.shr(64).to<U64>()
        sx      : U128 = cm_sqrt_mul_hi(r, radicand)
        h_bits  : U128 = cm_sqrt_mul_hi(r, sx).shl(2)
        h       : S128 = h_bits.to_wrap<S128>()
        ds_high : U128 = cm_sqrt_mul_hi(sx, h.to_wrap<U128>())
        h_neg   : Bool = h.lt(0)
        ds      : U128 = h_neg  // (signed h) × sx
            ? ds_high.sub_wrap(sx)
            : ds_high
        v : U128 = sx.shl(1).sub_wrap(ds)
        return(v)

/// 2^64 / sqrt(1 + m / 2^64) to almost 64 bits: the cubic seed of `m`'s subrange, then one Newton-Raphson step
/// r1 = r0 - r0 (r0² x - 1) / 2. A result of 0 saturates to `U64.MAX`.
/// :param m: The fraction bits of x in [1, 2).
/// :returns: The reciprocal square root, scaled by 2^64.
routine cm_sqrt_rsqrt9(m: U64) -> U64
    block entry()
        table      : @U64  = CM_SQRT_RSQRT9.to<@U64>()
        row        : USize = m.shr(58).to<USize>()
        i0         : USize = row.mul(4)
        c0_raw     : U64   = table.stride(i0).load()
        c1_raw     : U64   = table.stride(i0.add(1)).load()
        c2         : U64   = table.stride(i0.add(2)).load()
        c3         : U64   = table.stride(i0.add(3)).load()
        c0         : U64   = c0_raw.shl(31).bitor(0x8000000000000000)
        c1         : U64   = c1_raw.shl(25)
        d          : U64   = m.shl(6).shr(32)  // position in the subrange, [0, 2^32)
        d2         : U64   = d.mul_wrap(d).shr(32)
        even       : U64   = c0.add_wrap(d2.mul_wrap(c2).shr(13))  // even terms (positive)
        c13        : U64   = c1.add_wrap(d2.mul_wrap(c3).shr(19)).shr(26)
        odd        : U64   = d.mul_wrap(c13).shr(6)  // odd terms (negative)
        r0         : U64   = even.sub_wrap(odd)
        r0_sq      : U64   = cm_sqrt_mul_hi(r0, r0)
        resid_bits : U64   = cm_sqrt_mul_hi(m, r0_sq).add_wrap(r0_sq)
        resid      : S64   = resid_bits.to_wrap<S64>()  // r0² x - 1, signed
        half       : S64   = r0.shr(1).to<S64>()
        step_wide  : S128  = resid.to<S128>().mul_wrap(half.to<S128>())
        step       : U64   = step_wide.shr(64).to_wrap<U64>()
        r1         : U64   = r0.sub_wrap(step)
        zero       : Bool  = r1.eq(0)
        max        : U64   = U64.MAX
        r          : U64   = zero
            ? max
            : r1
        return(r)

/// The high 64 bits of the unsigned product a·b.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The high half of the 128-bit product.
routine cm_sqrt_mul_hi(a: U64, b: U64) -> U64
    block entry()
        product : U128 = a.to<U128>().mul_wrap(b.to<U128>())
        r       : U64  = product.shr(64).to<U64>()
        return(r)

/// The high 128 bits of the unsigned 64×128-bit product y·x, without the low partial product's low half.
/// :param y: The 64-bit factor.
/// :param x: The 128-bit factor.
/// :returns: The (truncated) high 128 bits.
routine cm_sqrt_mul_hi(y: U64, x: U128) -> U128
    block entry()
        y2  : U128 = y.to<U128>()
        xy0 : U128 = x.bitand(0xFFFFFFFFFFFFFFFF).mul_wrap(y2)
        xy1 : U128 = x.shr(64).mul_wrap(y2)
        r   : U128 = xy1.add_wrap(xy0.shr(64))
        return(r)

/// The approximate high 128 bits of the unsigned 128×128-bit product a·b (low × low dropped).
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The (truncated) high 128 bits.
routine cm_sqrt_mul_hi(a: U128, b: U128) -> U128
    block entry()
        a0    : U128 = a.bitand(0xFFFFFFFFFFFFFFFF)
        a1    : U128 = a.shr(64)
        b0    : U128 = b.bitand(0xFFFFFFFFFFFFFFFF)
        b1    : U128 = b.shr(64)
        high  : U128 = a1.mul_wrap(b1)
        mid_a : U128 = a1.mul_wrap(b0).shr(64)
        mid_b : U128 = a0.mul_wrap(b1).shr(64)
        r     : U128 = high.add_wrap(mid_a).add_wrap(mid_b)
        return(r)
