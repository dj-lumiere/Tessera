// Tessera stdlib: correctly rounded F128 square root (CORE-MATH)
//
// Ported from CORE-MATH, src/binary128/sqrt/sqrtq.c via RazorForge's B128Sqrt.rf.
// Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// Only round-to-nearest (ties to even) is kept. The original's rounding-mode probe, errno and
// exception flags are dropped. Everything runs on 64- and 128-bit integers: a cubic
// reciprocal-square-root seed for each 1/64 of [1, 2), one Newton step, a 128-bit refinement,
// and, when the result lands within a few units of a rounding boundary, an exact comparison of
// the candidate's square with the argument.
//
// The C helpers mhuu / mhuU / mhUU are cm_sqrt_mul_hi / _64x128 / _128x128 here.
// Hypot.tess reuses the seed and the refinement.

module Standard::Core

/// The IEEE default NaN of the original (x86's: sign set, quiet bit set, empty payload).
preset CM_SQRT_DEFAULT_NAN: U128 = F128_SIGN.bitor(F128_QNAN)

/// 2^64 / sqrt(2): the reciprocal root's scale for an odd exponent.
preset CM_SQRT_RSQRT2: U64 = 0xB504F333F9DE6484

/// The reciprocal-square-root seed table: for each of the 64 subranges of [1, 2), the cubic's
/// four 32-bit coefficients c0 c1 c2 c3 (c0 without its implicit leading bit).
preset CM_SQRT_RSQRT9: @Array<U64, 256> <- { 0xFFFFFFFF, 0xFFFFF780, 0xBFF55815, 0x9BB5B6E7,
    0xFC0BD889, 0xFA1D6E7D, 0xB8A95A89, 0x938BF8F0, 0xF82EC882, 0xF473BEA9, 0xB1BF4705, 0x8BED0079,
    0xF467F280, 0xEEFFF2A1, 0xAB309D4A, 0x84CDB431, 0xF0B6848C, 0xE9BF46F4, 0xA4F76232, 0x7E24037B,
    0xED19B75E, 0xE4AF2628, 0x9F0E1340, 0x77E6CA62, 0xE990CDAD, 0xDFCD2521, 0x996F9B96, 0x720DB8DF,
    0xE61B138E, 0xDB16FFDE, 0x94174A00, 0x6C913CFF, 0xE2B7DDDF, 0xD68A967B, 0x8F00C812, 0x676A6F92,
    0xDF6689B7, 0xD225EA80, 0x8A281226, 0x62930308, 0xDC267BEA, 0xCDE71C63, 0x8589702C, 0x5E05343E,
    0xD8F7208E, 0xC9CC6948, 0x81216F2E, 0x59BBBCF8, 0xD5D7EA91, 0xC5D428EE, 0x7CECDB76, 0x55B1C7D6,
    0xD2C8534E, 0xC1FCCBC9, 0x78E8BB45, 0x51E2E592, 0xCFC7DA32, 0xBE44D94A, 0x75124A0A, 0x4E4B0369,
    0xCCD6045F, 0xBAAAEE41, 0x7166F40F, 0x4AE66284, 0xC9F25C5C, 0xB72DBB69, 0x6DE45288, 0x47B19045,
    0xC71C71C7, 0xB3CC040F, 0x6A882804, 0x44A95F5F, 0xC453D90F, 0xB0849CD4, 0x67505D2A, 0x41CAE1A0,
    0xC1982B2E, 0xAD566A85, 0x643AFDC8, 0x3F13625C, 0xBEE9056F, 0xAA406113, 0x6146361F, 0x3C806169,
    0xBC46092E, 0xA7418293, 0x5E70506D, 0x3A0F8E8E, 0xB9AEDBA5, 0xA458DE58, 0x5BB7B2B1, 0x37BEC572,
    0xB72325B7, 0xA1859022, 0x591ADC9A, 0x358C09E2, 0xB4A293C2, 0x9EC6BF52, 0x569865A7, 0x33758476,
    0xB22CD56D, 0x9C1B9E36, 0x542EFB6A, 0x31797F8A, 0xAFC19D86, 0x9983695C, 0x51DD5FFB, 0x2F96647A,
    0xAD60A1D1, 0x96FD66F7, 0x4FA2687C, 0x2DCAB91F, 0xAB099AE9, 0x9488E64B, 0x4D7CFBC9, 0x2C151D8A,
