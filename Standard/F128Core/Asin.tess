// Tessera stdlib: the correctly rounded F128 arc sine
//
// Ported from CORE-MATH, src/binary128/asin/asinq.c via RazorForge's CoreMath/B128Asin.rf
// (https://core-math.gitlabpages.inria.fr/).
// Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// Only the round-to-nearest path of the original is kept. Everything works on integers; the
// helpers and tables shared with acos live in F128Core/AsinShared.tess.
//
// For |x| >= 0.022 the argument is reduced with the table point s_j = sin(pi/2/72*j):
// asin(x) = asin(s_j) + asin(x*sqrt(1 - s_j^2) - s_j*sqrt(1 - x^2)), and the small remainder goes
// through an odd polynomial. A 128-bit fast path is checked against its error bound and falls back
// to a 320-bit accurate path.

module Standard::Core

/// asin(PTH[j]) as five-word fixed-point values, one row per table point
preset CM_ASIN_PHI0: @Array<U64, 360> <- { 0x0000000000000000, 0x0000000000000000,
    0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x31DC03B852FDE26E,
