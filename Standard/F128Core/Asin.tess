/// The unpacked argument 2^-57 <= |x| < 1: the 128-bit mantissa xa (implicit bit at 127), its
/// biased exponent xn, the sign word and the table point j.
record CmAsinArg
    xa   : U128
    xn   : S64
    xsgn : S64
    j    : USize

routine F128.asin(self: Self) -> Self
    block entry():
        nan     : Bool = self.is_nan()
        outside : Bool = self.abs().gt(f128_of(0x3FFF0000000000000000000000000000))
        quiet   : Self = f128_of(f128_quiet(self.bits()))
        invalid : Self = Self.NAN
        when:
            nan     -> return(quiet)
            outside -> return(invalid)
            else    -> compute()

    block compute():
        bits  : U128 = self.bits()
        xb1   : U64  = cm_asin_hi(bits).bitand(0x7FFFFFFFFFFFFFFF)
        xn    : U64  = xb1.shr(48)
        tiny  : Bool = xn.lt(16327)  // |x| < 2^-56: asin(x) - x is below half an ulp
        large : Bool = xn.ge(16383)  // |x| >= 1, infinity or NaN
        when:
            tiny  -> return(self)
            large -> outside(self, xb1)
            else  -> inside(self)

    block outside(self: Self, xb1: U64):
        bits    : U128 = self.bits()
        xb0     : U64  = cm_asin_lo(bits.to_wrap<S128>())
        xsgn    : U64  = cm_asin_hi(bits).bitand(0x8000000000000000)
        is_one  : Bool = xb0.eq(0).bitand(xb1.eq(0x3FFF000000000000))
        is_qnan : Bool = xb1.ge(0x7FFF800000000000)
        hp_hi   : U64  = xsgn.bitor(0x3FFF921FB54442D1)
        half_pi : Self = f128_of(cm_asin_join(hp_hi, 0x8469898CC51701B8))
        nan     : Self = f128_of(cm_asin_join(0xFFFF800000000000, 0))
        when:
            is_one  -> return(half_pi)
            is_qnan -> return(self)
            else    -> return(nan)

    block inside(self: Self):
        r : Self = cm_asin_fast(self)
        return(r)

routine cm_asin_unpack(x: F128) -> CmAsinArg
    block entry():
        bits : U128      = x.bits()
        hi   : U64       = cm_asin_hi(bits)
        xb1  : U64       = hi.bitand(0x7FFFFFFFFFFFFFFF)
        xb0  : U64       = cm_asin_lo(bits.to_wrap<S128>())
        j    : USize     = cm_asin_jget(xb1)
        xa   : U128      = cm_asin_join(xb1.bitor(0x0001000000000000), xb0).shl(15)
        xn   : U64       = xb1.shr(48)
        xsgn : U64       = hi.bitand(0x8000000000000000)
        arg  : CmAsinArg = CmAsinArg { xa: xa, xn: xn.to<S64>(), xsgn: xsgn.to_wrap<S64>(), j: j }
        return(arg)

/// Packs the 113-bit mantissa v (implicit bit included), exponent xn, sign word and round bit.
routine cm_asin_pack(v: U128, xn: S64, xsgn: S64, rnd: U64) -> F128
    block entry():
        sign_exponent : S64  = xn.shl(48).bitor(xsgn)
        top           : U128 = cm_asin_join(sign_exponent.to_wrap<U64>(), rnd)
        r             : F128 = f128_of(v.add_wrap(top))
        return(r)

/// The 128-bit fast path of asin; it falls back to cm_asin_accurate when its result could round
/// either way.
routine cm_asin_fast(x: F128) -> F128
    block entry():
        arg     : CmAsinArg = cm_asin_unpack(x)
        nz      : S64       = 16383.sub(arg.xn)
        reduced : Bool      = arg.j.ne(0)
        branch reduced
            ? reduce(x, arg, nz)
            : direct(x, arg, nz)

    // asin(x) = asin(s_j) + asin(d) for the reduced argument d
    block reduce(x: F128, arg: CmAsinArg, nz: S64):
        x0    : U64         = cm_asin_lo(arg.xa.to_wrap<S128>())
        x1    : U64         = cm_asin_hi(arg.xa)
        root  : CmAsinRoot3 = cm_asin_fast_sqrt(x0, x1, nz, 0)
        d     : CmAsinW3    = cm_asin_reduce3(arg.xa, nz, arg.j, root)
        dz    : S64         = d.w2.leading_zeros().to<S64>()
        t     : U128        = cm_asin_top128(d, dz)
        phi0  : @U64        = CM_ASIN_PHI0.to<@U64>()
        phi_j : CmAsinW3    = cm_asin_load3(phi0, arg.j.mul(5).add(2))
        xc    : CmAsinW3    = cm_asin_add3(d, phi_j)
        f     : U128        = cm_asin_fast_poly(t, dz.sub(6).mul(2))
        sum   : CmAsinW3    = cm_asin_add3(xc, cm_asin_shift_poly3(f, dz.mul(3)))
        // round, and check the error bound of the fast path
        k         : S64  = sum.w2.leading_zeros().to<S64>()
        rnd       : U64  = sum.w1.shr(cm_asin_sh(14.sub(k))).bitand(1)
        err_sh    : S64  = dz.mul(3).sub(6)
        small_err : Bool = err_sh.le(57)
        eps       : U64  = small_err
            ? 0x8000000000000000.shr(cm_asin_sh(err_sh))
            : 64
        msk       : U128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF.shr(cm_asin_sh7(k.add(50)))
        low_words : U128 = cm_asin_join(sum.w1, sum.w0)
        tail      : U128 = low_words.add_wrap(eps.to<U128>()).bitand(msk)
        unsafe    : Bool = tail.lt(eps.mul_wrap(2).to<U128>())
        s         : S64  = cm_asin_sh(15.sub(k)).to<S64>()
        v_lo      : U64  = sum.w1.shr(s.to<U64>()).bitor(sum.w2.shl(cm_asin_sh(k.add(49))))
        v         : U128 = cm_asin_join(sum.w2.shr(s.to<U64>()), v_lo)
        r         : F128 = cm_asin_pack(v, 16382.sub(k), arg.xsgn, rnd)
        branch unsafe
            ? accurate(x)
            : return(r)

    // small |x|: asin(x) = x + x^3*P(x^2)
    block direct(x: F128, arg: CmAsinArg, nz: S64):
        f     : U128        = cm_asin_fast_poly(arg.xa, nz.sub(6).mul(2))
        g     : CmAsinW4    = cm_asin_shift_poly4(f, nz.mul(2).add(1))
        xh    : U128        = arg.xa.shr(1)
        a2    : CmAsinCarry = cm_asin_ac(cm_asin_lo(xh.to_wrap<S128>()), g.w2, 0)
        a3    : CmAsinCarry = cm_asin_ac(cm_asin_hi(xh), g.w3, a2.carry)
        k     : S64         = a3.sum.shr(63).to<S64>()
        rnd   : U64         = a2.sum.shr(cm_asin_sh(k.add(13))).bitand(1)
        v_all : U128        = cm_asin_join(a3.sum, a2.sum).shr(cm_asin_sh7(k.add(14)))
        v     : U128        = v_all.bitand(0xFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        // the bits under the round bit, checked against the error bound
        lk       : S64  = cm_asin_sh(51.sub(k)).to<S64>()
        rk       : S64  = cm_asin_sh(k.add(13)).to<S64>()
        th       : U64  = a2.sum.shl(lk.to<U64>()).bitor(g.w1.shr(rk.to<U64>()))
        tlo      : U64  = g.w1.shl(lk.to<U64>()).bitor(g.w0.shr(rk.to<U64>()))
        eps_base : S64  = nz.mul(2).add(8)
        eps_sh   : S64  = eps_base.add(k)
        eps      : U128 = 0x80000000000000000000000000000000.shr(cm_asin_sh7(eps_sh))
        tt       : U128 = cm_asin_join(th, tlo).add_wrap(eps)
        unsafe   : Bool = tt.lt(eps)
        r        : F128 = cm_asin_pack(v, arg.xn.add(k), arg.xsgn, rnd)
        branch unsafe
            ? accurate(x)
            : return(r)

    block accurate(x: F128):
        r : F128 = cm_asin_accurate(x)
        return(r)

/// A 128-bit f placed as the top two of four words and shifted right by sf (the small-argument
/// alignment of the fast polynomial part), as the original's case split writes it.
routine cm_asin_shift_poly4(f: U128, sf: S64) -> CmAsinW4
    block entry():
        g3      : U64      = cm_asin_hi(f)
        g2      : U64      = cm_asin_lo(f.to_wrap<S128>())
        s       : S64      = cm_asin_sh(sf).to<S64>()
        in_word : Bool     = sf.lt(64)
        in_one  : Bool     = sf.lt(128)
        in_two  : Bool     = sf.lt(192)
        gone    : CmAsinW4 = CmAsinW4 { w0: 0, w1: 0, w2: 0, w3: 0 }
        when:
            in_word -> within_word(g2, g3, s)
            in_one  -> one_word(g2, g3, s)
            in_two  -> two_words(g2, g3, s)
            else    -> return(gone)

    block within_word(g2: U64, g3: U64, s: S64):
        back : S64      = cm_asin_sh(0.sub(s)).to<S64>()
        w1   : U64      = g2.shl(back.to<U64>())
        w2   : U64      = g2.shr(s.to<U64>()).bitor(g3.shl(back.to<U64>()))
        r    : CmAsinW4 = CmAsinW4 { w0: 0, w1: w1, w2: w2, w3: g3.shr(s.to<U64>()) }
        return(r)

    block one_word(g2: U64, g3: U64, s: S64):
        w0 : U64      = g2.shl(cm_asin_sh(0.sub(s)))
        w1 : U64      = g2.shr(s.to<U64>()).bitor(g3.shl(1).shl(cm_asin_sh(s.bitnot())))
        r  : CmAsinW4 = CmAsinW4 { w0: w0, w1: w1, w2: g3.shr(s.to<U64>()), w3: 0 }
        return(r)

    // unreachable for asin (|x| >= 2^-56 keeps sf below 128); kept as the original writes it
    block two_words(g2: U64, g3: U64, s: S64):
        w0 : U64      = g2.shr(s.to<U64>()).bitor(g3.shl(1).shl(cm_asin_sh(s.bitnot())))
        r  : CmAsinW4 = CmAsinW4 { w0: w0, w1: g2.shr(s.to<U64>()), w2: 0, w3: 0 }
        return(r)

/// The 320-bit accurate path of F128.asin for 2^-57 <= |x| < 1 (the C as_asinq_accurate).
routine cm_asin_accurate(x: F128) -> F128
    block entry():
        arg     : CmAsinArg = cm_asin_unpack(x)
        nz      : S64       = 16383.sub(arg.xn)
        reduced : Bool      = arg.j.ne(0)
        branch reduced
            ? reduce(arg, nz)
            : direct(arg, nz)

    block reduce(arg: CmAsinArg, nz: S64):
        x0    : U64         = cm_asin_lo(arg.xa.to_wrap<S128>())
        x1    : U64         = cm_asin_hi(arg.xa)
        root  : CmAsinRoot5 = cm_asin_getcos(nz, x0, x1)
        d     : CmAsinW5    = cm_asin_reduce5(arg.xa, nz, arg.j, root)
        dz    : S64         = cm_asin_clz5(d, nz)
        t     : CmAsinW5    = cm_asin_shift5(d, 0.sub(dz))
        phi0  : @U64        = CM_ASIN_PHI0.to<@U64>()
        phi_j : CmAsinW5    = cm_asin_load5(phi0, arg.j.mul(5))
        xc    : CmAsinW5    = cm_asin_add5(phi_j, d)
        p     : CmAsinW5    = cm_asin_poly5(t, dz)
        sum   : CmAsinW5    = cm_asin_add5(xc, cm_asin_shift5(p, dz.mul(3)))
        k     : S64         = sum.w4.leading_zeros().to<S64>()
        rnd   : U64         = sum.w3.shr(cm_asin_sh(14.sub(k))).bitand(1)
        s     : S64         = cm_asin_sh(15.sub(k)).to<S64>()
        v_lo  : U64         = sum.w3.shr(s.to<U64>()).bitor(sum.w4.shl(cm_asin_sh(k.add(49))))
        v     : U128        = cm_asin_join(sum.w4.shr(s.to<U64>()), v_lo)
        r     : F128        = cm_asin_pack(v, 16382.sub(k), arg.xsgn, rnd)
        return(r)

    block direct(arg: CmAsinArg, nz: S64):
        x0      : U64         = cm_asin_lo(arg.xa.to_wrap<S128>())
        x1      : U64         = cm_asin_hi(arg.xa)
        t       : CmAsinW5    = CmAsinW5 { w0: 0, w1: 0, w2: 0, w3: x0, w4: x1 }
        p       : CmAsinW5    = cm_asin_poly5(t, nz)
        f       : CmAsinW5    = cm_asin_shift5(p, nz.mul(2).add(1))
        xh      : U128        = arg.xa.shr(1)
        a3      : CmAsinCarry = cm_asin_ac(cm_asin_lo(xh.to_wrap<S128>()), f.w3, 0)
        a4      : CmAsinCarry = cm_asin_ac(cm_asin_hi(xh), f.w4, a3.carry)
        k       : S64         = a4.sum.shr(63).to<S64>()
        rnd     : U64         = a3.sum.shr(cm_asin_sh(k.add(13))).bitand(1)
        v_shift : S64         = cm_asin_sh(k.add(14)).to_wrap<S64>()
        v_all   : U128        = cm_asin_join(a4.sum, a3.sum).shr(v_shift.to<U128>())
        v       : U128        = v_all.bitand(0xFFFFFFFFFFFFFFFFFFFFFFFFFFFF)
        r       : F128        = cm_asin_pack(v, arg.xn.add(k), arg.xsgn, rnd)
        return(r)
