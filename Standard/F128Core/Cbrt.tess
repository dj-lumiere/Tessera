// Tessera stdlib: correctly rounded cube root of F128
//
// Ported from CORE-MATH, src/binary128/cbrt/cbrtq.c via RazorForge's B128Cbrt.rf.
// Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// F128.cbrt returns the exact cube root rounded to the nearest F128 (ties to
// even). Only the round-to-nearest path of the original is kept: Tessera has no
// dynamic rounding modes or exception flags. cbrt(-x) = -cbrt(x). ±0, ±inf and
// NaN map to themselves, a signaling NaN is quieted.
//
// The work is all 64- and 128-bit integer code. A polynomial from a 16-entry
// table gives 1/cbrt of the leading significand bits, one Newton step lifts it
// to about 120 bits of cbrt, and when that lands too close to a rounding
// boundary the exact residual c^3 - x of a 113-bit candidate c decides it.
// Words are U64 / U128. Word arithmetic that relies on C's wrap-around uses the _wrap forms.
// Exponents, counts, and shift amounts use the plain (overflow-checked) ones.

module Standard::Core

// -- tables --------------------------------------------------------------------

/// packed coefficients c0, c1, c2 of the 1/cbrt polynomial, per leading 4 bits
preset CM_CBRT_KNST: @Array<U64, 16> <- { 0xD3ED1E72EFD6337B, 0xB8BCBB918F877572,
    0xA244650B6F3E7F80, 0x8F8418C89EFA9D5E, 0x7FB3D5217EBB3895, 0x724398C31E7FD263,
    0x66C3629B4E47FF19, 0x5CD331CA2E136288, 0x543B0596EDE1AD3B, 0x4CBADD683DB29A42,
    0x4622B8BD8D85ED78, 0x4052972A5D5B7219, 0x3B327852AD32F99E, 0x369A5BE7FD0C5AD6,
    0x328241A6BCE7711B, 0x2EDA2954ACC41BB2 }

/// the c3 coefficient, per leading 4 bits
preset CM_CBRT_KNSTH: @Array<U64, 16> <- { 0xA0, 0x83, 0x6D, 0x5C, 0x4E, 0x42, 0x39, 0x31, 0x2B,
    0x25, 0x21, 0x1D, 0x1A, 0x17, 0x15, 0x13 }

/// 2^63 / cbrt(2^i), i = 0, 1, 2
preset CM_CBRT_RCBRT_I: @Array<U64, 3> <- { 0x8000000000000000, 0x6597FA94F5B8F20B,
    0x50A28BE635CA2B89 }

preset CM_CBRT_LOW64:     U128 = U64.MAX.to<U128>()
preset CM_CBRT_QUIET_HI:  S64  = F128_QUIET_BIT.shr(64).to<S64>()  // quiet bit in the high word
preset CM_CBRT_TWO_THIRD: U64  = 0xAAAAAAAAAAAAAAAB  // 2/3 in 0.64 fixed point
preset CM_CBRT_ONE_THIRD: S64  = 0x5555555555555555  // 1/3 in 0.64 fixed point

// -- entry point ---------------------------------------------------------------

/// The cube root of `self`, correctly rounded to nearest (a CORE-MATH port).
/// :returns: cbrt(`self`), with the sign of `self`. ±0 and ±inf map to themselves, and a NaN comes back quieted.
routine F128.cbrt(self: Self) -> Self
    shared bits : U128 = self.bits()

    block entry()
        nan   : Bool = self.is_nan()
        quiet : Self = f128_of(f128_quiet(self.bits()))
        branch nan
            ? return(quiet)
            : continue
        hi       : U64  = bits.shr(64).to<U64>()
        sign     : U64  = hi.shr(63)
        exponent : U64  = hi.shr(48).bitand(0x7FFF)
        is_tiny  : Bool = exponent.eq(0)
        special  : Bool = exponent.eq(0x7FFF)
        when
            is_tiny -> subnormal(sign)
            special -> return(cm_cbrt_special(self))
            else    -> normal(sign, exponent)

    block normal(sign: U64, exponent: U64)
        e3  : U64  = exponent.div(3).add(10922)
        rem : U64  = exponent.mod(3)
        r   : Self = cm_cbrt_finish(bits, rem, e3, sign)
        return(r)

    // subnormal or ±0: normalize the significand so its top bit sits at bit 112
    block subnormal(sign: U64)
        magnitude : U128 = bits.bitand(F128_SIGN.bitnot())
        is_zero   : Bool = magnitude.eq(0)
        branch is_zero
            ? return(self)
            : continue
        lz       : U128 = magnitude.leading_zeros()
        shift    : S64  = lz.to<S64>().sub(15)
        exponent : U64  = 121.sub(shift).to<U64>()
        e3       : U64  = exponent.div(3).add(10882)
        rem      : U64  = exponent.mod(3)
        scaled   : U128 = magnitude.shl(shift.to<U128>())
        r        : Self = cm_cbrt_finish(scaled, rem, e3, sign)
        return(r)

/// cbrt of NaN or ±inf: a signaling NaN is quieted, everything else maps to itself.
/// :param x: A NaN or an infinity.
/// :returns: `x`, quieted when it is a signaling NaN.
routine cm_cbrt_special(x: F128) -> F128
    block entry()
        bits      : U128 = x.bits()
        hi        : S64  = bits.shr(64).to_wrap<S64>()
        is_nan    : Bool = bits.shl(16).ne(0)
        quiet     : Bool = hi.bitand(CM_CBRT_QUIET_HI).ne(0)
        signaling : Bool = is_nan.bitand(quiet.bitnot())
        quieted   : F128 = f128_of(bits.bitor(F128_QUIET_BIT))
        r         : F128 = signaling
            ? quieted
            : x
        return(r)

/// Packs the cube root of the significand in `u` (the exponent's remainder mod 3
/// in `rem`) with the biased result exponent `e3` and the sign. Adding the round
/// bit carries into the exponent when rounding up overflows the fraction.
/// :param u: Bits whose low 112 are the fraction (anything above is shifted out).
/// :param rem: The biased exponent mod 3 (0, 1 or 2).
/// :param e3: The biased exponent of the result.
/// :param sign: The sign bit (0 or 1).
/// :returns: The rounded cube root.
routine cm_cbrt_finish(u: U128, rem: U64, e3: U64, sign: U64) -> F128
    block entry()
        root        : U128 = cm_cbrt_icbrt(u.shl(16), rem.to<S64>())
        round       : U128 = root.shr(15).bitand(1)
        top         : U64  = e3.shl(48).bitor(sign.shl(63))
        top_shifted : U128 = top.to<U128>().shl(64)
        offset      : U128 = top_shifted.bitor(round)
        r           : F128 = f128_of(root.shr(16).add_wrap(offset))
        return(r)

// -- multiword products --------------------------------------------------------

/// The high word of the unsigned 64x64-bit product.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: (`a` × `b`) >> 64.
routine cm_cbrt_mhuu(a: U64, b: U64) -> U64
    block entry()
        product : U128 = a.to<U128>().mul_wrap(b.to<U128>())
        r       : U64  = product.shr(64).to<U64>()
        return(r)

/// The high word of the signed 64x64-bit product.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The signed (`a` × `b`) >> 64, as its bits.
routine cm_cbrt_mhii(a: S64, b: S64) -> U64
    block entry()
        product : S128 = a.to<S128>().mul_wrap(b.to<S128>())
        r       : U64  = product.shr(64).to_wrap<U64>()
        return(r)

/// The approximate high half of the unsigned 128x128-bit product (a0*b0 and the
/// carries out of the low halves are dropped).
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: Approximately (`a` × `b`) >> 128.
routine cm_cbrt_mhUU(a: U128, b: U128) -> U128
    block entry()
        a0   : U128 = a.bitand(CM_CBRT_LOW64)
        a1   : U128 = a.shr(64)
        b0   : U128 = b.bitand(CM_CBRT_LOW64)
        b1   : U128 = b.shr(64)
        a1b0 : U128 = a1.mul_wrap(b0)
        a0b1 : U128 = a0.mul_wrap(b1)
        a1b1 : U128 = a1.mul_wrap(b1)
        r    : U128 = a1b1.add_wrap(a1b0.shr(64)).add_wrap(a0b1.shr(64))
        return(r)

/// The high 128 bits of the unsigned 64x128-bit product.
/// :param y: The one-word factor.
/// :param x: The two-word factor.
/// :returns: (`y` × `x`) >> 64.
routine cm_cbrt_mhuU(y: U64, x: U128) -> U128
    block entry()
        y_wide : U128 = y.to<U128>()
        xy0    : U128 = x.bitand(CM_CBRT_LOW64).mul_wrap(y_wide)
        xy1    : U128 = x.shr(64).mul_wrap(y_wide)
        r      : U128 = xy1.add_wrap(xy0.shr(64))
        return(r)

// -- the root ------------------------------------------------------------------

/// 1 + r ~ 1/cbrt(m), r signed, from the high significand word m (top bit set): a cubic picked by the leading
/// 4 bits, then one correction step.
/// :param m: The high significand word, top bit set (m read as a value in [1, 2)).
/// :returns: r as a signed 0.64 fixed-point value.
routine cm_cbrt_rcbrt(m: U64) -> S64
    block entry()
        index  : USize = m.shr(60).to<USize>()
        knst   : @U64  = CM_CBRT_KNST.to<@U64>()
        knsth  : @U64  = CM_CBRT_KNSTH.to<@U64>()
        packed : U64   = knst.stride(index).load()
        c3     : U64   = knsth.stride(index).load()
        c0     : U64   = packed.shl(36)
        c1     : U64   = packed.shl(13).shr(37)
        c2     : U64   = packed.shr(42)
        d      : U64   = cm_sar(m.shl(4).sub_wrap(0x8000000000000000), 32)
        d2     : U64   = d.mul_wrap(d).shr(32)
        even   : U64   = c0.add_wrap(d2.mul_wrap(c2))
        odd_c  : U64   = c1.add(d2.mul_wrap(c3).shr(22))
        odd    : U64   = d.mul_wrap(odd_c)
        r      : U64   = even.sub_wrap(odd)
        jump refine(r.to_wrap<S64>())

    // one correction step: r -= r * h / 3 with h ~ m * (1 + r)^3 - 1
    block refine(r: S64)
        r2       : U64 = cm_cbrt_mhuu(r.to_wrap<U64>(), r.to_wrap<U64>())
        r3       : U64 = cm_cbrt_mhuu(r2, r.to_wrap<U64>())
        err_raw  : U64 = cm_cbrt_mhuu(m, r3).add_wrap(r3)
        err      : U64 = err_raw.shl(22)
        third    : U64 = cm_cbrt_mhii(err.to_wrap<S64>(), CM_CBRT_ONE_THIRD)
        third_sq : U64 = cm_cbrt_mhii(third.to_wrap<S64>(), third.to_wrap<S64>())
        h        : U64 = third.sub_wrap(third_sq.shr(21))
        hr_bits  : U64 = cm_cbrt_mhii(h.to_wrap<S64>(), r).add_wrap(h)
        hr       : S64 = hr_bits.to_wrap<S64>()
        result   : S64 = r.sub_wrap(hr.shr(22))
        return(result)

/// The cube root of the significand, 2^i × (1 + x / 2^128) with x the fraction
/// bits left-aligned, refined by one Newton step. The root comes back the same
/// way, its leading 1 dropped: 112 fraction bits at 16..127, the round bit at 15
/// and 15 more below. When those low bits sit too close to a rounding boundary,
/// the rounding is decided exactly by {cm_cbrt_exact}.
/// :param x: The fraction bits, left-aligned.
/// :param i: The exponent remainder mod 3 (0, 1 or 2).
/// :returns: The root's fraction bits, laid out as above.
routine cm_cbrt_icbrt(x: U128, i: S64) -> U128
    block entry()
        x_hi     : S64  = x.shr(64).to_wrap<S64>()
        approx   : S64  = cm_cbrt_rcbrt(x_hi.to_wrap<U64>())
        is_small : Bool = approx.ge(0)
        clamped  : S64  = is_small
            ? -1
            : approx
        scale   : @U64 = CM_CBRT_RCBRT_I.to<@U64>()
        factor  : U64  = scale.stride(i.to<SSize>()).load()
        r       : U64  = cm_cbrt_mhuu(clamped.to_wrap<U64>(), factor)
        r_wide  : U128 = r.to<U128>()
        r2      : U128 = r_wide.mul_wrap(r_wide)
        top_bit : U128 = 1.shl(125.add(i).to<U128>())
        xs      : U128 = x.shr(3.sub(i).to<U128>()).bitor(top_bit)
        sx      : U128 = cm_cbrt_mhUU(r2, xs)
        jump newton(xs, r, sx)

    // sx = r^2 x ~ cbrt(x). With h = r sx - 1, the Newton step is sx -= sx h / 3
    // (h3 = 2h/3, the product taken as signed, then shifted into place)
    block newton(xs: U128, r: U64, sx: U128)
        h           : S64  = cm_cbrt_mhuU(r, sx).to_wrap<S64>()
        h_neg       : U64  = h.shr(63).to_wrap<U64>()
        h_fix       : U64  = h_neg.bitand(CM_CBRT_TWO_THIRD)
        h3          : U64  = cm_cbrt_mhuu(h.to_wrap<U64>(), CM_CBRT_TWO_THIRD).sub_wrap(h_fix)
        h3_wide     : U128 = h3.to<U128>()
        mm          : U128 = h_neg.to_wrap<S64>().to_wrap<U128>()
        xy1         : U128 = sx.shr(64).mul_wrap(h3_wide)
        xy0         : U128 = sx.bitand(CM_CBRT_LOW64).mul_wrap(h3_wide)
        t_bits      : U128 = xy1.sub_wrap(mm.bitand(sx)).add_wrap(xy0.shr(64))
        t           : S128 = t_bits.to_wrap<S128>()
        ds          : U128 = t.shr(53).to_wrap<U128>()
        sx1         : U128 = sx.shl(5).sub_wrap(ds)
        sx1_doubled : U64  = sx1.to_wrap<U64>().shl(1)
        dd          : U64  = sx1_doubled.add_wrap(511).bitand(0xFFFF)
        boundary    : Bool = dd.lt(1023)
        branch boundary
            ? return(cm_cbrt_exact(sx1, xs))
            : return(sx1)

/// Rounds the candidate c = round(sx1 / 2^15) with c^3 - x: the result is c
/// shifted back, nudged by one so the caller's round bit goes the right way.
/// :param sx1: The approximate root from the Newton step.
/// :param xs: The scaled argument the root was taken of.
/// :returns: c × 2^15 plus one when c^3 is below x, minus one when it is above, or unchanged when exact.
routine cm_cbrt_exact(sx1: U128, xs: U128) -> U128
    block entry()
        rounded : U128 = sx1.add_wrap(0x4000).shr(15)
        c       : U128 = rounded.bitor(1.shl(113))
        // c^3 needs 342 bits, but c^3 - x × 2^214 is small, so modulo 2^256 its sign and zero test hold
        cube   : U256 = c.mul_wide(c).mul_wrap(c.to<U256>())
        target : U256 = xs.to<U256>().shl(214)
        excess : S256 = cube.sub_wrap(target).to_wrap<S256>()
        base   : U128 = c.shl(15)
        below  : Bool = excess.lt(0)
        above  : Bool = excess.ne(0)
        when
            below -> return(base.add_wrap(1))
            above -> return(base.sub_wrap(1))
            else  -> return(base)
