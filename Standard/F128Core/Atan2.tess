// Tessera stdlib: correctly rounded two-argument arc tangent of F128
//
// Ported from CORE-MATH, src/binary128/atan2/atan2q.c via RazorForge's B128Atan2.rf.
// Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// F128.atan2(y, x) is the exact angle of the point (x, y), in [-π, π], rounded to nearest,
// ties to even. The ratio b/a of min(|x|, |y|) to max(|x|, |y|) is reduced against a table angle
// atan(t) with t = TN[i] / 2^15, the series runs in AtanShared.tess, and the angle is rebuilt as
// ±(PHI0[i] + f) plus a quadrant offset 0, π/2 or π, and y's sign goes on last. Zero and infinite
// coordinates follow C99 Annex F (signed zeros pick 0 or π, infinities the multiples of π/4).
// NaN in gives NaN out as in every F128 operation: y quieted when it is NaN, else x quieted, the payload kept.

module Standard::Core

/// 0, π, 3π/4, π/4, π/2 as (lo, hi) pairs of fixed point with 2 integer bits
preset CM_ATAN2_RS: @Array<U64, 10> <- { 0x0000000000000000, 0x0000000000000000, 0x62633145C06E0E69,
    0x6487ED5110B4611A, 0xC9CA64F450528ACE, 0x4B65F1FCCC8748D3, 0x9898CC51701B839A,
    0x1921FB54442D1846, 0x313198A2E0370734, 0x3243F6A8885A308D }

/// reciprocal estimates of the top mantissa bits of max(|x|, |y|), for the table-index guess
preset CM_ATAN2_RCP: @Array<U64, 128> <- { 0, 248, 240, 232, 224, 217, 210, 202, 195, 188, 181, 174,
    168, 161, 155, 148, 142, 135, 129, 123, 117, 111, 105, 100, 94, 88, 83, 77, 72, 66, 61, 56, 51,
    46, 41, 36, 31, 26, 21, 16, 12, 7, 3, 254, 250, 245, 241, 236, 232, 228, 224, 220, 216, 212,
    208, 204, 200, 196, 192, 188, 185, 181, 177, 174, 170, 167, 163, 160, 156, 153, 149, 146, 143,
    140, 136, 133, 130, 127, 124, 121, 118, 115, 112, 109, 106, 103, 100, 97, 94, 92, 89, 86, 83,
    81, 78, 75, 73, 70, 67, 65, 62, 60, 57, 55, 52, 50, 48, 45, 43, 41, 38, 36, 34, 31, 29, 27, 25,
    22, 20, 18, 16, 14, 12, 10, 8, 6, 4, 2 }

/// the table index from the estimated ratio min/max × 2^7
preset CM_ATAN2_IND: @Array<U64, 129> <- { 0, 0, 1, 1, 2, 3, 3, 4, 5, 5, 6, 6, 7, 8, 8, 9, 10, 10,
    11, 11, 12, 13, 13, 14, 15, 15, 16, 16, 17, 18, 18, 19, 19, 20, 21, 21, 22, 22, 23, 23, 24, 25,
    25, 26, 26, 27, 27, 28, 29, 29, 30, 30, 31, 31, 32, 32, 33, 33, 34, 34, 35, 36, 36, 37, 37, 38,
    38, 39, 39, 40, 40, 41, 41, 41, 42, 42, 43, 43, 44, 44, 45, 45, 46, 46, 47, 47, 47, 48, 48, 49,
    49, 50, 50, 50, 51, 51, 52, 52, 52, 53, 53, 54, 54, 54, 55, 55, 56, 56, 56, 57, 57, 57, 58, 58,
    58, 59, 59, 60, 60, 60, 61, 61, 61, 62, 62, 62, 63, 63, 63 }

/// atan2(y, x) for y = `self`: the angle of the point (x, y), correctly rounded to nearest (a CORE-MATH port).
/// Zeros and infinities follow IEEE's rules (signed zeros pick 0 or pi, two infinities a multiple of pi/4).
/// :param x: The x coordinate.
/// :returns: The angle in [-pi, pi], with the sign of `self`. A NaN argument comes back quieted (`self` first).
routine F128.atan2(self: Self, x: Self) -> Self
    shared x_neg     : Bool = f128_is_negative_bits(x.bits())
    shared y_sign    : U128 = self.bits().bitand(F128_SIGN)
    shared magnitude : U128 = F128_SIGN.bitnot()
    shared xa        : U128 = x.bits().bitand(magnitude)
    shared ya        : U128 = self.bits().bitand(magnitude)

    block entry()
        nonfinite : Bool = xa.ge(F128_INF).bitor(ya.ge(F128_INF))
        branch nonfinite
            ? special()
            : reduce()

    block special()
        r : Self = cm_atan2_special(self, x)
        return(r)

    block reduce()
        red  : CmAtanReduction = cm_atan2_reduce(xa, ya)
        zero : Bool            = red.zero
        branch zero
            ? special()
            : fast(red)

    block fast(red: CmAtanReduction)
        kd       : U128 = cm_atan_join(red.kd2, red.kd1)
        f        : U128 = cm_atan_fast_core(red.kn, kd, red.dn)
        in_table : Bool = red.isct.ne(0).bitor(red.g)
        table    : Bool = in_table.bitor(x_neg)
        branch table
            ? with_table(red, f)
            : direct(red, f)

    // the angle ±(PHI0[isct] + f) + (0, π/2 or π): negated when exactly one of |x| < |y| and
    // x < 0 holds
    block with_table(red: CmAtanReduction, f: U128)
        placed  : CmAtanU192 = cm_atan_place(f, red.dn.add(1))
        phi     : CmAtanU192 = cm_atan_row_top(CM_ATAN_PHI0.to<@U64>(), red.isct)
        angle   : CmAtanU192 = cm_atan_u192_add(phi, placed)
        flip    : Bool       = red.g.bitxor(x_neg)
        negated : CmAtanU192 = cm_atan_u192_not(angle)
        signed  : CmAtanU192 = flip
            ? negated
            : angle
        q       : USize         = cm_atan2_quadrant(red.g, x_neg)
        offset  : CmAtanU192    = cm_atan_row_top(CM_ATAN_QOFF.to<@U64>(), q)
        final   : CmAtanU192    = cm_atan_u192_add(offset, signed)
        rounded : CmAtanRounded = cm_atan_round_fixed(final)
        result  : Self          = f128_of(rounded.bits.bitor(y_sign))
        hard    : Bool          = rounded.hard
        branch hard
            ? accurate(red, x_neg)
            : return(result)

    block direct(red: CmAtanReduction, f: U128)
        rounded : CmAtanRounded = cm_atan_round_direct(f, red.dn)
        result  : Self          = f128_of(rounded.bits.bitor(y_sign))
        hard    : Bool          = rounded.hard
        branch hard
            ? accurate(red, false)
            : return(result)

    block accurate(red: CmAtanReduction, x_negative: Bool)
        r : Self = cm_atan2_accurate(red, x_negative, y_sign)
        return(r)

/// The row of the quadrant offset: 0 (none), 1 (pi/2 when |x| < |y|), 2 (pi when x < 0, |x| >= |y|).
/// :param g: True when |x| < |y|.
/// :param x_neg: True when x is negative.
/// :returns: The row of CM_ATAN_QOFF to add, 0, 1 or 2.
routine cm_atan2_quadrant(g: Bool, x_neg: Bool) -> USize
    block entry()
        left : USize = x_neg
            ? 2
            : 0
        q : USize = g
            ? 1
            : left
        return(q)

/// Reduces b/a for a = max(|x|, |y|), b = min(|x|, |y|) (sign-stripped bits) against the table
/// angle atan(TN[isct] / 2^15). Subnormal coordinates are normalized first.
/// :param xa: The bits of |x|, finite.
/// :param ya: The bits of |y|, finite.
/// :returns: The reduced argument, `g` set when |x| < |y|, and `zero` set when b = 0.
routine cm_atan2_reduce(xa: U128, ya: U128) -> CmAtanReduction
    shared g : Bool = xa.lt(ya)
    shared a : U128 = g
        ? ya
        : xa
    shared b : U128 = g
        ? xa
        : ya
    shared xn : S64 = a.shr(112).to<S64>()

    block entry()
        yn          : S64  = b.shr(112).to<S64>()
        b_subnormal : Bool = yn.eq(0)
        branch b_subnormal
            ? scale()
            : estimate(a, b, xn, yn)

    // subnormal b (or a too): normalize the significand, extending the exponent below 1
    block scale()
        b_zero      : Bool            = b.eq(0)
        none        : CmAtanReduction = CmAtanReduction { zero: true, g: g, isct: 0, dn: 0, kn: 0,
            kd0: 0, kd1: 0, kd2: 0 }
        lz_b        : U128            = b.leading_zeros()
        ns_b        : S64             = lz_b.to<S64>().sub(15)
        b_norm      : U128            = b.shl(ns_b.max(0).to<U128>())
        yn          : S64             = 1.sub(ns_b)
        a_subnormal : Bool            = xn.eq(0)
        lz_a        : U128            = a.leading_zeros()
        ns_a        : S64             = lz_a.to<S64>().sub(15)
        a_norm      : U128            = a.shl(ns_a.max(0).to<U128>())
        a_used      : U128            = a_subnormal
            ? a_norm
            : a
        xn_used : S64 = a_subnormal
            ? 1.sub(ns_a)
            : xn
        branch b_zero
            ? return(none)
            : estimate(a_used, b_norm, xn_used, yn)

    // the table index from b × (1/a) estimated in a few bits, then corrected by one
    block estimate(a_raw: U128, b_raw: U128, a_exponent: S64, yn: S64)
        dn         : S64   = a_exponent.sub(yn)
        a_hi       : U64   = a_raw.shr(64).to<U64>()
        ah         : U64   = a_hi.bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        b_hi       : U64   = b_raw.shr(64).to<U64>()
        bh         : U64   = b_hi.bitand(0x0000FFFFFFFFFFFF).bitor(0x0001000000000000)
        a_full     : U128  = cm_atan_join(ah, a_raw.to_wrap<U64>())
        b_full     : U128  = cm_atan_join(bh, b_raw.to_wrap<U64>())
        inda_bits  : U64   = ah.shr(41).bitand(127)
        inda       : USize = inda_bits.to<USize>()
        rcp        : U64   = CM_ATAN2_RCP.getitem(inda)
        at_zero    : U64   = inda.eq(0).to<U64>()
        rsc        : U64   = at_zero.add(inda.lt(43).to<U64>()).add(2)
        rcpx       : U64   = rsc.shl(8).bitor(rcp)
        ratio_wide : U64   = bh.shr(10).mul_wrap(rcpx)
        ratio      : U64   = ratio_wide.shr(41)
        near       : Bool  = dn.lt(64)
        scaled     : U64   = ratio.shr(dn.min(63).to<U64>())
        k          : USize = near
            ? scaled.to<USize>()
            : 0
        guess : USize = CM_ATAN2_IND.getitem(k).to<USize>()
        jump correct(a_full, b_full, dn, near, guess)

    block correct(a_full: U128, b_full: U128, dn: S64, near: Bool, guess: USize)
        next_at      : USize = guess.add(1)
        next_tn      : U64   = CM_ATAN_TN.getitem(next_at)
        ah           : U64   = a_full.shr(64).to<U64>()
        bh           : U64   = b_full.shr(64).to<U64>()
        next_product : U64   = ah.shr(15).mul_wrap(next_tn)
        below        : Bool  = next_product.lt(bh.shr(dn.min(63).to<U64>()))
        bump         : Bool  = near.bitand(below)
        isct         : USize = guess.add(bump.to<USize>())
        plain        : Bool  = isct.eq(0)
        branch plain
            ? plain(a_full, b_full, dn)
            : offset(a_full, b_full, dn, isct.min(63))

    // b/a itself: kn = b, kd = a
    block plain(a_full: U128, b_full: U128, dn: S64)
        kn : U128            = b_full.shl(15)
        kd : U128            = a_full.shl(15)
        r  : CmAtanReduction = CmAtanReduction { zero: false, g: g, isct: 0, dn: dn, kn: kn, kd0: 0,
            kd1: kd.to_wrap<U64>(), kd2: kd.shr(64).to<U64>() }
        return(r)

    // kn = b - a t, kd = a + b t (scaled), the index moved down one when kn goes negative
    block offset(a_full: U128, b_full: U128, dn: S64, first: USize)
        first_tn      : U64   = CM_ATAN_TN.getitem(first)
        shift         : S128  = dn.to<S128>()
        kn_first_bits : U128  = b_full.shl(15).sub_wrap(a_full.mul_wrap(first_tn.to<U128>()).shl(shift.to<U128>()))
        kn_first      : S128  = kn_first_bits.to_wrap<S128>()
        over          : Bool  = kn_first.lt(0)
        isct          : USize = over
            ? first.sub(1)
            : first
        tn      : U64  = CM_ATAN_TN.getitem(isct)
        kn_raw  : U128 = b_full.shl(15).sub_wrap(a_full.mul_wrap(tn.to<U128>()).shl(shift.to<U128>()))
        kn_zero : Bool = kn_raw.eq(0)
        nzn_raw : S64  = kn_raw.leading_zeros().to<S64>()
        nzn     : S64  = kn_zero
            ? 0
            : nzn_raw
        kn : U128 = kn_raw.shl(nzn.to<U128>())
        // kd = a × 2^(15 + dn) + b t as 192 bits, then normalized
        sl        : S64        = dn.add(15)
        a_word    : U64        = a_full.shr(64).to<U64>()
        a_top     : U64        = a_word.shr(49.sub(dn).to<U64>())
        a_shifted : CmAtanU192 = CmAtanU192 { top: a_top, low: a_full.shl(sl.to<U128>()) }
        bt        : CmAtanU192 = CmAtanU192 { top: 0, low: b_full.mul_wrap(tn.to<U128>()) }
        kd        : CmAtanU192 = cm_atan_u192_add(a_shifted, bt)
        jump normalize(isct, dn, kn, nzn, kd)

    // shift kd left until its top bit is set: a whole limb first if the top one is empty
    block normalize(isct: USize, dn: S64, kn: U128, nzn: S64, kd: CmAtanU192)
        empty : Bool = kd.top.eq(0)
        top0  : U64  = empty
            ? kd.low.shr(64).to<U64>()
            : kd.top
        low0 : U128 = empty
            ? kd.low.shl(64)
            : kd.low
        z           : S64             = top0.leading_zeros().to<S64>()
        low0_hi     : U64             = low0.shr(64).to<U64>()
        under_shift : S64             = z.bitnot().bitand(63)
        under       : U64             = low0_hi.shr(1).shr(under_shift.to<U64>())
        kd2         : U64             = top0.shl(z.to<U64>()).bitor(under)
        low         : U128            = low0.shl(z.to<U128>())
        empty_bits  : S64             = empty.to<S64>().mul(64)
        nzd         : S64             = empty_bits.add(z)
        dn_new      : S64             = nzn.sub(nzd).add(64)
        r           : CmAtanReduction = CmAtanReduction { zero: false, g: g, isct: isct, dn: dn_new,
            kn: kn, kd0: low.to_wrap<S64>(), kd1: low.shr(64).to<U64>(), kd2: kd2 }
        return(r)

/// The accurate path of atan2: the same reduction, the series and the reconstruction in 6 limbs.
/// :param red: The reduction from {cm_atan2_reduce}.
/// :param x_neg: True when x is negative.
/// :param y_sign: The sign bit of y, in place in an F128's bits.
/// :returns: atan2(y, x), correctly rounded.
routine cm_atan2_accurate(red: CmAtanReduction, x_neg: Bool, y_sign: U128) -> F128
    shared f_buf : @Array<S64, 8> <- uninit
    shared f     : @U64           = f_buf.to<@U64>()

    block entry()
        cm_atan_accurate_core(red, f)
        in_table : Bool = red.isct.ne(0).bitor(red.g)
        table    : Bool = in_table.bitor(x_neg)
        branch table
            ? with_table()
            : finish(red.dn)

    block with_table()
        dn : S64 = red.dn
        cm_atan_limbs_shr(f, 6, dn.add(1))
        row : USize = red.isct.mul(6)
        phi : @U64  = CM_ATAN_PHI0.to<@U64>().stride(row)
        cm_atan_limbs_add(f, phi, f, 6)
        flip : Bool = red.g.bitxor(x_neg)
        branch flip
            ? negate()
            : quadrant()

    block negate()
        cm_atan_limbs_not(f, 6)
        jump quadrant()

    block quadrant()
        q      : USize = cm_atan2_quadrant(red.g, x_neg)
        row    : USize = q.mul(6)
        offset : @U64  = CM_ATAN_QOFF.to<@U64>().stride(row)
        cm_atan_limbs_add(f, offset, f, 6)
        jump finish(-1)

    block finish(dn: S64)
        bits : U128 = cm_atan_round_limbs(f, dn)
        r    : F128 = f128_of(bits.bitor(y_sign))
        return(r)

/// atan2 for NaN, infinite or zero coordinates.
/// :param y: The y coordinate.
/// :param x: The x coordinate.
/// :returns: `y` quieted when it is NaN, else `x` quieted when it is, else the exact-case angle: 0 or pi on the x
///     axis, ±pi/4 or ±3pi/4 for two infinities, otherwise ±pi/2, with the sign of `y`.
routine cm_atan2_special(y: F128, x: F128) -> F128
    shared magnitude : U128 = F128_SIGN.bitnot()
    shared ix        : U128 = x.bits().bitand(magnitude)
    shared iy        : U128 = y.bits().bitand(magnitude)
    shared x_class   : S64  = cm_atan_class(ix.shr(64).to<U64>(), ix.to_wrap<U64>())
    shared y_class   : S64  = cm_atan_class(iy.shr(64).to<U64>(), iy.to_wrap<U64>())

    block entry()
        nan : Bool = x_class.ge(2).bitor(y_class.ge(2))
        branch nan
            ? return(f128_nan_of(y, x))
            : angle()

    // the angle's row in RS: 0 or π on the x axis, π/4 or 3π/4 for two infinities, else π/2
    block angle()
        x_bits  : U128 = x.bits()
        xs      : U64  = x_bits.shr(127).to<U64>()
        x_inf   : Bool = x_class.eq(1)
        y_inf   : Bool = y_class.eq(1)
        on_axis : U64  = iy.eq(0)
            ? xs
            : 4
        steep : U64 = y_inf
            ? 4
            : on_axis
        flat : U64 = x_inf
            ? xs
            : steep
        corner : Bool = x_inf.bitand(y_inf)
        idx    : U64  = corner
            ? 3.sub(xs)
            : flat
        lo_at   : USize = idx.to<USize>().mul(2)
        hi_at   : USize = lo_at.add(1)
        ol      : U64   = CM_ATAN2_RS.getitem(lo_at)
        oh      : U64   = CM_ATAN2_RS.getitem(hi_at)
        y_sign  : U128  = y.bits().bitand(F128_SIGN)
        zero    : F128  = f128_of(y_sign)
        is_zero : Bool  = oh.eq(0)
        branch is_zero
            ? return(zero)
            : continue
        k    : U64 = oh.leading_zeros()
        rnd  : U64 = ol.shr(14.sub(k)).bitand(1)
        frac : U64 = ol.shl(49.add(k))
        up   : U64 = frac.eq(0)
            ? 0
            : rnd
        xn   : U64  = 0x4000.sub(k)
        v0   : U64  = ol.shr(15.sub(k)).bitor(oh.shl(49.add(k)))
        v1   : U64  = oh.shr(15.sub(k))
        bits : U128 = cm_atan_join(v1, v0).add_wrap(cm_atan_join(xn.shl(48), up))
        r    : F128 = f128_of(bits.bitor(y_sign))
        return(r)
