// Tessera stdlib: CORE-MATH multi-word integer helpers for the binary128 log and expm1
//
// Ported from CORE-MATH, src/binary128/log/logq.c and src/binary128/expm1/expm1q.c via RazorForge's
// B128Wide.rf (https://core-math.gitlabpages.inria.fr/).
// Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH
//
// Words are U64 and U128, and word arithmetic wraps (_wrap) like the C unsigned arithmetic it replaces;
// counts and indices use the plain (overflow-checked) operations.
// Numbers wider than 128 bits are little-endian runs of 64-bit words (word 0 is the least significant): a
// CmWide3 value for 3 words, a @U64 buffer for 6 or 7. The CORE-MATH name of each
// helper is in its comment.

module Standard::Core

/// A 192-bit number as three 64-bit words, w0 the least significant.
record CmWide3
    w0 : U64
    w1 : U64
    w2 : U64

// -- 64- and 128-bit words -----------------------------------------------------

/// (int64_t) x >> n: an arithmetic shift of the word read as signed.
routine cm_sar64(x: U64, n: U64) -> U64
    block entry():
        signed : S64 = x.to_wrap<S64>()
        r      : U64 = signed.shr(n.to<S64>()).to_wrap<U64>()
        return(r)

/// (__int128) x >> n.
routine cm_sar128(x: U128, n: U128) -> U128
    block entry():
        signed : S128 = x.to_wrap<S128>()
        r      : U128 = signed.shr(n.to<S128>()).to_wrap<U128>()
        return(r)

/// The sign mask of a word read as signed: all ones when its top bit is set, else 0.
routine cm_sign_mask64(x: U64) -> U64
    block entry():
        r : U64 = 0.sub_wrap(x.shr(63))
        return(r)

routine cm_wide_u128(hi: U64, lo: U64) -> U128
    block entry():
        high : U128 = hi.to<U128>().shl(64)
        r    : U128 = high.bitor(lo.to<U128>())
        return(r)

routine cm_wide_hi(x: U128) -> U64
    block entry():
        r : S64 = x.shr(64).to_wrap<S64>()
        return(r.to_wrap<U64>())

routine cm_wide_lo(x: U128) -> U64
    block entry():
        r : S64 = x.to_wrap<S64>()
        return(r.to_wrap<U64>())

/// muu: the full 128-bit product of two words.
routine cm_wide_mul_64x64(a: U64, b: U64) -> U128
    block entry():
        r : U128 = a.to<U128>().mul_wrap(b.to<U128>())
        return(r)

/// mhuu: the high word of the 64x64-bit product.
routine cm_wide_mulhi_64x64(a: U64, b: U64) -> U64
    block entry():
        p : U128 = cm_wide_mul_64x64(a, b)
        r : U64  = cm_wide_hi(p)
        return(r)

/// mhUU: the approximate high half of the 128x128-bit product (the low x low product is dropped).
routine cm_wide_mulhi_128x128(a: U128, b: U128) -> U128
    block entry():
        a0   : U64  = cm_wide_lo(a)
        a1   : U64  = cm_wide_hi(a)
        b0   : U64  = cm_wide_lo(b)
        b1   : U64  = cm_wide_hi(b)
        a1b1 : U128 = cm_wide_mul_64x64(a1, b1)
        a1b0 : U128 = cm_wide_mul_64x64(a1, b0)
        a0b1 : U128 = cm_wide_mul_64x64(a0, b1)
        r    : U128 = a1b1.add_wrap(a1b0.shr(64)).add_wrap(a0b1.shr(64))
        return(r)

/// mhuU: (a * b) >> 64 for a 64-bit a and a 128-bit b.
routine cm_wide_mulhi_64x128(a: U64, b: U128) -> U128
    block entry():
        ab0 : U128 = cm_wide_mul_64x64(a, cm_wide_lo(b))
        ab1 : U128 = cm_wide_mul_64x64(a, cm_wide_hi(b))
        r   : U128 = ab1.add_wrap(ab0.shr(64))
        return(r)

// -- 3-word numbers ------------------------------------------------------------

/// Row i of a table of 3-word entries.
routine cm_wide_row3(table: @U64, i: USize) -> CmWide3
    block entry():
        base : USize   = i.mul(3)
        w0   : U64     = table.stride(base).load()
        w1   : U64     = table.stride(base.add(1)).load()
        w2   : U64     = table.stride(base.add(2)).load()
        r    : CmWide3 = CmWide3 { w0: w0, w1: w1, w2: w2 }
        return(r)

/// mahu1u3u3: ((a * b) >> 64) + c over 3 words.
routine cm_wide_mulhi_add3(a: U64, b: CmWide3, c: CmWide3) -> CmWide3
    block entry():
        ab0     : U128    = cm_wide_mul_64x64(a, b.w0)
        ab1     : U128    = cm_wide_mul_64x64(a, b.w1)
        ab2     : U128    = cm_wide_mul_64x64(a, b.w2)
        t0      : U128    = ab1.bitand(0xFFFFFFFFFFFFFFFF).add(ab0.shr(64))
        s0      : U128    = c.w0.to<U128>().add(t0.bitand(0xFFFFFFFFFFFFFFFF))
        t1_part : U128    = ab2.bitand(0xFFFFFFFFFFFFFFFF).add(ab1.shr(64))
        t1      : U128    = t1_part.add(t0.shr(64))
        s1_part : U128    = c.w1.to<U128>().add(t1.bitand(0xFFFFFFFFFFFFFFFF))
        s1      : U128    = s1_part.add(s0.shr(64))
        t2      : U128    = ab2.shr(64).add(t1.shr(64))
        w2      : U64     = c.w2.add_wrap(cm_wide_lo(t2)).add_wrap(cm_wide_hi(s1))
        r       : CmWide3 = CmWide3 { w0: cm_wide_lo(s0), w1: cm_wide_lo(s1), w2: w2 }
        return(r)

/// a + b over 3 words.
routine cm_wide_add3(a: CmWide3, b: CmWide3) -> CmWide3
    block entry():
        s0      : U128    = a.w0.to<U128>().add(b.w0.to<U128>())
        s1_part : U128    = a.w1.to<U128>().add(b.w1.to<U128>())
        s1      : U128    = s1_part.add(s0.shr(64))
        w2      : U64     = a.w2.add_wrap(b.w2).add_wrap(cm_wide_hi(s1))
        r       : CmWide3 = CmWide3 { w0: cm_wide_lo(s0), w1: cm_wide_lo(s1), w2: w2 }
        return(r)

/// a - b over 3 words.
routine cm_wide_sub3(a: CmWide3, b: CmWide3) -> CmWide3
    block entry():
        borrow0 : Bool    = a.w0.lt(b.w0)
        w1      : U64     = a.w1.sub_wrap(b.w1).sub_wrap(borrow0.to<U64>())
        ties    : Bool    = a.w1.eq(b.w1).bitand(borrow0)
        borrow1 : Bool    = a.w1.lt(b.w1).bitor(ties)
        w2      : U64     = a.w2.sub_wrap(b.w2).sub_wrap(borrow1.to<U64>())
        r       : CmWide3 = CmWide3 { w0: a.w0.sub_wrap(b.w0), w1: w1, w2: w2 }
        return(r)

// -- word buffers --------------------------------------------------------------

/// Each word of x[0..n) XORed with mask, in place.
routine cm_wide_xor_words(x: @U64, n: USize, mask: U64) -> Void
    block entry():
        jump next(0)

    block next(i: USize):
        done : Bool = i.ge(n)
        branch done
            ? return()
            : continue
        word : U64 = x.stride(i).load()
        word.bitxor(mask).store_into(x.stride(i))
        jump next(i.add(1))

/// (a * b) >> 64 for a 7-word a, truncated to 7 words. out may be a.
routine cm_wide_mul7w(a: @U64, b: U64, out: @U64) -> Void
    block entry():
        a0   : U64 = a.stride(0).load()
        prev : U64 = cm_wide_mulhi_64x64(a0, b)
        jump next(1, prev)

    block next(i: USize, prev: U64):
        done : Bool = i.eq(7)
        branch done
            ? last(prev)
            : word(i, prev)

    block word(i: USize, prev: U64):
        ai : U64  = a.stride(i).load()
        p  : U128 = cm_wide_mul_64x64(ai, b)
        s  : U128 = p.bitand(0xFFFFFFFFFFFFFFFF).add(prev.to<U128>())
        out.stride(i.sub(1)).store(cm_wide_lo(s))
        carried : U64 = cm_wide_hi(p).add_wrap(cm_wide_hi(s))
        jump next(i.add(1), carried)

    block last(prev: U64):
        out.stride(6).store(prev)
        return()

/// mhu7xu2: the words at or above word 2 of the 7x2-word product a * b, as 7 words. out must not be a.
routine cm_wide_mulhi_7x2(a: @U64, b: U128, out: @U64) -> Void
    block entry():
        claim shifted_buf : @Array<U64, 7> <- Array<U64, 7> { 0, 0, 0, 0, 0, 0, 0 }
        shifted : @U64 = shifted_buf.to<@U64>()
        claim low_buf : @Array<U64, 7> <- uninit
        low : @U64 = low_buf.to<@U64>()
        cm_wide_mul7w(a, cm_wide_hi(b), out)
        jump shift(0, shifted, low)

    // shifted = a >> 64, the partner of b's low word
    block shift(i: USize, shifted: @U64, low: @U64):
        done : Bool = i.eq(6)
        branch done
            ? low(shifted, low)
            : shift_word(i, shifted, low)

    block shift_word(i: USize, shifted: @U64, low: @U64):
        w : U64 = a.stride(i.add(1)).load()
        shifted.stride(i).store(w)
        jump shift(i.add(1), shifted, low)

    block low(shifted: @U64, low: @U64):
        cm_wide_mul7w(shifted, cm_wide_lo(b), low)
        jump add(0, 0, low)

    block add(i: USize, carry: U64, low: @U64):
        done : Bool = i.eq(7)
        branch done
            ? return()
            : continue
        o    : U64  = out.stride(i).load()
        t    : U64  = low.stride(i).load()
        pair : U128 = o.to<U128>().add(t.to<U128>())
        s    : U128 = pair.add(carry.to<U128>())
        out.stride(i).store(cm_wide_lo(s))
        jump add(i.add(1), cm_wide_hi(s), low)

/// arsu7: arithmetic right shift of the 7-word x by n bits (n < 192), in place.
routine cm_wide_ashr7(x: @U64, n: U64) -> Void
    block entry():
        rk  : U64   = n.bitand(63)
        lk  : U64   = 64.sub_wrap(rk).bitand(63)
        qk  : USize = n.shr(6).to<USize>()
        top : U64   = x.stride(6).load()
        jump move(0, rk, lk, qk, top.to_wrap<S64>())

    // words move down by qk and shift by rk; the top word is shifted in once the loop ends
    block move(i: USize, rk: U64, lk: U64, qk: USize, top: S64):
        src  : USize = qk.add(i)
        done : Bool  = src.gt(5)
        branch done
            ? fill(rk, qk, top)
            : move_word(i, rk, lk, qk, top)

    block move_word(i: USize, rk: U64, lk: U64, qk: USize, top: S64):
        src      : USize = qk.add(i)
        lower    : U64   = x.stride(src).load()
        upper    : U64   = x.stride(src.add(1)).load()
        combined : U64   = upper.shl(lk).bitor(lower.shr(rk))
        aligned  : Bool  = rk.eq(0)
        x.stride(i).store(aligned ? lower : combined)
        jump move(i.add(1), rk, lk, qk, top)

    block fill(rk: U64, qk: USize, top: S64):
        k : USize = 6.sub(qk)
        x.stride(k).store(top.shr(rk.to<S64>()).to_wrap<U64>())
        jump sign(k.add(1), top.shr(63))

    block sign(k: USize, sign: S64):
        done : Bool = k.ge(7)
        branch done
            ? return()
            : continue
        x.stride(k).store(sign.to_wrap<U64>())
        jump sign(k.add(1), sign)

/// mhu6u6u6: the approximate high 6 words of the 6x6-word product a * b: every partial-product half at or
/// above word 6, summed exactly modulo 2^384. Word w of the result reads only words >= w of a and b, so out
/// may be a or b.
routine cm_wide_mulhi_6x6(b: @U64, a: @U64, out: @U64) -> Void
    block entry():
        jump word(0, 0)

    block word(w: USize, carry: U128):
        done : Bool = w.eq(6)
        branch done
            ? return()
            : term(w, w, carry)

    // the high half of a_i * b_(w+5-i) lands in word w, and so does the low half of a_i * b_(w+6-i)
    block term(w: USize, i: USize, sum: U128):
        done : Bool = i.eq(6)
        branch done
            ? store(w, sum)
            : add_term(w, i, sum)

    block add_term(w: USize, i: USize, sum: U128):
        ai      : U64   = a.stride(i).load()
        j       : USize = w.add(5).sub(i)
        bj      : U64   = b.stride(j).load()
        high    : U128  = cm_wide_mul_64x64(ai, bj).shr(64)
        has_low : Bool  = i.gt(w)
        k       : USize = has_low
            ? j.add(1)
            : j
        bk      : U64  = b.stride(k).load()
        low     : U128 = cm_wide_mul_64x64(ai, bk).bitand(0xFFFFFFFFFFFFFFFF)
        with_hi : U128 = sum.add(high)
        next    : U128 = has_low
            ? with_hi.add(low)
            : with_hi
        jump term(w, i.add(1), next)

    block store(w: USize, sum: U128):
        out.stride(w).store(cm_wide_lo(sum))
        jump word(w.add(1), sum.shr(64))

/// mahu1u6u6: ((a * b) >> 64) + c over 6 words. out may be b or c.
routine cm_wide_mulhi_add6(a: U64, b: @U64, c: @U64, out: @U64) -> Void
    block entry():
        b0   : U64 = b.stride(0).load()
        prev : U64 = cm_wide_mulhi_64x64(a, b0)
        jump next(0, prev, 0)

    block next(i: USize, prev: U64, carry: U64):
        done : Bool = i.eq(6)
        branch done
            ? return()
            : word(i, prev, carry)

    // b's word i + 1 (none past word 5) times a, plus the high word carried from word i
    block word(i: USize, prev: U64, carry: U64):
        has_next : Bool  = i.lt(5)
        j        : USize = i.add(1).min(5)
        bj       : U64   = b.stride(j).load()
        product  : U128  = cm_wide_mul_64x64(a, bj)
        p        : U128  = has_next
            ? product
            : 0
        s       : U128 = p.bitand(0xFFFFFFFFFFFFFFFF).add(prev.to<U128>())
        ci      : U64  = c.stride(i).load()
        s2_part : U128 = ci.to<U128>().add(s.bitand(0xFFFFFFFFFFFFFFFF))
        s2      : U128 = s2_part.add(carry.to<U128>())
        out.stride(i).store(cm_wide_lo(s2))
        next_prev : U64 = cm_wide_hi(p).add_wrap(cm_wide_hi(s))
        jump next(i.add(1), next_prev, cm_wide_hi(s2))

/// addu6u6: a + b over 6 words. out may be a or b.
routine cm_wide_add6(a: @U64, b: @U64, out: @U64) -> Void
    block entry():
        jump next(0, 0)

    block next(i: USize, carry: U64):
        done : Bool = i.eq(6)
        branch done
            ? return()
            : continue
        ai   : U64  = a.stride(i).load()
        bi   : U64  = b.stride(i).load()
        pair : U128 = ai.to<U128>().add(bi.to<U128>())
        s    : U128 = pair.add(carry.to<U128>())
        out.stride(i).store(cm_wide_lo(s))
        jump next(i.add(1), cm_wide_hi(s))

// -- 2^f to about 380 bits -----------------------------------------------------

/// Row i of the 2^r coefficient table, as a pointer to its 6 words.
routine cm_wide_coefficient(i: USize) -> @U64
    block entry():
        table : @U64 = CM_WIDE_EC.to<@U64>()
        row   : @U64 = table.stride(i.mul(6))
        return(row)

/// The 2^r polynomial on the top word x: Horner over every coefficient row.
routine cm_wide_pol6(x: U64, out: @U64) -> Void
    block entry():
        cm_wide_mulhi_add6(x, cm_wide_coefficient(36), cm_wide_coefficient(35), out)
        jump step(34)

    block step(i: USize):
        cm_wide_mulhi_add6(x, out, cm_wide_coefficient(i), out)
        done : Bool = i.eq(0)
        branch done
            ? return()
            : step(i.sub(1))

/// The same polynomial on the second word x, keeping only the terms that still matter: row r enters shifted
/// down by r words.
routine cm_wide_pol6red(x: U64, out: @U64) -> Void
    block entry():
        claim row_buf : @Array<U64, 6> <- Array<U64, 6> { 0, 0, 0, 0, 0, 0 }
        row : @U64 = row_buf.to<@U64>()
        out.zeroinit(6)
        jump step(5, row)

    block step(r: USize, row: @U64):
        done : Bool = r.eq(0)
        branch done
            ? last()
            : load_row(r, 0, row)

    // row[k] = coefficient r's word r + k, for k <= 5 - r (the words above keep the zeros they started with)
    block load_row(r: USize, k: USize, row: @U64):
        full : Bool = r.add(k).eq(6)
        branch full
            ? horner(r, row)
            : load_word(r, k, row)

    block load_word(r: USize, k: USize, row: @U64):
        coefficient : @U64 = cm_wide_coefficient(r)
        w           : U64  = coefficient.stride(r.add(k)).load()
        row.stride(k).store(w)
        jump load_row(r, k.add(1), row)

    block horner(r: USize, row: @U64):
        cm_wide_mulhi_add6(x, out, row, out)
        jump step(r.sub(1), row)

    block last():
        cm_wide_mulhi_add6(x, out, cm_wide_coefficient(0), out)
        return()

/// The polynomial's degree-2 contribution from the low words 0..3 of x.
routine cm_wide_pol6redred(x: @U64, out: @U64) -> Void
    block entry():
        x0 : U64 = x.stride(0).load()
        x1 : U64 = x.stride(1).load()
        x2 : U64 = x.stride(2).load()
        x3 : U64 = x.stride(3).load()
        claim xs_buf : @Array<U64, 6> <- Array<U64, 6> { 0, 0, x0, x1, x2, x3 }
        xs : @U64 = xs_buf.to<@U64>()
        claim f_buf : @Array<U64, 6> <- uninit
        f : @U64 = f_buf.to<@U64>()
        cm_wide_mulhi_6x6(xs, cm_wide_coefficient(2), f)
        cm_wide_shift_down2(f, out)
        out.stride(4).store(0)
        out.stride(5).store(0)
        cm_wide_add6(out, cm_wide_coefficient(1), out)
        cm_wide_mulhi_6x6(xs, out, f)
        cm_wide_shift_down2(f, out)
        c0 : @U64 = cm_wide_coefficient(0)
        c4 : U64  = c0.stride(4).load()
        c5 : U64  = c0.stride(5).load()
        out.stride(4).store(c4)
        out.stride(5).store(c5)
        return()

/// out[0..3] = f[2..5]
routine cm_wide_shift_down2(f: @U64, out: @U64) -> Void
    block entry():
        f2 : U64 = f.stride(2).load()
        f3 : U64 = f.stride(3).load()
        f4 : U64 = f.stride(4).load()
        f5 : U64 = f.stride(5).load()
        out.stride(0).store(f2)
        out.stride(1).store(f3)
        out.stride(2).store(f4)
        out.stride(3).store(f5)
        return()

/// 2^f to about 380 bits, as 6 words, for the fixed-point fraction f in words 0..5 of the 7-word x: bits
/// 60..63 of word 5 pick the 2^(j/16) table row, the rest feed the polynomial. x is left unchanged.
routine cm_wide_exp2_frac(x: @U64, out: @U64) -> Void
    block entry():
        claim f_buf : @Array<U64, 6> <- uninit
        f : @U64 = f_buf.to<@U64>()
        claim f1_buf : @Array<U64, 6> <- uninit
        f1 : @U64 = f1_buf.to<@U64>()
        claim f2_buf : @Array<U64, 6> <- uninit
        f2 : @U64  = f2_buf.to<@U64>()
        x4 : U64   = x.stride(4).load()
        x5 : U64   = x.stride(5).load()
        j  : USize = x5.shr(60).to<USize>()
        cm_wide_pol6(x5.bitand(0x0FFFFFFFFFFFFFFF), f)
        cm_wide_pol6red(x4, f1)
        cm_wide_pol6redred(x, f2)
        cm_wide_mulhi_6x6(f, f1, f)
        cm_wide_mulhi_6x6(f, f2, f)
        etbl : @U64 = CM_WIDE_ETBL.to<@U64>()
        row  : @U64 = etbl.stride(j.mul(6))
        cm_wide_mulhi_6x6(f, row, out)
        return()

// -- tables --------------------------------------------------------------------

/// 1/ln(2) to 448 bits
preset CM_WIDE_ILN2: @Array<U64, 7> <- { 0xEA90B9E60C4A90A0, 0x24D92F75C16BE0B3, 0xDE1C43F755176CD6,
    0x8B25166CD1A13247, 0xEB577AA8DD695A58, 0xBE87FED0691D3E88, 0xB8AA3B295C17F0BB }

/// 2^(j/16), j = 0..15, to 384 bits: one 6-word row per j
preset CM_WIDE_ETBL: @Array<U64, 96> <- { 0x0000000000000000, 0x0000000000000000,
    0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x8000000000000000,
    0x82DC9BF3421840D1, 0x7835AF9AB4E6355C, 0x5D42B362AF1EE859, 0x148A0459E7585151,
    0xC5C95B8C2154C1B2, 0x85AAC367CC487B14, 0x9994FAC7F4EA654B, 0xB4F28C879A524BD4,
    0x91E135EE84A3F733, 0x1AA84FFBEBAC349F, 0xFBE4628758A53C90, 0x8B95C1E3EA8BD6E6,
    0x23B504FB5DADBB25, 0x4E0D990C27C43643, 0xF1203CAF65BFB9B9, 0x1942B34816FB4F26,
    0x0FD6D8E0AE5AC9D8, 0x91C3D373AB11C336, 0x4E9F94EE0C90DBBD, 0xBE47C34D380250A8,
    0xD78B65CBEFA7BB6F, 0x5E139A1B14FA8178, 0x46AD23182E42F6F6, 0x9837F0518DB8A96F,
    0xA264696B6F6E2B1C, 0xCD12E5ADA91EEF7B, 0x21F977FE7C7FA117, 0x65C15C122133E2A2,
