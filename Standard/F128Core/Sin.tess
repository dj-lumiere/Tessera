// Tessera stdlib: correctly rounded F128 sine, and the sine and cosine together
//
// Ported from CORE-MATH, src/binary128/sin/sinq.c via RazorForge's B128Sin.rf.
// Copyright (c) 2026 Chen-Pang He <jdh863@gmail.com>
// MIT license: see LICENSE-CORE-MATH
//
// The result is the exact sine of the argument (in radians) rounded to the nearest F128, ties to even.
// sin(-x) = -sin(x), ±0 maps to itself, ±infinity gives the default quiet NaN, and a NaN comes back quieted
// with its sign and payload. The pipeline shared with the cosine lives in TrigShared.tess.

module Standard::Core

/// sin(x) and cos(x), each correctly rounded.
record F128SinCos
    sin : F128
    cos : F128

/// sin and cos are CORE-MATH ports. NaN and infinities go to
/// f128_trig_nonfinite. tan is in F128Tan.tess.
routine F128.sin(self: Self) -> Self
    block entry()
        finite : Bool = self.is_finite()
        branch finite
            ? compute()
            : special()

    block compute()
        bits : U128 = cm_trig(self.bits(), false)
        r    : Self = f128_of(bits)
        return(r)

    block special()
        r : Self = f128_trig_nonfinite(self)
        return(r)

/// sin and cos together, sharing one argument reduction
routine F128.sin_cos(self: Self) -> F128SinCos
    block entry()
        finite : Bool = self.is_finite()
        branch finite
            ? compute()
            : special()

    block compute()
        r : F128SinCos = cm_trig_both(self.bits())
        return(r)

    block special()
        r : F128SinCos = F128SinCos { sin: self.sin(), cos: self.cos() }
        return(r)
