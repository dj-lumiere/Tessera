/// A decimal U128, with an optional '+' ("-0" reads as 0).
routine U128.parse(text: Bytes) -> Result<Self, ParseIntError>
    block entry()
        parts : Result<IntParts, ParseIntError> = parse_int_parts(text)
        when parts
            .Success(p)     -> sign(p)
            .Failure(error) -> return(.Failure(error))

    block sign(p: IntParts)
        branch p.negative.bitand(p.magnitude.gt(0))
            ? return(.Failure(ParseIntError.OutOfRange))
            : return(in_range<Self>(p.magnitude.to_checked<Self>()))

/// A decimal U256, with an optional '+' ("-0" reads as 0).
routine U256.parse(text: Bytes) -> Result<Self, ParseIntError>
    block entry()
        parts : Result<IntParts, ParseIntError> = parse_int_parts(text)
        when parts
            .Success(p)     -> sign(p)
            .Failure(error) -> return(.Failure(error))

    block sign(p: IntParts)
        branch p.negative.bitand(p.magnitude.gt(0))
            ? return(.Failure(ParseIntError.OutOfRange))
            : return(.Success(p.magnitude))

/// A decimal SSize, with an optional sign: read as an S64, then narrowed.
routine SSize.parse(text: Bytes) -> Result<Self, ParseIntError>
    block entry()
        wide : Result<S64, ParseIntError> = S64.parse(text)
        when wide
            .Success(v)     -> return(in_range<Self>(v.to_checked<Self>()))
            .Failure(error) -> return(.Failure(error))

/// A decimal USize, with an optional '+': read as a U64, then narrowed.
routine USize.parse(text: Bytes) -> Result<Self, ParseIntError>
    block entry()
        wide : Result<U64, ParseIntError> = U64.parse(text)
        when wide
            .Success(v)     -> return(in_range<Self>(v.to_checked<Self>()))
            .Failure(error) -> return(.Failure(error))
