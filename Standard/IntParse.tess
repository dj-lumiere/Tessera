// Tessera stdlib: reading integers from text
//
// T.parse(text) reads a decimal integer for every built-in integer type: an optional '+' or '-', then one or more
// digits, and nothing else (no spaces, no '_', no "0x"). The digits are gathered into a U256, so any text that
// fits a U256 is read before the range is checked, and a type's most negative value reads too ("-128" as S8).
//
//     n : Result<S32, ParseIntError> = S32.parse("-42")    // .Success(-42)
//     S8.parse("200")                                      // .Failure(.OutOfRange)
//     U32.parse("-1")                                      // .Failure(.OutOfRange)
//     U32.parse("")                                        // .Failure(.Empty)
//     U32.parse("12a")                                     // .Failure(.Invalid)

module Standard::Format

/// Why parsing integer text failed: `Empty` when there are no digits, `Invalid` for a character that is not a digit after the sign, and `OutOfRange` when the value does not fit the type.
choice ParseIntError: U8
    Empty  // no digits
    Invalid  // something other than a digit, after the sign
    OutOfRange  // a value the type can't hold

/// The sign and the digits' value.
private record IntParts
    negative  : Bool
    magnitude : U256

/// Reads an optional `+` or `-` and then one or more decimal digits into a sign and a U256 magnitude.
/// :param text: The text to read.
/// :returns: `Success` with the sign and magnitude, or `Failure` with the reason.
/// :throws: Fails with `Empty` for no digits, `Invalid` for any other character, and `OutOfRange` when the digits overflow a U256.
private routine parse_int_parts(text: Bytes) -> Result<IntParts, ParseIntError>
    block entry()
        branch text.is_empty()
            ? return(.Failure(ParseIntError.Empty))
            : continue
        first : U8 = text.byte_at(0)
        // '-' and '+'
        when
            first.eq(45) -> digits(true, 1)
            first.eq(43) -> digits(false, 1)
            else         -> digits(false, 0)

    block digits(negative: Bool, start: USize)
        branch start.eq(text.length())
            ? return(.Failure(ParseIntError.Empty))
            : next(negative, start, 0)

    block next(negative: Bool, i: USize, value: U256)
        branch i.eq(text.length())
            ? return(.Success(IntParts { negative: negative, magnitude: value }))
            : continue
        c : U8 = text.byte_at(i)
        branch c.between(48, 57)
            ? continue
            : return(.Failure(ParseIntError.Invalid))
        times : Option<U256> = value.mul_checked(10)
        when times
            .Present(t) -> add(negative, i, t, c.sub(48).to<U256>())
            .Absent     -> return(.Failure(ParseIntError.OutOfRange))

    block add(negative: Bool, i: USize, t: U256, digit: U256)
        sum : Option<U256> = t.add_checked(digit)
        when sum
            .Present(s) -> next(negative, i.add(1), s)
            .Absent     -> return(.Failure(ParseIntError.OutOfRange))

/// value, or OutOfRange when it is Absent.
private routine in_range<T>(value: Option<T>) -> Result<T, ParseIntError>
require T: typename
    block entry()
        when value
            .Present(v) -> return(.Success(v))
            .Absent     -> return(.Failure(ParseIntError.OutOfRange))

/// A decimal S8, with an optional sign.
routine S8.parse(text: Bytes) -> Result<Self, ParseIntError>
    block entry()
        parts : Result<IntParts, ParseIntError> = parse_int_parts(text)
        when parts
            .Success(p)     -> sign(p)
            .Failure(error) -> return(.Failure(error))

    block sign(p: IntParts)
        branch p.negative.bitand(p.magnitude.gt(0))
            ? negative(p.magnitude)
            : return(in_range<Self>(p.magnitude.to_checked<Self>()))

    // -(m - 1) - 1: the most negative value's magnitude is one past the most positive value.
    block negative(m: U256)
        less : Option<Self> = m.sub(1).to_checked<Self>()
        when less
            .Present(v) -> return(.Success(v.neg().sub(1)))
            .Absent     -> return(.Failure(ParseIntError.OutOfRange))

