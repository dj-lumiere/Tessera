/// A decimal U8, with an optional '+' ("-0" reads as 0).
routine U8.parse(text: Bytes) -> Result<Self, ParseIntError>
    block entry()
        parts : Result<IntParts, ParseIntError> = parse_int_parts(text)
        when parts
            .Success(p)     -> sign(p)
            .Failure(error) -> return(.Failure(error))

    block sign(p: IntParts)
        branch p.negative.bitand(p.magnitude.gt(0))
            ? return(.Failure(ParseIntError.OutOfRange))
            : return(in_range<Self>(p.magnitude.to_checked<Self>()))

