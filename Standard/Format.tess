// Tessera stdlib: formatting
//
// Formatting writes text into a Writer: any type with a write_bytes method.
// Nothing allocates unless the Writer does, nothing parses a format string, and
// every value is written by one visible call. The writers for standard output
// and error need an operating system, so they're in Standard/Os
// (Os/Stdio.tess):
//
//     out : @Out = Out.writer()
//     write_str(out, "x = ")
//     x.represent_into(out)
//     write_line(out)
//
// A type is representable when it conforms to Representable. Integers have two forms:
// represent (decimal, signed for S types and unsigned for U types) and represent_hex_into
// (lowercase hex of the bits).

module Standard/Format

import Standard/Alloc
import Standard/Collections

/// A sink for bytes: any type with a `write_bytes` method. Formatting routines write into a Writer, so nothing allocates unless the Writer does.
/// :typeparam T: The type that accepts bytes.
protocol Writer[T]
needs T: typename
    /// Writes `count` bytes starting at `data`.
    /// :param data: The first byte to write.
    /// :param count: The number of bytes to write.
    routine Me.write_bytes(me: @Me, data: @Byte, count: USize) -> Void

/// A type that can write its program-output text into a Writer with `represent_into`. Integers write decimal (`represent_hex_into` gives hex), Span[Byte] writes itself unquoted, and Bool writes `true` or `false`.
/// :typeparam T: The type that can write its program-output text.
protocol Representable[T]
needs T: typename
    /// Writes the value's program-output text to `out`.
    /// :typeparam TWriter: The type of the Writer that receives the text.
    /// :param out: The Writer the text is written to.
    routine Me.represent_into[TWriter](me: Me, out: @TWriter) -> Void

/// A type that can write its value in lowercase hex into a Writer with `represent_hex_into`: every integer type, which writes its bits, so a negative value shows its two's complement at the type's width. `Hex[T]` is the view that writes a value this way.
/// :typeparam T: The type that can write its hex text.
protocol HexRepresentable[T]
needs T: typename
    /// Writes the value's bits in lowercase hex with no leading zeros to `out`.
    /// :typeparam TWriter: The type of the Writer that receives the text.
    /// :param out: The Writer the text is written to.
    routine Me.represent_hex_into[TWriter](me: Me, out: @TWriter) -> Void

/// A type that can write its value with a fixed number of digits after the point with `represent_fixed_into`: every float type. `Fixed[T]` is the view that writes a value this way.
/// :typeparam T: The type that can write its fixed-point text.
protocol FixedRepresentable[T]
needs T: typename
    /// Writes the value with exactly `digits` digits after the point to `out`.
    /// :typeparam TWriter: The type of the Writer that receives the text.
    /// :param out: The Writer the text is written to.
    /// :param digits: The number of digits after the point.
    routine Me.represent_fixed_into[TWriter](me: Me, out: @TWriter, digits: USize) -> Void

/// The built-in types' represent routines are further down.
obeys Representable[S8], Representable[S16], Representable[S32], Representable[S64], Representable[S128], Representable[S256]
obeys Representable[U8], Representable[U16], Representable[U32], Representable[U64], Representable[U128], Representable[U256]
obeys Representable[USize], Representable[SSize]
obeys Representable[B16], Representable[BF16], Representable[B32], Representable[B64], Representable[B128]
obeys Representable[Bool], Representable[Char], Representable[Span[Byte]], Representable[Addr], Representable[Unit]
obeys Representable[Array[T, COUNT]] when T: typename, COUNT: USize, Diagnosable[T]

obeys HexRepresentable[S8], HexRepresentable[S16], HexRepresentable[S32], HexRepresentable[S64], HexRepresentable[S128], HexRepresentable[S256]
obeys HexRepresentable[U8], HexRepresentable[U16], HexRepresentable[U32], HexRepresentable[U64], HexRepresentable[U128], HexRepresentable[U256]
obeys HexRepresentable[USize], HexRepresentable[SSize]
obeys FixedRepresentable[B16], FixedRepresentable[BF16], FixedRepresentable[B32], FixedRepresentable[B64], FixedRepresentable[B128]

// -- SliceWriter ---------------------------------------------------------------

/// Writes into a caller's buffer, for formatting into memory without a heap. What
/// doesn't fit is dropped and sets `overflowed`.
record SliceWriter
obeys Writer[SliceWriter]
    data: @Byte
    capacity: USize
    count: USize
    overflowed: Bool

/// Releases nothing: a `SliceWriter` holds no memory of its own.
routine SliceWriter.destruct(me: @Me) -> Void
    return

/// Creates a writer over `capacity` bytes starting at `data`. The buffer stays owned by the caller and must outlive the writer.
/// :param data: The start of the caller's buffer.
/// :param capacity: The size of the buffer in bytes.
/// :returns: A writer that appends into the buffer, with nothing written yet.
routine SliceWriter.construct(data: @Byte, capacity: USize) -> Me
    w: Me = Me(data: data, capacity: capacity, count: 0, overflowed: false)
    return w

/// The text written so far, a view into the buffer.
/// :returns: The bytes written so far, a view into the buffer.
routine SliceWriter.getview(me: Me) -> Span[Byte]
    return Span[Byte].construct(data: me.data, count: me.count)

/// The text written so far, a view into the buffer.
/// :returns: The bytes written so far, a view into the buffer.
routine SliceWriter.getview(me: @Me) -> Span[Byte]
    return me.peek().getview()

/// True once some write did not fit in the buffer, meaning the text was cut off.
/// :returns: True when at least one write was cut short.
routine SliceWriter.has_overflowed(me: Me) -> Bool
    return me.overflowed

/// True once some write did not fit in the buffer, meaning the text was cut off.
/// :returns: True when at least one write was cut short.
routine SliceWriter.has_overflowed(me: @Me) -> Bool
    return me.overflowed.peek()

/// Appends as many of the `count` bytes as fit in the remaining room and drops the rest.
/// :param data: The bytes to append.
/// :param count: The number of bytes to append.
/// :note: Sets the overflow flag when anything was dropped, see {SliceWriter.has_overflowed}.
routine SliceWriter.write_bytes(me: @Me, data: @Byte, count: USize) -> Void
    used: USize = me.count.peek()
    capacity: USize = me.capacity.peek()
    room: USize = capacity - used
    fits: Bool = count <= room
    taken: USize = count.min(room)
    buffer: @Byte = me.data.peek()
    to: @Byte = buffer.stride(used)
    to.copy(src: data, count: taken)
    me.count.poke(used + taken)
    if fits
        return
    me.overflowed.poke(true)
    return

// -- BufWriter -----------------------------------------------------------------

/// Collects writes in a 4 KiB buffer and passes them on to another Writer in
/// large pieces. Nothing reaches the inner Writer until the buffer fills or
/// flush() is called, and nothing flushes by itself: call flush() before the
/// program ends or reads input. Writes of 4 KiB or more skip the buffer.
record BufWriter[T]
needs T: typename
obeys Writer[BufWriter[T]] when T: typename, Writer[T]
    private inner: @T
    private count: USize
    private data: Array[Byte, 4096]

/// Releases nothing: a `BufWriter` holds no memory of its own.
routine BufWriter[T].destruct(me: @Me) -> Void
needs T: typename
    return

/// Sets up the buffer to pass its writes on to `inner`, with nothing buffered yet. `inner` must outlive the writer.
/// :typeparam T: The inner Writer type.
/// :param inner: The Writer that receives the buffered bytes.
routine BufWriter[T].construct(me: @Me, inner: @T) -> Void
needs T: typename
    me.inner.poke(inner)
    me.count.poke(0)
    return

/// Writes out the buffered bytes.
routine BufWriter[T].flush(me: @Me) -> Void
needs T: typename, Writer[T]
    local count: USize = me.count.peek()
    local inner: @T = me.inner.peek()
    local buffer: @Array[Byte, 4096] = me.data
    local data: @Byte = buffer.to[@Byte]()

    me.count.poke(0)
    if count == 0
        return
    else
        inner.write_bytes(data, count)
        return

/// Appends to the buffer, flushing it first when the bytes would not fit. A write of 4 KiB or more goes straight to the inner Writer after that flush.
/// :typeparam T: The inner Writer type.
/// :param data: The bytes to append.
/// :param count: The number of bytes to append.
routine BufWriter[T].write_bytes(me: @Me, data: @Byte, count: USize) -> Void
needs T: typename, Writer[T]
    buffered: USize = me.count.peek()
    fits: Bool = buffered + count <= 4096
    buffered2: USize = when
        fits => buffered
        else =>
            me.flush()
            if count >= 4096
                inner: @T = me.inner.peek()
                inner.write_bytes(data, count)
                return
            else
                becomes 0
    buffer: @Array[Byte, 4096] = me.data
    start: @Byte = buffer.to[@Byte]()
    to: @Byte = start.stride(buffered2)
    to.copy(src: data, count)
    me.count.poke(buffered2 + count)
    return

// -- CountWriter ---------------------------------------------------------------

/// Writes nothing and counts characters (UTF-8 code points: every byte that
/// isn't a continuation byte), to measure text before laying it out.
record CountWriter
obeys Writer[CountWriter]
    count: USize

/// Creates a counting writer with a count of zero.
/// :returns: A counting writer with a count of zero.
routine CountWriter.construct() -> Me
    w: Me = Me(count: 0)
    return w

/// Adds the number of UTF-8 code points in the bytes (every byte that is not a `10xxxxxx` continuation byte) to `count`, without storing the bytes.
/// :param data: The bytes to count.
/// :param count: The number of bytes.
routine CountWriter.write_bytes(me: @Me, data: @Byte, count: USize) -> Void
    local total: @USize <- .hollow()

    initial: USize = me.count.peek()
    initial.poke_into(total)

    each i in 0 til count
        // continuation bytes are 10xxxxxx
        byte: U8 = Byte.to[U8](data.stride(i).peek())
        starts: Bool = byte & 0xC0 != 0x80
        (total.peek() + starts.to[USize]()).poke_into(total)
    me.count.poke(total.peek())
    return

// -- text ----------------------------------------------------------------------

/// Writes the bytes of `text` to `out` as they are.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param text: The bytes to write.
routine write_str[T](out: @T, text: Span[Byte]) -> Void
needs T: typename, Writer[T]
    data: @Byte = text.data
    count: USize = text.count
    out.write_bytes(data, count)
    return

/// Writes a single `\n` to `out`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine write_line[T](out: @T) -> Void
needs T: typename, Writer[T]
    write_str(out, text: "\n")
    return

// -- Representable -----------------------------------------------------------------
//
// Decimal follows the type (S types signed, U types unsigned), hex writes the
// bits, so a negative S value shows its two's complement. The narrower types
// widen to the 64-bit ones, and the U64, U128, and U256 writers also take a
// minimum digit count (zero-padded), which the 19-digit chunks of the wider
// ones use.

/// 10^19, the largest power of ten that fits in a U64, used as the chunk size when writing wide decimals.
preset TEN_POW_19: U128 = 10000000000000000000

/// 2^64, the first value that no longer fits in a U64.
preset TWO_POW_64: U128 = U64.MAX.to[U128]().add(1)
/// `TEN_POW_19` as a U256, the chunk divisor for U256 decimals.
preset TEN_POW_19_WIDE: U256 = TEN_POW_19.to[U256]()

/// Writes the S8 in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S8.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[S64]().represent_into(out)
    return

/// Writes the bits of the S8 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S8.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    bits: U8 = me.bits().to[U8]()
    bits.represent_hex_into(out)
    return

/// Writes the S16 in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S16.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[S64]().represent_into(out)
    return

/// Writes the bits of the S16 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S16.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to_wrap[U16]().represent_hex_into(out)
    return

/// Writes the S32 in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S32.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[S64]().represent_into(out)
    return

/// Writes the bits of the S32 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S32.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to_wrap[U32]().represent_hex_into(out)
    return

/// Writes the S64 in decimal, with a leading `-` when negative: the sign, then the magnitude, which always fits in a U64.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S64.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    if me < 0
        write_str(out, text: "-")
    me.abs_diff(0).represent_into(out)
    return

/// Writes the bits of the S64 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S64.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to_wrap[U64]().represent_hex_into(out)
    return

/// Writes the S128 in decimal, with a leading `-` when negative: the sign, then the magnitude.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S128.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    if me < 0
        write_str(out, text: "-")
    me.abs_diff(0).represent_into(out)
    return

/// Writes the bits of the S128 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S128.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to_wrap[U128]().represent_hex_into(out)
    return

/// Writes the S256 in decimal, with a leading `-` when negative: the sign, then the magnitude.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S256.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    if me < 0
        write_str(out, text: "-")
    me.abs_diff(0).represent_into(out)
    return

/// Writes the bits of the S256 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S256.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to_wrap[U256]().represent_hex_into(out)
    return

/// Writes the U8 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U8.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_into(out)
    return

/// Writes the U8 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U8.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_hex_into(out)
    return

/// Writes the U16 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U16.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_into(out)
    return

/// Writes the U16 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U16.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_hex_into(out)
    return

/// Writes the U32 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U32.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_into(out)
    return

/// Writes the U32 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U32.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_hex_into(out)
    return

/// Writes the U64 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U64.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.represent_into(out, min_digits: 0)
    return

/// Writes the U64 in decimal, zero-padded to at least `min_digits` digits (at most 20).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U64.represent_into[T](me: Me, out: @T, min_digits: USize) -> Void
needs T: typename, Writer[T]
    local buf: @Array[Byte, 20] <- .hollow()
    local digits: @Byte = buf.to[@Byte]()

    // Fills digits from the right: at least one digit, then until the value is
    // used up and min_digits are written.
    while true with end: USize = 20, rest: Me = me
        at2: USize = end - 1
        low_digit2: U8 = (rest % 10).to[U8]()
        ascii2: U8 = low_digit2 + 48
        // '0' = 48
        digits.stride(at2).poke(ascii2.bits())
        next2: Me = rest / 10
        written2: USize = 20 - at2
        more_value2: Bool = next2 != 0
        more_width2: Bool = written2 < min_digits
        if more_value2 | more_width2
            continue with end: at2, rest: next2
        else
            first: @Byte = digits.stride(at2)
            out.write_bytes(data: first, count: 20 - at2)
            return

/// Writes the U64 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U64.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.represent_hex_into(out, min_digits: 0)
    return

/// Writes the U64 in lowercase hex, zero-padded to at least `min_digits` digits (at most 16).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U64.represent_hex_into[T](me: Me, out: @T, min_digits: USize) -> Void
needs T: typename, Writer[T]
    local buf: @Array[Byte, 16] <- .hollow()
    local digits: @Byte = buf.to[@Byte]()

    while true with end: USize = 16, rest: Me = me
        at2: USize = end - 1
        nibble2: U8 = (rest & 15).to[U8]()
        decimal2: Bool = nibble2 < 10
        base2: U8 = when
            decimal2 => 48
            else => 87
        // '0', or 'a' - 10
        digits.stride(at2).poke((base2 + nibble2).bits())
        next2: Me = rest >> 4
        written2: USize = 16 - at2
        more_value2: Bool = next2 != 0
        more_width2: Bool = written2 < min_digits
        if more_value2 | more_width2
            continue with end: at2, rest: next2
        else
            first: @Byte = digits.stride(at2)
            out.write_bytes(data: first, count: 16 - at2)
            return

/// Writes the U128 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U128.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.represent_into(out, min_digits: 0)
    return

/// Writes the U128 in decimal, zero-padded to at least `min_digits` digits. It goes out in 19-digit chunks, so only
/// the chunking divides U128.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U128.represent_into[T](me: Me, out: @T, min_digits: USize) -> Void
needs T: typename, Writer[T]
    if me < TWO_POW_64
        me.to[U64]().represent_into(out, min_digits)
        return
    else
        high: Me = me / TEN_POW_19
        low: Me = me % TEN_POW_19
        high_min: USize = min_digits -^ 19
        high.represent_into(out, min_digits: high_min)
        low.to[U64]().represent_into(out, min_digits: 19)
        return

/// Writes the U128 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U128.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    local high: U64 = (me >> 64).to[U64]()
    local low: U64 = me.to_wrap[U64]()

    if high != 0
        high.represent_hex_into(out)
        low.represent_hex_into(out, min_digits: 16)
        return
    else
        low.represent_hex_into(out)
        return

/// Writes the U256 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U256.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.represent_into(out, min_digits: 0)
    return

/// Writes the U256 in decimal, zero-padded to at least `min_digits` digits. It goes out in 19-digit chunks too, until
/// the rest fits in 128 bits.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U256.represent_into[T](me: Me, out: @T, min_digits: USize) -> Void
needs T: typename, Writer[T]
    if me >> 128 == 0
        me.to[U128]().represent_into(out, min_digits)
        return
    else
        high: Me = me / TEN_POW_19_WIDE
        low: Me = me % TEN_POW_19_WIDE
        high_min: USize = min_digits -^ 19
        high.represent_into(out, min_digits: high_min)
        low.to[U64]().represent_into(out, min_digits: 19)
        return

/// Writes the U256 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U256.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    local high: U128 = (me >> 128).to[U128]()
    local low: U128 = me.to_wrap[U128]()

    if high != 0
        middle: U64 = (low >> 64).to[U64]()
        high.represent_hex_into(out)
        middle.represent_hex_into(out, min_digits: 16)
        low.to_wrap[U64]().represent_hex_into(out, min_digits: 16)
        return
    else
        low.represent_hex_into(out)
        return

/// Writes the USize in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine USize.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_into(out)
    return

/// Writes the USize in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine USize.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[U64]().represent_hex_into(out)
    return

/// Writes the SSize in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine SSize.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to[S64]().represent_into(out)
    return

/// The bits at the target's width, like the fixed-width types.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine SSize.represent_hex_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    me.to_wrap[USize]().represent_hex_into(out)
    return

/// The character's UTF-8 bytes.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Char.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    local buf: @Array[Byte, 4] <- .hollow()
    bytes: @Byte = buf.to[@Byte]()
    count: USize = utf8_encode_into(char: me, out: bytes)
    out.write_bytes(data: bytes, count)
    return

/// Writes the unit value as `Unit`: an absent `Maybe` prints this way.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Unit.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    write_str(out, text: "Unit")
    return

/// Writes `true` or `false`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Bool.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    if me
        write_str(out, text: "true")
        return
    else
        write_str(out, text: "false")
        return

/// Writes the bytes as they are, without quotes or escapes.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Span[Byte].represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    write_str(out, text: me)
    return

// -- addresses -----------------------------------------------------------------
//
// A pointer isn't Representable: `{p}` would hide whether the value or the
// address was meant. `{p.peek()}` writes the value, `{p.to[Addr]()}` the
// address, as lowercase hex after 0x without leading zeros, like Rust's {:p}.
// Null is 0x0.

/// Writes the address as `0x` and lowercase hex without leading zeros. Null is `0x0`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Addr.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    address: U64 = ptrtoint[Me, U64](me)
    write_str(out, text: "0x")
    address.represent_hex_into(out, min_digits: 1)
    return

// -- arrays --------------------------------------------------------------------

/// The elements, each diagnosed (so strings keep their quotes), as [1, 2, 3].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Array[T, COUNT].represent_into[TWriter](me: Me, out: @TWriter) -> Void
needs T: typename, COUNT: USize, Diagnosable[T], TWriter: typename, Writer[TWriter]
    local slot: @Me <- me

    write_str(out, text: "[")

    each at in 0 til COUNT
        if not (at == 0)
            write_str(out, text: ", ")
        value: T = slot[at]
        value.diagnose_into(out)
    write_str(out, text: "]")
    return

// -- floats --------------------------------------------------------------------
//
// Floats print the shortest decimal that reads back to the same value (Ryu,
// Standard/Ryu.tess), laid out like Python's repr: positional when the decimal
// exponent is in -4 .. 15 (0.0001, 1.0, 123.5), scientific otherwise (1e+16,
// 5e-324). Specials are inf, -inf, NaN, and -0.0. Digits are built as ASCII
// codes in U8 buffers and written out as bytes.

/// Writes count zeros.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param count: The number of zeros.
routine write_zeros[T](out: @T, count: USize) -> Void
needs T: typename, Writer[T]
    while left != 0 with left: USize = count
        write_str(out, text: "0")
        continue with left: left - 1
    then
        return

/// Writes count ASCII digits starting at first.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param first: The first digit, as an ASCII code.
/// :param count: The number of digits.
routine write_digits[T](out: @T, first: @U8, count: USize) -> Void
needs T: typename, Writer[T]
    bytes: @Byte = first.to[@Byte]()
    out.write_bytes(data: bytes, count)
    return

/// Writes digits × 10^exponent (digits > 0, at most 19 digits).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param d: The digits and the decimal exponent.
routine write_float_decimal[T](out: @T, d: FloatDecimal) -> Void
needs T: typename, Writer[T]
    local buf: @Array[U8, 20] <- .hollow()
    local digits: @U8 = buf.to[@U8]()
    local end: @USize <- 20

    while true with rest: U64 = d.digits
        at2: USize = end.peek() - 1
        low_digit2: U8 = (rest % 10).to[U8]()
        digits.stride(at2).poke(low_digit2 + 48)
        next2: U64 = rest / 10
        if not (next2 != 0)
            first: @U8 = digits.stride(at2)
            write_decimal_digits(out, first, n: 20 - at2, exponent: d.exponent)
            return
        else
            at2.poke_into(end)
            continue with rest: next2

/// Writes the n ASCII digits at first times 10^exponent (no leading zero). The
/// point goes after the first digit at scientific exponent x = n - 1 + exponent.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param first: The first digit, as an ASCII code.
/// :param n: The number of digits.
/// :param exponent: The power of ten the digits are scaled by.
routine write_decimal_digits[T](out: @T, first: @U8, n: USize, exponent: S64) -> Void
needs T: typename, Writer[T]
    local top_place: S64 = n.to[S64]() - 1
    local x: S64 = top_place + exponent

    low_ok: Bool = x >= -4
    high_ok: Bool = x < 16
    if low_ok and high_ok
        whole: Bool = exponent >= 0
        when
            whole =>
                // 1234 × 10^2 → 123400.0
                write_digits(out, first, count: n)
                write_zeros(out, count: exponent.to[USize]())
                write_str(out, text: ".0")
                return
            x < 0 =>
                // 1234 × 10^-6 → 0.001234
                write_str(out, text: "0.")
                x_magnitude: USize = x.abs_diff(0).to[USize]()
                write_zeros(out, count: x_magnitude - 1)
                write_digits(out, first, count: n)
                return
            else =>
                // 1234 × 10^-2 → 12.34
                tail: USize = exponent.abs_diff(0).to[USize]()
                head: USize = n - tail
                write_digits(out, first, count: head)
                write_str(out, text: ".")
                rest: @U8 = first.stride(head)
                write_digits(out, first: rest, count: tail)
                return
    else
        // 1234 × 10^20 → 1.234e+23
        write_digits(out, first, count: 1)
        if n > 1
            write_str(out, text: ".")
            rest: @U8 = first.stride(1)
            write_digits(out, first: rest, count: n - 1)
        // e+XX / e-XX, at least two digits
        if x < 0
            write_str(out, text: "e-")
            x.abs_diff(0).represent_into(out, min_digits: 2)
            return
        else
            write_str(out, text: "e+")
            x.abs_diff(0).represent_into(out, min_digits: 2)
            return

/// Writes a binary float of at most 64 bits, given its bits and its format, as its shortest round-trip decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format (B16, BF16, B32, or B64).
routine write_binary_float[T](out: @T, bits: U64, format: FloatFormat) -> Void
needs T: typename, Writer[T]
    local mantissa_bits: S64 = format.fraction_bits.to[S64]()
    local bias: S64 = format.bias.to[S64]()
    local exponent_max: U64 = format.exponent_max.to[U64]()
    local fraction_mask: U64 = U64.shl(1, mantissa_bits.to[U64]()) - 1
    local mantissa: U64 = bits & fraction_mask
    local exponent: U64 = (bits >> mantissa_bits.to[U64]()) & exponent_max
    local sign_at: U64 = (format.width - 1).to[U64]()
    local negative: Bool = bits >> sign_at == 1

    if exponent == exponent_max
        if mantissa != 0
            write_str(out, text: "NaN")
            return
        else if negative
            write_str(out, text: "-inf")
            return
        else
            write_str(out, text: "inf")
            return
    else
        if negative
            write_str(out, text: "-")
        if mantissa | exponent == 0
            write_str(out, text: "0.0")
            return
        else if mantissa_bits == 52
            d: FloatDecimal = ryu_double_decimal(mantissa, exponent: exponent.to[S64]())
            write_float_decimal(out, d)
            return
        else
            d: FloatDecimal = ryu_float_decimal(mantissa: mantissa.to[S64](), exponent: exponent.to[S64](), mantissa_bits, bias)
            write_float_decimal(out, d)
            return

/// Writes the B64 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine B64.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    bits: U64 = me.bits()
    write_binary_float(out, bits, format: Me.FORMAT.peek())
    return

/// Writes the B32 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine B32.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    bits: U64 = me.bits().to[U64]()
    write_binary_float(out, bits, format: Me.FORMAT.peek())
    return

/// Writes the B16 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine B16.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    bits: U64 = me.bits().to[U64]()
    write_binary_float(out, bits, format: Me.FORMAT.peek())
    return

/// Writes the BF16 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine BF16.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    bits: U64 = me.bits().to[U64]()
    write_binary_float(out, bits, format: Me.FORMAT.peek())
    return

// -- B128 ----------------------------------------------------------------------
//
// B128 needs up to 36 digits, past Ryu's 64-bit tables, so its shortest digits
// come from Burger and Dybvig's exact method ("Printing Floating-Point Numbers
// Quickly and Accurately", 1996) on BigNats. With v = f × 2^e, the value,
// half the gap to the next float, and half the gap to the previous one are
// r / s, m+ / s, and m- / s. Digits come out one at a time until the number so
// far is inside the rounding interval. The last digit is the nearer choice.

/// floor(x × log10(2)), for |x| up to about 10^6.
/// :param x: The power of two.
/// :returns: Floor(`x` × log10(2)).
routine floor_log10_pow2(x: S64) -> S64
    r: S64 = x * 646456993 >> 31
    return r

/// Writes f × 2^e (f > 0) as its shortest round-trip decimal. boundary says the
/// gap below is half the gap above (f is a power of two above the smallest
/// normal). A tie reads back as this float when f is even.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param f: The significand, above 0.
/// :param e: The binary exponent.
/// :param boundary: True when the gap below is half the gap above.
routine write_float_exact[T](out: @T, f: U128, e: S64, boundary: Bool) -> Void
needs T: typename, Writer[T]
    local even: Bool = f & 1 == 0
    local r: @BigNat[320] <- .hollow()
    local s: @BigNat[320] <- .hollow()
    local plus: @BigNat[320] <- .hollow()
    local minus: @BigNat[320] <- .hollow()
    local t: @BigNat[320] <- .hollow()

    one: U64 = 1
    r.set(f)
    s.set(one)
    plus.set(one)
    minus.set(one)
    // r = 2f (4f at a boundary), s = 2 (4), m+ = 1 (2), m- = 1. Then 2^e
    // goes on r, m+, m- when e >= 0 and on s when e < 0.
    doubling: USize = when
        boundary => 2
        else => 1
    r.shl(doubling)
    s.shl(doubling)
    plus.shl(doubling - 1)
    if e >= 0
        jump scale_up()
    else
        jump scale_down()

    block scale_up()
        up: USize = e.to[USize]()
        r.shl(up)
        plus.shl(up)
        minus.shl(up)
        jump estimate()

    block scale_down()
        s.shl(e.abs_diff(0).to[USize]())
        jump estimate()

    // k = floor((bits(f) - 1 + e) × log10 2) + 1 is at most ceil(log10 v)//
    // divide by 10^k (multiply s, or r and the margins).
    block estimate()
        bits: S64 = 128 - f.leading_zeros().to[S64]()
        k: S64 = floor_log10_pow2(bits - 1 + e) + 1
        if k >= 0
            jump divide_s(k)
        else
            jump multiply_r(k)

    block divide_s(k: S64)
        s.mul_pow10(k.to[USize]())
        jump fixup(k)

    block multiply_r(k: S64)
        up: USize = k.abs_diff(0).to[USize]()
        r.mul_pow10(up)
        plus.mul_pow10(up)
        minus.mul_pow10(up)
        jump fixup(k)

    // Raise k while the top of the interval reaches 10^k, so every number in it
    // is below 10^k and the first digit is its leading one.
    block fixup(k: S64)
        t.copy_from(r)
        t.add(plus)
        cmp: S32 = t.compare(s)
        high: Bool = when
            even => cmp >= 0
            else => cmp > 0
        if high
            jump raise(k)
        else
            jump start(k)

    block raise(k: S64)
        s.mul_add(m: 10, addend: 0)
        jump fixup(k + 1)

    block start(k: S64)
        local buf: @Array[U8, 48] <- .hollow()
        jump next_digit(0, k, buf.to[@U8]())

    // d = floor(10r / s), r = 10r mod s, and the margins scale by 10 too.
    block next_digit(n: USize, k: S64, digits: @U8)
        r.mul_add(m: 10, addend: 0)
        plus.mul_add(m: 10, addend: 0)
        minus.mul_add(m: 10, addend: 0)
        jump take(0, n, k, digits)

    block take(d: U8, n: USize, k: S64, digits: @U8)
        if r.compare(s) >= 0
            jump take_one(d, n, k, digits)
        else
            jump judge(d, n, k, digits)

    block take_one(d: U8, n: USize, k: S64, digits: @U8)
        r.sub(s)
        jump take(d + 1, n, k, digits)

    // low: the digits so far are already within m- of the value. High: rounding
    // this digit up is within m+. Either one ends the output.
    block judge(d: U8, n: USize, k: S64, digits: @U8)
        low_cmp: S32 = r.compare(minus)
        low: Bool = when
            even => low_cmp <= 0
            else => low_cmp < 0
        t.copy_from(r)
        t.add(plus)
        high_cmp: S32 = t.compare(s)
        high: Bool = when
            even => high_cmp >= 0
            else => high_cmp > 0
        if low or high
            jump last(d, n, k, low, high, digits)
        else
            jump emit(d, n, k, digits)

    block emit(d: U8, n: USize, k: S64, digits: @U8)
        digits.stride(n).poke(d + 48)
        jump next_digit(n + 1, k, digits)

    // Both ends reachable: the nearer one, and the even digit on an exact tie.
    block last(d: U8, n: USize, k: S64, low: Bool, high: Bool, digits: @U8)
        t.copy_from(r)
        t.shl(1)
        half: S32 = t.compare(s)
        d_odd: Bool = d & 1 == 1
        nearer: Bool = half > 0 or (half == 0 and d_odd)
        both: Bool = low and high
        round_up: Bool = when
            both => nearer
            else => high
        digit: U8 = d + round_up.to[U8]()
        digits.stride(n).poke(digit + 48)
        count: USize = n + 1
        write_decimal_digits(out, first: digits, n: count, exponent: k - count.to[S64]())
        return

/// Writes the B128 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine B128.represent_into[T](me: Me, out: @T) -> Void
needs T: typename, Writer[T]
    local bits: U128 = me.bits()
    local negative: Bool = b128_is_negative_bits(bits)
    local biased: S64 = b128_exponent(bits)
    local fraction: U128 = b128_fraction(bits)

    if biased == B128_EXP_MAX
        when
            fraction != 0 =>
                s: Span[Byte] = "NaN"
                write_str(out, text: s)
                return
            negative =>
                s: Span[Byte] = "-inf"
                write_str(out, text: s)
                return
            else =>
                s: Span[Byte] = "inf"
                write_str(out, text: s)
                return
    else
        if negative
            write_str(out, text: "-")
        if biased == 0 and fraction == 0
            s: Span[Byte] = "0.0"
            write_str(out, text: s)
            return
        else
            subnormal: Bool = biased == 0
            f: U128 = when
                subnormal => fraction
                else => fraction | B128_IMPLICIT
            e: S64 = when
                subnormal => -16494
                else => biased - 16383 - 112
            boundary: Bool = fraction == 0 and biased > 1
            write_float_exact(out, f, e, boundary)
            return

// -- fixed-point floats --------------------------------------------------------
//
// represent_fixed_into(out, digits) writes a float with exactly digits digits after
// the point, like C's %.*f: 3.14159 at 2 is "3.14", 1e20 at 0 is
// "100000000000000000000", -0.001 at 2 is "-0.00". Rounding is correct from the
// exact binary value, ties to even (0.125 at 2 is "0.12", 2.5 at 0 is "2").
// Specials are inf, -inf, and NaN, as in represent.

/// Writes f × 2^e (f >= 0, no sign) with digits digits after the point. A float's
/// own digits end max(0, -e) places after the point, so the rounding works on at
/// most that many and the rest are zeros. Sized for B128: f × 10^16494 needs
/// about 55,000 bits and prints at most 16,530 digits.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param f: The significand.
/// :param e: The binary exponent.
/// :param digits: The number of digits after the point.
routine write_float_fixed[T](out: @T, f: U128, e: S64, digits: USize) -> Void
needs T: typename, Writer[T]
    local n: @BigNat[864] <- .hollow()
    local below_zero: U64 = e.min(0).abs_diff(0)
    local own: USize = below_zero.to[USize]()
    // max(0, -e)
    local places: USize = digits.min(own)

    n.set(f)
    if e >= 0
        jump scale_up()
    else
        jump scale_down()

    block scale_up()
        n.shl(e.to[USize]())
        jump print()

    // round(f × 10^places / 2^-e)
    block scale_down()
        n.mul_pow10(places)
        n.shr_round_even(e.abs_diff(0).to[USize]())
        jump print()

    // The digits of n fill chars from the right, 19 at a time.
    block print()
        local buf: @Array[U8, 16640] <- .hollow()
        jump chunk(buf.to[@U8](), 16640)

    block chunk(chars: @U8, at: USize)
        if n.is_zero()
            jump skip_zeros(chars, at)
        else
            jump split(chars, at)

    block split(chars: @U8, at: USize)
        // 10^19
        jump digit(chars, at, n.div_limb(10000000000000000000), 19)

    block digit(chars: @U8, at: USize, rest: U64, left: USize)
        if left == 0
            jump chunk(chars, at)
        else
            jump put(chars, at, rest, left)

    block put(chars: @U8, at: USize, rest: U64, left: USize)
        to: USize = at - 1
        low_digit: U8 = (rest % 10).to[U8]()
        chars.stride(to).poke(low_digit + 48)
        jump digit(chars, to, rest / 10, left - 1)

    // the top chunk is zero-padded to 19 digits
    block skip_zeros(chars: @U8, at: USize)
        if at < 16640
            jump look(chars, at)
        else
            jump lay_out(chars, at)

    block look(chars: @U8, at: USize)
        ascii: U8 = chars.stride(at).peek()
        if ascii == 48
            jump skip_zeros(chars, at + 1)
        else
            jump lay_out(chars, at)

    // n has count digits at chars[first ..]. The last places of them follow the point
    block lay_out(chars: @U8, first: USize)
        count: USize = 16640 - first
        if count > places
            jump int_part(chars, first, count - places)
        else
            jump zero_int(chars, first)

    block int_part(chars: @U8, first: USize, int_count: USize)
        from: @U8 = chars.stride(first)
        write_digits(out, first: from, count: int_count)
        jump fraction(chars, first + int_count)

    block zero_int(chars: @U8, first: USize)
        write_str(out, text: "0")
        jump fraction(chars, first)

    block fraction(chars: @U8, from: USize)
        if digits == 0
            return
        else
            jump point(chars, from)

    block point(chars: @U8, from: USize)
        count: USize = 16640 - from
        write_str(out, text: ".")
        write_zeros(out, count: places - count)
        start: @U8 = chars.stride(from)
        write_digits(out, first: start, count)
        write_zeros(out, count: digits - places)
        return

/// represent_fixed_into for a binary float given its bits and its format: with shift the bias plus the fraction
/// bits, a normal value is (1.fraction) × 2^(biased - shift).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format.
/// :param digits: The number of digits after the point.
routine write_binary_fixed[T](out: @T, bits: U128, format: FloatFormat, digits: USize) -> Void
needs T: typename, Writer[T]
    local mantissa_bits: U128 = format.fraction_bits.to[U128]()
    local shift: S64 = (format.bias + format.fraction_bits.to[S32]()).to[S64]()
    local exponent_max: S64 = format.exponent_max.to[S64]()
    local fraction_mask: U128 = U128.shl(1, mantissa_bits) - 1
    local fraction: U128 = bits & fraction_mask
    local field: U128 = (bits >> mantissa_bits) & exponent_max.to[U128]()
    local biased: S64 = field.to[S64]()
    local sign_at: U128 = (format.width - 1).to[U128]()
    local negative: Bool = bits >> sign_at == 1

    special: Bool = biased == exponent_max
    when
        special and fraction != 0 => jump text("NaN")
        special => jump infinity()
        negative => jump minus()
        else => jump magnitude()

    block infinity()
        if negative
            jump text("-inf")
        else
            jump text("inf")

    block text(s: Span[Byte])
        write_str(out, text: s)
        return

    block minus()
        write_str(out, text: "-")
        jump magnitude()

    block magnitude()
        subnormal: Bool = biased == 0
        implicit: U128 = 1 << mantissa_bits
        f: U128 = when
            subnormal => fraction
            else => fraction | implicit
        e: S64 = when
            subnormal => 1 - shift
            else => biased - shift
        write_float_fixed(out, f, e, digits)
        return

/// Writes the B64 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine B64.represent_fixed_into[T](me: Me, out: @T, digits: USize) -> Void
needs T: typename, Writer[T]
    bits: U128 = me.bits().to[U128]()
    write_binary_fixed(out, bits, format: Me.FORMAT.peek(), digits)
    return

/// Writes the B32 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine B32.represent_fixed_into[T](me: Me, out: @T, digits: USize) -> Void
needs T: typename, Writer[T]
    bits: U128 = me.bits().to[U128]()
    write_binary_fixed(out, bits, format: Me.FORMAT.peek(), digits)
    return

/// Writes the B16 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine B16.represent_fixed_into[T](me: Me, out: @T, digits: USize) -> Void
needs T: typename, Writer[T]
    bits: U128 = me.bits().to[U128]()
    write_binary_fixed(out, bits, format: Me.FORMAT.peek(), digits)
    return

/// Writes the BF16 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine BF16.represent_fixed_into[T](me: Me, out: @T, digits: USize) -> Void
needs T: typename, Writer[T]
    bits: U128 = me.bits().to[U128]()
    write_binary_fixed(out, bits, format: Me.FORMAT.peek(), digits)
    return

/// Writes the B128 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine B128.represent_fixed_into[T](me: Me, out: @T, digits: USize) -> Void
needs T: typename, Writer[T]
    write_binary_fixed(out, bits: me.bits(), format: Me.FORMAT.peek(), digits)
    return

// -- views ---------------------------------------------------------------------
//
// A view wraps a value to pick one of its other forms and conforms to Representable, so
// it can go where any representable value goes, represent_with_into included:
//
//     hex: Hex[U32] = Hex[U32] { value: bits }
//     represent_with_into(out, hex, FormatSpec.zero_padded(8))

/// An integer in lowercase hex (represent_hex_into).
record Hex[T]
needs T: typename, HexRepresentable[T]
obeys Representable[Hex[T]]
    value: T

/// A float with a fixed number of digits after the point (represent_fixed_into).
record Fixed[T]
needs T: typename, FixedRepresentable[T]
obeys Representable[Fixed[T]]
    value: T
    digits: USize

/// Makes a `Hex` from its fields.
/// :param value: Its `value`.
/// :returns: The new value.
routine Hex[T].construct(value: T) -> Me
needs T: typename
    return Me(value)

/// Releases nothing: a `Hex` holds no memory of its own.
routine Hex[T].destruct(me: @Me) -> Void
needs T: typename
    return

/// Makes a `Fixed` from its fields.
/// :param value: Its `value`.
/// :param digits: Its `digits`.
/// :returns: The new value.
routine Fixed[T].construct(value: T, digits: USize) -> Me
needs T: typename
    return Me(value, digits)

/// Releases nothing: a `Fixed` holds no memory of its own.
routine Fixed[T].destruct(me: @Me) -> Void
needs T: typename
    return

/// Writes the wrapped integer with its `represent_hex_into`.
/// :typeparam T: The wrapped integer type.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Hex[T].represent_into[TWriter](me: Me, out: @TWriter) -> Void
needs T: typename, TWriter: typename, Writer[TWriter]
    value: T = me.value
    value.represent_hex_into(out)
    return

/// Writes the wrapped float with its `represent_fixed_into` using `digits`.
/// :typeparam T: The wrapped float type.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Fixed[T].represent_into[TWriter](me: Me, out: @TWriter) -> Void
needs T: typename, TWriter: typename, Writer[TWriter]
    value: T = me.value
    digits: USize = me.digits
    value.represent_fixed_into(out, digits)
    return

// -- width and alignment -------------------------------------------------------
//
// represent_with_into(out, value, spec) writes any representable value padded to
// spec.width characters. It formats the value twice: once into a CountWriter
// to measure it, then for real, so nothing is buffered and any Representable type
// works. Width counts code points, not terminal columns.

/// Where padding goes when a value is shorter than the requested width.
choice Align: U8
    LEFT
    RIGHT
    CENTER
    /// like Right, but the padding goes after a leading - or +: -0042
    AFTER_SIGN

/// How `represent_with_into` pads a value: the minimum width in characters, the fill text, and the alignment.
record FormatSpec
    width: USize
    fill: Span[Byte]
    align: Align

/// Passes writes on to inner, putting pad copies of fill before the first
/// byte, or after it when it is - or +.
record SignPadWriter[T]
needs T: typename
obeys Writer[SignPadWriter[T]] when T: typename, Writer[T]
    inner: @T
    fill: Span[Byte]
    pad: USize

/// Releases the memory its `fill` holds.
routine FormatSpec.destruct(me: @Me) -> Void
    me.fill.destruct()
    return

/// Makes a `SignPadWriter` from its fields.
/// :param inner: Its `inner`.
/// :param fill: Its `fill`.
/// :param pad: Its `pad`.
/// :returns: The new value.
routine SignPadWriter[T].construct(inner: @T, fill: Span[Byte], pad: USize) -> Me
needs T: typename
    return Me(inner, fill, pad)

/// Releases the memory its `fill` holds.
routine SignPadWriter[T].destruct(me: @Me) -> Void
needs T: typename
    me.fill.destruct()
    return

/// Right-aligned to width, padded with spaces.
/// :param width: The minimum width in characters.
/// :returns: The spec.
routine FormatSpec.construct(width: USize) -> Me
    spec: Me = Me(width: width, fill: " ", align: Align.RIGHT)
    return spec

/// Padded with zeros after the sign: -7 at 4 is -007.
/// :param width: The minimum width in characters.
/// :returns: The spec.
routine FormatSpec.zero_padded(width: USize) -> Me
    spec: Me = Me(width: width, fill: "0", align: Align.AFTER_SIGN)
    return spec

/// The same spec with a different alignment.
/// :param align: The new alignment.
/// :returns: A copy of the spec with the new alignment.
routine FormatSpec.with_align(me: Me, align: Align) -> Me
    spec: Me = Me(width: me.width, fill: me.fill, align: align)
    return spec

/// The same spec with a different fill: one character (any UTF-8 text works, but width counts it as one).
/// :param fill: The new fill text.
/// :returns: A copy of the spec with the new fill.
routine FormatSpec.with_fill(me: Me, fill: Span[Byte]) -> Me
    spec: Me = Me(width: me.width, fill: fill, align: me.align)
    return spec

/// Writes text count times.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param text: The text to write.
/// :param count: How many times to write it.
routine write_repeated[T](out: @T, text: Span[Byte], count: USize) -> Void
needs T: typename, Writer[T]
    while left != 0 with left: USize = count
        write_str(out, text)
        continue with left: left - 1
    then
        return

/// Writes `value` padded to at least `spec.width` characters. The value is formatted twice, once into a `CountWriter` to measure it and once for real, so nothing is buffered. A value already as wide as the spec is written unpadded.
/// :typeparam TValue: The type of the value, which must conform to {Representable}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param value: The value to write.
/// :param spec: The width, fill and alignment to apply.
routine represent_with_into[TValue, TWriter](out: @TWriter, value: TValue, spec: FormatSpec) -> Void
needs TValue: typename, TWriter: typename, Writer[TWriter], Representable[TValue]
    local fill: Span[Byte] = spec.fill

    local counter: @CountWriter <- .construct()
    value.represent_into(counter)
    count: USize = counter.count.peek()
    pad: USize = spec.width -^ count
    half: USize = pad / 2
    align: Align = spec.align
    when align
        Align.LEFT =>
            write_repeated(out, text: fill, count: 0)
            value.represent_into(out)
            write_repeated(out, text: fill, count: pad)
            return
        Align.RIGHT =>
            write_repeated(out, text: fill, count: pad)
            value.represent_into(out)
            write_repeated(out, text: fill, count: 0)
            return
        Align.CENTER =>
            write_repeated(out, text: fill, count: half)
            value.represent_into(out)
            write_repeated(out, text: fill, count: pad - half)
            return
        Align.AFTER_SIGN =>
            local inner: @SignPadWriter[TWriter] <- SignPadWriter[TWriter](inner: out, fill: fill, pad: pad)
            value.represent_into(inner)
            return

/// Writes the first bytes after the padding, or after a leading `-` or `+`, and passes every later write straight through.
/// :typeparam T: The inner Writer type.
/// :param data: The bytes being written.
/// :param count: The number of bytes.
routine SignPadWriter[T].write_bytes(me: @Me, data: @Byte, count: USize) -> Void
needs T: typename, Writer[T]
    local inner: @T = me.inner.peek()
    local pad: USize = me.pad.peek()

    if pad > 0 and count > 0
        fill: Span[Byte] = me.fill.peek()
        me.pad.poke(0)
        byte: U8 = Byte.to[U8](data.stride(0).peek())
        signed: Bool = byte == 45 or byte == 43
        // - or +
        values2: (@Byte, USize) = when
            signed =>
                inner.write_bytes(data, count: 1)
                becomes (data.stride(1), count - 1)
            else => (data, count)
        from, left = values2
        write_repeated(out: inner, text: fill, count: pad)
        inner.write_bytes(data: from, count: left)
        return
    else
        inner.write_bytes(data: data, count: count)
        return
