// Tessera stdlib: formatting
//
// Formatting writes text into a Writer: any type with a write_bytes method.
// Nothing allocates unless the Writer does, nothing parses a format string, and
// every value is written by one visible call. The writers for standard output
// and error need an operating system, so they're in Standard::Os
// (Os/Stdio.tess):
//
//     out : @Out = Out.writer()
//     write_str(out, "x = ")
//     x.represent_into(out)
//     write_line(out)
//
// A type is representable when it conforms to Representable. Integers have two forms:
// represent (decimal, signed for S types and unsigned for U types) and represent_hex_into
// (lowercase hex of the bits).

module Standard::Format

import Standard::Alloc
import Standard::Collections

/// A sink for bytes: any type with a `write_bytes` method. Formatting routines write into a Writer, so nothing allocates unless the Writer does.
/// :typeparam T: The type that accepts bytes.
concept Writer<T>
require T: typename
    /// Writes `count` bytes starting at `data`.
    /// :param data: The first byte to write.
    /// :param count: The number of bytes to write.
    routine Self.write_bytes(self: @Self, data: @Byte, count: USize) -> Void

/// A type that can write its program-output text into a Writer with `represent_into`. Integers write decimal (`represent_hex_into` gives hex), Bytes writes itself unquoted, and Bool writes `true` or `false`.
/// :typeparam T: The type that can write its program-output text.
concept Representable<T>
require T: typename
    /// Writes the value's program-output text to `out`.
    /// :typeparam TWriter: The type of the Writer that receives the text.
    /// :param out: The Writer the text is written to.
    routine Self.represent_into<TWriter>(self: Self, out: @TWriter) -> Void

/// The built-in types' represent routines are further down.
conform Representable<S8>, Representable<S16>, Representable<S32>, Representable<S64>, Representable<S128>, Representable<S256>
conform Representable<U8>, Representable<U16>, Representable<U32>, Representable<U64>, Representable<U128>, Representable<U256>
conform Representable<USize>, Representable<SSize>
conform Representable<F16>, Representable<BF16>, Representable<F32>, Representable<F64>, Representable<F128>
conform Representable<Bool>, Representable<Char>, Representable<Bytes>, Representable<Addr>
conform Representable<Array<T, COUNT>> when T: typename, COUNT: USize, Diagnosable<T>

// -- SliceWriter ---------------------------------------------------------------

/// Writes into a caller's buffer, for formatting into memory without a heap. What
/// doesn't fit is dropped and sets `overflowed`.
record SliceWriter
conform Writer<SliceWriter>
    data       : @Byte
    capacity   : USize
    count      : USize
    overflowed : Bool

/// Creates a writer over `capacity` bytes starting at `data`. The buffer stays owned by the caller and must outlive the writer.
/// :param data: The start of the caller's buffer.
/// :param capacity: The size of the buffer in bytes.
/// :returns: A writer that appends into the buffer, with nothing written yet.
routine SliceWriter.construct(data: @Byte, capacity: USize) -> Self
    block entry()
        w : Self = Self { data: data, capacity: capacity, count: 0, overflowed: false }
        return(w)

/// The text written so far, a view into the buffer.
/// :returns: The bytes written so far, a view into the buffer.
routine SliceWriter.to<Bytes>(self: Self) -> Bytes
    block entry()
        data  : @Byte = self.data
        count : USize = self.count
        s     : Bytes = .from_ptr(data, count)
        return(s)

/// The text written so far, a view into the buffer.
/// :returns: The bytes written so far, a view into the buffer.
routine SliceWriter.to<Bytes>(self: @Self) -> Bytes
    block entry()
        s : Bytes = .from_ptr(self.data.load(), self.count.load())
        return(s)

/// True once some write did not fit in the buffer, meaning the text was cut off.
/// :returns: True when at least one write was cut short.
routine SliceWriter.has_overflowed(self: Self) -> Bool
    block entry()
        r : Bool = self.overflowed
        return(r)

/// True once some write did not fit in the buffer, meaning the text was cut off.
/// :returns: True when at least one write was cut short.
routine SliceWriter.has_overflowed(self: @Self) -> Bool
    block entry()
        r : Bool = self.overflowed.load()
        return(r)

/// Appends as many of the `count` bytes as fit in the remaining room and drops the rest.
/// :param bytes: The bytes to append.
/// :param count: The number of bytes to append.
/// :note: Sets the overflow flag when anything was dropped, see {SliceWriter.has_overflowed}.
routine SliceWriter.write_bytes(self: @Self, bytes: @Byte, count: USize) -> Void
    block entry()
        used     : USize = self.count.load()
        capacity : USize = self.capacity.load()
        room     : USize = capacity.sub(used)
        fits     : Bool  = count.le(room)
        taken    : USize = count.min(room)
        data     : @Byte = self.data.load()
        to       : @Byte = data.stride(used)
        to.copy(bytes, taken)
        self.count.store(used.add(taken))
        branch fits
            ? return()
            : continue
        self.overflowed.store(true)
        return()

// -- BufWriter -----------------------------------------------------------------

/// Collects writes in a 4 KiB buffer and passes them on to another Writer in
/// large pieces. Nothing reaches the inner Writer until the buffer fills or
/// flush() is called, and nothing flushes by itself: call flush() before the
/// program ends or reads input. Writes of 4 KiB or more skip the buffer.
record BufWriter<T>
require T: typename
conform Writer<BufWriter<T>>
    private inner  : @T
    private count : USize
    private data   : Array<Byte, 4096>

/// Sets up the buffer to pass its writes on to `inner`, with nothing buffered yet. `inner` must outlive the writer.
/// :typeparam T: The inner Writer type.
/// :param inner: The Writer that receives the buffered bytes.
routine BufWriter<T>.construct(self: @Self, inner: @T) -> Void
require T: typename
    block entry()
        self.inner.store(inner)
        self.count.store(0)
        return()

/// Writes out the buffered bytes.
routine BufWriter<T>.flush(self: @Self) -> Void
require T: typename, Writer<T>
    shared count  : USize              = self.count.load()
    shared inner  : @T                 = self.inner.load()
    shared buffer : @Array<Byte, 4096> = self.data
    shared data   : @Byte              = buffer.to<@Byte>()

    block entry()
        self.count.store(0)
        empty : Bool = count.eq(0)
        branch empty
            ? return()
            : pass()

    block pass()
        inner.write_bytes(data, count)
        return()

/// Appends to the buffer, flushing it first when the bytes would not fit. A write of 4 KiB or more goes straight to the inner Writer after that flush.
/// :typeparam T: The inner Writer type.
/// :param bytes: The bytes to append.
/// :param count: The number of bytes to append.
routine BufWriter<T>.write_bytes(self: @Self, bytes: @Byte, count: USize) -> Void
require T: typename, Writer<T>
    block entry()
        buffered : USize = self.count.load()
        fits     : Bool  = buffered.add(count).le(4096)
        branch fits
            ? append(buffered)
            : make_room()

    block make_room()
        self.flush()
        large : Bool = count.ge(4096)
        branch large
            ? direct()
            : append(0)

    block direct()
        inner : @T = self.inner.load()
        inner.write_bytes(bytes, count)
        return()

    block append(buffered: USize)
        buffer : @Array<Byte, 4096> = self.data
        data   : @Byte              = buffer.to<@Byte>()
        to     : @Byte              = data.stride(buffered)
        to.copy(bytes, count)
        self.count.store(buffered.add(count))
        return()

// -- CountWriter ---------------------------------------------------------------

/// Writes nothing and counts characters (UTF-8 code points: every byte that
/// isn't a continuation byte), to measure text before laying it out.
record CountWriter
conform Writer<CountWriter>
    count : USize

/// Creates a counting writer with a count of zero.
/// :returns: A counting writer with a count of zero.
routine CountWriter.construct() -> Self
    block entry()
        w : Self = Self { count: 0 }
        return(w)

/// Adds the number of UTF-8 code points in the bytes (every byte that is not a `10xxxxxx` continuation byte) to `count`, without storing the bytes.
/// :param bytes: The bytes to count.
/// :param count: The number of bytes.
routine CountWriter.write_bytes(self: @Self, bytes: @Byte, count: USize) -> Void
    block entry()
        total : USize = self.count.load()
        jump loop(0, total)

    block loop(i: USize, total: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish(total)
            : step(i, total)

    // continuation bytes are 10xxxxxx
    block step(i: USize, total: USize)
        byte   : U8   = Byte.to<U8>(bytes.stride(i).load())
        starts : Bool = byte.bitand(0xC0).ne(0x80)
        jump loop(i.add(1), total.add(starts.to<USize>()))

    block finish(total: USize)
        self.count.store(total)
        return()

// -- text ----------------------------------------------------------------------

/// Writes the bytes of `text` to `out` as they are.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param text: The bytes to write.
routine write_str<T>(out: @T, text: Bytes) -> Void
require T: typename, Writer<T>
    block entry()
        data  : @Byte = text.data
        count : USize = text.count
        out.write_bytes(data, count)
        return()

/// Writes a single `\n` to `out`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine write_line<T>(out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        write_str(out, "\n")
        return()

// -- Representable -----------------------------------------------------------------
//
// Decimal follows the type (S types signed, U types unsigned), hex writes the
// bits, so a negative S value shows its two's complement. The narrower types
// widen to the 64-bit ones, and the U64, U128, and U256 writers also take a
// minimum digit count (zero-padded), which the 19-digit chunks of the wider
// ones use.

/// 10^19, the largest power of ten that fits in a U64, used as the chunk size when writing wide decimals.
preset TEN_POW_19: U128 = 10000000000000000000
/// 2^64, the first value that no longer fits in a U64.
preset TWO_POW_64: U128 = U64.MAX.to<U128>().add(1)
/// `TEN_POW_19` as a U256, the chunk divisor for U256 decimals.
preset TEN_POW_19_WIDE: U256 = TEN_POW_19.to<U256>()

/// Writes the S8 in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S8.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<S64>().represent_into(out)
        return()

/// Writes the bits of the S8 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S8.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        bits : U8 = self.bits().to<U8>()
        bits.represent_hex_into(out)
        return()

/// Writes the S16 in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S16.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<S64>().represent_into(out)
        return()

/// Writes the bits of the S16 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S16.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to_wrap<U16>().represent_hex_into(out)
        return()

/// Writes the S32 in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S32.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<S64>().represent_into(out)
        return()

/// Writes the bits of the S32 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S32.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to_wrap<U32>().represent_hex_into(out)
        return()

/// Writes the S64 in decimal, with a leading `-` when negative: the sign, then the magnitude, which always fits in a U64.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S64.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? minus()
            : magnitude()

    block minus()
        write_str(out, "-")
        jump magnitude()

    block magnitude()
        self.abs_diff(0).represent_into(out)
        return()

/// Writes the bits of the S64 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S64.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to_wrap<U64>().represent_hex_into(out)
        return()

/// Writes the S128 in decimal, with a leading `-` when negative: the sign, then the magnitude.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S128.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? minus()
            : magnitude()

    block minus()
        write_str(out, "-")
        jump magnitude()

    block magnitude()
        self.abs_diff(0).represent_into(out)
        return()

/// Writes the bits of the S128 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S128.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to_wrap<U128>().represent_hex_into(out)
        return()

/// Writes the S256 in decimal, with a leading `-` when negative: the sign, then the magnitude.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S256.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? minus()
            : magnitude()

    block minus()
        write_str(out, "-")
        jump magnitude()

    block magnitude()
        self.abs_diff(0).represent_into(out)
        return()

/// Writes the bits of the S256 in lowercase hex with no leading zeros, so a negative value shows its two's complement at the type's width.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S256.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to_wrap<U256>().represent_hex_into(out)
        return()

/// Writes the U8 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U8.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_into(out)
        return()

/// Writes the U8 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U8.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_hex_into(out)
        return()

/// Writes the U16 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U16.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_into(out)
        return()

/// Writes the U16 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U16.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_hex_into(out)
        return()

/// Writes the U32 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U32.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_into(out)
        return()

/// Writes the U32 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U32.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_hex_into(out)
        return()

/// Writes the U64 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U64.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.represent_into(out, 0)
        return()

/// Writes the U64 in decimal, zero-padded to at least `min_digits` digits (at most 20).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U64.represent_into<T>(self: Self, out: @T, min_digits: USize) -> Void
require T: typename, Writer<T>
    shared buf    : @Array<Byte, 20> <- uninit
    shared digits : @Byte            = buf.to<@Byte>()

    block entry()
        jump digit(20, self)

    // Fills digits from the right: at least one digit, then until the value is
    // used up and min_digits are written.
    block digit(end: USize, rest: Self)
        at        : USize = end.sub(1)
        low_digit : U8    = rest.mod(10).to<U8>()
        ascii     : U8    = low_digit.add(48)  // '0' = 48
        digits.stride(at).store(ascii.bits())
        next       : Self  = rest.div(10)
        written    : USize = 20.sub(at)
        more_value : Bool  = next.ne(0)
        more_width : Bool  = written.lt(min_digits)
        more       : Bool  = more_value.bitor(more_width)
        branch more
            ? digit(at, next)
            : emit(at)

    block emit(start: USize)
        first : @Byte = digits.stride(start)
        out.write_bytes(first, 20.sub(start))
        return()

/// Writes the U64 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U64.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.represent_hex_into(out, 0)
        return()

/// Writes the U64 in lowercase hex, zero-padded to at least `min_digits` digits (at most 16).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U64.represent_hex_into<T>(self: Self, out: @T, min_digits: USize) -> Void
require T: typename, Writer<T>
    shared buf    : @Array<Byte, 16> <- uninit
    shared digits : @Byte            = buf.to<@Byte>()

    block entry()
        jump digit(16, self)

    block digit(end: USize, rest: Self)
        at      : USize = end.sub(1)
        nibble  : U8    = rest.bitand(15).to<U8>()
        decimal : Bool  = nibble.lt(10)
        base    : U8    = decimal  // '0', or 'a' - 10
            ? 48
            : 87
        digits.stride(at).store(base.add(nibble).bits())
        next       : Self  = rest.shr(4)
        written    : USize = 16.sub(at)
        more_value : Bool  = next.ne(0)
        more_width : Bool  = written.lt(min_digits)
        more       : Bool  = more_value.bitor(more_width)
        branch more
            ? digit(at, next)
            : emit(at)

    block emit(start: USize)
        first : @Byte = digits.stride(start)
        out.write_bytes(first, 16.sub(start))
        return()

/// Writes the U128 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U128.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.represent_into(out, 0)
        return()

/// Writes the U128 in decimal, zero-padded to at least `min_digits` digits. It goes out in 19-digit chunks, so only
/// the chunking divides U128.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U128.represent_into<T>(self: Self, out: @T, min_digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        fits : Bool = self.lt(TWO_POW_64)
        branch fits
            ? low_only()
            : split()

    block low_only()
        self.to<U64>().represent_into(out, min_digits)
        return()

    block split()
        high     : Self  = self.div(TEN_POW_19)
        low      : Self  = self.mod(TEN_POW_19)
        high_min : USize = min_digits.sub_clamp(19)
        high.represent_into(out, high_min)
        low.to<U64>().represent_into(out, 19)
        return()

/// Writes the U128 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U128.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    shared high : U64 = self.shr(64).to<U64>()
    shared low  : U64 = self.to_wrap<U64>()

    block entry()
        wide : Bool = high.ne(0)
        branch wide
            ? both()
            : low_only()

    block low_only()
        low.represent_hex_into(out)
        return()

    block both()
        high.represent_hex_into(out)
        low.represent_hex_into(out, 16)
        return()

/// Writes the U256 in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U256.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.represent_into(out, 0)
        return()

/// Writes the U256 in decimal, zero-padded to at least `min_digits` digits. It goes out in 19-digit chunks too, until
/// the rest fits in 128 bits.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param min_digits: The fewest digits to write. Shorter values get leading zeros.
routine U256.represent_into<T>(self: Self, out: @T, min_digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        fits : Bool = self.shr(128).eq(0)
        branch fits
            ? narrow()
            : split()

    block narrow()
        self.to<U128>().represent_into(out, min_digits)
        return()

    block split()
        high     : Self  = self.div(TEN_POW_19_WIDE)
        low      : Self  = self.mod(TEN_POW_19_WIDE)
        high_min : USize = min_digits.sub_clamp(19)
        high.represent_into(out, high_min)
        low.to<U64>().represent_into(out, 19)
        return()

/// Writes the U256 in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine U256.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    shared high : U128 = self.shr(128).to<U128>()
    shared low  : U128 = self.to_wrap<U128>()

    block entry()
        wide : Bool = high.ne(0)
        branch wide
            ? both()
            : low_only()

    block low_only()
        low.represent_hex_into(out)
        return()

    block both()
        middle : U64 = low.shr(64).to<U64>()
        high.represent_hex_into(out)
        middle.represent_hex_into(out, 16)
        low.to_wrap<U64>().represent_hex_into(out, 16)
        return()

/// Writes the USize in decimal.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine USize.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_into(out)
        return()

/// Writes the USize in lowercase hex with no leading zeros (`0` for zero).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine USize.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<U64>().represent_hex_into(out)
        return()

/// Writes the SSize in decimal, with a leading `-` when negative.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine SSize.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to<S64>().represent_into(out)
        return()

/// The bits at the target's width, like the fixed-width types.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine SSize.represent_hex_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        self.to_wrap<USize>().represent_hex_into(out)
        return()

/// The character's UTF-8 bytes.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Char.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        claim buf : @Array<Byte, 4> <- uninit
        bytes : @Byte = buf.to<@Byte>()
        count : USize = utf8_encode_into(self, bytes)
        out.write_bytes(bytes, count)
        return()

/// Writes `true` or `false`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Bool.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        branch self
            ? yes()
            : no()

    block yes()
        write_str(out, "true")
        return()

    block no()
        write_str(out, "false")
        return()

/// Writes the bytes as they are, without quotes or escapes.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Bytes.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        write_str(out, self)
        return()

// -- addresses -----------------------------------------------------------------
//
// A pointer isn't Representable: `{p}` would hide whether the value or the
// address was meant. `{p.load()}` writes the value, `{p.to<Addr>()}` the
// address, as lowercase hex after 0x without leading zeros, like Rust's {:p}.
// Null is 0x0.

/// Writes the address as `0x` and lowercase hex without leading zeros. Null is `0x0`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Addr.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        address : U64 = ptrtoint<Self, U64>(self)
        write_str(out, "0x")
        address.represent_hex_into(out, 1)
        return()

// -- arrays --------------------------------------------------------------------

/// The elements, each diagnosed (so strings keep their quotes), as [1, 2, 3].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Array<T, COUNT>.represent_into<TWriter>(self: Self, out: @TWriter) -> Void
require T: typename, COUNT: USize, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    shared slot : @Self <- self

    block entry()
        write_str(out, "[")
        jump walk(0)

    block walk(at: USize)
        more : Bool = at.lt(COUNT)
        branch more
            ? item(at)
            : close()

    block item(at: USize)
        first : Bool = at.eq(0)
        branch first
            ? element(at)
            : separate(at)

    block separate(at: USize)
        write_str(out, ", ")
        jump element(at)

    block element(at: USize)
        value : T = slot.getitem(at)
        value.diagnose_into(out)
        jump walk(at.add(1))

    block close()
        write_str(out, "]")
        return()

// -- floats --------------------------------------------------------------------
//
// Floats print the shortest decimal that reads back to the same value (Ryu,
// Standard/Ryu.tess), laid out like Python's repr: positional when the decimal
// exponent is in -4 .. 15 (0.0001, 1.0, 123.5), scientific otherwise (1e+16,
// 5e-324). Specials are inf, -inf, NaN, and -0.0. Digits are built as ASCII
// codes in U8 buffers and written out as bytes.

/// Writes count zeros.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param count: The number of zeros.
routine write_zeros<T>(out: @T, count: USize) -> Void
require T: typename, Writer<T>
    block entry()
        jump loop(count)

    block loop(left: USize)
        done : Bool = left.eq(0)
        branch done
            ? return()
            : one(left)

    block one(left: USize)
        write_str(out, "0")
        jump loop(left.sub(1))

/// Writes count ASCII digits starting at first.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param first: The first digit, as an ASCII code.
/// :param count: The number of digits.
routine write_digits<T>(out: @T, first: @U8, count: USize) -> Void
require T: typename, Writer<T>
    block entry()
        bytes : @Byte = first.to<@Byte>()
        out.write_bytes(bytes, count)
        return()

/// Writes digits × 10^exponent (digits > 0, at most 19 digits).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param d: The digits and the decimal exponent.
routine write_float_decimal<T>(out: @T, d: FloatDecimal) -> Void
require T: typename, Writer<T>
    shared buf    : @Array<U8, 20> <- uninit
    shared digits : @U8            = buf.to<@U8>()
    shared end    : @USize         <- 20

    block entry()
        value : U64 = d.digits
        jump fill(value)

    block fill(rest: U64)
        at        : USize = end.load().sub(1)
        low_digit : U8    = rest.mod(10).to<U8>()
        digits.stride(at).store(low_digit.add(48))
        next : U64  = rest.div(10)
        more : Bool = next.ne(0)
        branch more
            ? continue
            : layout(at)
        at.store_into(end)
        jump fill(next)

    block layout(start: USize)
        first : @U8 = digits.stride(start)
        write_decimal_digits(out, first, 20.sub(start), d.exponent)
        return()

/// Writes the n ASCII digits at first times 10^exponent (no leading zero). The
/// point goes after the first digit at scientific exponent x = n - 1 + exponent.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param first: The first digit, as an ASCII code.
/// :param n: The number of digits.
/// :param exponent: The power of ten the digits are scaled by.
routine write_decimal_digits<T>(out: @T, first: @U8, n: USize, exponent: S64) -> Void
require T: typename, Writer<T>
    shared top_place : S64 = n.to<S64>().sub(1)
    shared x         : S64 = top_place.add(exponent)

    block entry()
        low_ok     : Bool = x.ge(-4)
        high_ok    : Bool = x.lt(16)
        positional : Bool = low_ok.bitand(high_ok)
        branch positional
            ? positional()
            : scientific()

    block positional()
        whole    : Bool = exponent.ge(0)
        fraction : Bool = x.lt(0)
        when
            whole    -> integral()
            fraction -> below_one()
            else     -> split()

    // 1234 × 10^2 → 123400.0
    block integral()
        write_digits(out, first, n)
        write_zeros(out, exponent.to<USize>())
        write_str(out, ".0")
        return()

    // 1234 × 10^-6 → 0.001234
    block below_one()
        write_str(out, "0.")
        x_magnitude : USize = x.abs_diff(0).to<USize>()
        write_zeros(out, x_magnitude.sub(1))
        write_digits(out, first, n)
        return()

    // 1234 × 10^-2 → 12.34
    block split()
        tail : USize = exponent.abs_diff(0).to<USize>()
        head : USize = n.sub(tail)
        write_digits(out, first, head)
        write_str(out, ".")
        rest : @U8 = first.stride(head)
        write_digits(out, rest, tail)
        return()

    // 1234 × 10^20 → 1.234e+23
    block scientific()
        write_digits(out, first, 1)
        more : Bool = n.gt(1)
        branch more
            ? mantissa_tail()
            : exponent_part()

    block mantissa_tail()
        write_str(out, ".")
        rest : @U8 = first.stride(1)
        write_digits(out, rest, n.sub(1))
        jump exponent_part()

    // e+XX / e-XX, at least two digits
    block exponent_part()
        negative : Bool = x.lt(0)
        branch negative
            ? minus_exponent()
            : plus_exponent()

    block minus_exponent()
        write_str(out, "e-")
        x.abs_diff(0).represent_into(out, 2)
        return()

    block plus_exponent()
        write_str(out, "e+")
        x.abs_diff(0).represent_into(out, 2)
        return()

/// Writes a binary float given its IEEE fields. exponent_max is the all-ones
/// exponent (infinity / NaN).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param negative: The sign bit.
/// :param mantissa: The stored mantissa field.
/// :param exponent: The biased exponent field.
/// :param mantissa_bits: The number of stored mantissa bits.
/// :param bias: The exponent bias.
/// :param exponent_max: The all-ones exponent field.
routine write_binary_float<T>(out: @T, negative: Bool, mantissa: U64, exponent: U64,
    mantissa_bits: S64, bias: S64, exponent_max: U64) -> Void
require T: typename, Writer<T>
    block entry()
        special : Bool = exponent.eq(exponent_max)
        branch special
            ? special()
            : sign()

    block special()
        nan : Bool = mantissa.ne(0)
        branch nan
            ? nan()
            : infinity()

    block nan()
        write_str(out, "NaN")
        return()

    block infinity()
        branch negative
            ? negative_infinity()
            : positive_infinity()

    block negative_infinity()
        write_str(out, "-inf")
        return()

    block positive_infinity()
        write_str(out, "inf")
        return()

    block sign()
        branch negative
            ? minus()
            : magnitude()

    block minus()
        write_str(out, "-")
        jump magnitude()

    block magnitude()
        zero : Bool = mantissa.bitor(exponent).eq(0)
        branch zero
            ? zero()
            : digits()

    block zero()
        write_str(out, "0.0")
        return()

    block digits()
        double : Bool = mantissa_bits.eq(52)
        branch double
            ? double()
            : narrow()

    block double()
        d : FloatDecimal = ryu_double_decimal(mantissa, exponent.to<S64>())
        write_float_decimal(out, d)
        return()

    block narrow()
        d : FloatDecimal = ryu_float_decimal(mantissa.to<S64>(), exponent.to<S64>(), mantissa_bits,
            bias)
        write_float_decimal(out, d)
        return()

/// Writes the F64 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine F64.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        bits     : U64  = self.bits()
        negative : Bool = bits.shr(63).eq(1)
        mantissa : U64  = bits.bitand(0x000FFFFFFFFFFFFF)  // 2^52 - 1
        exponent : U64  = bits.shr(52).bitand(2047)
        write_binary_float(out, negative, mantissa, exponent, 52, 1023, 2047)
        return()

/// Writes the F32 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine F32.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        bits     : U64  = self.bits().to<U64>()
        negative : Bool = bits.shr(31).eq(1)
        mantissa : U64  = bits.bitand(0x7FFFFF)  // 2^23 - 1
        exponent : U64  = bits.shr(23).bitand(255)
        write_binary_float(out, negative, mantissa, exponent, 23, 127, 255)
        return()

/// Writes the F16 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine F16.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        bits     : U64  = self.bits().to<U64>()
        negative : Bool = bits.shr(15).eq(1)
        mantissa : U64  = bits.bitand(0x3FF)  // 2^10 - 1
        exponent : U64  = bits.shr(10).bitand(31)
        write_binary_float(out, negative, mantissa, exponent, 10, 15, 31)
        return()

/// Writes the BF16 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine BF16.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        bits     : U64  = self.bits().to<U64>()
        negative : Bool = bits.shr(15).eq(1)
        mantissa : U64  = bits.bitand(0x7F)  // 2^7 - 1
        exponent : U64  = bits.shr(7).bitand(255)
        write_binary_float(out, negative, mantissa, exponent, 7, 127, 255)
        return()

// -- F128 ----------------------------------------------------------------------
//
// F128 needs up to 36 digits, past Ryu's 64-bit tables, so its shortest digits
// come from Burger and Dybvig's exact method ("Printing Floating-Point Numbers
// Quickly and Accurately", 1996) on BigNats. With v = f × 2^e, the value,
// half the gap to the next float, and half the gap to the previous one are
// r / s, m+ / s, and m- / s. Digits come out one at a time until the number so
// far is inside the rounding interval. The last digit is the nearer choice.

/// floor(x × log10(2)), for |x| up to about 10^6.
/// :param x: The power of two.
/// :returns: floor(`x` × log10(2)).
routine floor_log10_pow2(x: S64) -> S64
    block entry()
        r : S64 = x.mul(646456993).shr(31)
        return(r)

/// Writes f × 2^e (f > 0) as its shortest round-trip decimal. boundary says the
/// gap below is half the gap above (f is a power of two above the smallest
/// normal). even says ties read back as this float (f is even).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param f: The significand, above 0.
/// :param e: The binary exponent.
/// :param boundary: True when the gap below is half the gap above.
/// :param even: True when a tie reads back as this float.
routine write_float_exact<T>(out: @T, f: U128, e: S64, boundary: Bool, even: Bool) -> Void
require T: typename, Writer<T>
    shared r     : @BigNat<320> <- uninit
    shared s     : @BigNat<320> <- uninit
    shared plus  : @BigNat<320> <- uninit
    shared minus : @BigNat<320> <- uninit
    shared t     : @BigNat<320> <- uninit

    block entry()
        one : U64 = 1
        r.set(f)
        s.set(one)
        plus.set(one)
        minus.set(one)
        // r = 2f (4f at a boundary), s = 2 (4), m+ = 1 (2), m- = 1. Then 2^e
        // goes on r, m+, m- when e >= 0 and on s when e < 0.
        doubling : USize = boundary
            ? 2
            : 1
        r.shl(doubling)
        s.shl(doubling)
        plus.shl(doubling.sub(1))
        up : Bool = e.ge(0)
        branch up
            ? scale_up()
            : scale_down()

    block scale_up()
        up : USize = e.to<USize>()
        r.shl(up)
        plus.shl(up)
        minus.shl(up)
        jump estimate()

    block scale_down()
        s.shl(e.abs_diff(0).to<USize>())
        jump estimate()

    // k = floor((bits(f) - 1 + e) × log10 2) + 1 is at most ceil(log10 v)//
    // divide by 10^k (multiply s, or r and the margins).
    block estimate()
        bits     : S64  = 128.sub(f.leading_zeros().to<S64>())
        k        : S64  = floor_log10_pow2(bits.sub(1).add(e)).add(1)
        positive : Bool = k.ge(0)
        branch positive
            ? divide_s(k)
            : multiply_r(k)

    block divide_s(k: S64)
        s.mul_pow10(k.to<USize>())
        jump fixup(k)

    block multiply_r(k: S64)
        up : USize = k.abs_diff(0).to<USize>()
        r.mul_pow10(up)
        plus.mul_pow10(up)
        minus.mul_pow10(up)
        jump fixup(k)

    // Raise k while the top of the interval reaches 10^k, so every number in it
    // is below 10^k and the first digit is its leading one.
    block fixup(k: S64)
        t.copy_from(r)
        t.add(plus)
        cmp  : S32  = t.compare(s)
        high : Bool = even
            ? cmp.ge(0)
            : cmp.gt(0)
        branch high
            ? raise(k)
            : start(k)

    block raise(k: S64)
        s.mul_add(10, 0)
        jump fixup(k.add(1))

    block start(k: S64)
        claim buf : @Array<U8, 48> <- uninit
        digits : @U8 = buf.to<@U8>()
        jump next_digit(0, k, digits)

    // d = floor(10r / s), r = 10r mod s, and the margins scale by 10 too.
    block next_digit(n: USize, k: S64, digits: @U8)
        r.mul_add(10, 0)
        plus.mul_add(10, 0)
        minus.mul_add(10, 0)
        jump take(0, n, k, digits)

    block take(d: U8, n: USize, k: S64, digits: @U8)
        more : Bool = r.compare(s).ge(0)
        branch more
            ? take_one(d, n, k, digits)
            : judge(d, n, k, digits)

    block take_one(d: U8, n: USize, k: S64, digits: @U8)
        r.sub(s)
        jump take(d.add(1), n, k, digits)

    // low: the digits so far are already within m- of the value. High: rounding
    // this digit up is within m+. Either one ends the output.
    block judge(d: U8, n: USize, k: S64, digits: @U8)
        low_cmp : S32  = r.compare(minus)
        low     : Bool = even
            ? low_cmp.le(0)
            : low_cmp.lt(0)
        t.copy_from(r)
        t.add(plus)
        high_cmp : S32  = t.compare(s)
        high     : Bool = even
            ? high_cmp.ge(0)
            : high_cmp.gt(0)
        either : Bool = low.bitor(high)
        branch either
            ? last(d, n, k, low, high, digits)
            : emit(d, n, k, digits)

    block emit(d: U8, n: USize, k: S64, digits: @U8)
        digits.stride(n).store(d.add(48))
        jump next_digit(n.add(1), k, digits)

    // Both ends reachable: the nearer one, and the even digit on an exact tie.
    block last(d: U8, n: USize, k: S64, low: Bool, high: Bool, digits: @U8)
        t.copy_from(r)
        t.shl(1)
        half     : S32  = t.compare(s)
        d_odd    : Bool = d.bitand(1).eq(1)
        nearer   : Bool = half.gt(0).bitor(half.eq(0).bitand(d_odd))
        both     : Bool = low.bitand(high)
        round_up : Bool = both
            ? nearer
            : high
        digit : U8 = d.add(round_up.to<U8>())
        digits.stride(n).store(digit.add(48))
        count : USize = n.add(1)
        write_decimal_digits(out, digits, count, k.sub(count.to<S64>()))
        return()

/// Writes the F128 as the shortest decimal that reads back as the same value, laid out positionally when the decimal exponent is in -4 .. 15 (`0.0001`, `123.5`, `1.0`) and in scientific form otherwise (`1e+16`). Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine F128.represent_into<T>(self: Self, out: @T) -> Void
require T: typename, Writer<T>
    shared bits     : U128 = self.bits()
    shared negative : Bool = f128_is_negative_bits(bits)
    shared biased   : S64  = f128_exponent(bits)
    shared fraction : U128 = f128_fraction(bits)

    block entry()
        special : Bool = biased.eq(F128_EXP_MAX)
        branch special
            ? special()
            : sign()

    block special()
        nan : Bool = fraction.ne(0)
        when
            nan      -> text("NaN")
            negative -> text("-inf")
            else     -> text("inf")

    block text(s: Bytes)
        write_str(out, s)
        return()

    block sign()
        branch negative
            ? minus()
            : magnitude()

    block minus()
        write_str(out, "-")
        jump magnitude()

    block magnitude()
        zero : Bool = biased.eq(0).bitand(fraction.eq(0))
        branch zero
            ? text("0.0")
            : digits()

    block digits()
        subnormal : Bool = biased.eq(0)
        f         : U128 = subnormal
            ? fraction
            : fraction.bitor(F128_IMPLICIT)
        e : S64 = subnormal
            ? -16494
            : biased.sub(16383).sub(112)
        boundary : Bool = fraction.eq(0).bitand(biased.gt(1))
        even     : Bool = f.bitand(1).eq(0)
        write_float_exact(out, f, e, boundary, even)
        return()

// -- fixed-point floats --------------------------------------------------------
//
// represent_fixed_into(out, digits) writes a float with exactly digits digits after
// the point, like C's %.*f: 3.14159 at 2 is "3.14", 1e20 at 0 is
// "100000000000000000000", -0.001 at 2 is "-0.00". Rounding is correct from the
// exact binary value, ties to even (0.125 at 2 is "0.12", 2.5 at 0 is "2").
// Specials are inf, -inf, and NaN, as in represent.

/// Writes f × 2^e (f >= 0, no sign) with digits digits after the point. A float's
/// own digits end max(0, -e) places after the point, so the rounding works on at
/// most that many and the rest are zeros. Sized for F128: f × 10^16494 needs
/// about 55,000 bits and prints at most 16,530 digits.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param f: The significand.
/// :param e: The binary exponent.
/// :param digits: The number of digits after the point.
routine write_float_fixed<T>(out: @T, f: U128, e: S64, digits: USize) -> Void
require T: typename, Writer<T>
    shared n          : @BigNat<864> <- uninit
    shared below_zero : U64          = e.min(0).abs_diff(0)
    shared own        : USize        = below_zero.to<USize>()  // max(0, -e)
    shared places     : USize        = digits.min(own)

    block entry()
        n.set(f)
        up : Bool = e.ge(0)
        branch up
            ? scale_up()
            : scale_down()

    block scale_up()
        n.shl(e.to<USize>())
        jump print()

    // round(f × 10^places / 2^-e)
    block scale_down()
        n.mul_pow10(places)
        n.shr_round_even(e.abs_diff(0).to<USize>())
        jump print()

    // The digits of n fill chars from the right, 19 at a time.
    block print()
        claim buf : @Array<U8, 16640> <- uninit
        chars : @U8 = buf.to<@U8>()
        jump chunk(chars, 16640)

    block chunk(chars: @U8, at: USize)
        done : Bool = n.is_zero()
        branch done
            ? skip_zeros(chars, at)
            : split(chars, at)

    block split(chars: @U8, at: USize)
        low : U64 = n.div_limb(10000000000000000000)  // 10^19
        jump digit(chars, at, low, 19)

    block digit(chars: @U8, at: USize, rest: U64, left: USize)
        done : Bool = left.eq(0)
        branch done
            ? chunk(chars, at)
            : put(chars, at, rest, left)

    block put(chars: @U8, at: USize, rest: U64, left: USize)
        to        : USize = at.sub(1)
        low_digit : U8    = rest.mod(10).to<U8>()
        chars.stride(to).store(low_digit.add(48))
        jump digit(chars, to, rest.div(10), left.sub(1))

    // the top chunk is zero-padded to 19 digits
    block skip_zeros(chars: @U8, at: USize)
        inside : Bool = at.lt(16640)
        branch inside
            ? look(chars, at)
            : lay_out(chars, at)

    block look(chars: @U8, at: USize)
        ascii : U8   = chars.stride(at).load()
        zero  : Bool = ascii.eq(48)
        branch zero
            ? skip_zeros(chars, at.add(1))
            : lay_out(chars, at)

    // n has count digits at chars[first ..]. The last places of them follow the point
    block lay_out(chars: @U8, first: USize)
        count   : USize = 16640.sub(first)
        has_int : Bool  = count.gt(places)
        branch has_int
            ? int_part(chars, first, count.sub(places))
            : zero_int(chars, first)

    block int_part(chars: @U8, first: USize, int_count: USize)
        from : @U8 = chars.stride(first)
        write_digits(out, from, int_count)
        jump fraction(chars, first.add(int_count))

    block zero_int(chars: @U8, first: USize)
        write_str(out, "0")
        jump fraction(chars, first)

    block fraction(chars: @U8, from: USize)
        none : Bool = digits.eq(0)
        branch none
            ? return()
            : point(chars, from)

    block point(chars: @U8, from: USize)
        count : USize = 16640.sub(from)
        write_str(out, ".")
        write_zeros(out, places.sub(count))
        start : @U8 = chars.stride(from)
        write_digits(out, start, count)
        write_zeros(out, digits.sub(places))
        return()

/// represent_fixed_into for a binary float given its IEEE fields: shift is bias +
/// mantissa bits, so a normal value is (1.fraction) × 2^(biased - shift).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param negative: The sign bit.
/// :param fraction: The stored mantissa field.
/// :param biased: The biased exponent field.
/// :param mantissa_bits: The number of stored mantissa bits.
/// :param shift: The bias plus the number of mantissa bits.
/// :param exponent_max: The all-ones exponent field.
/// :param digits: The number of digits after the point.
routine write_binary_fixed<T>(out: @T, negative: Bool, fraction: U128, biased: S64,
    mantissa_bits: U128, shift: S64, exponent_max: S64, digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        special : Bool = biased.eq(exponent_max)
        nan     : Bool = special.bitand(fraction.ne(0))
        when
            nan      -> text("NaN")
            special  -> infinity()
            negative -> minus()
            else     -> magnitude()

    block infinity()
        branch negative
            ? text("-inf")
            : text("inf")

    block text(s: Bytes)
        write_str(out, s)
        return()

    block minus()
        write_str(out, "-")
        jump magnitude()

    block magnitude()
        subnormal : Bool = biased.eq(0)
        implicit  : U128 = 1.shl(mantissa_bits)
        f         : U128 = subnormal
            ? fraction
            : fraction.bitor(implicit)
        e : S64 = subnormal
            ? 1.sub(shift)
            : biased.sub(shift)
        write_float_fixed(out, f, e, digits)
        return()

/// Writes the F64 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine F64.represent_fixed_into<T>(self: Self, out: @T, digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        bits           : U64  = self.bits()
        negative       : Bool = bits.shr(63).eq(1)
        fraction       : U128 = bits.bitand(0x000FFFFFFFFFFFFF).to<U128>()  // 2^52 - 1
        exponent_field : U64  = bits.shr(52).bitand(2047)
        biased         : S64  = exponent_field.to<S64>()
        write_binary_fixed(out, negative, fraction, biased, 52, 1075, 2047, digits)
        return()

/// Writes the F32 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine F32.represent_fixed_into<T>(self: Self, out: @T, digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        bits           : U64  = self.bits().to<U64>()
        negative       : Bool = bits.shr(31).eq(1)
        fraction       : U128 = bits.bitand(0x7FFFFF).to<U128>()  // 2^23 - 1
        exponent_field : U64  = bits.shr(23).bitand(255)
        biased         : S64  = exponent_field.to<S64>()
        write_binary_fixed(out, negative, fraction, biased, 23, 150, 255, digits)
        return()

/// Writes the F16 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine F16.represent_fixed_into<T>(self: Self, out: @T, digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        bits           : U64  = self.bits().to<U64>()
        negative       : Bool = bits.shr(15).eq(1)
        fraction       : U128 = bits.bitand(0x3FF).to<U128>()  // 2^10 - 1
        exponent_field : U64  = bits.shr(10).bitand(31)
        biased         : S64  = exponent_field.to<S64>()
        write_binary_fixed(out, negative, fraction, biased, 10, 25, 31, digits)
        return()

/// Writes the BF16 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine BF16.represent_fixed_into<T>(self: Self, out: @T, digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        bits           : U64  = self.bits().to<U64>()
        negative       : Bool = bits.shr(15).eq(1)
        fraction       : U128 = bits.bitand(0x7F).to<U128>()  // 2^7 - 1
        exponent_field : U64  = bits.shr(7).bitand(255)
        biased         : S64  = exponent_field.to<S64>()
        write_binary_fixed(out, negative, fraction, biased, 7, 134, 255, digits)
        return()

/// Writes the F128 with exactly `digits` digits after the point, correctly rounded from the exact binary value with ties to even. Specials are `inf`, `-inf` and `NaN`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param digits: The number of digits after the point.
routine F128.represent_fixed_into<T>(self: Self, out: @T, digits: USize) -> Void
require T: typename, Writer<T>
    block entry()
        bits     : U128 = self.bits()
        negative : Bool = f128_is_negative_bits(bits)
        fraction : U128 = f128_fraction(bits)
        biased   : S64  = f128_exponent(bits)
        write_binary_fixed(out, negative, fraction, biased, 112, 16495, F128_EXP_MAX, digits)
        return()

// -- views ---------------------------------------------------------------------
//
// A view wraps a value to pick one of its other forms and conforms to Representable, so
// it can go where any representable value goes, represent_with_into included:
//
//     hex: Hex<U32> = Hex<U32> { value: bits }
//     represent_with_into(out, hex, FormatSpec.zero_padded(8))

/// An integer in lowercase hex (represent_hex_into).
record Hex<T>
require T: typename
conform Representable<Hex<T>>
    value : T

/// A float with a fixed number of digits after the point (represent_fixed_into).
record Fixed<T>
require T: typename
conform Representable<Fixed<T>>
    value  : T
    digits : USize

/// Writes the wrapped integer with its `represent_hex_into`.
/// :typeparam T: The wrapped integer type.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Hex<T>.represent_into<TWriter>(self: Self, out: @TWriter) -> Void
require T: typename, TWriter: typename, Writer<TWriter>
    block entry()
        value : T = self.value
        value.represent_hex_into(out)
        return()

/// Writes the wrapped float with its `represent_fixed_into` using `digits`.
/// :typeparam T: The wrapped float type.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Fixed<T>.represent_into<TWriter>(self: Self, out: @TWriter) -> Void
require T: typename, TWriter: typename, Writer<TWriter>
    block entry()
        value  : T     = self.value
        digits : USize = self.digits
        value.represent_fixed_into(out, digits)
        return()

// -- width and alignment -------------------------------------------------------
//
// represent_with_into(out, value, spec) writes any representable value padded to
// spec.width characters. It formats the value twice: once into a CountWriter
// to measure it, then for real, so nothing is buffered and any Representable type
// works. Width counts code points, not terminal columns.

/// Where padding goes when a value is shorter than the requested width.
choice Align: U8
    Left
    Right
    Center
    /// like Right, but the padding goes after a leading - or +: -0042
    AfterSign

/// How `represent_with_into` pads a value: the minimum width in characters, the fill text, and the alignment.
record FormatSpec
    width : USize
    fill  : Bytes
    align : Align

/// Passes writes on to inner, putting pad copies of fill before the first
/// byte, or after it when it is - or +.
record SignPadWriter<T>
require T: typename
conform Writer<SignPadWriter<T>>
    inner : @T
    fill  : Bytes
    pad   : USize

/// Right-aligned to width, padded with spaces.
/// :param width: The minimum width in characters.
/// :returns: The spec.
routine FormatSpec.construct(width: USize) -> Self
    block entry()
        spec : Self = Self { width: width, fill: " ", align: Align.Right }
        return(spec)

/// Padded with zeros after the sign: -7 at 4 is -007.
/// :param width: The minimum width in characters.
/// :returns: The spec.
routine FormatSpec.zero_padded(width: USize) -> Self
    block entry()
        spec : Self = Self { width: width, fill: "0", align: Align.AfterSign }
        return(spec)

/// The same spec with a different alignment.
/// :param align: The new alignment.
/// :returns: A copy of the spec with the new alignment.
routine FormatSpec.with_align(self: Self, align: Align) -> Self
    block entry()
        spec : Self = Self { width: self.width, fill: self.fill, align: align }
        return(spec)

/// The same spec with a different fill: one character (any UTF-8 text works, but width counts it as one).
/// :param fill: The new fill text.
/// :returns: A copy of the spec with the new fill.
routine FormatSpec.with_fill(self: Self, fill: Bytes) -> Self
    block entry()
        spec : Self = Self { width: self.width, fill: fill, align: self.align }
        return(spec)

/// Writes text count times.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param text: The text to write.
/// :param count: How many times to write it.
routine write_repeated<T>(out: @T, text: Bytes, count: USize) -> Void
require T: typename, Writer<T>
    block entry()
        jump loop(count)

    block loop(left: USize)
        done : Bool = left.eq(0)
        branch done
            ? return()
            : one(left)

    block one(left: USize)
        write_str(out, text)
        jump loop(left.sub(1))

/// Writes `value` padded to at least `spec.width` characters. The value is formatted twice, once into a `CountWriter` to measure it and once for real, so nothing is buffered. A value already as wide as the spec is written unpadded.
/// :typeparam TValue: The type of the value, which must conform to {Representable}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param value: The value to write.
/// :param spec: The width, fill and alignment to apply.
routine represent_with_into<TValue, TWriter>(out: @TWriter, value: TValue, spec: FormatSpec) -> Void
require TValue: typename, TWriter: typename, Writer<TWriter>, Representable<TValue>
    shared fill : Bytes = spec.fill

    block entry()
        claim counter : @CountWriter <- .construct()
        value.represent_into(counter)
        count : USize = counter.count.load()
        pad   : USize = spec.width.sub_clamp(count)
        half  : USize = pad.div(2)
        align : Align = spec.align
        when align
            Align.Left      -> padded(0, pad)
            Align.Right     -> padded(pad, 0)
            Align.Center    -> padded(half, pad.sub(half))
            Align.AfterSign -> after_sign(pad)

    block padded(before: USize, after: USize)
        write_repeated(out, fill, before)
        value.represent_into(out)
        write_repeated(out, fill, after)
        return()

    block after_sign(pad: USize)
        claim inner : @SignPadWriter<TWriter> <- SignPadWriter<TWriter> { inner: out, fill: fill,
            pad: pad }
        value.represent_into(inner)
        return()

/// Writes the first bytes after the padding, or after a leading `-` or `+`, and passes every later write straight through.
/// :typeparam T: The inner Writer type.
/// :param bytes: The bytes being written.
/// :param count: The number of bytes.
routine SignPadWriter<T>.write_bytes(self: @Self, bytes: @Byte, count: USize) -> Void
require T: typename, Writer<T>
    shared inner : @T    = self.inner.load()
    shared pad   : USize = self.pad.load()

    block entry()
        first : Bool = pad.gt(0).bitand(count.gt(0))
        branch first
            ? first()
            : pass(bytes, count)

    block first()
        fill : Bytes = self.fill.load()
        self.pad.store(0)
        byte   : U8   = Byte.to<U8>(bytes.stride(0).load())
        signed : Bool = byte.eq(45).bitor(byte.eq(43))  // - or +
        branch signed
            ? sign(fill)
            : pad(fill, bytes, count)

    block sign(fill: Bytes)
        inner.write_bytes(bytes, 1)
        rest : @Byte = bytes.stride(1)
        jump pad(fill, rest, count.sub(1))

    block pad(fill: Bytes, from: @Byte, left: USize)
        write_repeated(inner, fill, pad)
        jump pass(from, left)

    block pass(from: @Byte, left: USize)
        inner.write_bytes(from, left)
        return()
