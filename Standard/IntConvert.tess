// Tessera stdlib: reading integers from text
//
// text.to_result<T>() reads a decimal integer for every built-in integer type: an optional '+' or '-', then one or
// more digits, and nothing else (no spaces, no '_', no "0x"). The digits are gathered into a U256, so any text that
// fits a U256 is read before the range is checked, and a type's most negative value reads too ("-128" as S8).
// text.to<T>() (Standard/Parsable.tess) is the same conversion, and it crashes on bad text.
//
// For the text "-42", text.to_result<S32>() is .Success(-42). "200" as an S8 and "-1" as a U32 are
// .Failure(.OutOfRange), "" is .Failure(.Empty), and "12a" is .Failure(.Invalid).

module Standard::Format

/// The sign and the digits' value.
private record IntParts
    negative  : Bool
    magnitude : U256

/// Reads an optional `+` or `-` and then one or more decimal digits into a sign and a U256 magnitude.
/// :param text: The text to read.
/// :returns: `Success` with the sign and magnitude, or `Failure` with the reason.
/// :throws: Fails with `Empty` for no digits, `Invalid` for any other character, and `OutOfRange` when the digits overflow a U256.
private routine parse_int_parts(text: Bytes) -> Result<IntParts, ParseError>
    block entry()
        branch text.is_empty()
            ? return(.Failure(ParseError.Empty))
            : continue
        first : U8 = text.byte_at(0)
        // '-' and '+'
        when
            first.eq(45) -> digits(true, 1)
            first.eq(43) -> digits(false, 1)
            else         -> digits(false, 0)

    block digits(negative: Bool, start: USize)
        branch start.eq(text.count())
            ? return(.Failure(ParseError.Empty))
            : next(negative, start, 0)

    block next(negative: Bool, i: USize, value: U256)
        branch i.eq(text.count())
            ? return(.Success(IntParts { negative: negative, magnitude: value }))
            : continue
        c : U8 = text.byte_at(i)
        branch c.between(48, 57)
            ? continue
            : return(.Failure(ParseError.Invalid))
        times : Option<U256> = value.mul_checked(10)
        when times
            .Present(t) -> add(negative, i, t, c.sub(48).to<U256>())
            .Absent     -> return(.Failure(ParseError.OutOfRange))

    block add(negative: Bool, i: USize, t: U256, digit: U256)
        sum : Option<U256> = t.add_checked(digit)
        when sum
            .Present(s) -> next(negative, i.add(1), s)
            .Absent     -> return(.Failure(ParseError.OutOfRange))

/// `value` as a Success, or OutOfRange when it is Absent.
/// :typeparam T: The integer type.
/// :param value: The converted value, Absent when it did not fit.
/// :returns: `Success` with the value, or `Failure(ParseError.OutOfRange)`.
private routine in_range<T>(value: Option<T>) -> Result<T, ParseError>
require T: typename
    block entry()
        when value
            .Present(v) -> return(.Success(v))
            .Absent     -> return(.Failure(ParseError.OutOfRange))

/// The text as a decimal S8, with an optional sign.
/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<S8>(self: Self) -> Result<S8, ParseError>
    block entry()
        parts : Result<IntParts, ParseError> = parse_int_parts(self)
        when parts
            .Success(p)     -> continue
            .Failure(error) -> return(.Failure(error))
        branch p.negative.bitand(p.magnitude.gt(0))
            ? negative(p.magnitude)
            : return(in_range<S8>(p.magnitude.to_checked<S8>()))

    // -(m - 1) - 1: the most negative value's magnitude is one past the most positive value.
    block negative(m: U256)
        less : Option<S8> = m.sub(1).to_checked<S8>()
        when less
            .Present(v) -> return(.Success(v.neg().sub(1)))
            .Absent     -> return(.Failure(ParseError.OutOfRange))

