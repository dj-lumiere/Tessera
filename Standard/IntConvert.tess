/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<U16>(self: Self) -> Result<U16, ParseError>
    block entry()
        parts : Result<IntParts, ParseError> = parse_int_parts(self)
        when parts
