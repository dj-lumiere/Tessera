// Tessera stdlib: reading integers from text
//
// text.to_result[T]() reads a decimal integer for every built-in integer type: an optional '+' or '-', then one or
// more digits, and nothing else (no spaces, no '_', no "0x"). The digits are gathered into a U256, so any text that
// fits a U256 is read before the range is checked, and a type's most negative value reads too ("-128" as S8).
// text.to[T]() (Standard/Parsable.tess) is the same conversion, and it crashes on bad text.
//
// For the text "-42", text.to_result[S32]() holds -42. "200" as an S8 and "-1" as a U32 are
// ParseError.OUT_OF_RANGE, "" is ParseError.EMPTY, and "12a" is ParseError.INVALID.

module Standard/Format

/// The sign and the digits' value.
private record IntParts
    negative: Bool
    magnitude: U256

/// Reads an optional `+` or `-` and then one or more decimal digits into a sign and a U256 magnitude.
/// :param text: The text to read.
/// :returns: The sign and magnitude, or the reason.
/// :throws: Fails with `Empty` for no digits, `Invalid` for any other character, and `OutOfRange` when the digits overflow a U256.
private routine parse_int_parts(text: Span[Byte]) -> Result[IntParts, ParseError]
    branch text.is_empty()
        ? return(ParseError.EMPTY)
        : continue
    first: U8 = text.byte_at(0)
    // '-' and '+'
    when
        first.eq(45) => digits(true, 1)
        first.eq(43) => digits(false, 1)
        else => digits(false, 0)

    block digits(negative: Bool, start: USize)
        branch start.eq(text.count())
            ? return(ParseError.EMPTY)
            : next(negative, start, 0)

    block next(negative: Bool, i: USize, value: U256)
        branch i.eq(text.count())
            ? return(IntParts(negative: negative, magnitude: value))
            : continue
        c: U8 = text.byte_at(i)
        branch c.between(lo: 48, hi: 57)
            ? continue
            : return(ParseError.INVALID)
        times: Maybe[U256] = value.mul_checked(10)
        when times
            is U256 as t => add(negative, i, t, c.sub(48).to[U256]())
            is Unit => return(ParseError.OUT_OF_RANGE)

    block add(negative: Bool, i: USize, t: U256, digit: U256)
        sum: Maybe[U256] = t.add_checked(digit)
        when sum
            is U256 as s => next(negative, i.add(1), s)
            is Unit => return(ParseError.OUT_OF_RANGE)

/// `value`, or OUT_OF_RANGE when it is Unit.
/// :typeparam T: The integer type.
/// :param value: The converted value, Unit when it did not fit.
/// :returns: The value, or `ParseError.OUT_OF_RANGE`.
private routine in_range[T](value: Maybe[T]) -> Result[T, ParseError]
require T: typename
    when value
        is T as v => return(v)
        is Unit => return(ParseError.OUT_OF_RANGE)

/// The text as a decimal S8, with an optional sign.
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[S8](me: Me) -> Result[S8, ParseError]
    parts: Result[IntParts, ParseError] = parse_int_parts(me)
    when parts
        is IntParts as p => continue
        is ParseError as error => return(error)
    branch p.negative.bitand(p.magnitude.gt(0))
        ? negative(p.magnitude)
        : return(in_range[S8](p.magnitude.to_checked[S8]()))

    // -(m - 1) - 1: the most negative value's magnitude is one past the most positive value.
    block negative(m: U256)
        less: Maybe[S8] = m.sub(1).to_checked[S8]()
        when less
            is S8 as v => return(v.neg().sub(1))
            is Unit => return(ParseError.OUT_OF_RANGE)

