/// The text as a decimal U8, with an optional '+' ("-0" reads as 0).
/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<U8>(self: Self) -> Result<U8, ParseError>
    block entry()
        parts : Result<IntParts, ParseError> = parse_int_parts(self)
        when parts
            .Success(p)     -> continue
            .Failure(error) -> return(.Failure(error))
        branch p.negative.bitand(p.magnitude.gt(0))
            ? return(.Failure(ParseError.OutOfRange))
            : return(in_range<U8>(p.magnitude.to_checked<U8>()))

