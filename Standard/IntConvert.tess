/// The text as a decimal U8, with an optional '+' ("-0" reads as 0).
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[U8](me: Me) -> Result[U8, ParseError]
    parts: Result[IntParts, ParseError] = parse_int_parts(me)
    when parts
        is IntParts as p => continue
        is ParseError as error => return(error)
    branch p.negative.bitand(p.magnitude.gt(0))
        ? return(ParseError.OUT_OF_RANGE)
        : return(in_range[U8](p.magnitude.to_checked[U8]()))

/// The text as a decimal U16, with an optional '+' ("-0" reads as 0).
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[U16](me: Me) -> Result[U16, ParseError]
    parts: Result[IntParts, ParseError] = parse_int_parts(me)
    when parts
        is IntParts as p => continue
        is ParseError as error => return(error)
