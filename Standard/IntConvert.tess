/// The text as a decimal U64, with an optional '+' ("-0" reads as 0).
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[U64](me: Me) -> Result[U64, ParseError]
    parts: Result[IntParts, ParseError] = parse_int_parts(me)
    when parts
        is IntParts as p => continue
        is ParseError as error => return(error)
    branch p.negative.bitand(p.magnitude.gt(0))
        ? return(ParseError.OUT_OF_RANGE)
        : return(in_range[U64](p.magnitude.to_checked[U64]()))

/// The text as a decimal U128, with an optional '+' ("-0" reads as 0).
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[U128](me: Me) -> Result[U128, ParseError]
    parts: Result[IntParts, ParseError] = parse_int_parts(me)
    when parts
        is IntParts as p => continue
        is ParseError as error => return(error)
    branch p.negative.bitand(p.magnitude.gt(0))
        ? return(ParseError.OUT_OF_RANGE)
        : return(in_range[U128](p.magnitude.to_checked[U128]()))

/// The text as a decimal U256, with an optional '+' ("-0" reads as 0).
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[U256](me: Me) -> Result[U256, ParseError]
    parts: Result[IntParts, ParseError] = parse_int_parts(me)
    when parts
        is IntParts as p => continue
        is ParseError as error => return(error)
    branch p.negative.bitand(p.magnitude.gt(0))
        ? return(ParseError.OUT_OF_RANGE)
        : return(p.magnitude)

/// The text as a decimal SSize, with an optional sign: read as an S64, then narrowed.
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[SSize](me: Me) -> Result[SSize, ParseError]
    wide: Result[S64, ParseError] = me.to_result[S64]()
    when wide
        is S64 as v => return(in_range[SSize](v.to_checked[SSize]()))
        is ParseError as error => return(error)

/// The text as a decimal USize, with an optional '+': read as an U64, then narrowed.
/// :returns: The value, or the error `Empty`, `Invalid`, or `OutOfRange`.
routine Span[Byte].to_result[USize](me: Me) -> Result[USize, ParseError]
    wide: Result[U64, ParseError] = me.to_result[U64]()
    when wide
        is U64 as v => return(in_range[USize](v.to_checked[USize]()))
        is ParseError as error => return(error)
