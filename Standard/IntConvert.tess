/// The text as a decimal U128, with an optional '+' ("-0" reads as 0).
/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<U128>(self: Self) -> Result<U128, ParseError>
    block entry()
        parts : Result<IntParts, ParseError> = parse_int_parts(self)
        when parts
            .Success(p)     -> continue
            .Failure(error) -> return(.Failure(error))
        branch p.negative.bitand(p.magnitude.gt(0))
            ? return(.Failure(ParseError.OutOfRange))
            : return(in_range<U128>(p.magnitude.to_checked<U128>()))

/// The text as a decimal U256, with an optional '+' ("-0" reads as 0).
/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<U256>(self: Self) -> Result<U256, ParseError>
    block entry()
        parts : Result<IntParts, ParseError> = parse_int_parts(self)
        when parts
            .Success(p)     -> continue
            .Failure(error) -> return(.Failure(error))
        branch p.negative.bitand(p.magnitude.gt(0))
            ? return(.Failure(ParseError.OutOfRange))
            : return(.Success(p.magnitude))

/// The text as a decimal SSize, with an optional sign: read as an S64, then narrowed.
/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<SSize>(self: Self) -> Result<SSize, ParseError>
    block entry()
        wide : Result<S64, ParseError> = self.to_result<S64>()
        when wide
            .Success(v)     -> return(in_range<SSize>(v.to_checked<SSize>()))
            .Failure(error) -> return(.Failure(error))

/// The text as a decimal USize, with an optional '+': read as an U64, then narrowed.
/// :returns: `Success` with the value, or `Failure` with `Empty`, `Invalid`, or `OutOfRange`.
routine Bytes.to_result<USize>(self: Self) -> Result<USize, ParseError>
    block entry()
        wide : Result<U64, ParseError> = self.to_result<U64>()
        when wide
            .Success(v)     -> return(in_range<USize>(v.to_checked<USize>()))
            .Failure(error) -> return(.Failure(error))
