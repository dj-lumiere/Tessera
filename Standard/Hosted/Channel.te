# Tessera stdlib: channels
#
# A channel carries values from transmitters to receivers in the order they were transmitted, through room for a fixed
# number of them. `Channel[T]` has one receiver and `SharedChannel[T]` any number, each value going to one of them.
# Both live in memory the threads and fibers that use them share (`@Channel[T]`):
#
#     claim jobs: @Channel[U64] <- .construct(capacity: 16)
#     jobs.transmit(42)   # waits while the room is full
#     got: Check[U64] = check jobs.receive()   # waits while it is empty
#
# A transmitter that waits for room, or a receiver that waits for a value, sleeps if it is a thread and parks if it is
# a fiber: the other fibers of its thread go on, and the other side wakes it. `transmit_if_room` doesn't wait. A
# channel starts with one transmitter and one receiver: `add_transmitter` (and `add_receiver` on a SharedChannel)
# counts another, and each says it is done with `close_transmitting` or `close_receiving`. Once every transmitter has
# closed, receivers take what is left and then get `ChannelClosedError`. Once every receiver has closed, the values
# left are dropped and transmitters get `ChannelClosedError`. Values that own memory are taken out and released by a
# receiver before it closes. A wait also ends
# with `CancelRequested` when the work that waits is asked to stop with `cancel()`.

module Hosted

### What a transmit or a receive throws when the other side has closed for good: every receiver, or every
### transmitter with no value left.
crashable ChannelClosedError
    nothing

### One transmitter or receiver waiting on a channel, on the frame of the routine that waits.
secret record ChannelWait
    waiter: Waiter
    next: @ChannelWait

### What both kinds of channel are: a ring of values under one exclusive access, the open transmitters and receivers, and who waits.
### :typeparam T: The type of the values.
secret entity ChannelCore[T]
    ### The byte whose exclusive access guards every field below.
    guard: U8
    ### Room for `capacity` values, a ring.
    items: BorrowedSlice[T]
    ### Where the oldest value is.
    head: U64
    ### How many values there are.
    count: U64
    ### The transmitters that haven't closed.
    transmitters: U32
    ### The receivers that haven't closed.
    receivers: U32
    ### Receivers waiting for a value.
    getters: @ChannelWait
    ### Transmitters waiting for room.
    putters: @ChannelWait

### A channel with one receiver: values from any number of transmitters, in order, through room for a fixed number.
### :typeparam T: The type of the values.
entity Channel[T]
    core: ChannelCore[T]

### A channel with any number of receivers, each value going to one of them.
### :typeparam T: The type of the values.
entity SharedChannel[T]
    core: ChannelCore[T]

### Writes `The channel is closed.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine ChannelClosedError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The channel is closed: no one is left on the other side.")
    return

### An empty channel core with room for `capacity` values from `manager`, one transmitter and one receiver.
### :param capacity: How many values it holds at most, at least 1.
### :param manager: Where the room comes from.
### :returns: The core.
### :throws: Crashes with `UnacceptedValueError` for a capacity of 0, and with `OutOfMemoryError` when `manager` has no
###     memory to give.
@track_caller
common routine ChannelCore[T].construct(capacity: U64, manager: @MemoryManager) -> Me
    if capacity == 0
        throw UnacceptedValueError(description: "A channel needs room for at least one value.")
    return Me(guard: 0, items: .construct(count: capacity, manager: manager), head: 0, count: 0,
        transmitters: 1, receivers: 1, getters: .hollow(), putters: .hollow())

### An empty channel with room for `capacity` values from `manager`, one transmitter and one receiver.
### :param capacity: How many values it holds at most, at least 1.
### :param manager: Where the room comes from.
### :returns: The channel.
### :throws: Crashes with `UnacceptedValueError` for a capacity of 0, and with `OutOfMemoryError` when `manager` has no
###     memory to give.
@track_caller
common routine Channel[T].construct(capacity: U64, manager: @MemoryManager) -> Me
    return Me(core: .construct(capacity, manager))

### An empty channel with room for `capacity` values from HEAP, one transmitter and one receiver.
### :param capacity: How many values it holds at most, at least 1.
### :returns: The channel.
### :throws: Crashes with `UnacceptedValueError` for a capacity of 0, and with `OutOfMemoryError` when there is no
###     memory for it.
@target(os: not "none")
@track_caller
common routine Channel[T].construct(capacity: U64) -> Me
    return Me(core: .construct(capacity, manager: HEAP))

### An empty shared channel with room for `capacity` values from `manager`, one transmitter and one receiver.
### :param capacity: How many values it holds at most, at least 1.
### :param manager: Where the room comes from.
### :returns: The channel.
### :throws: Crashes with `UnacceptedValueError` for a capacity of 0, and with `OutOfMemoryError` when `manager` has no
###     memory to give.
@track_caller
common routine SharedChannel[T].construct(capacity: U64, manager: @MemoryManager) -> Me
    return Me(core: .construct(capacity, manager))

### An empty shared channel with room for `capacity` values from HEAP, one transmitter and one receiver.
### :param capacity: How many values it holds at most, at least 1.
### :returns: The channel.
### :throws: Crashes with `UnacceptedValueError` for a capacity of 0, and with `OutOfMemoryError` when there is no
###     memory for it.
@target(os: not "none")
@track_caller
common routine SharedChannel[T].construct(capacity: U64) -> Me
    return Me(core: .construct(capacity, manager: HEAP))

# -- the two kinds, through the core ------------------------------------------------------------------------------

### Transmits `value`, waiting while the room is full.
### :param value: The value.
###     waits is asked to stop first.
@target(os: not "none")
failable routine @Channel[T].transmit(value: T) -> None
    when check me.core.transmit(value)
        is None => return

### Transmits `value` if there is room, without waiting.
### :param value: The value.
### :returns: True when it went in, false when the room is full or every receiver has closed.
@target(os: not "none")
routine @Channel[T].transmit_if_room(value: T) -> Bool
    return me.core.transmit_if_room(value)

### Takes the oldest value, waiting while there is none.
### :returns: The value, `ChannelClosedError` when every transmitter has closed and no value is left, or
###     `CancelRequested` when the work that waits is asked to stop first.
@target(os: not "none")
failable routine @Channel[T].receive() -> T
    when check me.core.receive()
        is T as returned => return returned

### Counts one more transmitter, which closes on its own.
@target(os: not "none")
routine @Channel[T].add_transmitter() -> None
    me.core.add_transmitter()
    return

### One transmitter is done. Once every transmitter is, the receiver takes what is left and then gets
### `ChannelClosedError`.
@target(os: not "none")
routine @Channel[T].close_transmitting() -> None
    me.core.close_transmitting()
    return

### The receiver is done: the values left are dropped, and transmitters get `ChannelClosedError`.
@target(os: not "none")
routine @Channel[T].close_receiving() -> None
    me.core.close_receiving()
    return

### Transmits `value`, waiting while the room is full.
### :param value: The value.
###     waits is asked to stop first.
@target(os: not "none")
failable routine @SharedChannel[T].transmit(value: T) -> None
    when check me.core.transmit(value)
        is None => return

### Transmits `value` if there is room, without waiting.
### :param value: The value.
### :returns: True when it went in, false when the room is full or every receiver has closed.
@target(os: not "none")
routine @SharedChannel[T].transmit_if_room(value: T) -> Bool
    return me.core.transmit_if_room(value)

### Takes the oldest value, waiting while there is none. Each value goes to one receiver.
### :returns: The value, `ChannelClosedError` when every transmitter has closed and no value is left, or
###     `CancelRequested` when the work that waits is asked to stop first.
@target(os: not "none")
failable routine @SharedChannel[T].receive() -> T
    when check me.core.receive()
        is T as returned => return returned

### Counts one more transmitter, which closes on its own.
@target(os: not "none")
routine @SharedChannel[T].add_transmitter() -> None
    me.core.add_transmitter()
    return

### Counts one more receiver, which closes on its own.
@target(os: not "none")
routine @SharedChannel[T].add_receiver() -> None
    me.core.add_receiver()
    return

### One transmitter is done. Once every transmitter is, receivers take what is left and then get `ChannelClosedError`.
@target(os: not "none")
routine @SharedChannel[T].close_transmitting() -> None
    me.core.close_transmitting()
    return

### One receiver is done. Once every receiver is, the values left are dropped, and transmitters get `ChannelClosedError`.
@target(os: not "none")
routine @SharedChannel[T].close_receiving() -> None
    me.core.close_receiving()
    return

# -- the core -----------------------------------------------------------------------------------------------------

### Transmits `value`, waiting while the room is full.
### :param value: The value.
@target(os: not "none")
failable routine @ChannelCore[T].transmit(value: T) -> None
    waiter: Waiter = current_waiter()
    node: &ChannelWait <- ChannelWait(waiter, next: .hollow())

    loop
        held: Authorized[U8] <- me.guard.get_exclusive_access()
        if me.receivers.peek() == 0
            drop held
            throw ChannelClosedError()
        if me.count.peek() < me.items.count()
            me.push(value)
            drop held
            return
        node.next.poke(me.putters.peek())
        me.putters.poke(node)
        drop held
        if blocked_until_cancelled(waiter)
            held2: Authorized[U8] <- me.guard.get_exclusive_access()
            unlink(list: me.putters, node)
            drop held2
            throw CancelRequested()
        waiter.park()
        held3: Authorized[U8] <- me.guard.get_exclusive_access()
        unlink(list: me.putters, node)
        drop held3

### Transmits `value` if there is room, without waiting.
### :param value: The value.
### :returns: True when it went in.
@target(os: not "none")
routine @ChannelCore[T].transmit_if_room(value: T) -> Bool
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    if not (me.receivers.peek() != 0 and me.count.peek() < me.items.count())
        drop held
        return false
    me.push(value)
    drop held
    return true

### Takes the oldest value, waiting while there is none.
### :returns: The value, `ChannelClosedError`, or `CancelRequested`.
@target(os: not "none")
failable routine @ChannelCore[T].receive() -> T
    waiter: Waiter = current_waiter()
    node: &ChannelWait <- ChannelWait(waiter, next: .hollow())

    loop
        held: Authorized[U8] <- me.guard.get_exclusive_access()
        if me.count.peek() != 0
            value: T = me.pop()
            drop held
            return value
        if me.transmitters.peek() == 0
            drop held
            throw ChannelClosedError()
        node.next.poke(me.getters.peek())
        me.getters.poke(node)
        drop held
        if blocked_until_cancelled(waiter)
            held2: Authorized[U8] <- me.guard.get_exclusive_access()
            unlink(list: me.getters, node)
            drop held2
            throw CancelRequested()
        waiter.park()
        held3: Authorized[U8] <- me.guard.get_exclusive_access()
        unlink(list: me.getters, node)
        drop held3

### Counts one more transmitter.
@target(os: not "none")
routine @ChannelCore[T].add_transmitter() -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    me.transmitters.poke(me.transmitters.peek() + 1)
    drop held
    return

### Counts one more receiver.
@target(os: not "none")
routine @ChannelCore[T].add_receiver() -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    me.receivers.poke(me.receivers.peek() + 1)
    drop held
    return

### One transmitter is done: once every transmitter is, the waiting receivers wake to take what is left.
### :throws: Crashes with `UnacceptedValueError` when every transmitter has closed already.
@target(os: not "none")
@track_caller
routine @ChannelCore[T].close_transmitting() -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    if me.transmitters.peek() == 0
        throw UnacceptedValueError(description: "Every transmitter of this channel has closed already.")
    me.transmitters.poke(me.transmitters.peek() - 1)
    wake_list(me.getters.peek())
    drop held
    return

### One receiver is done: once every receiver is, the values left are dropped and the waiting transmitters wake.
### :throws: Crashes with `UnacceptedValueError` when every receiver has closed already.
@target(os: not "none")
@track_caller
routine @ChannelCore[T].close_receiving() -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    if me.receivers.peek() == 0
        throw UnacceptedValueError(description: "Every receiver of this channel has closed already.")
    me.receivers.poke(me.receivers.peek() - 1)
    if me.receivers.peek() == 0
        me.count.poke(0)
        wake_list(me.putters.peek())
    drop held
    return

### Puts `value` behind the others and wakes the waiting receivers. The lock is held and there is room.
### :param value: The value.
@target(os: not "none")
secret routine @ChannelCore[T].push(value: T) -> None
    capacity: U64 = me.items.count()
    at: U64 = (me.head.peek() + me.count.peek()) % capacity
    me.items.getslot(at).poke(steal value)
    me.count.poke(me.count.peek() + 1)
    wake_list(me.getters.peek())
    return

### Takes the oldest value and wakes the waiting transmitters. The lock is held and there is a value.
### :returns: The value.
@target(os: not "none")
secret routine @ChannelCore[T].pop() -> T
    head: U64 = me.head.peek()
    # A ring of places: the count kept beside it says which hold a value, so the place is reached as raw memory.
    value: T = steal me.items.to[@T]().stride(head)
    me.head.poke((head + 1) % me.items.count())
    me.count.poke(me.count.peek() - 1)
    wake_list(me.putters.peek())
    return value

### Wakes every waiter in the list. Each takes itself out when it runs again.
### :param first: The first waiting node, or null.
@target(os: not "none")
secret routine wake_list(first: @ChannelWait) -> None
    until node.is_hollow() with node: @ChannelWait = first
        node.waiter.peek().wake()
        continue with node: node.next.peek()
    then
        return

### Takes `node` out of the list at `list`, if it is there.
### :param list: The place of the list's first node.
### :param node: The node.
@target(os: not "none")
secret routine unlink(list: @@ChannelWait, node: @ChannelWait) -> None
    loop with link: @@ChannelWait = list
        current2: @ChannelWait = link.peek()
        if current2.is_hollow()
            return
        if current2 === node
            link.poke(node.next.peek())
            node.next.poke(.hollow())
            return
        continue with link: current2.next
