# Tessera stdlib: OsEntropy, the operating system's random source, and the hash key drawn from it
#
# OsEntropy fills memory with secret random bits from the OS: getrandom on Linux, arc4random_buf on macOS, and
# ProcessPrng (what BCryptGenRandom draws from, Windows 10 and later) on Windows. Every stdlib `hash()` is SipHash-2-4
# under one per-process key (HashKey.te in System), which asks the program's `tessera_hash_key` for it the
# first time something hashes. With an operating system this is that routine: 128 bits from OsEntropy. A program
# replaces it by exporting its own routine under the same name, as it replaces the crash handler.
# `Xoshiro256.from_entropy()` draws from the same source through `entropy_key()`.

module Hosted

### Linux's EINTR: a signal arrived before getrandom had its bytes (only while the kernel's pool is still filling).
@target(os: "linux")
secret preset EINTR: CInt = 4

### The operating system's random source: secret random bits, for keys and seeds. Its routines are called on the type.
record OsEntropy
    nothing

### Binds the C `getrandom` function (glibc 2.25 and later, musl), which fills a buffer from the kernel's random source.
### :param buffer: Where the random bytes go.
### :param count: How many bytes to fill.
### :param flags: The `GRND_*` flags (0 waits until the random pool is first filled).
### :returns: The number of bytes written, or -1 with `errno` set.
@external("c")
@symbol("getrandom")
@target(os: "linux")
secret routine c_getrandom(buffer: Addr, count: CSize, flags: U32) -> CSSize

### Binds the C `__errno_location` function.
### :returns: The address of the calling thread's `errno`.
@external("c")
@symbol("__errno_location")
@target(os: "linux")
secret routine c_random_errno_place() -> @CInt

### Binds the C `arc4random_buf` function, which fills a buffer with random bytes and can't fail.
### :param buffer: Where the random bytes go.
### :param count: How many bytes to fill.
@external("c")
@symbol("arc4random_buf")
@target(os: "macos")
secret routine c_arc4random_buf(buffer: Addr, count: CSize) -> None

### Binds the Win32 `LoadLibraryA` function, which loads a DLL into the process.
### :param name: The DLL's file name.
### :returns: The module handle, or null when the DLL can't be loaded.
@external("c")
@symbol("LoadLibraryA")
@callconv("stdcall")
@target(os: "windows")
secret routine c_load_library(name: CStrView) -> Addr

### Binds the Win32 `GetProcAddress` function, which looks up an exported function in a loaded DLL.
### :param library: The module handle from `LoadLibraryA`.
### :param name: The exported function's name.
### :returns: The function's address, or null when the DLL doesn't export it.
@external("c")
@symbol("GetProcAddress")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_proc_address(library: Addr, name: CStrView) -> Addr

### Fills count bytes at buffer with random bits from getrandom, which waits only until the kernel's random pool is
### first filled.
### :param buffer: Where the bytes go.
### :param count: How many bytes to fill.
### :throws: Crashes with `UnacceptedValueError` when getrandom fails (a kernel older than 3.17, or a seccomp filter),
###     instead of handing back bytes that aren't random.
@target(os: "linux")
common routine OsEntropy.fill(buffer: Addr, count: U64) -> None
    # A signal that interrupts the wait (EINTR) asks for the rest again, and a large request may come in parts.
    until filled >= count with filled: U64 = 0
        got: S64 = c_getrandom(buffer.to[@Byte]().stride(filled), (count - filled).to[CSize](),
            0).to[S64]()
        if got > 0
            continue with filled: filled + got.to[U64]()
        if c_random_errno_place().peek() == EINTR
            continue with filled: filled
        throw UnacceptedValueError(description: "getrandom gave no random bytes.")
    then
        return

### Fills count bytes at buffer with random bits from arc4random_buf, which can't fail.
### :param buffer: Where the bytes go.
### :param count: How many bytes to fill.
@target(os: "macos")
common routine OsEntropy.fill(buffer: Addr, count: U64) -> None
    c_arc4random_buf(buffer, count.to[CSize]())
    return

### Fills count bytes at buffer with random bits from ProcessPrng in bcryptprimitives.dll, looked up at run time so
### that no import library is needed (it has none before the Windows 11 SDK).
### :param buffer: Where the bytes go.
### :param count: How many bytes to fill.
### :throws: Crashes with `UnacceptedValueError` when bcryptprimitives.dll has no ProcessPrng (Windows before 10).
@target(os: "windows")
common routine OsEntropy.fill(buffer: Addr, count: U64) -> None
    library: Addr = c_load_library("bcryptprimitives.dll")
    found: Addr = c_get_proc_address(library, "ProcessPrng")
    if found.is_hollow()
        throw UnacceptedValueError(description: "bcryptprimitives.dll has no ProcessPrng for random bytes (Windows 10 or later).")
    place: &Addr <- found

    # ProcessPrng takes the count as a SIZE_T, 32 bits on 32-bit Windows, and pops its own arguments.
    prng: Callable[@callconv("stdcall"), (Addr, CSize), CInt] = place.to[@Callable[@callconv("stdcall"), (Addr, CSize), CInt]]().peek()
    prng.call(buffer, count.to[CSize]())
    return

### 64 fresh random bits from the OS, drawn anew on every call: `OsEntropy.next[U64]()`.
### :returns: The random word.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[U64]() -> U64
    word: &U64 <- 0

    Me.fill(buffer: word, count: 8)
    return word.load()

### A random S64 over its full range from the OS.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[S64]() -> S64
    return Me.next[U64]().to_wrap[S64]()

### A random U8 over its full range from the OS: the high 8 bits of a 64-bit draw.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[U8]() -> U8
    return (Me.next[U64]() >> 56).to_wrap[U8]()

### A random U16 over its full range from the OS: the high 16 bits of a 64-bit draw.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[U16]() -> U16
    return (Me.next[U64]() >> 48).to_wrap[U16]()

### A random U32 over its full range from the OS: the high 32 bits of a 64-bit draw.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[U32]() -> U32
    return (Me.next[U64]() >> 32).to_wrap[U32]()

### A random S8 over its full range from the OS: the high 8 bits of a 64-bit draw.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[S8]() -> S8
    return (Me.next[U64]() >> 56).to_wrap[S8]()

### A random S16 over its full range from the OS: the high 16 bits of a 64-bit draw.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[S16]() -> S16
    return (Me.next[U64]() >> 48).to_wrap[S16]()

### A random S32 over its full range from the OS: the high 32 bits of a 64-bit draw.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[S32]() -> S32
    return (Me.next[U64]() >> 32).to_wrap[S32]()

### A random U128 over its full range from the OS: two 64-bit draws, the first the high half.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[U128]() -> U128
    high: U64 = Me.next[U64]()
    low: U64 = Me.next[U64]()
    return (high.to[U128]() << 64) | low.to[U128]()

### A random S128 over its full range from the OS: the bits of `next[U128]()`.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[S128]() -> S128
    return Me.next[U128]().to_wrap[S128]()

### A random double in [0, 1) from the OS: the top 53 bits of a 64-bit draw times 2^-53.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[B64]() -> B64
    top: B64 = (Me.next[U64]() >> 11).to[B64]()
    return top * B64.from_bits(0x3CA0000000000000)

### A random float in [0, 1) from the OS: the top 24 bits of a 64-bit draw times 2^-24.
### :returns: The random value.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
common routine OsEntropy.next[B32]() -> B32
    top: B32 = (Me.next[U64]() >> 40).to[B32]()
    return top * B32.from_bits(0x33800000)

### The hosted hash key: 16 bytes from {OsEntropy.fill}.
### :param key: Where the key goes.
### :throws: Crashes with `UnacceptedValueError` when the OS gives no random bytes.
@export("tessera_hash_key")
routine os_hash_key(key: @SipKey) -> None
    OsEntropy.fill(buffer: key, count: 16)
    return
