# Tessera stdlib: the console: the process's standard input, output, and error
#
# Console is what a program uses: Console.show and Console.alert write a line to standard output and standard error
# (the builder expands their template, as for a Writer's write), and the ask routines read standard input. Behind it
# are three types, one per stream, so a stream is only read or only written: ConsoleOutput and ConsoleErrors are
# Writers (write_all writes bytes, and nothing is buffered, a BufWriter[ConsoleOutput] is the caller's choice),
# and ConsoleInput is a Reader. Standard input is read through one buffer the whole process shares, behind one exclusive access:
# standard input is one stream, and two buffers over it would each take bytes the other should have had, so
# read_into, ask_bytes, ask_word, ask_line, and ask_all all draw on that one. Console.ask[T]() reads a number
# (any Parsable type) from the next word in place, without allocating unless the word is longer than the buffer.
# ask[T], ask_word, and ask_line are failable: they throw EndOfInputError at the end of the input, so a bare call stops
# there and `try Console.ask_line()` gives None. Code that reads a file or standard input alike takes a @R and gets
# Console.input().
#
# On Linux and macOS these are file descriptors 0, 1, and 2. On Windows a console is a different thing from a pipe:
# text for a console goes in as UTF-16 (WriteConsoleW, ReadConsoleW), so UTF-8 shows right whatever the console's code
# page, while a pipe or a file gets the bytes as they are (WriteFile, ReadFile), with no "\n" to "\r\n" change. A
# UTF-8 sequence split across two writes to a console is held until the rest comes.

module Hosted

### The console: what the program shows (`Console.show`), what it reports as a problem (`Console.alert`), and what it
### asks for (`Console.ask_line()`, `Console.ask[T]()`). `Console.show("x = {x}")` writes one line to standard output,
### `Console.alert("...")` one line to standard error, and `end:` changes the line end (`end: ""` for none). Every value
### is the same console, so the routines are called on the type.
record Console
    nothing

### The value Console.input() points at: a ConsoleInput holds nothing, so one serves every caller.
global CONSOLE_INPUT: &ConsoleInput
### The value Console.output() points at.
global CONSOLE_OUTPUT: &ConsoleOutput
### The value Console.errors() points at.
global CONSOLE_ERRORS: &ConsoleErrors

### Standard input, read through {Console}. {Console.input} is the pointer a Reader parameter takes.
record ConsoleInput
obeys Reader[ConsoleInput]
    nothing

### Standard output, a Writer. {Console.output} is the pointer a Writer parameter takes.
record ConsoleOutput
obeys Writer[ConsoleOutput]
    nothing

### Standard error, a Writer. {Console.errors} is the pointer a Writer parameter takes.
record ConsoleErrors
obeys Writer[ConsoleErrors]
    nothing

secret choice StdStream: U8
    INPUT
    OUTPUT
    ERROR

### What reads bytes: standard input, an open file.
protocol Reader[T]
    ### Reads up to `count` bytes into `buffer`.
    ### :param buffer: Where the bytes go.
    ### :param count: The most bytes to read.
    ### :returns: How many bytes were read, 0 at the end, or a {FsError}.
    failable routine @Me.read_bytes(buffer: @Byte, count: U64) -> U64

# -- Standard input --------------------------------------------------------------------------------

### The one buffer over standard input that the whole process shares.
global STDIN_BUFFER: &InputBuffer

### The size in bytes of standard input's buffer, and the read size at or above which a read skips the buffer.
preset IN_BUFFER: U64 = 8192

### Standard input's one buffer: bytes read from the OS and not handed out yet, in bytes[start, end).
secret record InputBuffer
    ### The byte whose exclusive access guards the buffer.
    guard: U8
    bytes: Items[Byte, IN_BUFFER]
    start: U64
    end: U64

### The input ended before a read found anything to read.
crashable EndOfInputError
    reader: @[Byte]

### Fills the empty buffer from the OS with one read.
### :returns: True when bytes came, false at the end of the input (or on a failure, which reads as the end).
secret routine @InputBuffer.fill() -> Bool
    got: Check[U64] = check stdin_read(buffer: me.bytes.getview().to[@Byte](), count: IN_BUFFER)
    n: U64 = when got
        is U64 as n => n
        is FsError => 0
    me.start.poke(0)
    me.end.poke(n)
    return n > 0

### The next byte, filling the buffer when it is empty. The lock is held.
### :returns: The byte.
### :throws: Throws `AbsentValueError` at the end of the input.
secret failable routine @InputBuffer.emit() -> Byte
    if me.start.peek() < me.end.peek() or me.fill()
        at: U64 = me.start.peek()
        me.start.poke(at + 1)
        buffered: @Byte = me.bytes.getview().to[@Byte]()
        return buffered.stride(at).peek()
    throw AbsentValueError()

### Puts back the byte emit just handed out. The lock is held.
secret routine @InputBuffer.unread() -> None
    previous_start: U64 = me.start.peek() - 1
    previous_start.poke_into(me.start)
    return

### Reads more input after what the buffer holds, into its free end. The buffer must have room after what it holds.
### The lock is held.
### :returns: True when bytes came, false at the end of the input (or on a failure, which reads as the end).
secret routine @InputBuffer.fill_more() -> Bool
    end: U64 = me.end.peek()

    free: @Byte = me.bytes.getview().to[@Byte]().stride(end)
    got: Check[U64] = check stdin_read(buffer: free, count: IN_BUFFER.sub(end))
    when got
        is U64 as n =>
            me.end.poke(end + n)
            return n > 0
        is FsError => return false

### Moves the bytes the buffer holds to its front, so the free space after them is as large as it can be. The lock is
### held.
secret routine @InputBuffer.compact() -> None
    from: U64 = me.start.peek()
    held: U64 = me.end.peek() - from
    buffered: @Byte = me.bytes.getview().to[@Byte]()

    me.start.poke(0)
    me.end.poke(held)

    # front to back: each byte goes to a place the loop has already read
    for i in 0 til held
        byte: Byte = buffered.stride(from + i).peek()
        buffered.stride(i).poke(byte)
    then
        return

### Skips white space and hands out the next word, None at the end of the input. A word that fits in the buffer is a
### view of it (moved to the front of the buffer first when it runs past the end of what was read, so it comes out
### whole), good until the buffer is read into again: nothing is allocated. A longer word is copied into memory from
### HEAP, which goes into `spill` for the caller to drop, and the word is a view of it. The lock is held.
### :param spill: Where a word longer than the buffer is kept, hollow until one is.
### :returns: The word.
### :absent: At the end of the input.
### :throws: Crashes with `OutOfMemoryError` when a word longer than the buffer can't be copied.
secret routine @InputBuffer.word(spill: @BorrowedSlice[Byte]) -> Optional[@[Byte]]
    # White space up to the word's first byte, which is put back.
    loop
        c: Optional[Byte] = try me.emit()
        when c
            is Byte as byte =>
                if is_space(byte)
                    continue
                me.unread()
                break
            is None => return None()

    # length bytes of the word are known
    loop with length: U64 = 1
        at: U64 = me.start.peek() + length
        if at < me.end.peek()
            buffered: @Byte = me.bytes.getview().to[@Byte]()
            following: Byte = buffered.stride(at).peek()
            if is_space(following)
                return me.take_word(length)
            continue with length: length + 1
        me.compact()
        if me.end.peek() >= IN_BUFFER
            # The whole buffer is one word so far: it goes on in memory from the default heap.
            return me.spill_word(length, spill)
        if me.fill_more()
            continue with length: length
        return me.take_word(length)

### Hands out the first `length` bytes the buffer holds as a view of it, and moves past them. The lock is held.
### :param length: How many bytes the word has.
### :returns: The word, good until the buffer is read into again.
secret routine @InputBuffer.take_word(length: U64) -> @[Byte]
    from: U64 = me.start.peek()
    buffered: @Byte = me.bytes.getview().to[@Byte]()
    word: @[Byte] = @[Byte].construct(data: buffered.stride(from), count: length)
    me.start.poke(from + length)
    return word

### A word longer than the buffer, which holds its first `length` bytes and nothing else: those bytes and the rest of
### the word, up to the next white space (put back) or the end of the input, copied into memory from HEAP
### that goes into `spill` for the caller to drop. The lock is held.
### :param length: How many bytes of the word the buffer holds, all of them.
### :param spill: Where the word is kept, hollow before.
### :returns: The word, a view of `spill`.
### :throws: Crashes with `OutOfMemoryError` when the word can't be copied.
secret routine @InputBuffer.spill_word(length: U64, spill: @BorrowedSlice[Byte]) -> @[Byte]
    text: &CaptureBuffer <- CaptureBuffer.empty()

    text.append(chunk: me.bytes.getview().to[@Byte](), n: length, manager: HEAP)
    me.start.poke(length)
    loop
        c: Optional[Byte] = try me.emit()
        when c
            is Byte as byte =>
                if is_space(byte)
                    me.unread()
                    break
                single: &Byte <- byte
                text.append(chunk: single, n: 1, manager: HEAP)
            is None => break
    if text.failed.peek()
        throw OutOfMemoryError()
    spill.replace(value: text.take_all())
    drop text
    return spill.getslice()

### A pointer to standard input, for passing where a Reader is taken (`@R`). Every value of {ConsoleInput} is the same stream,
### so the pointer holds no state: it points at a global that holds nothing.
### :returns: The pointer to hand to a reader parameter.
common routine Console.input() -> @ConsoleInput
    return CONSOLE_INPUT

### Reads up to `count` bytes: what the buffer holds first, else one read from the OS (straight into `buffer` when
### `count` is a bufferful or more).
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at the end, or a {FsError} when the OS read fails.
failable routine @ConsoleInput.read_into(buffer: @Byte, count: U64) -> U64
    b: @InputBuffer = STDIN_BUFFER

    held: Authorized[U8] <- b.guard.get_exclusive_access()
    if not (b.start.peek() < b.end.peek())
        # Nothing held: a read that wants a bufferful or more goes straight to the caller's buffer.
        if count >= IN_BUFFER
            read: Check[U64] = check stdin_read(buffer, count)
            drop held
            return when read
                is U64 as n => n
        elseif not b.fill()
            drop held
            return 0
    available: U64 = b.end.peek() - b.start.peek()
    n: U64 = available.min(count)
    buffer.copy(src: b.bytes.getview().to[@Byte]().stride(b.start.peek()), count: n)
    next_start: U64 = b.start.peek() + n
    next_start.poke_into(b.start)
    drop held
    return n

### Skips white space and reads the next word (spaces, tabs, and line ends separate words) as a T, straight from the
### input buffer: nothing is allocated unless the word is longer than the buffer. The space after the word stays in
### the input.
### :typeparam T: The type to read, a Parsable one (every integer and float type).
### :returns: The value.
### :throws: Throws `EndOfInputError` at the end of the input, and the failure of `text.to[T]()` (`InvalidValueError`,
###     naming the word and the type, `OutOfRangeError`) when the word isn't a T.
failable common routine Console.ask[T]() -> T
needs T obeys Parsable
    b: @InputBuffer = STDIN_BUFFER
    spill: &[Byte] <- .hollow()

    held: Authorized[U8] <- b.guard.get_exclusive_access()
    word: Optional[@[Byte]] = b.word(spill)
    when word
        is @[Byte] as text =>
            # The word may be a view of the buffer, so it's converted before the access is given back.
            converted: Check[T] = check text.to[T]()
            drop held
            when converted
                is T as value =>
                    drop spill
                    return value
                is Crashables as error =>
                    drop spill
                    throw error
        is None =>
            drop held
            drop spill
            throw EndOfInputError(reader: "Console.ask[T]")

### Writes `The input ended before Console.ask[T]() found anything to read.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine EndOfInputError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The input ended before {me.reader}() found anything to read.")
    return

### The Reader side: {ConsoleInput.read_into}.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at the end, or a {FsError}.
failable routine @ConsoleInput.read_bytes(buffer: @Byte, count: U64) -> U64
    when check me.read_into(buffer, count)
        is U64 as returned => return returned

### Up to `count` bytes, in memory from `manager`: fewer only at the end of the input or on a read failure. Drop them.
### :param count: How many bytes to read.
### :param manager: The manager for the bytes.
### :returns: The bytes read (empty when the allocation fails).
@expensive("allocates what it reads")
common routine Console.ask_bytes(count: U64, manager: @MemoryManager) -> BorrowedSlice[Byte]
    buffer: &[Byte] <- BorrowedSlice[Byte].construct(count: 0, manager: manager)

    when check BorrowedSlice[Byte].construct(count: count.max(1), manager: manager)
        is BorrowedSlice[Byte] as made => buffer.replace(value: steal made)
        is OutOfMemoryError => return buffer

    until n == count with n: U64 = 0
        got: Check[U64] = check Me.input().read_into(buffer: buffer.data.peek().stride(n),
            count: count - n)
        k: U64 = when got
            is U64 as k => k
            is FsError => 0
        if k == 0
            buffer.keep_first(n)
            return buffer
        continue with n: n + k
    then
        buffer.keep_first(n)
        return buffer

### What the rest of the input is, in memory from `manager`. Drop it.
### :param manager: The memory manager for the bytes.
### :returns: The bytes up to the end of the input (or up to a read failure).
@expensive("allocates what it reads")
common routine Console.ask_all(manager: @MemoryManager) -> BorrowedSlice[Byte]
    text: &CaptureBuffer <- CaptureBuffer.empty()
    chunk_buffer: &Items[Byte, 4096] <- .hollow()
    chunk: @Byte = chunk_buffer.getview().to[@Byte]()

    loop
        got2: Check[U64] = check Me.input().read_into(buffer: chunk, count: 4096)
        n2: U64 = when got2
            is U64 as n2 => n2
            is FsError => 0
        if n2 == 0
            all: &[Byte] <- text.take_all()
            drop text
            return all
        text.append(chunk, n: n2, manager)

### The next line, without its "\n" (or "\r\n"), in memory from manager. A last line with no "\n" still counts, and a
### blank line is "". Drop it.
### :param manager: The memory manager for the line.
### :returns: The line.
### :throws: Throws `EndOfInputError` at the end of the input.
@expensive("allocates what it reads")
failable common routine Console.ask_line(manager: @MemoryManager) -> BorrowedSlice[Byte]
    b: @InputBuffer = STDIN_BUFFER

    held: Authorized[U8] <- b.guard.get_exclusive_access()
    line: &Optional[BorrowedSlice[Byte]] <- b.line(manager)
    drop held
    when steal line
        is BorrowedSlice[Byte] as text => return text
        is None => throw EndOfInputError(reader: "Console.ask_line")

### The next line, without its "\n" (or "\r\n"), in memory from manager. The lock is held.
### :param manager: The memory manager for the line.
### :returns: The line.
### :absent: At the end of the input.
secret routine @InputBuffer.line(manager: @MemoryManager) -> Optional[BorrowedSlice[Byte]]
    text: &CaptureBuffer <- CaptureBuffer.empty()

    loop with any: Bool = false
        c: Optional[Byte] = try me.emit()
        when c
            is Byte as byte =>
                if byte == b'\n'
                    line: &[Byte] <- text.take_all()
                    drop text
                    return trim_cr(steal line)
                single: &Byte <- byte
                text.append(chunk: single, n: 1, manager)
                continue with any: true
            is None =>
                rest: &[Byte] <- text.take_all()
                drop text
                if any
                    return trim_cr(steal rest)
                drop rest
                return None()

### `line` without a "\r" at its end. The memory and its memory manager stay the same, only the count drops.
### :param line: The line.
### :returns: The line, one byte shorter when it ended in "\r".
secret routine trim_cr(line: BorrowedSlice[Byte]) -> BorrowedSlice[Byte]
    if line.getslice().has_suffix("\r")
        line.keep_first(line.count() - 1)
    return line

### Whether `c` separates words: a space, tab, line feed, or carriage return.
### :param c: The byte to test.
### :returns: `true` for white space.
secret routine is_space(c: Byte) -> Bool
    blank: Bool = c == b' ' or c == b'\t'
    line_end: Bool = c == b'\n' or c == b'\r'
    return blank or line_end

### The next word (spaces, tabs, and line ends separate words), in memory from manager. The space after the word stays
### in the input. Drop it.
### :param manager: The memory manager for the word.
### :returns: The word.
### :throws: Throws `EndOfInputError` at the end of the input.
@expensive("allocates what it reads")
failable common routine Console.ask_word(manager: @MemoryManager) -> BorrowedSlice[Byte]
    b: @InputBuffer = STDIN_BUFFER

    held: Authorized[U8] <- b.guard.get_exclusive_access()
    word: &Optional[BorrowedSlice[Byte]] <- b.take_word(manager)
    drop held
    when steal word
        is BorrowedSlice[Byte] as text => return text
        is None => throw EndOfInputError(reader: "Console.ask_word")

### The next word, in memory from manager. The space after the word stays in the input. The lock is held.
### :param manager: The memory manager for the word.
### :returns: The word.
### :absent: At the end of the input.
secret routine @InputBuffer.take_word(manager: @MemoryManager) -> Optional[BorrowedSlice[Byte]]
    text: &CaptureBuffer <- CaptureBuffer.empty()
    single: &Byte <- .hollow()

    # White space up to the word's first byte.
    loop
        c: Optional[Byte] = try me.emit()
        when c
            is Byte as byte =>
                if is_space(byte)
                    continue
                single.store(byte)
                text.append(chunk: single, n: 1, manager)
                break
            is None =>
                drop text
                return None()

    # The rest of the word, up to the next white space (put back) or the end of the input.
    loop
        c2: Optional[Byte] = try me.emit()
        when c2
            is Byte as byte2 =>
                if is_space(byte2)
                    me.unread()
                    break
                single.store(byte2)
                text.append(chunk: single, n: 1, manager)
            is None => break
    word: &[Byte] <- text.take_all()
    drop text
    return word

### Whether standard input is a terminal (a console on Windows), not a pipe or a file.
### :returns: `true` for a terminal.
routine @ConsoleInput.is_terminal() -> Bool
    return stream_is_terminal(StdStream.INPUT)

# -- Standard output and error -----------------------------------------------------------------------

### A pointer to standard output, for passing where a Writer is taken. Every value of {ConsoleOutput} is the same stream, so the
### pointer holds no state: it points at a global that holds nothing.
### :returns: The pointer to hand to a writer parameter.
common routine Console.output() -> @ConsoleOutput
    return CONSOLE_OUTPUT

### Writes all `count` bytes to standard output.
### :param data: The bytes to write.
### :param count: How many bytes there are.
@expensive("makes a system call")
failable routine @ConsoleOutput.write_all(data: @Byte, count: U64) -> None
    if stream_write(stream: StdStream.OUTPUT, data, count)
        return
    throw IoError(code: 0)

### The Writer side of standard output: a failed write is dropped ({ConsoleOutput.write_all} reports it).
### :param data: The bytes to write.
### :param count: How many bytes there are.
@expensive("makes a system call")
routine @ConsoleOutput.write_bytes(data: @Byte, count: U64) -> None
    stream_write(stream: StdStream.OUTPUT, data, count)
    return

### Whether standard output is a terminal (a console on Windows), not a pipe or a file.
### :returns: `true` for a terminal.
routine @ConsoleOutput.is_terminal() -> Bool
    return stream_is_terminal(StdStream.OUTPUT)

### Whether ANSI color sequences work: a terminal takes them (on Windows once this turns them on), a pipe or a file
### can't show them.
### :returns: `true` when standard output takes ANSI color sequences.
routine @ConsoleOutput.enable_colors() -> Bool
    return stream_enable_colors(StdStream.OUTPUT)

### A pointer to standard error, for passing where a Writer is taken. Every value of {ConsoleErrors} is the same stream, so the
### pointer holds no state: it points at a global that holds nothing.
### :returns: The pointer to hand to a writer parameter.
common routine Console.errors() -> @ConsoleErrors
    return CONSOLE_ERRORS

### Writes all `count` bytes to standard error.
### :param data: The bytes to write.
### :param count: How many bytes there are.
@expensive("makes a system call")
failable routine @ConsoleErrors.write_all(data: @Byte, count: U64) -> None
    if stream_write(stream: StdStream.ERROR, data, count)
        return
    throw IoError(code: 0)

### The Writer side of standard error: a failed write is dropped ({ConsoleErrors.write_all} reports it).
### :param data: The bytes to write.
### :param count: How many bytes there are.
@expensive("makes a system call")
routine @ConsoleErrors.write_bytes(data: @Byte, count: U64) -> None
    stream_write(stream: StdStream.ERROR, data, count)
    return

### Whether standard error is a terminal (a console on Windows), not a pipe or a file.
### :returns: `true` for a terminal.
routine @ConsoleErrors.is_terminal() -> Bool
    return stream_is_terminal(StdStream.ERROR)

### Whether ANSI color sequences work on standard error: a terminal takes them (on Windows once this turns them on), a
### pipe or a file can't show them.
### :returns: `true` when colors can be used.
routine @ConsoleErrors.enable_colors() -> Bool
    return stream_enable_colors(StdStream.ERROR)

# -- Linux and macOS -------------------------------------------------------------------

### Binds the C `isatty` function, which tells whether a descriptor is a terminal.
### :param fd: The descriptor.
### :returns: 1 for a terminal, 0 otherwise.
@external("c")
@symbol("isatty")
@target(os: ("linux", "macos"))
secret routine c_isatty(fd: CInt) -> CInt

### Binds the C `__errno_location` function (Linux).
### :returns: The address of the calling thread's `errno`.
@external("c")
@symbol("__errno_location")
@target(os: "linux")
secret routine c_errno_place() -> @CInt

### Binds the C `__error` function (macOS).
### :returns: The address of the calling thread's `errno`.
@external("c")
@symbol("__error")
@target(os: "macos")
secret routine c_errno_place() -> @CInt

### The file descriptor of a standard stream: 0 for input, 1 for output, 2 for error.
### :param stream: The stream.
### :returns: The descriptor.
@target(os: ("linux", "macos"))
secret routine fd_of(stream: StdStream) -> CInt
    when stream
        StdStream.INPUT => return 0
        StdStream.OUTPUT => return 1
        StdStream.ERROR => return 2

### Whether the stream is a terminal (a console on Windows), not a pipe or a file.
### :param stream: The stream.
### :returns: `true` for a terminal.
@target(os: ("linux", "macos"))
secret routine stream_is_terminal(stream: StdStream) -> Bool
    return c_isatty(fd_of(stream)) != 0

### Writes all `count` bytes to standard output or error, looping over partial writes and retrying after EINTR.
### :param stream: Standard output or error.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when every byte was written, `false` if the OS refused.
@target(os: ("linux", "macos"))
secret routine stream_write(stream: StdStream, data: @Byte, count: U64) -> Bool
    fd: CInt = fd_of(stream)

    until remaining == 0 with at: @Byte = data, remaining: U64 = count
        wrote: S64 = c_write(fd_of(stream), at, remaining.min(1073741824).to[CSize]()).to[S64]()
        if wrote > 0
            continue with at: at.stride(wrote.to[U64]()), remaining: remaining - wrote.to[U64]()
        errno: CInt = c_errno_place().peek()
        # EINTR: a signal came first, so try again
        if wrote < 0 and errno == 4
            continue with at: at, remaining: remaining
        return false
    then
        return true

### Reads up to `count` bytes of standard input with one read, retrying after EINTR.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at its end, or the error Other when the read fails.
@target(os: ("linux", "macos"))
secret failable routine stdin_read(buffer: @Byte, count: U64) -> U64
    got: S64 = c_read(0, buffer, count.min(1073741824).to[CSize]()).to[S64]()
    if got >= 0
        return got.to[U64]()
    errno: CInt = c_errno_place().peek()
    if errno == 4
        when check stdin_read(buffer, count)
            is U64 as returned => return returned
    throw IoError(code: 0)

### Whether ANSI color sequences work on the stream: a terminal takes them as it is.
### :param stream: The stream.
### :returns: `true` when the stream is a terminal.
@target(os: ("linux", "macos"))
secret routine stream_enable_colors(stream: StdStream) -> Bool
    return stream_is_terminal(stream)

# -- Windows -----------------------------------------------------------------------------

### The unfinished UTF-8 sequence of standard output's last console write.
@target(os: "windows")
global PENDING_OUTPUT: &PendingUtf8
### The unfinished UTF-8 sequence of standard error's last console write.
@target(os: "windows")
global PENDING_ERROR: &PendingUtf8
### The text read from the console and not handed out yet.
@target(os: "windows")
global CONSOLE_INPUT: &ConsoleReadBuffer

### The start of a UTF-8 sequence a write to the console ended in the middle of, for standard output and error.
@target(os: "windows")
secret record PendingUtf8
    bytes: Items[Byte, 4]
    count: U64

### ReadConsoleW's text as UTF-8, not yet handed out, and a high surrogate whose low half hasn't come.
@target(os: "windows")
secret record ConsoleReadBuffer
    bytes: Items[Byte, 16384]
    start: U64
    end: U64
    high: U16

### Binds the Win32 `GetStdHandle` function, which gives one of the process's standard handles.
### :param which: `STD_INPUT_HANDLE`, `STD_OUTPUT_HANDLE`, or `STD_ERROR_HANDLE`.
### :returns: The handle, null when there is none, or INVALID_HANDLE_VALUE with the last error set.
@external("c")
@symbol("GetStdHandle")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_std_handle(which: U32) -> Addr

### Binds the Win32 `GetConsoleMode` function, which reads a console's mode.
### :param console: The console handle.
### :param mode: Where the mode flags go.
### :returns: Nonzero on success, 0 (with the last error set) when the handle isn't a console.
@external("c")
@symbol("GetConsoleMode")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_console_mode(console: Addr, mode: @U32) -> CInt

### Binds the Win32 `SetConsoleMode` function, which sets a console's mode.
### :param console: The console handle.
### :param mode: The new mode flags.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("SetConsoleMode")
@callconv("stdcall")
@target(os: "windows")
secret routine c_set_console_mode(console: Addr, mode: U32) -> CInt

### Binds the Win32 `WriteConsoleW` function, which writes UTF-16 text to a console.
### :param console: The console handle.
### :param units: The UTF-16 units to write.
### :param count: How many units there are.
### :param written: Where the number of units written goes.
### :param reserved: Null.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("WriteConsoleW")
@callconv("stdcall")
@target(os: "windows")
secret routine c_write_console(console: Addr, units: @U16, count: U32, written: @U32,
    reserved: Addr) -> CInt

### Binds the Win32 `ReadConsoleW` function, which reads UTF-16 text from a console.
### :param console: The console handle.
### :param units: Where the UTF-16 units go.
### :param count: The most units to read.
### :param read: Where the number of units read goes.
### :param control: Null, or the read's control settings.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("ReadConsoleW")
@callconv("stdcall")
@target(os: "windows")
secret routine c_read_console(console: Addr, units: @U16, count: U32, read: @U32,
    control: Addr) -> CInt

### Binds the Win32 `WriteFile` function, which writes bytes to a file or pipe.
### :param file: The handle to write to.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :param written: Where the number of bytes written goes.
### :param overlapped: Null for a synchronous write.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("WriteFile")
@callconv("stdcall")
@target(os: "windows")
secret routine c_write_file(file: Addr, data: @Byte, count: U32, written: @U32,
    overlapped: Addr) -> CInt

### Binds the Win32 `ReadFile` function, which reads bytes from a file or pipe.
### :param file: The handle to read from.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :param read: Where the number of bytes read goes (0 at end of input).
### :param overlapped: Null for a synchronous read.
### :returns: Nonzero on success, 0 with the last error set (a pipe whose writer closed reports this too).
@external("c")
@symbol("ReadFile")
@callconv("stdcall")
@target(os: "windows")
secret routine c_read_file(file: Addr, buffer: @Byte, count: U32, read: @U32,
    overlapped: Addr) -> CInt

### Binds the Win32 `GetLastError` function.
### :returns: The calling thread's last error code.
@external("c")
@symbol("GetLastError")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_last_error() -> U32

### The Windows handle of a standard stream.
### :param stream: The stream.
### :returns: The handle, null or INVALID_HANDLE_VALUE when the process has none.
@target(os: "windows")
secret routine handle_of(stream: StdStream) -> Addr
    # STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
    when stream
        StdStream.INPUT => return c_get_std_handle(0xFFFFFFF6)
        StdStream.OUTPUT => return c_get_std_handle(0xFFFFFFF5)
        StdStream.ERROR => return c_get_std_handle(0xFFFFFFF4)

### Whether `h` is a real handle: not null and not INVALID_HANDLE_VALUE.
### :param h: The handle to test.
### :returns: `true` when it can be used.
@target(os: "windows")
secret routine is_usable(h: Addr) -> Bool
    return h.is_not_hollow() and h !== Addr.hollow() -% 1b

### Whether `h` is a console (GetConsoleMode accepts it), not a pipe or a file.
### :param h: The handle to test.
### :returns: `true` for a console.
@target(os: "windows")
secret routine is_console(h: Addr) -> Bool
    mode: &U32 <- 0

    return c_get_console_mode(h, mode) != 0

### Whether the stream is a terminal (a console on Windows), not a pipe or a file.
### :param stream: The stream.
### :returns: `true` for a console.
@target(os: "windows")
secret routine stream_is_terminal(stream: StdStream) -> Bool
    h: Addr = handle_of(stream)
    if is_usable(h)
        return is_console(h)
    return false

### Whether ANSI color sequences work on the stream: a console needs virtual terminal processing turned on, which
### this does. A pipe or a file can't show them.
### :param stream: The stream.
### :returns: `true` when the stream is a console and virtual terminal processing is now on.
@target(os: "windows")
secret routine stream_enable_colors(stream: StdStream) -> Bool
    h: Addr = handle_of(stream)
    if not is_usable(h)
        return false
    mode: &U32 <- 0
    if not (c_get_console_mode(h, mode) != 0)
        return false
    # ENABLE_VIRTUAL_TERMINAL_PROCESSING
    return c_set_console_mode(h, mode.load() | 4) != 0

### Writes all `count` bytes to standard output or error: as UTF-16 to a console, as they are to a pipe or a file.
### :param stream: Standard output or error.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when every byte was written (or held as an unfinished sequence), `false` if the OS refused (or
###     the process has no such stream).
@target(os: "windows")
secret routine stream_write(stream: StdStream, data: @Byte, count: U64) -> Bool
    h: Addr = handle_of(stream)
    if not is_usable(h)
        return false
    if is_console(h)
        return console_write(stream, h, data, count)
    return file_write(h, data, count)

### Writes all `count` bytes to a pipe or file handle with WriteFile as they are, looping over partial writes.
### :param h: The handle.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when every byte was written, `false` on the first failure.
@target(os: "windows")
secret routine file_write(h: Addr, data: @Byte, count: U64) -> Bool
    wrote: &U32 <- 0

    until remaining == 0 with at: @Byte = data, remaining: U64 = count
        ok: CInt = c_write_file(h, at, remaining.min(1073741824).to[U32](), wrote, .hollow())
        n: U64 = wrote.load().to[U64]()
        if ok != 0 and n > 0
            continue with at: at.stride(n), remaining: remaining - n
        return false
    then
        return true

### How many bytes a UTF-8 sequence starting with `b` has (1 for a byte that can't start one).
### :param b: The sequence's first byte.
### :returns: 1 to 4.
@target(os: "windows")
secret routine sequence_length(b: Byte) -> U64
    u: U8 = b.to[U8]()
    when
        u < 0xC0 => return 1
        u < 0xE0 => return 2
        u < 0xF0 => return 3
        u < 0xF8 => return 4
        else => return 1

### Where the last complete sequence of the `count` bytes ends: before a sequence the bytes stop in the middle of.
### :param data: The UTF-8 bytes.
### :param count: How many bytes there are.
### :returns: The number of bytes up to the end of the last complete sequence (`count` when none is cut off).
@target(os: "windows")
secret routine complete_end(data: @Byte, count: U64) -> U64
    until i == 0 or seen == 3 with i: U64 = count, seen: U64 = 0
        b: Byte = data.stride(i - 1).peek()
        top_bits: U8 = b.to[U8]() & 0xC0
        # a continuation byte: 10xxxxxx
        if top_bits == 0x80
            continue with i: i - 1, seen: seen + 1
        sequence_end: U64 = i - 1 + sequence_length(b)
        if sequence_end > count
            return i - 1
        return count
    then
        return count

### The record holding the unfinished UTF-8 sequence of a stream's console writes.
### :param stream: Standard output or error.
### :returns: The record for that stream.
@target(os: "windows")
secret routine pending_of(stream: StdStream) -> @PendingUtf8
    if stream == StdStream.ERROR
        return PENDING_ERROR
    return PENDING_OUTPUT

### Writes UTF-8 to a console as UTF-16, finishing a sequence an earlier write left open and holding one this
### write leaves open.
### :param stream: Standard output or error, whose unfinished sequence is used.
### :param h: The console handle.
### :param data: The UTF-8 bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when the text was written (or held), `false` if the console refused.
@target(os: "windows")
secret routine console_write(stream: StdStream, h: Addr, data: @Byte, count: U64) -> Bool
    pending: @PendingUtf8 = pending_of(stream)
    held: U64 = pending.count.peek()

    values2: (@Byte, U64) = when
        held == 0 => (data, count)
        else =>
            # The bytes the held sequence still needs come first.
            need: U64 = sequence_length(pending.bytes[0]) - held
            taken: U64 = need.min(count)
            held_bytes: @Byte = pending.bytes.getview().to[@Byte]()
            held_bytes.stride(held).copy(src: data, count: taken)
            if taken < need
                pending.count.poke(held + taken)
                return true
            pending.count.poke(0)
            if console_text(h, data: pending.bytes.getview().to[@Byte](), count: held + taken)
                becomes (data.stride(taken), count - taken)
            else
                return false

    at, n = values2
    cut: U64 = complete_end(data: at, count: n)
    pending.bytes.getview().to[@Byte]().copy(src: at.stride(cut), count: n - cut)
    pending.count.poke(n - cut)
    return console_text(h, data: at, count: cut)

### Writes complete UTF-8 text to a console, a bufferful of UTF-16 at a time.
### :param h: The console handle.
### :param data: The UTF-8 bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when all of it was written, `false` if the console refused.
@target(os: "windows")
secret routine console_text(h: Addr, data: @Byte, count: U64) -> Bool
    written: &U32 <- 0
    iter: &BytesCharsEmitter <- @[Byte].construct(data, count).chars()
    unit_buffer: &Items[U16, 2048] <- .hollow()
    units: @U16 = unit_buffer.getview().to[@U16]()

    loop with n: U64 = 0
        if n >= 2046
            if write_units(h, units, n, written)
                continue with n: 0
            return false
        c: Optional[Char] = try iter.emit()
        when c
            is Char as char =>
                cp: U32 = char.to[U32]()
                if cp < 0x10000
                    units.stride(n).poke(cp.to[U16]())
                    continue with n: n + 1
                v: U32 = cp - 0x10000
                high_surrogate: U32 = (v >> 10) + 0xD800
                units.stride(n).poke(high_surrogate.to[U16]())
                low_surrogate: U32 = (v & 0x3FF) + 0xDC00
                units.stride(n + 1).poke(low_surrogate.to[U16]())
                continue with n: n + 2
            is None => return write_units(h, units, n, written)

### Writes `n` UTF-16 units to a console, however many calls that takes.
### :param h: The console handle.
### :param units: The units to write.
### :param n: How many units there are.
### :param written: Scratch space for the count each call wrote.
### :returns: `true` when all were written, `false` if the console refused.
@target(os: "windows")
secret routine write_units(h: Addr, units: @U16, n: U64, written: @U32) -> Bool
    if n == 0
        return true
    ok: CInt = c_write_console(h, units, n.to[U32](), written, .hollow())
    w: U64 = written.peek().to[U64]()
    if ok != 0 and w > 0
        return write_units(h, units: units.stride(w), n: n - w, written)
    return false

### Reads up to `count` bytes of standard input: from the console as UTF-8, or from a pipe or a file as they are.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at its end (Ctrl+Z at the start of a console read, a closed pipe, or no
###     standard input), or the error Other when the read fails.
@target(os: "windows")
secret failable routine stdin_read(buffer: @Byte, count: U64) -> U64
    h: Addr = handle_of(StdStream.INPUT)
    if not is_usable(h)
        return 0
    if is_console(h)
        when check console_read(h, buffer, count)
            is U64 as returned => return returned
    got: &U32 <- 0
    if c_read_file(h, buffer, count.min(1073741824).to[U32](), got, .hollow()) != 0
        return got.load().to[U64]()
    # ERROR_BROKEN_PIPE: the writing end closed, which is the end
    if c_get_last_error() == 109
        return 0
    throw IoError(code: 0)

### Hands out UTF-8 from CONSOLE_INPUT, reading the console (as UTF-16) when it is empty.
### :param h: The console handle.
### :param buffer: Where the bytes go.
### :param count: The most bytes to hand out.
### :returns: How many bytes were handed out, 0 at the end of the input (Ctrl+Z first), or the error Other when
###     ReadConsoleW fails.
@target(os: "windows")
secret failable routine console_read(h: Addr, buffer: @Byte, count: U64) -> U64
    input: @ConsoleReadBuffer = CONSOLE_INPUT

    if input.start.peek() < input.end.peek()
        # Ctrl+Z first: the end of the input
        # A high surrogate at the end waits for its low half. One held from the last read goes in front.
        start: U64 = input.start.peek()
        available: U64 = input.end.peek() - start
        n: U64 = available.min(count)
        buffer.copy(src: input.bytes.getview().to[@Byte]().stride(start), count: n)
        input.start.poke(start + n)
        return n
    units: &Items[U16, 4096] <- .hollow()
    got: &U32 <- 0
    if not (c_read_console(h, units.getview().to[@U16](), 4096, got, .hollow()) != 0)
        throw IoError(code: 0)
    n: U64 = got.load().to[U64]()
    if n == 0
        return 0
    if units[0] == 0x1A
        return 0
    units2: @U16 = units.getview().to[@U16]()
    joined: &Items[U16, 4097] <- .hollow()
    high: U16 = input.high.peek()
    lead: U64 = when
        high == 0 => 0
        else => 1
    joined_units: @U16 = joined.getview().to[@U16]()
    joined_units.poke(high)
    joined_units.stride(lead).copy(src: units2, count: n)
    total: U64 = n + lead
    last: U16 = joined_units.stride(total - 1).peek()
    values: (@U16, U64, U16) = when
        0xD800 <= last <= 0xDBFF => (joined.getview().to[@U16](), total - 1, last)
        else => (joined.getview().to[@U16](), total, 0)
    joined2, units3, high2 = values
    input.high.poke(high2)
    made: U64 = narrow(units: joined2, count: units3, out: input.bytes.getview().to[@Byte]())
    input.start.poke(0)
    input.end.poke(made)
    if made == 0
        when check console_read(h, buffer, count)
            is U64 as returned => return returned
    start: U64 = input.start.peek()
    available: U64 = input.end.peek() - start
    n2: U64 = available.min(count)
    buffer.copy(src: input.bytes.getview().to[@Byte]().stride(start), count: n2)
    input.start.poke(start + n2)
    return n2
