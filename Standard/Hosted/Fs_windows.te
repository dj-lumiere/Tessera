### :returns: The view's address, or null with the last error set.
@external("c")
@symbol("MapViewOfFile")
@callconv("stdcall")
@target(os: "windows")
secret routine c_map_view_of_file(mapping: Addr, access: U32, offset_high: U32, offset_low: U32,
    size: CSize) -> Addr

### Binds the Win32 `UnmapViewOfFile` function: removes a mapped view.
### :param view: The view's address.
### :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("UnmapViewOfFile")
@callconv("stdcall")
@target(os: "windows")
secret routine c_unmap_view_of_file(view: Addr) -> CInt

### Binds the Win32 `FlushViewOfFile` function: writes a view's changed pages back to its file.
### :param view: The view's address.
### :param size: The bytes to write back, 0 for the whole view.
### :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("FlushViewOfFile")
@callconv("stdcall")
@target(os: "windows")
secret routine c_flush_view_of_file(view: Addr, size: CSize) -> CInt

### Binds the Win32 `GetCurrentProcess` function: a handle to the calling process.
### :returns: The pseudo-handle, which needs no closing.
@external("c")
@symbol("GetCurrentProcess")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_current_process() -> Addr

