### :param process: The process whose memory it is.
### :param count: How many ranges.
### :param ranges: The ranges.
### :param flags: 0.
### :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("PrefetchVirtualMemory")
@callconv("stdcall")
@target(os: "windows")
secret routine c_prefetch_virtual_memory(process: Addr, count: CSize, ranges: @MemoryRange,
    flags: U32) -> CInt

# -- errors and paths ----------------------------------------------------------------

### The FsError for a Win32 error code.
### :param e: The error code.
### :returns: The matching FsError, `IoError` for a code with no match.
@target(os: "windows")
secret routine error_of(e: U32) -> FsError
    when e
        2, 3 => return NotFoundError()
        5 => return NotEnoughPermissionError()
        80, 183 => return AlreadyExistsError()
        267 => return NotADirectoryError()
        145 => return DirectoryNotEmptyError()
        17 => return CrossDeviceError()
        206 => return NameTooLongError()
        123, 161 => return InvalidPathError()
        39, 112 => return NotEnoughSpaceError()
        19 => return ReadOnlyError()
        32, 33 => return BusyError()
        8, 14 => return OutOfMemoryError()
        # ERROR_CRC, ERROR_SECTOR_NOT_FOUND, ERROR_WRITE_FAULT, ERROR_READ_FAULT, ERROR_DEVICE_HARDWARE_ERROR,
        # ERROR_IO_DEVICE, ERROR_DISK_OPERATION_FAILED
        23, 27, 29, 30, 483, 1117, 1127 => return StorageFaultError()
        else => return IoError(code: 0)

### The FsError for the calling thread's last Win32 error.
### :returns: The matching FsError.
@target(os: "windows")
secret routine last_error() -> FsError
    return error_of(c_get_last_error())

### A nonzero BOOL is success, 0 the last error.
### :param ok: The BOOL a call returned.
@target(os: "windows")
secret failable routine checked(ok: CInt) -> None
    if ok != 0
        return
    throw last_error()

### Whether h is `INVALID_HANDLE_VALUE` (all ones).
### :param h: The handle to test.
### :returns: True for `INVALID_HANDLE_VALUE`.
@target(os: "windows")
secret routine is_invalid_handle(h: Addr) -> Bool
    # INVALID_HANDLE_VALUE, (HANDLE)-1: all ones at the address's own width, 32 bits on 32-bit Windows
    return h === Addr.hollow() -% 1b

### text as UTF-16 with a 0 after it in out, which has room for capacity units: its length in units, or None if
### text has a NUL or doesn't fit. (A UTF-8 byte count bounds the unit count, so length + 1 units always fit.)
### :param text: The UTF-8 text.
### :param out: The buffer.
### :param capacity: Its room in UTF-16 units.
### :returns: The length in units, the 0 left out.
### :absent: When `text` has a NUL or doesn't fit with its 0.
@target(os: "windows")
secret routine encode_utf16(text: @[Byte], out: @U16, capacity: U64) -> Optional[U64]
    iter: &BytesCharsEmitter <- text.chars()

    loop with n: U64 = 0
        c: Optional[Char] = try iter.emit()
        when c
            is Char as char =>
                cp: U32 = char.to[U32]()
                if cp == 0
                    return None()
                if cp < 0x10000
                    if n + 1 >= capacity
                        return None()
                    out.stride(n).poke(cp.to[U16]())
                    continue with n: n + 1
                if n + 2 >= capacity
                    return None()
                v: U32 = cp - 0x10000
                high_surrogate: U32 = (v >> 10) + 0xD800
                out.stride(n).poke(high_surrogate.to[U16]())
                low_surrogate: U32 = (v & 0x3FF) + 0xDC00
                out.stride(n + 1).poke(low_surrogate.to[U16]())
                continue with n: n + 2
            is None =>
                out.stride(n).poke(0)
                return n

### path as UTF-16 with a 0 after it in out (PATH_CAPACITY units): its length in units, or None if path has a NUL or
### doesn't fit.
### :param path: The UTF-8 path.
### :param out: The buffer, `PATH_CAPACITY` units.
### :returns: The length in units, the 0 left out.
### :absent: When `path` has a NUL or doesn't fit.
@target(os: "windows")
secret routine wide(path: @[Byte], out: @U16) -> Optional[U64]
    return encode_utf16(text: path, out, capacity: PATH_CAPACITY)

### path as UTF-16 in out: whether it fit.
### :param path: The UTF-8 path.
### :param out: The buffer, `PATH_CAPACITY` units.
### :returns: True when it was converted. False when `path` has a NUL or doesn't fit.
@target(os: "windows")
secret routine wide_path(path: @[Byte], out: @U16) -> Bool
    n: Optional[U64] = wide(path, out)
    return n.is_present()

### count UTF-16 units at units as UTF-8 at out (room for 3 bytes a unit): the bytes written. An unpaired surrogate
### becomes U+FFFD.
### :param units: The first unit.
### :param count: How many units.
### :param out: Where the UTF-8 goes.
### :returns: The bytes written.
@target(os: "windows")
secret routine narrow(units: @U16, count: U64, out: @Byte) -> U64
    n: &U64 <- 0

    until i >= count with i: U64 = 0
        unit: U16 = units.stride(i).peek()
        u: U32 = unit.to[U32]()
        values2: (U64, U32) = when
            0xD800 <= u <= 0xDBFF =>
                if not (i + 1 < count)
                    becomes (i + 1, 0xFFFD)
                else
                    low_unit: U16 = units.stride(i + 1).peek()
                    low: U32 = low_unit.to[U32]()
                    if 0xDC00 <= low <= 0xDFFF
                        high_half: U32 = u - 0xD800 << 10
                        cp_offset: U32 = high_half + (low - 0xDC00)
                        becomes (i + 2, cp_offset + 0x10000)
                    else
                        becomes (i + 1, 0xFFFD)
            else =>
                if 0xDC00 <= u <= 0xDFFF
                    becomes (i + 1, 0xFFFD)
                else
                    becomes (i + 1, u)
        i2, cp = values2
        (n.load() + utf8_encode_into(char: cp.to[Char](), out: out.stride(n.load()))).poke_into(n)
        continue with i: i2
    then
        return n.load()

### The units before the first 0 at units.
### :param units: A 0-terminated UTF-16 string.
### :returns: The count of units before the 0.
@target(os: "windows")
secret routine wide_length(units: @U16) -> U64
    until units.stride(i).peek() == 0 with i: U64 = 0
        continue with i: i + 1
    then
        return i

### count UTF-16 units as UTF-8, in memory from manager.
### :param units: The first unit.
### :param count: How many units.
### :param manager: The memory manager for the text.
### :returns: The UTF-8 text.
### :throws: Throws `OutOfMemoryError` when `manager` fails.
@target(os: "windows")
secret failable routine copied_wide(units: @U16, count: U64,
    manager: @MemoryManager) -> BorrowedSlice[Byte]
    room: U64 = (count * 3).max(1)
    when check BorrowedSlice[Byte].construct(count: room, manager: manager)
        is BorrowedSlice[Byte] as buffer =>
            n: U64 = narrow(units, count, out: buffer.data.peek())
            buffer.keep_first(n)
            return buffer
        is OutOfMemoryError as error => throw error

# -- metadata ------------------------------------------------------------------------

### Nanoseconds since 1970 from a FILETIME, wrapping on overflow.
### :param t: The FILETIME.
### :returns: The nanoseconds since 1970-01-01 UTC, negative before then.
@target(os: "windows")
secret routine unix_ns(t: FileTime) -> S64
    high_ticks: U64 = t.high.to[U64]() << 32
    ticks: U64 = high_ticks | t.low.to[U64]()
    # 100 ns ticks between 1601-01-01 and 1970-01-01
    since_epoch: S64 = ticks.to_wrap[S64]() -% 116444736000000000
    return since_epoch *% 100

### A 64-bit size from its high and low 32-bit halves.
### :param high: The high half.
### :param low: The low half.
### :returns: The size.
@target(os: "windows")
secret routine size_of(high: U32, low: U32) -> U64
    upper: U64 = high.to[U64]() << 32
    return upper | low.to[U64]()

### A link (symbolic or a junction) by its attributes and reparse tag, else a directory or a file.
### :param attributes: The file's attribute bits.
### :param tag: Its reparse tag, 0 when not known.
### :returns: `Symlink`, `Directory`, or `File`.
@target(os: "windows")
secret routine kind_of(attributes: U32, tag: U32) -> FileKind
    reparse: Bool = attributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
    if reparse and (tag == IO_REPARSE_TAG_SYMLINK or tag == IO_REPARSE_TAG_MOUNT_POINT)
        return FileKind.SYMLINK
    if attributes & FILE_ATTRIBUTE_DIRECTORY != 0
        return FileKind.DIRECTORY
    return FileKind.FILE

### A Metadata from the attributes, times, and size Windows reports. Read-only is the read-only attribute.
### :param data: The file's attribute bits, times, and size.
### :param tag: Its reparse tag, 0 when not known.
### :returns: The metadata.
@target(os: "windows")
secret routine make_metadata(data: AttributeData, tag: U32) -> Metadata
    size: U64 = size_of(high: data.size_high, low: data.size_low)
    return Metadata(kind: kind_of(attributes: data.attributes, tag), size: size,
        modified_ns: unix_ns(data.written), created_ns: unix_ns(data.created),
        readonly: data.attributes & FILE_ATTRIBUTE_READONLY != 0)

### The metadata in a WIN32_FIND_DATAW, which starts with the fields of a WIN32_FILE_ATTRIBUTE_DATA.
### :param data: The `WIN32_FIND_DATAW`.
### :returns: The metadata, a link describing itself.
@target(os: "windows")
secret routine from_find_data(data: @Byte) -> Metadata
    parts: AttributeData = data.to[@AttributeData]().peek()
    tag_at: @Byte = data.stride(FIND_REPARSE_TAG)
    tag: U32 = tag_at.to[@U32]().peek()
    return make_metadata(data: parts, tag)

### The Metadata in a `BY_HANDLE_FILE_INFORMATION`. It has no reparse tag, so a link reads as a directory or a file.
### :returns: The metadata.
@target(os: "windows")
secret routine HandleInfo.to[Metadata]() -> Metadata
    parts: AttributeData = AttributeData(attributes: me.attributes, created: me.created,
        accessed: me.accessed, written: me.written, size_high: me.size_high, size_low: me.size_low)
    return make_metadata(data: parts, tag: 0)

### The metadata of the open file h.
### :param h: The open file.
### :returns: The metadata.
### :throws: Throws the FsError for the last error when the call fails.
@target(os: "windows")
secret failable routine handle_metadata(h: Addr) -> Metadata
    info: &HandleInfo <- .hollow()

    if c_get_file_information_by_handle(h, info) != 0
        return info.load().to[Metadata]()
    throw last_error()

### The metadata of wpath from GetFileAttributesExW, for what can't be opened (a file another process holds
### exclusively).
### :param wpath: The 0-terminated UTF-16 path.
### :returns: The metadata.
### :throws: Throws the FsError for the last error when the call fails.
@target(os: "windows")
secret failable routine attribute_metadata(wpath: @U16) -> Metadata
    data: &AttributeData <- .hollow()

    # GetFileExInfoStandard
    if c_get_file_attributes_ex(wpath, 0, data) == 0
        throw last_error()
    d: AttributeData = data.load()
    return make_metadata(data: d, tag: 0)

### A handle for asking about path (no read or write access): a directory too, and with link_itself, a link rather
### than what it points at.
### :param wpath: The 0-terminated UTF-16 path.
### :param link_itself: True to open a link itself, false to open what it points at.
### :returns: The handle, or `INVALID_HANDLE_VALUE` with the last error set.
@target(os: "windows")
secret routine query_handle(wpath: @U16, link_itself: Bool) -> Addr
    flags: U32 = when
        link_itself => FILE_FLAG_BACKUP_SEMANTICS.bitor(FILE_FLAG_OPEN_REPARSE_POINT)
        else => FILE_FLAG_BACKUP_SEMANTICS
    return c_create_file(wpath, 0, FILE_SHARE_ALL, .hollow(), OPEN_EXISTING, flags, .hollow())

### path's metadata, a link followed to what it points at.
### :param path: The path to look at.
### :returns: The metadata.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine metadata(path: @[Byte]) -> Metadata
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    h: Addr = query_handle(wpath: wpath.getview().to[@U16](), link_itself: false)
    if is_invalid_handle(h)
        # A missing file stays missing. Anything else may be a file that can't be opened, which the attributes still
        # describe.
        wpath2: @U16 = wpath.getview().to[@U16]()
        error: FsError = last_error()
        when error
            is NotFoundError => throw error
            else => nothing
        when check attribute_metadata(wpath2)
            is Metadata as returned => return returned
    m: Check[Metadata] = check handle_metadata(h)
    c_close_handle(h)
    when m
        is Metadata as returned => return returned

### path's metadata. A link describes itself (kind Symlink), from its directory entry.
### :param path: The path to look at.
### :returns: The metadata.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine symlink_metadata(path: @[Byte]) -> Metadata
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    data: &Items[U32, FIND_DATA_WORDS] <- .hollow()
    find: Addr = c_find_first_file(wpath.getview().to[@U16](), data.to[@Byte]())
    # A root ("C:\") has no directory entry: its attributes describe it
    if is_invalid_handle(find)
        when check attribute_metadata(wpath.getview().to[@U16]())
            is Metadata as returned => return returned
    c_find_close(find)
    return from_find_data(data.to[@Byte]())

# -- file handles --------------------------------------------------------------------------

### An open file, from a File's open_read and the like: a Reader and a Writer. claim it, and close it when
### done.
@target(os: "windows")
record FileHandle
    handle: Addr
    failed: Bool  # a write_bytes failed (write_all reports each failure itself)

### Makes a `FileHandle` from its fields.
### :param handle: Its `handle`.
### :param failed: Its `failed`.
### :returns: The new value.
@target(os: "windows")
common routine FileHandle.construct(handle: Addr, failed: Bool) -> Me
    return Me(handle, failed)

### Releases nothing: a `FileHandle` holds no memory of its own.
@target(os: "windows")
routine @FileHandle.destruct() -> None
    return

### A handle to no file, whose close() does nothing: the start value of a slot that a finish block closes.
### :returns: The empty handle.
@target(os: "windows")
common routine FileHandle.empty() -> Me
    return Me(handle: inttoptr[U64, Addr](U64.MAX), failed: false)

### Opens path in mode. Other handles may read, write, and delete the file while it is open. Only CreateNew and
### CreateReplacing make a file: the other modes fail with NotFound when nothing is there.
### :param path: The file to open.
### :param mode: How to open it.
### :returns: The open handle.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable common routine FileHandle.open(path: @[Byte], mode: OpenMode) -> Me
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    values2: (@U16, U32, U32) = when mode
        OpenMode.READ => (wpath.getview().to[@U16](), GENERIC_READ, OPEN_EXISTING)
        OpenMode.WRITE => (wpath.getview().to[@U16](), GENERIC_WRITE, TRUNCATE_EXISTING)
        OpenMode.APPEND => (wpath.getview().to[@U16](), FILE_APPEND_ONLY, OPEN_EXISTING)
        OpenMode.READ_WRITE => (wpath.getview().to[@U16](), GENERIC_READ.bitor(GENERIC_WRITE), OPEN_EXISTING)
        OpenMode.CREATE_NEW => (wpath.getview().to[@U16](), GENERIC_WRITE, CREATE_NEW)
        OpenMode.CREATE_REPLACING => (wpath.getview().to[@U16](), GENERIC_WRITE, CREATE_ALWAYS)
    wpath2, access, disposition = values2
    h: Addr = c_create_file(wpath2, access, FILE_SHARE_ALL, .hollow(), disposition,
        FILE_ATTRIBUTE_NORMAL, .hollow())
    if is_invalid_handle(h)
        throw last_error()
    return Me(handle: h, failed: false)

### Reads up to count bytes into buffer: how many, 0 at the end of the file. One call reads at most 1 GiB, and a
### broken pipe reads as the end.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: The count read, 0 at the end of the file.
### :throws: Throws the reason when the read fails.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @FileHandle.read_bytes(buffer: @Byte, count: U64) -> U64
    got: &U32 <- 0

    ok: CInt = c_read_file(me.handle.peek(), buffer, count.min(1073741824).to[U32](), got,
        .hollow())
    if ok != 0
        return got.load().to[U64]()
    # ERROR_BROKEN_PIPE: the writing end closed, which is the end
    e: U32 = c_get_last_error()
    if e == 109
        return 0
    throw error_of(e)

### Writes up to count bytes: how many it did. One call writes at most 1 GiB.
### :param data: The first byte to write.
### :param count: The most bytes to write.
### :returns: The count written.
### :throws: Throws the reason when the write fails.
@target(os: "windows")
secret failable routine @FileHandle.write_some(data: @Byte, count: U64) -> U64
    wrote: &U32 <- 0

    ok: CInt = c_write_file(me.handle.peek(), data, count.min(1073741824).to[U32](), wrote,
        .hollow())
    if ok != 0
        return wrote.load().to[U64]()
    throw last_error()

### Moves the position: the new one, from the start.
### :param offset: The distance to move, negative to go back.
### :param from: Where `offset` counts from.
### :returns: The new position from the start.
### :throws: Throws the reason, such as a position before the start.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @FileHandle.seek(offset: S64, from: SeekFrom) -> U64
    at: &S64 <- 0

    # FILE_BEGIN, FILE_CURRENT, FILE_END
    ok: CInt = when from
        SeekFrom.START => c_set_file_pointer_ex(me.handle.peek(), offset, at, 0)
        SeekFrom.CURRENT => c_set_file_pointer_ex(me.handle.peek(), offset, at, 1)
        SeekFrom.END => c_set_file_pointer_ex(me.handle.peek(), offset, at, 2)
    if ok != 0
        return at.load().to[U64]()
    throw last_error()

### The metadata of the open file.
### :returns: The metadata.
### :throws: Throws the reason when the OS can't report it.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @FileHandle.metadata() -> Metadata
    when check handle_metadata(me.handle.peek())
        is Metadata as returned => return returned

### The size of the open file in bytes.
### :returns: The size.
### :throws: Throws the reason when the OS can't report it.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @FileHandle.size() -> U64
    size: &S64 <- 0

    if c_get_file_size_ex(me.handle.peek(), size) != 0
        return size.load().to[U64]()
    throw last_error()

### Truncates or extends (with zeros) the file to size bytes. The position stays.
### :param size: The new size in bytes.
### :throws: Throws the reason when the OS refuses. Crashes with `IntegerOverflowError` when `size`
###     doesn't fit in S64.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @FileHandle.set_size(size: U64) -> None
    end: &S64 <- size.to[S64]()

    # FileEndOfFileInfo
    when check checked(c_set_file_information_by_handle(me.handle.peek(), 6, end, 8))
        is None => return

### Waits until what was written is on the storage device.
### :throws: Throws the reason when the OS reports an error.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @FileHandle.sync() -> None
    when check checked(c_flush_file_buffers(me.handle.peek()))
        is None => return

### Closes the file and leaves the handle empty, so a second close does nothing.
@target(os: "windows")
@expensive("asks the operating system")
routine @FileHandle.close() -> None
    h: Addr = me.handle.peek()
    if is_invalid_handle(h)
        return
    c_close_handle(h)
    me.handle.poke(inttoptr[U64, Addr](U64.MAX))
    return

# -- directories and names -------------------------------------------------------------

### Makes the directory path (its parent must exist).
### :param path: The directory to make.
### :throws: Throws the reason, `AlreadyExistsError` when something is at `path`, `InvalidPathError` or
###     `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine create_dir(path: @[Byte]) -> None
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if wide_path(path, out: wpath.getview().to[@U16]())
        when check checked(c_create_directory(wpath.getview().to[@U16](), .hollow()))
            is None => return
    throw path_error(path)

### Removes a file (or a link, a directory link included), not a directory.
### :param path: The file to remove.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine remove_file(path: @[Byte]) -> None
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    if c_delete_file(wpath.getview().to[@U16]()) != 0
        return
    # A link to a directory is a directory to DeleteFileW
    error: U32 = c_get_last_error()
    attributes: U32 = c_get_file_attributes(wpath.getview().to[@U16]())
    link_bits: U32 = FILE_ATTRIBUTE_DIRECTORY.bitor(FILE_ATTRIBUTE_REPARSE_POINT)
    known: Bool = attributes != INVALID_FILE_ATTRIBUTES
    if known and attributes & link_bits == link_bits
        when check checked(c_remove_directory(wpath.getview().to[@U16]()))
            is None => return
    throw error_of(error)

### Removes an empty directory.
### :param path: The directory to remove.
### :throws: Throws the reason, `DirectoryNotEmptyError` when something is in it, `InvalidPathError` or
###     `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine remove_dir(path: @[Byte]) -> None
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if wide_path(path, out: wpath.getview().to[@U16]())
        when check checked(c_remove_directory(wpath.getview().to[@U16]()))
            is None => return
    throw path_error(path)

### Renames from to to with MoveFileExW and flags.
### :param from: The current path.
### :param to: The new path.
### :param flags: The `MOVEFILE_*` flags.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when a path doesn't fit a C path.
@target(os: "windows")
secret failable routine move_file(from: @[Byte], to: @[Byte], flags: U32) -> None
    a: &Items[U16, PATH_CAPACITY] <- .hollow()
    b: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path: from, out: a.getview().to[@U16]())
        throw path_error(from)
    if wide_path(path: to, out: b.getview().to[@U16]())
        when check checked(c_move_file_ex(a.getview().to[@U16](), b.getview().to[@U16](),
            flags))
            is None => return
    throw path_error(to)

### Renames from to to, replacing what is at to. Between volumes it fails with CrossDevice.
### :param from: The current path.
### :param to: The new path.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when a path doesn't fit a C path.
@target(os: "windows")
secret failable routine rename(from: @[Byte], to: @[Byte]) -> None
    # MOVEFILE_REPLACE_EXISTING
    when check move_file(from, to, flags: 1)
        is None => return

### Renames from to to, failing with AlreadyExistsError if something is at to.
### :param from: The current path.
### :param to: The new path.
### :throws: Throws the reason, `AlreadyExistsError` when something is at `to`, `InvalidPathError` or
###     `NameTooLongError` when a path doesn't fit a C path.
@target(os: "windows")
secret failable routine rename_no_replace(from: @[Byte], to: @[Byte]) -> None
    when check move_file(from, to, flags: 0)
        is None => return

### CopyFileExW's progress routine: records the bytes transferred so far in the U64 at `data`, and lets the copy go
### on.
### :param total_size: The file's size.
### :param transferred: The bytes copied so far.
### :param stream_size: The current stream's size.
### :param stream_transferred: The current stream's bytes copied so far.
### :param stream: The current stream's number.
### :param reason: Why it is called (a chunk finished, or a stream started).
### :param source: The source file's handle.
### :param destination: The destination file's handle.
### :param data: The U64 that counts the bytes copied.
### :returns: `PROGRESS_CONTINUE` (0).
@target(os: "windows")
@callconv("stdcall")
secret routine copy_progress(total_size: S64, transferred: S64, stream_size: S64,
    stream_transferred: S64, stream: U32, reason: U32, source: Addr, destination: Addr,
    data: Addr) -> U32
    data.to[@U64]().poke(transferred.to_wrap[U64]())
    return 0

### Copies from into to, which is made, or replaced when `replacing`: the bytes copied, as CopyFileExW reports them
### while it copies.
### :param from: The file to copy.
### :param to: The file to write.
### :param replacing: Whether a file already at `to` is replaced. When false, one there fails the copy.
### :returns: The number of bytes copied.
### :throws: Throws the reason when the copy fails, `AlreadyExistsError` when something is at `to` and `replacing` is
###     false, `InvalidPathError` or `NameTooLongError` when a path doesn't fit a C path.
@target(os: "windows")
secret failable routine copy_file(from: @[Byte], to: @[Byte], replacing: Bool) -> U64
    a: &Items[U16, PATH_CAPACITY] <- .hollow()
    b: &Items[U16, PATH_CAPACITY] <- .hollow()
    copied: &U64 <- 0

    if not wide_path(path: from, out: a.getview().to[@U16]())
        throw path_error(from)
    if not wide_path(path: to, out: b.getview().to[@U16]())
        throw path_error(to)
    # COPY_FILE_FAIL_IF_EXISTS
    flags: U32 = when
        replacing => 0
        else => 1
    if c_copy_file_ex(a.getview().to[@U16](), b.getview().to[@U16](),
        copy_progress.to[Callable](), copied, .hollow(), flags) != 0
        return copied.load()
    throw last_error()

### Sets or clears the read-only attribute.
### :param path: The file to change.
### :param readonly: True to set the attribute, false to clear it.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine set_readonly(path: @[Byte], readonly: Bool) -> None
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    attributes: U32 = c_get_file_attributes(wpath.getview().to[@U16]())
    if attributes == INVALID_FILE_ATTRIBUTES
        throw last_error()
    changed: U32 = when
        readonly => attributes | FILE_ATTRIBUTE_READONLY
        else => attributes & FILE_ATTRIBUTE_READONLY.bitnot()
    when check checked(c_set_file_attributes(wpath.getview().to[@U16](), changed))
        is None => return

### Whether e (an extension) is exe, com, cmd, or bat, in any case.
### :param e: The extension, without its dot.
### :returns: True for those four.
@target(os: "windows")
secret routine is_program_extension(e: @[Byte]) -> Bool
    if not (e.count() == 3)
        return false
    # ASCII lowercase: setting bit 5 of a letter
    a: U8 = e.byte_at(0) | 0x20
    b: U8 = e.byte_at(1) | 0x20
    c: U8 = e.byte_at(2) | 0x20
    starts_ex: Bool = a == 101 and b == 120
    exe: Bool = starts_ex and c == 101
    starts_co: Bool = a == 99 and b == 111
    com: Bool = starts_co and c == 109
    starts_cm: Bool = a == 99 and b == 109
    cmd: Bool = starts_cm and c == 100
    starts_ba: Bool = a == 98 and b == 97
    bat: Bool = starts_ba and c == 116
    binary: Bool = exe or com
    script: Bool = cmd or bat
    return binary or script

### Whether path can be read (it exists), written (it exists and isn't read-only), or run (a file named .exe, .com,
### .cmd, or .bat). Windows checks permissions only when a file is opened.
### :param path: The path to check.
### :param access: What to check for.
### :returns: True when allowed. False when not, when nothing is there, or when `path` doesn't fit a C path.
@target(os: "windows")
secret routine is_accessible(path: @[Byte], access: Access) -> Bool
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        return false
    attributes: U32 = c_get_file_attributes(wpath.getview().to[@U16]())
    if attributes == INVALID_FILE_ATTRIBUTES
        return false
    when access
        Access.READ => return true
        Access.WRITE => return attributes & FILE_ATTRIBUTE_READONLY == 0
        Access.EXECUTE =>
            if attributes & FILE_ATTRIBUTE_DIRECTORY != 0
                return false
            return is_program_extension(file_extension(path))

# -- directory listings ------------------------------------------------------------------

### The entries of a directory, "." and ".." left out, in the order the OS gives them. claim one, open it on a
### Directory, call next until None, and close it.
@target(os: "windows")
record DirEmitter
    find: Addr
    data: Items[U32, FIND_DATA_WORDS]  # WIN32_FIND_DATAW of the entry next returns or returned
    pending: Bool  # data holds an entry next hasn't returned yet
    name: Items[Byte, 1024]  # the UTF-8 name next returned

### Opens the listing of the directory at path, a search for `path\*`. The handle is invalid until the search starts,
### so close() is safe after a failure.
### :param path: The directory to list.
### :throws: Throws the reason, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine @DirEmitter.open_path(path: @[Byte]) -> None
    pattern_buffer: &Items[U16, PATH_CAPACITY] <- .hollow()
    pattern: @U16 = pattern_buffer.getview().to[@U16]()

    me.find.poke(inttoptr[U64, Addr](U64.MAX))
    me.pending.poke(false)
    n: Optional[U64] = wide(path, out: pattern)
    when n
        is U64 as count =>
            # path, a separator unless it ends with one, and "*"
            if count + 2 >= PATH_CAPACITY
                throw NameTooLongError()
            at: U64 = when
                count == 0 => 0
                else =>
                    last: U16 = pattern.stride(count - 1).peek()
                    if last == 0x2F or last == 0x5C
                        becomes count
                    else
                        pattern.stride(count).poke(0x5C)
                        becomes count + 1
            pattern.stride(at).poke(0x2A)
            pattern.stride(at + 1).poke(0)
            find: Addr = c_find_first_file(pattern, me.data.to[@Byte]())
            if is_invalid_handle(find)
                throw last_error()
            me.find.poke(find)
            me.pending.poke(true)
            return
        is None => throw path_error(path)

### Whether the UTF-16 name is "." or "..".
### :param name: The 0-terminated UTF-16 name.
### :returns: True for "." and "..".
@target(os: "windows")
secret routine is_dot_wide(name: @U16) -> Bool
    if not (name.peek() == 0x2E)
        return false
    second: U16 = name.stride(1).peek()
    if second == 0
        return true
    if second == 0x2E
        third: U16 = name.stride(2).peek()
        return third == 0
    return false

### The next entry (a failure partway reads as the end).
### :returns: The next entry, its name valid until the next call.
### :throws: Throws `AbsentValueError` at the end of the listing, or when reading it fails.
@target(os: "windows")
failable routine @DirEmitter.emit() -> DirEntry
    if is_invalid_handle(me.find.peek())
        throw AbsentValueError()
    if me.pending.peek() or c_find_next_file(me.find.peek(), me.data.to[@Byte]()) != 0
        me.pending.poke(false)
        data: @Byte = me.data.to[@Byte]()
        name: @U16 = data.stride(FIND_NAME).to[@U16]()
        if is_dot_wide(name)
            return when check me.emit()
                is DirEntry as next => next
        n: U64 = narrow(units: name, count: wide_length(name),
            out: me.name.getview().to[@Byte]())
        info: Metadata = from_find_data(data)
        return DirEntry(name: @[Byte].construct(data: me.name.getview().to[@Byte](), count: n),
            kind: info.kind)
    throw AbsentValueError()

### The metadata of the entry next last returned, from the listing itself (a link describes itself).
### :returns: The metadata, which never fails here.
@target(os: "windows")
@expensive("asks the operating system")
failable routine @DirEmitter.entry_metadata() -> Metadata
    return from_find_data(me.data.to[@Byte]())

### Ends the listing and leaves the handle invalid, so a second close does nothing.
@target(os: "windows")
routine @DirEmitter.close() -> None
    find: Addr = me.find.peek()
    if is_invalid_handle(find)
        return
    c_find_close(find)
    me.find.poke(inttoptr[U64, Addr](U64.MAX))
    return

# -- the working directory and well-known directories -------------------------------------

### The working directory, in memory from manager.
### :param manager: The memory manager for the text.
### :returns: The path.
### :throws: Throws the reason when the OS can't report it, `OutOfMemoryError` when `manager` fails.
@target(os: "windows")
secret failable routine current_dir(manager: @MemoryManager) -> BorrowedSlice[Byte]
    need: U32 = c_get_current_directory(0, .hollow())
    if need == 0
        throw last_error()
    when check BorrowedSlice[U16].construct(count: need.to[U64](), manager: manager)
        is BorrowedSlice[U16] as units =>
            need2: U32 = units.count().to[U32]()
            data: @U16 = units.data.peek()
            got: U32 = c_get_current_directory(need2, data)
            if got == 0 or got >= need2
                error: FsError = last_error()
                drop units
                throw error
            when check copied_wide(units: data, count: got.to[U64](), manager)
                is BorrowedSlice[Byte] as text =>
                    drop units
                    return text
                is FsError as error =>
                    drop units
                    throw error
        is OutOfMemoryError as error => throw error

### The temporary directory without its trailing separator (C:\Windows\Temp when it can't be told), in memory from
### manager.
### :param manager: The memory manager for the text.
### :returns: The path.
### :throws: Throws `OutOfMemoryError` when `manager` fails.
@target(os: "windows")
secret failable routine temp_dir(manager: @MemoryManager) -> BorrowedSlice[Byte]
    units: &Items[U16, PATH_CAPACITY] <- .hollow()

    got: U32 = c_get_temp_path(PATH_CAPACITY.to[U32](), units.getview().to[@U16]())
    if got == 0 or got.to[U64]() >= PATH_CAPACITY
        when check BorrowedSlice[Byte].construct(count: 15, manager: manager)
            is BorrowedSlice[Byte] as buffer =>
                buffer.data.peek().copy(src: "C:\\Windows\\Temp", count: 15)
                return buffer
            is OutOfMemoryError as error => throw error
    path_units: @U16 = units.getview().to[@U16]()
    trimmed: U64 = (got - 1).to[U64]()
    last: U16 = path_units.stride(trimmed).peek()
    if last == 0x5C or last == 0x2F
        when check copied_wide(units: units.getview().to[@U16](), count: trimmed, manager)
            is BorrowedSlice[Byte] as returned => return returned
    when check copied_wide(units: units.getview().to[@U16](), count: got.to[U64](), manager)
        is BorrowedSlice[Byte] as returned => return returned

### The environment variable name, as UTF-8 in memory from manager, when it is set and not empty.
### :param name: The variable's 0-terminated UTF-16 name.
### :param manager: The memory manager for the text.
### :returns: The value.
### :absent: When the variable is not set, is empty, takes `PATH_CAPACITY` units or more, or `manager` fails.
@target(os: "windows")
secret routine env_dir(name: CWStrView, manager: @MemoryManager) -> Optional[BorrowedSlice[Byte]]
    units: &Items[U16, PATH_CAPACITY] <- .hollow()

    got: U32 = c_get_environment_variable(name.to[@CWChar](), units.getview().to[@U16](),
        PATH_CAPACITY.to[U32]())
    if got == 0 or got.to[U64]() >= PATH_CAPACITY
        return None()
    when check copied_wide(units: units.getview().to[@U16](), count: got.to[U64](), manager)
        is BorrowedSlice[Byte] as t => return t
        is FsError => return None()

### USERPROFILE, or HOMEDRIVE and HOMEPATH, in memory from manager. NotFound when neither is set.
### :param manager: The memory manager for the text.
### :returns: The path.
### :throws: Throws `NotFoundError` when neither is set, or when `manager` fails for a variable's value. Crashes
###     with `OutOfMemoryError` when `manager` fails joining HOMEDRIVE and HOMEPATH.
@target(os: "windows")
secret failable routine home_dir(manager: @MemoryManager) -> BorrowedSlice[Byte]
    when env_dir(name: "USERPROFILE", manager)
        is BorrowedSlice[Byte] as dir => return dir
        is None => nothing
    when env_dir(name: "HOMEDRIVE", manager)
        is BorrowedSlice[Byte] as drive =>
            when env_dir(name: "HOMEPATH", manager)
                is BorrowedSlice[Byte] as path =>
                    joined: &[Byte] <- @[Byte].concat(a: drive.getslice(), b: path.getslice(),
                        manager)
                    drop drive
                    drop path
                    return joined
                is None =>
                    drop drive
                    throw NotFoundError()
        is None => throw NotFoundError()

### path made absolute by the text: the working directory in front of a relative path, and "." and ".." taken out
### (GetFullPathNameW), nothing looked up.
### :param path: The path to make absolute.
### :param manager: The memory manager for the result.
### :returns: The absolute path.
### :throws: Throws the reason, `NameTooLongError` when the result doesn't fit, `OutOfMemoryError` when
###     `manager` fails, `InvalidPathError` or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine absolute_path(path: @[Byte], manager: @MemoryManager) -> BorrowedSlice[Byte]
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    full: &Items[U16, PATH_CAPACITY] <- .hollow()
    got: U32 = c_get_full_path_name(wpath.getview().to[@U16](), PATH_CAPACITY.to[U32](),
        full.getview().to[@U16](), .hollow())
    if got == 0
        throw last_error()
    if got.to[U64]() >= PATH_CAPACITY
        throw NameTooLongError()
    when check copied_wide(units: full.getview().to[@U16](), count: got.to[U64](), manager)
        is BorrowedSlice[Byte] as returned => return returned

### The absolute path with every link, ".", and ".." resolved, and path must exist. The "\\?\" prefix the OS gives is
### taken off ("\\?\UNC\server\share" becomes "\\server\share").
### :param path: The path to resolve.
### :param manager: The memory manager for the result.
### :returns: The resolved path.
### :throws: Throws the reason, such as `NotFoundError`, `OutOfMemoryError` when `manager` fails, `InvalidPathError`
###     or `NameTooLongError` when `path` doesn't fit a C path.
@target(os: "windows")
secret failable routine canonical_path(path: @[Byte],
    manager: @MemoryManager) -> BorrowedSlice[Byte]
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    h: Addr = query_handle(wpath: wpath.getview().to[@U16](), link_itself: false)
    if is_invalid_handle(h)
        throw last_error()
    full: &Items[U16, PATH_CAPACITY] <- .hollow()
    # FILE_NAME_NORMALIZED | VOLUME_NAME_DOS
    got: U32 = c_get_final_path_name_by_handle(h, full.getview().to[@U16](),
        PATH_CAPACITY.to[U32](), 0)
    e: U32 = c_get_last_error()
    c_close_handle(h)
    if got == 0
        throw error_of(e)
    if got.to[U64]() >= PATH_CAPACITY
        throw NameTooLongError()
    when check copied_wide(units: full.getview().to[@U16](), count: got.to[U64](), manager)
        is BorrowedSlice[Byte] as t =>
            unc: Bool = t.getslice().has_prefix("\\\\?\\UNC\\")
            if not unc and not t.getslice().has_prefix("\\\\?\\")
                return t
            from: U64 = when
                unc => 8
                else => 4
            keep: U64 = when
                unc => 2
                else => 0
            # "\\?\UNC\server" to "\\server": keep the first two backslashes, drop "?\UNC\"
            # Moves the text from from down to keep, so the buffer's start (what free wants) stays where it is.

            rest: U64 = t.count() - from
            data: @Byte = t.data.peek()

            each i in 0 til rest
                data.stride(keep + i).poke(data.stride(from + i).peek())
            then
                t.keep_first(keep + rest)
                return t
        is FsError as error => throw error

# -- memory-mapped files -----------------------------------------------------------------

### Maps count cells of path from cell start (U64.MAX: to the end), clamped to the whole cells the file holds. Past the
### end, or an empty file, gives an empty storage. write maps it so stores reach the file. Otherwise it's read-only
### (opened for a front-to-back read).
### :param path: The file to map.
### :param write: True for a writable mapping whose stores reach the file.
### :param start: The first cell to map.
### :param count: The most cells to map.
### :returns: The storage.
### :throws: Throws the reason when the file can't be opened, measured, or mapped.
@target(os: "windows")
secret failable common routine FileStorage[T].map(path: @[Byte], write: Bool, start: U64,
    count: U64) -> Me
needs T: typename, StorageCell[T]
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    h: Addr = when
        write => c_create_file(wpath.getview().to[@U16](), GENERIC_READ.bitor(GENERIC_WRITE),
            FILE_SHARE_ALL, .hollow(), OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, .hollow())
        else => c_create_file(wpath.getview().to[@U16](), GENERIC_READ, FILE_SHARE_ALL,
            .hollow(), OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, .hollow())
    if is_invalid_handle(h)
        throw last_error()
    size: &S64 <- 0
    if c_get_file_size_ex(h, size) == 0
        error: FsError = last_error()
        c_close_handle(h)
        throw error
    offset, cells = cell_window(size: size.load().to[U64](), start, count, cell: sizeof[T]())
    if cells == 0
        c_close_handle(h)
        return Me.empty()
    want: U64 = cells * sizeof[T]()
    grain: U64 = map_granularity().bytes()
    aligned: U64 = offset - offset % grain
    delta: U64 = offset - aligned
    # PAGE_READWRITE or PAGE_READONLY
    protect: U32 = when
        write => 4
        else => 2
    mapping: Addr = c_create_file_mapping(h, .hollow(), protect, 0, 0, .hollow())
    if mapping.is_hollow()
        error: FsError = last_error()
        c_close_handle(h)
        throw error
    # FILE_MAP_WRITE or FILE_MAP_READ
    access: U32 = when
        write => 2
        else => 4
    view: Addr = c_map_view_of_file(mapping, access, (aligned >> 32).to_wrap[U32](),
        aligned.to_wrap[U32](), (want + delta).to[CSize]())
    e: U32 = c_get_last_error()
    # the view keeps the mapping and the file open on its own
    c_close_handle(mapping)
    c_close_handle(h)
    if view.is_hollow()
        throw error_of(e)
    return Me(base: view, delta: delta, count: cells, writable: write)

### Writes the changed pages of a mapping back to its file.
### :param base: The mapping's base.
### :param bytes: The mapped length.
### :throws: Throws the reason when FlushViewOfFile fails.
@target(os: "windows")
secret failable routine flush_mapping(base: Addr, bytes: U64) -> None
    when check checked(c_flush_view_of_file(base, 0))
        is None => return

### Writes the changed pages of a mapping back and unmaps it.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "windows")
secret routine unmap_mapping(base: Addr, bytes: U64) -> None
    c_flush_view_of_file(base, 0)
    c_unmap_view_of_file(base)
    return

### Asks the OS to read a whole mapping in now.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "windows")
secret routine prefetch_mapping(base: Addr, bytes: U64) -> None
    range: &MemoryRange <- MemoryRange(address: base, size: bytes)
    c_prefetch_virtual_memory(c_get_current_process(), 1, range, 0)
    return

### Tells the OS a mapping will be read front to back: a read-only mapping's file was already opened that way.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "windows")
secret routine advise_sequential_mapping(base: Addr, bytes: U64) -> None
    return

# -- partitions --------------------------------------------------------------------------

### The volume the file system at path is on, as the OS numbers it (its serial number).
### :param path: An existing path (a link counts as what it points at).
### :returns: The volume serial number.
### :throws: Throws the reason when the path can't be looked at.
@target(os: "windows")
secret failable routine device_id(path: @[Byte]) -> U64
    wpath: &Items[U16, PATH_CAPACITY] <- .hollow()
    info: &HandleInfo <- .hollow()

    if not wide_path(path, out: wpath.getview().to[@U16]())
        throw path_error(path)
    h: Addr = query_handle(wpath: wpath.getview().to[@U16](), link_itself: false)
    if is_invalid_handle(h)
        throw last_error()
    ok: CInt = c_get_file_information_by_handle(h, info)
    error: FsError = last_error()
    c_close_handle(h)
    if ok == 0
        throw error
    return info.volume_serial.peek().to[U64]()
