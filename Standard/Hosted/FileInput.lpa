# Lapila stdlib: reading an open file by line, word, and value
#
# A FileHandle reads as the console does (Stdio.lpa): read_line, read_word, and read[T] draw on one InputBuffer, the
# same code that finds lines and words in standard input, filled from the file. The buffer is made from HEAP on the
# first such read and given back by close. read_all and read_bytes(count, manager) take what the buffer
# holds first and then read the file on, and so does read_bytes(buffer, count), the Reader side, so the reads can be
# mixed in any order. seek counts the bytes the buffer holds and drops them, and a write puts the OS position back
# to where the program has read to first.
#
# read_line, read_word, and read[T] throw EndOfInputError at the end of the file, so `try h.read_line(manager)` is
# None there. The others give an empty result. A read the OS refuses throws its FsError, where the console reads a
# failure as the end.

module Hosted

### The bytes the input buffer holds that no read has taken.
### :returns: How many, 0 when no read by line, word, or value has made the buffer.
secret routine @FileHandle.held_input() -> U64
    at: Addr = me.input.peek()
    if at.is_hollow()
        return 0
    buffer: @InputBuffer = at.to[@InputBuffer]()
    return buffer.end.peek() - buffer.start.peek()

### The input buffer, made from HEAP on the first call.
### :returns: The buffer.
### :throws: Crashes with `OutOfMemoryError` when HEAP has no memory to give.
secret routine @FileHandle.input_buffer() -> @InputBuffer
    if me.input.peek().is_hollow()
        made: Addr = allocate[InputBuffer](count: 1, manager: HEAP)
        if made.is_hollow()
            throw OutOfMemoryError()
        fresh: @InputBuffer = made.to[@InputBuffer]()
        fresh.guard.poke(0)
        fresh.start.poke(0)
        fresh.end.poke(0)
        fresh.failed.poke(false)
        me.input.poke(made)
    return me.input.peek().to[@InputBuffer]()

### Gives the input buffer back to HEAP and leaves the handle without one. Does nothing when there is none.
secret routine @FileHandle.release_input() -> None
    at: Addr = me.input.peek()
    if at.is_hollow()
        return
    deallocate(data: at.to[@InputBuffer](), manager: HEAP)
    me.input.poke(Addr.zero())
    return

### Drops the bytes the input buffer holds and puts the OS position back to where the program has read to.
### :throws: Throws the reason when the OS refuses the move.
secret routine @FileHandle.discard_input() -> None
    held: U64 = me.held_input()
    if held == 0
        return
    buffer: @InputBuffer = me.input.peek().to[@InputBuffer]()
    back: S64 = 0 - held.to[S64]()
    moved: U64 = me.seek_os(offset: back, from: SeekFrom.CURRENT)
    buffer.start.poke(0)
    buffer.end.poke(0)
    return

### Throws the failure of a read from the file since the last call, and clears it. Does nothing when no read failed.
### :throws: Throws the {FsError} the read failed with.
secret routine @InputBuffer.throw_failure() -> None
    if not me.failed.peek()
        return
    me.failed.poke(false)
    throw me.failure.peek()

### The next line, without its "\n" (or "\r\n"), in memory from manager. A last line with no "\n" still counts, and a
### blank line is "". Drop it.
### :param manager: The memory manager for the line.
### :returns: The line.
### :throws: Throws `EndOfInputError` at the end of the file, the {FsError} a read fails with.
@expensive("allocates what it reads")
routine @FileHandle.read_line(manager: @MemoryManager) -> BorrowedSlice[Byte]
    buffer: @InputBuffer = me.input_buffer()

    line: &Optional[BorrowedSlice[Byte]] <- buffer.line(manager, me)
    when steal line
        is BorrowedSlice[Byte] as text =>
            when check buffer.throw_failure()
                is None => return text
                is FsError as error =>
                    drop text
                    throw error
        is None =>
            buffer.throw_failure()
            throw EndOfInputError(reader: "FileHandle.read_line")

### The next word (spaces, tabs, and line ends separate words), in memory from manager. The space after the word
### stays in the file. Drop it.
### :param manager: The memory manager for the word.
### :returns: The word.
### :throws: Throws `EndOfInputError` at the end of the file, the {FsError} a read fails with.
@expensive("allocates what it reads")
routine @FileHandle.read_word(manager: @MemoryManager) -> BorrowedSlice[Byte]
    buffer: @InputBuffer = me.input_buffer()

    word: &Optional[BorrowedSlice[Byte]] <- buffer.take_word(manager, me)
    when steal word
        is BorrowedSlice[Byte] as text =>
            when check buffer.throw_failure()
                is None => return text
                is FsError as error =>
                    drop text
                    throw error
        is None =>
            buffer.throw_failure()
            throw EndOfInputError(reader: "FileHandle.read_word")

### Skips white space and reads the next word as a T, straight from the input buffer: nothing is allocated unless the
### word is longer than the buffer. The space after the word stays in the file.
### :typeparam T: The type to read, a Parsable one (every integer and float type).
### :returns: The value.
### :throws: Throws `EndOfInputError` at the end of the file, the {FsError} a read fails with, and the failure of
###     `text.to[T]()` (`InvalidValueError`, `OutOfRangeError`) when the word isn't a T.
routine @FileHandle.read[T]() -> T
needs T obeys Parsable
    buffer: @InputBuffer = me.input_buffer()
    lateinit spill: &[Byte]

    word: Optional[@[Byte]] = buffer.word(spill, me)
    when check buffer.throw_failure()
        is None => nothing
        is FsError as error =>
            drop spill
            throw error
    when word
        is @[Byte] as text =>
            # The word may be a view of the buffer, so it's converted before anything reads the buffer again.
            converted: Check[T] = check text.to[T]()
            when converted
                is T as value =>
                    drop spill
                    return value
                is Crashables as error =>
                    drop spill
                    throw error
        is None =>
            drop spill
            throw EndOfInputError(reader: "FileHandle.read[T]")

### Moves the position: the new one, from the start, as the program sees it. The bytes the input buffer holds count as
### read and are dropped.
### :param offset: The distance to move, negative to go back.
### :param from: Where `offset` counts from.
### :returns: The new position from the start.
### :throws: Throws the reason, such as a position before the start.
@expensive("asks the operating system")
routine @FileHandle.seek(offset: S64, from: SeekFrom) -> U64
    held: U64 = me.held_input()
    relative: S64 = when from
        SeekFrom.CURRENT => offset - held.to[S64]()
        else => offset
    at: U64 = me.seek_os(offset: relative, from)
    if held > 0
        buffer: @InputBuffer = me.input.peek().to[@InputBuffer]()
        buffer.start.poke(0)
        buffer.end.poke(0)
    return at

### The Reader side: up to `count` bytes, what the input buffer holds first, else one read of the file.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at the end of the file.
### :throws: Throws the reason when the read fails.
@expensive("asks the operating system")
routine @FileHandle.read_bytes(buffer: @Byte, count: U64) -> U64
    held: U64 = me.held_input()
    if held == 0
        when check me.read_some(buffer, count)
            is U64 as returned => return returned
    held_buffer: @InputBuffer = me.input.peek().to[@InputBuffer]()
    n: U64 = held.min(count)
    from: U64 = held_buffer.start.peek()
    buffer.copy(src: held_buffer.bytes.getview().to[@Byte]().stride(from), count: n)
    held_buffer.start.poke(from + n)
    return n

### What the rest of the file is, in memory from manager. Drop it. Empty at the end of the file.
### :param manager: The memory manager for the bytes.
### :returns: The bytes from the position to the end of the file.
### :throws: Throws the reason when a read fails, `OutOfMemoryError` when `manager` fails.
@expensive("allocates what it reads")
routine @FileHandle.read_all(manager: @MemoryManager) -> BorrowedSlice[Byte]
    when check read_rest(f: me, manager)
        is BorrowedSlice[Byte] as text => return text

### Up to `count` bytes, in memory from manager: fewer only at the end of the file. Drop them.
### :param count: How many bytes to read.
### :param manager: The memory manager for the bytes.
### :returns: The bytes read.
### :throws: Throws the reason when a read fails, `OutOfMemoryError` when `manager` fails.
@expensive("allocates what it reads")
routine @FileHandle.read_bytes(count: U64, manager: @MemoryManager) -> BorrowedSlice[Byte]
    buffer: &[Byte] <- BorrowedSlice[Byte].construct(count: count.max(1), manager)

    until n == count with n: U64 = 0
        got: Check[U64] = check me.read_bytes(buffer: buffer.getslot(n), count: count - n)
        k: U64 = when got
            is U64 as k => k
            is FsError as error =>
                drop buffer
                throw error
        if k == 0
            buffer.keep_first(n)
            return buffer
        continue with n: n + k
    then
        buffer.keep_first(n)
        return buffer
