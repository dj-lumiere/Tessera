    return (runner, discard, place)

# -- Work[T]: a piece of work made before it runs ----------------------------------------------------------------

### A piece of work: a routine and its arguments, made with `f.to[Work](name: value, ...)`, the arguments named by the
### routine's parameters. A plain value bound with `=`: its block (the routine, its arguments and room for the result,
### a size the build knows) is in the frame of the routine that made it. `t.put_work(work)` starts it on a ticket, which
### runs a copy of the block, and the ticket's `retrieve()` waits for it and gives the result. Work with an argument
### that has something to give back runs once: the build checks that it goes to one ticket with
### `t.put_work(steal work)` on every path.
### :typeparam T: The type of the work's result, `None` for none.
record Work[T]
    ### Runs a block: calls the routine with the arguments and stores the result in front.
    runner: Callable[(Addr,), None]
    ### Destructs a block: what a ticket calls for a result nobody retrieved, before the block goes back.
    discard: Callable[(Addr,), None]
    ### The block the work was made in: the routine, its arguments and room for its result.
    block: @Byte
    ### The block's size in bytes, for the copy a ticket runs.
    size: U64
    ### The block's alignment.
    align: U64

### Work put on, or asked of, a ticket that was given back.
crashable TicketGivenBackError
    ### What happened, in a sentence.
    description: @[Byte]

### Work put on a ticket, or a ticket given back, while its last work runs.
crashable TicketBusyError
    ### What happened, in a sentence.
    description: @[Byte]

### A result asked of a ticket that runs no work.
crashable NoWorkError
    ### What happened, in a sentence.
    description: @[Byte]

### The work made in `block`: what `f.to[Work](...)` stands for. The builder makes the block in the routine's frame
### and calls this.
### :typeparam T: The work's result type.
### :typeparam B: The block's type.
### :param made: The block: the routine, its arguments, room for the result.
### :param runner: Runs a block of this type.
### :param discard: Destructs a block of this type.
### :returns: The work, not started.
routine work_from[T, B](made: @B, runner: Callable[(Addr,), None],
    discard: Callable[(Addr,), None]) -> Work[T]
    return Work[T](runner, discard, block: made.to[@Byte](), size: sizeof[B](), align: alignof[B]())

### A copy of the work's block in memory from the slot's manager, which the slot gives back with its next work or when
### its ticket is given back. Work that runs once was handed over with steal, so its block in the frame isn't read again.
### :param slot: The slot the work runs in.
### :returns: The copy.
### :throws: Crashes with `OutOfMemoryError` when the slot's manager has no memory for it.
@track_caller
routine Work[T].copy_for(slot: @WorkSlot) -> Addr
    copy: Addr = slot.manager.peek().borrow(size: me.size, align: me.align)
    if copy.is_hollow()
        throw OutOfMemoryError()
    copy.to[@Byte]().copy(src: me.block, count: me.size)
    return copy

### Writes the description.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine TicketGivenBackError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.description}")
    return

### Writes the description.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine TicketBusyError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.description}")
    return

### Writes the description.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NoWorkError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.description}")
    return
