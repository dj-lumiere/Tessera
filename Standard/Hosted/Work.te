# Tessera stdlib: the work a ticket runs
#
# A piece of work is a routine and its arguments, `Work[T]`, made with `f.to[Work](name: value, ...)`: a value bound
# with `=`. Work whose arguments have nothing to give back is copied onto each ticket it goes on. Work with an argument
# that has something to give back runs once, handed to its ticket with `steal`. A ticket is one flow of execution that a manager hands out, borrowed with
# `<-` and given back with `drop`: a thread from a ThreadManager (`Thread[T]`), a fiber from a CoroutineManager
# (`Fiber[T]`), or a passable fiber from a ThreadPoolManager (`PassableFiber[T]`), which the pool's threads hand
# between them. A ticket runs one piece of work at a time:
#
#     t: Thread[S64] <- get_thread[S64]()
#     primes: Work[S64] = count_primes.to[Work](table: table, limit: 1000)
#     t.put_work(primes)   # runs from here on
#     # ... other work, check_finished() to look without waiting
#     count: S64 = t.retrieve()   # waits for the work, then gives its result
#     drop t
#
# `t.waitfor(5s).retrieve()` waits at most 5 seconds and throws `TaskTimeoutError` when the time runs out first (`try`
# gives `None`). A `retrieve()` in work that is asked to stop with `cancel()` stops waiting and throws
# `CancelRequested`, and so does one whose own work was cancelled. The same ticket takes more work after a
# `retrieve()`, one piece after another.
#
# `drop t` is the ticket's destruct. The result `retrieve()` moves out leaves its place hollow, and a result nobody
# retrieved (the work was cancelled, the ticket is dropped first, or more work is put on it) is destructed through the
# block's destruct before the block goes back. The arguments went to the work's routine when it ran, and the routine
# ends them, on its cancelled path too.
#
# This file holds what the tickets share: the WorkSlot a ticket's work lives in (its state, the block that holds the
# routine, its arguments and the room for its result, a cancel request, the deadline of the next `retrieve()`, and a
# fiber waiting for it), the blocks for each number of arguments, and `cancel_requested()`, which the work itself asks.

module Hosted

### The slot of the work running on this thread (a thread worker's, or the fiber's that runs), or null.
@threadlocal
@target(os: not "none")
global RUNNING_WORK: &@WorkSlot

### Released before a thread worker takes the next ticket's work: what that work left in this thread's `@threadlocal`
### globals and still owns (the thread's CoroutineManager), or null. Whatever makes such a value sets it.
@threadlocal
@target(os: not "none")
global THREAD_CLEANUP: &Callable[(), None]

### A ticket with no work yet: the next may go on.
preset TICKET_EMPTY: U32 = 0
### A ticket whose work runs.
preset TICKET_RUNNING: U32 = 1
### A ticket whose work has finished: its result waits for `retrieve`, and the next work may go on.
preset TICKET_DONE: U32 = 2
### A ticket given back to its manager.
preset TICKET_IDLE: U32 = 3
### A thread worker its manager told to end.
preset TICKET_QUIT: U32 = 4
### `retrieve` waited and the work has finished.
preset WAITED_FINISHED: U32 = 0
### `retrieve` stopped waiting: the deadline `waitfor` set has passed.
preset WAITED_TIMED_OUT: U32 = 1
### `retrieve` stopped waiting: the work that waits was asked to stop with `cancel()`.
preset WAITED_CANCELLED: U32 = 2

### Where a ticket's work lives: a thread worker and a fiber each have one, and the ticket names it.
entity WorkSlot
    ### `TICKET_EMPTY`, `TICKET_RUNNING`, `TICKET_DONE`, `TICKET_IDLE` or `TICKET_QUIT`. A thread waits on it.
    state: U32
    ### Runs the work in `work`: calls its routine with its arguments and stores the result in front.
    runner: Callable[(Addr,), None]
    ### Ends what the block in `work` still holds (a result nobody retrieved) through the block's destruct.
    discard: Callable[(Addr,), None]
    ### The block of the work, from `manager`, or null.
    work: Addr
    ### The memory manager the work's blocks come from: the thread or coroutine manager's.
    manager: @MemoryManager
    ### 1 once `cancel()` asked the work to stop.
    cancel: U32
    ### The byte whose exclusive access guards `waiter`.
    guard: U8
    ### Whoever waits for the work to finish, or a hollow Waiter.
    waiter: Waiter
    ### The work's own waiter while it is in a cancellable wait, which `cancel()` wakes, or a hollow Waiter.
    blocked: Waiter
    ### The number of the ticket that holds the slot. `give_back` changes it, so an old ticket no longer matches.
    issued: U64
    ### When the next `retrieve()` stops waiting (in `Clock.monotonic()` time), set by `waitfor`, or `Duration.MAX`.
    deadline: Duration

### What `retrieve` throws for work that was asked to stop with `cancel()` before it finished, and in work that is
### asked to stop while it waits.
crashable CancelRequested
    nothing

### What `t.waitfor(timeout).retrieve()` throws when the time runs out before the work has finished.
crashable TaskTimeoutError
    nothing

### Writes `The work was asked to stop with cancel().`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine CancelRequested.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The work was asked to stop with cancel() before it finished.")
    return

### Writes `The work didn't finish before the deadline waitfor() set.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine TaskTimeoutError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The work didn't finish before the deadline waitfor() set.")
    return

### An empty slot whose work blocks come from `manager`.
### :param manager: Where the work's blocks come from.
### :returns: The slot.
common routine WorkSlot.construct(manager: @MemoryManager) -> Me
    return Me(state: TICKET_EMPTY, runner: no_work.to[Callable](), discard: no_work.to[Callable](),
        work: .hollow(), manager, cancel: 0, guard: 0, waiter: .hollow(), blocked: .hollow(),
        issued: 0, deadline: Duration.MAX)

### Ends what the last work's block still holds and gives the block back.
routine @WorkSlot.destruct() -> None
    me.free_work()
    return

### The work of a slot that has none.
### :param work: Ignored.
secret routine no_work(work: Addr) -> None
    return

### Whether the running work was asked to stop with `cancel()`. The work looks at it where stopping is safe, cleans up
### what it holds, and returns. False outside a ticket's work.
### :returns: True once its ticket was cancelled.
@target(os: not "none")
routine cancel_requested() -> Bool
    slot: @WorkSlot = RUNNING_WORK.peek()
    if slot.is_hollow()
        return false
    return slot.cancel.peek_unbroken() == 1

### Crashes unless the ticket numbered `issued` still holds the slot.
### :param issued: The ticket's number.
### :throws: Crashes with `TicketGivenBackError` for a ticket that was given back.
@track_caller
routine @WorkSlot.check_ticket(issued: U64) -> None
    if me.issued.peek() == issued
        return
    throw TicketGivenBackError(description: "This ticket was given back: get another one for more work.")

### Crashes when work runs: a ticket runs one piece of work at a time.
### :throws: Crashes with `TicketBusyError` while the work runs.
@track_caller
routine @WorkSlot.check_free() -> None
    if me.state.peek_unbroken() == TICKET_RUNNING
        throw TicketBusyError(description: "This ticket's work hasn't finished: a ticket runs one piece of work at a time, so retrieve() first.")
    return

### Starts the work in `work`, run by `runner`, in place of the last one: a result of the last one that nobody
### retrieved is destructed, and its block goes back.
### :param runner: Runs the work.
### :param discard: Destructs the block, for a result nobody retrieves.
### :param work: Its block, from the slot's memory manager.
### :throws: Crashes with `TicketBusyError` while the last work runs.
@track_caller
routine @WorkSlot.put(runner: Callable[(Addr,), None], discard: Callable[(Addr,), None],
    work: Addr) -> None
    me.check_free()
    me.free_work()
    me.runner.poke(runner)
    me.discard.poke(discard)
    me.work.poke(work)
    me.cancel.poke_unbroken(0)
    me.blocked.poke(.hollow())
    me.state.poke_unbroken(TICKET_RUNNING)
    wake_all(me.state)
    return

### Destructs the block of the last work, if there is one, and gives it back: a result nobody retrieved ends there. A
### result `retrieve` took left a hollow place, which the destruct leaves alone, and the arguments went to the work's
### routine when it ran.
routine @WorkSlot.free_work() -> None
    work: Addr = me.work.peek()
    if work.is_hollow()
        return
    me.discard.peek().call(work)
    deallocate(data: work.to[@Byte](), manager: me.manager.peek())
    me.work.poke(.hollow())
    return

### Whether no work runs: it finished, or there was none.
### :returns: True unless the work runs.
routine @WorkSlot.is_finished() -> Bool
    return me.state.peek_unbroken() != TICKET_RUNNING

### Waits until the work has finished, for the standard library's own waits that must see the work end (its block may
### point into the waiting fiber's stack). A fiber parks and the thread goes on with its manager's other fibers. A
### thread sleeps.
@target(os: not "none")
routine @WorkSlot.wait() -> None
    me.wait_until(deadline: Duration.MAX, cancellable: false)
    return

### Makes the next `retrieve()` stop waiting once `timeout` has passed.
### :param timeout: The longest wait, from now.
@target(os: not "none")
routine @WorkSlot.set_deadline(timeout: Duration) -> None
    me.deadline.poke(Clock.monotonic() +^ timeout)
    return

### The wait of a ticket's `retrieve()`: until the work has finished, the deadline `waitfor` set has passed, or the
### work that waits is asked to stop with `cancel()`, whichever comes first. The deadline holds for this one wait.
### :returns: `WAITED_FINISHED`, `WAITED_TIMED_OUT` or `WAITED_CANCELLED`.
@target(os: not "none")
routine @WorkSlot.wait_to_retrieve() -> U32
    deadline: Duration = me.deadline.peek()
    me.deadline.poke(Duration.MAX)
    if me.wait_until(deadline, cancellable: true)
        return WAITED_FINISHED
    if Clock.monotonic() >= deadline
        return WAITED_TIMED_OUT
    return WAITED_CANCELLED

### Waits until the work has finished, `deadline` (in `Clock.monotonic()` time, `Duration.MAX` for none) has passed, or, when
### `cancellable`, the work that waits was asked to stop with `cancel()`, whichever comes first.
### :param deadline: When to stop waiting.
### :param cancellable: True to stop waiting when the waiting work is cancelled.
### :returns: True when the work has finished.
@target(os: not "none")
routine @WorkSlot.wait_until(deadline: Duration, cancellable: Bool) -> Bool
    waiter: Waiter = current_waiter()

    # The waiter goes in under the exclusive access, which `complete` takes after it marks the work done: either this
    # sees it done, or `complete` sees the waiter. One left behind when the wait ends otherwise only wakes it once more later,
    # which a park allows.
    loop
        held: Authorized[U8] <- me.guard.get_exclusive_access()
        if me.is_finished()
            drop held
            break
        me.waiter.poke(waiter)
        drop held
        if Clock.monotonic() >= deadline
            return false
        if cancellable
            if blocked_until_cancelled(waiter)
                return false
        waiter.park_until(deadline)
        continue
    return true

### Whether the running work was asked to stop, after making `waiter` the one `cancel()` wakes while it waits.
### :param waiter: The waiter of the running work.
### :returns: True when it was asked to stop: the wait ends.
@target(os: not "none")
@noinline
routine blocked_until_cancelled(waiter: Waiter) -> Bool
    slot: @WorkSlot = RUNNING_WORK.peek()
    if slot.is_hollow()
        return false
    held: Authorized[U8] <- slot.guard.get_exclusive_access()
    slot.blocked.poke(waiter)
    drop held
    return slot.is_cancelled()

### Makes `waiter` the one woken when the work finishes, unless it has: for a wait on several tickets at once.
### :param waiter: The waiter.
### :returns: True when the work has finished already (`waiter` isn't kept).
@target(os: not "none")
routine @WorkSlot.register(waiter: Waiter) -> Bool
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    if me.is_finished()
        drop held
        return true
    me.waiter.poke(waiter)
    drop held
    return false

### Forgets `waiter` if it is the one woken when the work finishes: a wait on several tickets that is over.
### :param waiter: The waiter.
@target(os: not "none")
routine @WorkSlot.unregister(waiter: Waiter) -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    if me.waiter.peek() == waiter
        me.waiter.poke(.hollow())
    drop held
    return

### Marks the work finished and wakes whoever waits for it: the thread that runs it calls this once the routine
### returns.
@target(os: not "none")
routine @WorkSlot.complete() -> None
    me.state.poke_unbroken(TICKET_DONE)
    wake_all(me.state)
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    waiter: Waiter = me.waiter.peek()
    me.waiter.poke(.hollow())
    drop held
    waiter.wake()
    return

### The place of the finished work's result, the front of its block.
### :typeparam T: The result type.
### :returns: The place.
### :throws: Crashes with `NoWorkError` when no work was put on the ticket.
@track_caller
routine @WorkSlot.result_place[T]() -> @T
needs AnyType T
    if not (me.state.peek_unbroken() == TICKET_DONE)
        throw NoWorkError(description: "This ticket has no work to retrieve: put_work() comes first.")
    return me.work.peek().to[@T]()

### Leaves the result's place hollow once `retrieve` took the result out, so the block's destruct doesn't end it again.
### :typeparam T: The result type.
routine @WorkSlot.result_taken[T]() -> None
needs AnyType T
    me.work.peek().to[@T]().zeroinit(1)
    return

### Whether `cancel()` asked the work to stop.
### :returns: True once it did.
routine @WorkSlot.is_cancelled() -> Bool
    return me.cancel.peek_unbroken() == 1

### Asks the work to stop: `cancel_requested()` turns true inside it, and a cancellable wait it is in (a ticket's
### `retrieve()`, a channel's transmit or receive) ends.
@target(os: not "none")
routine @WorkSlot.request_cancel() -> None
    me.cancel.poke_unbroken(1)
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    blocked: Waiter = me.blocked.peek()
    drop held
    blocked.wake()
    return

### Ends the ticket that holds the slot: destructs the last work's block (a result nobody retrieved ends there), gives
### it back, and gives the slot a new number.
### :throws: Crashes with `TicketBusyError` while the work runs.
@track_caller
routine @WorkSlot.give_back() -> None
    if me.state.peek_unbroken() == TICKET_RUNNING
        throw TicketBusyError(description: "This ticket's work hasn't finished: retrieve() before drop, so nothing it still uses goes away.")
    me.free_work()
    me.issued.poke(me.issued.peek() + 1)
    me.state.poke_unbroken(TICKET_IDLE)
    return

# -- the blocks of work, by number of arguments -----------------------------------------------------------------

### The work a ticket runs: a routine of 0 argument(s), its result first.
entity Work0[T]
    result: T
    entry: Callable[(), T]

### The work a ticket runs: a routine of 1 argument(s), its result first.
entity Work1[T, A]
    result: T
    entry: Callable[(A,), T]
    first: A

### The work a ticket runs: a routine of 2 argument(s), its result first.
entity Work2[T, A, B]
    result: T
    entry: Callable[(A, B), T]
    first: A
    second: B

### The work a ticket runs: a routine of 3 argument(s), its result first.
entity Work3[T, A, B, C]
    result: T
    entry: Callable[(A, B, C), T]
    first: A
    second: B
    third: C

### The work a ticket runs: a routine of 4 argument(s), its result first.
entity Work4[T, A, B, C, D]
    result: T
    entry: Callable[(A, B, C, D), T]
    first: A
    second: B
    third: C
    fourth: D

### The work a ticket runs: a routine of 0 argument(s), no result.
entity VoidWork0
    entry: Callable[(), None]

### The work a ticket runs: a routine of 1 argument(s), no result.
entity VoidWork1[A]
    entry: Callable[(A,), None]
    first: A

### The work a ticket runs: a routine of 2 argument(s), no result.
entity VoidWork2[A, B]
    entry: Callable[(A, B), None]
    first: A
    second: B

### The work a ticket runs: a routine of 3 argument(s), no result.
entity VoidWork3[A, B, C]
    entry: Callable[(A, B, C), None]
    first: A
    second: B
    third: C

### The work a ticket runs: a routine of 4 argument(s), no result.
entity VoidWork4[A, B, C, D]
    entry: Callable[(A, B, C, D), None]
    first: A
    second: B
    third: C
    fourth: D

### Whether the value at `at` is hollow, all of its bytes zero: a place a block's destruct leaves alone.
### :typeparam T: The value's type.
### :param at: The value.
### :returns: True when every byte is zero.
secret routine is_hollow_value[T](at: @T) -> Bool
    # Through Addr: a T with its own to[...] (a @[Byte]) would convert itself instead of its place.
    place: Addr = at
    bytes: @Byte = place.to[@Byte]()

    for i in 0 til sizeof[T]()
        if bytes.stride(i).peek() != 0x00
            return false
    then
        return true

### Makes a `Work0` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :returns: The new value.
common routine Work0[T].construct(result: T, entry: Callable[(), T]) -> Me
    return Me(result: steal result, entry)

### Ends what the block still holds, the last field first: the result nobody retrieved, or the arguments of work
### that never ran. A hollow place (an argument the work's routine took, a result `retrieve` took out) is left alone.
routine @Work0[T].destruct() -> None
    if not is_hollow_value(me.result)
        drop me.result
    return

### Ends what the block at `raw`, a `Work0`, still holds, through its destruct: a ticket calls it before it gives
### the block back.
### :param raw: The block.
routine discard_work0[T](raw: Addr) -> None
    work: @Work0[T] = raw.to[@Work0[T]]()
    drop work.stride(0)
    return

### Runs the work in the block at `raw`, a `Work0`, and stores its result there.
### :param raw: The block.
routine run_work0[T](raw: Addr) -> None
    work: @Work0[T] = raw.to[@Work0[T]]()
    entry: Callable[(), T] = work.entry.peek()
    value: &T <- entry.call()
    result: @T = work.result
    result.poke(steal value)
    return

### The block for `entry` and its arguments, from `manager`, its runner and its destruct: what a ticket's `put_callable`
### hands over.
### :param entry: The routine.
### :param manager: Where the block comes from.
### :returns: The runner, the destruct of the block and the block.
### :throws: Crashes with `OutOfMemoryError` when `manager` can't give the block.
@track_caller
routine make_work0[T](entry: Callable[(), T],
    manager: @MemoryManager) -> (Callable[(Addr,), None], Callable[(Addr,), None], Addr)
    work: @Work0[T] = allocate[Work0[T]](count: 1, manager)
    if work.is_hollow()
        throw OutOfMemoryError()
    work.result.zeroinit(1)
    work.entry.poke(entry)
    runner: Callable[(Addr,), None] = run_work0[T].to[Callable]()
    place: Addr = work
    discard: Callable[(Addr,), None] = discard_work0[T].to[Callable]()
    return (runner, discard, place)

### Makes a `Work1` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :returns: The new value.
common routine Work1[T, A].construct(result: T, entry: Callable[(A,), T], first: A) -> Me
    return Me(result: steal result, entry, first: steal first)

### Ends what the block still holds, the last field first: the result nobody retrieved, or the arguments of work
### that never ran. A hollow place (an argument the work's routine took, a result `retrieve` took out) is left alone.
routine @Work1[T, A].destruct() -> None
    if not is_hollow_value(me.first)
        drop me.first
    if not is_hollow_value(me.result)
        drop me.result
    return

### Ends what the block at `raw`, a `Work1`, still holds, through its destruct: a ticket calls it before it gives
### the block back.
### :param raw: The block.
routine discard_work1[T, A](raw: Addr) -> None
    work: @Work1[T, A] = raw.to[@Work1[T, A]]()
    drop work.stride(0)
    return

### Runs the work in the block at `raw`, a `Work1`, and stores its result there.
### :param raw: The block.
routine run_work1[T, A](raw: Addr) -> None
    work: @Work1[T, A] = raw.to[@Work1[T, A]]()
    entry: Callable[(A,), T] = work.entry.peek()
    first: @A = work.first
    value: &T <- entry.call(steal first.stride(0))
    # The arguments are the routine's now: their places in the block are left hollow, which its destruct leaves alone.
    first.zeroinit(1)
    result: @T = work.result
    result.poke(steal value)
    return

### The block for `entry` and its arguments, from `manager`, its runner and its destruct: what a ticket's `put_callable`
### hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner, the destruct of the block and the block.
### :throws: Crashes with `OutOfMemoryError` when `manager` can't give the block.
@track_caller
routine make_work1[T, A](entry: Callable[(A,), T], args: A,
    manager: @MemoryManager) -> (Callable[(Addr,), None], Callable[(Addr,), None], Addr)
    work: @Work1[T, A] = allocate[Work1[T, A]](count: 1, manager)
    if work.is_hollow()
        throw OutOfMemoryError()
    work.result.zeroinit(1)
    work.entry.poke(entry)
    work.first.poke(args)
    runner: Callable[(Addr,), None] = run_work1[T, A].to[Callable]()
    place: Addr = work
    discard: Callable[(Addr,), None] = discard_work1[T, A].to[Callable]()
    return (runner, discard, place)

### Makes a `Work2` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
common routine Work2[T, A, B].construct(result: T, entry: Callable[(A, B), T], first: A,
    second: B) -> Me
    return Me(result: steal result, entry, first: steal first, second: steal second)

### Ends what the block still holds, the last field first: the result nobody retrieved, or the arguments of work
### that never ran. A hollow place (an argument the work's routine took, a result `retrieve` took out) is left alone.
routine @Work2[T, A, B].destruct() -> None
    if not is_hollow_value(me.second)
        drop me.second
    if not is_hollow_value(me.first)
        drop me.first
    if not is_hollow_value(me.result)
        drop me.result
    return

### Ends what the block at `raw`, a `Work2`, still holds, through its destruct: a ticket calls it before it gives
### the block back.
### :param raw: The block.
routine discard_work2[T, A, B](raw: Addr) -> None
    work: @Work2[T, A, B] = raw.to[@Work2[T, A, B]]()
    drop work.stride(0)
    return

### Runs the work in the block at `raw`, a `Work2`, and stores its result there.
### :param raw: The block.
routine run_work2[T, A, B](raw: Addr) -> None
    work: @Work2[T, A, B] = raw.to[@Work2[T, A, B]]()
    entry: Callable[(A, B), T] = work.entry.peek()
    first: @A = work.first
    second: @B = work.second
    value: &T <- entry.call(steal first.stride(0), steal second.stride(0))
    # The arguments are the routine's now: their places in the block are left hollow, which its destruct leaves alone.
    first.zeroinit(1)
    second.zeroinit(1)
    result: @T = work.result
    result.poke(steal value)
    return

### The block for `entry` and its arguments, from `manager`, its runner and its destruct: what a ticket's `put_callable`
### hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner, the destruct of the block and the block.
### :throws: Crashes with `OutOfMemoryError` when `manager` can't give the block.
@track_caller
routine make_work2[T, A, B](entry: Callable[(A, B), T], args: (A, B),
    manager: @MemoryManager) -> (Callable[(Addr,), None], Callable[(Addr,), None], Addr)
    work: @Work2[T, A, B] = allocate[Work2[T, A, B]](count: 1, manager)
    if work.is_hollow()
        throw OutOfMemoryError()
    work.result.zeroinit(1)
    work.entry.poke(entry)
    work.first.poke(args.item0)
    work.second.poke(args.item1)
    runner: Callable[(Addr,), None] = run_work2[T, A, B].to[Callable]()
    place: Addr = work
    discard: Callable[(Addr,), None] = discard_work2[T, A, B].to[Callable]()
    return (runner, discard, place)

### Makes a `Work3` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :param second: Its `second`.
### :param third: Its `third`.
### :returns: The new value.
common routine Work3[T, A, B, C].construct(result: T, entry: Callable[(A, B, C), T], first: A,
    second: B, third: C) -> Me
    return Me(result: steal result, entry, first: steal first, second: steal second,
        third: steal third)

### Ends what the block still holds, the last field first: the result nobody retrieved, or the arguments of work
### that never ran. A hollow place (an argument the work's routine took, a result `retrieve` took out) is left alone.
routine @Work3[T, A, B, C].destruct() -> None
    if not is_hollow_value(me.third)
        drop me.third
    if not is_hollow_value(me.second)
        drop me.second
    if not is_hollow_value(me.first)
        drop me.first
    if not is_hollow_value(me.result)
        drop me.result
    return

### Ends what the block at `raw`, a `Work3`, still holds, through its destruct: a ticket calls it before it gives
### the block back.
### :param raw: The block.
routine discard_work3[T, A, B, C](raw: Addr) -> None
    work: @Work3[T, A, B, C] = raw.to[@Work3[T, A, B, C]]()
    drop work.stride(0)
    return

### Runs the work in the block at `raw`, a `Work3`, and stores its result there.
### :param raw: The block.
routine run_work3[T, A, B, C](raw: Addr) -> None
    work: @Work3[T, A, B, C] = raw.to[@Work3[T, A, B, C]]()
    entry: Callable[(A, B, C), T] = work.entry.peek()
    first: @A = work.first
    second: @B = work.second
    third: @C = work.third
    value: &T <- entry.call(steal first.stride(0), steal second.stride(0), steal third.stride(0))
    # The arguments are the routine's now: their places in the block are left hollow, which its destruct leaves alone.
    first.zeroinit(1)
    second.zeroinit(1)
    third.zeroinit(1)
    result: @T = work.result
    result.poke(steal value)
    return

### The block for `entry` and its arguments, from `manager`, its runner and its destruct: what a ticket's `put_callable`
### hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner, the destruct of the block and the block.
### :throws: Crashes with `OutOfMemoryError` when `manager` can't give the block.
@track_caller
routine make_work3[T, A, B, C](entry: Callable[(A, B, C), T], args: (A, B, C),
    manager: @MemoryManager) -> (Callable[(Addr,), None], Callable[(Addr,), None], Addr)
    work: @Work3[T, A, B, C] = allocate[Work3[T, A, B, C]](count: 1, manager)
    if work.is_hollow()
        throw OutOfMemoryError()
    work.result.zeroinit(1)
    work.entry.poke(entry)
    work.first.poke(args.item0)
    work.second.poke(args.item1)
    work.third.poke(args.item2)
    runner: Callable[(Addr,), None] = run_work3[T, A, B, C].to[Callable]()
    place: Addr = work
    discard: Callable[(Addr,), None] = discard_work3[T, A, B, C].to[Callable]()
    return (runner, discard, place)

### Makes a `Work4` from its fields.
