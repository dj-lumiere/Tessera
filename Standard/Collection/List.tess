// Tessera stdlib collection: List<T>
//
// Dynamic array. The allocator is stored in the record; callers do not pass it
// to individual operations.

module Standard::Collections

import Standard::Alloc
import Standard::Format

/// A growable array of `T` stored contiguously on the heap. The allocator is kept in the record, so operations do not take one. The buffer grows by doubling, and the list is released with `destruct`.
/// :typeparam T: The element type.
record List<T>
conform Destruct<List<T>>
conform Equal<List<T>>     when T: typename, Equal<T>
conform Represent<List<T>> when T: typename, Diagnose<T>
conform Diagnose<List<T>>  when T: typename, Diagnose<T>
require T: typename
    data     : @T
    length   : USize
    capacity : USize
    alloc    : @Allocator

/// Creates an empty List that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the list stores and later frees its memory with.
/// :returns: A new empty List.
routine List<T>.construct(alloc: @Allocator) -> Self
require T: typename
    block entry():
        list : Self = Self { data: null, length: 0, capacity: 0, alloc: alloc }
        return(list)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine List<T>.length(self: Self) -> USize
require T: typename
    block entry():
        length : USize = self.length
        return(length)

/// Whether the list holds no elements.
/// :returns: `true` when the length is `0`.
routine List<T>.is_empty(self: Self) -> Bool
require T: typename
    block entry():
        length : USize = self.length
        empty  : Bool  = length.eq(0)
        return(empty)

/// Grows the buffer to hold at least `capacity` elements without further allocation. A smaller request leaves the buffer unchanged.
/// :param capacity: The number of elements to make room for.
/// :throws: Traps with `TrapCode.AllocFailed` when the allocator fails. See {List<T>.reserve_result} for a recoverable form.
#track_caller
routine List<T>.reserve(self: @Self, capacity: USize) -> Void
require T: typename
    block entry():
        reserved : Bool = self.make_capacity(capacity)
        branch reserved
            ? return()
            : panic(TrapCode.AllocFailed)

/// `reserve`, returning a Failure instead of trapping when the allocator fails.
routine List<T>.reserve_result(self: @Self, capacity: USize) -> Result<Unit, AllocFailed>
require T: typename
    block entry():
        reserved : Bool = self.make_capacity(capacity)
        branch reserved
            ? return(.Success(Unit.value()))
            : return(.Failure(AllocFailed {}))

/// Grows the buffer to at least capacity elements. Returns false when the
/// allocator fails, leaving the list as it was.
private routine List<T>.make_capacity(self: @Self, capacity: USize) -> Bool
require T: typename
    block entry():
        old_capacity : USize = self.capacity.load()
        enough       : Bool  = old_capacity.ge(capacity)
        branch enough
            ? return(true)
            : grow(capacity)

    block grow(capacity: USize):
        alloc    : @Allocator = self.alloc.load()
        old_data : @T         = self.data.load()
        new_data : @T         = reallocate<T>(alloc, old_data, capacity)
        failed   : Bool       = new_data.is_null()
        branch failed
            ? return(false)
            : install(new_data, capacity)

    block install(new_data: @T, capacity: USize):
        self.data.store(new_data)
        self.capacity.store(capacity)
        return(true)

/// Makes room for `wanted` elements, starting at 4 slots and doubling until the request fits.
/// :param wanted: The element count the buffer must hold.
/// :throws: Traps with `TrapCode.AllocFailed` when the allocator fails.
#track_caller
routine List<T>.ensure_capacity(self: @Self, wanted: USize) -> Void
require T: typename
    block entry():
        room : Bool = self.make_room(wanted)
        branch room
            ? return()
            : panic(TrapCode.AllocFailed)

/// Makes room for wanted elements, doubling the capacity. Returns false when
/// the allocator fails, leaving the list as it was.
private routine List<T>.make_room(self: @Self, wanted: USize) -> Bool
require T: typename
    block entry():
        capacity : USize = self.capacity.load()
        enough   : Bool  = capacity.ge(wanted)
        branch enough
            ? return(true)
            : choose(capacity, wanted)

    block choose(capacity: USize, wanted: USize):
        empty : Bool = capacity.eq(0)
        branch empty
            ? initial(wanted)
            : double(capacity, wanted)

    block initial(wanted: USize):
        base         : USize = 4
        use_wanted   : Bool  = wanted.gt(base)
        new_capacity : USize = use_wanted
            ? wanted
            : base
        return(self.make_capacity(new_capacity))

    block double(capacity: USize, wanted: USize):
        next   : USize = capacity.mul(2)
        enough : Bool  = next.ge(wanted)
        branch enough
            ? return(self.make_capacity(next))
            : double(next, wanted)

/// Appends `value` after the last element, growing the buffer when it is full.
/// :param value: The element to append.
/// :throws: Traps with `TrapCode.AllocFailed` when the allocator fails. See {List<T>.push_result} for a recoverable form.
#track_caller
routine List<T>.push(self: @Self, value: T) -> Void
require T: typename
    block entry():
        pushed : Result<Unit, AllocFailed> = self.push_result(value)
        when pushed:
            .Success -> return()
            .Failure -> panic(TrapCode.AllocFailed)

/// `push`, returning a Failure instead of trapping when the allocator fails.
routine List<T>.push_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry():
        length : USize = self.length.load()
        wanted : USize = length.add(1)
        room   : Bool  = self.make_room(wanted)
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data : @T = self.data.load()
        data.stride(length).store(value)
        self.length.store(wanted)
        return(.Success(Unit.value()))

/// Removes the last element and returns it.
/// :returns: The removed element.
/// :throws: Traps with `TrapCode.Empty` when the list is empty. See {List<T>.pop_checked}.
#track_caller
routine List<T>.pop(self: @Self) -> T
require T: typename
    block entry():
        popped : Option<T> = self.pop_checked()
        when popped:
            .Present(value) -> return(value)
            .Absent         -> panic(TrapCode.Empty)

/// `pop`, returning Absent instead of trapping on an empty list.
routine List<T>.pop_checked(self: @Self) -> Option<T>
require T: typename
    block entry():
        length : USize = self.length.load()
        empty  : Bool  = length.eq(0)
        branch empty
            ? return(.Absent)
            : pop(length)

    block pop(length: USize):
        index : USize = length.sub(1)
        data  : @T    = self.data.load()
        value : T     = data.stride(index).load()
        self.length.store(index)
        return(.Present(value))

/// Reads the element at `index`.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Traps with `TrapCode.Bounds` when `index >= length`. See {List<T>.get_checked}.
#track_caller
routine List<T>.get(self: Self, index: USize) -> T
require T: typename
    block entry():
        length    : USize = self.length
        in_bounds : Bool  = index.lt(length)
        branch in_bounds
            ? load(index)
            : panic(TrapCode.Bounds)

    block load(index: USize):
        data  : @T = self.data
        value : T  = data.stride(index).load()
        return(value)

/// `get`, returning Absent instead of trapping on an index past the end.
routine List<T>.get_checked(self: Self, index: USize) -> Option<T>
require T: typename
    block entry():
        length    : USize = self.length
        in_bounds : Bool  = index.lt(length)
        branch in_bounds
            ? load(index)
            : return(.Absent)

    block load(index: USize):
        data  : @T = self.data
        value : T  = data.stride(index).load()
        return(.Present(value))

/// The address of element index, checked like get: a place to read or write in place. It stays valid until the list grows, shrinks, or is destructed.
#track_caller
routine List<T>.at(self: Self, index: USize) -> @T
require T: typename
    block entry():
        length    : USize = self.length
        in_bounds : Bool  = index.lt(length)
        branch in_bounds
            ? address(index)
            : panic(TrapCode.Bounds)

    block address(index: USize):
        data    : @T = self.data
        element : @T = data.stride(index)
        return(element)

/// `at`, returning Absent instead of trapping on an index past the end.
routine List<T>.at_checked(self: Self, index: USize) -> Option<@T>
require T: typename
    block entry():
        length    : USize = self.length
        in_bounds : Bool  = index.lt(length)
        branch in_bounds
            ? address(index)
            : return(.Absent)

    block address(index: USize):
        data    : @T = self.data
        element : @T = data.stride(index)
        return(.Present(element))

/// Overwrites the element at `index` with `value`.
/// :param index: The zero-based position to write.
/// :param value: The value to store.
/// :throws: Traps with `TrapCode.Bounds` when `index >= length`.
#track_caller
routine List<T>.set(self: @Self, index: USize, value: T) -> Void
require T: typename
    block entry():
        length    : USize = self.length.load()
        in_bounds : Bool  = index.lt(length)
        branch in_bounds
            ? store(index, value)
            : panic(TrapCode.Bounds)

    block store(index: USize, value: T):
        data : @T = self.data.load()
        data.stride(index).store(value)
        return()

/// Removes every element by resetting the length to `0`. The buffer and its capacity are kept for reuse, and elements are not destructed.
routine List<T>.clear(self: @Self) -> Void
require T: typename
    block entry():
        self.length.store(0)
        return()

/// Whether two lists hold equal elements in the same order.
/// :param other: The list to compare with.
/// :returns: `true` when the lengths match and every element pair is equal.
routine List<T>.eq(self: Self, other: Self) -> Bool
require T: typename, Equal<T>
    block entry():
        la       : USize = self.length
        lb       : USize = other.length
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan(self, other, la)
            : return(false)

    block scan(self: Self, other: Self, len: USize):
        pa : @T = self.data
        pb : @T = other.data
        jump loop(0, len, pa, pb)

    block loop(i: USize, len: USize, pa: @T, pb: @T):
        done : Bool = i.ge(len)
        branch done
            ? return(true)
            : step(i, len, pa, pb)

    block step(i: USize, len: USize, pa: @T, pb: @T):
        x  : T    = pa.stride(i).load()
        y  : T    = pb.stride(i).load()
        eq : Bool = x.eq(y)
        branch eq
            ? loop(i.add(1), len, pa, pb)
            : return(false)

/// Frees the list's memory through its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
routine List<T>.destruct(self: @Self) -> Void
require T: typename
    block entry():
        data  : @T   = self.data.load()
        empty : Bool = data.is_null()
        branch empty
            ? reset()
            : release(data)

    block release(data: @T):
        alloc : @Allocator = self.alloc.load()
        data.free(alloc)
        jump reset()

    block reset():
        self.data.store(null)
        self.length.store(0)
        self.capacity.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine List<T>.destruct_all(self: @Self) -> Void
require T: typename, Destruct<T>
    block entry():
        iter_val : ListIter<T> = .construct(self)
        claim iter : @ListIter<T> <- iter_val
        claim slot : @T           <- uninit
        jump next(iter, slot)

    block next(iter: @ListIter<T>, slot: @T):
        item : Option<T> = iter.next()
        when item:
            .Present(value) -> element(iter, slot, value)
            .Absent         -> finish()

    block element(iter: @ListIter<T>, slot: @T, value: T):
        slot.store(value)
        slot.destruct()
        jump next(iter, slot)

    block finish():
        self.destruct()
        return()

// -- text ----------------------------------------------------------------------
//
// A List<Byte> is the growable text buffer: it's a Writer, so write(buf, "...")
// appends to it, and to_string() views what it holds. The list's allocator is
// the only place memory comes from.

conform Writer<List<Byte>>

/// Appends length bytes, growing through the list's allocator.
routine List<Byte>.write_bytes(self: @Self, data: @Byte, length: USize) -> Void
    block entry():
        nothing : Bool = length.eq(0)
        branch nothing
            ? return()
            : continue
        old : USize = self.length.load()
        new : USize = old.add(length)
        self.ensure_capacity(new)
        base : @Byte = self.data.load()
        copy<Byte>(base.stride(old), data, length)
        self.length.store(new)
        return()

/// A view of the bytes written so far, without copying. It's valid until the
/// list next grows or is destructed, and it isn't NUL-terminated.
routine List<Byte>.to_bytes(self: Self) -> Bytes
    block entry():
        data   : @Byte = self.data
        length : USize = self.length
        text   : Bytes = .from_ptr(data, length)
        return(text)

/// Ends the bytes with a NUL (not counted in the length) and points at them,
/// for C. Valid until the list next changes or is destructed.
routine List<Byte>.to_cstr(self: @Self) -> CStr
    block entry():
        length : USize = self.length.load()
        self.ensure_capacity(length.add(1))
        data : @Byte = self.data.load()
        data.stride(length).store(0x00)
        return(.from_ptr(data))

// -- text -----------------------------------------------------------------------

/// The elements in order, each diagnosed (strings quoted): [1, 2, 3].
routine List<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim whole : @Self <- self
        iter_val : ListIter<T> = .construct(whole)
        claim iter : @ListIter<T> <- iter_val
        diagnose_items<T, ListIter<T>, W>(out, iter, "[", "]")
        return()

/// The elements in order, each diagnosed: [1, 2, 3].
routine List<T>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry():
        claim whole : @Self <- self
        iter_val : ListIter<T> = .construct(whole)
        claim iter : @ListIter<T> <- iter_val
        diagnose_items<T, ListIter<T>, W>(out, iter, "[", "]")
        return()
