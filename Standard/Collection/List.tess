// Tessera stdlib collection: List<T>
//
// Dynamic array: a Slice<T> whose count is the capacity, and the number of
// elements in use. The allocator lives in the Slice, so callers do not pass
// it to individual operations.

module Standard::Collections

import Standard::Alloc
import Standard::Format

/// A growable array of `T` stored contiguously on the heap: `storage` holds the capacity (a {Slice<T>}, which keeps the allocator) and `count` the elements in use. The buffer grows by doubling, and the list is released with `destruct`.
/// :typeparam T: The element type.
record List<T>
conform Destructible<List<T>>
conform Equatable<List<T>>     when T: typename, Equatable<T>
conform Representable<List<T>> when T: typename, Diagnosable<T>
conform Diagnosable<List<T>>   when T: typename, Diagnosable<T>
require T: typename
    storage : Slice<T>
    count   : USize

/// Creates an empty List that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the list stores and later frees its memory with.
/// :returns: A new empty List.
routine List<T>.construct(alloc: @Allocator) -> Self
require T: typename
    block entry()
        storage : Slice<T> = Slice<T>.construct(0, alloc)
        list    : Self     = Self { storage: storage, count: 0 }
        return(list)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine List<T>.count(self: Self) -> USize
require T: typename
    block entry()
        count : USize = self.count
        return(count)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine List<T>.count(self: @Self) -> USize
require T: typename
    block entry()
        count : USize = self.count.load()
        return(count)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine List<T>.is_empty(self: Self) -> Bool
require T: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine List<T>.is_empty(self: @Self) -> Bool
require T: typename
    block entry()
        empty : Bool = self.count.load().eq(0)
        return(empty)

/// Grows the buffer to hold at least `capacity` elements without further allocation. A smaller request leaves the buffer unchanged.
/// :param capacity: The number of elements to make room for.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {List<T>.reserve_result} for a recoverable form.
#track_caller
routine List<T>.reserve(self: @Self, capacity: USize) -> Void
require T: typename
    block entry()
        reserved : Bool = self.make_capacity(capacity)
        branch reserved
            ? return()
            : crash_allocation()

/// `reserve`, returning a Failure instead of crashing when the allocator fails.
routine List<T>.reserve_result(self: @Self, capacity: USize) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        reserved : Bool = self.make_capacity(capacity)
        branch reserved
            ? return(.Success(Unit.value()))
            : return(.Failure(AllocFailed {}))

/// Grows the buffer to at least capacity elements. Returns false when the
/// allocator fails, leaving the list as it was.
private routine List<T>.make_capacity(self: @Self, capacity: USize) -> Bool
require T: typename
    block entry()
        old_capacity : USize = self.storage.count.load()
        enough       : Bool  = old_capacity.ge(capacity)
        branch enough
            ? return(true)
            : continue
        resized : Result<Unit, AllocFailed> = self.storage.resize_result(capacity)
        when resized
            .Success -> return(true)
            .Failure -> return(false)

/// Makes room for `wanted` elements, starting at 4 slots and doubling until the request fits.
/// :param wanted: The element count the buffer must hold.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails.
#track_caller
routine List<T>.ensure_capacity(self: @Self, wanted: USize) -> Void
require T: typename
    block entry()
        room : Bool = self.make_room(wanted)
        branch room
            ? return()
            : crash_allocation()

/// Makes room for wanted elements, doubling the capacity. Returns false when
/// the allocator fails, leaving the list as it was.
private routine List<T>.make_room(self: @Self, wanted: USize) -> Bool
require T: typename
    block entry()
        capacity : USize = self.storage.count.load()
        enough   : Bool  = capacity.ge(wanted)
        branch enough
            ? return(true)
            : choose(capacity)

    block choose(capacity: USize)
        empty : Bool = capacity.eq(0)
        branch empty
            ? initial()
            : double(capacity)

    block initial()
        base         : USize = 4
        use_wanted   : Bool  = wanted.gt(base)
        new_capacity : USize = use_wanted
            ? wanted
            : base
        return(self.make_capacity(new_capacity))

    block double(capacity: USize)
        next   : USize = capacity.mul(2)
        enough : Bool  = next.ge(wanted)
        branch enough
            ? return(self.make_capacity(next))
            : double(next)

/// Appends `value` after the last element, growing the buffer when it is full.
/// :param value: The element to append.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {List<T>.push_result} for a recoverable form.
#track_caller
routine List<T>.push(self: @Self, value: T) -> Void
require T: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = self.push_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push`, returning a Failure instead of crashing when the allocator fails.
routine List<T>.push_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        count  : USize = self.count.load()
        wanted : USize = count.add(1)
        room   : Bool  = self.make_room(wanted)
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data : @T = self.storage.data.load()
        data.stride(count).store(value)
        self.count.store(wanted)
        return(.Success(Unit.value()))

/// Removes the last element and returns it.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {List<T>.pop_checked}.
#track_caller
routine List<T>.pop(self: @Self) -> T
require T: typename
    block entry()
        popped : Option<T> = self.pop_checked()
        when popped
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `pop`, returning Absent instead of crashing on an empty list.
routine List<T>.pop_checked(self: @Self) -> Option<T>
require T: typename
    shared count : USize = self.count.load()

    block entry()
        empty : Bool = count.eq(0)
        branch empty
            ? return(.Absent)
            : pop()

    block pop()
        index : USize = count.sub(1)
        data  : @T    = self.storage.data.load()
        value : T     = data.stride(index).load()
        self.count.store(index)
        return(.Present(value))

// -- element access ------------------------------------------------------------

/// Reads the element at `index`.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`. See {List<T>.getitem_checked}.
#track_caller
routine List<T>.getitem(self: Self, index: USize) -> T
require T: typename
    block entry()
        value : T = self.to<Slice<T>>().getitem(index)
        return(value)

/// Reads the element at `index`.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`. See {List<T>.getitem_checked}.
#track_caller
routine List<T>.getitem(self: @Self, index: USize) -> T
require T: typename
    block entry()
        value : T = self.to<Slice<T>>().getitem(index)
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
routine List<T>.getitem_checked(self: Self, index: USize) -> Option<T>
require T: typename
    block entry()
        value : Option<T> = self.to<Slice<T>>().getitem_checked(index)
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
routine List<T>.getitem_checked(self: @Self, index: USize) -> Option<T>
require T: typename
    block entry()
        value : Option<T> = self.to<Slice<T>>().getitem_checked(index)
        return(value)

/// The address of element index, checked like getitem: a place to read or write in place. It stays valid until the list grows, shrinks, or is destructed.
#track_caller
routine List<T>.at(self: Self, index: USize) -> @T
require T: typename
    block entry()
        element : @T = self.to<Slice<T>>().at(index)
        return(element)

/// The address of element index, checked like getitem: a place to read or write in place. It stays valid until the list grows, shrinks, or is destructed.
#track_caller
routine List<T>.at(self: @Self, index: USize) -> @T
require T: typename
    block entry()
        element : @T = self.to<Slice<T>>().at(index)
        return(element)

/// `at`, returning Absent instead of crashing on an index past the end.
routine List<T>.at_checked(self: Self, index: USize) -> Option<@T>
require T: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? address()
            : return(.Absent)

    block address()
        data    : @T = self.storage.data
        element : @T = data.stride(index)
        return(.Present(element))

/// `at`, returning Absent instead of crashing on an index past the end.
routine List<T>.at_checked(self: @Self, index: USize) -> Option<@T>
require T: typename
    block entry()
        element : Option<@T> = self.load().at_checked(index)
        return(element)

/// Overwrites the element at `index` with `value`.
/// :param index: The zero-based position to write.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine List<T>.setitem(self: @Self, index: USize, value: T) -> Void
require T: typename
    block entry()
        view : Slice<T> = self.to<Slice<T>>()
        view.setitem(index, value)
        return()

/// The elements, borrowed: valid until the list grows, shrinks, or is destructed.
routine List<T>.to<Slice<T>>(self: Self) -> Slice<T>
require T: typename
    block entry()
        slice : Slice<T> = Slice<T>.construct(self.storage.data, self.count)
        return(slice)

/// The elements, borrowed: valid until the list grows, shrinks, or is destructed.
routine List<T>.to<Slice<T>>(self: @Self) -> Slice<T>
require T: typename
    block entry()
        slice : Slice<T> = self.load().to<Slice<T>>()
        return(slice)

/// The `count` elements from `start`, borrowed, checked against the list's count.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine List<T>.getslice(self: Self, start: USize, count: USize) -> Slice<T>
require T: typename
    block entry()
        part : Slice<T> = self.to<Slice<T>>().getslice(start, count)
        return(part)

/// The `count` elements from `start`, borrowed, checked against the list's count.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine List<T>.getslice(self: @Self, start: USize, count: USize) -> Slice<T>
require T: typename
    block entry()
        part : Slice<T> = self.to<Slice<T>>().getslice(start, count)
        return(part)

/// Removes every element by resetting the count to `0`. The buffer and its capacity are kept for reuse, and elements are not destructed.
routine List<T>.clear(self: @Self) -> Void
require T: typename
    block entry()
        self.count.store(0)
        return()

/// Whether two lists hold equal elements in the same order.
/// :param other: The list to compare with.
/// :returns: `true` when the counts match and every element pair is equal.
routine List<T>.eq(self: Self, other: Self) -> Bool
require T: typename, Equatable<T>
    shared la : USize = self.count

    block entry()
        lb       : USize = other.count
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan()
            : return(false)

    block scan()
        pa : @T = self.storage.data
        pb : @T = other.storage.data
        jump loop(0, pa, pb)

    block loop(i: USize, pa: @T, pb: @T)
        done : Bool = i.ge(la)
        branch done
            ? return(true)
            : step(i, pa, pb)

    block step(i: USize, pa: @T, pb: @T)
        x  : T    = pa.stride(i).load()
        y  : T    = pb.stride(i).load()
        eq : Bool = x.eq(y)
        branch eq
            ? loop(i.add(1), pa, pb)
            : return(false)

/// Gives the list's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine List<T>.destruct(self: @Self) -> Void
require T: typename
    block entry()
        self.storage.resize(0)
        self.count.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
#track_caller
routine List<T>.destruct_all(self: @Self) -> Void
require T: typename, Destructible<T>
    shared first : @T    = self.storage.data.load()
    shared count : USize = self.count.load()

    block entry()
        jump each(0)

    block each(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish()
            : continue
        first.stride(i).destruct()
        jump each(i.add(1))

    block finish()
        self.destruct()
        return()

// -- text ----------------------------------------------------------------------
//
// A List<Byte> is the growable text buffer: it's a Writer, so buf.write("...")
// appends to it, and to<Bytes>() views what it holds. The list's allocator is
// the only place memory comes from.

conform Writer<List<Byte>>

/// Appends count bytes, growing through the list's allocator.
routine List<Byte>.write_bytes(self: @Self, data: @Byte, count: USize) -> Void
    block entry()
        nothing : Bool = count.eq(0)
        branch nothing
            ? return()
            : continue
        old : USize = self.count.load()
        new : USize = old.add(count)
        self.ensure_capacity(new)
        base : @Byte = self.storage.data.load()
        copy<Byte>(base.stride(old), data, count)
        self.count.store(new)
        return()

/// A view of the bytes written so far, without copying. It's valid until the
/// list next grows or is destructed, and it isn't NUL-terminated.
routine List<Byte>.to<Bytes>(self: Self) -> Bytes
    block entry()
        text : Bytes = .from_ptr(self.storage.data, self.count)
        return(text)

/// A view of the bytes written so far, without copying. It's valid until the
/// list next grows or is destructed, and it isn't NUL-terminated.
routine List<Byte>.to<Bytes>(self: @Self) -> Bytes
    block entry()
        text : Bytes = self.load().to<Bytes>()
        return(text)

/// Ends the bytes with a NUL (not counted in `count`) and points at them,
/// for C. Valid until the list next changes or is destructed.
routine List<Byte>.to<CStr>(self: @Self) -> CStr
    block entry()
        count : USize = self.count.load()
        self.ensure_capacity(count.add(1))
        data : @Byte = self.storage.data.load()
        data.stride(count).store(0x00)
        return(data.to<CStr>())

// -- text -----------------------------------------------------------------------

/// The elements in order, each diagnosed (strings quoted): [1, 2, 3].
routine List<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnosable<T>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : ListIter<T> = .construct(whole)
        claim iter : @ListIter<T> <- iter_val
        diagnose_items<T, ListIter<T>, W>(out, iter, "[", "]")
        return()

/// The elements in order, each diagnosed: [1, 2, 3].
routine List<T>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnosable<T>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : ListIter<T> = .construct(whole)
        claim iter : @ListIter<T> <- iter_val
        diagnose_items<T, ListIter<T>, W>(out, iter, "[", "]")
        return()
