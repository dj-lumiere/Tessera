// Tessera stdlib collection: SetIter<T>
//
// Walks Set<T> in insertion order. Visits each live entry in the entries
// arrays, skipping entries marked dead by `remove`.
//
// Mutating the set during iteration produces undefined behaviour.
//
// Satisfies concept Iterator<T, SetIter<T>>.

module Standard::Collections

/// An iterator over a {Set<T>} in insertion order. Removed elements are skipped. Changing the set while iterating is undefined behavior.
/// :typeparam T: The element type.
record SetIter<T>
conform Iterator<T, SetIter<T>>
require T: typename
    set   : @Set<T>
    index : USize

/// Creates an iterator positioned before the first element of `set`.
/// :param set: The set to walk.
/// :returns: A new iterator at the first entry.
routine SetIter<T>.construct(set: @Set<T>) -> Me
require T: typename
    block entry()
        iter : Me = Me { set: set, index: 0 }
        return(iter)

/// Yields the next live element and advances past it, skipping dead entries.
/// :returns: The next element, in insertion order.
/// :absent: After the last live element has been yielded.
routine SetIter<T>.next(me: @Me) -> Option<T>
require T: typename
    shared set   : @Set<T> = me.set.load()
    shared count : USize   = set.entries_count.load()

    block entry()
        index : USize = me.index.load()
        jump scan(index)

    // Advance until we hit a live entry or exhaust the array.
    // index >= count holds at once when the set is empty, so it returns None.
    block scan(index: USize)
        exhausted : Bool = index.ge(count)
        branch exhausted
            ? return_none()
            : check(index)

    block check(index: USize)
        entry_states : @U8  = set.entry_states.data.load()
        state        : U8   = entry_states.stride(index).load()
        live         : Bool = state.eq(1)
        branch live
            ? yield(index)
            : scan(index.add(1))

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block yield(index: USize)
        keys : @T = set.keys.data.load()
        key  : T  = keys.stride(index).load()
        me.index.store(index.add(1))
        some : Option<T> = .Present(key)
        return(some)
