# Tessera stdlib collection: ListIter[T]
#
# Forward iterator over List[T].  Borrows the list — the list must outlive the
# iterator.  emit_checked() returns None after the last element, next_checked()
# hands out the element slots.
#
# Satisfies concept SlotIterator[T, ListIter[T]] (and so Iterator).

module Standard/Collections

### A forward iterator over a {List[T]}. It borrows the list, so the list must outlive the iterator and must not change while it is walked.
### :typeparam T: The element type.
record ListIter[T]
obeys SlotIterator[T, ListIter[T]]
needs T: typename
    list: @List[T]
    index: U64

### Releases nothing: a `ListIter` holds no memory of its own.
routine ListIter[T].destruct(me: @Me) -> None
needs T: typename
    return

### Creates an iterator positioned before the first element of `list`.
### :param list: The list to walk.
### :returns: A new iterator at index `0`.
routine ListIter[T].construct(list: @List[T]) -> Me
needs T: typename
    iter: Me = Me(list: list, index: 0)
    return iter

### Yields the next element and advances the iterator.
### :returns: The next element, front to back.
### :absent: After the last element has been yielded.
routine ListIter[T].emit_checked(me: @Me) -> Maybe[T]
needs T: typename
    local list: @List[T] = me.list.peek()
    local len: U64 = list.count()
    local index: U64 = me.index.peek()

    if index >= len
        none: Maybe[T] = None()
        return none
    value: T = list[index]
    me.index.poke(index + 1)
    some: Maybe[T] = value
    return some

### Yields the next element and advances the iterator, crashing when there is none.
### :returns: The next element, front to back.
### :throws: Crashes with `AbsentValueError` after the last element has been yielded.
@track_caller
routine ListIter[T].emit(me: @Me) -> T
needs T: typename
    item: Maybe[T] = me.emit_checked()
    when item
        is T as value => return value
        is None => crash_absent_value()

### Hands out the next element's slot and advances the iterator. Writing through the slot changes the element in the
### collection.
### :returns: The address of the next element, front to back.
### :absent: After the last element has been handed out.
routine ListIter[T].next_checked(me: @Me) -> Maybe[@T]
needs T: typename
    local list: @List[T] = me.list.peek()
    local index: U64 = me.index.peek()

    if index >= list.count()
        return None()
    me.index.poke(index + 1)
    element: @T = list.getslot(index)
    return element

### Hands out the next element's slot and advances the iterator, crashing when there is none.
### :returns: The address of the next element, front to back.
### :throws: Crashes with `AbsentValueError` after the last element has been handed out.
@track_caller
routine ListIter[T].next(me: @Me) -> @T
needs T: typename
    slot: Maybe[@T] = me.next_checked()
    when slot
        is @T as element => return element
        is None => crash_absent_value()
