// Tessera stdlib collection: Set<T>
//
// Insertion-ordered open-addressed hash set. Two layers:
//   - Entries arrays (keys/hashes/entry_states) hold live and dead entries in
//     the order they were first inserted. Iteration walks these.
//   - Slots is an index table: each cell is SLOT_EMPTY, SLOT_TOMBSTONE, or an
//     entry index >= 0. Linear probing on the hash mod capacity.
//
// Every array is a Slice of the same count, the capacity, and each keeps
// the allocator. Removal marks the entry dead and the slot a tombstone. The
// entry's position in the entries array is retained so the insertion order of
// surviving entries is preserved. Rehash compacts dead entries away.
//
// entry_state values: 0 = dead, 1 = live.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset SLOT_EMPTY:     USize = USize.MAX
private preset SLOT_TOMBSTONE: USize = SLOT_EMPTY.sub(1)

/// An insertion-ordered hash set. Keys live in parallel arrays (each a {Slice<T>} holding the capacity and the allocator) in the order they were first added, and an open-addressed slot table with linear probing maps a hash to its entry. Removal marks the entry dead, so surviving elements keep their order until the next rehash.
/// :typeparam T: The element type, which must provide hashing and equality.
record Set<T>
conform Destructible<Set<T>>
conform Representable<Set<T>> when T: typename, HashEquatable<T>, Diagnosable<T>
conform Diagnosable<Set<T>>   when T: typename, HashEquatable<T>, Diagnosable<T>
conform Equatable<Set<T>>     when T: typename, HashEquatable<T>
require T: typename, HashEquatable<T>
    keys          : Slice<T>
    hashes        : Slice<U64>
    entry_states  : Slice<U8>
    slots         : Slice<USize>
    count         : USize
    entries_count : USize

/// Creates an empty Set that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the set stores and later frees its memory with.
/// :returns: A new empty Set.
routine Set<T>.construct(alloc: @Allocator) -> Me
require T: typename, HashEquatable<T>
    block entry()
        keys         : Slice<T>     = Slice<T>.construct(0, alloc)
        hashes       : Slice<U64>   = Slice<U64>.construct(0, alloc)
        entry_states : Slice<U8>    = Slice<U8>.construct(0, alloc)
        slots        : Slice<USize> = Slice<USize>.construct(0, alloc)
        set          : Me           = Me { keys: keys, hashes: hashes, entry_states: entry_states,
            slots: slots, count: 0, entries_count: 0 }
        return(set)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the set is empty.
routine Set<T>.count(me: Me) -> USize
require T: typename
    block entry()
        count : USize = me.count
        return(count)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the set is empty.
routine Set<T>.count(me: @Me) -> USize
require T: typename
    block entry()
        count : USize = me.count.load()
        return(count)

/// Whether the set holds no elements.
/// :returns: `true` when the count is `0`.
routine Set<T>.is_empty(me: Me) -> Bool
require T: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Whether the set holds no elements.
/// :returns: `true` when the count is `0`.
routine Set<T>.is_empty(me: @Me) -> Bool
require T: typename
    block entry()
        empty : Bool = me.load().is_empty()
        return(empty)

/// Probes the slot table for `key`, linearly from `hash` modulo capacity.
/// :param key: The key being looked for.
/// :param hash: The hash of `key`.
/// :returns: The slot holding `key` if found, otherwise the slot where it should be installed: the first tombstone seen, else the first empty slot.
routine Set<T>.slot(me: Me, key: T, hash: U64) -> USize
require T: typename
    shared first_tombstone : @USize <- SLOT_EMPTY

    block entry()
        capacity : USize = me.slots.count
        mask     : USize = capacity.sub(1)
        start    : USize = hash.to_wrap<USize>().bitand(mask)
        jump probe(start)

    block probe(index: USize)
        slots        : @USize = me.slots.data
        entry_idx    : USize  = slots.stride(index).load()
        is_empty     : Bool   = entry_idx.eq(SLOT_EMPTY)
        is_tombstone : Bool   = entry_idx.eq(SLOT_TOMBSTONE)
        when
            is_empty     -> empty_slot(index)
            is_tombstone -> tombstone_slot(index)
            else         -> occupied_slot(index, entry_idx)

    block empty_slot(index: USize)
        has_tombstone : Bool  = first_tombstone.load().ne(SLOT_EMPTY)
        slot          : USize = has_tombstone
            ? first_tombstone.load()
            : index
        return(slot)

    block tombstone_slot(index: USize)
        seen           : Bool  = first_tombstone.load().ne(SLOT_EMPTY)
        next_tombstone : USize = seen
            ? first_tombstone.load()
            : index
        capacity : USize = me.slots.count
        next     : USize = index.add(1).bitand(capacity.sub(1))
        next_tombstone.store_into(first_tombstone)
        jump probe(next)

    block occupied_slot(index: USize, entry_idx: USize)
        hashes     : @U64 = me.hashes.data
        entry_hash : U64  = hashes.stride(entry_idx).load()
        hash_match : Bool = entry_hash.eq(hash)
        branch hash_match
            ? maybe_equal(index, entry_idx)
            : next(index)

    block maybe_equal(index: USize, entry_idx: USize)
        keys      : @T   = me.keys.data
        entry_key : T    = keys.stride(entry_idx).load()
        equal     : Bool = entry_key.eq(key)
        branch equal ? return(index): next(index)

    block next(index: USize)
        capacity : USize = me.slots.count
        next     : USize = index.add(1).bitand(capacity.sub(1))
        jump probe(next)

/// The entry index of `key`.
/// :param key: The element to look for.
/// :returns: The index of the element's entry, or `SLOT_EMPTY` when it is absent.
routine Set<T>.find(me: Me, key: T) -> USize
require T: typename
    block entry()
        capacity : USize = me.slots.count
        empty    : Bool  = capacity.eq(0)
        branch empty ? return(SLOT_EMPTY): hash()

    block hash()
        hash      : U64    = key.hash()
        slot      : USize  = me.slot(key, hash)
        slots     : @USize = me.slots.data
        entry_idx : USize  = slots.stride(slot).load()
        found     : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? return(entry_idx)
            : return(SLOT_EMPTY)

/// Whether `key` is in the set.
/// :param key: The element to look for.
/// :returns: `true` when an equal element is live.
routine Set<T>.has(me: Me, key: T) -> Bool
require T: typename
    block entry()
        found : Bool = me.find(key).ne(SLOT_EMPTY)
        return(found)

/// Whether `key` is in the set.
/// :param key: The element to look for.
/// :returns: `true` when an equal element is live.
routine Set<T>.has(me: @Me, key: T) -> Bool
require T: typename
    block entry()
        found : Bool = me.load().has(key)
        return(found)

/// Two sets are equal when they hold the same elements, regardless of insertion order or slot layout. With
/// matching counts, every element of `me` being in `other` is enough.
/// :param other: The set to compare with.
/// :returns: True when the two hold the same elements.
routine Set<T>.eq(me: Me, other: Me) -> Bool
require T: typename, HashEquatable<T>
    block entry()
        claim a : @Me <- me
        claim b : @Me <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// `eq`, through pointers to the two sets.
/// :param other: The set to compare with.
/// :returns: True when the two hold the same elements.
private routine Set<T>.eq_at(me: @Me, other: @Me) -> Bool
require T: typename, HashEquatable<T>
    block entry()
        la       : USize = me.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan()
            : return(false)

    block scan()
        n : USize = me.entries_count.load()
        jump loop(0, n)

    block loop(i: USize, n: USize)
        done : Bool = i.ge(n)
        branch done
            ? return(true)
            : check(i, n)

    block check(i: USize, n: USize)
        entry_states : @U8  = me.entry_states.data.load()
        s            : U8   = entry_states.stride(i).load()
        live         : Bool = s.eq(1)
        branch live
            ? probe(i, n)
            : loop(i.add(1), n)

    block probe(i: USize, n: USize)
        keys : @T   = me.keys.data.load()
        key  : T    = keys.stride(i).load()
        has  : Bool = other.has(key)
        branch has
            ? loop(i.add(1), n)
            : return(false)

/// Moves the live entries into fresh arrays of `new_capacity`, in insertion order, dropping dead ones. The new
/// arrays are made in the order keys, hashes, entry states, slots, and a failure releases the ones already made.
/// :param new_capacity: The new capacity, a power of two above the live count.
/// :returns: True when it rehashed, false when the allocator failed (the set is left as it was).
private routine Set<T>.rehash(me: @Me, new_capacity: USize) -> Bool
require T: typename
    shared alloc        : @Allocator    = me.keys.alloc.load()
    shared keys         : @Slice<T>     <- .construct(0, alloc)
    shared hashes       : @Slice<U64>   <- .construct(0, alloc)
    shared entry_states : @Slice<U8>    <- .construct(0, alloc)
    shared slots        : @Slice<USize> <- .construct(0, alloc)

    block entry()
        made_keys : Bool = make_array<T>(keys, new_capacity)
        branch made_keys
            ? continue
            : discard()
        made_hashes : Bool = make_array<U64>(hashes, new_capacity)
        branch made_hashes
            ? continue
            : discard()
        made_states : Bool = make_array<U8>(entry_states, new_capacity)
        branch made_states
            ? continue
            : discard()
        made_slots : Bool = make_array<USize>(slots, new_capacity)
        branch made_slots
            ? clear_loop(0)
            : discard()

    block discard()
        destruct_set_arrays<T>(keys, hashes, entry_states, slots)
        return(false)

    block clear_loop(i: USize)
        done : Bool = i.ge(new_capacity)
        branch done
            ? install()
            : continue
        slot_cells  : @USize = slots.data.load()
        state_cells : @U8    = entry_states.data.load()
        slot_cells.stride(i).store(SLOT_EMPTY)
        state_cells.stride(i).store(0)
        jump clear_loop(i.add(1))

    // Swaps the new arrays into the set, so the claimed slices hold the old ones from here on.
    block install()
        old_count : USize = me.entries_count.load()
        swap_slices<T>(me.keys, keys)
        swap_slices<U64>(me.hashes, hashes)
        swap_slices<U8>(me.entry_states, entry_states)
        swap_slices<USize>(me.slots, slots)
        me.count.store(0)
        me.entries_count.store(0)
        jump move_loop(0, old_count)

    block move_loop(i: USize, old_count: USize)
        done : Bool = i.ge(old_count)
        branch done
            ? release_old()
            : continue
        states : @U8  = entry_states.data.load()
        s      : U8   = states.stride(i).load()
        live   : Bool = s.eq(1)
        branch live
            ? insert_old(i, old_count)
            : move_loop(i.add(1), old_count)

    block insert_old(i: USize, old_count: USize)
        old_keys   : @T   = keys.data.load()
        old_hashes : @U64 = hashes.data.load()
        key        : T    = old_keys.stride(i).load()
        hash       : U64  = old_hashes.stride(i).load()
        me.add_direct(key, hash)
        jump move_loop(i.add(1), old_count)

    block release_old()
        destruct_set_arrays<T>(keys, hashes, entry_states, slots)
        return(true)

/// Makes room for one more entry: the first insertion rehashes into 8 slots, and the tables double once one more
/// entry would fill three quarters of them.
/// :returns: True when there is room, false when the allocator failed (the set is left as it was).
private routine Set<T>.ensure(me: @Me) -> Bool
require T: typename
    shared capacity : USize = me.slots.count.load()

    block entry()
        empty : Bool = capacity.eq(0)
        branch empty
            ? first()
            : check()

    block first()
        return(me.rehash(8))

    block check()
        count : USize = me.entries_count.load()
        limit : USize = capacity.mul(3).div(4)
        full  : Bool  = count.add(1).ge(limit)
        branch full
            ? grow()
            : return(true)

    block grow()
        return(me.rehash(capacity.mul(2)))

/// Inserts without growing, for rehash once the new arrays are in place and for `add_result` after `ensure`.
/// :param key: The element to add.
/// :param hash: The element's hash, so rehash can pass the stored one instead of hashing every element again.
/// :returns: True when a new entry was appended, false when an equal element was already live.
routine Set<T>.add_direct(me: @Me, key: T, hash: U64) -> Bool
require T: typename
    shared slot : USize = me.load().slot(key, hash)

    block entry()
        slots     : @USize = me.slots.data.load()
        entry_idx : USize  = slots.stride(slot).load()
        exists    : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch exists
            ? return(false)
            : add()

    block add()
        new_idx      : USize  = me.entries_count.load()
        keys         : @T     = me.keys.data.load()
        hashes       : @U64   = me.hashes.data.load()
        entry_states : @U8    = me.entry_states.data.load()
        slots        : @USize = me.slots.data.load()
        keys.stride(new_idx).store(key)
        hashes.stride(new_idx).store(hash)
        entry_states.stride(new_idx).store(1)
        slots.stride(slot).store(new_idx)
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        me.entries_count.store(new_idx.add(1))
        return(true)

/// Adds `key` to the set unless an equal element is already present.
/// :param key: The element to add.
/// :returns: `true` when `key` was new, `false` when it was already present.
/// :throws: Crashes with `MemoryAllocationError` when the tables must grow and the allocator fails. See {Set<T>.add_result} for a recoverable form.
#track_caller
routine Set<T>.add(me: @Me, key: T) -> Bool
require T: typename
    block entry()
        added : Result<Bool, AllocFailed> = me.add_result(key)
        when added
            .Success(is_new) -> return(is_new)
            .Failure         -> crash_allocation()

/// `add`, returning a Failure instead of crashing when the allocator fails.
/// :param key: The element to add.
/// :returns: `Success` holding whether `key` was new.
/// :throws: Returns `Failure(AllocFailed)` when the tables must grow and the allocator fails.
routine Set<T>.add_result(me: @Me, key: T) -> Result<Bool, AllocFailed>
require T: typename
    block entry()
        room : Bool = me.ensure()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        added : Bool = me.add_direct(key, key.hash())
        return(.Success(added))

/// Removes `key` from the set. Its position in the entries array stays until the next rehash.
/// :param key: The element to remove.
/// :returns: `true` when an element was removed, `false` when it was not present.
routine Set<T>.remove(me: @Me, key: T) -> Bool
require T: typename
    block entry()
        capacity : USize = me.slots.count.load()
        empty    : Bool  = capacity.eq(0)
        branch empty
            ? return(false)
            : hash()

    block hash()
        hash      : U64    = key.hash()
        slot      : USize  = me.load().slot(key, hash)
        slots     : @USize = me.slots.data.load()
        entry_idx : USize  = slots.stride(slot).load()
        found     : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? remove(slot, entry_idx)
            : return(false)

    block remove(slot: USize, entry_idx: USize)
        slots        : @USize = me.slots.data.load()
        entry_states : @U8    = me.entry_states.data.load()
        slots.stride(slot).store(SLOT_TOMBSTONE)
        entry_states.stride(entry_idx).store(0)
        remaining_count : USize = me.count.load().sub(1)
        remaining_count.store_into(me.count)
        return(true)

/// Gives the set's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine Set<T>.destruct(me: @Me) -> Void
require T: typename
    block entry()
        destruct_set_arrays<T>(me.keys, me.hashes, me.entry_states, me.slots)
        me.count.store(0)
        me.entries_count.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
#track_caller
routine Set<T>.destruct_all(me: @Me) -> Void
require T: typename, HashEquatable<T>, Destructible<T>
    shared iter_val : SetIter<T>  = .construct(me)
    shared iter     : @SetIter<T> <- iter_val
    shared slot     : @T          <- uninit

    block entry()
        jump next()

    block next()
        item : Option<T> = iter.next()
        when item
            .Present(value) -> element(value)
            .Absent         -> finish()

    block element(value: T)
        slot.store(value)
        slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements in insertion order, each diagnosed (strings quoted): {1, 2, 3}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine Set<T>.represent_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, HashEquatable<T>, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : SetIter<T> = .construct(whole)
        claim iter : @SetIter<T> <- iter_val
        diagnose_items<T, SetIter<T>, TWriter>(out, iter, "{", "}")
        return()

/// The elements in insertion order, each diagnosed: {1, 2, 3}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine Set<T>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, HashEquatable<T>, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : SetIter<T> = .construct(whole)
        claim iter : @SetIter<T> <- iter_val
        diagnose_items<T, SetIter<T>, TWriter>(out, iter, "{", "}")
        return()

// -- the arrays -----------------------------------------------------------------

/// Gives the four arrays of a set back to their allocator, leaving each empty.
/// :typeparam T: The element type.
/// :param keys: The keys array.
/// :param hashes: The hashes array.
/// :param entry_states: The entry states array.
/// :param slots: The slot table.
#track_caller
private routine destruct_set_arrays<T>(keys: @Slice<T>, hashes: @Slice<U64>,
    entry_states: @Slice<U8>, slots: @Slice<USize>) -> Void
require T: typename
    block entry()
        keys.resize(0)
        hashes.resize(0)
        entry_states.resize(0)
        slots.resize(0)
        return()
