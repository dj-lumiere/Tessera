// Tessera stdlib collection: SortedDictIter<TKey, TValue>
//
// In-order iterator over SortedDict<TKey, TValue>. Yields KVPair<TKey, TValue> with keys in
// ascending sorted order. It keeps the path from the root to the current node
// on an inline stack, so a full traversal is O(n) and the iterator allocates
// nothing.
//
// KVPair<TKey, TValue> is defined in option.tess.
//
// Satisfies concept Iterator<KVPair<TKey, TValue>, SortedDictIter<TKey, TValue>>.

module Standard::Collections

/// Every internal node has at least two children, so 2^64 entries fit in 64 levels.
private preset ITER_DEPTH: USize = 64

/// `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the next key to yield. Every child
/// left of that key has been walked already.
record SortedDictIter<TKey, TValue>
conform Iterator<KVPair<TKey, TValue>, SortedDictIter<TKey, TValue>>
require TKey: typename, TValue: typename, Comparable<TKey>
    nodes   : Array<@SortedDictNode<TKey, TValue>, ITER_DEPTH>
    indices : Array<USize, ITER_DEPTH>
    depth   : USize

/// Creates an iterator positioned before the smallest key, descending to the leftmost leaf.
/// :param map: The sorted dict to walk.
/// :returns: A new iterator, already positioned when the map is not empty.
routine SortedDictIter<TKey, TValue>.construct(map: @SortedDict<TKey, TValue>) -> Me
require TKey: typename, TValue: typename
    shared iter : @Me <- uninit

    block entry()
        root  : @SortedDictNode<TKey, TValue> = map.root.load()
        empty : Bool                          = root.is_null()
        iter.depth.store(0)
        branch empty
            ? finish()
            : continue
        iter.push_leftmost(root)
        jump finish()

    block finish()
        iter_val : Me = iter.load()
        return(iter_val)

/// Pushes node and the first child of each level below it, down to a leaf.
/// :param node: The node to start from.
private routine SortedDictIter<TKey, TValue>.push_leftmost(me: @Me,
    node: @SortedDictNode<TKey, TValue>) -> Void
require TKey: typename, TValue: typename
    block entry()
        jump push(node)

    block push(current: @SortedDictNode<TKey, TValue>)
        depth : USize = me.depth.load()
        leaf  : Bool  = current.leaf.load()
        me.nodes.setitem(depth, current)
        me.indices.setitem(depth, 0)
        me.depth.store(depth.add(1))
        branch leaf
            ? return()
            : first_child(current)

    block first_child(current: @SortedDictNode<TKey, TValue>)
        jump push(current.children.getitem(0))

/// Yields the next entry in ascending key order, climbing to a parent or descending to the next leaf as needed.
/// :returns: The next key and value pair, smallest key first.
/// :absent: After the entry with the largest key has been yielded.
routine SortedDictIter<TKey, TValue>.next(me: @Me) -> Option<KVPair<TKey, TValue>>
require TKey: typename, TValue: typename
    block entry()
        jump top()

    block top()
        depth : USize = me.depth.load()
        empty : Bool  = depth.eq(0)
        branch empty
            ? done()
            : continue
        level   : USize                         = depth.sub(1)
        node    : @SortedDictNode<TKey, TValue> = me.nodes.getitem(level)
        index   : USize                         = me.indices.getitem(level)
        count   : USize                         = node.count.load()
        has_key : Bool                          = index.lt(count)
        branch has_key
            ? take(node, level, index)
            : pop(level)

    block pop(level: USize)
        me.depth.store(level)
        jump top()

    block take(node: @SortedDictNode<TKey, TValue>, level: USize, index: USize)
        key   : TKey                 = node.keys.getitem(index)
        value : TValue               = node.values.getitem(index)
        pair  : KVPair<TKey, TValue> = KVPair<TKey, TValue> { key: key, value: value }
        leaf  : Bool                 = node.leaf.load()
        me.indices.setitem(level, index.add(1))
        branch leaf
            ? yield(pair)
            : continue
        right : @SortedDictNode<TKey, TValue> = node.children.getitem(index.add(1))
        me.push_leftmost(right)
        jump yield(pair)

    block yield(pair: KVPair<TKey, TValue>)
        some : Option<KVPair<TKey, TValue>> = .Present(pair)
        return(some)

    block done()
        none : Option<KVPair<TKey, TValue>> = .Absent
        return(none)
