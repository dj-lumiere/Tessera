# Tessera stdlib collection: SortedListIter[T]
#
# In-order iterator over SortedList[T]. Yields elements from index 0 to
# count-1. It keeps the path from the root to the current leaf on an inline
# stack, so a full traversal is O(n) and the iterator allocates nothing.
#
# Satisfies concept SlotIterator[T, SortedListIter[T]] (and so Iterator).

module Standard/Collections

### Every internal node has at least two children, so 2^64 elements fit in 64 levels.
secret preset SORTED_LIST_ITER_DEPTH: USize = 64

### `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the child being walked (internal) or
### the next value to yield (leaf).
record SortedListIter[T]
obeys SlotIterator[T, SortedListIter[T]]
needs T: typename, Comparable[T]
    nodes: Array[@SortedListNode[T], SORTED_LIST_ITER_DEPTH]
    indices: Array[USize, SORTED_LIST_ITER_DEPTH]
    depth: USize

### Releases nothing: a `SortedListIter` holds no memory of its own.
routine SortedListIter[T].destruct(me: @Me) -> None
needs T: typename
    return

### Creates an iterator positioned before the smallest element, descending to the leftmost leaf.
### :param list: The sorted list to walk.
### :returns: A new iterator, already positioned when the list is not empty.
routine SortedListIter[T].construct(list: @SortedList[T]) -> Me
needs T: typename
    local iter: @Me <- .hollow()

    root: @SortedListNode[T] = list.root.peek()
    empty: Bool = root.is_null()
    iter.depth.poke(0)
    if not empty
        iter.push_leftmost(root)
    iter_val: Me = iter.peek()
    return iter_val

### Pushes node and the first child of each level below it, down to a leaf.
### :param node: The node to start from.
secret routine SortedListIter[T].push_leftmost(me: @Me, node: @SortedListNode[T]) -> None
needs T: typename
    while true with current: @SortedListNode[T] = node
        depth2: USize = me.depth.peek()
        leaf2: Bool = current.leaf.peek()
        me.nodes[depth2] = current
        me.indices[depth2] = 0
        me.depth.poke(depth2 + 1)
        if leaf2
            return
        else
            continue with current: current.children[0]

### Hands out the next element's slot in sorted order, climbing to a parent or descending to the next leaf as needed.
### Changing the element in place can break the order.
### :returns: The next element's address, smallest first.
### :absent: After the largest element has been handed out.
routine SortedListIter[T].next_checked(me: @Me) -> Maybe[@T]
needs T: typename
    while true
        depth2: USize = me.depth.peek()
        if depth2 == 0
            break
        else
            level: USize = depth2 - 1
            node: @SortedListNode[T] = me.nodes[level]
            index: USize = me.indices[level]
            if node.leaf.peek()
                count: USize = node.count.peek()
                if index < count
                    me.indices[level] = index + 1
                    at: @T = node.values.getslot(index)
                    return at
            else
                # the child at `indices[level]` is done, so walk the next one, if there is one
                index2: USize = index + 1
                count: USize = node.count.peek()
                if index2 < count
                    me.indices[level] = index2
                    me.push_leftmost(node.children[index2])
                    continue
            me.depth.poke(level)
            continue
    return None()

### Hands out the next element's slot and advances the iterator, crashing when there is none.
### :returns: The next element's address, smallest first.
### :throws: Crashes with `AbsentValueError` after the last element has been handed out.
@track_caller
routine SortedListIter[T].next(me: @Me) -> @T
needs T: typename
    slot: Maybe[@T] = me.next_checked()
    when slot
        is @T as element => return element
        is None => crash_absent_value()

### Yields the next element in sorted order.
### :returns: The next element, smallest first.
### :absent: After the largest element has been yielded.
routine SortedListIter[T].emit_checked(me: @Me) -> Maybe[T]
needs T: typename
    when me.next_checked()
        is @T as at =>
            value: T = at.peek()
            return value
        is None => return None()

### Yields the next element and advances the iterator, crashing when there is none.
### :returns: The next element, smallest first.
### :throws: Crashes with `AbsentValueError` after the last element has been yielded.
@track_caller
routine SortedListIter[T].emit(me: @Me) -> T
needs T: typename
    item: Maybe[T] = me.emit_checked()
    when item
        is T as value => return value
        is None => crash_absent_value()
