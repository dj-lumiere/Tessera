# Tessera stdlib collection: Dict[TKey, TValue]
#
# Insertion-ordered open-addressed hash map. Two layers:
#   - Entries arrays (keys/values/hashes/entry_states) hold live and dead
#     entries in the order they were first inserted. Iteration walks these.
#   - Slots is an index table: each cell is DICT_SLOT_EMPTY, DICT_SLOT_TOMBSTONE, or an
#     entry index >= 0. Linear probing on the hash mod capacity.
#
# Every array is a Memory of the same count, the capacity, and each keeps
# the allocator. Removal marks the entry dead and the slot a tombstone. The
# entry's position in the entries array is retained so the insertion order of
# surviving entries is preserved. Rehash compacts dead entries away.
#
# entry_state values: 0 = dead, 1 = live.

module Standard/Collections

import Standard/Alloc
import Standard/Format

secret preset DICT_SLOT_EMPTY: USize = USize.MAX
secret preset DICT_SLOT_TOMBSTONE: USize = DICT_SLOT_EMPTY.sub(1)

### An insertion-ordered hash map. Entries live in parallel arrays (each a {Memory[T]} holding the capacity and the manager) in the order they were first inserted, and an open-addressed slot table with linear probing maps a key hash to its entry. Removal marks the entry dead, so surviving entries keep their order until the next rehash.
### :typeparam TKey: The key type, which must provide hashing and equality.
### :typeparam TValue: The value type.
entity Dict[TKey, TValue]
obeys Destructible[Dict[TKey, TValue]]
obeys Representable[Dict[TKey, TValue]] when TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue]
obeys Diagnosable[Dict[TKey, TValue]] when TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue]
obeys Equatable[Dict[TKey, TValue]] when TKey: typename, TValue: typename, Equatable[TValue]
needs TKey: typename, TValue: typename, HashEquatable[TKey]
    keys: Memory[TKey]
    values: Memory[TValue]
    hashes: Memory[U64]
    entry_states: Memory[U8]
    slots: Memory[USize]
    count: USize
    entries_count: USize

### Creates an empty Dict that draws its storage from `alloc`. Nothing is allocated until the first insertion.
### :param alloc: The allocator the dict stores and later frees its memory with.
### :returns: A new empty Dict.
routine Dict[TKey, TValue].construct(alloc: @MemoryManager) -> Me
needs TKey: typename, TValue: typename
    return Me(keys: Memory[TKey].construct(count: 0, manager: alloc),
        values: Memory[TValue].construct(count: 0, manager: alloc),
        hashes: Memory[U64].construct(count: 0, manager: alloc),
        entry_states: Memory[U8].construct(count: 0, manager: alloc),
        slots: Memory[USize].construct(count: 0, manager: alloc), count: 0, entries_count: 0)

### The number of entries currently stored.
### :returns: The count of entries, `0` when the dict is empty.
routine Dict[TKey, TValue].count(me: @Me) -> USize
needs TKey: typename, TValue: typename
    count: USize = me.count.peek()
    return count

### Whether the dict holds no entries.
### :returns: `true` when the count is `0`.
routine Dict[TKey, TValue].is_empty(me: @Me) -> Bool
needs TKey: typename, TValue: typename
    count: USize = me.count.peek()
    return count == 0

### Probes the slot table for `key`, from `hash` modulo the capacity. The table must have at least one slot.
### :param key: The key to look for.
### :param hash: The key's hash.
### :returns: The slot holding the key, or else the slot a new entry should take: the first tombstone seen, else the
###     first empty slot.
routine Dict[TKey, TValue].slot(me: @Me, key: @TKey, hash: U64) -> USize
needs TKey: typename, TValue: typename
    local first_tombstone: @USize <- DICT_SLOT_EMPTY

    capacity: USize = me.slots.count.peek()
    mask: USize = capacity - 1

    while true with index: USize = hash.to_wrap[USize]() & mask
        slots: @USize = me.slots.data.peek()
        entry_idx: USize = slots.stride(index).peek()
        is_empty: Bool = entry_idx == DICT_SLOT_EMPTY
        when
            is_empty =>
                has_tombstone: Bool = first_tombstone.peek() != DICT_SLOT_EMPTY
                slot: USize = when
                    has_tombstone => first_tombstone.peek()
                    else => index
                return slot
            entry_idx == DICT_SLOT_TOMBSTONE =>
                seen: Bool = first_tombstone.peek() != DICT_SLOT_EMPTY
                next_tombstone: USize = when
                    seen => first_tombstone.peek()
                    else => index
                capacity2: USize = me.slots.count.peek()
                next: USize = index + 1 & capacity2 - 1
                next_tombstone.poke_into(first_tombstone)
                continue with index: next
            else =>
                hashes: @U64 = me.hashes.data.peek()
                entry_hash: U64 = hashes.stride(entry_idx).peek()
                if entry_hash == hash
                    keys: @TKey = me.keys.data.peek()
                    entry_key: @TKey = keys.stride(entry_idx)
                    if entry_key.eq(key)
                        return index
                capacity2: USize = me.slots.count.peek()
                continue with index: index + 1 & capacity2 - 1

### The entry index of the key at `key`, read through its place, so an entity key is only lent.
### :param key: The key to look for.
### :returns: The index of the key's entry, or `DICT_SLOT_EMPTY` when the key is absent.
routine Dict[TKey, TValue].find(me: @Me, key: @TKey) -> USize
needs TKey: typename, TValue: typename
    capacity: USize = me.slots.count.peek()
    if capacity == 0
        return DICT_SLOT_EMPTY
    else
        hash: U64 = key.hash()
        slot: USize = me.slot(key, hash)
        slots: @USize = me.slots.data.peek()
        entry_idx: USize = slots.stride(slot).peek()
        if entry_idx < DICT_SLOT_TOMBSTONE
            return entry_idx
        else
            return DICT_SLOT_EMPTY

### The entry index of `key`, which ends here.
### :param key: The key to look for.
### :returns: The index of the key's entry, or `DICT_SLOT_EMPTY` when the key is absent.
secret routine Dict[TKey, TValue].find_value(me: @Me, key: TKey) -> USize
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    found: USize = me.find(probe)

    drop probe
    return found

### Whether the key at `key` is present, read through its place.
### :param key: The key to look for.
### :returns: `true` when an entry with an equal key is live.
routine Dict[TKey, TValue].has_key(me: @Me, key: @TKey) -> Bool
needs TKey: typename, TValue: typename
    return me.find(key) != DICT_SLOT_EMPTY

### Whether `key` is present.
### :param key: The key to look for.
### :returns: `true` when an entry with an equal key is live.
routine Dict[TKey, TValue].has_key(me: @Me, key: TKey) -> Bool
needs TKey: typename, TValue: typename
    return me.find_value(steal key) != DICT_SLOT_EMPTY

### Whether the key at `key` is not a key: the opposite of `has_key`.
### :param key: The key to look for.
### :returns: `true` when `has_key` would be `false`.
routine Dict[TKey, TValue].lacks_key(me: @Me, key: @TKey) -> Bool
needs TKey: typename, TValue: typename
    there: Bool = me.has_key(key)
    return not there

### Whether `key` is not a key: the opposite of `has_key`.
### :param key: The key to look for.
### :returns: `true` when `has_key` would be `false`.
routine Dict[TKey, TValue].lacks_key(me: @Me, key: TKey) -> Bool
needs TKey: typename, TValue: typename
    there: Bool = me.has_key(steal key)
    return not there

### Two dicts are equal when they hold the same key-value pairs, regardless of insertion order or slot layout. With
### matching counts, every key of `me` being in `other` with an equal value is enough.
### :param other: The dict to compare with.
### :returns: True when the two hold the same pairs.
routine Dict[TKey, TValue].eq(me: @Me, other: @Me) -> Bool
needs TKey: typename, TValue: typename, Equatable[TValue]
    return me.eq_at(other)

### `eq`, through pointers to the two dicts.
### :param other: The dict to compare with.
### :returns: True when the two hold the same pairs.
secret routine Dict[TKey, TValue].eq_at(me: @Me, other: @Me) -> Bool
needs TKey: typename, TValue: typename, Equatable[TValue]
    la: USize = me.count.peek()
    lb: USize = other.count.peek()
    if la == lb
        n: USize = me.entries_count.peek()

        each i in 0 til n
            entry_states: @U8 = me.entry_states.data.peek()
            s: U8 = entry_states.stride(i).peek()
            if s == 1
                keys: @TKey = me.keys.data.peek()
                eb: USize = other.find(keys.stride(i))
                if eb < DICT_SLOT_TOMBSTONE
                    values_a: @TValue = me.values.data.peek()
                    values_b: @TValue = other.values.data.peek()
                    if values_a.stride(i).eq(values_b.stride(eb))
                        continue
                    else
                        return false
                else
                    return false
            else
                continue
        then
            return true
    else
        return false

### Allocates fresh arrays of `new_capacity`, walks the old entries in insertion order, and re-inserts each live
### entry. Dead entries are dropped, so the entries array is compacted. The new arrays are made in the order keys,
### values, hashes, entry states, slots, and a failure releases the ones already made.
### :param new_capacity: The new capacity, a power of two above the live count.
### :returns: True when it rehashed, false when the allocator failed (the map is left as it was).
@reshaping
secret routine Dict[TKey, TValue].rehash(me: @Me, new_capacity: USize) -> Bool
needs TKey: typename, TValue: typename
    local alloc: @MemoryManager = me.keys.manager.peek()
    local fresh: @Me <- .construct(alloc)
    local keys: @Memory[TKey] = fresh.keys
    local values: @Memory[TValue] = fresh.values
    local hashes: @Memory[U64] = fresh.hashes
    local entry_states: @Memory[U8] = fresh.entry_states
    local slots: @Memory[USize] = fresh.slots

    if make_array[TKey](into: keys, count: new_capacity)
        if make_array[TValue](into: values, count: new_capacity)
            if make_array[U64](into: hashes, count: new_capacity)
                if make_array[U8](into: entry_states, count: new_capacity)
                    if make_array[USize](into: slots, count: new_capacity)
                        each i in 0 til new_capacity
                            slot_cells: @USize = slots.data.peek()
                            state_cells: @U8 = entry_states.data.peek()
                            slot_cells.stride(i).poke(DICT_SLOT_EMPTY)
                            state_cells.stride(i).poke(0)
                        # Swaps the new arrays into the dict, so the claimed slices hold the old ones from here on.
                        old_count: USize = me.entries_count.peek()
                        swap_slices[TKey](a: me.keys, b: keys)
                        swap_slices[TValue](a: me.values, b: values)
                        swap_slices[U64](a: me.hashes, b: hashes)
                        swap_slices[U8](a: me.entry_states, b: entry_states)
                        swap_slices[USize](a: me.slots, b: slots)
                        me.count.poke(0)
                        me.entries_count.poke(0)

                        each i in 0 til old_count
                            states: @U8 = entry_states.data.peek()
                            s: U8 = states.stride(i).peek()
                            if s == 1
                                old_keys: @TKey = keys.data.peek()
                                old_values: @TValue = values.data.peek()
                                old_hashes: @U64 = hashes.data.peek()
                                hash: U64 = old_hashes.stride(i).peek()
                                me.setitem_direct(key: steal old_keys.stride(i),
                                    value: steal old_values.stride(i), hash)
                        drop fresh
                        return true
    drop fresh
    return false

### Makes room for one more entry: the first insertion rehashes into 8 slots, and the tables double once one more
### entry would fill three quarters of them.
### :returns: True when there is room, false when the allocator failed (the map is left as it was).
@reshaping
secret routine Dict[TKey, TValue].ensure(me: @Me) -> Bool
needs TKey: typename, TValue: typename
    local capacity: USize = me.slots.count.peek()

    if capacity == 0
        return me.rehash(8)
    else
        count: USize = me.entries_count.peek()
        limit: USize = capacity * 3 // 4
        if count + 1 >= limit
            return me.rehash(capacity * 2)
        else
            return true

### Inserts without growing, for rehash once the new arrays are in place and for `setitem_result` after `ensure`. A key
### already live gets its value updated in place, so it keeps its position in insertion order. Otherwise a fresh
### entry is appended at `entries_count` and the slot bound to it. A key equal to one already there ends here.
### :param key: The key to store under.
### :param value: The value to store.
### :param hash: The key's hash, so rehash can pass the stored one instead of hashing every key again.
routine Dict[TKey, TValue].setitem_direct(me: @Me, key: TKey, value: TValue, hash: U64) -> None
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key
    local slot: USize = me.slot(key: probe, hash)
    local slots: @USize = me.slots.data.peek()
    local entry_idx: USize = slots.stride(slot).peek()

    if entry_idx < DICT_SLOT_TOMBSTONE
        drop probe
        values: @TValue = me.values.data.peek()
        drop values.stride(entry_idx)
        values.stride(entry_idx).poke(steal value)
        return
    else
        new_idx: USize = me.entries_count.peek()
        keys: @TKey = me.keys.data.peek()
        values: @TValue = me.values.data.peek()
        hashes: @U64 = me.hashes.data.peek()
        entry_states: @U8 = me.entry_states.data.peek()
        keys.stride(new_idx).poke(steal probe)
        values.stride(new_idx).poke(steal value)
        hashes.stride(new_idx).poke(hash)
        entry_states.stride(new_idx).poke(1)
        slots.stride(slot).poke(new_idx)
        next_count: USize = me.count.peek() + 1
        next_count.poke_into(me.count)
        me.entries_count.poke(new_idx + 1)
        return

### Stores `value` under `key`, inserting a new entry or replacing the value of an equal existing key.
### :param key: The key to store under.
### :param value: The value to store.
### :throws: Crashes with `MemoryAllocationError` when the tables must grow and the allocator fails. See {Dict[TKey, TValue].setitem_result} for a recoverable form.
@track_caller
@reshaping
routine Dict[TKey, TValue].setitem(me: @Me, key: TKey, value: TValue) -> None
needs TKey: typename, TValue: typename
    when me.setitem_result(key: steal key, value: steal value)
        is None => return
        is AllocFailed => crash_allocation()

### `setitem`, returning an error instead of crashing when the allocator fails.
### :param key: The key to store under.
### :param value: The value to store.
### :returns: A value once the value is stored.
### :throws: Returns `AllocFailed` when the tables must grow and the allocator fails.
@reshaping
routine Dict[TKey, TValue].setitem_result(me: @Me, key: TKey,
    value: TValue) -> Result[None, AllocFailed]
needs TKey: typename, TValue: typename
    hash: U64 = key.hash()

    if not me.ensure()
        # nothing took the key and the value: they end here
        drop key
        drop value
        return AllocFailed()
    me.setitem_direct(key: steal key, value: steal value, hash)
    return None()

### Reads the value stored under `key`.
### :param key: The key to look up, read through its place.
### :returns: A copy of the value.
### :throws: Crashes with `KeyNotFoundError` when the key is absent. See {Dict[TKey, TValue].getitem_checked}.
@track_caller
routine Dict[TKey, TValue].getitem(me: @Me, key: @TKey) -> TValue
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find(key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: TValue = values.stride(entry_idx).peek()
        return value
    else
        crash_key_not_found()

### Reads the value stored under `key`.
### :param key: The key to look up.
### :returns: A copy of the value.
### :throws: Crashes with `KeyNotFoundError` when the key is absent. See {Dict[TKey, TValue].getitem_checked}.
@track_caller
routine Dict[TKey, TValue].getitem(me: @Me, key: TKey) -> TValue
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find_value(steal key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: TValue = values.stride(entry_idx).peek()
        return value
    else
        crash_key_not_found()

### `getitem`, returning None instead of crashing on a missing key.
### :param key: The key to look up, read through its place.
### :returns: A copy of the value.
### :absent: When the key is not present.
routine Dict[TKey, TValue].getitem_checked(me: @Me, key: @TKey) -> Maybe[TValue]
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find(key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: TValue = values.stride(entry_idx).peek()
        return value
    else
        return None()

### `getitem`, returning None instead of crashing on a missing key.
### :param key: The key to look up.
### :returns: A copy of the value.
### :absent: When the key is not present.
routine Dict[TKey, TValue].getitem_checked(me: @Me, key: TKey) -> Maybe[TValue]
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find_value(steal key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: TValue = values.stride(entry_idx).peek()
        return value
    else
        return None()

### The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
### value: changing a key in place would lose it. It stays valid until the dict grows, rehashes, or is destructed.
### :param key: The key to look up, read through its place.
### :returns: The value's address.
### :throws: Crashes with `KeyNotFoundError` when the key is absent.
@track_caller
routine Dict[TKey, TValue].getslot(me: @Me, key: @TKey) -> @TValue
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find(key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: @TValue = values.stride(entry_idx)
        return value
    else
        crash_key_not_found()

### The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
### value: changing a key in place would lose it. It stays valid until the dict grows, rehashes, or is destructed.
### :param key: The key to look up.
### :returns: The value's address.
### :throws: Crashes with `KeyNotFoundError` when the key is absent.
@track_caller
routine Dict[TKey, TValue].getslot(me: @Me, key: TKey) -> @TValue
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find_value(steal key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: @TValue = values.stride(entry_idx)
        return value
    else
        crash_key_not_found()

### `at`, returning None instead of crashing on a missing key.
### :param key: The key to look up, read through its place.
### :returns: The value's address.
### :absent: When the key is not present.
routine Dict[TKey, TValue].getslot_checked(me: @Me, key: @TKey) -> Maybe[@TValue]
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find(key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: @TValue = values.stride(entry_idx)
        return value
    else
        return None()

### `at`, returning None instead of crashing on a missing key.
### :param key: The key to look up.
### :returns: The value's address.
### :absent: When the key is not present.
routine Dict[TKey, TValue].getslot_checked(me: @Me, key: TKey) -> Maybe[@TValue]
needs TKey: typename, TValue: typename
    local entry_idx: USize = me.find_value(steal key)

    if entry_idx < DICT_SLOT_TOMBSTONE
        values: @TValue = me.values.data.peek()
        value: @TValue = values.stride(entry_idx)
        return value
    else
        return None()

### Removes the entry for `key`. Removal keeps the entries array's layout: the entry is marked dead and its slot
### becomes a tombstone, so surviving entries keep their order until the next rehash.
### :param key: The key to remove, read through its place.
### :returns: `true` when an entry was removed, `false` when the key was not present.
routine Dict[TKey, TValue].remove(me: @Me, key: @TKey) -> Bool
needs TKey: typename, TValue: typename
    capacity: USize = me.slots.count.peek()
    if capacity == 0
        return false
    else
        hash: U64 = key.hash()
        slot: USize = me.slot(key, hash)
        slots: @USize = me.slots.data.peek()
        entry_idx: USize = slots.stride(slot).peek()
        if entry_idx < DICT_SLOT_TOMBSTONE
            slots2: @USize = me.slots.data.peek()
            entry_states: @U8 = me.entry_states.data.peek()
            keys: @TKey = me.keys.data.peek()
            values: @TValue = me.values.data.peek()
            drop keys.stride(entry_idx)
            drop values.stride(entry_idx)
            slots2.stride(slot).poke(DICT_SLOT_TOMBSTONE)
            entry_states.stride(entry_idx).poke(0)
            remaining_count: USize = me.count.peek() - 1
            remaining_count.poke_into(me.count)
            return true
        else
            return false

### Removes the entry for `key`, which ends here.
### :param key: The key to remove.
### :returns: `true` when an entry was removed, `false` when the key was not present.
routine Dict[TKey, TValue].remove(me: @Me, key: TKey) -> Bool
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    removed: Bool = me.remove(probe)

    drop probe
    return removed

### Ends every key and value (drop: one with something to give back gives it back, a plain value or a borrowed
### pointer gives nothing), then gives the dict's memory back to its allocator and resets it to the empty state, so
### it can be reused or destructed again.
### :note: Does nothing on a hollow instance (`.hollow()`, no allocator), and only resets the fields of a never-filled one.
@track_caller
routine Dict[TKey, TValue].destruct(me: @Me) -> None
needs TKey: typename, TValue: typename
    if me.keys.manager.peek().is_null()
        return
    keys: @TKey = me.keys.data.peek()
    values: @TValue = me.values.data.peek()
    states: @U8 = me.entry_states.data.peek()
    each i in 0 til me.entries_count.peek()
        if states.stride(i).peek() == 1
            drop keys.stride(i)
            drop values.stride(i)
    me.keys.give_back()
    me.values.give_back()
    me.hashes.give_back()
    me.entry_states.give_back()
    me.slots.give_back()
    me.count.poke(0)
    me.entries_count.poke(0)
    return

# -- text -----------------------------------------------------------------------

### The entries in insertion order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine Dict[TKey, TValue].represent_into[TWriter](me: @Me, out: @TWriter) -> None
needs TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue], TWriter: typename, Writer[TWriter]
    me.write_entries(out)
    return

### The entries in insertion order, keys and values diagnosed: {"a": 1, "b": 2}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine Dict[TKey, TValue].diagnose_into[TWriter](me: @Me, out: @TWriter) -> None
needs TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue], TWriter: typename, Writer[TWriter]
    me.write_entries(out)
    return

### Writes {key: value, ...}: each live entry's key and value diagnosed through their places, in insertion order.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
secret routine Dict[TKey, TValue].write_entries[TWriter](me: @Me, out: @TWriter) -> None
needs TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue], TWriter: typename, Writer[TWriter]
    keys: @TKey = me.keys.data.peek()
    values: @TValue = me.values.data.peek()
    states: @U8 = me.entry_states.data.peek()

    write_str(out, text: "{")
    each i in 0 til me.entries_count.peek() with first: Bool = true
        if states.stride(i).peek() == 1
            if not first
                write_str(out, text: ", ")
            keys.stride(i).diagnose_into(out)
            write_str(out, text: ": ")
            values.stride(i).diagnose_into(out)
            continue with first: false
        continue with first: first
    then
        write_str(out, text: "}")
        return

# -- the arrays -----------------------------------------------------------------

### Fills `into` (an empty slice holding the allocator) with `count` new values from that allocator. Set's rehash
### makes its arrays the same way.
### :typeparam T: The element type.
### :param into: The empty slice to fill, which carries the allocator.
### :param count: The number of elements to allocate.
### :returns: True when it allocated, false when the allocator failed (leaving `into` empty).
secret routine make_array[T](into: @Memory[T], count: USize) -> Bool
needs T: typename
    alloc: @MemoryManager = into.manager.peek()
    when Memory[T].construct_result(count, manager: alloc)
        is Memory[T] as slice =>
            into.replace(value: steal slice)
            return true
        is AllocFailed => return false

### Exchanges the slices at `a` and `b`.
### :typeparam T: The element type.
### :param a: The first slice.
### :param b: The second slice.
secret routine swap_slices[T](a: @Memory[T], b: @Memory[T]) -> None
needs T: typename
    local first: @Memory[T] <- steal a.stride(0)

    a.poke(steal b.stride(0))
    b.poke(steal first)
    return
