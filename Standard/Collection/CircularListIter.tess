// Tessera stdlib collection: CircularListIter[T]
//
// Forward iterator over CircularList[T], yielding elements front-to-back.
// Delegates index-to-physical mapping to CircularList.getitem, which reads storage.data[start + index].
//
// Satisfies concepts Iterator[T, CircularListIter[T]] and SlotIterator[T, CircularListIter[T]].

module Standard/Collections

/// A forward iterator over a {CircularList[T]}, front to back. It borrows the list, so the list must outlive the iterator and must not change while it is walked.
/// :typeparam T: The element type.
record CircularListIter[T]
conform Iterator[T, CircularListIter[T]], SlotIterator[T, CircularListIter[T]]
require T: typename
    circular_list: @CircularList[T]
    index: USize

/// Creates an iterator positioned before the first element of `circular_list`.
/// :param circular_list: The list to walk.
/// :returns: A new iterator at the front.
routine CircularListIter[T].construct(circular_list: @CircularList[T]) -> Me
require T: typename
    block entry()
        iter: Me = Me(circular_list: circular_list, index: 0)
        return(iter)

/// Yields the next element and advances the iterator.
/// :returns: The next element, front to back.
/// :absent: After the last element has been yielded.
routine CircularListIter[T].emit_checked(me: @Me) -> Maybe[T]
require T: typename
    local circular_list: @CircularList[T] = me.circular_list.peek()
    local len: USize = circular_list.count()
    local index: USize = me.index.peek()

    block entry()
        done: Bool = index.ge(len)
        branch done
            ? return_none()
            : return_some()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block return_some()
        value: T = circular_list.getitem(index)
        me.index.poke(index.add(1))
        some: Maybe[T] = value
        return(some)

/// Yields the next element and advances the iterator, crashing when there is none.
/// :returns: The next element, front to back.
/// :throws: Crashes with `AbsentValueError` after the last element has been yielded.
#track_caller
routine CircularListIter[T].emit(me: @Me) -> T
require T: typename
    block entry()
        item: Maybe[T] = me.emit_checked()
        when item
            is T as value => return(value)
            is Unit => crash_absent_value()

/// Hands out the next element's slot and advances the iterator. Writing through the slot changes the element in the
/// collection.
/// :returns: The address of the next element, front to back.
/// :absent: After the last element has been handed out.
routine CircularListIter[T].next_checked(me: @Me) -> Maybe[@T]
require T: typename
    local circular_list: @CircularList[T] = me.circular_list.peek()
    local index: USize = me.index.peek()

    block entry()
        done: Bool = index.ge(circular_list.count())
        branch done
            ? return(Unit())
            : continue
        me.index.poke(index.add(1))
        element: @T = circular_list.getslot(index)
        return(element)

/// Hands out the next element's slot and advances the iterator, crashing when there is none.
/// :returns: The address of the next element, front to back.
/// :throws: Crashes with `AbsentValueError` after the last element has been handed out.
#track_caller
routine CircularListIter[T].next(me: @Me) -> @T
require T: typename
    block entry()
        slot: Maybe[@T] = me.next_checked()
        when slot
            is @T as element => return(element)
            is Unit => crash_absent_value()
