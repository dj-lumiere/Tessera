// Tessera stdlib collection: collections as text
//
// A collection represents and diagnoses the same way, with its elements
// diagnosed, so strings keep their quotes: a list as ["a", "b"], a set as
// {1, 2, 3}, and a map as {"a": 1, "b": 2}. The order is the collection's
// iteration order. These helpers walk any iterator. Each collection's
// represent and diagnose call them with its own brackets.

module Standard/Collections

import Standard/Format

/// Writes `open`, the items `iter` yields separated by ", ", then `close`, with each item diagnosed.
/// :typeparam TItem: The item type.
/// :typeparam TIter: The iterator type.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
/// :param iter: The iterator to drain.
/// :param open: The opening bracket.
/// :param close: The closing bracket.
routine diagnose_items[TItem, TIter, TWriter](out: @TWriter, iter: @TIter, open: Bytes,
    close: Bytes) -> Void
require TItem: typename, TIter: typename, TWriter: typename, Iterator[TItem, TIter], Diagnosable[TItem], Writer[TWriter]
    write_str(out, text: open)
    jump next(true)

    block next(first: Bool)
        item: Maybe[TItem] = iter.emit_checked()
        when item
            is TItem as value => separate(first, value)
            is Unit => close()

    block separate(first: Bool, value: TItem)
        branch first
            ? element(value)
            : comma(value)

    block comma(value: TItem)
        write_str(out, text: ", ")
        jump element(value)

    block element(value: TItem)
        value.diagnose_into(out)
        jump next(false)

    block close()
        write_str(out, text: close)
        return()

/// Writes {key: value, ...} from an iterator over KVPairs, keys and values diagnosed.
/// :typeparam TKey: The key type.
/// :typeparam TValue: The value type.
/// :typeparam TIter: The iterator type.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
/// :param iter: The iterator to drain.
routine diagnose_entries[TKey, TValue, TIter, TWriter](out: @TWriter, iter: @TIter) -> Void
require TKey: typename, TValue: typename, TIter: typename, TWriter: typename, Iterator[KVPair[TKey, TValue], TIter]
require Diagnosable[TKey], Diagnosable[TValue], Writer[TWriter]
    write_str(out, text: "{")
    jump next(true)

    block next(first: Bool)
        item: Maybe[KVPair[TKey, TValue]] = iter.emit_checked()
        when item
            is KVPair[TKey, TValue] as pair => separate(first, pair)
            is Unit => close()

    block separate(first: Bool, pair: KVPair[TKey, TValue])
        branch first
            ? element(pair)
            : comma(pair)

    block comma(pair: KVPair[TKey, TValue])
        write_str(out, text: ", ")
        jump element(pair)

    block element(pair: KVPair[TKey, TValue])
        key: TKey = pair.key
        value: TValue = pair.value
        key.diagnose_into(out)
        write_str(out, text: ": ")
        value.diagnose_into(out)
        jump next(false)

    block close()
        write_str(out, text: "}")
        return()
