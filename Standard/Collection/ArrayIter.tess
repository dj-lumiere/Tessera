// Tessera stdlib collection: ArrayIter<T, N>
//
// Forward iterator over a fixed-size Array<T, N> held behind a pointer.
// The length N is computed once at construction via sizeof division and stored
// in the record so next() never needs generic arithmetic.
//
// Satisfies concept Iterator<T, ArrayIter<T, N>>.

module Standard::Core

/// A forward iterator over an {Array<T, N>} held behind a pointer. The length `N` is stored once at construction, and the array must outlive the iterator.
/// :typeparam T: The element type.
/// :typeparam N: The array length.
record ArrayIter<T, N>
conform Iterator<T, ArrayIter<T, N>>
require T: typename, N: USize
    data   : @T  // bitcast of the original @Array<T, N>
    index  : USize
    length : USize  // = N, resolved at monomorphisation

/// Creates an iterator positioned before the first element of `arr`.
/// :param arr: The array to walk.
/// :returns: A new iterator at index `0`.
routine ArrayIter<T, N>.construct(arr: @Array<T, N>) -> Self
require T: typename, N: USize
    block entry():
        data : @T   = bitcast<@Array<T, N>, @T>(arr)
        iter : Self = Self { data: data, index: 0, length: N }
        return(iter)

/// Yields the next element and advances the iterator.
/// :returns: The next element, in index order.
/// :absent: After the last element has been yielded.
routine ArrayIter<T, N>.next(self: @Self) -> Option<T>
require T: typename, N: USize
    block entry():
        index  : USize = self.index.load()
        length : USize = self.length.load()
        done   : Bool  = index.ge(length)
        branch done
            ? return_none()
            : return_some(index)

    block return_none():
        none : Option<T> = .Absent
        return(none)

    block return_some(index: USize):
        data  : @T = self.data.load()
        value : T  = data.stride(index).load()
        self.index.store(index.add(1))
        some : Option<T> = .Present(value)
        return(some)
