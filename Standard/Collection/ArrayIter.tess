// Tessera stdlib collection: ArrayIter<T, COUNT>
//
// Forward iterator over a fixed-size Array<T, COUNT> held behind a pointer.
// The count N is computed once at construction via sizeof division and stored
// in the record so next() never needs generic arithmetic.
//
// Satisfies concept Iterator<T, ArrayIter<T, COUNT>>.

module Standard::Core

/// A forward iterator over an {Array<T, COUNT>} held behind a pointer. The count `COUNT` is stored once at construction, and the array must outlive the iterator.
/// :typeparam T: The element type.
/// :typeparam COUNT: The number of elements.
record ArrayIter<T, COUNT>
conform Iterator<T, ArrayIter<T, COUNT>>
require T: typename, COUNT: USize
    data  : @T  // bitcast of the original @Array<T, COUNT>
    index : USize
    count : USize  // = COUNT, resolved at monomorphisation

/// Creates an iterator positioned before the first element of `arr`.
/// :param arr: The array to walk.
/// :returns: A new iterator at index `0`.
routine ArrayIter<T, COUNT>.construct(arr: @Array<T, COUNT>) -> Self
require T: typename, COUNT: USize
    block entry()
        data : @T   = bitcast<@Array<T, COUNT>, @T>(arr)
        iter : Self = Self { data: data, index: 0, count: COUNT }
        return(iter)

/// Yields the next element and advances the iterator.
/// :returns: The next element, in index order.
/// :absent: After the last element has been yielded.
routine ArrayIter<T, COUNT>.next(self: @Self) -> Option<T>
require T: typename, COUNT: USize
    shared index : USize = self.index.load()

    block entry()
        count : USize = self.count.load()
        done  : Bool  = index.ge(count)
        branch done
            ? return_none()
            : return_some()

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block return_some()
        data  : @T = self.data.load()
        value : T  = data.stride(index).load()
        self.index.store(index.add(1))
        some : Option<T> = .Present(value)
        return(some)
