// Tessera stdlib collection: ArrayIter[T, COUNT]
//
// Forward iterator over a fixed-size Array[T, COUNT] held behind a pointer.
// The count N is computed once at construction via sizeof division and stored
// in the record so emit_checked() never needs generic arithmetic.
//
// Satisfies concepts Iterator[T, ArrayIter[T, COUNT]] and SlotIterator[T, ArrayIter[T, COUNT]].

module Standard/Core

/// A forward iterator over an {Array[T, COUNT]} held behind a pointer. The count `COUNT` is stored once at construction, and the array must outlive the iterator.
/// :typeparam T: The element type.
/// :typeparam COUNT: The number of elements.
record ArrayIter[T, COUNT]
conform Iterator[T, ArrayIter[T, COUNT]], SlotIterator[T, ArrayIter[T, COUNT]]
require T: typename, COUNT: USize
    data: @T  // bitcast of the original @Array[T, COUNT]
    index: USize
    count: USize  // = COUNT, resolved at monomorphisation

/// Creates an iterator positioned before the first element of `arr`.
/// :param arr: The array to walk.
/// :returns: A new iterator at index `0`.
routine ArrayIter[T, COUNT].construct(arr: @Array[T, COUNT]) -> Me
require T: typename, COUNT: USize
    block entry()
        data: @T = bitcast[@Array[T, COUNT], @T](arr)
        iter: Me = Me(data: data, index: 0, count: COUNT)
        return(iter)

/// Yields the next element and advances the iterator.
/// :returns: The next element, in index order.
/// :absent: After the last element has been yielded.
routine ArrayIter[T, COUNT].emit_checked(me: @Me) -> Maybe[T]
require T: typename, COUNT: USize
    local index: USize = me.index.peek()

    block entry()
        count: USize = me.count.peek()
        done: Bool = index.ge(count)
        branch done
            ? return_none()
            : return_some()

    block return_none()
        none: Maybe[T] = Unit()
        return(none)

    block return_some()
        data: @T = me.data.peek()
        value: T = data.stride(index).peek()
        me.index.poke(index.add(1))
        some: Maybe[T] = value
        return(some)

/// Yields the next element and advances the iterator, crashing when there is none.
/// :returns: The next element, in index order.
/// :throws: Crashes with `AbsentValueError` after the last element has been yielded.
#track_caller
routine ArrayIter[T, COUNT].emit(me: @Me) -> T
require T: typename, COUNT: USize
    block entry()
        item: Maybe[T] = me.emit_checked()
        when item
            is T as value => return(value)
            is Unit => crash_absent_value()

/// Hands out the next element's slot and advances the iterator. Writing through the slot changes the element in the
/// collection.
/// :returns: The address of the next element, in index order.
/// :absent: After the last element has been handed out.
routine ArrayIter[T, COUNT].next_checked(me: @Me) -> Maybe[@T]
require T: typename, COUNT: USize
    local index: USize = me.index.peek()

    block entry()
        done: Bool = index.ge(me.count.peek())
        branch done
            ? return(Unit())
            : continue
        me.index.poke(index.add(1))
        element: @T = me.data.peek().stride(index)
        return(element)

/// Hands out the next element's slot and advances the iterator, crashing when there is none.
/// :returns: The address of the next element, in index order.
/// :throws: Crashes with `AbsentValueError` after the last element has been handed out.
#track_caller
routine ArrayIter[T, COUNT].next(me: @Me) -> @T
require T: typename, COUNT: USize
    block entry()
        slot: Maybe[@T] = me.next_checked()
        when slot
            is @T as element => return(element)
            is Unit => crash_absent_value()
