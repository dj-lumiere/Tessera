// Tessera stdlib collection: SortedSetIter<T>
//
// In-order iterator over SortedSet<T>. Yields keys in ascending sorted order. It keeps the path from the root to the current node
// on an inline stack, so a full traversal is O(n) and the iterator allocates
// nothing.
//
// Satisfies concept Iterator<T, SortedSetIter<T>>.

module Standard::Collections

/// Every internal node has at least two children, so 2^64 entries fit in 64 levels.
private preset ITER_DEPTH: USize = 64

/// `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the next key to yield. Every child
/// left of that key has been walked already.
record SortedSetIter<T>
conform Iterator<T, SortedSetIter<T>>
require T: typename
    nodes   : Array<@SortedSetNode<T>, ITER_DEPTH>
    indices : Array<USize, ITER_DEPTH>
    depth   : USize

/// Creates an iterator positioned before the smallest element, descending to the leftmost leaf.
/// :param set: The sorted set to walk.
/// :returns: A new iterator, already positioned when the set is not empty.
routine SortedSetIter<T>.construct(set: @SortedSet<T>) -> Self
require T: typename
    block entry():
        claim iter : @Self <- uninit
        root  : @SortedSetNode<T> = set.root.load()
        empty : Bool              = root.is_null()
        iter.depth.store(0)
        branch empty
            ? finish(iter)
            : continue
        iter.push_leftmost(root)
        jump finish(iter)

    block finish(iter: @Self):
        iter_val : Self = iter.load()
        return(iter_val)

/// Pushes node and the first child of each level below it, down to a leaf.
private routine SortedSetIter<T>.push_leftmost(self: @Self, node: @SortedSetNode<T>) -> Void
require T: typename
    block entry():
        jump push(node)

    block push(node: @SortedSetNode<T>):
        depth : USize = self.depth.load()
        leaf  : Bool  = node.leaf.load()
        self.nodes.set(depth, node)
        self.indices.set(depth, 0)
        self.depth.store(depth.add(1))
        branch leaf
            ? return()
            : first_child(node)

    block first_child(node: @SortedSetNode<T>):
        jump push(node.children.get(0))

/// Yields the next element in ascending order, climbing to a parent or descending to the next leaf as needed.
/// :returns: The next element, smallest first.
/// :absent: After the largest element has been yielded.
routine SortedSetIter<T>.next(self: @Self) -> Option<T>
require T: typename
    block entry():
        jump top()

    block top():
        depth : USize = self.depth.load()
        empty : Bool  = depth.eq(0)
        branch empty
            ? done()
            : continue
        level   : USize             = depth.sub(1)
        node    : @SortedSetNode<T> = self.nodes.get(level)
        index   : USize             = self.indices.get(level)
        length  : USize             = node.length.load()
        has_key : Bool              = index.lt(length)
        branch has_key
            ? take(node, level, index)
            : pop(level)

    block pop(level: USize):
        self.depth.store(level)
        jump top()

    block take(node: @SortedSetNode<T>, level: USize, index: USize):
        key  : T    = node.keys.get(index)
        leaf : Bool = node.leaf.load()
        self.indices.set(level, index.add(1))
        branch leaf
            ? yield(key)
            : continue
        right : @SortedSetNode<T> = node.children.get(index.add(1))
        self.push_leftmost(right)
        jump yield(key)

    block yield(key: T):
        some : Option<T> = .Present(key)
        return(some)

    block done():
        none : Option<T> = .Absent
        return(none)
