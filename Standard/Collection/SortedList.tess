// Tessera stdlib collection: SortedList<T>
//
// A sorted sequence that keeps duplicates: push puts a value after every equal
// one, so equal values stay in the order they came. get(order) and
// remove(order) work by position in that order, and rank finds where a value goes.
//
// The elements live in a B-tree keyed by position, with a fixed node value
// capacity of NODE_VALUES. Nodes store arrays inline. The allocator is stored
// in SortedList. Node helpers still receive it as a parameter. Internal nodes
// use `count` as the child count (no separator keys: navigation is purely by
// subtree_count). Leaf nodes use `count` as the value count. push finds its
// position by binary search over get, so it costs O(log² n).

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset NODE_VALUES: USize = 7
private preset NODE_CHILDREN: USize = NODE_VALUES.add(1)
private preset NODE_MIN: USize = NODE_VALUES.add(1).div(2)

/// One node of a {SortedList<T>} B-tree: up to `NODE_VALUES` values inline, and for internal nodes the child pointers. An internal node keeps no separator values, and its `count` is its child count. A leaf's `count` is its value count. `subtree_count` is the total values below the node.
/// :typeparam T: The element type.
record SortedListNode<T>
require T: typename
    leaf          : Bool
    count         : USize
    subtree_count : USize
    values        : Array<T, NODE_VALUES>
    children      : Array<@SortedListNode<T>, NODE_CHILDREN>

/// A sorted sequence that keeps duplicates, stored as a B-tree indexed by position. `push` places a value after every equal one, so equal values stay in arrival order. `get` and `remove` work by position, and `rank` finds where a value belongs.
/// :typeparam T: The element type, ordered by its `Compare` conformance.
record SortedList<T>
conform Destruct<SortedList<T>>
conform Represent<SortedList<T>> when T: typename, Compare<T>, Diagnose<T>
conform Diagnose<SortedList<T>>  when T: typename, Compare<T>, Diagnose<T>
conform Equal<SortedList<T>>     when T: typename, Compare<T>, Equal<T>
require T: typename, Compare<T>
    root  : @SortedListNode<T>
    count : USize
    alloc : @Allocator

/// Creates an empty SortedList that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the list stores and later frees its memory with.
/// :returns: A new empty SortedList.
routine SortedList<T>.construct(alloc: @Allocator) -> Self
require T: typename, Compare<T>
    block entry()
        list : Self = Self { root: null, count: 0, alloc: alloc }
        return(list)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine SortedList<T>.count(self: Self) -> USize
require T: typename
    block entry()
        count : USize = self.count
        return(count)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine SortedList<T>.is_empty(self: Self) -> Bool
require T: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        return(empty)

/// A new empty node, or null when the allocator fails.
routine SortedListNode<T>.construct(leaf: Bool, alloc: @Allocator) -> @Self
require T: typename
    block entry()
        node   : @Self = allocate<Self>(alloc, 1)
        failed : Bool  = node.is_null()
        branch failed
            ? return(node)
            : init(node)

    block init(node: @Self)
        node.leaf.store(leaf)
        node.count.store(0)
        node.subtree_count.store(0)
        return(node)

/// The number of values in the subtree below this node.
/// :returns: The node's subtree count, or `0` for a null node.
routine SortedListNode<T>.subtree_count(self: @Self) -> USize
require T: typename
    block entry()
        empty : Bool = self.is_null()
        branch empty
            ? return(0)
            : count()

    block count()
        count : USize = self.subtree_count.load()
        return(count)

/// Recomputes this node's subtree count from its own values or from its children's counts. Call it after the node's contents change.
routine SortedListNode<T>.recount(self: @Self) -> Void
require T: typename
    block entry()
        leaf  : Bool  = self.leaf.load()
        count : USize = self.count.load()
        branch leaf
            ? leaf_count(count)
            : internal_count(count)

    block leaf_count(count: USize)
        self.subtree_count.store(count)
        return()

    block internal_count(count: USize)
        jump loop(0, 0, count)

    block loop(i: USize, sum: USize, count: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish(sum)
            : add_child(i, sum, count)

    block add_child(i: USize, sum: USize, count: USize)
        child       : @Self = self.children.get(i)
        child_count : USize = child.subtree_count()
        jump loop(i.add(1), sum.add(child_count), count)

    block finish(sum: USize)
        self.subtree_count.store(sum)
        return()

/// Whether two sorted lists hold equal elements in the same sorted order.
/// :param other: The list to compare with.
/// :returns: `true` when the counts match and every element pair is equal.
routine SortedList<T>.eq(self: Self, other: Self) -> Bool
require T: typename, Equal<T>
    block entry()
        claim a : @Self <- self
        claim b : @Self <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// eq, through pointers to the two SortedLists.
private routine SortedList<T>.eq_at(self: @Self, other: @Self) -> Bool
require T: typename, Equal<T>
    block entry()
        la       : USize = self.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? continue
            : return(false)
        a_val : SortedListIter<T> = .construct(self)
        b_val : SortedListIter<T> = .construct(other)
        claim a : @SortedListIter<T> <- a_val
        claim b : @SortedListIter<T> <- b_val
        jump loop(a, b)

    // both have the same count, so both run out together
    block loop(a: @SortedListIter<T>, b: @SortedListIter<T>)
        x : Option<T> = a.next()
        y : Option<T> = b.next()
        when x
            .Present(x_item) -> compare(a, b, x_item, y.unwrap())
            .Absent          -> return(true)

    block compare(a: @SortedListIter<T>, b: @SortedListIter<T>, x: T, y: T)
        eq : Bool = x.eq(y)
        branch eq
            ? loop(a, b)
            : return(false)

/// Reads the element at position `order` in sorted order, where `0` is the smallest.
/// :param order: The zero-based position in sorted order.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `order >= count`. See {SortedList<T>.get_checked}.
#track_caller
routine SortedList<T>.get(self: Self, order: USize) -> T
require T: typename
    block entry()
        found : Option<T> = self.get_checked(order)
        when found
            .Present(value) -> return(value)
            .Absent         -> crash_out_of_bounds()

/// `get`, returning Absent instead of crashing on a position past the end.
routine SortedList<T>.get_checked(self: Self, order: USize) -> Option<T>
require T: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = order.lt(count)
        branch in_bounds
            ? select_root()
            : return(.Absent)

    block select_root()
        root : @SortedListNode<T> = self.root
        jump select_node(root, order)

    block select_node(node: @SortedListNode<T>, remaining: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? leaf_get(node, remaining)
            : internal_get(node, remaining)

    block leaf_get(node: @SortedListNode<T>, remaining: USize)
        value : T = node.values.get(remaining)
        return(.Present(value))

    block internal_get(node: @SortedListNode<T>, remaining: USize)
        jump scan(node, remaining, 0)

    block scan(node: @SortedListNode<T>, remaining: USize, i: USize)
        child       : @SortedListNode<T> = node.children.get(i)
        child_count : USize              = child.subtree_count()
        in_child    : Bool               = remaining.lt(child_count)
        branch in_child
            ? select_node(child, remaining)
            : scan(node, remaining.sub(child_count), i.add(1))

/// The element at rank, the same as get: a SortedList's rank is its position in sorted order. Crashes if
/// rank >= count.
routine SortedList<T>.get_by_rank(self: Self, rank: USize) -> T
require T: typename
    block entry()
        return(self.get(rank))

/// Puts value in sorted order, after every element equal to it.
#track_caller
routine SortedList<T>.push(self: @Self, value: T) -> Void
require T: typename, Compare<T>
    block entry()
        pushed : Result<Unit, AllocFailed> = self.push_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push`, returning a Failure instead of crashing when the allocator fails.
routine SortedList<T>.push_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename, Compare<T>
    block entry()
        order    : USize = self.load().bound(value, true)
        inserted : Bool  = self.insert_at(order, value)
        branch inserted
            ? return(.Success(Unit.value()))
            : return(.Failure(AllocFailed {}))

/// The number of elements less than value: the position of its first copy if it's there, and where push would put
/// it if not.
routine SortedList<T>.rank(self: Self, value: T) -> USize
require T: typename, Compare<T>
    block entry()
        rank : USize = self.bound(value, false)
        return(rank)

/// Whether an element equal to `value` is in the list.
/// :param value: The value to look for.
/// :returns: `true` when an equal element is present.
routine SortedList<T>.contains(self: Self, value: T) -> Bool
require T: typename, Compare<T>
    block entry()
        rank   : USize = self.rank(value)
        count  : USize = self.count
        inside : Bool  = rank.lt(count)
        branch inside
            ? check(rank)
            : return(false)

    block check(rank: USize)
        at   : T    = self.get(rank)
        same : Bool = at.compare(value).eq(0)
        return(same)

/// The number of elements less than value, or with or_equal, less than or equal to it. Binary search over get.
private routine SortedList<T>.bound(self: Self, value: T, or_equal: Bool) -> USize
require T: typename, Compare<T>
    block entry()
        count : USize = self.count
        jump search(0, count)

    block search(lo: USize, hi: USize)
        open : Bool = lo.lt(hi)
        branch open
            ? probe(lo, hi)
            : return(lo)

    block probe(lo: USize, hi: USize)
        mid     : USize = lo.add(hi.sub(lo).div(2))
        at      : T     = self.get(mid)
        order   : S32   = at.compare(value)
        below   : Bool  = order.lt(0)
        equal   : Bool  = order.eq(0).bitand(or_equal)
        left_of : Bool  = below.bitor(equal)
        branch left_of
            ? search(mid.add(1), hi)
            : search(lo, mid)

/// Splits the full child at index around its middle. Returns false when the
/// allocator fails, before anything has moved.
routine SortedListNode<T>.split_child(self: @Self, index: USize, alloc: @Allocator) -> Bool
require T: typename
    block entry()
        left     : @Self = self.children.get(index)
        leaf     : Bool  = left.leaf.load()
        right    : @Self = Self.construct(leaf, alloc)
        no_right : Bool  = right.is_null()
        branch no_right
            ? return(false)
            : continue
        count       : USize = left.count.load()
        mid         : USize = count.div(2)
        right_count : USize = count.sub(mid)
        branch leaf
            ? copy_values(left, right, mid, right_count)
            : copy_children(left, right, mid, right_count)

    block copy_values(left: @Self, right: @Self, mid: USize, right_count: USize)
        right.values.copy(0, left.values, mid, right_count)
        jump promote(left, right, mid, right_count)

    block copy_children(left: @Self, right: @Self, mid: USize, right_count: USize)
        jump child_loop(0, left, right, mid, right_count)

    block child_loop(i: USize, left: @Self, right: @Self, mid: USize, right_count: USize)
        done : Bool = i.ge(right_count)
        branch done
            ? promote(left, right, mid, right_count)
            : child_copy(i, left, right, mid, right_count)

    block child_copy(i: USize, left: @Self, right: @Self, mid: USize, right_count: USize)
        src   : USize = mid.add(i)
        child : @Self = left.children.get(src)
        right.children.set(i, child)
        jump child_loop(i.add(1), left, right, mid, right_count)

    block promote(left: @Self, right: @Self, mid: USize, right_count: USize)
        parent_count : USize = self.count.load()
        jump shift_children(parent_count, left, right, mid, right_count)

    block shift_children(i: USize, left: @Self, right: @Self, mid: USize, right_count: USize)
        stop : USize = index.add(1)
        done : Bool  = i.lt(stop)
        branch done
            ? install(left, right, mid, right_count)
            : move_child(i, left, right, mid, right_count)

    block move_child(i: USize, left: @Self, right: @Self, mid: USize, right_count: USize)
        child : @Self = self.children.get(i)
        self.children.set(i.add(1), child)
        jump shift_children(i.sub(1), left, right, mid, right_count)

    block install(left: @Self, right: @Self, mid: USize, right_count: USize)
        self.children.set(index.add(1), right)
        left.count.store(mid)
        right.count.store(right_count)
        next_count : USize = self.count.load().add(1)
        next_count.store_into(self.count)
        left.recount()
        right.recount()
        self.recount()
        return(true)

/// Insert variant: an order equal to the rightmost subtree's count means
/// "append at the end of that child", so `remaining == count` keeps us in
/// the current child rather than overflowing into a non-existent next one.
routine SortedListNode<T>.find_child(self: @Self, order: USize, out_local: @USize) -> USize
require T: typename
    block entry()
        jump loop(0, order)

    block loop(i: USize, remaining: USize)
        child    : @Self = self.children.get(i)
        count    : USize = child.subtree_count()
        in_child : Bool  = remaining.le(count)
        branch in_child
            ? found(i, remaining)
            : loop(i.add(1), remaining.sub(count))

    block found(i: USize, remaining: USize)
        out_local.store(remaining)
        return(i)

/// Remove variant: order must address an existing element, so `remaining`
/// must be strictly less than the child's count — at exact subtree
/// boundaries the element belongs to the next sibling, not the trailing
/// position of this one.
routine SortedListNode<T>.find_child_strict(self: @Self, order: USize, out_local: @USize) -> USize
require T: typename
    block entry()
        jump loop(0, order)

    block loop(i: USize, remaining: USize)
        child    : @Self = self.children.get(i)
        count    : USize = child.subtree_count()
        in_child : Bool  = remaining.lt(count)
        branch in_child
            ? found(i, remaining)
            : loop(i.add(1), remaining.sub(count))

    block found(i: USize, remaining: USize)
        out_local.store(remaining)
        return(i)

/// Inserts below a node that isn't full. Returns false when a split fails to
/// allocate; the tree then holds the same elements, some nodes already split.
routine SortedListNode<T>.insert_nonfull(self: @Self, order: USize, value: T,
    alloc: @Allocator) -> Bool
require T: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? insert_leaf()
            : insert_internal()

    block insert_leaf()
        count : USize = self.count.load()
        self.values.shift_right(order, count)
        self.values.set(order, value)
        new_count : USize = count.add(1)
        self.count.store(new_count)
        self.subtree_count.store(new_count)
        return(true)

    block insert_internal()
        claim local_order : @USize <- uninit
        slot            : USize = self.find_child(order, local_order)
        local_order_val : USize = local_order.load()
        child           : @Self = self.children.get(slot)
        child_count     : USize = child.count.load()
        full            : Bool  = child_count.eq(NODE_VALUES)
        branch full
            ? split_then_insert(slot, local_order_val)
            : descend(slot, child, local_order_val)

    block split_then_insert(slot: USize, local_order: USize)
        split : Bool = self.split_child(slot, alloc)
        branch split
            ? continue
            : return(false)
        left       : @Self = self.children.get(slot)
        left_count : USize = left.subtree_count()
        go_right   : Bool  = local_order.gt(left_count)
        branch go_right
            ? descend_right(slot, local_order, left_count)
            : descend_left(slot, local_order)

    block descend_left(slot: USize, local_order: USize)
        child : @Self = self.children.get(slot)
        jump descend(slot, child, local_order)

    block descend_right(slot: USize, local_order: USize, left_count: USize)
        right_slot  : USize = slot.add(1)
        right_order : USize = local_order.sub(left_count)
        child       : @Self = self.children.get(right_slot)
        jump descend(right_slot, child, right_order)

    block descend(slot: USize, child: @Self, local_order: USize)
        inserted : Bool = child.insert_nonfull(local_order, value, alloc)
        branch inserted
            ? continue
            : return(false)
        self.recount()
        return(true)

/// Inserts value before position order. push picks the position, so the order holds. Returns false when the
/// allocator fails, leaving the list with the same elements.
#track_caller
private routine SortedList<T>.insert_at(self: @Self, order: USize, value: T) -> Bool
require T: typename
    block entry()
        count     : USize = self.count.load()
        in_bounds : Bool  = order.le(count)
        branch in_bounds
            ? insert_checked()
            : crash_out_of_bounds()

    block insert_checked()
        alloc : @Allocator         = self.alloc.load()
        root  : @SortedListNode<T> = self.root.load()
        empty : Bool               = root.is_null()
        branch empty
            ? first_root(alloc)
            : insert_root(root, alloc)

    block first_root(alloc: @Allocator)
        root    : @SortedListNode<T> = SortedListNode<T>.construct(true, alloc)
        no_root : Bool               = root.is_null()
        branch no_root
            ? return(false)
            : continue
        root.values.set(0, value)
        root.count.store(1)
        root.subtree_count.store(1)
        self.root.store(root)
        self.count.store(1)
        return(true)

    block insert_root(root: @SortedListNode<T>, alloc: @Allocator)
        root_count : USize = root.count.load()
        full       : Bool  = root_count.eq(NODE_VALUES)
        branch full
            ? split_root(root, alloc)
            : insert_nonfull(root, alloc)

    block split_root(old_root: @SortedListNode<T>, alloc: @Allocator)
        new_root : @SortedListNode<T> = SortedListNode<T>.construct(false, alloc)
        no_root  : Bool               = new_root.is_null()
        branch no_root
            ? return(false)
            : continue
        new_root.children.set(0, old_root)
        new_root.count.store(1)
        split : Bool = new_root.split_child(0, alloc)
        branch split
            ? install_root(new_root, alloc)
            : discard_root(new_root, alloc)

    block install_root(new_root: @SortedListNode<T>, alloc: @Allocator)
        self.root.store(new_root)
        jump insert_nonfull(new_root, alloc)

    block discard_root(new_root: @SortedListNode<T>, alloc: @Allocator)
        new_root.free(alloc)
        return(false)

    block insert_nonfull(root: @SortedListNode<T>, alloc: @Allocator)
        inserted : Bool = root.insert_nonfull(order, value, alloc)
        branch inserted
            ? continue
            : return(false)
        next_count : USize = self.count.load().add(1)
        next_count.store_into(self.count)
        return(true)

// Capacity = NODE_VALUES, t = NODE_MIN. Internal-node `count` is the
// child count, so the underflow threshold (count < NODE_MIN) is shared
// with leaves. Helpers below ensure a child has count >= NODE_MIN before
// any deletion descent.

/// Moves the last value (leaf) or last child (internal node) of child `i - 1` to the front of child `i`, so child `i` gains one. Subtree counts are updated.
/// :param i: The index of the child that is short.
routine SortedListNode<T>.borrow_from_left(self: @Self, i: USize) -> Void
require T: typename
    block entry()
        left        : @Self = self.children.get(i.sub(1))
        child       : @Self = self.children.get(i)
        left_count  : USize = left.count.load()
        child_count : USize = child.count.load()
        leaf        : Bool  = child.leaf.load()
        branch leaf
            ? leaf_borrow(left, child, left_count, child_count)
            : internal_borrow(left, child, left_count, child_count)

    block leaf_borrow(left: @Self, child: @Self, left_count: USize, child_count: USize)
        child.values.shift_right(0, child_count)
        v : T = left.values.get(left_count.sub(1))
        child.values.set(0, v)
        jump finalize(left, child, left_count, child_count)

    block internal_borrow(left: @Self, child: @Self, left_count: USize, child_count: USize)
        child.children.shift_right(0, child_count)
        moved : @Self = left.children.get(left_count.sub(1))
        child.children.set(0, moved)
        jump finalize(left, child, left_count, child_count)

    block finalize(left: @Self, child: @Self, left_count: USize, child_count: USize)
        left.count.store(left_count.sub(1))
        child.count.store(child_count.add(1))
        left.recount()
        child.recount()
        self.recount()
        return()

/// Moves the first value (leaf) or first child (internal node) of child `i + 1` to the end of child `i`, so child `i` gains one. Subtree counts are updated.
/// :param i: The index of the child that is short.
routine SortedListNode<T>.borrow_from_right(self: @Self, i: USize) -> Void
require T: typename
    block entry()
        child       : @Self = self.children.get(i)
        right       : @Self = self.children.get(i.add(1))
        child_count : USize = child.count.load()
        right_count : USize = right.count.load()
        leaf        : Bool  = child.leaf.load()
        branch leaf
            ? leaf_borrow(child, right, child_count, right_count)
            : internal_borrow(child, right, child_count, right_count)

    block leaf_borrow(child: @Self, right: @Self, child_count: USize, right_count: USize)
        v : T = right.values.get(0)
        child.values.set(child_count, v)
        right.values.shift_left(0, right_count)
        jump finalize(child, right, child_count, right_count)

    block internal_borrow(child: @Self, right: @Self, child_count: USize, right_count: USize)
        moved : @Self = right.children.get(0)
        child.children.set(child_count, moved)
        right.children.shift_left(0, right_count)
        jump finalize(child, right, child_count, right_count)

    block finalize(child: @Self, right: @Self, child_count: USize, right_count: USize)
        child.count.store(child_count.add(1))
        right.count.store(right_count.sub(1))
        child.recount()
        right.recount()
        self.recount()
        return()

/// Merges child `i + 1` into child `i` and frees the emptied node, shrinking this node's child count by one.
/// :param i: The index of the left child of the pair.
/// :param alloc: The allocator that frees the merged node.
routine SortedListNode<T>.merge_children(self: @Self, i: USize, alloc: @Allocator) -> Void
require T: typename
    block entry()
        left        : @Self = self.children.get(i)
        right       : @Self = self.children.get(i.add(1))
        left_count  : USize = left.count.load()
        right_count : USize = right.count.load()
        leaf        : Bool  = left.leaf.load()
        branch leaf
            ? leaf_merge(left, right, left_count, right_count)
            : internal_merge(left, right, left_count, right_count)

    block leaf_merge(left: @Self, right: @Self, left_count: USize, right_count: USize)
        left.values.copy(left_count, right.values, 0, right_count)
        jump finalize(left, right, left_count, right_count)

    block internal_merge(left: @Self, right: @Self, left_count: USize, right_count: USize)
        left.children.copy(left_count, right.children, 0, right_count)
        jump finalize(left, right, left_count, right_count)

    block finalize(left: @Self, right: @Self, left_count: USize, right_count: USize)
        left.count.store(left_count.add(right_count))
        parent_count : USize = self.count.load()
        self.children.shift_left(i.add(1), parent_count)
        self.count.store(parent_count.sub(1))
        right.free(alloc)
        left.recount()
        self.recount()
        return()

/// remove descends with rebalancing inlined: when a borrow or merge fires the
/// local order index has to be adjusted to account for the entries that moved
/// into (or out of) the descent target, so we cannot factor out a generic
/// ensure_min the way the keyed B-tree variants do.
#track_caller
routine SortedListNode<T>.remove(self: @Self, order: USize, alloc: @Allocator) -> T
require T: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? remove_leaf()
            : remove_internal()

    block remove_leaf()
        value : T     = self.values.get(order)
        count : USize = self.count.load()
        self.values.shift_left(order, count)
        new_count : USize = count.sub(1)
        self.count.store(new_count)
        self.subtree_count.store(new_count)
        return(value)

    block remove_internal()
        claim local_order : @USize <- uninit
        slot            : USize = self.find_child_strict(order, local_order)
        local_order_val : USize = local_order.load()
        child           : @Self = self.children.get(slot)
        child_count     : USize = child.count.load()
        ok              : Bool  = child_count.ge(NODE_MIN)
        branch ok
            ? descend(slot, local_order_val)
            : rebalance(slot, local_order_val)

    block descend(slot: USize, local_order: USize)
        child : @Self = self.children.get(slot)
        value : T     = child.remove(local_order, alloc)
        self.recount()
        return(value)

    block rebalance(slot: USize, local_order: USize)
        has_left : Bool = slot.gt(0)
        branch has_left
            ? check_left(slot, local_order)
            : right_only(slot, local_order)

    block check_left(slot: USize, local_order: USize)
        left       : @Self = self.children.get(slot.sub(1))
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN)
        branch left_ok
            ? do_borrow_left(slot, local_order)
            : right_with_left(slot, local_order)

    // Borrow/merge change the descent target's leading subtree_count, so we
    // diff child.subtree_count() across the operation to recover
    // the local-order offset. This works uniformly for leaves (where each
    // moved value contributes 1) and internals (where the moved entry is a
    // whole child subtree of arbitrary count).
    block do_borrow_left(slot: USize, local_order: USize)
        child     : @Self = self.children.get(slot)
        old_count : USize = child.subtree_count()
        self.borrow_from_left(slot)
        new_local : USize = local_order.add(child.subtree_count().sub(old_count))
        jump descend(slot, new_local)

    block right_with_left(slot: USize, local_order: USize)
        parent_count : USize = self.count.load()
        has_right    : Bool  = slot.add(1).lt(parent_count)
        branch has_right
            ? check_right_after_left(slot, local_order)
            : do_merge_left(slot, local_order)

    block check_right_after_left(slot: USize, local_order: USize)
        right       : @Self = self.children.get(slot.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN)
        branch right_ok
            ? do_borrow_right(slot, local_order)
            : do_merge_left(slot, local_order)

    block do_borrow_right(slot: USize, local_order: USize)
        self.borrow_from_right(slot)
        jump descend(slot, local_order)

    block do_merge_left(slot: USize, local_order: USize)
        left_slot : USize = slot.sub(1)
        left      : @Self = self.children.get(left_slot)
        new_local : USize = left.subtree_count().add(local_order)
        self.merge_children(left_slot, alloc)
        jump descend(left_slot, new_local)

    block right_only(slot: USize, local_order: USize)
        parent_count : USize = self.count.load()
        has_right    : Bool  = slot.add(1).lt(parent_count)
        branch has_right
            ? check_right_only(slot, local_order)
            : crash_logic_breached()

    block check_right_only(slot: USize, local_order: USize)
        right       : @Self = self.children.get(slot.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN)
        branch right_ok
            ? do_borrow_right(slot, local_order)
            : do_merge_right(slot, local_order)

    block do_merge_right(slot: USize, local_order: USize)
        self.merge_children(slot, alloc)
        jump descend(slot, local_order)

/// Removes the element at position `order` in sorted order and returns it, shrinking the tree when the root empties.
/// :param order: The zero-based position in sorted order.
/// :returns: The removed element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `order >= count`.
#track_caller
routine SortedList<T>.remove(self: @Self, order: USize) -> T
require T: typename
    block entry()
        count     : USize = self.count.load()
        in_bounds : Bool  = order.lt(count)
        branch in_bounds
            ? remove_root()
            : crash_out_of_bounds()

    block remove_root()
        alloc           : @Allocator         = self.alloc.load()
        root            : @SortedListNode<T> = self.root.load()
        value           : T                  = root.remove(order, alloc)
        remaining_count : USize              = self.count.load().sub(1)
        remaining_count.store_into(self.count)
        leaf : Bool = root.leaf.load()
        branch leaf
            ? maybe_clear(root, value)
            : maybe_shrink(root, value)

    block maybe_clear(root: @SortedListNode<T>, value: T)
        root_count : USize = root.count.load()
        empty      : Bool  = root_count.eq(0)
        branch empty
            ? clear_root(root, value)
            : return(value)

    block maybe_shrink(root: @SortedListNode<T>, value: T)
        root_count : USize = root.count.load()
        only_one   : Bool  = root_count.eq(1)
        branch only_one
            ? shrink(root, value)
            : return(value)

    block clear_root(root: @SortedListNode<T>, value: T)
        alloc : @Allocator = self.alloc.load()
        root.free(alloc)
        self.root.store(null)
        return(value)

    block shrink(root: @SortedListNode<T>, value: T)
        alloc    : @Allocator         = self.alloc.load()
        new_root : @SortedListNode<T> = root.children.get(0)
        root.free(alloc)
        self.root.store(new_root)
        return(value)

/// Internal nodes use `count` as the child count (indices 0..count-1).
routine SortedListNode<T>.free_recursive(self: @Self, alloc: @Allocator) -> Void
require T: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? free_self()
            : free_children()

    block free_children()
        count : USize = self.count.load()
        jump child_loop(0, count)

    block child_loop(i: USize, count: USize)
        done : Bool = i.ge(count)
        branch done
            ? free_self()
            : free_child(i, count)

    block free_child(i: USize, count: USize)
        child : @Self = self.children.get(i)
        child.free_recursive(alloc)
        jump child_loop(i.add(1), count)

    block free_self()
        self.free(alloc)
        return()

/// Frees every node of the tree through the allocator and resets the list to empty. The stored values themselves are not destructed.
routine SortedList<T>.destruct(self: @Self) -> Void
require T: typename
    block entry()
        root  : @SortedListNode<T> = self.root.load()
        empty : Bool               = root.is_null()
        branch empty
            ? reset()
            : free_root(root)

    block free_root(root: @SortedListNode<T>)
        alloc : @Allocator = self.alloc.load()
        root.free_recursive(alloc)
        jump reset()

    block reset()
        self.root.store(null)
        self.count.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine SortedList<T>.destruct_all(self: @Self) -> Void
require T: typename, Destruct<T>
    block entry()
        iter_val : SortedListIter<T> = .construct(self)
        claim iter : @SortedListIter<T> <- iter_val
        claim slot : @T                 <- uninit
        jump next(iter, slot)

    block next(iter: @SortedListIter<T>, slot: @T)
        item : Option<T> = iter.next()
        when item
            .Present(value) -> element(iter, slot, value)
            .Absent         -> finish()

    block element(iter: @SortedListIter<T>, slot: @T, value: T)
        slot.store(value)
        slot.destruct()
        jump next(iter, slot)

    block finish()
        self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements in sorted order, each diagnosed (strings quoted): [1, 2, 3].
routine SortedList<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Compare<T>, Diagnose<T>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : SortedListIter<T> = .construct(whole)
        claim iter : @SortedListIter<T> <- iter_val
        diagnose_items<T, SortedListIter<T>, W>(out, iter, "[", "]")
        return()

/// The elements in sorted order, each diagnosed: [1, 2, 3].
routine SortedList<T>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, Compare<T>, Diagnose<T>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : SortedListIter<T> = .construct(whole)
        claim iter : @SortedListIter<T> <- iter_val
        diagnose_items<T, SortedListIter<T>, W>(out, iter, "[", "]")
        return()
