// Tessera stdlib collection: SortedList[T]
//
// A sorted sequence that keeps duplicates: push puts a value after every equal
// one, so equal values stay in the order they came. getitem(order) and
// remove(order) work by position in that order, and rank finds where a value goes.
//
// The elements live in a B-tree keyed by position, with a fixed node value
// capacity of NODE_VALUES. Nodes store arrays inline. The allocator is stored
// in SortedList. Node helpers still receive it as a parameter. Internal nodes
// use `count` as the child count (no separator keys: navigation is purely by
// subtree_count). Leaf nodes use `count` as the value count. push finds its
// position by binary search over getitem, so it costs O(log² n).

module Standard/Collections

import Standard/Alloc
import Standard/Format

private preset NODE_VALUES: USize = 7
private preset NODE_CHILDREN: USize = NODE_VALUES.add(1)
private preset NODE_MIN: USize = NODE_VALUES.add(1).div(2)

/// One node of a {SortedList[T]} B-tree: up to `NODE_VALUES` values inline, and for internal nodes the child pointers. An internal node keeps no separator values, and its `count` is its child count. A leaf's `count` is its value count. `subtree_count` is the total values below the node.
/// :typeparam T: The element type.
record SortedListNode[T]
needs T: typename
    leaf: Bool
    count: USize
    subtree_count: USize
    values: Array[T, NODE_VALUES]
    children: Array[@SortedListNode[T], NODE_CHILDREN]

/// A sorted sequence that keeps duplicates, stored as a B-tree indexed by position. `add` places a value after every equal one, so equal values stay in arrival order. `getitem` and `remove` work by position, and `rank` finds where a value belongs.
/// :typeparam T: The element type, ordered by its `Comparable` conformance.
record SortedList[T]
obeys Destructible[SortedList[T]]
obeys Representable[SortedList[T]] when T: typename, Diagnosable[T]
obeys Diagnosable[SortedList[T]] when T: typename, Diagnosable[T]
obeys Equatable[SortedList[T]] when T: typename, Equatable[T]
needs T: typename, Comparable[T]
    root: @SortedListNode[T]
    count: USize
    alloc: @MemoryManager

/// Releases nothing: a `SortedListNode` holds no memory of its own.
routine SortedListNode[T].destruct(me: @Me) -> Void
needs T: typename
    return

/// Creates an empty SortedList that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the list stores and later frees its memory with.
/// :returns: A new empty SortedList.
routine SortedList[T].construct(alloc: @MemoryManager) -> Me
needs T: typename
    list: Me = Me(root: null, count: 0, alloc: alloc)
    return list

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine SortedList[T].count(me: Me) -> USize
needs T: typename
    count: USize = me.count
    return count

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine SortedList[T].count(me: @Me) -> USize
needs T: typename
    result: USize = me.peek().count()
    return result

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine SortedList[T].is_empty(me: Me) -> Bool
needs T: typename
    count: USize = me.count
    return count == 0

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine SortedList[T].is_empty(me: @Me) -> Bool
needs T: typename
    return me.peek().is_empty()

/// A new empty node from `alloc`.
/// :param leaf: Whether the node is a leaf.
/// :param alloc: The allocator to take the node from.
/// :returns: The node, or null when the allocator fails.
routine SortedListNode[T].construct(leaf: Bool, alloc: @MemoryManager) -> @Me
needs T: typename
    local node: @Me = allocate[Me](count: 1, alloc)

    if node.is_null()
        return node
    else
        node.leaf.poke(leaf)
        node.count.poke(0)
        node.subtree_count.poke(0)
        return node

/// The number of values in the subtree below this node.
/// :returns: The node's subtree count, or `0` for a null node.
routine SortedListNode[T].subtree_count(me: @Me) -> USize
needs T: typename
    if me.is_null()
        return 0
    else
        count: USize = me.subtree_count.peek()
        return count

/// Recomputes this node's subtree count from its own values or from its children's counts. Call it after the node's contents change.
routine SortedListNode[T].recount(me: @Me) -> Void
needs T: typename
    local leaf: Bool = me.leaf.peek()
    local count: USize = me.count.peek()
    local sum: @USize <- .hollow()

    if leaf
        me.subtree_count.poke(count)
        return
    else
        0.poke_into(sum)

        each i in 0 til count
            child: @Me = me.children[i]
            child_count: USize = child.subtree_count()
            (sum.peek() + child_count).poke_into(sum)
        me.subtree_count.poke(sum.peek())
        return

/// Whether two sorted lists hold equal elements in the same sorted order.
/// :param other: The list to compare with.
/// :returns: `true` when the counts match and every element pair is equal.
routine SortedList[T].eq(me: Me, other: Me) -> Bool
needs T: typename, Equatable[T]
    local a: @Me <- me
    local b: @Me <- other
    return a.eq_at(b)

/// `eq`, through pointers to the two lists.
/// :param other: The list to compare with.
/// :returns: True when the counts match and every element pair is equal.
private routine SortedList[T].eq_at(me: @Me, other: @Me) -> Bool
needs T: typename, Equatable[T]
    local a: @SortedListIter[T] <- .hollow()
    local b: @SortedListIter[T] <- .hollow()

    la: USize = me.count.peek()
    lb: USize = other.count.peek()
    if not (la == lb)
        return false
    a_val: SortedListIter[T] = .construct(me)
    b_val: SortedListIter[T] = .construct(other)
    a.poke(a_val)
    b.poke(b_val)

    // both have the same count, so both run out together
    while true
        x: Maybe[T] = a.emit_checked()
        y: Maybe[T] = b.emit_checked()
        when x
            is T as x_item =>
                y2: T = y.unwrap()
                if x_item == y2
                    continue
                else
                    return false
            is Unit => return true

/// Reads the element at position `order` in sorted order, where `0` is the smallest.
/// :param order: The zero-based position in sorted order.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `order >= count`. See {SortedList[T].getitem_checked}.
@track_caller
routine SortedList[T].getitem(me: Me, order: USize) -> T
needs T: typename
    found: Maybe[T] = me.getitem_checked(order)
    when found
        is T as value => return value
        is Unit => crash_out_of_bounds()

/// Reads the element at position `order` in sorted order, where `0` is the smallest.
/// :param order: The zero-based position in sorted order.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `order >= count`. See {SortedList[T].getitem_checked}.
@track_caller
routine SortedList[T].getitem(me: @Me, order: USize) -> T
needs T: typename
    result: T = me.peek()[order]
    return result

/// `getitem`, returning Unit instead of crashing on a position past the end.
/// :param order: The zero-based position in sorted order.
/// :returns: A copy of the element.
/// :absent: When `order >= count`.
routine SortedList[T].getitem_checked(me: Me, order: USize) -> Maybe[T]
needs T: typename
    count: USize = me.count
    if order < count
        remaining: USize = order

        until node.leaf.peek() with node: @SortedListNode[T] = me.root
            until remaining2 < node.children[i].subtree_count() with remaining2: USize = remaining, i: USize = 0
                continue with remaining2: remaining2 - child_count, i: i + 1
            then
                continue with node: child
        then
            value: T = node.values[remaining]
            return value
    else
        return Unit()

/// `getitem`, returning Unit instead of crashing on a position past the end.
/// :param order: The zero-based position in sorted order.
/// :returns: A copy of the element.
/// :absent: When `order >= count`.
routine SortedList[T].getitem_checked(me: @Me, order: USize) -> Maybe[T]
needs T: typename
    result: Maybe[T] = me.peek().getitem_checked(order)
    return result

/// The element at `rank`, the same as getitem: a SortedList's rank is its position in sorted order.
/// :param rank: The zero-based rank.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedList[T].get_by_rank(me: Me, rank: USize) -> T
needs T: typename
    return me[rank]

/// The element at `rank`, the same as getitem: a SortedList's rank is its position in sorted order.
/// :param rank: The zero-based rank.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedList[T].get_by_rank(me: @Me, rank: USize) -> T
needs T: typename
    result: T = me.peek().get_by_rank(rank)
    return result

/// Puts `value` in sorted order, after every element equal to it.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when a node cannot be allocated. See {SortedList[T].add_result}
///     for a recoverable form.
@track_caller
@reshaping
routine SortedList[T].add(me: @Me, value: T) -> Void
needs T: typename
    pushed: Result[Unit, AllocFailed] = me.add_result(value)
    when pushed
        is Unit => return
        is AllocFailed => crash_allocation()

/// `add`, returning an error instead of crashing when the allocator fails.
/// :param value: The element to add.
/// :returns: A value once the element is in the list.
/// :throws: Returns `AllocFailed` when a node cannot be allocated.
@reshaping
routine SortedList[T].add_result(me: @Me, value: T) -> Result[Unit, AllocFailed]
needs T: typename
    order: USize = me.peek().bound(value, or_equal: true)
    if me.insert_at(order, value)
        return Unit()
    else
        return AllocFailed()

/// The number of elements less than `value`: the position of its first copy if it's there, and where push would put
/// it if not.
/// :param value: The value to rank.
/// :returns: The count of smaller elements.
routine SortedList[T].rank(me: Me, value: T) -> USize
needs T: typename
    rank: USize = me.bound(value, or_equal: false)
    return rank

/// The number of elements less than `value`: the position of its first copy if it's there, and where push would put
/// it if not.
/// :param value: The value to rank.
/// :returns: The count of smaller elements.
routine SortedList[T].rank(me: @Me, value: T) -> USize
needs T: typename
    result: USize = me.peek().rank(value)
    return result

/// Whether an element equal to `value` is in the list.
/// :param value: The value to look for.
/// :returns: `true` when an equal element is present.
routine SortedList[T].has(me: Me, value: T) -> Bool
needs T: typename
    local rank: USize = me.rank(value)

    count: USize = me.count
    if rank < count
        at: T = me[rank]
        return at.compare(value) == 0
    else
        return false

/// Whether `value` is not there: the opposite of `has`.
/// :param value: The value to look for.
/// :returns: `true` when `has` would be `false`.
routine SortedList[T].lacks(me: Me, value: T) -> Bool
needs T: typename
    there: Bool = me.has(value)
    return not there

/// Whether an element equal to `value` is in the list.
/// :param value: The value to look for.
/// :returns: `true` when an equal element is present.
routine SortedList[T].has(me: @Me, value: T) -> Bool
needs T: typename
    return me.peek().has(value)

/// Whether `value` is not there: the opposite of `has`.
/// :param value: The value to look for.
/// :returns: `true` when `has` would be `false`.
routine SortedList[T].lacks(me: @Me, value: T) -> Bool
needs T: typename
    there: Bool = me.has(value)
    return not there

/// The number of elements less than `value`, or with `or_equal`, less than or equal to it. Binary search over
/// getitem.
/// :param value: The value to compare against.
/// :param or_equal: Whether elements equal to `value` count too.
/// :returns: The count.
private routine SortedList[T].bound(me: Me, value: T, or_equal: Bool) -> USize
needs T: typename
    while lo < hi with lo: USize = 0, hi: USize = me.count
        mid: USize = lo + (hi - lo) / 2
        at: T = me[mid]
        order: S32 = at.compare(value)
        below: Bool = order < 0
        equal: Bool = order == 0 and or_equal
        if below or equal
            continue with lo: mid + 1, hi: hi
        else
            continue with lo: lo, hi: mid
    then
        return lo

/// Splits the full child at `index` around its middle: its upper half moves into a new right sibling placed after
/// it.
/// :param index: The index of the full child.
/// :param alloc: The allocator for the new node.
/// :returns: True when it split, false when the allocator failed (before anything moved).
@reshaping
routine SortedListNode[T].split_child(me: @Me, index: USize, alloc: @MemoryManager) -> Bool
needs T: typename
    local left: @Me = me.children[index]
    local leaf: Bool = left.leaf.peek()
    local right: @Me = Me.construct(leaf, alloc)

    if right.is_null()
        return false
    count: USize = left.count.peek()
    mid: USize = count / 2
    right_count: USize = count - mid
    if leaf
        right.values.copy(dst_start: 0, src: left.values, src_start: mid, count: right_count)

        until i < index + 1 with i: USize = me.count.peek()
            child: @Me = me.children[i]
            me.children[i + 1] = child
            continue with i: i - 1
        then
            me.children[index + 1] = right
            left.count.poke(mid)
            right.count.poke(right_count)
            next_count: USize = me.count.peek() + 1
            next_count.poke_into(me.count)
            left.recount()
            right.recount()
            me.recount()
            return true
    else
        each i in 0 til right_count
            src: USize = mid + i
            child: @Me = left.children[src]
            right.children[i] = child
        then
            until i2 < index + 1 with i2: USize = me.count.peek()
                child: @Me = me.children[i2]
                me.children[i2 + 1] = child
                continue with i2: i2 - 1
            then
                me.children[index + 1] = right
                left.count.poke(mid)
                right.count.poke(right_count)
                next_count: USize = me.count.peek() + 1
                next_count.poke_into(me.count)
                left.recount()
                right.recount()
                me.recount()
                return true

/// The child that position `order` falls in, for an insert: an order equal to a child's subtree count stays in that
/// child (appending at its end) rather than moving on to a next child that may not exist.
/// :param order: The position within this node's subtree.
/// :param out_local: Receives the position within the chosen child.
/// :returns: The child's index.
routine SortedListNode[T].find_child(me: @Me, order: USize, out_local: @USize) -> USize
needs T: typename
    until remaining <= me.children[i].subtree_count() with i: USize = 0, remaining: USize = order
        continue with i: i + 1, remaining: remaining - count
    then
        out_local.poke(remaining)
        return i

/// The child holding the element at position `order`, for a remove: the position must address an existing element,
/// so at a subtree boundary the element belongs to the next child.
/// :param order: The position within this node's subtree.
/// :param out_local: Receives the position within the chosen child.
/// :returns: The child's index.
routine SortedListNode[T].find_child_strict(me: @Me, order: USize, out_local: @USize) -> USize
needs T: typename
    until remaining < me.children[i].subtree_count() with i: USize = 0, remaining: USize = order
        continue with i: i + 1, remaining: remaining - count
    then
        out_local.poke(remaining)
        return i

/// Inserts `value` at position `order` below a node that isn't full, splitting full children on the way down.
/// :param order: The position within this node's subtree to insert before.
/// :param value: The element to insert.
/// :param alloc: The allocator for nodes made by splits.
/// :returns: True when it inserted, false when a split failed to allocate. The tree then holds the same elements,
///     some nodes already split.
@reshaping
routine SortedListNode[T].insert_nonfull(me: @Me, order: USize, value: T,
    alloc: @MemoryManager) -> Bool
needs T: typename
    leaf: Bool = me.leaf.peek()
    values2: (USize, @Me, USize) = when
        leaf =>
            count: USize = me.count.peek()
            me.values.shift_right(start: order, end: count)
            me.values[order] = value
            new_count: USize = count + 1
            me.count.poke(new_count)
            me.subtree_count.poke(new_count)
            return true
        else =>
            local local_order: @USize <- .hollow()
            slot: USize = me.find_child(order, out_local: local_order)
            local_order_val: USize = local_order.peek()
            child: @Me = me.children[slot]
            child_count: USize = child.count.peek()
            if child_count == NODE_VALUES
                if not me.split_child(index: slot, alloc)
                    return false
                left: @Me = me.children[slot]
                left_count: USize = left.subtree_count()
                if local_order_val > left_count
                    right_slot: USize = slot + 1
                    right_order: USize = local_order_val - left_count
                    becomes (right_slot, me.children[right_slot], right_order)
                else
                    becomes (slot, me.children[slot], local_order_val)
            else
                becomes (slot, child, local_order_val)
    slot, child, local_order = values2
    if not child.insert_nonfull(order: local_order, value, alloc)
        return false
    me.recount()
    return true

/// Inserts `value` before position `order`. push picks the position, so the order holds.
/// :param order: The position to insert before, at most the count.
/// :param value: The element to insert.
/// :returns: True when it inserted, false when the allocator failed (the list keeps the same elements).
/// :throws: Crashes with `IndexOutOfBoundsError` when `order > count`.
@track_caller
@reshaping
private routine SortedList[T].insert_at(me: @Me, order: USize, value: T) -> Bool
needs T: typename
    count: USize = me.count.peek()
    in_bounds: Bool = order <= count
    values2: (@SortedListNode[T], @MemoryManager) = when
        in_bounds =>
            alloc: @MemoryManager = me.alloc.peek()
            root: @SortedListNode[T] = me.root.peek()
            if root.is_null()
                root2: @SortedListNode[T] = SortedListNode[T].construct(leaf: true, alloc)
                if root2.is_null()
                    return false
                root2.values[0] = value
                root2.count.poke(1)
                root2.subtree_count.poke(1)
                me.root.poke(root2)
                me.count.poke(1)
                return true
            else
                root_count: USize = root.count.peek()
                if root_count == NODE_VALUES
                    new_root: @SortedListNode[T] = SortedListNode[T].construct(leaf: false, alloc)
                    if new_root.is_null()
                        return false
                    new_root.children[0] = root
                    new_root.count.poke(1)
                    if new_root.split_child(index: 0, alloc)
                        me.root.poke(new_root)
                        becomes (new_root, alloc)
                    else
                        deallocate[SortedListNode[T]](data: new_root, alloc)
                        return false
                else
                    becomes (root, alloc)
        else => crash_out_of_bounds()
    root, alloc = values2
    if not root.insert_nonfull(order, value, alloc)
        return false
    next_count: USize = me.count.peek() + 1
    next_count.poke_into(me.count)
    return true

// Capacity = NODE_VALUES, t = NODE_MIN. Internal-node `count` is the
// child count, so the underflow threshold (count < NODE_MIN) is shared
// with leaves. Helpers below ensure a child has count >= NODE_MIN before
// any deletion descent.

/// Moves the last value (leaf) or last child (internal node) of child `i - 1` to the front of child `i`, so child `i` gains one. Subtree counts are updated.
/// :param i: The index of the child that is short.
routine SortedListNode[T].borrow_from_left(me: @Me, i: USize) -> Void
needs T: typename
    local left: @Me = me.children[i - 1]
    local child: @Me = me.children[i]
    local left_count: USize = left.count.peek()
    local child_count: USize = child.count.peek()

    if child.leaf.peek()
        child.values.shift_right(start: 0, end: child_count)
        v: T = left.values[left_count - 1]
        child.values[0] = v
    else
        child.children.shift_right(start: 0, end: child_count)
        moved: @Me = left.children[left_count - 1]
        child.children[0] = moved
    left.count.poke(left_count - 1)
    child.count.poke(child_count + 1)
    left.recount()
    child.recount()
    me.recount()
    return

/// Moves the first value (leaf) or first child (internal node) of child `i + 1` to the end of child `i`, so child `i` gains one. Subtree counts are updated.
/// :param i: The index of the child that is short.
routine SortedListNode[T].borrow_from_right(me: @Me, i: USize) -> Void
needs T: typename
    local child: @Me = me.children[i]
    local right: @Me = me.children[i + 1]
    local child_count: USize = child.count.peek()
    local right_count: USize = right.count.peek()

    if child.leaf.peek()
        v: T = right.values[0]
        child.values[child_count] = v
        right.values.shift_left(start: 0, end: right_count)
    else
        moved: @Me = right.children[0]
        child.children[child_count] = moved
        right.children.shift_left(start: 0, end: right_count)
    child.count.poke(child_count + 1)
    right.count.poke(right_count - 1)
    child.recount()
    right.recount()
    me.recount()
    return

/// Merges child `i + 1` into child `i` and frees the emptied node, shrinking this node's child count by one.
/// :param i: The index of the left child of the pair.
/// :param alloc: The allocator that frees the merged node.
routine SortedListNode[T].merge_children(me: @Me, i: USize, alloc: @MemoryManager) -> Void
needs T: typename
    local left: @Me = me.children[i]
    local right: @Me = me.children[i + 1]
    local left_count: USize = left.count.peek()
    local right_count: USize = right.count.peek()

    if left.leaf.peek()
        left.values.copy(dst_start: left_count, src: right.values, src_start: 0, count: right_count)
    else
        left.children.copy(dst_start: left_count, src: right.children, src_start: 0, count: right_count)
    left.count.poke(left_count + right_count)
    parent_count: USize = me.count.peek()
    me.children.shift_left(start: i + 1, end: parent_count)
    me.count.poke(parent_count - 1)
    deallocate[Me](data: right, alloc)
    left.recount()
    me.recount()
    return

/// Removes the element at position `order` of this node's subtree and returns it, borrowing from or merging with a
/// sibling first whenever the child it descends into has too few elements.
/// :param order: The element's position within this node's subtree.
/// :param alloc: The allocator to free merged nodes through.
/// :returns: The removed element.
/// :note: The rebalancing is inlined: after a borrow or merge the local order has to be adjusted for the entries
///     that moved into or out of the child, so no generic ensure_min is factored out the way the keyed B-trees do.
@track_caller
routine SortedListNode[T].remove(me: @Me, order: USize, alloc: @MemoryManager) -> T
needs T: typename
    leaf: Bool = me.leaf.peek()
    values2: (USize, USize) = when
        leaf =>
            value: T = me.values[order]
            count: USize = me.count.peek()
            me.values.shift_left(start: order, end: count)
            new_count: USize = count - 1
            me.count.poke(new_count)
            me.subtree_count.poke(new_count)
            return value
        else =>
            local local_order: @USize <- .hollow()
            slot: USize = me.find_child_strict(order, out_local: local_order)
            local_order_val: USize = local_order.peek()
            child: @Me = me.children[slot]
            child_count: USize = child.count.peek()
            if child_count >= NODE_MIN
                child2: @Me = me.children[slot]
                value: T = child2.remove(order: local_order_val, alloc)
                me.recount()
                return value
            else
                if slot > 0
                    left: @Me = me.children[slot - 1]
                    left_count: USize = left.count.peek()
                    if left_count >= NODE_MIN
                        // Borrow/merge change the descent target's leading subtree_count, so we
                        // diff child.subtree_count() across the operation to recover
                        // the local-order offset. This works uniformly for leaves (where each
                        // moved value contributes 1) and internals (where the moved entry is a
                        // whole child subtree of arbitrary count).
                        child2: @Me = me.children[slot]
                        old_count: USize = child2.subtree_count()
                        me.borrow_from_left(slot)

                        local_order2: USize = local_order_val + (child2.subtree_count() - old_count)
                        child3: @Me = me.children[slot]
                        value: T = child3.remove(order: local_order2, alloc)
                        me.recount()
                        return value
                    else
                        parent_count: USize = me.count.peek()
                        if slot + 1 < parent_count
                            right: @Me = me.children[slot + 1]
                            right_count: USize = right.count.peek()
                            if right_count >= NODE_MIN
                                me.borrow_from_right(slot)
                                child2: @Me = me.children[slot]
                                value: T = child2.remove(order: local_order_val, alloc)
                                me.recount()
                                return value
                    left_slot: USize = slot - 1
                    left2: @Me = me.children[left_slot]
                    new_local: USize = left2.subtree_count() + local_order
                    me.merge_children(i: left_slot, alloc)
                    child2: @Me = me.children[left_slot]
                    value: T = child2.remove(order: new_local, alloc)
                    me.recount()
                    return value
                else
                    parent_count: USize = me.count.peek()
                    if slot + 1 < parent_count
                        right: @Me = me.children[slot + 1]
                        right_count: USize = right.count.peek()
                        if not (right_count >= NODE_MIN)
                            me.merge_children(i: slot, alloc)
                            child2: @Me = me.children[slot]
                            value: T = child2.remove(order: local_order_val, alloc)
                            me.recount()
                            return value
                    else
                        crash_logic_breached()
                me.borrow_from_right(slot)
                child2: @Me = me.children[slot]
                value: T = child2.remove(order: local_order, alloc)
                me.recount()
                return value
            left_slot: USize = slot - 1
            left: @Me = me.children[left_slot]
            new_local: USize = left.subtree_count() + local_order
            me.merge_children(i: left_slot, alloc)
            child2: @Me = me.children[left_slot]
            value: T = child2.remove(order: new_local, alloc)
            me.recount()
            return value
    slot, local_order = values2
    me.borrow_from_right(slot)
    child: @Me = me.children[slot]
    value: T = child.remove(order: local_order, alloc)
    me.recount()
    return value

    block descend(slot: USize, local_order: USize)
        child: @Me = me.children[slot]
        value: T = child.remove(order: local_order, alloc)
        me.recount()
        return value

/// Removes the element at position `order` in sorted order and returns it, shrinking the tree when the root empties.
/// :param order: The zero-based position in sorted order.
/// :returns: The removed element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `order >= count`.
@track_caller
routine SortedList[T].remove(me: @Me, order: USize) -> T
needs T: typename
    count: USize = me.count.peek()
    if order < count
        alloc: @MemoryManager = me.alloc.peek()
        root: @SortedListNode[T] = me.root.peek()
        value: T = root.remove(order, alloc)
        remaining_count: USize = me.count.peek() - 1
        remaining_count.poke_into(me.count)
        if root.leaf.peek()
            root_count: USize = root.count.peek()
            if root_count == 0
                alloc2: @MemoryManager = me.alloc.peek()
                deallocate[SortedListNode[T]](data: root, alloc: alloc2)
                me.root.poke(null)
                return value
            else
                return value
        else
            root_count: USize = root.count.peek()
            if root_count == 1
                alloc2: @MemoryManager = me.alloc.peek()
                new_root: @SortedListNode[T] = root.children[0]
                deallocate[SortedListNode[T]](data: root, alloc: alloc2)
                me.root.poke(new_root)
                return value
            else
                return value
    else
        crash_out_of_bounds()

/// Frees this node and every node below it through `alloc`. An internal node uses `count` as its child count. The
/// values are not destructed.
/// :param alloc: The allocator the nodes came from.
routine SortedListNode[T].free_recursive(me: @Me, alloc: @MemoryManager) -> Void
needs T: typename
    if me.leaf.peek()
        deallocate[Me](data: me, alloc)
        return
    else
        count: USize = me.count.peek()

        each i in 0 til count
            child: @Me = me.children[i]
            child.free_recursive(alloc)
        then
            deallocate[Me](data: me, alloc)
            return

/// Frees every node of the tree through the allocator and resets the list to empty. The stored values themselves are not destructed.
@track_caller
routine SortedList[T].destruct(me: @Me) -> Void
needs T: typename
    local root: @SortedListNode[T] = me.root.peek()

    if not root.is_null()
        alloc: @MemoryManager = me.alloc.peek()
        root.free_recursive(alloc)
    me.root.poke(null)
    me.count.poke(0)
    return

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
@track_caller
routine SortedList[T].destruct_all(me: @Me) -> Void
needs T: typename, Destructible[T]
    local iter_val: SortedListIter[T] = .construct(me)
    local iter: @SortedListIter[T] <- iter_val
    local slot: @T <- .hollow()

    while true
        item: Maybe[T] = iter.emit_checked()
        when item
            is T as value =>
                slot.poke(value)
                slot.destruct()
                continue
            is Unit => break
    me.destruct()
    return

// -- text -----------------------------------------------------------------------

/// The elements in sorted order, each diagnosed (strings quoted): [1, 2, 3].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine SortedList[T].represent_into[TWriter](me: Me, out: @TWriter) -> Void
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    local whole: @Me <- me
    iter_val: SortedListIter[T] = .construct(whole)
    local iter: @SortedListIter[T] <- iter_val
    diagnose_items[T, SortedListIter[T], TWriter](out, iter, open: "[", close: "]")
    return

/// The elements in sorted order, each diagnosed: [1, 2, 3].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine SortedList[T].diagnose_into[TWriter](me: Me, out: @TWriter) -> Void
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    local whole: @Me <- me
    iter_val: SortedListIter[T] = .construct(whole)
    local iter: @SortedListIter[T] <- iter_val
    diagnose_items[T, SortedListIter[T], TWriter](out, iter, open: "[", close: "]")
    return
