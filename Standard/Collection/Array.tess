// Tessera stdlib collection: Array<T, N> — fixed-size inline array
//
// Maps to LLVM IR [N x T].  Stored entirely inline — no heap allocation,
// no pointer indirection.  N is a buildtime constant USize.
//
// The helpers below also operate on Array<T, N> fields inside larger
// structures. The range convention is half-open: [start, end).

module Standard::Core

/// A fixed-size array stored inline as the LLVM type `[N x T]`: no heap allocation and no pointer indirection. `N` is a buildtime constant and every index is bounds-checked.
/// :typeparam T: The element type.
/// :typeparam N: The number of elements, fixed at build time.
#llvm("[{N} x {T}]")
record Array<T, N>
conform Equal<Array<T, N>> when T: typename, N: USize, Equal<T>
require T: typename, N: USize

// -- metadata ------------------------------------------------------------------

/// The number of elements, which is the buildtime constant `N`.
/// :returns: `N`.
routine Array<T, N>.count() -> USize
require T: typename, N: USize
    block entry()
        return(N)

// -- construction --------------------------------------------------------------

// `Array<T, N> { a, b, ... }` makes an array value from a literal, built into the builder like a record literal.

/// Reads the N values at first into an array value. first must point at N initialized Ts.
routine Array<T, N>.from_ptr(first: @T) -> Self
require T: typename, N: USize
    block entry()
        whole : @Self = first.to<@Self>()
        value : Self  = whole.load()
        return(value)

// -- element access ------------------------------------------------------------

/// Reads the element at `index`.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element at `index`.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= N`.
#track_caller
routine Array<T, N>.get(self: @Self, index: USize) -> T
require T: typename, N: USize
    block entry()
        in_bounds : Bool = index.lt(N)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        base  : @T = bitcast<@Self, @T>(self)
        value : T  = base.stride(index).load()
        return(value)

/// Writes `value` into the element at `index`, replacing the old value in place.
/// :param index: The zero-based position to write.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= N`.
#track_caller
routine Array<T, N>.set(self: @Self, index: USize, value: T) -> Void
require T: typename, N: USize
    block entry()
        in_bounds : Bool = index.lt(N)
        branch in_bounds
            ? store()
            : crash_out_of_bounds()

    block store()
        base : @T = bitcast<@Self, @T>(self)
        base.stride(index).store(value)
        return()

/// The address of element index, checked like get: a place to read or write in place (`a.at(i).store(v)`).
#track_caller
routine Array<T, N>.at(self: @Self, index: USize) -> @T
require T: typename, N: USize
    block entry()
        in_bounds : Bool = index.lt(N)
        branch in_bounds
            ? address()
            : crash_out_of_bounds()

    block address()
        base    : @T = bitcast<@Self, @T>(self)
        element : @T = base.stride(index)
        return(element)

// -- equality ------------------------------------------------------------------

/// Whether two arrays are equal: every pair of elements at the same index compares equal.
/// :param other: The array to compare with.
/// :returns: `true` when all `N` element pairs are equal.
routine Array<T, N>.eq(self: Self, other: Self) -> Bool
require T: typename, N: USize, Equal<T>
    block entry()
        claim a : @Self <- self
        claim b : @Self <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// eq, through pointers to the two Arrays.
private routine Array<T, N>.eq_at(self: @Self, other: @Self) -> Bool
require T: typename, N: USize, Equal<T>
    block entry()
        pa : @T = bitcast<@Self, @T>(self)
        pb : @T = bitcast<@Self, @T>(other)
        jump loop(0, pa, pb)

    block loop(i: USize, pa: @T, pb: @T)
        done : Bool = i.ge(N)
        branch done
            ? return(true)
            : step(i, pa, pb)

    block step(i: USize, pa: @T, pb: @T)
        x  : T    = pa.stride(i).load()
        y  : T    = pb.stride(i).load()
        eq : Bool = x.eq(y)
        branch eq
            ? loop(i.add(1), pa, pb)
            : return(false)

// -- pointer to first element --------------------------------------------------

/// Reinterprets the array as a pointer to its first element, so its elements can be walked with `stride`.
/// :returns: A pointer to element `0`, valid as long as the array itself is.
routine Array<T, N>.to<@T>(self: @Self) -> @T
require T: typename, N: USize
    block entry()
        base : @T = bitcast<@Self, @T>(self)
        return(base)

/// Tessera stdlib collection: fixed array helpers
///
/// These helpers operate on Array<T, N> fields inside larger structures. The
/// range convention is half-open: [start, end).
/// Moves elements [start, end) one slot right, to [start + 1, end + 1), opening a hole at start. Writes index end.
routine Array<T, N>.shift_right(self: @Self, start: USize, end: USize) -> Void
require T: typename, N: USize
    block entry()
        jump loop(end)

    block loop(i: USize)
        done : Bool = i.le(start)
        branch done
            ? return()
            : move(i)

    block move(i: USize)
        from  : USize = i.sub(1)
        value : T     = self.get(from)
        self.set(i, value)
        jump loop(from)

/// Closes the hole at start: moves elements [start + 1, end) one slot left, to [start, end - 1).
routine Array<T, N>.shift_left(self: @Self, start: USize, end: USize) -> Void
require T: typename, N: USize
    block entry()
        jump loop(start)

    block loop(i: USize)
        last : USize = end.sub(1)
        done : Bool  = i.ge(last)
        branch done
            ? return()
            : move(i)

    block move(i: USize)
        from  : USize = i.add(1)
        value : T     = self.get(from)
        self.set(i, value)
        jump loop(from)

/// Copies `count` elements from `src` starting at `src_start` into this array starting at `dst_start`, one element at a time from the front.
/// :param dst_start: The first index written in this array.
/// :param src: The array to read from.
/// :param src_start: The first index read in `src`.
/// :param count: The number of elements to copy.
/// :throws: Crashes with `IndexOutOfBoundsError` when either range runs past `N`.
/// :note: Overlapping ranges within one array are only safe when `dst_start` is below `src_start`.
routine Array<T, N>.copy(self: @Self, dst_start: USize, src: @Self, src_start: USize,
    count: USize) -> Void
require T: typename, N: USize
    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? return()
            : copy_one(i)

    block copy_one(i: USize)
        src_index : USize = src_start.add(i)
        dst_index : USize = dst_start.add(i)
        value     : T     = src.get(src_index)
        self.set(dst_index, value)
        jump loop(i.add(1))
