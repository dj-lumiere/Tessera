// Tessera stdlib collection: Array<T, COUNT> — fixed-size inline array
//
// Maps to LLVM IR [N x T].  Stored entirely inline — no heap allocation,
// no pointer indirection.  N is a buildtime constant USize.
//
// The helpers below also operate on Array<T, COUNT> fields inside larger
// structures. The range convention is half-open: [start, end).

module Standard::Core

/// A fixed-size array stored inline as the LLVM type `[COUNT x T]`: no heap allocation and no pointer indirection. `COUNT` is a buildtime constant and every index is bounds-checked.
/// :typeparam T: The element type.
/// :typeparam COUNT: The number of elements, fixed at build time.
#llvm("[{COUNT} x {T}]")
record Array<T, COUNT>
conform Equatable<Array<T, COUNT>> when T: typename, COUNT: USize, Equatable<T>
require T: typename, COUNT: USize

// -- metadata ------------------------------------------------------------------

/// The number of elements, which is the buildtime constant `COUNT`.
/// :returns: `COUNT`.
routine Array<T, COUNT>.count() -> USize
require T: typename, COUNT: USize
    block entry()
        return(COUNT)

// -- construction --------------------------------------------------------------

// `Array<T, COUNT> { a, b, ... }` makes an array value from a literal, built into the builder like a record literal.
// COUNT values already in memory are read through a pointer of the array type: `first.to<@Array<T, COUNT>>().load()`.

// -- element access ------------------------------------------------------------

/// Reads the element at `index`.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element at `index`.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= COUNT`.
#track_caller
routine Array<T, COUNT>.getitem(me: @Me, index: USize) -> T
require T: typename, COUNT: USize
    block entry()
        in_bounds : Bool = index.lt(COUNT)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        base  : @T = bitcast<@Me, @T>(me)
        value : T  = base.stride(index).load()
        return(value)

/// Writes `value` into the element at `index`, replacing the old value in place.
/// :param index: The zero-based position to write.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= COUNT`.
#track_caller
routine Array<T, COUNT>.setitem(me: @Me, index: USize, value: T) -> Void
require T: typename, COUNT: USize
    block entry()
        in_bounds : Bool = index.lt(COUNT)
        branch in_bounds
            ? store()
            : crash_out_of_bounds()

    block store()
        base : @T = bitcast<@Me, @T>(me)
        base.stride(index).store(value)
        return()

/// The address of element index, checked like getitem: a place to read or write in place (`a.at(i).store(v)`).
/// :param index: The element's index.
/// :returns: The element's address.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= COUNT`.
#track_caller
routine Array<T, COUNT>.at(me: @Me, index: USize) -> @T
require T: typename, COUNT: USize
    block entry()
        in_bounds : Bool = index.lt(COUNT)
        branch in_bounds
            ? address()
            : crash_out_of_bounds()

    block address()
        base    : @T = bitcast<@Me, @T>(me)
        element : @T = base.stride(index)
        return(element)

// -- equality ------------------------------------------------------------------

/// Whether two arrays are equal: every pair of elements at the same index compares equal.
/// :param other: The array to compare with.
/// :returns: `true` when all `COUNT` element pairs are equal.
routine Array<T, COUNT>.eq(me: Me, other: Me) -> Bool
require T: typename, COUNT: USize, Equatable<T>
    block entry()
        claim a : @Me <- me
        claim b : @Me <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// `eq`, through pointers to the two arrays.
/// :param other: The array to compare with.
/// :returns: True when all `COUNT` element pairs are equal.
private routine Array<T, COUNT>.eq_at(me: @Me, other: @Me) -> Bool
require T: typename, COUNT: USize, Equatable<T>
    shared pa : @T = bitcast<@Me, @T>(me)
    shared pb : @T = bitcast<@Me, @T>(other)

    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(COUNT)
        branch done
            ? return(true)
            : step(i)

    block step(i: USize)
        x  : T    = pa.stride(i).load()
        y  : T    = pb.stride(i).load()
        eq : Bool = x.eq(y)
        branch eq
            ? loop(i.add(1))
            : return(false)

// -- pointer to first element --------------------------------------------------

/// Reinterprets the array as a pointer to its first element, so its elements can be walked with `stride`.
/// :returns: A pointer to element `0`, valid as long as the array itself is.
routine Array<T, COUNT>.to<@T>(me: @Me) -> @T
require T: typename, COUNT: USize
    block entry()
        base : @T = bitcast<@Me, @T>(me)
        return(base)

// -- releasing elements --------------------------------------------------------

// An array acquires nothing (its elements live inside it), so it has no destruct().

/// Destructs every element: for elements that own something, such as lists. The array itself has nothing to release.
/// Elements that only borrow (a `Ptr` to memory owned elsewhere) must not be destructed this way.
#track_caller
routine Array<T, COUNT>.destruct_all(me: @Me) -> Void
require T: typename, COUNT: USize, Destructible<T>
    shared first : @T = bitcast<@Me, @T>(me)

    block entry()
        jump each(0)

    block each(i: USize)
        done : Bool = i.ge(COUNT)
        branch done
            ? return()
            : continue
        first.stride(i).destruct()
        jump each(i.add(1))

/// Moves elements [`start`, `end`) one slot right, to [`start` + 1, `end` + 1), opening a hole at `start`. Writes
/// index `end`.
/// :param start: The first index to move.
/// :param end: The index past the last one to move.
/// :throws: Crashes with `IndexOutOfBoundsError` when `end >= COUNT` and `end > start`.
routine Array<T, COUNT>.shift_right(me: @Me, start: USize, end: USize) -> Void
require T: typename, COUNT: USize
    block entry()
        jump loop(end)

    block loop(i: USize)
        done : Bool = i.le(start)
        branch done
            ? return()
            : move(i)

    block move(i: USize)
        from  : USize = i.sub(1)
        value : T     = me.getitem(from)
        me.setitem(i, value)
        jump loop(from)

/// Closes the hole at `start`: moves elements [`start` + 1, `end`) one slot left, to [`start`, `end` - 1).
/// :param start: The index of the hole.
/// :param end: The index past the last element to move.
/// :throws: Crashes with `IntegerOverflowError` when `end` is 0, and with `IndexOutOfBoundsError` when `end > COUNT`.
routine Array<T, COUNT>.shift_left(me: @Me, start: USize, end: USize) -> Void
require T: typename, COUNT: USize
    block entry()
        jump loop(start)

    block loop(i: USize)
        last : USize = end.sub(1)
        done : Bool  = i.ge(last)
        branch done
            ? return()
            : move(i)

    block move(i: USize)
        from  : USize = i.add(1)
        value : T     = me.getitem(from)
        me.setitem(i, value)
        jump loop(from)

/// Copies `count` elements from `src` starting at `src_start` into this array starting at `dst_start`, one element at a time from the front.
/// :param dst_start: The first index written in this array.
/// :param src: The array to read from.
/// :param src_start: The first index read in `src`.
/// :param count: The number of elements to copy.
/// :throws: Crashes with `IndexOutOfBoundsError` when either range runs past `COUNT`.
/// :note: Overlapping ranges within one array are only safe when `dst_start` is below `src_start`.
routine Array<T, COUNT>.copy(me: @Me, dst_start: USize, src: @Me, src_start: USize,
    count: USize) -> Void
require T: typename, COUNT: USize
    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? return()
            : copy_one(i)

    block copy_one(i: USize)
        src_index : USize = src_start.add(i)
        dst_index : USize = dst_start.add(i)
        value     : T     = src.getitem(src_index)
        me.setitem(dst_index, value)
        jump loop(i.add(1))
