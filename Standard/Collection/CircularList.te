# Tessera stdlib collection: CircularList[T]
#
# Dynamic array with a centered start index — front and back both grow without
# shifting. The buffer is a Memory[T] whose count is the capacity, and it
# keeps the allocator.
#
# Logical element i lives at storage.data[start + i]. Front growth consumes spare slots
# before start. When either side runs out the live range is moved back to the
# center of a new buffer, twice as large if the circular_list is more than half full.

module Standard/Collections

import Standard/Alloc
import Standard/Format

### A growable sequence with spare room on both sides of its live range, so `add_first` and `add_last` are both amortized constant time without shifting elements. Logical element `i` lives at `storage.data[start + i]`. When either side runs out, the live range is moved to the center of a new buffer.
### :typeparam T: The element type.
entity CircularList[T]
obeys Destructible[CircularList[T]]
obeys Representable[CircularList[T]] when T: typename, Diagnosable[T]
obeys Diagnosable[CircularList[T]] when T: typename, Diagnosable[T]
obeys Equatable[CircularList[T]] when T: typename, Equatable[T]
needs T: typename
    storage: Memory[T]
    start: USize
    count: USize

### Creates an empty CircularList that draws its storage from `alloc`. Nothing is allocated until the first insertion.
### :param alloc: The allocator the list stores and later frees its memory with.
### :returns: A new empty CircularList.
routine CircularList[T].construct(alloc: @MemoryManager) -> Me
needs T: typename
    return Me(storage: Memory[T].construct(count: 0, manager: alloc), start: 0, count: 0)

### The number of elements currently stored.
### :returns: The count of elements, `0` when the list is empty.
routine CircularList[T].count(me: @Me) -> USize
needs T: typename
    count: USize = me.count.peek()
    return count

### Whether the list holds no elements.
### :returns: `true` when the count is `0`.
routine CircularList[T].is_empty(me: @Me) -> Bool
needs T: typename
    count: USize = me.count.peek()
    return count == 0

### Moves the elements into a new buffer of `new_capacity`, centered in it.
### :param new_capacity: The new buffer's capacity, at least the count.
### :returns: True when it moved them, false when the allocator failed (the list is left as it was).
@reshaping
secret routine CircularList[T].recenter(me: @Me, new_capacity: USize) -> Bool
needs T: typename
    local count: USize = me.count.peek()
    local slack: USize = new_capacity - count
    local new_start: USize = slack // 2

    alloc: @MemoryManager = me.storage.manager.peek()
    when Memory[T].construct_result(count: new_capacity, manager: alloc)
        is Memory[T] as fresh =>
            old_data: @T = me.storage.data.peek()
            if not old_data.is_null()
                old_start: USize = me.start.peek()
                src: @T = old_data.stride(old_start)
                dst: @T = fresh.data.peek().stride(new_start)
                src.copy_into(dst, count)
            me.storage.replace(value: steal fresh)
            me.start.poke(new_start)
            return true
        is AllocFailed => return false

### The capacity to recenter into when one end runs out: double it only when the circular_list is more than half full.
### Otherwise the live range just moves back to the middle, so a queue (push_back / pop_front) keeps a bounded buffer
### instead of doubling each time its window drifts to the end.
### :param capacity: The current capacity.
### :returns: Twice `capacity` when the list is more than half full, else `capacity`.
routine CircularList[T].grown_capacity(me: @Me, capacity: USize) -> USize
needs T: typename
    count: USize = me.count.peek()
    crowded: Bool = count * 2 > capacity
    new_capacity: USize = when
        crowded => capacity * 2
        else => capacity
    return new_capacity

### Makes room for one element before the first: when the start is at 0, recenters into a buffer of 4 (none yet) or
### of {CircularList[T].grown_capacity}.
### :returns: True when there is room, false when the allocator failed.
@reshaping
secret routine CircularList[T].ensure_front(me: @Me) -> Bool
needs T: typename
    start: USize = me.start.peek()
    if start > 0
        return true
    else
        capacity: USize = me.storage.count.peek()
        if capacity == 0
            return me.recenter(4)
        else
            return me.recenter(me.grown_capacity(capacity))

### Makes room for one element after the last: when the buffer's end is reached, recenters into a buffer of 4 (none
### yet) or of {CircularList[T].grown_capacity}.
### :returns: True when there is room, false when the allocator failed.
@reshaping
secret routine CircularList[T].ensure_back(me: @Me) -> Bool
needs T: typename
    local start: USize = me.start.peek()
    local count: USize = me.count.peek()
    local capacity: USize = me.storage.count.peek()

    if start + count < capacity
        return true
    else if capacity == 0
        return me.recenter(4)
    else
        return me.recenter(me.grown_capacity(capacity))

### Appends `value` after the last element.
### :param value: The element to add.
### :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList[T].add_last_result} for a recoverable form.
@track_caller
@reshaping
routine CircularList[T].add_last(me: @Me, value: T) -> None
needs T: typename
    when me.add_last_result(steal value)
        is None => return
        is AllocFailed => crash_allocation()

### `add_last`, returning an error instead of crashing when the allocator fails.
### :param value: The element to add.
### :returns: A value once the element is added.
### :throws: Returns `AllocFailed` when the buffer must grow and the allocator fails.
@reshaping
routine CircularList[T].add_last_result(me: @Me, value: T) -> Result[None, AllocFailed]
needs T: typename
    if not me.ensure_back()
        return AllocFailed()
    data: @T = me.storage.data.peek()
    start: USize = me.start.peek()
    count: USize = me.count.peek()
    index: USize = start + count
    data.stride(index).poke(steal value)
    me.count.poke(count + 1)
    return None()

### Prepends `value` before the first element, so it becomes index `0`.
### :param value: The element to add.
### :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList[T].add_first_result} for a recoverable form.
@track_caller
@reshaping
routine CircularList[T].add_first(me: @Me, value: T) -> None
needs T: typename
    when me.add_first_result(steal value)
        is None => return
        is AllocFailed => crash_allocation()

### `add_first`, returning an error instead of crashing when the allocator fails.
### :param value: The element to add.
### :returns: A value once the element is added.
### :throws: Returns `AllocFailed` when the buffer must grow and the allocator fails.
@reshaping
routine CircularList[T].add_first_result(me: @Me, value: T) -> Result[None, AllocFailed]
needs T: typename
    if not me.ensure_front()
        return AllocFailed()
    data: @T = me.storage.data.peek()
    start: USize = me.start.peek()
    new_start: USize = start - 1
    data.stride(new_start).poke(steal value)
    me.start.poke(new_start)
    next_count: USize = me.count.peek() + 1
    next_count.poke_into(me.count)
    return None()

### Removes the last element and returns it.
### :returns: The removed element.
### :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList[T].remove_last_checked}.
@track_caller
routine CircularList[T].remove_last(me: @Me) -> T
needs T: typename
    when me.remove_last_checked()
        is T as value => return value
        is None => crash_absent_value()

### `remove_last`, returning None instead of crashing on an empty list.
### :returns: The removed element.
### :absent: When the list is empty.
routine CircularList[T].remove_last_checked(me: @Me) -> Maybe[T]
needs T: typename
    local count: USize = me.count.peek()

    if count == 0
        return None()
    else
        new_count: USize = count - 1
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        index: USize = start + new_count
        me.count.poke(new_count)
        return steal data.stride(index)

### Removes the first element and returns it. Every remaining element's index drops by one.
### :returns: The removed element.
### :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList[T].remove_first_checked}.
@track_caller
routine CircularList[T].remove_first(me: @Me) -> T
needs T: typename
    when me.remove_first_checked()
        is T as value => return value
        is None => crash_absent_value()

### `remove_first`, returning None instead of crashing on an empty list.
### :returns: The removed element.
### :absent: When the list is empty.
routine CircularList[T].remove_first_checked(me: @Me) -> Maybe[T]
needs T: typename
    local count: USize = me.count.peek()

    if count == 0
        return None()
    else
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        me.start.poke(start + 1)
        me.count.poke(count - 1)
        return steal data.stride(start)

### Reads the element at logical position `index`, counted from the front.
### :param index: The zero-based position to read.
### :returns: A copy of the element.
### :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
@track_caller
routine CircularList[T].getitem(me: @Me, index: USize) -> T
needs T: typename
    count: USize = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        return data.stride(start + index).peek()
    else
        crash_out_of_bounds()

### `getitem`, returning None instead of crashing on an index past the end.
### :param index: The zero-based position to read.
### :returns: A copy of the element.
### :absent: When `index >= count`.
routine CircularList[T].getitem_checked(me: @Me, index: USize) -> Maybe[T]
needs T: typename
    count: USize = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        return data.stride(start + index).peek()
    else
        return None()

### The address of element `index`, checked like getitem: a place to read or write in place. It stays valid until
### the list grows, shrinks, or is destructed.
### :param index: The zero-based position.
### :returns: The element's address.
### :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
@track_caller
routine CircularList[T].getslot(me: @Me, index: USize) -> @T
needs T: typename
    count: USize = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        element: @T = data.stride(start + index)
        return element
    else
        crash_out_of_bounds()

### `at`, returning None instead of crashing on an index past the end.
### :param index: The zero-based position.
### :returns: The element's address.
### :absent: When `index >= count`.
routine CircularList[T].getslot_checked(me: @Me, index: USize) -> Maybe[@T]
needs T: typename
    count: USize = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        element: @T = data.stride(start + index)
        return element
    else
        return None()

### Whether two lists hold equal elements in the same logical order, regardless of where each sits in its buffer.
### :param other: The list to compare with.
### :returns: `true` when the counts match and every element pair is equal.
routine CircularList[T].eq(me: @Me, other: @Me) -> Bool
needs T: typename, Equatable[T]
    return me.eq_at(other)

### `eq`, through pointers to the two lists.
### :param other: The list to compare with.
### :returns: True when the counts match and every element pair is equal.
secret routine CircularList[T].eq_at(me: @Me, other: @Me) -> Bool
needs T: typename, Equatable[T]
    local la: USize = me.count.peek()

    lb: USize = other.count.peek()
    if la == lb
        sa: USize = me.start.peek()
        sb: USize = other.start.peek()
        pa: @T = me.storage.data.peek()

        pb: @T = other.storage.data.peek()

        each i in 0 til la
            if pa.stride(sa + i).eq(pb.stride(sb + i))
                continue
            else
                return false
        then
            return true
    else
        return false

### Overwrites the element at logical position `index` with `value`: the element there is ended first (drop).
### :param index: The zero-based position to write.
### :param value: The value to store, taken over.
### :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
@track_caller
routine CircularList[T].setitem(me: @Me, index: USize, value: T) -> None
needs T: typename
    count: USize = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: USize = me.start.peek()
        drop data.stride(start + index)
        data.stride(start + index).poke(steal value)
        return
    else
        crash_out_of_bounds()

### Exchanges the elements at logical positions `first` and `second`, counted from the front, in place. Each element
### is moved, never copied, so entity elements swap too, and neither place is left hollow. The same index twice
### changes nothing.
### :param first: The zero-based position of one element.
### :param second: The zero-based position of the other element.
### :throws: Crashes with `IndexOutOfBoundsError` when `first >= count` or `second >= count`.
@track_caller
routine CircularList[T].swap(me: @Me, first: USize, second: USize) -> None
needs T: typename
    data: @T = me.storage.data.peek()
    front: @T = data.stride(me.start.peek())
    elements: Span[T] = Span[T].construct(data: front, count: me.count.peek())
    elements.swap(first, second)
    return

### Removes every element (each is ended, drop) and re-centers the start index. The buffer and its capacity are kept
### for reuse.
routine CircularList[T].clear(me: @Me) -> None
needs T: typename
    me.drop_elements()
    capacity: USize = me.storage.count.peek()
    start: USize = capacity // 2
    me.start.poke(start)
    me.count.poke(0)
    return

### Ends every element (drop: an element with something to give back gives it back, a plain value or a borrowed
### pointer gives nothing).
secret routine CircularList[T].drop_elements(me: @Me) -> None
needs T: typename
    data: @T = me.storage.data.peek()
    start: USize = me.start.peek()
    each i in 0 til me.count.peek()
        drop data.stride(start + i)
    return

### Ends every element, then gives the list's memory back to its allocator and resets it to the empty state, so it
### can be reused or destructed again.
### :note: Does nothing on a hollow instance (`.hollow()`, no allocator), and only resets the fields of a never-filled one.
@track_caller
routine CircularList[T].destruct(me: @Me) -> None
needs T: typename
    if me.storage.manager.peek().is_null()
        return
    me.drop_elements()
    me.storage.give_back()
    me.start.poke(0)
    me.count.poke(0)
    return

# -- text -----------------------------------------------------------------------

### The elements from the front, each diagnosed (strings quoted): [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine CircularList[T].represent_into[TWriter](me: @Me, out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    write_str(out, text: "[")
    each i in 0 til me.count()
        if i != 0
            write_str(out, text: ", ")
        me.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return

### The elements from the front, each diagnosed: [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine CircularList[T].diagnose_into[TWriter](me: @Me, out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    write_str(out, text: "[")
    each i in 0 til me.count()
        if i != 0
            write_str(out, text: ", ")
        me.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return
