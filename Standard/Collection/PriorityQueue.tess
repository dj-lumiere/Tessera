// Tessera stdlib collection: PriorityQueue<TPriority, TElement>
//
// Binary min-heap of (priority, element) entries ordered by the priority's
// Comparable<TPriority>: the entry with the smallest priority by compare sits at
// the top and comes out first. Entries whose priorities compare equal come out
// in no particular order. A Reversed<TPriority> priority takes the largest
// first. The element only rides along and needs no concept. The heap array is a
// Slice of PriorityEntry whose count is the capacity, and it keeps the
// allocator.

module Standard::Collections

import Standard::Alloc
import Standard::Format

/// One entry of a PriorityQueue: the priority it is ordered by and the element it carries. `peek_entry` and
/// `pop_entry` hand it back.
/// :typeparam TPriority: The priority type.
/// :typeparam TElement: The element type.
record PriorityEntry<TPriority, TElement>
require TPriority: typename, TElement: typename
    priority : TPriority
    element  : TElement

/// A binary min-heap on a growable array: each element is pushed with a priority, the entry with the smallest priority by `compare` is always at the top, and `pop` takes it out first. Entries whose priorities compare equal come out in no particular order. For the largest priority first, use {Reversed<T>} priorities. Push and pop are `O(log n)`, and peek is `O(1)`.
/// :typeparam TPriority: The priority type, ordered by its `Comparable` conformance.
/// :typeparam TElement: The element type, which only rides along with its priority.
record PriorityQueue<TPriority, TElement>
conform Destructible<PriorityQueue<TPriority, TElement>>
conform Representable<PriorityQueue<TPriority, TElement>> when TPriority: typename, TElement: typename, Diagnosable<TPriority>, Diagnosable<TElement>
conform Diagnosable<PriorityQueue<TPriority, TElement>>   when TPriority: typename, TElement: typename, Diagnosable<TPriority>, Diagnosable<TElement>
require TPriority: typename, TElement: typename, Comparable<TPriority>
    storage : Slice<PriorityEntry<TPriority, TElement>>
    count   : USize

/// Creates an empty PriorityQueue that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the queue stores and later frees its memory with.
/// :returns: A new empty PriorityQueue.
routine PriorityQueue<TPriority, TElement>.construct(alloc: @Allocator) -> Me
require TPriority: typename, TElement: typename
    block entry()
        storage : Slice<PriorityEntry<TPriority, TElement>> = .construct(0, alloc)
        queue   : Me                                        = Me { storage: storage, count: 0 }
        return(queue)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the queue is empty.
routine PriorityQueue<TPriority, TElement>.count(me: Me) -> USize
require TPriority: typename, TElement: typename
    block entry()
        count : USize = me.count
        return(count)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the queue is empty.
routine PriorityQueue<TPriority, TElement>.count(me: @Me) -> USize
require TPriority: typename, TElement: typename
    block entry()
        count : USize = me.load().count()
        return(count)

/// Whether the queue holds no entries.
/// :returns: `true` when the count is `0`.
routine PriorityQueue<TPriority, TElement>.is_empty(me: @Me) -> Bool
require TPriority: typename, TElement: typename
    block entry()
        empty : Bool = me.load().is_empty()
        return(empty)

/// Whether the queue holds no entries.
/// :returns: `true` when the count is `0`.
routine PriorityQueue<TPriority, TElement>.is_empty(me: Me) -> Bool
require TPriority: typename, TElement: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Grows the heap array to hold at least `capacity` entries without further allocation.
/// :param capacity: The number of entries to make room for.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {PriorityQueue<TPriority, TElement>.reserve_result}.
#track_caller
routine PriorityQueue<TPriority, TElement>.reserve(me: @Me, capacity: USize) -> Void
require TPriority: typename, TElement: typename
    block entry()
        reserved : Bool = me.make_capacity(capacity)
        branch reserved
            ? return()
            : crash_allocation()

/// `reserve`, returning a Failure instead of crashing when the allocator fails.
/// :param capacity: The number of entries to make room for.
/// :returns: `Success` once the heap array holds at least `capacity` entries.
/// :throws: Returns `Failure(AllocFailed)` when the allocator fails.
routine PriorityQueue<TPriority, TElement>.reserve_result(me: @Me,
    capacity: USize) -> Result<Unit, AllocFailed>
require TPriority: typename, TElement: typename
    block entry()
        reserved : Bool = me.make_capacity(capacity)
        branch reserved
            ? return(.Success(Unit.value()))
            : return(.Failure(AllocFailed {}))

/// Grows the heap array to at least `capacity` entries.
/// :param capacity: The number of entries to make room for.
/// :returns: True when the array is big enough, false when the allocator failed (the queue is left as it was).
private routine PriorityQueue<TPriority, TElement>.make_capacity(me: @Me, capacity: USize) -> Bool
require TPriority: typename, TElement: typename
    block entry()
        old_capacity : USize = me.storage.count.load()
        enough       : Bool  = old_capacity.ge(capacity)
        branch enough
            ? return(true)
            : continue
        resized : Result<Unit, AllocFailed> = me.storage.resize_result(capacity)
        when resized
            .Success -> return(true)
            .Failure -> return(false)

/// Makes room for `wanted` entries: an empty array starts at 8 slots (or `wanted`, when larger), and a full one
/// doubles until the request fits.
/// :param wanted: The entry count the array must hold.
/// :returns: True when the array is big enough, false when the allocator failed (the queue is left as it was).
private routine PriorityQueue<TPriority, TElement>.make_room(me: @Me, wanted: USize) -> Bool
require TPriority: typename, TElement: typename
    shared capacity : USize = me.storage.count.load()

    block entry()
        enough : Bool = capacity.ge(wanted)
        branch enough
            ? return(true)
            : choose()

    block choose()
        empty : Bool = capacity.eq(0)
        branch empty
            ? initial()
            : double(capacity)

    block initial()
        base         : USize = 8
        use_wanted   : Bool  = wanted.gt(base)
        new_capacity : USize = use_wanted
            ? wanted
            : base
        return(me.make_capacity(new_capacity))

    block double(grown: USize)
        next   : USize = grown.mul(2)
        enough : Bool  = next.ge(wanted)
        branch enough
            ? return(me.make_capacity(next))
            : double(next)

/// Adds `element` with `priority` and sifts the entry up to its place in the heap.
/// :param priority: The priority the element is ordered by, the smallest first.
/// :param element: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {PriorityQueue<TPriority, TElement>.push_result}.
#track_caller
routine PriorityQueue<TPriority, TElement>.push(me: @Me, priority: TPriority,
    element: TElement) -> Void
require TPriority: typename, TElement: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = me.push_result(priority, element)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push`, returning a Failure instead of crashing when the allocator fails.
/// :param priority: The priority the element is ordered by, the smallest first.
/// :param element: The element to add.
/// :returns: `Success` once the entry is in the heap.
/// :throws: Returns `Failure(AllocFailed)` when the heap array must grow and the allocator fails.
routine PriorityQueue<TPriority, TElement>.push_result(me: @Me, priority: TPriority,
    element: TElement) -> Result<Unit, AllocFailed>
require TPriority: typename, TElement: typename
    shared data_at : @@PriorityEntry<TPriority, TElement> = me.storage.data

    block entry()
        count  : USize = me.count.load()
        wanted : USize = count.add(1)
        room   : Bool  = me.make_room(wanted)
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data : @PriorityEntry<TPriority, TElement> = data_at.load()
        data.stride(count).store(PriorityEntry<TPriority, TElement> { priority: priority,
            element: element })
        me.count.store(wanted)
        jump sift_up(count)

    block sift_up(index: USize)
        at_root : Bool = index.eq(0)
        branch at_root
            ? return(.Success(Unit.value()))
            : compare_parent(index)

    block compare_parent(index: USize)
        parent       : USize                               = index.sub(1).div(2)
        data         : @PriorityEntry<TPriority, TElement> = data_at.load()
        child_entry  : PriorityEntry<TPriority, TElement>  = data.stride(index).load()
        parent_entry : PriorityEntry<TPriority, TElement>  = data.stride(parent).load()
        smaller      : Bool                                = child_entry.priority.compare(parent_entry.priority).lt(0)
        branch smaller
            ? swap(index, parent, child_entry, parent_entry)
            : return(.Success(Unit.value()))

    block swap(index: USize, parent: USize, child_entry: PriorityEntry<TPriority, TElement>,
        parent_entry: PriorityEntry<TPriority, TElement>)
        data : @PriorityEntry<TPriority, TElement> = data_at.load()
        data.stride(parent).store(child_entry)
        data.stride(index).store(parent_entry)
        jump sift_up(parent)

/// Reads the element with the smallest priority, the top, without removing it.
/// :returns: A copy of the top element.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<TPriority, TElement>.peek_checked}.
#track_caller
routine PriorityQueue<TPriority, TElement>.peek(me: Me) -> TElement
require TPriority: typename, TElement: typename
    block entry()
        top : PriorityEntry<TPriority, TElement> = me.peek_entry()
        return(top.element)

/// Reads the element with the smallest priority, the top, without removing it.
/// :returns: A copy of the top element.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<TPriority, TElement>.peek_checked}.
#track_caller
routine PriorityQueue<TPriority, TElement>.peek(me: @Me) -> TElement
require TPriority: typename, TElement: typename
    block entry()
        element : TElement = me.load().peek()
        return(element)

/// `peek`, returning Absent instead of crashing on an empty queue.
/// :returns: A copy of the top element.
/// :absent: When the queue is empty.
routine PriorityQueue<TPriority, TElement>.peek_checked(me: @Me) -> Option<TElement>
require TPriority: typename, TElement: typename
    block entry()
        element : Option<TElement> = me.load().peek_checked()
        return(element)

/// `peek`, returning Absent instead of crashing on an empty queue.
/// :returns: A copy of the top element.
/// :absent: When the queue is empty.
routine PriorityQueue<TPriority, TElement>.peek_checked(me: Me) -> Option<TElement>
require TPriority: typename, TElement: typename
    block entry()
        top : Option<PriorityEntry<TPriority, TElement>> = me.peek_entry_checked()
        when top
            .Present(found) -> return(.Present(found.element))
            .Absent         -> return(.Absent)

/// Reads the top entry, the smallest priority with its element, without removing it.
/// :returns: A copy of the top entry.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<TPriority, TElement>.peek_entry_checked}.
#track_caller
routine PriorityQueue<TPriority, TElement>.peek_entry(me: Me) -> PriorityEntry<TPriority, TElement>
require TPriority: typename, TElement: typename
    block entry()
        top : Option<PriorityEntry<TPriority, TElement>> = me.peek_entry_checked()
        when top
            .Present(found) -> return(found)
            .Absent         -> crash_absent_value()

/// Reads the top entry, the smallest priority with its element, without removing it.
/// :returns: A copy of the top entry.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<TPriority, TElement>.peek_entry_checked}.
#track_caller
routine PriorityQueue<TPriority, TElement>.peek_entry(me: @Me) -> PriorityEntry<TPriority, TElement>
require TPriority: typename, TElement: typename
    block entry()
        top : PriorityEntry<TPriority, TElement> = me.load().peek_entry()
        return(top)

/// `peek_entry`, returning Absent instead of crashing on an empty queue.
/// :returns: A copy of the top entry.
/// :absent: When the queue is empty.
routine PriorityQueue<TPriority, TElement>.peek_entry_checked(me: @Me) -> Option<PriorityEntry<TPriority, TElement>>
require TPriority: typename, TElement: typename
    block entry()
        top : Option<PriorityEntry<TPriority, TElement>> = me.load().peek_entry_checked()
        return(top)

/// `peek_entry`, returning Absent instead of crashing on an empty queue.
/// :returns: A copy of the top entry.
/// :absent: When the queue is empty.
routine PriorityQueue<TPriority, TElement>.peek_entry_checked(me: Me) -> Option<PriorityEntry<TPriority, TElement>>
require TPriority: typename, TElement: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        branch empty
            ? return(.Absent)
            : load()

    block load()
        data : @PriorityEntry<TPriority, TElement> = me.storage.data
        top  : PriorityEntry<TPriority, TElement>  = data.stride(0).load()
        return(.Present(top))

/// Removes the element with the smallest priority, the top, and returns it, then restores the heap order.
/// :returns: The removed top element.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<TPriority, TElement>.pop_checked}.
#track_caller
routine PriorityQueue<TPriority, TElement>.pop(me: @Me) -> TElement
require TPriority: typename, TElement: typename
    block entry()
        top : PriorityEntry<TPriority, TElement> = me.pop_entry()
        return(top.element)

/// `pop`, returning Absent instead of crashing on an empty queue.
/// :returns: The removed top element.
/// :absent: When the queue is empty.
routine PriorityQueue<TPriority, TElement>.pop_checked(me: @Me) -> Option<TElement>
require TPriority: typename, TElement: typename
    block entry()
        top : Option<PriorityEntry<TPriority, TElement>> = me.pop_entry_checked()
        when top
            .Present(found) -> return(.Present(found.element))
            .Absent         -> return(.Absent)

/// Removes the top entry, the smallest priority with its element, and returns it, then restores the heap order.
/// :returns: The removed top entry.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<TPriority, TElement>.pop_entry_checked}.
#track_caller
routine PriorityQueue<TPriority, TElement>.pop_entry(me: @Me) -> PriorityEntry<TPriority, TElement>
require TPriority: typename, TElement: typename
    block entry()
        top : Option<PriorityEntry<TPriority, TElement>> = me.pop_entry_checked()
        when top
            .Present(found) -> return(found)
            .Absent         -> crash_absent_value()

/// `pop_entry`, returning Absent instead of crashing on an empty queue.
/// :returns: The removed top entry.
/// :absent: When the queue is empty.
routine PriorityQueue<TPriority, TElement>.pop_entry_checked(me: @Me) -> Option<PriorityEntry<TPriority, TElement>>
require TPriority: typename, TElement: typename
    shared count   : USize                                = me.count.load()
    shared data_at : @@PriorityEntry<TPriority, TElement> = me.storage.data

    block entry()
        empty : Bool = count.eq(0)
        branch empty
            ? return(.Absent)
            : remove_root()

    block remove_root()
        data      : @PriorityEntry<TPriority, TElement> = data_at.load()
        result    : PriorityEntry<TPriority, TElement>  = data.stride(0).load()
        new_count : USize                               = count.sub(1)
        me.count.store(new_count)
        now_empty : Bool = new_count.eq(0)
        branch now_empty
            ? return(.Present(result))
            : move_last(result, new_count)

    block move_last(result: PriorityEntry<TPriority, TElement>, new_count: USize)
        data : @PriorityEntry<TPriority, TElement> = data_at.load()
        last : PriorityEntry<TPriority, TElement>  = data.stride(new_count).load()
        data.stride(0).store(last)
        jump sift_down(0, result)

    block sift_down(index: USize, result: PriorityEntry<TPriority, TElement>)
        heap_count : USize = me.count.load()
        left       : USize = index.mul(2).add(1)
        right      : USize = left.add(1)
        has_left   : Bool  = left.lt(heap_count)
        branch has_left
            ? choose_child(index, left, right, result)
            : return(.Present(result))

    block choose_child(index: USize, left: USize, right: USize,
        result: PriorityEntry<TPriority, TElement>)
        heap_count : USize = me.count.load()
        has_right  : Bool  = right.lt(heap_count)
        branch has_right
            ? compare_children(index, left, right, result)
            : compare_with_child(index, left, result)

    block compare_children(index: USize, left: USize, right: USize,
        result: PriorityEntry<TPriority, TElement>)
        data          : @PriorityEntry<TPriority, TElement> = data_at.load()
        left_entry    : PriorityEntry<TPriority, TElement>  = data.stride(left).load()
        right_entry   : PriorityEntry<TPriority, TElement>  = data.stride(right).load()
        right_smaller : Bool                                = right_entry.priority.compare(left_entry.priority).lt(0)
        child         : USize                               = right_smaller
            ? right
            : left
        jump compare_with_child(index, child, result)

    block compare_with_child(index: USize, child: USize, result: PriorityEntry<TPriority, TElement>)
        data          : @PriorityEntry<TPriority, TElement> = data_at.load()
        index_entry   : PriorityEntry<TPriority, TElement>  = data.stride(index).load()
        child_entry   : PriorityEntry<TPriority, TElement>  = data.stride(child).load()
        child_smaller : Bool                                = child_entry.priority.compare(index_entry.priority).lt(0)
        branch child_smaller
            ? swap_down(index, child, index_entry, child_entry, result)
            : return(.Present(result))

    block swap_down(index: USize, child: USize, index_entry: PriorityEntry<TPriority, TElement>,
        child_entry: PriorityEntry<TPriority, TElement>, result: PriorityEntry<TPriority, TElement>)
        data : @PriorityEntry<TPriority, TElement> = data_at.load()
        data.stride(index).store(child_entry)
        data.stride(child).store(index_entry)
        jump sift_down(child, result)

/// Removes every entry by resetting the count to `0`. The array and its capacity are kept for reuse, and neither priorities nor elements are destructed.
routine PriorityQueue<TPriority, TElement>.clear(me: @Me) -> Void
require TPriority: typename, TElement: typename
    block entry()
        me.count.store(0)
        return()

/// Gives the queue's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored priorities and elements themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine PriorityQueue<TPriority, TElement>.destruct(me: @Me) -> Void
require TPriority: typename, TElement: typename
    block entry()
        me.storage.resize(0)
        me.count.store(0)
        return()

/// Destructs every priority and every element, then the queue itself: for priorities and elements the queue owns.
#track_caller
routine PriorityQueue<TPriority, TElement>.destruct_all(me: @Me) -> Void
require TPriority: typename, TElement: typename, Destructible<TPriority>, Destructible<TElement>
    shared count : USize                               = me.count.load()
    shared data  : @PriorityEntry<TPriority, TElement> = me.storage.data.load()

    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish()
            : entry_at(i)

    block entry_at(i: USize)
        item : @PriorityEntry<TPriority, TElement> = data.stride(i)
        item.priority.destruct()
        item.element.destruct()
        jump loop(i.add(1))

    block finish()
        me.destruct()
        return()

/// Destructs every element, then the queue itself, leaving the priorities alone: for elements the queue owns under
/// plain priorities.
#track_caller
routine PriorityQueue<TPriority, TElement>.destruct_all_elements(me: @Me) -> Void
require TPriority: typename, TElement: typename, Destructible<TElement>
    shared count : USize                               = me.count.load()
    shared data  : @PriorityEntry<TPriority, TElement> = me.storage.data.load()

    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish()
            : element(i)

    block element(i: USize)
        item : @PriorityEntry<TPriority, TElement> = data.stride(i)
        item.element.destruct()
        jump loop(i.add(1))

    block finish()
        me.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The entries in heap order (the top first, the rest not sorted), each written `priority: element` with both
/// diagnosed (strings quoted): [1: "a", 4: "d", 2: "b"].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine PriorityQueue<TPriority, TElement>.represent_into<TWriter>(me: Me, out: @TWriter) -> Void
require TPriority: typename, TElement: typename, Diagnosable<TPriority>, Diagnosable<TElement>, TWriter: typename, Writer<TWriter>
    block entry()
        me.diagnose_into(out)
        return()

/// The entries in heap order (the top first, the rest not sorted), each written `priority: element` with both
/// diagnosed: [1: "a", 4: "d", 2: "b"].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine PriorityQueue<TPriority, TElement>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require TPriority: typename, TElement: typename, Diagnosable<TPriority>, Diagnosable<TElement>, TWriter: typename, Writer<TWriter>
    shared count : USize = me.count

    block entry()
        write_str(out, "[")
        jump walk(0)

    block walk(at: USize)
        more : Bool = at.lt(count)
        branch more
            ? item(at)
            : close()

    block item(at: USize)
        first : Bool = at.eq(0)
        branch first
            ? element(at)
            : comma(at)

    block comma(at: USize)
        write_str(out, ", ")
        jump element(at)

    block element(at: USize)
        data : @PriorityEntry<TPriority, TElement> = me.storage.data
        item : PriorityEntry<TPriority, TElement>  = data.stride(at).load()
        item.priority.diagnose_into(out)
        write_str(out, ": ")
        item.element.diagnose_into(out)
        jump walk(at.add(1))

    block close()
        write_str(out, "]")
        return()
