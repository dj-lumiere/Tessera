// Tessera stdlib collection: PriorityQueue<T>
//
// Binary min-heap ordered by Priority<T>: a.less(b) returns true when a has
// higher priority than b (sits closer to the top). The allocator is stored in
// the record.

module Standard::Collections

import Standard::Alloc
import Standard::Format

/// A binary heap on a growable array. `a.less(b)` means `a` has higher priority than `b`, and the element with the highest priority is always at the top. Push and pop are `O(log n)`, and peek is `O(1)`.
/// :typeparam T: The element type, ordered by its `Priority` conformance.
record PriorityQueue<T>
conform Destruct<PriorityQueue<T>>
conform Represent<PriorityQueue<T>> when T: typename, Priority<T>, Diagnose<T>
conform Diagnose<PriorityQueue<T>>  when T: typename, Priority<T>, Diagnose<T>
require T: typename, Priority<T>
    data     : @T
    count    : USize
    capacity : USize
    alloc    : @Allocator

/// Creates an empty PriorityQueue that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the queue stores and later frees its memory with.
/// :returns: A new empty PriorityQueue.
routine PriorityQueue<T>.construct(alloc: @Allocator) -> Self
require T: typename, Priority<T>
    block entry()
        queue : Self = Self { data: null, count: 0, capacity: 0, alloc: alloc }
        return(queue)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the queue is empty.
routine PriorityQueue<T>.count(self: Self) -> USize
require T: typename
    block entry()
        count : USize = self.count
        return(count)

/// Whether the queue holds no elements.
/// :returns: `true` when the count is `0`.
routine PriorityQueue<T>.is_empty(self: Self) -> Bool
require T: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Grows the heap array to hold at least `capacity` elements without further allocation.
/// :param capacity: The number of elements to make room for.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {PriorityQueue<T>.reserve_result}.
#track_caller
routine PriorityQueue<T>.reserve(self: @Self, capacity: USize) -> Void
require T: typename
    block entry()
        reserved : Bool = self.make_capacity(capacity)
        branch reserved
            ? return()
            : crash_allocation()

/// `reserve`, returning a Failure instead of crashing when the allocator fails.
routine PriorityQueue<T>.reserve_result(self: @Self, capacity: USize) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        reserved : Bool = self.make_capacity(capacity)
        branch reserved
            ? return(.Success(Unit.value()))
            : return(.Failure(AllocFailed {}))

/// Grows the heap array to at least capacity elements. Returns false when the
/// allocator fails, leaving the queue as it was.
private routine PriorityQueue<T>.make_capacity(self: @Self, capacity: USize) -> Bool
require T: typename
    block entry()
        old_capacity : USize = self.capacity.load()
        enough       : Bool  = old_capacity.ge(capacity)
        branch enough
            ? return(true)
            : grow()

    block grow()
        alloc    : @Allocator = self.alloc.load()
        old_data : @T         = self.data.load()
        new_data : @T         = reallocate<T>(alloc, old_data, capacity)
        failed   : Bool       = new_data.is_null()
        branch failed
            ? return(false)
            : install(new_data)

    block install(new_data: @T)
        self.data.store(new_data)
        self.capacity.store(capacity)
        return(true)

/// Makes room for wanted elements, doubling the capacity. Returns false when
/// the allocator fails, leaving the queue as it was.
private routine PriorityQueue<T>.make_room(self: @Self, wanted: USize) -> Bool
require T: typename
    block entry()
        capacity : USize = self.capacity.load()
        enough   : Bool  = capacity.ge(wanted)
        branch enough
            ? return(true)
            : choose(capacity)

    block choose(capacity: USize)
        empty : Bool = capacity.eq(0)
        branch empty
            ? initial()
            : double(capacity)

    block initial()
        base         : USize = 8
        use_wanted   : Bool  = wanted.gt(base)
        new_capacity : USize = use_wanted
            ? wanted
            : base
        return(self.make_capacity(new_capacity))

    block double(capacity: USize)
        next   : USize = capacity.mul(2)
        enough : Bool  = next.ge(wanted)
        branch enough
            ? return(self.make_capacity(next))
            : double(next)

/// Adds `value` and sifts it up to its place in the heap.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {PriorityQueue<T>.push_result}.
#track_caller
routine PriorityQueue<T>.push(self: @Self, value: T) -> Void
require T: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = self.push_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push`, returning a Failure instead of crashing when the allocator fails.
routine PriorityQueue<T>.push_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        count  : USize = self.count.load()
        wanted : USize = count.add(1)
        room   : Bool  = self.make_room(wanted)
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data : @T = self.data.load()
        data.stride(count).store(value)
        self.count.store(wanted)
        jump sift_up(count)

    block sift_up(index: USize)
        at_root : Bool = index.eq(0)
        branch at_root
            ? return(.Success(Unit.value()))
            : compare_parent(index)

    block compare_parent(index: USize)
        parent       : USize = index.sub(1).div(2)
        data         : @T    = self.data.load()
        child_value  : T     = data.stride(index).load()
        parent_value : T     = data.stride(parent).load()
        less         : Bool  = child_value.less(parent_value)
        branch less
            ? swap(index, parent, child_value, parent_value)
            : return(.Success(Unit.value()))

    block swap(index: USize, parent: USize, child_value: T, parent_value: T)
        data : @T = self.data.load()
        data.stride(parent).store(child_value)
        data.stride(index).store(parent_value)
        jump sift_up(parent)

/// Reads the highest-priority element without removing it.
/// :returns: A copy of the top element.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<T>.peek_checked}.
#track_caller
routine PriorityQueue<T>.peek(self: Self) -> T
require T: typename
    block entry()
        top : Option<T> = self.peek_checked()
        when top
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `peek`, returning Absent instead of crashing on an empty queue.
routine PriorityQueue<T>.peek_checked(self: Self) -> Option<T>
require T: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        branch empty
            ? return(.Absent)
            : load()

    block load()
        data  : @T = self.data
        value : T  = data.stride(0).load()
        return(.Present(value))

/// Removes the highest-priority element and returns it, then restores the heap order.
/// :returns: The removed top element.
/// :throws: Crashes with `AbsentValueError` when the queue is empty. See {PriorityQueue<T>.pop_checked}.
#track_caller
routine PriorityQueue<T>.pop(self: @Self) -> T
require T: typename
    block entry()
        popped : Option<T> = self.pop_checked()
        when popped
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `pop`, returning Absent instead of crashing on an empty queue.
routine PriorityQueue<T>.pop_checked(self: @Self) -> Option<T>
require T: typename
    block entry()
        count : USize = self.count.load()
        empty : Bool  = count.eq(0)
        branch empty
            ? return(.Absent)
            : remove_root(count)

    block remove_root(count: USize)
        data      : @T    = self.data.load()
        result    : T     = data.stride(0).load()
        new_count : USize = count.sub(1)
        self.count.store(new_count)
        now_empty : Bool = new_count.eq(0)
        branch now_empty ? return(.Present(result)): move_last(result, new_count)

    block move_last(result: T, new_count: USize)
        data : @T = self.data.load()
        last : T  = data.stride(new_count).load()
        data.stride(0).store(last)
        jump sift_down(0, result)

    block sift_down(index: USize, result: T)
        count    : USize = self.count.load()
        left     : USize = index.mul(2).add(1)
        right    : USize = left.add(1)
        has_left : Bool  = left.lt(count)
        branch has_left
            ? choose_child(index, left, right, result)
            : return(.Present(result))

    block choose_child(index: USize, left: USize, right: USize, result: T)
        count     : USize = self.count.load()
        has_right : Bool  = right.lt(count)
        branch has_right
            ? compare_children(index, left, right, result)
            : compare_with_child(index, left, result)

    block compare_children(index: USize, left: USize, right: USize, result: T)
        data        : @T    = self.data.load()
        left_value  : T     = data.stride(left).load()
        right_value : T     = data.stride(right).load()
        right_less  : Bool  = right_value.less(left_value)
        child       : USize = right_less
            ? right
            : left
        jump compare_with_child(index, child, result)

    block compare_with_child(index: USize, child: USize, result: T)
        data        : @T   = self.data.load()
        index_value : T    = data.stride(index).load()
        child_value : T    = data.stride(child).load()
        child_less  : Bool = child_value.less(index_value)
        branch child_less
            ? swap_down(index, child, index_value, child_value, result)
            : return(.Present(result))

    block swap_down(index: USize, child: USize, index_value: T, child_value: T, result: T)
        data : @T = self.data.load()
        data.stride(index).store(child_value)
        data.stride(child).store(index_value)
        jump sift_down(child, result)

/// Removes every element by resetting the count to `0`. The array and its capacity are kept for reuse, and elements are not destructed.
routine PriorityQueue<T>.clear(self: @Self) -> Void
require T: typename
    block entry()
        self.count.store(0)
        return()

/// Frees the queue's memory through its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
routine PriorityQueue<T>.destruct(self: @Self) -> Void
require T: typename
    block entry()
        data  : @T   = self.data.load()
        empty : Bool = data.is_null()
        branch empty
            ? reset()
            : release(data)

    block release(data: @T)
        alloc : @Allocator = self.alloc.load()
        data.free(alloc)
        jump reset()

    block reset()
        self.data.store(null)
        self.count.store(0)
        self.capacity.store(0)
        return()

/// Destructs every element, then the queue itself: for elements the queue owns.
routine PriorityQueue<T>.destruct_all(self: @Self) -> Void
require T: typename, Destruct<T>
    block entry()
        count : USize = self.count.load()
        data  : @T    = self.data.load()
        jump loop(0, count, data)

    block loop(i: USize, count: USize, data: @T)
        done : Bool = i.ge(count)
        branch done
            ? finish()
            : element(i, count, data)

    block element(i: USize, count: USize, data: @T)
        item : @T = data.stride(i)
        item.destruct()
        jump loop(i.add(1), count, data)

    block finish()
        self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements in heap order (the top first, the rest not sorted), each
/// diagnosed (strings quoted): [1, 4, 2].
routine PriorityQueue<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Priority<T>, Diagnose<T>, W: typename, Writer<W>
    block entry()
        write_str(out, "[")
        jump walk(0)

    block walk(at: USize)
        count : USize = self.count
        more  : Bool  = at.lt(count)
        branch more
            ? item(at)
            : close()

    block item(at: USize)
        first : Bool = at.eq(0)
        branch first
            ? element(at)
            : comma(at)

    block comma(at: USize)
        write_str(out, ", ")
        jump element(at)

    block element(at: USize)
        data  : @T = self.data
        value : T  = data.stride(at).load()
        value.diagnose_into(out)
        jump walk(at.add(1))

    block close()
        write_str(out, "]")
        return()

/// The elements in heap order (the top first, the rest not sorted), each
/// diagnosed: [1, 4, 2].
routine PriorityQueue<T>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, Priority<T>, Diagnose<T>, W: typename, Writer<W>
    block entry()
        write_str(out, "[")
        jump walk(0)

    block walk(at: USize)
        count : USize = self.count
        more  : Bool  = at.lt(count)
        branch more
            ? item(at)
            : close()

    block item(at: USize)
        first : Bool = at.eq(0)
        branch first
            ? element(at)
            : comma(at)

    block comma(at: USize)
        write_str(out, ", ")
        jump element(at)

    block element(at: USize)
        data  : @T = self.data
        value : T  = data.stride(at).load()
        value.diagnose_into(out)
        jump walk(at.add(1))

    block close()
        write_str(out, "]")
        return()
