# Tessera stdlib collection: SortedSetIter[T]
#
# In-order iterator over SortedSet[T]. Yields keys in ascending sorted order. It keeps the path from the root to the current node
# on an inline stack, so a full traversal is O(n) and the iterator allocates
# nothing.
#
# Satisfies concept SlotIterator[T, SortedSetIter[T]] (and so Iterator).

module Standard/Collections

### Every internal node has at least two children, so 2^64 entries fit in 64 levels.
private preset SORTED_SET_ITER_DEPTH: USize = 64

### `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the next key to yield. Every child
### left of that key has been walked already.
record SortedSetIter[T]
obeys SlotIterator[T, SortedSetIter[T]]
needs T: typename, Comparable[T]
    nodes: Array[@SortedSetNode[T], SORTED_SET_ITER_DEPTH]
    indices: Array[USize, SORTED_SET_ITER_DEPTH]
    depth: USize

### Releases nothing: a `SortedSetIter` holds no memory of its own.
routine SortedSetIter[T].destruct(me: @Me) -> None
needs T: typename
    return

### Creates an iterator positioned before the smallest element, descending to the leftmost leaf.
### :param set: The sorted set to walk.
### :returns: A new iterator, already positioned when the set is not empty.
routine SortedSetIter[T].construct(set: @SortedSet[T]) -> Me
needs T: typename
    local iter: @Me <- .hollow()

    root: @SortedSetNode[T] = set.root.peek()
    empty: Bool = root.is_null()
    iter.depth.poke(0)
    if not empty
        iter.push_leftmost(root)
    iter_val: Me = iter.peek()
    return iter_val

### Pushes node and the first child of each level below it, down to a leaf.
### :param node: The node to start from.
private routine SortedSetIter[T].push_leftmost(me: @Me, node: @SortedSetNode[T]) -> None
needs T: typename
    while true with current: @SortedSetNode[T] = node
        depth2: USize = me.depth.peek()
        leaf2: Bool = current.leaf.peek()
        me.nodes[depth2] = current
        me.indices[depth2] = 0
        me.depth.poke(depth2 + 1)
        if leaf2
            return
        else
            continue with current: current.children[0]

### Hands out the next element's slot in ascending order, climbing to a parent or descending to the next leaf as
### needed. Changing the element in place can break the order.
### :returns: The next element's address, smallest first.
### :absent: After the largest element has been handed out.
routine SortedSetIter[T].next_checked(me: @Me) -> Maybe[@T]
needs T: typename
    while true
        depth2: USize = me.depth.peek()
        if depth2 == 0
            break
        else
            level: USize = depth2 - 1
            node: @SortedSetNode[T] = me.nodes[level]
            index: USize = me.indices[level]
            count: USize = node.count.peek()
            if index < count
                at: @T = node.keys.getslot(index)
                leaf: Bool = node.leaf.peek()
                me.indices[level] = index + 1
                if not leaf
                    right: @SortedSetNode[T] = node.children[index + 1]
                    me.push_leftmost(right)
                return at
            else
                me.depth.poke(level)
                continue
    return None()

### Hands out the next element's slot and advances the iterator, crashing when there is none.
### :returns: The next element's address, smallest first.
### :throws: Crashes with `AbsentValueError` after the last element has been handed out.
@track_caller
routine SortedSetIter[T].next(me: @Me) -> @T
needs T: typename
    slot: Maybe[@T] = me.next_checked()
    when slot
        is @T as element => return element
        is None => crash_absent_value()

### Yields the next element in ascending order.
### :returns: The next element, smallest first.
### :absent: After the largest element has been yielded.
routine SortedSetIter[T].emit_checked(me: @Me) -> Maybe[T]
needs T: typename
    when me.next_checked()
        is @T as at =>
            value: T = at.peek()
            return value
        is None => return None()

### Yields the next element and advances the iterator, crashing when there is none.
### :returns: The next element, smallest first.
### :throws: Crashes with `AbsentValueError` after the last element has been yielded.
@track_caller
routine SortedSetIter[T].emit(me: @Me) -> T
needs T: typename
    item: Maybe[T] = me.emit_checked()
    when item
        is T as value => return value
        is None => crash_absent_value()
