// Tessera stdlib collection: SortedDict<K, V>
//
// Order-statistic B-tree map with a fixed node key capacity of NODE_KEYS.
// Nodes store keys/values/children inline with fixed arrays.
// The allocator is stored in SortedDict; node helpers still receive it as a parameter.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset NODE_KEYS: USize = 7
private preset NODE_CHILDREN: USize = NODE_KEYS.add(1)
private preset NODE_MIN_KEYS: USize = NODE_KEYS.add(1).div(2)

/// One node of a {SortedDict<K, V>} B-tree: up to `NODE_KEYS` keys and values inline, and for internal nodes the child pointers between them. `subtree_count` is the total entries in the subtree.
/// :typeparam K: The key type.
/// :typeparam V: The value type.
record SortedDictNode<K, V>
require K: typename, V: typename
    leaf          : Bool
    count         : USize
    subtree_count : USize
    keys          : Array<K, NODE_KEYS>
    values        : Array<V, NODE_KEYS>
    children      : Array<@SortedDictNode<K, V>, NODE_CHILDREN>

/// A map kept in ascending key order, stored as an order-statistic B-tree. Keys are unique, lookup and insertion are `O(log n)`, and iteration is in ascending key order.
/// :typeparam K: The key type, ordered by its `Compare` conformance.
/// :typeparam V: The value type.
record SortedDict<K, V>
conform Destruct<SortedDict<K, V>>
conform Represent<SortedDict<K, V>> when K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>
conform Diagnose<SortedDict<K, V>>  when K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>
conform Equal<SortedDict<K, V>>     when K: typename, V: typename, Compare<K>, Equal<V>
require K: typename, V: typename, Compare<K>
    root  : @SortedDictNode<K, V>
    count : USize
    alloc : @Allocator

/// Where the entry of a rank lives: its node and its index there.
private record SortedDictSpot<K, V>
require K: typename, V: typename
    node  : @SortedDictNode<K, V>
    index : USize

/// Creates an empty SortedDict that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the dict stores and later frees its memory with.
/// :returns: A new empty SortedDict.
routine SortedDict<K, V>.construct(alloc: @Allocator) -> Self
require K: typename, V: typename, Compare<K>
    block entry()
        map : Self = Self { root: null, count: 0, alloc: alloc }
        return(map)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine SortedDict<K, V>.count(self: Self) -> USize
require K: typename, V: typename
    block entry()
        count : USize = self.count
        return(count)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine SortedDict<K, V>.is_empty(self: Self) -> Bool
require K: typename, V: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        return(empty)

/// A new empty node, or null when the allocator fails.
routine SortedDictNode<K, V>.construct(leaf: Bool, alloc: @Allocator) -> @Self
require K: typename, V: typename
    block entry()
        node   : @Self = allocate<Self>(alloc, 1)
        failed : Bool  = node.is_null()
        branch failed
            ? return(node)
            : init(node)

    block init(node: @Self)
        node.leaf.store(leaf)
        node.count.store(0)
        node.subtree_count.store(0)
        return(node)

/// The number of entries in the subtree below this node.
/// :returns: The node's subtree count, or `0` for a null node.
routine SortedDictNode<K, V>.subtree_count(self: @Self) -> USize
require K: typename, V: typename
    block entry()
        empty : Bool = self.is_null()
        branch empty
            ? return(0)
            : count()

    block count()
        count : USize = self.subtree_count.load()
        return(count)

/// Recomputes this node's subtree count from its own keys and its children's counts. Call it after the node's contents change.
routine SortedDictNode<K, V>.recount(self: @Self) -> Void
require K: typename, V: typename
    block entry()
        leaf  : Bool  = self.leaf.load()
        count : USize = self.count.load()
        branch leaf
            ? leaf_count(count)
            : internal_count(count)

    block leaf_count(count: USize)
        self.subtree_count.store(count)
        return()

    block internal_count(count: USize)
        jump loop(0, 0, count)

    block loop(i: USize, sum: USize, count: USize)
        done : Bool = i.gt(count)
        branch done
            ? finish(sum)
            : add_child(i, sum, count)

    block add_child(i: USize, sum: USize, count: USize)
        child       : @Self = self.children.get(i)
        child_count : USize = child.subtree_count()
        with_child  : USize = sum.add(child_count)
        has_key     : Bool  = i.lt(count)
        next_sum    : USize = has_key
            ? with_child.add(1)
            : with_child
        jump loop(i.add(1), next_sum, count)

    block finish(sum: USize)
        self.subtree_count.store(sum)
        return()

/// Finds where `key` sits among this node's keys.
/// :param key: The key to locate.
/// :returns: The index of the first key not less than `key`, or the key count when every key is smaller. It is also the child to descend into.
routine SortedDictNode<K, V>.find_index(self: @Self, key: K) -> USize
require K: typename, V: typename
    block entry()
        jump loop(0)

    block loop(i: USize)
        count : USize = self.count.load()
        done  : Bool  = i.ge(count)
        branch done
            ? return(i)
            : compare(i)

    block compare(i: USize)
        node_key        : K    = self.keys.get(i)
        cmp             : S32  = key.compare(node_key)
        before_or_equal : Bool = cmp.le(0)
        branch before_or_equal
            ? return(i)
            : loop(i.add(1))

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {SortedDict<K, V>.get_checked}.
#track_caller
routine SortedDict<K, V>.get(self: Self, key: K) -> V
require K: typename, V: typename
    block entry()
        found : Option<V> = self.get_checked(key)
        when found
            .Present(value) -> return(value)
            .Absent         -> crash_key_not_found()

/// `get`, returning Absent instead of crashing on a missing key.
routine SortedDict<K, V>.get_checked(self: Self, key: K) -> Option<V>
require K: typename, V: typename
    block entry()
        root  : @SortedDictNode<K, V> = self.root
        empty : Bool                  = root.is_null()
        branch empty
            ? return(.Absent)
            : search(root)

    block search(node: @SortedDictNode<K, V>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedDictNode<K, V>, i: USize)
        node_key : K    = node.keys.get(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? load(node, i)
            : descend_or_missing(node, i)

    block descend_or_missing(node: @SortedDictNode<K, V>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? return(.Absent)
            : descend(node, i)

    block descend(node: @SortedDictNode<K, V>, i: USize)
        child : @SortedDictNode<K, V> = node.children.get(i)
        jump search(child)

    block load(node: @SortedDictNode<K, V>, i: USize)
        value : V = node.values.get(i)
        return(.Present(value))

/// The address of key's value, checked like get: a place to update the value in place. Only the value: changing a
/// key in place would break the order. It stays valid until the dict changes shape or is destructed.
#track_caller
routine SortedDict<K, V>.at(self: Self, key: K) -> @V
require K: typename, V: typename
    block entry()
        found : Option<@V> = self.at_checked(key)
        when found
            .Present(value) -> return(value)
            .Absent         -> crash_key_not_found()

/// `at`, returning Absent instead of crashing on a missing key.
routine SortedDict<K, V>.at_checked(self: Self, key: K) -> Option<@V>
require K: typename, V: typename
    block entry()
        root  : @SortedDictNode<K, V> = self.root
        empty : Bool                  = root.is_null()
        branch empty
            ? return(.Absent)
            : search(root)

    block search(node: @SortedDictNode<K, V>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedDictNode<K, V>, i: USize)
        node_key : K    = node.keys.get(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? address(node, i)
            : descend_or_missing(node, i)

    block descend_or_missing(node: @SortedDictNode<K, V>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? return(.Absent)
            : descend(node, i)

    block descend(node: @SortedDictNode<K, V>, i: USize)
        child : @SortedDictNode<K, V> = node.children.get(i)
        jump search(child)

    block address(node: @SortedDictNode<K, V>, i: USize)
        value : @V = node.values.at(i)
        return(.Present(value))

/// SortedDicts are sorted by key, so structural in-order comparison of both
/// keys and values gives map equality.
routine SortedDict<K, V>.eq(self: Self, other: Self) -> Bool
require K: typename, V: typename, Compare<K>, Equal<V>
    block entry()
        claim a : @Self <- self
        claim b : @Self <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// eq, through pointers to the two SortedDicts.
private routine SortedDict<K, V>.eq_at(self: @Self, other: @Self) -> Bool
require K: typename, V: typename, Compare<K>, Equal<V>
    block entry()
        la       : USize = self.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? continue
            : return(false)
        a_val : SortedDictIter<K, V> = .construct(self)
        b_val : SortedDictIter<K, V> = .construct(other)
        claim a : @SortedDictIter<K, V> <- a_val
        claim b : @SortedDictIter<K, V> <- b_val
        jump loop(a, b)

    // both have the same count, so both run out together
    block loop(a: @SortedDictIter<K, V>, b: @SortedDictIter<K, V>)
        x : Option<KVPair<K, V>> = a.next()
        y : Option<KVPair<K, V>> = b.next()
        when x
            .Present(x_item) -> compare(a, b, x_item, y.unwrap())
            .Absent          -> return(true)

    block compare(a: @SortedDictIter<K, V>, b: @SortedDictIter<K, V>, x: KVPair<K, V>,
        y: KVPair<K, V>)
        cmp  : S32  = x.key.compare(y.key)
        k_eq : Bool = cmp.eq(0)
        branch k_eq
            ? continue
            : return(false)
        v_eq : Bool = x.value.eq(y.value)
        branch v_eq
            ? loop(a, b)
            : return(false)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an equal key is in the map.
routine SortedDict<K, V>.contains(self: Self, key: K) -> Bool
require K: typename, V: typename
    block entry()
        root  : @SortedDictNode<K, V> = self.root
        empty : Bool                  = root.is_null()
        branch empty
            ? return(false)
            : search(root)

    block search(node: @SortedDictNode<K, V>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedDictNode<K, V>, i: USize)
        node_key : K    = node.keys.get(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? return(true)
            : descend_or_missing(node, i)

    block descend_or_missing(node: @SortedDictNode<K, V>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? return(false)
            : descend(node, i)

    block descend(node: @SortedDictNode<K, V>, i: USize)
        child : @SortedDictNode<K, V> = node.children.get(i)
        jump search(child)

/// The node and index of the rank-th smallest key. Crashes if rank >= count.
#track_caller
private routine SortedDict<K, V>.locate_rank(self: Self, rank: USize) -> SortedDictSpot<K, V>
require K: typename, V: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = rank.lt(count)
        branch in_bounds
            ? select_root()
            : crash_out_of_bounds()

    block select_root()
        root : @SortedDictNode<K, V> = self.root
        jump select_node(root, rank)

    block select_node(node: @SortedDictNode<K, V>, remaining: USize)
        jump scan(node, remaining, 0)

    block scan(node: @SortedDictNode<K, V>, remaining: USize, i: USize)
        count : USize = node.count.load()
        done  : Bool  = i.ge(count)
        branch done
            ? last_child(node, remaining, i)
            : check_child(node, remaining, i)

    block check_child(node: @SortedDictNode<K, V>, remaining: USize, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? leaf_key(node, remaining, i)
            : internal_child(node, remaining, i)

    block leaf_key(node: @SortedDictNode<K, V>, remaining: USize, i: USize)
        match : Bool = remaining.eq(i)
        branch match
            ? found(node, i)
            : scan(node, remaining, i.add(1))

    block internal_child(node: @SortedDictNode<K, V>, remaining: USize, i: USize)
        child       : @SortedDictNode<K, V> = node.children.get(i)
        child_count : USize                 = child.subtree_count()
        in_child    : Bool                  = remaining.lt(child_count)
        branch in_child
            ? select_node(child, remaining)
            : check_key(node, remaining, i, child_count)

    block check_key(node: @SortedDictNode<K, V>, remaining: USize, i: USize, child_count: USize)
        after_child : USize = remaining.sub(child_count)
        is_key      : Bool  = after_child.eq(0)
        branch is_key
            ? found(node, i)
            : scan(node, after_child.sub(1), i.add(1))

    block last_child(node: @SortedDictNode<K, V>, remaining: USize, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? crash_logic_breached()
            : descend_last(node, remaining, i)

    block descend_last(node: @SortedDictNode<K, V>, remaining: USize, i: USize)
        child : @SortedDictNode<K, V> = node.children.get(i)
        jump select_node(child, remaining)

    block found(node: @SortedDictNode<K, V>, i: USize)
        return(SortedDictSpot<K, V> { node: node, index: i })

/// The rank-th smallest key and its value, copied (0 is the smallest). Crashes if rank >= count. A copy, because
/// writing a key through a pointer would break the order.
routine SortedDict<K, V>.get_by_rank(self: Self, rank: USize) -> KVPair<K, V>
require K: typename, V: typename
    block entry()
        spot  : SortedDictSpot<K, V>  = self.locate_rank(rank)
        node  : @SortedDictNode<K, V> = spot.node
        key   : K                     = node.keys.get(spot.index)
        value : V                     = node.values.get(spot.index)
        return(KVPair<K, V> { key: key, value: value })

/// A pointer to the value of the rank-th smallest key, to change it in place. Crashes if rank >= count. Valid until
/// the next put or remove.
routine SortedDict<K, V>.value_ptr_by_rank(self: Self, rank: USize) -> @V
require K: typename, V: typename
    block entry()
        spot  : SortedDictSpot<K, V>  = self.locate_rank(rank)
        node  : @SortedDictNode<K, V> = spot.node
        value : @V                    = node.values.to<@V>().stride(spot.index)
        return(value)

/// Splits the full child at index around its middle. Returns false when the
/// allocator fails, before anything has moved.
routine SortedDictNode<K, V>.split_child(self: @Self, index: USize, alloc: @Allocator) -> Bool
require K: typename, V: typename
    block entry()
        left     : @Self = self.children.get(index)
        leaf     : Bool  = left.leaf.load()
        right    : @Self = Self.construct(leaf, alloc)
        no_right : Bool  = right.is_null()
        branch no_right
            ? return(false)
            : continue
        mid         : USize = NODE_KEYS.div(2)
        right_start : USize = mid.add(1)
        right_count : USize = NODE_KEYS.sub(right_start)
        right.keys.copy(0, left.keys, right_start, right_count)
        right.values.copy(0, left.values, right_start, right_count)
        right.count.store(right_count)
        branch leaf
            ? promote(left, right, mid)
            : copy_children(left, right, mid, right_count)

    block copy_children(left: @Self, right: @Self, mid: USize, right_count: USize)
        jump child_loop(0, left, right, mid, right_count)

    block child_loop(i: USize, left: @Self, right: @Self, mid: USize, right_count: USize)
        done : Bool = i.gt(right_count)
        branch done
            ? promote(left, right, mid)
            : child_copy(i, left, right, mid, right_count)

    block child_copy(i: USize, left: @Self, right: @Self, mid: USize, right_count: USize)
        src   : USize = mid.add(1).add(i)
        child : @Self = left.children.get(src)
        right.children.set(i, child)
        jump child_loop(i.add(1), left, right, mid, right_count)

    block promote(left: @Self, right: @Self, mid: USize)
        parent_count : USize = self.count.load()
        self.keys.shift_right(index, parent_count)
        self.values.shift_right(index, parent_count)
        jump shift_children(parent_count, left, right, mid)

    block shift_children(i: USize, left: @Self, right: @Self, mid: USize)
        stop : USize = index.add(1)
        done : Bool  = i.lt(stop)
        branch done
            ? install(left, right, mid)
            : move_child(i, left, right, mid)

    block move_child(i: USize, left: @Self, right: @Self, mid: USize)
        child : @Self = self.children.get(i)
        self.children.set(i.add(1), child)
        jump shift_children(i.sub(1), left, right, mid)

    block install(left: @Self, right: @Self, mid: USize)
        middle_key   : K = left.keys.get(mid)
        middle_value : V = left.values.get(mid)
        self.keys.set(index, middle_key)
        self.values.set(index, middle_value)
        self.children.set(index.add(1), right)
        left.count.store(mid)
        next_count : USize = self.count.load().add(1)
        next_count.store_into(self.count)
        left.recount()
        right.recount()
        self.recount()
        return(true)

/// Inserts below a node that isn't full. Returns false when a split fails to
/// allocate; the tree then holds the same elements, some nodes already split.
routine SortedDictNode<K, V>.insert_nonfull(self: @Self, key: K, value: V,
    alloc: @Allocator) -> Bool
require K: typename, V: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? insert_leaf()
            : insert_internal()

    block insert_leaf()
        slot  : USize = self.find_index(key)
        count : USize = self.count.load()
        self.keys.shift_right(slot, count)
        self.values.shift_right(slot, count)
        self.keys.set(slot, key)
        self.values.set(slot, value)
        new_count : USize = count.add(1)
        self.count.store(new_count)
        self.subtree_count.store(new_count)
        return(true)

    block insert_internal()
        slot        : USize = self.find_index(key)
        child       : @Self = self.children.get(slot)
        child_count : USize = child.count.load()
        full        : Bool  = child_count.eq(NODE_KEYS)
        branch full
            ? split_then_insert(slot, child)
            : descend(slot, child)

    block split_then_insert(slot: USize, child: @Self)
        split : Bool = self.split_child(slot, alloc)
        branch split
            ? continue
            : return(false)
        pivot     : K     = self.keys.get(slot)
        cmp       : S32   = key.compare(pivot)
        go_right  : Bool  = cmp.gt(0)
        next_slot : USize = go_right
            ? slot.add(1)
            : slot
        next_child : @Self = self.children.get(next_slot)
        jump descend(next_slot, next_child)

    block descend(slot: USize, child: @Self)
        inserted : Bool = child.insert_nonfull(key, value, alloc)
        branch inserted
            ? continue
            : return(false)
        self.recount()
        return(true)

/// Stores `value` under `key`, inserting a new entry in sorted position or replacing the value of an equal existing key.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :throws: Crashes with `MemoryAllocationError` when a node cannot be allocated. See {SortedDict<K, V>.put_result} for a recoverable form.
#track_caller
routine SortedDict<K, V>.put(self: @Self, key: K, value: V) -> Void
require K: typename, V: typename
    block entry()
        put : Result<Unit, AllocFailed> = self.put_result(key, value)
        when put
            .Success -> return()
            .Failure -> crash_allocation()

/// `put`, returning a Failure instead of crashing when the allocator fails.
routine SortedDict<K, V>.put_result(self: @Self, key: K, value: V) -> Result<Unit, AllocFailed>
require K: typename, V: typename
    block entry()
        root  : @SortedDictNode<K, V> = self.root.load()
        empty : Bool                  = root.is_null()
        branch empty
            ? first_root()
            : maybe_replace(root)

    block first_root()
        alloc   : @Allocator            = self.alloc.load()
        root    : @SortedDictNode<K, V> = SortedDictNode<K, V>.construct(true, alloc)
        no_root : Bool                  = root.is_null()
        branch no_root
            ? return(.Failure(AllocFailed {}))
            : continue
        root.keys.set(0, key)
        root.values.set(0, value)
        root.count.store(1)
        root.subtree_count.store(1)
        self.root.store(root)
        self.count.store(1)
        return(.Success(Unit.value()))

    block maybe_replace(root: @SortedDictNode<K, V>)
        replaced : Bool = root.replace(key, value)
        branch replaced
            ? return(.Success(Unit.value()))
            : insert_root(root)

    block insert_root(root: @SortedDictNode<K, V>)
        alloc      : @Allocator = self.alloc.load()
        root_count : USize      = root.count.load()
        full       : Bool       = root_count.eq(NODE_KEYS)
        branch full
            ? split_root(root, alloc)
            : insert_nonfull(root, alloc)

    block split_root(old_root: @SortedDictNode<K, V>, alloc: @Allocator)
        new_root : @SortedDictNode<K, V> = SortedDictNode<K, V>.construct(false, alloc)
        no_root  : Bool                  = new_root.is_null()
        branch no_root
            ? return(.Failure(AllocFailed {}))
            : continue
        new_root.children.set(0, old_root)
        split : Bool = new_root.split_child(0, alloc)
        branch split
            ? install_root(new_root, alloc)
            : discard_root(new_root, alloc)

    block install_root(new_root: @SortedDictNode<K, V>, alloc: @Allocator)
        self.root.store(new_root)
        jump insert_nonfull(new_root, alloc)

    block discard_root(new_root: @SortedDictNode<K, V>, alloc: @Allocator)
        new_root.free(alloc)
        return(.Failure(AllocFailed {}))

    block insert_nonfull(root: @SortedDictNode<K, V>, alloc: @Allocator)
        inserted : Bool = root.insert_nonfull(key, value, alloc)
        branch inserted
            ? continue
            : return(.Failure(AllocFailed {}))
        next_count : USize = self.count.load().add(1)
        next_count.store_into(self.count)
        return(.Success(Unit.value()))

/// Replaces the value of `key` somewhere in this subtree, if the key is present.
/// :param key: The key whose value to replace.
/// :param value: The new value.
/// :returns: `true` when the key was found and its value replaced, `false` when it is absent.
routine SortedDictNode<K, V>.replace(self: @Self, key: K, value: V) -> Bool
require K: typename, V: typename
    block entry()
        slot   : USize = self.find_index(key)
        count  : USize = self.count.load()
        inside : Bool  = slot.lt(count)
        branch inside
            ? maybe_match(slot)
            : descend_or_missing(slot)

    block maybe_match(slot: USize)
        node_key : K    = self.keys.get(slot)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? replace(slot)
            : descend_or_missing(slot)

    block replace(slot: USize)
        self.values.set(slot, value)
        return(true)

    block descend_or_missing(slot: USize)
        leaf : Bool = self.leaf.load()
        branch leaf ? return(false): descend(slot)

    block descend(slot: USize)
        child    : @Self = self.children.get(slot)
        replaced : Bool  = child.replace(key, value)
        return(replaced)

/// Removes the key and value at `index` from a leaf by shifting the later entries left.
/// :param index: The position of the entry within the leaf.
/// :returns: The removed value.
routine SortedDictNode<K, V>.remove_leaf_at(self: @Self, index: USize) -> V
require K: typename, V: typename
    block entry()
        old   : V     = self.values.get(index)
        count : USize = self.count.load()
        self.keys.shift_left(index, count)
        self.values.shift_left(index, count)
        new_count : USize = count.sub(1)
        self.count.store(new_count)
        self.subtree_count.store(new_count)
        return(old)

// Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
// count >= NODE_MIN_KEYS - 1.
// Helpers below ensure a child has count >= NODE_MIN_KEYS (= t) before any deletion
// descent so the child can absorb a one-key drop without underflowing.

/// Rotates one entry from child `i - 1` through the parent into the front of child `i`, so child `i` gains an entry. Subtree counts are updated.
/// :param i: The index of the child that is short of keys.
routine SortedDictNode<K, V>.borrow_from_left(self: @Self, i: USize) -> Void
require K: typename, V: typename
    block entry()
        separator   : USize = i.sub(1)
        left        : @Self = self.children.get(separator)
        child       : @Self = self.children.get(i)
        left_count  : USize = left.count.load()
        child_count : USize = child.count.load()
        child.keys.shift_right(0, child_count)
        child.values.shift_right(0, child_count)
        pivot_key   : K = self.keys.get(separator)
        pivot_value : V = self.values.get(separator)
        child.keys.set(0, pivot_key)
        child.values.set(0, pivot_value)
        new_pivot_key   : K = left.keys.get(left_count.sub(1))
        new_pivot_value : V = left.values.get(left_count.sub(1))
        self.keys.set(separator, new_pivot_key)
        self.values.set(separator, new_pivot_value)
        leaf : Bool = child.leaf.load()
        branch leaf
            ? finalize(left, child, left_count, child_count)
            : move_child(left, child, left_count, child_count)

    block move_child(left: @Self, child: @Self, left_count: USize, child_count: USize)
        children : USize = child_count.add(1)
        child.children.shift_right(0, children)
        moved : @Self = left.children.get(left_count)
        child.children.set(0, moved)
        jump finalize(left, child, left_count, child_count)

    block finalize(left: @Self, child: @Self, left_count: USize, child_count: USize)
        left.count.store(left_count.sub(1))
        child.count.store(child_count.add(1))
        left.recount()
        child.recount()
        self.recount()
        return()

/// Rotates one entry from child `i + 1` through the parent into the end of child `i`, so child `i` gains an entry. Subtree counts are updated.
/// :param i: The index of the child that is short of keys.
routine SortedDictNode<K, V>.borrow_from_right(self: @Self, i: USize) -> Void
require K: typename, V: typename
    block entry()
        child       : @Self = self.children.get(i)
        right       : @Self = self.children.get(i.add(1))
        child_count : USize = child.count.load()
        right_count : USize = right.count.load()
        pivot_key   : K     = self.keys.get(i)
        pivot_value : V     = self.values.get(i)
        child.keys.set(child_count, pivot_key)
        child.values.set(child_count, pivot_value)
        new_pivot_key   : K = right.keys.get(0)
        new_pivot_value : V = right.values.get(0)
        self.keys.set(i, new_pivot_key)
        self.values.set(i, new_pivot_value)
        right.keys.shift_left(0, right_count)
        right.values.shift_left(0, right_count)
        leaf : Bool = child.leaf.load()
        branch leaf
            ? finalize(child, right, child_count, right_count)
            : move_child(child, right, child_count, right_count)

    block move_child(child: @Self, right: @Self, child_count: USize, right_count: USize)
        moved : @Self = right.children.get(0)
        child.children.set(child_count.add(1), moved)
        right.children.shift_left(0, right_count.add(1))
        jump finalize(child, right, child_count, right_count)

    block finalize(child: @Self, right: @Self, child_count: USize, right_count: USize)
        child.count.store(child_count.add(1))
        right.count.store(right_count.sub(1))
        child.recount()
        right.recount()
        self.recount()
        return()

/// Merges child `i + 1` and the separating entry into child `i` and frees the emptied node, shrinking this node by one key.
/// :param i: The index of the left child of the pair.
/// :param alloc: The allocator that frees the merged node.
routine SortedDictNode<K, V>.merge_children(self: @Self, i: USize, alloc: @Allocator) -> Void
require K: typename, V: typename
    block entry()
        left        : @Self = self.children.get(i)
        right       : @Self = self.children.get(i.add(1))
        left_count  : USize = left.count.load()
        right_count : USize = right.count.load()
        pivot_key   : K     = self.keys.get(i)
        pivot_value : V     = self.values.get(i)
        left.keys.set(left_count, pivot_key)
        left.values.set(left_count, pivot_value)
        dst_start : USize = left_count.add(1)
        left.keys.copy(dst_start, right.keys, 0, right_count)
        left.values.copy(dst_start, right.values, 0, right_count)
        leaf : Bool = left.leaf.load()
        branch leaf
            ? finalize(left, right, left_count, right_count)
            : copy_children(left, right, left_count, right_count)

    block copy_children(left: @Self, right: @Self, left_count: USize, right_count: USize)
        left.children.copy(left_count.add(1), right.children, 0, right_count.add(1))
        jump finalize(left, right, left_count, right_count)

    block finalize(left: @Self, right: @Self, left_count: USize, right_count: USize)
        left.count.store(left_count.add(1).add(right_count))
        parent_count : USize = self.count.load()
        self.keys.shift_left(i, parent_count)
        self.values.shift_left(i, parent_count)
        self.children.shift_left(i.add(1), parent_count.add(1))
        self.count.store(parent_count.sub(1))
        right.free(alloc)
        left.recount()
        self.recount()
        return()

/// Makes sure child `i` has at least `NODE_MIN_KEYS` keys before a deletion descends into it, by borrowing from a sibling or merging with one.
/// :param i: The index of the child about to be descended into.
/// :param alloc: The allocator that frees a merged node.
/// :returns: The index of the child to descend into, which differs from `i` when a merge with the left sibling happened.
#track_caller
routine SortedDictNode<K, V>.ensure_min(self: @Self, i: USize, alloc: @Allocator) -> USize
require K: typename, V: typename
    block entry()
        child       : @Self = self.children.get(i)
        child_count : USize = child.count.load()
        ok          : Bool  = child_count.ge(NODE_MIN_KEYS)
        branch ok ? return(i): try_left()

    block try_left()
        has_left : Bool = i.gt(0)
        branch has_left
            ? check_left()
            : try_right(false)

    block check_left()
        left       : @Self = self.children.get(i.sub(1))
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN_KEYS)
        branch left_ok
            ? do_borrow_left()
            : try_right(true)

    block do_borrow_left()
        self.borrow_from_left(i)
        return(i)

    block try_right(has_left: Bool)
        parent_count : USize = self.count.load()
        has_right    : Bool  = i.lt(parent_count)
        branch has_right
            ? check_right(has_left)
            : pick_merge_no_right(has_left)

    block check_right(has_left: Bool)
        right       : @Self = self.children.get(i.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN_KEYS)
        branch right_ok
            ? do_borrow_right()
            : pick_merge(has_left)

    block do_borrow_right()
        self.borrow_from_right(i)
        return(i)

    block pick_merge(has_left: Bool)
        branch has_left
            ? merge_with_left()
            : merge_with_right()

    block pick_merge_no_right(has_left: Bool)
        branch has_left
            ? merge_with_left()
            : crash_logic_breached()

    block merge_with_left()
        merged_at : USize = i.sub(1)
        self.merge_children(merged_at, alloc)
        return(merged_at)

    block merge_with_right()
        self.merge_children(i, alloc)
        return(i)

/// Removes the entry with the largest key in this subtree, rebalancing children on the way down.
/// :param out_value: Receives the removed entry's value.
/// :param alloc: The allocator used when nodes merge.
/// :returns: The removed largest key.
routine SortedDictNode<K, V>.take_max_key(self: @Self, out_value: @V, alloc: @Allocator) -> K
require K: typename, V: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? leaf_take()
            : descend()

    block leaf_take()
        count : USize = self.count.load()
        index : USize = count.sub(1)
        key   : K     = self.keys.get(index)
        value : V     = self.remove_leaf_at(index)
        out_value.store(value)
        return(key)

    block descend()
        count  : USize = self.count.load()
        actual : USize = self.ensure_min(count, alloc)
        child  : @Self = self.children.get(actual)
        key    : K     = child.take_max_key(out_value, alloc)
        self.recount()
        return(key)

/// Removes the entry with the smallest key in this subtree, rebalancing children on the way down.
/// :param out_value: Receives the removed entry's value.
/// :param alloc: The allocator used when nodes merge.
/// :returns: The removed smallest key.
routine SortedDictNode<K, V>.take_min_key(self: @Self, out_value: @V, alloc: @Allocator) -> K
require K: typename, V: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? leaf_take()
            : descend()

    block leaf_take()
        key   : K = self.keys.get(0)
        value : V = self.remove_leaf_at(0)
        out_value.store(value)
        return(key)

    block descend()
        actual : USize = self.ensure_min(0, alloc)
        child  : @Self = self.children.get(actual)
        key    : K     = child.take_min_key(out_value, alloc)
        self.recount()
        return(key)

/// Removes the entry for `key` from this subtree, rebalancing children on the way down so no node underflows.
/// :param key: The key to remove.
/// :param alloc: The allocator used when nodes merge.
/// :returns: `true` when the key was found and removed, `false` otherwise.
routine SortedDictNode<K, V>.remove(self: @Self, key: K, alloc: @Allocator) -> Bool
require K: typename, V: typename
    block entry()
        slot   : USize = self.find_index(key)
        count  : USize = self.count.load()
        inside : Bool  = slot.lt(count)
        branch inside
            ? maybe_match(slot)
            : descend_or_missing(slot)

    block maybe_match(slot: USize)
        node_key : K    = self.keys.get(slot)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? remove_here(slot)
            : descend_or_missing(slot)

    block remove_here(slot: USize)
        leaf : Bool = self.leaf.load()
        branch leaf
            ? remove_leaf(slot)
            : remove_internal(slot)

    block remove_leaf(slot: USize)
        self.remove_leaf_at(slot)
        return(true)

    block remove_internal(slot: USize)
        left       : @Self = self.children.get(slot)
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN_KEYS)
        branch left_ok
            ? take_pred(slot)
            : try_succ(slot)

    block take_pred(slot: USize)
        claim out : @V <- uninit
        left              : @Self = self.children.get(slot)
        replacement_key   : K     = left.take_max_key(out, alloc)
        replacement_value : V     = out.load()
        self.keys.set(slot, replacement_key)
        self.values.set(slot, replacement_value)
        self.recount()
        return(true)

    block try_succ(slot: USize)
        right       : @Self = self.children.get(slot.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN_KEYS)
        branch right_ok
            ? take_succ(slot)
            : merge_and_recurse(slot)

    block take_succ(slot: USize)
        claim out : @V <- uninit
        right             : @Self = self.children.get(slot.add(1))
        replacement_key   : K     = right.take_min_key(out, alloc)
        replacement_value : V     = out.load()
        self.keys.set(slot, replacement_key)
        self.values.set(slot, replacement_value)
        self.recount()
        return(true)

    block merge_and_recurse(slot: USize)
        self.merge_children(slot, alloc)
        merged  : @Self = self.children.get(slot)
        removed : Bool  = merged.remove(key, alloc)
        self.recount()
        return(removed)

    block descend_or_missing(slot: USize)
        leaf : Bool = self.leaf.load()
        branch leaf ? return(false): descend(slot)

    block descend(slot: USize)
        actual  : USize = self.ensure_min(slot, alloc)
        child   : @Self = self.children.get(actual)
        removed : Bool  = child.remove(key, alloc)
        self.recount()
        return(removed)

/// Removes the entry for `key`, shrinking the tree when the root empties.
/// :param key: The key to remove.
/// :returns: `true` when an entry was removed, `false` when the key was not present.
routine SortedDict<K, V>.remove(self: @Self, key: K) -> Bool
require K: typename, V: typename
    block entry()
        root  : @SortedDictNode<K, V> = self.root.load()
        empty : Bool                  = root.is_null()
        branch empty
            ? return(false)
            : remove_root(root)

    block remove_root(root: @SortedDictNode<K, V>)
        alloc   : @Allocator = self.alloc.load()
        removed : Bool       = root.remove(key, alloc)
        branch removed
            ? after_remove(root)
            : return(false)

    block after_remove(root: @SortedDictNode<K, V>)
        remaining_count : USize = self.count.load().sub(1)
        remaining_count.store_into(self.count)
        root_count : USize = root.count.load()
        empty_root : Bool  = root_count.eq(0)
        branch empty_root
            ? maybe_shrink(root)
            : return(true)

    block maybe_shrink(root: @SortedDictNode<K, V>)
        leaf : Bool = root.leaf.load()
        branch leaf
            ? clear_root(root)
            : shrink(root)

    block clear_root(root: @SortedDictNode<K, V>)
        alloc : @Allocator = self.alloc.load()
        root.free(alloc)
        self.root.store(null)
        return(true)

    block shrink(root: @SortedDictNode<K, V>)
        alloc    : @Allocator            = self.alloc.load()
        new_root : @SortedDictNode<K, V> = root.children.get(0)
        root.free(alloc)
        self.root.store(new_root)
        return(true)

/// Internal nodes store `count` separator keys and `count + 1` children.
routine SortedDictNode<K, V>.free_recursive(self: @Self, alloc: @Allocator) -> Void
require K: typename, V: typename
    block entry()
        leaf : Bool = self.leaf.load()
        branch leaf
            ? free_self()
            : free_children()

    block free_children()
        count : USize = self.count.load()
        jump child_loop(0, count.add(1))

    block child_loop(i: USize, child_count: USize)
        done : Bool = i.ge(child_count)
        branch done
            ? free_self()
            : free_child(i, child_count)

    block free_child(i: USize, child_count: USize)
        child : @Self = self.children.get(i)
        child.free_recursive(alloc)
        jump child_loop(i.add(1), child_count)

    block free_self()
        self.free(alloc)
        return()

/// Frees the dict's memory through its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
routine SortedDict<K, V>.destruct(self: @Self) -> Void
require K: typename, V: typename
    block entry()
        root  : @SortedDictNode<K, V> = self.root.load()
        empty : Bool                  = root.is_null()
        branch empty
            ? reset()
            : free_root(root)

    block free_root(root: @SortedDictNode<K, V>)
        alloc : @Allocator = self.alloc.load()
        root.free_recursive(alloc)
        jump reset()

    block reset()
        self.root.store(null)
        self.count.store(0)
        return()

/// Destructs every key and value, then the dictionary itself.
routine SortedDict<K, V>.destruct_all(self: @Self) -> Void
require K: typename, V: typename, Destruct<K>, Destruct<V>
    block entry()
        iter_val : SortedDictIter<K, V> = .construct(self)
        claim iter       : @SortedDictIter<K, V> <- iter_val
        claim key_slot   : @K                    <- uninit
        claim value_slot : @V                    <- uninit
        jump next(iter, key_slot, value_slot)

    block next(iter: @SortedDictIter<K, V>, key_slot: @K, value_slot: @V)
        item : Option<KVPair<K, V>> = iter.next()
        when item
            .Present(entry) -> entry_found(iter, key_slot, value_slot, entry)
            .Absent         -> finish()

    block entry_found(iter: @SortedDictIter<K, V>, key_slot: @K, value_slot: @V,
        entry: KVPair<K, V>)
        key_slot.store(entry.key)
        key_slot.destruct()
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next(iter, key_slot, value_slot)

    block finish()
        self.destruct()
        return()

/// Destructs every value (the keys own nothing), then the dictionary itself.
routine SortedDict<K, V>.destruct_all_values(self: @Self) -> Void
require K: typename, V: typename, Destruct<V>
    block entry()
        iter_val : SortedDictIter<K, V> = .construct(self)
        claim iter       : @SortedDictIter<K, V> <- iter_val
        claim value_slot : @V                    <- uninit
        jump next(iter, value_slot)

    block next(iter: @SortedDictIter<K, V>, value_slot: @V)
        item : Option<KVPair<K, V>> = iter.next()
        when item
            .Present(entry) -> entry_found(iter, value_slot, entry)
            .Absent         -> finish()

    block entry_found(iter: @SortedDictIter<K, V>, value_slot: @V, entry: KVPair<K, V>)
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next(iter, value_slot)

    block finish()
        self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The entries in key order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
routine SortedDict<K, V>.represent_into<W>(self: Self, out: @W) -> Void
require K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : SortedDictIter<K, V> = .construct(whole)
        claim iter : @SortedDictIter<K, V> <- iter_val
        diagnose_entries<K, V, SortedDictIter<K, V>, W>(out, iter)
        return()

/// The entries in key order, keys and values diagnosed: {"a": 1, "b": 2}.
routine SortedDict<K, V>.diagnose_into<W>(self: Self, out: @W) -> Void
require K: typename, V: typename, Compare<K>, Diagnose<K>, Diagnose<V>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : SortedDictIter<K, V> = .construct(whole)
        claim iter : @SortedDictIter<K, V> <- iter_val
        diagnose_entries<K, V, SortedDictIter<K, V>, W>(out, iter)
        return()
