// Tessera stdlib collection: SortedDict<TKey, TValue>
//
// Order-statistic B-tree map with a fixed node key capacity of NODE_KEYS.
// Nodes store keys/values/children inline with fixed arrays.
// The allocator is stored in SortedDict. Node helpers still receive it as a parameter.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset NODE_KEYS: USize = 7
private preset NODE_CHILDREN: USize = NODE_KEYS.add(1)
private preset NODE_MIN_KEYS: USize = NODE_KEYS.add(1).div(2)

/// One node of a {SortedDict<TKey, TValue>} B-tree: up to `NODE_KEYS` keys and values inline, and for internal nodes the child pointers between them. `subtree_count` is the total entries in the subtree.
/// :typeparam TKey: The key type.
/// :typeparam TValue: The value type.
record SortedDictNode<TKey, TValue>
require TKey: typename, TValue: typename, Comparable<TKey>
    leaf          : Bool
    count         : USize
    subtree_count : USize
    keys          : Array<TKey, NODE_KEYS>
    values        : Array<TValue, NODE_KEYS>
    children      : Array<@SortedDictNode<TKey, TValue>, NODE_CHILDREN>

/// A map kept in ascending key order, stored as an order-statistic B-tree. Keys are unique, lookup and insertion are `O(log n)`, and iteration is in ascending key order.
/// :typeparam TKey: The key type, ordered by its `Comparable` conformance.
/// :typeparam TValue: The value type.
record SortedDict<TKey, TValue>
conform Destructible<SortedDict<TKey, TValue>>
conform Representable<SortedDict<TKey, TValue>> when TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>
conform Diagnosable<SortedDict<TKey, TValue>>   when TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>
conform Equatable<SortedDict<TKey, TValue>>     when TKey: typename, TValue: typename, Equatable<TValue>
require TKey: typename, TValue: typename, Comparable<TKey>
    root  : @SortedDictNode<TKey, TValue>
    count : USize
    alloc : @Allocator

/// Where the entry of a rank lives: its node and its index there.
private record SortedDictSpot<TKey, TValue>
require TKey: typename, TValue: typename
    node  : @SortedDictNode<TKey, TValue>
    index : USize

/// Creates an empty SortedDict that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the dict stores and later frees its memory with.
/// :returns: A new empty SortedDict.
routine SortedDict<TKey, TValue>.construct(alloc: @Allocator) -> Me
require TKey: typename, TValue: typename
    block entry()
        map : Me = Me { root: null, count: 0, alloc: alloc }
        return(map)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine SortedDict<TKey, TValue>.count(me: Me) -> USize
require TKey: typename, TValue: typename
    block entry()
        count : USize = me.count
        return(count)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine SortedDict<TKey, TValue>.count(me: @Me) -> USize
require TKey: typename, TValue: typename
    block entry()
        result : USize = me.load().count()
        return(result)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine SortedDict<TKey, TValue>.is_empty(me: Me) -> Bool
require TKey: typename, TValue: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine SortedDict<TKey, TValue>.is_empty(me: @Me) -> Bool
require TKey: typename, TValue: typename
    block entry()
        result : Bool = me.load().is_empty()
        return(result)

/// A new empty node from `alloc`.
/// :param leaf: Whether the node is a leaf.
/// :param alloc: The allocator to take the node from.
/// :returns: The node, or null when the allocator fails.
routine SortedDictNode<TKey, TValue>.construct(leaf: Bool, alloc: @Allocator) -> @Me
require TKey: typename, TValue: typename
    shared node : @Me = allocate<Me>(1, alloc)

    block entry()
        failed : Bool = node.is_null()
        branch failed
            ? return(node)
            : init()

    block init()
        node.leaf.store(leaf)
        node.count.store(0)
        node.subtree_count.store(0)
        return(node)

/// The number of entries in the subtree below this node.
/// :returns: The node's subtree count, or `0` for a null node.
routine SortedDictNode<TKey, TValue>.subtree_count(me: @Me) -> USize
require TKey: typename, TValue: typename
    block entry()
        empty : Bool = me.is_null()
        branch empty
            ? return(0)
            : count()

    block count()
        count : USize = me.subtree_count.load()
        return(count)

/// Recomputes this node's subtree count from its own keys and its children's counts. Call it after the node's contents change.
routine SortedDictNode<TKey, TValue>.recount(me: @Me) -> Void
require TKey: typename, TValue: typename
    shared leaf  : Bool   = me.leaf.load()
    shared count : USize  = me.count.load()
    shared sum   : @USize <- uninit

    block entry()
        branch leaf
            ? leaf_count()
            : internal_count()

    block leaf_count()
        me.subtree_count.store(count)
        return()

    block internal_count()
        0.store_into(sum)
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.gt(count)
        branch done
            ? store_sum()
            : add_child(i)

    block add_child(i: USize)
        child       : @Me   = me.children.getitem(i)
        child_count : USize = child.subtree_count()
        with_child  : USize = sum.load().add(child_count)
        has_key     : Bool  = i.lt(count)
        next_sum    : USize = has_key
            ? with_child.add(1)
            : with_child
        next_sum.store_into(sum)
        jump loop(i.add(1))

    block store_sum()
        me.subtree_count.store(sum.load())
        return()

/// Finds where `key` sits among this node's keys.
/// :param key: The key to locate.
/// :returns: The index of the first key not less than `key`, or the key count when every key is smaller. It is also the child to descend into.
routine SortedDictNode<TKey, TValue>.find_index(me: @Me, key: TKey) -> USize
require TKey: typename, TValue: typename
    block entry()
        jump loop(0)

    block loop(i: USize)
        count : USize = me.count.load()
        done  : Bool  = i.ge(count)
        branch done
            ? return(i)
            : compare(i)

    block compare(i: USize)
        node_key        : TKey = me.keys.getitem(i)
        cmp             : S32  = key.compare(node_key)
        before_or_equal : Bool = cmp.le(0)
        branch before_or_equal
            ? return(i)
            : loop(i.add(1))

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {SortedDict<TKey, TValue>.getitem_checked}.
#track_caller
routine SortedDict<TKey, TValue>.getitem(me: Me, key: TKey) -> TValue
require TKey: typename, TValue: typename
    block entry()
        found : Option<TValue> = me.getitem_checked(key)
        when found
            .Present(value) -> return(value)
            .Absent         -> crash_key_not_found()

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {SortedDict<TKey, TValue>.getitem_checked}.
#track_caller
routine SortedDict<TKey, TValue>.getitem(me: @Me, key: TKey) -> TValue
require TKey: typename, TValue: typename
    block entry()
        result : TValue = me.load().getitem(key)
        return(result)

/// `getitem`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :absent: When the key is not present.
routine SortedDict<TKey, TValue>.getitem_checked(me: Me, key: TKey) -> Option<TValue>
require TKey: typename, TValue: typename
    block entry()
        root  : @SortedDictNode<TKey, TValue> = me.root
        empty : Bool                          = root.is_null()
        branch empty
            ? return(.Absent)
            : search(root)

    block search(node: @SortedDictNode<TKey, TValue>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedDictNode<TKey, TValue>, i: USize)
        node_key : TKey = node.keys.getitem(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? load(node, i)
            : descend_or_missing(node, i)

    block descend_or_missing(node: @SortedDictNode<TKey, TValue>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? return(.Absent)
            : descend(node, i)

    block descend(node: @SortedDictNode<TKey, TValue>, i: USize)
        child : @SortedDictNode<TKey, TValue> = node.children.getitem(i)
        jump search(child)

    block load(node: @SortedDictNode<TKey, TValue>, i: USize)
        value : TValue = node.values.getitem(i)
        return(.Present(value))

/// `getitem`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :absent: When the key is not present.
routine SortedDict<TKey, TValue>.getitem_checked(me: @Me, key: TKey) -> Option<TValue>
require TKey: typename, TValue: typename
    block entry()
        result : Option<TValue> = me.load().getitem_checked(key)
        return(result)

/// The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
/// value: changing a key in place would break the order. It stays valid until the dict changes shape or is
/// destructed.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent.
#track_caller
routine SortedDict<TKey, TValue>.at(me: Me, key: TKey) -> @TValue
require TKey: typename, TValue: typename
    block entry()
        found : Option<@TValue> = me.at_checked(key)
        when found
            .Present(value) -> return(value)
            .Absent         -> crash_key_not_found()

/// The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
/// value: changing a key in place would break the order. It stays valid until the dict changes shape or is
/// destructed.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent.
#track_caller
routine SortedDict<TKey, TValue>.at(me: @Me, key: TKey) -> @TValue
require TKey: typename, TValue: typename
    block entry()
        result : @TValue = me.load().at(key)
        return(result)

/// `at`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :absent: When the key is not present.
routine SortedDict<TKey, TValue>.at_checked(me: Me, key: TKey) -> Option<@TValue>
require TKey: typename, TValue: typename
    block entry()
        root  : @SortedDictNode<TKey, TValue> = me.root
        empty : Bool                          = root.is_null()
        branch empty
            ? return(.Absent)
            : search(root)

    block search(node: @SortedDictNode<TKey, TValue>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedDictNode<TKey, TValue>, i: USize)
        node_key : TKey = node.keys.getitem(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? address(node, i)
            : descend_or_missing(node, i)

    block descend_or_missing(node: @SortedDictNode<TKey, TValue>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? return(.Absent)
            : descend(node, i)

    block descend(node: @SortedDictNode<TKey, TValue>, i: USize)
        child : @SortedDictNode<TKey, TValue> = node.children.getitem(i)
        jump search(child)

    block address(node: @SortedDictNode<TKey, TValue>, i: USize)
        value : @TValue = node.values.at(i)
        return(.Present(value))

/// `at`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :absent: When the key is not present.
routine SortedDict<TKey, TValue>.at_checked(me: @Me, key: TKey) -> Option<@TValue>
require TKey: typename, TValue: typename
    block entry()
        result : Option<@TValue> = me.load().at_checked(key)
        return(result)

/// Whether two dicts hold the same key-value pairs. Both are sorted by key, so comparing the pairs in order is
/// enough.
/// :param other: The dict to compare with.
/// :returns: True when the counts match and every pair has an equal key and an equal value.
routine SortedDict<TKey, TValue>.eq(me: Me, other: Me) -> Bool
require TKey: typename, TValue: typename, Equatable<TValue>
    block entry()
        claim a : @Me <- me
        claim b : @Me <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// `eq`, through pointers to the two dicts.
/// :param other: The dict to compare with.
/// :returns: True when the counts match and every pair has an equal key and an equal value.
private routine SortedDict<TKey, TValue>.eq_at(me: @Me, other: @Me) -> Bool
require TKey: typename, TValue: typename, Equatable<TValue>
    shared a : @SortedDictIter<TKey, TValue> <- uninit
    shared b : @SortedDictIter<TKey, TValue> <- uninit

    block entry()
        la       : USize = me.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? continue
            : return(false)
        a_val : SortedDictIter<TKey, TValue> = .construct(me)
        b_val : SortedDictIter<TKey, TValue> = .construct(other)
        a.store(a_val)
        b.store(b_val)
        jump loop()

    // both have the same count, so both run out together
    block loop()
        x : Option<KVPair<TKey, TValue>> = a.next()
        y : Option<KVPair<TKey, TValue>> = b.next()
        when x
            .Present(x_item) -> compare(x_item, y.unwrap())
            .Absent          -> return(true)

    block compare(x: KVPair<TKey, TValue>, y: KVPair<TKey, TValue>)
        cmp  : S32  = x.key.compare(y.key)
        k_eq : Bool = cmp.eq(0)
        branch k_eq
            ? continue
            : return(false)
        v_eq : Bool = x.value.eq(y.value)
        branch v_eq
            ? loop()
            : return(false)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an equal key is in the map.
routine SortedDict<TKey, TValue>.has_key(me: Me, key: TKey) -> Bool
require TKey: typename, TValue: typename
    block entry()
        root  : @SortedDictNode<TKey, TValue> = me.root
        empty : Bool                          = root.is_null()
        branch empty
            ? return(false)
            : search(root)

    block search(node: @SortedDictNode<TKey, TValue>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedDictNode<TKey, TValue>, i: USize)
        node_key : TKey = node.keys.getitem(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? return(true)
            : descend_or_missing(node, i)

    block descend_or_missing(node: @SortedDictNode<TKey, TValue>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? return(false)
            : descend(node, i)

    block descend(node: @SortedDictNode<TKey, TValue>, i: USize)
        child : @SortedDictNode<TKey, TValue> = node.children.getitem(i)
        jump search(child)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an equal key is in the map.
routine SortedDict<TKey, TValue>.has_key(me: @Me, key: TKey) -> Bool
require TKey: typename, TValue: typename
    block entry()
        result : Bool = me.load().has_key(key)
        return(result)

/// The node and index of the `rank`-th smallest key.
/// :param rank: The zero-based rank.
/// :returns: The entry's node and its index there.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
#track_caller
private routine SortedDict<TKey, TValue>.locate_rank(me: Me,
    rank: USize) -> SortedDictSpot<TKey, TValue>
require TKey: typename, TValue: typename
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = rank.lt(count)
        branch in_bounds
            ? select_root()
            : crash_out_of_bounds()

    block select_root()
        root : @SortedDictNode<TKey, TValue> = me.root
        jump select_node(root, rank)

    block select_node(node: @SortedDictNode<TKey, TValue>, remaining: USize)
        jump scan(node, remaining, 0)

    block scan(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize)
        count : USize = node.count.load()
        done  : Bool  = i.ge(count)
        branch done
            ? last_child(node, remaining, i)
            : check_child(node, remaining, i)

    block check_child(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? leaf_key(node, remaining, i)
            : internal_child(node, remaining, i)

    block leaf_key(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize)
        match : Bool = remaining.eq(i)
        branch match
            ? found(node, i)
            : scan(node, remaining, i.add(1))

    block internal_child(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize)
        child       : @SortedDictNode<TKey, TValue> = node.children.getitem(i)
        child_count : USize                         = child.subtree_count()
        in_child    : Bool                          = remaining.lt(child_count)
        branch in_child
            ? select_node(child, remaining)
            : check_key(node, remaining, i, child_count)

    block check_key(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize,
        child_count: USize)
        after_child : USize = remaining.sub(child_count)
        is_key      : Bool  = after_child.eq(0)
        branch is_key
            ? found(node, i)
            : scan(node, after_child.sub(1), i.add(1))

    block last_child(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? crash_logic_breached()
            : descend_last(node, remaining, i)

    block descend_last(node: @SortedDictNode<TKey, TValue>, remaining: USize, i: USize)
        child : @SortedDictNode<TKey, TValue> = node.children.getitem(i)
        jump select_node(child, remaining)

    block found(node: @SortedDictNode<TKey, TValue>, i: USize)
        return(SortedDictSpot<TKey, TValue> { node: node, index: i })

/// The `rank`-th smallest key and its value, copied (0 is the smallest). A copy, because writing a key through a
/// pointer would break the order.
/// :param rank: The zero-based rank.
/// :returns: The key and its value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedDict<TKey, TValue>.get_by_rank(me: Me, rank: USize) -> KVPair<TKey, TValue>
require TKey: typename, TValue: typename
    block entry()
        spot  : SortedDictSpot<TKey, TValue>  = me.locate_rank(rank)
        node  : @SortedDictNode<TKey, TValue> = spot.node
        key   : TKey                          = node.keys.getitem(spot.index)
        value : TValue                        = node.values.getitem(spot.index)
        return(KVPair<TKey, TValue> { key: key, value: value })

/// The `rank`-th smallest key and its value, copied (0 is the smallest). A copy, because writing a key through a
/// pointer would break the order.
/// :param rank: The zero-based rank.
/// :returns: The key and its value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedDict<TKey, TValue>.get_by_rank(me: @Me, rank: USize) -> KVPair<TKey, TValue>
require TKey: typename, TValue: typename
    block entry()
        result : KVPair<TKey, TValue> = me.load().get_by_rank(rank)
        return(result)

/// A pointer to the value of the `rank`-th smallest key, to change it in place. Valid until the next put or remove.
/// :param rank: The zero-based rank.
/// :returns: The value's address.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedDict<TKey, TValue>.value_ptr_by_rank(me: Me, rank: USize) -> @TValue
require TKey: typename, TValue: typename
    block entry()
        spot  : SortedDictSpot<TKey, TValue>  = me.locate_rank(rank)
        node  : @SortedDictNode<TKey, TValue> = spot.node
        value : @TValue                       = node.values.to<@TValue>().stride(spot.index)
        return(value)

/// A pointer to the value of the `rank`-th smallest key, to change it in place. Valid until the next put or remove.
/// :param rank: The zero-based rank.
/// :returns: The value's address.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedDict<TKey, TValue>.value_ptr_by_rank(me: @Me, rank: USize) -> @TValue
require TKey: typename, TValue: typename
    block entry()
        result : @TValue = me.load().value_ptr_by_rank(rank)
        return(result)

/// Splits the full child at `index` around its middle: the middle entry moves up into this node and the upper half
/// into a new right sibling.
/// :param index: The index of the full child.
/// :param alloc: The allocator for the new node.
/// :returns: True when it split, false when the allocator failed (before anything moved).
routine SortedDictNode<TKey, TValue>.split_child(me: @Me, index: USize, alloc: @Allocator) -> Bool
require TKey: typename, TValue: typename
    shared left  : @Me  = me.children.getitem(index)
    shared leaf  : Bool = left.leaf.load()
    shared right : @Me  = Me.construct(leaf, alloc)

    block entry()
        no_right : Bool = right.is_null()
        branch no_right
            ? return(false)
            : continue
        mid         : USize = NODE_KEYS.div(2)
        right_start : USize = mid.add(1)
        right_count : USize = NODE_KEYS.sub(right_start)
        right.keys.copy(0, left.keys, right_start, right_count)
        right.values.copy(0, left.values, right_start, right_count)
        right.count.store(right_count)
        branch leaf
            ? promote(mid)
            : copy_children(mid, right_count)

    block copy_children(mid: USize, right_count: USize)
        jump child_loop(0, mid, right_count)

    block child_loop(i: USize, mid: USize, right_count: USize)
        done : Bool = i.gt(right_count)
        branch done
            ? promote(mid)
            : child_copy(i, mid, right_count)

    block child_copy(i: USize, mid: USize, right_count: USize)
        src   : USize = mid.add(1).add(i)
        child : @Me   = left.children.getitem(src)
        right.children.setitem(i, child)
        jump child_loop(i.add(1), mid, right_count)

    block promote(mid: USize)
        parent_count : USize = me.count.load()
        me.keys.shift_right(index, parent_count)
        me.values.shift_right(index, parent_count)
        jump shift_children(parent_count, mid)

    block shift_children(i: USize, mid: USize)
        stop : USize = index.add(1)
        done : Bool  = i.lt(stop)
        branch done
            ? install(mid)
            : move_child(i, mid)

    block move_child(i: USize, mid: USize)
        child : @Me = me.children.getitem(i)
        me.children.setitem(i.add(1), child)
        jump shift_children(i.sub(1), mid)

    block install(mid: USize)
        middle_key   : TKey   = left.keys.getitem(mid)
        middle_value : TValue = left.values.getitem(mid)
        me.keys.setitem(index, middle_key)
        me.values.setitem(index, middle_value)
        me.children.setitem(index.add(1), right)
        left.count.store(mid)
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        left.recount()
        right.recount()
        me.recount()
        return(true)

/// Inserts `key` and `value` below a node that isn't full, splitting full children on the way down. An equal key
/// must not already be in the subtree (the caller replaces those first).
/// :param key: The key to insert.
/// :param value: The value to insert.
/// :param alloc: The allocator for nodes made by splits.
/// :returns: True when it inserted, false when a split failed to allocate. The tree then holds the same entries,
///     some nodes already split.
routine SortedDictNode<TKey, TValue>.insert_nonfull(me: @Me, key: TKey, value: TValue,
    alloc: @Allocator) -> Bool
require TKey: typename, TValue: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? insert_leaf()
            : insert_internal()

    block insert_leaf()
        slot  : USize = me.find_index(key)
        count : USize = me.count.load()
        me.keys.shift_right(slot, count)
        me.values.shift_right(slot, count)
        me.keys.setitem(slot, key)
        me.values.setitem(slot, value)
        new_count : USize = count.add(1)
        me.count.store(new_count)
        me.subtree_count.store(new_count)
        return(true)

    block insert_internal()
        slot        : USize = me.find_index(key)
        child       : @Me   = me.children.getitem(slot)
        child_count : USize = child.count.load()
        full        : Bool  = child_count.eq(NODE_KEYS)
        branch full
            ? split_then_insert(slot, child)
            : descend(slot, child)

    block split_then_insert(slot: USize, child: @Me)
        split : Bool = me.split_child(slot, alloc)
        branch split
            ? continue
            : return(false)
        pivot     : TKey  = me.keys.getitem(slot)
        cmp       : S32   = key.compare(pivot)
        go_right  : Bool  = cmp.gt(0)
        next_slot : USize = go_right
            ? slot.add(1)
            : slot
        next_child : @Me = me.children.getitem(next_slot)
        jump descend(next_slot, next_child)

    block descend(slot: USize, child: @Me)
        inserted : Bool = child.insert_nonfull(key, value, alloc)
        branch inserted
            ? continue
            : return(false)
        me.recount()
        return(true)

/// Stores `value` under `key`, inserting a new entry in sorted position or replacing the value of an equal existing key.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :throws: Crashes with `MemoryAllocationError` when a node cannot be allocated. See {SortedDict<TKey, TValue>.put_result} for a recoverable form.
#track_caller
routine SortedDict<TKey, TValue>.put(me: @Me, key: TKey, value: TValue) -> Void
require TKey: typename, TValue: typename
    block entry()
        put : Result<Unit, AllocFailed> = me.put_result(key, value)
        when put
            .Success -> return()
            .Failure -> crash_allocation()

/// `put`, returning a Failure instead of crashing when the allocator fails.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :returns: `Success` once the value is stored.
/// :throws: Returns `Failure(AllocFailed)` when a node cannot be allocated.
routine SortedDict<TKey, TValue>.put_result(me: @Me, key: TKey,
    value: TValue) -> Result<Unit, AllocFailed>
require TKey: typename, TValue: typename
    shared root : @SortedDictNode<TKey, TValue> = me.root.load()

    block entry()
        empty : Bool = root.is_null()
        branch empty
            ? first_root()
            : maybe_replace()

    block first_root()
        alloc      : @Allocator                    = me.alloc.load()
        first_node : @SortedDictNode<TKey, TValue> = SortedDictNode<TKey, TValue>.construct(true,
            alloc)
        no_root    : Bool                          = first_node.is_null()
        branch no_root
            ? return(.Failure(AllocFailed {}))
            : continue
        first_node.keys.setitem(0, key)
        first_node.values.setitem(0, value)
        first_node.count.store(1)
        first_node.subtree_count.store(1)
        me.root.store(first_node)
        me.count.store(1)
        return(.Success(Unit.value()))

    block maybe_replace()
        replaced : Bool = root.replace(key, value)
        branch replaced
            ? return(.Success(Unit.value()))
            : insert_root()

    block insert_root()
        alloc      : @Allocator = me.alloc.load()
        root_count : USize      = root.count.load()
        full       : Bool       = root_count.eq(NODE_KEYS)
        branch full
            ? split_root(alloc)
            : insert_nonfull(root, alloc)

    block split_root(alloc: @Allocator)
        new_root : @SortedDictNode<TKey, TValue> = SortedDictNode<TKey, TValue>.construct(false,
            alloc)
        no_root  : Bool                          = new_root.is_null()
        branch no_root
            ? return(.Failure(AllocFailed {}))
            : continue
        new_root.children.setitem(0, root)
        split : Bool = new_root.split_child(0, alloc)
        branch split
            ? install_root(new_root, alloc)
            : discard_root(new_root, alloc)

    block install_root(new_root: @SortedDictNode<TKey, TValue>, alloc: @Allocator)
        me.root.store(new_root)
        jump insert_nonfull(new_root, alloc)

    block discard_root(new_root: @SortedDictNode<TKey, TValue>, alloc: @Allocator)
        deallocate<SortedDictNode<TKey, TValue>>(new_root, alloc)
        return(.Failure(AllocFailed {}))

    block insert_nonfull(root_node: @SortedDictNode<TKey, TValue>, alloc: @Allocator)
        inserted : Bool = root_node.insert_nonfull(key, value, alloc)
        branch inserted
            ? continue
            : return(.Failure(AllocFailed {}))
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        return(.Success(Unit.value()))

/// Replaces the value of `key` somewhere in this subtree, if the key is present.
/// :param key: The key whose value to replace.
/// :param value: The new value.
/// :returns: `true` when the key was found and its value replaced, `false` when it is absent.
routine SortedDictNode<TKey, TValue>.replace(me: @Me, key: TKey, value: TValue) -> Bool
require TKey: typename, TValue: typename
    shared slot : USize = me.find_index(key)

    block entry()
        count  : USize = me.count.load()
        inside : Bool  = slot.lt(count)
        branch inside
            ? maybe_match()
            : descend_or_missing()

    block maybe_match()
        node_key : TKey = me.keys.getitem(slot)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? replace()
            : descend_or_missing()

    block replace()
        me.values.setitem(slot, value)
        return(true)

    block descend_or_missing()
        leaf : Bool = me.leaf.load()
        branch leaf ? return(false): descend()

    block descend()
        child    : @Me  = me.children.getitem(slot)
        replaced : Bool = child.replace(key, value)
        return(replaced)

/// Removes the key and value at `index` from a leaf by shifting the later entries left.
/// :param index: The position of the entry within the leaf.
/// :returns: The removed value.
routine SortedDictNode<TKey, TValue>.remove_leaf_at(me: @Me, index: USize) -> TValue
require TKey: typename, TValue: typename
    block entry()
        old   : TValue = me.values.getitem(index)
        count : USize  = me.count.load()
        me.keys.shift_left(index, count)
        me.values.shift_left(index, count)
        new_count : USize = count.sub(1)
        me.count.store(new_count)
        me.subtree_count.store(new_count)
        return(old)

// Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
// count >= NODE_MIN_KEYS - 1.
// Helpers below ensure a child has count >= NODE_MIN_KEYS (= t) before any deletion
// descent so the child can absorb a one-key drop without underflowing.

/// Rotates one entry from child `i - 1` through the parent into the front of child `i`, so child `i` gains an entry. Subtree counts are updated.
/// :param i: The index of the child that is short of keys.
routine SortedDictNode<TKey, TValue>.borrow_from_left(me: @Me, i: USize) -> Void
require TKey: typename, TValue: typename
    shared separator   : USize = i.sub(1)
    shared left        : @Me   = me.children.getitem(separator)
    shared child       : @Me   = me.children.getitem(i)
    shared left_count  : USize = left.count.load()
    shared child_count : USize = child.count.load()

    block entry()
        child.keys.shift_right(0, child_count)
        child.values.shift_right(0, child_count)
        pivot_key   : TKey   = me.keys.getitem(separator)
        pivot_value : TValue = me.values.getitem(separator)
        child.keys.setitem(0, pivot_key)
        child.values.setitem(0, pivot_value)
        new_pivot_key   : TKey   = left.keys.getitem(left_count.sub(1))
        new_pivot_value : TValue = left.values.getitem(left_count.sub(1))
        me.keys.setitem(separator, new_pivot_key)
        me.values.setitem(separator, new_pivot_value)
        leaf : Bool = child.leaf.load()
        branch leaf
            ? finalize()
            : move_child()

    block move_child()
        children : USize = child_count.add(1)
        child.children.shift_right(0, children)
        moved : @Me = left.children.getitem(left_count)
        child.children.setitem(0, moved)
        jump finalize()

    block finalize()
        left.count.store(left_count.sub(1))
        child.count.store(child_count.add(1))
        left.recount()
        child.recount()
        me.recount()
        return()

/// Rotates one entry from child `i + 1` through the parent into the end of child `i`, so child `i` gains an entry. Subtree counts are updated.
/// :param i: The index of the child that is short of keys.
routine SortedDictNode<TKey, TValue>.borrow_from_right(me: @Me, i: USize) -> Void
require TKey: typename, TValue: typename
    shared child       : @Me   = me.children.getitem(i)
    shared right       : @Me   = me.children.getitem(i.add(1))
    shared child_count : USize = child.count.load()
    shared right_count : USize = right.count.load()

    block entry()
        pivot_key   : TKey   = me.keys.getitem(i)
        pivot_value : TValue = me.values.getitem(i)
        child.keys.setitem(child_count, pivot_key)
        child.values.setitem(child_count, pivot_value)
        new_pivot_key   : TKey   = right.keys.getitem(0)
        new_pivot_value : TValue = right.values.getitem(0)
        me.keys.setitem(i, new_pivot_key)
        me.values.setitem(i, new_pivot_value)
        right.keys.shift_left(0, right_count)
        right.values.shift_left(0, right_count)
        leaf : Bool = child.leaf.load()
        branch leaf
            ? finalize()
            : move_child()

    block move_child()
        moved : @Me = right.children.getitem(0)
        child.children.setitem(child_count.add(1), moved)
        right.children.shift_left(0, right_count.add(1))
        jump finalize()

    block finalize()
        child.count.store(child_count.add(1))
        right.count.store(right_count.sub(1))
        child.recount()
        right.recount()
        me.recount()
        return()

/// Merges child `i + 1` and the separating entry into child `i` and frees the emptied node, shrinking this node by one key.
/// :param i: The index of the left child of the pair.
/// :param alloc: The allocator that frees the merged node.
routine SortedDictNode<TKey, TValue>.merge_children(me: @Me, i: USize, alloc: @Allocator) -> Void
require TKey: typename, TValue: typename
    shared left        : @Me   = me.children.getitem(i)
    shared right       : @Me   = me.children.getitem(i.add(1))
    shared left_count  : USize = left.count.load()
    shared right_count : USize = right.count.load()

    block entry()
        pivot_key   : TKey   = me.keys.getitem(i)
        pivot_value : TValue = me.values.getitem(i)
        left.keys.setitem(left_count, pivot_key)
        left.values.setitem(left_count, pivot_value)
        dst_start : USize = left_count.add(1)
        left.keys.copy(dst_start, right.keys, 0, right_count)
        left.values.copy(dst_start, right.values, 0, right_count)
        leaf : Bool = left.leaf.load()
        branch leaf
            ? finalize()
            : copy_children()

    block copy_children()
        left.children.copy(left_count.add(1), right.children, 0, right_count.add(1))
        jump finalize()

    block finalize()
        left.count.store(left_count.add(1).add(right_count))
        parent_count : USize = me.count.load()
        me.keys.shift_left(i, parent_count)
        me.values.shift_left(i, parent_count)
        me.children.shift_left(i.add(1), parent_count.add(1))
        me.count.store(parent_count.sub(1))
        deallocate<Me>(right, alloc)
        left.recount()
        me.recount()
        return()

/// Makes sure child `i` has at least `NODE_MIN_KEYS` keys before a deletion descends into it, by borrowing from a sibling or merging with one.
/// :param i: The index of the child about to be descended into.
/// :param alloc: The allocator that frees a merged node.
/// :returns: The index of the child to descend into, which differs from `i` when a merge with the left sibling happened.
#track_caller
routine SortedDictNode<TKey, TValue>.ensure_min(me: @Me, i: USize, alloc: @Allocator) -> USize
require TKey: typename, TValue: typename
    block entry()
        child       : @Me   = me.children.getitem(i)
        child_count : USize = child.count.load()
        ok          : Bool  = child_count.ge(NODE_MIN_KEYS)
        branch ok ? return(i): try_left()

    block try_left()
        has_left : Bool = i.gt(0)
        branch has_left
            ? check_left()
            : try_right(false)

    block check_left()
        left       : @Me   = me.children.getitem(i.sub(1))
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN_KEYS)
        branch left_ok
            ? do_borrow_left()
            : try_right(true)

    block do_borrow_left()
        me.borrow_from_left(i)
        return(i)

    block try_right(has_left: Bool)
        parent_count : USize = me.count.load()
        has_right    : Bool  = i.lt(parent_count)
        branch has_right
            ? check_right(has_left)
            : pick_merge_no_right(has_left)

    block check_right(has_left: Bool)
        right       : @Me   = me.children.getitem(i.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN_KEYS)
        branch right_ok
            ? do_borrow_right()
            : pick_merge(has_left)

    block do_borrow_right()
        me.borrow_from_right(i)
        return(i)

    block pick_merge(has_left: Bool)
        branch has_left
            ? merge_with_left()
            : merge_with_right()

    block pick_merge_no_right(has_left: Bool)
        branch has_left
            ? merge_with_left()
            : crash_logic_breached()

    block merge_with_left()
        merged_at : USize = i.sub(1)
        me.merge_children(merged_at, alloc)
        return(merged_at)

    block merge_with_right()
        me.merge_children(i, alloc)
        return(i)

/// Removes the entry with the largest key in this subtree, rebalancing children on the way down.
/// :param out_value: Receives the removed entry's value.
/// :param alloc: The allocator used when nodes merge.
/// :returns: The removed largest key.
routine SortedDictNode<TKey, TValue>.take_max_key(me: @Me, out_value: @TValue,
    alloc: @Allocator) -> TKey
require TKey: typename, TValue: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? leaf_take()
            : descend()

    block leaf_take()
        count : USize  = me.count.load()
        index : USize  = count.sub(1)
        key   : TKey   = me.keys.getitem(index)
        value : TValue = me.remove_leaf_at(index)
        out_value.store(value)
        return(key)

    block descend()
        count  : USize = me.count.load()
        actual : USize = me.ensure_min(count, alloc)
        child  : @Me   = me.children.getitem(actual)
        key    : TKey  = child.take_max_key(out_value, alloc)
        me.recount()
        return(key)

/// Removes the entry with the smallest key in this subtree, rebalancing children on the way down.
/// :param out_value: Receives the removed entry's value.
/// :param alloc: The allocator used when nodes merge.
/// :returns: The removed smallest key.
routine SortedDictNode<TKey, TValue>.take_min_key(me: @Me, out_value: @TValue,
    alloc: @Allocator) -> TKey
require TKey: typename, TValue: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? leaf_take()
            : descend()

    block leaf_take()
        key   : TKey   = me.keys.getitem(0)
        value : TValue = me.remove_leaf_at(0)
        out_value.store(value)
        return(key)

    block descend()
        actual : USize = me.ensure_min(0, alloc)
        child  : @Me   = me.children.getitem(actual)
        key    : TKey  = child.take_min_key(out_value, alloc)
        me.recount()
        return(key)

/// Removes the entry for `key` from this subtree, rebalancing children on the way down so no node underflows.
/// :param key: The key to remove.
/// :param alloc: The allocator used when nodes merge.
/// :returns: `true` when the key was found and removed, `false` otherwise.
routine SortedDictNode<TKey, TValue>.remove(me: @Me, key: TKey, alloc: @Allocator) -> Bool
require TKey: typename, TValue: typename
    shared slot : USize = me.find_index(key)

    block entry()
        count  : USize = me.count.load()
        inside : Bool  = slot.lt(count)
        branch inside
            ? maybe_match()
            : descend_or_missing()

    block maybe_match()
        node_key : TKey = me.keys.getitem(slot)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? remove_here()
            : descend_or_missing()

    block remove_here()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? remove_leaf()
            : remove_internal()

    block remove_leaf()
        me.remove_leaf_at(slot)
        return(true)

    block remove_internal()
        left       : @Me   = me.children.getitem(slot)
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN_KEYS)
        branch left_ok
            ? take_pred()
            : try_succ()

    block take_pred()
        claim out : @TValue <- uninit
        left              : @Me    = me.children.getitem(slot)
        replacement_key   : TKey   = left.take_max_key(out, alloc)
        replacement_value : TValue = out.load()
        me.keys.setitem(slot, replacement_key)
        me.values.setitem(slot, replacement_value)
        me.recount()
        return(true)

    block try_succ()
        right       : @Me   = me.children.getitem(slot.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN_KEYS)
        branch right_ok
            ? take_succ()
            : merge_and_recurse()

    block take_succ()
        claim out : @TValue <- uninit
        right             : @Me    = me.children.getitem(slot.add(1))
        replacement_key   : TKey   = right.take_min_key(out, alloc)
        replacement_value : TValue = out.load()
        me.keys.setitem(slot, replacement_key)
        me.values.setitem(slot, replacement_value)
        me.recount()
        return(true)

    block merge_and_recurse()
        me.merge_children(slot, alloc)
        merged  : @Me  = me.children.getitem(slot)
        removed : Bool = merged.remove(key, alloc)
        me.recount()
        return(removed)

    block descend_or_missing()
        leaf : Bool = me.leaf.load()
        branch leaf ? return(false): descend()

    block descend()
        actual  : USize = me.ensure_min(slot, alloc)
        child   : @Me   = me.children.getitem(actual)
        removed : Bool  = child.remove(key, alloc)
        me.recount()
        return(removed)

/// Removes the entry for `key`, shrinking the tree when the root empties.
/// :param key: The key to remove.
/// :returns: `true` when an entry was removed, `false` when the key was not present.
routine SortedDict<TKey, TValue>.remove(me: @Me, key: TKey) -> Bool
require TKey: typename, TValue: typename
    shared root : @SortedDictNode<TKey, TValue> = me.root.load()

    block entry()
        empty : Bool = root.is_null()
        branch empty
            ? return(false)
            : remove_root()

    block remove_root()
        alloc   : @Allocator = me.alloc.load()
        removed : Bool       = root.remove(key, alloc)
        branch removed
            ? after_remove()
            : return(false)

    block after_remove()
        remaining_count : USize = me.count.load().sub(1)
        remaining_count.store_into(me.count)
        root_count : USize = root.count.load()
        empty_root : Bool  = root_count.eq(0)
        branch empty_root
            ? maybe_shrink()
            : return(true)

    block maybe_shrink()
        leaf : Bool = root.leaf.load()
        branch leaf
            ? clear_root()
            : shrink()

    block clear_root()
        alloc : @Allocator = me.alloc.load()
        deallocate<SortedDictNode<TKey, TValue>>(root, alloc)
        me.root.store(null)
        return(true)

    block shrink()
        alloc    : @Allocator                    = me.alloc.load()
        new_root : @SortedDictNode<TKey, TValue> = root.children.getitem(0)
        deallocate<SortedDictNode<TKey, TValue>>(root, alloc)
        me.root.store(new_root)
        return(true)

/// Frees this node and every node below it through `alloc`. An internal node has `count` keys and `count + 1`
/// children. The keys and values are not destructed.
/// :param alloc: The allocator the nodes came from.
routine SortedDictNode<TKey, TValue>.free_recursive(me: @Me, alloc: @Allocator) -> Void
require TKey: typename, TValue: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? free_self()
            : free_children()

    block free_children()
        count : USize = me.count.load()
        jump child_loop(0, count.add(1))

    block child_loop(i: USize, child_count: USize)
        done : Bool = i.ge(child_count)
        branch done
            ? free_self()
            : free_child(i, child_count)

    block free_child(i: USize, child_count: USize)
        child : @Me = me.children.getitem(i)
        child.free_recursive(alloc)
        jump child_loop(i.add(1), child_count)

    block free_self()
        deallocate<Me>(me, alloc)
        return()

/// Frees the dict's memory through its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine SortedDict<TKey, TValue>.destruct(me: @Me) -> Void
require TKey: typename, TValue: typename
    shared root : @SortedDictNode<TKey, TValue> = me.root.load()

    block entry()
        empty : Bool = root.is_null()
        branch empty
            ? reset()
            : free_root()

    block free_root()
        alloc : @Allocator = me.alloc.load()
        root.free_recursive(alloc)
        jump reset()

    block reset()
        me.root.store(null)
        me.count.store(0)
        return()

/// Destructs every key and value, then the dictionary itself.
#track_caller
routine SortedDict<TKey, TValue>.destruct_all(me: @Me) -> Void
require TKey: typename, TValue: typename, Destructible<TKey>, Destructible<TValue>
    shared iter_val   : SortedDictIter<TKey, TValue>  = .construct(me)
    shared iter       : @SortedDictIter<TKey, TValue> <- iter_val
    shared key_slot   : @TKey                         <- uninit
    shared value_slot : @TValue                       <- uninit

    block entry()
        jump next()

    block next()
        item : Option<KVPair<TKey, TValue>> = iter.next()
        when item
            .Present(entry) -> entry_found(entry)
            .Absent         -> finish()

    block entry_found(entry: KVPair<TKey, TValue>)
        key_slot.store(entry.key)
        key_slot.destruct()
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

/// Destructs every value (the keys own nothing), then the dictionary itself.
#track_caller
routine SortedDict<TKey, TValue>.destruct_all_values(me: @Me) -> Void
require TKey: typename, TValue: typename, Destructible<TValue>
    shared iter_val   : SortedDictIter<TKey, TValue>  = .construct(me)
    shared iter       : @SortedDictIter<TKey, TValue> <- iter_val
    shared value_slot : @TValue                       <- uninit

    block entry()
        jump next()

    block next()
        item : Option<KVPair<TKey, TValue>> = iter.next()
        when item
            .Present(entry) -> entry_found(entry)
            .Absent         -> finish()

    block entry_found(entry: KVPair<TKey, TValue>)
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The entries in key order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine SortedDict<TKey, TValue>.represent_into<TWriter>(me: Me, out: @TWriter) -> Void
require TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : SortedDictIter<TKey, TValue> = .construct(whole)
        claim iter : @SortedDictIter<TKey, TValue> <- iter_val
        diagnose_entries<TKey, TValue, SortedDictIter<TKey, TValue>, TWriter>(out, iter)
        return()

/// The entries in key order, keys and values diagnosed: {"a": 1, "b": 2}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine SortedDict<TKey, TValue>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : SortedDictIter<TKey, TValue> = .construct(whole)
        claim iter : @SortedDictIter<TKey, TValue> <- iter_val
        diagnose_entries<TKey, TValue, SortedDictIter<TKey, TValue>, TWriter>(out, iter)
        return()
