// Tessera stdlib collection: ListIter<T>
//
// Forward iterator over List<T>.  Borrows the list — the list must outlive the
// iterator.  next() returns Option<T>.Absent after the last element.
//
// Satisfies concept Iterator<T, ListIter<T>>.

module Standard::Collections

/// A forward iterator over a {List<T>}. It borrows the list, so the list must outlive the iterator and must not change while it is walked.
/// :typeparam T: The element type.
record ListIter<T>
conform Iterator<T, ListIter<T>>
require T: typename
    list  : @List<T>
    index : USize

/// Creates an iterator positioned before the first element of `list`.
/// :param list: The list to walk.
/// :returns: A new iterator at index `0`.
routine ListIter<T>.construct(list: @List<T>) -> Self
require T: typename
    block entry()
        iter : Self = Self { list: list, index: 0 }
        return(iter)

/// Yields the next element and advances the iterator.
/// :returns: The next element, front to back.
/// :absent: After the last element has been yielded.
routine ListIter<T>.next(self: @Self) -> Option<T>
require T: typename
    block entry()
        list  : @List<T> = self.list.load()
        len   : USize    = list.load().count()
        index : USize    = self.index.load()
        done  : Bool     = index.ge(len)
        branch done
            ? return_none()
            : return_some(index, list)

    block return_none()
        none : Option<T> = .Absent
        return(none)

    block return_some(index: USize, list: @List<T>)
        value : T = list.load().get(index)
        self.index.store(index.add(1))
        some : Option<T> = .Present(value)
        return(some)
