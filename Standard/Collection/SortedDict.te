# Tessera stdlib collection: SortedDict[TKey, TValue]
#
# Order-statistic B-tree map with a fixed node key capacity of SORTED_DICT_NODE_KEYS.
# Nodes store keys/values/children inline with fixed arrays.
# The allocator is stored in SortedDict. Node helpers still receive it as a parameter.

module Standard/Collections

import Standard/Alloc
import Standard/Format

private preset SORTED_DICT_NODE_KEYS: USize = 7
private preset SORTED_DICT_NODE_CHILDREN: USize = SORTED_DICT_NODE_KEYS.add(1)
private preset SORTED_DICT_NODE_MIN_KEYS: USize = SORTED_DICT_NODE_KEYS.add(1).div_trunc(2)

### One node of a {SortedDict[TKey, TValue]} B-tree: up to `SORTED_DICT_NODE_KEYS` keys and values inline, and for internal nodes the child pointers between them. `subtree_count` is the total entries in the subtree. It is an entity, so an entity key or value can live in it: the dict makes and frees nodes, and its keys and values move in and out with steal.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
entity SortedDictNode[TKey, TValue]
needs TKey: typename, TValue: typename, Comparable[TKey]
    leaf: Bool
    count: USize
    subtree_count: USize
    keys: Array[TKey, SORTED_DICT_NODE_KEYS]
    values: Array[TValue, SORTED_DICT_NODE_KEYS]
    children: Array[@SortedDictNode[TKey, TValue], SORTED_DICT_NODE_CHILDREN]

### A map kept in ascending key order, stored as an order-statistic B-tree. Keys are unique, lookup and insertion are `O(log n)`, and iteration is in ascending key order.
### :typeparam TKey: The key type, ordered by its `Comparable` conformance.
### :typeparam TValue: The value type.
entity SortedDict[TKey, TValue]
obeys Destructible[SortedDict[TKey, TValue]]
obeys Representable[SortedDict[TKey, TValue]] when TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue]
obeys Diagnosable[SortedDict[TKey, TValue]] when TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue]
obeys Equatable[SortedDict[TKey, TValue]] when TKey: typename, TValue: typename, Equatable[TValue]
needs TKey: typename, TValue: typename, Comparable[TKey]
    root: @SortedDictNode[TKey, TValue]
    count: USize
    alloc: @MemoryManager

### Where an entry lives: its node and its index there.
private record SortedDictSpot[TKey, TValue]
needs TKey: typename, TValue: typename
    node: @SortedDictNode[TKey, TValue]
    index: USize

### Releases nothing: the dict ends a node's keys and values and frees the node itself (`free_recursive`).
routine SortedDictNode[TKey, TValue].destruct(me: @Me) -> None
needs TKey: typename, TValue: typename
    return

### Makes a `SortedDictSpot` from its fields.
### :param node: Its `node`.
### :param index: Its `index`.
### :returns: The new value.
private routine SortedDictSpot[TKey, TValue].construct(node: @SortedDictNode[TKey, TValue],
    index: USize) -> Me
needs TKey: typename, TValue: typename, Comparable[TKey]
    return Me(node, index)

### Releases nothing: a `SortedDictSpot` holds no memory of its own.
private routine SortedDictSpot[TKey, TValue].destruct(me: @Me) -> None
needs TKey: typename, TValue: typename, Comparable[TKey]
    return

### Creates an empty SortedDict that draws its storage from `alloc`. Nothing is allocated until the first insertion.
### :param alloc: The allocator the dict stores and later frees its memory with.
### :returns: A new empty SortedDict.
routine SortedDict[TKey, TValue].construct(alloc: @MemoryManager) -> Me
needs TKey: typename, TValue: typename
    return Me(root: null, count: 0, alloc: alloc)

### The number of entries currently stored.
### :returns: The count of entries, `0` when the dict is empty.
routine SortedDict[TKey, TValue].count(me: @Me) -> USize
needs TKey: typename, TValue: typename
    count: USize = me.count.peek()
    return count

### Whether the dict holds no entries.
### :returns: `true` when the count is `0`.
routine SortedDict[TKey, TValue].is_empty(me: @Me) -> Bool
needs TKey: typename, TValue: typename
    count: USize = me.count.peek()
    return count == 0

### A new empty node from `alloc`.
### :param leaf: Whether the node is a leaf.
### :param alloc: The allocator to take the node from.
### :returns: The node, or null when the allocator fails.
routine SortedDictNode[TKey, TValue].construct(leaf: Bool, alloc: @MemoryManager) -> @Me
needs TKey: typename, TValue: typename
    local node: @Me = allocate[Me](count: 1, alloc)

    if node.is_null()
        return node
    else
        node.leaf.poke(leaf)
        node.count.poke(0)
        node.subtree_count.poke(0)
        return node

### The number of entries in the subtree below this node.
### :returns: The node's subtree count, or `0` for a null node.
routine SortedDictNode[TKey, TValue].subtree_count(me: @Me) -> USize
needs TKey: typename, TValue: typename
    if me.is_null()
        return 0
    else
        count: USize = me.subtree_count.peek()
        return count

### Recomputes this node's subtree count from its own keys and its children's counts. Call it after the node's contents change.
routine SortedDictNode[TKey, TValue].recount(me: @Me) -> None
needs TKey: typename, TValue: typename
    local leaf: Bool = me.leaf.peek()
    local count: USize = me.count.peek()
    local sum: @USize <- .hollow()

    if leaf
        me.subtree_count.poke(count)
        return
    else
        0.poke_into(sum)

        each i in 0 to count
            child: @Me = me.children[i]
            child_count: USize = child.subtree_count()
            with_child: USize = sum.peek() + child_count
            has_key: Bool = i < count
            next_sum: USize = when
                has_key => with_child + 1
                else => with_child
            next_sum.poke_into(sum)
        me.subtree_count.poke(sum.peek())
        return

### Finds where the key at `key` sits among this node's keys, compared through their places.
### :param key: The key to locate.
### :returns: The index of the first key not less than `key`, or the key count when every key is smaller. It is also the child to descend into.
routine SortedDictNode[TKey, TValue].find_index(me: @Me, key: @TKey) -> USize
needs TKey: typename, TValue: typename
    while i < me.count.peek() with i: USize = 0
        cmp: S32 = key.compare(me.keys.getslot(i))
        if cmp <= 0
            return i
        else
            continue with i: i + 1
    then
        return i

### Where the entry with a key equal to the one at `key` lives, compared through the places.
### :param key: The key to look for.
### :returns: The entry's node and its index there.
### :absent: When the key is not present.
private routine SortedDict[TKey, TValue].find_spot(me: @Me,
    key: @TKey) -> Maybe[SortedDictSpot[TKey, TValue]]
needs TKey: typename, TValue: typename
    root: @SortedDictNode[TKey, TValue] = me.root.peek()
    if root.is_null()
        return None()

    while true with node: @SortedDictNode[TKey, TValue] = root
        i: USize = node.find_index(key)
        count: USize = node.count.peek()
        if i < count
            if key.compare(node.keys.getslot(i)) == 0
                return SortedDictSpot[TKey, TValue](node: node, index: i)
        if node.leaf.peek()
            return None()
        else
            continue with node: node.children[i]

### Reads the value stored under the key at `key`, read through its place.
### :param key: The key to look up.
### :returns: A copy of the value.
### :throws: Crashes with `KeyNotFoundError` when the key is absent. See {SortedDict[TKey, TValue].getitem_checked}.
@track_caller
routine SortedDict[TKey, TValue].getitem(me: @Me, key: @TKey) -> TValue
needs TKey: typename, TValue: typename
    at: @TValue = me.getslot(key)
    return at.peek()

### Reads the value stored under `key`.
### :param key: The key to look up.
### :returns: A copy of the value.
### :throws: Crashes with `KeyNotFoundError` when the key is absent. See {SortedDict[TKey, TValue].getitem_checked}.
@track_caller
routine SortedDict[TKey, TValue].getitem(me: @Me, key: TKey) -> TValue
needs TKey: typename, TValue: typename
    at: @TValue = me.getslot(steal key)
    return at.peek()

### `getitem`, returning None instead of crashing on a missing key.
### :param key: The key to look up, read through its place.
### :returns: A copy of the value.
### :absent: When the key is not present.
routine SortedDict[TKey, TValue].getitem_checked(me: @Me, key: @TKey) -> Maybe[TValue]
needs TKey: typename, TValue: typename
    when me.getslot_checked(key)
        is @TValue as at =>
            value: TValue = at.peek()
            return value
        is None => return None()

### `getitem`, returning None instead of crashing on a missing key.
### :param key: The key to look up.
### :returns: A copy of the value.
### :absent: When the key is not present.
routine SortedDict[TKey, TValue].getitem_checked(me: @Me, key: TKey) -> Maybe[TValue]
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    found: Maybe[TValue] = me.getitem_checked(probe)

    drop probe
    return found

### The address of the value under the key at `key`, checked like getitem: a place to update the value in place.
### Only the value: changing a key in place would break the order. It stays valid until the dict changes shape or is
### destructed.
### :param key: The key to look up, read through its place.
### :returns: The value's address.
### :throws: Crashes with `KeyNotFoundError` when the key is absent.
@track_caller
routine SortedDict[TKey, TValue].getslot(me: @Me, key: @TKey) -> @TValue
needs TKey: typename, TValue: typename
    found: Maybe[@TValue] = me.getslot_checked(key)
    when found
        is @TValue as value => return value
        is None => crash_key_not_found()

### The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
### value: changing a key in place would break the order. It stays valid until the dict changes shape or is
### destructed.
### :param key: The key to look up.
### :returns: The value's address.
### :throws: Crashes with `KeyNotFoundError` when the key is absent.
@track_caller
routine SortedDict[TKey, TValue].getslot(me: @Me, key: TKey) -> @TValue
needs TKey: typename, TValue: typename
    found: Maybe[@TValue] = me.getslot_checked(steal key)
    when found
        is @TValue as value => return value
        is None => crash_key_not_found()

### `getslot`, returning None instead of crashing on a missing key.
### :param key: The key to look up, read through its place.
### :returns: The value's address.
### :absent: When the key is not present.
routine SortedDict[TKey, TValue].getslot_checked(me: @Me, key: @TKey) -> Maybe[@TValue]
needs TKey: typename, TValue: typename
    when me.find_spot(key)
        is SortedDictSpot[TKey, TValue] as spot =>
            node: @SortedDictNode[TKey, TValue] = spot.node
            value: @TValue = node.values.getslot(spot.index)
            return value
        is None => return None()

### `getslot`, returning None instead of crashing on a missing key.
### :param key: The key to look up.
### :returns: The value's address.
### :absent: When the key is not present.
routine SortedDict[TKey, TValue].getslot_checked(me: @Me, key: TKey) -> Maybe[@TValue]
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    found: Maybe[@TValue] = me.getslot_checked(probe)

    drop probe
    return found

### Whether two dicts hold the same key-value pairs. Both are sorted by key, so comparing the pairs in order is
### enough.
### :param other: The dict to compare with.
### :returns: True when the counts match and every pair has an equal key and an equal value.
routine SortedDict[TKey, TValue].eq(me: @Me, other: @Me) -> Bool
needs TKey: typename, TValue: typename, Equatable[TValue]
    return me.eq_at(other)

### `eq`, through pointers to the two dicts.
### :param other: The dict to compare with.
### :returns: True when the counts match and every pair has an equal key and an equal value.
private routine SortedDict[TKey, TValue].eq_at(me: @Me, other: @Me) -> Bool
needs TKey: typename, TValue: typename, Equatable[TValue]
    local a: @SortedDictIter[TKey, TValue] <- .hollow()
    local b: @SortedDictIter[TKey, TValue] <- .hollow()

    la: USize = me.count.peek()
    lb: USize = other.count.peek()
    if not (la == lb)
        return false
    a_val: SortedDictIter[TKey, TValue] = .construct(me)
    b_val: SortedDictIter[TKey, TValue] = .construct(other)
    a.poke(a_val)
    b.poke(b_val)

    # both have the same count, so both run out together
    while true
        x: Maybe[SortedDictSpot[TKey, TValue]] = a.next_spot()
        y: Maybe[SortedDictSpot[TKey, TValue]] = b.next_spot()
        when x
            is SortedDictSpot[TKey, TValue] as x_spot =>
                y_spot: SortedDictSpot[TKey, TValue] = y.unwrap()
                x_node: @SortedDictNode[TKey, TValue] = x_spot.node
                y_node: @SortedDictNode[TKey, TValue] = y_spot.node
                cmp: S32 = x_node.keys.getslot(x_spot.index).compare(y_node.keys.getslot(y_spot.index))
                if not (cmp == 0)
                    return false
                if x_node.values.getslot(x_spot.index).eq(y_node.values.getslot(y_spot.index))
                    continue
                else
                    return false
            is None => return true

### Whether the key at `key` is present, read through its place.
### :param key: The key to look for.
### :returns: `true` when an equal key is in the map.
routine SortedDict[TKey, TValue].has_key(me: @Me, key: @TKey) -> Bool
needs TKey: typename, TValue: typename
    when me.find_spot(key)
        is SortedDictSpot[TKey, TValue] => return true
        is None => return false

### Whether `key` is present.
### :param key: The key to look for.
### :returns: `true` when an equal key is in the map.
routine SortedDict[TKey, TValue].has_key(me: @Me, key: TKey) -> Bool
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    there: Bool = me.has_key(probe)

    drop probe
    return there

### Whether the key at `key` is not a key: the opposite of `has_key`.
### :param key: The key to look for.
### :returns: `true` when `has_key` would be `false`.
routine SortedDict[TKey, TValue].lacks_key(me: @Me, key: @TKey) -> Bool
needs TKey: typename, TValue: typename
    there: Bool = me.has_key(key)
    return not there

### Whether `key` is not a key: the opposite of `has_key`.
### :param key: The key to look for.
### :returns: `true` when `has_key` would be `false`.
routine SortedDict[TKey, TValue].lacks_key(me: @Me, key: TKey) -> Bool
needs TKey: typename, TValue: typename
    there: Bool = me.has_key(steal key)
    return not there

### The node and index of the `rank`-th smallest key.
### :param rank: The zero-based rank.
### :returns: The entry's node and its index there.
### :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
@track_caller
private routine SortedDict[TKey, TValue].locate_rank(me: @Me,
    rank: USize) -> SortedDictSpot[TKey, TValue]
needs TKey: typename, TValue: typename
    count: USize = me.count.peek()
    if rank >= count
        crash_out_of_bounds()

    while true with node: @SortedDictNode[TKey, TValue] = me.root.peek(), remaining: USize = rank, i: USize = 0
        node_count: USize = node.count.peek()
        is_leaf: Bool = node.leaf.peek()
        if i >= node_count
            if is_leaf
                crash_logic_breached()
            continue with node: node.children[i], remaining: remaining, i: 0
        if is_leaf
            if remaining == i
                return SortedDictSpot[TKey, TValue](node: node, index: i)
            continue with node: node, remaining: remaining, i: i + 1
        child: @SortedDictNode[TKey, TValue] = node.children[i]
        child_count: USize = child.subtree_count()
        if remaining < child_count
            continue with node: child, remaining: remaining, i: 0
        after_child: USize = remaining - child_count
        if after_child == 0
            return SortedDictSpot[TKey, TValue](node: node, index: i)
        continue with node: node, remaining: after_child - 1, i: i + 1

### The `rank`-th smallest key and its value, copied (0 is the smallest). A copy, because writing a key through a
### pointer would break the order.
### :param rank: The zero-based rank.
### :returns: The key and its value.
### :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedDict[TKey, TValue].get_by_rank(me: @Me, rank: USize) -> KVPair[TKey, TValue]
needs TKey: typename, TValue: typename
    spot: SortedDictSpot[TKey, TValue] = me.locate_rank(rank)
    node: @SortedDictNode[TKey, TValue] = spot.node
    key: TKey = node.keys[spot.index]
    value: TValue = node.values[spot.index]
    return KVPair[TKey, TValue](key: key, value: value)

### A pointer to the value of the `rank`-th smallest key, to change it in place. Valid until the next put or remove.
### :param rank: The zero-based rank.
### :returns: The value's address.
### :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
routine SortedDict[TKey, TValue].value_ptr_by_rank(me: @Me, rank: USize) -> @TValue
needs TKey: typename, TValue: typename
    spot: SortedDictSpot[TKey, TValue] = me.locate_rank(rank)
    node: @SortedDictNode[TKey, TValue] = spot.node
    value: @TValue = node.values.to[@TValue]().stride(spot.index)
    return value

### Splits the full child at `index` around its middle: the middle entry moves up into this node and the upper half
### into a new right sibling.
### :param index: The index of the full child.
### :param alloc: The allocator for the new node.
### :returns: True when it split, false when the allocator failed (before anything moved).
@reshaping
routine SortedDictNode[TKey, TValue].split_child(me: @Me, index: USize,
    alloc: @MemoryManager) -> Bool
needs TKey: typename, TValue: typename
    local left: @Me = me.children[index]
    local leaf: Bool = left.leaf.peek()
    local right: @Me = Me.construct(leaf, alloc)

    if right.is_null()
        return false
    mid: USize = SORTED_DICT_NODE_KEYS.div_trunc(2)
    right_start: USize = mid + 1
    right_count: USize = SORTED_DICT_NODE_KEYS.sub(right_start)
    right.keys.copy(dst_start: 0, src: left.keys, src_start: right_start, count: right_count)
    right.values.copy(dst_start: 0, src: left.values, src_start: right_start, count: right_count)
    right.count.poke(right_count)
    if leaf
        parent_count: USize = me.count.peek()
        me.keys.shift_right(start: index, end: parent_count)
        me.values.shift_right(start: index, end: parent_count)

        until i < index + 1 with i: USize = parent_count
            child: @Me = me.children[i]
            me.children[i + 1] = child
            continue with i: i - 1
        then
            me.keys.getslot(index).poke(steal left.keys.getslot(mid))
            me.values.getslot(index).poke(steal left.values.getslot(mid))
            me.children[index + 1] = right
            left.count.poke(mid)
            next_count: USize = me.count.peek() + 1
            next_count.poke_into(me.count)
            left.recount()
            right.recount()
            me.recount()
            return true
    else
        each i in 0 to right_count
            src: USize = mid + 1 + i
            child: @Me = left.children[src]
            right.children[i] = child
        then
            parent_count: USize = me.count.peek()
            me.keys.shift_right(start: index, end: parent_count)
            me.values.shift_right(start: index, end: parent_count)

            until i2 < index + 1 with i2: USize = parent_count
                child: @Me = me.children[i2]
                me.children[i2 + 1] = child
                continue with i2: i2 - 1
            then
                me.keys.getslot(index).poke(steal left.keys.getslot(mid))
                me.values.getslot(index).poke(steal left.values.getslot(mid))
                me.children[index + 1] = right
                left.count.poke(mid)
                next_count: USize = me.count.peek() + 1
                next_count.poke_into(me.count)
                left.recount()
                right.recount()
                me.recount()
                return true

### Inserts `key` and `value` below a node that isn't full, splitting full children on the way down. An equal key
### must not already be in the subtree (the caller replaces those first).
### :param key: The key to insert.
### :param value: The value to insert.
### :param alloc: The allocator for nodes made by splits.
### :returns: True when it inserted, false when a split failed to allocate (the key and value end then). The tree then
###     holds the same entries, some nodes already split.
@reshaping
routine SortedDictNode[TKey, TValue].insert_nonfull(me: @Me, key: TKey, value: TValue,
    alloc: @MemoryManager) -> Bool
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    if me.leaf.peek()
        slot: USize = me.find_index(key: probe)
        count: USize = me.count.peek()
        me.keys.shift_right(start: slot, end: count)
        me.values.shift_right(start: slot, end: count)
        me.keys.getslot(slot).poke(steal probe)
        me.values.getslot(slot).poke(steal value)
        new_count: USize = count + 1
        me.count.poke(new_count)
        me.subtree_count.poke(new_count)
        return true
    else
        slot: USize = me.find_index(key: probe)
        child: @Me = me.children[slot]
        child_count: USize = child.count.peek()
        full: Bool = child_count == SORTED_DICT_NODE_KEYS
        values2: (USize, @Me) = when
            full =>
                if not me.split_child(index: slot, alloc)
                    drop probe
                    drop value
                    return false
                cmp: S32 = probe.compare(me.keys.getslot(slot))
                go_right: Bool = cmp > 0
                next_slot: USize = when
                    go_right => slot + 1
                    else => slot
                becomes (next_slot, me.children[next_slot])
            else => (slot, child)
        slot2, child2 = values2
        if not child2.insert_nonfull(key: steal probe, value: steal value, alloc)
            return false
        me.recount()
        return true

### Stores `value` under `key`, inserting a new entry in sorted position or replacing the value of an equal existing key.
### :param key: The key to store under.
### :param value: The value to store.
### :throws: Crashes with `MemoryAllocationError` when a node cannot be allocated. See {SortedDict[TKey, TValue].setitem_result} for a recoverable form.
@track_caller
@reshaping
routine SortedDict[TKey, TValue].setitem(me: @Me, key: TKey, value: TValue) -> None
needs TKey: typename, TValue: typename
    put: Result[None, AllocFailed] = me.setitem_result(key: steal key, value: steal value)
    when put
        is None => return
        is AllocFailed => crash_allocation()

### `setitem`, returning an error instead of crashing when the allocator fails. A key already there keeps its place
### and the new key ends, the old value ends and the new one takes its place.
### :param key: The key to store under.
### :param value: The value to store.
### :returns: A value once the value is stored.
### :throws: Returns `AllocFailed` when a node cannot be allocated.
@reshaping
routine SortedDict[TKey, TValue].setitem_result(me: @Me, key: TKey,
    value: TValue) -> Result[None, AllocFailed]
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key
    local root: @SortedDictNode[TKey, TValue] = me.root.peek()

    when me.getslot_checked(probe)
        is @TValue as old =>
            drop probe
            drop old
            old.poke(steal value)
            return None()
        is None => pass
    if root.is_null()
        alloc: @MemoryManager = me.alloc.peek()
        first_node: @SortedDictNode[TKey, TValue] = SortedDictNode[TKey, TValue].construct(
            leaf: true, alloc)
        if first_node.is_null()
            drop probe
            drop value
            return AllocFailed()
        first_node.keys.getslot(0).poke(steal probe)
        first_node.values.getslot(0).poke(steal value)
        first_node.count.poke(1)
        first_node.subtree_count.poke(1)
        me.root.poke(first_node)
        me.count.poke(1)
        return None()
    else
        alloc: @MemoryManager = me.alloc.peek()
        root_count: USize = root.count.peek()
        full: Bool = root_count == SORTED_DICT_NODE_KEYS
        root_node: @SortedDictNode[TKey, TValue] = when
            full =>
                new_root: @SortedDictNode[TKey, TValue] = SortedDictNode[TKey, TValue].construct(
                    leaf: false, alloc)
                if new_root.is_null()
                    drop probe
                    drop value
                    return AllocFailed()
                new_root.children[0] = root
                if new_root.split_child(index: 0, alloc)
                    me.root.poke(new_root)
                    becomes new_root
                else
                    deallocate[SortedDictNode[TKey, TValue]](data: new_root, alloc)
                    drop probe
                    drop value
                    return AllocFailed()
            else => root
        if not root_node.insert_nonfull(key: steal probe, value: steal value, alloc)
            return AllocFailed()
        next_count: USize = me.count.peek() + 1
        next_count.poke_into(me.count)
        return None()

### Removes the key and value at `index` from a leaf by shifting the later entries left. The key must already be
### taken out (or ended).
### :param index: The position of the entry within the leaf.
### :returns: The removed value.
routine SortedDictNode[TKey, TValue].remove_leaf_at(me: @Me, index: USize) -> TValue
needs TKey: typename, TValue: typename
    local old: @TValue <- steal me.values.getslot(index)

    count: USize = me.count.peek()
    me.keys.shift_left(start: index, end: count)
    me.values.shift_left(start: index, end: count)
    new_count: USize = count - 1
    me.count.poke(new_count)
    me.subtree_count.poke(new_count)
    return steal old

# Capacity = SORTED_DICT_NODE_KEYS, t = SORTED_DICT_NODE_MIN_KEYS. Non-root nodes maintain
# count >= SORTED_DICT_NODE_MIN_KEYS - 1.
# Helpers below ensure a child has count >= SORTED_DICT_NODE_MIN_KEYS (= t) before any deletion
# descent so the child can absorb a one-key drop without underflowing.

### Rotates one entry from child `i - 1` through the parent into the front of child `i`, so child `i` gains an entry. Subtree counts are updated.
### :param i: The index of the child that is short of keys.
routine SortedDictNode[TKey, TValue].borrow_from_left(me: @Me, i: USize) -> None
needs TKey: typename, TValue: typename
    local separator: USize = i - 1
    local left: @Me = me.children[separator]
    local child: @Me = me.children[i]
    local left_count: USize = left.count.peek()
    local child_count: USize = child.count.peek()

    child.keys.shift_right(start: 0, end: child_count)
    child.values.shift_right(start: 0, end: child_count)
    child.keys.getslot(0).poke(steal me.keys.getslot(separator))
    child.values.getslot(0).poke(steal me.values.getslot(separator))
    me.keys.getslot(separator).poke(steal left.keys.getslot(left_count - 1))
    me.values.getslot(separator).poke(steal left.values.getslot(left_count - 1))
    if not child.leaf.peek()
        children: USize = child_count + 1
        child.children.shift_right(start: 0, end: children)
        moved: @Me = left.children[left_count]
        child.children[0] = moved
    left.count.poke(left_count - 1)
    child.count.poke(child_count + 1)
    left.recount()
    child.recount()
    me.recount()
    return

### Rotates one entry from child `i + 1` through the parent into the end of child `i`, so child `i` gains an entry. Subtree counts are updated.
### :param i: The index of the child that is short of keys.
routine SortedDictNode[TKey, TValue].borrow_from_right(me: @Me, i: USize) -> None
needs TKey: typename, TValue: typename
    local child: @Me = me.children[i]
    local right: @Me = me.children[i + 1]
    local child_count: USize = child.count.peek()
    local right_count: USize = right.count.peek()

    child.keys.getslot(child_count).poke(steal me.keys.getslot(i))
    child.values.getslot(child_count).poke(steal me.values.getslot(i))
    me.keys.getslot(i).poke(steal right.keys.getslot(0))
    me.values.getslot(i).poke(steal right.values.getslot(0))
    right.keys.shift_left(start: 0, end: right_count)
    right.values.shift_left(start: 0, end: right_count)
    if not child.leaf.peek()
        moved: @Me = right.children[0]
        child.children[child_count + 1] = moved
        right.children.shift_left(start: 0, end: right_count + 1)
    child.count.poke(child_count + 1)
    right.count.poke(right_count - 1)
    child.recount()
    right.recount()
    me.recount()
    return

### Merges child `i + 1` and the separating entry into child `i` and frees the emptied node, shrinking this node by one key.
### :param i: The index of the left child of the pair.
### :param alloc: The allocator that frees the merged node.
routine SortedDictNode[TKey, TValue].merge_children(me: @Me, i: USize,
    alloc: @MemoryManager) -> None
needs TKey: typename, TValue: typename
    local left: @Me = me.children[i]
    local right: @Me = me.children[i + 1]
    local left_count: USize = left.count.peek()
    local right_count: USize = right.count.peek()

    left.keys.getslot(left_count).poke(steal me.keys.getslot(i))
    left.values.getslot(left_count).poke(steal me.values.getslot(i))
    dst_start: USize = left_count + 1
    left.keys.copy(dst_start, src: right.keys, src_start: 0, count: right_count)
    left.values.copy(dst_start, src: right.values, src_start: 0, count: right_count)
    if not left.leaf.peek()
        left.children.copy(dst_start: left_count + 1, src: right.children, src_start: 0,
            count: right_count + 1)
    left.count.poke(left_count + 1 + right_count)
    parent_count: USize = me.count.peek()
    me.keys.shift_left(start: i, end: parent_count)
    me.values.shift_left(start: i, end: parent_count)
    me.children.shift_left(start: i + 1, end: parent_count + 1)
    me.count.poke(parent_count - 1)
    deallocate[Me](data: right, alloc)
    left.recount()
    me.recount()
    return

### Makes sure child `i` has at least `SORTED_DICT_NODE_MIN_KEYS` keys before a deletion descends into it, by borrowing from a sibling or merging with one.
### :param i: The index of the child about to be descended into.
### :param alloc: The allocator that frees a merged node.
### :returns: The index of the child to descend into, which differs from `i` when a merge with the left sibling happened.
@track_caller
routine SortedDictNode[TKey, TValue].ensure_min(me: @Me, i: USize, alloc: @MemoryManager) -> USize
needs TKey: typename, TValue: typename
    child: @Me = me.children[i]
    child_count: USize = child.count.peek()
    if child_count >= SORTED_DICT_NODE_MIN_KEYS
        return i
    else
        has_left: Bool = i > 0
        has_left2: Bool = when
            has_left =>
                left: @Me = me.children[i - 1]
                left_count: USize = left.count.peek()
                if left_count >= SORTED_DICT_NODE_MIN_KEYS
                    me.borrow_from_left(i)
                    return i
                else
                    becomes true
            else => false
        parent_count: USize = me.count.peek()
        if i < parent_count
            right: @Me = me.children[i + 1]
            right_count: USize = right.count.peek()
            if right_count >= SORTED_DICT_NODE_MIN_KEYS
                me.borrow_from_right(i)
                return i
            else if not has_left2
                me.merge_children(i, alloc)
                return i
        else if not has_left2
            crash_logic_breached()
        merged_at: USize = i - 1
        me.merge_children(i: merged_at, alloc)
        return merged_at

### Removes the entry with the largest key in this subtree, rebalancing children on the way down.
### :param out_value: Receives the removed entry's value.
### :param alloc: The allocator used when nodes merge.
### :returns: The removed largest key.
routine SortedDictNode[TKey, TValue].take_max_key(me: @Me, out_value: @TValue,
    alloc: @MemoryManager) -> TKey
needs TKey: typename, TValue: typename
    if me.leaf.peek()
        count: USize = me.count.peek()
        index: USize = count - 1
        local key: @TKey <- steal me.keys.getslot(index)
        out_value.poke(me.remove_leaf_at(index))
        return steal key
    else
        count: USize = me.count.peek()
        actual: USize = me.ensure_min(i: count, alloc)
        child: @Me = me.children[actual]
        local key: @TKey <- child.take_max_key(out_value, alloc)
        me.recount()
        return steal key

### Removes the entry with the smallest key in this subtree, rebalancing children on the way down.
### :param out_value: Receives the removed entry's value.
### :param alloc: The allocator used when nodes merge.
### :returns: The removed smallest key.
routine SortedDictNode[TKey, TValue].take_min_key(me: @Me, out_value: @TValue,
    alloc: @MemoryManager) -> TKey
needs TKey: typename, TValue: typename
    if me.leaf.peek()
        local key: @TKey <- steal me.keys.getslot(0)
        out_value.poke(me.remove_leaf_at(0))
        return steal key
    else
        actual: USize = me.ensure_min(i: 0, alloc)
        child: @Me = me.children[actual]
        local key: @TKey <- child.take_min_key(out_value, alloc)
        me.recount()
        return steal key

### Removes the entry for the key at `key` from this subtree and ends its key and value, rebalancing children on the
### way down so no node underflows.
### :param key: The key to remove, read through its place.
### :param alloc: The allocator used when nodes merge.
### :returns: `true` when the key was found and removed, `false` otherwise.
routine SortedDictNode[TKey, TValue].remove(me: @Me, key: @TKey, alloc: @MemoryManager) -> Bool
needs TKey: typename, TValue: typename
    local slot: USize = me.find_index(key)

    count: USize = me.count.peek()
    if slot < count
        cmp: S32 = key.compare(me.keys.getslot(slot))
        if cmp == 0
            if me.leaf.peek()
                drop me.keys.getslot(slot)
                drop me.remove_leaf_at(slot)
                return true
            else
                left: @Me = me.children[slot]
                left_count: USize = left.count.peek()
                if left_count >= SORTED_DICT_NODE_MIN_KEYS
                    local out: @TValue <- .hollow()
                    left2: @Me = me.children[slot]
                    local replacement: @TKey <- left2.take_max_key(out_value: out, alloc)
                    drop me.keys.getslot(slot)
                    drop me.values.getslot(slot)
                    me.keys.getslot(slot).poke(steal replacement)
                    me.values.getslot(slot).poke(steal out)
                    me.recount()
                    return true
                else
                    right: @Me = me.children[slot + 1]
                    right_count: USize = right.count.peek()
                    if right_count >= SORTED_DICT_NODE_MIN_KEYS
                        local out: @TValue <- .hollow()
                        right2: @Me = me.children[slot + 1]
                        local replacement: @TKey <- right2.take_min_key(out_value: out, alloc)
                        drop me.keys.getslot(slot)
                        drop me.values.getslot(slot)
                        me.keys.getslot(slot).poke(steal replacement)
                        me.values.getslot(slot).poke(steal out)
                        me.recount()
                        return true
                    else
                        me.merge_children(i: slot, alloc)
                        merged: @Me = me.children[slot]
                        removed: Bool = merged.remove(key, alloc)
                        me.recount()
                        return removed
    if me.leaf.peek()
        return false
    else
        actual: USize = me.ensure_min(i: slot, alloc)
        child: @Me = me.children[actual]
        removed: Bool = child.remove(key, alloc)
        me.recount()
        return removed

### Removes the entry for the key at `key` and ends its key and value, shrinking the tree when the root empties.
### :param key: The key to remove, read through its place.
### :returns: `true` when an entry was removed, `false` when the key was not present.
@reshaping
routine SortedDict[TKey, TValue].remove(me: @Me, key: @TKey) -> Bool
needs TKey: typename, TValue: typename
    local root: @SortedDictNode[TKey, TValue] = me.root.peek()

    if root.is_null()
        return false
    else
        alloc: @MemoryManager = me.alloc.peek()
        if root.remove(key, alloc)
            remaining_count: USize = me.count.peek() - 1
            remaining_count.poke_into(me.count)
            root_count: USize = root.count.peek()
            if root_count == 0
                if root.leaf.peek()
                    alloc2: @MemoryManager = me.alloc.peek()
                    deallocate[SortedDictNode[TKey, TValue]](data: root, alloc: alloc2)
                    me.root.poke(null)
                    return true
                else
                    alloc2: @MemoryManager = me.alloc.peek()
                    new_root: @SortedDictNode[TKey, TValue] = root.children[0]
                    deallocate[SortedDictNode[TKey, TValue]](data: root, alloc: alloc2)
                    me.root.poke(new_root)
                    return true
            else
                return true
        else
            return false

### Removes the entry for `key` and ends its key and value, and `key` too.
### :param key: The key to remove.
### :returns: `true` when an entry was removed, `false` when the key was not present.
@reshaping
routine SortedDict[TKey, TValue].remove(me: @Me, key: TKey) -> Bool
needs TKey: typename, TValue: typename
    local probe: @TKey <- steal key

    removed: Bool = me.remove(probe)

    drop probe
    return removed

### Ends the keys and values of this node and every node below it (drop) and frees the nodes through `alloc`. An
### internal node has `count` keys and `count + 1` children.
### :param alloc: The allocator the nodes came from.
routine SortedDictNode[TKey, TValue].free_recursive(me: @Me, alloc: @MemoryManager) -> None
needs TKey: typename, TValue: typename
    each i in 0 til me.count.peek()
        drop me.keys.getslot(i)
        drop me.values.getslot(i)
    if me.leaf.peek()
        deallocate[Me](data: me, alloc)
        return
    else
        count: USize = me.count.peek()

        child_count: USize = count + 1

        each i in 0 til child_count
            child: @Me = me.children[i]
            child.free_recursive(alloc)
        then
            deallocate[Me](data: me, alloc)
            return

### Ends every key and value (drop), frees the dict's memory through its allocator, and resets it to the empty state, so it can be reused or destructed again.
### :note: Safe to call on a never-filled instance, where it only resets the fields.
@track_caller
routine SortedDict[TKey, TValue].destruct(me: @Me) -> None
needs TKey: typename, TValue: typename
    local root: @SortedDictNode[TKey, TValue] = me.root.peek()

    if not root.is_null()
        alloc: @MemoryManager = me.alloc.peek()
        root.free_recursive(alloc)
    me.root.poke(null)
    me.count.poke(0)
    return

# -- text -----------------------------------------------------------------------

### The entries in key order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine SortedDict[TKey, TValue].represent_into[TWriter](me: @Me, out: @TWriter) -> None
needs TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue], TWriter: typename, Writer[TWriter]
    me.write_entries(out)
    return

### The entries in key order, keys and values diagnosed: {"a": 1, "b": 2}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine SortedDict[TKey, TValue].diagnose_into[TWriter](me: @Me, out: @TWriter) -> None
needs TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue], TWriter: typename, Writer[TWriter]
    me.write_entries(out)
    return

### Writes {key: value, ...} in key order, each key and value diagnosed through its place.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
private routine SortedDict[TKey, TValue].write_entries[TWriter](me: @Me, out: @TWriter) -> None
needs TKey: typename, TValue: typename, Diagnosable[TKey], Diagnosable[TValue], TWriter: typename, Writer[TWriter]
    iter_val: SortedDictIter[TKey, TValue] = .construct(me)
    local iter: @SortedDictIter[TKey, TValue] <- iter_val

    write_str(out, text: "{")
    while true with first: Bool = true
        when iter.next_spot()
            is SortedDictSpot[TKey, TValue] as spot =>
                if not first
                    write_str(out, text: ", ")
                node: @SortedDictNode[TKey, TValue] = spot.node
                node.keys.getslot(spot.index).diagnose_into(out)
                write_str(out, text: ": ")
                node.values.getslot(spot.index).diagnose_into(out)
                continue with first: false
            is None => break
    write_str(out, text: "}")
    return
