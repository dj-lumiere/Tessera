// Tessera stdlib collection: Dict<TKey, TValue>
//
// Insertion-ordered open-addressed hash map. Two layers:
//   - Entries arrays (keys/values/hashes/entry_states) hold live and dead
//     entries in the order they were first inserted. Iteration walks these.
//   - Slots is an index table: each cell is SLOT_EMPTY, SLOT_TOMBSTONE, or an
//     entry index >= 0. Linear probing on the hash mod capacity.
//
// Every array is a Slice of the same count, the capacity, and each keeps
// the allocator. Removal marks the entry dead and the slot a tombstone. The
// entry's position in the entries array is retained so the insertion order of
// surviving entries is preserved. Rehash compacts dead entries away.
//
// entry_state values: 0 = dead, 1 = live.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset SLOT_EMPTY:     USize = USize.MAX
private preset SLOT_TOMBSTONE: USize = SLOT_EMPTY.sub(1)

/// An insertion-ordered hash map. Entries live in parallel arrays (each a {Slice<T>} holding the capacity and the allocator) in the order they were first inserted, and an open-addressed slot table with linear probing maps a key hash to its entry. Removal marks the entry dead, so surviving entries keep their order until the next rehash.
/// :typeparam TKey: The key type, which must provide hashing and equality.
/// :typeparam TValue: The value type.
record Dict<TKey, TValue>
conform Destructible<Dict<TKey, TValue>>
conform Representable<Dict<TKey, TValue>> when TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>
conform Diagnosable<Dict<TKey, TValue>>   when TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>
conform Equatable<Dict<TKey, TValue>>     when TKey: typename, TValue: typename, Equatable<TValue>
require TKey: typename, TValue: typename, HashEquatable<TKey>
    keys          : Slice<TKey>
    values        : Slice<TValue>
    hashes        : Slice<U64>
    entry_states  : Slice<U8>
    slots         : Slice<USize>
    count         : USize
    entries_count : USize

/// Creates an empty Dict that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the dict stores and later frees its memory with.
/// :returns: A new empty Dict.
routine Dict<TKey, TValue>.construct(alloc: @Allocator) -> Me
require TKey: typename, TValue: typename
    block entry()
        keys         : Slice<TKey>   = Slice<TKey>.construct(0, alloc)
        values       : Slice<TValue> = Slice<TValue>.construct(0, alloc)
        hashes       : Slice<U64>    = Slice<U64>.construct(0, alloc)
        entry_states : Slice<U8>     = Slice<U8>.construct(0, alloc)
        slots        : Slice<USize>  = Slice<USize>.construct(0, alloc)
        map          : Me            = Me { keys: keys, values: values, hashes: hashes,
            entry_states: entry_states, slots: slots, count: 0, entries_count: 0 }
        return(map)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine Dict<TKey, TValue>.count(me: Me) -> USize
require TKey: typename, TValue: typename
    block entry()
        count : USize = me.count
        return(count)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine Dict<TKey, TValue>.count(me: @Me) -> USize
require TKey: typename, TValue: typename
    block entry()
        count : USize = me.count.load()
        return(count)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine Dict<TKey, TValue>.is_empty(me: Me) -> Bool
require TKey: typename, TValue: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine Dict<TKey, TValue>.is_empty(me: @Me) -> Bool
require TKey: typename, TValue: typename
    block entry()
        empty : Bool = me.load().is_empty()
        return(empty)

/// Probes the slot table for `key`, from `hash` modulo the capacity. The table must have at least one slot.
/// :param key: The key to look for.
/// :param hash: The key's hash.
/// :returns: The slot holding the key, or else the slot a new entry should take: the first tombstone seen, else the
///     first empty slot.
routine Dict<TKey, TValue>.slot(me: Me, key: TKey, hash: U64) -> USize
require TKey: typename, TValue: typename
    shared first_tombstone : @USize <- SLOT_EMPTY

    block entry()
        capacity : USize = me.slots.count
        mask     : USize = capacity.sub(1)
        start    : USize = hash.to_wrap<USize>().bitand(mask)
        jump probe(start)

    block probe(index: USize)
        slots        : @USize = me.slots.data
        entry_idx    : USize  = slots.stride(index).load()
        is_empty     : Bool   = entry_idx.eq(SLOT_EMPTY)
        is_tombstone : Bool   = entry_idx.eq(SLOT_TOMBSTONE)
        when
            is_empty     -> empty_slot(index)
            is_tombstone -> tombstone_slot(index)
            else         -> occupied_slot(index, entry_idx)

    block empty_slot(index: USize)
        has_tombstone : Bool  = first_tombstone.load().ne(SLOT_EMPTY)
        slot          : USize = has_tombstone
            ? first_tombstone.load()
            : index
        return(slot)

    block tombstone_slot(index: USize)
        seen           : Bool  = first_tombstone.load().ne(SLOT_EMPTY)
        next_tombstone : USize = seen
            ? first_tombstone.load()
            : index
        capacity : USize = me.slots.count
        next     : USize = index.add(1).bitand(capacity.sub(1))
        next_tombstone.store_into(first_tombstone)
        jump probe(next)

    block occupied_slot(index: USize, entry_idx: USize)
        hashes     : @U64 = me.hashes.data
        entry_hash : U64  = hashes.stride(entry_idx).load()
        hash_match : Bool = entry_hash.eq(hash)
        branch hash_match
            ? maybe_equal(index, entry_idx)
            : next(index)

    block maybe_equal(index: USize, entry_idx: USize)
        keys      : @TKey = me.keys.data
        entry_key : TKey  = keys.stride(entry_idx).load()
        equal     : Bool  = entry_key.eq(key)
        branch equal ? return(index): next(index)

    block next(index: USize)
        capacity : USize = me.slots.count
        next     : USize = index.add(1).bitand(capacity.sub(1))
        jump probe(next)

/// The entry index of `key`.
/// :param key: The key to look for.
/// :returns: The index of the key's entry, or `SLOT_EMPTY` when the key is absent.
routine Dict<TKey, TValue>.find(me: Me, key: TKey) -> USize
require TKey: typename, TValue: typename
    block entry()
        capacity : USize = me.slots.count
        empty    : Bool  = capacity.eq(0)
        branch empty ? return(SLOT_EMPTY): hash()

    block hash()
        hash      : U64    = TKey.hash(key)
        slot      : USize  = me.slot(key, hash)
        slots     : @USize = me.slots.data
        entry_idx : USize  = slots.stride(slot).load()
        found     : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? return(entry_idx)
            : return(SLOT_EMPTY)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an entry with an equal key is live.
routine Dict<TKey, TValue>.has_key(me: Me, key: TKey) -> Bool
require TKey: typename, TValue: typename
    block entry()
        found : Bool = me.find(key).ne(SLOT_EMPTY)
        return(found)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an entry with an equal key is live.
routine Dict<TKey, TValue>.has_key(me: @Me, key: TKey) -> Bool
require TKey: typename, TValue: typename
    block entry()
        found : Bool = me.load().has_key(key)
        return(found)

/// Two dicts are equal when they hold the same key-value pairs, regardless of insertion order or slot layout. With
/// matching counts, every key of `me` being in `other` with an equal value is enough.
/// :param other: The dict to compare with.
/// :returns: True when the two hold the same pairs.
routine Dict<TKey, TValue>.eq(me: Me, other: Me) -> Bool
require TKey: typename, TValue: typename, Equatable<TValue>
    block entry()
        claim a : @Me <- me
        claim b : @Me <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// `eq`, through pointers to the two dicts.
/// :param other: The dict to compare with.
/// :returns: True when the two hold the same pairs.
private routine Dict<TKey, TValue>.eq_at(me: @Me, other: @Me) -> Bool
require TKey: typename, TValue: typename, Equatable<TValue>
    block entry()
        la       : USize = me.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan()
            : return(false)

    block scan()
        n : USize = me.entries_count.load()
        jump loop(0, n)

    block loop(i: USize, n: USize)
        done : Bool = i.ge(n)
        branch done
            ? return(true)
            : check(i, n)

    block check(i: USize, n: USize)
        entry_states : @U8  = me.entry_states.data.load()
        s            : U8   = entry_states.stride(i).load()
        live         : Bool = s.eq(1)
        branch live
            ? probe(i, n)
            : loop(i.add(1), n)

    block probe(i: USize, n: USize)
        keys  : @TKey = me.keys.data.load()
        key   : TKey  = keys.stride(i).load()
        eb    : USize = other.load().find(key)
        found : Bool  = eb.lt(SLOT_TOMBSTONE)
        branch found
            ? compare_value(i, n, eb)
            : return(false)

    block compare_value(i: USize, n: USize, eb: USize)
        values_a : @TValue = me.values.data.load()
        values_b : @TValue = other.values.data.load()
        va       : TValue  = values_a.stride(i).load()
        vb       : TValue  = values_b.stride(eb).load()
        eq       : Bool    = va.eq(vb)
        branch eq
            ? loop(i.add(1), n)
            : return(false)

/// Allocates fresh arrays of `new_capacity`, walks the old entries in insertion order, and re-inserts each live
/// entry. Dead entries are dropped, so the entries array is compacted. The new arrays are made in the order keys,
/// values, hashes, entry states, slots, and a failure releases the ones already made.
/// :param new_capacity: The new capacity, a power of two above the live count.
/// :returns: True when it rehashed, false when the allocator failed (the map is left as it was).
private routine Dict<TKey, TValue>.rehash(me: @Me, new_capacity: USize) -> Bool
require TKey: typename, TValue: typename
    shared alloc        : @Allocator     = me.keys.alloc.load()
    shared keys         : @Slice<TKey>   <- .construct(0, alloc)
    shared values       : @Slice<TValue> <- .construct(0, alloc)
    shared hashes       : @Slice<U64>    <- .construct(0, alloc)
    shared entry_states : @Slice<U8>     <- .construct(0, alloc)
    shared slots        : @Slice<USize>  <- .construct(0, alloc)

    block entry()
        made_keys : Bool = make_array<TKey>(keys, new_capacity)
        branch made_keys
            ? continue
            : discard()
        made_values : Bool = make_array<TValue>(values, new_capacity)
        branch made_values
            ? continue
            : discard()
        made_hashes : Bool = make_array<U64>(hashes, new_capacity)
        branch made_hashes
            ? continue
            : discard()
        made_states : Bool = make_array<U8>(entry_states, new_capacity)
        branch made_states
            ? continue
            : discard()
        made_slots : Bool = make_array<USize>(slots, new_capacity)
        branch made_slots
            ? clear_loop(0)
            : discard()

    block discard()
        destruct_arrays<TKey, TValue>(keys, values, hashes, entry_states, slots)
        return(false)

    block clear_loop(i: USize)
        done : Bool = i.ge(new_capacity)
        branch done
            ? install()
            : continue
        slot_cells  : @USize = slots.data.load()
        state_cells : @U8    = entry_states.data.load()
        slot_cells.stride(i).store(SLOT_EMPTY)
        state_cells.stride(i).store(0)
        jump clear_loop(i.add(1))

    // Swaps the new arrays into the dict, so the claimed slices hold the old ones from here on.
    block install()
        old_count : USize = me.entries_count.load()
        swap_slices<TKey>(me.keys, keys)
        swap_slices<TValue>(me.values, values)
        swap_slices<U64>(me.hashes, hashes)
        swap_slices<U8>(me.entry_states, entry_states)
        swap_slices<USize>(me.slots, slots)
        me.count.store(0)
        me.entries_count.store(0)
        jump move_loop(0, old_count)

    block move_loop(i: USize, old_count: USize)
        done : Bool = i.ge(old_count)
        branch done
            ? release_old()
            : continue
        states : @U8  = entry_states.data.load()
        s      : U8   = states.stride(i).load()
        live   : Bool = s.eq(1)
        branch live
            ? insert_old(i, old_count)
            : move_loop(i.add(1), old_count)

    block insert_old(i: USize, old_count: USize)
        old_keys   : @TKey   = keys.data.load()
        old_values : @TValue = values.data.load()
        old_hashes : @U64    = hashes.data.load()
        key        : TKey    = old_keys.stride(i).load()
        value      : TValue  = old_values.stride(i).load()
        hash       : U64     = old_hashes.stride(i).load()
        me.put_direct(key, value, hash)
        jump move_loop(i.add(1), old_count)

    block release_old()
        destruct_arrays<TKey, TValue>(keys, values, hashes, entry_states, slots)
        return(true)

/// Makes room for one more entry: the first insertion rehashes into 8 slots, and the tables double once one more
/// entry would fill three quarters of them.
/// :returns: True when there is room, false when the allocator failed (the map is left as it was).
private routine Dict<TKey, TValue>.ensure(me: @Me) -> Bool
require TKey: typename, TValue: typename
    shared capacity : USize = me.slots.count.load()

    block entry()
        empty : Bool = capacity.eq(0)
        branch empty
            ? first()
            : check()

    block first()
        return(me.rehash(8))

    block check()
        count : USize = me.entries_count.load()
        limit : USize = capacity.mul(3).div(4)
        full  : Bool  = count.add(1).ge(limit)
        branch full
            ? grow()
            : return(true)

    block grow()
        return(me.rehash(capacity.mul(2)))

/// Inserts without growing, for rehash once the new arrays are in place and for `put_result` after `ensure`. A key
/// already live gets its value updated in place, so it keeps its position in insertion order. Otherwise a fresh
/// entry is appended at `entries_count` and the slot bound to it.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :param hash: The key's hash, so rehash can pass the stored one instead of hashing every key again.
routine Dict<TKey, TValue>.put_direct(me: @Me, key: TKey, value: TValue, hash: U64) -> Void
require TKey: typename, TValue: typename
    shared slot      : USize  = me.load().slot(key, hash)
    shared slots     : @USize = me.slots.data.load()
    shared entry_idx : USize  = slots.stride(slot).load()

    block entry()
        occupied : Bool = entry_idx.lt(SLOT_TOMBSTONE)
        branch occupied
            ? replace()
            : add()

    block replace()
        values : @TValue = me.values.data.load()
        values.stride(entry_idx).store(value)
        return()

    block add()
        new_idx      : USize   = me.entries_count.load()
        keys         : @TKey   = me.keys.data.load()
        values       : @TValue = me.values.data.load()
        hashes       : @U64    = me.hashes.data.load()
        entry_states : @U8     = me.entry_states.data.load()
        keys.stride(new_idx).store(key)
        values.stride(new_idx).store(value)
        hashes.stride(new_idx).store(hash)
        entry_states.stride(new_idx).store(1)
        slots.stride(slot).store(new_idx)
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        me.entries_count.store(new_idx.add(1))
        return()

/// Stores `value` under `key`, inserting a new entry or replacing the value of an equal existing key.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :throws: Crashes with `MemoryAllocationError` when the tables must grow and the allocator fails. See {Dict<TKey, TValue>.put_result} for a recoverable form.
#track_caller
routine Dict<TKey, TValue>.put(me: @Me, key: TKey, value: TValue) -> Void
require TKey: typename, TValue: typename
    block entry()
        put : Result<Unit, AllocFailed> = me.put_result(key, value)
        when put
            .Success -> return()
            .Failure -> crash_allocation()

/// `put`, returning a Failure instead of crashing when the allocator fails.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :returns: `Success` once the value is stored.
/// :throws: Returns `Failure(AllocFailed)` when the tables must grow and the allocator fails.
routine Dict<TKey, TValue>.put_result(me: @Me, key: TKey,
    value: TValue) -> Result<Unit, AllocFailed>
require TKey: typename, TValue: typename
    block entry()
        room : Bool = me.ensure()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        me.put_direct(key, value, TKey.hash(key))
        return(.Success(Unit.value()))

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {Dict<TKey, TValue>.getitem_checked}.
#track_caller
routine Dict<TKey, TValue>.getitem(me: Me, key: TKey) -> TValue
require TKey: typename, TValue: typename
    shared entry_idx : USize = me.find(key)

    block entry()
        found : Bool = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? load()
            : crash_key_not_found()

    block load()
        values : @TValue = me.values.data
        value  : TValue  = values.stride(entry_idx).load()
        return(value)

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {Dict<TKey, TValue>.getitem_checked}.
#track_caller
routine Dict<TKey, TValue>.getitem(me: @Me, key: TKey) -> TValue
require TKey: typename, TValue: typename
    block entry()
        value : TValue = me.load().getitem(key)
        return(value)

/// `getitem`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :absent: When the key is not present.
routine Dict<TKey, TValue>.getitem_checked(me: Me, key: TKey) -> Option<TValue>
require TKey: typename, TValue: typename
    shared entry_idx : USize = me.find(key)

    block entry()
        found : Bool = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? load()
            : return(.Absent)

    block load()
        values : @TValue = me.values.data
        value  : TValue  = values.stride(entry_idx).load()
        return(.Present(value))

/// `getitem`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :absent: When the key is not present.
routine Dict<TKey, TValue>.getitem_checked(me: @Me, key: TKey) -> Option<TValue>
require TKey: typename, TValue: typename
    block entry()
        value : Option<TValue> = me.load().getitem_checked(key)
        return(value)

/// The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
/// value: changing a key in place would lose it. It stays valid until the dict grows, rehashes, or is destructed.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent.
#track_caller
routine Dict<TKey, TValue>.at(me: Me, key: TKey) -> @TValue
require TKey: typename, TValue: typename
    shared entry_idx : USize = me.find(key)

    block entry()
        found : Bool = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? address()
            : crash_key_not_found()

    block address()
        values : @TValue = me.values.data
        value  : @TValue = values.stride(entry_idx)
        return(value)

/// The address of the value under `key`, checked like getitem: a place to update the value in place. Only the
/// value: changing a key in place would lose it. It stays valid until the dict grows, rehashes, or is destructed.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent.
#track_caller
routine Dict<TKey, TValue>.at(me: @Me, key: TKey) -> @TValue
require TKey: typename, TValue: typename
    block entry()
        value : @TValue = me.load().at(key)
        return(value)

/// `at`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :absent: When the key is not present.
routine Dict<TKey, TValue>.at_checked(me: Me, key: TKey) -> Option<@TValue>
require TKey: typename, TValue: typename
    shared entry_idx : USize = me.find(key)

    block entry()
        found : Bool = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? address()
            : return(.Absent)

    block address()
        values : @TValue = me.values.data
        value  : @TValue = values.stride(entry_idx)
        return(.Present(value))

/// `at`, returning Absent instead of crashing on a missing key.
/// :param key: The key to look up.
/// :returns: The value's address.
/// :absent: When the key is not present.
routine Dict<TKey, TValue>.at_checked(me: @Me, key: TKey) -> Option<@TValue>
require TKey: typename, TValue: typename
    block entry()
        value : Option<@TValue> = me.load().at_checked(key)
        return(value)

/// Removes the entry for `key`. Removal keeps the entries array's layout: the entry is marked dead and its slot
/// becomes a tombstone, so surviving entries keep their order until the next rehash.
/// :param key: The key to remove.
/// :returns: `true` when an entry was removed, `false` when the key was not present.
routine Dict<TKey, TValue>.remove(me: @Me, key: TKey) -> Bool
require TKey: typename, TValue: typename
    block entry()
        capacity : USize = me.slots.count.load()
        empty    : Bool  = capacity.eq(0)
        branch empty
            ? return(false)
            : hash()

    block hash()
        hash      : U64    = TKey.hash(key)
        slot      : USize  = me.load().slot(key, hash)
        slots     : @USize = me.slots.data.load()
        entry_idx : USize  = slots.stride(slot).load()
        found     : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? remove(slot, entry_idx)
            : return(false)

    block remove(slot: USize, entry_idx: USize)
        slots        : @USize = me.slots.data.load()
        entry_states : @U8    = me.entry_states.data.load()
        slots.stride(slot).store(SLOT_TOMBSTONE)
        entry_states.stride(entry_idx).store(0)
        remaining_count : USize = me.count.load().sub(1)
        remaining_count.store_into(me.count)
        return(true)

/// Gives the dict's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine Dict<TKey, TValue>.destruct(me: @Me) -> Void
require TKey: typename, TValue: typename
    block entry()
        destruct_arrays<TKey, TValue>(me.keys, me.values, me.hashes, me.entry_states, me.slots)
        me.count.store(0)
        me.entries_count.store(0)
        return()

/// Destructs every key and value, then the dictionary itself.
#track_caller
routine Dict<TKey, TValue>.destruct_all(me: @Me) -> Void
require TKey: typename, TValue: typename, Destructible<TKey>, Destructible<TValue>
    shared iter_val   : DictIter<TKey, TValue>  = .construct(me)
    shared iter       : @DictIter<TKey, TValue> <- iter_val
    shared key_slot   : @TKey                   <- uninit
    shared value_slot : @TValue                 <- uninit

    block entry()
        jump next()

    block next()
        item : Option<KVPair<TKey, TValue>> = iter.next()
        when item
            .Present(entry) -> entry_found(entry)
            .Absent         -> finish()

    block entry_found(entry: KVPair<TKey, TValue>)
        key_slot.store(entry.key)
        key_slot.destruct()
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

/// Destructs every value (the keys own nothing), then the dictionary itself.
#track_caller
routine Dict<TKey, TValue>.destruct_all_values(me: @Me) -> Void
require TKey: typename, TValue: typename, Destructible<TValue>
    shared iter_val   : DictIter<TKey, TValue>  = .construct(me)
    shared iter       : @DictIter<TKey, TValue> <- iter_val
    shared value_slot : @TValue                 <- uninit

    block entry()
        jump next()

    block next()
        item : Option<KVPair<TKey, TValue>> = iter.next()
        when item
            .Present(entry) -> entry_found(entry)
            .Absent         -> finish()

    block entry_found(entry: KVPair<TKey, TValue>)
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The entries in insertion order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine Dict<TKey, TValue>.represent_into<TWriter>(me: Me, out: @TWriter) -> Void
require TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : DictIter<TKey, TValue> = .construct(whole)
        claim iter : @DictIter<TKey, TValue> <- iter_val
        diagnose_entries<TKey, TValue, DictIter<TKey, TValue>, TWriter>(out, iter)
        return()

/// The entries in insertion order, keys and values diagnosed: {"a": 1, "b": 2}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine Dict<TKey, TValue>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require TKey: typename, TValue: typename, Diagnosable<TKey>, Diagnosable<TValue>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : DictIter<TKey, TValue> = .construct(whole)
        claim iter : @DictIter<TKey, TValue> <- iter_val
        diagnose_entries<TKey, TValue, DictIter<TKey, TValue>, TWriter>(out, iter)
        return()

// -- the arrays -----------------------------------------------------------------

/// Fills `into` (an empty slice holding the allocator) with `count` new values from that allocator. Set's rehash
/// makes its arrays the same way.
/// :typeparam T: The element type.
/// :param into: The empty slice to fill, which carries the allocator.
/// :param count: The number of elements to allocate.
/// :returns: True when it allocated, false when the allocator failed (leaving `into` empty).
internal routine make_array<T>(into: @Slice<T>, count: USize) -> Bool
require T: typename
    block entry()
        alloc : @Allocator                    = into.alloc.load()
        made  : Result<Slice<T>, AllocFailed> = Slice<T>.construct_result(count, alloc)
        when made
            .Success(slice) -> stored(slice)
            .Failure        -> return(false)

    block stored(slice: Slice<T>)
        slice.store_into(into)
        return(true)

/// Exchanges the slices at `a` and `b`.
/// :typeparam T: The element type.
/// :param a: The first slice.
/// :param b: The second slice.
internal routine swap_slices<T>(a: @Slice<T>, b: @Slice<T>) -> Void
require T: typename
    block entry()
        first  : Slice<T> = a.load()
        second : Slice<T> = b.load()
        second.store_into(a)
        first.store_into(b)
        return()

/// Gives the five arrays of a dict back to their allocator, leaving each empty.
/// :typeparam TKey: The key type.
/// :typeparam TValue: The value type.
/// :param keys: The keys array.
/// :param values: The values array.
/// :param hashes: The hashes array.
/// :param entry_states: The entry states array.
/// :param slots: The slot table.
#track_caller
private routine destruct_arrays<TKey, TValue>(keys: @Slice<TKey>, values: @Slice<TValue>,
    hashes: @Slice<U64>, entry_states: @Slice<U8>, slots: @Slice<USize>) -> Void
require TKey: typename, TValue: typename
    block entry()
        keys.resize(0)
        values.resize(0)
        hashes.resize(0)
        entry_states.resize(0)
        slots.resize(0)
        return()
