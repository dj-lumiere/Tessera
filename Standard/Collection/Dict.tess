// Tessera stdlib collection: Dict<K, V>
//
// Insertion-ordered open-addressed hash map. Two layers:
//   - Entries arrays (keys/values/hashes/entry_states) hold live and dead
//     entries in the order they were first inserted. Iteration walks these.
//   - Slots is an index table: each cell is SLOT_EMPTY, SLOT_TOMBSTONE, or an
//     entry index >= 0. Linear probing on the hash mod capacity.
//
// Every array is a Slice of the same count, the capacity, and each keeps
// the allocator. Removal marks the entry dead and the slot a tombstone. The
// entry's position in the entries array is retained so the insertion order of
// surviving entries is preserved. Rehash compacts dead entries away.
//
// entry_state values: 0 = dead, 1 = live.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset SLOT_EMPTY:     USize = USize.MAX
private preset SLOT_TOMBSTONE: USize = SLOT_EMPTY.sub(1)

/// An insertion-ordered hash map. Entries live in parallel arrays (each a {Slice<T>} holding the capacity and the allocator) in the order they were first inserted, and an open-addressed slot table with linear probing maps a key hash to its entry. Removal marks the entry dead, so surviving entries keep their order until the next rehash.
/// :typeparam K: The key type, which must provide hashing and equality.
/// :typeparam V: The value type.
record Dict<K, V>
conform Destructible<Dict<K, V>>
conform Representable<Dict<K, V>> when K: typename, V: typename, HashEquatable<K>, Diagnosable<K>, Diagnosable<V>
conform Diagnosable<Dict<K, V>>   when K: typename, V: typename, HashEquatable<K>, Diagnosable<K>, Diagnosable<V>
conform Equatable<Dict<K, V>>     when K: typename, V: typename, HashEquatable<K>, Equatable<V>
require K: typename, V: typename, HashEquatable<K>
    keys          : Slice<K>
    values        : Slice<V>
    hashes        : Slice<U64>
    entry_states  : Slice<U8>
    slots         : Slice<USize>
    count         : USize
    entries_count : USize

/// Creates an empty Dict that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the dict stores and later frees its memory with.
/// :returns: A new empty Dict.
routine Dict<K, V>.construct(alloc: @Allocator) -> Self
require K: typename, V: typename, HashEquatable<K>
    block entry()
        keys         : Slice<K>     = Slice<K>.construct(0, alloc)
        values       : Slice<V>     = Slice<V>.construct(0, alloc)
        hashes       : Slice<U64>   = Slice<U64>.construct(0, alloc)
        entry_states : Slice<U8>    = Slice<U8>.construct(0, alloc)
        slots        : Slice<USize> = Slice<USize>.construct(0, alloc)
        map          : Self         = Self { keys: keys, values: values, hashes: hashes,
            entry_states: entry_states, slots: slots, count: 0, entries_count: 0 }
        return(map)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine Dict<K, V>.count(self: Self) -> USize
require K: typename, V: typename
    block entry()
        count : USize = self.count
        return(count)

/// The number of entries currently stored.
/// :returns: The count of entries, `0` when the dict is empty.
routine Dict<K, V>.count(self: @Self) -> USize
require K: typename, V: typename
    block entry()
        count : USize = self.count.load()
        return(count)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine Dict<K, V>.is_empty(self: Self) -> Bool
require K: typename, V: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Whether the dict holds no entries.
/// :returns: `true` when the count is `0`.
routine Dict<K, V>.is_empty(self: @Self) -> Bool
require K: typename, V: typename
    block entry()
        empty : Bool = self.load().is_empty()
        return(empty)

/// Probe the slot table for key. Returns the slot index at which the key was
/// found, or the slot at which a new entry should be installed (preferring the
/// first tombstone seen, else the first empty slot).
routine Dict<K, V>.slot(self: Self, key: K, hash: U64) -> USize
require K: typename, V: typename
    block entry()
        capacity : USize = self.slots.count
        mask     : USize = capacity.sub(1)
        start    : USize = hash.to_wrap<USize>().bitand(mask)
        jump probe(start, SLOT_EMPTY)

    block probe(index: USize, first_tombstone: USize)
        slots        : @USize = self.slots.data
        entry_idx    : USize  = slots.stride(index).load()
        is_empty     : Bool   = entry_idx.eq(SLOT_EMPTY)
        is_tombstone : Bool   = entry_idx.eq(SLOT_TOMBSTONE)
        when
            is_empty     -> empty_slot(index, first_tombstone)
            is_tombstone -> tombstone_slot(index, first_tombstone)
            else         -> occupied_slot(index, first_tombstone, entry_idx)

    block empty_slot(index: USize, first_tombstone: USize)
        has_tombstone : Bool  = first_tombstone.ne(SLOT_EMPTY)
        slot          : USize = has_tombstone
            ? first_tombstone
            : index
        return(slot)

    block tombstone_slot(index: USize, first_tombstone: USize)
        seen           : Bool  = first_tombstone.ne(SLOT_EMPTY)
        next_tombstone : USize = seen
            ? first_tombstone
            : index
        capacity : USize = self.slots.count
        next     : USize = index.add(1).bitand(capacity.sub(1))
        jump probe(next, next_tombstone)

    block occupied_slot(index: USize, first_tombstone: USize, entry_idx: USize)
        hashes     : @U64 = self.hashes.data
        entry_hash : U64  = hashes.stride(entry_idx).load()
        hash_match : Bool = entry_hash.eq(hash)
        branch hash_match
            ? maybe_equal(index, first_tombstone, entry_idx)
            : next(index, first_tombstone)

    block maybe_equal(index: USize, first_tombstone: USize, entry_idx: USize)
        keys      : @K   = self.keys.data
        entry_key : K    = keys.stride(entry_idx).load()
        equal     : Bool = entry_key.eq(key)
        branch equal ? return(index): next(index, first_tombstone)

    block next(index: USize, first_tombstone: USize)
        capacity : USize = self.slots.count
        next     : USize = index.add(1).bitand(capacity.sub(1))
        jump probe(next, first_tombstone)

/// Returns the entry index for key, or SLOT_EMPTY if absent.
routine Dict<K, V>.find(self: Self, key: K) -> USize
require K: typename, V: typename
    block entry()
        capacity : USize = self.slots.count
        empty    : Bool  = capacity.eq(0)
        branch empty ? return(SLOT_EMPTY): hash()

    block hash()
        hash      : U64    = K.hash(key)
        slot      : USize  = self.slot(key, hash)
        slots     : @USize = self.slots.data
        entry_idx : USize  = slots.stride(slot).load()
        found     : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? return(entry_idx)
            : return(SLOT_EMPTY)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an entry with an equal key is live.
routine Dict<K, V>.contains(self: Self, key: K) -> Bool
require K: typename, V: typename
    block entry()
        found : Bool = self.find(key).ne(SLOT_EMPTY)
        return(found)

/// Whether `key` is present.
/// :param key: The key to look for.
/// :returns: `true` when an entry with an equal key is live.
routine Dict<K, V>.contains(self: @Self, key: K) -> Bool
require K: typename, V: typename
    block entry()
        found : Bool = self.load().contains(key)
        return(found)

/// Two Dicts are equal when they hold the same key→value pairs, regardless
/// of insertion order or internal slot layout. With matching count, "every
/// key in A is in B and maps to an equal value" is sufficient.
routine Dict<K, V>.eq(self: Self, other: Self) -> Bool
require K: typename, V: typename, HashEquatable<K>, Equatable<V>
    block entry()
        claim a : @Self <- self
        claim b : @Self <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// eq, through pointers to the two Dicts.
private routine Dict<K, V>.eq_at(self: @Self, other: @Self) -> Bool
require K: typename, V: typename, HashEquatable<K>, Equatable<V>
    block entry()
        la       : USize = self.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan()
            : return(false)

    block scan()
        n : USize = self.entries_count.load()
        jump loop(0, n)

    block loop(i: USize, n: USize)
        done : Bool = i.ge(n)
        branch done
            ? return(true)
            : check(i, n)

    block check(i: USize, n: USize)
        entry_states : @U8  = self.entry_states.data.load()
        s            : U8   = entry_states.stride(i).load()
        live         : Bool = s.eq(1)
        branch live
            ? probe(i, n)
            : loop(i.add(1), n)

    block probe(i: USize, n: USize)
        keys  : @K    = self.keys.data.load()
        key   : K     = keys.stride(i).load()
        eb    : USize = other.load().find(key)
        found : Bool  = eb.lt(SLOT_TOMBSTONE)
        branch found
            ? compare_value(i, n, eb)
            : return(false)

    block compare_value(i: USize, n: USize, eb: USize)
        values_a : @V   = self.values.data.load()
        values_b : @V   = other.values.data.load()
        va       : V    = values_a.stride(i).load()
        vb       : V    = values_b.stride(eb).load()
        eq       : Bool = va.eq(vb)
        branch eq
            ? loop(i.add(1), n)
            : return(false)

/// Allocate fresh arrays at new_capacity, walk the old entries in insertion
/// order, and re-insert each live entry. Dead entries are dropped, so the
/// entries array is compacted as a side effect. Returns false when the
/// allocator fails, leaving the map as it was. The new arrays are made in the
/// order keys, values, hashes, entry states, slots, and a failure releases the
/// ones already made.
private routine Dict<K, V>.rehash(self: @Self, new_capacity: USize) -> Bool
require K: typename, V: typename
    block entry()
        alloc : @Allocator = self.keys.alloc.load()
        claim keys         : @Slice<K>     <- .construct(0, alloc)
        claim values       : @Slice<V>     <- .construct(0, alloc)
        claim hashes       : @Slice<U64>   <- .construct(0, alloc)
        claim entry_states : @Slice<U8>    <- .construct(0, alloc)
        claim slots        : @Slice<USize> <- .construct(0, alloc)
        made_keys : Bool = make_array<K>(keys, new_capacity)
        branch made_keys
            ? continue
            : discard(keys, values, hashes, entry_states, slots)
        made_values : Bool = make_array<V>(values, new_capacity)
        branch made_values
            ? continue
            : discard(keys, values, hashes, entry_states, slots)
        made_hashes : Bool = make_array<U64>(hashes, new_capacity)
        branch made_hashes
            ? continue
            : discard(keys, values, hashes, entry_states, slots)
        made_states : Bool = make_array<U8>(entry_states, new_capacity)
        branch made_states
            ? continue
            : discard(keys, values, hashes, entry_states, slots)
        made_slots : Bool = make_array<USize>(slots, new_capacity)
        branch made_slots
            ? clear_loop(0, keys, values, hashes, entry_states, slots)
            : discard(keys, values, hashes, entry_states, slots)

    block discard(keys: @Slice<K>, values: @Slice<V>, hashes: @Slice<U64>, entry_states: @Slice<U8>,
        slots: @Slice<USize>)
        destruct_arrays<K, V>(keys, values, hashes, entry_states, slots)
        return(false)

    block clear_loop(i: USize, keys: @Slice<K>, values: @Slice<V>, hashes: @Slice<U64>,
        entry_states: @Slice<U8>, slots: @Slice<USize>)
        done : Bool = i.ge(new_capacity)
        branch done
            ? install(keys, values, hashes, entry_states, slots)
            : continue
        slot_cells  : @USize = slots.data.load()
        state_cells : @U8    = entry_states.data.load()
        slot_cells.stride(i).store(SLOT_EMPTY)
        state_cells.stride(i).store(0)
        jump clear_loop(i.add(1), keys, values, hashes, entry_states, slots)

    // Swaps the new arrays into the dict, so the claimed slices hold the old ones from here on.
    block install(keys: @Slice<K>, values: @Slice<V>, hashes: @Slice<U64>, entry_states: @Slice<U8>,
        slots: @Slice<USize>)
        old_count : USize = self.entries_count.load()
        swap_slices<K>(self.keys, keys)
        swap_slices<V>(self.values, values)
        swap_slices<U64>(self.hashes, hashes)
        swap_slices<U8>(self.entry_states, entry_states)
        swap_slices<USize>(self.slots, slots)
        self.count.store(0)
        self.entries_count.store(0)
        jump move_loop(0, old_count, keys, values, hashes, entry_states, slots)

    block move_loop(i: USize, old_count: USize, keys: @Slice<K>, values: @Slice<V>,
        hashes: @Slice<U64>, entry_states: @Slice<U8>, slots: @Slice<USize>)
        done : Bool = i.ge(old_count)
        branch done
            ? release_old(keys, values, hashes, entry_states, slots)
            : continue
        states : @U8  = entry_states.data.load()
        s      : U8   = states.stride(i).load()
        live   : Bool = s.eq(1)
        branch live
            ? insert_old(i, old_count, keys, values, hashes, entry_states, slots)
            : move_loop(i.add(1), old_count, keys, values, hashes, entry_states, slots)

    block insert_old(i: USize, old_count: USize, keys: @Slice<K>, values: @Slice<V>,
        hashes: @Slice<U64>, entry_states: @Slice<U8>, slots: @Slice<USize>)
        old_keys   : @K   = keys.data.load()
        old_values : @V   = values.data.load()
        old_hashes : @U64 = hashes.data.load()
        key        : K    = old_keys.stride(i).load()
        value      : V    = old_values.stride(i).load()
        hash       : U64  = old_hashes.stride(i).load()
        self.put_direct(key, value, hash)
        jump move_loop(i.add(1), old_count, keys, values, hashes, entry_states, slots)

    block release_old(keys: @Slice<K>, values: @Slice<V>, hashes: @Slice<U64>,
        entry_states: @Slice<U8>, slots: @Slice<USize>)
        destruct_arrays<K, V>(keys, values, hashes, entry_states, slots)
        return(true)

/// Makes room for one more entry. Returns false when the allocator fails,
/// leaving the map as it was.
private routine Dict<K, V>.ensure(self: @Self) -> Bool
require K: typename, V: typename
    block entry()
        capacity : USize = self.slots.count.load()
        empty    : Bool  = capacity.eq(0)
        branch empty
            ? first()
            : check(capacity)

    block first()
        return(self.rehash(8))

    block check(capacity: USize)
        count : USize = self.entries_count.load()
        limit : USize = capacity.mul(3).div(4)
        full  : Bool  = count.add(1).ge(limit)
        branch full
            ? grow(capacity)
            : return(true)

    block grow(capacity: USize)
        return(self.rehash(capacity.mul(2)))

/// Insert without growing — used internally by rehash after new arrays are in place.
/// If the key already lives, update its value in place (preserves position in
/// the entries array, and therefore insertion order). Otherwise append a fresh
/// entry at entries_count and bind the slot to that index. hash is the key's hash, so rehash can pass the stored
/// one instead of hashing every key again.
routine Dict<K, V>.put_direct(self: @Self, key: K, value: V, hash: U64) -> Void
require K: typename, V: typename
    block entry()
        slot      : USize  = self.load().slot(key, hash)
        slots     : @USize = self.slots.data.load()
        entry_idx : USize  = slots.stride(slot).load()
        occupied  : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch occupied
            ? replace(entry_idx)
            : add(slot)

    block replace(entry_idx: USize)
        values : @V = self.values.data.load()
        values.stride(entry_idx).store(value)
        return()

    block add(slot: USize)
        new_idx      : USize  = self.entries_count.load()
        keys         : @K     = self.keys.data.load()
        values       : @V     = self.values.data.load()
        hashes       : @U64   = self.hashes.data.load()
        entry_states : @U8    = self.entry_states.data.load()
        slots        : @USize = self.slots.data.load()
        keys.stride(new_idx).store(key)
        values.stride(new_idx).store(value)
        hashes.stride(new_idx).store(hash)
        entry_states.stride(new_idx).store(1)
        slots.stride(slot).store(new_idx)
        next_count : USize = self.count.load().add(1)
        next_count.store_into(self.count)
        self.entries_count.store(new_idx.add(1))
        return()

/// Stores `value` under `key`, inserting a new entry or replacing the value of an equal existing key.
/// :param key: The key to store under.
/// :param value: The value to store.
/// :throws: Crashes with `MemoryAllocationError` when the tables must grow and the allocator fails. See {Dict<K, V>.put_result} for a recoverable form.
#track_caller
routine Dict<K, V>.put(self: @Self, key: K, value: V) -> Void
require K: typename, V: typename
    block entry()
        put : Result<Unit, AllocFailed> = self.put_result(key, value)
        when put
            .Success -> return()
            .Failure -> crash_allocation()

/// `put`, returning a Failure instead of crashing when the allocator fails.
routine Dict<K, V>.put_result(self: @Self, key: K, value: V) -> Result<Unit, AllocFailed>
require K: typename, V: typename
    block entry()
        room : Bool = self.ensure()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        self.put_direct(key, value, K.hash(key))
        return(.Success(Unit.value()))

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {Dict<K, V>.getitem_checked}.
#track_caller
routine Dict<K, V>.getitem(self: Self, key: K) -> V
require K: typename, V: typename
    block entry()
        entry_idx : USize = self.find(key)
        found     : Bool  = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? load(entry_idx)
            : crash_key_not_found()

    block load(entry_idx: USize)
        values : @V = self.values.data
        value  : V  = values.stride(entry_idx).load()
        return(value)

/// Reads the value stored under `key`.
/// :param key: The key to look up.
/// :returns: A copy of the value.
/// :throws: Crashes with `KeyNotFoundError` when the key is absent. See {Dict<K, V>.getitem_checked}.
#track_caller
routine Dict<K, V>.getitem(self: @Self, key: K) -> V
require K: typename, V: typename
    block entry()
        value : V = self.load().getitem(key)
        return(value)

/// `getitem`, returning Absent instead of crashing on a missing key.
routine Dict<K, V>.getitem_checked(self: Self, key: K) -> Option<V>
require K: typename, V: typename
    block entry()
        entry_idx : USize = self.find(key)
        found     : Bool  = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? load(entry_idx)
            : return(.Absent)

    block load(entry_idx: USize)
        values : @V = self.values.data
        value  : V  = values.stride(entry_idx).load()
        return(.Present(value))

/// `getitem`, returning Absent instead of crashing on a missing key.
routine Dict<K, V>.getitem_checked(self: @Self, key: K) -> Option<V>
require K: typename, V: typename
    block entry()
        value : Option<V> = self.load().getitem_checked(key)
        return(value)

/// The address of key's value, checked like getitem: a place to update the value in place. Only the value: changing a
/// key in place would lose it. It stays valid until the dict grows, rehashes, or is destructed.
#track_caller
routine Dict<K, V>.at(self: Self, key: K) -> @V
require K: typename, V: typename
    block entry()
        entry_idx : USize = self.find(key)
        found     : Bool  = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? address(entry_idx)
            : crash_key_not_found()

    block address(entry_idx: USize)
        values : @V = self.values.data
        value  : @V = values.stride(entry_idx)
        return(value)

/// The address of key's value, checked like getitem: a place to update the value in place. Only the value: changing a
/// key in place would lose it. It stays valid until the dict grows, rehashes, or is destructed.
#track_caller
routine Dict<K, V>.at(self: @Self, key: K) -> @V
require K: typename, V: typename
    block entry()
        value : @V = self.load().at(key)
        return(value)

/// `at`, returning Absent instead of crashing on a missing key.
routine Dict<K, V>.at_checked(self: Self, key: K) -> Option<@V>
require K: typename, V: typename
    block entry()
        entry_idx : USize = self.find(key)
        found     : Bool  = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? address(entry_idx)
            : return(.Absent)

    block address(entry_idx: USize)
        values : @V = self.values.data
        value  : @V = values.stride(entry_idx)
        return(.Present(value))

/// `at`, returning Absent instead of crashing on a missing key.
routine Dict<K, V>.at_checked(self: @Self, key: K) -> Option<@V>
require K: typename, V: typename
    block entry()
        value : Option<@V> = self.load().at_checked(key)
        return(value)

/// Removes the entry for `key`. Removal keeps the entries array's layout: the entry is marked dead and its slot
/// becomes a tombstone, so surviving entries keep their order until the next rehash.
/// :param key: The key to remove.
/// :returns: `true` when an entry was removed, `false` when the key was not present.
routine Dict<K, V>.remove(self: @Self, key: K) -> Bool
require K: typename, V: typename
    block entry()
        capacity : USize = self.slots.count.load()
        empty    : Bool  = capacity.eq(0)
        branch empty
            ? return(false)
            : hash()

    block hash()
        hash      : U64    = K.hash(key)
        slot      : USize  = self.load().slot(key, hash)
        slots     : @USize = self.slots.data.load()
        entry_idx : USize  = slots.stride(slot).load()
        found     : Bool   = entry_idx.lt(SLOT_TOMBSTONE)
        branch found
            ? remove(slot, entry_idx)
            : return(false)

    block remove(slot: USize, entry_idx: USize)
        slots        : @USize = self.slots.data.load()
        entry_states : @U8    = self.entry_states.data.load()
        slots.stride(slot).store(SLOT_TOMBSTONE)
        entry_states.stride(entry_idx).store(0)
        remaining_count : USize = self.count.load().sub(1)
        remaining_count.store_into(self.count)
        return(true)

/// Gives the dict's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine Dict<K, V>.destruct(self: @Self) -> Void
require K: typename, V: typename
    block entry()
        destruct_arrays<K, V>(self.keys, self.values, self.hashes, self.entry_states, self.slots)
        self.count.store(0)
        self.entries_count.store(0)
        return()

/// Destructs every key and value, then the dictionary itself.
#track_caller
routine Dict<K, V>.destruct_all(self: @Self) -> Void
require K: typename, V: typename, Destructible<K>, Destructible<V>
    block entry()
        iter_val : DictIter<K, V> = .construct(self)
        claim iter       : @DictIter<K, V> <- iter_val
        claim key_slot   : @K              <- uninit
        claim value_slot : @V              <- uninit
        jump next(iter, key_slot, value_slot)

    block next(iter: @DictIter<K, V>, key_slot: @K, value_slot: @V)
        item : Option<KVPair<K, V>> = iter.next()
        when item
            .Present(entry) -> entry_found(iter, key_slot, value_slot, entry)
            .Absent         -> finish()

    block entry_found(iter: @DictIter<K, V>, key_slot: @K, value_slot: @V, entry: KVPair<K, V>)
        key_slot.store(entry.key)
        key_slot.destruct()
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next(iter, key_slot, value_slot)

    block finish()
        self.destruct()
        return()

/// Destructs every value (the keys own nothing), then the dictionary itself.
#track_caller
routine Dict<K, V>.destruct_all_values(self: @Self) -> Void
require K: typename, V: typename, Destructible<V>
    block entry()
        iter_val : DictIter<K, V> = .construct(self)
        claim iter       : @DictIter<K, V> <- iter_val
        claim value_slot : @V              <- uninit
        jump next(iter, value_slot)

    block next(iter: @DictIter<K, V>, value_slot: @V)
        item : Option<KVPair<K, V>> = iter.next()
        when item
            .Present(entry) -> entry_found(iter, value_slot, entry)
            .Absent         -> finish()

    block entry_found(iter: @DictIter<K, V>, value_slot: @V, entry: KVPair<K, V>)
        value_slot.store(entry.value)
        value_slot.destruct()
        jump next(iter, value_slot)

    block finish()
        self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The entries in insertion order, keys and values diagnosed (strings quoted): {"a": 1, "b": 2}.
routine Dict<K, V>.represent_into<W>(self: Self, out: @W) -> Void
require K: typename, V: typename, HashEquatable<K>, Diagnosable<K>, Diagnosable<V>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : DictIter<K, V> = .construct(whole)
        claim iter : @DictIter<K, V> <- iter_val
        diagnose_entries<K, V, DictIter<K, V>, W>(out, iter)
        return()

/// The entries in insertion order, keys and values diagnosed: {"a": 1, "b": 2}.
routine Dict<K, V>.diagnose_into<W>(self: Self, out: @W) -> Void
require K: typename, V: typename, HashEquatable<K>, Diagnosable<K>, Diagnosable<V>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : DictIter<K, V> = .construct(whole)
        claim iter : @DictIter<K, V> <- iter_val
        diagnose_entries<K, V, DictIter<K, V>, W>(out, iter)
        return()

// -- the arrays -----------------------------------------------------------------

/// Fills `into` (an empty slice holding the allocator) with `count` new values from that allocator. Returns false when
/// the allocator fails, leaving `into` empty. Set's rehash makes its arrays the same way.
internal routine make_array<T>(into: @Slice<T>, count: USize) -> Bool
require T: typename
    block entry()
        alloc : @Allocator                    = into.alloc.load()
        made  : Result<Slice<T>, AllocFailed> = Slice<T>.construct_result(count, alloc)
        when made
            .Success(slice) -> stored(slice)
            .Failure        -> return(false)

    block stored(slice: Slice<T>)
        slice.store_into(into)
        return(true)

/// Exchanges the slices at `a` and `b`.
internal routine swap_slices<T>(a: @Slice<T>, b: @Slice<T>) -> Void
require T: typename
    block entry()
        first  : Slice<T> = a.load()
        second : Slice<T> = b.load()
        second.store_into(a)
        first.store_into(b)
        return()

/// Gives the five arrays of a dict back to their allocator, leaving each empty.
#track_caller
private routine destruct_arrays<K, V>(keys: @Slice<K>, values: @Slice<V>, hashes: @Slice<U64>,
    entry_states: @Slice<U8>, slots: @Slice<USize>) -> Void
require K: typename, V: typename
    block entry()
        keys.resize(0)
        values.resize(0)
        hashes.resize(0)
        entry_states.resize(0)
        slots.resize(0)
        return()
