// Tessera stdlib collection: DictIter[TKey, TValue]
//
// Walks Dict[TKey, TValue] in insertion order. Yields KVPair[TKey, TValue] for each live
// entry in the entries arrays, skipping entries marked dead by `remove`.
//
// KVPair[TKey, TValue] is defined in option.tess and shared with SortedDictIter.
//
// Mutating the map during iteration produces undefined behaviour.
//
// Satisfies concept Iterator[KVPair[TKey, TValue], DictIter[TKey, TValue]].

module Standard/Collections

/// An iterator over a {Dict[TKey, TValue]} in insertion order, yielding each live entry as a `KVPair`. Entries removed from the dict are skipped. Changing the dict while iterating is undefined behavior.
/// :typeparam TKey: The key type.
/// :typeparam TValue: The value type.
record DictIter[TKey, TValue]
obeys Iterator[KVPair[TKey, TValue], DictIter[TKey, TValue]]
needs TKey: typename, TValue: typename, HashEquatable[TKey]
    map: @Dict[TKey, TValue]
    index: USize

/// Releases nothing: a `DictIter` holds no memory of its own.
routine DictIter[TKey, TValue].destruct(me: @Me) -> Void
needs TKey: typename, TValue: typename
    return

/// Creates an iterator positioned before the first entry of `map`.
/// :param map: The dict to walk.
/// :returns: A new iterator at the first entry.
routine DictIter[TKey, TValue].construct(map: @Dict[TKey, TValue]) -> Me
needs TKey: typename, TValue: typename
    iter: Me = Me(map: map, index: 0)
    return iter

/// Yields the next live entry and advances past it, skipping dead entries.
/// :returns: The next key and value pair, in insertion order.
/// :absent: After the last live entry has been yielded.
routine DictIter[TKey, TValue].emit_checked(me: @Me) -> Maybe[KVPair[TKey, TValue]]
needs TKey: typename, TValue: typename
    local map: @Dict[TKey, TValue] = me.map.peek()
    local count: USize = map.entries_count.peek()

    each index in me.index.peek() til count
        entry_states: @U8 = map.entry_states.data.peek()
        state: U8 = entry_states.stride(index).peek()
        if state == 1
            keys: @TKey = map.keys.data.peek()
            values: @TValue = map.values.data.peek()
            key: TKey = keys.stride(index).peek()
            value: TValue = values.stride(index).peek()
            pair: KVPair[TKey, TValue] = KVPair[TKey, TValue](key: key, value: value)
            me.index.poke(index + 1)
            some: Maybe[KVPair[TKey, TValue]] = pair
            return some
        else
            continue
    none: Maybe[KVPair[TKey, TValue]] = Unit()
    return none

/// Yields the next element and advances the iterator, crashing when there is none.
/// :returns: The next element, in insertion order.
/// :throws: Crashes with `AbsentValueError` after the last element has been yielded.
@track_caller
routine DictIter[TKey, TValue].emit(me: @Me) -> KVPair[TKey, TValue]
needs TKey: typename, TValue: typename
    item: Maybe[KVPair[TKey, TValue]] = me.emit_checked()
    when item
        is KVPair[TKey, TValue] as value => return value
        is Unit => crash_absent_value()
