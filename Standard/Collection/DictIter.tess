// Tessera stdlib collection: DictIter<K, V>
//
// Walks Dict<K, V> in insertion order. Yields KVPair<K, V> for each live
// entry in the entries arrays, skipping entries marked dead by `remove`.
//
// KVPair<K, V> is defined in option.tess and shared with SortedDictIter.
//
// Mutating the map during iteration produces undefined behaviour.
//
// Satisfies concept Iterator<KVPair<K, V>, DictIter<K, V>>.

module Standard::Collections

/// An iterator over a {Dict<K, V>} in insertion order, yielding each live entry as a `KVPair`. Entries removed from the dict are skipped. Changing the dict while iterating is undefined behavior.
/// :typeparam K: The key type.
/// :typeparam V: The value type.
record DictIter<K, V>
conform Iterator<KVPair<K, V>, DictIter<K, V>>
require K: typename, V: typename
    map   : @Dict<K, V>
    index : USize

/// Creates an iterator positioned before the first entry of `map`.
/// :param map: The dict to walk.
/// :returns: A new iterator at the first entry.
routine DictIter<K, V>.construct(map: @Dict<K, V>) -> Self
require K: typename, V: typename
    block entry()
        iter : Self = Self { map: map, index: 0 }
        return(iter)

/// Yields the next live entry and advances past it, skipping dead entries.
/// :returns: The next key and value pair, in insertion order.
/// :absent: After the last live entry has been yielded.
routine DictIter<K, V>.next(self: @Self) -> Option<KVPair<K, V>>
require K: typename, V: typename
    shared map   : @Dict<K, V> = self.map.load()
    shared count : USize       = map.entries_count.load()

    block entry()
        index : USize = self.index.load()
        jump scan(index)

    block scan(index: USize)
        exhausted : Bool = index.ge(count)
        branch exhausted
            ? return_none()
            : check(index)

    block check(index: USize)
        entry_states : @U8  = map.entry_states.data.load()
        state        : U8   = entry_states.stride(index).load()
        live         : Bool = state.eq(1)
        branch live
            ? yield(index)
            : scan(index.add(1))

    block return_none()
        none : Option<KVPair<K, V>> = .Absent
        return(none)

    block yield(index: USize)
        keys   : @K           = map.keys.data.load()
        values : @V           = map.values.data.load()
        key    : K            = keys.stride(index).load()
        value  : V            = values.stride(index).load()
        pair   : KVPair<K, V> = KVPair<K, V> { key: key, value: value }
        self.index.store(index.add(1))
        some : Option<KVPair<K, V>> = .Present(pair)
        return(some)
