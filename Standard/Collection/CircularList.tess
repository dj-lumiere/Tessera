// Tessera stdlib collection: CircularList<T>
//
// Dynamic array with a centered start index — front and back both grow without
// shifting. The buffer is an OwnedSpan<T> whose count is the capacity, and it
// keeps the allocator.
//
// Logical element i lives at storage.data[start + i]. Front growth consumes spare slots
// before start. When either side runs out the live range is moved back to the
// center of a new buffer, twice as large if the circular_list is more than half full.

module Standard::Collections

import Standard::Alloc
import Standard::Format

/// A growable sequence with spare room on both sides of its live range, so `push_front` and `push_back` are both amortized constant time without shifting elements. Logical element `i` lives at `storage.data[start + i]`. When either side runs out, the live range is moved to the center of a new buffer.
/// :typeparam T: The element type.
record CircularList<T>
conform Destruct<CircularList<T>>
conform Represent<CircularList<T>> when T: typename, Diagnose<T>
conform Diagnose<CircularList<T>>  when T: typename, Diagnose<T>
conform Equal<CircularList<T>>     when T: typename, Equal<T>
require T: typename
    storage : OwnedSpan<T>
    start   : USize
    count   : USize

/// Creates an empty CircularList that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the list stores and later frees its memory with.
/// :returns: A new empty CircularList.
routine CircularList<T>.construct(alloc: @Allocator) -> Self
require T: typename
    block entry()
        storage       : OwnedSpan<T> = OwnedSpan<T>.construct(0, alloc)
        circular_list : Self         = Self { storage: storage, start: 0, count: 0 }
        return(circular_list)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine CircularList<T>.count(self: Self) -> USize
require T: typename
    block entry()
        count : USize = self.count
        return(count)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine CircularList<T>.count(self: @Self) -> USize
require T: typename
    block entry()
        count : USize = self.load().count()
        return(count)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine CircularList<T>.is_empty(self: @Self) -> Bool
require T: typename
    block entry()
        empty : Bool = self.load().is_empty()
        return(empty)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine CircularList<T>.is_empty(self: Self) -> Bool
require T: typename
    block entry()
        count : USize = self.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Moves the elements into a new buffer of new_capacity, centered. Returns false
/// when the allocator fails, leaving the list as it was.
private routine CircularList<T>.recenter(self: @Self, new_capacity: USize) -> Bool
require T: typename
    block entry()
        count     : USize                             = self.count.load()
        slack     : USize                             = new_capacity.sub(count)
        new_start : USize                             = slack.div(2)
        alloc     : @Allocator                        = self.storage.alloc.load()
        made      : Result<OwnedSpan<T>, AllocFailed> = OwnedSpan<T>.construct_result(new_capacity,
            alloc)
        when made
            .Success(fresh) -> move(fresh, new_start, count)
            .Failure        -> return(false)

    block move(fresh: OwnedSpan<T>, new_start: USize, count: USize)
        old_data : @T   = self.storage.data.load()
        old_null : Bool = old_data.is_null()
        branch old_null
            ? install(fresh, new_start)
            : copy_live(fresh, new_start, old_data, count)

    block copy_live(fresh: OwnedSpan<T>, new_start: USize, old_data: @T, count: USize)
        old_start : USize = self.start.load()
        src       : @T    = old_data.stride(old_start)
        dst       : @T    = fresh.data.stride(new_start)
        copy<T>(dst, src, count)
        self.storage.destruct()
        jump install(fresh, new_start)

    block install(fresh: OwnedSpan<T>, new_start: USize)
        self.storage.store(fresh)
        self.start.store(new_start)
        return(true)

/// The capacity to recenter into when one end runs out: double it only when the circular_list is more than half full.
/// Otherwise the live range just moves back to the middle, so a queue (push_back / pop_front) keeps a bounded buffer
/// instead of doubling each time its window drifts to the end.
routine CircularList<T>.grown_capacity(self: Self, capacity: USize) -> USize
require T: typename
    block entry()
        count        : USize = self.count
        crowded      : Bool  = count.mul(2).gt(capacity)
        new_capacity : USize = crowded
            ? capacity.mul(2)
            : capacity
        return(new_capacity)

private routine CircularList<T>.ensure_front(self: @Self) -> Bool
require T: typename
    block entry()
        start           : USize = self.start.load()
        has_front_space : Bool  = start.gt(0)
        branch has_front_space
            ? return(true)
            : choose()

    block choose()
        capacity : USize = self.storage.count.load()
        empty    : Bool  = capacity.eq(0)
        branch empty
            ? initial()
            : grow(capacity)

    block initial()
        return(self.recenter(4))

    block grow(capacity: USize)
        return(self.recenter(self.load().grown_capacity(capacity)))

private routine CircularList<T>.ensure_back(self: @Self) -> Bool
require T: typename
    block entry()
        start          : USize = self.start.load()
        count          : USize = self.count.load()
        capacity       : USize = self.storage.count.load()
        has_back_space : Bool  = start.add(count).lt(capacity)
        branch has_back_space
            ? return(true)
            : choose(capacity)

    block choose(capacity: USize)
        empty : Bool = capacity.eq(0)
        branch empty
            ? initial()
            : grow(capacity)

    block initial()
        return(self.recenter(4))

    block grow(capacity: USize)
        return(self.recenter(self.load().grown_capacity(capacity)))

/// Appends `value` after the last element.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList<T>.push_back_result} for a recoverable form.
#track_caller
routine CircularList<T>.push_back(self: @Self, value: T) -> Void
require T: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = self.push_back_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push_back`, returning a Failure instead of crashing when the allocator fails.
routine CircularList<T>.push_back_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        room : Bool = self.ensure_back()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data  : @T    = self.storage.data.load()
        start : USize = self.start.load()
        count : USize = self.count.load()
        index : USize = start.add(count)
        data.stride(index).store(value)
        self.count.store(count.add(1))
        return(.Success(Unit.value()))

/// Appends `value` after the last element, the same as {CircularList<T>.push_back}.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList<T>.push_result} for a recoverable form.
routine CircularList<T>.push(self: @Self, value: T) -> Void
require T: typename
    block entry()
        self.push_back(value)
        return()

/// `push`, returning a Failure instead of crashing when the allocator fails.
routine CircularList<T>.push_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        return(self.push_back_result(value))

/// Prepends `value` before the first element, so it becomes index `0`.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList<T>.push_front_result} for a recoverable form.
#track_caller
routine CircularList<T>.push_front(self: @Self, value: T) -> Void
require T: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = self.push_front_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push_front`, returning a Failure instead of crashing when the allocator fails.
routine CircularList<T>.push_front_result(self: @Self, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        room : Bool = self.ensure_front()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data      : @T    = self.storage.data.load()
        start     : USize = self.start.load()
        new_start : USize = start.sub(1)
        data.stride(new_start).store(value)
        self.start.store(new_start)
        next_count : USize = self.count.load().add(1)
        next_count.store_into(self.count)
        return(.Success(Unit.value()))

/// Removes the last element and returns it.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList<T>.pop_back_checked}.
#track_caller
routine CircularList<T>.pop_back(self: @Self) -> T
require T: typename
    block entry()
        popped : Option<T> = self.pop_back_checked()
        when popped
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `pop_back`, returning Absent instead of crashing on an empty list.
routine CircularList<T>.pop_back_checked(self: @Self) -> Option<T>
require T: typename
    block entry()
        count : USize = self.count.load()
        empty : Bool  = count.eq(0)
        branch empty
            ? return(.Absent)
            : pop(count)

    block pop(count: USize)
        new_count : USize = count.sub(1)
        data      : @T    = self.storage.data.load()
        start     : USize = self.start.load()
        index     : USize = start.add(new_count)
        value     : T     = data.stride(index).load()
        self.count.store(new_count)
        return(.Present(value))

/// Removes the last element and returns it, the same as {CircularList<T>.pop_back}.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList<T>.pop_checked}.
routine CircularList<T>.pop(self: @Self) -> T
require T: typename
    block entry()
        value : T = self.pop_back()
        return(value)

/// `pop`, returning Absent instead of crashing on an empty list.
routine CircularList<T>.pop_checked(self: @Self) -> Option<T>
require T: typename
    block entry()
        return(self.pop_back_checked())

/// Removes the first element and returns it. Every remaining element's index drops by one.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList<T>.pop_front_checked}.
#track_caller
routine CircularList<T>.pop_front(self: @Self) -> T
require T: typename
    block entry()
        popped : Option<T> = self.pop_front_checked()
        when popped
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `pop_front`, returning Absent instead of crashing on an empty list.
routine CircularList<T>.pop_front_checked(self: @Self) -> Option<T>
require T: typename
    block entry()
        count : USize = self.count.load()
        empty : Bool  = count.eq(0)
        branch empty
            ? return(.Absent)
            : pop(count)

    block pop(count: USize)
        data  : @T    = self.storage.data.load()
        start : USize = self.start.load()
        value : T     = data.stride(start).load()
        self.start.store(start.add(1))
        self.count.store(count.sub(1))
        return(.Present(value))

/// Reads the element at logical position `index`, counted from the front.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.getitem(self: Self, index: USize) -> T
require T: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        data  : @T    = self.storage.data
        start : USize = self.start
        value : T     = data.stride(start.add(index)).load()
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
routine CircularList<T>.getitem_checked(self: Self, index: USize) -> Option<T>
require T: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? load()
            : return(.Absent)

    block load()
        data  : @T    = self.storage.data
        start : USize = self.start
        value : T     = data.stride(start.add(index)).load()
        return(.Present(value))

/// The address of element index, checked like getitem: a place to read or write in place. It stays valid until the
/// list grows, shrinks, or is destructed.
#track_caller
routine CircularList<T>.at(self: Self, index: USize) -> @T
require T: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? address()
            : crash_out_of_bounds()

    block address()
        data    : @T    = self.storage.data
        start   : USize = self.start
        element : @T    = data.stride(start.add(index))
        return(element)

/// `at`, returning Absent instead of crashing on an index past the end.
routine CircularList<T>.at_checked(self: Self, index: USize) -> Option<@T>
require T: typename
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? address()
            : return(.Absent)

    block address()
        data    : @T    = self.storage.data
        start   : USize = self.start
        element : @T    = data.stride(start.add(index))
        return(.Present(element))

/// Reads the element at logical position `index`, counted from the front.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.getitem(self: @Self, index: USize) -> T
require T: typename
    block entry()
        value : T = self.load().getitem(index)
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
routine CircularList<T>.getitem_checked(self: @Self, index: USize) -> Option<T>
require T: typename
    block entry()
        value : Option<T> = self.load().getitem_checked(index)
        return(value)

/// The address of element index, checked like getitem: a place to read or write in place. It stays valid until the
/// list grows, shrinks, or is destructed.
#track_caller
routine CircularList<T>.at(self: @Self, index: USize) -> @T
require T: typename
    block entry()
        element : @T = self.load().at(index)
        return(element)

/// `at`, returning Absent instead of crashing on an index past the end.
routine CircularList<T>.at_checked(self: @Self, index: USize) -> Option<@T>
require T: typename
    block entry()
        element : Option<@T> = self.load().at_checked(index)
        return(element)

/// Whether two lists hold equal elements in the same logical order, regardless of where each sits in its buffer.
/// :param other: The list to compare with.
/// :returns: `true` when the counts match and every element pair is equal.
routine CircularList<T>.eq(self: Self, other: Self) -> Bool
require T: typename, Equal<T>
    block entry()
        claim a : @Self <- self
        claim b : @Self <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// eq, through pointers to the two CircularLists.
private routine CircularList<T>.eq_at(self: @Self, other: @Self) -> Bool
require T: typename, Equal<T>
    block entry()
        la       : USize = self.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan(la)
            : return(false)

    block scan(len: USize)
        sa : USize = self.start.load()
        sb : USize = other.start.load()
        pa : @T    = self.storage.data.load()
        pb : @T    = other.storage.data.load()
        jump loop(0, len, sa, sb, pa, pb)

    block loop(i: USize, len: USize, sa: USize, sb: USize, pa: @T, pb: @T)
        done : Bool = i.ge(len)
        branch done
            ? return(true)
            : step(i, len, sa, sb, pa, pb)

    block step(i: USize, len: USize, sa: USize, sb: USize, pa: @T, pb: @T)
        x  : T    = pa.stride(sa.add(i)).load()
        y  : T    = pb.stride(sb.add(i)).load()
        eq : Bool = x.eq(y)
        branch eq
            ? loop(i.add(1), len, sa, sb, pa, pb)
            : return(false)

/// Overwrites the element at logical position `index` with `value`.
/// :param index: The zero-based position to write.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.setitem(self: @Self, index: USize, value: T) -> Void
require T: typename
    block entry()
        count     : USize = self.count.load()
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? store()
            : crash_out_of_bounds()

    block store()
        data  : @T    = self.storage.data.load()
        start : USize = self.start.load()
        data.stride(start.add(index)).store(value)
        return()

/// Removes every element and re-centers the start index. The buffer and its capacity are kept for reuse, and elements are not destructed.
routine CircularList<T>.clear(self: @Self) -> Void
require T: typename
    block entry()
        capacity : USize = self.storage.count.load()
        start    : USize = capacity.div(2)
        self.start.store(start)
        self.count.store(0)
        return()

/// Gives the list's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
routine CircularList<T>.destruct(self: @Self) -> Void
require T: typename
    block entry()
        self.storage.destruct()
        self.start.store(0)
        self.count.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
routine CircularList<T>.destruct_all(self: @Self) -> Void
require T: typename, Destruct<T>
    block entry()
        iter_val : CircularListIter<T> = .construct(self)
        claim iter : @CircularListIter<T> <- iter_val
        claim slot : @T                   <- uninit
        jump next(iter, slot)

    block next(iter: @CircularListIter<T>, slot: @T)
        item : Option<T> = iter.next()
        when item
            .Present(value) -> element(iter, slot, value)
            .Absent         -> finish()

    block element(iter: @CircularListIter<T>, slot: @T, value: T)
        slot.store(value)
        slot.destruct()
        jump next(iter, slot)

    block finish()
        self.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements from the front, each diagnosed (strings quoted): [1, 2, 3].
routine CircularList<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : CircularListIter<T> = .construct(whole)
        claim iter : @CircularListIter<T> <- iter_val
        diagnose_items<T, CircularListIter<T>, W>(out, iter, "[", "]")
        return()

/// The elements from the front, each diagnosed: [1, 2, 3].
routine CircularList<T>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry()
        claim whole : @Self <- self
        iter_val : CircularListIter<T> = .construct(whole)
        claim iter : @CircularListIter<T> <- iter_val
        diagnose_items<T, CircularListIter<T>, W>(out, iter, "[", "]")
        return()
