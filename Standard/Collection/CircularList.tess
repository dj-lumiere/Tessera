// Tessera stdlib collection: CircularList<T>
//
// Dynamic array with a centered start index — front and back both grow without
// shifting. The buffer is a Slice<T> whose count is the capacity, and it
// keeps the allocator.
//
// Logical element i lives at storage.data[start + i]. Front growth consumes spare slots
// before start. When either side runs out the live range is moved back to the
// center of a new buffer, twice as large if the circular_list is more than half full.

module Standard::Collections

import Standard::Alloc
import Standard::Format

/// A growable sequence with spare room on both sides of its live range, so `push_front` and `push_back` are both amortized constant time without shifting elements. Logical element `i` lives at `storage.data[start + i]`. When either side runs out, the live range is moved to the center of a new buffer.
/// :typeparam T: The element type.
record CircularList<T>
conform Destructible<CircularList<T>>
conform Representable<CircularList<T>> when T: typename, Diagnosable<T>
conform Diagnosable<CircularList<T>>   when T: typename, Diagnosable<T>
conform Equatable<CircularList<T>>     when T: typename, Equatable<T>
require T: typename
    storage : Slice<T>
    start   : USize
    count   : USize

/// Creates an empty CircularList that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the list stores and later frees its memory with.
/// :returns: A new empty CircularList.
routine CircularList<T>.construct(alloc: @Allocator) -> Me
require T: typename
    block entry()
        storage       : Slice<T> = Slice<T>.construct(0, alloc)
        circular_list : Me       = Me { storage: storage, start: 0, count: 0 }
        return(circular_list)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine CircularList<T>.count(me: Me) -> USize
require T: typename
    block entry()
        count : USize = me.count
        return(count)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the list is empty.
routine CircularList<T>.count(me: @Me) -> USize
require T: typename
    block entry()
        count : USize = me.load().count()
        return(count)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine CircularList<T>.is_empty(me: @Me) -> Bool
require T: typename
    block entry()
        empty : Bool = me.load().is_empty()
        return(empty)

/// Whether the list holds no elements.
/// :returns: `true` when the count is `0`.
routine CircularList<T>.is_empty(me: Me) -> Bool
require T: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Moves the elements into a new buffer of `new_capacity`, centered in it.
/// :param new_capacity: The new buffer's capacity, at least the count.
/// :returns: True when it moved them, false when the allocator failed (the list is left as it was).
private routine CircularList<T>.recenter(me: @Me, new_capacity: USize) -> Bool
require T: typename
    shared count     : USize = me.count.load()
    shared slack     : USize = new_capacity.sub(count)
    shared new_start : USize = slack.div(2)

    block entry()
        alloc : @Allocator                    = me.storage.alloc.load()
        made  : Result<Slice<T>, AllocFailed> = Slice<T>.construct_result(new_capacity, alloc)
        when made
            .Success(fresh) -> move(fresh)
            .Failure        -> return(false)

    block move(fresh: Slice<T>)
        old_data : @T   = me.storage.data.load()
        old_null : Bool = old_data.is_null()
        branch old_null
            ? install(fresh)
            : copy_live(fresh, old_data)

    block copy_live(fresh: Slice<T>, old_data: @T)
        old_start : USize = me.start.load()
        src       : @T    = old_data.stride(old_start)
        dst       : @T    = fresh.data.stride(new_start)
        src.copy_into(dst, count)
        me.storage.destruct()
        jump install(fresh)

    block install(fresh: Slice<T>)
        me.storage.store(fresh)
        me.start.store(new_start)
        return(true)

/// The capacity to recenter into when one end runs out: double it only when the circular_list is more than half full.
/// Otherwise the live range just moves back to the middle, so a queue (push_back / pop_front) keeps a bounded buffer
/// instead of doubling each time its window drifts to the end.
/// :param capacity: The current capacity.
/// :returns: Twice `capacity` when the list is more than half full, else `capacity`.
routine CircularList<T>.grown_capacity(me: Me, capacity: USize) -> USize
require T: typename
    block entry()
        count        : USize = me.count
        crowded      : Bool  = count.mul(2).gt(capacity)
        new_capacity : USize = crowded
            ? capacity.mul(2)
            : capacity
        return(new_capacity)

/// Makes room for one element before the first: when the start is at 0, recenters into a buffer of 4 (none yet) or
/// of {CircularList<T>.grown_capacity}.
/// :returns: True when there is room, false when the allocator failed.
private routine CircularList<T>.ensure_front(me: @Me) -> Bool
require T: typename
    block entry()
        start           : USize = me.start.load()
        has_front_space : Bool  = start.gt(0)
        branch has_front_space
            ? return(true)
            : choose()

    block choose()
        capacity : USize = me.storage.count.load()
        empty    : Bool  = capacity.eq(0)
        branch empty
            ? initial()
            : grow(capacity)

    block initial()
        return(me.recenter(4))

    block grow(capacity: USize)
        return(me.recenter(me.load().grown_capacity(capacity)))

/// Makes room for one element after the last: when the buffer's end is reached, recenters into a buffer of 4 (none
/// yet) or of {CircularList<T>.grown_capacity}.
/// :returns: True when there is room, false when the allocator failed.
private routine CircularList<T>.ensure_back(me: @Me) -> Bool
require T: typename
    shared start    : USize = me.start.load()
    shared count    : USize = me.count.load()
    shared capacity : USize = me.storage.count.load()

    block entry()
        has_back_space : Bool = start.add(count).lt(capacity)
        branch has_back_space
            ? return(true)
            : choose()

    block choose()
        empty : Bool = capacity.eq(0)
        branch empty
            ? initial()
            : grow()

    block initial()
        return(me.recenter(4))

    block grow()
        return(me.recenter(me.load().grown_capacity(capacity)))

/// Appends `value` after the last element.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList<T>.push_back_result} for a recoverable form.
#track_caller
routine CircularList<T>.push_back(me: @Me, value: T) -> Void
require T: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = me.push_back_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push_back`, returning a Failure instead of crashing when the allocator fails.
/// :param value: The element to add.
/// :returns: `Success` once the element is added.
/// :throws: Returns `Failure(AllocFailed)` when the buffer must grow and the allocator fails.
routine CircularList<T>.push_back_result(me: @Me, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        room : Bool = me.ensure_back()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data  : @T    = me.storage.data.load()
        start : USize = me.start.load()
        count : USize = me.count.load()
        index : USize = start.add(count)
        data.stride(index).store(value)
        me.count.store(count.add(1))
        return(.Success(Unit.value()))

/// Appends `value` after the last element, the same as {CircularList<T>.push_back}.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList<T>.push_result} for a recoverable form.
routine CircularList<T>.push(me: @Me, value: T) -> Void
require T: typename
    block entry()
        me.push_back(value)
        return()

/// `push`, returning a Failure instead of crashing when the allocator fails.
/// :param value: The element to add.
/// :returns: `Success` once the element is added.
/// :throws: Returns `Failure(AllocFailed)` when the buffer must grow and the allocator fails.
routine CircularList<T>.push_result(me: @Me, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        return(me.push_back_result(value))

/// Prepends `value` before the first element, so it becomes index `0`.
/// :param value: The element to add.
/// :throws: Crashes with `MemoryAllocationError` when the buffer must grow and the allocator fails. See {CircularList<T>.push_front_result} for a recoverable form.
#track_caller
routine CircularList<T>.push_front(me: @Me, value: T) -> Void
require T: typename
    block entry()
        pushed : Result<Unit, AllocFailed> = me.push_front_result(value)
        when pushed
            .Success -> return()
            .Failure -> crash_allocation()

/// `push_front`, returning a Failure instead of crashing when the allocator fails.
/// :param value: The element to add.
/// :returns: `Success` once the element is added.
/// :throws: Returns `Failure(AllocFailed)` when the buffer must grow and the allocator fails.
routine CircularList<T>.push_front_result(me: @Me, value: T) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        room : Bool = me.ensure_front()
        branch room
            ? continue
            : return(.Failure(AllocFailed {}))
        data      : @T    = me.storage.data.load()
        start     : USize = me.start.load()
        new_start : USize = start.sub(1)
        data.stride(new_start).store(value)
        me.start.store(new_start)
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        return(.Success(Unit.value()))

/// Removes the last element and returns it.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList<T>.pop_back_checked}.
#track_caller
routine CircularList<T>.pop_back(me: @Me) -> T
require T: typename
    block entry()
        popped : Option<T> = me.pop_back_checked()
        when popped
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `pop_back`, returning Absent instead of crashing on an empty list.
/// :returns: The removed element.
/// :absent: When the list is empty.
routine CircularList<T>.pop_back_checked(me: @Me) -> Option<T>
require T: typename
    shared count : USize = me.count.load()

    block entry()
        empty : Bool = count.eq(0)
        branch empty
            ? return(.Absent)
            : pop()

    block pop()
        new_count : USize = count.sub(1)
        data      : @T    = me.storage.data.load()
        start     : USize = me.start.load()
        index     : USize = start.add(new_count)
        value     : T     = data.stride(index).load()
        me.count.store(new_count)
        return(.Present(value))

/// Removes the last element and returns it, the same as {CircularList<T>.pop_back}.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList<T>.pop_checked}.
routine CircularList<T>.pop(me: @Me) -> T
require T: typename
    block entry()
        value : T = me.pop_back()
        return(value)

/// `pop`, returning Absent instead of crashing on an empty list.
/// :returns: The removed element.
/// :absent: When the list is empty.
routine CircularList<T>.pop_checked(me: @Me) -> Option<T>
require T: typename
    block entry()
        return(me.pop_back_checked())

/// Removes the first element and returns it. Every remaining element's index drops by one.
/// :returns: The removed element.
/// :throws: Crashes with `AbsentValueError` when the list is empty. See {CircularList<T>.pop_front_checked}.
#track_caller
routine CircularList<T>.pop_front(me: @Me) -> T
require T: typename
    block entry()
        popped : Option<T> = me.pop_front_checked()
        when popped
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// `pop_front`, returning Absent instead of crashing on an empty list.
/// :returns: The removed element.
/// :absent: When the list is empty.
routine CircularList<T>.pop_front_checked(me: @Me) -> Option<T>
require T: typename
    shared count : USize = me.count.load()

    block entry()
        empty : Bool = count.eq(0)
        branch empty
            ? return(.Absent)
            : pop()

    block pop()
        data  : @T    = me.storage.data.load()
        start : USize = me.start.load()
        value : T     = data.stride(start).load()
        me.start.store(start.add(1))
        me.count.store(count.sub(1))
        return(.Present(value))

/// Reads the element at logical position `index`, counted from the front.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.getitem(me: Me, index: USize) -> T
require T: typename
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        data  : @T    = me.storage.data
        start : USize = me.start
        value : T     = data.stride(start.add(index)).load()
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :absent: When `index >= count`.
routine CircularList<T>.getitem_checked(me: Me, index: USize) -> Option<T>
require T: typename
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? load()
            : return(.Absent)

    block load()
        data  : @T    = me.storage.data
        start : USize = me.start
        value : T     = data.stride(start.add(index)).load()
        return(.Present(value))

/// The address of element `index`, checked like getitem: a place to read or write in place. It stays valid until
/// the list grows, shrinks, or is destructed.
/// :param index: The zero-based position.
/// :returns: The element's address.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.at(me: Me, index: USize) -> @T
require T: typename
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? address()
            : crash_out_of_bounds()

    block address()
        data    : @T    = me.storage.data
        start   : USize = me.start
        element : @T    = data.stride(start.add(index))
        return(element)

/// `at`, returning Absent instead of crashing on an index past the end.
/// :param index: The zero-based position.
/// :returns: The element's address.
/// :absent: When `index >= count`.
routine CircularList<T>.at_checked(me: Me, index: USize) -> Option<@T>
require T: typename
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? address()
            : return(.Absent)

    block address()
        data    : @T    = me.storage.data
        start   : USize = me.start
        element : @T    = data.stride(start.add(index))
        return(.Present(element))

/// Reads the element at logical position `index`, counted from the front.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.getitem(me: @Me, index: USize) -> T
require T: typename
    block entry()
        value : T = me.load().getitem(index)
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
/// :param index: The zero-based position to read.
/// :returns: A copy of the element.
/// :absent: When `index >= count`.
routine CircularList<T>.getitem_checked(me: @Me, index: USize) -> Option<T>
require T: typename
    block entry()
        value : Option<T> = me.load().getitem_checked(index)
        return(value)

/// The address of element `index`, checked like getitem: a place to read or write in place. It stays valid until
/// the list grows, shrinks, or is destructed.
/// :param index: The zero-based position.
/// :returns: The element's address.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.at(me: @Me, index: USize) -> @T
require T: typename
    block entry()
        element : @T = me.load().at(index)
        return(element)

/// `at`, returning Absent instead of crashing on an index past the end.
/// :param index: The zero-based position.
/// :returns: The element's address.
/// :absent: When `index >= count`.
routine CircularList<T>.at_checked(me: @Me, index: USize) -> Option<@T>
require T: typename
    block entry()
        element : Option<@T> = me.load().at_checked(index)
        return(element)

/// Whether two lists hold equal elements in the same logical order, regardless of where each sits in its buffer.
/// :param other: The list to compare with.
/// :returns: `true` when the counts match and every element pair is equal.
routine CircularList<T>.eq(me: Me, other: Me) -> Bool
require T: typename, Equatable<T>
    block entry()
        claim a : @Me <- me
        claim b : @Me <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// `eq`, through pointers to the two lists.
/// :param other: The list to compare with.
/// :returns: True when the counts match and every element pair is equal.
private routine CircularList<T>.eq_at(me: @Me, other: @Me) -> Bool
require T: typename, Equatable<T>
    shared la : USize = me.count.load()

    block entry()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? scan()
            : return(false)

    block scan()
        sa : USize = me.start.load()
        sb : USize = other.start.load()
        pa : @T    = me.storage.data.load()
        pb : @T    = other.storage.data.load()
        jump loop(0, sa, sb, pa, pb)

    block loop(i: USize, sa: USize, sb: USize, pa: @T, pb: @T)
        done : Bool = i.ge(la)
        branch done
            ? return(true)
            : step(i, sa, sb, pa, pb)

    block step(i: USize, sa: USize, sb: USize, pa: @T, pb: @T)
        x  : T    = pa.stride(sa.add(i)).load()
        y  : T    = pb.stride(sb.add(i)).load()
        eq : Bool = x.eq(y)
        branch eq
            ? loop(i.add(1), sa, sb, pa, pb)
            : return(false)

/// Overwrites the element at logical position `index` with `value`.
/// :param index: The zero-based position to write.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine CircularList<T>.setitem(me: @Me, index: USize, value: T) -> Void
require T: typename
    block entry()
        count     : USize = me.count.load()
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? store()
            : crash_out_of_bounds()

    block store()
        data  : @T    = me.storage.data.load()
        start : USize = me.start.load()
        data.stride(start.add(index)).store(value)
        return()

/// Removes every element and re-centers the start index. The buffer and its capacity are kept for reuse, and elements are not destructed.
routine CircularList<T>.clear(me: @Me) -> Void
require T: typename
    block entry()
        capacity : USize = me.storage.count.load()
        start    : USize = capacity.div(2)
        me.start.store(start)
        me.count.store(0)
        return()

/// Gives the list's memory back to its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine CircularList<T>.destruct(me: @Me) -> Void
require T: typename
    block entry()
        me.storage.resize(0)
        me.start.store(0)
        me.count.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
#track_caller
routine CircularList<T>.destruct_all(me: @Me) -> Void
require T: typename, Destructible<T>
    shared iter_val : CircularListIter<T>  = .construct(me)
    shared iter     : @CircularListIter<T> <- iter_val
    shared slot     : @T                   <- uninit

    block entry()
        jump next()

    block next()
        item : Option<T> = iter.next()
        when item
            .Present(value) -> element(value)
            .Absent         -> finish()

    block element(value: T)
        slot.store(value)
        slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements from the front, each diagnosed (strings quoted): [1, 2, 3].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine CircularList<T>.represent_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : CircularListIter<T> = .construct(whole)
        claim iter : @CircularListIter<T> <- iter_val
        diagnose_items<T, CircularListIter<T>, TWriter>(out, iter, "[", "]")
        return()

/// The elements from the front, each diagnosed: [1, 2, 3].
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine CircularList<T>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : CircularListIter<T> = .construct(whole)
        claim iter : @CircularListIter<T> <- iter_val
        diagnose_items<T, CircularListIter<T>, TWriter>(out, iter, "[", "]")
        return()
