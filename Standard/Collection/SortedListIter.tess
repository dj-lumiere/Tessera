// Tessera stdlib collection: SortedListIter<T>
//
// In-order iterator over SortedList<T>. Yields elements from index 0 to
// length-1. It keeps the path from the root to the current leaf on an inline
// stack, so a full traversal is O(n) and the iterator allocates nothing.
//
// Satisfies concept Iterator<T, SortedListIter<T>>.

module Standard::Collections

/// Every internal node has at least two children, so 2^64 elements fit in 64 levels.
private preset ITER_DEPTH: USize = 64

/// `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the child being walked (internal) or
/// the next value to yield (leaf).
record SortedListIter<T>
conform Iterator<T, SortedListIter<T>>
require T: typename
    nodes   : Array<@SortedListNode<T>, ITER_DEPTH>
    indices : Array<USize, ITER_DEPTH>
    depth   : USize

/// Creates an iterator positioned before the smallest element, descending to the leftmost leaf.
/// :param list: The sorted list to walk.
/// :returns: A new iterator, already positioned when the list is not empty.
routine SortedListIter<T>.construct(list: @SortedList<T>) -> Self
require T: typename
    block entry()
        claim iter : @Self <- uninit
        root  : @SortedListNode<T> = list.root.load()
        empty : Bool               = root.is_null()
        iter.depth.store(0)
        branch empty
            ? finish(iter)
            : continue
        iter.push_leftmost(root)
        jump finish(iter)

    block finish(iter: @Self)
        iter_val : Self = iter.load()
        return(iter_val)

/// Pushes node and the first child of each level below it, down to a leaf.
private routine SortedListIter<T>.push_leftmost(self: @Self, node: @SortedListNode<T>) -> Void
require T: typename
    block entry()
        jump push(node)

    block push(current: @SortedListNode<T>)
        depth : USize = self.depth.load()
        leaf  : Bool  = current.leaf.load()
        self.nodes.set(depth, current)
        self.indices.set(depth, 0)
        self.depth.store(depth.add(1))
        branch leaf
            ? return()
            : first_child(current)

    block first_child(current: @SortedListNode<T>)
        jump push(current.children.get(0))

/// Yields the next element in sorted order, climbing to a parent or descending to the next leaf as needed.
/// :returns: The next element, smallest first.
/// :absent: After the largest element has been yielded.
routine SortedListIter<T>.next(self: @Self) -> Option<T>
require T: typename
    block entry()
        jump top()

    block top()
        depth : USize = self.depth.load()
        empty : Bool  = depth.eq(0)
        branch empty
            ? done()
            : continue
        level : USize              = depth.sub(1)
        node  : @SortedListNode<T> = self.nodes.get(level)
        index : USize              = self.indices.get(level)
        leaf  : Bool               = node.leaf.load()
        branch leaf
            ? take_value(node, level, index)
            : next_child(node, level, index.add(1))

    block take_value(node: @SortedListNode<T>, level: USize, index: USize)
        length    : USize = node.length.load()
        has_value : Bool  = index.lt(length)
        branch has_value
            ? continue
            : pop(level)
        value : T = node.values.get(index)
        self.indices.set(level, index.add(1))
        some : Option<T> = .Present(value)
        return(some)

    // the child at `indices[level]` is done; walk the next one, if there is one
    block next_child(node: @SortedListNode<T>, level: USize, index: USize)
        length    : USize = node.length.load()
        has_child : Bool  = index.lt(length)
        branch has_child
            ? continue
            : pop(level)
        self.indices.set(level, index)
        self.push_leftmost(node.children.get(index))
        jump top()

    block pop(level: USize)
        self.depth.store(level)
        jump top()

    block done()
        none : Option<T> = .Absent
        return(none)
