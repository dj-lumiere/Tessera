# Tessera stdlib collection: SortedSet[T]
#
# Ordered set with its own order-statistic B-tree node and fixed node key
# capacity of NODE_KEYS. The allocator is stored in SortedSet. Node helpers
# still receive it as a parameter.

module Standard/Collections

import Standard/Alloc
import Standard/Format

private preset NODE_KEYS: USize = 7
private preset NODE_CHILDREN: USize = NODE_KEYS.add(1)
private preset NODE_MIN_KEYS: USize = NODE_KEYS.add(1).div(2)

### One node of a {SortedSet[T]} B-tree: up to `NODE_KEYS` keys inline, and for internal nodes the child pointers between them. `subtree_count` is the total keys in the subtree.
### :typeparam T: The element type.
record SortedSetNode[T]
needs T: typename, Comparable[T]
    leaf: Bool
    count: USize
    subtree_count: USize
    keys: Array[T, NODE_KEYS]
    children: Array[@SortedSetNode[T], NODE_CHILDREN]

### A set kept in sorted order, stored as an order-statistic B-tree. Elements are unique, lookup and insertion are `O(log n)`, and iteration is in ascending order.
### :typeparam T: The element type, ordered by its `Comparable` conformance.
record SortedSet[T]
obeys Destructible[SortedSet[T]]
obeys Representable[SortedSet[T]] when T: typename, Diagnosable[T]
obeys Diagnosable[SortedSet[T]] when T: typename, Diagnosable[T]
obeys Equatable[SortedSet[T]] when T: typename
needs T: typename, Comparable[T]
    root: @SortedSetNode[T]
    count: USize
    alloc: @MemoryManager

### Releases nothing: a `SortedSetNode` holds no memory of its own.
routine SortedSetNode[T].destruct(me: @Me) -> None
needs T: typename
    return

### Creates an empty SortedSet that draws its storage from `alloc`. Nothing is allocated until the first insertion.
### :param alloc: The allocator the set stores and later frees its memory with.
### :returns: A new empty SortedSet.
routine SortedSet[T].construct(alloc: @MemoryManager) -> Me
needs T: typename
    set: Me = Me(root: null, count: 0, alloc: alloc)
    return set

### The number of elements currently stored.
### :returns: The count of elements, `0` when the set is empty.
routine SortedSet[T].count(me: Me) -> USize
needs T: typename
    count: USize = me.count
    return count

### The number of elements currently stored.
### :returns: The count of elements, `0` when the set is empty.
routine SortedSet[T].count(me: @Me) -> USize
needs T: typename
    result: USize = me.peek().count()
    return result

### Whether the set holds no elements.
### :returns: `true` when the count is `0`.
routine SortedSet[T].is_empty(me: Me) -> Bool
needs T: typename
    count: USize = me.count
    return count == 0

### Whether the set holds no elements.
### :returns: `true` when the count is `0`.
routine SortedSet[T].is_empty(me: @Me) -> Bool
needs T: typename
    return me.peek().is_empty()

### A new empty node from `alloc`.
### :param leaf: Whether the node is a leaf.
### :param alloc: The allocator to take the node from.
### :returns: The node, or null when the allocator fails.
routine SortedSetNode[T].construct(leaf: Bool, alloc: @MemoryManager) -> @Me
needs T: typename
    local node: @Me = allocate[Me](count: 1, alloc)

    if node.is_null()
        return node
    else
        node.leaf.poke(leaf)
        node.count.poke(0)
        node.subtree_count.poke(0)
        return node

### The number of keys in the subtree below this node.
### :returns: The node's subtree count, or `0` for a null node.
routine SortedSetNode[T].subtree_count(me: @Me) -> USize
needs T: typename
    if me.is_null()
        return 0
    else
        count: USize = me.subtree_count.peek()
        return count

### Recomputes this node's subtree count from its own keys and its children's counts. Call it after the node's contents change.
routine SortedSetNode[T].recount(me: @Me) -> None
needs T: typename
    local leaf: Bool = me.leaf.peek()
    local count: USize = me.count.peek()
    local sum: @USize <- .hollow()

    if leaf
        me.subtree_count.poke(count)
        return
    else
        0.poke_into(sum)

        each i in 0 to count
            child: @Me = me.children[i]
            child_count: USize = child.subtree_count()
            with_child: USize = sum.peek() + child_count
            has_key: Bool = i < count
            next_sum: USize = when
                has_key => with_child + 1
                else => with_child
            next_sum.poke_into(sum)
        me.subtree_count.poke(sum.peek())
        return

### Finds where `key` sits among this node's keys.
### :param key: The key to locate.
### :returns: The index of the first key not less than `key`, or the key count when every key is smaller. It is also the child to descend into.
routine SortedSetNode[T].find_index(me: @Me, key: T) -> USize
needs T: typename
    while i < me.count.peek() with i: USize = 0
        node_key: T = me.keys[i]
        cmp: S32 = key.compare(node_key)
        if cmp <= 0
            return i
        else
            continue with i: i + 1
    then
        return i

### Whether two sets hold the same elements. Both are sorted, so comparing the elements in order gives set equality
### without a `contains` lookup per element.
### :param other: The set to compare with.
### :returns: True when the counts match and every element pair is equal.
routine SortedSet[T].eq(me: Me, other: Me) -> Bool
needs T: typename
    local a: @Me <- me
    local b: @Me <- other
    return a.eq_at(b)

### `eq`, through pointers to the two sets.
### :param other: The set to compare with.
### :returns: True when the counts match and every element pair is equal.
private routine SortedSet[T].eq_at(me: @Me, other: @Me) -> Bool
needs T: typename
    local a: @SortedSetIter[T] <- .hollow()
    local b: @SortedSetIter[T] <- .hollow()

    la: USize = me.count.peek()
    lb: USize = other.count.peek()
    if not (la == lb)
        return false
    a_val: SortedSetIter[T] = .construct(me)
    b_val: SortedSetIter[T] = .construct(other)
    a.poke(a_val)
    b.poke(b_val)

    # both have the same count, so both run out together
    while true
        x: Maybe[T] = a.emit_checked()
        y: Maybe[T] = b.emit_checked()
        when x
            is T as x_item =>
                y2: T = y.unwrap()
                cmp: S32 = x_item.compare(y2)
                if cmp == 0
                    continue
                else
                    return false
            is None => return true

### Whether an element equal to `key` is in the set.
### :param key: The element to look for.
### :returns: `true` when an equal element is present.
routine SortedSet[T].has(me: Me, key: T) -> Bool
needs T: typename
    root: @SortedSetNode[T] = me.root
    if root.is_null()
        return false
    else
        while true with node: @SortedSetNode[T] = root
            i: USize = node.find_index(key)
            count: USize = node.count.peek()
            if i < count
                node_key: T = node.keys[i]
                cmp: S32 = key.compare(node_key)
                if cmp == 0
                    return true
            if node.leaf.peek()
                return false
            else
                continue with node: node.children[i]

### Whether `key` is not there: the opposite of `has`.
### :param key: The value to look for.
### :returns: `true` when `has` would be `false`.
routine SortedSet[T].lacks(me: Me, key: T) -> Bool
needs T: typename
    there: Bool = me.has(key)
    return not there

### Whether an element equal to `key` is in the set.
### :param key: The element to look for.
### :returns: `true` when an equal element is present.
routine SortedSet[T].has(me: @Me, key: T) -> Bool
needs T: typename
    return me.peek().has(key)

### Whether `key` is not there: the opposite of `has`.
### :param key: The value to look for.
### :returns: `true` when `has` would be `false`.
routine SortedSet[T].lacks(me: @Me, key: T) -> Bool
needs T: typename
    there: Bool = me.has(key)
    return not there

### The `rank`-th smallest element (0 is the smallest).
### :param rank: The zero-based rank.
### :returns: A copy of the element.
### :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
@track_caller
routine SortedSet[T].get_by_rank(me: Me, rank: USize) -> T
needs T: typename
    count: USize = me.count
    if rank < count
        jump select_root()
    else
        crash_out_of_bounds()

    block select_root()
        jump select_node(me.root, rank)

    block select_node(node: @SortedSetNode[T], remaining: USize)
        jump scan(node, remaining, 0)

    block scan(node: @SortedSetNode[T], remaining: USize, i: USize)
        count: USize = node.count.peek()
        if i >= count
            jump last_child(node, remaining, i)
        else
            jump check_child(node, remaining, i)

    block check_child(node: @SortedSetNode[T], remaining: USize, i: USize)
        if node.leaf.peek()
            jump leaf_key(node, remaining, i)
        else
            jump internal_child(node, remaining, i)

    block leaf_key(node: @SortedSetNode[T], remaining: USize, i: USize)
        if remaining == i
            jump load_key(node, i)
        else
            jump scan(node, remaining, i + 1)

    block internal_child(node: @SortedSetNode[T], remaining: USize, i: USize)
        child: @SortedSetNode[T] = node.children[i]
        child_count: USize = child.subtree_count()
        if remaining < child_count
            jump select_node(child, remaining)
        else
            jump check_key(node, remaining, i, child_count)

    block check_key(node: @SortedSetNode[T], remaining: USize, i: USize, child_count: USize)
        after_child: USize = remaining - child_count
        if after_child == 0
            jump load_key(node, i)
        else
            jump scan(node, after_child - 1, i + 1)

    block last_child(node: @SortedSetNode[T], remaining: USize, i: USize)
        if node.leaf.peek()
            crash_logic_breached()
        else
            jump descend_last(node, remaining, i)

    block descend_last(node: @SortedSetNode[T], remaining: USize, i: USize)
        jump select_node(node.children[i], remaining)

    block load_key(node: @SortedSetNode[T], i: USize)
        key: T = node.keys[i]
        return key

### The `rank`-th smallest element (0 is the smallest).
### :param rank: The zero-based rank.
### :returns: A copy of the element.
### :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
@track_caller
routine SortedSet[T].get_by_rank(me: @Me, rank: USize) -> T
needs T: typename
    result: T = me.peek().get_by_rank(rank)
    return result

### Splits the full child at `index` around its middle: the middle element moves up into this node and the upper
### half into a new right sibling.
### :param index: The index of the full child.
### :param alloc: The allocator for the new node.
### :returns: True when it split, false when the allocator failed (before anything moved).
@reshaping
routine SortedSetNode[T].split_child(me: @Me, index: USize, alloc: @MemoryManager) -> Bool
needs T: typename
    local left: @Me = me.children[index]
    local leaf: Bool = left.leaf.peek()
    local right: @Me = Me.construct(leaf, alloc)

    if right.is_null()
        return false
    mid: USize = NODE_KEYS.div(2)
    right_start: USize = mid + 1
    right_count: USize = NODE_KEYS.sub(right_start)
    right.keys.copy(dst_start: 0, src: left.keys, src_start: right_start, count: right_count)
    right.count.poke(right_count)
    if leaf
        parent_count: USize = me.count.peek()
        me.keys.shift_right(start: index, end: parent_count)

        until i < index + 1 with i: USize = parent_count
            child: @Me = me.children[i]
            me.children[i + 1] = child
            continue with i: i - 1
        then
            middle_key: T = left.keys[mid]
            me.keys[index] = middle_key
            me.children[index + 1] = right
            left.count.poke(mid)
            next_count: USize = me.count.peek() + 1
            next_count.poke_into(me.count)
            left.recount()
            right.recount()
            me.recount()
            return true
    else
        each i in 0 to right_count
            src: USize = mid + 1 + i
            child: @Me = left.children[src]
            right.children[i] = child
        then
            parent_count: USize = me.count.peek()
            me.keys.shift_right(start: index, end: parent_count)

            until i2 < index + 1 with i2: USize = parent_count
                child: @Me = me.children[i2]
                me.children[i2 + 1] = child
                continue with i2: i2 - 1
            then
                middle_key: T = left.keys[mid]
                me.keys[index] = middle_key
                me.children[index + 1] = right
                left.count.poke(mid)
                next_count: USize = me.count.peek() + 1
                next_count.poke_into(me.count)
                left.recount()
                right.recount()
                me.recount()
                return true

### Inserts `key` below a node that isn't full, splitting full children on the way down. An equal element must not
### already be in the subtree (`add_result` checks first).
### :param key: The element to insert.
### :param alloc: The allocator for nodes made by splits.
### :returns: True when it inserted, false when a split failed to allocate. The tree then holds the same elements,
###     some nodes already split.
@reshaping
routine SortedSetNode[T].insert_nonfull(me: @Me, key: T, alloc: @MemoryManager) -> Bool
needs T: typename
    if me.leaf.peek()
        slot: USize = me.find_index(key)
        count: USize = me.count.peek()
        me.keys.shift_right(start: slot, end: count)
        me.keys[slot] = key
        new_count: USize = count + 1
        me.count.poke(new_count)
        me.subtree_count.poke(new_count)
        return true
    else
        slot: USize = me.find_index(key)
        child: @Me = me.children[slot]
        child_count: USize = child.count.peek()
        full: Bool = child_count == NODE_KEYS
        values2: (USize, @Me) = when
            full =>
                if not me.split_child(index: slot, alloc)
                    return false
                pivot: T = me.keys[slot]
                cmp: S32 = key.compare(pivot)
                go_right: Bool = cmp > 0
                next_slot: USize = when
                    go_right => slot + 1
                    else => slot
                becomes (next_slot, me.children[next_slot])
            else => (slot, child)
        slot2, child2 = values2
        if not child2.insert_nonfull(key, alloc)
            return false
        me.recount()
        return true

### Adds `key` to the set in sorted position unless an equal element is already present.
### :param key: The element to add.
### :returns: `true` when `key` was new, `false` when it was already present.
### :throws: Crashes with `MemoryAllocationError` when a node cannot be allocated. See {SortedSet[T].add_result} for a recoverable form.
@track_caller
@reshaping
routine SortedSet[T].add(me: @Me, key: T) -> Bool
needs T: typename
    added: Result[Bool, AllocFailed] = me.add_result(key)
    when added
        is Bool as is_new => return is_new
        is AllocFailed => crash_allocation()

### `add`, returning an error instead of crashing when the allocator fails.
### :param key: The element to add.
### :returns: A value holding whether `key` was new.
### :throws: Returns `AllocFailed` when a node cannot be allocated.
@reshaping
routine SortedSet[T].add_result(me: @Me, key: T) -> Result[Bool, AllocFailed]
needs T: typename
    if me.has(key)
        return false
    else
        alloc: @MemoryManager = me.alloc.peek()
        root: @SortedSetNode[T] = me.root.peek()
        if root.is_null()
            root2: @SortedSetNode[T] = SortedSetNode[T].construct(leaf: true, alloc)
            if root2.is_null()
                return AllocFailed()
            root2.keys[0] = key
            root2.count.poke(1)
            root2.subtree_count.poke(1)
            me.root.poke(root2)
            me.count.poke(1)
            return true
        else
            root_count: USize = root.count.peek()
            full: Bool = root_count == NODE_KEYS
            root2: @SortedSetNode[T] = when
                full =>
                    new_root: @SortedSetNode[T] = SortedSetNode[T].construct(leaf: false, alloc)
                    if new_root.is_null()
                        return AllocFailed()
                    new_root.children[0] = root
                    if new_root.split_child(index: 0, alloc)
                        me.root.poke(new_root)
                        becomes new_root
                    else
                        deallocate[SortedSetNode[T]](data: new_root, alloc)
                        return AllocFailed()
                else => root
            if not root2.insert_nonfull(key, alloc)
                return AllocFailed()
            next_count: USize = me.count.peek() + 1
            next_count.poke_into(me.count)
            return true

### Removes the key at `index` from a leaf by shifting the later keys left.
### :param index: The position of the key within the leaf.
### :returns: The removed key.
routine SortedSetNode[T].remove_leaf_at(me: @Me, index: USize) -> T
needs T: typename
    old: T = me.keys[index]
    count: USize = me.count.peek()
    me.keys.shift_left(start: index, end: count)
    new_count: USize = count - 1
    me.count.poke(new_count)
    me.subtree_count.poke(new_count)
    return old

# Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
# count >= NODE_MIN_KEYS - 1.
# Helpers below ensure a child has count >= NODE_MIN_KEYS (= t) before any deletion
# descent so the child can absorb a one-key drop without underflowing.

### Rotates one key from child `i - 1` through the parent into the front of child `i`, so child `i` gains a key. Subtree counts are updated.
### :param i: The index of the child that is short of keys.
routine SortedSetNode[T].borrow_from_left(me: @Me, i: USize) -> None
needs T: typename
    local separator: USize = i - 1
    local left: @Me = me.children[separator]
    local child: @Me = me.children[i]
    local left_count: USize = left.count.peek()
    local child_count: USize = child.count.peek()

    child.keys.shift_right(start: 0, end: child_count)
    pivot: T = me.keys[separator]
    child.keys[0] = pivot
    new_pivot: T = left.keys[left_count - 1]
    me.keys[separator] = new_pivot
    if not child.leaf.peek()
        children: USize = child_count + 1
        child.children.shift_right(start: 0, end: children)
        moved: @Me = left.children[left_count]
        child.children[0] = moved
    left.count.poke(left_count - 1)
    child.count.poke(child_count + 1)
    left.recount()
    child.recount()
    me.recount()
    return

### Rotates one key from child `i + 1` through the parent into the end of child `i`, so child `i` gains a key. Subtree counts are updated.
### :param i: The index of the child that is short of keys.
routine SortedSetNode[T].borrow_from_right(me: @Me, i: USize) -> None
needs T: typename
    local child: @Me = me.children[i]
    local right: @Me = me.children[i + 1]
    local child_count: USize = child.count.peek()
    local right_count: USize = right.count.peek()

    pivot: T = me.keys[i]
    child.keys[child_count] = pivot
    new_pivot: T = right.keys[0]
    me.keys[i] = new_pivot
    right.keys.shift_left(start: 0, end: right_count)
    if not child.leaf.peek()
        moved: @Me = right.children[0]
        child.children[child_count + 1] = moved
        right.children.shift_left(start: 0, end: right_count + 1)
    child.count.poke(child_count + 1)
    right.count.poke(right_count - 1)
    child.recount()
    right.recount()
    me.recount()
    return

### Merges child `i + 1` and the separating key into child `i` and frees the emptied node, shrinking this node by one key.
### :param i: The index of the left child of the pair.
### :param alloc: The allocator that frees the merged node.
routine SortedSetNode[T].merge_children(me: @Me, i: USize, alloc: @MemoryManager) -> None
needs T: typename
    local left: @Me = me.children[i]
    local right: @Me = me.children[i + 1]
    local left_count: USize = left.count.peek()
    local right_count: USize = right.count.peek()

    pivot: T = me.keys[i]
    left.keys[left_count] = pivot
    dst_start: USize = left_count + 1
    left.keys.copy(dst_start, src: right.keys, src_start: 0, count: right_count)
    if not left.leaf.peek()
        left.children.copy(dst_start: left_count + 1, src: right.children, src_start: 0, count: right_count + 1)
    left.count.poke(left_count + 1 + right_count)
    parent_count: USize = me.count.peek()
    me.keys.shift_left(start: i, end: parent_count)
    me.children.shift_left(start: i + 1, end: parent_count + 1)
    me.count.poke(parent_count - 1)
    deallocate[Me](data: right, alloc)
    left.recount()
    me.recount()
    return

### Makes sure child `i` has at least `NODE_MIN_KEYS` keys before a deletion descends into it, by borrowing from a sibling or merging with one.
### :param i: The index of the child about to be descended into.
### :param alloc: The allocator that frees a merged node.
### :returns: The index of the child to descend into, which differs from `i` when a merge with the left sibling happened.
@track_caller
routine SortedSetNode[T].ensure_min(me: @Me, i: USize, alloc: @MemoryManager) -> USize
needs T: typename
    child: @Me = me.children[i]
    child_count: USize = child.count.peek()
    if child_count >= NODE_MIN_KEYS
        return i
    else
        has_left: Bool = i > 0
        has_left2: Bool = when
            has_left =>
                left: @Me = me.children[i - 1]
                left_count: USize = left.count.peek()
                if left_count >= NODE_MIN_KEYS
                    me.borrow_from_left(i)
                    return i
                else
                    becomes true
            else => false
        parent_count: USize = me.count.peek()
        if i < parent_count
            right: @Me = me.children[i + 1]
            right_count: USize = right.count.peek()
            if right_count >= NODE_MIN_KEYS
                me.borrow_from_right(i)
                return i
            else if not has_left2
                me.merge_children(i, alloc)
                return i
        else if not has_left2
            crash_logic_breached()
        merged_at: USize = i - 1
        me.merge_children(i: merged_at, alloc)
        return merged_at

### Removes and returns the largest key in this subtree, rebalancing children on the way down.
### :param alloc: The allocator used when nodes merge.
### :returns: The removed largest key.
routine SortedSetNode[T].take_max(me: @Me, alloc: @MemoryManager) -> T
needs T: typename
    if me.leaf.peek()
        count: USize = me.count.peek()
        index: USize = count - 1
        key: T = me.remove_leaf_at(index)
        return key
    else
        count: USize = me.count.peek()
        actual: USize = me.ensure_min(i: count, alloc)
        child: @Me = me.children[actual]
        key: T = child.take_max(alloc)
        me.recount()
        return key

### Removes and returns the smallest key in this subtree, rebalancing children on the way down.
### :param alloc: The allocator used when nodes merge.
### :returns: The removed smallest key.
routine SortedSetNode[T].take_min(me: @Me, alloc: @MemoryManager) -> T
needs T: typename
    if me.leaf.peek()
        key: T = me.remove_leaf_at(0)
        return key
    else
        actual: USize = me.ensure_min(i: 0, alloc)
        child: @Me = me.children[actual]
        key: T = child.take_min(alloc)
        me.recount()
        return key

### Removes `key` from this subtree, rebalancing children on the way down so no node underflows.
### :param key: The key to remove.
### :param alloc: The allocator used when nodes merge.
### :returns: `true` when the key was found and removed, `false` otherwise.
routine SortedSetNode[T].remove(me: @Me, key: T, alloc: @MemoryManager) -> Bool
needs T: typename
    local slot: USize = me.find_index(key)

    count: USize = me.count.peek()
    if slot < count
        node_key: T = me.keys[slot]
        cmp: S32 = key.compare(node_key)
        if cmp == 0
            if me.leaf.peek()
                me.remove_leaf_at(slot)
                return true
            else
                left: @Me = me.children[slot]
                left_count: USize = left.count.peek()
                if left_count >= NODE_MIN_KEYS
                    left2: @Me = me.children[slot]
                    replacement: T = left2.take_max(alloc)
                    me.keys[slot] = replacement
                    me.recount()
                    return true
                else
                    right: @Me = me.children[slot + 1]
                    right_count: USize = right.count.peek()
                    if right_count >= NODE_MIN_KEYS
                        right2: @Me = me.children[slot + 1]
                        replacement: T = right2.take_min(alloc)
                        me.keys[slot] = replacement
                        me.recount()
                        return true
                    else
                        me.merge_children(i: slot, alloc)
                        merged: @Me = me.children[slot]
                        removed: Bool = merged.remove(key, alloc)
                        me.recount()
                        return removed
    if me.leaf.peek()
        return false
    else
        actual: USize = me.ensure_min(i: slot, alloc)
        child: @Me = me.children[actual]
        removed: Bool = child.remove(key, alloc)
        me.recount()
        return removed

### Removes `key` from the set, shrinking the tree when the root empties.
### :param key: The element to remove.
### :returns: `true` when an element was removed, `false` when it was not present.
routine SortedSet[T].remove(me: @Me, key: T) -> Bool
needs T: typename
    local root: @SortedSetNode[T] = me.root.peek()

    if root.is_null()
        return false
    else
        alloc: @MemoryManager = me.alloc.peek()
        if root.remove(key, alloc)
            remaining_count: USize = me.count.peek() - 1
            remaining_count.poke_into(me.count)
            root_count: USize = root.count.peek()
            if root_count == 0
                if root.leaf.peek()
                    alloc2: @MemoryManager = me.alloc.peek()
                    deallocate[SortedSetNode[T]](data: root, alloc: alloc2)
                    me.root.poke(null)
                    return true
                else
                    alloc2: @MemoryManager = me.alloc.peek()
                    new_root: @SortedSetNode[T] = root.children[0]
                    deallocate[SortedSetNode[T]](data: root, alloc: alloc2)
                    me.root.poke(new_root)
                    return true
            else
                return true
        else
            return false

### Frees this node and every node below it through `alloc`. An internal node has `count` keys and `count + 1`
### children. The elements are not destructed.
### :param alloc: The allocator the nodes came from.
routine SortedSetNode[T].free_recursive(me: @Me, alloc: @MemoryManager) -> None
needs T: typename
    if me.leaf.peek()
        deallocate[Me](data: me, alloc)
        return
    else
        count: USize = me.count.peek()

        child_count: USize = count + 1

        each i in 0 til child_count
            child: @Me = me.children[i]
            child.free_recursive(alloc)
        then
            deallocate[Me](data: me, alloc)
            return

### Frees the set's memory through its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
### :note: Safe to call on a never-filled instance, where it only resets the fields.
@track_caller
routine SortedSet[T].destruct(me: @Me) -> None
needs T: typename
    local root: @SortedSetNode[T] = me.root.peek()

    if not root.is_null()
        alloc: @MemoryManager = me.alloc.peek()
        root.free_recursive(alloc)
    me.root.poke(null)
    me.count.poke(0)
    return

### Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
### Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
@track_caller
routine SortedSet[T].destruct_all(me: @Me) -> None
needs T: typename, Destructible[T]
    local iter_val: SortedSetIter[T] = .construct(me)
    local iter: @SortedSetIter[T] <- iter_val
    local slot: @T <- .hollow()

    while true
        item: Maybe[T] = iter.emit_checked()
        when item
            is T as value =>
                slot.poke(value)
                drop slot
                continue
            is None => break
    drop me
    return

# -- text -----------------------------------------------------------------------

### The elements in sorted order, each diagnosed (strings quoted): {1, 2, 3}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine SortedSet[T].represent_into[TWriter](me: Me, out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    local whole: @Me <- me
    iter_val: SortedSetIter[T] = .construct(whole)
    local iter: @SortedSetIter[T] <- iter_val
    diagnose_items[T, SortedSetIter[T], TWriter](out, iter, open: "{", close: "}")
    return

### The elements in sorted order, each diagnosed: {1, 2, 3}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine SortedSet[T].diagnose_into[TWriter](me: Me, out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    local whole: @Me <- me
    iter_val: SortedSetIter[T] = .construct(whole)
    local iter: @SortedSetIter[T] <- iter_val
    diagnose_items[T, SortedSetIter[T], TWriter](out, iter, open: "{", close: "}")
    return
