// Tessera stdlib collection: SortedSet<T>
//
// Ordered set with its own order-statistic B-tree node and fixed node key
// capacity of NODE_KEYS. The allocator is stored in SortedSet. Node helpers
// still receive it as a parameter.

module Standard::Collections

import Standard::Alloc
import Standard::Format

private preset NODE_KEYS: USize = 7
private preset NODE_CHILDREN: USize = NODE_KEYS.add(1)
private preset NODE_MIN_KEYS: USize = NODE_KEYS.add(1).div(2)

/// One node of a {SortedSet<T>} B-tree: up to `NODE_KEYS` keys inline, and for internal nodes the child pointers between them. `subtree_count` is the total keys in the subtree.
/// :typeparam T: The element type.
record SortedSetNode<T>
require T: typename
    leaf          : Bool
    count         : USize
    subtree_count : USize
    keys          : Array<T, NODE_KEYS>
    children      : Array<@SortedSetNode<T>, NODE_CHILDREN>

/// A set kept in sorted order, stored as an order-statistic B-tree. Elements are unique, lookup and insertion are `O(log n)`, and iteration is in ascending order.
/// :typeparam T: The element type, ordered by its `Comparable` conformance.
record SortedSet<T>
conform Destructible<SortedSet<T>>
conform Representable<SortedSet<T>> when T: typename, Comparable<T>, Diagnosable<T>
conform Diagnosable<SortedSet<T>>   when T: typename, Comparable<T>, Diagnosable<T>
conform Equatable<SortedSet<T>>     when T: typename, Comparable<T>
require T: typename, Comparable<T>
    root  : @SortedSetNode<T>
    count : USize
    alloc : @Allocator

/// Creates an empty SortedSet that draws its storage from `alloc`. Nothing is allocated until the first insertion.
/// :param alloc: The allocator the set stores and later frees its memory with.
/// :returns: A new empty SortedSet.
routine SortedSet<T>.construct(alloc: @Allocator) -> Me
require T: typename, Comparable<T>
    block entry()
        set : Me = Me { root: null, count: 0, alloc: alloc }
        return(set)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the set is empty.
routine SortedSet<T>.count(me: Me) -> USize
require T: typename
    block entry()
        count : USize = me.count
        return(count)

/// The number of elements currently stored.
/// :returns: The count of elements, `0` when the set is empty.
routine SortedSet<T>.count(me: @Me) -> USize
require T: typename
    block entry()
        result : USize = me.load().count()
        return(result)

/// Whether the set holds no elements.
/// :returns: `true` when the count is `0`.
routine SortedSet<T>.is_empty(me: Me) -> Bool
require T: typename
    block entry()
        count : USize = me.count
        empty : Bool  = count.eq(0)
        return(empty)

/// Whether the set holds no elements.
/// :returns: `true` when the count is `0`.
routine SortedSet<T>.is_empty(me: @Me) -> Bool
require T: typename
    block entry()
        result : Bool = me.load().is_empty()
        return(result)

/// A new empty node from `alloc`.
/// :param leaf: Whether the node is a leaf.
/// :param alloc: The allocator to take the node from.
/// :returns: The node, or null when the allocator fails.
routine SortedSetNode<T>.construct(leaf: Bool, alloc: @Allocator) -> @Me
require T: typename
    shared node : @Me = allocate<Me>(1, alloc)

    block entry()
        failed : Bool = node.is_null()
        branch failed
            ? return(node)
            : init()

    block init()
        node.leaf.store(leaf)
        node.count.store(0)
        node.subtree_count.store(0)
        return(node)

/// The number of keys in the subtree below this node.
/// :returns: The node's subtree count, or `0` for a null node.
routine SortedSetNode<T>.subtree_count(me: @Me) -> USize
require T: typename
    block entry()
        empty : Bool = me.is_null()
        branch empty ? return(0): count()

    block count()
        count : USize = me.subtree_count.load()
        return(count)

/// Recomputes this node's subtree count from its own keys and its children's counts. Call it after the node's contents change.
routine SortedSetNode<T>.recount(me: @Me) -> Void
require T: typename
    shared leaf  : Bool   = me.leaf.load()
    shared count : USize  = me.count.load()
    shared sum   : @USize <- uninit

    block entry()
        branch leaf
            ? leaf_count()
            : internal_count()

    block leaf_count()
        me.subtree_count.store(count)
        return()

    block internal_count()
        0.store_into(sum)
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.gt(count)
        branch done
            ? store_sum()
            : add_child(i)

    block add_child(i: USize)
        child       : @Me   = me.children.getitem(i)
        child_count : USize = child.subtree_count()
        with_child  : USize = sum.load().add(child_count)
        has_key     : Bool  = i.lt(count)
        next_sum    : USize = has_key
            ? with_child.add(1)
            : with_child
        next_sum.store_into(sum)
        jump loop(i.add(1))

    block store_sum()
        me.subtree_count.store(sum.load())
        return()

/// Finds where `key` sits among this node's keys.
/// :param key: The key to locate.
/// :returns: The index of the first key not less than `key`, or the key count when every key is smaller. It is also the child to descend into.
routine SortedSetNode<T>.find_index(me: @Me, key: T) -> USize
require T: typename
    block entry()
        jump loop(0)

    block loop(i: USize)
        count : USize = me.count.load()
        done  : Bool  = i.ge(count)
        branch done ? return(i): compare(i)

    block compare(i: USize)
        node_key        : T    = me.keys.getitem(i)
        cmp             : S32  = key.compare(node_key)
        before_or_equal : Bool = cmp.le(0)
        branch before_or_equal ? return(i): loop(i.add(1))

/// Whether two sets hold the same elements. Both are sorted, so comparing the elements in order gives set equality
/// without a `has` lookup per element.
/// :param other: The set to compare with.
/// :returns: True when the counts match and every element pair is equal.
routine SortedSet<T>.eq(me: Me, other: Me) -> Bool
require T: typename, Comparable<T>
    block entry()
        claim a : @Me <- me
        claim b : @Me <- other
        equal : Bool = a.eq_at(b)
        return(equal)

/// `eq`, through pointers to the two sets.
/// :param other: The set to compare with.
/// :returns: True when the counts match and every element pair is equal.
private routine SortedSet<T>.eq_at(me: @Me, other: @Me) -> Bool
require T: typename, Comparable<T>
    shared a : @SortedSetIter<T> <- uninit
    shared b : @SortedSetIter<T> <- uninit

    block entry()
        la       : USize = me.count.load()
        lb       : USize = other.count.load()
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? continue
            : return(false)
        a_val : SortedSetIter<T> = .construct(me)
        b_val : SortedSetIter<T> = .construct(other)
        a.store(a_val)
        b.store(b_val)
        jump loop()

    // both have the same count, so both run out together
    block loop()
        x : Option<T> = a.next()
        y : Option<T> = b.next()
        when x
            .Present(x_item) -> compare(x_item, y.unwrap())
            .Absent          -> return(true)

    block compare(x: T, y: T)
        cmp : S32  = x.compare(y)
        eq  : Bool = cmp.eq(0)
        branch eq
            ? loop()
            : return(false)

/// Whether an element equal to `key` is in the set.
/// :param key: The element to look for.
/// :returns: `true` when an equal element is present.
routine SortedSet<T>.has(me: Me, key: T) -> Bool
require T: typename
    block entry()
        root  : @SortedSetNode<T> = me.root
        empty : Bool              = root.is_null()
        branch empty ? return(false): search(root)

    block search(node: @SortedSetNode<T>)
        i      : USize = node.find_index(key)
        count  : USize = node.count.load()
        inside : Bool  = i.lt(count)
        branch inside
            ? maybe_match(node, i)
            : descend_or_missing(node, i)

    block maybe_match(node: @SortedSetNode<T>, i: USize)
        node_key : T    = node.keys.getitem(i)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal ? return(true): descend_or_missing(node, i)

    block descend_or_missing(node: @SortedSetNode<T>, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf ? return(false): descend(node, i)

    block descend(node: @SortedSetNode<T>, i: USize)
        child : @SortedSetNode<T> = node.children.getitem(i)
        jump search(child)

/// Whether an element equal to `key` is in the set.
/// :param key: The element to look for.
/// :returns: `true` when an equal element is present.
routine SortedSet<T>.has(me: @Me, key: T) -> Bool
require T: typename
    block entry()
        result : Bool = me.load().has(key)
        return(result)

/// The `rank`-th smallest element (0 is the smallest).
/// :param rank: The zero-based rank.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
#track_caller
routine SortedSet<T>.get_by_rank(me: Me, rank: USize) -> T
require T: typename
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = rank.lt(count)
        branch in_bounds
            ? select_root()
            : crash_out_of_bounds()

    block select_root()
        root : @SortedSetNode<T> = me.root
        jump select_node(root, rank)

    block select_node(node: @SortedSetNode<T>, remaining: USize)
        jump scan(node, remaining, 0)

    block scan(node: @SortedSetNode<T>, remaining: USize, i: USize)
        count : USize = node.count.load()
        done  : Bool  = i.ge(count)
        branch done
            ? last_child(node, remaining, i)
            : check_child(node, remaining, i)

    block check_child(node: @SortedSetNode<T>, remaining: USize, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? leaf_key(node, remaining, i)
            : internal_child(node, remaining, i)

    block leaf_key(node: @SortedSetNode<T>, remaining: USize, i: USize)
        match : Bool = remaining.eq(i)
        branch match
            ? load_key(node, i)
            : scan(node, remaining, i.add(1))

    block internal_child(node: @SortedSetNode<T>, remaining: USize, i: USize)
        child       : @SortedSetNode<T> = node.children.getitem(i)
        child_count : USize             = child.subtree_count()
        in_child    : Bool              = remaining.lt(child_count)
        branch in_child
            ? select_node(child, remaining)
            : check_key(node, remaining, i, child_count)

    block check_key(node: @SortedSetNode<T>, remaining: USize, i: USize, child_count: USize)
        after_child : USize = remaining.sub(child_count)
        is_key      : Bool  = after_child.eq(0)
        branch is_key
            ? load_key(node, i)
            : scan(node, after_child.sub(1), i.add(1))

    block last_child(node: @SortedSetNode<T>, remaining: USize, i: USize)
        leaf : Bool = node.leaf.load()
        branch leaf
            ? crash_logic_breached()
            : descend_last(node, remaining, i)

    block descend_last(node: @SortedSetNode<T>, remaining: USize, i: USize)
        child : @SortedSetNode<T> = node.children.getitem(i)
        jump select_node(child, remaining)

    block load_key(node: @SortedSetNode<T>, i: USize)
        key : T = node.keys.getitem(i)
        return(key)

/// The `rank`-th smallest element (0 is the smallest).
/// :param rank: The zero-based rank.
/// :returns: A copy of the element.
/// :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
#track_caller
routine SortedSet<T>.get_by_rank(me: @Me, rank: USize) -> T
require T: typename
    block entry()
        result : T = me.load().get_by_rank(rank)
        return(result)

/// Splits the full child at `index` around its middle: the middle element moves up into this node and the upper
/// half into a new right sibling.
/// :param index: The index of the full child.
/// :param alloc: The allocator for the new node.
/// :returns: True when it split, false when the allocator failed (before anything moved).
routine SortedSetNode<T>.split_child(me: @Me, index: USize, alloc: @Allocator) -> Bool
require T: typename
    shared left  : @Me  = me.children.getitem(index)
    shared leaf  : Bool = left.leaf.load()
    shared right : @Me  = Me.construct(leaf, alloc)

    block entry()
        no_right : Bool = right.is_null()
        branch no_right
            ? return(false)
            : continue
        mid         : USize = NODE_KEYS.div(2)
        right_start : USize = mid.add(1)
        right_count : USize = NODE_KEYS.sub(right_start)
        right.keys.copy(0, left.keys, right_start, right_count)
        right.count.store(right_count)
        branch leaf
            ? promote(mid)
            : copy_children(mid, right_count)

    block copy_children(mid: USize, right_count: USize)
        jump child_loop(0, mid, right_count)

    block child_loop(i: USize, mid: USize, right_count: USize)
        done : Bool = i.gt(right_count)
        branch done
            ? promote(mid)
            : child_copy(i, mid, right_count)

    block child_copy(i: USize, mid: USize, right_count: USize)
        src   : USize = mid.add(1).add(i)
        child : @Me   = left.children.getitem(src)
        right.children.setitem(i, child)
        jump child_loop(i.add(1), mid, right_count)

    block promote(mid: USize)
        parent_count : USize = me.count.load()
        me.keys.shift_right(index, parent_count)
        jump shift_children(parent_count, mid)

    block shift_children(i: USize, mid: USize)
        stop : USize = index.add(1)
        done : Bool  = i.lt(stop)
        branch done
            ? install(mid)
            : move_child(i, mid)

    block move_child(i: USize, mid: USize)
        child : @Me = me.children.getitem(i)
        me.children.setitem(i.add(1), child)
        jump shift_children(i.sub(1), mid)

    block install(mid: USize)
        middle_key : T = left.keys.getitem(mid)
        me.keys.setitem(index, middle_key)
        me.children.setitem(index.add(1), right)
        left.count.store(mid)
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        left.recount()
        right.recount()
        me.recount()
        return(true)

/// Inserts `key` below a node that isn't full, splitting full children on the way down. An equal element must not
/// already be in the subtree (`add_result` checks first).
/// :param key: The element to insert.
/// :param alloc: The allocator for nodes made by splits.
/// :returns: True when it inserted, false when a split failed to allocate. The tree then holds the same elements,
///     some nodes already split.
routine SortedSetNode<T>.insert_nonfull(me: @Me, key: T, alloc: @Allocator) -> Bool
require T: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? insert_leaf()
            : insert_internal()

    block insert_leaf()
        slot  : USize = me.find_index(key)
        count : USize = me.count.load()
        me.keys.shift_right(slot, count)
        me.keys.setitem(slot, key)
        new_count : USize = count.add(1)
        me.count.store(new_count)
        me.subtree_count.store(new_count)
        return(true)

    block insert_internal()
        slot        : USize = me.find_index(key)
        child       : @Me   = me.children.getitem(slot)
        child_count : USize = child.count.load()
        full        : Bool  = child_count.eq(NODE_KEYS)
        branch full
            ? split_then_insert(slot, child)
            : descend(slot, child)

    block split_then_insert(slot: USize, child: @Me)
        split : Bool = me.split_child(slot, alloc)
        branch split
            ? continue
            : return(false)
        pivot     : T     = me.keys.getitem(slot)
        cmp       : S32   = key.compare(pivot)
        go_right  : Bool  = cmp.gt(0)
        next_slot : USize = go_right
            ? slot.add(1)
            : slot
        next_child : @Me = me.children.getitem(next_slot)
        jump descend(next_slot, next_child)

    block descend(slot: USize, child: @Me)
        inserted : Bool = child.insert_nonfull(key, alloc)
        branch inserted
            ? continue
            : return(false)
        me.recount()
        return(true)

/// Adds `key` to the set in sorted position unless an equal element is already present.
/// :param key: The element to add.
/// :returns: `true` when `key` was new, `false` when it was already present.
/// :throws: Crashes with `MemoryAllocationError` when a node cannot be allocated. See {SortedSet<T>.add_result} for a recoverable form.
#track_caller
routine SortedSet<T>.add(me: @Me, key: T) -> Bool
require T: typename
    block entry()
        added : Result<Bool, AllocFailed> = me.add_result(key)
        when added
            .Success(is_new) -> return(is_new)
            .Failure         -> crash_allocation()

/// `add`, returning a Failure instead of crashing when the allocator fails.
/// :param key: The element to add.
/// :returns: `Success` holding whether `key` was new.
/// :throws: Returns `Failure(AllocFailed)` when a node cannot be allocated.
routine SortedSet<T>.add_result(me: @Me, key: T) -> Result<Bool, AllocFailed>
require T: typename
    block entry()
        exists : Bool = me.has(key)
        branch exists
            ? return(.Success(false))
            : insert()

    block insert()
        alloc : @Allocator        = me.alloc.load()
        root  : @SortedSetNode<T> = me.root.load()
        empty : Bool              = root.is_null()
        branch empty
            ? first_root(alloc)
            : insert_root(root, alloc)

    block first_root(alloc: @Allocator)
        root    : @SortedSetNode<T> = SortedSetNode<T>.construct(true, alloc)
        no_root : Bool              = root.is_null()
        branch no_root
            ? return(.Failure(AllocFailed {}))
            : continue
        root.keys.setitem(0, key)
        root.count.store(1)
        root.subtree_count.store(1)
        me.root.store(root)
        me.count.store(1)
        return(.Success(true))

    block insert_root(root: @SortedSetNode<T>, alloc: @Allocator)
        root_count : USize = root.count.load()
        full       : Bool  = root_count.eq(NODE_KEYS)
        branch full
            ? split_root(root, alloc)
            : insert_nonfull(root, alloc)

    block split_root(old_root: @SortedSetNode<T>, alloc: @Allocator)
        new_root : @SortedSetNode<T> = SortedSetNode<T>.construct(false, alloc)
        no_root  : Bool              = new_root.is_null()
        branch no_root
            ? return(.Failure(AllocFailed {}))
            : continue
        new_root.children.setitem(0, old_root)
        split : Bool = new_root.split_child(0, alloc)
        branch split
            ? install_root(new_root, alloc)
            : discard_root(new_root, alloc)

    block install_root(new_root: @SortedSetNode<T>, alloc: @Allocator)
        me.root.store(new_root)
        jump insert_nonfull(new_root, alloc)

    block discard_root(new_root: @SortedSetNode<T>, alloc: @Allocator)
        deallocate<SortedSetNode<T>>(new_root, alloc)
        return(.Failure(AllocFailed {}))

    block insert_nonfull(root: @SortedSetNode<T>, alloc: @Allocator)
        inserted : Bool = root.insert_nonfull(key, alloc)
        branch inserted
            ? continue
            : return(.Failure(AllocFailed {}))
        next_count : USize = me.count.load().add(1)
        next_count.store_into(me.count)
        return(.Success(true))

/// Removes the key at `index` from a leaf by shifting the later keys left.
/// :param index: The position of the key within the leaf.
/// :returns: The removed key.
routine SortedSetNode<T>.remove_leaf_at(me: @Me, index: USize) -> T
require T: typename
    block entry()
        old   : T     = me.keys.getitem(index)
        count : USize = me.count.load()
        me.keys.shift_left(index, count)
        new_count : USize = count.sub(1)
        me.count.store(new_count)
        me.subtree_count.store(new_count)
        return(old)

// Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
// count >= NODE_MIN_KEYS - 1.
// Helpers below ensure a child has count >= NODE_MIN_KEYS (= t) before any deletion
// descent so the child can absorb a one-key drop without underflowing.

/// Rotates one key from child `i - 1` through the parent into the front of child `i`, so child `i` gains a key. Subtree counts are updated.
/// :param i: The index of the child that is short of keys.
routine SortedSetNode<T>.borrow_from_left(me: @Me, i: USize) -> Void
require T: typename
    shared separator   : USize = i.sub(1)
    shared left        : @Me   = me.children.getitem(separator)
    shared child       : @Me   = me.children.getitem(i)
    shared left_count  : USize = left.count.load()
    shared child_count : USize = child.count.load()

    block entry()
        child.keys.shift_right(0, child_count)
        pivot : T = me.keys.getitem(separator)
        child.keys.setitem(0, pivot)
        new_pivot : T = left.keys.getitem(left_count.sub(1))
        me.keys.setitem(separator, new_pivot)
        leaf : Bool = child.leaf.load()
        branch leaf
            ? finalize()
            : move_child()

    block move_child()
        children : USize = child_count.add(1)
        child.children.shift_right(0, children)
        moved : @Me = left.children.getitem(left_count)
        child.children.setitem(0, moved)
        jump finalize()

    block finalize()
        left.count.store(left_count.sub(1))
        child.count.store(child_count.add(1))
        left.recount()
        child.recount()
        me.recount()
        return()

/// Rotates one key from child `i + 1` through the parent into the end of child `i`, so child `i` gains a key. Subtree counts are updated.
/// :param i: The index of the child that is short of keys.
routine SortedSetNode<T>.borrow_from_right(me: @Me, i: USize) -> Void
require T: typename
    shared child       : @Me   = me.children.getitem(i)
    shared right       : @Me   = me.children.getitem(i.add(1))
    shared child_count : USize = child.count.load()
    shared right_count : USize = right.count.load()

    block entry()
        pivot : T = me.keys.getitem(i)
        child.keys.setitem(child_count, pivot)
        new_pivot : T = right.keys.getitem(0)
        me.keys.setitem(i, new_pivot)
        right.keys.shift_left(0, right_count)
        leaf : Bool = child.leaf.load()
        branch leaf
            ? finalize()
            : move_child()

    block move_child()
        moved : @Me = right.children.getitem(0)
        child.children.setitem(child_count.add(1), moved)
        right.children.shift_left(0, right_count.add(1))
        jump finalize()

    block finalize()
        child.count.store(child_count.add(1))
        right.count.store(right_count.sub(1))
        child.recount()
        right.recount()
        me.recount()
        return()

/// Merges child `i + 1` and the separating key into child `i` and frees the emptied node, shrinking this node by one key.
/// :param i: The index of the left child of the pair.
/// :param alloc: The allocator that frees the merged node.
routine SortedSetNode<T>.merge_children(me: @Me, i: USize, alloc: @Allocator) -> Void
require T: typename
    shared left        : @Me   = me.children.getitem(i)
    shared right       : @Me   = me.children.getitem(i.add(1))
    shared left_count  : USize = left.count.load()
    shared right_count : USize = right.count.load()

    block entry()
        pivot : T = me.keys.getitem(i)
        left.keys.setitem(left_count, pivot)
        dst_start : USize = left_count.add(1)
        left.keys.copy(dst_start, right.keys, 0, right_count)
        leaf : Bool = left.leaf.load()
        branch leaf
            ? finalize()
            : copy_children()

    block copy_children()
        left.children.copy(left_count.add(1), right.children, 0, right_count.add(1))
        jump finalize()

    block finalize()
        left.count.store(left_count.add(1).add(right_count))
        parent_count : USize = me.count.load()
        me.keys.shift_left(i, parent_count)
        me.children.shift_left(i.add(1), parent_count.add(1))
        me.count.store(parent_count.sub(1))
        deallocate<Me>(right, alloc)
        left.recount()
        me.recount()
        return()

/// Makes sure child `i` has at least `NODE_MIN_KEYS` keys before a deletion descends into it, by borrowing from a sibling or merging with one.
/// :param i: The index of the child about to be descended into.
/// :param alloc: The allocator that frees a merged node.
/// :returns: The index of the child to descend into, which differs from `i` when a merge with the left sibling happened.
#track_caller
routine SortedSetNode<T>.ensure_min(me: @Me, i: USize, alloc: @Allocator) -> USize
require T: typename
    block entry()
        child       : @Me   = me.children.getitem(i)
        child_count : USize = child.count.load()
        ok          : Bool  = child_count.ge(NODE_MIN_KEYS)
        branch ok ? return(i): try_left()

    block try_left()
        has_left : Bool = i.gt(0)
        branch has_left
            ? check_left()
            : try_right(false)

    block check_left()
        left       : @Me   = me.children.getitem(i.sub(1))
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN_KEYS)
        branch left_ok
            ? do_borrow_left()
            : try_right(true)

    block do_borrow_left()
        me.borrow_from_left(i)
        return(i)

    block try_right(has_left: Bool)
        parent_count : USize = me.count.load()
        has_right    : Bool  = i.lt(parent_count)
        branch has_right
            ? check_right(has_left)
            : pick_merge_no_right(has_left)

    block check_right(has_left: Bool)
        right       : @Me   = me.children.getitem(i.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN_KEYS)
        branch right_ok
            ? do_borrow_right()
            : pick_merge(has_left)

    block do_borrow_right()
        me.borrow_from_right(i)
        return(i)

    block pick_merge(has_left: Bool)
        branch has_left
            ? merge_with_left()
            : merge_with_right()

    block pick_merge_no_right(has_left: Bool)
        branch has_left
            ? merge_with_left()
            : crash_logic_breached()

    block merge_with_left()
        merged_at : USize = i.sub(1)
        me.merge_children(merged_at, alloc)
        return(merged_at)

    block merge_with_right()
        me.merge_children(i, alloc)
        return(i)

/// Removes and returns the largest key in this subtree, rebalancing children on the way down.
/// :param alloc: The allocator used when nodes merge.
/// :returns: The removed largest key.
routine SortedSetNode<T>.take_max(me: @Me, alloc: @Allocator) -> T
require T: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? leaf_take()
            : descend()

    block leaf_take()
        count : USize = me.count.load()
        index : USize = count.sub(1)
        key   : T     = me.remove_leaf_at(index)
        return(key)

    block descend()
        count  : USize = me.count.load()
        actual : USize = me.ensure_min(count, alloc)
        child  : @Me   = me.children.getitem(actual)
        key    : T     = child.take_max(alloc)
        me.recount()
        return(key)

/// Removes and returns the smallest key in this subtree, rebalancing children on the way down.
/// :param alloc: The allocator used when nodes merge.
/// :returns: The removed smallest key.
routine SortedSetNode<T>.take_min(me: @Me, alloc: @Allocator) -> T
require T: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? leaf_take()
            : descend()

    block leaf_take()
        key : T = me.remove_leaf_at(0)
        return(key)

    block descend()
        actual : USize = me.ensure_min(0, alloc)
        child  : @Me   = me.children.getitem(actual)
        key    : T     = child.take_min(alloc)
        me.recount()
        return(key)

/// Removes `key` from this subtree, rebalancing children on the way down so no node underflows.
/// :param key: The key to remove.
/// :param alloc: The allocator used when nodes merge.
/// :returns: `true` when the key was found and removed, `false` otherwise.
routine SortedSetNode<T>.remove(me: @Me, key: T, alloc: @Allocator) -> Bool
require T: typename
    shared slot : USize = me.find_index(key)

    block entry()
        count  : USize = me.count.load()
        inside : Bool  = slot.lt(count)
        branch inside
            ? maybe_match()
            : descend_or_missing()

    block maybe_match()
        node_key : T    = me.keys.getitem(slot)
        cmp      : S32  = key.compare(node_key)
        equal    : Bool = cmp.eq(0)
        branch equal
            ? remove_here()
            : descend_or_missing()

    block remove_here()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? remove_leaf()
            : remove_internal()

    block remove_leaf()
        me.remove_leaf_at(slot)
        return(true)

    block remove_internal()
        left       : @Me   = me.children.getitem(slot)
        left_count : USize = left.count.load()
        left_ok    : Bool  = left_count.ge(NODE_MIN_KEYS)
        branch left_ok
            ? take_pred()
            : try_succ()

    block take_pred()
        left        : @Me = me.children.getitem(slot)
        replacement : T   = left.take_max(alloc)
        me.keys.setitem(slot, replacement)
        me.recount()
        return(true)

    block try_succ()
        right       : @Me   = me.children.getitem(slot.add(1))
        right_count : USize = right.count.load()
        right_ok    : Bool  = right_count.ge(NODE_MIN_KEYS)
        branch right_ok
            ? take_succ()
            : merge_and_recurse()

    block take_succ()
        right       : @Me = me.children.getitem(slot.add(1))
        replacement : T   = right.take_min(alloc)
        me.keys.setitem(slot, replacement)
        me.recount()
        return(true)

    block merge_and_recurse()
        me.merge_children(slot, alloc)
        merged  : @Me  = me.children.getitem(slot)
        removed : Bool = merged.remove(key, alloc)
        me.recount()
        return(removed)

    block descend_or_missing()
        leaf : Bool = me.leaf.load()
        branch leaf ? return(false): descend()

    block descend()
        actual  : USize = me.ensure_min(slot, alloc)
        child   : @Me   = me.children.getitem(actual)
        removed : Bool  = child.remove(key, alloc)
        me.recount()
        return(removed)

/// Removes `key` from the set, shrinking the tree when the root empties.
/// :param key: The element to remove.
/// :returns: `true` when an element was removed, `false` when it was not present.
routine SortedSet<T>.remove(me: @Me, key: T) -> Bool
require T: typename
    shared root : @SortedSetNode<T> = me.root.load()

    block entry()
        empty : Bool = root.is_null()
        branch empty
            ? return(false)
            : remove_root()

    block remove_root()
        alloc   : @Allocator = me.alloc.load()
        removed : Bool       = root.remove(key, alloc)
        branch removed
            ? after_remove()
            : return(false)

    block after_remove()
        remaining_count : USize = me.count.load().sub(1)
        remaining_count.store_into(me.count)
        root_count : USize = root.count.load()
        empty_root : Bool  = root_count.eq(0)
        branch empty_root
            ? maybe_shrink()
            : return(true)

    block maybe_shrink()
        leaf : Bool = root.leaf.load()
        branch leaf
            ? clear_root()
            : shrink()

    block clear_root()
        alloc : @Allocator = me.alloc.load()
        deallocate<SortedSetNode<T>>(root, alloc)
        me.root.store(null)
        return(true)

    block shrink()
        alloc    : @Allocator        = me.alloc.load()
        new_root : @SortedSetNode<T> = root.children.getitem(0)
        deallocate<SortedSetNode<T>>(root, alloc)
        me.root.store(new_root)
        return(true)

/// Frees this node and every node below it through `alloc`. An internal node has `count` keys and `count + 1`
/// children. The elements are not destructed.
/// :param alloc: The allocator the nodes came from.
routine SortedSetNode<T>.free_recursive(me: @Me, alloc: @Allocator) -> Void
require T: typename
    block entry()
        leaf : Bool = me.leaf.load()
        branch leaf
            ? free_self()
            : free_children()

    block free_children()
        count : USize = me.count.load()
        jump child_loop(0, count.add(1))

    block child_loop(i: USize, child_count: USize)
        done : Bool = i.ge(child_count)
        branch done
            ? free_self()
            : free_child(i, child_count)

    block free_child(i: USize, child_count: USize)
        child : @Me = me.children.getitem(i)
        child.free_recursive(alloc)
        jump child_loop(i.add(1), child_count)

    block free_self()
        deallocate<Me>(me, alloc)
        return()

/// Frees the set's memory through its allocator and resets it to the empty state, so it can be reused or destructed again. The stored values themselves are not destructed.
/// :note: Safe to call on a never-filled instance, where it only resets the fields.
#track_caller
routine SortedSet<T>.destruct(me: @Me) -> Void
require T: typename
    shared root : @SortedSetNode<T> = me.root.load()

    block entry()
        empty : Bool = root.is_null()
        branch empty
            ? reset()
            : free_root()

    block free_root()
        alloc : @Allocator = me.alloc.load()
        root.free_recursive(alloc)
        jump reset()

    block reset()
        me.root.store(null)
        me.count.store(0)
        return()

/// Destructs every element, then the collection itself: for elements the collection owns, such as inner lists.
/// Elements that are only borrowed (a `Ptr` to memory owned elsewhere) must not be destructed this way.
#track_caller
routine SortedSet<T>.destruct_all(me: @Me) -> Void
require T: typename, Comparable<T>, Destructible<T>
    shared iter_val : SortedSetIter<T>  = .construct(me)
    shared iter     : @SortedSetIter<T> <- iter_val
    shared slot     : @T                <- uninit

    block entry()
        jump next()

    block next()
        item : Option<T> = iter.next()
        when item
            .Present(value) -> element(value)
            .Absent         -> finish()

    block element(value: T)
        slot.store(value)
        slot.destruct()
        jump next()

    block finish()
        me.destruct()
        return()

// -- text -----------------------------------------------------------------------

/// The elements in sorted order, each diagnosed (strings quoted): {1, 2, 3}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine SortedSet<T>.represent_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, Comparable<T>, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : SortedSetIter<T> = .construct(whole)
        claim iter : @SortedSetIter<T> <- iter_val
        diagnose_items<T, SortedSetIter<T>, TWriter>(out, iter, "{", "}")
        return()

/// The elements in sorted order, each diagnosed: {1, 2, 3}.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The writer to write to.
routine SortedSet<T>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, Comparable<T>, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    block entry()
        claim whole : @Me <- me
        iter_val : SortedSetIter<T> = .construct(whole)
        claim iter : @SortedSetIter<T> <- iter_val
        diagnose_items<T, SortedSetIter<T>, TWriter>(out, iter, "{", "}")
        return()
