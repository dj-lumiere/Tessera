// Tessera stdlib: F128 tan, correctly rounded
//
// CORE-MATH has no binary128 tan, so tan runs in two tiers, as tan_pi does (F128Extra.tess):
//
// - fast: |x| = k π/2 + θ by f128_reduce, then sin θ / cos θ (k even) or -cos θ / sin θ (k odd) in F128Extended.
//   The result is kept when all of it × (1 ± 2^-F128_TAN_BAND) rounds to the same F128.
// - exact: otherwise the same formulas in F128Big (448 bits, F128Big.tess), rounded once.
//
// The band is measured, not proven: on about 110000 inputs (every exponent, tiny ones, 1/2 to 2, near k π/4 and
// k π/2 for small and huge k, up to F128.MAX) the fast tier's worst relative error against mpmath was 2^-150.2, at
// |θ| near π/4 where the sin and cos series stop, so 2^-145 leaves about 5 bits. Results near a rounding boundary do
// occur: just above 2^-57, tan x - x = x³/3 + … sweeps past the midpoints between F128s so slowly that the nearest
// x lands within about 2^-225 of one, and the fast tier alone rounds some of those the wrong way
// (tests/f128_tan.tess has them).
//
// f128_reduce keeps 256 bits of x × 2/π's fraction, so θ is good to about 2^-256 absolute, and tan's relative error
// grows as θ shrinks. Past |x| = 1/2, a θ under 2^-90 therefore goes straight to the exact tier (the reduction
// alone would leave 2^-166 relative there). The closest an F128 gets to a multiple of π/2 is |θ| = 2^-123.3, found
// by continued fractions of 2^e × 2/π for every exponent: x = 8794873135033829349702184924722639 × 2^1852, whose
// tan is about 1.27e37. big_reduce's θ is good to 2^-449 absolute, so even there the exact tier keeps 2^-325
// relative.
//
// The only exact result is tan(±0) = ±0: for a rational x ≠ 0, e^(2ix) is transcendental (Lindemann), so tan x =
// -i (e^(2ix) - 1) / (e^(2ix) + 1) is too, and it is never an F128 or a midpoint between two. Below |x| = 2^-57 the
// answer is x itself: tan x - x < x³/2 < 2^-115 |x|, under half an ulp of x (at least 2^-114 |x|), and tan x lies
// on x's side away from zero.

module Standard::Core

/// The fast tier's error band for tan, as a power of two: an F128Extended result is kept only when all of it × (1 ± 2^-145) rounds to the same F128.
/// :note: Measured, not proven: the worst fast-tier error seen against mpmath was about 2^-150.2, so the band leaves about 5 bits.
preset F128_TAN_BAND: S64 = 145

/// Past |x| = 1/2, the fast tier needs |θ| >= 2^-F128_TAN_LOOSE (else f128_reduce's 2^-256 is too coarse).
preset F128_TAN_LOOSE: S64 = 90

/// tan x, correctly rounded (round to nearest, ties to even): ±0 for ±0, a quiet NaN for NaN, NaN for infinities.
/// :returns: tan(`self`).
routine F128.tan(self: Self) -> Self
    block entry()
        r : Self = f128_tan(self, false)
        return(r)

/// tan x, correctly rounded, as {F128.tan}. Below |x| = 2^-57 the answer is x itself.
/// :param x: The argument.
/// :param exact: True skips the fast tier (the tests use it to check the exact tier on its own).
/// :returns: tan x.
routine f128_tan(x: F128, exact: Bool) -> F128
    block entry()
        bits     : U128 = x.bits()
        nan      : Bool = f128_is_nan_bits(bits)
        infinite : Bool = x.is_infinite()
        tiny     : Bool = f128_exponent(bits).lt(F128_BIAS.sub(57))  // |x| < 2^-57, zeros too
        when
            nan      -> return(f128_of(f128_quiet(bits)))
            infinite -> return(F128.NAN)
            tiny     -> return(x)
            else     -> general()

    block general()
        r : F128 = f128_tan_general(x, exact)
        return(r)

/// tan x for a finite x with |x| >= 2^-57, by the two tiers.
/// :param x: The argument.
/// :param exact: True skips the fast tier.
/// :returns: tan x, correctly rounded.
routine f128_tan_general(x: F128, exact: Bool) -> F128
    block entry()
        branch exact
            ? slow()
            : fast()

    block fast()
        red   : Reduced = f128_reduce(x)
        loose : Bool    = wide_theta_is_loose(x, red.theta)
        branch loose
            ? slow()
            : estimate(red)

    block estimate(red: Reduced)
        w       : F128Extended = wide_tan(x, red)
        rounded : WideRounding = wide_round_within(w, F128_TAN_BAND)
        branch rounded.ok
            ? return(rounded.value)
            : slow()

    block slow()
        r : F128 = big_tan(x)
        return(r)

/// Whether f128_reduce's θ is too coarse for the fast tier: |x| >= 1/2 (below it θ is |x| exactly) and θ is
/// zero or under 2^-F128_TAN_LOOSE.
/// :param x: The argument.
/// :param theta: θ from {f128_reduce}.
/// :returns: True when the exact tier must run.
routine wide_theta_is_loose(x: F128, theta: F128Extended) -> Bool
    block entry()
        reduced : Bool = f128_exponent(x.bits()).ge(F128_BIAS.sub(1))
        small   : Bool = theta.is_zero().bitor(theta.exponent.lt(0.sub(F128_TAN_LOOSE)))
        r       : Bool = reduced.bitand(small)
        return(r)

/// The fast tier's tan x before rounding, from |x| = k π/2 + θ with θ nonzero.
/// :param x: The argument (its sign is applied at the end).
/// :param red: The reduction of |x|.
/// :returns: tan x at 192 bits.
routine wide_tan(x: F128, red: Reduced) -> F128Extended
    shared s : F128Extended = wide_sin_core(red.theta)
    shared c : F128Extended = wide_cos_core(red.theta)

    block entry()
        odd : Bool = red.quadrant.bitand(1).eq(1)
        branch odd
            ? cotangent()
            : tangent()

    block tangent()
        jump signed(s.div(c))

    // tan(θ + π/2) = -cot θ
    block cotangent()
        jump signed(c.div(s).neg())

    // tan is odd, and the reduction took |x|
    block signed(t: F128Extended)
        negative : Bool         = f128_is_negative_bits(x.bits())
        r        : F128Extended = negative
            ? t.neg()
            : t
        return(r)

/// The exact tier: the same formulas in F128Big, rounded once.
/// :param x: The argument, finite.
/// :returns: tan x, correctly rounded.
routine big_tan(x: F128) -> F128
    shared red : BigReduced = big_reduce(x)
    shared s   : F128Big    = big_sin_core(red.theta)
    shared c   : F128Big    = big_cos_core(red.theta)

    block entry()
        odd : Bool = red.quadrant.bitand(1).eq(1)
        branch odd
            ? cotangent()
            : tangent()

    block tangent()
        jump signed(s.div(c))

    block cotangent()
        jump signed(c.div(s).neg())

    block signed(t: F128Big)
        negative : Bool    = f128_is_negative_bits(x.bits())
        v        : F128Big = negative
            ? t.neg()
            : t
        r : F128 = v.to<F128>()
        return(r)
