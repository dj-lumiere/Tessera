// Tessera stdlib algorithm: sort
//
// Hybrid sort for List[T]. T must satisfy Comparable[T].
//
// Strategy:
//   * count <= 32 — straight insertion sort, no allocation.
//   * count  > 32 — insertion-sort initial runs of 32 elements, then merge
//     adjacent runs bottom-up using a scratch buffer the size of the list.
//     Buffers ping-pong between data and scratch. If the final pass leaves
//     the result in scratch, it is copied back to data before returning.
//
// Stable: equal elements keep their original relative order (the merge step
// takes from the left run on ties).

module Standard/Core

import Standard/Alloc
import Standard/Collections

/// The length of the runs that `sort` insertion-sorts first, and the length up to which a list is sorted by insertion alone.
preset SORT_RUN: USize = 32

/// Two adjacent sorted runs of one buffer, the half-open ranges `[lo, mid)` and `[mid, hi)`, that a merge step joins
/// into `[lo, hi)`.
record MergeRuns
    /// The index of the start of the left run.
    lo: USize
    /// The index of the end of the left run and the start of the right run.
    mid: USize
    /// The index of the end of the right run.
    hi: USize

/// Makes a `MergeRuns` from its fields.
/// :param lo: Its `lo`.
/// :param mid: Its `mid`.
/// :param hi: Its `hi`.
/// :returns: The new value.
routine MergeRuns.construct(lo: USize, mid: USize, hi: USize) -> Me
    return(Me(lo, mid, hi))

/// Releases nothing: a `MergeRuns` holds no memory of its own.
routine MergeRuns.destruct(me: @Me) -> Void
    return()

// -- insertion sort over a half-open range [lo, hi) ----------------------------

/// Stable insertion sort of the elements `data[lo..hi)` in place by `compare`, with no allocation.
/// :typeparam T: The element type, which must conform to {Comparable}.
/// :param data: The elements to sort.
/// :param lo: The index of the first element of the range.
/// :param hi: The index one past the last element of the range.
routine sort_insertion[T](data: @T, lo: USize, hi: USize) -> Void
require T: typename, Comparable[T]
    jump outer(lo.add(1))

    block outer(i: USize)
        done: Bool = i.ge(hi)
        branch done
            ? return()
            : load(i)

    block load(i: USize)
        x: T = data.stride(i).peek()
        jump inner(i, i, x)

    block inner(i: USize, j: USize, x: T)
        at_start: Bool = j.le(lo)
        branch at_start
            ? place(i, j, x)
            : check(i, j, x)

    block check(i: USize, j: USize, x: T)
        prev: USize = j.sub(1)
        y: T = data.stride(prev).peek()
        cmp: S32 = y.compare(x)
        greater: Bool = cmp.gt(0)
        branch greater
            ? shift(i, j, x, y, prev)
            : place(i, j, x)

    block shift(i: USize, j: USize, x: T, y: T, prev: USize)
        data.stride(j).poke(y)
        jump inner(i, prev, x)

    block place(i: USize, j: USize, x: T)
        data.stride(j).poke(x)
        jump outer(i.add(1))

// -- merge two sorted half-open ranges [lo, mid) and [mid, hi) -----------------
//
// Reads from src, writes the merged result into dst[lo..hi). Stable: when
// elements compare equal, the one from the left run is taken first.

/// Merges the sorted runs `src[runs.lo..runs.mid)` and `src[runs.mid..runs.hi)` into `dst[runs.lo..runs.hi)`. Stable: on ties the left element goes first.
/// :typeparam T: The element type, which must conform to {Comparable}.
/// :param src: The elements holding the two sorted runs.
/// :param dst: Where the merged run is written.
/// :param runs: Where the two adjacent runs start and end.
routine sort_merge[T](src: @T, dst: @T, runs: MergeRuns) -> Void
require T: typename, Comparable[T]
    local lo: USize = runs.lo
    local mid: USize = runs.mid
    local hi: USize = runs.hi
    local k: @USize <- lo

    jump loop(lo, mid)

    block loop(i: USize, j: USize)
        i_done: Bool = i.ge(mid)
        branch i_done
            ? drain_b(j)
            : check_j(i, j)

    block check_j(i: USize, j: USize)
        j_done: Bool = j.ge(hi)
        branch j_done
            ? drain_a(i)
            : pick(i, j)

    block pick(i: USize, j: USize)
        a: T = src.stride(i).peek()
        b: T = src.stride(j).peek()
        cmp: S32 = a.compare(b)
        take_a: Bool = cmp.le(0)
        branch take_a
            ? take_a(i, j, a)
            : take_b(i, j, b)

    block take_a(i: USize, j: USize, a: T)
        dst.stride(k.peek()).poke(a)
        k.peek().add(1).poke_into(k)
        jump loop(i.add(1), j)

    block take_b(i: USize, j: USize, b: T)
        dst.stride(k.peek()).poke(b)
        k.peek().add(1).poke_into(k)
        jump loop(i, j.add(1))

    block drain_a(i: USize)
        done: Bool = i.ge(mid)
        branch done
            ? return()
            : copy_a(i)

    block copy_a(i: USize)
        v: T = src.stride(i).peek()
        dst.stride(k.peek()).poke(v)
        k.peek().add(1).poke_into(k)
        jump drain_a(i.add(1))

    block drain_b(j: USize)
        done: Bool = j.ge(hi)
        branch done
            ? return()
            : copy_b(j)

    block copy_b(j: USize)
        v: T = src.stride(j).peek()
        dst.stride(k.peek()).poke(v)
        k.peek().add(1).poke_into(k)
        jump drain_b(j.add(1))

// -- one bottom-up pass merging every pair of width-sized runs -----------------

/// One bottom-up merge pass over the first `n` elements: merges every adjacent pair of sorted runs of `width` elements from `src` into `dst`, the last pair possibly shorter.
/// :typeparam T: The element type, which must conform to {Comparable}.
/// :param src: The elements to read the runs from.
/// :param dst: Where the merged runs are written.
/// :param n: The number of elements.
/// :param width: The length of each sorted run in `src`.
routine sort_merge_pass[T](src: @T, dst: @T, n: USize, width: USize) -> Void
require T: typename, Comparable[T]
    jump loop(0)

    block loop(lo: USize)
        done: Bool = lo.ge(n)
        branch done
            ? return()
            : run(lo)

    block run(lo: USize)
        mid_raw: USize = lo.add(width)
        hi_raw: USize = mid_raw.add(width)
        mid_ok: Bool = mid_raw.le(n)
        mid: USize = mid_ok
            ? mid_raw
            : n
        hi_ok: Bool = hi_raw.le(n)
        hi: USize = hi_ok
            ? hi_raw
            : n
        sort_merge[T](src, dst, runs: MergeRuns(lo: lo, mid: mid, hi: hi))
        jump loop(hi_raw)

// -- public entry point --------------------------------------------------------

/// Sorts the list in place into ascending `compare` order. Stable, so equal elements keep their order. A list of 32 elements or fewer is insertion-sorted without allocating. A longer one is merge-sorted through a scratch buffer from the list's allocator, and the buffer is freed afterward.
/// :typeparam T: The element type, which must conform to {Comparable}.
/// :throws: Crashes with `MemoryAllocationError` if the scratch buffer cannot be allocated.
#track_caller
routine List[T].sort(me: @Me) -> Void
require T: typename, Comparable[T]
    local n: USize = me.count.peek()

    small: Bool = n.le(SORT_RUN)
    branch small
        ? small_sort()
        : big_sort()

    block small_sort()
        data: @T = me.storage.data.peek()
        sort_insertion[T](data, lo: 0, hi: n)
        return()

    block big_sort()
        data: @T = me.storage.data.peek()
        alloc: @MemoryManager = me.storage.alloc.peek()
        scratch: @T = allocate[T](count: n, alloc)
        failed: Bool = scratch.is_null()
        branch failed
            ? crash_allocation()
            : run_loop(0, data, scratch)

    block run_loop(lo: USize, data: @T, scratch: @T)
        done: Bool = lo.ge(n)
        branch done
            ? pass_start(data, scratch)
            : run_step(lo, data, scratch)

    block run_step(lo: USize, data: @T, scratch: @T)
        hi_raw: USize = lo.add(SORT_RUN)
        hi_ok: Bool = hi_raw.le(n)
        hi: USize = hi_ok
            ? hi_raw
            : n
        sort_insertion[T](data, lo, hi)
        jump run_loop(hi_raw, data, scratch)

    block pass_start(data: @T, scratch: @T)
        jump pass_loop(SORT_RUN, data, scratch, data, scratch)

    block pass_loop(width: USize, src: @T, dst: @T, data: @T, scratch: @T)
        done: Bool = width.ge(n)
        branch done
            ? merged(src, data, scratch)
            : pass(width, src, dst, data, scratch)

    block pass(width: USize, src: @T, dst: @T, data: @T, scratch: @T)
        sort_merge_pass[T](src, dst, n, width)
        jump pass_loop(width.mul(2), dst, src, data, scratch)

    block merged(src: @T, data: @T, scratch: @T)
        in_place: Bool = src.ptr_eq(data)
        branch in_place
            ? release(scratch)
            : copy_back(src, data, scratch)

    block copy_back(src: @T, data: @T, scratch: @T)
        src.copy_into(dst: data, count: n)
        jump release(scratch)

    block release(scratch: @T)
        deallocate[T](data: scratch, alloc: me.storage.alloc.peek())
        return()
