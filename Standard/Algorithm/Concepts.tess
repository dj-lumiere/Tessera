// Tessera stdlib algorithm concepts
//
// Concepts are buildtime required routine sets. They do not imply a runtime
// vtable by themselves// a generic routine names an Ops type and constrains it
// with one of these concepts.
//
// `routine Self.name` belongs to the concept's first parameter; a concept whose
// routines belong to another parameter names it (`routine Iter.next`). A type
// satisfies a concept through a `conform` clause or declaration, checked against
// these signatures// HashEqual, which only groups Equal and Hash, needs none.

module Standard::Core

/// Types whose values can be compared for equality with `eq`.
/// :typeparam T: The type compared for equality.
concept Equal<T>
require T: typename
    /// True when `self` and `other` are equal.
    /// :param other: The value to compare with.
    /// :returns: True when the two values are equal.
    routine Self.eq(self: Self, other: Self) -> Bool

/// Types that can be hashed to a U64 with `hash`. Values that are equal must hash the same.
/// :typeparam T: The type that is hashed.
concept Hash<T>
require T: typename
    /// The 64-bit hash of `self`.
    /// :returns: The 64-bit hash.
    routine Self.hash(self: Self) -> U64

/// Types that are both Equal and Hash, as hash tables and sets require of their keys.
/// :typeparam T: The key type.
concept HashEqual<T>
conform Equal<T>, Hash<T>
require T: typename

/// Types with a three-way ordering through `compare`, as sorting requires.
/// :typeparam T: The type being ordered.
concept Compare<T>
require T: typename
    /// Return -1 when self < other, 0 when they're equal, and 1 when self > other.
    routine Self.compare(self: Self, other: Self) -> S32

/// Types ordered by `less`, as priority queues and heaps require.
/// :typeparam T: The type being ordered.
concept Priority<T>
require T: typename
    /// Return true when self should be closer to the top than other.
    routine Self.less(self: Self, other: Self) -> Bool

/// An iterator type `Iter` that produces elements of type `T` one at a time through `next`.
/// :typeparam T: The element type produced.
/// :typeparam Iter: The iterator type.
concept Iterator<T, Iter>
require T: typename, Iter: typename
    /// Advance and return the next element, or Option<T>.Absent when exhausted.
    /// next() mutates the iterator state, so self is a pointer. The routine belongs
    /// to Iter, so it names its owner (Self in it is Iter).
    routine Iter.next(self: @Self) -> Option<T>

/// A type that holds resources (memory, handles) and releases them in `destruct`. Collections of such values offer
/// `destruct_all`, which destructs the elements too.
concept Destruct<T>
require T: typename
    /// Releases what the value holds and leaves it empty.
    routine Self.destruct(self: @Self) -> Void
