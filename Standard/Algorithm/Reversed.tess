// Tessera stdlib algorithm: Reversed[T]
//
// A value of T whose compare is T's flipped: the larger T is the smaller
// Reversed[T]. A PriorityQueue takes the smallest priority first, so a
// Reversed[T] priority takes the largest T first, and sort orders a list of
// them largest first. Equality, hashing, and text go straight to the value.

module Standard/Core

import Standard/Format

/// A value whose order is its type's order reversed: `a.compare(b)` is `b.value.compare(a.value)`. A `PriorityQueue` with `Reversed[T]` priorities takes the largest first. It is Comparable, Equatable, Hashable, Representable, and Diagnosable when `T` is.
/// :typeparam T: The type of the wrapped value.
record Reversed[T]
obeys Comparable[Reversed[T]] when T: typename, Comparable[T]
obeys Equatable[Reversed[T]] when T: typename, Equatable[T]
obeys Hashable[Reversed[T]] when T: typename, Hashable[T]
obeys Representable[Reversed[T]] when T: typename, Representable[T]
obeys Diagnosable[Reversed[T]] when T: typename, Diagnosable[T]
needs T: typename
    value: T

/// Releases nothing: a `Reversed` holds no memory of its own.
routine Reversed[T].destruct(me: @Me) -> None
needs T: typename
    return

/// Wraps `value` so that it orders the other way round.
/// :param value: The value to wrap.
/// :returns: `value` in a `Reversed`.
routine Reversed[T].construct(value: T) -> Me
needs T: typename
    return Me(value: value)

/// Compares the wrapped values the other way round: -1 when `me`'s value is greater than `other`'s, 0 when they're
/// equal, and 1 when it is smaller.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1.
routine Reversed[T].compare(me: Me, other: Me) -> S32
needs T: typename, Comparable[T]
    order: S32 = other.value.compare(me.value)
    return order

/// Whether the wrapped values are equal.
/// :param other: The value to compare with.
/// :returns: True when the two wrapped values are equal.
routine Reversed[T].eq(me: Me, other: Me) -> Bool
needs T: typename, Equatable[T]
    return me.value == other.value

/// The wrapped value's hash, so that equal values hash the same.
/// :returns: The 64-bit hash of the wrapped value.
routine Reversed[T].hash(me: Me) -> U64
needs T: typename, Hashable[T]
    hashed: U64 = me.value.hash()
    return hashed

/// Writes the wrapped value with its `represent_into`, so `{r}` prints what `{r.value}` does.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Reversed[T].represent_into[TWriter](me: Me, out: @TWriter) -> None
needs T: typename, Representable[T], TWriter: typename, Writer[TWriter]
    me.value.represent_into(out)
    return

/// Writes the value as Tessera source, the wrapped value diagnosed: `Reversed(value: 3)`.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Reversed[T].diagnose_into[TWriter](me: Me, out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    write_str(out, text: "Reversed(value: ")
    me.value.diagnose_into(out)
    write_str(out, text: ")")
    return
