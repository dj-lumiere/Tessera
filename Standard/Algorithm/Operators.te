# Tessera stdlib operator protocols
#
# An operator works on a type only when the type obeys the operator's protocol: `a + b` is `a.add(b)` when the
# type of `a` obeys `Addable`, and a generic routine writes `a + b` on a `T` under `needs T: Addable[T]`. One
# protocol per operator, and one more per operand pairing (`Moment + Duration` is `DurationAddable`). Comparisons
# come from `Equatable` (`==`, and `!=` as not-eq) and `Comparable` (`<`, `<=`, `>`, `>=` from `compare`), declared
# in Concepts.te next to the others.

module Standard/Core

# -- arithmetic ------------------------------------------------------------------

### Types with `+` between two values of the type, through `add`.
### :typeparam T: The type added.
protocol Addable[T]
needs T: typename
    ### The sum of `me` and `other`, for `me + other`.
    ### :param other: The right-hand operand.
    ### :returns: The sum.
    routine Me.add(other: Me) -> Me

### Types with `-` between two values of the type, through `sub`.
### :typeparam T: The type subtracted.
protocol Subtractable[T]
needs T: typename
    ### The difference of `me` and `other`, for `me - other`.
    ### :param other: The right-hand operand.
    ### :returns: The difference.
    routine Me.sub(other: Me) -> Me

### Types with `*` between two values of the type, through `mul`.
### :typeparam T: The type multiplied.
protocol Multiplicable[T]
needs T: typename
    ### The product of `me` and `other`, for `me * other`.
    ### :param other: The right-hand operand.
    ### :returns: The product.
    routine Me.mul(other: Me) -> Me

### Types with true division `/`, through `truediv`: the quotient in the same type (floats and the types built on them).
### :typeparam T: The type divided.
protocol Divisible[T]
needs T: typename
    ### The quotient of `me` and `other`, for `me / other`.
    ### :param other: The divisor.
    ### :returns: The quotient.
    routine Me.truediv(other: Me) -> Me

### Types with Euclidean division `//` (`floordiv`) and its remainder `%` (`mod`), whose remainder is never negative.
### :typeparam T: The type divided.
protocol FloorDivisible[T]
needs T: typename
    ### The Euclidean quotient of `me` and `other`, for `me // other`.
    ### :param other: The divisor.
    ### :returns: The quotient.
    routine Me.floordiv(other: Me) -> Me

    ### The Euclidean remainder of `me` and `other`, for `me % other`.
    ### :param other: The divisor.
    ### :returns: The remainder, never negative.
    routine Me.mod(other: Me) -> Me

### Types with `**`, through `pow`, whose exponent is a value of the type itself.
### :typeparam T: The type raised to a power.
protocol Exponentiable[T]
needs T: typename
    ### `me` raised to `exponent`, for `me ** exponent`.
    ### :param exponent: The exponent.
    ### :returns: The power.
    routine Me.pow(exponent: Me) -> Me

### Types with unary `-`, through `neg`.
### :typeparam T: The type negated.
protocol Negatable[T]
needs T: typename
    ### The negation of `me`, for `-me`.
    ### :returns: The negated value.
    routine Me.neg() -> Me

### The arithmetic every number type has: `+`, `-`, `*`, `//` and `%`.
### :typeparam T: The number type.
protocol Numeric[T]
obeys Addable[T], Subtractable[T], Multiplicable[T], FloorDivisible[T]
needs T: typename

# -- wrapping and clamping arithmetic --------------------------------------------

### Types with wrapping `+%`, through `add_wrap`.
### :typeparam T: The type added.
protocol WrappingAddable[T]
needs T: typename
    ### The sum of `me` and `other` modulo the type's range, for `me +% other`.
    ### :param other: The right-hand operand.
    ### :returns: The wrapped sum.
    routine Me.add_wrap(other: Me) -> Me

### Types with wrapping `-%`, through `sub_wrap`.
### :typeparam T: The type subtracted.
protocol WrappingSubtractable[T]
needs T: typename
    ### The difference of `me` and `other` modulo the type's range, for `me -% other`.
    ### :param other: The right-hand operand.
    ### :returns: The wrapped difference.
    routine Me.sub_wrap(other: Me) -> Me

### Types with wrapping `*%`, through `mul_wrap`.
### :typeparam T: The type multiplied.
protocol WrappingMultiplicable[T]
needs T: typename
    ### The product of `me` and `other` modulo the type's range, for `me *% other`.
    ### :param other: The right-hand operand.
    ### :returns: The wrapped product.
    routine Me.mul_wrap(other: Me) -> Me

### The three wrapping operators `+%`, `-%` and `*%`.
### :typeparam T: The type.
protocol WrappingArithmetic[T]
obeys WrappingAddable[T], WrappingSubtractable[T], WrappingMultiplicable[T]
needs T: typename

### Types with clamping `+^`, through `add_clamp`.
### :typeparam T: The type added.
protocol ClampingAddable[T]
needs T: typename
    ### The sum of `me` and `other`, held at the nearest bound when it doesn't fit, for `me +^ other`.
    ### :param other: The right-hand operand.
    ### :returns: The clamped sum.
    routine Me.add_clamp(other: Me) -> Me

### Types with clamping `-^`, through `sub_clamp`.
### :typeparam T: The type subtracted.
protocol ClampingSubtractable[T]
needs T: typename
    ### The difference of `me` and `other`, held at the nearest bound when it doesn't fit, for `me -^ other`.
    ### :param other: The right-hand operand.
    ### :returns: The clamped difference.
    routine Me.sub_clamp(other: Me) -> Me

### Types with clamping `*^`, through `mul_clamp`.
### :typeparam T: The type multiplied.
protocol ClampingMultiplicable[T]
needs T: typename
    ### The product of `me` and `other`, held at the nearest bound when it doesn't fit, for `me *^ other`.
    ### :param other: The right-hand operand.
    ### :returns: The clamped product.
    routine Me.mul_clamp(other: Me) -> Me

### The three clamping operators `+^`, `-^` and `*^`.
### :typeparam T: The type.
protocol ClampingArithmetic[T]
obeys ClampingAddable[T], ClampingSubtractable[T], ClampingMultiplicable[T]
needs T: typename

# -- operand pairings ------------------------------------------------------------

### Types that move forward by a `Duration` with `+` (`Moment + Duration`).
### :typeparam T: The type moved.
protocol DurationAddable[T]
needs T: typename
    ### `me` moved forward by `d`, for `me + d`.
    ### :param d: How far to move.
    ### :returns: The later value.
    routine Me.add(d: Duration) -> Me

### Types that move forward by a `Duration` with clamping `+^`.
### :typeparam T: The type moved.
protocol ClampingDurationAddable[T]
needs T: typename
    ### `me` moved forward by `d`, held at the nearest bound when it doesn't fit, for `me +^ d`.
    ### :param d: How far to move.
    ### :returns: The later value.
    routine Me.add_clamp(d: Duration) -> Me

### Types that move back by a `Duration` with `-`, and whose difference is a `Duration` (`Moment - Moment`).
### :typeparam T: The type moved.
protocol DurationSubtractable[T]
needs T: typename
    ### `me` moved back by `d`, for `me - d`.
    ### :param d: How far to move.
    ### :returns: The earlier value.
    routine Me.sub(d: Duration) -> Me

    ### The time from `earlier` to `me`, for `me - earlier`.
    ### :param earlier: The value to measure from.
    ### :returns: The time between the two.
    routine Me.sub(earlier: Me) -> Duration

### Types that move forward by a `ByteSize` with `+` (an address plus an offset).
### :typeparam T: The type moved.
protocol OffsetAddable[T]
needs T: typename
    ### `me` moved forward by `offset`, for `me + offset`.
    ### :param offset: How far to move.
    ### :returns: The moved value.
    routine Me.add(offset: ByteSize) -> Me

### Types that move back by a `ByteSize` with `-`, and whose difference is a `ByteSize`.
### :typeparam T: The type moved.
protocol OffsetSubtractable[T]
needs T: typename
    ### `me` moved back by `offset`, for `me - offset`.
    ### :param offset: How far to move.
    ### :returns: The moved value.
    routine Me.sub(offset: ByteSize) -> Me

    ### The distance from `other` to `me`, for `me - other`.
    ### :param other: The value to measure from.
    ### :returns: The distance between the two.
    routine Me.sub(other: Me) -> ByteSize

### Types multiplied by a factor of another type with `*` (`Duration * S64`).
### :typeparam T: The type scaled.
### :typeparam TFactor: The factor's type.
protocol Scalable[T, TFactor]
needs T: typename, TFactor: typename
    ### `me` scaled by `factor`, for `me * factor`.
    ### :param factor: The factor.
    ### :returns: The scaled value.
    routine Me.mul(factor: TFactor) -> Me

### Types divided by a value of another type with `/`.
### :typeparam T: The type divided.
### :typeparam TDivisor: The divisor's type.
protocol ScalarDivisible[T, TDivisor]
needs T: typename, TDivisor: typename
    ### `me` divided by `divisor`, for `me / divisor`.
    ### :param divisor: The divisor.
    ### :returns: The quotient.
    routine Me.truediv(divisor: TDivisor) -> Me

### Types split into equal parts by a count of another type with `//` (`Duration // S64`).
### :typeparam T: The type divided.
### :typeparam TDivisor: The divisor's type.
protocol ScalarFloorDivisible[T, TDivisor]
needs T: typename, TDivisor: typename
    ### One of `parts` equal parts of `me`, for `me // parts`.
    ### :param parts: The number of parts.
    ### :returns: The part.
    routine Me.floordiv(parts: TDivisor) -> Me

### Types where `//` between two values counts how many times one fits in the other, and `%` is what is left over
### (`Duration // Duration` is an `S64`).
### :typeparam T: The type divided.
### :typeparam TRatio: The count's type.
protocol RatioDivisible[T, TRatio]
needs T: typename, TRatio: typename
    ### How many whole times `other` fits in `me`, for `me // other`.
    ### :param other: The divisor.
    ### :returns: The count.
    routine Me.floordiv(other: Me) -> TRatio

    ### What is left of `me` after the whole multiples of `other`, for `me % other`.
    ### :param other: The divisor.
    ### :returns: The remainder.
    routine Me.mod(other: Me) -> Me

# -- bits ------------------------------------------------------------------------

### Types with the bitwise operators `&`, `|` and `^`.
### :typeparam T: The type combined.
protocol Bitwiseable[T]
needs T: typename
    ### The bits set in both `me` and `other`, for `me & other`.
    ### :param other: The right-hand operand.
    ### :returns: The bitwise AND.
    routine Me.bitand(other: Me) -> Me

    ### The bits set in either `me` or `other`, for `me | other`.
    ### :param other: The right-hand operand.
    ### :returns: The bitwise OR.
    routine Me.bitor(other: Me) -> Me

    ### The bits set in exactly one of `me` and `other`, for `me ^ other`.
    ### :param other: The right-hand operand.
    ### :returns: The bitwise XOR.
    routine Me.bitxor(other: Me) -> Me

### Types with unary `~`, through `bitnot`.
### :typeparam T: The type inverted.
protocol Invertible[T]
needs T: typename
    ### `me` with every bit flipped, for `~me`.
    ### :returns: The bitwise NOT.
    routine Me.bitnot() -> Me

### Types with the shifts `<<` (`shift_left`) and `>>` (`arith_shift_right`).
### :typeparam T: The type shifted.
protocol Shiftable[T]
needs T: typename
    ### `me` shifted left by `n` bits, for `me << n`.
    ### :param n: The shift amount.
    ### :returns: The shifted value.
    routine Me.shift_left(n: Me) -> Me

    ### `me` shifted right by `n` bits, for `me >> n`.
    ### :param n: The shift amount.
    ### :returns: The shifted value.
    routine Me.arith_shift_right(n: Me) -> Me

# -- lanes -----------------------------------------------------------------------

### Types whose comparisons work lane by lane and give a mask (`Vector`): `==` `eq`, `!=` `ne`, `<` `lt`, `<=` `le`,
### `>` `gt` and `>=` `ge` each call the routine of their own.
### :typeparam T: The type compared.
### :typeparam TMask: The mask the comparisons give.
protocol LaneComparable[T, TMask]
needs T: typename, TMask: typename
    ### Lane-wise `me == other`.
    ### :param other: The value to compare with.
    ### :returns: The mask of the lanes that are equal.
    routine Me.eq(other: Me) -> TMask

    ### Lane-wise `me != other`.
    ### :param other: The value to compare with.
    ### :returns: The mask of the lanes that differ.
    routine Me.ne(other: Me) -> TMask

    ### Lane-wise `me < other`.
    ### :param other: The value to compare with.
    ### :returns: The mask of the lanes where `me` is less.
    routine Me.lt(other: Me) -> TMask

    ### Lane-wise `me <= other`.
    ### :param other: The value to compare with.
    ### :returns: The mask of the lanes where `me` is less or equal.
    routine Me.le(other: Me) -> TMask

    ### Lane-wise `me > other`.
    ### :param other: The value to compare with.
    ### :returns: The mask of the lanes where `me` is greater.
    routine Me.gt(other: Me) -> TMask

    ### Lane-wise `me >= other`.
    ### :param other: The value to compare with.
    ### :returns: The mask of the lanes where `me` is greater or equal.
    routine Me.ge(other: Me) -> TMask

# -- indexing --------------------------------------------------------------------

### Types whose elements are read by position with `xs[i]`, through `getitem`, which gives a copy of the element.
### :typeparam T: The indexed type.
### :typeparam TItem: The element type.
protocol ViewingIndexable[T, TItem]
needs T: typename, TItem: typename
    ### A copy of the element at `index`, for `me[index]`.
    ### :param index: The position, from 0.
    ### :returns: The element.
    routine Me.getitem(index: U64) -> TItem

### Types whose elements are also written by position with `xs[i] = v`, through `setitem`.
### :typeparam T: The indexed type.
### :typeparam TItem: The element type.
protocol ModifyingIndexable[T, TItem]
obeys ViewingIndexable[T, TItem]
needs T: typename, TItem: typename
    ### Stores `value` at `index`, for `me[index] = value`. It changes the value, so `me` is a pointer.
    ### :param index: The position, from 0.
    ### :param value: The element to store.
    routine @Me.setitem(index: U64, value: TItem) -> None

### Types read and written by key with `d[key]` and `d[key] = value` (the dictionaries).
### :typeparam T: The keyed type.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
protocol KeyFindable[T, TKey, TValue]
needs T: typename, TKey: typename, TValue: typename
    ### A copy of the value under `key`, for `me[key]`.
    ### :param key: The key.
    ### :returns: The value.
    routine Me.getitem(key: TKey) -> TValue

    ### Stores `value` under `key`, adding or replacing it, for `me[key] = value`.
    ### :param key: The key.
    ### :param value: The value to store.
    routine @Me.setitem(key: TKey, value: TValue) -> None
