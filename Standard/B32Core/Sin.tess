# Tessera stdlib: the correctly rounded sine of B32
#
# x * 16/pi = q + z: sin(q pi/16) and cos(q pi/16) from a table, sin(z pi/16) and cos(z pi/16) from
# polynomials, all in B64. Four arguments the fast path can't round come from a small table of exact results.
# Round to nearest only: +-0 stays itself, infinities give NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/sin/sinf.c via RazorForge's B32Sin.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The sine of `me` (in radians), correctly rounded (to nearest). +-0 stays itself, infinities give NaN, and NaN
### comes back quiet.
### :returns: sin(`me`).
routine B32.sin(me: Me) -> Me
    local ax: U32 = me.bits() << 1

    if ax > 0x99000000 or ax < 0x73000000
        jump edge()
    else
        jump reduce()

    # |x| > 0x1p+26, x is NaN, or |x| < 0x1p-12
    block edge()
        tiny: Bool = ax < 0x66000000
        when
            tiny => jump tiny()
            ax < 0x73000000 => jump cubic()
            else => return cm_b32_sin_big(me)

    block cubic()
        cube_term: Me = me * -0.1666666716337204 * (me * me)
        return cube_term + me

    # |x| < 0x1p-25: sin(x) rounds like x - x |x| tiny
    block tiny()
        if ax == 0
            return me
        else
            return (-me).mul_add(a: me.abs(), b: me)

    block reduce()
        z0: B64 = me.to[B64]()
        small: Bool = ax < 0x822D97C8
        hard_pair: Bool = ax == 0x7E75B8A2 or ax == 0x7F4F0654
        when
            hard_pair or ax == 0x8C333330 => return cm_b32_sin_database(me)
            small => jump fast(cm_b32_trig_reduce_small(z0))
            else => jump fast(cm_b32_trig_reduce_medium(z0))

    block fast(red: CmF32TrigReduced)
        z: B64 = red.z
        ia: U64 = red.q
        z2: B64 = z * z
        z4: B64 = z2 * z2
        aa: B64 = cm_b32_trig_poly_a(z2, z4)
        bb: B64 = cm_b32_trig_poly_b(z2, z4)
        s0: B64 = cm_b32_trig_sin_tb(ia)
        c0: B64 = cm_b32_trig_sin_tb(ia +% 8)
        head: B64 = aa * (z * c0) + s0
        r: B64 = head - bb * (z2 * s0)
        return r.to[Me]()

### The sine of the four arguments whose fast path isn't correctly rounded: sign(x) (rh + rl).
### :param x: One of the four arguments (any other |x| gets the fourth entry).
### :returns: The tabulated sine.
private routine cm_b32_sin_database(x: B32) -> B32
    ax: U32 = x.bits() & 0x7FFFFFFF
    values2: (B32, B32) = when ax
        0x46199998 => (-0.34761324524879456, -7.450580596923828e-09)
        0x3F3ADC51 => (0.6668131947517395, -1.4901161193847656e-08)
        0x3FA7832A => (0.9658464193344116, -1.4901161193847656e-08)
        else => (-2.384975950064927e-08, -4.440892098500626e-16)
    rh, rl = values2
    sgn: B32 = B32.copysign(1.0, x)
    return sgn * rh + sgn * rl

### The sine for |x| > 2^26, infinities and NaN.
### :param x: The argument.
### :returns: sin(`x`), NaN for an infinity, and a NaN `x` quieted.
private routine cm_b32_sin_big(x: B32) -> B32
    local t: U32 = x.bits()

    if t << 1 >= 0xFF000000
        # NaN comes back quiet with its sign and payload, an infinity gives a NaN
        if t << 9 != 0
            return x + x
        else
            return B32.from_bits(0xFFC00000)
    else
        red: CmF32TrigReduced = cm_b32_trig_reduce_big(u: t, bias: 147)
        z: B64 = red.z
        ia: U64 = red.q
        z2: B64 = z * z
        z4: B64 = z2 * z2
        aa: B64 = cm_b32_trig_poly_a(z2, z4)
        bb: B64 = cm_b32_trig_poly_b(z2, z4)
        s0: B64 = cm_b32_trig_sin_tb(ia)
        c0: B64 = cm_b32_trig_sin_tb(ia +% 8)
        slope: B64 = aa * c0 - bb * (z * s0)
        r: B64 = slope * z + s0
        return r.to[B32]()
