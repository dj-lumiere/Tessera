// Tessera stdlib: the correctly rounded sine of B32
//
// x * 16/pi = q + z: sin(q pi/16) and cos(q pi/16) from a table, sin(z pi/16) and cos(z pi/16) from
// polynomials, all in B64. Four arguments the fast path can't round come from a small table of exact results.
// Round to nearest only: +-0 stays itself, infinities give NaN, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/sin/sinf.c via RazorForge's B32Sin.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// The sine of `me` (in radians), correctly rounded (to nearest). +-0 stays itself, infinities give NaN, and NaN
/// comes back quiet.
/// :returns: sin(`me`).
routine B32.sin(me: Me) -> Me
    local ax: U32 = me.bits().shl(1)

    block entry()
        outside: Bool = ax.gt(0x99000000).bitor(ax.lt(0x73000000))
        branch outside
            ? edge()
            : reduce()

    // |x| > 0x1p+26, x is NaN, or |x| < 0x1p-12
    block edge()
        tiny: Bool = ax.lt(0x66000000)
        small: Bool = ax.lt(0x73000000)
        when
            tiny => tiny()
            small => cubic()
            else => return(cm_b32_sin_big(me))

    block cubic()
        cube_term: Me = me.mul(-0x1.555556p-3).mul(me.mul(me))
        return(cube_term.add(me))

    // |x| < 0x1p-25: sin(x) rounds like x - x |x| tiny
    block tiny()
        zero: Bool = ax.eq(0)
        branch zero
            ? return(me)
            : return(me.neg().mul_add(a: me.abs(), b: me))

    block reduce()
        z0: B64 = me.to[B64]()
        small: Bool = ax.lt(0x822D97C8)
        hard_pair: Bool = ax.eq(0x7E75B8A2).bitor(ax.eq(0x7F4F0654))
        hard: Bool = hard_pair.bitor(ax.eq(0x8C333330))
        when
            hard => return(cm_b32_sin_database(me))
            small => fast(cm_b32_trig_reduce_small(z0))
            else => fast(cm_b32_trig_reduce_medium(z0))

    block fast(red: CmF32TrigReduced)
        z: B64 = red.z
        ia: U64 = red.q
        z2: B64 = z.mul(z)
        z4: B64 = z2.mul(z2)
        aa: B64 = cm_b32_trig_poly_a(z2, z4)
        bb: B64 = cm_b32_trig_poly_b(z2, z4)
        s0: B64 = cm_b32_trig_sin_tb(ia)
        c0: B64 = cm_b32_trig_sin_tb(ia.add_wrap(8))
        head: B64 = aa.mul(z.mul(c0)).add(s0)
        r: B64 = head.sub(bb.mul(z2.mul(s0)))
        return(r.to[Me]())

/// The sine of the four arguments whose fast path isn't correctly rounded: sign(x) (rh + rl).
/// :param x: One of the four arguments (any other |x| gets the fourth entry).
/// :returns: The tabulated sine.
private routine cm_b32_sin_database(x: B32) -> B32
    block entry()
        ax: U32 = x.bits().bitand(0x7FFFFFFF)
        when ax
            0x46199998 => finish(-0x1.63f4bap-2, -0x1p-27)
            0x3F3ADC51 => finish(0x1.55688ap-1, -0x1p-26)
            0x3FA7832A => finish(0x1.ee836cp-1, -0x1p-26)
            else => finish(-0x1.99bc5ap-26, -0x1p-51)

    block finish(rh: B32, rl: B32)
        sgn: B32 = B32.copysign(1.0, x)
        return(sgn.mul(rh).add(sgn.mul(rl)))

/// The sine for |x| > 2^26, infinities and NaN.
/// :param x: The argument.
/// :returns: sin(`x`), NaN for an infinity, and a NaN `x` quieted.
private routine cm_b32_sin_big(x: B32) -> B32
    local t: U32 = x.bits()

    block entry()
        special: Bool = t.shl(1).ge(0xFF000000)
        branch special
            ? special()
            : continue
        red: CmF32TrigReduced = cm_b32_trig_reduce_big(u: t, bias: 147)
        z: B64 = red.z
        ia: U64 = red.q
        z2: B64 = z.mul(z)
        z4: B64 = z2.mul(z2)
        aa: B64 = cm_b32_trig_poly_a(z2, z4)
        bb: B64 = cm_b32_trig_poly_b(z2, z4)
        s0: B64 = cm_b32_trig_sin_tb(ia)
        c0: B64 = cm_b32_trig_sin_tb(ia.add_wrap(8))
        slope: B64 = aa.mul(c0).sub(bb.mul(z.mul(s0)))
        r: B64 = slope.mul(z).add(s0)
        return(r.to[B32]())

    // NaN comes back quiet with its sign and payload, an infinity gives a NaN
    block special()
        nan: Bool = t.shl(9).ne(0)
        branch nan
            ? return(x.add(x))
            : return(B32.from_bits(0xFFC00000))
