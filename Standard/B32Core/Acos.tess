// Tessera stdlib: the correctly rounded arc cosine of B32
//
// pi/2 minus a fast odd polynomial in x covers |x| < 0x1.c2a1dcp-1 and settles
// most inputs. The rest go through an accurate path in B64: for |x| < 1/2
// pi/2 - x - x^3 p(x^2), above that sqrt(1 - |x|) times a polynomial in
// 1 - |x|, plus pi for negative x. Both polynomials are cm_b32_asin_poly12
// (Asin.tess). Round to nearest only: |x| > 1 gives NaN, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/acos/acosf.c via RazorForge's B32Acos.rf.
// Copyright (c) 2023 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// arccos(`me`), correctly rounded.
/// :returns: The arc cosine of `me`, in radians.
routine B32.acos(me: Me) -> Me
    local xs: B64 = me.to[B64]()
    local t: U32 = me.bits()
    local ax: U32 = t << 1

    edge: Bool = ax >= 0x7F000000
    when
        edge => jump edge()
        ax < 0x7EC2A1DC => jump fast()
        else => jump accurate()

    // |x| >= 1 or NaN, which comes back quiet with its sign and payload
    block edge()
        one: Bool = t == 0x3F800000
        minus_one: Bool = t == 0xBF800000
        when
            one => return 0.0
            minus_one => return Me.add(3.1415927410125732, -5.960464477539063e-08)
            ax > 0xFF000000 => return me + me
            else => return Me.from_bits(0xFFC00000)

    // |x| < 0x1.c2a1dcp-1
    block fast()
        // |x| < 2^-63
        if ax < 0x40000000
            return Me.add(1.5707963705062866, -4.371138828673793e-08)
        z2: B64 = xs * xs
        z4: B64 = z2 * z2
        z8: B64 = z4 * z4
        z16: B64 = z8 * z8
        a01: B64 = z2 * 0.1666675305523315 + 0.9999999997220561
        a23: B64 = z2 * 0.047534405138862854 + 0.07491953938381704
        a45: B64 = z2 * 0.6698889818036169 + -0.024905344107261872
        a67: B64 = z2 * 27.02642690834356 + -5.003757071019054
        p0: B64 = z8 * (z4 * a67 + a45) + (z4 * a23 + a01)
        b01: B64 = z2 * 288.04495822181497 + -103.66551324982036
        b23: B64 = z2 * 842.6925540871983 + -580.9121849063603
        b45: B64 = z2 * 581.0567760763246 + -857.2868238883075
        b67: B64 = z2 * 43.51567221246845 + -235.92908248702702
        p1: B64 = z8 * (z4 * b67 + b45) + (z4 * b23 + b01)
        rf: B64 = xs * (z16 * p1 + p0)
        ub: Me = B64.sub(1.5707963270725467, rf).to[Me]()
        lb: Me = B64.sub(1.5707963265172467, rf).to[Me]()
        if ub == lb
            return ub
        else
            jump accurate()

    // The fast path can't decide the rounding, or |x| >= 0x1.c2a1dcp-1.
    block accurate()
        // |x| < 1/2
        if ax < 0x7E000000
            jump small()
        else
            jump large()

    // pi/2 - x - x^3 p(x^2)
    block small()
        hard1: Bool = t == 0x328885A3
        when
            hard1 => return Me.add(1.5707963705062866, 2.980232238769531e-08)
            t == 0x39826222 => return Me.add(1.5705476999282837, 2.980232238769531e-08)
            else => pass
        x2: B64 = xs * xs
        r: B64 = B64.sub(1.5707963267948966, xs) - xs * x2 * cm_b32_asin_poly12(z: x2, base: 0)
        return r.to[Me]()

    // o + sign(x) sqrt(z) q(z) with z = 1 - |x|, o = pi for negative x and 0 otherwise
    block large()
        z: B64 = B64.sub(1.0, xs.abs())
        s: B64 = z.sqrt().copysign(xs)
        negative: Bool = t >> 31 == 1
        o: B64 = when
            negative => 3.141592653589793
            else => 0.0
        r: B64 = s * cm_b32_asin_poly12(z, base: 12) + o
        return r.to[Me]()
