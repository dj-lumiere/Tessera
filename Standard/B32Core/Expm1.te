# Tessera stdlib: the correctly rounded e^x - 1 of B32
#
# Near zero a polynomial in x. Elsewhere x / ln(2) = k/32 + h: 2^(k/32) from a
# table, 2^h from a polynomial, all in B64, minus 1. A second, longer
# polynomial settles the cases the first can't round.
# Round to nearest only: overflow gives +inf, x -> -inf gives -1, +-0 stay
# themselves, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/expm1/expm1f.c via RazorForge's B32Expm1.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### 2^(i/32) for i in 0..31, as B64 bits.
preset CM_B32_EXPM1_TD: @Array[U64, 32] <- [0x3FF0000000000000, 0x3FF059B0D3158574,
    0x3FF0B5586CF9890F, 0x3FF11301D0125B51, 0x3FF172B83C7D517B, 0x3FF1D4873168B9AA,
    0x3FF2387A6E756238, 0x3FF29E9DF51FDEE1, 0x3FF306FE0A31B715, 0x3FF371A7373AA9CB,
    0x3FF3DEA64C123422, 0x3FF44E086061892D, 0x3FF4BFDAD5362A27, 0x3FF5342B569D4F82,
    0x3FF5AB07DD485429, 0x3FF6247EB03A5585, 0x3FF6A09E667F3BCD, 0x3FF71F75E8EC5F74,
    0x3FF7A11473EB0187, 0x3FF82589994CCE13, 0x3FF8ACE5422AA0DB, 0x3FF93737B0CDC5E5,
    0x3FF9C49182A3F090, 0x3FFA5503B23E255D, 0x3FFAE89F995AD3AD, 0x3FFB7F76F2FB5E47,
    0x3FFC199BDD85529C, 0x3FFCB720DCEF9069, 0x3FFD5818DCFBA487, 0x3FFDFC97337B9B5F,
    0x3FFEA4AFA2A490DA, 0x3FFF50765B6E4540]

### e^`me` - 1, accurate near 0 and correctly rounded (to nearest). Overflow gives +inf, -inf gives -1, +-0 stay
### themselves, and NaN comes back quiet.
### :returns: e^`me` - 1.
routine B32.exp_m1(me: Me) -> Me
    local ux: U32 = me.bits()
    local z: B64 = me.to[B64]()
    local ax: U32 = ux << 1

    small: Bool = ax < 0x7C400000
    when
        small =>
            # |x| < 0.15625
            zero: Bool = ax == 0
            when
                zero => return me
                ax < 0x676A09E8 => return me.abs().mul_add(a: 0x1p-25, b: me)
                else =>
                    # rounds like x + |x| 2^-25
                    z2: B64 = z * z
                    z4: B64 = z2 * z2
                    p01: B64 = z * 0x1.55555555555fep-3 + 0x1.fffffffffffc2p-2
                    p23: B64 = z * 0x1.1111111098dc1p-7 + 0x1.555555559767fp-5
                    p45: B64 = z * 0x1.a01a07658483fp-13 + 0x1.6c16bca988aa9p-10
                    p67: B64 = z * 0x1.71de3a960b5e3p-19 + 0x1.a05b04d2c3503p-16
                    q03: B64 = z2 * p23 + p01
                    q47: B64 = z4 * (z2 * p67 + p45)
                    r: B64 = z2 * (q03 + q47) + z
                    return r.to[Me]()
        ax >= 0x8562E430 =>
            # |x| >= 0x1.62e43p+6, infinities and NaN
            nan: Bool = ax > 0xFF000000
            negative: Bool = ux >> 31 == 1
            infinite: Bool = ax == 0xFF000000
            when
                nan => return me + me
                negative =>
                    # x < 0: the result is -1 (the float just above it is too far away)
                    if infinite
                        return -1.0
                    else
                        return Me.add(-1.0, 0x1p-26)
                else => return Me.INFINITY
        else =>
            a: B64 = z * 0x1.71547652b82fep+5  # 32 x / ln(2)
            ia: B64 = a.round_ties_even()
            h: B64 = a - ia
            h2: B64 = h * h
            uu: U64 = (ia + 0x1.8p+52).bits()  # the low bits are round(32 x / ln(2))
            c2: B64 = h * 0x1.c6b19384ecd93p-20 + 0x1.ebfd1b232f475p-13
            c0: B64 = h * 0x1.62e42fef4c4e7p-6 + 1.0
            tb: U64 = CM_B32_EXPM1_TD.getitem((uu & 0x1F).to[U64]())
            sv: B64 = B64.from_bits(tb +% ((uu >> 5) << 52))  # 2^(round(32 x / ln(2)) / 32)
            c02: B64 = h2 * c2 + c0
            r: B64 = c02 * sv - 1.0
            ub: Me = r.to[Me]()
            lb: Me = (r - sv * 0x1.3b3p-33).to[Me]()
            if ub == lb
                return ub
            # The fast path can't decide the rounding.
            # x < -17.32
            else if ux > 0xC18AA123
                return Me.add(-1.0, 0x1p-26)
            else
                # a longer reduction and polynomial
                h_hi: B64 = z * 0x1.7154765p+5 - ia
                h3: B64 = h_hi + z * 0x1.5c17f0bbbe88p-26
                h22: B64 = h3 * h3
                w: B64 = sv * h3
                q01: B64 = h3 * 0x1.ebfbdff82c58fp-13 + 0x1.62e42fefa39efp-6
                q23: B64 = h3 * 0x1.3b2ab6fb92e5ep-27 + 0x1.c6b08d702e0edp-20
                q45: B64 = h3 * 0x1.430976b8ce6efp-43 + 0x1.5d886e6d54203p-35
                q: B64 = h22 * (h22 * q45 + q23) + q01
                r2: B64 = sv - 1.0 + w * q
                return r2.to[Me]()
