# Tessera stdlib: the correctly rounded hyperbolic sine of B32
#
# Near zero a polynomial in x. Elsewhere 32 x / ln(2) = k + h, and
# sinh x = 2^(k/32) 2^(h/32) / 2 - 2^(-k/32) 2^(-h/32) / 2 with the powers of
# two from a table and 2^(+-h/32) from a polynomial, all in B64. A second,
# longer polynomial settles the cases the first can't round.
# Round to nearest only: overflow gives a signed infinity, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/sinh/sinhf.c via RazorForge's B32Sinh.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### 2^(i/32) / 2 for i in 0..31, as B64 bits. Shared with cosh.
secret preset CM_B32_SINH_TB: @Array[U64, 32] <- [0x3FE0000000000000, 0x3FE059B0D3158574,
    0x3FE0B5586CF9890F, 0x3FE11301D0125B51, 0x3FE172B83C7D517B, 0x3FE1D4873168B9AA,
    0x3FE2387A6E756238, 0x3FE29E9DF51FDEE1, 0x3FE306FE0A31B715, 0x3FE371A7373AA9CB,
    0x3FE3DEA64C123422, 0x3FE44E086061892D, 0x3FE4BFDAD5362A27, 0x3FE5342B569D4F82,
    0x3FE5AB07DD485429, 0x3FE6247EB03A5585, 0x3FE6A09E667F3BCD, 0x3FE71F75E8EC5F74,
    0x3FE7A11473EB0187, 0x3FE82589994CCE13, 0x3FE8ACE5422AA0DB, 0x3FE93737B0CDC5E5,
    0x3FE9C49182A3F090, 0x3FEA5503B23E255D, 0x3FEAE89F995AD3AD, 0x3FEB7F76F2FB5E47,
    0x3FEC199BDD85529C, 0x3FECB720DCEF9069, 0x3FED5818DCFBA487, 0x3FEDFC97337B9B5F,
    0x3FEEA4AFA2A490DA, 0x3FEF50765B6E4540]

### sinh `me`, correctly rounded.
### :returns: The hyperbolic sine of `me`.
routine B32.sinh() -> Me
    local ux: U32 = me.bits() << 1

    large: Bool = ux > 0x8565A9F8
    when
        large =>
            # |x| > 0x1.65a9f8p+6: NaN, infinities, or overflow
            nan: Bool = ux > 0xFF000000
            when
                nan => return me + me
                ux == 0xFF000000 => return me
                else => return Me.INFINITY.copysign(me)
        ux < 0x7C000000 =>
            # |x| < 0.125
            tiny: Bool = ux < 0x66000000
            hard: Bool = ux == 0x74250BFE
            # |x| < 0x1.250bfep-11
            when
                tiny => return me.mul_add(a: me.abs(), b: me)
                hard =>
                    # |x| = 0x1.250bfep-11, which the cubic rounds the wrong way
                    sgn: Me = Me.copysign(1.0, me)
                    r: Me = sgn * 0x1.250bfep-11 + sgn * 0x1p-36
                    return r
                ux < 0x74250BFE =>
                    cube_term: Me = me * 0x1.555556p-3 * (me * me)
                    return cube_term + me
                else =>
                    z: B64 = me.to[B64]()
                    z2: B64 = z * z
                    z4: B64 = z2 * z2
                    p0: B64 = z2 * 0x1.11111111146e1p-7 + 0x1.5555555555555p-3
                    p1: B64 = z2 * 0x1.71f92198aa6e9p-19 + 0x1.a01a00930dda6p-13
                    p: B64 = z4 * p1 + p0
                    z3: B64 = z2 * z
                    r: B64 = z3 * p + z
                    return r.to[Me]()
        else => return cm_b32_sinh_main(me.to[B64]())

### 2^(k/32) / 2 for k = ia, or k = -ia when minus, where ia is an integer held in a B64.
### :param ia: The integer k, held in a B64.
### :param minus: Whether to negate k.
### :returns: 2^(k/32) / 2.
secret routine cm_b32_sinh_scale(ia: B64, minus: Bool) -> B64
    ia_shifted: B64 = ia + 0x1.8p+52
    j: S64 = ia_shifted.bits().to_wrap[S64]()
    jp: S64 = when
        minus => j.neg_wrap()
        else => j
    index: U64 = (jp & 31).to_wrap[U64]()
    scale_exponent: U64 = (jp >> 5).to_wrap[U64]()
    shift: U64 = scale_exponent << 52
    return B64.from_bits(CM_B32_SINH_TB.getitem(index.to[U64]()) +% shift)

### The main path of sinh, for 0.125 <= |x| without overflow: e^x / 2 - e^-x / 2 from a 2^(k/32) table.
### :param z: The argument as B64.
### :returns: sinh(`z`), rounded to B32.
secret routine cm_b32_sinh_main(z: B64) -> B32
    local a: B64 = z * 0x1.71547652b82fep+5
    # 32 x / ln(2)
    local ia: B64 = a.round_ties_even()
    local h: B64 = a - ia
    local h2: B64 = h * h
    local sp: B64 = cm_b32_sinh_scale(ia, minus: false)
    local sm: B64 = cm_b32_sinh_scale(ia, minus: true)

    tev: B64 = h2 * 0x1.ebfd1b232f475p-13 + 1.0
    tod: B64 = h2 * 0x1.c6b19384ecd93p-20 + 0x1.62e42fef4c4e7p-6
    rp: B64 = sp * (h * tod + tev)
    rm: B64 = sm * (tev - h * tod)
    r: B64 = rp - rm
    ub: B32 = r.to[B32]()
    lb: B32 = (r - r * 0x1.4e406496685f4p-33).to[B32]()
    if ub == lb
        return ub
    # too close to a rounding boundary: redo it with a split 32 / ln(2) and a longer polynomial
    h_hi: B64 = z * 0x1.7154765p+5 - ia
    h_split: B64 = h_hi + z * 0x1.5c17f0bbbe88p-26
    h2_split: B64 = h_split * h_split
    te4: B64 = h2_split * 0x1.430976b8ce6efp-43 + 0x1.3b2ab6fb92e5ep-27
    te02: B64 = h2_split * 0x1.ebfbdff82c58fp-13 + 1.0
    tev2: B64 = te02 + h2_split * h2_split * te4
    to2: B64 = h2_split * 0x1.5d886e6d54203p-35 + 0x1.c6b08d702e0edp-20
    tod2: B64 = h2_split * to2 + 0x1.62e42fefa39efp-6
    rp2: B64 = sp * (h_split * tod2 + tev2)
    rm2: B64 = sm * (tev2 - h_split * tod2)
    r2: B64 = rp2 - rm2
    return r2.to[B32]()
