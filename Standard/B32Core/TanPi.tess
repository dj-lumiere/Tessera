# Tessera stdlib: the correctly rounded tan(pi x) of B32
#
# x = n + z with n the nearest integer and |z| <= 1/2: tan(pi z) is z (1 - z^2) P(z^2) / (Q(z^2) (1/4 - z^2)), a
# rational approximation in B64 whose factors carry the zeros at z = 0, +-1 and the poles at z = +-1/2 exactly.
# Multiples of 1/4 are exact, and two arguments the rational function can't round are listed. Round to nearest
# only.
#
# Ported from CORE-MATH, src/binary32/tanpi/tanpif.c via RazorForge's B32Tanpi.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### tan(pi me), correctly rounded (to nearest, ties to even). An integer n gives +0 for a positive even n or a
### negative odd one and -0 otherwise, n + 1/2 gives +inf for an even n and -inf for an odd one, +-inf gives NaN,
### and NaN comes back quiet.
### :returns: tan(pi `me`).
routine B32.tan_pi(me: Me) -> Me
    local ix: U32 = me.bits()
    local e: U32 = ix & 0x7F800000

    # |x| >= 2^24
    if e > 0x4B000000
        # x minus the nearest integer
        # NaN comes back quiet with its sign and payload, an infinity gives NaN, any other x is an even integer
        if not (e == 0x7F800000)
            return Me.copysign(0.0, me)
        if ix << 9 == 0
            return Me.from_bits(0x7FC00000)
        else
            return me + me
    else
        x4: Me = Me.mul(4.0, me)
        dx4: Me = x4 - x4.round_ties_even()
        zf: Me = me - me.round_ties_even()
        if dx4 == 0.0
            # x = k/4 for an integer k
            k: S32 = x4.to[S32]()
            # x = 1/4 mod 1/2: +-1 with the sign of tan
            if k & 1 == 1
                return Me.copysign(1.0, zf)
            zero: Me = Me.copysign(0.0, me)
            turn: S32 = k & 6  # 4 x mod 8, k being even: x mod 2 in quarters
            when turn
                0 => return zero
                4 => return -zero
                2 => return Me.INFINITY
                else => return Me.NEG_INFINITY
        else
            a: U32 = zf.bits() & 0x7FFFFFFF
            when a
                0x3E933802 => return Me.copysign(1.2687946557998657, zf) + Me.copysign(2.980232238769531e-08, zf)
                0x38F26685 => return Me.copysign(0.000363122730050236, zf) + Me.copysign(7.275957614183426e-12, zf)
                else =>
                    # x = 0 mod 2
                    # x = 1 mod 2
                    # x = 1/2 mod 2
                    # x = -1/2 mod 2
                    # the two arguments whose rational evaluation would round wrongly: sign(z) (rh + rl)
                    z: B64 = zf.to[B64]()
                    z2: B64 = z * z
                    z4: B64 = z2 * z2
                    n23: B64 = B64.add(0.02201158908691473, z2 * -0.00023103959012326923)
                    n01: B64 = B64.add(0.7853981633974484, z2 * -0.2805387264887832)
                    poly: B64 = n01 + z4 * n23
                    num: B64 = (z - z * z2) * poly
                    d23: B64 = B64.add(0.0973140255480054, z2 * -0.0032269805489163333)
                    d01: B64 = B64.add(1.0, z2 * -0.6470611340915767)
                    dpoly: B64 = d01 + z4 * d23
                    den: B64 = dpoly * B64.sub(0.25, z2)
                    r: B64 = num / den
                    return r.to[Me]()
