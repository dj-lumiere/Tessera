# Tessera stdlib: the correctly rounded log-gamma function of B32
#
# log|gamma(x)| from rational approximations for |x| < 0x1.52p-1 and up to
# 0x1.afc1ap+1, Stirling's series above, polynomials around the zeros near
# -2.7476, -2.4570 and -3.1435, and the reflection formula for the other
# negative x, all in B64. Hard-to-round inputs come from a table. Only the
# value is computed: C's signgam (the sign of gamma(x)) is not.
# Round to nearest only: 0 and the negative integers give +inf, +-inf gives
# +inf, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/lgamma/lgammaf.c via RazorForge's B32Lgamma.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### -log(r) for the reciprocals r in CM_B32_LGAMMA_IX, as B64 bits.
preset CM_B32_LGAMMA_IL: @Array[U64, 16] <- [0x3C659CAEEC280116, 0x3FAF0A30C01162AA,
    0x3FBE27076E2AF2EB, 0x3FC5FF3070A793D6, 0x3FCC8FF7C79A9A20, 0x3FD1675CABABA60F,
    0x3FD4618BC21C5EC2, 0x3FD739D7F6BBD007, 0x3FD9F323ECBF984D, 0x3FDC8FF7C79A9A21,
    0x3FDF128F5FAF06EC, 0x3FE0BE72E4252A83, 0x3FE1E85F5E7040D1, 0x3FE307D7334F10BE,
    0x3FE41D8FE84672AF, 0x3FE52A2D265BC5AB]

### Reciprocals 1 / (1 + i/16), rounded, for i in 0..15, as B64 bits.
preset CM_B32_LGAMMA_IX: @Array[U64, 16] <- [0x3FF0000000000000, 0x3FEE1E1E1E1E1E1E,
    0x3FEC71C71C71C71C, 0x3FEAF286BCA1AF28, 0x3FE999999999999A, 0x3FE8618618618618,
    0x3FE745D1745D1746, 0x3FE642C8590B2164, 0x3FE5555555555555, 0x3FE47AE147AE147B,
    0x3FE3B13B13B13B14, 0x3FE2F684BDA12F68, 0x3FE2492492492492, 0x3FE1A7B9611A7B96,
    0x3FE1111111111111, 0x3FE0842108421084]

### Inputs whose log-gamma is hard to round, as B32 bits.
preset CM_B32_LGAMMA_EXC_X: @Array[U32, 27] <- [0x1B7679FF, 0x1E88452D, 0x2AD345DE, 0x39EEFE83,
    0x3B7C53AA, 0x42468B59, 0x449ACF07, 0x46541516, 0x46B16323, 0x4F3F94C0, 0x50522F52, 0x65FCA09F,
    0x716E5DD5, 0x77AC5674, 0x7943DEF8, 0x8212E5B3, 0x9B7679FF, 0x9E88452D, 0xA77A8E47, 0xAA6C2DFF,
    0xABA1BF3A, 0xB0D6F2CA, 0xB0E17820, 0xC02C060F, 0xC134EB14, 0xC33139A3, 0xC6F7E151]

### The correctly rounded results for those inputs, as f + df (B32 bits).
preset CM_B32_LGAMMA_EXC_F: @Array[U32, 27] <- [0x4247C72D, 0x4236BD8C, 0x41E4E374, 0x40F62DD4,
    0x40B1D661, 0x430F25A7, 0x45ECD681, 0x47E1C01B, 0x48483ADF, 0x517A24A3, 0x5292EE5E, 0x68CEAD5A,
    0x747E2BB9, 0x7ACF27B3, 0x7C7232D7, 0x42AA3D22, 0x4247C72D, 0x4236BD8C, 0x42052B95, 0x41E98AC9,
    0x41DBEF61, 0x41A23559, 0x41A1D37B, 0xBDABC3E3, 0xC1875615, 0xC43991AF, 0xC89116DE]
### The low-order corrections `df` for the inputs in {CM_B32_LGAMMA_EXC_X}, as B32 bits: `f + df` is the correctly rounded result.
preset CM_B32_LGAMMA_EXC_DF: @Array[U32, 27] <- [0xB5800000, 0xB5800000, 0x35000000, 0xB4000000,
    0x34000000, 0x36800000, 0xB9000000, 0x3B000000, 0xBB800000, 0xC4800000, 0xC6000000, 0xDC000000,
    0x67800000, 0xEE000000, 0x6F800000, 0xB6000000, 0xB5800000, 0xB5800000, 0xB5800000, 0xB5000000,
    0xB5000000, 0xB5000000, 0x35000000, 0x31000000, 0xB5000000, 0xB7800000, 0xBC000000]

### ln |Γ(`me`)|, correctly rounded: +inf at 0 and the negative integers.
### :returns: ln |Γ(`me`)|.
routine B32.ln_gamma(me: Me) -> Me
    local fx: Me = me.floor()
    local ax: Me = me.abs()
    local tu: U32 = ax.bits()

    # +-inf gives +inf, NaN comes back quiet
    if tu >= 0x7F800000
        if tu == 0x7F800000
            return me * me
        return me + me
    # an integer: a pole at 0 and the negative integers, and log(gamma) = 0 at 1 and 2
    if fx == me
        when
            me <= 0.0 => return Me.from_bits(0x7F800000)
            me == 1.0 or me == 2.0 => return 0.0
            else => pass
    z: B64 = ax.to[B64]()
    s: B64 = me.to[B64]()
    f: B64 = when
        # |x| < 0x1.52p-1: a rational approximation of log|gamma(x)| + log|x|
        ax < 0x1.52p-1 => cm_b32_lgamma_small(s) - cm_b32_lgamma_ln(z)
        # |x| > 0x1.afc1ap+1: Stirling's series
        ax > 0x1.afc1ap+1 =>
            if me >= 0x1.895f1cp+121
                return me.mul_add(a: 0x1.4d3398p+6, b: 0x1.10f35ep+103)
            lz: B64 = cm_b32_lgamma_ln(z)
            series: B64 = cm_b32_lgamma_stirling(z, lz, ax)
            large: B64 = when
                me < 0.0 =>
                    # log|gamma(x)| = log(pi) - log|gamma(-x)| - log(-x) - log|sin(pi x)|
                    g: B64 = B64.sub(0x1.250d048e7a1bdp+0, series) - lz
                    lp: B64 = cm_b32_lgamma_ln(cm_b32_lgamma_sinpi((me - fx).to[B64]()))
                    becomes g - lp
                else => series
            becomes large
        # 0x1.52p-1 <= |x| <= 0x1.afc1ap+1: a rational approximation of log(gamma(|x|))
        else =>
            rational: B64 = cm_b32_lgamma_middle(z)
            near1: Bool = tu < 0x40301B93 and tu > 0x402F95C2
            near2: Bool = tu > 0x401CECCB and tu < 0x401D95CA
            middle: B64 = when
                not (me < 0.0) => rational
                near1 => cm_b32_lgamma_near1(s)
                near2 => cm_b32_lgamma_near2(s)
                tu > 0x40492009 and tu < 0x404940EF => cm_b32_lgamma_near3(s)
                else =>
                    # log|gamma(x)| = log(pi) - log(gamma(|x|)) - log|x sin(pi x)|
                    g: B64 = B64.sub(0x1.250d048e7a1bdp+0, rational)
                    lp: B64 = cm_b32_lgamma_ln(cm_b32_lgamma_sinpi((me - fx).to[B64]()) * z)
                    becomes g - lp
            becomes middle
    r: Me = f.to[Me]()
    biased_bits: U64 = f.bits() +% 5
    if biased_bits & 0xFFFFFFF <= 31
        return cm_b32_lgamma_exception(xb: me.bits(), fallback: r)
    return r

### log|gamma(x)| + log|x| for |x| < 0x1.52p-1, from a rational approximation.
### :param s: x, widened to B64.
### :returns: The approximation of log|gamma(x)| + log|x|.
private routine cm_b32_lgamma_small(s: B64) -> B64
    n1: B64 = (s + 0x1.505bdf4b65acp+4) * (s + 0x1.51c80eb47e068p+2)
    n2: B64 = (s - 0x1.0000000007cb8p+0) * (s + 0x1.4ac529250a1fcp+1)
    n3: B64 = (s + 0x1.a8c99dbe1621ap+0) * (s + 0x1.4abdcc74115eap+0)
    n4: B64 = (s + 0x1.1b87fe5a5b923p+0) * (s + 0x1.05b8a4d47ff64p+0)
    num: B64 = s * 0x1.0fc0fad268c4dp+2 * (n1 * n2 * (n3 * n4))
    d1: B64 = (s + 0x1.4db2cfe9a5265p+5) * (s + 0x1.062e99d1c4f27p+3)
    d2: B64 = (s + 0x1.c81bc2ecf25f6p+1) * (s + 0x1.108e55c10091bp+1)
    d3: B64 = (s + 0x1.7dd25af0b83d4p+0) * (s + 0x1.36bf1880125fcp+0)
    d4: B64 = (s + 0x1.1379fc8023d9cp+0) * (s + 0x1.03712e41525d2p+0)
    den: B64 = d1 * d2 * (d3 * d4)
    return num / den

### log(gamma(z)) for z > 0x1.afc1ap+1 from Stirling's series, with fewer correction terms the larger z is.
### :param z: |x|, widened to B64.
### :param lz: log(`z`).
### :param ax: |x| as a B32, which picks the number of terms.
### :returns: The approximation of log(gamma(`z`)).
private routine cm_b32_lgamma_stirling(z: B64, lz: B64, ax: B32) -> B64
    stirling_lead: B64 = (z - 0.5) * (lz - 1.0)
    f: B64 = stirling_lead + 0x1.acfe390c97d69p-2
    iz: B64 = B64.truediv(1.0, z)
    iz2: B64 = iz * iz
    exact: Bool = ax >= 0x1p+20
    terms1: Bool = ax > 1198.0
    terms2: Bool = ax > 0x1.279a7p+6
    when
        exact => return f
        terms1 => return f + iz * 0x1.5555555555555p-4
        terms2 =>
            p: B64 = iz2 * -0x1.6c0fd270c465p-9 + 0x1.555555547fbadp-4
            return f + iz * p
        ax > 0x1.555556p+3 =>
            iz4: B64 = iz2 * iz2
            p0: B64 = iz2 * -0x1.6c16bdc45944fp-9 + 0x1.555555554de0bp-4
            p2: B64 = iz2 * -0x1.2e9cfff3b29c2p-11 + 0x1.a0077f300ecb3p-11
            p: B64 = p0 + iz4 * p2
            return f + iz * p
        else =>
            iz4: B64 = iz2 * iz2
            iz8: B64 = iz4 * iz4
            p0: B64 = iz2 * -0x1.6c16c0e7c4cf4p-9 + 0x1.5555555551286p-4
            p2: B64 = iz2 * -0x1.37e87ec19cb45p-11 + 0x1.a0193267fe6f2p-11
            p4: B64 = iz2 * -0x1.c16c8946b19b6p-10 + 0x1.b40011dfff081p-11
            p6: B64 = iz2 * -0x1.4f5843a71a338p-8 + 0x1.e9f47ace150d8p-9
            lo: B64 = p0 + iz4 * p2
            hi: B64 = p4 + iz4 * p6
            p: B64 = lo + iz8 * hi
            return f + iz * p

### log(gamma(z)) for 0x1.52p-1 <= z <= 0x1.afc1ap+1, from a rational approximation that vanishes at 1 and 2.
### :param z: |x|, widened to B64.
### :returns: The approximation of log(gamma(`z`)).
private routine cm_b32_lgamma_middle(z: B64) -> B64
    zero_factors: B64 = (z - 1.0) * (z - 2.0)
    n0: B64 = zero_factors * 0x1.3cc0e6a0106b3p+2
    n1: B64 = (z + 0x1.667923ff14df7p+5) * (z + 0x1.2d35f25ad8f64p+3)
    n2: B64 = (z + 0x1.b8c9eab9d5bd3p+1) * (z + 0x1.7a4a97f494127p+0)
    n3: B64 = (z + 0x1.3a6c8295b4445p-1) * (z + 0x1.da44e8b810024p-3)
    n4: B64 = n3 * (z + 0x1.9061e81c77e4ap-5)
    num: B64 = n0 * (n1 * n2 * n4)
    d1: B64 = (z + 0x1.491a899e84c52p+6) * (z + 0x1.d202961b9e098p+3)
    d2: B64 = (z + 0x1.4ced68c631ed6p+2) * (z + 0x1.2589eedf40738p+1)
    d3: B64 = (z + 0x1.1302e3337271p+0) * (z + 0x1.c36b802f26dffp-2)
    d4: B64 = (z + 0x1.3ded448acc39dp-3) * (z + 0x1.bffc491078eafp-6)
    den: B64 = d1 * d2 * (d3 * d4)
    return num / den

### log|gamma(x)| near the zero of lgamma at about -2.7476, as a polynomial in the distance h from that zero.
### :param s: x, widened to B64.
### :returns: The approximation of log|gamma(x)|.
private routine cm_b32_lgamma_near1(s: B64) -> B64
    h: B64 = s + 0x1.5fb410a1bd901p+1 - 0x1.a19a96d2e6f85p-54
    hh: B64 = h * h
    h4: B64 = hh * hh
    a0: B64 = h * 0x1.3267f3c265a54p+3 + -0x1.ea12da904b18cp+0
    a2: B64 = h * 0x1.f504accc3f2e4p+5 + -0x1.4185ac30cadb3p+4
    a4: B64 = h * 0x1.43740491dc22p+9 + -0x1.8588444c679b4p+7
    a6: B64 = h * 0x1.dac829f365795p+12 + -0x1.12400ea23f9e6p+11
    p: B64 = a0 + hh * a2 + h4 * (a4 + hh * a6)
    return h * p

### log|gamma(x)| near the zero of lgamma at about -2.4570, as a polynomial in the distance h from that zero.
### :param s: x, widened to B64.
### :returns: The approximation of log|gamma(x)|.
private routine cm_b32_lgamma_near2(s: B64) -> B64
    h: B64 = s + 0x1.3a7fc9600f86cp+1 + 0x1.55f64f98af8dp-55
    hh: B64 = h * h
    h4: B64 = hh * hh
    a0: B64 = h * 0x1.36eebb002f61ap+2 + 0x1.83fe966af535fp+0
    a2: B64 = h * 0x1.1718d7aedb0b5p+3 + 0x1.694a60589a0b3p+0
    a4: B64 = h * 0x1.8d4297421205bp+4 + 0x1.733a045eca0d3p+2
    p: B64 = a0 + hh * a2 + h4 * (a4 + hh * 0x1.7feea5fb29965p+4)
    return h * p

### log|gamma(x)| near the zero of lgamma at about -3.1435, as a polynomial in the distance h from that zero.
### :param s: x, widened to B64.
### :returns: The approximation of log|gamma(x)|.
private routine cm_b32_lgamma_near3(s: B64) -> B64
    h: B64 = s + 0x1.9260dbc9e59afp+1 + 0x1.f717cd335a7b3p-53
    hh: B64 = h * h
    h4: B64 = hh * hh
    a0: B64 = h * 0x1.9d4d297715105p+4 + 0x1.f20a65f2fac55p+2
    a2: B64 = h * 0x1.267203d24de38p+9 + 0x1.c1137124d5b21p+6
    a4: B64 = h * 0x1.2941214faaf0cp+14 + 0x1.99a63399a0b44p+11
    p: B64 = a0 + hh * a2 + h4 * (a4 + hh * 0x1.bb912c0c9cdd1p+16)
    return h * p

### sin(pi x) for x in [0, 1), as an even polynomial in x - 1/2 that vanishes at 0 and 1.
### :param x: The argument, in [0, 1).
### :returns: sin(pi `x`).
private routine cm_b32_lgamma_sinpi(x: B64) -> B64
    y: B64 = x - 0.5
    x2: B64 = y * y
    x4: B64 = x2 * x2
    x8: B64 = x4 * x4
    a0: B64 = x2 * -0x1.de9e64df22ea4p+1 + 0x1p+2
    a2: B64 = x2 * -0x1.d4fcd82df91bp-3 + 0x1.472be122401f8p+0
    a4: B64 = x2 * -0x1.f3091c427b611p-10 + 0x1.9f05c97e0aab2p-6
    a6: B64 = x2 * -0x1.15484325ef569p-18 + 0x1.b22c9bfdca547p-14
    p: B64 = a0 + x4 * a2 + x8 * (a4 + x4 * a6)
    return B64.sub(0.25, x2) * p

### log(x) for a positive normal B64 x, through a 16-entry reciprocal table.
### :param x: The argument, positive and normal.
### :returns: The natural logarithm of `x`.
private routine cm_b32_lgamma_ln(x: B64) -> B64
    tb: U64 = x.bits()
    biased_exponent: S64 = (tb >> 52).to_wrap[S64]()
    e: B64 = (biased_exponent - 0x3FF).to[B64]()
    top_bits: U64 = (tb >> 48) & 0xF
    i: USize = top_bits.to[USize]()
    t: B64 = B64.from_bits((tb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000)
    ix: B64 = B64.from_bits(CM_B32_LGAMMA_IX.getitem(i))
    z: B64 = ix * t - 1.0
    z2: B64 = z * z
    z4: B64 = z2 * z2
    a0: B64 = z * -0x1.ffffffffd1d67p-2 + 0x1.fffffffffff24p-1
    a2: B64 = z * -0x1.ffffeca81b866p-3 + 0x1.55555537802dep-2
    a4: B64 = z * -0x1.54f3e581b61bfp-3 + 0x1.999611761d772p-3
    a6: B64 = z * -0x1.9115a5af1e1edp-4 + 0x1.1e642b4cb5143p-3
    p: B64 = a0 + z2 * a2 + z4 * (a4 + z2 * a6)
    l: B64 = e * 0x1.62e42fefa39efp-1 + B64.from_bits(CM_B32_LGAMMA_IL.getitem(i))
    return l + z * p

### The tabulated correctly rounded log-gamma for a hard-to-round input with B32 bits xb, or fallback.
### :param xb: The B32 bits of the input.
### :param fallback: The result for an input that is not in the table.
### :returns: The tabulated value for a listed `xb`, else `fallback`.
private routine cm_b32_lgamma_exception(xb: U32, fallback: B32) -> B32
    each k in 0 til 27
        if CM_B32_LGAMMA_EXC_X.getitem(k) == xb
            f: B32 = B32.from_bits(CM_B32_LGAMMA_EXC_F.getitem(k))
            df: B32 = B32.from_bits(CM_B32_LGAMMA_EXC_DF.getitem(k))
            return f + df
        else
            continue
    then
        return fallback
