# Tessera stdlib: the correctly rounded arc tangent of B32
#
# A degree-7/7 rational approximation in B64, evaluated at x for |x| < 1 and at
# 1/x above, with atan(x) = sign(x) pi/2 - atan(1/x). Tiny and huge |x| are
# handled apart. Round to nearest only: +-0 stays itself, +-inf gives +-pi/2
# rounded, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/atan/atanf.c via RazorForge's B32Atan.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### arctan(`me`), correctly rounded.
### :returns: The arc tangent of `me`, in radians.
routine B32.atan(me: Me) -> Me
    local t: U32 = me.bits()
    local e: U32 = (t >> 23) & 0xFF
    local ta: U32 = t & 0x7FFFFFFF

    huge: Bool = ta >= 0x4C700518  # |x| >= 0x1.e00a3p+25
    # |x| < 2^-13
    when
        huge =>
            # sign(x) pi/2 rounded, or NaN, which comes back quiet with its sign and payload
            if ta > 0x7F800000
                return me + me
            else
                return B64.copysign(1.5707963267948966, me.to[B64]()).to[Me]()
        e < 114 =>
            # x - x^3 / 3, and x - x |x| below 2^-25 to round the right way
            very_tiny: Bool = e < 102  # |x| < 2^-25
            when
                t << 1 == 0 => return me
                very_tiny => return (-me).mul_add(a: me.abs(), b: me)
                else => return Me.mul(-0.3333333432674408, me).mul_add(a: me * me, b: me)
        else =>
            # |x| >= 2^-13: for |x| >= 1 the rational approximation is evaluated at 1/x
            gt: Bool = e >= 127
            xd: B64 = me.to[B64]()
            z: B64 = when
                gt => B64.truediv(1.0, xd)
                else => xd
            z2: B64 = z * z
            z4: B64 = z2 * z2
            z8: B64 = z4 * z4
            cn0: B64 = z2 * 0.8269936260181494 + 0.33000489885804146
            cn2: B64 = z2 * 0.3041250206581639 + 0.7536692267812706
            cn4: B64 = z2 * 0.0030928116297212196 + 0.052585465033265374
            cn6: B64 = 2.6680447001914062e-05
            n0: B64 = z4 * cn2 + cn0
            n4: B64 = z4 * cn6 + cn4
            n07: B64 = z8 * n4 + n0
            n: B64 = n07 * z
            cd0: B64 = z2 * 0.9369952589708292 + 0.3300048988580414
            cd2: B64 = z2 * 0.4972028591750377 + 1.0
            cd4: B64 = z2 * 0.0109022453539874 + 0.1155090060414157
            cd6: B64 = 0.00027322693677761577
            d0: B64 = z4 * cd2 + cd0
            d4: B64 = z4 * cd6 + cd4
            d: B64 = z8 * d4 + d0
            r: B64 = n / d
            if gt  # for |x| < 1, the rounded r is correct
                # atan(x) = sign(x) pi/2 - atan(1/x), with pi/2 split as 0x1.9p+0 + 0x1.0fdaa22168c23p-7
                lo: B64 = B64.copysign(0.008296326794896619, z)
                hi: B64 = B64.copysign(1.5625, z)
                reflected: B64 = lo - r + hi
                return reflected.to[Me]()
            else
                return r.to[Me]()
