# Tessera stdlib: the correctly rounded inverse hyperbolic cosine of B32
#
# Near 1, acosh(x) = sqrt(2 z) (1 + z f(z)) with z = x - 1 and a polynomial f
# in B64. Otherwise acosh(x) = log(x + sqrt(x^2 - 1)), with the logarithm
# reduced through a 128-entry reciprocal table and a short polynomial. A
# longer polynomial settles the cases the first can't round. The logarithm is
# asinh's (cm_b32_asinh_log in Asinh.te): the C sources carry identical copies. Round to nearest
# only: acosh(1) = 0, +inf maps to itself, x < 1 gives NaN, and a NaN comes
# back quiet.
#
# Ported from CORE-MATH, src/binary32/acosh/acoshf.c via RazorForge's B32Acosh.rf.
# Copyright (c) 2023 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### acosh(`me`), correctly rounded.
### :returns: The inverse hyperbolic cosine of `me`.
routine B32.acosh_unchecked() -> Me
    local tu: U32 = me.bits()

    when
        tu <= 0x3F800000 => pass
        tu <= 0x3F99DB23 =>
            # x <= 1, or -0
            # 1 < x <= 0x1.33b646p+0
            # x <= 1, a negative x, +inf, or NaN
            # quiets a signaling NaN
            z: B64 = (me -! 1.0).to[B64]()
            a: B64 = B64.mul_unchecked(2.0, z).sqrt_unchecked()
            z2: B64 = z *! z
            z4: B64 = z2 *! z2
            p01: B64 = z *! 0x1.333333319c2p-6 +! -0x1.555555555491ep-4
            p23: B64 = z *! 0x1.f1c698b7100cep-10 +! -0x1.6db6da26e5e0ep-8
            p45: B64 = z *! 0x1.1b4cf187158bdp-12 +! -0x1.6e7ca9e152dc2p-11
            p67: B64 = z *! 0x1.056c6c57152b2p-15 +! -0x1.b5137f11a88e5p-14
            p03: B64 = z2 *! p23 +! p01
            p47: B64 = z2 *! p67 +! p45
            f: B64 = z4 *! p47 +! p03
            correction: B64 = a *! z *! f
            return (correction +! a).to_unchecked[Me]()
        tu < 0x7F800000 =>
            xd: B64 = me.to[B64]()
            x2m1: B64 = xd *! xd -! 1.0
            tp: B64 = xd +! x2m1.sqrt_unchecked()
            return cm_b32_asinh_log(tp).to_unchecked[Me]()
        else => pass
    one: Bool = tu == 0x3F800000
    when
        one => return 0.0
        tu << 1 > 0xFF000000 => return me +! me
        tu == 0x7F800000 => return me
        else => return Me.from_bits(0x7FC00000)
