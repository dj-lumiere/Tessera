// Tessera stdlib: the correctly rounded cosine of B32
//
// x * 16/pi = q + z: sin(q pi/16) and cos(q pi/16) from a table, sin(z pi/16) and cos(z pi/16) from
// polynomials, all in B64. The few arguments the fast path can't round come from a small table of exact
// results. Round to nearest only: infinities give NaN, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/cos/cosf.c via RazorForge's B32Cos.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// The cosine of `me` (in radians), correctly rounded (to nearest). Infinities give NaN and NaN comes back quiet.
/// :returns: cos(`me`).
routine B32.cos(me: Me) -> Me
    local ax : U32 = me.bits().shl(1)

    block entry()
        outside : Bool = ax.gt(0x99000000).bitor(ax.lt(0x74000000))
        branch outside
            ? edge()
            : reduce()

    // |x| > 0x1p+26, x is NaN, or |x| < 0x1p-11, where cos(x) rounds like 1 - x^2/2
    block edge()
        tiny : Bool = ax.lt(0x74000000)
        branch tiny
            ? return(me.mul_add(me.neg(), 2.0).mul(0.5))
            : return(cm_b32_cos_big(me))

    block reduce()
        z0    : B64  = me.to[B64]()
        small : Bool = ax.lt(0x82A41896)
        hard  : Bool = ax.eq(0x812D97C8)
        when
            hard  => return(cm_b32_cos_database(me, 0.0))
            small => fast(cm_b32_trig_reduce_small(z0))
            else  => fast(cm_b32_trig_reduce_medium(z0))

    block fast(red: CmF32TrigReduced)
        z    : B64 = red.z
        ia   : U64 = red.q
        z2   : B64 = z.mul(z)
        z4   : B64 = z2.mul(z2)
        aa   : B64 = cm_b32_trig_poly_a(z2, z4)
        bb   : B64 = cm_b32_trig_poly_b(z2, z4)
        c0   : B64 = cm_b32_trig_sin_tb(ia.add_wrap(8))
        s0   : B64 = cm_b32_trig_sin_tb(ia.add_wrap(16))
        head : B64 = aa.mul(z.mul(s0)).add(c0)
        r    : B64 = head.sub(bb.mul(z2.mul(c0)))
        return(r.to[Me]())

/// The cosine of the arguments whose fast path isn't correctly rounded, as rh + rl. Any other x gives r.
/// :param x: The argument.
/// :param r: The fast path's B64 result.
/// :returns: The tabulated cosine for a listed `x`, else `r` rounded to B32.
private routine cm_b32_cos_database(x: B32, r: B64) -> B32
    block entry()
        ax : U32 = x.bits().bitand(0x7FFFFFFF)
        when ax
            0x4096CBE4 => return(B32.add(0x1.99bc5cp-27, -0x1p-52))
            0x5922AA80 => return(B32.add(0x1.115d7ep-1, -0x1p-26))
            0x5AA4542C => return(B32.add(0x1.f48148p-2, 0x1p-27))
            0x5F18B878 => return(B32.add(0x1.fe2976p-1, 0x1p-26))
            0x6115CB11 => return(B32.add(0x1.f0285ep-1, -0x1p-26))
            else       => return(r.to[B32]())

/// The cosine for |x| > 2^26, infinities and NaN.
/// :param x: The argument.
/// :returns: cos(`x`), NaN for an infinity, and a NaN `x` quieted.
private routine cm_b32_cos_big(x: B32) -> B32
    local t : U32 = x.bits()

    block entry()
        special : Bool = t.shl(1).ge(0xFF000000)
        branch special
            ? special()
            : continue
        red         : CmF32TrigReduced = cm_b32_trig_reduce_big(t, 147)
        z           : B64              = red.z
        ia          : U64              = red.q
        z2          : B64              = z.mul(z)
        z4          : B64              = z2.mul(z2)
        aa          : B64              = cm_b32_trig_poly_a(z2, z4)
        bb          : B64              = cm_b32_trig_poly_b(z2, z4)
        s0          : B64              = cm_b32_trig_sin_tb(ia.add_wrap(16))
        c0          : B64              = cm_b32_trig_sin_tb(ia.add_wrap(8))
        slope       : B64              = aa.mul(s0).sub(bb.mul(z.mul(c0)))
        r           : B64              = slope.mul(z).add(c0)
        biased_bits : U64              = r.bits().add_wrap(6)
        tail        : U64              = biased_bits.bitand(0xFFFFFFF)
        near        : Bool             = tail.le(12)  // close to a rounding boundary: only a few known arguments
        branch near
            ? return(cm_b32_cos_database(x, r))
            : return(r.to[B32]())

    // NaN comes back quiet with its sign and payload, an infinity gives a NaN
    block special()
        nan : Bool = t.shl(9).ne(0)
        branch nan
            ? return(x.add(x))
            : return(B32.from_bits(0xFFC00000))
