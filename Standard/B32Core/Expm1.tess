// Tessera stdlib: the correctly rounded e^x - 1 of B32
//
// Near zero a polynomial in x. Elsewhere x / ln(2) = k/32 + h: 2^(k/32) from a
// table, 2^h from a polynomial, all in B64, minus 1. A second, longer
// polynomial settles the cases the first can't round.
// Round to nearest only: overflow gives +inf, x -> -inf gives -1, +-0 stay
// themselves, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/expm1/expm1f.c via RazorForge's B32Expm1.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// 2^(i/32) for i in 0..31, as B64 bits.
preset CM_B32_EXPM1_TD: @Array[U64, 32] <- { 0x3FF0000000000000, 0x3FF059B0D3158574,
    0x3FF0B5586CF9890F, 0x3FF11301D0125B51, 0x3FF172B83C7D517B, 0x3FF1D4873168B9AA,
    0x3FF2387A6E756238, 0x3FF29E9DF51FDEE1, 0x3FF306FE0A31B715, 0x3FF371A7373AA9CB,
    0x3FF3DEA64C123422, 0x3FF44E086061892D, 0x3FF4BFDAD5362A27, 0x3FF5342B569D4F82,
    0x3FF5AB07DD485429, 0x3FF6247EB03A5585, 0x3FF6A09E667F3BCD, 0x3FF71F75E8EC5F74,
    0x3FF7A11473EB0187, 0x3FF82589994CCE13, 0x3FF8ACE5422AA0DB, 0x3FF93737B0CDC5E5,
    0x3FF9C49182A3F090, 0x3FFA5503B23E255D, 0x3FFAE89F995AD3AD, 0x3FFB7F76F2FB5E47,
    0x3FFC199BDD85529C, 0x3FFCB720DCEF9069, 0x3FFD5818DCFBA487, 0x3FFDFC97337B9B5F,
    0x3FFEA4AFA2A490DA, 0x3FFF50765B6E4540 }

/// e^`me` - 1, accurate near 0 and correctly rounded (to nearest). Overflow gives +inf, -inf gives -1, +-0 stay
/// themselves, and NaN comes back quiet.
/// :returns: e^`me` - 1.
routine B32.exp_m1(me: Me) -> Me
    local ux : U32 = me.bits()
    local z  : B64 = me.to[B64]()
    local ax : U32 = ux.shl(1)

    block entry()
        small : Bool = ax.lt(0x7C400000)
        large : Bool = ax.ge(0x8562E430)
        when
            small => small()
            large => large()
            else  => fast()

    // |x| < 0.15625
    block small()
        zero : Bool = ax.eq(0)
        tiny : Bool = ax.lt(0x676A09E8)
        when
            zero => return(me)
            tiny => return(me.abs().mul_add(0x1p-25, me))  // rounds like x + |x| 2^-25
            else => series()

    block series()
        z2  : B64 = z.mul(z)
        z4  : B64 = z2.mul(z2)
        p01 : B64 = z.mul(0x1.55555555555fep-3).add(0x1.fffffffffffc2p-2)
        p23 : B64 = z.mul(0x1.1111111098dc1p-7).add(0x1.555555559767fp-5)
        p45 : B64 = z.mul(0x1.a01a07658483fp-13).add(0x1.6c16bca988aa9p-10)
        p67 : B64 = z.mul(0x1.71de3a960b5e3p-19).add(0x1.a05b04d2c3503p-16)
        q03 : B64 = z2.mul(p23).add(p01)
        q47 : B64 = z4.mul(z2.mul(p67).add(p45))
        r   : B64 = z2.mul(q03.add(q47)).add(z)
        return(r.to[Me]())

    // |x| >= 0x1.62e43p+6, infinities and NaN
    block large()
        nan      : Bool = ax.gt(0xFF000000)
        negative : Bool = ux.shr(31).eq(1)
        infinite : Bool = ax.eq(0xFF000000)
        when
            nan      => return(me.add(me))
            negative => minus_one(infinite)
            else     => return(Me.INFINITY)

    // x < 0: the result is -1 (the float just above it is too far away)
    block minus_one(infinite: Bool)
        branch infinite
            ? return(-1.0)
            : return(Me.add(-1.0, 0x1p-26))

    block fast()
        a    : B64  = z.mul(0x1.71547652b82fep+5)  // 32 x / ln(2)
        ia   : B64  = a.round_ties_even()
        h    : B64  = a.sub(ia)
        h2   : B64  = h.mul(h)
        uu   : U64  = ia.add(0x1.8p+52).bits()  // the low bits are round(32 x / ln(2))
        c2   : B64  = h.mul(0x1.c6b19384ecd93p-20).add(0x1.ebfd1b232f475p-13)
        c0   : B64  = h.mul(0x1.62e42fef4c4e7p-6).add(1.0)
        tb   : U64  = CM_B32_EXPM1_TD.getitem(uu.bitand(0x1F).to[USize]())
        sv   : B64  = B64.from_bits(tb.add_wrap(uu.shr(5).shl(52)))  // 2^(round(32 x / ln(2)) / 32)
        c02  : B64  = h2.mul(c2).add(c0)
        r    : B64  = c02.mul(sv).sub(1.0)
        ub   : Me   = r.to[Me]()
        lb   : Me   = r.sub(sv.mul(0x1.3b3p-33)).to[Me]()
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(ub)
            : hard(ia, sv)

    // The fast path can't decide the rounding.
    block hard(ia: B64, sv: B64)
        far : Bool = ux.gt(0xC18AA123)  // x < -17.32
        branch far
            ? return(Me.add(-1.0, 0x1p-26))
            : slow(ia, sv)

    // a longer reduction and polynomial
    block slow(ia: B64, sv: B64)
        h_hi : B64 = z.mul(0x1.7154765p+5).sub(ia)
        h    : B64 = h_hi.add(z.mul(0x1.5c17f0bbbe88p-26))
        h2   : B64 = h.mul(h)
        w    : B64 = sv.mul(h)
        q01  : B64 = h.mul(0x1.ebfbdff82c58fp-13).add(0x1.62e42fefa39efp-6)
        q23  : B64 = h.mul(0x1.3b2ab6fb92e5ep-27).add(0x1.c6b08d702e0edp-20)
        q45  : B64 = h.mul(0x1.430976b8ce6efp-43).add(0x1.5d886e6d54203p-35)
        q    : B64 = h2.mul(h2.mul(q45).add(q23)).add(q01)
        r    : B64 = sv.sub(1.0).add(w.mul(q))
        return(r.to[Me]())
