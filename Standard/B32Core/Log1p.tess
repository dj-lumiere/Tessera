# Tessera stdlib: the correctly rounded log(1 + x) of B32
#
# Near zero a polynomial in x. Elsewhere 1 + x = 2^e (1 + m), and
# 1 + m = x0_j (1 + z) with 1/x0_j from a table, so log(1 + x) =
# e log(2) - log(x0_j) + log(1 + z), with a short polynomial in B64. A longer
# polynomial, a two-part log(2) and a double-float final sum settle the cases
# the first can't round. Round to nearest only: log1p(-1) is -inf, an input
# below -1 gives NaN, +-0 and +inf map to themselves, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/log1p/log1pf.c via RazorForge's B32Log1p.rf.
# Copyright (c) 2023-2026 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### 1/(1 + (j + 0.5)/32) for j in 0..31, rounded to 23 bits, as B64 bits.
preset CM_B32_LOG1P_X0: @Array[U64, 32] <- [0x3FEF81F800000000, 0x3FEE9131C0000000,
    0x3FEDAE6080000000, 0x3FECD85680000000, 0x3FEC0E0700000000, 0x3FEB4E81C0000000,
    0x3FEA98EF80000000, 0x3FE9EC8E80000000, 0x3FE948B100000000, 0x3FE8ACB900000000,
    0x3FE8181800000000, 0x3FE78A4C80000000, 0x3FE702E040000000, 0x3FE6816800000000,
    0x3FE6058180000000, 0x3FE58ED240000000, 0x3FE51D0800000000, 0x3FE4AFD6C0000000,
    0x3FE446F880000000, 0x3FE3E22CC0000000, 0x3FE3813800000000, 0x3FE323E340000000,
    0x3FE2C9FB40000000, 0x3FE27350C0000000, 0x3FE21FB780000000, 0x3FE1CF06C0000000,
    0x3FE1811800000000, 0x3FE135C800000000, 0x3FE0ECF580000000, 0x3FE0A68100000000,
    0x3FE0624DC0000000, 0x3FE0204080000000]

### -log(CM_B32_LOG1P_X0[j]) offset by 0x1.7654p-37 (so the fast path errs upward), as B64 bits.
preset CM_B32_LOG1P_LIX: @Array[U64, 32] <- [0x3F8FC0B0B1599CE4, 0x3FA77457A64A42AB,
    0x3FB341D74627847D, 0x3FBA926D8A568810, 0x3FC0D77E8CD667AA, 0x3FC44D2B38D15679,
    0x3FC7AB886A16B2B3, 0x3FCAF3C9B686996D, 0x3FCE27075E30CC37, 0x3FD0A3250A767D98,
    0x3FD229423BD2662E, 0x3FD3A64C596C3292, 0x3FD51AADD530E505, 0x3FD686C85E9E0177,
    0x3FD7EAF7DF859CAE, 0x3FD94793EE2403B3, 0x3FDA9CEC5A9CF512, 0x3FDBEB4D3BAA086F,
    0x3FDD32FE2A03D8B5, 0x3FDE744257D97431, 0x3FDFAF58CF7BDFE7, 0x3FE0723E6D1E5599,
    0x3FE109F3B52EC2F3, 0x3FE19EE6A7693FC5, 0x3FE23130D9C03597, 0x3FE2C0E9CC4604F1,
    0x3FE34E28BD9E5837, 0x3FE3D9028A72CD5F, 0x3FE4618B9C1DD52D, 0x3FE4E7D825B8D20B,
    0x3FE56BF9FAB56A02, 0x3FE5EE02AB258CCA]

### ln(1 + `me`), accurate near 0 and correctly rounded.
### :returns: ln(1 + `me`).
routine B32.ln_1p(me: Me) -> Me
    z: B64 = me.to[B64]()
    ux: U32 = me.bits()
    ax: U32 = ux & 0x7FFFFFFF
    below: Bool = ux >= 0xBF800000  # x <= -1, -inf, or a negative NaN
    special: Bool = ax >= 0x7F800000  # +inf or a positive NaN
    # |x| < 0x1.1p-6
    when
        below => return cm_b32_log1p_special(me)
        special => return cm_b32_log1p_special(me)
        ax < 0x3C880000 =>
            # |x| < 0x1p-25
            if ax < 0x33000000
                # log1p(x) rounds like x - x^2
                if ax == 0
                    return me
                else
                    return me.mul_add(a: -me, b: me)
            else
                f: B64 = cm_b32_log1p_poly(z, z2: z * z)
                r: B64 = z + f
                low_bits: U64 = r.bits() & 0xFFFFFFF
                if low_bits == 0
                    return (r + (f + (z - r)) * 16384.0).to[Me]()
                else
                    return r.to[Me]()
        else =>
            tp: U64 = (z + 1.0).bits()
            biased_exponent: U64 = tp >> 52
            e: S64 = biased_exponent.to[S64]() - 0x3FF
            ed: B64 = e.to[B64]()
            m52: U64 = tp & 0x000FFFFFFFFFFFFF
            top_bits: U64 = (tp >> 47) & 31
            j: USize = top_bits.to[USize]()
            xd: B64 = B64.from_bits(m52 | 0x3FF0000000000000)
            zj: B64 = xd * B64.from_bits(CM_B32_LOG1P_X0.getitem(j)) - 1.0  # exact for x < 0x1.0cp+30
            lixj: B64 = B64.from_bits(CM_B32_LOG1P_LIX.getitem(j))
            z2: B64 = zj * zj
            c01: B64 = B64.sub(0.9999999964978914, zj * 0.49999999241150506)
            c23: B64 = B64.sub(0.33339251544971726, zj * 0.2500690494115668)
            e_log: B64 = ed * 0.6931471805599453 + lixj
            r: B64 = e_log + zj * (c01 + z2 * c23)
            ub: Me = r.to[Me]()
            lb: Me = (r - 2.1555e-11).to[Me]()
            if ub == lb
                return ub
            else
                # The fast path can't decide the rounding: a longer polynomial, a two-part log(2) and a double-float final sum.
                f: B64 = cm_b32_log1p_poly(z: zj, z2)
                lj: B64 = lixj - 1.063904520037795e-11  # remove the offset
                lh: B64 = ed * 0.693145751953125
                ll: B64 = ed * 1.4286068203094173e-06 + zj
                rh: B64 = lh + lj
                rh_err: B64 = lh - rh + lj
                rl: B64 = rh_err + (ll + f)
                fh: Me = (rh + rl).to[Me]()
                fl64: B64 = rh - fh.to[B64]() + rl
                fl: Me = fl64.to[Me]()
                tfl: Me = fl * 2.0
                rounded_tfl: Me = fh + tfl - fh
                if rounded_tfl == tfl
                    # fh + fl may land on a tie: move fl by half its size toward fl64
                    sign: Me = (fl64 - fl.to[B64]()).to[Me]()
                    step: Me = Me.copysign(0.5, sign) * fl.abs()
                    return fh + (fl + step)
                else
                    return fh + fl

### z^2 (-1/2 + z/3 - z^2/4 + ...), the tail of log(1 + z) past z.
### :param z: The argument.
### :param z2: `z`^2.
### :returns: The tail.
private routine cm_b32_log1p_poly(z: B64, z2: B64) -> B64
    z4: B64 = z2 * z2
    c01: B64 = z * 0.333333333333704 + -0.5
    c23: B64 = z * 0.1999999921853749 + -0.2500000000005929
    c56: B64 = B64.sub(0.1429098594542405, z * 0.125052714602758)
    c46: B64 = c56 * z + -0.16666665744658113
    return z2 * (c01 + z2 * c23 + z4 * c46)

### log1p of -1 (-inf), +inf (itself), NaN (itself, quiet) or an input below -1 (NaN).
### :param x: The special input.
### :returns: ln(1 + `x`).
private routine cm_b32_log1p_special(x: B32) -> B32
    ux: U32 = x.bits()
    minus: Bool = ux == 0xBF800000
    inf: Bool = ux == 0x7F800000
    when
        minus => return B32.from_bits(0xFF800000)
        inf => return x
        ux << 1 > 0xFF000000 => return x + x
        else => return B32.from_bits(0xFFC00000)
