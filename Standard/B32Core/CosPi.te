# Tessera stdlib: the correctly rounded cos(pi x) of B32
#
# With 64 |x| = iq + z/2^32 for an integer iq: cos(iq pi/64) and sin(iq pi/64) from sin_pi's table,
# cos(z pi/2^38) - 1 and sin(z pi/2^38) from short polynomials, all in B64, where one evaluation rounds correctly to
# B32. Multiples of 1/64 read the table directly, |x| < 2^-15 is 1 - (pi^2/2) x^2 by one FMA, |x| >= 2^24 is an
# even integer. Round to nearest only.
#
# Ported from CORE-MATH, src/binary32/cospi/cospif.c via RazorForge's B32Cospi.rf.
# Copyright (c) 2022 Alexei Sibidanov
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### cos(pi me), correctly rounded (to nearest, ties to even). An integer gives +-1, a half-integer +0, +-inf
### gives NaN, and NaN comes back quiet.
### :returns: cos(pi `me`).
routine B32.cos_pi() -> Me
    local ix: U32 = me.bits()
    local e: S32 = ((ix >> 23) & 0xFF).to_wrap[S32]()
    local m: U32 = (ix & 0x7FFFFF) | 0x800000

    if e == 0xFF
        # |x| < 2^-15
        # |x| >= 2^17: x is a multiple of 1/64
        # infinities give NaN, NaN comes back quiet with its sign and payload
        if ix << 9 == 0
            return Me.from_bits(0x7FC00000)
        return me + me
    p: S32 = e - 112
    tiny: Bool = p < 0
    when
        tiny =>
            # the product below would underflow for |x| < 0x1.9f03p-129
            ax: U32 = ix & 0x7FFFFFFF
            if ax >= 0x19F030
                return (me * -0x1.3bd3ccp+2).mul_add(a: me, b: 1.0)
            return (-me).mul_add(a: me, b: 1.0)
        p > 31 =>
            # |x| >= 2^49: an even integer, too large for the shift below
            if p > 63
                return 1.0
            shift: U32 = (p - 32).to[U32]()
            # the bits of 64 |x| below the binary point, scaled by 2^32
            # x is a multiple of 1/64
            # |x| = iq/64: cos(pi x) = sin((iq + 32) pi/64)
            i: U32 = (m << shift) +% 32 & 127
            r: B64 = B64.from_bits(CM_B32_SIN_PI_S.getitem(i.to[U64]()))
            return r.to[Me]()
        else =>
            k: U32 = m << p.to[U32]()
            if k == 0
                iq: U32 = m >> S32.sub(32, p).to[U32]()
                i: U32 = iq +% 32 & 127
                r: B64 = B64.from_bits(CM_B32_SIN_PI_S.getitem(i.to[U64]()))
                return r.to[Me]()
            z: B64 = k.to_wrap[S32]().to[B64]()  # 64 |x| - round(64 |x|), scaled by 2^32
            z2: B64 = z * z
            fs2: B64 = B64.add(-0x1.4abbce6102b94p-112, z2 * 0x1.4669fa3c58463p-189)
            fs: B64 = B64.add(0x1.921fb54442d0fp-37, z2 * fs2)
            fc2: B64 = B64.add(0x1.03c1f08088742p-150, z2 * -0x1.55d1e5eff55a5p-228)
            fc: B64 = B64.add(-0x1.3bd3cc9be45cfp-74, z2 * fc2)
            s: U32 = S32.sub(31, p).to[U32]()
            iq: U32 = (m >> s) +% 1 >> 1  # round(64 |x|)
            ts_i: U32 = iq +% 32 & 127
            ts: B64 = B64.from_bits(CM_B32_SIN_PI_S.getitem(ts_i.to[U64]()))
            tc: B64 = B64.from_bits(CM_B32_SIN_PI_S.getitem((iq & 127).to[U64]()))
            head: B64 = ts + ts * z2 * fc
            r: B64 = head - tc * z * fs
            return r.to[Me]()
