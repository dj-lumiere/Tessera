// Tessera stdlib: the correctly rounded tangent of B32
//
// x * 2/pi = q + z, and tan(z pi/2) is a rational function n/d of z in B64: an even q gives n/d, an odd one
// -d/n. The few arguments the fast path can't round come from a small table of exact results. Round to
// nearest only: +-0 stays itself, infinities give NaN, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/tan/tanf.c via RazorForge's B32Tan.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// The tangent of `me` (in radians), correctly rounded (to nearest). +-0 stays itself, infinities give NaN, and
/// NaN comes back quiet.
/// :returns: tan(`me`).
routine B32.tan(me: Me) -> Me
    shared t : U32 = me.bits()

    block entry()
        e      : U32  = t.shr(23).bitand(0xFF)
        tiny   : Bool = e.lt(102)  // |x| < 2^-26: tan(x) rounds like x + x |x| tiny
        small  : Bool = e.lt(115)  // |x| < 2^-13
        medium : Bool = e.lt(155)  // |x| < 2^28
        finite : Bool = e.lt(0xFF)
        when
            tiny   -> return(me.mul_add(me.abs(), me))
            small  -> return(me.mul_add(me.mul(me).mul(0x1.555556p-2), me))
            medium -> fast(cm_b32_tan_reduce(me.to[B64]()))
            finite -> fast(cm_b32_trig_reduce_big(t, 150))
            else   -> special()

    // NaN comes back quiet with its sign and payload, an infinity gives a NaN
    block special()
        nan : Bool = t.shl(9).ne(0)
        branch nan
            ? return(me.add(me))
            : return(Me.NAN)

    block fast(red: CmF32TrigReduced)
        z   : B64  = red.z
        z2  : B64  = z.mul(z)
        z4  : B64  = z2.mul(z2)
        n01 : B64  = z2.mul(-0x1.fd226e573289fp-2).add(0x1.921fb54442d18p+0)
        n23 : B64  = z2.mul(-0x1.725beb40f33e5p-13).add(0x1.b7a60c8dac9f6p-6)
        n03 : B64  = z4.mul(n23).add(n01)
        n   : B64  = n03.mul(z)
        d01 : B64  = z2.mul(-0x1.2395347fb829dp+0).add(0x1p+0)
        d23 : B64  = z2.mul(-0x1.9a707ab98d1c1p-9).add(0x1.2313660f29c36p-3)
        d   : B64  = z4.mul(d23).add(d01)
        odd : Bool = red.q.bitand(1).eq(1)  // an even quotient gives n/d, an odd one -d/n
        s0  : B64  = odd
            ? 1.0
            : 0.0
        s1 : B64 = odd
            ? 0.0
            : 1.0
        num         : B64  = n.mul(s1).sub(d.mul(s0))
        den         : B64  = n.mul(s0).add(d.mul(s1))
        r           : B64  = num.div(den)
        biased_bits : U64  = r.bits().add_wrap(7)
        tail        : U64  = biased_bits.bitand(0x1FFFFFFF)
        near        : Bool = tail.le(14)  // close to a rounding boundary: only a few known arguments
        branch near
            ? return(cm_b32_tan_database(me, r))
            : return(r.to[Me]())

/// Reduces x (|x| < 2^28) modulo pi/2 with a two-part 2/pi: x * 2/pi = q + z. Only the low bit of q matters.
/// :param x: The argument.
/// :returns: The reduced argument (z, q).
private routine cm_b32_tan_reduce(x: B64) -> CmF32TrigReduced
    block entry()
        idl : B64 = x.mul(-0x1.b1bbead603d8bp-32)
        idh : B64 = x.mul(0x1.45f306ep-1)
        q   : B64 = idh.add(0x1.8p+52)  // rounds idh to an integer, left in the low mantissa bits
        id  : B64 = q.sub(0x1.8p+52)
        z   : B64 = idh.sub(id).add(idl)
        return(CmF32TrigReduced { z: z, q: q.bits() })

/// The tangent of the arguments whose fast path isn't correctly rounded, as sign(x) (rh + rl) with rh + rl
/// the result for |x|. Any other x gives r.
/// :param x: The argument.
/// :param r: The fast path's B64 result.
/// :returns: The tabulated tangent for a listed `x`, else `r` rounded to B32.
private routine cm_b32_tan_database(x: B32, r: B64) -> B32
    block entry()
        ax : U32 = x.bits().bitand(0x7FFFFFFF)
        when ax
            0x3F8A1F62 -> exact(0x1.ddf9f6p+0, -0x1.891d24p-52)
            0x4D56D355 -> exact(0x1.e80304p-3, 0x1.419f46p-58)
            0x57D7B0ED -> exact(0x1.60d1c8p-2, -0x1.2d6c3ap-55)
            0x5980445E -> exact(0x1.ca1edp+0, 0x1.f6053p-53)
            0x63FC86FE -> exact(0x1.597f9cp-1, 0x1.925978p-53)
            0x6A662711 -> exact(-0x1.f33584p+1, 0x1.d7254ap-51)
            0x6AD36709 -> exact(-0x1.c5612ep-1, -0x1.26c33ep-53)
            0x72B505BB -> exact(-0x1.e42a1ep+0, -0x1.1dc906p-52)
            else       -> return(r.to[B32]())

    block exact(rh: B32, rl: B32)
        sign_bit : U32  = x.bits().shr(31)
        negative : Bool = sign_bit.eq(1)
        branch negative
            ? return(rh.neg().sub(rl))
            : return(rh.add(rl))
