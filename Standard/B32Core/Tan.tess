# Tessera stdlib: the correctly rounded tangent of B32
#
# x * 2/pi = q + z, and tan(z pi/2) is a rational function n/d of z in B64: an even q gives n/d, an odd one
# -d/n. The few arguments the fast path can't round come from a small table of exact results. Round to
# nearest only: +-0 stays itself, infinities give NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/tan/tanf.c via RazorForge's B32Tan.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The tangent of `me` (in radians), correctly rounded (to nearest). +-0 stays itself, infinities give NaN, and
### NaN comes back quiet.
### :returns: tan(`me`).
routine B32.tan(me: Me) -> Me
    local t: U32 = me.bits()

    e: U32 = (t >> 23) & 0xFF
    tiny: Bool = e < 102  # |x| < 2^-26: tan(x) rounds like x + x |x| tiny
    small: Bool = e < 115  # |x| < 2^-13
    medium: Bool = e < 155  # |x| < 2^28
    when
        tiny => return me.mul_add(a: me.abs(), b: me)
        small => return me.mul_add(a: me * me * 0.3333333432674408, b: me)
        medium => jump fast(cm_b32_tan_reduce(me.to[B64]()))
        e < 0xFF => jump fast(cm_b32_trig_reduce_big(u: t, bias: 150))
        else => jump special()

    # NaN comes back quiet with its sign and payload, an infinity gives a NaN
    block special()
        if t << 9 != 0
            return me + me
        else
            return Me.NAN

    block fast(red: CmF32TrigReduced)
        z: B64 = red.z
        z2: B64 = z * z
        z4: B64 = z2 * z2
        n01: B64 = z2 * -0.49720165641032027 + 1.5707963267948966
        n23: B64 = z2 * -0.00017660096093977045 + 0.02683402276915988
        n03: B64 = z4 * n23 + n01
        n: B64 = n03 * z
        d01: B64 = z2 * -1.1389954387488281 + 1.0
        d23: B64 = z2 * -0.0031314039049681057 + 0.1421268437745497
        d: B64 = z4 * d23 + d01
        odd: Bool = red.q & 1 == 1  # an even quotient gives n/d, an odd one -d/n
        s0: B64 = when
            odd => 1.0
            else => 0.0
        s1: B64 = when
            odd => 0.0
            else => 1.0
        num: B64 = n * s1 - d * s0
        den: B64 = n * s0 + d * s1
        r: B64 = num / den
        biased_bits: U64 = r.bits() +% 7
        tail: U64 = biased_bits & 0x1FFFFFFF
        # close to a rounding boundary: only a few known arguments
        if tail <= 14
            return cm_b32_tan_database(x: me, r)
        else
            return r.to[Me]()

### Reduces x (|x| < 2^28) modulo pi/2 with a two-part 2/pi: x * 2/pi = q + z. Only the low bit of q matters.
### :param x: The argument.
### :returns: The reduced argument (z, q).
private routine cm_b32_tan_reduce(x: B64) -> CmF32TrigReduced
    idl: B64 = x * -3.944788223297384e-10
    idh: B64 = x * 0.6366197727620602
    q: B64 = idh + 6755399441055744.0  # rounds idh to an integer, left in the low mantissa bits
    id: B64 = q - 6755399441055744.0
    z: B64 = idh - id + idl
    return CmF32TrigReduced(z: z, q: q.bits())

### The tangent of the arguments whose fast path isn't correctly rounded, as sign(x) (rh + rl) with rh + rl
### the result for |x|. Any other x gives r.
### :param x: The argument.
### :param r: The fast path's B64 result.
### :returns: The tabulated tangent for a listed `x`, else `r` rounded to B32.
private routine cm_b32_tan_database(x: B32, r: B64) -> B32
    ax: U32 = x.bits() & 0x7FFFFFFF
    when ax
        0x3F8A1F62 => jump exact(1.8670953512191772, -3.409718953073569e-16)
        0x4D56D355 => jump exact(0.23828700184822083, 4.358793082672146e-18)
        0x57D7B0ED => jump exact(0.3445502519607544, -3.268032112391647e-17)
        0x5980445E => jump exact(1.7895326614379883, 2.1771658420191705e-16)
        0x63FC86FE => jump exact(0.6748017072677612, 1.7449127529366843e-16)
        0x6A662711 => jump exact(-3.9000706672668457, 8.173074377011539e-16)
        0x6AD36709 => jump exact(-0.8855070471763611, -1.2783292861530832e-16)
        0x72B505BB => jump exact(-1.8912676572799683, -2.4787918922562627e-16)
        else => return r.to[B32]()

    block exact(rh: B32, rl: B32)
        sign_bit: U32 = x.bits() >> 31
        if sign_bit == 1
            return -rh - rl
        else
            return rh + rl
