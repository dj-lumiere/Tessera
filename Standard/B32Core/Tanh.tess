// Tessera stdlib: the correctly rounded hyperbolic tangent of B32
//
// Near zero x - x^3 / 3 in B32 with a fused multiply-add. Up to
// |x| = 0x1.205966p+3 a rational approximation x n(x^2) / d(x^2) in B64.
// Beyond it the result rounds to +-1.
// Infinities give +-1, +-0 stay themselves, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/tanh/tanhf.c via RazorForge's B32Tanh.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// tanh `me`, correctly rounded. Infinities give +-1 and NaN comes back quiet.
/// :returns: The hyperbolic tangent of `me`.
routine B32.tanh(me: Me) -> Me
    local ux: U32 = me.bits()
    local e: U32 = ux.shr(23).bitand(0xFF)

    special: Bool = e.eq(0xFF)
    small: Bool = e.lt(115)  // |x| < 2^-13
    one: Bool = ux.shl(1).gt(0x82205966)  // |x| > 0x1.205966p+3
    when
        special => special()
        small => small()
        one => return(Me.copysign(1.0, me).sub(Me.copysign(0x1p-25, me)))
        else => return(cm_b32_tanh_rational(me.to[B64]()))

    // infinities give +-1, NaN comes back quiet
    block special()
        nan: Bool = ux.shl(9).ne(0)
        branch nan
            ? return(me.add(me))
            : return(Me.copysign(1.0, me))

    block small()
        zero: Bool = ux.shl(1).eq(0)
        tiny: Bool = e.lt(102)  // |x| < 2^-26
        when
            zero => return(me)
            tiny => return(me.neg().mul_add(a: me.abs(), b: me))
            else => cubic()

    // x - x^3 / 3 with one rounding for the final addition
    block cubic()
        x2: Me = me.mul(me)
        return(me.mul_add(a: Me.mul(-0x1.555556p-2, x2), b: me))

/// tanh z = z n(z^2) / d(z^2), rounded to B32.
/// :param z: The argument, 2^-13 <= |z| <= 0x1.205966p+3.
/// :returns: tanh(`z`), rounded to B32.
private routine cm_b32_tanh_rational(z: B64) -> B32
    z2: B64 = z.mul(z)
    z4: B64 = z2.mul(z2)
    z8: B64 = z4.mul(z4)
    n0: B64 = z2.mul(0x1.30877b8b72d33p-3).add(1.0)
    n2: B64 = z2.mul(0x1.4101377abb729p-14).add(0x1.694aa09ae9e5ep-8)
    n4: B64 = z2.mul(0x1.2533756e546f7p-30).add(0x1.e0392b1db0018p-22)
    n6: B64 = z2.mul(0x1.b06be534182dep-54).add(0x1.d62e5abe6ae8ap-41)
    n02: B64 = z4.mul(n2).add(n0)
    n46: B64 = z4.mul(n6).add(n4)
    n: B64 = z8.mul(n46).add(n02)
    d0: B64 = z2.mul(0x1.ed99131b0ebeap-2).add(1.0)
    d2: B64 = z2.mul(0x1.7cbdaca0e9fccp-11).add(0x1.0d27ed6c95a69p-5)
    d4: B64 = z2.mul(0x1.a6f707c5c71abp-26).add(0x1.b4e60b892578ep-18)
    d6: B64 = z2.mul(0x1.ca8230677aa01p-47).add(0x1.35a8b6e2cd94cp-35)
    d02: B64 = z4.mul(d2).add(d0)
    d46: B64 = z4.mul(d6).add(d4)
    d: B64 = z8.mul(d46).add(d02)
    ratio: B64 = z.mul(n).div(d)
    return(ratio.to[B32]())
