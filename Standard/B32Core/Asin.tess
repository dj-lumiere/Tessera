// Tessera stdlib: the correctly rounded arc sine of B32
//
// A fast odd polynomial in x covers |x| < 0x1.c29p-1 and settles most inputs.
// The rest go through an accurate path in B64: for |x| < 1/2 a degree-11
// polynomial in x^2, above that pi/2 - sqrt(1 - |x|) times a polynomial in
// 1 - |x|. Round to nearest only: |x| > 1 gives NaN, NaN comes back quiet.
// The accurate polynomial cm_b32_asin_poly12 is shared with acos.
//
// Ported from CORE-MATH, src/binary32/asin/asinf.c via RazorForge's B32Asin.rf.
// Copyright (c) 2023 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// The two degree-11 accurate-path polynomials, as B64 bits: entries 0..11
/// approximate (asin(x) - x) / x^3 in x^2, entries 12..23 approximate
/// (pi/2 - asin(1 - z)) / sqrt(z) in z.
preset CM_B32_ASIN_C: @Array[U64, 24] <- [0x3FC555555555529C, 0x3FB333333337E0DD,
    0x3FA6DB6DB3B4465E, 0x3F9F1C72E13AC306, 0x3F96E89CEBE06BC4, 0x3F91C6DCF5289094,
    0x3F8C6DBBCC7C6315, 0x3F88F8DC2615E996, 0x3F7A5833B7BF15E8, 0x3F943F44ACE1665C,
    0xBF90FB17DF881C73, 0x3FA07520C026B2D6, 0x3FF6A09E667F3BCB, 0x3FBE2B7DDDFF2DB9,
    0x3F9B27247AB42DBC, 0x3F802995CC4E0744, 0x3F65FFB0276EC8EA, 0x3F5033885A928DEC,
    0x3F3911F2BE23F8C7, 0x3F24C3C55D2437FD, 0x3F0AF477E1D7B461, 0x3F0ABD6BDFF67DCB,
    0xBEF1717E86D0FA28, 0x3EF6FF526DE46023]

/// arcsin(`me`), correctly rounded.
/// :returns: The arc sine of `me`, in radians.
routine B32.asin(me: Me) -> Me
    local xs: B64 = me.to[B64]()
    local ax: U32 = me.bits().shl(1)

    block entry()
        outside: Bool = ax.gt(0x7F000000)
        fast: Bool = ax.lt(0x7EC29000)
        when
            outside => outside()
            fast => fast()
            else => accurate()

    // |x| > 1 or NaN, which comes back quiet with its sign and payload
    block outside()
        nan: Bool = ax.gt(0xFF000000)
        branch nan
            ? return(me.add(me))
            : return(Me.from_bits(0xFFC00000))

    // |x| < 0x1.c29p-1
    block fast()
        tiny: Bool = ax.lt(0x73000000)  // |x| < 0x1p-12
        branch tiny
            ? return(me.mul_add(a: 0x1p-25, b: me))
            : continue
        z2: B64 = xs.mul(xs)
        z4: B64 = z2.mul(z2)
        z8: B64 = z4.mul(z4)
        z16: B64 = z8.mul(z8)
        a01: B64 = z2.mul(0x1.55557aeca105dp-3).add(0x1.0000000000005p+0)
        a23: B64 = z2.mul(0x1.775738a5a6f92p-5).add(0x1.3314ec3db7d12p-4)
        a45: B64 = z2.mul(0x1.605c6d58740fp-2).add(0x1.5d5f7ce1c8538p-8)
        a67: B64 = z2.mul(0x1.f152170f151ebp+3).add(-0x1.5728b732d73c6p+1)
        p0: B64 = z8.mul(z4.mul(a67).add(a45)).add(z4.mul(a23).add(a01))
        b01: B64 = z2.mul(0x1.71971e17375ap+7).add(-0x1.f962ea3ca992ep+5)
        b23: B64 = z2.mul(0x1.26a3b8d4bdb14p+9).add(-0x1.860512b4ba23p+8)
        b45: B64 = z2.mul(0x1.b3d722aebfa2ep+8).add(-0x1.36f2ea5698b51p+9)
        b67: B64 = z2.mul(0x1.1518af6a65e2dp+5).add(-0x1.6cf89703b1289p+7)
        p1: B64 = z8.mul(z4.mul(b67).add(b45)).add(z4.mul(b23).add(b01))
        rf: B64 = xs.mul(z16.mul(p1).add(p0))
        ub: Me = rf.to[Me]()
        lb: Me = rf.sub(xs.mul(0x1.efa8ebp-31)).to[Me]()
        sure: Bool = ub.eq(lb)
        branch sure
            ? return(ub)
            : accurate()

    // The fast path can't decide the rounding, or |x| >= 0x1.c29p-1.
    block accurate()
        half: Bool = ax.lt(0x7E000000)  // |x| < 1/2
        hard1: Bool = ax.eq(0x7E55688A)
        hard2: Bool = ax.eq(0x7E107434)
        when
            half => small()
            hard1 => return(Me.copysign(0x1.75b8a2p-1, me).add(Me.copysign(0x1p-26, me)))
            hard2 => return(Me.copysign(0x1.1f4b64p-1, me).add(Me.copysign(0x1p-26, me)))
            else => large()

    // x + x^3 p(x^2)
    block small()
        z2: B64 = xs.mul(xs)
        x3: B64 = xs.mul(z2)
        r: B64 = x3.mul(cm_b32_asin_poly12(z: z2, base: 0)).add(xs)
        return(r.to[Me]())

    // sign(x) (pi/2 - sqrt(z) q(z)) with z = 1 - |x|
    block large()
        z: B64 = B64.sub(1.0, xs.abs())
        s: B64 = z.sqrt()
        r: B64 = B64.sub(0x1.921fb54442d18p+0, s.mul(cm_b32_asin_poly12(z, base: 12)))
        return(r.copysign(xs).to[Me]())

/// Evaluates one of the two degree-11 polynomials of CM_B32_ASIN_C at `z`.
/// :param z: The point to evaluate at.
/// :param base: 0 or 12, the index of the polynomial's first coefficient.
/// :returns: The polynomial's value.
routine cm_b32_asin_poly12(z: B64, base: USize) -> B64
    block entry()
        z2: B64 = z.mul(z)
        z4: B64 = z2.mul(z2)
        c0: B64 = z.mul(cm_b32_asin_coef(base, k: 1)).add(cm_b32_asin_coef(base, k: 0))
        c2: B64 = z.mul(cm_b32_asin_coef(base, k: 3)).add(cm_b32_asin_coef(base, k: 2))
        c4: B64 = z.mul(cm_b32_asin_coef(base, k: 5)).add(cm_b32_asin_coef(base, k: 4))
        c6: B64 = z.mul(cm_b32_asin_coef(base, k: 7)).add(cm_b32_asin_coef(base, k: 6))
        c8: B64 = z.mul(cm_b32_asin_coef(base, k: 9)).add(cm_b32_asin_coef(base, k: 8))
        c10: B64 = z.mul(cm_b32_asin_coef(base, k: 11)).add(cm_b32_asin_coef(base, k: 10))
        d0: B64 = c2.mul(z2).add(c0)
        d4: B64 = c6.mul(z2).add(c4)
        d8: B64 = z2.mul(c10).add(c8)
        r: B64 = z4.mul(z4.mul(d8).add(d4)).add(d0)
        return(r)

/// Coefficient `k` of the polynomial starting at `base` in CM_B32_ASIN_C.
/// :param base: The index of the polynomial's first coefficient.
/// :param k: The coefficient's index within the polynomial.
/// :returns: The coefficient.
private routine cm_b32_asin_coef(base: USize, k: USize) -> B64
    block entry()
        return(B64.from_bits(CM_B32_ASIN_C.getitem(base.add(k))))
