// Tessera stdlib: the correctly rounded hyperbolic cosine of B32
//
// Near zero a polynomial in x^2. Elsewhere 32 x / ln(2) = k + h, and
// cosh x = 2^(k/32) 2^(h/32) / 2 + 2^(-k/32) 2^(-h/32) / 2 with the powers of
// two from a table and 2^(+-h/32) from a polynomial, all in B64. A second,
// longer polynomial settles the cases the first can't round. The table and
// cm_b32_sinh_scale are shared with sinh (Sinh.tess).
// Round to nearest only: overflow gives +inf, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/cosh/coshf.c via RazorForge's B32Cosh.rf.
// Copyright (c) 2022-2023 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// cosh `me`, correctly rounded.
/// :returns: The hyperbolic cosine of `me`.
routine B32.cosh(me: Me) -> Me
    local ax: U32 = me.bits() << 1

    large: Bool = ax > 0x8565A9F8
    when
        large =>
            // |x| > 0x1.65a9f8p+6: NaN, infinities, or overflow
            if ax >= 0xFF000000
                return me * me
            else
                return Me.INFINITY
        ax < 0x7C000000 =>
            // |x| < 0.125
            tiny: Bool = ax < 0x66000000
            // |x| < 0x1p-11
            when
                tiny => return me.abs().mul_add(a: 2.980232238769531e-08, b: 1.0)
                ax < 0x74000000 =>
                    half_square: Me = me * 0.5 * me
                    return half_square + 1.0
                else =>
                    z: B64 = me.to[B64]()
                    z2: B64 = z * z
                    z4: B64 = z2 * z2
                    p0: B64 = z2 * 0.04166666666748819 + 0.4999999999999984
                    p1: B64 = z2 * 2.4812354013894482e-05 + 0.0013888887416776143
                    p: B64 = z4 * p1 + p0
                    r: B64 = z2 * p + 1.0
                    return r.to[Me]()
        else => return cm_b32_cosh_main(me.to[B64]())

/// The main path of cosh, for 0.125 <= |x| without overflow: e^x / 2 + e^-x / 2 from a 2^(k/32) table.
/// :param z: The argument as B64.
/// :returns: cosh(`z`), rounded to B32.
private routine cm_b32_cosh_main(z: B64) -> B32
    local a: B64 = z * 46.16624130844683
    // 32 x / ln(2)
    local ia: B64 = a.round_ties_even()
    local h: B64 = a - ia
    local h2: B64 = h * h
    local sp: B64 = cm_b32_sinh_scale(ia, minus: false)
    local sm: B64 = cm_b32_sinh_scale(ia, minus: true)

    tev: B64 = h2 * 0.0002345984913513542 + 1.0
    tod: B64 = h2 * 1.6938658699950235e-06 + 0.021660849391257477
    rp: B64 = sp * (h * tod + tev)
    rm: B64 = sm * (tev - h * tod)
    r: B64 = rp + rm
    ub: B32 = r.to[B32]()
    lb: B32 = (r - r * 1.45e-10).to[B32]()
    if ub == lb
        return ub
    else
        // too close to a rounding boundary: redo it with a split 32 / ln(2) and a longer polynomial
        h_hi: B64 = z * 46.16624128818512 - ia
        h_split: B64 = h_hi + z * 2.026170940661134e-08
        h2_split: B64 = h_split * h_split
        te4: B64 = h2_split * 1.4345723178374038e-13 + 9.172562701702629e-09
        te02: B64 = h2_split * 0.0002345961982022468 + 1.0
        tev2: B64 = te02 + h2_split * h2_split * te4
        to2: B64 = h2_split * 3.973729405780548e-11 + 1.6938509724129055e-06
        tod2: B64 = h2_split * to2 + 0.02166084939249829
        rp2: B64 = sp * (h_split * tod2 + tev2)
        rm2: B64 = sm * (tev2 - h_split * tod2)
        r2: B64 = rp2 + rm2
        return r2.to[B32]()
