### Two rows of 16 coefficients (for |x| <= 0x1.0a2p+1 and above), as B64 bits: the shift a and pole b
### of z = (|x| - a) / (|x| + b), then the polynomial s(z).
preset CM_B32_ERFC_CT: @Array[U64, 32] <- [0x3FEC162355429B28, 0x400D99999999999A,
    0x3FDDA951CECE2B85, 0xBFF70EF6CFF4BCC4, 0x4003D7F7B3D617DE, 0xC009D0AA47537C51,
    0x4009754EA9A3FCB1, 0xC0027A5453FCC015, 0x3FF1EF2E0531AEBA, 0xBFCECA090F5A1C06,
    0xBFB7A3CD173A063C, 0x3FB30FA68A68FDDD, 0x3F555AD9A326993A, 0xBF907E7B0BB39FBF,
    0x3F52328706C0E950, 0x3F6D6AA0B7B19CFE, 0x401137C8983F8516, 0x400799999999999A,
    0x3FC05B53AA241333, 0xBFCA3F53872BF870, 0x3FBDE4C30742C9D5, 0xBFACB24BFA591986,
    0x3F9666AEC059CA5F, 0xBF7A61250EB26B0B, 0x3F52B28B7924B34D, 0x3F041B13A9D45013,
    0xBF16DD5E8A273613, 0x3EF09CE8EA5E8DA5, 0x3ED33923B4102981, 0xBEC1DFD161E3F984,
    0xBE8C87618FCAE3B3, 0x3E8E8A6FFA0BA2C7]

### 1 - erf(`me`), accurate where erf is near 1 and correctly rounded (to nearest). -inf gives 2, +inf gives 0,
### and NaN comes back quiet.
### :returns: erfc(`me`).
routine B32.erfc() -> Me
    local ax: Me = me.abs()
    local axd: B64 = ax.to[B64]()
    local x2: B64 = axd * axd
    local tu: U32 = me.bits()
    local at: U32 = tu & 0x7FFFFFFF
    local sgn: U64 = (tu >> 31).to[U64]()
    local row: U64 = (at > 0x40051000).to[U64]()

    two: Bool = tu > 0xC07547CA  # x < -0x1.ea8f94p+1
    zero: Bool = at >= 0x4120DDFC  # |x| >= 0x1.41bbf8p+3
    # |x| <= 0x1.7p-4
    when
        two =>
            # x < -0x1.ea8f94p+1: erfc(x) rounds to 2 (also -inf and negative NaNs)
            special: Bool = tu >= 0xFF800000
            when
                tu == 0xFF800000 => return 2.0
                special => return me + me
                else => return Me.sub(2.0, 0x1p-25)
        zero =>
            # |x| >= 0x1.41bbf8p+3 with x > 0: erfc(x) < 2^-150 rounds to 0 (also +inf and positive NaNs)
            special: Bool = at >= 0x7F800000
            when
                at == 0x7F800000 => return 0.0
                special => return me + me
                else => return Me.mul(0x1p-149, 0.25)
        at <= 0x3DB80000 =>
            # |x| <= 0x1.7p-4
            hard: Bool = tu == 0xB76C9F62  # x = -0x1.d93ec4p-17
            # |x| <= 0x1.c5bf88p-26: erfc(x) rounds to 1
            when
                hard => return Me.add(0x1.00010ap+0, 0x1p-25)
                at <= 0x32E2DFC4 =>
                    exact: Bool = at == 0
                    when
                        exact => return 1.0
                        sgn == 0 => return Me.add(1.0, -0x1p-26)
                        else => return Me.add(1.0, 0x1p-25)
                else =>
                    # around 0, erfc(x) behaves as 1 - (odd polynomial)
                    p3: B64 = x2 * 0x1.553af09b8008ep-8 + -0x1.b82c609607dcbp-6
                    p2: B64 = x2 * p3 + 0x1.ce2f218831d2fp-4
                    p1: B64 = x2 * p2 + -0x1.812746b03610bp-2
                    p0: B64 = x2 * p1 + 0x1.20dd750429b6dp+0
                    f0: B64 = me.to[B64]() * p0
                    return B64.sub(1.0, f0).to[Me]()
        else =>
            # -0x1.ea8f94p+1 <= x <= 0x1.41bbf8p+3 with |x| > 0x1.7p-4: erfc(|x|) = e^(-x^2) s(z)
            jt: B64 = x2 * 0x1.71547652b82fep+0 - 0x1.00004p+10
            jt_shifted: U64 = jt.bits() << 12
            j: S64 = jt_shifted.to_wrap[S64]() >> 48
            sign_field: U64 = (sgn << 11) | 0x3FF
            sce: S64 = (j >> 7) + sign_field.to_wrap[S64]()
            sc: B64 = B64.from_bits(sce.to_wrap[U64]() << 52)
            jf: B64 = j.to[B64]()
            d: B64 = x2 + jf * 0x1.62e42fefap-8 + jf * 0x1.cf79abd6f5dc8p-47
            d2: B64 = d * d
            j_low: S64 = j & 127
            ej: U64 = j_low.to_wrap[U64]().to[U64]()
            e0: B64 = B64.from_bits(CM_B32_ERFC_E.getitem(ej))
            f01: B64 = d * 0x1.5555555556a14p-3 + -0x1.ffffffffff333p-2
            f23: B64 = d * 0x1.1111074cc7b22p-7 + -0x1.55556666659b4p-5
            f: B64 = d + d2 * (f01 + d2 * f23)
            b: U64 = (row * 16).to[U64]()
            z: B64 = (axd - cm_b32_erfc_coef(base: b, k: 0)) / (axd + cm_b32_erfc_coef(base: b, k: 1))
            z2: B64 = z * z
            z4: B64 = z2 * z2
            z8: B64 = z4 * z4
            c0: B64 = cm_b32_erfc_coef(base: b, k: 3) + z * cm_b32_erfc_coef(base: b, k: 4)
            c2: B64 = cm_b32_erfc_coef(base: b, k: 5) + z * cm_b32_erfc_coef(base: b, k: 6)
            c4: B64 = cm_b32_erfc_coef(base: b, k: 7) + z * cm_b32_erfc_coef(base: b, k: 8)
            c6: B64 = cm_b32_erfc_coef(base: b, k: 9) + z * cm_b32_erfc_coef(base: b, k: 10)
            c8: B64 = cm_b32_erfc_coef(base: b, k: 11) + z * cm_b32_erfc_coef(base: b, k: 12)
            c10: B64 = cm_b32_erfc_coef(base: b, k: 13) + z * cm_b32_erfc_coef(base: b, k: 14)
            p0: B64 = c0 + z2 * c2
            p1: B64 = c4 + z2 * c6
            q0: B64 = c8 + z2 * c10
            q: B64 = q0 + z4 * cm_b32_erfc_coef(base: b, k: 15)
            s0: B64 = p0 + z4 * p1 + z8 * q
            s: B64 = cm_b32_erfc_coef(base: b, k: 2) + z * s0
            r: B64 = sc * (e0 - f * e0) * s
            off: B64 = when
                sgn == 1 => 2.0
                else => 0.0
            return (off + r).to[Me]()

### Coefficient `k` of the row starting at `base` in CM_B32_ERFC_CT.
### :param base: The index of the row's first coefficient.
### :param k: The coefficient's index within the row.
### :returns: The coefficient.
secret routine cm_b32_erfc_coef(base: U64, k: U64) -> B64
    return B64.from_bits(CM_B32_ERFC_CT.getitem(base + k))
