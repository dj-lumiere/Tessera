# Tessera stdlib: the correctly rounded complementary error function of B32
#
# Near zero erfc(x) = 1 - (odd polynomial). Elsewhere erfc(|x|) = e^(-x^2) s(z)
# with e^(-x^2) = 2^(j/128) 2^k e^(-d) from a table and a polynomial, and s a
# polynomial in the rational reduction z = (|x| - a) / (|x| + b), and for x < 0
# erfc(x) = 2 - erfc(-x). All in B64. Round to nearest only: -inf gives 2,
# +inf gives 0, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/erfc/erfcf.c via RazorForge's B32Erfc.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### 2^(j/128) for j in 0..127, as B64 bits.
preset CM_B32_ERFC_E: @Array[U64, 128] <- [0x3FF0000000000000, 0x3FF0163DA9FB3335,
    0x3FF02C9A3E778061, 0x3FF04315E86E7F85, 0x3FF059B0D3158574, 0x3FF0706B29DDF6DE,
