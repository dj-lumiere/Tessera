# Tessera stdlib: the correctly rounded arc cosine of B32
#
# pi/2 minus a fast odd polynomial in x covers |x| < 0x1.c2a1dcp-1 and settles
# most inputs. The rest go through an accurate path in B64: for |x| < 1/2
# pi/2 - x - x^3 p(x^2), above that sqrt(1 - |x|) times a polynomial in
# 1 - |x|, plus pi for negative x. Both polynomials are cm_b32_asin_poly12
# (Asin.te). Round to nearest only: |x| > 1 gives NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/acos/acosf.c via RazorForge's B32Acos.rf.
# Copyright (c) 2023 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### arccos(`me`), correctly rounded.
### :returns: The arc cosine of `me`, in radians.
routine B32.acos_unchecked() -> Me
    local xs: B64 = me.to[B64]()
    local t: U32 = me.bits()
    local ax: U32 = t << 1

    when
        ax >= 0x7F000000 =>
            # |x| >= 1 or NaN, which comes back quiet with its sign and payload
            one: Bool = t == 0x3F800000
            when
                one => return 0.0
                t == 0xBF800000 => return Me.add_unchecked(0x1.921fb6p+1, -0x1p-24)
                ax > 0xFF000000 => return me +! me
                else => return Me.from_bits(0xFFC00000)
        ax < 0x7EC2A1DC =>
            # |x| < 0x1.c2a1dcp-1
            # |x| < 2^-63
            if ax < 0x40000000
                return Me.add_unchecked(0x1.921fb6p+0, -0x1.777a5cp-25)
            z2: B64 = xs *! xs
            z4: B64 = z2 *! z2
            z8: B64 = z4 *! z4
            z16: B64 = z8 *! z8
            a01: B64 = z2 *! 0x1.5555c94838007p-3 +! 0x1.fffffffd9ccb8p-1
            a23: B64 = z2 *! 0x1.8566df703309ep-5 +! 0x1.32ded4b7c20fap-4
            a45: B64 = z2 *! 0x1.56fbb04998344p-1 +! -0x1.980c959bec9a3p-6
            a67: B64 = z2 *! 0x1.b06c3e9f311eap+4 +! -0x1.403d8e4c49f52p+2
            p0: B64 = z8 *! (z4 *! a67 +! a45) +! (z4 *! a23 +! a01)
            b01: B64 = z2 *! 0x1.200b8261cc61bp+8 +! -0x1.9ea97c4e2c21fp+6
            b23: B64 = z2 *! 0x1.a558a59cc19d3p+9 +! -0x1.2274c2799a5c7p+9
            b45: B64 = z2 *! 0x1.228744703f813p+9 +! -0x1.aca4b6a529ffp+9
            b67: B64 = z2 *! 0x1.5c2018c0c0105p+5 +! -0x1.d7dbb0b322228p+7
            p1: B64 = z8 *! (z4 *! b67 +! b45) +! (z4 *! b23 +! b01)
            rf: B64 = xs *! (z16 *! p1 +! p0)
            ub: Me = B64.sub_unchecked(0x1.921fb54574191p+0, rf).to[Me]()
            lb: Me = B64.sub_unchecked(0x1.921fb543118ap+0, rf).to[Me]()
            if ub == lb
                return ub
        else => pass

    # The fast path can't decide the rounding, or |x| >= 0x1.c2a1dcp-1.
    # |x| < 1/2
    if ax < 0x7E000000
        # pi/2 - x - x^3 p(x^2)
        when
            t == 0x328885A3 => return Me.add_unchecked(0x1.921fb6p+0, 0x1p-25)
            t == 0x39826222 => return Me.add_unchecked(0x1.920f6ap+0, 0x1p-25)
            else => pass
        x2: B64 = xs *! xs
        r: B64 = B64.sub_unchecked(0x1.921fb54442d18p+0, xs) -! xs *! x2 *! cm_b32_asin_poly12(z: x2, base: 0)
        return r.to[Me]()
    # o + sign(x) sqrt(z) q(z) with z = 1 - |x|, o = pi for negative x and 0 otherwise
    z: B64 = B64.sub_unchecked(1.0, xs.abs())
    s: B64 = z.sqrt_unchecked().copysign(xs)
    negative: Bool = t >> 31 == 1
    o: B64 = when
        negative => 0x1.921fb54442d18p+1
        else => 0.0
    r: B64 = s *! cm_b32_asin_poly12(z, base: 12) +! o
    return r.to[Me]()
