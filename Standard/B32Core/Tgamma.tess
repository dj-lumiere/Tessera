// Tessera stdlib: the correctly rounded gamma function of B32
//
// Near zero gamma(x) = 1/x - euler_gamma + O(x). Positive integers give (x-1)!
// exactly. Otherwise gamma on [2.375, 3.375) (x reduced to x - 23/8 = i + d)
// from a degree-15 polynomial in d, shifted to x by the product of the
// i factors between them, all in B64. Hard-to-round inputs come from a table.
// Round to nearest only: overflow gives +inf, +-0 gives +-inf, the negative
// integers and -inf give NaN, and NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/tgamma/tgammaf.c via RazorForge's B32Tgamma.rf.
// Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// Inputs whose gamma is hard to round, as B32 bits.
preset CM_B32_TGAMMA_EXC_X: @Array[U32, 10] <- [0x27DE86A9, 0x27E05475, 0xB63BEFB3, 0x3C7BB570,
    0x41E886D1, 0xC067D177, 0xBD99DA31, 0xBF54C45A, 0x41EE77FE, 0x3F843A64]

/// The correctly rounded results for those inputs, as f + df (B32 bits).
preset CM_B32_TGAMMA_EXC_F: @Array[U32, 10] <- [0x57134133, 0x57121211, 0xC8AE5B72, 0x42810EC8,
    0x709989B5, 0x3E7B4286, 0xC15F7F33, 0xC0D35A76, 0x7269B18E, 0x3F7B631C]
/// The low-order corrections `df` for the inputs in {CM_B32_TGAMMA_EXC_X}, as B32 bits: `f + df` is the correctly rounded result.
preset CM_B32_TGAMMA_EXC_DF: @Array[U32, 10] <- [0x4A800000, 0x4A800000, 0x3C000000, 0x36000000,
    0x64000000, 0x31800000, 0xB4800000, 0x34000000, 0x99800000, 0x32800000]

/// Γ(`me`), correctly rounded: ±inf at ±0, NaN at the negative integers and -inf.
/// :returns: Γ(`me`).
routine B32.gamma(me: Me) -> Me
    local tu: U32 = me.bits()
    local ax: U32 = tu << 1
    local t0: @B64 <- .hollow()
    local x0: @B64 <- .hollow()
    local z: B64 = me.to[B64]()
    local fx: Me = me.floor()

    special: Bool = ax >= 0xFF000000
    tiny: Bool = ax < 0x6D000000
    // |x| < 0x1p-18
    over: Bool = me >= 35.04010009765625
    integer: Bool = fx == me
    when
        special => jump special()
        tiny => jump tiny()
        over => return Me.mul(1.7014118346046923e38, 1.7014118346046923e38)
        integer => jump integer()
        me < -42.0 => jump under()
        else => jump main()

    // NaN or +-inf
    block special()
        infinite: Bool = ax == 0xFF000000
        when
            infinite and tu >> 31 == 1 => return Me.from_bits(0xFFC00000)
            infinite => return me
            else => return me + me

    // |x| < 0x1p-18: gamma(x) = 1/x - euler_gamma + O(x)
    block tiny()
        c: B64 = B64.sub(0.9890559953279725, z * 0.9074790760808863)
        d: B64 = c * z - 0.5772156649015329
        f: B64 = B64.div(1.0, z) + d
        r: Me = f.to[Me]()
        biased_bits: U64 = f.bits() +% 2
        if biased_bits & 0xFFFFFFF < 4
            return cm_b32_tgamma_exception(xb: tu, fallback: r)
        else
            return r

    // an integer: a pole (NaN) for the negative ones, (k-1)! for the positive ones
    block integer()
        zero: Bool = me == 0.0
        when
            zero => return Me.div(1.0, me)
            me < 0.0 => return Me.from_bits(0xFFC00000)
            else => pass
        1.0.poke_into(t0)
        1.0.poke_into(x0)
        jump factorial(fx.to[S64](), 1)

    block factorial(k: S64, i: S64)
        if not (i < k)
            return t0.peek().to[Me]()
        next_x0: B64 = x0.peek() + 1.0
        next_t0: B64 = t0.peek() * x0.peek()
        next_t0.poke_into(t0)
        next_x0.poke_into(x0)
        jump factorial(k, i + 1)

    // x < -42, not an integer: |gamma(x)| < 2^-151 rounds to a signed zero
    block under()
        whole: S64 = fx.to[S64]()
        if whole & 1 == 0
            return Me.mul(5.877471754111438e-39, 5.877471754111438e-39)
        else
            return Me.mul(5.877471754111438e-39, -5.877471754111438e-39)

    // gamma(23/8 + i + d) from a polynomial in d, shifted by the i factors between
    block main()
        m: B64 = z - 2.875
        i: B64 = m.round_ties_even()
        step: B64 = B64.copysign(1.0, i)
        d: B64 = m - i
        d2: B64 = d * d
        d4: B64 = d2 * d2
        d8: B64 = d4 * d4
        a0: B64 = d * 1.5591939012079508 + 1.7877108988969403
        a2: B64 = d * 0.47065801829337245 + 1.0510493266811867
        a4: B64 = d * 0.058831548411746724 + 0.18881863831977497
        a6: B64 = d * 0.004228758148929772 + 0.017825943652294146
        a8: B64 = d * 0.00019456568933897892 + 0.001097917853717287
        a10: B64 = d * 4.914144140610218e-06 + 5.197131759674315e-05
        a12: B64 = d * -1.4461519623063317e-07 + 2.437173471710669e-06
        a14: B64 = d * -4.919948895618967e-08 + 1.8260131876052383e-07
        b0: B64 = a0 + d2 * a2
        b4: B64 = a4 + d2 * a6
        b8: B64 = a8 + d2 * a10
        b12: B64 = a12 + d2 * a14
        lo: B64 = b0 + d4 * b4
        hi: B64 = b8 + d4 * b12
        f: B64 = lo + d8 * hi
        jm: S64 = i.abs().to[S64]()
        if jm == 0
            jump narrow(f, i, 1.0)
        else
            jump shift(f, i, step, jm)

    // the first factor: x - 1/2 - step/2
    block shift(f: B64, i: B64, step: B64, jm: S64)
        z1: B64 = z - (step * 0.5 + 0.5)
        jump product(z1, z1, jm - 1, f, i, step)

    block product(zj: B64, w: B64, j: S64, f: B64, i: B64, step: B64)
        if j == 0
            jump narrow(f, i, w)
        else
            jump product(zj - step, w * (zj - step), j - 1, f, i, step)

    // for x below the polynomial's interval the product divides
    block narrow(f: B64, i: B64, w: B64)
        below: Bool = i <= -0.5
        wv: B64 = when
            below => B64.div(1.0, w)
            else => w
        g: B64 = f * wv
        r: Me = g.to[Me]()
        biased_bits: U64 = g.bits() +% 2
        if biased_bits & 0xFFFFFFF < 8
            return cm_b32_tgamma_exception(xb: tu, fallback: r)
        else
            return r

/// The tabulated correctly rounded gamma for a hard-to-round input with B32 bits xb, or fallback.
/// :param xb: The B32 bits of the input.
/// :param fallback: The result for an input that is not in the table.
/// :returns: The tabulated value for a listed `xb`, else `fallback`.
private routine cm_b32_tgamma_exception(xb: U32, fallback: B32) -> B32
    each k in 0 til 10
        if CM_B32_TGAMMA_EXC_X.getitem(k) == xb
            f: B32 = B32.from_bits(CM_B32_TGAMMA_EXC_F.getitem(k))
            df: B32 = B32.from_bits(CM_B32_TGAMMA_EXC_DF.getitem(k))
            return f + df
        else
            continue
    then
        return fallback
