// Tessera stdlib: the correctly rounded hyperbolic sine of B32
//
// Near zero a polynomial in x. Elsewhere 32 x / ln(2) = k + h, and
// sinh x = 2^(k/32) 2^(h/32) / 2 - 2^(-k/32) 2^(-h/32) / 2 with the powers of
// two from a table and 2^(+-h/32) from a polynomial, all in B64. A second,
// longer polynomial settles the cases the first can't round.
// Round to nearest only: overflow gives a signed infinity, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/sinh/sinhf.c via RazorForge's B32Sinh.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// 2^(i/32) / 2 for i in 0..31, as B64 bits. Shared with cosh.
preset CM_B32_SINH_TB: @Array[U64, 32] <- { 0x3FE0000000000000, 0x3FE059B0D3158574,
    0x3FE0B5586CF9890F, 0x3FE11301D0125B51, 0x3FE172B83C7D517B, 0x3FE1D4873168B9AA,
    0x3FE2387A6E756238, 0x3FE29E9DF51FDEE1, 0x3FE306FE0A31B715, 0x3FE371A7373AA9CB,
    0x3FE3DEA64C123422, 0x3FE44E086061892D, 0x3FE4BFDAD5362A27, 0x3FE5342B569D4F82,
    0x3FE5AB07DD485429, 0x3FE6247EB03A5585, 0x3FE6A09E667F3BCD, 0x3FE71F75E8EC5F74,
    0x3FE7A11473EB0187, 0x3FE82589994CCE13, 0x3FE8ACE5422AA0DB, 0x3FE93737B0CDC5E5,
    0x3FE9C49182A3F090, 0x3FEA5503B23E255D, 0x3FEAE89F995AD3AD, 0x3FEB7F76F2FB5E47,
    0x3FEC199BDD85529C, 0x3FECB720DCEF9069, 0x3FED5818DCFBA487, 0x3FEDFC97337B9B5F,
    0x3FEEA4AFA2A490DA, 0x3FEF50765B6E4540 }

/// sinh `me`, correctly rounded.
/// :returns: The hyperbolic sine of `me`.
routine B32.sinh(me: Me) -> Me
    local ux : U32 = me.bits().shl(1)

    block entry()
        large : Bool = ux.gt(0x8565A9F8)
        small : Bool = ux.lt(0x7C000000)
        when
            large => large()
            small => small()
            else  => return(cm_b32_sinh_main(me.to[B64]()))

    // |x| > 0x1.65a9f8p+6: NaN, infinities, or overflow
    block large()
        nan      : Bool = ux.gt(0xFF000000)
        infinite : Bool = ux.eq(0xFF000000)
        when
            nan      => return(me.add(me))
            infinite => return(me)
            else     => return(Me.INFINITY.copysign(me))

    // |x| < 0.125
    block small()
        tiny  : Bool = ux.lt(0x66000000)
        hard  : Bool = ux.eq(0x74250BFE)
        cubic : Bool = ux.lt(0x74250BFE)  // |x| < 0x1.250bfep-11
        when
            tiny  => return(me.mul_add(me.abs(), me))
            hard  => hard()
            cubic => cubic()
            else  => series()

    block cubic()
        cube_term : Me = me.mul(0x1.555556p-3).mul(me.mul(me))
        return(cube_term.add(me))

    // |x| = 0x1.250bfep-11, which the cubic rounds the wrong way
    block hard()
        sgn : Me = Me.copysign(1.0, me)
        r   : Me = sgn.mul(0x1.250bfep-11).add(sgn.mul(0x1p-36))
        return(r)

    block series()
        z  : B64 = me.to[B64]()
        z2 : B64 = z.mul(z)
        z4 : B64 = z2.mul(z2)
        p0 : B64 = z2.mul(0x1.11111111146e1p-7).add(0x1.5555555555555p-3)
        p1 : B64 = z2.mul(0x1.71f92198aa6e9p-19).add(0x1.a01a00930dda6p-13)
        p  : B64 = z4.mul(p1).add(p0)
        z3 : B64 = z2.mul(z)
        r  : B64 = z3.mul(p).add(z)
        return(r.to[Me]())

/// 2^(k/32) / 2 for k = ia, or k = -ia when minus, where ia is an integer held in a B64.
/// :param ia: The integer k, held in a B64.
/// :param minus: Whether to negate k.
/// :returns: 2^(k/32) / 2.
routine cm_b32_sinh_scale(ia: B64, minus: Bool) -> B64
    block entry()
        ia_shifted : B64 = ia.add(0x1.8p+52)
        j          : S64 = ia_shifted.bits().to_wrap[S64]()
        jp         : S64 = minus
            ? j.neg_wrap()
            : j
        index          : U64 = jp.bitand(31).to_wrap[U64]()
        scale_exponent : U64 = jp.shr(5).to_wrap[U64]()
        shift          : U64 = scale_exponent.shl(52)
        return(B64.from_bits(CM_B32_SINH_TB.getitem(index.to[USize]()).add_wrap(shift)))

/// The main path of sinh, for 0.125 <= |x| without overflow: e^x / 2 - e^-x / 2 from a 2^(k/32) table.
/// :param z: The argument as B64.
/// :returns: sinh(`z`), rounded to B32.
private routine cm_b32_sinh_main(z: B64) -> B32
    local a  : B64 = z.mul(0x1.71547652b82fep+5)  // 32 x / ln(2)
    local ia : B64 = a.round_ties_even()
    local h  : B64 = a.sub(ia)
    local h2 : B64 = h.mul(h)
    local sp : B64 = cm_b32_sinh_scale(ia, false)
    local sm : B64 = cm_b32_sinh_scale(ia, true)

    block entry()
        tev  : B64  = h2.mul(0x1.ebfd1b232f475p-13).add(1.0)
        tod  : B64  = h2.mul(0x1.c6b19384ecd93p-20).add(0x1.62e42fef4c4e7p-6)
        rp   : B64  = sp.mul(h.mul(tod).add(tev))
        rm   : B64  = sm.mul(tev.sub(h.mul(tod)))
        r    : B64  = rp.sub(rm)
        ub   : B32  = r.to[B32]()
        lb   : B32  = r.sub(r.mul(0x1.4e406496685f4p-33)).to[B32]()
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(ub)
            : slow()

    // too close to a rounding boundary: redo it with a split 32 / ln(2) and a longer polynomial
    block slow()
        h_hi     : B64 = z.mul(0x1.7154765p+5).sub(ia)
        h_split  : B64 = h_hi.add(z.mul(0x1.5c17f0bbbe88p-26))
        h2_split : B64 = h_split.mul(h_split)
        te4      : B64 = h2_split.mul(0x1.430976b8ce6efp-43).add(0x1.3b2ab6fb92e5ep-27)
        te02     : B64 = h2_split.mul(0x1.ebfbdff82c58fp-13).add(1.0)
        tev      : B64 = te02.add(h2_split.mul(h2_split).mul(te4))
        to2      : B64 = h2_split.mul(0x1.5d886e6d54203p-35).add(0x1.c6b08d702e0edp-20)
        tod      : B64 = h2_split.mul(to2).add(0x1.62e42fefa39efp-6)
        rp       : B64 = sp.mul(h_split.mul(tod).add(tev))
        rm       : B64 = sm.mul(tev.sub(h_split.mul(tod)))
        r        : B64 = rp.sub(rm)
        return(r.to[B32]())
