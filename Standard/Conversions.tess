// Tessera stdlib: generic IR operation member methods
//
// Only truly type-agnostic casts live here. Integer comparisons/arithmetic
// and float comparisons/arithmetic are type-specific and live on their
// respective types.

module Standard::Core

// -- casts ---------------------------------------------------------------------

/// Reinterprets the bits of `self` as a `U` of the same size, such as an F64 as a U64. No conversion of the value takes place.
/// :typeparam U: The type to reinterpret the bits as.
/// :returns: The same bits viewed as the target type.
routine T.bitcast<U>(self: T) -> U
require T: typename, U: typename
    block entry():
        r : U = bitcast<Self, U>(self)
        return(r)
