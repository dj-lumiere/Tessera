// Tessera stdlib: generic IR operation member methods
//
// Only truly type-agnostic casts live here. Integer comparisons/arithmetic
// and float comparisons/arithmetic are type-specific and live on their
// respective types.

module Standard::Core

// -- casts ---------------------------------------------------------------------

/// Reinterprets the bits of `self` as a `TTo` of the same size, such as an F64 as a U64. No conversion of the value takes place.
/// :typeparam TTo: The type to reinterpret the bits as.
/// :returns: The same bits viewed as the target type.
routine TFrom.bitcast<TTo>(self: TFrom) -> TTo
require TFrom: typename, TTo: typename
    block entry()
        r : TTo = bitcast<Self, TTo>(self)
        return(r)
