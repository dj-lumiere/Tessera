# Tessera stdlib: the correctly rounded cos(pi x) of B64
#
# cos(pi x) = sin(pi (|x| + 1/2)): with 2048 |x| + 1024 = iq + z 2^-64 for an integer iq, sin(pi iq/2048) and
# cos(pi iq/2048) come from tables (TrigPi.te), the residual from short polynomials, and an error bound says
# whether the sum rounds safely. When it can't, the accurate phase sin_pi shares redoes it, and eight inputs too
# close to a rounding boundary even for that are listed. Small |x| has its own polynomial and accurate phase.
# Integers give +-1, half-integers +0. Round to nearest only.
#
# Ported from CORE-MATH, src/binary64/cospi/cospi.c via RazorForge's B64Cospi.rf.
# Copyright (c) 2023-2026 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/B64

### The angle index (mod 2048) of each input whose accurate phase is still too close to a rounding boundary.
secret preset CM_B64_COS_PI_DB_IQ: &Array[U64, 8] <- [903, 1029, 1078, 1217, 1025, 1026, 1033, 1235]

### For each entry of CM_B64_COS_PI_DB_IQ: the reduced argument, the correctly rounded result and a tiny correction
### that fixes the rounding direction, as B64 bits.
secret preset CM_B64_COS_PI_DB: &Array[U64, 24] <- [0xBFDBDD02D1AD6000, 0x3FEF72C906962631,
    0x3C80000000000000, 0xBFCA4AD070549D00, 0x3FEFFFC4D2C6CA51, 0x3C80000000000000,
    0x3FCFBDB79CA3DA00, 0x3FEFE3C8219054C3, 0x3C80000000000000, 0x3FEC0CCEE4ADA200,
    0x3FEE99FD53791BCF, 0xBC80000000000000, 0x3FDB536647B1FE98, 0x3FEFFFFC5DDD0738,
    0x3C80000000000000, 0xBFDDC93EAAD12A18, 0x3FEFFFF84B21C731, 0x3C80000000000000,
    0x3FEE78F0E592B360, 0x3FEFFF2270422604, 0xBC80000000000000, 0x3FDF13412A48D800,
    0x3FEE55A7FA9A24C4, 0xBC80000000000000]

### cos(pi me), correctly rounded (to nearest, ties to even). An integer gives +-1, a half-integer +0, +-inf
### gives NaN, and NaN comes back quiet.
### :returns: cos(pi `me`).
routine B64.cos_pi() -> Me
    ixu: U64 = me.bits()
    ax: U64 = ixu & 0x7FFFFFFFFFFFFFFF
    e: S64 = (ax >> 52).to_wrap[S64]()
    # 2^(e - 1023) <= |x| < 2^(e - 1022)
    m: U64 = (ixu & 0x000FFFFFFFFFFFFF) | 0x0010000000000000

    if ax == 0
        return 1.0
    s: S64 = S64.sub(1063, e)  # 2^(40 - s) <= |x| < 2^(41 - s)
    large: Bool = s < 0  # |x| >= 2^41
    # |x| <= 2^-12
    when
        large =>
            if e == 0x7FF
                # 2^(41 + shift) <= |x| < 2^(42 + shift)
                # |x| >= 2^53: an even integer
                # 2048 |x| + 1024 mod 2^64
                # infinities give NaN, NaN comes back quiet with its sign and payload
                if ixu << 12 == 0
                    return Me.from_bits(0x7FF8000000000000)
                return me +! me
            shift: S64 = -s - 1
            if shift > 11
                return 1.0
            iq: U64 = (m << shift.to_wrap[U64]()) +% 1024
            if iq & 2047 == 0
                return 0.0
            b: CmF64TrigPiSinCos = cm_b64_trig_pi_sincos(iq)
            return b.sh +! b.sl
        ax <= 0x3F30000000000000 =>
            # |x| <= 0x1.ccf6429be6621p-29: rounds below 1
            if ax <= 0x3E2CCF6429BE6621
                return Me.sub_unchecked(1.0, 0x1p-55)
            x2: Me = me *! me
            x4: Me = x2 *! x2
            eps: Me = x2 *! 0x1.ap-48
            c01: Me = Me.add_unchecked(-0x1.3bd3cc9be45dcp+2, x2 *! 0x1.03c1f081b0833p+2)
            c23: Me = Me.add_unchecked(-0x1.55d3c6fc9af15p+0, x2 *! 0x1.e1d3ff2ae3f9ap-3)
            p: Me = x2 *! (c01 +! x4 *! c23)
            lb: Me = p -! eps +! 1.0
            ub: Me = p +! eps +! 1.0
            if lb == ub
                return lb
            return cm_b64_cos_pi_zero(me)
        else =>
            # x is an integer or a half-integer when its bits below 1/2 are all 0
            si: S64 = e - 1011
            if si >= 0
                shift: U64 = si.to_wrap[U64]()
                if m << shift + 1 == 0
                    if not (m << shift == 0)
                        return 0.0
                    if (m << shift - 1) >> 63 == 1
                        return -1.0
                    return 1.0
            shifted: U64 = (m >> s.to_wrap[U64]()) +% 2048 & 8191
            iq: U64 = shifted + 1 >> 1  # round(2048 |x| + 1024) mod 4096
            # 2048 |x| + 1024 - iq, scaled by 2^64
            up: U64 = (e - 1000).to_wrap[U64]()
            k: S64 = (m << up).to_wrap[S64]()
            z: Me = k.to[Me]()
            z2: Me = z *! z
            fs2: Me = Me.add_unchecked(-0x1.4abbce625be51p-223, z2 *! 0x1.466bc6044ba16p-374)
            fs: Me = Me.add_unchecked(0x1.921fb54442d18p-74, z2 *! fs2)
            fc: Me = Me.add_unchecked(-0x1.3bd3cc9be45dbp-148, z2 *! 0x1.03c1f00186416p-298)

            b: CmF64TrigPiSinCos = cm_b64_trig_pi_sincos(iq)
            er: Me = z.abs() *! 0x1p-123 +! 0x1p-78
            r0: Me = b.sl +! b.sh *! (z2 *! fc)
            r: Me = r0 +! b.ch *! (z *! fs)
            lb: Me = r -! er +! b.sh
            ub: Me = r +! er +! b.sh
            if lb == ub
                return lb
            return cm_b64_cos_pi_refine(iq, z)

### cos(pi x) for 0x1.ccf6429be6621p-29 < |x| <= 2^-12 in double-double arithmetic: the accurate phase of the
### small-argument path.
### :param x: The argument.
### :returns: cos(pi `x`), correctly rounded.
secret routine cm_b64_cos_pi_zero(x: B64) -> B64
    x2: B64 = x *! x
    dx2: B64 = b64_mul_error(x, y: x, p: x2)
    x2dd: CmF64TrigDD = (hi: x2, lo: dx2)
    fl1: B64 = B64.add_unchecked(-0x1.55d3c7e3cbff9p+0, x2 *! 0x1.e1f50604fa0ffp-3)
    fl: B64 = x2 *! fl1
    f0: CmF64TrigDD = cm_b64_trig_pi_poly_start(c0: 0x1.03c1f081b5ac4p+2,
        c1: -0x1.32b33fda9113cp-52, l: fl)
    f1: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: x2dd, p: f0,
        c: CmF64TrigDD(hi: -0x1.3bd3cc9be45dep+2, lo: -0x1.692b71366cc04p-52))
    f: CmF64TrigDD = cm_b64_trig_pi_muldd(xh: x2, xl: dx2, ch: f1.hi, cl: f1.lo)
    s0: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: 1.0, b: f.hi)
    s1: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: s0.lo, b: f.lo)
    tu: U64 = s1.hi.bits()
    if tu & 0x000FFFFFFFFFFFFF == 0
        # the low part is a power of two: nudge it one ulp toward the tail so that the sum rounds correctly
        signs: U64 = s1.lo.bits() ^ tu
        away: Bool = signs >> 63 == 1
        u: U64 = when
            away => tu -% 1
            else => tu +% 1
        return s0.hi +! B64.from_bits(u)
    return s0.hi +! s1.hi

### The accurate phase of cos_pi's main path, with the list of exceptions.
### :param iq: The angle index, round(2048 |x| + 1024) mod 4096, in 2048ths of a half turn.
### :param z: The residual 2048 |x| + 1024 - `iq`, scaled by 2^64.
### :returns: cos(pi x), correctly rounded.
secret routine cm_b64_cos_pi_refine(iq: U64, z: B64) -> B64
    t: CmF64TrigDD = cm_b64_trig_pi_refine(iq, z)

    if cm_b64_trig_pi_is_refine_suspect(t.lo)
        each i: U64 in 0 til 8
            x: B64 = z *! 0x1p-63
            iqm: U64 = iq & 0x7FF
            dq: U64 = CM_B64_COS_PI_DB_IQ.getitem(i)
            dx: B64 = B64.from_bits(CM_B64_COS_PI_DB.getitem(i * 3))
            plus: Bool = x == dx and iqm == dq
            minus: Bool = x == -dx and iqm == U64.sub(2048, dq)
            if plus or minus
                upper: Bool = iq > 2048
                sgn: B64 = when
                    upper => -1.0
                    else => 1.0
                r: B64 = B64.from_bits(CM_B64_COS_PI_DB.getitem(i * 3 + 1))
                dr: B64 = B64.from_bits(CM_B64_COS_PI_DB.getitem(i * 3 + 2))
                return sgn *! r +! sgn *! dr
            continue
        then
            return t.hi +! t.lo
    else
        return t.hi +! t.lo
