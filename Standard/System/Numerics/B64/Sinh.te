    0x3990000000000000, 0xB99BE00000000000, 0x39B6100000000000, 0x3A04800000000000,
    0x3A50000000000000, 0xBA50000000000000, 0xBAE9000000000000, 0x3B09B00000000000,
    0x3BC0000000000000, 0xBB9BC00000000000, 0x3BA4000000000000, 0x3C16D00000000000,
    0x3C60E80000000000, 0x3CB0880000000000, 0x3CD6E00000000000, 0xBCE2800000000000,
    0x3E70000000000000, 0xBF00000000000000, 0xC130800000000000, 0x41CB000000000000,
    0x4655900000000000, 0x4862000000000000, 0x48C0200000000000, 0xCA5FA00000000000,
    0x5480A00000000000, 0xD812200000000000, 0x5EC0000000000000, 0xE237800000000000,
