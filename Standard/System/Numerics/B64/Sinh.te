### sinh me, correctly rounded (to nearest, ties to even). ±0 stays itself, ±inf stays itself, overflow gives ±inf,
### and NaN comes back quiet.
### :returns: The hyperbolic sine of `me`.
routine B64.sinh_unchecked() -> Me
    aix: U64 = me.abs().bits()

    small: Bool = aix < 0x3FD0000000000000  # |x| < 1/4
    # |x| > 0x1.633ce8fb9f87dp+9 ~ 710.47586
    when
        small =>
            # |x| < 0x1.7137449123ef7p-26
            if aix < 0x3E57137449123EF7
                return me.mul_add_unchecked(a: 0x1p-55, b: me)
            # x + p is a minimax approximation of sinh x on [0x1.7137449123ef7p-26, 1/4] with
            # |x + p - sinh x| / x^3 < 2^-56.584
            x2: Me = me *! me
            x3: Me = x2 *! me
            x4: Me = x2 *! x2
            c0: Me = x2 *! 0x1.111111111151ep-7 +! 0x1.5555555555555p-3
            c4: Me = x2 *! 0x1.71de444a96e11p-19 +! 0x1.a01a019d0c767p-13
            c48: Me = x4 *! 0x1.ae8465375242p-26 +! c4
            p: Me = x3 *! (x4 *! c48 +! c0)
            e: Me = x3 *! 0x1.cp-53
            lb: Me = me +! (p -! e)
            ub: Me = me +! (p +! e)
            if lb == ub
                return lb
            return cm_b64_sinh_zero(me)
        aix > 0x408633CE8FB9F87D =>
            # NaN, infinities, or overflow
            if aix >= 0x7FF0000000000000
                return me +! me
            return Me.copysign(0x1p+1023, me) *! 2.0
        else => return cm_b64_sinh_main(me)

### sinh x for 1/4 <= |x| <= 0x1.633ce8fb9f87dp+9.
### :param x: The argument.
### :returns: sinh(`x`), correctly rounded.
secret routine cm_b64_sinh_main(x: B64) -> B64
    ax: B64 = x.abs()
    aix: U64 = ax.bits()
    sgn: B64 = B64.copysign(1.0, x)
    # t = round(|x| 2^12 / log 2), and its bits il = 2^12 ie + 2^6 i0 + i1
    v0: B64 = ax.mul_add_unchecked(a: 0x1.71547652b82fep+12, b: 0x1.8000002p+26)
    jt: U64 = v0.bits()
    t: B64 = B64.from_bits(jt & 0xFFFFFFFFFC000000) -! 0x1.8p+26
    index_bits: U64 = (jt << 14) >> 40
    il: S64 = index_bits.to[S64]()
    ie: S64 = il >> 12
    i1: U64 = (il & 0x3F).to[U64]()
    slot0: S64 = (il >> 6) & 0x3F
    i0: U64 = slot0.to[U64]()
    sp: B64 = cm_b64_hyp_scale(ie + 1022)
    tt: CmF64HypDd = cm_b64_hyp_table(i0, i1)
    # |x| = t log(2) / 2^12 + dx, with log(2) / 2^12 as l2h + l2l and l2h t exact
    dx: B64 = ax -! t *! 0x1.62e42ffp-13 +! t *! 0x1.718432a1b0e26p-47
    dx2: B64 = dx *! dx
    pp: B64 = cm_b64_hyp_poly(d: dx, d2: dx2)
    jl: S64 = -il
    th: B64 = tt.hi
    tl: B64 = tt.lo

    # |x| > ~36.736801: e^-|x| is negligible
    when
        aix > 0x40425E4F7B2737FA =>
            # sinh x ~ sgn e^|x| / 2
            sp_huge: B64 = cm_b64_hyp_scale(ie + 1021)
            rh: B64 = th *! sgn
            rl: B64 = (tl +! th *! pp) *! sgn
            e: B64 = th *! 0x1.1b6p-63
            lb: B64 = rh +! (rl -! e)
            ub: B64 = rh +! (rl +! e)
            if lb == ub
                return lb *! sp_huge *! 2.0
            a0: CmF64HypDd = cm_b64_hyp_exp_accurate(x: ax, t, th, tl)
            a: CmF64HypDd = cm_b64_hyp_fasttwosum(x: a0.hi, y: a0.lo)
            bh: B64 = a.hi *! sgn
            bl: B64 = a.lo *! sgn
            hard: Bool = cm_b64_hyp_is_hard(h: bh, l: bl)
            doubled: B64 = (bh +! bl) *! 2.0
            r: B64 = doubled *! sp_huge
            if hard
                return cm_b64_sinh_database(x, f: r)
            return r
        aix > 0x4014000000000000 =>
            # 5 < |x| <= ~36.736801: e^-|x| matters only to the low part
            j1: U64 = (jl & 0x3F).to[U64]()
            slot_j: S64 = (jl >> 6) & 0x3F
            j0: U64 = slot_j.to[U64]()
            sm: B64 = cm_b64_hyp_scale((jl >> 12) + 1022)
            q: CmF64HypDd = cm_b64_hyp_table(i0: j0, i1: j1)
            th_scaled: B64 = th *! sp
            tl_scaled: B64 = tl *! sp
            qh: B64 = q.hi *! sm
            pm: B64 = cm_b64_hyp_poly(d: -dx, d2: dx2)
            em: B64 = qh *! pm +! qh
            rh: B64 = th_scaled *! sgn
            rl0: B64 = tl_scaled -! em +! th_scaled *! pp
            rl: B64 = rl0 *! sgn
            e: B64 = B64.mul_unchecked(0x1.202p-63, rh)
            lb: B64 = rh +! (rl -! e)
            ub: B64 = rh +! (rl +! e)
            if lb == ub
                return lb
            a: CmF64HypDd = cm_b64_hyp_exp_accurate(x: ax, t, th: th_scaled, tl: tl_scaled)
            # |x| > 31.4
            if aix > 0x403F666666666666
                # e^-|x| as the one B64 qh
                rh2: B64 = a.hi -! qh
                rh_err: B64 = a.hi -! rh2 -! qh
                # e^-|x| in double-double
                # 1/4 <= |x| <= 5
                s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: rh2, y: rh_err +! a.lo)
                hard: Bool = cm_b64_hyp_is_hard(h: s.hi, l: s.lo)
                r: B64 = s.hi *! sgn +! s.lo *! sgn
                if hard
                    return cm_b64_sinh_database(x, f: r)
                return r
            m: CmF64HypDd = cm_b64_hyp_exp_accurate(x: -ax, t: -t, th: q.hi *! sm, tl: q.lo *! sm)
            rh2: B64 = a.hi -! m.hi
            rh_err: B64 = a.hi -! rh2 -! m.hi
            s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: rh2, y: rh_err -! m.lo +! a.lo)
            hard: Bool = cm_b64_hyp_is_hard(h: s.hi, l: s.lo)
            r: B64 = s.hi *! sgn +! s.lo *! sgn
            if hard
                return cm_b64_sinh_database(x, f: r)
            return r
        else =>
            j1: U64 = (jl & 0x3F).to[U64]()
            slot_j: S64 = (jl >> 6) & 0x3F
            j0: U64 = slot_j.to[U64]()
            sm: B64 = cm_b64_hyp_scale((jl >> 12) + 1022)
            q: CmF64HypDd = cm_b64_hyp_table(i0: j0, i1: j1)
            th_scaled: B64 = th *! sp
            tl_scaled: B64 = tl *! sp
            qh: B64 = q.hi *! sm
            ql: B64 = q.lo *! sm
            pm: B64 = cm_b64_hyp_poly(d: -dx, d2: dx2)
            fpl: B64 = tl_scaled +! th_scaled *! pp
            fml: B64 = ql +! qh *! pm
            rh0: B64 = th_scaled -! qh
            rh0_err: B64 = th_scaled -! rh0 -! qh
            rl0: B64 = rh0_err -! fml +! fpl
            rh: B64 = rh0 *! sgn
            rl: B64 = rl0 *! sgn
            e: B64 = B64.mul_unchecked(0x1.c0ap-62, rh)
            lb: B64 = rh +! (rl -! e)
            ub: B64 = rh +! (rl +! e)
            if lb == ub
                return lb
            a: CmF64HypDd = cm_b64_hyp_exp_accurate(x: ax, t, th: th_scaled, tl: tl_scaled)
            m: CmF64HypDd = cm_b64_hyp_exp_accurate(x: -ax, t: -t, th: qh, tl: ql)
            rh2: B64 = a.hi -! m.hi
            rh_err: B64 = a.hi -! rh2 -! m.hi
            s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: rh2, y: rh_err -! m.lo +! a.lo)
            hard: Bool = cm_b64_hyp_is_hard(h: s.hi, l: s.lo)
            r: B64 = s.hi *! sgn +! s.lo *! sgn
            if hard
                return cm_b64_sinh_database(x, f: r)
            return r

### The accurate path of sinh for 0x1.7137449123ef7p-26 <= |x| < 1/4: a double-double odd polynomial.
### :param x: The argument.
### :returns: sinh(`x`), correctly rounded.
secret routine cm_b64_sinh_zero(x: B64) -> B64
    x2: B64 = x *! x
    x2l: B64 = b64_mul_error(x, y: x, p: x2)
    x2dd: CmF64HypDd = (hi: x2, lo: x2l)
    c: B64 = x2 *! 0x1.95785063cd974p-49 +! 0x1.ae7f36beea815p-41
    y2: B64 = x2 *! (x2 *! c +! 0x1.6124613aef206p-33)
    p9: CmF64HypDd = cm_b64_hyp_polydd_init(l: y2, c_hi: 0x1.ae64567f54482p-26,
        c_lo: -0x1.defcf17a6ab79p-81)
    p7: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p9,
        c: CmF64HypDd(hi: 0x1.71de3a556c734p-19, lo: -0x1.b4e2835532bcdp-73))
    p5: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p7,
        c: CmF64HypDd(hi: 0x1.a01a01a01a01ap-13, lo: 0x1.a0011c925b85cp-73))
    p3: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p5,
        c: CmF64HypDd(hi: 0x1.1111111111111p-7, lo: 0x1.11111115cf00dp-63))
    p1: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p3,
        c: CmF64HypDd(hi: 0x1.5555555555555p-3, lo: 0x1.555555555552fp-57))
    px: CmF64HypDd = cm_b64_hyp_mulddd(xh: p1.hi, xl: p1.lo, ch: x)
    p: CmF64HypDd = cm_b64_hyp_muldd(xh: px.hi, xl: px.lo, ch: x2, cl: x2l)
    s0: CmF64HypDd = cm_b64_hyp_fasttwosum(x, y: p.hi)
    s1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: s0.lo, y: p.lo)
    return s0.hi +! cm_b64_hyp_nudge(y1: s1.hi, y2: s1.lo)

### The exact sinh x for the arguments the fast and accurate paths can't round, or f for any other x.
### :param x: The argument.
### :param f: The result returned when |x| is not in the table.
### :returns: The correctly rounded sinh for a listed |x|, else `f`.
secret routine cm_b64_sinh_database(x: B64, f: B64) -> B64
    until a > b with a: S64 = 0, b: S64 = 50
        m: S64 = (a + b).div_trunc(2)
        mu: U64 = m.to[U64]()
        key: B64 = B64.from_bits(CM_B64_SINH_DB_X.getitem(mu))
        ax: B64 = x.abs()
        below: Bool = key < ax
        when
            below => continue with a: m + 1, b: b
            key == ax =>
                sgn: B64 = B64.copysign(1.0, x)
                h: B64 = B64.from_bits(CM_B64_SINH_DB_H.getitem(mu))
                l: B64 = B64.from_bits(CM_B64_SINH_DB_L.getitem(mu))
                return sgn *! h +! sgn *! l
            else => continue with a: a, b: m - 1
    then
        return f
