### The low parts, as B64 bits.
secret preset CM_B64_SINH_DB_L: &Array[U64, 51] <- [0xB95BC00000000000, 0xBC70000000000000,
    0x390A000000000000, 0xB960000000000000, 0xB970000000000000, 0xB922000000000000,
    0xB93F800000000000, 0x394E000000000000, 0x3958A00000000000, 0x3967200000000000,
