# Tessera stdlib: the correctly rounded e^x - 1 of B64
#
# For |x| < 1/4, e^x - 1 = (e^(i/128) - 1) + e^(i/128) (e^(z/128) - 1) with a
# table of e^(i/128) - 1 as double-doubles. Otherwise e^x as in exp, minus 1
# folded into the double-double sum. When that can't decide the rounding, a
# double-double Taylor expansion (|x| < 1/4) or the accurate exp polynomial
# redoes it, and a few arguments too close to a rounding boundary even for
# that are looked up. Round to nearest only: overflow gives +inf, a very
# negative x -1, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary64/expm1/expm1.c via RazorForge's B64Expm1.rf.
# Copyright (c) 2024 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/B64

### Double-double coefficients (high, low) of the degree-10 polynomial (in x,
### times x^3) of the accurate path for |x| < 1/4, as B64 bits.
secret preset CM_B64_EXPM1_ACC_SMALL_CH: @Array[U64, 22] <- [0x3FC5555555555555, 0x3C65555555555554,
    0x3FA5555555555555, 0x3C45555555555123, 0x3F81111111111111, 0x3C01111111118167,
    0x3F56C16C16C16C17, 0xBBEF49F49E220CEA, 0x3F2A01A01A01A01A, 0x3B6A019EFF6F919C,
    0x3EFA01A01A01A01A, 0x3B39FCFF48A75B41, 0x3EC71DE3A556C734, 0xBB6C14F73758CD7F,
    0x3E927E4FB7789F5C, 0x3B3DFCE97931018F, 0x3E5AE64567F544E3, 0x3AFC513DA9E4C9C5,
    0x3E21EED8EFF8D831, 0x3ACCA00AF84F2B60, 0x3DE6124613A86E8F, 0x3A8F27AC6000898F]

### Double coefficients of the highest-order terms of that polynomial, as B64 bits.
secret preset CM_B64_EXPM1_ACC_SMALL_CL: @Array[U64, 6] <- [0x3DA93974A8CA5354, 0x3D6AE7F3E71E4908,
    0x3D2AE7F357341648, 0x3CE952C7F96664CB, 0x3CA686F8CE633AAE, 0x3C62F49B2FBFB5B6]

### Double-double values (low, high) of e^(i/128) - 1, -32 <= i <= 32 (entry
