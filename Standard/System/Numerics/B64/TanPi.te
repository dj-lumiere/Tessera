### tan(pi me), correctly rounded (to nearest, ties to even). An integer n gives +0 for a positive even n or a
### negative odd one and -0 otherwise, n + 1/2 gives +inf for an even n and -inf for an odd one, n +- 1/4 gives
### +-1, +-inf gives NaN, and NaN comes back quiet.
### :returns: tan(pi `me`), correctly rounded.
routine B64.tan_pi_unchecked() -> Me
    ixu: U64 = me.bits()
    ax: U64 = ixu & 0x7FFFFFFFFFFFFFFF
    neg: U64 = ixu >> 63
    zero: Me = Me.copysign(0.0, me)
    one: Me = Me.copysign(1.0, me)

    moderate: Bool = ax >= 0x3F30000000000000  # |x| >= 2^-12
    # |x| >= 2^46: x is a multiple of 1/64, so tan(pi x) is a table entry
    if ax >= 0x42D0000000000000
        # NaN comes back quiet with its sign and payload, an infinity gives the NaN 0.0 / 0.0 gives
        # on x86-64
        if ax >= 0x7FF0000000000000
            if ax > 0x7FF0000000000000
                return me +! me
            return Me.from_bits(0xFFF8000000000000)
        sb: U64 = (ax >> 52) - 1069  # 2^(46 + sb) <= |x| < 2^(47 + sb)
        # |x| >= 2^53: an even integer
        if sb > 6
            return zero
        sm: U64 = cm_b64_tan_pi_signed(x: ax, neg)
        iq: U64 = (sm << sb) & 127  # 64 x mod 128
        if iq & 31 == 0
            return cm_b64_tan_pi_exact(jq: iq >> 5, neg)
        j: U64 = iq & 31
        # tan(pi (32 + j)/64) = -tan(pi (32 - j)/64)
        if iq & 32 != 0
            return -cm_b64_tan_pi_entry(U64.sub(32, j))
        return cm_b64_tan_pi_entry(j)

    # 2^-12 <= |x| < 2^46, so 1011 <= e <= 1068
    if moderate
        e: U64 = ax >> 52
        s: U64 = U64.sub(1068, e)
        s1: U64 = e - 1011
        m: U64 = (ax & 0x000FFFFFFFFFFFFF) | 0x0010000000000000  # 2^52 <= m < 2^53
        # msb is the bit of weight 1/2 in |x|: past it, tan(pi |x|) is read from the next table entry backward
        msb: U64 = (m << s1) >> 63
        past: Bool = msb == 1
        mm: U64 = when
            past => ~m
            else => m
        iq2: U64 = (mm >> s) & 63
        iq: U64 = iq2 + 1 >> 1
        flip: U64 = msb ^ neg  # the table entry is negated
        sm: U64 = cm_b64_tan_pi_signed(x: m, neg)
        k: U64 = sm << e - 1005  # the bits of 64 x below 1/2 (signed), scaled by 2^63
        z: Me = k.to_wrap[S64]().to[Me]()
        # x mod 2^-7 = 0
        if k == 0
            # x = jq/2: jq counts the quarter turns of the angle pi x
            if iq & 31 == 0
                jq: S64 = sm.to_wrap[S64]() >> (s + 6).to_wrap[S64]()
                return cm_b64_tan_pi_exact(jq: jq.to_wrap[U64](), neg)
            # |x| = 1/4 mod 1, or |x| = 3/4 mod 1
            kq: U64 = (m << s1) >> 58
            when kq
                0x10 => return one
                0x30 => return -one
                else => nothing
        # x mod 2^-8 = 0: the residual takes the sign of x
        aligned: Bool = k << 1 == 0
        zs: Me = when
            aligned => one *! z
            else => z
        return cm_b64_tan_pi_reduced(x: me, iq, flip, zs)

    # |x| < 2^-12
    is_zero: Bool = ax == 0
    when
        is_zero => return me
        # |x| < 2^-53
        ax < 0x3CA0000000000000 =>
            # |x| < 2^-916: scaled up so that the double-double product stays exact
            if ax < 0x06B0000000000000
                e: U64 = ax >> 52
                sc: Me = Me.from_bits(U64.sub(2045, e) << 52)
                isc: Me = Me.from_bits(e + 1 << 52)
                r: CmF64TrigDD = cm_b64_trig_pi_mulddd(xh: 0x1.921fb54442d18p+1,
                    xl: 0x1.1a62633145c07p-53, c: me *! sc)
                res: Me = r.hi *! isc
                # a subnormal result: round at the subnormal's precision by adding and removing
                # 2^-1022 at the scaled size
                if res.abs() < 0x1p-1022
                    o: Me = Me.copysign(0x1p-1022, me)
                    v0b: Me = (o +! res) *! sc
                    v0h: Me = res *! sc
                    tl: Me = r.lo +! (r.hi -! v0h)
                    v0: Me = v0b +! tl
                    return v0 *! isc -! o
                return cm_b64_tan_pi_check(x: me, th: r.hi, tl: r.lo, res)
            r: CmF64TrigDD = cm_b64_trig_pi_mulddd(xh: 0x1.921fb54442d18p+1,
                xl: 0x1.1a62633145c07p-53, c: me)
            return cm_b64_tan_pi_check(x: me, th: r.hi, tl: r.lo, res: r.hi)
        else => nothing

    # 2^-53 <= |x| < 2^-12: pi x + (pi^3/3) x^3 + ...
    x2: Me = me *! me
    x3: Me = me *! x2
    f2: Me = Me.add_unchecked(0x1.466bc6775aa2ap+5, x2 *! 0x1.46000158496c2p+7)
    f1: Me = Me.add_unchecked(0x1.4abbce625be53p+3, x2 *! f2)
    f: Me = x3 *! f1
    px: CmF64TrigDD = cm_b64_trig_pi_mulddd(xh: 0x1.921fb54442d18p+1, xl: 0x1.1a62633145c07p-53,
        c: me)
    t: CmF64TrigDD = cm_b64_tan_pi_fastsumddd(xh: px.hi, xl: px.lo, c: f)
    eps: Me = me *! (x2 *! 0x1.1p-47 +! 0x1p-101)
    lb: Me = t.hi +! (t.lo -! eps)
    ub: Me = t.hi +! (t.lo +! eps)
    if lb == ub
        return lb

    # the fast path can't decide the rounding: a longer double-double polynomial
    dx2: Me = b64_mul_error(x: me, y: me, p: x2)
    x2dd: CmF64TrigDD = (hi: x2, lo: dx2)
    dx3: Me = b64_mul_error(x: x2, y: me, p: x3) +! dx2 *! me
    cl1: Me = Me.add_unchecked(0x1.45f472e3aed7dp+9, x2 *! 0x1.45f33be0e9598p+11)
    cl: Me = x2 *! cl1
    q0: CmF64TrigDD = cm_b64_trig_pi_poly_start(c0: 0x1.45fff9b48e95ep+7, c1: 0x1.a5047910ae0efp-49,
        l: cl)
    q1: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: x2dd, p: q0,
        c: CmF64TrigDD(hi: 0x1.466bc6775aae2p+5, lo: -0x1.6dc0cbddc0e69p-50))
    q2: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: x2dd, p: q1,
        c: CmF64TrigDD(hi: 0x1.4abbce625be53p+3, lo: -0x1.05511c68476a8p-51))
    q3: CmF64TrigDD = cm_b64_trig_pi_muldd(xh: x3, xl: dx3, ch: q2.hi, cl: q2.lo)
    sv: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: px.hi, b: q3.hi)
    tl: Me = q3.lo +! px.lo +! sv.lo
    q: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: sv.hi, b: tl)
    return cm_b64_tan_pi_check(x: me, th: q.hi, tl: q.lo, res: q.hi)

### tan(pi x) for 2^-12 <= |x| < 2^46, from the table entry tan(pi iq/64) and the residual
### angle pi zs 2^-69 by the tangent addition formula: a fast double-double polynomial with a
### rounding test, else a longer one.
### :param x: The original input.
### :param iq: The table index, in 0..32.
### :param flip: 1 to negate the table entry, 0 to keep it.
### :param zs: The residual, 2^69 times the part of x the table entry leaves.
### :returns: tan(pi `x`), correctly rounded.
secret routine cm_b64_tan_pi_reduced(x: B64, iq: U64, flip: U64, zs: B64) -> B64
    z2: B64 = zs *! zs
    z4: B64 = z2 *! z2
    z3: B64 = zs *! z2
    c01: B64 = B64.add_unchecked(0x1.4abbce625be51p-207, z2 *! 0x1.466bc6776a9b1p-345)
    c23: B64 = B64.add_unchecked(0x1.45fff6eb26045p-483, z2 *! 0x1.4627663861052p-621)
    f: B64 = z3 *! (c01 +! z4 *! c23)
    eps0: B64 = z3 *! 0x1p-256 +! B64.copysign(0x1p-104, zs)
    p0: CmF64TrigDD = cm_b64_trig_pi_mulddd(xh: 0x1.921fb54442d18p-69, xl: 0x1.1a62633145c07p-123,
        c: zs)
    p1: CmF64TrigDD = cm_b64_tan_pi_fastsumddd(xh: p0.hi, xl: p0.lo, c: f)
    p: CmF64TrigDD = cm_b64_tan_pi_combine(th: p1.hi, tl: p1.lo, iq, flip)
    eps: B64 = eps0 +! eps0 *! (p.hi *! p.hi)
    lb: B64 = p.hi +! (p.lo -! eps)
    ub: B64 = p.hi +! (p.lo +! eps)
    if lb == ub
        return lb

    # the fast path can't decide the rounding: a longer double-double polynomial of tan(pi z 2^-69)
    z: B64 = zs *! 0x1p-63
    zz: B64 = z *! z
    dz2: B64 = b64_mul_error(x: z, y: z, p: zz)
    z2dd: CmF64TrigDD = (hi: zz, lo: dz2)
    cl2: B64 = B64.add_unchecked(0x1.45f3030c82af4p-78, zz *! 0x1.464490600a978p-90)
    cl1: B64 = B64.add_unchecked(0x1.45f32f25dab7fp-66, zz *! cl2)
    cl: B64 = zz *! cl1
    q0: CmF64TrigDD = cm_b64_trig_pi_poly_start(c0: 0x1.45f472e3af011p-54,
        c1: 0x1.90612a0755449p-110, l: cl)
    q1: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: z2dd, p: q0,
        c: CmF64TrigDD(hi: 0x1.45fff9b48e95ep-42, lo: 0x1.b226b250d2cc3p-98))
    q2: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: z2dd, p: q1,
        c: CmF64TrigDD(hi: 0x1.466bc6775aae2p-30, lo: -0x1.6dc0d93fb2ecep-85))
    q3: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: z2dd, p: q2,
        c: CmF64TrigDD(hi: 0x1.4abbce625be53p-18, lo: -0x1.05511c6842515p-72))
    q4: CmF64TrigDD = cm_b64_trig_pi_poly_step(x: z2dd, p: q3,
        c: CmF64TrigDD(hi: 0x1.921fb54442d18p-6, lo: 0x1.1a62633145c07p-60))
    q5: CmF64TrigDD = cm_b64_trig_pi_mulddd(xh: q4.hi, xl: q4.lo, c: z)
    q6: CmF64TrigDD = cm_b64_tan_pi_combine(th: q5.hi, tl: q5.lo, iq, flip)
    q: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: q6.hi, b: q6.lo)
    return cm_b64_tan_pi_check(x, th: q.hi, tl: q.lo, res: q.hi)

### The last step of the accurate paths: th + tl may still round the wrong way when tl sits at
### a rounding boundary, so such an input is looked up among the hard cases.
### :param x: The original input.
### :param th: The high part of tan(pi `x`).
### :param tl: The low part of tan(pi `x`).
### :param res: The result to return when `x` needs no lookup (or isn't listed).
### :returns: tan(pi `x`), correctly rounded.
secret routine cm_b64_tan_pi_check(x: B64, th: B64, tl: B64, res: B64) -> B64
    ul: U64 = tl.bits()
    er: U64 = ul +% 6 & 0x000FFFFFFFFFFFFF
    diff: U64 = th.bits() -% ul
    de: U64 = (diff >> 52) & 0x7FF
    if er <= 12 or de > 102
        return cm_b64_tan_pi_database(x, f: res)
    return res

### x with the sign of the input (neg is its sign bit), in two's complement.
### :param x: The magnitude.
### :param neg: The input's sign bit, 1 for negative.
### :returns: `x` when `neg` is 0, else `0 - x` (wrapping).
secret routine cm_b64_tan_pi_signed(x: U64, neg: U64) -> U64
    if neg == 1
        return U64.sub_wrap(0, x)
    return x

### tan(pi j/64) for j in 0..31, from its double-double table entry.
### :param j: The table index, in 0..31.
### :returns: tan(pi `j`/64), the high and low table parts summed to one B64.
secret routine cm_b64_tan_pi_entry(j: U64) -> B64
    i: U64 = j.to[U64]() * 2
    nl: B64 = B64.from_bits(CM_B64_TAN_PI_T.getitem(i))
    nh: B64 = B64.from_bits(CM_B64_TAN_PI_T.getitem(i + 1))
    return nh +! nl

### The exact tangent at a multiple of 1/4 (jq counts quarter turns, as a two's-complement bit pattern, only its two
### low bits matter, neg is the input's sign bit): +-inf at half-integers, a signed zero at integers.
### :param jq: The number of quarter turns (only its two low bits are read).
### :param neg: The input's sign bit.
### :returns: +inf or -inf for an odd `jq`, else +0 or -0.
secret routine cm_b64_tan_pi_exact(jq: U64, neg: U64) -> B64
    down: Bool = jq & 2 != 0

    odd: Bool = jq & 1 == 1
    when
        odd =>
            if down
                return -inf
            return inf
        (jq >> 1) & 1 != neg => return B64.from_bits(0x8000000000000000)
        else => return 0.0

### (xh + xl) + c as a double-double, for |xh| >= |c|.
### :param xh: The high part of the double-double.
### :param xl: The low part of the double-double.
### :param c: The B64 to add.
### :returns: The sum as a double-double.
secret routine cm_b64_tan_pi_fastsumddd(xh: B64, xl: B64, c: B64) -> CmF64TrigDD
    t: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: xh, b: c)
    return CmF64TrigDD(hi: t.hi, lo: xl +! t.lo)

### Combines tan(pi z') = th + tl for the small residual angle with the table entry tan(pi iq/64) by the tangent
### addition formula, in double-double arithmetic (iq in 0..32, where 32 is the pole, handled as -1/t, and flip = 1
### negates the table entry).
### :param th: The high part of tan(pi z').
### :param tl: The low part of tan(pi z').
### :param iq: The table index, in 0..32.
### :param flip: 1 to negate the table entry, 0 to keep it.
### :returns: The tangent of the whole angle as a double-double.
secret routine cm_b64_tan_pi_combine(th: B64, tl: B64, iq: U64, flip: U64) -> CmF64TrigDD
    if iq == 32
        # the denominator 1 - (th + tl) n
        # the numerator n + (th + tl)
        # 1 - (mh + ml) imh
        ith: B64 = B64.truediv_unchecked(-1.0, th)
        il: B64 = (ith.mul_add_unchecked(a: th, b: 1.0) +! tl *! ith) *! ith
        return CmF64TrigDD(hi: ith, lo: il)
    i: U64 = iq.to[U64]() * 2
    entry_l: B64 = B64.from_bits(CM_B64_TAN_PI_T.getitem(i))
    entry_h: B64 = B64.from_bits(CM_B64_TAN_PI_T.getitem(i + 1))
    negate: Bool = flip == 1
    nh0: B64 = when
        negate => -entry_h
        else => entry_h
    nl0: B64 = when
        negate => -entry_l
        else => entry_l
    mp: CmF64TrigDD = cm_b64_trig_pi_muldd(xh: th, xl: tl, ch: nh0, cl: nl0)
    mh: B64 = B64.sub_unchecked(1.0, mp.hi)
    dm: B64 = B64.sub_unchecked(1.0, mh) -! mp.hi
    ml: B64 = dm -! mp.lo
    ns: CmF64TrigDD = cm_b64_trig_fast_two_sum(a: nh0, b: th)
    nh: B64 = ns.hi
    nl: B64 = nl0 +! (ns.lo +! tl)
    imh: B64 = B64.truediv_unchecked(1.0, mh)
    rh: B64 = nh *! imh
    rem: B64 = (-mh).mul_add_unchecked(a: imh, b: 1.0) -! ml *! imh
    corr: B64 = (nl +! nh *! rem) *! imh
    rl: B64 = b64_mul_error(x: nh, y: imh, p: rh) +! corr
    return CmF64TrigDD(hi: rh, lo: rl)

### Looks up an input whose correctly rounded tangent the fast path can't decide, using tan(pi (x + 1)) = tan(pi x)
### and tan(pi (1/2 - x)) = 1/tan(pi x) to reduce it to [0, 1/2). Returns f when it isn't listed.
### :param x: The original input.
### :param f: The fast path's result, returned when `x` isn't listed.
### :returns: The listed correctly rounded tangent, or `f`.
secret routine cm_b64_tan_pi_database(x: B64, f: B64) -> B64
    ixu: U64 = x.bits()
    aix: U64 = ixu & 0x7FFFFFFFFFFFFFFF

    e: S64 = (aix >> 52).to_wrap[S64]() - 1022
    periodic: Bool = e >= 0  # |x| >= 1/2
    values2: (B64, U64) = when
        periodic =>
            # drop the integer part of |x|, then fold [1/2, 1) onto (0, 1/2]
            e2: U64 = e.to_wrap[U64]()
            whole: U64 = ~U64.arith_shift_right(0xFFFFFFFFFFFFFFFF, e2 + 12)
            t: B64 = B64.from_bits(aix & whole)
            ax: B64 = x.abs() -! t
            p: U64 = ((aix | 0x0010000000000000) >> U64.sub(52, e2)) & 1
            if p == 1
                becomes (B64.sub_unchecked(0.5, ax), p)
            else
                becomes (ax, p)
        else => (x.abs(), 0)
    ax, p = values2
    minus: Bool = p ^ (ixu >> 63) == 1
    sgn: B64 = when
        minus => -1.0
        else => 1.0

    each i: U64 in 0 til 49
        key: B64 = B64.from_bits(CM_B64_TAN_PI_DB.getitem(i * 3))
        if key == ax
            r: B64 = B64.from_bits(CM_B64_TAN_PI_DB.getitem(i * 3 + 1))
            dr: B64 = B64.from_bits(CM_B64_TAN_PI_DB.getitem(i * 3 + 2))
            return sgn *! r +! sgn *! dr
        continue
    then
        return f
