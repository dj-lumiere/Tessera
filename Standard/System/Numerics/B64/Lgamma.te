### The fast phase of lgamma: lgamma(x) within eps of hi + lo.
secret record CmF64LgammaFast
    hi: B64
    lo: B64
    eps: B64

### ln |Γ(me)|, correctly rounded (to nearest, ties to even): +inf at 0 and the negative integers, 0 at 1 and 2,
### +inf at ±inf and on overflow, and NaN comes back quiet.
### :returns: The natural logarithm of the absolute value of the gamma function at `me`.
routine B64.ln_gamma_unchecked() -> Me
    t: U64 = me.bits()
    nx: U64 = t << 1

    # |x| >= 0x1.006df1bfac84ep+1015
    if nx >= 0xFEAEA9B24F16A34C
        # two hard cases, +-inf, NaN (x + x quiets it), and overflow (huge negative integers are poles)
        when
            t == 0x7F5754D9278B51A6 => return Me.sub_unchecked(0x1.ffffffffffffep+1023, 0x1p+969)
            t == 0x7F5754D9278B51A7 => return Me.sub_unchecked(0x1.fffffffffffffp+1023, 0x1p+969)
            nx == 0xFFE0000000000000 => return me.abs()
            nx > 0xFFE0000000000000 => return me +! me
            else => return Me.mul_unchecked(0x1.fp+1023, 0x1.fp+1023)
    else
        if me.floor() == me
            # 0 and the negative integers are poles, and lgamma(1) = lgamma(2) = 0
            when
                me <= 0.0 => return Me.from_bits(0x7FF0000000000000)
                me == 1.0 or me == 2.0 => return 0.0
                else => nothing
        f: CmF64LgammaFast = cm_b64_lgamma_dd(me)
        ub: Me = f.hi +! (f.lo +! f.eps)
        lb: Me = f.hi +! (f.lo -! f.eps)
        if ub != lb
            return cm_b64_lgamma_accurate(me)
        return ub

### The double-double fast phase of lgamma, for a finite x that is not a pole, not
### 1 or 2, and below 0x1.006df1bfac84ep+1015 in magnitude.
### :param x: The argument.
### :returns: The approximation hi + lo and its error bound eps.
secret routine cm_b64_lgamma_dd(x: B64) -> CmF64LgammaFast
    t: U64 = x.bits()
    au: U64 = (t << 1) >> 38

    # |x| < 0.5: lgamma(x) = lgamma(1 + x) - log|x|
    if au < CM_B64_LGAMMA_UBRD.getitem(0)
        lg: CmF64GammaDD = cm_b64_gamma_logd(x.abs())
        # |x| < 2^-75
        if au < 0x1DA0000
            return CmF64LgammaFast(hi: -lg.hi, lo: -lg.lo, eps: 0x1.6aad80c11872cp-73)
        # |x| < 0.03125
        if au < 0x1FD0000
            z2: B64 = x *! x
            z4: B64 = z2 *! z2
            lo: B64 = cm_b64_lgamma_pair4(z: x, z2, q: 1437)
            hi: B64 = cm_b64_lgamma_pair4(z: x, z2, q: 1441)
            fl: B64 = x *! (lo +! z4 *! hi)
            p: CmF64GammaDD = cm_b64_lgamma_polydddfst(x, n: 4, base: 1429, l: fl)
            m: CmF64GammaDD = cm_b64_gamma_mulddd(x, ch: p.hi, cl: p.lo)
            f: CmF64GammaDD = cm_b64_gamma_sumdd(xh: -lg.hi, xl: -lg.lo, yh: m.hi, yl: m.lo)
            return CmF64LgammaFast(hi: f.hi, lo: f.lo, eps: 0x1.6aad80c11872cp-73)
        # 0.03125 <= |x| < 0.5: 1 + x falls in the piece-wise approximation
        s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: 1.0, y: x)
        j: U64 = cm_b64_lgamma_piece(s.hi.bits() >> 37)
        z: B64 = s.hi -! cm_b64_lgamma_t(j + 1068) +! s.lo
        p: CmF64GammaDD = cm_b64_lgamma_piece_poly(z, j)
        root: Bool = j == 4  # the region around the root at 1
        f: CmF64GammaDD = when
            root => cm_b64_gamma_mulddd(x: -x, ch: p.hi, cl: p.lo)
            else => p
        eps: B64 = f.hi.abs() *! 0x1.87f4d7d0af16bp-64
        g: CmF64GammaDD = cm_b64_gamma_sumdd(xh: -lg.hi, xl: -lg.lo, yh: f.hi, yl: f.lo)
        return CmF64LgammaFast(hi: g.hi, lo: g.lo, eps: eps +! lg.hi.abs() *! 0x1.2e3b40a0e9b4fp-71)

    # lgamma(|x|) with its error bound
    ax: B64 = x.abs()
    f: CmF64LgammaFast = when
        au >= CM_B64_LGAMMA_UBRD.getitem(19) => cm_b64_lgamma_stirling(ax, au)
        else =>
            # 0.5 <= |x| < 8.29541: piece-wise polynomials, with the roots at 1 and 2 factored out
            j: U64 = cm_b64_lgamma_piece(au)
            z: B64 = ax -! cm_b64_lgamma_t(j + 1068)
            p: CmF64GammaDD = cm_b64_lgamma_piece_poly(z, j)
            one: Bool = j == 4
            two: Bool = j == 10
            f1: CmF64GammaDD = when
                one => cm_b64_gamma_mulddd(x: B64.sub_unchecked(1.0, ax), ch: p.hi, cl: p.lo)
                else => p
            f2: CmF64GammaDD = when
                two => cm_b64_gamma_mulddd(x: ax -! 2.0, ch: f1.hi, cl: f1.lo)
                else => f1
            hi_err: B64 = f2.hi.abs() *! 0x1.9ad88bdabdb20p-64
            becomes CmF64LgammaFast(hi: f2.hi, lo: f2.lo, eps: hi_err +! 0x1.357c299a88ea7p-80)
    if t >> 63 == 1
        # x < 0: lgamma(x) = log(pi / |x sin(pi x)|) - lgamma(-x)
        s0: CmF64GammaDD = cm_b64_lgamma_sinpipid(x -! x.floor())
        sp: CmF64GammaDD = cm_b64_gamma_mulddd(x: -x, ch: s0.hi, cl: s0.lo)
        lg: CmF64GammaDD = cm_b64_gamma_logd(sp.hi)
        s: CmF64GammaDD = cm_b64_gamma_sumdd(xh: f.hi, xl: f.lo, yh: lg.hi,
            yl: lg.lo +! sp.lo /! sp.hi)
        return CmF64LgammaFast(hi: -s.hi, lo: -s.lo,
            eps: f.eps +! lg.hi.abs() *! 0x1.e392010175ee6p-71)
    return f

### lgamma(|x|) for |x| >= 8.29541 by Stirling's series, (|x| - 1/2) (log|x| - 1) + ..., with its
### error bound.
### :param ax: The argument |x|, at least 8.29541.
### :param au: The bits of |x| shifted right by 37, which pick the case.
### :returns: The approximation hi + lo and its error bound eps.
secret routine cm_b64_lgamma_stirling(ax: B64, au: U64) -> CmF64LgammaFast
    lg: CmF64GammaDD = cm_b64_gamma_logd(ax)
    lh: B64 = lg.hi -! 1.0
    s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: lh, y: lg.lo)
    # (|x| - 1/2) (log|x| - 1)
    m: CmF64GammaDD = when
        # |x| >= 2^52: |x| - 1/2 isn't exact, so multiply by |x| and take half the log off
        au >= 0x2198000 =>
            # |x| >= 0x1.754cp+1014 takes the renormalized log - 1
            renorm: Bool = au >= 0x3FABAA6
            l: CmF64GammaDD = when
                renorm => s
                else => CmF64GammaDD(hi: lh, lo: lg.lo)
            p: CmF64GammaDD = cm_b64_gamma_mulddd(x: ax, ch: l.hi, cl: l.lo)
            becomes CmF64GammaDD(hi: p.hi, lo: p.lo -! l.hi *! 0.5)
        else => cm_b64_gamma_mulddd(x: ax -! 0.5, ch: lh, cl: lg.lo)
    a: CmF64GammaDD = cm_b64_gamma_fastsum(xh: m.hi, xl: m.lo, yh: cm_b64_lgamma_t(1445),
        yl: cm_b64_lgamma_t(1446))
    # the series in 1/|x|, negligible from 2^100 on
    g: CmF64GammaDD = when
        ax < 0x1p+100 =>
            zh: B64 = B64.truediv_unchecked(1.0, ax)
            zl: B64 = zh.mul_add_unchecked(a: -ax, b: 1.0) *! zh
            z2h: B64 = zh *! zh
            z4h: B64 = z2h *! z2h
            q0: B64 = cm_b64_lgamma_t(1449) +! z2h *! cm_b64_lgamma_t(1450)
            q2: B64 = cm_b64_lgamma_t(1451) +! z2h *! cm_b64_lgamma_t(1452)
            q4: B64 = cm_b64_lgamma_t(1453)
            fl: B64 = z2h *! (q0 +! z4h *! (q2 +! z4h *! q4))
            f: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: cm_b64_lgamma_t(1447), y: fl)
            becomes cm_b64_gamma_muldd(xh: f.hi, xl: f.lo +! cm_b64_lgamma_t(1448), ch: zh, cl: zl)
        else => CmF64GammaDD(hi: 0.0, lo: 0.0)
    f: CmF64GammaDD = cm_b64_gamma_fastsum(xh: a.hi, xl: a.lo, yh: g.hi, yl: g.lo)
    return CmF64LgammaFast(hi: f.hi, lo: f.lo, eps: f.hi.abs() *! 0x1.a90352e248a68p-65)

### Entry i of CM_B64_LGAMMA_T as a B64.
### :param i: The index into the table.
### :returns: The entry as a B64.
secret routine cm_b64_lgamma_t(i: U64) -> B64
    return B64.from_bits(CM_B64_LGAMMA_T.getitem(i))

### (c[q] + z c[q+1]) + z2 (c[q+2] + z c[q+3]) for the entries c of CM_B64_LGAMMA_T.
### :param z: The argument.
### :param z2: z^2.
### :param q: The table index of c[q].
### :returns: The value of the four-term polynomial.
secret routine cm_b64_lgamma_pair4(z: B64, z2: B64, q: U64) -> B64
    a: B64 = cm_b64_lgamma_t(q) +! z *! cm_b64_lgamma_t(q + 1)
    b: B64 = cm_b64_lgamma_t(q + 2) +! z *! cm_b64_lgamma_t(q + 3)
    return a +! z2 *! b

### The piece-wise region (0..18) of [0.5, 8.29541] holding the argument whose bits
### shifted right by 37 are au (at least CM_B64_LGAMMA_UBRD[0]).
### :param au: The bits of the argument's absolute value, shifted right by 37.
### :returns: The region index.
secret routine cm_b64_lgamma_piece(au: U64) -> U64
    ou: U64 = au - CM_B64_LGAMMA_UBRD.getitem(0)
    p: U64 = ou *% 0x150D & 0xFFFFFFFF  # the C code's 32-bit product wraps
    prod: U64 = U64.sub_wrap(0x157CED865, p) *% ou
    region: U64 = prod +% 0x128000000000 >> 45
    j: U64 = region.to[U64]()
    if au < CM_B64_LGAMMA_UBRD.getitem(j)
        return j - 1
    return j

### The region-j polynomial of the piece-wise approximation at the offset z.
### :param z: The offset of the argument within the region.
### :param j: The region index, 0..18.
### :returns: The polynomial value as a double-double.
secret routine cm_b64_lgamma_piece_poly(z: B64, j: U64) -> CmF64GammaDD
    z2: B64 = z *! z
    z4: B64 = z2 *! z2
    q: U64 = j * 8 + 1087
    lo: B64 = cm_b64_lgamma_pair4(z, z2, q)
    hi: B64 = cm_b64_lgamma_pair4(z, z2, q: q + 4)
    fl: B64 = z *! (lo +! z4 *! hi)
    return cm_b64_lgamma_polydddfst(x: z, n: 5, base: j * 10 + 1239, l: fl)

### The correctly rounded log-gamma of a tabulated hard-to-round x, or f otherwise.
### :param x: The argument.
### :param f: The result returned when `x` is not in the table.
### :returns: The correctly rounded log-gamma for a listed `x`, else `f`.
secret routine cm_b64_lgamma_database(x: B64, f: B64) -> B64
    until a > b with a: S64 = 0, b: S64 = 18
        m: S64 = (a + b).div_trunc(2)
        base: U64 = (m * 3).to[U64]()
        key: B64 = cm_b64_lgamma_t(base)
        when
            key < x => continue with a: m + 1, b: b
            key == x => return cm_b64_lgamma_t(base + 1) +! cm_b64_lgamma_t(base + 2)
            else => continue with a: a, b: m - 1
    then
        return f

### The triple-double sum f + l.
### :param f: The triple-double addend.
### :param lh: The high part of l.
### :param ll: The middle part of l.
### :param lll: The low part of l.
### :returns: The sum as a triple-double.
secret routine cm_b64_lgamma_add3(f: CmF64GammaTD, lh: B64, ll: B64, lll: B64) -> CmF64GammaTD
    s: CmF64GammaDD = cm_b64_gamma_sumdd(xh: f.mid, xl: f.lo, yh: ll, yl: lll)
    h: CmF64GammaDD = cm_b64_gamma_twosum(x: f.hi, y: lh)
    s2: CmF64GammaDD = cm_b64_gamma_sumdd(xh: s.hi, xl: s.lo, yh: h.lo, yl: 0.0)
    return CmF64GammaTD(hi: h.hi, mid: s2.hi, lo: s2.lo)

### f + log(x) for a triple-double f and x > 0, both as triple-doubles.
### :param f: The triple-double addend.
### :param x: The positive argument of the logarithm.
### :returns: The sum as a triple-double.
secret routine cm_b64_lgamma_add_log(f: CmF64GammaTD, x: B64) -> CmF64GammaTD
    l: CmF64GammaTD = cm_b64_lgamma_logd_accurate(x)
    return cm_b64_lgamma_add3(f, lh: l.hi, ll: l.mid, lll: l.lo)

### log(x - 1) + log(x - 2) as a triple-double, for x > 2.
### :param x: The argument, greater than 2.
### :returns: The sum of the two logarithms as a triple-double.
secret routine cm_b64_lgamma_log2terms(x: B64) -> CmF64GammaTD
    l2: CmF64GammaTD = cm_b64_lgamma_logd_accurate(x -! 2.0)
    l1: CmF64GammaTD = cm_b64_lgamma_logd_accurate(x -! 1.0)
    s: CmF64GammaDD = cm_b64_gamma_sumdd(xh: l1.mid, xl: l1.lo, yh: l2.mid, yl: l2.lo)
    h: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: l1.hi, y: l2.hi)
    s2: CmF64GammaDD = cm_b64_gamma_sumdd(xh: s.hi, xl: s.lo, yh: h.lo, yl: 0.0)
    return CmF64GammaTD(hi: h.hi, mid: s2.hi, lo: s2.lo)

### A double-double as a triple-double with a zero low part.
### :param f: The double-double value.
### :returns: `f` as a triple-double.
secret routine cm_b64_lgamma_td(f: CmF64GammaDD) -> CmF64GammaTD
    return CmF64GammaTD(hi: f.hi, mid: f.lo, lo: 0.0)

### The accurate phase of lgamma, for a finite x that is not a pole.
### :param x: The argument.
### :returns: lgamma(`x`), correctly rounded.
secret routine cm_b64_lgamma_accurate(x: B64) -> B64
    ax: B64 = x.abs()

    if ax < 0x1p-2
        # lgamma(x) as fh + fl + fll
        near: CmF64GammaTD = when
            ax < 0x1p-100 =>
                # |x| < 2^-100: lgamma(x) = -log|x|
                l: CmF64GammaTD = cm_b64_lgamma_logd_accurate(ax)
                s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: -l.hi, y: -l.mid)
                s2: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: s.lo, y: -l.lo)
                becomes CmF64GammaTD(hi: s.hi, mid: s2.hi, lo: s2.lo)
            else =>
                # |x| < 1/4: lgamma(x) = x P(x) - log|x|
                p: CmF64GammaDD = cm_b64_lgamma_polydddfst(x, n: 34, base: 57, l: 0.0)
                m: CmF64GammaDD = cm_b64_gamma_mulddd(x, ch: p.hi, cl: p.lo)
                l: CmF64GammaTD = cm_b64_lgamma_logd_accurate(ax)
                f: CmF64GammaDD = cm_b64_gamma_sumdd(xh: m.hi, xl: m.lo, yh: -l.mid, yl: -l.lo)
                h: CmF64GammaDD = cm_b64_gamma_twosum(x: -l.hi, y: f.hi)
                s: CmF64GammaDD = cm_b64_gamma_twosum(x: h.lo, y: f.lo)
                becomes CmF64GammaTD(hi: h.hi, mid: s.hi, lo: s.lo)
        # fh + fl a rounding midpoint: move fl toward fll (the second test holds in round to
        # nearest)
        e: B64 = cm_b64_gamma_fasttwosum(x: near.hi, y: B64.mul_unchecked(2.0, near.mid)).lo
        tie: Bool = e == 0.0 and B64.add_unchecked(1.0, 0x1p-54) == B64.sub_unchecked(1.0, 0x1p-54)
        adj: B64 = B64.copysign(0x1p-52, near.mid) *! B64.copysign(1.0, near.lo)
        fl: B64 = when
            tie => near.mid *! B64.add_unchecked(1.0, adj)
            else => near.mid
        return cm_b64_lgamma_round(x, fh: near.hi, fl)

    # |x| >= 1/4: lgamma(|x|) or, for x < 0, lgamma(1 + |x|), from the region of |x|
    r: CmF64GammaTD = when
        (ax -! 0.5).abs() < 0x1p-2 =>
            # the polynomial of lgamma(1 + y) around 1.5 gives lgamma(1/2 + d) after taking log off
            q: CmF64GammaTD = cm_b64_lgamma_td(cm_b64_lgamma_polydddfst(x: ax -! 0.5, n: 30,
                base: 125, l: 0.0))
            positive: Bool = x > 0.0
            becomes when
                positive =>
                    l: CmF64GammaTD = cm_b64_lgamma_logd_accurate(ax)
                    becomes cm_b64_lgamma_add3(f: q, lh: -l.hi, ll: -l.mid, lll: -l.lo)
                else => q
        (ax -! 2.5).abs() < 0x1p-2 =>
            f: CmF64GammaTD = cm_b64_lgamma_td(cm_b64_lgamma_polydddfst(x: ax -! 2.5, n: 30,
                base: 125, l: 0.0))
            becomes cm_b64_lgamma_shift_up(x, r: cm_b64_lgamma_add_log(f, x: ax -! 1.0))
        (ax -! 3.5).abs() < 0x1p-2 =>
            l: CmF64GammaTD = cm_b64_lgamma_log2terms(ax)
            f: CmF64GammaTD = cm_b64_lgamma_td(cm_b64_lgamma_polydddfst(x: ax -! 3.5, n: 30,
                base: 125, l: 0.0))
            becomes cm_b64_lgamma_shift_up(x,
                r: cm_b64_lgamma_add3(f, lh: l.hi, ll: l.mid, lll: l.lo))
        (ax -! 1.0).abs() < 0x1p-2 =>
            d: B64 = ax -! 1.0
            p: CmF64GammaDD = cm_b64_lgamma_polydddfst(x: d, n: 34, base: 57, l: 0.0)
            becomes cm_b64_lgamma_shift_up(x,
                r: cm_b64_lgamma_td(cm_b64_gamma_mulddd(x: d, ch: p.hi, cl: p.lo)))
        (ax -! 1.5).abs() < 0x1p-2 =>
            p: CmF64GammaDD = cm_b64_lgamma_polydddfst(x: ax -! 1.5, n: 30, base: 125, l: 0.0)
            becomes cm_b64_lgamma_shift_up(x, r: cm_b64_lgamma_td(p))
        (ax -! 2.0).abs() < 0x1p-2 =>
            l: CmF64GammaTD = cm_b64_lgamma_logd_accurate(ax -! 1.0)
            d: B64 = ax -! 2.0
            p: CmF64GammaDD = cm_b64_lgamma_polydddfst(x: d, n: 34, base: 57, l: 0.0)
            f: CmF64GammaTD = cm_b64_lgamma_td(cm_b64_gamma_mulddd(x: d, ch: p.hi, cl: p.lo))
            becomes cm_b64_lgamma_shift_up(x,
                r: cm_b64_lgamma_add3(f, lh: l.hi, ll: l.mid, lll: l.lo))
        (ax -! 3.0).abs() < 0x1p-2 =>
            l: CmF64GammaTD = cm_b64_lgamma_log2terms(ax)
            d: B64 = ax -! 3.0
            p: CmF64GammaDD = cm_b64_lgamma_polydddfst(x: d, n: 34, base: 57, l: 0.0)
            f: CmF64GammaTD = cm_b64_lgamma_td(cm_b64_gamma_mulddd(x: d, ch: p.hi, cl: p.lo))
            becomes cm_b64_lgamma_shift_up(x,
                r: cm_b64_lgamma_add3(f, lh: l.hi, ll: l.mid, lll: l.lo))
        else =>
            # Stirling's series at |x|, or at 1 + |x| = 1 - x for x < 0
            negative: Bool = x < 0.0
            s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: ax, y: 1.0)
            becomes when
                negative => cm_b64_lgamma_asym_accurate(xh: s.hi, xl: s.lo)
                else => cm_b64_lgamma_asym_accurate(xh: ax, xl: 0.0)
    full: CmF64GammaTD = when
        x < 0.0 =>
            # lgamma(x) = log(pi / |sin(pi x)|) - lgamma(1 - x)
            far: Bool = x < -0.5
            phi: B64 = when
                far => x -! x.floor()
                else => -x
            sp: CmF64GammaDD = cm_b64_lgamma_sinpipid_accurate(phi)
            l: CmF64GammaTD = cm_b64_lgamma_logd_accurate(sp.hi)
            s: CmF64GammaTD = cm_b64_lgamma_add3(f: r, lh: l.hi,
                ll: l.mid +! (sp.lo /! sp.hi +! l.lo), lll: 0.0)
            becomes CmF64GammaTD(hi: -s.hi, mid: -s.mid, lo: -s.lo)
        else => r

    # renormalize the triple-double, then nudge fl off a rounding midpoint toward fll
    s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: full.hi, y: full.mid)
    s2: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: s.lo, y: full.lo)
    s3: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: s.hi, y: s2.hi)
    s4: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: s3.lo, y: s2.lo)
    e: B64 = cm_b64_gamma_fasttwosum(x: s3.hi, y: B64.mul_unchecked(2.0, s4.hi)).lo
    tie: Bool = e == 0.0
    adj: B64 = B64.copysign(0x1p-26, s4.hi) *! B64.copysign(0x1p-26, s4.lo)
    fl: B64 = when
        tie => s4.hi *! B64.add_unchecked(1.0, adj)
        else => s4.hi
    return cm_b64_lgamma_round(x, fh: s3.hi, fl)

### lgamma(|x|) as r, made lgamma(1 + |x|) = r + log|x| for x < 0, which the reflection wants.
### :param x: The argument.
### :param r: lgamma(|`x`|) as a triple-double.
### :returns: `r` + log|`x`| for `x` < 0, else `r`.
secret routine cm_b64_lgamma_shift_up(x: B64, r: CmF64GammaTD) -> CmF64GammaTD
    if x < 0.0
        return cm_b64_lgamma_add_log(f: r, x: x.abs())
    return r

### Rounds the accurate result fh + fl of lgamma(x): near a root of lgamma for -10.5 < x < -2
### it is replaced by the polynomial around that root, and a sum with fl next to a power of two
### is looked up among the hard cases.
### :param x: The argument.
### :param fh: The high part of lgamma(`x`).
### :param fl: The low part of lgamma(`x`).
### :returns: lgamma(`x`), correctly rounded.
secret routine cm_b64_lgamma_round(x: B64, fh: B64, fl: B64) -> B64
    # near a root of lgamma for -10.5 < x < -2: a polynomial around the root
    k: U64 = when
        fh.abs() < 0x1.8p-2 => cm_b64_lgamma_root_region(x, fh)
        else => 17
    f: CmF64GammaDD = when
        k == 17 => CmF64GammaDD(hi: fh, lo: fl)
        else => cm_b64_lgamma_root_poly(x, k)
    # fl next to a power of two: fh + fl may be one of the tabulated hard cases
    fl_near: U64 = f.lo.bits() +% 2
    if fl_near & 0x000FFFFFFFFFFFFF <= 2
        return cm_b64_lgamma_database(x, f: f.hi +! f.lo)
    return f.hi +! f.lo

### The root region k (0..16) whose interval holds x and whose bound on |fh| holds, or 17 when there
### is none.
### :param x: The argument.
### :param fh: The high part of the approximation of lgamma(`x`).
### :returns: The first region that fits, or 17.
secret routine cm_b64_lgamma_root_region(x: B64, fh: B64) -> U64
    for k: U64 in 0 til 17
        small: Bool = fh.abs() < B64.from_bits(CM_B64_LGAMMA_RG_FH.getitem(k))
        above: Bool = x > B64.from_bits(CM_B64_LGAMMA_RG_LO.getitem(k))
        below: Bool = x < B64.from_bits(CM_B64_LGAMMA_RG_HI.getitem(k))
        if small and above and below
            return k
    then
        return 17

### The polynomial of root region k (around a root x0 of lgamma for -10.5 < x < -2) at x.
### :param x: The argument.
### :param k: The root region, 0..16.
### :returns: The polynomial value as a double-double.
secret routine cm_b64_lgamma_root_poly(x: B64, k: U64) -> CmF64GammaDD
    x0: U64 = CM_B64_LGAMMA_RG_X0.getitem(k)
    c: U64 = CM_B64_LGAMMA_RG_C.getitem(k)
    n: U64 = CM_B64_LGAMMA_RG_N.getitem(k)
    kk: U64 = CM_B64_LGAMMA_RG_K.getitem(k)
    biased_exponent: S64 = CM_B64_LGAMMA_RG_SC.getitem(k) + 1023
    sc: B64 = B64.from_bits(biased_exponent.to[U64]() << 52)
    z: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: cm_b64_lgamma_t(x0) +! x,
        y: cm_b64_lgamma_t(x0 + 1))
    zh: B64 = z.hi
    zl: B64 = z.lo +! cm_b64_lgamma_t(x0 + 2)
    sh: B64 = zh *! sc
    sl: B64 = zl *! sc
    nd: U64 = n - kk
    fl: B64 = sh *! cm_b64_lgamma_polyd(x: sh, n: kk, base: c + nd * 2)
    s: CmF64GammaDD = (hi: sh, lo: sl)
    f: CmF64GammaDD = cm_b64_lgamma_polydd(x: s, n: nd, base: c, l: fl)
    return cm_b64_gamma_muldd(xh: zh, xl: zl, ch: f.hi, cl: f.lo)

### The double-double polynomial c[0] + c[1] x + ... + (c[n-1] + l) x^(n-1) of the
### (high, low) pairs of CM_B64_LGAMMA_T from base, at a double-double x.
### :param x: The point, as a double-double.
### :param n: The number of coefficient pairs, at least 1.
### :param base: The table index of the first pair.
### :param l: The tail added to the highest coefficient.
### :returns: The polynomial value as a double-double.
secret routine cm_b64_lgamma_polydd(x: CmF64GammaDD, n: U64, base: U64, l: B64) -> CmF64GammaDD
    ch: &B64 <- .hollow()
    cl: &B64 <- .hollow()

    i: U64 = n - 1
    k: U64 = base + i * 2
    s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: cm_b64_lgamma_t(k), y: l)
    s.hi.poke_into(ch)
    (s.lo +! cm_b64_lgamma_t(k + 1)).poke_into(cl)

    until i2 == 0 with i2: U64 = i
        i3: U64 = i2 - 1
        k2: U64 = base + i3 * 2
        m: CmF64GammaDD = cm_b64_gamma_muldd(xh: x.hi, xl: x.lo, ch: ch.load(), cl: cl.load())
        a: CmF64GammaDD = cm_b64_gamma_fastsum(xh: cm_b64_lgamma_t(k2), xl: cm_b64_lgamma_t(k2 + 1),
            yh: m.hi, yl: m.lo)
        next_cl: B64 = a.lo
        next_ch: B64 = a.hi
        next_ch.poke_into(ch)
        next_cl.poke_into(cl)
        continue with i2: i3
    then
        return CmF64GammaDD(hi: ch.load(), lo: cl.load())

### The same polynomial at a double x.
### :param x: The argument.
### :param n: The number of coefficient pairs, at least 1.
### :param base: The table index of the first pair.
### :param l: The tail added to the highest coefficient.
### :returns: The polynomial value as a double-double.
secret routine cm_b64_lgamma_polydddfst(x: B64, n: U64, base: U64, l: B64) -> CmF64GammaDD
    ch: &B64 <- .hollow()
    cl: &B64 <- .hollow()

    i: U64 = n - 1
    k: U64 = base + i * 2
    s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: cm_b64_lgamma_t(k), y: l)
    s.hi.poke_into(ch)
    (s.lo +! cm_b64_lgamma_t(k + 1)).poke_into(cl)

    until i2 == 0 with i2: U64 = i
        i3: U64 = i2 - 1
        k2: U64 = base + i3 * 2
        m: CmF64GammaDD = cm_b64_gamma_mulddd(x, ch: ch.load(), cl: cl.load())
        a: CmF64GammaDD = cm_b64_gamma_fastsum(xh: cm_b64_lgamma_t(k2), xl: cm_b64_lgamma_t(k2 + 1),
            yh: m.hi, yl: m.lo)
        next_cl: B64 = a.lo
        next_ch: B64 = a.hi
        next_ch.poke_into(ch)
        next_cl.poke_into(cl)
        continue with i2: i3
    then
        return CmF64GammaDD(hi: ch.load(), lo: cl.load())

### The double polynomial c[0] + c[1] x + ... + c[n-1] x^(n-1) of the high parts of the
### pairs of CM_B64_LGAMMA_T from base.
### :param x: The argument.
### :param n: The number of coefficients, at least 1.
### :param base: The table index of the first pair.
### :returns: The polynomial value.
secret routine cm_b64_lgamma_polyd(x: B64, n: U64, base: U64) -> B64
    ch: &B64 <- .hollow()

    i: U64 = n - 1
    cm_b64_lgamma_t(base + i * 2).poke_into(ch)

    until i2 == 0 with i2: U64 = i
        i3: U64 = i2 - 1
        (cm_b64_lgamma_t(base + i3 * 2) +! x *! ch.load()).poke_into(ch)
        continue with i2: i3
    then
        return ch.load()

### sin(pi x) / pi as a double-double, for 0 < x < 1.
### :param x: The argument, 0 < x < 1.
### :returns: sin(pi `x`) / pi as a double-double.
secret routine cm_b64_lgamma_sinpipid(x: B64) -> CmF64GammaDD
    ax: B64 = (x -! 0.5).abs()
    sx: B64 = ax *! 128.0
    ix: B64 = sx.round_ties_even()
    ky: U64 = ix.to[S64]().to[U64]()
    kx: U64 = U64.sub(64, ky)

    if kx < 2
        # x close to 0 or 1: sin(pi z) / pi = z (1 + z^2 P(z^2)) with z = 1/2 - |x - 1/2|
        z: B64 = B64.sub_unchecked(0.5, ax)
        z2: B64 = z *! z
        z2l: B64 = b64_mul_error(x: z, y: z, p: z2)
        fl_tail: B64 = z2 *! 0x1.ac644e7aa33e6p-6 +! -0x1.86a8e46ddf78dp-3
        fl: B64 = z2 *! (z2 *! fl_tail +! 0x1.9f9cb402bc42ap-1)
        f0: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: -0x1.a51a6625307d3p+0, y: fl)
        f1: CmF64GammaDD = cm_b64_gamma_muldd(xh: z2, xl: z2l, ch: f0.hi,
            cl: f0.lo +! -0x1.16cc8f2044a4ap-55)
        f: CmF64GammaDD = cm_b64_gamma_mulddd(x: z, ch: f1.hi, cl: f1.lo)
        s: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: z, y: f.hi)
        return CmF64GammaDD(hi: s.hi, lo: f.lo +! s.lo)
    d: B64 = ix -! sx
    d2: B64 = d *! d
    sh: B64 = cm_b64_lgamma_t(kx * 2 + 1671)
    sl: B64 = cm_b64_lgamma_t(kx * 2 + 1670)
    ch: B64 = cm_b64_lgamma_t(ky * 2 + 1671)
    cl: B64 = cm_b64_lgamma_t(ky * 2 + 1670)
    pp_tail: B64 = d2 *! 0x1.e1f4826790653p-59 +! -0x1.55d3c7e3bd8bfp-42
    pp: B64 = d2 *! (d2 *! pp_tail +! 0x1.03c1f081b5ac4p-26)
    qq_tail: B64 = d2 *! -0x1.32d26e446373ap-50 +! 0x1.466bc67748efcp-34
    qq: B64 = d2 *! (d2 *! qq_tail +! -0x1.4abbce625be53p-19)
    q: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: 0x1.921fb54442d18p-6, y: qq)
    c: CmF64GammaDD = cm_b64_gamma_muldd(xh: q.hi, xl: q.lo +! 0x1.1a624b88c9448p-60, ch, cl)
    t0: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: -0x1.3bd3cc9be45dep-12, y: pp)
    th: CmF64GammaDD = cm_b64_gamma_mulddd(x: d, ch: t0.hi, cl: t0.lo +! -0x1.692b66e3cf6e8p-66)
    ph: CmF64GammaDD = cm_b64_gamma_muldd(xh: th.hi, xl: th.lo, ch: sh, cl: sl)
    c1: CmF64GammaDD = cm_b64_gamma_fastsum(xh: c.hi, xl: c.lo, yh: ph.hi, yl: ph.lo)
    c2: CmF64GammaDD = cm_b64_gamma_mulddd(x: d, ch: c1.hi, cl: c1.lo)
    return cm_b64_gamma_fastsum(xh: sh, xl: sl, yh: c2.hi, yl: c2.lo)

### sin(pi x) / pi as an accurate double-double, for 0 < x < 1.
### :param x: The argument, 0 < x < 1.
### :returns: sin(pi `x`) / pi as a double-double.
secret routine cm_b64_lgamma_sinpipid_accurate(x: B64) -> CmF64GammaDD
    from_half: B64 = (x -! 0.5).abs()
    y: B64 = from_half *! 128.0
    ix: B64 = y.round_ties_even()
    d: B64 = ix -! y
    ky: U64 = ix.to[S64]().to[U64]()
    kx: U64 = U64.sub(64, ky)
    sh: B64 = cm_b64_lgamma_t(kx * 2 + 1671)
    sl: B64 = cm_b64_lgamma_t(kx * 2 + 1670)
    ch: B64 = cm_b64_lgamma_t(ky * 2 + 1671)
    cl: B64 = cm_b64_lgamma_t(ky * 2 + 1670)
    d2h: B64 = d *! d
    d2l: B64 = b64_mul_error(x: d, y: d, p: d2h)
    d2: CmF64GammaDD = (hi: d2h, lo: d2l)
    p0: CmF64GammaDD = cm_b64_lgamma_polydd(x: d2, n: 5, base: 1800, l: 0.0)
    q0: CmF64GammaDD = cm_b64_lgamma_polydd(x: d2, n: 6, base: 1810, l: 0.0)
    p1: CmF64GammaDD = cm_b64_gamma_mulddd(x: d, ch: p0.hi, cl: p0.lo)
    p: CmF64GammaDD = cm_b64_gamma_muldd(xh: sh, xl: sl, ch: p1.hi, cl: p1.lo)
    q: CmF64GammaDD = cm_b64_gamma_muldd(xh: ch, xl: cl, ch: q0.hi, cl: q0.lo)
    c0: CmF64GammaDD = cm_b64_gamma_fastsum(xh: q.hi, xl: q.lo, yh: p.hi, yl: p.lo)
    c: CmF64GammaDD = cm_b64_gamma_mulddd(x: d, ch: c0.hi, cl: c0.lo)
    return cm_b64_gamma_fastsum(xh: sh, xl: sl, yh: c.hi, yl: c.lo)

### log(x) as a triple-double, for a positive finite x (subnormals included).
### :param x: The positive finite argument.
### :returns: log(`x`) as a triple-double.
secret routine cm_b64_lgamma_logd_accurate(x: B64) -> CmF64GammaTD
    a: CmF64GammaLogArg = cm_b64_gamma_log_arg(x)
    r: B64 = cm_b64_tgamma_t(a.i1 + 969) *! cm_b64_tgamma_t(a.i2 + 1002)
    o: B64 = r *! a.tf
    dx: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: o -! 1.0, y: b64_mul_error(x: r, y: a.tf, p: o))
    q: B64 = cm_b64_lgamma_t(1666) +! dx.hi *! cm_b64_lgamma_t(1668)
    fl: B64 = dx.hi *! (cm_b64_lgamma_t(1664) +! dx.hi *! q)
    f0: CmF64GammaDD = cm_b64_lgamma_polydd(x: dx, n: 6, base: 1652, l: fl)
    f: CmF64GammaDD = cm_b64_gamma_muldd(xh: dx.hi, xl: dx.lo, ch: f0.hi, cl: f0.lo)
    h1: U64 = a.i1 * 3 + 1454
    h2: U64 = a.i2 * 3 + 1553
    s2: B64 = cm_b64_lgamma_t(h1 + 2) +! cm_b64_lgamma_t(h2 + 2)
    s1: B64 = cm_b64_lgamma_t(h1 + 1) +! cm_b64_lgamma_t(h2 + 1)
    s0: B64 = cm_b64_lgamma_t(h1) +! cm_b64_lgamma_t(h2)
    l0: B64 = a.ed *! 0x1.62e42fefa38p-1 +! s2
    l1: B64 = a.ed *! 0x1.ef35793c76p-45
    l2: B64 = a.ed *! 0x1.cc01f97b57a08p-87
    u: CmF64GammaDD = cm_b64_gamma_sumdd(xh: l1, xl: l2, yh: s1, yl: s0)
    v: CmF64GammaDD = cm_b64_gamma_sumdd(xh: u.hi, xl: u.lo, yh: f.hi, yl: f.lo)
    b: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: l0, y: v.hi)
    b2: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: b.lo, y: v.lo)
    return CmF64GammaTD(hi: b.hi, mid: b2.hi, lo: b2.lo)

### lgamma(x) for x = xh + xl > 3.75 as a triple-double, from Stirling's asymptotic series.
### :param xh: The high part of the argument.
### :param xl: The low part of the argument.
### :returns: lgamma(`xh + xl`) as a triple-double.
secret routine cm_b64_lgamma_asym_accurate(xh: B64, xl: B64) -> CmF64GammaTD
    lg: CmF64GammaTD = cm_b64_lgamma_logd_accurate(xh)

    if xh >= 0x1p+120
        # log(xh + xl) = log(xh) + log(1 + xl/xh)
        # (x - 1/2) (log x - 1) + the series in 1/x^2, with x - 1/2 split exactly past 2^52
        # x >= 2^120: the series in 1/x is below the triple-double's precision
        wl: B64 = xl -! 0.5
        m0: B64 = lg.hi -! 1.0
        l0x: B64 = m0 *! xh
        l0xl: B64 = b64_mul_error(x: m0, y: xh, p: l0x)
        l1x: B64 = lg.mid *! xh
        l1xl: B64 = b64_mul_error(x: lg.mid, y: xh, p: l1x)
        l2x: B64 = lg.lo *! xh
        s0: CmF64GammaDD = cm_b64_gamma_sumdd(xh: l1x, xl: l2x, yh: l0xl, yl: l1xl)
        s1: CmF64GammaDD = cm_b64_gamma_sumdd(xh: s0.hi, xl: s0.lo, yh: m0 *! wl, yl: lg.mid *! wl)
        return CmF64GammaTD(hi: l0x, mid: s1.hi, lo: s1.lo)
    zh: B64 = B64.truediv_unchecked(1.0, xh)
    dz: B64 = xl *! zh
    zh_err: B64 = zh.mul_add_unchecked(a: -xh, b: 1.0) -! dz
    zl: B64 = zh_err *! zh
    xl0: Bool = xl != 0.0
    values2: (B64, B64, B64) = when
        xl0 =>
            dl: CmF64GammaDD = cm_b64_gamma_mulddd(x: xl, ch: zh,
                cl: zh.mul_add_unchecked(a: -xh, b: 1.0) *! zh)
            dl2: B64 = dl.lo -! dl.hi *! dl.hi /! 2.0
            s: CmF64GammaDD = cm_b64_gamma_sumdd(xh: lg.mid, xl: lg.lo, yh: dl.hi, yl: dl2)
            becomes (lg.hi, s.hi, s.lo)
        else => (lg.hi, lg.mid, lg.lo)
    l0, l1, l2 = values2
    xh_exp: U64 = xh.bits() >> 52
    big: Bool = xh_exp > 0x432
    wh: B64 = when
        big => xh
        else => xh -! 0.5
    wl: B64 = when
        big => xl -! 0.5
        else => xl
    m0: B64 = l0 -! 1.0
    l0x: B64 = m0 *! wh
    l0xl: B64 = b64_mul_error(x: m0, y: wh, p: l0x)
    l1x: B64 = l1 *! wh
    l1xl: B64 = b64_mul_error(x: l1, y: wh, p: l1x)
    l2x: B64 = l2 *! wh
    s0: CmF64GammaDD = cm_b64_gamma_sumdd(xh: l1x, xl: l2x, yh: l0xl, yl: l1xl)
    s1: CmF64GammaDD = cm_b64_gamma_sumdd(xh: s0.hi, xl: s0.lo, yh: m0 *! wl, yl: l1 *! wl)
    z2: CmF64GammaDD = cm_b64_gamma_muldd(xh: zh, xl: zl, ch: zh, cl: zl)
    values3: (U64, U64) = when
        xh >= 48.0 => (1822, 7)
        xh >= 14.5 => (1838, 11)
        else => (1862, 27)
    c, n = values3
    s2: CmF64GammaDD = cm_b64_gamma_sumdd(xh: s1.hi, xl: s1.lo, yh: cm_b64_lgamma_t(c),
        yl: cm_b64_lgamma_t(c + 1))
    f0: CmF64GammaDD = cm_b64_lgamma_polydd(x: z2, n, base: c + 2, l: 0.0)
    f: CmF64GammaDD = cm_b64_gamma_muldd(xh: zh, xl: zl, ch: f0.hi, cl: f0.lo)
    s3: CmF64GammaDD = cm_b64_gamma_sumdd(xh: s2.hi, xl: s2.lo, yh: f.hi, yl: f.lo)
    h: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: l0x, y: s3.hi)
    h2: CmF64GammaDD = cm_b64_gamma_fasttwosum(x: h.lo, y: s3.lo)
    return CmF64GammaTD(hi: h.hi, mid: h2.hi, lo: h2.lo)
