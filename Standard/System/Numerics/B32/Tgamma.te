# Tessera stdlib: the correctly rounded gamma function of B32
#
# Near zero gamma(x) = 1/x - euler_gamma + O(x). Positive integers give (x-1)!
# exactly. Otherwise gamma on [2.375, 3.375) (x reduced to x - 23/8 = i + d)
# from a degree-15 polynomial in d, shifted to x by the product of the
# i factors between them, all in B64. Hard-to-round inputs come from a table.
# Round to nearest only: overflow gives +inf, +-0 gives +-inf, the negative
# integers and -inf give NaN, and NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/tgamma/tgammaf.c via RazorForge's B32Tgamma.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/B32

### Inputs whose gamma is hard to round, as B32 bits.
secret preset CM_B32_TGAMMA_EXC_X: &Array[U32, 10] <- [0x27DE86A9, 0x27E05475, 0xB63BEFB3,
    0x3C7BB570, 0x41E886D1, 0xC067D177, 0xBD99DA31, 0xBF54C45A, 0x41EE77FE, 0x3F843A64]

### The correctly rounded results for those inputs, as f + df (B32 bits).
secret preset CM_B32_TGAMMA_EXC_F: &Array[U32, 10] <- [0x57134133, 0x57121211, 0xC8AE5B72,
    0x42810EC8, 0x709989B5, 0x3E7B4286, 0xC15F7F33, 0xC0D35A76, 0x7269B18E, 0x3F7B631C]
### The low-order corrections `df` for the inputs in {CM_B32_TGAMMA_EXC_X}, as B32 bits: `f + df` is the correctly rounded result.
secret preset CM_B32_TGAMMA_EXC_DF: &Array[U32, 10] <- [0x4A800000, 0x4A800000, 0x3C000000,
    0x36000000, 0x64000000, 0x31800000, 0xB4800000, 0x34000000, 0x99800000, 0x32800000]

### Γ(`me`), correctly rounded: ±inf at ±0, NaN at the negative integers and -inf.
### :returns: Γ(`me`).
routine B32.gamma_unchecked() -> Me
    tu: U32 = me.bits()
    ax: U32 = tu << 1
    z: B64 = me.to[B64]()
    fx: Me = me.floor()

    # NaN or +-inf
    if ax >= 0xFF000000
        infinite: Bool = ax == 0xFF000000
        when
            infinite and tu >> 31 == 1 => return Me.from_bits(0xFFC00000)
            infinite => return me
            else => return me +! me
    # |x| < 0x1p-18: gamma(x) = 1/x - euler_gamma + O(x)
    if ax < 0x6D000000
        c: B64 = B64.sub_unchecked(0x1.fa658c23b1578p-1, z *! 0x1.d0a118f324b63p-1)
        d: B64 = c *! z -! 0x1.2788cfc6fb619p-1
        f: B64 = B64.truediv_unchecked(1.0, z) +! d
        r: Me = f.to_unchecked[Me]()
        biased_bits: U64 = f.bits() +% 2
        if biased_bits & 0xFFFFFFF < 4
            return cm_b32_tgamma_exception(xb: tu, fallback: r)
        return r
    if me >= 0x1.18522p+5
        return Me.mul_unchecked(0x1p127, 0x1p127)
    # an integer: a pole (NaN) for the negative ones, (k-1)! for the positive ones
    if fx == me
        when
            me == 0.0 => return Me.truediv_unchecked(1.0, me)
            me < 0.0 => return Me.from_bits(0xFFC00000)
            else => nothing
        k: S64 = fx.to[S64]()
        until i >= k with i: S64 = 1, product: B64 = 1.0, factor: B64 = 1.0
            continue with i: i + 1, product: product *! factor, factor: factor +! 1.0
        then
            return product.to_unchecked[Me]()
    # x < -42, not an integer: |gamma(x)| < 2^-151 rounds to a signed zero
    if me < -42.0
        whole: S64 = fx.to[S64]()
        if whole & 1 == 0
            return Me.mul_unchecked(0x1p-127, 0x1p-127)
        return Me.mul_unchecked(0x1p-127, -0x1p-127)

    # gamma(23/8 + i + d) from a polynomial in d, shifted by the i factors between
    m: B64 = z -! 0x1.7p+1
    i: B64 = m.round_ties_even()
    step: B64 = B64.copysign(1.0, i)
    d: B64 = m -! i
    d2: B64 = d *! d
    d4: B64 = d2 *! d2
    d8: B64 = d4 *! d4
    a0: B64 = d *! 0x1.8f2754ddcf90dp+0 +! 0x1.c9a76be577123p+0
    a2: B64 = d *! 0x1.e1f42cf0ae4a1p-2 +! 0x1.0d1191949419bp+0
    a4: B64 = d *! 0x1.e1f2b30cd907bp-5 +! 0x1.82b358a3ab638p-3
    a6: B64 = d *! 0x1.1522c9f3cd012p-8 +! 0x1.240f6d4071bd8p-6
    a8: B64 = d *! 0x1.9808a8b96c37ep-13 +! 0x1.1fd0051a0525bp-10
    a10: B64 = d *! 0x1.49c85a7e1fd04p-18 +! 0x1.b3f78e01152b5p-15
    a12: B64 = d *! -0x1.368f0b7ed9e36p-23 +! 0x1.471ca49184475p-19
    a14: B64 = d *! -0x1.a69ed2042842cp-25 +! 0x1.882222f9049efp-23
    b0: B64 = a0 +! d2 *! a2
    b4: B64 = a4 +! d2 *! a6
    b8: B64 = a8 +! d2 *! a10
    b12: B64 = a12 +! d2 *! a14
    lo: B64 = b0 +! d4 *! b4
    hi: B64 = b8 +! d4 *! b12
    f: B64 = lo +! d8 *! hi
    jm: S64 = i.abs().to[S64]()
    w: B64 = when
        jm == 0 => 1.0
        else => cm_b32_tgamma_shift(z, step, count: jm)

    # for x below the polynomial's interval the product divides
    below: Bool = i <= -0.5
    wv: B64 = when
        below => B64.truediv_unchecked(1.0, w)
        else => w
    g: B64 = f *! wv
    r: Me = g.to_unchecked[Me]()
    biased_bits: U64 = g.bits() +% 2
    if biased_bits & 0xFFFFFFF < 8
        return cm_b32_tgamma_exception(xb: tu, fallback: r)
    return r

### The product of the `count` factors between x and the polynomial's interval [2.375, 3.375): the first is
### x - 1/2 - step/2, and each next one is a step further.
### :param z: x, widened to B64.
### :param step: 1 when x lies above the interval, -1 when below.
### :param count: The number of factors, at least 1.
### :returns: The product of the factors, rounded at each multiplication.
secret routine cm_b32_tgamma_shift(z: B64, step: B64, count: S64) -> B64
    # the first factor: x - 1/2 - step/2
    first: B64 = z -! (step *! 0.5 +! 0.5)
    until j == 0 with factor: B64 = first, product: B64 = first, j: S64 = count - 1
        continue with factor: factor -! step, product: product *! (factor -! step), j: j - 1
    then
        return product

### The tabulated correctly rounded gamma for a hard-to-round input with B32 bits xb, or fallback.
### :param xb: The B32 bits of the input.
### :param fallback: The result for an input that is not in the table.
### :returns: The tabulated value for a listed `xb`, else `fallback`.
secret routine cm_b32_tgamma_exception(xb: U32, fallback: B32) -> B32
    each k: U64 in 0 til 10
        if CM_B32_TGAMMA_EXC_X.getitem(k) == xb
            f: B32 = B32.from_bits(CM_B32_TGAMMA_EXC_F.getitem(k))
            df: B32 = B32.from_bits(CM_B32_TGAMMA_EXC_DF.getitem(k))
            return f +! df
        continue
    then
        return fallback
