# Tessera stdlib: the correctly rounded cube root of B32
#
# x = 2^(3 et + it) z with 1 <= z < 2: cbrt(z) from a rational approximation
# in B64, scaled by 2^(it/3) 2^et. When the result sits too close to a
# rounding boundary, one Newton step refines it, and an exact cube root has
# its rounding noise cleared. Round to nearest only: ±0, ±inf and NaN map to
# themselves (NaN comes back quiet).
#
# Ported from CORE-MATH, src/binary32/cbrt/cbrtf.c via RazorForge's B32Cbrt.rf.
# Copyright (c) 2023 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/B32

### The cube root of `me`, correctly rounded.
### :returns: The cube root.
routine B32.cbrt() -> Me
    u: U32 = me.bits()
    sgn: U64 = (u >> 31).to[U64]()
    au: U32 = u << 1
    e: S64 = (au >> 24).to[S64]()

    normal: Bool = au >= 0x01000000 and au < 0xFF000000
    values2: (U32, S64) = when
        normal => (au, e)
        else =>
            # ±0, subnormals, ±inf and NaN
            special: Bool = au >= 0xFF000000
            when
                special => return me +! me
                au == 0 => return me
                else =>
                    # x + x also quiets a signaling NaN
                    # normalize the mantissa
                    nz: U32 = au.leading_zeros() - 7
                    becomes (au << nz, e - (nz.to[S64]() - 1))
    au_norm, e_norm = values2

    # cbrt(x) = cbrt(z) scale with 1 <= z < 2 and scale = ±2^(it/3) 2^(et-342)
    mant: U64 = (au_norm & 0x00FFFFFF).to[U64]()
    z: B64 = B64.from_bits((mant << 28) | U64.shift_left(0x3FF, 52))
    eb: S64 = e_norm + 899
    et: S64 = eb.div_trunc(3)
    it: S64 = eb.mod_trunc(3)
    isc0: U64 = cm_cbrt_escale(it).bits()
    scale_exponent: U64 = (et - 342).to_wrap[U64]()
    isc1: U64 = isc0 +% (scale_exponent << 52)
    scale: B64 = B64.from_bits(isc1 | (sgn << 63))
    r0: B64 = B64.truediv_unchecked(-0x1.9931c6c2d19d1p-6, z)
    z2: B64 = z *! z
    z4: B64 = z2 *! z2
    p0: B64 = z *! 0x1.67ad8ee258d1ap-1 +! 0x1.2319d352ea5d5p-1
    p1: B64 = z *! 0x1.b6388fc510a75p-3 +! -0x1.9342edf9cbad9p-2
    p2: B64 = z *! 0x1.7b096936192c4p-6 +! -0x1.6002455599e2fp-4
    p3: B64 = z *! 0x1.169ef81d6c34ep-12 +! -0x1.e5577187e8bf8p-9
    lo: B64 = z2 *! p1 +! p0
    hi: B64 = z2 *! p3 +! p2
    p03: B64 = z4 *! hi +! lo
    f: B64 = p03 +! r0
    r: B64 = f *! scale
    ub: Me = r.to_unchecked[Me]()
    lb: Me = (r -! scale *! 0x1.85d4f3f7556ecp-30).to_unchecked[Me]()
    if ub == lb
        return ub
    # one Newton step when the first approximation is too close to a rounding boundary
    f0: B64 = f
    f0_cubed: B64 = f0 *! f0 *! f0
    h: B64 = f0_cubed -! z
    step: B64 = f0 *! r0 *! -0x1.ab16ec65d138fp+3
    f2: B64 = f0 -! step *! h
    r2: B64 = f2 *! scale
    bits: U64 = r2.bits()
    m0: S64 = (bits << 19).to_wrap[S64]()
    m1: S64 = m0 >> 63
    if m0 ^ m1 < S64.shift_left(1, 31)
        # an exact cube root: clear the rounding noise below the B32 precision
        cleared: U64 = bits +% U64.shift_left(1, 31) & 0xFFFFFFFF00000000
        return B64.from_bits(cleared).to_unchecked[Me]()
    return r2.to_unchecked[Me]()
