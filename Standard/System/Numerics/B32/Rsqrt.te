# Tessera stdlib: the correctly rounded reciprocal square root 1 / sqrt(x) of B32
#
# sqrt(x) / x in B64: the B64 square root and quotient are each rounded once, and the B64 result rounds to the
# correct B32 for every x. Two families of x, 0x1.7bf15p-128 and 0x1.ab6f7ap-125 times 2^(2k) with k >= 0, take a
# factor just below 1, which the original needs for rounding upward and which leaves round to nearest correct.
# Round to nearest only: +0 gives +inf, -0 gives -inf, +inf gives +0, a negative x gives NaN, NaN
# comes back quiet.
#
# Ported from CORE-MATH, src/binary32/rsqrt/rsqrtf.c.
# Copyright (c) 2022-2026 Alexei Sibidanov and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/B32

### 1 / sqrt(`me`), correctly rounded (to nearest, ties to even). +0 gives +inf, -0 gives -inf, +inf gives +0, a
### value below zero (-inf included) gives NaN, and a NaN comes back quiet.
### :returns: The reciprocal square root of `me`.
routine B32.rsqrt_unchecked() -> Me
    u: U32 = me.bits()

    # ±0, x < 0, +inf or NaN
    if u >= 0x7F800000 or u == 0
        if u << 1 == 0
            one: Me = 1.0
            return one /! me
        if u >> 31 == 1
            if (u & 0x7FFFFFFF) > 0x7F800000
                return me +! me
            return nan
        if u << 9 == 0
            return 0.0
        return me +! me
    xd: B64 = me.to[B64]()
    sq: B64 = xd.sqrt_unchecked()
    m: U32 = u << 8
    hard: Bool = u == 0x002F7E2A or m == 0xBDF8A800 or m == 0x55B7BD00
    c: B64 = when
        hard => 0x1.ffffffffffffep-1
        else => 1.0
    r: B64 = sq *! (c /! xd)
    return r.to_unchecked[Me]()
