# Tessera stdlib: the correctly rounded cosine of B32
#
# x * 16/pi = q + z: sin(q pi/16) and cos(q pi/16) from a table, sin(z pi/16) and cos(z pi/16) from
# polynomials, all in B64. The few arguments the fast path can't round come from a small table of exact
# results. Round to nearest only: infinities give NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/cos/cosf.c via RazorForge's B32Cos.rf.
# Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/B32

### The cosine of `me` (in radians), correctly rounded (to nearest). Infinities give NaN and NaN comes back quiet.
### :returns: cos(`me`).
routine B32.cos() -> Me
    ax: U32 = me.bits() << 1

    if ax > 0x99000000 or ax < 0x74000000
        # |x| > 0x1p+26, x is NaN, or |x| < 0x1p-11, where cos(x) rounds like 1 - x^2/2
        if ax < 0x74000000
            return me.mul_add_unchecked(a: -me, b: 2.0) *! 0.5
        return cm_b32_cos_big(me)
    z0: B64 = me.to[B64]()
    small: Bool = ax < 0x82A41896
    red: CmF32TrigReduced = when
        ax == 0x812D97C8 => return cm_b32_cos_database(x: me, r: 0.0)
        small => cm_b32_trig_reduce_small(z0)
        else => cm_b32_trig_reduce_medium(z0)
    z: B64 = red.z
    ia: U64 = red.q
    z2: B64 = z *! z
    z4: B64 = z2 *! z2
    aa: B64 = cm_b32_trig_poly_a(z2, z4)
    bb: B64 = cm_b32_trig_poly_b(z2, z4)
    c0: B64 = cm_b32_trig_sin_tb(ia +% 8)
    s0: B64 = cm_b32_trig_sin_tb(ia +% 16)
    head: B64 = aa *! (z *! s0) +! c0
    r: B64 = head -! bb *! (z2 *! c0)
    return r.to_unchecked[Me]()

### The cosine of the arguments whose fast path isn't correctly rounded, as rh + rl. Any other x gives r.
### :param x: The argument.
### :param r: The fast path's B64 result.
### :returns: The tabulated cosine for a listed `x`, else `r` rounded to B32.
secret routine cm_b32_cos_database(x: B32, r: B64) -> B32
    ax: U32 = x.bits() & 0x7FFFFFFF
    when ax
        0x4096CBE4 => return B32.add_unchecked(0x1.99bc5cp-27, -0x1p-52)
        0x5922AA80 => return B32.add_unchecked(0x1.115d7ep-1, -0x1p-26)
        0x5AA4542C => return B32.add_unchecked(0x1.f48148p-2, 0x1p-27)
        0x5F18B878 => return B32.add_unchecked(0x1.fe2976p-1, 0x1p-26)
        0x6115CB11 => return B32.add_unchecked(0x1.f0285ep-1, -0x1p-26)
        else => return r.to_unchecked[B32]()

### The cosine for |x| > 2^26, infinities and NaN.
### :param x: The argument.
### :returns: cos(`x`), NaN for an infinity, and a NaN `x` quieted.
secret routine cm_b32_cos_big(x: B32) -> B32
    t: U32 = x.bits()

    if t << 1 >= 0xFF000000
        # close to a rounding boundary: only a few known arguments
        # NaN comes back quiet with its sign and payload, an infinity gives a NaN
        if t << 9 != 0
            return x +! x
        return B32.from_bits(0xFFC00000)
    red: CmF32TrigReduced = cm_b32_trig_reduce_big(u: t, bias: 147)
    z: B64 = red.z
    ia: U64 = red.q
    z2: B64 = z *! z
    z4: B64 = z2 *! z2
    aa: B64 = cm_b32_trig_poly_a(z2, z4)
    bb: B64 = cm_b32_trig_poly_b(z2, z4)
    s0: B64 = cm_b32_trig_sin_tb(ia +% 16)
    c0: B64 = cm_b32_trig_sin_tb(ia +% 8)
    slope: B64 = aa *! s0 -! bb *! (z *! c0)
    r: B64 = slope *! z +! c0
    biased_bits: U64 = r.bits() +% 6
    tail: U64 = biased_bits & 0xFFFFFFF
    if tail <= 12
        return cm_b32_cos_database(x, r)
    return r.to_unchecked[B32]()
