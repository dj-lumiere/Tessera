# Tessera stdlib: the correctly rounded base-2 exponential 2^x of B32
#
# x = k/64 + h: 2^(k/64) from a table, 2^h from a polynomial, all in B64. A
# second, longer polynomial settles the cases the first can't round, and
# integers 1 <= |x| < 2^9 give exact powers of two directly.
# Round to nearest only: overflow gives +inf, underflow a correctly rounded
# subnormal or +0, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary32/exp2/exp2f.c via RazorForge's B32Exp2.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/B32

### 2^`me`, correctly rounded (to nearest). Overflow gives +inf, underflow a correctly rounded subnormal or +0, and
### NaN comes back quiet.
### :returns: 2^`me`.
routine B32.exp2_unchecked() -> Me
    tu: U32 = me.bits()
    ux: U32 = tu << 1

    if tu & 0xFFFF == 0
        # x may be an integer: look at its exponent, 2^k <= |x| < 2^(k+1)
        e: U32 = (tu >> 23) & 0xFF
        # 0 <= k < 9
        if 127 <= e <= 135
            k: U32 = e - 127
            if tu << k + 9 == 0
                # x is an integer with 1 <= |x| < 2^9: the result is an exact power of two (or a subnormal)
                significand: U32 = (tu & 0x7FFFFF) | 0x800000
                mant: U64 = significand.to[U64]()
                magnitude: S64 = (mant >> U32.sub(23, k).to[U64]()).to[S64]()
                negative: Bool = tu >> 31 == 1
                signed: S64 = when
                    negative => -magnitude
                    else => magnitude
                m: S64 = signed + 127
                normal: Bool = 1 <= m <= 254
                when
                    normal => return Me.from_bits(m.to_wrap[U32]() << 23)
                    -22 <= m <= 0 => return Me.from_bits(U32.shift_left(1, (m + 22).to_wrap[U32]()))
                    else => nothing
    if ux >= 0x86000000 or ux < 0x65000000
        # |x| >= 128, x is NaN, or |x| < 0x1p-26
        tiny: Bool = ux < 0x65000000
        # -149 < x <= -128
        when
            tiny => return me +! 1.0
            tu >= 0xC3000000 and tu < 0xC3150000 => nothing
            else =>
                # infinities, NaN, x <= -149 (underflow) or x >= 128 (overflow)
                special: Bool = ux >= 0xFF000000
                is_nan: Bool = ux > 0xFF000000
                negative: Bool = tu >> 31 == 1
                when
                    is_nan => return me +! me
                    special =>
                        if negative
                            return 0.0
                        return inf
                    tu >= 0xC3150000 =>
                        z: B64 = me.to[B64]()
                        scaled: B64 = (z +! 149.0) *! 0x1p-150
                        y: B64 = scaled +! 0x1p-149
                        clamped: B64 = y.max(0x1p-151)
                        return clamped.to_unchecked[Me]()
                    else => return inf
    xd: B64 = me.to[B64]()
    h: B64 = xd -! (xd +! 0x1.8p+46 -! 0x1.8p+46)
    h2: B64 = h *! h
    u: U32 = (me +! 0x1.8p+17).bits()  # the low bits are round(64 x)
    tb: U64 = CM_B32_EXP_TB.getitem((u & 0x3F).to[U64]())
    scale_exponent: U64 = (u >> 6).to[U64]()
    sv: B64 = B64.from_bits(tb +% (scale_exponent << 52))  # 2^(round(64 x) / 64)
    p01: B64 = h *! 0x1.62e42fef4c4e7p-1 +! 1.0
    p23: B64 = h *! 0x1.c6b19384ecd93p-5 +! 0x1.ebfd1b232f475p-3
    r: B64 = sv *! (h2 *! p23 +! p01)
    ub: Me = r.to_unchecked[Me]()
    lb: Me = (r -! r *! 0x1.3d8p-33).to_unchecked[Me]()
    if ub == lb
        return ub
    # The fast path can't decide the rounding: three hard cases, then a longer polynomial.
    near: Bool = ux <= 0x79E7526E
    case1: Bool = near and tu == 0x3B429D37
    case2: Bool = near and tu == 0xBCF3A937
    when
        case1 => return Me.sub_unchecked(0x1.00870ap+0, 0x1p-25)
        case2 => return Me.sub_unchecked(0x1.f58d62p-1, 0x1p-26)
        near and tu == 0xB8D3D026 => return Me.add_unchecked(0x1.fff6d2p-1, 0x1p-26)
        else =>
            c01: B64 = h *! 0x1.ebfbdff82c58fp-3 +! 0x1.62e42fefa39efp-1
            c23: B64 = h *! 0x1.3b2ab6fb92e5ep-7 +! 0x1.c6b08d702e0edp-5
            c45: B64 = h *! 0x1.430976b8ce6efp-13 +! 0x1.5d886e6d54203p-10
            svh: B64 = sv *! h
            r2: B64 = svh *! (h2 *! (h2 *! c45 +! c23) +! c01) +! sv
            return r2.to_unchecked[Me]()
