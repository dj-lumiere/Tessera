# Tessera stdlib: the correctly rounded three-leg Euclidean norm sqrt(x^2 + y^2 + z^2) of B32
#
# The legs widen exactly to B64, where each square is exact and the sum and square root lie within 2^-52 of the true
# root relative, so a few B64 ulps. Rounding that to B32 is correct unless the root lies within 16 B64 ulps of a B32
# midpoint, or the result is subnormal in B32: then the exact path of B128/Hypot3.te decides. Round to nearest
# only.

module Standard/System/Numerics/B32

### sqrt(`x`^2 + `y`^2 + `z`^2) without intermediate overflow or underflow, correctly rounded to nearest (ties to
### even). The signs don't matter and the order of the legs doesn't either. A signaling NaN leg gives a NaN, and
### otherwise an infinite leg gives +inf, even when another leg is a quiet NaN. A NaN result is the first NaN leg in
### the order `x`, `y`, `z`, quieted, its sign kept when some leg is a signaling NaN and cleared otherwise, as the
### two-leg hypot gives it. A result past the largest finite value gives +inf.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The length of the vector (`x`, `y`, `z`).
routine hypot_unchecked(x: B32, y: B32, z: B32) -> B32
    tx: U32 = x.bits() & 0x7FFFFFFF
    ty: U32 = y.bits() & 0x7FFFFFFF
    tz: U32 = z.bits() & 0x7FFFFFFF

    if tx >= 0x7F800000 or ty >= 0x7F800000 or tz >= 0x7F800000
        return cm_b32_hypot3_special(x, y, z)
    xd: B64 = x.to[B64]()
    yd: B64 = y.to[B64]()
    zd: B64 = z.to[B64]()
    sum: B64 = xd *! xd +! yd *! yd +! zd *! zd
    r: B64 = sum.sqrt_unchecked()
    rb: U64 = r.bits()
    # The low 29 bits of r are those below B32's last bit: a midpoint has only the top one of them set.
    near: Bool = (rb +% 16 -% 0x10000000) & 0x1FFFFFFF <= 32
    tiny: Bool = rb < 0x3810000000000000  # below B32's smallest normal value
    if near or tiny
        return cm_b32_hypot3_exact(x: tx, y: ty, z: tz)
    return r.to_unchecked[B32]()

### hypot of three legs where one of them is infinite or NaN, as the two-leg hypot treats them.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The first NaN leg quieted with its sign kept for a signaling NaN leg, else +inf for an infinite leg, else
###     the first NaN leg quieted with its sign cleared.
secret routine cm_b32_hypot3_special(x: B32, y: B32, z: B32) -> B32
    signaling: Bool = cm_b32_is_signaling(x) or cm_b32_is_signaling(y) or cm_b32_is_signaling(z)
    infinite: Bool = x.is_infinite() or y.is_infinite() or z.is_infinite()
    when
        signaling => return cm_b32_hypot_quiet_nan(x, y: cm_b32_hypot_quiet_nan(x: y, y: z))
        infinite => return inf
        else =>
            rest: B32 = cm_b32_hypot_quiet_nan(x: y.abs(), y: z.abs())
            return cm_b32_hypot_quiet_nan(x: x.abs(), y: rest)

### Whether `x` is a signaling NaN: a NaN with the quiet bit (the top fraction bit) clear.
### :param x: The value.
### :returns: True for a signaling NaN.
secret routine cm_b32_is_signaling(x: B32) -> Bool
    quiet: Bool = x.bits() & 0x00400000 != 0
    return x.is_nan() and not quiet

### The exact path: the three finite legs' bits (sign clear) through the shared three-leg hypot.
### :param x: The first leg's bits.
### :param y: The second leg's bits.
### :param z: The third leg's bits.
### :returns: The correctly rounded hypot.
secret routine cm_b32_hypot3_exact(x: U32, y: U32, z: U32) -> B32
    bits: U128 = hypot3_exact_bits(x: x.to[U128](), y: y.to[U128](), z: z.to[U128](),
        format: Hypot3Format(precision: 24, emin: -126))
    return B32.from_bits(bits.to[U32]())
