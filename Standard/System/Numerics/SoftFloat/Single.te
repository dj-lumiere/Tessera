# Tessera stdlib: B32 arithmetic in software
#
# The B32 operations LLVM calls a routine for on a target without a floating-point unit (Exports.te and Aeabi.te
# export them under those names), on the bits, with integer operations only. They round to nearest, ties to even,
# handle subnormals, signed zeros, and infinities, and treat NaN as compiler-rt does: a NaN operand comes back
# quieted (its payload and sign kept, the first operand's when both are NaN), and an invalid operation gives the
# positive quiet NaN 0x7FC00000. Each routine is callable on any target, so a hosted test can check it against the
# hardware.

module Standard/System/Numerics/SoftFloat

secret preset B32_SIGN: U32 = 0x80000000
secret preset B32_MAGNITUDE: U32 = 0x7FFFFFFF
secret preset B32_INFINITY: U32 = 0x7F800000
secret preset B32_QUIET: U32 = 0x00400000
secret preset B32_NAN: U32 = 0x7FC00000
secret preset B32_IMPLICIT: U32 = 0x00800000
secret preset B32_ONE: U32 = 0x3F800000

# -- addition ------------------------------------------------------------------

### B32 addition on the bits, rounded to nearest (ties to even): compiler-rt's `__addsf3`.
### :param a: The first addend's bits.
### :param b: The second addend's bits.
### :returns: The bits of `a + b`: a NaN operand comes back quieted, `inf + -inf` is NaN, and a sum of two zeros is
### -0 only when both are -0 (an exact zero sum of nonzero values is +0).
@no_builtins
routine soft_b32_add(a: U32, b: U32) -> U32
    local a_size: U32 = a & B32_MAGNITUDE
    local b_size: U32 = b & B32_MAGNITUDE

    when
        a_size > B32_INFINITY => return a | B32_QUIET
        b_size > B32_INFINITY => return b | B32_QUIET
        a_size == B32_INFINITY =>
            # inf + inf keeps the sign, and inf - inf is NaN
            if a ^ b == B32_SIGN
                return B32_NAN
            return a
        b_size == B32_INFINITY => return b
        a_size == 0 =>
            if b_size == 0
                return a & b
            return b
        b_size == 0 => return a
        else =>
            # the larger magnitude first, so the result takes its sign
            swap: Bool = b_size > a_size
            larger: U32 = when
                swap => b
                else => a
            smaller: U32 = when
                swap => a
                else => b
            # each significand gets three bits below it (half, and the rest), and the smaller one shifts right to the larger
            # one's exponent with the bits it loses folded into a sticky bit
            x_parts: SoftParts32 = soft_unpack(magnitude: larger & B32_MAGNITUDE, sig_bits: 23)
            y_parts: SoftParts32 = soft_unpack(magnitude: smaller & B32_MAGNITUDE, sig_bits: 23)
            x_sig: U32 = x_parts.sig << 3
            y_sig: U32 = y_parts.sig << 3
            apart: U32 = (x_parts.exponent - y_parts.exponent).to[U32]()
            aligned: U32 = soft_shr_sticky(x: y_sig, shift: apart)
            sign: U32 = larger & B32_SIGN
            if larger ^ smaller < B32_SIGN
                return soft_round_pack(sign, exponent: x_parts.exponent, m: x_sig + aligned,
                    format: B32.FORMAT.peek())
            # the larger magnitude came first, so the difference isn't negative. An exact zero is +0
            sig: U32 = x_sig - aligned
            if sig == 0
                return 0
            return soft_round_pack(sign, exponent: x_parts.exponent, m: sig,
                format: B32.FORMAT.peek())

### B32 subtraction on the bits: `a + (-b)`, as compiler-rt's `__subsf3` computes it (so a NaN `b` comes back with its
### sign flipped).
### :param a: The minuend's bits.
### :param b: The subtrahend's bits.
### :returns: The bits of `a - b`.
@no_builtins
routine soft_b32_sub(a: U32, b: U32) -> U32
    r: U32 = soft_b32_add(a, b: b ^ B32_SIGN)
    return r

# -- multiplication ------------------------------------------------------------

### B32 multiplication on the bits, rounded to nearest (ties to even): compiler-rt's `__mulsf3`.
### :param a: The first factor's bits.
### :param b: The second factor's bits.
### :returns: The bits of `a * b`: a NaN operand comes back quieted, `inf * 0` is NaN, and the sign is the XOR of the
### signs.
@no_builtins
routine soft_b32_mul(a: U32, b: U32) -> U32
    local sign: U32 = (a ^ b) & B32_SIGN
    local a_size: U32 = a & B32_MAGNITUDE
    local b_size: U32 = b & B32_MAGNITUDE

    when
        a_size > B32_INFINITY => return a | B32_QUIET
        b_size > B32_INFINITY => return b | B32_QUIET
        a_size == B32_INFINITY =>
            # infinity times zero is NaN, times anything else infinity
            if b_size == 0
                return B32_NAN
            return sign | B32_INFINITY
        b_size == B32_INFINITY =>
            if a_size == 0
                return B32_NAN
            return sign | B32_INFINITY
        a_size == 0 => return sign
        b_size == 0 => return sign
        else =>
            # the 48-bit product of two 24-bit significands, its leading bit at 46 or 47. Shifted down by 21 with a sticky
            # bit, it is a significand for an exponent of the two exponents' sum minus 126
            x: SoftParts32 = soft_unpack(magnitude: a_size, sig_bits: 23)
            y: SoftParts32 = soft_unpack(magnitude: b_size, sig_bits: 23)
            product: U64 = x.sig.to[U64]() *% y.sig.to[U64]()
            sig: U64 = soft_shr_sticky(x: product, shift: 21)
            sum: S32 = x.exponent + y.exponent
            r: U32 = soft_round_pack(sign, exponent: sum - 126, m: sig.to_wrap[U32](),
                format: B32.FORMAT.peek())
            return r

# -- division ------------------------------------------------------------------

### B32 division on the bits, rounded to nearest (ties to even): compiler-rt's `__divsf3`, computed by long division.
### :param a: The dividend's bits.
### :param b: The divisor's bits.
### :returns: The bits of `a / b`: a NaN operand comes back quieted, `0 / 0` and `inf / inf` are NaN, and a nonzero
### value over zero is a signed infinity.
@no_builtins
routine soft_b32_div(a: U32, b: U32) -> U32
    local sign: U32 = (a ^ b) & B32_SIGN
    local a_size: U32 = a & B32_MAGNITUDE
    local b_size: U32 = b & B32_MAGNITUDE
    local rem: @U32 <- .hollow()
    local quotient: @U32 <- .hollow()

    when
        a_size > B32_INFINITY => return a | B32_QUIET
        b_size > B32_INFINITY => return b | B32_QUIET
        a_size == B32_INFINITY =>
            if b_size == B32_INFINITY
                return B32_NAN
            return sign | B32_INFINITY
        b_size == B32_INFINITY => return sign
        a_size == 0 =>
            if b_size == 0
                return B32_NAN
            return sign
        b_size == 0 => return sign | B32_INFINITY
        else =>
            # a dividend below the divisor doubles, so the quotient is in [1, 2)
            x: SoftParts32 = soft_unpack(magnitude: a_size, sig_bits: 23)
            y: SoftParts32 = soft_unpack(magnitude: b_size, sig_bits: 23)
            apart: S32 = x.exponent - y.exponent
            below: Bool = x.sig < y.sig
            num: U32 = when
                below => x.sig << 1
                else => x.sig
            exponent: S32 = when
                below => apart + 126
                else => apart + 127
            num.poke_into(rem)
            0.poke_into(quotient)
            # 26 quotient bits, one a step: the 24 the result keeps and two below them, then the remainder's sticky bit
            den: U32 = y.sig
            until step == 26 with step: U32 = 0
                fits: Bool = rem.peek() >= den
                left: U32 = when
                    fits => rem.peek() -% den
                    else => rem.peek()
                q_bit: U32 = fits.to[U32]()
                next: U32 = (quotient.peek() << 1) | q_bit
                next_quotient: U32 = next
                next_rem: U32 = left << 1
                next_rem.poke_into(rem)
                next_quotient.poke_into(quotient)
                continue with step: step + 1
            then
                sticky: U32 = (rem.peek() != 0).to[U32]()
                sig: U32 = (quotient.peek() << 1) | sticky
                r: U32 = soft_round_pack(sign, exponent, m: sig, format: B32.FORMAT.peek())
                return r

# -- square root and remainder ---------------------------------------------------

### The B32 square root on the bits, correctly rounded: C's `sqrtf`, which LLVM calls for `B32.sqrt` on a target
### without a floating-point unit. The root comes from a bit-by-bit integer square root.
### :param a: The radicand's bits.
### :returns: The bits of sqrt(a): the same zero for ±0, +inf for +inf, a quieted NaN for NaN, and NaN (0x7FC00000)
### for any other negative value.
@no_builtins
routine soft_b32_sqrt(a: U32) -> U32
    local size: U32 = a & B32_MAGNITUDE
    local rem: @U64 <- .hollow()
    local res: @U64 <- .hollow()

    when
        size > B32_INFINITY => return a | B32_QUIET
        size == 0 => return a
        a >= B32_SIGN => return B32_NAN
        size == B32_INFINITY => return a
        else =>
            # an odd unbiased exponent moves one bit into the significand, so the root's exponent is a whole half. The
            # significand scaled by 2^27 has a 26-bit root, the 24 kept bits and two below them
            parts: SoftParts32 = soft_unpack(magnitude: size, sig_bits: 23)
            unbiased: S32 = parts.exponent - 127
            odd: Bool = unbiased & 1 == 1
            sig: U32 = when
                odd => parts.sig << 1
                else => parts.sig
            even: S32 = unbiased - odd.to[S32]()
            radicand: U64 = sig.to[U64]() << 27
            radicand.poke_into(rem)
            0.poke_into(res)

            half: S32 = even >> 1

            until bit == 0 with bit: U64 = 0x4000000000000
                trial: U64 = res.peek() + bit
                fits: Bool = rem.peek() >= trial
                left: U64 = when
                    fits => rem.peek() -% trial
                    else => rem.peek()
                shifted: U64 = res.peek() >> 1
                next: U64 = when
                    fits => shifted + bit
                    else => shifted
                next_res: U64 = next
                next_rem: U64 = left
                next_rem.poke_into(rem)
                next_res.poke_into(res)
                continue with bit: bit >> 2
            then
                sticky: U64 = (rem.peek() != 0).to[U64]()
                sig2: U64 = (res.peek() << 1) | sticky
                r: U32 = soft_round_pack(sign: 0, exponent: half + 127, m: sig2.to_wrap[U32](),
                    format: B32.FORMAT.peek())
                return r

### The B32 remainder on the bits, exact: C's `fmodf`, which LLVM calls for `frem`. The result has the sign of `a`
### and a magnitude below `|b|`.
### :param a: The dividend's bits.
### :param b: The divisor's bits.
### :returns: The bits of `fmod(a, b)`: a NaN operand comes back quieted, NaN for an infinite `a` or a zero `b`, `a`
### itself when `|a| < |b|`, and a zero with `a`'s sign when the division is exact.
@no_builtins
routine soft_b32_mod(a: U32, b: U32) -> U32
    local sign: U32 = a & B32_SIGN
    local a_size: U32 = a & B32_MAGNITUDE
    local b_size: U32 = b & B32_MAGNITUDE

    when
        a_size > B32_INFINITY => return a | B32_QUIET
        b_size > B32_INFINITY => return b | B32_QUIET
        a_size == B32_INFINITY => return B32_NAN
        b_size == 0 => return B32_NAN
        a_size < b_size => return a
        a_size == b_size => return sign
        else =>
            # long division one exponent step at a time, keeping only the remainder (below 2 × den throughout)
            x: SoftParts32 = soft_unpack(magnitude: a_size, sig_bits: 23)
            y: SoftParts32 = soft_unpack(magnitude: b_size, sig_bits: 23)

            den: U32 = y.sig

            den_exponent: S32 = y.exponent

            loop with rem: U32 = x.sig, exponent: S32 = x.exponent
                fits: Bool = rem >= den
                left: U32 = when
                    fits => rem -% den
                    else => rem
                exact: Bool = left == 0
                when
                    exact => return sign
                    exponent == den_exponent =>
                        # the remainder is exact and fits the format, so the packing doesn't round
                        r: U32 = soft_round_pack(sign, exponent, m: left << 3,
                            format: B32.FORMAT.peek())
                        return r
                    else => continue with rem: left << 1, exponent: exponent - 1

### B32 raised to an integer power by repeated squaring: compiler-rt's `__powisf2`, with the same multiplications in
### the same order (so it rounds at each step, as compiler-rt does, rather than once).
### :param a: The base's bits.
### :param n: The exponent. A negative one takes the reciprocal of the positive power at the end.
### :returns: The bits of the result.
@no_builtins
routine soft_b32_powi(a: U32, n: S32) -> U32
    local base: @U32 <- a
    local result: @U32 <- B32_ONE

    loop with left: U32 = n.abs_diff(0)
        if left & 1 == 1
            soft_b32_mul(a: result.peek(), b: base.peek()).poke_into(result)
        rest: U32 = left >> 1
        if rest == 0
            break
        soft_b32_mul(a: base.peek(), b: base.peek()).poke_into(base)
        continue with left: rest
    if n < 0
        return soft_b32_div(a: B32_ONE, b: result.peek())
    return result.peek()

# -- comparison ----------------------------------------------------------------

### Orders two B32 values as compiler-rt's `__lesf2` (and its aliases `__eqsf2`, `__ltsf2`, `__nesf2`) does.
### :param a: The first operand's bits.
### :param b: The second operand's bits.
### :returns: -1 when `a < b`, 0 when they are equal (+0 equals -0), 1 when `a > b` or either is NaN.
@no_builtins
routine soft_b32_le(a: U32, b: U32) -> S32
    if soft_b32_unordered(a, b)
        return 1
    return soft_b32_order(a, b)

### Orders two B32 values as compiler-rt's `__gesf2` (and its alias `__gtsf2`) does.
### :param a: The first operand's bits.
### :param b: The second operand's bits.
### :returns: -1 when `a < b` or either is NaN, 0 when they are equal (+0 equals -0), 1 when `a > b`.
@no_builtins
routine soft_b32_ge(a: U32, b: U32) -> S32
    if soft_b32_unordered(a, b)
        return -1
    return soft_b32_order(a, b)

### Whether either B32 is NaN: compiler-rt's `__unordsf2`.
### :param a: The first operand's bits.
### :param b: The second operand's bits.
### :returns: True when `a` or `b` is NaN.
@no_builtins
routine soft_b32_unordered(a: U32, b: U32) -> Bool
    a_nan: Bool = a & B32_MAGNITUDE > B32_INFINITY
    b_nan: Bool = b & B32_MAGNITUDE > B32_INFINITY
    return a_nan or b_nan

### Two numbers (not NaN) in order: equal zeros first, then as sign-magnitude integers, whose order flips when both
### are negative.
### :param a: The first operand's bits.
### :param b: The second operand's bits.
### :returns: -1 when `a < b`, 0 when they are equal (+0 equals -0), 1 when `a > b`.
secret routine soft_b32_order(a: U32, b: U32) -> S32
    both: U32 = a | b
    if both & B32_MAGNITUDE == 0
        return 0
    x: S32 = a.to_wrap[S32]()
    y: S32 = b.to_wrap[S32]()
    negative: Bool = x & y < 0
    order: S32 = x.compare(y)
    if negative
        return -order
    return order
