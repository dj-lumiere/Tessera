### 1 / sqrt(`me`), correctly rounded (to nearest, ties to even). +0 gives +inf, -0 gives -inf, +inf gives +0, a
### value below zero (-inf included) gives NaN, and a NaN comes back quiet.
### :returns: The reciprocal square root of `me`.
routine B16.rsqrt_unchecked() -> Me
    u: U16 = me.bits()
    i1: U16 = u >> 10
    i2: U16 = u & 0x3FF

    # -0 or x < 0
    if u >> 15 == 1
        if u == 0x8000
            return -inf
        # Adding the quiet NaN keeps a negative NaN x (quieted) and gives the quiet NaN for any other negative x.
        return me +! nan
    # NaN or +inf
    if i1 == 0x1F
        one: B32 = 1.0
        return (one /! me.to[B32]()).to_unchecked[Me]()
    # subnormal case, +0 included
    if i1 == 0
        return B32.from_bits(CM_B16_RSQRT_T3.getitem(i2.to[U64]())).to_unchecked[Me]()
    t1: B32 = B32.from_bits(CM_B16_RSQRT_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_B16_RSQRT_T2.getitem(i2.to[U64]()))
    return (t1 *! t2).to_unchecked[Me]()
