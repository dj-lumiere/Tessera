# Tessera stdlib: the correctly rounded reciprocal square root 1 / sqrt(x) of B16
#
# 1 / sqrt(2^e m) = (1 / sqrt(2^e)) (1 / sqrt(m)): the exponent part and the 1024 mantissas in [1, 2) are both
# tabulated as B32 values whose product rounds correctly to B16, and subnormals have a table of their own. Round to
# nearest only: +0 gives +inf, -0 gives -inf, +inf gives +0, a negative x gives NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary16/rsqrt/rsqrtf16.c.
# Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/B16

### B32 bit patterns of 1/sqrt(x1), where the B16 encoding of x1 is `i1 * 2^10` (i1 is the exponent field of x1),
### for 0 <= i1 < 2^5. The entries for i1 = 0 and 31 are never read.
secret preset CM_B16_RSQRT_T1: &Items[U32, 32] <- [0x00000000, 0x43000000, 0x42B504F3, 0x42800000,
    0x423504F3, 0x42000000, 0x41B504F3, 0x41800000, 0x413504F3, 0x41000000, 0x40B504F3, 0x40800000,
    0x403504F3, 0x40000000, 0x3FB504F3, 0x3F800000, 0x3F3504F3, 0x3F000000, 0x3EB504F3, 0x3E800000,
    0x3E3504F3, 0x3E000000, 0x3DB504F3, 0x3D800000, 0x3D3504F3, 0x3D000000, 0x3CB504F3, 0x3C800000,
    0x3C3504F3, 0x3C000000, 0x3BB504F3, 0x00000000]

