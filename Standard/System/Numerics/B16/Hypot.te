# Tessera stdlib: the correctly rounded Euclidean distance sqrt(x^2 + y^2) of B16
#
# The legs widen exactly to B64, where both squares are exact and the sum and
# square root keep enough bits that the single final rounding to B16 is
# correct. Round to nearest only: overflow gives +inf, an infinite leg gives
# +inf even when the other is a quiet NaN, NaN comes back quiet (x's before
# y's).
#
# Ported from CORE-MATH, src/binary16/hypot/hypotf16.c via RazorForge's B16Hypot.rf.
# Copyright (c) 2025-2026 Maxence Ponsardin and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/B16

### sqrt(`x`^2 + `y`^2), correctly rounded (to nearest). The squares and the sum are taken in B64, so nothing
### overflows before the final rounding. An infinite leg gives +inf even when the other is a quiet NaN.
### :param x: One leg.
### :param y: The other leg.
### :returns: The Euclidean distance, +inf on overflow.
routine hypot_unchecked(x: B16, y: B16) -> B16
    sx: U16 = x.bits()
    sy: U16 = y.bits()
    tx: B64 = x.to[B64]()
    ty: B64 = y.to[B64]()

    inf_x: Bool = sx & 0x7FFF == 0x7C00
    inf_y: Bool = sy & 0x7FFF == 0x7C00
    qnan_x: Bool = sx & 0x7FFF >= 0x7E00
    when
        inf_x and sy & 0x7FFF >= 0x7E00 => return (tx *! tx).to_unchecked[B16]()
        inf_y and qnan_x => return (ty *! ty).to_unchecked[B16]()
        x.is_nan() => return B16.from_bits(sx | 0x0200)
        y.is_nan() => return B16.from_bits(sy | 0x0200)
        else =>
            sum_sq: B64 = tx *! tx +! ty *! ty
            return sum_sq.sqrt_unchecked().to_unchecked[B16]()
