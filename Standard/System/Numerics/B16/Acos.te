# Tessera stdlib: the correctly rounded arc cosine of B16
#
# Evaluated in B32 on t = |x|: degree-4 minimax polynomials for acos on
# [0, 0.25] and [0.25, 0.5], and for acos(t)/sqrt(1 - t) on [0.5, 1]. A
# negative x uses acos(x) = pi - acos(-x). The coefficients were tuned to
# leave only a few exceptional inputs, handled explicitly. Round to nearest
# only: |x| > 1, +-inf and NaN give the default NaN 0xFE00 (the original's NaN
# test never holds, so a NaN input takes the |x| > 1 path too).
#
# Ported from CORE-MATH, src/binary16/acos/acosf16.c via RazorForge's B16Acos.rf.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/B16

### arccos(me), correctly rounded (a CORE-MATH port). |me| > 1, ±inf, and NaN give the default NaN 0xFE00.
### :returns: acos(`me`), in [0, π].
routine B16.acos_unchecked() -> Me
    v: B32 = me.to[B32]()
    u: U32 = v.bits()
    au: U32 = u & 0x7FFFFFFF
    negative: Bool = u >> 31 == 1
    t: B32 = v.abs()
    tt: B32 = t *! t

    # NaN, infinity or |x| >= 1
    when
        au >= 0x3F800000 =>
            one: Bool = au == 0x3F800000
            when
                one and negative => return B32.to[Me](0x1.921fb6p+1)
                one => return Me.from_bits(0)
                else => return Me.from_bits(0xFE00)
        au < 0x3E800000 =>
            # |x| < 0.25
            c1: B32 = B32.mul_add_unchecked(-0x1.25e6b8p-10, a: t, b: -0x1.fffb44p-1)
            c3: B32 = B32.mul_add_unchecked(-0x1.a85b22p-5, a: t, b: -0x1.3cc114p-3)
            y: B32 = c3.mul_add_unchecked(a: tt, b: c1).mul_add_unchecked(a: t, b: 0x1.921fb4p+0)
            if negative
                # pi - acos(-x), except for the inputs the tuned coefficients could not fix
                # x = -0x1.2cp-18, -0x1.3p-18 or -0x1.34p-18
                when
                    0x36960000 <= au <= 0x369A0000 => return B32.to[Me](0x1.922002p+0)
                    u == 0xBCF80000 => return B32.to[Me](0x1.99e002p+0)
                    u == 0xBCFC0000 => return B32.to[Me](0x1.9a0006p+0)
                    else => return B32.sub_unchecked(0x1.921fb4p+1, y).to_unchecked[Me]()
            else
                return y.to_unchecked[Me]()
        au < 0x3F000000 =>
            # x = -0x1.fp-6
            # x = -0x1.f8p-6
            # 0.25 <= |x| < 0.5
            c1: B32 = B32.mul_add_unchecked(-0x1.bd043ap-4, a: t, b: -0x1.f515cap-1)
            c3: B32 = B32.mul_add_unchecked(-0x1.190806p-2, a: t, b: 0x1.7e2d5ap-4)
            # 0.5 <= |x| < 1: acos(t) = sqrt(1 - t) p(t)

            y: B32 = c3.mul_add_unchecked(a: tt, b: c1).mul_add_unchecked(a: t, b: 0x1.91b678p+0)
            if negative
                return B32.sub_unchecked(0x1.921fb4p+1, y).to_unchecked[Me]()
            return y.to_unchecked[Me]()
        else =>
            c1: B32 = B32.mul_add_unchecked(0x1.31640cp-4, a: t, b: -0x1.ae5c5ep-3)
            c3: B32 = B32.mul_add_unchecked(0x1.251b5p-8, a: t, b: -0x1.98038p-6)
            p: B32 = c3.mul_add_unchecked(a: tt, b: c1).mul_add_unchecked(a: t, b: 0x1.91fa1cp+0)
            root: B32 = B32.sub_unchecked(1.0, t).sqrt_unchecked()

            y: B32 = root *! p
            if negative
                return B32.sub_unchecked(0x1.921fb4p+1, y).to_unchecked[Me]()
            return y.to_unchecked[Me]()
