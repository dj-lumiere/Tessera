### sin(x) and cos(x) of a BF16, each correctly rounded.
record BF16SinCos
    ### The sine.
    sin: BF16
    ### The cosine.
    cos: BF16

### The sine and the cosine of `me` (in radians), each correctly rounded (to nearest, ties to even), and the same as
### `me.sin()` and `me.cos()`. +-0 gives a sine of +-0 and a cosine of 1, +-inf gives NaN for both, and a NaN comes
### back quiet in both.
### :returns: sin(`me`) and cos(`me`).
routine BF16.sin_cos() -> BF16SinCos
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    sign: B32 = when

        au == u => 1.0
        else => -1.0

    # for |x| <= 0x1p-4, sin(x) rounds to x and cos(x) to 1
    if au <= 0x3D80
        if au == 0
            return BF16SinCos(sin: me, cos: 1.0)
        # for |x| = 0x1p-126, x * 0x1.fffffep-1 would underflow spuriously
        tiny: B32 = 0x1.fffffcp-127
        small: B32 = when
            au == 0x80 => sign *! tiny
            else => me.to[B32]() *! 0x1.fffffep-1
        near_one: B32 = 0x1.fffffep-1
        return BF16SinCos(sin: small.to_unchecked[Me](), cos: near_one.to_unchecked[Me]())
    if au < 0x4580
        # |x| < 4096, the exponent lies in [123, 138], and 0x3D80 is 123 << 7
        i1: U16 = (au - 0x3D80) >> 3
        i2: U16 = (((au - 0x3D80) >> 7) << 3) | (au & 0x7)
        s1: B32 = .from_bits(CM_BF16_SIN_S1.getitem(i1.to[U64]()))
        c1: B32 = .from_bits(CM_BF16_SIN_C1.getitem(i1.to[U64]()))
        s2: B32 = .from_bits(CM_BF16_SIN_S2.getitem(i2.to[U64]()))
        c2: B32 = .from_bits(CM_BF16_SIN_C2.getitem(i2.to[U64]()))
        # the fmas fix the evaluation order
        s: B32 = sign *! s1.mul_add_unchecked(a: c2, b: c1 *! s2)
        c: B32 = c1.mul_add_unchecked(a: c2, b: -s1 *! s2)
        return BF16SinCos(sin: s.to_unchecked[Me](), cos: c.to_unchecked[Me]())
    if au >> 7 == 0xFF
        # NaN or infinity: like the C code's 0x7FC0 + x, a NaN comes back quiet with its payload and an infinity
        # gives the quiet NaN 0x7FC0
        if au > 0x7F80
            return BF16SinCos(sin: me +! me, cos: me +! me)
        return BF16SinCos(sin: Me.from_bits(0x7FC0), cos: Me.from_bits(0x7FC0))
    # |x| >= 4096, so ulp(x) >= 32 and |x| = b0 2^i + ... + b7 2^(i+7). Start from sin and cos of b7 2^(i+7) and add
    # each other power present with sin(a+b) = sin(a) cos(b) + cos(a) sin(b), cos(a+b) = cos(a) cos(b) - sin(a) sin(b).
    k: U16 = (au >> 7) - 0x8B  # 0 for |x| = 4096
    s7: B32 = .from_bits(CM_BF16_SIN_COS_S3.getitem((k + 7).to[U64]()))  # sin and cos of b7 2^(i+7)
    c7: B32 = .from_bits(CM_BF16_SIN_COS_C3.getitem((k + 7).to[U64]()))
    for j: U16 in 0 til 7 with s: B32 = s7, c: B32 = c7
        if (au >> j) & 1 == 0
            continue with s: s, c: c
        sj: B32 = .from_bits(CM_BF16_SIN_COS_S3.getitem((k + j).to[U64]()))
        cj: B32 = .from_bits(CM_BF16_SIN_COS_C3.getitem((k + j).to[U64]()))
        t: B32 = s.mul_add_unchecked(a: cj, b: c *! sj)
        continue with s: t, c: c.mul_add_unchecked(a: cj, b: -s *! sj)
    then
        return BF16SinCos(sin: (sign *! s).to_unchecked[Me](), cos: c.to_unchecked[Me]())
