# Tessera stdlib: the correctly rounded arc cosine of BF16 divided by pi
#
# Evaluated in B32 on t = |x|: degree-3 minimax polynomials for acos(t) on [0, 0.25] and [0.25, 0.5], and for
# acos(t)/sqrt(1 - t) on [0.5, 1], scaled by 1/pi, with acospi(-t) = 1 - acospi(t) for a negative x. Round to nearest
# only: |x| > 1, an infinity and NaN give the default NaN.
#
# Ported from CORE-MATH, src/binaryb16/acospi/acospi_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/BF16

### The arc cosine of `me` divided by pi, in [0, 1], correctly rounded (to nearest, ties to even). An input with
### |x| > 1, an infinity and NaN give the default NaN (bits 0xFFC0).
### :returns: acos(`me`) / pi.
routine BF16.acos_pi_unchecked() -> Me
    v: B32 = me.to[B32]()
    u: U32 = v.bits()
    au: U32 = u & 0x7FFFFFFF

    # NaN, infinity or |x| >= 1
    if au >= 0x3F800000
        if au == 0x3F800000
            if u == 0x3F800000
                return 0.0
            return 1.0
        # The C code's NaN test never holds, so a NaN takes this path too: 0/0, the default NaN.
        return Me.from_bits(0xFFC0)

    t: B32 = B32.from_bits(au)
    y: B32 = when
        au < 0x3E800000 =>
            # |x| < 0.25. For |x| <= 0x1.92p-9 acospi(x) rounds to 0.5 to nearest, and this avoids a spurious
            # underflow for a tiny x.
            if au <= 0x3B490000
                return v.mul_add_unchecked(a: -0.25, b: 0.5).to_unchecked[Me]()
            c1: B32 = B32.mul_add_unchecked(0x1.9ed63ap-9, a: t, b: -0x1.000c5cp+0)
            p: B32 = B32.mul_add_unchecked(-0x1.731646p-3, a: t *! t, b: c1)
            becomes p.mul_add_unchecked(a: t, b: 0x1.921fd2p+0)
        au < 0x3F000000 =>
            # 0.25 <= |x| < 0.5
            c1: B32 = B32.mul_add_unchecked(0x1.f5273p-4, a: t, b: -0x1.08e352p+0)
            p: B32 = B32.mul_add_unchecked(-0x1.4961b2p-2, a: t *! t, b: c1)
            becomes p.mul_add_unchecked(a: t, b: 0x1.92fdc4p+0)
        else =>
            # 0.5 <= |x| < 1: the polynomial approximates acos(t)/sqrt(1 - t)
            c1: B32 = B32.mul_add_unchecked(0x1.e9bcc4p-5, a: t, b: -0x1.9fd22cp-3)
            p: B32 = B32.mul_add_unchecked(-0x1.78f01ep-7, a: t *! t, b: c1)
            q: B32 = p.mul_add_unchecked(a: t, b: 0x1.91a802p+0)
            becomes B32.sub_unchecked(1.0, t).sqrt_unchecked() *! q

    # times 1/pi, and acospi(-x) = 1 - acospi(x) for a negative x
    r: B32 = y *! 0x1.45f306p-2
    if au == u
        return r.to_unchecked[Me]()
    return B32.sub_unchecked(1.0, r).to_unchecked[Me]()
