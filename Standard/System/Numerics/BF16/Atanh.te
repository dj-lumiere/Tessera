# Tessera stdlib: the correctly rounded inverse hyperbolic tangent of BF16
#
# atanh(-x) = -atanh(x), so work on |x|: tiny |x| round to x, 1/2 <= |x| < 1 (128 BF16 values) come from a table,
# and in between an odd degree-7 polynomial in B32 gives a result that rounds correctly. Round to nearest only: +-0
# map to themselves, +-1 give +-inf, |x| > 1 gives NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/atanh/atanh_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/BF16

### B32 bit patterns of atanh(1/2 + i/2^8), rounded to nearest, for 0 <= i < 2^7.
secret preset CM_BF16_ATANH_T1: @Array[U32, 128] <- [0x3F0C9F54, 0x3F0DF58E, 0x3F0F4D98, 0x3F10A77A,
    0x3F12033D, 0x3F1360E9, 0x3F14C089, 0x3F162225, 0x3F1785C7, 0x3F18EB7A, 0x3F1A5346, 0x3F1BBD37,
    0x3F1D2956, 0x3F1E97B0, 0x3F20084F, 0x3F217B3E, 0x3F22F08A, 0x3F24683E, 0x3F25E267, 0x3F275F11,
    0x3F28DE49, 0x3F2A601E, 0x3F2BE49C, 0x3F2D6BD1, 0x3F2EF5CD, 0x3F30829E, 0x3F321254, 0x3F33A4FE,
    0x3F353AAD, 0x3F36D372, 0x3F386F5D, 0x3F3A0E80, 0x3F3BB0EF, 0x3F3D56BB, 0x3F3EFFF9, 0x3F40ACBC,
    0x3F425D19, 0x3F441126, 0x3F45C8F9, 0x3F4784A8, 0x3F49444B, 0x3F4B07FB, 0x3F4CCFD1, 0x3F4E9BE7,
    0x3F506C58, 0x3F524140, 0x3F541ABD, 0x3F55F8EC, 0x3F57DBEC, 0x3F59C3DE, 0x3F5BB0E3, 0x3F5DA31F,
    0x3F5F9AB6, 0x3F6197CD, 0x3F639A8B, 0x3F65A31A, 0x3F67B1A4, 0x3F69C654, 0x3F6BE15A, 0x3F6E02E4,
    0x3F702B27, 0x3F725A55, 0x3F7490A5, 0x3F76CE51, 0x3F791395, 0x3F7B60B0, 0x3F7DB5E3, 0x3F8009B9,
    0x3F813CD4, 0x3F827467, 0x3F83B09B, 0x3F84F19A, 0x3F86378F, 0x3F8782AA, 0x3F88D31C, 0x3F8A2919,
    0x3F8B84D6, 0x3F8CE690, 0x3F8E4E83, 0x3F8FBCF0, 0x3F91321C, 0x3F92AE53, 0x3F9431E0, 0x3F95BD1A,
    0x3F975057, 0x3F98EBF9, 0x3F9A9065, 0x3F9C3E08, 0x3F9DF558, 0x3F9FB6D3, 0x3FA18302, 0x3FA35A78,
    0x3FA53DD5, 0x3FA72DC4, 0x3FA92B03, 0x3FAB365D, 0x3FAD50B2, 0x3FAF7AF7, 0x3FB1B638, 0x3FB4039E,
    0x3FB66471, 0x3FB8DA1B, 0x3FBB6630, 0x3FBE0A75, 0x3FC0C8E5, 0x3FC3A3BB, 0x3FC69D80, 0x3FC9B916,
    0x3FCCF9CC, 0x3FD06374, 0x3FD3FA7E, 0x3FD7C41B, 0x3FDBC672, 0x3FE008D8, 0x3FE49428, 0x3FE97335,
    0x3FEEB36E, 0x3FF465C2, 0x3FFA9FFD, 0x4000BF69, 0x4004948F, 0x4008EAB0, 0x400DE9B2, 0x4013CF72,
    0x401B0395, 0x40244862, 0x40315208, 0x40479057]

### atanh(`me`), correctly rounded (to nearest, ties to even). +-0 map to themselves, +-1 give +-inf, a value beyond
### [-1, 1] (+-inf included) gives NaN, and a NaN comes back quiet.
### :returns: The inverse hyperbolic tangent of `me`.
routine BF16.atanh_unchecked() -> Me
    local t: B32 = me.to[B32]()
    local u: U32 = t.bits()
    local au: U32 = u & 0x7FFFFFFF

    # NaN, +-inf or |x| >= 1
    if au >= 0x3F800000
        if au == 0x3F800000
            if au == u
                return inf
            return -inf
        if au > 0x7F800000
            return me +! me
        # |x| > 1: the invalid-operation NaN that 0.0 / 0.0 gives on x86-64.
        return Me.from_bits(0xFFC0)

    # Now |x| < 1, and atanh(-x) = -atanh(x).
    sgn: B32 = when
        u >> 31 == 1 => -1.0
        else => 1.0
    # |x| >= 1/2: every BF16 value there is in the table.
    if au >= 0x3F000000
        i: U64 = ((au - 0x3F000000) >> 16).to[U64]()
        return (sgn *! B32.from_bits(CM_BF16_ATANH_T1.getitem(i))).to_unchecked[Me]()

    # For |x| <= 0x1.7p-4, atanh(x) rounds to x: push it up in magnitude by a little before rounding.
    if au <= 0x3DB80000
        if au == 0
            return me
        return t.mul_add_unchecked(a: 0x1p-9, b: t).to_unchecked[Me]()

    # Now 0x1.7p-4 < |x| < 1/2: p is an odd degree-7 polynomial approximating atanh on [0, 1/2], its degree-1
    # coefficient slightly changed so that |x| = 0x1.bap-2 rounds correctly.
    p0: B32 = 0x1.fffff8p-1
    p1: B32 = 0x1.55ba9p-2
    p2: B32 = 0x1.85109p-3
    p3: B32 = 0x1.b04258p-3
    tt: B32 = t *! t
    # degree 5
    c5: B32 = p3.mul_add_unchecked(a: tt, b: p2)
    # degree 1
    c1: B32 = p1.mul_add_unchecked(a: tt, b: p0)
    c: B32 = c5.mul_add_unchecked(a: tt *! tt, b: c1)
    return (t *! c).to_unchecked[Me]()
