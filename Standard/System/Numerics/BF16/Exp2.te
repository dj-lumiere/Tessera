### B32 bit patterns of 2^-128 to 2^-133, the exact results for x = -128 to -133.
secret preset CM_BF16_EXP2_UND: &Items[U32, 6] <- [0x00200000, 0x00100000, 0x00080000, 0x00040000,
    0x00020000, 0x00010000]

### 2^`me`, correctly rounded (to nearest, ties to even). Overflow gives +inf, -inf and underflow below 2^-134 give +0,
### and NaN comes back quiet.
### :returns: 2^`me`.
routine BF16.exp2_unchecked() -> Me
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    # For |x| <= 0x1.7p-9, 2^x rounds to 1. The tiny term on the side of the true result keeps the B32 sum right
    # under directed rounding too.
    if au <= 0x3B38
        if au == 0
            return 1.0
        one: B32 = 1.0
        if au == u
            tiny: B32 = 0x1p-24
            return (one +! tiny).to_unchecked[Me]()
        tiny: B32 = -0x1p-25
        return (one +! tiny).to_unchecked[Me]()
    # For x >= 128, 2^x >= 2^128, and for x < -0x1.0cp+7, 2^x < 2^-134.
    if au >= 0x4300
        if au >= 0x7F80
            if u == 0xFF80
                return 0.0
            return me +! me
        if au == u
            return inf
        # Now x <= -128.
        if au >= 0x4306
            r: B32 = 0x1p-134
            return r.to_unchecked[Me]()
        # It remains -133 <= x <= -128, where 2^x is an exact subnormal.
        r: B32 = B32.from_bits(CM_BF16_EXP2_UND.getitem((u - 0xC300).to[U64]()))
        return r.to_unchecked[Me]()
    # The exponent lies in [118, 133], so au takes 11 bits.
    sign: U16 = u >> 15
    i1: U16 = (sign << 8) + (au >> 3) - 0x760
    i2: U16 = (sign << 7) + (((au >> 7) << 3) | (au & 0x7)) - 0x3B0
    t1: B32 = B32.from_bits(CM_BF16_EXP2_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_EXP2_T2.getitem(i2.to[U64]()))
    return (t1 *! t2).to_unchecked[Me]()
