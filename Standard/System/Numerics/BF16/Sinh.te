### sinh(`me`), correctly rounded (to nearest, ties to even). +-0 and +-inf map to themselves, a result past the BF16
### range gives an infinity of `me`'s sign, and a NaN comes back quiet.
### :returns: The hyperbolic sine of `me`.
routine BF16.sinh_unchecked() -> Me
    local u: U16 = me.bits()
    local au: U16 = u & 0x7FFF

    # For |x| <= 0x1.dp-4, sinh(x) rounds to x.
    if au <= 0x3DE8
        if au == 0
            return me
        # sinh(x) = x + x^3/6 + o(x^3), so nudge x up in magnitude by one B32 ulp before rounding.
        return (me.to[B32]() *! 0x1.000002p+0).to_unchecked[Me]()
    # For |x| >= 0x1.66p+6, sinh(x) overflows: this also maps +-inf to themselves and quiets a NaN.
    if au >= 0x42B3
        return (me.to[B32]() *! 0x1p127).to_unchecked[Me]()
    # Now 0x3DE8 < au < 0x42B3: the exponent lies in [123, 133], and 0x3D80 is 123 << 7.
    i1: U16 = (au - 0x3D80) >> 3
    i2: U16 = (((au - 0x3D80) >> 7) << 3) | (au & 0x7)
    s1: B32 = B32.from_bits(CM_BF16_SINH_S1.getitem(i1.to[U64]()))
    c1: B32 = B32.from_bits(CM_BF16_SINH_C1.getitem(i1.to[U64]()))
    s2: B32 = B32.from_bits(CM_BF16_SINH_S2.getitem(i2.to[U64]()))
    c2: B32 = B32.from_bits(CM_BF16_SINH_C2.getitem(i2.to[U64]()))
    # The fused multiply-add fixes the evaluation order.
    res: B32 = s1.mul_add_unchecked(a: c2, b: c1 *! s2)
    sgn: B32 = when
        u >> 15 == 1 => -1.0
        else => 1.0
    return (sgn *! res).to_unchecked[Me]()
