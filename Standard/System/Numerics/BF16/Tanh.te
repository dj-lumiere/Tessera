# Tessera stdlib: the correctly rounded hyperbolic tangent of BF16
#
# x = x1 + x2, where x1 keeps the exponent and the upper 4 bits of the mantissa of |x| and x2 the exponent and the
# lower 3 bits: sinh(x) and cosh(x) come from the addition formulas over the B32 tables of BF16.sinh, and their
# quotient rounds correctly to BF16. Round to nearest only: +-0 map to themselves, +-inf give +-1, NaN comes back
# quiet.
#
# Ported from CORE-MATH, src/binaryb16/tanh/tanh_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/BF16

### tanh(`me`), correctly rounded (to nearest, ties to even), in [-1, 1]. +-0 map to themselves, +-inf give +-1, and
### a NaN comes back quiet.
### :returns: The hyperbolic tangent of `me`.
routine BF16.tanh() -> Me
    local u: U16 = me.bits()
    local au: U16 = u & 0x7FFF
    local sgn: B32 = when
        u >> 15 == 1 => -1.0
        else => 1.0

    # For |x| <= 0x1.7p-4, tanh(x) rounds to x.
    if au <= 0x3DB8
        if au == 0
            return me
        # tanh(x) = x - x^3/3 + o(x^3), so pull x down in magnitude by one B32 ulp before rounding. For |x| = 2^-126
        # the constant below gives the same result without a spurious underflow.
        if au == 0x80
            return (sgn *! 0x1.fffffcp-127).to_unchecked[Me]()
        return (me.to[B32]() *! 0x1.fffffep-1).to_unchecked[Me]()
    # For |x| >= 0x1.bcp+1, tanh(x) rounds to +-1.
    if au >= 0x405E
        if au >= 0x7F80
            # +-inf give +-1, a NaN comes back quiet.
            if au == 0x7F80
                return sgn.to_unchecked[Me]()
            return me +! me
        # The B32 value just below 1 in magnitude marks the result inexact.
        return (sgn *! 0x1.fffffep-1).to_unchecked[Me]()
    # Now 0x3DB8 < au < 0x405E: the exponent lies in [123, 128], and 0x3D80 is 123 << 7.
    i1: U16 = (au - 0x3D80) >> 3
    i2: U16 = (((au - 0x3D80) >> 7) << 3) | (au & 0x7)
    s1: B32 = B32.from_bits(CM_BF16_SINH_S1.getitem(i1.to[U64]()))
    c1: B32 = B32.from_bits(CM_BF16_SINH_C1.getitem(i1.to[U64]()))
    s2: B32 = B32.from_bits(CM_BF16_SINH_S2.getitem(i2.to[U64]()))
    c2: B32 = B32.from_bits(CM_BF16_SINH_C2.getitem(i2.to[U64]()))
    # The fused multiply-adds fix the evaluation order.
    s: B32 = s1.mul_add_unchecked(a: c2, b: c1 *! s2)
    c: B32 = c1.mul_add_unchecked(a: c2, b: s1 *! s2)
    return (sgn *! (s /! c)).to_unchecked[Me]()
