### The mask of the fraction bits of a BF16 with biased exponent 127 + i, i = the index (|x| in [2^i, 2^(i+1))).
secret preset CM_BF16_SIN_PI_M: @Array[U16, 7] <- [0x7F, 0x3F, 0x1F, 0xF, 0x7, 0x3, 0x1]

### sin(pi `me`), correctly rounded (to nearest, ties to even). An integer gives +0 for a positive one and -0 for a
### negative one (+-0 comes back unchanged), +-inf and a quiet NaN give the NaN 0xFFC0, and a signaling NaN comes
### back quiet (0x7F81 and 0xFF81 give 0xFFC0 too).
### :returns: sin(pi `me`).
routine BF16.sin_pi() -> Me
    local u: U16 = me.bits()
    local au: U16 = u & 0x7FFF

    if au >= 0x3F80
        # |x| >= 1, so x might be an integer
        if au >= 0x7F80
            # NaN or infinity. 0xFFC0 is what the C code's 0.0f / 0.0f gives on x86.
            if au > 0x7F81 and au < 0x7FC0
                return me +! me
            return Me.from_bits(0xFFC0)
        e: U16 = au >> 7  # 127 <= e <= 254
        if e >= 134 or au & CM_BF16_SIN_PI_M.getitem((e - 127).to[U64]()) == 0
            # x is an integer
            if au == u
                return 0.0
            return Me.from_bits(0x8000)
    # now |x| < 2^7 and x is not an integer
    if au < 0x3B00
        # |x| < 2^-9: pi x rounds correctly
        if au == 0
            return me
        pi24: B32 = 0x1.921fb6p+1
        small: B32 = pi24 *! me.to[B32]()
        return small.to_unchecked[Me]()
    # now 2^-9 <= |x| < 2^7, the exponent lies in [118, 133], and 0x3B00 is 118 << 7
    i1: U16 = (au - 0x3B00) >> 3
    i2: U16 = (((au - 0x3B00) >> 7) << 3) | (au & 0x7)
    s1: B32 = .from_bits(CM_BF16_SIN_PI_S1.getitem(i1.to[U64]()))
    c1: B32 = .from_bits(CM_BF16_SIN_PI_C1.getitem(i1.to[U64]()))
    s2: B32 = .from_bits(CM_BF16_SIN_PI_S2.getitem(i2.to[U64]()))
    c2: B32 = .from_bits(CM_BF16_SIN_PI_C2.getitem(i2.to[U64]()))
    res: B32 = s1.mul_add_unchecked(a: c2, b: c1 *! s2)  # the fma fixes the evaluation order
    sign: B32 = when
        au == u => 1.0
        else => -1.0
    return (sign *! res).to_unchecked[Me]()
