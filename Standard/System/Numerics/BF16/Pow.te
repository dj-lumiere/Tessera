    0x3FF0286685C9E059, 0x3FF02919BBD1D1D8, 0x3FF029CCF99D720A, 0x3FF02A803F2D170D,
    0x3FF02B338C811703, 0x3FF02BE6E199C811]

### `me` raised to the power `exponent`, correctly rounded (to nearest, ties to even). The special cases follow C's
### pow: x^+-0 is 1 and 1^y is 1 (also for a quiet NaN, a signaling one gives NaN), (-1)^+-inf is 1, a negative `me`
### with a non-integer `exponent` gives NaN, a zero `me` with a negative `exponent` gives an infinity (negative for
### -0 and an odd integer `exponent`), overflow gives an infinity and underflow a zero. Any other NaN comes back quiet.
### :param exponent: The power to raise `me` to.
### :returns: `me`^`exponent`.
routine BF16.powf_unchecked(exponent: Me) -> Me
    x: B32 = me.to[B32]()
    y: B32 = exponent.to[B32]()
    ux: U16 = me.bits()
    uy: U16 = exponent.bits()

    if ux & 0x7FFF == 0x3F80
        # |x| = 1
        if ux >> 15 != 0
            # x = -1
            if uy & 0x7FFF > 0x7F80
                return (y +! y).to_unchecked[Me]()
            if cm_bf16_pow_isint(uy)
                if cm_bf16_pow_isodd(uy)
                    return me
                return -me
            return B32.truediv_unchecked(0.0, 0.0).to_unchecked[Me]()
        # 1^y = 1 except when y is a signaling NaN
        if uy & 0x7FFF > 0x7F80 and uy & 0x0040 == 0
            return (y +! y).to_unchecked[Me]()
        return me
    if uy & 0x7FFF == 0
        # x^0 = 1 except when x is a signaling NaN
        if ux & 0x7FFF > 0x7F80 and ux & 0x0040 == 0
            return (x +! x).to_unchecked[Me]()
        return 1.0
    if uy & 0x7FFF >= 0x7F80
        # y = +-inf or NaN (|x| = 1 was handled above)
        if ux & 0x7FFF > 0x7F80
            return (x +! x).to_unchecked[Me]()
        if uy & 0x7FFF == 0x7F80
            # +0 for |x| < 1 and y = +inf or |x| > 1 and y = -inf, +inf for the other two
            if (ux & 0x7FFF < 0x3F80) != (uy >> 15 != 0)
                return 0.0
            return inf
        return (y +! y).to_unchecked[Me]()
    if ux & 0x7FFF == 0
        # x = +-0: the result is -0 or -inf only for x = -0 and an odd integer y
        if uy >> 15 != 0
            if cm_bf16_pow_isodd(uy) and ux >> 1 != 0
                return -inf
            return inf
        if cm_bf16_pow_isodd(uy) and ux >> 1 != 0
            return -0.0
        return 0.0
    if ux >= 0x7F80
        # x = +-inf, NaN, or x < 0
        if ux & 0x7FFF == 0x7F80
            # the sign stays only for an odd y, a negative y gives a zero
            even: U16 = when
                cm_bf16_pow_isodd(uy) => ux
                else => ux & 0x7FFF
            signed: U16 = when
                uy >> 15 != 0 => even & 0x8000
                else => even
            return Me.from_bits(signed)
        if ux & 0x7FFF > 0x7F80
            return (x +! x).to_unchecked[Me]()
        if not cm_bf16_pow_isint(uy)
            return B32.truediv_unchecked(0.0, 0.0).to_unchecked[Me]()
    # x > 0 here, or x < 0 with an integer y: then |x|^y, negative for an odd y
    sign: U64 = when
        ux >= 0x7F80 and cm_bf16_pow_isodd(uy) => 0x8000000000000000
        else => 0
    logx: B64 = cm_bf16_pow_log(ux & 0x7FFF)
    ylogx: B64 = exponent.to[B64]() *! logx
    return cm_bf16_pow_exp(ylogx, sign)

### Whether the BF16 with bits v is an integer (zeros, infinities and NaN count as integers).
### :param v: The BF16 bits.
### :returns: True for an integer.
secret routine cm_bf16_pow_isint(v: U16) -> Bool
    if v & 0x7FFF == 0
        return true
    return (v & 0x7FFF) >> 7 >= U16.sub(134, (v | 0x80).trailing_zeros())

### Whether the BF16 with bits v is an odd integer.
### :param v: The BF16 bits.
### :returns: True for an odd integer.
secret routine cm_bf16_pow_isodd(v: U16) -> Bool
    if v & 0x7FFF == 0
        return false
    return (v & 0x7FFF) >> 7 == U16.sub(134, (v | 0x80).trailing_zeros())

### A B64 approximation of log(x) for a positive finite BF16 x, from its bits.
### :param u: The bits of x.
### :returns: log(x).
secret routine cm_bf16_pow_log(u: U16) -> B64
    i1: U16 = u >> 7
    i2: U64 = (u & 0x7F).to[U64]()
    if i1 == 0
        return B64.from_bits(CM_BF16_POW_T3.getitem(i2))
    return B64.from_bits(CM_BF16_POW_T1.getitem(i1.to[U64]())) +! B64.from_bits(CM_BF16_POW_T2.getitem(i2))

### exp(ylogx) rounded to BF16, with the sign bit `sign` added, correctly rounded including the exact and midpoint
### cases. Overflow gives an infinity and underflow a zero.
### :param ylogx: y log(x).
### :param sign: 0 or the B64 sign bit.
### :returns: +-exp(ylogx) as a BF16.
secret routine cm_bf16_pow_exp(ylogx: B64, sign: U64) -> BF16
    # overflow and underflow
    if ylogx > 0x1.62e42fefa39efp+6
        r: B64 = when
            sign == 0 => 0x1p128
            else => -0x1p128
        return r.to_unchecked[BF16]()
    if ylogx < -0x1.7386e22edf4a6p+6
        r: B64 = when
            sign == 0 => 0x1p-134
            else => -0x1p-134
        return r.to_unchecked[BF16]()
    # x^y rounds to 1
    if ylogx.abs() <= 0x1p-9
        r: B64 = when
            sign == 0 => 1.0 +! ylogx
            else => -1.0 -! ylogx
        return r.to_unchecked[BF16]()
    # ylogx = e log(2) + i1 log(2)/2^6 + i2 log(2)/2^12 + r, with 2^12/log(2) and -log(2)/2^12 rounded to B64
    jd: B64 = B64.mul_unchecked(0x1.71547652b82fep+12, ylogx).trunc()
    j: S32 = jd.to[S32]()
    e: S32 = j >> 12
    i1: U64 = ((j >> 6) & 0x3F).to[U64]()
    i2: U64 = (j & 0x3F).to[U64]()
    # |r| < 2^-13 log(2), exp(r) from a degree-3 polynomial
    r: B64 = jd.mul_add_unchecked(a: -0x1.62e42fefa39efp-13, b: ylogx)
    rr: B64 = r *! r
    c2: B64 = 0.5 +! 0x1.5555555555555p-3 *! r
    c0: B64 = 1.0 +! r
    t: B64 = B64.from_bits(CM_BF16_POW_T4.getitem(i1)) *! B64.from_bits(CM_BF16_POW_T5.getitem(i2))
    expr: B64 = (c0 +! c2 *! rr) *! t
    u: U64 = expr.bits() +% (sign +% (e.to[S64]().to_wrap[U64]() << 52))
    # Round the low bits to nearest to catch the exact and midpoint values.
    rounded: U64 = when
        (u +% 0xD9) & 0xFFFFFFFFE00 <= 0x93 => (u +% 0xD9) & 0xFFFFFFFFFFFFFE00
        else => u
    return B64.from_bits(rounded).to_unchecked[BF16]()
