### B32 bit patterns of 10^x for the 33 encodings `0xBA5F + i3` of x, where -2^-10 < x < -0x1.bcp-11.
secret preset CM_BF16_EXP10_T3: &Items[U32, 33] <- [0x3F7F7FC2, 0x3F7F7F2F, 0x3F7F7E9C, 0x3F7F7E08,
    0x3F7F7D75, 0x3F7F7CE2, 0x3F7F7C4F, 0x3F7F7BBC, 0x3F7F7B29, 0x3F7F7A96, 0x3F7F7A03, 0x3F7F7970,
    0x3F7F78DD, 0x3F7F784A, 0x3F7F77B7, 0x3F7F7724, 0x3F7F7691, 0x3F7F75FE, 0x3F7F756A, 0x3F7F74D7,
    0x3F7F7444, 0x3F7F73B1, 0x3F7F731E, 0x3F7F728B, 0x3F7F71F8, 0x3F7F7165, 0x3F7F70D2, 0x3F7F703F,
    0x3F7F6FAC, 0x3F7F6F19, 0x3F7F6E86, 0x3F7F6DF3, 0x3F7F6D60]

### 10^`me`, correctly rounded (to nearest, ties to even). Overflow gives +inf, -inf and underflow give +0, and NaN
### comes back quiet.
### :returns: 10^`me`.
routine BF16.exp10_unchecked() -> Me
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    # For -0x1.bcp-11 <= x <= 0x1.bap-10, 10^x rounds to 1: a B32 value just above or below 1 keeps the rounding right
    # under directed rounding too.
    if au < 0x3A80
        if au == 0
            return 1.0
        if au == u
            r: B32 = 0x1.000002p+0
            return r.to_unchecked[Me]()
        if au <= 0x3A5E
            r: B32 = 0x1.fffffep-1
            return r.to_unchecked[Me]()
        # Now -2^-10 < x < -0x1.bcp-11, so 0xBA5F <= u <= 0xBA7F.
        r: B32 = B32.from_bits(CM_BF16_EXP10_T3.getitem((u - 0xBA5F).to[U64]()))
        return r.to_unchecked[Me]()
    # For x >= 0x1.36p+5, 10^x >= 2^128, and for x <= -0x1.44p+5, 10^x < 2^-134.
    if au >= 0x4222
        if au >= 0x7F80
            if u == 0xFF80
                return 0.0
            return me +! me
        if au == u
            return inf
        r: B32 = 0x1p-134
        return r.to_unchecked[Me]()
    # The exponent lies in [117, 132], so au takes 11 bits.
    sign: U16 = u >> 15
    i1: U16 = (sign << 8) + (au >> 3) - 0x750
    i2: U16 = (sign << 7) + (((au >> 7) << 3) | (au & 0x7)) - 0x3A8
    t1: B32 = B32.from_bits(CM_BF16_EXP10_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_EXP10_T2.getitem(i2.to[U64]()))
    return (t1 *! t2).to_unchecked[Me]()
