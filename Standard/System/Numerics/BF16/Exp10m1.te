### ln(10) rounded to B32.
secret preset CM_BF16_EXP10M1_LOG10: B32 = 0x1.26bb1cp+1

### 10^`me` - 1, accurate near 0 and correctly rounded (to nearest, ties to even). Overflow gives +inf, a large
### negative `me` and -inf give -1, and NaN comes back quiet.
### :returns: 10^`me` - 1.
routine BF16.exp10_m1_unchecked() -> Me
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    # |x| < 2^-10
    if au < 0x3A80
        if au == 0
            return me
        # The Taylor expansion of 10^x - 1 is ln(10) x + ln(10)^2/2 x^2, the square term only matters above
        # 0x1.7p-125.
        t: B32 = CM_BF16_EXP10M1_LOG10 *! me.to[B32]()
        if au <= 0x138
            return t.to_unchecked[Me]()
        return t.mul_add_unchecked(a: 0.5 *! t, b: t).to_unchecked[Me]()
    # For x >= 0x1.36p+5, 10^x >= 2^128.
    if au >= 0x421B
        if au >= 0x7F80
            if u == 0xFF80
                return -1.0
            return me +! me
        if au == u
            return inf
        r: B32 = -0x1.fffffep-1
        return r.to_unchecked[Me]()
    # The exponent lies in [117, 132], so au takes 11 bits.
    sign: U16 = u >> 15
    i1: U16 = (sign << 8) + (au >> 3) - 0x750
    i2: U16 = (sign << 7) + (((au >> 7) << 3) | (au & 0x7)) - 0x3A8
    t1: B32 = B32.from_bits(CM_BF16_EXP10M1_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_EXP10_T2.getitem(i2.to[U64]()))
    return t1.mul_add_unchecked(a: t2, b: -1.0).to_unchecked[Me]()
