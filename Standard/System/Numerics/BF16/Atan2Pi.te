# Tessera stdlib: the correctly rounded two-argument arc tangent of BF16 divided by pi
#
# The BF16 arguments widen exactly to B32 and run the B32 atan2pi algorithm: atan2pi(y, x) is off + atan(z)/pi, with
# z = y/x or -x/y (whichever is at most 1 in magnitude) and off a multiple of 1/2 picked by the signs and by which of
# |y|, |x| is larger. A degree-6/6 rational approximation in B64 settles most inputs, and the rest go through a
# double-double polynomial. The final B64 value is rounded straight to BF16 (never through B32, which would round
# twice). Round to nearest only. Zeros and infinities follow C99 (divided by pi), and a NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/atan2pi/atan2pi_bf16.c.
# Copyright (c) 2022-2025 Alexei Sibidanov and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/BF16

### Offsets added to the reduced arc tangent over pi, indexed by (sign of y) 4 + (sign of x) 2 + (|y| > |x|), as B64
### bits: 0, 1/2, 1, 1/2, -0, -1/2, -1, -1/2.
secret preset CM_BF16_ATAN2PI_OFF: &Array[U64, 8] <- [0x0000000000000000, 0x3FE0000000000000,
    0x3FF0000000000000, 0x3FE0000000000000, 0x8000000000000000, 0xBFE0000000000000,
    0xBFF0000000000000, 0xBFE0000000000000]

### Double-double coefficients (high and low parts interleaved) of the accurate polynomial for atan(z)/(pi z) in z^2, as B64 bits.
secret preset CM_BF16_ATAN2PI_C: &Array[U64, 64] <- [0x3FD45F306DC9C883, 0xBC76B01EC5513324,
    0xBFBB2995E7B7B604, 0x3C5E402B0C13EEDC, 0x3FB04C26BE3B06CF, 0xBC3571D178A53EF0,
    0xBFA7483758E69C03, 0x3C0819A6ED7AAF38, 0x3FA21BB9452523FF, 0xBC3234D866FB9807,
    0xBF9DA1BACE3CC54E, 0xBBFC84F6ADA49294, 0x3F9912B1C23345DD, 0xBC3534890FBC1650,
    0xBF95BADE52F5F52A, 0x3C3F783BAFC832F6, 0x3F932C69D084C5C0, 0x3C3042D155953025,
    0xBF9127BCFB3E8C7D, 0xBC385AAE199A7B6B, 0x3F8F0AF43B11A731, 0x3C28F03563566630,
    0xBF8C57E86801029E, 0x3C2DCDF3E3B38EB4, 0x3F8A136408617EA1, 0x3C0A71AFFB36C6C4,
    0xBF8824AC7814BA37, 0x3C28928B295C0898, 0x3F86794E32EA5471, 0x3C20B4334FB41E63,
    0xBF8501D57F643D97, 0x3C2516785BF1376E, 0x3F83ADF02FF2400A, 0xBC1B0E30BB8C8076,
    0xBF8267702F94FAA0, 0xBC17A4D3A1850CC6, 0x3F810DCE97099686, 0x3C2FCC208EEE2571,
    0xBF7EEE49CDAD8002, 0xBBF9109B3F1BAB82, 0x3F7AF93BC191A929, 0x3C1069FD3B47D7B0,
    0xBF76240751B54675, 0xBC172DC8CFD03B6F, 0x3F70B61E84080884, 0x3C0825824C80941B,
    0xBF66A72A8A74E3A5, 0x3C08786A82FD117E, 0x3F5AEDE3217D939D, 0xBBB93B626982E1FE,
    0xBF4B66568F09EBEE, 0xBBD704A39121D0A5, 0x3F373AF3977FA973, 0xBBBAA050E2244EA3,
    0xBF1FC69D85ED28C9, 0x3BB867F17B764CA0, 0x3F00C883A9270162, 0xBB96842833896DD9,
    0xBED9A0B27B6DFE15, 0x3B6427FC2F4E1327, 0x3EA91E15E7AB5BDC, 0xBB2730DBC6279D0D,
    0xBE67B1119C1FF867, 0x3B0145F9980759C4]

### A double-double number hi + lo, the result of the helpers of BF16.atan2_pi.
secret record CmBf16Atan2PiDD
    ### The high part.
    hi: B64
    ### The low part, below the last bit of `hi`.
    lo: B64

### The angle of the point (`x`, `y`) divided by pi, in [-1, 1], correctly rounded (to nearest, ties to even).
### Zeros and infinities follow C99: atan2pi(+-0, +0) is +-0, atan2pi(+-0, -0) is +-1,
### atan2pi(+-inf, +inf) is +-1/4, atan2pi(+-inf, -inf) is +-3/4. A NaN in either argument gives a quiet NaN.
### :param y: The y coordinate.
### :param x: The x coordinate.
### :returns: atan2(`y`, `x`) / pi.
routine atan2_pi(y: BF16, x: BF16) -> BF16
    fy: B32 = y.to[B32]()
    fx: B32 = x.to[B32]()
    ux: U32 = fx.bits()
    uy: U32 = fy.bits()
    ax: U32 = ux & 0x7FFFFFFF
    ay: U32 = uy & 0x7FFFFFFF
    sy: B32 = when

        uy >> 31 != 0 => -1.0
        else => 1.0

    if ay >= 0x7F800000 or ax >= 0x7F800000
        # x or y is NaN or an infinity. x + y gives the quiet NaN of either NaN argument.
        if ay > 0x7F800000 or ax > 0x7F800000
            return (fx +! fy).to_unchecked[BF16]()
        yinf: Bool = ay == 0x7F800000
        xinf: Bool = ax == 0x7F800000
        if yinf and xinf
            # +-3/4 or +-1/4
            if ux >> 31 != 0
                return B32.mul_unchecked(0.75, sy).to_unchecked[BF16]()
            return B32.mul_unchecked(0.25, sy).to_unchecked[BF16]()
        if xinf
            if ux >> 31 != 0
                return sy.to_unchecked[BF16]()
            return B32.mul_unchecked(0.0, sy).to_unchecked[BF16]()
        return B32.mul_unchecked(0.5, sy).to_unchecked[BF16]()
    if ay == 0
        if ax == 0
            # both zero: +-0 or +-1 by the signs
            iz: U64 = ((uy >> 31) * 4 + (ux >> 31) * 2).to[U64]()
            return B64.from_bits(CM_BF16_ATAN2PI_OFF.getitem(iz)).to_unchecked[BF16]()
        if ux >> 31 == 0
            return B32.mul_unchecked(0.0, sy).to_unchecked[BF16]()
    if ax == ay
        # |y| = |x|: +-1/4 or +-3/4
        return cm_bf16_atan2pi_diagonal(uy, ux).to_unchecked[BF16]()

    gt: U32 = (ay > ax).to[U32]()
    i: U64 = ((uy >> 31) * 4 + (ux >> 31) * 2 + gt).to[U64]()
    mg: B64 = gt.to[B64]()
    mng: B64 = (1 - gt).to[B64]()
    sg: B64 = when
        gt != 0 => -1.0
        else => 1.0
    off: B64 = B64.from_bits(CM_BF16_ATAN2PI_OFF.getitem(i))
    zx: B64 = fx.to[B64]()
    zy: B64 = fy.to[B64]()
    # z = x/y if |y| > |x|, and z = y/x otherwise
    z: B64 = (mg *! zx +! mng *! zy) /! (mg *! zy +! mng *! zx)
    z2: B64 = z *! z
    r: B64 = when
        z2 > 0x1p-54 =>
            # a rational approximation of atan(z)/(pi z), skipped for an extremely small z, where its terms
            # could underflow spuriously
            z4: B64 = z2 *! z2
            z8: B64 = z4 *! z4
            cn0: B64 = 0x1.45f306dc9c883p-2 +! z2 *! 0x1.988d83a142adap-1
            cn2: B64 = 0x1.747bebf492057p-1 +! z2 *! 0x1.2cc5645094ff3p-2
            cn4: B64 = 0x1.a0521c711ab66p-5 +! z2 *! 0x1.881b8058b9a0dp-9
            cn6: B64 = 0x1.b16ff514a0afp-16
            n0: B64 = cn0 +! z4 *! cn2
            n4: B64 = cn4 +! z4 *! cn6
            n: B64 = n0 +! z8 *! n4
            cd0: B64 = 0x1p+0 +! z2 *! 0x1.6b8b143a3f6dap+1
            cd2: B64 = 0x1.8421201d18ed5p+1 +! z2 *! 0x1.8221d086914ebp+0
            cd4: B64 = 0x1.670657e3a07bap-2 +! z2 *! 0x1.0f4951fd1e72dp-5
            cd6: B64 = 0x1.b3874b8798286p-11
            m0: B64 = cd0 +! z4 *! cd2
            m4: B64 = cd4 +! z4 *! cd6
            m: B64 = m0 +! z8 *! m4
            becomes n /! m
        else => 0x1.45f306dc9c883p-2
    res: B64 = z *! sg *! r +! off
    rb: U64 = res.bits()
    # The slow path runs only when |res| > 2^-149 and the fast path can't decide the rounding.
    if rb << 1 <= 0x6D40000000000000 or (rb +% 8) & 0xFFFFFFF > 16
        return res.to_unchecked[BF16]()
    if ax == ay
        return cm_bf16_atan2pi_diagonal(uy, ux).to_unchecked[BF16]()

    # redo it in double-double
    num: B64 = when
        gt != 0 => zx
        else => zy
    den: B64 = when
        gt != 0 => zy
        else => zx
    zh: B64 = num /! den
    zl: B64 = zh.mul_add_unchecked(a: -den, b: num) /! den
    zz: CmBf16Atan2PiDD = cm_bf16_atan2pi_muldd(xh: zh, xl: zl, ch: zh, cl: zl)
    p0: CmBf16Atan2PiDD = cm_bf16_atan2pi_polydd(xh: zz.hi, xl: zz.lo)
    p: CmBf16Atan2PiDD = cm_bf16_atan2pi_muldd(xh: zh *! sg, xl: zl *! sg, ch: p0.hi, cl: p0.lo)
    sh: B64 = p.hi +! off
    sl: B64 = off -! sh +! p.hi +! p.lo
    th: B64 = sh.to_unchecked[B32]().to[B64]()
    tm: B64 = sh -! th +! sl
    rr: B64 = th +! tm
    dd: B64 = rr -! th
    if dd.bits() << 12 == 0
        # rr - th is a power of two, so rr may sit on a rounding boundary: move it a little toward th + tm
        ad: B64 = dd.abs()
        am: B64 = tm.abs()
        if ad > am
            return (rr -! dd *! 0x1p-10).to_unchecked[BF16]()
        if ad < am
            return (rr +! dd *! 0x1p-10).to_unchecked[BF16]()
    # rounded straight to BF16, which avoids a double rounding
    return rr.to_unchecked[BF16]()

### atan2pi on the diagonal |y| = |x|: 1/4, 3/4, -1/4 or -3/4 by the signs.
### :param uy: The B32 bits of y.
### :param ux: The B32 bits of x.
### :returns: The exact result.
secret routine cm_bf16_atan2pi_diagonal(uy: U32, ux: U32) -> B32
    return when (uy >> 31) * 2 + (ux >> 31)
        0 => 0.25
        1 => 0.75
        2 => -0.25
        else => -0.75

### The double-double product (xh + xl) (ch + cl), without the low parts' product.
### :param xh: The first factor's high part.
### :param xl: The first factor's low part.
### :param ch: The second factor's high part.
### :param cl: The second factor's low part.
### :returns: The product as a double-double.
secret routine cm_bf16_atan2pi_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmBf16Atan2PiDD
    ahlh: B64 = ch *! xl
    alhh: B64 = cl *! xh
    ahhh: B64 = ch *! xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) +! (alhh +! ahlh)
    hi: B64 = ahhh +! ahhl
    return CmBf16Atan2PiDD(hi: hi, lo: ahhh -! hi +! ahhl)

### The 32-term double-double polynomial of CM_BF16_ATAN2PI_C at xh + xl, by Horner's rule.
### :param xh: The argument's high part.
### :param xl: The argument's low part.
### :returns: The polynomial's value as a double-double.
secret routine cm_bf16_atan2pi_polydd(xh: B64, xl: B64) -> CmBf16Atan2PiDD
    hi0: B64 = B64.from_bits(CM_BF16_ATAN2PI_C.getitem(62))
    lo0: B64 = B64.from_bits(CM_BF16_ATAN2PI_C.getitem(63))

    until k == 0 with k: U64 = 31, ch: B64 = hi0, cl: B64 = lo0
        j: U64 = k - 1
        m: CmBf16Atan2PiDD = cm_bf16_atan2pi_muldd(xh, xl, ch, cl)
        c0: B64 = B64.from_bits(CM_BF16_ATAN2PI_C.getitem(j * 2))
        c1: B64 = B64.from_bits(CM_BF16_ATAN2PI_C.getitem(j * 2 + 1))
        th: B64 = m.hi +! c0
        tl: B64 = c0 -! th +! m.hi
        continue with k: j, ch: th, cl: m.lo +! (tl +! c1)
    then
        return CmBf16Atan2PiDD(hi: ch, lo: cl)
