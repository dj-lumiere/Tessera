    0xBF331B0C, 0xBF7FF181, 0xBD2C40FB, 0x3DAC19F9, 0x3E2B7E22, 0x3EA91216, 0x3F1F9631]

### B32 bits of cos(2^(5 + i)) (i = the index) for the sine, a few values nudged so that fewer inputs round wrongly.
secret preset CM_BF16_SIN_C3: &Array[U32, 123] <- [0x3F558FAA, 0x3EC8A183, 0xBF31619F, 0xBD22FBA3,
    0xBF7F3079, 0x3F7CC335, 0x3F7321CA, 0x3F4DD254, 0x3E95EA1F, 0xBF541AD1, 0x3EBEF1B5, 0xBF38CA2A,
    0x3D2C676B, 0xBF7F17CA, 0x3F7C60CC, 0x3F719D6D, 0x3F481391, 0x3E62F4A2, 0xBF66D965, 0x3F2056B4,
    0xBE5C9C0D, 0xBF683C6D, 0x3F255B29, 0xBE298AEA, 0xBF71F6E9, 0x3F4965A3, 0x3E738617, 0xBF630B04,
    0x3F12B918, 0xBEAFA16C, 0xBF43C0F5, 0x3E2D7C30, 0xBF714DDD, 0x3F46E765, 0x3E54560D, 0xBF69FC2C,
    0x3F2BBA00, 0xBDCCDFCD, 0xBF7AE054, 0x3F6BB5D3, 0x3F320EA5, 0xBD04F439, 0xBF7F75E6, 0x3F7DD82F,
    0x3F776A06, 0x3F5E3B89, 0x3F01D69D, 0xBEF89807, 0xBF074C8C, 0xBEE1F8B4, 0xBF1C4471, 0xBE827211,
    0xBF5EC3FA, 0x3F03B0F7, 0xBEF105A4, 0xBF0E8A30, 0xBEC289A0, 0xBF361590, 0x3C41551C, 0xBF7FEDC0,
    0x3F7FB702, 0x3F7EDC31, 0x3F7B735E, 0x3F6DF6DC, 0x3F3A6603, 0x3D770CB4, 0xBF7E232D, 0x3F7893A4,
    0x3F62BCC6, 0x3F11A3B3, 0xBEB4949C, 0xBF404F58, 0x3E03B8DF, 0xBF778729, 0x3F5EAC30, 0x3F035E2F,
    0xBEF259E5, 0xBF0D48F6, 0xBEC81A32, 0xBF31CB87, 0xBD109D9C, 0xBF7F5C9D, 0x3F7D7343, 0x3F75DA0D,
    0x3F58362D, 0x3EDA6DDC, 0xBF22D05B, 0xBE439D17, 0xBF6D50E9, 0x3F37FDD5, 0x3D079C38, 0xBF7F7054,
    0x3F7DC1F0, 0x3F7711CF, 0x3F5CE6BF, 0x3EFA75A0, 0xBF057B07, 0xBEE99BBF, 0xBF15698F, 0xBEA32FCE,
    0xBF4BFD0B, 0x3E8A2D27, 0xBF5AB5A5, 0x3EEB6778, 0xBF13C470, 0xBEAAD341, 0xBF470160, 0x3E559914,
    0xBF69B8FD, 0x3F2AC485, 0xBDE1668D, 0xBF79CC54, 0x3F677E3F, 0x3F22AA29, 0xBE45219B, 0xBF6D0668,
    0x3F36E9BB, 0x3CAC4ABD, 0xBF7FC606, 0x3F7F1831, 0x3F7C6269, 0x3F71A3C8, 0x3F482B8F]

### The sine of `me` (in radians), correctly rounded (to nearest, ties to even). +-0 comes back unchanged,
### +-inf gives NaN, and a NaN comes back quiet.
### :returns: sin(`me`).
routine BF16.sin() -> Me
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    sign: B32 = when

        au == u => 1.0
        else => -1.0

    # for |x| <= 0x1.dp-4, sin(x) rounds to x
    if au <= 0x3DE8
        if au == 0
            return me
        # for |x| = 0x1p-126, x * 0x1.fffffep-1 would underflow spuriously
        tiny: B32 = 0x1.fffffcp-127
        small: B32 = when
            au == 0x80 => sign *! tiny
            else => me.to[B32]() *! 0x1.fffffep-1
        return small.to_unchecked[Me]()
    if au < 0x4580
        # |x| < 4096, the exponent lies in [123, 138], and 0x3D80 is 123 << 7
        i1: U16 = (au - 0x3D80) >> 3
        i2: U16 = (((au - 0x3D80) >> 7) << 3) | (au & 0x7)
        s1: B32 = .from_bits(CM_BF16_SIN_S1.getitem(i1.to[U64]()))
        c1: B32 = .from_bits(CM_BF16_SIN_C1.getitem(i1.to[U64]()))
        s2: B32 = .from_bits(CM_BF16_SIN_S2.getitem(i2.to[U64]()))
        c2: B32 = .from_bits(CM_BF16_SIN_C2.getitem(i2.to[U64]()))
        res: B32 = s1.mul_add_unchecked(a: c2, b: c1 *! s2)  # the fma fixes the evaluation order
        return (sign *! res).to_unchecked[Me]()
    if au >> 7 == 0xFF
        # NaN or infinity: like the C code's 0x7FC0 + x, a NaN comes back quiet with its payload and an infinity
        # gives the quiet NaN 0x7FC0
        if au > 0x7F80
            return me +! me
        return Me.from_bits(0x7FC0)
    # |x| >= 4096, so ulp(x) >= 32 and |x| = b0 2^i + ... + b7 2^(i+7). Start from sin and cos of b7 2^(i+7) and add
    # each other power present with sin(a+b) = sin(a) cos(b) + cos(a) sin(b), cos(a+b) = cos(a) cos(b) - sin(a) sin(b).
    k: U16 = (au >> 7) - 0x8B  # 0 for |x| = 4096
    s7: B32 = .from_bits(CM_BF16_SIN_S3.getitem((k + 7).to[U64]()))  # sin and cos of b7 2^(i+7)
    c7: B32 = .from_bits(CM_BF16_SIN_C3.getitem((k + 7).to[U64]()))
    each j: U16 in 0 til 7 with s: B32 = s7, c: B32 = c7
        if (au >> j) & 1 == 0
            continue with s: s, c: c
        sj: B32 = .from_bits(CM_BF16_SIN_S3.getitem((k + j).to[U64]()))
        cj: B32 = .from_bits(CM_BF16_SIN_C3.getitem((k + j).to[U64]()))
        t: B32 = s.mul_add_unchecked(a: cj, b: c *! sj)
        continue with s: t, c: c.mul_add_unchecked(a: cj, b: -s *! sj)
    then
        return (sign *! s).to_unchecked[Me]()
