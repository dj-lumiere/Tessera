# Tessera stdlib: the BF16 functions that go through B32
#
# These compute with B32's correctly rounded CORE-MATH ports and round once to BF16. Every BF16 input was checked
# against CORE-MATH's own bfloat16 functions, bit for bit, so the results are the correctly rounded ones (only the
# sign and payload of a NaN may differ). CORE-MATH's bfloat16 versions of these are slower than going through B32,
# so these use B32.

module System/Numerics/BF16

### The inverse hyperbolic sine, correctly rounded (to nearest, ties to even).
### :returns: asinh(`me`).
routine BF16.asinh() -> Me
    r: Me = me.to[B32]().asinh().to_unchecked[Me]()
    return r

### cos(pi * `me`), correctly rounded (to nearest, ties to even).
### :returns: cos(pi * `me`), NaN for an infinity or NaN.
routine BF16.cos_pi() -> Me
    r: Me = me.to[B32]().cos_pi().to_unchecked[Me]()
    return r

### The error function, correctly rounded (to nearest, ties to even).
### :returns: erf(`me`), in [-1, 1].
routine BF16.erf() -> Me
    r: Me = me.to[B32]().erf().to_unchecked[Me]()
    return r

### 1 - erf(`me`), accurate where erf is near 1, correctly rounded (to nearest, ties to even).
### :returns: erfc(`me`), in [0, 2].
routine BF16.erfc() -> Me
    r: Me = me.to[B32]().erfc().to_unchecked[Me]()
    return r

### ln(1 + `me`), accurate near 0, correctly rounded (to nearest, ties to even).
### :returns: ln(1 + `me`): -inf at -1, NaN below it.
routine BF16.ln_1p_unchecked() -> Me
    r: Me = me.to[B32]().ln_1p_unchecked().to_unchecked[Me]()
    return r

### The logarithm of the absolute value of the gamma function, correctly rounded (to nearest, ties to even).
### :returns: ln |Γ(`me`)|: +inf at 0 and the negative integers.
routine BF16.ln_gamma_unchecked() -> Me
    r: Me = me.to[B32]().ln_gamma_unchecked().to_unchecked[Me]()
    return r

### The gamma function, correctly rounded (to nearest, ties to even).
### :returns: Γ(`me`): ±inf at ±0, NaN at the negative integers and -inf.
routine BF16.gamma_unchecked() -> Me
    r: Me = me.to[B32]().gamma_unchecked().to_unchecked[Me]()
    return r
