# Tessera stdlib: the correctly rounded two-argument arc tangent of BF16
#
# The BF16 arguments widen exactly to B32 and run the B32 atan2 algorithm: atan2(y, x) is off + atan(z), with z = y/x
# or -x/y (whichever is at most 1 in magnitude) and off a multiple of pi/2 picked by the signs and by which of |y|,
# |x| is larger. A degree-6/6 rational approximation in B64 settles most inputs. The rest go through a double-double
# polynomial, and a tiny ratio y/x through z - z^3/3. The final B64 value is rounded straight to BF16 (never through
# B32, which would round twice). Round to nearest only. Zeros and infinities follow C99, and a NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/atan2/atan2_bf16.c.
# Copyright (c) 2022-2025 Alexei Sibidanov and Paul Zimmermann.
# MIT license: see LICENSE-CORE-MATH

module System/Numerics/BF16

### Offsets added to the reduced arc tangent, indexed by (sign of y) 4 + (sign of x) 2 + (|y| > |x|), as B64 bits:
### 0, pi/2, pi, pi/2, -0, -pi/2, -pi, -pi/2.
secret preset CM_BF16_ATAN2_OFF: Items[U64, 8] = [0x0000000000000000, 0x3FF921FB54442D18,
    0x400921FB54442D18, 0x3FF921FB54442D18, 0x8000000000000000, 0xBFF921FB54442D18,
    0xC00921FB54442D18, 0xBFF921FB54442D18]

### Low parts of the offsets in CM_BF16_ATAN2_OFF (pi/2 minus its B64 rounding, twice that for pi), as B64 bits.
secret preset CM_BF16_ATAN2_OFFL: Items[U64, 8] = [0x0000000000000000, 0x3C91A62633145C07,
    0x3CA1A62633145C07, 0x3C91A62633145C07, 0x8000000000000000, 0xBC91A62633145C07,
    0xBCA1A62633145C07, 0xBC91A62633145C07]

### Double-double coefficients (high and low parts interleaved) of the accurate polynomial for atan(z)/z in z^2, as B64 bits.
secret preset CM_BF16_ATAN2_C: Items[U64, 64] = [0x3FF0000000000000, 0xBA88C1DAC5492248,
    0xBFD5555555555555, 0xBC755553BF3A2ABE, 0x3FC999999999999A, 0xBC699DEED1EC9071,
    0xBFC2492492492492, 0xBC5FD99C8D18269A, 0x3FBC71C71C71C717, 0xBC2651EEE4C4D9D0,
    0xBFB745D1745D1649, 0xBC5632683D6C44A6, 0x3FB3B13B13B11C63, 0x3C5BF69C1F8AF41D,
    0xBFB11111110E6338, 0x3C23C3E431E8BB68, 0x3FAE1E1E1DC45C4A, 0xBC4BE2DB05C77BBF,
    0xBFAAF286B8164B4F, 0x3C2A4673491F0942, 0x3FA86185E9AD4846, 0x3C4E12E32D79FCEE,
    0xBFA642C6D5161FAE, 0x3C43CE76C1CA03F0, 0x3FA47AD6F277E5BF, 0xBC3ABD8D85BDB714,
    0xBFA2F64A2EE8896D, 0x3C2EF87D4B615323, 0x3FA1A6A2B31741B5, 0x3C1A5D9D973547EE,
    0xBFA07FBDAD65E0A6, 0xBC265AC07F5D35F4, 0x3F9EE9932A9A5F8B, 0x3C2F8B9623F6F55A,
    0xBF9CE8B5B9584DC6, 0x3C2FE5AF96E8EA2D, 0x3F9AC9CB288087B7, 0xBC3450CDFCEAF5CA,
    0xBF984B025351F3E6, 0x3C2579561B0D73DA, 0x3F952F5B8ECDD52B, 0x3C3036BD2C6FBA47,
    0xBF9163A8C44909DC, 0x3C318F735FFB9F16, 0x3F8A400DCE3EEA6F, 0xBC2C90569C0C1B5C,
    0xBF81CAA78AE6DB3A, 0xBC24C60F8161EA09, 0x3F752672453C0731, 0x3C1834EFB598C338,
    0xBF65850C5BE137CF, 0xBC0445FC150CA7F5, 0x3F523EB98D22E1CA, 0xBBF388FBAF1D7830,
    0xBF38F4E974A40741, 0x3BD271198A97DA34, 0x3F1A5CF2E9CF76E5, 0xBBB887EB4A63B665,
    0xBEF420C270719E32, 0x3B8EFD595B27888B, 0x3EC3BA2D69B51677, 0xBB64FB06829CDFC7,
    0xBE829B7E6F676385, 0xBB2A783B6DE718FB]

### A double-double number hi + lo, the result of the helpers of BF16.atan2.
secret record CmBf16Atan2DD
    ### The high part.
    hi: B64
    ### The low part, below the last bit of `hi`.
    lo: B64

### The angle of the point (`x`, `y`) in radians, in [-pi, pi], correctly rounded (to nearest, ties to even).
### Zeros and infinities follow C99: atan2(+-0, +0) is +-0, atan2(+-0, -0) is +-pi,
### atan2(+-inf, +inf) is +-pi/4, atan2(+-inf, -inf) is +-3pi/4. A NaN in either argument gives a quiet NaN.
### :param y: The y coordinate.
### :param x: The x coordinate.
### :returns: atan2(`y`, `x`).
routine atan2(y: BF16, x: BF16) -> BF16
    fy: B32 = y.to[B32]()
    fx: B32 = x.to[B32]()
    ux: U32 = fx.bits()
    uy: U32 = fy.bits()
    ax: U32 = ux & 0x7FFFFFFF
    ay: U32 = uy & 0x7FFFFFFF
    sy: B64 = when

        uy >> 31 != 0 => -1.0
        else => 1.0

    if ay >= 0x7F800000 or ax >= 0x7F800000
        # x or y is NaN or an infinity. x + y gives the quiet NaN of either NaN argument.
        if ay > 0x7F800000 or ax > 0x7F800000
            return (fx +! fy).to_unchecked[BF16]()
        yinf: Bool = ay == 0x7F800000
        xinf: Bool = ax == 0x7F800000
        if yinf and xinf
            # +-3pi/4 or +-pi/4
            if ux >> 31 != 0
                return B64.mul_unchecked(0x1.2d97c7f3321d2p+1, sy).to_unchecked[BF16]()
            return B64.mul_unchecked(0x1.921fb54442d18p-1, sy).to_unchecked[BF16]()
        if xinf
            if ux >> 31 != 0
                return B64.mul_unchecked(0x1.921fb54442d18p+1, sy).to_unchecked[BF16]()
            return B64.mul_unchecked(0.0, sy).to_unchecked[BF16]()
        return B64.mul_unchecked(0x1.921fb54442d18p+0, sy).to_unchecked[BF16]()
    if ay == 0
        if ax == 0
            # both zero: +-0 or +-pi by the signs
            iz: U64 = ((uy >> 31) * 4 + (ux >> 31) * 2).to[U64]()
            off0: B64 = B64.from_bits(CM_BF16_ATAN2_OFF.getitem(iz))
            if ux >> 31 != 0
                return (off0 +! B64.from_bits(CM_BF16_ATAN2_OFFL.getitem(iz))).to_unchecked[BF16]()
            return off0.to_unchecked[BF16]()
        if ux >> 31 == 0
            return B64.mul_unchecked(0.0, sy).to_unchecked[BF16]()

    gt: U32 = (ay > ax).to[U32]()
    i: U64 = ((uy >> 31) * 4 + (ux >> 31) * 2 + gt).to[U64]()
    mg: B64 = gt.to[B64]()
    mng: B64 = (1 - gt).to[B64]()
    sg: B64 = when
        gt != 0 => -1.0
        else => 1.0
    off: B64 = B64.from_bits(CM_BF16_ATAN2_OFF.getitem(i))
    zx: B64 = fx.to[B64]()
    zy: B64 = fy.to[B64]()
    # z = x/y if |y| > |x|, and z = y/x otherwise
    z: B64 = (mg *! zx +! mng *! zy) /! (mg *! zy +! mng *! zx)
    d: S32 = ax.to[S32]() - ay.to[S32]()
    r: B64 = when
        -0x0D800000 < d < 0x0D800000 =>
            # The exponents differ by less than 27: a rational approximation of atan(z)/z. z2 can't underflow (for
            # |y| = 2^-149 and |x| near 2^128, |z| > 2^-277), z4 and z8 may.
            z2: B64 = z *! z
            z4: B64 = z2 *! z2
            z8: B64 = z4 *! z4
            cn0: B64 = 0x1p+0 +! z2 *! 0x1.40e0698f94c35p+1
            cn2: B64 = 0x1.248c5da347f0dp+1 +! z2 *! 0x1.d873386572976p-1
            cn4: B64 = 0x1.46fa40b20f1dp-3 +! z2 *! 0x1.33f5e041eed0fp-7
            cn6: B64 = 0x1.546bbf28667c5p-14
            n0: B64 = cn0 +! z4 *! cn2
            n4: B64 = cn4 +! z4 *! cn6
            n: B64 = n0 +! z8 *! n4
            cd0: B64 = 0x1p+0 +! z2 *! 0x1.6b8b143a3f6dap+1
            cd2: B64 = 0x1.8421201d18ed5p+1 +! z2 *! 0x1.8221d086914ebp+0
            cd4: B64 = 0x1.670657e3a07bap-2 +! z2 *! 0x1.0f4951fd1e72dp-5
            cd6: B64 = 0x1.b3874b8798286p-11
            m0: B64 = cd0 +! z4 *! cd2
            m4: B64 = cd4 +! z4 *! cd6
            m: B64 = m0 +! z8 *! m4
            becomes n /! m
        else => 1.0
    res: B64 = z *! sg *! r +! off
    if (res.bits() +% 8) & 0xFFFFFFF > 16
        return res.to_unchecked[BF16]()

    # The fast path can't decide the rounding.
    # a tiny y/x: the exponents differ by 25 or more
    if ay < ax and (ax - ay) >> 23 >= 25
        return cm_bf16_atan2_tiny(fy, fx)
    # redo it in double-double
    num: B64 = when
        gt != 0 => zx
        else => zy
    den: B64 = when
        gt != 0 => zy
        else => zx
    zh: B64 = num /! den
    zl: B64 = zh.mul_add_unchecked(a: -den, b: num) /! den
    z2: CmBf16Atan2DD = cm_bf16_atan2_muldd(xh: zh, xl: zl, ch: zh, cl: zl)
    p0: CmBf16Atan2DD = cm_bf16_atan2_polydd(xh: z2.hi, xl: z2.lo)
    p: CmBf16Atan2DD = cm_bf16_atan2_muldd(xh: zh *! sg, xl: zl *! sg, ch: p0.hi, cl: p0.lo)
    offl: B64 = B64.from_bits(CM_BF16_ATAN2_OFFL.getitem(i))
    sh: B64 = p.hi +! off
    sl: B64 = off -! sh +! p.hi +! p.lo +! offl
    th: B64 = sh.to_unchecked[B32]().to[B64]()
    tm: B64 = sh -! th +! sl
    if th +! th *! 0x1p-60 == th -! th *! 0x1p-60
        # th +- th 2^-60 rounds to th: push tm away from the rounding boundary, by a quarter of the unit 2^-24 th
        tthu: U64 = (th.bits() & 0x7FF0000000000000) - 0x0180000000000000
        scaled: B64 = when
            tm.abs() > B64.from_bits(tthu) => tm *! 1.25
            else => tm *! 0.75
        return (th +! scaled).to_unchecked[BF16]()
    # rounded straight to BF16, which avoids a double rounding
    return (th +! tm).to_unchecked[BF16]()

### The double-double product (xh + xl) (ch + cl), without the low parts' product.
### :param xh: The first factor's high part.
### :param xl: The first factor's low part.
### :param ch: The second factor's high part.
### :param cl: The second factor's low part.
### :returns: The product as a double-double.
secret routine cm_bf16_atan2_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmBf16Atan2DD
    ahlh: B64 = ch *! xl
    alhh: B64 = cl *! xh
    ahhh: B64 = ch *! xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) +! (alhh +! ahlh)
    hi: B64 = ahhh +! ahhl
    return CmBf16Atan2DD(hi: hi, lo: ahhh -! hi +! ahhl)

### The 32-term double-double polynomial of CM_BF16_ATAN2_C at xh + xl, by Horner's rule.
### :param xh: The argument's high part.
### :param xl: The argument's low part.
### :returns: The polynomial's value as a double-double.
secret routine cm_bf16_atan2_polydd(xh: B64, xl: B64) -> CmBf16Atan2DD
    hi0: B64 = B64.from_bits(CM_BF16_ATAN2_C.getitem(62))
    lo0: B64 = B64.from_bits(CM_BF16_ATAN2_C.getitem(63))

    until k == 0 with k: U64 = 31, ch: B64 = hi0, cl: B64 = lo0
        j: U64 = k - 1
        m: CmBf16Atan2DD = cm_bf16_atan2_muldd(xh, xl, ch, cl)
        c0: B64 = B64.from_bits(CM_BF16_ATAN2_C.getitem(j * 2))
        c1: B64 = B64.from_bits(CM_BF16_ATAN2_C.getitem(j * 2 + 1))
        th: B64 = m.hi +! c0
        tl: B64 = c0 -! th +! m.hi
        continue with k: j, ch: th, cl: m.lo +! (tl +! c1)
    then
        return CmBf16Atan2DD(hi: ch, lo: cl)

### atan2(y, x) for a tiny ratio y/x, from z - z^3/3 with z = y/x, rounded once to BF16. When z sits on a rounding
### boundary its last bit moves toward the correction, so the final rounding is not a tie.
### :param y: The y coordinate.
### :param x: The x coordinate.
### :returns: The angle, rounded to BF16.
secret routine cm_bf16_atan2_tiny(y: B32, x: B32) -> BF16
    dy: B64 = y.to[B64]()
    dx: B64 = x.to[B64]()
    z: B64 = dy /! dx
    # z x + e = y, so y/x = z + e/x
    e: B64 = (-z).mul_add_unchecked(a: dx, b: dy)
    zz: B64 = z *! z
    # -1/3 rounded to nearest
    cz: B64 = B64.mul_unchecked(-0x1.5555555555555p-2, z)
    corr: B64 = e /! dx +! cz *! zz
    t: U64 = z.bits()
    if t & 0xFFFFFFF == 0
        # z and the correction of the same sign move z up, of different signs down
        if z *! corr > 0.0
            return B64.from_bits(t + 1).to_unchecked[BF16]()
        return B64.from_bits(t - 1).to_unchecked[BF16]()
    return z.to_unchecked[BF16]()
