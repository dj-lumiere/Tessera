# Tessera stdlib: the correctly rounded inverse hyperbolic cosine of BF16
#
# acosh(x) = log(x + sqrt(x^2 - 1)) for x >= 1, evaluated in B32, with large x using log(x) + log(2). The log of y =
# 2^k m (1 <= m < 2) is k log(2) + log(1 + i/2^6) + log(1 + t), with i the upper 6 bits of m's mantissa, both
# log(1 + i/2^6) and 1/(1 + i/2^6) tabulated, and log(1 + t) approximated by t. Round to nearest only: acosh(1) =
# +0, +inf maps to itself, x < 1 gives NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/acosh/acosh_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/BF16

### B32 bit patterns of log(1 + i/2^6), rounded to nearest, for 0 <= i < 2^6, with a few entries adjusted so that every
### input rounds correctly.
secret preset CM_BF16_ACOSH_T1: @Array[U32, 64] <- [0x00000000, 0x3C7E0546, 0x3CFC14D8, 0x3D3BA2C8, 0x3D785186, 0x3D9A0EBD,
    0x3DB78694, 0x3DD4936A, 0x3DF1383B, 0x3E06BBF4, 0x3E14AA98, 0x3E22695B, 0x3E2FF984, 0x3E3D5C48, 0x3E4A92D5,
    0x3E579A5A, 0x3E647FBE, 0x3E71383B, 0x3E7DC8C3, 0x3E851927, 0x3E8B3AE5, 0x3E914A10, 0x3E974716, 0x3E9D3263,
    0x3EA30C5E, 0x3EA8D56C, 0x3EAE8DEE, 0x3EB43641, 0x3EB9CEC0, 0x3EBF57C2, 0x3EC4D19C, 0x3ECA3C74, 0x3ECF991F,
    0x3ED4E765, 0x3EDA27BC, 0x3EDF5A6D, 0x3EE47FBE, 0x3EE997F4, 0x3EEEA350, 0x3EF3A213, 0x3EF8947B, 0x3EFD7AC4,
    0x3F012A95, 0x3F0391F3, 0x3F05F397, 0x3F084F9D, 0x3F0AA61F, 0x3F0CF736, 0x3F0F42FB, 0x3F118987, 0x3F13CAF1,
    0x3F16074F, 0x3F183EBA, 0x3F1A7145, 0x3F1C9F07, 0x3F1EC813, 0x3F20EC7F, 0x3F230C5E, 0x3F2527C3, 0x3F273EC1,
    0x3F295169, 0x3F2B5FCF, 0x3F2D6A02, 0x3F2F7015]

### B32 bit patterns of 1/(1 + i/2^6), rounded to nearest, for 0 <= i < 2^6.
secret preset CM_BF16_ACOSH_T2: @Array[U32, 64] <- [0x3F800000, 0x3F7C0FC1, 0x3F783E10, 0x3F74898D, 0x3F70F0F1, 0x3F6D7304,
    0x3F6A0EA1, 0x3F66C2B4, 0x3F638E39, 0x3F607038, 0x3F5D67C9, 0x3F5A740E, 0x3F579436, 0x3F54C77B, 0x3F520D21,
    0x3F4F6475, 0x3F4CCCCD, 0x3F4A4588, 0x3F47CE0C, 0x3F4565C8, 0x3F430C31, 0x3F40C0C1, 0x3F3E82FA, 0x3F3C5264,
    0x3F3A2E8C, 0x3F381703, 0x3F360B61, 0x3F340B41, 0x3F321643, 0x3F302C0B, 0x3F2E4C41, 0x3F2C7692, 0x3F2AAAAB,
    0x3F28E83F, 0x3F272F05, 0x3F257EB5, 0x3F23D70A, 0x3F2237C3, 0x3F20A0A1, 0x3F1F1166, 0x3F1D89D9, 0x3F1C09C1,
    0x3F1A90E8, 0x3F191F1A, 0x3F17B426, 0x3F164FDA, 0x3F14F209, 0x3F139A86, 0x3F124925, 0x3F10FDBC, 0x3F0FB824,
    0x3F0E7835, 0x3F0D3DCB, 0x3F0C08C1, 0x3F0AD8F3, 0x3F09AE41, 0x3F088889, 0x3F0767AB, 0x3F064B8A, 0x3F053408,
    0x3F042108, 0x3F03126F, 0x3F020821, 0x3F010204]

### acosh(`me`), correctly rounded (to nearest, ties to even). acosh(1) is +0, +inf maps to itself, a value below 1
### (-inf and -0 included) gives NaN, and a NaN comes back quiet.
### :returns: The inverse hyperbolic cosine of `me`.
routine BF16.acosh_unchecked() -> Me
    local t: B32 = me.to[B32]()
    local u: U32 = t.bits()

    # 0 <= x <= 1, NaN, +-inf or x < 0
    if u <= 0x3F800000 or u >= 0x7F800000
        if u == 0x3F800000
            return 0.0
        # x < 1, a negative NaN included: the invalid-operation NaN that 0.0 / 0.0 gives on x86-64.
        if u < 0x3F800000 or u >= 0x80000000
            return BF16.from_bits(0xFFC0)
        # A positive NaN or +inf
        return me +! me

    # y is the argument of the log, and j counts the log(2) to add.
    local y: @B32 <- t
    local j: @U32 <- 0
    # x <= 0x1.46p+6
    if u <= 0x42A30000
        (t +! t.mul_add_unchecked(a: t, b: -1.0).sqrt_unchecked()).poke_into(y)
    else
        # For large x, log(x + sqrt(x^2 - 1)) is log(x) + log(2) in BF16 precision.
        1.poke_into(j)

    # Now log(y) = k log(2) + log(m), with y = 2^k m and 1 <= m < 2.
    yu: U32 = y.peek().bits()
    k: U32 = (yu >> 23) - 127
    m: B32 = B32.from_bits(yu - (k << 23))
    i: U64 = ((m.bits() >> 17) & 0x3F).to[U64]()
    r: B32 = B32.from_bits(CM_BF16_ACOSH_T2.getitem(i)).mul_add_unchecked(a: m, b: -1.0)
    # log(y) = (j + k) log(2) + T1[i] + log(1 + r), with log(1 + r) approximated by r.
    jk: B32 = (j.peek() + k).to[B32]()
    log2: B32 = 0x1.62e43p-1
    return jk.mul_add_unchecked(a: log2, b: B32.from_bits(CM_BF16_ACOSH_T1.getitem(i)) +! r).to_unchecked[Me]()
