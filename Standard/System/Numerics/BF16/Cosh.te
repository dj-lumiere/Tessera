# Tessera stdlib: the correctly rounded hyperbolic cosine of BF16
#
# x = x1 + x2, where x1 keeps the exponent and the upper 4 bits of the mantissa of |x| and x2 the exponent and the
# lower 3 bits: cosh(x1 + x2) = cosh(x1) cosh(x2) + sinh(x1) sinh(x2), from the B32 tables of BF16.sinh, whose
# combination rounds correctly to BF16. Round to nearest only: +-inf and overflow give +inf, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/cosh/cosh_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/BF16

### cosh(`me`), correctly rounded (to nearest, ties to even), at least 1. +-inf and a result past the BF16 range give
### +inf, and a NaN comes back quiet.
### :returns: The hyperbolic cosine of `me`.
routine BF16.cosh_unchecked() -> Me
    # cosh(-x) = cosh(x), so drop the sign.
    local u: U16 = me.bits() & 0x7FFF

    # For |x| <= 0x1.68p-4, cosh(x) rounds to 1. For x != 0 the B32 value just above 1 marks the result inexact.
    if u <= 0x3DB4
        if u == 0
            return 1.0
        above_one: B32 = 0x1.000002p+0
        return above_one.to_unchecked[Me]()
    # For |x| >= 0x1.66p+6, cosh(x) overflows: this also maps +-inf to +inf and quiets a NaN.
    if u >= 0x42B3
        return (me.to[B32]().abs() *! 0x1p127).to_unchecked[Me]()
    # Now 0x3DB4 < u < 0x42B3: the exponent lies in [123, 133], and 0x3D80 is 123 << 7.
    i1: U16 = (u - 0x3D80) >> 3
    i2: U16 = (((u - 0x3D80) >> 7) << 3) | (u & 0x7)
    s1: B32 = B32.from_bits(CM_BF16_SINH_S1.getitem(i1.to[U64]()))
    c1: B32 = B32.from_bits(CM_BF16_SINH_C1.getitem(i1.to[U64]()))
    s2: B32 = B32.from_bits(CM_BF16_SINH_S2.getitem(i2.to[U64]()))
    c2: B32 = B32.from_bits(CM_BF16_SINH_C2.getitem(i2.to[U64]()))
    # The fused multiply-add fixes the evaluation order.
    return c1.mul_add_unchecked(a: c2, b: s1 *! s2).to_unchecked[Me]()
