# Tessera stdlib: the correctly rounded 2^x - 1 of BF16
#
# For |x| <= 0x1.7p-9 the Taylor expansion ln(2) x + (ln(2) x)^2/2 in B32. Otherwise x = x1 + x2, where x1 keeps the
# sign, the exponent and the upper 4 bits of the mantissa and x2 the exponent and the lower 3 bits:
# 2^x - 1 = 2^x1 2^x2 - 1, both factors read from the 2^x tables, combined with one fused multiply-add. Round to
# nearest only: overflow gives +inf, large negative x gives -1, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/exp2m1/exp2m1_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/System/Numerics/BF16

### ln(2) rounded to B32.
secret preset CM_BF16_EXP2M1_LOG2: B32 = 0x1.62e43p-1

### 2^`me` - 1, accurate near 0 and correctly rounded (to nearest, ties to even). Overflow gives +inf, a large negative
### `me` and -inf give -1, and NaN comes back quiet.
### :returns: 2^`me` - 1.
routine BF16.exp2_m1_unchecked() -> Me
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    # |x| <= 0x1.7p-9
    if au <= 0x3B38
        if au == 0
            return me
        # |x| = 0x1.7p-126: the result is written out to avoid a spurious underflow.
        if au == 0xB8
            if au == u
                r: B32 = 0x1.fe3p-127
                return r.to_unchecked[Me]()
            r: B32 = -0x1.fe3p-127
            return r.to_unchecked[Me]()
        # The Taylor expansion of 2^x - 1 is ln(2) x + ln(2)^2/2 x^2, the square term only matters above
        # 0x1.7p-125.
        t: B32 = CM_BF16_EXP2M1_LOG2 *! me.to[B32]()
        if au <= 0x138
            return t.to_unchecked[Me]()
        return t.mul_add_unchecked(a: 0.5 *! t, b: t).to_unchecked[Me]()
    # |x| >= 128
    if au >= 0x4300
        if au >= 0x7F80
            if u == 0xFF80
                return -1.0
            return me +! me
        if au == u
            return (me.to[B32]() *! 0x1.fffffep+120).to_unchecked[Me]()
        r: B32 = -0x1.fffffep-1
        return r.to_unchecked[Me]()
    # The exponent lies in [118, 133], so au takes 11 bits.
    sign: U16 = u >> 15
    i1: U16 = (sign << 8) + (au >> 3) - 0x760
    i2: U16 = (sign << 7) + (((au >> 7) << 3) | (au & 0x7)) - 0x3B0
    t1: B32 = B32.from_bits(CM_BF16_EXP2_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_EXP2_T2.getitem(i2.to[U64]()))
    return t1.mul_add_unchecked(a: t2, b: -1.0).to_unchecked[Me]()
