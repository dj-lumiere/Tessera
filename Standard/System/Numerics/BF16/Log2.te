### The base-2 logarithm log2(`me`), correctly rounded (to nearest, ties to even). log2(+-0) = -inf, a negative `me`
### (-inf and a negative NaN included) gives the quiet NaN, log2(+inf) = +inf, and a positive NaN comes back quiet.
### :returns: log2(`me`).
routine BF16.log2_unchecked() -> Me
    u: U16 = me.bits()
    i1: U16 = u >> 7
    i2: U16 = u & 0x7F
    if u >> 15 != 0
        # -0 gives -inf, every other negative x (a negative NaN included) gives the quiet NaN.
        if u == 0x8000
            return -inf
        return nan
    if u >> 7 == 0xFF
        # +inf or a positive NaN
        return me +! me
    if i1 == 0
        # subnormal or +0
        return B32.from_bits(CM_BF16_LOG2_T3.getitem(i2.to[U64]())).to_unchecked[Me]()
    t1: B32 = B32.from_bits(CM_BF16_LOG2_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_LOG2_T2.getitem(i2.to[U64]()))
    return (t1 +! t2).to_unchecked[Me]()
