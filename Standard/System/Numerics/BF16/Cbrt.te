### cbrt(`me`), correctly rounded (to nearest, ties to even), defined for every input: negative values give negative
### roots. +-0 and +-inf map to themselves, and a NaN comes back quiet.
### :returns: The cube root of `me`.
routine BF16.cbrt() -> Me
    local u: U16 = me.bits()
    local au: U16 = u & 0x7FFF
    local i1: U16 = au >> 7
    local i2: U16 = au & 0x7F

    # NaN or +-inf
    if au >> 7 == 0xFF
        return me +! me

    # The exact cases in the normal range are 0x1p+0 (encoding 0x3F80), 0x1.f4p+0 (0x3FFA) and 0x1.bp+1 (0x4058),
    # times 8^k. For the first two the exponent part 2^(3k) has an exact table entry, and T2 is exact for 1 and
    # 0x1.f4p+0, so the product below is exact. Only the third needs care.
    e: U16 = au >> 7
    e3: U16 = e % 3
    if au & 0x7F == 0x58 and e3 == 2
        # 0x1.8p+0 with x's sign, its exponent raised by (e - 128) / 3, which divides exactly.
        q: S32 = (e.to[S32]() - 0x80).div_trunc(3)
        r: U16 = ((u & 0x8000) | 0x3FC0) +% (q.to_wrap[U16]() << 7)
        return Me.from_bits(r)

    sgn: B32 = when
        u >> 15 == 1 => -1.0
        else => 1.0
    # subnormal case
    if i1 == 0
        return (sgn *! B32.from_bits(CM_BF16_CBRT_T3.getitem(i2.to[U64]()))).to_unchecked[Me]()
    t1: B32 = B32.from_bits(CM_BF16_CBRT_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_CBRT_T2.getitem(i2.to[U64]()))
    return (sgn *! t1 *! t2).to_unchecked[Me]()
