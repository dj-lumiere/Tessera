# Tessera stdlib: correctly rounded arc tangent of B128
#
# Ported from CORE-MATH, src/binary128/atan/atanq.c via RazorForge's B128Atan.rf.
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH
#
# B128.atan(x) is the exact arc tangent rounded to nearest, ties to even. |x| below 2^-57
# returns x and |x| above 2^115 returns ±π/2 (both already correctly rounded). Otherwise |x| (or
# 1/|x| past 1) is reduced against a table angle atan(t) with t = TN[i] / 2^15 to
# (|x| - t) / (1 + |x| t), whose series runs in AtanShared.te. The table angle is added back
# (and taken from π/2 past 1). NaN in gives NaN out, quieted, the payload kept.

module Standard/System/Numerics/B128

### |x| in [2^-e, 2^-e+1) for e <= 7: the first guess of the table index from the top mantissa bits
secret preset CM_ATAN_INDL: @Array[U64, 128] <- [0, 0, 1, 1, 2, 3, 3, 4, 5, 5, 6, 6, 7, 8, 8, 9, 10, 10,
    11, 12, 12, 13, 13, 14, 15, 15, 16, 16, 17, 18, 18, 19, 19, 20, 21, 21, 22, 22, 23, 24, 24, 25,
    25, 26, 26, 27, 28, 28, 29, 29, 30, 30, 31, 31, 32, 33, 33, 34, 34, 35, 35, 36, 36, 37, 37, 38,
    38, 39, 39, 40, 40, 41, 41, 42, 42, 43, 43, 44, 44, 45, 45, 45, 46, 46, 47, 47, 48, 48, 49, 49,
    49, 50, 50, 51, 51, 52, 52, 52, 53, 53, 54, 54, 54, 55, 55, 55, 56, 56, 57, 57, 57, 58, 58, 58,
    59, 59, 59, 60, 60, 61, 61, 61, 62, 62, 62, 63, 63, 63]

### |x| in [2^e, 2^e+1) for e <= 6: the first guess from the complemented top mantissa bits
secret preset CM_ATAN_INDH: @Array[U64, 128] <- [0, 0, 1, 1, 2, 2, 3, 4, 5, 5, 5, 6, 6, 7, 8, 9, 10, 10,
    10, 11, 11, 11, 12, 12, 13, 14, 14, 15, 16, 16, 17, 18, 19, 20, 20, 20, 21, 21, 21, 22, 22, 23,
    23, 23, 24, 24, 25, 25, 26, 26, 27, 27, 28, 29, 29, 30, 31, 31, 32, 33, 34, 34, 35, 36, 37, 38,
    38, 38, 38, 39, 39, 39, 39, 40, 40, 40, 41, 41, 41, 41, 42, 42, 42, 43, 43, 43, 44, 44, 44, 45,
    45, 46, 46, 46, 47, 47, 47, 48, 48, 49, 49, 49, 50, 50, 51, 51, 52, 52, 53, 53, 54, 54, 54, 55,
    55, 56, 57, 57, 58, 58, 59, 59, 60, 60, 61, 62, 62, 63]

### The arc tangent of `me`, correctly rounded to nearest (a CORE-MATH port).
### :returns: atan(`me`) in [-pi/2, pi/2]. It is `me` itself for |`me`| < 2^-57 and ±pi/2 for |`me`| >= 2^115
###     (infinities included). A NaN comes back quieted.
routine B128.atan() -> Me
    local bits: U128 = me.bits()
    local sign: U128 = bits & B128_SIGN
    local lo: U64 = bits.to_wrap[U64]()

    is_nan: Bool = me.is_nan()
    quiet: Me = b128_of(b128_quiet(me.bits()))
    if is_nan
        return quiet
    hi_raw: U64 = (bits >> 64).to[U64]()
    hi: U64 = hi_raw & 0x7FFFFFFFFFFFFFFF
    xn: U64 = hi >> 48
    # for |x| < 2^-57 the difference atan(x) - x is under half an ulp (this covers ±0)
    tiny: Bool = xn < 0x3FC6  # 0x3FFF - 57
    # 0x3FFF + 114
    when
        tiny => return me
        xn > 0x4071 =>
            # |x| >= 2^115 or infinity (a NaN went back above): ±pi/2
            half_pi: U128 = 0x3FFF921FB54442D18469898CC51701B8
            return b128_of(half_pi | sign)
        else =>
            mant: U64 = (hi & 0x0000FFFFFFFFFFFF) | 0x0001000000000000
            red: CmAtanReduction = cm_atan_reduce(mant, lo, xn)
            kd: U128 = cm_atan_join(hi: red.kd2, lo: red.kd1)
            f: U128 = cm_atan_fast_core(kn: red.kn, kd, dn: red.dn)
            if (red.isct != 0) or red.g
                # atan|x| = PHI0[isct] + f, or π/2 - that past 1
                placed: CmAtanU192 = cm_atan_place(f, dn: red.dn + 1)
                phi: CmAtanU192 = cm_atan_row_top(table: CM_ATAN_PHI0.to[@U64](), row: red.isct)
                angle: CmAtanU192 = cm_atan_u192_add(a: phi, b: placed)
                half_pi: CmAtanU192 = cm_atan_row_top(table: CM_ATAN_QOFF.to[@U64](), row: 1)
                reflected: CmAtanU192 = cm_atan_u192_sub(a: half_pi, b: angle)
                final: CmAtanU192 = when
                    red.g => reflected
                    else => angle
                rounded: CmAtanRounded = cm_atan_round_fixed(final)
                result: Me = b128_of(rounded.bits | sign)
                if not rounded.hard
                    return result
            else
                rounded: CmAtanRounded = cm_atan_round_direct(f, dn: red.dn)
                result: Me = b128_of(rounded.bits | sign)
                if not rounded.hard
                    return result
            r: Me = cm_atan_accurate(red, sign)
            return r

### Reduces |x| = mant:lo × 2^(xn - 0x3FFF - 112) (mant carrying the implicit bit) against the
### table. Far from 1 no table angle is needed: |x| itself below 2^-7, or 1/|x| from 2^7 on.
### :param mant: The high 49 bits of the significand, implicit bit included.
### :param lo: The low 64 bits of the significand.
### :param xn: The biased exponent, for 2^-57 <= |x| < 2^115.
### :returns: The reduced argument kn / kd × 2^-dn with its table index, `g` set when |x| >= 1 (the ratio was
###     inverted).
routine cm_atan_reduce(mant: U64, lo: U64, xn: U64) -> CmAtanReduction
    if xn >= 0x3FFF
        # |x| < 2^-7: kn / kd = |x| itself
        # kn = |x| - t, kd = 1 + |x| t
        # kd = 1 + xa >> e: the leading one and xa's bits under it
        e: U64 = xn - 0x3FFF
        if e > 6
            # |x| >= 2^7: kn / kd = 1 / |x|
            kd: U128 = cm_atan_join(hi: mant, lo) << 15
            one: U128 = 0x80000000000000000000000000000000
            r: CmAtanReduction = CmAtanReduction(zero: false, g: true, isct: 0, dn: e.to[S64](),
                kn: one, kd0: 0, kd1: kd.to_wrap[U64](), kd2: (kd >> 64).to[U64]())
            return r
        # kn = 1 - |x| t, kd = |x| + t, the index guess moved down one when |x| t passes 1
        e2: S64 = e.to[S64]()
        xa: U128 = cm_atan_join(hi: mant, lo)
        guess_bits: U64 = (mant ^ 0x0000FFFFFFFFFFFF) >> (e2 + 42).to[U64]()
        guess_at: U64 = guess_bits.to[U64]()
        guess: U64 = CM_ATAN_INDH.getitem(guess_at).to[U64]()
        next_at: U64 = guess + 1
        next_tn: U64 = CM_ATAN_TN.getitem(next_at)
        limit: U64 = (1 << 63 - e2).to_wrap[U64]()
        bump: Bool = next_tn *% mant < limit
        first: U64 = guess + bump.to[U64]()
        first_tn: U64 = CM_ATAN_TN.getitem(first)
        past: U128 = xa *% first_tn.to[U128]()
        past_hi: U64 = (past >> 64).to[U64]()
        over: Bool = past_hi & limit != 0
        isct: U64 = when
            over => first -% 1
            else => first
        tn: U64 = CM_ATAN_TN.getitem(isct)
        t: U128 = xa *% tn.to[U128]()
        # kn = -(t << e) with its top bit flipped, normalized
        neg: U128 = 0 -% (t << e2.to[U128]())
        neg_hi: U64 = (neg >> 64).to[U64]()
        knh: U64 = neg_hi ^ 0x8000000000000000
        norm: CmAtanNorm = cm_atan_normalize(knh, knl: neg.to_wrap[U64]())
        sum_hi: U64 = mant +% (tn << (33 - e2).to[U64]())
        nzd: S64 = sum_hi.leading_zeros().to[S64]()
        spill_shift: S64 = 0 - nzd & 63
        spill: U64 = lo >> spill_shift.to[U64]()
        kd2: U64 = (sum_hi << nzd.to[U64]()) | spill
        kd1: U64 = lo << nzd.to[U64]()
        e_shifted: S64 = e2 + norm.shift - nzd
        dn: S64 = e_shifted + 15
        r: CmAtanReduction = CmAtanReduction(zero: false, g: true, isct: isct, dn: dn,
            kn: norm.kn, kd0: 0, kd1: kd1, kd2: kd2)
        return r
    e: U64 = 0x3FFF - xn
    if e > 7
        kn: U128 = cm_atan_join(hi: mant, lo) << 15
        r: CmAtanReduction = CmAtanReduction(zero: false, g: false, isct: 0, dn: e.to[S64](),
            kn: kn, kd0: 0, kd1: 0, kd2: 0x8000000000000000)
        return r
    e2: S64 = e.to[S64]()
    guess_at: U64 = (mant >> (e2 + 41).to[U64]()).to[U64]()
    guess: U64 = CM_ATAN_INDL.getitem(guess_at).to[U64]()
    next_at: U64 = guess + 1
    next_tn: U64 = CM_ATAN_TN.getitem(next_at)
    bump: Bool = next_tn <= mant >> (e2 + 33).to[U64]()
    isct: U64 = guess + bump.to[U64]()
    tn: U64 = CM_ATAN_TN.getitem(isct)
    tt: U64 = tn << (e2 + 33).to[U64]()
    norm: CmAtanNorm = cm_atan_normalize(knh: mant -% tt, knl: lo)
    xa: U128 = cm_atan_join(hi: mant, lo) *% tn.to[U128]()
    kd: U128 = xa >> e2.to[U128]()
    kd0: S64 = xa.to_wrap[S64]() << (0 - e2 & 63)
    kd_hi: U64 = (kd >> 64).to[U64]()
    kd2: U64 = kd_hi | 0x8000000000000000
    dn: S64 = e2 + norm.shift - 15
    r: CmAtanReduction = CmAtanReduction(zero: false, g: false, isct: isct, dn: dn,
        kn: norm.kn, kd0: kd0, kd1: kd.to_wrap[U64](), kd2: kd2)
    return r

### The accurate path of atan: the same reduction, the series in 6 limbs, then the table angle added back (and
### taken from pi/2 when the ratio was inverted).
### :param red: The reduction from {cm_atan_reduce}.
### :param sign: The sign bit of x, in place in a B128's bits.
### :returns: atan(x), correctly rounded.
routine cm_atan_accurate(red: CmAtanReduction, sign: U128) -> B128
    local f_buf: @Array[S64, 8] <- .hollow()
    local f: @U64 = f_buf.to[@U64]()

    cm_atan_accurate_core(red, f)
    table: Bool = (red.isct != 0) or red.g
    dn: S64 = when
        table =>
            dn: S64 = red.dn
            cm_atan_limbs_shr(a: f, n: 6, k: dn + 1)
            row: U64 = red.isct * 6
            phi: @U64 = CM_ATAN_PHI0.to[@U64]().stride(row)
            cm_atan_limbs_add(dst: f, a: phi, b: f, n: 6)
            if red.g
                # π/2 - f
                half_pi: @U64 = CM_ATAN_QOFF.to[@U64]().offset(48)
                cm_atan_limbs_sub(dst: f, a: half_pi, b: f, n: 6)
                becomes -1
            else
                becomes -1
        else => red.dn
    bits: U128 = cm_atan_round_limbs(f, dn)
    r: B128 = b128_of(bits | sign)
    return r
