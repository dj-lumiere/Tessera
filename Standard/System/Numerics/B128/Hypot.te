# Tessera stdlib: correctly rounded B128 hypot (CORE-MATH)
#
# Ported from CORE-MATH, src/binary128/hypot/hypotq.c via RazorForge's B128Hypot.rf.
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH
#
# Only round-to-nearest (ties to even) is kept. The original's rounding-mode probe, errno and
# exception flags are dropped. Everything runs on 64- and 128-bit integers: x² + y² is formed
# in fixed point relative to the larger leg, its square root comes from Sqrt.te's seed and
# refinement, and a result within a few units of a rounding boundary is settled by an exact
# 256-bit comparison of the candidate's square with the sum of squares.

module Standard/System/Numerics/B128

### A 256-bit value (or square) as two 128-bit halves.
secret record CmHypotSquare
    hi: U128
    lo: U128

# -- hypot ---------------------------------------------------------------------

### sqrt(x² + y²) without overflow or underflow, correctly rounded to nearest (a CORE-MATH port). A signaling NaN
### gives NaN, as it does in every operation, and otherwise an infinite leg gives +inf, even with a quiet NaN in the
### other leg (IEEE 754's hypot(±inf, qNaN)). A NaN comes back quieted (`x` first), the payload kept.
### :param x: One leg.
### :param y: The other leg.
### :returns: sqrt(`x`² + `y`²), +inf when it overflows.
routine hypot_unchecked(x: B128, y: B128) -> B128
    x_abs: U128 = x.bits() & B128_SIGN.bitnot()
    y_abs: U128 = y.bits() & B128_SIGN.bitnot()
    swap: Bool = x_abs < y_abs
    a: U128 = when  # the larger leg

        swap => y_abs
        else => x_abs
    b: U128 = when
        swap => x_abs
        else => y_abs

    signaling: Bool = b128_is_signaling(x) or b128_is_signaling(y)
    is_inf: Bool = x.is_infinite() or y.is_infinite()
    when
        signaling => return b128_nan_of(a: x, b: y)
        is_inf => return inf
        x.is_nan() or y.is_nan() => return b128_nan_of(a: x, b: y)
        else =>
            a_exp: S64 = (a >> 112).to[S64]()
            b_exp: S64 = (b >> 112).to[S64]()
            b_tiny: Bool = b_exp == 0
            values2: (U128, S64, U128, S64) = when
                b_tiny =>
                    b_zero: Bool = b == 0
                    a_only: B128 = b128_of(a)
                    if b_zero
                        return a_only
                    # A subnormal leg moves its leading bit up to the implicit bit's place, and its exponent
                    # drops below 1 to match. Only then can the larger leg be subnormal too.
                    lz_b: U128 = b.leading_zeros()
                    shift: S64 = lz_b.to[S64]() - 15
                    b_norm: U128 = b << shift.to[U128]()
                    b_exp2: S64 = 1 - shift
                    if a_exp == 0
                        lz_a: U128 = a.leading_zeros()
                        shift2: S64 = lz_a.to[S64]() - 15
                        becomes (a << shift2.to[U128](), 1 - shift2, b_norm, b_exp2)
                    else
                        becomes (a, a_exp, b_norm, b_exp2)
                else => (a, a_exp, b, b_exp)
            a_leg, a_exp2, b_leg, b_exp2 = values2
            # Both legs as 1.frac × 2^(exponent - 16383) with the leading bit placed at bit 127.
            gap: S64 = a_exp2 - b_exp2
            a_top: U128 = (a_leg << 15) | B128_SIGN
            b_top: U128 = (b_leg << 15) | B128_SIGN
            # b only matters as a sticky bit
            if gap > 56
                r: B128 = cm_hypot_round(v: a_top | 1, exponent: a_exp2)
                return r
            # s = a² + b² in fixed point (b aligned to a), normalized with an even or odd shift so its
            # square root can reuse the sqrt refinement. A carry out of the sum bumps the exponent.
            a_sq: U128 = cm_hypot_sqr_hi(a_top)
            b_sq: U128 = cm_hypot_sqr_hi(b_top >> gap.to[U128]())
            s: U128 = a_sq +% b_sq
            carried: Bool = s < a_sq
            carry: S64 = carried.to[S64]()
            s_hi: S64 = (s >> 64).to_wrap[S64]()
            zeros: S64 = s_hi.leading_zeros()
            lead: S64 = when
                carried => 0
                else => zeros
            shift: S64 = 1 - carry + lead
            odd: S64 = shift & 1
            frac: U128 = s << shift.to[U128]()
            exponent: S64 = a_exp2 + carry
            radicand: U128 = cm_sqrt_radicand(frac, odd)
            approx: U128 = cm_sqrt_approx(frac, radicand, odd)
            slack: S16 = (approx << 2).to_wrap[S16]()  # the bits under the rounding point
            if slack > -37 and slack < 13
                # approx is at most one unit (of its bit 14) off: square the candidate, compare it with the
                # exact sum of squares, and leave bit 0 saying which way the true root lies. Rounding up
                # can wrap the candidate to 0, which means 2^128: the exponent takes the carry.
                candidate: U128 = approx +% 0x2000 & ~0x3FFF
                wrapped: Bool = candidate == 0
                excess: S128 = cm_hypot_excess(c: candidate >> 13, a_top, b_top, gap)
                top_bit: U128 = when
                    wrapped => B128_SIGN
                    else => 0
                above: U128 = (excess < 0).to[U128]()  # the sum is below the square
                below: U128 = (excess > 0).to[U128]()
                lowered: U128 = (candidate | top_bit) -% above
                v: U128 = lowered +% below
                r: B128 = cm_hypot_round(v, exponent: exponent + wrapped.to[S64]())
                return r
            r: B128 = cm_hypot_round(v: approx, exponent)
            return r

### Rounds v (leading bit at 127, sticky information in its low bits) times 2^(exponent - 16383) to
### the nearest B128, ties to even: a normal result, +inf on overflow, or a subnormal.
### :param v: The significand, leading bit at 127.
### :param exponent: The biased exponent of the leading bit.
### :returns: The rounded B128.
secret routine cm_hypot_round(v: U128, exponent: S64) -> B128
    e: S64 = exponent - 1

    if e > 0
        overflow: Bool = e >= 32766
        infinity: B128 = inf
        if overflow
            return infinity
        # The leading bit lands on bit 112 and adds 1 to the exponent field e.
        rest: U128 = v & 0x7FFF
        tie: Bool = rest == 0x4000
        up: U128 = rest >> 14
        kept: U128 = v >> 15
        even: U128 = kept & 1
        round_up: U128 = when
            tie => even
            else => up
        exponent_field: U128 = e.to[U128]() << 112
        field: U128 = exponent_field | round_up
        r: B128 = b128_of(kept +% field)
        return r
    # e <= 0: shift out 15 - e bits (at most 127) and round them.
    one: U128 = 1
    shift: S128 = (15 - e).to[S128]()
    half: U128 = one << (14 - e).to[U128]()
    rest: U128 = v & (one << shift.to[U128]()) -% 1
    tie: Bool = rest == half
    up: U128 = rest >> (14 - e).to[U128]()
    kept: U128 = v >> shift.to[U128]()
    even: U128 = kept & 1
    round_up: U128 = when
        tie => even
        else => up
    r: B128 = b128_of(kept +% round_up)
    return r

### a² + b² - c², reduced mod 2^128 and read as signed, where a and b are the legs (leading bit
### at 127, b not yet aligned) and c the candidate root, all shifted down 13 bits. The sum is
### exact apart from a sticky bit for b's shifted-out part.
### :param c: The candidate root, shifted down 13 bits.
### :param a_top: The larger leg, leading bit at 127.
### :param b_top: The smaller leg, leading bit at 127.
### :param gap: The exponent difference of the legs, 0 to 56.
### :returns: The low 128 bits of a² + b² - c² as a signed value: negative when the root is below `c`, positive when
###     above, 0 when exact.
secret routine cm_hypot_excess(c: U128, a_top: U128, b_top: U128, gap: S64) -> S128
    c_sq: U128 = c *% c
    a_sq: CmHypotSquare = cm_hypot_sqr(a_top >> 13)
    b_sq: CmHypotSquare = cm_hypot_sqr(b_top >> 13)

    aligned: Bool = gap == 0
    b_sq_aligned: CmHypotSquare = when
        aligned => b_sq
        else =>
            # b² × 2^(-2 gap), with the bits shifted out kept as a sticky bit.
            k: S128 = (gap * 2).to[S128]()
            kc: S128 = 128 - k
            b_hi: U128 = b_sq.hi
            b_lo: U128 = b_sq.lo
            lost: Bool = b_lo << kc.to[U128]() != 0
            sticky: U128 = lost.to[U128]()
            aligned2: U128 = (b_lo >> k.to[U128]()) | (b_hi << kc.to[U128]())
            low: U128 = aligned2 | sticky
            becomes CmHypotSquare(hi: b_hi >> k.to[U128](), lo: low)
    b_lo: U128 = b_sq_aligned.lo
    lo: U128 = a_sq.lo +% b_lo
    carry: U128 = (lo < b_lo).to[U128]()
    hi: U128 = a_sq.hi +% (b_sq_aligned.hi +% carry)
    # the sum carried: halve it (s = 2)
    if not (hi >> 102 != 0)
        return (lo -% c_sq).to_wrap[S128]()
    dropped: Bool = lo << 126 != 0
    sticky: U128 = dropped.to[U128]()
    shifted: U128 = (lo >> 2) | (hi << 126)
    low: U128 = shifted | sticky
    return (low -% c_sq).to_wrap[S128]()

### Approximate high 128 bits of a² (low × low dropped).
### :param a: The value.
### :returns: Approximately `a`² >> 128.
secret routine cm_hypot_sqr_hi(a: U128) -> U128
    a0: U128 = a & 0xFFFFFFFFFFFFFFFF
    a1: U128 = a >> 64
    cross: U128 = a1 *% a0 >> 64
    partial: U128 = a1 *% a1 +% cross
    r: U128 = partial +% cross
    return r

### The full 256-bit a²: the cross term a1·a0 is added twice at bit 64.
### :param a: The value.
### :returns: `a`², exact, as two 128-bit halves.
secret routine cm_hypot_sqr(a: U128) -> CmHypotSquare
    a0: U128 = a & 0xFFFFFFFFFFFFFFFF
    a1: U128 = a >> 64
    cross: U128 = a1 *% a0
    t: U128 = cross << 64
    th: U128 = cross >> 64
    lo0: U128 = a0 *% a0
    hi0: U128 = a1 *% a1
    lo1: U128 = lo0 +% t
    hi1: U128 = hi0 +% (lo1 < t).to[U128]() +% th
    lo2: U128 = lo1 +% t
    hi2: U128 = hi1 +% (lo2 < t).to[U128]() +% th
    r: CmHypotSquare = CmHypotSquare(hi: hi2, lo: lo2)
    return r
