### A finite float mant × 2^(exponent - 191) with the mantissa's top bit (191) set.
### Zero has a zero mantissa. The mantissa is hi (bits 191..64) and lo (63..0).
record B128Extended
obeys Addable[B128Extended], Subtractable[B128Extended], Multiplicable[B128Extended], Divisible[B128Extended], Negatable[B128Extended]
    negative: Bool
    exponent: S64
    hi: U128
    lo: U64

# -- B128Extended ----------------------------------------------------------------------

### The B128Extended zero (positive, zero mantissa).
### :returns: +0.
secret routine wide_zero() -> B128Extended
    w: B128Extended = B128Extended(negative: false, exponent: 0, hi: 0, lo: 0)
    return w

### True when the mantissa is zero, whatever the sign.
### :returns: Whether `me` is ±0.
routine B128Extended.is_zero() -> Bool
    return me.hi == 0 and me.lo == 0

### `me` with its sign flipped.
### :returns: -`me`.
routine B128Extended.neg() -> Me
    r: Me = Me(negative: not me.negative, exponent: me.exponent, hi: me.hi, lo: me.lo)
    return r

### `me` × 2^k, by adding k to the exponent.
### :param k: The power of two.
### :returns: The scaled value.
routine B128Extended.ldexp(k: S64) -> Me
    r: Me = Me(negative: me.negative, exponent: me.exponent + k, hi: me.hi, lo: me.lo)
    return r

### Entry i of one of the constant tables, as a positive B128Extended.
### :param hi: The table of mantissa bits 191..64.
### :param lo: The table of mantissa bits 63..0.
### :param exponent: The table of exponents.
### :param i: The entry.
### :returns: The entry.
secret routine wide_table(hi: @U128, lo: @U64, exponent: @S64, i: U64) -> B128Extended
    h: U128 = hi.stride(i).peek()
    l: U64 = lo.stride(i).peek()
    e: S64 = exponent.stride(i).peek()
    w: B128Extended = B128Extended(negative: false, exponent: e, hi: h, lo: l)
    return w

### Entry i of the constants: 0 = ln 2, 1 = 1/ln 2, 2 = sqrt(1/2), 3 = 1/ln 10, 4 = 180/π, 5 = π/180.
### :param i: The entry, 0 to 5.
### :returns: The constant at 192 bits.
secret routine wide_const(i: U64) -> B128Extended
    w: B128Extended = wide_table(hi: WIDE_CONST_HI.to[@U128](), lo: WIDE_CONST_LO.to[@U64](),
        exponent: WIDE_CONST_EXP.to[@S64](), i)
    return w

### Shifts the mantissa up until bit 191 is set, lowering the exponent to match. A zero mantissa gives
### {wide_zero}.
### :param negative: The sign.
### :param exponent: The exponent before the shift.
### :param hi: Mantissa bits 191..64.
### :param lo: Mantissa bits 63..0.
### :returns: The normalized value.
secret routine wide_normalize(negative: Bool, exponent: S64, hi: U128, lo: U64) -> B128Extended
    adjusted: &S64 <- exponent

    zero: Bool = hi == 0 and lo == 0
    zero_result: B128Extended = wide_zero()
    if zero
        return zero_result
    # a whole empty top limb moves in 64 bits at a time
    until upper >> 64 != 0 with upper: U128 = hi, lower: U64 = lo
        new_hi: U128 = (upper << 64) | lower.to[U128]()
        (adjusted.load() - 64).poke_into(adjusted)
        continue with upper: new_hi, lower: 0
    then
        s: S64 = upper.leading_zeros().to[S64]()
        some: Bool = s > 0
        carry: U128 = when
            some => lower.to[U128]() >> (64 - s).to[U128]()
            else => 0
        new_hi: U128 = (upper << s.to[U128]()) | carry
        new_lo: U64 = lower << s.to[U64]()
        w: B128Extended = B128Extended(negative: negative, exponent: adjusted.load() - s,
            hi: new_hi, lo: new_lo)
        return w

### `me` in B128Extended, exactly. For a finite `me` (±0 gives +0).
### :returns: The widened value.
routine B128.to[B128Extended]() -> B128Extended
    zero: Bool = b128_is_zero_bits(me.bits())
    zero_result: B128Extended = wide_zero()
    if zero
        return zero_result
    p: B128Parts = b128_unpack(me.bits())
    w: B128Extended = B128Extended(negative: b128_is_negative_bits(me.bits()), exponent: p.exponent,
        hi: p.sig << 15, lo: 0)
    return w

### `me` in B128Extended, through B128 (exact for any S64).
### :returns: The widened value.
routine S64.to[B128Extended]() -> B128Extended
    w: B128Extended = me.to[B128]().to[B128Extended]()
    return w

### Rounds once to B128 (overflow, subnormals, and underflow included).
### :returns: The nearest B128, ties to even.
routine B128Extended.to[B128]() -> B128
    zero: Bool = me.is_zero()
    plus_zero: B128 = b128_of(0)
    if zero
        return plus_zero
    # value ~ hi × 2^(exponent - 127): b128_round_pack wants sig × 2^(biased - 16383 - 115)
    sticky: U128 = (me.lo != 0).to[U128]()
    sig: U128 = me.hi | sticky
    bits: U128 = b128_round_pack(negative: me.negative, exponent: me.exponent + 16371, sig)
    r: B128 = b128_of(bits)
    return r

### mantissa >> n (bits shifted out are dropped), as a positive B128Extended with exponent 0.
### :param hi: Mantissa bits 191..64.
### :param lo: Mantissa bits 63..0.
### :param n: The shift, at least 0.
### :returns: The shifted mantissa.
secret routine wide_shift_right(hi: U128, lo: U64, n: S64) -> B128Extended
    none: Bool = n == 0
    small: Bool = n < 64
    mid: Bool = n < 192
    values2: (U128, U64) = when
        none => (hi, lo)
        small =>
            new_lo: U64 = (lo >> n.to[U64]()) | (hi.to_wrap[U64]() << (64 - n).to[U64]())
            becomes (hi >> n.to[U128](), new_lo)
        mid =>
            # 64 <= n < 192: lo comes from hi, and hi keeps what's left above bit 128 + n - 64
            new_lo: U64 = (hi >> (n - 64).to[U128]()).to_wrap[U64]()
            new_hi: U128 = when
                n >= 128 => 0
                else => hi >> n.min(127).to[U128]()
            becomes (new_hi, new_lo)
        else => (0, 0)
    h, l = values2
    w: B128Extended = B128Extended(negative: false, exponent: 0, hi: h, lo: l)
    return w

### The sum `me` + `other`, with the smaller operand's bits below the larger one's mantissa truncated.
### :param other: The value to add.
### :returns: The sum.
routine B128Extended.add(other: Me) -> Me
    a_zero: Bool = me.is_zero()
    when
        a_zero => return other
        other.is_zero() => return me
        else =>
            # big has the larger magnitude: larger exponent, or the same and a larger mantissa
            a_hi_more: Bool = me.hi > other.hi or (me.hi == other.hi and me.lo >= other.lo)
            a_first: Bool = me.exponent > other.exponent or (me.exponent == other.exponent and a_hi_more)
            big: Me = when
                a_first => me
                else => other
            small: Me = when
                a_first => other
                else => me
            aligned: Me = wide_shift_right(hi: small.hi, lo: small.lo,
                n: big.exponent - small.exponent)
            if big.negative == small.negative
                lo: U64 = big.lo +% aligned.lo
                c0: U128 = (lo < big.lo).to[U128]()
                hi_part: U128 = big.hi +% aligned.hi
                c1: Bool = hi_part < big.hi
                hi: U128 = hi_part +% c0
                c2: Bool = hi < hi_part
                carry: Bool = c1 or c2
                values2: (Bool, S64, U128, U64) = when
                    carry =>
                        # the 193rd bit: shift right once, the carry becoming bit 191
                        new_lo: U64 = (lo >> 1) | (hi.to_wrap[U64]() << 63)
                        becomes (big.negative, big.exponent + 1, (hi >> 1) | B128_SIGN, new_lo)
                    else => (big.negative, big.exponent, hi, lo)
                negative, exponent, hi2, lo2 = values2
                r: Me = Me(negative: negative, exponent: exponent, hi: hi2, lo: lo2)
                return r
            lo: U64 = big.lo -% aligned.lo
            borrow: U128 = (big.lo < aligned.lo).to[U128]()
            hi: U128 = big.hi -% aligned.hi -% borrow
            r: Me = wide_normalize(negative: big.negative, exponent: big.exponent, hi, lo)
            return r

### The difference `me` - `other`.
### :param other: The value to subtract.
### :returns: The difference.
routine B128Extended.sub(other: Me) -> Me
    r: Me = me + -other
    return r

### The top 192 bits of the 384-bit product (the rest dropped).
### :param other: The value to multiply by.
### :returns: The product.
routine B128Extended.mul(other: Me) -> Me
    a_zero: Bool = me.is_zero()
    b_zero: Bool = other.is_zero()
    zero: Bool = a_zero or b_zero
    zero_result: Me = wide_zero()
    if zero
        return zero_result
    a2: U128 = me.hi >> 64
    a1: U128 = me.hi & 0xFFFFFFFFFFFFFFFF
    a0: U128 = me.lo.to[U128]()
    b2: U128 = other.hi >> 64
    b1: U128 = other.hi & 0xFFFFFFFFFFFFFFFF
    b0: U128 = other.lo.to[U128]()
    # columns 1..5 of the schoolbook product, and column 0 only feeds carries into 1
    c0: U128 = a0 *% b0 >> 64
    t1: U128 = a0 *% b1
    t1b: U128 = a1 *% b0
    s1: U128 = c0 + (t1 & 0xFFFFFFFFFFFFFFFF) + (t1b & 0xFFFFFFFFFFFFFFFF)
    c1: U128 = s1 >> 64
    k1: U128 = c1 + (t1 >> 64) + (t1b >> 64)
    t2a: U128 = a0 *% b2
    t2b: U128 = a1 *% b1
    t2c: U128 = a2 *% b0
    s2ab: U128 = k1 + (t2a & 0xFFFFFFFFFFFFFFFF) + (t2b & 0xFFFFFFFFFFFFFFFF)
    s2: U128 = s2ab + (t2c & 0xFFFFFFFFFFFFFFFF)
    c2: U128 = s2 >> 64
    k2ab: U128 = c2 + (t2a >> 64) + (t2b >> 64)
    k2: U128 = k2ab + (t2c >> 64)
    t3a: U128 = a1 *% b2
    t3b: U128 = a2 *% b1
    s3: U128 = k2 + (t3a & 0xFFFFFFFFFFFFFFFF) + (t3b & 0xFFFFFFFFFFFFFFFF)
    c3: U128 = s3 >> 64
    k3: U128 = c3 + (t3a >> 64) + (t3b >> 64)
    t4: U128 = a2 *% b2
    s4: U128 = k3 + (t4 & 0xFFFFFFFFFFFFFFFF)
    k4: U128 = (s4 >> 64) + (t4 >> 64)
    # limbs r5 r4 r3 (and r2 for the shift): product = r5..r0 × 2^(64 i)
    r2: U64 = s2.to_wrap[U64]()
    r3: U64 = s3.to_wrap[U64]()
    r4: U64 = s4.to_wrap[U64]()
    r5: U64 = k4.to_wrap[S64]().to_wrap[U64]()
    top: Bool = r5 >> 63 == 1  # bit 383 set
    r5_high: U128 = r5.to[U128]() << 64
    hi_full: U128 = r5_high | r4.to[U128]()
    hi: U128 = when
        top => hi_full
        else => (hi_full << 1) | (r3.to[U128]() >> 63)
    lo: U64 = when
        top => r3
        else => (r3 << 1) | (r2 >> 63)
    exponent: S64 = me.exponent + other.exponent + top.to[S64]()
    negative: Bool = me.negative != other.negative
    r: Me = Me(negative: negative, exponent: exponent, hi: hi, lo: lo)
    return r

### me / other by Newton's method on the reciprocal: y ← y + y(1 - other·y), from a B64 seed
### (53 bits → 106 → 212).
### :param other: The divisor, nonzero.
### :returns: The quotient.
routine B128Extended.truediv(other: Me) -> Me
    e: S64 = other.exponent
    unit: Me = other.ldexp(0 - e)  # in [1, 2)
    seed: B64 = unit.to[B128]().to_unchecked[B64]()
    one64: B64 = 1.0
    y0: Me = B128.to[Me]((one64 /! seed).to[B128]())
    one: Me = S64.to[Me](1)
    y1: Me = y0 + y0 * (one - unit * y0)
    y2: Me = y1 + y1 * (one - unit * y1)
    r: Me = (me * y2).ldexp(0 - e)
    return r

### Rounds to the nearest integer (ties to even), for |me| < 2^62. Out-of-range values clamp.
### :returns: The integer.
routine B128Extended.to_nearest[S64]() -> S64
    rounded: B128 = me.to[B128]().round_ties_even()
    r: S64 = rounded.to_clamp[S64]()
    return r

# -- exponent -----------------------------------------------------------------------

### e^x for finite x with |x| below the overflow range (the caller clamps). x = q ln2 + d with |d| <= ln2/2,
### e^d by its Taylor series (27th degree, and the first dropped term is below 2^-141), then × 2^q.
### :param x: The exponent.
### :returns: e^x at 192 bits.
secret routine wide_exp(x: B128Extended) -> B128Extended
    ln2: B128Extended = wide_const(0)
    inv_ln2: B128Extended = wide_const(1)
    q: S64 = (x * inv_ln2).to_nearest[S64]()
    d: B128Extended = x - q.to[B128Extended]() * ln2
    s: &B128Extended <- .hollow()

    last: B128Extended = wide_table(hi: WIDE_EXP_COEF_HI.to[@U128](),
        lo: WIDE_EXP_COEF_LO.to[@U64](), exponent: WIDE_EXP_COEF_EXP.to[@S64](), i: 27)
    last.poke_into(s)

    loop with i: S64 = 26
        done2: Bool = i < 0
        scaled2: B128Extended = s.load().ldexp(q)
        if done2
            return scaled2
        c: B128Extended = wide_table(hi: WIDE_EXP_COEF_HI.to[@U128](),
            lo: WIDE_EXP_COEF_LO.to[@U64](), exponent: WIDE_EXP_COEF_EXP.to[@S64](), i: i.to[U64]())
        s.store(s.load() * d + c)
        continue with i: i - 1

# -- log -----------------------------------------------------------------------

