### ln x for finite x > 0: x = fr × 2^e with fr in [sqrt(1/2), sqrt(2)), then ln fr = 2 atanh(t) =
### 2 (t + t^3/3 + t^5/5 + …) with t = (fr - 1) / (fr + 1), |t| <= 0.172, 26 terms (the first dropped one is
### below 2^-135).
### :param x: The argument, positive.
### :returns: ln x at 192 bits.
secret routine wide_log(x: B128Extended) -> B128Extended
    s: &B128Extended <- .hollow()

    sqrt_half: B128Extended = wide_const(2)
    fr0: B128Extended = x.ldexp(0 - x.exponent)  # in [1, 2)
    low: Bool = fr0.hi < sqrt_half.ldexp(1).hi  # below sqrt(2)?
    fr: B128Extended = when
        low => fr0
        else => fr0.ldexp(-1)
    e: S64 = when
        low => x.exponent
        else => x.exponent + 1
    one: B128Extended = S64.to[B128Extended](1)
    t: B128Extended = (fr - one) / (fr + one)
    tt: B128Extended = t * t
    last: B128Extended = wide_table(hi: WIDE_LOG_COEF_HI.to[@U128](),
        lo: WIDE_LOG_COEF_LO.to[@U64](), exponent: WIDE_LOG_COEF_EXP.to[@S64](), i: 25)
    last.poke_into(s)

    until i < 0 with i: S64 = 24
        c: B128Extended = wide_table(hi: WIDE_LOG_COEF_HI.to[@U128](),
            lo: WIDE_LOG_COEF_LO.to[@U64](), exponent: WIDE_LOG_COEF_EXP.to[@S64](), i: i.to[U64]())
        s.store(s.load() * tt + c)
        continue with i: i - 1
    then
        ln_fr: B128Extended = (s.load() * t).ldexp(1)
        e_ln2: B128Extended = e.to[B128Extended]() * wide_const(0)
        r: B128Extended = e_ln2 + ln_fr
        return r

# -- argument reduction (Payne-Hanek) ------------------------------------------

### x = k × π/2 + θ with k taken mod 4 and |θ| <= π/4.
secret record Reduced
    quadrant: U64
    theta: B128Extended

### 64 bits of the little-endian limbs at p starting at bit pos (pos >= 0).
### :param p: The limbs, least significant first.
### :param pos: The lowest bit to take.
### :returns: The 64 bits.
routine limbs_bits64(p: @U64, pos: S64) -> U64
    i: U64 = (pos >> 6).to[U64]()
    off: S64 = pos & 63
    low: U64 = p.stride(i).peek()
    if off == 0
        return low
    j: U64 = i + 1
    high: U64 = p.stride(j).peek()
    r: U64 = (low >> off.to[U64]()) | (high << (64 - off).to[U64]())
    return r

### Reduces |x| (finite, nonzero). With x = m × 2^(e - 112), x × 2/π keeps only the bits of 2/π that land below
### 4: a 512-bit window W of them, so x × 2/π mod 4 = m × W × 2^-sh. The product's bits above sh give the
### quadrant and the ones below it the fraction f. The window is good to about 2^-330, but f keeps only the 256
### bits under sh, so θ is good to about 2^-256 absolute: relative 2^-133 at worst, where x sits closest to a
### multiple of π/2 (|θ| = 2^-123.3), which is why tan sends |θ| < 2^-90 to its exact tier (Tan.te).
### Below 0.5 the quadrant is 0 and θ = |x|.
### :param x: The argument.
### :returns: The quadrant (mod 4) and θ, |θ| <= π/4.
secret routine b128_reduce(x: B128) -> Reduced
    p: B128Parts = b128_unpack(x.bits())

    # |x| < 0.5 < π/4
    if p.exponent < -1
        near_zero: Reduced = Reduced(quadrant: 0, theta: B128.to[B128Extended](x.abs()))
        return near_zero

    bits_above: S64 = (p.exponent - 114).max(0)
    start: S64 = bits_above.div_trunc(64)  # first 2/π limb used
    window_bits: S64 = (start + 8) * 64
    sh: S64 = window_bits - p.exponent + 112
    prod: &Array[S64, 12] <- .hollow()
    limbs: @U64 = prod.to[@U64]()
    limbs.zeroinit(12)
    m0: U128 = p.sig & 0xFFFFFFFFFFFFFFFF
    m1: U128 = p.sig >> 64

    # limb k of W (little-endian) is TWO_OVER_PI[start + 7 - k]. Add m × w_k at limb k
    each k: U64 in 0 til 8
        index: U64 = start.to[U64]() + 7 - k
        w: U64 = TWO_OVER_PI.getitem(index)
        wide: U128 = w.to[U128]()
        lo_p: U128 = m0 *% wide
        hi_p: U128 = m1 *% wide
        k1: U64 = k + 1
        k2: U64 = k + 2
        r0: U64 = limbs.stride(k).peek()
        r1: U64 = limbs.stride(k1).peek()
        r2: U64 = limbs.stride(k2).peek()
        # limb k gets lo_p's low half, limb k+1 lo_p's high half and hi_p's low, and k+2 the rest
        s0: U128 = r0.to[U128]() + (lo_p & 0xFFFFFFFFFFFFFFFF)
        s1a: U128 = r1.to[U128]() + (lo_p >> 64)
        s1: U128 = s1a + (hi_p & 0xFFFFFFFFFFFFFFFF) + (s0 >> 64)
        s2a: U128 = r2.to[U128]() + (hi_p >> 64)
        s2: U128 = s2a + (s1 >> 64)
        limbs.stride(k).poke(s0.to_wrap[U64]())
        limbs.stride(k1).poke(s1.to_wrap[U64]())
        limbs.stride(k2).poke(s2.to[U64]())
        # carry on up the limbs
        until carry == 0 or j >= 12 with j: U64 = k + 3, carry: U64 = (s2 >> 64).to[U64]()
            r: U64 = limbs.stride(j).peek()
            s: U128 = r.to[U128]() +% carry.to[U128]()
            limbs.stride(j).poke(s.to_wrap[U64]())
            continue with j: j +% 1, carry: (s >> 64).to[U64]()

    # quadrant: bits sh and sh+1. Fraction: the 256 bits under sh, normalized
    q: U64 = limbs_bits64(p: limbs, pos: sh) & 3
    a: U64 = limbs_bits64(p: limbs, pos: sh - 64)
    b: U64 = limbs_bits64(p: limbs, pos: sh - 128)
    c: U64 = limbs_bits64(p: limbs, pos: sh - 192)
    d: U64 = limbs_bits64(p: limbs, pos: sh - 256)
    a_high: U128 = a.to[U128]() << 64
    x_hi: U128 = a_high | b.to[U128]()
    c_high: U128 = c.to[U128]() << 64
    x_lo: U128 = c_high | d.to[U128]()
    # f = X × 2^-256 in [0, 1). Past 1/2, count the next quadrant and use
    # f - 1 = -(2^256 - X) × 2^-256, complemented on all 256 bits before
    # normalizing: f can be 1 - 2^-120, and f - 1 taken after cutting f to
    # 192 bits would keep only its last 72.
    past_half: Bool = a >> 63 == 1
    neg_lo: U128 = 0 -% x_lo
    borrow: U128 = (x_lo != 0).to[U128]()
    neg_hi: U128 = 0 -% x_hi -% borrow
    use_hi: U128 = when
        past_half => neg_hi
        else => x_hi
    use_lo: U128 = when
        past_half => neg_lo
        else => x_lo
    magnitude: B128Extended = wide_from_256(hi: use_hi, lo: use_lo)
    g: B128Extended = when
        past_half => -magnitude
        else => magnitude
    k: U64 = when
        past_half => q +% 1 & 3
        else => q
    theta: B128Extended = g * wide_table(hi: WIDE_HALF_PI_HI.to[@U128](),
        lo: WIDE_HALF_PI_LO.to[@U64](), exponent: WIDE_HALF_PI_EXP.to[@S64](), i: 0)
    r: Reduced = Reduced(quadrant: k, theta: theta)
    return r

### (hi × 2^128 + lo) × 2^-256 as a B128Extended, keeping its top 192 bits.
### :param hi: The high 128 bits.
### :param lo: The low 128 bits.
### :returns: The normalized value, or zero.
secret routine wide_from_256(hi: U128, lo: U128) -> B128Extended
    exponent: &S64 <- -1

    loop with upper: U128 = hi, lower: U128 = lo
        empty: Bool = upper == 0
        all: Bool = empty and lower == 0
        zero_result: B128Extended = wide_zero()
        when
            all => return zero_result
            empty => nothing
            else =>
                s: S64 = upper.leading_zeros().to[S64]()
                some: Bool = s > 0
                carry: U128 = when
                    some => lower >> (128 - s).to[U128]()
                    else => 0
                new_hi: U128 = (upper << s.to[U128]()) | carry
                new_lo: U128 = lower << s.to[U128]()
                w: B128Extended = B128Extended(negative: false, exponent: exponent.load() - s,
                    hi: new_hi, lo: (new_lo >> 64).to[U64]())
                return w
        (exponent.load() -% 128).poke_into(exponent)
        continue with upper: lower, lower: 0

# -- sin, cos, tan -------------------------------------------------------------

secret choice TrigKind: U8
    SIN
    COS
    TAN

### sin θ = θ Σ (-θ²)^k / (2k+1)!, 18 terms, for |θ| <= π/4 (the first dropped term is below 2^-139).
### :param t: θ.
### :returns: sin θ at 192 bits.
secret routine wide_sin_core(t: B128Extended) -> B128Extended
    u: B128Extended = -(t * t)
    s: &B128Extended <- .hollow()

    last: B128Extended = wide_table(hi: WIDE_SIN_COEF_HI.to[@U128](),
        lo: WIDE_SIN_COEF_LO.to[@U64](), exponent: WIDE_SIN_COEF_EXP.to[@S64](), i: 17)
    last.poke_into(s)

    loop with i: S64 = 16
        done2: Bool = i < 0
        r2: B128Extended = s.load() * t
        if done2
            return r2
        c: B128Extended = wide_table(hi: WIDE_SIN_COEF_HI.to[@U128](),
            lo: WIDE_SIN_COEF_LO.to[@U64](), exponent: WIDE_SIN_COEF_EXP.to[@S64](), i: i.to[U64]())
        s.store(s.load() * u + c)
        continue with i: i - 1

### cos θ = Σ (-θ²)^k / (2k)!, 18 terms, for |θ| <= π/4 (the first dropped term is below 2^-139).
### :param t: θ.
### :returns: cos θ at 192 bits.
secret routine wide_cos_core(t: B128Extended) -> B128Extended
    u: B128Extended = -(t * t)
    s: &B128Extended <- .hollow()

    last: B128Extended = wide_table(hi: WIDE_COS_COEF_HI.to[@U128](),
        lo: WIDE_COS_COEF_LO.to[@U64](), exponent: WIDE_COS_COEF_EXP.to[@S64](), i: 17)
    last.poke_into(s)

    until i < 0 with i: S64 = 16
        c: B128Extended = wide_table(hi: WIDE_COS_COEF_HI.to[@U128](),
            lo: WIDE_COS_COEF_LO.to[@U64](), exponent: WIDE_COS_COEF_EXP.to[@S64](), i: i.to[U64]())
        s.store(s.load() * u + c)
        continue with i: i - 1
    then
        return s.load()

### sin and cos of NaN (a quiet NaN) and of the infinities (NaN).
### :param x: A NaN or an infinity.
### :returns: The quieted NaN for a NaN, else the default NaN.
secret routine b128_trig_nonfinite(x: B128) -> B128
    is_nan: Bool = x.is_nan()
    quiet: B128 = b128_of(b128_quiet(x.bits()))
    r: B128 = when
        is_nan => quiet
        else => nan
    return r

# -- more B128Extended -----------------------------------------------------------------

### `me` with its sign cleared.
### :returns: |`me`|.
routine B128Extended.abs() -> Me
    r: Me = Me(negative: false, exponent: me.exponent, hi: me.hi, lo: me.lo)
    return r

### sqrt for me > 0: Newton's method on 1/sqrt, y ← y (3 - a y²) / 2, from a B64 seed (53 bits → 106 → 212),
### then × a. Zero gives itself.
### :returns: The square root.
routine B128Extended.sqrt() -> Me
    if me.is_zero()
        return me
    half_e: S64 = me.exponent >> 1  # floor(e / 2)
    unit: Me = me.ldexp((0 - half_e) * 2)  # in [1, 4)
    unit128: B128 = unit.to[B128]()
    seed64: B64 = unit128.to_unchecked[B64]().sqrt_unchecked()
    one64: B64 = 1.0
    y0: Me = B128.to[Me]((one64 /! seed64).to[B128]())
    three: Me = S64.to[Me](3)
    y1: Me = (y0 * (three - unit * y0 * y0)).ldexp(-1)
    y2: Me = (y1 * (three - unit * y1 * y1)).ldexp(-1)
    r: Me = (unit * y2).ldexp(half_e)
    return r

### Whether |me| > 1.
### :returns: True when the magnitude is above 1.
routine B128Extended.is_above_one() -> Bool
    big: Bool = me.exponent > 0
    one_e: Bool = me.exponent == 0
    more: Bool = me.hi != B128_SIGN or me.lo != 0
    zero: Bool = me.is_zero()
    return (big or (one_e and more)) and not zero

### The B128Extended 1.
### :returns: 1.
secret routine wide_one() -> B128Extended
    r: B128Extended = S64.to[B128Extended](1)
    return r

### π/2 at 192 bits.
### :returns: π/2.
secret routine wide_half_pi() -> B128Extended
    r: B128Extended = wide_table(hi: WIDE_HALF_PI_HI.to[@U128](), lo: WIDE_HALF_PI_LO.to[@U64](),
        exponent: WIDE_HALF_PI_EXP.to[@S64](), i: 0)
    return r

# -- exp_m1, ln_1p ---------------------------------------------------------------

### e^x - 1 without cancellation: below |x| = 1/2 the series x Σ x^j / (j+1)! (35 terms, the first dropped one
### under 2^-150 relative), else e^x - 1.
### :param x: The exponent.
### :returns: e^x - 1 at 192 bits.
secret routine wide_exp_m1(x: B128Extended) -> B128Extended
    s: &B128Extended <- .hollow()

    if x.exponent < -1
        last: B128Extended = wide_table(hi: WIDE_EXP_COEF_HI.to[@U128](),
            lo: WIDE_EXP_COEF_LO.to[@U64](), exponent: WIDE_EXP_COEF_EXP.to[@S64](), i: 35)
        last.poke_into(s)

        loop with i: U64 = 34
            done2: Bool = i < 1
            r2: B128Extended = s.load() * x
            if done2
                return r2
            c: B128Extended = wide_table(hi: WIDE_EXP_COEF_HI.to[@U128](),
                lo: WIDE_EXP_COEF_LO.to[@U64](), exponent: WIDE_EXP_COEF_EXP.to[@S64](), i)
            s.store(s.load() * x + c)
            continue with i: i - 1
    else
        r: B128Extended = wide_exp(x) - wide_one()
        return r

### ln(1 + x) for x > -1: below |x| = 1/4, 2 atanh(t) with t = x / (2 + x) (|t| < 0.143, inside the log
### series' reach), else ln of 1 + x, which is exact.
### :param x: The argument, above -1.
### :returns: ln(1 + x) at 192 bits.
secret routine wide_ln_1p(x: B128Extended) -> B128Extended
    s: &B128Extended <- .hollow()

    if x.exponent < -2
        t: B128Extended = x / (x + S64.to[B128Extended](2))
        tt: B128Extended = t * t
        last: B128Extended = wide_table(hi: WIDE_LOG_COEF_HI.to[@U128](),
            lo: WIDE_LOG_COEF_LO.to[@U64](), exponent: WIDE_LOG_COEF_EXP.to[@S64](), i: 25)
        last.poke_into(s)

        loop with i: S64 = 24
            done2: Bool = i < 0
            r2: B128Extended = (s.load() * t).ldexp(1)
            if done2
                return r2
            c: B128Extended = wide_table(hi: WIDE_LOG_COEF_HI.to[@U128](),
                lo: WIDE_LOG_COEF_LO.to[@U64](), exponent: WIDE_LOG_COEF_EXP.to[@S64](),
                i: i.to[U64]())
            s.store(s.load() * tt + c)
            continue with i: i - 1
    else
        r: B128Extended = wide_log(x + wide_one())
        return r

# -- atan ----------------------------------------------------------------------

### atan x = x Σ (-x²)^k / (2k+1), 26 terms, for |x| < 0.1.
### :param x: The argument.
### :returns: atan x at 192 bits.
secret routine wide_atan_series(x: B128Extended) -> B128Extended
    u: B128Extended = -(x * x)
    s: &B128Extended <- .hollow()

    last: B128Extended = wide_table(hi: WIDE_LOG_COEF_HI.to[@U128](),
        lo: WIDE_LOG_COEF_LO.to[@U64](), exponent: WIDE_LOG_COEF_EXP.to[@S64](), i: 25)
    last.poke_into(s)

    loop with i: S64 = 24
        done2: Bool = i < 0
        r2: B128Extended = s.load() * x
        if done2
            return r2
        c: B128Extended = wide_table(hi: WIDE_LOG_COEF_HI.to[@U128](),
            lo: WIDE_LOG_COEF_LO.to[@U64](), exponent: WIDE_LOG_COEF_EXP.to[@S64](), i: i.to[U64]())
        s.store(s.load() * u + c)
        continue with i: i -% 1

### atan x for any finite x: past |x| = 1, π/2 - atan(1/|x|). Then three half-angle steps
### x ← x / (1 + sqrt(1 + x²)) bring |x| <= 1 under 0.1.
### :param x: The argument.
### :returns: atan x at 192 bits.
secret routine wide_atan(x: B128Extended) -> B128Extended
    a: B128Extended = x.abs()
    big: Bool = a.is_above_one()
    t: &B128Extended <- .hollow()

    inv: B128Extended = wide_one() / a
    small: B128Extended = when
        big => inv
        else => a
    small.poke_into(t)

    until n >= 3 with n: S64 = 0
        one: B128Extended = wide_one()
        next: B128Extended = t.load() / (one + (one + t.load() * t.load()).sqrt())
        next.poke_into(t)
        continue with n: n +% 1
    r0: B128Extended = wide_atan_series(t.load()).ldexp(3)
    r1: B128Extended = when
        big => wide_half_pi() - r0
        else => r0
    r: B128Extended = when
        x.negative => -r1
        else => r1
    return r

# -- B128 methods --------------------------------------------------------------

# sinh, cosh, and tanh, correctly rounded, are in Hyperbolic.te.

# -- exponentials and logarithms -----------------------------------------------

### The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even), in
### two tiers ({b128_log_base}): both logarithms in B128Extended (192 bits, each within 2^-137.9 relative) divided
### there, kept when all of the quotient × (1 ± 2^-132) rounds to one B128, else both logarithms in B128Big (448 bits)
### divided there, within about 2^-420 relative, and rounded once. Exact results come out exact: log(8, 2) = 3,
### log(10^30, 10) = 30, log(x, x) = 1.
### :param base: The base of the logarithm.
### :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the B128 quotient
###     ln(`me`) / ln(`base`): NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for
###     `me` 1 or base 0 or +inf, NaN when both logarithms are zero or both infinite.
### :note: The first tier decides every pair but those whose quotient lies within about 2^-131 of a midpoint: none of
###     120000 pairs drawn from the whole range, but some with `me` and `base` both within a few ulps of 1, where
###     ln(1 + u) / ln(1 + v) = (u / v)(1 - (u - v) / 2 + (4u + v)(u - v) / 12 + …) can sit within 2^-227 of a
###     midpoint, and within 2^-334 where u = -v/4 drops the second-order term: log(1 - 2^-112, 1 + 2^-110).
### :note: The quotient is never a midpoint, so rounding the B128Big quotient once rounds it correctly. With
###     x = `me`, it is always normal: |ln x| <= 11433 and |ln base| >= about 2^-113 keep it below 2^127, and the
###     same bounds the other way keep it above 2^-127. So a midpoint is an odd integer of 114 bits times a power of
###     2, a rational, and only a rational quotient could be one. If ln x / ln base = p / q in lowest terms (q > 0),
###     then x^q = base^p, so q v_r(x) = p v_r(base) for every prime r (v_r counts the
###     factors r). As p and q are coprime, q divides v_r(base) and p divides v_r(x), so x = c^p and base = c^q for
###     the positive rational c with v_r(c) = v_r(x) / p. A midpoint needs an odd part of p of 114 bits, so
###     |p| >= 2^113. base is not 1, so c is not 1, and some prime r has v_r(c) nonzero, giving
###     |v_r(x)| >= |p| >= 2^113. But a finite B128 is m 2^e with m < 2^113 and -16494 <= e <= 16271, so
###     |v_2(x)| <= 16494 and v_r(x) <= 71 for an odd prime r.
routine B128.log_unchecked(base: Me) -> Me
    x_bits: U128 = me.bits()
    base_bits: U128 = base.bits()

    # positive and finite: the sign bit clear and the exponent below the top
    x_ok: Bool = x_bits > 0 and x_bits < B128_INF
    base_ok: Bool = base_bits > 0 and base_bits < B128_INF
    one: Bool = x_bits == B128_ONE or base_bits == B128_ONE
    if x_ok and base_ok and not one
        return b128_log_base(x: me, base, exact: false)
    return me.ln_unchecked() /! base.ln_unchecked()

# -- powers and roots ----------------------------------------------------------

### Whether x is a finite integer.
### :param x: The value.
### :returns: True for a finite x with no fractional part.
secret routine b128_is_integer(x: B128) -> Bool
    integral: Bool = x.trunc() == x
    return integral and x.is_finite()

### Whether x is an odd integer. |x| >= 2^113 is always even.
### :param x: The value.
### :returns: True for an odd finite integer.
secret routine b128_is_odd_integer(x: B128) -> Bool
    int: Bool = b128_is_integer(x)
    big: Bool = x.abs() >= b128_of(0x40700000000000000000000000000000)  # 2^113
    whole: S128 = x.to_clamp[S128]()
    odd: Bool = whole & 1 == 1
    return int and not big and odd

# -- angles --------------------------------------------------------------------

### 1/sqrt(pi), ln(2 pi), ln(pi), pi
preset WIDE_SPECIAL_CONST_HI: &Array[U128, 4] <- [0x906EBA8214DB688D71D48A7F6BFEC344,
    0xEB3F8E4325F5A53494BC900144192023, 0x928682473D0DE85EAFCAB635421FA4CC,
    0xC90FDAA22168C234C4C6628B80DC1CD1]

preset WIDE_SPECIAL_CONST_LO: &Array[U64, 4] <- [1443862089616487703, 0xCFB08F8D13458B4E,
    3402168225884614711, 2955010104097229940]

preset WIDE_SPECIAL_CONST_EXP: &Array[S64, 4] <- [-1, 0, 0, 1]

### x times constant `which` of {wide_const}, rounded once. Zeros, infinities, and NaN pass through.
### :param x: The angle.
### :param which: 4 for 180/π (to degrees), 5 for π/180 (to radians).
### :returns: The scaled angle.
secret routine b128_scale_angle(x: B128, which: U64) -> B128
    if b128_is_zero_bits(x.bits()) or not x.is_finite()
        return x
    scaled: B128Extended = x.to[B128Extended]() * wide_const(which)
    r: B128 = scaled.to[B128]()
    return r

### `me` (in radians) in degrees, rounded once. Zeros, infinities, and NaN pass through.
### :returns: `me` × 180/π.
routine B128.to_degrees_unchecked() -> Me
    r: Me = b128_scale_angle(x: me, which: 4)
    return r

### `me` (in degrees) in radians, rounded once. Zeros, infinities, and NaN pass through.
### :returns: `me` × π/180.
routine B128.to_radians() -> Me
    r: Me = b128_scale_angle(x: me, which: 5)
    return r

# -- constants of erf and gamma -------------------------------------------------

### Entry i of the erf and gamma constants: 0 = 1/sqrt(π), 1 = ln(2π), 2 = ln π, 3 = π.
### :param i: The entry, 0 to 3.
### :returns: The constant at 192 bits.
secret routine wide_special(i: U64) -> B128Extended
    w: B128Extended = wide_table(hi: WIDE_SPECIAL_CONST_HI.to[@U128](),
        lo: WIDE_SPECIAL_CONST_LO.to[@U64](), exponent: WIDE_SPECIAL_CONST_EXP.to[@S64](), i)
    return w
