# Tessera stdlib: S16 — 16-bit signed integer
#
# Maps to LLVM IR i16. Every S / U width shares the same method set.
#
# add / sub / mul / floordiv / mod / neg / abs / pow are failable: they throw
# IntegerOverflowError (or DivisionByZeroError) when the result doesn't fit,
# so a bare call stops there and `try a + b` gives None. A lossy to[T] crashes,
# and to_checked[T] gives None instead. add / sub / mul / pow / neg / abs and
# the conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard/System

### S16 is a 16-bit signed two's-complement integer. Arithmetic throws `IntegerOverflowError` on overflow (`try a + b` gives None), with `_wrap` and `_clamp` forms for the other behaviors.
@llvm("i16")
record S16
obeys Equatable[S16], Comparable[S16], Hashable[S16]
obeys Numeric[S16], Exponentiable[S16], Negatable[S16], WrappingArithmetic[S16], ClampingArithmetic[S16], Bitwiseable[S16], Invertible[S16], Shiftable[S16]

# -- constants -------------------------------------------------------------------

### The smallest value a S16 can hold.
preset S16.MIN: S16 = -32768
### The largest value a S16 can hold.
preset S16.MAX: S16 = 32767
### The width of S16 in bits.
preset S16.BITS: S16 = 16

# -- bits ------------------------------------------------------------------------

### Counts the bits of `me` that are 1.
### :returns: The population count, between 0 and `BITS`.
routine S16.count_ones() -> Me
    r: Me = popcount[Me](me)
    return r

### Counts the consecutive 0 bits starting at the most significant bit.
### :returns: The count, which is `BITS` when `me` is 0.
routine S16.leading_zeros() -> Me
    r: Me = clz[Me](val: me, is_zero_undef: false)
    return r

### Counts the consecutive 0 bits starting at the least significant bit.
### :returns: The count, which is `BITS` when `me` is 0.
routine S16.trailing_zeros() -> Me
    r: Me = ctz[Me](val: me, is_zero_undef: false)
    return r

### Reverses the order of all bits, so the most significant bit becomes the least significant.
### :returns: The bit-reversed value.
routine S16.reverse_bits() -> Me
    r: Me = bitreverse[Me](me)
    return r

### Counts the bits of `me` that are 0.
### :returns: `BITS` minus the population count.
routine S16.count_zeros() -> Me
    inverted: Me = ~me
    r: Me = popcount[Me](inverted)
    return r

### Counts the consecutive 1 bits starting at the most significant bit.
### :returns: The count, which is `BITS` when `me` is -1.
routine S16.leading_ones() -> Me
    inverted: Me = ~me
    r: Me = clz[Me](val: inverted, is_zero_undef: false)
    return r

### Counts the consecutive 1 bits starting at the least significant bit.
### :returns: The count, which is `BITS` when `me` is -1.
routine S16.trailing_ones() -> Me
    inverted: Me = ~me
    r: Me = ctz[Me](val: inverted, is_zero_undef: false)
    return r

### Reverses the order of the bytes of `me`.
### :returns: The byte-swapped value.
routine S16.swap_bytes() -> Me
    r: Me = bswap[Me](me)
    return r

### Converts from this target's byte order to big-endian, which swaps the bytes.
### :returns: The value in big-endian byte order.
routine S16.to_be() -> Me
    r: Me = me.swap_bytes()
    return r

### Converts from big-endian to this target's byte order, which swaps the bytes.
### :returns: The value in native byte order.
routine S16.from_be() -> Me
    r: Me = me.swap_bytes()
    return r

### Converts from this target's byte order to little-endian. The target is little-endian, so this returns `me` unchanged.
### :returns: The value in little-endian byte order.
routine S16.to_le() -> Me
    return me

### Converts from little-endian to this target's byte order. The target is little-endian, so this returns `me` unchanged.
### :returns: The value in native byte order.
routine S16.from_le() -> Me
    return me

### Bitwise AND of `me` and `other`.
### :param other: The right-hand operand.
### :returns: A value with each bit set only when it is set in both operands.
routine S16.bitand(other: Me) -> Me
    r: Me = band[Me](me, other)
    return r

### Bitwise OR of `me` and `other`.
### :param other: The right-hand operand.
### :returns: A value with each bit set when it is set in either operand.
routine S16.bitor(other: Me) -> Me
    r: Me = bor[Me](me, other)
    return r

### Bitwise XOR of `me` and `other`.
### :param other: The right-hand operand.
### :returns: A value with each bit set when it is set in exactly one operand.
routine S16.bitxor(other: Me) -> Me
    r: Me = bxor[Me](me, other)
    return r

### Bitwise NOT: flips every bit of `me`.
### :returns: The complement, which equals `-me - 1`.
routine S16.bitnot() -> Me
    r: Me = bnot[Me](me)
    return r

# -- shifts ----------------------------------------------------------------------

### Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0, and a negative amount counts as out of range too.
### :param n: The shift amount in bits.
### :returns: `me` shifted left by `n`, or 0 when `n` is outside `0 ..< BITS`.
### :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine S16.shift_left(n: Me) -> Me
    in_range: Bool = 0 <= n < Me.BITS
    shifted: Me = shl[Me](val: me, amt: n)
    r: Me = when
        in_range => shifted
        else => 0
    return r

### Shift right, arithmetic: the sign bit fills in. A shift by `BITS` or more, or by a negative amount, gives the sign fill (0 or -1).
### :param n: The shift amount in bits.
### :returns: `me` shifted right by `n`, or the sign fill when `n` is outside `0 ..< BITS`.
routine S16.arith_shift_right(n: Me) -> Me
    in_range: Bool = 0 <= n < Me.BITS
    shifted: Me = ashr[Me](val: me, amt: n)
    out: Me = ashr[Me](val: me, amt: Me.BITS - 1)
    r: Me = when
        in_range => shifted
        else => out
    return r

### Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
### :param n: The rotate amount in bits.
### :returns: The rotated value.
routine S16.rotl(n: Me) -> Me
    r: Me = fshl[Me](hi: me, lo: me, amt: n)
    return r

### Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
### :param n: The rotate amount in bits.
### :returns: The rotated value.
routine S16.rotr(n: Me) -> Me
    r: Me = fshr[Me](hi: me, lo: me, amt: n)
    return r

### Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out.
### :param n: The shift amount in bits, taken modulo `BITS`.
### :returns: `me` shifted left, with 0 bits filling in.
routine S16.shift_left_wrap(n: Me) -> Me
    amount: Me = band[Me](n, 15)
    r: Me = shl[Me](val: me, amt: amount)
    return r

### Arithmetic shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of saturating.
### :param n: The shift amount in bits, taken modulo `BITS`.
### :returns: `me` shifted right with the sign bit filling in.
routine S16.arith_shift_right_wrap(n: Me) -> Me
    amount: Me = band[Me](n, 15)
    r: Me = ashr[Me](val: me, amt: amount)
    return r

# -- arithmetic ------------------------------------------------------------------

### The sum of `me` and `other`.
### :param other: The value to add.
### :returns: The sum.
### :throws: Throws `IntegerOverflowError` when the sum does not fit in `S16`.
failable routine S16.add(other: Me) -> Me
    if sadd_overflows[Me](me, other)
        throw IntegerOverflowError()
    r: Me = add[Me](a: me, b: other)
    return r

### The sum of `me` and `other`, wrapped modulo 2^16.
### :param other: The value to add.
### :returns: The low 16 bits of the exact sum.
routine S16.add_wrap(other: Me) -> Me
    r: Me = add[Me](a: me, b: other)
    return r

### The sum of `me` and `other`, saturated at `MIN` / `MAX`.
### :param other: The value to add.
### :returns: The sum, or `MIN` / `MAX` when the exact sum is below / above the range.
routine S16.add_clamp(other: Me) -> Me
    r: Me = sadd_sat[Me](me, other)
    return r

### The difference of `me` and `other`.
### :param other: The value to subtract.
### :returns: The difference.
### :throws: Throws `IntegerOverflowError` when the difference does not fit in `S16`.
failable routine S16.sub(other: Me) -> Me
    if ssub_overflows[Me](me, other)
        throw IntegerOverflowError()
    r: Me = sub[Me](me, other)
    return r

### The difference of `me` and `other`, wrapped modulo 2^16.
### :param other: The value to subtract.
### :returns: The low 16 bits of the exact difference.
routine S16.sub_wrap(other: Me) -> Me
    r: Me = sub[Me](me, other)
    return r

### The difference of `me` and `other`, saturated at `MIN` / `MAX`.
### :param other: The value to subtract.
### :returns: The difference, or `MIN` / `MAX` when the exact difference is below / above the range.
routine S16.sub_clamp(other: Me) -> Me
    r: Me = ssub_sat[Me](me, other)
    return r

### The product of `me` and `other`.
### :param other: The factor to multiply by.
### :returns: The product.
### :throws: Throws `IntegerOverflowError` when the product does not fit in `S16`.
failable routine S16.mul(other: Me) -> Me
    if smul_overflows[Me](me, other)
        throw IntegerOverflowError()
    r: Me = mul[Me](me, other)
    return r

### The product of `me` and `other`, wrapped modulo 2^16.
### :param other: The factor to multiply by.
### :returns: The low 16 bits of the exact product.
routine S16.mul_wrap(other: Me) -> Me
    r: Me = mul[Me](me, other)
    return r

### The product of `me` and `other`, saturated at `MIN` / `MAX` by the sign of the exact product.
### :param other: The factor to multiply by.
### :returns: The product, or `MIN` / `MAX` when the exact product does not fit.
routine S16.mul_clamp(other: Me) -> Me
    overflow: Bool = me.mul_overflows(other)
    negative_result: Bool = me ^ other < 0
    limit: Me = when
        negative_result => Me.MIN
        else => Me.MAX
    product: Me = mul[Me](me, other)
    r: Me = when
        overflow => limit
        else => product
    return r

### Tests whether the exact product of `me` and `other` is outside `MIN ..= MAX`.
### :param other: The factor to multiply by.
### :returns: True when the product does not fit in `S16`.
routine S16.mul_overflows(other: Me) -> Bool
    return smul_overflows[Me](me, other)

### The exact product of `me` and `other` in twice the width. It never overflows.
### :param other: The factor to multiply by.
### :returns: The product as an `S32`.
routine S16.mul_wide(other: Me) -> S32
    r: S32 = me.to[S32]() *% other.to[S32]()
    return r

# -- sign ------------------------------------------------------------------------

### The negation of `me`.
### :returns: `-me`.
### :throws: Throws `IntegerOverflowError` when `me` is `MIN`, whose negation does not fit.
failable routine S16.neg() -> Me
    if me == Me.MIN
        throw IntegerOverflowError()
    r: Me = sub[Me](0, me)
    return r

### The negation of `me`, wrapped modulo 2^16, so `MIN.neg_wrap()` is `MIN`.
### :returns: `-me`, or `MIN` when `me` is `MIN`.
routine S16.neg_wrap() -> Me
    r: Me = sub[Me](0, me)
    return r

### The negation of `me`, saturated at `MAX`, so `MIN.neg_clamp()` is `MAX`.
### :returns: `-me`, or `MAX` when `me` is `MIN`.
routine S16.neg_clamp() -> Me
    r: Me = ssub_sat[Me](0, me)
    return r

### The absolute value of `me`.
### :returns: The magnitude of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is `MIN`, whose magnitude does not fit.
failable routine S16.abs() -> Me
    if me == Me.MIN
        throw IntegerOverflowError()
    return me.abs_wrap()

### The absolute value of `me`, wrapped modulo 2^16, so `MIN.abs_wrap()` is `MIN`.
### :returns: The magnitude of `me`, or `MIN` when `me` is `MIN`.
routine S16.abs_wrap() -> Me
    negative: Bool = me < 0
    negated: Me = sub[Me](0, me)
    r: Me = when
        negative => negated
        else => me
    return r

### The absolute value of `me`, saturated at `MAX`, so `MIN.abs_clamp()` is `MAX`.
### :returns: The magnitude of `me`, or `MAX` when `me` is `MIN`.
routine S16.abs_clamp() -> Me
    is_min: Bool = me == Me.MIN
    magnitude: Me = me.abs_wrap()
    r: Me = when
        is_min => Me.MAX
        else => magnitude
    return r

### The sign of `me`.
### :returns: -1 when `me` is negative, 0 when it is 0, and 1 when it is positive.
routine S16.signum() -> Me
    negative: Bool = me < 0
    positive: Bool = me > 0
    non_negative: Me = when
        positive => 1
        else => 0
    r: Me = when
        negative => -1
        else => non_negative
    return r

### Tests whether `me` is below zero.
### :returns: True when `me < 0`.
routine S16.is_negative() -> Bool
    return me < 0

### Tests whether `me` is above zero.
### :returns: True when `me > 0`.
routine S16.is_positive() -> Bool
    return me > 0

# -- division --------------------------------------------------------------------

### The quotient of `me` divided by `other`, truncated toward zero.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.div_trunc(-1)`.
@track_caller
routine S16.div_trunc(other: Me) -> Me
    if other == 0
        crash_division_by_zero()
    if me == Me.MIN and other == -1
        crash_overflow()
    r: Me = sdiv[Me](me, other)
    return r

### The remainder of `me` divided by `other`. It has the dividend's sign.
### :param other: The divisor.
### :returns: The remainder, with the sign of `me`.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.mod_trunc(-1)`.
@track_caller
routine S16.mod_trunc(other: Me) -> Me
    if other == 0
        crash_division_by_zero()
    if me == Me.MIN and other == -1
        crash_overflow()
    r: Me = srem[Me](me, other)
    return r

### The Euclidean quotient of `me` divided by `other`. `MIN.floordiv_wrap(-1)` wraps to `MIN`.
### :param other: The divisor.
### :returns: The quotient, or `MIN` for `MIN.floordiv_wrap(-1)`.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine S16.floordiv_wrap(other: Me) -> Me
    if other == 0
        crash_division_by_zero()
    if me == Me.MIN and other == -1
        return Me.MIN
    r: Me = me.floordiv(other)
    return r

### The Euclidean remainder of `me` divided by `other` (never negative). `MIN.mod_wrap(-1)` is 0.
### :param other: The divisor.
### :returns: The remainder, or 0 for `MIN.mod_wrap(-1)`.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine S16.mod_wrap(other: Me) -> Me
    if other == 0
        crash_division_by_zero()
    if me == Me.MIN and other == -1
        return 0
    r: Me = me.mod(other)
    return r

### The quotient of Euclidean division, chosen so the remainder is never negative.
### :param other: The divisor.
### :returns: The quotient `q` for which `me - q * other` is in `0 ..< |other|`.
### :throws: Throws `DivisionByZeroError` when `other` is 0, and `IntegerOverflowError` on `MIN.floordiv(-1)`.
failable routine S16.floordiv(other: Me) -> Me
    if other == 0
        throw DivisionByZeroError()
    if me == Me.MIN and other == -1
        throw IntegerOverflowError()
    q: Me = me.div_trunc(other)
    rem: Me = me.mod_trunc(other)
    if not (rem < 0)
        return q
    if other > 0
        r: Me = q - 1
        return r
    r: Me = q + 1
    return r

### The remainder of Euclidean division, always in `0 ..< |other|`.
### :param other: The divisor.
### :returns: The remainder, never negative.
### :throws: Throws `DivisionByZeroError` when `other` is 0, and `IntegerOverflowError` on `MIN.mod(-1)`.
failable routine S16.mod(other: Me) -> Me
    if other == 0
        throw DivisionByZeroError()
    if me == Me.MIN and other == -1
        throw IntegerOverflowError()
    rem: Me = me.mod_trunc(other)
    if not (rem < 0)
        return rem
    magnitude: Me = other.abs_wrap()
    r: Me = add[Me](a: rem, b: magnitude)
    return r

# -- powers ----------------------------------------------------------------------

### Raises `me` to the power `exponent`.
### :param exponent: The power to raise to.
### :returns: `me` to the power `exponent`.
### :throws: Throws `IntegerOverflowError` when the exact power does not fit in `S16`, and
###     `NegativeExponentError` when `exponent` is negative: the power is a fraction then.
failable routine S16.pow(exponent: Me) -> Me
    if exponent < 0
        throw NegativeExponentError()
    local base: @Me <- me
    local acc: @Me <- 1
    local overflow: @Bool <- false

    while exponent_left != 0 with exponent_left: Me = exponent
        # The accumulator only multiplies on odd bits, and the base only needs
        # squaring while bits remain, so only those overflows count.
        odd: Bool = exponent_left & 1 != 0
        acc_overflow: Bool = smul_overflows[Me](acc.peek(), base.peek()) and odd
        with_base: Me = mul[Me](acc.peek(), base.peek())
        next_acc: Me = when
            odd => with_base
            else => acc.peek()
        rest: Me = exponent_left >> 1
        more: Bool = rest != 0
        base_overflow: Bool = smul_overflows[Me](base.peek(), base.peek()) and more
        any: Bool = overflow.peek() or acc_overflow or base_overflow
        next_overflow: Bool = any
        next_acc2: Me = next_acc
        next_base: Me = mul[Me](base.peek(), base.peek())
        next_base.poke_into(base)
        next_acc2.poke_into(acc)
        next_overflow.poke_into(overflow)
        continue with exponent_left: rest
    fits: Bool = not overflow.peek()
    if not fits
        throw IntegerOverflowError()
    return acc.peek()

### Raises `me` to the power `exponent` by squaring, wrapping modulo 2^16.
### :param exponent: The power to raise to.
### :returns: The low 16 bits of the exact power.
### :throws: Crashes with `NumericDomainError` when `exponent` is negative.
routine S16.pow_wrap(exponent: Me) -> Me
    if exponent < 0
        crash_negative_exponent()
    local base: @Me <- me
    local acc: @Me <- 1

    while exponent_left != 0 with exponent_left: Me = exponent
        odd: Bool = exponent_left & 1 != 0
        with_base: Me = mul[Me](acc.peek(), base.peek())
        next_acc: Me = when
            odd => with_base
            else => acc.peek()
        next_acc2: Me = next_acc
        next_base: Me = mul[Me](base.peek(), base.peek())
        next_base.poke_into(base)
        next_acc2.poke_into(acc)
        continue with exponent_left: exponent_left >> 1
    then
        return acc.peek()

### Raises `me` to the power `exponent`, saturated at `MIN` or `MAX` by the sign the exact power would have.
### :param exponent: The power to raise to.
### :returns: The power, or `MIN` / `MAX` when the exact power does not fit.
### :throws: Crashes with `NumericDomainError` when `exponent` is negative.
routine S16.pow_clamp(exponent: Me) -> Me
    if exponent < 0
        crash_negative_exponent()
    odd_exp: Bool = exponent & 1 != 0
    negative_result: Bool = me < 0 and odd_exp
    limit: Me = when
        negative_result => Me.MIN
        else => Me.MAX
    checked: Maybe[Me] = try me.pow(exponent)
    r: Me = checked.unwrap_or(limit)
    return r

# -- equality and ordering -------------------------------------------------------

### Tests whether `me` and `other` are equal.
### :param other: The value to compare with.
### :returns: True when the values are equal.
routine S16.eq(other: Me) -> Bool
    return ieq[Me](me, other)

### Tests whether `me` and `other` differ.
### :param other: The value to compare with.
### :returns: True when the values are not equal.
routine S16.ne(other: Me) -> Bool
    return ine[Me](me, other)

### Signed less-than comparison.
### :param other: The value to compare with.
### :returns: True when `me < other`.
@external("llvm")
@template("{result} = icmp slt i16 {me}, {other}")
routine S16.lt(other: Me) -> Bool

### Signed less-than-or-equal comparison.
### :param other: The value to compare with.
### :returns: True when `me <= other`.
@external("llvm")
@template("{result} = icmp sle i16 {me}, {other}")
routine S16.le(other: Me) -> Bool

### Signed greater-than comparison.
### :param other: The value to compare with.
### :returns: True when `me > other`.
@external("llvm")
@template("{result} = icmp sgt i16 {me}, {other}")
routine S16.gt(other: Me) -> Bool

### Signed greater-than-or-equal comparison.
### :param other: The value to compare with.
### :returns: True when `me >= other`.
@external("llvm")
@template("{result} = icmp sge i16 {me}, {other}")
routine S16.ge(other: Me) -> Bool

### Compares `me` with `other` by signed order.
### :param other: The value to compare with.
### :returns: -1 when `me < other`, 0 when they are equal, and 1 when `me > other`.
routine S16.compare(other: Me) -> S32
    if me < other
        return -1
    if me > other
        return 1
    return 0

### Returns the smaller of two values by signed comparison.
### :param other: The value to compare with.
### :returns: `me` or `other`, whichever is smaller.
routine S16.min(other: Me) -> Me
    r: Me = smin[Me](me, other)
    return r

### Returns the larger of two values by signed comparison.
### :param other: The value to compare with.
### :returns: `me` or `other`, whichever is larger.
routine S16.max(other: Me) -> Me
    r: Me = smax[Me](me, other)
    return r

### Limits `me` to the range from `lo` to `hi`, both ends included.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
### :throws: Crashes with `InvalidValueError` when `lo > hi`.
@track_caller
routine S16.clamp(lo: Me, hi: Me) -> Me
    if lo <= hi
        at_least_lo: Me = smax[Me](me, lo)
        r: Me = smin[Me](at_least_lo, hi)
        return r
    crash_invalid_value()

# -- hash ------------------------------------------------------------------------

### SipHash-2-4 of the bits widened to 64, under the process key, the same hash for `S16` and `U16`.
### :returns: The 64-bit hash of `me`.
routine S16.hash() -> U64
    bits: U16 = bitcast[Me, U16](me)
    h: U64 = siphash24(value: bits.to[U64](), key: hash_key())
    return h

# -- differences, midpoints, logarithms, roots -----------------------------------

### The distance between `me` and `other`, `|me - other|`, which always fits in `U16`.
### :param other: The value to measure from.
### :returns: `|me - other|` as a `U16`.
routine S16.abs_diff(other: Me) -> U16
    hi: Me = smax[Me](me, other)
    lo: Me = smin[Me](me, other)
    diff: Me = sub[Me](hi, lo)
    r: U16 = bitcast[Me, U16](diff)
    return r

### The average of `me` and `other`, rounded toward zero, computed without overflow.
### :param other: The other value.
### :returns: `(me + other) / 2`, rounded toward zero.
routine S16.midpoint(other: Me) -> Me
    common: Me = me & other
    half_diff: Me = (me ^ other) >> 1
    rounded_down: Me = add[Me](a: common, b: half_diff)
    parity: Me = (me ^ other) & 1
    odd_sum: Bool = parity != 0
    round_up: Bool = odd_sum and rounded_down < 0
    up: Me = add[Me](a: rounded_down, b: 1)
    r: Me = when
        round_up => up
        else => rounded_down
    return r

### The base-2 logarithm of `me`, rounded down.
### :returns: `floor(log2(me))`.
### :throws: Crashes with `NumericDomainError` when `me <= 0`.
@track_caller
routine S16.ilog2() -> Me
    if not (me > 0)
        crash_numeric_domain()
    r: Me = bitcast[U16, Me](bitcast[Me, U16](me).ilog2())
    return r

### The base-10 logarithm of `me`, rounded down.
### :returns: `floor(log10(me))`.
### :throws: Crashes with `NumericDomainError` when `me <= 0`.
@track_caller
routine S16.ilog10() -> Me
    if not (me > 0)
        crash_numeric_domain()
    r: Me = bitcast[U16, Me](bitcast[Me, U16](me).ilog10())
    return r

### The integer square root of `me`, rounded down.
### :returns: `floor(sqrt(me))`.
### :throws: Crashes with `NumericDomainError` when `me` is negative.
@track_caller
routine S16.isqrt() -> Me
    if me < 0
        crash_numeric_domain()
    r: Me = bitcast[U16, Me](bitcast[Me, U16](me).isqrt())
    return r

# -- conversions -----------------------------------------------------------------

### Converts `me` to `S8`.
### to[T] returns the same value in another integer type. A conversion that
### can't lose the value returns it directly. One that can crashes when the value
### doesn't fit, and has to_checked[T] (Maybe), to_wrap[T] (keep the low bits),
### and to_clamp[T] (saturate) forms.
### :returns: The same numeric value as an `S8`.
### :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
@track_caller
routine S16.to[S8]() -> S8
    if not (-128 <= me <= 127)
        crash_overflow()
    r: S8 = trunc[Me, S8](me)
    return r

### Converts `me` to `S8` when the value fits.
### :returns: The value as an `S8`.
### :absent: When `me` is outside the range of `S8`.
routine S16.to_checked[S8]() -> Maybe[S8]
    fits: Bool = -128 <= me <= 127
    value: S8 = trunc[Me, S8](me)
    r: Maybe[S8] = fits.then_present(value)
    return r

### Converts `me` to `S8`, keeping the low 8 bits (modulo 2^8).
### :returns: `me` modulo 2^8, as an `S8`.
routine S16.to_wrap[S8]() -> S8
    r: S8 = trunc[Me, S8](me)
    return r

### Converts `me` to `S8`, saturating at `S8`'s range.
### :returns: `me`, or the nearest end of `S8`'s range when it does not fit.
routine S16.to_clamp[S8]() -> S8
    at_least: Me = smax[Me](me, -128)
    at_most: Me = smin[Me](at_least, 127)
    r: S8 = trunc[Me, S8](at_most)
    return r

### The identity conversion: returns `me` unchanged.
### :returns: `me` as `S16`.
routine S16.to[Me]() -> Me
    return me

### Sign-extends `me` to `S32`. Every `S16` value fits, so this never fails.
### :returns: The same numeric value as an `S32`.
routine S16.to[S32]() -> S32
    r: S32 = sext[Me, S32](me)
    return r

### Sign-extends `me` to `S64`. Every `S16` value fits, so this never fails.
### :returns: The same numeric value as an `S64`.
routine S16.to[S64]() -> S64
    r: S64 = sext[Me, S64](me)
    return r

### Sign-extends `me` to `S128`. Every `S16` value fits, so this never fails.
### :returns: The same numeric value as an `S128`.
routine S16.to[S128]() -> S128
    r: S128 = sext[Me, S128](me)
    return r

### Sign-extends `me` to `S256`. Every `S16` value fits, so this never fails.
### :returns: The same numeric value as an `S256`.
routine S16.to[S256]() -> S256
    r: S256 = sext[Me, S256](me)
    return r

### Converts `me` to `U8`.
### :returns: The same numeric value as a `U8`.
### :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U8`.
@track_caller
routine S16.to[U8]() -> U8
    if not (0 <= me <= 255)
        crash_overflow()
    r: U8 = trunc[Me, U8](me)
    return r

### Converts `me` to `U8` when the value fits.
### :returns: The value as a `U8`.
### :absent: When `me` is negative or above the largest `U8`.
routine S16.to_checked[U8]() -> Maybe[U8]
    fits: Bool = 0 <= me <= 255
    value: U8 = trunc[Me, U8](me)
    r: Maybe[U8] = fits.then_present(value)
    return r

### Converts `me` to `U8`, keeping the low 8 bits (modulo 2^8).
### :returns: `me` modulo 2^8, as a `U8`.
routine S16.to_wrap[U8]() -> U8
    r: U8 = trunc[Me, U8](me)
    return r

### Converts `me` to `U8`, saturating at `U8`'s range.
### :returns: `me`, or the nearest end of `U8`'s range when it does not fit.
routine S16.to_clamp[U8]() -> U8
    at_least: Me = smax[Me](me, 0)
    at_most: Me = smin[Me](at_least, 255)
    r: U8 = trunc[Me, U8](at_most)
    return r

### Converts `me` to `U16`.
### :returns: The same numeric value as a `U16`.
### :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U16`.
@track_caller
routine S16.to[U16]() -> U16
    if not (me >= 0)
        crash_overflow()
    r: U16 = bitcast[Me, U16](me)
    return r

### Converts `me` to `U16` when the value fits.
### :returns: The value as a `U16`.
### :absent: When `me` is negative.
