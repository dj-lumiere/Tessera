# Lapila stdlib: Addr — an address with no pointee type
#
# Maps to LLVM IR ptr, like PointedCell[T]. Addr is C's `void*`: what a memory manager hands out, a callback's state, an
# opaque C handle. It says where, not what, so it has no load or store: memory is read through a @T, and
# to[@T]() names what is there. Any @T converts to Addr where one is expected. It moves by a ByteSize with +% and -%,
# and b -% a is the distance from a to b. Two addresses compare with === and !==.

module System

### An address with no pointee type, mapped to LLVM `ptr` (C's `void*`). It says where, not what: it has no load or
### store, and `to[@T]()` names what is there. It moves by a `ByteSize` with `+%` / `-%` (wrapping, unchecked), and
### `b -% a` is the distance from `a` to `b`. Two addresses compare with `===` / `!==`.
@llvm("ptr")
record Addr
obeys WrappingOffsetAddable[Addr], WrappingOffsetSubtractable[Addr]
    nothing

# -- identity ------------------------------------------------------------------

### Whether `me` and `other` are the same address: `me === other`.
### :param other: The right-hand operand.
### :returns: `true` when the addresses are equal.
routine Addr.same(other: Me) -> Bool
    a: U64 = ptrtoint[Me, U64](me)
    b: U64 = ptrtoint[Me, U64](other)
    return ieq[U64](a, b)

### Whether `me` and `other` are different addresses: `me !== other`.
### :param other: The right-hand operand.
### :returns: `true` when the addresses differ.
routine Addr.notsame(other: Me) -> Bool
    a: U64 = ptrtoint[Me, U64](me)
    b: U64 = ptrtoint[Me, U64](other)
    return ine[U64](a, b)

### The address 0, which points at nothing: a C routine's null argument, or an address not yet found.
### :returns: The address 0.
common routine Addr.zero() -> Me
    r: Me = inttoptr[U64, Me](0)
    return r

# -- predicates ----------------------------------------------------------------

### Whether `me` is hollow: the address 0.
### :returns: `true` when the address is 0.
routine Addr.is_hollow() -> Bool
    a: U64 = ptrtoint[Me, U64](me)
    return ieq[U64](a, 0)

### Whether `me` is not hollow: an address other than 0.
### :returns: `true` when the address is not 0.
routine Addr.is_not_hollow() -> Bool
    a: U64 = ptrtoint[Me, U64](me)
    return ine[U64](a, 0)

# -- arithmetic and typing -----------------------------------------------------

### The address `offset` bytes further on: `me +% offset`. It wraps around the end of the address space, and nothing
### checks bounds: staying inside the block is the caller's job.
### :param offset: How far to move.
### :returns: The moved address.
routine Addr.add_wrap(offset: ByteSize) -> Me
    r: Me = addr_offset(base: me, bytes: bitcast[ByteSize, S64](offset))
    return r

### The address `offset` bytes back: `me -% offset`. It wraps around the start of the address space, and nothing
### checks bounds.
### :param offset: How far to move back.
### :returns: The moved address.
routine Addr.sub_wrap(offset: ByteSize) -> Me
    back: U64 = 0 -% offset.bytes()
    r: Me = addr_offset(base: me, bytes: bitcast[U64, S64](back))
    return r

### The distance in bytes from `other` to `me`: `me -% other`. With `other` past `me` it wraps around, so write the
### earlier address on the right.
### :param other: The address to measure from.
### :returns: The distance.
routine Addr.sub_wrap(other: Me) -> ByteSize
    a: U64 = ptrtoint[Me, U64](me)
    b: U64 = ptrtoint[Me, U64](other)
    return ByteSize.construct(bytes: a -% b)

# -- alignment -----------------------------------------------------------------

### The first address at or after `me` that is a multiple of `ALIGN` bytes: `a.align_up[16]()`.
### :typeparam ALIGN: The alignment in bytes, a power of two (any other is a build error).
### :returns: The aligned address, `me` itself when it is aligned already.
### :throws: Throws `IntegerOverflowError` when that address would be past the end of the address space.
routine Addr.align_up[ALIGN]() -> Me
needs U64 ALIGN
    if ALIGN == 0 or (ALIGN & (ALIGN -% 1)) != 0
        build_error("you gave align_up the alignment {ALIGN}, which is not a power of two: give it 1, 2, 4, 8, 16, ...")
    return me.align_up(by: ByteSize.construct(bytes: ALIGN))

### The last address at or before `me` that is a multiple of `ALIGN` bytes: `a.align_down[16]()`.
### :typeparam ALIGN: The alignment in bytes, a power of two (any other is a build error).
### :returns: The aligned address, `me` itself when it is aligned already.
routine Addr.align_down[ALIGN]() -> Me
needs U64 ALIGN
    if ALIGN == 0 or (ALIGN & (ALIGN -% 1)) != 0
        build_error("you gave align_down the alignment {ALIGN}, which is not a power of two: give it 1, 2, 4, 8, 16, ...")
    return me.align_down(by: ByteSize.construct(bytes: ALIGN))

### Whether `me` is a multiple of `ALIGN` bytes: `a.is_aligned[16]()`.
### :typeparam ALIGN: The alignment in bytes, a power of two (any other is a build error).
### :returns: `true` when the address is aligned.
routine Addr.is_aligned[ALIGN]() -> Bool
needs U64 ALIGN
    if ALIGN == 0 or (ALIGN & (ALIGN -% 1)) != 0
        build_error("you gave is_aligned the alignment {ALIGN}, which is not a power of two: give it 1, 2, 4, 8, 16, ...")
    return me.is_aligned(by: ByteSize.construct(bytes: ALIGN))

### The first address at or after `me` that is a multiple of `by`, for an alignment known only while the program runs.
### :param by: The alignment, a power of two.
### :returns: The aligned address, `me` itself when it is aligned already.
### :throws: Throws `UnacceptedValueError` when `by` is not a power of two, and `IntegerOverflowError` when the
###     address would be past the end of the address space.
routine Addr.align_up(by: ByteSize) -> Me
    mask: U64 = alignment_mask(by)
    a: U64 = ptrtoint[Me, U64](me)
    up: U64 = (a + mask) & mask.bitnot()
    r: Me = addr_offset(base: me, bytes: bitcast[U64, S64](up - a))
    return r

### The last address at or before `me` that is a multiple of `by`, for an alignment known only while the program runs.
### :param by: The alignment, a power of two.
### :returns: The aligned address, `me` itself when it is aligned already.
### :throws: Throws `UnacceptedValueError` when `by` is not a power of two.
routine Addr.align_down(by: ByteSize) -> Me
    mask: U64 = alignment_mask(by)
    a: U64 = ptrtoint[Me, U64](me)
    back: U64 = 0 -% (a & mask)
    r: Me = addr_offset(base: me, bytes: bitcast[U64, S64](back))
    return r

### Whether `me` is a multiple of `by`, for an alignment known only while the program runs.
### :param by: The alignment, a power of two.
### :returns: `true` when the address is aligned.
### :throws: Throws `UnacceptedValueError` when `by` is not a power of two.
routine Addr.is_aligned(by: ByteSize) -> Bool
    mask: U64 = alignment_mask(by)
    a: U64 = ptrtoint[Me, U64](me)
    return (a & mask) == 0

### The low bits an address of alignment `by` has clear: `by` less one.
### :param by: The alignment.
### :returns: The mask.
### :throws: Throws `UnacceptedValueError` when `by` is not a power of two.
secret routine alignment_mask(by: ByteSize) -> U64
    bytes: U64 = by.bytes()
    if not bytes.is_power_of_two()
        throw UnacceptedValueError(description: "An alignment is a power of two (1, 2, 4, 8, 16, ...), and this one isn't.")
    return bytes - 1

### The raw byte-offset arithmetic behind `+%` and `-%`: a `getelementptr i8` with no bounds checking.
### :param base: The starting address.
### :param bytes: The signed byte distance to move.
### :returns: The moved address.
@external("llvm")
@template("{result} = getelementptr i8, ptr {base}, i64 {bytes}")
secret routine addr_offset(base: Addr, bytes: S64) -> Addr

### The same address as a pointer to T.
### :returns: `me` typed as `@T`.
### :throws: Throws `UnacceptedValueError` when `me` is the zero address, which points at nothing. Where it may be
### zero, write `to[@T?]()` and take the result apart with `when`.
routine Addr.to[@T]() -> @T
needs AnyType T
    if me.is_hollow()
        throw UnacceptedValueError(description: "This address is zero, so it points at nothing: where it may be zero, turn it into a @T? with to[@T?]() and take it apart with when.")
    r: @T = bitcast[Me, @T](me)
    return r

### The same address as a pointer to T, or None when it is zero.
### :returns: `me` typed as `@T`, or None for the zero address.
routine Addr.to[@T?]() -> @T?
needs AnyType T
    if me.is_hollow()
        return None()
    r: @T = bitcast[Me, @T](me)
    return r
