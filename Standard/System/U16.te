# Tessera stdlib: U16 — 16-bit unsigned integer
#
# Maps to LLVM IR i16. Every S / U width shares the same method set.
#
# add / sub / mul / floordiv / mod / neg / abs / pow are failable: they throw
# IntegerOverflowError (or DivisionByZeroError) when the result doesn't fit,
# so a bare call stops there and `try a + b` gives None. A lossy to[T] throws
# IntegerOverflowError the same way (`try x.to[U8]()`). add / sub / mul / pow / neg / abs and
# the conversions have _wrap (modular) and _clamp (saturating) forms.

module System

### The powers of ten that fit in `U16`, 10^0 through 10^4, for {U16.ilog10}.
secret preset U16_POW10: Items[U16, 5] = [1, 10, 100, 1000, 10000]

### 16-bit unsigned integer, mapped to LLVM `i16`. Arithmetic throws `IntegerOverflowError` when the result does not fit (`try a + b` gives None), a lossy conversion throws it too (`try x.to[U8]()` gives None), the `_wrap` forms are modular, and the `_clamp` forms saturate.
@llvm("i16")
record U16
obeys Equatable[U16], Comparable[U16], Hashable[U16]
obeys Numeric[U16], Exponentiable[U16], WrappingArithmetic[U16], ClampingArithmetic[U16], Bitwiseable[U16], Invertible[U16], Shiftable[U16]
    nothing

# -- constants -------------------------------------------------------------------

### The smallest `U16` value, 0.
preset U16.MIN: U16 = 0
### The largest `U16` value, `65535`.
preset U16.MAX: U16 = 65535
### The width of `U16` in bits.
preset U16.BITS: U16 = 16

# -- bits ------------------------------------------------------------------------

### Counts the bits of `me` that are 1.
### :returns: The population count, between 0 and `BITS`.
routine U16.count_ones() -> Me
    r: Me = popcount[Me](me)
    return r

### Counts the consecutive 0 bits starting at the most significant bit.
### :returns: The count, which is `BITS` when `me` is 0.
routine U16.leading_zeros() -> Me
    r: Me = clz[Me](val: me, is_zero_undef: false)
    return r

### Counts the consecutive 0 bits starting at the least significant bit.
### :returns: The count, which is `BITS` when `me` is 0.
routine U16.trailing_zeros() -> Me
    r: Me = ctz[Me](val: me, is_zero_undef: false)
    return r

### Reverses the order of all bits, so the most significant bit becomes the least significant.
### :returns: The bit-reversed value.
routine U16.reverse_bits() -> Me
    r: Me = bitreverse[Me](me)
    return r

### Counts the bits of `me` that are 0.
### :returns: `BITS` minus the population count.
routine U16.count_zeros() -> Me
    inverted: Me = ~me
    r: Me = popcount[Me](inverted)
    return r

### Counts the consecutive 1 bits starting at the most significant bit.
### :returns: The count, which is `BITS` when `me` is `MAX`.
routine U16.leading_ones() -> Me
    inverted: Me = ~me
    r: Me = clz[Me](val: inverted, is_zero_undef: false)
    return r

### Counts the consecutive 1 bits starting at the least significant bit.
### :returns: The count, which is `BITS` when `me` is `MAX`.
routine U16.trailing_ones() -> Me
    inverted: Me = ~me
    r: Me = ctz[Me](val: inverted, is_zero_undef: false)
    return r

### Reverses the order of the bytes of `me`.
### :returns: The byte-swapped value.
routine U16.swap_bytes() -> Me
    r: Me = bswap[Me](me)
    return r

### Converts from this target's byte order to big-endian, which swaps the bytes.
### :returns: The value in big-endian byte order.
routine U16.to_be() -> Me
    r: Me = me.swap_bytes()
    return r

### Converts from big-endian to this target's byte order, which swaps the bytes.
### :returns: The value in native byte order.
routine U16.from_be() -> Me
    r: Me = me.swap_bytes()
    return r

### Converts from this target's byte order to little-endian. The target is little-endian, so this returns `me` unchanged.
### :returns: The value in little-endian byte order.
routine U16.to_le() -> Me
    return me

### Converts from little-endian to this target's byte order. The target is little-endian, so this returns `me` unchanged.
### :returns: The value in native byte order.
routine U16.from_le() -> Me
    return me

### Tests whether exactly one bit of `me` is set.
### :returns: True when `me` is a power of two.
routine U16.is_power_of_two() -> Bool
    ones: Me = popcount[Me](me)
    return ones == 1

### Bitwise AND of `me` and `other`.
### :param other: The right-hand operand.
### :returns: A value with each bit set only when it is set in both operands.
routine U16.bitand(other: Me) -> Me
    r: Me = band[Me](me, other)
    return r

### Bitwise OR of `me` and `other`.
### :param other: The right-hand operand.
### :returns: A value with each bit set when it is set in either operand.
routine U16.bitor(other: Me) -> Me
    r: Me = bor[Me](me, other)
    return r

### Bitwise XOR of `me` and `other`.
### :param other: The right-hand operand.
### :returns: A value with each bit set when it is set in exactly one operand.
routine U16.bitxor(other: Me) -> Me
    r: Me = bxor[Me](me, other)
    return r

### Bitwise NOT: flips every bit of `me`.
### :returns: The complement, which equals `MAX - me`.
routine U16.bitnot() -> Me
    r: Me = bnot[Me](me)
    return r

# -- shifts ----------------------------------------------------------------------

### Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0.
### :param n: The shift amount in bits.
### :returns: `me` shifted left by `n`, or 0 when `n` is `BITS` or more.
### :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine U16.shift_left(n: Me) -> Me
    in_range: Bool = n < Me.BITS
    shifted: Me = shl[Me](val: me, amt: n)
    r: Me = when
        in_range => shifted
        else => 0
    return r

### Shift right, logical: 0 bits fill in. A shift by `BITS` or more gives 0.
### :param n: The shift amount in bits.
### :returns: `me` shifted right by `n`, or 0 when `n` is `BITS` or more.
routine U16.arith_shift_right(n: Me) -> Me
    in_range: Bool = n < Me.BITS
    shifted: Me = lshr[Me](val: me, amt: n)
    out: Me = 0
    r: Me = when
        in_range => shifted
        else => out
    return r

### Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
### :param n: The rotate amount in bits.
### :returns: The rotated value.
routine U16.rotl(n: Me) -> Me
    r: Me = fshl[Me](hi: me, lo: me, amt: n)
    return r

### Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
### :param n: The rotate amount in bits.
### :returns: The rotated value.
routine U16.rotr(n: Me) -> Me
    r: Me = fshr[Me](hi: me, lo: me, amt: n)
    return r

### Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out.
### :param n: The shift amount in bits, taken modulo `BITS`.
### :returns: `me` shifted left, with 0 bits filling in.
routine U16.shift_left_wrap(n: Me) -> Me
    amount: Me = band[Me](n, 15)
    r: Me = shl[Me](val: me, amt: amount)
    return r

### Logical shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
### :param n: The shift amount in bits, taken modulo `BITS`.
### :returns: `me` shifted right with 0 bits filling in.
routine U16.arith_shift_right_wrap(n: Me) -> Me
    amount: Me = band[Me](n, 15)
    r: Me = lshr[Me](val: me, amt: amount)
    return r

# -- arithmetic ------------------------------------------------------------------

### The sum of `me` and `other`.
### :param other: The value to add.
### :returns: The sum.
### :throws: Throws `IntegerOverflowError` when the sum does not fit in `U16`.
failable routine U16.add(other: Me) -> Me
    if uadd_overflows[Me](me, other)
        throw IntegerOverflowError()
    r: Me = add[Me](a: me, b: other)
    return r

### The sum of `me` and `other`, wrapped modulo 2^16.
### :param other: The value to add.
### :returns: The low 16 bits of the exact sum.
routine U16.add_wrap(other: Me) -> Me
    r: Me = add[Me](a: me, b: other)
    return r

### The sum of `me` and `other`, saturated at `MAX`.
### :param other: The value to add.
### :returns: The sum, or `MAX` when the exact sum is above the range.
routine U16.add_clamp(other: Me) -> Me
    r: Me = uadd_sat[Me](me, other)
    return r

### The difference of `me` and `other`.
### :param other: The value to subtract.
### :returns: The difference.
### :throws: Throws `IntegerOverflowError` when the difference does not fit in `U16`.
failable routine U16.sub(other: Me) -> Me
    if usub_overflows[Me](me, other)
        throw IntegerOverflowError()
    r: Me = sub[Me](me, other)
    return r

### The difference of `me` and `other`, wrapped modulo 2^16.
### :param other: The value to subtract.
### :returns: The low 16 bits of the exact difference.
routine U16.sub_wrap(other: Me) -> Me
    r: Me = sub[Me](me, other)
    return r

### The difference of `me` and `other`, saturated at 0.
### :param other: The value to subtract.
### :returns: The difference, or 0 when the exact difference is below 0.
routine U16.sub_clamp(other: Me) -> Me
    r: Me = usub_sat[Me](me, other)
    return r

### The product of `me` and `other`.
### :param other: The factor to multiply by.
### :returns: The product.
### :throws: Throws `IntegerOverflowError` when the product does not fit in `U16`.
failable routine U16.mul(other: Me) -> Me
    if umul_overflows[Me](me, other)
        throw IntegerOverflowError()
    r: Me = mul[Me](me, other)
    return r

### The product of `me` and `other`, wrapped modulo 2^16.
### :param other: The factor to multiply by.
### :returns: The low 16 bits of the exact product.
routine U16.mul_wrap(other: Me) -> Me
    r: Me = mul[Me](me, other)
    return r

### The product of `me` and `other`, saturated at `MAX`.
### :param other: The factor to multiply by.
### :returns: The product, or `MAX` when the exact product is above the range.
routine U16.mul_clamp(other: Me) -> Me
    overflow: Bool = me.mul_overflows(other)
    product: Me = mul[Me](me, other)
    r: Me = when
        overflow => Me.MAX
        else => product
    return r

### Tests whether the exact product of `me` and `other` is outside `MIN ..= MAX`.
### :param other: The factor to multiply by.
### :returns: True when the product does not fit in `U16`.
routine U16.mul_overflows(other: Me) -> Bool
    return umul_overflows[Me](me, other)

### The exact product of `me` and `other` in twice the width. It never overflows.
### :param other: The factor to multiply by.
### :returns: The product as a `U32`.
routine U16.mul_wide(other: Me) -> U32
    r: U32 = me.to[U32]() *% other.to[U32]()
    return r

# -- division --------------------------------------------------------------------

### The quotient of `me` divided by `other`, truncated toward zero.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine U16.div_trunc(other: Me) -> Me
    if other == 0
        throw DivisionByZeroError()
    r: Me = udiv[Me](me, other)
    return r

### The remainder of `me` divided by `other`.
### :param other: The divisor.
### :returns: The remainder, between 0 and `other - 1`.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine U16.mod_trunc(other: Me) -> Me
    if other == 0
        throw DivisionByZeroError()
    r: Me = urem[Me](me, other)
    return r

### The quotient of Euclidean division: for an unsigned integer, the plain quotient (the remainder is never negative).
### :param other: The divisor.
### :returns: The quotient.
### :throws: Throws `DivisionByZeroError` when `other` is 0.
failable routine U16.floordiv(other: Me) -> Me
    if other == 0
        throw DivisionByZeroError()
    return me.div_trunc(other)

### The remainder of Euclidean division: for an unsigned integer, the plain remainder.
### :param other: The divisor.
### :returns: The remainder, between 0 and `other - 1`.
### :throws: Throws `DivisionByZeroError` when `other` is 0.
failable routine U16.mod(other: Me) -> Me
    if other == 0
        throw DivisionByZeroError()
    return me.mod_trunc(other)

### The quotient of `me` divided by `other`, rounded up.
### :param other: The divisor.
### :returns: The quotient, rounded up.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine U16.div_ceil(other: Me) -> Me
    q: Me = me // other
    rem: Me = urem[Me](me, other)
    if rem == 0
        return q
    r: Me = add[Me](a: q, b: 1)
    return r

### The smallest multiple of `other` that is at least `me`.
### :param other: The value whose multiple to round up to.
### :returns: `me` when it is already a multiple of `other`, else the next multiple above it.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when the multiple does not fit in `U16`.
@track_caller
routine U16.next_multiple_of(other: Me) -> Me
    rem: Me = me % other
    if rem == 0
        return me
    gap: Me = sub[Me](other, rem)
    r: Me = me + gap
    return r

### The smallest power of two that is at least `me`. Both 0 and 1 give 1.
### :returns: The power of two.
### :throws: Throws `IntegerOverflowError` when the power of two does not fit in `U16`.
failable routine U16.next_power_of_two() -> Me
    if me <= 1
        return 1
    # A shift by the full width would be poison, so check the amount first.
    below: Me = sub[Me](me, 1)
    lz: Me = clz[Me](val: below, is_zero_undef: true)
    shift: Me = sub[Me](Me.BITS, lz)
    if not (shift < Me.BITS)
        throw IntegerOverflowError()
    power: Me = shl[Me](val: 1, amt: shift)
    return power

# -- powers ----------------------------------------------------------------------

### Raises `me` to the power `exponent`.
### :param exponent: The power to raise to.
### :returns: `me` to the power `exponent`.
### :throws: Throws `IntegerOverflowError` when the exact power does not fit in `U16`.
failable routine U16.pow(exponent: Me) -> Me
    base: &Me <- me
    acc: &Me <- 1
    overflow: &Bool <- false

    until exponent_left == 0 with exponent_left: Me = exponent
        # The accumulator only multiplies on odd bits, and the base only needs
        # squaring while bits remain, so only those overflows count.
        odd: Bool = exponent_left & 1 != 0
        acc_overflow: Bool = umul_overflows[Me](acc.load(), base.load()) and odd
        with_base: Me = mul[Me](acc.load(), base.load())
        next_acc: Me = when
            odd => with_base
            else => acc.load()
        rest: Me = exponent_left >> 1
        more: Bool = rest != 0
        base_overflow: Bool = umul_overflows[Me](base.load(), base.load()) and more
        any: Bool = overflow.load() or acc_overflow or base_overflow
        next_overflow: Bool = any
        next_acc2: Me = next_acc
        next_base: Me = mul[Me](base.load(), base.load())
        next_base.poke_into(base)
        next_acc2.poke_into(acc)
        next_overflow.poke_into(overflow)
        continue with exponent_left: rest
    fits: Bool = not overflow.load()
    if not fits
        throw IntegerOverflowError()
    return acc.load()

### Raises `me` to the power `exponent` by squaring, wrapping modulo 2^16.
### :param exponent: The power to raise to.
### :returns: The low 16 bits of the exact power.
routine U16.pow_wrap(exponent: Me) -> Me
    base: &Me <- me
    acc: &Me <- 1

    until exponent_left == 0 with exponent_left: Me = exponent
        odd: Bool = exponent_left & 1 != 0
        with_base: Me = mul[Me](acc.load(), base.load())
        next_acc: Me = when
            odd => with_base
            else => acc.load()
        next_acc2: Me = next_acc
        next_base: Me = mul[Me](base.load(), base.load())
        next_base.poke_into(base)
        next_acc2.poke_into(acc)
        continue with exponent_left: exponent_left >> 1
    then
        return acc.load()

### Raises `me` to the power `exponent`, saturated at `MAX`.
### :param exponent: The power to raise to.
### :returns: The power, or `MAX` when the exact power does not fit.
routine U16.pow_clamp(exponent: Me) -> Me
    checked: Optional[Me] = try me.pow(exponent)
    r: Me = checked.unwrap_or(Me.MAX)
    return r

# -- equality and ordering -------------------------------------------------------

### Tests whether `me` and `other` are equal.
### :param other: The value to compare with.
### :returns: True when the values are equal.
routine U16.eq(other: Me) -> Bool
    return ieq[Me](me, other)

### Tests whether `me` and `other` differ.
### :param other: The value to compare with.
### :returns: True when the values are not equal.
routine U16.ne(other: Me) -> Bool
    return ine[Me](me, other)

### Unsigned less-than comparison.
### :param other: The value to compare with.
### :returns: True when `me < other`.
@external("llvm")
@template("{result} = icmp ult i16 {me}, {other}")
routine U16.lt(other: Me) -> Bool

### Unsigned less-than-or-equal comparison.
### :param other: The value to compare with.
### :returns: True when `me <= other`.
@external("llvm")
@template("{result} = icmp ule i16 {me}, {other}")
routine U16.le(other: Me) -> Bool

### Unsigned greater-than comparison.
### :param other: The value to compare with.
### :returns: True when `me > other`.
@external("llvm")
@template("{result} = icmp ugt i16 {me}, {other}")
routine U16.gt(other: Me) -> Bool

### Unsigned greater-than-or-equal comparison.
### :param other: The value to compare with.
### :returns: True when `me >= other`.
@external("llvm")
@template("{result} = icmp uge i16 {me}, {other}")
routine U16.ge(other: Me) -> Bool

### Compares `me` with `other` by unsigned order.
### :param other: The value to compare with.
### :returns: -1 when `me < other`, 0 when they are equal, and 1 when `me > other`.
routine U16.compare(other: Me) -> S32
    if me < other
        return -1
    if me > other
        return 1
    return 0

### Returns the smaller of two values by unsigned comparison.
### :param other: The value to compare with.
### :returns: `me` or `other`, whichever is smaller.
routine U16.min(other: Me) -> Me
    r: Me = umin[Me](me, other)
    return r

### Returns the larger of two values by unsigned comparison.
### :param other: The value to compare with.
### :returns: `me` or `other`, whichever is larger.
routine U16.max(other: Me) -> Me
    r: Me = umax[Me](me, other)
    return r

### Limits `me` to the range from `lo` to `hi`, both ends included.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
### :throws: Crashes with `UnacceptedValueError` when `lo > hi`.
@track_caller
routine U16.clamp(lo: Me, hi: Me) -> Me
    if lo <= hi
        at_least_lo: Me = umax[Me](me, lo)
        r: Me = umin[Me](at_least_lo, hi)
        return r
    throw UnacceptedValueError(description: "The value is not one the routine accepts.")

# -- hash ------------------------------------------------------------------------

### SipHash-2-4 of the bits widened to 64, under the process key, the same hash for `S16` and `U16`.
### :returns: The 64-bit hash of `me`.
routine U16.hash() -> U64
    bits: Me = bitcast[Me, Me](me)
    h: U64 = siphash24(value: bits.to[U64](), key: hash_key())
    return h

# -- differences, midpoints, logarithms, roots -----------------------------------

### The distance between `me` and `other`, `|me - other|`, which always fits in `U16`.
### :param other: The value to measure from.
### :returns: `|me - other|` as a `U16`.
routine U16.abs_diff(other: Me) -> Me
    hi: Me = umax[Me](me, other)
    lo: Me = umin[Me](me, other)
    diff: Me = sub[Me](hi, lo)
    r: Me = bitcast[Me, Me](diff)
    return r

### The average of `me` and `other`, rounded down, computed without overflow.
### :param other: The other value.
### :returns: `(me + other) / 2`, rounded down.
routine U16.midpoint(other: Me) -> Me
    common: Me = me & other
    half_diff: Me = (me ^ other) >> 1
    r: Me = add[Me](a: common, b: half_diff)
    return r

### The base-2 logarithm of `me`, rounded down.
### :returns: `floor(log2(me))`.
### :throws: Crashes with `NumericDomainError` when `me` is 0.
@track_caller
routine U16.ilog2() -> Me
    if me == 0
        throw NumericDomainError()
    lz: Me = clz[Me](val: me, is_zero_undef: true)
    r: Me = sub[Me](Me.BITS - 1, lz)
    return r

### The base-10 logarithm of `me`, rounded down. It estimates the answer from the bit length of `me` and corrects the
### estimate with one compare against {U16_POW10}, with no division and no loop.
### :returns: `floor(log10(me))`.
### :throws: Crashes with `NumericDomainError` when `me` is 0.
@track_caller
routine U16.ilog10() -> Me
    if me == 0
        throw NumericDomainError()
    # me has bits significant bits, so 2^(bits - 1) <= me < 2^bits. guess = floor(bits * 1233 / 4096), where
    # 1233 / 4096 = 0.3010254 is just under log10(2) = 0.3010300, so guess <= bits * log10(2), and with
    # log10(2) < 1 that gives 10^(guess - 1) <= 2^(bits - 1) <= me. Going through every bits from 1 to 256 (the
    # widest type), bits * log10(2) - guess is at most 0.9958, so me < 2^bits < 10^(guess + 1). floor(log10(me))
    # is therefore guess when me >= 10^guess and guess - 1 otherwise, which never goes below 0 since
    # me >= 1 = 10^0. guess is at most 4 here, the table's last index.
    bits: U64 = (Me.BITS - clz[Me](val: me, is_zero_undef: true)).to[U64]()
    guess: U64 = bits *% 1233 >> 12
    below: Bool = me < U16_POW10.getitem(guess)
    r: Me = (guess - below.to[U64]()).to_wrap[Me]()
    return r

### The integer square root of `me`, rounded down.
### :returns: `floor(sqrt(me))`.
routine U16.isqrt() -> Me
    # Start from the highest power of four that is <= me.
    until bit <= me with bit: Me = shl[Me](val: 1, amt: Me.BITS - 2)
        continue with bit: bit >> 2
    then
        until bit2 == 0 with rest: Me = me, root: Me = 0, bit2: Me = bit
            trial: Me = add[Me](a: root, b: bit2)
            fits: Bool = rest >= trial
            half_root: Me = root >> 1
            next_bit: Me = bit2 >> 2
            if fits
                continue with rest: sub[Me](rest,
                    trial), root: add[Me](a: half_root, b: bit2), bit2: next_bit
            continue with rest: rest, root: half_root, bit2: next_bit
        then
            return root

# -- conversions -----------------------------------------------------------------

### to[T] returns the same value in another integer type. A conversion that
### can't lose the value returns it directly. One that can is failable: it throws
### IntegerOverflowError when the value doesn't fit (try gives None), and has
### to_wrap[T] (keep the low bits) and to_clamp[T] (saturate) forms.
### Converts `me` to `S8`.
### :returns: The same numeric value as an `S8`.
### :throws: Throws `IntegerOverflowError` when the value does not fit in `S8`.
failable routine U16.to[S8]() -> S8
    if not (me <= 127)
        throw IntegerOverflowError()
    r: S8 = trunc[Me, S8](me)
    return r

### Converts `me` to `S8`, keeping the low 8 bits (modulo 2^8).
### :returns: `me` modulo 2^8, as an `S8`.
routine U16.to_wrap[S8]() -> S8
    r: S8 = trunc[Me, S8](me)
    return r

### Converts `me` to `S8`, saturating at the ends of `S8`'s range.
### :returns: `me` clamped to `S8.MIN ..= S8.MAX`.
routine U16.to_clamp[S8]() -> S8
    at_most: Me = umin[Me](me, 127)
    r: S8 = trunc[Me, S8](at_most)
    return r

### Converts `me` to `S16`.
### :returns: The same numeric value as an `S16`.
### :throws: Throws `IntegerOverflowError` when the value does not fit in `S16`.
failable routine U16.to[S16]() -> S16
    if not (me <= 32767)
        throw IntegerOverflowError()
    r: S16 = bitcast[Me, S16](me)
    return r

### Converts `me` to `S16`, keeping the low 16 bits (modulo 2^16).
### :returns: `me` modulo 2^16, as an `S16`.
routine U16.to_wrap[S16]() -> S16
    r: S16 = bitcast[Me, S16](me)
    return r

### Converts `me` to `S16`, saturating at the ends of `S16`'s range.
### :returns: `me` clamped to `S16.MIN ..= S16.MAX`.
routine U16.to_clamp[S16]() -> S16
    at_most: Me = umin[Me](me, 32767)
    r: S16 = bitcast[Me, S16](at_most)
    return r

### Converts `me` to `S32`. Every `U16` value fits in `S32`, so the conversion never fails.
### :returns: The same numeric value as an `S32`.
routine U16.to[S32]() -> S32
    r: S32 = zext[Me, S32](me)
    return r

### Converts `me` to `S64`. Every `U16` value fits in `S64`, so the conversion never fails.
### :returns: The same numeric value as an `S64`.
routine U16.to[S64]() -> S64
    r: S64 = zext[Me, S64](me)
    return r

### Converts `me` to `S128`. Every `U16` value fits in `S128`, so the conversion never fails.
### :returns: The same numeric value as an `S128`.
routine U16.to[S128]() -> S128
    r: S128 = zext[Me, S128](me)
    return r

### Converts `me` to `S256`. Every `U16` value fits in `S256`, so the conversion never fails.
### :returns: The same numeric value as an `S256`.
routine U16.to[S256]() -> S256
    r: S256 = zext[Me, S256](me)
    return r

### Converts `me` to `U8`.
### :returns: The same numeric value as a `U8`.
### :throws: Throws `IntegerOverflowError` when the value does not fit in `U8`.
failable routine U16.to[U8]() -> U8
    if not (me <= 255)
        throw IntegerOverflowError()
    r: U8 = trunc[Me, U8](me)
    return r

### Converts `me` to `U8`, keeping the low 8 bits (modulo 2^8).
### :returns: `me` modulo 2^8, as a `U8`.
routine U16.to_wrap[U8]() -> U8
    r: U8 = trunc[Me, U8](me)
    return r

### Converts `me` to `U8`, saturating at the ends of `U8`'s range.
### :returns: `me` clamped to `U8.MIN ..= U8.MAX`.
routine U16.to_clamp[U8]() -> U8
    at_most: Me = umin[Me](me, 255)
    r: U8 = trunc[Me, U8](at_most)
    return r

### The identity conversion: returns `me` unchanged.
### :returns: `me` as `U16`.
routine U16.to[Me]() -> Me
    return me

### Converts `me` to `U32`. Every `U16` value fits in `U32`, so the conversion never fails.
### :returns: The same numeric value as a `U32`.
routine U16.to[U32]() -> U32
    r: U32 = zext[Me, U32](me)
    return r

### Converts `me` to `U64`. Every `U16` value fits in `U64`, so the conversion never fails.
### :returns: The same numeric value as a `U64`.
routine U16.to[U64]() -> U64
    r: U64 = zext[Me, U64](me)
    return r

### Converts `me` to `U128`. Every `U16` value fits in `U128`, so the conversion never fails.
### :returns: The same numeric value as a `U128`.
routine U16.to[U128]() -> U128
    r: U128 = zext[Me, U128](me)
    return r

### Converts `me` to `U256`. Every `U16` value fits in `U256`, so the conversion never fails.
### :returns: The same numeric value as a `U256`.
routine U16.to[U256]() -> U256
    r: U256 = zext[Me, U256](me)
    return r

### Converts `me` to `B32`, rounding to nearest, ties to even.
### :returns: The `B32` nearest to `me`.
routine U16.to[B32]() -> B32
    r: B32 = uitofp[Me, B32](me)
    return r

### Converts `me` to `B64`, rounding to nearest, ties to even.
### :returns: The `B64` nearest to `me`.
routine U16.to[B64]() -> B64
    r: B64 = uitofp[Me, B64](me)
    return r
