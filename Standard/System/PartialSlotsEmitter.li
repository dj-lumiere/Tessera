# Lapila stdlib collection: PartialSlotsEmitter[T, COUNT]
#
# Forward emitter over the elements held by a PartialSlots[T, COUNT] behind a pointer. The count held is stored in the
# record at construction.
#
# Satisfies concept SlotEmitter[PartialSlotsEmitter[T, COUNT], T] (and so Emitter).

module System

### A forward emitter over the elements a {PartialSlots[T, COUNT]} holds, behind a pointer. The count held is stored once at construction, and the Slots must outlive the emitter and keep its shape while the emitter walks.
### :typeparam T: The element type.
### :typeparam COUNT: The most elements the walked value holds.
record PartialSlotsEmitter[T, COUNT]
obeys SlotEmitter[PartialSlotsEmitter[T, COUNT], T]
needs U64 COUNT
    data: @T  # the first place of the original @PartialSlots[T, COUNT]
    index: U64
    count: U64  # = the elements held when the emitter was made

### An emitter over the elements held, at the first: `e: &PartialSlotsEmitter[T, COUNT] <- xs.emitter()`, then `for x in e`.
### :returns: A new {PartialSlotsEmitter[T, COUNT]} over `me`.
routine @PartialSlots[T, COUNT].emitter() -> PartialSlotsEmitter[T, COUNT]
needs U64 COUNT
    data: @T = bitcast[@Me, @T](me)
    emitter: PartialSlotsEmitter[T, COUNT] = PartialSlotsEmitter[T, COUNT](data: data, index: 0,
        count: me.used.peek())
    return emitter

### Yields the next element held and advances the emitter.
### :returns: The next element, in index order.
### :throws: Throws `AbsentValueError` after the last element held has been yielded.
routine @PartialSlotsEmitter[T, COUNT].emit() -> T
needs U64 COUNT
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    data: @T = me.data.peek()
    value: T = data.stride(index).peek()
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the emitter.
### :returns: The address of the next element, in index order.
### :throws: Throws `AbsentValueError` after the last element held has been handed out.
routine @PartialSlotsEmitter[T, COUNT].next() -> @T
needs U64 COUNT
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = me.data.peek().stride(index)
    return element
