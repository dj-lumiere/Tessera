# Tessera stdlib: the hosted memory managers' tables
#
# On a target with an operating system the standard library comes with three tables, each ready before start runs:
# HEAP (the default heap: the checked heap with the heap check on, else the C library's heap), C_HEAP (HeapManagerByC,
# plain malloc, realloc, and free in every build), and PAGES (PageManagerByOs, the operating system's pages). Each is the
# table `m.to[MemoryManager]()` makes for an instance of its manager, written out here because a global's first value
# is in the program image. The managers live in Heap.te and Pages.te. On a target without one none
# of this is there.

module System/Memory

### The C library's heap that `C_HEAP`, and `HEAP` with the heap check off, hand out from.
@target(os: not "none")
secret global C_HEAP_MANAGER: &HeapManagerByC

### The checked heap that `HEAP` hands out from with the heap check on.
@target(os: not "none")
secret global CHECKED_HEAP_MANAGER: &HeapManagerByCheckedHeap

### The C library's aligned heap that `HEAP` hands out from on Windows with the heap check off.
@target(os: "windows")
secret global C_ALIGNED_HEAP_MANAGER: &HeapManagerByCAligned

### The operating system's pages that `PAGES` hands out.
@target(os: not "none")
secret global OS_PAGE_MANAGER: &PageManagerByOs

### The hosted default heap, ready before `start` runs: the C library's heap with the heap check off. It can be passed
### wherever an `@MemoryManager` goes (`List[S64].construct(HEAP)`). It holds no state, so threads share it.
@target(os: ("linux", "macos"))
@heap_check("off")
global HEAP: &MemoryManager <- (borrow_fn: forward_borrow[HeapManagerByC].to[Callable](), reborrow_fn: forward_reborrow[HeapManagerByC].to[Callable](), give_back_fn: forward_give_back[HeapManagerByC].to[Callable](), reserve_fn: .hollow(), commit_fn: .hollow(), release_fn: .hollow(), protect_fn: .hollow(), state: C_HEAP_MANAGER)
### The hosted default heap on Windows with the heap check off: the C library's heap through `_aligned_malloc`, so
### every alignment is there.
@target(os: "windows")
@heap_check("off")
global HEAP: &MemoryManager <- (borrow_fn: forward_borrow[HeapManagerByCAligned].to[Callable](), reborrow_fn: forward_reborrow[HeapManagerByCAligned].to[Callable](), give_back_fn: forward_give_back[HeapManagerByCAligned].to[Callable](), reserve_fn: .hollow(), commit_fn: .hollow(), release_fn: .hollow(), protect_fn: .hollow(), state: C_ALIGNED_HEAP_MANAGER)
### The hosted default heap with the heap check on: the checked heap, which crashes on a block freed twice.
@target(os: not "none")
@heap_check("on")
global HEAP: &MemoryManager <- (borrow_fn: forward_borrow[HeapManagerByCheckedHeap].to[Callable](), reborrow_fn: forward_reborrow[HeapManagerByCheckedHeap].to[Callable](), give_back_fn: forward_give_back[HeapManagerByCheckedHeap].to[Callable](), reserve_fn: .hollow(), commit_fn: .hollow(), release_fn: .hollow(), protect_fn: .hollow(), state: CHECKED_HEAP_MANAGER)

### The C library's malloc, realloc, and free in every build, with nothing in front of the blocks: for memory that C
### code frees or reallocates, or that comes from C's malloc and is freed here. An alignment past malloc's own comes
### from posix_memalign (still freed with free), and on Windows, whose free can't take such a block, it crashes.
@target(os: not "none")
global C_HEAP: &MemoryManager <- (borrow_fn: forward_borrow[HeapManagerByC].to[Callable](), reborrow_fn: forward_reborrow[HeapManagerByC].to[Callable](), give_back_fn: forward_give_back[HeapManagerByC].to[Callable](), reserve_fn: .hollow(), commit_fn: .hollow(), release_fn: .hollow(), protect_fn: .hollow(), state: C_HEAP_MANAGER)

### The operating system's pages, ready before `start` runs: `reserve`, `commit`, `release`, and `protect`, and `borrow`
### of whole committed pages. Fibers' stacks come from it.
@target(os: not "none")
global PAGES: &MemoryManager <- (borrow_fn: forward_borrow[PageManagerByOs].to[Callable](), reborrow_fn: forward_reborrow[PageManagerByOs].to[Callable](), give_back_fn: forward_give_back[PageManagerByOs].to[Callable](), reserve_fn: forward_reserve[PageManagerByOs].to[Callable](), commit_fn: forward_commit[PageManagerByOs].to[Callable](), release_fn: forward_release[PageManagerByOs].to[Callable](), protect_fn: forward_protect[PageManagerByOs].to[Callable](), state: OS_PAGE_MANAGER)
