# Tessera stdlib: Stamped and the PoolManager, links to an entity that see when it has ended
#
# `node.stamp()` on an entity gives a `Stamped[Node]`, 8 bytes: a slot in the PoolManager's table and the slot's
# generation. The entity stays where it is and keeps its slot in a hidden U32 the builder adds to its type (only to the
# entity types the program stamps). The slot holds the entity's address while it lives. When the entity ends (`drop`,
# the builder's give back of a STACK place, the old value of `y <- v`, the walk of the entity that held it) or moves to
# another address (`steal` out of a place of its own, `return` of a STACK place, a collection that reallocates), the
# slot's generation goes up and its address is cleared, so every stamp of it fails. `fetch()` gives the entity's `@T`,
# or throws `StaleStampError` when the generations differ. A stamp doesn't keep the entity alive and copies for free.
# `steal node as other` of a place from a manager keeps the memory, so it keeps the slot.
#
# The table is chunks of 4,096 entries of 16 bytes (64 KiB) that never move, and a directory of the chunks'
# addresses that doubles when it is full. The directory it replaces stays until the program ends, so a fetch reading
# it on another thread is never left with memory given back. A fetch reads the directory, the chunk and the entry with
# no lock. Taking and ending slots take a short lock. Slot 0 is never used, so an all-zero stamp is always stale. A
# slot whose generation reaches U32.MAX is retired, never used again.

module System/Memory

### A link to an entity that doesn't keep it alive: the entity's slot in the PoolManager's table and the slot's
### generation when the stamp was taken. Made with `stamp()` on the entity, read with `fetch()`. Copied for free.
### :typeparam T: The entity's type.
record Stamped[T]
obeys Equatable[Stamped[T]]
    ### The entity's slot in the table.
    slot: U32
    ### The slot's generation when the stamp was taken.
    generation: U32

### A stamp whose entity has ended or moved: its slot has a newer generation now.
crashable StaleStampError
    nothing

### Writes `The entity this stamp was taken of has ended, or moved to another place.`
### :typeparam TWriter: The Writer's type.
### :param out: Where it goes.
routine StaleStampError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The entity this stamp was taken of has ended, or moved to another place.")
    return

### The table of the program's stamps, one per program. Its routines are called on the type, and its state is its own
### globals. With an operating system its chunks come from HEAP unless `set_up` names another manager. Without one,
### `set_up` comes first.
record PoolManager
    nothing

### One entry of the table: 16 bytes.
secret record PoolEntry
    ### The entity's address while it lives, zero after it ends.
    at: Addr
    ### Goes up each time the entity in the slot ends.
    generation: U32
    ### The next free slot after this one, while this one is free.
    next_free: U32

### How many entries a chunk holds.
secret preset POOL_CHUNK_SLOTS: U64 = 4096

### The address of the directory: one Addr per chunk.
secret global POOL_DIRECTORY: &Addr
### How many chunk addresses the directory has room for.
secret global POOL_DIRECTORY_ROOM: &U64
### How many chunks there are.
secret global POOL_CHUNKS: &U64
### The slot after the last one ever taken, 0 before the first.
secret global POOL_NEXT: &U32
### The first free slot, 0 for none.
secret global POOL_FREE: &U32
### 1 while a flow takes or ends a slot.
secret global POOL_LOCK: &U32
### Where the chunks come from, None for the default.
secret global POOL_MEMORY: &(@MemoryManager?)

### Names the manager the table's chunks come from. Without an operating system a program calls it before its first
### `stamp()`. Chunks already taken stay where they are.
### :param memory: The memory manager.
common routine PoolManager.set_up(memory: @MemoryManager) -> None
    lock_pool()
    POOL_MEMORY.poke(memory)
    unlock_pool()
    return

### The manager the chunks come from: the one `set_up` named, else HEAP.
### :returns: The manager.
@target(os: not "none")
secret routine pool_memory() -> @MemoryManager
    when POOL_MEMORY.peek()
        is @MemoryManager as memory => return memory
        is None => return HEAP

### The manager the chunks come from: the one `set_up` named.
### :returns: The manager.
### :throws: Crashes with `UnacceptedValueError` when `set_up` wasn't called.
@target(os: "none")
secret routine pool_memory() -> @MemoryManager
    when POOL_MEMORY.peek()
        is @MemoryManager as memory => return memory
        is None =>
            throw UnacceptedValueError(description: "a stamp needs the PoolManager's memory, and nothing set it up: call PoolManager.set_up(memory: m) before the first stamp()")

### Takes the table's lock.
secret routine lock_pool() -> None
    loop
        if POOL_LOCK.swap_unbroken(1) == 0
            return

### Gives the table's lock back.
secret routine unlock_pool() -> None
    POOL_LOCK.poke_unbroken(0)
    return

### The entry of a slot that was taken once: the chunk from the directory, then the entry in it. No lock.
### :param slot: The slot, not 0.
### :returns: The entry.
@inline
secret routine pool_entry(slot: U32) -> @PoolEntry
    directory: @Addr = POOL_DIRECTORY.peek_unbroken[ACQUIRE]().to[@Addr]()
    chunk: Addr = directory.stride((slot >> 12).to[U64]()).peek_unbroken[ACQUIRE]()
    return chunk.to[@PoolEntry]().stride((slot & 4095).to[U64]())

### Adds a chunk, and a directory twice the size when the directory is full. The directory it replaces stays. Called
### with the lock held.
### :throws: Crashes with `OutOfMemoryError` when the manager has no memory.
secret routine add_pool_chunk() -> None
    memory: @MemoryManager = pool_memory()
    chunks: U64 = POOL_CHUNKS.peek()
    room: U64 = POOL_DIRECTORY_ROOM.peek()
    if chunks == room
        grown: U64 = when
            room == 0 => 4
            else => room * 2
        fresh: Addr = allocate[Addr](count: grown, manager: memory)
        if fresh.is_hollow()
            throw OutOfMemoryError()
        if chunks > 0
            fresh.to[@Addr]().copy(src: POOL_DIRECTORY.peek().to[@Addr](), count: chunks)
        POOL_DIRECTORY.poke_unbroken(fresh)
        POOL_DIRECTORY_ROOM.poke(grown)
    chunk: Addr = allocate[PoolEntry](count: POOL_CHUNK_SLOTS, manager: memory)
    if chunk.is_hollow()
        throw OutOfMemoryError()
    chunk.to[@PoolEntry]().zeroinit(POOL_CHUNK_SLOTS)
    directory: @Addr = POOL_DIRECTORY.peek().to[@Addr]()
    directory.stride(chunks).poke_unbroken(chunk)
    POOL_CHUNKS.poke(chunks + 1)
    return

### Takes a slot for the entity at `at`: a free one, else the next one never used.
### :param at: The entity's address.
### :returns: The slot.
### :throws: Crashes with `OutOfMemoryError` when there is no memory for a chunk, or every slot is taken.
secret common routine PoolManager.take(at: Addr) -> U32
    lock_pool()
    free: U32 = POOL_FREE.peek()
    if free != 0
        entry: @PoolEntry = pool_entry(free)
        POOL_FREE.poke(entry.next_free.peek())
        entry.next_free.poke(0)
        entry.at.poke_unbroken(at)
        unlock_pool()
        return free
    next: U32 = when
        POOL_NEXT.peek() == 0 => 1
        else => POOL_NEXT.peek()
    if next == U32.MAX
        unlock_pool()
        throw OutOfMemoryError()
    if (next >> 12).to[U64]() == POOL_CHUNKS.peek()
        add_pool_chunk()
    POOL_NEXT.poke(next + 1)
    pool_entry(next).at.poke_unbroken(at)
    unlock_pool()
    return next

### The generation of a slot that is taken.
### :param slot: The slot.
### :returns: Its generation.
@inline
secret common routine PoolManager.generation(slot: U32) -> U32
    return pool_entry(slot).generation.peek_unbroken[ACQUIRE]()

### Ends the entity in a slot: its address is cleared and its generation goes up, so its stamps fail, and the slot is
### free for the next stamp. A slot whose generation reaches U32.MAX is retired instead.
### :param slot: The slot.
secret common routine PoolManager.end(slot: U32) -> None
    lock_pool()
    entry: @PoolEntry = pool_entry(slot)
    entry.at.poke_unbroken(Addr.zero())
    generation: U32 = entry.generation.peek()
    if generation == U32.MAX
        unlock_pool()
        return
    entry.generation.poke_unbroken(generation + 1)
    entry.next_free.poke(POOL_FREE.peek())
    POOL_FREE.poke(slot)
    unlock_pool()
    return

### The address of the entity a stamp was taken of, or zero when it has ended or moved.
### :param slot: The stamp's slot.
### :param generation: The stamp's generation.
### :returns: The address, or zero.
@inline
secret common routine PoolManager.lookup(slot: U32, generation: U32) -> Addr
    if slot == 0
        return Addr.zero()
    entry: @PoolEntry = pool_entry(slot)
    if entry.generation.peek_unbroken[ACQUIRE]() != generation
        return Addr.zero()
    at: Addr = entry.at.peek_unbroken[ACQUIRE]()
    # Read again: the entity may have ended, and a new one taken the slot, between the two reads above.
    if entry.generation.peek_unbroken[ACQUIRE]() != generation
        return Addr.zero()
    return at

### A stamp of the entity `me` points at: its slot in the table, taken on the first stamp and kept by the entity, and
### the slot's generation. A `&T` lends its view, so `node.stamp()` works on the place itself.
### :typeparam T: The entity's type.
### :returns: The stamp.
### :throws: Crashes with `OutOfMemoryError` when the table has no memory for a new slot.
@inline
routine PointedCell[T].stamp() -> Stamped[T]
    slot: @U32 = stamp_slot[T](me)
    taken: U32 = slot.peek()
    if taken != 0
        return Stamped[T](slot: taken, generation: PoolManager.generation(taken))
    fresh: U32 = PoolManager.take(at: me)
    slot.poke(fresh)
    return Stamped[T](slot: fresh, generation: PoolManager.generation(fresh))

### A stamp of the entity in the place: `getview().stamp()`.
### :typeparam T: The entity's type.
### :returns: The stamp.
### :throws: Crashes with `OutOfMemoryError` when the table has no memory for a new slot.
routine @BorrowedCell[T].stamp() -> Stamped[T]
    return me.getview().stamp()

### The entity the stamp was taken of, while it lives where it was stamped.
### :typeparam T: The entity's type.
### :returns: The entity's view.
### :throws: `StaleStampError` when the entity has ended or moved.
failable routine Stamped[T].fetch() -> @T
    at: Addr = PoolManager.lookup(slot: me.slot, generation: me.generation)
    if at.is_hollow()
        throw StaleStampError()
    return at.to[@T]()

### Whether two stamps are of the same entity: the same slot and generation.
### :typeparam T: The entity's type.
### :param other: The other stamp.
### :returns: True for the same slot and generation.
routine Stamped[T].eq(other: Me) -> Bool
    return me.slot == other.slot and me.generation == other.generation

### Ends the slot of the entity `at` points at, if it has one, and clears the entity's hidden slot: the builder calls it
### where the entity ends (its destruct) or leaves its address (moved out of its place).
### :typeparam T: The entity's type.
### :param at: The entity.
secret routine release_stamp[T](at: @T) -> None
    when stamp_slot_kept[T](at)
        is @U32 as slot =>
            taken: U32 = slot.peek()
            if taken == 0
                return
            slot.poke(0)
            PoolManager.end(taken)
            return
        is None => return

### Gives the slot of the entity `at` points at its new address, if it has one: the builder calls it where the entity
### moved into a new place of the same routine and keeps its stamps (`steal a as b`).
### :typeparam T: The entity's type.
### :param at: The entity, at its new address.
secret routine move_stamp[T](at: @T) -> None
    when stamp_slot_kept[T](at)
        is @U32 as slot =>
            taken: U32 = slot.peek()
            if taken == 0
                return
            lock_pool()
            pool_entry(taken).at.poke_unbroken(at)
            unlock_pool()
            return
        is None => return

### Ends the stamps of `count` entities in a row that moved to another address together: what a collection calls once
### its memory has moved (a List that grows), so their stamps fail instead of reaching the old memory. Nothing for a type
### the program doesn't stamp.
### :typeparam T: The entities' type.
### :param at: The first entity, at its new address.
### :param count: How many there are.
routine release_stamps[T](at: @T, count: U64) -> None
    when stamp_slot_kept[T](at)
        is @U32 => nothing
        is None => return
    for i in 0 til count
        release_stamp[T](at.stride(i))
    return
