# Tessera stdlib: the heap managers
#
# Two managers of the C library's heap, both HeapManageable (MemoryManager.te): CHeapManager is malloc, realloc, and
# free with nothing in front of the blocks, for memory that C code frees or reallocates, or that comes from C's malloc,
# and CheckedHeapManager keeps a header in front of each block and crashes on a block freed twice. HEAP (built in
# MemoryManager.te, with the table's fields) is the default heap, ready before start runs: the checked one with the heap
# check on (config.toml's [debug] heap-check, in any build mode), else the C library's. The construct overloads
# without a memory manager (Os/Defaults.te) draw from it. C_HEAP is CHeapManager's table in every build. Collections take
# any MemoryManager, so these are the hosted defaults, not a requirement.

module Standard/System/Memory

### The alignment malloc gives every block: twice a pointer's size (8 on 32-bit targets, 16 on 64-bit ones).
@target(os: not "none")
secret preset MALLOC_ALIGN: U64 = sizeof[Addr]().mul(2)

### The C library's heap: malloc, realloc, and free in every build, with nothing in front of the blocks. For memory
### that C code frees or reallocates, or that comes from C's malloc and is freed here. An alignment past malloc's own
### comes from posix_memalign (still freed with free), and on Windows, whose free can't take such a block, it crashes.
### `C_HEAP` is its table.
@target(os: not "none")
entity CHeapManager
obeys HeapManageable[CHeapManager]
    nothing

### The C library's heap through `_aligned_malloc`, so every alignment is there: the default heap on Windows with the
### heap check off. Its blocks go back through `_aligned_free`, never C's free.
@target(os: "windows")
entity AlignedHeapManager
obeys HeapManageable[AlignedHeapManager]
    nothing

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: not "none")
common routine CHeapManager.construct() -> Me
    return Me()

### Releases nothing: the manager holds no values.
@target(os: not "none")
routine @CHeapManager.destruct() -> None
    return

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: "windows")
common routine AlignedHeapManager.construct() -> Me
    return Me()

### Releases nothing: the manager holds no values.
@target(os: "windows")
routine @AlignedHeapManager.destruct() -> None
    return

### Whether C's heap can be asked for `size` bytes at all. On a 32-bit target a size of 4 GiB or more doesn't fit
### C's size_t, and a heap turns it down as having no room instead of crashing on the conversion.
### :param size: The number of bytes.
### :returns: True when `size` fits C's size_t.
@target(os: not "none")
secret routine fits_c_size(size: U64) -> Bool
    return size <= CSize.MAX.to[U64]()

### Binds the C `malloc` function, which allocates a block of memory.
### :param size: The number of bytes.
### :returns: The new block, or null when the allocation fails.
@external("c")
@symbol("malloc")
@target(os: not "none")
secret routine c_malloc(size: CSize) -> Addr

### Binds the C `realloc` function, which resizes a block, keeping its contents up to the smaller size.
### :param ptr: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :returns: The resized block (possibly moved), or null when the allocation fails and `ptr` is untouched.
@external("c")
@symbol("realloc")
@target(os: not "none")
secret routine c_realloc(ptr: Addr, size: CSize) -> Addr

### Binds the C `free` function, which gives a block back to the C heap.
### :param ptr: The block to free. Null does nothing.
@external("c")
@symbol("free")
@target(os: not "none")
secret routine c_free(ptr: Addr) -> None

### Binds the C `posix_memalign` function, which allocates a block aligned past malloc's own alignment.
### :param out: Where the block goes.
### :param align: The alignment, a power of two and a multiple of a pointer's size.
### :param size: The number of bytes.
### :returns: 0, or an error number when the block can't be allocated.
@external("c")
@symbol("posix_memalign")
@target(os: ("linux", "macos"))
secret routine c_posix_memalign(out: @Addr, align: CSize, size: CSize) -> CInt

### Binds glibc's `malloc_usable_size`, the size a malloc block holds.
### :param ptr: The block.
### :returns: The bytes the block holds, at least its size.
@external("c")
@symbol("malloc_usable_size")
@target(os: "linux")
secret routine c_block_size(ptr: Addr) -> CSize

### Binds macOS's `malloc_size`, the size a malloc block holds.
### :param ptr: The block.
### :returns: The bytes the block holds, at least its size.
@external("c")
@symbol("malloc_size")
@target(os: "macos")
secret routine c_block_size(ptr: Addr) -> CSize

### Binds the C runtime's `_aligned_malloc`, an aligned block that `_aligned_free` gives back.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block, or null.
@external("c")
@symbol("_aligned_malloc")
@target(os: "windows")
secret routine c_aligned_malloc(size: CSize, align: CSize) -> Addr

### Binds the C runtime's `_aligned_realloc`, which resizes an `_aligned_malloc` block keeping its alignment.
### :param ptr: The block, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, or null with the old one untouched.
@external("c")
@symbol("_aligned_realloc")
@target(os: "windows")
secret routine c_aligned_realloc(ptr: Addr, size: CSize, align: CSize) -> Addr

### Binds the C runtime's `_aligned_free`, which gives an `_aligned_malloc` block back.
### :param ptr: The block. Null does nothing.
@external("c")
@symbol("_aligned_free")
@target(os: "windows")
secret routine c_aligned_free(ptr: Addr) -> None

### Allocates `size` bytes with malloc, or with posix_memalign for an alignment past malloc's.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: ("linux", "macos"))
routine @CHeapManager.borrow(size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return .hollow()
    if align <= MALLOC_ALIGN
        return c_malloc(size.to[CSize]())
    local out: @Addr <- .hollow()
    if c_posix_memalign(out, align.to[CSize](), size.to[CSize]()) != 0
        return .hollow()
    return out.peek()

### Allocates `size` bytes with malloc. Windows' free can't take a block aligned past malloc's own.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when malloc fails.
### :throws: Crashes with `InvalidValueError` when `align` is past malloc's own.
@target(os: "windows")
routine @CHeapManager.borrow(size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return .hollow()
    if align <= MALLOC_ALIGN
        return c_malloc(size.to[CSize]())
    crash(name: "InvalidValueError",
        message: "The C heap can't give a block aligned past malloc's own on Windows: use HEAP.")

### Resizes a block with realloc, and a block aligned past malloc's own through a new aligned block, the contents
### copied over.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block (possibly moved), null when the heap has no room and the old block is untouched.
@target(os: ("linux", "macos"))
routine @CHeapManager.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return .hollow()
    if align <= MALLOC_ALIGN
        return c_realloc(at, size.to[CSize]())
    fresh: Addr = me.borrow(size, align)
    if fresh.is_hollow()
        return .hollow()
    if at.is_hollow()
        return fresh
    kept: U64 = c_block_size(at).min(size.to[CSize]()).to[U64]()
    fresh.to[@Byte]().copy(src: at.to[@Byte](), count: kept)
    c_free(at)
    return fresh

### Resizes a block with realloc.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment, at most malloc's own.
### :returns: The resized block (possibly moved), null when realloc fails and the old block is untouched.
@target(os: "windows")
routine @CHeapManager.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return .hollow()
    return c_realloc(at, size.to[CSize]())

### Gives a block back with free.
### :param at: The block to free. Null does nothing.
@target(os: not "none")
routine @CHeapManager.give_back(at: Addr) -> None
    c_free(at)
    return

### Allocates `size` bytes with `_aligned_malloc`.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: "windows")
routine @AlignedHeapManager.borrow(size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return .hollow()
    return c_aligned_malloc(size.to[CSize](), align.max(MALLOC_ALIGN).to[CSize]())

### Resizes a block with `_aligned_realloc`, keeping its alignment.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, null when the heap has no room and the old block is untouched.
@target(os: "windows")
routine @AlignedHeapManager.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return .hollow()
    return c_aligned_realloc(at, size.to[CSize](), align.max(MALLOC_ALIGN).to[CSize]())

### Gives a block back with `_aligned_free`.
### :param at: The block to free. Null does nothing.
@target(os: "windows")
routine @AlignedHeapManager.give_back(at: Addr) -> None
    c_aligned_free(at)
    return

# -- the checked heap ---------------------------------------------------------------------------------------------
#
# With the heap check on (config.toml's [debug] heap-check, the same in every build mode) every block has a header
# right in front of it: a tag that says whether the block is live or freed, its size, and where malloc's block starts
# (the block is placed HEADER_ROOM bytes or more into it, at the alignment asked for). Freeing swaps the tag to FREED atomically and looks at what was there:
#
# - LIVE: the first free. The block goes into a quarantine of the last QUARANTINE_SIZE freed blocks instead of back to
#   malloc, so its memory keeps saying FREED. The block it pushes out of the quarantine goes back to malloc.
# - FREED: the block was freed before, and the program crashes with DoubleFreeError at the line that freed it again
#   (allocator_call_place(), noted by deallocate).
# - anything else: the pointer isn't a block from this heap (or the bytes in front of it were overwritten), and the
#   program crashes with InvalidValueError.
#
# The swap is atomic, so two threads freeing one block at once are caught too: exactly one of them sees LIVE. A
# second free is caught for sure while the block is in the quarantine. Once it has gone back to malloc, malloc may
# have written over the header (the free reads as "not a block": still a crash) or handed the memory out again as
# another live block (the second free then frees that one, unseen), so the quarantine keeps the window wide. A
# reallocation copies into a new block and frees the old one the same way, so a stale pointer to the old block is
# caught like any freed one. CheckedHeapManager is there in every build, and HEAP is the checked heap when the heap
# check is on. With it off HEAP is the C library's heap above.

### The headers of the last QUARANTINE_SIZE freed blocks, held back from malloc.
@target(os: not "none")
secret global QUARANTINE: @Array[Addr, QUARANTINE_SIZE]
### The number of blocks that have gone into the quarantine, whose low bits pick the next slot.
@target(os: not "none")
secret global QUARANTINE_NEXT: @U64

### The room kept in front of a block for its header, a multiple of every alignment malloc gives.
@target(os: not "none")
secret preset HEADER_ROOM: U64 = 32
### The tag of a block that is in use.
@target(os: not "none")
secret preset LIVE: U64 = 0x7E55A11E
### The tag of a block that has been freed.
@target(os: not "none")
secret preset FREED: U64 = 0x7E55F4EE
### How many freed blocks the checked heap holds back from malloc.
@target(os: not "none")
secret preset QUARANTINE_SIZE: U64 = 256
### The mask that turns the running count of frees into a quarantine slot.
@target(os: not "none")
secret preset QUARANTINE_MASK: U64 = QUARANTINE_SIZE.sub(1)

### The checked heap: the C library's heap with a header in front of each block, which crashes with `DoubleFreeError`
### on a block freed twice and with `InvalidValueError` on memory that isn't one of its blocks. Every alignment is
### there. `HEAP` is its table when the heap check is on.
@target(os: not "none")
entity CheckedHeapManager
obeys HeapManageable[CheckedHeapManager]
    nothing

### What the checked heap keeps in front of each block.
@target(os: not "none")
secret record BlockHeader
    tag: U64
    size: U64
    raw: Addr

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: not "none")
common routine CheckedHeapManager.construct() -> Me
    return Me()

### Releases nothing: the manager holds no values.
@target(os: not "none")
routine @CheckedHeapManager.destruct() -> None
    return

### Allocates with malloc the header room, `size` bytes, and room to align, the header tagged LIVE.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block after the header, null when malloc fails or the size can't hold a header too.
@target(os: not "none")
routine @CheckedHeapManager.borrow(size: U64, align: U64) -> Addr
    local step: U64 = align.max(MALLOC_ALIGN)

    total: Maybe[U64] = try size.add(HEADER_ROOM.add(step))
    when total
        is U64 as bytes =>
            if not fits_c_size(bytes)
                return .hollow()
            raw: Addr = c_malloc(bytes.to[CSize]())
            if raw.is_hollow()
                return .hollow()
            # The first address HEADER_ROOM bytes in that is a multiple of the alignment.
            lowest: U64 = ptrtoint[Addr, U64](raw) + HEADER_ROOM
            aligned: U64 = lowest + step - 1 & ~(step - 1)
            block_start: Addr = inttoptr[U64, Addr](aligned)
            header: @BlockHeader = header_of(block_start)
            header.tag.poke(LIVE)
            header.size.poke(size)
            header.raw.poke(raw)
            return block_start
        is None => return .hollow()

### Resizes a block: a new block, the contents copied over (as many bytes as both sizes allow), and the old block
### freed through the same checks as `free`.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The new block, null when malloc fails and the old block is untouched.
### :throws: Crashes with `InvalidValueError` when `at` was freed already or isn't a block of this heap.
@target(os: not "none")
routine @CheckedHeapManager.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if at.is_hollow()
        return me.borrow(size, align)
    header: @BlockHeader = header_of(at)
    tag: U64 = header.tag.peek_atomic()
    when
        tag == LIVE =>
            new_ptr: Addr = me.borrow(size, align)
            if new_ptr.is_hollow()
                return .hollow()
            kept: U64 = header.size.peek().min(size)
            new_ptr.to[@Byte]().copy(src: at.to[@Byte](), count: kept)
            release_block(at)
            return new_ptr
        tag == FREED => heap_crash(name: "InvalidValueError",
            message: "The checked heap was asked to resize a block that was given back already.")
        else => heap_crash(name: "InvalidValueError",
            message: "The checked heap was asked to resize memory that isn't a block it gave out.")

### Gives a block back: checks the block's tag and puts the block in the quarantine.
### :param at: The block to free. Null does nothing.
### :throws: Crashes with `DoubleFreeError` when the block was freed already, and with `InvalidValueError` when `at`
###     isn't a block of this heap.
@target(os: not "none")
routine @CheckedHeapManager.give_back(at: Addr) -> None
    if at.is_hollow()
        return
    release_block(at)
    return

### The header in front of a block of the checked heap.
### :param block_start: The block, as the checked heap gave it out.
### :returns: The address `HEADER_ROOM` bytes before `block_start`.
@target(os: not "none")
secret routine header_of(block_start: Addr) -> @BlockHeader
    raw: Addr = block_start -% ByteSize.construct(bytes: HEADER_ROOM)
    header: @BlockHeader = raw.to[@BlockHeader]()
    return header

### Tags the block FREED and puts it in the quarantine, crashing when it was freed already or isn't a block of this
### heap. The block pushed out of the quarantine goes back to malloc.
### :param block_start: The block to release.
### :throws: Crashes with `DoubleFreeError` when the block was freed already, and with `InvalidValueError` when it
###     isn't a block of this heap.
@target(os: not "none")
secret routine release_block(block_start: Addr) -> None
    local header: @BlockHeader = header_of(block_start)

    was: U64 = header.tag.atomic_swap(FREED)
    when
        was == LIVE =>
            turn: U64 = QUARANTINE_NEXT.atomic_fetch_add(1)
            slot: @Addr = QUARANTINE.getslot(turn & QUARANTINE_MASK)
            evicted: Addr = slot.atomic_swap(header)
            if evicted.is_hollow()
                return
            c_free(evicted.to[@BlockHeader]().raw.peek())
            return
        was == FREED => heap_crash(name: "DoubleFreeError",
            message: "This block was given back already: it was given back twice.")
        else => heap_crash(name: "InvalidValueError",
            message: "The checked heap was asked to take back memory that isn't a block it lent.")

### Crashes at the place of the deallocate or reallocate call that reached the heap, when one was noted, else at the
### heap itself.
### :param name: The crash's error name, such as `DoubleFreeError`.
### :param message: The crash message.
### :throws: Always crashes with the error `name`.
@target(os: not "none")
@noreturn
secret routine heap_crash(name: @[Byte], message: @[Byte]) -> None
    place: @SourceLocation = allocator_call_place()
    if place.is_not_hollow()
        crash_at(name, message, place)
    crash(name, message)
