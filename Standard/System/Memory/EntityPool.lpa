# Lapila stdlib: the EntityPool and PoolStamp, a pool that keeps entities of many types and links to them by stamps
#
# `EntityPool.add(steal node)` hands an entity to the pool, which keeps it in a slot and gives a `PoolStamp[Node]`, 8
# bytes: the slot's number and the slot's generation. `stamp.fetch()` gives the entity's `@T`, or throws
# `StaleStampError` when the generation in the slot is not the stamp's. `EntityPool.remove(stamp)` takes effect at once:
# the slot's generation goes up, so every later `fetch` of any stamp of it fails, but the entity stays in its slot and
# nothing is destructed. `EntityPool.sweep()` destructs the removed entities and makes their slots free for the next
# `add`, in time proportional to how many were removed. Until the sweep an `@T` fetched before the `remove` still
# points at a live entity. `EntityPool.tear_down()` ends the entities that are left and gives the pool's memory back.
# A link that may be missing is a `PoolStamp[T]?`: a `@none_is_zero` record, so it is the 8-byte stamp itself and the
# all-zero stamp is None.
#
# The pool reserves one range of address space when it is set up (64 GiB on a 64-bit target) and commits pages of it as
# it grows, so nothing ever moves and a slot's address is the range's start plus the slot's number times 16. A slot is
# a header and the entity: the header is 8 bytes, the type id (`typeid[T]()`, 0 while the slot holds no entity) and
# the generation, and the entity follows at 8 bytes. The slots of one type sit side by side in chunks of 4,096 slots
# taken from the range one after the other. A fetch reads the range's start and the slot's generation, with no
# lock. Adding, removing and sweeping take a short lock (the one of the PoolManager's table). Slot 0 is the range's
# first 16 bytes, never given out and with generation 1, so an all-zero stamp is always stale. A slot whose generation
# reaches U32.MAX is retired, never used again. The pool is a service: `EntityPool.set_up(memory: PAGES)` in `start`,
# before the first `add`, with a memory manager that reserves pages.

module System/Memory

### The start of the reserved range, zero before set_up. Slot n is at this address plus n times 16.
secret global ENTITY_BASE: &Addr
### The bytes reserved.
secret global ENTITY_RESERVED: &U64
### The bytes of the range committed so far, from its start.
secret global ENTITY_COMMITTED: &U64
### The first 16-byte unit of the range no chunk has taken.
secret global ENTITY_TOP: &U64
### The table of types, `ENTITY_TYPE_ROOM` entries of `PoolType` found by their type id.
secret global ENTITY_TYPES: &Addr
### The chunks taken so far: one `PoolChunk` each.
secret global ENTITY_CHUNK_LIST: &Addr
### How many chunks the chunk list has room for.
secret global ENTITY_CHUNK_ROOM: &U64
### How many chunks there are.
secret global ENTITY_CHUNK_COUNT: &U64
### The slots removed and not swept yet, one U32 each.
secret global ENTITY_REMOVED: &Addr
### How many slots the removed list has room for.
secret global ENTITY_REMOVED_ROOM: &U64
### How many removed slots wait for a sweep.
secret global ENTITY_REMOVED_COUNT: &U64
### Where the tables come from and which reserved the range, None before set_up.
secret global ENTITY_MEMORY: &(@MemoryManager?)

### How many slots a chunk holds.
secret preset ENTITY_CHUNK_SLOTS: U64 = 4096
### How many entries the type table has: a power of two, with room for every type a program is likely to keep.
secret preset ENTITY_TYPE_ROOM: U64 = 1024
### The bytes in front of an entity in its slot: the type id and the generation.
secret preset ENTITY_HEADER: U64 = 8
### The pages committed at a time, a multiple of every page size.
secret preset ENTITY_COMMIT_STEP: U64 = 1048576

### A link to an entity in the EntityPool: the entity's slot and the slot's generation when the entity was added. The
### stamp doesn't keep the entity alive and copies for free. `fetch()` reads the entity while its slot has this
### generation. A link that may be missing is a `PoolStamp[T]?`, which is this record alone with the all-zero record as
### None (slot 0 is never given out).
### :typeparam T: The entity's type.
@none_is_zero
record PoolStamp[T]
    ### The entity's slot, never 0.
    secret slot: U32
    ### The slot's generation when the entity was added.
    secret generation: U32

### The table of the program's pool entities, one per program. Its routines are called on the type, and its state is
### its own globals. A program that adds entities sets it up first, in `start`: `EntityPool.set_up(memory: PAGES)`.
record EntityPool
    nothing

### The head of a slot: 8 bytes in front of the entity.
secret record SlotHeader
    ### The type id of the slot's entity, 0 while it holds no entity.
    type_id: U32
    ### Goes up each time the slot's entity is removed.
    generation: U32

### One chunk of slots: where it starts, in 16-byte units, and the type id of its slots.
secret record PoolChunk
    ### The chunk's first slot.
    first: U32
    ### The type id of its slots.
    type_id: U32

### One type the pool keeps, found in the type table by its type id.
secret record PoolType
    ### The type id, 0 for an empty entry.
    id: U32
    ### The first free slot, 0 for none.
    free: U32
    ### The next slot never used in the type's last chunk, 0 for none.
    fresh_next: U32
    ### One past the last slot of the type's last chunk.
    fresh_end: U32
    ### Ends the entity a slot holds, from the address of the entity.
    destroy: Callable[(Addr,), None]
    ### The bytes of a slot of this type, a multiple of 16.
    stride: U64

### The bytes of a slot of `T`: the header and the entity rounded up to 16 bytes.
### :typeparam T: The entity's type.
### :returns: The slot size.
@inline
secret routine slot_stride[T]() -> U64
needs AnyType T
    raw: U64 = ENTITY_HEADER + sizeof[T]()
    rounded: U64 = (raw + 15) // 16 * 16
    return when
        rounded < 16 => 16
        else => rounded

### Ends the entity at `at`: what the pool calls for a swept or left slot, kept in the type's entry.
### :typeparam T: The entity's type.
### :param at: The entity's address.
secret routine pool_destroy[T](at: Addr) -> None
needs AnyType T
    drop at.to[@T]()
    return

### The first byte of a slot. No lock.
### :param slot: The slot's number.
### :returns: Its address.
@inline
secret routine slot_address(slot: U32) -> @Byte
    return bitcast[Addr, @Byte](pool_read(ENTITY_BASE)).stride(slot.to[U64]() << 4)

### The entry of a type in the type table: the one with this id, else the empty one it would take. Called with the lock
### held, or on a table that doesn't change.
### :param id: The type id, not 0.
### :returns: The entry.
secret routine type_entry(id: U32) -> @PoolType
    table: @PoolType = ENTITY_TYPES.load().to[@PoolType]()
    mask: U64 = ENTITY_TYPE_ROOM - 1
    loop with at: U64 = id.to[U64]() & mask
        entry: @PoolType = table.stride(at)
        found: U32 = entry.id.peek()
        if found == 0 or found == id
            return entry
        continue with at: (at + 1) & mask

### The memory manager the pool's tables come from.
### :returns: The manager.
### :throws: Throws `UnacceptedValueError` when `set_up` wasn't called.
secret routine entity_memory() -> @MemoryManager
    when ENTITY_MEMORY.load()
        is @MemoryManager as memory => return memory
        is None =>
            throw UnacceptedValueError(description: "The EntityPool is not set up: call EntityPool.set_up(memory: PAGES) in start, before the first add.")

### Sets the pool up: it reserves its range of address space from `memory`, which also gives its tables. A program calls
### it once, in `start`, before its first `add`.
### :param memory: A memory manager that reserves pages, such as `PAGES`.
### :throws: Throws `UnacceptedValueError` when the pool is set up already, or the manager can't reserve pages.
### :throws: Throws `OutOfMemoryError` when there is no memory for the tables.
common routine EntityPool.set_up(memory: @MemoryManager) -> None
    lock_pool()
    when ENTITY_MEMORY.load()
        is @MemoryManager =>
            unlock_pool()
            throw UnacceptedValueError(description: "The EntityPool is set up already: call EntityPool.set_up(memory: m) once, in start.")
        is None => nothing
    reserved: U64 = when
        sizeof[Addr]() == 8 => 68719476736
        else => 268435456
    base: Addr = memory.reserve(reserved)
    if base.is_hollow()
        unlock_pool()
        throw UnacceptedValueError(description: "The EntityPool needs a memory manager that reserves pages: call EntityPool.set_up(memory: PAGES).")
    types: Addr = allocate[PoolType](count: ENTITY_TYPE_ROOM, manager: memory)
    if types.is_hollow()
        memory.release(base, reserved)
        unlock_pool()
        throw OutOfMemoryError()
    types.to[@PoolType]().zeroinit(ENTITY_TYPE_ROOM)
    if not memory.commit(base, ENTITY_COMMIT_STEP)
        memory.release(base, reserved)
        memory.give_back(types)
        unlock_pool()
        throw OutOfMemoryError()
    base.to[@SlotHeader]().generation.poke(1)
    ENTITY_RESERVED.store(reserved)
    ENTITY_COMMITTED.store(ENTITY_COMMIT_STEP)
    ENTITY_TOP.store(1)
    ENTITY_TYPES.store(types)
    ENTITY_MEMORY.store(memory)
    pool_write(ENTITY_BASE, value: base)
    unlock_pool()
    return

### Whether `set_up` was called.
### :returns: True once the pool is set up.
common routine EntityPool.is_set_up() -> Bool
    when ENTITY_MEMORY.load()
        is @MemoryManager => return true
        is None => return false

### Appends a chunk to the chunk list, which grows by doubling. Called with the lock held.
### :param first: The chunk's first slot.
### :param id: The type id of its slots.
### :returns: False when the manager has no memory.
secret routine note_chunk(first: U32, id: U32) -> Bool
    count: U64 = ENTITY_CHUNK_COUNT.load()
    if count == ENTITY_CHUNK_ROOM.load()
        memory: @MemoryManager = entity_memory()
        grown: U64 = when
            count == 0 => 64
            else => count * 2
        fresh: Addr = allocate[PoolChunk](count: grown, manager: memory)
        if fresh.is_hollow()
            return false
        if count > 0
            fresh.to[@PoolChunk]().copy(src: ENTITY_CHUNK_LIST.load().to[@PoolChunk](), count)
            memory.give_back(ENTITY_CHUNK_LIST.load())
        ENTITY_CHUNK_LIST.store(fresh)
        ENTITY_CHUNK_ROOM.store(grown)
    entry: @PoolChunk = ENTITY_CHUNK_LIST.load().to[@PoolChunk]().stride(count)
    entry.first.poke(first)
    entry.type_id.poke(id)
    ENTITY_CHUNK_COUNT.store(count + 1)
    return true

### Takes a chunk of slots for a type from the end of the range, committing pages when it reaches past the committed ones.
### Called with the lock held.
### :param entry: The type's entry.
### :returns: False when the range is full or the pages can't be committed.
secret routine take_chunk(entry: @PoolType) -> Bool
    stride: U64 = entry.stride.peek()
    first: U64 = ENTITY_TOP.load()
    end: U64 = first + ENTITY_CHUNK_SLOTS * stride // 16
    if (end << 4) > ENTITY_RESERVED.load() or end >= 4294967296
        return false
    committed: U64 = ENTITY_COMMITTED.load()
    if (end << 4) > committed
        step: U64 = ((end << 4) - committed + ENTITY_COMMIT_STEP - 1) // ENTITY_COMMIT_STEP * ENTITY_COMMIT_STEP
        step_to: U64 = when
            committed + step > ENTITY_RESERVED.load() => ENTITY_RESERVED.load() - committed
            else => step
        at: Addr = pool_read(ENTITY_BASE) +% ByteSize.construct(bytes: committed)
        if not entity_memory().commit(at, step_to)
            return false
        ENTITY_COMMITTED.store(committed + step_to)
    if not note_chunk(first.to[U32](), entry.id.peek())
        return false
    ENTITY_TOP.store(end)
    entry.fresh_next.poke(first.to[U32]())
    entry.fresh_end.poke(end.to[U32]())
    return true

### Takes a slot of a type: a free one, else the next one never used, in a new chunk when the last one is full. Called with
### the lock held.
### :param entry: The type's entry.
### :returns: The slot, 0 when there is no room.
secret routine take_slot(entry: @PoolType) -> U32
    free: U32 = entry.free.peek()
    if free != 0
        entry.free.poke(slot_address(free).stride(ENTITY_HEADER).to[@U32]().peek())
        return free
    if entry.fresh_next.peek() == entry.fresh_end.peek()
        if not take_chunk(entry)
            return 0
    next: U32 = entry.fresh_next.peek()
    entry.fresh_next.poke(next + (entry.stride.peek() // 16).to[U32]())
    slot_address(next).to[@SlotHeader]().generation.poke(1)
    return next

### Hands `value` to the pool, which keeps it in a slot from now on, and gives its stamp.
### :typeparam T: The entity's type (a record is kept too).
### :param value: The entity, handed over.
### :returns: The stamp.
### :throws: Throws `OutOfMemoryError` when the range is full or its pages can't be committed. Throws `UnacceptedValueError` for a type aligned past 8 bytes, or when the type table is full. The value ends before the failure goes on.
common routine EntityPool.add[T](value: T) -> PoolStamp[T]
needs AnyType T
    if alignof[T]() > 8
        drop value
        throw UnacceptedValueError(description: "The EntityPool keeps types aligned to at most 8 bytes.")
    id: U32 = typeid[T]()
    lock_pool()
    entry: @PoolType = type_entry(id)
    if entry.id.peek() == 0
        entry.id.poke(id)
        entry.destroy.poke(pool_destroy[T].to[Callable]())
        entry.stride.poke(slot_stride[T]())
    slot: U32 = take_slot(entry)
    if slot == 0
        unlock_pool()
        drop value
        throw OutOfMemoryError()
    base: @Byte = slot_address(slot)
    base.stride(ENTITY_HEADER).to[@T]().poke(steal value)
    header: @SlotHeader = base.to[@SlotHeader]()
    header.type_id.poke(id)
    generation: U32 = header.generation.peek()
    unlock_pool()
    return PoolStamp[T](slot, generation)

### The entity the stamp was added with, in its slot.
### :typeparam T: The entity's type.
### :returns: The entity's view.
### :throws: `StaleStampError` when the entity was removed, or its slot was reused.
@inline
routine PoolStamp[T].fetch() -> @T
needs AnyType T
    base: @Byte = slot_address(me.slot)
    if pool_read(base.to[@SlotHeader]().generation) != me.generation
        throw StaleStampError()
    return base.stride(ENTITY_HEADER).to[@T]()

### Whether two stamps are of the same entity, the same slot and generation: `a === b`. A stamp names an entity, so it
### compares by identity and has no `==`.
### :typeparam T: The entity's type.
### :param other: The other stamp.
### :returns: True for the same slot and generation.
routine PoolStamp[T].same(other: Me) -> Bool
    return me.slot == other.slot and me.generation == other.generation

### Whether two stamps are of different entities: `a !== b`.
### :typeparam T: The entity's type.
### :param other: The other stamp.
### :returns: True when the slot or the generation differs.
routine PoolStamp[T].notsame(other: Me) -> Bool
    return me.slot != other.slot or me.generation != other.generation

### Removes the entity of a stamp, at once: every `fetch` of its stamps fails from now on. The entity stays in its slot
### and is not destructed until `sweep`, so an `@T` fetched before still points at it.
### :typeparam T: The entity's type.
### :param stamp: The entity's stamp.
### :throws: `StaleStampError` when the entity was removed already. Throws `OutOfMemoryError` when the removed list can't grow.
common routine EntityPool.remove[T](stamp: PoolStamp[T]) -> None
needs AnyType T
    header: @SlotHeader = slot_address(stamp.slot).to[@SlotHeader]()
    lock_pool()
    generation: U32 = header.generation.peek()
    if generation != stamp.generation
        unlock_pool()
        throw StaleStampError()
    waiting: U64 = ENTITY_REMOVED_COUNT.load()
    if waiting == ENTITY_REMOVED_ROOM.load()
        memory: @MemoryManager = entity_memory()
        grown: U64 = when
            waiting == 0 => 64
            else => waiting * 2
        fresh: Addr = allocate[U32](count: grown, manager: memory)
        if fresh.is_hollow()
            unlock_pool()
            throw OutOfMemoryError()
        if waiting > 0
            fresh.to[@U32]().copy(src: ENTITY_REMOVED.load().to[@U32](), count: waiting)
            memory.give_back(ENTITY_REMOVED.load())
        ENTITY_REMOVED.store(fresh)
        ENTITY_REMOVED_ROOM.store(grown)
    ENTITY_REMOVED.load().to[@U32]().stride(waiting).poke(stamp.slot)
    ENTITY_REMOVED_COUNT.store(waiting + 1)
    pool_write(header.generation, value: generation + 1)
    unlock_pool()
    return

### Ends the entity in a slot, makes the slot free (unless it is retired), and marks it empty. Called without the lock.
### :param slot: The slot.
secret routine end_slot(slot: U32) -> None
    base: @Byte = slot_address(slot)
    header: @SlotHeader = base.to[@SlotHeader]()
    entry: @PoolType = type_entry(header.type_id.peek())
    destroy: Callable[(Addr,), None] = entry.destroy.peek()
    destroy.call(base.stride(ENTITY_HEADER).to[Addr]())
    lock_pool()
    header.type_id.poke(0)
    if header.generation.peek() != U32.MAX
        base.stride(ENTITY_HEADER).to[@U32]().poke(entry.free.peek())
        entry.free.poke(slot)
    unlock_pool()
    return

### Destructs the entities removed so far and makes their slots free for reuse. The time is proportional to the number
### of removed entities. An `@T` fetched before the `remove` must not be used after this.
common routine EntityPool.sweep() -> None
    loop
        lock_pool()
        waiting: U64 = ENTITY_REMOVED_COUNT.load()
        if waiting == 0
            unlock_pool()
            return
        slot: U32 = ENTITY_REMOVED.load().to[@U32]().stride(waiting - 1).peek()
        ENTITY_REMOVED_COUNT.store(waiting - 1)
        unlock_pool()
        end_slot(slot)

### Ends the entities that are left, after a sweep, and gives the pool's memory back, so the pool can be set up again.
### A program calls it at the end of `start`: the program's end doesn't run it.
common routine EntityPool.tear_down() -> None
    EntityPool.sweep()
    when ENTITY_MEMORY.load()
        is @MemoryManager as memory =>
            for number in 0 til ENTITY_CHUNK_COUNT.load()
                chunk: @PoolChunk = ENTITY_CHUNK_LIST.load().to[@PoolChunk]().stride(number)
                step: U32 = (type_entry(chunk.type_id.peek()).stride.peek() // 16).to[U32]()
                for index in 0 til ENTITY_CHUNK_SLOTS
                    slot: U32 = chunk.first.peek() + index.to[U32]() * step
                    if slot_address(slot).to[@SlotHeader]().type_id.peek() != 0
                        end_slot(slot)
            memory.release(ENTITY_BASE.load(), ENTITY_RESERVED.load())
            memory.give_back(ENTITY_TYPES.load())
            if ENTITY_CHUNK_ROOM.load() > 0
                memory.give_back(ENTITY_CHUNK_LIST.load())
            if ENTITY_REMOVED_ROOM.load() > 0
                memory.give_back(ENTITY_REMOVED.load())
            ENTITY_BASE.store(Addr.zero())
            ENTITY_RESERVED.store(0)
            ENTITY_COMMITTED.store(0)
            ENTITY_TOP.store(0)
            ENTITY_TYPES.store(Addr.zero())
            ENTITY_CHUNK_LIST.store(Addr.zero())
            ENTITY_CHUNK_ROOM.store(0)
            ENTITY_CHUNK_COUNT.store(0)
            ENTITY_REMOVED.store(Addr.zero())
            ENTITY_REMOVED_ROOM.store(0)
            ENTITY_REMOVED_COUNT.store(0)
            ENTITY_MEMORY.store(None())
            return
        is None => return
