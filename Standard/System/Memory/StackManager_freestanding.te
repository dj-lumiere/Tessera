# Tessera stdlib: the stack manager of a program without an operating system (see StackManager.te)
#
# The link script the builder writes from the board's memory map defines `__stack_top`, where the one stack starts
# (the end of RAM), and `__stack_bottom`, the lowest address it may reach (the end of the globals). A program that
# asks for StackManager.current() needs both.

module System/Memory

### The lowest address the stack may reach (the link script's `__stack_bottom`), for StackManager.current().
@external("c")
@symbol("__stack_bottom")
@target(os: "none")
global STACK_BOTTOM: &Byte

### The address the stack starts at (the link script's `__stack_top`), for StackManager.current().
@external("c")
@symbol("__stack_top")
@target(os: "none")
global STACK_TOP: &Byte

### The StackManager of the one stack a program without an operating system runs on, filled on first use.
@target(os: "none")
secret global BOOT_STACK: &StackManager

### The StackManager of the stack the running flow is on when the program switched to a stack of its own (a thread of
### a ThreadManagerByRoundRobin), null on the program's own stack. What switches stacks points it at the stack it
### switches to, so the frame check measures from that stack's bottom.
@target(os: "none")
global RUNNING_STACK: &@StackManager

### Whether a stack that ran out has been reported: the report's own routines run inside the margin.
@target(os: "none")
secret global STACK_OVERFLOWED: &Bool

### How far above the stack's bottom the stack pointer must stay when a routine starts: the room a routine's spills
### and the crash report of a stack that ran out still use.
@target(os: "none")
secret preset STACK_MARGIN: U64 = 4096

### The StackManager of the stack the program runs on: `__stack_bottom` up to `__stack_top`.
### :returns: The manager, for the program's whole run.
@target(os: "none")
common routine StackManager.current() -> @Me
    if BOOT_STACK.top.peek().is_hollow()
        BOOT_STACK.poke(Me.construct(STACK_BOTTOM.to[Addr](), STACK_TOP.to[Addr]()))
    return BOOT_STACK

### Borrows the running routine's frame from the stack, once the routine's prologue has made it: the builder calls it
### at the start of every routine but one that calls no other routine and has at most 1 KiB of slots (the check of the
### routine that called it left it room), which the routines this one calls are. Without an operating system nothing
### closes the memory below a stack (the globals are there, or another thread's slot), so it reads the stack pointer
### and stops the program with `StackOverflowError` when it is less than the margin above the bottom of the running
### stack: RUNNING_STACK's, else the program's own. A frame whose slots are larger than the margin is checked from where
### the stack pointer was before the frame.
### :param size: The bytes of the frame's slots the builder knows of.
@inline
@target(os: "none")
common routine StackManager.borrow_frame(size: U64) -> None
    sp: U64 = ptrtoint[Addr, U64](stack_pointer())
    running: @StackManager = RUNNING_STACK.peek()
    if running.is_not_hollow()
        thread_low: U64 = ptrtoint[Addr, U64](running.bottom.peek())
        if sp +% size >= thread_low and sp < thread_low +% STACK_MARGIN
            Me.report_overflow()
        return
    low: U64 = ptrtoint[Addr, U64](STACK_BOTTOM.to[Addr]())
    if sp +% size >= low and sp < low +% STACK_MARGIN
        Me.report_overflow()
    return

### Stops the program with `StackOverflowError`, once: the report runs on what is left of the stack, inside the
### margin, and its routines' own frame checks find the stack reported already.
@noinline
@target(os: "none")
common routine StackManager.report_overflow() -> None
    if STACK_OVERFLOWED.peek()
        return
    STACK_OVERFLOWED.poke(true)
    throw StackOverflowError(
        description: "The stack ran out: the routines called each other deeper than it holds.")

### The stack ran out.
crashable StackOverflowError
    ### What happened, in a sentence.
    description: @[Byte]

### Writes the description.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine StackOverflowError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("{me.description}")
    return
