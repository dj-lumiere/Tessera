# Tessera stdlib: the GlobalManager, the globals' memory on a target without an operating system
#
# The link script the builder writes from the board's memory map defines the symbols it uses: `__bss_start` and
# `__bss_end` around .bss, `__data_start` and `__data_end` around .data in RAM, and `__data_load`, where .data's first
# values are: in flash, or on a board without flash the same place as `__data_start`, since the loader put the image in
# RAM. The program's when_power_on runs GlobalManager.prepare() (through `prepare_core`, Boot.te in
# Unhosted) before anything reads a global.

module System/Memory

### The first byte of .bss (the link script's `__bss_start`).
@external("c")
@symbol("__bss_start")
@target(os: "none")
global BSS_START: &Byte

### The byte after .bss (the link script's `__bss_end`).
@external("c")
@symbol("__bss_end")
@target(os: "none")
global BSS_END: &Byte

### The first byte of .data in RAM (the link script's `__data_start`).
@external("c")
@symbol("__data_start")
@target(os: "none")
global DATA_START: &Byte

### The byte after .data in RAM (the link script's `__data_end`).
@external("c")
@symbol("__data_end")
@target(os: "none")
global DATA_END: &Byte

### Where .data's first values are in flash (the link script's `__data_load`).
@external("c")
@symbol("__data_load")
@target(os: "none")
global DATA_LOAD: &Byte

### The globals' memory: .bss, the globals whose first value is all zero bytes, and .data, the others. The program
### image holds their first values, and on a target without an operating system the GlobalManager puts them in place
### before anything reads a global: `GlobalManager.prepare()`, which `prepare_core` runs. Its routines are called on
### the type.
@target(os: "none")
entity GlobalManager
    nothing

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: "none")
common routine GlobalManager.construct() -> Me
    return Me()

### Zeroes .bss, the globals whose first value is all zero bytes: `__bss_start` up to `__bss_end`.
@target(os: "none")
common routine GlobalManager.zero_bss() -> None
    first: U64 = ptrtoint[Addr, U64](BSS_START)
    after: U64 = ptrtoint[Addr, U64](BSS_END)
    BSS_START.zeroinit(after - first)
    return

### Copies .data's first values from flash (`__data_load`) into RAM (`__data_start` up to `__data_end`). On a board
### without flash both are the same place, and there is nothing to copy.
@target(os: "none")
common routine GlobalManager.copy_data() -> None
    first: U64 = ptrtoint[Addr, U64](DATA_START)
    after: U64 = ptrtoint[Addr, U64](DATA_END)
    if ptrtoint[Addr, U64](DATA_LOAD) == first
        return
    DATA_START.copy(src: DATA_LOAD, count: after - first)
    return

### Puts the globals in place: zeroes .bss and copies .data's first values from flash.
@target(os: "none")
common routine GlobalManager.prepare() -> None
    Me.zero_bss()
    Me.copy_data()
    return
