# Tessera stdlib: ByteSize, an amount of memory
#
# A ByteSize counts bytes in a U64. A literal with a size unit is one: 512b, 4kb, 4kib, 16mb, 16mib, 1gb, 1gib (kb, mb
# and gb count by 1000, kib, mib and gib by 1024). Page and stack sizes are ByteSizes. Arithmetic crashes when the
# result doesn't fit, and +^ / -^ stop at the ends instead.

module Standard/System/Memory

### The largest size a ByteSize holds, 2^64 - 1 bytes.
preset ByteSize.MAX: ByteSize = 18446744073709551615b

### An amount of memory in bytes. A literal with a size unit is one (`512b`, `4kib`, `16mib`, `1gb`). Arithmetic
### crashes on overflow and on a result below 0, and `add_clamp` / `sub_clamp` (`+^`, `-^`) stop at the ends instead.
@llvm("i64")
record ByteSize
obeys Equatable[ByteSize], Comparable[ByteSize], Hashable[ByteSize]
obeys Addable[ByteSize], Subtractable[ByteSize], ClampingAddable[ByteSize], ClampingSubtractable[ByteSize], Scalable[ByteSize, U64], ScalarFloorDivisible[ByteSize, U64], RatioDivisible[ByteSize, U64]

# -- the count -----------------------------------------------------------------

### The size of `bytes` bytes.
### :param bytes: The bytes.
### :returns: The size.
common routine ByteSize.construct(bytes: U64) -> Me
    r: Me = bitcast[U64, Me](bytes)
    return r

### The size in bytes.
### :returns: The bytes.
routine ByteSize.bytes() -> U64
    r: U64 = bitcast[Me, U64](me)
    return r

### No memory at all, 0 bytes.
### :returns: The zero size.
common routine ByteSize.zero() -> Me
    return Me.construct(bytes: 0)

### Whether the size is 0.
### :returns: True for no memory at all.
routine ByteSize.is_zero() -> Bool
    return me.bytes() == 0

# -- arithmetic ----------------------------------------------------------------

### The two sizes together: `me + other`.
### :param other: The size to add.
### :returns: The sum.
### :throws: Crashes with `IntegerOverflowError` when it is larger than {ByteSize.MAX}.
@track_caller
routine ByteSize.add(other: Me) -> Me
    return Me.construct(bytes: me.bytes() + other.bytes())

### The two sizes together, stopping at {ByteSize.MAX}: `me +^ other`.
### :param other: The size to add.
### :returns: The sum, or {ByteSize.MAX}.
routine ByteSize.add_clamp(other: Me) -> Me
    return Me.construct(bytes: me.bytes() +^ other.bytes())

### What is left of `me` after `other`: `me - other`.
### :param other: The size to take away.
### :returns: The difference.
### :throws: Crashes with `IntegerOverflowError` when `other` is larger than `me`.
@track_caller
routine ByteSize.sub(other: Me) -> Me
    return Me.construct(bytes: me.bytes() - other.bytes())

### What is left of `me` after `other`, stopping at 0: `me -^ other`.
### :param other: The size to take away.
### :returns: The difference, or 0 when `other` is larger.
routine ByteSize.sub_clamp(other: Me) -> Me
    return Me.construct(bytes: me.bytes() -^ other.bytes())

### The size `factor` times over: `me * factor`.
### :param factor: How many times.
### :returns: The product.
### :throws: Crashes with `IntegerOverflowError` when it is larger than {ByteSize.MAX}.
@track_caller
routine ByteSize.mul(factor: U64) -> Me
    return Me.construct(bytes: me.bytes() * factor)

### The size cut into `parts` equal parts, one of them rounded down to the byte: `me // parts`.
### :param parts: How many parts.
### :returns: One part.
### :throws: Crashes with `DivisionByZeroError` when `parts` is 0.
@track_caller
routine ByteSize.floordiv(parts: U64) -> Me
    return Me.construct(bytes: me.bytes() // parts)

### How many whole times `other` fits in `me`: `me // other`.
### :param other: The size to count.
### :returns: The count.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine ByteSize.floordiv(other: Me) -> U64
    return me.bytes() // other.bytes()

### What is left of `me` after taking out `other` as many whole times as it fits: `me % other`.
### :param other: The size to take out.
### :returns: The rest.
### :throws: Crashes with `DivisionByZeroError` when `other` is 0.
@track_caller
routine ByteSize.mod(other: Me) -> Me
    return Me.construct(bytes: me.bytes() % other.bytes())

### The smaller of the two sizes.
### :param other: The other size.
### :returns: The smaller one.
routine ByteSize.min(other: Me) -> Me
    return Me.construct(bytes: me.bytes().min(other.bytes()))

### The larger of the two sizes.
### :param other: The other size.
### :returns: The larger one.
routine ByteSize.max(other: Me) -> Me
    return Me.construct(bytes: me.bytes().max(other.bytes()))

# -- comparison and hashing ----------------------------------------------------

### Whether the two sizes are as large.
### :param other: The size to compare with.
### :returns: True when they are as large.
routine ByteSize.eq(other: Me) -> Bool
    return me.bytes() == other.bytes()

### Three-way comparison of `me` and `other`.
### :param other: The size to compare with.
### :returns: -1, 0, or 1 as `me` is smaller, as large, or larger.
routine ByteSize.compare(other: Me) -> S32
    return me.bytes().compare(other.bytes())

### The keyed hash of the nanoseconds.
### :returns: The hash.
routine ByteSize.hash() -> U64
    return me.bytes().hash()
