@target(arch: "aarch64")
obeys UnbrokenAddable[S8], UnbrokenAddable[U8], UnbrokenAddable[S16], UnbrokenAddable[U16], UnbrokenAddable[S32], UnbrokenAddable[U32], UnbrokenAddable[S64], UnbrokenAddable[U64], UnbrokenAddable[CSize], UnbrokenAddable[CSSize]
