# -- compare and exchange --------------------------------------------------------

# The `_raw` forms write new if the value here is expected and return whether they did, storing the value that was
# here in previous either way: the shape of LLVM's cmpxchg, for code that wants the flag and the value side by side.
# The forms without `_raw` give a Maybe: None when they wrote, the value found when not.

### Writes `new` if the value here is `expected`, unbroken and sequentially consistent, and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is sequentially consistent.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} seq_cst seq_cst, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_unbroken_raw(expected: T, new: T, previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]

### Writes new if the value here is expected, unbroken and sequentially consistent: None if it did,
### the value found if not. It fails only when the value differs.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_unbroken(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_unbroken_raw(expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

### Writes `new` if the value here is `expected`, unbroken and relaxed (only unbroken), and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is relaxed.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} monotonic monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_unbroken_relaxed_raw(expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]

### Writes new if the value here is expected, unbroken and relaxed (only unbroken): None if it did,
### the value found if not. It fails only when the value differs.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_unbroken_relaxed(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_unbroken_relaxed_raw(expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

### Writes `new` if the value here is `expected`, unbroken and acquire, and returns whether it did. The value that was here is stored through `previous` either way. It fails only when the value differs. The failure order is acquire.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} acquire acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_unbroken_acquire_raw(expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]

### Writes new if the value here is expected, unbroken and acquire: None if it did,
### the value found if not. It fails only when the value differs.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_unbroken_acquire(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_unbroken_acquire_raw(expected, new, previous)
