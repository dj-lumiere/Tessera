# Tessera stdlib: unbroken values
#
# A value whose every access is unbroken is an Unbroken[T]: the type says it, and its operations are the ones below
# without the _unbroken in their names. Memory whose type the program doesn't choose (from C, shared with another
# process, a futex word) is reached per access instead, like a volatile access: the *_unbroken routines on @T next to
# peek and poke (the operation, then _unbroken: fetch_add_unbroken).
# The memory order is a type argument, a MemoryOrder: fetch_add_unbroken[RELAXED](1). A routine that names none is
# SEQ_CST. Each routine takes only the orders its operation has (a load can't release, a store can't acquire, a fence
# can't be RELAXED), and another order is a build error at the call. compare_exchange takes two, the order when it
# writes and the order when it doesn't, and the second comes from the first when it isn't written.
#
# What an Unbroken[T] can do depends on T and on the target, so each routine requires a marker concept, declared below
# per type and target: UnbrokenStorable (load, store), UnbrokenExchangeable (swap, compare_exchange: integers, bytes, and
# pointers, since LLVM's cmpxchg takes no float), AtomicAddable (fetch_add, fetch_sub: integers), AtomicMaskable
# (fetch_and, fetch_or, fetch_xor), and UnbrokenFloatAddable (fetch_fadd, fetch_fsub: B32, B64). An access wider than the
# target does lock-free is a build error, never a hidden libatomic call or interrupt masking: bare metal has no
# libatomic, a hosted one may take a lock, and masking interrupts is wrong on a multicore MCU. So 64-bit atomics
# exist on x86, AArch64, A-profile ARM, and riscv64 with A, 32-bit ones on ARMv7-M and riscv32 with A, 128-bit ones
# on x86-64 with cx16 (x86-64-v2 and up), and none on Cortex-M0 or RISC-V without A. Bool has none yet: use a U8 flag.
#
# The address must be aligned to T's size. A U64 field of a record has
# alignment 4 on some 32-bit ABIs, so put a 64-bit Unbroken[T] where it's 8-aligned there.

module System/Memory

# -- capabilities ----------------------------------------------------------------

### peek_unbroken and poke_unbroken are lock-free for T on the target.
protocol UnbrokenStorable[T]
needs T: typename

### swap_unbroken and compare_exchange_unbroken are lock-free for T on the target. Such a T is also UnbrokenStorable.
protocol UnbrokenExchangeable[T]
obeys UnbrokenStorable[T]
needs T: typename

### fetch_add_unbroken and fetch_sub_unbroken are lock-free for T on the target. Such a T is also UnbrokenStorable.
protocol UnbrokenAddable[T]
obeys UnbrokenStorable[T]
needs T: typename

### fetch_and_unbroken, fetch_or_unbroken, and fetch_xor_unbroken are lock-free for T on the target. Such a T is also
### UnbrokenStorable.
protocol UnbrokenMaskable[T]
obeys UnbrokenStorable[T]
needs T: typename

### fetch_fadd_unbroken and fetch_fsub_unbroken are lock-free for T on the target. Such a T is also UnbrokenStorable.
protocol UnbrokenFloatAddable[T]
obeys UnbrokenStorable[T]
needs T: typename

# -- what each target does lock-free --------------------------------------------

# 64 bits: x86-64 (lock-prefixed instructions), i686 (cmpxchg8b), AArch64, A-profile ARM from v6K
# (ldrexd), riscv64 with A.
@target(arch: "x86_64")
obeys UnbrokenStorable[S8], UnbrokenStorable[U8], UnbrokenStorable[S16], UnbrokenStorable[U16], UnbrokenStorable[S32], UnbrokenStorable[U32], UnbrokenStorable[S64], UnbrokenStorable[U64], UnbrokenStorable[CSize], UnbrokenStorable[CSSize], UnbrokenStorable[Byte], UnbrokenStorable[Addr], UnbrokenStorable[B32], UnbrokenStorable[B64]
@target(arch: "x86_64")
obeys UnbrokenStorable[@T] when T: typename
@target(arch: "x86_64")
obeys UnbrokenExchangeable[S8], UnbrokenExchangeable[U8], UnbrokenExchangeable[S16], UnbrokenExchangeable[U16], UnbrokenExchangeable[S32], UnbrokenExchangeable[U32], UnbrokenExchangeable[S64], UnbrokenExchangeable[U64], UnbrokenExchangeable[CSize], UnbrokenExchangeable[CSSize], UnbrokenExchangeable[Byte], UnbrokenExchangeable[Addr]
@target(arch: "x86_64")
obeys UnbrokenExchangeable[@T] when T: typename
@target(arch: "x86_64")
obeys UnbrokenAddable[S8], UnbrokenAddable[U8], UnbrokenAddable[S16], UnbrokenAddable[U16], UnbrokenAddable[S32], UnbrokenAddable[U32], UnbrokenAddable[S64], UnbrokenAddable[U64], UnbrokenAddable[CSize], UnbrokenAddable[CSSize]
@target(arch: "x86_64")
obeys UnbrokenMaskable[S8], UnbrokenMaskable[U8], UnbrokenMaskable[S16], UnbrokenMaskable[U16], UnbrokenMaskable[S32], UnbrokenMaskable[U32], UnbrokenMaskable[S64], UnbrokenMaskable[U64], UnbrokenMaskable[CSize], UnbrokenMaskable[CSSize], UnbrokenMaskable[Byte]
@target(arch: "x86_64")
obeys UnbrokenFloatAddable[B32], UnbrokenFloatAddable[B64]

@target(arch: "x86")
obeys UnbrokenStorable[S8], UnbrokenStorable[U8], UnbrokenStorable[S16], UnbrokenStorable[U16], UnbrokenStorable[S32], UnbrokenStorable[U32], UnbrokenStorable[S64], UnbrokenStorable[U64], UnbrokenStorable[CSize], UnbrokenStorable[CSSize], UnbrokenStorable[Byte], UnbrokenStorable[Addr], UnbrokenStorable[B32], UnbrokenStorable[B64]
