### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_weak_unbroken(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_weak_unbroken_raw(expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

