needs T: typename, UnbrokenExchangeable[T]

### Writes new if the value here is expected, unbroken and acquire: None if it did,
### the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_weak_unbroken_acquire(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_weak_unbroken_acquire_raw(expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

### Writes `new` if the value here is `expected`, unbroken and release, and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is relaxed.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} release monotonic, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_weak_unbroken_release_raw(expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]

### Writes new if the value here is expected, unbroken and release: None if it did,
### the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_weak_unbroken_release(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_weak_unbroken_release_raw(expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

### Writes `new` if the value here is `expected`, unbroken and acquire and release, and returns whether it did. The value that was here is stored through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop. The failure order is acquire.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} acq_rel acquire, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_weak_unbroken_acq_rel_raw(expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]

### Writes new if the value here is expected, unbroken and acquire and release: None if it did,
### the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine PointedCell[T].compare_exchange_weak_unbroken_acq_rel(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_weak_unbroken_acq_rel_raw(expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

# -- Unbroken[T] -------------------------------------------------------------------

### A value every access to which is unbroken: the type says it, where an `@T` says it only at each access. It sits at
### an address aligned to T's size, so a 64-bit one is 8-aligned on 32-bit targets too. Threads share the place
### (`@Unbroken[T]`), not copies, which would be other values. The operations and their memory orders are `@T`'s
### `*_unbroken` ones without the `_unbroken`: `peek`, `poke`, `swap`, `compare_exchange`, `fetch_add`, ..., each with
### the same order suffixes.
### :typeparam T: The value type, which the target must change as one unbroken step.
@layout(align: sizeof[T]())
record Unbroken[T]
needs T: typename, UnbrokenStorable[T]
    value: T

### An Unbroken[T] holding `value`.
### :param value: The value it starts with.
### :returns: The new value.
common routine Unbroken[T].construct(value: T) -> Me
needs T: typename, UnbrokenStorable[T]
    return Me(value)

### Releases nothing: an `Unbroken` holds no memory of its own.
routine @Unbroken[T].destruct() -> None
needs T: typename, UnbrokenStorable[T]
    return

### Reads the value unbroken, sequentially consistent.
### :returns: The value.
routine @Unbroken[T].peek() -> T
needs T: typename, UnbrokenStorable[T]
    return me.value.peek_unbroken()

### Reads the value unbroken, relaxed (only unbroken).
### :returns: The value.
routine @Unbroken[T].peek_relaxed() -> T
needs T: typename, UnbrokenStorable[T]
    return me.value.peek_unbroken_relaxed()

### Reads the value unbroken, acquire.
### :returns: The value.
routine @Unbroken[T].peek_acquire() -> T
needs T: typename, UnbrokenStorable[T]
    return me.value.peek_unbroken_acquire()

### Writes `value` unbroken, sequentially consistent.
### :param value: The value to write.
routine @Unbroken[T].poke(value: T) -> None
needs T: typename, UnbrokenStorable[T]
    me.value.poke_unbroken(value)
    return

### Writes `value` unbroken, relaxed (only unbroken).
### :param value: The value to write.
routine @Unbroken[T].poke_relaxed(value: T) -> None
needs T: typename, UnbrokenStorable[T]
    me.value.poke_unbroken_relaxed(value)
    return

### Writes `value` unbroken, release.
### :param value: The value to write.
routine @Unbroken[T].poke_release(value: T) -> None
needs T: typename, UnbrokenStorable[T]
    me.value.poke_unbroken_release(value)
    return

### Writes `value` and returns what was there, unbroken and sequentially consistent.
### :param value: The value to write.
### :returns: The value that was there before.
routine @Unbroken[T].swap(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]
    return me.value.swap_unbroken(value)

### Writes `value` and returns what was there, unbroken and relaxed (only unbroken).
### :param value: The value to write.
### :returns: The value that was there before.
routine @Unbroken[T].swap_relaxed(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]
    return me.value.swap_unbroken_relaxed(value)

### Writes `value` and returns what was there, unbroken and acquire.
### :param value: The value to write.
### :returns: The value that was there before.
routine @Unbroken[T].swap_acquire(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]
    return me.value.swap_unbroken_acquire(value)

### Writes `value` and returns what was there, unbroken and release.
### :param value: The value to write.
### :returns: The value that was there before.
routine @Unbroken[T].swap_release(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]
    return me.value.swap_unbroken_release(value)

### Writes `value` and returns what was there, unbroken and acquire and release.
### :param value: The value to write.
### :returns: The value that was there before.
routine @Unbroken[T].swap_acq_rel(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]
    return me.value.swap_unbroken_acq_rel(value)

### Writes `new` if the value is `expected`, unbroken and sequentially consistent: `None` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine @Unbroken[T].compare_exchange(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    return me.value.compare_exchange_unbroken(expected, new)

### Writes `new` if the value is `expected`, unbroken and relaxed (only unbroken): `None` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine @Unbroken[T].compare_exchange_relaxed(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    return me.value.compare_exchange_unbroken_relaxed(expected, new)

### Writes `new` if the value is `expected`, unbroken and acquire: `None` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine @Unbroken[T].compare_exchange_acquire(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    return me.value.compare_exchange_unbroken_acquire(expected, new)

### Writes `new` if the value is `expected`, unbroken and release: `None` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine @Unbroken[T].compare_exchange_release(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    return me.value.compare_exchange_unbroken_release(expected, new)

### Writes `new` if the value is `expected`, unbroken and acquire and release: `None` if it did, the value found if
### not. It fails only when the value differs.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine @Unbroken[T].compare_exchange_acq_rel(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    return me.value.compare_exchange_unbroken_acq_rel(expected, new)

### Writes `new` if the value is `expected`, unbroken and sequentially consistent: `None` if it did, the value found if
### not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
routine @Unbroken[T].compare_exchange_weak(expected: T, new: T) -> Maybe[T]
needs T: typename, UnbrokenExchangeable[T]
    return me.value.compare_exchange_weak_unbroken(expected, new)

### Writes `new` if the value is `expected`, unbroken and relaxed (only unbroken): `None` if it did, the value found if
### not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop.
