# -- load and store --------------------------------------------------------------

### Reads the T at this address unbroken, sequentially consistent.
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} seq_cst, align {sizeof T}")
routine PointedCell[T].peek_unbroken() -> T
needs T: typename, UnbrokenStorable[T]

### Reads the T at this address unbroken, relaxed (only unbroken).
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} monotonic, align {sizeof T}")
routine PointedCell[T].peek_unbroken_relaxed() -> T
needs T: typename, UnbrokenStorable[T]

### Reads the T at this address unbroken, acquire.
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} acquire, align {sizeof T}")
routine PointedCell[T].peek_unbroken_acquire() -> T
needs T: typename, UnbrokenStorable[T]

### Writes value to this address unbroken, sequentially consistent.
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} seq_cst, align {sizeof T}")
routine PointedCell[T].poke_unbroken(value: T) -> None
needs T: typename, UnbrokenStorable[T]

### Writes value to this address unbroken, relaxed (only unbroken).
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} monotonic, align {sizeof T}")
routine PointedCell[T].poke_unbroken_relaxed(value: T) -> None
needs T: typename, UnbrokenStorable[T]

### Writes value to this address unbroken, release.
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} release, align {sizeof T}")
routine PointedCell[T].poke_unbroken_release(value: T) -> None
needs T: typename, UnbrokenStorable[T]

# -- read-modify-write -----------------------------------------------------------

### Writes value and returns what was there, unbroken and sequentially consistent.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} seq_cst, align {sizeof T}")
routine PointedCell[T].swap_unbroken(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]

### Writes value and returns what was there, unbroken and relaxed (only unbroken).
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} monotonic, align {sizeof T}")
routine PointedCell[T].swap_unbroken_relaxed(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]

### Writes value and returns what was there, unbroken and acquire.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} acquire, align {sizeof T}")
routine PointedCell[T].swap_unbroken_acquire(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]

### Writes value and returns what was there, unbroken and release.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} release, align {sizeof T}")
routine PointedCell[T].swap_unbroken_release(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]

### Writes value and returns what was there, unbroken and acquire and release.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} acq_rel, align {sizeof T}")
routine PointedCell[T].swap_unbroken_acq_rel(value: T) -> T
needs T: typename, UnbrokenExchangeable[T]

### Adds value (wrapping) and returns what was there, unbroken and sequentially consistent.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} seq_cst, align {sizeof T}")
routine PointedCell[T].fetch_add_unbroken(value: T) -> T
needs T: typename, UnbrokenAddable[T]

### Adds value (wrapping) and returns what was there, unbroken and relaxed (only unbroken).
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} monotonic, align {sizeof T}")
routine PointedCell[T].fetch_add_unbroken_relaxed(value: T) -> T
needs T: typename, UnbrokenAddable[T]

### Adds value (wrapping) and returns what was there, unbroken and acquire.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} acquire, align {sizeof T}")
routine PointedCell[T].fetch_add_unbroken_acquire(value: T) -> T
needs T: typename, UnbrokenAddable[T]

