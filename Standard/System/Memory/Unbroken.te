obeys UnbrokenMaskable[S8], UnbrokenMaskable[U8], UnbrokenMaskable[S16], UnbrokenMaskable[U16], UnbrokenMaskable[S32], UnbrokenMaskable[U32], UnbrokenMaskable[S64], UnbrokenMaskable[U64], UnbrokenMaskable[CSize], UnbrokenMaskable[CSSize], UnbrokenMaskable[Byte]
