# -- memory orders ---------------------------------------------------------------

### How an unbroken access is ordered with the other memory accesses of its thread, as other threads see them. It is a
### type argument of every unbroken routine (`fetch_add_unbroken[RELAXED](1)`, `c.peek[ACQUIRE]()`), and a routine that
### names none is SEQ_CST.
choice MemoryOrder: U8
    ### Only unbroken: no order with the accesses around it.
    RELAXED
    ### No later access of this thread is moved before it, so after reading what a RELEASE write wrote, the thread sees
    ### what came before that write.
    ACQUIRE
    ### No earlier access of this thread is moved after it, so a thread that reads it with ACQUIRE sees what came
    ### before it.
    RELEASE
    ### ACQUIRE and RELEASE together, for an operation that reads and writes.
    ACQ_REL
    ### ACQ_REL, and every thread sees all the SEQ_CST operations in one order.
    SEQ_CST

# -- load and store --------------------------------------------------------------

### Reads the T at this address unbroken.
### :typeparam O: The memory order: RELAXED, ACQUIRE or SEQ_CST (a read can't release), SEQ_CST when none is given.
### :returns: The value read.
@inline
routine PointedCell[T].peek_unbroken[O]() -> T
needs T: typename, UnbrokenStorable[T], O: MemoryOrder = SEQ_CST
    if O == MemoryOrder.RELEASE or O == MemoryOrder.ACQ_REL
        build_error("you gave peek_unbroken the order {O}, and a read can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    return me.peek_unbroken_unchecked[O]()

### Reads the T at this address unbroken, with an order that isn't checked: LLVM refuses RELEASE and ACQ_REL, and
### peek_unbroken checks it first.
### :typeparam O: The memory order.
### :returns: The value read.
@external("llvm")
@template("{result} = load atomic {T}, ptr {me} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].peek_unbroken_unchecked[O]() -> T
needs T: typename, UnbrokenStorable[T], O: MemoryOrder

### Writes value to this address unbroken.
### :typeparam O: The memory order: RELAXED, RELEASE or SEQ_CST (a write can't acquire), SEQ_CST when none is given.
### :param value: The value to write.
@inline
routine PointedCell[T].poke_unbroken[O](value: T) -> None
needs T: typename, UnbrokenStorable[T], O: MemoryOrder = SEQ_CST
    if O == MemoryOrder.ACQUIRE or O == MemoryOrder.ACQ_REL
        build_error("you gave poke_unbroken the order {O}, and a write can't acquire: give it RELAXED, RELEASE or SEQ_CST")
    me.poke_unbroken_unchecked[O](value)
    return

### Writes value to this address unbroken, with an order that isn't checked: LLVM refuses ACQUIRE and ACQ_REL, and
### poke_unbroken checks it first.
### :typeparam O: The memory order.
### :param value: The value to write.
@external("llvm")
@template("store atomic {T} {value}, ptr {me} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].poke_unbroken_unchecked[O](value: T) -> None
needs T: typename, UnbrokenStorable[T], O: MemoryOrder

# -- read-modify-write -----------------------------------------------------------

### Writes value and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to write.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xchg ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].swap_unbroken[O](value: T) -> T
needs T: typename, UnbrokenExchangeable[T], O: MemoryOrder = SEQ_CST

### Adds value (wrapping) and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw add ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_add_unbroken[O](value: T) -> T
needs T: typename, UnbrokenAddable[T], O: MemoryOrder = SEQ_CST

### Subtracts value (wrapping) and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to subtract.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw sub ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_sub_unbroken[O](value: T) -> T
needs T: typename, UnbrokenAddable[T], O: MemoryOrder = SEQ_CST

### ANDs in value and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The mask to AND in.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw and ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_and_unbroken[O](value: T) -> T
needs T: typename, UnbrokenMaskable[T], O: MemoryOrder = SEQ_CST

### ORs in value and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The mask to OR in.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw or ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_or_unbroken[O](value: T) -> T
needs T: typename, UnbrokenMaskable[T], O: MemoryOrder = SEQ_CST

### XORs in value and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The mask to XOR in.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw xor ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_xor_unbroken[O](value: T) -> T
needs T: typename, UnbrokenMaskable[T], O: MemoryOrder = SEQ_CST

### Adds value and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to add.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw fadd ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_fadd_unbroken[O](value: T) -> T
needs T: typename, UnbrokenFloatAddable[T], O: MemoryOrder = SEQ_CST

### Subtracts value and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to subtract.
### :returns: The value that was there before.
@external("llvm")
@template("{result} = atomicrmw fsub ptr {me}, {T} {value} {by O|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}")
routine PointedCell[T].fetch_fsub_unbroken[O](value: T) -> T
needs T: typename, UnbrokenFloatAddable[T], O: MemoryOrder = SEQ_CST

# -- compare and exchange --------------------------------------------------------

# The `_raw` forms write new if the value here is expected and return whether they did, storing the value that was
# here in previous either way: the shape of LLVM's cmpxchg, for code that wants the flag and the value side by side.
# The forms without `_raw` give an Optional: None when they wrote, the value found when not.

### Writes `new` if the value here is `expected`, unbroken, and returns whether it did. The value that was here is stored
### through `previous` either way. It fails only when the value differs.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :typeparam S: The memory order when it writes, SEQ_CST when none is given.
### :typeparam F: The memory order when it doesn't write (it only reads then): RELAXED, ACQUIRE or SEQ_CST, and no
### stronger than S. When none is given it comes from S: ACQUIRE for ACQ_REL, RELAXED for RELEASE, S itself otherwise.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@inline
routine PointedCell[T].compare_exchange_unbroken_raw[S, F](expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]
needs S: MemoryOrder = SEQ_CST, F: MemoryOrder = if S == ACQ_REL then ACQUIRE else if S == RELEASE then RELAXED else S
    if F == MemoryOrder.RELEASE or F == MemoryOrder.ACQ_REL
        build_error("you gave compare_exchange_unbroken_raw the failure order {F}, and an exchange that doesn't write only reads, so its order can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    if S == MemoryOrder.RELAXED or S == MemoryOrder.RELEASE
        if F != MemoryOrder.RELAXED
            build_error("you gave compare_exchange_unbroken_raw the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED")
    if S == MemoryOrder.ACQUIRE or S == MemoryOrder.ACQ_REL
        if F == MemoryOrder.SEQ_CST
            build_error("you gave compare_exchange_unbroken_raw the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED or ACQUIRE")
    return me.compare_exchange_unbroken_raw_unchecked[S, F](expected, new, previous)

### compare_exchange_unbroken_raw with orders that aren't checked: LLVM refuses a failure order of RELEASE or ACQ_REL, and
### compare_exchange_unbroken_raw checks both first.
### :typeparam S: The memory order when it writes.
### :typeparam F: The memory order when it doesn't.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg ptr {me}, {T} {expected}, {T} {new} {by S|monotonic|acquire|release|acq_rel|seq_cst} {by F|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_unbroken_raw_unchecked[S, F](expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T], S: MemoryOrder, F: MemoryOrder

### Writes new if the value here is expected, unbroken: None if it did, the value found if not. It fails only when the value differs.
### :typeparam S: The memory order when it writes, SEQ_CST when none is given.
### :typeparam F: The memory order when it doesn't write (it only reads then): RELAXED, ACQUIRE or SEQ_CST, and no
### stronger than S. When none is given it comes from S: ACQUIRE for ACQ_REL, RELAXED for RELEASE, S itself otherwise.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
@inline
routine PointedCell[T].compare_exchange_unbroken[S, F](expected: T, new: T) -> Optional[T]
needs T: typename, UnbrokenExchangeable[T]
needs S: MemoryOrder = SEQ_CST, F: MemoryOrder = if S == ACQ_REL then ACQUIRE else if S == RELEASE then RELAXED else S
    if F == MemoryOrder.RELEASE or F == MemoryOrder.ACQ_REL
        build_error("you gave compare_exchange_unbroken the failure order {F}, and an exchange that doesn't write only reads, so its order can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    if S == MemoryOrder.RELAXED or S == MemoryOrder.RELEASE
        if F != MemoryOrder.RELAXED
            build_error("you gave compare_exchange_unbroken the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED")
    if S == MemoryOrder.ACQUIRE or S == MemoryOrder.ACQ_REL
        if F == MemoryOrder.SEQ_CST
            build_error("you gave compare_exchange_unbroken the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED or ACQUIRE")
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_unbroken_raw_unchecked[S, F](expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

### Writes `new` if the value here is `expected`, unbroken, and returns whether it did. The value that was here is stored
### through `previous` either way. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop.
### :typeparam T: The pointee type, which must support the operation as one unbroken step on the target.
### :typeparam S: The memory order when it writes, SEQ_CST when none is given.
### :typeparam F: The memory order when it doesn't write (it only reads then): RELAXED, ACQUIRE or SEQ_CST, and no
### stronger than S. When none is given it comes from S: ACQUIRE for ACQ_REL, RELAXED for RELEASE, S itself otherwise.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@inline
routine PointedCell[T].compare_exchange_weak_unbroken_raw[S, F](expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T]
needs S: MemoryOrder = SEQ_CST, F: MemoryOrder = if S == ACQ_REL then ACQUIRE else if S == RELEASE then RELAXED else S
    if F == MemoryOrder.RELEASE or F == MemoryOrder.ACQ_REL
        build_error("you gave compare_exchange_weak_unbroken_raw the failure order {F}, and an exchange that doesn't write only reads, so its order can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    if S == MemoryOrder.RELAXED or S == MemoryOrder.RELEASE
        if F != MemoryOrder.RELAXED
            build_error("you gave compare_exchange_weak_unbroken_raw the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED")
    if S == MemoryOrder.ACQUIRE or S == MemoryOrder.ACQ_REL
        if F == MemoryOrder.SEQ_CST
            build_error("you gave compare_exchange_weak_unbroken_raw the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED or ACQUIRE")
    return me.compare_exchange_weak_unbroken_raw_unchecked[S, F](expected, new, previous)

### compare_exchange_weak_unbroken_raw with orders that aren't checked: LLVM refuses a failure order of RELEASE or ACQ_REL, and
### compare_exchange_weak_unbroken_raw checks both first.
### :typeparam S: The memory order when it writes.
### :typeparam F: The memory order when it doesn't.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :param previous: Receives the value that was in memory.
### :returns: True when the exchange happened.
@external("llvm")
@template("{t0} = cmpxchg weak ptr {me}, {T} {expected}, {T} {new} {by S|monotonic|acquire|release|acq_rel|seq_cst} {by F|monotonic|acquire|release|acq_rel|seq_cst}, align {sizeof T}\n{t1} = extractvalue {{ {T}, i1 }} {t0}, 0\nstore {T} {t1}, ptr {previous}\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")
routine PointedCell[T].compare_exchange_weak_unbroken_raw_unchecked[S, F](expected: T, new: T,
    previous: Me) -> Bool
needs T: typename, UnbrokenExchangeable[T], S: MemoryOrder, F: MemoryOrder

### Writes new if the value here is expected, unbroken: None if it did, the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop, where it is cheaper on LL/SC machines (ARM, AArch64, RISC-V).
### :typeparam S: The memory order when it writes, SEQ_CST when none is given.
### :typeparam F: The memory order when it doesn't write (it only reads then): RELAXED, ACQUIRE or SEQ_CST, and no
### stronger than S. When none is given it comes from S: ACQUIRE for ACQ_REL, RELAXED for RELEASE, S itself otherwise.
### :param expected: The value the memory is expected to hold.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
@inline
routine PointedCell[T].compare_exchange_weak_unbroken[S, F](expected: T, new: T) -> Optional[T]
needs T: typename, UnbrokenExchangeable[T]
needs S: MemoryOrder = SEQ_CST, F: MemoryOrder = if S == ACQ_REL then ACQUIRE else if S == RELEASE then RELAXED else S
    if F == MemoryOrder.RELEASE or F == MemoryOrder.ACQ_REL
        build_error("you gave compare_exchange_weak_unbroken the failure order {F}, and an exchange that doesn't write only reads, so its order can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    if S == MemoryOrder.RELAXED or S == MemoryOrder.RELEASE
        if F != MemoryOrder.RELAXED
            build_error("you gave compare_exchange_weak_unbroken the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED")
    if S == MemoryOrder.ACQUIRE or S == MemoryOrder.ACQ_REL
        if F == MemoryOrder.SEQ_CST
            build_error("you gave compare_exchange_weak_unbroken the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED or ACQUIRE")
    previous: &T <- .hollow()

    swapped: Bool = me.compare_exchange_weak_unbroken_raw_unchecked[S, F](expected, new, previous)
    value: T = previous.load()
    if swapped
        return None()
    return value

# -- Unbroken[T] -------------------------------------------------------------------

### A value every access to which is unbroken: the type says it, where an `@T` says it only at each access. It sits at
### an address aligned to T's size, so a 64-bit one is 8-aligned on 32-bit targets too. Threads share the place
### (`@Unbroken[T]`), not copies, which would be other values. The operations and their memory orders are `@T`'s
### `*_unbroken` ones without the `_unbroken`: `peek`, `poke`, `swap`, `compare_exchange`, `fetch_add`, ..., each with
### the same MemoryOrder type arguments (`hits.fetch_add[RELAXED](1)`).
### :typeparam T: The value type, which the target must change as one unbroken step.
@layout(align: sizeof[T]())
record Unbroken[T]
needs T: record, UnbrokenStorable[T]
    value: T

### An Unbroken[T] holding `value`.
### :param value: The value it starts with.
### :returns: The new value.
common routine Unbroken[T].construct(value: T) -> Me
needs T: typename, UnbrokenStorable[T]
    return Me(value)

### Releases nothing: an `Unbroken` holds no memory of its own.
routine @Unbroken[T].destruct() -> None
needs T: typename, UnbrokenStorable[T]
    return

### Reads the value unbroken.
### :typeparam O: The memory order: RELAXED, ACQUIRE or SEQ_CST (a read can't release), SEQ_CST when none is given.
### :returns: The value.
@inline
routine @Unbroken[T].peek[O]() -> T
needs T: typename, UnbrokenStorable[T]
needs O: MemoryOrder = SEQ_CST
    if O == MemoryOrder.RELEASE or O == MemoryOrder.ACQ_REL
        build_error("you gave peek the order {O}, and a read can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    return me.value.peek_unbroken[O]()

### Writes `value` unbroken.
### :typeparam O: The memory order: RELAXED, RELEASE or SEQ_CST (a write can't acquire), SEQ_CST when none is given.
### :param value: The value to write.
@inline
routine @Unbroken[T].poke[O](value: T) -> None
needs T: typename, UnbrokenStorable[T]
needs O: MemoryOrder = SEQ_CST
    if O == MemoryOrder.ACQUIRE or O == MemoryOrder.ACQ_REL
        build_error("you gave poke the order {O}, and a write can't acquire: give it RELAXED, RELEASE or SEQ_CST")
    me.value.poke_unbroken[O](value)
    return

### Writes `value` and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to write.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].swap[O](value: T) -> T
needs T: typename, UnbrokenExchangeable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.swap_unbroken[O](value)

### Writes `new` if the value is `expected`, unbroken: `None` if it did, the value found if not. It fails only when the value differs.
### :typeparam S: The memory order when it writes, SEQ_CST when none is given.
### :typeparam F: The memory order when it doesn't write (it only reads then): RELAXED, ACQUIRE or SEQ_CST, and no
### stronger than S. When none is given it comes from S: ACQUIRE for ACQ_REL, RELAXED for RELEASE, S itself otherwise.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
@inline
routine @Unbroken[T].compare_exchange[S, F](expected: T, new: T) -> Optional[T]
needs T: typename, UnbrokenExchangeable[T]
needs S: MemoryOrder = SEQ_CST, F: MemoryOrder = if S == ACQ_REL then ACQUIRE else if S == RELEASE then RELAXED else S
    if F == MemoryOrder.RELEASE or F == MemoryOrder.ACQ_REL
        build_error("you gave compare_exchange the failure order {F}, and an exchange that doesn't write only reads, so its order can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    if S == MemoryOrder.RELAXED or S == MemoryOrder.RELEASE
        if F != MemoryOrder.RELAXED
            build_error("you gave compare_exchange the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED")
    if S == MemoryOrder.ACQUIRE or S == MemoryOrder.ACQ_REL
        if F == MemoryOrder.SEQ_CST
            build_error("you gave compare_exchange the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED or ACQUIRE")
    return me.value.compare_exchange_unbroken[S, F](expected, new)

### Writes `new` if the value is `expected`, unbroken: `None` if it did, the value found if not. It may also fail when the value matched (a spurious failure), so it belongs in a retry loop.
### :typeparam S: The memory order when it writes, SEQ_CST when none is given.
### :typeparam F: The memory order when it doesn't write (it only reads then): RELAXED, ACQUIRE or SEQ_CST, and no
### stronger than S. When none is given it comes from S: ACQUIRE for ACQ_REL, RELAXED for RELEASE, S itself otherwise.
### :param expected: The value expected.
### :param new: The value to write when it matches.
### :returns: `None` when `new` was written, the value found when not.
@inline
routine @Unbroken[T].compare_exchange_weak[S, F](expected: T, new: T) -> Optional[T]
needs T: typename, UnbrokenExchangeable[T]
needs S: MemoryOrder = SEQ_CST, F: MemoryOrder = if S == ACQ_REL then ACQUIRE else if S == RELEASE then RELAXED else S
    if F == MemoryOrder.RELEASE or F == MemoryOrder.ACQ_REL
        build_error("you gave compare_exchange_weak the failure order {F}, and an exchange that doesn't write only reads, so its order can't release: give it RELAXED, ACQUIRE or SEQ_CST")
    if S == MemoryOrder.RELAXED or S == MemoryOrder.RELEASE
        if F != MemoryOrder.RELAXED
            build_error("you gave compare_exchange_weak the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED")
    if S == MemoryOrder.ACQUIRE or S == MemoryOrder.ACQ_REL
        if F == MemoryOrder.SEQ_CST
            build_error("you gave compare_exchange_weak the failure order {F} with the success order {S}, and the failure order can't be stronger than the success order: with {S}, give it RELAXED or ACQUIRE")
    return me.value.compare_exchange_weak_unbroken[S, F](expected, new)

### Adds `value` (wrapping) and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to add.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_add[O](value: T) -> T
needs T: typename, UnbrokenAddable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_add_unbroken[O](value)

### Subtracts `value` (wrapping) and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to subtract.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_sub[O](value: T) -> T
needs T: typename, UnbrokenAddable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_sub_unbroken[O](value)

### Ands in `value` and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The mask.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_and[O](value: T) -> T
needs T: typename, UnbrokenMaskable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_and_unbroken[O](value)

### Ors in `value` and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The mask.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_or[O](value: T) -> T
needs T: typename, UnbrokenMaskable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_or_unbroken[O](value)

### Xors in `value` and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The mask.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_xor[O](value: T) -> T
needs T: typename, UnbrokenMaskable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_xor_unbroken[O](value)

### Adds `value` and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to add.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_fadd[O](value: T) -> T
needs T: typename, UnbrokenFloatAddable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_fadd_unbroken[O](value)

### Subtracts `value` and returns what was there, unbroken.
### :typeparam O: The memory order (any of the five), SEQ_CST when none is given.
### :param value: The value to subtract.
### :returns: The value that was there before.
@inline
routine @Unbroken[T].fetch_fsub[O](value: T) -> T
needs T: typename, UnbrokenFloatAddable[T]
needs O: MemoryOrder = SEQ_CST
    return me.value.fetch_fsub_unbroken[O](value)

# -- fences ----------------------------------------------------------------------

### Orders memory accesses around it across threads and cores.
### :typeparam O: The memory order: ACQUIRE, RELEASE, ACQ_REL or SEQ_CST (a RELAXED fence orders nothing), SEQ_CST when none is given.
@inline
routine fence[O]() -> None
needs O: MemoryOrder = SEQ_CST
    if O == MemoryOrder.RELAXED
        build_error("you gave fence the order RELAXED, which orders nothing: give it ACQUIRE, RELEASE, ACQ_REL or SEQ_CST")
    fence_unchecked[O]()
    return

### fence with an order that isn't checked: LLVM refuses RELAXED, and fence checks it first.
### :typeparam O: The memory order.
@external("llvm")
@template("fence {by O|monotonic|acquire|release|acq_rel|seq_cst}")
routine fence_unchecked[O]() -> None
needs O: MemoryOrder

### Orders memory accesses around it for the compiler only: against an interrupt handler on the same core, with no
### barrier instruction.
### :typeparam O: The memory order: ACQUIRE, RELEASE, ACQ_REL or SEQ_CST (a RELAXED fence orders nothing), SEQ_CST when none is given.
@inline
routine compiler_fence[O]() -> None
needs O: MemoryOrder = SEQ_CST
    if O == MemoryOrder.RELAXED
        build_error("you gave compiler_fence the order RELAXED, which orders nothing: give it ACQUIRE, RELEASE, ACQ_REL or SEQ_CST")
    compiler_fence_unchecked[O]()
    return

### compiler_fence with an order that isn't checked: LLVM refuses RELAXED, and compiler_fence checks it first.
### :typeparam O: The memory order.
@external("llvm")
@template("fence syncscope(\"singlethread\") {by O|monotonic|acquire|release|acq_rel|seq_cst}")
routine compiler_fence_unchecked[O]() -> None
needs O: MemoryOrder
