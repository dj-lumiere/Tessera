@target(arch: "riscv64")
@feature("a")
obeys UnbrokenExchangeable[@T] when T: typename
@target(arch: "riscv64")
@feature("a")
obeys UnbrokenAddable[S8], UnbrokenAddable[U8], UnbrokenAddable[S16], UnbrokenAddable[U16], UnbrokenAddable[S32], UnbrokenAddable[U32], UnbrokenAddable[S64], UnbrokenAddable[U64], UnbrokenAddable[CSize], UnbrokenAddable[CSSize]
@target(arch: "riscv64")
@feature("a")
obeys UnbrokenMaskable[S8], UnbrokenMaskable[U8], UnbrokenMaskable[S16], UnbrokenMaskable[U16], UnbrokenMaskable[S32], UnbrokenMaskable[U32], UnbrokenMaskable[S64], UnbrokenMaskable[U64], UnbrokenMaskable[CSize], UnbrokenMaskable[CSSize], UnbrokenMaskable[Byte]
@target(arch: "riscv64")
@feature("a")
obeys UnbrokenFloatAddable[B32], UnbrokenFloatAddable[B64]

@target(arch: "arm")
@feature("armv6kz")
obeys UnbrokenStorable[S8], UnbrokenStorable[U8], UnbrokenStorable[S16], UnbrokenStorable[U16], UnbrokenStorable[S32], UnbrokenStorable[U32], UnbrokenStorable[S64], UnbrokenStorable[U64], UnbrokenStorable[CSize], UnbrokenStorable[CSSize], UnbrokenStorable[Byte], UnbrokenStorable[Addr], UnbrokenStorable[B32], UnbrokenStorable[B64]
