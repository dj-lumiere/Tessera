# -- byte ------------------------------------------------------------------------

### Reinterprets the bits of `me` as a `Byte`.
### :returns: The same 8 bits as a `Byte`.
routine S8.bits() -> Byte
    r: Byte = bitcast[Me, Byte](me)
    return r
