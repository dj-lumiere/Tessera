routine S8.to[S64]() -> S64
    r: S64 = sext[Me, S64](me)
    return r

### Sign-extends `me` to `S128`. Every `S8` value fits, so this never fails.
### :returns: The same numeric value as an `S128`.
routine S8.to[S128]() -> S128
    r: S128 = sext[Me, S128](me)
    return r

### Sign-extends `me` to `S256`. Every `S8` value fits, so this never fails.
### :returns: The same numeric value as an `S256`.
routine S8.to[S256]() -> S256
    r: S256 = sext[Me, S256](me)
    return r

### Converts `me` to `U8`.
### :returns: The same numeric value as a `U8`.
### :throws: Throws `IntegerOverflowError` when the value does not fit in `U8`.
failable routine S8.to[U8]() -> U8
    if not (me >= 0)
        throw IntegerOverflowError()
    r: U8 = bitcast[Me, U8](me)
    return r

### Converts `me` to `U8`, keeping the low 8 bits (modulo 2^8).
### :returns: `me` modulo 2^8, as a `U8`.
routine S8.to_wrap[U8]() -> U8
    r: U8 = bitcast[Me, U8](me)
    return r

### Converts `me` to `U8`, saturating at the ends of `U8`'s range.
### :returns: `me` clamped to `U8.MIN ..= U8.MAX`.
routine S8.to_clamp[U8]() -> U8
    at_least: Me = smax[Me](me, 0)
    r: U8 = bitcast[Me, U8](at_least)
    return r

