# Tessera stdlib: the crashables of arithmetic, collections, emitters, and broken contracts
#
# The routines that fail on a value the caller can test for (an addition that overflows, a conversion to a type that
# can't hold the value, an index past the end, an emitter past its last item) are failable and throw one of these. A
# bare call that fails stops the program on its line, as a crash would, and `try` in front of the call gives `None`
# instead: `try a + b`, `try x.to[U8]()`, `try list.getitem(i)`. A routine that isn't failable throws one of these when
# its caller breaks its contract (an index past the end of an Items, unwrap of None), which stops the program there.
# Each holds a few numbers at most, so a `Check` or an `Optional` of them stays one small value.

module System

### An integer result that doesn't fit its type: a sum, a difference, a product, a power, a negation.
crashable IntegerOverflowError
    nothing

### A float conversion whose finite value rounds to an infinity in the narrower type.
crashable NumericOverflowError
    nothing

### A number that isn't a Unicode scalar value: above 0x10FFFF, or a surrogate in 0xD800 ..= 0xDFFF.
crashable NotAScalarError
    ### The number asked for.
    value: U32

### A division or a remainder by zero.
crashable DivisionByZeroError
    nothing

### An integer power with a negative exponent, which is a fraction.
crashable NegativeExponentError
    nothing

### An index outside the elements a collection or a view holds.
crashable IndexOutOfBoundsError
    ### The index asked for.
    index: U64
    ### How many elements there are.
    count: U64

### A value asked of something that has none: an emitter past its last item, the last element of an empty list.
crashable AbsentValueError
    nothing

### A key a dict doesn't hold.
crashable KeyNotFoundError
    nothing

### A numeric operation with no result for its argument, such as ilog2 of 0, the square root of a negative number, or a
### float operation whose result is NaN.
crashable NumericDomainError
    nothing

### A value outside what a routine accepts, such as clamp with min > max, or a value used in a state that rules it
### out (memory given back, a channel closed already).
crashable UnacceptedValueError
    ### What is wrong with the value, in a sentence.
    description: @[Byte]

### The operating system didn't start a thread.
crashable TaskSpawnError
    nothing

### A range walked with a step of 0, held in a value: it never moves, so it would never reach its end.
crashable RangeStepZeroError
    nothing

### A state the code rules out was reached: a bug in the code.
crashable LogicBreachedError
    nothing

### Lines that aren't written yet: `todo` throws it, naming the routine and the block.
crashable NotImplementedError
    ### What isn't written yet, in a sentence.
    description: @[Byte]

### A bitmask converted to a flags type with a bit on that is no member's.
crashable UnknownBitsError
    ### The bits that are on and that no member has.
    bits: U64
    ### The flags type's name.
    target: @[Byte]

### Writes `Integer overflow: value does not fit in the target type.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine IntegerOverflowError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("Integer overflow: value does not fit in the target type.")
    return

### Writes `The result is out of the float type's range: it would be infinite.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NumericOverflowError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The result is out of the float type's range: it would be infinite.")
    return

### Writes which number was asked for and that it isn't a Unicode scalar value.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NotAScalarError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.value} is not a Unicode scalar value: it is above 0x10FFFF or a surrogate.")
    return

### Writes `The bits 64 are on, and no member of CellMarks has them.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine UnknownBitsError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The bits {me.bits} are on, and no member of {me.target} has them.")
    return

### Writes `You tried to divide by zero, which is not allowed.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine DivisionByZeroError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("You tried to divide by zero, which is not allowed.")
    return

### Writes `A negative exponent makes the power a fraction, which an integer can't hold.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NegativeExponentError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("A negative exponent makes the power a fraction, which an integer can't hold.")
    return

### Writes which index was asked for and how many elements there are.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine IndexOutOfBoundsError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    if me.count == 0
        out.write("Index {me.index} is out of bounds: the collection is empty.")
        return
    out.write("Index {me.index} is out of bounds for {me.count} elements.")
    return

### Writes `Attempted to access a value that is absent.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine AbsentValueError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("Attempted to access a value that is absent.")
    return

### Writes `Key not found.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine KeyNotFoundError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("Key not found.")
    return

### Writes `The operation has no result for this value.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NumericDomainError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The operation has no result for this value.")
    return

### Writes the description.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine UnacceptedValueError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.description}")
    return

### Writes `Failed to spawn a threaded task.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine TaskSpawnError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("Failed to spawn a threaded task.")
    return

### Writes that the range's step is zero and which steps move.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine RangeStepZeroError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("This range's step is zero, so it would never reach its end. Give it a step that moves: a positive step counts up, a negative one counts down (`10 to 0 by -1`).")
    return

### Writes `A logic breach was detected.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine LogicBreachedError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("A logic breach was detected.")
    return

### Writes the description for a `todo`: `routine 'parse' is not written yet`, or `block 'retry' of routine 'parse'
### is not written yet` for a `todo` in a named block.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NotImplementedError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("{me.description}")
    return
