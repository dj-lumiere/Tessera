# Tessera stdlib collection: ArrayIter[T, COUNT]
#
# Forward iterator over a fixed-size Array[T, COUNT] held behind a pointer.
# The count N is computed once at construction via sizeof division and stored
# in the record so emit() never needs generic arithmetic.
#
# Satisfies concept SlotIterator[T, ArrayIter[T, COUNT]] (and so Iterator).

module Standard/System

### A forward iterator over an {Array[T, COUNT]} held behind a pointer. The count `COUNT` is stored once at construction, and the array must outlive the iterator.
### :typeparam T: The element type.
### :typeparam COUNT: The number of elements.
record ArrayIter[T, COUNT]
obeys SlotIterator[T, ArrayIter[T, COUNT]]
needs T: typename, COUNT: U64
    data: @T  # bitcast of the original @Array[T, COUNT]
    index: U64
    count: U64  # = COUNT, resolved at monomorphisation

### Creates an iterator positioned before the first element of `arr`.
### :param arr: The array to walk.
### :returns: A new iterator at index `0`.
common routine ArrayIter[T, COUNT].construct(arr: @Array[T, COUNT]) -> Me
needs T: typename, COUNT: U64
    data: @T = bitcast[@Array[T, COUNT], @T](arr)
    iter: Me = Me(data: data, index: 0, count: COUNT)
    return iter

### Yields the next element and advances the iterator.
### :returns: The next element, in index order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @ArrayIter[T, COUNT].emit() -> T
needs T: typename, COUNT: U64
    index: U64 = me.index.peek()

    count: U64 = me.count.peek()
    if index >= count
        throw AbsentValueError()
    data: @T = me.data.peek()
    value: T = data.stride(index).peek()
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the iterator.
### :returns: The address of the next element, in index order.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @ArrayIter[T, COUNT].next() -> @T
needs T: typename, COUNT: U64
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = me.data.peek().stride(index)
    return element
