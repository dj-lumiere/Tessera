# Tessera stdlib: BF16 — 16-bit bfloat16 (B32's exponent, 7-bit mantissa)
#
# Maps to LLVM IR bfloat. x86 has no BF16 arithmetic, so LLVM computes in B32
# and rounds. The conversions call compiler-rt, which the builder links.

module Standard/System

### A 16-bit bfloat16 floating-point number, mapped to LLVM `bfloat`: B32's 8-bit exponent with a 7-bit stored mantissa.
### It keeps B32's range (finite magnitudes up to about 3.4e38) with an 8-bit significand (2 to 3 significant decimal digits).
### :note: Targets without BF16 arithmetic (x86) compute in B32 and round back. The math functions are correctly rounded:
###     most are ports of CORE-MATH's bfloat16 functions (`Standard/System/Numerics/BF16/`), and the few that are faster through B32's
###     CORE-MATH ports go through B32 and round once (`Standard/System/Numerics/BF16/ThroughB32.te`).
### :see: {B16} for more precision in a smaller range.
@llvm("bfloat")
record BF16
obeys Equatable[BF16], Comparable[BF16], Hashable[BF16]
obeys Numeric[BF16], Divisible[BF16], Negatable[BF16]
obeys UncheckedArithmetic[BF16]
    nothing

# -- runtime support ---------------------------------------------------------

# x86 has no BF16 arithmetic, so LLVM computes in B32 and narrows the result by
# calling these compiler-rt routines. The Windows builds of compiler-rt lack
# them, so the stdlib provides them under their C names.

### Windows-only replacement for compiler-rt's `__truncsfbf2`, exported under that name: narrows B32 to BF16, rounding to nearest (ties to even).
### :param x: The B32 to narrow.
### :returns: The nearest BF16.
### :note: LLVM calls it on x86 to round BF16 arithmetic computed in B32. The Windows compiler-rt lacks it.
@export("__truncsfbf2")
@target(os: "windows")
secret routine export_truncsfbf2(x: B32) -> BF16
    r: BF16 = x.to_unchecked[BF16]()
    return r

### Windows-only replacement for compiler-rt's `__truncdfbf2`, exported under that name: narrows B64 to BF16, rounding once to nearest (ties to even).
### :param x: The B64 to narrow.
### :returns: The nearest BF16.
@export("__truncdfbf2")
@target(os: "windows")
secret routine export_truncdfbf2(x: B64) -> BF16
    r: BF16 = x.to_unchecked[BF16]()
    return r

# -- arithmetic ----------------------------------------------------------------

### Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
### :returns: `|me|`.
routine BF16.abs() -> Me
    r: Me = fabs[Me](me)
    return r

### The smaller value, or the other one if one operand is NaN. Computed in B32, which is exact.
### :param other: The value to compare with.
### :returns: The smaller of `me` and `other`, NaN only when both are NaN.
routine BF16.min(other: Me) -> Me
    smaller: B32 = me.to[B32]().min(other.to[B32]())
    r: Me = smaller.to_unchecked[Me]()  # via B32 (exact)
    return r

### The larger value, or the other one if one operand is NaN. Computed in B32, which is exact.
### :param other: The value to compare with.
### :returns: The larger of `me` and `other`, NaN only when both are NaN.
routine BF16.max(other: Me) -> Me
    larger: B32 = me.to[B32]().max(other.to[B32]())
    r: Me = larger.to_unchecked[Me]()  # via B32 (exact)
    return r

### Adds `other` to `me`, rounded to nearest (ties to even).
### :param other: The value to add.
### :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine BF16.add_unchecked(other: Me) -> Me
    r: Me = fadd[Me](me, other)
    return r

### Subtracts `other` from `me`, rounded to nearest (ties to even).
### :param other: The value to subtract.
### :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine BF16.sub_unchecked(other: Me) -> Me
    r: Me = fsub[Me](me, other)
    return r

### Multiplies `me` by `other`, rounded to nearest (ties to even).
### :param other: The factor.
### :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine BF16.mul_unchecked(other: Me) -> Me
    r: Me = fmul[Me](me, other)
    return r

# -- comparisons ---------------------------------------------------------------

### Whether `me` is less than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.lt(other: Me) -> Bool
    return flt[Me](me, other)

### Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.le(other: Me) -> Bool
    return fle[Me](me, other)

### Whether `me` is greater than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.gt(other: Me) -> Bool
    return fgt[Me](me, other)

### Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.ge(other: Me) -> Bool
    return fge[Me](me, other)

# -- division ------------------------------------------------------------------

### Divides `me` by `other`, rounded to nearest (ties to even).
### :param other: The divisor.
### :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine BF16.truediv_unchecked(other: Me) -> Me
    r: Me = fdiv[Me](me, other)
    return r

# -- equality, ordering, hashing -----------------------------------------------

### IEEE equality.
### :param other: The value to compare against.
### :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine BF16.eq(other: Me) -> Bool
    return feq[Me](me, other)

### Three-way comparison for the `Comparable` conformance.
### :param other: The value to compare against.
### :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
### :see: {BF16.total_compare} for a total order that ranks NaN and the signed zeros.
routine BF16.compare(other: Me) -> S32
    if me < other
        return -1
    if me > other
        return 1
    return 0

### Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
### :returns: The 64-bit hash.
### :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine BF16.hash() -> U64
    h: U64 = siphash24(value: me.bits().to[U64](), key: hash_key())
    return h

# -- named widening conversion -------------------------------------------------

### Widens to B64, exactly.
### :returns: The same value as a B64. Every BF16 is representable.
routine BF16.to[B64]() -> B64
    result: B64 = fpext[Me, B64](me)
    return result

# ============================================================
# Rust-level operations
# ============================================================

# -- constants ------------------------------------------------------------------

### The largest finite BF16, about 3.3895314e38 (bits `0x7F7F`).
preset BF16.MAX:          BF16 = BF16.from_bits(0x7F7F)  # largest finite value
### The most negative finite BF16, the negation of `BF16.MAX` (bits `0xFF7F`).
preset BF16.MIN:          BF16 = BF16.from_bits(0xFF7F)  # most negative finite value
### The smallest positive normal BF16, 2^-126, about 1.1754944e-38 (bits `0x0080`). Subnormal values go below it.
preset BF16.MIN_POSITIVE: BF16 = BF16.from_bits(0x0080)  # smallest positive normal value
### The gap between 1.0 and the next larger BF16, 2^-7, 0.0078125 (bits `0x3C00`).
preset BF16.EPSILON:      BF16 = BF16.from_bits(0x3C00)  # the gap between 1.0 and the next value

### Pi, rounded to the nearest BF16.
preset BF16.PI: BF16 = 3.14159265358979323846264338327950288  # pi
### Tau (2 pi), one full turn in radians, rounded to the nearest BF16.
preset BF16.TAU: BF16 = 6.28318530717958647692528676655900577  # 2 pi
### Euler's number e, rounded to the nearest BF16.
preset BF16.E: BF16 = 2.71828182845904523536028747135266250  # Euler's number
### Pi / 2, rounded to the nearest BF16.
preset BF16.FRAC_PI_2: BF16 = 1.57079632679489661923132169163975144  # pi / 2
### Pi / 4, rounded to the nearest BF16.
preset BF16.FRAC_PI_4: BF16 = 0.785398163397448309615660845819875721  # pi / 4
### 1 / pi, rounded to the nearest BF16.
preset BF16.FRAC_1_PI: BF16 = 0.318309886183790671537767526745028724  # 1 / pi
### The square root of 2, rounded to the nearest BF16.
preset BF16.SQRT_2: BF16 = 1.41421356237309504880168872420969808  # sqrt(2)
### 1 / sqrt(2), rounded to the nearest BF16.
preset BF16.FRAC_1_SQRT_2: BF16 = 0.707106781186547524400844362104849039  # 1 / sqrt(2)
### The natural logarithm of 2, rounded to the nearest BF16.
preset BF16.LN_2: BF16 = 0.693147180559945309417232121458176568  # ln(2)
### The natural logarithm of 10, rounded to the nearest BF16.
preset BF16.LN_10: BF16 = 2.30258509299404568401799145468436421  # ln(10)
### Log2(e), rounded to the nearest BF16.
preset BF16.LOG2_E: BF16 = 1.44269504088896340735992468100189214  # log2(e)
### Log10(e), rounded to the nearest BF16.
preset BF16.LOG10_E: BF16 = 0.434294481903251827651128918916605082  # log10(e)

# -- sign ----------------------------------------------------------------------

### Flips the sign bit, exactly.
### :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine BF16.neg() -> Me
    r: Me = fneg[Me](me)
    return r

### The magnitude of `me` with the sign of `sign`, exactly.
### :param sign: The value whose sign bit is taken.
### :returns: `|me|` with the sign bit of `sign`.
routine BF16.copysign(sign: Me) -> Me
    r: Me = copysign[Me](mag: me, sign)
    return r

### The sign of `me` as a number.
### :returns: 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine BF16.signum() -> Me
    is_nan: Bool = me.is_nan()
    unit: Me = copysign[Me](mag: 1.0, sign: me)
    r: Me = when
        is_nan => me
        else => unit
    return r

### Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
### :returns: Whether the sign bit is clear.
routine BF16.is_sign_positive() -> Bool
    bits: S16 = me.bits().to_wrap[S16]()
    return bits >= 0

### Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
### :returns: Whether the sign bit is set.
routine BF16.is_sign_negative() -> Bool
    bits: S16 = me.bits().to_wrap[S16]()
    return bits < 0

# -- arithmetic ----------------------------------------------------------------

### The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact: B32's remainder of the same
### values is a BF16.
### :param other: The divisor.
### :returns: `me - q * other` for `q` the quotient rounded toward zero. NaN when `other` is 0 or `me` is infinite.
routine BF16.mod_trunc_unchecked(other: Me) -> Me
    remainder: B32 = me.to[B32]().mod_trunc_unchecked(other.to[B32]())
    r: Me = remainder.to_unchecked[Me]()
    return r

### The reciprocal `1 / me`, rounded once.
### :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine BF16.recip_unchecked() -> Me
    r: Me = fdiv[Me](1.0, me)
    return r

### `me * a + b`, rounded once. The product of two 8-bit significands is exact in B64. The sum is added with
### round-to-odd ({b64_add_round_to_odd}), which the narrowing then rounds as it would the exact result.
### :param a: The factor to multiply `me` by.
### :param b: The addend.
### :returns: `me * a + b`, correctly rounded.
routine BF16.mul_add_unchecked(a: Me, b: Me) -> Me
    product: B64 = me.to[B64]() *! a.to[B64]()
    sum: B64 = b64_add_round_to_odd(a: product, b: b.to[B64]())
    r: Me = sum.to_unchecked[Me]()
    return r

### The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
### :param other: The divisor.
### :returns: The truncated quotient, moved one step down (for a positive `other`) or up when the remainder is negative.
routine BF16.floordiv_unchecked(other: Me) -> Me
    q: Me = me.truediv_unchecked(other).trunc()
    rem: Me = me.mod_trunc_unchecked(other)
    if not (rem < 0.0)
        return q
    positive_divisor: Bool = other > 0.0
    down: Me = q -! 1.0
    up: Me = q +! 1.0
    r: Me = when
        positive_divisor => down
        else => up
    return r

### The least non-negative remainder of `me / other`.
### :param other: The divisor.
### :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
###     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine BF16.mod_unchecked(other: Me) -> Me
    rem: Me = me.mod_trunc_unchecked(other)
    if not (rem < 0.0)
        return rem
    magnitude: Me = other.abs()
    r: Me = rem +! magnitude
    # a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
    # one in range
    if r == magnitude and magnitude.is_finite()
        return Me.from_bits(magnitude.bits() - 1)
    return r

# -- ordering ------------------------------------------------------------------

### The smaller value, NaN if either is NaN, and -0.0 below +0.0 (IEEE 754 minimum).
### :param other: The value to compare with.
### :returns: The smaller of `me` and `other`.
routine BF16.minimum(other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me +! other
    # equal values have equal bits except ±0, where bitor picks the negative one
    if me == other
        return Me.from_bits(me.bits() | other.bits())
    pick: Bool = me < other
    r: Me = when
        pick => me
        else => other
    return r

### The larger value, NaN if either is NaN, and +0.0 above -0.0 (IEEE 754 maximum).
### :param other: The value to compare with.
### :returns: The larger of `me` and `other`.
routine BF16.maximum(other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me +! other
    # equal values have equal bits except ±0, where bitand picks the positive one
    if me == other
        return Me.from_bits(me.bits() & other.bits())
    pick: Bool = me > other
    r: Me = when
        pick => me
        else => other
    return r

### Restricts `me` to `lo ..= hi`. NaN stays NaN.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` when `me < lo`, `hi` when `me > hi`, else `me`.
### :throws: Crashes with `UnacceptedValueError` unless `lo <= hi` (so also when either bound is NaN).
@track_caller
routine BF16.clamp(lo: Me, hi: Me) -> Me
    if lo <= hi
        below: Bool = me < lo
        above: Bool = me > hi
        upper: Me = when
            above => hi
            else => me
        r: Me = when
            below => lo
            else => upper
        return r
    throw UnacceptedValueError(description: "The value is not one the routine accepts.")

### Orders by IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
### :param other: The value to compare with.
### :returns: -1, 0, or 1 as `me` is below, equal to, or above `other` in that order.
routine BF16.total_compare(other: Me) -> S32
    a: S16 = me.bits().to_wrap[S16]()
    b: S16 = other.bits().to_wrap[S16]()
    # Flipping every bit but the sign of negative values makes the bits order like signed integers.
    a_key: S16 = a ^ ((a >> 15) & S16.MAX)
    b_key: S16 = b ^ ((b >> 15) & S16.MAX)
    r: S32 = a_key.compare(b_key)
    return r

# -- rounding ------------------------------------------------------------------

### Rounds toward negative infinity by widening to B32, rounding there, and narrowing back (exact).
### :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
routine BF16.floor() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.floor().to_unchecked[Me]()
    return r

### Rounds toward positive infinity by widening to B32, rounding there, and narrowing back (exact).
### :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine BF16.ceil() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.ceil().to_unchecked[Me]()
    return r

### Rounds to the nearest integer, half-way cases away from zero, through B32 (exact).
### :returns: The rounded value. Zeros, infinities and NaN come back unchanged.
routine BF16.round() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.round().to_unchecked[Me]()
    return r

### Rounds to the nearest integer, half-way cases to the even neighbor, through B32 (exact).
### :returns: The rounded value. Zeros, infinities and NaN come back unchanged.
routine BF16.round_ties_even() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.round_ties_even().to_unchecked[Me]()
    return r

### Rounds toward zero, through B32 (exact).
### :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
routine BF16.trunc() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.trunc().to_unchecked[Me]()
    return r

### `me` minus its integer part, with the sign of `me`.
### :returns: `me - me.trunc()`, NaN for an infinity or NaN.
routine BF16.fract() -> Me
    whole: Me = me.trunc()
    r: Me = me -! whole
    return r

# -- powers --------------------------------------------------------------------

### `me` raised to an integer power, correctly rounded. The B64 power (`n` converts exactly) rounds correctly to
### BF16 unless it lands exactly on a BF16 midpoint. There the B128 power decides (checked for every x and n that
### reach it).
### :param n: The exponent.
### :returns: `me` to the power `n`.
routine BF16.powi_unchecked(n: S32) -> Me
    r: B64 = me.to[B64]().powf_unchecked(n.to[B64]())
    if bf16_is_on_midpoint(r)
        r2: B128 = me.to[B128]().powf_unchecked(n.to[B128]())
        return r2.to_unchecked[Me]()
    return r.to_unchecked[Me]()

### The logarithm with an arbitrary base, ln(`me`) / ln(`base`), correctly rounded to BF16. The quotient of the two
### correctly rounded B64 logarithms is within about 2^-51 of the true value, so it rounds to BF16 correctly unless it
### lies within 2^-36 of a BF16 midpoint. There both logarithms and the quotient are taken again in B128.
### :param base: The base of the logarithm.
### :returns: log base `base` of `me`, NaN for a negative `me` or `base` and for base 1, ±inf or ±0 where the
###     logarithms are infinite or zero.
### :note: No result is exactly a BF16 midpoint: that would take x^(2^e) = base^m with an odd m of 9 bits, which
###     8-bit significands and exponents within ±133 rule out, so the B128 quotient decides every case it gets. A scan
###     of every pair of positive finite inputs found two quotients in the band, both rounded the same in B128.
routine BF16.log_unchecked(base: Me) -> Me
    num: B64 = me.to[B64]().ln_unchecked()
    den: B64 = base.to[B64]().ln_unchecked()
    wide: B64 = num /! den
    if bf16_is_near_midpoint(wide)
        num2: B128 = me.to[B128]().ln_unchecked()
        den2: B128 = base.to[B128]().ln_unchecked()
        return (num2 /! den2).to_unchecked[Me]()
    return wide.to_unchecked[Me]()

# -- trigonometry --------------------------------------------------------------

# -- special functions ---------------------------------------------------------

### Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to BF16).
### :returns: `me` in degrees, rounded once.
routine BF16.to_degrees_unchecked() -> Me
    r: Me = me *! 57.2957795130823208767981548141051703
    return r

### Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to BF16).
### :returns: `me` in radians, rounded once.
routine BF16.to_radians() -> Me
    r: Me = me *! 0.0174532925199432957692369076848861271
    return r

# -- rounding from wider results -------------------------------------------------
#
# powi and log(base:) compute in B64 (and in B128 near a tie) and round once to BF16. That rounding is correct
# unless the wide result lies on or near a BF16 midpoint, which these two test for.

### Whether the normal B64 `r` is within 2^16 of its own units (2^-36 relative) of a BF16 midpoint.
### :param r: The B64 result to test.
### :returns: `true` near a midpoint. Zeros, infinities, NaN, and values below BF16's normal range give `false`.
secret routine bf16_is_near_midpoint(r: B64) -> Bool
    a: B64 = r.abs()
    if not (a.is_finite() and a >= 0x1p-126)
        return false
    low: U64 = a.bits() & 0x1FFFFFFFFFFF
    distance: U64 = low.abs_diff(0x100000000000)
    return distance <= 0x10000

### Whether `r` lies exactly between two BF16 values, normal or subnormal.
### :param r: The B64 result to test.
### :returns: `true` on a BF16 midpoint.
secret routine bf16_is_on_midpoint(r: B64) -> Bool
    a: B64 = r.abs()

    if a < 0x1p-126
        # BF16 keeps 7 fraction bits: a midpoint has bit 44 set and nothing below it.
        # Below 2^-126 BF16's quantum is 2^-133: a midpoint is an odd multiple of 2^-134.
        t: B64 = a *! 0x1p134
        whole: Bool = t.trunc() == t
        odd: Bool = t.mod_trunc_unchecked(2.0) == 1.0
        return whole and odd
    low: U64 = a.bits() & 0x1FFFFFFFFFFF
    return a.is_finite() and low == 0x100000000000

# -- classification ------------------------------------------------------------

### Whether `me` is NaN, quiet or signaling.
### :returns: True for NaN, the only value unordered with itself.
routine BF16.is_nan() -> Bool
    return funo[Me](me, me)

### Whether `me` is +inf or -inf.
### :returns: True for either infinity, false for NaN and finite values.
routine BF16.is_infinite() -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude == inf

### Whether `me` is neither infinite nor NaN.
### :returns: True for zeros, subnormals and normal values.
routine BF16.is_finite() -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude < inf

### Whether `me` is a normal value: not zero, subnormal, infinite, or NaN.
### :returns: True when the exponent field is neither all zeros nor all ones.
routine BF16.is_normal() -> Bool
    exponent: U16 = me.bits() & 0x7F80
    return exponent != 0 and exponent != 0x7F80

### Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `BF16.MIN_POSITIVE`.
### :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine BF16.is_subnormal() -> Bool
    bits: U16 = me.bits()
    exponent: U16 = bits & 0x7F80
    mantissa: U16 = bits & 0x007F
    return exponent == 0 and mantissa != 0

# -- bits ----------------------------------------------------------------------

### The raw IEEE 754 bfloat16 bits.
### :returns: The encoding: sign bit at the top, then the exponent field, then the fraction.
routine BF16.bits() -> U16
    r: U16 = bitcast[Me, U16](me)
    return r

### Reinterprets raw IEEE 754 bfloat16 bits as a BF16, exactly.
### :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
### :returns: The value with that encoding. NaN payloads are kept.
### :see: {BF16.bits} for the inverse.
common routine BF16.from_bits(bits: U16) -> Me
    r: Me = bitcast[U16, Me](bits)
    return r

# -- float conversions -----------------------------------------------------------

### Narrows to B16, rounding once to nearest (ties to even). {BF16.to_unchecked[B16]} gives an infinity instead of failing.
### :returns: The nearest B16. An infinity stays infinite, and NaN stays NaN.
### :throws: Throws `NumericOverflowError` when `me` is finite and rounds past B16's range.
failable routine BF16.to[B16]() -> B16
    r: B16 = me.to_unchecked[B16]()
    if r.is_infinite() and me.is_finite()
        throw NumericOverflowError()
    return r

### Converts to B16 by widening to B32 exactly and rounding once to nearest (ties to even).
### A finite value past B16's range gives an infinity here, where {BF16.to[B16]} fails.
### :returns: The nearest B16: infinity above B16's range (65504), a subnormal or zero for tiny values, NaN for NaN.
routine BF16.to_unchecked[B16]() -> B16
    wide: B32 = me.to[B32]()
    r: B16 = wide.to_unchecked[B16]()
    return r

### The identity conversion, so generic code can call `to[T]()` when `T` is BF16.
### :returns: `me` unchanged.
routine BF16.to[Me]() -> Me
    return me

### Widens to B32, exactly: BF16 is the upper half of a B32 encoding.
### :returns: The same value as a B32.
routine BF16.to[B32]() -> B32
    r: B32 = fpext[Me, B32](me)
    return r

# -- integer conversions ---------------------------------------------------------
#
# to[int] rounds toward zero and throws IntegerOverflowError on NaN or a value out
# of the integer's range (try gives None), and to_clamp[int] saturates (NaN gives
# 0).

### Converts to S8, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127].
### :see: {BF16.to_clamp[S8]} to saturate.
failable routine BF16.to[S8]() -> S8
    if not me.is_trunc_in_range(lo: -128.0, hi: 128.0)
        throw IntegerOverflowError()
    r: S8 = fptosi_sat[Me, S8](me)
    return r

### Converts to S8, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[S8]} with try in front to detect values that do not fit.
routine BF16.to_clamp[S8]() -> S8
    r: S8 = fptosi_sat[Me, S8](me)
    return r

### Converts to S16, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767].
### :see: {BF16.to_clamp[S16]} to saturate.
failable routine BF16.to[S16]() -> S16
    if not me.is_trunc_in_range(lo: -32768.0, hi: 32768.0)
        throw IntegerOverflowError()
    r: S16 = fptosi_sat[Me, S16](me)
    return r

### Converts to S16, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[S16]} with try in front to detect values that do not fit.
routine BF16.to_clamp[S16]() -> S16
    r: S16 = fptosi_sat[Me, S16](me)
    return r

### Converts to S32, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1].
### :see: {BF16.to_clamp[S32]} to saturate.
failable routine BF16.to[S32]() -> S32
    if not me.is_trunc_in_range(lo: -2147483648.0, hi: 2147483648.0)
        throw IntegerOverflowError()
    r: S32 = fptosi_sat[Me, S32](me)
    return r

### Converts to S32, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-2^31, 2^31 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[S32]} with try in front to detect values that do not fit.
routine BF16.to_clamp[S32]() -> S32
    r: S32 = fptosi_sat[Me, S32](me)
    return r

### Converts to S64, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1].
### :see: {BF16.to_clamp[S64]} to saturate.
failable routine BF16.to[S64]() -> S64
    if not me.is_trunc_in_range(lo: -9223372036854775808.0, hi: 9223372036854775808.0)
        throw IntegerOverflowError()
    r: S64 = fptosi_sat[Me, S64](me)
    return r

### Converts to S64, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-2^63, 2^63 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[S64]} with try in front to detect values that do not fit.
routine BF16.to_clamp[S64]() -> S64
    r: S64 = fptosi_sat[Me, S64](me)
    return r

### Converts to S128, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
### :see: {BF16.to_clamp[S128]} to saturate.
failable routine BF16.to[S128]() -> S128
    if not me.is_trunc_in_range(lo: -170141183460469231731687303715884105728.0,
        hi: 170141183460469231731687303715884105728.0)
        throw IntegerOverflowError()
    r: S128 = fptosi_sat[Me, S128](me)
    return r

### Converts to S128, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-2^127, 2^127 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[S128]} with try in front to detect values that do not fit.
routine BF16.to_clamp[S128]() -> S128
    r: S128 = fptosi_sat[Me, S128](me)
    return r

### Converts to U8, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 255].
### :see: {BF16.to_clamp[U8]} to saturate.
failable routine BF16.to[U8]() -> U8
    if not me.is_trunc_in_range(lo: 0.0, hi: 256.0)
        throw IntegerOverflowError()
    r: U8 = fptoui_sat[Me, U8](me)
    return r

### Converts to U8, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 255]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[U8]} with try in front to detect values that do not fit.
routine BF16.to_clamp[U8]() -> U8
    r: U8 = fptoui_sat[Me, U8](me)
    return r

### Converts to U16, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 65535].
### :see: {BF16.to_clamp[U16]} to saturate.
failable routine BF16.to[U16]() -> U16
    if not me.is_trunc_in_range(lo: 0.0, hi: 65536.0)
        throw IntegerOverflowError()
    r: U16 = fptoui_sat[Me, U16](me)
    return r

### Converts to U16, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 65535]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[U16]} with try in front to detect values that do not fit.
routine BF16.to_clamp[U16]() -> U16
    r: U16 = fptoui_sat[Me, U16](me)
    return r

### Converts to U32, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^32 - 1].
### :see: {BF16.to_clamp[U32]} to saturate.
failable routine BF16.to[U32]() -> U32
    if not me.is_trunc_in_range(lo: 0.0, hi: 4294967296.0)
        throw IntegerOverflowError()
    r: U32 = fptoui_sat[Me, U32](me)
    return r

### Converts to U32, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 2^32 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[U32]} with try in front to detect values that do not fit.
routine BF16.to_clamp[U32]() -> U32
    r: U32 = fptoui_sat[Me, U32](me)
    return r

### Converts to U64, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^64 - 1].
### :see: {BF16.to_clamp[U64]} to saturate.
failable routine BF16.to[U64]() -> U64
    if not me.is_trunc_in_range(lo: 0.0, hi: 18446744073709551616.0)
        throw IntegerOverflowError()
    r: U64 = fptoui_sat[Me, U64](me)
    return r

### Converts to U64, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 2^64 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[U64]} with try in front to detect values that do not fit.
routine BF16.to_clamp[U64]() -> U64
    r: U64 = fptoui_sat[Me, U64](me)
    return r

### Converts to U128, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^128 - 1].
### :see: {BF16.to_clamp[U128]} to saturate.
failable routine BF16.to[U128]() -> U128
    if not me.is_trunc_in_range(lo: 0.0, hi: 340282366920938463463374607431768211456.0)
        throw IntegerOverflowError()
    r: U128 = fptoui_sat[Me, U128](me)
    return r

### Converts to U128, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 2^128 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {BF16.to[U128]} with try in front to detect values that do not fit.
routine BF16.to_clamp[U128]() -> U128
    r: U128 = fptoui_sat[Me, U128](me)
    return r

### Whether `me`, rounded toward zero, lies in [`lo`, `hi`). False for NaN.
### :param lo: The lower bound, included.
### :param hi: The upper bound, excluded.
### :returns: `true` when `me.trunc()` is in range.
routine BF16.is_trunc_in_range(lo: Me, hi: Me) -> Bool
    whole: Me = me.trunc()
    return lo <= whole < hi

# -- checked forms -----------------------------------------------------------
#
# The default form of each operation whose finite arguments can give an infinite or NaN result crashes there:
# such a result is almost always a bug. Each has an _unchecked form, which gives the raw IEEE 754 value, and the
# operators +! -! *! /! spell the unchecked arithmetic. Finite results are the same bits in both forms.

### `me` when it is finite: the last step of a checked BF16 operation.
### :returns: `me`.
### :throws: Crashes with `NumericOverflowError` when `me` is infinite, and with `NumericDomainError` when it is NaN.
@track_caller
secret routine BF16.require_finite() -> Me
    if me.is_finite()
        return me
    if me.is_nan()
        throw NumericDomainError()
    throw NumericOverflowError()

### `me`, the result of dividing `dividend` by `divisor`, when it is finite: the last step of a checked BF16 division.
### :param dividend: The value divided.
### :param divisor: The value divided by.
### :returns: `me`.
### :throws: Crashes with `DivisionByZeroError` when `me` isn't finite because `divisor` is zero and `dividend` isn't,
###     else as {BF16.require_finite}.
@track_caller
secret routine BF16.require_finite_quotient(dividend: Me, divisor: Me) -> Me
    if me.is_finite()
        return me
    if divisor == 0.0 and not (dividend == 0.0)
        throw DivisionByZeroError()
    r: Me = me.require_finite()
    return r

### Adds `other` to `me`, rounded to nearest (ties to even). {BF16.add_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me + other`.
### :throws: Crashes with `NumericOverflowError` when the sum is too large for BF16 or an operand is infinite, and
###     with `NumericDomainError` when it is NaN: a NaN operand, or infinities of opposite signs.
@track_caller
routine BF16.add(other: Me) -> Me
    r: Me = me.add_unchecked(other)
    checked: Me = r.require_finite()
    return checked

### Subtracts `other` from `me`, rounded to nearest (ties to even). {BF16.sub_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me - other`.
### :throws: Crashes with `NumericOverflowError` when the difference is too large for BF16 or an operand is infinite,
###     and with `NumericDomainError` when it is NaN: a NaN operand, or infinities of the same sign.
@track_caller
routine BF16.sub(other: Me) -> Me
    r: Me = me.sub_unchecked(other)
    checked: Me = r.require_finite()
    return checked

### Multiplies `me` by `other`, rounded to nearest (ties to even). {BF16.mul_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me * other`.
### :throws: Crashes with `NumericOverflowError` when the product is too large for BF16 or a factor is infinite, and
###     with `NumericDomainError` when it is NaN: a NaN factor, or zero times infinity.
@track_caller
routine BF16.mul(other: Me) -> Me
    r: Me = me.mul_unchecked(other)
    checked: Me = r.require_finite()
    return checked

### Divides `me` by `other`, rounded to nearest (ties to even). {BF16.truediv_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me / other`.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, with `NumericOverflowError` when
###     the quotient is too large for BF16 or `me` is infinite, and with `NumericDomainError` when it is NaN: `0 / 0`,
###     `inf / inf`, or a NaN operand.
@track_caller
routine BF16.truediv(other: Me) -> Me
    r: Me = me.truediv_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### Fused multiply-add: `me * a + b` with a single rounding (to nearest, ties to even). {BF16.mul_add_unchecked} gives the raw IEEE 754 result.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b`, rounded once.
### :throws: Crashes with `NumericOverflowError` when the result is too large for BF16 or an operand is infinite, and
###     with `NumericDomainError` when it is NaN: a NaN operand, `0 * inf`, or infinities that cancel.
@track_caller
routine BF16.mul_add(a: Me, b: Me) -> Me
    r: Me = me.mul_add_unchecked(a, b)
    checked: Me = r.require_finite()
    return checked

### The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`. {BF16.floordiv_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The quotient `q`.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, with `NumericOverflowError` when
###     the quotient is too large for BF16 or infinite, and with `NumericDomainError` when it is NaN: `0 // 0`, an
###     infinite `me`, or a NaN operand.
@track_caller
routine BF16.floordiv(other: Me) -> Me
    r: Me = me.floordiv_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### The least non-negative remainder of `me / other` (Euclidean). {BF16.mod_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The remainder, in `[0, |other|)`.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, with `NumericOverflowError` when
###     the remainder is infinite (a negative `me` and an infinite `other`), and with `NumericDomainError` when it is
###     NaN: `0 % 0`, an infinite `me`, or a NaN operand.
@track_caller
routine BF16.mod(other: Me) -> Me
    r: Me = me.mod_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### The remainder of `me / other` with the sign of `me` (C fmod). Exact. {BF16.mod_trunc_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The remainder.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, and with `NumericDomainError`
###     when the remainder is NaN: a zero `other` and `me`, an infinite `me`, or a NaN operand.
@track_caller
routine BF16.mod_trunc(other: Me) -> Me
    r: Me = me.mod_trunc_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### The reciprocal `1 / me`, rounded once. {BF16.recip_unchecked} gives the raw IEEE 754 result.
### :returns: `1 / me`.
### :throws: Crashes with `DivisionByZeroError` when `me` is zero, with `NumericOverflowError` when `1 / me` is too
###     large for BF16 (a tiny subnormal `me`), and with `NumericDomainError` when `me` is NaN.
@track_caller
routine BF16.recip() -> Me
    r: Me = me.recip_unchecked()
    checked: Me = r.require_finite_quotient(dividend: 1.0, divisor: me)
    return checked

### The square root of `me`, correctly rounded. -0.0 gives -0.0. {BF16.sqrt_unchecked} gives the raw IEEE 754 result.
### :returns: The square root.
### :throws: Crashes with `NumericOverflowError` when `me` is +inf, and with `NumericDomainError` when `me` is
###     negative (other than -0.0) or NaN.
@track_caller
routine BF16.sqrt() -> Me
    r: Me = me.sqrt_unchecked()
    checked: Me = r.require_finite()
    return checked

### e^`me`, correctly rounded. {BF16.exp_unchecked} gives the raw IEEE 754 result.
### :returns: e^`me`.
### :throws: Crashes with `NumericOverflowError` when e^`me` is too large for BF16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine BF16.exp() -> Me
    r: Me = me.exp_unchecked()
    checked: Me = r.require_finite()
    return checked

### 2^`me`, correctly rounded. {BF16.exp2_unchecked} gives the raw IEEE 754 result.
### :returns: 2^`me`.
### :throws: Crashes with `NumericOverflowError` when 2^`me` is too large for BF16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine BF16.exp2() -> Me
    r: Me = me.exp2_unchecked()
    checked: Me = r.require_finite()
    return checked

### 10^`me`, correctly rounded. {BF16.exp10_unchecked} gives the raw IEEE 754 result.
### :returns: 10^`me`.
### :throws: Crashes with `NumericOverflowError` when 10^`me` is too large for BF16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine BF16.exp10() -> Me
    r: Me = me.exp10_unchecked()
    checked: Me = r.require_finite()
    return checked

### e^`me` - 1, correctly rounded and accurate near 0. {BF16.exp_m1_unchecked} gives the raw IEEE 754 result.
### :returns: e^`me` - 1.
### :throws: Crashes with `NumericOverflowError` when the result is too large for BF16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine BF16.exp_m1() -> Me
    r: Me = me.exp_m1_unchecked()
    checked: Me = r.require_finite()
    return checked

### The natural logarithm of `me`, correctly rounded. {BF16.ln_unchecked} gives the raw IEEE 754 result.
### :returns: ln(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is zero (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is negative or NaN.
@track_caller
routine BF16.ln() -> Me
    r: Me = me.ln_unchecked()
    checked: Me = r.require_finite()
    return checked

### The base-2 logarithm of `me`, correctly rounded. {BF16.log2_unchecked} gives the raw IEEE 754 result.
### :returns: log2(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is zero (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is negative or NaN.
@track_caller
routine BF16.log2() -> Me
    r: Me = me.log2_unchecked()
    checked: Me = r.require_finite()
    return checked

### The base-10 logarithm of `me`, correctly rounded. {BF16.log10_unchecked} gives the raw IEEE 754 result.
### :returns: log10(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is zero (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is negative or NaN.
@track_caller
routine BF16.log10() -> Me
    r: Me = me.log10_unchecked()
    checked: Me = r.require_finite()
    return checked

### ln(1 + `me`), correctly rounded and accurate near 0. {BF16.ln_1p_unchecked} gives the raw IEEE 754 result.
### :returns: ln(1 + `me`).
### :throws: Crashes with `NumericOverflowError` when `me` is -1 (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is below -1 or NaN.
@track_caller
routine BF16.ln_1p() -> Me
    r: Me = me.ln_1p_unchecked()
    checked: Me = r.require_finite()
    return checked

### The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded. {BF16.log_unchecked} gives the raw IEEE 754 result.
### :param base: The base of the logarithm.
### :returns: log base `base` of `me`.
### :throws: Crashes with `NumericOverflowError` when the quotient is infinite (`me` zero or +inf, or `base` 1), and
###     with `NumericDomainError` when it is NaN: a negative or NaN argument, or both logarithms zero or both
###     infinite.
@track_caller
routine BF16.log(base: Me) -> Me
    r: Me = me.log_unchecked(base)
    checked: Me = r.require_finite()
    return checked

### `me` raised to the power `exponent`, correctly rounded. {BF16.powf_unchecked} gives the raw IEEE 754 result.
### :param exponent: The exponent.
### :returns: `me` ^ `exponent`.
### :throws: Crashes with `NumericOverflowError` when the power is too large for BF16, or infinite (a zero `me` with a
###     negative `exponent`), and with `NumericDomainError` when it is NaN: a negative `me` with an `exponent` that
###     isn't an integer, or a NaN operand.
@track_caller
routine BF16.powf(exponent: Me) -> Me
    r: Me = me.powf_unchecked(exponent)
    checked: Me = r.require_finite()
    return checked

### `me` raised to the integer power `n`, correctly rounded. {BF16.powi_unchecked} gives the raw IEEE 754 result.
### :param n: The exponent.
### :returns: `me` ^ `n`.
### :throws: Crashes with `NumericOverflowError` when the power is too large for BF16, or infinite (a zero `me` with a
###     negative `n`), and with `NumericDomainError` when `me` is NaN.
@track_caller
routine BF16.powi(n: S32) -> Me
    r: Me = me.powi_unchecked(n)
    checked: Me = r.require_finite()
    return checked

### tan(pi * `me`), correctly rounded. {BF16.tan_pi_unchecked} gives the raw IEEE 754 result.
### :returns: tan(pi * `me`).
### :throws: Crashes with `NumericOverflowError` when `me` is an odd multiple of 0.5 (a pole), and with
###     `NumericDomainError` when `me` is infinite or NaN.
@track_caller
routine BF16.tan_pi() -> Me
    r: Me = me.tan_pi_unchecked()
    checked: Me = r.require_finite()
    return checked

### The arcsine of `me` in radians, correctly rounded. {BF16.asin_unchecked} gives the raw IEEE 754 result.
### :returns: asin(`me`), in [-pi/2, pi/2].
### :throws: Crashes with `NumericDomainError` when `me` is outside [-1, 1] or NaN.
@track_caller
routine BF16.asin() -> Me
    r: Me = me.asin_unchecked()
    checked: Me = r.require_finite()
    return checked

### The arccosine of `me` in radians, correctly rounded. {BF16.acos_unchecked} gives the raw IEEE 754 result.
### :returns: acos(`me`), in [0, pi].
### :throws: Crashes with `NumericDomainError` when `me` is outside [-1, 1] or NaN.
@track_caller
routine BF16.acos() -> Me
    r: Me = me.acos_unchecked()
    checked: Me = r.require_finite()
    return checked

### The hyperbolic sine of `me`, correctly rounded. {BF16.sinh_unchecked} gives the raw IEEE 754 result.
### :returns: sinh(`me`).
### :throws: Crashes with `NumericOverflowError` when the result is too large for BF16 or `me` is infinite, and with
###     `NumericDomainError` when `me` is NaN.
