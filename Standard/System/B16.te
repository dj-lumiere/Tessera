# Tessera stdlib: B16 — 16-bit IEEE 754 half precision
#
# Maps to LLVM IR half. x86 has no B16 arithmetic, so LLVM computes in B32
# and rounds. The conversions call compiler-rt, which the builder links.

module Standard/System

### A 16-bit IEEE 754 binary16 floating-point number (half precision), mapped to LLVM `half`.
### It has an 11-bit significand (about 3 significant decimal digits) and finite magnitudes up to 65504.
### :note: Targets without B16 arithmetic (x86) compute in B32 and round back, which gives the same correctly rounded result.
### :see: {BF16} for B32's range at lower precision.
@llvm("half")
record B16
obeys Equatable[B16], Comparable[B16], Hashable[B16]
obeys Numeric[B16], Divisible[B16], Negatable[B16]
obeys UncheckedArithmetic[B16]
    nothing

# -- runtime support ---------------------------------------------------------

# x86 has no B16 arithmetic, so LLVM computes in B32 and converts with these
# compiler-rt routines. The Windows build of compiler-rt passes half values in
# integer registers while LLVM passes them in SSE registers, so the stdlib
# provides its own under the same names.

### Windows-only replacement for compiler-rt's `__extendhfsf2`, exported under that name: widens B16 to B32 exactly.
### :param x: The B16 to widen.
### :returns: The same value as a B32.
### :note: LLVM calls it on x86, which computes B16 arithmetic in B32. The Windows compiler-rt passes half values in integer registers where LLVM uses SSE registers.
@export("__extendhfsf2")
@target(os: "windows")
secret routine export_extendhfsf2(x: B16) -> B32
    r: B32 = x.to[B32]()
    return r

### Windows-only replacement for compiler-rt's `__truncsfhf2`, exported under that name: narrows B32 to B16, rounding to nearest (ties to even).
### :param x: The B32 to narrow.
### :returns: The nearest B16.
### :note: LLVM calls it on x86 to round B16 arithmetic computed in B32.
@export("__truncsfhf2")
@target(os: "windows")
secret routine export_truncsfhf2(x: B32) -> B16
    r: B16 = x.to_unchecked[B16]()
    return r

### Windows-only replacement for compiler-rt's `__truncdfhf2`, exported under that name: narrows B64 to B16, rounding once to nearest (ties to even).
### :param x: The B64 to narrow.
### :returns: The nearest B16.
@export("__truncdfhf2")
@target(os: "windows")
secret routine export_truncdfhf2(x: B64) -> B16
    r: B16 = x.to_unchecked[B16]()
    return r

# -- arithmetic ----------------------------------------------------------------

### Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
### :returns: `me` with the sign bit cleared.
routine B16.abs() -> Me
    r: Me = fabs[Me](me)
    return r

### The smaller value, or the other one if one operand is NaN.
### :param other: The value to compare with.
### :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine B16.min(other: Me) -> Me
    smaller: B32 = me.to[B32]().min(other.to[B32]())
    r: Me = smaller.to_unchecked[Me]()  # via B32 (exact)
    return r

### The larger value, or the other one if one operand is NaN.
### :param other: The value to compare with.
### :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine B16.max(other: Me) -> Me
    larger: B32 = me.to[B32]().max(other.to[B32]())
    r: Me = larger.to_unchecked[Me]()  # via B32 (exact)
    return r

### Adds `other` to `me`, rounded to nearest (ties to even).
### :param other: The value to add.
### :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine B16.add_unchecked(other: Me) -> Me
    r: Me = fadd[Me](me, other)
    return r

### Subtracts `other` from `me`, rounded to nearest (ties to even).
### :param other: The value to subtract.
### :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine B16.sub_unchecked(other: Me) -> Me
    r: Me = fsub[Me](me, other)
    return r

### Multiplies `me` by `other`, rounded to nearest (ties to even).
### :param other: The factor.
### :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine B16.mul_unchecked(other: Me) -> Me
    r: Me = fmul[Me](me, other)
    return r

# -- comparisons ---------------------------------------------------------------

### Whether `me` is less than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B16.lt(other: Me) -> Bool
    return flt[Me](me, other)

### Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B16.le(other: Me) -> Bool
    return fle[Me](me, other)

### Whether `me` is greater than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B16.gt(other: Me) -> Bool
    return fgt[Me](me, other)

### Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B16.ge(other: Me) -> Bool
    return fge[Me](me, other)

# -- division ------------------------------------------------------------------

### Divides `me` by `other`, rounded to nearest (ties to even).
### :param other: The divisor.
### :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine B16.truediv_unchecked(other: Me) -> Me
    r: Me = fdiv[Me](me, other)
    return r

# -- equality, ordering, hashing -----------------------------------------------

### IEEE equality.
### :param other: The value to compare against.
### :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine B16.eq(other: Me) -> Bool
    return feq[Me](me, other)

### Three-way comparison for the `Comparable` conformance.
### :param other: The value to compare against.
### :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
### :see: {B16.total_compare} for a total order that ranks NaN and the signed zeros.
routine B16.compare(other: Me) -> S32
    if me < other
        return -1
    if me > other
        return 1
    return 0

### Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
### :returns: The 64-bit hash.
### :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine B16.hash() -> U64
    h: U64 = siphash24(value: me.bits().to[U64](), key: hash_key())
    return h

# -- named widening conversion -------------------------------------------------

### Widens to B64, exactly, through B32.
### :returns: The same value as a B64. Every B16 is representable.
routine B16.to[B64]() -> B64
    wide: B32 = me.to[B32]()
    r: B64 = wide.to[B64]()
    return r

# ============================================================
# Rust-level operations
# ============================================================

# -- constants ------------------------------------------------------------------

### The largest finite B16, 65504 (bits `0x7BFF`).
preset B16.MAX:          B16 = B16.from_bits(0x7BFF)  # largest finite value
### The most negative finite B16, the negation of `B16.MAX` (bits `0xFBFF`).
preset B16.MIN:          B16 = B16.from_bits(0xFBFF)  # most negative finite value
### The smallest positive normal B16, 2^-14, about 6.1035156e-5 (bits `0x0400`). Subnormal values go below it.
preset B16.MIN_POSITIVE: B16 = B16.from_bits(0x0400)  # smallest positive normal value
### The gap between 1.0 and the next larger B16, 2^-10, 0.0009765625 (bits `0x1400`).
preset B16.EPSILON:      B16 = B16.from_bits(0x1400)  # the gap between 1.0 and the next value

### Pi, rounded to the nearest B16.
preset B16.PI: B16 = 3.14159265358979323846264338327950288  # pi
### Tau (2 pi), one full turn in radians, rounded to the nearest B16.
preset B16.TAU: B16 = 6.28318530717958647692528676655900577  # 2 pi
### Euler's number e, rounded to the nearest B16.
preset B16.E: B16 = 2.71828182845904523536028747135266250  # Euler's number
### Pi / 2, rounded to the nearest B16.
preset B16.FRAC_PI_2: B16 = 1.57079632679489661923132169163975144  # pi / 2
### Pi / 4, rounded to the nearest B16.
preset B16.FRAC_PI_4: B16 = 0.785398163397448309615660845819875721  # pi / 4
### 1 / pi, rounded to the nearest B16.
preset B16.FRAC_1_PI: B16 = 0.318309886183790671537767526745028724  # 1 / pi
### The square root of 2, rounded to the nearest B16.
preset B16.SQRT_2: B16 = 1.41421356237309504880168872420969808  # sqrt(2)
### 1 / sqrt(2), rounded to the nearest B16.
preset B16.FRAC_1_SQRT_2: B16 = 0.707106781186547524400844362104849039  # 1 / sqrt(2)
### The natural logarithm of 2, rounded to the nearest B16.
preset B16.LN_2: B16 = 0.693147180559945309417232121458176568  # ln(2)
### The natural logarithm of 10, rounded to the nearest B16.
preset B16.LN_10: B16 = 2.30258509299404568401799145468436421  # ln(10)
### Log2(e), rounded to the nearest B16.
preset B16.LOG2_E: B16 = 1.44269504088896340735992468100189214  # log2(e)
### Log10(e), rounded to the nearest B16.
preset B16.LOG10_E: B16 = 0.434294481903251827651128918916605082  # log10(e)

# -- sign ----------------------------------------------------------------------

### Flips the sign bit, exactly.
### :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine B16.neg() -> Me
    r: Me = fneg[Me](me)
    return r

### The magnitude of `me` with the sign of `sign`.
### :param sign: The value whose sign bit is used.
### :returns: `me` with its sign bit replaced by the sign bit of `sign`.
routine B16.copysign(sign: Me) -> Me
    r: Me = copysign[Me](mag: me, sign)
    return r

### 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
### :returns: 1.0, -1.0, or NaN, by the sign of `me`.
routine B16.signum() -> Me
    is_nan: Bool = me.is_nan()
    unit: Me = copysign[Me](mag: 1.0, sign: me)
    r: Me = when
        is_nan => me
        else => unit
    return r

### Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
### :returns: Whether the sign bit is clear.
routine B16.is_sign_positive() -> Bool
    bits: S16 = me.bits().to_wrap[S16]()
    return bits >= 0

### Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
### :returns: Whether the sign bit is set.
routine B16.is_sign_negative() -> Bool
    bits: S16 = me.bits().to_wrap[S16]()
    return bits < 0

# -- arithmetic ----------------------------------------------------------------

### The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact: B32's remainder of the
### same values is a B16.
### :param other: The divisor.
### :returns: The remainder. NaN when either operand is NaN, `me` is infinite, or `other` is 0. Otherwise `me`
###     itself when `other` is infinite or `me` is a zero.
routine B16.mod_trunc_unchecked(other: Me) -> Me
    remainder: B32 = me.to[B32]().mod_trunc_unchecked(other.to[B32]())
    r: Me = remainder.to_unchecked[Me]()
    return r

### The reciprocal `1 / me`, rounded once.
### :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine B16.recip_unchecked() -> Me
    r: Me = fdiv[Me](1.0, me)
    return r

### `me * a + b`, rounded once. The product of two 11-bit significands is exact in B64. The sum is added
### with round-to-odd ({b64_add_round_to_odd}), which the narrowing then rounds as it would the exact result.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
routine B16.mul_add_unchecked(a: Me, b: Me) -> Me
    product: B64 = me.to[B64]() *! a.to[B64]()
    sum: B64 = b64_add_round_to_odd(a: product, b: b.to[B64]())
    r: Me = sum.to_unchecked[Me]()
    return r

### The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
### :param other: The divisor.
### :returns: The quotient `q`. NaN when either operand is NaN.
routine B16.floordiv_unchecked(other: Me) -> Me
    q: Me = me.truediv_unchecked(other).trunc()
    rem: Me = me.mod_trunc_unchecked(other)
    if not (rem < 0.0)
        return q
    positive_divisor: Bool = other > 0.0
    down: Me = q -! 1.0
    up: Me = q +! 1.0
    r: Me = when
        positive_divisor => down
        else => up
    return r

### The least non-negative remainder of `me / other`.
### :param other: The divisor.
### :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
###     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine B16.mod_unchecked(other: Me) -> Me
    rem: Me = me.mod_trunc_unchecked(other)
    if not (rem < 0.0)
        return rem
    magnitude: Me = other.abs()
    r: Me = rem +! magnitude
    # a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
    # one in range
    if r == magnitude and magnitude.is_finite()
        return Me.from_bits(magnitude.bits() - 1)
    return r

# -- ordering ------------------------------------------------------------------

### The smaller value, NaN if either is NaN, and -0.0 below +0.0.
### :param other: The value to compare with.
### :returns: The smaller value, or NaN when either operand is NaN.
routine B16.minimum(other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me +! other
    # equal values have equal bits except ±0, where bitor picks the negative one
    if me == other
        return Me.from_bits(me.bits() | other.bits())
    pick: Bool = me < other
    r: Me = when
        pick => me
        else => other
    return r

### The larger value, NaN if either is NaN, and +0.0 above -0.0.
### :param other: The value to compare with.
### :returns: The larger value, or NaN when either operand is NaN.
routine B16.maximum(other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me +! other
    # equal values have equal bits except ±0, where bitand picks the positive one
    if me == other
        return Me.from_bits(me.bits() & other.bits())
    pick: Bool = me > other
    r: Me = when
        pick => me
        else => other
    return r

### Restricts `me` to `lo ..= hi`. NaN stays NaN.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
### :throws: Crashes with `InvalidValueError` unless `lo <= hi`, so also when either bound is NaN.
@track_caller
routine B16.clamp(lo: Me, hi: Me) -> Me
    if lo <= hi
        below: Bool = me < lo
        above: Bool = me > hi
        upper: Me = when
            above => hi
            else => me
        r: Me = when
            below => lo
            else => upper
        return r
    crash_invalid_value()

### IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
### :param other: The value to compare with.
### :returns: -1, 0, or 1 as `me` comes before, at the same place as, or after `other` in that order.
routine B16.total_compare(other: Me) -> S32
    a: S16 = me.bits().to_wrap[S16]()
    b: S16 = other.bits().to_wrap[S16]()
    # Flipping every bit but the sign of negative values makes the bits order like signed integers.
    a_key: S16 = a ^ ((a >> 15) & S16.MAX)
    b_key: S16 = b ^ ((b >> 15) & S16.MAX)
    r: S32 = a_key.compare(b_key)
    return r

# -- rounding ------------------------------------------------------------------

### Rounds toward negative infinity by widening to B32, rounding there, and narrowing back (exact).
### :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
routine B16.floor() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.floor().to_unchecked[Me]()
    return r

### Rounds toward positive infinity by widening to B32, rounding there, and narrowing back (exact).
### :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine B16.ceil() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.ceil().to_unchecked[Me]()
    return r

### Rounds half-way cases away from zero.
### :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
routine B16.round() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.round().to_unchecked[Me]()
    return r

### Rounds half-way cases to the even neighbor.
### :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
routine B16.round_ties_even() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.round_ties_even().to_unchecked[Me]()
    return r

### Rounds toward zero.
### :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
routine B16.trunc() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.trunc().to_unchecked[Me]()
    return r

### `me` minus its integer part, with the sign of `me`.
### :returns: The fractional part. NaN for an infinity or NaN.
routine B16.fract() -> Me
    whole: Me = me.trunc()
    r: Me = me -! whole
    return r

# -- powers --------------------------------------------------------------------
#
# cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
# defined in Standard/System/Numerics/B16/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
# bits on every target, unlike the platform libm.

### The square root of `me`.
### :returns: The square root: NaN for negative values other than -0.0, which gives -0.0.
routine B16.sqrt_unchecked() -> Me
    wide: B32 = me.to[B32]()
    r: Me = wide.sqrt_unchecked().to_unchecked[Me]()
    return r

### me raised to an integer power, correctly rounded. The B64 power (n converts exactly) rounds correctly to
### B16 unless it lands exactly on a B16 midpoint. There the B128 power decides (checked for every x and n that
### reach it).
### :param n: The integer exponent.
### :returns: `me` to the power `n`, rounded once.
routine B16.powi_unchecked(n: S32) -> Me
    r: B64 = me.to[B64]().powf_unchecked(n.to[B64]())
    if b16_is_on_midpoint_b64(r)
        r2: B128 = me.to[B128]().powf_unchecked(n.to[B128]())
        return r2.to_unchecked[Me]()
    return r.to_unchecked[Me]()

### Whether r lies exactly between two B16 values.
### :param r: The B64 value to test.
### :returns: True when `r` is finite and lies exactly halfway between two adjacent B16 values.
secret routine b16_is_on_midpoint_b64(r: B64) -> Bool
    local a: B64 = r.abs()

    if a < 0x1p-14
        # B16 keeps 10 fraction bits: a midpoint has bit 41 set and nothing below it.
        # Below 2^-14 B16's quantum is 2^-24: a midpoint is an odd multiple of 2^-25.
        t: B64 = a *! 0x1p25
        whole: Bool = t.trunc() == t
        odd: Bool = t.mod_trunc_unchecked(2.0) == 1.0
        return whole and odd
    low: U64 = a.bits() & 0x3FFFFFFFFFF
    return a.is_finite() and low == 0x20000000000

### The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even): the
### quotient of the correctly rounded B64 logarithms, rounded once to B16. That quotient is within 3 × 2^-53 relative of
### the true value, and over every pair of positive finite B16 inputs no true value lies closer than 2^-41.2 relative to
### a B16 midpoint (subnormal results included), so the one rounding is always the correct one.
### :param base: The base of the logarithm.
### :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the quotient of the
###     logarithms: NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for `me` 1 or base
###     0 or +inf, NaN when both logarithms are zero or both infinite.
### :note: The scan behind it checked all 1,007,554,564 pairs (bases and arguments other than 1), with the 164 pairs
###     closer than 2^-34 to a midpoint compared against mpmath.
routine B16.log_unchecked(base: Me) -> Me
    q: B64 = me.to[B64]().ln_unchecked() /! base.to[B64]().ln_unchecked()
    return q.to_unchecked[Me]()

# -- special functions ---------------------------------------------------------

### Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to B16).
### :returns: `me` in degrees, rounded once.
routine B16.to_degrees_unchecked() -> Me
    r: Me = me *! 57.2957795130823208767981548141051703
    return r

### Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to B16).
### :returns: `me` in radians, rounded once.
routine B16.to_radians() -> Me
    r: Me = me *! 0.0174532925199432957692369076848861271
    return r

# -- classification ------------------------------------------------------------

### Whether `me` is NaN, quiet or signaling.
### :returns: True for NaN, the only value unordered with itself.
routine B16.is_nan() -> Bool
    return funo[Me](me, me)

### Whether `me` is +inf or -inf.
### :returns: True for either infinity, false for NaN and finite values.
routine B16.is_infinite() -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude == inf

### Neither infinite nor NaN.
### :returns: True for zeros, subnormals and normal values. False for infinities and NaN.
routine B16.is_finite() -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude < inf

### Not zero, subnormal, infinite, or NaN.
### :returns: True when the exponent field is neither all zeros nor all ones.
routine B16.is_normal() -> Bool
    exponent: U16 = me.bits() & 0x7C00
    return exponent != 0 and exponent != 0x7C00

### Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `B16.MIN_POSITIVE`.
### :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine B16.is_subnormal() -> Bool
    bits: U16 = me.bits()
    exponent: U16 = bits & 0x7C00
    mantissa: U16 = bits & 0x03FF
    return exponent == 0 and mantissa != 0

# -- bits ----------------------------------------------------------------------

### The raw IEEE 754 bits.
### :returns: The encoding as a U16: sign bit at the top, then the exponent field, then the fraction.
routine B16.bits() -> U16
    r: U16 = bitcast[Me, U16](me)
    return r

### Reinterprets raw IEEE 754 binary16 bits as a B16, exactly.
### :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
### :returns: The value with that encoding. NaN payloads are kept.
### :see: {B16.bits} for the inverse.
common routine B16.from_bits(bits: U16) -> Me
    r: Me = bitcast[U16, Me](bits)
    return r

# -- float conversions -----------------------------------------------------------

### The identity conversion, so generic code can call `to[T]()` when `T` is B16.
### :returns: `me` unchanged.
routine B16.to[Me]() -> Me
    return me

### Converts to BF16 by widening to B32 exactly and rounding once to nearest (ties to even).
### :returns: The nearest BF16: BF16 covers B16's range but keeps only 8 significant bits, so low bits may round off.
routine B16.to[BF16]() -> BF16
    wide: B32 = me.to[B32]()
    r: BF16 = wide.to_unchecked[BF16]()
    return r

### Widens to B32 exactly. Written with integer operations instead of fpext, which would call
### compiler-rt's `__extendhfsf2` (on Windows the stdlib's own replacement for it is built on this routine).
### :returns: The same value as a B32. Every B16 is representable.
routine B16.to[B32]() -> B32
    local bits: U32 = me.bits().to[U32]()
    local sign: U32 = (bits & 0x8000) << 16
    local exponent: U32 = (bits >> 10) & 0x1F
    local mantissa: U32 = bits & 0x3FF

    when
        exponent == 0x1F =>
            r: B32 = .from_bits(sign | 0x7F800000 | (mantissa << 13))
            return r
        exponent == 0 =>
            # Zero or subnormal: the value is mantissa * 2^-24, which B32 holds exactly.
            value: B32 = mantissa.to[B32]() *! 0.000000059604644775390625
            magnitude: U32 = value.bits()
            r: B32 = .from_bits(magnitude | sign)
            return r
        else =>
            r: B32 = .from_bits(sign | (exponent + 112 << 23) | (mantissa << 13))
            return r

# -- integer conversions ---------------------------------------------------------
#
# to[int] rounds toward zero and throws IntegerOverflowError on NaN or a value out
# of the integer's range (try gives None), and to_clamp[int] saturates (NaN gives
# 0).

### Converts to S8, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127].
### :see: {B16.to_clamp[S8]} to saturate.
failable routine B16.to[S8]() -> S8
    if not me.is_trunc_in_range(lo: -128.0, hi: 128.0)
        throw IntegerOverflowError()
    r: S8 = fptosi_sat[Me, S8](me)
    return r

### Converts to S8, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[S8]} with try in front to detect values that do not fit.
routine B16.to_clamp[S8]() -> S8
    r: S8 = fptosi_sat[Me, S8](me)
    return r

### Converts to S16, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767].
### :see: {B16.to_clamp[S16]} to saturate.
failable routine B16.to[S16]() -> S16
    if not me.is_trunc_in_range(lo: -32768.0, hi: 32768.0)
        throw IntegerOverflowError()
    r: S16 = fptosi_sat[Me, S16](me)
    return r

### Converts to S16, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[S16]} with try in front to detect values that do not fit.
routine B16.to_clamp[S16]() -> S16
    r: S16 = fptosi_sat[Me, S16](me)
    return r

### Converts to S32, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1].
### :see: {B16.to_clamp[S32]} to saturate.
failable routine B16.to[S32]() -> S32
    if not me.is_trunc_in_range(lo: -2147483648.0, hi: 2147483648.0)
        throw IntegerOverflowError()
    r: S32 = fptosi_sat[Me, S32](me)
    return r

### Converts to S32, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-2^31, 2^31 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[S32]} with try in front to detect values that do not fit.
routine B16.to_clamp[S32]() -> S32
    r: S32 = fptosi_sat[Me, S32](me)
    return r

### Converts to S64, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1].
### :see: {B16.to_clamp[S64]} to saturate.
failable routine B16.to[S64]() -> S64
    if not me.is_trunc_in_range(lo: -9223372036854775808.0, hi: 9223372036854775808.0)
        throw IntegerOverflowError()
    r: S64 = fptosi_sat[Me, S64](me)
    return r

### Converts to S64, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-2^63, 2^63 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[S64]} with try in front to detect values that do not fit.
routine B16.to_clamp[S64]() -> S64
    r: S64 = fptosi_sat[Me, S64](me)
    return r

# B16 to a 128-bit integer goes through B32 (exact): LLVM 21 at -O0 on AArch64 lowers the saturating half to i128
# conversion to one 64-bit fcvtzs/fcvtzu and leaves the high word 0 or unset, so -1 came back as 2^64 - 1.
### Converts to S128, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
### :see: {B16.to_clamp[S128]} to saturate.
failable routine B16.to[S128]() -> S128
    if not me.is_trunc_in_range(lo: -170141183460469231731687303715884105728.0,
        hi: 170141183460469231731687303715884105728.0)
        throw IntegerOverflowError()
    r: S128 = fptosi_sat[B32, S128](me.to[B32]())
    return r

### Converts to S128, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-2^127, 2^127 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[S128]} with try in front to detect values that do not fit.
routine B16.to_clamp[S128]() -> S128
    r: S128 = fptosi_sat[B32, S128](me.to[B32]())
    return r

### Converts to U8, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 255].
### :see: {B16.to_clamp[U8]} to saturate.
failable routine B16.to[U8]() -> U8
    if not me.is_trunc_in_range(lo: 0.0, hi: 256.0)
        throw IntegerOverflowError()
    r: U8 = fptoui_sat[Me, U8](me)
    return r

### Converts to U8, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 255]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[U8]} with try in front to detect values that do not fit.
routine B16.to_clamp[U8]() -> U8
    r: U8 = fptoui_sat[Me, U8](me)
    return r

### Converts to U16, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 65535].
### :see: {B16.to_clamp[U16]} to saturate.
failable routine B16.to[U16]() -> U16
    if not me.is_trunc_in_range(lo: 0.0, hi: 65536.0)
        throw IntegerOverflowError()
    r: U16 = fptoui_sat[Me, U16](me)
    return r

### Converts to U16, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 65535]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[U16]} with try in front to detect values that do not fit.
routine B16.to_clamp[U16]() -> U16
    r: U16 = fptoui_sat[Me, U16](me)
    return r

### Converts to U32, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^32 - 1].
### :see: {B16.to_clamp[U32]} to saturate.
failable routine B16.to[U32]() -> U32
    if not me.is_trunc_in_range(lo: 0.0, hi: 4294967296.0)
        throw IntegerOverflowError()
    r: U32 = fptoui_sat[Me, U32](me)
    return r

### Converts to U32, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 2^32 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[U32]} with try in front to detect values that do not fit.
routine B16.to_clamp[U32]() -> U32
    r: U32 = fptoui_sat[Me, U32](me)
    return r

### Converts to U64, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^64 - 1].
### :see: {B16.to_clamp[U64]} to saturate.
failable routine B16.to[U64]() -> U64
    if not me.is_trunc_in_range(lo: 0.0, hi: 18446744073709551616.0)
        throw IntegerOverflowError()
    r: U64 = fptoui_sat[Me, U64](me)
    return r

### Converts to U64, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 2^64 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[U64]} with try in front to detect values that do not fit.
routine B16.to_clamp[U64]() -> U64
    r: U64 = fptoui_sat[Me, U64](me)
    return r

### Converts to U128, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Throws `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^128 - 1].
### :see: {B16.to_clamp[U128]} to saturate.
failable routine B16.to[U128]() -> U128
    if not me.is_trunc_in_range(lo: 0.0, hi: 340282366920938463463374607431768211456.0)
        throw IntegerOverflowError()
    r: U128 = fptoui_sat[B32, U128](me.to[B32]())
    return r

### Converts to U128, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [0, 2^128 - 1]. Infinities give the nearer end and NaN gives 0.
### :see: {B16.to[U128]} with try in front to detect values that do not fit.
routine B16.to_clamp[U128]() -> U128
    r: U128 = fptoui_sat[B32, U128](me.to[B32]())
    return r

### Whether `me`, rounded toward zero, lies in `[lo, hi)`. False for NaN.
### :param lo: The lower bound, included.
### :param hi: The upper bound, excluded.
### :returns: True when `lo <= trunc(me) < hi`.
routine B16.is_trunc_in_range(lo: Me, hi: Me) -> Bool
    whole: Me = me.trunc()
    return lo <= whole < hi

# -- checked forms -----------------------------------------------------------
#
# The default form of each operation whose finite arguments can give an infinite or NaN result crashes there:
# such a result is almost always a bug. Each has an _unchecked form, which gives the raw IEEE 754 value, and the
# operators +! -! *! /! spell the unchecked arithmetic. Finite results are the same bits in both forms.

### `me` when it is finite: the last step of a checked B16 operation.
### :returns: `me`.
### :throws: Crashes with `NumericOverflowError` when `me` is infinite, and with `NumericDomainError` when it is NaN.
@track_caller
secret routine B16.require_finite() -> Me
    if me.is_finite()
        return me
    if me.is_nan()
        crash_numeric_domain()
    crash_float_overflow()

### `me`, the result of dividing `dividend` by `divisor`, when it is finite: the last step of a checked B16 division.
### :param dividend: The value divided.
### :param divisor: The value divided by.
### :returns: `me`.
### :throws: Crashes with `DivisionByZeroError` when `me` isn't finite because `divisor` is zero and `dividend` isn't,
###     else as {B16.require_finite}.
@track_caller
secret routine B16.require_finite_quotient(dividend: Me, divisor: Me) -> Me
    if me.is_finite()
        return me
    if divisor == 0.0 and not (dividend == 0.0)
        crash_division_by_zero()
    r: Me = me.require_finite()
    return r

### Adds `other` to `me`, rounded to nearest (ties to even). {B16.add_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me + other`.
### :throws: Crashes with `NumericOverflowError` when the sum is too large for B16 or an operand is infinite, and with
###     `NumericDomainError` when it is NaN: a NaN operand, or infinities of opposite signs.
@track_caller
routine B16.add(other: Me) -> Me
    r: Me = me.add_unchecked(other)
    checked: Me = r.require_finite()
    return checked

### Subtracts `other` from `me`, rounded to nearest (ties to even). {B16.sub_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me - other`.
### :throws: Crashes with `NumericOverflowError` when the difference is too large for B16 or an operand is infinite,
###     and with `NumericDomainError` when it is NaN: a NaN operand, or infinities of the same sign.
@track_caller
routine B16.sub(other: Me) -> Me
    r: Me = me.sub_unchecked(other)
    checked: Me = r.require_finite()
    return checked

### Multiplies `me` by `other`, rounded to nearest (ties to even). {B16.mul_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me * other`.
### :throws: Crashes with `NumericOverflowError` when the product is too large for B16 or a factor is infinite, and
###     with `NumericDomainError` when it is NaN: a NaN factor, or zero times infinity.
@track_caller
routine B16.mul(other: Me) -> Me
    r: Me = me.mul_unchecked(other)
    checked: Me = r.require_finite()
    return checked

### Divides `me` by `other`, rounded to nearest (ties to even). {B16.truediv_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: `me / other`.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, with `NumericOverflowError` when
###     the quotient is too large for B16 or `me` is infinite, and with `NumericDomainError` when it is NaN: `0 / 0`,
###     `inf / inf`, or a NaN operand.
@track_caller
routine B16.truediv(other: Me) -> Me
    r: Me = me.truediv_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### Fused multiply-add: `me * a + b` with a single rounding (to nearest, ties to even). {B16.mul_add_unchecked} gives the raw IEEE 754 result.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b`, rounded once.
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or an operand is infinite, and
###     with `NumericDomainError` when it is NaN: a NaN operand, `0 * inf`, or infinities that cancel.
@track_caller
routine B16.mul_add(a: Me, b: Me) -> Me
    r: Me = me.mul_add_unchecked(a, b)
    checked: Me = r.require_finite()
    return checked

### The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`. {B16.floordiv_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The quotient `q`.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, with `NumericOverflowError` when
###     the quotient is too large for B16 or infinite, and with `NumericDomainError` when it is NaN: `0 // 0`, an
###     infinite `me`, or a NaN operand.
@track_caller
routine B16.floordiv(other: Me) -> Me
    r: Me = me.floordiv_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### The least non-negative remainder of `me / other` (Euclidean). {B16.mod_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The remainder, in `[0, |other|)`.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, with `NumericOverflowError` when
###     the remainder is infinite (a negative `me` and an infinite `other`), and with `NumericDomainError` when it is
###     NaN: `0 % 0`, an infinite `me`, or a NaN operand.
@track_caller
routine B16.mod(other: Me) -> Me
    r: Me = me.mod_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### The remainder of `me / other` with the sign of `me` (C fmod). Exact. {B16.mod_trunc_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The remainder.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` isn't, and with `NumericDomainError`
###     when the remainder is NaN: a zero `other` and `me`, an infinite `me`, or a NaN operand.
@track_caller
routine B16.mod_trunc(other: Me) -> Me
    r: Me = me.mod_trunc_unchecked(other)
    checked: Me = r.require_finite_quotient(dividend: me, divisor: other)
    return checked

### The reciprocal `1 / me`, rounded once. {B16.recip_unchecked} gives the raw IEEE 754 result.
### :returns: `1 / me`.
### :throws: Crashes with `DivisionByZeroError` when `me` is zero, with `NumericOverflowError` when `1 / me` is too
###     large for B16 (a tiny subnormal `me`), and with `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.recip() -> Me
    r: Me = me.recip_unchecked()
    checked: Me = r.require_finite_quotient(dividend: 1.0, divisor: me)
    return checked

### The square root of `me`, correctly rounded. -0.0 gives -0.0. {B16.sqrt_unchecked} gives the raw IEEE 754 result.
### :returns: The square root.
### :throws: Crashes with `NumericOverflowError` when `me` is +inf, and with `NumericDomainError` when `me` is
###     negative (other than -0.0) or NaN.
@track_caller
routine B16.sqrt() -> Me
    r: Me = me.sqrt_unchecked()
    checked: Me = r.require_finite()
    return checked

### e^`me`, correctly rounded. {B16.exp_unchecked} gives the raw IEEE 754 result.
### :returns: e^`me`.
### :throws: Crashes with `NumericOverflowError` when e^`me` is too large for B16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.exp() -> Me
    r: Me = me.exp_unchecked()
    checked: Me = r.require_finite()
    return checked

### 2^`me`, correctly rounded. {B16.exp2_unchecked} gives the raw IEEE 754 result.
### :returns: 2^`me`.
### :throws: Crashes with `NumericOverflowError` when 2^`me` is too large for B16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.exp2() -> Me
    r: Me = me.exp2_unchecked()
    checked: Me = r.require_finite()
    return checked

### 10^`me`, correctly rounded. {B16.exp10_unchecked} gives the raw IEEE 754 result.
### :returns: 10^`me`.
### :throws: Crashes with `NumericOverflowError` when 10^`me` is too large for B16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.exp10() -> Me
    r: Me = me.exp10_unchecked()
    checked: Me = r.require_finite()
    return checked

### e^`me` - 1, correctly rounded and accurate near 0. {B16.exp_m1_unchecked} gives the raw IEEE 754 result.
### :returns: e^`me` - 1.
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or `me` is +inf, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.exp_m1() -> Me
    r: Me = me.exp_m1_unchecked()
    checked: Me = r.require_finite()
    return checked

### The natural logarithm of `me`, correctly rounded. {B16.ln_unchecked} gives the raw IEEE 754 result.
### :returns: ln(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is zero (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is negative or NaN.
@track_caller
routine B16.ln() -> Me
    r: Me = me.ln_unchecked()
    checked: Me = r.require_finite()
    return checked

### The base-2 logarithm of `me`, correctly rounded. {B16.log2_unchecked} gives the raw IEEE 754 result.
### :returns: log2(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is zero (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is negative or NaN.
@track_caller
routine B16.log2() -> Me
    r: Me = me.log2_unchecked()
    checked: Me = r.require_finite()
    return checked

### The base-10 logarithm of `me`, correctly rounded. {B16.log10_unchecked} gives the raw IEEE 754 result.
### :returns: log10(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is zero (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is negative or NaN.
@track_caller
routine B16.log10() -> Me
    r: Me = me.log10_unchecked()
    checked: Me = r.require_finite()
    return checked

### ln(1 + `me`), correctly rounded and accurate near 0. {B16.ln_1p_unchecked} gives the raw IEEE 754 result.
### :returns: ln(1 + `me`).
### :throws: Crashes with `NumericOverflowError` when `me` is -1 (the logarithm is -inf) or +inf, and with
###     `NumericDomainError` when `me` is below -1 or NaN.
@track_caller
routine B16.ln_1p() -> Me
    r: Me = me.ln_1p_unchecked()
    checked: Me = r.require_finite()
    return checked

### The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded. {B16.log_unchecked} gives the raw IEEE 754 result.
### :param base: The base of the logarithm.
### :returns: log base `base` of `me`.
### :throws: Crashes with `NumericOverflowError` when the quotient is infinite (`me` zero or +inf, or `base` 1), and
###     with `NumericDomainError` when it is NaN: a negative or NaN argument, or both logarithms zero or both
###     infinite.
@track_caller
routine B16.log(base: Me) -> Me
    r: Me = me.log_unchecked(base)
    checked: Me = r.require_finite()
    return checked

### `me` raised to the power `exponent`, correctly rounded. {B16.powf_unchecked} gives the raw IEEE 754 result.
### :param exponent: The exponent.
### :returns: `me` ^ `exponent`.
### :throws: Crashes with `NumericOverflowError` when the power is too large for B16, or infinite (a zero `me` with a
###     negative `exponent`), and with `NumericDomainError` when it is NaN: a negative `me` with an `exponent` that
###     isn't an integer, or a NaN operand.
@track_caller
routine B16.powf(exponent: Me) -> Me
    r: Me = me.powf_unchecked(exponent)
    checked: Me = r.require_finite()
    return checked

### `me` raised to the integer power `n`, correctly rounded. {B16.powi_unchecked} gives the raw IEEE 754 result.
### :param n: The exponent.
### :returns: `me` ^ `n`.
### :throws: Crashes with `NumericOverflowError` when the power is too large for B16, or infinite (a zero `me` with a
###     negative `n`), and with `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.powi(n: S32) -> Me
    r: Me = me.powi_unchecked(n)
    checked: Me = r.require_finite()
    return checked

### tan(pi * `me`), correctly rounded. {B16.tan_pi_unchecked} gives the raw IEEE 754 result.
### :returns: tan(pi * `me`).
### :throws: Crashes with `NumericOverflowError` when `me` is an odd multiple of 0.5 (a pole), and with
###     `NumericDomainError` when `me` is infinite or NaN.
@track_caller
routine B16.tan_pi() -> Me
    r: Me = me.tan_pi_unchecked()
    checked: Me = r.require_finite()
    return checked

### The arcsine of `me` in radians, correctly rounded. {B16.asin_unchecked} gives the raw IEEE 754 result.
### :returns: asin(`me`), in [-pi/2, pi/2].
### :throws: Crashes with `NumericDomainError` when `me` is outside [-1, 1] or NaN.
@track_caller
routine B16.asin() -> Me
    r: Me = me.asin_unchecked()
    checked: Me = r.require_finite()
    return checked

### The arccosine of `me` in radians, correctly rounded. {B16.acos_unchecked} gives the raw IEEE 754 result.
### :returns: acos(`me`), in [0, pi].
### :throws: Crashes with `NumericDomainError` when `me` is outside [-1, 1] or NaN.
@track_caller
routine B16.acos() -> Me
    r: Me = me.acos_unchecked()
    checked: Me = r.require_finite()
    return checked

### The hyperbolic sine of `me`, correctly rounded. {B16.sinh_unchecked} gives the raw IEEE 754 result.
### :returns: sinh(`me`).
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or `me` is infinite, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.sinh() -> Me
    r: Me = me.sinh_unchecked()
    checked: Me = r.require_finite()
    return checked

### The hyperbolic cosine of `me`, correctly rounded. {B16.cosh_unchecked} gives the raw IEEE 754 result.
### :returns: cosh(`me`).
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or `me` is infinite, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.cosh() -> Me
    r: Me = me.cosh_unchecked()
    checked: Me = r.require_finite()
    return checked

### The inverse hyperbolic cosine of `me`, correctly rounded. {B16.acosh_unchecked} gives the raw IEEE 754 result.
### :returns: acosh(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is +inf, and with `NumericDomainError` when `me` is below 1
###     or NaN.
@track_caller
routine B16.acosh() -> Me
    r: Me = me.acosh_unchecked()
    checked: Me = r.require_finite()
    return checked

### The inverse hyperbolic tangent of `me`, correctly rounded. {B16.atanh_unchecked} gives the raw IEEE 754 result.
### :returns: atanh(`me`).
### :throws: Crashes with `NumericOverflowError` when `me` is 1 or -1 (the result is infinite), and with
###     `NumericDomainError` when `me` is outside [-1, 1] or NaN.
@track_caller
routine B16.atanh() -> Me
    r: Me = me.atanh_unchecked()
    checked: Me = r.require_finite()
    return checked

### The gamma function of `me`, correctly rounded. {B16.gamma_unchecked} gives the raw IEEE 754 result.
### :returns: Gamma(`me`).
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16, `me` is a zero (a pole), or
###     `me` is +inf, and with `NumericDomainError` when `me` is a negative integer, -inf, or NaN.
@track_caller
routine B16.gamma() -> Me
    r: Me = me.gamma_unchecked()
    checked: Me = r.require_finite()
    return checked

### ln(|Gamma(`me`)|), correctly rounded. {B16.ln_gamma_unchecked} gives the raw IEEE 754 result.
### :returns: ln(|Gamma(`me`)|).
### :throws: Crashes with `NumericOverflowError` when `me` is zero or a negative integer (a pole), the result is too
###     large for B16, or `me` is infinite, and with `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.ln_gamma() -> Me
    r: Me = me.ln_gamma_unchecked()
    checked: Me = r.require_finite()
    return checked

### Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to B16). {B16.to_degrees_unchecked} gives the raw IEEE 754 result.
### :returns: `me` in degrees, rounded once.
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or `me` is infinite, and with
###     `NumericDomainError` when `me` is NaN.
@track_caller
routine B16.to_degrees() -> Me
    r: Me = me.to_degrees_unchecked()
    checked: Me = r.require_finite()
    return checked

### The tangent of `me` (radians), correctly rounded. {B16.tan_unchecked} gives the raw IEEE 754 result.
### :returns: tan(`me`).
### :throws: Crashes with `NumericOverflowError` when the tangent is too large for B16 (177.5 is such an argument),
###     and with `NumericDomainError` when `me` is infinite or NaN.
@track_caller
routine B16.tan() -> Me
    r: Me = me.tan_unchecked()
    checked: Me = r.require_finite()
    return checked

### sqrt(x^2 + y^2), correctly rounded, with no overflow on the way. {hypot_unchecked} gives the raw IEEE 754 result.
### :param x: The first leg.
### :param y: The second leg.
### :returns: sqrt(x^2 + y^2).
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or a leg is infinite, and
###     with `NumericDomainError` when a leg is NaN and none is infinite.
@track_caller
routine hypot(x: B16, y: B16) -> B16
    r: B16 = hypot_unchecked(x: x, y: y)
    checked: B16 = r.require_finite()
    return checked

### sqrt(x^2 + y^2 + z^2), correctly rounded, with no overflow on the way. {hypot_unchecked} gives the raw IEEE 754 result.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: sqrt(x^2 + y^2 + z^2).
### :throws: Crashes with `NumericOverflowError` when the result is too large for B16 or a leg is infinite, and
###     with `NumericDomainError` when a leg is NaN and none is infinite.
@track_caller
routine hypot(x: B16, y: B16, z: B16) -> B16
    r: B16 = hypot_unchecked(x: x, y: y, z: z)
    checked: B16 = r.require_finite()
    return checked
