# Tessera stdlib: Maybe[T] and KVPair[TKey, TValue]
#
# Maybe[T] is a value that may be absent: a T, or None when there is none. `try` in front of a failable call gives
# one, `try iter.emit()` included. A T goes where a Maybe[T] is expected as it is, and so does None():
#
#     return(value)
#     return(None())
#
# Read it with when:
#
#     when item
#         is S64 as value => use(value)
#         is None => done()
#
# KVPair[TKey, TValue] is a plain value pair used by Dict and SortedDict iterators.

module System

# -- Maybe ---------------------------------------------------------------------

### A value that may be absent: a `T`, or `Unit` when there is none. A `T` or `Unit()` goes where a `Maybe[T]` is
### expected as it is, and `when` observes which with `is T as value` / `is Unit`. `try` in front of a failable call
### gives one. A `Maybe[None]` can't exist (both branches would be `Unit`), nor a `Maybe[Maybe[T]]`.
### :typeparam T: The type of the present value.
@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
variant Maybe[T]
needs T: typename
    T
    None

### Releases nothing: a `Maybe` holds no memory of its own.
routine @Maybe[T].destruct() -> None
needs T: typename
    return

### Whether `me` holds a value.
### :typeparam T: The type of the present value.
### :returns: `true` for a `T`, `false` for `Unit`.
routine Maybe[T].is_present() -> Bool
needs T: typename
    when me
        is T => return true
        is None => return false

### Whether `me` holds no value.
### :typeparam T: The type of the present value.
### :returns: `true` for `Unit`, `false` for a `T`.
routine Maybe[T].is_absent() -> Bool
needs T: typename
    when me
        is T => return false
        is None => return true

### The value. Crashes if it's absent.
### :returns: The present value.
### :throws: Crashes with `AbsentValueError` when `me` is `Unit`.
@track_caller
routine Maybe[T].unwrap() -> T
needs T: typename
    when steal me
        is T as value => return value
        is None => throw AbsentValueError()

### The value if present, otherwise `default`.
### :param default: The value to return when `me` is `Unit`.
### :returns: The present value, or `default`.
routine Maybe[T].unwrap_or(default: T) -> T
needs T: typename
    when me
        is T as value => return value
        is None => return default

# -- KVPair --------------------------------------------------------------------

### Yielded by Dict and SortedDict iterators.
@derive(Equatable, Hashable)
record KVPair[TKey, TValue]
needs TKey: typename, TValue: typename
    key: TKey
    value: TValue

### Makes a `KVPair` from its fields.
### :param key: Its `key`.
### :param value: Its `value`.
### :returns: The new value.
common routine KVPair[TKey, TValue].construct(key: TKey, value: TValue) -> Me
needs TKey: typename, TValue: typename
    return Me(key, value)

### Releases nothing: a `KVPair` holds no memory of its own.
routine @KVPair[TKey, TValue].destruct() -> None
needs TKey: typename, TValue: typename
    return
