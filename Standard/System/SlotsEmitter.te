# Tessera stdlib collection: SlotsEmitter[T, COUNT]
#
# Forward emitter over a Slots[T, COUNT] held behind a pointer. The count is
# stored in the record at construction, so emit() needs no generic arithmetic.
#
# Satisfies concept SlotEmitter[T, SlotsEmitter[T, COUNT]] (and so Emitter).

module System

### A forward emitter over a {Slots[T, COUNT]} held behind a pointer. The count `COUNT` is stored once at construction, and the Slots must outlive the emitter.
### :typeparam T: The element type.
### :typeparam COUNT: The number of elements.
record SlotsEmitter[T, COUNT]
obeys SlotEmitter[T, SlotsEmitter[T, COUNT]]
needs T: typename, COUNT: U64
    data: @T  # bitcast of the original @Slots[T, COUNT]
    index: U64
    count: U64  # = COUNT, resolved at monomorphisation

### Creates an emitter positioned before the first element of `arr`.
### :param arr: The array to walk.
### :returns: A new emitter at index `0`.
common routine SlotsEmitter[T, COUNT].construct(arr: @Slots[T, COUNT]) -> Me
needs T: typename, COUNT: U64
    data: @T = bitcast[@Slots[T, COUNT], @T](arr)
    emitter: Me = Me(data: data, index: 0, count: COUNT)
    return emitter

### An emitter over the array, at its first element: `e: &SlotsEmitter[T, COUNT] <- array.emitter()`, then `for x in e`.
### :returns: A new {SlotsEmitter[T, COUNT]} over `me`.
routine @Slots[T, COUNT].emitter() -> SlotsEmitter[T, COUNT]
needs T: typename, COUNT: U64
    emitter: SlotsEmitter[T, COUNT] = SlotsEmitter[T, COUNT].construct(me)
    return emitter

### Yields the next element and advances the emitter.
### :returns: The next element, in index order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @SlotsEmitter[T, COUNT].emit() -> T
needs T: typename, COUNT: U64
    index: U64 = me.index.peek()

    count: U64 = me.count.peek()
    if index >= count
        throw AbsentValueError()
    data: @T = me.data.peek()
    value: T = data.stride(index).peek()
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the emitter.
### :returns: The address of the next element, in index order.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @SlotsEmitter[T, COUNT].next() -> @T
needs T: typename, COUNT: U64
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = me.data.peek().stride(index)
    return element
