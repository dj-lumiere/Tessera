# Tessera stdlib: None — the type with exactly one value
#
# Maps to the empty LLVM struct {} (zero size). Unlike None, None values
# exist: they can be bound, passed, stored in fields, and used as a generic
# argument. Its value is written None(). It is the branch of Maybe[T] that
# holds nothing, and Check[None] is what `check` gives for a failable routine
# that returns nothing.

module System

### The type with exactly one value, mapped to the empty LLVM struct `{}`. Unlike `Void` it can be bound, passed, and stored, so it fills a generic slot that needs no payload, such as `Maybe[None]`.
record None
obeys Equatable[None], Hashable[None], Comparable[None]
    nothing

# -- equality, hashing ---------------------------------------------------------

### There is only one `Unit` value, so every pair is equal.
### :param other: The other `Unit`.
### :returns: Always `true`.
routine None.eq(other: Me) -> Bool
    return true

### Hashes the one `Unit` value. Every `Unit` hashes the same.
### :returns: A constant 64-bit hash.
routine None.hash() -> U64
    h: U64 = siphash24(value: 0, key: hash_key())
    return h

### None values are all equal.
### :param other: The value to compare with.
### :returns: Always 0.
routine None.compare(other: Me) -> S32
    return 0
