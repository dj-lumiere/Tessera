# Tessera stdlib: the startup steps of a program for a target without an operating system
#
# Such a program's entry is `when_power_on`: the reset sends the core there. The stack pointer is part of its prologue
# (on Cortex-M the core loads it from the vector table's first word, elsewhere the builder's first instructions load
# `__stack_top`), then its body turns the managers on, here: GlobalManager.prepare() (.bss zeroed, .data copied where
# the code runs from flash, 32-bit ARM and RISC-V), enable_fpu when the target has a floating-point unit the build may
# use, and the CpuEventManager's vector table (CpuEvents.te), which prepare_core runs together, and then whatever the
# board needs. When it returns, start runs, then halt. A program without when_power_on gets one that runs
# prepare_core. A global's first value is build-time data in the program image, so nothing runs before these steps,
# and none of them reads a global before GlobalManager.prepare() has run.
#
# The link script defines `__stack_top`, which those first instructions load. The globals' symbols are the
# GlobalManager's (GlobalManager.te in Standard/System/Memory).

module Standard/System/Cpu

### Turns SSE on: CR0.EM off and CR0.MP on, then CR4.OSFXSR and CR4.OSXMMEXCPT.
@target(arch: "x86_64", os: "none")
routine enable_fpu() -> None
    allow_sse()
    return

### Turns the FP and SIMD registers on at EL1: CPACR_EL1.FPEN = 0b11.
@target(arch: "aarch64", os: "none")
routine enable_fpu() -> None
    allow_fp_access()
    return

### Turns the FPU on in machine mode: mstatus.FS = Initial.
@target(arch: "riscv32", os: "none")
routine enable_fpu() -> None
    allow_fp_access()
    return

### Turns a Cortex-M FPU on: full access to coprocessors 10 and 11 in CPACR (0xE000ED88), then a data and an
### instruction barrier, so the next instruction may use it. Cortex-M runs Thumb code only, so the steps for it are
### there for a Thumb build.
@target(arch: "arm", os: "none")
@feature("thumb-mode")
routine enable_fpu() -> None
    local cpacr: @U32 = inttoptr[U64, @U32](0xE000ED88)

    access: U32 = cpacr.peek_volatile()
    cpacr.poke_volatile(access | 0xF00000)
    data_barrier()
    instruction_barrier()
    return

### Turns the managers on before anything reads a global: the GlobalManager and the FPU.
@target(arch: "x86_64", os: "none")
@feature("sse")
routine prepare_core() -> None
    GlobalManager.prepare()
    enable_fpu()
    return

### Turns the managers on before anything reads a global: the GlobalManager.
@target(arch: "x86_64", os: "none")
@feature(not "sse")
routine prepare_core() -> None
    GlobalManager.prepare()
    return

### Turns the managers on before anything reads a global: the GlobalManager, the FPU, and the CpuEventManager's vector
### table.
@target(arch: "aarch64", os: "none")
@feature("fp-armv8")
routine prepare_core() -> None
    GlobalManager.prepare()
    enable_fpu()
    CpuEventManager.install()
    return

### Turns the managers on before anything reads a global: the GlobalManager and the CpuEventManager's vector table.
@target(arch: "aarch64", os: "none")
@feature(not "fp-armv8")
routine prepare_core() -> None
    GlobalManager.prepare()
    CpuEventManager.install()
    return

### Turns the managers on before anything reads a global: the GlobalManager and the FPU. The CpuEventManager's vector
### table is the one the core reads at reset.
@target(arch: "arm", os: "none")
@feature("vfp2sp")
routine prepare_core() -> None
    GlobalManager.prepare()
    enable_fpu()
    return

### Turns the managers on before anything reads a global: the GlobalManager. The CpuEventManager's vector table is the
### one the core reads at reset.
@target(arch: "arm", os: "none")
@feature(not "vfp2sp")
routine prepare_core() -> None
    GlobalManager.prepare()
    return

### Turns the managers on before anything reads a global: the GlobalManager, the FPU, and the CpuEventManager's trap
### entry.
@target(arch: "riscv32", os: "none")
@feature("f")
routine prepare_core() -> None
    GlobalManager.prepare()
    enable_fpu()
    CpuEventManager.install()
    return

### Turns the managers on before anything reads a global: the GlobalManager and the CpuEventManager's trap entry.
@target(arch: "riscv32", os: "none")
@feature(not "f")
routine prepare_core() -> None
    GlobalManager.prepare()
    CpuEventManager.install()
    return

### Halts the core for good once `start` has returned: it waits for interrupts, forever. On Cortex-M the vector
### table's system exceptions come here too.
@target(os: "none")
@noreturn
secret routine halt() -> None
    while true
        wait_for_interrupt()

### CR0: EM (bit 2) off, MP (bit 1) on. CR4: OSFXSR (bit 9) and OSXMMEXCPT (bit 10) on.
@target(arch: "x86_64", os: "none")
@external("asm")
secret routine allow_sse() -> None
    block entry()
        mov[U64](R0, CR0)  # mov rax, cr0
        and[U64](R0, -5)  # and rax, ~4
        or[U64](R0, 2)  # or rax, 2
        mov[U64](CR0, R0)  # mov cr0, rax
        mov[U64](R0, CR4)  # mov rax, cr4
        or[U64](R0, 0x600)  # or rax, 0x600
        mov[U64](CR4, R0)  # mov cr4, rax
        return

### CPACR_EL1.FPEN (bits 20 and 21) on, then an instruction barrier.
@target(arch: "aarch64", os: "none")
@external("asm")
secret routine allow_fp_access() -> None
    block entry()
        mrs[U64](R0, CPACR_EL1)  # mrs x0, cpacr_el1
        orr[U64, U64](R0, R0, 0x300000)  # orr x0, x0, #0x300000
        msr[U64](CPACR_EL1, R0)  # msr cpacr_el1, x0
        isb()  # isb
        return

### mstatus.FS (bits 13 and 14) to Initial, 0b01.
@target(arch: "riscv32", os: "none")
@external("asm")
secret routine allow_fp_access() -> None
    block entry()
        lui[U32](R5, 2)  # lui t0, 2: t0 = 0x2000
        csrrs[U32, U32](ZERO, mstatus, R5)  # csrs mstatus, t0
        return

### Waits for an interrupt.
@target(arch: "x86_64", os: "none")
@external("asm")
secret routine wait_for_interrupt() -> None
    block entry()
        hlt()  # hlt
        return

### Waits for an interrupt.
@target(arch: "aarch64", os: "none")
@external("asm")
secret routine wait_for_interrupt() -> None
    block entry()
        wfi()  # wfi
        return

### Waits for an interrupt.
@target(arch: "riscv32", os: "none")
@external("asm")
secret routine wait_for_interrupt() -> None
    block entry()
        wfi()  # wfi
        return

### Waits for an interrupt.
@target(arch: "arm", os: "none")
@feature("thumb-mode")
@external("asm")
secret routine wait_for_interrupt() -> None
    block entry()
        wfi()  # wfi
        return

### Waits: an ARM-mode core before ARMv6K has no `wfi` hint, so the halt loop only spins there. The generated entry is
### for Cortex-M, which has it.
@target(arch: "arm", os: "none")
@feature(not "thumb-mode")
secret routine wait_for_interrupt() -> None
    return

### A data synchronization barrier: every memory access before it completes first.
@target(arch: "arm", os: "none")
@feature("thumb-mode")
@external("asm")
secret routine data_barrier() -> None
    block entry()
        dsb(SY)  # dsb sy
        return

### An instruction synchronization barrier: the instructions after it are fetched again.
@target(arch: "arm", os: "none")
@feature("thumb-mode")
@external("asm")
secret routine instruction_barrier() -> None
    block entry()
        isb(SY)  # isb sy
        return
