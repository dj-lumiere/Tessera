# Tessera stdlib collection: PartialItems[T, COUNT], up to COUNT values in a row with a count
#
# An Items[T, COUNT] (Items.te) with the number of places in use kept beside it: the room is fixed at build time and
# lives in the value, no memory from a manager, and the count changes while the program runs.

module System

### Up to `COUNT` values of `T` in a row, stored in place, with `used` of them in use: the room is fixed at build time and lives in the value (no memory from a manager and no address to follow), and the count changes while the program runs. A `PartialItems` is a record, so it is a value (copied with `=`), and its elements hold nothing with a release duty: entities go in a {PartialSlots[T, COUNT]}. Adding to a full one throws {FullCollectionError}, which `try` and `check` receive. On a target without an OS, one sized to the greatest depth of a walk is the stack of that walk.
### :typeparam T: The element type, a type whose values hold nothing with a release duty.
### :typeparam COUNT: The most elements held, fixed at build time.
record PartialItems[T, COUNT]
obeys Representable[PartialItems[T, COUNT]] when T obeys Diagnosable
obeys Diagnosable[PartialItems[T, COUNT]] when T obeys Diagnosable
needs RecordType T, U64 COUNT
    places: Items[T, COUNT]
    used: U64

### Makes a `PartialItems` that holds no element yet.
### :returns: An empty `PartialItems` with room for `COUNT` elements.
common routine PartialItems[T, COUNT].construct() -> Me
needs RecordType T, U64 COUNT
    lateinit places: &Items[T, COUNT]
    places.zeroinit(1)
    return Me(places: places.load(), used: 0)

### The number of elements held.
### :returns: The count, at most `COUNT`.
routine @PartialItems[T, COUNT].count() -> U64
needs RecordType T, U64 COUNT
    return me.used.peek()

### The most elements this holds, the buildtime constant `COUNT`.
### :returns: `COUNT`.
routine @PartialItems[T, COUNT].capacity() -> U64
needs RecordType T, U64 COUNT
    return COUNT

### Whether no place holds an element.
### :returns: `true` when the count is `0`.
routine @PartialItems[T, COUNT].is_empty() -> Bool
needs RecordType T, U64 COUNT
    return me.used.peek() == 0

### Whether every place holds an element, so `add_last` would throw.
### :returns: `true` when the count is `COUNT`.
routine @PartialItems[T, COUNT].is_full() -> Bool
needs RecordType T, U64 COUNT
    return me.used.peek() >= COUNT

### Puts `value` in the next place, after the elements held.
### :param value: The element to add.
### :throws: Throws `FullCollectionError` when all `COUNT` places hold an element.
@track_caller
routine @PartialItems[T, COUNT].add_last(value: T) -> None
needs RecordType T, U64 COUNT
    used: U64 = me.used.peek()
    if used >= COUNT
        throw FullCollectionError(capacity: COUNT)
    me.places.getslot(used).poke(steal value)
    me.used.poke(used + 1)
    return

### Adds the steps that run next, given in the order they run, so that `remove_last` gives them back in that order:
### `stack.add_next([a, b, c])` leaves `a` at the back, then `b`, then `c`. When they do not all fit, none is added.
### :typeparam N: The number of steps.
### :param steps: The steps, in the order they should come back out.
### :throws: Throws `FullCollectionError` when there is not room for every step.
@track_caller
routine @PartialItems[T, COUNT].add_next[N](steps: Items[T, N]) -> None
needs RecordType T, U64 COUNT, U64 N
    used: U64 = me.used.peek()
    if N > COUNT - used
        throw FullCollectionError(capacity: COUNT)
    for i in 0 til N
        step: T = steps.getitem(N - 1 - i)
        me.places.getslot(used + i).poke(step)
    me.used.poke(used + N)
    return

### Removes the last element and returns it.
### :returns: The removed element.
### :throws: Throws `AbsentValueError` when no place holds an element.
routine @PartialItems[T, COUNT].remove_last() -> T
needs RecordType T, U64 COUNT
    used: U64 = me.used.peek()
    if used == 0
        throw AbsentValueError()
    me.used.poke(used - 1)
    return steal me.places.getslot(used - 1).stride(0)

### Reads the element at `index`.
### :param index: The zero-based position to read.
### :returns: A copy of the element.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
routine @PartialItems[T, COUNT].getitem(index: U64) -> T
needs RecordType T, U64 COUNT
    used: U64 = me.used.peek()
    if index >= used
        throw IndexOutOfBoundsError(index, count: used)
    value: T = me.places.getslot(index).peek()
    return value

### Overwrites the element at `index` with `value`.
### :param index: The zero-based position to write.
### :param value: The value to store.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
routine @PartialItems[T, COUNT].setitem(index: U64, value: T) -> None
needs RecordType T, U64 COUNT
    used: U64 = me.used.peek()
    if index >= used
        throw IndexOutOfBoundsError(index, count: used)
    me.places.getslot(index).poke(steal value)
    return

### Removes every element. The places are free for `add_last` again.
routine @PartialItems[T, COUNT].clear() -> None
needs RecordType T, U64 COUNT
    me.used.poke(0)
    return

### The elements held, borrowed: valid until the `PartialItems` is changed in shape or ends.
### :returns: A span of the `count` elements.
routine @PartialItems[T, COUNT].getview() -> @[T]
needs RecordType T, U64 COUNT
    first: @T = bitcast[@Me, @T](me)
    return @[T].construct(data: first, count: me.used.peek())

# -- text ----------------------------------------------------------------------

### The elements held in order, each diagnosed (strings quoted): [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @PartialItems[T, COUNT].represent_into[TWriter](out: @TWriter) -> None
needs RecordType T, U64 COUNT, T obeys Diagnosable, TWriter obeys Writer
    write_str(out, text: "[")
    for i in 0 til me.used.peek()
        if i != 0
            write_str(out, text: ", ")
        me.places.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return

### The elements held in order, each diagnosed: [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @PartialItems[T, COUNT].diagnose_into[TWriter](out: @TWriter) -> None
needs RecordType T, U64 COUNT, T obeys Diagnosable, TWriter obeys Writer
    write_str(out, text: "[")
    for i in 0 til me.used.peek()
        if i != 0
            write_str(out, text: ", ")
        me.places.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return
