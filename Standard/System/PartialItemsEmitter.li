# Lapila stdlib collection: PartialItemsEmitter[T, COUNT]
#
# Forward emitter over the elements held by a PartialItems[T, COUNT] behind a pointer. The count held is stored in the
# record at construction.
#
# Satisfies concept SlotEmitter[PartialItemsEmitter[T, COUNT], T] (and so Emitter).

module System

### A forward emitter over the elements a {PartialItems[T, COUNT]} holds, behind a pointer. The count held is stored once at construction, and the Items must outlive the emitter and keep its shape while the emitter walks.
### :typeparam T: The element type.
### :typeparam COUNT: The most elements the walked value holds.
record PartialItemsEmitter[T, COUNT]
obeys SlotEmitter[PartialItemsEmitter[T, COUNT], T]
needs RecordType T, U64 COUNT
    data: @T  # the first place of the original @PartialItems[T, COUNT]
    index: U64
    count: U64  # = the elements held when the emitter was made

### An emitter over the elements held, at the first: `e: &PartialItemsEmitter[T, COUNT] <- xs.emitter()`, then `for x in e`.
### :returns: A new {PartialItemsEmitter[T, COUNT]} over `me`.
routine @PartialItems[T, COUNT].emitter() -> PartialItemsEmitter[T, COUNT]
needs RecordType T, U64 COUNT
    data: @T = bitcast[@Me, @T](me)
    emitter: PartialItemsEmitter[T, COUNT] = PartialItemsEmitter[T, COUNT](data: data, index: 0,
        count: me.used.peek())
    return emitter

### Yields the next element held and advances the emitter.
### :returns: The next element, in index order.
### :throws: Throws `AbsentValueError` after the last element held has been yielded.
routine @PartialItemsEmitter[T, COUNT].emit() -> T
needs RecordType T, U64 COUNT
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    data: @T = me.data.peek()
    value: T = data.stride(index).peek()
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the emitter.
### :returns: The address of the next element, in index order.
### :throws: Throws `AbsentValueError` after the last element held has been handed out.
routine @PartialItemsEmitter[T, COUNT].next() -> @T
needs RecordType T, U64 COUNT
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = me.data.peek().stride(index)
    return element
