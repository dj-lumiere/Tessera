# Tessera stdlib: BytesIter
#
# Forward iterator over the raw bytes (U8) of a @[Byte].
# emit() throws AbsentValueError after the last byte.
#
# Satisfies concept Iterator[U8, BytesIter].

module Standard/System/Text

### Iterator over the raw bytes (`U8`) of a {@[Byte]}. It satisfies `Iterator[U8, BytesIter]`, and `emit` yields each byte in order and then throws `AbsentValueError`.
secret record BytesIter
obeys Iterator[U8, BytesIter]
    str: @[Byte]
    index: U64

### Starts an iterator at the first byte of `str`.
### :param str: The view to iterate. It is not copied, so its bytes must outlive the iterator.
### :returns: An iterator positioned before the first element.
common routine BytesIter.construct(str: @[Byte]) -> Me
    iter: Me = Me(str: str, index: 0)
    return iter

### Yields the next element and advances the iterator.
### :returns: The next element, in order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @BytesIter.emit() -> U8
    local index: U64 = me.index.peek()
    local str: @[Byte] = me.str.peek()

    str_len: U64 = str.count
    if index >= str_len
        throw AbsentValueError()
    data: @Byte = str.data
    byte: U8 = Byte.to[U8](data.stride(index).peek())
    me.index.poke(index + 1)
    return byte
