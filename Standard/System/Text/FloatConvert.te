# Tessera stdlib: reading floats from text
#
# text.to[B64]() (and B32, B16, BF16, B128) reads decimal text and
# rounds it correctly (to nearest, ties to even), however many digits it has.
# It is failable: bad text throws, and a bare call stops the program on it.
#
#     [+-] digits [. digits] [(e|E) [+-] digits]      at least one mantissa digit
#     [+-] inf | infinity | nan                        any letter case
#
# "5." and ".5" are accepted, whitespace is not. It throws EmptyTextError for
# "" and InvalidValueError for anything else that doesn't match (Parsable.te).
#
# The method is exact, not fast: the value becomes a fraction N / D of big
# naturals, and a bit-by-bit division gives the significand plus a remainder
# for rounding. Only the first significant digits are kept. Later ones only
# record whether any was nonzero, which is enough to break a tie as long as
# every exactly-halfway decimal fits in the kept digits: 767 digits for B64,
# 11,563 for B128. So B64 and the smaller formats keep 800 digits in a
# BigNat[72], and B128 keeps 11,600 in a BigNat[864] (Standard/System/Numerics/BigNat.te).

module System/Text

### What kind of value a parsed decimal text denotes: an ordinary number, an infinity, or a NaN.
choice DecimalKind: U8
    FINITE
    INFINITY
    NAN

### The parsed text: value = digits × 10^exponent, digits kept in a BigNat.
record DecimalParts
    kind: DecimalKind
    negative: Bool
    kept: S64  # significant digits kept
    exponent: S64
    sticky: Bool  # a nonzero digit was dropped after the kept ones

# -- text ----------------------------------------------------------------------

### True when the byte is an ASCII digit `0` to `9`.
### :param c: The byte to test.
### :returns: True when the byte is between `0` and `9`.
routine is_ascii_digit(c: Byte) -> Bool
    return b'0' <= c <= b'9'

### Is text[0..count) word, ignoring ASCII letter case? word must be lowercase letters.
### :param text: The first byte of the text.
### :param count: The number of bytes of text to compare.
### :param word: The lowercase word.
### :returns: True when the text and `word` have the same length and match ignoring ASCII case.
routine matches_word(text: @Byte, count: U64, word: @[Byte]) -> Bool
    letters: @Byte = word.data

    word_count: U64 = word.count
    if count == word_count
        each i in 0 til count
            c: Byte = text.stride(i).peek()
            w: Byte = letters.stride(i).peek()
            folded: Byte = c | 0x20
            if folded == w
                continue
            return false
        then
            return true
    else
        return false

### Reads text into DecimalParts, accumulating the kept digits in digits.
### :typeparam LIMBS: The number of 64-bit limbs of the BigNat holding the digits.
### :param text: The text to read.
### :param digits: Where the kept digits accumulate (set to 0 first).
### :param max_kept: The most significant digits to keep. Later ones only raise the exponent and the sticky flag.
### :param target: The name of the float type being read, for the failure.
### :returns: The parsed parts.
### :throws: Throws `EmptyTextError` for empty text and `InvalidValueError` for text that does not match.
failable routine parse_decimal[LIMBS](text: @[Byte], digits: @BigNat[LIMBS], max_kept: S64,
    target: @[Byte]) -> DecimalParts
needs LIMBS: U64
    digits.set(U64.MIN)
    count: U64 = text.count
    if count == 0
        throw EmptyTextError(text, target)

    data: @Byte = text.data
    sign_char: Byte = data.stride(0).peek()
    negative: Bool = sign_char == b'-'
    plus: Bool = sign_char == b'+'
    skip: Bool = negative or plus
    start: U64 = skip.to[U64]()
    rest: @Byte = data.stride(start)
    left: U64 = count - start
    short_inf: Bool = matches_word(text: rest, count: left, word: "inf")
    long_inf: Bool = matches_word(text: rest, count: left, word: "infinity")
    is_inf: Bool = short_inf or long_inf
    if is_inf
        infinite_parts: DecimalParts = DecimalParts(kind: DecimalKind.INFINITY, negative, kept: 0,
            exponent: 0, sticky: false)
        return infinite_parts
    if matches_word(text: rest, count: left, word: "nan")
        nan_parts: DecimalParts = DecimalParts(kind: DecimalKind.NAN, negative, kept: 0,
            exponent: 0, sticky: false)
        return nan_parts

    # Integer digits, then fraction digits after a point. Leading zeros are skipped. An integer digit past the cap
    # raises the exponent, and each fraction digit kept, or each leading zero there, lowers it.
    until i >= count with i: U64 = start, kept: S64 = 0, exponent: S64 = 0, sticky: Bool = false, seen: Bool = false, fraction: Bool = false
        c: Byte = data.stride(i).peek()
        if c == b'.' and not fraction
            continue with i: i + 1, kept: kept, exponent: exponent, sticky: sticky, seen: seen, fraction: true
        if not is_ascii_digit(c)
            # After the mantissa only an exponent may follow: e or E, a sign, digits.
            if not seen
                throw InvalidValueError(text, target)
            mantissa: DecimalParts = DecimalParts(kind: DecimalKind.FINITE, negative, kept,
                exponent, sticky)
            return when check parse_decimal_exponent(text, at: i, mantissa, target)
                is DecimalParts as whole => whole

        code: U8 = c.to[U8]()
        d: U64 = (code - b'0'.to[U8]()).to[U64]()
        leading: Bool = kept == 0 and d == 0
        full: Bool = kept >= max_kept
        if leading
            skipped_exponent: S64 = when
                fraction => exponent - 1
                else => exponent
            continue with i: i + 1, kept: kept, exponent: skipped_exponent, sticky: sticky, seen: true, fraction: fraction
        if full
            dropped_exponent: S64 = when
                fraction => exponent
                else => exponent + 1
            continue with i: i + 1, kept: kept, exponent: dropped_exponent, sticky: sticky or d != 0, seen: true, fraction: fraction
        digits.mul_add(m: 10, addend: d)
        kept_exponent: S64 = when
            fraction => exponent - 1
            else => exponent
        continue with i: i + 1, kept: kept + 1, exponent: kept_exponent, sticky: sticky, seen: true, fraction: fraction
    then
        if not seen
            throw InvalidValueError(text, target)
        parts: DecimalParts = DecimalParts(kind: DecimalKind.FINITE, negative, kept, exponent,
            sticky)
        return parts

### Reads the exponent that may follow a decimal's mantissa: `e` or `E`, an optional sign, and digits. The exponent
### saturates at 1,000,000, far past any float's range.
### :param text: The whole text.
### :param at: The index of the first byte after the mantissa.
### :param mantissa: What the mantissa gave: its sign, its kept digits, its exponent, and its sticky flag.
### :param target: The name of the float type being read, for the failure.
### :returns: The parsed parts with the exponent added in.
### :throws: Throws `InvalidValueError` when anything but a complete exponent follows the mantissa.
secret failable routine parse_decimal_exponent(text: @[Byte], at: U64, mantissa: DecimalParts,
    target: @[Byte]) -> DecimalParts
    data: @Byte = text.data
    c: Byte = data.stride(at).peek()
    mark: Bool = c | 0x20 == b'e'
    if not mark
        throw InvalidValueError(text, target)

    sign_at: U64 = at + 1
    if sign_at >= text.count
        throw InvalidValueError(text, target)
    sign_char: Byte = data.stride(sign_at).peek()
    minus: Bool = sign_char == b'-'
    plus: Bool = sign_char == b'+'
    skip: U64 = (minus or plus).to[U64]()
    first: U64 = sign_at + skip
    if first >= text.count
        throw InvalidValueError(text, target)

    until i >= text.count with i: U64 = first, value: S64 = 0
        digit_char: Byte = data.stride(i).peek()
        if not is_ascii_digit(digit_char)
            throw InvalidValueError(text, target)
        code: U8 = digit_char.to[U8]()
        d: S64 = (code - b'0'.to[U8]()).to[S64]()
        appended: S64 = value * 10 + d
        continue with i: i + 1, value: appended.min(1000000)
    then
        signed: S64 = when
            minus => -value
            else => value
        parts: DecimalParts = DecimalParts(kind: DecimalKind.FINITE, negative: mantissa.negative,
            kept: mantissa.kept, exponent: mantissa.exponent + signed, sticky: mantissa.sticky)
        return parts

# -- rounding ------------------------------------------------------------------

### The IEEE bits, without the sign, of the float of `format` nearest to the parsed value.
### :typeparam LIMBS: The number of 64-bit limbs of the BigNat holding the digits: room for B64's decimal range (72
###     limbs) for B64 and the narrower formats, for B128's (320 or more) for B128.
### :param digits: The kept digits from {parse_decimal}, used as scratch.
### :param parts: The parsed parts.
### :param format: The float's format (B16, BF16, B32, B64, or B128).
### :returns: The float's bits without the sign (a quiet NaN for a NaN).
routine decimal_to_bits[LIMBS](digits: @BigNat[LIMBS], parts: DecimalParts,
    format: FloatFormat) -> U128
needs LIMBS: U64
    mantissa_bits: S64 = format.fraction_bits.to[S64]()
    bias: S64 = format.bias.to[S64]()
    exponent_max: S64 = format.exponent_max.to[S64]()
    # The decimal magnitudes (kept digits plus exponent) past which the result is infinity, or 0. B128 has its own,
    # and the narrower formats all take B64's: past them every format is infinity or 0, and inside them the numbers
    # stay inside the BigNat.
    wide: Bool = format.width > 64
    huge_from: S64 = when

        wide => 4933
        else => 310
    tiny_below: S64 = when
        wide => -4966
        else => -324
    infinity: U128 = exponent_max.to[U128]() << mantissa_bits.to[U128]()
    d: &BigNat[LIMBS] <- .hollow()
    a: &BigNat[LIMBS] <- .hollow()
    b: &BigNat[LIMBS] <- .hollow()
    t: &BigNat[LIMBS] <- .hollow()
    exponent: S64 = parts.exponent

    quiet: U128 = 1 << (mantissa_bits - 1).to[U128]()
    kind: DecimalKind = parts.kind
    when kind
        DecimalKind.INFINITY => return infinity
        DecimalKind.NAN => return infinity | quiet
        DecimalKind.FINITE =>
            # Below 10^tiny_below everything rounds to zero. From 10^huge_from up, to
            # infinity. In between, the numbers stay inside BigNat's capacity.
            zero: Bool = digits.is_zero()
            kept: S64 = parts.kept
            magnitude: S64 = kept + exponent
            huge: Bool = magnitude > huge_from
            when
                zero => return 0
                magnitude < tiny_below => return 0
                huge => return infinity
                else =>
                    # value = n / d exactly
                    one: U64 = 1
                    d.set(one)
                    if exponent >= 0
                        digits.mul_pow10(exponent.to[U64]())
                    else
                        d.mul_pow10(exponent.abs_diff(0).to[U64]())
                    # Pick the binary exponent e so that q = floor(value / 2^e) has
                    # mantissa_bits + 1 bits, or fewer at the subnormal floor.
                    num_bits: S64 = digits.bit_length().to[S64]()
                    log2: S64 = num_bits - d.bit_length().to[S64]()
                    floor: S64 = 1 - bias - mantissa_bits
                    unclamped: S64 = log2 - mantissa_bits - 1
                    # a / b = value / 2^e
                    loop with e: S64 = unclamped.max(floor)
                        a.copy_from(digits)
                        b.copy_from(d)
                        if e < 0
                            a.shift_left(e.abs_diff(0).to[U64]())
                        else
                            b.shift_left(e.to[U64]())
                        # The estimate can be one bit short. Then q has a bit too many: try e + 1.
                        q: U128 = a.div_small(divisor: b, scratch: t,
                            bits: (mantissa_bits + 3).to[U64]())
                        limit: U128 = 1 << (mantissa_bits + 1).to[U128]()
                        if q >= limit
                            continue with e: e + 1
                        # Round to nearest, ties to even. The remainder is in a. Compare 2a with b.
                        a.shift_left(1)
                        half: S32 = a.compare(b)
                        above: Bool = half > 0
                        tie: Bool = half == 0
                        sticky: Bool = parts.sticky
                        odd: Bool = q & 1 == 1
                        up2: Bool = above or (tie and (sticky or odd))
                        rounded: U128 = q + up2.to[U128]()
                        # rounding up can carry into a new bit
                        carry: Bool = rounded == 1 << (mantissa_bits + 1).to[U128]()
                        q2: U128 = when
                            carry => rounded >> 1
                            else => rounded
                        e2: S64 = e + carry.to[S64]()
                        hidden: U128 = 1 << mantissa_bits.to[U128]()
                        normal: Bool = q2 >= hidden
                        biased: S64 = when
                            normal => e2 + mantissa_bits + bias
                            else => 0
                        overflow: Bool = biased >= exponent_max
                        exponent_field: U128 = biased.to[U128]() << mantissa_bits.to[U128]()
                        bits: U128 = exponent_field | (q2 & hidden - 1)
                        if overflow
                            return infinity
                        return bits

# -- to ------------------------------------------------------------------------

### Converts decimal text to a B64, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
### :returns: The nearest float.
### :throws: Throws `EmptyTextError` for an empty string and `InvalidValueError` for anything else that does not match.
### :note: Overflow gives an infinity and underflow gives zero.
failable routine @[Byte].to[B64]() -> B64
    digits: &BigNat[72] <- .hollow()

    parts: DecimalParts = when check parse_decimal(text: me, digits, max_kept: 800, target: "B64")
        is DecimalParts as parsed => parsed
    magnitude: U64 = decimal_to_bits(digits, parts, format: B64.FORMAT.peek()).to[U64]()
    negative: Bool = parts.negative
    sign: U64 = when
        negative => 0x8000000000000000
        else => 0
    return .from_bits(magnitude | sign)

### Converts decimal text to a B32, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
### :returns: The nearest float.
### :throws: Throws `EmptyTextError` for an empty string and `InvalidValueError` for anything else that does not match.
### :note: Overflow gives an infinity and underflow gives zero.
failable routine @[Byte].to[B32]() -> B32
    digits: &BigNat[72] <- .hollow()

    parts: DecimalParts = when check parse_decimal(text: me, digits, max_kept: 800, target: "B32")
        is DecimalParts as parsed => parsed
    magnitude: U32 = decimal_to_bits(digits, parts, format: B32.FORMAT.peek()).to[U32]()
    negative: Bool = parts.negative
    sign: U32 = when
        negative => 0x80000000
        else => 0
    return .from_bits(magnitude | sign)

### Converts decimal text to a B16, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
### :returns: The nearest float.
### :throws: Throws `EmptyTextError` for an empty string and `InvalidValueError` for anything else that does not match.
### :note: Overflow gives an infinity and underflow gives zero.
failable routine @[Byte].to[B16]() -> B16
    digits: &BigNat[72] <- .hollow()

    parts: DecimalParts = when check parse_decimal(text: me, digits, max_kept: 800, target: "B16")
        is DecimalParts as parsed => parsed
    magnitude: U16 = decimal_to_bits(digits, parts, format: B16.FORMAT.peek()).to[U16]()
    negative: Bool = parts.negative
    sign: U16 = when
        negative => 0x8000
        else => 0
    return .from_bits(magnitude | sign)

### Converts decimal text to a BF16, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
### :returns: The nearest float.
### :throws: Throws `EmptyTextError` for an empty string and `InvalidValueError` for anything else that does not match.
### :note: Overflow gives an infinity and underflow gives zero.
failable routine @[Byte].to[BF16]() -> BF16
    digits: &BigNat[72] <- .hollow()

    parts: DecimalParts = when check parse_decimal(text: me, digits, max_kept: 800, target: "BF16")
        is DecimalParts as parsed => parsed
    magnitude: U16 = decimal_to_bits(digits, parts, format: BF16.FORMAT.peek()).to[U16]()
    negative: Bool = parts.negative
    sign: U16 = when
        negative => 0x8000
        else => 0
    return .from_bits(magnitude | sign)

### Converts decimal text to a B128, rounded correctly (to nearest, ties to even) however many digits it has. Accepts an optional sign, digits with an optional point and exponent, `inf`, `infinity` or `nan` in any letter case, and no whitespace.
### :returns: The nearest float.
### :throws: Throws `EmptyTextError` for an empty string and `InvalidValueError` for anything else that does not match.
### :note: Overflow gives an infinity and underflow gives zero.
failable routine @[Byte].to[B128]() -> B128
    digits: &BigNat[864] <- .hollow()

    parts: DecimalParts = when check parse_decimal(text: me, digits, max_kept: 11600,
        target: "B128")
        is DecimalParts as parsed => parsed
    # B128's largest value is about 1.19e4932 and its smallest subnormal 6.5e-4966.
    magnitude: U128 = decimal_to_bits(digits, parts, format: B128.FORMAT.peek())
    negative: Bool = parts.negative
    sign: U128 = when
        negative => B128_SIGN
        else => 0
    return b128_of(magnitude | sign)

# -- B128, faithful ------------------------------------------------------------
#
# text.to_faithful[B128]() trades correct rounding for speed and a small stack: the
# result is one of the two B128 values around the decimal (error below 1 ulp),
# and differs from to[B128] only when the decimal is within about 2^-7 ulp of
# a halfway point. No BigNat: the first 38 significant digits go into a U128,
# and the power of ten is a product of 10^(±2^i) taken from a table of 128-bit
# mantissas (each rounded to nearest), keeping the high 128 bits of every
# product. At most 13 products, 13 table roundings (2^-128 each), 13 dropped
# product halves (under 2^-127 each), and the digits past 38 (under 10^-37)
# add up to less than 2^-120 relative error, which 113-bit rounding turns into
# at most 0.5 + 2^-7 ulp.

### 128-bit mantissas of 10^(2^i) for i = 0 to 12, each normalized with its top bit set and rounded to nearest. Paired with `B128_POW10_POS_EXP`.
preset B128_POW10_POS_MANT: &Array[U128, 13] <- [0xA0000000000000000000000000000000,
    0xC8000000000000000000000000000000, 0x9C400000000000000000000000000000,
    0xBEBC2000000000000000000000000000, 0x8E1BC9BF040000000000000000000000,
    0x9DC5ADA82B70B59DF020000000000000, 0xC2781F49FFCFA6D53CBF6B71C76B25FB,
    0x93BA47C980E98CDFC66F336C36B10137, 0xAA7EEBFB9DF9DE8DDDBB901B98FEEAB8,
    0xE319A0AEA60E91C6CC655C54BC5058F9, 0xC976758681750C17650D3D28F18B50CE,
    0x9E8B3B5DC53D5DE4A74D28CE329ACE52, 0xC46052028A20979AC94C153F804A4A92]
### The binary exponents for `B128_POW10_POS_MANT`: 10^(2^i) is about mantissa × 2^exponent.
preset B128_POW10_POS_EXP: &Array[S64, 13] <- [-124, -121, -114, -101, -74, -21, 85, 298, 723, 1573,
    3274, 6676, 13479]
### 128-bit mantissas of 10^-(2^i) for i = 0 to 12, each normalized with its top bit set and rounded to nearest. Paired with `B128_POW10_NEG_EXP`.
preset B128_POW10_NEG_MANT: &Array[U128, 13] <- [0xCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCD,
    0xA3D70A3D70A3D70A3D70A3D70A3D70A4, 0xD1B71758E219652BD3C36113404EA4A9,
    0xABCC77118461CEFCFDC20D2B36BA7C3D, 0xE69594BEC44DE15B4C2EBE687989A9B4,
    0xCFB11EAD453994BA67DE18EDA5814AF2, 0xA87FEA27A539E9A53F2398D747B36224,
    0xDDD0467C64BCE4A0AC7CB3F6D05DDBDF, 0xC0314325637A1939FA911155FEFB5309,
    0x9049EE32DB23D21C7132D332E3F204D5, 0xA2A682A5DA57C0BD87A601586BD3F699,
    0xCEAE534F34362DE4492512D4F2EAD2CC, 0xA6DD04C8D2CE9FDE2DE38123A1C3CFFC]
### The binary exponents for `B128_POW10_NEG_MANT`: 10^-(2^i) is about mantissa × 2^exponent.
preset B128_POW10_NEG_EXP: &Array[S64, 13] <- [-131, -134, -141, -154, -181, -234, -340, -553, -978,
    -1828, -3529, -6931, -13734]

### A value mant × 2^exponent with the mantissa's top bit (127) set.
secret record B128Wide
    mant: U128
    exponent: S64

### The high 128 bits of a × b (both normalized), renormalized: the product of
### two numbers in [2^127, 2^128) is in [2^254, 2^256).
### :param a: The first factor.
### :param m: The mantissa of the second factor, top bit set.
### :param e: The binary exponent of the second factor.
### :returns: The product, normalized and truncated to 128 bits.
secret routine b128_wide_mul(a: B128Wide, m: U128, e: S64) -> B128Wide
    x: U128 = a.mant
    x0: U128 = x & 0xFFFFFFFFFFFFFFFF
    x1: U128 = x >> 64
    y0: U128 = m & 0xFFFFFFFFFFFFFFFF
    y1: U128 = m >> 64
    p00: U128 = x0 * y0
    p01: U128 = x0 * y1
    p10: U128 = x1 * y0
    p11: U128 = x1 * y1
    carry0: U128 = p00 >> 64
    mid: U128 = carry0 + (p01 & 0xFFFFFFFFFFFFFFFF) + (p10 & 0xFFFFFFFFFFFFFFFF)
    hi_p: U128 = p11 + (p01 >> 64) + (p10 >> 64)
    hi: U128 = hi_p + (mid >> 64)
    next: U128 = (mid >> 63) & 1  # bit 127 of the low half
    top: Bool = hi >> 127 == 1  # bit 255 set
    mant: U128 = when
        top => hi
        else => (hi << 1) | next
    bias: S64 = when
        top => 128
        else => 127
    exponent: S64 = a.exponent + e + bias
    r: B128Wide = B128Wide(mant: mant, exponent: exponent)
    return r

### Converts decimal text to a B128 quickly and with little stack, accepting the same text as `to[B128]`. The result is one of the two B128 values around the decimal (error under 1 ulp), and differs from `to[B128]` only when the text lies within about 2^-7 ulp of a halfway point. Only the first 38 significant digits are used.
### :returns: A float within 1 ulp of the decimal.
### :throws: Throws `EmptyTextError` for an empty string and `InvalidValueError` for anything else that does not match.
### :note: Overflow gives an infinity and underflow gives zero.
failable routine @[Byte].to_faithful[B128]() -> B128
    digits: &BigNat[3] <- .hollow()

    when check parse_decimal(text: me, digits, max_kept: 38, target: "B128")
        is DecimalParts as parts =>
            negative: Bool = parts.negative
            sign: U128 = when
                negative => B128_SIGN
                else => 0
            kind: DecimalKind = parts.kind
            when kind
                DecimalKind.INFINITY =>
                    # d × 10^exponent: normalize d, then multiply in 10^(2^i) for every set bit of |exponent|.
                    # value = mant × 2^exponent = sig × 2^(biased - 16383 - 115)
                    return b128_of(sign | B128_INF)
                DecimalKind.NAN =>
                    return b128_of(sign | B128_QNAN)
                DecimalKind.FINITE =>
                    count: U64 = digits.count.peek()
                    low: U64 = digits.limbs[0]
                    high: U64 = digits.limbs[1]
                    d_low: U128 = when
                        count >= 1 => low.to[U128]()
                        else => 0
                    d_high: U128 = when
                        count >= 2 => high.to[U128]() << 64
                        else => 0
                    d: U128 = d_low | d_high
                    kept: S64 = parts.kept
                    exponent: S64 = parts.exponent
                    magnitude: S64 = kept + exponent
                    zero: Bool = d == 0 or magnitude < -4966
                    when
                        zero =>
                            return b128_of(sign)
                        magnitude > 4933 =>
                            return b128_of(sign | B128_INF)
                        else =>
                            shift: U128 = d.leading_zeros()
                            start: B128Wide = B128Wide(mant: d << shift,
                                exponent: 0 - shift.to[S64]())
                            down: Bool = exponent < 0

                            sticky: Bool = parts.sticky

                            until left == 0 with i: U64 = 0, left: U64 = exponent.abs_diff(0), w: B128Wide = start
                                if left & 1 == 1
                                    pos_m: U128 = B128_POW10_POS_MANT.getitem(i)
                                    pos_e: S64 = B128_POW10_POS_EXP.getitem(i)
                                    neg_m: U128 = B128_POW10_NEG_MANT.getitem(i)
                                    neg_e: S64 = B128_POW10_NEG_EXP.getitem(i)
                                    m: U128 = when
                                        down => neg_m
                                        else => pos_m
                                    e: S64 = when
                                        down => neg_e
                                        else => pos_e
                                    continue with i: i + 1, left: left >> 1, w: b128_wide_mul(a: w,
                                        m, e)
                                continue with i: i + 1, left: left >> 1, w: w
                            then
                                sig: U128 = w.mant | sticky.to[U128]()

                                bits: U128 = b128_round_pack(negative,
                                    exponent: w.exponent + 16383 + 115, sig)
                                return b128_of(bits)
