# Tessera stdlib: BytesCharsIter
#
# Forward iterator over the characters (Char) of a UTF-8 @[Byte].
# Advances by a variable number of bytes per step via utf8_decode.
# emit() throws AbsentValueError after the last character.
# A malformed byte sequence yields U+FFFD (the replacement character) and
# advances past the offending byte, so iteration always terminates.
#
# Satisfies concept Iterator[Char, BytesCharsIter].

module Standard/System/Text

### Iterator over the characters (`Char`) of a UTF-8 {@[Byte]}. It satisfies `Iterator[Char, BytesCharsIter]`. A malformed sequence yields U+FFFD and skips one byte, so iteration always ends.
record BytesCharsIter
obeys Iterator[Char, BytesCharsIter]
    str: @[Byte]
    index: U64

### Releases the memory its `str` holds.
routine @BytesCharsIter.destruct() -> None
    me.str.destruct()
    return

### Starts an iterator at the first byte of `str`.
### :param str: The view to iterate. It is not copied, so its bytes must outlive the iterator.
### :returns: An iterator positioned before the first element.
common routine BytesCharsIter.construct(str: @[Byte]) -> Me
    iter: Me = Me(str: str, index: 0)
    return iter

### Yields the next element and advances the iterator.
### :returns: The next element, in order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @BytesCharsIter.emit() -> Char
    local index: U64 = me.index.peek()
    local str: @[Byte] = me.str.peek()

    str_len: U64 = str.count
    if index >= str_len
        throw AbsentValueError()
    data: @Byte = str.data
    decoded: Utf8Decoded = utf8_decode(bytes: data, pos: index, len: str.count)
    ok: Bool = decoded.ok
    # on a decode error next_pos == index, so advance by 1 to avoid an infinite loop
    safe_next: U64 = index + 1
    advance: U64 = when
        ok => decoded.next_pos
        else => safe_next
    me.index.poke(advance)
    return decoded.char
