# Tessera stdlib: BytesEmitter
#
# Forward emitter over the raw bytes (U8) of a @[Byte].
# emit() throws AbsentValueError after the last byte.
#
# Satisfies concept Emitter[U8, BytesEmitter].

module System/Text

### Emitter over the raw bytes (`U8`) of a {@[Byte]}. It satisfies `Emitter[U8, BytesEmitter]`, and `emit` yields each byte in order and then throws `AbsentValueError`.
secret record BytesEmitter
obeys Emitter[U8, BytesEmitter]
    str: @[Byte]
    index: U64

### Starts an emitter at the first byte of `str`.
### :param str: The view to iterate. It is not copied, so its bytes must outlive the emitter.
### :returns: An emitter positioned before the first element.
common routine BytesEmitter.construct(str: @[Byte]) -> Me
    emitter: Me = Me(str: str, index: 0)
    return emitter

### Yields the next element and advances the emitter.
### :returns: The next element, in order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @BytesEmitter.emit() -> U8
    index: U64 = me.index.peek()
    str: @[Byte] = me.str.peek()

    str_len: U64 = str.count
    if index >= str_len
        throw AbsentValueError()
    data: @Byte = str.data
    byte: U8 = Byte.to[U8](data.stride(index).peek())
    me.index.poke(index + 1)
    return byte
