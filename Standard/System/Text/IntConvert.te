### The text as a decimal U8, with an optional '+' ("-0" reads as 0).
### :returns: The value.
### :throws: Throws `EmptyTextError` for no digits, `InvalidValueError` for anything but digits after the sign, and
###     `OutOfRangeError` for a value a U8 can't hold.
failable routine @[Byte].to[U8]() -> U8
    p: IntParts = when check parse_int_parts(text: me, target: "U8")
        is IntParts as parts => parts
    if p.negative and (p.magnitude > 0)
        throw OutOfRangeError(text: me, target: "U8")
    when try p.magnitude.to[U8]()
        is U8 as v => return v
        is None => throw OutOfRangeError(text: me, target: "U8")

