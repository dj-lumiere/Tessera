### The text as a decimal U256, with an optional '+' ("-0" reads as 0).
### :returns: The value.
### :throws: Throws `EmptyTextError` for no digits, `InvalidValueError` for anything but digits after the sign, and
###     `OutOfRangeError` for a value a U256 can't hold.
failable routine @[Byte].to[U256]() -> U256
    p: IntParts = when check parse_int_parts(text: me, target: "U256")
        is IntParts as parts => parts
    if p.negative and (p.magnitude > 0)
        throw OutOfRangeError(text: me, target: "U256")
    return p.magnitude

### The text as a decimal CSSize, with an optional sign: read as an S64, then narrowed.
### :returns: The value.
### :throws: Throws `EmptyTextError` for no digits, `InvalidValueError` for anything but digits after the sign, and
###     `OutOfRangeError` for a value a CSSize can't hold.
failable routine @[Byte].to[CSSize]() -> CSSize
    wide: S64 = when check me.to[S64]()
        is S64 as v => v
    when try wide.to[CSSize]()
        is CSSize as v => return v
        is None => throw OutOfRangeError(text: me, target: "CSSize")

### The text as a decimal CSize, with an optional '+': read as a U64, then narrowed.
### :returns: The value.
### :throws: Throws `EmptyTextError` for no digits, `InvalidValueError` for anything but digits after the sign, and
###     `OutOfRangeError` for a value a CSize can't hold.
failable routine @[Byte].to[CSize]() -> CSize
    wide: U64 = when check me.to[U64]()
        is U64 as v => v
    when try wide.to[CSize]()
        is CSize as v => return v
        is None => throw OutOfRangeError(text: me, target: "CSize")
