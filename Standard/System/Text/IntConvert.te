# Tessera stdlib: reading integers from text
#
# text.to[T]() reads a decimal integer for every built-in integer type: an optional '+' or '-', then one or more
# digits, and nothing else (no spaces, no '_', no "0x"). The digits are gathered into a U256, so any text that fits a
# U256 is read before the range is checked, and a type's most negative value reads too ("-128" as S8).
#
# For the text "-42", text.to[S32]() is -42. "200" as an S8 and "-1" as a U32 throw OutOfRangeError, "" throws
# EmptyTextError, and "12a" throws InvalidValueError (Parsable.te).

module System/Text

### The sign and the digits' value.
secret record IntParts
    negative: Bool
    magnitude: U256

### Reads an optional `+` or `-` and then one or more decimal digits into a sign and a U256 magnitude.
### :param text: The text to read.
### :param target: The name of the type being read, for the failure.
### :returns: The sign and magnitude.
### :throws: Throws `EmptyTextError` for no digits, `InvalidValueError` for any other character, and `OutOfRangeError`
###     when the digits overflow a U256.
secret failable routine parse_int_parts(text: @[Byte], target: @[Byte]) -> IntParts
    if text.is_empty()
        throw EmptyTextError(text, target)
    first: U8 = text.byte_at(0)
    # '-' and '+'
    values2: (Bool, U64) = when
        first == 45 => (true, 1)
        first == 43 => (false, 1)
        else => (false, 0)
    negative, start = values2
    if start == text.count()
        throw EmptyTextError(text, target)
    each i in start til text.count() with value: U256 = 0
        c: U8 = text.byte_at(i)
        if not (48 <= c <= 57)
            throw InvalidValueError(text, target)
        times: Optional[U256] = try value.mul(10)
        when times
            is U256 as t =>
                digit: U256 = (c - 48).to[U256]()
                sum: Optional[U256] = try t.add(digit)
                when sum
                    is U256 as s => continue with value: s
                    is None => throw OutOfRangeError(text, target)
            is None => throw OutOfRangeError(text, target)
    then
        return IntParts(negative: negative, magnitude: value)

### The text as a decimal S8, with an optional sign.
### :returns: The value.
### :throws: Throws `EmptyTextError` for no digits, `InvalidValueError` for anything but digits after the sign, and
###     `OutOfRangeError` for a value a S8 can't hold.
failable routine @[Byte].to[S8]() -> S8
    p: IntParts = when check parse_int_parts(text: me, target: "S8")
        is IntParts as parts => parts
    if p.negative and (p.magnitude > 0)
        # -(m - 1) - 1: the most negative value's magnitude is one past the most positive value.
        less: Optional[S8] = try (p.magnitude - 1).to[S8]()
        when less
            is S8 as v => return -v - 1
            is None => throw OutOfRangeError(text: me, target: "S8")
    when try p.magnitude.to[S8]()
        is S8 as v => return v
        is None => throw OutOfRangeError(text: me, target: "S8")

