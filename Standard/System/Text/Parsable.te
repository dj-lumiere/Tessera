# Tessera stdlib: values from text
#
# Text becomes a value the way any value becomes another type, with to[T]: text.to[S32]() is the number the text
# writes. It is failable: text that isn't one throws EmptyTextError, InvalidValueError, or OutOfRangeError, so a bare
# call stops the program on bad text, and `check text.to[S32]()` (or `try`) receives the failure, for text that may be
# wrong (input, a file). A type that can be read from text conforms to Parsable[T] by defining that conversion for
# itself, failable routine @[Byte].to[T]. Every integer type (IntConvert.te) and every float type (FloatConvert.te) is
# Parsable.

module Standard/System/Text

### No value in the text: it is empty, or a sign with no digits after it.
crashable EmptyTextError
    text: @[Byte]
    target: @[Byte]

### Text that isn't written the way the type's values are, such as a letter among digits.
crashable InvalidValueError
    text: @[Byte]
    target: @[Byte]

### Text that names a value the type can't hold, such as "300" for a U8.
crashable OutOfRangeError
    text: @[Byte]
    target: @[Byte]

### Types that can be read from text: `text.to[T]()` gives the value, and throws when the text isn't one. A type
### conforms by defining the conversion from @[Byte] for itself, `failable routine @[Byte].to[T]() -> T`.
### :typeparam T: The type read from text.
protocol Parsable[T]
needs T: typename
    ### The text as a T.
    ### :returns: The value.
    ### :throws: The crashable that says why the text isn't a T.
    failable routine @[Byte].to[T]() -> T

obeys Parsable[S8], Parsable[S16], Parsable[S32], Parsable[S64], Parsable[S128], Parsable[S256]
obeys Parsable[U8], Parsable[U16], Parsable[U32], Parsable[U64], Parsable[U128], Parsable[U256]
obeys Parsable[CSSize], Parsable[CSize]
obeys Parsable[B16], Parsable[BF16], Parsable[B32], Parsable[B64], Parsable[B128]

### Writes `Can't convert "" to S32: the text is empty.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine EmptyTextError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    write_conversion(out, text: me.text, target: me.target)
    out.write("the text is empty.")
    return

### Writes `Can't convert "12a" to S32: the text isn't a valid S32.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine InvalidValueError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    write_conversion(out, text: me.text, target: me.target)
    out.write("the text isn't a valid {me.target}.")
    return

### Writes `Can't convert "300" to U8: the value is out of U8's range.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine OutOfRangeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    write_conversion(out, text: me.text, target: me.target)
    out.write("the value is out of {me.target}'s range.")
    return

### Writes `Can't convert "12a" to S32: `, the text as source (past 64 bytes cut short, with "..." after it).
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the text goes to.
### :param text: The text that didn't convert.
### :param target: The name of the type it was converted to.
secret routine write_conversion[TWriter](out: @TWriter, text: @[Byte], target: @[Byte]) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("Can't convert ")
    if text.count() > 64
        shown: @[Byte] = text.slice(start: 0, end: 64)
        out.write("{shown.diagnose()}...")
    else
        out.write("{text.diagnose()}")
    out.write(" to {target}: ")
    return
