# Tessera stdlib: Ryu shortest float-to-decimal
#
# A port of Ryu (Ulf Adams, https://github.com/ulfjack/ryu, Apache 2.0 or
# Boost 1.0). For a binary float it finds the decimal with the fewest digits
# that reads back to the same float, and of those the one closest to the exact
# value. The result is FloatDecimal: value = digits × 10^exponent.
#
#   ryu_double_decimal  B64 (d2s.c): 128-bit multipliers
#   ryu_float_decimal   B32, and B16 / BF16 through the same code (f2s.c):
#                       64-bit multipliers taken from the high words of the
#                       B64 tables, with the format's mantissa bits and bias
#                       passed in. Every B16 and BF16 value is a B32 value, so
#                       their exponents stay inside the B32 table range.
#
# Both take the IEEE fields of a finite, nonzero value. Zero, infinity, and NaN
# are the caller's job. All arithmetic is on U64 values, below 2^63 except where
# noted.

module Standard/System/Text

### A decimal found by Ryu: the value is `digits` × 10^`exponent`, with the fewest digits that read back to the same float. `digits` is nonzero.
secret record FloatDecimal
    digits: U64
    exponent: S64

### The state of digit removal: the scaled value vr and the interval ends vp, vm.
secret record RyuDigits
    vr: U64
    vp: U64
    vm: U64
    removed: S64
    last: U64  # the last digit removed from vr
    vm_zeros: Bool  # everything removed from vm so far was 0
    vr_zeros: Bool  # everything removed from vr before `last` was 0

# -- helpers -------------------------------------------------------------------

### floor(log2(5^e)) + 1, the number of bits in 5^e, for 0 <= e <= 3528.
### :param e: The power of 5.
### :returns: The bit count.
secret routine ryu_pow5bits(e: U64) -> U64
    log2_floor: U64 = e * 1217359 >> 19
    r: U64 = log2_floor + 1
    return r

### floor(log10(2^e)), for 0 <= e <= 1650.
### :param e: The power of 2.
### :returns: floor(log10(2^`e`)).
secret routine ryu_log10_pow2(e: U64) -> U64
    r: U64 = e * 78913 >> 18
    return r

### floor(log10(5^e)), for 0 <= e <= 2620.
### :param e: The power of 5.
### :returns: floor(log10(5^`e`)).
secret routine ryu_log10_pow5(e: U64) -> U64
    r: U64 = e * 732923 >> 20
    return r

### Is value (nonzero) divisible by 5^p?
### :param value: The value to test, nonzero.
### :param p: The power of 5.
### :returns: True when 5^`p` divides `value` (always for `p` <= 0).
secret routine ryu_is_multiple_of_pow5(value: U64, p: S64) -> Bool
    while true with rest: U64 = value, found: S64 = 0
        enough2: Bool = found >= p
        divides2: Bool = rest % 5 == 0
        if divides2 and not enough2
            continue with rest: rest // 5, found: found + 1
        return enough2

### Is value divisible by 2^p (p < 63)?
### :param value: The value to test.
### :param p: The power of 2, below 63.
### :returns: True when the low `p` bits of `value` are all 0.
secret routine ryu_is_multiple_of_pow2(value: U64, p: U64) -> Bool
    mask: U64 = (1 << p) -% 1
    return value & mask == 0

### floor(m × factor / 2^shift), with factor read as unsigned 64-bit and m < 2^32.
### :param m: The value to scale, below 2^32.
### :param factor: The 64-bit table multiplier.
### :param shift: How far to shift the 128-bit product right.
### :returns: The scaled value's low 64 bits.
secret routine ryu_mul_shift32(m: U64, factor: U64, shift: S64) -> U64
    product: U128 = m.to[U128]() * factor.to[U128]()
    r: U64 = (product >> shift.to[U128]()).to[U64]()
    return r

### floor(m × W / 2^shift) for the 128-bit W = high:low, with m < 2^55 and shift > 64.
### :param m: The value to scale, below 2^55.
### :param low: The table multiplier's low 64 bits.
### :param high: The table multiplier's high 64 bits.
### :param shift: How far to shift the product right, above 64.
### :returns: The scaled value's low 64 bits.
secret routine ryu_mul_shift64(m: U64, low: U64, high: U64, shift: S64) -> U64
    wide: U128 = m.to[U128]()
    b0: U128 = wide *% low.to[U128]()
    b2: U128 = wide *% high.to[U128]()
    sum: U128 = (b0 >> 64) +% b2
    r: U64 = (sum >> (shift - 64).to[U128]()).to[U64]()
    return r

# -- digit removal -------------------------------------------------------------

### Can one more digit go? Only while the interval still holds a shorter number,
### and never past the last digit of vr: Ryu would round a lone 0 up to 1 at the
### next power of ten, which is no shorter than vr and can be farther from the
### value (BF16's smallest subnormal, 9.18e-41, would print as 1e-40, not 9e-41).
### Stopping there changes no B32 or B64 output. B16 and BF16 were checked
### exhaustively.
### :param vr: The scaled value.
### :param vp: The interval's upper end.
### :param vm: The interval's lower end.
### :returns: True when one more digit can be removed.
secret routine ryu_has_removable_digit(vr: U64, vp: U64, vm: U64) -> Bool
    shorter: Bool = vp // 10 > vm // 10
    two_plus: Bool = vr >= 10
    return shorter and two_plus

### Removes digits while the interval [vm, vp] still holds a shorter number,
### then rounds vr. accept says whether the interval ends themselves read back
### to the float (they do when its mantissa is even).
### :param start: The scaled value, the interval ends, and what is known about their trailing zeros.
### :param accept: True when the interval ends read back to the float.
### :param e10: The decimal exponent of `start`'s values.
### :returns: The shortest decimal.
secret routine ryu_shorten(start: RyuDigits, accept: Bool, e10: S64) -> FloatDecimal
    vm_zeros: Bool = start.vm_zeros
    vr_zeros: Bool = start.vr_zeros
    if not (vm_zeros or vr_zeros)
        # The usual case: no trailing zeros to track, round on the last removed digit.
        while ryu_has_removable_digit(vr: fast.vr, vp: fast.vp,
            vm: fast.vm) with fast: RyuDigits = start
            vr: U64 = fast.vr
            vp: U64 = fast.vp
            vm: U64 = fast.vm
            removed: S64 = fast.removed
            continue with fast: RyuDigits(vr: vr // 10, vp: vp // 10, vm: vm // 10,
                removed: removed + 1, last: vr % 10, vm_zeros: false, vr_zeros: false)
        then
            vr: U64 = fast.vr
            vm: U64 = fast.vm
            last: U64 = fast.last
            at_low: Bool = vr == vm
            round_up: Bool = last >= 5
            bump: Bool = at_low or round_up
            return ryu_finish(digits: vr +% bump.to[U64](), removed: fast.removed, e10)

    # Some removed digits may all be zero: track that, so an exact tie rounds to
    # even and vm may be used when it is exactly representable.
    while ryu_has_removable_digit(vr: careful.vr, vp: careful.vp,
        vm: careful.vm) with careful: RyuDigits = start
        vr: U64 = careful.vr
        vp: U64 = careful.vp
        vm: U64 = careful.vm
        last: U64 = careful.last
        removed: S64 = careful.removed
        vm_digit: U64 = vm % 10
        vm_zeros_left: Bool = careful.vm_zeros and vm_digit == 0
        vr_zeros_left: Bool = careful.vr_zeros and last == 0
        continue with careful: RyuDigits(vr: vr // 10, vp: vp // 10, vm: vm // 10,
            removed: removed + 1, last: vr % 10, vm_zeros: vm_zeros_left, vr_zeros: vr_zeros_left)
    then
        # vm ends in zeros that can go too, as long as it is exactly representable.
        while trimmed.vm_zeros and trimmed.vm % 10 == 0 with trimmed: RyuDigits = careful
            vr: U64 = trimmed.vr
            vp: U64 = trimmed.vp
            vm: U64 = trimmed.vm
            last: U64 = trimmed.last
            removed: S64 = trimmed.removed
            vr_zeros_left: Bool = trimmed.vr_zeros and last == 0
            continue with trimmed: RyuDigits(vr: vr // 10, vp: vp // 10, vm: vm // 10,
                removed: removed + 1, last: vr % 10, vm_zeros: true, vr_zeros: vr_zeros_left)
        then
            vr: U64 = trimmed.vr
            vm: U64 = trimmed.vm
            last: U64 = trimmed.last
            # exactly halfway (…5000…): round to even
            half: Bool = trimmed.vr_zeros and last == 5
            vr_even: Bool = vr & 1 == 0
            tie_down: Bool = half and vr_even
            rounding: U64 = when
                tie_down => 4
                else => last
            # vr sits on vm but vm itself doesn't read back: step up
            vm_usable: Bool = accept and trimmed.vm_zeros
            at_low: Bool = vr == vm and not vm_usable
            round_up: Bool = rounding >= 5
            bump: Bool = at_low or round_up
            return ryu_finish(digits: vr +% bump.to[U64](), removed: trimmed.removed, e10)

### Writes the rounded digits as a FloatDecimal. Rounding 9 up gives 10: that is written as 1 at the next exponent.
### :param digits: The rounded digits.
### :param removed: How many digits were removed.
### :param e10: The decimal exponent the digits had before any were removed.
### :returns: The shortest decimal.
secret routine ryu_finish(digits: U64, removed: S64, e10: S64) -> FloatDecimal
    carry: Bool = digits == 10
    shortest: U64 = when
        carry => 1
        else => digits
    exponent: S64 = e10 + removed + carry.to[S64]()
    r: FloatDecimal = FloatDecimal(digits: shortest, exponent: exponent)
    return r

# -- B64 (d2s) -----------------------------------------------------------------

### The shortest decimal that reads back to a B64 (Ryu's d2s), closest to the exact value among those.
### :param mantissa: The raw 52-bit mantissa field of a finite, nonzero B64.
### :param exponent: The raw biased exponent field (0 for a subnormal).
### :returns: The decimal.
secret routine ryu_double_decimal(mantissa: U64, exponent: S64) -> FloatDecimal
    local subnormal: Bool = exponent == 0
    local normal_m2: U64 = mantissa | 4503599627370496
    # 2^52
    local m2: U64 = when

        subnormal => mantissa
        else => normal_m2
    local biased: S64 = when
        subnormal => 1
        else => exponent
    local unbiased: S64 = biased - 1023 - 52
    local e2: S64 = unbiased - 2
    local accept: Bool = m2 & 1 == 0
    local mv: U64 = m2 *% 4
    # the gap below is half as wide at the bottom of a binade
    local mm_shift_b: Bool = mantissa != 0 or exponent <= 1
    local mm_shift: U64 = mm_shift_b.to[U64]()

    if e2 >= 0
        # e2 >= 0: multiply by 2^e2 / 10^q through the inverse table.
        above3: Bool = e2 > 3
        q_u: U64 = ryu_log10_pow2(e2.to[U64]()) - above3.to[U64]()
        q: S64 = q_u.to[S64]()
        k_u: U64 = 125 + ryu_pow5bits(q.to[U64]()) - 1
        k: S64 = k_u.to[S64]()
        i: S64 = q + k - e2
        lo_at: U64 = (q * 2).to[U64]()
        hi_at: U64 = lo_at + 1
        lo: U64 = RYU_POW5_INV.getitem(lo_at)
        hi: U64 = RYU_POW5_INV.getitem(hi_at)
        mp: U64 = mv +% 2
        mm: U64 = mv -% 1 -% mm_shift
        vr: U64 = ryu_mul_shift64(m: mv, low: lo, high: hi, shift: i)
        vp: U64 = ryu_mul_shift64(m: mp, low: lo, high: hi, shift: i)
        vm: U64 = ryu_mul_shift64(m: mm, low: lo, high: hi, shift: i)
        # For small q, the scaled values may be exact: check for 5^q factors.
        small: Bool = q <= 21
        mv_by_5: Bool = mv % 5 == 0
        not_by_5: Bool = not mv_by_5
        vr_exact: Bool = (small and mv_by_5) and ryu_is_multiple_of_pow5(value: mv, p: q)
        mm_case: Bool = small and not_by_5 and accept
        vm_exact: Bool = mm_case and ryu_is_multiple_of_pow5(value: mm, p: q)
        mp_case: Bool = small and not_by_5 and not accept
        vp_exact: Bool = mp_case and ryu_is_multiple_of_pow5(value: mp, p: q)
        vp_fixed: U64 = vp -% vp_exact.to[U64]()
        digits: RyuDigits = RyuDigits(vr: vr, vp: vp_fixed, vm: vm, removed: 0, last: 0,
            vm_zeros: vm_exact, vr_zeros: vr_exact)
        r: FloatDecimal = ryu_shorten(start: digits, accept, e10: q)
        return r
    # e2 < 0: multiply by 5^-e2 / 2^j through the power table.
    neg_e2: S64 = 0 - e2
    above1: Bool = neg_e2 > 1
    q_u: U64 = ryu_log10_pow5(neg_e2.to[U64]()) - above1.to[U64]()
    q: S64 = q_u.to[S64]()
    e10: S64 = q + e2
    i: S64 = neg_e2 - q
    k_u: U64 = ryu_pow5bits(i.to[U64]()) -% 125
    k: S64 = k_u.to_wrap[S64]()
    j: S64 = q - k
    lo_at: U64 = (i * 2).to[U64]()
    hi_at: U64 = lo_at + 1
    lo: U64 = RYU_POW5.getitem(lo_at)
    hi: U64 = RYU_POW5.getitem(hi_at)
    mp: U64 = mv +% 2
    mm: U64 = mv -% 1 -% mm_shift
    vr: U64 = ryu_mul_shift64(m: mv, low: lo, high: hi, shift: j)
    vp: U64 = ryu_mul_shift64(m: mp, low: lo, high: hi, shift: j)
    vm: U64 = ryu_mul_shift64(m: mm, low: lo, high: hi, shift: j)
    if q <= 1
        # q <= 1: vr is exact, and vm is exact when the gap below is a full one.
        vm_exact: Bool = accept and mm_shift == 1
        vp_fixed: U64 = when
            accept => vp
            else => vp -% 1
        digits: RyuDigits = RyuDigits(vr: vr, vp: vp_fixed, vm: vm, removed: 0, last: 0,
            vm_zeros: vm_exact, vr_zeros: true)
        r: FloatDecimal = ryu_shorten(start: digits, accept, e10)
        return r
    # vr is exact when mv has at least q trailing zero bits.
    checkable: Bool = q < 63
    shift: S64 = q.min(62)
    vr_exact: Bool = checkable and ryu_is_multiple_of_pow2(value: mv, p: shift.to[U64]())
    digits: RyuDigits = RyuDigits(vr: vr, vp: vp, vm: vm, removed: 0, last: 0,
        vm_zeros: false, vr_zeros: vr_exact)
    r: FloatDecimal = ryu_shorten(start: digits, accept, e10)
    return r

# -- B32, B16, BF16 (f2s) ------------------------------------------------------

### The shortest decimal that reads back to a B32, B16, or BF16 value (Ryu's f2s), closest to the exact value among
### those.
### :param mantissa: The raw mantissa field of a finite, nonzero value.
### :param exponent: The raw biased exponent field (0 for a subnormal).
### :param mantissa_bits: How many mantissa bits the format stores (23 for B32).
### :param bias: The format's exponent bias (127 for B32).
### :returns: The decimal.
secret routine ryu_float_decimal(mantissa: S64, exponent: S64, mantissa_bits: S64,
    bias: S64) -> FloatDecimal
    subnormal: Bool = exponent == 0
    hidden: S64 = 1 << mantissa_bits
    normal_m2: S64 = mantissa | hidden
    m2: S64 = when
        subnormal => mantissa
        else => normal_m2
    biased: S64 = when
        subnormal => 1
        else => exponent
    unbiased: S64 = biased - bias - mantissa_bits
    e2: S64 = unbiased - 2
    accept: Bool = m2 & 1 == 0
    mv: S64 = m2 * 4
    mm_shift_b: Bool = mantissa != 0 or exponent <= 1
    mm_shift: U64 = mm_shift_b.to[U64]()
    if e2 >= 0
        mv2: U64 = mv.to[U64]()
        q: S64 = ryu_log10_pow2(e2.to[U64]()).to[S64]()
        k_u: U64 = 61 + ryu_pow5bits(q.to[U64]()) - 1
        k: S64 = k_u.to[S64]()
        i: S64 = q + k - e2
        hi_index: S64 = q * 2 + 1
        hi_at: U64 = hi_index.to[U64]()
        hi: U64 = RYU_POW5_INV.getitem(hi_at)
        factor: U64 = hi +% 1
        mp: U64 = mv2 + 2
        mm: U64 = mv2 - 1 - mm_shift
        vr: U64 = ryu_mul_shift32(m: mv2, factor, shift: i)
        vp: U64 = ryu_mul_shift32(m: mp, factor, shift: i)
        vm: U64 = ryu_mul_shift32(m: mm, factor, shift: i)
        small: Bool = q <= 9
        mv_by_5: Bool = mv2 % 5 == 0
        not_by_5: Bool = not mv_by_5
        vr_exact: Bool = (small and mv_by_5) and ryu_is_multiple_of_pow5(value: mv2, p: q)
        mm_case: Bool = small and not_by_5 and accept
        vm_exact: Bool = mm_case and ryu_is_multiple_of_pow5(value: mm, p: q)
        mp_case: Bool = small and not_by_5 and not accept
        vp_exact: Bool = mp_case and ryu_is_multiple_of_pow5(value: mp, p: q)
        vp_fixed: U64 = vp - vp_exact.to[U64]()
        # f2s also needs the digit just below vr, in case nothing gets removed
        vp_tens: U64 = (vp - 1) // 10
        if q != 0 and vp_tens <= vm // 10
            q1: S64 = q - 1
            l_u: U64 = 61 + ryu_pow5bits(q1.to[U64]()) - 1
            l: S64 = l_u.to[S64]()
            hi_index2: S64 = q1 * 2 + 1
            hi_at2: U64 = hi_index2.to[U64]()
            hi2: U64 = RYU_POW5_INV.getitem(hi_at2)
            shift: S64 = q1 + l - e2

            digit: U64 = ryu_mul_shift32(m: mv2, factor: hi2 +% 1, shift) % 10
            digits: RyuDigits = RyuDigits(vr: vr, vp: vp_fixed, vm: vm, removed: 0, last: digit,
                vm_zeros: vm_exact, vr_zeros: vr_exact)
            r: FloatDecimal = ryu_shorten(start: digits, accept, e10: q)
            return r
        digits: RyuDigits = RyuDigits(vr: vr, vp: vp_fixed, vm: vm, removed: 0, last: 0,
            vm_zeros: vm_exact, vr_zeros: vr_exact)
        r: FloatDecimal = ryu_shorten(start: digits, accept, e10: q)
        return r
    mm_shift2: S64 = mm_shift.to[S64]()
    neg_e2: S64 = 0 - e2
    q: S64 = ryu_log10_pow5(neg_e2.to[U64]()).to[S64]()
    e10: S64 = q + e2
    i: S64 = neg_e2 - q
    k_u: U64 = ryu_pow5bits(i.to[U64]()) -% 61
    k: S64 = k_u.to_wrap[S64]()
    j: S64 = q - k
    hi_index: S64 = i * 2 + 1
    hi_at: U64 = hi_index.to[U64]()
    factor: U64 = RYU_POW5.getitem(hi_at)
    mp: S64 = mv + 2
    mm: S64 = mv - 1 - mm_shift2
    vr: U64 = ryu_mul_shift32(m: mv.to[U64](), factor, shift: j)
    vp: U64 = ryu_mul_shift32(m: mp.to[U64](), factor, shift: j)
    vm: U64 = ryu_mul_shift32(m: mm.to[U64](), factor, shift: j)
    vp_tens: U64 = (vp - 1) // 10
    narrow: Bool = q != 0 and vp_tens <= vm // 10
    values2: (S64, U64) = when
        narrow =>
            q2: U64 = q.to[U64]()
            i1: S64 = i + 1
            shift: U64 = q2 - 1 -% (ryu_pow5bits(i1.to[U64]()) -% 61)
            hi_index2: S64 = i1 * 2 + 1
            hi_at2: U64 = hi_index2.to[U64]()
            factor2: U64 = RYU_POW5.getitem(hi_at2)
            becomes (q2.to[S64](), ryu_mul_shift32(m: mv.to[U64](), factor: factor2, shift: shift.to[S64]()) % 10)
        else => (q, 0)
    q2, digit = values2
    tiny: Bool = q2 <= 1
    vm_exact: Bool = tiny and accept and mm_shift2 == 1
    vp_down: Bool = tiny and not accept
    vp_fixed: U64 = vp - vp_down.to[U64]()
    checkable: Bool = not tiny and q2 < 31
    shift: S64 = (q2 - 1).max(0)
    by_2: Bool = checkable and ryu_is_multiple_of_pow2(value: mv.to[U64](), p: shift.to[U64]())
    digits: RyuDigits = RyuDigits(vr: vr, vp: vp_fixed, vm: vm, removed: 0, last: digit,
        vm_zeros: vm_exact, vr_zeros: tiny or by_2)
    r: FloatDecimal = ryu_shorten(start: digits, accept, e10)
    return r
