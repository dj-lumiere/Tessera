# Tessera stdlib: UTF-8 encode/decode
#
# Text is Char (a Unicode scalar value). @[Byte] are Byte in @Byte buffers,
# read as U8 to look at their bits.
#
# utf8_decode reads one character starting at byte pos (never reading at or
# past len) and returns a Utf8Decoded { char, next_pos, ok }. On a malformed
# sequence (a bad lead or continuation byte, an overlong form, a surrogate, or
# a value past 0x10FFFF) it returns { char: U+FFFD, next_pos: pos, ok: false }.
#
# utf8_encode_into writes one character into out (caller must ensure 4 bytes of
# space) and returns the number of bytes written.

module System/Text

# -- Utf8Decoded ---------------------------------------------------------------

### The result of `utf8_decode`: the character read, the byte position just after it, and whether the sequence was well formed.
record Utf8Decoded
    char: Char
    next_pos: U64
    ok: Bool

# -- decode --------------------------------------------------------------------

### Decodes the character starting at byte `pos` of `bytes`, never reading at or past `len`.
### :param bytes: The buffer to decode from.
### :param pos: The index of the first byte of the character.
### :param len: The number of readable bytes in the buffer.
### :returns: The character, the position after it, and whether it was well formed.
### :note: A malformed or truncated sequence, or `pos` at or past `len`, gives U+FFFD with `next_pos` equal to `pos` and `ok` false.
routine utf8_decode(bytes: @Byte, pos: U64, len: U64) -> Utf8Decoded
    if pos >= len
        # single byte: 0xxxxxxx
        # two byte: 110xxxxx 10xxxxxx
        # three byte: 1110xxxx 10xxxxxx 10xxxxxx
        # four byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        # An overlong form (below min, the smallest value that needs this many bytes), a surrogate, or a value
        # past 0x10FFFF isn't a Char.
        fffd: U32 = 0xFFFD
        replacement: Char = fffd.to[Char]()
        result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos, ok: false)
        return result
    b0: Byte = bytes.stride(pos).peek()
    b0u: U32 = b0.to[U8]().to[U32]()
    next: U64 = pos + 1
    is_one: Bool = b0u < 0x80
    values2: (U32, U32, U64) = when
        is_one => (b0u, 0, next)
        else =>
            mask2: U32 = b0u & 0xE0
            if mask2 == 0xC0
                b1u: U32 = utf8_continuation(bytes, pos: next, len)
                if b1u <= 0x3F
                    hi: U32 = (b0u & 0x1F) << 6
                    becomes (hi | b1u, 0x80, next + 1)
                else
                    fffd: U32 = 0xFFFD
                    replacement: Char = fffd.to[Char]()
                    result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos, ok: false)
                    return result
            else
                mask3: U32 = b0u & 0xF0
                if mask3 == 0xE0
                    n2: U64 = next + 1
                    b1u: U32 = utf8_continuation(bytes, pos: next, len)
                    b2u: U32 = utf8_continuation(bytes, pos: n2, len)
                    if b1u | b2u <= 0x3F
                        hi: U32 = (b0u & 0x0F) << 12
                        mid: U32 = b1u << 6
                        becomes (hi | mid | b2u, 0x800, n2 + 1)
                    else
                        fffd: U32 = 0xFFFD
                        replacement: Char = fffd.to[Char]()
                        result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos,
                            ok: false)
                        return result
                else
                    mask4: U32 = b0u & 0xF8
                    if mask4 == 0xF0
                        n2: U64 = next + 1
                        n3: U64 = n2 + 1
                        b1u: U32 = utf8_continuation(bytes, pos: next, len)
                        b2u: U32 = utf8_continuation(bytes, pos: n2, len)
                        b3u: U32 = utf8_continuation(bytes, pos: n3, len)
                        continuation_bits: U32 = b1u | b2u | b3u
                        if continuation_bits <= 0x3F
                            p0: U32 = (b0u & 0x07) << 18
                            p1: U32 = b1u << 12
                            p2: U32 = b2u << 6
                            upper: U32 = p0 | p1 | p2
                            becomes (upper | b3u, 0x10000, n3 + 1)
                        else
                            fffd: U32 = 0xFFFD
                            replacement: Char = fffd.to[Char]()
                            result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos,
                                ok: false)
                            return result
                    else
                        fffd: U32 = 0xFFFD
                        replacement: Char = fffd.to[Char]()
                        result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos,
                            ok: false)
                        return result
    cp, min, after = values2
    if cp < min
        fffd: U32 = 0xFFFD
        replacement: Char = fffd.to[Char]()
        result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos, ok: false)
        return result
    scalar: Maybe[Char] = try cp.to[Char]()
    when scalar
        is Char as char =>
            result: Utf8Decoded = Utf8Decoded(char: char, next_pos: after, ok: true)
            return result
        is None =>
            fffd: U32 = 0xFFFD
            replacement: Char = fffd.to[Char]()
            result: Utf8Decoded = Utf8Decoded(char: replacement, next_pos: pos, ok: false)
            return result

### Reads the continuation byte at `pos` and gives its six payload bits.
### :param bytes: The buffer to read from.
### :param pos: The index of the byte to read.
### :param len: The number of readable bytes in the buffer.
### :returns: The payload bits, 0x00 ..= 0x3F, or 0xFF when `pos` is at or past `len` or the byte is not a continuation byte (`10xxxxxx`).
routine utf8_continuation(bytes: @Byte, pos: U64, len: U64) -> U32
    if pos >= len
        return 0xFF
    b: Byte = bytes.stride(pos).peek()
    bu: U32 = b.to[U8]().to[U32]()
    if bu & 0xC0 == 0x80
        return bu & 0x3F
    return 0xFF

# -- encode --------------------------------------------------------------------

### Writes the UTF-8 encoding of `char` (1 to 4 bytes) at `out`.
### :param char: The character to encode.
### :param out: Where the bytes go. The caller makes sure at least 4 bytes are writable there.
### :returns: The number of bytes written, 1 to 4.
routine utf8_encode_into(char: Char, out: @Byte) -> U64
    cp: U32 = char.to[U32]()

    if cp < 0x80
        out.stride(0).poke(cp.to[U8]().bits())
        return 1
    if cp < 0x800
        hi: U32 = (cp >> 6) | 0xC0
        lo: U32 = (cp & 0x3F) | 0x80
        out.stride(0).poke(hi.to[U8]().bits())
        out.stride(1).poke(lo.to[U8]().bits())
        return 2
    if cp < 0x10000
        b0: U32 = (cp >> 12) | 0xE0
        middle_six: U32 = (cp >> 6) & 0x3F
        b1: U32 = middle_six | 0x80
        b2: U32 = (cp & 0x3F) | 0x80
        out.stride(0).poke(b0.to[U8]().bits())
        out.stride(1).poke(b1.to[U8]().bits())
        out.stride(2).poke(b2.to[U8]().bits())
        return 3
    b0: U32 = (cp >> 18) | 0xF0
    upper_six: U32 = (cp >> 12) & 0x3F
    b1: U32 = upper_six | 0x80
    middle_six: U32 = (cp >> 6) & 0x3F
    b2: U32 = middle_six | 0x80
    b3: U32 = (cp & 0x3F) | 0x80
    out.stride(0).poke(b0.to[U8]().bits())
    out.stride(1).poke(b1.to[U8]().bits())
    out.stride(2).poke(b2.to[U8]().bits())
    out.stride(3).poke(b3.to[U8]().bits())
    return 4
