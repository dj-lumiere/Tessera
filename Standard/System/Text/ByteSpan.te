# Tessera stdlib: text, as bytes
#
# Text is bytes, UTF-8 by convention: a `@[Byte]` reads it (a string literal is one, its bytes in the program
# image, NUL-terminated past the count), and text a routine makes in new memory (concat, Console.ask_line,
# FileManager.read_all) is a `BorrowedSlice[Byte]`, which the caller drops. The routines here are on `@[Byte]`: a `BorrowedSlice[Byte]` is
# lent to them as a view, by argument and by receiver.
#
# Nothing checks that the bytes are UTF-8, but is_utf8 does when it matters. The character operations read a malformed
# sequence as U+FFFD and move on, so they are defined for any bytes. eq, compare, and hash look at the bytes only.

module Standard/System/Text

obeys Equatable[@[Byte]], Comparable[@[Byte]], Hashable[@[Byte]]

# -- element access ------------------------------------------------------------

### Reads the byte at `index`.
### :param index: The zero-based byte position.
### :returns: The byte as a number from 0 to 255.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is not less than the count.
@track_caller
routine @[Byte].byte_at(index: U64) -> U8
    count: U64 = me.count
    if index < count
        data: @Byte = me.data
        byte: U8 = Byte.to[U8](data.stride(index).peek())
        return byte
    crash_out_of_bounds()

### Reads the byte at `index`.
### :param index: The zero-based byte position.
### :returns: The byte as a number from 0 to 255.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is not less than the count.
@track_caller
routine @@[Byte].byte_at(index: U64) -> U8
    byte: U8 = me.peek().byte_at(index)
    return byte

# -- slicing -------------------------------------------------------------------

### The bytes in [`start`, `end`), a view of the same bytes, without copying.
### :param start: The index of the first byte, included.
### :param end: The index after the last byte.
### :returns: The borrowed text.
### :throws: Crashes with `IndexOutOfBoundsError` when `end` is past the count or `start > end`.
@track_caller
routine @[Byte].slice(start: U64, end: U64) -> Me
    count: U64 = me.count
    valid_end: Bool = end <= count
    valid_order: Bool = start <= end
    if valid_end and valid_order
        base: @Byte = me.data
        from: @Byte = base.stride(start)
        count2: U64 = me.count
        slice_len: U64 = end - start
        result: Me = Me(data: from, count: slice_len)
        return result
    crash_out_of_bounds()

### The bytes in [`start`, `end`), a view of the same bytes, without copying.
### :param start: The index of the first byte, included.
### :param end: The index after the last byte.
### :returns: The borrowed text.
### :throws: Crashes with `IndexOutOfBoundsError` when `end` is past the count or `start > end`.
@track_caller
routine @@[Byte].slice(start: U64, end: U64) -> Me
    result: Me = me.peek().slice(start, end)
    return result

# -- heap-allocating operations ------------------------------------------------

### `a` followed by `b` in new memory from `manager`, with a NUL after them that the count leaves out. The caller drops
### it.
### :param a: The first text.
### :param b: The text that follows it.
### :param manager: The manager the new bytes come from.
### :returns: The joined text.
### :throws: Crashes with `MemoryAllocationError` when the manager has no memory to give.
@track_caller
@expensive("allocates a new buffer")
common routine @[Byte].concat(a: Me, b: Me, manager: @MemoryManager) -> BorrowedSlice[Byte]
    count: U64 = a.count + b.count
    buffer: &[Byte] <- BorrowedSlice[Byte].construct(count: count + 1, manager: manager)
    data: @Byte = buffer.data.peek()

    data.copy(src: a.data, count: a.count)
    data.stride(a.count).copy(src: b.data, count: b.count)
    data.stride(count).poke(0x00)
    buffer.keep_first(count)
    return buffer

# -- equality, ordering, hashing -----------------------------------------------

### Whether both hold the same bytes: equal counts and equal contents, not the same address or memory manager.
### :param other: The right-hand operand.
### :returns: `true` when the contents are identical.
routine @[Byte].eq(other: Me) -> Bool
    la: U64 = me.count
    pa: @Byte = me.data
    pb: @Byte = other.data

    lb: U64 = other.count
    if la == lb
        each i in 0 til la
            ba: U8 = Byte.to[U8](pa.stride(i).peek())
            bb: U8 = Byte.to[U8](pb.stride(i).peek())
            if ba == bb
                continue
            return false
        then
            return true
    else
        return false

### Lexicographic byte-wise comparison. @[Byte] compare as U8, so this matches `memcmp` ordering, and a text that is a
### prefix of the other comes first. The memory manager plays no part.
### :param other: The right-hand operand.
### :returns: -1, 0, or 1 as `me` orders before, equal to, or after `other`.
routine @[Byte].compare(other: Me) -> S32
    la: U64 = me.count
    lb: U64 = other.count
    a_shorter: Bool = la <= lb
    min: U64 = when

        a_shorter => la
        else => lb
    pa: @Byte = me.data
    pb: @Byte = other.data

    each i in 0 til min
        ba: U8 = Byte.to[U8](pa.stride(i).peek())
        bb: U8 = Byte.to[U8](pb.stride(i).peek())
        if ba < bb
            return -1
        if ba > bb
            return 1
        continue
    if la < lb
        return -1
    if la > lb
        return 1
    return 0

### SipHash-2-4 of the byte contents under the process key. The memory manager plays no part.
### :returns: The 64-bit hash.
@expensive("hashes the whole buffer")
routine @[Byte].hash() -> U64
    data: @Byte = me.data
    len: U64 = me.count
    h: U64 = siphash24(data, count: len, key: hash_key())
    return h

# -- search --------------------------------------------------------------------

### Whether the text begins with `prefix`.
### :param prefix: The bytes to look for at the start.
### :returns: `true` when `prefix` matches the first bytes. An empty `prefix` always matches.
routine @[Byte].has_prefix(prefix: Me) -> Bool
    pl: U64 = prefix.count
    sd: @Byte = me.data
    pd: @Byte = prefix.data

    sl: U64 = me.count
    if pl <= sl
        each i in 0 til pl
            a: U8 = Byte.to[U8](sd.stride(i).peek())
            b: U8 = Byte.to[U8](pd.stride(i).peek())
            if a == b
                continue
            return false
        then
            return true
    else
        return false

### Whether the text begins with `prefix`.
### :param prefix: The bytes to look for at the start.
### :returns: `true` when `prefix` matches the first bytes. An empty `prefix` always matches.
routine @@[Byte].has_prefix(prefix: Me) -> Bool
    return me.peek().has_prefix(prefix)

### Whether the text ends with `suffix`.
### :param suffix: The bytes to look for at the end.
### :returns: `true` when `suffix` matches the last bytes. An empty `suffix` always matches.
routine @[Byte].has_suffix(suffix: Me) -> Bool
    fl: U64 = suffix.count
    sd: @Byte = me.data
    fd: @Byte = suffix.data

    sl: U64 = me.count
    if fl <= sl
        off: U64 = sl - fl

        each i in 0 til fl
            idx: U64 = off + i
            a: U8 = Byte.to[U8](sd.stride(idx).peek())
            b: U8 = Byte.to[U8](fd.stride(i).peek())
            if a == b
                continue
            return false
        then
            return true
    else
        return false

### Whether the text ends with `suffix`.
### :param suffix: The bytes to look for at the end.
### :returns: `true` when `suffix` matches the last bytes. An empty `suffix` always matches.
routine @@[Byte].has_suffix(suffix: Me) -> Bool
    return me.peek().has_suffix(suffix)

### The byte index of the first match of `needle`, by a naive O(n*m) search.
### :param needle: The bytes to look for.
### :returns: The index where the first match starts. An empty `needle` matches at 0.
### :absent: When `needle` does not occur in the text.
routine @[Byte].find(needle: Me) -> Maybe[U64]
    nlen: U64 = needle.count
    slen: U64 = me.count
    sd: @Byte = me.data
    nd: @Byte = needle.data

    if nlen == 0
        r: Maybe[U64] = 0
        return r
    if nlen > slen
        r: Maybe[U64] = None()
        return r
    last: U64 = slen - nlen

    until i > last with i: U64 = 0
        until j == nlen with j: U64 = 0
            idx: U64 = i + j
            a: U8 = Byte.to[U8](sd.stride(idx).peek())
            b: U8 = Byte.to[U8](nd.stride(j).peek())
            if a != b
                break
            continue with j: j + 1
        then
            if j == nlen
                r: Maybe[U64] = i
                return r

        continue with i: i + 1
    then
        r: Maybe[U64] = None()
        return r

### The byte index of the first match of `needle`.
### :param needle: The bytes to look for.
### :returns: The index where the first match starts. An empty `needle` matches at 0.
### :absent: When `needle` does not occur in the text.
routine @@[Byte].find(needle: Me) -> Maybe[U64]
    r: Maybe[U64] = me.peek().find(needle)
    return r

### Whether `needle` occurs anywhere in the text, using {@[Byte].find}.
### :param needle: The bytes to look for.
### :returns: `true` when a match exists. An empty `needle` always matches.
routine @[Byte].has(needle: Me) -> Bool
    r: Maybe[U64] = me.find(needle)
    return r.is_present()

### Whether `needle` is not there: the opposite of `has`.
### :param needle: The value to look for.
### :returns: `true` when `has` would be `false`.
routine @[Byte].lacks(needle: Me) -> Bool
    there: Bool = me.has(needle)
    return not there

### Whether `needle` occurs anywhere in the text, using {@[Byte].find}.
### :param needle: The bytes to look for.
### :returns: `true` when a match exists. An empty `needle` always matches.
routine @@[Byte].has(needle: Me) -> Bool
    return me.peek().has(needle)

### Whether `needle` is not there: the opposite of `has`.
### :param needle: The value to look for.
### :returns: `true` when `has` would be `false`.
routine @@[Byte].lacks(needle: Me) -> Bool
    there: Bool = me.has(needle)
    return not there

# -- UTF-8 -----------------------------------------------------------------------

### Whether the bytes are well-formed UTF-8: no bad lead or continuation byte, overlong form, surrogate, or value past
### U+10FFFF.
### :returns: `true` when the whole text decodes as UTF-8. An empty text is valid.
routine @[Byte].is_utf8() -> Bool
    until pos >= me.count with pos: U64 = 0
        d: Utf8Decoded = utf8_decode(bytes: me.data, pos, len: me.count)
        if d.ok
            continue with pos: d.next_pos
        return false
    then
        return true

### Whether the bytes are well-formed UTF-8.
### :returns: `true` when the whole text decodes as UTF-8. An empty text is valid.
routine @@[Byte].is_utf8() -> Bool
    return me.peek().is_utf8()

### Whether a character can start at byte `index`: the byte there is not a UTF-8 continuation byte.
### :param index: The byte position.
### :returns: `true` when `index` is the count or the byte there is not a continuation byte. `false` past the end.
routine @[Byte].is_char_boundary(index: U64) -> Bool
    at_end: Bool = index == me.count
    when
        at_end => return true
        index > me.count => return false
        else =>
            b: U8 = Byte.to[U8](me.data.stride(index).peek())
            return b & 0xC0 != 0x80

### Whether a character can start at byte `index`: the byte there is not a UTF-8 continuation byte.
### :param index: The byte position.
### :returns: `true` when `index` is the count or the byte there is not a continuation byte. `false` past the end.
routine @@[Byte].is_char_boundary(index: U64) -> Bool
    return me.peek().is_char_boundary(index)

# -- iterators -----------------------------------------------------------------

### Iterates over the raw bytes as `U8` values.
### :returns: A {BytesIter} positioned at the first byte.
routine @[Byte].bytes() -> BytesIter
    iter: BytesIter = BytesIter(str: me.getview(), index: 0)
    return iter

### Iterates over the raw bytes as `U8` values.
### :returns: A {BytesIter} positioned at the first byte.
routine @@[Byte].bytes() -> BytesIter
    iter: BytesIter = me.peek().bytes()
    return iter

### Iterates over the characters, decoding UTF-8. A malformed sequence yields U+FFFD.
### :returns: A {BytesCharsIter} positioned at the first character.
routine @[Byte].chars() -> BytesCharsIter
    iter: BytesCharsIter = BytesCharsIter(str: me.getview(), index: 0)
    return iter

### Iterates over the characters, decoding UTF-8. A malformed sequence yields U+FFFD.
### :returns: A {BytesCharsIter} positioned at the first character.
routine @@[Byte].chars() -> BytesCharsIter
    iter: BytesCharsIter = me.peek().chars()
    return iter

# -- splitting -----------------------------------------------------------------

### The pieces of the text between the places `separator` occurs, in order. Each piece is a view of the same bytes
### (nothing is copied). Two separators next to each other give an empty piece between them, and a text without
### `separator` is one piece. An empty `separator` gives each character (one UTF-8 sequence) as its own piece. The list
### of pieces is new memory from `manager`, which the caller drops.
### :param separator: The bytes between the pieces.
### :param manager: The manager the list of pieces comes from.
### :returns: The pieces.
### :throws: Crashes with `MemoryAllocationError` when the manager has no memory to give.
@track_caller
@expensive("allocates the list of pieces")
routine @[Byte].split(separator: Me, manager: @MemoryManager) -> BorrowedSlice[@[Byte]]
    pieces: &[@[Byte]] <- BorrowedSlice[@[Byte]].construct(count: me.piece_count(separator),
        manager: manager)

    if separator.count == 0
        until at == me.count with at: U64 = 0, piece: U64 = 0
            end: U64 = me.char_end(at)
            pieces.getslot(piece).poke(me.slice(at, end))
            continue with at: end, piece: piece + 1
        return pieces

    until at + separator.count > me.count with at: U64 = 0, start: U64 = 0, piece: U64 = 0
        if me.slice(at, at + separator.count).eq(separator)
            pieces.getslot(piece).poke(me.slice(start, at))
            continue with at: at + separator.count, start: at + separator.count, piece: piece + 1
        continue with at: at + 1, start: start, piece: piece
    then
        pieces.getslot(piece).poke(me.slice(start, me.count))
    return pieces

### The words of the text: the runs of bytes between white space (space, tab, line feed, carriage return, vertical tab,
### form feed), in order. Each word is a view of the same bytes (nothing is copied), and white space at the ends or
### several white space bytes in a row give no empty word. The list of words is new memory from `manager`, which the
### caller drops.
### :param manager: The manager the list of words comes from.
### :returns: The words.
### :throws: Crashes with `MemoryAllocationError` when the manager has no memory to give.
@track_caller
@expensive("allocates the list of words")
routine @[Byte].words(manager: @MemoryManager) -> BorrowedSlice[@[Byte]]
    words: &[@[Byte]] <- BorrowedSlice[@[Byte]].construct(count: me.word_count(), manager: manager)

    until at == me.count with at: U64 = 0, start: U64 = 0, inside: Bool = false, word: U64 = 0
        if is_white_space(me.byte_at(at))
            if inside
                words.getslot(word).poke(me.slice(start, at))
                continue with at: at + 1, start: start, inside: false, word: word + 1
            continue with at: at + 1, start: start, inside: false, word: word
        if inside
            continue with at: at + 1, start: start, inside: true, word: word
        continue with at: at + 1, start: at, inside: true, word: word
    then
        if inside
            words.getslot(word).poke(me.slice(start, at))
    return words

### How many pieces {@[Byte].split} gives for `separator`.
### :param separator: The bytes between the pieces.
### :returns: The number of pieces.
secret routine @[Byte].piece_count(separator: Me) -> U64
    if separator.count == 0
        until at == me.count with at: U64 = 0, pieces: U64 = 0
            continue with at: me.char_end(at), pieces: pieces + 1
        then
            return pieces

    until at + separator.count > me.count with at: U64 = 0, pieces: U64 = 1
        if me.slice(at, at + separator.count).eq(separator)
            continue with at: at + separator.count, pieces: pieces + 1
        continue with at: at + 1, pieces: pieces
    then
        return pieces

### How many words {@[Byte].words} gives.
### :returns: The number of words.
secret routine @[Byte].word_count() -> U64
    until at == me.count with at: U64 = 0, inside: Bool = false, words: U64 = 0
        if is_white_space(me.byte_at(at))
            continue with at: at + 1, inside: false, words: words
        if inside
            continue with at: at + 1, inside: true, words: words
        continue with at: at + 1, inside: true, words: words + 1
    then
        return words

### The index after the character that starts at `at`: past its lead byte and the continuation bytes that follow.
### :param at: The index of a character's first byte.
### :returns: The index of the next character's first byte, or the count.
secret routine @[Byte].char_end(at: U64) -> U64
    until next == me.count with next: U64 = at + 1
        if me.byte_at(next) & 0xC0 != 0x80
            break
        continue with next: next + 1
    then
        return next

### Whether `b` is white space between words: space, tab, line feed, carriage return, vertical tab or form feed.
### :param b: The byte as a number.
### :returns: `true` for white space.
secret routine is_white_space(b: U8) -> Bool
    return b == 0x20 or 0x09 <= b <= 0x0D
