# Tessera stdlib: Vector[T, LANES] — LANES lanes of T as one SIMD value
#
# Maps to LLVM IR <LANES x T>, built into the builder like Items[T, COUNT]. A lane is an integer (S8..S64, U8..U64, U64,
# S64), a float (B32, B64), or a Bool, which makes Vector[Bool, LANES] a lane mask: what a compare gives and select
# takes. LANES is any buildtime U64 of at least 1, and the width is the program's choice: the same Vector[B32, 8]
# is one AVX register on x86-64-v3 and two SSE ones on x86-64-v1, and correct either way. SIMD_BYTES says how wide
# the target's native vectors are, for code that wants to match it.
#
# Operations are lane-wise and named like the scalar ones, and unchecked: integer add, sub, and mul wrap, and float
# lanes give the raw IEEE 754 result (infinity and NaN included), since a check on every lane would cost what SIMD
# saves. add_clamp and sub_clamp saturate instead. A shift by the lane width or more shifts every bit out, and float
# min and max return the other operand when one is NaN. Compares give a mask. The layout is LLVM's:
# lanes packed (a Bool lane is one bit) and aligned for the whole vector, so Vector[B32, 3] takes 16 bytes where
# Items[B32, 3] takes 12. A Vector can't cross the C ABI yet.

module System

### `LANES` lanes of `T` held as one SIMD value, mapped to LLVM `<LANES x T>`. A lane is an integer, a float, or a `Bool` (a `Vector[Bool, LANES]` is a lane mask). Operations are lane-wise and unchecked: integer `+ - *` wrap and float lanes give the raw IEEE 754 result. `LANES` may be any buildtime `U64` of at least 1.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
@llvm("<{LANES} x {T}>")
record Vector[T, LANES]
needs U64 LANES
obeys ViewingIndexable[Vector[T, LANES], T]
obeys Addable[Vector[T, LANES]], Subtractable[Vector[T, LANES]], Multiplicable[Vector[T, LANES]] when U64 LANES, T obeys NumberLane
obeys Divisible[Vector[T, LANES]], Negatable[Vector[T, LANES]] when U64 LANES, T obeys FloatLane
obeys ClampingAddable[Vector[T, LANES]], ClampingSubtractable[Vector[T, LANES]], Shiftable[Vector[T, LANES]] when U64 LANES, T obeys IntLane
obeys Bitwiseable[Vector[T, LANES]], Invertible[Vector[T, LANES]] when U64 LANES, T obeys BitLane
obeys LaneComparable[Vector[T, LANES], Vector[Bool, LANES]] when U64 LANES, T obeys NumberLane
    nothing

# -- lane kinds ----------------------------------------------------------------------

### T is an integer lane: clamping, shifts, and bitwise operations.
protocol IntLane[T]

### T is a float lane: division, square root, negation.
protocol FloatLane[T]

### T is a number lane, integer or float: arithmetic, compares, min and max, memory.
protocol NumberLane[T]

### T is a lane the bitwise operations take: an integer or a Bool.
protocol BitLane[T]

### T is Bool: the vector is a lane mask.
protocol MaskLane[T]

obeys IntLane[S8], IntLane[S16], IntLane[S32], IntLane[S64], IntLane[U8], IntLane[U16], IntLane[U32], IntLane[U64], IntLane[CSize], IntLane[CSSize]
obeys FloatLane[B32], FloatLane[B64]
obeys NumberLane[S8], NumberLane[S16], NumberLane[S32], NumberLane[S64], NumberLane[U8], NumberLane[U16], NumberLane[U32], NumberLane[U64], NumberLane[CSize], NumberLane[CSSize], NumberLane[B32], NumberLane[B64]
obeys BitLane[S8], BitLane[S16], BitLane[S32], BitLane[S64], BitLane[U8], BitLane[U16], BitLane[U32], BitLane[U64], BitLane[CSize], BitLane[CSSize], BitLane[Bool]
obeys MaskLane[Bool]

# -- the target's native width ---------------------------------------------------------

# The bytes in one of the target's vector registers, or 0 without SIMD registers: Vector[B32, SIMD_BYTES.div_trunc(4)]
# matches it. 32 with AVX2 (--cpu x86-64-v3 and up). 16 with SSE2, on AArch64, on ARM with NEON, and on RISC-V with
# V (its registers are at least 128 bits). 0 on i386 without SSE2, ARM without NEON (Cortex-M), RISC-V without V,
# and AVR. A wider Vector still works on any target, split into several registers or into scalar code.
### The `SIMD_BYTES` value on x86-64 with AVX2: 32 bytes, one 256-bit register.
@target(arch: "x86_64")
@feature("avx2")
preset SIMD_BYTES: U64 = 32
### The `SIMD_BYTES` value on x86-64 without AVX2: 16 bytes, one SSE2 register.
@target(arch: "x86_64")
@feature(not "avx2")
preset SIMD_BYTES: U64 = 16
### The `SIMD_BYTES` value on 32-bit x86 with AVX2: 32 bytes, one 256-bit register.
@target(arch: "x86")
@feature("avx2")
preset SIMD_BYTES: U64 = 32
### The `SIMD_BYTES` value on 32-bit x86 without AVX2 but with SSE2: 16 bytes, one SSE2 register.
@target(arch: "x86")
@feature(not "avx2")
@feature("sse2")
preset SIMD_BYTES: U64 = 16
### The `SIMD_BYTES` value on 32-bit x86 without SSE2: 0, since there are no vector registers.
@target(arch: "x86")
@feature(not "sse2")
preset SIMD_BYTES: U64 = 0
### The `SIMD_BYTES` value on AArch64: 16 bytes, one NEON register.
@target(arch: "aarch64")
preset SIMD_BYTES: U64 = 16
### The `SIMD_BYTES` value on ARM with NEON: 16 bytes, one NEON register.
@target(arch: "arm")
@feature("neon")
preset SIMD_BYTES: U64 = 16
### The `SIMD_BYTES` value on ARM without NEON: 0, since there are no vector registers.
@target(arch: "arm")
@feature(not "neon")
preset SIMD_BYTES: U64 = 0
### The `SIMD_BYTES` value on 64-bit RISC-V with the V extension: 16 bytes, the minimum register width of V.
@target(arch: "riscv64")
@feature("v")
preset SIMD_BYTES: U64 = 16
### The `SIMD_BYTES` value on 64-bit RISC-V without the V extension: 0, since there are no vector registers.
@target(arch: "riscv64")
@feature(not "v")
preset SIMD_BYTES: U64 = 0
### The `SIMD_BYTES` value on 32-bit RISC-V with the V extension: 16 bytes, the minimum register width of V.
@target(arch: "riscv32")
@feature("v")
preset SIMD_BYTES: U64 = 16
### The `SIMD_BYTES` value on 32-bit RISC-V without the V extension: 0, since there are no vector registers.
@target(arch: "riscv32")
@feature(not "v")
preset SIMD_BYTES: U64 = 0
### The `SIMD_BYTES` value on any other architecture: 0, since no vector registers are known.
@target(arch: not ("x86_64", "x86", "aarch64", "arm", "riscv64", "riscv32"))
preset SIMD_BYTES: U64 = 0

# -- metadata --------------------------------------------------------------------------

### The number of lanes, which is `LANES`.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :returns: `LANES` as a `U64`.
common routine Vector[T, LANES].count() -> U64
needs U64 LANES
    return LANES

# -- construction ----------------------------------------------------------------------

### A vector with every lane set to `x`.
### :param x: The value for every lane.
### :returns: The vector of `LANES` copies of `x`.
@external("llvm")
@template("{t0} = insertelement {Me} poison, {T} {x}, i64 0\n{result} = shufflevector {Me} {t0}, {Me} poison, <{LANES} x i32> zeroinitializer")
common routine Vector[T, LANES].splat(x: T) -> Me
needs U64 LANES

### Every lane zero (false, for a mask).
### :returns: The all-zero vector.
@external("llvm")
@template("{result} = bitcast {Me} zeroinitializer to {Me}")
common routine Vector[T, LANES].zero() -> Me
needs U64 LANES

### The array's elements as lanes, element i in lane i.
### :returns: The vector whose lane i is element i.
routine Items[T, COUNT].to[Vector[T, COUNT]]() -> Vector[T, COUNT]
needs RecordType T, U64 COUNT
    elements: &Me <- me
    acc: &Vector[T, COUNT] <- .hollow()

    start: Vector[T, COUNT] = Vector[T, COUNT].zero()
    start.poke_into(acc)

    for i in 0 til COUNT
        lane: T = elements[i]
        next: Vector[T, COUNT] = acc.load().with(index: i, x: lane)
        next.poke_into(acc)
    then
        return acc.load()

### The lanes as an array, lane i in element i.
### :returns: The array whose element i is lane i.
routine Vector[T, LANES].to[Items[T, LANES]]() -> Items[T, LANES]
needs RecordType T, U64 LANES
    elements: &Items[T, LANES] <- .hollow()

    for i in 0 til LANES
        lane: T = me[i]
        elements[i] = lane
    array: Items[T, LANES] = elements.load()
    return array

# -- lanes -----------------------------------------------------------------------------

### Reads lane `index` with no bounds check. {Vector.get} is the checked form.
### :param index: The lane to read. It must be less than `LANES`.
### :returns: The lane value.
@external("llvm")
@template("{result} = extractelement {Me} {me}, i64 {index}")
secret routine Vector[T, LANES].get_unchecked(index: U64) -> T
needs U64 LANES

### Replaces lane `index` with no bounds check. {Vector.with} is the checked form.
### :param index: The lane to replace. It must be less than `LANES`.
### :param x: The new lane value.
### :returns: A copy of `me` with that lane set.
@external("llvm")
@template("{result} = insertelement {Me} {me}, {T} {x}, i64 {index}")
secret routine Vector[T, LANES].with_unchecked(index: U64, x: T) -> Me
needs U64 LANES

### Reads lane `index`.
### :param index: The lane to read.
### :returns: The lane value.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is `LANES` or more.
@track_caller
routine Vector[T, LANES].getitem(index: U64) -> T
needs U64 LANES
    if not (index < LANES)
        throw IndexOutOfBoundsError(index, count: LANES)
    lane: T = me.get_unchecked(index)
    return lane

### A copy of `me` with lane `index` set to `x`.
### :param index: The lane to replace.
### :param x: The new lane value.
### :returns: The copy with that lane set.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is `LANES` or more.
@track_caller
routine Vector[T, LANES].with(index: U64, x: T) -> Me
needs U64 LANES
    if not (index < LANES)
        throw IndexOutOfBoundsError(index, count: LANES)
    r: Me = me.with_unchecked(index, x)
    return r

# -- memory ----------------------------------------------------------------------------

# A @Vector[T, LANES] loads and stores the whole vector at the vector's alignment. These read and write LANES Ts in a
# row at any T-aligned address: an array's elements, a list's storage.

### Reads the `LANES` values of `T` starting at `first` as lanes. `first` need only be aligned for `T`.
### :param first: The address of the first value.
### :returns: The vector, value i in lane i.
@external("llvm")
@template("{result} = load {Me}, ptr {first}, align {sizeof T}")
common routine Vector[T, LANES].peek_at(first: @T) -> Me
needs U64 LANES, T obeys NumberLane

### Writes the lanes to the `LANES` values of `T` starting at `first`. `first` need only be aligned for `T`.
### :param first: The address of the first value.
@external("llvm")
@template("store {Me} {me}, ptr {first}, align {sizeof T}")
routine Vector[T, LANES].poke_at(first: @T) -> None
needs U64 LANES, T obeys NumberLane

# -- arithmetic ------------------------------------------------------------------------

### Lane-wise sum, unchecked: integer lanes wrap modulo 2^bits (bits the lane width), float lanes give the raw IEEE 754
### sum (infinity and NaN included).
### :param other: The right-hand operand.
### :returns: The lane-wise sum.
@external("llvm")
@template("{result} = {by T|fadd|add|add} {Me} {me}, {other}")
routine Vector[T, LANES].add(other: Me) -> Me
needs U64 LANES, T obeys NumberLane

### Lane-wise difference, unchecked: integer lanes wrap modulo 2^bits (bits the lane width), float lanes give the raw
### IEEE 754 difference (infinity and NaN included).
### :param other: The right-hand operand.
### :returns: The lane-wise difference.
@external("llvm")
@template("{result} = {by T|fsub|sub|sub} {Me} {me}, {other}")
routine Vector[T, LANES].sub(other: Me) -> Me
needs U64 LANES, T obeys NumberLane

### Lane-wise product, unchecked: integer lanes wrap modulo 2^bits (bits the lane width), float lanes give the raw
### IEEE 754 product (infinity and NaN included).
### :param other: The right-hand operand.
### :returns: The lane-wise product.
@external("llvm")
@template("{result} = {by T|fmul|mul|mul} {Me} {me}, {other}")
routine Vector[T, LANES].mul(other: Me) -> Me
needs U64 LANES, T obeys NumberLane

### Lane-wise sum, each lane saturating at `T`'s `MIN` / `MAX`.
### :param other: The right-hand operand.
### :returns: The saturated lane-wise sum.
@external("llvm")
@template("{result} = call {Me} @llvm.{by T||s|u}add.sat.{mangle Me}({Me} {me}, {Me} {other})")
routine Vector[T, LANES].add_clamp(other: Me) -> Me
needs U64 LANES, T obeys IntLane

### Lane-wise difference, each lane saturating at `T`'s `MIN` / `MAX`.
### :param other: The right-hand operand.
### :returns: The saturated lane-wise difference.
@external("llvm")
@template("{result} = call {Me} @llvm.{by T||s|u}sub.sat.{mangle Me}({Me} {me}, {Me} {other})")
routine Vector[T, LANES].sub_clamp(other: Me) -> Me
needs U64 LANES, T obeys IntLane

### Lane-wise quotient of float lanes, unchecked: the raw IEEE 754 quotient (a signed infinity for a nonzero lane
### divided by zero, NaN for `0 / 0`).
### :param other: The divisor.
### :returns: The lane-wise quotient.
@external("llvm")
@template("{result} = fdiv {Me} {me}, {other}")
routine Vector[T, LANES].truediv(other: Me) -> Me
needs U64 LANES, T obeys FloatLane

### Each lane negated (-0.0 for 0.0).
### :returns: `me` with every lane negated.
@external("llvm")
@template("{result} = fneg {Me} {me}")
routine Vector[T, LANES].neg() -> Me
needs U64 LANES, T obeys FloatLane

### Each lane's magnitude.
### :returns: The lane-wise absolute value.
@external("llvm")
@template("{result} = call {Me} @llvm.fabs.{mangle Me}({Me} {me})")
routine Vector[T, LANES].abs() -> Me
needs U64 LANES, T obeys FloatLane

### Each lane's square root, unchecked: NaN for a negative lane (other than -0.0).
### :returns: The lane-wise square root.
@external("llvm")
@template("{result} = call {Me} @llvm.sqrt.{mangle Me}({Me} {me})")
routine Vector[T, LANES].sqrt() -> Me
needs U64 LANES, T obeys FloatLane

# min and max as selects, not minnum / maxnum: those become libm calls on 32-bit ARM. A NaN lane gives the other
# operand's lane, as the scalar min and max do. The templates take scalars or vectors alike.
### Lane-wise minimum. When one lane is NaN the other operand's lane is returned, as the scalar `min` does.
### :param other: The right-hand operand.
### :returns: The smaller lane of each pair.
@external("llvm")
@template("{by T|{t0} = fcmp uno {Me} {me}, {me}\n{t1} = fcmp uno {Me} {other}, {other}\n{t2} = fcmp ole {Me} {me}, {other}\n{t3} = select <{LANES} x i1> {t2}, {Me} {me}, {Me} {other}\n{t4} = select <{LANES} x i1> {t0}, {Me} {other}, {Me} {t3}\n{result} = select <{LANES} x i1> {t1}, {Me} {me}, {Me} {t4}|{result} = call {Me} @llvm.smin.{mangle Me}({Me} {me}, {Me} {other})|{result} = call {Me} @llvm.umin.{mangle Me}({Me} {me}, {Me} {other})}")
routine Vector[T, LANES].min(other: Me) -> Me
needs U64 LANES, T obeys NumberLane

### Lane-wise maximum. When one lane is NaN the other operand's lane is returned, as the scalar `max` does.
### :param other: The right-hand operand.
### :returns: The larger lane of each pair.
@external("llvm")
@template("{by T|{t0} = fcmp uno {Me} {me}, {me}\n{t1} = fcmp uno {Me} {other}, {other}\n{t2} = fcmp oge {Me} {me}, {other}\n{t3} = select <{LANES} x i1> {t2}, {Me} {me}, {Me} {other}\n{t4} = select <{LANES} x i1> {t0}, {Me} {other}, {Me} {t3}\n{result} = select <{LANES} x i1> {t1}, {Me} {me}, {Me} {t4}|{result} = call {Me} @llvm.smax.{mangle Me}({Me} {me}, {Me} {other})|{result} = call {Me} @llvm.umax.{mangle Me}({Me} {me}, {Me} {other})}")
routine Vector[T, LANES].max(other: Me) -> Me
needs U64 LANES, T obeys NumberLane

# -- bitwise and shifts ----------------------------------------------------------------

### Lane-wise bitwise AND.
### :param other: The right-hand operand.
### :returns: The lane-wise AND.
@external("llvm")
@template("{result} = and {Me} {me}, {other}")
routine Vector[T, LANES].bitand(other: Me) -> Me
needs U64 LANES, T obeys BitLane

### Lane-wise bitwise OR.
### :param other: The right-hand operand.
### :returns: The lane-wise OR.
@external("llvm")
@template("{result} = or {Me} {me}, {other}")
routine Vector[T, LANES].bitor(other: Me) -> Me
needs U64 LANES, T obeys BitLane

### Lane-wise bitwise XOR.
### :param other: The right-hand operand.
### :returns: The lane-wise XOR.
@external("llvm")
@template("{result} = xor {Me} {me}, {other}")
routine Vector[T, LANES].bitxor(other: Me) -> Me
needs U64 LANES, T obeys BitLane

### Lane-wise bitwise complement.
### :returns: `me` with every bit of every lane flipped.
@external("llvm")
@template("{result} = xor {Me} {me}, splat ({T} -1)")
routine Vector[T, LANES].bitnot() -> Me
needs U64 LANES, T obeys BitLane

### Each lane shifted left by the matching lane of `n`. A shift by the lane width or more (or a negative one) gives 0.
### :param n: The shift amount for each lane.
### :returns: The shifted lanes.
@external("llvm")
@template("{t0} = icmp ult {Me} {n}, splat ({T} {bits T})\n{t1} = shl {Me} {me}, {n}\n{result} = select <{LANES} x i1> {t0}, {Me} {t1}, {Me} zeroinitializer")
routine Vector[T, LANES].shift_left(n: Me) -> Me
needs U64 LANES, T obeys IntLane

### Each lane shifted right by the matching lane of `n`: arithmetic for signed lanes, logical for unsigned. A shift
### by the lane width or more (or a negative one) gives the sign fill: 0, or -1 for a negative signed lane.
### :param n: The shift amount for each lane.
### :returns: The shifted lanes.
@external("llvm")
@template("{t0} = icmp ult {Me} {n}, splat ({T} {bits T})\n{by T||{t1} = ashr {Me} {me}, {n}\n{t3} = icmp slt {Me} {me}, zeroinitializer\n{t2} = sext <{LANES} x i1> {t3} to {Me}|{t1} = lshr {Me} {me}, {n}\n{t2} = bitcast {Me} zeroinitializer to {Me}}\n{result} = select <{LANES} x i1> {t0}, {Me} {t1}, {Me} {t2}")
routine Vector[T, LANES].arith_shift_right(n: Me) -> Me
needs U64 LANES, T obeys IntLane

### Each lane shifted right by the matching lane of `n` with 0 bits filling in, for signed lanes too. A shift by the
### lane width or more (or a negative one) gives 0.
### :param n: The shift amount for each lane.
### :returns: The shifted lanes.
@external("llvm")
@template("{t0} = icmp ult {Me} {n}, splat ({T} {bits T})\n{t1} = lshr {Me} {me}, {n}\n{result} = select <{LANES} x i1> {t0}, {Me} {t1}, {Me} zeroinitializer")
routine Vector[T, LANES].logical_shift_right(n: Me) -> Me
needs U64 LANES, T obeys IntLane

# -- compares --------------------------------------------------------------------------

# Each gives a mask, lane i true where the compare holds for lane i. Float compares are ordered (false when a lane
# is NaN), as the scalar ones are.

### Lane-wise test of whether each lane of `me` is equal to the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :param other: The right-hand operand.
### :returns: A mask whose lane i is true where the relation holds for lane i.
@external("llvm")
@template("{result} = {by T|fcmp oeq|icmp eq|icmp eq} {Me} {me}, {other}")
routine Vector[T, LANES].eq(other: Me) -> Vector[Bool, LANES]
needs U64 LANES, T obeys NumberLane

### Lane-wise test of whether each lane of `me` is different from the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :param other: The right-hand operand.
### :returns: A mask whose lane i is true where the relation holds for lane i.
@external("llvm")
@template("{result} = {by T|fcmp one|icmp ne|icmp ne} {Me} {me}, {other}")
routine Vector[T, LANES].ne(other: Me) -> Vector[Bool, LANES]
needs U64 LANES, T obeys NumberLane

### Lane-wise test of whether each lane of `me` is less than the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :param other: The right-hand operand.
### :returns: A mask whose lane i is true where the relation holds for lane i.
@external("llvm")
@template("{result} = {by T|fcmp olt|icmp slt|icmp ult} {Me} {me}, {other}")
routine Vector[T, LANES].lt(other: Me) -> Vector[Bool, LANES]
needs U64 LANES, T obeys NumberLane

### Lane-wise test of whether each lane of `me` is less than or equal to the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :param other: The right-hand operand.
### :returns: A mask whose lane i is true where the relation holds for lane i.
@external("llvm")
@template("{result} = {by T|fcmp ole|icmp sle|icmp ule} {Me} {me}, {other}")
routine Vector[T, LANES].le(other: Me) -> Vector[Bool, LANES]
needs U64 LANES, T obeys NumberLane

### Lane-wise test of whether each lane of `me` is greater than the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :param other: The right-hand operand.
### :returns: A mask whose lane i is true where the relation holds for lane i.
@external("llvm")
@template("{result} = {by T|fcmp ogt|icmp sgt|icmp ugt} {Me} {me}, {other}")
routine Vector[T, LANES].gt(other: Me) -> Vector[Bool, LANES]
needs U64 LANES, T obeys NumberLane

### Lane-wise test of whether each lane of `me` is greater than or equal to the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
### :typeparam T: The lane type.
### :typeparam LANES: The number of lanes.
### :param other: The right-hand operand.
### :returns: A mask whose lane i is true where the relation holds for lane i.
@external("llvm")
@template("{result} = {by T|fcmp oge|icmp sge|icmp uge} {Me} {me}, {other}")
routine Vector[T, LANES].ge(other: Me) -> Vector[Bool, LANES]
needs U64 LANES, T obeys NumberLane

# -- masks -----------------------------------------------------------------------------

### Whether every lane is true.
### :returns: `true` when every lane of the mask is true.
@external("llvm")
@template("{result} = call i1 @llvm.vector.reduce.and.{mangle Me}({Me} {me})")
routine Vector[T, LANES].is_all_true() -> Bool
needs U64 LANES, T obeys MaskLane

### Whether some lane is true.
### :returns: `true` when at least one lane of the mask is true.
@external("llvm")
@template("{result} = call i1 @llvm.vector.reduce.or.{mangle Me}({Me} {me})")
routine Vector[T, LANES].is_any_true() -> Bool
needs U64 LANES, T obeys MaskLane

### Whether no lane is true.
### :returns: `true` when every lane of the mask is false.
routine Vector[T, LANES].is_none_true() -> Bool
needs U64 LANES, T obeys MaskLane
    some: Bool = me.is_any_true()
    return not some

### How many lanes are true.
### :returns: The count of true lanes, from 0 to `LANES`.
@external("llvm")
@template("{t0} = bitcast {Me} {me} to i{LANES}\n{t1} = call i{LANES} @llvm.ctpop.i{LANES}(i{LANES} {t0})\n{result} = zext i{LANES} {t1} to i64")
routine Vector[T, LANES].count_true() -> U64
needs U64 LANES, T obeys MaskLane

### Lane i of `if_true` where this mask's lane i is true, else lane i of `if_false`.
### :typeparam TValue: The lane type of the vectors to choose from.
### :param if_true: The lanes taken where the mask is true.
### :param if_false: The lanes taken where the mask is false.
### :returns: The lanes chosen by the mask.
@external("llvm")
@template("{result} = select {Me} {me}, <{LANES} x {TValue}> {if_true}, <{LANES} x {TValue}> {if_false}")
routine Vector[T, LANES].select[TValue](if_true: Vector[TValue, LANES],
    if_false: Vector[TValue, LANES]) -> Vector[TValue, LANES]
needs AnyType TValue, U64 LANES, T obeys MaskLane

# -- reductions ------------------------------------------------------------------------

### Adds two scalar lanes with no overflow check, for {Vector.sum}.
### :param a: The accumulated value.
### :param b: The lane to add.
### :returns: The sum, wrapping for integers.
@external("llvm")
@template("{result} = {by T|fadd|add|add} {T} {a}, {b}")
secret common routine Vector[T, LANES].lane_add(a: T, b: T) -> T
needs U64 LANES, T obeys NumberLane

### The smaller of two scalar lanes for {Vector.reduce_min}. A NaN operand yields the other.
### :param a: The accumulated value.
### :param b: The lane to compare.
### :returns: The smaller value.
@external("llvm")
@template("{by T|{t0} = fcmp uno {T} {a}, {a}\n{t1} = fcmp uno {T} {b}, {b}\n{t2} = fcmp ole {T} {a}, {b}\n{t3} = select i1 {t2}, {T} {a}, {T} {b}\n{t4} = select i1 {t0}, {T} {b}, {T} {t3}\n{result} = select i1 {t1}, {T} {a}, {T} {t4}|{result} = call {T} @llvm.smin.{mangle T}({T} {a}, {T} {b})|{result} = call {T} @llvm.umin.{mangle T}({T} {a}, {T} {b})}")
secret common routine Vector[T, LANES].lane_min(a: T, b: T) -> T
needs U64 LANES, T obeys NumberLane

### The larger of two scalar lanes for {Vector.reduce_max}. A NaN operand yields the other.
### :param a: The accumulated value.
### :param b: The lane to compare.
### :returns: The larger value.
@external("llvm")
@template("{by T|{t0} = fcmp uno {T} {a}, {a}\n{t1} = fcmp uno {T} {b}, {b}\n{t2} = fcmp oge {T} {a}, {b}\n{t3} = select i1 {t2}, {T} {a}, {T} {b}\n{t4} = select i1 {t0}, {T} {b}, {T} {t3}\n{result} = select i1 {t1}, {T} {a}, {T} {t4}|{result} = call {T} @llvm.smax.{mangle T}({T} {a}, {T} {b})|{result} = call {T} @llvm.umax.{mangle T}({T} {a}, {T} {b})}")
secret common routine Vector[T, LANES].lane_max(a: T, b: T) -> T
needs U64 LANES, T obeys NumberLane

### The lanes added in order, lane 0 first, unchecked like the lane-wise `+`: an integer sum wraps, a float sum gives
### the raw IEEE 754 value. In order, so a float sum is the same on every target, though a tree of adds would be faster.
### :returns: The sum of the lanes.
routine Vector[T, LANES].sum() -> T
needs U64 LANES, T obeys NumberLane
    for i in 1 til LANES with acc: T = me[0]
        lane: T = me[i]
        continue with acc: Me.lane_add(a: acc, b: lane)
    then
        return acc

### The smallest lane. A NaN lane counts only if every lane is NaN.
### :returns: The smallest lane value.
routine Vector[T, LANES].reduce_min() -> T
needs U64 LANES, T obeys NumberLane
    acc: &T <- .hollow()

    first: T = me[0]
    first.poke_into(acc)

    for i in 1 til LANES
        lane: T = me[i]
        next: T = Me.lane_min(a: acc.load(), b: lane)
        next.poke_into(acc)
    then
        return acc.load()

### The largest lane. A NaN lane counts only if every lane is NaN.
### :returns: The largest lane value.
routine Vector[T, LANES].reduce_max() -> T
needs U64 LANES, T obeys NumberLane
    acc: &T <- .hollow()

    first: T = me[0]
    first.poke_into(acc)

    for i in 1 til LANES
        lane: T = me[i]
        next: T = Me.lane_max(a: acc.load(), b: lane)
        next.poke_into(acc)
    then
        return acc.load()
