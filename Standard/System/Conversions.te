# Tessera stdlib: generic IR operation member methods
#
# Only truly type-agnostic casts live here. Integer comparisons/arithmetic
# and float comparisons/arithmetic are type-specific and live on their
# respective types.

module System

# -- casts ---------------------------------------------------------------------

### Reinterprets the bits of `me` as a `TTo` of the same size, such as a B64 as a U64. No conversion of the value takes place.
### :typeparam TTo: The type to reinterpret the bits as.
### :returns: The same bits viewed as the target type.
routine TFrom.bitcast[TTo]() -> TTo
needs TFrom: typename, TTo: typename
    r: TTo = bitcast[Me, TTo](me)
    return r

# -- identity conversions --------------------------------------------------------

### Converts `me` to its own type, keeping the low bits: every value fits, so this is `me`. With it, generic code that
### converts with `to_wrap[T]()` takes any integer `T`, the one it starts from included.
### :returns: `me` unchanged.
routine T.to_wrap[T]() -> T
needs T: typename, WrappingArithmetic[T]
    return me

### Converts `me` to its own type, saturating: every value fits, so this is `me`. With it, generic code that converts
### with `to_clamp[T]()` takes any integer `T`, the one it starts from included.
### :returns: `me` unchanged.
routine T.to_clamp[T]() -> T
needs T: typename, ClampingArithmetic[T]
    return me
