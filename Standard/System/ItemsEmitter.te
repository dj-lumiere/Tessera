# Tessera stdlib collection: ItemsEmitter[T, COUNT]
#
# Forward emitter over an Items[T, COUNT] held behind a pointer. The count is
# stored in the record at construction, so emit() needs no generic arithmetic.
#
# Satisfies concept SlotEmitter[T, ItemsEmitter[T, COUNT]] (and so Emitter).

module System

### A forward emitter over an {Items[T, COUNT]} held behind a pointer. The count `COUNT` is stored once at construction, and the Items must outlive the emitter.
### :typeparam T: The element type.
### :typeparam COUNT: The number of elements.
record ItemsEmitter[T, COUNT]
obeys SlotEmitter[T, ItemsEmitter[T, COUNT]]
needs T: record, COUNT: U64
    data: @T  # bitcast of the original @Items[T, COUNT]
    index: U64
    count: U64  # = COUNT, resolved at monomorphisation

### Creates an emitter positioned before the first element of `arr`.
### :param arr: The array to walk.
### :returns: A new emitter at index `0`.
common routine ItemsEmitter[T, COUNT].construct(arr: @Items[T, COUNT]) -> Me
needs T: record, COUNT: U64
    data: @T = bitcast[@Items[T, COUNT], @T](arr)
    emitter: Me = Me(data: data, index: 0, count: COUNT)
    return emitter

### An emitter over the array, at its first element: `e: &ItemsEmitter[T, COUNT] <- array.emitter()`, then `each x in e`.
### :returns: A new {ItemsEmitter[T, COUNT]} over `me`.
routine @Items[T, COUNT].emitter() -> ItemsEmitter[T, COUNT]
needs T: record, COUNT: U64
    emitter: ItemsEmitter[T, COUNT] = ItemsEmitter[T, COUNT].construct(me)
    return emitter

### Yields the next element and advances the emitter.
### :returns: The next element, in index order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @ItemsEmitter[T, COUNT].emit() -> T
needs T: record, COUNT: U64
    index: U64 = me.index.peek()

    count: U64 = me.count.peek()
    if index >= count
        throw AbsentValueError()
    data: @T = me.data.peek()
    value: T = data.stride(index).peek()
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the emitter.
### :returns: The address of the next element, in index order.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @ItemsEmitter[T, COUNT].next() -> @T
needs T: record, COUNT: U64
    index: U64 = me.index.peek()

    if index >= me.count.peek()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = me.data.peek().stride(index)
    return element
