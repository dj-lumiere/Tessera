# Tessera stdlib: CORE-MATH multi-word integer helpers for the binary128 log and expm1
#
# Ported from CORE-MATH, src/binary128/log/logq.c and src/binary128/expm1/expm1q.c via RazorForge's
# B128Wide.rf (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH
#
# Words are U64 and U128, and word arithmetic wraps (_wrap) like the C unsigned arithmetic it replaces.
# Counts and indices use the plain (overflow-checked) operations.
# Numbers wider than 128 bits are little-endian runs of 64-bit words (word 0 is the least significant): a
# CmWide3 value for 3 words, a @U64 buffer for 6 or 7. The CORE-MATH name of each
# helper is in its comment.

module Standard/Core

### A 192-bit number as three 64-bit words, w0 the least significant.
record CmWide3
    w0: U64
    w1: U64
    w2: U64

# -- 64- and 128-bit words -----------------------------------------------------

### (int64_t) x >> n: an arithmetic shift of the word read as signed.
### :param x: The word.
### :param n: The shift amount, below 64.
### :returns: The shifted word.
routine cm_sar(x: U64, n: U64) -> U64
    signed: S64 = x.to_wrap[S64]()
    r: U64 = (signed >> n.to[S64]()).to_wrap[U64]()
    return r

### (__int128) x >> n: an arithmetic shift of the 128-bit word read as signed.
### :param x: The word.
### :param n: The shift amount, below 128.
### :returns: The shifted word.
routine cm_sar(x: U128, n: U128) -> U128
    signed: S128 = x.to_wrap[S128]()
    r: U128 = (signed >> n.to[S128]()).to_wrap[U128]()
    return r

### The sign mask of a word read as signed: all ones when its top bit is set, else 0.
### :param x: The word.
### :returns: The mask.
routine cm_sign_mask64(x: U64) -> U64
    r: U64 = 0 -% (x >> 63)
    return r

### A 128-bit word from its two 64-bit halves.
### :param hi: The high half.
### :param lo: The low half.
### :returns: (hi:lo).
routine cm_wide_u128(hi: U64, lo: U64) -> U128
    high: U128 = hi.to[U128]() << 64
    r: U128 = high | lo.to[U128]()
    return r

### The high 64 bits of a 128-bit word.
### :param x: The word.
### :returns: The high half.
routine cm_wide_hi(x: U128) -> U64
    r: S64 = (x >> 64).to_wrap[S64]()
    return r.to_wrap[U64]()

### The low 64 bits of a 128-bit word.
### :param x: The word.
### :returns: The low half.
routine cm_wide_lo(x: U128) -> U64
    r: S64 = x.to_wrap[S64]()
    return r.to_wrap[U64]()

### muu: the full 128-bit product of two words.
### :param a: The first factor.
### :param b: The second factor.
### :returns: a * b.
routine cm_wide_mul(a: U64, b: U64) -> U128
    r: U128 = a.to[U128]() *% b.to[U128]()
    return r

### mhuu: the high word of the 64x64-bit product.
### :param a: The first factor.
### :param b: The second factor.
### :returns: (a * b) >> 64.
routine cm_wide_mulhi(a: U64, b: U64) -> U64
    p: U128 = cm_wide_mul(a, b)
    r: U64 = cm_wide_hi(p)
    return r

### mhUU: the approximate high half of the 128x128-bit product (the low x low product is dropped).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The approximate (a * b) >> 128.
routine cm_wide_mulhi(a: U128, b: U128) -> U128
    a0: U64 = cm_wide_lo(a)
    a1: U64 = cm_wide_hi(a)
    b0: U64 = cm_wide_lo(b)
    b1: U64 = cm_wide_hi(b)
    a1b1: U128 = cm_wide_mul(a: a1, b: b1)
    a1b0: U128 = cm_wide_mul(a: a1, b: b0)
    a0b1: U128 = cm_wide_mul(a: a0, b: b1)
    r: U128 = a1b1 +% (a1b0 >> 64) +% (a0b1 >> 64)
    return r

### mhuU: (a * b) >> 64 for a 64-bit a and a 128-bit b.
### :param a: The 64-bit factor.
### :param b: The 128-bit factor.
### :returns: The product shifted down one word.
routine cm_wide_mulhi(a: U64, b: U128) -> U128
    ab0: U128 = cm_wide_mul(a, b: cm_wide_lo(b))
    ab1: U128 = cm_wide_mul(a, b: cm_wide_hi(b))
    r: U128 = ab1 +% (ab0 >> 64)
    return r

# -- 3-word numbers ------------------------------------------------------------

### Row i of a table of 3-word entries.
### :param table: The table's first word.
### :param i: The row.
### :returns: The row's three words.
routine cm_wide_row3(table: @U64, i: USize) -> CmWide3
    base: USize = i * 3
    w0: U64 = table.stride(base).peek()
    w1: U64 = table.stride(base + 1).peek()
    w2: U64 = table.stride(base + 2).peek()
    r: CmWide3 = CmWide3(w0: w0, w1: w1, w2: w2)
    return r

### mahu1u3u3: ((a * b) >> 64) + c over 3 words, wrapping past 192 bits.
### :param a: The one-word factor.
### :param b: The 3-word factor.
### :param c: The 3-word addend.
### :returns: The 3-word result.
routine cm_wide_mulhi_add3(a: U64, b: CmWide3, c: CmWide3) -> CmWide3
    ab0: U128 = cm_wide_mul(a, b: b.w0)
    ab1: U128 = cm_wide_mul(a, b: b.w1)
    ab2: U128 = cm_wide_mul(a, b: b.w2)
    t0: U128 = (ab1 & 0xFFFFFFFFFFFFFFFF) + (ab0 >> 64)
    s0: U128 = c.w0.to[U128]() + (t0 & 0xFFFFFFFFFFFFFFFF)
    t1_part: U128 = (ab2 & 0xFFFFFFFFFFFFFFFF) + (ab1 >> 64)
    t1: U128 = t1_part + (t0 >> 64)
    s1_part: U128 = c.w1.to[U128]() + (t1 & 0xFFFFFFFFFFFFFFFF)
    s1: U128 = s1_part + (s0 >> 64)
    t2: U128 = (ab2 >> 64) + (t1 >> 64)
    w2: U64 = c.w2 +% cm_wide_lo(t2) +% cm_wide_hi(s1)
    r: CmWide3 = CmWide3(w0: cm_wide_lo(s0), w1: cm_wide_lo(s1), w2: w2)
    return r

### a + b over 3 words, wrapping past 192 bits.
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
routine cm_wide_add3(a: CmWide3, b: CmWide3) -> CmWide3
    s0: U128 = a.w0.to[U128]() + b.w0.to[U128]()
    s1_part: U128 = a.w1.to[U128]() + b.w1.to[U128]()
    s1: U128 = s1_part + (s0 >> 64)
    w2: U64 = a.w2 +% b.w2 +% cm_wide_hi(s1)
    r: CmWide3 = CmWide3(w0: cm_wide_lo(s0), w1: cm_wide_lo(s1), w2: w2)
    return r

### a - b over 3 words, wrapping below zero.
### :param a: The minuend.
### :param b: The subtrahend.
### :returns: The difference.
routine cm_wide_sub3(a: CmWide3, b: CmWide3) -> CmWide3
    borrow0: Bool = a.w0 < b.w0
    w1: U64 = a.w1 -% b.w1 -% borrow0.to[U64]()
    ties: Bool = a.w1 == b.w1 and borrow0
    borrow1: Bool = a.w1 < b.w1 or ties
    w2: U64 = a.w2 -% b.w2 -% borrow1.to[U64]()
    r: CmWide3 = CmWide3(w0: a.w0 -% b.w0, w1: w1, w2: w2)
    return r

# -- word buffers --------------------------------------------------------------

### XORs each word of x[0..n) with mask, in place.
### :param x: The words.
### :param n: How many words.
### :param mask: The mask.
routine cm_wide_xor_words(x: @U64, n: USize, mask: U64) -> None
    each i in 0 til n
        word: U64 = x.stride(i).peek()
        (word ^ mask).poke_into(x.stride(i))
    then
        return

### Writes (a * b) >> 64 for a 7-word a, truncated to 7 words. out may be a.
### :param a: The 7-word factor.
### :param b: The one-word factor.
### :param out: Room for 7 words.
routine cm_wide_mul7w(a: @U64, b: U64, out: @U64) -> None
    local prev: @U64 <- .hollow()

    a0: U64 = a.stride(0).peek()
    high0: U64 = cm_wide_mulhi(a: a0, b)
    high0.poke_into(prev)

    each i in 1 til 7
        ai: U64 = a.stride(i).peek()
        p: U128 = cm_wide_mul(a: ai, b)
        s: U128 = (p & 0xFFFFFFFFFFFFFFFF) + prev.peek().to[U128]()
        out.stride(i - 1).poke(cm_wide_lo(s))
        carried: U64 = cm_wide_hi(p) +% cm_wide_hi(s)
        carried.poke_into(prev)
    out.stride(6).poke(prev.peek())
    return

### mhu7xu2: writes the words at or above word 2 of the 7x2-word product a * b, as 7 words. out must not be a.
### :param a: The 7-word factor.
### :param b: The 2-word factor.
### :param out: Room for 7 words.
routine cm_wide_mulhi_7x2(a: @U64, b: U128, out: @U64) -> None
    local shifted_buf: @Array[U64, 7] <- [0, 0, 0, 0, 0, 0, 0]
    local shifted: @U64 = shifted_buf.to[@U64]()
    local low_buf: @Array[U64, 7] <- .hollow()
    local low: @U64 = low_buf.to[@U64]()
    local carry: @U64 <- .hollow()

    cm_wide_mul7w(a, b: cm_wide_hi(b), out)

    # shifted = a >> 64, the partner of b's low word
    each i in 0 til 6
        w: U64 = a.stride(i + 1).peek()
        shifted.stride(i).poke(w)
    cm_wide_mul7w(a: shifted, b: cm_wide_lo(b), out: low)
    0.poke_into(carry)

    each i in 0 til 7
        o: U64 = out.stride(i).peek()
        t: U64 = low.stride(i).peek()
        pair: U128 = o.to[U128]() + t.to[U128]()
        s: U128 = pair + carry.peek().to[U128]()
        out.stride(i).poke(cm_wide_lo(s))
        cm_wide_hi(s).poke_into(carry)
    then
        return

### arsu7: arithmetic right shift of the 7-word x by n bits (n < 192), in place.
### :param x: The 7 words.
### :param n: The shift amount.
routine cm_wide_ashr7(x: @U64, n: U64) -> None
    local rk: U64 = n & 63
    local lk: U64 = 64 -% rk & 63
    local qk: USize = (n >> 6).to[USize]()

    top: U64 = x.stride(6).peek()

    # words move down by qk and shift by rk. The top word is shifted in once the loop ends
    top2: S64 = top.to_wrap[S64]()
    while qk + i <= 5 with i: USize = 0
        src2: USize = qk + i
        lower: U64 = x.stride(src2).peek()
        upper: U64 = x.stride(src2 + 1).peek()
        combined: U64 = (upper << lk) | (lower >> rk)
        aligned: Bool = rk == 0
        limb: U64 = when
            aligned => lower
            else => combined
        x.stride(i).poke(limb)
        continue with i: i + 1
    then
        k: USize = 6 - qk
        x.stride(k).poke((top2 >> rk.to[S64]()).to_wrap[U64]())

        sign: S64 = top2 >> 63

        each k2 in k + 1 til 7
            x.stride(k2).poke(sign.to_wrap[U64]())
        then
            return

### mhu6u6u6: writes the approximate high 6 words of the 6x6-word product a * b: every partial-product half at
### or above word 6, summed exactly modulo 2^384. Word w of the result reads only words >= w of a and b, so
### out may be a or b.
### :param b: The first 6-word factor.
### :param a: The second 6-word factor.
### :param out: Room for 6 words.
routine cm_wide_mulhi_6x6(b: @U64, a: @U64, out: @U64) -> None
    local sum: @U128 <- 0

    each w in 0 til 6
        # the high half of a_i * b_(w+5-i) lands in word w, and so does the low half of a_i * b_(w+6-i)
        each i in w til 6
            ai: U64 = a.stride(i).peek()
            j: USize = w + 5 - i
            bj: U64 = b.stride(j).peek()
            high: U128 = cm_wide_mul(a: ai, b: bj) >> 64
            has_low: Bool = i > w
            k: USize = when
                has_low => j + 1
                else => j
            bk: U64 = b.stride(k).peek()
            low: U128 = cm_wide_mul(a: ai, b: bk) & 0xFFFFFFFFFFFFFFFF
            with_hi: U128 = sum.peek() + high
            next: U128 = when
                has_low => with_hi + low
                else => with_hi
            next.poke_into(sum)
        then
            out.stride(w).poke(cm_wide_lo(sum.peek()))
            (sum.peek() >> 64).poke_into(sum)
            continue
    then
        return

### mahu1u6u6: writes ((a * b) >> 64) + c over 6 words. out may be b or c.
### :param a: The one-word factor.
### :param b: The 6-word factor.
### :param c: The 6-word addend.
### :param out: Room for 6 words.
routine cm_wide_mulhi_add6(a: U64, b: @U64, c: @U64, out: @U64) -> None
    b0: U64 = b.stride(0).peek()

    each i in 0 til 6 with prev: U64 = cm_wide_mulhi(a, b: b0), carry: U64 = 0
        # b's word i + 1 (none past word 5) times a, plus the high word carried from word i
        has_next: Bool = i < 5
        j: USize = (i + 1).min(5)
        bj: U64 = b.stride(j).peek()
        product: U128 = cm_wide_mul(a, b: bj)
        p: U128 = when
            has_next => product
            else => 0
        s: U128 = (p & 0xFFFFFFFFFFFFFFFF) + prev.to[U128]()
        ci: U64 = c.stride(i).peek()
        s2_part: U128 = ci.to[U128]() + (s & 0xFFFFFFFFFFFFFFFF)
        s2: U128 = s2_part + carry.to[U128]()
        out.stride(i).poke(cm_wide_lo(s2))
        continue with prev: cm_wide_hi(p) +% cm_wide_hi(s), carry: cm_wide_hi(s2)
    then
        return

### addu6u6: writes a + b over 6 words, dropping the final carry. out may be a or b.
### :param a: The first addend.
### :param b: The second addend.
### :param out: Room for 6 words.
routine cm_wide_add6(a: @U64, b: @U64, out: @U64) -> None
    local carry: @U64 <- 0

    each i in 0 til 6
        ai: U64 = a.stride(i).peek()
        bi: U64 = b.stride(i).peek()
        pair: U128 = ai.to[U128]() + bi.to[U128]()
        s: U128 = pair + carry.peek().to[U128]()
        out.stride(i).poke(cm_wide_lo(s))
        cm_wide_hi(s).poke_into(carry)
    then
        return

# -- 2^f to about 380 bits -----------------------------------------------------

### Row i of the 2^r coefficient table, as a pointer to its 6 words.
### :param i: The coefficient's index, 0 to 36.
### :returns: The row's first word.
routine cm_wide_coefficient(i: USize) -> @U64
    table: @U64 = CM_WIDE_EC.to[@U64]()
    row: @U64 = table.stride(i * 6)
    return row

### Writes the 2^r polynomial on the top word x: Horner over every coefficient row.
### :param x: The top word of the fraction.
### :param out: Room for 6 words.
routine cm_wide_pol6(x: U64, out: @U64) -> None
    cm_wide_mulhi_add6(a: x, b: cm_wide_coefficient(36), c: cm_wide_coefficient(35), out)

    while true with i: USize = 34
        cm_wide_mulhi_add6(a: x, b: out, c: cm_wide_coefficient(i), out)
        if i == 0
            return
        else
            continue with i: i - 1

### Writes the same polynomial on the second word x, keeping only the terms that still matter: row r enters
### shifted down by r words.
### :param x: The second word of the fraction.
### :param out: Room for 6 words.
routine cm_wide_pol6red(x: U64, out: @U64) -> None
    local row_buf: @Array[U64, 6] <- [0, 0, 0, 0, 0, 0]
    local row: @U64 = row_buf.to[@U64]()

    out.zeroinit(6)

    while r != 0 with r: USize = 5
        # row[k] = coefficient r's word r + k, for k <= 5 - r (the words above keep the zeros they started with)
        while r + k != 6 with k: USize = 0
            coefficient: @U64 = cm_wide_coefficient(r)
            w: U64 = coefficient.stride(r + k).peek()
            row.stride(k).poke(w)
            continue with k: k + 1
        then
            cm_wide_mulhi_add6(a: x, b: out, c: row, out)
            continue with r: r - 1
    cm_wide_mulhi_add6(a: x, b: out, c: cm_wide_coefficient(0), out)
    return

### Writes the polynomial's degree-2 contribution from the low words 0..3 of x.
### :param x: The fraction's words.
### :param out: Room for 6 words.
routine cm_wide_pol6redred(x: @U64, out: @U64) -> None
    x0: U64 = x.stride(0).peek()
    x1: U64 = x.stride(1).peek()
    x2: U64 = x.stride(2).peek()
    x3: U64 = x.stride(3).peek()
    local xs_buf: @Array[U64, 6] <- [0, 0, x0, x1, x2, x3]
    xs: @U64 = xs_buf.to[@U64]()
    local f_buf: @Array[U64, 6] <- .hollow()
    f: @U64 = f_buf.to[@U64]()
    cm_wide_mulhi_6x6(b: xs, a: cm_wide_coefficient(2), out: f)
    cm_wide_shift_down2(f, out)
    out.stride(4).poke(0)
    out.stride(5).poke(0)
    cm_wide_add6(a: out, b: cm_wide_coefficient(1), out)
    cm_wide_mulhi_6x6(b: xs, a: out, out: f)
    cm_wide_shift_down2(f, out)
    c0: @U64 = cm_wide_coefficient(0)
    c4: U64 = c0.stride(4).peek()
    c5: U64 = c0.stride(5).peek()
    out.stride(4).poke(c4)
    out.stride(5).poke(c5)
    return

### Copies f[2..5] to out[0..3].
### :param f: The 6 source words.
### :param out: Room for 4 words.
routine cm_wide_shift_down2(f: @U64, out: @U64) -> None
    f2: U64 = f.stride(2).peek()
    f3: U64 = f.stride(3).peek()
    f4: U64 = f.stride(4).peek()
    f5: U64 = f.stride(5).peek()
    out.stride(0).poke(f2)
    out.stride(1).poke(f3)
    out.stride(2).poke(f4)
    out.stride(3).poke(f5)
    return

### Writes 2^f to about 380 bits, as 6 words, for the fixed-point fraction f in words 0..5 of the 7-word x: bits
### 60..63 of word 5 pick the 2^(j/16) table row, the rest feed the polynomial. x is left unchanged.
### :param x: The 7 words holding the fraction.
### :param out: Room for 6 words.
routine cm_wide_exp2_frac(x: @U64, out: @U64) -> None
    local f_buf: @Array[U64, 6] <- .hollow()
    f: @U64 = f_buf.to[@U64]()
    local f1_buf: @Array[U64, 6] <- .hollow()
    f1: @U64 = f1_buf.to[@U64]()
    local f2_buf: @Array[U64, 6] <- .hollow()
    f2: @U64 = f2_buf.to[@U64]()
    x4: U64 = x.stride(4).peek()
    x5: U64 = x.stride(5).peek()
    j: USize = (x5 >> 60).to[USize]()
    cm_wide_pol6(x: x5 & 0x0FFFFFFFFFFFFFFF, out: f)
    cm_wide_pol6red(x: x4, out: f1)
    cm_wide_pol6redred(x, out: f2)
    cm_wide_mulhi_6x6(b: f, a: f1, out: f)
    cm_wide_mulhi_6x6(b: f, a: f2, out: f)
    etbl: @U64 = CM_WIDE_ETBL.to[@U64]()
    row: @U64 = etbl.stride(j * 6)
    cm_wide_mulhi_6x6(b: f, a: row, out)
    return

# -- tables --------------------------------------------------------------------

### 1/ln(2) to 448 bits
preset CM_WIDE_ILN2: @Array[U64, 7] <- [0xEA90B9E60C4A90A0, 0x24D92F75C16BE0B3, 0xDE1C43F755176CD6,
    0x8B25166CD1A13247, 0xEB577AA8DD695A58, 0xBE87FED0691D3E88, 0xB8AA3B295C17F0BB]

### 2^(j/16), j = 0..15, to 384 bits: one 6-word row per j
preset CM_WIDE_ETBL: @Array[U64, 96] <- [0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
    0x0000000000000000, 0x0000000000000000, 0x8000000000000000, 0x82DC9BF3421840D1,
    0x7835AF9AB4E6355C, 0x5D42B362AF1EE859, 0x148A0459E7585151, 0xC5C95B8C2154C1B2,
    0x85AAC367CC487B14, 0x9994FAC7F4EA654B, 0xB4F28C879A524BD4, 0x91E135EE84A3F733,
    0x1AA84FFBEBAC349F, 0xFBE4628758A53C90, 0x8B95C1E3EA8BD6E6, 0x23B504FB5DADBB25,
    0x4E0D990C27C43643, 0xF1203CAF65BFB9B9, 0x1942B34816FB4F26, 0x0FD6D8E0AE5AC9D8,
    0x91C3D373AB11C336, 0x4E9F94EE0C90DBBD, 0xBE47C34D380250A8, 0xD78B65CBEFA7BB6F,
    0x5E139A1B14FA8178, 0x46AD23182E42F6F6, 0x9837F0518DB8A96F, 0xA264696B6F6E2B1C,
    0xCD12E5ADA91EEF7B, 0x21F977FE7C7FA117, 0x65C15C122133E2A2, 0xA0911F09EBB9FDD1,
    0x9EF5326091A111AD, 0xAD35E8E58C5CE4F4, 0x5343B4A0330A8052, 0x2589C98A8290D3F0,
    0x1DD170ACE2BCFC17, 0x1CBD7F621710701B, 0xA5FED6A9B15138EA, 0x739A3D061FEA7592,
    0x458FD5F44E26A7A7, 0xB165F141833A67DA, 0x6BE409407034FDED, 0x4980A8C8F59A2EC4,
    0xAD583EEA42A14AC6, 0xA8B1FE6FDC83DB39, 0x4AFC83043AB8A2C3, 0xED17AC8583339915,
    0x1D6F60BA893BA84C, 0x597D89B3754ABE9F, 0xB504F333F9DE6484, 0x283C66DB56DF97F8,
