# Tessera stdlib: the correctly rounded base-2 exponential 2^x of B128
#
# x itself is the fixed-point multiple of log2(2), so it goes straight to the shared
# 2^x engine (ExpShared.te). Integer x gives the exact power of two, normal or
# subnormal. Round to nearest only: overflow gives +inf, underflow a correctly
# rounded subnormal or +0, NaN comes back quiet with its sign and payload.
#
# Ported from CORE-MATH, src/binary128/exp2/exp2q.c via RazorForge's B128Exp2.rf.
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### x >= 2^14 overflows
preset CM_EXP2_OVERFLOW:  U128 = 0x400D0000000000000000000000000000
### x <= -0x1.01bcp+14 rounds to +0
preset CM_EXP2_UNDERFLOW: U128 = 0xC00D01BC000000000000000000000000

### The base-2 exponential 2^`me`, correctly rounded to nearest (a CORE-MATH port), exact for integer `me`.
### :returns: 2^`me`: +inf from 2^14 on, a correctly rounded subnormal or +0 at the bottom of the range. A NaN
###     comes back quieted with its sign and payload.
routine B128.exp2(me: Me) -> Me
    local u: U128 = me.bits()

    nan: Bool = me.is_nan()
    over: Bool = me > b128_of(0x400D0008000000000000000000000000)  # 16386
    under: Bool = me < b128_of(0xC00D0300000000000000000000000000)  # -16576
    quiet: Me = b128_of(b128_quiet(me.bits()))
    infinity: Me = Me.INFINITY
    plus_zero: Me = b128_of(0)
    when
        nan => return quiet
        over => return infinity
        under => return plus_zero
        else =>
            hi: U64 = cm_exp_hi(u)
            mag_hi: U64 = hi & 0x7FFFFFFFFFFFFFFF
            # 2^x rounds to 1
            when
                mag_hi < 0x3F8D71547652B82F => return CM_EXP_ONE
                mag_hi >= 0x400D000000000000 =>
                    # NaN, infinities, and the overflow and underflow thresholds
                    is_nan: Bool = b128_is_nan_bits(u)
                    nonnegative: Bool = ~b128_is_negative_bits(u)
                    overflow: Bool = nonnegative and u >= CM_EXP2_OVERFLOW
                    underflow: Bool = u >= CM_EXP2_UNDERFLOW
                    quiet2: Me = b128_of(u | B128_QUIET_BIT)
                    when
                        is_nan => return quiet2
                        overflow => return Me.INFINITY
                        underflow => return CM_EXP_ZERO
                        else => pass
                else => pass
            # |x| >= 1 with no fraction bits in the low word
            e: S64 = b128_exponent(u)
            if e >= 16383 and u.to_wrap[S64]() == 0
                # the high word has 16 sign and exponent bits, then e - 16383 integer bits
                fraction_bits: U64 = cm_exp_hi(u) << (e - 16367).to[U64]()
                fraction: S64 = fraction_bits.to_wrap[S64]()
                if fraction == 0
                    r: Me = cm_exp2_exact(u, e)
                    return r
            # the significand, two's-complemented for negative x
            hi2: S64 = cm_exp_hi(u).to_wrap[S64]()
            sign2: U128 = 0 -% (u >> 127)
            sig: U128 = (u & B128_FRAC_MASK) | B128_IMPLICIT
            signed: U128 = (sig ^ sign2) -% sign2
            words: CmExpWords3 = CmExpWords3(w0: 0, w1: signed.to_wrap[S64]().to_wrap[U64](),
                w2: cm_exp_hi(signed))
            reduced: CmExpWords3 = cm_exp_ashr3(w: words, n: (0x401B - e).to[U64]())
            r: Me = cm_exp_finish(fs: reduced, x: u, kind: CM_EXP_KIND_TWO)
            return r

### 2^n for the integer n = x (biased exponent e): exact, normal or subnormal.
### :param u: The bits of x, an integer with |x| >= 1 in the range that neither overflows nor underflows to 0.
### :param e: The biased exponent of x.
### :returns: 2^x, exact.
routine cm_exp2_exact(u: U128, e: S64) -> B128
    hi: S64 = cm_exp_hi(u).to_wrap[S64]()
    sign_mask: S64 = hi >> 63
    sig_bits: S64 = (hi & 0xFFFFFFFFFFFF) | 0x1000000000000
    sig_hi: U64 = sig_bits.to_wrap[U64]()
    magnitude: S64 = (sig_hi >> (16431 - e).to[U64]()).to[S64]()
    n: S64 = (magnitude ^ sign_mask) - sign_mask
    biased: S64 = n + 16383
    if biased > 0
        r: B128 = b128_of(biased.to[U128]() << 112)
        return r
    # 2^-16383 is bit 111, and each step down halves it
    r: B128 = b128_of(B128_QUIET_BIT.shr((0 - biased).to[U128]()))
    return r
