# Tessera stdlib: the shared engine of the correctly rounded B128 atan and atan2
#
# Ported from CORE-MATH, src/binary128/atan/atanq.c and src/binary128/atan2/atan2q.c via
# RazorForge's B128AtanShared.rf. The two C files carry identical integer helpers, tables and
# series kernels. They live here once, and Atan.te / Atan2.te keep only their own argument
# reduction and reconstruction.
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH
#
# Only the round-to-nearest path of the original is kept (no rounding-mode probe, errno or
# exception flags). Everything runs on integers: the reduced argument is kn / kd × 2^-dn, a
# 128-bit numerator over a normalized denominator. The fast path evaluates the arc tangent
# series in 128-bit words, and the accurate path, taken when the fast result lies too close to a
# rounding boundary, in up to 8 64-bit limbs (an Array[S64, 8], limb 0 least significant). All
# limbs and words are read as unsigned.

module Standard/Core

### The reduced argument: kn / (kd2:kd1:kd0) × 2^-dn = (b/a - t) / (1 + b/a × t) against the
### table angle atan(t), t = TN[isct] / 2^15. g says the ratio was inverted (|arg| >= 1), and zero
### (atan2 only) that one coordinate is zero, so there is nothing to reduce.
record CmAtanReduction
    zero: Bool
    g: Bool
    isct: U64
    dn: S64
    kn: U128
    kd0: S64
    kd1: U64
    kd2: U64

### A 192-bit fixed-point number: top holds bits 191..128, low bits 127..0.
record CmAtanU192
    top: U64
    low: U128

### A fast-path result: the magnitude bits of the B128, and whether it lies too close to a
### rounding boundary to trust (then the accurate path decides).
record CmAtanRounded
    hard: Bool
    bits: U128

### A 128-bit word normalized so its top bit is set, and the left shift that took.
record CmAtanNorm
    kn: U128
    shift: S64

# -- word helpers ----------------------------------------------------------------

### A 128-bit value from its high and low words.
### :param hi: The high word.
### :param lo: The low word.
### :returns: `hi` × 2^64 + `lo`.
routine cm_atan_join(hi: U64, lo: U64) -> U128
    upper: U128 = hi.to[U128]() << 64
    r: U128 = upper | lo.to[U128]()
    return r

### The full 64 × 64 -> 128-bit product.
### :param a: The first factor.
### :param b: The second factor.
### :returns: `a` × `b`, exact.
routine cm_atan_mul(a: U64, b: U64) -> U128
    r: U128 = a.to[U128]() *% b.to[U128]()
    return r

### The high 128 bits of the 64 × 128-bit product y × x.
### :param y: The one-word factor.
### :param x: The two-word factor.
### :returns: (`y` × `x`) >> 64.
routine cm_atan_mul_high(y: U64, x: U128) -> U128
    xy0: U128 = cm_atan_mul(a: x.to_wrap[U64](), b: y)
    xy1: U128 = cm_atan_mul(a: (x >> 64).to[U64](), b: y)
    r: U128 = xy1 +% (xy0 >> 64)
    return r

### The approximate high 128 bits of a² (the low × low product and the low words of the cross products are
### dropped).
### :param a: The value.
### :returns: Approximately `a`² >> 128.
routine cm_atan_square_high(a: U128) -> U128
    a1: U64 = (a >> 64).to[U64]()
    cross: U128 = cm_atan_mul(a: a1, b: a.to_wrap[U64]()) >> 64
    partial: U128 = cm_atan_mul(a: a1, b: a1) +% cross
    r: U128 = partial +% cross
    return r

### The approximate high 128 bits of the 128 × 128-bit product (the low × low product and the low words of the
### cross products are dropped).
### :param a: The first factor.
### :param b: The second factor.
### :returns: Approximately (`a` × `b`) >> 128.
routine cm_atan_mul_high(a: U128, b: U128) -> U128
    a0: U64 = a.to_wrap[U64]()
    a1: U64 = (a >> 64).to[U64]()
    b0: U64 = b.to_wrap[U64]()
    b1: U64 = (b >> 64).to[U64]()
    a1b0: U128 = cm_atan_mul(a: a1, b: b0) >> 64
    a0b1: U128 = cm_atan_mul(a: a0, b: b1) >> 64
    partial: U128 = cm_atan_mul(a: a1, b: b1) +% a1b0
    r: U128 = partial +% a0b1
    return r

### 2^255 / kd rounded to 128 bits, for a normalized kd (top bit set): a 64-bit quotient refined
### by one Newton step.
### :param kd: The divisor, top bit set.
### :returns: The reciprocal as a 128-bit fixed-point value.
routine cm_atan_reciprocal(kd: U128) -> U128
    kdh: U64 = (kd >> 64).to[U64]()
    kdl: U128 = kd & 0xFFFFFFFFFFFFFFFF
    # r = 2^127 / kdh cut to 64 bits: all ones when the quotient is 2^64
    power: Bool = kdh == 0x8000000000000000
    two127: U128 = 0x80000000000000000000000000000000
    quot: U128 = two127 // kdh.to[U128]()
    r: U64 = when
        power => U64.MAX
        else => quot.to_wrap[U64]()
    rr: U128 = r.to[U128]()
    hl: U128 = kdl *% rr
    kdh_rr: U128 = kdh.to[U128]() *% rr
    hh_raw: S128 = (kdh_rr +% (hl >> 64)).to_wrap[S128]()
    hl_low: U64 = hl.to_wrap[U64]()
    hl_top: S128 = (hl_low >> 7).to[S128]()
    hh: S128 = (hh_raw << 57) | hl_top
    hh_top: S64 = (hh >> 92).to[S64]()
    hh_neg: Bool = hh_top < 0
    corr: U128 = when
        hh_neg => rr << 64
        else => 0
    dr: U128 = cm_atan_mul_high(y: r, x: hh.to_wrap[U128]()) -% corr
    result: U128 = (rr << 64) -% cm_sar(x: dr, n: 56)
    return result

### The class of a sign-stripped binary128: 0 a number, 1 infinity, 2 signaling NaN, 3 quiet NaN.
### :param hi: The high word, sign bit clear.
### :param lo: The low word.
### :returns: The class, 0 to 3.
routine cm_atan_class(hi: U64, lo: U64) -> S64
    rest_bits: U64 = (hi << 32) | lo
    rest: Bool = rest_bits != 0
    t: U64 = (hi >> 32) | rest.to[U64]()
    inf: S64 = (t >= 0x7FFF0000).to[S64]()
    nan: S64 = (t >= 0x7FFF0001).to[S64]()
    quiet: S64 = (t >= 0x7FFF8000).to[S64]()
    r: S64 = inf + nan + quiet
    return r

### knh:knl shifted left until its top bit is set.
### :param knh: The high word.
### :param knl: The low word.
### :returns: The normalized value and the shift it took, or 0 with a shift of 128 when both words are zero.
routine cm_atan_normalize(knh: U64, knl: U64) -> CmAtanNorm
    high_set: Bool = knh != 0
    when
        high_set =>
            nzn: S64 = knh.leading_zeros().to[S64]()
            spill_shift: S64 = 0 - nzn & 63
            spill: U64 = knl >> spill_shift.to[U64]()
            h: U64 = (knh << nzn.to[U64]()) | spill
            kn: U128 = cm_atan_join(hi: h, lo: knl << nzn.to[U64]())
            r: CmAtanNorm = CmAtanNorm(kn: kn, shift: nzn)
            return r
        knl != 0 =>
            nzl: S64 = knl.leading_zeros().to[S64]()
            kn: U128 = cm_atan_join(hi: knl << nzl.to[U64](), lo: 0)
            shift: S64 = nzl + 64
            r: CmAtanNorm = CmAtanNorm(kn: kn, shift: shift)
            return r
        else =>
            r: CmAtanNorm = CmAtanNorm(kn: 0, shift: 128)
            return r

# -- 192-bit fixed point ---------------------------------------------------------

### The sum of two 192-bit fixed-point values, modulo 2^192.
### :param a: The first value.
### :param b: The second value.
### :returns: `a` + `b`, the carry out of the top word dropped.
routine cm_atan_u192_add(a: CmAtanU192, b: CmAtanU192) -> CmAtanU192
    low: U128 = a.low +% b.low
    carry: U64 = (low < a.low).to[U64]()
    top: U64 = a.top +% b.top +% carry
    r: CmAtanU192 = CmAtanU192(top: top, low: low)
    return r

### The difference of two 192-bit fixed-point values, modulo 2^192.
### :param a: The value subtracted from.
### :param b: The value subtracted.
### :returns: `a` - `b`, the borrow out of the top word dropped.
routine cm_atan_u192_sub(a: CmAtanU192, b: CmAtanU192) -> CmAtanU192
    borrow: U64 = (a.low < b.low).to[U64]()
    top: U64 = a.top -% b.top -% borrow
    low: U128 = a.low -% b.low
    r: CmAtanU192 = CmAtanU192(top: top, low: low)
    return r

### The one's complement of a 192-bit value, which is -`a` - 1 modulo 2^192.
### :param a: The value.
### :returns: `a` with every bit flipped.
routine cm_atan_u192_not(a: CmAtanU192) -> CmAtanU192
    top: U64 = ~a.top
    low: U128 = ~a.low
    r: CmAtanU192 = CmAtanU192(top: top, low: low)
    return r

### The top three limbs of row `row` of a 6-limb table (PHI0 or QOFF).
### :param table: The first limb of the table.
### :param row: The row index.
### :returns: Limbs 3..5 of the row as a 192-bit value.
routine cm_atan_row_top(table: @U64, row: U64) -> CmAtanU192
    base: U64 = row * 6
    l3: U64 = table.stride(base + 3).peek()
    l4: U64 = table.stride(base + 4).peek()
    l5: U64 = table.stride(base + 5).peek()
    r: CmAtanU192 = CmAtanU192(top: l5, low: cm_atan_join(hi: l4, lo: l3))
    return r

### The fast series result `f`, placed as a fraction under 192 bits: (f × 2^64) >> dn.
### :param f: The fast series result.
### :param dn: The right shift, not negative.
### :returns: The placed value, zero once `dn` >= 192.
routine cm_atan_place(f: U128, dn: S64) -> CmAtanU192
    if dn < 64
        f_hi: U64 = (f >> 64).to[U64]()
        top: U64 = f_hi >> dn.to[U64]()
        low: U128 = f << (64 - dn).to[U128]()
        r: CmAtanU192 = CmAtanU192(top: top, low: low)
        return r
    else
        shift: S64 = dn - 64
        inside: Bool = shift < 128
        moved: U128 = f >> shift.min(127).to[U128]()
        low: U128 = when
            inside => moved
            else => 0
        r: CmAtanU192 = CmAtanU192(top: 0, low: low)
        return r

# -- fast path -------------------------------------------------------------------

### The 128-bit fixed-point atan(kn / kd × 2^-dn) × 2^dn, before the table angle is
### added: t = kn / kd, then t - t³ Σ c_i t^2i in Horner form, the low terms in 64-bit words.
### :param kn: The numerator of the reduced argument.
### :param kd: The normalized denominator (top bit set).
### :param dn: The scale exponent of the reduced argument.
### :returns: The scaled arc tangent of the reduced argument.
routine cm_atan_fast_core(kn: U128, kd: U128, dn: S64) -> U128
    local f: @U128 <- .hollow()

    rcp: U128 = cm_atan_reciprocal(kd)
    t: U128 = cm_atan_mul_high(a: kn, b: rcp)
    square: U128 = cm_atan_square_high(t)
    dn2: S64 = dn * 2 - 12
    inside: Bool = dn2 < 128
    scaled: U128 = square >> dn2.min(127).to[U128]()
    t2: U128 = when
        inside => scaled
        else => 0
    t2h: U64 = (t2 >> 64).to[U64]()
    c16: U64 = CM_ATAN_C.getitem(16)
    c14: U64 = CM_ATAN_C.getitem(14)
    c12: U64 = CM_ATAN_C.getitem(12)
    c11: U64 = CM_ATAN_C.getitem(11)
    c10: U64 = CM_ATAN_C.getitem(10)
    fl14: U64 = c14 -% mul_high64(a: t2h, b: c16)
    fl12: U64 = c12 -% mul_high64(a: t2h, b: fl14)
    f_lo: U64 = c10 -% t2h -% mul_high64(a: t2h, b: fl12)
    f_start: U128 = cm_atan_join(hi: c11, lo: f_lo)
    f_start.poke_into(f)

    until i < 1 with i: U64 = 4
        lo_at: U64 = i * 2
        hi_at: U64 = lo_at + 1
        c_lo: U64 = CM_ATAN_C.getitem(lo_at)
        c_hi: U64 = CM_ATAN_C.getitem(hi_at)
        next: U128 = cm_atan_join(hi: c_hi, lo: c_lo) -% cm_atan_mul_high(a: t2, b: f.peek())
        next.poke_into(f)
        continue with i: i - 1
    then
        times_t2: U128 = cm_atan_mul_high(a: t2, b: f.peek())
        times_t: U128 = cm_atan_mul_high(a: t, b: times_t2)
        r: U128 = t -% times_t
        return r

### Rounds a table-path angle, a 192-bit fixed point with 2 integer bits, to B128 magnitude bits.
### :param s: The angle.
### :returns: The rounded magnitude bits, `hard` set when the bits under the rounding bit lie within the error bound
###     of a half ulp.
routine cm_atan_round_fixed(s: CmAtanU192) -> CmAtanRounded
    f2: U64 = s.top
    f1: U64 = (s.low >> 64).to[U64]()
    k: U64 = f2.leading_zeros()
    rnd: U64 = (f1 >> 14 - k) & 1
    t: U128 = s.low +% 0x0CA2339C0EBEDFA4
    mask: U64 = (1 << 15 - k) - 1
    t_hi: U64 = (t >> 64).to[U64]()
    th: U64 = (t_hi & mask) ^ (1 << 14 - k)
    hard: Bool = th == 0 and t.to_wrap[U64]() < 0x194467381D7DBF48
    xn: U64 = 0x3FFF - k
    v0: U64 = (f1 >> 15 - k) | (f2 << 49 + k)
    v1: U64 = f2 >> 15 - k
    bits: U128 = cm_atan_join(hi: v1, lo: v0) +% cm_atan_join(hi: xn << 48, lo: rnd)
    r: CmAtanRounded = CmAtanRounded(hard: hard, bits: bits)
    return r

### Rounds a direct (no table angle) fast result f × 2^(-dn-128) to B128 magnitude bits, down to
### the subnormal range (atan2's y/x can underflow, but atan's never does).
### :param f: The fast series result.
### :param dn: The scale exponent.
### :returns: The rounded magnitude bits, `hard` set when the result lies too close to a rounding boundary.
routine cm_atan_round_direct(f: U128, dn: S64) -> CmAtanRounded
    local w0: U64 = f.to_wrap[U64]()
    local w1: U64 = (f >> 64).to[U64]()
    local k: S64 = w1.leading_zeros().to[S64]()
    local xn: S64 = 0x3FFE - dn - k

    if xn > 0
        ku: U64 = k.to[U64]()
        ones: U64 = U64.MAX
        mask: U64 = ones >> 49 + ku
        w0_tail: U64 = w0 +% 6 & mask
        tl: U64 = w0_tail ^ (1 << 14 - ku)
        hard: Bool = tl <= 15
        rnd: U64 = (w0 >> 14 - ku) & 1
        v0: U64 = (w0 >> 15 - ku) | (w1 << 49 + ku)
        v1: U64 = w1 >> 15 - ku
        bits: U128 = cm_atan_join(hi: v1,
            lo: v0) +% cm_atan_join(hi: (xn << 48).to_wrap[U64](), lo: rnd)
        r: CmAtanRounded = CmAtanRounded(hard: hard, bits: bits)
        return r
    else
        ks: S64 = dn - 0x3FEF  # 15 - 0x3FFE + dn
        if ks < 128
            shift: U128 = ks.to[U128]()
            below: U128 = (1 << shift) -% 1
            f_tail: U128 = f +% 6 & below
            tt: U128 = f_tail ^ (1 << shift - 1)
            hard: Bool = tt <= 15
            rnd: U128 = (f >> shift - 1) & 1
            bits: U128 = (f >> shift) +% rnd
            r: CmAtanRounded = CmAtanRounded(hard: hard, bits: bits)
            return r
        else
            at_top: Bool = ks == 128
            rnd: U128 = when
                at_top => f >> 127
                else => 0
            r: CmAtanRounded = CmAtanRounded(hard: false, bits: rnd)
            return r

# -- accurate path: limbs --------------------------------------------------------
#
# Numbers are little-endian 64-bit limbs in 8-limb buffers, and n says how many take part.

### o += v × 2^(64 pos), modulo 2^(64 n): the carry runs up until it is gone or limb n is reached.
### :param o: The limbs added into.
### :param pos: The limb `v` starts at.
### :param v: The two-limb value added.
### :param n: The number of limbs of `o`.
routine cm_atan_limbs_add_at(o: @U64, pos: U64, v: U128, n: U64) -> None
    while q < n and c != 0 with q: U64 = pos, c: U128 = v
        limb: U64 = o.stride(q).peek()
        s: U128 = limb.to[U128]() + (c & 0xFFFFFFFFFFFFFFFF)
        o.stride(q).poke(s.to_wrap[S64]().to_wrap[U64]())
        continue with q: q + 1, c: (c >> 64) + (s >> 64)
    then
        return

### dst = a + b modulo 2^(64 n), and dst may be a or b.
### :param dst: Where the sum goes.
### :param a: The first value.
### :param b: The second value.
### :param n: The number of limbs.
routine cm_atan_limbs_add(dst: @U64, a: @U64, b: @U64, n: U64) -> None
    local carry: @U128 <- 0

    each i in 0 til n
        ai: U64 = a.stride(i).peek()
        bi: U64 = b.stride(i).peek()
        ab: U128 = ai.to[U128]() + bi.to[U128]()
        s: U128 = ab + carry.peek()
        dst.stride(i).poke(s.to_wrap[S64]().to_wrap[U64]())
        (s >> 64).poke_into(carry)
    then
        return

### dst = a - b modulo 2^(64 n), and dst may be a or b.
### :param dst: Where the difference goes.
### :param a: The value subtracted from.
### :param b: The value subtracted.
### :param n: The number of limbs.
routine cm_atan_limbs_sub(dst: @U64, a: @U64, b: @U64, n: U64) -> None
    local borrow: @U128 <- 0

    each i in 0 til n
        ai: U64 = a.stride(i).peek()
        bi: U64 = b.stride(i).peek()
        ab: U128 = ai.to[U128]() -% bi.to[U128]()
        s: U128 = ab -% borrow.peek()
        dst.stride(i).poke(s.to_wrap[S64]().to_wrap[U64]())
        ((s >> 64) & 1).poke_into(borrow)
    then
        return

### a = ~a on the low n limbs.
### :param a: The limbs flipped in place.
### :param n: The number of limbs.
routine cm_atan_limbs_not(a: @U64, n: U64) -> None
    each i in 0 til n
        limb: U64 = a.stride(i).peek()
        (~limb).poke_into(a.stride(i))
    then
        return

### o = a × b exactly (a.count + b.count limbs), where o is neither a nor b. All 8 limbs of `o` are cleared
### first.
### :param o: The 8-limb product buffer.
### :param a: The first factor's limbs.
### :param b: The second factor's limbs, with `a.count` + `b.count` <= 8.
routine cm_atan_limbs_mul(o: @U64, a: @[U64], b: @[U64]) -> None
    local na: U64 = a.count
    local nb: U64 = b.count

    o.zeroinit(8)

    each j in 0 til nb
        each i in 0 til na
            ai: U64 = a.data.stride(i).peek()
            bj: U64 = b.data.stride(j).peek()
            cm_atan_limbs_add_at(o, pos: i + j, v: cm_atan_mul(a: ai, b: bj), n: na + nb)
        then
            continue
    then
        return

### o = the approximate high n limbs of the product of the n-limb a and b: the partial products of
### column n-1 add their high words, the columns above add in full (the mhu2u2u2 .. mhu6u6u6 and
### sqrhu6 helpers of the original). o is neither a nor b. All 8 limbs of `o` are cleared first.
### :param o: The 8-limb result buffer.
### :param a: The first factor.
### :param b: The second factor.
### :param n: The limbs of each factor and of the result.
routine cm_atan_limbs_mul_high(o: @U64, a: @U64, b: @U64, n: U64) -> None
    o.zeroinit(8)

    each j in 0 til n
        each i in 0 til n
            s: U64 = i + j
            if s + 1 >= n
                ai: U64 = a.stride(i).peek()
                bj: U64 = b.stride(j).peek()
                p: U128 = cm_atan_mul(a: ai, b: bj)
                edge: Bool = s + 1 == n
                value: U128 = when
                    edge => p >> 64
                    else => p
                pos: U64 = when
                    edge => 0
                    else => s -% n
                cm_atan_limbs_add_at(o, pos, v: value, n)
        then
            continue
    then
        return

### a <<= k on n limbs, k >= 0. Bits shifted past limb n - 1 are dropped.
### :param a: The limbs shifted in place.
### :param n: The number of limbs.
### :param k: The left shift, not negative.
routine cm_atan_limbs_shl_pos(a: @U64, n: U64, k: S64) -> None
    local dst: S64 = n.to[S64]() - 1
    local s: S64 = k & 63

    src: S64 = dst - (k >> 6).to[S64]()
    clear_from: S64 = when
        src < 0 => dst
        else =>
            first_at: U64 = src.to[U64]()
            first_limb: U64 = a.stride(first_at).peek()
            src_below: S64 = (first_at - 1).to[S64]()
            top_carry: S64 = first_limb.to_wrap[S64]()
            # the limb at `at` takes the carried bits and the top of the limb at `from`, one lower
            while from >= 0 with at: S64 = dst, from: S64 = src_below, carry: S64 = top_carry
                at_index: U64 = at.to[U64]()
                from_index: U64 = from.to[U64]()
                next: U64 = a.stride(from_index).peek()
                under_shift: S64 = ~k & 63
                under_bits: U64 = next >> 1 >> under_shift.to[U64]()
                under: S64 = under_bits.to[S64]()
                limb_bits: S64 = (carry << s) | under
                a.stride(at_index).poke(limb_bits.to_wrap[U64]())
                next_at: S64 = (at_index - 1).to[S64]()
                next_from: S64 = (from_index -% 1).to_wrap[S64]()
                continue with at: next_at, from: next_from, carry: next.to_wrap[S64]()
            then
                last_at: U64 = at.to[U64]()
                a.stride(last_at).poke((carry << s).to_wrap[U64]())
                becomes (last_at -% 1).to_wrap[S64]()

    # the limbs below the shifted ones become zero
    while clear_at >= 0 with clear_at: S64 = clear_from
        clear_one: U64 = clear_at.to[U64]()
        zero: S64 = 0
        a.stride(clear_one).poke(zero.to[U64]())
        continue with clear_at: (clear_one -% 1).to_wrap[S64]()
    then
        return

### a >>= k (logical) on n limbs, k >= 0.
### :param a: The limbs shifted in place.
### :param n: The number of limbs.
### :param k: The right shift, not negative.
routine cm_atan_limbs_shr_pos(a: @U64, n: U64, k: S64) -> None
    local src: U64 = (k >> 6).to[U64]()
    local s: S64 = k & 63

    clear_from: U64 = when
        src >= n => 0
        else =>
            first_limb: U64 = a.stride(src).peek()
            # the limb at dst takes the carried limb's bits and the bottom of the next higher limb
            while from < n with dst: U64 = 0, from: U64 = src + 1, carry: U64 = first_limb
                next: U64 = a.stride(from).peek()
                aligned: Bool = s == 0
                over_shift: S64 = 0 - k & 63
                over: U64 = next << over_shift.to[U64]()
                above: U64 = when
                    aligned => 0
                    else => over
                a.stride(dst).poke((carry >> s.to[U64]()) | above)
                continue with dst: dst + 1, from: from + 1, carry: next
            then
                a.stride(dst).poke(carry >> s.to[U64]())
                becomes dst + 1

    # the limbs above the shifted ones become zero
    while clear_at < n with clear_at: U64 = clear_from
        zero: S64 = 0
        a.stride(clear_at).poke(zero.to[U64]())
        continue with clear_at: clear_at + 1
    then
        return

### a >>= k (logical), or a <<= -k when k < 0.
### :param a: The limbs shifted in place.
### :param n: The number of limbs.
### :param k: The right shift, negative for a left shift.
routine cm_atan_limbs_shr(a: @U64, n: U64, k: S64) -> None
    if k < 0
        cm_atan_limbs_shl_pos(a, n, k: 0 - k)
        return
    else
        cm_atan_limbs_shr_pos(a, n, k)
        return

### a >>= k (arithmetic) on n limbs, k >= 0: the top limb's sign bit fills the vacated bits.
### :param a: The limbs shifted in place.
### :param n: The number of limbs.
### :param k: The right shift, not negative.
routine cm_atan_limbs_sar(a: @U64, n: U64, k: S64) -> None
    local s: S64 = k & 63

    src: U64 = (k >> 6).to[U64]()
    fill_start: (U64, S64) = when
        src >= n =>
            top_at: U64 = n -% 1
            top: U64 = a.stride(top_at).peek()
            becomes (0, top.to_wrap[S64]() >> 63)
        else =>
            first_limb: U64 = a.stride(src).peek()
            # the limb at dst takes the carried limb's bits and the bottom of the next higher limb
            while from < n with dst: U64 = 0, from: U64 = src + 1, carry: U64 = first_limb
                next: U64 = a.stride(from).peek()
                above_shift: S64 = ~k & 63
                above: U64 = next << 1 << above_shift.to[U64]()
                a.stride(dst).poke((carry >> s.to[U64]()) | above)
                continue with dst: dst + 1, from: from + 1, carry: next
            then
                carry_signed: S64 = carry.to_wrap[S64]()
                a.stride(dst).poke((carry_signed >> s).to_wrap[U64]())
                becomes (dst + 1, carry_signed >> 63)
    fill_from, sign = fill_start

    # the top limb's sign fills the limbs above the shifted ones
    while fill_at < n with fill_at: U64 = fill_from
        a.stride(fill_at).poke(sign.to_wrap[U64]())
        continue with fill_at: fill_at +% 1
    then
        return

# -- accurate path: kernel -------------------------------------------------------

### r = 2^447 / (kd2:kd1:kd0) to 6 limbs: the 128-bit fast reciprocal refined by one Newton step
### with a second-order term, r × (1 - h + h²) for the error h = 1 - r × kd.
### :param kd0: The low limb of the denominator.
### :param kd1: The middle limb of the denominator.
### :param kd2: The top limb of the denominator, top bit set.
### :param r: The 8-limb buffer the reciprocal goes into (limbs 0..5).
routine cm_atan_accurate_reciprocal(kd0: S64, kd1: U64, kd2: U64, r: @U64) -> None
    local rcp_buf: @Array[S64, 8] <- .hollow()
    local kd_buf: @Array[S64, 8] <- .hollow()
    local h_buf: @Array[S64, 8] <- .hollow()
    local sh_buf: @Array[S64, 8] <- .hollow()
    local h2_buf: @Array[S64, 8] <- .hollow()
    local fix_buf: @Array[S64, 8] <- .hollow()
    local dr_buf: @Array[S64, 8] <- .hollow()

    rcp: @U64 = rcp_buf.to[@U64]()
    kd: @U64 = kd_buf.to[@U64]()
    h: @U64 = h_buf.to[@U64]()
    sh: @U64 = sh_buf.to[@U64]()
    h2: @U64 = h2_buf.to[@U64]()
    fix: @U64 = fix_buf.to[@U64]()
    dr: @U64 = dr_buf.to[@U64]()
    first: U128 = cm_atan_reciprocal(cm_atan_join(hi: kd2, lo: kd1))
    r_lo: S64 = first.to_wrap[S64]()
    r_hi: S64 = (first >> 64).to_wrap[S64]()
    r.zeroinit(8)
    r.stride(4).poke(r_lo.to_wrap[U64]())
    r.stride(5).poke(r_hi.to_wrap[U64]())
    rcp.stride(0).poke(r_lo.to_wrap[U64]())
    rcp.stride(1).poke(r_hi.to_wrap[U64]())
    kd.stride(0).poke(kd0.to_wrap[U64]())
    kd.stride(1).poke(kd1)
    kd.stride(2).poke(kd2)
    # h = r × kd (5 limbs), and sh = h >> 58, a signed 3-limb error term
    cm_atan_limbs_mul(o: h, a: @[U64].construct(data: rcp, count: 2),
        b: @[U64].construct(data: kd, count: 3))
    h0: U64 = h.stride(0).peek()
    h1: U64 = h.stride(1).peek()
    h2_val: U64 = h.stride(2).peek()
    h3: U64 = h.stride(3).peek()
    sh0: U64 = (h0 >> 58) | (h1 << 6)
    sh1: U64 = (h1 >> 58) | (h2_val << 6)
    sh2: U64 = (h2_val >> 58) | (h3 << 6)
    sh.stride(0).poke(sh0)
    sh.stride(1).poke(sh1)
    sh.stride(2).poke(sh2)
    # h2 = sh² as a signed square: the unsigned square, less 2 sh × 2^192 when sh < 0
    cm_atan_limbs_mul(o: h2, a: @[U64].construct(data: sh, count: 3),
        b: @[U64].construct(data: sh, count: 3))
    sh_neg: Bool = sh2 >> 63 == 1
    fix.zeroinit(8)
    tw3: S64 = (sh0 << 1).to_wrap[S64]()
    tw4_bits: U64 = (sh1 << 1) | (sh0 >> 63)
    tw4: S64 = tw4_bits.to_wrap[S64]()
    tw5_bits: U64 = (sh2 << 1) | (sh1 >> 63)
    tw5: S64 = tw5_bits.to_wrap[S64]()
    fix3: S64 = when
        sh_neg => tw3
        else => 0
    fix4: S64 = when
        sh_neg => tw4
        else => 0
    fix5: S64 = when
        sh_neg => tw5
        else => 0
    fix.stride(3).poke(fix3.to_wrap[U64]())
    fix.stride(4).poke(fix4.to_wrap[U64]())
    fix.stride(5).poke(fix5.to_wrap[U64]())
    cm_atan_limbs_sub(dst: h2, a: h2, b: fix, n: 6)
    # h = (h << 75) - h2 >> 128
    cm_atan_limbs_shl_pos(a: h, n: 5, k: 75)
    sq2: U64 = h2.stride(2).peek()
    sq3: U64 = h2.stride(3).peek()
    sq4: U64 = h2.stride(4).peek()
    fix.zeroinit(8)
    fix.stride(0).poke(sq2)
    fix.stride(1).poke(sq3)
    fix.stride(2).poke(sq4)
    cm_atan_limbs_sub(dst: h, a: h, b: fix, n: 5)
    # dr = h × r as a signed product (h is signed), then >> 10
    cm_atan_limbs_mul(o: dr, a: @[U64].construct(data: h, count: 5),
        b: @[U64].construct(data: rcp, count: 2))
    top_h: U64 = h.stride(4).peek()
    h_neg: Bool = top_h >> 63 == 1
    fix.zeroinit(8)
    fix_lo: S64 = when
        h_neg => r_lo
        else => 0
    fix_hi: S64 = when
        h_neg => r_hi
        else => 0
    fix.stride(5).poke(fix_lo.to_wrap[U64]())
    fix.stride(6).poke(fix_hi.to_wrap[U64]())
    cm_atan_limbs_sub(dst: dr, a: dr, b: fix, n: 7)
    cm_atan_limbs_sar(a: dr, n: 7, k: 10)
    # r -= dr >> 128, sign-extended to 6 limbs
    d2: U64 = dr.stride(2).peek()
    d3: U64 = dr.stride(3).peek()
    d4: U64 = dr.stride(4).peek()
    d5: U64 = dr.stride(5).peek()
    d6: U64 = dr.stride(6).peek()
    fix.stride(0).poke(d2)
    fix.stride(1).poke(d3)
    fix.stride(2).poke(d4)
    fix.stride(3).poke(d5)
    d7: S64 = d6.to_wrap[S64]() >> 63
    fix.stride(4).poke(d6)
    fix.stride(5).poke(d7.to_wrap[U64]())
    cm_atan_limbs_sub(dst: r, a: r, b: fix, n: 6)
    return

### f = the 6-limb fixed-point atan(t × 2^-dn) × 2^dn for the 6-limb t: the odd series in 25
### terms, t - t³ Σ c_k t^2k, the working precision widening from 2 to 6 limbs as the terms grow.
### :param t: The 6-limb reduced argument.
### :param dn: The scale exponent of `t`.
### :param f: The 8-limb buffer the result goes into.
routine cm_atan_accurate_series(t: @U64, dn: S64, f: @U64) -> None
    local t2_buf: @Array[S64, 8] <- .hollow()
    local tmp_buf: @Array[S64, 8] <- .hollow()
    local t2: @U64 = t2_buf.to[@U64]()
    local tmp: @U64 = tmp_buf.to[@U64]()
    local ck: @U64 <- 0

    cm_atan_limbs_mul_high(o: t2, a: t, b: t, n: 6)
    cm_atan_limbs_shr(a: t2, n: 6, k: dn * 2 - 14)
    c0: U64 = CM_ATAN_CP.getitem(0)
    c1: U64 = CM_ATAN_CP.getitem(1)
    f.zeroinit(8)
    f.stride(0).poke(c0)
    f.stride(1).poke(c1)

    # left terms remain at the n-limb precision. The coefficient of the last one began at ck
    while true with n: U64 = 2, left: S64 = 5
        if left == 0
            # f = CP[ck..] - f × t2 (the top n limbs of t2)
            # one more limb on top: CP holds it right after the last coefficient used
            if n == 6
                break
            else
                top_at: U64 = ck.peek() + n
                top: U64 = CM_ATAN_CP.getitem(top_at)
                f.stride(n).poke(top)
                wider: U64 = n + 1
                last: Bool = wider == 6
                terms: S64 = when
                    last => 4
                    else => 5
                continue with n: wider, left: terms
        else
            next_ck: U64 = ck.peek() + n
            t2_top: @U64 = t2.stride(6 - n)
            coef: @U64 = CM_ATAN_CP.to[@U64]().stride(next_ck)
            cm_atan_limbs_mul_high(o: tmp, a: f, b: t2_top, n)
            cm_atan_limbs_sub(dst: f, a: coef, b: tmp, n)
            next_ck.poke_into(ck)
            continue with n: n, left: left - 1

    # f = t - t × (f × t2)
    cm_atan_limbs_mul_high(o: tmp, a: f, b: t2, n: 6)
    cm_atan_limbs_mul_high(o: t2, a: t, b: tmp, n: 6)
    cm_atan_limbs_sub(dst: f, a: t, b: t2, n: 6)
    return

### f = the 6-limb fixed-point atan(kn / kd × 2^-dn) × 2^dn, before the table angle is added.
### :param red: The reduction.
### :param f: The 8-limb buffer the result goes into.
routine cm_atan_accurate_core(red: CmAtanReduction, f: @U64) -> None
    local r_buf: @Array[S64, 8] <- .hollow()
    local kn_buf: @Array[S64, 8] <- .hollow()
    local t_buf: @Array[S64, 8] <- .hollow()

    r: @U64 = r_buf.to[@U64]()
    kn: @U64 = kn_buf.to[@U64]()
    t: @U64 = t_buf.to[@U64]()
    cm_atan_accurate_reciprocal(kd0: red.kd0, kd1: red.kd1, kd2: red.kd2, r)
    kn_val: U128 = red.kn
    kn_lo: S64 = kn_val.to_wrap[S64]()
    kn_hi: S64 = (kn_val >> 64).to_wrap[S64]()
    kn.stride(0).poke(kn_lo.to_wrap[U64]())
    kn.stride(1).poke(kn_hi.to_wrap[U64]())
    # t = r × kn >> 128: the reduced argument to 6 limbs (limbs 2..7 of the product)
    cm_atan_limbs_mul(o: t, a: @[U64].construct(data: r, count: 6),
        b: @[U64].construct(data: kn, count: 2))
    t_top: @U64 = t.offset(16)
    cm_atan_accurate_series(t: t_top, dn: red.dn, f)
    return

### Rounds the 6-limb angle f × 2^(-dn - 384) to B128 magnitude bits, down to the subnormal range.
### No tie can occur, so the bit under the last kept one decides.
### :param f: The 6-limb angle.
### :param dn: The scale exponent (-1 once a table angle has been added).
### :returns: The rounded magnitude bits.
routine cm_atan_round_limbs(f: @U64, dn: S64) -> U128
    local f5: U64 = f.stride(5).peek()
    local f4: U64 = f.stride(4).peek()
    local k: S64 = f5.leading_zeros().to[S64]()
    local v: U128 = cm_atan_join(hi: f5, lo: f4) << k.to[U128]()
    local xn: S64 = 0x3FFE - dn - k

    if xn > 0
        rnd: U128 = (v >> 14) & 1
        unrounded: U128 = (v >> 15) +% cm_atan_join(hi: (xn << 48).to_wrap[U64](), lo: 0)
        bits: U128 = unrounded +% rnd
        return bits
    else
        ks: S64 = 15 - xn
        if ks < 128
            ks2: S128 = ks.to[S128]()
            rnd: U128 = (v >> (ks2 - 1).to[U128]()) & 1
            bits: U128 = (v >> ks2.to[U128]()) +% rnd
            return bits
        else
            at_top: Bool = ks == 128
            rnd: U128 = when
                at_top => v >> 127
                else => 0
            return rnd

# -- tables ----------------------------------------------------------------------

### TN[i]: a 15-bit approximation of tan(i π/4 / 64)
preset CM_ATAN_TN: @Array[U64, 65] <- [0, 402, 804, 1207, 1610, 2013, 2417, 2822, 3227, 3634, 4042,
    4450, 4861, 5272, 5686, 6101, 6518, 6937, 7358, 7782, 8208, 8637, 9068, 9503, 9940, 10381,
    10825, 11273, 11725, 12180, 12640, 13104, 13573, 14046, 14525, 15009, 15498, 15993, 16494,
    17001, 17515, 18035, 18563, 19098, 19640, 20191, 20750, 21318, 21895, 22481, 23078, 23685,
    24302, 24931, 25572, 26226, 26892, 27572, 28266, 28975, 29699, 30440, 31198, 31973, 32768]

