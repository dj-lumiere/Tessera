// Tessera stdlib: correctly rounded B128 cosine
//
// Ported from CORE-MATH, src/binary128/cos/cosq.c via RazorForge's B128Cos.rf.
// Copyright (c) 2026 Chen-Pang He <jdh863@gmail.com>
// MIT license: see LICENSE-CORE-MATH
//
// The result is the exact cosine of the argument (in radians) rounded to the nearest B128, ties to even.
// cos(-x) = cos(x), ±infinity gives the default quiet NaN, and a NaN comes back quieted with its sign and
// payload. The pipeline shared with the sine lives in TrigShared.tess.

module Standard/Core

/// The cosine, correctly rounded (to nearest, ties to even): a CORE-MATH port sharing its pipeline with the sine (TrigShared.tess).
/// :returns: cos of `me` in radians, in [-1, 1]. cos(-x) = cos(x), ±inf gives the default quiet NaN, and a NaN comes back quieted with its sign and payload.
/// :see: {B128.sin}
routine B128.cos(me: Me) -> Me
    if me.is_finite()
        bits: U128 = cm_trig(bits: me.bits(), cosine: true)
        r: Me = b128_of(bits)
        return r
    else
        r: Me = b128_trig_nonfinite(me)
        return r
