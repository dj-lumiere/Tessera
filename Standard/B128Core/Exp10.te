# Tessera stdlib: the correctly rounded base-10 exponential 10^x of B128
#
# x × log2(10) in 3-word fixed point, then the shared 2^x engine (ExpShared.te).
# x = 1, 2, ..., 48 give the exact power of ten. Round to nearest only: overflow
# gives +inf, underflow a correctly rounded subnormal or +0, NaN comes back quiet
# with its sign and payload.
#
# Ported from CORE-MATH, src/binary128/exp10/exp10q.c via RazorForge's B128Exp10.rf.
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### x >= 0x1.34413509f79fef311f12b35816fap+12 overflows
secret preset CM_EXP10_OVERFLOW:  U128 = 0x400B34413509F79FEF311F12B35816FA
### x <= -0x1.3657d621f4e96893f84497c723c1p+12 rounds to +0
secret preset CM_EXP10_UNDERFLOW: U128 = 0xC00B3657D621F4E96893F84497C723C1

### The base-10 exponential 10^`me`, correctly rounded to nearest (a CORE-MATH port), exact for the integers 1 to 48.
### :returns: 10^`me`: +inf past the overflow threshold (about 4932.08), a correctly rounded subnormal or +0 at the
###     bottom of the range. A NaN comes back quieted with its sign and payload.
routine B128.exp10() -> Me
    local u: U128 = me.bits()

    nan: Bool = me.is_nan()
    quiet: Me = b128_of(b128_quiet(me.bits()))
    if nan
        return quiet
    hi: U64 = cm_exp_hi(u)
    mag_hi: U64 = hi & 0x7FFFFFFFFFFFFFFF
    tiny: Bool = mag_hi < 0x3F8BBCB7B1526E50  # 10^x rounds to 1
    su: S128 = when
        tiny => return CM_EXP_ONE
        mag_hi >= 0x400B34413509F79F =>
            # NaN, infinities, and the overflow and underflow thresholds
            is_nan: Bool = b128_is_nan_bits(u)
            nonnegative: Bool = not b128_is_negative_bits(u)
            overflow: Bool = nonnegative and u >= CM_EXP10_OVERFLOW
            underflow: Bool = u >= CM_EXP10_UNDERFLOW
            quiet2: Me = b128_of(u | B128_QUIET_BIT)
            when
                is_nan => return quiet2
                overflow => return Me.INFINITY
                underflow => return CM_EXP_ZERO
                else =>
                    becomes u.to_wrap[S128]()
        else => u.to_wrap[S128]()

    # positive x >= 1 with no fraction bits in the low word
    e: S64 = b128_exponent(su.to_wrap[U128]())
    positive: Bool = su >= 0
    x_bits: U128 = when
        positive and e >= 16383 and su.to_wrap[S64]() == 0 =>
            # the high word has 16 sign and exponent bits, then e - 16383 integer bits
            hi2: U64 = cm_exp_hi(su.to_wrap[U128]())
            fraction: U64 = hi2 << (e - 16367).to[U64]()
            sig_hi: U64 = (hi2 & 0xFFFFFFFFFFFF) | 0x1000000000000
            n: U64 = sig_hi >> (16431 - e).to[U64]()
            if fraction == 0 and n <= 48
                r: Me = cm_exp10_exact(n)
                return r
            becomes su.to_wrap[U128]()
        else => su.to_wrap[U128]()

    # x × log2(10): the significand times log2(10), one's-complemented for negative x
    hi2: S64 = cm_exp_hi(x_bits).to_wrap[S64]()
    sign_mask: S64 = hi2 >> 63
    sig: U128 = (x_bits & B128_FRAC_MASK) | B128_IMPLICIT
    k4: U64 = CM_EXP_ILN102.getitem(4)
    k5: U64 = CM_EXP_ILN102.getitem(5)
    k6: U64 = CM_EXP_ILN102.getitem(6)
    scaled: CmExpWords3 = cm_exp_mul3x2_high(a0: k4, a1: k5, a2: k6, b: sig)
    shift: S64 = 0x4019 - b128_exponent(x_bits)
    reduced: CmExpWords3 = cm_exp_ashr3(w: cm_exp_flip3(w: scaled, mask: sign_mask.to_wrap[U64]()),
        n: shift.to[U64]())
    r: Me = cm_exp_finish(fs: reduced, x: x_bits, kind: CM_EXP_KIND_TEN)
    return r

### 10^n for an integer n in 1..48, exact: 5^n fits 112 bits, so it is normalized to
### the significand and scaled by 2^n.
### :param n: The power, 1 to 48.
### :returns: 10^`n` as a B128, exact.
secret routine cm_exp10_exact(n: U64) -> B128
    local p: @U128 <- 1

    each i in 0 til n
        (p.peek() *% 5).poke_into(p)
    then
        ten_exponent: S64 = n.to[S64]()
        lz: S64 = p.peek().leading_zeros().to[S64]()
        sig: U128 = p.peek() << (lz - 15).to[U128]()
        exponent: S64 = 16509 - lz + ten_exponent
        bits: U128 = sig +% (exponent.to[U128]() << 112)
        r: B128 = b128_of(bits)
        return r
