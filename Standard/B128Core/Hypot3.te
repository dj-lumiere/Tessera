# Tessera stdlib: the correctly rounded three-leg Euclidean norm sqrt(x^2 + y^2 + z^2)
#
# B128's hypot of three legs, and the exact path every three-leg hypot ends in when its fast path can't decide. The
# legs are unpacked into 113-bit significands (a narrower format's values fit exactly), their squares are added in
# 256-bit fixed point relative to the largest leg, and the floor of the square root comes from B128's sqrt, one Newton
# step (cm_frac_isqrt) and an exact check of the candidate's square. A square that reaches below the fixed point
# keeps only whether it was cut, and a root that isn't exact counts the same way: that is all rounding needs to know.
# Round to nearest, ties to even.

module Standard/Core

### The `lead` of a zero leg: so far below every format's smallest exponent that its square shifts out entirely, and
### small enough that twice the gap to it can't overflow.
secret preset HYPOT3_ZERO_LEAD: S64 = -1000000

### One leg of a three-leg hypot, exactly: `m` times 2^(`lead` - 112), or a zero leg.
secret record Hypot3Leg
    ### The significand with its leading bit at bit 112, or 0 for a zero leg.
    m: U128
    ### The exponent of the leading bit, or `HYPOT3_ZERO_LEAD` for a zero leg.
    lead: S64

### The three legs of a hypot.
secret record Hypot3Legs
    ### The first leg.
    a: Hypot3Leg
    ### The second leg.
    b: Hypot3Leg
    ### The third leg.
    c: Hypot3Leg

### A binary float format, as the three-leg hypot needs it.
secret record Hypot3Format
    ### The precision in bits, the implicit bit included (113 at most).
    precision: S64
    ### The exponent of the smallest normal value.
    emin: S64

### sqrt(`x`^2 + `y`^2 + `z`^2) without intermediate overflow or underflow, correctly rounded to nearest (ties to
### even). The signs don't matter and the order of the legs doesn't either. A signaling NaN leg gives a NaN, and
### otherwise an infinite leg gives +inf, even when another leg is a quiet NaN. A NaN result is the first NaN leg in
### the order `x`, `y`, `z`, quieted, its sign and payload kept. A result past the largest finite value gives +inf.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The length of the vector (`x`, `y`, `z`).
routine hypot_unchecked(x: B128, y: B128, z: B128) -> B128
    signaling: Bool = b128_is_signaling(x) or b128_is_signaling(y) or b128_is_signaling(z)
    infinite: Bool = x.is_infinite() or y.is_infinite() or z.is_infinite()
    is_nan: Bool = x.is_nan() or y.is_nan() or z.is_nan()
    when
        signaling => return b128_nan_of(a: x, b: b128_nan_of(a: y, b: z))
        infinite => return inf
        is_nan => return b128_nan_of(a: x, b: b128_nan_of(a: y, b: z))
        else =>
            mask: U128 = B128_SIGN.bitnot()
            bits: U128 = hypot3_exact_bits(x: x.bits() & mask, y: y.bits() & mask,
                z: z.bits() & mask, format: Hypot3Format(precision: 113, emin: -16382))
            return b128_of(bits)

### The correctly rounded sqrt(x^2 + y^2 + z^2) of three finite non-negative floats of one binary format, encoded in
### that format: a normal value, a subnormal one, zero, or +inf when it overflows.
### :param x: The first leg's encoding, the sign bit clear, widened to U128.
### :param y: The second leg's encoding, the same way.
### :param z: The third leg's encoding, the same way.
### :param format: The format.
### :returns: The encoding of the result, widened to U128.
secret routine hypot3_exact_bits(x: U128, y: U128, z: U128, format: Hypot3Format) -> U128
    a: Hypot3Leg = hypot3_leg(bits: x, format)
    b: Hypot3Leg = hypot3_leg(bits: y, format)
    c: Hypot3Leg = hypot3_leg(bits: z, format)
    return hypot3_exact(legs: Hypot3Legs(a, b, c), format)

### Unpacks a finite non-negative float of a binary format into a leg. A subnormal one is normalized, so its
### leading bit sits at bit 112 too and its exponent goes below the format's smallest.
### :param bits: The encoding, the sign bit clear, widened to U128.
### :param format: The format.
### :returns: The leg, exactly the value.
secret routine hypot3_leg(bits: U128, format: Hypot3Format) -> Hypot3Leg
    local p: S64 = format.precision
    local emin: S64 = format.emin

    stored: U128 = (p - 1).to[U128]()
    implicit: U128 = U128.shift_left(1, stored)
    field: U128 = bits >> stored
    frac: U128 = bits & implicit - 1
    if field != 0
        m: U128 = (frac | implicit) << (113 - p).to[U128]()
        return Hypot3Leg(m: m, lead: field.to[S64]() + emin - 1)
    if frac == 0
        return Hypot3Leg(m: 0, lead: HYPOT3_ZERO_LEAD)
    top: S64 = 127 - frac.leading_zeros().to[S64]()
    m: U128 = frac << (112 - top).to[U128]()
    return Hypot3Leg(m: m, lead: emin - (p - 1) + top)

### The correctly rounded sqrt(a^2 + b^2 + c^2) of three legs, encoded in a binary format.
### :param legs: The legs.
### :param format: The format.
### :returns: The encoding of the result, widened to U128.
secret routine hypot3_exact(legs: Hypot3Legs, format: Hypot3Format) -> U128
    top: S64 = legs.a.lead.max(legs.b.lead).max(legs.c.lead)
    if top == HYPOT3_ZERO_LEAD
        return 0
    # The sum lies in [2^250, 3 * 2^252) at scale 26. Four times as much (scale 28) when that is below 2^252 puts it
    # in [2^252, 2^254), the range of cm_frac_isqrt.
    first: (U256, Bool) = hypot3_sum(legs, top, scale: 26)
    sum26, cut26 = first
    narrow: Bool = sum26 < U256.shift_left(1, 252)
    scale: S64 = when
        narrow => 28
        else => 26
    picked: (U256, Bool) = when
        narrow => hypot3_sum(legs, top, scale: 28)
        else => (sum26, cut26)
    sum, cut = picked
    root: U128 = hypot3_floor_root(m: sum, guess: cm_frac_isqrt(sum))
    exact: Bool = root.mul_wide(root) == sum and not cut
    # The root times 2^lsb is the result: its leading bit (bit 126) has the exponent top + 14 - scale / 2.
    lsb: S64 = top - 112 - scale.floordiv(2)
    return hypot3_round(root, inexact: not exact, lsb, format)

### The integer part of (a^2 + b^2 + c^2) / 2^(2 top - 224 - scale), with whether a fraction was cut off: the squares
### of the significands in fixed point, each shifted by twice its exponent's distance below `top`.
### :param legs: The legs.
### :param top: The largest exponent among the legs.
### :param scale: The fixed-point shift of the largest square, 26 or 28.
### :returns: The integer part of the sum, and true when a fraction was cut off.
secret routine hypot3_sum(legs: Hypot3Legs, top: S64, scale: S64) -> (U256, Bool)
    sq_a: (U256, Bool) = hypot3_square(leg: legs.a, top, scale)
    sq_b: (U256, Bool) = hypot3_square(leg: legs.b, top, scale)
    sq_c: (U256, Bool) = hypot3_square(leg: legs.c, top, scale)
    va, ca = sq_a
    vb, cb = sq_b
    vc, cc = sq_c
    # Each square is below 2^254 and the largest-leg one above 2^250, so the sum fits in 256 bits.
    sum: U256 = va + vb + vc
    return (sum, ca or cb or cc)

### One leg's square in the fixed point of hypot3_sum, as its integer part and whether a fraction was cut off. A leg
### far below `top` only keeps that bit.
### :param leg: The leg.
### :param top: The largest exponent among the legs.
### :param scale: The fixed-point shift of the largest square.
### :returns: The integer part of the scaled square, and true when a fraction was cut off.
secret routine hypot3_square(leg: Hypot3Leg, top: S64, scale: S64) -> (U256, Bool)
    sq: U256 = leg.m.mul_wide(leg.m)
    shift: S64 = scale - (top - leg.lead) * 2
    if shift >= 0
        return (sq << shift.to[U256](), false)
    k: U256 = (-shift).to[U256]()
    cut: Bool = sq & U256.shift_left(1, k) -% 1 != 0
    return (sq >> k, cut)

### The floor of sqrt(`m`), from a guess within a couple of units: stepped down while its square is above `m`, then up
### while the next square still fits.
### :param m: The radicand, below 2^254.
### :param guess: The guess, below 2^127.
### :returns: The largest r with r^2 <= `m`.
secret routine hypot3_floor_root(m: U256, guess: U128) -> U128
    while r.mul_wide(r) > m with r: U128 = guess
        continue with r: r - 1
    then
        while next.mul_wide(next) <= m with low: U128 = r, next: U128 = r + 1
            continue with low: next, next: next + 1
        then
            return low

### Rounds root times 2^lsb to nearest (ties to even) in a binary format and encodes it. The root's leading bit is
### bit 126, and `inexact` says the true value lies strictly above it (below the next integer).
### :param root: The floor of the exact root, in [2^126, 2^127).
### :param inexact: True when the exact root is above `root`.
### :param lsb: The exponent of the root's lowest bit.
### :param format: The format.
### :returns: The encoding: a normal or subnormal value, or +inf on overflow.
secret routine hypot3_round(root: U128, inexact: Bool, lsb: S64, format: Hypot3Format) -> U128
    local emin: S64 = format.emin
    local stored: S64 = format.precision - 1

    inf_bits: U128 = (3 - emin * 2).to[U128]() << stored.to[U128]()
    lead: S64 = lsb + 126
    if lead > 1 - emin
        return inf_bits
    # The lowest bit kept: p bits from the leading one, or the subnormal grid's.
    kept_lsb: S64 = lead.max(emin) - stored
    shift: U128 = (kept_lsb - lsb).to[U128]()
    kept: U128 = root >> shift
    rest: U128 = root & U128.shift_left(1, shift) - 1
    half: U128 = U128.shift_left(1, shift - 1)
    tie: Bool = rest == half
    odd: Bool = kept & 1 == 1
    up: Bool = rest > half or (tie and (inexact or odd))
    # A normal value is kept plus its exponent above the subnormal grid, which moves the implicit bit into the field.
    # A carry out of the significand bumps the exponent the same way, up to +inf.
    exponent_bits: U128 = (kept_lsb - emin + stored).to[U128]() << stored.to[U128]()
    bits: U128 = kept + up.to[U128]() + exponent_bits
    return bits.min(inf_bits)
