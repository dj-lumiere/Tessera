# Tessera stdlib: correctly rounded B128 sine, and the sine and cosine together
#
# Ported from CORE-MATH, src/binary128/sin/sinq.c via RazorForge's B128Sin.rf.
# Copyright (c) 2026 Chen-Pang He <jdh863@gmail.com>
# MIT license: see LICENSE-CORE-MATH
#
# The result is the exact sine of the argument (in radians) rounded to the nearest B128, ties to even.
# sin(-x) = -sin(x), ±0 maps to itself, ±infinity gives the default quiet NaN, and a NaN comes back quieted
# with its sign and payload. The pipeline shared with the cosine lives in TrigShared.te.

module Standard/Core

### sin(x) and cos(x), each correctly rounded.
record B128SinCos
    sin: B128
    cos: B128

### The sine of `me` (in radians), correctly rounded to nearest with ties to even (a CORE-MATH port).
### ±infinity gives the default quiet NaN, and a NaN comes back quieted.
### :returns: sin(`me`).
### :see: {B128.sin_cos}
routine B128.sin() -> Me
    if me.is_finite()
        bits: U128 = cm_trig(bits: me.bits(), cosine: false)
        r: Me = b128_of(bits)
        return r
    r: Me = b128_trig_nonfinite(me)
    return r

### The sine and cosine of `me` (in radians) together, each correctly rounded, sharing one argument reduction.
### :returns: Both results, as {B128.sin} and {B128.cos} would give them.
routine B128.sin_cos() -> B128SinCos
    if me.is_finite()
        r: B128SinCos = cm_trig_both(me.bits())
        return r
    r: B128SinCos = B128SinCos(sin: me.sin(), cos: me.cos())
    return r
