// Tessera stdlib: panic
//
// panic ends the program when a contract is broken: an index out of bounds,
// unwrap of Absent, a failed allocation. It hands the code (and panic_msg's
// message) to tessera_panic_handler, a routine the program links against and
// that never returns. Standard::Os exports the default on hosted targets: one
// line on stderr, then exit status 101 (Os/Panic.tess). A program replaces it
// by exporting its own routine under that name, which is how a target without
// an operating system gets one.
//
// panic and the stdlib routines that panic on a caller's mistake (an index out
// of bounds, an overflowing add) are #track_caller: the handler gets the place
// of the call in the caller's code, not a line inside the stdlib.
//
// There is no unwinding and no recovery. Failures a caller is expected to
// handle return Result or Option instead. trap() stays in the prelude as the
// runtime-free way to stop: it needs no handler and prints nothing.

module Standard::Core

/// Why the program stopped. Codes 0-63 belong to the stdlib; 64 and up are free
/// for programs (bitcast<U8, TrapCode>(64)).
choice TrapCode: U8
    Unreachable  // a stdlib invariant broke: a bug in the stdlib
    Bounds  // an index or range outside the valid one
    Empty  // pop / peek on an empty collection
    MissingKey  // get of a key that isn't there
    UnwrapAbsent  // unwrap of Absent
    UnwrapFailure  // unwrap of a Failure
    UnwrapSuccess  // unwrap_failure of a Success
    AllocFailed  // the allocator returned null
    InvalidArgument  // outside the routine's domain: clamp with min > max, ilog of 0
    AssertFailed
    Overflow
    DivByZero
    ThreadFailed  // the operating system didn't start a thread

/// A place in the source: the file as the build named it, the line, and the column (0 when a #source gave none).
record SourceLocation
    file   : Bytes
    line   : U32
    column : U32

/// Stops the program at once, with no message: LLVM's trap instruction.
#[external("llvm"), template("call void @llvm.trap()"), noreturn]
routine trap() -> Void

/// The program's panic handler. Export a routine with this signature as "tessera_panic_handler" to replace the
/// default; message is empty for panic, and place is the call that panicked.
#[external("c"), symbol("tessera_panic_handler"), noreturn]
private routine panic_handler(code: TrapCode, message: Bytes, place: @SourceLocation) -> Void

/// The fixed English message for a trap code, such as `index out of bounds` for `Bounds`. Codes outside the stdlib ones give `error code`.
/// :returns: A static message for the code.
routine TrapCode.description(self: Self) -> Bytes
    block entry()
        when self
            Self.Unreachable     -> describe("internal error: entered unreachable code")
            Self.Bounds          -> describe("index out of bounds")
            Self.Empty           -> describe("the collection is empty")
            Self.MissingKey      -> describe("key not found")
            Self.UnwrapAbsent    -> describe("unwrap of Absent")
            Self.UnwrapFailure   -> describe("unwrap of a Failure")
            Self.UnwrapSuccess   -> describe("unwrap_failure of a Success")
            Self.AllocFailed     -> describe("memory allocation failed")
            Self.InvalidArgument -> describe("invalid argument")
            Self.AssertFailed    -> describe("assertion failed")
            Self.Overflow        -> describe("arithmetic overflow")
            Self.DivByZero       -> describe("division by zero")
            Self.ThreadFailed    -> describe("the operating system didn't start a thread")
            else                 -> describe("error code")

    block describe(text: Bytes)
        return(text)

/// Ends the program with `code` and an empty message by calling the panic handler, which never returns.
/// :param code: The reason the program stops.
/// :note: The handler receives the call site in the caller's code.
#[noreturn, track_caller]
routine panic(code: TrapCode) -> Void
    block entry()
        panic_handler(code, "", caller_location())

/// Like `panic`, but passes `message` to the panic handler as well.
/// :param code: The reason the program stops.
/// :param message: Text describing the failure, passed to the panic handler.
/// :note: The handler receives the call site in the caller's code and never returns.
#[noreturn, track_caller]
routine panic_msg(code: TrapCode, message: Bytes) -> Void
    block entry()
        panic_handler(code, message, caller_location())
