// Tessera stdlib: UTF-8 encode/decode
//
// Text is Char (a Unicode scalar value); bytes are Byte in @Byte buffers,
// read as U8 to look at their bits.
//
// utf8_decode reads one character starting at byte pos (never reading at or
// past len) and returns a Utf8Decoded { char, next_pos, ok }. On a malformed
// sequence (a bad lead or continuation byte, an overlong form, a surrogate, or
// a value past 0x10FFFF) it returns { char: U+FFFD, next_pos: pos, ok: false }.
//
// utf8_encode writes one character into out (caller must ensure 4 bytes of
// space) and returns the number of bytes written.

module Standard::Core

// -- Utf8Decoded ---------------------------------------------------------------

/// The result of `utf8_decode`: the character read, the byte position just after it, and whether the sequence was well formed.
record Utf8Decoded
    char     : Char
    next_pos : USize
    ok       : Bool

// -- decode --------------------------------------------------------------------

/// Decodes the character starting at byte `pos` of `bytes`, never reading at or past `len`.
/// :param bytes: The buffer to decode from.
/// :param pos: The index of the first byte of the character.
/// :param len: The number of readable bytes in the buffer.
/// :returns: The character, the position after it, and whether it was well formed.
/// :note: A malformed or truncated sequence, or `pos` at or past `len`, gives U+FFFD with `next_pos` equal to `pos` and `ok` false.
routine utf8_decode(bytes: @Byte, pos: USize, len: USize) -> Utf8Decoded
    block entry():
        past_end : Bool = pos.ge(len)
        branch past_end
            ? error(pos)
            : read_lead(pos)

    block read_lead(pos: USize):
        b0   : Byte  = bytes.stride(pos).load()
        b0u  : U32   = U8.from_byte(b0).to<U32>()
        next : USize = pos.add(1)
        // single byte: 0xxxxxxx
        is_one : Bool = b0u.lt(0x80)
        branch is_one
            ? done(b0u, 0, pos, next)
            : check_two(b0u, pos, next)

    block check_two(b0u: U32, pos: USize, next: USize):
        // two byte: 110xxxxx 10xxxxxx
        mask2  : U32  = b0u.bitand(0xE0)
        is_two : Bool = mask2.eq(0xC0)
        branch is_two
            ? read_two(b0u, pos, next)
            : check_three(b0u, pos, next)

    block read_two(b0u: U32, pos: USize, next: USize):
        b1u   : U32  = utf8_continuation(bytes, next, len)
        valid : Bool = b1u.le(0x3F)
        branch valid
            ? done_two(b0u, b1u, pos, next)
            : error(pos)

    block done_two(b0u: U32, b1u: U32, pos: USize, next: USize):
        hi : U32 = b0u.bitand(0x1F).shl(6)
        cp : U32 = hi.bitor(b1u)
        jump done(cp, 0x80, pos, next.add(1))

    block check_three(b0u: U32, pos: USize, next: USize):
        // three byte: 1110xxxx 10xxxxxx 10xxxxxx
        mask3    : U32  = b0u.bitand(0xF0)
        is_three : Bool = mask3.eq(0xE0)
        branch is_three
            ? read_three(b0u, pos, next)
            : check_four(b0u, pos, next)

    block read_three(b0u: U32, pos: USize, next: USize):
        n2    : USize = next.add(1)
        b1u   : U32   = utf8_continuation(bytes, next, len)
        b2u   : U32   = utf8_continuation(bytes, n2, len)
        valid : Bool  = b1u.bitor(b2u).le(0x3F)
        branch valid
            ? done_three(b0u, b1u, b2u, pos, n2)
            : error(pos)

    block done_three(b0u: U32, b1u: U32, b2u: U32, pos: USize, n2: USize):
        hi  : U32 = b0u.bitand(0x0F).shl(12)
        mid : U32 = b1u.shl(6)
        cp  : U32 = hi.bitor(mid).bitor(b2u)
        jump done(cp, 0x800, pos, n2.add(1))

    block check_four(b0u: U32, pos: USize, next: USize):
        // four byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        mask4   : U32  = b0u.bitand(0xF8)
        is_four : Bool = mask4.eq(0xF0)
        branch is_four
            ? read_four(b0u, pos, next)
            : error(pos)

    block read_four(b0u: U32, pos: USize, next: USize):
        n2                : USize = next.add(1)
        n3                : USize = n2.add(1)
        b1u               : U32   = utf8_continuation(bytes, next, len)
        b2u               : U32   = utf8_continuation(bytes, n2, len)
        b3u               : U32   = utf8_continuation(bytes, n3, len)
        continuation_bits : U32   = b1u.bitor(b2u).bitor(b3u)
        valid             : Bool  = continuation_bits.le(0x3F)
        branch valid
            ? done_four(b0u, b1u, b2u, b3u, pos, n3)
            : error(pos)

    block done_four(b0u: U32, b1u: U32, b2u: U32, b3u: U32, pos: USize, n3: USize):
        p0    : U32 = b0u.bitand(0x07).shl(18)
        p1    : U32 = b1u.shl(12)
        p2    : U32 = b2u.shl(6)
        upper : U32 = p0.bitor(p1).bitor(p2)
        cp    : U32 = upper.bitor(b3u)
        jump done(cp, 0x10000, pos, n3.add(1))

    // An overlong form (below min, the smallest value that needs this many bytes), a surrogate, or a value
    // past 0x10FFFF isn't a Char.
    block done(cp: U32, min: U32, pos: USize, after: USize):
        overlong : Bool = cp.lt(min)
        branch overlong
            ? error(pos)
            : continue
        scalar : Option<Char> = cp.to_checked<Char>()
        when scalar:
            .Present(char) -> decoded(char, after)
            .Absent        -> error(pos)

    block decoded(char: Char, after: USize):
        result : Utf8Decoded = Utf8Decoded { char: char, next_pos: after, ok: true }
        return(result)

    block error(pos: USize):
        fffd        : U32         = 0xFFFD
        replacement : Char        = fffd.to<Char>()
        result      : Utf8Decoded = Utf8Decoded { char: replacement, next_pos: pos, ok: false }
        return(result)

/// The payload bits of the continuation byte at pos, 0x00 ..= 0x3F, or 0xFF
/// when the byte isn't a continuation byte or lies past len.
routine utf8_continuation(bytes: @Byte, pos: USize, len: USize) -> U32
    block entry():
        past_end : Bool = pos.ge(len)
        branch past_end
            ? return(0xFF)
            : continue
        b               : Byte = bytes.stride(pos).load()
        bu              : U32  = U8.from_byte(b).to<U32>()
        is_continuation : Bool = bu.bitand(0xC0).eq(0x80)
        branch is_continuation
            ? return(bu.bitand(0x3F))
            : return(0xFF)

// -- encode --------------------------------------------------------------------

/// Writes 1–4 bytes into out. Caller must have >= 4 bytes available.
/// Returns the byte count written.
routine utf8_encode(char: Char, out: @Byte) -> USize
    block entry():
        cp     : U32  = char.to<U32>()
        in_one : Bool = cp.lt(0x80)
        branch in_one
            ? enc_one(cp)
            : check_two(cp)

    block enc_one(cp: U32):
        out.stride(0).store(cp.to<U8>().bits())
        return(1)

    block check_two(cp: U32):
        in_two : Bool = cp.lt(0x800)
        branch in_two
            ? enc_two(cp)
            : check_three(cp)

    block enc_two(cp: U32):
        hi : U32 = cp.shr(6).bitor(0xC0)
        lo : U32 = cp.bitand(0x3F).bitor(0x80)
        out.stride(0).store(hi.to<U8>().bits())
        out.stride(1).store(lo.to<U8>().bits())
        return(2)

    block check_three(cp: U32):
        in_three : Bool = cp.lt(0x10000)
        branch in_three
            ? enc_three(cp)
            : enc_four(cp)

    block enc_three(cp: U32):
        b0         : U32 = cp.shr(12).bitor(0xE0)
        middle_six : U32 = cp.shr(6).bitand(0x3F)
        b1         : U32 = middle_six.bitor(0x80)
        b2         : U32 = cp.bitand(0x3F).bitor(0x80)
        out.stride(0).store(b0.to<U8>().bits())
        out.stride(1).store(b1.to<U8>().bits())
        out.stride(2).store(b2.to<U8>().bits())
        return(3)

    block enc_four(cp: U32):
        b0         : U32 = cp.shr(18).bitor(0xF0)
        upper_six  : U32 = cp.shr(12).bitand(0x3F)
        b1         : U32 = upper_six.bitor(0x80)
        middle_six : U32 = cp.shr(6).bitand(0x3F)
        b2         : U32 = middle_six.bitor(0x80)
        b3         : U32 = cp.bitand(0x3F).bitor(0x80)
        out.stride(0).store(b0.to<U8>().bits())
        out.stride(1).store(b1.to<U8>().bits())
        out.stride(2).store(b2.to<U8>().bits())
        out.stride(3).store(b3.to<U8>().bits())
        return(4)
