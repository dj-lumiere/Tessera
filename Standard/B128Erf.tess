// Tessera stdlib: B128 erf, erfc
//
// Correctly rounded, in two tiers as sin_pi (B128Extra.tess):
//
// - fast: B128Extended (192 bits), TLFloat's continued fractions with a finer e^x than wide_exp. Below |x| = 3,
//   erf from the continued fraction of e^(x²) erf x (100 levels, converged to 2^-309 at 3) and erfc = 1 - erf,
//   which cancels at most 16 bits there. From 3 on, erfc from Laplace's continued fraction with a level count
//   that falls with x (converged to 2^-196 at every x) and erf = 1 - erfc. The result is kept when all of it
//   × (1 ± 2^-B128_ERF_BAND) rounds to the same B128.
// - exact: otherwise B128Big (448 bits), rounded once. erf from the series without cancellation
//   erf x = 2/√π e^(-x²) Σ 2^n x^(2n+1) / (1·3·…·(2n+1)) (at most about 390 terms below 8.74, where erf
//   saturates). erfc = 1 + erf |x| for negative x, 1 - erf x below 4 (losing at most 26 of the 448 bits), and
//   from 4 on Laplace's continued fraction again, with enough levels for 2^-460 (926 at x = 4, 60 at the top).
//   Measured against mpmath on 3000 inputs: within 2^-411 relative (erfc just below 4), 2^-435 elsewhere.
//
// The band is measured, not proven: on 85000 random inputs (|x| from the subnormals to 107, both signs, with
// extra weight on (2, 3.2) and around each threshold) the fast tier's worst relative error against mpmath was
// 2^-163.7, erfc just below 3 where 1 - erf cancels. Elsewhere 2^-177 or better (2^-177.5 for erfc near 107,
// where x² is rounded to 192 bits). 2^-158 leaves 5.7 bits. None of 30000 inputs drawn without
// the extra weight failed the band test. Results near a rounding boundary do occur: erfc x = 1 - 2x/√π + … lies
// within 2^-226 of a midpoint when 2x/√π is near an odd multiple of 2^-114 (or of 2^-113 for x < 0), and so does
// erf x = 2x/√π (…) for tiny x when 2x/√π lands on a midpoint. At the B128 just below B128_ERF_ONE (and just above
// -B128_ERFC_TWO) the fast tier alone rounds the wrong way (tests/b128_erf.tess has them).
//
// Exact cases: erf(±0) = ±0, erf(±inf) = ±1, erfc(±0) = 1, erfc(-inf) = 2, erfc(+inf) = +0. Every other result
// is a rounding question, including the saturations: erf x rounds to ±1 once erfc |x| < 2^-114 (half an ulp below
// 1), from |x| = B128_ERF_ONE, erfc x rounds to 2 once erfc |x| < 2^-113, from x = -B128_ERFC_TWO, and erfc x
// rounds to +0 once it is below 2^-16495 (half the smallest subnormal), from x = B128_ERFC_ZERO. Each threshold is
// the first B128 past the crossing, found with mpmath at 2000 bits. The B128 just before each one comes within
// 2^-219 (the first two) or 2^-99 (the last) of the boundary, relative.
//
// Why no other input should be exact or a midpoint: either would make erf x (and erfc x = 1 - erf x) rational for
// a dyadic x ≠ 0. The Siegel-Shidlovskii theorem makes ∫₀ˣ e^(-t²) dt = (√π / 2) erf x transcendental for every
// algebraic x ≠ 0 (it is x/2 times the E-function Σ w^n / ((n + 1/2) n!) at w = -x²), but that doesn't rule out
// erf x itself being rational: it would take ∫₀ˣ e^(-t²) dt / √π to be irrational, which, as far as we know, is
// not proven. So the argument is not airtight. What the code relies on is the exact tier's accuracy (2^-411
// relative or better), far closer than any B128 was seen to come to a rounding boundary in testing.

module Standard/Core

import Standard/Format

/// The fast tier's result is kept when all of it × (1 ± 2^-B128_ERF_BAND) rounds to one B128. Measured, not
/// proven: the worst error seen was 2^-163.7 (see the header).
preset B128_ERF_BAND: S64 = 158

/// Where the fast tier turns from erf's continued fraction to erfc's
preset B128_ERF_FAST_SPLIT: B128 = B128.from_bits(0x40008000000000000000000000000000)  // 3
/// Where the exact tier turns from 1 - erf to erfc's continued fraction
preset B128_ERF_SPLIT: B128 = B128.from_bits(0x40010000000000000000000000000000)  // 4
/// erf rounds to ±1 from here on (erfc 8.7334302606… = 2^-114)
preset B128_ERF_ONE: B128 = B128.from_bits(0x4002177842BCE67448BC471EEA540735)
/// erfc rounds to 2 from minus this on down (erfc 8.6939136243… = 2^-113)
preset B128_ERFC_TWO: B128 = B128.from_bits(0x400216348A5859398F7A86034CB5B0B4)
/// erfc rounds to +0 from here on (erfc 106.9028456787… = 2^-16495)
preset B128_ERFC_ZERO: B128 = B128.from_bits(0x4005AB9C8393DDD2517E5404D6DD3C9D)

/// 2/√π = hi × 2^-447, 448 bits, least significant limb first (mpmath at 3000 bits, rounded)
preset BIG_TWO_OVER_SQRT_PI: @Array[U64, 7] <- [0xBD1F4EEE48E1CA78, 0x40C036096CC79AEB,
    0xC0759CF859270F11, 0x39A15830CCE620B0, 0x1409A0EBAC3E7517, 0x71D48A7F6BFEC344,
    0x906EBA8214DB688D]

// -- fast tier: B128Extended ---------------------------------------------------

/// e^x for |x| < 2^14, finer than wide_exp (whose Taylor series stops at 2^-141): x = q ln 2 + d with |d| <= ln 2
/// / 2, e^(d/16) by its Taylor series to degree 22 (the first dropped term is below 2^-200), then four squarings.
/// :param x: The exponent, |x| < 2^14.
/// :returns: e^x at 192 bits.
routine wide_erf_exp(x: B128Extended) -> B128Extended
    local q: S64 = (x * wide_const(1)).to_nearest[S64]()
    local s: @B128Extended <- .hollow()

    d: B128Extended = x - q.to[B128Extended]() * wide_const(0)
    last: B128Extended = wide_table(hi: WIDE_EXP_COEF_HI.to[@U128](), lo: WIDE_EXP_COEF_LO.to[@U64](), exponent: WIDE_EXP_COEF_EXP.to[@S64](), i: 22)
    last.poke_into(s)

    // s ← s × t + 1/i!
    t: B128Extended = d.ldexp(-4)
    until i < 0 with i: S64 = 21
        c: B128Extended = wide_table(hi: WIDE_EXP_COEF_HI.to[@U128](), lo: WIDE_EXP_COEF_LO.to[@U64](), exponent: WIDE_EXP_COEF_EXP.to[@S64](), i: i.to[USize]())
        s.poke(s.peek() * t + c)
        continue with i: i - 1

    each k in 0 til 4
        (s.peek() * s.peek()).poke_into(s)
    then
        return s.peek().ldexp(q)

/// erf z = 2/sqrt(pi) × z e^(-z²) × d/n, from the continued fraction evaluated backward over `levels` levels,
/// two per step.
/// :param z: The argument.
/// :param levels: The level count, even.
/// :returns: erf z at 192 bits.
routine wide_erf_cf(z: B128Extended, levels: S64) -> B128Extended
    local zz: B128Extended = z * z
    local n: @B128Extended <- .hollow()
    local d: @B128Extended <- .hollow()

    n0: B128Extended = S64.to[B128Extended](levels * 2 + 1)
    n0.poke_into(n)
    wide_one().poke_into(d)

    until i <= 0 with i: S64 = levels
        i2: S64 = i * 2
        n1: B128Extended = n.peek() * S64.to[B128Extended](i2 - 1) + zz * i2.to[B128Extended]() * d.peek()
        n2: B128Extended = n1 * S64.to[B128Extended](i2 - 3) - zz * S64.to[B128Extended](i2 - 2) * n.peek()
        next_d: B128Extended = n1
        next_n: B128Extended = n2
        next_n.poke_into(n)
        next_d.poke_into(d)
        continue with i: i - 2
    scale: B128Extended = z * wide_special(0) * wide_erf_exp(-zz)
    r: B128Extended = scale * (d.peek().ldexp(1) / n.peek())
    return r

/// erfc z = 1/sqrt(pi) × z e^(-z²) × d/n from Laplace's continued fraction, for the tail z >= 3.
/// :param z: The argument, at least 3.
/// :param levels: The level count, even (from {erfc_cf_levels}).
/// :returns: erfc z at 192 bits.
routine wide_erfc_cf(z: B128Extended, levels: S64) -> B128Extended
    local zz: B128Extended = z * z
    local n: @B128Extended <- .hollow()
    local d: @B128Extended <- .hollow()

    wide_one().poke_into(n)
    wide_one().poke_into(d)

    until i <= 0 with i: S64 = levels
        half_i: B128Extended = i.to[B128Extended]().ldexp(-1)
        n1: B128Extended = n.peek() + half_i * d.peek()
        half_prev: B128Extended = S64.to[B128Extended](i - 1).ldexp(-1)
        n2: B128Extended = zz * n1 + half_prev * n.peek()
        next_d: B128Extended = n1
        next_n: B128Extended = n2
        next_n.poke_into(n)
        next_d.poke_into(d)
        continue with i: i - 2
    scale: B128Extended = z * wide_special(0) * wide_erf_exp(-zz)
    r: B128Extended = scale * (d.peek() / n.peek())
    return r

/// Levels of the erfc continued fraction for a in [3, 107): base + linear / k + square / k² (+ 2, rounded up to
/// even) with k = floor(a). The counts were checked against mpmath at every integer k, where the fraction
/// converges slowest for its k: the fast tier's (22, 400, 1300) reaches 2^-196 at 3 and 2^-208 from 4 on, the
/// exact tier's (48, 1000, 10000) 2^-470 from 4 on.
/// :param a: The argument, in [3, 107).
/// :param base: The constant term.
/// :param linear: The coefficient of 1/k.
/// :param square: The coefficient of 1/k².
/// :returns: The even level count.
/// :throws: Crashes with `DivisionByZeroError` when `a` < 1.
routine erfc_cf_levels(a: B128, base: S64, linear: S64, square: S64) -> S64
    k: S64 = a.trunc().to[S64]()
    with_linear: S64 = base + linear / k
    n: S64 = with_linear + square / (k * k) + 2
    r: S64 = n + (n & 1)
    return r

/// erf a for 0 < a < B128_ERF_ONE, the fast tier: the erf continued fraction below 3, 1 - erfc from 3 on.
/// :param a: The argument.
/// :returns: erf a at 192 bits.
routine wide_erf(a: B128) -> B128Extended
    local z: B128Extended = a.to[B128Extended]()

    if a >= B128_ERF_FAST_SPLIT
        c: B128Extended = wide_erfc_cf(z, levels: erfc_cf_levels(a, base: 22, linear: 400, square: 1300))
        r: B128Extended = wide_one() - c
        return r
    else
        return wide_erf_cf(z, levels: 100)

/// erfc x for a nonzero x in (-B128_ERFC_TWO, B128_ERFC_ZERO), the fast tier.
/// :param x: The argument.
/// :returns: erfc x at 192 bits.
routine wide_erfc(x: B128) -> B128Extended
    local a: B128 = x.abs()
    local negative: Bool = b128_is_negative_bits(x.bits())

    if a >= B128_ERF_FAST_SPLIT
        // erfc(-a) = 2 - erfc a
        c: B128Extended = wide_erfc_cf(z: a.to[B128Extended](), levels: erfc_cf_levels(a, base: 22, linear: 400, square: 1300))
        two: B128Extended = S64.to[B128Extended](2)
        r: B128Extended = when
            negative => two - c
            else => c
        return r
    else
        return wide_one() - wide_erf_cf(z: x.to[B128Extended](), levels: 100)

// -- exact tier: B128Big -------------------------------------------------------

/// 2/√π at 448 bits.
/// :returns: 2/√π as a B128Big.
routine big_two_over_sqrt_pi() -> B128Big
    r: B128Big = big_from_limbs(limbs: BIG_TWO_OVER_SQRT_PI.to[@U64](), exponent: -447)
    return r

/// erf a for 0 < a < B128_ERF_ONE: 2/√π e^(-a²) Σ t_n with t_0 = a, t_n = t_(n-1) × 2a² / (2n + 1). Every term
/// is positive, so nothing cancels. The terms grow until n ~ a², then fall, and the sum stops once one is below
/// 2^-456 of it (at most about 390 terms below 8.74).
/// :param a: The argument.
/// :returns: erf a at 448 bits.
routine big_erf(a: B128Big) -> B128Big
    local aa: B128Big = a * a

    y: B128Big = aa.ldexp(1)

    while true with n: U64 = 1, term: B128Big = a, sum: B128Big = a
        next2: B128Big = term * y / (n * 2 + 1)
        if big_is_negligible(term: next2, sum)
            r: B128Big = sum * big_exp(-aa) * big_two_over_sqrt_pi()
            return r
        else
            continue with n: n + 1, term: next2, sum: sum + next2

/// erfc z for z >= 4: Laplace's continued fraction as wide_erfc_cf, over `levels` levels (even). Every quantity
/// is positive, so the backward recurrence loses nothing to cancellation.
/// :param z: The argument, at least 4.
/// :param levels: The level count, even (from {erfc_cf_levels}).
/// :returns: erfc z at 448 bits.
routine big_erfc_cf(z: B128Big, levels: S64) -> B128Big
    local zz: B128Big = z * z
    // exact: z has 113 bits
    local n: @B128Big <- .hollow()
    local d: @B128Big <- .hollow()

    one: B128Big = big_one()
    one.poke_into(n)
    one.poke_into(d)

    until i <= 0 with i: S64 = levels
        n1: B128Big = n.peek() + (d.peek() * i).ldexp(-1)
        n2: B128Big = zz * n1 + (n.peek() * (i - 1)).ldexp(-1)
        next_d: B128Big = n1
        next_n: B128Big = n2
        next_n.poke_into(n)
        next_d.poke_into(d)
        continue with i: i - 2
    scale: B128Big = z * big_two_over_sqrt_pi().ldexp(-1) * big_exp(-zz)
    r: B128Big = scale * (d.peek() / n.peek())
    return r

/// erfc x for a nonzero x in (-B128_ERFC_TWO, B128_ERFC_ZERO), the exact tier: 1 + erf |x| for negative x,
/// 1 - erf x below 4, Laplace's continued fraction from 4 on.
/// :param x: The argument.
/// :returns: erfc x at 448 bits.
routine big_erfc(x: B128) -> B128Big
    a: B128 = x.abs()
    big_a: B128Big = a.to[B128Big]()
    negative: Bool = b128_is_negative_bits(x.bits())
    when
        negative => return big_one() + big_erf(big_a)
        a >= B128_ERF_SPLIT => return big_erfc_cf(z: big_a, levels: erfc_cf_levels(a, base: 48, linear: 1000, square: 10000))
        else => return big_one() - big_erf(big_a)

// -- erf, erfc -----------------------------------------------------------------

/// The error function, correctly rounded: ±0 at ±0, ±1 from |me| = 8.7334… on. A NaN comes back quieted.
/// :returns: erf(`me`).
routine B128.erf(me: Me) -> Me
    r: Me = b128_erf(x: me, exact: false)
    return r

/// The complementary error function 1 - erf, correctly rounded: 1 at ±0, 2 from me = -8.6939… down, +0 from
/// 106.9028… up. A NaN comes back quieted.
/// :returns: erfc(`me`).
routine B128.erfc(me: Me) -> Me
    r: Me = b128_erfc(x: me, exact: false)
    return r

/// erf x, correctly rounded. erf is odd and rounding to nearest is symmetric, so the work is done on |x|.
/// :param x: The argument.
/// :param exact: True skips the fast tier (the tests use it to check the exact tier on its own).
/// :returns: erf x.
routine b128_erf(x: B128, exact: Bool) -> B128
    local bits: U128 = x.bits()
    local nan: Bool = b128_is_nan_bits(bits)
    local zero: Bool = b128_is_zero_bits(bits)
    local a: B128 = x.abs()

    // the infinities too
    when
        nan => return b128_of(b128_quiet(bits))
        zero => return x
        a >= B128_ERF_ONE => return b128_of(B128_ONE).copysign(x)
        else =>
            if not exact
                w: B128Extended = wide_erf(a)
                rounded: WideRounding = wide_round_within(u: w, k: B128_ERF_BAND)
                if rounded.ok
                    return rounded.value.copysign(x)
            magnitude: B128 = big_erf(a.to[B128Big]()).to[B128]()
            r: B128 = magnitude.copysign(x)
            return r

/// erfc x, correctly rounded.
/// :param x: The argument.
/// :param exact: True skips the fast tier.
/// :returns: erfc x.
routine b128_erfc(x: B128, exact: Bool) -> B128
    bits: U128 = x.bits()
    nan: Bool = b128_is_nan_bits(bits)
    zero: Bool = b128_is_zero_bits(bits)
    none: Bool = x >= B128_ERFC_ZERO
    // +inf too
    // -inf too
    when
        nan => return b128_of(b128_quiet(bits))
        zero => return b128_of(B128_ONE)
        none => return b128_of(0)
        x <= B128_ERFC_TWO.neg() => return b128_of(0x40000000000000000000000000000000)
        else =>
            if not exact
                w: B128Extended = wide_erfc(x)
                rounded: WideRounding = wide_round_within(u: w, k: B128_ERF_BAND)
                if rounded.ok
                    return rounded.value
            r: B128 = big_erfc(x).to[B128]()
            return r
