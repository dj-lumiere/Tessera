/// Coefficients of the accurate-path polynomial, highest degree first, as 128-bit significands (hi, lo),
/// exponents and signs: an entry is (-1)^sgn (hi + lo/2^64) 2^(ex - 63).
preset CM_F64_LOG_DP_HI: @Array<U64, 13> <- { 0x99DF88A0430813CA, 0xAAA02D43F696C3E4,
    0xBA2E7A1EAF856174, 0xCCCCCCB9EC017492, 0xE38E38E3807CFA4B, 0xFFFFFFFFFFF924CC,
    0x924924924924911D, 0xAAAAAAAAAAAAAAAA, 0xCCCCCCCCCCCCCCCC, 0xFFFFFFFFFFFFFFFF,
    0xAAAAAAAAAAAAAAAA, 0xFFFFFFFFFFFFFFFF, 0x8000000000000000 }

/// The low significand words of CM_F64_LOG_DP_HI.
preset CM_F64_LOG_DP_LO: @Array<U64, 13> <- { 0xA1CFFB6E966A70F6, 0x4DBE754667B6BC48,
    0x70E5C5A5EBBE0226, 0xF934E28D924E76D4, 0xC976E6CBD22E203F, 0x05B308E39FA7DFB5,
    0x862BC3D33ABB3649, 0x6637FD4B19743EEC, 0xCCC2CA18B08FE343, 0xFFFFFF2245823AE0,
    0xAAAAAAAAA5C48B54, 0xFFFFFFFFFFFFEBD8, 0x0000000000000000 }

/// The exponents of CM_F64_LOG_DP_HI.
preset CM_F64_LOG_DP_EX: @Array<S64, 13> <- { -4, -4, -4, -4, -4, -4, -3, -3, -3, -3, -2, -2, 0 }

/// The signs of CM_F64_LOG_DP_HI.
preset CM_F64_LOG_DP_SGN: @Array<U64, 13> <- { 0x0000000000000000, 0x0000000000000001,
    0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001,
    0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001,
    0x0000000000000000, 0x0000000000000001, 0x0000000000000000 }

/// A double-double value hi + lo.
record CmF64LogDd
    hi : F64
    lo : F64

/// A "dint": (-1)^sgn m 2^(ex - 127), with the 128-bit significand m normalized so that its top bit is set (or m = 0
/// for zero).
record CmF64LogDint
    m   : U128
    ex  : S64
    sgn : U64

/// The natural logarithm, correctly rounded (to nearest, ties to even). ln(1) = +0, ln(±0) = -inf, ln(+inf) = +inf,
/// a negative argument gives NaN, and NaN comes back quiet.
/// :returns: ln(`self`).
routine F64.ln(self: Self) -> Self
    shared u               : U64 = self.bits()
    shared biased_exponent : S64 = u.shr(52).to<S64>()
    shared e               : S64 = biased_exponent.sub(0x3FF)

    block entry()
        edge : Bool = e.ge(0x400).bitor(e.eq(-0x3FF))
        branch edge
            ? edge()
            : normal(u, e)

    // x <= 0, NaN, infinity or subnormal
    block edge()
        nan_inf  : Bool = e.eq(0x400).bitor(e.eq(0xC00).bitand(u.ne(0xFFF0000000000000)))
        negative : Bool = self.lt(0.0)
        zero     : Bool = self.eq(0.0)
        when
            nan_inf  -> return(self.add(self))  // +inf or NaN of either sign
            negative -> return(Self.from_bits(0xFFF8000000000000))  // the default NaN of 0/0
            zero     -> return(Self.from_bits(0xFFF0000000000000))  // the pole
            else     -> subnormal()

    // scale into the normal range
    block subnormal()
        us              : U64 = self.mul(0x1p52).bits()
        scaled_exponent : S64 = us.shr(52).to<S64>()
        jump normal(us, scaled_exponent.sub(0x3FF).sub(52))

    // now x = m 2^e_norm with 1 <= m < 2 and -1074 <= e_norm <= 1023
    block normal(u_norm: U64, e_norm: S64)
        mbits : U64  = u_norm.bitand(0x000FFFFFFFFFFFFF)
        one   : Bool = mbits.eq(0).bitand(e_norm.eq(0))
        branch one
            ? return(0.0)
            : continue
        hl    : CmF64LogDd = cm_f64_log_fast(e_norm, mbits)
        left  : Self       = hl.hi.add(hl.lo.sub(0x1.b6p-69))  // the fast path's maximal absolute error
        right : Self       = hl.hi.add(hl.lo.add(0x1.b6p-69))
        sure  : Bool       = left.eq(right)
        branch sure
            ? return(left)
            : return(CmF64LogDint.to<Self>(cm_f64_log_dint_log_of(self)))

/// The fast path of log: a double-double approximation of log(2^e m) with absolute error below 0x1.b6p-69, where
/// m = 1 + mbits/2^52.
/// :param e: The unbiased exponent.
/// :param mbits: The 52 fraction bits of the significand.
/// :returns: The approximation as a double-double.
private routine cm_f64_log_fast(e: S64, mbits: U64) -> CmF64LogDd
    block entry()
        m     : U64  = mbits.add(0x0010000000000000)
        yf    : F64  = F64.from_bits(mbits.bitor(0x3FF0000000000000))
        large : Bool = m.ge(0x16A09E667F3BCD)  // m > sqrt(2): divide it by 2 to avoid cancellation
        branch large
            ? reduce(e.add(1), m.shr(44), yf.mul(0.5))
            : reduce(e, m.shr(43), yf)

    block reduce(ee: S64, i: U64, y: F64)
        k  : USize = i.sub(362).to<USize>()
        r  : F64   = F64.from_bits(CM_F64_LOG_INVERSE.getitem(k))
        l1 : F64   = F64.from_bits(CM_F64_LOG_LOG_INV.getitem(k.mul(2)))
        l2 : F64   = F64.from_bits(CM_F64_LOG_LOG_INV.getitem(k.mul(2).add(1)))
        z  : F64   = r.mul_add(y, -1.0)  // exact
        // P(z) - z, for |z| < 0.00212097167968735
        z2  : F64 = z.mul(z)
        p45 : F64 = F64.mul_add(-0x1.55362255e0f63p-3, z, 0x1.999a14758b084p-3)
        p23 : F64 = F64.mul_add(-0x1.0000000537df6p-2, z, 0x1.555555554f4d8p-2)
        ph0 : F64 = p45.mul_add(z2, p23)
        ph1 : F64 = ph0.mul_add(z, -0x1.ffffffffffffap-2)
        ph  : F64 = ph1.mul(z2)
        // add e log(2): log2_h is an integer multiple of 2^-42, so e log2_h + l1 is exact
        eed : F64 = ee.to<F64>()
        hi  : F64 = eed.mul_add(0x1.62e42fefa38p-1, l1)
        h   : F64 = hi.add(z)
        lo0 : F64 = z.sub(h.sub(hi))
        lo1 : F64 = ph.add(lo0.add(l2))
        lo  : F64 = eed.mul_add(0x1.ef35793c7673p-45, lo1)
        return(CmF64LogDd { hi: h, lo: lo })

/// ln `x` as the fast path's double-double, renormalized so that the low part is at most half an ulp of the high
/// part, for F64.log's first tier. Its absolute error stays below 0x1.b6p-69.
/// :param x: The argument, positive and finite (subnormals included), not 1.
/// :returns: ln `x` as a normalized double-double.
routine cm_f64_log_dd(x: F64) -> CmF64LogDd
    shared u      : U64 = x.bits()
    shared biased : S64 = u.shr(52).to<S64>()

    block entry()
        branch biased.eq(0)
            ? subnormal()
            : fast(u, biased.sub(0x3FF))

    // scale into the normal range, as F64.ln does
    block subnormal()
        us     : U64 = x.mul(0x1p52).bits()
        scaled : S64 = us.shr(52).to<S64>()
        jump fast(us, scaled.sub(0x3FF).sub(52))

    // the fast path's low part can be about 2^-10 of its high part near 1: fold it back (Fast2Sum, exact)
    block fast(bits: U64, e: S64)
        hl : CmF64LogDd = cm_f64_log_fast(e, bits.bitand(0x000FFFFFFFFFFFFF))
        hi : F64        = hl.hi.add(hl.lo)
        lo : F64        = hl.lo.sub(hi.sub(hl.hi))
        return(CmF64LogDd { hi: hi, lo: lo })

/// ln `x` / ln `base` from the fast path's double-doubles, divided in double-double, when an error band around the
/// quotient rounds to one F64 (Ziv's test). Each logarithm is off by at most 0x1.b6p-69 absolute, so by that over its
/// size relative. The quotient adds below 2^-100 relative. The band is the sum of the two relative bounds, raised by
/// 1/10000 for the first-order terms and the bounds' own rounding, plus 2^-98.
/// :param x: The argument, positive and finite, not 1.
/// :param base: The base, positive and finite, not 1.
/// :returns: log base `base` of `x`, correctly rounded.
/// :absent: When the band reaches a rounding boundary: about 2 in a million random pairs, and most pairs with `x` or
///     `base` within about 2^-12 of 1, where the absolute bound is wide next to the logarithm.
routine cm_f64_log_ratio_fast(x: F64, base: F64) -> Option<F64>
    block entry()
        n     : CmF64LogDd = cm_f64_log_dd(x)
        d     : CmF64LogDd = cm_f64_log_dd(base)
        q_hi  : F64        = n.hi.div(d.hi)
        rest  : F64        = q_hi.neg().mul_add(d.hi, n.hi)  // n.hi - q_hi d.hi, exact
        top   : F64        = rest.add(n.lo).sub(q_hi.mul(d.lo))
        q_lo  : F64        = top.div(d.hi)
        en    : F64        = F64.div(0x1.b6p-69, n.hi.abs())
        ed    : F64        = F64.div(0x1.b6p-69, d.hi.abs())
        rel   : F64        = en.add(ed).mul(1.0001).add(0x1p-98)
        width : F64        = q_hi.abs().mul(rel)
        left  : F64        = q_hi.add(q_lo.sub(width))
        right : F64        = q_hi.add(q_lo.add(width))
        branch left.eq(right)
            ? return(.Present(left))
            : return(.Absent)

/// The accurate path of log: log x as a dint with about 126 bits of accuracy, for a positive finite x other than 1.
/// :param x: The argument.
/// :returns: log(`x`) as a dint.
routine cm_f64_log_dint_log_of(x: F64) -> CmF64LogDint
    shared d : CmF64LogDint = x.to<CmF64LogDint>()

    block entry()
        hi    : U64  = d.m.shr(64).to<U64>()
        above : Bool = hi.gt(0xB504F333F9DE6484)  // the lookup index
        branch above
            ? reduce(d.ex.add(1), hi.shr(56))
            : reduce(d.ex, hi.shr(55))

    block reduce(e: S64, i: U64)
        k      : USize        = i.sub(128).to<USize>()
        inv_hi : U64          = CM_F64_LOG_DINV_HI.getitem(k)
        inv    : CmF64LogDint = CmF64LogDint { m: inv_hi.to<U128>().shl(64),
            ex: CM_F64_LOG_DINV_EX.getitem(k), sgn: 0 }
        xr     : CmF64LogDint = CmF64LogDint { m: d.m, ex: d.ex.sub(e), sgn: 0 }
        zp     : CmF64LogDint = cm_f64_log_dint_mul(xr, inv)
        minus1 : CmF64LogDint = CmF64LogDint { m: U128.shl(1, 127), ex: 0, sgn: 1 }
        z      : CmF64LogDint = cm_f64_log_dint_add(minus1, zp)
        log2   : CmF64LogDint = CmF64LogDint { m: 0xB17217F7D1CF79ABC9E3B39803F2F6AF, ex: -1,
            sgn: 0 }
        r      : CmF64LogDint = cm_f64_log_dint_mul_int(e, log2)  // e log(2)
        p      : CmF64LogDint = cm_f64_log_dint_poly(z)
        lk_top : U64          = CM_F64_LOG_DLOG_INV_HI.getitem(k)
        lk_hi  : U128         = lk_top.to<U128>().shl(64)
        lk_m   : U128         = lk_hi.bitor(CM_F64_LOG_DLOG_INV_LO.getitem(k).to<U128>())
        lk_ex  : S64          = CM_F64_LOG_DLOG_INV_EX.getitem(k)
        lk     : CmF64LogDint = CmF64LogDint { m: lk_m, ex: lk_ex,
            sgn: CM_F64_LOG_DLOG_INV_SGN.getitem(k) }
        s      : CmF64LogDint = cm_f64_log_dint_add(lk, p)
        return(cm_f64_log_dint_add(s, r))

/// The accurate-path polynomial approximating log(1 + z), evaluated in dint arithmetic.
/// :param z: The reduced argument.
/// :returns: The polynomial value as a dint.
private routine cm_f64_log_dint_poly(z: CmF64LogDint) -> CmF64LogDint
    shared r : @CmF64LogDint <- uninit

    block entry()
        cm_f64_log_dint_coefficient(0).store_into(r)
        jump horner(1)

    block horner(j: USize)
        done : Bool = j.eq(13)
        branch done
            ? return(cm_f64_log_dint_mul(z, r.load()))
            : continue
        t : CmF64LogDint = cm_f64_log_dint_mul(z, r.load())
        cm_f64_log_dint_add(cm_f64_log_dint_coefficient(j), t).store_into(r)
        jump horner(j.add(1))

/// Coefficient j of the accurate-path polynomial, highest degree first.
/// :param j: The coefficient index, 0..12.
/// :returns: The coefficient as a dint.
private routine cm_f64_log_dint_coefficient(j: USize) -> CmF64LogDint
    block entry()
        m_hi : U128 = CM_F64_LOG_DP_HI.getitem(j).to<U128>()
        m    : U128 = m_hi.shl(64).bitor(CM_F64_LOG_DP_LO.getitem(j).to<U128>())
        return(CmF64LogDint { m: m, ex: CM_F64_LOG_DP_EX.getitem(j),
            sgn: CM_F64_LOG_DP_SGN.getitem(j) })

/// a + b, rounded to nearest on 128 bits.
/// :param a: The first addend.
/// :param b: The second addend.
/// :returns: The sum as a normalized dint.
private routine cm_f64_log_dint_add(a: CmF64LogDint, b: CmF64LogDint) -> CmF64LogDint
    block entry()
        a_zero   : Bool = a.m.eq(0)
        b_zero   : Bool = b.m.eq(0)
        same_ex  : Bool = a.ex.eq(b.ex)
        equal    : Bool = same_ex.bitand(a.m.eq(b.m))
        a_larger : Bool = a.ex.gt(b.ex).bitor(same_ex.bitand(a.m.gt(b.m)))
        when
            a_zero   -> return(b)
            b_zero   -> return(a)
            equal    -> equal()
            a_larger -> align(a, b)
            else     -> align(b, a)

    // |a| = |b|
    block equal()
        opposite : Bool = a.sgn.ne(b.sgn)
        branch opposite
            ? return(CmF64LogDint { m: 0, ex: 0, sgn: 0 })
            : return(CmF64LogDint { m: a.m, ex: a.ex.add(1), sgn: a.sgn })

    // from now on |x| > |y|: shift y's significand to x's exponent, rounding to nearest
    block align(x: CmF64LogDint, y: CmF64LogDint)
        sh      : S64  = x.ex.sub(y.ex)
        shifted : Bool = sh.gt(0)
        branch shifted
            ? continue
            : combine(x, y.m, y.sgn)
        // a shift past 128 bits leaves the round bit 0, as C's guard sh <= 128 does
        round : U128 = y.m.shr(sh.sub(1).to<U128>()).bitand(1)
        jump combine(x, y.m.add_wrap(round).shr(sh.to<U128>()), y.sgn)

    block combine(x: CmF64LogDint, ym: U128, ysgn: U64)
        opposite : Bool = x.sgn.ne(ysgn)
        branch opposite
            ? normalize(x.m.sub_wrap(ym), x.ex, x)
            : continue
        c     : U128 = x.m.add_wrap(ym)
        carry : Bool = c.lt(x.m)  // carry out of the 128 bits
        branch carry
            ? carry(c, x)
            : normalize(c, x.ex, x)

    block carry(c: U128, x: CmF64LogDint)
        rounded : U128 = c.add_wrap(c.bitand(1))
        jump normalize(U128.shl(1, 127).bitor(rounded.shr(1)), x.ex.add(1), x)

    block normalize(c: U128, m_ex: S64, x: CmF64LogDint)
        zero : Bool = c.eq(0)
        branch zero
            ? return(CmF64LogDint { m: 0, ex: m_ex.sub(x.ex.add(64)), sgn: x.sgn })
            : continue
        lz : U128 = c.leading_zeros()
        return(CmF64LogDint { m: c.shl(lz), ex: m_ex.sub(lz.to<S64>()), sgn: x.sgn })

/// a b, with 126 bits of accuracy.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The product as a normalized dint.
routine cm_f64_log_dint_mul(a: CmF64LogDint, b: CmF64LogDint) -> CmF64LogDint
    block entry()
        mask : U128 = 0xFFFFFFFFFFFFFFFF
        ahi  : U128 = a.m.shr(64)
        alo  : U128 = a.m.bitand(mask)
        bhi  : U128 = b.m.shr(64)
        blo  : U128 = b.m.bitand(mask)
        t0   : U128 = ahi.mul_wrap(bhi)
        m1   : U128 = ahi.mul_wrap(blo)
        m2   : U128 = alo.mul_wrap(bhi)
        m    : U128 = m1.add_wrap(m2)
        wrap : Bool = m.lt(m1)
        t1   : U128 = wrap
            ? t0.add_wrap(U128.shl(1, 64))
            : t0
        t   : U128 = t1.add_wrap(m.shr(64))
        low : U128 = m.bitand(mask).shr(63)
        sgn : U64  = a.sgn.bitxor(b.sgn)
        top : Bool = t.shr(127).eq(1)
        // make the top bit of the significand 1
        branch top
            ? return(CmF64LogDint { m: t.add_wrap(low), ex: a.ex.add(b.ex).add(1), sgn: sgn })
            : return(CmF64LogDint { m: t.shl(1).add_wrap(low), ex: a.ex.add(b.ex), sgn: sgn })

/// b a for a small integer b.
/// :param b: The integer factor.
/// :param a: The dint factor.
/// :returns: The product as a normalized dint.
private routine cm_f64_log_dint_mul_int(b: S64, a: CmF64LogDint) -> CmF64LogDint
    block entry()
        zero : Bool = b.eq(0)
        branch zero
            ? return(CmF64LogDint { m: 0, ex: 0, sgn: 0 })
            : continue
        negative : Bool = b.lt(0)
        branch negative
            ? scale(b.neg().to<U128>(), U64.sub(1, a.sgn))
            : scale(b.to<U128>(), a.sgn)

    block scale(c: U128, sgn: U64)
        t0   : U128 = a.m.shr(64).mul_wrap(c)
        wide : Bool = t0.shr(64).ne(0)
        sh   : U128 = wide
            ? t0.leading_zeros()
            : 64
        t     : U128 = t0.shl(sh)
        l0    : U128 = a.m.bitand(0xFFFFFFFFFFFFFFFF).mul_wrap(c)
        l     : U128 = l0.shl(sh.sub(1)).shr(63)
        s     : U128 = l.add_wrap(t)
        carry : Bool = s.lt(l)
        branch carry
            ? continue
            : return(CmF64LogDint { m: s, ex: a.ex.add(64).sub(sh.to<S64>()), sgn: sgn })
        rounded : U128 = s.add_wrap(s.bitand(1))
        m       : U128 = U128.shl(1, 127).bitor(rounded.shr(1))
        return(CmF64LogDint { m: m, ex: a.ex.add(64).sub(sh.to<S64>().sub(1)), sgn: sgn })

/// A positive finite x as a dint.
/// :returns: `self` as a normalized dint.
private routine F64.to<CmF64LogDint>(self: Self) -> CmF64LogDint
    block entry()
        u      : U64  = self.bits()
        eb     : U64  = u.shr(52).bitand(0x7FF)
        frac   : U64  = u.bitand(0x000FFFFFFFFFFFFF)
        normal : Bool = eb.ne(0)
        mant   : U64  = normal
            ? frac.add(0x0010000000000000)
            : frac
        e     : S64  = eb.to<S64>().sub(0x3FF)
        t     : U64  = mant.leading_zeros()
        sub   : Bool = t.gt(11)
        shift : S64  = sub
            ? t.to<S64>().sub(12)
            : 0
        normalized : U64 = mant.shl(t)
        return(CmF64LogDint { m: normalized.to<U128>().shl(64), ex: e.sub(shift), sgn: 0 })

/// A dint rounded to the nearest F64, assuming the result is in the normal range.
/// :returns: The rounded F64.
routine CmF64LogDint.to<F64>(self: Self) -> F64
    block entry()
        hi        : U64  = self.m.shr(64).to<U64>()
        lo        : U64  = self.m.to_wrap<U64>()
        rbits     : U64  = hi.shr(11).bitor(0x3FF0000000000000)  // the upper 53 bits of hi, 1 <= r < 2
        round_bit : U64  = hi.shr(10).bitand(1)
        round     : Bool = round_bit.eq(1)
        hi_sticky : Bool = hi.bitand(0x3FF).ne(0)
        sticky    : Bool = hi_sticky.bitor(lo.ne(0))
        rd0       : F64  = round
            ? 0x1p-53
            : 0.0
        rd : F64 = sticky
            ? rd0.add(0x1p-54)
            : rd0
        r0   : F64  = F64.from_bits(rbits.bitor(self.sgn.shl(63)))
        plus : Bool = self.sgn.eq(0)
        r    : F64  = plus
            ? r0.add(rd)
            : r0.add(rd.neg())
        biased_exponent : U64 = self.ex.add(1023).to_wrap<U64>()
        scale           : F64 = F64.from_bits(biased_exponent.bitand(0x7FF).shl(52))
        return(r.mul(scale))
