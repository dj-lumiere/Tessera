// Tessera stdlib: the correctly rounded log-gamma function of F64
//
// log|gamma(x)| in double-double with an error bound: -log|x| plus a series for
// |x| < 0.5, piece-wise polynomials on [0.5, 8.29541] (with the zeros at 1 and
// 2 factored out), Stirling's series above, and the reflection formula for
// negative x. When the bound can't decide the rounding, an accurate phase redoes
// it in triple-double, with polynomials around the zeros of lgamma between
// -10.5 and -2, and a table settles the hardest inputs. Only the value is
// computed: C's signgam (the sign of gamma(x)) is not. Round to nearest only:
// 0, the negative integers and +-inf give +inf, NaN comes back quiet.
//
// The double-double helpers and the fast logarithm come from Tgamma.tess.
//
// Ported from CORE-MATH, src/binary64/lgamma/lgamma.c via RazorForge's B64Lgamma.rf.
// Copyright (c) 2024 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Upper borders of the piece-wise regions of [0.5, 8.29541], as the argument's bits
/// shifted right by 37.
preset CM_F64_LGAMMA_UBRD: @Array<U64, 20> <- { 0x0000000001FF0000, 0x0000000001FF146C,
    0x0000000001FF2B7B, 0x0000000001FF4532, 0x0000000001FF614C, 0x0000000001FF8310,
    0x0000000001FF93F7, 0x0000000001FFA880, 0x0000000001FFC05E, 0x0000000001FFDB73,
    0x0000000001FFF8A5, 0x0000000002001147, 0x0000000002002703, 0x00000000020041AC,
    0x000000000200622A, 0x00000000020084D9, 0x0000000002009CE7, 0x000000000200BA2C,
    0x000000000200DDD7, 0x00000000020104BA }

/// The 17 root regions of the accurate path (roots of lgamma for -10.5 < x < -2):
/// offsets in CM_F64_LGAMMA_T of the triple-double root x0.
preset CM_F64_LGAMMA_RG_X0: @Array<USize, 17> <- { 185, 240, 297, 340, 383, 434, 475, 516, 567, 618,
    671, 722, 779, 836, 895, 954, 1011 }

/// Offsets of each root region's coefficient pairs.
preset CM_F64_LGAMMA_RG_C: @Array<USize, 17> <- { 188, 243, 300, 343, 386, 437, 478, 519, 570, 621,
    674, 725, 782, 839, 898, 957, 1014 }

/// The coefficient pair count of each root region.
preset CM_F64_LGAMMA_RG_N: @Array<USize, 17> <- { 26, 27, 20, 20, 24, 19, 19, 24, 24, 25, 24, 27,
    27, 28, 28, 27, 27 }

/// How many trailing coefficients of each root region are evaluated in double precision.
preset CM_F64_LGAMMA_RG_K: @Array<USize, 17> <- { 6, 6, 7, 7, 7, 7, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6,
    6 }

/// The scale exponent of each root region (z is scaled by 2^sc).
preset CM_F64_LGAMMA_RG_SC: @Array<S64, 17> <- { 3, 4, 6, 8, 7, 10, 10, 12, 12, 14, 15, 17, 17, 20,
    20, 24, 24 }

/// The bound on |fh| of each root region (F64 bits).
preset CM_F64_LGAMMA_RG_FH: @Array<U64, 17> <- { 0x3FB7400000000000, 0x3FB1680000000000,
    0x3FB2D40000000000, 0x3FAEF00000000000, 0x3FC0000000000000, 0x3FB0800000000000,
    0x3FB1000000000000, 0x3FC1300000000000, 0x3FC1500000000000, 0x3FC3400000000000,
    0x3FC1450000000000, 0x3FC76B0000000000, 0x3FC76C0000000000, 0x3FC9900000000000,
    0x3FC9900000000000, 0x3FC76B0000000000, 0x3FC76B0000000000 }

/// The open interval (lo, hi) of x of each root region: lo (F64 bits).
preset CM_F64_LGAMMA_RG_LO: @Array<U64, 17> <- { 0xC004E147AE147AE1, 0xC008000000000000,
    0xC00C000000000000, 0xC010000000000000, 0xC012000000000000, 0xC014000000000000,
    0xC016000000000000, 0xC018000000000000, 0xC01A000000000000, 0xC01C000000000000,
    0xC01E000000000000, 0xC020000000000000, 0xC021000000000000, 0xC022000000000000,
    0xC023000000000000, 0xC024000000000000, 0xC025000000000000 }

/// The open interval (lo, hi) of x of each root region: hi (F64 bits).
preset CM_F64_LGAMMA_RG_HI: @Array<U64, 17> <- { 0xC000000000000000, 0xC004E147AE147AE1,
    0xC008000000000000, 0xC00C000000000000, 0xC010000000000000, 0xC012000000000000,
    0xC014000000000000, 0xC016000000000000, 0xC018000000000000, 0xC01A000000000000,
    0xC01C000000000000, 0xC01E000000000000, 0xC020000000000000, 0xC021000000000000,
    0xC022000000000000, 0xC023000000000000, 0xC024000000000000 }

/// Coefficient tables of lgamma (F64 bits), generated from lgamma.c. Layout (offset, count):
/// DB 0 57, ACC_C0 57 68, ACC_B 125 60, then per root region k = 0..16 the root x0
/// (3 entries) and its coefficients RC_k (at CM_F64_LGAMMA_RG_X0 / _RG_C), OFFS 1068 19,
/// CL 1087 152, CH 1239 190, SMALL_C0 1429 8, SMALL_Q 1437 8, ASYM_C 1445 4,
/// ASYM_Q 1449 5, H1 1454 99, H2 1553 99, LOGDA_C 1652 18, STPI 1670 130, SPA_C 1800 10,
/// SPA_S 1810 12, ASA_C1 1822 16, ASA_C2 1838 24, ASA_C3 1862 56. DB holds (x, f, df) triples
/// sorted by x, the polynomial tables (high, low) pairs, H1 and H2 (low, middle, high) triples, and
/// STPI (low, high) pairs.
