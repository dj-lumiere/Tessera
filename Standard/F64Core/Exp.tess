// Tessera stdlib: the correctly rounded exponential e^x of F64
//
// x = (k + h) ln(2) / 2^12 with k an integer: 2^(k/2^12) as a double-double
// from two 64-entry tables, e^h from a short polynomial. When that can't
// decide the rounding, a triple-double reduction and a degree-6
// double-double polynomial redo it, and a few arguments too close to a
// rounding boundary even for that are looked up. Round to nearest only:
// overflow gives +inf, underflow a correctly rounded subnormal or +0, NaN
// comes back quiet.
//
// The double-double helpers and the 2^(i/2^6), 2^(i/2^12) tables of this file
// are shared with exp2 and expm1 (and exp10).
//
// Ported from CORE-MATH, src/binary64/exp/exp.c via RazorForge's B64Exp.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Double-double coefficients (high, low) of the degree-6 polynomial of the
/// accurate path, as F64 bits.
preset CM_F64_EXP_ACC_CH: @Array<U64, 14> <- { 0x3FF0000000000000, 0x0000000000000000,
    0x3FE0000000000000, 0x39C712F72ECEC2CF, 0x3FC5555555555555, 0x3C65555555554D07,
    0x3FA5555555555555, 0x3C455194D28275DA, 0x3F81111111111111, 0x3C012FAA0E1C0F7B,
    0x3F56C16C16DA6973, 0xBBF4BA45AB25D2A3, 0x3F2A01A019EB7F31, 0xBBC9091D845ECD36 }

/// The arguments (sorted bits) whose e^x is too close to a rounding boundary
