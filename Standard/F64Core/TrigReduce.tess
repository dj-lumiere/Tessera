// Tessera stdlib: argument reduction and kernels shared by the accurate paths of the correctly rounded F64 cosine
// and tangent
//
// Both reduce x to x/(2pi) mod 1 = i/2^11 + X with 0 <= X < 2^-11 in 128-bit floating point ("dints"): an exact
// reduction against a 1280-bit 1/(2pi) table (Payne-Hanek), then degree-11/10 polynomials and 128-bit
// sin2pi/cos2pi tables. Their fast paths are the sine's (Sin.tess), which has its own reduction and tables.
//
// Ported from CORE-MATH, src/binary64/cos/cos.c and src/binary64/tan/tan.c via RazorForge's B64TrigReduce.rf.
// Copyright (c) 2022-2025 Paul Zimmermann and Tom Hubrecht
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// 1/(2pi) rounded down to 1280 bits: 1/(2pi) ~ sum of T[j] / 2^(64(j+1)).
preset CM_F64_TRIG_T: @Array<U64, 20> <- { 0x28be60db9391054a, 0x7f09d5f47d4d3770,
    0x36d8a5664f10e410, 0x7f9458eaf7aef158, 0x6dc91b8e909374b8, 0x1924bba82746487,
    0x3f877ac72c4a69cf, 0xba208d7d4baed121, 0x3a671c09ad17df90, 0x4e64758e60d4ce7d,
    0x272117e2ef7e4a0e, 0xc7fe25fff7816603, 0xfbcbc462d6829b47, 0xdb4d9fb3c9f2c26d,
    0xd3d18fd9a797fa8b, 0x5d49eeb1faf97c5e, 0xcf41ce7de294a4ba, 0x9afed7ec47e35742,
    0x1580cc11bf1edaea, 0xfc33ef0826bd0d87 }

