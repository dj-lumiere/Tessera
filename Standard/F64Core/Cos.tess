// Tessera stdlib: the correctly rounded cosine of F64
//
// The fast path is the sine's (Sin.tess) a quarter turn further: cos x = sin(x + pi/2), and the sine's reductions
// give x as k steps of pi/2^14 plus a remainder, so the cosine is the sine's double-double evaluation at k + 2^13
// with the same remainder. Its error bound holds for every k, so the sine's rounding test decides the cosine too.
// When it can't, the accurate path reduces |x| to x/(2pi) mod 1 = i/2^11 + X (TrigReduce.tess), folds it into
// [0, pi/4] by the symmetries of the cosine, and evaluates in 128-bit floating point. Five arguments that path
// still can't round have their results written out. Round to nearest only: infinities give the default NaN (sign
// bit set, as x86's 0/0), a NaN comes back quiet.
//
// The fast path is ported from CORE-MATH, src/binary64/sin/sin.c, the accurate path from src/binary64/cos/cos.c via
// RazorForge's B64Cos.rf.
// Copyright (c) 2022-2026 Paul Zimmermann and Tom Hubrecht and Alexei Sibidanov
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// The cosine of `me` (in radians), correctly rounded (to nearest). Infinities give the default NaN (sign bit
/// set, as x86's 0/0), and a NaN comes back quiet.
/// :returns: cos(`me`).
routine F64.cos(me: Me) -> Me
    shared ux : U64 = me.bits()
    shared ax : Me  = Me.from_bits(ux.bitand(0x7FFFFFFFFFFFFFFF))

    block entry()
        ebits   : U64  = ux.shr(52).bitand(0x7FF)
        special : Bool = ebits.eq(0x7FF)
        branch special
            ? special()
            : continue
        // |x| <= 0x1.6a09e667f3bccp-27: cos(x) rounds like 1 - x^2/2
        tiny : Bool = ax.bits().le(0x3E46A09E667F3BCC)
        branch tiny
            ? return(ax.mul_add(-0x1p-28, 1.0))
            : continue
        moderate : Bool = ebits.lt(1054)
        branch moderate
            ? moderate()
            : large()

    // an infinity gives the default NaN of an invalid operation, a NaN comes back quiet
    block special()
        inf : Bool = ux.shl(1).eq(0xFFE0000000000000)
        branch inf
            ? return(Me.from_bits(0xFFF8000000000000))
            : return(me.add(me))

    // |x| < 2^31, a quarter turn is 2^13 steps of pi/2^14
    block moderate()
        red  : CmF64SinReduced = cm_f64_sin_reduce_moderate(ax)
        f    : CmF64TrigDD     = cm_f64_sin_moderate_parts(red.k.add(0x2000), red.r)
        fl   : Me              = f.lo.sub(0x1.dep-64)
        lb   : Me              = f.hi.add(fl)
        ub   : Me              = f.hi.add(fl.add(0x1.dep-63))
        done : Bool            = ub.eq(lb)
        branch done
            ? return(lb)
            : return(cm_f64_cos_accurate(ax))

    // |x| >= 2^31
    block large()
        red  : CmF64SinReduced = cm_f64_sin_reduce_large(ax)
        f    : CmF64TrigDD     = cm_f64_sin_large_parts(red.k.add(0x2000), red.r)
        lb   : Me              = f.hi.add(f.lo.sub(0x1.41p-63))
        ub   : Me              = f.hi.add(f.lo.add(0x1.41p-63))
        done : Bool            = lb.eq(ub)
        branch done
            ? return(lb)
            : return(cm_f64_cos_accurate(ax))

/// The accurate path for x > 0x1.6a09e667f3bccp-27, in 128-bit floating point.
/// :param x: The argument, |x| of the caller.
/// :returns: cos(`x`), correctly rounded.
private routine cm_f64_cos_accurate(x: F64) -> F64
    shared red : CmF64TrigAccurate = cm_f64_trig_accurate_reduce(x)
    shared i   : U64               = red.i
    shared q   : U64               = red.quadrant
    // pi <= x < 2pi: cos(x) = -cos(x - pi), and pi/2 <= x < pi: cos(x) = -sin(x - pi/2)
    shared neg : U64 = q.bitand(1).bitxor(q.shr(1).bitand(1))

    block entry()
        is_cos : U64 = U64.bitxor(1, q.shr(1).bitand(1))
        // pi/4 <= x < pi/2: cos(x) = sin(pi/2 - x)
        is_cos2 : U64  = is_cos.bitxor(q.shr(2).bitand(1))
        is_sin  : Bool = is_cos2.eq(0)
        branch is_sin
            ? sine()
            : cosine()

    // sin2pi(R) ~ sin2pi(i/2^11) cos2pi(X) + cos2pi(i/2^11) sin2pi(X)
    block sine()
        u : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_s(i), red.cos)
        v : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_c(i), red.sin)
        jump decide(cm_f64_trig_dint_add(u, v))

    // cos2pi(R) ~ cos2pi(i/2^11) cos2pi(X) - sin2pi(i/2^11) sin2pi(X)
    block cosine()
        u : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_c(i), red.cos)
        v : CmF64TrigDint = cm_f64_trig_dint_mul(cm_f64_trig_s(i), red.sin)
        jump decide(cm_f64_trig_dint_add(u, cm_f64_trig_dint_neg(v)))

    // the total error is below 41 ulps of the low word: check the upper 54 bits are determined
    block decide(u: CmF64TrigDint)
        decided : Bool = cm_f64_trig_is_rounding_decided(u.r, 41)
        branch decided
            ? round(u)
            : continue
        hard1 : Bool = x.eq(0x1.8000000000009p-23)
        hard2 : Bool = x.eq(0x1.8000000000024p-22)
        hard3 : Bool = x.eq(0x1.800000000009p-21)
        hard4 : Bool = x.eq(0x1.20000000000f3p-20)
        hard5 : Bool = x.eq(0x1.800000000024p-20)
        when
            hard1 -> return(F64.add(0x1.fffffffffff7p-1, 0x1.b56666666666cp-143))
            hard2 -> return(F64.add(0x1.ffffffffffdcp-1, 0x1.b56666666667ep-137))
            hard3 -> return(F64.add(0x1.ffffffffff7p-1, 0x1.b5666666666c4p-131))
            hard4 -> return(F64.add(0x1.fffffffffebcp-1, 0x1.37642666666fdp-127))
            hard5 -> return(F64.add(0x1.fffffffffdcp-1, 0x1.b5666666667ddp-125))
            else  -> round(u)

    block round(u: CmF64TrigDint)
        flip : Bool = neg.ne(0)
        branch flip
            ? return(CmF64TrigDint.to<F64>(cm_f64_trig_dint_neg(u)))
            : return(u.to<F64>())
