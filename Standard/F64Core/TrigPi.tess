/// sin(pi s/2048) and cos(pi s/2048) as double-doubles.
record CmF64TrigPiSinCos
    sh : F64
    sl : F64
    ch : F64
    cl : F64

/// The angle s/2048 (only the low 12 bits of s matter) as a table index ks of sin(pi ks/64), its complement kc
/// (cos(pi ks/64) = sin(pi kc/64)), and an index jm of the pi j/2048 tables: s/2048 = +-(ks/64 + jm/2048) folded
/// into a quarter turn, with the signs of the sine and cosine as the bits ss and sc.
private record CmF64TrigPiAngle
    ks : USize
    kc : USize
    jm : USize
    ss : Bool
    sc : Bool

/// (xh + xl) + (ch + cl) as a double-double.
routine cm_f64_trig_pi_adddd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64TrigDD
    block entry()
        s     : F64 = xh.add(ch)
        d     : F64 = s.sub(xh)
        error : F64 = ch.sub(d).add(xh.add(d.sub(s)))
        return(CmF64TrigDD { hi: s, lo: error.add(xl.add(cl)) })

/// (xh + xl) (ch + cl) as a double-double, the cross terms added before the final Fast2Sum.
routine cm_f64_trig_pi_muldd(xh: F64, xl: F64, ch: F64, cl: F64) -> CmF64TrigDD
    block entry()
        ahlh : F64 = ch.mul(xl)
        alhh : F64 = cl.mul(xh)
        ahhh : F64 = ch.mul(xh)
        ahhl : F64 = ch.mul_add(xh, ahhh.neg())
        low  : F64 = ahhl.add(alhh.add(ahlh))
        return(cm_f64_trig_fast_two_sum(ahhh, low))

/// (xh + xl) c as a double-double.
routine cm_f64_trig_pi_mulddd(xh: F64, xl: F64, c: F64) -> CmF64TrigDD
    block entry()
        ahlh : F64 = c.mul(xl)
        ahhh : F64 = c.mul(xh)
        ahhl : F64 = c.mul_add(xh, ahhh.neg()).add(ahlh)
        h    : F64 = ahhh.add(ahhl)
        return(CmF64TrigDD { hi: h, lo: ahhh.sub(h).add(ahhl) })

/// The first step of a double-double Horner evaluation: the top coefficient c0 + c1 plus the tail l, already
/// evaluated in double precision.
routine cm_f64_trig_pi_poly_start(c0: F64, c1: F64, l: F64) -> CmF64TrigDD
    block entry()
        h : F64 = c0.add(l)
        return(CmF64TrigDD { hi: h, lo: c0.sub(h).add(l).add(c1) })

/// One double-double Horner step: p (xh + xl) + (c0 + c1).
routine cm_f64_trig_pi_poly_step(xh: F64, xl: F64, p: CmF64TrigDD, c0: F64, c1: F64) -> CmF64TrigDD
    block entry()
        q  : CmF64TrigDD = cm_f64_trig_pi_muldd(xh, xl, p.hi, p.lo)
        th : F64         = q.hi.add(c0)
        tl : F64         = c0.sub(th).add(q.hi)
        return(CmF64TrigDD { hi: th, lo: q.lo.add(tl.add(c1)) })

/// The CmF64TrigPiAngle of the angle index s.
private routine cm_f64_trig_pi_angle(s: U64) -> CmF64TrigPiAngle
    block entry()
        low      : U64  = s.bitand(0x3FF)
        mirrored : Bool = s.shr(10).bitand(1).eq(1)
        j        : U64  = mirrored
            ? U64.sub(1024, low)
            : low
        ks        : USize = j.shr(5).to<USize>()
        kc        : USize = USize.sub(32, ks)
        jm        : USize = j.bitand(0x1F).to<USize>()
        ss        : Bool  = s.shr(11).bitand(1).eq(1)
        next_half : U64   = s.add_wrap(1024)  // the angle plus a quarter turn
        sc        : Bool  = next_half.shr(11).bitand(1).eq(1)
        return(CmF64TrigPiAngle { ks: ks, kc: kc, jm: jm, ss: ss, sc: sc })

/// The signs of the angle applied to a sine and a cosine double-double.
private routine cm_f64_trig_pi_signed(a: CmF64TrigPiAngle, ts: CmF64TrigDD,
    tc: CmF64TrigDD) -> CmF64TrigPiSinCos
    block entry()
        sh : F64 = a.ss
            ? ts.hi.neg()
            : ts.hi
        sl : F64 = a.ss
            ? ts.lo.neg()
            : ts.lo
        ch : F64 = a.sc
            ? tc.hi.neg()
            : tc.hi
        cl : F64 = a.sc
            ? tc.lo.neg()
            : tc.lo
        return(CmF64TrigPiSinCos { sh: sh, sl: sl, ch: ch, cl: cl })

/// The F64 at index i of a table.
private routine cm_f64_trig_pi_at(table: @Array<U64, 66>, i: USize) -> F64
    block entry()
        return(F64.from_bits(table.getitem(i)))

/// The F64 at index i of a 64-entry table.
private routine cm_f64_trig_pi_at(table: @Array<U64, 64>, i: USize) -> F64
    block entry()
        return(F64.from_bits(table.getitem(i)))

/// sin(pi s/2048) and cos(pi s/2048) to about 2^-75, from the angle index s (only its low 12 bits matter).
routine cm_f64_trig_pi_sincos(s: U64) -> CmF64TrigPiSinCos
    block entry()
        a   : CmF64TrigPiAngle = cm_f64_trig_pi_angle(s)
        sbh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN, a.ks.mul(2))
        sbl : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN, a.ks.mul(2).add(1))
        cbh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN, a.kc.mul(2))
        cbl : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN, a.kc.mul(2).add(1))
        slh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SM, a.jm.mul(2))
        sll : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SM, a.jm.mul(2).add(1))
        clh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_CM, a.jm.mul(2))
        cll : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_CM, a.jm.mul(2).add(1))
        sb  : F64              = sbh.add(sbl)
        cb  : F64              = cbh.add(cbl)
        // cos(b + l) = cb cl - sb sl and sin(b + l) = sb cl + cb sl, the high parts exact
        bch : F64         = cbh.mul(clh).sub(sbh.mul(slh))
        bc1 : F64         = clh.mul(cbl).sub(slh.mul(sbl))
        bcl : F64         = bc1.add(cb.mul(cll)).sub(sb.mul(sll))
        bsh : F64         = sbh.mul(clh).add(cbh.mul(slh))
        bs1 : F64         = slh.mul(cbl).add(clh.mul(sbl))
        bsl : F64         = bs1.add(cb.mul(sll)).add(sb.mul(cll))
        tch : F64         = bch.add(bcl)
        tsh : F64         = bsh.add(bsl)
        tc  : CmF64TrigDD = { hi: tch, lo: bch.sub(tch).add(bcl) }
        ts  : CmF64TrigDD = { hi: tsh, lo: bsh.sub(tsh).add(bsl) }
        return(cm_f64_trig_pi_signed(a, ts, tc))

/// sin(pi s/2048) and cos(pi s/2048) to double-double accuracy, from the angle index s (only its low 12 bits
/// matter).
routine cm_f64_trig_pi_sincos2(s: U64) -> CmF64TrigPiSinCos
    block entry()
        a   : CmF64TrigPiAngle = cm_f64_trig_pi_angle(s)
        sbh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN2, a.ks.mul(2))
        sbl : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN2, a.ks.mul(2).add(1))
        cbh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN2, a.kc.mul(2))
        cbl : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SN2, a.kc.mul(2).add(1))
        slh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SM2, a.jm.mul(2))
        sll : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_SM2, a.jm.mul(2).add(1))
        clh : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_CM2, a.jm.mul(2))
        cll : F64              = cm_f64_trig_pi_at(CM_F64_TRIG_PI_CM2, a.jm.mul(2).add(1))
        // with the second table holding 1 - cos(l): cos(b + l) = cb - (cb (1 - cos l) + sb sin l) and
        // sin(b + l) = sb - (sb (1 - cos l) - cb sin l)
        cc  : CmF64TrigDD = cm_f64_trig_pi_muldd(clh, cll, cbh, cbl)
        sn  : CmF64TrigDD = cm_f64_trig_pi_muldd(slh, sll, sbh, sbl)
        cs  : CmF64TrigDD = cm_f64_trig_pi_muldd(clh, cll, sbh, sbl)
        scp : CmF64TrigDD = cm_f64_trig_pi_muldd(slh, sll, cbh, cbl)
        dc  : CmF64TrigDD = cm_f64_trig_fast_two_sum(sn.hi, cc.hi)
        dcl : F64         = dc.lo.add(cc.lo.add(sn.lo))
        ds  : CmF64TrigDD = cm_f64_trig_fast_two_sum(scp.hi.neg(), cs.hi)
        dsl : F64         = ds.lo.add(cs.lo.sub(scp.lo))
        tc  : CmF64TrigDD = cm_f64_trig_fast_two_sum(cbh, dc.hi.neg())
        ts  : CmF64TrigDD = cm_f64_trig_fast_two_sum(sbh, ds.hi.neg())
        c   : CmF64TrigDD = { hi: tc.hi, lo: cbl.sub(dcl).add(tc.lo) }
        s2  : CmF64TrigDD = { hi: ts.hi, lo: sbl.sub(dsl).add(ts.lo) }
        return(cm_f64_trig_pi_signed(a, s2, c))

/// The accurate phase shared by sin_pi and cos_pi: the sine of the angle iq/2048 + z 2^-75 half turns, as an
/// unevaluated double-double (iq in 0..4096, z the scaled residual angle).
routine cm_f64_trig_pi_refine(iq: U64, z: F64) -> CmF64TrigDD
    block entry()
        x   : F64               = z.mul(0x1p-63)
        x2  : F64               = x.mul(x)
        dx2 : F64               = x.mul_add(x, x2.neg())
        sll : F64               = F64.mul(-0x1.32d2cc920dcb4p-73, x2)
        sp0 : CmF64TrigDD       = cm_f64_trig_pi_poly_start(0x1.466bc6775aae1p-47,
            -0x1.9c3c168d990ap-114, sll)
        sp1 : CmF64TrigDD       = cm_f64_trig_pi_poly_step(x2, dx2, sp0, -0x1.4abbce625be53p-22,
            0x1.05511cbc65743p-76)
        sp2 : CmF64TrigDD       = cm_f64_trig_pi_poly_step(x2, dx2, sp1, 0x1.921fb54442d18p+1,
            0x1.1a62633145c06p-53)
        sl  : CmF64TrigDD       = cm_f64_trig_pi_mulddd(sp2.hi, sp2.lo,
            x.mul(0x1p-12))  // sin(pi x 2^-12)
        cl2 : F64               = F64.add(-0x1.55d3c7e3cbff9p-72,
            F64.mul(0x1.e1f50604fa0ffp-99, x2))
        cll : F64               = x2.mul(cl2)
        cp0 : CmF64TrigDD       = cm_f64_trig_pi_poly_start(0x1.03c1f081b5ac4p-46,
            -0x1.32b33fda9113cp-100, cll)
        cp1 : CmF64TrigDD       = cm_f64_trig_pi_poly_step(x2, dx2, cp0, -0x1.3bd3cc9be45dep-22,
            -0x1.692b71366cc04p-76)
        cl  : CmF64TrigDD       = cm_f64_trig_pi_muldd(cp1.hi, cp1.lo, x2,
            dx2)  // cos(pi x 2^-12) - 1
        b   : CmF64TrigPiSinCos = cm_f64_trig_pi_sincos2(iq)
        cs  : CmF64TrigDD       = cm_f64_trig_pi_muldd(cl.hi, cl.lo, b.sh, b.sl)
        sc  : CmF64TrigDD       = cm_f64_trig_pi_muldd(sl.hi, sl.lo, b.ch, b.cl)
        ts  : CmF64TrigDD       = cm_f64_trig_fast_two_sum(sc.hi, cs.hi)
        tsl : F64               = ts.lo.add(cs.lo.add(sc.lo))
        ts2 : CmF64TrigDD       = cm_f64_trig_fast_two_sum(b.sh, ts.hi)
        low : F64               = b.sl.add(tsl).add(ts2.lo)
        return(CmF64TrigDD { hi: ts2.hi, lo: low })

/// Whether the low part of the accurate phase has a mantissa of all zeros or all ones: the only case where
/// high + low may round wrongly, so the list of exceptions must be consulted.
routine cm_f64_trig_pi_refine_suspect(tsl: F64) -> Bool
    block entry()
        t    : U64  = tsl.bits()
        ones : Bool = t.bitor(0xFFF0000000000000).eq(0xFFFFFFFFFFFFFFFF)
        zero : Bool = t.shl(12).eq(0)
        return(ones.bitor(zero))
