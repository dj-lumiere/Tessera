// Tessera stdlib: the correctly rounded cube root of F64
//
// x = ±2^(3 et + it) z with 1 <= z < 2: a cubic polynomial gives cbrt(z) to
// about 13 bits, a cubic Newton step triples that, and a linear Newton step
// with y^3 in double-double arithmetic lands within half an ulp. When the
// correction sits too close to a rounding boundary, one more step settles it
// (with two inputs known to need more), and an exact cube root has its
// rounding noise cleared. Round to nearest only: ±0, ±inf and NaN map to
// themselves (NaN comes back quiet), and cbrt(-x) = -cbrt(x).
//
// Ported from CORE-MATH, src/binary64/cbrt/cbrt.c via RazorForge's B64Cbrt.rf.
// Copyright (c) 2021-2022 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// The cube root of `me`, correctly rounded.
/// :returns: The cube root.
routine F64.cbrt(me: Me) -> Me
    shared hx    : U64 = me.bits()
    shared sign  : U64 = hx.shr(63)
    shared mant  : U64 = hx.bitand(0x000FFFFFFFFFFFFF)
    shared ebits : U64 = hx.shr(52).bitand(0x7FF)
    shared e     : S64 = ebits.to<S64>()

    block entry()
        edge : Bool = e.eq(0).bitor(e.eq(0x7FF))
        branch edge
            ? edge()
            : reduce(mant, e)

    // ±0, subnormals, ±inf and NaN
    block edge()
        ix      : U64  = hx.bitand(0x7FFFFFFFFFFFFFFF)
        special : Bool = e.eq(0x7FF).bitor(ix.eq(0))
        branch special  // x + x also quiets a signaling NaN
            ? return(me.add(me))
            : continue
        // subnormal: normalize the mantissa
        nz : U64 = ix.leading_zeros().sub(11)
        jump reduce(mant.shl(nz).bitand(0x000FFFFFFFFFFFFF), e.sub(nz.to<S64>().sub(1)))

    // 2^(3 et + it) <= |x| < 2^(3 et + it + 1) with 0 <= it <= 2 (et biased)
    block reduce(mant_norm: U64, e_norm: S64)
        eb   : S64 = e_norm.add(3072)
        cvt1 : U64 = mant_norm.bitor(0x3FF0000000000000)
        et   : S64 = eb.div(3)
        it   : S64 = eb.mod(3)
        // cbrt(x) = cbrt(zz) 2^(et-1365) where 1 <= |zz| < 8
        zz : Me = Me.from_bits(cvt1.add(it.to_wrap<U64>().shl(52)).bitor(sign.shl(63)))
        // cbrt(zz) = cbrt(z) isc, where isc is ±1, ±2^(1/3) or ±2^(2/3), and 1 <= z < 2
        escale : Me = cm_cbrt_escale(it)
        isc    : Me = Me.from_bits(escale.bits().bitor(sign.shl(63)))
        z      : Me = Me.from_bits(cvt1)
        r      : Me = Me.div(1.0, z)
        rr     : Me = r.mul(cm_f64_cbrt_rsc(it, sign))
        z2     : Me = z.mul(z)
        c0     : Me = Me.add(0x1.1b0babccfef9cp-1, z.mul(0x1.2c9a3e94d1da5p-1))
        c2     : Me = Me.add(-0x1.4dc30b1a1ddbap-3, z.mul(0x1.7a8d3e4ec9b07p-6))
        // c0 + c1 z + c2 z^2 + c3 z^3 approximates z^(1/3) on [1, 2] with error < 9.2e-5
        y0  : Me = c0.add(z2.mul(c2))
        y02 : Me = y0.mul(y0)
        h0  : Me = y02.mul(y0.mul(r)).sub(1.0)
        // a cubic variant of Newton's method on f(y) = 1 - z/y^3
        k  : Me = Me.sub(0x1.5555555555555p-2, Me.mul(0x1.c71c71c71c71cp-3, h0))
        yz : Me = y0.sub(h0.mul(y0).mul(k))
        y  : Me = yz.mul(isc)
        // one more (linear) Newton iteration, with y^3 computed to about 106 bits
        y2    : Me = y.mul(y)
        y2l   : Me = f64_mul_error(y, y, y2)
        y3    : Me = y2.mul(y)
        y3l   : Me = f64_mul_error(y, y2, y3).add(y.mul(y2l))
        resid : Me = y3.sub(zz).add(y3l)
        h     : Me = resid.mul(rr)
        dy0   : Me = h.mul(y.mul(0x1.5555555555555p-2))
        y1    : Me = y.sub(dy0)
        dy    : Me = y.sub(y1).sub(dy0)
        // the cube root is now y1 + dy with |dy| < 1/2 ulp(y1): rounding is hard only when dy is close to
        // 1/2 ulp or 3/2 ulp
        hard : Bool = cm_f64_cbrt_is_near_boundary(dy, 0x1p-75)
        branch hard
            ? refine(y1, zz, rr, et)
            : assemble(y1, dy, zz, et)

    block refine(y1: Me, zz: Me, rr: Me, et: S64)
        y2    : Me   = y1.mul(y1)
        y2l   : Me   = f64_mul_error(y1, y1, y2)
        y3    : Me   = y2.mul(y1)
        y3l   : Me   = f64_mul_error(y1, y2, y3).add(y1.mul(y2l))
        resid : Me   = y3.sub(zz).add(y3l)
        h     : Me   = resid.mul(rr)
        dy0   : Me   = h.mul(y1.mul(0x1.5555555555555p-2))
        y     : Me   = y1.sub(dy0)
        dy    : Me   = y1.sub(y).sub(dy0)
        hard  : Bool = cm_f64_cbrt_is_near_boundary(dy, 0x1p-98)
        branch hard
            ? known(y, dy, zz, et)
            : assemble(y, dy, zz, et)

    // two inputs whose cube root lies within 2^-98 of a rounding boundary
    block known(y1: Me, dy: Me, zz: Me, et: S64)
        azz    : Me   = zz.abs()
        first  : Bool = azz.eq(0x1.9b78223aa307cp+1)
        second : Bool = azz.eq(0x1.a202bfc89ddffp+2)
        when
            first  -> assemble(Me.copysign(0x1.79d15d0e8d59cp+0, zz), dy, zz, et)
            second -> assemble(Me.copysign(0x1.de87aa837820fp+0, zz), dy, zz, et)
            else   -> assemble(y1, dy, zz, et)

    block assemble(y1: Me, dy: Me, zz: Me, et: S64)
        out_e : S64 = et.sub(342).sub(1023)
        bits  : U64 = y1.bits().add_wrap(out_e.to_wrap<U64>().shl(52))
        // exact cube roots have the low 34 mantissa bits all 0 or all 1
        m0    : U64  = bits.shl(30)
        m0neg : Bool = m0.shr(63).eq(1)
        m1    : U64  = m0neg
            ? m0.bitnot()
            : m0
        close : Bool = m1.le(U64.shl(1, 30))
        branch close
            ? exact(bits, y1, dy, zz)
            : return(Me.from_bits(bits))

    // a cube root that may be exact: round the last bits away
    block exact(bits: U64, y1: Me, dy: Me, zz: Me)
        rounded_bits : U64  = y1.bits().add_wrap(U64.shl(1, 15))
        cvt4         : Me   = Me.from_bits(rounded_bits.bitand(0xFFFFFFFFFFFF0000))
        diff         : Me   = cvt4.sub(y1).sub(dy)
        tight        : Bool = diff.abs().lt(0x1p-60)
        one          : Bool = zz.abs().eq(1.0)
        clear        : Bool = tight.bitor(one)
        branch clear
            ? return(Me.from_bits(bits.add_wrap(U64.shl(1, 15)).bitand(0xFFFFFFFFFFFF0000)))
            : return(Me.from_bits(bits))

/// Whether the correction dy lies within tol of 1/2 ulp or 3/2 ulp of the
/// approximation (ulp 2^-52 on [1, 2)).
/// :param dy: The correction.
/// :param tol: The tolerance.
/// :returns: True when |`dy`| is within `tol` of 2^-53 or of 3 2^-53.
private routine cm_f64_cbrt_is_near_boundary(dy: F64, tol: F64) -> Bool
    block entry()
        ady  : F64 = dy.abs()
        ady0 : F64 = ady.sub(0x1p-53).abs()
        ady1 : F64 = ady.sub(0x1.8p-52).abs()  // 0x1p-52 + 0x1p-53
        return(ady0.lt(tol).bitor(ady1.lt(tol)))

/// The scale 2^(it/3) of the cube root reduction, for it in 0..2.
/// :param it: 0, 1 or 2 (anything above 1 is taken as 2).
/// :returns: 2^(`it`/3).
internal routine cm_cbrt_escale(it: S64) -> F64
    block entry()
        when it
            0    -> return(1.0)
            1    -> return(0x1.428a2f98d728bp+0)
            else -> return(0x1.965fea53d6e3dp+0)

/// The reciprocal scale ±2^-it applied to 1/z, for it in 0..2, negated when
/// the sign bit is 1.
/// :param it: 0, 1 or 2.
/// :param sign: The sign bit, 0 or 1.
/// :returns: ±2^-`it`.
private routine cm_f64_cbrt_rsc(it: S64, sign: U64) -> F64
    block entry()
        magnitude : F64  = cm_f64_cbrt_rsc_magnitude(it)
        negative  : Bool = sign.eq(1)
        branch negative
            ? return(magnitude.neg())
            : return(magnitude)

/// The magnitude 2^-it of {cm_f64_cbrt_rsc}, for it in 0..2.
/// :param it: 0, 1 or 2 (anything above 1 is taken as 2).
/// :returns: 1, 0.5 or 0.25.
private routine cm_f64_cbrt_rsc_magnitude(it: S64) -> F64
    block entry()
        when it
            0    -> return(1.0)
            1    -> return(0.5)
            else -> return(0.25)
