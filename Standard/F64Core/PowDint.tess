// Tessera stdlib: 128-bit floating-point arithmetic for the second phase of the F64 power x^y
//
// A CmF64PowDint is (-1)^sgn r 2^(ex - 127), with the top bit of r set when normalized (the C dint64_t). The
// second phase computes exp(y log(x)) with it to a relative error below 2^-117.
//
// Ported from CORE-MATH, src/binary64/pow/pow.c and dint.h via RazorForge's B64Pow.rf.
// Copyright (c) 2022-2025 CERN and Inria
// Authors: Tom Hubrecht and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// A 128-bit floating-point value (-1)^sgn r 2^(ex - 127).
record CmF64PowDint
    r   : U128
    ex  : S64
    sgn : U64

/// The upper 64 bits of v.
routine cm_f64_pow_hi(v: U128) -> U64
    block entry()
        return(v.shr(64).to_wrap<U64>())

/// The lower 64 bits of v.
routine cm_f64_pow_lo(v: U128) -> U64
    block entry()
        return(v.to_wrap<U64>())

/// hi 2^64 + lo.
routine cm_f64_pow_join(hi: U64, lo: U64) -> U128
    block entry()
        hi_part : U128 = hi.to<U128>().shl(64)
        return(hi_part.bitor(lo.to<U128>()))

/// The zero CmF64PowDint.
private routine cm_f64_pow_dint_zero() -> CmF64PowDint
    block entry()
        return(CmF64PowDint { r: 0, ex: -1076, sgn: 0 })

/// Compares |a| and |b|: -1, 0 or 1.
routine cm_f64_pow_cmp_dint_abs(a: CmF64PowDint, b: CmF64PowDint) -> S64
    block entry()
        a_zero : Bool = cm_f64_pow_hi(a.r).eq(0)
        b_zero : Bool = cm_f64_pow_hi(b.r).eq(0)
        both   : Bool = a_zero.bitand(b_zero)
        by_ex  : S32  = a.ex.compare(b.ex)
        by_r   : S32  = a.r.compare(b.r)
        c      : S32  = by_ex.ne(0)
            ? by_ex
            : by_r
        when
            both   -> return(0)
            a_zero -> return(-1)
            b_zero -> return(1)
            else   -> return(c.to<S64>())

/// Compares |a| and |b| using only their upper limbs: -1, 0 or 1.
private routine cm_f64_pow_cmp_dint_11(a: CmF64PowDint, b: CmF64PowDint) -> S64
    block entry()
        by_ex : S32 = a.ex.compare(b.ex)
        by_r  : S32 = cm_f64_pow_hi(a.r).compare(cm_f64_pow_hi(b.r))
        c     : S32 = by_ex.ne(0)
            ? by_ex
            : by_r
        return(c.to<S64>())

/// a + b with error below 2 ulps (exact in the Sterbenz case).
routine cm_f64_pow_add_dint(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    block entry()
        a_zero : Bool = a.r.eq(0)
        branch a_zero
            ? return(b)
            : continue
        c   : S64  = cm_f64_pow_cmp_dint_abs(a, b)
        tie : Bool = c.eq(0)
        branch tie
            ? tie()
            : continue
        swap : Bool         = c.lt(0)
        aa   : CmF64PowDint = swap
            ? b
            : a
        bb : CmF64PowDint = swap
            ? a
            : b
        k      : U64  = aa.ex.sub_wrap(bb.ex).to_wrap<U64>()
        big_b  : U128 = bb.r.shr(k.to<U128>())
        differ : Bool = aa.sgn.ne(bb.sgn)
        branch differ
            ? subtract(aa, bb, big_b, k)
            : add(aa, big_b)

    block tie()
        differ : Bool = a.sgn.ne(b.sgn)
        branch differ
            ? return(cm_f64_pow_dint_zero())
            : return(CmF64PowDint { r: a.r, ex: a.ex.add(1), sgn: a.sgn })

    block subtract(aa: CmF64PowDint, bb: CmF64PowDint, big_b: U128, k: U64)
        cc     : U128 = aa.r.sub_wrap(big_b)
        ex     : U64  = cc.leading_zeros().to_wrap<U64>()
        renorm : Bool = ex.gt(0)
        branch renorm
            ? renormalize(aa, bb, big_b, k, ex)
            : finish(cc, 0, aa.ex, aa.sgn)

    // redo the subtraction with both operands shifted left by ex, so that no bit of b is lost
    block renormalize(aa: CmF64PowDint, bb: CmF64PowDint, big_b: U128, k: U64, ex: U64)
        shifted_a : U128 = aa.r.shl(ex.to<U128>())
        near      : Bool = k.eq(1)
        shifted_b : U128 = near
            ? bb.r.shl(ex.sub(1).to<U128>())
            : big_b.shl(ex.to<U128>())
        cc : U128 = shifted_a.sub_wrap(shifted_b)
        jump finish(cc, cm_f64_pow_hi(cc).leading_zeros(), aa.ex.sub(ex.to<S64>()), aa.sgn)

    block finish(cc: U128, ex: U64, rex: S64, sgn: U64)
        return(CmF64PowDint { r: cc.shl(ex.to<U128>()), ex: rex.sub(ex.to<S64>()), sgn: sgn })

    block add(aa: CmF64PowDint, big_b: U128)
        cc    : U128 = aa.r.add_wrap(big_b)
        carry : Bool = cc.lt(aa.r)
        branch carry
            ? return(CmF64PowDint { r: U128.shl(1, 127).bitor(cc.shr(1)), ex: aa.ex.add(1),
                sgn: aa.sgn })
            : return(CmF64PowDint { r: cc, ex: aa.ex, sgn: aa.sgn })

/// a + b using only the upper limbs of a and b, with error below 2 ulps (64-bit ulps). The lower limb of the
/// result keeps the lower limb of b, as the C code (which writes into b) does.
private routine cm_f64_pow_add_dint_11(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    block entry()
        a_zero : Bool = cm_f64_pow_hi(a.r).eq(0)
        b_zero : Bool = cm_f64_pow_hi(b.r).eq(0)
        when
            a_zero -> return(b)
            b_zero -> return(a)
            else   -> compare()

    block compare()
        stale : U64  = cm_f64_pow_lo(b.r)
        c     : S64  = cm_f64_pow_cmp_dint_11(a, b)
        tie   : Bool = c.eq(0)
        branch tie
            ? tie()
            : continue
        swap : Bool         = c.lt(0)
        aa   : CmF64PowDint = swap
            ? b
            : a
        bb : CmF64PowDint = swap
            ? a
            : b
        big_a : U64  = cm_f64_pow_hi(aa.r)
        apart : Bool = aa.ex.gt(bb.ex)
        k     : U64  = apart
            ? aa.ex.sub_wrap(bb.ex).to_wrap<U64>()
            : 0
        big_b  : U64  = cm_f64_pow_hi(bb.r).shr(k)
        differ : Bool = aa.sgn.ne(bb.sgn)
        branch differ
            ? subtract(big_a, big_b, aa.ex, aa.sgn, stale)
            : add(big_a, big_b, aa.ex, aa.sgn, stale)

    block tie()
        differ : Bool = a.sgn.ne(b.sgn)
        branch differ
            ? return(cm_f64_pow_dint_zero())
            : return(CmF64PowDint { r: a.r, ex: a.ex.add(1), sgn: a.sgn })

    block subtract(big_a: U64, big_b: U64, rex: S64, sgn: U64, stale: U64)
        cc     : U64  = big_a.sub_wrap(big_b)
        ex     : U64  = cc.leading_zeros()
        renorm : Bool = ex.gt(0)
        branch renorm
            ? renormalize(big_a, big_b, ex, rex, sgn, stale)
            : finish(cc, 0, rex, sgn, stale)

    block renormalize(big_a: U64, big_b: U64, ex: U64, rex: S64, sgn: U64, stale: U64)
        cc : U64 = big_a.shl(ex).sub_wrap(big_b.shl(ex))
        jump finish(cc, cc.leading_zeros(), rex.sub(ex.to<S64>()), sgn, stale)

    block finish(cc: U64, ex: U64, rex: S64, sgn: U64, stale: U64)
        r : U128 = cm_f64_pow_join(cc.shl(ex), stale)
        return(CmF64PowDint { r: r, ex: rex.sub(ex.to<S64>()), sgn: sgn })

    block add(big_a: U64, big_b: U64, rex: S64, sgn: U64, stale: U64)
        cc    : U64  = big_a.add_wrap(big_b)
        carry : Bool = cc.lt(big_a)
        hi    : U64  = carry
            ? cc.shr(1).bitor(0x8000000000000000)
            : cc
        ex : S64 = carry
            ? rex.add(1)
            : rex
        return(CmF64PowDint { r: cm_f64_pow_join(hi, stale), ex: ex, sgn: sgn })

/// Normalizes a 128-bit product whose top bit is at position 126 or 127.
private routine cm_f64_pow_dint_norm(r: U128, ex: S64, sgn: U64) -> CmF64PowDint
    block entry()
        top : Bool = r.shr(127).ne(0)
        rr  : U128 = top
            ? r
            : r.shl(1)
        rex : S64 = top
            ? ex.add(1)
            : ex
        return(CmF64PowDint { r: rr, ex: rex, sgn: sgn })

/// a b with error below 6 ulps.
private routine cm_f64_pow_mul_dint(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    block entry()
        bh : U64  = cm_f64_pow_hi(b.r)
        bl : U64  = cm_f64_pow_lo(b.r)
        ah : U64  = cm_f64_pow_hi(a.r)
        m1 : U128 = ah.mul_wide(bl)
        m2 : U128 = cm_f64_pow_lo(a.r).mul_wide(bh)
        r0 : U128 = ah.mul_wide(bh)
        r  : U128 = r0.add_wrap(m1.shr(64).add_wrap(m2.shr(64)))
        return(cm_f64_pow_dint_norm(r, a.ex.add(b.ex), a.sgn.bitxor(b.sgn)))

/// a b assuming the lower limb of b is zero, with error below 2 ulps.
routine cm_f64_pow_mul_dint_21(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    block entry()
        bh : U64  = cm_f64_pow_hi(b.r)
        hi : U128 = cm_f64_pow_hi(a.r).mul_wide(bh)
        lo : U128 = cm_f64_pow_lo(a.r).mul_wide(bh)
        return(cm_f64_pow_dint_norm(hi.add_wrap(lo.shr(64)), a.ex.add(b.ex), a.sgn.bitxor(b.sgn)))

/// a b using only the upper limbs of a and b (exact).
private routine cm_f64_pow_mul_dint_11(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    block entry()
        r : U128 = cm_f64_pow_hi(a.r).mul_wide(cm_f64_pow_hi(b.r))
        return(cm_f64_pow_dint_norm(r, a.ex.add(b.ex), a.sgn.bitxor(b.sgn)))

/// a b for an integer b, with error below 1 ulp.
private routine cm_f64_pow_mul_dint_int64(a: CmF64PowDint, b: S64) -> CmF64PowDint
    block entry()
        zero : Bool = b.eq(0)
        branch zero
            ? return(cm_f64_pow_dint_zero())
            : continue
        neg : Bool = b.lt(0)
        c0  : U64  = b.to_wrap<U64>()
        c   : U64  = neg
            ? U64.sub_wrap(0, c0)
            : c0
        sgn : U64 = neg
            ? a.sgn.bitxor(1)
            : a.sgn
        r0 : U128 = cm_f64_pow_hi(a.r).mul_wide(c)
        rh : U64  = cm_f64_pow_hi(r0)
        m  : U64  = rh.ne(0)
            ? rh.leading_zeros()
            : 64
        r1    : U128 = r0.shl(m.to<U128>())
        rex   : S64  = a.ex.add(64).sub(m.to<S64>())
        l0    : U128 = cm_f64_pow_lo(a.r).mul_wide(c)
        l     : U128 = l0.shl(m.sub_wrap(1).to<U128>()).shr(63)
        r     : U128 = r1.add_wrap(l)
        carry : Bool = r.lt(l)
        branch carry
            ? return(CmF64PowDint { r: U128.shl(1, 127).bitor(r.shr(1)), ex: rex.add(1), sgn: sgn })
            : return(CmF64PowDint { r: r, ex: rex, sgn: sgn })

/// A nonzero finite F64 as a CmF64PowDint (exact).
routine F64.to<CmF64PowDint>(self: Self) -> CmF64PowDint
    block entry()
        u         : U64  = self.bits()
        exp_field : U64  = u.shr(52).bitand(0x7FF)
        e0        : S64  = exp_field.to<S64>()
        m0        : U64  = u.bitand(0x000FFFFFFFFFFFFF)
        normal    : Bool = e0.ne(0)
        m1        : U64  = normal
            ? m0.add(0x0010000000000000)
            : m0
        e1  : S64 = e0.sub(0x3FF)
        t   : U64 = m1.leading_zeros()
        sgn : U64 = self.lt(0.0)
            ? 1
            : 0
        e : S64 = t.gt(11)
            ? e1.sub(t.to<S64>().sub(12))
            : e1
        return(CmF64PowDint { r: cm_f64_pow_join(m1.shl(t), 0), ex: e, sgn: sgn })

/// a as an integer, rounded toward zero.
private routine cm_f64_pow_dint_toi(a: CmF64PowDint) -> S64
    block entry()
        small : Bool = a.ex.lt(0)
        branch small
            ? return(0)
            : continue
        integer_part : U64  = cm_f64_pow_hi(a.r).shr(S64.sub(63, a.ex).to_wrap<U64>())
        r            : S64  = integer_part.to_wrap<S64>()
        neg          : Bool = a.sgn.ne(0)
        branch neg
            ? return(S64.sub(0, r))
            : return(r)

/// log(1+z) for |z| <= 2^-13 (lower limb of z zero), with relative error below 2^-124.82.
private routine cm_f64_pow_p_2(z: CmF64PowDint) -> CmF64PowDint
    shared r : @CmF64PowDint <- uninit

    block entry()
        r1 : CmF64PowDint = cm_f64_pow_mul_dint_11(z, cm_f64_pow_p_2_at(0))
        r2 : CmF64PowDint = cm_f64_pow_add_dint_11(cm_f64_pow_p_2_at(1), r1)
        r3 : CmF64PowDint = cm_f64_pow_mul_dint_11(z, r2)
        r4 : CmF64PowDint = cm_f64_pow_add_dint_11(cm_f64_pow_p_2_at(2), r3)
        r5 : CmF64PowDint = cm_f64_pow_mul_dint_11(z, r4)
        r6 : CmF64PowDint = cm_f64_pow_add_dint_11(cm_f64_pow_p_2_at(3), r5)
        r7 : CmF64PowDint = cm_f64_pow_mul_dint_11(z, r6)
        r8 : CmF64PowDint = cm_f64_pow_add_dint(cm_f64_pow_p_2_at(4), r7)
        r8.store_into(r)
        jump horner(5)

    block horner(k: USize)
        zr   : CmF64PowDint = cm_f64_pow_mul_dint_21(r.load(), z)
        done : Bool         = k.eq(9)
        branch done
            ? return(zr)
            : continue
        next : CmF64PowDint = cm_f64_pow_add_dint(cm_f64_pow_p_2_at(k), zr)
        next.store_into(r)
        jump horner(k.add(1))

/// exp(y) for |y| < 0.00016923, with relative error below 2^-122.29.
private routine cm_f64_pow_q_2(y: CmF64PowDint) -> CmF64PowDint
    shared r : @CmF64PowDint <- uninit

    block entry()
        r1 : CmF64PowDint = cm_f64_pow_mul_dint_11(y, cm_f64_pow_q_2_at(0))
        r2 : CmF64PowDint = cm_f64_pow_add_dint_11(cm_f64_pow_q_2_at(1), r1)
        r3 : CmF64PowDint = cm_f64_pow_mul_dint_11(y, r2)
        r4 : CmF64PowDint = cm_f64_pow_add_dint_11(cm_f64_pow_q_2_at(2), r3)
        r5 : CmF64PowDint = cm_f64_pow_mul_dint_11(y, r4)
        r6 : CmF64PowDint = cm_f64_pow_add_dint(cm_f64_pow_q_2_at(3), r5)
        r6.store_into(r)
        jump horner(4)

    block horner(k: USize)
        done : Bool = k.eq(8)
        branch done
            ? return(r.load())
            : continue
        yr   : CmF64PowDint = cm_f64_pow_mul_dint(y, r.load())
        next : CmF64PowDint = cm_f64_pow_add_dint(cm_f64_pow_q_2_at(k), yr)
        next.store_into(r)
        jump horner(k.add(1))

/// log(x) with relative error below 2^-122.88.
routine cm_f64_pow_log_2(x: CmF64PowDint) -> CmF64PowDint
    block entry()
        xh    : U64  = cm_f64_pow_hi(x.r)
        above : Bool = xh.gt(0xB504F333F9DE6484)
        big_e : S64  = above
            ? x.ex.add(1)
            : x.ex
        i : U64 = above  // 90 <= i <= 181, sqrt(2)/2 < x < sqrt(2)
            ? xh.shr(57)
            : xh.shr(56)
        ii    : USize        = i.sub(90).to<USize>()
        xx    : CmF64PowDint = CmF64PowDint { r: x.r, ex: x.ex.sub(big_e), sgn: x.sgn }
        z1    : CmF64PowDint = cm_f64_pow_mul_dint_11(xx, cm_f64_pow_inverse_2_1(ii))
        j     : U64          = cm_f64_pow_hi(z1.r).shr(S64.sub(50, z1.ex).to_wrap<U64>())
        jj    : USize        = j.sub(8128).to<USize>()
        z2    : CmF64PowDint = cm_f64_pow_mul_dint_11(z1, cm_f64_pow_inverse_2_2(jj))
        m_one : CmF64PowDint = CmF64PowDint { r: U128.shl(1, 127), ex: 0, sgn: 1 }
        z     : CmF64PowDint = cm_f64_pow_add_dint(m_one, z2)
        log2  : CmF64PowDint = CmF64PowDint {
            r: cm_f64_pow_join(0xB17217F7D1CF79AB, 0xC9E3B39803F2F6AF), ex: -1, sgn: 0 }
        r     : CmF64PowDint = cm_f64_pow_mul_dint_int64(log2, big_e)
        p0    : CmF64PowDint = cm_f64_pow_p_2(z)
        p1    : CmF64PowDint = cm_f64_pow_add_dint(cm_f64_pow_log_inv_2_2(jj), p0)
        p2    : CmF64PowDint = cm_f64_pow_add_dint(cm_f64_pow_log_inv_2_1(ii), p1)
        return(cm_f64_pow_add_dint(p2, r))

/// exp(x) for |x| < 744.45 with relative error below 2^-121.70. For larger |x| a value whose exponent marks the
/// underflow (-1076) or overflow (1025).
routine cm_f64_pow_exp_2(x: CmF64PowDint) -> CmF64PowDint
    block entry()
        extreme : Bool = x.ex.ge(10)
        branch extreme
            ? extreme()
            : continue
        log2     : CmF64PowDint = CmF64PowDint {
            r: cm_f64_pow_join(0xB17217F7D1CF79AB, 0xC9E3B39803F2F6AF), ex: -1, sgn: 0 }
        log2_inv : CmF64PowDint = CmF64PowDint { r: cm_f64_pow_join(0xB8AA3B295C17F0BC, 0), ex: 12,
            sgn: 0 }
        kk0      : CmF64PowDint = cm_f64_pow_mul_dint_11(x, log2_inv)
        k        : S64          = cm_f64_pow_dint_toi(kk0)
        kk1      : CmF64PowDint = cm_f64_pow_mul_dint_int64(log2, k)
        kk       : CmF64PowDint = CmF64PowDint { r: kk1.r, ex: kk1.ex.sub(12),
            sgn: kk1.sgn.bitxor(1) }
        y        : CmF64PowDint = cm_f64_pow_add_dint(x, kk)
        big_m    : S64          = k.shr(12)
        k_high   : U64          = k.shr(6).to_wrap<U64>()
        i2       : USize        = k_high.bitand(0x3F).to<USize>()
        k_bits   : U64          = k.to_wrap<U64>()
        i1       : USize        = k_bits.bitand(0x3F).to<USize>()
        r0       : CmF64PowDint = cm_f64_pow_q_2(y)
        r1       : CmF64PowDint = cm_f64_pow_mul_dint(cm_f64_pow_t1_2(i2), r0)
        r2       : CmF64PowDint = cm_f64_pow_mul_dint(cm_f64_pow_t2_2(i1), r1)
        return(CmF64PowDint { r: r2.r, ex: r2.ex.add(big_m), sgn: r2.sgn })

    block extreme()
        neg : Bool = x.sgn.eq(1)
        branch neg
            ? return(CmF64PowDint { r: x.r, ex: -1076, sgn: 0 })
            : return(CmF64PowDint { r: x.r, ex: 1025, sgn: 0 })

/// a (with a.ex < -1022) rounded to the nearest subnormal F64.
private routine cm_f64_pow_dint_tod_subnormal(a: CmF64PowDint) -> F64
    shared ah : U64 = cm_f64_pow_hi(a.r)
    shared al : U64 = cm_f64_pow_lo(a.r)
    shared ex : U64 = S64.sub(0, a.ex.add(1011)).to_wrap<U64>()

    block entry()
        gone : Bool = ex.ge(64)
        branch gone
            ? vanish()
            : continue
        hi0       : U64  = ah.shr(ex)
        rb        : U64  = ah.shr(ex.sub(1)).bitand(1)
        ah_sticky : Bool = ah.shl(U64.sub(65, ex)).ne(0)
        sticky    : Bool = ah_sticky.bitor(al.ne(0))
        hi        : U64  = sticky
            ? hi0.add(rb)
            : hi0.add(hi0.bitand(rb))
        return(F64.from_bits(hi.bitor(a.sgn.shl(63))))

    // all bits disappear: |a| < 2^-1074
    block vanish()
        rb0      : U64  = ah.shr(63)
        sb0      : U64  = ah.shl(1).bitor(al)
        no_round : Bool = ex.gt(64).bitor(rb0.eq(0))
        zero     : Bool = no_round.bitor(sb0.eq(0))
        ret      : F64  = zero
            ? 0.0
            : F64.from_bits(1)
        neg : Bool = a.sgn.ne(0)
        branch neg
            ? return(ret.neg())
            : return(ret)

/// a rounded to the nearest F64.
routine CmF64PowDint.to<F64>(self: Self) -> F64
    block entry()
        sub : Bool = self.ex.lt(-1022)
        branch sub
            ? return(cm_f64_pow_dint_tod_subnormal(self))
            : continue
        ah        : U64  = cm_f64_pow_hi(self.r)
        al        : U64  = cm_f64_pow_lo(self.r)
        r0        : F64  = F64.from_bits(ah.shr(11).bitor(0x3FF0000000000000))  // the significand in [1, 2)
        round_bit : U64  = ah.shr(10).bitand(1)
        half      : Bool = round_bit.ne(0)
        rd0       : F64  = half
            ? F64.add(0.0, 0x1p-53)
            : 0.0
        ah_sticky : Bool = ah.bitand(0x3FF).ne(0)
        sticky    : Bool = ah_sticky.bitor(al.ne(0))
        rd1       : F64  = sticky
            ? rd0.add(0x1p-54)
            : rd0
        neg : Bool = self.sgn.ne(0)
        rd  : F64  = neg
            ? rd1.neg()
            : rd1
        r1   : F64  = F64.from_bits(r0.bits().bitor(self.sgn.shl(63)))
        r    : F64  = r1.add(rd)
        high : Bool = self.ex.gt(-1023)
        branch high
            ? high(r)
            : low(r)

    block high(r: F64)
        edge : Bool = self.ex.eq(1024)
        over : Bool = self.ex.gt(1023)
        when
            edge -> return(r.mul(2.0).mul(0x1p+1023))
            over -> return(F64.mul(0x1.fffffffffffffp+1023, 0x1.fffffffffffffp+1023))
            else -> normal_range(r)

    block normal_range(r: F64)
        biased_exponent : U64 = self.ex.add(1023).to_wrap<U64>()
        return(r.mul(F64.from_bits(biased_exponent.bitand(0x7FF).shl(52))))

    block low(r: F64)
        edge  : Bool = self.ex.eq(-1075)
        below : Bool = self.ex.lt(-1074)
        when
            edge  -> return(r.mul(0.5).mul(F64.from_bits(1)))
            below -> return(F64.from_bits(1).mul(F64.from_bits(1)))
            else  -> return(r.mul(F64.from_bits(U64.shl(1, self.ex.add(1074).to_wrap<U64>()))))

/// Entry i of a 128-bit table: limbs mant[2i], mant[2i+1], exponent and sign.
private routine cm_f64_pow_dint_entry(hi: U64, lo: U64, ex: S64, sgn: U64) -> CmF64PowDint
    block entry()
        return(CmF64PowDint { r: cm_f64_pow_join(hi, lo), ex: ex, sgn: sgn })

private routine cm_f64_pow_inverse_2_1(i: USize) -> CmF64PowDint
    block entry()
        hi : U64 = CM_F64_POW_INVERSE_2_1_MANT.getitem(i.mul(2))
        lo : U64 = CM_F64_POW_INVERSE_2_1_MANT.getitem(i.mul(2).add(1))
        return(cm_f64_pow_dint_entry(hi, lo, CM_F64_POW_INVERSE_2_1_EX.getitem(i),
            CM_F64_POW_INVERSE_2_1_SGN.getitem(i)))

