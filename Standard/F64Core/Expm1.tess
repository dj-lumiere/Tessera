// Tessera stdlib: the correctly rounded e^x - 1 of F64
//
// For |x| < 1/4, e^x - 1 = (e^(i/128) - 1) + e^(i/128) (e^(z/128) - 1) with a
// table of e^(i/128) - 1 as double-doubles. Otherwise e^x as in exp, minus 1
// folded into the double-double sum. When that can't decide the rounding, a
// double-double Taylor expansion (|x| < 1/4) or the accurate exp polynomial
// redoes it, and a few arguments too close to a rounding boundary even for
// that are looked up. Round to nearest only: overflow gives +inf, a very
// negative x -1, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary64/expm1/expm1.c via RazorForge's B64Expm1.rf.
// Copyright (c) 2024 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Double-double coefficients (high, low) of the degree-10 polynomial (in x,
/// times x^3) of the accurate path for |x| < 1/4, as F64 bits.
preset CM_F64_EXPM1_ACC_SMALL_CH: @Array<U64, 22> <- { 0x3FC5555555555555, 0x3C65555555555554,
    0x3FA5555555555555, 0x3C45555555555123, 0x3F81111111111111, 0x3C01111111118167,
    0x3F56C16C16C16C17, 0xBBEF49F49E220CEA, 0x3F2A01A01A01A01A, 0x3B6A019EFF6F919C,
    0x3EFA01A01A01A01A, 0x3B39FCFF48A75B41, 0x3EC71DE3A556C734, 0xBB6C14F73758CD7F,
    0x3E927E4FB7789F5C, 0x3B3DFCE97931018F, 0x3E5AE64567F544E3, 0x3AFC513DA9E4C9C5,
    0x3E21EED8EFF8D831, 0x3ACCA00AF84F2B60, 0x3DE6124613A86E8F, 0x3A8F27AC6000898F }

/// Double coefficients of the highest-order terms of that polynomial, as F64 bits.
preset CM_F64_EXPM1_ACC_SMALL_CL: @Array<U64, 6> <- { 0x3DA93974A8CA5354, 0x3D6AE7F3E71E4908,
    0x3D2AE7F357341648, 0x3CE952C7F96664CB, 0x3CA686F8CE633AAE, 0x3C62F49B2FBFB5B6 }

/// Double-double values (low, high) of e^(i/128) - 1, -32 <= i <= 32 (entry
/// i + 32), as F64 bits.
preset CM_F64_EXPM1_TZ: @Array<U64, 130> <- { 0xBC6797D4686C5393, 0xBFCC5041854DF7D4,
    0xBC8EA1CB9D163339, 0xBFCB881A23AEBB48, 0x3C8F483A3E8CD60F, 0xBFCABE60E1F21838,
    0x3C7DFFD920F493DB, 0xBFC9F3129931FAB0, 0xBC851BFDBB129094, 0xBFC9262C1C3430A0,
    0x3C8CD3E5225E2206, 0xBFC857AA375DB4E4, 0x3C5E3A6BDAECE8F9, 0xBFC78789B0A5E0C0,
    0xBC8DAF2AE0C2D3D4, 0xBFC6B5C7478983D8, 0xBC7FD36226FADD44, 0xBFC5E25FB4FDE210,
    0x3C7D887CD0341AB0, 0xBFC50D4FAB639758, 0xBC8676A52A1A618B, 0xBFC43693D679612C,
    0x3C79776B420AD283, 0xBFC35E28DB4ECD9C, 0x3C73D5FD7D70A5ED, 0xBFC2840B5836CF68,
    0x3C5A94AD2C8FA0BF, 0xBFC1A837E4BA3760, 0x3C26AD4C353465B0, 0xBFC0CAAB118A1278,
    0xBC78BBA170E59B65, 0xBFBFD6C2D0E3D910, 0xBC8E1E0A76CB0685, 0xBFBE14AED893EEF0,
    0x3C8FE131F55E75F8, 0xBFBC4F1331D22D40, 0xBC8B5BEEE8BCEE31, 0xBFBA85E8C62D9C10,
    0xBC77FE9B02C25E9B, 0xBFB8B92870FA2B58, 0xBC832AE7BDAF1116, 0xBFB6E8CAFF341FE8,
    0x3C7A6CFE58CBD73B, 0xBFB514C92F634788, 0x3C68798DE3138A56, 0xBFB33D1BB17DF2E8,
    0xBC3589321A7EF10B, 0xBFB161BB26CBB590, 0xBC78D0E700FCFB65, 0xBFAF0540438FD5C0,
    0x3C8473EF07D5DD3B, 0xBFAB3F864C080000, 0xBC838E62149C16E2, 0xBFA7723950130400,
    0xBC508BB6309BD394, 0xBFA39D4A1A77E050, 0xBC8BAD3FD501A227, 0xBF9F8152AEE94500,
    0x3C63D27AC39ED253, 0xBF97B88F290230E0, 0xBC8B60BBD08AAC55, 0xBF8FC055004416C0,
    0xBC4A00D03B3359DE, 0xBF7FE0154AAEED80, 0x0000000000000000, 0x0000000000000000,
    0x3C8861931C15E39B, 0x3F80100AB00222C0, 0x3C77AB864B3E9045, 0x3F90202AD5778E40,
    0x3C74E5659D75E95B, 0x3F984890D9043740, 0x3C78E0BD083ABA81, 0x3FA040AC0224FD90,
    0x3C345CC1CF959B1B, 0x3FA465509D383EB0, 0xBC8EB6980CE14DA7, 0x3FA89246D053D180,
    0x3C77324137D6C342, 0x3FACC79F4F5613A0, 0xBC45272FF30EED1B, 0x3FB082B577D34ED8,
    0xBC81280F19DACE1C, 0x3FB2A5DD543CCC50, 0xBC8D550AF31C8EC3, 0x3FB4CD4FC989CD68,
    0x3C87923B72AA582D, 0x3FB6F91575870690, 0xBC776C2E732457F1, 0x3FB92937074E0CD8,
    0x3C881F5C92A5200F, 0x3FBB5DBD3F681220, 0x3C8E8AC7A4D3206C, 0x3FBD96B0EFF0E790,
    0xBC712DB6F4BBE33B, 0x3FBFD41AFCBA45E8, 0xBC58C4A5DF1EC7E5, 0x3FC10B022DB7AE68,
    0xBC6BD4B1C37EA8A2, 0x3FC22E3B09DC54D8, 0x3C85AEB9860044D0, 0x3FC353BC9FB00B20,
    0xBC64C26602C63FDA, 0x3FC47B8B853AAFEC, 0xBC87F644C1F9D314, 0x3FC5A5AC59B963CC,
    0x3C8F5AA8EC61FC2D, 0x3FC6D223C5B10638, 0x3C27AB912C69FFEB, 0x3FC800F67B00D7B8,
    0xBC5B3564BC0EC9CD, 0x3FC9322934F54148, 0x3C86A7062465BE33, 0x3FCA65C0B85AC1A8,
    0xBC885718D2FF1BF4, 0x3FCB9BC1D3910094, 0xBC8045CB0C685E08, 0x3FCCD4315E9E0834,
    0xBC16E7FB859D5055, 0x3FCE0F143B41A554, 0x3C851BBDEE020603, 0x3FCF4C6F5508EE5C,
    0x3C6E17611AFC42C5, 0x3FD04623D0B0F8C8, 0xBC71C5B2E8735A43, 0x3FD0E7510FD7C564,
    0xBC825FE139C4CFFD, 0x3FD189C1ECAEB084, 0xBC789843C4964554, 0x3FD22D78F0FA061A }

/// The arguments (sorted bits) whose e^x - 1 is too close to a rounding
/// boundary for the accurate path.
preset CM_F64_EXPM1_DB: @Array<U64, 38> <- { 0x3FBE923C188EA79B, 0x3FD1A0408712E00A,
    0x3FD1C38132777B26, 0x3FD27F4980D511FF, 0x3FD8172A0E02F90E, 0x3FD8BBE2FB45C151,
    0x3FDBCAB27D05ABDE, 0x3FE005AE04256BAB, 0x3FEACCFBE46B4EF0, 0x3FED086543694C5A,
    0x401273C188AA7B14, 0x40183D4BCDEBB3F4, 0x40308F51434652C3, 0x4031D5C2DAEBE367,
    0x403C44CE0D716A1A, 0x4042EE70220FB1C5, 0x40489D56A0C38E6F, 0x4057A60EE15E3E9D,
    0x4061F0DA93354198, 0x40654CD1FEA7663A, 0x406556C678D5E976, 0x4072DA9E5E6AF0B0,
    0x4079E7B643238A14, 0x407D6479EBA7C971, 0x4080BC04AF1B09F5, 0xBFBAB86CB1743B75,
    0xBFD119AAE6072D39, 0xBFD175693A03B590, 0xBFD474D4DE7C14BB, 0xBFD789D025948EFA,
    0xBFD82B5DFAF59B4C, 0xBFD9D871E078EBCE, 0xBFE1397ADD4538AC, 0xBFE22E24FA3D5CF9,
    0xBFEDC2B5DF1F7D3D, 0xBFF0A54D87783D6F, 0xBFF2A9CAD9998262, 0xBFFE42A2ABB1BF0F }

/// e^me - 1, correctly rounded (to nearest, ties to even) and accurate near 0. +inf gives +inf, -inf gives -1,
/// overflow gives +inf, and NaN comes back quiet.
/// :returns: e^`me` - 1, correctly rounded.
routine F64.exp_m1(me: Me) -> Me
    shared ux  : U64 = me.bits()
    shared aix : U64 = ux.bitand(0x7FFFFFFFFFFFFFFF)

    block entry()
        small : Bool = aix.lt(0x3FD0000000000000)  // |x| < 0.25
        branch small
            ? small()
            : large()

    block small()
        tiny : Bool = aix.lt(0x3CA0000000000000)  // |x| < 2^-53
        zero : Bool = aix.eq(0)
        when
            zero -> return(me)
            tiny -> return(Me.mul_add(0x1p-54, me.abs(), me))
            else -> near_zero()

    // e^x - 1 = (e^(i/128) - 1) + e^(i/128) (e^(z/128) - 1), with |i| <= 32 and |z| <= 1/2
    block near_zero()
        sx   : Me         = Me.mul(0x1p7, me)
        fx   : Me         = sx.round_ties_even()
        z    : Me         = sx.sub(fx)
        z2   : Me         = z.mul(z)
        slot : S64        = fx.to<S64>().add(32)
        i    : USize      = slot.to<USize>()
        th   : Me         = Me.from_bits(CM_F64_EXPM1_TZ.getitem(i.mul(2).add(1)))
        tl   : Me         = Me.from_bits(CM_F64_EXPM1_TZ.getitem(i.mul(2)))
        fh   : Me         = z.mul(0x1p-7)
        q4   : Me         = Me.add(0x1.11111ad1ad69dp-42, z.mul(0x1.6c16c168b1fb5p-52))
        q3   : Me         = Me.add(0x1.555555555599cp-33, z.mul(q4))
        q1   : Me         = Me.add(0x1p-15, z.mul(0x1.55555555551adp-24))
        fl   : Me         = z2.mul(q1.add(z2.mul(q3)))
        eps  : Me         = z2.mul(0x1.ap-65).add(0x1p-104)
        r    : CmF64ExpDd = cm_f64_exp_fasttwosum(th, fh)
        rl   : Me         = r.lo.add(tl.add(fl))
        p    : CmF64ExpDd = cm_f64_exp_muldd(th, tl, fh, fl)
        f    : CmF64ExpDd = cm_f64_exp_fastsum(r.hi, rl, p.hi, p.lo)
        ub   : Me         = f.hi.add(f.lo.add(eps))
        lb   : Me         = f.hi.add(f.lo.sub(eps))
        sure : Bool       = ub.eq(lb)
        branch sure
            ? return(lb)
            : return(cm_f64_expm1_accurate(me))

    // |x| >= 0.25, infinite or NaN
    block large()
        edge : Bool = aix.ge(0x40862E42FEFA39F0)  // |x| >= 0x1.62e42fefa39fp+9
        branch edge
            ? edge()
            : middle()

    block edge()
        nan      : Bool = aix.gt(0x7FF0000000000000)
        inf      : Bool = aix.eq(0x7FF0000000000000)
        positive : Bool = ux.shr(63).eq(0)
        when
            nan      -> return(me.add(me))
            inf      -> infinite(positive)
            positive -> return(Me.INFINITY)
            else     -> middle()

    block infinite(positive: Bool)
        branch positive
            ? return(me)
            : return(-1.0)

    block middle()
        near_minus_one : Bool = ux.ge(0xC0425E4F7B2737FA)  // x <= -0x1.25e4f7b2737fap+5
        branch near_minus_one
            ? minus_one()
            : general()

    // the result is within an ulp of -1
    block minus_one()
        flat : Bool = ux.ge(0xC042B708872320E2)
        branch flat
            ? return(Me.add(-1.0, 0x1p-55))
            : continue
        d : Me = Me.add(0x1.25e4f7b2737fap+5, me).add(0x1.8486612173c69p-51)
        return(d.mul(0x1.71547652b82fep-54).sub(0x1.fffffffffffffp-1))

    block general()
        t   : Me         = me.mul(0x1.71547652b82fep+12).round_ties_even()
        jt  : S64        = t.to<S64>()
        ie  : S64        = jt.shr(12)
        tt  : CmF64ExpDd = cm_f64_exp_table_2pow(jt.to_wrap<U64>())
        dx  : Me         = me.sub(t.mul(0x1.62e42ffp-13)).add(t.mul(0x1.718432a1b0e26p-47))
        dx2 : Me         = dx.mul(dx)
        p01 : Me         = Me.add(1.0, dx.mul(0x1p-1))
        p23 : Me         = Me.add(0x1.55555557e54ffp-3, dx.mul(0x1.55555553a12f4p-5))
        p   : Me         = p01.add(dx2.mul(p23))
        tx  : Me         = tt.hi.mul(dx)
        fl  : Me         = tt.lo.add(tx.mul(p))
        eps : Me         = Me.mul(1.64e-19, tt.hi)
        // off = -2^-ie, so that 2^ie (fh + fl + off) = e^x - 1
        off_bits : U64  = S64.sub(3071, ie).to_wrap<U64>()
        off      : Me   = Me.from_bits(off_bits.shl(52))
        lt53     : Bool = ie.lt(53)
        lt75     : Bool = ie.lt(75)
        when
            lt53 -> off_first(tt.hi, fl, off, eps, ie)
            lt75 -> off_second(tt.hi, fl, off, eps, ie)
            else -> round(tt.hi, fl, 0.0, eps, ie)

    block off_first(fh: Me, fl: Me, off: Me, eps: Me, ie: S64)
        s : CmF64ExpDd = cm_f64_exp_fasttwosum(off, fh)
        jump round(s.hi, fl, s.lo, eps, ie)

    block off_second(fh: Me, fl: Me, off: Me, eps: Me, ie: S64)
        s : CmF64ExpDd = cm_f64_exp_fasttwosum(fh, off)
        jump round(s.hi, fl, s.lo, eps, ie)

    block round(fh: Me, fl: Me, e: Me, eps: Me, ie: S64)
        fe   : Me   = fl.add(e)
        ub   : Me   = fh.add(fe.add(eps))
        lb   : Me   = fh.add(fe.sub(eps))
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(cm_f64_exp_ldexp(lb, ie))
            : return(cm_f64_expm1_accurate(me))

/// The slow accurate path of expm1, for finite x with 2^-53 <= |x| and e^x - 1
/// neither overflowing nor within an ulp of -1.
/// :param x: The argument.
/// :returns: e^`x` - 1, correctly rounded.
private routine cm_f64_expm1_accurate(x: F64) -> F64
    block entry()
        small : Bool = x.abs().lt(0.25)
        branch small
            ? small()
            : large()

    // odd-and-even Taylor expansion x + x^2/2 + x^3 (1/6 + ...), with the high-order terms in double
    block small()
        p    : CmF64ExpDd = cm_f64_expm1_poly_small(x)
        f1   : CmF64ExpDd = cm_f64_expm1_mulddd(p.hi, p.lo, x)
        f2   : CmF64ExpDd = cm_f64_expm1_mulddd(f1.hi, f1.lo, x)
        f3   : CmF64ExpDd = cm_f64_expm1_mulddd(f2.hi, f2.lo, x)
        hx   : F64        = F64.mul(0.5, x)
        x2h  : F64        = x.mul(hx)
        x2l  : F64        = f64_mul_error(x, hx, x2h)
        f    : CmF64ExpDd = cm_f64_exp_fastsum(x2h, x2l, f3.hi, f3.lo)
        a1   : CmF64ExpDd = cm_f64_exp_fasttwosum(x, f.hi)
        a2   : CmF64ExpDd = cm_f64_exp_fasttwosum(a1.lo, f.lo)
        a3   : CmF64ExpDd = cm_f64_exp_fasttwosum(a1.hi, a2.hi)
        a4   : CmF64ExpDd = cm_f64_exp_fasttwosum(a3.lo, a2.lo)
        u1   : U64        = a4.hi.bits()
        pow2 : Bool       = u1.bitand(0x000FFFFFFFFFFFFF).eq(0)
        branch pow2
            ? small_boundary(a3.hi, u1, a4.lo)
            : return(a3.hi.add(a4.hi))

    // v1 is zero or a power of 2
    block small_boundary(v0: F64, u1: U64, tail: F64)
        zero : Bool = u1.shl(1).eq(0)
        branch zero
            ? return(cm_f64_expm1_database(x, v0))
            : continue
        // v1 is a power of 2: nudge it one ulp toward the sign of the tail
        same : Bool = u1.shr(63).eq(tail.bits().shr(63))
        u    : U64  = same
            ? u1.add_wrap(1)
            : u1.sub_wrap(1)
        return(v0.add(F64.from_bits(u)))

    block large()
        t  : F64        = x.mul(0x1.71547652b82fep+12).round_ties_even()
        jt : S64        = t.to<S64>()
        ie : S64        = jt.shr(12)
        tt : CmF64ExpDd = cm_f64_exp_table_2pow(jt.to_wrap<U64>())
        // Cody-Waite reduction with a triple-double log(2)/2^12
        dx       : F64        = x.sub(t.mul(0x1.62e42ffp-13))
        dxl      : F64        = F64.mul(0x1.718432a1b0e26p-47, t)
        dxl3     : F64        = F64.mul(0x1.9ff0342542fc3p-102, t)
        dxle     : F64        = F64.mul_add(0x1.718432a1b0e26p-47, t,
            dxl.neg())  // the rounding error of dxl
        dxll     : F64        = dxl3.add(dxle)
        dxh      : F64        = dx.add(dxl)
        dxe      : F64        = dx.sub(dxh).add(dxl)
        dxlo     : F64        = dxe.add(dxll)
        p        : CmF64ExpDd = cm_f64_expm1_poly_exp(dxh, dxlo)
        f1       : CmF64ExpDd = cm_f64_exp_muldd(dxh, dxlo, p.hi, p.lo)
        f2       : CmF64ExpDd = cm_f64_exp_muldd(f1.hi, f1.lo, tt.hi, tt.lo)
        f        : CmF64ExpDd = cm_f64_exp_fastsum(tt.hi, tt.lo, f2.hi, f2.lo)
        off_bits : U64        = S64.sub(3071, ie).to_wrap<U64>()
        off      : F64        = F64.from_bits(off_bits.shl(52))  // -2^-ie
        lt53     : Bool       = ie.lt(53)
        lt104    : Bool       = ie.lt(104)
        when
            lt53  -> off_first(f.hi, f.lo, off, ie)
            lt104 -> off_second(f.hi, f.lo, off, ie)
            else  -> round(f.hi, f.lo, 0.0, ie)

    block off_first(fh: F64, fl: F64, off: F64, ie: S64)
        s : CmF64ExpDd = cm_f64_exp_fasttwosum(off, fh)
        jump round(s.hi, fl, s.lo, ie)

    block off_second(fh: F64, fl: F64, off: F64, ie: S64)
        s : CmF64ExpDd = cm_f64_exp_fasttwosum(fh, off)
        jump round(s.hi, fl, s.lo, ie)

    block round(fh: F64, fl: F64, e: F64, ie: S64)
        s       : CmF64ExpDd = cm_f64_exp_fasttwosum(fh, fl.add(e))
        lo_bits : U64        = s.lo.bits()
        d       : U64        = lo_bits.add_wrap(8).bitand(0x000FFFFFFFFFFFFF)
        hard    : Bool       = d.le(8)
        branch hard
            ? return(cm_f64_exp_ldexp(cm_f64_expm1_database(x, s.hi), ie))
            : return(cm_f64_exp_ldexp(s.hi, ie))

/// The degree-10 double-double polynomial (in x, with double high-order terms)
/// of the accurate path for |x| < 1/4, by Horner's rule.
/// :param x: The argument, |x| < 1/4.
/// :returns: The polynomial value as a double-double.
private routine cm_f64_expm1_poly_small(x: F64) -> CmF64ExpDd
    block entry()
        c5 : F64        = F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CL.getitem(5))
        c4 : F64        = F64.add(F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CL.getitem(4)), x.mul(c5))
        c3 : F64        = F64.add(F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CL.getitem(3)), x.mul(c4))
        c2 : F64        = F64.add(F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CL.getitem(2)), x.mul(c3))
        c1 : F64        = F64.add(F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CL.getitem(1)), x.mul(c2))
        c0 : F64        = F64.add(F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CL.getitem(0)), x.mul(c1))
        fl : F64        = x.mul(c0)
        h0 : CmF64ExpDd = cm_f64_exp_fasttwosum(
            F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CH.getitem(20)), fl)
        cl : F64        = F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CH.getitem(21)).add(h0.lo)
        jump loop(10, h0.hi, cl)

    block loop(i: USize, ch: F64, cl: F64)
        done : Bool = i.eq(0)
        branch done
            ? return(CmF64ExpDd { hi: ch, lo: cl })
            : step(i.sub(1), ch, cl)

    block step(i: USize, ch: F64, cl: F64)
        m  : CmF64ExpDd = cm_f64_expm1_mulddd(ch, cl, x)
        c0 : F64        = F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CH.getitem(i.mul(2)))
        c1 : F64        = F64.from_bits(CM_F64_EXPM1_ACC_SMALL_CH.getitem(i.mul(2).add(1)))
        s  : CmF64ExpDd = cm_f64_exp_fastsum(c0, c1, m.hi, m.lo)
        jump loop(i, s.hi, s.lo)

/// The degree-6 double-double polynomial of e^x at xh + xl (the exp accurate
/// polynomial), by Horner's rule with double-double products and sums.
/// :param xh: The high part of the reduced argument.
/// :param xl: The low part of the reduced argument.
/// :returns: The polynomial value as a double-double.
private routine cm_f64_expm1_poly_exp(xh: F64, xl: F64) -> CmF64ExpDd
    shared ch : @F64 <- uninit
    shared cl : @F64 <- uninit

    block entry()
        F64.from_bits(CM_F64_EXP_ACC_CH.getitem(12)).store_into(ch)
        F64.from_bits(CM_F64_EXP_ACC_CH.getitem(13)).store_into(cl)
        jump loop(6)

    block loop(i: USize)
        done : Bool = i.eq(0)
        branch done
            ? return(CmF64ExpDd { hi: ch.load(), lo: cl.load() })
            : step(i.sub(1))

    block step(i: USize)
        m       : CmF64ExpDd = cm_f64_exp_muldd(xh, xl, ch.load(), cl.load())
        c0      : F64        = F64.from_bits(CM_F64_EXP_ACC_CH.getitem(i.mul(2)))
        c1      : F64        = F64.from_bits(CM_F64_EXP_ACC_CH.getitem(i.mul(2).add(1)))
        s       : CmF64ExpDd = cm_f64_exp_fastsum(c0, c1, m.hi, m.lo)
        next_cl : F64        = s.lo
        next_ch : F64        = s.hi
        next_ch.store_into(ch)
        next_cl.store_into(cl)
        jump loop(i)

/// Double-double times double (xh + xl) c.
/// :param xh: The high part of the double-double factor.
/// :param xl: The low part of the double-double factor.
/// :param c: The double factor.
/// :returns: The product as a double-double, not renormalized.
private routine cm_f64_expm1_mulddd(xh: F64, xl: F64, c: F64) -> CmF64ExpDd
    block entry()
        h  : F64 = c.mul(xh)
        lo : F64 = c.mul(xl).add(f64_mul_error(c, xh, h))
        return(CmF64ExpDd { hi: h, lo: lo })

/// Looks x up among the arguments whose e^x - 1 lies too close to a rounding
/// boundary for the accurate path, and returns the correctly rounded result
/// (unscaled when |x| >= 1/4) for them, or f unchanged otherwise.
/// :param x: The argument.
/// :param f: The result of the accurate path, returned when `x` is not in the table.
/// :returns: The correctly rounded result for a listed `x`, else `f`.
private routine cm_f64_expm1_database(x: F64, f: F64) -> F64
    block entry()
        jump search(0, 37)

    block search(a: S64, b: S64)
        open : Bool = a.le(b)
        branch open
            ? probe(a, b)
            : return(f)

    block probe(a: S64, b: S64)
        m     : S64  = a.add(b).shr(1)
        cm    : U64  = CM_F64_EXPM1_DB.getitem(m.to<USize>())
        ux    : U64  = x.bits()
        below : Bool = cm.lt(ux)
        found : Bool = cm.eq(ux)
        when
            below -> search(m.add(1), b)
            found -> found(m.to_wrap<U64>())
            else  -> search(a, m.sub(1))

    block found(um: U64)
        jf     : U64  = f.bits()
        sign   : U64  = U64.shr(0x300E81651C, um).shl(63)
        binade : U64  = jf.shr(52).bitand(0x7FF)
        scale  : U64  = binade.sub_wrap(54).shl(52)  // 2^-54 times the binade of f
        dr     : F64  = F64.from_bits(sign.bitor(scale))
        upper  : Bool = um.shr(5).eq(1)
        s2     : U64  = upper
            ? 0xC06
            : 0x76F58B0D65BD5553
        t : U64 = s2.shr(um.shl(1).bitand(63)).bitand(3)
        return(cm_f64_exp_pick(f, t, dr))
