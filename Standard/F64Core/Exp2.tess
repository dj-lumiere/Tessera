// Tessera stdlib: the correctly rounded base-2 exponential 2^x of F64
//
// x = (k + z) / 2^12 with k an integer: 2^(k/2^12) as a double-double from
// the exp tables, 2^(z/2^12) from a short polynomial. Integers give exact
// powers of two. When the fast path can't decide the rounding, a degree-6
// double-double polynomial redoes it, and a few arguments too close to a
// rounding boundary even for that are looked up. Round to nearest only:
// overflow gives +inf, underflow a correctly rounded subnormal or +0, NaN
// comes back quiet.
//
// Ported from CORE-MATH, src/binary64/exp2/exp2.c via RazorForge's B64Exp2.rf.
// Copyright (c) 2023-2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Double-double coefficients (high, low) of the accurate polynomial, as F64 bits.
preset CM_F64_EXP2_ACC_CD: @Array<U64, 12> <- { 0x3F262E42FEFA39EF, 0x3BBABC9E3B39873E,
    0x3E4EBFBDFF82C58F, 0xBAE5E43A53E44950, 0x3D6C6B08D704A0C0, 0xBA0D3A15710D3D83,
    0x3C83B2AB6FBA4E77, 0x3914DD5D2A5E025A, 0x3B95D87FE7A66459, 0xB83DC47E47BEB9DD,
    0x3AA430912F9FB79D, 0xB744FCD51FCB7640 }

/// The arguments (sorted bits) whose 2^x is too close to a rounding boundary
/// for the accurate path.
preset CM_F64_EXP2_DB: @Array<U64, 43> <- { 0x3F5E4596526BF94D, 0x3F5E76049073067F,
    0x3F6755AA6FA428CD, 0x3F679015CE2843D7, 0x3F7F99AFEFA30D65, 0x3F98D040898B73F5,
    0x3FB673A7779D5293, 0x3FB8859F5E252908, 0x3FBFA18DFAD6E466, 0x3FC6C4175EA0C6E1,
    0x3FC926961243BABA, 0x3FE3E34FA6AB969E, 0x3FEB32A6C92D1185, 0x3FF9F1A7D355CB4F,
    0xBF243C1CEA9BD4D9, 0xBF277970470A37ED, 0xBF27D44C7C8229A6, 0xBF395A914543EAB7,
    0xBF399BE01D01064A, 0xBF413F898B1E4F28, 0xBF468E7A49000B1C, 0xBF486D2A6E5E8368,
    0xBF5120D3BDFB6ED8, 0xBF53EC814D260D02, 0xBF647B667916C4B2, 0xBF6899E0474BA2D5,
    0xBF6BA84C6EBFB038, 0xBF7111BC29CCDBB1, 0xBF71FB57E1996E26, 0xBF772E40977492C3,
    0xBF7EBF8CF367FCB8, 0xBF807F812303F10A, 0xBF9234ADA2403885, 0xBF935DD739305031,
    0xBFA526CE079B05A5, 0xBFB3EA95A5C16E4A, 0xBFC33564DB4BB9EC, 0xBFCD4854D9F87FCA,
    0xBFCFE89353E31CBF, 0xBFD83960B2A8D2C4, 0xBFDE242801B45D0D, 0xBFECEF4C143B5ADF,
    0xBFF60E582CAA34B1 }

/// 2^self, correctly rounded (to nearest, ties to even). 2^-inf = +0, 2^+inf = +inf, overflow gives +inf,
/// underflow a correctly rounded subnormal or +0, and NaN comes back quiet. 2^n is exact for integer n.
/// :returns: 2^`self`, correctly rounded.
routine F64.exp2(self: Self) -> Self
    shared ux : U64 = self.bits()
    shared ax : U64 = ux.shl(1)

    block entry()
        zero : Bool = ax.eq(0)
        big  : Bool = ax.ge(0x8120000000000000)  // |x| >= 1024, infinite or NaN
        tiny : Bool = ax.le(0x792E2A8ECA5705FC)  // |x| <= 0x1.71547652b82fep-54: 2^x rounds to 1
        when
            zero -> return(1.0)
            big  -> edge()
            tiny -> return(Self.add(1.0, Self.copysign(0x1p-54, self)))
            else -> fast()

    block edge()
        nan      : Bool = ax.gt(0xFFE0000000000000)
        inf      : Bool = ax.eq(0xFFE0000000000000)
        positive : Bool = ux.shr(63).eq(0)
        under    : Bool = ux.ge(0xC090CC0000000000)  // x <= -1075
        when
            nan      -> return(self.add(self))
            inf      -> infinite(positive)
            positive -> return(Self.mul(0x1p1023, self))  // x >= 1024: overflow
            under    -> return(0.0)
            else     -> fast()

    block infinite(positive: Bool)
        branch positive
            ? return(self)
            : return(0.0)

    block fast()
        // frac is nonzero exactly when x is not an integer
        m      : U64        = ux.shl(12)
        ex     : U64        = ax.shr(53).sub_wrap(0x3FF)
        frac   : U64        = ex.shr(63).bitor(m.shl(ex.bitand(63)))
        sx     : Self       = Self.mul(4096.0, self)
        fx     : Self       = sx.round_ties_even()
        z      : Self       = sx.sub(fx)
        z2     : Self       = z.mul(z)
        k      : S64        = fx.to<S64>()
        ie     : S64        = k.shr(12)
        tt     : CmF64ExpDd = cm_f64_exp_table_2pow(k.to_wrap<U64>())
        tz     : Self       = tt.hi.mul(z)
        p01    : Self       = Self.add(0x1.62e42fefa39efp-13, z.mul(0x1.ebfbdff82c58fp-27))
        p23    : Self       = Self.add(0x1.c6b08d73b3e01p-41, z.mul(0x1.3b2ab6fdda001p-55))
        fl     : Self       = tz.mul(p01.add(z2.mul(p23))).add(tt.lo)
        normal : Bool       = ux.le(0xC08FF00000000000)  // x >= -1022
        whole  : Bool       = frac.eq(0)
        when
            normal -> normal(tt.hi, fl, ie, whole)
            else   -> subnormal(tt.hi, fl, ie, whole)

    block normal(fh: Self, fl: Self, ie: S64, whole: Bool)
        branch whole
            ? return(cm_f64_exp_ldexp(fh, ie))
            : continue
        ub   : Self = fh.add(fl.add(0x1.fdp-63))
        lb   : Self = fh.add(fl.sub(0x1.fdp-63))
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(cm_f64_exp_ldexp(lb, ie))
            : return(cm_f64_exp2_accurate(self))

    block subnormal(fh: Self, fl: Self, ie: S64, whole: Bool)
        bias_e : U64        = S64.sub(1, ie).to_wrap<U64>()
        bias   : Self       = Self.from_bits(bias_e.shl(52))
        s      : CmF64ExpDd = cm_f64_exp_fasttwosum(bias, fh)
        sl     : Self       = fl.add(s.lo)
        branch whole
            ? return(Self.from_bits(s.hi.bits().bitand(0x000FFFFFFFFFFFFF)))
            : continue
        ub   : Self = s.hi.add(sl.add(0x1.fdp-63))
        lb   : Self = s.hi.add(sl.sub(0x1.fdp-63))
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(Self.from_bits(lb.bits().bitand(0x000FFFFFFFFFFFFF)))
            : return(cm_f64_exp2_accurate(self))

/// The slow accurate path of exp2, for finite x that is not an integer, with
/// 2^x neither overflowing nor below 2^-1075.
/// :param x: The argument.
/// :returns: 2^`x`, correctly rounded.
private routine cm_f64_exp2_accurate(x: F64) -> F64
    shared sx : F64        = F64.mul(4096.0, x)
    shared fx : F64        = sx.round_ties_even()
    shared z  : F64        = sx.sub(fx)
    shared k  : S64        = fx.to<S64>()
    shared uk : U64        = k.to_wrap<U64>()
    shared ie : S64        = k.shr(12)
    shared tt : CmF64ExpDd = cm_f64_exp_table_2pow(uk)
    shared p  : CmF64ExpDd = cm_f64_exp2_poly_acc(z)
    shared f  : CmF64ExpDd = cm_f64_exp2_mulddd(z, p.hi, p.lo)

    block entry()
        ux     : U64  = x.bits()
        normal : Bool = ux.le(0xC08FF00000000000)  // x >= -1022
        branch normal
            ? normal()
            : subnormal()

    block normal()
        above : Bool = F64.le(-0x1.71547652b82fep-54, x)
        below : Bool = x.le(0x1.71547652b82fdp-53)
        near1 : Bool = above.bitand(below)
        branch near1
            ? return(x.mul_add(0.5, 1.0))
            : continue
        whole : Bool = uk.bitand(0xFFF).eq(0)  // 4096 x rounds to 4096 times an integer
        branch whole
            ? at_one(tt.hi)
            : scale()

    // 2^(k/2^12) is exactly 1: add it in without a product
    block at_one(th: F64)
        s        : CmF64ExpDd = cm_f64_exp_fasttwosum(th, f.hi)
        s2       : CmF64ExpDd = cm_f64_exp_fasttwosum(s.lo, f.lo)
        ul       : U64        = s2.hi.bits()
        pow2     : Bool       = ul.bitand(0x000FFFFFFFFFFFFF).eq(0)
        ebits    : U64        = ul.shr(52).bitand(0x7FF)
        nonzero  : Bool       = ebits.ne(0)
        adjusted : Bool       = pow2.bitand(nonzero)
        branch adjusted
            ? nudge(s.hi, ul, s2.lo)
            : round(s.hi, s2.hi)

    // the low part is a nonzero power of 2: nudge it one ulp toward the sign of the tail
    block nudge(fh: F64, ul: U64, tail: F64)
        same : Bool = ul.shr(63).eq(tail.bits().shr(63))
        u    : U64  = same
            ? ul.add_wrap(1)
            : ul.sub_wrap(1)
        jump round(fh, F64.from_bits(u))

    block scale()
        g : CmF64ExpDd = cm_f64_exp_muldd(f.hi, f.lo, tt.hi, tt.lo)
        h : CmF64ExpDd = cm_f64_exp_fastsum(tt.hi, tt.lo, g.hi, g.lo)
        jump round(h.hi, h.lo)

    block round(fh: F64, fl: F64)
        s       : CmF64ExpDd = cm_f64_exp_fasttwosum(fh, fl)
        lo_bits : U64        = s.lo.bits()
        d       : U64        = lo_bits.add_wrap(2).bitand(0x000FFFFFFFFFFFFF)
        hard    : Bool       = d.le(2)
        branch hard
            ? return(cm_f64_exp_ldexp(cm_f64_exp2_database(x, s.hi), ie))
            : return(cm_f64_exp_ldexp(s.hi, ie))

    block subnormal()
        bias_e : U64        = S64.sub(1, ie).to_wrap<U64>()
        bias   : F64        = F64.from_bits(bias_e.shl(52))
        g      : CmF64ExpDd = cm_f64_exp_muldd(f.hi, f.lo, tt.hi, tt.lo)
        h      : CmF64ExpDd = cm_f64_exp_fastsum(tt.hi, tt.lo, g.hi, g.lo)
        s      : CmF64ExpDd = cm_f64_exp_fasttwosum(bias, h.hi)
        fl     : F64        = h.lo.add(s.lo)
        res    : F64        = s.hi.add(fl)
        return(F64.from_bits(res.bits().bitand(0x000FFFFFFFFFFFFF)))

/// The degree-6 double-double polynomial (constant term 0) of the accurate
/// path, divided by z, at z: Horner's rule on CM_F64_EXP2_ACC_CD.
/// :param z: The reduced argument, 4096 x minus its nearest integer (|z| <= 1/2).
/// :returns: The polynomial value as a double-double.
private routine cm_f64_exp2_poly_acc(z: F64) -> CmF64ExpDd
    shared ch : @F64 <- uninit
    shared cl : @F64 <- uninit

    block entry()
        F64.from_bits(CM_F64_EXP2_ACC_CD.getitem(10)).store_into(ch)
        F64.from_bits(CM_F64_EXP2_ACC_CD.getitem(11)).store_into(cl)
        jump loop(5)

    block loop(i: USize)
        done : Bool = i.eq(0)
        branch done
            ? return(CmF64ExpDd { hi: ch.load(), lo: cl.load() })
            : step(i.sub(1))

    block step(i: USize)
        r       : CmF64ExpDd = cm_f64_exp2_mulddd(z, ch.load(), cl.load())
        c0      : F64        = F64.from_bits(CM_F64_EXP2_ACC_CD.getitem(i.mul(2)))
        c1      : F64        = F64.from_bits(CM_F64_EXP2_ACC_CD.getitem(i.mul(2).add(1)))
        sh      : F64        = r.hi.add(c0)
        sl      : F64        = c0.sub(sh).add(r.hi)
        next_cl : F64        = r.lo.add(sl.add(c1))
        next_ch : F64        = sh
        next_ch.store_into(ch)
        next_cl.store_into(cl)
        jump loop(i)

/// Double-double times double (ch + cl) xh.
/// :param xh: The double factor.
/// :param ch: The high part of the double-double factor.
/// :param cl: The low part of the double-double factor.
/// :returns: The product as a double-double, not renormalized.
private routine cm_f64_exp2_mulddd(xh: F64, ch: F64, cl: F64) -> CmF64ExpDd
    block entry()
        ahhh : F64 = ch.mul(xh)
        lo   : F64 = cl.mul(xh).add(ch.mul_add(xh, ahhh.neg()))
        return(CmF64ExpDd { hi: ahhh, lo: lo })

/// Looks x up among the arguments whose 2^x lies too close to a rounding
/// boundary for the accurate path, and returns the correctly rounded
/// (unscaled) result for them, or f unchanged otherwise.
/// :param x: The argument.
/// :param f: The unscaled result of the accurate path, returned when `x` is not in the table.
/// :returns: The correctly rounded unscaled result for a listed `x`, else `f`.
private routine cm_f64_exp2_database(x: F64, f: F64) -> F64
    block entry()
        jump search(0, 42)

    block search(a: S64, b: S64)
        open : Bool = a.le(b)
        branch open
            ? probe(a, b)
            : return(f)

    block probe(a: S64, b: S64)
        m     : S64  = a.add(b).shr(1)
        cm    : U64  = CM_F64_EXP2_DB.getitem(m.to<USize>())
        ux    : U64  = x.bits()
        below : Bool = cm.lt(ux)
        found : Bool = cm.eq(ux)
        when
            below -> search(m.add(1), b)
            found -> found(m.to_wrap<U64>())
            else  -> search(a, m.sub(1))

    block found(um: U64)
        sign_bit : U64  = U64.shr(8677191773140, um).shl(63)
        dr       : F64  = F64.from_bits(sign_bit.bitor(0x3C90000000000000))
        upper    : Bool = um.shr(5).eq(1)
        s2       : U64  = upper
            ? 0x34C797
            : 0x3B216FBD5FD7665F
        t : U64 = s2.shr(um.shl(1).bitand(63)).bitand(3)
        return(cm_f64_exp_pick(f, t, dr))
