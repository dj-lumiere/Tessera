// Tessera stdlib: prelude
//
// Builder-intrinsic operations, part of Standard::Core, so every file sees
// them. Their names (exp, floor, round, ...) are taken: a value can't use one.
// These map directly to LLVM IR instructions and have no runtime cost beyond
// the instruction itself.
//
// All operations are generic over their operand type:
//   integer ops  — T is an integer type (S*, U*, and Byte for the bit operations)
//   float ops    — T is a float type
//   conversions  — From/To unconstrained, caller picks concrete types
//
// Ordered integer comparisons aren't here: signedness belongs to the type, so S*.lt lowers to
// `icmp slt` and U*.lt to `icmp ult` directly (Standard/Types). Shifts are the three LLVM
// instructions shl, ashr, and lshr.

module Standard::Core

// ============================================================
// Division and remainder
// ============================================================

/// Signed integer division, truncating toward zero (LLVM `sdiv`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The quotient.
/// :note: Division by zero or `MIN / -1` is undefined behavior, so callers check first.
#[external("llvm"), template("{result} = sdiv {T} {a}, {b}")]
routine sdiv<T>(a: T, b: T) -> T
require T: typename
/// Signed integer remainder, taking the sign of the dividend (LLVM `srem`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder.
/// :note: A zero divisor or `MIN % -1` is undefined behavior.
#[external("llvm"), template("{result} = srem {T} {a}, {b}")]
routine srem<T>(a: T, b: T) -> T
require T: typename
/// Unsigned integer division (LLVM `udiv`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The quotient.
/// :note: A zero divisor is undefined behavior, so callers check first.
#[external("llvm"), template("{result} = udiv {T} {a}, {b}")]
routine udiv<T>(a: T, b: T) -> T
require T: typename
/// Unsigned integer remainder (LLVM `urem`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder.
/// :note: A zero divisor is undefined behavior.
#[external("llvm"), template("{result} = urem {T} {a}, {b}")]
routine urem<T>(a: T, b: T) -> T
require T: typename

// ============================================================
// Integer arithmetic
// ============================================================

/// Integer addition that wraps modulo 2^N on overflow (LLVM `add`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The sum.
#[external("llvm"), template("{result} = add {T} {a}, {b}")]
routine add<T>(a: T, b: T) -> T
require T: typename
/// Integer subtraction that wraps modulo 2^N on overflow (LLVM `sub`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The value to subtract from.
/// :param b: The value to subtract.
/// :returns: The difference.
#[external("llvm"), template("{result} = sub {T} {a}, {b}")]
routine sub<T>(a: T, b: T) -> T
require T: typename
/// Integer multiplication that wraps modulo 2^N on overflow (LLVM `mul`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The product.
#[external("llvm"), template("{result} = mul {T} {a}, {b}")]
routine mul<T>(a: T, b: T) -> T
require T: typename

// ============================================================
// Integer bitwise
// ============================================================

/// Bitwise AND of two integers (LLVM `and`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The bitwise AND.
#[external("llvm"), template("{result} = and {T} {a}, {b}")]
routine band<T>(a: T, b: T) -> T
require T: typename
/// Bitwise OR of two integers (LLVM `or`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The bitwise OR.
#[external("llvm"), template("{result} = or {T} {a}, {b}")]
routine bor<T>(a: T, b: T) -> T
require T: typename
/// Bitwise XOR of two integers (LLVM `xor`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The bitwise XOR.
#[external("llvm"), template("{result} = xor {T} {a}, {b}")]
routine bxor<T>(a: T, b: T) -> T
require T: typename
/// Bitwise NOT: flips every bit of the integer (LLVM `xor` with -1).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The value with every bit flipped.
#[external("llvm"), template("{result} = xor {T} {val}, -1")]
routine bnot<T>(val: T) -> T
require T: typename

// ============================================================
// Integer and bool equality
// ============================================================

/// Integer or Bool equality, true when both operands hold the same bits (LLVM `icmp eq`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operands are equal.
#[external("llvm"), template("{result} = icmp eq {T} {a}, {b}")]
routine ieq<T>(a: T, b: T) -> Bool
require T: typename
/// Integer or Bool inequality, true when the operands differ (LLVM `icmp ne`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operands differ.
#[external("llvm"), template("{result} = icmp ne {T} {a}, {b}")]
routine ine<T>(a: T, b: T) -> Bool
require T: typename

// ============================================================
// Bit shifts
// ============================================================

/// Shifts `val` left by `amt` bits, filling with zeros (LLVM `shl`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to shift.
/// :param amt: The shift amount in bits.
/// :returns: The shifted value.
/// :note: An amount of the bit width or more is poison.
#[external("llvm"), template("{result} = shl {T} {val}, {amt}")]
routine shl<T>(val: T, amt: T) -> T
require T: typename
/// Arithmetic shift right: shifts `val` right by `amt` bits, filling with copies of the sign bit (LLVM `ashr`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to shift.
/// :param amt: The shift amount in bits.
/// :returns: The shifted value.
/// :note: An amount of the bit width or more is poison.
#[external("llvm"), template("{result} = ashr {T} {val}, {amt}")]
routine ashr<T>(val: T, amt: T) -> T  // arithmetic (sign-extend)
require T: typename
/// Logical shift right: shifts `val` right by `amt` bits, filling with zeros (LLVM `lshr`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to shift.
/// :param amt: The shift amount in bits.
/// :returns: The shifted value.
/// :note: An amount of the bit width or more is poison.
#[external("llvm"), template("{result} = lshr {T} {val}, {amt}")]
routine lshr<T>(val: T, amt: T) -> T  // logical (zero-fill)
require T: typename

// ============================================================
// Floating-point arithmetic
// ============================================================

/// Floating-point addition (LLVM `fadd`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The sum.
#[external("llvm"), template("{result} = fadd {T} {a}, {b}")]
routine fadd<T>(a: T, b: T) -> T
require T: typename
/// Floating-point subtraction (LLVM `fsub`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The value to subtract from.
/// :param b: The value to subtract.
/// :returns: The difference.
#[external("llvm"), template("{result} = fsub {T} {a}, {b}")]
routine fsub<T>(a: T, b: T) -> T
require T: typename
/// Floating-point multiplication (LLVM `fmul`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The product.
#[external("llvm"), template("{result} = fmul {T} {a}, {b}")]
routine fmul<T>(a: T, b: T) -> T
require T: typename
/// Floating-point division (LLVM `fdiv`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The quotient.
/// :note: A zero divisor gives an infinity or NaN rather than crashing.
#[external("llvm"), template("{result} = fdiv {T} {a}, {b}")]
routine fdiv<T>(a: T, b: T) -> T
require T: typename

// ============================================================
// Floating-point comparisons (ordered — false if either NaN)
// ============================================================

/// Ordered float equality: false when either operand is NaN (LLVM `fcmp oeq`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operands are equal and neither is NaN.
#[external("llvm"), template("{result} = fcmp oeq {T} {a}, {b}")]
routine feq<T>(a: T, b: T) -> Bool
require T: typename
/// Ordered float inequality: false when either operand is NaN (LLVM `fcmp one`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operands differ and neither is NaN.
#[external("llvm"), template("{result} = fcmp one {T} {a}, {b}")]
routine fne<T>(a: T, b: T) -> Bool
require T: typename
/// Ordered float less-than: false when either operand is NaN (LLVM `fcmp olt`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when `a` is less than `b`.
#[external("llvm"), template("{result} = fcmp olt {T} {a}, {b}")]
routine flt<T>(a: T, b: T) -> Bool
require T: typename
/// Ordered float greater-than: false when either operand is NaN (LLVM `fcmp ogt`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when `a` is greater than `b`.
#[external("llvm"), template("{result} = fcmp ogt {T} {a}, {b}")]
routine fgt<T>(a: T, b: T) -> Bool
require T: typename
/// Ordered float less-or-equal: false when either operand is NaN (LLVM `fcmp ole`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when `a` is less than or equal to `b`.
#[external("llvm"), template("{result} = fcmp ole {T} {a}, {b}")]
routine fle<T>(a: T, b: T) -> Bool
require T: typename
/// Ordered float greater-or-equal: false when either operand is NaN (LLVM `fcmp oge`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when `a` is greater than or equal to `b`.
#[external("llvm"), template("{result} = fcmp oge {T} {a}, {b}")]
routine fge<T>(a: T, b: T) -> Bool
require T: typename

// ============================================================
// Type conversions
// ============================================================

/// Sign-extends an integer to a wider integer type, copying the sign bit into the new high bits (LLVM `sext`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The integer to extend.
/// :returns: The sign-extended value.
#[external("llvm"), template("{result} = sext {TFrom} {val} to {TTo}")]
routine sext<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Zero-extends an integer to a wider integer type, filling the new high bits with zeros (LLVM `zext`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The integer to extend.
/// :returns: The zero-extended value.
#[external("llvm"), template("{result} = zext {TFrom} {val} to {TTo}")]
routine zext<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Truncates an integer to a narrower integer type, dropping the high bits (LLVM `trunc`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The integer to truncate.
/// :returns: The truncated value.
#[external("llvm"), template("{result} = trunc {TFrom} {val} to {TTo}")]
routine trunc<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Reinterprets the bits of a value as another type of the same size, such as a float as an integer (LLVM `bitcast`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The value whose bits are reinterpreted.
/// :returns: The same bits viewed as the target type.
#[external("llvm"), template("{result} = bitcast {TFrom} {val} to {TTo}")]
routine bitcast<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts a float to a signed integer, rounding toward zero (LLVM `fptosi`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The float to convert.
/// :returns: The signed integer.
/// :note: An out-of-range or NaN input is poison.
/// :see: {fptosi_sat}
#[external("llvm"), template("{result} = fptosi {TFrom} {val} to {TTo}")]
routine fptosi<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts a signed integer to a float, rounding to nearest (LLVM `sitofp`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The signed integer to convert.
/// :returns: The float.
#[external("llvm"), template("{result} = sitofp {TFrom} {val} to {TTo}")]
routine sitofp<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Widens a float to a wider float type, exactly (LLVM `fpext`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The float to widen.
/// :returns: The widened float.
#[external("llvm"), template("{result} = fpext {TFrom} {val} to {TTo}")]
routine fpext<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Narrows a float to a narrower float type, rounding to nearest (LLVM `fptrunc`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The float to narrow.
/// :returns: The narrowed float.
#[external("llvm"), template("{result} = fptrunc {TFrom} {val} to {TTo}")]
routine fptrunc<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts a pointer to an integer holding its address (LLVM `ptrtoint`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The pointer to convert.
/// :returns: The address as an integer.
#[external("llvm"), template("{result} = ptrtoint {TFrom} {val} to {TTo}")]
routine ptrtoint<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts an integer to a pointer with that address (LLVM `inttoptr`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The integer address to convert.
/// :returns: The pointer.
#[external("llvm"), template("{result} = inttoptr {TFrom} {val} to {TTo}")]
routine inttoptr<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

// ============================================================
// Bit manipulation (LLVM intrinsics)
// ============================================================

/// Counts the set bits of `val` (LLVM `ctpop`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The number of set bits.
#[external("llvm"), template("{result} = call {T} @llvm.ctpop.{T}({T} {val})")]
routine popcount<T>(val: T) -> T
require T: typename
/// Counts the leading zero bits of `val`. When `is_zero_undef` is true a zero input is poison. Otherwise it gives the bit width (LLVM `ctlz`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :param is_zero_undef: When true a zero input is poison, otherwise the result for zero is the bit width.
/// :returns: The number of leading zero bits.
#[external("llvm"), template("{result} = call {T} @llvm.ctlz.{T}({T} {val}, i1 {is_zero_undef})")]
routine clz<T>(val: T, is_zero_undef: Bool) -> T
require T: typename
/// Counts the trailing zero bits of `val`. When `is_zero_undef` is true a zero input is poison. Otherwise it gives the bit width (LLVM `cttz`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :param is_zero_undef: When true a zero input is poison, otherwise the result for zero is the bit width.
/// :returns: The number of trailing zero bits.
#[external("llvm"), template("{result} = call {T} @llvm.cttz.{T}({T} {val}, i1 {is_zero_undef})")]
routine ctz<T>(val: T, is_zero_undef: Bool) -> T
require T: typename
/// Reverses the byte order of `val` (LLVM `bswap`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The value with its bytes reversed.
#[external("llvm"), template("{result} = call {T} @llvm.bswap.{T}({T} {val})")]
routine bswap<T>(val: T) -> T
require T: typename

// ============================================================
// Unsigned and saturating conversions
//
// uitofp reads the integer as unsigned. The *_sat forms clamp out-of-range
// floats to the integer range and map NaN to 0 (Rust `as` semantics). The
// plain fptosi / fptoui give poison for out-of-range input.
// ============================================================

/// Converts an unsigned integer to a float, rounding to nearest (LLVM `uitofp`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The unsigned integer to convert.
/// :returns: The float.
#[external("llvm"), template("{result} = uitofp {TFrom} {val} to {TTo}")]
routine uitofp<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts a float to an unsigned integer, rounding toward zero (LLVM `fptoui`).
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The float to convert.
/// :returns: The unsigned integer.
/// :note: An out-of-range or NaN input is poison.
/// :see: {fptoui_sat}
#[external("llvm"), template("{result} = fptoui {TFrom} {val} to {TTo}")]
routine fptoui<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts a float to a signed integer, rounding toward zero, clamping out-of-range inputs to the integer range and mapping NaN to 0.
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The float to convert.
/// :returns: The clamped signed integer.
#[external("llvm"), template("{result} = call {TTo} @llvm.fptosi.sat.{TTo}.{TFrom}({TFrom} {val})")]
routine fptosi_sat<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

/// Converts a float to an unsigned integer, rounding toward zero, clamping out-of-range inputs to the integer range and mapping NaN to 0.
/// :typeparam TFrom: The type of the input value.
/// :typeparam TTo: The type of the result.
/// :param val: The float to convert.
/// :returns: The clamped unsigned integer.
#[external("llvm"), template("{result} = call {TTo} @llvm.fptoui.sat.{TTo}.{TFrom}({TFrom} {val})")]
routine fptoui_sat<TFrom, TTo>(val: TFrom) -> TTo
    require TFrom: typename
    require TTo: typename

// ============================================================
// Overflow detection
//
// Each returns only the overflow flag. The wrapped result is the plain
// add / sub / mul of the same operands.
// ============================================================

/// True when adding `a` and `b` does not fit the signed range of `T`. The wrapped result is the plain `add` of the same operands.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operation overflows.
#[external("llvm"),
    template("{t0} = call {{ {T}, i1 }} @llvm.sadd.with.overflow.{T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine sadd_overflows<T>(a: T, b: T) -> Bool
require T: typename
/// True when adding `a` and `b` does not fit the unsigned range of `T`. The wrapped result is the plain `add` of the same operands.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operation overflows.
#[external("llvm"),
    template("{t0} = call {{ {T}, i1 }} @llvm.uadd.with.overflow.{T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine uadd_overflows<T>(a: T, b: T) -> Bool
require T: typename
/// True when subtracting `a` and `b` does not fit the signed range of `T`. The wrapped result is the plain `sub` of the same operands.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The value to subtract from.
/// :param b: The value to subtract.
/// :returns: True when the operation overflows.
#[external("llvm"),
    template("{t0} = call {{ {T}, i1 }} @llvm.ssub.with.overflow.{T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine ssub_overflows<T>(a: T, b: T) -> Bool
require T: typename
/// True when subtracting `a` and `b` does not fit the unsigned range of `T`. The wrapped result is the plain `sub` of the same operands.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The value to subtract from.
/// :param b: The value to subtract.
/// :returns: True when the operation overflows.
#[external("llvm"),
    template("{t0} = call {{ {T}, i1 }} @llvm.usub.with.overflow.{T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine usub_overflows<T>(a: T, b: T) -> Bool
require T: typename
/// True when multiplying `a` and `b` does not fit the signed range of `T`. The wrapped result is the plain `mul` of the same operands.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operation overflows.
#[external("llvm"),
    template("{t0} = call {{ {T}, i1 }} @llvm.smul.with.overflow.{T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine smul_overflows<T>(a: T, b: T) -> Bool
require T: typename
/// True when multiplying `a` and `b` does not fit the unsigned range of `T`. The wrapped result is the plain `mul` of the same operands.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when the operation overflows.
#[external("llvm"),
    template("{t0} = call {{ {T}, i1 }} @llvm.umul.with.overflow.{T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1")]
routine umul_overflows<T>(a: T, b: T) -> Bool
require T: typename

// ============================================================
// Saturating arithmetic, min / max, funnel shifts, bit reversal
// ============================================================

/// Saturating signed addition: clamps to the signed minimum or maximum of `T` instead of wrapping.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The clamped result.
#[external("llvm"), template("{result} = call {T} @llvm.sadd.sat.{T}({T} {a}, {T} {b})")]
routine sadd_sat<T>(a: T, b: T) -> T
require T: typename
/// Saturating unsigned addition: clamps to the unsigned minimum or maximum of `T` instead of wrapping.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The clamped result.
#[external("llvm"), template("{result} = call {T} @llvm.uadd.sat.{T}({T} {a}, {T} {b})")]
routine uadd_sat<T>(a: T, b: T) -> T
require T: typename
/// Saturating signed subtraction: clamps to the signed minimum or maximum of `T` instead of wrapping.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The value to subtract from.
/// :param b: The value to subtract.
/// :returns: The clamped result.
#[external("llvm"), template("{result} = call {T} @llvm.ssub.sat.{T}({T} {a}, {T} {b})")]
routine ssub_sat<T>(a: T, b: T) -> T
require T: typename
/// Saturating unsigned subtraction: clamps to the unsigned minimum or maximum of `T` instead of wrapping.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The value to subtract from.
/// :param b: The value to subtract.
/// :returns: The clamped result.
#[external("llvm"), template("{result} = call {T} @llvm.usub.sat.{T}({T} {a}, {T} {b})")]
routine usub_sat<T>(a: T, b: T) -> T
require T: typename

/// Smaller of two signed integers.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The smaller value.
#[external("llvm"), template("{result} = call {T} @llvm.smin.{T}({T} {a}, {T} {b})")]
routine smin<T>(a: T, b: T) -> T
require T: typename
/// Larger of two signed integers.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The larger value.
#[external("llvm"), template("{result} = call {T} @llvm.smax.{T}({T} {a}, {T} {b})")]
routine smax<T>(a: T, b: T) -> T
require T: typename
/// Smaller of two unsigned integers.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The smaller value.
#[external("llvm"), template("{result} = call {T} @llvm.umin.{T}({T} {a}, {T} {b})")]
routine umin<T>(a: T, b: T) -> T
require T: typename
/// Larger of two unsigned integers.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The larger value.
#[external("llvm"), template("{result} = call {T} @llvm.umax.{T}({T} {a}, {T} {b})")]
routine umax<T>(a: T, b: T) -> T
require T: typename

/// Funnel shift left: concatenates `hi:lo`, shifts left by `amt` modulo the bit width, and keeps the high half.
/// `fshl(x, x, n)` rotates left.
/// :typeparam T: The operand type, an integer type.
/// :param hi: The high half of the concatenated pair.
/// :param lo: The low half of the concatenated pair.
/// :param amt: The shift amount, taken modulo the bit width.
/// :returns: The high half of the shifted pair.
#[external("llvm"), template("{result} = call {T} @llvm.fshl.{T}({T} {hi}, {T} {lo}, {T} {amt})")]
routine fshl<T>(hi: T, lo: T, amt: T) -> T
require T: typename
/// Funnel shift right: concatenates `hi:lo`, shifts right by `amt` modulo the bit width, and keeps the low half. `fshr(x, x, n)` rotates right.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param hi: The high half of the concatenated pair.
/// :param lo: The low half of the concatenated pair.
/// :param amt: The shift amount, taken modulo the bit width.
/// :returns: The low half of the shifted pair.
#[external("llvm"), template("{result} = call {T} @llvm.fshr.{T}({T} {hi}, {T} {lo}, {T} {amt})")]
routine fshr<T>(hi: T, lo: T, amt: T) -> T
require T: typename

/// Reverses the order of all bits of `val` (LLVM `bitreverse`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The value with its bits reversed.
#[external("llvm"), template("{result} = call {T} @llvm.bitreverse.{T}({T} {val})")]
routine bitreverse<T>(val: T) -> T
require T: typename

// ============================================================
// Floating-point operations
//
// Intrinsic names are written with the LLVM type ({T} = double / float).
// LLVM normalizes them to .f64 / .f32.
// ============================================================

/// Negates a float by flipping its sign bit, so it also negates zeros and NaNs (LLVM `fneg`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The negated value.
#[external("llvm"), template("{result} = fneg {T} {val}")]
routine fneg<T>(val: T) -> T
require T: typename
/// Floating-point remainder with the sign of the dividend, like C `fmod` (LLVM `frem`).
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder.
#[external("llvm"), template("{result} = frem {T} {a}, {b}")]
routine frem<T>(a: T, b: T) -> T
require T: typename
/// Unordered compare: true if either operand is NaN (LLVM `fcmp uno`).
/// :typeparam T: The operand type, a float type.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: True when `a` or `b` is NaN.
#[external("llvm"), template("{result} = fcmp uno {T} {a}, {b}")]
routine funo<T>(a: T, b: T) -> Bool
require T: typename

/// Absolute value of a float: clears the sign bit.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The absolute value.
#[external("llvm"), template("{result} = call {T} @llvm.fabs.{T}({T} {val})")]
routine fabs<T>(val: T) -> T
require T: typename
/// Returns the magnitude of `mag` with the sign of `sign`.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param mag: The value whose magnitude is kept.
/// :param sign: The value whose sign is kept.
/// :returns: The magnitude of `mag` with the sign of `sign`.
#[external("llvm"), template("{result} = call {T} @llvm.copysign.{T}({T} {mag}, {T} {sign})")]
routine copysign<T>(mag: T, sign: T) -> T
require T: typename
/// Fused multiply-add: `a * b + c` with a single rounding.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The first factor.
/// :param b: The second factor.
/// :param c: The value added.
/// :returns: `a * b + c` rounded once.
#[external("llvm"), template("{result} = call {T} @llvm.fma.{T}({T} {a}, {T} {b}, {T} {c})")]
routine fma<T>(a: T, b: T, c: T) -> T
require T: typename

/// Rounds a float down to the nearest integral value.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The rounded value.
#[external("llvm"), template("{result} = call {T} @llvm.floor.{T}({T} {val})")]
routine floor<T>(val: T) -> T
require T: typename
/// Rounds a float up to the nearest integral value.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The rounded value.
#[external("llvm"), template("{result} = call {T} @llvm.ceil.{T}({T} {val})")]
routine ceil<T>(val: T) -> T
require T: typename
/// Rounds a float toward zero to an integral value, keeping the float type.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The truncated value.
#[external("llvm"), template("{result} = call {T} @llvm.trunc.{T}({T} {val})")]
routine ftrunc<T>(val: T) -> T
require T: typename
/// Rounds a float to the nearest integral value, half-way cases away from zero, keeping the float type.
/// :typeparam T: The operand type, a float type.
/// :param val: The value to operate on.
/// :returns: The rounded value.
#[external("llvm"), template("{result} = call {T} @llvm.round.{T}({T} {val})")]
routine round<T>(val: T) -> T
require T: typename
/// Rounds to the nearest integer in the current rounding mode, which is ties to
/// even unless changed. (llvm.roundeven would say so directly, but it lowers to
/// the C23 roundeven, which the Windows C runtime lacks.)
/// :typeparam T: The operand type, a float type.
/// :param val: The value to operate on.
/// :returns: The rounded value.
#[external("llvm"), template("{result} = call {T} @llvm.rint.{T}({T} {val})")]
routine rint<T>(val: T) -> T
require T: typename

/// Smaller of two floats. When one operand is NaN it returns the other. (minnum / maxnum return the other operand
/// when one is NaN, while minimum / maximum propagate NaN and order -0.0 below +0.0.)
/// :typeparam T: The operand type, a float type.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The smaller value.
#[external("llvm"), template("{result} = call {T} @llvm.minnum.{T}({T} {a}, {T} {b})")]
routine minnum<T>(a: T, b: T) -> T
require T: typename
/// Larger of two floats. When one operand is NaN it returns the other.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The larger value.
#[external("llvm"), template("{result} = call {T} @llvm.maxnum.{T}({T} {a}, {T} {b})")]
routine maxnum<T>(a: T, b: T) -> T
require T: typename
/// Smaller of two floats, propagating NaN and ordering `-0.0` below `+0.0`.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The smaller value.
#[external("llvm"), template("{result} = call {T} @llvm.minimum.{T}({T} {a}, {T} {b})")]
routine minimum<T>(a: T, b: T) -> T
require T: typename
/// Larger of two floats, propagating NaN and ordering `-0.0` below `+0.0`.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param a: The left operand.
/// :param b: The right operand.
/// :returns: The larger value.
#[external("llvm"), template("{result} = call {T} @llvm.maximum.{T}({T} {a}, {T} {b})")]
routine maximum<T>(a: T, b: T) -> T
require T: typename

/// Square root of a float.
/// :typeparam T: The operand type, an integer or float type as the operation requires.
/// :param val: The value to operate on.
/// :returns: The square root.
/// :note: A negative input gives NaN.
#[external("llvm"), template("{result} = call {T} @llvm.sqrt.{T}({T} {val})")]
routine sqrt<T>(val: T) -> T
require T: typename
