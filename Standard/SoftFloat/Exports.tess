/// :returns: The nearest F16.
#[export("__truncsfhf2"), no_builtins, target(os: "none")]
private routine export_truncsfhf2(a: F32) -> F16
    block entry()
        r : F16 = a.soft_to<F16>()
        return(r)

/// `__truncdfhf2`: narrows F64 to F16, rounding once to nearest even ({F64.soft_to}).
/// :param a: The value to narrow.
/// :returns: The nearest F16.
#[export("__truncdfhf2"), no_builtins, target(os: "none")]
private routine export_truncdfhf2(a: F64) -> F16
    block entry()
        r : F16 = a.soft_to<F16>()
        return(r)

/// `__truncsfbf2`: narrows F32 to BF16, rounding to nearest even ({F32.soft_to}).
/// :param a: The value to narrow.
/// :returns: The nearest BF16.
#[export("__truncsfbf2"), no_builtins, target(os: "none")]
private routine export_truncsfbf2(a: F32) -> BF16
    block entry()
        r : BF16 = a.soft_to<BF16>()
        return(r)

/// `__truncdfbf2`: narrows F64 to BF16, rounding once to nearest even ({F64.soft_to}).
/// :param a: The value to narrow.
/// :returns: The nearest BF16.
#[export("__truncdfbf2"), no_builtins, target(os: "none")]
private routine export_truncdfbf2(a: F64) -> BF16
    block entry()
        r : BF16 = a.soft_to<BF16>()
        return(r)

