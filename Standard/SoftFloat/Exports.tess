// -- C's square root and remainder ----------------------------------------------

/// `sqrtf`: the B32 square root, correctly rounded ({soft_b32_sqrt}).
/// :param a: The value.
/// :returns: The square root.
#[export("sqrtf"), no_builtins, target(os: "none")]
private routine export_sqrtf(a: B32) -> B32
    r: B32 = .from_bits(soft_b32_sqrt(a.bits()))
    return(r)

/// `sqrt`: the B64 square root, correctly rounded ({soft_b64_sqrt}).
/// :param a: The value.
/// :returns: The square root.
#[export("sqrt"), no_builtins, target(os: "none")]
private routine export_sqrt(a: B64) -> B64
    r: B64 = .from_bits(soft_b64_sqrt(a.bits()))
    return(r)

/// `fmodf`: the B32 remainder, exact ({soft_b32_mod}).
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder, with the sign of `a`.
#[export("fmodf"), no_builtins, target(os: "none")]
private routine export_fmodf(a: B32, b: B32) -> B32
    r: B32 = .from_bits(soft_b32_mod(a: a.bits(), b: b.bits()))
    return(r)

/// `fmod`: the B64 remainder, exact ({soft_b64_mod}).
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder, with the sign of `a`.
#[export("fmod"), no_builtins, target(os: "none")]
private routine export_fmod(a: B64, b: B64) -> B64
    r: B64 = .from_bits(soft_b64_mod(a: a.bits(), b: b.bits()))
    return(r)

// -- integers ------------------------------------------------------------------

/// `__udivsi3`: U32 division, rounding toward zero.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient.
#[export("__udivsi3"), no_builtins, target(os: "none")]
private routine export_udivsi3(n: U32, d: U32) -> U32
    q, rem = soft_divmod(n, d)
    r: U32 = q
    return(r)

