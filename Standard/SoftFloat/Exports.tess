// -- float to float ------------------------------------------------------------

/// `__extendsfdf2`: widens F32 to F64 exactly ({F32.soft_to}).
/// :param a: The value to widen.
/// :returns: The same value as an F64.
#[export("__extendsfdf2"), no_builtins, target(os: "none")]
private routine export_extendsfdf2(a: F32) -> F64
    block entry()
        r : F64 = a.soft_to<F64>()
        return(r)

/// `__truncdfsf2`: narrows F64 to F32, rounding to nearest even ({F64.soft_to}).
/// :param a: The value to narrow.
/// :returns: The nearest F32.
#[export("__truncdfsf2"), no_builtins, target(os: "none")]
private routine export_truncdfsf2(a: F64) -> F32
    block entry()
        r : F32 = a.soft_to<F32>()
        return(r)

/// `__extendhfsf2`: widens F16 to F32 exactly ({F16.soft_to}).
