// -- float to float ------------------------------------------------------------

/// `__extendsfdf2`: widens B32 to B64 exactly ({B32.soft_to}).
/// :param a: The value to widen.
/// :returns: The same value as a B64.
#[export("__extendsfdf2"), no_builtins, target(os: "none")]
private routine export_extendsfdf2(a: B32) -> B64
    r: B64 = a.soft_to[B64]()
    return(r)

/// `__truncdfsf2`: narrows B64 to B32, rounding to nearest even ({B64.soft_to}).
/// :param a: The value to narrow.
/// :returns: The nearest B32.
#[export("__truncdfsf2"), no_builtins, target(os: "none")]
private routine export_truncdfsf2(a: B64) -> B32
    r: B32 = a.soft_to[B32]()
    return(r)

/// `__extendhfsf2`: widens B16 to B32 exactly ({B16.soft_to}).
