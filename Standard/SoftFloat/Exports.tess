        return(r)

/// `__gtsf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and -1 when either is NaN ({soft_f32_ge}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__gtsf2"), no_builtins, target(os: "none")]
private routine export_gtsf2(a: F32, b: F32) -> CInt
    block entry()
        r : CInt = soft_f32_ge(a.bits(), b.bits())
        return(r)

/// `__unordsf2`: 1 when either operand is NaN, else 0.
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: 1 when `a` or `b` is NaN, else 0.
#[export("__unordsf2"), no_builtins, target(os: "none")]
private routine export_unordsf2(a: F32, b: F32) -> CInt
    block entry()
        unordered : Bool = soft_f32_unordered(a.bits(), b.bits())
        r         : CInt = unordered.to<S32>()
        return(r)

