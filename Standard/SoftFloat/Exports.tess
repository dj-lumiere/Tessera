// The 128-bit division helpers, like the 128-bit conversions above, are on every 32-bit target and on 64-bit Windows
// too. The stdlib's own U128 and S128 division never calls them (Div128.tess divides by limbs), but LLVM's udiv / sdiv
// on an i128, which a program can write itself (`udiv<U128>(a, b)`), calls them on riscv32, wasm32, and x32, whose C
// runtime may not have them, and on Windows, whose C runtime doesn't.

/// `__udivti3`: U128 division, rounding toward zero.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient.
#[export("__udivti3"), no_builtins, target(os: ("none", "windows"), size: 64)]
private routine export_udivti3(n: U128, d: U128) -> U128
    block entry()
        q, rem = soft_divmod(n, d)
        r : U128 = q
        return(r)

/// `__udivti3`: U128 division, rounding toward zero.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient.
#[export("__udivti3"), no_builtins, target(size: 32)]
private routine export_udivti3(n: U128, d: U128) -> U128
    block entry()
        q, rem = soft_divmod(n, d)
        r : U128 = q
        return(r)

/// `__umodti3`: the U128 remainder.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The remainder.
#[export("__umodti3"), no_builtins, target(os: ("none", "windows"), size: 64)]
private routine export_umodti3(n: U128, d: U128) -> U128
    block entry()
