    return(r)

/// `__powisf2`: B32 to an integer power ({soft_b32_powi}).
/// :param a: The base.
/// :param n: The exponent.
/// :returns: `a` to the power `n`.
#[export("__powisf2"), no_builtins, target(os: "none")]
private routine export_powisf2(a: B32, n: CInt) -> B32
    r: B32 = .from_bits(soft_b32_powi(a: a.bits(), n))
    return(r)

/// `__powidf2`: B64 to an integer power ({soft_b64_powi}).
/// :param a: The base.
/// :param n: The exponent.
/// :returns: `a` to the power `n`.
#[export("__powidf2"), no_builtins, target(os: "none")]
private routine export_powidf2(a: B64, n: CInt) -> B64
    r: B64 = .from_bits(soft_b64_powi(a: a.bits(), n))
    return(r)

// -- comparison ----------------------------------------------------------------

/// `__eqsf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and 1 when either is NaN ({soft_b32_le}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__eqsf2"), no_builtins, target(os: "none")]
private routine export_eqsf2(a: B32, b: B32) -> CInt
    r: CInt = soft_b32_le(a: a.bits(), b: b.bits())
    return(r)

