// -- 128-bit conversions ---------------------------------------------------------
//
// On a 64-bit target without an operating system, on 64-bit Windows, and on every 32-bit target, hosted or not:
// libgcc builds its 128-bit routines only for 64-bit targets, and compiler-rt only for some 32-bit ones (riscv32,
// wasm32), so a hosted 32-bit target's C runtime may not have them. Windows' C runtime has none of them at all: a
// native build gets them from clang's compiler-rt, but code JIT-compiled in a process (RazorForge's dev loop) has no
// compiler-rt to link, and resolves them from a library that exports these (the way it gets the F16 conversions). A
// 64-bit Linux or macOS target takes them from its own C runtime (libgcc_s, libSystem).

/// `__fixsfti`: F32 to S128, rounding toward zero.
/// :param a: The value to convert.
/// :returns: The integer part of the value.
#[export("__fixsfti"), no_builtins, target(os: ("none", "windows"), size: 64)]
private routine export_fixsfti(a: F32) -> S128
    block entry()
        r : S128 = a.soft_to<S128>()
        return(r)

/// `__fixsfti`: F32 to S128, rounding toward zero.
/// :param a: The value to convert.
/// :returns: The integer part of the value.
#[export("__fixsfti"), no_builtins, target(size: 32)]
private routine export_fixsfti(a: F32) -> S128
    block entry()
        r : S128 = a.soft_to<S128>()
        return(r)

/// `__fixunssfti`: F32 to U128, rounding toward zero.
/// :param a: The value to convert.
/// :returns: The integer part of the value.
