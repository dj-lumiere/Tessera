/// :returns: The nearest B16.
#[export("__truncdfhf2"), no_builtins, target(os: "none")]
private routine export_truncdfhf2(a: B64) -> B16
    r: B16 = a.soft_to[B16]()
    return(r)

/// `__truncsfbf2`: narrows B32 to BF16, rounding to nearest even ({B32.soft_to}).
