// Tessera stdlib: the soft-float routines under the C names LLVM calls
//
// On a target without an operating system there is no compiler-rt or libgcc to link, so the stdlib exports the
// routines LLVM's lowering calls there by their C names: float arithmetic, comparison, and conversion where the
// target has no floating-point unit (arm-none-eabi, riscv32-none-elf), the F16, BF16, and 128-bit integer
// conversions that x86_64 and AArch64 call too, the integer division, multiplication, and leading-zero helpers of
// cores without those instructions, and C's sqrtf / sqrt / fmodf / fmod, which LLVM calls for `F32.sqrt` and
// `frem`. 32-bit ARM calls most of them by its run-time ABI's names instead (Aeabi.tess).
//
// Each takes and returns the types its C declaration has, so a definition here and LLVM's call agree on the
// target's calling convention whatever it is (a float in an integer register on a soft-float target, in an SSE
// register on x86_64). Each is weak, so a program's own definition, or a C library it links, wins. Each is also
// #no_builtins, so LLVM can't turn its body into a call. The bodies are Standard/SoftFloat's integer routines,
// which any target can call (the hosted tests check them against the hardware).
//
// The 128-bit division and float conversion helpers are exported on hosted 32-bit targets too, whose C runtime may
// lack them (libgcc builds them only for 64-bit targets), and on 64-bit Windows, whose C runtime has none of them
// (only clang's compiler-rt does, which an in-process JIT doesn't link).

module Standard::Core

// -- arithmetic ----------------------------------------------------------------

/// `__addsf3`: F32 addition ({soft_f32_add}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The sum.
#[export("__addsf3"), no_builtins, target(os: "none")]
private routine export_addsf3(a: F32, b: F32) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_add(a.bits(), b.bits()))
        return(r)

/// `__subsf3`: F32 subtraction ({soft_f32_sub}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The difference `a - b`.
#[export("__subsf3"), no_builtins, target(os: "none")]
private routine export_subsf3(a: F32, b: F32) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_sub(a.bits(), b.bits()))
        return(r)

/// `__mulsf3`: F32 multiplication ({soft_f32_mul}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The product.
#[export("__mulsf3"), no_builtins, target(os: "none")]
private routine export_mulsf3(a: F32, b: F32) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_mul(a.bits(), b.bits()))
        return(r)

/// `__divsf3`: F32 division ({soft_f32_div}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The quotient `a / b`.
#[export("__divsf3"), no_builtins, target(os: "none")]
private routine export_divsf3(a: F32, b: F32) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_div(a.bits(), b.bits()))
        return(r)

/// `__adddf3`: F64 addition ({soft_f64_add}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The sum.
#[export("__adddf3"), no_builtins, target(os: "none")]
private routine export_adddf3(a: F64, b: F64) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_add(a.bits(), b.bits()))
        return(r)

/// `__subdf3`: F64 subtraction ({soft_f64_sub}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The difference `a - b`.
#[export("__subdf3"), no_builtins, target(os: "none")]
private routine export_subdf3(a: F64, b: F64) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_sub(a.bits(), b.bits()))
        return(r)

/// `__muldf3`: F64 multiplication ({soft_f64_mul}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The product.
#[export("__muldf3"), no_builtins, target(os: "none")]
private routine export_muldf3(a: F64, b: F64) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_mul(a.bits(), b.bits()))
        return(r)

/// `__divdf3`: F64 division ({soft_f64_div}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The quotient `a / b`.
#[export("__divdf3"), no_builtins, target(os: "none")]
private routine export_divdf3(a: F64, b: F64) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_div(a.bits(), b.bits()))
        return(r)

/// `__powisf2`: F32 to an integer power ({soft_f32_powi}).
/// :param a: The base.
/// :param n: The exponent.
/// :returns: `a` to the power `n`.
#[export("__powisf2"), no_builtins, target(os: "none")]
private routine export_powisf2(a: F32, n: CInt) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_powi(a.bits(), n))
        return(r)

/// `__powidf2`: F64 to an integer power ({soft_f64_powi}).
/// :param a: The base.
/// :param n: The exponent.
/// :returns: `a` to the power `n`.
#[export("__powidf2"), no_builtins, target(os: "none")]
private routine export_powidf2(a: F64, n: CInt) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_powi(a.bits(), n))
        return(r)

// -- comparison ----------------------------------------------------------------

/// `__eqsf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and 1 when either is NaN ({soft_f32_le}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__eqsf2"), no_builtins, target(os: "none")]
private routine export_eqsf2(a: F32, b: F32) -> CInt
    block entry()
        r : CInt = soft_f32_le(a.bits(), b.bits())
        return(r)

/// `__nesf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and 1 when either is NaN ({soft_f32_le}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__nesf2"), no_builtins, target(os: "none")]
private routine export_nesf2(a: F32, b: F32) -> CInt
    block entry()
        r : CInt = soft_f32_le(a.bits(), b.bits())
        return(r)

/// `__ltsf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and 1 when either is NaN ({soft_f32_le}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__ltsf2"), no_builtins, target(os: "none")]
private routine export_ltsf2(a: F32, b: F32) -> CInt
    block entry()
        r : CInt = soft_f32_le(a.bits(), b.bits())
        return(r)

/// `__lesf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and 1 when either is NaN ({soft_f32_le}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__lesf2"), no_builtins, target(os: "none")]
private routine export_lesf2(a: F32, b: F32) -> CInt
    block entry()
        r : CInt = soft_f32_le(a.bits(), b.bits())
        return(r)

/// `__gesf2`: -1, 0, or 1 as `a` is below, equal to, or above `b`, and -1 when either is NaN ({soft_f32_ge}).
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: The ordering: -1, 0, or 1.
#[export("__gesf2"), no_builtins, target(os: "none")]
private routine export_gesf2(a: F32, b: F32) -> CInt
    block entry()
