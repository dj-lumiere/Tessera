/// :returns: The nearest BF16.
#[export("__truncsfbf2"), no_builtins, target(os: "none")]
private routine export_truncsfbf2(a: B32) -> BF16
    r: BF16 = a.soft_to[BF16]()
    return(r)

/// `__truncdfbf2`: narrows B64 to BF16, rounding once to nearest even ({B64.soft_to}).
