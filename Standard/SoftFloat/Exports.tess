/// `__unordsf2`: 1 when either operand is NaN, else 0.
/// :param a: The first operand.
/// :param b: The second operand.
/// :returns: 1 when `a` or `b` is NaN, else 0.
#[export("__unordsf2"), no_builtins, target(os: "none")]
private routine export_unordsf2(a: B32, b: B32) -> CInt
    unordered: Bool = soft_b32_unordered(a: a.bits(), b: b.bits())
    r: CInt = unordered.to[S32]()
    return(r)

