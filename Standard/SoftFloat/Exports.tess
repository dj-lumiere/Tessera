// -- C's square root and remainder ----------------------------------------------

/// `sqrtf`: the F32 square root, correctly rounded ({soft_f32_sqrt}).
/// :param a: The value.
/// :returns: The square root.
#[export("sqrtf"), no_builtins, target(os: "none")]
private routine export_sqrtf(a: F32) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_sqrt(a.bits()))
        return(r)

/// `sqrt`: the F64 square root, correctly rounded ({soft_f64_sqrt}).
/// :param a: The value.
/// :returns: The square root.
#[export("sqrt"), no_builtins, target(os: "none")]
private routine export_sqrt(a: F64) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_sqrt(a.bits()))
        return(r)

/// `fmodf`: the F32 remainder, exact ({soft_f32_mod}).
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder, with the sign of `a`.
#[export("fmodf"), no_builtins, target(os: "none")]
private routine export_fmodf(a: F32, b: F32) -> F32
    block entry()
        r : F32 = .from_bits(soft_f32_mod(a.bits(), b.bits()))
        return(r)

/// `fmod`: the F64 remainder, exact ({soft_f64_mod}).
/// :param a: The dividend.
/// :param b: The divisor.
/// :returns: The remainder, with the sign of `a`.
#[export("fmod"), no_builtins, target(os: "none")]
private routine export_fmod(a: F64, b: F64) -> F64
    block entry()
        r : F64 = .from_bits(soft_f64_mod(a.bits(), b.bits()))
        return(r)

// -- integers ------------------------------------------------------------------

/// `__udivsi3`: U32 division, rounding toward zero.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient.
#[export("__udivsi3"), no_builtins, target(os: "none")]
private routine export_udivsi3(n: U32, d: U32) -> U32
    block entry()
        q, rem = soft_divmod(n, d)
        r : U32 = q
        return(r)

/// `__umodsi3`: the U32 remainder.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The remainder.
