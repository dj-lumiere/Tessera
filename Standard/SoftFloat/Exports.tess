/// `__mulsi3`: the low 32 bits of a product, without a multiply instruction.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The product, wrapped to 32 bits.
#[export("__mulsi3"), no_builtins, target(os: "none")]
private routine export_mulsi3(a: U32, b: U32) -> U32
    block entry()
        r : U32 = soft_mul(a, b)
        return(r)

/// `__muldi3`: the low 64 bits of a product, without a 64-bit multiply.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The product, wrapped to 64 bits.
#[export("__muldi3"), no_builtins, target(os: "none")]
private routine export_muldi3(a: U64, b: U64) -> U64
    block entry()
        r : U64 = soft_mul(a, b)
        return(r)

/// `__clzsi2`: the number of leading zero bits, 32 for 0.
/// :param x: The value.
/// :returns: The count, from 0 to 32.
#[export("__clzsi2"), no_builtins, target(os: "none")]
private routine export_clzsi2(x: U32) -> CInt
    block entry()
        count : U32  = soft_u32_leading_zeros(x)
        r     : CInt = count.to_wrap<S32>()
        return(r)
