/// S128 to F16, rounded once to nearest (ties to even): compiler-rt's `__floattihf`, which LLVM calls on x86_64
/// and AArch64.
/// :returns: The nearest F16, or infinity from 65520 in magnitude up.
#[inline, no_builtins]
routine S128.soft_to<F16>(me: Me) -> F16
    block entry()
        bits : U32 = soft_float32_from(me.lt(0), me.abs_diff(0), F16.FORMAT.load())
        r    : U16 = bits.to_wrap<U16>()
        return(bitcast<U16, F16>(r))

/// U128 to F16, rounded once to nearest (ties to even): compiler-rt's `__floatuntihf`, which LLVM calls on
/// x86_64 and AArch64.
/// :returns: The nearest F16, or infinity from 65520 up.
#[inline, no_builtins]
routine U128.soft_to<F16>(me: Me) -> F16
    block entry()
        bits : U32 = soft_float32_from(false, me, F16.FORMAT.load())
        r    : U16 = bits.to_wrap<U16>()
        return(bitcast<U16, F16>(r))
