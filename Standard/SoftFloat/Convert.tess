// Tessera stdlib: float conversions in software
//
// The conversions LLVM calls a routine for on a target without a floating-point unit, or without instructions for
// F16 and BF16 (x86_64 calls __extendhfsf2 and __truncsfbf2 too): between the float formats, and between floats and
// 32-, 64-, and 128-bit integers. Integer operations only, on the bits. Exports.tess and Aeabi.tess export them.
// Each is `x.soft_to<T>()`, shaped like the conversion `x.to<T>()` it implements but under its own name: on these
// targets LLVM lowers `to<T>` to a call of the routine exported here, so a routine named `to<T>` would call itself.
// The ones that give a float are #inline and make it with bitcast, so the value never comes back through a call:
// 32-bit x86 returns a float on the x87 stack, which quiets a signaling NaN that widening must keep.
//
// Widening is exact and keeps a NaN's payload as it is (a signaling NaN stays signaling, as in compiler-rt).
// Narrowing rounds to nearest, ties to even, into the subnormals and up to infinity. A NaN keeps its sign and the top
// of its payload and is made quiet. Float to integer rounds toward zero as compiler-rt does: a value in range
// converts exactly, a value of 2^width or more (infinity and NaN too) saturates by its sign, and an unsigned
// conversion of a negative value is 0. LLVM leaves an out-of-range conversion undefined and checks the range itself
// for the saturating ones, so only the in-range results are the language's. The rest match compiler-rt's.
// Integer to float rounds to nearest, ties to even.

module Standard::Core

// -- widening ------------------------------------------------------------------

/// Widens F32 to F64, exactly: compiler-rt's `__extendsfdf2`.
/// :returns: The same value as an F64. A NaN keeps its payload, moved to the top of the fraction.
#[inline, no_builtins]
routine F32.soft_to<F64>(me: Me) -> F64
    shared a    : U32 = me.bits()
    shared high : U64 = a.bitand(0x80000000).to<U64>()
    shared sign : U64 = high.shl(32)
    shared size : U32 = a.bitand(0x7FFFFFFF)

    block entry()
        when
            size.ge(0x7F800000) -> special()
            size.eq(0)          -> return(bitcast<U64, F64>(sign))
            else                -> finite()

    block special()
        fraction : U64 = size.bitand(0x007FFFFF).to<U64>()
        r        : U64 = sign.bitor(0x7FF0000000000000).bitor(fraction.shl(29))
        return(bitcast<U64, F64>(r))

    // a subnormal F32 is normal in F64
    block finite()
        parts    : SoftParts32 = soft_unpack(size, 23)
        field    : U64         = parts.exponent.add(896).to<U64>()
        fraction : U64         = parts.sig.bitand(0x007FFFFF).to<U64>()
        r        : U64         = sign.bitor(field.shl(52)).bitor(fraction.shl(29))
        return(bitcast<U64, F64>(r))

/// Widens F16 to F32, exactly: compiler-rt's `__extendhfsf2`.
/// :returns: The same value as an F32. A NaN keeps its payload, moved to the top of the fraction.
#[inline, no_builtins]
routine F16.soft_to<F32>(me: Me) -> F32
    shared a    : U16 = me.bits()
    shared bits : U32 = a.to<U32>()
    shared sign : U32 = bits.bitand(0x8000).shl(16)
    shared size : U32 = bits.bitand(0x7FFF)

    block entry()
        when
            size.ge(0x7C00) -> special()
            size.eq(0)      -> return(bitcast<U32, F32>(sign))
            else            -> finite()

    block special()
        payload : U32 = size.bitand(0x03FF).shl(13)
        r       : U32 = sign.bitor(0x7F800000).bitor(payload)
        return(bitcast<U32, F32>(r))

    // a subnormal F16 is normal in F32
    block finite()
        parts    : SoftParts32 = soft_unpack(size, 10)
        field    : U32         = parts.exponent.add(112).to<U32>()
        fraction : U32         = parts.sig.bitand(0x03FF)
        r        : U32         = sign.bitor(field.shl(23)).bitor(fraction.shl(13))
        return(bitcast<U32, F32>(r))

// -- narrowing -----------------------------------------------------------------

/// Narrows F64 to F32, rounding to nearest (ties to even): compiler-rt's `__truncdfsf2`.
/// :returns: The nearest F32.
#[inline, no_builtins]
routine F64.soft_to<F32>(me: Me) -> F32
    block entry()
        a : U64 = me.bits()
        r : U32 = soft_narrow(a, F32.FORMAT.load())
        return(bitcast<U32, F32>(r))

/// Narrows F64 to F16, rounding once to nearest (ties to even): compiler-rt's `__truncdfhf2`.
/// :returns: The nearest F16.
#[inline, no_builtins]
routine F64.soft_to<F16>(me: Me) -> F16
    block entry()
        a : U64 = me.bits()
        r : U16 = soft_narrow(a, F16.FORMAT.load()).to_wrap<U16>()
        return(bitcast<U16, F16>(r))

/// Narrows F64 to BF16, rounding once to nearest (ties to even): compiler-rt's `__truncdfbf2`.
/// :returns: The nearest BF16.
#[inline, no_builtins]
routine F64.soft_to<BF16>(me: Me) -> BF16
    block entry()
        a : U64 = me.bits()
        r : U16 = soft_narrow(a, BF16.FORMAT.load()).to_wrap<U16>()
        return(bitcast<U16, BF16>(r))

/// Narrows F32 to F16, rounding to nearest (ties to even): compiler-rt's `__truncsfhf2`.
/// :returns: The nearest F16.
#[inline, no_builtins]
routine F32.soft_to<F16>(me: Me) -> F16
    block entry()
        a : U32 = me.bits()
        r : U16 = soft_narrow(a, F16.FORMAT.load()).to_wrap<U16>()
        return(bitcast<U16, F16>(r))

/// Narrows F32 to BF16, rounding to nearest (ties to even): compiler-rt's `__truncsfbf2`.
/// :returns: The nearest BF16. An F32 subnormal becomes a BF16 subnormal or zero.
#[inline, no_builtins]
routine F32.soft_to<BF16>(me: Me) -> BF16
    block entry()
        a : U32 = me.bits()
        r : U16 = soft_narrow(a, BF16.FORMAT.load()).to_wrap<U16>()
        return(bitcast<U16, BF16>(r))

/// Narrows F64 bits into a binary format whose bits fit in a U32, rounding to nearest (ties to even).
/// :param a: The F64's bits.
/// :param format: The narrower format (F32, F16, or BF16).
/// :returns: The format's bits, in the low bits of a U32.
#inline
routine soft_narrow(a: U64, format: FloatFormat) -> U32
    shared sig_bits     : U32  = format.fraction_bits
    shared bias         : S32  = format.bias
    shared max_exponent : S32  = format.exponent_max
    shared negative     : Bool = a.ge(0x8000000000000000)
    shared sign         : U32  = negative
        ? format.sign_bit()
        : 0
    shared size : U64 = a.bitand(0x7FFFFFFFFFFFFFFF)

    block entry()
        infinity : U32 = max_exponent.to<U32>().shl(sig_bits)
        when
            size.gt(0x7FF0000000000000) -> nan(sign.bitor(infinity))
            size.eq(0x7FF0000000000000) -> return(sign.bitor(infinity))
            size.eq(0)                  -> return(sign)
            else                        -> finite()

    // the top of the payload, made quiet
    block nan(signed_infinity: U32)
        quiet   : U32 = U32.shl(1, sig_bits.sub(1))
        shift   : U64 = U32.sub(52, sig_bits).to<U64>()
        top     : U64 = size.bitand(0x000FFFFFFFFFFFFF).shr(shift)
        payload : U32 = top.to_wrap<U32>()
        r       : U32 = signed_infinity.bitor(quiet).bitor(payload)
        return(r)

    // a subnormal F64 sits at exponent 1 without the implicit bit. The significand drops to 27 bits with a sticky
    // bit, which the narrower format's rounding needs no more than
    block finite()
        field    : U64  = size.shr(52)
        normal   : Bool = field.ne(0)
        fraction : U64  = size.bitand(0x000FFFFFFFFFFFFF)
        sig      : U64  = normal
            ? fraction.bitor(0x0010000000000000)
            : fraction
        stored : S32 = normal
            ? field.to_wrap<S32>()
            : 1
        narrow   : U64 = soft_shr_sticky(sig, 26)
        scale    : S32 = bias.add(sig_bits.to<S32>())
        exponent : S32 = stored.add(scale).sub(1046)
        r        : U32 = soft_round_pack(sign, exponent, narrow.to_wrap<U32>(), format)
        return(r)

/// Narrows F32 bits into F16 or BF16, rounding to nearest (ties to even).
/// :param a: The F32's bits.
/// :param format: The narrower format (F16 or BF16).
/// :returns: The format's bits, in the low 16 bits of a U32.
#inline
routine soft_narrow(a: U32, format: FloatFormat) -> U32
    shared sig_bits     : U32 = format.fraction_bits
    shared bias         : S32 = format.bias
    shared max_exponent : S32 = format.exponent_max
    shared sign         : U32 = a.shr(16).bitand(0x8000)
    shared size         : U32 = a.bitand(0x7FFFFFFF)

    block entry()
        infinity : U32 = max_exponent.to<U32>().shl(sig_bits)
        when
            size.gt(0x7F800000) -> nan(sign.bitor(infinity))
            size.eq(0x7F800000) -> return(sign.bitor(infinity))
            size.eq(0)          -> return(sign)
            else                -> finite()

    block nan(signed_infinity: U32)
        quiet   : U32 = U32.shl(1, sig_bits.sub(1))
        payload : U32 = size.bitand(0x007FFFFF).shr(U32.sub(23, sig_bits))
        r       : U32 = signed_infinity.bitor(quiet).bitor(payload)
        return(r)

    block finite()
        field    : U32  = size.shr(23)
        normal   : Bool = field.ne(0)
        fraction : U32  = size.bitand(0x007FFFFF)
        sig      : U32  = normal
            ? fraction.bitor(0x00800000)
            : fraction
        stored : S32 = normal
            ? field.to<S32>()
            : 1
        scale    : S32 = bias.add(sig_bits.to<S32>())
        exponent : S32 = stored.add(scale).sub(147)
        r        : U32 = soft_round_pack(sign, exponent, sig, format)
        return(r)

// -- float to integer ----------------------------------------------------------

/// Converts float bits to an integer of at most 64 bits, rounding toward zero, as compiler-rt's `__fix*` and
/// `__fixuns*` do.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format (F32 or F64).
/// :param width: The integer's width, 32 or 64.
/// :param signed: Whether the integer is signed.
/// :returns: The integer's bits in the low `width` bits.
#inline
routine soft_fix(bits: U64, format: FloatFormat, width: U64, signed: Bool) -> U64
    shared all      : U64  = U64.shl(1, width).sub_wrap(1)
    shared negative : Bool = soft_is_negative(bits, format)
    shared sig      : U64  = soft_sig(bits, format)
    shared sig_bits : S32  = format.fraction_bits.to<S32>()

    block entry()
        field    : S32  = soft_field(bits, format)
        exponent : S32  = field.sub(format.bias)
        largest  : U64  = all.shr(1)
        unsigned : Bool = signed.bitnot()
        huge     : Bool = exponent.ge(width.to_wrap<S32>())
        when
            exponent.lt(0)            -> return(0)
            unsigned.bitand(negative) -> return(0)
            huge.bitand(signed)       -> return(negative ? largest.add(1) : largest)
            huge                      -> return(all)
            exponent.lt(sig_bits)     -> down(sig_bits.sub(exponent).to<U64>())
            else                      -> up(exponent.sub(sig_bits).to<U64>())

    block down(shift: U64)
        jump done(sig.shr(shift))

    block up(shift: U64)
        jump done(sig.shl(shift))

    block done(magnitude: U64)
        twos : U64 = U64.sub_wrap(0, magnitude)
        r    : U64 = negative
            ? twos
            : magnitude
        return(r.bitand(all))

/// {soft_fix} for 128-bit integers.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format (F16, F32, or F64).
/// :param signed: Whether the integer is signed.
/// :returns: The integer's bits.
#inline
routine soft_fix(bits: U64, format: FloatFormat, signed: Bool) -> U128
    shared negative : Bool = soft_is_negative(bits, format)
    shared narrow   : U64  = soft_sig(bits, format)
    shared sig      : U128 = narrow.to<U128>()
    shared sig_bits : S32  = format.fraction_bits.to<S32>()

    block entry()
        field    : S32  = soft_field(bits, format)
        exponent : S32  = field.sub(format.bias)
        unsigned : Bool = signed.bitnot()
        largest  : U128 = U128.MAX.shr(1)
        when
            exponent.lt(0)                  -> return(0)
            unsigned.bitand(negative)       -> return(0)
            exponent.ge(128).bitand(signed) -> return(negative ? largest.add(1) : largest)
            exponent.ge(128)                -> return(U128.MAX)
            exponent.lt(sig_bits)           -> down(sig_bits.sub(exponent).to<U128>())
            else                            -> up(exponent.sub(sig_bits).to<U128>())

    block down(shift: U128)
        jump done(sig.shr(shift))

    block up(shift: U128)
        jump done(sig.shl(shift))

    block done(magnitude: U128)
        twos : U128 = U128.sub_wrap(0, magnitude)
        r    : U128 = negative
            ? twos
            : magnitude
        return(r)

/// F32 to S32, rounding toward zero: compiler-rt's `__fixsfsi`.
/// :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
#no_builtins
routine F32.soft_to<S32>(me: Me) -> S32
    block entry()
        a    : U64 = me.bits().to<U64>()
        bits : U64 = soft_fix(a, Me.FORMAT.load(), 32, true)
        r    : S32 = bits.to_wrap<U32>().to_wrap<S32>()
        return(r)

/// F32 to U32, rounding toward zero: compiler-rt's `__fixunssfsi`.
/// :returns: The integer, 0 for a negative value, U32.MAX from 2^32 up.
#no_builtins
routine F32.soft_to<U32>(me: Me) -> U32
    block entry()
        a    : U64 = me.bits().to<U64>()
        bits : U64 = soft_fix(a, Me.FORMAT.load(), 32, false)
        r    : U32 = bits.to_wrap<U32>()
        return(r)

/// F32 to S64, rounding toward zero: compiler-rt's `__fixsfdi`.
/// :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
#no_builtins
routine F32.soft_to<S64>(me: Me) -> S64
    block entry()
        a    : U64 = me.bits().to<U64>()
        bits : U64 = soft_fix(a, Me.FORMAT.load(), 64, true)
        r    : S64 = bits.to_wrap<S64>()
        return(r)

/// F32 to U64, rounding toward zero: compiler-rt's `__fixunssfdi`.
/// :returns: The integer, 0 for a negative value, U64.MAX from 2^64 up.
#no_builtins
routine F32.soft_to<U64>(me: Me) -> U64
    block entry()
        a : U64 = me.bits().to<U64>()
        r : U64 = soft_fix(a, Me.FORMAT.load(), 64, false)
        return(r)

/// F32 to S128, rounding toward zero: compiler-rt's `__fixsfti`.
/// :returns: The integer. Out of range, compiler-rt's saturated value.
#no_builtins
routine F32.soft_to<S128>(me: Me) -> S128
    block entry()
        a    : U64  = me.bits().to<U64>()
        bits : U128 = soft_fix(a, Me.FORMAT.load(), true)
        r    : S128 = bits.to_wrap<S128>()
        return(r)

/// F32 to U128, rounding toward zero: compiler-rt's `__fixunssfti`.
/// :returns: The integer, 0 for a negative value, U128.MAX for infinity and NaN.
#no_builtins
routine F32.soft_to<U128>(me: Me) -> U128
    block entry()
        a : U64  = me.bits().to<U64>()
        r : U128 = soft_fix(a, Me.FORMAT.load(), false)
        return(r)

/// F64 to S32, rounding toward zero: compiler-rt's `__fixdfsi`.
/// :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
#no_builtins
routine F64.soft_to<S32>(me: Me) -> S32
    block entry()
        bits : U64 = soft_fix(me.bits(), Me.FORMAT.load(), 32, true)
        r    : S32 = bits.to_wrap<U32>().to_wrap<S32>()
        return(r)

/// F64 to U32, rounding toward zero: compiler-rt's `__fixunsdfsi`.
/// :returns: The integer, 0 for a negative value, U32.MAX from 2^32 up.
#no_builtins
routine F64.soft_to<U32>(me: Me) -> U32
    block entry()
        bits : U64 = soft_fix(me.bits(), Me.FORMAT.load(), 32, false)
        r    : U32 = bits.to_wrap<U32>()
        return(r)

/// F64 to S64, rounding toward zero: compiler-rt's `__fixdfdi`.
/// :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
#no_builtins
routine F64.soft_to<S64>(me: Me) -> S64
    block entry()
        bits : U64 = soft_fix(me.bits(), Me.FORMAT.load(), 64, true)
        r    : S64 = bits.to_wrap<S64>()
        return(r)

/// F64 to U64, rounding toward zero: compiler-rt's `__fixunsdfdi`.
/// :returns: The integer, 0 for a negative value, U64.MAX from 2^64 up.
#no_builtins
routine F64.soft_to<U64>(me: Me) -> U64
    block entry()
        r : U64 = soft_fix(me.bits(), Me.FORMAT.load(), 64, false)
        return(r)

/// F64 to S128, rounding toward zero: compiler-rt's `__fixdfti`.
/// :returns: The integer. Out of range, compiler-rt's saturated value.
#no_builtins
routine F64.soft_to<S128>(me: Me) -> S128
    block entry()
        bits : U128 = soft_fix(me.bits(), Me.FORMAT.load(), true)
        r    : S128 = bits.to_wrap<S128>()
        return(r)

/// F64 to U128, rounding toward zero: compiler-rt's `__fixunsdfti`.
/// :returns: The integer, 0 for a negative value, U128.MAX from 2^128 up.
#no_builtins
routine F64.soft_to<U128>(me: Me) -> U128
    block entry()
        r : U128 = soft_fix(me.bits(), Me.FORMAT.load(), false)
        return(r)

/// F16 to S128, rounding toward zero: compiler-rt's `__fixhfti`, which LLVM calls on x86_64 and AArch64.
/// :returns: The integer. Every finite F16 is in range. Infinity and NaN give what compiler-rt computes for them.
#no_builtins
routine F16.soft_to<S128>(me: Me) -> S128
    block entry()
        a    : U64  = me.bits().to<U64>()
        bits : U128 = soft_fix(a, Me.FORMAT.load(), true)
        r    : S128 = bits.to_wrap<S128>()
        return(r)

/// F16 to U128, rounding toward zero: compiler-rt's `__fixunshfti`, which LLVM calls on x86_64 and AArch64.
/// :returns: The integer, 0 for a negative value.
#no_builtins
routine F16.soft_to<U128>(me: Me) -> U128
    block entry()
        a : U64  = me.bits().to<U64>()
        r : U128 = soft_fix(a, Me.FORMAT.load(), false)
        return(r)

/// Whether float bits are negative: the format's sign bit.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format.
/// :returns: True when the sign bit is set.
#inline
private routine soft_is_negative(bits: U64, format: FloatFormat) -> Bool
    block entry()
        top  : U64 = format.width.sub(1).to<U64>()
        sign : U64 = bits.shr(top).bitand(1)
        return(sign.eq(1))

/// The biased exponent field of float bits.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format.
/// :returns: The exponent field, from 0 to the format's all-ones field.
#inline
private routine soft_field(bits: U64, format: FloatFormat) -> S32
    block entry()
        mask  : U64 = format.exponent_max.to<U64>()
        field : U64 = bits.shr(format.fraction_bits.to<U64>()).bitand(mask)
        r     : S32 = field.to_wrap<S32>()
        return(r)

/// The significand of float bits with the implicit bit set.
/// :param bits: The float's bits, in the low `format.width` bits.
/// :param format: The float's format.
/// :returns: The fraction bits with the implicit bit above them set.
#inline
private routine soft_sig(bits: U64, format: FloatFormat) -> U64
    block entry()
        implicit : U64 = U64.shl(1, format.fraction_bits.to<U64>())
        fraction : U64 = bits.bitand(implicit.sub(1))
        return(fraction.bitor(implicit))

// -- integer to float ----------------------------------------------------------

/// Rounds an integer magnitude of at most 64 bits into a binary format whose bits fit in a U32.
/// :param negative: Whether the integer was negative.
/// :param magnitude: Its magnitude.
/// :param format: The format (F32 or F16).
/// :returns: The format's bits, 0 for 0.
#inline
routine soft_float32_from(negative: Bool, magnitude: U64, format: FloatFormat) -> U32
    block entry()
        zero : Bool = magnitude.eq(0)
        branch zero
            ? return(0)
            : continue
        lead   : U64 = U64.sub(63, magnitude.leading_zeros())
        shift  : U64 = lead.sub_clamp(31)
        narrow : U64 = soft_shr_sticky(magnitude, shift)
        sign   : U32 = negative
            ? format.sign_bit()
            : 0
        scale    : S32 = format.bias.add(format.fraction_bits.to<S32>())
        exponent : S32 = scale.add(shift.to_wrap<S32>().add(3))
        r        : U32 = soft_round_pack(sign, exponent, narrow.to_wrap<U32>(), format)
        return(r)

/// {soft_float32_from} for a 128-bit magnitude.
/// :param negative: Whether the integer was negative.
/// :param magnitude: Its magnitude.
/// :param format: The format (F32 or F16).
/// :returns: The format's bits, 0 for 0.
#inline
routine soft_float32_from(negative: Bool, magnitude: U128, format: FloatFormat) -> U32
    block entry()
        zero : Bool = magnitude.eq(0)
        branch zero
            ? return(0)
            : continue
        lead   : U128 = U128.sub(127, magnitude.leading_zeros())
        shift  : U128 = lead.sub_clamp(31)
        narrow : U128 = soft_shr_sticky(magnitude, shift)
        sign   : U32  = negative
            ? format.sign_bit()
            : 0
        scale    : S32 = format.bias.add(format.fraction_bits.to<S32>())
        exponent : S32 = scale.add(shift.to_wrap<S32>().add(3))
        r        : U32 = soft_round_pack(sign, exponent, narrow.to_wrap<U32>(), format)
        return(r)

/// Rounds an integer magnitude of at most 64 bits into F64 bits.
/// :param negative: Whether the integer was negative.
/// :param magnitude: Its magnitude.
/// :returns: The F64 bits, 0 for 0.
#inline
routine soft_float64_from(negative: Bool, magnitude: U64) -> U64
    block entry()
        zero : Bool = magnitude.eq(0)
        sign : U64  = negative
            ? 0x8000000000000000
            : 0
        branch zero
            ? return(0)
            : return(soft_round_pack(sign, 1078, magnitude))

/// Rounds a 128-bit integer magnitude into F64 bits.
/// :param negative: Whether the integer was negative.
/// :param magnitude: Its magnitude.
/// :returns: The F64 bits, 0 for 0.
#inline
routine soft_float64_from(negative: Bool, magnitude: U128) -> U64
    block entry()
        zero : Bool = magnitude.eq(0)
        branch zero
            ? return(0)
            : continue
        lead   : U128 = U128.sub(127, magnitude.leading_zeros())
        shift  : U128 = lead.sub_clamp(63)
        narrow : U128 = soft_shr_sticky(magnitude, shift)
        sign   : U64  = negative
            ? 0x8000000000000000
            : 0
        exponent : S32 = shift.to_wrap<S32>().add(1078)
        r        : U64 = soft_round_pack(sign, exponent, narrow.to_wrap<U64>())
        return(r)

/// S32 to F32, rounded to nearest (ties to even): compiler-rt's `__floatsisf`.
/// :returns: The nearest F32.
#[inline, no_builtins]
routine S32.soft_to<F32>(me: Me) -> F32
    block entry()
        r : U32 = soft_float32_from(me.lt(0), me.abs_diff(0).to<U64>(), F32.FORMAT.load())
        return(bitcast<U32, F32>(r))

/// U32 to F32, rounded to nearest (ties to even): compiler-rt's `__floatunsisf`.
/// :returns: The nearest F32.
#[inline, no_builtins]
routine U32.soft_to<F32>(me: Me) -> F32
    block entry()
        r : Me = soft_float32_from(false, me.to<U64>(), F32.FORMAT.load())
        return(bitcast<Me, F32>(r))

/// S64 to F32, rounded to nearest (ties to even): compiler-rt's `__floatdisf`.
/// :returns: The nearest F32.
#[inline, no_builtins]
routine S64.soft_to<F32>(me: Me) -> F32
    block entry()
        r : U32 = soft_float32_from(me.lt(0), me.abs_diff(0), F32.FORMAT.load())
        return(bitcast<U32, F32>(r))

