#[inline, no_builtins]
routine U128.soft_to<F32>(me: Me) -> F32
    block entry()
        r : U32 = soft_float32_from(false, me, F32.FORMAT.load())
        return(bitcast<U32, F32>(r))

/// S32 to F64, exactly: compiler-rt's `__floatsidf`.
/// :returns: The F64.
#[inline, no_builtins]
routine S32.soft_to<F64>(me: Me) -> F64
    block entry()
        r : U64 = soft_float64_from(me.lt(0), me.abs_diff(0).to<U64>())
        return(bitcast<U64, F64>(r))

/// U32 to F64, exactly: compiler-rt's `__floatunsidf`.
/// :returns: The F64.
#[inline, no_builtins]
routine U32.soft_to<F64>(me: Me) -> F64
