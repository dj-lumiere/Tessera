#[inline, no_builtins]
routine S64.soft_to<F64>(me: Me) -> F64
    block entry()
        r : U64 = soft_float64_from(me.lt(0), me.abs_diff(0))
        return(bitcast<U64, F64>(r))

/// U64 to F64, rounded to nearest (ties to even): compiler-rt's `__floatundidf`.
