// -- integers ------------------------------------------------------------------

/// `__aeabi_idiv`: S32 division, rounding toward zero.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient.
@export("__aeabi_idiv")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_idiv(n: S32, d: S32) -> S32
    q, rem = soft_divmod(n, d)
    r: S32 = q
    return r

/// `__aeabi_uidiv`: U32 division, rounding toward zero.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient.
@export("__aeabi_uidiv")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_uidiv(n: U32, d: U32) -> U32
    q, rem = soft_divmod(n, d)
    r: U32 = q
    return r

/// `__aeabi_idivmod`: S32 division: the quotient in r0, the remainder in r1.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient in the low 32 bits and the remainder in the high 32 bits.
@export("__aeabi_idivmod")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_idivmod(n: S32, d: S32) -> U64
    q, rem = soft_divmod(n, d)
    low: U64 = q.to_wrap[U32]().to[U64]()
    high: U64 = rem.to_wrap[U32]().to[U64]()
    r: U64 = (high << 32) | low
    return r

/// `__aeabi_uidivmod`: U32 division: the quotient in r0, the remainder in r1.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient in the low 32 bits and the remainder in the high 32 bits.
@export("__aeabi_uidivmod")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_uidivmod(n: U32, d: U32) -> U64
    q, rem = soft_divmod(n, d)
    high: U64 = rem.to[U64]() << 32
    r: U64 = high | q.to[U64]()
    return r

/// `__aeabi_ldivmod`: S64 division: the quotient in r0:r1, the remainder in r2:r3.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient in the low 64 bits and the remainder in the high 64 bits.
@export("__aeabi_ldivmod")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_ldivmod(n: S64, d: S64) -> U128
    q, rem = soft_divmod(n, d)
    low: U128 = q.to_wrap[U64]().to[U128]()
    high: U128 = rem.to_wrap[U64]().to[U128]()
    r: U128 = (high << 64) | low
    return r

/// `__aeabi_uldivmod`: U64 division: the quotient in r0:r1, the remainder in r2:r3.
/// :param n: The dividend.
/// :param d: The divisor.
/// :returns: The quotient in the low 64 bits and the remainder in the high 64 bits.
@export("__aeabi_uldivmod")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_uldivmod(n: U64, d: U64) -> U128
    q, rem = soft_divmod(n, d)
    high: U128 = rem.to[U128]() << 64
    r: U128 = high | q.to[U128]()
    return r

/// `__aeabi_lmul`: the low 64 bits of a product, which Thumb-1 calls for.
/// :param a: The first factor.
/// :param b: The second factor.
/// :returns: The product, wrapped to 64 bits.
@export("__aeabi_lmul")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_lmul(a: U64, b: U64) -> U64
    r: U64 = soft_mul(a, b)
    return r

/// `__aeabi_llsl`: a 64-bit shift left, which Thumb-1 calls for.
/// :param x: The value to shift.
/// :param n: The shift amount.
/// :returns: The shifted value.
@export("__aeabi_llsl")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_llsl(x: U64, n: CInt) -> U64
    r: U64 = soft_shl(x, n: n.to_wrap[U32]())
    return r

/// `__aeabi_llsr`: a 64-bit shift right filling with zeros, which Thumb-1 calls for.
/// :param x: The value to shift.
/// :param n: The shift amount.
/// :returns: The shifted value.
@export("__aeabi_llsr")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_llsr(x: U64, n: CInt) -> U64
    r: U64 = soft_shr(x, n: n.to_wrap[U32]())
    return r

/// `__aeabi_lasr`: a 64-bit shift right filling with the sign, which Thumb-1 calls for.
/// :param x: The value to shift.
/// :param n: The shift amount.
/// :returns: The shifted value.
@export("__aeabi_lasr")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_lasr(x: S64, n: CInt) -> S64
    r: S64 = soft_shr(x, n: n.to_wrap[U32]())
    return r
