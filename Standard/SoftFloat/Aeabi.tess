// -- comparison ----------------------------------------------------------------

/// `__aeabi_fcmpeq`: 1 when `a` is equal to `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_fcmpeq")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fcmpeq(a: U32, b: U32) -> CInt
    order: S32 = soft_b32_le(a, b)
    holds: Bool = order == 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_fcmplt`: 1 when `a` is less than `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_fcmplt")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fcmplt(a: U32, b: U32) -> CInt
    order: S32 = soft_b32_le(a, b)
    holds: Bool = order < 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_fcmple`: 1 when `a` is less or equal to `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_fcmple")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fcmple(a: U32, b: U32) -> CInt
    order: S32 = soft_b32_le(a, b)
    holds: Bool = order <= 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_fcmpge`: 1 when `a` is greater or equal to `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_fcmpge")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fcmpge(a: U32, b: U32) -> CInt
    order: S32 = soft_b32_ge(a, b)
    holds: Bool = order >= 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_fcmpgt`: 1 when `a` is greater than `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_fcmpgt")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fcmpgt(a: U32, b: U32) -> CInt
    order: S32 = soft_b32_ge(a, b)
    holds: Bool = order > 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_fcmpun`: 1 when either operand is NaN, else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when `a` or `b` is NaN, else 0.
@export("__aeabi_fcmpun")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fcmpun(a: U32, b: U32) -> CInt
    unordered: Bool = soft_b32_unordered(a, b)
    r: CInt = unordered.to[S32]()
    return r

/// `__aeabi_dcmpeq`: 1 when `a` is equal to `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_dcmpeq")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_dcmpeq(a: U64, b: U64) -> CInt
    order: S32 = soft_b64_le(a, b)
    holds: Bool = order == 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_dcmplt`: 1 when `a` is less than `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_dcmplt")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_dcmplt(a: U64, b: U64) -> CInt
    order: S32 = soft_b64_le(a, b)
    holds: Bool = order < 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_dcmple`: 1 when `a` is less or equal to `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_dcmple")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_dcmple(a: U64, b: U64) -> CInt
    order: S32 = soft_b64_le(a, b)
    holds: Bool = order <= 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_dcmpge`: 1 when `a` is greater or equal to `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_dcmpge")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_dcmpge(a: U64, b: U64) -> CInt
    order: S32 = soft_b64_ge(a, b)
    holds: Bool = order >= 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_dcmpgt`: 1 when `a` is greater than `b` (ordered), else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when the comparison holds, else 0.
@export("__aeabi_dcmpgt")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_dcmpgt(a: U64, b: U64) -> CInt
    order: S32 = soft_b64_ge(a, b)
    holds: Bool = order > 0
    r: CInt = holds.to[S32]()
    return r

/// `__aeabi_dcmpun`: 1 when either operand is NaN, else 0.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: 1 when `a` or `b` is NaN, else 0.
@export("__aeabi_dcmpun")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_dcmpun(a: U64, b: U64) -> CInt
    unordered: Bool = soft_b64_unordered(a, b)
    r: CInt = unordered.to[S32]()
    return r

// -- float to float ------------------------------------------------------------

/// `__aeabi_f2d`: B32 to B64, exactly.
/// :param a: The B32's bits.
/// :returns: The B64's bits.
@export("__aeabi_f2d")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_f2d(a: U32) -> U64
    value: B32 = .from_bits(a)
    r: U64 = value.soft_to[B64]().bits()
    return r

/// `__aeabi_d2f`: B64 to B32, rounding to nearest even.
/// :param a: The B64's bits.
/// :returns: The B32's bits.
@export("__aeabi_d2f")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_d2f(a: U64) -> U32
    value: B64 = .from_bits(a)
    r: U32 = value.soft_to[B32]().bits()
    return r

/// `__aeabi_h2f`: B16 to B32, exactly.
/// :param a: The B16's bits.
/// :returns: The B32's bits.
@export("__aeabi_h2f")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_h2f(a: U16) -> U32
    value: B16 = .from_bits(a)
    r: U32 = value.soft_to[B32]().bits()
    return r

/// `__aeabi_f2h`: B32 to B16, rounding to nearest even.
/// :param a: The B32's bits.
/// :returns: The B16's bits.
@export("__aeabi_f2h")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_f2h(a: U32) -> U16
    value: B32 = .from_bits(a)
    r: U16 = value.soft_to[B16]().bits()
    return r

/// `__aeabi_d2h`: B64 to B16, rounding once to nearest even.
/// :param a: The B64's bits.
/// :returns: The B16's bits.
@export("__aeabi_d2h")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_d2h(a: U64) -> U16
    value: B64 = .from_bits(a)
    r: U16 = value.soft_to[B16]().bits()
    return r

// -- float to integer ----------------------------------------------------------

/// `__aeabi_f2iz`: B32 to S32, rounding toward zero.
/// :param a: The B32's bits.
/// :returns: The integer part of the value.
@export("__aeabi_f2iz")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_f2iz(a: U32) -> S32
    r: S32 = B32.from_bits(a).soft_to[S32]()
    return r

/// `__aeabi_f2uiz`: B32 to U32, rounding toward zero.
/// :param a: The B32's bits.
