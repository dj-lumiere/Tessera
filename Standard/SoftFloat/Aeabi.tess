#[export("__aeabi_f2ulz"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_f2ulz(a: U32) -> U64
    block entry()
        r : U64 = soft_f32_to_u64(a)
        return(r)

/// `__aeabi_d2iz`: F64 to S32, rounding toward zero.
#[export("__aeabi_d2iz"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_d2iz(a: U64) -> S32
    block entry()
        r : S32 = soft_f64_to_s32(a)
        return(r)

/// `__aeabi_d2uiz`: F64 to U32, rounding toward zero.
#[export("__aeabi_d2uiz"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_d2uiz(a: U64) -> U32
    block entry()
        r : U32 = soft_f64_to_u32(a)
        return(r)

/// `__aeabi_d2lz`: F64 to S64, rounding toward zero.
#[export("__aeabi_d2lz"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_d2lz(a: U64) -> S64
    block entry()
        r : S64 = soft_f64_to_s64(a)
        return(r)

/// `__aeabi_d2ulz`: F64 to U64, rounding toward zero.
#[export("__aeabi_d2ulz"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_d2ulz(a: U64) -> U64
    block entry()
        r : U64 = soft_f64_to_u64(a)
        return(r)

// -- integer to float ----------------------------------------------------------

/// `__aeabi_i2f`: S32 to F32, rounding to nearest even.
#[export("__aeabi_i2f"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_i2f(x: S32) -> U32
    block entry()
        r : U32 = soft_s32_to_f32(x)
        return(r)

/// `__aeabi_ui2f`: U32 to F32, rounding to nearest even.
#[export("__aeabi_ui2f"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_ui2f(x: U32) -> U32
    block entry()
        r : U32 = soft_u32_to_f32(x)
        return(r)

/// `__aeabi_l2f`: S64 to F32, rounding to nearest even.
#[export("__aeabi_l2f"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_l2f(x: S64) -> U32
    block entry()
        r : U32 = soft_s64_to_f32(x)
        return(r)

/// `__aeabi_ul2f`: U64 to F32, rounding to nearest even.
#[export("__aeabi_ul2f"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_ul2f(x: U64) -> U32
    block entry()
        r : U32 = soft_u64_to_f32(x)
        return(r)

/// `__aeabi_i2d`: S32 to F64, rounding to nearest even.
#[export("__aeabi_i2d"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_i2d(x: S32) -> U64
    block entry()
        r : U64 = soft_s32_to_f64(x)
        return(r)

/// `__aeabi_ui2d`: U32 to F64, rounding to nearest even.
#[export("__aeabi_ui2d"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_ui2d(x: U32) -> U64
    block entry()
        r : U64 = soft_u32_to_f64(x)
        return(r)

/// `__aeabi_l2d`: S64 to F64, rounding to nearest even.
#[export("__aeabi_l2d"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_l2d(x: S64) -> U64
    block entry()
        r : U64 = soft_s64_to_f64(x)
        return(r)

/// `__aeabi_ul2d`: U64 to F64, rounding to nearest even.
#[export("__aeabi_ul2d"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_ul2d(x: U64) -> U64
    block entry()
        r : U64 = soft_u64_to_f64(x)
        return(r)

// -- integers ------------------------------------------------------------------

/// `__aeabi_idiv`: S32 division, rounding toward zero.
#[export("__aeabi_idiv"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_idiv(n: S32, d: S32) -> S32
    block entry()
        q, rem = soft_s32_divmod(n, d)
        r : S32 = q
        return(r)

/// `__aeabi_uidiv`: U32 division, rounding toward zero.
#[export("__aeabi_uidiv"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_uidiv(n: U32, d: U32) -> U32
    block entry()
        q, rem = soft_u32_divmod(n, d)
        r : U32 = q
        return(r)

/// `__aeabi_idivmod`: S32 division: the quotient in r0, the remainder in r1.
#[export("__aeabi_idivmod"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_idivmod(n: S32, d: S32) -> U64
    block entry()
        q, rem = soft_s32_divmod(n, d)
        low  : U64 = q.to_wrap<U32>().to<U64>()
        high : U64 = rem.to_wrap<U32>().to<U64>()
        r    : U64 = high.shl(32).bitor(low)
        return(r)

/// `__aeabi_uidivmod`: U32 division: the quotient in r0, the remainder in r1.
#[export("__aeabi_uidivmod"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_uidivmod(n: U32, d: U32) -> U64
    block entry()
        q, rem = soft_u32_divmod(n, d)
        high : U64 = rem.to<U64>().shl(32)
        r    : U64 = high.bitor(q.to<U64>())
        return(r)

/// `__aeabi_ldivmod`: S64 division: the quotient in r0:r1, the remainder in r2:r3.
#[export("__aeabi_ldivmod"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_ldivmod(n: S64, d: S64) -> U128
    block entry()
        q, rem = soft_s64_divmod(n, d)
        low  : U128 = q.to_wrap<U64>().to<U128>()
        high : U128 = rem.to_wrap<U64>().to<U128>()
        r    : U128 = high.shl(64).bitor(low)
        return(r)

/// `__aeabi_uldivmod`: U64 division: the quotient in r0:r1, the remainder in r2:r3.
#[export("__aeabi_uldivmod"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_uldivmod(n: U64, d: U64) -> U128
    block entry()
        q, rem = soft_u64_divmod(n, d)
        high : U128 = rem.to<U128>().shl(64)
        r    : U128 = high.bitor(q.to<U128>())
        return(r)

/// `__aeabi_lmul`: the low 64 bits of a product, which Thumb-1 calls for.
#[export("__aeabi_lmul"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_lmul(a: U64, b: U64) -> U64
    block entry()
        r : U64 = soft_u64_mul(a, b)
        return(r)

/// `__aeabi_llsl`: a 64-bit shift left, which Thumb-1 calls for.
#[export("__aeabi_llsl"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_llsl(x: U64, n: CInt) -> U64
    block entry()
        r : U64 = soft_u64_shl(x, n.to_wrap<U32>())
        return(r)

/// `__aeabi_llsr`: a 64-bit shift right filling with zeros, which Thumb-1 calls for.
#[export("__aeabi_llsr"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_llsr(x: U64, n: CInt) -> U64
    block entry()
        r : U64 = soft_u64_shr(x, n.to_wrap<U32>())
        return(r)

/// `__aeabi_lasr`: a 64-bit shift right filling with the sign, which Thumb-1 calls for.
#[export("__aeabi_lasr"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_lasr(x: S64, n: CInt) -> S64
    block entry()
        r : S64 = soft_s64_shr(x, n.to_wrap<U32>())
        return(r)
