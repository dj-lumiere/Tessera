// Tessera stdlib: the soft-float routines under ARM's run-time ABI names
//
// On 32-bit ARM, LLVM calls the run-time ABI's names (__aeabi_fadd, __aeabi_dcmplt, __aeabi_f2iz, __aeabi_uidivmod,
// ...) where other targets call compiler-rt's, with the run-time ABI's own calling convention: the base AAPCS, every
// float in core registers, even where the program's own convention uses the floating-point registers. So these take
// and return each float as its bits (B32 as a U32, B64 as a U64, B16 as a U16), which the base AAPCS passes in the
// same registers whatever the program's float ABI is. A comparison returns 0 or 1. A division that returns the
// remainder too returns both in one wider integer, which AAPCS splits across registers as the ABI says:
// __aeabi_uidivmod's quotient in r0 and remainder in r1 (a U64, low half first), __aeabi_uldivmod's quotient in
// r0:r1 and remainder in r2:r3 (a U128).
//
// LLVM never calls the flag-setting comparisons (__aeabi_cfcmpeq, __aeabi_cdcmple, ...), which answer in the CPSR
// flags, nor the reversed subtractions (__aeabi_frsub, __aeabi_drsub), so they aren't here. The 128-bit conversions
// and __truncsfbf2 / __truncdfbf2, __powisf2 / __powidf2, __clzsi2, sqrtf / sqrt, and fmodf / fmod have no run-time ABI
// name: ARM calls them by their C names (Exports.tess).

module Standard/Core

// -- arithmetic ----------------------------------------------------------------

/// `__aeabi_fadd`: B32 addition on the bits.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: The bits of the sum.
@export("__aeabi_fadd")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fadd(a: U32, b: U32) -> U32
    r: U32 = soft_b32_add(a, b)
    return r

/// `__aeabi_fsub`: B32 subtraction on the bits.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: The bits of the difference `a - b`.
@export("__aeabi_fsub")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fsub(a: U32, b: U32) -> U32
    r: U32 = soft_b32_sub(a, b)
    return r

/// `__aeabi_fmul`: B32 multiplication on the bits.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: The bits of the product.
@export("__aeabi_fmul")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fmul(a: U32, b: U32) -> U32
    r: U32 = soft_b32_mul(a, b)
    return r

/// `__aeabi_fdiv`: B32 division on the bits.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: The bits of the quotient `a / b`.
@export("__aeabi_fdiv")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_fdiv(a: U32, b: U32) -> U32
    r: U32 = soft_b32_div(a, b)
    return r

/// `__aeabi_dadd`: B64 addition on the bits.
