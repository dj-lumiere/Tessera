@export("__aeabi_ui2d")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_ui2d(x: U32) -> U64
    r: U64 = x.soft_to[B64]().bits()
    return r

/// `__aeabi_l2d`: S64 to B64, rounding to nearest even.
/// :param x: The integer to convert.
/// :returns: The nearest B64's bits.
@export("__aeabi_l2d")
@no_builtins
@target(arch: "arm", os: "none")
private routine export_aeabi_l2d(x: S64) -> U64
    r: U64 = x.soft_to[B64]().bits()
    return r

/// `__aeabi_ul2d`: U64 to B64, rounding to nearest even.
