// Tessera stdlib: the soft-float routines under ARM's run-time ABI names
//
// On 32-bit ARM, LLVM calls the run-time ABI's names (__aeabi_fadd, __aeabi_dcmplt, __aeabi_f2iz, __aeabi_uidivmod,
// ...) where other targets call compiler-rt's, with the run-time ABI's own calling convention: the base AAPCS, every
// float in core registers, even where the program's own convention uses the floating-point registers. So these take
// and return each float as its bits (F32 as a U32, F64 as a U64, F16 as a U16), which the base AAPCS passes in the
// same registers whatever the program's float ABI is. A comparison returns 0 or 1. A division that returns the
// remainder too returns both in one wider integer, which AAPCS splits across registers as the ABI says:
// __aeabi_uidivmod's quotient in r0 and remainder in r1 (a U64, low half first), __aeabi_uldivmod's quotient in
// r0:r1 and remainder in r2:r3 (a U128).
//
// LLVM never calls the flag-setting comparisons (__aeabi_cfcmpeq, __aeabi_cdcmple, ...), which answer in the CPSR
// flags, nor the reversed subtractions (__aeabi_frsub, __aeabi_drsub), so they aren't here. The 128-bit conversions
// and __truncsfbf2 / __truncdfbf2, __powisf2 / __powidf2, __clzsi2, sqrtf / sqrt, and fmodf / fmod have no run-time ABI
// name: ARM calls them by their C names (Exports.tess).

module Standard::Core

// -- arithmetic ----------------------------------------------------------------

/// `__aeabi_fadd`: F32 addition on the bits.
#[export("__aeabi_fadd"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fadd(a: U32, b: U32) -> U32
    block entry()
        r : U32 = soft_f32_add(a, b)
        return(r)

/// `__aeabi_fsub`: F32 subtraction on the bits.
#[export("__aeabi_fsub"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fsub(a: U32, b: U32) -> U32
    block entry()
        r : U32 = soft_f32_sub(a, b)
        return(r)

/// `__aeabi_fmul`: F32 multiplication on the bits.
#[export("__aeabi_fmul"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fmul(a: U32, b: U32) -> U32
    block entry()
        r : U32 = soft_f32_mul(a, b)
        return(r)

/// `__aeabi_fdiv`: F32 division on the bits.
#[export("__aeabi_fdiv"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fdiv(a: U32, b: U32) -> U32
    block entry()
        r : U32 = soft_f32_div(a, b)
        return(r)

/// `__aeabi_dadd`: F64 addition on the bits.
#[export("__aeabi_dadd"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dadd(a: U64, b: U64) -> U64
    block entry()
        r : U64 = soft_f64_add(a, b)
        return(r)

/// `__aeabi_dsub`: F64 subtraction on the bits.
#[export("__aeabi_dsub"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dsub(a: U64, b: U64) -> U64
    block entry()
        r : U64 = soft_f64_sub(a, b)
        return(r)

/// `__aeabi_dmul`: F64 multiplication on the bits.
#[export("__aeabi_dmul"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dmul(a: U64, b: U64) -> U64
    block entry()
        r : U64 = soft_f64_mul(a, b)
        return(r)

/// `__aeabi_ddiv`: F64 division on the bits.
#[export("__aeabi_ddiv"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_ddiv(a: U64, b: U64) -> U64
    block entry()
        r : U64 = soft_f64_div(a, b)
        return(r)

// -- comparison ----------------------------------------------------------------

/// `__aeabi_fcmpeq`: 1 when `a` is equal to `b` (ordered), else 0.
#[export("__aeabi_fcmpeq"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fcmpeq(a: U32, b: U32) -> CInt
    block entry()
        order : S32  = soft_f32_le(a, b)
        holds : Bool = order.eq(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_fcmplt`: 1 when `a` is less than `b` (ordered), else 0.
#[export("__aeabi_fcmplt"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fcmplt(a: U32, b: U32) -> CInt
    block entry()
        order : S32  = soft_f32_le(a, b)
        holds : Bool = order.lt(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_fcmple`: 1 when `a` is less or equal to `b` (ordered), else 0.
#[export("__aeabi_fcmple"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fcmple(a: U32, b: U32) -> CInt
    block entry()
        order : S32  = soft_f32_le(a, b)
        holds : Bool = order.le(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_fcmpge`: 1 when `a` is greater or equal to `b` (ordered), else 0.
#[export("__aeabi_fcmpge"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fcmpge(a: U32, b: U32) -> CInt
    block entry()
        order : S32  = soft_f32_ge(a, b)
        holds : Bool = order.ge(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_fcmpgt`: 1 when `a` is greater than `b` (ordered), else 0.
#[export("__aeabi_fcmpgt"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fcmpgt(a: U32, b: U32) -> CInt
    block entry()
        order : S32  = soft_f32_ge(a, b)
        holds : Bool = order.gt(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_fcmpun`: 1 when either operand is NaN, else 0.
#[export("__aeabi_fcmpun"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_fcmpun(a: U32, b: U32) -> CInt
    block entry()
        unordered : Bool = soft_f32_unordered(a, b)
        r         : CInt = unordered.to<S32>()
        return(r)

/// `__aeabi_dcmpeq`: 1 when `a` is equal to `b` (ordered), else 0.
#[export("__aeabi_dcmpeq"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dcmpeq(a: U64, b: U64) -> CInt
    block entry()
        order : S32  = soft_f64_le(a, b)
        holds : Bool = order.eq(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_dcmplt`: 1 when `a` is less than `b` (ordered), else 0.
#[export("__aeabi_dcmplt"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dcmplt(a: U64, b: U64) -> CInt
    block entry()
        order : S32  = soft_f64_le(a, b)
        holds : Bool = order.lt(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_dcmple`: 1 when `a` is less or equal to `b` (ordered), else 0.
#[export("__aeabi_dcmple"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dcmple(a: U64, b: U64) -> CInt
    block entry()
        order : S32  = soft_f64_le(a, b)
        holds : Bool = order.le(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_dcmpge`: 1 when `a` is greater or equal to `b` (ordered), else 0.
#[export("__aeabi_dcmpge"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dcmpge(a: U64, b: U64) -> CInt
    block entry()
        order : S32  = soft_f64_ge(a, b)
        holds : Bool = order.ge(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_dcmpgt`: 1 when `a` is greater than `b` (ordered), else 0.
#[export("__aeabi_dcmpgt"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dcmpgt(a: U64, b: U64) -> CInt
    block entry()
        order : S32  = soft_f64_ge(a, b)
        holds : Bool = order.gt(0)
        r     : CInt = holds.to<S32>()
        return(r)

/// `__aeabi_dcmpun`: 1 when either operand is NaN, else 0.
#[export("__aeabi_dcmpun"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_dcmpun(a: U64, b: U64) -> CInt
    block entry()
        unordered : Bool = soft_f64_unordered(a, b)
        r         : CInt = unordered.to<S32>()
        return(r)

// -- float to float ------------------------------------------------------------

/// `__aeabi_f2d`: F32 to F64, exactly.
#[export("__aeabi_f2d"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_f2d(a: U32) -> U64
    block entry()
        r : U64 = soft_f32_to_f64(a)
        return(r)

/// `__aeabi_d2f`: F64 to F32, rounding to nearest even.
#[export("__aeabi_d2f"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_d2f(a: U64) -> U32
    block entry()
        r : U32 = soft_f64_to_f32(a)
        return(r)

/// `__aeabi_h2f`: F16 to F32, exactly.
#[export("__aeabi_h2f"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_h2f(a: U16) -> U32
    block entry()
        r : U32 = soft_f16_to_f32(a)
        return(r)

/// `__aeabi_f2h`: F32 to F16, rounding to nearest even.
#[export("__aeabi_f2h"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_f2h(a: U32) -> U16
    block entry()
        r : U16 = soft_f32_to_f16(a)
        return(r)

/// `__aeabi_d2h`: F64 to F16, rounding once to nearest even.
#[export("__aeabi_d2h"), no_builtins, target(arch: "arm", os: "none")]
private routine export_aeabi_d2h(a: U64) -> U16
    block entry()
        r : U16 = soft_f64_to_f16(a)
        return(r)

// -- float to integer ----------------------------------------------------------

