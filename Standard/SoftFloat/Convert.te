# Tessera stdlib: float conversions in software
#
# The conversions LLVM calls a routine for on a target without a floating-point unit, or without instructions for
# B16 and BF16 (x86_64 calls __extendhfsf2 and __truncsfbf2 too): between the float formats, and between floats and
# 32-, 64-, and 128-bit integers. Integer operations only, on the bits. Exports.te and Aeabi.te export them.
# Each is `x.soft_to[T]()`, shaped like the conversion `x.to[T]()` it implements but under its own name: on these
# targets LLVM lowers `to[T]` to a call of the routine exported here, so a routine named `to[T]` would call itself.
# The ones that give a float are #inline and make it with bitcast, so the value never comes back through a call:
# 32-bit x86 returns a float on the x87 stack, which quiets a signaling NaN that widening must keep.
#
# Widening is exact and keeps a NaN's payload as it is (a signaling NaN stays signaling, as in compiler-rt).
# Narrowing rounds to nearest, ties to even, into the subnormals and up to infinity. A NaN keeps its sign and the top
# of its payload and is made quiet. Float to integer rounds toward zero as compiler-rt does: a value in range
# converts exactly, a value of 2^width or more (infinity and NaN too) saturates by its sign, and an unsigned
# conversion of a negative value is 0. LLVM leaves an out-of-range conversion undefined and checks the range itself
# for the saturating ones, so only the in-range results are the language's. The rest match compiler-rt's.
# Integer to float rounds to nearest, ties to even.

module Standard/Core

# -- widening ------------------------------------------------------------------

### Widens B32 to B64, exactly: compiler-rt's `__extendsfdf2`.
### :returns: The same value as a B64. A NaN keeps its payload, moved to the top of the fraction.
@inline
@no_builtins
routine B32.soft_to[B64](me: Me) -> B64
    local a: U32 = me.bits()
    local high: U64 = (a & 0x80000000).to[U64]()
    local sign: U64 = high << 32
    local size: U32 = a & 0x7FFFFFFF

    when
        size >= 0x7F800000 =>
            fraction: U64 = (size & 0x007FFFFF).to[U64]()
            r: U64 = sign | 0x7FF0000000000000 | (fraction << 29)
            return bitcast[U64, B64](r)
        size == 0 => return bitcast[U64, B64](sign)
        else =>
            # a subnormal B32 is normal in B64
            parts: SoftParts32 = soft_unpack(magnitude: size, sig_bits: 23)
            field: U64 = (parts.exponent + 896).to[U64]()
            fraction: U64 = (parts.sig & 0x007FFFFF).to[U64]()
            r: U64 = sign | (field << 52) | (fraction << 29)
            return bitcast[U64, B64](r)

### Widens B16 to B32, exactly: compiler-rt's `__extendhfsf2`.
### :returns: The same value as a B32. A NaN keeps its payload, moved to the top of the fraction.
@inline
@no_builtins
routine B16.soft_to[B32](me: Me) -> B32
    local a: U16 = me.bits()
    local bits: U32 = a.to[U32]()
    local sign: U32 = (bits & 0x8000) << 16
    local size: U32 = bits & 0x7FFF

    when
        size >= 0x7C00 =>
            payload: U32 = (size & 0x03FF) << 13
            r: U32 = sign | 0x7F800000 | payload
            return bitcast[U32, B32](r)
        size == 0 => return bitcast[U32, B32](sign)
        else =>
            # a subnormal B16 is normal in B32
            parts: SoftParts32 = soft_unpack(magnitude: size, sig_bits: 10)
            field: U32 = (parts.exponent + 112).to[U32]()
            fraction: U32 = parts.sig & 0x03FF
            r: U32 = sign | (field << 23) | (fraction << 13)
            return bitcast[U32, B32](r)

# -- narrowing -----------------------------------------------------------------

### Narrows B64 to B32, rounding to nearest (ties to even): compiler-rt's `__truncdfsf2`.
### :returns: The nearest B32.
@inline
@no_builtins
routine B64.soft_to[B32](me: Me) -> B32
    a: U64 = me.bits()
    r: U32 = soft_narrow(a, format: B32.FORMAT.peek())
    return bitcast[U32, B32](r)

### Narrows B64 to B16, rounding once to nearest (ties to even): compiler-rt's `__truncdfhf2`.
### :returns: The nearest B16.
@inline
@no_builtins
routine B64.soft_to[B16](me: Me) -> B16
    a: U64 = me.bits()
    r: U16 = soft_narrow(a, format: B16.FORMAT.peek()).to_wrap[U16]()
    return bitcast[U16, B16](r)

### Narrows B64 to BF16, rounding once to nearest (ties to even): compiler-rt's `__truncdfbf2`.
### :returns: The nearest BF16.
@inline
@no_builtins
routine B64.soft_to[BF16](me: Me) -> BF16
    a: U64 = me.bits()
    r: U16 = soft_narrow(a, format: BF16.FORMAT.peek()).to_wrap[U16]()
    return bitcast[U16, BF16](r)

### Narrows B32 to B16, rounding to nearest (ties to even): compiler-rt's `__truncsfhf2`.
### :returns: The nearest B16.
@inline
@no_builtins
routine B32.soft_to[B16](me: Me) -> B16
    a: U32 = me.bits()
    r: U16 = soft_narrow(a, format: B16.FORMAT.peek()).to_wrap[U16]()
    return bitcast[U16, B16](r)

### Narrows B32 to BF16, rounding to nearest (ties to even): compiler-rt's `__truncsfbf2`.
### :returns: The nearest BF16. A B32 subnormal becomes a BF16 subnormal or zero.
@inline
@no_builtins
routine B32.soft_to[BF16](me: Me) -> BF16
    a: U32 = me.bits()
    r: U16 = soft_narrow(a, format: BF16.FORMAT.peek()).to_wrap[U16]()
    return bitcast[U16, BF16](r)

### Narrows B64 bits into a binary format whose bits fit in a U32, rounding to nearest (ties to even).
### :param a: The B64's bits.
### :param format: The narrower format (B32, B16, or BF16).
### :returns: The format's bits, in the low bits of a U32.
@inline
routine soft_narrow(a: U64, format: FloatFormat) -> U32
    local sig_bits: U32 = format.fraction_bits
    local bias: S32 = format.bias
    local max_exponent: S32 = format.exponent_max
    local negative: Bool = a >= 0x8000000000000000
    local sign: U32 = when

        negative => format.sign_bit()
        else => 0
    local size: U64 = a & 0x7FFFFFFFFFFFFFFF

    infinity: U32 = max_exponent.to[U32]() << sig_bits
    when
        size > 0x7FF0000000000000 =>
            # the top of the payload, made quiet
            quiet: U32 = U32.shl(1, sig_bits - 1)
            shift: U64 = U32.sub(52, sig_bits).to[U64]()
            top: U64 = (size & 0x000FFFFFFFFFFFFF) >> shift
            payload: U32 = top.to_wrap[U32]()
            r: U32 = sign | infinity | quiet | payload
            return r
        size == 0x7FF0000000000000 => return sign | infinity
        size == 0 => return sign
        else =>
            # a subnormal B64 sits at exponent 1 without the implicit bit. The significand drops to 27 bits with a sticky
            # bit, which the narrower format's rounding needs no more than
            field: U64 = size >> 52
            normal: Bool = field != 0
            fraction: U64 = size & 0x000FFFFFFFFFFFFF
            sig: U64 = when
                normal => fraction | 0x0010000000000000
                else => fraction
            stored: S32 = when
                normal => field.to_wrap[S32]()
                else => 1
            narrow: U64 = soft_shr_sticky(x: sig, shift: 26)
            scale: S32 = bias + sig_bits.to[S32]()
            exponent: S32 = stored + scale - 1046
            r: U32 = soft_round_pack(sign, exponent, m: narrow.to_wrap[U32](), format)
            return r

### Narrows B32 bits into B16 or BF16, rounding to nearest (ties to even).
### :param a: The B32's bits.
### :param format: The narrower format (B16 or BF16).
### :returns: The format's bits, in the low 16 bits of a U32.
@inline
routine soft_narrow(a: U32, format: FloatFormat) -> U32
    local sig_bits: U32 = format.fraction_bits
    local bias: S32 = format.bias
    local max_exponent: S32 = format.exponent_max
    local sign: U32 = (a >> 16) & 0x8000
    local size: U32 = a & 0x7FFFFFFF

    infinity: U32 = max_exponent.to[U32]() << sig_bits
    when
        size > 0x7F800000 =>
            quiet: U32 = U32.shl(1, sig_bits - 1)
            payload: U32 = (size & 0x007FFFFF) >> U32.sub(23, sig_bits)
            r: U32 = sign | infinity | quiet | payload
            return r
        size == 0x7F800000 => return sign | infinity
        size == 0 => return sign
        else =>
            field: U32 = size >> 23
            normal: Bool = field != 0
            fraction: U32 = size & 0x007FFFFF
            sig: U32 = when
                normal => fraction | 0x00800000
                else => fraction
            stored: S32 = when
                normal => field.to[S32]()
                else => 1
            scale: S32 = bias + sig_bits.to[S32]()
            exponent: S32 = stored + scale - 147
            r: U32 = soft_round_pack(sign, exponent, m: sig, format)
            return r

# -- float to integer ----------------------------------------------------------

### Converts float bits to an integer of at most 64 bits, rounding toward zero, as compiler-rt's `__fix*` and
### `__fixuns*` do.
### :param bits: The float's bits, in the low `format.width` bits.
### :param format: The float's format (B32 or B64).
### :param width: The integer's width, 32 or 64.
### :param signed: Whether the integer is signed.
### :returns: The integer's bits in the low `width` bits.
@inline
routine soft_fix(bits: U64, format: FloatFormat, width: U64, signed: Bool) -> U64
    local all: U64 = U64.shl(1, width) -% 1
    local negative: Bool = soft_is_negative(bits, format)
    local sig: U64 = soft_sig(bits, format)
    local sig_bits: S32 = format.fraction_bits.to[S32]()

    field: S32 = soft_field(bits, format)
    exponent: S32 = field - format.bias
    largest: U64 = all >> 1
    unsigned: Bool = not signed
    huge: Bool = exponent >= width.to_wrap[S32]()
    when
        exponent < 0 => return 0
        unsigned and negative => return 0
        huge and signed => return if negative then largest + 1 else largest
        huge => return all
        exponent < sig_bits =>
            shift: U64 = (sig_bits - exponent).to[U64]()

            magnitude: U64 = sig >> shift
            twos: U64 = U64.sub_wrap(0, magnitude)
            r: U64 = when
                negative => twos
                else => magnitude
            return r & all
        else =>
            shift: U64 = (exponent - sig_bits).to[U64]()

            magnitude: U64 = sig << shift
            twos: U64 = U64.sub_wrap(0, magnitude)
            r: U64 = when
                negative => twos
                else => magnitude
            return r & all

### {soft_fix} for 128-bit integers.
### :param bits: The float's bits, in the low `format.width` bits.
### :param format: The float's format (B16, B32, or B64).
### :param signed: Whether the integer is signed.
### :returns: The integer's bits.
@inline
routine soft_fix(bits: U64, format: FloatFormat, signed: Bool) -> U128
    local negative: Bool = soft_is_negative(bits, format)
    local narrow: U64 = soft_sig(bits, format)
    local sig: U128 = narrow.to[U128]()
    local sig_bits: S32 = format.fraction_bits.to[S32]()

    field: S32 = soft_field(bits, format)
    exponent: S32 = field - format.bias
    unsigned: Bool = not signed
    largest: U128 = U128.MAX >> 1
    when
        exponent < 0 => return 0
        unsigned and negative => return 0
        exponent >= 128 and signed => return if negative then largest + 1 else largest
        exponent >= 128 => return U128.MAX
        exponent < sig_bits =>
            shift: U128 = (sig_bits - exponent).to[U128]()

            magnitude: U128 = sig >> shift
            twos: U128 = U128.sub_wrap(0, magnitude)
            r: U128 = when
                negative => twos
                else => magnitude
            return r
        else =>
            shift: U128 = (exponent - sig_bits).to[U128]()

            magnitude: U128 = sig << shift
            twos: U128 = U128.sub_wrap(0, magnitude)
            r: U128 = when
                negative => twos
                else => magnitude
            return r

### B32 to S32, rounding toward zero: compiler-rt's `__fixsfsi`.
### :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
@no_builtins
routine B32.soft_to[S32](me: Me) -> S32
    a: U64 = me.bits().to[U64]()
    bits: U64 = soft_fix(bits: a, format: Me.FORMAT.peek(), width: 32, signed: true)
    r: S32 = bits.to_wrap[U32]().to_wrap[S32]()
    return r

### B32 to U32, rounding toward zero: compiler-rt's `__fixunssfsi`.
### :returns: The integer, 0 for a negative value, U32.MAX from 2^32 up.
@no_builtins
routine B32.soft_to[U32](me: Me) -> U32
    a: U64 = me.bits().to[U64]()
    bits: U64 = soft_fix(bits: a, format: Me.FORMAT.peek(), width: 32, signed: false)
    r: U32 = bits.to_wrap[U32]()
    return r

### B32 to S64, rounding toward zero: compiler-rt's `__fixsfdi`.
### :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
@no_builtins
routine B32.soft_to[S64](me: Me) -> S64
    a: U64 = me.bits().to[U64]()
    bits: U64 = soft_fix(bits: a, format: Me.FORMAT.peek(), width: 64, signed: true)
    r: S64 = bits.to_wrap[S64]()
    return r

### B32 to U64, rounding toward zero: compiler-rt's `__fixunssfdi`.
### :returns: The integer, 0 for a negative value, U64.MAX from 2^64 up.
@no_builtins
routine B32.soft_to[U64](me: Me) -> U64
    a: U64 = me.bits().to[U64]()
    r: U64 = soft_fix(bits: a, format: Me.FORMAT.peek(), width: 64, signed: false)
    return r

### B32 to S128, rounding toward zero: compiler-rt's `__fixsfti`.
### :returns: The integer. Out of range, compiler-rt's saturated value.
@no_builtins
routine B32.soft_to[S128](me: Me) -> S128
    a: U64 = me.bits().to[U64]()
    bits: U128 = soft_fix(bits: a, format: Me.FORMAT.peek(), signed: true)
    r: S128 = bits.to_wrap[S128]()
    return r

### B32 to U128, rounding toward zero: compiler-rt's `__fixunssfti`.
### :returns: The integer, 0 for a negative value, U128.MAX for infinity and NaN.
@no_builtins
routine B32.soft_to[U128](me: Me) -> U128
    a: U64 = me.bits().to[U64]()
    r: U128 = soft_fix(bits: a, format: Me.FORMAT.peek(), signed: false)
    return r

### B64 to S32, rounding toward zero: compiler-rt's `__fixdfsi`.
### :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
@no_builtins
routine B64.soft_to[S32](me: Me) -> S32
    bits: U64 = soft_fix(bits: me.bits(), format: Me.FORMAT.peek(), width: 32, signed: true)
    r: S32 = bits.to_wrap[U32]().to_wrap[S32]()
    return r

### B64 to U32, rounding toward zero: compiler-rt's `__fixunsdfsi`.
### :returns: The integer, 0 for a negative value, U32.MAX from 2^32 up.
@no_builtins
routine B64.soft_to[U32](me: Me) -> U32
    bits: U64 = soft_fix(bits: me.bits(), format: Me.FORMAT.peek(), width: 32, signed: false)
    r: U32 = bits.to_wrap[U32]()
    return r

### B64 to S64, rounding toward zero: compiler-rt's `__fixdfdi`.
### :returns: The integer. Out of range, compiler-rt's saturated or wrapped value.
@no_builtins
routine B64.soft_to[S64](me: Me) -> S64
    bits: U64 = soft_fix(bits: me.bits(), format: Me.FORMAT.peek(), width: 64, signed: true)
    r: S64 = bits.to_wrap[S64]()
    return r

### B64 to U64, rounding toward zero: compiler-rt's `__fixunsdfdi`.
### :returns: The integer, 0 for a negative value, U64.MAX from 2^64 up.
@no_builtins
routine B64.soft_to[U64](me: Me) -> U64
    r: U64 = soft_fix(bits: me.bits(), format: Me.FORMAT.peek(), width: 64, signed: false)
    return r

### B64 to S128, rounding toward zero: compiler-rt's `__fixdfti`.
### :returns: The integer. Out of range, compiler-rt's saturated value.
@no_builtins
routine B64.soft_to[S128](me: Me) -> S128
    bits: U128 = soft_fix(bits: me.bits(), format: Me.FORMAT.peek(), signed: true)
    r: S128 = bits.to_wrap[S128]()
    return r

### B64 to U128, rounding toward zero: compiler-rt's `__fixunsdfti`.
### :returns: The integer, 0 for a negative value, U128.MAX from 2^128 up.
@no_builtins
routine B64.soft_to[U128](me: Me) -> U128
    r: U128 = soft_fix(bits: me.bits(), format: Me.FORMAT.peek(), signed: false)
    return r

### B16 to S128, rounding toward zero: compiler-rt's `__fixhfti`, which LLVM calls on x86_64 and AArch64.
### :returns: The integer. Every finite B16 is in range. Infinity and NaN give what compiler-rt computes for them.
@no_builtins
routine B16.soft_to[S128](me: Me) -> S128
    a: U64 = me.bits().to[U64]()
    bits: U128 = soft_fix(bits: a, format: Me.FORMAT.peek(), signed: true)
    r: S128 = bits.to_wrap[S128]()
    return r

### B16 to U128, rounding toward zero: compiler-rt's `__fixunshfti`, which LLVM calls on x86_64 and AArch64.
### :returns: The integer, 0 for a negative value.
@no_builtins
routine B16.soft_to[U128](me: Me) -> U128
    a: U64 = me.bits().to[U64]()
    r: U128 = soft_fix(bits: a, format: Me.FORMAT.peek(), signed: false)
    return r

### Whether float bits are negative: the format's sign bit.
### :param bits: The float's bits, in the low `format.width` bits.
### :param format: The float's format.
### :returns: True when the sign bit is set.
@inline
secret routine soft_is_negative(bits: U64, format: FloatFormat) -> Bool
    top: U64 = (format.width - 1).to[U64]()
    sign: U64 = (bits >> top) & 1
    return sign == 1

### The biased exponent field of float bits.
### :param bits: The float's bits, in the low `format.width` bits.
### :param format: The float's format.
### :returns: The exponent field, from 0 to the format's all-ones field.
@inline
secret routine soft_field(bits: U64, format: FloatFormat) -> S32
    mask: U64 = format.exponent_max.to[U64]()
    field: U64 = (bits >> format.fraction_bits.to[U64]()) & mask
    r: S32 = field.to_wrap[S32]()
    return r

### The significand of float bits with the implicit bit set.
### :param bits: The float's bits, in the low `format.width` bits.
### :param format: The float's format.
### :returns: The fraction bits with the implicit bit above them set.
@inline
secret routine soft_sig(bits: U64, format: FloatFormat) -> U64
    implicit: U64 = U64.shl(1, format.fraction_bits.to[U64]())
    fraction: U64 = bits & implicit - 1
    return fraction | implicit

# -- integer to float ----------------------------------------------------------

### Rounds an integer magnitude of at most 64 bits into a binary format whose bits fit in a U32.
### :param negative: Whether the integer was negative.
### :param magnitude: Its magnitude.
### :param format: The format (B32 or B16).
### :returns: The format's bits, 0 for 0.
@inline
routine soft_float32_from(negative: Bool, magnitude: U64, format: FloatFormat) -> U32
    if magnitude == 0
        return 0
    lead: U64 = U64.sub(63, magnitude.leading_zeros())
    shift: U64 = lead -^ 31
    narrow: U64 = soft_shr_sticky(x: magnitude, shift)
    sign: U32 = when
        negative => format.sign_bit()
        else => 0
    scale: S32 = format.bias + format.fraction_bits.to[S32]()
    exponent: S32 = scale + (shift.to_wrap[S32]() + 3)
    r: U32 = soft_round_pack(sign, exponent, m: narrow.to_wrap[U32](), format)
    return r

### {soft_float32_from} for a 128-bit magnitude.
### :param negative: Whether the integer was negative.
### :param magnitude: Its magnitude.
### :param format: The format (B32 or B16).
### :returns: The format's bits, 0 for 0.
@inline
routine soft_float32_from(negative: Bool, magnitude: U128, format: FloatFormat) -> U32
    if magnitude == 0
        return 0
    lead: U128 = U128.sub(127, magnitude.leading_zeros())
    shift: U128 = lead -^ 31
    narrow: U128 = soft_shr_sticky(x: magnitude, shift)
    sign: U32 = when
        negative => format.sign_bit()
        else => 0
    scale: S32 = format.bias + format.fraction_bits.to[S32]()
    exponent: S32 = scale + (shift.to_wrap[S32]() + 3)
    r: U32 = soft_round_pack(sign, exponent, m: narrow.to_wrap[U32](), format)
    return r

### Rounds an integer magnitude of at most 64 bits into B64 bits.
### :param negative: Whether the integer was negative.
### :param magnitude: Its magnitude.
### :returns: The B64 bits, 0 for 0.
@inline
routine soft_float64_from(negative: Bool, magnitude: U64) -> U64
    zero: Bool = magnitude == 0
    sign: U64 = when
        negative => 0x8000000000000000
        else => 0
    if zero
        return 0
    else
        return soft_round_pack(sign, exponent: 1078, m: magnitude)

### Rounds a 128-bit integer magnitude into B64 bits.
### :param negative: Whether the integer was negative.
### :param magnitude: Its magnitude.
### :returns: The B64 bits, 0 for 0.
@inline
routine soft_float64_from(negative: Bool, magnitude: U128) -> U64
    if magnitude == 0
        return 0
    lead: U128 = U128.sub(127, magnitude.leading_zeros())
    shift: U128 = lead -^ 63
    narrow: U128 = soft_shr_sticky(x: magnitude, shift)
    sign: U64 = when
        negative => 0x8000000000000000
        else => 0
    exponent: S32 = shift.to_wrap[S32]() + 1078
    r: U64 = soft_round_pack(sign, exponent, m: narrow.to_wrap[U64]())
    return r

### S32 to B32, rounded to nearest (ties to even): compiler-rt's `__floatsisf`.
### :returns: The nearest B32.
@inline
@no_builtins
routine S32.soft_to[B32](me: Me) -> B32
    r: U32 = soft_float32_from(negative: me < 0, magnitude: me.abs_diff(0).to[U64](),
        format: B32.FORMAT.peek())
    return bitcast[U32, B32](r)

### U32 to B32, rounded to nearest (ties to even): compiler-rt's `__floatunsisf`.
### :returns: The nearest B32.
@inline
@no_builtins
routine U32.soft_to[B32](me: Me) -> B32
    r: Me = soft_float32_from(negative: false, magnitude: me.to[U64](), format: B32.FORMAT.peek())
    return bitcast[Me, B32](r)

### S64 to B32, rounded to nearest (ties to even): compiler-rt's `__floatdisf`.
### :returns: The nearest B32.
@inline
@no_builtins
routine S64.soft_to[B32](me: Me) -> B32
    r: U32 = soft_float32_from(negative: me < 0, magnitude: me.abs_diff(0),
        format: B32.FORMAT.peek())
    return bitcast[U32, B32](r)

### U64 to B32, rounded to nearest (ties to even): compiler-rt's `__floatundisf`.
### :returns: The nearest B32.
@inline
@no_builtins
routine U64.soft_to[B32](me: Me) -> B32
    r: U32 = soft_float32_from(negative: false, magnitude: me, format: B32.FORMAT.peek())
    return bitcast[U32, B32](r)

### S128 to B32, rounded to nearest (ties to even): compiler-rt's `__floattisf`.
### :returns: The nearest B32.
@inline
@no_builtins
routine S128.soft_to[B32](me: Me) -> B32
    r: U32 = soft_float32_from(negative: me < 0, magnitude: me.abs_diff(0),
        format: B32.FORMAT.peek())
    return bitcast[U32, B32](r)

### U128 to B32, rounded to nearest (ties to even): compiler-rt's `__floatuntisf`.
### :returns: The nearest B32, or infinity for the values that round to 2^128.
@inline
@no_builtins
routine U128.soft_to[B32](me: Me) -> B32
    r: U32 = soft_float32_from(negative: false, magnitude: me, format: B32.FORMAT.peek())
    return bitcast[U32, B32](r)

### S32 to B64, exactly: compiler-rt's `__floatsidf`.
### :returns: The B64.
@inline
@no_builtins
routine S32.soft_to[B64](me: Me) -> B64
    r: U64 = soft_float64_from(negative: me < 0, magnitude: me.abs_diff(0).to[U64]())
    return bitcast[U64, B64](r)

### U32 to B64, exactly: compiler-rt's `__floatunsidf`.
### :returns: The B64.
@inline
@no_builtins
routine U32.soft_to[B64](me: Me) -> B64
    r: U64 = soft_float64_from(negative: false, magnitude: me.to[U64]())
    return bitcast[U64, B64](r)

### S64 to B64, rounded to nearest (ties to even): compiler-rt's `__floatdidf`.
### :returns: The nearest B64.
@inline
@no_builtins
routine S64.soft_to[B64](me: Me) -> B64
    r: U64 = soft_float64_from(negative: me < 0, magnitude: me.abs_diff(0))
    return bitcast[U64, B64](r)

### U64 to B64, rounded to nearest (ties to even): compiler-rt's `__floatundidf`.
### :returns: The nearest B64.
@inline
@no_builtins
routine U64.soft_to[B64](me: Me) -> B64
    r: Me = soft_float64_from(negative: false, magnitude: me)
    return bitcast[Me, B64](r)

### S128 to B64, rounded to nearest (ties to even): compiler-rt's `__floattidf`.
### :returns: The nearest B64.
@inline
@no_builtins
routine S128.soft_to[B64](me: Me) -> B64
    r: U64 = soft_float64_from(negative: me < 0, magnitude: me.abs_diff(0))
    return bitcast[U64, B64](r)

### U128 to B64, rounded to nearest (ties to even): compiler-rt's `__floatuntidf`.
### :returns: The nearest B64.
@inline
@no_builtins
routine U128.soft_to[B64](me: Me) -> B64
    r: U64 = soft_float64_from(negative: false, magnitude: me)
    return bitcast[U64, B64](r)

### S128 to B16, rounded once to nearest (ties to even): compiler-rt's `__floattihf`, which LLVM calls on x86_64
### and AArch64.
### :returns: The nearest B16, or infinity from 65520 in magnitude up.
@inline
@no_builtins
routine S128.soft_to[B16](me: Me) -> B16
    bits: U32 = soft_float32_from(negative: me < 0, magnitude: me.abs_diff(0),
        format: B16.FORMAT.peek())
    r: U16 = bits.to_wrap[U16]()
    return bitcast[U16, B16](r)

### U128 to B16, rounded once to nearest (ties to even): compiler-rt's `__floatuntihf`, which LLVM calls on
### x86_64 and AArch64.
### :returns: The nearest B16, or infinity from 65520 up.
@inline
@no_builtins
routine U128.soft_to[B16](me: Me) -> B16
    bits: U32 = soft_float32_from(negative: false, magnitude: me, format: B16.FORMAT.peek())
    r: U16 = bits.to_wrap[U16]()
    return bitcast[U16, B16](r)
