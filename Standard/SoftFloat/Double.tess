// Tessera stdlib: B64 arithmetic in software
//
// The B64 operations LLVM calls a routine for on a target without a floating-point unit (Exports.tess and Aeabi.tess
// export them under those names), on the bits, with integer operations only. They round to nearest, ties to even,
// handle subnormals, signed zeros, and infinities, and treat NaN as compiler-rt does: a NaN operand comes back
// quieted (its payload and sign kept, the first operand's when both are NaN), and an invalid operation gives the
// positive quiet NaN 0x7FF8000000000000. Each routine is callable on any target, so a hosted test can check it against the
// hardware.

module Standard/Core

private preset SIGN:      U64 = 0x8000000000000000
private preset MAGNITUDE: U64 = 0x7FFFFFFFFFFFFFFF
private preset INFINITY:  U64 = 0x7FF0000000000000
private preset QUIET:     U64 = 0x0008000000000000
private preset NAN:       U64 = 0x7FF8000000000000
private preset ONE:       U64 = 0x3FF0000000000000

// -- addition ------------------------------------------------------------------

/// B64 addition on the bits, rounded to nearest (ties to even): compiler-rt's `__adddf3`.
/// :param a: The first addend's bits.
/// :param b: The second addend's bits.
/// :returns: The bits of `a + b`: a NaN operand comes back quieted, `inf + -inf` is NaN, and a sum of two zeros is
/// -0 only when both are -0 (an exact zero sum of nonzero values is +0).
#no_builtins
routine soft_b64_add(a: U64, b: U64) -> U64
    local a_size: U64 = a.bitand(MAGNITUDE)
    local b_size: U64 = b.bitand(MAGNITUDE)

    when
        a_size.gt(INFINITY) => return(a.bitor(QUIET))
        b_size.gt(INFINITY) => return(b.bitor(QUIET))
        a_size.eq(INFINITY) => infinite()
        b_size.eq(INFINITY) => return(b)
        a_size.eq(0) => zero()
        b_size.eq(0) => return(a)
        else => order()

    // inf + inf keeps the sign, and inf - inf is NaN
    block infinite()
        opposite: Bool = a.bitxor(b).eq(SIGN)
        branch opposite
            ? return(NAN)
            : return(a)

    block zero()
        both: Bool = b_size.eq(0)
        branch both
            ? return(a.bitand(b))
            : return(b)

    // the larger magnitude first, so the result takes its sign
    block order()
        swap: Bool = b_size.gt(a_size)
        larger: U64 = swap
            ? b
            : a
        smaller: U64 = swap
            ? a
            : b
        jump align(larger, smaller)

    // each significand gets three bits below it (half, and the rest), and the smaller one shifts right to the larger
    // one's exponent with the bits it loses folded into a sticky bit
    block align(x: U64, y: U64)
        x_parts: SoftParts64 = soft_unpack(x.bitand(MAGNITUDE))
        y_parts: SoftParts64 = soft_unpack(y.bitand(MAGNITUDE))
        x_sig: U64 = x_parts.sig.shl(3)
        y_sig: U64 = y_parts.sig.shl(3)
        apart: U64 = x_parts.exponent.sub(y_parts.exponent).to[U64]()
        aligned: U64 = soft_shr_sticky(x: y_sig, shift: apart)
        sign: U64 = x.bitand(SIGN)
        same: Bool = x.bitxor(y).lt(SIGN)
        branch same
            ? return(soft_round_pack(sign, exponent: x_parts.exponent, m: x_sig.add(aligned)))
            : difference(sign, x_sig.sub(aligned), x_parts.exponent)

    // the larger magnitude came first, so the difference isn't negative. An exact zero is +0
    block difference(sign: U64, sig: U64, exponent: S32)
        cancelled: Bool = sig.eq(0)
        branch cancelled
            ? return(0)
            : return(soft_round_pack(sign, exponent, m: sig))

/// B64 subtraction on the bits: `a + (-b)`, as compiler-rt's `__subdf3` computes it (so a NaN `b` comes back with its
/// sign flipped).
/// :param a: The minuend's bits.
/// :param b: The subtrahend's bits.
/// :returns: The bits of `a - b`.
#no_builtins
routine soft_b64_sub(a: U64, b: U64) -> U64
    r: U64 = soft_b64_add(a, b: b.bitxor(SIGN))
    return(r)

// -- multiplication ------------------------------------------------------------

/// B64 multiplication on the bits, rounded to nearest (ties to even): compiler-rt's `__muldf3`.
/// :param a: The first factor's bits.
/// :param b: The second factor's bits.
/// :returns: The bits of `a * b`: a NaN operand comes back quieted, `inf * 0` is NaN, and the sign is the XOR of the
/// signs.
#no_builtins
routine soft_b64_mul(a: U64, b: U64) -> U64
    local sign: U64 = a.bitxor(b).bitand(SIGN)
    local a_size: U64 = a.bitand(MAGNITUDE)
    local b_size: U64 = b.bitand(MAGNITUDE)

    when
        a_size.gt(INFINITY) => return(a.bitor(QUIET))
        b_size.gt(INFINITY) => return(b.bitor(QUIET))
        a_size.eq(INFINITY) => infinite(b_size)
        b_size.eq(INFINITY) => infinite(a_size)
        a_size.eq(0) => return(sign)
        b_size.eq(0) => return(sign)
        else => finite()

    // infinity times zero is NaN, times anything else infinity
    block infinite(other: U64)
        nothing: Bool = other.eq(0)
        branch nothing
            ? return(NAN)
            : return(sign.bitor(INFINITY))

    // the 106-bit product of two 53-bit significands, its leading bit at 104 or 105. Shifted down by 50 with a
    // sticky bit, it is a significand for an exponent of the two exponents' sum minus 1022
    block finite()
        x: SoftParts64 = soft_unpack(a_size)
        y: SoftParts64 = soft_unpack(b_size)
        product: U128 = x.sig.to[U128]().mul_wrap(y.sig.to[U128]())
        sig: U128 = soft_shr_sticky(x: product, shift: 50)
        sum: S32 = x.exponent.add(y.exponent)
        r: U64 = soft_round_pack(sign, exponent: sum.sub(1022), m: sig.to_wrap[U64]())
        return(r)

// -- division ------------------------------------------------------------------

/// B64 division on the bits, rounded to nearest (ties to even): compiler-rt's `__divdf3`, computed by long division.
/// :param a: The dividend's bits.
/// :param b: The divisor's bits.
/// :returns: The bits of `a / b`: a NaN operand comes back quieted, `0 / 0` and `inf / inf` are NaN, and a nonzero
/// value over zero is a signed infinity.
#no_builtins
routine soft_b64_div(a: U64, b: U64) -> U64
    local sign: U64 = a.bitxor(b).bitand(SIGN)
    local a_size: U64 = a.bitand(MAGNITUDE)
    local b_size: U64 = b.bitand(MAGNITUDE)
    local rem: @U64 <- .hollow()
    local quotient: @U64 <- .hollow()

    when
        a_size.gt(INFINITY) => return(a.bitor(QUIET))
        b_size.gt(INFINITY) => return(b.bitor(QUIET))
        a_size.eq(INFINITY) => infinite()
        b_size.eq(INFINITY) => return(sign)
        a_size.eq(0) => zero()
        b_size.eq(0) => return(sign.bitor(INFINITY))
        else => finite()

    block infinite()
        both: Bool = b_size.eq(INFINITY)
        branch both
            ? return(NAN)
            : return(sign.bitor(INFINITY))

    block zero()
        both: Bool = b_size.eq(0)
        branch both
            ? return(NAN)
            : return(sign)

    // a dividend below the divisor doubles, so the quotient is in [1, 2)
    block finite()
        x: SoftParts64 = soft_unpack(a_size)
        y: SoftParts64 = soft_unpack(b_size)
        apart: S32 = x.exponent.sub(y.exponent)
        below: Bool = x.sig.lt(y.sig)
        num: U64 = below
            ? x.sig.shl(1)
            : x.sig
        exponent: S32 = below
            ? apart.add(1022)
            : apart.add(1023)
        num.poke_into(rem)
        0.poke_into(quotient)
        jump divide(exponent, y.sig, 0)

    // 55 quotient bits, one a step: the 53 the result keeps and two below them, then the remainder's sticky bit
    block divide(exponent: S32, den: U64, step: U64)
        done: Bool = step.eq(55)
        branch done
            ? round(exponent)
            : continue
        fits: Bool = rem.peek().ge(den)
        left: U64 = fits
            ? rem.peek().sub_wrap(den)
            : rem.peek()
        q_bit: U64 = fits.to[U64]()
        next: U64 = quotient.peek().shl(1).bitor(q_bit)
        next_quotient: U64 = next
        next_rem: U64 = left.shl(1)
        next_rem.poke_into(rem)
        next_quotient.poke_into(quotient)
        jump divide(exponent, den, step.add(1))

    block round(exponent: S32)
        sticky: U64 = rem.peek().ne(0).to[U64]()
        sig: U64 = quotient.peek().shl(1).bitor(sticky)
        r: U64 = soft_round_pack(sign, exponent, m: sig)
        return(r)

// -- square root and remainder ---------------------------------------------------

/// The B64 square root on the bits, correctly rounded: C's `sqrt`, which LLVM calls for `B64.sqrt` on a target
/// without a floating-point unit. The root comes from a bit-by-bit integer square root.
/// :param a: The radicand's bits.
/// :returns: The bits of sqrt(a): the same zero for ±0, +inf for +inf, a quieted NaN for NaN, and NaN (0x7FF8000000000000)
/// for any other negative value.
#no_builtins
routine soft_b64_sqrt(a: U64) -> U64
    local size: U64 = a.bitand(MAGNITUDE)
    local rem: @U128 <- .hollow()
    local res: @U128 <- .hollow()

    when
        size.gt(INFINITY) => return(a.bitor(QUIET))
        size.eq(0) => return(a)
        a.ge(SIGN) => return(NAN)
        size.eq(INFINITY) => return(a)
        else => finite()

    // an odd unbiased exponent moves one bit into the significand, so the root's exponent is a whole half. The
    // significand scaled by 2^56 has a 55-bit root, the 53 kept bits and two below them
    block finite()
        parts: SoftParts64 = soft_unpack(size)
        unbiased: S32 = parts.exponent.sub(1023)
        odd: Bool = unbiased.bitand(1).eq(1)
        sig: U64 = odd
            ? parts.sig.shl(1)
            : parts.sig
        even: S32 = unbiased.sub(odd.to[S32]())
        radicand: U128 = sig.to[U128]().shl(56)
        radicand.poke_into(rem)
        0.poke_into(res)
        jump root(even.shr(1), 0x1000000000000000000000000000)

    block root(half: S32, bit: U128)
        done: Bool = bit.eq(0)
        branch done
            ? round(half)
            : continue
        trial: U128 = res.peek().add(bit)
        fits: Bool = rem.peek().ge(trial)
        left: U128 = fits
            ? rem.peek().sub_wrap(trial)
            : rem.peek()
        shifted: U128 = res.peek().shr(1)
        next: U128 = fits
            ? shifted.add(bit)
            : shifted
        next_res: U128 = next
        next_rem: U128 = left
        next_rem.poke_into(rem)
        next_res.poke_into(res)
        jump root(half, bit.shr(2))

    block round(half: S32)
        sticky: U64 = rem.peek().ne(0).to[U64]()
        root: U64 = res.peek().to_wrap[U64]()
        sig: U64 = root.shl(1).bitor(sticky)
        r: U64 = soft_round_pack(sign: 0, exponent: half.add(1023), m: sig)
        return(r)

/// The B64 remainder on the bits, exact: C's `fmod`, which LLVM calls for `frem`. The result has the sign of `a`
/// and a magnitude below `|b|`.
/// :param a: The dividend's bits.
/// :param b: The divisor's bits.
/// :returns: The bits of `fmod(a, b)`: a NaN operand comes back quieted, NaN for an infinite `a` or a zero `b`, `a`
/// itself when `|a| < |b|`, and a zero with `a`'s sign when the division is exact.
#no_builtins
routine soft_b64_mod(a: U64, b: U64) -> U64
    local sign: U64 = a.bitand(SIGN)
    local a_size: U64 = a.bitand(MAGNITUDE)
    local b_size: U64 = b.bitand(MAGNITUDE)

    when
        a_size.gt(INFINITY) => return(a.bitor(QUIET))
        b_size.gt(INFINITY) => return(b.bitor(QUIET))
        a_size.eq(INFINITY) => return(NAN)
        b_size.eq(0) => return(NAN)
        a_size.lt(b_size) => return(a)
        a_size.eq(b_size) => return(sign)
        else => finite()

    // long division one exponent step at a time, keeping only the remainder (below 2 × den throughout)
    block finite()
        x: SoftParts64 = soft_unpack(a_size)
        y: SoftParts64 = soft_unpack(b_size)
        jump reduce(x.sig, x.exponent, y.sig, y.exponent)

    block reduce(rem: U64, exponent: S32, den: U64, den_exponent: S32)
        fits: Bool = rem.ge(den)
        left: U64 = fits
            ? rem.sub_wrap(den)
            : rem
        exact: Bool = left.eq(0)
        last: Bool = exponent.eq(den_exponent)
        when
            exact => return(sign)
            last => pack(left, exponent)
            else => reduce(left.shl(1), exponent.sub(1), den, den_exponent)

    // the remainder is exact and fits the format, so the packing doesn't round
    block pack(rem: U64, exponent: S32)
        r: U64 = soft_round_pack(sign, exponent, m: rem.shl(3))
        return(r)

/// B64 raised to an integer power by repeated squaring: compiler-rt's `__powidf2`, with the same multiplications in
/// the same order (so it rounds at each step, as compiler-rt does, rather than once).
/// :param a: The base's bits.
/// :param n: The exponent. A negative one takes the reciprocal of the positive power at the end.
/// :returns: The bits of the result.
#no_builtins
routine soft_b64_powi(a: U64, n: S32) -> U64
    local base: @U64 <- a
    local result: @U64 <- ONE

    count: U32 = n.abs_diff(0)
    jump step(count)

    block step(left: U32)
        odd: Bool = left.bitand(1).eq(1)
        branch odd
            ? continue
            : advance(left)
        soft_b64_mul(a: result.peek(), b: base.peek()).poke_into(result)
        jump advance(left)

    block advance(left: U32)
        rest: U32 = left.shr(1)
        done: Bool = rest.eq(0)
        branch done
            ? finish()
            : continue
        soft_b64_mul(a: base.peek(), b: base.peek()).poke_into(base)
        jump step(rest)

    block finish()
        negative: Bool = n.lt(0)
        branch negative
            ? return(soft_b64_div(a: ONE, b: result.peek()))
            : return(result.peek())

// -- comparison ----------------------------------------------------------------

/// Orders two B64 values as compiler-rt's `__ledf2` (and its aliases `__eqdf2`, `__ltdf2`, `__nedf2`) does.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: -1 when `a < b`, 0 when they are equal (+0 equals -0), 1 when `a > b` or either is NaN.
#no_builtins
routine soft_b64_le(a: U64, b: U64) -> S32
    unordered: Bool = soft_b64_unordered(a, b)
    branch unordered
        ? return(1)
        : return(soft_b64_order(a, b))

/// Orders two B64 values as compiler-rt's `__gedf2` (and its alias `__gtdf2`) does.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: -1 when `a < b` or either is NaN, 0 when they are equal (+0 equals -0), 1 when `a > b`.
#no_builtins
routine soft_b64_ge(a: U64, b: U64) -> S32
    unordered: Bool = soft_b64_unordered(a, b)
    branch unordered
        ? return(-1)
        : return(soft_b64_order(a, b))

/// Whether either B64 is NaN: compiler-rt's `__unorddf2`.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: True when `a` or `b` is NaN.
#no_builtins
routine soft_b64_unordered(a: U64, b: U64) -> Bool
    a_nan: Bool = a.bitand(MAGNITUDE).gt(INFINITY)
    b_nan: Bool = b.bitand(MAGNITUDE).gt(INFINITY)
    r: Bool = a_nan.bitor(b_nan)
    return(r)

/// Two numbers (not NaN) in order: equal zeros first, then as sign-magnitude integers, whose order flips when both
/// are negative.
/// :param a: The first operand's bits.
/// :param b: The second operand's bits.
/// :returns: -1 when `a < b`, 0 when they are equal (+0 equals -0), 1 when `a > b`.
private routine soft_b64_order(a: U64, b: U64) -> S32
    both: U64 = a.bitor(b)
    zeros: Bool = both.bitand(MAGNITUDE).eq(0)
    branch zeros
        ? return(0)
        : continue
    x: S64 = a.to_wrap[S64]()
    y: S64 = b.to_wrap[S64]()
    negative: Bool = x.bitand(y).lt(0)
    order: S32 = x.compare(y)
    branch negative
        ? return(order.neg())
        : return(order)
