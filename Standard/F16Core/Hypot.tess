// Tessera stdlib: the correctly rounded Euclidean distance sqrt(x^2 + y^2) of F16
//
// The legs widen exactly to F64, where both squares are exact and the sum and
// square root keep enough bits that the single final rounding to F16 is
// correct. Round to nearest only: overflow gives +inf, an infinite leg gives
// +inf even when the other is a quiet NaN, NaN comes back quiet (x's before
// y's).
//
// Ported from CORE-MATH, src/binary16/hypot/hypotf16.c via RazorForge's B16Hypot.rf.
// Copyright (c) 2025-2026 Maxence Ponsardin and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// sqrt(`me`^2 + `other`^2), correctly rounded (to nearest). The squares and the sum are taken in F64, so nothing
/// overflows before the final rounding. An infinite leg gives +inf even when the other is a quiet NaN.
/// :param other: The other leg.
/// :returns: The Euclidean distance, +inf on overflow.
routine F16.hypot(me: Me, other: Me) -> Me
    shared sx : U16 = me.bits()
    shared sy : U16 = other.bits()
    shared tx : F64 = me.to<F64>()
    shared ty : F64 = other.to<F64>()

    block entry()
        inf_x  : Bool = sx.bitand(0x7FFF).eq(0x7C00)
        inf_y  : Bool = sy.bitand(0x7FFF).eq(0x7C00)
        qnan_x : Bool = sx.bitand(0x7FFF).ge(0x7E00)
        qnan_y : Bool = sy.bitand(0x7FFF).ge(0x7E00)
        when
            inf_x.bitand(qnan_y) -> return(tx.mul(tx).to<Me>())
            inf_y.bitand(qnan_x) -> return(ty.mul(ty).to<Me>())
            me.is_nan()          -> return(Me.from_bits(sx.bitor(0x0200)))
            other.is_nan()       -> return(Me.from_bits(sy.bitor(0x0200)))
            else                 -> root_sum()

    block root_sum()
        sum_sq : F64 = tx.mul(tx).add(ty.mul(ty))
        return(sum_sq.sqrt().to<Me>())
