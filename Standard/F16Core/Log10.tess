/// log10(self), correctly rounded.
routine F16.log10(self: Self) -> Self
    shared u : U16   = self.bits()
    shared m : USize = u.bitand(0x3FF).to<USize>()

    block entry()
        e : U16 = u.shr(10)
        when
            u.shr(15).ne(0) -> negative()
            e.eq(0x1F)      -> return(self.add(self))  // +inf or NaN
            e.eq(0)         -> return(F32.from_bits(CM_F16_LOG10_T3.getitem(m)).to<Self>())  // subnormal or +0
            else            -> normal(e.to<USize>())

    block normal(e: USize)
        r : F32 = F32.from_bits(CM_F16_LOG10_T1.getitem(e)).add(F32.from_bits(CM_F16_LOG10_T2.getitem(m)))
        return(r.to<Self>())

    // -0 gives -inf, x < 0 gives NaN, a NaN comes back quiet
    block negative()
        when
            u.eq(0x8000)  -> return(Self.NEG_INFINITY)
            self.is_nan() -> return(self.add(self))
            else          -> return(Self.from_bits(0x7E01))
