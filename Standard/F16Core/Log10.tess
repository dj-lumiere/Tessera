// Tessera stdlib: the correctly rounded base-10 logarithm log10(x) of F16
//
// A normal x = 2^e m: log10(2^e) and log10(m) come from two tables of F32 values
// whose sum rounds correctly to F16. Subnormals are tabulated directly. Round
// to nearest only: log10(±0) = -inf, a negative x gives NaN, log10(+inf) = +inf, NaN
// comes back quiet.
//
// Ported from CORE-MATH, src/binary16/log10/log10f16.c via RazorForge's B16Log10.rf.
// Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// F32 bit patterns of log10(x1), where the F16 encoding of x1 is `i1 * 2^10` (i1 encodes the exponent).
preset CM_F16_LOG10_T1: @Array<U32, 32> <- { 0x00000000, 0xC086DC87, 0xC07A74FB, 0xC06730E8,
    0xC053ECD4, 0xC040A8C1, 0xC02D64AE, 0xC01A209B, 0xC006DC87, 0xBFE730E8, 0xBFC0A8C1, 0xBF9A209B,
    0xBF6730E8, 0xBF1A209B, 0xBE9A209B, 0x00000000, 0x3E9A209B, 0x3F1A209B, 0x3F6730E8, 0x3F9A209B,
    0x3FC0A8C1, 0x3FE730E8, 0x4006DC87, 0x401A209B, 0x402D64AE, 0x4040A8C1, 0x4053ECD4, 0x406730E8,
    0x407A74FB, 0x4086DC87, 0x40907E91, 0x00000000 }

