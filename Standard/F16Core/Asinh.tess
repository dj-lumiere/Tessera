// Tessera stdlib: the correctly rounded inverse hyperbolic sine of F16
//
// Evaluated in F32: an odd degree-7 polynomial for |x| < 2^-2, and above that
// one degree-6 polynomial per binade [2^(i-3), 2^(i-2)) on |x|, with the sign
// restored at the end. Four inputs the polynomials round wrongly are returned
// explicitly. Round to nearest only: +-0 and +-inf map to themselves, NaN
// comes back quiet.
//
// Ported from CORE-MATH, src/binary16/asinh/asinhf16.c via RazorForge's B16Asinh.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Row i holds 7 coefficients, as F32 bits: row 0 an odd degree-7 polynomial for
/// asinh on [0, 2^-2] (its x, x^3, x^5, x^7 coefficients in slots 0..3), row i
/// for 1 <= i < 19 a degree-6 polynomial for asinh on [2^(i-3), 2^(i-2)).
preset CM_F16_ASINH_P: @Array<U32, 133> <- { 0x3F800001, 0xBE2AAA6B, 0x3D996252, 0xBD299B79,
    0x00000000, 0x00000000, 0x00000000, 0x37383EBD, 0x3F7FF2D0, 0x3AC35142, 0xBE30443A, 0x3C0E9B68,
    0x3DA1AF84, 0xBD1430EB, 0x3A9614B6, 0x3F7CEAB8, 0x3D5C555C, 0xBE985B52, 0x3E39D7C5, 0xBD50AB27,
    0x3BB48400, 0xBC8B8B14, 0x3F89C173, 0xBDFC560C, 0xBDE33CAE, 0x3D9696FF, 0xBC9C7B13, 0x3AFCEB8B,
    0xBD94B9CE, 0x3FA1EF65, 0xBEC8BB0E, 0x3DC1130D, 0xBC777113, 0x3ABA32A3, 0xB8781735, 0x3E339157,
    0x3F6B5972, 0xBE3EDF1A, 0x3CE0865F, 0xBB281661, 0x390F1759, 0xB652B21A, 0x3F37BF60, 0x3F02FF08,
    0xBD614875, 0x3B89685F, 0xB952D941, 0x36B6ABE0, 0xB3884294, 0x3FAF695F, 0x3E869D80, 0xBC6AAD5C,
    0x3A104816, 0xB75E8735, 0x344174E9, 0xB090A7AE, 0x40036772, 0x3E078BE1, 0xBB6D1B37, 0x3892114D,
    0xB56193EB, 0x31C449B9, 0xAD92DF26, 0x402F9CD7, 0x3D87C03B, 0xBA6D9CF3, 0x37126B93, 0xB362254B,
    0x2F44C88A, 0xAA933C25, 0x405BF108, 0x3D07CA49, 0xB96DB2D3, 0x3592787C, 0xB1623607, 0x2CC4D349,
    0xA79340EA, 0x40842689, 0x3C87C918, 0xB86DAB0B, 0x34126F81, 0xAF622110, 0x2A44BA8E, 0xA49329E0,
    0x409A57E7, 0x3C07BB7B, 0xB76D79E4, 0x329240C6, 0xAD61BEBF, 0x27C44DBF, 0xA192C653, 0x40B085B7,
    0x3B87BD6C, 0xB66D8110, 0x311247D4, 0xAB61CE38, 0x25445FB0, 0x9E92D777, 0x40C6B54C, 0x3B07B797,
    0xB56D6C3A, 0x2F923448, 0xA961A55B, 0x22C43299, 0x9B92AEAF, 0x40DCE4C3, 0x3A87B28E, 0xB46D5A96,
    0x2E1223F2, 0xA76183CF, 0x20440E53, 0x98928E23, 0x40F3134D, 0x3A07B157, 0xB36D5637, 0x2C921FCF,
    0xA5617B1E, 0x1DC404B6, 0x95928563, 0x4104A128, 0x3987AE35, 0xB26D4B70, 0x2B121609, 0xA3616766,
    0x1B43EFB9, 0x929272F7, 0x410FB83F, 0x3907AE89, 0xB16D4C85, 0x299216F9, 0xA1616939, 0x18C3F197,
    0x8F92748B }

/// asinh(self), correctly rounded.
routine F16.asinh(self: Self) -> Self
    block entry()
        v       : F32  = self.to<F32>()
        u       : U32  = v.bits()
        au      : U32  = u.bitand(0x7FFFFFFF)
        special : Bool = au.ge(0x7F800000)
        e       : U32  = au.shr(23)  // 2^(e-127) <= |x| < 2^(e-126)
        tt      : F32  = v.mul(v)
        when
            special   -> special(u, au)
            e.le(124) -> small(v, u, au, tt)
            else      -> binade(v, u, au, tt, e.sub(124).to<USize>())

    // +inf or NaN: x + x (quiets a signaling NaN), and -inf maps to itself
    block special(u: U32, au: U32)
        quiet : Bool = u.eq(0x7F800000).bitor(au.bitand(0x7FFFFF).ne(0))
        branch quiet
            ? return(self.add(self))
            : return(self)

    // |x| < 2^-2
    block small(v: F32, u: U32, au: U32, tt: F32)
        rounds_to_x : Bool = au.le(0x3D38A000)  // for |x| <= 0x1.714p-5, asinh(x) rounds to x
        branch rounds_to_x
            ? tiny(v, u, au)
            : continue
        // an odd degree-7 polynomial
        c5 : F32 = cm_f16_asinh_p(0, 3).mul_add(tt, cm_f16_asinh_p(0, 2))
        c1 : F32 = cm_f16_asinh_p(0, 1).mul_add(tt, cm_f16_asinh_p(0, 0))
        c  : F32 = c5.mul_add(tt.mul(tt), c1)
        return(v.mul(c).to<Self>())

    block tiny(v: F32, u: U32, au: U32)
        zero     : Bool = au.eq(0)
        positive : Bool = au.eq(u)
        when
            zero     -> return(self)
            positive -> return(v.sub(0x1p-26).to<Self>())
            else     -> return(v.add(0x1p-26).to<Self>())

    // |x| >= 2^-2: the polynomials are not odd, so evaluate on |x| and restore the sign
    block binade(v: F32, u: U32, au: U32, tt: F32, i: USize)
        s : F32 = u.shr(31).eq(1)
            ? -1.0
            : 1.0
        t  : F32 = v.mul(s)
        c4 : F32 = cm_f16_asinh_p(i, 5).mul_add(t, cm_f16_asinh_p(i, 4))
        c2 : F32 = cm_f16_asinh_p(i, 3).mul_add(t, cm_f16_asinh_p(i, 2))
        c0 : F32 = cm_f16_asinh_p(i, 1).mul_add(t, cm_f16_asinh_p(i, 0))
        d4 : F32 = cm_f16_asinh_p(i, 6).mul_add(tt, c4)
        d0 : F32 = c2.mul_add(tt, c0)
        y  : F32 = d4.mul_add(tt.mul(tt), d0)
        // the inputs the polynomials round wrongly (each au fixes its binade i)
        when
            au.eq(0x41936000) -> finish(0x1.cdbffep+1, s)  // i = 7
            au.eq(0x436CC000) -> finish(0x1.8a4002p+2, s)  // i = 10
            au.eq(0x43F10000) -> finish(0x1.b7bffap+2, s)  // i = 11
            au.eq(0x44588000) -> finish(0x1.dd4004p+2, s)  // i = 12
            else              -> finish(y, s)

    block finish(y: F32, s: F32)
        return(y.mul(s).to<Self>())

/// Coefficient k of the asinh polynomial for binade index i.
private routine cm_f16_asinh_p(i: USize, k: USize) -> F32
    block entry()
        return(F32.from_bits(CM_F16_ASINH_P.getitem(i.mul(7).add(k))))
