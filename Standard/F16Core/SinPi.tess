/// sin(pi self), correctly rounded (to nearest, ties to even). An integer gives +-0 with the sign of self, a
/// half-integer +-1, +-inf and a quiet NaN give the NaN 0xFE00, and a signaling NaN comes back quiet.
routine F16.sin_pi(self: Self) -> Self
    shared u        : U16  = self.bits()
    shared au       : U16  = u.bitand(0x7FFF)
    shared positive : Bool = au.eq(u)

    block entry()
        at_least_one : Bool = au.ge(0x3C00)
        branch at_least_one
            ? integral()
            : small()

    // |x| >= 1: x is an integer when its encoding bits below the binary point are all 0
    block integral()
        special : Bool = au.ge(0x7C00)
        branch special
            ? return(cm_f16_trig_pi_nan(self))
            : continue
        e            : U16  = au.shr(10)
        has_fraction : Bool = e.le(25)
        mask         : U16  = has_fraction
            ? U16.shr(0x3FF, e.sub(15))
            : 0
        integer : Bool = au.bitand(mask).eq(0)
        branch integer
            ? signed_zero()
            : tabulated()

    block signed_zero()
        branch positive
            ? return(Self.from_bits(0))
            : return(Self.from_bits(0x8000))

    block small()
        zero  : Bool = au.eq(0)
        wrong : Bool = au.eq(0x3BF7)  // the one input whose F32 evaluation would round wrongly
        when
            zero  -> return(self)
            wrong -> listed()
            else  -> tabulated()

    block listed()
        r : Self = F32.to<Self>(0x1.c45ffep-7)
        branch positive
            ? return(r)
            : return(r.neg())

    block tabulated()
        i1, i2 = cm_f16_trig_split(u)
        s1  : F32 = .from_bits(CM_F16_SIN_PI_S1.getitem(i1))
        c1  : F32 = .from_bits(CM_F16_SIN_PI_C1.getitem(i1))
        s2  : F32 = .from_bits(CM_F16_SIN_PI_S2.getitem(i2))
        c2  : F32 = .from_bits(CM_F16_SIN_PI_C2.getitem(i2))
        res : F32 = s1.mul_add(c2, c1.mul(s2))  // the fma fixes the evaluation order
        return(res.to<Self>())

/// The NaN sin_pi, cos_pi and tan_pi give for a non-finite x: a signaling NaN comes back quiet (sign and payload
/// kept), while a quiet NaN or +-inf gives the default NaN 0xFE00 (what the original's 0.0f / 0.0f gives on
/// x86-64), so every target agrees.
routine cm_f16_trig_pi_nan(x: F16) -> F16
    block entry()
        u         : U16  = x.bits()
        au        : U16  = u.bitand(0x7FFF)
        signaling : Bool = au.gt(0x7C00).bitand(au.lt(0x7E00))
        branch signaling
            ? return(F16.from_bits(u.bitor(0x0200)))
            : return(F16.from_bits(0xFE00))
