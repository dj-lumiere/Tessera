/// tanh(self), correctly rounded.
routine F16.tanh(self: Self) -> Self
    block entry():
        u        : U16  = self.bits()
        au       : U16  = u.bitand(0x7FFF)
        positive : Bool = au.eq(u)
        when:
            au.ge(0x4482) -> saturate(au,
                positive)  // |x| >= 0x1.208p+2: tanh(x) rounds to sign(x)
            au.le(0x2744) -> tiny(au)  // |x| <= 0x1.d1p-6: tanh(x) rounds to x
            u.eq(0xBFD5)  -> return(F32.to<Self>(-0x1.ec002p-1))  // the one case the tables can't absorb
            else          -> split(u)

    block saturate(au: U16, positive: Bool):
        near_one : F32 = 0x1.fffff2p-1
        signed   : F32 = positive
            ? near_one
            : near_one.neg()
        one : Self = positive
            ? 1.0
            : -1.0
        when:
            au.gt(0x7C00) -> return(self.sub(self))  // NaN
            au.eq(0x7C00) -> return(one)
            else          -> return(signed.to<Self>())

    block tiny(au: U16):
        zero : Bool = au.eq(0)
        branch zero
            ? return(self)
            : continue
        t : F32 = self.to<F32>()
        return(t.mul_add(-0x1p-12, t).to<Self>())

    // tanh = sinh(x1 + x2) / cosh(x1 + x2)
    block split(u: U16):
        i1            : USize = u.shr(5).to<USize>()
        sign_exponent : U16   = u.shr(10).shl(5)
        i2            : USize = sign_exponent.bitor(u.bitand(0x1F)).to<USize>()
        s1            : F32   = F32.from_bits(CM_F16_TANH_S1.get(i1))
        c1            : F32   = F32.from_bits(CM_F16_HYP_C1.get(i1))
        s2            : F32   = F32.from_bits(CM_F16_HYP_S2.get(i2))
        c2            : F32   = F32.from_bits(CM_F16_HYP_C2.get(i2))
        s             : F32   = s1.mul_add(c2, c1.mul(s2))
        c             : F32   = c1.mul_add(c2, s1.mul(s2))
        return(s.div(c).to<Self>())
