// Tessera stdlib: the correctly rounded inverse hyperbolic cosine of F16
//
// Evaluated in F32 with one degree-5 polynomial per binade [2^i, 2^(i+1)):
// below 32 it approximates acosh(x)/sqrt(x - 1), above that acosh(x) itself.
// The inputs the polynomials round wrongly are returned explicitly. Round to
// nearest only: acosh(1) = +0, x < 1 and -inf give the default NaN 0xFE00,
// +inf maps to itself, and NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary16/acosh/acoshf16.c via RazorForge's B16Acosh.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Row i holds 6 coefficients, as F32 bits: a degree-5 polynomial on [2^i, 2^(i+1))
/// approximating acosh(x)/sqrt(x - 1) for i < 5 and acosh(x) for 5 <= i < 16.
preset CM_F16_ACOSH_P: @Array<U32, 96> <- { 0x3FC8CA05, 0xBE50F729, 0x3D86E325, 0xBCA29884,
    0x3B820523, 0xB9C018CC, 0x3FC75AFD, 0xBE362951, 0x3D26EEE0, 0xBBF4F4AE, 0x3A5B4BD9, 0xB82D96FA,
    0x3FC2A7AD, 0xBE08F094, 0x3C9B1303, 0xBAFD91D8, 0x38F16818, 0xB64690F5, 0x3FB8B991, 0xBDB046BA,
    0x3BE1E759, 0xB9C42CEA, 0x37414704, 0xB4227559, 0x3FA958DA, 0xBD473056, 0x3B097281, 0xB8774433,
    0x357886C9, 0xB1D38F9F, 0x400DA0BB, 0x3DE2C7E8, 0xBB1EA48E, 0x3812272C, 0xB495ACF3, 0x30814B41,
    0x403A229B, 0x3D626A01, 0xBA1E3C3D, 0x3691ADAC, 0xB2951BAE, 0x2E00BE75, 0x40668B75, 0x3CE24860,
    0xB91E13EF, 0x35117B86, 0xB094DC87, 0x2B807E93, 0x4089763A, 0x3C623AF2, 0xB81E02ED, 0x33916596,
    0xAE94C025, 0x2900614D, 0x409FA63F, 0x3BE22EED, 0xB71DF280, 0x32114F39, 0xAC94A1F8, 0x26804112,
    0x40B5D528, 0x3B622ABB, 0xB61DECC4, 0x309147B7, 0xAA949847, 0x240036E8, 0x40CC0441, 0x3AE224D4,
    0xB51DE4A2, 0x2F113C70, 0xA89488DD, 0x21802698, 0x40E23332, 0x3A622003, 0xB41DDDE8, 0x2D91332F,
    0xA6947C52, 0x1F001930, 0x40F8626B, 0x39E21923, 0xB31DD435, 0x2C1125B1, 0xA49469CF, 0x1C800523,
    0x41074896, 0x396215A7, 0xB21DCF5A, 0x2A911F08, 0xA29460D0, 0x19FFF71E, 0x41125FE6, 0x38E21318,
    0xB11DCBDC, 0x29111A3D, 0xA0945A62, 0x177FE976 }

/// acosh(self), correctly rounded.
routine F16.acosh(self: Self) -> Self
    block entry()
        v               : F32  = self.to<F32>()
        u               : U32  = v.bits()
        au              : U32  = u.bitand(0x7FFFFFFF)
        special         : Bool = au.ge(0x7F800000)
        at_most1        : Bool = u.ge(0x80000000).bitor(au.le(0x3F800000))  // x <= 1
        biased_exponent : U32  = au.shr(23)
        when
            special  -> special(u, au)
            at_most1 -> at_most_one(u)
            else     -> binade(v, u, biased_exponent.sub(127).to<USize>())

    // +inf or NaN: x + x (quiets a signaling NaN), and -inf has no real result
    block special(u: U32, au: U32)
        quiet : Bool = u.eq(0x7F800000).bitor(au.bitand(0x7FFFFF).ne(0))
        branch quiet
            ? return(self.add(self))
            : return(Self.from_bits(0xFE00))

    // acosh(1) = +0, and below 1 there is no real result (the default NaN of x86)
    block at_most_one(u: U32)
        one : Bool = u.eq(0x3F800000)
        branch one
            ? return(Self.from_bits(0))
            : return(Self.from_bits(0xFE00))

    // 2^i <= x < 2^(i+1)
    block binade(t: F32, u: U32, i: USize)
        tt : F32 = t.mul(t)
        c4 : F32 = cm_f16_acosh_p(i, 5).mul_add(t, cm_f16_acosh_p(i, 4))
        c2 : F32 = cm_f16_acosh_p(i, 3).mul_add(t, cm_f16_acosh_p(i, 2))
        d2 : F32 = c4.mul_add(tt, c2)
        c0 : F32 = cm_f16_acosh_p(i, 1).mul_add(t, cm_f16_acosh_p(i, 0))
        p  : F32 = d2.mul_add(tt, c0)
        // for x < 32 the polynomial approximates acosh(x) / sqrt(x - 1)
        below32 : Bool = i.lt(5)
        branch below32
            ? scale_by_root(u, t, p)
            : finish(u, p)

    block scale_by_root(u: U32, t: F32, p: F32)
        root : F32 = t.sub(1.0).sqrt()
        jump finish(u, root.mul(p))

    // the inputs the polynomials round wrongly
    block finish(u: U32, y: F32)
        when
            u.eq(0x40422000) -> return(F32.to<Self>(0x1.c63ffcp+0))
            u.eq(0x411C0000) -> return(F32.to<Self>(0x1.7be006p+1))
            u.eq(0x415F6000) -> return(F32.to<Self>(0x1.aa0002p+1))
            u.eq(0x41BFE000) -> return(F32.to<Self>(0x1.ef5fecp+1))
            u.eq(0x41C04000) -> return(F32.to<Self>(0x1.ef9ff6p+1))
            u.eq(0x41DBC000) -> return(F32.to<Self>(0x1.006016p+2))
            u.eq(0x41D3C000) -> return(F32.to<Self>(0x1.fc002ap+1))
            u.eq(0x42374000) -> return(F32.to<Self>(0x1.21201cp+2))
            u.eq(0x4245C000) -> return(F32.to<Self>(0x1.260012p+2))
            u.eq(0x42890000) -> return(F32.to<Self>(0x1.3ae018p+2))
            u.eq(0x429D6000) -> return(F32.to<Self>(0x1.43bff4p+2))
            u.eq(0x433D2000) -> return(F32.to<Self>(0x1.7be006p+2))
            u.eq(0x43884000) -> return(F32.to<Self>(0x1.934004p+2))
            u.eq(0x43F9A000) -> return(F32.to<Self>(0x1.ba000ep+2))
            u.eq(0x443B0000) -> return(F32.to<Self>(0x1.d3e00cp+2))
            u.eq(0x45B78000) -> return(F32.to<Self>(0x1.2be008p+3))
            u.eq(0x4673A000) -> return(F32.to<Self>(0x1.4b2008p+3))
            else             -> return(y.to<Self>())

/// Coefficient k of the acosh polynomial for binade index i.
private routine cm_f16_acosh_p(i: USize, k: USize) -> F32
    block entry()
        return(F32.from_bits(CM_F16_ACOSH_P.get(i.mul(6).add(k))))
