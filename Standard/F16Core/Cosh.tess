/// cosh(self), correctly rounded.
routine F16.cosh(self: Self) -> Self
    block entry():
        u    : U16  = self.bits().bitand(0x7FFF)  // cosh(-x) = cosh(x)
        zero : Bool = u.eq(0)
        branch zero
            ? return(1.0)
            : continue
        i1            : USize = u.shr(5).to<USize>()
        sign_exponent : U16   = u.shr(10).shl(5)
        i2            : USize = sign_exponent.bitor(u.bitand(0x1F)).to<USize>()
        s1            : F32   = F32.from_bits(CM_F16_COSH_S1.get(i1))
        c1            : F32   = F32.from_bits(CM_F16_COSH_C1.get(i1))
        s2            : F32   = F32.from_bits(CM_F16_COSH_S2.get(i2))
        c2            : F32   = F32.from_bits(CM_F16_HYP_C2.get(i2))
        r             : F32   = c1.mul_add(c2, s1.mul(s2))
        return(r.to<Self>())
