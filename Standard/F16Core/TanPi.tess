/// tan(pi self), correctly rounded (to nearest, ties to even). An integer n gives +0 for a positive even n or a
/// negative odd one and -0 otherwise, n + 1/2 gives +inf for an even n and -inf for an odd one (for the sign of
/// self), +-inf and a quiet NaN give the NaN 0xFE00, and a signaling NaN comes back quiet.
routine F16.tan_pi(self: Self) -> Self
    shared u        : U16  = self.bits()
    shared au       : U16  = u.bitand(0x7FFF)
    shared positive : Bool = au.eq(u)

    block entry()
        from_half : Bool = au.ge(0x3800)  // |x| >= 1/2: maybe an integer or a half-integer
        minus0    : Bool = u.eq(0x8000)  // the only input the tables get wrong
        when
            from_half -> exact()
            minus0    -> return(self)
            else      -> tabulated()

    // 14 <= e <= 30, the biased exponent: the bit of weight 1 is bit 25 - e of the encoding (none when e >= 26,
    // where |x| is even), the bit of weight 1/2 is bit 24 - e (the hidden bit when e = 14)
    block exact()
        special : Bool = au.ge(0x7C00)
        branch special
            ? return(cm_f16_trig_pi_nan(self))
            : continue
        e       : U16  = au.shr(10)
        integer : Bool = au.bitand(cm_f16_tan_pi_fraction_mask(e.sub(14))).eq(0)
        halfway : Bool = au.bitand(cm_f16_tan_pi_fraction_mask(e.sub(13))).eq(0)
        when
            integer -> integer(e)
            halfway -> halfway(e)
            else    -> tabulated()

    block integer(e: U16)
        large : Bool = e.ge(26)
        branch large
            ? integer_parity(true)
            : integer_parity(au.bitand(U16.shl(1, U16.sub(25, e))).eq(0))

    block integer_parity(even: Bool)
        plus : Bool = even.eq(positive)
        branch plus
            ? return(Self.from_bits(0))
            : return(Self.from_bits(0x8000))

    block halfway(e: U16)
        half : Bool = e.eq(14)  // |x| = 1/2
        branch half
            ? pole(true)
            : pole(au.bitand(U16.shl(1, U16.sub(25, e))).eq(0))

    // x = n + 1/2: near_even says whether n (of |x|) is even
    block pole(near_even: Bool)
        plus : Bool = near_even.eq(positive)
        branch plus
            ? return(Self.INFINITY)
            : return(Self.NEG_INFINITY)

    block tabulated()
        i1, i2 = cm_f16_trig_split(u)
        s1 : F32 = .from_bits(CM_F16_TAN_PI_S1.getitem(i1))
        c1 : F32 = .from_bits(CM_F16_SIN_PI_C1.getitem(i1))
        s2 : F32 = .from_bits(CM_F16_SIN_PI_S2.getitem(i2))
        c2 : F32 = .from_bits(CM_F16_SIN_PI_C2.getitem(i2))
        s  : F32 = s1.mul_add(c2, c1.mul(s2))  // the fmas fix the evaluation order
        c  : F32 = c1.mul_add(c2, s1.neg().mul(s2))
        r  : F32 = s.div(c)
        return(r.to<Self>())

/// The mask of the encoding bits below the binary point, shifted left by one, for an F16 with biased exponent
/// 14 + j (j = 0 is |x| in [1/2, 1), where the bit 1/2 is the hidden bit): 0xFFF for j = 0, 0x3FF >> (j - 1) for
/// 1 <= j <= 11, else 0.
private routine cm_f16_tan_pi_fraction_mask(j: U16) -> U16
    block entry()
        when
            j.eq(0)  -> return(0xFFF)
            j.le(11) -> return(U16.shr(0x3FF, j.sub(1)))
            else     -> return(0)
