/// 10^`me`, correctly rounded (to nearest, ties to even). 10^-inf = +0, 10^+inf = +inf, overflow gives +inf,
/// underflow +0, and NaN comes back quiet.
/// :returns: 10^`me`.
routine F16.exp10(me: Me) -> Me
    block entry()
        u             : U16   = me.bits()
        i1            : USize = u.shr(5).to<USize>()
        sign_exponent : U16   = u.shr(10).shl(5)
        i2            : USize = sign_exponent.bitor(u.bitand(0x1F)).to<USize>()
        t1            : U32   = CM_F16_EXP10_T1.getitem(i1)
        t2            : U32   = CM_F16_EXP10_T2.getitem(i2)
        is_nan        : Bool  = me.is_nan()
        branch is_nan
            ? return(cm_f16_exp10_pick_nan(t1, t2))
            : continue
        r : F32 = F32.from_bits(t1).mul(F32.from_bits(t2))
        return(r.to<Me>())

/// The NaN result for a NaN input, whose two table entries may both be NaN patterns. The NaN is picked explicitly
/// instead of relying on the platform's NaN propagation: `first` when it is a NaN, else `second`, quieted and
/// narrowed to F16 by truncating its payload, as the x86 reference does.
/// :param first: The F32 bits of the first table entry.
/// :param second: The F32 bits of the second table entry.
/// :returns: The quiet F16 NaN.
private routine cm_f16_exp10_pick_nan(first: U32, second: U32) -> F16
    block entry()
        first_nan : Bool = first.bitand(0x7FFFFFFF).gt(0x7F800000)
        n         : U32  = first_nan
            ? first
            : second
        quiet : U32 = n.bitor(0x00400000)
        sign  : U32 = quiet.shr(16).bitand(0x8000)
        h     : U32 = sign.bitor(0x7C00).bitor(quiet.shr(13).bitand(0x3FF))
        return(F16.from_bits(h.to<U16>()))
