/// In radians.
routine F16.tan(self: Self) -> Self
    block entry():
        u    : U16  = self.bits()
        au   : U16  = u.bitand(0x7FFF)
        tiny : Bool = au.le(0x2744)  // |x| <= 0x1.d1p-6: tan(x) rounds like x + x 2^-12
        when:
            tiny          -> tiny()
            au.eq(0x55ED) -> return(F32.to<Self>(0x1.445ffep-1).copysign(self))  // |x| = 0x1.7b4p+6
            au.eq(0x658C) -> return(F32.to<Self>(0x1.f9bd04p-14).copysign(self))  // |x| = 0x1.63p+10
            au.eq(0x6429) -> return(F32.to<Self>(0x1.7b4dc2p-14).copysign(self))  // |x| = 0x1.0a4p+10
            u.eq(0x681E)  -> return(F32.to<Self>(-0x1.1c1fbep-7))  // x = 0x1.078p+11
            u.eq(0xE74E)  -> return(F32.to<Self>(-0x1.df4002p-1))  // x = -0x1.d38p+10
            u.eq(0xE807)  -> return(F32.to<Self>(-0x1.053ffep+1))  // x = -0x1.01cp+11
            u.eq(0x6F4D)  -> return(F32.to<Self>(-0x1.867ffep+0))  // x = 0x1.d34p+12
            else          -> tabulated(u)

    block tiny():
        t : F32 = self.to<F32>()
        return(t.mul_add(0x1p-12, t).to<Self>())

    block tabulated(u: U16):
        i1, i2 = cm_f16_trig_split(u)
        s1 : F32 = .from_bits(CM_F16_TAN_S1.get(i1))
        c1 : F32 = .from_bits(CM_F16_TAN_C1.get(i1))
        s2 : F32 = .from_bits(CM_F16_TAN_S2.get(i2))
        c2 : F32 = .from_bits(CM_F16_SIN_C2.get(i2))
        s  : F32 = s1.mul_add(c2, c1.mul(s2))  // the fmas fix the evaluation order
        c  : F32 = c1.mul_add(c2, s1.neg().mul(s2))
        return(s.div(c).to<Self>())
