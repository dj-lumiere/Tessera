# -- the adapters --------------------------------------------------------------

### x, to be written by its diagnose_into: what x.diagnose() hands back.
record Diagnosed[T]
    value: T

### x, to be written by its represent_into: what x.represent() hands back.
record Represented[T]
    value: T

obeys Representable[Diagnosed[T]] when T: typename, Diagnosable[T]
obeys Representable[Represented[T]] when T: typename, Representable[T]

### Makes a `Diagnosed` from its fields.
### :param value: Its `value`.
### :returns: The new value.
routine Diagnosed[T].construct(value: T) -> Me
    return Me(value)

### Releases nothing: a `Diagnosed` holds no memory of its own.
routine Diagnosed[T].destruct(me: @Me) -> None
    return

### Makes a `Represented` from its fields.
### :param value: Its `value`.
### :returns: The new value.
routine Represented[T].construct(value: T) -> Me
    return Me(value)

### Releases nothing: a `Represented` holds no memory of its own.
routine Represented[T].destruct(me: @Me) -> None
    return

### `me`, to be written as Tessera source: Console.show("{x.diagnose()}", end: "").
### :returns: `me` in a `Diagnosed` adapter.
routine T.diagnose(me: T) -> Diagnosed[T]
needs T: typename, Diagnosable[T]
    return Diagnosed[Me](value: me)

### `me`, to be written as the program's output (what a plain hole already does): Console.show("{x.represent()}", end: "").
### :returns: `me` in a `Represented` adapter.
routine T.represent(me: T) -> Represented[T]
needs T: typename, Representable[T]
    return Represented[Me](value: me)

### Writes the wrapped value with its `diagnose_into`, so a template hole holding `x.diagnose()` prints the source form.
### :typeparam T: The wrapped type, which must conform to {Diagnosable}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The Writer the text is written to.
routine Diagnosed[T].represent_into[TWriter](me: Me, out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    me.value.diagnose_into(out)
    return

### Writes the wrapped value with its `represent_into`.
### :typeparam T: The wrapped type, which must conform to {Representable}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The Writer the text is written to.
routine Represented[T].represent_into[TWriter](me: Me, out: @TWriter) -> None
needs T: typename, Representable[T], TWriter: typename, Writer[TWriter]
    me.value.represent_into(out)
    return
