# Tessera stdlib: construction and the hosted routines on the default heap
#
# The hosted layer gives the collections and Memory a construct without an
# allocator, drawing from DEFAULT_HEAP (Os/Heap.tess). Like Out and Err, they
# exist only where Standard/Os is imported: a file that doesn't import it, and
# every program for a target without an operating system, passes an allocator.

module Standard/Os

import Standard/Alloc
import Standard/Collections

### `count` uninitialized values of `T` on the default heap, dropped when done. A count of 0 allocates
### nothing.
### :param count: The number of values.
### :returns: The slice, owning its memory.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates heap memory")
routine Memory[T].construct(count: USize) -> Me
needs T: typename
    return Me.construct(count, manager: DEFAULT_HEAP)

### An empty List on the default heap. Nothing is allocated until the first insertion.
### :returns: The empty collection.
routine List[T].construct() -> Me
needs T: typename
    return Me.construct(DEFAULT_HEAP)

### An empty CircularList on the default heap.
### :returns: The empty collection.
routine CircularList[T].construct() -> Me
needs T: typename
    return Me.construct(DEFAULT_HEAP)

### An empty PriorityQueue on the default heap.
### :returns: The empty collection.
routine PriorityQueue[TPriority, TElement].construct() -> Me
needs TPriority: typename, TElement: typename
    return Me.construct(DEFAULT_HEAP)

### An empty Dict on the default heap.
### :returns: The empty collection.
routine Dict[TKey, TValue].construct() -> Me
needs TKey: typename, TValue: typename
    return Me.construct(DEFAULT_HEAP)

### An empty Set on the default heap.
### :returns: The empty collection.
routine Set[T].construct() -> Me
needs T: typename
    return Me.construct(DEFAULT_HEAP)

### An empty SortedDict on the default heap.
### :returns: The empty collection.
routine SortedDict[TKey, TValue].construct() -> Me
needs TKey: typename, TValue: typename
    return Me.construct(DEFAULT_HEAP)

### An empty SortedSet on the default heap.
### :returns: The empty collection.
routine SortedSet[T].construct() -> Me
needs T: typename
    return Me.construct(DEFAULT_HEAP)

### An empty SortedList on the default heap.
### :returns: The empty collection.
routine SortedList[T].construct() -> Me
needs T: typename
    return Me.construct(DEFAULT_HEAP)

# -- the hosted routines on the default heap ---------------------------------------------
#
# Every routine of this layer that hands back memory takes an allocator, and has an overload here without one that
# draws from DEFAULT_HEAP. The allocator version stays for memory that should come from somewhere else (an arena,
# a fixed buffer).

### The next word (spaces, tabs, and line ends separate words) on the default heap. The space after the word stays in
### the input. Drop it.
### :returns: The word.
### :throws: Crashes with `AbsentValueError` at the end of the input. See {In.read_word_checked}.
@track_caller
@expensive("allocates what it reads")
routine In.read_word() -> Memory[Byte]
    return Me.read_word(DEFAULT_HEAP)

### The next word on the default heap, or None at the end of the input. Drop it.
### :returns: The word, or None at the end of the input.
@expensive("allocates what it reads")
routine In.read_word_checked() -> Maybe[Memory[Byte]]
    return Me.read_word_checked(DEFAULT_HEAP)

### The next line, without its "\n" (or "\r\n"), on the default heap. A last line with no "\n" still counts, and a
### blank line is "". Drop it.
### :returns: The line.
### :throws: Crashes with `AbsentValueError` at the end of the input. See {In.read_line_checked}.
@track_caller
@expensive("allocates what it reads")
routine In.read_line() -> Memory[Byte]
    return Me.read_line(DEFAULT_HEAP)

### The next line on the default heap, or None at the end of the input. Drop it.
### :returns: The line, or None at the end of the input.
@expensive("allocates what it reads")
routine In.read_line_checked() -> Maybe[Memory[Byte]]
    return Me.read_line_checked(DEFAULT_HEAP)

### The rest of the input on the default heap. Drop it.
### :returns: The rest of the input.
@expensive("allocates what it reads")
routine In.read_all() -> Memory[Byte]
    return Me.read_all(DEFAULT_HEAP)

### Up to count bytes on the default heap, fewer only at the end of the input. Drop them.
### :param count: The most bytes to read.
### :returns: The bytes read.
@expensive("allocates what it reads")
routine In.read_count(count: USize) -> Memory[Byte]
    return Me.read_count(count, alloc: DEFAULT_HEAP)

### The whole file on the default heap. Drop it.
### :returns: The file's bytes, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.read_all_result(me: @Me) -> Result[Memory[Byte], FsError]
    return me.read_all_result(DEFAULT_HEAP)

### The path made absolute by the text, nothing looked up, on the default heap. Drop it.
### :returns: The absolute {File}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.absolute_result(me: @Me) -> Result[Me, FsError]
    return me.absolute_result(DEFAULT_HEAP)

### The absolute path with every link, ".", and ".." resolved, on the default heap. The file must exist. Drop it.
### :returns: The canonical {File}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.canonical_result(me: @Me) -> Result[Me, FsError]
    return me.canonical_result(DEFAULT_HEAP)

### Deletes the directory and everything in it, building child paths on the default heap. A link inside is deleted,
### not followed.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.delete_all_result(me: @Me) -> Result[None, FsError]
    return me.delete_all_result(DEFAULT_HEAP)

### The file name in this directory, its path on the default heap (drop it).
### :param name: The file's name.
### :returns: The {File}.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates the joined path")
routine Directory.file(me: @Me, name: Span[Byte]) -> File
    return me.file(name, alloc: DEFAULT_HEAP)

### The directory name in this directory, its path on the default heap (drop it).
### :param name: The directory's name.
### :returns: The {Directory}.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates the joined path")
routine Directory.subdir(me: @Me, name: Span[Byte]) -> Me
    return me.subdir(name, alloc: DEFAULT_HEAP)

### The path made absolute by its text, nothing else looked up, on the default heap. Drop it.
### :returns: The absolute {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.absolute_result(me: @Me) -> Result[Me, FsError]
    return me.absolute_result(DEFAULT_HEAP)

### The absolute path with every link, `.`, and `..` resolved, on the default heap. The directory must exist. Drop it.
### :returns: The canonical {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.canonical_result(me: @Me) -> Result[Me, FsError]
    return me.canonical_result(DEFAULT_HEAP)

### The working directory, its path on the default heap (drop it).
### :returns: The working {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.current_result() -> Result[Me, FsError]
    return Me.current_result(DEFAULT_HEAP)

### The temporary directory (TMPDIR or /tmp, on Windows GetTempPathW's), its path on the default heap
### (drop it).
### :returns: The temporary {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.temp_result() -> Result[Me, FsError]
    return Me.temp_result(DEFAULT_HEAP)

### The user's home directory (HOME, on Windows USERPROFILE), its path on the default heap. NotFound when it can't be
### told.
### :returns: The home {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.home_result() -> Result[Me, FsError]
    return Me.home_result(DEFAULT_HEAP)

### a and b with a separator between them (none added after one a already ends with), on the default heap. Drop
### it.
### :param a: The leading part.
### :param b: The part to append.
### :returns: The joined path.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates the joined path")
routine join_path(a: Span[Byte], b: Span[Byte]) -> Memory[Byte]
    return join_path(a, b, alloc: DEFAULT_HEAP)

### The value of the environment variable name on the default heap, or None when it isn't set. Drop it.
### :param name: The variable's name.
### :returns: The value's bytes.
### :absent: When the variable isn't set, its name is too long or holds a NUL, or the value can't be read or allocated.
@expensive("allocates a copy of the variable")
routine env_var(name: Span[Byte]) -> Maybe[Memory[Byte]]
    return env_var(name, alloc: DEFAULT_HEAP)
