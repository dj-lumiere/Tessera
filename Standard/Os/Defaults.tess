// Tessera stdlib: construction and the hosted routines on the default heap
//
// The hosted layer gives the collections and Slice a construct without an
// allocator, drawing from DEFAULT_HEAP (Os/Heap.tess). Like Out and Err, they
// exist only where Standard::Os is imported: a file that doesn't import it, and
// every program for a target without an operating system, passes an allocator.

module Standard::Os

import Standard::Alloc
import Standard::Collections

/// `count` uninitialized values of `T` on the default heap, given back with `destruct()`. A count of 0 allocates
/// nothing.
/// :param count: The number of values.
/// :returns: The slice, owning its memory.
/// :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
#track_caller
routine Slice<T>.construct(count: USize) -> Self
require T: typename
    block entry()
        owned : Self = Self.construct(count, DEFAULT_HEAP)
        return(owned)

/// An empty List on the default heap. Nothing is allocated until the first insertion.
/// :returns: The empty collection.
routine List<T>.construct() -> Self
require T: typename
    block entry()
        list : Self = Self.construct(DEFAULT_HEAP)
        return(list)

/// An empty CircularList on the default heap.
/// :returns: The empty collection.
routine CircularList<T>.construct() -> Self
require T: typename
    block entry()
        list : Self = Self.construct(DEFAULT_HEAP)
        return(list)

/// An empty PriorityQueue on the default heap.
/// :returns: The empty collection.
routine PriorityQueue<T>.construct() -> Self
require T: typename, Ordered<T>
    block entry()
        queue : Self = Self.construct(DEFAULT_HEAP)
        return(queue)

/// An empty Dict on the default heap.
/// :returns: The empty collection.
routine Dict<TKey, TValue>.construct() -> Self
require TKey: typename, TValue: typename, HashEquatable<TKey>
    block entry()
        map : Self = Self.construct(DEFAULT_HEAP)
        return(map)

/// An empty Set on the default heap.
/// :returns: The empty collection.
routine Set<T>.construct() -> Self
require T: typename, HashEquatable<T>
    block entry()
        set : Self = Self.construct(DEFAULT_HEAP)
        return(set)

/// An empty SortedDict on the default heap.
/// :returns: The empty collection.
routine SortedDict<TKey, TValue>.construct() -> Self
require TKey: typename, TValue: typename, Comparable<TKey>
    block entry()
        map : Self = Self.construct(DEFAULT_HEAP)
        return(map)

/// An empty SortedSet on the default heap.
/// :returns: The empty collection.
routine SortedSet<T>.construct() -> Self
require T: typename, Comparable<T>
    block entry()
        set : Self = Self.construct(DEFAULT_HEAP)
        return(set)

/// An empty SortedList on the default heap.
/// :returns: The empty collection.
routine SortedList<T>.construct() -> Self
require T: typename, Comparable<T>
    block entry()
        list : Self = Self.construct(DEFAULT_HEAP)
        return(list)

// -- the hosted routines on the default heap ---------------------------------------------
//
// Every routine of this layer that hands back memory takes an allocator, and has an overload here without one that
// draws from DEFAULT_HEAP. The allocator version stays for memory that should come from somewhere else (an arena,
// a fixed buffer).

/// The next word (spaces, tabs, and line ends separate words) on the default heap. The space after the word stays in
/// the input. Release it with destruct().
/// :returns: The word.
/// :throws: Crashes with `AbsentValueError` at the end of the input. See {In.read_word_checked}.
#track_caller
routine In.read_word() -> Bytes
    block entry()
        return(Self.read_word(DEFAULT_HEAP))

/// The next word on the default heap, or Absent at the end of the input. Release it with destruct().
/// :returns: The word, or Absent at the end of the input.
routine In.read_word_checked() -> Option<Bytes>
    block entry()
        return(Self.read_word_checked(DEFAULT_HEAP))

/// The next line, without its "\n" (or "\r\n"), on the default heap. A last line with no "\n" still counts, and a
/// blank line is "". Release it with destruct().
/// :returns: The line.
/// :throws: Crashes with `AbsentValueError` at the end of the input. See {In.read_line_checked}.
#track_caller
routine In.read_line() -> Bytes
    block entry()
        return(Self.read_line(DEFAULT_HEAP))

/// The next line on the default heap, or Absent at the end of the input. Release it with destruct().
/// :returns: The line, or Absent at the end of the input.
routine In.read_line_checked() -> Option<Bytes>
    block entry()
        return(Self.read_line_checked(DEFAULT_HEAP))

/// The rest of the input on the default heap. Release it with destruct().
/// :returns: The rest of the input.
routine In.read_all() -> Bytes
    block entry()
        return(Self.read_all(DEFAULT_HEAP))

/// Up to count bytes on the default heap, fewer only at the end of the input. Release them with destruct().
/// :param count: The most bytes to read.
/// :returns: The bytes read.
routine In.read_count(count: USize) -> Bytes
    block entry()
        return(Self.read_count(count, DEFAULT_HEAP))

/// The whole file on the default heap. Release it with destruct().
/// :returns: `Success` with the file's bytes, or `Failure` with the {FsError} the OS reported.
routine File.read_all_result(self: Self) -> Result<Bytes, FsError>
    block entry()
        return(self.read_all_result(DEFAULT_HEAP))

/// The path made absolute by the text, nothing looked up, on the default heap. Give it back with
/// `file.destruct()`.
/// :returns: `Success` with the absolute {File}, or `Failure` with the {FsError} the OS reported.
routine File.absolute_result(self: Self) -> Result<Self, FsError>
    block entry()
        return(self.absolute_result(DEFAULT_HEAP))

/// The absolute path with every link, ".", and ".." resolved, on the default heap. The file must exist. Give it back
/// with `file.destruct()`.
/// :returns: `Success` with the canonical {File}, or `Failure` with the {FsError} the OS reported.
routine File.canonical_result(self: Self) -> Result<Self, FsError>
    block entry()
        return(self.canonical_result(DEFAULT_HEAP))

/// Deletes the directory and everything in it, building child paths on the default heap. A link inside is deleted,
/// not followed.
/// :returns: `Success`, or `Failure` with the {FsError} the OS reported.
routine Directory.delete_all_result(self: Self) -> Result<Unit, FsError>
    block entry()
        return(self.delete_all_result(DEFAULT_HEAP))

/// The file name in this directory, its path on the default heap (`file.destruct()` gives it
/// back).
/// :param name: The file's name.
/// :returns: The {File}.
/// :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
#track_caller
routine Directory.file(self: Self, name: Bytes) -> File
    block entry()
        return(self.file(name, DEFAULT_HEAP))

/// The directory name in this directory, its path on the default heap (`dir.destruct()`
/// gives it back).
/// :param name: The directory's name.
/// :returns: The {Directory}.
/// :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
#track_caller
routine Directory.subdir(self: Self, name: Bytes) -> Self
    block entry()
        return(self.subdir(name, DEFAULT_HEAP))

/// The path made absolute by its text, nothing else looked up, on the default heap. Give it back with
/// `dir.destruct()`.
/// :returns: `Success` with the absolute {Directory}, or `Failure` with the {FsError} the OS reported.
routine Directory.absolute_result(self: Self) -> Result<Self, FsError>
    block entry()
        return(self.absolute_result(DEFAULT_HEAP))

/// The absolute path with every link, `.`, and `..` resolved, on the default heap. The directory must exist. Give it
/// back with `dir.destruct()`.
/// :returns: `Success` with the canonical {Directory}, or `Failure` with the {FsError} the OS reported.
routine Directory.canonical_result(self: Self) -> Result<Self, FsError>
    block entry()
        return(self.canonical_result(DEFAULT_HEAP))

/// The working directory, its path on the default heap (`dir.destruct()` gives it back).
/// :returns: `Success` with the working {Directory}, or `Failure` with the {FsError} the OS reported.
routine Directory.current_result() -> Result<Self, FsError>
    block entry()
        return(Self.current_result(DEFAULT_HEAP))

/// The temporary directory (TMPDIR or /tmp, on Windows GetTempPathW's), its path on the default heap
/// (`dir.destruct()` gives it back).
/// :returns: `Success` with the temporary {Directory}, or `Failure` with the {FsError} the OS reported.
routine Directory.temp_result() -> Result<Self, FsError>
    block entry()
        return(Self.temp_result(DEFAULT_HEAP))

/// The user's home directory (HOME, on Windows USERPROFILE), its path on the default heap. NotFound when it can't be
/// told.
/// :returns: `Success` with the home {Directory}, or `Failure` with the {FsError} the OS reported.
routine Directory.home_result() -> Result<Self, FsError>
    block entry()
        return(Self.home_result(DEFAULT_HEAP))

/// a and b with a separator between them (none added after one a already ends with), on the default heap. Release it
/// with destruct().
/// :param a: The leading part.
/// :param b: The part to append.
/// :returns: The joined path.
/// :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
#track_caller
routine join_path(a: Bytes, b: Bytes) -> Bytes
    block entry()
        return(join_path(a, b, DEFAULT_HEAP))

/// The value of the environment variable name on the default heap, or Absent when it isn't set. Release it with
/// destruct().
/// :param name: The variable's name.
/// :returns: The value's bytes.
/// :absent: When the variable isn't set, its name is too long or holds a NUL, or the value can't be read or allocated.
routine env_var(name: Bytes) -> Option<Bytes>
    block entry()
        return(env_var(name, DEFAULT_HEAP))

/// Starts entry(arg) on a new thread, its start record on the default heap.
/// :typeparam T: The type of the state the thread works on.
/// :param entry: The routine the thread runs.
/// :param arg: The state it works on, which must outlive the thread.
/// :returns: The new thread, to {Thread.join} or {Thread.detach}.
/// :throws: Crashes with `MemoryAllocationError` when the default heap can't give the thread's start record, and
///     with `TaskSpawnError` when the operating system starts no thread.
#track_caller
routine Thread.spawn<T>(entry: Callable<(@T,), Void>, arg: @T) -> Self
require T: typename
    block entry()
        thread : Self = Self.spawn(entry, arg, DEFAULT_HEAP)
        return(thread)
