# Tessera stdlib: ExclusiveAccess
#
# Access for one thread or fiber at a time, the same on every operating system: its state in one U32 (Drepper's
# three-state futex mutex, 0 free, 1 taken, 2 taken with a flow that may be waiting), the id of the flow holding it,
# and how often and how long flows waited for it. Taking a free one is one atomic step. A flow that finds it taken
# waits through the AccessManager, which looks for a deadlock first and parks the flow the way it waits (a thread
# sleeps, a fiber parks a short while at a time so the other fibers of its thread go on). Taking it again from the
# flow that holds it stops the program with ReenterDuringAccessError. It starts free (`.construct()`) and needs
# nothing given back.

module Standard/Os

### Access for one thread or fiber at a time: {ExclusiveAccess.lock} waits until it is free and takes it,
### {ExclusiveAccess.unlock} gives it up. It records which flow holds it, so taking it again from that flow stops the
### program with `ReenterDuringAccessError`, and a wait goes through the {AccessManager}, which finds deadlocks. It
### starts free and needs nothing given back.
record ExclusiveAccess
    ### 0 free, 1 taken, 2 taken with a flow that may be waiting.
    state: U32
    ### The id of the flow holding it, 0 while free.
    holder: U64
    ### How many times a flow had to wait for it.
    waits: U64
    ### How long flows waited for it in all, in nanoseconds.
    waited: U64

### A free access.
### :returns: An {ExclusiveAccess} that no flow holds and none waited for.
common routine ExclusiveAccess.construct() -> Me
    return Me(state: 0, holder: 0, waits: 0, waited: 0)

### Takes the access, waiting until it is free when another flow holds it.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it, and with `DeadlockError`
### (with the deadlock check on) when the flows waiting for each other close a cycle.
@track_caller
@target(os: not "none")
routine @ExclusiveAccess.lock() -> None
    me.take(place: caller_location(), deadline: Duration.MAX, hooked: false)
    return

### As {ExclusiveAccess.lock}, giving `place` as where it is taken: for another language's runtime, whose agents wait
### the way it asked the {AccessManager} (`AccessManager.set_park`).
### :param place: Where the access is taken.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it, and with `DeadlockError`
### (with the deadlock check on) when the flows waiting for each other close a cycle.
@target(os: not "none")
routine @ExclusiveAccess.lock_at(place: @SourceLocation) -> None
    me.take(place, deadline: Duration.MAX, hooked: true)
    return

### Takes the access, waiting at most `timeout` for another flow to give it up.
### :param timeout: The longest wait.
### :returns: True when it took the access, false when the time ran out first.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it.
@track_caller
@target(os: not "none")
routine @ExclusiveAccess.lock_within(timeout: Duration) -> Bool
    deadline: Duration = Clock.monotonic() +^ timeout
    return me.take(place: caller_location(), deadline, hooked: false)

### Gives the access up, waking one flow that waits for it. Only the flow holding it may call it.
@target(os: not "none")
routine @ExclusiveAccess.unlock() -> None
    flow: @AccessFlow = current_flow()
    note_released(flow, access: me)
    me.holder.poke_atomic(0)
    previous: U32 = me.state.atomic_swap_release(0)
    if previous == 2
        wake_one(me.state)
        return
    return

### Takes the access if it is free, without waiting.
### :returns: True when it took the access.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it.
@track_caller
routine @ExclusiveAccess.try_lock() -> Bool
    return me.try_take(place: caller_location())

### As {ExclusiveAccess.try_lock}, giving `place` as where it is taken.
### :param place: Where the access is taken.
### :returns: True when it took the access.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it.
routine @ExclusiveAccess.try_lock_at(place: @SourceLocation) -> Bool
    return me.try_take(place)

### How many times a flow had to wait for the access.
### :returns: The count.
routine @ExclusiveAccess.wait_count() -> U64
    return me.waits.peek_atomic()

### How long flows waited for the access in all.
### :returns: The total.
routine @ExclusiveAccess.waited() -> Duration
    nanos: U64 = me.waited.peek_atomic()
    return Duration.from_nanoseconds(nanos.to_clamp[S64]())

### Takes the access, waiting until `deadline` at most.
### :param place: Where it is taken.
### :param deadline: When to give up, in `Clock.monotonic()` time, `Duration.MAX` for never.
### :param hooked: Whether the flow waits the way another language's runtime asked.
### :returns: True when it took the access.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it.
@target(os: not "none")
secret routine @ExclusiveAccess.take(place: @SourceLocation, deadline: Duration, hooked: Bool) -> Bool
    local flow: @AccessFlow = current_flow()
    local id: U64 = flow_id(flow)

    if me.try_take(place)
        return true
    started: Duration = Clock.monotonic()
    # Marks the access contended. Whoever takes it from 0 this way holds it.
    while me.state.atomic_swap_acquire(2) != 0
        if deadline != Duration.MAX
            if Clock.monotonic() >= deadline
                note_wait(waits: me.waits, waited: me.waited, since: started)
                return false
        wait_once(flow,
            wait: AccessWait(access: me, holder: me.holder, word: me.state, expected: 2, hooked), deadline,
            place)
    then
        me.holder.poke_atomic(id)
        note_wait(waits: me.waits, waited: me.waited, since: started)
        note_taken(flow,
            taken: HeldAccess(access: me, kind: ACCESS_EXCLUSIVE, mode: ACCESS_WRITE, place: place.peek()))
        return true

### Takes the access if it is free, without waiting.
### :param place: Where it is taken.
### :returns: True when it took the access.
### :throws: Crashes with `ReenterDuringAccessError` when the calling flow already holds it.
secret routine @ExclusiveAccess.try_take(place: @SourceLocation) -> Bool
    local found: @U32 <- 0
    local flow: @AccessFlow = current_flow()
    local id: U64 = flow_id(flow)

    if me.state.atomic_compare_exchange_acquire_raw(expected: 0, new: 1, previous: found)
        me.holder.poke_atomic(id)
        note_taken(flow,
            taken: HeldAccess(access: me, kind: ACCESS_EXCLUSIVE, mode: ACCESS_WRITE, place: place.peek()))
        return true
    if me.holder.peek_atomic() == id
        crash_reenter(place)
    return false
