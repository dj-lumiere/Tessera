// Tessera stdlib: the stack allocator
//
// A MemoryManager for stacks, such as a fiber's: whole pages from the operating
// system, with one page below them that may not be touched. A stack grows
// down, so a stack that runs out reaches that page and the program stops
// there, instead of writing over whatever lies below.
//
// The pages are reserved, not committed up front, so a stack costs the memory
// it has touched and a great many can coexist: Linux and macOS commit a page
// when it is first touched (mmap, MAP_NORESERVE on Linux), and on Windows the
// top two pages are committed with a guard page below them, which Windows moves
// down as the stack grows into it, as for a thread's own stack (the fiber
// switch keeps the thread block's stack fields in step, see switch_stack).
//
// The MemoryManager interface frees without a size, so the size of the mapping is
// written at the start of the bottom page, which is opened again to read it
// when the stack is freed. It doesn't grow a stack past its size: realloc
// returns null, as an allocator out of memory does.

module Standard/Os

import Standard/Alloc

// -- pages, POSIX ------------------------------------------------------------------

/// Binds the C `mmap` function, which maps pages into the address space.
/// :param addr: Where to put the mapping, or null to let the system choose.
/// :param length: The number of bytes.
/// :param prot: The `PROT_*` access the pages allow.
/// :param flags: The `MAP_*` flags.
/// :param fd: The file to map, or -1 for anonymous memory.
/// :param offset: The offset into the file.
/// :returns: The mapping's start, or MAP_FAILED (-1) with `errno` set.
@external("c")
@symbol("mmap")
@target(os: ("linux", "macos"))
private routine c_mmap(addr: Addr, length: USize, prot: CInt, flags: CInt, fd: CInt,
    offset: SSize) -> Addr

/// MAP_PRIVATE | MAP_ANONYMOUS, whose second bit differs between Linux and the BSDs, and on Linux MAP_NORESERVE:
/// the pages are counted against memory only once touched.
/// :returns: The flags.
@target(os: "macos")
private routine map_private_anonymous() -> CInt
    return 0x1002

/// MAP_PRIVATE | MAP_ANONYMOUS, whose second bit differs between Linux and the BSDs, and on Linux MAP_NORESERVE:
/// the pages are counted against memory only once touched.
/// :returns: The flags.
@target(os: "linux")
private routine map_private_anonymous() -> CInt
    return 0x4022

/// `length` bytes of pages for a stack, the bottom one closed with the length written in it.
/// :param length: The number of bytes, a whole number of pages.
/// :param page: The page size in bytes.
/// :returns: The start of the mapping, or null when the pages can't be mapped.
@target(os: ("linux", "macos"))
private routine stack_map(length: USize, page: USize) -> Addr
    // PROT_READ | PROT_WRITE, no file
    local at: Addr = c_mmap(null, length, 3, map_private_anonymous(), -1, 0)

    if ptrtoint[Addr, SSize](at) == -1
        return null
    else
        length.poke_into(at.to[@USize]())
        pages_protect(at, size: page, access: PageAccess.NONE)
        return at

// -- pages, Windows ----------------------------------------------------------------

/// Binds the Win32 `VirtualAlloc` function, which reserves or commits pages.
/// :param addr: Where to put the pages, or null to let the system choose.
/// :param size: The number of bytes.
/// :param type: The `MEM_*` allocation type, such as `MEM_RESERVE` or `MEM_COMMIT`.
/// :param protect: The `PAGE_*` protection.
/// :returns: The start of the pages, or null with the last error set.
@external("c")
@symbol("VirtualAlloc")
@callconv("stdcall")
@target(os: "windows")
private routine c_virtual_alloc(addr: Addr, size: USize, type: U32, protect: U32) -> Addr

/// `length` bytes reserved for a stack: the bottom page committed and closed with the length written in it, the top
/// two committed, and below them a guard page Windows moves down as the stack grows into it. A stack of fewer than
/// three pages above the bottom one is committed whole.
/// :param length: The number of bytes, a whole number of pages.
/// :param page: The page size in bytes.
/// :returns: The start of the reservation, or null when the space can't be reserved.
@target(os: "windows")
private routine stack_map(length: USize, page: USize) -> Addr
    // MEM_RESERVE, PAGE_NOACCESS
    local at: Addr = c_virtual_alloc(null, length, 0x2000, 1)

    if at.is_null()
        return null
    else
        // MEM_COMMIT, PAGE_READWRITE
        c_virtual_alloc(at, page, 0x1000, 4)
        length.poke_into(at.to[@USize]())
        pages_protect(at, size: page, access: PageAccess.NONE)
        pages: USize = length / page - 1
        if pages < 3
            // Too small to grow: all of it committed.
            c_virtual_alloc(at.offset(page.to[SSize]()), pages * page, 0x1000, 4)
            return at
        else
            // PAGE_READWRITE | PAGE_GUARD for the page below the top two
            two: USize = page * 2
            c_virtual_alloc(at.offset((length - two).to[SSize]()), two, 0x1000, 4)
            guard_offset: USize = length - two - page
            c_virtual_alloc(at.offset(guard_offset.to[SSize]()), page, 0x1000, 0x104)
            return at

// -- the allocator -----------------------------------------------------------------

/// The hosted stack allocator, ready before `start` runs: whole pages, with a guard page below each stack. Each
/// thread's FIBERS takes its fibers' stacks from it.
@target(os: not "none")
global DEFAULT_STACKS: @MemoryManager <- (alloc_fn: stack_alloc_fn.to[Callable](), realloc_fn: stack_realloc_fn.to[Callable](), free_fn: stack_free_fn.to[Callable](), reserve_fn: os_reserve_fn.to[Callable](), commit_fn: os_commit_fn.to[Callable](), release_fn: os_release_fn.to[Callable](), protect_fn: os_protect_fn.to[Callable](), state: null)

/// The stack allocator's alloc function: rounds `size` up to whole pages and adds the guard page below them.
/// :param state: Unused, the stack allocator has no state.
/// :param size: The stack size wanted, in bytes.
/// :param align: The alignment asked for: a page start is aligned for anything up to a page.
/// :returns: The lowest usable address of the stack (just above the guard page), null when the pages can't be
/// reserved.
/// :throws: Crashes with `IntegerOverflowError` when `size` rounded up to pages, plus the guard page, doesn't fit in
///     USize.
@target(os: not "none")
private routine stack_alloc_fn(state: Addr, size: USize, align: USize) -> Addr
    local page: USize = page_size()
    local padded_size: USize = size + page - 1
    local pages: USize = padded_size / page
    local length: USize = (pages + 1) * page
    local base: Addr = stack_map(length, page)

    if base.is_null()
        return null
    else
        stack: Addr = base.offset(page.to[SSize]())
        return stack

/// The stack allocator's realloc function: a stack doesn't grow past its size, so this always fails.
/// :param state: Unused.
/// :param old_ptr: The stack.
/// :param size: The size asked for.
/// :param align: The alignment the stack has.
/// :returns: Always null.
@target(os: not "none")
private routine stack_realloc_fn(state: Addr, old_ptr: Addr, size: USize, align: USize) -> Addr
    return null

/// The stack allocator's free function: reopens the bottom page to read the length written in it, then releases the
/// whole mapping.
/// :param state: Unused, the stack allocator has no state.
/// :param ptr: A stack from {make_stack_memory}.
@target(os: not "none")
private routine stack_free_fn(state: Addr, ptr: Addr) -> Void
    page: USize = page_size()
    base: Addr = ptr.offset(-page.to[SSize]())
    pages_protect(at: base, size: page, access: PageAccess.READ_WRITE)
    length: USize = base.to[@USize]().peek()
    pages_release(at: base, size: length)
    return

/// A MemoryManager for stacks: whole pages, with a guard page below that stops the program when a stack overflows. Its
/// page routines are the operating system's.
/// :returns: The allocator, which holds no state and needs nothing to free.
@target(os: not "none")
routine make_stack_memory() -> MemoryManager
    alloc: MemoryManager = MemoryManager(alloc_fn: stack_alloc_fn.to[Callable](), realloc_fn: stack_realloc_fn.to[Callable](), free_fn: stack_free_fn.to[Callable](), reserve_fn: os_reserve_fn.to[Callable](), commit_fn: os_commit_fn.to[Callable](), release_fn: os_release_fn.to[Callable](), protect_fn: os_protect_fn.to[Callable](), state: null)
    return alloc
