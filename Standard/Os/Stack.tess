// Tessera stdlib: the stack allocator
//
// An Allocator for stacks, such as a fiber's: whole pages from the operating
// system, with one page below them that may not be touched. A stack grows
// down, so a stack that runs out reaches that page and the program stops
// there, instead of writing over whatever lies below.
//
// The pages are reserved, not committed up front, so a stack costs the memory
// it has touched and a great many can coexist: Linux and macOS commit a page
// when it is first touched (mmap, MAP_NORESERVE on Linux), and on Windows the
// top two pages are committed with a guard page below them, which Windows moves
// down as the stack grows into it, as for a thread's own stack (the fiber
// switch keeps the thread block's stack fields in step, see switch_stack).
//
// The Allocator interface frees without a size, so the size of the mapping is
// written at the start of the bottom page, which is opened again to read it
// when the stack is freed. It doesn't grow a stack past its size: realloc
// returns null, as an allocator out of memory does.

module Standard::Os

import Standard::Alloc

// -- pages, POSIX ------------------------------------------------------------------

/// Binds the C `getpagesize` function.
/// :returns: The memory page size in bytes.
#[external("c"), symbol("getpagesize"), target(os: ("linux", "macos"))]
private routine c_getpagesize() -> CInt

/// Binds the C `mmap` function, which maps pages into the address space.
/// :param addr: Where to put the mapping, or null to let the system choose.
/// :param length: The number of bytes.
/// :param prot: The `PROT_*` access the pages allow.
/// :param flags: The `MAP_*` flags.
/// :param fd: The file to map, or -1 for anonymous memory.
/// :param offset: The offset into the file.
/// :returns: The mapping's start, or MAP_FAILED (-1) with `errno` set.
#[external("c"), symbol("mmap"), target(os: ("linux", "macos"))]
private routine c_mmap(addr: Addr, length: USize, prot: CInt, flags: CInt, fd: CInt,
    offset: SSize) -> Addr

/// Binds the C `mprotect` function, which changes the access pages allow.
/// :param addr: The start of the pages, page aligned.
/// :param length: The number of bytes.
/// :param prot: The `PROT_*` access the pages allow.
/// :returns: 0 on success, or -1 with `errno` set.
#[external("c"), symbol("mprotect"), target(os: ("linux", "macos"))]
private routine c_mprotect(addr: Addr, length: USize, prot: CInt) -> CInt

/// Binds the C `munmap` function, which removes a mapping.
/// :param addr: The start of the pages, page aligned.
/// :param length: The number of bytes.
/// :returns: 0 on success, or -1 with `errno` set.
#[external("c"), symbol("munmap"), target(os: ("linux", "macos"))]
private routine c_munmap(addr: Addr, length: USize) -> CInt

/// MAP_PRIVATE | MAP_ANONYMOUS, whose second bit differs between Linux and the BSDs, and on Linux MAP_NORESERVE:
/// the pages are counted against memory only once touched.
/// :returns: The flags.
#target(os: "macos")
private routine map_private_anonymous() -> CInt
    block entry()
        return(0x1002)

/// MAP_PRIVATE | MAP_ANONYMOUS, whose second bit differs between Linux and the BSDs, and on Linux MAP_NORESERVE:
/// the pages are counted against memory only once touched.
/// :returns: The flags.
#target(os: "linux")
private routine map_private_anonymous() -> CInt
    block entry()
        return(0x4022)

/// The memory page size from the C library's getpagesize.
/// :returns: The page size in bytes.
#target(os: ("linux", "macos"))
private routine page_size() -> USize
    block entry()
        size : USize = c_getpagesize().to<USize>()
        return(size)

/// `length` bytes of pages for a stack, the bottom one closed with the length written in it.
/// :param length: The number of bytes, a whole number of pages.
/// :param page: The page size in bytes.
/// :returns: The start of the mapping, or null when the pages can't be mapped.
#target(os: ("linux", "macos"))
private routine stack_map(length: USize, page: USize) -> Addr
    // PROT_READ | PROT_WRITE, no file
    shared at : Addr = c_mmap(null, length, 3, map_private_anonymous(), -1, 0)

    block entry()
        failed : Bool = ptrtoint<Addr, SSize>(at).eq(-1)
        branch failed
            ? return(null)
            : close()

    block close()
        length.store_into(at.to<@USize>())
        pages_protect(at, page, false)
        return(at)

/// Makes `length` bytes of pages at `at` readable and writable (`open`) or inaccessible. The result is not checked.
/// :param at: The start of the pages, page aligned.
/// :param length: The number of bytes, a whole number of pages.
/// :param open: `true` to allow access, `false` to close the pages.
#target(os: ("linux", "macos"))
private routine pages_protect(at: Addr, length: USize, open: Bool) -> Void
    block entry()
        prot : CInt = open.to<CInt>().mul(3)
        c_mprotect(at, length, prot)
        return()

/// Returns pages to the operating system. On Windows the whole reservation at `at` is freed whatever `length` says.
/// :param at: The start of the reservation.
/// :param length: The number of bytes it covers.
#target(os: ("linux", "macos"))
private routine pages_release(at: Addr, length: USize) -> Void
    block entry()
        c_munmap(at, length)
        return()

// -- pages, Windows ----------------------------------------------------------------

/// Binds the Win32 `VirtualAlloc` function, which reserves or commits pages.
/// :param addr: Where to put the pages, or null to let the system choose.
/// :param size: The number of bytes.
/// :param type: The `MEM_*` allocation type, such as `MEM_RESERVE` or `MEM_COMMIT`.
/// :param protect: The `PAGE_*` protection.
/// :returns: The start of the pages, or null with the last error set.
#[external("c"), symbol("VirtualAlloc"), callconv("stdcall"), target(os: "windows")]
private routine c_virtual_alloc(addr: Addr, size: USize, type: U32, protect: U32) -> Addr

/// Binds the Win32 `VirtualProtect` function, which changes the protection of committed pages.
/// :param addr: The start of the pages.
/// :param size: The number of bytes.
/// :param protect: The new `PAGE_*` protection.
/// :param old: Where the previous protection goes.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("VirtualProtect"), callconv("stdcall"), target(os: "windows")]
private routine c_virtual_protect(addr: Addr, size: USize, protect: U32, old: @U32) -> CInt

/// Binds the Win32 `VirtualFree` function, which decommits or releases pages.
/// :param addr: The start of the pages (the reservation's start for `MEM_RELEASE`).
/// :param size: The number of bytes (0 for `MEM_RELEASE`).
/// :param type: The `MEM_*` free type, such as `MEM_RELEASE`.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("VirtualFree"), callconv("stdcall"), target(os: "windows")]
private routine c_virtual_free(addr: Addr, size: USize, type: U32) -> CInt

/// Windows' pages are 4 KiB on every architecture it runs on.
/// :returns: 4096.
#target(os: "windows")
private routine page_size() -> USize
    block entry()
        return(4096)

/// `length` bytes reserved for a stack: the bottom page committed and closed with the length written in it, the top
/// two committed, and below them a guard page Windows moves down as the stack grows into it. A stack of fewer than
/// three pages above the bottom one is committed whole.
/// :param length: The number of bytes, a whole number of pages.
/// :param page: The page size in bytes.
/// :returns: The start of the reservation, or null when the space can't be reserved.
#target(os: "windows")
private routine stack_map(length: USize, page: USize) -> Addr
    // MEM_RESERVE, PAGE_NOACCESS
    shared at : Addr = c_virtual_alloc(null, length, 0x2000, 1)

    block entry()
        failed : Bool = at.is_null()
        branch failed
            ? return(null)
            : bottom()

    // MEM_COMMIT, PAGE_READWRITE
    block bottom()
        c_virtual_alloc(at, page, 0x1000, 4)
        length.store_into(at.to<@USize>())
        pages_protect(at, page, false)
        pages : USize = length.div(page).sub(1)
        small : Bool  = pages.lt(3)
        branch small
            ? whole(pages)
            : top()

    // Too small to grow: all of it committed.
    block whole(pages: USize)
        c_virtual_alloc(at.offset(page.to<SSize>()), pages.mul(page), 0x1000, 4)
        return(at)

    // PAGE_READWRITE | PAGE_GUARD for the page below the top two
    block top()
        two : USize = page.mul(2)
        c_virtual_alloc(at.offset(length.sub(two).to<SSize>()), two, 0x1000, 4)
        guard_offset : USize = length.sub(two).sub(page)
        c_virtual_alloc(at.offset(guard_offset.to<SSize>()), page, 0x1000, 0x104)
        return(at)

/// Makes `length` bytes of pages at `at` readable and writable (`open`) or inaccessible. The result is not checked.
/// :param at: The start of the pages, page aligned.
/// :param length: The number of bytes, a whole number of pages.
/// :param open: `true` to allow access, `false` to close the pages.
#target(os: "windows")
private routine pages_protect(at: Addr, length: USize, open: Bool) -> Void
    block entry()
        // PAGE_READWRITE, or PAGE_NOACCESS
        open_flag : U32 = open.to<U32>()
        protect   : U32 = open_flag.mul(3).add(1)
        claim old : @U32 <- 0
        c_virtual_protect(at, length, protect, old)
        return()

/// Returns pages to the operating system. On Windows the whole reservation at `at` is freed whatever `length` says.
/// :param at: The start of the reservation.
/// :param length: The number of bytes it covers.
#target(os: "windows")
private routine pages_release(at: Addr, length: USize) -> Void
    block entry()
        // MEM_RELEASE frees the whole reservation, whatever its size
        c_virtual_free(at, 0, 0x8000)
        return()

// -- the allocator -----------------------------------------------------------------

/// The stack allocator's alloc function: rounds `size` up to whole pages and adds the guard page below them.
/// :param state: Unused, the stack allocator has no state.
/// :param size: The stack size wanted, in bytes.
/// :returns: The lowest usable address of the stack (just above the guard page), null when the pages can't be
/// reserved.
/// :throws: Crashes with `IntegerOverflowError` when `size` rounded up to pages, plus the guard page, doesn't fit in
///     USize.
#target(os: not "none")
private routine stack_alloc_fn(state: Addr, size: USize) -> Addr
    shared page        : USize = page_size()
    shared padded_size : USize = size.add(page).sub(1)
    shared pages       : USize = padded_size.div(page)
    shared length      : USize = pages.add(1).mul(page)
    shared base        : Addr  = stack_map(length, page)

    block entry()
        failed : Bool = base.is_null()
        branch failed
            ? return(null)
            : done()

    block done()
        stack : Addr = base.offset(page.to<SSize>())
        return(stack)

/// The stack allocator's realloc function: a stack doesn't grow past its size, so this always fails.
/// :param state: Unused.
/// :param old_ptr: The stack.
/// :param size: The size asked for.
/// :returns: Always null.
#target(os: not "none")
private routine stack_realloc_fn(state: Addr, old_ptr: Addr, size: USize) -> Addr
    block entry()
        return(null)

/// The stack allocator's free function: reopens the bottom page to read the length written in it, then releases the
/// whole mapping.
/// :param state: Unused, the stack allocator has no state.
/// :param ptr: A stack from {make_stack_allocator}.
#target(os: not "none")
private routine stack_free_fn(state: Addr, ptr: Addr) -> Void
    block entry()
        page : USize = page_size()
        base : Addr  = ptr.offset(page.to<SSize>().neg())
        pages_protect(base, page, true)
        length : USize = base.to<@USize>().load()
        pages_release(base, length)
        return()

/// An Allocator for stacks: whole pages, with a guard page below that stops the program when a stack overflows.
/// :returns: The allocator, which holds no state and needs nothing to free.
#target(os: not "none")
routine make_stack_allocator() -> Allocator
    block entry()
        alloc : Allocator = Allocator { alloc_fn: stack_alloc_fn.to<Callable>(),
            realloc_fn: stack_realloc_fn.to<Callable>(), free_fn: stack_free_fn.to<Callable>(),
            state: null }
        return(alloc)
