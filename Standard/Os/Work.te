# Tessera stdlib: the work a ticket runs
#
# A ticket is one flow of execution that a manager hands out: a thread from a ThreadManager (`Thread[T]`) or a fiber
# from a FiberManager (`Fiber[T]`). It runs one piece of work at a time, and the flow is the same for both, written
# out from top to bottom:
#
#     t: Thread[S64] = get_thread[S64]()
#     t.put_work(entry: count_primes.to[Callable](), args: (table, 1000))   # runs from here on
#     # ... other work, then check_finished() to look, or wait_finished() to wait
#     t.wait_finished()
#     primes: S64 = t.retrieve()
#     t.give_back()
#
# This file holds what the two share: the WorkSlot a ticket's work lives in (its state, the block that holds the
# routine, its arguments and the room for its result, a cancel request, and a fiber waiting for it), the blocks for
# each number of arguments, and `cancel_requested()`, which the work itself asks.

module Standard/Os

### The slot of the work running on this thread (a thread worker's, or the fiber's that runs), or null.
@threadlocal
@target(os: not "none")
global RUNNING_WORK: @@WorkSlot

### Released before a thread worker takes the next ticket's work: what that work left in this thread's `@threadlocal`
### globals and still owns (the thread's FiberManager), or null. Whatever makes such a value sets it.
@threadlocal
@target(os: not "none")
global THREAD_CLEANUP: @Callable[(), None]

### A ticket with no work yet: the next may go on.
preset TICKET_EMPTY: U32 = 0
### A ticket whose work runs.
preset TICKET_RUNNING: U32 = 1
### A ticket whose work has finished: its result waits for `retrieve`, and the next work may go on.
preset TICKET_DONE: U32 = 2
### A ticket given back to its manager.
preset TICKET_IDLE: U32 = 3
### A thread worker its manager told to end.
preset TICKET_QUIT: U32 = 4

### Where a ticket's work lives: a thread worker and a fiber each have one, and the ticket names it.
record WorkSlot
    ### `TICKET_EMPTY`, `TICKET_RUNNING`, `TICKET_DONE`, `TICKET_IDLE` or `TICKET_QUIT`. A thread waits on it.
    state: U32
    ### Runs the work in `work`: calls its routine with its arguments and stores the result in front.
    runner: Callable[(Addr,), None]
    ### The block of the work, from `manager`, or null.
    work: Addr
    ### The memory manager the work's blocks come from: the thread or fiber manager's.
    manager: @MemoryManager
    ### 1 once `cancel()` asked the work to stop.
    cancel: U32
    ### Guards `waiter`.
    lock: ExclusiveAccess
    ### Whoever waits for the work to finish, or a hollow Waiter.
    waiter: Waiter
    ### The work's own waiter while it is in a cancellable wait, which `cancel()` wakes, or a hollow Waiter.
    blocked: Waiter
    ### The number of the ticket that holds the slot. `give_back` changes it, so an old ticket no longer matches.
    issued: U64

### What `retrieve` and a cancellable wait throw for work that was asked to stop with `cancel()` before it finished.
crashable CancelRequested
    nothing

### Writes `The work was asked to stop with cancel().`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine CancelRequested.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("The work was asked to stop with cancel() before it finished.")
    return

### Makes a `WorkSlot` from its fields.
### :param state: Its `state`.
### :param runner: Its `runner`.
### :param work: Its `work`.
### :param manager: Its `manager`.
### :param cancel: Its `cancel`.
### :param lock: Its `lock`.
### :param waiter: Its `waiter`.
### :param blocked: Its `blocked`.
### :param issued: Its `issued`.
### :returns: The new value.
common routine WorkSlot.construct(state: U32, runner: Callable[(Addr,), None], work: Addr,
    manager: @MemoryManager, cancel: U32, lock: ExclusiveAccess, waiter: Waiter, blocked: Waiter,
    issued: U64) -> Me
    return Me(state, runner, work, manager, cancel, lock, waiter, blocked, issued)

### An empty slot whose work blocks come from `manager`.
### :param manager: Where the work's blocks come from.
### :returns: The slot.
common routine WorkSlot.construct(manager: @MemoryManager) -> Me
    return Me(state: TICKET_EMPTY, runner: no_work.to[Callable](), work: .hollow(), manager,
        cancel: 0, lock: .construct(), waiter: .hollow(), blocked: .hollow(), issued: 0)

### Gives back the block of the last work.
routine @WorkSlot.destruct() -> None
    me.free_work()
    return

### The work of a slot that has none.
### :param work: Ignored.
secret routine no_work(work: Addr) -> None
    return

### Whether the running work was asked to stop with `cancel()`. The work looks at it where stopping is safe, cleans up
### what it holds, and returns. False outside a ticket's work.
### :returns: True once its ticket was cancelled.
@target(os: not "none")
routine cancel_requested() -> Bool
    slot: @WorkSlot = RUNNING_WORK.peek()
    if slot.is_hollow()
        return false
    return slot.cancel.peek_atomic() == 1

### Crashes unless the ticket numbered `issued` still holds the slot.
### :param issued: The ticket's number.
### :throws: Crashes with `TicketGivenBackError` for a ticket that was given back.
@track_caller
routine @WorkSlot.check_ticket(issued: U64) -> None
    if me.issued.peek() == issued
        return
    crash(name: "TicketGivenBackError",
        message: "This ticket was given back: get another one for more work.")

### Crashes when work runs: a ticket runs one piece of work at a time.
### :throws: Crashes with `TicketBusyError` while the work runs.
@track_caller
routine @WorkSlot.check_free() -> None
    if me.state.peek_atomic() == TICKET_RUNNING
        crash(name: "TicketBusyError",
            message: "This ticket's work hasn't finished: a ticket runs one piece of work at a time, so wait_finished() first.")
    return

### Starts the work in `work`, run by `runner`, in place of the last one, whose block goes back.
### :param runner: Runs the work.
### :param work: Its block, from the slot's memory manager.
### :throws: Crashes with `TicketBusyError` while the last work runs.
@track_caller
routine @WorkSlot.put(runner: Callable[(Addr,), None], work: Addr) -> None
    me.check_free()
    me.free_work()
    me.runner.poke(runner)
    me.work.poke(work)
    me.cancel.poke_atomic(0)
    me.blocked.poke(.hollow())
    me.state.poke_atomic(TICKET_RUNNING)
    wake_all(me.state)
    return

### Gives the block of the last work back, if there is one.
routine @WorkSlot.free_work() -> None
    work: Addr = me.work.peek()
    if work.is_hollow()
        return
    deallocate(data: work.to[@Byte](), manager: me.manager.peek())
    me.work.poke(.hollow())
    return

### Whether no work runs: it finished, or there was none.
### :returns: True unless the work runs.
routine @WorkSlot.is_finished() -> Bool
    return me.state.peek_atomic() != TICKET_RUNNING

### Waits until the work has finished. A fiber parks and the thread goes on with its manager's other fibers. A thread
### sleeps.
@target(os: not "none")
routine @WorkSlot.wait() -> None
    me.wait_until(deadline: Duration.MAX, cancellable: false)
    return

### Waits until the work has finished, `deadline` (in `Clock.monotonic()` time, `Duration.MAX` for none) has passed, or, when
### `cancellable`, the work that waits was asked to stop with `cancel()`, whichever comes first.
### :param deadline: When to stop waiting.
### :param cancellable: True to stop waiting when the waiting work is cancelled.
### :returns: True when the work has finished.
@target(os: not "none")
routine @WorkSlot.wait_until(deadline: Duration, cancellable: Bool) -> Bool
    local waiter: Waiter = current_waiter()

    # The waiter goes in under the lock, which `complete` takes after it marks the work done: either this sees it
    # done, or `complete` sees the waiter. One left behind when the wait ends otherwise only wakes it once more later,
    # which a park allows.
    loop
        me.lock.lock()
        if me.is_finished()
            break
        me.waiter.poke(waiter)
        me.lock.unlock()
        if Clock.monotonic() >= deadline
            return false
        if cancellable
            if blocked_until_cancelled(waiter)
                return false
        waiter.park_until(deadline)
        continue
    me.lock.unlock()
    return true

### Whether the running work was asked to stop, after making `waiter` the one `cancel()` wakes while it waits.
### :param waiter: The waiter of the running work.
### :returns: True when it was asked to stop: the wait ends.
@target(os: not "none")
@noinline
routine blocked_until_cancelled(waiter: Waiter) -> Bool
    slot: @WorkSlot = RUNNING_WORK.peek()
    if slot.is_hollow()
        return false
    slot.lock.lock()
    slot.blocked.poke(waiter)
    slot.lock.unlock()
    return slot.is_cancelled()

### Makes `waiter` the one woken when the work finishes, unless it has: for a wait on several tickets at once.
### :param waiter: The waiter.
### :returns: True when the work has finished already (`waiter` isn't kept).
@target(os: not "none")
routine @WorkSlot.register(waiter: Waiter) -> Bool
    me.lock.lock()
    if me.is_finished()
        me.lock.unlock()
        return true
    me.waiter.poke(waiter)
    me.lock.unlock()
    return false

### Forgets `waiter` if it is the one woken when the work finishes: a wait on several tickets that is over.
### :param waiter: The waiter.
@target(os: not "none")
routine @WorkSlot.unregister(waiter: Waiter) -> None
    me.lock.lock()
    if me.waiter.peek() == waiter
        me.waiter.poke(.hollow())
    me.lock.unlock()
    return

### Marks the work finished and wakes whoever waits for it: the thread that runs it calls this once the routine
### returns.
@target(os: not "none")
routine @WorkSlot.complete() -> None
    me.state.poke_atomic(TICKET_DONE)
    wake_all(me.state)
    me.lock.lock()
    waiter: Waiter = me.waiter.peek()
    me.waiter.poke(.hollow())
    me.lock.unlock()
    waiter.wake()
    return

### The place of the finished work's result, the front of its block.
### :typeparam T: The result type.
### :returns: The place.
### :throws: Crashes with `TicketBusyError` while the work runs, and with `NoWorkError` when no work was put on the
###     ticket.
@track_caller
routine @WorkSlot.result_place[T]() -> @T
needs T: typename
    state: U32 = me.state.peek_atomic()
    if not (state == TICKET_DONE)
        if state == TICKET_RUNNING
            crash(name: "TicketBusyError",
                message: "This ticket's work hasn't finished: wait_finished() before retrieve().")
        crash(name: "NoWorkError",
            message: "This ticket has no work to retrieve: put_work() comes first.")
    return me.work.peek().to[@T]()

### Whether `cancel()` asked the work to stop.
### :returns: True once it did.
routine @WorkSlot.is_cancelled() -> Bool
    return me.cancel.peek_atomic() == 1

### Asks the work to stop: `cancel_requested()` turns true inside it, and a cancellable wait it is in (a
### `wait_finished_cancellable`, a channel's transmit or receive) ends.
@target(os: not "none")
routine @WorkSlot.request_cancel() -> None
    me.cancel.poke_atomic(1)
    me.lock.lock()
    blocked: Waiter = me.blocked.peek()
    me.lock.unlock()
    blocked.wake()
    return

### Ends the ticket that holds the slot: gives the last work's block back and gives the slot a new number.
### :throws: Crashes with `TicketBusyError` while the work runs.
@track_caller
routine @WorkSlot.give_back() -> None
    if me.state.peek_atomic() == TICKET_RUNNING
        crash(name: "TicketBusyError",
            message: "This ticket's work hasn't finished: wait_finished() before give_back(), so nothing it still uses goes away.")
    me.free_work()
    me.issued.poke(me.issued.peek() + 1)
    me.state.poke_atomic(TICKET_IDLE)
    return

# -- the blocks of work, by number of arguments -----------------------------------------------------------------

### The work a ticket runs: a routine of 0 argument(s), its result first.
secret record Work0[T]
needs T: typename
    result: T
    entry: Callable[(), T]

### The work a ticket runs: a routine of 1 argument(s), its result first.
secret record Work1[T, A]
needs T: typename, A: typename
    result: T
    entry: Callable[(A,), T]
    first: A

### The work a ticket runs: a routine of 2 argument(s), its result first.
secret record Work2[T, A, B]
needs T: typename, A: typename, B: typename
    result: T
    entry: Callable[(A, B), T]
    first: A
    second: B

### The work a ticket runs: a routine of 3 argument(s), its result first.
secret record Work3[T, A, B, C]
needs T: typename, A: typename, B: typename, C: typename
    result: T
    entry: Callable[(A, B, C), T]
    first: A
    second: B
    third: C

### The work a ticket runs: a routine of 4 argument(s), its result first.
secret record Work4[T, A, B, C, D]
needs T: typename, A: typename, B: typename, C: typename, D: typename
    result: T
    entry: Callable[(A, B, C, D), T]
    first: A
    second: B
    third: C
    fourth: D

### The work a ticket runs: a routine of 0 argument(s), no result.
secret record VoidWork0
    entry: Callable[(), None]

### The work a ticket runs: a routine of 1 argument(s), no result.
secret record VoidWork1[A]
needs A: typename
    entry: Callable[(A,), None]
    first: A

### The work a ticket runs: a routine of 2 argument(s), no result.
secret record VoidWork2[A, B]
needs A: typename, B: typename
    entry: Callable[(A, B), None]
    first: A
    second: B

### The work a ticket runs: a routine of 3 argument(s), no result.
secret record VoidWork3[A, B, C]
needs A: typename, B: typename, C: typename
    entry: Callable[(A, B, C), None]
    first: A
    second: B
    third: C

### The work a ticket runs: a routine of 4 argument(s), no result.
secret record VoidWork4[A, B, C, D]
needs A: typename, B: typename, C: typename, D: typename
    entry: Callable[(A, B, C, D), None]
    first: A
    second: B
    third: C
    fourth: D

### Makes a `Work0` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :returns: The new value.
common routine Work0[T].construct(result: T, entry: Callable[(), T]) -> Me
needs T: typename
    return Me(result, entry)

### Releases nothing: a `Work0` holds the work's arguments, which its routine owns once it runs.
routine @Work0[T].destruct() -> None
needs T: typename
    return

### Runs the work in the block at `raw`, a `Work0`, and stores its result there.
### :param raw: The block.
secret routine run_work0[T](raw: Addr) -> None
needs T: typename
    work: @Work0[T] = raw.to[@Work0[T]]()
    entry: Callable[(), T] = work.entry.peek()
    value: T = entry.call()
    work.result.poke(value)
    return

### The block for `entry` and its arguments, from `manager`, and its runner: what a ticket's `put_work` hands over.
### :param entry: The routine.
### :param manager: Where the block comes from.
### :returns: The runner and the block.
### :throws: Crashes with `MemoryAllocationError` when `manager` can't give the block.
@track_caller
routine make_work0[T](entry: Callable[(), T],
    manager: @MemoryManager) -> (Callable[(Addr,), None], Addr)
needs T: typename
    work: @Work0[T] = allocate[Work0[T]](count: 1, manager)
    if work.is_hollow()
        crash_allocation()
    work.entry.poke(entry)
    runner: Callable[(Addr,), None] = run_work0[T].to[Callable]()
    place: Addr = work
    return (runner, place)

### Makes a `Work1` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :returns: The new value.
common routine Work1[T, A].construct(result: T, entry: Callable[(A,), T], first: A) -> Me
needs T: typename, A: typename
    return Me(result, entry, first)

### Releases nothing: a `Work1` holds the work's arguments, which its routine owns once it runs.
routine @Work1[T, A].destruct() -> None
needs T: typename, A: typename
    return

### Runs the work in the block at `raw`, a `Work1`, and stores its result there.
### :param raw: The block.
secret routine run_work1[T, A](raw: Addr) -> None
needs T: typename, A: typename
    work: @Work1[T, A] = raw.to[@Work1[T, A]]()
    entry: Callable[(A,), T] = work.entry.peek()
    value: T = entry.call(work.first.peek())
    work.result.poke(value)
    return

### The block for `entry` and its arguments, from `manager`, and its runner: what a ticket's `put_work` hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner and the block.
### :throws: Crashes with `MemoryAllocationError` when `manager` can't give the block.
@track_caller
routine make_work1[T, A](entry: Callable[(A,), T], args: A,
    manager: @MemoryManager) -> (Callable[(Addr,), None], Addr)
needs T: typename, A: typename
    work: @Work1[T, A] = allocate[Work1[T, A]](count: 1, manager)
    if work.is_hollow()
        crash_allocation()
    work.entry.poke(entry)
    work.first.poke(args)
    runner: Callable[(Addr,), None] = run_work1[T, A].to[Callable]()
    place: Addr = work
    return (runner, place)

### Makes a `Work2` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :param second: Its `second`.
### :returns: The new value.
common routine Work2[T, A, B].construct(result: T, entry: Callable[(A, B), T], first: A,
    second: B) -> Me
needs T: typename, A: typename, B: typename
    return Me(result, entry, first, second)

### Releases nothing: a `Work2` holds the work's arguments, which its routine owns once it runs.
routine @Work2[T, A, B].destruct() -> None
needs T: typename, A: typename, B: typename
    return

### Runs the work in the block at `raw`, a `Work2`, and stores its result there.
### :param raw: The block.
secret routine run_work2[T, A, B](raw: Addr) -> None
needs T: typename, A: typename, B: typename
    work: @Work2[T, A, B] = raw.to[@Work2[T, A, B]]()
    entry: Callable[(A, B), T] = work.entry.peek()
    value: T = entry.call(work.first.peek(), work.second.peek())
    work.result.poke(value)
    return

### The block for `entry` and its arguments, from `manager`, and its runner: what a ticket's `put_work` hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner and the block.
### :throws: Crashes with `MemoryAllocationError` when `manager` can't give the block.
@track_caller
routine make_work2[T, A, B](entry: Callable[(A, B), T], args: (A, B),
    manager: @MemoryManager) -> (Callable[(Addr,), None], Addr)
needs T: typename, A: typename, B: typename
    work: @Work2[T, A, B] = allocate[Work2[T, A, B]](count: 1, manager)
    if work.is_hollow()
        crash_allocation()
    work.entry.poke(entry)
    work.first.poke(args.item0)
    work.second.poke(args.item1)
    runner: Callable[(Addr,), None] = run_work2[T, A, B].to[Callable]()
    place: Addr = work
    return (runner, place)

### Makes a `Work3` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :param second: Its `second`.
### :param third: Its `third`.
### :returns: The new value.
common routine Work3[T, A, B, C].construct(result: T, entry: Callable[(A, B, C), T], first: A,
    second: B, third: C) -> Me
needs T: typename, A: typename, B: typename, C: typename
    return Me(result, entry, first, second, third)

### Releases nothing: a `Work3` holds the work's arguments, which its routine owns once it runs.
routine @Work3[T, A, B, C].destruct() -> None
needs T: typename, A: typename, B: typename, C: typename
    return

### Runs the work in the block at `raw`, a `Work3`, and stores its result there.
### :param raw: The block.
secret routine run_work3[T, A, B, C](raw: Addr) -> None
needs T: typename, A: typename, B: typename, C: typename
    work: @Work3[T, A, B, C] = raw.to[@Work3[T, A, B, C]]()
    entry: Callable[(A, B, C), T] = work.entry.peek()
    value: T = entry.call(work.first.peek(), work.second.peek(), work.third.peek())
    work.result.poke(value)
    return

### The block for `entry` and its arguments, from `manager`, and its runner: what a ticket's `put_work` hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner and the block.
### :throws: Crashes with `MemoryAllocationError` when `manager` can't give the block.
@track_caller
routine make_work3[T, A, B, C](entry: Callable[(A, B, C), T], args: (A, B, C),
    manager: @MemoryManager) -> (Callable[(Addr,), None], Addr)
needs T: typename, A: typename, B: typename, C: typename
    work: @Work3[T, A, B, C] = allocate[Work3[T, A, B, C]](count: 1, manager)
    if work.is_hollow()
        crash_allocation()
    work.entry.poke(entry)
    work.first.poke(args.item0)
    work.second.poke(args.item1)
    work.third.poke(args.item2)
    runner: Callable[(Addr,), None] = run_work3[T, A, B, C].to[Callable]()
    place: Addr = work
    return (runner, place)

### Makes a `Work4` from its fields.
### :param result: Its `result`.
### :param entry: Its `entry`.
### :param first: Its `first`.
### :param second: Its `second`.
### :param third: Its `third`.
### :param fourth: Its `fourth`.
### :returns: The new value.
common routine Work4[T, A, B, C, D].construct(result: T, entry: Callable[(A, B, C, D), T], first: A,
    second: B, third: C, fourth: D) -> Me
needs T: typename, A: typename, B: typename, C: typename, D: typename
    return Me(result, entry, first, second, third, fourth)

### Releases nothing: a `Work4` holds the work's arguments, which its routine owns once it runs.
routine @Work4[T, A, B, C, D].destruct() -> None
needs T: typename, A: typename, B: typename, C: typename, D: typename
    return

### Runs the work in the block at `raw`, a `Work4`, and stores its result there.
### :param raw: The block.
secret routine run_work4[T, A, B, C, D](raw: Addr) -> None
needs T: typename, A: typename, B: typename, C: typename, D: typename
    work: @Work4[T, A, B, C, D] = raw.to[@Work4[T, A, B, C, D]]()
    entry: Callable[(A, B, C, D), T] = work.entry.peek()
    value: T = entry.call(work.first.peek(), work.second.peek(), work.third.peek(),
        work.fourth.peek())
    work.result.poke(value)
    return

### The block for `entry` and its arguments, from `manager`, and its runner: what a ticket's `put_work` hands over.
### :param entry: The routine.
### :param args: Its arguments.
### :param manager: Where the block comes from.
### :returns: The runner and the block.
### :throws: Crashes with `MemoryAllocationError` when `manager` can't give the block.
@track_caller
routine make_work4[T, A, B, C, D](entry: Callable[(A, B, C, D), T], args: (A, B, C, D),
    manager: @MemoryManager) -> (Callable[(Addr,), None], Addr)
needs T: typename, A: typename, B: typename, C: typename, D: typename
    work: @Work4[T, A, B, C, D] = allocate[Work4[T, A, B, C, D]](count: 1, manager)
    if work.is_hollow()
        crash_allocation()
    work.entry.poke(entry)
    work.first.poke(args.item0)
    work.second.poke(args.item1)
    work.third.poke(args.item2)
    work.fourth.poke(args.item3)
    runner: Callable[(Addr,), None] = run_work4[T, A, B, C, D].to[Callable]()
    place: Addr = work
    return (runner, place)

### Runs the work in the block at `raw`, a `VoidWork0`.
### :param raw: The block.
secret routine run_voidwork0(raw: Addr) -> None
    work: @VoidWork0 = raw.to[@VoidWork0]()
    entry: Callable[(), None] = work.entry.peek()
