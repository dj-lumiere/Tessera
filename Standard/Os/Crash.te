# Tessera stdlib: the Crash service's hosted part
#
# Standard/System's Crash service reports a crash with the routine in its slot and then stops. With an operating
# system the default report is this one: the crash's name and message, the place on a second line, then the crash
# trace (Trace.te), most recent frame first, on standard error. Stopping exits with status 82.
#
#     tessera: IndexOutOfBoundsError: Index is out of bounds for the collection.
#       at examples/grid.te:12:9
#     Stack trace:
#       0: at fill (examples/grid.te:12:9)
#       1: at start (examples/grid.te:30:5)
#
# A trace deeper than the frames it keeps ends with "  ... (40 frames total)", and an untraced build prints no
# trace. A program reports differently by putting its own routine in the slot: Crash.report_with.

module Standard/Os

### The hosted default report of a crash: `tessera: <name>: <message>`, the source location on a second line, the
### crash trace, and for a failure where it was made, on standard error. The Crash service calls it when its slot
### holds no routine.
### :param name: The kind of failure, such as `IntegerOverflowError`.
### :param message: What happened.
### :param place: Where the crash happened: file, line, and column (0 when only the line is known), or hollow when
### it isn't known.
@export("tessera_crash_default_report")
routine default_crash_report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    text: @[Byte] = message.text()
    Console.alert("tessera: {name}", end: "")
    if not (text.count == 0)
        Console.alert(": {text}", end: "")
    if not place.is_hollow()
        # A report that knows no place (a deadlock between another language's agents) leaves it out.
        file: @[Byte] = place.file.peek()
        line: U32 = place.line.peek()
        Console.alert("\n  at {file}:{line}", end: "")
        column: U32 = place.column.peek()
        if not (column == 0)
            Console.alert(":{column}", end: "")
    Console.alert("")
    write_trace()
    failure: U32 = message.failure.peek()
    if failure == 0
        return
    write_failure_trace(seq: failure, out: Console.errors())
    Console.alert("")
    return

### Stops the program after a crash: exits with status 82.
@export("tessera_crash_exit")
@noreturn
routine crash_exit() -> None
    c_exit(82)

### Waits for good: another thread reports a crash, and stops the program when it is done.
@export("tessera_crash_wait")
@noreturn
routine crash_wait() -> None
    loop
        waitfor(1s)

### Writes the running thread's crash trace to standard error, most recent frame first, in RazorForge's shape: `Stack
### trace:`, then `  0: at <routine> (<file>:<line>:<column>)` per frame, and `  ... (<n> frames total)` when there were
### more than the trace keeps. Writes nothing when the trace is empty (an untraced build).
routine write_trace() -> None
    depth: U64 = trace_depth()
    shown: U64 = depth.min(TRACE_CAPACITY)

    if depth == 0
        return
    Console.alert("Stack trace:")

    each back in 0 til shown
        at: TraceFrame = trace_frame(back)
        name: @[Byte] = at.name.getview()
        file: @[Byte] = at.file.getview()
        line: U32 = at.line
        if line == 0
            # A frame that made no call yet (the fault came first) has no place within its routine.
            Console.alert("  {back}: at {name} ({file}", end: "")
        else
            Console.alert("  {back}: at {name} ({file}:{line}", end: "")
            column: U32 = at.column
            if not (column == 0)
                Console.alert(":{column}", end: "")
        Console.alert(")")
    total_depth: U64 = trace_depth()
    if not (total_depth > TRACE_CAPACITY)
        return
    Console.alert("  ... ({total_depth} frames total)")
    return
