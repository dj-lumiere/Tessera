# Tessera stdlib: running another program on Linux and macOS (see Process.te)
#
# Everything the child needs (the argument vector, the environment, the directory) is made in the parent before
# fork, so the child only calls what is safe between fork and exec: dup2, chdir, execvp, write, _exit. If the
# directory change or the exec fails, the child writes errno to a close-on-exec pipe. The parent reads that pipe to
# its end, which comes at the exec or the child's exit, and so knows whether the program started.

module Standard/Os

### C's `environ`, the process's environment as a null-terminated array of `NAME=VALUE` strings (Linux, while macOS goes
### through _NSGetEnviron).
@external("c")
@symbol("environ")
@target(os: "linux")
global ENVIRON: @@@Byte

### struct pollfd
@target(os: ("linux", "macos"))
secret record PollFd
    fd: CInt
    events: S16
    revents: S16

### Makes a `PollFd` from its fields.
### :param fd: Its `fd`.
### :param events: Its `events`.
### :param revents: Its `revents`.
### :returns: The new value.
@target(os: ("linux", "macos"))
secret common routine PollFd.construct(fd: CInt, events: S16, revents: S16) -> Me
    return Me(fd, events, revents)

### Releases nothing: a `PollFd` holds no memory of its own.
@target(os: ("linux", "macos"))
secret routine @PollFd.destruct() -> None
    return

### Binds the C `pipe` function, which makes a pipe.
### :param fds: Where the two descriptors go: the read end, then the write end.
### :returns: 0 on success, or -1 with `errno` set.
@external("c")
@symbol("pipe")
@target(os: ("linux", "macos"))
secret routine c_pipe(fds: @CInt) -> CInt

### Binds the C `fcntl` function (variadic), which changes or reads a descriptor's settings.
### :param fd: The descriptor.
### :param cmd: The command, such as `F_SETFD`, with any argument it takes passed after it.
### :returns: What the command gives, or -1 with `errno` set.
@external("c")
@symbol("fcntl")
@variadic
@target(os: ("linux", "macos"))
secret routine c_fcntl(fd: CInt, cmd: CInt) -> CInt

### Binds the C `fork` function, which makes a copy of the process.
### :returns: 0 in the child, the child's process id in the parent, or -1 with `errno` set.
@external("c")
@symbol("fork")
@target(os: ("linux", "macos"))
secret routine c_fork() -> CInt

### Binds the C `dup2` function, which makes one descriptor a copy of another, closing what it was first.
### :param from: The descriptor to copy.
### :param to: The descriptor number the copy takes.
### :returns: `to`, or -1 with `errno` set.
@external("c")
@symbol("dup2")
@target(os: ("linux", "macos"))
secret routine c_dup2(from: CInt, to: CInt) -> CInt

### Binds the C `execvp` function, which replaces the process with a program looked up on PATH.
### :param file: The program, NUL-terminated.
### :param argv: The null-terminated argument vector, the program name first.
### :returns: -1 with `errno` set (it returns only on failure).
@external("c")
@symbol("execvp")
@target(os: ("linux", "macos"))
secret routine c_execvp(file: @Byte, argv: @@Byte) -> CInt

### Binds the C `_exit` function, which ends the process at once, without flushing or running `atexit` handlers.
### :param status: The process's exit status.
@external("c")
@symbol("_exit")
@noreturn
@target(os: ("linux", "macos"))
secret routine c_exit_now(status: CInt) -> None

### Binds the C `waitpid` function, which waits for a child process to change state.
### :param pid: The child's process id.
### :param status: Where the child's wait status goes.
### :param options: The `W*` flags (0 to wait until it ends).
### :returns: The child's process id, or -1 with `errno` set.
@external("c")
@symbol("waitpid")
@target(os: ("linux", "macos"))
secret routine c_waitpid(pid: CInt, status: @CInt, options: CInt) -> CInt

### Binds the C `_NSGetEnviron` function (macOS).
### :returns: The address of the process's `environ` pointer.
@external("c")
@symbol("_NSGetEnviron")
@target(os: "macos")
secret routine c_ns_get_environ() -> @@@Byte

# nfds_t: unsigned long on Linux, unsigned int on macOS
### Binds the C `poll` function (Linux), which waits until one of several descriptors is ready.
### :param fds: The poll entries.
### :param count: How many entries `fds` holds.
### :param timeout: The longest wait in milliseconds, -1 for no limit.
### :returns: How many entries have events, 0 on a timeout, or -1 with `errno` set.
@external("c")
@symbol("poll")
@target(os: "linux")
secret routine c_poll(fds: @PollFd, count: CSize, timeout: CInt) -> CInt

### Binds the C `poll` function (macOS), which waits until one of several descriptors is ready.
### :param fds: The poll entries.
### :param count: How many entries `fds` holds.
### :param timeout: The longest wait in milliseconds, -1 for no limit.
### :returns: How many entries have events, 0 on a timeout, or -1 with `errno` set.
@external("c")
@symbol("poll")
@target(os: "macos")
secret routine c_poll(fds: @PollFd, count: U32, timeout: CInt) -> CInt

### Waits, without a time limit, until one of two descriptors is ready.
### :param fds: An array of two poll entries.
### :returns: The poll result, negative on failure.
@target(os: "linux")
secret routine poll_two(fds: @PollFd) -> CInt
    return c_poll(fds, 2, -1)

### Waits, without a time limit, until one of two descriptors is ready.
### :param fds: An array of two poll entries.
### :returns: The poll result, negative on failure.
@target(os: "macos")
secret routine poll_two(fds: @PollFd) -> CInt
    return c_poll(fds, 2, -1)

### Where C's environ lives: the variable on Linux, and through _NSGetEnviron on macOS (as a library must).
### :returns: The address of the `environ` pointer.
@target(os: "linux")
secret routine environ_place() -> @@@Byte
    return ENVIRON

### Where C's environ lives: the variable on Linux, and through _NSGetEnviron on macOS (as a library must).
### :returns: The address of the `environ` pointer.
@target(os: "macos")
secret routine environ_place() -> @@@Byte
    return c_ns_get_environ()

### The `open` flags O_RDWR | O_CLOEXEC, whose values differ between Linux and macOS.
### :returns: The flags.
@target(os: "linux")
secret routine read_write_cloexec() -> CInt
    return 0x80002

### The `open` flags O_RDWR | O_CLOEXEC, whose values differ between Linux and macOS.
### :returns: The flags.
@target(os: "macos")
secret routine read_write_cloexec() -> CInt
    return 0x1000002

### The {ProcessError} for the errno a failed start reported.
### :param e: The error number.
### :returns: NotFound, PermissionDenied, or OutOfMemory for those errors, else Other.
@target(os: ("linux", "macos"))
secret routine spawn_error(e: CInt) -> ProcessError
    when
        e == 2 or e == 20 => return NotFoundError()
        e == 1 or e == 13 => return NotEnoughPermissionError()
        e == 12 => return MemoryAllocationError()
        else => return IoError(code: 0)

# -- what the child is given -----------------------------------------------------------

### The argument vector, the environment (null to inherit), and the directory (null to stay), in memory from manager.
@target(os: ("linux", "macos"))
secret record Prepared
    argv: @@Byte  # the program and the arguments, then null
    argc: U64  # how many strings argv holds (made so far, when it couldn't finish)
    envp: @@Byte  # the parent's entries not overridden, the overrides, then null
    own_first: U64  # where envp's own (allocated) entries start
    own_count: U64
    directory: @Byte

### Makes a `Prepared` from its fields.
### :param argv: Its `argv`.
### :param argc: Its `argc`.
### :param envp: Its `envp`.
### :param own_first: Its `own_first`.
### :param own_count: Its `own_count`.
### :param directory: Its `directory`.
### :returns: The new value.
@target(os: ("linux", "macos"))
secret common routine Prepared.construct(argv: @@Byte, argc: U64, envp: @@Byte, own_first: U64,
    own_count: U64, directory: @Byte) -> Me
    return Me(argv, argc, envp, own_first, own_count, directory)

### Releases nothing: a `Prepared` holds no memory of its own.
@target(os: ("linux", "macos"))
secret routine @Prepared.destruct() -> None
    return

### Nothing prepared: what a run starts from, so releasing it is right on every path.
### :returns: The empty {Prepared}.
@target(os: ("linux", "macos"))
secret common routine Prepared.empty() -> Me
    return Me(argv: .hollow(), argc: 0, envp: .hollow(), own_first: 0, own_count: 0,
        directory: .hollow())

### `text` with a NUL after it, in memory from `manager`.
### :param text: The bytes to copy.
### :param manager: The memory manager for the copy.
### :returns: The NUL-terminated copy, or null when the allocation fails.
@target(os: ("linux", "macos"))
secret routine c_string(text: @[Byte], manager: @MemoryManager) -> @Byte
    n: U64 = text.count()
    p: @Byte = allocate[Byte](count: n + 1, manager)
    if p.is_hollow()
        return .hollow()
    p.copy(src: text.data, count: n)
    p.stride(n).poke(0x00)
    return p

### "name=value" with a NUL after it, in memory from `manager`.
### :param v: The variable.
### :param manager: The memory manager for the entry.
### :returns: The NUL-terminated entry, or null when the allocation fails.
@target(os: ("linux", "macos"))
secret routine env_entry(v: EnvVar, manager: @MemoryManager) -> @Byte
    n: U64 = v.name.count()
    m: U64 = v.value.count()
    p: @Byte = allocate[Byte](count: n + m + 2, manager)
    if p.is_hollow()
        return .hollow()
    p.copy(src: v.name.data, count: n)
    p.stride(n).poke(b'=')
    p.stride(n + 1).copy(src: v.value.data, count: m)
    p.stride(n + m + 1).poke(0x00)
    return p

### Frees every string and array a prepared start owns, whether it was made completely or not.
### :param manager: The memory manager they came from.
@target(os: ("linux", "macos"))
secret routine @Prepared.release(manager: @MemoryManager) -> None
    each i in 0 til me.argc.peek()
        arg_slot: @@Byte = me.argv.peek().stride(i)
        deallocate(data: arg_slot.peek(), manager)

    loop with i: U64 = 0
        envp2: @@Byte = me.envp.peek()
        if envp2.is_hollow() or i == me.own_count.peek()
            break
        entry_slot: @@Byte = envp2.stride(me.own_first.peek() + i)
        deallocate(data: entry_slot.peek(), manager)
        continue with i: i + 1
    argv: @@Byte = me.argv.peek()
    if not argv.is_hollow()
        deallocate(data: argv, manager)
    envp: @@Byte = me.envp.peek()
    if not envp.is_hollow()
        deallocate(data: envp, manager)
    dir: @Byte = me.directory.peek()
    if dir.is_hollow()
        return
    deallocate(data: dir, manager)
    return

### Builds everything the child needs before fork, so the child allocates nothing: the argument vector, the merged
### environment, and the directory path. What it made is right to release even when it fails.
### :param program: The program to run.
### :param args: The arguments, not including the program.
### :param options: The directory and environment overrides.
### :param manager: The memory manager for the strings and arrays.
### :returns: `true` on success, `false` when an allocation failed.
@target(os: ("linux", "macos"))
secret routine @Prepared.make(program: @[Byte], args: @[@[Byte]], options: ProcessOptions,
    manager: @MemoryManager) -> Bool
    local arg_count: U64 = args.count()
    local first: @U64 <- .hollow()

    me.poke(Me.empty())
    argv: @@Byte = allocate[@Byte](count: arg_count + 2, manager)
    if argv.is_hollow()
        return false
    me.argv.poke(argv)
    each i in 0 to arg_count
        s: @Byte = when
            i == 0 => c_string(text: program, manager)
            else => c_string(text: args[i - 1], manager)
        if s.is_hollow()
            return false
        argv.stride(i).poke(s)
        me.argc.poke(i + 1)
    argv.stride(arg_count + 1).poke(.hollow())
    when options.directory
        is @[Byte] as d =>
            directory: @Byte = c_string(text: d, manager)
            if directory.is_hollow()
                return false
            me.directory.poke(directory)
        is None => nothing
    if options.env_count == 0
        return true
    parent: @@Byte = environ_place().peek()
    n: U64 = count_entries(parent)

    # The parent's entries the overrides don't name, pointed at as they are (the child gets the same memory), then
    # the overrides, made here.
    envp: @@Byte = allocate[@Byte](count: n + options.env_count + 1, manager)
    if envp.is_hollow()
        return false
    me.envp.poke(envp)
    0.poke_into(first)
    each i in 0 til n
        entry: @Byte = parent.stride(i).peek()
        if not is_overridden(entry: entry.to[CStrView]().getview(), options)
            envp.stride(first.peek()).poke(entry)
            (first.peek() + 1).poke_into(first)
    each j in 0 til options.env_count
        e: @Byte = env_entry(v: options.env.stride(j).peek(), manager)
        if e.is_hollow()
            me.own_first.poke(first.peek())
            me.own_count.poke(j)
            return false
        envp.stride(first.peek() + j).poke(e)
    envp.stride(first.peek() + options.env_count).poke(.hollow())
    me.own_first.poke(first.peek())
    me.own_count.poke(options.env_count)
    return true

### How many entries a null-ended array of C strings holds before its null.
### :param entries: The array, or null for none.
### :returns: The number of entries, 0 when `entries` is null.
@target(os: ("linux", "macos"))
secret routine count_entries(entries: @@Byte) -> U64
    if entries.is_hollow()
        return 0
    until entries.stride(n).peek().is_hollow() with n: U64 = 0
        continue with n: n + 1
    then
        return n

### Whether an override names `entry`'s variable (names compared exactly, case included).
### :param entry: A "NAME=VALUE" entry of this process's environment.
### :param options: The environment overrides.
### :returns: True when an override has the same name.
@target(os: ("linux", "macos"))
secret routine is_overridden(entry: @[Byte], options: ProcessOptions) -> Bool
    each j in 0 til options.env_count
        if env_key_matches(name: options.env.stride(j).peek().name, entry, fold: false)
            return true
        continue
    then
        return false

# -- the child ---------------------------------------------------------------------------

### The streams one child gets: each the fd to put in place, or -1 to leave what it inherits.
@target(os: ("linux", "macos"))
secret record ChildStreams
    input: CInt
    output: CInt
    error: CInt
    report: CInt

### Makes a `ChildStreams` from its fields.
### :param input: Its `input`.
### :param output: Its `output`.
### :param error: Its `error`.
### :param report: Its `report`.
### :returns: The new value.
@target(os: ("linux", "macos"))
secret common routine ChildStreams.construct(input: CInt, output: CInt, error: CInt,
    report: CInt) -> Me
    return Me(input, output, error, report)

### Releases nothing: a `ChildStreams` holds no memory of its own.
@target(os: ("linux", "macos"))
secret routine @ChildStreams.destruct() -> None
    return

### What the forked child does: connects its standard streams to the given descriptors (one below 0 stays as
### inherited), changes directory, installs the merged environment, and execs the program. If a step fails it writes
### the errno to the report pipe and exits with status 127 at once. It never returns.
### :param p: The prepared arguments, environment, and directory.
### :param s: The descriptors to use for standard input, output, and error, and the report pipe.
@noreturn
@target(os: ("linux", "macos"))
secret routine child(p: @Prepared, s: ChildStreams) -> None
    if s.input >= 0
        c_dup2(s.input, 0)
    if s.output >= 0
        c_dup2(s.output, 1)
    if s.error >= 0
        c_dup2(s.error, 2)
    dir: @Byte = p.directory.peek()
    if dir.is_hollow() or c_chdir(dir) == 0
        envp: @@Byte = p.envp.peek()
        if not envp.is_hollow()
            environ_place().poke(envp)
        argv: @@Byte = p.argv.peek()
        c_execvp(argv.peek(), argv)
        local e: @CInt <- errno()
        c_write(s.report, e.to[@Byte](), 4)
        c_exit_now(127)
    local e: @CInt <- errno()
    c_write(s.report, e.to[@Byte](), 4)
    c_exit_now(127)

# -- the parent --------------------------------------------------------------------------

### The pipes and the null device a run uses: -1 where it has none.
@target(os: ("linux", "macos"))
secret record Plumbing
    out_r: CInt
    out_w: CInt
    err_r: CInt
    err_w: CInt
    exec_r: CInt
    exec_w: CInt
    devnull: CInt

### One captured output stream of the child: the read end of its pipe and the buffer what it reads goes into.
@target(os: ("linux", "macos"))
secret record PipeCapture
    ### The read end of the pipe, or -1 when the stream isn't captured.
    fd: CInt
    ### The buffer the stream's bytes go into.
    buffer: @CaptureBuffer

### What a run works in: the prepared strings, the pipes, and the two captures, all released by the caller of
### run_child, and the memory manager they come from.
@target(os: ("linux", "macos"))
secret record ChildRun
    p: @Prepared
    pipes: @Plumbing
    out: @CaptureBuffer
    err: @CaptureBuffer
    manager: @MemoryManager

### Makes a `Plumbing` from its fields.
### :param out_r: Its `out_r`.
### :param out_w: Its `out_w`.
### :param err_r: Its `err_r`.
### :param err_w: Its `err_w`.
### :param exec_r: Its `exec_r`.
### :param exec_w: Its `exec_w`.
### :param devnull: Its `devnull`.
### :returns: The new value.
@target(os: ("linux", "macos"))
secret common routine Plumbing.construct(out_r: CInt, out_w: CInt, err_r: CInt, err_w: CInt,
    exec_r: CInt, exec_w: CInt, devnull: CInt) -> Me
    return Me(out_r, out_w, err_r, err_w, exec_r, exec_w, devnull)

### Releases nothing: a `Plumbing` holds no memory of its own.
@target(os: ("linux", "macos"))
secret routine @Plumbing.destruct() -> None
    return

### Makes a `PipeCapture` from its fields.
### :param fd: Its `fd`.
### :param buffer: Its `buffer`.
### :returns: The new value.
@target(os: ("linux", "macos"))
secret common routine PipeCapture.construct(fd: CInt, buffer: @CaptureBuffer) -> Me
    return Me(fd, buffer)

### Releases nothing: a `PipeCapture` holds no memory of its own.
@target(os: ("linux", "macos"))
secret routine @PipeCapture.destruct() -> None
    return

### No pipes and no null device: what a run starts from, so closing them is right on every path.
### :returns: The {Plumbing} with every descriptor -1.
@target(os: ("linux", "macos"))
secret common routine Plumbing.empty() -> Me
    return Me(out_r: -1, out_w: -1, err_r: -1, err_w: -1, exec_r: -1, exec_w: -1, devnull: -1)

### Makes a pipe with both ends close-on-exec.
### :param fds: Where the two descriptors go: the read end, then the write end.
### :returns: True when the pipe was made.
@target(os: ("linux", "macos"))
secret routine cloexec_pipe(fds: @CInt) -> Bool
    if not (c_pipe(fds) == 0)
        return false
    # F_SETFD, FD_CLOEXEC
    c_fcntl(fds.peek(), 2, 1)
    c_fcntl(fds.stride(1).peek(), 2, 1)
    return true

### Closes `fd` unless it is negative (not open).
### :param fd: The descriptor, or a negative value for none.
@target(os: ("linux", "macos"))
secret routine close_if_open(fd: CInt) -> None
    if not (fd >= 0)
        return
    c_close(fd)
    return

### Closes every pipe end and descriptor still open.
@target(os: ("linux", "macos"))
secret routine @Plumbing.close_all() -> None
    close_if_open(me.out_r.peek())
    close_if_open(me.out_w.peek())
    close_if_open(me.err_r.peek())
    close_if_open(me.err_w.peek())
    close_if_open(me.exec_r.peek())
    close_if_open(me.exec_w.peek())
    close_if_open(me.devnull.peek())
    return

### Makes the pipes and the null device `options` call for: always the exec report pipe, a pipe for each captured
### stream, and `/dev/null` when a stream is the null device.
### :param options: The standard streams.
### :returns: True when all were made. What was made before a failure is kept for {Plumbing.close_all}.
@target(os: ("linux", "macos"))
secret routine @Plumbing.make(options: ProcessOptions) -> Bool
    me.poke(Me.empty())
    local fds: @Array[CInt, 2] <- [-1, -1]
    if not cloexec_pipe(fds.to[@CInt]())
        return false
    me.exec_r.poke(fds[0])
    me.exec_w.poke(fds[1])
    fds2: @CInt = when
        not (options.stdout == OutputMode.CAPTURE) => fds.to[@CInt]()
        else =>
            if not cloexec_pipe(fds.to[@CInt]())
                return false
            me.out_r.poke(fds[0])
            me.out_w.poke(fds[1])
            becomes fds.to[@CInt]()
    if options.stderr == OutputMode.CAPTURE
        if not cloexec_pipe(fds2)
            return false
        me.err_r.poke(fds2.peek())
        me.err_w.poke(fds2.stride(1).peek())
    null_in: Bool = options.stdin == InputMode.NULL
    null_out: Bool = options.stdout == OutputMode.NULL or options.stderr == OutputMode.NULL
    if not (null_in or null_out)
        return true
    fd: CInt = c_open("/dev/null", read_write_cloexec())
    me.devnull.poke(fd)
    return fd >= 0

### The fd one output stream of the child gets: the pipe's write end, the null device, or -1 (inherit).
### :param mode: What becomes of the stream.
### :param pipe: The pipe's write end, for `Capture`.
### :param null_fd: The null device, for `Null`.
### :returns: The descriptor, or -1 to leave what the child inherits.
@target(os: ("linux", "macos"))
secret routine output_fd(mode: OutputMode, pipe: CInt, null_fd: CInt) -> CInt
    when mode
        OutputMode.CAPTURE => return pipe
        OutputMode.NULL => return null_fd
        OutputMode.INHERIT => return -1

### Creates a process that runs `program` (looked up on PATH) with fork and execvp, waits for it to end, reaps it, and
### returns how it ended and what it captured. Captured output is read to the end from both pipes at once. This is the Linux and macOS half. Windows
### uses CreateProcessW.
### :param program: The program to run.
### :param args: The arguments, not including the program name.
### :param options: The directory, environment overrides, and standard streams.
### :param manager: The memory manager for the captured output and the working memory.
### :returns: The {ProcessOutput}, or a {ProcessError} (InvalidArgument for a NUL in the program, an
### argument, the directory, or a variable, OutOfMemory when the working memory or the captured output can't be
### allocated).
@target(os: ("linux", "macos"))
@expensive("starts a process")
failable common routine ProcessManager.create_process(program: @[Byte], args: @[@[Byte]],
    options: ProcessOptions, manager: @MemoryManager) -> ProcessOutput
    local p: @Prepared <- Prepared.empty()
    local pipes: @Plumbing <- Plumbing.empty()
    local out: @CaptureBuffer <- CaptureBuffer.empty()
    local err: @CaptureBuffer <- CaptureBuffer.empty()

    when check run_child(program, args, options, run: ChildRun(p, pipes, out, err, manager))
        is ProcessOutput as made =>
            # Every descriptor still open, the prepared strings, and the captured bytes nothing took.
            pipes.close_all()
            p.release(manager)
            drop out
            drop err
            return made
        is ProcessError as error =>
            pipes.close_all()
            p.release(manager)
            drop out
            drop err
            throw error

### Makes a `ChildRun` from its fields.
### :param p: Its `p`.
### :param pipes: Its `pipes`.
### :param out: Its `out`.
### :param err: Its `err`.
### :param manager: Its `manager`.
### :returns: The new value.
@target(os: ("linux", "macos"))
secret common routine ChildRun.construct(p: @Prepared, pipes: @Plumbing, out: @CaptureBuffer,
    err: @CaptureBuffer, manager: @MemoryManager) -> Me
    return Me(p, pipes, out, err, manager)

### Releases nothing: a `ChildRun` only points at what its caller holds.
@target(os: ("linux", "macos"))
secret routine @ChildRun.destruct() -> None
    return

### Prepares, starts, and waits for the child, capturing into the run's buffers. What it opens and makes stays in the
### run for the caller to release.
### :param program: The program to run.
### :param args: The arguments.
### :param options: The directory, environment, and standard streams.
### :param run: The prepared strings, pipes, captures, and memory manager.
### :returns: The {ProcessOutput}, or the {ProcessError}.
@target(os: ("linux", "macos"))
secret failable routine run_child(program: @[Byte], args: @[@[Byte]], options: ProcessOptions,
    run: ChildRun) -> ProcessOutput
    local report: @CInt <- 0

    p: @Prepared = run.p
    pipes: @Plumbing = run.pipes
    out: @CaptureBuffer = run.out
    err: @CaptureBuffer = run.err
    manager: @MemoryManager = run.manager

    if has_nul(program, args, options)
        throw InvalidArgumentError()
    if not p.make(program, args, options, manager)
        throw MemoryAllocationError()
    if not pipes.make(options)
        throw spawn_error(errno())
    pid: CInt = fork_child(p, pipes, options)
    if pid < 0
        throw spawn_error(errno())
    # 4 bytes on the report pipe are the errno of a failed exec. Its end without them is a started program.
    got: S64 = read_report(fd: pipes.exec_r.peek(), report)
    c_close(pipes.exec_r.peek())
    pipes.exec_r.poke(-1)
    # drain closes both pipes as each ends.
    drain(out: PipeCapture(fd: pipes.out_r.peek(), buffer: out),
        err: PipeCapture(fd: pipes.err_r.peek(), buffer: err), manager)
    pipes.out_r.poke(-1)
    pipes.err_r.poke(-1)
    status: Maybe[ExitStatus] = reap(pid)
    if got == 4
        throw spawn_error(report.peek())
    when check take_output(status, out, err)
        is ProcessOutput as returned => return returned

### Forks the child with what `p` and `pipes` prepared. In the parent, closes the child's ends of the pipes and the
### null device and marks them -1 in `pipes`, so each pipe ends when the child is done with it.
### :param p: The argument vector, environment, and directory, made.
### :param pipes: The pipes and the null device, made.
### :param options: The standard streams.
### :returns: The child's process id, or a negative value with `errno` set when fork failed (nothing is closed then).
@target(os: ("linux", "macos"))
secret routine fork_child(p: @Prepared, pipes: @Plumbing, options: ProcessOptions) -> CInt
    null_fd: CInt = pipes.devnull.peek()
    input: CInt = when
        options.stdin == InputMode.NULL => null_fd
        else => -1
    streams: ChildStreams = ChildStreams(input: input,
        output: output_fd(mode: options.stdout, pipe: pipes.out_w.peek(), null_fd),
        error: output_fd(mode: options.stderr, pipe: pipes.err_w.peek(), null_fd),
        report: pipes.exec_w.peek())
    pid: CInt = c_fork()
    if pid == 0
        child(p, s: streams)
    if pid < 0
        return pid
    # The child's ends close here, so each pipe ends when the child is done with it.
    close_if_open(pipes.out_w.peek())
    close_if_open(pipes.err_w.peek())
    close_if_open(pipes.exec_w.peek())
    close_if_open(null_fd)
    pipes.out_w.poke(-1)
    pipes.err_w.poke(-1)
    pipes.exec_w.poke(-1)
    pipes.devnull.poke(-1)
    return pid

### The run's output once the child has ended: its exit status and the captured bytes, which the output owns from
### here, so the buffers are left empty and the caller has none left to release. A capture that couldn't grow lost
### bytes: the run fails, and the caller releases what was captured.
### :param status: How the child ended, `None` when it couldn't be waited for.
### :param out: The captured standard output.
### :param err: The captured standard error.
### :returns: The {ProcessOutput}.
### :throws: Throws `MemoryAllocationError` when a capture couldn't grow, `IoError` when the child couldn't be waited for.
@target(os: ("linux", "macos"))
secret failable routine take_output(status: Maybe[ExitStatus], out: @CaptureBuffer,
    err: @CaptureBuffer) -> ProcessOutput
    when status
        is ExitStatus as s =>
            if out.failed.peek() or err.failed.peek()
                throw MemoryAllocationError()
            return ProcessOutput(status: s, stdout: out.owned(), stderr: err.owned())
        is None => throw IoError(code: 0)

### Reads the exec report from the report pipe into `report`, retrying when a signal interrupts the read.
### :param fd: The report pipe's read end.
### :param report: Where the 4 report bytes go.
### :returns: What the read returned: 4 for a report, 0 at the pipe's end, or negative on a failure.
@target(os: ("linux", "macos"))
secret routine read_report(fd: CInt, report: @CInt) -> S64
    loop
        got: S64 = c_read(fd, report.to[@Byte](), 4).to[S64]()
        if got < 0 and errno() == 4
            continue
        return got

### Reads both pipes (-1 for one not captured) to their end, whichever has data, and closes them. When poll fails
### with anything but EINTR, it closes both and stops.
### :param out: Standard output's pipe (its fd -1 when not captured) and the buffer it goes into.
### :param err: Standard error's pipe (its fd -1 when not captured) and the buffer it goes into.
### :param manager: The memory manager the buffers grow from.
@target(os: ("linux", "macos"))
secret routine drain(out: PipeCapture, err: PipeCapture, manager: @MemoryManager) -> None
    local out_fd: CInt = out.fd
    local err_fd: CInt = err.fd
    # POLLIN, and poll skips a negative fd
    local poll_fds: @Array[PollFd, 2] <- [PollFd(fd: out_fd, events: 1, revents: 0),
        PollFd(fd: err_fd, events: 1, revents: 0)]
    local chunk_buffer: @Array[Byte, 4096] <- .hollow()
    local fds: @PollFd = poll_fds.to[@PollFd]()
    local chunk: @Byte = chunk_buffer.to[@Byte]()

    out_open: U32 = (out_fd >= 0).to[U32]()
    until open == 0 with open: U32 = out_open + (err_fd >= 0).to[U32]()
        if poll_two(fds) < 0
            if errno() == 4
                continue with open: open
            close_if_open(fds.fd.peek())
            close_if_open(fds.stride(1).fd.peek())
            return
        each i: U64 in 0 til 2 with left: U32 = open
            p: @PollFd = fds.stride(i)
            fd: CInt = p.fd.peek()
            if fd < 0 or p.revents.peek() == 0
                continue with left: left
            n: S64 = c_read(fd, chunk, 4096).to[S64]()
            if n > 0
                count: U64 = n.to[U64]()
                buffer: @CaptureBuffer = when
                    i == 0 => out.buffer
                    else => err.buffer
                buffer.append(chunk, n: count, manager)
                continue with left: left
            if n < 0 and errno() == 4
                continue with left: left
            c_close(fd)
            p.fd.poke(-1)
            continue with left: left - 1
        then
            continue with open: left
    return

### Waits for the child to end, retrying when a signal interrupts the wait.
### :param pid: The child's process id.
### :returns: How it ended.
### :absent: When waitpid fails.
@target(os: ("linux", "macos"))
secret routine reap(pid: CInt) -> Maybe[ExitStatus]
    local status: @CInt <- 0

    loop
        rc2: CInt = c_waitpid(pid, status, 0)
        if rc2 < 0 and errno() == 4
            continue
        if rc2 < 0
            return None()
        s: CInt = status.peek()
        low: CInt = s & 0x7F
        # WIFEXITED, else WIFSIGNALED (0x7F is a stop, which waitpid without WUNTRACED doesn't report)
        if low == 0
            ended: ExitStatus = Exited(code: (s >> 8) & 0xFF)
            return ended
        stopped: ExitStatus = Signaled(signal: low)
        return stopped

# -- the environment ---------------------------------------------------------------------

### The value of the environment variable `name`, in memory from `manager`. Drop it.
### :param name: The variable's name.
### :param manager: The memory manager for the value.
### :returns: The value's bytes.
### :absent: When the variable isn't set, `name` is 256 bytes or longer or holds a NUL, or the allocation fails.
@target(os: ("linux", "macos"))
@expensive("allocates a copy of the variable")
secret routine env_var(name: @[Byte], manager: @MemoryManager) -> Maybe[Memory[Byte]]
    local key: @Array[Byte, 256] <- .hollow()

    if (name.count() >= 256) or name.has("\0")
        return None()
    key.to[@Byte]().copy(src: name.data, count: name.count())
    key_end: @Byte = key.to[@Byte]().stride(name.count())
    key_end.poke(0x00)
    value: @Byte = c_getenv(key.to[@Byte]().to[CStrView]())
    if value.is_hollow()
        return None()
    n: U64 = value.to[CStrView]().count()
    when check Memory[Byte].construct(count: n.max(1), manager: manager)
        is Memory[Byte] as owned =>
            owned.data.peek().copy(src: value, count: n)
            owned.keep_first(n)
            return owned
        is MemoryAllocationError => return None()
