// Tessera stdlib: running another program, the environment, and leaving this one
//
// run_process starts a program (looked up on PATH as a shell would) with its arguments, waits for it, and hands
// back how it ended and what it wrote. Its standard input is the null device unless the options say to share this
// process's. Its output and error are captured (read to the end, both at once, so a child that fills one while the
// other waits can't deadlock), shared, or discarded. Environment overrides are merged into this process's
// environment, so PATH and the rest stay. run_shell runs a command line through the platform shell (sh -c, or
// cmd.exe /c) for pipes and globs, at the cost of the shell's quoting.
//
// The per-OS halves are Process_posix.tess (fork and execvp) and Process_windows.tess (CreateProcessW).

module Standard::Os

import Standard::Alloc

/// The exit status {set_exit_code} stored, which `start` returning ends the process with.
private global EXIT_CODE: @S32 <- 0

/// Why a program couldn't start, or its output couldn't be captured.
choice ProcessError: U8
    NotFound  // no such program
    PermissionDenied
    InvalidArgument  // a NUL inside the program, an argument, the directory, or a variable, or a '=' in a name
    OutOfMemory  // the working memory, or room for the captured output, couldn't be allocated
    Other

/// What the child's standard input is.
choice InputMode: U8
    Null  // the null device: it reads end-of-file at once
    Inherit  // this process's standard input

/// What becomes of the child's standard output or error.
choice OutputMode: U8
    Capture  // read into the ProcessOutput
    Inherit  // this process's
    Null  // discarded

/// How a program ended.
variant ExitStatus
    Exited   : S32  // its exit code
    Signaled : S32  // the signal that stopped it (POSIX only)

/// One environment variable for the child.
record EnvVar
    name  : Bytes
    value : Bytes

/// How {run_process_result} starts a program: its working directory, environment overrides, and what its standard
/// streams are. {ProcessOptions.default} is a good start.
record ProcessOptions
    directory : Option<Bytes>  // where it starts: Absent for this process's working directory
    env       : @EnvVar  // env_count overrides of this process's environment
    env_count : USize
    stdin     : InputMode
    stdout    : OutputMode
    stderr    : OutputMode

/// What run_process hands back. A captured stream is in memory from the allocator, and `destruct()` releases both.
/// One not captured is empty and holds nothing.
record ProcessOutput
conform Destructible<ProcessOutput>
    status : ExitStatus
    stdout : Bytes
    stderr : Bytes

/// Gives both captured streams back to the allocator they came from.
#track_caller
routine ProcessOutput.destruct(self: @Self) -> Void
    block entry()
        self.stdout.destruct()
        self.stderr.destruct()
        return()

/// No directory and no overrides, the null device as input, and both output streams captured.
/// :returns: The default options.
routine ProcessOptions.default() -> Self
    block entry()
        return(Self { directory: .Absent, env: null, env_count: 0, stdin: InputMode.Null,
            stdout: OutputMode.Capture, stderr: OutputMode.Capture })

/// The exit code, or for a program a signal stopped, 128 plus the signal (as a POSIX shell reports it).
/// :returns: The code.
routine ExitStatus.code(self: Self) -> S32
    block entry()
        when self
            .Exited(c)   -> return(c)
            .Signaled(s) -> return(s.add_wrap(128))

/// Whether it exited with code 0.
/// :returns: True for an exit with code 0, false for any other code or a signal.
routine ExitStatus.is_success(self: Self) -> Bool
    block entry()
        when self
            .Exited(c) -> return(c.eq(0))
            .Signaled  -> return(false)

/// Runs a command line through the platform shell (`/bin/sh -c` on Linux and macOS, `cmd.exe /c` on Windows) with
/// {run_process_result}, for pipes and globs at the cost of the shell's quoting.
/// :param command: The command line.
/// :param options: The directory, environment overrides, and standard streams.
/// :param alloc: The allocator for the captured output and the working memory.
/// :returns: The {ProcessOutput}, or Failure with a {ProcessError} when the shell couldn't start.
routine run_shell_result(command: Bytes, options: ProcessOptions,
    alloc: @Allocator) -> Result<ProcessOutput, ProcessError>
    block entry()
        claim args : @Array<Bytes, 2> <- { shell_flag(), command }
        return(run_process_result(shell_program(), args.to<@Bytes>(), 2, options, alloc))

/// The platform shell {run_shell_result} starts: `cmd.exe` on Windows, `/bin/sh` elsewhere.
/// :returns: The program name.
#target(os: "windows")
private routine shell_program() -> Bytes
    block entry()
        return("cmd.exe")

/// The shell's flag that takes a command line: `/c` for cmd.exe, `-c` for sh.
/// :returns: The flag.
#target(os: "windows")
private routine shell_flag() -> Bytes
    block entry()
        return("/c")

/// The platform shell {run_shell_result} starts: `cmd.exe` on Windows, `/bin/sh` elsewhere.
/// :returns: The program name.
#target(os: ("linux", "macos"))
private routine shell_program() -> Bytes
    block entry()
        return("/bin/sh")

/// The shell's flag that takes a command line: `/c` for cmd.exe, `-c` for sh.
/// :returns: The flag.
#target(os: ("linux", "macos"))
private routine shell_flag() -> Bytes
    block entry()
        return("-c")

/// Sets the exit status the program ends with when `start` returns. The last store wins: it is one atomic value, so
/// any thread may set it, and the builder's `main` reads it after `start` returned (a thread still running then may
/// or may not get its store in). A crash ends the process with its own status, whatever was set.
/// :param code: The exit status, 0 for success.
routine set_exit_code(code: S32) -> Void
    block entry()
        EXIT_CODE.atomic_store(code)
        return()

/// The exit status the program ends with when `start` returns: the last {set_exit_code}, 0 when nothing set one.
/// The builder's `main` returns it after `start`.
/// :returns: The status.
routine exit_code() -> S32
    block entry()
        return(EXIT_CODE.atomic_load())

/// Ends this process with `status`, without returning. (Nothing is flushed but what the C library flushes.)
/// :param status: The process's exit status.
#noreturn
routine exit(status: S32) -> Void
    block entry()
        c_exit(status.to<CInt>())

// -- what both halves share ------------------------------------------------------------

/// A captured stream as it grows, in memory from an allocator.
internal record CaptureBuffer
    data     : @Byte
    count   : USize
    capacity : USize
    failed   : Bool  // an allocation failed: what came after was dropped

/// An empty capture buffer that holds no memory yet. Its `failed` is read when the run ends: a capture that lost
/// bytes makes the run fail with OutOfMemory instead of handing back a truncated stream.
/// :returns: The buffer.
internal routine CaptureBuffer.empty() -> Self
    block entry()
        return(Self { data: null, count: 0, capacity: 0, failed: false })

/// Appends `n` bytes, growing the buffer (to at least double, and at least 256 bytes). An allocation failure drops
/// them and marks the buffer `failed`.
/// :param chunk: The first byte to append.
/// :param n: How many bytes to append.
/// :param alloc: The allocator the buffer's memory comes from.
internal routine CaptureBuffer.append(self: @Self, chunk: @Byte, n: USize,
    alloc: @Allocator) -> Void
    shared need : USize = self.count.load().add(n)

    block entry()
        branch need.gt(self.capacity.load())
            ? grow_to_fit()
            : put()

    block grow_to_fit()
        doubled : USize = self.capacity.load().mul(2)
        jump grow(doubled.max(need).max(256))

    block grow(capacity: USize)
        old : @Byte = self.data.load()
        branch old.is_null()
            ? grown(capacity, allocate<Byte>(capacity, alloc))
            : grown(capacity, reallocate<Byte>(old, capacity, alloc))

    block grown(capacity: USize, bigger: @Byte)
        branch bigger.is_null()
            ? lost()
            : continue
        self.data.store(bigger)
        self.capacity.store(capacity)
        jump put()

    block lost()
        self.failed.store(true)
        return()

    block put()
        self.data.load().stride(self.count.load()).copy(chunk, n)
        next_count : USize = self.count.load().add(n)
        next_count.store_into(self.count)
        return()

/// What was captured, owned by the caller, who releases it with `destruct()`.
/// :param alloc: The allocator the buffer was filled from.
/// :returns: The captured bytes, carrying `alloc`.
internal routine CaptureBuffer.owned(self: Self, alloc: @Allocator) -> Bytes
    block entry()
        owned : Bytes = Bytes { data: self.data, count: self.count, alloc: alloc }
        return(owned)

/// What was captured, owned by the caller, who releases it with `destruct()`.
/// :param alloc: The allocator the buffer was filled from.
/// :returns: The captured bytes, carrying `alloc`.
internal routine CaptureBuffer.owned(self: @Self, alloc: @Allocator) -> Bytes
    block entry()
        owned : Bytes = self.load().owned(alloc)
        return(owned)

/// Whether a NUL is inside any text the child would get, or an override's name holds a '=': what run_process_result
/// turns down with InvalidArgument before it allocates anything, so a later failure to allocate is OutOfMemory.
/// :param program: The program to run.
/// :param args: The arguments.
/// :param arg_count: How many arguments `args` holds.
/// :param options: The directory and environment overrides.
/// :returns: True when the program, an argument, an override, or the directory can't be passed to the child.
internal routine has_nul(program: Bytes, args: @Bytes, arg_count: USize,
    options: ProcessOptions) -> Bool
    block entry()
        branch program.has("\x00")
            ? return(true)
            : arg(0)

    block arg(i: USize)
        branch i.eq(arg_count)
            ? env(0)
            : continue
        argument : Bytes = args.stride(i).load()
        branch argument.has("\x00")
            ? return(true)
            : arg(i.add(1))

    block env(i: USize)
        branch i.eq(options.env_count)
            ? directory()
            : continue
        v          : EnvVar = options.env.stride(i).load()
        nul_inside : Bool   = v.name.has("\x00").bitor(v.value.has("\x00"))
        branch nul_inside.bitor(v.name.has("="))
            ? return(true)
            : env(i.add(1))

    block directory()
        when options.directory
            .Present(d) -> return(d.has("\x00"))
            .Absent     -> return(false)

/// Whether `name`'s bytes equal the start of `entry` up to its '=' (a "NAME=VALUE" entry), ASCII letters in any case
/// when `fold` is set.
/// :param name: The variable name.
/// :param entry: The "NAME=VALUE" entry.
/// :param fold: True to compare ASCII letters without regard to case.
/// :returns: True when `entry` is the variable `name`.
internal routine env_key_matches(name: Bytes, entry: Bytes, fold: Bool) -> Bool
    block entry()
        n : USize = name.count()
        branch entry.count().gt(n)
            ? continue
            : return(false)
        branch entry.byte_at(n).eq(61)
            ? compare(0)
            : return(false)

    block compare(i: USize)
        branch i.eq(name.count())
            ? return(true)
            : continue
        a : U8 = name.byte_at(i)
        b : U8 = entry.byte_at(i)
        branch a.eq(b)
            ? compare(i.add(1))
            : continue
        branch fold.bitand(ascii_lower(a).eq(ascii_lower(b)))
            ? compare(i.add(1))
            : return(false)

/// The lowercase form of an ASCII uppercase letter, any other byte unchanged.
/// :param c: The byte.
/// :returns: `c` plus 32 for 'A' to 'Z', else `c`.
internal routine ascii_lower(c: U8) -> U8
    block entry()
        branch c.between(65, 90)
            ? return(c.add(32))
            : return(c)
