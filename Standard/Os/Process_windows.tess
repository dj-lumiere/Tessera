// Tessera stdlib: running another program on Windows (see Process.tess)
//
// CreateProcessW with a command line quoted so the child's CommandLineToArgvW reads back each argument as it was
// given, and, with overrides, a Unicode environment block: this process's variables (from GetEnvironmentStringsW,
// so nothing is lost to a code page) with the overridden ones replaced, names compared without case as Windows does,
// sorted as Windows wants. The child's three standard handles are always given: a pipe, the null device, or a
// duplicate of this process's own. When both output streams are captured, a helper thread reads standard error into
// the malloc heap (the caller's allocator may not be safe to share between threads) while this thread reads standard
// output.

module Standard::Os

import Standard::Alloc

/// SECURITY_ATTRIBUTES
#target(os: "windows")
private record SecurityAttributes
    length         : U32
    descriptor     : Addr
    inherit_handle : CInt

/// STARTUPINFOW
#target(os: "windows")
private record StartupInfo
    cb             : U32
    reserved       : Addr
    desktop        : Addr
    title          : Addr
    x              : U32
    y              : U32
    x_size         : U32
    y_size         : U32
    x_count_chars  : U32
    y_count_chars  : U32
    fill_attribute : U32
    flags          : U32
    show_window    : U16
    cb_reserved2   : U16
    reserved2      : Addr
    std_input      : Addr
    std_output     : Addr
    std_error      : Addr

/// PROCESS_INFORMATION
#target(os: "windows")
private record ProcessInformation
    process    : Addr
    thread     : Addr
    process_id : U32
    thread_id  : U32

/// Binds the Win32 `GetLastError` function.
/// :returns: The calling thread's last error code.
#[external("c"), symbol("GetLastError"), callconv("stdcall"), target(os: "windows")]
private routine c_get_last_error() -> U32

/// Binds the Win32 `SetLastError` function.
/// :param code: The error code to set as the calling thread's last error.
#[external("c"), symbol("SetLastError"), callconv("stdcall"), target(os: "windows")]
private routine c_set_last_error(code: U32) -> Void

/// Binds the Win32 `CreateFileW` function, which opens or creates a file or device.
/// :param name: The path, UTF-16 and 0-terminated.
/// :param access: The `GENERIC_*` access wanted.
/// :param share: The `FILE_SHARE_*` sharing allowed.
/// :param security: The security attributes, which say whether the handle is inheritable.
/// :param disposition: What to do when the file exists or doesn't, such as `OPEN_EXISTING`.
/// :param flags: The `FILE_ATTRIBUTE_*` and `FILE_FLAG_*` flags.
/// :param template: A template file handle, or null.
/// :returns: The handle, or INVALID_HANDLE_VALUE with the last error set.
#[external("c"), symbol("CreateFileW"), callconv("stdcall"), target(os: "windows")]
private routine c_create_file(name: @U16, access: U32, share: U32, security: @SecurityAttributes,
    disposition: U32, flags: U32, template: Addr) -> Addr

/// Binds the Win32 `CreatePipe` function, which makes an anonymous pipe.
/// :param read: Where the read end's handle goes.
/// :param write: Where the write end's handle goes.
/// :param security: The security attributes, which say whether the handles are inheritable.
/// :param size: The buffer size in bytes, 0 for the default.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("CreatePipe"), callconv("stdcall"), target(os: "windows")]
private routine c_create_pipe(read: @Addr, write: @Addr, security: @SecurityAttributes,
    size: U32) -> CInt

/// Binds the Win32 `SetHandleInformation` function, which sets a handle's flags.
/// :param handle: The handle.
/// :param mask: The flags to change, such as `HANDLE_FLAG_INHERIT`.
/// :param flags: The new values of the flags in `mask`.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("SetHandleInformation"), callconv("stdcall"), target(os: "windows")]
private routine c_set_handle_information(handle: Addr, mask: U32, flags: U32) -> CInt

/// Binds the Win32 `GetStdHandle` function, which gives one of the process's standard handles.
/// :param which: `STD_INPUT_HANDLE`, `STD_OUTPUT_HANDLE`, or `STD_ERROR_HANDLE`.
/// :returns: The handle, null when there is none, or INVALID_HANDLE_VALUE with the last error set.
#[external("c"), symbol("GetStdHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_get_std_handle(which: U32) -> Addr

/// Binds the Win32 `GetCurrentProcess` function.
/// :returns: The pseudo-handle of the current process (needs no closing).
#[external("c"), symbol("GetCurrentProcess"), callconv("stdcall"), target(os: "windows")]
private routine c_get_current_process() -> Addr

/// Binds the Win32 `DuplicateHandle` function, which copies a handle from one process into another.
/// :param from_process: The process that owns `handle`.
/// :param handle: The handle to copy.
/// :param to_process: The process that gets the copy.
/// :param copy: Where the copy goes.
/// :param access: The access the copy has (ignored with `DUPLICATE_SAME_ACCESS`).
/// :param inherit: Nonzero to make the copy inheritable.
/// :param options: The `DUPLICATE_*` flags.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("DuplicateHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_duplicate_handle(from_process: Addr, handle: Addr, to_process: Addr, copy: @Addr,
    access: U32, inherit: CInt, options: U32) -> CInt

/// Binds the Win32 `CreateProcessW` function, which starts a program.
/// :param application: The program's path, or null to take it from `command_line`.
/// :param command_line: The command line, UTF-16 and 0-terminated (the call may write to it).
/// :param process_attrs: The process handle's security attributes, or null.
/// :param thread_attrs: The thread handle's security attributes, or null.
/// :param inherit: Nonzero for the child to inherit this process's inheritable handles.
/// :param flags: The creation flags, such as `CREATE_UNICODE_ENVIRONMENT`.
/// :param environment: The environment block, or null to inherit this process's.
/// :param directory: The child's working directory, UTF-16 and 0-terminated, or null for this process's.
/// :param startup: The window and standard handle settings.
/// :param info: Where the process and thread handles and ids go.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("CreateProcessW"), callconv("stdcall"), target(os: "windows")]
private routine c_create_process(application: Addr, command_line: @U16, process_attrs: Addr,
    thread_attrs: Addr, inherit: CInt, flags: U32, environment: Addr, directory: @U16,
    startup: @StartupInfo, info: @ProcessInformation) -> CInt

/// Binds the Win32 `ReadFile` function, which reads bytes from a file or pipe.
/// :param handle: The handle to read from.
/// :param buffer: Where the bytes go.
/// :param size: The most bytes to read.
/// :param read: Where the number of bytes read goes (0 at end of input).
/// :param overlapped: Null for a synchronous read.
/// :returns: Nonzero on success, 0 with the last error set (a pipe whose writer closed reports this too).
#[external("c"), symbol("ReadFile"), callconv("stdcall"), target(os: "windows")]
private routine c_read_file(handle: Addr, buffer: @Byte, size: U32, read: @U32,
    overlapped: Addr) -> CInt

/// Binds the Win32 `WaitForSingleObject` function, which waits until an object is signaled.
/// :param handle: The object, such as a process.
/// :param millis: The longest wait in milliseconds, `INFINITE` (U32 MAX) for no limit.
/// :returns: `WAIT_OBJECT_0`, `WAIT_TIMEOUT`, or `WAIT_FAILED` with the last error set.
#[external("c"), symbol("WaitForSingleObject"), callconv("stdcall"), target(os: "windows")]
private routine c_wait_for_single_object(handle: Addr, millis: U32) -> U32

/// Binds the Win32 `GetExitCodeProcess` function, which reads a process's exit code.
/// :param process: The process.
/// :param code: Where the exit code goes (`STILL_ACTIVE` while it runs).
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("GetExitCodeProcess"), callconv("stdcall"), target(os: "windows")]
private routine c_get_exit_code_process(process: Addr, code: @U32) -> CInt

/// Binds the Win32 `CloseHandle` function, which closes a handle.
/// :param handle: The handle.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("CloseHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_close_handle(handle: Addr) -> CInt

/// Binds the Win32 `GetEnvironmentStringsW` function, which copies the process's environment block.
/// :returns: The block ("NAME=VALUE" strings, each 0-terminated, then an empty one), or null on failure. Free it with
///     `FreeEnvironmentStringsW`.
#[external("c"), symbol("GetEnvironmentStringsW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_environment_strings() -> @U16

/// Binds the Win32 `FreeEnvironmentStringsW` function, which frees a block from `GetEnvironmentStringsW`.
/// :param strings: The block.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("FreeEnvironmentStringsW"), callconv("stdcall"), target(os: "windows")]
private routine c_free_environment_strings(strings: @U16) -> CInt

/// Binds the Win32 `GetEnvironmentVariableW` function, which looks up an environment variable.
/// :param name: The variable's name, UTF-16 and 0-terminated.
/// :param buffer: Where the value goes, or null to ask for the size.
/// :param size: The units `buffer` has room for, the terminating 0 included.
/// :returns: The value's units without the 0 when it fit, the units needed with the 0 when it didn't, or 0 with the
///     last error set (`ERROR_ENVVAR_NOT_FOUND` when it isn't set).
#[external("c"), symbol("GetEnvironmentVariableW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_environment_variable(name: @U16, buffer: @U16, size: U32) -> U32

/// The {ProcessError} for the Win32 error code a failed start reported.
/// :param e: The error code.
/// :returns: NotFound, PermissionDenied, OutOfMemory, or InvalidArgument for those errors, else Other.
#target(os: "windows")
private routine spawn_error(e: U32) -> ProcessError
    block entry()
        when e
            2, 3, 267 -> return(ProcessError.NotFound)
            5         -> return(ProcessError.PermissionDenied)
            8, 14     -> return(ProcessError.OutOfMemory)
            123, 87   -> return(ProcessError.InvalidArgument)
            else      -> return(ProcessError.Other)

/// Whether `h` is null or INVALID_HANDLE_VALUE.
/// :param h: The handle to test.
/// :returns: `true` when it holds no usable handle.
#target(os: "windows")
private routine is_invalid(h: Addr) -> Bool
    block entry()
        return(h.is_null().bitor(ptrtoint<Addr, USize>(h).eq(USize.MAX)))

/// Whether two handles are the same value.
/// :param a: One handle.
/// :param b: The other.
/// :returns: `true` when they are equal.
#target(os: "windows")
private routine same(a: Addr, b: Addr) -> Bool
    block entry()
        return(ptrtoint<Addr, USize>(a).eq(ptrtoint<Addr, USize>(b)))

/// Closes `h` unless it holds no usable handle.
/// :param h: The handle, or null or INVALID_HANDLE_VALUE for none.
#target(os: "windows")
private routine close_if_open(h: Addr) -> Void
    block entry()
        branch is_invalid(h)
            ? return()
            : continue
        c_close_handle(h)
        return()

/// `text` as UTF-16 with a 0 after it, in memory from `alloc`.
/// :param text: The UTF-8 text.
/// :param alloc: The allocator for the units.
/// :returns: The units and their count without the 0, or null and 0 when `text` has a NUL or the allocation fails.
#target(os: "windows")
private routine utf16(text: Bytes, alloc: @Allocator) -> (@U16, USize)
    shared units : @U16 = allocate<U16>(text.count().add(1), alloc)

    block entry()
        branch units.is_null()
            ? return({ null, 0 })
            : continue
        n : Option<USize> = encode_utf16(text, units, text.count().add(1))
        when n
            .Present(count) -> return({ units, count })
            .Absent         -> failed()

    block failed()
        deallocate(units, alloc)
        return({ null, 0 })

// -- the command line --------------------------------------------------------------------

/// Whether one of the `n` units at `s` is `a`, `b`, or `c`.
/// :param s: The first unit.
/// :param n: How many units to look at.
/// :param a: One unit to look for.
/// :param b: Another unit to look for.
/// :param c: A third unit to look for.
/// :returns: True when one of them is there.
#target(os: "windows")
private routine has_any(s: @U16, n: USize, a: U16, b: U16, c: U16) -> Bool
    block entry()
        jump look(0)

    block look(i: USize)
        branch i.eq(n)
            ? return(false)
            : continue
        u          : U16  = s.stride(i).load()
        matches_ab : Bool = u.eq(a).bitor(u.eq(b))
        branch matches_ab.bitor(u.eq(c))
            ? return(true)
            : look(i.add(1))

/// Writes one argument at `target` as CommandLineToArgvW reads it back, quoted only when it has to be (empty, or
/// holding a space, a tab, or a quote).
/// :param source: The argument's first UTF-16 unit.
/// :param n: How many units the argument has.
/// :param target: Where it is written, with room for 2 * `n` + 2 units.
/// :returns: The unit just after what was written.
#target(os: "windows")
private routine quote_arg(source: @U16, n: USize, target: @U16) -> @U16
    block entry()
        branch n.eq(0)
            ? empty()
            : continue
        // ' ', '\t', '"'
        branch has_any(source, n, 32, 9, 34)
            ? continue
            : plain()
        // '"', '\\'
        branch has_any(source, n, 34, 92, 34)
            ? escaped()
            : quoted()

    block empty()
        target.store(34)
        target.stride(1).store(34)
        return(target.stride(2))

    block plain()
        target.copy(source, n)
        return(target.stride(n))

    block quoted()
        target.store(34)
        target.stride(1).copy(source, n)
        target.stride(n.add(1)).store(34)
        return(target.stride(n.add(2)))

    // Backslashes before a quote, or before the closing quote, are doubled, and a quote gets a backslash: built
    // backwards, then reversed.
    block escaped()
        target.store(34)
        start : @U16 = target.stride(1)
        jump back(n, start, start, true)

    block back(i: USize, start: @U16, at: @U16, before_quote: Bool)
        branch i.eq(0)
            ? reverse(at, start, at.stride(-1))
            : continue
        u : U16 = source.stride(i.sub(1)).load()
        at.store(u)
        branch before_quote.bitand(u.eq(92))
            ? doubled(i, start, at)
            : continue
        branch u.eq(34)
            ? doubled(i, start, at)
            : back(i.sub(1), start, at.stride(1), false)

    block doubled(i: USize, start: @U16, at: @U16)
        at.stride(1).store(92)
        jump back(i.sub(1), start, at.stride(2), true)

    block reverse(end: @U16, a: @U16, b: @U16)
        branch ptrtoint<@U16, USize>(a).lt(ptrtoint<@U16, USize>(b))
            ? continue
            : close(end)
        t : U16 = a.load()
        a.store(b.load())
        b.store(t)
        jump reverse(end, a.stride(1), b.stride(-1))

    block close(end: @U16)
        end.store(34)
        return(end.stride(1))

/// The program and the arguments as one 0-terminated UTF-16 command line, each quoted by {quote_arg}, in memory from
/// `alloc`.
/// :param program: The program to run.
/// :param args: The arguments, not including the program name.
/// :param arg_count: How many arguments `args` holds.
/// :param alloc: The allocator for the line and the working memory.
/// :returns: The command line, or null when a text has a NUL or an allocation fails.
#target(os: "windows")
private routine command_line(program: Bytes, args: @Bytes, arg_count: USize,
    alloc: @Allocator) -> @U16
    shared at : @@U16 <- uninit

    block entry()
        program_bound : USize = program.count().mul(2)
        jump size(0, program_bound.add(3))

    // A UTF-8 byte count bounds the UTF-16 unit count, so 2 * bytes + 3 units bound an argument and its space.
    block size(i: USize, capacity: USize)
        branch i.eq(arg_count)
            ? made(allocate<U16>(capacity.add(1), alloc))
            : count_arg(i, capacity)

    block count_arg(i: USize, capacity: USize)
        argument : Bytes = args.stride(i).load()
        jump size(i.add(1), capacity.add(argument.count().mul(2)).add(3))

    block made(line: @U16)
        branch line.is_null()
            ? return(null)
            : continue
        line.store_into(at)
        jump append(line, 0)

    // 0 is the program, i the argument i - 1.
    block append(line: @U16, i: USize)
        branch i.gt(arg_count)
            ? terminate(line)
            : continue
        branch i.eq(0)
            ? one(line, i, program)
            : one(line, i, args.stride(i.sub(1)).load())

    block one(line: @U16, i: USize, arg: Bytes)
        units, n = utf16(arg, alloc)
        branch units.is_null()
            ? failed(line)
            : continue
        branch i.eq(0)
            ? quote(line, i, units, n)
            : space(line, i, units, n)

    block space(line: @U16, i: USize, units: @U16, n: USize)
        at.load().store(32)
        at.load().stride(1).store_into(at)
        jump quote(line, i, units, n)

    block quote(line: @U16, i: USize, units: @U16, n: USize)
        end : @U16 = quote_arg(units, n, at.load())
        deallocate(units, alloc)
        end.store_into(at)
        jump append(line, i.add(1))

    block failed(line: @U16)
        deallocate(line, alloc)
        return(null)

    block terminate(line: @U16)
        at.load().store(0)
        return(line)

// -- the environment block ---------------------------------------------------------------

/// The units of a "NAME=VALUE" entry before its '=' (a leading '=' belongs to the name, as in "=C:=C:\\").
/// :param entry: The entry, 0-terminated and not empty.
/// :returns: The name's length in units (the whole entry's when it has no '=').
#target(os: "windows")
private routine key_units(entry: @U16) -> USize
    block entry()
        jump scan(1)

    block scan(i: USize)
        u : U16 = entry.stride(i).load()
        branch u.eq(0).bitor(u.eq(61))
            ? return(i)
            : scan(i.add(1))

/// A UTF-16 unit with ASCII capitals lowered, for comparing environment names the way Windows does (without regard to
/// case).
/// :param u: The unit.
/// :returns: The lowered unit, or `u` when it isn't an ASCII capital.
#target(os: "windows")
private routine ascii_lower(u: U16) -> U16
    block entry()
        branch u.between(65, 90)
            ? return(u.add(32))
            : return(u)

/// The order Windows keeps an environment block in: unit by unit with ASCII capitals lowered, over the whole
/// 0-terminated entry.
/// :param a: One entry.
/// :param b: The other entry.
/// :returns: True when `a` sorts before `b`.
#target(os: "windows")
private routine before(a: @U16, b: @U16) -> Bool
    block entry()
        jump compare(0)

    block compare(i: USize)
        x : U16 = ascii_lower(a.stride(i).load())
        y : U16 = ascii_lower(b.stride(i).load())
        branch x.ne(y)
            ? return(x.lt(y))
            : continue
        branch x.eq(0)
            ? return(false)
            : compare(i.add(1))

/// Whether the entry's name is the `n` units of `name`, ASCII letters in any case.
/// :param entry: A "NAME=VALUE" entry, 0-terminated.
/// :param name: The name's first unit.
/// :param n: How many units the name has.
/// :returns: True when the names match.
#target(os: "windows")
private routine names(entry: @U16, name: @U16, n: USize) -> Bool
    block entry()
        branch key_units(entry).eq(n)
            ? compare(0)
            : return(false)

    block compare(i: USize)
        branch i.eq(n)
            ? return(true)
            : continue
        branch ascii_lower(entry.stride(i).load()).eq(ascii_lower(name.stride(i).load()))
            ? compare(i.add(1))
            : return(false)

/// The units of a 0-terminated string, the 0 not counted.
/// :param s: The string.
/// :returns: Its length in units.
#target(os: "windows")
private routine units_of(s: @U16) -> USize
    block entry()
        return(wide_length(s))

/// The overrides as "NAME=VALUE" UTF-16 strings, in memory from `alloc`.
/// :param options: The environment overrides.
/// :param out: Where the strings go, room for one per override.
/// :param alloc: The allocator for the strings.
/// :returns: True when all were made, false (and the ones made so far freed) when a text has a NUL or an allocation
///     fails.
/// :throws: Crashes with `MemoryAllocationError` when the "NAME=VALUE" text can't be allocated.
#target(os: "windows")
private routine wide_overrides(options: ProcessOptions, out: @@U16, alloc: @Allocator) -> Bool
    block entry()
        jump next(0)

    block next(i: USize)
        branch i.eq(options.env_count)
            ? return(true)
            : continue
        v : EnvVar = options.env.stride(i).load()
        claim named : @Bytes <- Bytes.concat(v.name, "=", alloc)
        claim whole : @Bytes <- Bytes.concat(named.load(), v.value, alloc)
        named.destruct()
        units, n = utf16(whole.load(), alloc)
        whole.destruct()
        branch units.is_null()
            ? undo(i)
            : continue
        out.stride(i).store(units)
        jump next(i.add(1))

    block undo(i: USize)
        branch i.eq(0)
            ? return(false)
            : continue
        copy_slot : @@U16 = out.stride(i.sub(1))
        deallocate(copy_slot.load(), alloc)
        jump undo(i.sub(1))

/// This process's environment with the overrides applied, as a sorted block, in memory from `alloc`.
/// :param options: The environment overrides.
/// :param alloc: The allocator for the block and the working memory.
/// :returns: The UTF-16 environment block, or null when an override has a NUL or an allocation fails.
/// :throws: Crashes with `MemoryAllocationError` when an override's "NAME=VALUE" text can't be allocated.
#target(os: "windows")
private routine env_block(options: ProcessOptions, alloc: @Allocator) -> @U16
    shared own : @@U16 = allocate<@U16>(options.env_count.max(1), alloc)

    block entry()
        branch own.is_null()
            ? finish(null, null)
            : continue
        // A failure has freed the strings made so far, so only the array is left.
        branch wide_overrides(options, own, alloc)
            ? continue
            : finish(null, null)
        parent : @U16 = c_get_environment_strings()
        jump count(parent, parent, 0)

    // How many entries the parent block has: each ends with a 0, and an empty one ends the block.
    block count(parent: @U16, at: @U16, n: USize)
        branch at.is_null()
            ? collect(parent, n)
            : continue
        branch at.load().eq(0)
            ? collect(parent, n)
            : count(parent, at.stride(units_of(at).add(1)), n.add(1))

    block collect(parent: @U16, n: USize)
        all : @@U16 = allocate<@U16>(n.add(options.env_count).max(1), alloc)
        branch all.is_null()
            ? done(parent, null, null)
            : keep(parent, all, parent, 0)

    // The parent's entries no override names.
    block keep(parent: @U16, all: @@U16, at: @U16, k: USize)
        branch at.is_null()
            ? add_own(parent, all, k, 0)
            : continue
        branch at.load().eq(0)
            ? add_own(parent, all, k, 0)
            : continue
        next : @U16 = at.stride(units_of(at).add(1))
        branch is_overridden(at, own, options.env_count)
            ? keep(parent, all, next, k)
            : continue
        all.stride(k).store(at)
        jump keep(parent, all, next, k.add(1))

    block add_own(parent: @U16, all: @@U16, k: USize, j: USize)
        branch j.eq(options.env_count)
            ? sort(parent, all, k.add(options.env_count), 1)
            : continue
        all.stride(k.add(j)).store(own.stride(j).load())
        jump add_own(parent, all, k, j.add(1))

    // Insertion sort.
    block sort(parent: @U16, all: @@U16, total: USize, i: USize)
        branch i.ge(total)
            ? measure(parent, all, total, 0, 1)
            : sink(parent, all, total, i, i)

    block sink(parent: @U16, all: @@U16, total: USize, i: USize, j: USize)
        branch j.eq(0)
            ? sort(parent, all, total, i.add(1))
            : continue
        a : @U16 = all.stride(j.sub(1)).load()
        b : @U16 = all.stride(j).load()
        branch before(b, a)
            ? continue
            : sort(parent, all, total, i.add(1))
        all.stride(j.sub(1)).store(b)
        all.stride(j).store(a)
        jump sink(parent, all, total, i, j.sub(1))

    block measure(parent: @U16, all: @@U16, total: USize, i: USize, units: USize)
        branch i.eq(total)
            ? build(parent, all, total, allocate<U16>(units, alloc))
            : measure(parent, all, total, i.add(1),
                units.add(units_of(all.stride(i).load())).add(1))

    block build(parent: @U16, all: @@U16, total: USize, block_units: @U16)
        branch block_units.is_null()
            ? done(parent, all, null)
            : place(parent, all, total, block_units, block_units, 0)

    block place(parent: @U16, all: @@U16, total: USize, block_units: @U16, at: @U16, i: USize)
        branch i.eq(total)
            ? terminate(parent, all, block_units, at)
            : continue
        entry : @U16  = all.stride(i).load()
        n     : USize = units_of(entry).add(1)
        at.copy(entry, n)
        jump place(parent, all, total, block_units, at.stride(n), i.add(1))

    block terminate(parent: @U16, all: @@U16, block_units: @U16, at: @U16)
        at.store(0)
        jump done(parent, all, block_units)

    block done(parent: @U16, all: @@U16, result: @U16)
        branch parent.is_null()
            ? continue
            : free_parent(all, result, parent)
        jump release(all, result, 0)

    block free_parent(all: @@U16, result: @U16, parent: @U16)
        c_free_environment_strings(parent)
        jump release(all, result, 0)

    block release(all: @@U16, result: @U16, j: USize)
        branch j.eq(options.env_count)
            ? finish(result, all)
            : continue
        own_slot : @@U16 = own.stride(j)
        deallocate(own_slot.load(), alloc)
        jump release(all, result, j.add(1))

    // The arrays, each when it was made: own is null only when its allocation failed, and all is then null too.
    block finish(result: @U16, all: @@U16)
        branch own.is_null()
            ? return(result)
            : continue
        deallocate(own, alloc)
        branch all.is_null()
            ? return(result)
            : continue
        deallocate(all, alloc)
        return(result)

/// Whether one of the `m` overrides ("NAME=VALUE" each) names the parent entry's variable, ASCII letters in any case.
/// :param entry: A "NAME=VALUE" entry of this process's environment.
/// :param own: The overrides as UTF-16 strings.
/// :param m: How many overrides `own` holds.
/// :returns: True when an override has the same name.
#target(os: "windows")
private routine is_overridden(entry: @U16, own: @@U16, m: USize) -> Bool
    block entry()
        jump look(0)

    block look(j: USize)
        branch j.eq(m)
            ? return(false)
            : continue
        o : @U16 = own.stride(j).load()
        branch names(entry, o, key_units(o))
            ? return(true)
            : look(j.add(1))

// -- running -----------------------------------------------------------------------------

/// What a helper thread reads standard error into: a buffer on the malloc heap, safe to fill from another thread.
#target(os: "windows")
private record PipeReader
    pipe   : Addr
    buffer : CaptureBuffer

/// The handles a run uses: null where it has none.
#target(os: "windows")
private record Handles
    out_r  : Addr
    out_w  : Addr
    err_r  : Addr
    err_w  : Addr
    input  : Addr  // what the child gets as each standard handle (owned here: closed after the start)
    output : Addr
    error  : Addr
    device : Addr  // the null device

/// No handles at all: what a run starts from, so closing them is right on every path.
/// :returns: The {Handles} with every handle null.
#target(os: "windows")
private routine Handles.empty() -> Self
    block entry()
        return(Self { out_r: null, out_w: null, err_r: null, err_w: null, input: null, output: null,
            error: null, device: null })

/// Reads the pipe to its end into the reader's buffer, from the malloc heap.
/// :param r: The pipe and the buffer.
#target(os: "windows")
private routine read_pipe(r: @PipeReader) -> Void
    shared heap : @Allocator <- make_heap_allocator()
    shared n    : @U32       <- 0

    block entry()
        claim chunk : @Array<Byte, 4096> <- uninit
        jump next(chunk.to<@Byte>())

    block next(chunk: @Byte)
        ok : Bool = c_read_file(r.pipe.load(), chunk, 4096, n, null).ne(0)
        branch ok.bitand(n.load().gt(0))
            ? continue
            : return()
        r.buffer.append(chunk, n.load().to<USize>(), heap)
        jump next(chunk)

/// Closes this process's copies of the handles the child was given (its ends of the pipes, the null device, and any
/// standard handle duplicated only for it), so end-of-file reaches the parent when the child exits.
#target(os: "windows")
private routine Handles.close_child_side(self: @Self) -> Void
    block entry()
        close_if_open(self.out_w.load())
        close_if_open(self.err_w.load())
        close_if_open(self.device.load())
        own_input : Bool = same(self.input.load(), self.device.load()).bitnot()
        branch own_input
            ? continue
            : outputs()
        close_if_open(self.input.load())
        jump outputs()

    // The pipe ends and the device were closed above. The duplicates of this process's handles go here.
    block outputs()
        o : Addr = self.output.load()
        branch same(o, self.out_w.load()).bitor(same(o, self.device.load()))
            ? errors()
            : continue
        close_if_open(o)
        jump errors()

    block errors()
        e : Addr = self.error.load()
        branch same(e, self.err_w.load()).bitor(same(e, self.device.load()))
            ? return()
            : continue
        close_if_open(e)
        return()

/// An inheritable duplicate of one of this process's standard handles.
/// :param which: `STD_INPUT_HANDLE`, `STD_OUTPUT_HANDLE`, or `STD_ERROR_HANDLE`.
/// :returns: The duplicate, or null when there is no such handle or it can't be duplicated.
#target(os: "windows")
private routine inherited(which: U32) -> Addr
    block entry()
        h : Addr = c_get_std_handle(which)
        branch is_invalid(h)
            ? return(null)
            : continue
        claim copy : @Addr <- null
        me : Addr = c_get_current_process()
        // DUPLICATE_SAME_ACCESS
        branch c_duplicate_handle(me, h, me, copy, 0, 1, 2).ne(0)
            ? return(copy.load())
            : return(null)

/// Makes the handles `options` call for: the null device when a stream is the null device, a pipe for each captured
/// stream (the parent's end not inheritable), and the three handles the child gets.
/// :param options: The standard streams.
/// :param sa: The security attributes that make the child's handles inheritable.
/// :returns: True when all were made. What was made before a failure is kept for closing.
#target(os: "windows")
private routine Handles.make(self: @Self, options: ProcessOptions, sa: @SecurityAttributes) -> Bool
    block entry()
        self.store(Handles.empty())
        null_in  : Bool = options.stdin.eq(InputMode.Null)
        null_out : Bool = options.stdout.eq(OutputMode.Null).bitor(options.stderr.eq(OutputMode.Null))
        branch null_in.bitor(null_out)
            ? continue
            : pipes()
        claim name : @Array<U16, 4> <- { 78, 85, 76, 0 }
        // GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, OPEN_EXISTING
        device : Addr = c_create_file(name.to<@U16>(), 0xC0000000, 3, sa, 3, 0, null)
        branch is_invalid(device)
            ? return(false)
            : continue
        self.device.store(device)
        jump pipes()

    block pipes()
        branch options.stdout.eq(OutputMode.Capture)
            ? continue
            : error_pipe()
        branch c_create_pipe(self.out_r, self.out_w, sa, 0).ne(0)
            ? continue
            : return(false)
        // HANDLE_FLAG_INHERIT off for the parent's end
        c_set_handle_information(self.out_r.load(), 1, 0)
        jump error_pipe()

    block error_pipe()
        branch options.stderr.eq(OutputMode.Capture)
            ? continue
            : standard()
        branch c_create_pipe(self.err_r, self.err_w, sa, 0).ne(0)
            ? continue
            : return(false)
        c_set_handle_information(self.err_r.load(), 1, 0)
        jump standard()

    // STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
    block standard()
        self.input.store(input_handle(options.stdin, self.device.load()))
        self.output.store(output_handle(options.stdout, self.out_w.load(), self.device.load(),
            0xFFFFFFF5))
        self.error.store(output_handle(options.stderr, self.err_w.load(), self.device.load(),
            0xFFFFFFF4))
        return(true)

/// The child's standard input: the null device, or a duplicate of this process's.
/// :param mode: What the child's standard input is.
/// :param device: The null device, for `Null`.
/// :returns: The handle, or null when this process's can't be duplicated.
#target(os: "windows")
private routine input_handle(mode: InputMode, device: Addr) -> Addr
    block entry()
        when mode
            InputMode.Null    -> return(device)
            InputMode.Inherit -> return(inherited(0xFFFFFFF6))

/// One of the child's output handles: the pipe's write end, the null device, or a duplicate of this process's.
/// :param mode: What becomes of the stream.
/// :param pipe: The pipe's write end, for `Capture`.
/// :param device: The null device, for `Null`.
/// :param which: `STD_OUTPUT_HANDLE` or `STD_ERROR_HANDLE`, for `Inherit`.
/// :returns: The handle, or null when this process's can't be duplicated.
#target(os: "windows")
private routine output_handle(mode: OutputMode, pipe: Addr, device: Addr, which: U32) -> Addr
    block entry()
        when mode
            OutputMode.Capture -> return(pipe)
            OutputMode.Null    -> return(device)
            OutputMode.Inherit -> return(inherited(which))

/// Starts `program` with CreateProcessW, waits for it, and returns how it ended and what it captured. The arguments
/// are joined into one quoted command line, and when both streams are captured, standard error is read on a helper
/// thread so neither pipe fills while the other is read. This is the Windows half. Linux and macOS use fork and
/// execvp.
/// :param program: The program to run.
/// :param args: The arguments, not including the program name.
/// :param arg_count: How many arguments `args` holds.
/// :param options: The directory, environment overrides, and standard streams.
/// :param alloc: The allocator for the captured output and the working memory.
/// :returns: The {ProcessOutput}, or Failure with a {ProcessError} (InvalidArgument for a NUL in the command, the
/// directory, or a variable).
/// :throws: Crashes with `MemoryAllocationError` when an environment override's text can't be allocated.
#target(os: "windows")
routine run_process_result(program: Bytes, args: @Bytes, arg_count: USize, options: ProcessOptions,
    alloc: @Allocator) -> Result<ProcessOutput, ProcessError>
    shared line : @U16                = command_line(program, args, arg_count, alloc)
    shared env  : @@U16               <- null
    shared h    : @Handles            <- Handles.empty()
    shared pi   : @ProcessInformation <- ProcessInformation { process: null, thread: null,
        process_id: 0, thread_id: 0 }

    block entry()
        branch line.is_null()
            ? finish(.Failure(ProcessError.InvalidArgument))
            : continue
        claim directory : @Array<U16, PATH_CAPACITY> <- uninit
        when options.directory
            .Present(d) -> continue
            .Absent     -> environment(null)
        units : @U16          = directory.to<@U16>()
        n     : Option<USize> = encode_utf16(d, units, PATH_CAPACITY)
        branch n.is_present()
            ? environment(units)
            : finish(.Failure(ProcessError.InvalidArgument))

    block environment(directory: @U16)
        branch options.env_count.eq(0)
            ? handles(directory)
            : continue
        block_units : @U16 = env_block(options, alloc)
        block_units.store_into(env)
        branch block_units.is_null()
            ? finish(.Failure(ProcessError.InvalidArgument))
            : handles(directory)

    block handles(directory: @U16)
        claim sa : @SecurityAttributes <- SecurityAttributes {
            length: sizeof<SecurityAttributes>().to<U32>(), descriptor: null, inherit_handle: 1 }
        branch h.make(options, sa)
            ? continue
            : not_started(c_get_last_error())
        // STARTF_USESTDHANDLES
        claim si : @StartupInfo <- StartupInfo { cb: sizeof<StartupInfo>().to<U32>(),
            reserved: null, desktop: null, title: null, x: 0, y: 0, x_size: 0, y_size: 0,
            x_count_chars: 0, y_count_chars: 0, fill_attribute: 0, flags: 0x100, show_window: 0,
            cb_reserved2: 0, reserved2: null, std_input: h.input.load(),
            std_output: h.output.load(), std_error: h.error.load() }
        // CREATE_UNICODE_ENVIRONMENT
        made : Bool = c_create_process(null, line, null, null, 1, 0x400, env.load(), directory, si,
            pi).ne(0)
        e    : U32  = c_get_last_error()
        h.close_child_side()
        branch made
            ? started()
            : finish(.Failure(spawn_error(e)))

    // The handles were partly made: the child's side of what there is closes here, the parent's side in finish.
    block not_started(e: U32)
        h.close_child_side()
        jump finish(.Failure(spawn_error(e)))

    block started()
        claim out : @CaptureBuffer <- CaptureBuffer.empty()
        claim err : @PipeReader    <- PipeReader { pipe: h.err_r.load(),
            buffer: CaptureBuffer.empty() }
        read_both(h.out_r.load(), out, err, alloc)
        // INFINITE
        c_wait_for_single_object(pi.process.load(), U32.MAX)
        claim code : @U32 <- 0
        c_get_exit_code_process(pi.process.load(), code)
        error_text : Bytes = moved(err.buffer.load(), alloc)
        jump finish(.Success(ProcessOutput { status: ExitStatus.Exited(code.load().to_wrap<S32>()),
            stdout: out.owned(alloc), stderr: error_text }))

    // The parent's ends of the pipes, the process and thread handles, the command line, and the environment block:
    // each one this run got.
    block finish(result: Result<ProcessOutput, ProcessError>)
        close_if_open(h.out_r.load())
        close_if_open(h.err_r.load())
        close_if_open(pi.thread.load())
        close_if_open(pi.process.load())
        free_texts(line, env.load(), alloc)
        return(result)

/// Frees the command line and the environment block, each when there is one.
/// :param line: The command line text, or null.
/// :param env: The environment block, or null.
/// :param alloc: The allocator they came from.
#target(os: "windows")
private routine free_texts(line: @U16, env: @U16, alloc: @Allocator) -> Void
    block entry()
        branch line.is_null()
            ? environment()
            : continue
        deallocate(line, alloc)
        jump environment()

    block environment()
        branch env.is_null()
            ? return()
            : continue
        deallocate(env, alloc)
        return()

/// Reads standard output here and standard error on a helper thread when both are captured, and one alone here.
/// :param out_pipe: The read end of the standard output pipe, or null.
/// :param out: The buffer standard output goes into.
/// :param err: The standard error pipe (null when not captured) and the malloc-heap buffer it goes into.
/// :param alloc: The allocator `out` grows from.
#target(os: "windows")
private routine read_both(out_pipe: Addr, out: @CaptureBuffer, err: @PipeReader,
    alloc: @Allocator) -> Void
    block entry()
        has_out : Bool = out_pipe.is_not_null()
        has_err : Bool = err.pipe.load().is_not_null()
        branch has_out.bitand(has_err)
            ? both()
            : continue
        branch has_err
            ? err_only()
            : continue
        branch has_out
            ? out_only()
            : return()

    block both()
        claim heap : @Allocator <- make_heap_allocator()
        helper : Thread = Thread.spawn(read_pipe.to<Callable>(), err, heap)
        read_into(out_pipe, out, alloc)
        helper.join()
        return()

    block err_only()
        read_pipe(err)
        return()

    block out_only()
        read_into(out_pipe, out, alloc)
        return()

/// Reads a pipe to its end into `buffer`, from `alloc`.
/// :param pipe: The pipe's read end.
/// :param buffer: The buffer the bytes go into.
/// :param alloc: The allocator `buffer` grows from.
#target(os: "windows")
private routine read_into(pipe: Addr, buffer: @CaptureBuffer, alloc: @Allocator) -> Void
    shared n : @U32 <- 0

    block entry()
        claim chunk : @Array<Byte, 4096> <- uninit
        jump next(chunk.to<@Byte>())

    block next(chunk: @Byte)
        ok : Bool = c_read_file(pipe, chunk, 4096, n, null).ne(0)
        branch ok.bitand(n.load().gt(0))
            ? continue
            : return()
        buffer.append(chunk, n.load().to<USize>(), alloc)
        jump next(chunk)

/// What a helper thread captured on the malloc heap, copied into `alloc` (and the heap copy given back).
/// :param b: The buffer filled on the malloc heap.
/// :param alloc: The allocator for the copy.
/// :returns: The captured bytes, carrying `alloc` (empty when nothing was captured or the copy couldn't be allocated).
#target(os: "windows")
private routine moved(b: CaptureBuffer, alloc: @Allocator) -> Bytes
    block entry()
        branch b.data.is_null()
            ? return(Bytes { data: null, count: 0, alloc: alloc })
            : continue
        claim heap   : @Allocator     <- make_heap_allocator()
        claim copied : @CaptureBuffer <- CaptureBuffer.empty()
        copied.append(b.data, b.count, alloc)
        deallocate(b.data, heap)
        return(copied.owned(alloc))

// -- the environment ---------------------------------------------------------------------

/// The value of the environment variable `name`, in memory from `alloc`. Release it with `destruct()`.
/// :param name: The variable's name.
/// :param alloc: The allocator for the value.
/// :returns: The value's bytes (UTF-8).
/// :absent: When the variable isn't set, `name` doesn't fit in 256 UTF-16 units or holds a NUL, or the value can't be
///     read or allocated.
#target(os: "windows")
routine env_var(name: Bytes, alloc: @Allocator) -> Option<Bytes>
    shared units : @@U16 <- null

    block entry()
        claim key : @Array<U16, 256> <- uninit
        n : Option<USize> = encode_utf16(name, key.to<@U16>(), 256)
        branch n.is_present()
            ? continue
            : finish(.Absent)
        c_set_last_error(0)
        need : U32 = c_get_environment_variable(key.to<@U16>(), null, 0)
        // ERROR_ENVVAR_NOT_FOUND
        branch need.eq(0).bitand(c_get_last_error().eq(203))
            ? finish(.Absent)
            : continue
        branch need.eq(0)
            ? finish(.Present(Bytes { data: null, count: 0, alloc: alloc }))
            : continue
        made : @U16 = allocate<U16>(need.to<USize>(), alloc)
        made.store_into(units)
        branch made.is_null()
            ? finish(.Absent)
            : continue
        got : U32 = c_get_environment_variable(key.to<@U16>(), made, need)
        branch got.eq(0).bitor(got.ge(need))
            ? finish(.Absent)
            : continue
        text : Result<Bytes, FsError> = owned_wide(made, got.to<USize>(), alloc)
        when text
            .Success(t) -> finish(.Present(t))
            .Failure    -> finish(.Absent)

    // The UTF-16 value, when there is one: the UTF-8 copy is what goes back.
    block finish(value: Option<Bytes>)
        held : @U16 = units.load()
        branch held.is_null()
            ? return(value)
            : continue
        deallocate(held, alloc)
        return(value)
