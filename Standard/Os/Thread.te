# Tessera stdlib: threads
#
# A thread is a ticket a ThreadManager hands out: `get_thread[T]()` takes one from DEFAULT_THREADS, the hosted
# manager, whose threads are the operating system's, and `get_thread[T](manager)` from a manager of the program's own.
# The ticket runs one piece of work at a time, in the flow of Work.te: `put_work` starts it, `check_finished`
# looks, `wait_finished` waits, `retrieve` takes the result, and `give_back` hands the thread back to its manager,
# which keeps it asleep for the next ticket instead of ending it. Until then the same ticket takes more work, one
# piece after another.
#
# A ticket given back with its work still running, or destructed before it is given back, crashes: no work runs on
# that nobody looks at, and nothing it uses goes away under it. Work with no result is a `Thread[None]`, waited for
# and given back the same way. Before each piece of work the thread puts every `#threadlocal` global back to its
# starting value, so no work sees what the one before left.

module Standard/Os

import Standard/Alloc

### The hosted thread manager: the operating system's threads, with the work blocks from DEFAULT_HEAP. Ready before
### `start` runs.
@target(os: not "none")
global DEFAULT_THREADS: @ThreadManager <- (launch_fn: os_launch_fn.to[Callable](), state: null, lock: (state: 0), idle: null, alloc: DEFAULT_HEAP)

### A ticket for a thread, from {get_thread}: it runs one piece of work at a time, whose result is a `T` (`Void` for
### none), until {Thread[T].give_back}.
### :typeparam T: The type of the work's result.
record Thread[T]
needs T: typename
    worker: @ThreadWorker
    ### The ticket's number: the worker's until the ticket is given back.
    issued: U64

### A thread a manager hands out: its work and, while it waits for the next ticket, its place among the idle ones.
record ThreadWorker
    slot: WorkSlot
    ### The next idle worker of the manager.
    next: @ThreadWorker
    manager: @ThreadManager

### Hands out threads. Its routine starts a thread, and the threads it started and got back wait among the idle ones
### for the next ticket. `DEFAULT_THREADS` is the hosted one, and a program without an operating system makes its own.
record ThreadManager
    ### Starts a thread that runs `(entry, arg)` and ends when it returns, given `state`: false when none starts.
    launch_fn: Callable[(Callable[(Addr,), None], Addr, Addr), Bool]
    ### What `launch_fn` is given.
    state: Addr
    ### Guards `idle`.
    lock: ExclusiveLock
    ### The threads given back, asleep until a ticket takes one.
    idle: @ThreadWorker
    ### Where the workers and the work blocks come from.
    alloc: @MemoryManager

### Makes a `Thread` from its fields.
### :param worker: Its `worker`.
### :param issued: Its `issued`.
### :returns: The new value.
routine Thread[T].construct(worker: @ThreadWorker, issued: U64) -> Me
needs T: typename
    return Me(worker, issued)

### Crashes when the ticket wasn't given back: its thread would be lost, and its work might still run.
### :throws: Crashes with `TicketNotGivenBackError` for a ticket that still holds its thread.
@track_caller
routine Thread[T].destruct(me: @Me) -> None
needs T: typename
    worker: @ThreadWorker = me.worker.peek()
    if worker.is_null()
        return
    if worker.slot.issued.peek() == me.issued.peek()
        crash(name: "TicketNotGivenBackError",
            message: "This thread ticket was never given back: wait_finished() and give_back() before it goes.")
    else
        return

### Makes a `ThreadWorker` from its fields.
### :param slot: Its `slot`.
### :param next: Its `next`.
### :param manager: Its `manager`.
### :returns: The new value.
routine ThreadWorker.construct(slot: WorkSlot, next: @Me, manager: @ThreadManager) -> Me
    return Me(slot, next, manager)

### Releases the block of its last work.
routine ThreadWorker.destruct(me: @Me) -> None
    me.slot.destruct()
    return

### A manager whose threads `launch_fn` starts.
### :param launch_fn: Starts a thread that runs `(entry, arg)` and ends when it returns, given `state`: false when none
###     starts.
### :param state: What `launch_fn` is given.
### :param alloc: Where the workers and the work blocks come from.
### :returns: The manager, with no threads yet.
routine ThreadManager.construct(launch_fn: Callable[(Callable[(Addr,), None], Addr, Addr), Bool],
    state: Addr, alloc: @MemoryManager) -> Me
    return Me(launch_fn, state, lock: .construct(), idle: null, alloc)

### A manager of the operating system's threads, with the workers and the work blocks from `alloc`.
### :param alloc: Where the workers and the work blocks come from.
### :returns: The manager, with no threads yet.
@target(os: not "none")
routine ThreadManager.construct(alloc: @MemoryManager) -> Me
    return Me(launch_fn: os_launch_fn.to[Callable](), state: null, lock: .construct(), idle: null,
        alloc)

### Ends the idle threads. Every ticket goes back first: a ticket given back to a manager that is gone reaches memory
### that is gone, and its thread never ends.
routine ThreadManager.destruct(me: @Me) -> None
    me.lock.lock()

    while true
        worker2: @ThreadWorker = me.idle.peek()
        if worker2.is_null()
            break
        else
            me.idle.poke(worker2.next.peek())
            worker2.slot.state.poke_atomic(TICKET_QUIT)
            wake_all(worker2.slot.state)
            continue
    me.lock.unlock()
    return

### A ticket for a thread of DEFAULT_THREADS, the operating system's.
### :typeparam T: The type of the work's result, `Void` for none.
### :returns: The ticket, with no work yet.
### :throws: Crashes with `TaskSpawnError` when the operating system starts no thread, and with
###     `MemoryAllocationError` when there is no memory for it.
@target(os: not "none")
@track_caller
routine get_thread[T]() -> Thread[T]
needs T: typename
    return get_thread[T](manager: DEFAULT_THREADS)

### A ticket for a thread of `manager`: one it got back, or a new one.
### :typeparam T: The type of the work's result, `Void` for none.
### :param manager: The manager.
### :returns: The ticket, with no work yet.
### :throws: Crashes with `TaskSpawnError` when the manager starts no thread, and with `MemoryAllocationError` when
###     there is no memory for it.
@track_caller
routine get_thread[T](manager: @ThreadManager) -> Thread[T]
needs T: typename
    worker: @ThreadWorker = manager.take_worker()
    return Thread[T](worker, issued: worker.slot.issued.peek())

### Starts a thread that runs `entry(arg)` and ends when it returns, which nobody waits for: for a runtime's own
### threads that run as long as the program does. Work that ends is a ticket's (`get_thread`), so its end is seen.
### :typeparam T: The type of the state the thread works on.
### :param entry: The routine.
### :param arg: The state it works on, which must outlive the thread.
### :throws: Crashes with `TaskSpawnError` when no thread starts.
@track_caller
@expensive("starts a thread")
routine ThreadManager.launch_unwatched[T](me: @Me, entry: Callable[(@T,), None], arg: @T) -> None
needs T: typename
    erased: Callable[(Addr,), None] = bitcast(entry)
    state: Addr = arg
    if me.launch_fn.peek().call(erased, state, me.state.peek())
        return
    else
        crash_task_spawn()

### An idle worker, or a new one on a thread of its own.
### :returns: The worker, with an empty slot.
@track_caller
secret routine ThreadManager.take_worker(me: @Me) -> @ThreadWorker
    me.lock.lock()
    idle: @ThreadWorker = me.idle.peek()
    if idle.is_null()
        me.lock.unlock()
        alloc: @MemoryManager = me.alloc.peek()
        worker: @ThreadWorker = allocate[ThreadWorker](count: 1, alloc)
        if worker.is_null()
            crash_allocation()
        worker.poke(ThreadWorker(slot: .construct(alloc), next: null, manager: me))
        place: Addr = worker
        if me.launch_fn.peek().call(worker_main.to[Callable](), place, me.state.peek())
            return worker
        else
            deallocate(data: worker, alloc)
            crash_task_spawn()
    else
        me.idle.poke(idle.next.peek())
        me.lock.unlock()
        idle.next.poke(null)
        idle.slot.state.poke_atomic(TICKET_EMPTY)
        return idle

### A worker thread's loop: runs each piece of work put on its slot, and sleeps on the slot's state in between, until
### its manager tells it to end.
### :param raw: The {ThreadWorker}.
@target(os: not "none")
secret routine worker_main(raw: Addr) -> None
    local worker: @ThreadWorker = raw.to[@ThreadWorker]()

    while true
        state2: U32 = worker.slot.state.peek_atomic()
        if state2 == TICKET_RUNNING
            # Every piece of work starts from the thread-local values a new thread has.
            reset_thread_locals()
            RUNNING_WORK.poke(worker.slot)
            runner: Callable[(Addr,), None] = worker.slot.runner.peek()
            runner.call(worker.slot.work.peek())
            cleanup: Callable[(), None] = THREAD_CLEANUP.peek()
            if cleanup.addr().is_null()
                RUNNING_WORK.poke(null)
                worker.slot.complete()
                continue
            else
                cleanup.call()
                RUNNING_WORK.poke(null)
                worker.slot.complete()
                continue
        else if state2 == TICKET_QUIT
            break
        else
            wait_on(at: worker.slot.state, expected: state2)
            continue
    alloc: @MemoryManager = worker.slot.alloc.peek()
    drop worker.slot
    deallocate(data: worker, alloc)
    return

### Puts every `#threadlocal` global of the program back to its starting value on this thread: a thread worker does it
### before each ticket's work.
@external("llvm")
@template("call void @tessera.reset_thread_locals()")
@target(os: not "none")
routine reset_thread_locals() -> None

### The slot the ticket's work lives in, for code that waits on several tickets at once.
### :returns: The slot.
### :throws: Crashes with `TicketGivenBackError` for a ticket given back.
@track_caller
routine Thread[T].work_slot(me: Me) -> @WorkSlot
needs T: typename
    worker: @ThreadWorker = me.worker
    worker.slot.check_ticket(me.issued)
    return worker.slot

### Starts the work in `work`, run by `runner`.
### :param runner: Runs the work.
### :param work: Its block.
@track_caller
secret routine Thread[T].start(me: Me, runner: Callable[(Addr,), None], work: Addr) -> None
needs T: typename
    me.work_slot().put(runner, work)
    return

### Starts `entry` on the ticket. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[T].put_work(me: Me, entry: Callable[(), T]) -> None
needs T: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work0[T](entry, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[T].put_work[A](me: Me, entry: Callable[(A,), T], args: A) -> None
needs T: typename, A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work1[T, A](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[T].put_work[A, B](me: Me, entry: Callable[(A, B), T], args: (A, B)) -> None
needs T: typename, A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work2[T, A, B](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[T].put_work[A, B, C](me: Me, entry: Callable[(A, B, C), T], args: (A, B, C)) -> None
needs T: typename, A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work3[T, A, B, C](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[T].put_work[A, B, C, D](me: Me, entry: Callable[(A, B, C, D), T],
    args: (A, B, C, D)) -> None
needs T: typename, A: typename, B: typename, C: typename, D: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_work4[T, A, B, C, D](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[None].put_work(me: Me, entry: Callable[(), None]) -> None
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork0(entry, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its argument.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[None].put_work[A](me: Me, entry: Callable[(A,), None], args: A) -> None
needs A: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork1[A](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[None].put_work[A, B](me: Me, entry: Callable[(A, B), None], args: (A, B)) -> None
needs A: typename, B: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork2[A, B](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[None].put_work[A, B, C](me: Me, entry: Callable[(A, B, C), None],
    args: (A, B, C)) -> None
needs A: typename, B: typename, C: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork3[A, B, C](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Starts `entry` on `args` on the ticket, a routine with no result. It runs from here on.
### :param entry: The routine.
### :param args: Its arguments, in a tuple.
### :throws: Crashes with `TicketBusyError` while the last work runs, with `TicketGivenBackError` for a ticket
###     given back, and with `MemoryAllocationError` when the manager has no memory for the work.
@track_caller
routine Thread[None].put_work[A, B, C, D](me: Me, entry: Callable[(A, B, C, D), None],
    args: (A, B, C, D)) -> None
needs A: typename, B: typename, C: typename, D: typename
    slot: @WorkSlot = me.work_slot()
    slot.check_free()
    runner, work = make_voidwork4[A, B, C, D](entry, args, alloc: slot.alloc.peek())
    me.start(runner, work)
    return

### Whether the work has finished, without waiting: true once it has, and for a ticket with no work.
### :returns: True unless the work runs.
@track_caller
routine Thread[T].check_finished(me: Me) -> Bool
needs T: typename
    return me.work_slot().is_finished()

### Waits until the work has finished. Inside a fiber only the fiber waits: its thread goes on with the other fibers,
### and the thread that finishes the work wakes it.
@target(os: not "none")
@track_caller
routine Thread[T].wait_finished(me: Me) -> None
needs T: typename
    me.work_slot().wait()
    return

### Waits until the work has finished or `ns` nanoseconds have passed, whichever comes first.
### :param ns: The longest wait, in nanoseconds.
### :returns: True when the work has finished, false when the time ran out first.
@target(os: not "none")
@track_caller
routine Thread[T].wait_finished_for(me: Me, ns: U64) -> Bool
needs T: typename
    return me.work_slot().wait_until(deadline: monotonic_ns() +^ ns, cancellable: false)

### Waits until the work has finished, or until the work that waits is asked to stop with `cancel()`.
### :returns: `Unit` when the work has finished, `CancelRequested` when the waiting work was cancelled first.
@target(os: not "none")
@track_caller
routine Thread[T].wait_finished_result(me: Me) -> Result[None, CancelRequested]
needs T: typename
    if me.work_slot().wait_until(deadline: U64.MAX, cancellable: true)
        return None()
    else
        return CancelRequested()

### The finished work's result.
### :returns: The result.
### :throws: Crashes with `TicketBusyError` while the work runs, with `NoWorkError` when there was none, and with
###     `CancelledWorkError` when it was cancelled (`retrieve_result` tells that apart).
@track_caller
routine Thread[T].retrieve(me: Me) -> T
needs T: typename
    slot: @WorkSlot = me.work_slot()
    place: @T = slot.result_place[T]()
    if slot.is_cancelled()
        crash(name: "CancelledWorkError",
            message: "This ticket's work was cancelled, so its result may be cut short: retrieve_result() tells a cancelled one apart.")
    else
        return place.peek()

### Gives nothing: work with no result. It checks that the work has finished and wasn't cancelled.
### :throws: Crashes with `TicketBusyError` while the work runs, with `NoWorkError` when there was none, and with
###     `CancelledWorkError` when it was cancelled.
@track_caller
routine Thread[None].retrieve(me: Me) -> None
    slot: @WorkSlot = me.work_slot()
    slot.result_place[Byte]()
    if slot.is_cancelled()
        crash(name: "CancelledWorkError",
            message: "This ticket's work was cancelled, so it may have stopped short: retrieve_result() tells a cancelled one apart.")
    else
        return

### The finished work's result, or `CancelRequested` when `cancel()` asked it to stop before it finished.
### :returns: The result or `CancelRequested`.
### :throws: Crashes with `TicketBusyError` while the work runs, and with `NoWorkError` when there was none.
@track_caller
routine Thread[T].retrieve_result(me: Me) -> Result[T, CancelRequested]
needs T: typename
    slot: @WorkSlot = me.work_slot()
    place: @T = slot.result_place[T]()
    if slot.is_cancelled()
        return CancelRequested()
    else
        return place.peek()

### Asks the work to stop: `cancel_requested()` turns true inside it, and the work stops where it looks.
@track_caller
routine Thread[T].cancel(me: Me) -> None
needs T: typename
    me.work_slot().request_cancel()
    return

### Hands the thread back to its manager, which keeps it asleep for the next ticket. The ticket is over.
### :throws: Crashes with `TicketBusyError` while the work runs, and with `TicketGivenBackError` for a ticket given
###     back already.
@track_caller
routine Thread[T].give_back(me: Me) -> None
needs T: typename
    me.work_slot().give_back()
    worker: @ThreadWorker = me.worker
    manager: @ThreadManager = worker.manager.peek()
    manager.lock.lock()
    worker.next.poke(manager.idle.peek())
    manager.idle.poke(worker)
    manager.lock.unlock()
    return

# -- the hosted manager -----------------------------------------------------------------------------------------

### What a new operating system thread starts with.
secret record ThreadStart
    entry: Callable[(Addr,), None]
    arg: Addr

### Makes a `ThreadStart` from its fields.
### :param entry: Its `entry`.
### :param arg: Its `arg`.
### :returns: The new value.
secret routine ThreadStart.construct(entry: Callable[(Addr,), None], arg: Addr) -> Me
    return Me(entry, arg)

### Releases nothing: a `ThreadStart` holds no memory of its own.
secret routine ThreadStart.destruct(me: @Me) -> None
    return

### Every new operating system thread's first Tessera routine, whatever the system's entry signature: frees the start
### record, then calls the entry.
### :param raw: The {ThreadStart} record.
@target(os: not "none")
secret routine thread_body(raw: Addr) -> None
    start: @ThreadStart = raw.to[@ThreadStart]()
    entry: Callable[(Addr,), None] = start.entry.peek()
    arg: Addr = start.arg.peek()
    deallocate(data: start, alloc: DEFAULT_HEAP)
    fault_stack: Addr = give_fault_stack()
    entry.call(arg)
    release_fault_stack(fault_stack)
    return

### The start record of a new thread, from DEFAULT_HEAP, or null when there is no memory for it.
### :param entry: The routine the thread runs.
### :param arg: What it is given.
### :returns: The record, or null.
@target(os: not "none")
secret routine thread_start(entry: Callable[(Addr,), None], arg: Addr) -> @ThreadStart
    start: @ThreadStart = allocate[ThreadStart](count: 1, alloc: DEFAULT_HEAP)
    if start.is_null()
        return null
    start.poke(ThreadStart(entry, arg))
    return start

# -- POSIX -------------------------------------------------------------------------------------------------------

### Binds the C `pthread_create` function, which starts a thread.
### :param thread: Where the new thread's id goes.
### :param attr: The thread attributes, or null for the defaults.
### :param start: The routine the thread runs.
### :param arg: What `start` is called with.
### :returns: 0 on success, or an error number.
@external("c")
@symbol("pthread_create")
@target(os: ("linux", "macos"))
secret routine c_pthread_create(thread: @Addr, attr: Addr, start: Callable[(Addr,), Addr],
    arg: Addr) -> CInt

### Binds the C `pthread_detach` function, which lets a thread's resources go when it returns, with nobody joining.
### :param thread: The thread's id.
### :returns: 0 on success, or an error number.
@external("c")
@symbol("pthread_detach")
@target(os: ("linux", "macos"))
secret routine c_pthread_detach(thread: Addr) -> CInt

### The pthread entry point: runs the thread's body and returns null.
### :param arg: The {ThreadStart} record.
### :returns: Always null.
@target(os: ("linux", "macos"))
secret routine posix_thread_main(arg: Addr) -> Addr
    thread_body(arg)
    return null

### DEFAULT_THREADS' `launch_fn`: an operating system thread that runs `entry(arg)` and ends when it returns. Its
### manager's workers don't return until they are told to end, and nobody waits for the thread itself.
### :param entry: The routine.
### :param arg: What it is given.
### :param state: Unused.
### :returns: False when the operating system starts no thread, or there is no memory for its start record.
@target(os: ("linux", "macos"))
secret routine os_launch_fn(entry: Callable[(Addr,), None], arg: Addr, state: Addr) -> Bool
    start: @ThreadStart = thread_start(entry, arg)
    if start.is_null()
        return false
    local handle: @Addr <- null
    result: CInt = c_pthread_create(handle, null, posix_thread_main.to[Callable](), start)
    if result != 0
        deallocate(data: start, alloc: DEFAULT_HEAP)
        return false
    else
        c_pthread_detach(handle.peek())
        return true

### _SC_NPROCESSORS_ONLN, whose number differs between Linux and macOS.
### :returns: The sysconf number.
@target(os: "macos")
secret routine sc_nprocessors_onln() -> CInt
    return 58

### _SC_NPROCESSORS_ONLN, whose number differs between Linux and macOS.
### :returns: The sysconf number.
@target(os: "linux")
secret routine sc_nprocessors_onln() -> CInt
    return 84

### The number of processors the system has online, at least 1.
### :returns: The processor count, 1 when it can't be told.
@target(os: ("linux", "macos"))
routine cpu_count() -> USize
    n: CLong = c_sysconf(sc_nprocessors_onln())
    if n < 1
        return 1
    else
        return n.to[USize]()

# -- Windows -----------------------------------------------------------------------------------------------------

### Binds the Win32 `CreateThread` function, which starts a thread.
### :param attrs: The thread handle's security attributes, or null.
### :param stack: The stack size in bytes, 0 for the default.
### :param start: The routine the thread runs.
### :param arg: What `start` is called with.
### :param flags: The creation flags, 0 to run at once.
### :param id: Where the thread id goes, or null.
### :returns: The thread's handle, or null with the last error set.
@external("c")
@symbol("CreateThread")
@callconv("stdcall")
@target(os: "windows")
secret routine c_create_thread(attrs: Addr, stack: USize,
    start: Callable[@callconv("stdcall"), (Addr,), U32], arg: Addr, flags: U32, id: Addr) -> Addr

### Binds the Win32 `GetActiveProcessorCount` function, which counts the active processors.
### :param group: The processor group, or `ALL_PROCESSOR_GROUPS` (0xFFFF) for all of them.
### :returns: The number of active processors, 0 on failure.
@external("c")
@symbol("GetActiveProcessorCount")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_active_processor_count(group: U16) -> U32

### The Windows thread entry point: runs the thread's body and returns 0.
### :param arg: The {ThreadStart} record.
### :returns: Always 0.
@target(os: "windows")
@callconv("stdcall")
secret routine windows_thread_main(arg: Addr) -> U32
    thread_body(arg)
    return 0

### DEFAULT_THREADS' `launch_fn`: an operating system thread that runs `entry(arg)` and ends when it returns. Its
### manager's workers don't return until they are told to end, and nobody waits for the thread itself.
### :param entry: The routine.
### :param arg: What it is given.
### :param state: Unused.
### :returns: False when the operating system starts no thread, or there is no memory for its start record.
@target(os: "windows")
secret routine os_launch_fn(entry: Callable[(Addr,), None], arg: Addr, state: Addr) -> Bool
    start: @ThreadStart = thread_start(entry, arg)
    if start.is_null()
        return false
    handle: Addr = c_create_thread(null, 0, windows_thread_main.to[Callable](), start, 0, null)
    if handle.is_null()
        deallocate(data: start, alloc: DEFAULT_HEAP)
        return false
    else
        c_close_handle(handle)
        return true

### The number of processors the system has online, at least 1.
### :returns: The processor count, 1 when it can't be told.
@target(os: "windows")
routine cpu_count() -> USize
    # ALL_PROCESSOR_GROUPS
    n: U32 = c_get_active_processor_count(0xFFFF)
    if n < 1
        return 1
    else
        return n.to[USize]()
