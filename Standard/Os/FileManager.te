# Tessera stdlib: the file managers, the role FileManager and the OS's OsFileManager
#
# A file manager manages the files of one partition: its file table, the space it gives each file, and every read and
# write. FileManager is that role, the routines every file manager has. OsFileManager is the operating system's: on
# an OS, the OS keeps each partition's table and space, and OsFileManager asks it, for every partition the OS has
# mounted. A program on a machine without an OS (a FAT partition on an SD card) brings its own file manager.
#
# A partition has exactly one file manager: never two over one table (each would take the space as its own), and a
# partition with no file system has none. Making a second one over a partition that has one fails loudly. On an OS this
# is the OS's one file system per mounted volume, so it holds by itself. StorageManager and PartitionManager
# (Storage.te) are the device and the partition under it, and OsFileManager.partition tells which partition a
# path is on.
#
# A File or a Directory (File.te) only says where. Every routine that does something at a path is an OsFileManager
# routine, called on the type: there is no OsFileManager value. Each one is one thing done at the path now, and a
# routine that can fail for a reason the caller handles is failable and throws one of FsError's crashables: a bare call
# that fails stops the program on its line, and `check` (or `try`) in front of the call receives the failure.
#
# Nothing makes a file on the side. Opening for writing or appending, writing, and mapping need a file that is there
# (NotFoundError when it isn't), and make_file is the one way to make one:
#
#     log: &File <- dir.file(name: "log.txt", manager)
#     OsFileManager.make_file(at: log, replacing: false)
#     h: &FileHandle <- OsFileManager.open_write(at: log)
#     h.write("total = {total}\n")
#     h.close()
#
# Renaming, moving, and copying refuse to replace what is at the destination unless `replacing` is true. A move is a
# copy then a delete: on one partition the OS renames instead, which ends the same, and nothing promises that a move
# happens all at once.

module Standard/Os

### The operating system's file manager: making, opening, reading, writing, mapping, deleting, renaming, moving,
### copying, asking about, setting, and listing files and directories, on every partition the OS has mounted. Its
### routines are called on the type (`OsFileManager.read_all(at: notes, manager)`).
entity OsFileManager
obeys FileManager[OsFileManager]
    nothing

### What a file manager does, the role every one fills: the files of one partition made, read, written, renamed,
### deleted, and listed. `OsFileManager` is the OS's.
### :typeparam T: The file manager type.
protocol FileManager[T]
needs T: typename
    ### Makes an empty file at the path.
    ### :param at: Where the file goes.
    ### :param replacing: Whether a file already there is emptied (else it is `AlreadyExistsError`).
    failable common routine Me.make_file(at: @File, replacing: Bool) -> None

    ### The whole file, in memory from manager.
    ### :param at: The file to read.
    ### :param manager: The memory manager for the bytes.
    ### :returns: The bytes.
    failable common routine Me.read_all(at: @File, manager: @MemoryManager) -> BorrowedSlice[Byte]

    ### Writes data as the whole content of the file, which must exist.
    ### :param at: The file to write.
    ### :param data: The bytes that become the file.
    failable common routine Me.write_all(at: @File, data: @[Byte]) -> None

    ### Changes the file's name, keeping it in its directory.
    ### :param at: The file to rename.
    ### :param to: Its new name.
    ### :param replacing: Whether a file already named `to` is replaced.
    failable common routine Me.rename(at: @File, to: @[Byte], replacing: Bool) -> None

    ### Deletes the file.
    ### :param at: The file to delete.
    failable common routine Me.delete(at: @File) -> None

    ### Starts listing the directory's entries into iter.
    ### :param at: The directory to list.
    ### :param iter: The listing to start.
    failable common routine Me.list(at: @Directory, iter: @DirIter) -> None

### Makes the manager. It holds no values.
### :returns: The manager.
common routine OsFileManager.construct() -> Me
    return Me()

### Releases nothing: the manager holds no values.
routine @OsFileManager.destruct() -> None
    return

# -- making ------------------------------------------------------------------------------

### Makes an empty file at the path. The directory it goes in must exist.
### :param at: Where the file goes.
### :param replacing: What happens when a file is already there: `true` empties it, `false` fails with AlreadyExistsError.
###     false (or when a directory is there).
@expensive("asks the operating system")
failable common routine OsFileManager.make_file(at: @File, replacing: Bool) -> None
    mode: OpenMode = when
        replacing => OpenMode.CREATE_REPLACING
        else => OpenMode.CREATE_NEW
    when check FileHandle.open(path: at.path.peek(), mode)
        is FileHandle as f =>
            made: &FileHandle <- f
            made.close()
            return
        is FsError as error => throw error

### Makes the directory.
### :param at: Where the directory goes.
### :param parents: `true` also makes every missing directory on the way, like mkdir -p, and a directory already at
###     the path is fine. `false` needs the parent to exist and fails with AlreadyExistsError when something is there.
@expensive("asks the operating system")
failable common routine OsFileManager.make_directory(at: @Directory, parents: Bool) -> None
    if parents
        when check create_dir_all(at.path.peek())
            is None => return
    when check create_dir(at.path.peek())
        is None => return

# -- reading and writing -----------------------------------------------------------------

### The whole file, in memory from manager (drop it).
### :param at: The file to read.
### :param manager: The memory manager for the bytes.
### :returns: The file's bytes, or throws the {FsError} the OS reported, `MemoryAllocationError` when `manager` fails or the file is too
###     large for the address space (4 GiB or more on a 32-bit target).
@expensive("asks the operating system")
failable common routine OsFileManager.read_all(at: @File,
    manager: @MemoryManager) -> BorrowedSlice[Byte]
    when check read_file(path: at.path.peek(), manager)
        is BorrowedSlice[Byte] as returned => return returned

### Writes data as the whole content of the file, which must exist. What it held before is gone.
### :param at: The file to write.
### :param data: The bytes that become the file.
@expensive("asks the operating system")
failable common routine OsFileManager.write_all(at: @File, data: @[Byte]) -> None
    when check write_file(path: at.path.peek(), data)
        is None => return

# -- opening -----------------------------------------------------------------------------

### Opens the file for reading.
### :param at: The file to open.
### :returns: The open {FileHandle}, or throws the {FsError} the OS reported (NotFoundError when nothing is there).
@expensive("asks the operating system")
failable common routine OsFileManager.open_read(at: @File) -> FileHandle
    when check FileHandle.open(path: at.path.peek(), mode: OpenMode.READ)
        is FileHandle as returned => return returned

### Opens the file for writing and empties it.
### :param at: The file to open.
### :returns: The open {FileHandle}, or throws the {FsError} the OS reported (NotFoundError when nothing is there).
@expensive("asks the operating system")
failable common routine OsFileManager.open_write(at: @File) -> FileHandle
    when check FileHandle.open(path: at.path.peek(), mode: OpenMode.WRITE)
        is FileHandle as returned => return returned

### Opens the file for writing at its end.
### :param at: The file to open.
### :returns: The open {FileHandle}, or throws the {FsError} the OS reported (NotFoundError when nothing is there).
@expensive("asks the operating system")
failable common routine OsFileManager.open_append(at: @File) -> FileHandle
    when check FileHandle.open(path: at.path.peek(), mode: OpenMode.APPEND)
        is FileHandle as returned => return returned

### Opens the file for reading and writing, keeping what it holds.
### :param at: The file to open.
### :returns: The open {FileHandle}, or throws the {FsError} the OS reported (NotFoundError when nothing is there).
@expensive("asks the operating system")
failable common routine OsFileManager.open_read_write(at: @File) -> FileHandle
    when check FileHandle.open(path: at.path.peek(), mode: OpenMode.READ_WRITE)
        is FileHandle as returned => return returned

### The file as cells of `T` mapped into memory: count cells from cell start (`U64.MAX`: to the end), clamped to the
### whole cells the file holds. Past the end, or an empty file, gives an empty storage. It is borrowed with `<-`
### (`storage: FileStorage[Byte] <- OsFileManager.storage[Byte](...)`) and given back with `drop`.
### :typeparam T: The cell type, `Byte` or `Char` (four bytes, UTF-32LE).
### :param at: The file to map.
### :param write: Whether stores to the cells reach the file. Otherwise it's read-only.
### :param start: The first cell to map.
### :param count: The number of cells to map, or `U64.MAX` for the rest of the file.
### :returns: The {FileStorage}, or throws the {FsError} the OS reported (NotFoundError when nothing is there).
@expensive("asks the operating system")
failable common routine OsFileManager.storage[T](at: @File, write: Bool, start: U64,
    count: U64) -> FileStorage[T]
needs T: typename, StorageCell[T]
    when check FileStorage[T].map(path: at.path.peek(), write, start, count)
        is FileStorage[T] as returned => return returned

# -- deleting, moving, copying -------------------------------------------------------------

### Deletes the file (or a link, not what it points at).
### :param at: The file to delete.
@expensive("asks the operating system")
failable common routine OsFileManager.delete(at: @File) -> None
    when check remove_file(at.path.peek())
        is None => return

### Deletes the directory, which must be empty.
### :param at: The directory to delete.
@expensive("asks the operating system")
failable common routine OsFileManager.delete(at: @Directory) -> None
    when check remove_dir(at.path.peek())
        is None => return

### Deletes the directory and everything in it. A link inside is deleted, not followed.
### :param at: The directory to delete.
### :param manager: The memory manager for the child paths.
@expensive("asks the operating system")
failable common routine OsFileManager.delete_all(at: @Directory, manager: @MemoryManager) -> None
    when check remove_dir_all(path: at.path.peek(), manager)
        is None => return

### Changes the file's name, keeping it in its directory: the one routine that renames. A name with a separator in
### it would move the file, so it fails (`move` moves).
### :param at: The file to rename.
### :param to: The new name, one name with no separator.
### :param replacing: Whether a file already named `to` is replaced. When false, one there fails the rename.
###     separator, `AlreadyExistsError` when something is named `to` and `replacing` is false.
@expensive("asks the operating system")
failable common routine OsFileManager.rename(at: @File, to: @[Byte], replacing: Bool) -> None
    when check rename_in_place(path: at.path.peek(), name: to, replacing)
        is None => return

### Changes the directory's name, keeping it where it is, as for a file.
### :param at: The directory to rename.
### :param to: The new name, one name with no separator.
### :param replacing: Whether an empty directory already named `to` is replaced (on Linux and macOS). When false,
###     anything there fails the rename.
###     `AlreadyExistsError` when something is named `to` and `replacing` is false.
@expensive("asks the operating system")
failable common routine OsFileManager.rename(at: @Directory, to: @[Byte], replacing: Bool) -> None
    when check rename_in_place(path: at.path.peek(), name: to, replacing)
        is None => return

### Puts the file into the directory, keeping its name. A move is a copy then a delete: on one partition the OS
### renames it instead, which ends the same, and on two the file is copied and the original deleted. A move doesn't
### happen all at once.
### :param at: The file to move.
### :param into: The directory it goes into.
### :param replacing: Whether a file of the same name in `into` is replaced. When false, one there fails the move.
### :param manager: The memory manager for the new path.
###     whole but deleting the original failed, so both are there. A copy that fails deletes nothing.
@expensive("asks the operating system")
failable common routine OsFileManager.move(at: @File, into: @Directory, replacing: Bool,
    manager: @MemoryManager) -> None
    when check move_into(path: at.path.peek(), into: into.path.peek(), replacing, manager)
        is None => return

### Puts the directory, with everything in it, into another directory, keeping its name, as for a file. On two
### partitions the tree is copied (a link copied as what it points at), then deleted.
### :param at: The directory to move.
### :param into: The directory it goes into.
### :param replacing: Whether an empty directory of the same name in `into` is replaced. When false, anything there
###     fails the move.
### :param manager: The memory manager for the new paths.
@expensive("asks the operating system")
failable common routine OsFileManager.move(at: @Directory, into: @Directory, replacing: Bool,
    manager: @MemoryManager) -> None
    when check move_into(path: at.path.peek(), into: into.path.peek(), replacing, manager)
        is None => return

### Copies the bytes (and on Linux and macOS the permissions) of the file. On Linux and macOS a copy that fails once
### `to` is opened removes it, so no partial file is left.
### :param from: The file to copy.
### :param to: The file to write.
### :param replacing: Whether a file already at `to` is replaced. When false, one there fails the copy.
### :returns: The number of bytes copied, or throws the {FsError} the OS reported (AlreadyExistsError when something is at `to`
###     and `replacing` is false).
@expensive("asks the operating system")
failable common routine OsFileManager.copy(from: @File, to: @File, replacing: Bool) -> U64
    when check copy_file(from: from.path.peek(), to: to.path.peek(), replacing)
        is U64 as returned => return returned

# -- asking ------------------------------------------------------------------------------

### Whether something is at the path, of any kind (a link counts as what it points at).
### :param at: The path to look at.
### :returns: True when something is there.
@expensive("asks the operating system")
common routine OsFileManager.is_present(at: @File) -> Bool
    return is_present(at.path.peek())

### Whether something is at the path, of any kind (a link counts as what it points at).
### :param at: The path to look at.
### :returns: True when something is there.
@expensive("asks the operating system")
common routine OsFileManager.is_present(at: @Directory) -> Bool
    return is_present(at.path.peek())

### Whether a file is at the path, not a directory or anything else (a link counts as what it points at).
### :param at: The path to look at.
### :returns: True when a file is there.
@expensive("asks the operating system")
common routine OsFileManager.is_file(at: @File) -> Bool
    return is_kind(path: at.path.peek(), kind: FileKind.FILE)

### Whether a directory is at the path (a link counts as what it points at).
### :param at: The path to look at.
### :returns: True when a directory is there.
@expensive("asks the operating system")
common routine OsFileManager.is_directory(at: @Directory) -> Bool
    return is_kind(path: at.path.peek(), kind: FileKind.DIRECTORY)

### The file's metadata, a link followed to what it points at.
### :param at: The file to look at.
### :returns: The {Metadata}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.metadata(at: @File) -> Metadata
    when check metadata(at.path.peek())
        is Metadata as returned => return returned

### The directory's metadata, a link followed to what it points at.
### :param at: The directory to look at.
### :returns: The {Metadata}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.metadata(at: @Directory) -> Metadata
    when check metadata(at.path.peek())
        is Metadata as returned => return returned

### The metadata of a link itself (kind Symlink), or of what isn't one.
### :param at: The path to look at.
### :returns: The {Metadata}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.link_metadata(at: @File) -> Metadata
    when check symlink_metadata(at.path.peek())
        is Metadata as returned => return returned

### Whether this process may read, write, or run the file.
### :param at: The file to look at.
### :param access: The kind of access to test for.
### :returns: `true` when the OS allows it, `false` when it refuses or the path can't be examined.
@expensive("asks the operating system")
common routine OsFileManager.is_accessible(at: @File, access: Access) -> Bool
    return is_accessible(path: at.path.peek(), access)

### Whether this process may read, write, or enter the directory.
### :param at: The directory to look at.
### :param access: The kind of access to test for.
### :returns: `true` when the OS allows it, `false` when it refuses or the path can't be examined.
@expensive("asks the operating system")
common routine OsFileManager.is_accessible(at: @Directory, access: Access) -> Bool
    return is_accessible(path: at.path.peek(), access)

# -- setting -----------------------------------------------------------------------------

### Sets or clears the file's read-only state. On Linux and macOS read-only takes every write permission away and
### writable gives the user's own back. On Windows it sets or clears the read-only attribute.
### :param at: The file to change.
### :param readonly: `true` to make the file read-only, `false` to make it writable.
@expensive("asks the operating system")
failable common routine OsFileManager.set_readonly(at: @File, readonly: Bool) -> None
    when check set_readonly(path: at.path.peek(), readonly)
        is None => return

### Sets or clears the directory's read-only state, as for a file.
### :param at: The directory to change.
### :param readonly: `true` to make the directory read-only, `false` to make it writable.
@expensive("asks the operating system")
failable common routine OsFileManager.set_readonly(at: @Directory, readonly: Bool) -> None
    when check set_readonly(path: at.path.peek(), readonly)
        is None => return

### Makes the file exactly size bytes long: cut short, or grown with zero bytes. The file must exist.
### :param at: The file to change.
### :param size: The new size in bytes.
@expensive("asks the operating system")
failable common routine OsFileManager.set_size(at: @File, size: U64) -> None
    when check FileHandle.open(path: at.path.peek(), mode: OpenMode.READ_WRITE)
        is FileHandle as f =>
            opened: &FileHandle <- f
            set: Check[None] = check opened.set_size(size)
            opened.close()
            when set
                is None => return
        is FsError as error => throw error

# -- listing -----------------------------------------------------------------------------

### Starts listing the directory's entries into iter: walk it with `each entry in iter` (or `try iter.emit()` until it
### gives None), then `iter.close()`.
### :param at: The directory to list.
### :param iter: The listing to start, a local slot.
@expensive("asks the operating system")
failable common routine OsFileManager.list(at: @Directory, iter: @DirIter) -> None
    when check iter.open_path(at.path.peek())
        is None => return

# -- paths -------------------------------------------------------------------------------

### The file's path made absolute by its text: the working directory in front of a relative one (on Windows "." and
### ".." taken out too), nothing else looked up. The new path is in memory from manager: drop the File.
### :param at: The file whose path is used.
### :param manager: The memory manager for the new path.
### :returns: The absolute {File}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.absolute(at: @File, manager: @MemoryManager) -> File
    when check absolute_path(path: at.path.peek(), manager)
        is BorrowedSlice[Byte] as p => return File.construct(path: steal p)
        is FsError as error => throw error

### The directory's path made absolute by its text, as for a file. The new path is in memory from manager: drop the
### Directory.
### :param at: The directory whose path is used.
### :param manager: The memory manager for the new path.
### :returns: The absolute {Directory}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.absolute(at: @Directory, manager: @MemoryManager) -> Directory
    when check absolute_path(path: at.path.peek(), manager)
        is BorrowedSlice[Byte] as found => return Directory.construct(path: steal found)

### The file's absolute path with every link, ".", and ".." resolved. The file must exist. The new path is in memory
### from manager: drop the File.
### :param at: The file whose path is used.
### :param manager: The memory manager for the new path.
### :returns: The canonical {File}, or throws the {FsError} the OS reported (NotFoundError when it is missing).
@expensive("asks the operating system")
failable common routine OsFileManager.canonical(at: @File, manager: @MemoryManager) -> File
    when check canonical_path(path: at.path.peek(), manager)
        is BorrowedSlice[Byte] as p => return File.construct(path: steal p)
        is FsError as error => throw error

### The directory's absolute path with every link, ".", and ".." resolved. The directory must exist. The new path is
### in memory from manager: drop the Directory.
### :param at: The directory whose path is used.
### :param manager: The memory manager for the new path.
### :returns: The canonical {Directory}, or throws the {FsError} the OS reported (NotFoundError when it is missing).
@expensive("asks the operating system")
failable common routine OsFileManager.canonical(at: @Directory,
    manager: @MemoryManager) -> Directory
    when check canonical_path(path: at.path.peek(), manager)
        is BorrowedSlice[Byte] as found => return Directory.construct(path: steal found)

# -- partitions --------------------------------------------------------------------------

### The partition the file is on, its names in memory from manager (drop it).
### :param at: An existing file.
### :param manager: The memory manager for the names.
### :returns: The {PartitionManager}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.partition(at: @File,
    manager: @MemoryManager) -> PartitionManager
    when check partition_of(path: at.path.peek(), manager)
        is PartitionManager as returned => return returned

### The partition the directory is on, its names in memory from manager (drop it).
### :param at: An existing directory.
### :param manager: The memory manager for the names.
### :returns: The {PartitionManager}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.partition(at: @Directory,
    manager: @MemoryManager) -> PartitionManager
    when check partition_of(path: at.path.peek(), manager)
        is PartitionManager as returned => return returned

# -- helpers -----------------------------------------------------------------------------

### Renames the file or directory at path to name, in the same directory.
### :param path: What to rename.
### :param name: The new name.
### :param replacing: Whether something already named `name` is replaced.
secret failable routine rename_in_place(path: @[Byte], name: @[Byte], replacing: Bool) -> None
    manager: @MemoryManager = C_HEAP

    if not is_plain_name(name)
        throw InvalidPathError()
    to: &[Byte] <- join_path(a: parent_path(path), b: name, manager)
    renamed: Check[None] = check rename_with(from: path, to: to.getslice(), replacing)
    drop to
    when renamed
        is None => return

### Renames from to to, replacing what is there or not.
### :param from: The current path.
### :param to: The new path.
### :param replacing: Whether something at `to` is replaced.
secret failable routine rename_with(from: @[Byte], to: @[Byte], replacing: Bool) -> None
    if replacing
        when check rename(from, to)
            is None => return
    when check rename_no_replace(from, to)
        is None => return

### Moves the file or directory at path into the directory into, keeping its name.
### :param path: What to move.
### :param into: The directory it goes into.
### :param replacing: Whether something of the same name in `into` is replaced.
### :param manager: The memory manager for the new path.
secret failable routine move_into(path: @[Byte], into: @[Byte], replacing: Bool,
    manager: @MemoryManager) -> None
    to: &[Byte] <- join_path(a: into, b: file_name(path), manager)

    moved: Check[None] = check move_path(from: path, to: to.getslice(), replacing, manager)
    drop to
    when moved
        is None => return
