// Tessera stdlib: pages from the operating system
//
// The page routines every hosted MemoryManager shares: reserving address space, committing pages of it, giving the
// whole reservation back, and setting what pages allow. DEFAULT_HEAP, make_c_heap_memory() and make_stack_memory()
// fill their reserve_fn, commit_fn, release_fn and protect_fn with these, since the pages come from the operating
// system whichever manager hands out the blocks.
//
// A reservation is space no page of which can be touched until it is committed. On Linux the space is mapped with
// PROT_NONE and MAP_NORESERVE, and commit opens the pages (the memory is counted once touched). On Windows it is
// MEM_RESERVE, and commit is MEM_COMMIT.

module Standard/Os

import Standard/Alloc

// -- POSIX -------------------------------------------------------------------------

/// Binds the C `mmap` function, which maps pages into the address space.
/// :param addr: Where to put the mapping, or null to let the system choose.
/// :param length: The number of bytes.
/// :param prot: The `PROT_*` access the pages allow.
/// :param flags: The `MAP_*` flags.
/// :param fd: The file to map, or -1 for anonymous memory.
/// :param offset: The offset into the file.
/// :returns: The mapping's start, or MAP_FAILED (-1) with `errno` set.
#[external("c"), symbol("mmap"), target(os: ("linux", "macos"))]
private routine c_page_map(addr: Addr, length: USize, prot: CInt, flags: CInt, fd: CInt,
    offset: SSize) -> Addr

/// Binds the C `mprotect` function, which changes the access pages allow.
/// :param addr: The start of the pages, page aligned.
/// :param length: The number of bytes.
/// :param prot: The `PROT_*` access the pages allow.
/// :returns: 0 on success, or -1 with `errno` set.
#[external("c"), symbol("mprotect"), target(os: ("linux", "macos"))]
private routine c_page_protect(addr: Addr, length: USize, prot: CInt) -> CInt

/// Binds the C `munmap` function, which removes a mapping.
/// :param addr: The start of the pages, page aligned.
/// :param length: The number of bytes.
/// :returns: 0 on success, or -1 with `errno` set.
#[external("c"), symbol("munmap"), target(os: ("linux", "macos"))]
private routine c_page_unmap(addr: Addr, length: USize) -> CInt

/// MAP_PRIVATE | MAP_ANONYMOUS, whose second bit differs between Linux and the BSDs.
/// :returns: The flags.
#target(os: "macos")
private routine map_private_anonymous() -> CInt
    block entry()
        return(0x1002)

/// MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE: the pages are counted against memory only once touched.
/// :returns: The flags.
#target(os: "linux")
private routine map_private_anonymous() -> CInt
    block entry()
        return(0x4022)

/// The `PROT_*` value for an access: PROT_NONE 0, PROT_READ 1, PROT_READ | PROT_WRITE 3.
/// :param access: What the pages allow.
/// :returns: The protection bits.
#target(os: ("linux", "macos"))
private routine posix_protection(access: PageAccess) -> CInt
    block entry()
        when access
            PageAccess.NONE => return(0)
            PageAccess.READ => return(1)
            PageAccess.READ_WRITE => return(3)

/// Reserves `size` bytes of address space, rounded up to whole pages, no page usable yet.
/// :param size: The number of bytes.
/// :returns: The reservation's start, or null when the space can't be reserved.
/// :throws: Crashes with `IntegerOverflowError` when `size` rounded up to pages doesn't fit in USize.
#[target(os: ("linux", "macos")), expensive("asks for address space")]
routine pages_reserve(size: USize) -> Addr
    local at: Addr = c_page_map(null, length: whole_pages(size), prot: 0, flags: map_private_anonymous(), fd: -1,
        offset: 0)

    block entry()
        failed: Bool = ptrtoint[Addr, SSize](at).eq(-1)
        branch failed
            ? return(null)
            : return(at)

/// Makes `size` bytes of reserved pages at `at` readable and writable.
/// :param at: The first page, page aligned.
/// :param size: The number of bytes, a whole number of pages.
/// :returns: False when the pages can't be committed.
#[target(os: ("linux", "macos")), expensive("asks for memory")]
routine pages_commit(at: Addr, size: USize) -> Bool
    block entry()
        done: Bool = c_page_protect(addr: at, length: size, prot: 3).eq(0)
        return(done)

/// Gives a whole reservation back to the operating system.
/// :param at: The reservation's start.
/// :param size: The size it was reserved with.
#[target(os: ("linux", "macos")), expensive("gives memory back")]
routine pages_release(at: Addr, size: USize) -> Void
    block entry()
        c_page_unmap(addr: at, length: whole_pages(size))
        return()

/// Sets what `size` bytes of pages at `at` allow.
/// :param at: The first page, page aligned.
/// :param size: The number of bytes, a whole number of pages.
/// :param access: What the pages allow.
/// :returns: False when the access can't be set.
#[target(os: ("linux", "macos")), expensive("asks the operating system")]
routine pages_protect(at: Addr, size: USize, access: PageAccess) -> Bool
    block entry()
        done: Bool = c_page_protect(addr: at, length: size, prot: posix_protection(access)).eq(0)
        return(done)

// -- Windows -----------------------------------------------------------------------

/// Binds the Win32 `VirtualAlloc` function, which reserves or commits pages.
/// :param addr: Where to put the pages, or null to let the system choose.
/// :param size: The number of bytes.
/// :param type: The `MEM_*` allocation type, such as `MEM_RESERVE` or `MEM_COMMIT`.
/// :param protect: The `PAGE_*` protection.
/// :returns: The start of the pages, or null with the last error set.
#[external("c"), symbol("VirtualAlloc"), callconv("stdcall"), target(os: "windows")]
private routine c_virtual_alloc(addr: Addr, size: USize, type: U32, protect: U32) -> Addr

/// Binds the Win32 `VirtualProtect` function, which changes the protection of committed pages.
/// :param addr: The start of the pages.
/// :param size: The number of bytes.
/// :param protect: The new `PAGE_*` protection.
/// :param old: Where the previous protection goes.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("VirtualProtect"), callconv("stdcall"), target(os: "windows")]
private routine c_virtual_protect(addr: Addr, size: USize, protect: U32, old: @U32) -> CInt

/// Binds the Win32 `VirtualFree` function, which decommits or releases pages.
/// :param addr: The start of the pages (the reservation's start for `MEM_RELEASE`).
/// :param size: The number of bytes (0 for `MEM_RELEASE`).
/// :param type: The `MEM_*` free type, such as `MEM_RELEASE`.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("VirtualFree"), callconv("stdcall"), target(os: "windows")]
private routine c_virtual_free(addr: Addr, size: USize, type: U32) -> CInt

/// The `PAGE_*` value for an access: PAGE_NOACCESS 1, PAGE_READONLY 2, PAGE_READWRITE 4.
/// :param access: What the pages allow.
/// :returns: The protection.
#target(os: "windows")
private routine windows_protection(access: PageAccess) -> U32
    block entry()
        when access
            PageAccess.NONE => return(1)
            PageAccess.READ => return(2)
            PageAccess.READ_WRITE => return(4)

/// Reserves `size` bytes of address space, rounded up to whole pages, no page usable yet.
/// :param size: The number of bytes.
/// :returns: The reservation's start, or null when the space can't be reserved.
/// :throws: Crashes with `IntegerOverflowError` when `size` rounded up to pages doesn't fit in USize.
#[target(os: "windows"), expensive("asks for address space")]
routine pages_reserve(size: USize) -> Addr
    block entry()
        // MEM_RESERVE, PAGE_NOACCESS
        at: Addr = c_virtual_alloc(addr: null, size: whole_pages(size), type: 0x2000, protect: 1)
        return(at)

/// Makes `size` bytes of reserved pages at `at` readable and writable.
/// :param at: The first page, page aligned.
/// :param size: The number of bytes, a whole number of pages.
/// :returns: False when the pages can't be committed.
#[target(os: "windows"), expensive("asks for memory")]
routine pages_commit(at: Addr, size: USize) -> Bool
    block entry()
        // MEM_COMMIT, PAGE_READWRITE
        done: Bool = c_virtual_alloc(addr: at, size, type: 0x1000, protect: 4).is_not_null()
        return(done)

/// Gives a whole reservation back to the operating system.
/// :param at: The reservation's start.
/// :param size: The size it was reserved with (Windows releases the whole reservation whatever it says).
#[target(os: "windows"), expensive("gives memory back")]
routine pages_release(at: Addr, size: USize) -> Void
    block entry()
        // MEM_RELEASE frees the whole reservation, whatever its size
        c_virtual_free(addr: at, size: 0, type: 0x8000)
        return()

/// Sets what `size` bytes of committed pages at `at` allow.
/// :param at: The first page, page aligned.
/// :param size: The number of bytes, a whole number of pages.
/// :param access: What the pages allow.
/// :returns: False when the access can't be set.
#[target(os: "windows"), expensive("asks the operating system")]
routine pages_protect(at: Addr, size: USize, access: PageAccess) -> Bool
    block entry()
        claim old: @U32 <- 0
        done: Bool = c_virtual_protect(addr: at, size, protect: windows_protection(access), old).ne(0)
        return(done)

// -- shared ------------------------------------------------------------------------

/// `size` rounded up to whole pages.
/// :param size: The number of bytes.
/// :returns: The smallest multiple of the page size that holds `size` bytes.
/// :throws: Crashes with `IntegerOverflowError` when it doesn't fit in USize.
#target(os: not "none")
routine whole_pages(size: USize) -> USize
    block entry()
        page: USize = page_size()
        pages: USize = size.add(page).sub(1).div(page)
        return(pages.mul(page))

/// A manager's reserve routine over the operating system's pages.
/// :param state: Unused.
/// :param size: The number of bytes.
/// :returns: The reservation's start, or null.
#target(os: not "none")
routine os_reserve_fn(state: Addr, size: USize) -> Addr
    block entry()
        return(pages_reserve(size))

/// A manager's commit routine over the operating system's pages.
/// :param state: Unused.
/// :param at: The first page.
/// :param size: The number of bytes.
/// :returns: False when the pages can't be committed.
#target(os: not "none")
routine os_commit_fn(state: Addr, at: Addr, size: USize) -> Bool
    block entry()
        return(pages_commit(at, size))

/// A manager's release routine over the operating system's pages.
/// :param state: Unused.
/// :param at: The reservation's start.
/// :param size: The size it was reserved with.
#target(os: not "none")
routine os_release_fn(state: Addr, at: Addr, size: USize) -> Void
    block entry()
        pages_release(at, size)
        return()

/// A manager's protect routine over the operating system's pages.
/// :param state: Unused.
/// :param at: The first page.
/// :param size: The number of bytes.
/// :param access: What the pages allow.
/// :returns: False when the access can't be set.
#target(os: not "none")
routine os_protect_fn(state: Addr, at: Addr, size: USize, access: PageAccess) -> Bool
    block entry()
        return(pages_protect(at, size, access))
