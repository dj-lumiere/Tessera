# Tessera stdlib: the console: the process's standard input, output, and error
#
# Three types, one per stream, so a stream is only read or only written. Out and Err are Writers:
# Out.write("x = {x}\n") writes formatted text (the builder expands it, as for any Writer), write_all_result writes
# bytes, and nothing is buffered (a BufWriter[Out] is the caller's choice). In is read through one buffer the whole
# process shares, behind a lock: standard input is one stream, and two buffers over it would each take bytes the
# other should have had, so In.read_into_result, read_count, read_word, read_line, and read_all all draw on that one.
# In.read[T]() reads a number (any Parsable type) from the next word in place, without allocating unless the word is
# longer than the buffer. read[T], read_word, and read_line crash at the end of the input, and their _checked forms
# return None there. In is a Reader, so code that reads a file or standard input alike takes a @R and gets
# In.reader().
#
# On Linux and macOS these are file descriptors 0, 1, and 2. On Windows a console is a different thing from a pipe:
# text for a console goes in as UTF-16 (WriteConsoleW, ReadConsoleW), so UTF-8 shows right whatever the console's code
# page, while a pipe or a file gets the bytes as they are (WriteFile, ReadFile), with no "\n" to "\r\n" change. A
# UTF-8 sequence split across two writes to a console is held until the rest comes.

module Standard/Os

import Standard/Alloc
import Standard/Format

### Standard input. Every value is the same stream, so the routines are called on the type, and reader() is the pointer
### a Reader parameter takes.
record In
obeys Reader[In]

### Standard output, a Writer: Out.write("x = {x}\n").
record Out
obeys Writer[Out]
### Standard error, a Writer: Err.write("...").
record Err
obeys Writer[Err]

internal choice StdStream: U8
    INPUT
    OUTPUT
    ERROR

### What reads bytes: standard input, an open file.
protocol Reader[T]
needs T: typename
    ### Reads up to `count` bytes into `buffer`.
    ### :param buffer: Where the bytes go.
    ### :param count: The most bytes to read.
    ### :returns: How many bytes were read, 0 at the end, or a {FsError}.
    routine Me.read_bytes_result(me: @Me, buffer: @Byte, count: USize) -> Result[USize, FsError]

# -- In ----------------------------------------------------------------------------------

### The one buffer over standard input that the whole process shares.
global STDIN_BUFFER: @InputBuffer

### The size in bytes of standard input's buffer, and the read size at or above which a read skips the buffer.
preset IN_BUFFER: USize = 8192

### Standard input's one buffer: bytes read from the OS and not handed out yet, in bytes[start, end).
private record InputBuffer
    lock: ExclusiveLock
    bytes: Array[Byte, IN_BUFFER]
    start: USize
    end: USize

### Fills the empty buffer from the OS with one read.
### :returns: True when bytes came, false at the end of the input (or on a failure, which reads as the end).
private routine InputBuffer.fill(me: @Me) -> Bool
    got: Result[USize, FsError] = stdin_read(buffer: me.bytes.to[@Byte](), count: IN_BUFFER)
    n: USize = when got
        is USize as n => n
        is FsError => 0
    me.start.poke(0)
    me.end.poke(n)
    return n > 0

### The next byte, filling the buffer when it is empty. The lock is held.
### :returns: The byte.
### :absent: At the end of the input.
private routine InputBuffer.emit_checked(me: @Me) -> Maybe[Byte]
    if me.start.peek() < me.end.peek() or me.fill()
        at: USize = me.start.peek()
        me.start.poke(at + 1)
        buffered: @Byte = me.bytes.to[@Byte]()
        return buffered.stride(at).peek()
    else
        return None()

### Puts back the byte emit_checked just handed out. The lock is held.
private routine InputBuffer.unread(me: @Me) -> None
    previous_start: USize = me.start.peek() - 1
    previous_start.poke_into(me.start)
    return

### Reads more input after what the buffer holds, into its free end. The buffer must have room after what it holds.
### The lock is held.
### :returns: True when bytes came, false at the end of the input (or on a failure, which reads as the end).
private routine InputBuffer.fill_more(me: @Me) -> Bool
    local end: USize = me.end.peek()

    free: @Byte = me.bytes.to[@Byte]().stride(end)
    got: Result[USize, FsError] = stdin_read(buffer: free, count: IN_BUFFER.sub(end))
    when got
        is USize as n =>
            me.end.poke(end + n)
            return n > 0
        is FsError => return false

### Moves the bytes the buffer holds to its front, so the free space after them is as large as it can be. The lock is
### held.
private routine InputBuffer.compact(me: @Me) -> None
    local from: USize = me.start.peek()
    local held: USize = me.end.peek() - from
    local buffered: @Byte = me.bytes.to[@Byte]()

    me.start.poke(0)
    me.end.poke(held)

    # front to back: each byte goes to a place the loop has already read
    each i in 0 til held
        byte: Byte = buffered.stride(from + i).peek()
        buffered.stride(i).poke(byte)
    then
        return

### Skips white space and hands out the next word, None at the end of the input. A word that fits in the buffer is a
### view of it (moved to the front of the buffer first when it runs past the end of what was read, so it comes out
### whole), good until the buffer is read into again: nothing is allocated. A longer word is copied into memory from
### DEFAULT_HEAP, which goes into `spill` for the caller to drop, and the word is a view of it. The lock is held.
### :param spill: Where a word longer than the buffer is kept, hollow until one is.
### :returns: The word.
### :absent: At the end of the input.
### :throws: Crashes with `MemoryAllocationError` when a word longer than the buffer can't be copied.
private routine InputBuffer.word(me: @Me, spill: @Memory[Byte]) -> Maybe[Span[Byte]]
    local text: @CaptureBuffer <- CaptureBuffer.empty()

    jump skip()

    block skip()
        c: Maybe[Byte] = me.emit_checked()
        when c
            is Byte as byte => jump first(byte)
            is None => return None()

    block first(byte: Byte)
        if is_space(byte)
            jump skip()
        me.unread()
        jump scan(1)

    # length bytes of the word are known
    block scan(length: USize)
        at: USize = me.start.peek() + length
        if at < me.end.peek()
            jump look(length, at)
        else
            jump more(length)

    block look(length: USize, at: USize)
        buffered: @Byte = me.bytes.to[@Byte]()
        c: Byte = buffered.stride(at).peek()
        if is_space(c)
            jump found(length)
        else
            jump scan(length + 1)

    block more(length: USize)
        me.compact()
        if me.end.peek() >= IN_BUFFER
            jump spill(length)
        if me.fill_more()
            jump scan(length)
        else
            jump found(length)

    block found(length: USize)
        from: USize = me.start.peek()
        buffered: @Byte = me.bytes.to[@Byte]()
        word: Span[Byte] = Span[Byte].construct(data: buffered.stride(from), count: length)
        me.start.poke(from + length)
        return word

    # The whole buffer is one word so far: it goes on in memory from the default heap.
    block spill(length: USize)
        text.append(chunk: me.bytes.to[@Byte](), n: length, alloc: DEFAULT_HEAP)
        me.start.poke(length)
        jump spill_next()

    block spill_next()
        c: Maybe[Byte] = me.emit_checked()
        when c
            is Byte as byte => jump spill_byte(byte)
            is None => jump spilled()

    block spill_byte(byte: Byte)
        if is_space(byte)
            jump spill_end()
        local single: @Byte <- byte
        text.append(chunk: single, n: 1, alloc: DEFAULT_HEAP)
        jump spill_next()

    block spill_end()
        me.unread()
        jump spilled()

    block spilled()
        if text.failed.peek()
            crash_allocation()
        text.owned().poke_into(spill)
        return spill.getview()

### A pointer to standard input, for passing where a Reader is taken (`@R`). Every value of {In} is the same stream,
### so the pointer holds no state and is null.
### :returns: The pointer to hand to a reader parameter.
routine In.reader() -> @Me
    none: @Me = null
    return none

### Reads up to `count` bytes: what the buffer holds first, else one read from the OS (straight into `buffer` when
### `count` is a bufferful or more).
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at the end, or a {FsError} when the OS read fails.
routine In.read_into_result(buffer: @Byte, count: USize) -> Result[USize, FsError]
    local b: @InputBuffer = STDIN_BUFFER

    b.lock.lock()
    if not (b.start.peek() < b.end.peek())
        # Nothing held: a read that wants a bufferful or more goes straight to the caller's buffer.
        if count >= IN_BUFFER
            read: Result[USize, FsError] = stdin_read(buffer, count)
            b.lock.unlock()
            return read
        else if not b.fill()
            b.lock.unlock()
            return 0
    available: USize = b.end.peek() - b.start.peek()
    n: USize = available.min(count)
    buffer.copy(src: b.bytes.to[@Byte]().stride(b.start.peek()), count: n)
    next_start: USize = b.start.peek() + n
    next_start.poke_into(b.start)
    b.lock.unlock()
    return n

### Skips white space and reads the next word (spaces, tabs, and line ends separate words) as a T, straight from the
### input buffer: nothing is allocated unless the word is longer than the buffer. The space after the word stays in
### the input.
### :typeparam T: The type to read, a Parsable one (every integer and float type).
### :returns: The value.
### :throws: Crashes with `AbsentValueError` at the end of the input, and with `InvalidValueError`, naming the word and
### the type, when the word isn't a T. See {In.read_checked} and {In.read_result}.
@track_caller
routine In.read[T]() -> T
needs T: typename, Parsable[T]
    local b: @InputBuffer = STDIN_BUFFER
    local spill: @Memory[Byte] <- .hollow()

    b.lock.lock()
    word: Maybe[Span[Byte]] = b.word(spill)
    when word
        is Span[Byte] as text =>
            # The word may be a view of the buffer, so it's converted before the lock goes.
            value: T = text.to[T]()
            drop spill
            b.lock.unlock()
            return value
        is None =>
            b.lock.unlock()
            crash(name: "AbsentValueError", message: "The input ended before In.read<T>() found a word to read.")

### Skips white space and reads the next word as a T, like {In.read[T]}, with None instead of a crash at the end of
### the input and on a word that isn't a T. The word is gone from the input either way.
### :typeparam T: The type to read, a Parsable one.
### :returns: The value, or None at the end of the input or when the word isn't a T.
routine In.read_checked[T]() -> Maybe[T]
needs T: typename, Parsable[T]
    converted: Result[T, ParseError] = Me.read_result[T]()
    when converted
        is T as value => return value
        is ParseError => return None()

### Skips white space and reads the next word as a T, like {In.read[T]}, with an error instead of a crash: `Empty` at
### the end of the input, else why the word isn't a T. The word is gone from the input either way.
### :typeparam T: The type to read, a Parsable one.
### :returns: The value, or a {ParseError}.
routine In.read_result[T]() -> Result[T, ParseError]
needs T: typename, Parsable[T]
    local b: @InputBuffer = STDIN_BUFFER
    local spill: @Memory[Byte] <- .hollow()

    b.lock.lock()
    word: Maybe[Span[Byte]] = b.word(spill)
    value: Result[T, ParseError] = when word
        is Span[Byte] as text =>
            converted: Result[T, ParseError] = text.to_result[T]()
            drop spill
            becomes converted
        is None => ParseError.EMPTY
    b.lock.unlock()
    return value

### The Reader side: {In.read_into_result}.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at the end, or a {FsError}.
routine In.read_bytes_result(me: @Me, buffer: @Byte, count: USize) -> Result[USize, FsError]
    return Me.read_into_result(buffer, count)

### Up to `count` bytes, in memory from `alloc`: fewer only at the end of the input or on a read failure. Drop them.
### :param count: How many bytes to read.
### :param alloc: The manager for the bytes.
### :returns: The bytes read (empty when the allocation fails).
@expensive("allocates what it reads")
routine In.read_count(count: USize, alloc: @MemoryManager) -> Memory[Byte]
    local made: Result[Memory[Byte], AllocFailed] = Memory[Byte].construct_result(count: count.max(1), manager: alloc)

    buffer: Memory[Byte] = when made
        is Memory[Byte] as buffer => buffer
        is AllocFailed => return Memory[Byte].construct(count: 0, manager: alloc)

    while n != count with n: USize = 0
        got: Result[USize, FsError] = Me.read_into_result(buffer: buffer.data.stride(n), count: count - n)
        k: USize = when got
            is USize as k => k
            is FsError => return buffer.with_count(n)
        if k == 0
            return buffer.with_count(n)
        else
            continue with n: n + k
    then
        return buffer.with_count(n)

### What the rest of the input is, in memory from `alloc`. Drop it.
### :param alloc: The allocator for the bytes.
### :returns: The bytes up to the end of the input (or up to a read failure).
@expensive("allocates what it reads")
routine In.read_all(alloc: @MemoryManager) -> Memory[Byte]
    local text: @CaptureBuffer <- CaptureBuffer.empty()
    local chunk_buffer: @Array[Byte, 4096] <- .hollow()
    local chunk: @Byte = chunk_buffer.to[@Byte]()

    while true
        got2: Result[USize, FsError] = Me.read_into_result(buffer: chunk, count: 4096)
        n2: USize = when got2
            is USize as n2 => n2
            is FsError => return text.owned()
        if n2 == 0
            return text.owned()
        text.append(chunk, n: n2, alloc)

### The next line, without its "\n" (or "\r\n"), in memory from alloc. A last line with no "\n" still counts, and a
### blank line is "". Drop it.
### :param alloc: The allocator for the line.
### :returns: The line.
### :throws: Crashes with `AbsentValueError` at the end of the input. See {In.read_line_checked}.
@track_caller
@expensive("allocates what it reads")
routine In.read_line(alloc: @MemoryManager) -> Memory[Byte]
    line: Maybe[Memory[Byte]] = Me.read_line_checked(alloc)
    when line
        is Memory[Byte] as text => return text
        is None => crash(name: "AbsentValueError", message: "The input ended before In.read_line() found a line to read.")

### The next line, without its "\n" (or "\r\n"), in memory from alloc, or None at the end of the input. A last line
### with no "\n" still counts, and a blank line is "". Drop it.
### :param alloc: The allocator for the line.
### :returns: The line.
### :absent: At the end of the input.
@expensive("allocates what it reads")
routine In.read_line_checked(alloc: @MemoryManager) -> Maybe[Memory[Byte]]
    local b: @InputBuffer = STDIN_BUFFER
    local text: @CaptureBuffer <- CaptureBuffer.empty()

    b.lock.lock()

    while true with any: Bool = false
        c2: Maybe[Byte] = b.emit_checked()
        when c2
            is Byte as byte2 =>
                if byte2 == b'\n'
                    line: Maybe[Memory[Byte]] = trim_cr(text.owned())
                    b.lock.unlock()
                    return line
                else
                    local single: @Byte <- byte2
                    text.append(chunk: single, n: 1, alloc)
                    continue with any: true
            is None =>
                if any
                    line: Maybe[Memory[Byte]] = trim_cr(text.owned())
                    b.lock.unlock()
                    return line
                else
                    line: Maybe[Memory[Byte]] = None()
                    b.lock.unlock()
                    return line

    block done()
        line: Maybe[Memory[Byte]] = trim_cr(text.owned())
        b.lock.unlock()
        return line

    block finish(line: Maybe[Memory[Byte]])
        b.lock.unlock()
        return line

### `line` without a "\r" at its end. The memory and its allocator stay the same, only the count drops.
### :param line: The line.
### :returns: The line, one byte shorter when it ended in "\r".
private routine trim_cr(line: Memory[Byte]) -> Memory[Byte]
    if not line.has_suffix("\r")
        return line
    return line.with_count(line.count - 1)

### Whether `c` separates words: a space, tab, line feed, or carriage return.
### :param c: The byte to test.
### :returns: `true` for white space.
private routine is_space(c: Byte) -> Bool
    blank: Bool = c == b' ' or c == b'\t'
    line_end: Bool = c == b'\n' or c == b'\r'
    return blank or line_end

### The next word (spaces, tabs, and line ends separate words), in memory from alloc. The space after the word stays
### in the input. Drop it.
### :param alloc: The allocator for the word.
### :returns: The word.
### :throws: Crashes with `AbsentValueError` at the end of the input. See {In.read_word_checked}.
@track_caller
@expensive("allocates what it reads")
routine In.read_word(alloc: @MemoryManager) -> Memory[Byte]
    word: Maybe[Memory[Byte]] = Me.read_word_checked(alloc)
    when word
        is Memory[Byte] as text => return text
        is None => crash(name: "AbsentValueError", message: "The input ended before In.read_word() found a word to read.")

### The next word (spaces, tabs, and line ends separate words), in memory from alloc, or None at the end of the
### input. The space after the word stays in the input. Drop it.
### :param alloc: The allocator for the word.
### :returns: The word.
### :absent: At the end of the input.
@expensive("allocates what it reads")
routine In.read_word_checked(alloc: @MemoryManager) -> Maybe[Memory[Byte]]
    local b: @InputBuffer = STDIN_BUFFER
    local text: @CaptureBuffer <- CaptureBuffer.empty()
    local single: @Byte <- .hollow()

    b.lock.lock()

    while true
        c: Maybe[Byte] = b.emit_checked()
        when c
            is Byte as byte =>
                if is_space(byte)
                    continue
                else
                    single.poke(byte)
                    text.append(chunk: single, n: 1, alloc)
                    break
            is None =>
                word: Maybe[Memory[Byte]] = None()
                b.lock.unlock()
                return word

    while true
        c2: Maybe[Byte] = b.emit_checked()
        when c2
            is Byte as byte2 =>
                if is_space(byte2)
                    break
                else
                    single.poke(byte2)
                    text.append(chunk: single, n: 1, alloc)
                    continue
            is None =>
                word: Maybe[Memory[Byte]] = text.owned()
                b.lock.unlock()
                return word
    b.unread()

    word: Maybe[Memory[Byte]] = text.owned()
    b.lock.unlock()
    return word

    block done()
        word: Maybe[Memory[Byte]] = text.owned()
        b.lock.unlock()
        return word

    block finish(word: Maybe[Memory[Byte]])
        b.lock.unlock()
        return word

### Whether standard input is a terminal (a console on Windows), not a pipe or a file.
### :returns: `true` for a terminal.
routine In.is_terminal() -> Bool
    return stream_is_terminal(StdStream.INPUT)

# -- Out and Err -------------------------------------------------------------------------

### A pointer to standard output, for passing where a Writer is taken. Every value of {Out} is the same stream, so the
### pointer holds no state and is null.
### :returns: The pointer to hand to a writer parameter.
routine Out.writer() -> @Me
    none: @Me = null
    return none

### Writes all `count` bytes to standard output.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: Success, or the error Other if the OS refused (or the process has no standard output).
@expensive("makes a system call")
routine Out.write_all_result(data: @Byte, count: USize) -> Result[None, FsError]
    if stream_write(stream: StdStream.OUTPUT, data, count)
        return None()
    else
        return FsError.OTHER

### The Writer side of standard output: a failed write is dropped ({Out.write_all_result} reports it).
### :param data: The bytes to write.
### :param count: How many bytes there are.
@expensive("makes a system call")
routine Out.write_bytes(me: @Me, data: @Byte, count: USize) -> None
    stream_write(stream: StdStream.OUTPUT, data, count)
    return

### Whether standard output is a terminal (a console on Windows), not a pipe or a file.
### :returns: `true` for a terminal.
routine Out.is_terminal() -> Bool
    return stream_is_terminal(StdStream.OUTPUT)

### Whether ANSI color sequences work: a terminal takes them (on Windows once this turns them on), a pipe or a file
### can't show them.
### :returns: `true` when standard output takes ANSI color sequences.
routine Out.enable_colors() -> Bool
    return stream_enable_colors(StdStream.OUTPUT)

### A pointer to standard error, for passing where a Writer is taken. Every value of {Err} is the same stream, so the
### pointer holds no state and is null.
### :returns: The pointer to hand to a writer parameter.
routine Err.writer() -> @Me
    none: @Me = null
    return none

### Writes all `count` bytes to standard error.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: Success, or the error Other if the OS refused (or the process has no standard error).
@expensive("makes a system call")
routine Err.write_all_result(data: @Byte, count: USize) -> Result[None, FsError]
    if stream_write(stream: StdStream.ERROR, data, count)
        return None()
    else
        return FsError.OTHER

### The Writer side of standard error: a failed write is dropped ({Err.write_all_result} reports it).
### :param data: The bytes to write.
### :param count: How many bytes there are.
@expensive("makes a system call")
routine Err.write_bytes(me: @Me, data: @Byte, count: USize) -> None
    stream_write(stream: StdStream.ERROR, data, count)
    return

### Whether standard error is a terminal (a console on Windows), not a pipe or a file.
### :returns: `true` for a terminal.
routine Err.is_terminal() -> Bool
    return stream_is_terminal(StdStream.ERROR)

### Whether ANSI color sequences work on standard error: a terminal takes them (on Windows once this turns them on), a
### pipe or a file can't show them.
### :returns: `true` when colors can be used.
routine Err.enable_colors() -> Bool
    return stream_enable_colors(StdStream.ERROR)

# -- Linux and macOS -------------------------------------------------------------------

### Binds the C `isatty` function, which tells whether a descriptor is a terminal.
### :param fd: The descriptor.
### :returns: 1 for a terminal, 0 otherwise.
@external("c")
@symbol("isatty")
@target(os: ("linux", "macos"))
private routine c_isatty(fd: CInt) -> CInt

### Binds the C `__errno_location` function (Linux).
### :returns: The address of the calling thread's `errno`.
@external("c")
@symbol("__errno_location")
@target(os: "linux")
private routine c_errno_place() -> @CInt

### Binds the C `__error` function (macOS).
### :returns: The address of the calling thread's `errno`.
@external("c")
@symbol("__error")
@target(os: "macos")
private routine c_errno_place() -> @CInt

### The file descriptor of a standard stream: 0 for input, 1 for output, 2 for error.
### :param stream: The stream.
### :returns: The descriptor.
@target(os: ("linux", "macos"))
private routine fd_of(stream: StdStream) -> CInt
    when stream
        StdStream.INPUT => return 0
        StdStream.OUTPUT => return 1
        StdStream.ERROR => return 2

### Whether the stream is a terminal (a console on Windows), not a pipe or a file.
### :param stream: The stream.
### :returns: `true` for a terminal.
@target(os: ("linux", "macos"))
internal routine stream_is_terminal(stream: StdStream) -> Bool
    return c_isatty(fd_of(stream)) != 0

### Writes all `count` bytes to standard output or error, looping over partial writes and retrying after EINTR.
### :param stream: Standard output or error.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when every byte was written, `false` if the OS refused.
@target(os: ("linux", "macos"))
internal routine stream_write(stream: StdStream, data: @Byte, count: USize) -> Bool
    fd: CInt = fd_of(stream)

    while remaining != 0 with at: @Byte = data, remaining: USize = count
        wrote: SSize = c_write(fd_of(stream), at, remaining.min(1073741824))
        if wrote > 0
            continue with at: at.stride(wrote.to[USize]()), remaining: remaining - wrote.to[USize]()
        else
            errno: CInt = c_errno_place().peek()
            # EINTR: a signal came first, so try again
            if wrote < 0 and errno == 4
                continue with at: at, remaining: remaining
            else
                return false
    then
        return true

### Reads up to `count` bytes of standard input with one read, retrying after EINTR.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at its end, or the error Other when the read fails.
@target(os: ("linux", "macos"))
internal routine stdin_read(buffer: @Byte, count: USize) -> Result[USize, FsError]
    got: SSize = c_read(0, buffer, count.min(1073741824))
    if got >= 0
        return got.to[USize]()
    errno: CInt = c_errno_place().peek()
    if errno == 4
        return stdin_read(buffer, count)
    else
        return FsError.OTHER

### Whether ANSI color sequences work on the stream: a terminal takes them as it is.
### :param stream: The stream.
### :returns: `true` when the stream is a terminal.
@target(os: ("linux", "macos"))
internal routine stream_enable_colors(stream: StdStream) -> Bool
    return stream_is_terminal(stream)

# -- Windows -----------------------------------------------------------------------------

### The unfinished UTF-8 sequence of standard output's last console write.
@target(os: "windows")
global PENDING_OUTPUT: @PendingUtf8
### The unfinished UTF-8 sequence of standard error's last console write.
@target(os: "windows")
global PENDING_ERROR: @PendingUtf8
### The text read from the console and not handed out yet.
@target(os: "windows")
global CONSOLE_INPUT: @ConsoleReadBuffer

### The start of a UTF-8 sequence a write to the console ended in the middle of, for standard output and error.
@target(os: "windows")
private record PendingUtf8
    bytes: Array[Byte, 4]
    count: USize

### ReadConsoleW's text as UTF-8, not yet handed out, and a high surrogate whose low half hasn't come.
@target(os: "windows")
private record ConsoleReadBuffer
    bytes: Array[Byte, 16384]
    start: USize
    end: USize
    high: U16

### Binds the Win32 `GetStdHandle` function, which gives one of the process's standard handles.
### :param which: `STD_INPUT_HANDLE`, `STD_OUTPUT_HANDLE`, or `STD_ERROR_HANDLE`.
### :returns: The handle, null when there is none, or INVALID_HANDLE_VALUE with the last error set.
@external("c")
@symbol("GetStdHandle")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_std_handle(which: U32) -> Addr

### Binds the Win32 `GetConsoleMode` function, which reads a console's mode.
### :param console: The console handle.
### :param mode: Where the mode flags go.
### :returns: Nonzero on success, 0 (with the last error set) when the handle isn't a console.
@external("c")
@symbol("GetConsoleMode")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_console_mode(console: Addr, mode: @U32) -> CInt

### Binds the Win32 `SetConsoleMode` function, which sets a console's mode.
### :param console: The console handle.
### :param mode: The new mode flags.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("SetConsoleMode")
@callconv("stdcall")
@target(os: "windows")
private routine c_set_console_mode(console: Addr, mode: U32) -> CInt

### Binds the Win32 `WriteConsoleW` function, which writes UTF-16 text to a console.
### :param console: The console handle.
### :param units: The UTF-16 units to write.
### :param count: How many units there are.
### :param written: Where the number of units written goes.
### :param reserved: Null.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("WriteConsoleW")
@callconv("stdcall")
@target(os: "windows")
private routine c_write_console(console: Addr, units: @U16, count: U32, written: @U32,
    reserved: Addr) -> CInt

### Binds the Win32 `ReadConsoleW` function, which reads UTF-16 text from a console.
### :param console: The console handle.
### :param units: Where the UTF-16 units go.
### :param count: The most units to read.
### :param read: Where the number of units read goes.
### :param control: Null, or the read's control settings.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("ReadConsoleW")
@callconv("stdcall")
@target(os: "windows")
private routine c_read_console(console: Addr, units: @U16, count: U32, read: @U32,
    control: Addr) -> CInt

### Binds the Win32 `WriteFile` function, which writes bytes to a file or pipe.
### :param file: The handle to write to.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :param written: Where the number of bytes written goes.
### :param overlapped: Null for a synchronous write.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("WriteFile")
@callconv("stdcall")
@target(os: "windows")
private routine c_write_file(file: Addr, data: @Byte, count: U32, written: @U32,
    overlapped: Addr) -> CInt

### Binds the Win32 `ReadFile` function, which reads bytes from a file or pipe.
### :param file: The handle to read from.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :param read: Where the number of bytes read goes (0 at end of input).
### :param overlapped: Null for a synchronous read.
### :returns: Nonzero on success, 0 with the last error set (a pipe whose writer closed reports this too).
@external("c")
@symbol("ReadFile")
@callconv("stdcall")
@target(os: "windows")
private routine c_read_file(file: Addr, buffer: @Byte, count: U32, read: @U32,
    overlapped: Addr) -> CInt

### Binds the Win32 `GetLastError` function.
### :returns: The calling thread's last error code.
@external("c")
@symbol("GetLastError")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_last_error() -> U32

### The Windows handle of a standard stream.
### :param stream: The stream.
### :returns: The handle, null or INVALID_HANDLE_VALUE when the process has none.
@target(os: "windows")
private routine handle_of(stream: StdStream) -> Addr
    # STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
    when stream
        StdStream.INPUT => return c_get_std_handle(0xFFFFFFF6)
        StdStream.OUTPUT => return c_get_std_handle(0xFFFFFFF5)
        StdStream.ERROR => return c_get_std_handle(0xFFFFFFF4)

### Whether `h` is a real handle: not null and not INVALID_HANDLE_VALUE.
### :param h: The handle to test.
### :returns: `true` when it can be used.
@target(os: "windows")
private routine is_usable(h: Addr) -> Bool
    return h.is_not_null() and ptrtoint[Addr, USize](h) != USize.MAX

### Whether `h` is a console (GetConsoleMode accepts it), not a pipe or a file.
### :param h: The handle to test.
### :returns: `true` for a console.
@target(os: "windows")
private routine is_console(h: Addr) -> Bool
    local mode: @U32 <- 0
    return c_get_console_mode(h, mode) != 0

### Whether the stream is a terminal (a console on Windows), not a pipe or a file.
### :param stream: The stream.
### :returns: `true` for a console.
@target(os: "windows")
internal routine stream_is_terminal(stream: StdStream) -> Bool
    h: Addr = handle_of(stream)
    if is_usable(h)
        return is_console(h)
    else
        return false

### Whether ANSI color sequences work on the stream: a console needs virtual terminal processing turned on, which
### this does. A pipe or a file can't show them.
### :param stream: The stream.
### :returns: `true` when the stream is a console and virtual terminal processing is now on.
@target(os: "windows")
internal routine stream_enable_colors(stream: StdStream) -> Bool
    h: Addr = handle_of(stream)
    if not is_usable(h)
        return false
    local mode: @U32 <- 0
    if not (c_get_console_mode(h, mode) != 0)
        return false
    # ENABLE_VIRTUAL_TERMINAL_PROCESSING
    return c_set_console_mode(h, mode.peek() | 4) != 0

### Writes all `count` bytes to standard output or error: as UTF-16 to a console, as they are to a pipe or a file.
### :param stream: Standard output or error.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when every byte was written (or held as an unfinished sequence), `false` if the OS refused (or
###     the process has no such stream).
@target(os: "windows")
internal routine stream_write(stream: StdStream, data: @Byte, count: USize) -> Bool
    h: Addr = handle_of(stream)
    if not is_usable(h)
        return false
    if is_console(h)
        return console_write(stream, h, data, count)
    else
        return file_write(h, data, count)

### Writes all `count` bytes to a pipe or file handle with WriteFile as they are, looping over partial writes.
### :param h: The handle.
### :param data: The bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when every byte was written, `false` on the first failure.
@target(os: "windows")
private routine file_write(h: Addr, data: @Byte, count: USize) -> Bool
    local wrote: @U32 <- 0

    while remaining != 0 with at: @Byte = data, remaining: USize = count
        ok: CInt = c_write_file(h, at, remaining.min(1073741824).to[U32](), wrote, null)
        n: USize = wrote.peek().to[USize]()
        if ok != 0 and n > 0
            continue with at: at.stride(n), remaining: remaining - n
        else
            return false
    then
        return true

### How many bytes a UTF-8 sequence starting with `b` has (1 for a byte that can't start one).
### :param b: The sequence's first byte.
### :returns: 1 to 4.
@target(os: "windows")
private routine sequence_length(b: Byte) -> USize
    u: U8 = b.to[U8]()
    when
        u < 0xC0 => return 1
        u < 0xE0 => return 2
        u < 0xF0 => return 3
        u < 0xF8 => return 4
        else => return 1

### Where the last complete sequence of the `count` bytes ends: before a sequence the bytes stop in the middle of.
### :param data: The UTF-8 bytes.
### :param count: How many bytes there are.
### :returns: The number of bytes up to the end of the last complete sequence (`count` when none is cut off).
@target(os: "windows")
private routine complete_end(data: @Byte, count: USize) -> USize
    until i == 0 or seen == 3 with i: USize = count, seen: USize = 0
        b: Byte = data.stride(i - 1).peek()
        top_bits: U8 = b.to[U8]() & 0xC0
        # a continuation byte: 10xxxxxx
        if top_bits == 0x80
            continue with i: i - 1, seen: seen + 1
        else
            sequence_end: USize = i - 1 + sequence_length(b)
            if sequence_end > count
                return i - 1
            else
                return count
    then
        return count

### The record holding the unfinished UTF-8 sequence of a stream's console writes.
### :param stream: Standard output or error.
### :returns: The record for that stream.
@target(os: "windows")
private routine pending_of(stream: StdStream) -> @PendingUtf8
    if stream == StdStream.ERROR
        return PENDING_ERROR
    else
        return PENDING_OUTPUT

### Writes UTF-8 to a console as UTF-16, finishing a sequence an earlier write left open and holding one this
### write leaves open.
### :param stream: Standard output or error, whose unfinished sequence is used.
### :param h: The console handle.
### :param data: The UTF-8 bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when the text was written (or held), `false` if the console refused.
@target(os: "windows")
private routine console_write(stream: StdStream, h: Addr, data: @Byte, count: USize) -> Bool
    local pending: @PendingUtf8 = pending_of(stream)
    local held: USize = pending.count.peek()

    values2: (@Byte, USize) = when
        held == 0 => (data, count)
        else =>
            # The bytes the held sequence still needs come first.
            need: USize = sequence_length(pending.bytes[0]) - held
            taken: USize = need.min(count)
            pending.bytes.to[@Byte]().stride(held).copy(src: data, count: taken)
            if taken < need
                pending.count.poke(held + taken)
                return true
            else
                pending.count.poke(0)
                if console_text(h, data: pending.bytes.to[@Byte](), count: held + taken)
                    becomes (data.stride(taken), count - taken)
                else
                    return false

    at, n = values2
    cut: USize = complete_end(data: at, count: n)
    pending.bytes.to[@Byte]().copy(src: at.stride(cut), count: n - cut)
    pending.count.poke(n - cut)
    return console_text(h, data: at, count: cut)

### Writes complete UTF-8 text to a console, a bufferful of UTF-16 at a time.
### :param h: The console handle.
### :param data: The UTF-8 bytes to write.
### :param count: How many bytes there are.
### :returns: `true` when all of it was written, `false` if the console refused.
@target(os: "windows")
private routine console_text(h: Addr, data: @Byte, count: USize) -> Bool
    local written: @U32 <- 0
    local iter: @BytesCharsIter <- Span[Byte].construct(data, count).chars()
    local unit_buffer: @Array[U16, 2048] <- .hollow()
    local units: @U16 = unit_buffer.to[@U16]()

    while true with n: USize = 0
        if n >= 2046
            if write_units(h, units, n, written)
                continue with n: 0
            else
                return false
        else
            c: Maybe[Char] = iter.emit_checked()
            when c
                is Char as char =>
                    cp: U32 = char.to[U32]()
                    if cp < 0x10000
                        units.stride(n).poke(cp.to[U16]())
                        continue with n: n + 1
                    else
                        v: U32 = cp - 0x10000
                        high_surrogate: U32 = (v >> 10) + 0xD800
                        units.stride(n).poke(high_surrogate.to[U16]())
                        low_surrogate: U32 = (v & 0x3FF) + 0xDC00
                        units.stride(n + 1).poke(low_surrogate.to[U16]())
                        continue with n: n + 2
                is None => return write_units(h, units, n, written)

### Writes `n` UTF-16 units to a console, however many calls that takes.
### :param h: The console handle.
### :param units: The units to write.
### :param n: How many units there are.
### :param written: Scratch space for the count each call wrote.
### :returns: `true` when all were written, `false` if the console refused.
@target(os: "windows")
private routine write_units(h: Addr, units: @U16, n: USize, written: @U32) -> Bool
    if n == 0
        return true
    ok: CInt = c_write_console(h, units, n.to[U32](), written, null)
    w: USize = written.peek().to[USize]()
    if ok != 0 and w > 0
        return write_units(h, units: units.stride(w), n: n - w, written)
    else
        return false

### Reads up to `count` bytes of standard input: from the console as UTF-8, or from a pipe or a file as they are.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: How many bytes were read, 0 at its end (Ctrl+Z at the start of a console read, a closed pipe, or no
###     standard input), or the error Other when the read fails.
@target(os: "windows")
internal routine stdin_read(buffer: @Byte, count: USize) -> Result[USize, FsError]
    h: Addr = handle_of(StdStream.INPUT)
    if not is_usable(h)
        return 0
    if is_console(h)
        return console_read(h, buffer, count)
    local got: @U32 <- 0
    if c_read_file(h, buffer, count.min(1073741824).to[U32](), got, null) != 0
        return got.peek().to[USize]()
    # ERROR_BROKEN_PIPE: the writing end closed, which is the end
    if c_get_last_error() == 109
        return 0
    else
        return FsError.OTHER

### Hands out UTF-8 from CONSOLE_INPUT, reading the console (as UTF-16) when it is empty.
### :param h: The console handle.
### :param buffer: Where the bytes go.
### :param count: The most bytes to hand out.
### :returns: How many bytes were handed out, 0 at the end of the input (Ctrl+Z first), or the error Other when
###     ReadConsoleW fails.
@target(os: "windows")
private routine console_read(h: Addr, buffer: @Byte, count: USize) -> Result[USize, FsError]
    local input: @ConsoleReadBuffer = CONSOLE_INPUT

    if input.start.peek() < input.end.peek()
        jump hand_out()
    local units: @Array[U16, 4096] <- .hollow()
    local got: @U32 <- 0
    if not (c_read_console(h, units.to[@U16](), 4096, got, null) != 0)
        return FsError.OTHER
    n: USize = got.peek().to[USize]()
    if n == 0
        return 0
    # Ctrl+Z first: the end of the input
    if units[0] == 0x1A
        return 0
    else
        jump convert(units.to[@U16](), n)

    # A high surrogate at the end waits for its low half. One held from the last read goes in front.
    block convert(units: @U16, n: USize)
        local joined: @Array[U16, 4097] <- .hollow()
        high: U16 = input.high.peek()
        lead: USize = when
            high == 0 => 0
            else => 1
        joined.to[@U16]().poke(high)
        joined.to[@U16]().stride(lead).copy(src: units, count: n)
        total: USize = n + lead
        joined_units: @U16 = joined.to[@U16]()
        last: U16 = joined_units.stride(total - 1).peek()
        if last.between(lo: 0xD800, hi: 0xDBFF)
            jump hold(joined.to[@U16](), total - 1, last)
        else
            jump hold(joined.to[@U16](), total, 0)

    block hold(joined: @U16, units: USize, high: U16)
        input.high.poke(high)
        made: USize = narrow(units: joined, count: units, out: input.bytes.to[@Byte]())
        input.start.poke(0)
        input.end.poke(made)
        if made == 0
            return console_read(h, buffer, count)
        else
            jump hand_out()

    block hand_out()
        start: USize = input.start.peek()
        available: USize = input.end.peek() - start
        n: USize = available.min(count)
        buffer.copy(src: input.bytes.to[@Byte]().stride(start), count: n)
        input.start.poke(start + n)
        return n
