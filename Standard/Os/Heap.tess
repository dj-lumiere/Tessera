// Tessera stdlib: the heap allocator
//
// An Allocator backed by libc malloc / realloc / free. Collections take any
// Allocator, so this is the hosted default, not a requirement.

module Standard::Os

import Standard::Alloc

/// Binds the C `malloc` function.
#[external("c"), symbol("malloc")]
private routine c_malloc(size: USize) -> Addr

/// Binds the C `realloc` function.
#[external("c"), symbol("realloc")]
private routine c_realloc(ptr: Addr, size: USize) -> Addr

/// Binds the C `free` function.
#[external("c"), symbol("free")]
private routine c_free(ptr: Addr) -> Void

/// The allocator's alloc function: malloc of `size` bytes.
/// :param state: Unused, the heap allocator has no state.
/// :param size: The number of bytes.
/// :returns: The new block, null when malloc fails.
private routine heap_alloc_fn(state: Addr, size: USize) -> Addr
    block entry()
        result : Addr = c_malloc(size)
        return(result)

/// The allocator's realloc function: resizes a block with realloc, keeping its contents.
/// :param state: Unused, the heap allocator has no state.
/// :param old_ptr: The block to resize.
/// :param size: The new size in bytes.
/// :returns: The resized block (possibly moved), null when realloc fails and the old block is untouched.
private routine heap_realloc_fn(state: Addr, old_ptr: Addr, size: USize) -> Addr
    block entry()
        result : Addr = c_realloc(old_ptr, size)
        return(result)

/// The allocator's free function: free of a block from this allocator.
/// :param state: Unused, the heap allocator has no state.
/// :param ptr: The block to free.
private routine heap_free_fn(state: Addr, ptr: Addr) -> Void
    block entry()
        c_free(ptr)
        return()

/// An {Allocator} backed by the C library's malloc, realloc, and free. Collections take any allocator, so this is the
/// hosted default and not a requirement.
/// :returns: The allocator, which holds no state and needs nothing to free.
routine make_heap_allocator() -> Allocator
    block entry()
        alloc : Allocator = Allocator { alloc_fn: heap_alloc_fn.to<Callable>(),
            realloc_fn: heap_realloc_fn.to<Callable>(), free_fn: heap_free_fn.to<Callable>(),
            state: null }
        return(alloc)
