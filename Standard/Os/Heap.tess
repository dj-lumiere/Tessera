# Tessera stdlib: the heap allocator
#
# An MemoryManager backed by libc malloc / realloc / free. Collections take any
# MemoryManager, so this is the hosted default, not a requirement. DEFAULT_HEAP is
# one, ready before start runs: the construct overloads without an allocator
# (Os/Defaults.tess) draw from it, and make_heap_memory() gives the same
# allocator. With the heap check on (config.toml's [debug] heap-check, in any
# build mode) it checks every free and crashes on a block freed twice (the
# checked heap, below), so its blocks are not malloc's own then.
# make_c_heap_memory() is plain malloc / realloc / free in every build: for
# memory that C code frees or reallocates, or that comes from C's malloc.

module Standard/Os

import Standard/Alloc

### The hosted default allocator, ready before `start` runs: the C library's heap, with the checked heap's checks when
### the heap check is on. The collections' and {Span[T]}'s `construct` without an allocator draw from it, and it can
### be passed wherever an `@MemoryManager` goes. It holds no state, so threads share it. Its page routines are the
### operating system's.
@heap_check("off")
global DEFAULT_HEAP: @MemoryManager <- (alloc_fn: plain_heap_alloc_fn.to[Callable](), realloc_fn: plain_heap_realloc_fn.to[Callable](), free_fn: plain_heap_free_fn.to[Callable](), reserve_fn: os_reserve_fn.to[Callable](), commit_fn: os_commit_fn.to[Callable](), release_fn: os_release_fn.to[Callable](), protect_fn: os_protect_fn.to[Callable](), state: null)
### The hosted default allocator with the heap check on: the C library's heap behind the checked heap's checks, which
### crash on a block freed twice.
@heap_check("on")
global DEFAULT_HEAP: @MemoryManager <- (alloc_fn: checked_heap_alloc_fn.to[Callable](), realloc_fn: checked_heap_realloc_fn.to[Callable](), free_fn: checked_heap_free_fn.to[Callable](), reserve_fn: os_reserve_fn.to[Callable](), commit_fn: os_commit_fn.to[Callable](), release_fn: os_release_fn.to[Callable](), protect_fn: os_protect_fn.to[Callable](), state: null)

### The alignment malloc gives every block: twice a pointer's size (8 on 32-bit targets, 16 on 64-bit ones).
private preset MALLOC_ALIGN: USize = sizeof[Addr]().mul(2)

### Binds the C `malloc` function, which allocates a block of memory.
### :param size: The number of bytes.
### :returns: The new block, or null when the allocation fails.
@external("c")
@symbol("malloc")
private routine c_malloc(size: USize) -> Addr

### Binds the C `realloc` function, which resizes a block, keeping its contents up to the smaller size.
### :param ptr: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :returns: The resized block (possibly moved), or null when the allocation fails and `ptr` is untouched.
@external("c")
@symbol("realloc")
private routine c_realloc(ptr: Addr, size: USize) -> Addr

### Binds the C `free` function, which gives a block back to the C heap.
### :param ptr: The block to free. Null does nothing.
@external("c")
@symbol("free")
private routine c_free(ptr: Addr) -> None

### An {MemoryManager} that is {DEFAULT_HEAP}: the C library's malloc, realloc, and free, with the checked heap's checks
### when the heap check is on. Collections take any allocator, so this is the hosted default and not a requirement.
### :returns: The allocator, which holds no state and needs nothing to free.
routine make_heap_memory() -> MemoryManager
    alloc: MemoryManager = DEFAULT_HEAP.peek()
    return alloc

### An {MemoryManager} that is the C library's malloc, realloc, and free in every build, with nothing in front of the
### blocks: for memory that C code frees or reallocates, or that comes from C's malloc and is freed here. An alignment
### past malloc's own comes from posix_memalign (still freed with free), and on Windows, whose free can't take such a
### block, it crashes.
### :returns: The allocator, which holds no state and needs nothing to free.
routine make_c_heap_memory() -> MemoryManager
    alloc: MemoryManager = MemoryManager(alloc_fn: c_heap_alloc_fn.to[Callable](), realloc_fn: c_heap_realloc_fn.to[Callable](), free_fn: c_heap_free_fn.to[Callable](), reserve_fn: os_reserve_fn.to[Callable](), commit_fn: os_commit_fn.to[Callable](), release_fn: os_release_fn.to[Callable](), protect_fn: os_protect_fn.to[Callable](), state: null)
    return alloc

### Binds the C `posix_memalign` function, which allocates a block aligned past malloc's own alignment.
### :param out: Where the block goes.
### :param align: The alignment, a power of two and a multiple of a pointer's size.
### :param size: The number of bytes.
### :returns: 0, or an error number when the block can't be allocated.
@external("c")
@symbol("posix_memalign")
@target(os: ("linux", "macos"))
private routine c_posix_memalign(out: @Addr, align: USize, size: USize) -> CInt

### Binds glibc's `malloc_usable_size`, the size a malloc block holds.
### :param ptr: The block.
### :returns: The bytes the block holds, at least its size.
@external("c")
@symbol("malloc_usable_size")
@target(os: "linux")
private routine c_block_size(ptr: Addr) -> USize

### Binds macOS's `malloc_size`, the size a malloc block holds.
### :param ptr: The block.
### :returns: The bytes the block holds, at least its size.
@external("c")
@symbol("malloc_size")
@target(os: "macos")
private routine c_block_size(ptr: Addr) -> USize

### Binds the C runtime's `_aligned_malloc`, an aligned block that `_aligned_free` gives back.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block, or null.
@external("c")
@symbol("_aligned_malloc")
@target(os: "windows")
private routine c_aligned_malloc(size: USize, align: USize) -> Addr

### Binds the C runtime's `_aligned_realloc`, which resizes an `_aligned_malloc` block keeping its alignment.
### :param ptr: The block, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, or null with the old one untouched.
@external("c")
@symbol("_aligned_realloc")
@target(os: "windows")
private routine c_aligned_realloc(ptr: Addr, size: USize, align: USize) -> Addr

### Binds the C runtime's `_aligned_free`, which gives an `_aligned_malloc` block back.
### :param ptr: The block. Null does nothing.
@external("c")
@symbol("_aligned_free")
@target(os: "windows")
private routine c_aligned_free(ptr: Addr) -> None

### The C heap's alloc function: malloc of `size` bytes, or posix_memalign for an alignment past malloc's.
### :param state: Unused, the heap allocator has no state.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: ("linux", "macos"))
private routine c_heap_alloc_fn(state: Addr, size: USize, align: USize) -> Addr
    if align <= MALLOC_ALIGN
        return c_malloc(size)
    local out: @Addr <- null
    if c_posix_memalign(out, align, size) != 0
        return null
    else
        return out.peek()

### The C heap's alloc function: malloc of `size` bytes. Windows' free can't take a block aligned past malloc's own.
### :param state: Unused, the heap allocator has no state.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when malloc fails.
### :throws: Crashes with `InvalidValueError` when `align` is past malloc's own.
@target(os: "windows")
private routine c_heap_alloc_fn(state: Addr, size: USize, align: USize) -> Addr
    if align <= MALLOC_ALIGN
        return c_malloc(size)
    else
        crash(name: "InvalidValueError", message: "The C heap can't give a block aligned past malloc's own on Windows: use DEFAULT_HEAP.")

### The C heap's realloc function: resizes a block with realloc, and a block aligned past malloc's own through a new
### aligned block, the contents copied over.
### :param state: Unused, the heap allocator has no state.
### :param old_ptr: The block to resize.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block (possibly moved), null when the heap has no room and the old block is untouched.
@target(os: ("linux", "macos"))
private routine c_heap_realloc_fn(state: Addr, old_ptr: Addr, size: USize, align: USize) -> Addr
    if align <= MALLOC_ALIGN
        return c_realloc(old_ptr, size)
    fresh: Addr = c_heap_alloc_fn(state, size, align)
    if fresh.is_null()
        return null
    if old_ptr.is_null()
        return fresh
    kept: USize = c_block_size(old_ptr).min(size)
    fresh.to[@Byte]().copy(src: old_ptr.to[@Byte](), count: kept)
    c_free(old_ptr)
    return fresh

### The C heap's realloc function: resizes a block with realloc.
### :param state: Unused, the heap allocator has no state.
### :param old_ptr: The block to resize.
### :param size: The new size in bytes.
### :param align: The block's alignment, at most malloc's own.
### :returns: The resized block (possibly moved), null when realloc fails and the old block is untouched.
@target(os: "windows")
private routine c_heap_realloc_fn(state: Addr, old_ptr: Addr, size: USize, align: USize) -> Addr
    return c_realloc(old_ptr, size)

### The C heap's free function: free of a block from this allocator.
### :param state: Unused, the heap allocator has no state.
### :param ptr: The block to free.
private routine c_heap_free_fn(state: Addr, ptr: Addr) -> None
    c_free(ptr)
    return

### The default heap's alloc function with the heap check off: the C heap's.
### :param state: Unused.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: ("linux", "macos"))
private routine plain_heap_alloc_fn(state: Addr, size: USize, align: USize) -> Addr
    return c_heap_alloc_fn(state, size, align)

### The default heap's realloc function with the heap check off: the C heap's.
### :param state: Unused.
### :param old_ptr: The block to resize.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, null when the heap has no room and the old block is untouched.
@target(os: ("linux", "macos"))
private routine plain_heap_realloc_fn(state: Addr, old_ptr: Addr, size: USize, align: USize) -> Addr
    return c_heap_realloc_fn(state, old_ptr, size, align)

### The default heap's free function with the heap check off: free.
### :param state: Unused.
### :param ptr: The block to free.
@target(os: ("linux", "macos"))
private routine plain_heap_free_fn(state: Addr, ptr: Addr) -> None
    c_free(ptr)
    return

### The default heap's alloc function on Windows: `_aligned_malloc`, so any alignment is there.
### :param state: Unused.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: "windows")
private routine plain_heap_alloc_fn(state: Addr, size: USize, align: USize) -> Addr
    return c_aligned_malloc(size, align.max(MALLOC_ALIGN))

### The default heap's realloc function on Windows: `_aligned_realloc`, keeping the alignment.
### :param state: Unused.
### :param old_ptr: The block to resize.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, null when the heap has no room and the old block is untouched.
@target(os: "windows")
private routine plain_heap_realloc_fn(state: Addr, old_ptr: Addr, size: USize, align: USize) -> Addr
    return c_aligned_realloc(old_ptr, size, align.max(MALLOC_ALIGN))

### The default heap's free function on Windows: `_aligned_free`.
### :param state: Unused.
### :param ptr: The block to free.
@target(os: "windows")
private routine plain_heap_free_fn(state: Addr, ptr: Addr) -> None
    c_aligned_free(ptr)
    return

# -- the checked heap ---------------------------------------------------------------------------------------------
#
# With the heap check on (config.toml's [debug] heap-check, the same in every build mode) every block has a header
# right in front of it: a tag that says whether the block is live or freed, its size, and where malloc's block starts
# (the block is placed HEADER_ROOM bytes or more into it, at the alignment asked for). Freeing swaps the tag to FREED atomically and looks at what was there:
#
# - LIVE: the first free. The block goes into a quarantine of the last QUARANTINE_SIZE freed blocks instead of back to
#   malloc, so its memory keeps saying FREED. The block it pushes out of the quarantine goes back to malloc.
# - FREED: the block was freed before, and the program crashes with DoubleFreeError at the line that freed it again
#   (allocator_call_place(), noted by deallocate).
# - anything else: the pointer isn't a block from this heap (or the bytes in front of it were overwritten), and the
#   program crashes with InvalidValueError.
#
# The swap is atomic, so two threads freeing one block at once are caught too: exactly one of them sees LIVE. A
# second free is caught for sure while the block is in the quarantine. Once it has gone back to malloc, malloc may
# have written over the header (the free reads as "not a block": still a crash) or handed the memory out again as
# another live block (the second free then frees that one, unseen), so the quarantine keeps the window wide. A
# reallocation copies into a new block and frees the old one the same way, so a stale pointer to the old block is
# caught like any freed one. With the heap check off none of this is there: DEFAULT_HEAP is the C heap above, plain
# malloc, realloc, free.

### The headers of the last QUARANTINE_SIZE freed blocks, held back from malloc.
@heap_check("on")
private global QUARANTINE: @Array[Addr, QUARANTINE_SIZE]
### The number of blocks that have gone into the quarantine, whose low bits pick the next slot.
@heap_check("on")
private global QUARANTINE_NEXT: @USize

### The room kept in front of a block for its header, a multiple of every alignment malloc gives.
private preset HEADER_ROOM: USize = 32

### The offset from a block back to its header.
private preset HEADER_BACK: SSize = -32
### The tag of a block that is in use.
private preset LIVE: USize = 0x7E55A11E
### The tag of a block that has been freed.
private preset FREED: USize = 0x7E55F4EE
### How many freed blocks the checked heap holds back from malloc.
private preset QUARANTINE_SIZE: USize = 256
### The mask that turns the running count of frees into a quarantine slot.
private preset QUARANTINE_MASK: USize = QUARANTINE_SIZE.sub(1)

### What the checked heap keeps in front of each block.
private record BlockHeader
    tag: USize
    size: USize
    raw: Addr

### Makes a `BlockHeader` from its fields.
### :param tag: Its `tag`.
### :param size: Its `size`.
### :param raw: Its `raw`.
### :returns: The new value.
private routine BlockHeader.construct(tag: USize, size: USize, raw: Addr) -> Me
    return Me(tag, size, raw)

### Releases nothing: a `BlockHeader` holds no memory of its own.
private routine BlockHeader.destruct(me: @Me) -> None
    return

### The checked heap's alloc function: malloc of the header room, `size` bytes, and room to align, the header tagged
### LIVE.
### :param state: Unused, the heap allocator has no state.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block after the header, null when malloc fails or the size can't hold a header too.
@heap_check("on")
private routine checked_heap_alloc_fn(state: Addr, size: USize, align: USize) -> Addr
    local step: USize = align.max(MALLOC_ALIGN)

    total: Maybe[USize] = size.add_checked(HEADER_ROOM.add(step))
    when total
        is USize as bytes =>
            raw: Addr = c_malloc(bytes)
            if raw.is_null()
                return null
            # The first address HEADER_ROOM bytes in that is a multiple of the alignment.
            lowest: USize = ptrtoint[Addr, USize](raw) + HEADER_ROOM
            aligned: USize = lowest + step - 1 & ~(step - 1)
            block_start: Addr = inttoptr[USize, Addr](aligned)
            header: @BlockHeader = header_of(block_start)
            header.tag.poke(LIVE)
            header.size.poke(size)
            header.raw.poke(raw)
            return block_start
        is None => return null

### The checked heap's realloc function: a new block, the contents copied over (as many bytes as both sizes allow),
### and the old block freed through the same checks as `checked_heap_free_fn`.
### :param state: Unused, the heap allocator has no state.
### :param old_ptr: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The new block, null when malloc fails and the old block is untouched.
### :throws: Crashes with `InvalidValueError` when `old_ptr` was freed already or isn't a block of this heap.
@heap_check("on")
private routine checked_heap_realloc_fn(state: Addr, old_ptr: Addr, size: USize,
    align: USize) -> Addr
    if old_ptr.is_null()
        return checked_heap_alloc_fn(state, size, align)
    header: @BlockHeader = header_of(old_ptr)
    tag: USize = header.tag.peek_atomic()
    when
        tag == LIVE =>
            new_ptr: Addr = checked_heap_alloc_fn(state, size, align)
            if new_ptr.is_null()
                return null
            kept: USize = header.size.peek().min(size)
            new_ptr.to[@Byte]().copy(src: old_ptr.to[@Byte](), count: kept)
            release_block(old_ptr)
            return new_ptr
        tag == FREED => heap_crash(name: "InvalidValueError", message: "The default heap was asked to resize a block that was already freed.")
        else => heap_crash(name: "InvalidValueError", message: "The default heap was asked to resize memory that isn't a block it gave out.")

### The checked heap's free function: checks the block's tag and puts the block in the quarantine.
### :param state: Unused, the heap allocator has no state.
### :param ptr: The block to free. Null does nothing.
### :throws: Crashes with `DoubleFreeError` when the block was freed already, and with `InvalidValueError` when `ptr`
###     isn't a block of this heap.
@heap_check("on")
private routine checked_heap_free_fn(state: Addr, ptr: Addr) -> None
    if ptr.is_null()
        return
    release_block(ptr)
    return

### The header in front of a block of the checked heap.
### :param block_start: The block, as the checked heap gave it out.
### :returns: The address `HEADER_ROOM` bytes before `block_start`.
@heap_check("on")
private routine header_of(block_start: Addr) -> @BlockHeader
    raw: Addr = block_start.offset(HEADER_BACK)
    header: @BlockHeader = raw.to[@BlockHeader]()
    return header

### Tags the block FREED and puts it in the quarantine, crashing when it was freed already or isn't a block of this
### heap. The block pushed out of the quarantine goes back to malloc.
### :param block_start: The block to release.
### :throws: Crashes with `DoubleFreeError` when the block was freed already, and with `InvalidValueError` when it
###     isn't a block of this heap.
@heap_check("on")
private routine release_block(block_start: Addr) -> None
    local header: @BlockHeader = header_of(block_start)

    was: USize = header.tag.atomic_swap(FREED)
    when
        was == LIVE =>
            turn: USize = QUARANTINE_NEXT.atomic_fetch_add(1)
            slot: @Addr = QUARANTINE.getslot(turn & QUARANTINE_MASK)
            evicted: Addr = slot.atomic_swap(header)
            if evicted.is_null()
                return
            c_free(evicted.to[@BlockHeader]().raw.peek())
            return
        was == FREED => heap_crash(name: "DoubleFreeError", message: "This block was already freed: it was freed twice.")
        else => heap_crash(name: "InvalidValueError", message: "The default heap was asked to free memory that isn't a block it gave out.")

### Crashes at the place of the deallocate or reallocate call that reached the heap, when one was noted, else at the
### heap itself.
### :param name: The crash's error name, such as `DoubleFreeError`.
### :param message: The crash message.
### :throws: Always crashes with the error `name`.
@heap_check("on")
@noreturn
private routine heap_crash(name: Span[Byte], message: Span[Byte]) -> None
    place: @SourceLocation = allocator_call_place()
    if place.is_not_null()
        crash_at(name, message, place)
    else
        crash(name, message)
