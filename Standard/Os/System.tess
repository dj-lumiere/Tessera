# Tessera stdlib: what the machine has
#
# The memory page size, what a mapping's offset aligns to, and the physical memory, for code that sizes its work by
# them (a reader decides how much to prefetch from the memory there is).

module Standard/Os

### SYSTEM_INFO
@target(os: "windows")
private record SystemInfo
    architecture: U16
    reserved: U16
    page_size: U32
    min_address: Addr
    max_address: Addr
    processor_mask: USize
    processors: U32
    processor_type: U32
    granularity: U32
    level: U16
    revision: U16

### MEMORYSTATUSEX
@target(os: "windows")
private record MemoryStatus
    length: U32
    load: U32
    total_phys: U64
    avail_phys: U64
    total_file: U64
    avail_file: U64
    total_virtual: U64
    avail_virtual: U64
    avail_extended: U64

### Makes a `SystemInfo` from its fields.
### :param architecture: Its `architecture`.
### :param reserved: Its `reserved`.
### :param page_size: Its `page_size`.
### :param min_address: Its `min_address`.
### :param max_address: Its `max_address`.
### :param processor_mask: Its `processor_mask`.
### :param processors: Its `processors`.
### :param processor_type: Its `processor_type`.
### :param granularity: Its `granularity`.
### :param level: Its `level`.
### :param revision: Its `revision`.
### :returns: The new value.
@target(os: "windows")
private routine SystemInfo.construct(architecture: U16, reserved: U16, page_size: U32,
    min_address: Addr, max_address: Addr, processor_mask: USize, processors: U32,
    processor_type: U32, granularity: U32, level: U16, revision: U16) -> Me
    return Me(architecture, reserved, page_size, min_address, max_address, processor_mask,
        processors, processor_type, granularity, level, revision)

### Releases nothing: a `SystemInfo` holds no memory of its own.
@target(os: "windows")
private routine SystemInfo.destruct(me: @Me) -> None
    return

### Makes a `MemoryStatus` from its fields.
### :param length: Its `length`.
### :param load: Its `load`.
### :param total_phys: Its `total_phys`.
### :param avail_phys: Its `avail_phys`.
### :param total_file: Its `total_file`.
### :param avail_file: Its `avail_file`.
### :param total_virtual: Its `total_virtual`.
### :param avail_virtual: Its `avail_virtual`.
### :param avail_extended: Its `avail_extended`.
### :returns: The new value.
@target(os: "windows")
private routine MemoryStatus.construct(length: U32, load: U32, total_phys: U64, avail_phys: U64,
    total_file: U64, avail_file: U64, total_virtual: U64, avail_virtual: U64,
    avail_extended: U64) -> Me
    return Me(length, load, total_phys, avail_phys, total_file, avail_file, total_virtual,
        avail_virtual, avail_extended)

### Binds the C `sysconf` function, which reads a system setting.
### :param name: The setting's `_SC_*` number.
### :returns: The setting's value, or -1 when it can't be told.
@external("c")
@symbol("sysconf")
@target(os: ("linux", "macos"))
private routine c_sysconf(name: CInt) -> CLong

### _SC_PAGESIZE and _SC_PHYS_PAGES, whose numbers differ between Linux and macOS.
### :returns: The two numbers, _SC_PAGESIZE first.
@target(os: "linux")
private routine sc_numbers() -> (CInt, CInt)
    return (30, 85)

### _SC_PAGESIZE and _SC_PHYS_PAGES, whose numbers differ between Linux and macOS.
### :returns: The two numbers, _SC_PAGESIZE first.
@target(os: "macos")
private routine sc_numbers() -> (CInt, CInt)
    return (29, 200)

### The memory page size.
### :returns: The page size in bytes (4096 when sysconf can't tell it).
@target(os: ("linux", "macos"))
routine page_size() -> USize
    page, phys = sc_numbers()
    size: CLong = c_sysconf(page)
    if size > 0
        return size.to[USize]()
    else
        return 4096

### What a memory mapping's file offset must be a multiple of: the page size.
### :returns: The granularity in bytes.
@target(os: ("linux", "macos"))
routine map_granularity() -> USize
    return page_size()

### The physical memory in bytes, or 0 when it can't be told.
### :returns: The physical memory in bytes, or 0.
@target(os: ("linux", "macos"))
routine physical_memory() -> U64
    page, phys = sc_numbers()
    pages: CLong = c_sysconf(phys)
    if pages > 0
        return pages.to[U64]() *% page_size().to[U64]()
    else
        return 0

### Binds the Win32 `GetSystemInfo` function, which describes the machine.
### :param info: Where the description goes.
@external("c")
@symbol("GetSystemInfo")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_system_info(info: @SystemInfo) -> None

### Binds the Win32 `GlobalMemoryStatusEx` function, which reports the physical and virtual memory.
### :param status: Where the report goes, its `length` set to the record's size first.
### :returns: Nonzero on success, 0 with the last error set.
@external("c")
@symbol("GlobalMemoryStatusEx")
@callconv("stdcall")
@target(os: "windows")
private routine c_global_memory_status_ex(status: @MemoryStatus) -> CInt

### The memory page size.
### :returns: The page size in bytes.
@target(os: "windows")
routine page_size() -> USize
    local info: @SystemInfo <- .hollow()

    c_get_system_info(info)
    return info.page_size.peek().to[USize]()

### What a memory mapping's file offset must be a multiple of: the allocation granularity (64 KiB), coarser than the
### page.
### :returns: The granularity in bytes.
@target(os: "windows")
routine map_granularity() -> USize
    local info: @SystemInfo <- .hollow()

    c_get_system_info(info)
    return info.granularity.peek().to[USize]()

### The physical memory in bytes, or 0 when it can't be told.
### :returns: The physical memory in bytes, or 0.
@target(os: "windows")
routine physical_memory() -> U64
    local status: @MemoryStatus <- .hollow()

    status.length.poke(sizeof[MemoryStatus]().to[U32]())
    if c_global_memory_status_ex(status) != 0
        return status.total_phys.peek()
    else
        return 0
