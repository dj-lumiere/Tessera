// Tessera stdlib: files and the filesystem on Linux and macOS (see Fs.tess)
//
// Metadata on Linux comes from statx, whose struct is the same on every architecture and word size and has the
// creation time; on macOS from the 64-bit-inode stat ($INODE64 on x86-64). Linux's calls are the 64-bit-offset ones
// (open64, lseek64, ...), so a 32-bit build handles files past 2 GiB too.

module Standard::Os

import Standard::Alloc

// -- the C library -------------------------------------------------------------------

/// Binds the C `__errno_location` function.
#[external("c"), symbol("__errno_location"), target(os: "linux")]
private routine c_errno_place() -> @CInt

/// Binds the C `__error` function.
#[external("c"), symbol("__error"), target(os: "macos")]
private routine c_errno_place() -> @CInt

/// Binds the C `open64` function.
#[external("c"), symbol("open64"), variadic, target(os: "linux")]
private routine c_open(path: @Byte, flags: CInt) -> CInt

/// Binds the C `open` function.
#[external("c"), symbol("open"), variadic, target(os: "macos")]
private routine c_open(path: @Byte, flags: CInt) -> CInt

/// Binds the C `close` function.
#[external("c"), symbol("close"), target(os: ("linux", "macos"))]
private routine c_close(fd: CInt) -> CInt

/// Binds the C `lseek64` function.
#[external("c"), symbol("lseek64"), target(os: "linux")]
private routine c_lseek(fd: CInt, offset: S64, whence: CInt) -> S64

/// Binds the C `lseek` function.
#[external("c"), symbol("lseek"), target(os: "macos")]
private routine c_lseek(fd: CInt, offset: S64, whence: CInt) -> S64

/// Binds the C `ftruncate64` function.
#[external("c"), symbol("ftruncate64"), target(os: "linux")]
private routine c_ftruncate(fd: CInt, size: S64) -> CInt

/// Binds the C `ftruncate` function.
#[external("c"), symbol("ftruncate"), target(os: "macos")]
private routine c_ftruncate(fd: CInt, size: S64) -> CInt

/// Binds the C `fsync` function.
#[external("c"), symbol("fsync"), target(os: ("linux", "macos"))]
private routine c_fsync(fd: CInt) -> CInt

/// Binds the C `mkdir` function.
#[external("c"), symbol("mkdir"), target(os: "linux")]
