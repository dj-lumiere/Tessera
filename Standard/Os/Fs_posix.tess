/// Binds the C `chmod` function.
#[external("c"), symbol("chmod"), target(os: "macos")]
private routine c_chmod(path: @Byte, mode: U16) -> CInt

/// Binds the C `fchmod` function.
#[external("c"), symbol("fchmod"), target(os: "linux")]
