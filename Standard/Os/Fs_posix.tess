// Tessera stdlib: files and the filesystem on Linux and macOS (see Fs.tess)
//
// Metadata on Linux comes from statx, whose struct is the same on every architecture and word size and has the
// creation time, on macOS from the 64-bit-inode stat ($INODE64 on x86-64). Linux's calls are the 64-bit-offset ones
// (open64, lseek64, ...), so a 32-bit build handles files past 2 GiB too.

module Standard::Os

import Standard::Alloc

// -- the C library -------------------------------------------------------------------

/// Binds the C `__errno_location` function: where the calling thread's `errno` is.
/// :returns: The address of `errno`.
#[external("c"), symbol("__errno_location"), target(os: "linux")]
private routine c_errno_place() -> @CInt

/// Binds the C `__error` function: where the calling thread's `errno` is.
/// :returns: The address of `errno`.
#[external("c"), symbol("__error"), target(os: "macos")]
private routine c_errno_place() -> @CInt

/// Binds the C `open64` function: opens or creates a file. A third, variadic argument gives the permission bits of a
/// file it creates.
/// :param path: The NUL-terminated path.
/// :param flags: The `O_*` flags.
/// :returns: The new file descriptor, or -1 with `errno` set.
#[external("c"), symbol("open64"), variadic, target(os: "linux")]
private routine c_open(path: @Byte, flags: CInt) -> CInt

/// Binds the C `open` function: opens or creates a file. A third, variadic argument gives the permission bits of a
/// file it creates.
/// :param path: The NUL-terminated path.
/// :param flags: The `O_*` flags.
/// :returns: The new file descriptor, or -1 with `errno` set.
#[external("c"), symbol("open"), variadic, target(os: "macos")]
private routine c_open(path: @Byte, flags: CInt) -> CInt

/// Binds the C `close` function: closes a file descriptor.
/// :param fd: The descriptor to close.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("close"), target(os: ("linux", "macos"))]
private routine c_close(fd: CInt) -> CInt

/// Binds the C `lseek64` function: moves a descriptor's file position.
/// :param fd: The open file.
/// :param offset: The distance to move.
/// :param whence: Where `offset` counts from: 0 the start, 1 the current position, 2 the end.
/// :returns: The new position from the start, or -1 with `errno` set.
#[external("c"), symbol("lseek64"), target(os: "linux")]
private routine c_lseek(fd: CInt, offset: S64, whence: CInt) -> S64

/// Binds the C `lseek` function: moves a descriptor's file position.
/// :param fd: The open file.
/// :param offset: The distance to move.
/// :param whence: Where `offset` counts from: 0 the start, 1 the current position, 2 the end.
/// :returns: The new position from the start, or -1 with `errno` set.
#[external("c"), symbol("lseek"), target(os: "macos")]
private routine c_lseek(fd: CInt, offset: S64, whence: CInt) -> S64

/// Binds the C `ftruncate64` function: cuts a file to a size, or extends it with zeros.
/// :param fd: The open file.
/// :param size: The new size in bytes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("ftruncate64"), target(os: "linux")]
private routine c_ftruncate(fd: CInt, size: S64) -> CInt

/// Binds the C `ftruncate` function: cuts a file to a size, or extends it with zeros.
/// :param fd: The open file.
/// :param size: The new size in bytes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("ftruncate"), target(os: "macos")]
private routine c_ftruncate(fd: CInt, size: S64) -> CInt

/// Binds the C `fsync` function: waits until a file's written data is on the storage device.
/// :param fd: The open file.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("fsync"), target(os: ("linux", "macos"))]
private routine c_fsync(fd: CInt) -> CInt

/// Binds the C `mkdir` function: makes a directory.
/// :param path: The NUL-terminated path of the new directory.
/// :param mode: Its permission bits, before the umask.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("mkdir"), target(os: "linux")]
private routine c_mkdir(path: @Byte, mode: U32) -> CInt

/// Binds the C `mkdir` function: makes a directory.
/// :param path: The NUL-terminated path of the new directory.
/// :param mode: Its permission bits, before the umask.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("mkdir"), target(os: "macos")]
private routine c_mkdir(path: @Byte, mode: U16) -> CInt

/// Binds the C `chmod` function: sets a file's permission bits.
/// :param path: The NUL-terminated path, a link followed.
/// :param mode: The new permission bits.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("chmod"), target(os: "linux")]
private routine c_chmod(path: @Byte, mode: U32) -> CInt

/// Binds the C `chmod` function: sets a file's permission bits.
/// :param path: The NUL-terminated path, a link followed.
/// :param mode: The new permission bits.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("chmod"), target(os: "macos")]
private routine c_chmod(path: @Byte, mode: U16) -> CInt

/// Binds the C `fchmod` function: sets the permission bits of an open file.
/// :param fd: The open file.
/// :param mode: The new permission bits.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("fchmod"), target(os: "linux")]
private routine c_fchmod(fd: CInt, mode: U32) -> CInt

/// Binds the C `fchmod` function: sets the permission bits of an open file.
/// :param fd: The open file.
/// :param mode: The new permission bits.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("fchmod"), target(os: "macos")]
private routine c_fchmod(fd: CInt, mode: U16) -> CInt

/// Binds the C `rmdir` function: removes an empty directory.
/// :param path: The NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("rmdir"), target(os: ("linux", "macos"))]
private routine c_rmdir(path: @Byte) -> CInt

/// Binds the C `unlink` function: removes a file or a link, not a directory.
/// :param path: The NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("unlink"), target(os: ("linux", "macos"))]
private routine c_unlink(path: @Byte) -> CInt

/// Binds the C `rename` function: renames a file or directory, replacing what is at the new name.
/// :param from: The current NUL-terminated path.
/// :param to: The new NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("rename"), target(os: ("linux", "macos"))]
private routine c_rename(from: @Byte, to: @Byte) -> CInt

/// Binds the C `renameat2` function: renames a file or directory, with flags such as `RENAME_NOREPLACE`.
/// :param from_dir: The directory `from` is relative to, `AT_FDCWD` for the working directory.
/// :param from: The current NUL-terminated path.
/// :param to_dir: The directory `to` is relative to, `AT_FDCWD` for the working directory.
/// :param to: The new NUL-terminated path.
/// :param flags: The `RENAME_*` flags.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("renameat2"), target(os: "linux")]
private routine c_renameat2(from_dir: CInt, from: @Byte, to_dir: CInt, to: @Byte,
    flags: U32) -> CInt

/// Binds the C `renamex_np` function: renames a file or directory, with flags such as `RENAME_EXCL`.
/// :param from: The current NUL-terminated path.
/// :param to: The new NUL-terminated path.
/// :param flags: The `RENAME_*` flags.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("renamex_np"), target(os: "macos")]
private routine c_renamex_np(from: @Byte, to: @Byte, flags: U32) -> CInt

/// Binds the C `access` function: checks whether this process may read, write, or run a file.
/// :param path: The NUL-terminated path.
/// :param mode: `R_OK` (4), `W_OK` (2), `X_OK` (1), or `F_OK` (0) to ask only whether it exists.
/// :returns: 0 when allowed, or -1 with `errno` set.
#[external("c"), symbol("access"), target(os: ("linux", "macos"))]
private routine c_access(path: @Byte, mode: CInt) -> CInt

/// Binds the C `utimes` function: sets a file's access and modification times.
/// :param path: The NUL-terminated path.
/// :param times: Two `struct timeval`s, or null for now.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("utimes"), target(os: ("linux", "macos"))]
private routine c_utimes(path: @Byte, times: Addr) -> CInt

/// Binds the C `getcwd` function: copies the working directory, NUL-terminated, into a buffer.
/// :param buf: The buffer.
/// :param size: Its size in bytes.
/// :returns: `buf`, or null with `errno` set (`ERANGE` when the buffer is too small).
#[external("c"), symbol("getcwd"), target(os: ("linux", "macos"))]
private routine c_getcwd(buf: @Byte, size: USize) -> @Byte

/// Binds the C `chdir` function: changes the working directory.
/// :param path: The NUL-terminated path of the new working directory.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("chdir"), target(os: ("linux", "macos"))]
private routine c_chdir(path: @Byte) -> CInt

/// Binds the C `getenv` function: looks up an environment variable.
/// :param name: The variable's name.
/// :returns: Its NUL-terminated value, owned by the C library, or null when it isn't set.
#[external("c"), symbol("getenv"), target(os: ("linux", "macos"))]
private routine c_getenv(name: CStr) -> @Byte

/// Binds the C `realpath` function: makes a path absolute with every link, ".", and ".." resolved.
/// :param path: The NUL-terminated path, which must exist.
/// :param resolved: A buffer of `PATH_MAX` bytes, or null to get memory from C's malloc.
/// :returns: The resolved path, or null with `errno` set.
#[external("c"), symbol("realpath"), target(os: ("linux", "macos"))]
private routine c_realpath(path: @Byte, resolved: Addr) -> @Byte

/// Binds the C `free` function: gives memory from C's malloc back.
/// :param ptr: The memory, or null.
#[external("c"), symbol("free"), target(os: ("linux", "macos"))]
private routine c_free(ptr: Addr) -> Void

/// Binds the C `opendir` function: opens a directory listing.
/// :param path: The NUL-terminated path of the directory.
/// :returns: A `DIR` handle, or null with `errno` set.
#[external("c"), symbol("opendir"), target(os: "linux")]
private routine c_opendir(path: @Byte) -> Addr

/// Binds the C `opendir$INODE64` function: opens a directory listing.
/// :param path: The NUL-terminated path of the directory.
/// :returns: A `DIR` handle, or null with `errno` set.
#[external("c"), symbol("opendir$INODE64"), target(os: "macos", arch: "x86_64")]
private routine c_opendir(path: @Byte) -> Addr

/// Binds the C `opendir` function: opens a directory listing.
/// :param path: The NUL-terminated path of the directory.
/// :returns: A `DIR` handle, or null with `errno` set.
#[external("c"), symbol("opendir"), target(os: "macos", arch: not "x86_64")]
private routine c_opendir(path: @Byte) -> Addr

/// Binds the C `readdir64` function: reads the next entry of a directory listing.
/// :param dir: The `DIR` handle.
/// :returns: The entry's `struct dirent64`, valid until the next call, or null at the end or on an error.
#[external("c"), symbol("readdir64"), target(os: "linux")]
private routine c_readdir(dir: Addr) -> @Byte

/// Binds the C `readdir$INODE64` function: reads the next entry of a directory listing.
/// :param dir: The `DIR` handle.
/// :returns: The entry's `struct dirent`, valid until the next call, or null at the end or on an error.
#[external("c"), symbol("readdir$INODE64"), target(os: "macos", arch: "x86_64")]
private routine c_readdir(dir: Addr) -> @Byte

/// Binds the C `readdir` function: reads the next entry of a directory listing.
/// :param dir: The `DIR` handle.
/// :returns: The entry's `struct dirent`, valid until the next call, or null at the end or on an error.
#[external("c"), symbol("readdir"), target(os: "macos", arch: not "x86_64")]
private routine c_readdir(dir: Addr) -> @Byte

/// Binds the C `closedir` function: closes a directory listing.
/// :param dir: The `DIR` handle.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("closedir"), target(os: ("linux", "macos"))]
private routine c_closedir(dir: Addr) -> CInt

/// Binds the C `mmap64` function: maps part of a file into memory.
/// :param addr: Where to put the mapping, or null to let the OS choose.
/// :param length: The bytes to map.
/// :param prot: The `PROT_*` flags.
/// :param flags: `MAP_SHARED` or `MAP_PRIVATE`, with other `MAP_*` flags.
/// :param fd: The open file.
/// :param offset: Where in the file to start, a multiple of the page size.
/// :returns: The mapping's address, or `MAP_FAILED` (all ones) with `errno` set.
#[external("c"), symbol("mmap64"), target(os: "linux")]
private routine c_mmap(addr: Addr, length: USize, prot: CInt, flags: CInt, fd: CInt,
    offset: S64) -> Addr

/// Binds the C `mmap` function: maps part of a file into memory.
/// :param addr: Where to put the mapping, or null to let the OS choose.
/// :param length: The bytes to map.
/// :param prot: The `PROT_*` flags.
/// :param flags: `MAP_SHARED` or `MAP_PRIVATE`, with other `MAP_*` flags.
/// :param fd: The open file.
/// :param offset: Where in the file to start, a multiple of the page size.
/// :returns: The mapping's address, or `MAP_FAILED` (all ones) with `errno` set.
#[external("c"), symbol("mmap"), target(os: "macos")]
private routine c_mmap(addr: Addr, length: USize, prot: CInt, flags: CInt, fd: CInt,
    offset: S64) -> Addr

/// Binds the C `munmap` function: removes a mapping.
/// :param addr: The mapping's address.
/// :param length: Its length in bytes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("munmap"), target(os: ("linux", "macos"))]
private routine c_munmap(addr: Addr, length: USize) -> CInt

/// Binds the C `msync` function: writes a mapping's changed pages back to its file.
/// :param addr: The mapping's address.
/// :param length: The bytes to write back.
/// :param flags: `MS_SYNC` to wait for the write, or `MS_ASYNC`.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("msync"), target(os: ("linux", "macos"))]
private routine c_msync(addr: Addr, length: USize, flags: CInt) -> CInt

/// Binds the C `madvise` function: tells the OS how a mapping will be used.
/// :param addr: The mapping's address.
/// :param length: The bytes the advice covers.
/// :param advice: An `MADV_*` value.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("madvise"), target(os: ("linux", "macos"))]
private routine c_madvise(addr: Addr, length: USize, advice: CInt) -> CInt

// -- the numbers that differ between Linux and macOS --------------------------------------

/// O_CREAT, O_TRUNC, O_APPEND, O_EXCL, O_CLOEXEC (O_RDONLY 0, O_WRONLY 1, O_RDWR 2 everywhere).
private record OpenFlags
    create   : CInt
    truncate : CInt
    append   : CInt
    exclude  : CInt
    cloexec  : CInt

/// ENAMETOOLONG, ENOTEMPTY, ELOOP, and what renameat2 / renamex_np fail with when the filesystem can't do it.
private record ErrnoNumbers
    name_too_long : CInt
    not_empty     : CInt
    loop          : CInt
    unsupported   : CInt

/// The `O_*` open flags whose values differ, Linux's.
/// :returns: `O_CREAT`, `O_TRUNC`, `O_APPEND`, `O_EXCL`, and `O_CLOEXEC` on Linux.
#target(os: "linux")
private routine open_flags() -> OpenFlags
    block entry()
        return(OpenFlags { create: 0x40, truncate: 0x200, append: 0x400, exclude: 0x80,
            cloexec: 0x80000 })

/// The `O_*` open flags whose values differ, macOS's.
/// :returns: `O_CREAT`, `O_TRUNC`, `O_APPEND`, `O_EXCL`, and `O_CLOEXEC` on macOS.
#target(os: "macos")
private routine open_flags() -> OpenFlags
    block entry()
        return(OpenFlags { create: 0x200, truncate: 0x400, append: 0x8, exclude: 0x800,
            cloexec: 0x1000000 })

/// The errno values that differ between Linux and macOS, Linux's.
/// :returns: `ENAMETOOLONG`, `ENOTEMPTY`, `ELOOP`, and `ENOSYS` as the unsupported one.
#target(os: "linux")
private routine errno_numbers() -> ErrnoNumbers
    block entry()
        // ENOSYS for unsupported (EINVAL is checked too)
        return(ErrnoNumbers { name_too_long: 36, not_empty: 39, loop: 40, unsupported: 38 })

/// The errno values that differ between Linux and macOS, macOS's.
/// :returns: `ENAMETOOLONG`, `ENOTEMPTY`, `ELOOP`, and `ENOTSUP` as the unsupported one.
#target(os: "macos")
private routine errno_numbers() -> ErrnoNumbers
    block entry()
        // ENOTSUP for unsupported
        return(ErrnoNumbers { name_too_long: 63, not_empty: 66, loop: 62, unsupported: 45 })

/// The `MS_SYNC` flag of msync on Linux.
/// :returns: 4.
#target(os: "linux")
private routine ms_sync() -> CInt
    block entry()
        return(4)

/// The `MS_SYNC` flag of msync on macOS.
/// :returns: 0x10.
#target(os: "macos")
private routine ms_sync() -> CInt
    block entry()
        return(0x10)

/// Where a Linux `struct dirent64` (readdir64's) has `d_type`.
/// :returns: The byte offset 18.
#target(os: "linux")
private routine dirent_type_at() -> USize
    block entry()
        return(18)

/// Where a macOS `struct dirent` (64-bit inodes) has `d_type`.
/// :returns: The byte offset 20.
#target(os: "macos")
private routine dirent_type_at() -> USize
    block entry()
        return(20)

/// Where a Linux `struct dirent64` (readdir64's) has `d_name`.
/// :returns: The byte offset 19.
#target(os: "linux")
private routine dirent_name_at() -> USize
    block entry()
        return(19)

/// Where a macOS `struct dirent` (64-bit inodes) has `d_name`.
/// :returns: The byte offset 21.
#target(os: "macos")
private routine dirent_name_at() -> USize
    block entry()
        return(21)

// -- errors and paths ----------------------------------------------------------------

/// The calling thread's `errno`.
/// :returns: The value of `errno`.
#target(os: ("linux", "macos"))
private routine errno() -> CInt
    block entry()
        return(c_errno_place().load())

/// The FsError for an errno value.
/// :param e: The errno value.
/// :returns: The matching FsError, `Other` for a value with no match.
#target(os: ("linux", "macos"))
private routine error_of(e: CInt) -> FsError
    block entry()
        n : ErrnoNumbers = errno_numbers()
        when
            e.eq(2)                      -> return(FsError.NotFound)
            e.eq(1).bitor(e.eq(13))      -> return(FsError.PermissionDenied)
            e.eq(17)                     -> return(FsError.AlreadyExists)
            e.eq(20)                     -> return(FsError.NotADirectory)
            e.eq(21)                     -> return(FsError.IsADirectory)
            e.eq(n.not_empty)            -> return(FsError.DirectoryNotEmpty)
            e.eq(18)                     -> return(FsError.CrossDevice)
            e.eq(n.name_too_long)        -> return(FsError.NameTooLong)
            e.eq(22).bitor(e.eq(n.loop)) -> return(FsError.InvalidPath)
            e.eq(28)                     -> return(FsError.NoSpace)
            e.eq(30)                     -> return(FsError.ReadOnly)
            e.eq(16).bitor(e.eq(26))     -> return(FsError.Busy)
            e.eq(12)                     -> return(FsError.OutOfMemory)
            else                         -> return(FsError.Other)

/// The FsError for the calling thread's `errno`.
/// :returns: The matching FsError.
#target(os: ("linux", "macos"))
private routine last_error() -> FsError
    block entry()
        return(error_of(errno()))

/// A failure carrying the FsError for the calling thread's `errno`.
/// :typeparam T: The success type of the result.
/// :returns: `Failure` with that FsError.
#target(os: ("linux", "macos"))
private routine failed<T>() -> Result<T, FsError>
require T: typename
    block entry()
        return(.Failure(last_error()))

/// A C return code as a result: 0 is success, anything else the last error.
/// :param rc: The return code.
/// :returns: `Success(Unit)` for 0, else `Failure` with the FsError for `errno`.
#target(os: ("linux", "macos"))
private routine checked(rc: CInt) -> Result<Unit, FsError>
    block entry()
        branch rc.eq(0)
            ? return(fs_done())
            : return(failed<Unit>())

/// path with a NUL after it in out (PATH_CAPACITY bytes): false if path has a NUL or doesn't fit.
/// :param path: The path to copy.
/// :param out: The buffer, `PATH_CAPACITY` bytes.
/// :returns: True when `path` was copied.
#target(os: ("linux", "macos"))
private routine c_path(path: Bytes, out: @Byte) -> Bool
    block entry()
        n : USize = path.count()
        branch n.ge(PATH_CAPACITY)
            ? return(false)
            : continue
        branch path.has("\x00")
            ? return(false)
            : continue
        out.copy(path.data, n)
        out.stride(n).store(0x00)
        return(true)

/// dir, a '/', and name (NUL-terminated) in out: false if it doesn't fit.
/// :param dir: The directory's bytes, no NUL needed.
/// :param dir_count: How many bytes of `dir` to use.
/// :param name: The NUL-terminated entry name.
/// :param out: The buffer, `PATH_CAPACITY` bytes.
/// :returns: True when the path fit.
#target(os: ("linux", "macos"))
private routine c_child_path(dir: @Byte, dir_count: USize, name: @Byte, out: @Byte) -> Bool
    block entry()
        name_count : USize = name.to<CStr>().count()
        total      : USize = dir_count.add(1).add(name_count)
        branch total.ge(PATH_CAPACITY)
            ? return(false)
            : continue
        out.copy(dir, dir_count)
        out.stride(dir_count).store(b'/')
        out.stride(dir_count.add(1)).copy(name, name_count)
        out.stride(total).store(0x00)
        return(true)

// -- metadata ------------------------------------------------------------------------

// AT_FDCWD, AT_SYMLINK_NOFOLLOW, AT_EMPTY_PATH, and STATX_BASIC_STATS | STATX_BTIME
preset AT_FDCWD:            CInt = -100
preset AT_SYMLINK_NOFOLLOW: CInt = 0x100
preset AT_EMPTY_PATH:       CInt = 0x1000
preset STATX_WANTED:        U32  = 0xFFF
preset STATX_BTIME:         U32  = 0x800

/// struct statx_timestamp
#target(os: "linux")
private record StatxTime
    sec      : S64
    nsec     : U32
    reserved : S32

/// struct statx: 256 bytes on every architecture.
#target(os: "linux")
private record Statx
    mask            : U32
    blksize         : U32
    attributes      : U64
    nlink           : U32
    uid             : U32
    gid             : U32
    mode            : U16
    spare0          : U16
    ino             : U64
    size            : U64
    blocks          : U64
    attributes_mask : U64
    atime           : StatxTime
    btime           : StatxTime
    ctime           : StatxTime
    mtime           : StatxTime
    spare           : Array<U64, 16>

/// struct stat with 64-bit inodes.
#target(os: "macos")
private record DarwinStat
    dev       : S32
    mode      : U16
    nlink     : U16
    ino       : U64
    uid       : U32
    gid       : U32
    rdev      : S32
    atime     : Timespec
    mtime     : Timespec
    ctime     : Timespec
    birthtime : Timespec
    size      : S64
    blocks    : S64
    blksize   : S32
    flags     : U32
    gen       : U32
    lspare    : S32
    qspare    : Array<S64, 2>

/// The FileKind for a `st_mode` value, by its `S_IFMT` bits.
/// :param mode: The mode, type bits included.
/// :returns: `File`, `Directory`, `Symlink`, or `Other`.
#target(os: ("linux", "macos"))
private routine mode_kind(mode: U32) -> FileKind
    block entry()
        // S_IFMT
        when mode.bitand(0o170000)
            0o100000 -> return(FileKind.File)
            0o040000 -> return(FileKind.Directory)
            0o120000 -> return(FileKind.Symlink)
            else     -> return(FileKind.Other)

/// Seconds and nanoseconds as nanoseconds since 1970, wrapping on overflow.
/// :param sec: The seconds.
/// :param nsec: The nanoseconds.
/// :returns: `sec * 1000000000 + nsec`.
#target(os: ("linux", "macos"))
private routine ns_of(sec: S64, nsec: S64) -> S64
    block entry()
        return(sec.mul_wrap(1000000000).add_wrap(nsec))

/// Binds the C `statx` function: reads a file's metadata into a `struct statx`.
/// :param dir: The directory `path` is relative to (`AT_FDCWD`), or the open file itself with `AT_EMPTY_PATH`.
/// :param path: The NUL-terminated path.
/// :param flags: The `AT_*` flags.
/// :param mask: The `STATX_*` fields wanted.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("statx"), target(os: "linux")]
private routine c_statx(dir: CInt, path: @Byte, flags: CInt, mask: U32, out: @Statx) -> CInt

/// The Metadata in a `struct statx`. The creation time is Absent when the filesystem didn't fill `btime`, and
/// read-only means the owner has no write permission.
/// :returns: The metadata.
#target(os: "linux")
private routine Statx.to<Metadata>(me: Me) -> Metadata
    block entry()
        mode     : U32         = me.mode.to<U32>()
        modified : S64         = ns_of(me.mtime.sec, me.mtime.nsec.to<S64>())
        born     : Bool        = me.mask.bitand(STATX_BTIME).ne(0)
        created  : Option<S64> = born
            ? Option<S64>.Present(ns_of(me.btime.sec, me.btime.nsec.to<S64>()))
            : .Absent
        return(Metadata { kind: mode_kind(mode), size: me.size, modified_ns: modified,
            created_ns: created, readonly: mode.bitand(0o200).eq(0) })

/// statx of dir + path with flags: the raw struct.
/// :param dir: The directory `cpath` is relative to, or the open file with `AT_EMPTY_PATH`.
/// :param cpath: The NUL-terminated path.
/// :param flags: The `AT_*` flags.
/// :param out: Where the struct goes.
/// :returns: True when statx succeeded.
#target(os: "linux")
private routine stat_raw(dir: CInt, cpath: @Byte, flags: CInt, out: @Statx) -> Bool
    block entry()
        return(c_statx(dir, cpath, flags, STATX_WANTED, out).eq(0))

/// The metadata of the NUL-terminated cpath.
/// :param cpath: The NUL-terminated path.
/// :param follow: True to describe what a link points at, false to describe the link itself.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the FsError for `errno` when statx fails.
#target(os: "linux")
private routine metadata_of(cpath: @Byte, follow: Bool) -> Result<Metadata, FsError>
    block entry()
        claim st : @Statx <- uninit
        flags : CInt = follow
            ? 0
            : AT_SYMLINK_NOFOLLOW
        branch stat_raw(AT_FDCWD, cpath, flags, st)
            ? return(.Success(st.load().to<Metadata>()))
            : return(failed<Metadata>())

/// The metadata of the open file fd.
/// :param fd: The open file.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the FsError for `errno` when statx fails.
#target(os: "linux")
private routine fd_metadata(fd: CInt) -> Result<Metadata, FsError>
    block entry()
        claim st : @Statx <- uninit
        branch stat_raw(fd, "", AT_EMPTY_PATH, st)
            ? return(.Success(st.load().to<Metadata>()))
            : return(failed<Metadata>())

/// The permission bits of the open file fd, or 0o666 when they can't be read.
/// :param fd: The open file.
/// :returns: The permission bits, `S_IFMT` left out.
#target(os: "linux")
private routine fd_mode(fd: CInt) -> U32
    shared st : @Statx <- uninit

    block entry()
        branch stat_raw(fd, "", AT_EMPTY_PATH, st)
            ? permission_bits()
            : return(0o666)

    block permission_bits()
        mode : U32 = st.mode.load().to<U32>()
        return(mode.bitand(0o7777))

/// The `st_mode` of the NUL-terminated cpath, a link followed.
/// :param cpath: The NUL-terminated path.
/// :returns: The mode, type bits included.
/// :absent: When statx fails.
#target(os: "linux")
private routine path_mode(cpath: @Byte) -> Option<U32>
    block entry()
        claim st : @Statx <- uninit
        branch stat_raw(AT_FDCWD, cpath, 0, st)
            ? return(.Present(st.mode.load().to<U32>()))
            : return(.Absent)

/// Binds the C `stat$INODE64` function: reads a file's metadata, a link followed.
/// :param path: The NUL-terminated path.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("stat$INODE64"), target(os: "macos", arch: "x86_64")]
private routine c_stat(path: @Byte, out: @DarwinStat) -> CInt

/// Binds the C `stat` function: reads a file's metadata, a link followed.
/// :param path: The NUL-terminated path.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("stat"), target(os: "macos", arch: not "x86_64")]
private routine c_stat(path: @Byte, out: @DarwinStat) -> CInt

/// Binds the C `lstat$INODE64` function: reads a file's metadata, a link describing itself.
/// :param path: The NUL-terminated path.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("lstat$INODE64"), target(os: "macos", arch: "x86_64")]
private routine c_lstat(path: @Byte, out: @DarwinStat) -> CInt

/// Binds the C `lstat` function: reads a file's metadata, a link describing itself.
/// :param path: The NUL-terminated path.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("lstat"), target(os: "macos", arch: not "x86_64")]
private routine c_lstat(path: @Byte, out: @DarwinStat) -> CInt

/// Binds the C `fstat$INODE64` function: reads the metadata of an open file.
/// :param fd: The open file.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("fstat$INODE64"), target(os: "macos", arch: "x86_64")]
private routine c_fstat(fd: CInt, out: @DarwinStat) -> CInt

/// Binds the C `fstat` function: reads the metadata of an open file.
/// :param fd: The open file.
/// :param out: Where the struct goes.
/// :returns: 0, or -1 with `errno` set.
#[external("c"), symbol("fstat"), target(os: "macos", arch: not "x86_64")]
private routine c_fstat(fd: CInt, out: @DarwinStat) -> CInt

/// The Metadata in a macOS `struct stat`, the birth time as the creation time. Read-only means the owner has no
/// write permission.
/// :returns: The metadata.
#target(os: "macos")
private routine DarwinStat.to<Metadata>(me: Me) -> Metadata
    block entry()
        mode     : U32 = me.mode.to<U32>()
        modified : S64 = ns_of(me.mtime.sec, me.mtime.nsec)
        created  : S64 = ns_of(me.birthtime.sec, me.birthtime.nsec)
        return(Metadata { kind: mode_kind(mode), size: me.size.to_wrap<U64>(),
            modified_ns: modified, created_ns: .Present(created),
            readonly: mode.bitand(0o200).eq(0) })

/// The metadata of the NUL-terminated cpath.
/// :param cpath: The NUL-terminated path.
/// :param follow: True to describe what a link points at (stat), false to describe the link itself (lstat).
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the FsError for `errno` when the call fails.
#target(os: "macos")
private routine metadata_of(cpath: @Byte, follow: Bool) -> Result<Metadata, FsError>
    shared st : @DarwinStat <- uninit

    block entry()
        branch follow
            ? got(c_stat(cpath, st))
            : got(c_lstat(cpath, st))

    block got(rc: CInt)
        branch rc.eq(0)
            ? return(.Success(st.load().to<Metadata>()))
            : return(failed<Metadata>())

/// The metadata of the open file fd.
/// :param fd: The open file.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the FsError for `errno` when fstat fails.
#target(os: "macos")
private routine fd_metadata(fd: CInt) -> Result<Metadata, FsError>
    block entry()
        claim st : @DarwinStat <- uninit
        branch c_fstat(fd, st).eq(0)
            ? return(.Success(st.load().to<Metadata>()))
            : return(failed<Metadata>())

/// The permission bits of the open file fd, or 0o666 when they can't be read.
/// :param fd: The open file.
/// :returns: The permission bits, `S_IFMT` left out.
#target(os: "macos")
private routine fd_mode(fd: CInt) -> U32
    shared st : @DarwinStat <- uninit

    block entry()
        branch c_fstat(fd, st).eq(0)
            ? permission_bits()
            : return(0o666)

    block permission_bits()
        mode : U32 = st.mode.load().to<U32>()
        return(mode.bitand(0o7777))

/// The `st_mode` of the NUL-terminated cpath, a link followed.
/// :param cpath: The NUL-terminated path.
/// :returns: The mode, type bits included.
/// :absent: When stat fails.
#target(os: "macos")
private routine path_mode(cpath: @Byte) -> Option<U32>
    block entry()
        claim st : @DarwinStat <- uninit
        branch c_stat(cpath, st).eq(0)
            ? return(.Present(st.mode.load().to<U32>()))
            : return(.Absent)

/// path's metadata, a link followed to what it points at.
/// :param path: The path to look at.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine metadata(path: Bytes) -> Result<Metadata, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? return(metadata_of(cpath.to<@Byte>(), true))
            : return(.Failure(path_error(path)))

/// path's metadata. A link describes itself (kind Symlink).
/// :param path: The path to look at.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine symlink_metadata(path: Bytes) -> Result<Metadata, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? return(metadata_of(cpath.to<@Byte>(), false))
            : return(.Failure(path_error(path)))

// -- file handles ------------------------------------------------------------------------

/// An open file, from a File's open_read_result and the like: a Reader and a Writer. claim it, and close it when done.
#target(os: ("linux", "macos"))
record FileHandle
    fd     : CInt
    failed : Bool  // a write_bytes failed (write_all_result reports each failure itself)

/// A handle to no file, whose close() does nothing: the start value of a slot that a finish block closes.
/// :returns: The empty handle.
#target(os: ("linux", "macos"))
routine FileHandle.empty() -> Me
    block entry()
        return(Me { fd: -1, failed: false })

/// Opens path in mode. The file is opened close-on-exec, and one it makes gets the permissions 0o666 before the
/// umask.
/// :param path: The file to open.
/// :param mode: How to open it.
/// :returns: `Success` with the open handle.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine FileHandle.open(path: Bytes, mode: OpenMode) -> Result<Me, FsError>
    shared cpath_buffer : @Array<Byte, PATH_CAPACITY> <- uninit
    shared cpath        : @Byte                       = cpath_buffer.to<@Byte>()

    block entry()
        branch c_path(path, cpath)
            ? continue
            : return(.Failure(path_error(path)))
        f : OpenFlags = open_flags()
        when mode
            OpenMode.Read      -> open(f.cloexec)
            OpenMode.Write     -> open_creating(f, f.truncate)
            OpenMode.Append    -> open_creating(f, f.append)
            OpenMode.ReadWrite -> open(f.cloexec.bitor(2))
            OpenMode.CreateNew -> open_creating(f, f.exclude)

    // Write-only and created if missing, plus how it opens (truncate, append, or exclude).
    block open_creating(f: OpenFlags, how: CInt)
        creating : CInt = f.cloexec.bitor(1).bitor(f.create)
        jump open(creating.bitor(how))

    block open(flags: CInt)
        fd : CInt = c_open(cpath, flags, 0o666)
        branch fd.lt(0)
            ? return(failed<Me>())
            : return(.Success(Me { fd: fd, failed: false }))

/// Reads up to count bytes into buffer: how many, 0 at the end of the file. One call reads at most 1 GiB, and a
/// read a signal interrupts is tried again.
/// :param buffer: Where the bytes go.
/// :param count: The most bytes to read.
/// :returns: `Success` with the count read, 0 at the end of the file.
/// :throws: Returns `Failure` with the reason when the read fails.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.read_bytes_result(me: @Me, buffer: @Byte, count: USize) -> Result<USize, FsError>
    block entry()
        got : SSize = c_read(me.fd.load(), buffer, count.min(1073741824))
        branch got.ge(0)
            ? return(.Success(got.to<USize>()))
            : continue
        // EINTR: a signal came first, so ask again
        branch errno().eq(4)
            ? return(me.read_bytes_result(buffer, count))
            : return(failed<USize>())

/// Writes up to count bytes: how many it did. One call writes at most 1 GiB, and a write a signal interrupts is
/// tried again.
/// :param data: The first byte to write.
/// :param count: The most bytes to write.
/// :returns: `Success` with the count written.
/// :throws: Returns `Failure` with the reason when the write fails.
#target(os: ("linux", "macos"))
internal routine FileHandle.write_some(me: @Me, data: @Byte, count: USize) -> Result<USize, FsError>
    block entry()
        wrote : SSize = c_write(me.fd.load(), data, count.min(1073741824))
        branch wrote.ge(0)
            ? return(.Success(wrote.to<USize>()))
            : continue
        branch errno().eq(4)
            ? return(me.write_some(data, count))
            : return(failed<USize>())

/// Moves the position: the new one, from the start.
/// :param offset: The distance to move, negative to go back.
/// :param from: Where `offset` counts from.
/// :returns: `Success` with the new position from the start.
/// :throws: Returns `Failure` with the reason, such as a position before the start.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.seek_result(me: @Me, offset: S64, from: SeekFrom) -> Result<U64, FsError>
    block entry()
        fd : CInt = me.fd.load()
        // SEEK_SET, SEEK_CUR, SEEK_END
        when from
            SeekFrom.Start   -> moved(c_lseek(fd, offset, 0))
            SeekFrom.Current -> moved(c_lseek(fd, offset, 1))
            SeekFrom.End     -> moved(c_lseek(fd, offset, 2))

    block moved(at: S64)
        branch at.ge(0)
            ? return(.Success(at.to<U64>()))
            : return(failed<U64>())

/// The metadata of the open file.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason when the OS can't report it.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.metadata_result(me: @Me) -> Result<Metadata, FsError>
    block entry()
        return(fd_metadata(me.fd.load()))

/// The size of the open file in bytes.
/// :returns: `Success` with the size.
/// :throws: Returns `Failure` with the reason when the OS can't report it.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.size_result(me: @Me) -> Result<U64, FsError>
    block entry()
        m : Result<Metadata, FsError> = fd_metadata(me.fd.load())
        when m
            .Success(info)  -> return(.Success(info.size))
            .Failure(error) -> return(.Failure(error))

/// Truncates or extends (with zeros) the file to size bytes. The position stays.
/// :param size: The new size in bytes.
/// :returns: `Success(Unit)` once the size is set.
/// :throws: Returns `Failure` with the reason when the OS refuses. Crashes with `IntegerOverflowError` when `size`
///     doesn't fit in S64.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.set_size_result(me: @Me, size: U64) -> Result<Unit, FsError>
    block entry()
        return(checked(c_ftruncate(me.fd.load(), size.to<S64>())))

/// Waits until what was written is on the storage device.
/// :returns: `Success(Unit)` once it is.
/// :throws: Returns `Failure` with the reason when the OS reports an error.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.sync_result(me: @Me) -> Result<Unit, FsError>
    block entry()
        return(checked(c_fsync(me.fd.load())))

/// Closes the file and leaves the handle empty, so a second close does nothing.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine FileHandle.close(me: @Me) -> Void
    block entry()
        fd : CInt = me.fd.load()
        branch fd.lt(0)
            ? return()
            : continue
        c_close(fd)
        me.fd.store(-1)
        return()

// -- directories and names -------------------------------------------------------------

/// Makes the directory cpath with the permissions 0o777 before the umask.
/// :param cpath: The NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#target(os: "linux")
private routine make_dir(cpath: @Byte) -> CInt
    block entry()
        return(c_mkdir(cpath, 0o777))

/// Makes the directory cpath with the permissions 0o777 before the umask.
/// :param cpath: The NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#target(os: "macos")
private routine make_dir(cpath: @Byte) -> CInt
    block entry()
        return(c_mkdir(cpath, 0o777))

/// Makes the directory path (its parent must exist).
/// :param path: The directory to make.
/// :returns: `Success(Unit)` once it is made.
/// :throws: Returns `Failure` with the reason, `AlreadyExists` when something is at `path`, `InvalidPath` or
///     `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine create_dir(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? return(checked(make_dir(cpath.to<@Byte>())))
            : return(.Failure(path_error(path)))

/// Removes a file (or a link), not a directory.
/// :param path: The file to remove.
/// :returns: `Success(Unit)` once it is gone.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine remove_file(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? return(checked(c_unlink(cpath.to<@Byte>())))
            : return(.Failure(path_error(path)))

/// Removes an empty directory.
/// :param path: The directory to remove.
/// :returns: `Success(Unit)` once it is gone.
/// :throws: Returns `Failure` with the reason, `DirectoryNotEmpty` when something is in it, `InvalidPath` or
///     `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine remove_dir(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? return(checked(c_rmdir(cpath.to<@Byte>())))
            : return(.Failure(path_error(path)))

/// Renames from to to, replacing what is at to. Between filesystems it fails with CrossDevice.
/// :param from: The current path.
/// :param to: The new path.
/// :returns: `Success(Unit)` once it is renamed.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when a path doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine rename(from: Bytes, to: Bytes) -> Result<Unit, FsError>
    block entry()
        claim a : @Array<Byte, PATH_CAPACITY> <- uninit
        claim b : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(from, a.to<@Byte>())
            ? continue
            : return(.Failure(path_error(from)))
        branch c_path(to, b.to<@Byte>())
            ? return(checked(c_rename(a.to<@Byte>(), b.to<@Byte>())))
            : return(.Failure(path_error(to)))

/// Renames a to b unless something is at b, in one step (renameat2 with `RENAME_NOREPLACE`).
/// :param a: The current NUL-terminated path.
/// :param b: The new NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#target(os: "linux")
private routine rename_exclusive(a: @Byte, b: @Byte) -> CInt
    block entry()
        // RENAME_NOREPLACE
        return(c_renameat2(AT_FDCWD, a, AT_FDCWD, b, 1))

/// Renames a to b unless something is at b, in one step (renamex_np with `RENAME_EXCL`).
/// :param a: The current NUL-terminated path.
/// :param b: The new NUL-terminated path.
/// :returns: 0, or -1 with `errno` set.
#target(os: "macos")
private routine rename_exclusive(a: @Byte, b: @Byte) -> CInt
    block entry()
        // RENAME_EXCL
        return(c_renamex_np(a, b, 4))

/// Renames from to to, failing with AlreadyExists if something is at to. On a filesystem that can't do that in one
/// step, it looks first, so another process could slip a file in between.
/// :param from: The current path.
/// :param to: The new path.
/// :returns: `Success(Unit)` once it is renamed.
/// :throws: Returns `Failure` with the reason, `AlreadyExists` when something is at `to`, `InvalidPath` or
///     `NameTooLong` when a path doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine rename_no_replace(from: Bytes, to: Bytes) -> Result<Unit, FsError>
    block entry()
        claim a : @Array<Byte, PATH_CAPACITY> <- uninit
        claim b : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(from, a.to<@Byte>())
            ? continue
            : return(.Failure(path_error(from)))
        branch c_path(to, b.to<@Byte>())
            ? continue
            : return(.Failure(path_error(to)))
        branch rename_exclusive(a.to<@Byte>(), b.to<@Byte>()).eq(0)
            ? return(fs_done())
            : continue
        e : CInt = errno()
        branch e.eq(22).bitor(e.eq(errno_numbers().unsupported))
            ? look(a.to<@Byte>(), b.to<@Byte>())
            : return(.Failure(error_of(e)))

    block look(a: @Byte, b: @Byte)
        there : Option<U32> = path_mode(b)
        branch there.is_present()
            ? return(.Failure(FsError.AlreadyExists))
            : return(checked(c_rename(a, b)))

/// Copies from's bytes and permissions into to (made, or replaced): the bytes copied.
/// :param from: The file to copy.
/// :param to: The file to write.
/// :returns: `Success` with the number of bytes copied.
/// :throws: Returns `Failure` with the reason when a file can't be opened, read, or written, or the permissions can't
///     be set. A failure once `to` is opened removes it, so no partial copy is left.
#target(os: ("linux", "macos"))
internal routine copy_file(from: Bytes, to: Bytes) -> Result<U64, FsError>
    shared src   : @FileHandle <- .empty()
    shared dst   : @FileHandle <- .empty()
    shared total : @U64        <- 0

    block entry()
        source : Result<FileHandle, FsError> = FileHandle.open(from, OpenMode.Read)
        when source
            .Success(f)     -> target(f)
            .Failure(error) -> finish(.Failure(error))

    block target(opened: FileHandle)
        src.store(opened)
        dest : Result<FileHandle, FsError> = FileHandle.open(to, OpenMode.Write)
        when dest
            .Success(f)     -> copy(f)
            .Failure(error) -> finish(.Failure(error))

    block copy(made: FileHandle)
        dst.store(made)
        set : Bool = set_mode(dst.fd.load(), fd_mode(src.fd.load())).eq(0)
        branch set
            ? continue
            : abandon(error_of(errno()))
        claim buffer : @Array<Byte, 16384> <- uninit
        jump chunk(buffer.to<@Byte>())

    block chunk(buffer: @Byte)
        got : Result<USize, FsError> = src.read_bytes_result(buffer, 16384)
        when got
            .Success(n)     -> put(buffer, n)
            .Failure(error) -> abandon(error)

    block put(buffer: @Byte, n: USize)
        branch n.eq(0)
            ? finish(.Success(total.load()))
            : continue
        wrote : Result<Unit, FsError> = dst.write_all_result(buffer, n)
        when wrote
            .Success        -> continue
            .Failure(error) -> abandon(error)
        total.load().add(n.to<U64>()).store_into(total)
        jump chunk(buffer)

    // `to` is opened (made or emptied) and the copy can't be finished: it goes, so no partial copy is left.
    block abandon(error: FsError)
        dst.close()
        discard_removed : Result<Unit, FsError> = remove_file(to)
        jump finish(.Failure(error))

    block finish(result: Result<U64, FsError>)
        src.close()
        dst.close()
        return(result)

/// Sets the permission bits of the open file fd.
/// :param fd: The open file.
/// :param mode: The new permission bits.
/// :returns: 0, or -1 with `errno` set.
#target(os: "linux")
private routine set_mode(fd: CInt, mode: U32) -> CInt
    block entry()
        return(c_fchmod(fd, mode))

/// Sets the permission bits of the open file fd.
/// :param fd: The open file.
/// :param mode: The new permission bits, of which the low 16 bits are used.
/// :returns: 0, or -1 with `errno` set.
#target(os: "macos")
private routine set_mode(fd: CInt, mode: U32) -> CInt
    block entry()
        return(c_fchmod(fd, mode.to_wrap<U16>()))

/// Sets the permission bits of cpath, a link followed.
/// :param cpath: The NUL-terminated path.
/// :param mode: The new permission bits.
/// :returns: 0, or -1 with `errno` set.
#target(os: "linux")
private routine change_mode(cpath: @Byte, mode: U32) -> CInt
    block entry()
        return(c_chmod(cpath, mode))

/// Sets the permission bits of cpath, a link followed.
/// :param cpath: The NUL-terminated path.
/// :param mode: The new permission bits, of which the low 16 bits are used.
/// :returns: 0, or -1 with `errno` set.
#target(os: "macos")
private routine change_mode(cpath: @Byte, mode: U32) -> CInt
    block entry()
        return(c_chmod(cpath, mode.to_wrap<U16>()))

/// Read-only takes every write permission away, and writable gives the owner's back.
/// :param path: The file to change.
/// :param readonly: True to make it read-only, false to make it writable by its owner.
/// :returns: `Success(Unit)` once the permissions are set.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine set_readonly(path: Bytes, readonly: Bool) -> Result<Unit, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? continue
            : return(.Failure(path_error(path)))
        there : Option<U32> = path_mode(cpath.to<@Byte>())
        when there
            .Present(mode) -> change(cpath.to<@Byte>(), mode.bitand(0o7777))
            .Absent        -> return(failed<Unit>())

    block change(cpath: @Byte, mode: U32)
        // S_IWUSR | S_IWGRP | S_IWOTH, or S_IWUSR
        branch readonly
            ? return(checked(change_mode(cpath, mode.bitand(0o222.bitnot()))))
            : return(checked(change_mode(cpath, mode.bitor(0o200))))

/// Whether this process may read, write, or execute path.
/// :param path: The path to check.
/// :param access: What to check for.
/// :returns: True when allowed. False when not, when nothing is there, or when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine is_accessible(path: Bytes, access: Access) -> Bool
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? continue
            : return(false)
        // R_OK, W_OK, X_OK
        when access
            Access.Read    -> return(c_access(cpath.to<@Byte>(), 4).eq(0))
            Access.Write   -> return(c_access(cpath.to<@Byte>(), 2).eq(0))
            Access.Execute -> return(c_access(cpath.to<@Byte>(), 1).eq(0))

/// Makes the file if it's missing, and sets its access and modification times to now.
/// :param path: The file to touch.
/// :returns: `Success(Unit)` once the times are set.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine touch(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? continue
            : return(.Failure(path_error(path)))
        f  : OpenFlags = open_flags()
        fd : CInt      = c_open(cpath.to<@Byte>(), f.cloexec.bitor(1).bitor(f.create), 0o666)
        branch fd.lt(0)
            ? return(failed<Unit>())
            : continue
        c_close(fd)
        return(checked(c_utimes(cpath.to<@Byte>(), null)))

// -- directory listings ------------------------------------------------------------------

/// The entries of a directory, "." and ".." left out, in the order the OS gives them. claim one, open it on a
/// Directory, call next until Absent, and close it.
#target(os: ("linux", "macos"))
record DirIter
    dir   : Addr
    path  : Array<Byte, PATH_CAPACITY>  // the directory, NUL-terminated
    count : USize  // the directory's byte count
    name  : @Byte  // the last entry's name, in readdir's buffer

/// Opens the listing of the directory at path. The handle is null until the open succeeds, so close() is safe
/// after a failure.
/// :param path: The directory to list.
/// :returns: `Success(Unit)` once the listing is open.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine DirIter.open_path(me: @Me, path: Bytes) -> Result<Unit, FsError>
    block entry()
        me.dir.store(null)
        branch c_path(path, me.path.to<@Byte>())
            ? continue
            : return(.Failure(path_error(path)))
        me.count.store(path.count())
        me.name.store(null)
        dir : Addr = c_opendir(me.path.to<@Byte>())
        branch dir.is_null()
            ? return(failed<Unit>())
            : continue
        me.dir.store(dir)
        return(fs_done())

/// Whether name is "." or "..".
/// :param name: The NUL-terminated name.
/// :returns: True for "." and "..".
#target(os: ("linux", "macos"))
private routine is_dot_name(name: @Byte) -> Bool
    block entry()
        branch name.load().eq(b'.')
            ? continue
            : return(false)
        second : Byte = name.stride(1).load()
        branch second.eq(0x00)
            ? return(true)
            : continue
        branch second.eq(b'.')
            ? two_dots()
            : return(false)

    block two_dots()
        third : Byte = name.stride(2).load()
        return(third.eq(0x00))

/// The next entry, or Absent at the end (a failure partway reads as the end).
/// :returns: The next entry, its name valid until the next call.
/// :absent: At the end of the listing, or when reading it fails.
#target(os: ("linux", "macos"))
routine DirIter.next(me: @Me) -> Option<DirEntry>
    block entry()
        entry : @Byte = c_readdir(me.dir.load())
        branch entry.is_null()
            ? return(.Absent)
            : continue
        name : @Byte = entry.stride(dirent_name_at())
        branch is_dot_name(name)
            ? return(me.next())
            : continue
        me.name.store(name)
        // DT_DIR, DT_REG, DT_LNK. DT_UNKNOWN (some filesystems) asks lstat
        d_type : Byte = entry.stride(dirent_type_at()).load()
        when d_type.to<U8>()
            4    -> found(name, FileKind.Directory)
            8    -> found(name, FileKind.File)
            10   -> found(name, FileKind.Symlink)
            0    -> unknown(name)
            else -> found(name, FileKind.Other)

    block unknown(name: @Byte)
        m : Result<Metadata, FsError> = me.entry_metadata_of(false)
        when m
            .Success(info) -> found(name, info.kind)
            .Failure       -> found(name, FileKind.Other)

    block found(name: @Byte, kind: FileKind)
        return(.Present(DirEntry { name: name.to<CStr>().to<Bytes>(), kind: kind }))

/// The metadata of the entry next last returned, a link followed.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason, `NameTooLong` when the entry's full path doesn't fit a C path.
#target(os: ("linux", "macos"))
#expensive("asks the operating system")
routine DirIter.entry_metadata_result(me: @Me) -> Result<Metadata, FsError>
    block entry()
        return(me.entry_metadata_of(true))

/// The metadata of the entry next last returned, by its full path.
/// :param follow: True to describe what a link points at, false to describe the link itself.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason, `NameTooLong` when the entry's full path doesn't fit a C path.
#target(os: ("linux", "macos"))
private routine DirIter.entry_metadata_of(me: @Me, follow: Bool) -> Result<Metadata, FsError>
    block entry()
        claim full : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_child_path(me.path.to<@Byte>(), me.count.load(), me.name.load(), full.to<@Byte>())
            ? return(metadata_of(full.to<@Byte>(), follow))
            : return(.Failure(FsError.NameTooLong))

/// Closes the listing and leaves the handle null, so a second close does nothing.
#target(os: ("linux", "macos"))
routine DirIter.close(me: @Me) -> Void
    block entry()
        dir : Addr = me.dir.load()
        branch dir.is_null()
            ? return()
            : continue
        c_closedir(dir)
        me.dir.store(null)
        return()

// -- the working directory and well-known directories -------------------------------------

/// A copy of the n bytes at p, in memory from alloc, carrying that allocator.
/// :param p: The first byte to copy.
/// :param n: How many bytes to copy.
/// :param alloc: The allocator for the copy.
/// :returns: `Success` with the copy.
/// :throws: Returns `Failure(OutOfMemory)` when `alloc` fails.
#target(os: ("linux", "macos"))
private routine owned(p: @Byte, n: USize, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        buffer : @Byte = allocate<Byte>(n.max(1), alloc)
        branch buffer.is_null()
            ? return(.Failure(FsError.OutOfMemory))
            : continue
        buffer.copy(p, n)
        return(.Success(Bytes { data: buffer, count: n, alloc: alloc }))

/// The value of the environment variable name, when it is set and not empty.
/// :param name: The variable's name.
/// :returns: The NUL-terminated value, owned by the C library.
/// :absent: When the variable is not set or is empty.
#target(os: ("linux", "macos"))
private routine nonempty_env(name: CStr) -> Option<@Byte>
    block entry()
        value : @Byte = c_getenv(name)
        branch value.is_null()
            ? return(.Absent)
            : continue
        branch value.load().eq(0x00)
            ? return(.Absent)
            : return(.Present(value))

/// The working directory, in memory from alloc.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the path.
/// :throws: Returns `Failure` with the reason when the OS can't report it, `OutOfMemory` when `alloc` fails.
#target(os: ("linux", "macos"))
internal routine current_dir(alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        jump attempt(256)

    block attempt(capacity: USize)
        buffer : @Byte = allocate<Byte>(capacity, alloc)
        branch buffer.is_null()
            ? return(.Failure(FsError.OutOfMemory))
            : continue
        branch c_getcwd(buffer, capacity).is_not_null()
            ? found(buffer)
            : continue
        e : CInt = errno()
        deallocate(buffer, alloc)
        // ERANGE: a bigger buffer
        branch e.eq(34)
            ? attempt(capacity.mul(2))
            : return(.Failure(error_of(e)))

    block found(buffer: @Byte)
        count : USize = buffer.to<CStr>().count()
        dir   : Bytes = Bytes { data: buffer, count: count, alloc: alloc }
        return(.Success(dir))

/// Makes path the working directory.
/// :param path: The new working directory.
/// :returns: `Success(Unit)` once it is changed.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine set_current_dir(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? return(checked(c_chdir(cpath.to<@Byte>())))
            : return(.Failure(path_error(path)))

/// TMPDIR, or /tmp when it is not set or empty, in memory from alloc.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the path.
/// :throws: Returns `Failure(OutOfMemory)` when `alloc` fails.
#target(os: ("linux", "macos"))
internal routine temp_dir(alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        t : Option<@Byte> = nonempty_env("TMPDIR")
        when t
            .Present(dir) -> return(owned(dir, dir.to<CStr>().count(), alloc))
            .Absent       -> return(owned("/tmp", 4, alloc))

/// HOME, in memory from alloc. NotFound when it isn't set or is empty.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the path.
/// :throws: Returns `Failure(NotFound)` when HOME is not set or empty, `Failure(OutOfMemory)` when `alloc` fails.
#target(os: ("linux", "macos"))
internal routine home_dir(alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        h : Option<@Byte> = nonempty_env("HOME")
        when h
            .Present(dir) -> return(owned(dir, dir.to<CStr>().count(), alloc))
            .Absent       -> return(.Failure(FsError.NotFound))

/// path made absolute by the text alone: the working directory in front of a relative path, nothing resolved.
/// :param path: The path to make absolute.
/// :param alloc: The allocator for the result.
/// :returns: `Success` with the absolute path.
/// :throws: Returns `Failure` with the reason when the working directory can't be read, `OutOfMemory` when `alloc`
///     fails for it. Crashes with `MemoryAllocationError` when `alloc` fails for the joined path.
#target(os: ("linux", "macos"))
internal routine absolute_path(path: Bytes, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        branch path.has_prefix("/")
            ? return(owned(path.data, path.count(), alloc))
            : continue
        cwd : Result<Bytes, FsError> = current_dir(alloc)
        when cwd
            .Success(dir)   -> join(dir)
            .Failure(error) -> return(.Failure(error))

    block join(dir: Bytes)
        full : Bytes = join_path(dir, path, alloc)
        claim cwd : @Bytes <- dir
        cwd.destruct()
        return(.Success(full))

/// The absolute path with every link, ".", and ".." resolved, and path must exist.
/// :param path: The path to resolve.
/// :param alloc: The allocator for the result.
/// :returns: `Success` with the resolved path.
/// :throws: Returns `Failure` with the reason, such as `NotFound`, `OutOfMemory` when `alloc` fails, `InvalidPath`
///     or `NameTooLong` when `path` doesn't fit a C path.
#target(os: ("linux", "macos"))
internal routine canonical_path(path: Bytes, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? continue
            : return(.Failure(path_error(path)))
        resolved : @Byte = c_realpath(cpath.to<@Byte>(), null)
        branch resolved.is_null()
            ? return(failed<Bytes>())
            : continue
        copied : Result<Bytes, FsError> = owned(resolved, resolved.to<CStr>().count(), alloc)
        c_free(resolved)
        return(copied)

// -- memory-mapped files -----------------------------------------------------------------

/// Whether p is `MAP_FAILED`, the all-ones address mmap returns on failure.
/// :param p: The address mmap returned.
/// :returns: True for `MAP_FAILED`.
#target(os: ("linux", "macos"))
private routine is_map_failed(p: Addr) -> Bool
    block entry()
        // MAP_FAILED, (void*)-1
        return(ptrtoint<Addr, USize>(p).eq(USize.MAX))

/// Maps count bytes of path from offset (USize.MAX: to the end), clamped to the file. Past the end, or an empty
/// file, gives an empty mapping. write maps it shared, so stores reach the file. Otherwise it's read-only.
/// :param path: The file to map.
/// :param write: True for a shared, writable mapping.
/// :param offset: Where in the file the mapping starts.
/// :param count: The most bytes to map.
/// :returns: `Success` with the mapping.
/// :throws: Returns `Failure` with the reason when the file can't be opened, measured, or mapped.
#target(os: ("linux", "macos"))
internal routine Mapping.map(path: Bytes, write: Bool, offset: U64,
    count: USize) -> Result<Me, FsError>
    shared file : @FileHandle <- .empty()

    block entry()
        claim cpath : @Array<Byte, PATH_CAPACITY> <- uninit
        branch c_path(path, cpath.to<@Byte>())
            ? continue
            : finish(.Failure(path_error(path)))
        flags : CInt = write
            ? 2
            : 0
        fd : CInt = c_open(cpath.to<@Byte>(), flags.bitor(open_flags().cloexec), 0)
        branch fd.lt(0)
            ? finish(failed<Me>())
            : continue
        file.fd.store(fd)
        m : Result<Metadata, FsError> = fd_metadata(fd)
        when m
            .Success(info)  -> sized(fd, info.size)
            .Failure(error) -> finish(.Failure(error))

    block sized(fd: CInt, size: U64)
        branch offset.ge(size)
            ? finish(.Success(Me.empty()))
            : continue
        want_bytes : U64   = count.to<U64>().min(size.sub(offset))
        want       : USize = want_bytes.to<USize>()
        page       : U64   = map_granularity().to<U64>()
        aligned    : U64   = offset.sub(offset.mod(page))
        delta      : USize = offset.sub(aligned).to<USize>()
        // PROT_READ | PROT_WRITE and MAP_SHARED, or PROT_READ and MAP_PRIVATE
        prot : CInt = write
            ? 3
            : 1
        share : CInt = write
            ? 1
            : 2
        p : Addr = c_mmap(null, want.add(delta), prot, share, fd, aligned.to<S64>())
        // the mapping keeps the file open on its own, and errno is read before finish closes the descriptor
        branch is_map_failed(p)
            ? finish(failed<Me>())
            : finish(.Success(Me { base: p, delta: delta, count: want }))

    block finish(result: Result<Me, FsError>)
        file.close()
        return(result)

/// Writes changed pages back to the file.
/// :returns: `Success(Unit)` once they are written, at once for an empty mapping.
/// :throws: Returns `Failure` with the reason when msync fails.
#target(os: ("linux", "macos"))
routine Mapping.flush_result(me: Me) -> Result<Unit, FsError>
    block entry()
        branch me.base.is_null()
            ? return(fs_done())
            : return(checked(c_msync(me.base, me.delta.add(me.count), ms_sync())))

/// Writes changed pages back and unmaps.
#target(os: ("linux", "macos"))
routine Mapping.unmap(me: Me) -> Void
    block entry()
        branch me.base.is_null()
            ? return()
            : continue
        c_msync(me.base, me.delta.add(me.count), ms_sync())
        c_munmap(me.base, me.delta.add(me.count))
        return()

/// Asks the OS to read the whole mapping in now.
#target(os: ("linux", "macos"))
routine Mapping.prefetch(me: Me) -> Void
    block entry()
        branch me.base.is_null()
            ? return()
            : continue
        // MADV_WILLNEED
        c_madvise(me.base, me.delta.add(me.count), 3)
        return()

/// Tells the OS the mapping will be read front to back.
#target(os: ("linux", "macos"))
routine Mapping.advise_sequential(me: Me) -> Void
    block entry()
        branch me.base.is_null()
            ? return()
            : continue
        // MADV_SEQUENTIAL
        c_madvise(me.base, me.delta.add(me.count), 2)
        return()
