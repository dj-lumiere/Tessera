// Tessera stdlib: lists of thread tickets
//
// Work spread over several threads keeps their tickets in a List[Thread[T]], and these routines handle them together:
// wait for all, take every result, give all back, wait for whichever finishes first, cancel all, and take out or give
// back the ones that have finished.

module Standard/Os

import Standard/Alloc
import Standard/Collections

/// Waits until the work of every thread ticket in the list has finished.
@target(os: not "none")
@track_caller
routine List[Thread[T]].wait_all_finished(me: @Me) -> None
needs T: typename
    each i in 0 til me.count()
        me[i].wait_finished()
    then
        return

/// The results of the thread tickets' finished work, in the list's order, in a list from `alloc`.
/// :param alloc: Where the list comes from.
/// :returns: The results.
/// :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
@target(os: not "none")
@track_caller
routine List[Thread[T]].retrieve_all(me: @Me, alloc: @MemoryManager) -> List[T]
needs T: typename
    local results: @List[T] <- .construct(alloc)

    each i in 0 til me.count()
        results.add_last(me[i].retrieve())
    then
        return results.peek()

/// The results of the thread tickets' finished work, in the list's order, in a list from DEFAULT_HEAP.
/// :returns: The results.
/// :throws: Crashes as each ticket's `retrieve` does: work still running, none, or cancelled.
@target(os: not "none")
@track_caller
routine List[Thread[T]].retrieve_all(me: @Me) -> List[T]
needs T: typename
    return me.retrieve_all(alloc: DEFAULT_HEAP)

/// Gives every thread ticket in the list back, and empties the list.
/// :throws: Crashes as each ticket's `give_back` does, when its work still runs.
@target(os: not "none")
@track_caller
routine List[Thread[T]].give_back_all(me: @Me) -> None
needs T: typename
    each i in 0 til me.count()
        me[i].give_back()
    me.clear()
    return

/// Asks the work of every thread ticket in the list to stop.
@target(os: not "none")
@track_caller
routine List[Thread[T]].cancel_all(me: @Me) -> None
needs T: typename
    each i in 0 til me.count()
        me[i].cancel()
    then
        return

/// Waits until the work of one of the thread tickets in the list has finished, and says which: the first in the list
/// among those finished when it looks.
/// :returns: The position of a ticket whose work has finished.
/// :throws: Crashes with `InvalidValueError` for an empty list.
@target(os: not "none")
@track_caller
routine List[Thread[T]].wait_any_finished(me: @Me) -> USize
needs T: typename
    local waiter: Waiter = current_waiter()

    if me.count() == 0
        crash(name: "InvalidValueError", message: "wait_any_finished of an empty list waits for nothing.")
    else
        // Each ticket keeps the waiter, so the first to finish wakes it: then it forgets every one.
        while true with i: USize = 0
            values2: (USize, USize) = when
                i >= me.count() =>
                    waiter.park()
                    becomes (0, me.count())
                else =>
                    if me[i].work_slot().register(waiter)
                        becomes (0, i)
                    else
                        continue with i: i + 1
            k, result = values2

            each k2 in k til me.count()
                me[k2].work_slot().unregister(waiter)
            then
                // After a park, the tickets are looked at again.
                if result < me.count()
                    return result
                else
                    continue with i: 0

/// Takes the thread tickets whose work has finished out of the list, into a list from `alloc`, keeping the others
/// in order.
/// :param alloc: Where the list of finished tickets comes from.
/// :returns: The finished tickets, in the order they had.
@target(os: not "none")
@track_caller
routine List[Thread[T]].take_finished(me: @Me, alloc: @MemoryManager) -> Me
needs T: typename
    local finished: @Me <- .construct(alloc)

    each i in 0 til me.count() with kept: USize = 0
        ticket: Thread[T] = me[i]
        if ticket.check_finished()
            finished.add_last(ticket)
            continue with kept: kept
        else
            me[kept] = ticket
            continue with kept: kept + 1
    then
        while me.count() > kept
            removed: Thread[T] = me.remove_last()
        then
            return finished.peek()

/// Takes the thread tickets whose work has finished out of the list, into a list from DEFAULT_HEAP.
/// :returns: The finished tickets, in the order they had.
@target(os: not "none")
@track_caller
routine List[Thread[T]].take_finished(me: @Me) -> Me
needs T: typename
    return me.take_finished(alloc: DEFAULT_HEAP)

/// Gives back the thread tickets whose work has finished, and takes them out of the list: for work whose result
/// nobody needs.
@target(os: not "none")
@track_caller
routine List[Thread[T]].give_back_finished(me: @Me) -> None
needs T: typename
    each i in 0 til me.count() with kept: USize = 0
        ticket: Thread[T] = me[i]
        if ticket.check_finished()
            ticket.give_back()
            continue with kept: kept
        else
            me[kept] = ticket
            continue with kept: kept + 1
    then
        while me.count() > kept
            removed: Thread[T] = me.remove_last()
        then
            return
