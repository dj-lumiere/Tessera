// Tessera stdlib: channels
//
// A channel carries values from senders to receivers in the order they were sent, through room for a fixed number of
// them. `Channel[T]` has one receiver and `SharedChannel[T]` any number, each value going to one of them. Both live in
// memory the threads and fibers that use them share (`@Channel[T]`):
//
//     claim jobs: @Channel[U64] <- .construct(capacity: 16)
//     sent: Result[Unit, ChannelClosed | CancelRequested] = jobs.send_result(42)   // waits while the room is full
//     got: Result[U64, ChannelClosed | CancelRequested] = jobs.receive_result()     // waits while it is empty
//
// A sender that waits for room, or a receiver that waits for a value, sleeps if it is a thread and parks if it is a
// fiber: the other fibers of its thread go on, and the other side wakes it. `send_if_room` doesn't wait. A channel
// starts with one sender and one receiver: `add_sender` (and `add_receiver` on a SharedChannel) counts another, and each
// says it is done with `close_sending` or `close_receiving`. Once every sender has closed, receivers take what is left
// and then get `ChannelClosed`. Once every receiver has closed, the values left are dropped and senders get
// `ChannelClosed`. Values that own memory are taken out and released by a receiver before it closes. A wait also ends
// with `CancelRequested` when the work that waits is asked to stop with `cancel()`.

module Standard/Os

import Standard/Alloc

/// What a send or a receive gets when the other side has closed for good: every receiver, or every sender with no
/// value left.
@derive(Representable, Diagnosable, Equatable, Hashable)
record ChannelClosed

/// One sender or receiver waiting on a channel, on the frame of the routine that waits.
record ChannelWait
    waiter: Waiter
    next: @ChannelWait

/// What both kinds of channel are: a ring of values under a lock, the open senders and receivers, and who waits.
/// :typeparam T: The type of the values.
record ChannelCore[T]
needs T: typename
    lock: ExclusiveLock
    /// Room for `capacity` values, a ring.
    items: Memory[T]
    /// Where the oldest value is.
    head: USize
    /// How many values there are.
    count: USize
    /// The senders that haven't closed.
    senders: U32
    /// The receivers that haven't closed.
    receivers: U32
    /// Receivers waiting for a value.
    getters: @ChannelWait
    /// Senders waiting for room.
    putters: @ChannelWait

/// A channel with one receiver: values from any number of senders, in order, through room for a fixed number.
/// :typeparam T: The type of the values.
record Channel[T]
needs T: typename
    core: ChannelCore[T]

/// A channel with any number of receivers, each value going to one of them.
/// :typeparam T: The type of the values.
record SharedChannel[T]
needs T: typename
    core: ChannelCore[T]

/// Makes a `ChannelWait` from its fields.
/// :param waiter: Its `waiter`.
/// :param next: Its `next`.
/// :returns: The new value.
routine ChannelWait.construct(waiter: Waiter, next: @Me) -> Me
    return Me(waiter, next)

/// Releases nothing: a `ChannelWait` holds no memory of its own.
routine ChannelWait.destruct(me: @Me) -> Void
    return

/// An empty channel core with room for `capacity` values from `alloc`, one sender and one receiver.
/// :param capacity: How many values it holds at most, at least 1.
/// :param alloc: Where the room comes from.
/// :returns: The core.
/// :throws: Crashes with `InvalidValueError` for a capacity of 0, and with `MemoryAllocationError` when `alloc` has no
///     memory to give.
@track_caller
routine ChannelCore[T].construct(capacity: USize, alloc: @MemoryManager) -> Me
needs T: typename
    if capacity == 0
        crash(name: "InvalidValueError", message: "A channel needs room for at least one value.")
    return Me(lock: .construct(), items: .construct(count: capacity, manager: alloc), head: 0, count: 0, senders: 1, receivers: 1, getters: null, putters: null)

/// Gives the room back. The values left in it are dropped.
@track_caller
routine ChannelCore[T].destruct(me: @Me) -> Void
needs T: typename
    me.items.drop()
    return

/// An empty channel with room for `capacity` values from `alloc`, one sender and one receiver.
/// :param capacity: How many values it holds at most, at least 1.
/// :param alloc: Where the room comes from.
/// :returns: The channel.
/// :throws: Crashes with `InvalidValueError` for a capacity of 0, and with `MemoryAllocationError` when `alloc` has no
///     memory to give.
@track_caller
routine Channel[T].construct(capacity: USize, alloc: @MemoryManager) -> Me
needs T: typename
    return Me(core: .construct(capacity, alloc))

/// An empty channel with room for `capacity` values from DEFAULT_HEAP, one sender and one receiver.
/// :param capacity: How many values it holds at most, at least 1.
/// :returns: The channel.
/// :throws: Crashes with `InvalidValueError` for a capacity of 0, and with `MemoryAllocationError` when there is no
///     memory for it.
@target(os: not "none")
@track_caller
routine Channel[T].construct(capacity: USize) -> Me
needs T: typename
    return Me(core: .construct(capacity, alloc: DEFAULT_HEAP))

/// Gives the room back. The values left in it are dropped.
@track_caller
routine Channel[T].destruct(me: @Me) -> Void
needs T: typename
    me.core.destruct()
    return

/// An empty shared channel with room for `capacity` values from `alloc`, one sender and one receiver.
/// :param capacity: How many values it holds at most, at least 1.
/// :param alloc: Where the room comes from.
/// :returns: The channel.
/// :throws: Crashes with `InvalidValueError` for a capacity of 0, and with `MemoryAllocationError` when `alloc` has no
///     memory to give.
@track_caller
routine SharedChannel[T].construct(capacity: USize, alloc: @MemoryManager) -> Me
needs T: typename
    return Me(core: .construct(capacity, alloc))

/// An empty shared channel with room for `capacity` values from DEFAULT_HEAP, one sender and one receiver.
/// :param capacity: How many values it holds at most, at least 1.
/// :returns: The channel.
/// :throws: Crashes with `InvalidValueError` for a capacity of 0, and with `MemoryAllocationError` when there is no
///     memory for it.
@target(os: not "none")
@track_caller
routine SharedChannel[T].construct(capacity: USize) -> Me
needs T: typename
    return Me(core: .construct(capacity, alloc: DEFAULT_HEAP))

/// Gives the room back. The values left in it are dropped.
@track_caller
routine SharedChannel[T].destruct(me: @Me) -> Void
needs T: typename
    me.core.destruct()
    return

// -- the two kinds, through the core ------------------------------------------------------------------------------

/// Sends `value`, waiting while the room is full.
/// :param value: The value.
/// :returns: `Unit` once it is in, `ChannelClosed` when every receiver has closed, `CancelRequested` when the work that
///     waits is asked to stop first.
@target(os: not "none")
routine Channel[T].send_result(me: @Me, value: T) -> Result[Unit, ChannelClosed | CancelRequested]
needs T: typename
    return me.core.send_result(value)

/// Sends `value` if there is room, without waiting.
/// :param value: The value.
/// :returns: True when it went in, false when the room is full or every receiver has closed.
@target(os: not "none")
routine Channel[T].send_if_room(me: @Me, value: T) -> Bool
needs T: typename
    return me.core.send_if_room(value)

/// Takes the oldest value, waiting while there is none.
/// :returns: The value, `ChannelClosed` when every sender has closed and no value is left, or `CancelRequested` when
///     the work that waits is asked to stop first.
@target(os: not "none")
routine Channel[T].receive_result(me: @Me) -> Result[T, ChannelClosed | CancelRequested]
needs T: typename
    return me.core.receive_result()

/// Counts one more sender, which closes on its own.
@target(os: not "none")
routine Channel[T].add_sender(me: @Me) -> Void
needs T: typename
    me.core.add_sender()
    return

/// One sender is done. Once every sender is, the receiver takes what is left and then gets `ChannelClosed`.
@target(os: not "none")
routine Channel[T].close_sending(me: @Me) -> Void
needs T: typename
    me.core.close_sending()
    return

/// The receiver is done: the values left are dropped, and senders get `ChannelClosed`.
@target(os: not "none")
routine Channel[T].close_receiving(me: @Me) -> Void
needs T: typename
    me.core.close_receiving()
    return

/// Sends `value`, waiting while the room is full.
/// :param value: The value.
/// :returns: `Unit` once it is in, `ChannelClosed` when every receiver has closed, `CancelRequested` when the work that
///     waits is asked to stop first.
@target(os: not "none")
routine SharedChannel[T].send_result(me: @Me,
    value: T) -> Result[Unit, ChannelClosed | CancelRequested]
needs T: typename
    return me.core.send_result(value)

/// Sends `value` if there is room, without waiting.
/// :param value: The value.
/// :returns: True when it went in, false when the room is full or every receiver has closed.
@target(os: not "none")
routine SharedChannel[T].send_if_room(me: @Me, value: T) -> Bool
needs T: typename
    return me.core.send_if_room(value)

/// Takes the oldest value, waiting while there is none. Each value goes to one receiver.
/// :returns: The value, `ChannelClosed` when every sender has closed and no value is left, or `CancelRequested` when
///     the work that waits is asked to stop first.
@target(os: not "none")
routine SharedChannel[T].receive_result(me: @Me) -> Result[T, ChannelClosed | CancelRequested]
needs T: typename
    return me.core.receive_result()

/// Counts one more sender, which closes on its own.
@target(os: not "none")
routine SharedChannel[T].add_sender(me: @Me) -> Void
needs T: typename
    me.core.add_sender()
    return

/// Counts one more receiver, which closes on its own.
@target(os: not "none")
routine SharedChannel[T].add_receiver(me: @Me) -> Void
needs T: typename
    me.core.add_receiver()
    return

/// One sender is done. Once every sender is, receivers take what is left and then get `ChannelClosed`.
@target(os: not "none")
routine SharedChannel[T].close_sending(me: @Me) -> Void
needs T: typename
    me.core.close_sending()
    return

/// One receiver is done. Once every receiver is, the values left are dropped, and senders get `ChannelClosed`.
@target(os: not "none")
routine SharedChannel[T].close_receiving(me: @Me) -> Void
needs T: typename
    me.core.close_receiving()
    return

// -- the core -----------------------------------------------------------------------------------------------------

/// Sends `value`, waiting while the room is full.
/// :param value: The value.
/// :returns: `Unit`, `ChannelClosed`, or `CancelRequested`.
@target(os: not "none")
routine ChannelCore[T].send_result(me: @Me,
    value: T) -> Result[Unit, ChannelClosed | CancelRequested]
needs T: typename
    local waiter: Waiter = current_waiter()
    local node: @ChannelWait <- ChannelWait(waiter, next: null)

    jump look()

    block look()
        me.lock.lock()
        if me.receivers.peek() == 0
            jump closed()
        if me.count.peek() < me.items.count()
            jump put()
        node.next.poke(me.putters.peek())
        me.putters.poke(node)
        me.lock.unlock()
        if blocked_until_cancelled(waiter)
            jump cancelled()
        waiter.park()
        me.lock.lock()
        unlink(list: me.putters, node)
        me.lock.unlock()
        jump look()

    block put()
        me.push(value)
        me.lock.unlock()
        return Unit()

    block closed()
        me.lock.unlock()
        return ChannelClosed()

    block cancelled()
        me.lock.lock()
        unlink(list: me.putters, node)
        me.lock.unlock()
        return CancelRequested()

/// Sends `value` if there is room, without waiting.
/// :param value: The value.
/// :returns: True when it went in.
@target(os: not "none")
routine ChannelCore[T].send_if_room(me: @Me, value: T) -> Bool
needs T: typename
    me.lock.lock()
    if not (me.receivers.peek() != 0 and me.count.peek() < me.items.count())
        me.lock.unlock()
        return false
    else
        me.push(value)
        me.lock.unlock()
        return true

/// Takes the oldest value, waiting while there is none.
/// :returns: The value, `ChannelClosed`, or `CancelRequested`.
@target(os: not "none")
routine ChannelCore[T].receive_result(me: @Me) -> Result[T, ChannelClosed | CancelRequested]
needs T: typename
    local waiter: Waiter = current_waiter()
    local node: @ChannelWait <- ChannelWait(waiter, next: null)

    jump look()

    block look()
        me.lock.lock()
        if me.count.peek() != 0
            jump take()
        if me.senders.peek() == 0
            jump closed()
        node.next.poke(me.getters.peek())
        me.getters.poke(node)
        me.lock.unlock()
        if blocked_until_cancelled(waiter)
            jump cancelled()
        waiter.park()
        me.lock.lock()
        unlink(list: me.getters, node)
        me.lock.unlock()
        jump look()

    block take()
        value: T = me.pop()
        me.lock.unlock()
        return value

    block closed()
        me.lock.unlock()
        return ChannelClosed()

    block cancelled()
        me.lock.lock()
        unlink(list: me.getters, node)
        me.lock.unlock()
        return CancelRequested()

/// Counts one more sender.
@target(os: not "none")
routine ChannelCore[T].add_sender(me: @Me) -> Void
needs T: typename
    me.lock.lock()
    me.senders.poke(me.senders.peek() + 1)
    me.lock.unlock()
    return

/// Counts one more receiver.
@target(os: not "none")
routine ChannelCore[T].add_receiver(me: @Me) -> Void
needs T: typename
    me.lock.lock()
    me.receivers.poke(me.receivers.peek() + 1)
    me.lock.unlock()
    return

/// One sender is done: once every sender is, the waiting receivers wake to take what is left.
/// :throws: Crashes with `InvalidValueError` when every sender has closed already.
@target(os: not "none")
@track_caller
routine ChannelCore[T].close_sending(me: @Me) -> Void
needs T: typename
    me.lock.lock()
    if me.senders.peek() == 0
        crash(name: "InvalidValueError", message: "Every sender of this channel has closed already.")
    me.senders.poke(me.senders.peek() - 1)
    wake_list(me.getters.peek())
    me.lock.unlock()
    return

/// One receiver is done: once every receiver is, the values left are dropped and the waiting senders wake.
/// :throws: Crashes with `InvalidValueError` when every receiver has closed already.
@target(os: not "none")
@track_caller
routine ChannelCore[T].close_receiving(me: @Me) -> Void
needs T: typename
    me.lock.lock()
    if me.receivers.peek() == 0
        crash(name: "InvalidValueError", message: "Every receiver of this channel has closed already.")
    me.receivers.poke(me.receivers.peek() - 1)
    if me.receivers.peek() == 0
        me.count.poke(0)
        wake_list(me.putters.peek())
    me.lock.unlock()
    return

/// Puts `value` behind the others and wakes the waiting receivers. The lock is held and there is room.
/// :param value: The value.
@target(os: not "none")
private routine ChannelCore[T].push(me: @Me, value: T) -> Void
needs T: typename
    capacity: USize = me.items.count()
    at: USize = (me.head.peek() + me.count.peek()) % capacity
    me.items.store(index: at, value)
    me.count.poke(me.count.peek() + 1)
    wake_list(me.getters.peek())
    return

/// Takes the oldest value and wakes the waiting senders. The lock is held and there is a value.
/// :returns: The value.
@target(os: not "none")
private routine ChannelCore[T].pop(me: @Me) -> T
needs T: typename
    head: USize = me.head.peek()
    value: T = me.items.load(index: head)
    me.head.poke((head + 1) % me.items.count())
    me.count.poke(me.count.peek() - 1)
    wake_list(me.putters.peek())
    return value

/// Wakes every waiter in the list. Each takes itself out when it runs again.
/// :param first: The first waiting node, or null.
@target(os: not "none")
private routine wake_list(first: @ChannelWait) -> Void
    until node.is_null() with node: @ChannelWait = first
        node.waiter.peek().wake()
        continue with node: node.next.peek()
    then
        return

/// Takes `node` out of the list at `list`, if it is there.
/// :param list: The place of the list's first node.
/// :param node: The node.
@target(os: not "none")
private routine unlink(list: @@ChannelWait, node: @ChannelWait) -> Void
    while true with link: @@ChannelWait = list
        current2: @ChannelWait = link.peek()
        if current2.is_null()
            return
        if current2.ptr_eq(node)
            link.poke(node.next.peek())
            node.next.poke(null)
            return
        else
            continue with link: current2.next
