// Tessera stdlib: the C runtime calls the hosted layer needs
//
// write(2) for standard output and error (Os/Stdio.tess), files, and the
// fiber scheduler's write, read(2) for standard input and the scheduler's
// read, and exit(3) for the default crash handler. Printing goes
// through a writer: Out.write("x = {x}\n") for stdout, Err.write for stderr,
// and out.write(...) for any other Writer.
//
// CInt and SSize appear only on these externs. Lengths are USize.

module Standard::Os

/// Binds the C `write` function, which writes bytes to a file descriptor.
/// :param fd: The file descriptor to write to.
/// :param buf: The first byte to write.
/// :param count: How many bytes to write.
/// :returns: The number of bytes written (possibly fewer than `count`), or -1 with `errno` set.
#[external("c"), symbol("write")]
routine c_write(fd: CInt, buf: @Byte, count: USize) -> SSize

/// Binds the C `read` function, which reads bytes from a file descriptor.
/// :param fd: The file descriptor to read from.
/// :param buf: Where the bytes go.
/// :param count: The most bytes to read.
/// :returns: The number of bytes read (0 at end of input), or -1 with `errno` set.
#[external("c"), symbol("read")]
routine c_read(fd: CInt, buf: @Byte, count: USize) -> SSize

/// Binds the C `exit` function, which ends the process after flushing C's streams and running `atexit` handlers.
/// :param status: The process's exit status.
#[external("c"), symbol("exit"), noreturn]
routine c_exit(status: CInt) -> Void
