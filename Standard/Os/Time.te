# Tessera stdlib: the clocks
#
# Clock.now() reads the date and time, a Moment. Clock.monotonic() reads a clock that only goes forward, a Duration since
# a start the operating system chooses: for measuring time and for deadlines. CpuClock.now() reads how much processor
# time the process has used. clock_gettime on Linux and macOS, GetSystemTimePreciseAsFileTime,
# QueryPerformanceCounter and GetProcessTimes on Windows.

module Standard/Os

### The clock: the date and time (`Clock.now()`) and a clock that only goes forward (`Clock.monotonic()`) for measuring
### time and for deadlines. Every value is the same clock, so the routines are called on the type.
record Clock
    nothing

### The processor time the process has used (`CpuClock.now()`), all its threads together. Every value is the same
### clock, so the routines are called on the type.
record CpuClock
    nothing

### struct timespec, with C's long for both fields as Linux and macOS have it.
secret record Timespec
    sec: CLong
    nsec: CLong

### Makes a `Timespec` from its fields.
### :param sec: Its `sec`.
### :param nsec: Its `nsec`.
### :returns: The new value.
common routine Timespec.construct(sec: CLong, nsec: CLong) -> Me
    return Me(sec, nsec)

### Releases nothing: a `Timespec` holds no memory of its own.
routine @Timespec.destruct() -> None
    return

# -- POSIX: clock_gettime ------------------------------------------------------------

### Binds the C `clock_gettime` function, which reads a clock.
### :param clock: The clock id, such as CLOCK_MONOTONIC.
### :param out: Where the reading goes.
### :returns: 0 on success, or -1 with `errno` set.
@external("c")
@symbol("clock_gettime")
@target(os: ("linux", "macos"))
secret routine c_clock_gettime(clock: CInt, out: @Timespec) -> CInt

### CLOCK_MONOTONIC, whose number depends on the operating system.
### :returns: The clock id.
@target(os: "macos")
secret routine clock_monotonic() -> CInt
    return 6

### CLOCK_MONOTONIC, whose number depends on the operating system.
### :returns: The clock id.
@target(os: "linux")
secret routine clock_monotonic() -> CInt
    return 1

### CLOCK_PROCESS_CPUTIME_ID, whose number depends on the operating system.
### :returns: The clock id.
@target(os: "macos")
secret routine clock_process_cputime() -> CInt
    return 12

### CLOCK_PROCESS_CPUTIME_ID, whose number depends on the operating system.
### :returns: The clock id.
@target(os: "linux")
secret routine clock_process_cputime() -> CInt
    return 2

### Reads a clock with clock_gettime.
### :param clock: The clock id.
### :returns: The reading as seconds and nanoseconds.
@target(os: ("linux", "macos"))
secret routine read_clock(clock: CInt) -> Duration
    ts: &Timespec <- Timespec(sec: 0, nsec: 0)

    c_clock_gettime(clock, ts)
    return Duration.from_parts(seconds: ts.sec.peek().to[S64](),
        nanoseconds: ts.nsec.peek().to[U32]())

### Reads the date and time.
### :returns: The current moment.
@target(os: ("linux", "macos"))
common routine Clock.now() -> Moment
    return Moment.from_epoch(read_clock(0))  # CLOCK_REALTIME

### Reads a clock that only goes forward: the time since a start the operating system chooses. For measuring time and
### for deadlines (`Clock.monotonic() + 30ms`), not for the date.
### :returns: The reading. Subtract two readings to get the time between them.
@target(os: ("linux", "macos"))
common routine Clock.monotonic() -> Duration
    return read_clock(clock_monotonic())

### Reads the processor time the process has used, all its threads together.
### :returns: The reading. Subtract two readings to get the processor time between them.
@target(os: ("linux", "macos"))
common routine CpuClock.now() -> Duration
    return read_clock(clock_process_cputime())

# -- Windows -------------------------------------------------------------------------

### Binds the Win32 `QueryPerformanceCounter` function, which reads the high-resolution counter.
### :param count: Where the counter's value goes, in ticks.
### :returns: Nonzero on success (always, on Windows XP and later).
@external("c")
@symbol("QueryPerformanceCounter")
@callconv("stdcall")
@target(os: "windows")
secret routine c_query_performance_counter(count: @S64) -> CInt

### Binds the Win32 `QueryPerformanceFrequency` function, which reads the counter's ticks per second.
### :param frequency: Where the ticks per second go.
### :returns: Nonzero on success (always, on Windows XP and later).
@external("c")
@symbol("QueryPerformanceFrequency")
@callconv("stdcall")
@target(os: "windows")
secret routine c_query_performance_frequency(frequency: @S64) -> CInt

### Binds the Win32 `GetSystemTimePreciseAsFileTime` function, which reads the date and time.
### :param time: Where the FILETIME goes: 100-nanosecond ticks since 1601-01-01 UTC.
@external("c")
@symbol("GetSystemTimePreciseAsFileTime")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_system_time_precise(time: @U64) -> None

### Binds the Win32 `GetProcessTimes` function, which reads a process's times as FILETIMEs.
### :param process: The process.
### :param creation: Where the time it started goes.
### :param exit: Where the time it ended goes.
### :param kernel: Where the processor time it spent in the kernel goes, in 100-nanosecond ticks.
### :param user: Where the processor time it spent in its own code goes, in 100-nanosecond ticks.
### :returns: Nonzero on success.
@external("c")
@symbol("GetProcessTimes")
@callconv("stdcall")
@target(os: "windows")
secret routine c_get_process_times(process: Addr, creation: @U64, exit: @U64, kernel: @U64,
    user: @U64) -> CInt

### A count of 100-nanosecond ticks as a Duration.
### :param ticks: The ticks.
### :returns: The duration.
@target(os: "windows")
secret routine of_ticks(ticks: U64) -> Duration
    seconds: S64 = (ticks // 10000000).to[S64]()
    return Duration.from_parts(seconds, nanoseconds: (ticks % 10000000 * 100).to[U32]())

### Reads the date and time.
### :returns: The current moment.
@target(os: "windows")
common routine Clock.now() -> Moment
    ticks: &U64 <- 0

    c_get_system_time_precise(ticks)
    # 11644473600 seconds between 1601-01-01 and 1970-01-01
    return Moment.from_epoch(of_ticks(ticks.load()) - 11644473600s)

### Reads a clock that only goes forward: the time since a start the operating system chooses. For measuring time and
### for deadlines (`Clock.monotonic() + 30ms`), not for the date.
### :returns: The reading. Subtract two readings to get the time between them.
### :note: The counter's whole seconds and its remainder are scaled apart, so the product never overflows.
@target(os: "windows")
common routine Clock.monotonic() -> Duration
    count: &S64 <- 0
    frequency: &S64 <- 1

    c_query_performance_counter(count)
    c_query_performance_frequency(frequency)
    c: S64 = count.load()
    f: S64 = frequency.load()
    nanoseconds: U32 = (c % f * 1000000000 // f).to[U32]()
    return Duration.from_parts(seconds: c // f, nanoseconds)

### Reads the processor time the process has used, all its threads together.
### :returns: The reading. Subtract two readings to get the processor time between them.
@target(os: "windows")
common routine CpuClock.now() -> Duration
    creation: &U64 <- 0
    exit: &U64 <- 0
    kernel: &U64 <- 0
    user: &U64 <- 0

    c_get_process_times(c_get_current_process(), creation, exit, kernel, user)
    return of_ticks(kernel.load() + user.load())
