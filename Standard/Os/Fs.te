    return

### Writes `The path, or a name in it, is too long.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NameTooLongError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("The path, or a name in it, is too long.")
    return

### Writes `The path isn't one the system takes: a NUL inside it, or a name it rejects.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine InvalidPathError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
