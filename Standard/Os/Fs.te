# Tessera stdlib: files and the filesystem, the parts FileManager.te is built on
#
# Paths are @[Byte], UTF-8 by convention, as every Tessera text is. Each call copies its path into a stack buffer with
# the terminator the OS wants (UTF-16 on Windows), so nothing allocates for a path. A path too long for that buffer
# (4095 bytes, or 4095 UTF-16 units on Windows) fails with NameTooLong. Only routines that hand text back
# (read_file, current_dir, ...) or build paths of their own (remove_dir_all) take an allocator. Text comes back as
# @[Byte] that carry that allocator, and the caller gives them back with destruct(), a path inside a File or Directory
# through the File's or the Directory's own destruct().
#
# Expected failures are a Result with an FsError. The per-OS halves are Fs_posix.te (Linux and macOS) and
# Fs_windows.te (the Win32 wide-character calls). Each defines the same routines and records, and this file holds
# the types they share and what is built on top of them.

module Standard/Os

### The longest path a call takes, in bytes (UTF-16 units on Windows), not counting the terminator.
preset PATH_CAPACITY: U64 = 4096

### Why a filesystem call failed.
choice FsError: U8
    NOT_FOUND
    PERMISSION_DENIED
    ALREADY_EXISTS
    NOT_A_DIRECTORY
    IS_A_DIRECTORY
    DIRECTORY_NOT_EMPTY
    CROSS_DEVICE  # a rename between filesystems: copy and remove instead
    NAME_TOO_LONG
    INVALID_PATH  # a NUL inside the path, or a name the OS rejects
    NO_SPACE
    READ_ONLY  # a read-only filesystem
    BUSY  # in use by another process (a Windows sharing violation)
    STORAGE_FAULT  # the storage device couldn't read or write (a bad sector, a failing disk, a pulled card)
    OUT_OF_MEMORY
    OTHER

choice FileKind: U8
    FILE
    DIRECTORY
    SYMLINK
    OTHER

### A file's metadata. Times are nanoseconds since 1970-01-01 UTC.
record Metadata
    kind: FileKind
    size: U64
    modified_ns: S64
    created_ns: Maybe[S64]  # None where the filesystem doesn't record it
    readonly: Bool

choice OpenMode: U8
    READ  # an existing file, for reading
    WRITE  # an existing file, emptied, for writing
    APPEND  # an existing file, for writing at its end
    READ_WRITE  # an existing file, for both
    CREATE_NEW  # for writing, made here: AlreadyExists if something is there
    CREATE_REPLACING  # for writing, made here, or emptied when a file is there

choice SeekFrom: U8
    START
    CURRENT
    END

choice Access: U8
    READ
    WRITE
    EXECUTE

### One entry of a directory listing.
record DirEntry
    name: @[Byte]  # the entry's name, valid until the iterator's next call
    kind: FileKind

### A file seen as cells of `T`, mapped into memory (mmap, or CreateFileMapping and MapViewOfFile): random access
### by index, `storage[i]` and `storage[i] = v`, each read and write going to the file through the OS's page cache.
### It comes from {OsFileManager.storage_result}, and `unmap` gives it back (writing changed pages first).
### `FileStorage[Byte]` is the file's bytes, `FileStorage[Char]` its Unicode scalars, four bytes each (UTF-32LE). A
### UTF-8 text file isn't a `FileStorage[Char]`: read it as bytes.
### :typeparam T: The cell type, `Byte` or `Char`.
record FileStorage[T]
needs T: typename, StorageCell[T]
obeys ViewingIndexable[FileStorage[T], T], ModifyingIndexable[FileStorage[T], T]
    base: Addr  # what the OS mapped, from an aligned offset (null for an empty storage)
    delta: U64  # bytes from base to the first cell asked for
    count: U64  # the cells mapped from there
    writable: Bool  # whether stores reach the file (mapped with write: true)

### Why a move failed, and whether the copy at the destination was finished.
record MoveError
    reason: FsError  # what the OS reported
    copied: Bool  # true when the copy at the destination is whole and the source is still there, as deleting it failed

### A type a {FileStorage} keeps one value of in each cell: `Byte` (one byte) and `Char` (four bytes, a Unicode
### scalar as UTF-32LE). A cell's bytes are read and written through these two routines.
### :typeparam T: The cell type.
protocol StorageCell[T]
needs T: typename
    ### The value the cell at `at` holds.
    ### :param at: The cell's first byte.
    ### :returns: The value, or `None` when the cell's bytes aren't a value of the type.
    common routine Me.from_cell(at: @Byte) -> Maybe[Me]

    ### Writes `me` into the cell at `at`.
    ### :param at: The cell's first byte.
    routine Me.into_cell(at: @Byte) -> None

obeys StorageCell[Byte], StorageCell[Char]

### Makes a `FileStorage` from its fields.
### :param base: Its `base`.
### :param delta: Its `delta`.
### :param count: Its `count`.
### :param writable: Its `writable`.
### :returns: The new value.
common routine FileStorage[T].construct(base: Addr, delta: U64, count: U64, writable: Bool) -> Me
needs T: typename, StorageCell[T]
    return Me(base, delta, count, writable)

### A `FileStorage` over a mapping made elsewhere, from its base, delta, and cell count, to flush or unmap it. Its cells
### count as writable.
### :param base: The mapping's base.
### :param delta: Bytes from the base to the first cell.
### :param count: The number of cells.
### :returns: The new value.
common routine FileStorage[T].construct(base: Addr, delta: U64, count: U64) -> Me
needs T: typename, StorageCell[T]
    return Me(base, delta, count, writable: true)

### Releases nothing: a `FileStorage` is given back with `unmap`.
routine @FileStorage[T].destruct() -> None
needs T: typename, StorageCell[T]
    return

### Makes a `MoveError` from its fields.
### :param reason: Its `reason`.
### :param copied: Its `copied`.
### :returns: The new value.
common routine MoveError.construct(reason: FsError, copied: Bool) -> Me
    return Me(reason, copied)

### Releases nothing: a `MoveError` holds no memory of its own.
routine @MoveError.destruct() -> None
    return

### Makes a `DirEntry` from its fields.
### :param name: Its `name`.
### :param kind: Its `kind`.
### :returns: The new value.
common routine DirEntry.construct(name: @[Byte], kind: FileKind) -> Me
    return Me(name, kind)

### Releases the memory its `name` holds.
routine @DirEntry.destruct() -> None
    me.name.destruct()
    return

### The success value of a filesystem call that has nothing to return.
### :returns: `Unit`.
secret routine fs_done() -> Result[None, FsError]
    return None()

### Why path didn't fit a C path: a NUL inside, or too long.
### :param path: The path that didn't fit.
### :returns: `InvalidPath` when `path` holds a NUL, else `NameTooLong`.
secret routine path_error(path: @[Byte]) -> FsError
    if path.has("\0")
        return FsError.INVALID_PATH
    return FsError.NAME_TOO_LONG

# -- built on the per-OS calls ---------------------------------------------------------

### Whether something is at path (a link counts as what it points at).
### :param path: The path to look at.
### :returns: True when the metadata of `path` can be read. Any failure, not only `NotFound`, gives false.
secret routine is_present(path: @[Byte]) -> Bool
    m: Result[Metadata, FsError] = metadata(path)
    return m.is_success()

### Whether something is at path and is of the given kind (a link counts as what it points at).
### :param path: The path to look at.
### :param kind: The kind to test for.
### :returns: True when the metadata of `path` can be read and its kind is `kind`.
secret routine is_kind(path: @[Byte], kind: FileKind) -> Bool
    m: Result[Metadata, FsError] = metadata(path)
    when m
        is Metadata as info => return info.kind == kind
        is FsError => return false

### Like mkdir -p: every missing directory on the way, then path. A directory already there is fine.
### :param path: The directory to make.
### :returns: `Unit` once `path` is a directory.
### :throws: Returns the reason when the last step fails, `AlreadyExists` when something other than a
###     directory is at `path`.
secret routine create_dir_all(path: @[Byte]) -> Result[None, FsError]
    # Each separator after the first byte ends a prefix to make. Failures there show up in the last step.
    each i in 1 til path.count()
        if is_separator(path.byte_at(i).bits())
            create_dir(path.slice(start: 0, end: i))
    made: Result[None, FsError] = create_dir(path)
    when made
        is None => return made
        is FsError as error =>
            if error == FsError.ALREADY_EXISTS and is_kind(path, kind: FileKind.DIRECTORY)
                return fs_done()
            return error

### Removes path and everything in it. A link is removed, not followed. Child paths are built in memory from alloc.
### :param path: The file or directory to remove.
### :param alloc: The allocator for the child paths, each given back before the next.
### :returns: `Unit` once everything is gone.
### :throws: Returns the first error, which stops the removal partway. Crashes with
###     `MemoryAllocationError` when `alloc` fails for a child path.
secret routine remove_dir_all(path: @[Byte], alloc: @MemoryManager) -> Result[None, FsError]
    m: Result[Metadata, FsError] = symlink_metadata(path)
    when m
        is Metadata as info =>
            if not (info.kind == FileKind.DIRECTORY)
                return remove_file(path)
            emptied: Result[None, FsError] = remove_entries(path, alloc)
            when emptied
                is None => return remove_dir(path)
                is FsError as error => return error
        is FsError as error => return error

### Removes everything in the directory at path, which is left empty. Its listing is closed before remove_dir_all
### removes the directory itself, since Windows can't remove a directory that is still being listed.
### :param path: The directory to empty.
### :param alloc: The allocator for the child paths.
### :returns: `Unit` once the directory is empty.
### :throws: Returns the first error. Crashes with `MemoryAllocationError` when `alloc` fails for a
###     child path.
secret routine remove_entries(path: @[Byte], alloc: @MemoryManager) -> Result[None, FsError]
    # open_path sets the handle before anything in it can fail, so finish closes a real or a null one
    local iter: @DirIter <- .hollow()

    opened: Result[None, FsError] = iter.open_path(path)
    when opened
        is None =>
            while true
                entry: Maybe[DirEntry] = iter.emit_checked()
                when entry
                    is DirEntry as e =>
                        local full: @Memory[Byte] <- join_path(a: path, b: e.name, alloc)
                        gone: Result[None, FsError] = remove_dir_all(path: full, alloc)
                        drop full
                        when gone
                            is None => continue
                            is FsError as error =>
                                iter.close()
                                return error
                    is None =>
                        result: Result[None, FsError] = fs_done()
                        iter.close()
                        return result
        is FsError as error =>
            iter.close()
            return error

### Reads the whole file at path into memory from alloc (drop it).
### :param path: The file to read.
### :param alloc: The allocator for the text.
### :returns: The file's bytes.
### :throws: Returns the reason when the file can't be opened or read, `OutOfMemory` when `alloc`
###     fails or the file is too large for the address space (4 GiB or more on a 32-bit target).
secret routine read_file(path: @[Byte], alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    opened: Result[FileHandle, FsError] = FileHandle.open(path, mode: OpenMode.READ)
    when opened
        is FileHandle as f =>
            local f2: @FileHandle <- f
            local text: @Result[Memory[Byte], FsError] <- read_rest(f: f2, alloc)
            f2.close()
            return text
        is FsError as error => return error

### Reads the rest of the open file f into memory from alloc. The size is a first guess: a file that grows while it's
### read, or reports 0 (Linux's /proc), still reads whole.
### :param f: The open file, read from its position to the end.
### :param alloc: The allocator for the text.
### :returns: The bytes read.
### :throws: Returns the reason when a read fails, `OutOfMemory` when `alloc` fails or the file is too
###     large for the address space (it reports a size, or grows to one, that a U64 can't hold).
secret routine read_rest(f: @FileHandle, alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    local buffer: @Memory[Byte] <- .hollow()

    size: Result[U64, FsError] = f.size_result()
    capacity: U64 = when size
        is U64 as n =>
            room: Maybe[U64] = n.add_checked(1)
            when room
                is U64 as with_one => becomes with_one.max(64)
                is None =>
                    drop buffer
                    return FsError.OUT_OF_MEMORY
        is FsError => 64
    when Memory[Byte].construct_result(count: capacity, manager: alloc)
        is Memory[Byte] as slice =>
            buffer.replace(value: steal slice)
            while true with count: U64 = 0
                capacity2: U64 = buffer.count()
                if count == capacity2
                    doubled: Maybe[U64] = count.mul_checked(2)
                    when doubled
                        is U64 as capacity3 =>
                            bigger: Result[None, AllocFailed] = buffer.resize_result(capacity3)
                            when bigger
                                is None => continue with count: count
                                is AllocFailed =>
                                    drop buffer
                                    return FsError.OUT_OF_MEMORY
                        is None =>
                            drop buffer
                            return FsError.OUT_OF_MEMORY
                else
                    got: Result[U64, FsError] = f.read_bytes_result(buffer: buffer.getslot(count),
                        count: capacity2 - count)
                    when got
                        is U64 as n =>
                            if n == 0
                                buffer.keep_first(count)
                                return buffer
                            continue with count: count + n
                        is FsError as error =>
                            drop buffer
                            return error
        is AllocFailed =>
            drop buffer
            return FsError.OUT_OF_MEMORY

### Writes data as the whole content of the existing file at path, which is emptied first.
### :param path: The file to write.
### :param data: The bytes that become the file.
### :returns: `Unit` once every byte is written.
### :throws: Returns the reason when the file can't be opened or written, `NotFound` when nothing is at `path`.
secret routine write_file(path: @[Byte], data: @[Byte]) -> Result[None, FsError]
    opened: Result[FileHandle, FsError] = FileHandle.open(path, mode: OpenMode.WRITE)
    when opened
        is FileHandle as f =>
            local f2: @FileHandle <- f
            wrote: Result[None, FsError] = f2.write_all_result(data: data.data, count: data.count())
            f2.close()
            return wrote
        is FsError as error => return error

# -- FileHandle: what both halves share ------------------------------------------------------

obeys Reader[FileHandle]
obeys Writer[FileHandle]

### Writes all count bytes, however many calls that takes.
### :param data: The first byte to write.
### :param count: How many bytes to write.
### :returns: `Unit` once all of them are written.
### :throws: Returns the reason when a write fails, `Other` when a write makes no progress.
@expensive("asks the operating system")
routine @FileHandle.write_all_result(data: @Byte, count: U64) -> Result[None, FsError]
    while remaining != 0 with at: @Byte = data, remaining: U64 = count
        wrote: Result[U64, FsError] = me.write_some(data: at, count: remaining)
        n: U64 = when wrote
            is U64 as n => n
            is FsError as error => return error
        if n == 0
            return FsError.OTHER
        continue with at: at.stride(n), remaining: remaining - n
    then
        return fs_done()

### The Writer side, behind handle.write("x = {x}\n"): a failure is kept for has_failed, and the bytes are dropped.
### :param data: The first byte to write.
### :param count: How many bytes to write.
@expensive("asks the operating system")
routine @FileHandle.write_bytes(data: @Byte, count: U64) -> None
    wrote: Result[None, FsError] = me.write_all_result(data, count)
    if wrote.is_success()
        return
    me.failed.poke(true)
    return

### Whether a write through the Writer side (write_bytes) failed.
### :returns: True once a `write_bytes` has failed. Nothing clears it.
routine @FileHandle.has_failed() -> Bool
    return me.failed.peek()

# -- paths (no OS calls) -----------------------------------------------------------------
#
# A separator is '/' everywhere, and '\' too on Windows. These look at the text only: nothing is resolved. The
# public form of the secret ones is a File or Directory member: name, stem, extension, parent, file, and go_to.

### Whether b is a path separator: '/' or '\' on Windows.
### :param b: The byte to test.
### :returns: True for '/' and '\'.
@target(os: "windows")
routine is_separator(b: Byte) -> Bool
    return b == b'/' or b == b'\\'

### Whether b is a path separator: '/' on Linux and macOS.
### :param b: The byte to test.
### :returns: True for '/'.
@target(os: ("linux", "macos"))
routine is_separator(b: Byte) -> Bool
    return b == b'/'

### The separator the OS writes.
### :returns: '\' on Windows.
@target(os: "windows")
routine path_separator() -> Byte
    return b'\\'

### The separator the OS writes.
### :returns: '/' on Linux and macOS.
@target(os: ("linux", "macos"))
routine path_separator() -> Byte
    return b'/'

### a and b with a separator between them (none added when a is empty or already ends with one), in memory from
### alloc. Drop it.
### :param a: The leading part.
### :param b: The part to append.
### :param alloc: The allocator for the result.
### :returns: The joined path.
### :throws: Crashes with `MemoryAllocationError` when the allocator fails.
@track_caller
@expensive("allocates the joined path")
secret routine join_path(a: @[Byte], b: @[Byte], alloc: @MemoryManager) -> Memory[Byte]
    ends: Bool = when
        a.is_empty() => true
        else => is_separator(a.byte_at(a.count() - 1).bits())
    sep: U64 = when
        ends => 0
        else => 1
    prefix_count: U64 = a.count() + sep
    count: U64 = prefix_count + b.count()
    local memory: @Memory[Byte] <- Memory[Byte].construct(count: count.max(1), manager: alloc)
    buffer: @Byte = memory.data.peek()
    buffer.copy(src: a.data, count: a.count())
    if not ends
        buffer.stride(a.count()).poke(path_separator())
    buffer.stride(a.count() + sep).copy(src: b.data, count: b.count())
    memory.keep_first(count)
    return memory

### Where path's last component ends, trailing separators left out.
### :param path: The path to look at.
### :returns: The index just past the component's last byte, 0 when `path` is empty or only separators.
secret routine name_end(path: @[Byte]) -> U64
    while end != 0 with end: U64 = path.count()
        if is_separator(path.byte_at(end - 1).bits())
            continue with end: end - 1
        return end
    then
        return 0

### Where the component that ends at end starts.
### :param path: The path to look at.
### :param end: Where the component ends, from {name_end}.
### :returns: The index just after the separator before the component, or 0 when there is none.
secret routine name_start(path: @[Byte], end: U64) -> U64
    while i != 0 with i: U64 = end
        if is_separator(path.byte_at(i - 1).bits())
            return i
        continue with i: i - 1
    then
        return 0

### The last component: "/a/b/file.txt" gives "file.txt", "/a/b/" gives "b".
### :param path: The path to look at.
### :returns: The component, borrowed from `path` (empty when `path` is empty or only separators).
secret routine file_name(path: @[Byte]) -> @[Byte]
    end: U64 = name_end(path)
    start: U64 = name_start(path, end)
    return path.slice(start, end)

### The directory part: "/a/b/c" gives "/a/b", "a/b" gives "a", "file.txt" gives "", and "/" stays "/".
### :param path: The path to look at.
### :returns: The directory part, borrowed from `path`.
secret routine parent_path(path: @[Byte]) -> @[Byte]
    local end: U64 = name_end(path)

    start: U64 = name_start(path, end)
    if start == 0
        # Separators before the name go too, but a leading root separator stays.
        # No separator before the name: the root if path is only separators, else nothing.
        if end == 0 and not path.is_empty()
            return path.slice(start: 0, end: 1)
        return path.slice(start: 0, end: 0)
    while i != 0 with i: U64 = start
        if is_separator(path.byte_at(i - 1).bits())
            continue with i: i - 1
        return path.slice(start: 0, end: i)
    then
        return path.slice(start: 0, end: 1)

### The last '.' of a name after its first character, or 0: a hidden file's leading dot isn't an extension.
### :param name: The file name to look at.
### :returns: The index of that dot, or 0 when there is none.
secret routine last_dot(name: @[Byte]) -> U64
    if name.count() < 2
        return 0
    while i != 0 with i: U64 = name.count() - 1
        if name.byte_at(i) == 46
            return i
        continue with i: i - 1
    then
        return 0

### The name without its extension: "file.txt" gives "file", "archive.tar.gz" gives "archive.tar".
### :param path: The path whose last component is used.
### :returns: The stem, borrowed from `path`.
secret routine file_stem(path: @[Byte]) -> @[Byte]
    name: @[Byte] = file_name(path)
    dot: U64 = last_dot(name)
    if dot == 0
        return name
    return name.slice(start: 0, end: dot)

### The extension without its dot: "file.txt" gives "txt", "file" and ".hidden" give "".
### :param path: The path whose last component is used.
### :returns: The extension, borrowed from `path`.
secret routine file_extension(path: @[Byte]) -> @[Byte]
    name: @[Byte] = file_name(path)
    dot: U64 = last_dot(name)
    if dot == 0
        return name.slice(start: 0, end: 0)
    return name.slice(start: dot + 1, end: name.count())

### Whether name is one name in a directory: not empty, not "." or "..", and no separator in it.
### :param name: The name to look at.
### :returns: True for a plain name.
secret routine is_plain_name(name: @[Byte]) -> Bool
    if name.is_empty() or name == "." or name == ".."
        return false
    each i in 0 til name.count()
        if is_separator(name.byte_at(i).bits())
            return false
    return true

# -- the cells of a FileStorage ---------------------------------------------------------

### The byte in the cell at `at`.
### :param at: The cell.
### :returns: The byte, always present.
common routine Byte.from_cell(at: @Me) -> Maybe[Me]
    b: Me = at.peek()
    return b

### Writes `me` into the cell at `at`.
### :param at: The cell.
routine Byte.into_cell(at: @Me) -> None
    at.poke(me)
    return

### The Unicode scalar in the four-byte cell at `at`, little-endian (UTF-32LE).
### :param at: The cell's first byte.
### :returns: The character.
### :absent: When the four bytes are above 0x10FFFF or a surrogate, so not a Unicode scalar.
common routine Char.from_cell(at: @Byte) -> Maybe[Me]
    return at.read_le[U32](0).to_checked[Me]()

### Writes `me` into the four-byte cell at `at`, little-endian (UTF-32LE).
### :param at: The cell's first byte.
routine Char.into_cell(at: @Byte) -> None
    bits: U32 = me.to[U32]()
    each i in 0 til 4
        shifted: U32 = bits >> (i * 8).to_wrap[U32]()
        at.stride(i).poke(shifted.to_wrap[U8]().bits())
    return

# -- FileStorage -------------------------------------------------------------------------

### A storage of nothing: what an empty file, or a range past the end, maps to.
### :returns: A storage with a null base and no cells.
common routine FileStorage[T].empty() -> Me
needs T: typename, StorageCell[T]
    return Me(base: .hollow(), delta: 0, count: 0, writable: false)

### The bytes one cell takes: 1 for a Byte, 4 for a Char.
### :returns: The size of `T`.
common routine FileStorage[T].cell_size() -> U64
needs T: typename, StorageCell[T]
    return sizeof[T]()

### The first byte of the first cell (null for an empty storage).
### :returns: `base` plus `delta`, or null.
routine FileStorage[T].data() -> @Byte
needs T: typename, StorageCell[T]
    if me.base.is_hollow()
        return .hollow()
    return me.base.to[@Byte]().stride(me.delta)

### The number of cells.
### :returns: The cell count, 0 for an empty storage.
routine FileStorage[T].count() -> U64
needs T: typename, StorageCell[T]
    return me.count

### The bytes the OS mapped, from `base`: the delta and every cell.
### :returns: The mapped length in bytes.
routine FileStorage[T].mapped_bytes() -> U64
needs T: typename, StorageCell[T]
    return me.delta + me.count * sizeof[T]()

### The value in cell `index`, `storage[index]`.
### :param index: The cell, from 0.
### :returns: The value.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is not below `count()`, and with `InvalidValueError`
###     when the cell's bytes aren't a `T` (four bytes that aren't a Unicode scalar, in a `FileStorage[Char]`).
@track_caller
routine FileStorage[T].getitem(index: U64) -> T
needs T: typename, StorageCell[T]
    if index >= me.count
        crash_out_of_bounds()
    when T.from_cell(at: me.data().stride(index * sizeof[T]()))
        is T as value => return value
        is None =>
            crash(name: "InvalidValueError",
                message: "This cell isn't a value of the storage's type (a Char cell holds a Unicode scalar).")

### The value in cell `index`.
### :param index: The cell, from 0.
### :returns: The value.
### :absent: When `index` is not below `count()`, or the cell's bytes aren't a `T`.
routine FileStorage[T].getitem_checked(index: U64) -> Maybe[T]
needs T: typename, StorageCell[T]
    if index >= me.count
        return None()
    return T.from_cell(at: me.data().stride(index * sizeof[T]()))

### Writes `value` into cell `index`, `storage[index] = value`. It reaches the file when the OS writes the page back,
### at `flush_result`, or at `unmap`.
### :param index: The cell, from 0.
### :param value: The value to write.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is not below `count()` (a storage never grows its file),
###     and with `InvalidValueError` when the storage was mapped without `write`.
@track_caller
routine @FileStorage[T].setitem(index: U64, value: T) -> None
needs T: typename, StorageCell[T]
    if index >= me.count.peek()
        crash_out_of_bounds()
    if not me.writable.peek()
        crash(name: "InvalidValueError",
            message: "This storage was mapped for reading only: map it with write: true to change its cells.")
    storage: Me = me.peek()
    value.into_cell(at: storage.data().stride(index * sizeof[T]()))
    return

### Where `count` cells from cell `start` begin in a file of `size` bytes, and how many of them it has: `start` and
### `count` clamped to the whole cells the file holds.
### :param size: The file's size in bytes.
### :param start: The first cell asked for.
### :param count: The most cells asked for, or `U64.MAX` for the rest.
### :param cell: The bytes of one cell.
### :returns: The byte offset of the first cell and the number of cells, 0 cells past the end.
secret routine cell_window(size: U64, start: U64, count: U64, cell: U64) -> (U64, U64)
    cells: U64 = size // cell
    if start >= cells
        return (0, 0)
    return (start * cell, count.min(cells - start))

# -- moving and copying trees ------------------------------------------------------------

### Copies the directory tree at from to to, which must not be there: each directory made, each file copied (a link
### copied as what it points at).
### :param from: The directory to copy.
### :param to: Where the copy goes.
### :param alloc: The allocator for the child paths.
### :returns: `Unit` once everything is copied.
### :throws: Returns the first error, which stops the copy partway.
secret routine copy_tree(from: @[Byte], to: @[Byte], alloc: @MemoryManager) -> Result[None, FsError]
    local iter: @DirIter <- .hollow()

    made: Result[None, FsError] = create_dir(to)
    when made
        is None => pass
        is FsError as error => return error
    opened: Result[None, FsError] = iter.open_path(from)
    when opened
        is None => pass
        is FsError as error =>
            iter.close()
            return error
    while true
        entry: Maybe[DirEntry] = iter.emit_checked()
        when entry
            is DirEntry as e =>
                local src: @Memory[Byte] <- join_path(a: from, b: e.name, alloc)
                local dst: @Memory[Byte] <- join_path(a: to, b: e.name, alloc)
                done: Result[None, FsError] = copy_entry(from: src.getview(), to: dst.getview(),
                    alloc)
                drop dst
                drop src
                when done
                    is None => continue
                    is FsError as error =>
                        iter.close()
                        return error
            is None => break
    iter.close()
    return fs_done()

### Copies one entry of a tree: a directory with everything in it, or a file (a link copied as what it points at).
### :param from: The entry to copy.
### :param to: Where the copy goes, which must not be there.
### :param alloc: The allocator for the child paths.
### :returns: `Unit` once it is copied.
### :throws: Returns the first error.
secret routine copy_entry(from: @[Byte], to: @[Byte],
    alloc: @MemoryManager) -> Result[None, FsError]
    if is_kind(path: from, kind: FileKind.DIRECTORY)
        return copy_tree(from, to, alloc)
    copied: Result[U64, FsError] = copy_file(from, to, replacing: false)
    when copied
        is U64 => return fs_done()
        is FsError as error => return error

### Whether path is a link itself.
### :param path: The path to look at.
### :returns: True when a link is at `path`.
secret routine is_link(path: @[Byte]) -> Bool
    when symlink_metadata(path)
        is Metadata as info => return info.kind == FileKind.SYMLINK
        is FsError => return false

### Whether two existing paths are on the same partition: the same device as the OS counts them.
### :param a: One path.
### :param b: The other path.
### :returns: True when both are on one partition, false when they are on two or one can't be looked at.
secret routine same_partition(a: @[Byte], b: @[Byte]) -> Bool
    first: Result[U64, FsError] = device_id(a)
    second: Result[U64, FsError] = device_id(b)
    when first
        is U64 as x =>
            when second
                is U64 as y => return x == y
                is FsError => return false
        is FsError => return false

### Moves the file or directory at from to the path to: renamed in place when both are on one partition, else copied
### there and then deleted. A directory already at `to` is replaced only when `replacing` is true and it is empty, a
### file at `to` only when `replacing` is true.
### :param from: What to move.
### :param to: The new path, in another directory.
### :param replacing: Whether something already at `to` is replaced.
### :param alloc: The allocator for the child paths of a copied tree.
### :returns: `Unit` once it is moved.
### :throws: Returns a {MoveError}: the reason, and `copied` true when the copy is whole and deleting the source
###     failed (both are there then). When the copy fails nothing is deleted, and the partial copy is removed.
secret routine move_path(from: @[Byte], to: @[Byte], replacing: Bool,
    alloc: @MemoryManager) -> Result[None, MoveError]
    # A directory goes with everything in it, and a link (to a directory too) is moved as the link.
    is_directory: Bool = is_kind(path: from, kind: FileKind.DIRECTORY) and not is_link(from)
    dir: @[Byte] = parent_path(to)
    there: @[Byte] = when
        dir.is_empty() => "."
        else => dir
    if same_partition(a: from, b: there)
        renamed: Result[None, FsError] = when
            replacing => rename(from, to)
            else => rename_no_replace(from, to)
        when renamed
            is None => return None()
            is FsError as error =>
                # Two mounts of one device still need a copy: the OS says CrossDevice for them.
                if not (error == FsError.CROSS_DEVICE)
                    return MoveError(reason: error, copied: false)
    if is_present(to)
        if not replacing
            return MoveError(reason: FsError.ALREADY_EXISTS, copied: false)
        if is_directory
            cleared: Result[None, FsError] = remove_dir(to)
            when cleared
                is None => pass
                is FsError as error => return MoveError(reason: error, copied: false)
    copied: Result[None, FsError] = when
        is_directory => copy_tree(from, to, alloc)
        else =>
            bytes: Result[U64, FsError] = copy_file(from, to, replacing)
            becomes when bytes
                is U64 => fs_done()
                is FsError as error => error
    when copied
        is None => pass
        is FsError as error =>
            # A partial tree goes, so no half copy is left (copy_file removes its own).
            if is_directory
                remove_dir_all(path: to, alloc)
            return MoveError(reason: error, copied: false)
    removed: Result[None, FsError] = when
        is_directory => remove_dir_all(path: from, alloc)
        else => remove_file(from)
    when removed
        is None => return None()
        is FsError as error => return MoveError(reason: error, copied: true)

# -- a FileStorage in a slot -------------------------------------------------------------
#
# A storage written by index (`s[i] = v`) lives in a slot, so its reading routines take the slot too.

### The number of cells.
### :returns: The cell count, 0 for an empty storage.
routine @FileStorage[T].count() -> U64
needs T: typename, StorageCell[T]
    return me.count.peek()

### The value in cell `index`, `storage[index]`.
### :param index: The cell, from 0.
### :returns: The value.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is not below `count()`, and with `InvalidValueError`
###     when the cell's bytes aren't a `T`.
@track_caller
routine @FileStorage[T].getitem(index: U64) -> T
needs T: typename, StorageCell[T]
    storage: Me = me.peek()
    return storage.getitem(index)

### The value in cell `index`.
### :param index: The cell, from 0.
### :returns: The value.
### :absent: When `index` is not below `count()`, or the cell's bytes aren't a `T`.
routine @FileStorage[T].getitem_checked(index: U64) -> Maybe[T]
needs T: typename, StorageCell[T]
    storage: Me = me.peek()
    return storage.getitem_checked(index)

### Writes changed pages back to the file.
### :returns: `Unit` once they are written.
### :throws: Returns the reason when the OS can't write them.
routine @FileStorage[T].flush_result() -> Result[None, FsError]
needs T: typename, StorageCell[T]
    storage: Me = me.peek()
    return storage.flush_result()

### Writes changed pages back, unmaps, and leaves the slot an empty storage.
routine @FileStorage[T].unmap() -> None
needs T: typename, StorageCell[T]
    storage: Me = me.peek()
    storage.unmap()
    me.poke(Me.empty())
    return
