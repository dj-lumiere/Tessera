### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NotEnoughSpaceError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("The storage has no room left.")
    return

### Writes `The partition is read-only.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine ReadOnlyError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
