# Tessera stdlib: files and the filesystem, the parts FileManager.te is built on
#
# Paths are @[Byte], UTF-8 by convention, as every Tessera text is. Each call copies its path into a stack buffer with
# the terminator the OS wants (UTF-16 on Windows), so nothing allocates for a path. A path too long for that buffer
# (4095 bytes, or 4095 UTF-16 units on Windows) throws NameTooLongError. Only routines that hand text back
# (read_file, current_dir, ...) or build paths of their own (remove_dir_all) take a memory manager. Text comes back as
# @[Byte] that carry that memory manager, and the caller gives them back with destruct(), a path inside a File or Directory
# through the File's or the Directory's own destruct().
#
# Expected failures throw one of FsError's crashables. The per-OS halves are Fs_posix.te (Linux and macOS) and
# Fs_windows.te (the Win32 wide-character calls). Each defines the same routines and records, and this file holds
# the types they share and what is built on top of them.

module Standard/Os

### The longest path a call takes, in bytes (UTF-16 units on Windows), not counting the terminator.
preset PATH_CAPACITY: U64 = 4096

### Nothing is at the path: no file or directory.
crashable NotFoundError
    nothing

### The system doesn't allow this program to do that at the path.
crashable NotEnoughPermissionError
    nothing

### Something is already at the path.
crashable AlreadyExistsError
    nothing

### A part of the path isn't a directory.
crashable NotADirectoryError
    nothing

### The path is a directory, and this works on a file.
crashable IsADirectoryError
    nothing

### The directory isn't empty.
crashable DirectoryNotEmptyError
    nothing

### The paths are on two partitions, which a rename can't cross: copy, then delete.
crashable CrossDeviceError
    nothing

### The path, or a name in it, is too long.
crashable NameTooLongError
    nothing

### The path isn't one the system takes: a NUL inside it, or a name it rejects.
crashable InvalidPathError
    nothing

### The storage has no room left.
crashable NotEnoughSpaceError
    nothing

### The partition is read-only.
crashable ReadOnlyError
    nothing

### Another program is using it.
crashable BusyError
    nothing

### The storage device couldn't read or write: a bad sector, a failing disk, a pulled card.
crashable StorageFaultError
    nothing

### A failure the system reports with no other name here: its error number says which.
crashable IoError
    code: S32

### A move that copied everything to the new place and then couldn't delete the original: both are there.
crashable OriginalKeptError
    nothing

### A cell of a file storage whose bytes aren't a value of its type: four bytes that aren't a Unicode scalar, in a
### `FileStorage[Char]`.
crashable InvalidCellError
    ### The cell, from 0.
    index: U64

### Why a file system call failed: one of the crashables a file system routine throws. `is FsError as e` on a `Check`
### takes any of them.
variant FsError
    NotFoundError
    NotEnoughPermissionError
    AlreadyExistsError
    NotADirectoryError
    IsADirectoryError
    DirectoryNotEmptyError
    CrossDeviceError
    NameTooLongError
    InvalidPathError
    NotEnoughSpaceError
    ReadOnlyError
    BusyError
    StorageFaultError
    OutOfMemoryError
    IoError

choice FileKind: U8
    FILE
    DIRECTORY
    SYMLINK
    OTHER

### A file's metadata. Times are nanoseconds since 1970-01-01 UTC.
record Metadata
    kind: FileKind
    size: U64
    modified_ns: S64
    created_ns: Maybe[S64]  # None where the filesystem doesn't record it
    readonly: Bool

choice OpenMode: U8
    READ  # an existing file, for reading
    WRITE  # an existing file, emptied, for writing
    APPEND  # an existing file, for writing at its end
    READ_WRITE  # an existing file, for both
    CREATE_NEW  # for writing, made here: AlreadyExistsError if something is there
    CREATE_REPLACING  # for writing, made here, or emptied when a file is there

choice SeekFrom: U8
    START
    CURRENT
    END

choice Access: U8
    READ
    WRITE
    EXECUTE

### One entry of a directory listing.
record DirEntry
    name: @[Byte]  # the entry's name, valid until the iterator's next call
    kind: FileKind

### A file seen as cells of `T`, mapped into memory (mmap, or CreateFileMapping and MapViewOfFile): random access
### by index, `storage[i]` and `storage[i] = v`, each read and write going to the file through the OS's page cache.
### It is borrowed from {OsFileManager.storage} with `<-` and given back with `drop`, which writes changed pages back
### and unmaps it.
### `FileStorage[Byte]` is the file's bytes, `FileStorage[Char]` its Unicode scalars, four bytes each (UTF-32LE). A
### UTF-8 text file isn't a `FileStorage[Char]`: read it as bytes.
### :typeparam T: The cell type, `Byte` or `Char`.
entity FileStorage[T]
needs T: typename, StorageCell[T]
obeys ViewingIndexable[FileStorage[T], T], ModifyingIndexable[FileStorage[T], T]
    base: Addr  # what the OS mapped, from an aligned offset (null for an empty storage)
    delta: U64  # bytes from base to the first cell asked for
    count: U64  # the cells mapped from there
    writable: Bool  # whether stores reach the file (mapped with write: true)

### A type a {FileStorage} keeps one value of in each cell: `Byte` (one byte) and `Char` (four bytes, a Unicode
### scalar as UTF-32LE). A cell's bytes are read and written through these two routines.
### :typeparam T: The cell type.
protocol StorageCell[T]
needs T: typename
    ### The value the cell at `at` holds.
    ### :param at: The cell's first byte.
    ### :returns: The value, or `None` when the cell's bytes aren't a value of the type.
    common routine Me.from_cell(at: @Byte) -> Maybe[Me]

    ### Writes `me` into the cell at `at`.
    ### :param at: The cell's first byte.
    routine Me.into_cell(at: @Byte) -> None

obeys StorageCell[Byte], StorageCell[Char]

### Writes `Nothing is at the path: no file or directory.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NotFoundError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("Nothing is at the path: no file or directory.")
    return

### Writes `The system doesn't allow this program to do that at the path.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NotEnoughPermissionError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("The system doesn't allow this program to do that at the path.")
    return

### Writes `Something is already at the path.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine AlreadyExistsError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("Something is already at the path.")
    return

### Writes `A part of the path isn't a directory.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine NotADirectoryError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
