### Writes which cell isn't a value of the storage's type.
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine InvalidCellError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("Cell {me.index} isn't a value of the storage's type (a Char cell holds a Unicode scalar).")
    return

### A `FileStorage` over a mapping made elsewhere, from its base, delta, and cell count: its `drop` writes changed pages
### back and unmaps it. Its cells count as writable.
### :param base: The mapping's base.
### :param delta: Bytes from the base to the first cell.
### :param count: The number of cells.
### :returns: The new value.
common routine FileStorage[T].construct(base: Addr, delta: U64, count: U64) -> Me
needs T: typename, StorageCell[T]
    return Me(base, delta, count, writable: true)

### Why path didn't fit a C path: a NUL inside, or too long.
### :param path: The path that didn't fit.
### :returns: `InvalidPathError` when `path` holds a NUL, else `NameTooLongError`.
secret routine path_error(path: @[Byte]) -> FsError
    if path.has("\0")
        return InvalidPathError()
    return NameTooLongError()

# -- built on the per-OS calls ---------------------------------------------------------

### Whether something is at path (a link counts as what it points at).
### :param path: The path to look at.
### :returns: True when the metadata of `path` can be read. Any failure, not only `NotFoundError`, gives false.
secret routine is_present(path: @[Byte]) -> Bool
    when check metadata(path)
        is Metadata => return true
        is FsError => return false

### Whether something is at path and is of the given kind (a link counts as what it points at).
### :param path: The path to look at.
### :param kind: The kind to test for.
### :returns: True when the metadata of `path` can be read and its kind is `kind`.
secret routine is_kind(path: @[Byte], kind: FileKind) -> Bool
    m: Check[Metadata] = check metadata(path)
    when m
        is Metadata as info => return info.kind == kind
        is FsError => return false

### Like mkdir -p: every missing directory on the way, then path. A directory already there is fine.
### :param path: The directory to make.
### :throws: Throws the reason when the last step fails, `AlreadyExistsError` when something other than a directory is
###     at `path`.
secret failable routine create_dir_all(path: @[Byte]) -> None
    # Each separator after the first byte ends a prefix to make. Failures there show up in the last step.
    each i in 1 til path.count()
        if is_separator(path.byte_at(i).bits())
            try create_dir(path.slice(start: 0, end: i))
    when check create_dir(path)
        is None => return
        is AlreadyExistsError as error =>
            if is_kind(path, kind: FileKind.DIRECTORY)
                return
            throw error

### Removes path and everything in it. A link is removed, not followed. Child paths are built in memory from manager.
### :param path: The file or directory to remove.
### :param manager: The memory manager for the child paths, each given back before the next.
### :throws: Throws the first failure, which stops the removal partway. Crashes with `OutOfMemoryError` when
###     `manager` fails for a child path.
secret failable routine remove_dir_all(path: @[Byte], manager: @MemoryManager) -> None
    info: Metadata = when check symlink_metadata(path)
        is Metadata as found => found
    if not (info.kind == FileKind.DIRECTORY)
        when check remove_file(path)
            is None => return
    when check remove_entries(path, manager)
        is None => nothing
    when check remove_dir(path)
        is None => return

### Removes everything in the directory at path, which is left empty. Its listing is closed before remove_dir_all
### removes the directory itself, since Windows can't remove a directory that is still being listed.
### :param path: The directory to empty.
### :param manager: The memory manager for the child paths.
### :throws: Throws the first failure. Crashes with `OutOfMemoryError` when `manager` fails for a child path.
secret failable routine remove_entries(path: @[Byte], manager: @MemoryManager) -> None
    # open_path sets the handle before anything in it can fail, so finish closes a real or a null one
    iter: &DirIter <- .hollow()

    when check iter.open_path(path)
        is None => nothing
        is FsError as error =>
            iter.close()
            throw error
    loop
        entry: Maybe[DirEntry] = try iter.emit()
        when entry
            is DirEntry as e =>
                full: &[Byte] <- join_path(a: path, b: e.name, manager)
                gone: Check[None] = check remove_dir_all(path: full, manager)
                drop full
                when gone
                    is None => continue
                    is FsError as error =>
                        iter.close()
                        throw error
            is None =>
                iter.close()
                return

### Reads the whole file at path into memory from manager (drop it).
### :param path: The file to read.
### :param manager: The memory manager for the text.
### :returns: The file's bytes.
### :throws: Throws the reason when the file can't be opened or read, `OutOfMemoryError` when `manager` fails or
###     the file is too large for the address space (4 GiB or more on a 32-bit target).
secret failable routine read_file(path: @[Byte], manager: @MemoryManager) -> BorrowedSlice[Byte]
    f: &FileHandle <- .hollow()

    when check FileHandle.open(path, mode: OpenMode.READ)
        is FileHandle as opened => f.store(opened)
    when check read_rest(f, manager)
        is BorrowedSlice[Byte] as text =>
            f.close()
            return text
        is FsError as error =>
            f.close()
            throw error

### Reads the rest of the open file f into memory from manager. The size is a first guess: a file that grows while it's
### read, or reports 0 (Linux's /proc), still reads whole.
### :param f: The open file, read from its position to the end.
### :param manager: The memory manager for the text.
### :returns: The bytes read.
### :throws: Throws the reason when a read fails, `OutOfMemoryError` when `manager` fails or the file is too large
###     for the address space (it reports a size, or grows to one, that a U64 can't hold).
secret failable routine read_rest(f: @FileHandle, manager: @MemoryManager) -> BorrowedSlice[Byte]
    buffer: &[Byte] <- .hollow()

    capacity: U64 = when check f.size()
        is U64 as n =>
            room: Maybe[U64] = try n.add(1)
            when room
                is U64 as with_one => becomes with_one.max(64)
                is None =>
                    drop buffer
                    throw OutOfMemoryError()
        is FsError => 64
    when check BorrowedSlice[Byte].construct(count: capacity, manager: manager)
        is BorrowedSlice[Byte] as slice => buffer.replace(value: steal slice)
        is OutOfMemoryError as error =>
            drop buffer
            throw error
    loop with count: U64 = 0
        capacity2: U64 = buffer.count()
        if count == capacity2
            doubled: Maybe[U64] = try count.mul(2)
            when doubled
                is U64 as capacity3 =>
                    when check buffer.resize(capacity3)
                        is None => continue with count: count
                        is OutOfMemoryError as error =>
                            drop buffer
                            throw error
                is None =>
                    drop buffer
                    throw OutOfMemoryError()
        got: Check[U64] = check f.read_bytes(buffer: buffer.getslot(count),
            count: capacity2 - count)
        when got
            is U64 as n =>
                if n == 0
                    buffer.keep_first(count)
                    return buffer
                continue with count: count + n
            is FsError as error =>
                drop buffer
                throw error

### Writes data as the whole content of the existing file at path, which is emptied first.
### :param path: The file to write.
### :param data: The bytes that become the file.
### :throws: Throws the reason when the file can't be opened or written, `NotFoundError` when nothing is at `path`.
secret failable routine write_file(path: @[Byte], data: @[Byte]) -> None
    f: &FileHandle <- .hollow()

    when check FileHandle.open(path, mode: OpenMode.WRITE)
        is FileHandle as opened => f.store(opened)
    wrote: Check[None] = check f.write_all(data: data.data, count: data.count())
    f.close()
    when wrote
        is None => return

# -- FileHandle: what both halves share ------------------------------------------------------

obeys Reader[FileHandle]
obeys Writer[FileHandle]

### Writes all count bytes, however many calls that takes.
### :param data: The first byte to write.
### :param count: How many bytes to write.
### :throws: Throws the reason when a write fails, `IoError` when a write makes no progress.
@expensive("asks the operating system")
failable routine @FileHandle.write_all(data: @Byte, count: U64) -> None
    until remaining == 0 with at: @Byte = data, remaining: U64 = count
        n: U64 = when check me.write_some(data: at, count: remaining)
            is U64 as written => written
        if n == 0
            throw IoError(code: 0)
        continue with at: at.stride(n), remaining: remaining - n
    then
        return

### The Writer side, behind handle.write("x = {x}\n"): a failure is kept for has_failed, and the bytes are dropped.
### :param data: The first byte to write.
### :param count: How many bytes to write.
@expensive("asks the operating system")
routine @FileHandle.write_bytes(data: @Byte, count: U64) -> None
    when check me.write_all(data, count)
        is None => return
        is FsError => me.failed.poke(true)
    return

### Whether a write through the Writer side (write_bytes) failed.
### :returns: True once a `write_bytes` has failed. Nothing clears it.
routine @FileHandle.has_failed() -> Bool
    return me.failed.peek()

# -- paths (no OS calls) -----------------------------------------------------------------
#
# A separator is '/' everywhere, and '\' too on Windows. These look at the text only: nothing is resolved. The
# public form of the secret ones is a File or Directory member: name, stem, extension, parent, file, and go_to.

### Whether b is a path separator: '/' or '\' on Windows.
### :param b: The byte to test.
### :returns: True for '/' and '\'.
@target(os: "windows")
routine is_separator(b: Byte) -> Bool
    return b == b'/' or b == b'\\'

### Whether b is a path separator: '/' on Linux and macOS.
### :param b: The byte to test.
### :returns: True for '/'.
@target(os: ("linux", "macos"))
routine is_separator(b: Byte) -> Bool
    return b == b'/'

### The separator the OS writes.
### :returns: '\' on Windows.
@target(os: "windows")
routine path_separator() -> Byte
    return b'\\'

### The separator the OS writes.
### :returns: '/' on Linux and macOS.
@target(os: ("linux", "macos"))
routine path_separator() -> Byte
    return b'/'

### a and b with a separator between them (none added when a is empty or already ends with one), in memory from
### manager. Drop it.
### :param a: The leading part.
### :param b: The part to append.
### :param manager: The memory manager for the result.
### :returns: The joined path.
### :throws: Crashes with `OutOfMemoryError` when the memory manager fails.
@track_caller
@expensive("allocates the joined path")
secret routine join_path(a: @[Byte], b: @[Byte], manager: @MemoryManager) -> BorrowedSlice[Byte]
    ends: Bool = when
        a.is_empty() => true
        else => is_separator(a.byte_at(a.count() - 1).bits())
    sep: U64 = when
        ends => 0
        else => 1
    prefix_count: U64 = a.count() + sep
    count: U64 = prefix_count + b.count()
    memory: &[Byte] <- BorrowedSlice[Byte].construct(count: count.max(1), manager: manager)
    buffer: @Byte = memory.data.peek()
    buffer.copy(src: a.data, count: a.count())
    if not ends
        buffer.stride(a.count()).poke(path_separator())
    buffer.stride(a.count() + sep).copy(src: b.data, count: b.count())
    memory.keep_first(count)
    return memory

### Where path's last component ends, trailing separators left out.
### :param path: The path to look at.
### :returns: The index just past the component's last byte, 0 when `path` is empty or only separators.
secret routine name_end(path: @[Byte]) -> U64
    until end == 0 with end: U64 = path.count()
        if is_separator(path.byte_at(end - 1).bits())
            continue with end: end - 1
        return end
    then
        return 0

### Where the component that ends at end starts.
### :param path: The path to look at.
### :param end: Where the component ends, from {name_end}.
### :returns: The index just after the separator before the component, or 0 when there is none.
secret routine name_start(path: @[Byte], end: U64) -> U64
    until i == 0 with i: U64 = end
        if is_separator(path.byte_at(i - 1).bits())
            return i
        continue with i: i - 1
    then
        return 0

### The last component: "/a/b/file.txt" gives "file.txt", "/a/b/" gives "b".
### :param path: The path to look at.
### :returns: The component, borrowed from `path` (empty when `path` is empty or only separators).
secret routine file_name(path: @[Byte]) -> @[Byte]
    end: U64 = name_end(path)
    start: U64 = name_start(path, end)
    return path.slice(start, end)

### The directory part: "/a/b/c" gives "/a/b", "a/b" gives "a", "file.txt" gives "", and "/" stays "/".
### :param path: The path to look at.
### :returns: The directory part, borrowed from `path`.
secret routine parent_path(path: @[Byte]) -> @[Byte]
    end: U64 = name_end(path)

    start: U64 = name_start(path, end)
    if start == 0
        # Separators before the name go too, but a leading root separator stays.
        # No separator before the name: the root if path is only separators, else nothing.
        if end == 0 and not path.is_empty()
            return path.slice(start: 0, end: 1)
        return path.slice(start: 0, end: 0)
    until i == 0 with i: U64 = start
        if is_separator(path.byte_at(i - 1).bits())
            continue with i: i - 1
        return path.slice(start: 0, end: i)
    then
        return path.slice(start: 0, end: 1)

### The last '.' of a name after its first character, or 0: a hidden file's leading dot isn't an extension.
### :param name: The file name to look at.
### :returns: The index of that dot, or 0 when there is none.
secret routine last_dot(name: @[Byte]) -> U64
    if name.count() < 2
        return 0
    until i == 0 with i: U64 = name.count() - 1
        if name.byte_at(i) == 46
            return i
        continue with i: i - 1
    then
        return 0

### The name without its extension: "file.txt" gives "file", "archive.tar.gz" gives "archive.tar".
### :param path: The path whose last component is used.
### :returns: The stem, borrowed from `path`.
secret routine file_stem(path: @[Byte]) -> @[Byte]
    name: @[Byte] = file_name(path)
    dot: U64 = last_dot(name)
    if dot == 0
        return name
    return name.slice(start: 0, end: dot)

### The extension without its dot: "file.txt" gives "txt", "file" and ".hidden" give "".
### :param path: The path whose last component is used.
### :returns: The extension, borrowed from `path`.
secret routine file_extension(path: @[Byte]) -> @[Byte]
    name: @[Byte] = file_name(path)
    dot: U64 = last_dot(name)
    if dot == 0
        return name.slice(start: 0, end: 0)
    return name.slice(start: dot + 1, end: name.count())

### Whether name is one name in a directory: not empty, not "." or "..", and no separator in it.
### :param name: The name to look at.
### :returns: True for a plain name.
secret routine is_plain_name(name: @[Byte]) -> Bool
    if name.is_empty() or name == "." or name == ".."
        return false
    each i in 0 til name.count()
        if is_separator(name.byte_at(i).bits())
            return false
    return true

# -- the cells of a FileStorage ---------------------------------------------------------

### The byte in the cell at `at`.
### :param at: The cell.
### :returns: The byte, always present.
common routine Byte.from_cell(at: @Me) -> Maybe[Me]
    b: Me = at.peek()
    return b

### Writes `me` into the cell at `at`.
### :param at: The cell.
routine Byte.into_cell(at: @Me) -> None
    at.poke(me)
    return

### The Unicode scalar in the four-byte cell at `at`, little-endian (UTF-32LE).
### :param at: The cell's first byte.
### :returns: The character.
### :absent: When the four bytes are above 0x10FFFF or a surrogate, so not a Unicode scalar.
common routine Char.from_cell(at: @Byte) -> Maybe[Me]
    return try at.read_le[U32](0).to[Me]()

### Writes `me` into the four-byte cell at `at`, little-endian (UTF-32LE).
### :param at: The cell's first byte.
routine Char.into_cell(at: @Byte) -> None
    bits: U32 = me.to[U32]()
    each i in 0 til 4
        shifted: U32 = bits >> (i * 8).to_wrap[U32]()
        at.stride(i).poke(shifted.to_wrap[U8]().bits())
    return

# -- FileStorage -------------------------------------------------------------------------

### A storage of nothing: what an empty file, or a range past the end, maps to.
### :returns: A storage with a null base and no cells.
common routine FileStorage[T].empty() -> Me
needs T: typename, StorageCell[T]
    return Me(base: .hollow(), delta: 0, count: 0, writable: false)

### The bytes one cell takes: 1 for a Byte, 4 for a Char.
### :returns: The size of `T`.
common routine FileStorage[T].cell_size() -> U64
needs T: typename, StorageCell[T]
    return sizeof[T]()

### Writes changed pages back and unmaps the storage, which then holds nothing.
routine @FileStorage[T].destruct() -> None
needs T: typename, StorageCell[T]
    base: Addr = me.base.peek()
    if base.is_hollow()
        return
    unmap_mapping(base, bytes: me.mapped_bytes())
    me.base.poke(.hollow())
    me.count.poke(0)
    return

### The first byte of the first cell (null for an empty storage).
### :returns: `base` plus `delta`, or null.
routine @FileStorage[T].data() -> @Byte
needs T: typename, StorageCell[T]
    base: Addr = me.base.peek()
    if base.is_hollow()
        return .hollow()
    return base.to[@Byte]().stride(me.delta.peek())

### The number of cells.
### :returns: The cell count, 0 for an empty storage.
routine @FileStorage[T].count() -> U64
needs T: typename, StorageCell[T]
    return me.count.peek()

### The bytes the OS mapped, from `base`: the delta and every cell.
### :returns: The mapped length in bytes.
routine @FileStorage[T].mapped_bytes() -> U64
needs T: typename, StorageCell[T]
    return me.delta.peek() + me.count.peek() * sizeof[T]()

### The value in cell `index`, `storage[index]`.
### :param index: The cell, from 0.
### :returns: The value.
### :throws: Throws `IndexOutOfBoundsError` when `index` is not below `count()`, and `InvalidCellError` when the cell's
###     bytes aren't a `T` (four bytes that aren't a Unicode scalar, in a `FileStorage[Char]`).
failable routine @FileStorage[T].getitem(index: U64) -> T
needs T: typename, StorageCell[T]
    count: U64 = me.count.peek()
    if index >= count
        throw IndexOutOfBoundsError(index, count)
    when T.from_cell(at: me.data().stride(index * sizeof[T]()))
        is T as value => return value
        is None => throw InvalidCellError(index)

### Writes `value` into cell `index`, `storage[index] = value`. It reaches the file when the OS writes the page back,
### at `flush`, or at `drop`.
### :param index: The cell, from 0.
### :param value: The value to write.
### :throws: Crashes with `IndexOutOfBoundsError` when `index` is not below `count()` (a storage never grows its file),
###     and with `UnacceptedValueError` when the storage was mapped without `write`.
@track_caller
routine @FileStorage[T].setitem(index: U64, value: T) -> None
needs T: typename, StorageCell[T]
    if index >= me.count.peek()
        throw IndexOutOfBoundsError(index, count: me.count.peek())
    if not me.writable.peek()
        throw UnacceptedValueError(
            description: "This storage was mapped for reading only: map it with write: true to change its cells.")
    value.into_cell(at: me.data().stride(index * sizeof[T]()))
    return

### Writes changed pages back to the file.
### :throws: Throws the reason when the OS can't write them.
failable routine @FileStorage[T].flush() -> None
needs T: typename, StorageCell[T]
    base: Addr = me.base.peek()
    if base.is_hollow()
        return
    when check flush_mapping(base, bytes: me.mapped_bytes())
        is None => return

### Asks the OS to read the whole storage in now.
routine @FileStorage[T].prefetch() -> None
needs T: typename, StorageCell[T]
    base: Addr = me.base.peek()
    if base.is_hollow()
        return
    prefetch_mapping(base, bytes: me.mapped_bytes())
    return

### Tells the OS the storage will be read front to back.
routine @FileStorage[T].advise_sequential() -> None
needs T: typename, StorageCell[T]
    base: Addr = me.base.peek()
    if base.is_hollow()
        return
    advise_sequential_mapping(base, bytes: me.mapped_bytes())
    return

### Takes the mapping out of the storage, which then holds nothing (its `drop` unmaps nothing): for code that hands
### the mapping on by its address and later gives it back through {FileStorage.construct} and `drop`.
### :returns: The mapping's base (null for an empty storage).
routine @FileStorage[T].take_mapping() -> Addr
needs T: typename, StorageCell[T]
    base: Addr = me.base.peek()
    me.base.poke(.hollow())
    me.count.poke(0)
    me.delta.poke(0)
    return base

### Where `count` cells from cell `start` begin in a file of `size` bytes, and how many of them it has: `start` and
### `count` clamped to the whole cells the file holds.
### :param size: The file's size in bytes.
### :param start: The first cell asked for.
### :param count: The most cells asked for, or `U64.MAX` for the rest.
### :param cell: The bytes of one cell.
### :returns: The byte offset of the first cell and the number of cells, 0 cells past the end.
secret routine cell_window(size: U64, start: U64, count: U64, cell: U64) -> (U64, U64)
    cells: U64 = size // cell
    if start >= cells
        return (0, 0)
    return (start * cell, count.min(cells - start))

# -- moving and copying trees ------------------------------------------------------------

### Copies the directory tree at from to to, which must not be there: each directory made, each file copied (a link
### copied as what it points at).
### :param from: The directory to copy.
### :param to: Where the copy goes.
### :param manager: The memory manager for the child paths.
### :throws: Throws the first failure, which stops the copy partway.
secret failable routine copy_tree(from: @[Byte], to: @[Byte], manager: @MemoryManager) -> None
    iter: &DirIter <- .hollow()

    when check create_dir(to)
        is None => nothing
    when check iter.open_path(from)
        is None => nothing
        is FsError as error =>
            iter.close()
            throw error
    loop
        entry: Maybe[DirEntry] = try iter.emit()
        when entry
            is DirEntry as e =>
                src: &[Byte] <- join_path(a: from, b: e.name, manager)
                dst: &[Byte] <- join_path(a: to, b: e.name, manager)
                done: Check[None] = check copy_entry(from: src.getslice(), to: dst.getslice(),
                    manager)
                drop dst
                drop src
                when done
                    is None => continue
                    is FsError as error =>
                        iter.close()
                        throw error
            is None => break
    iter.close()
    return

### Copies one entry of a tree: a directory with everything in it, or a file (a link copied as what it points at).
### :param from: The entry to copy.
### :param to: Where the copy goes, which must not be there.
### :param manager: The memory manager for the child paths.
### :throws: Throws the first failure.
secret failable routine copy_entry(from: @[Byte], to: @[Byte], manager: @MemoryManager) -> None
    if is_kind(path: from, kind: FileKind.DIRECTORY)
        when check copy_tree(from, to, manager)
            is None => return
    when check copy_file(from, to, replacing: false)
        is U64 => return

### Whether path is a link itself.
### :param path: The path to look at.
### :returns: True when a link is at `path`.
secret routine is_link(path: @[Byte]) -> Bool
    when check symlink_metadata(path)
        is Metadata as info => return info.kind == FileKind.SYMLINK
        is FsError => return false

### Whether two existing paths are on the same partition: the same device as the OS counts them.
### :param a: One path.
### :param b: The other path.
### :returns: True when both are on one partition, false when they are on two or one can't be looked at.
secret routine same_partition(a: @[Byte], b: @[Byte]) -> Bool
    first: Maybe[U64] = try device_id(a)
    second: Maybe[U64] = try device_id(b)
    when first
        is U64 as x =>
            when second
                is U64 as y => return x == y
                is None => return false
        is None => return false

### Moves the file or directory at from to the path to: renamed in place when both are on one partition, else copied
### there and then deleted. A directory already at `to` is replaced only when `replacing` is true and it is empty, a
### file at `to` only when `replacing` is true.
### :param from: What to move.
### :param to: The new path, in another directory.
### :param replacing: Whether something already at `to` is replaced.
### :param manager: The memory manager for the child paths of a copied tree.
### :throws: Throws the reason the move failed. When the copy fails nothing is deleted and the partial copy is
###     removed. Throws `OriginalKeptError` when the copy is whole and deleting the source failed (both are there then).
secret failable routine move_path(from: @[Byte], to: @[Byte], replacing: Bool,
    manager: @MemoryManager) -> None
    # A directory goes with everything in it, and a link (to a directory too) is moved as the link.
    is_directory: Bool = is_kind(path: from, kind: FileKind.DIRECTORY) and not is_link(from)
    dir: @[Byte] = parent_path(to)
    there: @[Byte] = when
        dir.is_empty() => "."
        else => dir
    if same_partition(a: from, b: there)
        # Two mounts of one device still need a copy: the OS says CrossDeviceError for them.
        when check rename_with(from, to, replacing)
            is None => return
            is CrossDeviceError => nothing
    if is_present(to)
        if not replacing
            throw AlreadyExistsError()
        if is_directory
            when check remove_dir(to)
                is None => nothing
    if is_directory
        when check copy_tree(from, to, manager)
            is None => nothing
            is FsError as error =>
                # A partial tree goes, so no half copy is left.
                try remove_dir_all(path: to, manager)
                throw error
        when check remove_dir_all(path: from, manager)
            is None => return
            is FsError => throw OriginalKeptError()
    # A failed copy_file removes its own partial copy.
    when check copy_file(from, to, replacing)
        is U64 => nothing
    when check remove_file(from)
        is None => return
        is FsError => throw OriginalKeptError()
