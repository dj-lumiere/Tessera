// Tessera stdlib: files and directories, named by their paths
//
// A File or a Directory is a path and nothing else: making one touches nothing, and each routine on it is one thing
// done at that path now. Opening a File gives a FileHandle (Fs_posix.tess, Fs_windows.tess), which reads and writes
// (a Reader and a Writer: handle.write("x = {x}\n")) until it is closed:
//
//     claim h : @FileHandle <- File.at("out.txt").open_write().unwrap()
//     h.write("total = {total}\n")
//     h.close()
//
// The path is a view, so its text must outlive the File (a literal does). A routine that makes a path (file, subdir,
// absolute, the well-known directories) takes an allocator, and the caller frees the new path with
// `path.data.free(alloc)`.

module Standard::Os

import Standard::Alloc

/// A file, by its path.
record File
    path : Bytes

/// A directory, by its path.
record Directory
    path : Bytes

// -- File --------------------------------------------------------------------------------

/// A file named by `path`. Nothing is touched: the path is only held, and as a view its text must outlive the file.
/// :param path: The path of the file, as UTF-8 bytes.
/// :returns: A {File} holding `path`.
routine File.at(path: Bytes) -> Self
    block entry()
        return(Self { path: path })

/// Whether something is at the path (a link counts as what it points at).
routine File.exists(self: Self) -> Bool
    block entry()
        return(exists(self.path))

/// Whether a file is at the path, not a directory or anything else.
routine File.is_file(self: Self) -> Bool
    block entry()
        return(is_kind(self.path, FileKind.File))

/// The metadata, a link followed to what it points at.
routine File.metadata(self: Self) -> Result<Metadata, FsError>
    block entry()
        return(metadata(self.path))

/// The metadata of a link itself (kind Symlink), or of what isn't one.
routine File.link_metadata(self: Self) -> Result<Metadata, FsError>
    block entry()
        return(symlink_metadata(self.path))

/// Opens an existing file for reading.
routine File.open_read(self: Self) -> Result<FileHandle, FsError>
    block entry()
        return(FileHandle.open(self.path, OpenMode.Read))

/// Opens the file for writing, made if missing and emptied if not.
routine File.open_write(self: Self) -> Result<FileHandle, FsError>
    block entry()
        return(FileHandle.open(self.path, OpenMode.Write))

/// Opens the file for writing at its end, made if missing.
routine File.open_append(self: Self) -> Result<FileHandle, FsError>
    block entry()
        return(FileHandle.open(self.path, OpenMode.Append))

/// Opens an existing file for reading and writing.
routine File.open_read_write(self: Self) -> Result<FileHandle, FsError>
    block entry()
        return(FileHandle.open(self.path, OpenMode.ReadWrite))

/// Makes the file and opens it for writing: AlreadyExists if something is at the path.
routine File.create_new(self: Self) -> Result<FileHandle, FsError>
    block entry()
        return(FileHandle.open(self.path, OpenMode.CreateNew))

/// The whole file, in memory from alloc (free it with `data.free(alloc)`).
routine File.read_all(self: Self, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        return(read_file(self.path, alloc))

/// Writes data as the whole file: made if missing, replaced if not.
routine File.write_all(self: Self, data: Bytes) -> Result<Unit, FsError>
    block entry()
        return(write_file(self.path, data))

/// Copies the bytes (and on Linux and macOS the permissions) to destination, made or replaced: the bytes copied.
routine File.copy_to(self: Self, destination: Self) -> Result<U64, FsError>
    block entry()
        return(copy_file(self.path, destination.path))

/// Moves (renames) the file to destination, replacing what is there. Between filesystems it fails with
/// CrossDevice: copy and delete instead.
routine File.move_to(self: Self, destination: Self) -> Result<Unit, FsError>
    block entry()
        return(rename(self.path, destination.path))

/// Moves the file to destination, failing with AlreadyExists if something is there.
routine File.move_to_if_absent(self: Self, destination: Self) -> Result<Unit, FsError>
    block entry()
        return(rename_no_replace(self.path, destination.path))

/// Deletes the file (or a link, not what it points at).
routine File.delete(self: Self) -> Result<Unit, FsError>
    block entry()
        return(remove_file(self.path))

/// Makes the file if it's missing, and sets its access and modification times to now.
routine File.touch(self: Self) -> Result<Unit, FsError>
    block entry()
        return(touch(self.path))

/// Sets or clears the file's read-only state. On Linux and macOS read-only takes every write permission away and
/// writable gives the owner's back; on Windows it sets or clears the read-only attribute.
/// :param readonly: `true` to make the file read-only, `false` to make it writable.
/// :returns: Success, or Failure with the {FsError} the OS reported (for example NotFound).
routine File.set_readonly(self: Self, readonly: Bool) -> Result<Unit, FsError>
    block entry()
        return(set_readonly(self.path, readonly))

/// Whether this process may read, write, or run the file.
routine File.can(self: Self, access: Access) -> Bool
    block entry()
        return(can_access(self.path, access))

/// Maps length bytes from offset (USize.MAX: to the end) into memory, clamped to the file; past the end, or an empty
/// file, gives an empty mapping. write maps it so stores reach the file; otherwise it's read-only.
routine File.map(self: Self, write: Bool, offset: U64, length: USize) -> Result<Mapping, FsError>
    block entry()
        return(Mapping.map(self.path, write, offset, length))

/// The last part of the path: "/a/b/file.txt" gives "file.txt".
routine File.name(self: Self) -> Bytes
    block entry()
        return(file_name(self.path))

/// The name without its extension: "archive.tar.gz" gives "archive.tar".
routine File.stem(self: Self) -> Bytes
    block entry()
        return(file_stem(self.path))

/// The extension without its dot: "file.txt" gives "txt", "file" gives "".
routine File.extension(self: Self) -> Bytes
    block entry()
        return(file_extension(self.path))

/// The directory the path names the file in (by the text: nothing is looked up).
routine File.parent(self: Self) -> Directory
    block entry()
        return(Directory { path: parent_path(self.path) })

/// The path made absolute by the text: the working directory in front of a relative one (on Windows "." and ".."
/// taken out too), nothing looked up. The new path is in memory from alloc.
routine File.absolute(self: Self, alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        r : Result<Bytes, FsError> = absolute_path(self.path, alloc)
        when r
            .Success(p)     -> return(.Success(Self { path: p }))
            .Failure(error) -> return(.Failure(error))

/// The absolute path with every link, ".", and ".." resolved; the file must exist. In memory from alloc.
routine File.canonical(self: Self, alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        r : Result<Bytes, FsError> = canonical_path(self.path, alloc)
        when r
            .Success(p)     -> return(.Success(Self { path: p }))
            .Failure(error) -> return(.Failure(error))

// -- Directory ---------------------------------------------------------------------------

/// A directory named by `path`. Nothing is touched: the path is only held, and as a view its text must outlive the
/// directory.
/// :param path: The path of the directory, as UTF-8 bytes.
/// :returns: A {Directory} holding `path`.
routine Directory.at(path: Bytes) -> Self
    block entry()
        return(Self { path: path })

/// Whether a directory is at the path (a link counts as what it points at).
routine Directory.exists(self: Self) -> Bool
    block entry()
        return(is_kind(self.path, FileKind.Directory))

/// The metadata of the directory, a link followed to what it points at.
/// :returns: The {Metadata}, or Failure with the {FsError} the OS reported.
routine Directory.metadata(self: Self) -> Result<Metadata, FsError>
    block entry()
        return(metadata(self.path))

/// Makes the directory; its parent must exist.
routine Directory.create(self: Self) -> Result<Unit, FsError>
    block entry()
        return(create_dir(self.path))

/// Makes the directory and every missing one on the way, like mkdir -p; one already there is fine.
routine Directory.create_all(self: Self) -> Result<Unit, FsError>
    block entry()
        return(create_dir_all(self.path))

/// Deletes the directory, which must be empty.
routine Directory.delete(self: Self) -> Result<Unit, FsError>
    block entry()
        return(remove_dir(self.path))

/// Deletes the directory and everything in it; a link inside is deleted, not followed. Child paths are built in
/// memory from alloc.
routine Directory.delete_all(self: Self, alloc: @Allocator) -> Result<Unit, FsError>
    block entry()
        return(remove_dir_all(self.path, alloc))

/// Moves (renames) the directory to destination. Between filesystems it fails with CrossDevice.
routine Directory.move_to(self: Self, destination: Self) -> Result<Unit, FsError>
    block entry()
        return(rename(self.path, destination.path))

/// Moves the directory to destination, failing with AlreadyExists if something is there.
routine Directory.move_to_if_absent(self: Self, destination: Self) -> Result<Unit, FsError>
    block entry()
        return(rename_no_replace(self.path, destination.path))

/// Sets or clears the directory's read-only state, as {File.set_readonly} does for a file.
/// :param readonly: `true` to make the directory read-only, `false` to make it writable.
/// :returns: Success, or Failure with the {FsError} the OS reported.
routine Directory.set_readonly(self: Self, readonly: Bool) -> Result<Unit, FsError>
    block entry()
        return(set_readonly(self.path, readonly))

/// Whether this process may read, write, or enter the directory.
/// :param access: The kind of access to test for.
/// :returns: `true` when the OS allows it, `false` when it refuses or the path can't be examined.
routine Directory.can(self: Self, access: Access) -> Bool
    block entry()
        return(can_access(self.path, access))

/// The last part of the path: "/a/b/" gives "b".
routine Directory.name(self: Self) -> Bytes
    block entry()
        return(file_name(self.path))

/// The directory this one is in, by the text of the path: nothing is looked up, and no memory is allocated.
/// :returns: A {Directory} over the leading part of the path.
routine Directory.parent(self: Self) -> Self
    block entry()
        return(Self { path: parent_path(self.path) })

/// The file name in this directory, its path in memory from alloc.
#track_caller
routine Directory.file(self: Self, name: Bytes, alloc: @Allocator) -> File
    block entry()
        return(File { path: join_path(self.path, name, alloc) })

/// The directory name in this directory, its path in memory from alloc.
#track_caller
routine Directory.subdir(self: Self, name: Bytes, alloc: @Allocator) -> Self
    block entry()
        return(Self { path: join_path(self.path, name, alloc) })

/// The path made absolute by its text: the working directory in front of a relative one, nothing else looked up. The
/// new path is in memory from `alloc`; free it with `path.data.free(alloc)`.
/// :param alloc: The allocator for the new path.
/// :returns: The absolute {Directory}, or Failure with the {FsError} the OS reported.
routine Directory.absolute(self: Self, alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        r : Result<Bytes, FsError> = absolute_path(self.path, alloc)
        when r
            .Success(p)     -> return(.Success(Self { path: p }))
            .Failure(error) -> return(.Failure(error))

/// The absolute path with every link, `.`, and `..` resolved. The directory must exist, and the new path is in memory
/// from `alloc`; free it with `path.data.free(alloc)`.
/// :param alloc: The allocator for the new path.
/// :returns: The canonical {Directory}, or Failure with the {FsError} the OS reported (NotFound when it is missing).
routine Directory.canonical(self: Self, alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        r : Result<Bytes, FsError> = canonical_path(self.path, alloc)
        when r
            .Success(p)     -> return(.Success(Self { path: p }))
            .Failure(error) -> return(.Failure(error))

/// The working directory, its path in memory from alloc.
routine Directory.current(alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        return(directory_of(current_dir(alloc)))

/// Makes this the working directory.
routine Directory.set_current(self: Self) -> Result<Unit, FsError>
    block entry()
        return(set_current_dir(self.path))

/// The temporary directory (TMPDIR or /tmp; on Windows GetTempPathW's), its path in memory from alloc.
routine Directory.temp(alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        return(directory_of(temp_dir(alloc)))

/// The user's home directory (HOME; on Windows USERPROFILE), its path in memory from alloc; NotFound when it can't
/// be told.
routine Directory.home(alloc: @Allocator) -> Result<Self, FsError>
    block entry()
        return(directory_of(home_dir(alloc)))

/// Wraps the path of a successful result as a {Directory}, passing a failure through unchanged.
/// :param r: A path result from one of the well-known-directory routines.
/// :returns: The same outcome, with the path as a {Directory}.
private routine directory_of(r: Result<Bytes, FsError>) -> Result<Directory, FsError>
    block entry()
        when r
            .Success(p)     -> return(.Success(Directory { path: p }))
            .Failure(error) -> return(.Failure(error))

/// Starts listing dir's entries.
routine DirIter.open(self: @Self, dir: Directory) -> Result<Unit, FsError>
    block entry()
        return(self.open_path(dir.path))
