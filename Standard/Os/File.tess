# Tessera stdlib: files and directories, named by their paths
#
# A File or a Directory is a path and nothing else: making one touches nothing, and each routine on it is one thing
# done at that path now. Opening a File gives a FileHandle (Fs_posix.tess, Fs_windows.tess), which reads and writes
# (a Reader and a Writer: handle.write("x = {x}\n")) until it is closed:
#
#     local h: @FileHandle <- File.at("out.txt").open_write_result().unwrap()
#     h.write("total = {total}\n")
#     h.close()
#
# The path is a Span[Byte]. File.at and Directory.at keep the one they're given, so a borrowed path's text must outlive
# the File (a literal's does). A routine that makes a path (file, subdir, absolute, canonical, the well-known
# directories) takes an allocator, and the File or Directory holds that memory in `storage`, which its destruct gives
# back: a File or a Directory is an entity, kept in a slot and ended with drop (`File.at(p).is_file()` on its own lasts
# the statement). Ending one over a borrowed path gives nothing back.

module Standard/Os

import Standard/Alloc

### A file, by its path. Its destruct gives the path's memory back when the File made it.
entity File
    path: Span[Byte]
    storage: Memory[Byte]  # the path's memory when it was made from an allocator, hollow when it is borrowed

### A directory, by its path. Its destruct gives the path's memory back when the Directory made it.
entity Directory
    path: Span[Byte]
    storage: Memory[Byte]  # the path's memory when it was made from an allocator, hollow when it is borrowed

### A `File` over a borrowed path, which must outlive it.
### :param path: The path.
### :returns: The new value.
routine File.construct(path: Span[Byte]) -> Me
    return Me(path, storage: .hollow())

### A `File` that takes over the memory of its path, given back by its destruct.
### :param path: The path's memory.
### :returns: The new value.
routine File.construct(path: Memory[Byte]) -> Me
    return Me(path: path.getview(), storage: steal path)

### A `Directory` over a borrowed path, which must outlive it.
### :param path: The path.
### :returns: The new value.
routine Directory.construct(path: Span[Byte]) -> Me
    return Me(path, storage: .hollow())

### A `Directory` that takes over the memory of its path, given back by its destruct.
### :param path: The path's memory.
### :returns: The new value.
routine Directory.construct(path: Memory[Byte]) -> Me
    return Me(path: path.getview(), storage: steal path)

# -- File --------------------------------------------------------------------------------

### A file named by `path`. Nothing is touched: the path is only held. A borrowed path's text must outlive the file,
### and one with an allocator goes back with drop.
### :param path: The path of the file, as UTF-8 bytes.
### :returns: A {File} holding `path`.
routine File.at(path: Span[Byte]) -> Me
    return Me.construct(path)

### Gives the path back to the allocator it came from (a path made by `Directory.file`, `absolute`, `canonical`, ...)
### and leaves the path empty. Does nothing when the path is borrowed (a literal, or text someone else gives back).
@track_caller
routine File.destruct(me: @Me) -> None
    drop me.storage
    me.path.poke(.hollow())
    return

### Whether something is at the path (a link counts as what it points at).
### :returns: True when something is at the path.
@expensive("asks the operating system")
routine File.is_present(me: @Me) -> Bool
    return is_present(me.path.peek())

### Whether a file is at the path, not a directory or anything else.
### :returns: True when a file is at the path.
@expensive("asks the operating system")
routine File.is_file(me: @Me) -> Bool
    return is_kind(path: me.path.peek(), kind: FileKind.FILE)

### The metadata, a link followed to what it points at.
### :returns: The {Metadata}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.metadata_result(me: @Me) -> Result[Metadata, FsError]
    return metadata(me.path.peek())

### The metadata of a link itself (kind Symlink), or of what isn't one.
### :returns: The {Metadata}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.link_metadata_result(me: @Me) -> Result[Metadata, FsError]
    return symlink_metadata(me.path.peek())

### Opens an existing file for reading.
### :returns: The open {FileHandle}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.open_read_result(me: @Me) -> Result[FileHandle, FsError]
    return FileHandle.open(path: me.path.peek(), mode: OpenMode.READ)

### Opens the file for writing, made if missing and emptied if not.
### :returns: The open {FileHandle}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.open_write_result(me: @Me) -> Result[FileHandle, FsError]
    return FileHandle.open(path: me.path.peek(), mode: OpenMode.WRITE)

### Opens the file for writing at its end, made if missing.
### :returns: The open {FileHandle}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.open_append_result(me: @Me) -> Result[FileHandle, FsError]
    return FileHandle.open(path: me.path.peek(), mode: OpenMode.APPEND)

### Opens an existing file for reading and writing.
### :returns: The open {FileHandle}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.open_read_write_result(me: @Me) -> Result[FileHandle, FsError]
    return FileHandle.open(path: me.path.peek(), mode: OpenMode.READ_WRITE)

### Makes the file and opens it for writing: AlreadyExists if something is at the path.
### :returns: The open {FileHandle}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.create_new_result(me: @Me) -> Result[FileHandle, FsError]
    return FileHandle.open(path: me.path.peek(), mode: OpenMode.CREATE_NEW)

### The whole file, in memory from alloc (drop it).
### :param alloc: The allocator for the bytes.
### :returns: The file's bytes, or the {FsError} the OS reported, `OutOfMemory` when
###     `alloc` fails or the file is too large for the address space (4 GiB or more on a 32-bit target).
@expensive("asks the operating system")
routine File.read_all_result(me: @Me, alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    return read_file(path: me.path.peek(), alloc)

### Writes data as the whole file: made if missing, replaced if not.
### :param data: The bytes to write.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.write_all_result(me: @Me, data: Span[Byte]) -> Result[None, FsError]
    return write_file(path: me.path.peek(), data)

### Copies the bytes (and on Linux and macOS the permissions) to destination, made or replaced: the bytes copied. On
### Linux and macOS a copy that fails once destination is opened removes it, so no partial file is left.
### :param destination: The file to copy to.
### :returns: The number of bytes copied, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.copy_to_result(me: @Me, destination: @Me) -> Result[U64, FsError]
    return copy_file(from: me.path.peek(), to: destination.path.peek())

### Moves (renames) the file to destination, replacing what is there. Between filesystems it fails with
### CrossDevice: copy and delete instead.
### :param destination: The file's new path.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.move_to_result(me: @Me, destination: @Me) -> Result[None, FsError]
    return rename(from: me.path.peek(), to: destination.path.peek())

### Moves the file to destination, failing with AlreadyExists if something is there.
### :param destination: The file's new path.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.move_to_if_absent_result(me: @Me, destination: @Me) -> Result[None, FsError]
    return rename_no_replace(from: me.path.peek(), to: destination.path.peek())

### Deletes the file (or a link, not what it points at).
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.delete_result(me: @Me) -> Result[None, FsError]
    return remove_file(me.path.peek())

### Makes the file if it's missing, and sets its access and modification times to now.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.touch_result(me: @Me) -> Result[None, FsError]
    return touch(me.path.peek())

### Sets or clears the file's read-only state. On Linux and macOS read-only takes every write permission away and
### writable gives the owner's back. On Windows it sets or clears the read-only attribute.
### :param readonly: `true` to make the file read-only, `false` to make it writable.
### :returns: Success, or the {FsError} the OS reported (for example NotFound).
@expensive("asks the operating system")
routine File.set_readonly_result(me: @Me, readonly: Bool) -> Result[None, FsError]
    return set_readonly(path: me.path.peek(), readonly)

### Whether this process may read, write, or run the file.
### :param access: The kind of access to test for.
### :returns: `true` when the OS allows it, `false` when it refuses or the path can't be examined.
@expensive("asks the operating system")
routine File.is_accessible(me: @Me, access: Access) -> Bool
    return is_accessible(path: me.path.peek(), access)

### Maps count bytes from offset (USize.MAX: to the end) into memory, clamped to the file. Past the end, or an empty
### file, gives an empty mapping. write maps it so stores reach the file. Otherwise it's read-only.
### :param write: Whether stores to the mapping reach the file.
### :param offset: The byte offset in the file to map from.
### :param count: The number of bytes to map, or `USize.MAX` for the rest of the file.
### :returns: The {Mapping}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.map_result(me: @Me, write: Bool, offset: U64, count: USize) -> Result[Mapping, FsError]
    return Mapping.map(path: me.path.peek(), write, offset, count)

### The last part of the path: "/a/b/file.txt" gives "file.txt".
### :returns: The last part of the path, a view into it.
routine File.name(me: @Me) -> Span[Byte]
    return file_name(me.path.peek())

### The name without its extension: "archive.tar.gz" gives "archive.tar".
### :returns: The name without its extension, a view into the path.
routine File.stem(me: @Me) -> Span[Byte]
    return file_stem(me.path.peek())

### The extension without its dot: "file.txt" gives "txt", "file" gives "".
### :returns: The extension, a view into the path, or empty.
routine File.extension(me: @Me) -> Span[Byte]
    return file_extension(me.path.peek())

### The directory the path names the file in (by the text: nothing is looked up).
### :returns: A {Directory} over the leading part of the path.
routine File.parent(me: @Me) -> Directory
    return Directory.construct(path: parent_path(me.path.peek()))

### The path made absolute by the text: the working directory in front of a relative one (on Windows "." and ".."
### taken out too), nothing looked up. The new path is in memory from alloc: drop it.
### :param alloc: The allocator for the new path.
### :returns: The absolute {File}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.absolute_result(me: @Me, alloc: @MemoryManager) -> Result[Me, FsError]
    when absolute_path(path: me.path.peek(), alloc)
        is Memory[Byte] as p => return Me.construct(path: steal p)
        is FsError as error => return error

### The absolute path with every link, ".", and ".." resolved. The file must exist. In memory from alloc: drop it.
### :param alloc: The allocator for the new path.
### :returns: The canonical {File}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine File.canonical_result(me: @Me, alloc: @MemoryManager) -> Result[Me, FsError]
    when canonical_path(path: me.path.peek(), alloc)
        is Memory[Byte] as p => return Me.construct(path: steal p)
        is FsError as error => return error

# -- Directory ---------------------------------------------------------------------------

### A directory named by `path`. Nothing is touched: the path is only held. A borrowed path's text must outlive the
### directory, and one with an allocator goes back with drop.
### :param path: The path of the directory, as UTF-8 bytes.
### :returns: A {Directory} holding `path`.
routine Directory.at(path: Span[Byte]) -> Me
    return Me.construct(path)

### Gives the path back to the allocator it came from (a path made by `subdir`, `current`, `temp`, ...) and leaves the
### path empty. Does nothing when the path is borrowed (a literal, or text someone else gives back).
@track_caller
routine Directory.destruct(me: @Me) -> None
    drop me.storage
    me.path.poke(.hollow())
    return

### Whether a directory is at the path (a link counts as what it points at).
### :returns: True when a directory is at the path.
@expensive("asks the operating system")
routine Directory.is_present(me: @Me) -> Bool
    return is_kind(path: me.path.peek(), kind: FileKind.DIRECTORY)

### The metadata of the directory, a link followed to what it points at.
### :returns: The {Metadata}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.metadata_result(me: @Me) -> Result[Metadata, FsError]
    return metadata(me.path.peek())

### Makes the directory. Its parent must exist.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.create_result(me: @Me) -> Result[None, FsError]
    return create_dir(me.path.peek())

### Makes the directory and every missing one on the way, like mkdir -p. One already there is fine.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.create_all_result(me: @Me) -> Result[None, FsError]
    return create_dir_all(me.path.peek())

### Deletes the directory, which must be empty.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.delete_result(me: @Me) -> Result[None, FsError]
    return remove_dir(me.path.peek())

### Deletes the directory and everything in it. A link inside is deleted, not followed. Child paths are built in
### memory from alloc.
### :param alloc: The allocator for the child paths.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.delete_all_result(me: @Me, alloc: @MemoryManager) -> Result[None, FsError]
    return remove_dir_all(path: me.path.peek(), alloc)

### Moves (renames) the directory to destination. Between filesystems it fails with CrossDevice.
### :param destination: The directory's new path.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.move_to_result(me: @Me, destination: @Me) -> Result[None, FsError]
    return rename(from: me.path.peek(), to: destination.path.peek())

### Moves the directory to destination, failing with AlreadyExists if something is there.
### :param destination: The directory's new path.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.move_to_if_absent_result(me: @Me, destination: @Me) -> Result[None, FsError]
    return rename_no_replace(from: me.path.peek(), to: destination.path.peek())

### Sets or clears the directory's read-only state, as {File.set_readonly_result} does for a file.
### :param readonly: `true` to make the directory read-only, `false` to make it writable.
### :returns: Success, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.set_readonly_result(me: @Me, readonly: Bool) -> Result[None, FsError]
    return set_readonly(path: me.path.peek(), readonly)

### Whether this process may read, write, or enter the directory.
### :param access: The kind of access to test for.
### :returns: `true` when the OS allows it, `false` when it refuses or the path can't be examined.
@expensive("asks the operating system")
routine Directory.is_accessible(me: @Me, access: Access) -> Bool
    return is_accessible(path: me.path.peek(), access)

### The last part of the path: "/a/b/" gives "b".
### :returns: The last part of the path, a view into it.
routine Directory.name(me: @Me) -> Span[Byte]
    return file_name(me.path.peek())

### The directory this one is in, by the text of the path: nothing is looked up, and no memory is allocated.
### :returns: A {Directory} over the leading part of the path.
routine Directory.parent(me: @Me) -> Me
    return Me.construct(path: parent_path(me.path.peek()))

### The file name in this directory, its path in memory from alloc (drop it).
### :param name: The file's name.
### :param alloc: The allocator for the new path.
### :returns: The {File}.
### :throws: Crashes with `MemoryAllocationError` when the allocator fails.
@track_caller
@expensive("allocates the joined path")
routine Directory.file(me: @Me, name: Span[Byte], alloc: @MemoryManager) -> File
    return File.construct(path: join_path(a: me.path.peek(), b: name, alloc))

### The directory name in this directory, its path in memory from alloc (drop it).
### :param name: The directory's name.
### :param alloc: The allocator for the new path.
### :returns: The {Directory}.
### :throws: Crashes with `MemoryAllocationError` when the allocator fails.
@track_caller
@expensive("allocates the joined path")
routine Directory.subdir(me: @Me, name: Span[Byte], alloc: @MemoryManager) -> Me
    return Me.construct(path: join_path(a: me.path.peek(), b: name, alloc))

### The path made absolute by its text: the working directory in front of a relative one, nothing else looked up. The
### new path is in memory from `alloc`. Drop it.
### :param alloc: The allocator for the new path.
### :returns: The absolute {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.absolute_result(me: @Me, alloc: @MemoryManager) -> Result[Me, FsError]
    when absolute_path(path: me.path.peek(), alloc)
        is Memory[Byte] as p => return Me.construct(path: steal p)
        is FsError as error => return error

### The absolute path with every link, `.`, and `..` resolved. The directory must exist, and the new path is in memory
### from `alloc`. Drop it.
### :param alloc: The allocator for the new path.
### :returns: The canonical {Directory}, or the {FsError} the OS reported (NotFound when it is missing).
@expensive("asks the operating system")
routine Directory.canonical_result(me: @Me, alloc: @MemoryManager) -> Result[Me, FsError]
    when canonical_path(path: me.path.peek(), alloc)
        is Memory[Byte] as p => return Me.construct(path: steal p)
        is FsError as error => return error

### The working directory, its path in memory from alloc (drop it).
### :param alloc: The allocator for the new path.
### :returns: The working {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.current_result(alloc: @MemoryManager) -> Result[Me, FsError]
    return directory_of(current_dir(alloc))

### Makes this the working directory.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.set_current_result(me: @Me) -> Result[None, FsError]
    return set_current_dir(me.path.peek())

### The temporary directory (TMPDIR or /tmp, on Windows GetTempPathW's), its path in memory from alloc
### (drop it).
### :param alloc: The allocator for the new path.
### :returns: The temporary {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.temp_result(alloc: @MemoryManager) -> Result[Me, FsError]
    return directory_of(temp_dir(alloc))

### The user's home directory (HOME, on Windows USERPROFILE), its path in memory from alloc. NotFound when it can't
### be told.
### :param alloc: The allocator for the new path.
### :returns: The home {Directory}, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine Directory.home_result(alloc: @MemoryManager) -> Result[Me, FsError]
    return directory_of(home_dir(alloc))

### Wraps the path of a successful result as a {Directory}, passing a failure through unchanged.
### :param r: A path result from one of the well-known-directory routines.
### :returns: The same outcome, with the path as a {Directory}.
private routine directory_of(r: Result[Memory[Byte], FsError]) -> Result[Directory, FsError]
    when steal r
        is Memory[Byte] as p => return Directory.construct(path: steal p)
        is FsError as error => return error

### Starts listing dir's entries.
### :param dir: The directory to list.
### :returns: A value, or the {FsError} the OS reported.
@expensive("asks the operating system")
routine DirIter.open_result(me: @Me, dir: @Directory) -> Result[None, FsError]
    return me.open_path(dir.path.peek())
