# Tessera stdlib: the data race check's hooks
#
# A build with the race check (`--race-check`, `[debug] race-check = true`) has every routine instrumented and links
# ThreadSanitizer's runtime, which stops the program with a report of both places when two threads touch the same
# memory, one of them writing, with neither an atomic access nor a lock between them (the builder sets it to stop at
# the first race, with the exit status a crash has). What it needs from the standard library is here: the fiber switch,
# which tells it which stack runs. Without the race check every hook does nothing.

module Standard/Os

### Binds ThreadSanitizer's `__tsan_get_current_fiber`, the stack running now.
### :returns: Its handle.
@race_check("on")
@external("c")
@symbol("__tsan_get_current_fiber")
@target(os: not "none")
secret routine c_tsan_get_current_fiber() -> Addr

### Binds ThreadSanitizer's `__tsan_create_fiber`, a new stack to tell it about.
### :param flags: 0.
### :returns: Its handle.
@race_check("on")
@external("c")
@symbol("__tsan_create_fiber")
@target(os: not "none")
secret routine c_tsan_create_fiber(flags: U32) -> Addr

### Binds ThreadSanitizer's `__tsan_destroy_fiber`, a stack that is gone.
### :param fiber: Its handle.
@race_check("on")
@external("c")
@symbol("__tsan_destroy_fiber")
@target(os: not "none")
secret routine c_tsan_destroy_fiber(fiber: Addr) -> None

### Binds ThreadSanitizer's `__tsan_switch_to_fiber`, called just before the switch to another stack.
### :param fiber: The handle of the stack that runs next.
### :param flags: 0: the switch orders what came before it on this stack before what runs there.
@race_check("on")
@external("c")
@symbol("__tsan_switch_to_fiber")
@target(os: not "none")
secret routine c_tsan_switch_to_fiber(fiber: Addr, flags: U32) -> None

### The race check's handle of the stack running now, or null without the race check.
### :returns: The handle.
@race_check("on")
@target(os: not "none")
routine race_stack_current() -> Addr
    return c_tsan_get_current_fiber()

### The race check's handle of the stack running now, or null without the race check.
### :returns: The handle.
@race_check("off")
@inline
routine race_stack_current() -> Addr
    return null

### A new stack for the race check, or null without it.
### :returns: The handle.
@race_check("on")
@target(os: not "none")
routine race_stack_new() -> Addr
    return c_tsan_create_fiber(0)

### A new stack for the race check, or null without it.
### :returns: The handle.
@race_check("off")
@inline
routine race_stack_new() -> Addr
    return null

### Tells the race check a stack is gone. Nothing without it.
### :param stack: Its handle.
@race_check("on")
@target(os: not "none")
routine race_stack_free(stack: Addr) -> None
    c_tsan_destroy_fiber(stack)
    return

### Tells the race check a stack is gone. Nothing without it.
### :param stack: Its handle.
@race_check("off")
@inline
routine race_stack_free(stack: Addr) -> None
    return

### Tells the race check the stack `stack` runs next: called just before a switch to it. Nothing without it. It is
### inlined: a routine of its own would enter on one stack and return on the other, as the check counts calls.
### :param stack: Its handle.
@race_check("on")
@target(os: not "none")
@inline
routine race_stack_switch(stack: Addr) -> None
    c_tsan_switch_to_fiber(stack, 0)
    return

### Tells the race check the stack `stack` runs next: called just before a switch to it. Nothing without it.
### :param stack: Its handle.
@race_check("off")
@inline
routine race_stack_switch(stack: Addr) -> None
    return
