# Tessera stdlib: construction and the hosted routines on the default heap
#
# The hosted layer gives the collections and Memory a construct without an
# memory manager, drawing from HEAP (Standard/System/Memory/Heap.te). Like Out and Err, they
# exist only where Standard/Os is imported: a file that doesn't import it, and
# every program for a target without an operating system, passes a memory manager.

module Standard/Os

import Standard/Collections

### `count` uninitialized values of `T` on the default heap, dropped when done. A count of 0 allocates
### nothing.
### :param count: The number of values.
### :returns: The slice, owning its memory.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates heap memory")
common routine Memory[T].construct(count: U64) -> Me
needs T: typename
    return Me.construct(count, manager: HEAP)

### An empty List on the default heap. Nothing is allocated until the first insertion.
### :returns: The empty collection.
common routine List[T].construct() -> Me
needs T: typename
    return Me.construct(HEAP)

### An empty CircularList on the default heap.
### :returns: The empty collection.
common routine CircularList[T].construct() -> Me
needs T: typename
    return Me.construct(HEAP)

### An empty PriorityQueue on the default heap.
### :returns: The empty collection.
common routine PriorityQueue[TPriority, TElement].construct() -> Me
needs TPriority: typename, TElement: typename
    return Me.construct(HEAP)

### An empty Dict on the default heap.
### :returns: The empty collection.
common routine Dict[TKey, TValue].construct() -> Me
needs TKey: typename, TValue: typename
    return Me.construct(HEAP)

### An empty Set on the default heap.
### :returns: The empty collection.
common routine Set[T].construct() -> Me
needs T: typename
    return Me.construct(HEAP)

### An empty SortedDict on the default heap.
### :returns: The empty collection.
common routine SortedDict[TKey, TValue].construct() -> Me
needs TKey: typename, TValue: typename
    return Me.construct(HEAP)

### An empty SortedSet on the default heap.
### :returns: The empty collection.
common routine SortedSet[T].construct() -> Me
needs T: typename
    return Me.construct(HEAP)

### An empty SortedList on the default heap.
### :returns: The empty collection.
common routine SortedList[T].construct() -> Me
needs T: typename
    return Me.construct(HEAP)

### An empty BitList on the default heap.
### :returns: The empty collection.
common routine BitList.construct() -> Me
    return Me.construct(HEAP)

# -- the hosted routines on the default heap ---------------------------------------------
#
# Every routine of this layer that hands back memory takes a memory manager, and has an overload here without one that
# draws from HEAP. The memory manager version stays for memory that should come from somewhere else (an arena,
# a fixed buffer).

### The next word (spaces, tabs, and line ends separate words) on the default heap. The space after the word stays in
### the input. Drop it.
### :returns: The word.
### :throws: Throws `EndOfInputError` at the end of the input.
@expensive("allocates what it reads")
failable common routine Console.ask_word() -> Memory[Byte]
    when check Me.ask_word(HEAP)
        is Memory[Byte] as returned => return returned

### The next line, without its "\n" (or "\r\n"), on the default heap. A last line with no "\n" still counts, and a
### blank line is "". Drop it.
### :returns: The line.
### :throws: Throws `EndOfInputError` at the end of the input.
@expensive("allocates what it reads")
failable common routine Console.ask_line() -> Memory[Byte]
    when check Me.ask_line(HEAP)
        is Memory[Byte] as returned => return returned

### The rest of the input on the default heap. Drop it.
### :returns: The rest of the input.
@expensive("allocates what it reads")
common routine Console.ask_all() -> Memory[Byte]
    return Me.ask_all(HEAP)

### Up to count bytes on the default heap, fewer only at the end of the input. Drop them.
### :param count: The most bytes to read.
### :returns: The bytes read.
@expensive("allocates what it reads")
common routine Console.ask_bytes(count: U64) -> Memory[Byte]
    return Me.ask_bytes(count, manager: HEAP)

### The whole file on the default heap. Drop it.
### :param at: The file to read.
### :returns: The file's bytes, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.read_all(at: @File) -> Memory[Byte]
    when check Me.read_all(at, manager: HEAP)
        is Memory[Byte] as returned => return returned

### The file's path made absolute by its text, nothing else looked up, on the default heap. Drop it.
### :param at: The file whose path is used.
### :returns: The absolute {File}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.absolute(at: @File) -> File
    when check Me.absolute(at, manager: HEAP)
        is File as returned => return returned

### The directory's path made absolute by its text, nothing else looked up, on the default heap. Drop it.
### :param at: The directory whose path is used.
### :returns: The absolute {Directory}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.absolute(at: @Directory) -> Directory
    when check Me.absolute(at, manager: HEAP)
        is Directory as returned => return returned

### The file's absolute path with every link, ".", and ".." resolved, on the default heap. The file must exist. Drop
### it.
### :param at: The file whose path is used.
### :returns: The canonical {File}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.canonical(at: @File) -> File
    when check Me.canonical(at, manager: HEAP)
        is File as returned => return returned

### The directory's absolute path with every link, ".", and ".." resolved, on the default heap. The directory must
### exist. Drop it.
### :param at: The directory whose path is used.
### :returns: The canonical {Directory}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.canonical(at: @Directory) -> Directory
    when check Me.canonical(at, manager: HEAP)
        is Directory as returned => return returned

### Deletes the directory and everything in it, building child paths on the default heap. A link inside is deleted,
### not followed.
### :param at: The directory to delete.
@expensive("asks the operating system")
failable common routine OsFileManager.delete_all(at: @Directory) -> None
    when check Me.delete_all(at, manager: HEAP)
        is None => return

### The file name in this directory, its path on the default heap (drop it).
### :param name: The file's name.
### :returns: The {File}.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates the joined path")
routine @Directory.file(name: @[Byte]) -> File
    return me.file(name, manager: HEAP)

### The directory name in this directory, its path on the default heap (drop it).
### :param name: The directory's name.
### :returns: The {Directory}.
### :throws: Crashes with `MemoryAllocationError` when the heap is exhausted.
@track_caller
@expensive("allocates the joined path")
routine @Directory.go_to(name: @[Byte]) -> Me
    return me.go_to(name, manager: HEAP)

### Puts the file into the directory, keeping its name, building the new path on the default heap.
### :param at: The file to move.
### :param into: The directory it goes into.
### :param replacing: Whether a file of the same name in `into` is replaced.
@expensive("asks the operating system")
failable common routine OsFileManager.move(at: @File, into: @Directory, replacing: Bool) -> None
    when check Me.move(at, into, replacing, manager: HEAP)
        is None => return

### Puts the directory into another directory, keeping its name, building the new paths on the default heap.
### :param at: The directory to move.
### :param into: The directory it goes into.
### :param replacing: Whether an empty directory of the same name in `into` is replaced.
@expensive("asks the operating system")
failable common routine OsFileManager.move(at: @Directory, into: @Directory,
    replacing: Bool) -> None
    when check Me.move(at, into, replacing, manager: HEAP)
        is None => return

### The partition the file is on, its names on the default heap (drop it).
### :param at: An existing file.
### :returns: The {PartitionManager}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.partition(at: @File) -> PartitionManager
    when check Me.partition(at, manager: HEAP)
        is PartitionManager as returned => return returned

### The partition the directory is on, its names on the default heap (drop it).
### :param at: An existing directory.
### :returns: The {PartitionManager}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsFileManager.partition(at: @Directory) -> PartitionManager
    when check Me.partition(at, manager: HEAP)
        is PartitionManager as returned => return returned

### The storage devices the OS reports, their names on the default heap (drop the list).
### :returns: The devices.
@expensive("asks the operating system")
common routine StorageManager.list() -> List[Me]
    return Me.list(HEAP)

### The partitions the OS reports, their names on the default heap (drop the list).
### :returns: The partitions.
@expensive("asks the operating system")
common routine PartitionManager.list() -> List[Me]
    return Me.list(HEAP)

### The working directory, its path on the default heap (drop it).
### :returns: The working {Directory}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsEnvironment.working_directory() -> Directory
    when check Me.working_directory(HEAP)
        is Directory as returned => return returned

### The temporary directory (TMPDIR or /tmp, on Windows GetTempPathW's), its path on the default heap
### (drop it).
### :returns: The temporary {Directory}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsEnvironment.temp_directory() -> Directory
    when check Me.temp_directory(HEAP)
        is Directory as returned => return returned

### The user's home directory (HOME, on Windows USERPROFILE), its path on the default heap. NotFound when it can't be
### told.
### :returns: The home {Directory}, or throws the {FsError} the OS reported.
@expensive("asks the operating system")
failable common routine OsEnvironment.home_directory() -> Directory
    when check Me.home_directory(HEAP)
        is Directory as returned => return returned

### The value of the environment variable name on the default heap, or None when it isn't set. Drop it.
### :param name: The variable's name.
### :returns: The value's bytes.
### :absent: When the variable isn't set, its name is too long or holds a NUL, or the value can't be read or allocated.
@expensive("allocates a copy of the variable")
common routine OsEnvironment.variable(name: @[Byte]) -> Maybe[Memory[Byte]]
    return Me.variable(name, manager: HEAP)

### Every environment variable as the program sees it now, a snapshot on the default heap (drop the list).
### :returns: The variables, in the OS's order.
@track_caller
@expensive("allocates a copy of every variable")
common routine OsEnvironment.variables() -> List[EnvironmentEntry]
    return Me.variables(HEAP)
