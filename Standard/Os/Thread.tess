// Tessera stdlib: threads
//
// Thread.spawn starts entry(arg) on a new OS thread, and join waits for it to
// return, and detach lets it run on with nobody waiting. arg is the state the
// thread works on (the state record is the capture list), an @S for the entry's
// own S, and must outlive it. The thread starts from a small record allocated
// from alloc, which the new thread frees.

module Standard::Os

import Standard::Alloc

/// An OS thread from Thread.spawn, until join.
record Thread
    handle : Addr  // pthread_t, or a Windows HANDLE

/// What a new thread starts with.
private record ThreadStart
    entry : Callable<(Addr,), Void>
    arg   : Addr
    alloc : @Allocator

/// Every new thread's first Tessera routine, whatever the OS's entry signature: frees the start record, then calls
/// the entry with its state.
/// :param raw: The {ThreadStart} record.
private routine thread_body(raw: Addr) -> Void
    block entry()
        start : @ThreadStart            = raw.to<@ThreadStart>()
        entry : Callable<(Addr,), Void> = start.entry.load()
        arg   : Addr                    = start.arg.load()
        deallocate(start, start.alloc.load())
        entry.call(arg)
        return()

/// Allocates the record a new thread starts from. The record keeps the entry without its state type: a routine
/// taking an @T takes an Addr the same way (both are one pointer), so thread_body calls it with the state as an Addr.
/// :param entry: The routine the thread runs.
/// :param arg: The state it works on.
/// :param alloc: The allocator the record comes from, which the new thread frees it to.
/// :returns: The filled record.
/// :throws: Crashes with `MemoryAllocationError` when `alloc` can't give the record.
#track_caller
private routine thread_start<T>(entry: Callable<(@T,), Void>, arg: @T,
    alloc: @Allocator) -> @ThreadStart
require T: typename
    block entry()
        erased : Callable<(Addr,), Void> = bitcast(entry)
        state  : Addr                    = arg
        start  : @ThreadStart            = allocate<ThreadStart>(1, alloc)
        branch start.is_null()
            ? crash_allocation()
            : continue
        start.store(ThreadStart { entry: erased, arg: state, alloc: alloc })
        return(start)

// -- POSIX ----------------------------------------------------------------------------

/// Binds the C `pthread_create` function, which starts a thread.
/// :param thread: Where the new thread's id goes.
/// :param attr: The thread attributes, or null for the defaults.
/// :param start: The routine the thread runs.
/// :param arg: What `start` is called with.
/// :returns: 0 on success, or an error number.
#[external("c"), symbol("pthread_create"), target(os: ("linux", "macos"))]
private routine c_pthread_create(thread: @Addr, attr: Addr, start: Callable<(Addr,), Addr>,
    arg: Addr) -> CInt

/// Binds the C `pthread_join` function, which waits for a thread to return.
/// :param thread: The thread's id.
/// :param result: Where the thread's return value goes, or null.
/// :returns: 0 on success, or an error number.
#[external("c"), symbol("pthread_join"), target(os: ("linux", "macos"))]
private routine c_pthread_join(thread: Addr, result: Addr) -> CInt

/// Binds the C `sysconf` function, which reads a system setting.
/// :param name: The setting's `_SC_*` number.
/// :returns: The setting's value, or -1 when it can't be told.
#[external("c"), symbol("sysconf"), target(os: ("linux", "macos"))]
private routine c_sysconf(name: CInt) -> CLong

/// The pthread entry point: runs the thread's body and returns null.
/// :param arg: The {ThreadStart} record.
/// :returns: Always null.
#target(os: ("linux", "macos"))
private routine posix_thread_main(arg: Addr) -> Addr
    block entry()
        thread_body(arg)
        return(null)

/// Starts entry(arg) on a new thread.
/// :param entry: The routine the thread runs.
/// :param arg: The state it works on, which must outlive the thread.
/// :param alloc: The allocator the thread's start record comes from.
/// :returns: The new thread, to {Thread.join} or {Thread.detach}.
/// :throws: Crashes with `MemoryAllocationError` when `alloc` can't give the thread's start record, and with
///     `TaskSpawnError` when the operating system starts no thread.
#[target(os: ("linux", "macos")), track_caller]
#expensive("starts an operating system thread")
routine Thread.spawn<T>(entry: Callable<(@T,), Void>, arg: @T, alloc: @Allocator) -> Me
require T: typename
    block entry()
        start : @ThreadStart = thread_start(entry, arg, alloc)
        claim handle : @Addr <- null
        result : CInt = c_pthread_create(handle, null, posix_thread_main.to<Callable>(), start)
        failed : Bool = result.ne(0)
        branch failed
            ? crash_task_spawn()
            : continue
        thread : Me = Me { handle: handle.load() }
        return(thread)

/// Waits for the thread to return.
#target(os: ("linux", "macos"))
routine Thread.join(me: Me) -> Void
    block entry()
        c_pthread_join(me.handle, null)
        return()

/// Binds the C `pthread_detach` function, which lets a thread's resources go when it returns, with nobody joining.
/// :param thread: The thread's id.
/// :returns: 0 on success, or an error number.
#[external("c"), symbol("pthread_detach"), target(os: ("linux", "macos"))]
private routine c_pthread_detach(thread: Addr) -> CInt

/// Lets the thread run on with nobody waiting for it: the OS reclaims it when it returns. A thread is joined or
/// detached, once.
#target(os: ("linux", "macos"))
routine Thread.detach(me: Me) -> Void
    block entry()
        c_pthread_detach(me.handle)
        return()

/// _SC_NPROCESSORS_ONLN, whose number differs between Linux and macOS.
/// :returns: The sysconf number.
#target(os: "macos")
private routine sc_nprocessors_onln() -> CInt
    block entry()
        return(58)

/// _SC_NPROCESSORS_ONLN, whose number differs between Linux and macOS.
/// :returns: The sysconf number.
#target(os: "linux")
private routine sc_nprocessors_onln() -> CInt
    block entry()
        return(84)

/// The number of processors the system has online, at least 1.
/// :returns: The processor count, 1 when it can't be told.
#target(os: ("linux", "macos"))
routine cpu_count() -> USize
    block entry()
        n    : CLong = c_sysconf(sc_nprocessors_onln())
        none : Bool  = n.lt(1)
        branch none
            ? return(1)
            : return(n.to<USize>())

// -- Windows --------------------------------------------------------------------------

/// Binds the Win32 `CreateThread` function, which starts a thread.
/// :param attrs: The thread handle's security attributes, or null.
/// :param stack: The stack size in bytes, 0 for the default.
/// :param start: The routine the thread runs.
/// :param arg: What `start` is called with.
/// :param flags: The creation flags, 0 to run at once.
/// :param id: Where the thread id goes, or null.
/// :returns: The thread's handle, or null with the last error set.
#[external("c"), symbol("CreateThread"), callconv("stdcall"), target(os: "windows")]
private routine c_create_thread(attrs: Addr, stack: USize,
    start: Callable<#callconv("stdcall"), (Addr,), U32>, arg: Addr, flags: U32, id: Addr) -> Addr

/// Binds the Win32 `WaitForSingleObject` function, which waits until an object is signaled.
/// :param handle: The object, such as a thread.
/// :param millis: The longest wait in milliseconds, `INFINITE` (U32 MAX) for no limit.
/// :returns: `WAIT_OBJECT_0`, `WAIT_TIMEOUT`, or `WAIT_FAILED` with the last error set.
#[external("c"), symbol("WaitForSingleObject"), callconv("stdcall"), target(os: "windows")]
private routine c_wait_for_single_object(handle: Addr, millis: U32) -> U32

/// Binds the Win32 `CloseHandle` function, which closes a handle.
/// :param handle: The handle.
/// :returns: Nonzero on success, 0 with the last error set.
#[external("c"), symbol("CloseHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_close_handle(handle: Addr) -> CInt

/// Binds the Win32 `GetActiveProcessorCount` function, which counts the active processors.
/// :param group: The processor group, or `ALL_PROCESSOR_GROUPS` (0xFFFF) for all of them.
/// :returns: The number of active processors, 0 on failure.
#[external("c"), symbol("GetActiveProcessorCount"), callconv("stdcall"), target(os: "windows")]
private routine c_get_active_processor_count(group: U16) -> U32

/// The Windows thread entry point: runs the thread's body and returns 0.
/// :param arg: The {ThreadStart} record.
/// :returns: Always 0.
#[target(os: "windows"), callconv("stdcall")]
private routine windows_thread_main(arg: Addr) -> U32
    block entry()
        thread_body(arg)
        return(0)

/// Starts entry(arg) on a new thread.
/// :param entry: The routine the thread runs.
/// :param arg: The state it works on, which must outlive the thread.
/// :param alloc: The allocator the thread's start record comes from.
/// :returns: The new thread, to {Thread.join} or {Thread.detach}.
/// :throws: Crashes with `MemoryAllocationError` when `alloc` can't give the thread's start record, and with
///     `TaskSpawnError` when the operating system starts no thread.
#[target(os: "windows"), track_caller]
#expensive("starts an operating system thread")
routine Thread.spawn<T>(entry: Callable<(@T,), Void>, arg: @T, alloc: @Allocator) -> Me
require T: typename
    block entry()
        start  : @ThreadStart = thread_start(entry, arg, alloc)
        handle : Addr         = c_create_thread(null, 0, windows_thread_main.to<Callable>(), start,
            0, null)
        failed : Bool         = handle.is_null()
        branch failed
            ? crash_task_spawn()
            : continue
        thread : Me = Me { handle: handle }
        return(thread)

/// Waits for the thread to return.
#target(os: "windows")
routine Thread.join(me: Me) -> Void
    block entry()
        // INFINITE
        c_wait_for_single_object(me.handle, U32.MAX)
        c_close_handle(me.handle)
        return()

/// Lets the thread run on with nobody waiting for it: the OS reclaims it when it returns. A thread is joined or
/// detached, once.
#target(os: "windows")
routine Thread.detach(me: Me) -> Void
    block entry()
        c_close_handle(me.handle)
        return()

/// The number of processors the system has online, at least 1.
/// :returns: The processor count, 1 when it can't be told.
#target(os: "windows")
routine cpu_count() -> USize
    block entry()
        // ALL_PROCESSOR_GROUPS
        n    : U32  = c_get_active_processor_count(0xFFFF)
        none : Bool = n.lt(1)
        branch none
            ? return(1)
            : return(n.to<USize>())
