// Tessera stdlib: files and the filesystem on Windows (see Fs.tess)
//
// The wide-character (W) calls: a path's UTF-8 becomes UTF-16 on the way in, and text from the OS (a directory
// entry, the working directory) becomes UTF-8 on the way out, an unpaired surrogate as U+FFFD. So any path the
// filesystem holds works, whatever the code page.

module Standard::Os

import Standard::Alloc

preset GENERIC_READ:                 U32 = 0x80000000
preset GENERIC_WRITE:                U32 = 0x40000000
preset FILE_APPEND_ONLY:             U32 = 0x120114  // FILE_GENERIC_WRITE without FILE_WRITE_DATA
preset FILE_WRITE_ATTRIBUTES:        U32 = 0x100
preset FILE_SHARE_ALL:               U32 = 7  // read, write, and delete
preset CREATE_NEW:                   U32 = 1
preset CREATE_ALWAYS:                U32 = 2
preset OPEN_EXISTING:                U32 = 3
preset OPEN_ALWAYS:                  U32 = 4
preset FILE_ATTRIBUTE_READONLY:      U32 = 0x1
preset FILE_ATTRIBUTE_DIRECTORY:     U32 = 0x10
preset FILE_ATTRIBUTE_NORMAL:        U32 = 0x80
preset FILE_ATTRIBUTE_REPARSE_POINT: U32 = 0x400
preset INVALID_FILE_ATTRIBUTES:      U32 = 0xFFFFFFFF
preset FILE_FLAG_BACKUP_SEMANTICS:   U32 = 0x02000000
preset FILE_FLAG_OPEN_REPARSE_POINT: U32 = 0x00200000
preset FILE_FLAG_SEQUENTIAL_SCAN:    U32 = 0x08000000
preset IO_REPARSE_TAG_SYMLINK:       U32 = 0xA000000C
preset IO_REPARSE_TAG_MOUNT_POINT:   U32 = 0xA0000003

/// WIN32_FIND_DATAW: the attributes, the creation and last-write times, the size, the reparse tag, then the name.
preset FIND_DATA_WORDS:  USize = 148

preset FIND_CREATED:     USize = 4
preset FIND_WRITTEN:     USize = 20
preset FIND_SIZE_HIGH:   USize = 28
preset FIND_SIZE_LOW:    USize = 32
preset FIND_REPARSE_TAG: USize = 36
preset FIND_NAME:        USize = 44

/// FILETIME: 100-nanosecond ticks since 1601-01-01 UTC.
#target(os: "windows")
private record FileTime
    low  : U32
    high : U32

/// WIN32_FILE_ATTRIBUTE_DATA
#target(os: "windows")
private record AttributeData
    attributes : U32
    created    : FileTime
    accessed   : FileTime
    written    : FileTime
    size_high  : U32
    size_low   : U32

/// BY_HANDLE_FILE_INFORMATION
#target(os: "windows")
private record HandleInfo
    attributes    : U32
    created       : FileTime
    accessed      : FileTime
    written       : FileTime
    volume_serial : U32
    size_high     : U32
    size_low      : U32
    links         : U32
    index_high    : U32
    index_low     : U32

#target(os: "windows")
private record MemoryRange
    address : Addr
    size    : USize

/// Binds the Win32 `GetLastError` function.
#[external("c"), symbol("GetLastError"), callconv("stdcall"), target(os: "windows")]
private routine c_get_last_error() -> U32

/// Binds the Win32 `CreateFileW` function.
#[external("c"), symbol("CreateFileW"), callconv("stdcall"), target(os: "windows")]
private routine c_create_file(name: @U16, access: U32, share: U32, security: Addr, disposition: U32,
    flags: U32, template: Addr) -> Addr

/// Binds the Win32 `CloseHandle` function.
#[external("c"), symbol("CloseHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_close_handle(handle: Addr) -> CInt

/// Binds the Win32 `ReadFile` function.
#[external("c"), symbol("ReadFile"), callconv("stdcall"), target(os: "windows")]
