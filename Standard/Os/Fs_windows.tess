/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("UnmapViewOfFile")
@callconv("stdcall")
@target(os: "windows")
private routine c_unmap_view_of_file(view: Addr) -> CInt

/// Binds the Win32 `FlushViewOfFile` function: writes a view's changed pages back to its file.
/// :param view: The view's address.
/// :param size: The bytes to write back, 0 for the whole view.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("FlushViewOfFile")
@callconv("stdcall")
@target(os: "windows")
private routine c_flush_view_of_file(view: Addr, size: USize) -> CInt

/// Binds the Win32 `GetCurrentProcess` function: a handle to the calling process.
/// :returns: The pseudo-handle, which needs no closing.
@external("c")
@symbol("GetCurrentProcess")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_current_process() -> Addr

/// Binds the Win32 `PrefetchVirtualMemory` function: asks the OS to read memory ranges in.
/// :param process: The process whose memory it is.
/// :param count: How many ranges.
/// :param ranges: The ranges.
/// :param flags: 0.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("PrefetchVirtualMemory")
@callconv("stdcall")
@target(os: "windows")
private routine c_prefetch_virtual_memory(process: Addr, count: USize, ranges: @MemoryRange,
    flags: U32) -> CInt

// -- errors and paths ----------------------------------------------------------------

/// The FsError for a Win32 error code.
/// :param e: The error code.
/// :returns: The matching FsError, `Other` for a code with no match.
@target(os: "windows")
private routine error_of(e: U32) -> FsError
    when e
        2, 3 => return FsError.NOT_FOUND
        5 => return FsError.PERMISSION_DENIED
        80, 183 => return FsError.ALREADY_EXISTS
        267 => return FsError.NOT_A_DIRECTORY
        145 => return FsError.DIRECTORY_NOT_EMPTY
        17 => return FsError.CROSS_DEVICE
        206 => return FsError.NAME_TOO_LONG
        123, 161 => return FsError.INVALID_PATH
        39, 112 => return FsError.NO_SPACE
        19 => return FsError.READ_ONLY
        32, 33 => return FsError.BUSY
        8, 14 => return FsError.OUT_OF_MEMORY
        else => return FsError.OTHER

/// The FsError for the calling thread's last Win32 error.
/// :returns: The matching FsError.
@target(os: "windows")
private routine last_error() -> FsError
    return error_of(c_get_last_error())

/// A failure carrying the FsError for the calling thread's last Win32 error.
/// :typeparam T: The success type of the result.
/// :returns: The error that FsError.
@target(os: "windows")
private routine failed[T]() -> Result[T, FsError]
needs T: typename
    return last_error()

/// A nonzero BOOL is success, 0 the last error.
/// :param ok: The BOOL a call returned.
/// :returns: `Unit` for nonzero, else the FsError for the last error.
@target(os: "windows")
private routine checked(ok: CInt) -> Result[None, FsError]
    if ok != 0
        return fs_done()
    else
        return failed[None]()

/// Whether h is `INVALID_HANDLE_VALUE` (all ones).
/// :param h: The handle to test.
/// :returns: True for `INVALID_HANDLE_VALUE`.
@target(os: "windows")
private routine is_invalid_handle(h: Addr) -> Bool
    // INVALID_HANDLE_VALUE, (HANDLE)-1
    return ptrtoint[Addr, USize](h) == USize.MAX

/// text as UTF-16 with a 0 after it in out, which has room for capacity units: its length in units, or None if
/// text has a NUL or doesn't fit. (A UTF-8 byte count bounds the unit count, so length + 1 units always fit.)
/// :param text: The UTF-8 text.
/// :param out: The buffer.
/// :param capacity: Its room in UTF-16 units.
/// :returns: The length in units, the 0 left out.
/// :absent: When `text` has a NUL or doesn't fit with its 0.
@target(os: "windows")
internal routine encode_utf16(text: Span[Byte], out: @U16, capacity: USize) -> Maybe[USize]
    local iter: @BytesCharsIter <- text.chars()

    while true with n: USize = 0
        c: Maybe[Char] = iter.emit_checked()
        when c
            is Char as char =>
                cp: U32 = char.to[U32]()
                if cp == 0
                    return None()
                if cp < 0x10000
                    if n + 1 >= capacity
                        return None()
                    out.stride(n).poke(cp.to[U16]())
                    continue with n: n + 1
                else
                    if n + 2 >= capacity
                        return None()
                    v: U32 = cp - 0x10000
                    high_surrogate: U32 = (v >> 10) + 0xD800
                    out.stride(n).poke(high_surrogate.to[U16]())
                    low_surrogate: U32 = (v & 0x3FF) + 0xDC00
                    out.stride(n + 1).poke(low_surrogate.to[U16]())
                    continue with n: n + 2
            is None =>
                out.stride(n).poke(0)
                return n

/// path as UTF-16 with a 0 after it in out (PATH_CAPACITY units): its length in units, or None if path has a NUL or
/// doesn't fit.
/// :param path: The UTF-8 path.
/// :param out: The buffer, `PATH_CAPACITY` units.
/// :returns: The length in units, the 0 left out.
/// :absent: When `path` has a NUL or doesn't fit.
@target(os: "windows")
private routine wide(path: Span[Byte], out: @U16) -> Maybe[USize]
    return encode_utf16(text: path, out, capacity: PATH_CAPACITY)

/// path as UTF-16 in out: whether it fit.
/// :param path: The UTF-8 path.
/// :param out: The buffer, `PATH_CAPACITY` units.
/// :returns: True when it was converted. False when `path` has a NUL or doesn't fit.
@target(os: "windows")
private routine wide_path(path: Span[Byte], out: @U16) -> Bool
    n: Maybe[USize] = wide(path, out)
    return n.is_present()

/// count UTF-16 units at units as UTF-8 at out (room for 3 bytes a unit): the bytes written. An unpaired surrogate
/// becomes U+FFFD.
/// :param units: The first unit.
/// :param count: How many units.
/// :param out: Where the UTF-8 goes.
/// :returns: The bytes written.
@target(os: "windows")
internal routine narrow(units: @U16, count: USize, out: @Byte) -> USize
    local n: @USize <- 0

    i: USize = 0

    while i < count
        unit: U16 = units.stride(i).peek()
        u: U32 = unit.to[U32]()
        values2: (USize, U32) = when
            u.between(lo: 0xD800, hi: 0xDBFF) =>
                if not (i + 1 < count)
                    becomes (i + 1, 0xFFFD)
                else
                    low_unit: U16 = units.stride(i + 1).peek()
                    low: U32 = low_unit.to[U32]()
                    if low.between(lo: 0xDC00, hi: 0xDFFF)
                        high_half: U32 = u - 0xD800 << 10
                        cp_offset: U32 = high_half + (low - 0xDC00)
                        becomes (i + 2, cp_offset + 0x10000)
                    else
                        becomes (i + 1, 0xFFFD)
            else =>
                if u.between(lo: 0xDC00, hi: 0xDFFF)
                    becomes (i + 1, 0xFFFD)
                else
                    becomes (i + 1, u)
        i2, cp = values2
        (n.peek() + utf8_encode_into(char: cp.to[Char](), out: out.stride(n.peek()))).poke_into(n)
    then
        return n.peek()

/// The units before the first 0 at units.
/// :param units: A 0-terminated UTF-16 string.
/// :returns: The count of units before the 0.
@target(os: "windows")
internal routine wide_length(units: @U16) -> USize
    while units.stride(i).peek() != 0 with i: USize = 0
        continue with i: i + 1
    then
        return i

/// count UTF-16 units as UTF-8, in memory from alloc.
/// :param units: The first unit.
/// :param count: How many units.
/// :param alloc: The allocator for the text.
/// :returns: The UTF-8 text.
/// :throws: Returns `OutOfMemory` when `alloc` fails.
@target(os: "windows")
internal routine owned_wide(units: @U16, count: USize,
    alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    made: Result[Memory[Byte], AllocFailed] = Memory[Byte].construct_result(count: (count * 3).max(1), manager: alloc)
    buffer: Memory[Byte] = when made
        is Memory[Byte] as buffer => buffer
        is AllocFailed => return FsError.OUT_OF_MEMORY
    n: USize = narrow(units, count, out: buffer.data)
    return buffer.with_count(n)

// -- metadata ------------------------------------------------------------------------

/// Nanoseconds since 1970 from a FILETIME, wrapping on overflow.
/// :param t: The FILETIME.
/// :returns: The nanoseconds since 1970-01-01 UTC, negative before then.
@target(os: "windows")
private routine unix_ns(t: FileTime) -> S64
    high_ticks: U64 = t.high.to[U64]() << 32
    ticks: U64 = high_ticks | t.low.to[U64]()
    // 100 ns ticks between 1601-01-01 and 1970-01-01
    since_epoch: S64 = ticks.to_wrap[S64]() -% 116444736000000000
    return since_epoch *% 100

/// A 64-bit size from its high and low 32-bit halves.
/// :param high: The high half.
/// :param low: The low half.
/// :returns: The size.
@target(os: "windows")
private routine size_of(high: U32, low: U32) -> U64
    upper: U64 = high.to[U64]() << 32
    return upper | low.to[U64]()

/// A link (symbolic or a junction) by its attributes and reparse tag, else a directory or a file.
/// :param attributes: The file's attribute bits.
/// :param tag: Its reparse tag, 0 when not known.
/// :returns: `Symlink`, `Directory`, or `File`.
@target(os: "windows")
private routine kind_of(attributes: U32, tag: U32) -> FileKind
    reparse: Bool = attributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
    if reparse and (tag == IO_REPARSE_TAG_SYMLINK or tag == IO_REPARSE_TAG_MOUNT_POINT)
        return FileKind.SYMLINK
    if attributes & FILE_ATTRIBUTE_DIRECTORY != 0
        return FileKind.DIRECTORY
    else
        return FileKind.FILE

/// A Metadata from the attributes, times, and size Windows reports. Read-only is the read-only attribute.
/// :param data: The file's attribute bits, times, and size.
/// :param tag: Its reparse tag, 0 when not known.
/// :returns: The metadata.
@target(os: "windows")
private routine make_metadata(data: AttributeData, tag: U32) -> Metadata
    size: U64 = size_of(high: data.size_high, low: data.size_low)
    return Metadata(kind: kind_of(attributes: data.attributes, tag), size: size, modified_ns: unix_ns(data.written), created_ns: unix_ns(data.created), readonly: data.attributes & FILE_ATTRIBUTE_READONLY != 0)

/// The metadata in a WIN32_FIND_DATAW, which starts with the fields of a WIN32_FILE_ATTRIBUTE_DATA.
/// :param data: The `WIN32_FIND_DATAW`.
/// :returns: The metadata, a link describing itself.
@target(os: "windows")
private routine from_find_data(data: @Byte) -> Metadata
    parts: AttributeData = data.to[@AttributeData]().peek()
    tag_at: @Byte = data.stride(FIND_REPARSE_TAG)
    tag: U32 = tag_at.to[@U32]().peek()
    return make_metadata(data: parts, tag)

/// The Metadata in a `BY_HANDLE_FILE_INFORMATION`. It has no reparse tag, so a link reads as a directory or a file.
/// :returns: The metadata.
@target(os: "windows")
private routine HandleInfo.to[Metadata](me: Me) -> Metadata
    parts: AttributeData = AttributeData(attributes: me.attributes, created: me.created, accessed: me.accessed, written: me.written, size_high: me.size_high, size_low: me.size_low)
    return make_metadata(data: parts, tag: 0)

/// The metadata of the open file h.
/// :param h: The open file.
/// :returns: The metadata.
/// :throws: Returns the FsError for the last error when the call fails.
@target(os: "windows")
private routine handle_metadata(h: Addr) -> Result[Metadata, FsError]
    local info: @HandleInfo <- .hollow()
    if c_get_file_information_by_handle(h, info) != 0
        return info.peek().to[Metadata]()
    else
        return failed[Metadata]()

/// The metadata of wpath from GetFileAttributesExW, for what can't be opened (a file another process holds
/// exclusively).
/// :param wpath: The 0-terminated UTF-16 path.
/// :returns: The metadata.
/// :throws: Returns the FsError for the last error when the call fails.
@target(os: "windows")
private routine attribute_metadata(wpath: @U16) -> Result[Metadata, FsError]
    local data: @AttributeData <- .hollow()
    // GetFileExInfoStandard
    if c_get_file_attributes_ex(wpath, 0, data) == 0
        return failed[Metadata]()
    d: AttributeData = data.peek()
    return make_metadata(data: d, tag: 0)

/// A handle for asking about path (no read or write access): a directory too, and with link_itself, a link rather
/// than what it points at.
/// :param wpath: The 0-terminated UTF-16 path.
/// :param link_itself: True to open a link itself, false to open what it points at.
/// :returns: The handle, or `INVALID_HANDLE_VALUE` with the last error set.
@target(os: "windows")
private routine query_handle(wpath: @U16, link_itself: Bool) -> Addr
    flags: U32 = when
        link_itself => FILE_FLAG_BACKUP_SEMANTICS.bitor(FILE_FLAG_OPEN_REPARSE_POINT)
        else => FILE_FLAG_BACKUP_SEMANTICS
    return c_create_file(wpath, 0, FILE_SHARE_ALL, null, OPEN_EXISTING, flags, null)

/// path's metadata, a link followed to what it points at.
/// :param path: The path to look at.
/// :returns: The metadata.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine metadata(path: Span[Byte]) -> Result[Metadata, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    h: Addr = query_handle(wpath: wpath.to[@U16](), link_itself: false)
    if is_invalid_handle(h)
        // A missing file stays missing. Anything else may be a file that can't be opened, which the attributes still
        // describe.
        wpath2: @U16 = wpath.to[@U16]()
        error: FsError = last_error()
        if error == FsError.NOT_FOUND
            return error
        else
            return attribute_metadata(wpath2)
    else
        m: Result[Metadata, FsError] = handle_metadata(h)
        c_close_handle(h)
        return m

/// path's metadata. A link describes itself (kind Symlink), from its directory entry.
/// :param path: The path to look at.
/// :returns: The metadata.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine symlink_metadata(path: Span[Byte]) -> Result[Metadata, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    local data: @Array[U32, FIND_DATA_WORDS] <- .hollow()
    find: Addr = c_find_first_file(wpath.to[@U16](), data.to[@Byte]())
    // A root ("C:\") has no directory entry: its attributes describe it
    if is_invalid_handle(find)
        return attribute_metadata(wpath.to[@U16]())
    c_find_close(find)
    return from_find_data(data.to[@Byte]())

// -- file handles --------------------------------------------------------------------------

/// An open file, from a File's open_read_result and the like: a Reader and a Writer. claim it, and close it when
/// done.
@target(os: "windows")
record FileHandle
    handle: Addr
    failed: Bool  // a write_bytes failed (write_all_result reports each failure itself)

/// Makes a `FileHandle` from its fields.
/// :param handle: Its `handle`.
/// :param failed: Its `failed`.
/// :returns: The new value.
@target(os: "windows")
routine FileHandle.construct(handle: Addr, failed: Bool) -> Me
    return Me(handle, failed)

/// Releases nothing: a `FileHandle` holds no memory of its own.
@target(os: "windows")
routine FileHandle.destruct(me: @Me) -> None
    return

/// A handle to no file, whose close() does nothing: the start value of a slot that a finish block closes.
/// :returns: The empty handle.
@target(os: "windows")
routine FileHandle.empty() -> Me
    return Me(handle: inttoptr[USize, Addr](USize.MAX), failed: false)

/// Opens path in mode. Other handles may read, write, and delete the file while it is open.
/// :param path: The file to open.
/// :param mode: How to open it.
/// :returns: The open handle.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine FileHandle.open(path: Span[Byte], mode: OpenMode) -> Result[Me, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    values2: (@U16, U32, U32) = when mode
        OpenMode.READ => (wpath.to[@U16](), GENERIC_READ, OPEN_EXISTING)
        OpenMode.WRITE => (wpath.to[@U16](), GENERIC_WRITE, CREATE_ALWAYS)
        OpenMode.APPEND => (wpath.to[@U16](), FILE_APPEND_ONLY, OPEN_ALWAYS)
        OpenMode.READ_WRITE => (wpath.to[@U16](), GENERIC_READ.bitor(GENERIC_WRITE), OPEN_EXISTING)
        OpenMode.CREATE_NEW => (wpath.to[@U16](), GENERIC_WRITE, CREATE_NEW)
    wpath2, access, disposition = values2
    h: Addr = c_create_file(wpath2, access, FILE_SHARE_ALL, null, disposition, FILE_ATTRIBUTE_NORMAL, null)
    if is_invalid_handle(h)
        return failed[Me]()
    else
        return Me(handle: h, failed: false)

/// Reads up to count bytes into buffer: how many, 0 at the end of the file. One call reads at most 1 GiB, and a
/// broken pipe reads as the end.
/// :param buffer: Where the bytes go.
/// :param count: The most bytes to read.
/// :returns: The count read, 0 at the end of the file.
/// :throws: Returns the reason when the read fails.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.read_bytes_result(me: @Me, buffer: @Byte, count: USize) -> Result[USize, FsError]
    local got: @U32 <- 0
    ok: CInt = c_read_file(me.handle.peek(), buffer, count.min(1073741824).to[U32](), got, null)
    if ok != 0
        return got.peek().to[USize]()
    // ERROR_BROKEN_PIPE: the writing end closed, which is the end
    e: U32 = c_get_last_error()
    if e == 109
        return 0
    else
        return error_of(e)

/// Writes up to count bytes: how many it did. One call writes at most 1 GiB.
/// :param data: The first byte to write.
/// :param count: The most bytes to write.
/// :returns: The count written.
/// :throws: Returns the reason when the write fails.
@target(os: "windows")
internal routine FileHandle.write_some(me: @Me, data: @Byte, count: USize) -> Result[USize, FsError]
    local wrote: @U32 <- 0
    ok: CInt = c_write_file(me.handle.peek(), data, count.min(1073741824).to[U32](), wrote, null)
    if ok != 0
        return wrote.peek().to[USize]()
    else
        return failed[USize]()

/// Moves the position: the new one, from the start.
/// :param offset: The distance to move, negative to go back.
/// :param from: Where `offset` counts from.
/// :returns: The new position from the start.
/// :throws: Returns the reason, such as a position before the start.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.seek_result(me: @Me, offset: S64, from: SeekFrom) -> Result[U64, FsError]
    local at: @S64 <- 0

    // FILE_BEGIN, FILE_CURRENT, FILE_END
    ok: CInt = when from
        SeekFrom.START => c_set_file_pointer_ex(me.handle.peek(), offset, at, 0)
        SeekFrom.CURRENT => c_set_file_pointer_ex(me.handle.peek(), offset, at, 1)
        SeekFrom.END => c_set_file_pointer_ex(me.handle.peek(), offset, at, 2)
    if ok != 0
        return at.peek().to[U64]()
    else
        return failed[U64]()

/// The metadata of the open file.
/// :returns: The metadata.
/// :throws: Returns the reason when the OS can't report it.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.metadata_result(me: @Me) -> Result[Metadata, FsError]
    return handle_metadata(me.handle.peek())

/// The size of the open file in bytes.
/// :returns: The size.
/// :throws: Returns the reason when the OS can't report it.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.size_result(me: @Me) -> Result[U64, FsError]
    local size: @S64 <- 0
    if c_get_file_size_ex(me.handle.peek(), size) != 0
        return size.peek().to[U64]()
    else
        return failed[U64]()

/// Truncates or extends (with zeros) the file to size bytes. The position stays.
/// :param size: The new size in bytes.
/// :returns: `Unit` once the size is set.
/// :throws: Returns the reason when the OS refuses. Crashes with `IntegerOverflowError` when `size`
///     doesn't fit in S64.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.set_size_result(me: @Me, size: U64) -> Result[None, FsError]
    local end: @S64 <- size.to[S64]()
    // FileEndOfFileInfo
    return checked(c_set_file_information_by_handle(me.handle.peek(), 6, end, 8))

/// Waits until what was written is on the storage device.
/// :returns: `Unit` once it is.
/// :throws: Returns the reason when the OS reports an error.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.sync_result(me: @Me) -> Result[None, FsError]
    return checked(c_flush_file_buffers(me.handle.peek()))

/// Closes the file and leaves the handle empty, so a second close does nothing.
@target(os: "windows")
@expensive("asks the operating system")
routine FileHandle.close(me: @Me) -> None
    h: Addr = me.handle.peek()
    if is_invalid_handle(h)
        return
    c_close_handle(h)
    me.handle.poke(inttoptr[USize, Addr](USize.MAX))
    return

// -- directories and names -------------------------------------------------------------

/// Makes the directory path (its parent must exist).
/// :param path: The directory to make.
/// :returns: `Unit` once it is made.
/// :throws: Returns the reason, `AlreadyExists` when something is at `path`, `InvalidPath` or
///     `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine create_dir(path: Span[Byte]) -> Result[None, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if wide_path(path, out: wpath.to[@U16]())
        return checked(c_create_directory(wpath.to[@U16](), null))
    else
        return path_error(path)

/// Removes a file (or a link, a directory link included), not a directory.
/// :param path: The file to remove.
/// :returns: `Unit` once it is gone.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine remove_file(path: Span[Byte]) -> Result[None, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    if c_delete_file(wpath.to[@U16]()) != 0
        return fs_done()
    // A link to a directory is a directory to DeleteFileW
    error: U32 = c_get_last_error()
    attributes: U32 = c_get_file_attributes(wpath.to[@U16]())
    link_bits: U32 = FILE_ATTRIBUTE_DIRECTORY.bitor(FILE_ATTRIBUTE_REPARSE_POINT)
    known: Bool = attributes != INVALID_FILE_ATTRIBUTES
    if known and attributes & link_bits == link_bits
        return checked(c_remove_directory(wpath.to[@U16]()))
    else
        return error_of(error)

/// Removes an empty directory.
/// :param path: The directory to remove.
/// :returns: `Unit` once it is gone.
/// :throws: Returns the reason, `DirectoryNotEmpty` when something is in it, `InvalidPath` or
///     `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine remove_dir(path: Span[Byte]) -> Result[None, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if wide_path(path, out: wpath.to[@U16]())
        return checked(c_remove_directory(wpath.to[@U16]()))
    else
        return path_error(path)

/// Renames from to to with MoveFileExW and flags.
/// :param from: The current path.
/// :param to: The new path.
/// :param flags: The `MOVEFILE_*` flags.
/// :returns: `Unit` once it is renamed.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when a path doesn't fit a C path.
@target(os: "windows")
private routine move_file(from: Span[Byte], to: Span[Byte], flags: U32) -> Result[None, FsError]
    local a: @Array[U16, PATH_CAPACITY] <- .hollow()
    local b: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path: from, out: a.to[@U16]())
        return path_error(from)
    if wide_path(path: to, out: b.to[@U16]())
        return checked(c_move_file_ex(a.to[@U16](), b.to[@U16](), flags))
    else
        return path_error(to)

/// Renames from to to, replacing what is at to. Between volumes it fails with CrossDevice.
/// :param from: The current path.
/// :param to: The new path.
/// :returns: `Unit` once it is renamed.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when a path doesn't fit a C path.
@target(os: "windows")
internal routine rename(from: Span[Byte], to: Span[Byte]) -> Result[None, FsError]
    // MOVEFILE_REPLACE_EXISTING
    return move_file(from, to, flags: 1)

/// Renames from to to, failing with AlreadyExists if something is at to.
/// :param from: The current path.
/// :param to: The new path.
/// :returns: `Unit` once it is renamed.
/// :throws: Returns the reason, `AlreadyExists` when something is at `to`, `InvalidPath` or
///     `NameTooLong` when a path doesn't fit a C path.
@target(os: "windows")
internal routine rename_no_replace(from: Span[Byte], to: Span[Byte]) -> Result[None, FsError]
    return move_file(from, to, flags: 0)

/// CopyFileExW's progress routine: records the bytes transferred so far in the U64 at `data`, and lets the copy go
/// on.
/// :param total_size: The file's size.
/// :param transferred: The bytes copied so far.
/// :param stream_size: The current stream's size.
/// :param stream_transferred: The current stream's bytes copied so far.
/// :param stream: The current stream's number.
/// :param reason: Why it is called (a chunk finished, or a stream started).
/// :param source: The source file's handle.
/// :param destination: The destination file's handle.
/// :param data: The U64 that counts the bytes copied.
/// :returns: `PROGRESS_CONTINUE` (0).
@target(os: "windows")
@callconv("stdcall")
private routine copy_progress(total_size: S64, transferred: S64, stream_size: S64,
    stream_transferred: S64, stream: U32, reason: U32, source: Addr, destination: Addr,
    data: Addr) -> U32
    data.to[@U64]().poke(transferred.to_wrap[U64]())
    return 0

/// Copies from into to (made, or replaced): the bytes copied, as CopyFileExW reports them while it copies.
/// :param from: The file to copy.
/// :param to: The file to write.
/// :returns: The number of bytes copied.
/// :throws: Returns the reason when the copy fails, `InvalidPath` or `NameTooLong` when a path doesn't
///     fit a C path.
@target(os: "windows")
internal routine copy_file(from: Span[Byte], to: Span[Byte]) -> Result[U64, FsError]
    local a: @Array[U16, PATH_CAPACITY] <- .hollow()
    local b: @Array[U16, PATH_CAPACITY] <- .hollow()
    local copied: @U64 <- 0
    if not wide_path(path: from, out: a.to[@U16]())
        return path_error(from)
    if not wide_path(path: to, out: b.to[@U16]())
        return path_error(to)
    if c_copy_file_ex(a.to[@U16](), b.to[@U16](), copy_progress.to[Callable](), copied, null, 0) != 0
        return copied.peek()
    else
        return failed[U64]()

/// Sets or clears the read-only attribute.
/// :param path: The file to change.
/// :param readonly: True to set the attribute, false to clear it.
/// :returns: `Unit` once the attribute is set.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine set_readonly(path: Span[Byte], readonly: Bool) -> Result[None, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    attributes: U32 = c_get_file_attributes(wpath.to[@U16]())
    if attributes == INVALID_FILE_ATTRIBUTES
        return failed[None]()
    if readonly
        return checked(c_set_file_attributes(wpath.to[@U16](), attributes | FILE_ATTRIBUTE_READONLY))
    else
        return checked(c_set_file_attributes(wpath.to[@U16](), attributes & FILE_ATTRIBUTE_READONLY.bitnot()))

/// Whether e (an extension) is exe, com, cmd, or bat, in any case.
/// :param e: The extension, without its dot.
/// :returns: True for those four.
@target(os: "windows")
private routine is_program_extension(e: Span[Byte]) -> Bool
    if not (e.count() == 3)
        return false
    // ASCII lowercase: setting bit 5 of a letter
    a: U8 = e.byte_at(0) | 0x20
    b: U8 = e.byte_at(1) | 0x20
    c: U8 = e.byte_at(2) | 0x20
    starts_ex: Bool = a == 101 and b == 120
    exe: Bool = starts_ex and c == 101
    starts_co: Bool = a == 99 and b == 111
    com: Bool = starts_co and c == 109
    starts_cm: Bool = a == 99 and b == 109
    cmd: Bool = starts_cm and c == 100
    starts_ba: Bool = a == 98 and b == 97
    bat: Bool = starts_ba and c == 116
    binary: Bool = exe or com
    script: Bool = cmd or bat
    return binary or script

/// Whether path can be read (it exists), written (it exists and isn't read-only), or run (a file named .exe, .com,
/// .cmd, or .bat). Windows checks permissions only when a file is opened.
/// :param path: The path to check.
/// :param access: What to check for.
/// :returns: True when allowed. False when not, when nothing is there, or when `path` doesn't fit a C path.
@target(os: "windows")
internal routine is_accessible(path: Span[Byte], access: Access) -> Bool
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return false
    attributes: U32 = c_get_file_attributes(wpath.to[@U16]())
    if attributes == INVALID_FILE_ATTRIBUTES
        return false
    when access
        Access.READ => return true
        Access.WRITE => return attributes & FILE_ATTRIBUTE_READONLY == 0
        Access.EXECUTE =>
            if attributes & FILE_ATTRIBUTE_DIRECTORY != 0
                return false
            else
                return is_program_extension(file_extension(path))

/// Makes the file if it's missing, and sets its access and modification times to now.
/// :param path: The file to touch.
/// :returns: `Unit` once the times are set.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine touch(path: Span[Byte]) -> Result[None, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    h: Addr = c_create_file(wpath.to[@U16](), FILE_WRITE_ATTRIBUTES, FILE_SHARE_ALL, null, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL.bitor(FILE_FLAG_BACKUP_SEMANTICS), null)
    if is_invalid_handle(h)
        return failed[None]()
    local now: @FileTime <- FileTime(low: 0, high: 0)
    c_get_system_time_as_file_time(now)
    set: Result[None, FsError] = checked(c_set_file_time(h, null, now, now))
    c_close_handle(h)
    return set

// -- directory listings ------------------------------------------------------------------

/// The entries of a directory, "." and ".." left out, in the order the OS gives them. claim one, open it on a
/// Directory, call next until None, and close it.
@target(os: "windows")
record DirIter
    find: Addr
    data: Array[U32, FIND_DATA_WORDS]  // WIN32_FIND_DATAW of the entry next returns or returned
    pending: Bool  // data holds an entry next hasn't returned yet
    name: Array[Byte, 1024]  // the UTF-8 name next returned

/// Makes a `DirIter` from its fields.
/// :param find: Its `find`.
/// :param data: Its `data`.
/// :param pending: Its `pending`.
/// :param name: Its `name`.
/// :returns: The new value.
@target(os: "windows")
routine DirIter.construct(find: Addr, data: Array[U32, FIND_DATA_WORDS], pending: Bool,
    name: Array[Byte, 1024]) -> Me
    return Me(find, data, pending, name)

/// Releases nothing: a `DirIter` holds no memory of its own.
@target(os: "windows")
routine DirIter.destruct(me: @Me) -> None
    return

/// Opens the listing of the directory at path, a search for `path\*`. The handle is invalid until the search starts,
/// so close() is safe after a failure.
/// :param path: The directory to list.
/// :returns: `Unit` once the listing is open.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine DirIter.open_path(me: @Me, path: Span[Byte]) -> Result[None, FsError]
    local pattern_buffer: @Array[U16, PATH_CAPACITY] <- .hollow()
    local pattern: @U16 = pattern_buffer.to[@U16]()

    me.find.poke(inttoptr[USize, Addr](USize.MAX))
    me.pending.poke(false)
    n: Maybe[USize] = wide(path, out: pattern)
    when n
        is USize as count =>
            // path, a separator unless it ends with one, and "*"
            if count + 2 >= PATH_CAPACITY
                return FsError.NAME_TOO_LONG
            at: USize = when
                count == 0 => 0
                else =>
                    last: U16 = pattern.stride(count - 1).peek()
                    if last == 0x2F or last == 0x5C
                        becomes count
                    else
                        pattern.stride(count).poke(0x5C)
                        becomes count + 1
            pattern.stride(at).poke(0x2A)
            pattern.stride(at + 1).poke(0)
            find: Addr = c_find_first_file(pattern, me.data.to[@Byte]())
            if is_invalid_handle(find)
                return failed[None]()
            me.find.poke(find)
            me.pending.poke(true)
            return fs_done()
        is None => return path_error(path)

/// Whether the UTF-16 name is "." or "..".
/// :param name: The 0-terminated UTF-16 name.
/// :returns: True for "." and "..".
@target(os: "windows")
private routine is_dot_wide(name: @U16) -> Bool
    if not (name.peek() == 0x2E)
        return false
    second: U16 = name.stride(1).peek()
    if second == 0
        return true
    if second == 0x2E
        third: U16 = name.stride(2).peek()
        return third == 0
    else
        return false

/// The next entry, or None at the end (a failure partway reads as the end).
/// :returns: The next entry, its name valid until the next call.
/// :absent: At the end of the listing, or when reading it fails.
@target(os: "windows")
routine DirIter.emit_checked(me: @Me) -> Maybe[DirEntry]
    if is_invalid_handle(me.find.peek())
        return None()
    if me.pending.peek() or c_find_next_file(me.find.peek(), me.data.to[@Byte]()) != 0
        me.pending.poke(false)
        data: @Byte = me.data.to[@Byte]()
        name: @U16 = data.stride(FIND_NAME).to[@U16]()
        if is_dot_wide(name)
            return me.emit_checked()
        n: USize = narrow(units: name, count: wide_length(name), out: me.name.to[@Byte]())
        info: Metadata = from_find_data(data)
        return DirEntry(name: Span[Byte].construct(data: me.name.to[@Byte](), count: n), kind: info.kind)
    else
        return None()

/// The metadata of the entry next last returned, from the listing itself (a link describes itself).
/// :returns: The metadata, which never fails here.
@target(os: "windows")
@expensive("asks the operating system")
routine DirIter.entry_metadata_result(me: @Me) -> Result[Metadata, FsError]
    return from_find_data(me.data.to[@Byte]())

/// Ends the listing and leaves the handle invalid, so a second close does nothing.
@target(os: "windows")
routine DirIter.close(me: @Me) -> None
    find: Addr = me.find.peek()
    if is_invalid_handle(find)
        return
    c_find_close(find)
    me.find.poke(inttoptr[USize, Addr](USize.MAX))
    return

// -- the working directory and well-known directories -------------------------------------

/// The working directory, in memory from alloc.
/// :param alloc: The allocator for the text.
/// :returns: The path.
/// :throws: Returns the reason when the OS can't report it, `OutOfMemory` when `alloc` fails.
@target(os: "windows")
internal routine current_dir(alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    local units: @Memory[U16] <- .hollow()

    need: U32 = c_get_current_directory(0, null)
    result: Result[Memory[Byte], FsError] = when
        need == 0 => failed[Memory[Byte]]()
        else =>
            made: Result[Memory[U16], AllocFailed] = Memory[U16].construct_result(count: need.to[USize](), manager: alloc)
            when made
                is Memory[U16] as slice =>
                    slice.poke_into(units)
                    need2: U32 = slice.count().to[U32]()
                    got: U32 = c_get_current_directory(need2, slice.data)
                    if got == 0 or got >= need2
                        becomes failed[Memory[Byte]]()
                    else
                        becomes owned_wide(units: slice.data, count: got.to[USize](), alloc)
                is AllocFailed =>
                    becomes FsError.OUT_OF_MEMORY
    units.drop()
    return result

/// Makes path the working directory.
/// :param path: The new working directory.
/// :returns: `Unit` once it is changed.
/// :throws: Returns the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine set_current_dir(path: Span[Byte]) -> Result[None, FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if wide_path(path, out: wpath.to[@U16]())
        return checked(c_set_current_directory(wpath.to[@U16]()))
    else
        return path_error(path)

/// The temporary directory without its trailing separator (C:\Windows\Temp when it can't be told), in memory from
/// alloc.
/// :param alloc: The allocator for the text.
/// :returns: The path.
/// :throws: Returns `OutOfMemory` when `alloc` fails.
@target(os: "windows")
internal routine temp_dir(alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    local units: @Array[U16, PATH_CAPACITY] <- .hollow()
    got: U32 = c_get_temp_path(PATH_CAPACITY.to[U32](), units.to[@U16]())
    if got == 0 or got.to[USize]() >= PATH_CAPACITY
        made: Result[Memory[Byte], AllocFailed] = Memory[Byte].construct_result(count: 15, manager: alloc)
        buffer: Memory[Byte] = when made
            is Memory[Byte] as buffer => buffer
            is AllocFailed => return FsError.OUT_OF_MEMORY
        buffer.data.copy(src: "C:\\Windows\\Temp", count: 15)
        return buffer
    else
        path_units: @U16 = units.to[@U16]()
        last: U16 = path_units.stride((got - 1).to[USize]()).peek()
        if last == 0x5C or last == 0x2F
            return owned_wide(units: units.to[@U16](), count: (got - 1).to[USize](), alloc)
        else
            return owned_wide(units: units.to[@U16](), count: got.to[USize](), alloc)

/// The environment variable name, as UTF-8 in memory from alloc, when it is set and not empty.
/// :param name: The variable's 0-terminated UTF-16 name.
/// :param alloc: The allocator for the text.
/// :returns: The value.
/// :absent: When the variable is not set, is empty, takes `PATH_CAPACITY` units or more, or `alloc` fails.
@target(os: "windows")
private routine env_dir(name: CWStr, alloc: @MemoryManager) -> Maybe[Memory[Byte]]
    local units: @Array[U16, PATH_CAPACITY] <- .hollow()
    got: U32 = c_get_environment_variable(name, units.to[@U16](), PATH_CAPACITY.to[U32]())
    if got == 0 or got.to[USize]() >= PATH_CAPACITY
        return None()
    text: Result[Memory[Byte], FsError] = owned_wide(units: units.to[@U16](), count: got.to[USize](), alloc)
    when text
        is Memory[Byte] as t => return t
        is FsError => return None()

/// USERPROFILE, or HOMEDRIVE and HOMEPATH, in memory from alloc. NotFound when neither is set.
/// :param alloc: The allocator for the text.
/// :returns: The path.
/// :throws: Returns `NotFound` when neither is set, or when `alloc` fails for a variable's value. Crashes
///     with `MemoryAllocationError` when `alloc` fails joining HOMEDRIVE and HOMEPATH.
@target(os: "windows")
internal routine home_dir(alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    local drive: @Memory[Byte] <- .hollow()
    local path: @Memory[Byte] <- .hollow()

    profile: Maybe[Memory[Byte]] = env_dir(name: "USERPROFILE", alloc)
    result: Result[Memory[Byte], FsError] = when profile
        is Memory[Byte] as dir => dir
        is None =>
            d: Maybe[Memory[Byte]] = env_dir(name: "HOMEDRIVE", alloc)
            when d
                is Memory[Byte] as text =>
                    text.poke_into(drive)
                    p: Maybe[Memory[Byte]] = env_dir(name: "HOMEPATH", alloc)
                    when p
                        is Memory[Byte] as text2 =>
                            text2.poke_into(path)
                            becomes Span[Byte].concat(a: drive, b: path, alloc)
                        is None =>
                            becomes FsError.NOT_FOUND
                is None =>
                    becomes FsError.NOT_FOUND
    drive.drop()
    path.drop()
    return result

/// path made absolute by the text: the working directory in front of a relative path, and "." and ".." taken out
/// (GetFullPathNameW), nothing looked up.
/// :param path: The path to make absolute.
/// :param alloc: The allocator for the result.
/// :returns: The absolute path.
/// :throws: Returns the reason, `NameTooLong` when the result doesn't fit, `OutOfMemory` when
///     `alloc` fails, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine absolute_path(path: Span[Byte],
    alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    local full: @Array[U16, PATH_CAPACITY] <- .hollow()
    got: U32 = c_get_full_path_name(wpath.to[@U16](), PATH_CAPACITY.to[U32](), full.to[@U16](), null)
    if got == 0
        return failed[Memory[Byte]]()
    if got.to[USize]() >= PATH_CAPACITY
        return FsError.NAME_TOO_LONG
    else
        return owned_wide(units: full.to[@U16](), count: got.to[USize](), alloc)

/// The absolute path with every link, ".", and ".." resolved, and path must exist. The "\\?\" prefix the OS gives is
/// taken off ("\\?\UNC\server\share" becomes "\\server\share").
/// :param path: The path to resolve.
/// :param alloc: The allocator for the result.
/// :returns: The resolved path.
/// :throws: Returns the reason, such as `NotFound`, `OutOfMemory` when `alloc` fails, `InvalidPath`
///     or `NameTooLong` when `path` doesn't fit a C path.
@target(os: "windows")
internal routine canonical_path(path: Span[Byte],
    alloc: @MemoryManager) -> Result[Memory[Byte], FsError]
    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        return path_error(path)
    h: Addr = query_handle(wpath: wpath.to[@U16](), link_itself: false)
    if is_invalid_handle(h)
        return failed[Memory[Byte]]()
    local full: @Array[U16, PATH_CAPACITY] <- .hollow()
    // FILE_NAME_NORMALIZED | VOLUME_NAME_DOS
    got: U32 = c_get_final_path_name_by_handle(h, full.to[@U16](), PATH_CAPACITY.to[U32](), 0)
    e: U32 = c_get_last_error()
    c_close_handle(h)
    if got == 0
        return error_of(e)
    if got.to[USize]() >= PATH_CAPACITY
        return FsError.NAME_TOO_LONG
    text: Result[Memory[Byte], FsError] = owned_wide(units: full.to[@U16](), count: got.to[USize](), alloc)
    when text
        is Memory[Byte] as t =>
            values2: (USize, USize) = when
                t.has_prefix("\\\\?\\UNC\\") => (8, 2)
                else =>
                    if t.has_prefix("\\\\?\\")
                        becomes (4, 0)
                    else
                        return t
            from, keep = values2
            // "\\?\UNC\server" to "\\server": keep the first two backslashes, drop "?\UNC\"
            // Moves the text from from down to keep, so the buffer's start (what free wants) stays where it is.

            rest: USize = t.count() - from

            each i in 0 til rest
                t.data.stride(keep + i).poke(t.data.stride(from + i).peek())
            then
                return t.with_count(keep + rest)
        is FsError as error => return error

// -- memory-mapped files -----------------------------------------------------------------

/// Maps count bytes of path from offset (USize.MAX: to the end), clamped to the file. Past the end, or an empty
/// file, gives an empty mapping. write maps it so stores reach the file. Otherwise it's read-only (opened for a
/// front-to-back read).
/// :param path: The file to map.
/// :param write: True for a writable mapping whose stores reach the file.
/// :param offset: Where in the file the mapping starts.
/// :param count: The most bytes to map.
/// :returns: The mapping.
/// :throws: Returns the reason when the file can't be opened, measured, or mapped.
@target(os: "windows")
internal routine Mapping.map(path: Span[Byte], write: Bool, offset: U64,
    count: USize) -> Result[Me, FsError]
    local file: @FileHandle <- .empty()

    local wpath: @Array[U16, PATH_CAPACITY] <- .hollow()
    if not wide_path(path, out: wpath.to[@U16]())
        // PAGE_READWRITE or PAGE_READONLY
        // FILE_MAP_WRITE or FILE_MAP_READ
        // the view keeps the mapping and the file open on its own

        result: Result[Me, FsError] = path_error(path)
        file.close()
        return result
    else
        h: Addr = when
            write => c_create_file(wpath.to[@U16](), GENERIC_READ.bitor(GENERIC_WRITE), FILE_SHARE_ALL, null, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, null)
            else => c_create_file(wpath.to[@U16](), GENERIC_READ, FILE_SHARE_ALL, null, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, null)
        if is_invalid_handle(h)
            result: Result[Me, FsError] = failed[Me]()
            file.close()
            return result
        else
            file.handle.poke(h)
            local size: @S64 <- 0
            if c_get_file_size_ex(h, size) != 0
                size2: U64 = size.peek().to[U64]()
                if offset >= size2
                    result: Result[Me, FsError] = Me.empty()
                    file.close()
                    return result
                else
                    want_bytes: U64 = count.to[U64]().min(size2 - offset)
                    want: USize = want_bytes.to[USize]()
                    grain: U64 = map_granularity().to[U64]()
                    aligned: U64 = offset - offset % grain
                    delta: USize = (offset - aligned).to[USize]()
                    protect: U32 = when
                        write => 4
                        else => 2
                    mapping: Addr = c_create_file_mapping(h, null, protect, 0, 0, null)
                    if mapping.is_null()
                        result: Result[Me, FsError] = failed[Me]()
                        file.close()
                        return result
                    else
                        access: U32 = when
                            write => 2
                            else => 4
                        view: Addr = c_map_view_of_file(mapping, access, (aligned >> 32).to_wrap[U32](), aligned.to_wrap[U32](), want + delta)
                        e: U32 = c_get_last_error()
                        c_close_handle(mapping)
                        if view.is_null()
                            result: Result[Me, FsError] = error_of(e)
                            file.close()
                            return result
                        else
                            result: Result[Me, FsError] = Me(base: view, delta: delta, count: want)
                            file.close()
                            return result
            else
                result: Result[Me, FsError] = failed[Me]()
                file.close()
                return result

/// Writes changed pages back to the file.
/// :returns: `Unit` once they are written, at once for an empty mapping.
/// :throws: Returns the reason when FlushViewOfFile fails.
@target(os: "windows")
routine Mapping.flush_result(me: Me) -> Result[None, FsError]
    if me.base.is_null()
        return fs_done()
    else
        return checked(c_flush_view_of_file(me.base, 0))

/// Writes changed pages back and unmaps.
@target(os: "windows")
routine Mapping.unmap(me: Me) -> None
    if me.base.is_null()
        return
    c_flush_view_of_file(me.base, 0)
    c_unmap_view_of_file(me.base)
    return

/// Asks the OS to read the whole mapping in now.
@target(os: "windows")
routine Mapping.prefetch(me: Me) -> None
    if me.base.is_null()
        return
    local range: @MemoryRange <- MemoryRange(address: me.base, size: me.delta + me.count)
    c_prefetch_virtual_memory(c_get_current_process(), 1, range, 0)
    return

/// Tells the OS the mapping will be read front to back: a read-only mapping's file was already opened that way.
@target(os: "windows")
routine Mapping.advise_sequential(me: Me) -> None
    return
