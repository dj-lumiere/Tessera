///     error set.
@external("c")
@symbol("GetFinalPathNameByHandleW")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_final_path_name_by_handle(file: Addr, buffer: @U16, size: U32,
    flags: U32) -> U32

