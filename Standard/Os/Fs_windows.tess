// Tessera stdlib: files and the filesystem on Windows (see Fs.tess)
//
// The wide-character (W) calls: a path's UTF-8 becomes UTF-16 on the way in, and text from the OS (a directory
// entry, the working directory) becomes UTF-8 on the way out, an unpaired surrogate as U+FFFD. So any path the
// filesystem holds works, whatever the code page.

module Standard::Os

import Standard::Alloc

preset GENERIC_READ:                 U32 = 0x80000000
preset GENERIC_WRITE:                U32 = 0x40000000
preset FILE_APPEND_ONLY:             U32 = 0x120114  // FILE_GENERIC_WRITE without FILE_WRITE_DATA
preset FILE_WRITE_ATTRIBUTES:        U32 = 0x100
preset FILE_SHARE_ALL:               U32 = 7  // read, write, and delete
preset CREATE_NEW:                   U32 = 1
preset CREATE_ALWAYS:                U32 = 2
preset OPEN_EXISTING:                U32 = 3
preset OPEN_ALWAYS:                  U32 = 4
preset FILE_ATTRIBUTE_READONLY:      U32 = 0x1
preset FILE_ATTRIBUTE_DIRECTORY:     U32 = 0x10
preset FILE_ATTRIBUTE_NORMAL:        U32 = 0x80
preset FILE_ATTRIBUTE_REPARSE_POINT: U32 = 0x400
preset INVALID_FILE_ATTRIBUTES:      U32 = 0xFFFFFFFF
preset FILE_FLAG_BACKUP_SEMANTICS:   U32 = 0x02000000
preset FILE_FLAG_OPEN_REPARSE_POINT: U32 = 0x00200000
preset FILE_FLAG_SEQUENTIAL_SCAN:    U32 = 0x08000000
preset IO_REPARSE_TAG_SYMLINK:       U32 = 0xA000000C
preset IO_REPARSE_TAG_MOUNT_POINT:   U32 = 0xA0000003

/// WIN32_FIND_DATAW: the fields of a WIN32_FILE_ATTRIBUTE_DATA (attributes, times, size), the reparse tag, then the
/// name.
preset FIND_DATA_WORDS:  USize = 148

preset FIND_REPARSE_TAG: USize = 36
preset FIND_NAME:        USize = 44

/// FILETIME: 100-nanosecond ticks since 1601-01-01 UTC.
#target(os: "windows")
private record FileTime
    low  : U32
    high : U32

/// WIN32_FILE_ATTRIBUTE_DATA
#target(os: "windows")
private record AttributeData
    attributes : U32
    created    : FileTime
    accessed   : FileTime
    written    : FileTime
    size_high  : U32
    size_low   : U32

/// BY_HANDLE_FILE_INFORMATION
#target(os: "windows")
private record HandleInfo
    attributes    : U32
    created       : FileTime
    accessed      : FileTime
    written       : FileTime
    volume_serial : U32
    size_high     : U32
    size_low      : U32
    links         : U32
    index_high    : U32
    index_low     : U32

#target(os: "windows")
private record MemoryRange
    address : Addr
    size    : USize

/// Binds the Win32 `GetLastError` function: the calling thread's last error code.
/// :returns: The error code.
#[external("c"), symbol("GetLastError"), callconv("stdcall"), target(os: "windows")]
private routine c_get_last_error() -> U32

/// Binds the Win32 `CreateFileW` function: opens or creates a file, a directory with backup semantics, or a device.
/// :param name: The 0-terminated UTF-16 path.
/// :param access: The access rights, such as `GENERIC_READ`.
/// :param share: The `FILE_SHARE_*` modes other handles may open it with.
/// :param security: The security attributes, or null.
/// :param disposition: What to do when the file is there or missing, such as `OPEN_EXISTING`.
/// :param flags: The `FILE_ATTRIBUTE_*` and `FILE_FLAG_*` values.
/// :param template: A template file handle, or null.
/// :returns: The handle, or `INVALID_HANDLE_VALUE` (all ones) with the last error set.
#[external("c"), symbol("CreateFileW"), callconv("stdcall"), target(os: "windows")]
private routine c_create_file(name: @U16, access: U32, share: U32, security: Addr, disposition: U32,
    flags: U32, template: Addr) -> Addr

/// Binds the Win32 `CloseHandle` function: closes a handle.
/// :param handle: The handle to close.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("CloseHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_close_handle(handle: Addr) -> CInt

/// Binds the Win32 `ReadFile` function: reads from a file.
/// :param file: The open file.
/// :param buffer: Where the bytes go.
/// :param count: The most bytes to read.
/// :param read: Where the count read goes.
/// :param overlapped: An `OVERLAPPED` for asynchronous reads, or null.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("ReadFile"), callconv("stdcall"), target(os: "windows")]
private routine c_read_file(file: Addr, buffer: @Byte, count: U32, read: @U32,
    overlapped: Addr) -> CInt

/// Binds the Win32 `WriteFile` function: writes to a file.
/// :param file: The open file.
/// :param data: The first byte to write.
/// :param count: The most bytes to write.
/// :param written: Where the count written goes.
/// :param overlapped: An `OVERLAPPED` for asynchronous writes, or null.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("WriteFile"), callconv("stdcall"), target(os: "windows")]
private routine c_write_file(file: Addr, data: @Byte, count: U32, written: @U32,
    overlapped: Addr) -> CInt

/// Binds the Win32 `SetFilePointerEx` function: moves a file's position.
/// :param file: The open file.
/// :param distance: The distance to move.
/// :param position: Where the new position, from the start, goes, or null.
/// :param method: Where `distance` counts from: 0 the start, 1 the current position, 2 the end.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("SetFilePointerEx"), callconv("stdcall"), target(os: "windows")]
private routine c_set_file_pointer_ex(file: Addr, distance: S64, position: @S64,
    method: U32) -> CInt

/// Binds the Win32 `GetFileSizeEx` function: reads a file's size.
/// :param file: The open file.
/// :param size: Where the size in bytes goes.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("GetFileSizeEx"), callconv("stdcall"), target(os: "windows")]
private routine c_get_file_size_ex(file: Addr, size: @S64) -> CInt

/// Binds the Win32 `SetFileInformationByHandle` function: sets one class of information about a file.
/// :param file: The open file.
/// :param class: The `FILE_INFO_BY_HANDLE_CLASS` value, such as `FileEndOfFileInfo`.
/// :param info: The information.
/// :param size: Its size in bytes.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("SetFileInformationByHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_set_file_information_by_handle(file: Addr, class: CInt, info: Addr,
    size: U32) -> CInt

/// Binds the Win32 `GetFileInformationByHandle` function: reads a file's attributes, times, size, and identity.
/// :param file: The open file.
/// :param info: Where the information goes.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("GetFileInformationByHandle"), callconv("stdcall"), target(os: "windows")]
private routine c_get_file_information_by_handle(file: Addr, info: @HandleInfo) -> CInt

/// Binds the Win32 `FlushFileBuffers` function: waits until a file's written data is on the storage device.
/// :param file: The open file.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("FlushFileBuffers"), callconv("stdcall"), target(os: "windows")]
private routine c_flush_file_buffers(file: Addr) -> CInt

/// Binds the Win32 `GetFileAttributesW` function: reads a file's attribute bits.
/// :param path: The 0-terminated UTF-16 path.
/// :returns: The attributes, or `INVALID_FILE_ATTRIBUTES` with the last error set.
#[external("c"), symbol("GetFileAttributesW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_file_attributes(path: @U16) -> U32

/// Binds the Win32 `GetFileAttributesExW` function: reads a file's attributes, times, and size without opening it.
/// :param path: The 0-terminated UTF-16 path.
/// :param level: The information level, 0 for `GetFileExInfoStandard`.
/// :param data: Where the information goes.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("GetFileAttributesExW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_file_attributes_ex(path: @U16, level: CInt, data: @AttributeData) -> CInt

/// Binds the Win32 `SetFileAttributesW` function: sets a file's attribute bits.
/// :param path: The 0-terminated UTF-16 path.
/// :param attributes: The new attributes.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("SetFileAttributesW"), callconv("stdcall"), target(os: "windows")]
private routine c_set_file_attributes(path: @U16, attributes: U32) -> CInt

/// Binds the Win32 `CreateDirectoryW` function: makes a directory.
/// :param path: The 0-terminated UTF-16 path of the new directory.
/// :param security: The security attributes, or null.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("CreateDirectoryW"), callconv("stdcall"), target(os: "windows")]
private routine c_create_directory(path: @U16, security: Addr) -> CInt

/// Binds the Win32 `RemoveDirectoryW` function: removes an empty directory, or a link to a directory.
/// :param path: The 0-terminated UTF-16 path.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("RemoveDirectoryW"), callconv("stdcall"), target(os: "windows")]
private routine c_remove_directory(path: @U16) -> CInt

/// Binds the Win32 `DeleteFileW` function: removes a file or a link to a file, not a directory.
/// :param path: The 0-terminated UTF-16 path.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("DeleteFileW"), callconv("stdcall"), target(os: "windows")]
private routine c_delete_file(path: @U16) -> CInt

/// Binds the Win32 `CopyFileExW` function: copies a file's data and attributes, calling `progress` as it goes.
/// :param from: The 0-terminated UTF-16 path of the file to copy.
/// :param to: The 0-terminated UTF-16 path of the copy.
/// :param progress: The progress routine, or null.
/// :param data: What `progress` gets as its last argument.
/// :param cancel: A flag that cancels the copy when set, or null.
/// :param flags: The `COPY_FILE_*` flags, 0 to replace what is at `to`.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("CopyFileExW"), callconv("stdcall"), target(os: "windows")]
private routine c_copy_file_ex(from: @U16, to: @U16,
    progress: Callable<#callconv("stdcall"), (S64, S64, S64, S64, U32, U32, Addr, Addr, Addr), U32>,
    data: Addr, cancel: Addr, flags: U32) -> CInt

/// Binds the Win32 `MoveFileExW` function: renames a file or directory.
/// :param from: The current 0-terminated UTF-16 path.
/// :param to: The new 0-terminated UTF-16 path.
/// :param flags: The `MOVEFILE_*` flags, such as `MOVEFILE_REPLACE_EXISTING`.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("MoveFileExW"), callconv("stdcall"), target(os: "windows")]
private routine c_move_file_ex(from: @U16, to: @U16, flags: U32) -> CInt

/// Binds the Win32 `FindFirstFileW` function: starts a directory search and reads its first match.
/// :param pattern: The 0-terminated UTF-16 pattern, such as `dir\*`.
/// :param data: Where the first match's `WIN32_FIND_DATAW` goes.
/// :returns: A search handle, or `INVALID_HANDLE_VALUE` with the last error set.
#[external("c"), symbol("FindFirstFileW"), callconv("stdcall"), target(os: "windows")]
private routine c_find_first_file(pattern: @U16, data: @Byte) -> Addr

/// Binds the Win32 `FindNextFileW` function: reads the next match of a search.
/// :param find: The search handle.
/// :param data: Where the match's `WIN32_FIND_DATAW` goes.
/// :returns: Nonzero, or 0 at the end or on an error, with the last error set.
#[external("c"), symbol("FindNextFileW"), callconv("stdcall"), target(os: "windows")]
private routine c_find_next_file(find: Addr, data: @Byte) -> CInt

/// Binds the Win32 `FindClose` function: ends a search.
/// :param find: The search handle.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("FindClose"), callconv("stdcall"), target(os: "windows")]
private routine c_find_close(find: Addr) -> CInt

/// Binds the Win32 `GetCurrentDirectoryW` function: copies the working directory, 0-terminated, into a buffer.
/// :param size: The buffer's size in UTF-16 units.
/// :param buffer: The buffer, or null to ask for the size.
/// :returns: The units written without the 0, the units needed with the 0 when the buffer is too small, or 0 with
///     the last error set.
#[external("c"), symbol("GetCurrentDirectoryW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_current_directory(size: U32, buffer: @U16) -> U32

/// Binds the Win32 `SetCurrentDirectoryW` function: changes the working directory.
/// :param path: The 0-terminated UTF-16 path of the new working directory.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("SetCurrentDirectoryW"), callconv("stdcall"), target(os: "windows")]
private routine c_set_current_directory(path: @U16) -> CInt

/// Binds the Win32 `GetTempPathW` function: copies the temporary directory, with a trailing backslash and a 0,
/// into a buffer.
/// :param size: The buffer's size in UTF-16 units.
/// :param buffer: The buffer.
/// :returns: The units written without the 0, the units needed when the buffer is too small, or 0 with the last
///     error set.
#[external("c"), symbol("GetTempPathW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_temp_path(size: U32, buffer: @U16) -> U32

/// Binds the Win32 `GetFullPathNameW` function: makes a path absolute by the text, against the working directory.
/// :param path: The 0-terminated UTF-16 path.
/// :param size: The buffer's size in UTF-16 units.
/// :param buffer: Where the 0-terminated result goes.
/// :param part: Where the address of the last component goes, or null.
/// :returns: The units written without the 0, the units needed when the buffer is too small, or 0 with the last
///     error set.
#[external("c"), symbol("GetFullPathNameW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_full_path_name(path: @U16, size: U32, buffer: @U16, part: Addr) -> U32

/// Binds the Win32 `GetFinalPathNameByHandleW` function: the path of an open file with every link resolved.
/// :param file: The open file.
/// :param buffer: Where the 0-terminated path goes.
/// :param size: The buffer's size in UTF-16 units.
/// :param flags: The `FILE_NAME_*` and `VOLUME_NAME_*` flags.
/// :returns: The units written without the 0, the units needed when the buffer is too small, or 0 with the last
///     error set.
#[external("c"), symbol("GetFinalPathNameByHandleW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_final_path_name_by_handle(file: Addr, buffer: @U16, size: U32,
    flags: U32) -> U32

/// Binds the Win32 `GetEnvironmentVariableW` function: copies an environment variable's value into a buffer.
/// :param name: The variable's 0-terminated UTF-16 name.
/// :param buffer: Where the 0-terminated value goes.
/// :param size: The buffer's size in UTF-16 units.
/// :returns: The units written without the 0, the units needed when the buffer is too small, or 0 when the
///     variable is not set.
#[external("c"), symbol("GetEnvironmentVariableW"), callconv("stdcall"), target(os: "windows")]
private routine c_get_environment_variable(name: CWStr, buffer: @U16, size: U32) -> U32

/// Binds the Win32 `GetSystemTimeAsFileTime` function: reads the current time.
/// :param time: Where the time goes, as a FILETIME.
#[external("c"), symbol("GetSystemTimeAsFileTime"), callconv("stdcall"), target(os: "windows")]
private routine c_get_system_time_as_file_time(time: @FileTime) -> Void

/// Binds the Win32 `SetFileTime` function: sets a file's times.
/// :param file: The open file, with `FILE_WRITE_ATTRIBUTES` access.
/// :param created: The new creation time, or null to leave it.
/// :param accessed: The new last-access time, or null to leave it.
/// :param written: The new last-write time, or null to leave it.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("SetFileTime"), callconv("stdcall"), target(os: "windows")]
private routine c_set_file_time(file: Addr, created: Addr, accessed: @FileTime,
    written: @FileTime) -> CInt

/// Binds the Win32 `CreateFileMappingW` function: makes a file-mapping object for an open file.
/// :param file: The open file.
/// :param security: The security attributes, or null.
/// :param protect: The `PAGE_*` protection.
/// :param size_high: The high 32 bits of the largest size, 0 with `size_low` 0 for the file's size.
/// :param size_low: The low 32 bits of the largest size.
/// :param name: The object's name, or null.
/// :returns: The mapping handle, or null with the last error set.
#[external("c"), symbol("CreateFileMappingW"), callconv("stdcall"), target(os: "windows")]
private routine c_create_file_mapping(file: Addr, security: Addr, protect: U32, size_high: U32,
    size_low: U32, name: Addr) -> Addr

/// Binds the Win32 `MapViewOfFile` function: maps part of a file-mapping object into memory.
/// :param mapping: The file-mapping object.
/// :param access: The `FILE_MAP_*` access.
/// :param offset_high: The high 32 bits of the file offset, a multiple of the allocation granularity.
/// :param offset_low: The low 32 bits of the file offset.
/// :param size: The bytes to map.
/// :returns: The view's address, or null with the last error set.
#[external("c"), symbol("MapViewOfFile"), callconv("stdcall"), target(os: "windows")]
private routine c_map_view_of_file(mapping: Addr, access: U32, offset_high: U32, offset_low: U32,
    size: USize) -> Addr

/// Binds the Win32 `UnmapViewOfFile` function: removes a mapped view.
/// :param view: The view's address.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("UnmapViewOfFile"), callconv("stdcall"), target(os: "windows")]
private routine c_unmap_view_of_file(view: Addr) -> CInt

/// Binds the Win32 `FlushViewOfFile` function: writes a view's changed pages back to its file.
/// :param view: The view's address.
/// :param size: The bytes to write back, 0 for the whole view.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("FlushViewOfFile"), callconv("stdcall"), target(os: "windows")]
private routine c_flush_view_of_file(view: Addr, size: USize) -> CInt

/// Binds the Win32 `GetCurrentProcess` function: a handle to the calling process.
/// :returns: The pseudo-handle, which needs no closing.
#[external("c"), symbol("GetCurrentProcess"), callconv("stdcall"), target(os: "windows")]
private routine c_get_current_process() -> Addr

/// Binds the Win32 `PrefetchVirtualMemory` function: asks the OS to read memory ranges in.
/// :param process: The process whose memory it is.
/// :param count: How many ranges.
/// :param ranges: The ranges.
/// :param flags: 0.
/// :returns: Nonzero, or 0 with the last error set.
#[external("c"), symbol("PrefetchVirtualMemory"), callconv("stdcall"), target(os: "windows")]
private routine c_prefetch_virtual_memory(process: Addr, count: USize, ranges: @MemoryRange,
    flags: U32) -> CInt

// -- errors and paths ----------------------------------------------------------------

/// The FsError for a Win32 error code.
/// :param e: The error code.
/// :returns: The matching FsError, `Other` for a code with no match.
#target(os: "windows")
private routine error_of(e: U32) -> FsError
    block entry()
        when e
            2, 3     -> return(FsError.NotFound)
            5        -> return(FsError.PermissionDenied)
            80, 183  -> return(FsError.AlreadyExists)
            267      -> return(FsError.NotADirectory)
            145      -> return(FsError.DirectoryNotEmpty)
            17       -> return(FsError.CrossDevice)
            206      -> return(FsError.NameTooLong)
            123, 161 -> return(FsError.InvalidPath)
            39, 112  -> return(FsError.NoSpace)
            19       -> return(FsError.ReadOnly)
            32, 33   -> return(FsError.Busy)
            8, 14    -> return(FsError.OutOfMemory)
            else     -> return(FsError.Other)

/// The FsError for the calling thread's last Win32 error.
/// :returns: The matching FsError.
#target(os: "windows")
private routine last_error() -> FsError
    block entry()
        return(error_of(c_get_last_error()))

/// A failure carrying the FsError for the calling thread's last Win32 error.
/// :typeparam T: The success type of the result.
/// :returns: `Failure` with that FsError.
#target(os: "windows")
private routine failed<T>() -> Result<T, FsError>
require T: typename
    block entry()
        return(.Failure(last_error()))

/// A nonzero BOOL is success, 0 the last error.
/// :param ok: The BOOL a call returned.
/// :returns: `Success(Unit)` for nonzero, else `Failure` with the FsError for the last error.
#target(os: "windows")
private routine checked(ok: CInt) -> Result<Unit, FsError>
    block entry()
        branch ok.ne(0)
            ? return(fs_done())
            : return(failed<Unit>())

/// Whether h is `INVALID_HANDLE_VALUE` (all ones).
/// :param h: The handle to test.
/// :returns: True for `INVALID_HANDLE_VALUE`.
#target(os: "windows")
private routine is_invalid_handle(h: Addr) -> Bool
    block entry()
        // INVALID_HANDLE_VALUE, (HANDLE)-1
        return(ptrtoint<Addr, USize>(h).eq(USize.MAX))

/// text as UTF-16 with a 0 after it in out, which has room for capacity units: its length in units, or Absent if
/// text has a NUL or doesn't fit. (A UTF-8 byte count bounds the unit count, so length + 1 units always fit.)
/// :param text: The UTF-8 text.
/// :param out: The buffer.
/// :param capacity: Its room in UTF-16 units.
/// :returns: The length in units, the 0 left out.
/// :absent: When `text` has a NUL or doesn't fit with its 0.
#target(os: "windows")
internal routine encode_utf16(text: Bytes, out: @U16, capacity: USize) -> Option<USize>
    shared iter : @BytesCharsIter <- text.chars()

    block entry()
        jump next(0)

    block next(n: USize)
        c : Option<Char> = iter.next()
        when c
            .Present(char) -> put(n, char.to<U32>())
            .Absent        -> end(n)

    block put(n: USize, cp: U32)
        branch cp.eq(0)
            ? return(.Absent)
            : continue
        branch cp.lt(0x10000)
            ? single(n, cp)
            : pair(n, cp)

    block single(n: USize, cp: U32)
        branch n.add(1).ge(capacity)
            ? return(.Absent)
            : continue
        out.stride(n).store(cp.to<U16>())
        jump next(n.add(1))

    block pair(n: USize, cp: U32)
        branch n.add(2).ge(capacity)
            ? return(.Absent)
            : continue
        v              : U32 = cp.sub(0x10000)
        high_surrogate : U32 = v.shr(10).add(0xD800)
        out.stride(n).store(high_surrogate.to<U16>())
        low_surrogate : U32 = v.bitand(0x3FF).add(0xDC00)
        out.stride(n.add(1)).store(low_surrogate.to<U16>())
        jump next(n.add(2))

    block end(n: USize)
        out.stride(n).store(0)
        return(.Present(n))

/// path as UTF-16 with a 0 after it in out (PATH_CAPACITY units): its length in units, or Absent if path has a NUL or
/// doesn't fit.
/// :param path: The UTF-8 path.
/// :param out: The buffer, `PATH_CAPACITY` units.
/// :returns: The length in units, the 0 left out.
/// :absent: When `path` has a NUL or doesn't fit.
#target(os: "windows")
private routine wide(path: Bytes, out: @U16) -> Option<USize>
    block entry()
        return(encode_utf16(path, out, PATH_CAPACITY))

/// path as UTF-16 in out: whether it fit.
/// :param path: The UTF-8 path.
/// :param out: The buffer, `PATH_CAPACITY` units.
/// :returns: True when it was converted. False when `path` has a NUL or doesn't fit.
#target(os: "windows")
private routine wide_path(path: Bytes, out: @U16) -> Bool
    block entry()
        n : Option<USize> = wide(path, out)
        return(n.is_present())

/// count UTF-16 units at units as UTF-8 at out (room for 3 bytes a unit): the bytes written. An unpaired surrogate
/// becomes U+FFFD.
/// :param units: The first unit.
/// :param count: How many units.
/// :param out: Where the UTF-8 goes.
/// :returns: The bytes written.
#target(os: "windows")
internal routine narrow(units: @U16, count: USize, out: @Byte) -> USize
    shared n : @USize <- 0

    block entry()
        jump next(0)

    block next(i: USize)
        branch i.ge(count)
            ? return(n.load())
            : continue
        unit : U16 = units.stride(i).load()
        u    : U32 = unit.to<U32>()
        branch u.between(0xD800, 0xDBFF)
            ? high(i, u)
            : continue
        branch u.between(0xDC00, 0xDFFF)
            ? put(i.add(1), 0xFFFD)
            : put(i.add(1), u)

    block high(i: USize, u: U32)
        branch i.add(1).lt(count)
            ? continue
            : put(i.add(1), 0xFFFD)
        low_unit : U16 = units.stride(i.add(1)).load()
        low      : U32 = low_unit.to<U32>()
        branch low.between(0xDC00, 0xDFFF)
            ? surrogate_pair(i, u, low)
            : put(i.add(1), 0xFFFD)

    block surrogate_pair(i: USize, u: U32, low: U32)
        high_half : U32 = u.sub(0xD800).shl(10)
        cp_offset : U32 = high_half.add(low.sub(0xDC00))
        jump put(i.add(2), cp_offset.add(0x10000))

    block put(i: USize, cp: U32)
        n.load().add(utf8_encode_into(cp.to<Char>(), out.stride(n.load()))).store_into(n)
        jump next(i)

/// The units before the first 0 at units.
/// :param units: A 0-terminated UTF-16 string.
/// :returns: The count of units before the 0.
#target(os: "windows")
internal routine wide_length(units: @U16) -> USize
    block entry()
        jump scan(0)

    block scan(i: USize)
        unit : U16 = units.stride(i).load()
        branch unit.eq(0)
            ? return(i)
            : scan(i.add(1))

/// count UTF-16 units as UTF-8, in memory from alloc, carrying that allocator.
/// :param units: The first unit.
/// :param count: How many units.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the UTF-8 text.
/// :throws: Returns `Failure(OutOfMemory)` when `alloc` fails.
#target(os: "windows")
internal routine owned_wide(units: @U16, count: USize, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        buffer : @Byte = allocate<Byte>(count.mul(3).max(1), alloc)
        branch buffer.is_null()
            ? return(.Failure(FsError.OutOfMemory))
            : continue
        n : USize = narrow(units, count, buffer)
        return(.Success(Bytes { data: buffer, count: n, alloc: alloc }))

// -- metadata ------------------------------------------------------------------------

/// Nanoseconds since 1970 from a FILETIME, wrapping on overflow.
/// :param t: The FILETIME.
/// :returns: The nanoseconds since 1970-01-01 UTC, negative before then.
#target(os: "windows")
private routine unix_ns(t: FileTime) -> S64
    block entry()
        high_ticks : U64 = t.high.to<U64>().shl(32)
        ticks      : U64 = high_ticks.bitor(t.low.to<U64>())
        // 100 ns ticks between 1601-01-01 and 1970-01-01
        since_epoch : S64 = ticks.to_wrap<S64>().sub_wrap(116444736000000000)
        return(since_epoch.mul_wrap(100))

/// A 64-bit size from its high and low 32-bit halves.
/// :param high: The high half.
/// :param low: The low half.
/// :returns: The size.
#target(os: "windows")
private routine size_of(high: U32, low: U32) -> U64
    block entry()
        upper : U64 = high.to<U64>().shl(32)
        return(upper.bitor(low.to<U64>()))

/// A link (symbolic or a junction) by its attributes and reparse tag, else a directory or a file.
/// :param attributes: The file's attribute bits.
/// :param tag: Its reparse tag, 0 when not known.
/// :returns: `Symlink`, `Directory`, or `File`.
#target(os: "windows")
private routine kind_of(attributes: U32, tag: U32) -> FileKind
    block entry()
        reparse : Bool = attributes.bitand(FILE_ATTRIBUTE_REPARSE_POINT).ne(0)
        link    : Bool = tag.eq(IO_REPARSE_TAG_SYMLINK).bitor(tag.eq(IO_REPARSE_TAG_MOUNT_POINT))
        branch reparse.bitand(link)
            ? return(FileKind.Symlink)
            : continue
        branch attributes.bitand(FILE_ATTRIBUTE_DIRECTORY).ne(0)
            ? return(FileKind.Directory)
            : return(FileKind.File)

/// A Metadata from the attributes, times, and size Windows reports. Read-only is the read-only attribute.
/// :param data: The file's attribute bits, times, and size.
/// :param tag: Its reparse tag, 0 when not known.
/// :returns: The metadata.
#target(os: "windows")
private routine make_metadata(data: AttributeData, tag: U32) -> Metadata
    block entry()
        size : U64 = size_of(data.size_high, data.size_low)
        return(Metadata { kind: kind_of(data.attributes, tag), size: size,
            modified_ns: unix_ns(data.written), created_ns: .Present(unix_ns(data.created)),
            readonly: data.attributes.bitand(FILE_ATTRIBUTE_READONLY).ne(0) })

/// The metadata in a WIN32_FIND_DATAW, which starts with the fields of a WIN32_FILE_ATTRIBUTE_DATA.
/// :param data: The `WIN32_FIND_DATAW`.
/// :returns: The metadata, a link describing itself.
#target(os: "windows")
private routine from_find_data(data: @Byte) -> Metadata
    block entry()
        parts  : AttributeData = data.to<@AttributeData>().load()
        tag_at : @Byte         = data.stride(FIND_REPARSE_TAG)
        tag    : U32           = tag_at.to<@U32>().load()
        return(make_metadata(parts, tag))

/// The Metadata in a `BY_HANDLE_FILE_INFORMATION`. It has no reparse tag, so a link reads as a directory or a file.
/// :returns: The metadata.
#target(os: "windows")
private routine HandleInfo.to<Metadata>(me: Me) -> Metadata
    block entry()
        parts : AttributeData = AttributeData { attributes: me.attributes, created: me.created,
            accessed: me.accessed, written: me.written, size_high: me.size_high,
            size_low: me.size_low }
        return(make_metadata(parts, 0))

/// The metadata of the open file h.
/// :param h: The open file.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the FsError for the last error when the call fails.
#target(os: "windows")
private routine handle_metadata(h: Addr) -> Result<Metadata, FsError>
    block entry()
        claim info : @HandleInfo <- uninit
        branch c_get_file_information_by_handle(h, info).ne(0)
            ? return(.Success(info.load().to<Metadata>()))
            : return(failed<Metadata>())

/// The metadata of wpath from GetFileAttributesExW, for what can't be opened (a file another process holds
/// exclusively).
/// :param wpath: The 0-terminated UTF-16 path.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the FsError for the last error when the call fails.
#target(os: "windows")
private routine attribute_metadata(wpath: @U16) -> Result<Metadata, FsError>
    block entry()
        claim data : @AttributeData <- uninit
        // GetFileExInfoStandard
        branch c_get_file_attributes_ex(wpath, 0, data).eq(0)
            ? return(failed<Metadata>())
            : continue
        d : AttributeData = data.load()
        return(.Success(make_metadata(d, 0)))

/// A handle for asking about path (no read or write access): a directory too, and with link_itself, a link rather
/// than what it points at.
/// :param wpath: The 0-terminated UTF-16 path.
/// :param link_itself: True to open a link itself, false to open what it points at.
/// :returns: The handle, or `INVALID_HANDLE_VALUE` with the last error set.
#target(os: "windows")
private routine query_handle(wpath: @U16, link_itself: Bool) -> Addr
    block entry()
        flags : U32 = link_itself
            ? FILE_FLAG_BACKUP_SEMANTICS.bitor(FILE_FLAG_OPEN_REPARSE_POINT)
            : FILE_FLAG_BACKUP_SEMANTICS
        return(c_create_file(wpath, 0, FILE_SHARE_ALL, null, OPEN_EXISTING, flags, null))

/// path's metadata, a link followed to what it points at.
/// :param path: The path to look at.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine metadata(path: Bytes) -> Result<Metadata, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        h : Addr = query_handle(wpath.to<@U16>(), false)
        branch is_invalid_handle(h)
            ? unopened(wpath.to<@U16>())
            : continue
        m : Result<Metadata, FsError> = handle_metadata(h)
        c_close_handle(h)
        return(m)

    // A missing file stays missing. Anything else may be a file that can't be opened, which the attributes still
    // describe.
    block unopened(wpath: @U16)
        error : FsError = last_error()
        branch error.eq(FsError.NotFound)
            ? return(.Failure(error))
            : return(attribute_metadata(wpath))

/// path's metadata. A link describes itself (kind Symlink), from its directory entry.
/// :param path: The path to look at.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine symlink_metadata(path: Bytes) -> Result<Metadata, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        claim data : @Array<U32, FIND_DATA_WORDS> <- uninit
        find : Addr = c_find_first_file(wpath.to<@U16>(), data.to<@Byte>())
        // A root ("C:\") has no directory entry: its attributes describe it
        branch is_invalid_handle(find)
            ? return(attribute_metadata(wpath.to<@U16>()))
            : continue
        c_find_close(find)
        return(.Success(from_find_data(data.to<@Byte>())))

// -- file handles --------------------------------------------------------------------------

/// An open file, from a File's open_read_result and the like: a Reader and a Writer. claim it, and close it when
/// done.
#target(os: "windows")
record FileHandle
    handle : Addr
    failed : Bool  // a write_bytes failed (write_all_result reports each failure itself)

/// A handle to no file, whose close() does nothing: the start value of a slot that a finish block closes.
/// :returns: The empty handle.
#target(os: "windows")
routine FileHandle.empty() -> Me
    block entry()
        return(Me { handle: inttoptr<USize, Addr>(USize.MAX), failed: false })

/// Opens path in mode. Other handles may read, write, and delete the file while it is open.
/// :param path: The file to open.
/// :param mode: How to open it.
/// :returns: `Success` with the open handle.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine FileHandle.open(path: Bytes, mode: OpenMode) -> Result<Me, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        when mode
            OpenMode.Read      -> open(wpath.to<@U16>(), GENERIC_READ, OPEN_EXISTING)
            OpenMode.Write     -> open(wpath.to<@U16>(), GENERIC_WRITE, CREATE_ALWAYS)
            OpenMode.Append    -> open(wpath.to<@U16>(), FILE_APPEND_ONLY, OPEN_ALWAYS)
            OpenMode.ReadWrite -> open(wpath.to<@U16>(), GENERIC_READ.bitor(GENERIC_WRITE),
                OPEN_EXISTING)
            OpenMode.CreateNew -> open(wpath.to<@U16>(), GENERIC_WRITE, CREATE_NEW)

    block open(wpath: @U16, access: U32, disposition: U32)
        h : Addr = c_create_file(wpath, access, FILE_SHARE_ALL, null, disposition,
            FILE_ATTRIBUTE_NORMAL, null)
        branch is_invalid_handle(h)
            ? return(failed<Me>())
            : return(.Success(Me { handle: h, failed: false }))

/// Reads up to count bytes into buffer: how many, 0 at the end of the file. One call reads at most 1 GiB, and a
/// broken pipe reads as the end.
/// :param buffer: Where the bytes go.
/// :param count: The most bytes to read.
/// :returns: `Success` with the count read, 0 at the end of the file.
/// :throws: Returns `Failure` with the reason when the read fails.
#target(os: "windows")
routine FileHandle.read_bytes_result(me: @Me, buffer: @Byte, count: USize) -> Result<USize, FsError>
    block entry()
        claim got : @U32 <- 0
        ok : CInt = c_read_file(me.handle.load(), buffer, count.min(1073741824).to<U32>(), got,
            null)
        branch ok.ne(0)
            ? return(.Success(got.load().to<USize>()))
            : continue
        // ERROR_BROKEN_PIPE: the writing end closed, which is the end
        e : U32 = c_get_last_error()
        branch e.eq(109)
            ? return(.Success(0))
            : return(.Failure(error_of(e)))

/// Writes up to count bytes: how many it did. One call writes at most 1 GiB.
/// :param data: The first byte to write.
/// :param count: The most bytes to write.
/// :returns: `Success` with the count written.
/// :throws: Returns `Failure` with the reason when the write fails.
#target(os: "windows")
internal routine FileHandle.write_some(me: @Me, data: @Byte, count: USize) -> Result<USize, FsError>
    block entry()
        claim wrote : @U32 <- 0
        ok : CInt = c_write_file(me.handle.load(), data, count.min(1073741824).to<U32>(), wrote,
            null)
        branch ok.ne(0)
            ? return(.Success(wrote.load().to<USize>()))
            : return(failed<USize>())

/// Moves the position: the new one, from the start.
/// :param offset: The distance to move, negative to go back.
/// :param from: Where `offset` counts from.
/// :returns: `Success` with the new position from the start.
/// :throws: Returns `Failure` with the reason, such as a position before the start.
#target(os: "windows")
routine FileHandle.seek_result(me: @Me, offset: S64, from: SeekFrom) -> Result<U64, FsError>
    shared at : @S64 <- 0

    block entry()
        // FILE_BEGIN, FILE_CURRENT, FILE_END
        when from
            SeekFrom.Start   -> moved(c_set_file_pointer_ex(me.handle.load(), offset, at, 0))
            SeekFrom.Current -> moved(c_set_file_pointer_ex(me.handle.load(), offset, at, 1))
            SeekFrom.End     -> moved(c_set_file_pointer_ex(me.handle.load(), offset, at, 2))

    block moved(ok: CInt)
        branch ok.ne(0)
            ? return(.Success(at.load().to<U64>()))
            : return(failed<U64>())

/// The metadata of the open file.
/// :returns: `Success` with the metadata.
/// :throws: Returns `Failure` with the reason when the OS can't report it.
#target(os: "windows")
routine FileHandle.metadata_result(me: @Me) -> Result<Metadata, FsError>
    block entry()
        return(handle_metadata(me.handle.load()))

/// The size of the open file in bytes.
/// :returns: `Success` with the size.
/// :throws: Returns `Failure` with the reason when the OS can't report it.
#target(os: "windows")
routine FileHandle.size_result(me: @Me) -> Result<U64, FsError>
    block entry()
        claim size : @S64 <- 0
        branch c_get_file_size_ex(me.handle.load(), size).ne(0)
            ? return(.Success(size.load().to<U64>()))
            : return(failed<U64>())

/// Truncates or extends (with zeros) the file to size bytes. The position stays.
/// :param size: The new size in bytes.
/// :returns: `Success(Unit)` once the size is set.
/// :throws: Returns `Failure` with the reason when the OS refuses. Crashes with `IntegerOverflowError` when `size`
///     doesn't fit in S64.
#target(os: "windows")
routine FileHandle.set_size_result(me: @Me, size: U64) -> Result<Unit, FsError>
    block entry()
        claim end : @S64 <- size.to<S64>()
        // FileEndOfFileInfo
        return(checked(c_set_file_information_by_handle(me.handle.load(), 6, end, 8)))

/// Waits until what was written is on the storage device.
/// :returns: `Success(Unit)` once it is.
/// :throws: Returns `Failure` with the reason when the OS reports an error.
#target(os: "windows")
routine FileHandle.sync_result(me: @Me) -> Result<Unit, FsError>
    block entry()
        return(checked(c_flush_file_buffers(me.handle.load())))

/// Closes the file and leaves the handle empty, so a second close does nothing.
#target(os: "windows")
routine FileHandle.close(me: @Me) -> Void
    block entry()
        h : Addr = me.handle.load()
        branch is_invalid_handle(h)
            ? return()
            : continue
        c_close_handle(h)
        me.handle.store(inttoptr<USize, Addr>(USize.MAX))
        return()

// -- directories and names -------------------------------------------------------------

/// Makes the directory path (its parent must exist).
/// :param path: The directory to make.
/// :returns: `Success(Unit)` once it is made.
/// :throws: Returns `Failure` with the reason, `AlreadyExists` when something is at `path`, `InvalidPath` or
///     `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine create_dir(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? return(checked(c_create_directory(wpath.to<@U16>(), null)))
            : return(.Failure(path_error(path)))

/// Removes a file (or a link, a directory link included), not a directory.
/// :param path: The file to remove.
/// :returns: `Success(Unit)` once it is gone.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine remove_file(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        branch c_delete_file(wpath.to<@U16>()).ne(0)
            ? return(fs_done())
            : continue
        // A link to a directory is a directory to DeleteFileW
        error      : U32  = c_get_last_error()
        attributes : U32  = c_get_file_attributes(wpath.to<@U16>())
        link_bits  : U32  = FILE_ATTRIBUTE_DIRECTORY.bitor(FILE_ATTRIBUTE_REPARSE_POINT)
        known      : Bool = attributes.ne(INVALID_FILE_ATTRIBUTES)
        dir_link   : Bool = known.bitand(attributes.bitand(link_bits).eq(link_bits))
        branch dir_link
            ? return(checked(c_remove_directory(wpath.to<@U16>())))
            : return(.Failure(error_of(error)))

/// Removes an empty directory.
/// :param path: The directory to remove.
/// :returns: `Success(Unit)` once it is gone.
/// :throws: Returns `Failure` with the reason, `DirectoryNotEmpty` when something is in it, `InvalidPath` or
///     `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine remove_dir(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? return(checked(c_remove_directory(wpath.to<@U16>())))
            : return(.Failure(path_error(path)))

/// Renames from to to with MoveFileExW and flags.
/// :param from: The current path.
/// :param to: The new path.
/// :param flags: The `MOVEFILE_*` flags.
/// :returns: `Success(Unit)` once it is renamed.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when a path doesn't fit a C path.
#target(os: "windows")
private routine move_file(from: Bytes, to: Bytes, flags: U32) -> Result<Unit, FsError>
    block entry()
        claim a : @Array<U16, PATH_CAPACITY> <- uninit
        claim b : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(from, a.to<@U16>())
            ? continue
            : return(.Failure(path_error(from)))
        branch wide_path(to, b.to<@U16>())
            ? return(checked(c_move_file_ex(a.to<@U16>(), b.to<@U16>(), flags)))
            : return(.Failure(path_error(to)))

/// Renames from to to, replacing what is at to. Between volumes it fails with CrossDevice.
/// :param from: The current path.
/// :param to: The new path.
/// :returns: `Success(Unit)` once it is renamed.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when a path doesn't fit a C path.
#target(os: "windows")
internal routine rename(from: Bytes, to: Bytes) -> Result<Unit, FsError>
    block entry()
        // MOVEFILE_REPLACE_EXISTING
        return(move_file(from, to, 1))

/// Renames from to to, failing with AlreadyExists if something is at to.
/// :param from: The current path.
/// :param to: The new path.
/// :returns: `Success(Unit)` once it is renamed.
/// :throws: Returns `Failure` with the reason, `AlreadyExists` when something is at `to`, `InvalidPath` or
///     `NameTooLong` when a path doesn't fit a C path.
#target(os: "windows")
internal routine rename_no_replace(from: Bytes, to: Bytes) -> Result<Unit, FsError>
    block entry()
        return(move_file(from, to, 0))

/// CopyFileExW's progress routine: records the bytes transferred so far in the U64 at `data`, and lets the copy go
/// on.
/// :param total_size: The file's size.
/// :param transferred: The bytes copied so far.
/// :param stream_size: The current stream's size.
/// :param stream_transferred: The current stream's bytes copied so far.
/// :param stream: The current stream's number.
/// :param reason: Why it is called (a chunk finished, or a stream started).
/// :param source: The source file's handle.
/// :param destination: The destination file's handle.
/// :param data: The U64 that counts the bytes copied.
/// :returns: `PROGRESS_CONTINUE` (0).
#[target(os: "windows"), callconv("stdcall")]
private routine copy_progress(total_size: S64, transferred: S64, stream_size: S64,
    stream_transferred: S64, stream: U32, reason: U32, source: Addr, destination: Addr,
    data: Addr) -> U32
    block entry()
        data.to<@U64>().store(transferred.to_wrap<U64>())
        return(0)

/// Copies from into to (made, or replaced): the bytes copied, as CopyFileExW reports them while it copies.
/// :param from: The file to copy.
/// :param to: The file to write.
/// :returns: `Success` with the number of bytes copied.
/// :throws: Returns `Failure` with the reason when the copy fails, `InvalidPath` or `NameTooLong` when a path doesn't
///     fit a C path.
#target(os: "windows")
internal routine copy_file(from: Bytes, to: Bytes) -> Result<U64, FsError>
    block entry()
        claim a      : @Array<U16, PATH_CAPACITY> <- uninit
        claim b      : @Array<U16, PATH_CAPACITY> <- uninit
        claim copied : @U64                       <- 0
        branch wide_path(from, a.to<@U16>())
            ? continue
            : return(.Failure(path_error(from)))
        branch wide_path(to, b.to<@U16>())
            ? continue
            : return(.Failure(path_error(to)))
        done : Bool = c_copy_file_ex(a.to<@U16>(), b.to<@U16>(), copy_progress.to<Callable>(),
            copied, null, 0).ne(0)
        branch done
            ? return(.Success(copied.load()))
            : return(failed<U64>())

/// Sets or clears the read-only attribute.
/// :param path: The file to change.
/// :param readonly: True to set the attribute, false to clear it.
/// :returns: `Success(Unit)` once the attribute is set.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine set_readonly(path: Bytes, readonly: Bool) -> Result<Unit, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        attributes : U32 = c_get_file_attributes(wpath.to<@U16>())
        branch attributes.eq(INVALID_FILE_ATTRIBUTES)
            ? return(failed<Unit>())
            : continue
        branch readonly
            ? return(checked(c_set_file_attributes(wpath.to<@U16>(),
                attributes.bitor(FILE_ATTRIBUTE_READONLY))))
            : return(checked(c_set_file_attributes(wpath.to<@U16>(),
                attributes.bitand(FILE_ATTRIBUTE_READONLY.bitnot()))))

/// Whether e (an extension) is exe, com, cmd, or bat, in any case.
/// :param e: The extension, without its dot.
/// :returns: True for those four.
#target(os: "windows")
private routine is_program_extension(e: Bytes) -> Bool
    block entry()
        branch e.count().eq(3)
            ? continue
            : return(false)
        // ASCII lowercase: setting bit 5 of a letter
        a         : U8   = e.byte_at(0).bitor(0x20)
        b         : U8   = e.byte_at(1).bitor(0x20)
        c         : U8   = e.byte_at(2).bitor(0x20)
        starts_ex : Bool = a.eq(101).bitand(b.eq(120))
        exe       : Bool = starts_ex.bitand(c.eq(101))
        starts_co : Bool = a.eq(99).bitand(b.eq(111))
        com       : Bool = starts_co.bitand(c.eq(109))
        starts_cm : Bool = a.eq(99).bitand(b.eq(109))
        cmd       : Bool = starts_cm.bitand(c.eq(100))
        starts_ba : Bool = a.eq(98).bitand(b.eq(97))
        bat       : Bool = starts_ba.bitand(c.eq(116))
        binary    : Bool = exe.bitor(com)
        script    : Bool = cmd.bitor(bat)
        return(binary.bitor(script))

/// Whether path can be read (it exists), written (it exists and isn't read-only), or run (a file named .exe, .com,
/// .cmd, or .bat). Windows checks permissions only when a file is opened.
/// :param path: The path to check.
/// :param access: What to check for.
/// :returns: True when allowed. False when not, when nothing is there, or when `path` doesn't fit a C path.
#target(os: "windows")
internal routine is_accessible(path: Bytes, access: Access) -> Bool
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(false)
        attributes : U32 = c_get_file_attributes(wpath.to<@U16>())
        branch attributes.eq(INVALID_FILE_ATTRIBUTES)
            ? return(false)
            : continue
        when access
            Access.Read    -> return(true)
            Access.Write   -> return(attributes.bitand(FILE_ATTRIBUTE_READONLY).eq(0))
            Access.Execute -> run(attributes)

    block run(attributes: U32)
        branch attributes.bitand(FILE_ATTRIBUTE_DIRECTORY).ne(0)
            ? return(false)
            : return(is_program_extension(file_extension(path)))

/// Makes the file if it's missing, and sets its access and modification times to now.
/// :param path: The file to touch.
/// :returns: `Success(Unit)` once the times are set.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine touch(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        h : Addr = c_create_file(wpath.to<@U16>(), FILE_WRITE_ATTRIBUTES, FILE_SHARE_ALL, null,
            OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL.bitor(FILE_FLAG_BACKUP_SEMANTICS), null)
        branch is_invalid_handle(h)
            ? return(failed<Unit>())
            : continue
        claim now : @FileTime <- FileTime { low: 0, high: 0 }
        c_get_system_time_as_file_time(now)
        set : Result<Unit, FsError> = checked(c_set_file_time(h, null, now, now))
        c_close_handle(h)
        return(set)

// -- directory listings ------------------------------------------------------------------

/// The entries of a directory, "." and ".." left out, in the order the OS gives them. claim one, open it on a
/// Directory, call next until Absent, and close it.
#target(os: "windows")
record DirIter
    find    : Addr
    data    : Array<U32, FIND_DATA_WORDS>  // WIN32_FIND_DATAW of the entry next returns or returned
    pending : Bool  // data holds an entry next hasn't returned yet
    name    : Array<Byte, 1024>  // the UTF-8 name next returned

/// Opens the listing of the directory at path, a search for `path\*`. The handle is invalid until the search starts,
/// so close() is safe after a failure.
/// :param path: The directory to list.
/// :returns: `Success(Unit)` once the listing is open.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine DirIter.open_path(me: @Me, path: Bytes) -> Result<Unit, FsError>
    shared pattern_buffer : @Array<U16, PATH_CAPACITY> <- uninit
    shared pattern        : @U16                       = pattern_buffer.to<@U16>()

    block entry()
        me.find.store(inttoptr<USize, Addr>(USize.MAX))
        me.pending.store(false)
        n : Option<USize> = wide(path, pattern)
        when n
            .Present(count) -> star(count)
            .Absent         -> return(.Failure(path_error(path)))

    // path, a separator unless it ends with one, and "*"
    block star(count: USize)
        branch count.add(2).ge(PATH_CAPACITY)
            ? return(.Failure(FsError.NameTooLong))
            : continue
        branch count.eq(0)
            ? glob(0)
            : continue
        last : U16 = pattern.stride(count.sub(1)).load()
        branch last.eq(0x2F).bitor(last.eq(0x5C))
            ? glob(count)
            : continue
        pattern.stride(count).store(0x5C)
        jump glob(count.add(1))

    block glob(at: USize)
        pattern.stride(at).store(0x2A)
        pattern.stride(at.add(1)).store(0)
        find : Addr = c_find_first_file(pattern, me.data.to<@Byte>())
        branch is_invalid_handle(find)
            ? return(failed<Unit>())
            : continue
        me.find.store(find)
        me.pending.store(true)
        return(fs_done())

/// Whether the UTF-16 name is "." or "..".
/// :param name: The 0-terminated UTF-16 name.
/// :returns: True for "." and "..".
#target(os: "windows")
private routine is_dot_wide(name: @U16) -> Bool
    block entry()
        branch name.load().eq(0x2E)
            ? continue
            : return(false)
        second : U16 = name.stride(1).load()
        branch second.eq(0)
            ? return(true)
            : continue
        branch second.eq(0x2E)
            ? two_dots()
            : return(false)

    block two_dots()
        third : U16 = name.stride(2).load()
        return(third.eq(0))

/// The next entry, or Absent at the end (a failure partway reads as the end).
/// :returns: The next entry, its name valid until the next call.
/// :absent: At the end of the listing, or when reading it fails.
#target(os: "windows")
routine DirIter.next(me: @Me) -> Option<DirEntry>
    block entry()
        branch is_invalid_handle(me.find.load())
            ? return(.Absent)
            : continue
        branch me.pending.load()
            ? current()
            : continue
        branch c_find_next_file(me.find.load(), me.data.to<@Byte>()).ne(0)
            ? current()
            : return(.Absent)

    block current()
        me.pending.store(false)
        data : @Byte = me.data.to<@Byte>()
        name : @U16  = data.stride(FIND_NAME).to<@U16>()
        branch is_dot_wide(name)
            ? return(me.next())
            : continue
        n    : USize    = narrow(name, wide_length(name), me.name.to<@Byte>())
        info : Metadata = from_find_data(data)
        return(.Present(DirEntry { name: Bytes.from_ptr(me.name.to<@Byte>(), n), kind: info.kind }))

/// The metadata of the entry next last returned, from the listing itself (a link describes itself).
/// :returns: `Success` with the metadata, which never fails here.
#target(os: "windows")
routine DirIter.entry_metadata_result(me: @Me) -> Result<Metadata, FsError>
    block entry()
        return(.Success(from_find_data(me.data.to<@Byte>())))

/// Ends the listing and leaves the handle invalid, so a second close does nothing.
#target(os: "windows")
routine DirIter.close(me: @Me) -> Void
    block entry()
        find : Addr = me.find.load()
        branch is_invalid_handle(find)
            ? return()
            : continue
        c_find_close(find)
        me.find.store(inttoptr<USize, Addr>(USize.MAX))
        return()

// -- the working directory and well-known directories -------------------------------------

/// The working directory, in memory from alloc.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the path.
/// :throws: Returns `Failure` with the reason when the OS can't report it, `OutOfMemory` when `alloc` fails.
#target(os: "windows")
internal routine current_dir(alloc: @Allocator) -> Result<Bytes, FsError>
    shared units : @Slice<U16> <- .empty()

    block entry()
        need : U32 = c_get_current_directory(0, null)
        branch need.eq(0)
            ? finish(failed<Bytes>())
            : continue
        made : Result<Slice<U16>, AllocFailed> = Slice<U16>.construct_result(need.to<USize>(),
            alloc)
        when made
            .Success(slice) -> read(slice)
            .Failure        -> finish(.Failure(FsError.OutOfMemory))

    block read(slice: Slice<U16>)
        slice.store_into(units)
        need : U32 = slice.count().to<U32>()
        got  : U32 = c_get_current_directory(need, slice.to<@U16>())
        branch got.eq(0).bitor(got.ge(need))
            ? finish(failed<Bytes>())
            : finish(owned_wide(slice.to<@U16>(), got.to<USize>(), alloc))

    block finish(result: Result<Bytes, FsError>)
        units.destruct()
        return(result)

/// Makes path the working directory.
/// :param path: The new working directory.
/// :returns: `Success(Unit)` once it is changed.
/// :throws: Returns `Failure` with the reason, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine set_current_dir(path: Bytes) -> Result<Unit, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? return(checked(c_set_current_directory(wpath.to<@U16>())))
            : return(.Failure(path_error(path)))

/// The temporary directory without its trailing separator (C:\Windows\Temp when it can't be told), in memory from
/// alloc.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the path.
/// :throws: Returns `Failure(OutOfMemory)` when `alloc` fails.
#target(os: "windows")
internal routine temp_dir(alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        claim units : @Array<U16, PATH_CAPACITY> <- uninit
        got : U32 = c_get_temp_path(PATH_CAPACITY.to<U32>(), units.to<@U16>())
        branch got.eq(0).bitor(got.to<USize>().ge(PATH_CAPACITY))
            ? fallback()
            : continue
        path_units : @U16 = units.to<@U16>()
        last       : U16  = path_units.stride(got.sub(1).to<USize>()).load()
        branch last.eq(0x5C).bitor(last.eq(0x2F))
            ? return(owned_wide(units.to<@U16>(), got.sub(1).to<USize>(), alloc))
            : return(owned_wide(units.to<@U16>(), got.to<USize>(), alloc))

    block fallback()
        buffer : @Byte = allocate<Byte>(15, alloc)
        branch buffer.is_null()
            ? return(.Failure(FsError.OutOfMemory))
            : continue
        buffer.copy("C:\\Windows\\Temp", 15)
        return(.Success(Bytes { data: buffer, count: 15, alloc: alloc }))

/// The environment variable name, as UTF-8 in memory from alloc, when it is set and not empty.
/// :param name: The variable's 0-terminated UTF-16 name.
/// :param alloc: The allocator for the text.
/// :returns: The value.
/// :absent: When the variable is not set, is empty, takes `PATH_CAPACITY` units or more, or `alloc` fails.
#target(os: "windows")
private routine env_dir(name: CWStr, alloc: @Allocator) -> Option<Bytes>
    block entry()
        claim units : @Array<U16, PATH_CAPACITY> <- uninit
        got : U32 = c_get_environment_variable(name, units.to<@U16>(), PATH_CAPACITY.to<U32>())
        branch got.eq(0).bitor(got.to<USize>().ge(PATH_CAPACITY))
            ? return(.Absent)
            : continue
        text : Result<Bytes, FsError> = owned_wide(units.to<@U16>(), got.to<USize>(), alloc)
        when text
            .Success(t) -> return(.Present(t))
            .Failure    -> return(.Absent)

/// USERPROFILE, or HOMEDRIVE and HOMEPATH, in memory from alloc. NotFound when neither is set.
/// :param alloc: The allocator for the text.
/// :returns: `Success` with the path.
/// :throws: Returns `Failure(NotFound)` when neither is set, or when `alloc` fails for a variable's value. Crashes
///     with `MemoryAllocationError` when `alloc` fails joining HOMEDRIVE and HOMEPATH.
#target(os: "windows")
internal routine home_dir(alloc: @Allocator) -> Result<Bytes, FsError>
    shared drive : @Bytes <- .empty()
    shared path  : @Bytes <- .empty()

    block entry()
        profile : Option<Bytes> = env_dir("USERPROFILE", alloc)
        when profile
            .Present(dir) -> finish(.Success(dir))
            .Absent       -> from_drive()

    block from_drive()
        d : Option<Bytes> = env_dir("HOMEDRIVE", alloc)
        when d
            .Present(text) -> home_path(text)
            .Absent        -> finish(.Failure(FsError.NotFound))

    block home_path(drive_text: Bytes)
        drive_text.store_into(drive)
        p : Option<Bytes> = env_dir("HOMEPATH", alloc)
        when p
            .Present(text) -> join(text)
            .Absent        -> finish(.Failure(FsError.NotFound))

    block join(path_text: Bytes)
        path_text.store_into(path)
        both : Bytes = Bytes.concat(drive.load(), path.load(), alloc)
        jump finish(.Success(both))

    block finish(result: Result<Bytes, FsError>)
        drive.destruct()
        path.destruct()
        return(result)

/// path made absolute by the text: the working directory in front of a relative path, and "." and ".." taken out
/// (GetFullPathNameW), nothing looked up.
/// :param path: The path to make absolute.
/// :param alloc: The allocator for the result.
/// :returns: `Success` with the absolute path.
/// :throws: Returns `Failure` with the reason, `NameTooLong` when the result doesn't fit, `OutOfMemory` when
///     `alloc` fails, `InvalidPath` or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine absolute_path(path: Bytes, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        claim full : @Array<U16, PATH_CAPACITY> <- uninit
        got : U32 = c_get_full_path_name(wpath.to<@U16>(), PATH_CAPACITY.to<U32>(), full.to<@U16>(),
            null)
        branch got.eq(0)
            ? return(failed<Bytes>())
            : continue
        branch got.to<USize>().ge(PATH_CAPACITY)
            ? return(.Failure(FsError.NameTooLong))
            : return(owned_wide(full.to<@U16>(), got.to<USize>(), alloc))

/// The absolute path with every link, ".", and ".." resolved, and path must exist. The "\\?\" prefix the OS gives is
/// taken off ("\\?\UNC\server\share" becomes "\\server\share").
/// :param path: The path to resolve.
/// :param alloc: The allocator for the result.
/// :returns: `Success` with the resolved path.
/// :throws: Returns `Failure` with the reason, such as `NotFound`, `OutOfMemory` when `alloc` fails, `InvalidPath`
///     or `NameTooLong` when `path` doesn't fit a C path.
#target(os: "windows")
internal routine canonical_path(path: Bytes, alloc: @Allocator) -> Result<Bytes, FsError>
    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : return(.Failure(path_error(path)))
        h : Addr = query_handle(wpath.to<@U16>(), false)
        branch is_invalid_handle(h)
            ? return(failed<Bytes>())
            : continue
        claim full : @Array<U16, PATH_CAPACITY> <- uninit
        // FILE_NAME_NORMALIZED | VOLUME_NAME_DOS
        got : U32 = c_get_final_path_name_by_handle(h, full.to<@U16>(), PATH_CAPACITY.to<U32>(), 0)
        e   : U32 = c_get_last_error()
        c_close_handle(h)
        branch got.eq(0)
            ? return(.Failure(error_of(e)))
            : continue
        branch got.to<USize>().ge(PATH_CAPACITY)
            ? return(.Failure(FsError.NameTooLong))
            : continue
        text : Result<Bytes, FsError> = owned_wide(full.to<@U16>(), got.to<USize>(), alloc)
        when text
            .Success(t)     -> strip(t)
            .Failure(error) -> return(.Failure(error))

    block strip(t: Bytes)
        branch t.has_prefix("\\\\?\\UNC\\")
            ? unc(t)
            : continue
        branch t.has_prefix("\\\\?\\")
            ? shift(t, 4, 0)
            : return(.Success(t))

    // "\\?\UNC\server" to "\\server": keep the first two backslashes, drop "?\UNC\"
    block unc(t: Bytes)
        jump shift(t, 8, 2)

    // Moves the text from from down to keep, so the buffer's start (what free wants) stays where it is.
    block shift(t: Bytes, from: USize, keep: USize)
        rest : USize = t.count().sub(from)
        jump move(t, from, keep, rest, 0)

    block move(t: Bytes, from: USize, keep: USize, rest: USize, i: USize)
        branch i.eq(rest)
            ? return(.Success(Bytes { data: t.data, count: keep.add(rest), alloc: t.alloc }))
            : continue
        t.data.stride(keep.add(i)).store(t.data.stride(from.add(i)).load())
        jump move(t, from, keep, rest, i.add(1))

// -- memory-mapped files -----------------------------------------------------------------

/// Maps count bytes of path from offset (USize.MAX: to the end), clamped to the file. Past the end, or an empty
/// file, gives an empty mapping. write maps it so stores reach the file. Otherwise it's read-only (opened for a
/// front-to-back read).
/// :param path: The file to map.
/// :param write: True for a writable mapping whose stores reach the file.
/// :param offset: Where in the file the mapping starts.
/// :param count: The most bytes to map.
/// :returns: `Success` with the mapping.
/// :throws: Returns `Failure` with the reason when the file can't be opened, measured, or mapped.
#target(os: "windows")
internal routine Mapping.map(path: Bytes, write: Bool, offset: U64,
    count: USize) -> Result<Me, FsError>
    shared file : @FileHandle <- .empty()

    block entry()
        claim wpath : @Array<U16, PATH_CAPACITY> <- uninit
        branch wide_path(path, wpath.to<@U16>())
            ? continue
            : finish(.Failure(path_error(path)))
        branch write
            ? opened(c_create_file(wpath.to<@U16>(), GENERIC_READ.bitor(GENERIC_WRITE),
                FILE_SHARE_ALL, null, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, null))
            : opened(c_create_file(wpath.to<@U16>(), GENERIC_READ, FILE_SHARE_ALL, null,
                OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, null))

    block opened(h: Addr)
        branch is_invalid_handle(h)
            ? finish(failed<Me>())
            : continue
        file.handle.store(h)
        claim size : @S64 <- 0
        branch c_get_file_size_ex(h, size).ne(0)
            ? sized(h, size.load().to<U64>())
            : finish(failed<Me>())

    block sized(h: Addr, size: U64)
        branch offset.ge(size)
            ? finish(.Success(Me.empty()))
            : continue
        want_bytes : U64   = count.to<U64>().min(size.sub(offset))
        want       : USize = want_bytes.to<USize>()
        grain      : U64   = map_granularity().to<U64>()
        aligned    : U64   = offset.sub(offset.mod(grain))
        delta      : USize = offset.sub(aligned).to<USize>()
        // PAGE_READWRITE or PAGE_READONLY
        protect : U32 = write
            ? 4
            : 2
        mapping : Addr = c_create_file_mapping(h, null, protect, 0, 0, null)
        branch mapping.is_null()
            ? finish(failed<Me>())
            : continue
        // FILE_MAP_WRITE or FILE_MAP_READ
        access : U32 = write
            ? 2
            : 4
        view : Addr = c_map_view_of_file(mapping, access, aligned.shr(32).to_wrap<U32>(),
            aligned.to_wrap<U32>(), want.add(delta))
        e    : U32  = c_get_last_error()
        // the view keeps the mapping and the file open on its own
        c_close_handle(mapping)
        branch view.is_null()
            ? finish(.Failure(error_of(e)))
            : finish(.Success(Me { base: view, delta: delta, count: want }))

    block finish(result: Result<Me, FsError>)
        file.close()
        return(result)

/// Writes changed pages back to the file.
/// :returns: `Success(Unit)` once they are written, at once for an empty mapping.
/// :throws: Returns `Failure` with the reason when FlushViewOfFile fails.
#target(os: "windows")
routine Mapping.flush_result(me: Me) -> Result<Unit, FsError>
    block entry()
        branch me.base.is_null()
            ? return(fs_done())
            : return(checked(c_flush_view_of_file(me.base, 0)))

/// Writes changed pages back and unmaps.
#target(os: "windows")
routine Mapping.unmap(me: Me) -> Void
    block entry()
        branch me.base.is_null()
            ? return()
            : continue
        c_flush_view_of_file(me.base, 0)
        c_unmap_view_of_file(me.base)
        return()

/// Asks the OS to read the whole mapping in now.
#target(os: "windows")
routine Mapping.prefetch(me: Me) -> Void
    block entry()
        branch me.base.is_null()
            ? return()
            : continue
        claim range : @MemoryRange <- MemoryRange { address: me.base, size: me.delta.add(me.count) }
        c_prefetch_virtual_memory(c_get_current_process(), 1, range, 0)
        return()

/// Tells the OS the mapping will be read front to back: a read-only mapping's file was already opened that way.
#target(os: "windows")
routine Mapping.advise_sequential(me: Me) -> Void
    block entry()
        return()
