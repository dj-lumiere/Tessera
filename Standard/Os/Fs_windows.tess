// Tessera stdlib: files and the filesystem on Windows (see Fs.tess)
//
// The wide-character (W) calls: a path's UTF-8 becomes UTF-16 on the way in, and text from the OS (a directory
// entry, the working directory) becomes UTF-8 on the way out, an unpaired surrogate as U+FFFD. So any path the
// filesystem holds works, whatever the code page.

module Standard/Os

import Standard/Alloc

preset GENERIC_READ:                 U32 = 0x80000000
preset GENERIC_WRITE:                U32 = 0x40000000
preset FILE_APPEND_ONLY:             U32 = 0x120114  // FILE_GENERIC_WRITE without FILE_WRITE_DATA
preset FILE_WRITE_ATTRIBUTES:        U32 = 0x100
preset FILE_SHARE_ALL:               U32 = 7  // read, write, and delete
preset CREATE_NEW:                   U32 = 1
preset CREATE_ALWAYS:                U32 = 2
preset OPEN_EXISTING:                U32 = 3
preset OPEN_ALWAYS:                  U32 = 4
preset FILE_ATTRIBUTE_READONLY:      U32 = 0x1
preset FILE_ATTRIBUTE_DIRECTORY:     U32 = 0x10
preset FILE_ATTRIBUTE_NORMAL:        U32 = 0x80
preset FILE_ATTRIBUTE_REPARSE_POINT: U32 = 0x400
preset INVALID_FILE_ATTRIBUTES:      U32 = 0xFFFFFFFF
preset FILE_FLAG_BACKUP_SEMANTICS:   U32 = 0x02000000
preset FILE_FLAG_OPEN_REPARSE_POINT: U32 = 0x00200000
preset FILE_FLAG_SEQUENTIAL_SCAN:    U32 = 0x08000000
preset IO_REPARSE_TAG_SYMLINK:       U32 = 0xA000000C
preset IO_REPARSE_TAG_MOUNT_POINT:   U32 = 0xA0000003

/// WIN32_FIND_DATAW: the fields of a WIN32_FILE_ATTRIBUTE_DATA (attributes, times, size), the reparse tag, then the
/// name.
preset FIND_DATA_WORDS:  USize = 148

preset FIND_REPARSE_TAG: USize = 36
preset FIND_NAME:        USize = 44

/// FILETIME: 100-nanosecond ticks since 1601-01-01 UTC.
@target(os: "windows")
private record FileTime
    low: U32
    high: U32

/// WIN32_FILE_ATTRIBUTE_DATA
@target(os: "windows")
private record AttributeData
    attributes: U32
    created: FileTime
    accessed: FileTime
    written: FileTime
    size_high: U32
    size_low: U32

/// BY_HANDLE_FILE_INFORMATION
@target(os: "windows")
private record HandleInfo
    attributes: U32
    created: FileTime
    accessed: FileTime
    written: FileTime
    volume_serial: U32
    size_high: U32
    size_low: U32
    links: U32
    index_high: U32
    index_low: U32

@target(os: "windows")
private record MemoryRange
    address: Addr
    size: USize

/// Makes a `HandleInfo` from its fields.
/// :param attributes: Its `attributes`.
/// :param created: Its `created`.
/// :param accessed: Its `accessed`.
/// :param written: Its `written`.
/// :param volume_serial: Its `volume_serial`.
/// :param size_high: Its `size_high`.
/// :param size_low: Its `size_low`.
/// :param links: Its `links`.
/// :param index_high: Its `index_high`.
/// :param index_low: Its `index_low`.
/// :returns: The new value.
@target(os: "windows")
private routine HandleInfo.construct(attributes: U32, created: FileTime, accessed: FileTime,
    written: FileTime, volume_serial: U32, size_high: U32, size_low: U32, links: U32,
    index_high: U32, index_low: U32) -> Me
    return Me(attributes, created, accessed, written, volume_serial, size_high, size_low, links, index_high, index_low)

/// Makes a `MemoryRange` from its fields.
/// :param address: Its `address`.
/// :param size: Its `size`.
/// :returns: The new value.
@target(os: "windows")
private routine MemoryRange.construct(address: Addr, size: USize) -> Me
    return Me(address, size)

/// Releases nothing: a `MemoryRange` holds no memory of its own.
@target(os: "windows")
private routine MemoryRange.destruct(me: @Me) -> None
    return

/// Binds the Win32 `GetLastError` function: the calling thread's last error code.
/// :returns: The error code.
@external("c")
@symbol("GetLastError")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_last_error() -> U32

/// Binds the Win32 `CreateFileW` function: opens or creates a file, a directory with backup semantics, or a device.
/// :param name: The 0-terminated UTF-16 path.
/// :param access: The access rights, such as `GENERIC_READ`.
/// :param share: The `FILE_SHARE_*` modes other handles may open it with.
/// :param security: The security attributes, or null.
/// :param disposition: What to do when the file is there or missing, such as `OPEN_EXISTING`.
/// :param flags: The `FILE_ATTRIBUTE_*` and `FILE_FLAG_*` values.
/// :param template: A template file handle, or null.
/// :returns: The handle, or `INVALID_HANDLE_VALUE` (all ones) with the last error set.
@external("c")
@symbol("CreateFileW")
@callconv("stdcall")
@target(os: "windows")
private routine c_create_file(name: @U16, access: U32, share: U32, security: Addr, disposition: U32,
    flags: U32, template: Addr) -> Addr

/// Binds the Win32 `CloseHandle` function: closes a handle.
/// :param handle: The handle to close.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("CloseHandle")
@callconv("stdcall")
@target(os: "windows")
private routine c_close_handle(handle: Addr) -> CInt

/// Binds the Win32 `ReadFile` function: reads from a file.
/// :param file: The open file.
/// :param buffer: Where the bytes go.
/// :param count: The most bytes to read.
/// :param read: Where the count read goes.
/// :param overlapped: An `OVERLAPPED` for asynchronous reads, or null.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("ReadFile")
@callconv("stdcall")
@target(os: "windows")
private routine c_read_file(file: Addr, buffer: @Byte, count: U32, read: @U32,
    overlapped: Addr) -> CInt

/// Binds the Win32 `WriteFile` function: writes to a file.
/// :param file: The open file.
/// :param data: The first byte to write.
/// :param count: The most bytes to write.
/// :param written: Where the count written goes.
/// :param overlapped: An `OVERLAPPED` for asynchronous writes, or null.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("WriteFile")
@callconv("stdcall")
@target(os: "windows")
private routine c_write_file(file: Addr, data: @Byte, count: U32, written: @U32,
    overlapped: Addr) -> CInt

/// Binds the Win32 `SetFilePointerEx` function: moves a file's position.
/// :param file: The open file.
/// :param distance: The distance to move.
/// :param position: Where the new position, from the start, goes, or null.
/// :param method: Where `distance` counts from: 0 the start, 1 the current position, 2 the end.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("SetFilePointerEx")
@callconv("stdcall")
@target(os: "windows")
private routine c_set_file_pointer_ex(file: Addr, distance: S64, position: @S64,
    method: U32) -> CInt

/// Binds the Win32 `GetFileSizeEx` function: reads a file's size.
/// :param file: The open file.
/// :param size: Where the size in bytes goes.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("GetFileSizeEx")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_file_size_ex(file: Addr, size: @S64) -> CInt

/// Binds the Win32 `SetFileInformationByHandle` function: sets one class of information about a file.
/// :param file: The open file.
/// :param class: The `FILE_INFO_BY_HANDLE_CLASS` value, such as `FileEndOfFileInfo`.
/// :param info: The information.
/// :param size: Its size in bytes.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("SetFileInformationByHandle")
@callconv("stdcall")
@target(os: "windows")
private routine c_set_file_information_by_handle(file: Addr, class: CInt, info: Addr,
    size: U32) -> CInt

/// Binds the Win32 `GetFileInformationByHandle` function: reads a file's attributes, times, size, and identity.
/// :param file: The open file.
/// :param info: Where the information goes.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("GetFileInformationByHandle")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_file_information_by_handle(file: Addr, info: @HandleInfo) -> CInt

/// Binds the Win32 `FlushFileBuffers` function: waits until a file's written data is on the storage device.
/// :param file: The open file.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("FlushFileBuffers")
@callconv("stdcall")
@target(os: "windows")
private routine c_flush_file_buffers(file: Addr) -> CInt

/// Binds the Win32 `GetFileAttributesW` function: reads a file's attribute bits.
/// :param path: The 0-terminated UTF-16 path.
/// :returns: The attributes, or `INVALID_FILE_ATTRIBUTES` with the last error set.
@external("c")
@symbol("GetFileAttributesW")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_file_attributes(path: @U16) -> U32

/// Binds the Win32 `GetFileAttributesExW` function: reads a file's attributes, times, and size without opening it.
/// :param path: The 0-terminated UTF-16 path.
/// :param level: The information level, 0 for `GetFileExInfoStandard`.
/// :param data: Where the information goes.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("GetFileAttributesExW")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_file_attributes_ex(path: @U16, level: CInt, data: @AttributeData) -> CInt

/// Binds the Win32 `SetFileAttributesW` function: sets a file's attribute bits.
/// :param path: The 0-terminated UTF-16 path.
/// :param attributes: The new attributes.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("SetFileAttributesW")
@callconv("stdcall")
@target(os: "windows")
private routine c_set_file_attributes(path: @U16, attributes: U32) -> CInt

/// Binds the Win32 `CreateDirectoryW` function: makes a directory.
/// :param path: The 0-terminated UTF-16 path of the new directory.
/// :param security: The security attributes, or null.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("CreateDirectoryW")
@callconv("stdcall")
@target(os: "windows")
private routine c_create_directory(path: @U16, security: Addr) -> CInt

/// Binds the Win32 `RemoveDirectoryW` function: removes an empty directory, or a link to a directory.
