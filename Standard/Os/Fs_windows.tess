/// :param size: The buffer's size in UTF-16 units.
/// :param buffer: The buffer, or null to ask for the size.
/// :returns: The units written without the 0, the units needed with the 0 when the buffer is too small, or 0 with
///     the last error set.
@external("c")
@symbol("GetCurrentDirectoryW")
@callconv("stdcall")
@target(os: "windows")
private routine c_get_current_directory(size: U32, buffer: @U16) -> U32

/// Binds the Win32 `SetCurrentDirectoryW` function: changes the working directory.
/// :param path: The 0-terminated UTF-16 path of the new working directory.
/// :returns: Nonzero, or 0 with the last error set.
@external("c")
@symbol("SetCurrentDirectoryW")
@callconv("stdcall")
@target(os: "windows")
private routine c_set_current_directory(path: @U16) -> CInt

/// Binds the Win32 `GetTempPathW` function: copies the temporary directory, with a trailing backslash and a 0,
/// into a buffer.
/// :param size: The buffer's size in UTF-16 units.
/// :param buffer: The buffer.
