# Tessera stdlib: ExclusiveLock
#
# A lock in one U32, the same on every operating system: atomics for the
# uncontended case and wait_while / wake_one for the rest (Drepper's three-state
# futex mutex). A fiber that waits for it parks instead of holding up its thread. 0 is free, 1 locked, 2 locked with a thread that may be
# waiting. An ExclusiveLock starts free (ExclusiveLock { state: 0 }) and needs nothing to free.

module Standard/Os

### A lock in one U32 that works the same on every operating system: atomics when uncontended, {wait_on} and
### {wake_one} otherwise. 0 is free, 1 locked, 2 locked with a thread that may be waiting. It starts free, needs
### nothing to free, and isn't recursive: locking it again from the holder blocks forever.
record ExclusiveLock
    state: U32

### A free mutex.
### :returns: A {ExclusiveLock} with state 0.
common routine ExclusiveLock.construct() -> Me
    m: Me = Me(state: 0)
    return m

### Takes the lock, waiting until it is free when someone else holds it: a thread sleeps, and a fiber parks a short
### while at a time so the other fibers of its thread go on (one of them may hold it).
routine @ExclusiveLock.lock() -> None
    local found: @U32 <- 0

    if me.state.atomic_compare_exchange_acquire_raw(expected: 0, new: 1, previous: found)
        return
    # Marks the lock contended. Whoever takes it from 0 this way holds it.
    while me.state.atomic_swap_acquire(2) != 0
        wait_while(at: me.state, expected: 2)
    then
        return

### Releases the lock, waking one sleeping thread if any waits. Only the holder may call it.
routine @ExclusiveLock.unlock() -> None
    previous: U32 = me.state.atomic_swap_release(0)
    if previous == 2
        wake_one(me.state)
        return
    return

### Takes the lock if it is free, without waiting.
### :returns: True when it took the lock.
routine @ExclusiveLock.try_lock() -> Bool
    local found: @U32 <- 0

    return me.state.atomic_compare_exchange_acquire_raw(expected: 0, new: 1, previous: found)
