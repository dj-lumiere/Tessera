# Tessera stdlib: ProcessManager, the environment, and leaving this process
#
# ProcessManager manages processes: it creates them and reaps them, and it ends this one. A process the program creates
# goes create_process, then its start, then exit_process, and ProcessManager.create_process does all of it for
# the caller: it starts a program (looked up on PATH as a shell would) with its arguments, waits for it to end, reaps
# it, and hands back how it ended and what it wrote. Its standard input is the null device unless the options say to share this
# process's. Its output and error are captured (read to the end, both at once, so a child that fills one while the
# other waits can't deadlock), shared, or discarded. Environment overrides are merged into this process's
# environment, so PATH and the rest stay. create_shell_process runs a command line through the platform shell (sh -c, or
# cmd.exe /c) for pipes and globs, at the cost of the shell's quoting.
#
# The per-OS halves are Process_posix.te (fork and execvp) and Process_windows.te (CreateProcessW).

module Standard/Os

### The exit status {set_exit_code} stored, which `start` returning ends the process with.
secret global EXIT_CODE: &S32 <- 0

### Processes: creating one and reaping it when it ends ({ProcessManager.create_process},
### {ProcessManager.create_shell_process}), and ending this one ({ProcessManager.exit_process}). Its routines are
### called on the type.
entity ProcessManager
    nothing

### An argument, the program, the directory, or a variable holds a NUL, or a variable's name holds a '='.
crashable InvalidArgumentError
    nothing

### Why a program couldn't start, or its output couldn't be captured: one of the crashables process routines throw.
variant ProcessError
    NotFoundError
    NotEnoughPermissionError
    InvalidArgumentError
    MemoryAllocationError
    IoError

### What the child's standard input is.
choice InputMode: U8
    NULL  # the null device: it reads end-of-file at once
    INHERIT  # this process's standard input

### What becomes of the child's standard output or error.
choice OutputMode: U8
    CAPTURE  # read into the ProcessOutput
    INHERIT  # this process's
    NULL  # discarded

### A program that ended by exiting.
@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Exited
    code: S32  # its exit code

### A program a signal stopped (POSIX only).
@derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
record Signaled
    signal: S32  # the signal that stopped it

### How a program ended.
variant ExitStatus
    Exited
    Signaled

### One environment variable for the child.
record EnvVar
    name: @[Byte]
    value: @[Byte]

### How {ProcessManager.create_process} starts a program: its working directory, environment overrides, and what its standard
### streams are. {ProcessOptions.default} is a good start.
record ProcessOptions
    directory: Maybe[@[Byte]]  # where it starts: None for this process's working directory
    env: @EnvVar  # env_count overrides of this process's environment
    env_count: U64
    stdin: InputMode
    stdout: OutputMode
    stderr: OutputMode

### What {ProcessManager.create_process} hands back. A captured stream is in memory from the memory manager, and dropping the output releases
### both. One not captured is empty and holds nothing.
entity ProcessOutput
    status: ExitStatus
    stdout: Memory[Byte]
    stderr: Memory[Byte]

### Makes the manager. It holds no values.
### :returns: The manager.
common routine ProcessManager.construct() -> Me
    return Me()

### Releases nothing: the manager holds no values.
routine @ProcessManager.destruct() -> None
    return

### Writes `A NUL in the program, an argument, the directory, or a variable, or a '=' in a variable's name.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine InvalidArgumentError.message_into[TWriter](out: @TWriter) -> None
needs TWriter: typename, Writer[TWriter]
    out.write("The program, an argument, the directory, or a variable holds a NUL, or a variable's name holds a '='.")
    return

### Makes a `ProcessOutput` from its fields.
### :param status: Its `status`.
### :param stdout: Its `stdout`.
### :param stderr: Its `stderr`.
### :returns: The new value.
common routine ProcessOutput.construct(status: ExitStatus, stdout: Memory[Byte],
    stderr: Memory[Byte]) -> Me
    return Me(status, stdout: steal stdout, stderr: steal stderr)

### Gives both captured streams back to the memory manager they came from.
@track_caller
routine @ProcessOutput.destruct() -> None
    drop me.stdout
    drop me.stderr
    return

### No directory and no overrides, the null device as input, and both output streams captured.
### :returns: The default options.
common routine ProcessOptions.default() -> Me
    return Me(directory: None(), env: .hollow(), env_count: 0, stdin: InputMode.NULL,
        stdout: OutputMode.CAPTURE, stderr: OutputMode.CAPTURE)

### The exit code, or for a program a signal stopped, 128 plus the signal (as a POSIX shell reports it).
### :returns: The code.
routine ExitStatus.code() -> S32
    when me
        is Exited as exited => return exited.code
        is Signaled as signaled => return signaled.signal +% 128

### Whether it exited with code 0.
### :returns: True for an exit with code 0, false for any other code or a signal.
routine ExitStatus.is_success() -> Bool
    when me
        is Exited as exited => return exited.code == 0
        is Signaled => return false

### Runs a command line through the platform shell (`/bin/sh -c` on Linux and macOS, `cmd.exe /c` on Windows) with
### {ProcessManager.create_process}, for pipes and globs at the cost of the shell's quoting.
### :param command: The command line.
### :param options: The directory, environment overrides, and standard streams.
### :param manager: The memory manager for the captured output and the working memory.
### :returns: The {ProcessOutput}, or a {ProcessError} when the shell couldn't start.
@expensive("starts a process")
failable common routine ProcessManager.create_shell_process(command: @[Byte],
    options: ProcessOptions, manager: @MemoryManager) -> ProcessOutput
    args: &Array[@[Byte], 2] <- [shell_flag(), command]

    when check Me.create_process(program: shell_program(), args: args.getview(), options, manager)

        is ProcessOutput as returned => return returned

### The platform shell {ProcessManager.create_shell_process} starts: `cmd.exe` on Windows, `/bin/sh` elsewhere.
### :returns: The program name.
@target(os: "windows")
secret routine shell_program() -> @[Byte]
    return "cmd.exe"

### The shell's flag that takes a command line: `/c` for cmd.exe, `-c` for sh.
### :returns: The flag.
@target(os: "windows")
secret routine shell_flag() -> @[Byte]
    return "/c"

### The platform shell {ProcessManager.create_shell_process} starts: `cmd.exe` on Windows, `/bin/sh` elsewhere.
### :returns: The program name.
@target(os: ("linux", "macos"))
secret routine shell_program() -> @[Byte]
    return "/bin/sh"

### The shell's flag that takes a command line: `/c` for cmd.exe, `-c` for sh.
### :returns: The flag.
@target(os: ("linux", "macos"))
secret routine shell_flag() -> @[Byte]
    return "-c"

### Sets the exit status the program ends with when `start` returns. The last store wins: it is one atomic value, so
### any thread may set it, and the builder's `main` reads it after `start` returned (a thread still running then may
### or may not get its store in). A crash ends the process with its own status, whatever was set.
### :param code: The exit status, 0 for success.
routine set_exit_code(code: S32) -> None
    EXIT_CODE.poke_atomic(code)
    return

### The exit status the program ends with when `start` returns: the last {set_exit_code}, 0 when nothing set one.
### The builder's `main` returns it after `start`.
### :returns: The status.
routine exit_code() -> S32
    return EXIT_CODE.peek_atomic()

### Ends this process with `status`, without returning. (Nothing is flushed but what the C library flushes.)
### :param status: The process's exit status.
@noreturn
common routine ProcessManager.exit_process(status: S32) -> None
    c_exit(status.to[CInt]())

# -- what both halves share ------------------------------------------------------------

### A captured stream as it grows, in memory from a memory manager: `storage` holds the capacity, `count` the bytes in
### use.
secret entity CaptureBuffer
    storage: Memory[Byte]
    count: U64
    failed: Bool  # an allocation failed: what came after was dropped

### Makes a `CaptureBuffer` from its fields.
### :param storage: Its `storage`.
### :param count: Its `count`.
### :param failed: Its `failed`.
### :returns: The new value.
secret common routine CaptureBuffer.construct(storage: Memory[Byte], count: U64, failed: Bool) -> Me
    return Me(storage: steal storage, count, failed)

### Gives the buffer's memory back.
secret routine @CaptureBuffer.destruct() -> None
    drop me.storage
    return

### An empty capture buffer that holds no memory yet. Its `failed` is read when the run ends: a capture that lost
### bytes makes the run fail with OutOfMemory instead of handing back a truncated stream.
### :returns: The buffer.
secret common routine CaptureBuffer.empty() -> Me
    return Me(storage: .hollow(), count: 0, failed: false)

### Appends `n` bytes, growing the buffer (to at least double, and at least 256 bytes). An allocation failure drops
### them and marks the buffer `failed`.
### :param chunk: The first byte to append.
### :param n: How many bytes to append.
### :param manager: The memory manager the buffer's memory comes from.
@reshaping
secret routine @CaptureBuffer.append(chunk: @Byte, n: U64, manager: @MemoryManager) -> None
    need: U64 = me.count.peek() + n
    capacity: U64 = me.storage.count.peek()

    if need > capacity
        doubled: U64 = capacity * 2

        bigger: U64 = doubled.max(need).max(256)
        if me.storage.data.peek().is_hollow()
            when check Memory[Byte].construct(count: bigger, manager: manager)
                is Memory[Byte] as memory =>
                    me.storage.replace(value: steal memory)
                    me.storage.getslot(me.count.peek()).copy(src: chunk, count: n)
                    next_count: U64 = me.count.peek() + n
                    next_count.poke_into(me.count)
                    return
                is MemoryAllocationError => nothing
        else
            resized: Check[None] = check me.storage.resize(bigger)
            when resized
                is None =>
                    me.storage.getslot(me.count.peek()).copy(src: chunk, count: n)
                    next_count: U64 = me.count.peek() + n
                    next_count.poke_into(me.count)
                    return
                is MemoryAllocationError => nothing
        me.failed.poke(true)
        return
    me.storage.getslot(me.count.peek()).copy(src: chunk, count: n)
    next_count: U64 = me.count.peek() + n
    next_count.poke_into(me.count)
    return

### What was captured, in memory the caller drops. The buffer is left empty.
### :returns: The captured bytes.
secret routine @CaptureBuffer.take_all() -> Memory[Byte]
    me.storage.keep_first(me.count.peek())
    me.count.poke(0)
    return me.storage.take()

### Whether a NUL is inside any text the child would get, or an override's name holds a '=': what create_process
### turns down with InvalidArgument before it allocates anything, so a later failure to allocate is OutOfMemory.
### :param program: The program to run.
### :param args: The arguments.
### :param options: The directory and environment overrides.
### :returns: True when the program, an argument, an override, or the directory can't be passed to the child.
secret routine has_nul(program: @[Byte], args: @[@[Byte]], options: ProcessOptions) -> Bool
    arg_count: U64 = args.count()

    if program.has("\0")
        return true
    each i in 0 til arg_count
        argument: @[Byte] = args[i]
        if argument.has("\0")
            return true
        continue

    each i in 0 til options.env_count
        v: EnvVar = options.env.stride(i).peek()
        if v.name.has("\0") or v.value.has("\0") or v.name.has("=")
            return true
        continue
    when options.directory
        is @[Byte] as d => return d.has("\0")
        is None => return false

### Whether `name`'s bytes equal the start of `entry` up to its '=' (a "NAME=VALUE" entry), ASCII letters in any case
### when `fold` is set.
### :param name: The variable name.
### :param entry: The "NAME=VALUE" entry.
### :param fold: True to compare ASCII letters without regard to case.
### :returns: True when `entry` is the variable `name`.
secret routine env_key_matches(name: @[Byte], entry: @[Byte], fold: Bool) -> Bool
    n: U64 = name.count()
    if not (entry.count() > n)
        return false
    if entry.byte_at(n) == 61
        each i in 0 til name.count()
            a: U8 = name.byte_at(i)
            b: U8 = entry.byte_at(i)
            if a == b or (fold and ascii_lower(a) == ascii_lower(b))
                continue
            return false
        return true
    return false

### The lowercase form of an ASCII uppercase letter, any other byte unchanged.
### :param c: The byte.
### :returns: `c` plus 32 for 'A' to 'Z', else `c`.
secret routine ascii_lower(c: U8) -> U8
    if 65 <= c <= 90
        return c + 32
    return c
