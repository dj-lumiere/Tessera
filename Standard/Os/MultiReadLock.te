# Tessera stdlib: MultiReadLock
#
# A lock that many readers hold at once, or one writer alone: for a place that several threads really do read and
# write. Writers come first: once a writer waits, a reader that comes later waits too, so a stream of readers can't
# keep a writer out forever. Two U32s: the readers holding it (with a bit for a writer holding it instead), and the
# writers waiting or holding. The last reader out wakes a waiting writer, and a writer going out wakes everyone who
# waits. A thread that waits sleeps, and a fiber parks a short while at a time so the other fibers of its thread go
# on. It starts free and needs nothing to free.

module Standard/Os

### The bit of `MultiReadLock.state` that a writer holding the lock sets.
secret preset WRITE_HELD: U32 = 0x80000000

### A lock that many readers hold at once, or one writer alone, and a writer that waits goes before the readers that
### come after it. It starts free, needs nothing to free, and isn't recursive.
record MultiReadLock
    ### The readers holding it, or WRITE_HELD while a writer does.
    state: U32
    ### The writers waiting for it or holding it.
    writers: U32

### A free lock.
### :returns: The lock.
routine MultiReadLock.construct() -> Me
    return Me(state: 0, writers: 0)

### Takes the lock for reading, waiting while a writer holds it or waits for it.
@target(os: not "none")
routine MultiReadLock.lock_read(me: @Me) -> None
    while true
        state2: U32 = me.state.peek_atomic()
        writers2: U32 = me.writers.peek_atomic()
        if writers2 != 0
            wait_while(at: me.writers, expected: writers2)
            continue
        else if state2 & WRITE_HELD != 0
            wait_while(at: me.state, expected: state2)
            continue
        else if me.try_add_reader(state2)
            return
        else
            continue

### Takes the lock for reading if no writer holds it or waits for it, without waiting.
### :returns: True when it took the lock.
routine MultiReadLock.try_lock_read(me: @Me) -> Bool
    while true
        state2: U32 = me.state.peek_atomic()
        if me.writers.peek_atomic() != 0 or state2 & WRITE_HELD != 0
            return false
        if me.try_add_reader(state2)
            return true
        else
            continue

### Lets go of the lock taken for reading. The last reader out wakes a waiting writer.
@target(os: not "none")
routine MultiReadLock.unlock_read(me: @Me) -> None
    before: U32 = me.state.atomic_fetch_sub_release(1)
    if not (before == 1 and me.writers.peek_atomic() != 0)
        return
    wake_all(me.state)
    return

### Takes the lock for writing, waiting until no one holds it. From the moment it waits, readers that come later wait
### behind it.
@target(os: not "none")
routine MultiReadLock.lock_write(me: @Me) -> None
    me.writers.atomic_fetch_add(1)

    while true
        state: U32 = me.state.peek_atomic()
        if state == 0
            if me.state.atomic_compare_exchange_acquire(expected: 0, new: WRITE_HELD).is_success()
                return
            else
                continue
        else
            wait_while(at: me.state, expected: state)
            continue

### Takes the lock for writing if no one holds it, without waiting.
### :returns: True when it took the lock.
@target(os: not "none")
routine MultiReadLock.try_lock_write(me: @Me) -> Bool
    me.writers.atomic_fetch_add(1)
    if me.state.atomic_compare_exchange_acquire(expected: 0, new: WRITE_HELD).is_success()
        return true
    # A reader that saw this writer for a moment waits on the count: it looks again.
    me.writers.atomic_fetch_sub(1)
    wake_all(me.writers)
    return false

### Lets go of the lock taken for writing, and wakes everyone who waits for it.
@target(os: not "none")
routine MultiReadLock.unlock_write(me: @Me) -> None
    me.state.poke_atomic_release(0)
    me.writers.atomic_fetch_sub_release(1)
    wake_all(me.state)
    wake_all(me.writers)
    return

### One more reader, if the state is still `state`.
### :param state: The state read before.
### :returns: True when the reader is in.
secret routine MultiReadLock.try_add_reader(me: @Me, state: U32) -> Bool
    return me.state.atomic_compare_exchange_acquire(expected: state, new: state + 1).is_success()
