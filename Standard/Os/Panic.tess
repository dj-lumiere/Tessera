// Tessera stdlib: the default panic handler
//
// Standard::Core's panic calls tessera_panic_handler, a link-time symbol. This
// is the hosted default: one line on stderr, then exit status 101.
//
//     tessera: runtime error: index out of bounds
//       at examples/grid.tess:12:9
//     tessera: runtime error: index out of bounds: row 7 of 5      (panic_msg)
//       at examples/grid.tess:12:9
//
// A program replaces it by exporting its own routine under the same name; a
// target without an operating system has no default, so a program for one
// exports a handler (halt, blink an LED, reset) or fails to link.

module Standard::Os

import Standard::Format

/// The hosted default panic handler, exported under the link-time name the core panic calls. It writes `tessera:
/// runtime error: ` with the code's description (the number too for a program's own code), the message when there is
/// one, and the source location on a second line to standard error, then exits with status 101. A program replaces it
/// by exporting its own routine under the same name.
/// :param code: The trap code that stopped the program.
/// :param message: Extra detail, empty when there is none.
/// :param place: Where the panic happened: file, line, and column (0 when only the line is known).
#[export("tessera_panic_handler"), noreturn, target(os: not "none")]
routine default_panic_handler(code: TrapCode, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        text : Bytes = code.description()
        Err.write("tessera: runtime error: {text}")
        raw    : U8   = bitcast<TrapCode, U8>(code)
        stdlib : Bool = raw.lt(64)
        branch stdlib
            ? message()
            : code(raw)

    // A program's own codes (64 and up) have no description, so the number is written too.
    block code(raw: U8)
        Err.write(" {raw}")
        jump message()

    block message()
        none : Bool = message.length.eq(0)
        branch none
            ? finish()
            : detail()

    block detail()
        Err.write(": {message}")
        jump finish()

    block finish()
        file : Bytes = place.file.load()
        line : U32   = place.line.load()
        Err.write("\n  at {file}:{line}")
        column : U32  = place.column.load()
        whole  : Bool = column.eq(0)
        branch whole
            ? done()
            : column(column)

    block column(column: U32)
        Err.write(":{column}")
        jump done()

    block done()
        Err.write("\n")
        c_exit(101)
