// Tessera stdlib: BigNat, fixed-capacity big naturals
//
// Exact arithmetic for float parsing and printing (FloatConvert.tess,
// Format.tess). Limbs are U64, least significant first, no heap. N is the
// capacity in limbs, so each use sizes its own: F64 parsing needs 72, F128
// printing 320, F128 parsing 864.

module Standard::Format

preset POW10_U64: @Array<U64, 20> <- { 1, 10, 100, 1000, 10000, 100000, 1000000, 10000000,
    100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,
    100000000000000, 1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000,
    10000000000000000000 }

/// A natural number in U64 limbs, least significant first. `count` limbs are
/// in use and the top one is nonzero (zero has count 0). Fixed capacity:
/// growing past N limbs crashes with Overflow.
record BigNat<N>
require N: USize
    limbs : Array<U64, N>
    count : USize

routine BigNat<N>.set(self: @Self, value: U64) -> Void
require N: USize
    block entry()
        self.limbs.setitem(0, value)
        self.count.store(value.ne(0).to<USize>())
        return()

routine BigNat<N>.set(self: @Self, value: U128) -> Void
require N: USize
    block entry()
        low  : U64 = value.to_wrap<U64>()
        high : U64 = value.shr(64).to<U64>()
        self.limbs.setitem(0, low)
        self.limbs.setitem(1, high)
        two  : Bool  = high.ne(0)
        one  : Bool  = low.ne(0)
        used : USize = two
            ? 2
            : one.to<USize>()
        self.count.store(used)
        return()

routine BigNat<N>.copy_from(self: @Self, other: @Self) -> Void
require N: USize
    block entry()
        value : Self = other.load()
        self.store(value)
        return()

routine BigNat<N>.is_zero(self: @Self) -> Bool
require N: USize
    block entry()
        count : USize = self.count.load()
        zero  : Bool  = count.eq(0)
        return(zero)

routine BigNat<N>.bit_length(self: @Self) -> USize
require N: USize
    block entry()
        count : USize = self.count.load()
        zero  : Bool  = count.eq(0)
        branch zero
            ? return(0)
            : count(count)

    block count(count: USize)
        top_at    : USize = count.sub(1)
        top       : U64   = self.limbs.getitem(top_at)
        full_bits : USize = top_at.mul(64).add(64)
        bits      : USize = full_bits.sub(top.leading_zeros().to<USize>())
        return(bits)

/// Appends limb as the new top limb.
#track_caller
routine BigNat<N>.push_limb(self: @Self, limb: U64) -> Void
require N: USize
    block entry()
        count : USize = self.count.load()
        room  : Bool  = count.lt(N)
        branch room
            ? store(count)
            : crash_overflow()

    block store(count: USize)
        self.limbs.setitem(count, limb)
        self.count.store(count.add(1))
        return()

/// Drops zero limbs from the top.
routine BigNat<N>.trim(self: @Self) -> Void
require N: USize
    block entry()
        count : USize = self.count.load()
        jump check(count)

    block check(count: USize)
        empty : Bool = count.eq(0)
        branch empty
            ? store(count)
            : look(count)

    block look(count: USize)
        at   : USize = count.sub(1)
        top  : U64   = self.limbs.getitem(at)
        zero : Bool  = top.eq(0)
        branch zero
            ? check(at)
            : store(count)

    block store(count: USize)
        self.count.store(count)
        return()

/// self = self × m + addend
routine BigNat<N>.mul_add(self: @Self, m: U64, addend: U64) -> Void
require N: USize
    block entry()
        count : USize = self.count.load()
        jump loop(0, addend.to<U128>(), count)

    block loop(i: USize, carry: U128, count: USize)
        done : Bool = i.ge(count)
        branch done
            ? spill(carry)
            : step(i, carry, count)

    // limb × m + carry < 2^128, so the sum can't overflow
    block step(i: USize, carry: U128, count: USize)
        limb    : U64  = self.limbs.getitem(i)
        product : U128 = limb.mul_wide(m).add(carry)
        self.limbs.setitem(i, product.to_wrap<U64>())
        jump loop(i.add(1), product.shr(64), count)

    block spill(carry: U128)
        high : U64  = carry.to<U64>()
        none : Bool = high.eq(0)
        branch none
            ? return()
            : grow(high)

    block grow(high: U64)
        self.push_limb(high)
        return()

/// self = self × 10^k
routine BigNat<N>.mul_pow10(self: @Self, k: USize) -> Void
require N: USize
    block entry()
        jump loop(k)

    block loop(left: USize)
        big_step : Bool = left.ge(19)
        branch big_step
            ? chunk(left)
            : last(left)

    block chunk(left: USize)
        self.mul_add(10000000000000000000, 0)  // 10^19
        jump loop(left.sub(19))

    block last(left: USize)
        factor : U64 = POW10_U64.getitem(left)
        self.mul_add(factor, 0)
        return()

/// self = self × 2^bits
#track_caller
routine BigNat<N>.shl(self: @Self, bits: USize) -> Void
require N: USize
    block entry()
        limb_shift : USize = bits.div(64)
        bit_shift  : U64   = bits.mod(64).to<U64>()
        count      : USize = self.count.load()
        whole      : Bool  = bit_shift.eq(0)
        branch whole
            ? move(limb_shift)
            : shift_bits(0, 0, count, limb_shift, bit_shift)

    block shift_bits(i: USize, carry: U64, count: USize, limb_shift: USize, bit_shift: U64)
        done : Bool = i.ge(count)
        branch done
            ? spill(carry, limb_shift)
            : shift_one(i, carry, count, limb_shift, bit_shift)

    block shift_one(i: USize, carry: U64, count: USize, limb_shift: USize, bit_shift: U64)
        limb : U64 = self.limbs.getitem(i)
        self.limbs.setitem(i, limb.shl(bit_shift).bitor(carry))
        out : U64 = limb.shr(64.sub(bit_shift))
        jump shift_bits(i.add(1), out, count, limb_shift, bit_shift)

    block spill(carry: U64, limb_shift: USize)
        none : Bool = carry.eq(0)
        branch none
            ? move(limb_shift)
            : grow(carry, limb_shift)

    block grow(carry: U64, limb_shift: USize)
        self.push_limb(carry)
        jump move(limb_shift)

    // Whole limbs move up by limb_shift, top first, and zeros fill the bottom.
    block move(limb_shift: USize)
        count     : USize = self.count.load()
        nothing   : Bool  = limb_shift.eq(0).bitor(count.eq(0))
        new_count : USize = count.add(limb_shift)
        room      : Bool  = new_count.le(N)
        when
            nothing -> return()
            room    -> move_loop(count, limb_shift, new_count)
            else    -> crash_overflow()

    // left limbs are still to move. The next one down is left - 1
    block move_loop(left: USize, limb_shift: USize, new_count: USize)
        done : Bool = left.eq(0)
        branch done
            ? zero_fill(0, limb_shift, new_count)
            : move_one(left.sub(1), limb_shift, new_count)

    block move_one(i: USize, limb_shift: USize, new_count: USize)
        limb : U64 = self.limbs.getitem(i)
        self.limbs.setitem(i.add(limb_shift), limb)
        jump move_loop(i, limb_shift, new_count)

    block zero_fill(i: USize, limb_shift: USize, new_count: USize)
        done : Bool = i.ge(limb_shift)
        branch done
            ? finish(new_count)
            : zero_one(i, limb_shift, new_count)

    block zero_one(i: USize, limb_shift: USize, new_count: USize)
        self.limbs.setitem(i, 0)
        jump zero_fill(i.add(1), limb_shift, new_count)

    block finish(new_count: USize)
        self.count.store(new_count)
        return()

/// self = self / 2, rounding down
routine BigNat<N>.shr1(self: @Self) -> Void
require N: USize
    block entry()
        count : USize = self.count.load()
        jump loop(count, 0)

    // left limbs are still to shift, top first
    block loop(left: USize, carry: U64)
        done : Bool = left.eq(0)
        branch done
            ? finish()
            : step(left.sub(1), carry)

    block step(i: USize, carry: U64)
        limb : U64 = self.limbs.getitem(i)
        self.limbs.setitem(i, limb.shr(1).bitor(carry.shl(63)))
        jump loop(i, limb.bitand(1))

    block finish()
        self.trim()
        return()

/// -1, 0, or 1 as self is below, equal to, or above other
routine BigNat<N>.compare(self: @Self, other: @Self) -> S32
require N: USize
    block entry()
        a_count : USize = self.count.load()
        b_count : USize = other.count.load()
        shorter : Bool  = a_count.lt(b_count)
        longer  : Bool  = a_count.gt(b_count)
        when
            shorter -> return(-1)
            longer  -> return(1)
            else    -> loop(a_count)

    // left limbs are still to compare, top first
    block loop(left: USize)
        done : Bool = left.eq(0)
        branch done
            ? return(0)
            : step(left.sub(1))

    block step(i: USize)
        a     : U64  = self.limbs.getitem(i)
        b     : U64  = other.limbs.getitem(i)
        below : Bool = a.lt(b)
        above : Bool = a.gt(b)
        when
            below -> return(-1)
            above -> return(1)
            else  -> loop(i)

/// self = self - other, which must not be larger
routine BigNat<N>.sub(self: @Self, other: @Self) -> Void
require N: USize
    block entry()
        a_count : USize = self.count.load()
        b_count : USize = other.count.load()
        jump loop(0, 0, a_count, b_count)

    block loop(i: USize, borrow: U64, a_count: USize, b_count: USize)
        done : Bool = i.ge(a_count)
        branch done
            ? finish()
            : step(i, borrow, a_count, b_count)

    block step(i: USize, borrow: U64, a_count: USize, b_count: USize)
        a      : U64  = self.limbs.getitem(i)
        b_limb : U64  = other.limbs.getitem(i)
        in_b   : Bool = i.lt(b_count)
        b      : U64  = in_b
            ? b_limb
            : 0
        self.limbs.setitem(i, a.sub_wrap(b).sub_wrap(borrow))
        // a - b - borrow goes negative when a < b, or a == b with a borrow in
        under    : Bool = a.lt(b)
        even_out : Bool = a.eq(b).bitand(borrow.eq(1))
        next     : U64  = under.bitor(even_out).to<U64>()
        jump loop(i.add(1), next, a_count, b_count)

    block finish()
        self.trim()
        return()

/// For a quotient below 2^bits (at most 127): returns floor(self / divisor) and leaves the
/// remainder in self. scratch holds the shifted divisor.
routine BigNat<N>.div_small(self: @Self, divisor: @Self, scratch: @Self, bits: USize) -> U128
require N: USize
    block entry()
        scratch.copy_from(divisor)
        scratch.shl(bits.sub(1))
        jump loop(bits, 0)

    // left quotient bits are still to find, top first
    block loop(left: USize, q: U128)
        done : Bool = left.eq(0)
        branch done
            ? return(q)
            : try_bit(left.sub(1), q)

    block try_bit(i: USize, q: U128)
        fits : Bool = self.compare(scratch).ge(0)
        branch fits
            ? take(i, q)
            : next(i, q)

    block take(i: USize, q: U128)
        self.sub(scratch)
        jump next(i, q.bitor(1.shl(i.to<U128>())))

    block next(i: USize, q: U128)
        scratch.shr1()
        jump loop(i, q)

/// self = self + other
routine BigNat<N>.add(self: @Self, other: @Self) -> Void
require N: USize
    block entry()
        a_count : USize = self.count.load()
        b_count : USize = other.count.load()
        count   : USize = a_count.max(b_count)
        jump loop(0, 0, a_count, b_count, count)

    block loop(i: USize, carry: U64, a_count: USize, b_count: USize, count: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish(carry, count)
            : step(i, carry, a_count, b_count, count)

    block step(i: USize, carry: U64, a_count: USize, b_count: USize, count: USize)
        a_limb : U64 = self.limbs.getitem(i)
        b_limb : U64 = other.limbs.getitem(i)
        a      : U64 = i.lt(a_count)
            ? a_limb
            : 0
        b : U64 = i.lt(b_count)
            ? b_limb
            : 0
        limb_sum : U128 = a.to<U128>().add(b.to<U128>())
        sum      : U128 = limb_sum.add(carry.to<U128>())
        self.limbs.setitem(i, sum.to_wrap<U64>())
        jump loop(i.add(1), sum.shr(64).to<U64>(), a_count, b_count, count)

    block finish(carry: U64, count: USize)
        self.count.store(count)
        none : Bool = carry.eq(0)
        branch none
            ? return()
            : grow(carry)

    block grow(carry: U64)
        self.push_limb(carry)
        return()

/// self = floor(self / d), with d > 0. Returns the remainder
routine BigNat<N>.div_limb(self: @Self, d: U64) -> U64
require N: USize
    block entry()
        count   : USize = self.count.load()
        divisor : U128  = d.to<U128>()
        jump loop(count, 0, divisor)

    // left limbs are still to divide, top first
    block loop(left: USize, rem: U128, divisor: U128)
        done : Bool = left.eq(0)
        branch done
            ? finish(rem)
            : step(left.sub(1), rem, divisor)

    block step(i: USize, rem: U128, divisor: U128)
        limb : U64  = self.limbs.getitem(i)
        cur  : U128 = rem.shl(64).bitor(limb.to<U128>())
        self.limbs.setitem(i, cur.div(divisor).to<U64>())
        jump loop(i, cur.mod(divisor), divisor)

    block finish(rem: U128)
        self.trim()
        return(rem.to<U64>())

/// Bit i of self (0 is the lowest).
routine BigNat<N>.bit(self: @Self, i: USize) -> Bool
require N: USize
    block entry()
        count  : USize = self.count.load()
        at     : USize = i.div(64)
        inside : Bool  = at.lt(count)
        branch inside
            ? read(at)
            : return(false)

    block read(at: USize)
        limb      : U64  = self.limbs.getitem(at)
        bit_value : U64  = limb.shr(i.mod(64).to<U64>()).bitand(1)
        set       : Bool = bit_value.eq(1)
        return(set)

/// Whether any bit below bit n is set.
routine BigNat<N>.any_below(self: @Self, n: USize) -> Bool
require N: USize
    block entry()
        count : USize = self.count.load()
        whole : USize = n.div(64).min(count)
        jump loop(0, whole, count)

    block loop(i: USize, whole: USize, count: USize)
        done : Bool = i.ge(whole)
        branch done
            ? partial(whole, count)
            : step(i, whole, count)

    block step(i: USize, whole: USize, count: USize)
        limb : U64  = self.limbs.getitem(i)
        set  : Bool = limb.ne(0)
        branch set
            ? return(true)
            : loop(i.add(1), whole, count)

    block partial(whole: USize, count: USize)
        inside : Bool = whole.lt(count)
        branch inside
            ? mask(whole)
            : return(false)

    block mask(at: USize)
        limb : U64  = self.limbs.getitem(at)
        low  : U64  = 1.shl(n.mod(64).to<U64>()).sub(1)
        set  : Bool = limb.bitand(low).ne(0)
        return(set)

/// self = self / 2^bits (bits > 0), rounded to nearest, ties to even
routine BigNat<N>.shr_round_even(self: @Self, bits: USize) -> Void
require N: USize
    block entry()
        half_at    : USize = bits.sub(1)
        half       : Bool  = self.bit(half_at)
        sticky     : Bool  = self.any_below(half_at)
        limb_shift : USize = bits.div(64)
        bit_shift  : U64   = bits.mod(64).to<U64>()
        count      : USize = self.count.load()
        kept       : USize = count.sub_clamp(limb_shift)
        jump loop(0, kept, count, limb_shift, bit_shift, half, sticky)

    // limb i takes the bits of limbs i + shift and i + shift + 1
    block loop(i: USize, kept: USize, count: USize, limb_shift: USize, bit_shift: U64, half: Bool,
        sticky: Bool)
        done : Bool = i.ge(kept)
        branch done
            ? shifted(kept, half, sticky)
            : step(i, kept, count, limb_shift, bit_shift, half, sticky)

    block step(i: USize, kept: USize, count: USize, limb_shift: USize, bit_shift: U64, half: Bool,
        sticky: Bool)
        from      : USize = i.add(limb_shift)
        low       : U64   = self.limbs.getitem(from)
        next_at   : USize = from.add(1)
        has_next  : Bool  = next_at.lt(count)
        next_limb : U64   = self.limbs.getitem(next_at.min(count.sub(1)))
        next      : U64   = has_next
            ? next_limb
            : 0
        // two shifts, so a zero bit shift never shifts by 64
        high : U64 = next.shl(63.sub(bit_shift)).shl(1)
        self.limbs.setitem(i, low.shr(bit_shift).bitor(high))
        jump loop(i.add(1), kept, count, limb_shift, bit_shift, half, sticky)

    block shifted(kept: USize, half: Bool, sticky: Bool)
        self.count.store(kept)
        self.trim()
        odd   : Bool = self.bit(0)
        round : Bool = half.bitand(sticky.bitor(odd))
        branch round
            ? bump()
            : return()

    block bump()
        self.mul_add(1, 1)
        return()
