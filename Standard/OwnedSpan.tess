// Tessera stdlib: OwnedSpan<T>, values on the heap that are yours
//
// An OwnedSpan is an address, a count, and the allocator the memory came from. It is how heap memory reaches user
// code: what allocates hands back an OwnedSpan (or a type built on one), and destruct() gives the memory back to the
// same allocator. Reading and writing go through the same words as a Span (at, getitem, setitem, getspan), and
// to<Span<T>>() lends the values to code that only reads or writes them.
//
// Nothing enforces the ownership: it is a convention the type names. Copying an OwnedSpan copies the handle, not the
// memory, so exactly one copy is destructed.

module Standard::Alloc

/// `count` values of `T` on the heap, owned: it keeps the allocator it came from and gives the memory back with
/// `destruct()`. Unlike `List<T>` it doesn't grow by itself (`resize` reallocates on request), and unlike
/// `Array<T, N>` its count is chosen at run time. The values start uninitialized.
/// :typeparam T: The element type.
record OwnedSpan<T>
conform Destructible<OwnedSpan<T>>
require T: typename
    data  : @T
    count : USize
    alloc : @Allocator

/// `count` uninitialized values of `T` from `alloc`. A count of 0 allocates nothing.
/// :param count: The number of values.
/// :param alloc: The allocator the memory comes from and goes back to.
/// :returns: The owned span.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {OwnedSpan<T>.construct_result}.
#track_caller
routine OwnedSpan<T>.construct(count: USize, alloc: @Allocator) -> Self
require T: typename
    block entry()
        made : Result<Self, AllocFailed> = Self.construct_result(count, alloc)
        when made
            .Success(owned) -> return(owned)
            .Failure        -> crash_allocation()

/// `construct`, returning a Failure instead of crashing when the allocator fails.
routine OwnedSpan<T>.construct_result(count: USize, alloc: @Allocator) -> Result<Self, AllocFailed>
require T: typename
    block entry()
        nothing : Bool = count.eq(0)
        branch nothing
            ? empty()
            : continue
        data   : @T   = allocate<T>(alloc, count)
        failed : Bool = data.is_null()
        branch failed
            ? return(.Failure(AllocFailed {}))
            : continue
        owned : Self = Self { data: data, count: count, alloc: alloc }
        return(.Success(owned))

    block empty()
        owned : Self = Self { data: null, count: 0, alloc: alloc }
        return(.Success(owned))

// -- reading ------------------------------------------------------------------------------------------------------

/// The number of values.
routine OwnedSpan<T>.count(self: Self) -> USize
require T: typename
    block entry()
        count : USize = self.count
        return(count)

/// The number of values.
routine OwnedSpan<T>.count(self: @Self) -> USize
require T: typename
    block entry()
        count : USize = self.count.load()
        return(count)

/// The values, borrowed: valid until `destruct()` or `resize`.
routine OwnedSpan<T>.to<Span<T>>(self: Self) -> Span<T>
require T: typename
    block entry()
        span : Span<T> = Span<T>.construct(self.data, self.count)
        return(span)

/// The values, borrowed: valid until `destruct()` or `resize`.
routine OwnedSpan<T>.to<Span<T>>(self: @Self) -> Span<T>
require T: typename
    block entry()
        span : Span<T> = self.load().to<Span<T>>()
        return(span)

/// The address of the first value.
routine OwnedSpan<T>.to<@T>(self: Self) -> @T
require T: typename
    block entry()
        data : @T = self.data
        return(data)

/// The address of the first value.
routine OwnedSpan<T>.to<@T>(self: @Self) -> @T
require T: typename
    block entry()
        data : @T = self.data.load()
        return(data)

/// The address of the value at `index`, checked against the count. Everything else is `@T`'s own.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine OwnedSpan<T>.at(self: Self, index: USize) -> @T
require T: typename
    block entry()
        place : @T = self.to<Span<T>>().at(index)
        return(place)

/// The address of the value at `index`, checked against the count. Everything else is `@T`'s own.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine OwnedSpan<T>.at(self: @Self, index: USize) -> @T
require T: typename
    block entry()
        place : @T = self.to<Span<T>>().at(index)
        return(place)

/// The value at `index`, checked.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`. See {OwnedSpan<T>.getitem_checked}.
#track_caller
routine OwnedSpan<T>.getitem(self: Self, index: USize) -> T
require T: typename
    block entry()
        value : T = self.to<Span<T>>().getitem(index)
        return(value)

/// The value at `index`, checked.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`. See {OwnedSpan<T>.getitem_checked}.
#track_caller
routine OwnedSpan<T>.getitem(self: @Self, index: USize) -> T
require T: typename
    block entry()
        value : T = self.to<Span<T>>().getitem(index)
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
routine OwnedSpan<T>.getitem_checked(self: Self, index: USize) -> Option<T>
require T: typename
    block entry()
        value : Option<T> = self.to<Span<T>>().getitem_checked(index)
        return(value)

/// `getitem`, returning Absent instead of crashing on an index past the end.
routine OwnedSpan<T>.getitem_checked(self: @Self, index: USize) -> Option<T>
require T: typename
    block entry()
        value : Option<T> = self.to<Span<T>>().getitem_checked(index)
        return(value)

/// Writes `value` at `index`, checked.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine OwnedSpan<T>.setitem(self: Self, index: USize, value: T) -> Void
require T: typename
    block entry()
        self.to<Span<T>>().setitem(index, value)
        return()

/// Writes `value` at `index`, checked.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine OwnedSpan<T>.setitem(self: @Self, index: USize, value: T) -> Void
require T: typename
    block entry()
        self.to<Span<T>>().setitem(index, value)
        return()

/// The `count` values from `start`, borrowed, checked against the count.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine OwnedSpan<T>.getspan(self: Self, start: USize, count: USize) -> Span<T>
require T: typename
    block entry()
        part : Span<T> = self.to<Span<T>>().getspan(start, count)
        return(part)

/// The `count` values from `start`, borrowed, checked against the count.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine OwnedSpan<T>.getspan(self: @Self, start: USize, count: USize) -> Span<T>
require T: typename
    block entry()
        part : Span<T> = self.to<Span<T>>().getspan(start, count)
        return(part)

// -- changing the memory ------------------------------------------------------------------------------------------

/// Reallocates to hold `count` values, keeping the first ones (as many as both counts allow). The memory may move,
/// so addresses and spans taken before are stale. A count of 0 gives the memory back and keeps the allocator.
/// :param count: The new number of values.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {OwnedSpan<T>.resize_result}.
#track_caller
routine OwnedSpan<T>.resize(self: @Self, count: USize) -> Void
require T: typename
    block entry()
        resized : Result<Unit, AllocFailed> = self.resize_result(count)
        when resized
            .Success -> return()
            .Failure -> crash_allocation()

/// `resize`, returning a Failure instead of crashing when the allocator fails. The span is unchanged then.
routine OwnedSpan<T>.resize_result(self: @Self, count: USize) -> Result<Unit, AllocFailed>
require T: typename
    block entry()
        nothing : Bool = count.eq(0)
        branch nothing
            ? emptied()
            : continue
        alloc  : @Allocator = self.alloc.load()
        data   : @T         = reallocate<T>(alloc, self.data.load(), count)
        failed : Bool       = data.is_null()
        branch failed
            ? return(.Failure(AllocFailed {}))
            : continue
        self.data.store(data)
        self.count.store(count)
        return(.Success(Unit.value()))

    block emptied()
        self.destruct()
        return(.Success(Unit.value()))

/// Gives the memory back to the allocator it came from and leaves the span empty (no values, the same allocator),
/// so it can be resized or destructed again. The values themselves are not destructed: see `destruct_all`.
routine OwnedSpan<T>.destruct(self: @Self) -> Void
require T: typename
    block entry()
        data  : @T   = self.data.load()
        empty : Bool = data.is_null()
        branch empty
            ? reset()
            : continue
        deallocate<T>(self.alloc.load(), data)
        jump reset()

    block reset()
        self.data.store(null)
        self.count.store(0)
        return()

/// Destructs every value, then gives the memory back: for values that own something, such as lists. Every value
/// must be initialized. Values that only borrow must not be destructed this way.
routine OwnedSpan<T>.destruct_all(self: @Self) -> Void
require T: typename, Destructible<T>
    block entry()
        first : @T    = self.data.load()
        count : USize = self.count.load()
        jump each(first, count, 0)

    block each(first: @T, count: USize, i: USize)
        done : Bool = i.ge(count)
        branch done
            ? finish()
            : continue
        first.stride(i).destruct()
        jump each(first, count, i.add(1))

    block finish()
        self.destruct()
        return()

// -- text ---------------------------------------------------------------------------------------------------------

/// The bytes as text, borrowed: valid until `destruct()` or `resize`.
routine OwnedSpan<Byte>.to<Bytes>(self: Self) -> Bytes
    block entry()
        text : Bytes = Bytes.from_ptr(self.data, self.count)
        return(text)

/// The bytes as text, borrowed: valid until `destruct()` or `resize`.
routine OwnedSpan<Byte>.to<Bytes>(self: @Self) -> Bytes
    block entry()
        text : Bytes = self.load().to<Bytes>()
        return(text)
