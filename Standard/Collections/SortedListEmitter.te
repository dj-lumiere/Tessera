# Tessera stdlib collection: SortedListEmitter[T]
#
# In-order emitter over SortedList[T]. Yields elements from index 0 to
# count-1. It keeps the path from the root to the current leaf on an inline
# stack, so a full traversal is O(n) and the emitter allocates nothing.
#
# Satisfies concept SlotEmitter[SortedListEmitter[T], T] (and so Emitter).

module Collections

### Every internal node has at least two children, so 2^64 elements fit in 64 levels.
secret preset SORTED_LIST_ITER_DEPTH: U64 = 64

### `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the child being walked (internal) or
### the next value to yield (leaf).
record SortedListEmitter[T]
obeys SlotEmitter[SortedListEmitter[T], T]
needs T obeys Comparable
    nodes: Items[@SortedListNode[T], SORTED_LIST_ITER_DEPTH]
    indices: Items[U64, SORTED_LIST_ITER_DEPTH]
    depth: U64

### Creates an emitter positioned before the smallest element, descending to the leftmost leaf.
### :param list: The sorted list to walk.
### :returns: A new emitter, already positioned when the list is not empty.
common routine SortedListEmitter[T].construct(list: @SortedList[T]) -> Me
    lateinit emitter: &Me

    root_or_none: @SortedListNode[T]? = list.root.peek()
    empty: Bool = root_or_none.is_absent()
    emitter.depth.poke(0)
    if not empty
        emitter.push_leftmost(root_or_none.unwrap())
    first: Me = emitter.load()
    return first

### An emitter over the list, at its smallest element: `e: &SortedListEmitter[T] <- list.emitter()`, then `for x in e`.
### :returns: A new {SortedListEmitter[T]} over `me`.
routine @SortedList[T].emitter() -> SortedListEmitter[T]
    emitter: SortedListEmitter[T] = SortedListEmitter[T].construct(me)
    return emitter

### Pushes node and the first child of each level below it, down to a leaf.
### :param node: The node to start from.
secret routine @SortedListEmitter[T].push_leftmost(node: @SortedListNode[T]) -> None
    loop with current: @SortedListNode[T] = node
        depth2: U64 = me.depth.peek()
        leaf2: Bool = current.leaf.peek()
        me.nodes[depth2] = current
        me.indices[depth2] = 0
        me.depth.poke(depth2 + 1)
        if leaf2
            return
        continue with current: current.children[0]

### Hands out the next element's slot and advances the emitter.
### :returns: The next element's address, smallest first.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @SortedListEmitter[T].next() -> @T
    loop
        depth2: U64 = me.depth.peek()
        if depth2 == 0
            break
        level: U64 = depth2 - 1
        node: @SortedListNode[T] = me.nodes[level]
        index: U64 = me.indices[level]
        if node.leaf.peek()
            count: U64 = node.count.peek()
            if index < count
                me.indices[level] = index + 1
                at: @T = node.values.getslot(index)
                return at
        else
            # the child at `indices[level]` is done, so walk the next one, if there is one
            index2: U64 = index + 1
            count: U64 = node.count.peek()
            if index2 < count
                me.indices[level] = index2
                me.push_leftmost(node.children[index2])
                continue
        me.depth.poke(level)
        continue
    throw AbsentValueError()

### Yields the next element and advances the emitter.
### :returns: The next element, smallest first.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @SortedListEmitter[T].emit() -> T
    slot: @T = when check me.next()
        is @T as at => at
    return slot.peek()
