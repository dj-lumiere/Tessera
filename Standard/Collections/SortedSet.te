# Tessera stdlib collection: SortedSet[T]
#
# Ordered set with its own order-statistic B-tree node and fixed node key
# capacity of SORTED_SET_NODE_KEYS. The memory manager is stored in SortedSet. Node helpers
# still receive it as a parameter.

module Collections

secret preset SORTED_SET_NODE_KEYS: U64 = 7
secret preset SORTED_SET_NODE_CHILDREN: U64 = SORTED_SET_NODE_KEYS.add(1)
secret preset SORTED_SET_NODE_MIN_KEYS: U64 = SORTED_SET_NODE_KEYS.add(1).div_trunc(2)

### One node of a {SortedSet[T]} B-tree: up to `SORTED_SET_NODE_KEYS` keys inline, and for internal nodes the child pointers between them. `subtree_count` is the total keys in the subtree. It is an entity, so an entity element can live in it: the set makes and frees nodes, and its keys move in and out with steal.
### :typeparam T: The element type.
secret entity SortedSetNode[T]
needs T: typename, Comparable[T]
    leaf: Bool
    count: U64
    subtree_count: U64
    keys: Array[T, SORTED_SET_NODE_KEYS]
    children: Array[@SortedSetNode[T], SORTED_SET_NODE_CHILDREN]

### A set kept in sorted order, stored as an order-statistic B-tree. Elements are unique, lookup and insertion are `O(log n)`, and iteration is in ascending order.
### :typeparam T: The element type, ordered by its `Comparable` conformance.
entity SortedSet[T]
obeys Destructible[SortedSet[T]]
obeys Representable[SortedSet[T]] when T: typename, Diagnosable[T]
obeys Diagnosable[SortedSet[T]] when T: typename, Diagnosable[T]
obeys Equatable[SortedSet[T]] when T: typename
needs T: typename, Comparable[T]
    root: @SortedSetNode[T]
    count: U64
    manager: @MemoryManager

### Releases nothing: the set ends a node's keys and frees the node itself (`free_recursive`).
routine @SortedSetNode[T].destruct() -> None
needs T: typename
    return

### Creates an empty SortedSet that draws its storage from `manager`. Nothing is allocated until the first insertion.
### :param manager: The memory manager the set stores and later frees its memory with.
### :returns: A new empty SortedSet.
common routine SortedSet[T].construct(manager: @MemoryManager) -> Me
needs T: typename
    return Me(root: .hollow(), count: 0, manager: manager)

### A SortedSet of the values of an array, drawing its storage from `manager`. The array is taken over: its values go
### into the sorted set, entity values too, a value equal to an earlier one ending there.
### :typeparam COUNT: The number of values.
### :param values: The values, taken over.
### :param manager: The memory manager the sorted set stores and later gives its memory back with.
### :returns: The sorted set.
### :throws: Crashes with `OutOfMemoryError` when the memory manager has no memory to give.
@track_caller
@expensive("borrows memory")
common routine SortedSet[T].of[COUNT](values: Array[T, COUNT], manager: @MemoryManager) -> Me
needs T: typename, COUNT: U64
    made: &Me <- Me.construct(manager)
    items: &List[T] <- List[T].of(values: steal values, manager: manager)

    view: @[T] = items.getview()
    each i: U64 in 0 til COUNT
        drop made.add(steal view.getslot(i))
    then
        # every value went into the sorted set: the list's places are hollow
        drop items
        return made

### The number of elements currently stored.
### :returns: The count of elements, `0` when the set is empty.
routine @SortedSet[T].count() -> U64
needs T: typename
    count: U64 = me.count.peek()
    return count

### Whether the set holds no elements.
### :returns: `true` when the count is `0`.
routine @SortedSet[T].is_empty() -> Bool
needs T: typename
    count: U64 = me.count.peek()
    return count == 0

### A new empty node from `manager`.
### :param leaf: Whether the node is a leaf.
### :param manager: The memory manager to take the node from.
### :returns: The node, or null when the memory manager fails.
common routine SortedSetNode[T].construct(leaf: Bool, manager: @MemoryManager) -> @Me
needs T: typename
    node: @Me = allocate[Me](count: 1, manager)

    if node.is_hollow()
        return node
    node.leaf.poke(leaf)
    node.count.poke(0)
    node.subtree_count.poke(0)
    return node

### The number of keys in the subtree below this node.
### :returns: The node's subtree count, or `0` for a null node.
routine @SortedSetNode[T].subtree_count() -> U64
needs T: typename
    if me.is_hollow()
        return 0
    count: U64 = me.subtree_count.peek()
    return count

### Recomputes this node's subtree count from its own keys and its children's counts. Call it after the node's contents change.
routine @SortedSetNode[T].recount() -> None
needs T: typename
    leaf: Bool = me.leaf.peek()
    count: U64 = me.count.peek()
    sum: &U64 <- .hollow()

    if leaf
        me.subtree_count.poke(count)
        return
    0.poke_into(sum)

    each i in 0 to count
        child: @Me = me.children[i]
        child_count: U64 = child.subtree_count()
        with_child: U64 = sum.load() + child_count
        has_key: Bool = i < count
        next_sum: U64 = when
            has_key => with_child + 1
            else => with_child
        next_sum.poke_into(sum)
    me.subtree_count.poke(sum.load())
    return

### Finds where the key at `key` sits among this node's keys, compared through their places.
### :param key: The key to locate.
### :returns: The index of the first key not less than `key`, or the key count when every key is smaller. It is also the child to descend into.
routine @SortedSetNode[T].find_index(key: @T) -> U64
needs T: typename
    until i >= me.count.peek() with i: U64 = 0
        cmp: S32 = key.compare(me.keys.getslot(i))
        if cmp <= 0
            return i
        continue with i: i + 1
    then
        return i

### Whether two sets hold the same elements. Both are sorted, so comparing the elements in order gives set equality
### without a `contains` lookup per element.
### :param other: The set to compare with.
### :returns: True when the counts match and every element pair is equal.
routine @SortedSet[T].eq(other: @Me) -> Bool
needs T: typename
    return me.eq_at(other)

### `eq`, through pointers to the two sets.
### :param other: The set to compare with.
### :returns: True when the counts match and every element pair is equal.
secret routine @SortedSet[T].eq_at(other: @Me) -> Bool
needs T: typename
    a: &SortedSetEmitter[T] <- .hollow()
    b: &SortedSetEmitter[T] <- .hollow()

    la: U64 = me.count.peek()
    lb: U64 = other.count.peek()
    if not (la == lb)
        return false
    a_val: SortedSetEmitter[T] = .construct(me)
    b_val: SortedSetEmitter[T] = .construct(other)
    a.store(a_val)
    b.store(b_val)

    # both have the same count, so both run out together
    loop
        x: Maybe[@T] = try a.next()
        y: Maybe[@T] = try b.next()
        when x
            is @T as x_item =>
                cmp: S32 = x_item.compare(y.unwrap())
                if cmp == 0
                    continue
                return false
            is None => return true

### Whether an element equal to the one at `key` is in the set, read through its place.
### :param key: The element to look for.
### :returns: `true` when an equal element is present.
routine @SortedSet[T].has(key: @T) -> Bool
needs T: typename
    root: @SortedSetNode[T] = me.root.peek()
    if root.is_hollow()
        return false
    loop with node: @SortedSetNode[T] = root
        i: U64 = node.find_index(key)
        count: U64 = node.count.peek()
        if i < count
            cmp: S32 = key.compare(node.keys.getslot(i))
            if cmp == 0
                return true
        if node.leaf.peek()
            return false
        continue with node: node.children[i]

### Whether an element equal to `key` is in the set.
### :param key: The element to look for.
### :returns: `true` when an equal element is present.
routine @SortedSet[T].has(key: T) -> Bool
needs T: typename
    probe: &T <- steal key

    there: Bool = me.has(probe)

    drop probe
    return there

### Whether the one at `key` is not there: the opposite of `has`.
### :param key: The value to look for.
### :returns: `true` when `has` would be `false`.
routine @SortedSet[T].lacks(key: @T) -> Bool
needs T: typename
    there: Bool = me.has(key)
    return not there

### Whether `key` is not there: the opposite of `has`.
### :param key: The value to look for.
### :returns: `true` when `has` would be `false`.
routine @SortedSet[T].lacks(key: T) -> Bool
needs T: typename
    there: Bool = me.has(steal key)
    return not there

### The `rank`-th smallest element (0 is the smallest).
### :param rank: The zero-based rank.
### :returns: A copy of the element.
### :throws: Crashes with `IndexOutOfBoundsError` when `rank >= count`.
@track_caller
routine @SortedSet[T].get_by_rank(rank: U64) -> T
needs T: typename
    count: U64 = me.count.peek()
    if rank >= count
        throw IndexOutOfBoundsError(index: rank, count)

    loop with node: @SortedSetNode[T] = me.root.peek(), remaining: U64 = rank, i: U64 = 0
        node_count: U64 = node.count.peek()
        is_leaf: Bool = node.leaf.peek()
        if i >= node_count
            if is_leaf
                throw LogicBreachedError()
            continue with node: node.children[i], remaining: remaining, i: 0
        if is_leaf
            if remaining == i
                key: T = node.keys[i]
                return key
            continue with node: node, remaining: remaining, i: i + 1
        child: @SortedSetNode[T] = node.children[i]
        child_count: U64 = child.subtree_count()
        if remaining < child_count
            continue with node: child, remaining: remaining, i: 0
        after_child: U64 = remaining - child_count
        if after_child == 0
            key: T = node.keys[i]
            return key
        continue with node: node, remaining: after_child - 1, i: i + 1

### Splits the full child at `index` around its middle: the middle element moves up into this node and the upper
### half into a new right sibling.
### :param index: The index of the full child.
### :param manager: The memory manager for the new node.
### :returns: True when it split, false when the memory manager failed (before anything moved).
@reshaping
routine @SortedSetNode[T].split_child(index: U64, manager: @MemoryManager) -> Bool
needs T: typename
    left: @Me = me.children[index]
    leaf: Bool = left.leaf.peek()
    right: @Me = Me.construct(leaf, manager)

    if right.is_hollow()
        return false
    mid: U64 = SORTED_SET_NODE_KEYS.div_trunc(2)
    right_start: U64 = mid + 1
    right_count: U64 = SORTED_SET_NODE_KEYS.sub(right_start)
    right.keys.copy(dst_start: 0, src: left.keys, src_start: right_start, count: right_count)
    right.count.poke(right_count)
    if leaf
        parent_count: U64 = me.count.peek()
        me.keys.shift_right(start: index, end: parent_count)

        until i < index + 1 with i: U64 = parent_count
            child: @Me = me.children[i]
            me.children[i + 1] = child
            continue with i: i - 1
        then
            me.keys.getslot(index).poke(steal left.keys.getslot(mid))
            me.children[index + 1] = right
            left.count.poke(mid)
            next_count: U64 = me.count.peek() + 1
            next_count.poke_into(me.count)
            left.recount()
            right.recount()
            me.recount()
            return true
    else
        each i in 0 to right_count
            src: U64 = mid + 1 + i
            child: @Me = left.children[src]
            right.children[i] = child
        then
            parent_count: U64 = me.count.peek()
            me.keys.shift_right(start: index, end: parent_count)

            until i2 < index + 1 with i2: U64 = parent_count
                child: @Me = me.children[i2]
                me.children[i2 + 1] = child
                continue with i2: i2 - 1
            then
                me.keys.getslot(index).poke(steal left.keys.getslot(mid))
                me.children[index + 1] = right
                left.count.poke(mid)
                next_count: U64 = me.count.peek() + 1
                next_count.poke_into(me.count)
                left.recount()
                right.recount()
                me.recount()
                return true

### Inserts `key` below a node that isn't full, splitting full children on the way down. An equal element must not
### already be in the subtree (`add` checks first).
### :param key: The element to insert.
### :param manager: The memory manager for nodes made by splits.
### :returns: True when it inserted, false when a split failed to allocate (the key ends then). The tree then holds the
###     same elements, some nodes already split.
@reshaping
routine @SortedSetNode[T].insert_nonfull(key: T, manager: @MemoryManager) -> Bool
needs T: typename
    probe: &T <- steal key

    if me.leaf.peek()
        slot: U64 = me.find_index(key: probe)
        count: U64 = me.count.peek()
        me.keys.shift_right(start: slot, end: count)
        me.keys.getslot(slot).poke(steal probe)
        new_count: U64 = count + 1
        me.count.poke(new_count)
        me.subtree_count.poke(new_count)
        return true
    slot: U64 = me.find_index(key: probe)
    child: @Me = me.children[slot]
    child_count: U64 = child.count.peek()
    full: Bool = child_count == SORTED_SET_NODE_KEYS
    values2: (U64, @Me) = when
        full =>
            if not me.split_child(index: slot, manager)
                drop probe
                return false
            cmp: S32 = probe.compare(me.keys.getslot(slot))
            go_right: Bool = cmp > 0
            next_slot: U64 = when
                go_right => slot + 1
                else => slot
            becomes (next_slot, me.children[next_slot])
        else => (slot, child)
    slot2, child2 = values2
    if not child2.insert_nonfull(key: steal probe, manager)
        return false
    me.recount()
    return true

### Adds `key` to the set in sorted position unless an equal element is already present.
### :param key: The element to add.
### :returns: `true` when `key` was new, `false` when it was already present.
### :throws: Throws `OutOfMemoryError` when a node cannot be allocated.
@track_caller
@reshaping
failable routine @SortedSet[T].add(key: T) -> Bool
needs T: typename
    probe: &T <- steal key

    if me.has(probe)
        drop probe
        return false
    manager: @MemoryManager = me.manager.peek()
    root: @SortedSetNode[T] = me.root.peek()
    if root.is_hollow()
        root2: @SortedSetNode[T] = SortedSetNode[T].construct(leaf: true, manager)
        if root2.is_hollow()
            drop probe
            throw OutOfMemoryError()
        root2.keys.getslot(0).poke(steal probe)
        root2.count.poke(1)
        root2.subtree_count.poke(1)
        me.root.poke(root2)
        me.count.poke(1)
        return true
    root_count: U64 = root.count.peek()
    full: Bool = root_count == SORTED_SET_NODE_KEYS
    root2: @SortedSetNode[T] = when
        full =>
            new_root: @SortedSetNode[T] = SortedSetNode[T].construct(leaf: false, manager)
            if new_root.is_hollow()
                drop probe
                throw OutOfMemoryError()
            new_root.children[0] = root
            if new_root.split_child(index: 0, manager)
                me.root.poke(new_root)
                becomes new_root
            else
                deallocate[SortedSetNode[T]](data: new_root, manager)
                drop probe
                throw OutOfMemoryError()
        else => root
    if not root2.insert_nonfull(key: steal probe, manager)
        throw OutOfMemoryError()
    next_count: U64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return true

### Removes the key at `index` from a leaf by shifting the later keys left.
### :param index: The position of the key within the leaf.
### :returns: The removed key.
routine @SortedSetNode[T].remove_leaf_at(index: U64) -> T
needs T: typename
    old: &T <- steal me.keys.getslot(index)

    count: U64 = me.count.peek()
    me.keys.shift_left(start: index, end: count)
    new_count: U64 = count - 1
    me.count.poke(new_count)
    me.subtree_count.poke(new_count)
    return steal old

# Capacity = SORTED_SET_NODE_KEYS, t = SORTED_SET_NODE_MIN_KEYS. Non-root nodes maintain
# count >= SORTED_SET_NODE_MIN_KEYS - 1.
# Helpers below ensure a child has count >= SORTED_SET_NODE_MIN_KEYS (= t) before any deletion
# descent so the child can absorb a one-key drop without underflowing.

### Rotates one key from child `i - 1` through the parent into the front of child `i`, so child `i` gains a key. Subtree counts are updated.
### :param i: The index of the child that is short of keys.
routine @SortedSetNode[T].borrow_from_left(i: U64) -> None
needs T: typename
    separator: U64 = i - 1
    left: @Me = me.children[separator]
    child: @Me = me.children[i]
    left_count: U64 = left.count.peek()
    child_count: U64 = child.count.peek()

    child.keys.shift_right(start: 0, end: child_count)
    child.keys.getslot(0).poke(steal me.keys.getslot(separator))
    me.keys.getslot(separator).poke(steal left.keys.getslot(left_count - 1))
    if not child.leaf.peek()
        children: U64 = child_count + 1
        child.children.shift_right(start: 0, end: children)
        moved: @Me = left.children[left_count]
        child.children[0] = moved
    left.count.poke(left_count - 1)
    child.count.poke(child_count + 1)
    left.recount()
    child.recount()
    me.recount()
    return

### Rotates one key from child `i + 1` through the parent into the end of child `i`, so child `i` gains a key. Subtree counts are updated.
### :param i: The index of the child that is short of keys.
routine @SortedSetNode[T].borrow_from_right(i: U64) -> None
needs T: typename
    child: @Me = me.children[i]
    right: @Me = me.children[i + 1]
    child_count: U64 = child.count.peek()
    right_count: U64 = right.count.peek()

    child.keys.getslot(child_count).poke(steal me.keys.getslot(i))
    me.keys.getslot(i).poke(steal right.keys.getslot(0))
    right.keys.shift_left(start: 0, end: right_count)
    if not child.leaf.peek()
        moved: @Me = right.children[0]
        child.children[child_count + 1] = moved
        right.children.shift_left(start: 0, end: right_count + 1)
    child.count.poke(child_count + 1)
    right.count.poke(right_count - 1)
    child.recount()
    right.recount()
    me.recount()
    return

### Merges child `i + 1` and the separating key into child `i` and frees the emptied node, shrinking this node by one key.
### :param i: The index of the left child of the pair.
### :param manager: The memory manager that frees the merged node.
routine @SortedSetNode[T].merge_children(i: U64, manager: @MemoryManager) -> None
needs T: typename
    left: @Me = me.children[i]
    right: @Me = me.children[i + 1]
    left_count: U64 = left.count.peek()
    right_count: U64 = right.count.peek()

    left.keys.getslot(left_count).poke(steal me.keys.getslot(i))
    dst_start: U64 = left_count + 1
    left.keys.copy(dst_start, src: right.keys, src_start: 0, count: right_count)
    if not left.leaf.peek()
        left.children.copy(dst_start: left_count + 1, src: right.children, src_start: 0,
            count: right_count + 1)
    left.count.poke(left_count + 1 + right_count)
    parent_count: U64 = me.count.peek()
    me.keys.shift_left(start: i, end: parent_count)
    me.children.shift_left(start: i + 1, end: parent_count + 1)
    me.count.poke(parent_count - 1)
    deallocate[Me](data: right, manager)
    left.recount()
    me.recount()
    return

### Makes sure child `i` has at least `SORTED_SET_NODE_MIN_KEYS` keys before a deletion descends into it, by borrowing from a sibling or merging with one.
### :param i: The index of the child about to be descended into.
### :param manager: The memory manager that frees a merged node.
### :returns: The index of the child to descend into, which differs from `i` when a merge with the left sibling happened.
@track_caller
routine @SortedSetNode[T].ensure_min(i: U64, manager: @MemoryManager) -> U64
needs T: typename
    child: @Me = me.children[i]
    child_count: U64 = child.count.peek()
    if child_count >= SORTED_SET_NODE_MIN_KEYS
        return i
    has_left: Bool = i > 0
    has_left2: Bool = when
        has_left =>
            left: @Me = me.children[i - 1]
            left_count: U64 = left.count.peek()
            if left_count >= SORTED_SET_NODE_MIN_KEYS
                me.borrow_from_left(i)
                return i
            becomes true
        else => false
    parent_count: U64 = me.count.peek()
    if i < parent_count
        right: @Me = me.children[i + 1]
        right_count: U64 = right.count.peek()
        if right_count >= SORTED_SET_NODE_MIN_KEYS
            me.borrow_from_right(i)
            return i
        elseif not has_left2
            me.merge_children(i, manager)
            return i
    elseif not has_left2
        throw LogicBreachedError()
    merged_at: U64 = i - 1
    me.merge_children(i: merged_at, manager)
    return merged_at

### Removes and returns the largest key in this subtree, rebalancing children on the way down.
### :param manager: The memory manager used when nodes merge.
### :returns: The removed largest key.
routine @SortedSetNode[T].take_max(manager: @MemoryManager) -> T
needs T: typename
    if me.leaf.peek()
        count: U64 = me.count.peek()
        index: U64 = count - 1
        key: &T <- me.remove_leaf_at(index)
        return steal key
    count: U64 = me.count.peek()
    actual: U64 = me.ensure_min(i: count, manager)
    child: @Me = me.children[actual]
    key: &T <- child.take_max(manager)
    me.recount()
    return steal key

### Removes and returns the smallest key in this subtree, rebalancing children on the way down.
### :param manager: The memory manager used when nodes merge.
### :returns: The removed smallest key.
routine @SortedSetNode[T].take_min(manager: @MemoryManager) -> T
needs T: typename
    if me.leaf.peek()
        key: &T <- me.remove_leaf_at(0)
        return steal key
    actual: U64 = me.ensure_min(i: 0, manager)
    child: @Me = me.children[actual]
    key: &T <- child.take_min(manager)
    me.recount()
    return steal key

### Removes the key equal to the one at `key` from this subtree and ends it, rebalancing children on the way down so
### no node underflows.
### :param key: The key to remove, read through its place.
### :param manager: The memory manager used when nodes merge.
### :returns: `true` when the key was found and removed, `false` otherwise.
routine @SortedSetNode[T].remove(key: @T, manager: @MemoryManager) -> Bool
needs T: typename
    slot: U64 = me.find_index(key)

    count: U64 = me.count.peek()
    if slot < count
        cmp: S32 = key.compare(me.keys.getslot(slot))
        if cmp == 0
            if me.leaf.peek()
                drop me.remove_leaf_at(slot)
                return true
            left: @Me = me.children[slot]
            left_count: U64 = left.count.peek()
            if left_count >= SORTED_SET_NODE_MIN_KEYS
                left2: @Me = me.children[slot]
                replacement: &T <- left2.take_max(manager)
                drop me.keys.getslot(slot)
                me.keys.getslot(slot).poke(steal replacement)
                me.recount()
                return true
            right: @Me = me.children[slot + 1]
            right_count: U64 = right.count.peek()
            if right_count >= SORTED_SET_NODE_MIN_KEYS
                right2: @Me = me.children[slot + 1]
                replacement: &T <- right2.take_min(manager)
                drop me.keys.getslot(slot)
                me.keys.getslot(slot).poke(steal replacement)
                me.recount()
                return true
            me.merge_children(i: slot, manager)
            merged: @Me = me.children[slot]
            removed: Bool = merged.remove(key, manager)
            me.recount()
            return removed
    if me.leaf.peek()
        return false
    actual: U64 = me.ensure_min(i: slot, manager)
    child: @Me = me.children[actual]
    removed: Bool = child.remove(key, manager)
    me.recount()
    return removed

### Removes the element equal to the one at `key` and ends it, shrinking the tree when the root empties.
### :param key: The element to remove, read through its place.
### :returns: `true` when an element was removed, `false` when it was not present.
routine @SortedSet[T].remove(key: @T) -> Bool
needs T: typename
    root: @SortedSetNode[T] = me.root.peek()

    if root.is_hollow()
        return false
    manager: @MemoryManager = me.manager.peek()
    if root.remove(key, manager)
        remaining_count: U64 = me.count.peek() - 1
        remaining_count.poke_into(me.count)
        root_count: U64 = root.count.peek()
        if root_count == 0
            if root.leaf.peek()
                deallocate[SortedSetNode[T]](data: root, manager)
                me.root.poke(.hollow())
                return true
            new_root: @SortedSetNode[T] = root.children[0]
            deallocate[SortedSetNode[T]](data: root, manager)
            me.root.poke(new_root)
            return true
        return true
    return false

### Removes the element equal to `key` and ends it, and `key` too.
### :param key: The element to remove.
### :returns: `true` when an element was removed, `false` when it was not present.
routine @SortedSet[T].remove(key: T) -> Bool
needs T: typename
    probe: &T <- steal key

    removed: Bool = me.remove(probe)

    drop probe
    return removed

### Ends the keys of this node and every node below it (drop) and frees the nodes through `manager`. An internal node has
### `count` keys and `count + 1` children.
### :param manager: The memory manager the nodes came from.
routine @SortedSetNode[T].free_recursive(manager: @MemoryManager) -> None
needs T: typename
    each i in 0 til me.count.peek()
        drop me.keys.getslot(i)
    if me.leaf.peek()
        deallocate[Me](data: me, manager)
        return
    count: U64 = me.count.peek()

    child_count: U64 = count + 1

    each i in 0 til child_count
        child: @Me = me.children[i]
        child.free_recursive(manager)
    then
        deallocate[Me](data: me, manager)
        return

### Ends every element (drop), frees the set's memory through its memory manager, and resets it to the empty state, so it can be reused or destructed again.
### :note: Safe to call on a never-filled instance, where it only resets the fields.
@track_caller
routine @SortedSet[T].destruct() -> None
needs T: typename
    root: @SortedSetNode[T] = me.root.peek()

    if not root.is_hollow()
        manager: @MemoryManager = me.manager.peek()
        root.free_recursive(manager)
    me.root.poke(.hollow())
    me.count.poke(0)
    return

# -- text -----------------------------------------------------------------------

### The elements in sorted order, each diagnosed (strings quoted): {1, 2, 3}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @SortedSet[T].represent_into[TWriter](out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    iter_val: SortedSetEmitter[T] = .construct(me)
    iter: &SortedSetEmitter[T] <- iter_val
    diagnose_slots[T, SortedSetEmitter[T], TWriter](out, iter, open: "{", close: "}")
    return

### The elements in sorted order, each diagnosed: {1, 2, 3}.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @SortedSet[T].diagnose_into[TWriter](out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    iter_val: SortedSetEmitter[T] = .construct(me)
    iter: &SortedSetEmitter[T] <- iter_val
    diagnose_slots[T, SortedSetEmitter[T], TWriter](out, iter, open: "{", close: "}")
    return
