# Tessera stdlib collection: BitListEmitter
#
# Forward emitter over a BitList, yielding each bit as a Bool. Borrows the
# list: the list must outlive the emitter. The bits are packed, so there are
# no element slots to hand out.
#
# Satisfies concept Emitter[Bool, BitListEmitter].

module Collections

### A forward emitter over a {BitList}, yielding each bit as a `Bool`. It borrows the list, so the list must outlive the emitter and must not change while it is walked.
record BitListEmitter
obeys Emitter[Bool, BitListEmitter]
    list: @BitList
    index: U64

### Creates an emitter positioned before the first bit of `list`.
### :param list: The list to walk.
### :returns: A new emitter at index `0`.
common routine BitListEmitter.construct(list: @BitList) -> Me
    emitter: Me = Me(list: list, index: 0)
    return emitter

### An emitter over the bit list, at its first bit: `e: &BitListEmitter <- list.emitter()`, then `each x in e`.
### :returns: A new {BitListEmitter} over `me`.
routine @BitList.emitter() -> BitListEmitter
    emitter: BitListEmitter = BitListEmitter.construct(me)
    return emitter

### Yields the next bit and advances the emitter.
### :returns: The next bit, front to back.
### :throws: Throws `AbsentValueError` after the last bit has been yielded.
failable routine @BitListEmitter.emit() -> Bool
    list: @BitList = me.list.peek()
    index: U64 = me.index.peek()

    if index >= list.count()
        throw AbsentValueError()
    value: Bool = list[index]
    me.index.poke(index + 1)
    return value
