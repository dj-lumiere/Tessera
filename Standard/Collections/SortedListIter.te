# Tessera stdlib collection: SortedListIter[T]
#
# In-order iterator over SortedList[T]. Yields elements from index 0 to
# count-1. It keeps the path from the root to the current leaf on an inline
# stack, so a full traversal is O(n) and the iterator allocates nothing.
#
# Satisfies concept SlotIterator[T, SortedListIter[T]] (and so Iterator).

module Standard/Collections

### Every internal node has at least two children, so 2^64 elements fit in 64 levels.
secret preset SORTED_LIST_ITER_DEPTH: U64 = 64

### `nodes[d]` and `indices[d]` for each level `d < depth`: the node, and in it the child being walked (internal) or
### the next value to yield (leaf).
record SortedListIter[T]
obeys SlotIterator[T, SortedListIter[T]]
needs T: typename, Comparable[T]
    nodes: Array[@SortedListNode[T], SORTED_LIST_ITER_DEPTH]
    indices: Array[U64, SORTED_LIST_ITER_DEPTH]
    depth: U64

### Creates an iterator positioned before the smallest element, descending to the leftmost leaf.
### :param list: The sorted list to walk.
### :returns: A new iterator, already positioned when the list is not empty.
common routine SortedListIter[T].construct(list: @SortedList[T]) -> Me
needs T: typename
    iter: &Me <- .hollow()

    root: @SortedListNode[T] = list.root.peek()
    empty: Bool = root.is_hollow()
    iter.depth.poke(0)
    if not empty
        iter.push_leftmost(root)
    iter_val: Me = iter.load()
    return iter_val

### Pushes node and the first child of each level below it, down to a leaf.
### :param node: The node to start from.
secret routine @SortedListIter[T].push_leftmost(node: @SortedListNode[T]) -> None
needs T: typename
    loop with current: @SortedListNode[T] = node
        depth2: U64 = me.depth.peek()
        leaf2: Bool = current.leaf.peek()
        me.nodes[depth2] = current
        me.indices[depth2] = 0
        me.depth.poke(depth2 + 1)
        if leaf2
            return
        continue with current: current.children[0]

### Hands out the next element's slot and advances the iterator.
### :returns: The next element's address, smallest first.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @SortedListIter[T].next() -> @T
needs T: typename
    loop
        depth2: U64 = me.depth.peek()
        if depth2 == 0
            break
        level: U64 = depth2 - 1
        node: @SortedListNode[T] = me.nodes[level]
        index: U64 = me.indices[level]
        if node.leaf.peek()
            count: U64 = node.count.peek()
            if index < count
                me.indices[level] = index + 1
                at: @T = node.values.getslot(index)
                return at
        else
            # the child at `indices[level]` is done, so walk the next one, if there is one
            index2: U64 = index + 1
            count: U64 = node.count.peek()
            if index2 < count
                me.indices[level] = index2
                me.push_leftmost(node.children[index2])
                continue
        me.depth.poke(level)
        continue
    throw AbsentValueError()

### Yields the next element and advances the iterator.
### :returns: The next element, smallest first.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @SortedListIter[T].emit() -> T
needs T: typename
    slot: @T = when check me.next()
        is @T as at => at
    return slot.peek()
