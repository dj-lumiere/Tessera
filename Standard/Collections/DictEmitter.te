# Tessera stdlib collection: DictEmitter[TKey, TValue]
#
# Walks Dict[TKey, TValue] in insertion order. Yields KVPair[TKey, TValue] for each live
# entry in the entries arrays, skipping entries marked dead by `remove`.
#
# KVPair[TKey, TValue] is defined in option.te and shared with SortedDictEmitter.
#
# Mutating the map during iteration produces undefined behaviour.
#
# Satisfies concept Emitter[KVPair[TKey, TValue], DictEmitter[TKey, TValue]].

module Collections

### An emitter over a {Dict[TKey, TValue]} in insertion order, yielding each live entry as a `KVPair`. Entries removed from the dict are skipped. Changing the dict while iterating is undefined behavior.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
record DictEmitter[TKey, TValue]
obeys Emitter[KVPair[TKey, TValue], DictEmitter[TKey, TValue]] when TKey: record, TValue: record
needs TKey: typename, TValue: typename, HashEquatable[TKey]
    map: @Dict[TKey, TValue]
    index: U64

### Creates an emitter positioned before the first entry of `map`.
### :param map: The dict to walk.
### :returns: A new emitter at the first entry.
common routine DictEmitter[TKey, TValue].construct(map: @Dict[TKey, TValue]) -> Me
needs TKey: typename, TValue: typename
    emitter: Me = Me(map: map, index: 0)
    return emitter

### An emitter over the dict, at its first entry: `e: &DictEmitter[TKey, TValue] <- dict.emitter()`, then `each x in e`.
### :returns: A new {DictEmitter[TKey, TValue]} over `me`.
routine @Dict[TKey, TValue].emitter() -> DictEmitter[TKey, TValue]
needs TKey: typename, TValue: typename
    emitter: DictEmitter[TKey, TValue] = DictEmitter[TKey, TValue].construct(me)
    return emitter

### Yields the next element and advances the emitter.
### :returns: The next element, in insertion order.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @DictEmitter[TKey, TValue].emit() -> KVPair[TKey, TValue]
needs TKey: record, TValue: record
    map: @Dict[TKey, TValue] = me.map.peek()
    count: U64 = map.entries_count.peek()

    each index in me.index.peek() til count
        entry_states: @U8 = map.entry_states.data.peek()
        state: U8 = entry_states.stride(index).peek()
        if state == 1
            keys: @TKey = map.keys.data.peek()
            values: @TValue = map.values.data.peek()
            key: TKey = keys.stride(index).peek()
            value: TValue = values.stride(index).peek()
            pair: KVPair[TKey, TValue] = KVPair[TKey, TValue](key: key, value: value)
            me.index.poke(index + 1)
            return pair
        continue
    throw AbsentValueError()
