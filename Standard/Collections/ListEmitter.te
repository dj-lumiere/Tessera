# Tessera stdlib collection: ListEmitter[T]
#
# Forward emitter over List[T].  Borrows the list — the list must outlive the
# emitter.  emit() throws AbsentValueError after the last element, and next()
# hands out the element slots the same way.
#
# Satisfies concept SlotEmitter[T, ListEmitter[T]] (and so Emitter).

module Collections

### A forward emitter over a {List[T]}. It borrows the list, so the list must outlive the emitter and must not change while it is walked.
### :typeparam T: The element type.
record ListEmitter[T]
obeys SlotEmitter[T, ListEmitter[T]]
needs T: typename
    list: @List[T]
    index: U64

### Creates an emitter positioned before the first element of `list`.
### :param list: The list to walk.
### :returns: A new emitter at index `0`.
common routine ListEmitter[T].construct(list: @List[T]) -> Me
needs T: typename
    emitter: Me = Me(list: list, index: 0)
    return emitter

### An emitter over the list, at its first element: `e: &ListEmitter[T] <- list.emitter()`, then `for x in e`.
### :returns: A new {ListEmitter[T]} over `me`.
routine @List[T].emitter() -> ListEmitter[T]
needs T: typename
    emitter: ListEmitter[T] = ListEmitter[T].construct(me)
    return emitter

### Yields the next element and advances the emitter.
### :returns: The next element, front to back.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @ListEmitter[T].emit() -> T
needs T: typename
    list: @List[T] = me.list.peek()
    len: U64 = list.count()
    index: U64 = me.index.peek()

    if index >= len
        throw AbsentValueError()
    value: T = list[index]
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the emitter.
### :returns: The address of the next element, front to back.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @ListEmitter[T].next() -> @T
needs T: typename
    list: @List[T] = me.list.peek()
    index: U64 = me.index.peek()

    if index >= list.count()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = list.getslot(index)
    return element
