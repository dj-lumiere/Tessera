# Tessera stdlib collection: RotatableList[T]
#
# Dynamic array with a centered start index — front and back both grow without
# shifting. The buffer is a BorrowedSlice[T] whose count is the capacity, and it
# keeps the memory manager.
#
# Logical element i lives at storage.data[start + i]. Front growth consumes spare slots
# before start. When either side runs out the live range is moved back to the
# center of a new buffer, twice as large if the circular_list is more than half full.

module Collections

### A growable sequence with spare room on both sides of its live range, so `add_first` and `add_last` are both amortized constant time without shifting elements. Logical element `i` lives at `storage.data[start + i]`. When either side runs out, the live range is moved to the center of a new buffer.
### :typeparam T: The element type.
entity RotatableList[T]
obeys Destructible[RotatableList[T]]
obeys Representable[RotatableList[T]] when T: typename, Diagnosable[T]
obeys Diagnosable[RotatableList[T]] when T: typename, Diagnosable[T]
obeys Equatable[RotatableList[T]] when T: typename, Equatable[T]
needs T: typename
obeys ViewingIndexable[RotatableList[T], T], ModifyingIndexable[RotatableList[T], T]
    storage: BorrowedSlice[T]
    start: U64
    count: U64

### Creates an empty RotatableList that draws its storage from `manager`. Nothing is allocated until the first insertion.
### :param manager: The memory manager the list stores and later frees its memory with.
### :returns: A new empty RotatableList.
common routine RotatableList[T].construct(manager: @MemoryManager) -> Me
needs T: typename
    return Me(storage: BorrowedSlice[T].construct(count: 0, manager: manager), start: 0, count: 0)

### A RotatableList of the values of an Items, drawing its storage from `manager`. The array is taken over: its values go
### into the circular list, entity values too, in order.
### :typeparam COUNT: The number of values.
### :param values: The values, taken over.
### :param manager: The memory manager the circular list stores and later gives its memory back with.
### :returns: The circular list.
### :throws: Crashes with `OutOfMemoryError` when the memory manager has no memory to give.
@track_caller
@expensive("borrows memory")
common routine RotatableList[T].of[COUNT](values: Items[T, COUNT], manager: @MemoryManager) -> Me
needs T: record, COUNT: U64
    made: &Me <- Me.construct(manager)
    items: &List[T] <- List[T].of(values: steal values, manager: manager)

    # Every value moves out into the new collection, so the list is given back without destructing them: its places
    # are walked as raw memory.
    first: @T = items.getview().to[@T]()
    each i: U64 in 0 til COUNT
        made.add_last(steal first.stride(i))
    then
        # every value went into the circular list: the list's places are hollow
        drop items
        return made

### A RotatableList of the values of a Slots, drawing its storage from `manager`. The array is taken over: its values go
### into the circular list, entity values too, in order.
### :typeparam COUNT: The number of values.
### :param values: The values, taken over.
### :param manager: The memory manager the circular list stores and later gives its memory back with.
### :returns: The circular list.
### :throws: Crashes with `OutOfMemoryError` when the memory manager has no memory to give.
@track_caller
@expensive("borrows memory")
common routine RotatableList[T].of[COUNT](values: Slots[T, COUNT], manager: @MemoryManager) -> Me
needs T: typename, COUNT: U64
    made: &Me <- Me.construct(manager)
    items: &List[T] <- List[T].of(values: steal values, manager: manager)

    # Every value moves out into the new collection, so the list is given back without destructing them: its places
    # are walked as raw memory.
    first: @T = items.getview().to[@T]()
    each i: U64 in 0 til COUNT
        made.add_last(steal first.stride(i))
    then
        # every value went into the circular list: the list's places are hollow
        drop items
        return made

### The number of elements currently stored.
### :returns: The count of elements, `0` when the list is empty.
routine @RotatableList[T].count() -> U64
needs T: typename
    count: U64 = me.count.peek()
    return count

### Whether the list holds no elements.
### :returns: `true` when the count is `0`.
routine @RotatableList[T].is_empty() -> Bool
needs T: typename
    count: U64 = me.count.peek()
    return count == 0

### Moves the elements into a new buffer of `new_capacity`, centered in it.
### :param new_capacity: The new buffer's capacity, at least the count.
### :returns: True when it moved them, false when the memory manager failed (the list is left as it was).
@reshaping
secret routine @RotatableList[T].recenter(new_capacity: U64) -> Bool
needs T: typename
    count: U64 = me.count.peek()
    slack: U64 = new_capacity - count
    new_start: U64 = slack // 2

    manager: @MemoryManager = me.storage.manager.peek()
    when check BorrowedSlice[T].construct(count: new_capacity, manager: manager)
        is BorrowedSlice[T] as fresh =>
            old_data: @T = me.storage.data.peek()
            if not old_data.is_hollow()
                old_start: U64 = me.start.peek()
                src: @T = old_data.stride(old_start)
                dst: @T = fresh.data.peek().stride(new_start)
                src.copy_into(dst, count)
            me.storage.replace(value: steal fresh)
            me.start.poke(new_start)
            return true
        is OutOfMemoryError => return false

### The capacity to recenter into when one end runs out: double it only when the circular_list is more than half full.
### Otherwise the live range just moves back to the middle, so a queue (push_back / pop_front) keeps a bounded buffer
### instead of doubling each time its window drifts to the end.
### :param capacity: The current capacity.
### :returns: Twice `capacity` when the list is more than half full, else `capacity`.
routine @RotatableList[T].grown_capacity(capacity: U64) -> U64
needs T: typename
    count: U64 = me.count.peek()
    crowded: Bool = count * 2 > capacity
    new_capacity: U64 = when
        crowded => capacity * 2
        else => capacity
    return new_capacity

### Makes room for one element before the first: when the start is at 0, recenters into a buffer of 4 (none yet) or
### of {RotatableList[T].grown_capacity}.
### :returns: True when there is room, false when the memory manager failed.
@reshaping
secret routine @RotatableList[T].ensure_front() -> Bool
needs T: typename
    start: U64 = me.start.peek()
    if start > 0
        return true
    capacity: U64 = me.storage.count.peek()
    if capacity == 0
        return me.recenter(4)
    return me.recenter(me.grown_capacity(capacity))

### Makes room for one element after the last: when the buffer's end is reached, recenters into a buffer of 4 (none
### yet) or of {RotatableList[T].grown_capacity}.
### :returns: True when there is room, false when the memory manager failed.
@reshaping
secret routine @RotatableList[T].ensure_back() -> Bool
needs T: typename
    start: U64 = me.start.peek()
    count: U64 = me.count.peek()
    capacity: U64 = me.storage.count.peek()

    if start + count < capacity
        return true
    if capacity == 0
        return me.recenter(4)
    return me.recenter(me.grown_capacity(capacity))

### Appends `value` after the last element.
### :param value: The element to add.
### :throws: Throws `OutOfMemoryError` when the buffer must grow and the memory manager fails.
@track_caller
@reshaping
failable routine @RotatableList[T].add_last(value: T) -> None
needs T: typename
    if not me.ensure_back()
        # nothing took the value: it ends here
        drop value
        throw OutOfMemoryError()
    data: @T = me.storage.data.peek()
    start: U64 = me.start.peek()
    count: U64 = me.count.peek()
    index: U64 = start + count
    data.stride(index).poke(steal value)
    me.count.poke(count + 1)
    return

### Prepends `value` before the first element, so it becomes index `0`.
### :param value: The element to add.
### :throws: Throws `OutOfMemoryError` when the buffer must grow and the memory manager fails.
@track_caller
@reshaping
failable routine @RotatableList[T].add_first(value: T) -> None
needs T: typename
    if not me.ensure_front()
        # nothing took the value: it ends here
        drop value
        throw OutOfMemoryError()
    data: @T = me.storage.data.peek()
    start: U64 = me.start.peek()
    new_start: U64 = start - 1
    data.stride(new_start).poke(steal value)
    me.start.poke(new_start)
    next_count: U64 = me.count.peek() + 1
    next_count.poke_into(me.count)
    return

### Removes the last element and returns it.
### :returns: The removed element.
### :throws: Throws `AbsentValueError` when the list is empty.
failable routine @RotatableList[T].remove_last() -> T
needs T: typename
    count: U64 = me.count.peek()

    if count == 0
        throw AbsentValueError()
    new_count: U64 = count - 1
    data: @T = me.storage.data.peek()
    start: U64 = me.start.peek()
    index: U64 = start + new_count
    me.count.poke(new_count)
    return steal data.stride(index)

### Removes the first element and returns it. Every remaining element's index drops by one.
### :returns: The removed element.
### :throws: Throws `AbsentValueError` when the list is empty.
failable routine @RotatableList[T].remove_first() -> T
needs T: typename
    count: U64 = me.count.peek()

    if count == 0
        throw AbsentValueError()
    data: @T = me.storage.data.peek()
    start: U64 = me.start.peek()
    me.start.poke(start + 1)
    me.count.poke(count - 1)
    return steal data.stride(start)

### Reads the element at logical position `index`, counted from the front.
### :param index: The zero-based position to read.
### :returns: A copy of the element.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
failable routine @RotatableList[T].getitem(index: U64) -> T
needs T: typename
    count: U64 = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: U64 = me.start.peek()
        return data.stride(start + index).peek()
    throw IndexOutOfBoundsError(index, count)

### The address of element `index`, checked like getitem: a place to read or write in place. It stays valid until
### the list grows, shrinks, or is destructed.
### :param index: The zero-based position.
### :returns: The element's address.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
failable routine @RotatableList[T].getslot(index: U64) -> @T
needs T: typename
    count: U64 = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: U64 = me.start.peek()
        element: @T = data.stride(start + index)
        return element
    throw IndexOutOfBoundsError(index, count)

### Whether two lists hold equal elements in the same logical order, regardless of where each sits in its buffer.
### :param other: The list to compare with.
### :returns: `true` when the counts match and every element pair is equal.
routine @RotatableList[T].eq(other: @Me) -> Bool
needs T: typename, Equatable[T]
    return me.eq_at(other)

### `eq`, through pointers to the two lists.
### :param other: The list to compare with.
### :returns: True when the counts match and every element pair is equal.
secret routine @RotatableList[T].eq_at(other: @Me) -> Bool
needs T: typename, Equatable[T]
    la: U64 = me.count.peek()

    lb: U64 = other.count.peek()
    if la == lb
        sa: U64 = me.start.peek()
        sb: U64 = other.start.peek()
        pa: @T = me.storage.data.peek()

        pb: @T = other.storage.data.peek()

        each i in 0 til la
            if pa.stride(sa + i).eq(pb.stride(sb + i))
                continue
            return false
        then
            return true
    else
        return false

### Overwrites the element at logical position `index` with `value`: the element there is ended first (drop).
### :param index: The zero-based position to write.
### :param value: The value to store, taken over.
### :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
@track_caller
routine @RotatableList[T].setitem(index: U64, value: T) -> None
needs T: typename
    count: U64 = me.count.peek()
    if index < count
        data: @T = me.storage.data.peek()
        start: U64 = me.start.peek()
        drop data.stride(start + index)
        data.stride(start + index).poke(steal value)
        return
    throw IndexOutOfBoundsError(index, count)

### Exchanges the elements at logical positions `first` and `second`, counted from the front, in place. Each element
### is moved, never copied, so entity elements swap too, and neither place is left hollow. The same index twice
### changes nothing.
### :param first: The zero-based position of one element.
### :param second: The zero-based position of the other element.
### :throws: Crashes with `IndexOutOfBoundsError` when `first >= count` or `second >= count`.
@track_caller
routine @RotatableList[T].swap(first: U64, second: U64) -> None
needs T: typename
    data: @T = me.storage.data.peek()
    front: @T = data.stride(me.start.peek())
    elements: @[T] = @[T].construct(data: front, count: me.count.peek())
    elements.swap(first, second)
    return

### Removes every element (each is ended, drop) and re-centers the start index. The buffer and its capacity are kept
### for reuse.
routine @RotatableList[T].clear() -> None
needs T: typename
    me.drop_elements()
    capacity: U64 = me.storage.count.peek()
    start: U64 = capacity // 2
    me.start.poke(start)
    me.count.poke(0)
    return

### Ends every element (drop: an element with something to give back gives it back, a plain value or a borrowed
### pointer gives nothing).
secret routine @RotatableList[T].drop_elements() -> None
needs T: typename
    data: @T = me.storage.data.peek()
    start: U64 = me.start.peek()
    each i in 0 til me.count.peek()
        drop data.stride(start + i)
    return

### Ends every element, then gives the list's memory back to its memory manager and resets it to the empty state, so it
### can be reused or destructed again.
### :note: Does nothing on a hollow instance (`.hollow()`, no memory manager), and only resets the fields of a never-filled one.
@track_caller
routine @RotatableList[T].destruct() -> None
needs T: typename
    if me.storage.manager.peek().is_hollow()
        return
    me.drop_elements()
    me.storage.give_back()
    me.start.poke(0)
    me.count.poke(0)
    return

# -- text -----------------------------------------------------------------------

### The elements from the front, each diagnosed (strings quoted): [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @RotatableList[T].represent_into[TWriter](out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    write_str(out, text: "[")
    each i in 0 til me.count()
        if i != 0
            write_str(out, text: ", ")
        me.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return

### The elements from the front, each diagnosed: [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @RotatableList[T].diagnose_into[TWriter](out: @TWriter) -> None
needs T: typename, Diagnosable[T], TWriter: typename, Writer[TWriter]
    write_str(out, text: "[")
    each i in 0 til me.count()
        if i != 0
            write_str(out, text: ", ")
        me.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return
