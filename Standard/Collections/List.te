# Tessera stdlib collection: List[T]
#
# Dynamic array: a BorrowedSlice[T] whose count is the capacity, and the number of
# elements in use. The manager lives in the BorrowedSlice, so callers do not pass
# it to individual operations.

module Collections

### A growable array of `T` stored contiguously on the heap: `storage` holds the capacity (a {BorrowedSlice[T]}, which keeps the manager) and `count` the elements in use. The buffer grows by doubling, and the list is released with `destruct`.
### :typeparam T: The element type.
entity List[T]
obeys Destructible[List[T]]
obeys Equatable[List[T]] when T obeys Equatable
obeys Representable[List[T]] when T obeys Diagnosable
obeys Diagnosable[List[T]] when T obeys Diagnosable
obeys ViewingIndexable[List[T], T], ModifyingIndexable[List[T], T]
    storage: BorrowedSlice[T]
    count: U64

### Creates an empty List that draws its storage from `manager`. Nothing is allocated until the first insertion.
### :param manager: The memory manager the list stores and later frees its memory with.
### :returns: A new empty List.
common routine List[T].construct(manager: @MemoryManager) -> Me
    return Me(storage: BorrowedSlice[T].construct(count: 0, manager: manager), count: 0)

### A List of the values of an Items, in order, drawing its storage from `manager`. Its values go into the list.
### :typeparam COUNT: The number of values.
### :param values: The values, taken over.
### :param manager: The memory manager the list stores and later gives its memory back with.
### :returns: The list.
### :throws: Crashes with `OutOfMemoryError` when the memory manager has no memory to give.
@track_caller
@expensive("borrows memory")
common routine List[T].of[COUNT](values: Items[T, COUNT], manager: @MemoryManager) -> Me
needs RecordType T, U64 COUNT
    list: &Me <- Me.construct(manager)

    # one place at least, so the array always has memory to go into
    list.reserve(U64.max(COUNT, 1))
    first: @T = list.storage.data.peek()
    first.to[@Items[T, COUNT]]().poke(steal values)
    list.count.poke(COUNT)
    return list

### A List of the values of a Slots, in order, drawing its storage from `manager`. The Slots is taken over: its
### values go into the list, entity values too.
### :typeparam COUNT: The number of values.
### :param values: The values, taken over.
### :param manager: The memory manager the list stores and later gives its memory back with.
### :returns: The list.
### :throws: Crashes with `OutOfMemoryError` when the memory manager has no memory to give.
@track_caller
@expensive("borrows memory")
common routine List[T].of[COUNT](values: Slots[T, COUNT], manager: @MemoryManager) -> Me
needs U64 COUNT
    list: &Me <- Me.construct(manager)

    # one place at least, so the array always has memory to go into
    list.reserve(U64.max(COUNT, 1))
    first: @T = list.storage.data.peek()
    first.to[@Slots[T, COUNT]]().poke(steal values)
    list.count.poke(COUNT)
    return list

### The number of elements currently stored.
### :returns: The count of elements, `0` when the list is empty.
routine @List[T].count() -> U64
    count: U64 = me.count.peek()
    return count

### Whether the list holds no elements.
### :returns: `true` when the count is `0`.
routine @List[T].is_empty() -> Bool
    return me.count.peek() == 0

### Grows the buffer to hold at least `capacity` elements without further allocation. A smaller request leaves the buffer unchanged.
### :param capacity: The number of elements to make room for.
### :throws: Throws `OutOfMemoryError` when the memory manager fails.
@track_caller
@expensive("reallocates to exactly the capacity asked for")
@reshaping
failable routine @List[T].reserve(capacity: U64) -> None
    if me.make_capacity(capacity)
        return
    throw OutOfMemoryError()

### Grows the buffer to at least `capacity` elements.
### :param capacity: The number of elements to make room for.
### :returns: True when the buffer is big enough, false when the memory manager failed (the list is left as it was).
@reshaping
secret routine @List[T].make_capacity(capacity: U64) -> Bool
    old_capacity: U64 = me.storage.count.peek()
    if old_capacity >= capacity
        return true
    when check me.storage.resize(capacity)
        is None => return true
        is OutOfMemoryError => return false

### Makes room for `wanted` elements, starting at 4 slots and doubling until the request fits.
### :param wanted: The element count the buffer must hold.
### :throws: Crashes with `OutOfMemoryError` when the memory manager fails.
@track_caller
@reshaping
routine @List[T].ensure_capacity(wanted: U64) -> None
    if me.make_room(wanted)
        return
    throw OutOfMemoryError()

### Makes room for `wanted` elements: an empty buffer starts at 4 slots (or `wanted`, when larger), and a full one
### doubles until the request fits.
### :param wanted: The element count the buffer must hold.
### :returns: True when the buffer is big enough, false when the memory manager failed (the list is left as it was).
@reshaping
secret routine @List[T].make_room(wanted: U64) -> Bool
    capacity: U64 = me.storage.count.peek()

    if capacity >= wanted
        return true
    if capacity == 0
        base: U64 = 4
        use_wanted: Bool = wanted > base
        new_capacity: U64 = when
            use_wanted => wanted
            else => base
        return me.make_capacity(new_capacity)
    loop with grown: U64 = capacity
        next2: U64 = grown * 2
        if next2 >= wanted
            return me.make_capacity(next2)
        continue with grown: next2

### Appends `value` after the last element, growing the buffer when it is full.
### :param value: The element to append.
### :throws: Throws `OutOfMemoryError` when the buffer must grow and the memory manager fails.
@track_caller
@reshaping
failable routine @List[T].add_last(value: T) -> None
    count: U64 = me.count.peek()
    wanted: U64 = count + 1
    if not me.make_room(wanted)
        # nothing took the value: it ends here
        drop value
        throw OutOfMemoryError()
    data: @T = me.storage.data.peek()
    data.stride(count).poke(steal value)
    me.count.poke(wanted)
    return

### Removes the last element and returns it.
### :returns: The removed element.
### :throws: Throws `AbsentValueError` when the list is empty.
failable routine @List[T].remove_last() -> T
    count: U64 = me.count.peek()

    if count == 0
        throw AbsentValueError()
    index: U64 = count - 1
    data: @T = me.storage.data.peek()
    me.count.poke(index)
    return steal data.stride(index)

# -- element access ------------------------------------------------------------

### Reads the element at `index`.
### :param index: The zero-based position to read.
### :returns: A copy of the element.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
failable routine @List[T].getitem(index: U64) -> T
    count: U64 = me.count.peek()
    if index >= count
        throw IndexOutOfBoundsError(index, count)
    data: @T = me.storage.data.peek()
    value: T = data.stride(index).peek()
    return value

### The address of element `index`, checked like getitem: a place to read or write in place. It stays valid until
### the list grows, shrinks, or is destructed.
### :param index: The zero-based position.
### :returns: The element's address.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
failable routine @List[T].getslot(index: U64) -> @T
    count: U64 = me.count.peek()
    if index >= count
        throw IndexOutOfBoundsError(index, count)
    data: @T = me.storage.data.peek()
    return data.stride(index)

### Overwrites the element at `index` with `value`: the element there is ended first (drop), then `value` takes
### its place.
### :param index: The zero-based position to write.
### :param value: The value to store, taken over.
### :throws: Throws `IndexOutOfBoundsError` when `index >= count`.
@track_caller
failable routine @List[T].setitem(index: U64, value: T) -> None
    count: U64 = me.count.peek()
    if index >= count
        throw IndexOutOfBoundsError(index, count)
    data: @T = me.storage.data.peek()
    drop data.stride(index)
    data.stride(index).poke(steal value)
    return

### Exchanges the elements at `first` and `second` in place. Each element is moved, never copied, so entity elements
### swap too, and neither place is left hollow. The same index twice changes nothing.
### :param first: The zero-based position of one element.
### :param second: The zero-based position of the other element.
### :throws: Crashes with `IndexOutOfBoundsError` when `first >= count` or `second >= count`.
@track_caller
routine @List[T].swap(first: U64, second: U64) -> None
    me.getview().swap(first, second)
    return

### The elements, borrowed: valid until the list grows, shrinks, or is destructed.
### :returns: A span of the `count` elements.
routine @List[T].getview() -> @[T]
    return @[T].construct(data: me.storage.data.peek(), count: me.count.peek())

### The `count` elements from `start`, borrowed, checked against the list's count.
### :param start: The index of the first element.
### :param count: The number of elements.
### :returns: A borrowed slice of those elements.
### :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
@track_caller
routine @List[T].getslice(start: U64, count: U64) -> @[T]
    part: @[T] = me.getview().getslice(start, count)
    return part

### Removes every element (each is ended, drop) by resetting the count to `0`. The buffer and its capacity are kept
### for reuse.
routine @List[T].clear() -> None
    first: @T = me.storage.data.peek()
    for i in 0 til me.count.peek()
        drop first.stride(i)
    me.count.poke(0)
    return

### Whether two lists hold equal elements in the same order.
### :param other: The list to compare with.
### :returns: `true` when the counts match and every element pair is equal.
routine @List[T].eq(other: @Me) -> Bool
needs T obeys Equatable
    la: U64 = me.count.peek()
    pa: @T = me.storage.data.peek()
    pb: @T = other.storage.data.peek()

    lb: U64 = other.count.peek()
    if la == lb
        for i in 0 til la
            if pa.stride(i).eq(pb.stride(i))
                continue
            return false
        then
            return true
    else
        return false

### Ends every element (drop: an element with something to give back gives it back, a plain value or a borrowed
### pointer gives nothing), then gives the list's memory back to its memory manager and resets it to the empty state, so it
### can be reused or destructed again.
### :note: Does nothing on a list that is all zero (a `lateinit` one never filled, no memory manager), and only resets the fields of a never-filled one.
@track_caller
routine @List[T].destruct() -> None
    if me.storage.manager.peek().to[Addr]().is_hollow()
        return
    first: @T = me.storage.data.peek()
    count: U64 = me.count.peek()
    for i in 0 til count
        drop first.stride(i)
    me.storage.give_back()
    me.count.poke(0)
    return

# -- text ----------------------------------------------------------------------
#
# A List[Byte] is the growable text buffer: it's a Writer, so buf.write("...")
# appends to it, and getview() views what it holds. The list's memory manager is
# the only place memory comes from.

obeys Writer[List[Byte]]

### Appends `count` bytes, growing through the list's memory manager.
### :param data: The first byte to append.
### :param count: The number of bytes.
### :throws: Crashes with `OutOfMemoryError` when the buffer must grow and the memory manager fails.
@reshaping
routine @List[Byte].write_bytes(data: @Byte, count: U64) -> None
    if count == 0
        return
    old: U64 = me.count.peek()
    new: U64 = old + count
    me.ensure_capacity(new)
    base: @Byte = me.storage.data.peek()
    base.stride(old).copy(src: data, count)
    me.count.poke(new)
    return

### Ends the bytes with a NUL (not counted in `count`) and points at them,
### for C. Valid until the list next changes or is destructed.
### :returns: The NUL-terminated text.
### :throws: Crashes with `OutOfMemoryError` when the buffer must grow and the memory manager fails.
@reshaping
routine @List[Byte].to[CStrView]() -> CStrView
    count: U64 = me.count.peek()
    me.ensure_capacity(count + 1)
    data: @Byte = me.storage.data.peek()
    data.stride(count).poke(0x00)
    return data.to[CStrView]()

# -- text -----------------------------------------------------------------------

### The elements in order, each diagnosed (strings quoted): [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @List[T].represent_into[TWriter](out: @TWriter) -> None
needs T obeys Diagnosable, TWriter obeys Writer
    write_str(out, text: "[")
    for i in 0 til me.count()
        if i != 0
            write_str(out, text: ", ")
        me.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return

### The elements in order, each diagnosed: [1, 2, 3].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine @List[T].diagnose_into[TWriter](out: @TWriter) -> None
needs T obeys Diagnosable, TWriter obeys Writer
    write_str(out, text: "[")
    for i in 0 til me.count()
        if i != 0
            write_str(out, text: ", ")
        me.getslot(i).diagnose_into(out)
    write_str(out, text: "]")
    return
