# Tessera stdlib collection: PriorityQueue[TPriority, TElement]
#
# Binary min-heap of (priority, element) entries ordered by the priority's
# Comparable[TPriority]: the entry with the smallest priority by compare sits at
# the top and comes out first. Entries whose priorities compare equal come out
# in no particular order. A Reversed[TPriority] priority takes the largest
# first. The element only rides along and needs no concept. The heap is two
# parallel arrays, the priorities and the elements, each a BorrowedSlice whose count is
# the capacity and which keeps the memory manager. Priorities are compared through
# their places, and entries move with steal, so either may be an entity.

module Collections

### One entry of a PriorityQueue: the priority it is ordered by and the element it carries. `first_entry` and
### `remove_entry` hand it back. It is a record, so it holds neither an entity priority nor an entity element: those
### come out with `first_slot` / `priority_slot` and `remove`.
### :typeparam TPriority: The priority type.
### :typeparam TElement: The element type.
record PriorityEntry[TPriority, TElement]
needs TPriority: typename, TElement: typename
    priority: TPriority
    element: TElement

### A binary min-heap on a growable array: each element is added with a priority, the entry with the smallest priority by `compare` is always at the top, and `remove` takes it out first. Entries whose priorities compare equal come out in no particular order. For the largest priority first, use {Reversed[T]} priorities. Adding and removing are `O(log n)`, and `first` is `O(1)`.
### :typeparam TPriority: The priority type, ordered by its `Comparable` conformance.
### :typeparam TElement: The element type, which only rides along with its priority.
entity PriorityQueue[TPriority, TElement]
obeys Destructible[PriorityQueue[TPriority, TElement]]
obeys Representable[PriorityQueue[TPriority, TElement]] when TPriority: typename, TElement: typename, Diagnosable[TPriority], Diagnosable[TElement]
obeys Diagnosable[PriorityQueue[TPriority, TElement]] when TPriority: typename, TElement: typename, Diagnosable[TPriority], Diagnosable[TElement]
needs TPriority: typename, TElement: typename, Comparable[TPriority]
    priorities: BorrowedSlice[TPriority]
    elements: BorrowedSlice[TElement]
    count: U64

### Makes a `PriorityEntry` from its fields.
### :param priority: Its `priority`.
### :param element: Its `element`.
### :returns: The new value.
common routine PriorityEntry[TPriority, TElement].construct(priority: TPriority,
    element: TElement) -> Me
needs TPriority: typename, TElement: typename
    return Me(priority, element)

### Releases nothing: a `PriorityEntry` holds no memory of its own.
routine @PriorityEntry[TPriority, TElement].destruct() -> None
needs TPriority: typename, TElement: typename
    return

### Creates an empty PriorityQueue that draws its storage from `manager`. Nothing is allocated until the first insertion.
### :param manager: The memory manager the queue stores and later frees its memory with.
### :returns: A new empty PriorityQueue.
common routine PriorityQueue[TPriority, TElement].construct(manager: @MemoryManager) -> Me
needs TPriority: typename, TElement: typename
    return Me(priorities: BorrowedSlice[TPriority].construct(count: 0, manager: manager),
        elements: BorrowedSlice[TElement].construct(count: 0, manager: manager), count: 0)

### A PriorityQueue of the values of an array, drawing its storage from `manager`. The array is taken over: its values go
### into the priority queue, entity values too, each a priority and its element.
### :typeparam COUNT: The number of values.
### :param values: The values, taken over.
### :param manager: The memory manager the priority queue stores and later gives its memory back with.
### :returns: The priority queue.
### :throws: Crashes with `OutOfMemoryError` when the memory manager has no memory to give.
@track_caller
@expensive("borrows memory")
common routine PriorityQueue[TPriority, TElement].of[COUNT](
    values: Array[(TPriority, TElement), COUNT], manager: @MemoryManager) -> Me
needs TPriority: typename, TElement: typename, COUNT: U64
    made: &Me <- Me.construct(manager)
    items: &List[(TPriority, TElement)] <- List[(TPriority, TElement)].of(values: steal values,
        manager: manager)

    view: @[(TPriority, TElement)] = items.getview()
    each i: U64 in 0 til COUNT
        priority, element = steal view.getslot(i)
        made.add(priority, element)
    then
        # every value went into the priority queue: the list's places are hollow
        drop items
        return made

### The number of entries currently stored.
### :returns: The count of entries, `0` when the queue is empty.
routine @PriorityQueue[TPriority, TElement].count() -> U64
needs TPriority: typename, TElement: typename
    count: U64 = me.count.peek()
    return count

### Whether the queue holds no entries.
### :returns: `true` when the count is `0`.
routine @PriorityQueue[TPriority, TElement].is_empty() -> Bool
needs TPriority: typename, TElement: typename
    count: U64 = me.count.peek()
    return count == 0

### The number of entries the two arrays both have room for.
### :returns: The smaller of the two array counts.
secret routine @PriorityQueue[TPriority, TElement].capacity() -> U64
needs TPriority: typename, TElement: typename
    priorities: U64 = me.priorities.count.peek()
    elements: U64 = me.elements.count.peek()
    return priorities.min(elements)

### Grows the heap arrays to hold at least `capacity` entries without further allocation.
### :param capacity: The number of entries to make room for.
### :throws: Throws `OutOfMemoryError` when the memory manager fails.
@track_caller
@expensive("reallocates to exactly the capacity asked for")
@reshaping
failable routine @PriorityQueue[TPriority, TElement].reserve(capacity: U64) -> None
needs TPriority: typename, TElement: typename
    if me.make_capacity(capacity)
        return
    throw OutOfMemoryError()

### Grows both heap arrays to at least `capacity` entries. When the second one fails the first keeps its new size,
### and the queue goes on using the room both have.
### :param capacity: The number of entries to make room for.
### :returns: True when the arrays are big enough, false when the memory manager failed (the entries are left as they were).
@reshaping
secret routine @PriorityQueue[TPriority, TElement].make_capacity(capacity: U64) -> Bool
needs TPriority: typename, TElement: typename
    if me.capacity() >= capacity
        return true
    if me.priorities.count.peek() < capacity
        when check me.priorities.resize(capacity)
            is None => nothing
            is OutOfMemoryError => return false
    if me.elements.count.peek() < capacity
        when check me.elements.resize(capacity)
            is None => nothing
            is OutOfMemoryError => return false
    return true

### Makes room for `wanted` entries: empty arrays start at 8 slots (or `wanted`, when larger), and full ones double
### until the request fits.
### :param wanted: The entry count the arrays must hold.
### :returns: True when the arrays are big enough, false when the memory manager failed (the entries are left as they were).
@reshaping
secret routine @PriorityQueue[TPriority, TElement].make_room(wanted: U64) -> Bool
needs TPriority: typename, TElement: typename
    capacity: U64 = me.capacity()

    if capacity >= wanted
        return true
    if capacity == 0
        base: U64 = 8
        use_wanted: Bool = wanted > base
        new_capacity: U64 = when
            use_wanted => wanted
            else => base
        return me.make_capacity(new_capacity)
    loop with grown: U64 = capacity
        next2: U64 = grown * 2
        if next2 >= wanted
            return me.make_capacity(next2)
        continue with grown: next2

### Whether the priority at `a` comes before the one at `b`, compared through their places.
### :param a: The first entry's index.
### :param b: The second entry's index.
### :returns: `true` when the priority at `a` is smaller.
secret routine @PriorityQueue[TPriority, TElement].before(a: U64, b: U64) -> Bool
needs TPriority: typename, TElement: typename
    priorities: @TPriority = me.priorities.data.peek()
    return priorities.stride(a).compare(priorities.stride(b)) < 0

### Exchanges the entries at `a` and `b`, each priority and element moved, never copied.
### :param a: The first entry's index.
### :param b: The second entry's index.
secret routine @PriorityQueue[TPriority, TElement].swap(a: U64, b: U64) -> None
needs TPriority: typename, TElement: typename
    me.priorities.swap(first: a, second: b)
    me.elements.swap(first: a, second: b)
    return

### Adds `element` with `priority` and sifts the entry up to its place in the heap. Both move in.
### :param priority: The priority the element is ordered by, the smallest first.
### :param element: The element to add.
### :throws: Throws `OutOfMemoryError` when the heap arrays must grow and the memory manager fails.
@track_caller
@reshaping
failable routine @PriorityQueue[TPriority, TElement].add(priority: TPriority,
    element: TElement) -> None
needs TPriority: typename, TElement: typename
    count: U64 = me.count.peek()
    wanted: U64 = count + 1
    if not me.make_room(wanted)
        # nothing took the entry: it ends here
        drop priority
        drop element
        throw OutOfMemoryError()
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    priorities.stride(count).poke(steal priority)
    elements.stride(count).poke(steal element)
    me.count.poke(wanted)

    until index == 0 with index: U64 = count
        parent: U64 = (index - 1) // 2
        if me.before(a: index, b: parent)
            me.swap(a: index, b: parent)
            continue with index: parent
        return
    then
        return

### Reads the element with the smallest priority, the top, without removing it.
### :returns: A copy of the top element.
### :throws: Throws `AbsentValueError` when the queue is empty.
failable routine @PriorityQueue[TPriority, TElement].first() -> TElement
needs TPriority: typename, TElement: typename
    if me.count.peek() == 0
        throw AbsentValueError()
    elements: @TElement = me.elements.data.peek()
    top: TElement = elements.stride(0).peek()
    return top

### The place of the element with the smallest priority, the top: the way to reach an entity element without taking
### it out. It stays valid until the queue changes.
### :returns: The top element's address.
### :throws: Crashes with `AbsentValueError` when the queue is empty.
@track_caller
routine @PriorityQueue[TPriority, TElement].first_slot() -> @TElement
needs TPriority: typename, TElement: typename
    if me.count.peek() == 0
        throw AbsentValueError()
    elements: @TElement = me.elements.data.peek()
    return elements.stride(0)

### The place of the smallest priority, the top's. Changing it in place breaks the heap order.
### :returns: The top priority's address.
### :throws: Crashes with `AbsentValueError` when the queue is empty.
@track_caller
routine @PriorityQueue[TPriority, TElement].priority_slot() -> @TPriority
needs TPriority: typename, TElement: typename
    if me.count.peek() == 0
        throw AbsentValueError()
    priorities: @TPriority = me.priorities.data.peek()
    return priorities.stride(0)

### Reads the top entry, the smallest priority with its element, without removing it.
### :returns: A copy of the top entry.
### :throws: Throws `AbsentValueError` when the queue is empty.
failable routine @PriorityQueue[TPriority, TElement].first_entry() -> PriorityEntry[TPriority, TElement]
needs TPriority: typename, TElement: typename
    count: U64 = me.count.peek()
    if count == 0
        throw AbsentValueError()
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    top: PriorityEntry[TPriority, TElement] = .construct(priority: priorities.stride(0).peek(),
        element: elements.stride(0).peek())
    return top

### Removes the element with the smallest priority, the top, and returns it (it moves out, its priority ends), then
### restores the heap order.
### :returns: The removed top element.
### :throws: Throws `AbsentValueError` when the queue is empty.
failable routine @PriorityQueue[TPriority, TElement].remove() -> TElement
needs TPriority: typename, TElement: typename
    if me.count.peek() == 0
        throw AbsentValueError()
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    drop priorities.stride(0)
    top: &TElement <- steal elements.stride(0)
    me.close_top()
    return steal top

### Removes the top entry, the smallest priority with its element, and returns it, then restores the heap order.
### :returns: The removed top entry.
### :throws: Throws `AbsentValueError` when the queue is empty.
failable routine @PriorityQueue[TPriority, TElement].remove_entry() -> PriorityEntry[TPriority, TElement]
needs TPriority: typename, TElement: typename
    if me.count.peek() == 0
        throw AbsentValueError()
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    top: PriorityEntry[TPriority, TElement] = .construct(priority: steal priorities.stride(0),
        element: steal elements.stride(0))
    me.close_top()
    return top

### Fills the top the removal emptied with the last entry and sifts it down, one entry fewer.
secret routine @PriorityQueue[TPriority, TElement].close_top() -> None
needs TPriority: typename, TElement: typename
    new_count: U64 = me.count.peek() - 1

    me.count.poke(new_count)
    if new_count == 0
        return
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    priorities.stride(0).poke(steal priorities.stride(new_count))
    elements.stride(0).poke(steal elements.stride(new_count))

    loop with index: U64 = 0
        left: U64 = index * 2 + 1
        right: U64 = left + 1
        if left < new_count
            has_right: Bool = right < new_count
            child: U64 = when
                has_right =>
                    right_smaller: Bool = me.before(a: right, b: left)
                    child: U64 = when
                        right_smaller => right
                        else => left
                    becomes child
                else => left
            if me.before(a: child, b: index)
                me.swap(a: index, b: child)
                continue with index: child
            return
        return

### Removes every entry (each priority and element is ended, drop) by resetting the count to `0`. The array and its
### capacity are kept for reuse.
routine @PriorityQueue[TPriority, TElement].clear() -> None
needs TPriority: typename, TElement: typename
    me.drop_entries()
    me.count.poke(0)
    return

### Ends every priority and every element (drop: one with something to give back gives it back, a plain value or a
### borrowed pointer gives nothing).
secret routine @PriorityQueue[TPriority, TElement].drop_entries() -> None
needs TPriority: typename, TElement: typename
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    each i in 0 til me.count.peek()
        drop priorities.stride(i)
        drop elements.stride(i)
    return

### Ends every entry, then gives the queue's memory back to its memory manager and resets it to the empty state, so it can
### be reused or destructed again.
### :note: Does nothing on a hollow instance (`.hollow()`, no memory manager), and only resets the fields of a never-filled one.
@track_caller
routine @PriorityQueue[TPriority, TElement].destruct() -> None
needs TPriority: typename, TElement: typename
    if me.priorities.manager.peek().is_hollow()
        return
    me.drop_entries()
    me.priorities.give_back()
    me.elements.give_back()
    me.count.poke(0)
    return

# -- text -----------------------------------------------------------------------

### One queue entry as `represent_into` and `diagnose_into` show it: the place of its priority and its position in
### the heap. It orders by priority, then by position.
### :typeparam TPriority: The priority type.
secret record ShownEntry[TPriority]
obeys Comparable[ShownEntry[TPriority]] when TPriority: typename, Comparable[TPriority]
needs TPriority: typename
    ### The place of the entry's priority, read and never changed.
    priority: @TPriority
    ### The entry's position in the heap.
    at: U64

### The entries in the order they come out, the next one first, each written `priority: element` with both
### diagnosed (strings quoted): [1: "a", 2: "b", 4: "d"]. Entries with equal priorities show in storage order.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
### :throws: Crashes with `OutOfMemoryError` when the queue's memory manager has no memory for the sorted copy.
@track_caller
routine @PriorityQueue[TPriority, TElement].represent_into[TWriter](out: @TWriter) -> None
needs TPriority: typename, TElement: typename, Diagnosable[TPriority], Diagnosable[TElement], TWriter: typename, Writer[TWriter]
    me.diagnose_into(out)
    return

### The entries in the order they come out, the next one first, each written `priority: element` with both
### diagnosed: [1: "a", 2: "b", 4: "d"]. The order comes from a sorted copy of the entries' places, so the heap
### itself is not changed. Entries with equal priorities show in storage order.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
### :throws: Crashes with `OutOfMemoryError` when the queue's memory manager has no memory for the sorted copy.
@track_caller
routine @PriorityQueue[TPriority, TElement].diagnose_into[TWriter](out: @TWriter) -> None
needs TPriority: typename, TElement: typename, Diagnosable[TPriority], Diagnosable[TElement], TWriter: typename, Writer[TWriter]
    count: U64 = me.count.peek()

    if count == 0
        write_str(out, text: "[]")
        return
    priorities: @TPriority = me.priorities.data.peek()
    elements: @TElement = me.elements.data.peek()
    shown: &List[ShownEntry[TPriority]] <- .construct(manager: me.priorities.manager.peek())

    each at in 0 til count
        shown.add_last(ShownEntry[TPriority].construct(priority: priorities.stride(at), at))
    shown.sort()

    write_str(out, text: "[")

    each i in 0 til count
        if not (i == 0)
            write_str(out, text: ", ")
        entry: ShownEntry[TPriority] = shown[i]
        entry.priority.diagnose_into(out)
        write_str(out, text: ": ")
        elements.stride(entry.at).diagnose_into(out)
    write_str(out, text: "]")
    drop shown
    return

### Makes a `ShownEntry` from its fields.
### :param priority: Its `priority`.
### :param at: Its `at`.
### :returns: The new value.
common routine ShownEntry[TPriority].construct(priority: @TPriority, at: U64) -> Me
needs TPriority: typename
    return Me(priority, at)

### Releases nothing: a `ShownEntry` only points at a priority the queue keeps.
routine @ShownEntry[TPriority].destruct() -> None
needs TPriority: typename
    return

### Compares the priorities through their places, then the positions: -1, 0, or 1.
### :param other: The entry to compare with.
### :returns: -1 when `me` shows first, 0 for the same entry, and 1 when `other` shows first.
routine ShownEntry[TPriority].compare(other: Me) -> S32
needs TPriority: typename, Comparable[TPriority]
    order: S32 = me.priority.compare(other.priority)
    if order != 0
        return order
    if me.at < other.at
        return -1
    if me.at > other.at
        return 1
    return 0
