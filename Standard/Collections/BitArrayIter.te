# Tessera stdlib collection: BitArrayIter[BITS]
#
# Forward iterator over a BitArray[BITS] held behind a pointer, yielding each
# bit as a Bool. The array must outlive the iterator. The bits are packed, so
# there are no element slots to hand out.
#
# Satisfies concept Iterator[Bool, BitArrayIter[BITS]].

module Standard/Collections

### A forward iterator over a {BitArray[BITS]} held behind a pointer, yielding each bit as a `Bool`. The array must outlive the iterator.
### :typeparam BITS: The number of bits.
record BitArrayIter[BITS]
obeys Iterator[Bool, BitArrayIter[BITS]]
needs BITS: U64
    bits: @BitArray[BITS]
    index: U64

### Creates an iterator positioned before the first bit of `bits`.
### :param bits: The array to walk.
### :returns: A new iterator at index `0`.
common routine BitArrayIter[BITS].construct(bits: @BitArray[BITS]) -> Me
needs BITS: U64
    iter: Me = Me(bits: bits, index: 0)
    return iter

### Yields the next bit and advances the iterator.
### :returns: The next bit, in index order.
### :throws: Throws `AbsentValueError` after the last bit has been yielded.
failable routine @BitArrayIter[BITS].emit() -> Bool
needs BITS: U64
    index: U64 = me.index.peek()

    if index >= BITS
        throw AbsentValueError()
    bits: @BitArray[BITS] = me.bits.peek()
    value: Bool = bits[index]
    me.index.poke(index + 1)
    return value
