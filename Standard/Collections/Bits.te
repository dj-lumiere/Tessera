# Tessera stdlib collection: Bits[BITS]
#
# BITS bits packed eight to a byte in an inline Items[Byte, (BITS + 7) // 8]:
# a record, copied by value, with no heap memory. Bit i lives in byte i // 8,
# at bit i % 8 (least significant first), and the unused high bits of the last
# byte are always 0. Reads come in both receiver forms, changes take the
# address.

module Collections

### `BITS` `Bool` values packed eight to a byte, stored inline: a record copied by value, with no heap memory. Bit `i` is bit `i % 8` of byte `i // 8`, and the unused high bits of the last byte are always 0. Every index is bounds-checked.
### :typeparam BITS: The number of bits, fixed at build time.
record Bits[BITS]
obeys Equatable[Bits[BITS]]
obeys Representable[Bits[BITS]]
obeys Diagnosable[Bits[BITS]]
needs U64 BITS
obeys Bitwiseable[Bits[BITS]], Invertible[Bits[BITS]], ViewingIndexable[Bits[BITS], Bool], ModifyingIndexable[Bits[BITS], Bool]
    bytes: Items[Byte, (BITS + 7) // 8]

### A Bits with every bit clear, the same as `.hollow()`.
### :returns: `BITS` `false` bits.
common routine Bits[BITS].zero() -> Me
needs U64 BITS
    return Me.hollow()

### The number of bits, which is the buildtime constant `BITS`.
### :returns: `BITS`.
common routine Bits[BITS].count() -> U64
needs U64 BITS
    return BITS

### Whether the array holds no bits at all.
### :returns: `true` when `BITS` is `0`.
common routine Bits[BITS].is_empty() -> Bool
needs U64 BITS
    return BITS == 0

### The first byte of the bits, for the byte-level routines.
### :returns: The address of byte `0`.
secret routine @Bits[BITS].data() -> @Byte
needs U64 BITS
    data: @Byte = bitcast[@Me, @Byte](me)
    return data

# -- bit access -------------------------------------------------------------------

### Reads the bit at `index` of a Bits value.
### :param index: The zero-based position to read.
### :returns: The bit.
### :throws: Throws `IndexOutOfBoundsError` when `index >= BITS`.
failable routine Bits[BITS].getitem(index: U64) -> Bool
needs U64 BITS
    slot: &Me <- me

    return when check slot.getitem(index)
        is Bool as value => value

### Reads the bit at `index`.
### :param index: The zero-based position to read.
### :returns: The bit.
### :throws: Throws `IndexOutOfBoundsError` when `index >= BITS`.
failable routine @Bits[BITS].getitem(index: U64) -> Bool
needs U64 BITS
    if index < BITS
        value: Bool = bit_read(data: me.data(), index)
        return value
    throw IndexOutOfBoundsError(index, count: BITS)

### Sets the bit at `index` to `value`, in place.
### :param index: The zero-based position to write.
### :param value: The bit's new value.
### :throws: Throws `IndexOutOfBoundsError` when `index >= BITS`.
@track_caller
failable routine @Bits[BITS].setitem(index: U64, value: Bool) -> None
needs U64 BITS
    if index < BITS
        bit_write(data: me.data(), index, value)
        return
    throw IndexOutOfBoundsError(index, count: BITS)

### Inverts the bit at `index`, in place.
### :param index: The zero-based position to invert.
### :throws: Crashes with `IndexOutOfBoundsError` when `index >= BITS`.
@track_caller
routine @Bits[BITS].flip(index: U64) -> None
needs U64 BITS
    if index < BITS
        data: @Byte = me.data()
        value: Bool = not bit_read(data, index)
        bit_write(data, index, value)
        return
    throw IndexOutOfBoundsError(index, count: BITS)

### Sets every bit to `value`, in place.
### :param value: The value every bit takes.
routine @Bits[BITS].set_all(value: Bool) -> None
needs U64 BITS
    bit_fill(data: me.data(), bits: BITS, value)
    return

### Inverts every bit, in place. {Bits[BITS].bitnot} gives the inverted copy instead.
routine @Bits[BITS].flip_all() -> None
needs U64 BITS
    bit_flip_all(data: me.data(), bits: BITS)
    return

# -- counting and searching -------------------------------------------------------

### Counts the bits of a Bits value that are set.
### :returns: The number of `true` bits.
routine Bits[BITS].count_trues() -> U64
needs U64 BITS
    slot: &Me <- me

    return slot.count_trues()

### Counts the bits that are set, a byte at a time.
### :returns: The number of `true` bits.
routine @Bits[BITS].count_trues() -> U64
needs U64 BITS
    return bit_count_ones(data: me.data(), bits: BITS)

### Counts the bits of a Bits value that are clear.
### :returns: The number of `false` bits.
routine Bits[BITS].count_falses() -> U64
needs U64 BITS
    return BITS - me.count_trues()

### Counts the bits that are clear.
### :returns: The number of `false` bits.
routine @Bits[BITS].count_falses() -> U64
needs U64 BITS
    return BITS - me.count_trues()

### Whether at least one bit of a Bits value is set.
### :returns: `true` when some bit is `true`.
routine Bits[BITS].is_any_true() -> Bool
needs U64 BITS
    slot: &Me <- me

    return slot.is_any_true()

### Whether at least one bit is set.
### :returns: `true` when some bit is `true`.
routine @Bits[BITS].is_any_true() -> Bool
needs U64 BITS
    return bit_any(data: me.data(), bits: BITS)

### Whether every bit of a Bits value is set.
### :returns: `true` when no bit is `false`, also when `BITS` is `0`.
routine Bits[BITS].is_all_true() -> Bool
needs U64 BITS
    return me.count_trues() == BITS

### Whether every bit is set.
### :returns: `true` when no bit is `false`, also when `BITS` is `0`.
routine @Bits[BITS].is_all_true() -> Bool
needs U64 BITS
    return me.count_trues() == BITS

### Whether no bit of a Bits value is set.
### :returns: `true` when no bit is `true`.
routine Bits[BITS].is_none_true() -> Bool
needs U64 BITS
    return not me.is_any_true()

### Whether no bit is set.
### :returns: `true` when no bit is `true`.
routine @Bits[BITS].is_none_true() -> Bool
needs U64 BITS
    return not me.is_any_true()

### Whether some bit of a Bits value has `value`.
### :param value: The bit value to look for.
### :returns: `true` when at least one bit equals `value`.
routine Bits[BITS].has(value: Bool) -> Bool
needs U64 BITS
    slot: &Me <- me

    return slot.has(value)

### Whether some bit has `value`.
### :param value: The bit value to look for.
### :returns: `true` when at least one bit equals `value`.
routine @Bits[BITS].has(value: Bool) -> Bool
needs U64 BITS
    if value
        return me.is_any_true()
    return me.count_falses() != 0

### Whether no bit of a Bits value has `value`.
### :param value: The bit value to look for.
### :returns: `true` when no bit equals `value`.
routine Bits[BITS].lacks(value: Bool) -> Bool
needs U64 BITS
    return not me.has(value)

### Whether no bit has `value`.
### :param value: The bit value to look for.
### :returns: `true` when no bit equals `value`.
routine @Bits[BITS].lacks(value: Bool) -> Bool
needs U64 BITS
    return not me.has(value)

### The position of the first `true` bit of a Bits value.
### :returns: The lowest position whose bit is `true`.
### :absent: When no bit is `true`.
routine Bits[BITS].first_true() -> Optional[U64]
needs U64 BITS
    slot: &Me <- me

    return slot.first_true()

### The position of the first `true` bit.
### :returns: The lowest position whose bit is `true`.
### :absent: When no bit is `true`.
routine @Bits[BITS].first_true() -> Optional[U64]
needs U64 BITS
    return bit_find(data: me.data(), bits: BITS, from: 0, value: true)

### The position of the next `true` bit of a Bits value after `after`.
### :param after: The position to look past.
### :returns: The lowest position above `after` whose bit is `true`.
### :absent: When no bit after `after` is `true`.
routine Bits[BITS].next_true(after: U64) -> Optional[U64]
needs U64 BITS
    slot: &Me <- me

    return slot.next_true(after)

### The position of the next `true` bit after `after`.
### :param after: The position to look past.
### :returns: The lowest position above `after` whose bit is `true`.
### :absent: When no bit after `after` is `true`.
routine @Bits[BITS].next_true(after: U64) -> Optional[U64]
needs U64 BITS
    if after >= BITS
        return None()
    return bit_find(data: me.data(), bits: BITS, from: after + 1, value: true)

### The position of the first `false` bit of a Bits value.
### :returns: The lowest position whose bit is `false`.
### :absent: When no bit is `false`.
routine Bits[BITS].first_false() -> Optional[U64]
needs U64 BITS
    slot: &Me <- me

    return slot.first_false()

### The position of the first `false` bit.
### :returns: The lowest position whose bit is `false`.
### :absent: When no bit is `false`.
routine @Bits[BITS].first_false() -> Optional[U64]
needs U64 BITS
    return bit_find(data: me.data(), bits: BITS, from: 0, value: false)

### The position of the next `false` bit of a Bits value after `after`.
### :param after: The position to look past.
### :returns: The lowest position above `after` whose bit is `false`.
### :absent: When no bit after `after` is `false`.
routine Bits[BITS].next_false(after: U64) -> Optional[U64]
needs U64 BITS
    slot: &Me <- me

    return slot.next_false(after)

### The position of the next `false` bit after `after`.
### :param after: The position to look past.
### :returns: The lowest position above `after` whose bit is `false`.
### :absent: When no bit after `after` is `false`.
routine @Bits[BITS].next_false(after: U64) -> Optional[U64]
needs U64 BITS
    if after >= BITS
        return None()
    return bit_find(data: me.data(), bits: BITS, from: after + 1, value: false)

# -- combining --------------------------------------------------------------------

### The bitwise and: a bit is set where it is set in both (`a & b`).
### :param other: The array to combine with.
### :returns: A new Bits.
routine Bits[BITS].bitand(other: Me) -> Me
needs U64 BITS
    result: &Me <- me
    right: &Me <- other

    bit_and_into(data: result.data(), other: right.data(), bits: BITS)
    return result.load()

### The bitwise or: a bit is set where it is set in either (`a | b`).
### :param other: The array to combine with.
### :returns: A new Bits.
routine Bits[BITS].bitor(other: Me) -> Me
needs U64 BITS
    result: &Me <- me
    right: &Me <- other

    bit_or_into(data: result.data(), other: right.data(), bits: BITS)
    return result.load()

### The bitwise exclusive or: a bit is set where exactly one of the two is set (`a ^ b`).
### :param other: The array to combine with.
### :returns: A new Bits.
routine Bits[BITS].bitxor(other: Me) -> Me
needs U64 BITS
    result: &Me <- me
    right: &Me <- other

    bit_xor_into(data: result.data(), other: right.data(), bits: BITS)
    return result.load()

### The bitwise not: every bit inverted (`~a`). {Bits[BITS].flip_all} inverts in place instead.
### :returns: A new Bits.
routine Bits[BITS].bitnot() -> Me
needs U64 BITS
    result: &Me <- me

    result.flip_all()
    return result.load()

# -- comparing --------------------------------------------------------------------

### Whether two arrays hold the same bits, compared a byte at a time.
### :param other: The array to compare with.
### :returns: `true` when every bit is equal.
routine Bits[BITS].eq(other: Me) -> Bool
needs U64 BITS
    left: &Me <- me
    right: &Me <- other

    return bit_eq(data: left.data(), other: right.data(), bits: BITS)

# -- text -------------------------------------------------------------------------

### The bits in order, like a list of `Bool`: [true, false, true].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine Bits[BITS].represent_into[TWriter](out: @TWriter) -> None
needs U64 BITS, TWriter obeys Writer
    slot: &Me <- me

    bit_write_text(data: slot.data(), bits: BITS, out)
    return

### The bits in order, like a list of `Bool`: [true, false, true].
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
routine Bits[BITS].diagnose_into[TWriter](out: @TWriter) -> None
needs U64 BITS, TWriter obeys Writer
    slot: &Me <- me

    bit_write_text(data: slot.data(), bits: BITS, out)
    return
