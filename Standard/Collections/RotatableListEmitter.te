# Tessera stdlib collection: RotatableListEmitter[T]
#
# Forward emitter over RotatableList[T], yielding elements front-to-back.
# Delegates index-to-physical mapping to RotatableList.getitem, which reads storage.data[start + index].
#
# Satisfies concept SlotEmitter[RotatableListEmitter[T], T] (and so Emitter).

module Collections

### A forward emitter over a {RotatableList[T]}, front to back. It borrows the list, so the list must outlive the emitter and must not change while it is walked.
### :typeparam T: The element type.
record RotatableListEmitter[T]
obeys SlotEmitter[RotatableListEmitter[T], T]
    circular_list: @RotatableList[T]
    index: U64

### Creates an emitter positioned before the first element of `circular_list`.
### :param circular_list: The list to walk.
### :returns: A new emitter at the front.
common routine RotatableListEmitter[T].construct(circular_list: @RotatableList[T]) -> Me
    emitter: Me = Me(circular_list: circular_list, index: 0)
    return emitter

### An emitter over the list, at its front: `e: &RotatableListEmitter[T] <- list.emitter()`, then `for x in e`.
### :returns: A new {RotatableListEmitter[T]} over `me`.
routine @RotatableList[T].emitter() -> RotatableListEmitter[T]
    emitter: RotatableListEmitter[T] = RotatableListEmitter[T].construct(me)
    return emitter

### Yields the next element and advances the emitter.
### :returns: The next element, front to back.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @RotatableListEmitter[T].emit() -> T
    circular_list: @RotatableList[T] = me.circular_list.peek()
    len: U64 = circular_list.count()
    index: U64 = me.index.peek()

    if index >= len
        throw AbsentValueError()
    value: T = circular_list[index]
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the emitter.
### :returns: The address of the next element, front to back.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @RotatableListEmitter[T].next() -> @T
    circular_list: @RotatableList[T] = me.circular_list.peek()
    index: U64 = me.index.peek()

    if index >= circular_list.count()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = circular_list.getslot(index)
    return element
