# Tessera stdlib collection: BitListIter
#
# Forward iterator over a BitList, yielding each bit as a Bool. Borrows the
# list: the list must outlive the iterator. The bits are packed, so there are
# no element slots to hand out.
#
# Satisfies concept Iterator[Bool, BitListIter].

module Standard/Collections

### A forward iterator over a {BitList}, yielding each bit as a `Bool`. It borrows the list, so the list must outlive the iterator and must not change while it is walked.
record BitListIter
obeys Iterator[Bool, BitListIter]
    list: @BitList
    index: U64

### Releases nothing: a `BitListIter` holds no memory of its own.
routine @BitListIter.destruct() -> None
    return

### Creates an iterator positioned before the first bit of `list`.
### :param list: The list to walk.
### :returns: A new iterator at index `0`.
common routine BitListIter.construct(list: @BitList) -> Me
    iter: Me = Me(list: list, index: 0)
    return iter

### Yields the next bit and advances the iterator.
### :returns: The next bit, front to back.
### :throws: Throws `AbsentValueError` after the last bit has been yielded.
failable routine @BitListIter.emit() -> Bool
    local list: @BitList = me.list.peek()
    local index: U64 = me.index.peek()

    if index >= list.count()
        throw AbsentValueError()
    value: Bool = list[index]
    me.index.poke(index + 1)
    return value
