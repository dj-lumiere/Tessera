# Tessera stdlib collection: collections as text
#
# A collection represents and diagnoses the same way, with its elements
# diagnosed, so strings keep their quotes: a list as ["a", "b"], a set as
# {1, 2, 3}, and a map as {"a": 1, "b": 2}. The order is the collection's
# iteration order. These helpers walk any iterator. Each collection's
# represent and diagnose call them with its own brackets.

module Standard/Collections

### Writes `open`, the items `iter` yields separated by ", ", then `close`, with each item diagnosed.
### :typeparam TItem: The item type.
### :typeparam TIter: The iterator type.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
### :param iter: The iterator to drain.
### :param open: The opening bracket.
### :param close: The closing bracket.
routine diagnose_items[TItem, TIter, TWriter](out: @TWriter, iter: @TIter, open: @[Byte],
    close: @[Byte]) -> None
needs TItem: typename, TIter: typename, TWriter: typename, Iterator[TItem, TIter], Diagnosable[TItem], Writer[TWriter]
    write_str(out, text: open)

    while true with first: Bool = true
        item: Maybe[TItem] = iter.emit_checked()
        when item
            is TItem as value =>
                if not first
                    write_str(out, text: ", ")
                value.diagnose_into(out)
                continue with first: false
            is None => break
    write_str(out, text: close)
    return

### Writes the elements a slot iterator hands out between `open` and `close`, each diagnosed through its place, so an
### entity element is only read.
### :typeparam TItem: The element type.
### :typeparam TIter: The iterator type.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
### :param iter: The iterator to drain.
### :param open: The text before the first element.
### :param close: The text after the last element.
routine diagnose_slots[TItem, TIter, TWriter](out: @TWriter, iter: @TIter, open: @[Byte],
    close: @[Byte]) -> None
needs TItem: typename, TIter: typename, TWriter: typename, SlotIterator[TItem, TIter], Diagnosable[TItem], Writer[TWriter]
    write_str(out, text: open)

    while true with first: Bool = true
        item: Maybe[@TItem] = iter.next_checked()
        when item
            is @TItem as at =>
                if not first
                    write_str(out, text: ", ")
                at.diagnose_into(out)
                continue with first: false
            is None => break
    write_str(out, text: close)
    return

### Writes {key: value, ...} from an iterator over KVPairs, keys and values diagnosed.
### :typeparam TKey: The key type.
### :typeparam TValue: The value type.
### :typeparam TIter: The iterator type.
### :typeparam TWriter: The type of the Writer that receives the text.
### :param out: The writer to write to.
### :param iter: The iterator to drain.
routine diagnose_entries[TKey, TValue, TIter, TWriter](out: @TWriter, iter: @TIter) -> None
needs TKey: typename, TValue: typename, TIter: typename, TWriter: typename, Iterator[KVPair[TKey, TValue], TIter]
needs Diagnosable[TKey], Diagnosable[TValue], Writer[TWriter]
    write_str(out, text: "{")

    while true with first: Bool = true
        item: Maybe[KVPair[TKey, TValue]] = iter.emit_checked()
        when item
            is KVPair[TKey, TValue] as pair =>
                if not first
                    write_str(out, text: ", ")
                key: TKey = pair.key
                value: TValue = pair.value
                key.diagnose_into(out)
                write_str(out, text: ": ")
                value.diagnose_into(out)
                continue with first: false
            is None => break
    write_str(out, text: "}")
    return
