# Tessera stdlib collection: BitArrayEmitter[BITS]
#
# Forward emitter over a BitArray[BITS] held behind a pointer, yielding each
# bit as a Bool. The array must outlive the emitter. The bits are packed, so
# there are no element slots to hand out.
#
# Satisfies concept Emitter[Bool, BitArrayEmitter[BITS]].

module Collections

### A forward emitter over a {BitArray[BITS]} held behind a pointer, yielding each bit as a `Bool`. The array must outlive the emitter.
### :typeparam BITS: The number of bits.
record BitArrayEmitter[BITS]
obeys Emitter[Bool, BitArrayEmitter[BITS]]
needs BITS: U64
    bits: @BitArray[BITS]
    index: U64

### Creates an emitter positioned before the first bit of `bits`.
### :param bits: The array to walk.
### :returns: A new emitter at index `0`.
common routine BitArrayEmitter[BITS].construct(bits: @BitArray[BITS]) -> Me
needs BITS: U64
    emitter: Me = Me(bits: bits, index: 0)
    return emitter

### An emitter over the bit array, at its first bit: `e: &BitArrayEmitter[BITS] <- array.emitter()`, then `each x in e`.
### :returns: A new {BitArrayEmitter[BITS]} over `me`.
routine @BitArray[BITS].emitter() -> BitArrayEmitter[BITS]
needs BITS: U64
    emitter: BitArrayEmitter[BITS] = BitArrayEmitter[BITS].construct(me)
    return emitter

### Yields the next bit and advances the emitter.
### :returns: The next bit, in index order.
### :throws: Throws `AbsentValueError` after the last bit has been yielded.
failable routine @BitArrayEmitter[BITS].emit() -> Bool
needs BITS: U64
    index: U64 = me.index.peek()

    if index >= BITS
        throw AbsentValueError()
    bits: @BitArray[BITS] = me.bits.peek()
    value: Bool = bits[index]
    me.index.poke(index + 1)
    return value
