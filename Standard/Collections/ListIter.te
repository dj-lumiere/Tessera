# Tessera stdlib collection: ListIter[T]
#
# Forward iterator over List[T].  Borrows the list — the list must outlive the
# iterator.  emit() throws AbsentValueError after the last element, and next()
# hands out the element slots the same way.
#
# Satisfies concept SlotIterator[T, ListIter[T]] (and so Iterator).

module Standard/Collections

### A forward iterator over a {List[T]}. It borrows the list, so the list must outlive the iterator and must not change while it is walked.
### :typeparam T: The element type.
record ListIter[T]
obeys SlotIterator[T, ListIter[T]]
needs T: typename
    list: @List[T]
    index: U64

### Creates an iterator positioned before the first element of `list`.
### :param list: The list to walk.
### :returns: A new iterator at index `0`.
common routine ListIter[T].construct(list: @List[T]) -> Me
needs T: typename
    iter: Me = Me(list: list, index: 0)
    return iter

### Yields the next element and advances the iterator.
### :returns: The next element, front to back.
### :throws: Throws `AbsentValueError` after the last element has been yielded.
failable routine @ListIter[T].emit() -> T
needs T: typename
    local list: @List[T] = me.list.peek()
    local len: U64 = list.count()
    local index: U64 = me.index.peek()

    if index >= len
        throw AbsentValueError()
    value: T = list[index]
    me.index.poke(index + 1)
    return value

### Hands out the next element's slot and advances the iterator.
### :returns: The address of the next element, front to back.
### :throws: Throws `AbsentValueError` after the last element has been handed out.
failable routine @ListIter[T].next() -> @T
needs T: typename
    local list: @List[T] = me.list.peek()
    local index: U64 = me.index.peek()

    if index >= list.count()
        throw AbsentValueError()
    me.index.poke(index + 1)
    element: @T = list.getslot(index)
    return element
