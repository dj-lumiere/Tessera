# Tessera stdlib: the correctly rounded arc sine of B16
#
# Evaluated in B32: odd minimax polynomials on [0, 0.25] and [0.25, 0.5], and
# for |x| >= 0.5 the reduction asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2)). A
# handful of inputs whose B32 result would round wrongly are returned
# explicitly. Round to nearest only: |x| > 1, +-inf and NaN give the default
# NaN 0xFE00 (the original's NaN test never holds, so a NaN input takes the
# |x| > 1 path too).
#
# Ported from CORE-MATH, src/binary16/asin/asinf16.c via RazorForge's B16Asin.rf.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### arcsin(me), correctly rounded (a CORE-MATH port). |me| > 1, ±inf, and NaN give the default NaN 0xFE00.
### :returns: asin(`me`), in [-π/2, π/2].
routine B16.asin_unchecked() -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    local negative: Bool = u >> 31 == 1

    # NaN, infinity or |x| >= 1
    if au >= 0x3F800000
        if au == 0x3F800000
            return cm_b16_asin_signed(r: 0x1.921fb6p+0, positive: not negative)
        return Me.from_bits(0xFE00)
    reduction: (B32, U32, Bool, Bool) = when
        au >= 0x3F000000 =>
            # argument reduction: asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2))
            half_gap: B32 = B32.sub_unchecked(1.0, v.abs()) *! 0.5
            root: B32 = half_gap.sqrt_unchecked()
            becomes (root, root.bits() & 0x7FFFFFFF, true, v < 0.0)
        else => (v, au, false, negative)
    t, ta, reduce, x_neg = reduction

    # now 0 <= |t| <= 0.5 (the polynomials are odd, so a negative t needs no reduction)
    tt: B32 = t *! t
    positive: Bool = ta == me.to[B32]().bits()
    y: B32 = when
        ta < 0x3E800000 =>
            # |t| < 0.25
            # for |x| <= 0x1.71p-5, asin(x) rounds to x
            rounds_to_x: Bool = ta <= 0x3D388000 and not reduce
            when
                rounds_to_x and ta == 0 => return me
                rounds_to_x and positive => return (v +! 0x1p-26).to[Me]()
                rounds_to_x => return (v -! 0x1p-26).to[Me]()
                # |x| = 0x1.a6p-4
                ta == 0x3DD30000 => return cm_b16_asin_signed(r: 0x1.a6c00ap-4, positive)
                # |x| = 0x1.d1p-5
                ta == 0x3D688000 => return cm_b16_asin_signed(r: 0x1.d14004p-5, positive)
                # |x| = 0x1.f4p-4
                ta == 0x3DFA0000 => return cm_b16_asin_signed(r: 0x1.f5400ap-4, positive)
                else => pass
            # degree-5 odd polynomial for asin on [0, 0.25], evaluated as t + t^3 (c1 + c2 t^2)
            c1: B32 = B32.mul_add_unchecked(0x1.43696ep-4, a: tt, b: 0x1.552e8ep-3)
            becomes c1.mul_add_unchecked(a: tt *! t, b: t)
        else =>
            # 0.25 <= |t| <= 0.5
            when
                # |x| = 0x1.648p-2
                ta == 0x3EB24000 => return cm_b16_asin_signed(r: 0x1.6c2012p-2, positive)
                # |x| = 0x1.b2cp-2
                ta == 0x3ED96000 => return cm_b16_asin_signed(r: 0x1.c0fffap-2, positive)
                # |x| = 0x1.e14p-2
                ta == 0x3EF0A000 => return cm_b16_asin_signed(r: 0x1.f4fffp-2, positive)
                else => pass
            # degree-7 odd polynomial for asin on [0.25, 0.5]
            c5: B32 = B32.mul_add_unchecked(0x1.08e44p-4, a: tt, b: 0x1.258e54p-4)
            c1: B32 = B32.mul_add_unchecked(0x1.55a7ep-3, a: tt, b: 1.0)
            p: B32 = c5.mul_add_unchecked(a: tt *! tt, b: c1)
            becomes t *! p
    if not reduce
        return y.to[Me]()

    # argument reconstruction
    r: B32 = B32.sub_unchecked(0x1.921fb6p+0, y *! 2.0)
    if x_neg
        return (-r).to[Me]()
    return r.to[Me]()

### An explicitly listed arc sine result `r`, rounded to B16 and negated for a negative x.
### :param r: The result for the positive input.
### :param positive: Whether the input is positive.
### :returns: `r` rounded to B16, negated when `positive` is false.
secret routine cm_b16_asin_signed(r: B32, positive: Bool) -> B16
    h: B16 = r.to[B16]()
    if positive
        return h
    return -h
