// Tessera stdlib: the correctly rounded two-argument arc tangent of B16
//
// The B16 arguments widen exactly to B32 and run the B32 atan2 algorithm:
// atan2(y, x) is off + atan(z), with z = y/x or -x/y (whichever is at most 1)
// and off a multiple of pi/2 picked by the signs and which of |y|, |x| is
// larger. A degree-7/7 rational approximation in B64 settles most inputs. The
// rest go through a double-double polynomial, and a tiny ratio y/x through
// z - z^3/3. The final B64 value is rounded straight to B16 (never through
// B32, which would round twice). Round to nearest only. Zeros and infinities
// follow C99. A NaN comes back quiet, x's if both are NaN (as x86's x + y).
//
// Ported from CORE-MATH, src/binary16/atan2/atan2f16.c via RazorForge's B16Atan2.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca> and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// Offsets added to the reduced arc tangent, indexed by (sign y) 4 + (sign x) 2
/// + (|y| > |x|), as B64 bits: 0, pi/2, pi, pi/2, -0, -pi/2, -pi, -pi/2.
preset CM_B16_ATAN2_OFF: @Array[U64, 8] <- [0x0000000000000000, 0x3FF921FB54442D18,
    0x400921FB54442D18, 0x3FF921FB54442D18, 0x8000000000000000, 0xBFF921FB54442D18,
    0xC00921FB54442D18, 0xBFF921FB54442D18]

/// Low parts of the offsets above (pi/2 minus its B64 rounding, and twice that
/// for pi), as B64 bits.
preset CM_B16_ATAN2_OFFL: @Array[U64, 8] <- [0x0000000000000000, 0x3C91A62633145C07,
    0x3CA1A62633145C07, 0x3C91A62633145C07, 0x8000000000000000, 0xBC91A62633145C07,
    0xBCA1A62633145C07, 0xBC91A62633145C07]

/// Double-double coefficients (high, low interleaved) of the accurate atan(z)/z
/// polynomial in z^2, as B64 bits.
preset CM_B16_ATAN2_C: @Array[U64, 64] <- [0x3FF0000000000000, 0xBA88C1DAC5492248,
    0xBFD5555555555555, 0xBC755553BF3A2ABE, 0x3FC999999999999A, 0xBC699DEED1EC9071,
    0xBFC2492492492492, 0xBC5FD99C8D18269A, 0x3FBC71C71C71C717, 0xBC2651EEE4C4D9D0,
    0xBFB745D1745D1649, 0xBC5632683D6C44A6, 0x3FB3B13B13B11C63, 0x3C5BF69C1F8AF41D,
    0xBFB11111110E6338, 0x3C23C3E431E8BB68, 0x3FAE1E1E1DC45C4A, 0xBC4BE2DB05C77BBF,
    0xBFAAF286B8164B4F, 0x3C2A4673491F0942, 0x3FA86185E9AD4846, 0x3C4E12E32D79FCEE,
    0xBFA642C6D5161FAE, 0x3C43CE76C1CA03F0, 0x3FA47AD6F277E5BF, 0xBC3ABD8D85BDB714,
    0xBFA2F64A2EE8896D, 0x3C2EF87D4B615323, 0x3FA1A6A2B31741B5, 0x3C1A5D9D973547EE,
    0xBFA07FBDAD65E0A6, 0xBC265AC07F5D35F4, 0x3F9EE9932A9A5F8B, 0x3C2F8B9623F6F55A,
    0xBF9CE8B5B9584DC6, 0x3C2FE5AF96E8EA2D, 0x3F9AC9CB288087B7, 0xBC3450CDFCEAF5CA,
    0xBF984B025351F3E6, 0x3C2579561B0D73DA, 0x3F952F5B8ECDD52B, 0x3C3036BD2C6FBA47,
    0xBF9163A8C44909DC, 0x3C318F735FFB9F16, 0x3F8A400DCE3EEA6F, 0xBC2C90569C0C1B5C,
    0xBF81CAA78AE6DB3A, 0xBC24C60F8161EA09, 0x3F752672453C0731, 0x3C1834EFB598C338,
    0xBF65850C5BE137CF, 0xBC0445FC150CA7F5, 0x3F523EB98D22E1CA, 0xBBF388FBAF1D7830,
    0xBF38F4E974A40741, 0x3BD271198A97DA34, 0x3F1A5CF2E9CF76E5, 0xBBB887EB4A63B665,
    0xBEF420C270719E32, 0x3B8EFD595B27888B, 0x3EC3BA2D69B51677, 0xBB64FB06829CDFC7,
    0xBE829B7E6F676385, 0xBB2A783B6DE718FB]

/// A double-double number hi + lo.
record CmF16Atan2DD
    hi: B64
    lo: B64

/// The angle of the point (other, me), correctly rounded (a CORE-MATH port): me is y and other is x. Zeros
/// and infinities follow C99. A NaN comes back quiet, other's if both are NaN.
/// :param other: The x coordinate.
/// :returns: atan2(`me`, `other`), in [-π, π].
routine B16.atan2(me: Me, other: Me) -> Me
    local ux: U32 = other.to[B32]().bits()
    local uy: U32 = me.to[B32]().bits()
    local ax: U32 = ux & 0x7FFFFFFF
    local yneg: Bool = uy >> 31 != 0
    local sy: B64 = when
        yneg => -1.0
        else => 1.0
    local ay: U32 = uy & 0x7FFFFFFF

    special: Bool = ay >= 0x7F800000 or ax >= 0x7F800000
    when
        special => jump special()
        ay == 0 => jump y_zero()
        else => jump general(ay)

    // x or y is NaN or infinity: a NaN x wins over a NaN y, and the result is quiet
    block special()
        xnan: Bool = ax > 0x7F800000
        ynan: Bool = ay > 0x7F800000
        yinf: Bool = ay == 0x7F800000
        xinf: Bool = ax == 0x7F800000
        both: Bool = yinf and xinf
        xneg: Bool = ux >> 31 != 0
        when
            xnan => return Me.from_bits(other.bits() | 0x0200)
            ynan => return Me.from_bits(me.bits() | 0x0200)
            both => jump both_inf(xneg)
            xinf => jump x_inf(xneg)
            else => return B64.mul(1.5707963267948966, sy).to[Me]()

    // +-3pi/4 or +-pi/4
    block both_inf(xneg: Bool)
        if xneg
            return B64.mul(2.356194490192345, sy).to[Me]()
        else
            return B64.mul(0.7853981633974483, sy).to[Me]()

    block x_inf(xneg: Bool)
        if xneg
            return B64.mul(3.141592653589793, sy).to[Me]()
        else
            return B64.mul(0.0, sy).to[Me]()

    block y_zero()
        xzero: Bool = ax == 0
        when
            xzero => jump zeros()
            ux >> 31 == 0 => return B64.mul(0.0, sy).to[Me]()
            else => jump general(0)

    // both zero: +-0 or +-pi by the signs
    block zeros()
        y_slot: U32 = (uy >> 31) * 4
        iz: USize = (y_slot + (ux >> 31) * 2).to[USize]()
        off: B64 = B64.from_bits(CM_B16_ATAN2_OFF.getitem(iz))
        if ux >> 31 != 0
            return (off + B64.from_bits(CM_B16_ATAN2_OFFL.getitem(iz))).to[Me]()
        else
            return off.to[Me]()

    block general(y_abs: U32)
        gt: Bool = y_abs > ax
        gti: U32 = when
            gt => 1
            else => 0
        mg: B64 = when
            gt => 1.0
            else => 0.0
        mng: B64 = when
            gt => 0.0
            else => 1.0
        sg: B64 = when
            gt => -1.0
            else => 1.0
        y_slot: U32 = (uy >> 31) * 4
        sign_slot: U32 = y_slot + (ux >> 31) * 2
        i: USize = (sign_slot + gti).to[USize]()
        off: B64 = B64.from_bits(CM_B16_ATAN2_OFF.getitem(i))
        zx: B64 = other.to[B32]().to[B64]()
        zy: B64 = me.to[B32]().to[B64]()
        // z = x/y if |y| > |x|, and z = y/x otherwise
        num: B64 = mg * zx + mng * zy
        den: B64 = mg * zy + mng * zx
        z: B64 = num / den
        xbig: Bool = ax >= y_abs
        d: U32 = when
            xbig => ax -% y_abs
            else => y_abs -% ax
        if d < 0x0D800000
            jump rational(y_abs, gt, i, off, sg, z)
        else
            jump combine(y_abs, gt, i, off, sg, z, 1.0)

    // the exponents are close: a rational approximation of atan(z)/z
    block rational(y_abs: U32, gt: Bool, i: USize, off: B64, sg: B64, z: B64)
        z2: B64 = z * z
        z4: B64 = z2 * z2
        z8: B64 = z4 * z4
        cn0: B64 = z2 * 2.506848521335565 + 1.0
        cn2: B64 = z2 * 0.9227540611112051 + 2.2855336234350774
        cn4: B64 = z2 * 0.0093982071883745 + 0.15965700667756133
        cn6: B64 = 8.116266383809054e-05
        n0: B64 = z4 * cn2 + cn0
        n4: B64 = z4 * cn6 + cn4
        n: B64 = z8 * n4 + n0
        cd0: B64 = z2 * 2.840181854668896 + 1.0
        cd2: B64 = z2 * 1.5083284691366383 + 3.03226090832491
        cd4: B64 = z2 * 0.03311601651598859 + 0.35061013533424623
        cd6: B64 = 0.0008307046818566012
        d0: B64 = z4 * cd2 + cd0
        d4: B64 = z4 * cd6 + cd4
        d: B64 = z8 * d4 + d0
        jump combine(y_abs, gt, i, off, sg, z, n / d)

    block combine(y_abs: U32, gt: Bool, i: USize, off: B64, sg: B64, z: B64, r: B64)
        zr: B64 = z * sg * r
        res: B64 = zr + off
        biased_bits: U64 = res.bits() +% 8
        if biased_bits & 0xFFFFFFF <= 16
            jump check_tiny(y_abs, gt, i, off, sg)
        else
            return res.to[Me]()

    block check_tiny(y_abs: U32, gt: Bool, i: USize, off: B64, sg: B64)
        exponent_gap: U32 = ax -% y_abs >> 23
        // the exponents differ by 25 or more
        if y_abs < ax and exponent_gap >= 25
            return cm_b16_atan2_tiny(y: me.to[B32](), x: other.to[B32]())
        else
            jump accurate(gt, i, off, sg)

    // the fast path can't decide the rounding: redo it in double-double
    block accurate(gt: Bool, i: USize, off: B64, sg: B64)
        zx: B64 = other.to[B32]().to[B64]()
        zy: B64 = me.to[B32]().to[B64]()
        n: B64 = when
            gt => zx
            else => zy
        d: B64 = when
            gt => zy
            else => zx
        zh: B64 = n / d
        zl: B64 = zh.mul_add(a: -d, b: n) / d
        z2: CmF16Atan2DD = cm_b16_atan2_muldd(xh: zh, xl: zl, ch: zh, cl: zl)
        p0: CmF16Atan2DD = cm_b16_atan2_polydd(xh: z2.hi, xl: z2.lo)
        p: CmF16Atan2DD = cm_b16_atan2_muldd(xh: zh * sg, xl: zl * sg, ch: p0.hi, cl: p0.lo)
        offl: B64 = B64.from_bits(CM_B16_ATAN2_OFFL.getitem(i))
        sh: B64 = p.hi + off
        sh_err: B64 = off - sh + p.hi
        sl: B64 = sh_err + p.lo + offl
        th: B64 = sh.to[B32]().to[B64]()
        tm: B64 = sh - th + sl
        if th + th * 8.673617379884035e-19 == th - th * 8.673617379884035e-19
            jump nudge(th, tm)
        else
            return (th + tm).to[Me]()

    // th is so large that th +- th 2^-60 rounds to th: scale tm away from the rounding boundary
    block nudge(th: B64, tm: B64)
        th_exponent: U64 = th.bits() & 0x7FF0000000000000
        tthu: U64 = th_exponent -% 0x0180000000000000  // exponent of th, minus 24
        beyond: Bool = tm.abs() > B64.from_bits(tthu)
        scaled: B64 = when
            beyond => tm * 1.25
            else => tm * 0.75
        return (th + scaled).to[Me]()

/// Double-double product (xh + xl) (ch + cl).
/// :param xh: The first factor's high part.
/// :param xl: The first factor's low part.
/// :param ch: The second factor's high part.
/// :param cl: The second factor's low part.
/// :returns: The product as a double-double.
routine cm_b16_atan2_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF16Atan2DD
    ahlh: B64 = ch * xl
    alhh: B64 = cl * xh
    ahhh: B64 = ch * xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) + (alhh + ahlh)
    hi: B64 = ahhh + ahhl
    r: CmF16Atan2DD = CmF16Atan2DD(hi: hi, lo: ahhh - hi + ahhl)
    return r

/// The 32-term double-double polynomial of CM_B16_ATAN2_C at xh + xl, by Horner's rule.
/// :param xh: The argument's high part.
/// :param xl: The argument's low part.
/// :returns: The polynomial's value as a double-double.
routine cm_b16_atan2_polydd(xh: B64, xl: B64) -> CmF16Atan2DD
    local ch: @B64 <- .hollow()
    local cl: @B64 <- .hollow()

    B64.from_bits(CM_B16_ATAN2_C.getitem(62)).poke_into(ch)
    B64.from_bits(CM_B16_ATAN2_C.getitem(63)).poke_into(cl)

    i: USize = 31

    while i != 0
        i2: USize = i - 1
        m: CmF16Atan2DD = cm_b16_atan2_muldd(xh, xl, ch: ch.peek(), cl: cl.peek())
        c0: B64 = B64.from_bits(CM_B16_ATAN2_C.getitem(i2 * 2))
        c1: B64 = B64.from_bits(CM_B16_ATAN2_C.getitem(i2 * 2 + 1))
        th: B64 = m.hi + c0
        tl: B64 = c0 - th + m.hi
        next_cl: B64 = m.lo + (tl + c1)
        next_ch: B64 = th
        next_ch.poke_into(ch)
        next_cl.poke_into(cl)
    then
        return CmF16Atan2DD(hi: ch.peek(), lo: cl.peek())

/// atan2(y, x) for a tiny ratio y/x, from z - z^3/3 with z = y/x, rounded once to B16. When z sits on a
/// rounding boundary its last bit moves toward the correction so the rounding is not a tie.
/// :param y: The y coordinate.
/// :param x: The x coordinate.
/// :returns: The angle.
routine cm_b16_atan2_tiny(y: B32, x: B32) -> B16
    dy: B64 = y.to[B64]()
    dx: B64 = x.to[B64]()
    z: B64 = dy / dx
    e: B64 = (-z).mul_add(a: dx, b: dy)  // z x + e = y, so y/x = z + e/x
    zz: B64 = z * z
    cz: B64 = B64.mul(-0.3333333333333333, z)
    corr: B64 = e / dx + cz * zz
    t: U64 = z.bits()
    if t & 0xFFFFFFF == 0
        // z sits on a rounding boundary: move its last bit toward the correction so the final rounding is not a tie
        up: Bool = z * corr > 0.0
        u: U64 = when
            up => t +% 1
            else => t -% 1
        return B64.from_bits(u).to[B16]()
    else
        return z.to[B16]()
