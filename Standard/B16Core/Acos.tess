// Tessera stdlib: the correctly rounded arc cosine of B16
//
// Evaluated in B32 on t = |x|: degree-4 minimax polynomials for acos on
// [0, 0.25] and [0.25, 0.5], and for acos(t)/sqrt(1 - t) on [0.5, 1]. A
// negative x uses acos(x) = pi - acos(-x). The coefficients were tuned to
// leave only a few exceptional inputs, handled explicitly. Round to nearest
// only: |x| > 1, +-inf and NaN give the default NaN 0xFE00 (the original's NaN
// test never holds, so a NaN input takes the |x| > 1 path too).
//
// Ported from CORE-MATH, src/binary16/acos/acosf16.c via RazorForge's B16Acos.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// arccos(me), correctly rounded (a CORE-MATH port). |me| > 1, ±inf, and NaN give the default NaN 0xFE00.
/// :returns: acos(`me`), in [0, π].
routine B16.acos(me: Me) -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    local negative: Bool = u >> 31 == 1
    local t: B32 = v.abs()
    local tt: B32 = t * t

    // NaN, infinity or |x| >= 1
    when
        au >= 0x3F800000 => jump outside()
        au < 0x3E800000 => jump below_quarter()
        au < 0x3F000000 => jump below_half()
        else => jump above_half()

    block outside()
        one: Bool = au == 0x3F800000
        when
            one and negative => return B32.to[Me](3.1415927410125732)
            one => return Me.from_bits(0)
            else => return Me.from_bits(0xFE00)

    // |x| < 0.25
    block below_quarter()
        c1: B32 = B32.mul_add(-0.001121144276112318, a: t, b: -0.9999638795852661)
        c3: B32 = B32.mul_add(-0.05180126801133156, a: t, b: -0.15466514229774475)
        y: B32 = c3.mul_add(a: tt, b: c1).mul_add(a: t, b: 1.570796251296997)
        if negative
            jump below_quarter_negative(y)
        else
            return y.to[Me]()

    // pi - acos(-x), except for the inputs the tuned coefficients could not fix
    block below_quarter_negative(y: B32)
        // x = -0x1.2cp-18, -0x1.3p-18 or -0x1.34p-18
        when
            au.between(lo: 0x36960000, hi: 0x369A0000) => return B32.to[Me](1.5708009004592896)
            u == 0xBCF80000 => return B32.to[Me](1.6010743379592896)
            u == 0xBCFC0000 => return B32.to[Me](1.6015628576278687)
            else => return B32.sub(3.141592502593994, y).to[Me]()

    // x = -0x1.fp-6
    // x = -0x1.f8p-6

    // 0.25 <= |x| < 0.5
    block below_half()
        c1: B32 = B32.mul_add(-0.10864660888910294, a: t, b: -0.9786818623542786)
        c3: B32 = B32.mul_add(-0.27444466948509216, a: t, b: 0.09330496937036514)
        jump narrow(c3.mul_add(a: tt, b: c1).mul_add(a: t, b: 1.569190502166748))

    // 0.5 <= |x| < 1: acos(t) = sqrt(1 - t) p(t)
    block above_half()
        c1: B32 = B32.mul_add(0.0745583027601242, a: t, b: -0.21013711392879486)
        c3: B32 = B32.mul_add(0.004472453147172928, a: t, b: -0.024903178215026855)
        p: B32 = c3.mul_add(a: tt, b: c1).mul_add(a: t, b: 1.5702226161956787)
        root: B32 = B32.sub(1.0, t).sqrt()
        jump narrow(root * p)

    block narrow(y: B32)
        if negative
            return B32.sub(3.141592502593994, y).to[Me]()
        else
            return y.to[Me]()
