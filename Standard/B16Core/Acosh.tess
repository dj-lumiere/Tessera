// Tessera stdlib: the correctly rounded inverse hyperbolic cosine of B16
//
// Evaluated in B32 with one degree-5 polynomial per binade [2^i, 2^(i+1)):
// below 32 it approximates acosh(x)/sqrt(x - 1), above that acosh(x) itself.
// The inputs the polynomials round wrongly are returned explicitly. Round to
// nearest only: acosh(1) = +0, x < 1 and -inf give the default NaN 0xFE00,
// +inf maps to itself, and NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary16/acosh/acoshf16.c via RazorForge's B16Acosh.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// Row i holds 6 coefficients, as B32 bits: a degree-5 polynomial on [2^i, 2^(i+1))
/// approximating acosh(x)/sqrt(x - 1) for i < 5 and acosh(x) for 5 <= i < 16.
preset CM_B16_ACOSH_P: @Array[U32, 96] <- [0x3FC8CA05, 0xBE50F729, 0x3D86E325, 0xBCA29884,
    0x3B820523, 0xB9C018CC, 0x3FC75AFD, 0xBE362951, 0x3D26EEE0, 0xBBF4F4AE, 0x3A5B4BD9, 0xB82D96FA,
    0x3FC2A7AD, 0xBE08F094, 0x3C9B1303, 0xBAFD91D8, 0x38F16818, 0xB64690F5, 0x3FB8B991, 0xBDB046BA,
    0x3BE1E759, 0xB9C42CEA, 0x37414704, 0xB4227559, 0x3FA958DA, 0xBD473056, 0x3B097281, 0xB8774433,
    0x357886C9, 0xB1D38F9F, 0x400DA0BB, 0x3DE2C7E8, 0xBB1EA48E, 0x3812272C, 0xB495ACF3, 0x30814B41,
    0x403A229B, 0x3D626A01, 0xBA1E3C3D, 0x3691ADAC, 0xB2951BAE, 0x2E00BE75, 0x40668B75, 0x3CE24860,
    0xB91E13EF, 0x35117B86, 0xB094DC87, 0x2B807E93, 0x4089763A, 0x3C623AF2, 0xB81E02ED, 0x33916596,
    0xAE94C025, 0x2900614D, 0x409FA63F, 0x3BE22EED, 0xB71DF280, 0x32114F39, 0xAC94A1F8, 0x26804112,
    0x40B5D528, 0x3B622ABB, 0xB61DECC4, 0x309147B7, 0xAA949847, 0x240036E8, 0x40CC0441, 0x3AE224D4,
    0xB51DE4A2, 0x2F113C70, 0xA89488DD, 0x21802698, 0x40E23332, 0x3A622003, 0xB41DDDE8, 0x2D91332F,
    0xA6947C52, 0x1F001930, 0x40F8626B, 0x39E21923, 0xB31DD435, 0x2C1125B1, 0xA49469CF, 0x1C800523,
    0x41074896, 0x396215A7, 0xB21DCF5A, 0x2A911F08, 0xA29460D0, 0x19FFF71E, 0x41125FE6, 0x38E21318,
    0xB11DCBDC, 0x29111A3D, 0xA0945A62, 0x177FE976]

/// acosh(me), correctly rounded (a CORE-MATH port): +0 at 1, the default NaN 0xFE00 below 1 and at -inf,
/// +inf at +inf, and a NaN comes back quiet.
/// :returns: acosh(`me`).
routine B16.acosh(me: Me) -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF

    special: Bool = au >= 0x7F800000
    at_most1: Bool = u >= 0x80000000 or au <= 0x3F800000
    // x <= 1
    biased_exponent: U32 = au >> 23
    when
        special =>
            // +inf or NaN: x + x (quiets a signaling NaN), and -inf has no real result
            if u == 0x7F800000 or au & 0x7FFFFF != 0
                return me + me
            else
                return Me.from_bits(0xFE00)
        at_most1 =>
            // acosh(1) = +0, and below 1 there is no real result (the default NaN of x86)
            if u == 0x3F800000
                return Me.from_bits(0)
            else
                return Me.from_bits(0xFE00)
        else =>
            // 2^i <= x < 2^(i+1)
            i: USize = (biased_exponent - 127).to[USize]()
            tt: B32 = v * v
            c4: B32 = cm_b16_acosh_p(i, k: 5).mul_add(a: v, b: cm_b16_acosh_p(i, k: 4))
            c2: B32 = cm_b16_acosh_p(i, k: 3).mul_add(a: v, b: cm_b16_acosh_p(i, k: 2))
            d2: B32 = c4.mul_add(a: tt, b: c2)
            c0: B32 = cm_b16_acosh_p(i, k: 1).mul_add(a: v, b: cm_b16_acosh_p(i, k: 0))
            p: B32 = d2.mul_add(a: tt, b: c0)
            // for x < 32 the polynomial approximates acosh(x) / sqrt(x - 1)
            below32: Bool = i < 5
            y: B32 = when
                below32 =>
                    root: B32 = (v - 1.0).sqrt()
                    becomes root * p
                else => p
            // the inputs the polynomials round wrongly
            when
                u == 0x40422000 => return B32.to[Me](1.774413824081421)
                u == 0x411C0000 => return B32.to[Me](2.9677741527557373)
                u == 0x415F6000 => return B32.to[Me](3.328125238418579)
                u == 0x41BFE000 => return B32.to[Me](3.870114803314209)
                u == 0x41C04000 => return B32.to[Me](3.8720691204071045)
                u == 0x41DBC000 => return B32.to[Me](4.00586462020874)
                u == 0x41D3C000 => return B32.to[Me](3.968755006790161)
                u == 0x42374000 => return B32.to[Me](4.517584800720215)
                u == 0x4245C000 => return B32.to[Me](4.593754291534424)
                u == 0x42890000 => return B32.to[Me](4.919927597045898)
                u == 0x429D6000 => return B32.to[Me](5.058590888977051)
                u == 0x433D2000 => return B32.to[Me](5.935548305511475)
                u == 0x43884000 => return B32.to[Me](6.300782203674316)
                u == 0x43F9A000 => return B32.to[Me](6.906253337860107)
                u == 0x443B0000 => return B32.to[Me](7.310549736022949)
                u == 0x45B78000 => return B32.to[Me](9.371097564697266)
                u == 0x4673A000 => return B32.to[Me](10.347660064697266)
                else => return y.to[Me]()

/// Coefficient k of the acosh polynomial for binade index i.
/// :param i: The binade index, 0 to 15.
/// :param k: The coefficient, 0 to 5.
/// :returns: The coefficient.
/// :throws: Crashes with `IndexOutOfBoundsError` when `i * 6 + k` is past the table.
private routine cm_b16_acosh_p(i: USize, k: USize) -> B32
    return B32.from_bits(CM_B16_ACOSH_P.getitem(i * 6 + k))
