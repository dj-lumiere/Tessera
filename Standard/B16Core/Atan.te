# Tessera stdlib: the correctly rounded arc tangent of B16
#
# Evaluated in B32 on t = |x|, reduced to [0, 1] by atan(t) = pi/2 - atan(1/t),
# with an odd degree-7 minimax polynomial on [0, 0.25] and degree-4 ones on
# [0.25, 0.5], [0.5, 0.75] and [0.75, 1]. The coefficients were tuned to leave
# only three exceptional inputs, handled explicitly. Round to nearest only:
# +-inf gives +-pi/2 rounded, NaN comes back quiet with its sign and payload.
#
# Ported from CORE-MATH, src/binary16/atan/atanf16.c via RazorForge's B16Atan.rf.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### arctan(me), correctly rounded (a CORE-MATH port): ±inf gives ±π/2 rounded, and a NaN comes back quiet with
### its sign and payload.
### :returns: atan(`me`), in [-π/2, π/2].
routine B16.atan(me: Me) -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    # for x < 0, atan(-x) = -atan(x)
    local neg: Bool = u >> 31 == 1
    local s: B32 = when

        neg => -1.0
        else => 1.0

    # NaN or infinity
    if au >= 0x7F800000
        if au == 0x7F800000
            return cm_b16_atan_signed(r: 0x1.921fb6p+0, positive: au == u)
        return Me.from_bits(me.bits() | 0x0200)
    abs_x: B32 = v * s
    # for x > 1, atan(x) = pi/2 - atan(1/x)
    reduce: Bool = au > 0x3F800000
    t: B32 = when
        reduce => B32.truediv(1.0, abs_x)
        else => abs_x

    # now 0 <= t <= 1
    tt: B32 = t * t
    y: B32 = when
        t <= 0.25 =>
            # for |x| < 0x1.d14p-6, atan(x) rounds to x
            rounds_to_x: Bool = not reduce and t <= 0x1.d14p-6
            positive: Bool = au == u
            when
                rounds_to_x and au == 0 => return me
                rounds_to_x =>
                    st: B32 = s * t
                    return st.mul_add(a: -0x1p-23, b: st).to[Me]()
                # |x| = 0x1.ad4p-3
                au == 0x3E56A000 => return cm_b16_atan_signed(r: 0x1.a72002p-3, positive)
                # |x| = 0x1.2b8p+3
                au == 0x4115C000 => return cm_b16_atan_signed(r: 0x1.76dffep+0, positive)
                # |x| = 0x1.864p+6
                au == 0x42C32000 => return cm_b16_atan_signed(r: 0x1.8f7ffep+0, positive)
                else => pass
            # an odd degree-7 polynomial on [0, 0.25]
            c5: B32 = B32.mul_add(-0x1.0c7c54p-3, a: tt, b: 0x1.98d0ep-3)
            c1: B32 = B32.mul_add(-0x1.55546cp-2, a: tt, b: 0x1.fffffcp-1)
            c: B32 = c5.mul_add(a: tt * tt, b: c1)
            becomes t * c
        # the degree-4 polynomial p0 + p1 t + ... + p4 t^4 for the subinterval holding t
        t <= 0.5 =>
            c3: B32 = B32.mul_add(0x1.81dd3ep-3, a: t, b: -0x1.a6fc96p-2)
            c2: B32 = c3.mul_add(a: t, b: 0x1.1ee64cp-6)
            y0: B32 = B32.mul_add(0x1.ff076cp-1, a: t, b: 0x1.411612p-14)
            becomes c2.mul_add(a: tt, b: y0)
        t <= 0.75 =>
            c3: B32 = B32.mul_add(0x1.a5eb88p-4, a: t, b: -0x1.e70ab4p-3)
            c2: B32 = c3.mul_add(a: t, b: -0x1.e652e2p-4)
            y0: B32 = B32.mul_add(0x1.0bad76p+0, a: t, b: -0x1.95964cp-8)
            becomes c2.mul_add(a: tt, b: y0)
        else =>
            c3: B32 = B32.mul_add(0x1.6aa268p-6, a: t, b: 0x1.d18c96p-13)
            c2: B32 = c3.mul_add(a: t, b: -0x1.882376p-2)
            y0: B32 = B32.mul_add(0x1.2d3d1p+0, a: t, b: -0x1.f75b16p-6)
            becomes c2.mul_add(a: tt, b: y0)

    # argument reconstruction
    r: B32 = when
        reduce => B32.sub(0x1.921fb6p+0, y)
        else => y
    if s < 0.0
        return (-r).to[Me]()
    return r.to[Me]()

### An explicitly listed arc tangent result `r`, rounded to B16 and negated for a negative x.
### :param r: The result for the positive input.
### :param positive: Whether the input is positive.
### :returns: `r` rounded to B16, negated when `positive` is false.
secret routine cm_b16_atan_signed(r: B32, positive: Bool) -> B16
    h: B16 = r.to[B16]()
    if positive
        return h
    return -h
