### `me`^`exponent`, correctly rounded (to nearest), with the C pow special cases: overflow gives +-inf, a negative
### base with a non-integer exponent gives NaN, x^+-0 = 1 and 1^y = 1 (except for a signaling NaN), (-1)^+-inf = 1,
### and NaN comes back quiet.
### :param exponent: The power to raise `me` to.
### :returns: `me`^`exponent`.
routine B16.powf(me: Me, exponent: Me) -> Me
    local xu: U32 = me.bits().to[U32]()
    local yu: U32 = exponent.bits().to[U32]()
    local xa: U32 = xu & 0x7FFF
    local ya: U32 = yu & 0x7FFF

    values: (U32, U64) = when
        xa == 0x3C00 =>
            # |x| = 1
            # y = ±inf or NaN
            # x = ±inf, NaN, or x < 0
            if xu >> 15 == 1
                # (-1)^y: ±1 for an integer y, NaN otherwise
                when
                    ya > 0x7C00 => return exponent + exponent
                    cm_b16_pow_is_int(yu) =>
                        if cm_b16_pow_is_odd(yu)
                            return me
                        else
                            return -me
                    else => return Me.from_bits(0xFE00)
            # 1^y = 1, except for a signaling NaN y
            else if ya > 0x7C00 and yu & 0x0200 == 0
                return exponent + exponent
            else
                return me
        ya == 0 =>
            # x^0 = 1, except for a signaling NaN x
            if xa > 0x7C00 and xu & 0x0200 == 0
                return me + me
            else
                return 1.0
        ya >= 0x7C00 =>
            # |x| = 1 was handled above
            when
                xa > 0x7C00 => return me + me
                ya == 0x7C00 =>
                    # 0 when |x| < 1 and y = +inf or |x| > 1 and y = -inf, else +inf
                    small: Bool = xa < 0x3C00
                    if small != (yu >> 15 == 1)
                        return Me.from_bits(0x0000)
                    else
                        return Me.INFINITY
                else => return exponent + exponent
        xa == 0 =>
            # x = ±0: a signed zero or infinity, negative only for -0 and an odd integer y
            odd_neg: Bool = cm_b16_pow_is_odd(yu) & (xu >> 15 != 0)
            neg_y: Bool = yu >> 15 == 1
            when
                neg_y and odd_neg => return Me.NEG_INFINITY
                neg_y => return Me.INFINITY
                odd_neg => return Me.from_bits(0x8000)
                else => return Me.from_bits(0x0000)
        xu >= 0x7C00 =>
            when
                xa == 0x7C00 =>
                    # ±inf: the sign survives only for an odd y, and a negative y gives a zero
                    odd: Bool = cm_b16_pow_is_odd(yu)
                    signed: U32 = when
                        odd => xu
                        else => xu & 0x7FFF
                    neg_y: Bool = yu >> 15 == 1
                    r: U32 = when
                        neg_y => signed & 0x8000
                        else => signed
                    return Me.from_bits(r.to[U16]())
                xa > 0x7C00 => return me + me
                else =>
                    # x < 0: NaN for a non-integer y, else |x|^y with the sign of an odd y
                    if not cm_b16_pow_is_int(yu)
                        return Me.from_bits(0xFE00)
                    odd: Bool = cm_b16_pow_is_odd(yu)
                    sign: U64 = when
                        odd => 0x8000000000000000
                        else => 0
                    becomes (xa, sign)
        else => (xu, 0)

    xm, sign = values

    # the inputs the approximation rounds wrongly (xm = |x| from here on)
    when
        xm == 0x1C94 and yu == 0x31BC => return B32.sub(0x1.848p-2, 0x1p-14).to[Me]()
        xm == 0x537B and yu == 0x25BF => return B32.sub(0x1.18cp+0, 0x1p-12).to[Me]()
        xm == 0x756B and yu == 0x112E => return B32.sub(0x1.01cp+0, 0x1p-12).to[Me]()
        xm == 0x0D36 and yu == 0x2316 => return B32.add(0x1.cap-1, 0x1p-13).to[Me]()
        xm == 0x273B and yu == 0x38B3 => return B32.add(0x1.f8p-4, 0x1p-16).to[Me]()
        xm == 0x32BB and yu == 0x4242 => return B32.add(0x1.f2cp-8, 0x1p-20).to[Me]()
        xm == 0x4D47 and yu == 0x9D5F => return B64.sub(0x1.f8p-1, 0x1p-13).to[Me]()
        xm == 0x2E27 and yu == 0xC107 => return B64.sub(0x1.688p+8, 0x1p-4).to[Me]()
        xm == 0x14CB and yu == 0xBE46 => return B64.sub(0x1.35cp+15, 0x1p-3).to[Me]()
        xm == 0x7ABF and yu == 0x8CC5 => return B64.sub(0x1.fe8p-1, 0x1p-13).to[Me]()
        xm == 0x650C and yu == 0x9BED => return B64.add(0x1.f2p-1, 0x1p-13).to[Me]()
        xm == 0x29A0 and yu == 0xB5CF => return B64.add(0x1.8ep+1, 0x1p-11).to[Me]()
        xm == 0x17E9 and yu == 0xB1CF => return B64.add(0x1.8ep+1, 0x1p-11).to[Me]()
        xm == 0x5988 and yu == 0x9443 => return B64.add(0x1.fd4p-1, 0x1p-13).to[Me]()
        else =>
            xd: B64 = Me.from_bits(xm.to[U16]()).to[B64]()
            isex: U64 = cm_b16_pow_is_exact(xu: xm, yu, y: exponent)
            # x = 2^E with an integer y E in range: the exact power of two
            ret: U64 = when
                isex > 0xFF => isex
                else =>
                    ret: U64 = cm_b16_pow_exp(cm_b16_pow_log(xd) * exponent.to[B64]()).bits()
                    if isex != 0
                        # y = n / 2^F in a small set: when the result is exact, round away the approximation error
                        rounded: U64 = ret +% 0x0000010000000000 & 0xFFFFFE0000000000
                        test1: U64 = cm_b16_pow_fast(x: xd, y: isex >> 4).bits()
                        test2: U64 = cm_b16_pow_fast(x: B64.from_bits(rounded),
                            y: isex & 0xF).bits()
                        exact: Bool = test1 == test2
                        r: U64 = when
                            exact => rounded
                            else => ret
                        becomes r
                    else
                        becomes ret
            return B64.from_bits(ret +% sign).to[Me]()

### Whether the B16 value with bits `u` is an integer (zero counts).
### :param u: The B16 bits, widened to U32.
### :returns: True for an integer or a zero.
secret routine cm_b16_pow_is_int(u: U32) -> Bool
    zero: Bool = u & 0x7FFF == 0
    exponent: U32 = (u & 0x7FFF) >> 10
    int: Bool = exponent >= U32.sub(25, (u | 0x400).trailing_zeros())
    return zero or int

### Whether the B16 value with bits `u` is an odd integer.
### :param u: The B16 bits, widened to U32.
### :returns: True for an odd integer.
secret routine cm_b16_pow_is_odd(u: U32) -> Bool
    nonzero: Bool = u & 0x7FFF != 0
    exponent: U32 = (u & 0x7FFF) >> 10
    odd: Bool = exponent == U32.sub(25, (u | 0x400).trailing_zeros())
    return nonzero and odd

### Classifies the inputs whose power may be exactly representable: a power of two x = 2^E with -25 <= y E <= 15 and
### y E an integer, or y in {1/4, 1/2, 3/4, 1, 5/4, 3/2, 7/4, 2, 5/2, 3, 7/2, 4, 5, 6, 7}.
### :param xu: The bits of |x|.
### :param yu: The bits of `y`.
### :param y: The exponent.
### :returns: The B64 bits of 2^(y E) for a power of two, (n << 4) + 2^F for y = n / 2^F in the set, else 0.
secret routine cm_b16_pow_is_exact(xu: U32, yu: U32, y: B16) -> U64
    local yexp: U32 = (yu >> 10) & 0x1F
    local yexp_tz: U32 = yexp + (yu | 0x400).trailing_zeros()

    e: S32 = when
        xu & 0x3FF == 0 =>
            # x = 2^E with E >= -14
            biased_exponent: U32 = xu >> 10
            becomes biased_exponent.to[S32]() - 15
        else =>
            # x = 2^E with E < -14 when x has a single bit set
            zero_count: U32 = xu.trailing_zeros() + xu.leading_zeros()
            if not (zero_count == 31)
                return cm_b16_pow_exact_fraction(yu)
            low_zeros: S32 = xu.trailing_zeros().to[S32]()
            becomes low_zeros - 24
    ye_float: B32 = e.to[B32]() * y.to[B32]()
    ye: S32 = ye_float.to[S32]()
    integral: Bool = yexp_tz + e.to_wrap[U32]().trailing_zeros() >= 25
    in_range: Bool = ye.between(lo: -25, hi: 15)
    if not (integral and in_range)
        return cm_b16_pow_exact_fraction(yu)
    biased_power: S64 = S64.add(0x3FF, ye.to[S64]())
    return biased_power.to_wrap[U64]() << 52

### Classifies the exponents y = n / 2^F in {1/4, 1/2, 3/4, 1, 5/4, 3/2, 7/4, 2, 5/2, 3, 7/2, 4, 5, 6, 7}, for which
### x^y may be exactly representable.
### :param yu: The bits of `y`.
### :returns: (n << 4) + 2^F for a `y` in the set, else 0.
secret routine cm_b16_pow_exact_fraction(yu: U32) -> U64
    if not (yu & 0xFF == 0)
        return 0
    when yu
        0x3400 => return 0x14
        0x3800 => return 0x12
        0x3A00 => return 0x34
        0x3C00 => return 0x11
        0x3D00 => return 0x54
        0x3E00 => return 0x32
        0x3F00 => return 0x74
        0x4000 => return 0x21
        0x4100 => return 0x52
        0x4200 => return 0x31
        0x4300 => return 0x72
        0x4400 => return 0x41
        0x4500 => return 0x51
        0x4600 => return 0x61
        0x4700 => return 0x71
        else => return 0

### x^y for 0 <= y < 8 by square-and-multiply (three bits of y, as in the original).
### :param x: The base.
### :param y: The exponent, below 8.
### :returns: `x`^`y`, rounded at each product.
secret routine cm_b16_pow_fast(x: B64, y: U64) -> B64
    r0: B64 = 1.0
    m4: B64 = r0 * x
    r1: B64 = when
        y & 4 != 0 => m4
        else => r0
    s1: B64 = r1 * r1
    m2: B64 = s1 * x
    r2: B64 = when
        y & 2 != 0 => m2
        else => s1
    s2: B64 = r2 * r2
    m1: B64 = s2 * x
    r: B64 = when
        y & 1 != 0 => m1
        else => s2
    return r

### ln(x) for a positive normal B64 `x`, from a 64-entry table and a polynomial.
### :param x: The argument, positive and normal.
### :returns: The approximation of ln(`x`).
secret routine cm_b16_pow_log(x: B64) -> B64
    u: U64 = x.bits()
    biased_exponent: U64 = u >> 52
    expo: S64 = biased_exponent.to[S64]() - 1023
    top_bits: U64 = (u & 0x000FC00000000000) >> 46
    i: USize = top_bits.to[USize]()
    low_mantissa: B64 = (u & 0x3FFFFFFFFFFF).to[B64]()
    r0: B64 = low_mantissa * B64.from_bits(CM_B16_POW_LOG_TL.getitem(i))
    p3: B64 = B64.mul_add(0x1.999999999999ap-3, a: r0, b: -0.25)
    p2: B64 = p3.mul_add(a: r0, b: 0x1.5555555555555p-2)
    p1: B64 = p2.mul_add(a: r0, b: -0.5)
    p0: B64 = p1.mul_add(a: r0, b: 1.0)
    r: B64 = r0 * p0
    tb: B64 = B64.from_bits(CM_B16_POW_LOG_TB.getitem(i))
    return B64.mul_add(0x1.62e42fefa39efp-1, a: expo.to[B64](), b: tb + r)

### e^x, saturated below at 2^-25 and above at 2^16 (both beyond the B16 range), from a 64-entry table and a
### polynomial. -inf gives 0, and NaN or +inf gives `x + x`. B16.powf only passes it log(x) y for finite x and y,
### which stays below 2^21 in magnitude, so these cases are for the routine's own sake.
### :param x: The argument.
### :returns: The approximation of e^`x`.
secret routine cm_b16_pow_exp(x: B64) -> B64
    local u: U64 = x.bits()

    # NaN or infinity
    when
        u & 0x7FF0000000000000 == 0x7FF0000000000000 =>
            # x < -0x1.1542457337d44p+4
            # the original's -inf test compared the bits against 0xff << 25, which never matches: -inf's bits are tested
            if u == 0xFFF0000000000000
                return 0.0
            else
                return x + x
        u > 0xC031542457337D44 => return 0x1p-25
        x > 0x1.62e42fefa39efp+3 => return B64.add(0x1.ffcp+15, 0x1p+5)
        else =>
            j: B64 = B64.mul(0x1.71547652b82fep+6, x).round_ties_even()
            jint: S64 = j.to[S64]()
            slot: U64 = jint.to_wrap[U64]() & 0x3F
            i: USize = slot.to[USize]()
            xp: B64 = B64.mul_add(-0x1.62e42fefa39efp-7, a: j, b: x)
            p2: B64 = B64.mul_add(0x1.55555555555p-3, a: xp, b: 0.5)
            p1: B64 = p2.mul_add(a: xp, b: 1.0)
            p0: B64 = p1.mul_add(a: xp, b: 1.0)
            ret: U64 = (p0 * B64.from_bits(CM_B16_POW_EXP_TB.getitem(i))).bits()
            scale_exponent: U64 = (jint >> 6).to_wrap[U64]()
            return B64.from_bits(ret +% (scale_exponent << 52))
