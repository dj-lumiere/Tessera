// Tessera stdlib: the correctly rounded arc sine of B16
//
// Evaluated in B32: odd minimax polynomials on [0, 0.25] and [0.25, 0.5], and
// for |x| >= 0.5 the reduction asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2)). A
// handful of inputs whose B32 result would round wrongly are returned
// explicitly. Round to nearest only: |x| > 1, +-inf and NaN give the default
// NaN 0xFE00 (the original's NaN test never holds, so a NaN input takes the
// |x| > 1 path too).
//
// Ported from CORE-MATH, src/binary16/asin/asinf16.c via RazorForge's B16Asin.rf.
// Copyright (c) 2025 Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// arcsin(me), correctly rounded (a CORE-MATH port). |me| > 1, ±inf, and NaN give the default NaN 0xFE00.
/// :returns: asin(`me`), in [-π/2, π/2].
routine B16.asin(me: Me) -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    local negative: Bool = u >> 31 == 1

    outside: Bool = au >= 0x3F800000

    // NaN, infinity or |x| >= 1
    when
        outside => jump outside()
        au >= 0x3F000000 => jump reduce()
        else => jump reduced(v, au, false, negative)

    block outside()
        if au == 0x3F800000
            jump signed(1.5707963705062866, not negative)
        else
            return Me.from_bits(0xFE00)

    // argument reduction: asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2))
    block reduce()
        half_gap: B32 = B32.sub(1.0, v.abs()) * 0.5
        t: B32 = half_gap.sqrt()
        jump reduced(t, t.bits() & 0x7FFFFFFF, true, v < 0.0)

    // now 0 <= |t| <= 0.5 (the polynomials are odd, so a negative t needs no reduction)
    block reduced(t: B32, ta: U32, reduce: Bool, x_neg: Bool)
        tt: B32 = t * t
        positive: Bool = ta == me.to[B32]().bits()
        if ta < 0x3E800000
            jump below_quarter(t, tt, ta, reduce, x_neg, positive)
        else
            jump above_quarter(t, tt, ta, reduce, x_neg, positive)

    // |t| < 0.25
    block below_quarter(t: B32, tt: B32, ta: U32, reduce: Bool, x_neg: Bool, positive: Bool)
        when
            ta <= 0x3D388000 and not reduce => jump tiny(ta, positive)
            ta == 0x3DD30000 => jump signed(0.10321048647165298, positive)
            ta == 0x3D688000 => jump signed(0.0567932203412056, positive)
            ta == 0x3DFA0000 => jump signed(0.12237552553415298, positive)
            else => pass
        // |x| = 0x1.a6p-4
        // |x| = 0x1.d1p-5
        // |x| = 0x1.f4p-4
        // degree-5 odd polynomial for asin on [0, 0.25], evaluated as t + t^3 (c1 + c2 t^2)
        c1: B32 = B32.mul_add(0.07895796746015549, a: tt, b: 0.16659270226955414)
        jump result(c1.mul_add(a: tt * t, b: t), reduce, x_neg)

    // for |x| <= 0x1.71p-5, asin(x) rounds to x
    block tiny(ta: U32, positive: Bool)
        when
            ta == 0 => return me
            positive => return (v + 1.4901161193847656e-08).to[Me]()
            else => return (v - 1.4901161193847656e-08).to[Me]()

    // 0.25 <= |t| <= 0.5
    block above_quarter(t: B32, tt: B32, ta: U32, reduce: Bool, x_neg: Bool, positive: Bool)
        when
            ta == 0x3EB24000 => jump signed(0.3555910885334015, positive)
            ta == 0x3ED96000 => jump signed(0.43847647309303284, positive)
            ta == 0x3EF0A000 => jump signed(0.4892575740814209, positive)
            else => pass
        // |x| = 0x1.648p-2
        // |x| = 0x1.b2cp-2
        // |x| = 0x1.e14p-2
        // degree-7 odd polynomial for asin on [0.25, 0.5]
        c5: B32 = B32.mul_add(0.06467080116271973, a: tt, b: 0.07166893780231476)
        c1: B32 = B32.mul_add(0.1668241024017334, a: tt, b: 1.0)
        p: B32 = c5.mul_add(a: tt * tt, b: c1)
        jump result(t * p, reduce, x_neg)

    block result(y: B32, reduce: Bool, x_neg: Bool)
        if reduce
            jump reconstruct(y, x_neg)
        else
            return y.to[Me]()

    // argument reconstruction
    block reconstruct(y: B32, x_neg: Bool)
        r: B32 = B32.sub(1.5707963705062866, y * 2.0)
        if x_neg
            return (-r).to[Me]()
        else
            return r.to[Me]()

    // an explicit result r, negated for a negative x
    block signed(r: B32, positive: Bool)
        h: Me = r.to[Me]()
        if positive
            return h
        else
            return -h
