# Tessera stdlib: the correctly rounded arc tangent of B16
#
# Evaluated in B32 on t = |x|, reduced to [0, 1] by atan(t) = pi/2 - atan(1/t),
# with an odd degree-7 minimax polynomial on [0, 0.25] and degree-4 ones on
# [0.25, 0.5], [0.5, 0.75] and [0.75, 1]. The coefficients were tuned to leave
# only three exceptional inputs, handled explicitly. Round to nearest only:
# +-inf gives +-pi/2 rounded, NaN comes back quiet with its sign and payload.
#
# Ported from CORE-MATH, src/binary16/atan/atanf16.c via RazorForge's B16Atan.rf.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### arctan(me), correctly rounded (a CORE-MATH port): ±inf gives ±π/2 rounded, and a NaN comes back quiet with
### its sign and payload.
### :returns: atan(`me`), in [-π/2, π/2].
routine B16.atan(me: Me) -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    # for x < 0, atan(-x) = -atan(x)
    local neg: Bool = u >> 31 == 1
    local s: B32 = when
        neg => -1.0
        else => 1.0

    # NaN or infinity
    if au >= 0x7F800000
        jump special()
    t: B32 = v * s
    # for x > 1, atan(x) = pi/2 - atan(1/x)
    if au > 0x3F800000
        jump reduced(B32.truediv(1.0, t), true)
    else
        jump reduced(t, false)

    block special()
        if au == 0x7F800000
            jump signed(1.5707963705062866, au == u)
        else
            return Me.from_bits(me.bits() | 0x0200)

    # now 0 <= t <= 1
    block reduced(t: B32, reduce: Bool)
        tt: B32 = t * t
        quarter: Bool = t <= 0.25
        half: Bool = t <= 0.5
        when
            quarter => jump small(t, tt, reduce)
            half => jump quartic(t, tt, reduce, 7.655291847186163e-05, 0.9981034994125366, 0.01751096174120903, -0.4130729138851166, 0.18841026723384857)
            t <= 0.75 => jump quartic(t, tt, reduce, -0.006188767962157726, 1.045615553855896, -0.11873138695955276, -0.23781338334083557, 0.10300782322883606)
            else => jump quartic(t, tt, reduce, -0.030722400173544884, 1.176712989807129, -0.38294777274131775, 0.0002219911402789876, 0.022133447229862213)

    # t <= 0.25
    block small(t: B32, tt: B32, reduce: Bool)
        rounds_to_x: Bool = not reduce and t <= 0.0283966064453125
        positive: Bool = au == u
        when
            rounds_to_x => jump tiny(t)
            au == 0x3E56A000 => jump signed(0.2066040188074112, positive)
            au == 0x4115C000 => jump signed(1.4643553495407104, positive)
            au == 0x42C32000 => jump signed(1.5605467557907104, positive)
            else => pass
        # |x| = 0x1.ad4p-3
        # |x| = 0x1.2b8p+3
        # |x| = 0x1.864p+6
        c5: B32 = B32.mul_add(-0.1310965120792389, a: tt, b: 0.1996171474456787)
        c1: B32 = B32.mul_add(-0.33332985639572144, a: tt, b: 0.9999998807907104)
        c: B32 = c5.mul_add(a: tt * tt, b: c1)
        jump narrow(t * c, reduce)

    # for |x| < 0x1.d14p-6, atan(x) rounds to x
    block tiny(t: B32)
        if au == 0
            return me
        st: B32 = s * t
        return st.mul_add(a: -1.1920928955078125e-07, b: st).to[Me]()

    # the degree-4 polynomial p0 + p1 t + ... + p4 t^4 for the subinterval holding t
    block quartic(t: B32, tt: B32, reduce: Bool, p0: B32, p1: B32, p2: B32, p3: B32, p4: B32)
        c3: B32 = p4.mul_add(a: t, b: p3)
        c2: B32 = c3.mul_add(a: t, b: p2)
        y0: B32 = p1.mul_add(a: t, b: p0)
        jump narrow(c2.mul_add(a: tt, b: y0), reduce)

    block narrow(y: B32, reduce: Bool)
        r: B32 = when  # argument reconstruction
            reduce => B32.sub(1.5707963705062866, y)
            else => y
        if s < 0.0
            return (-r).to[Me]()
        else
            return r.to[Me]()

    # an explicit result r, negated for a negative x
    block signed(r: B32, positive: Bool)
        h: Me = r.to[Me]()
        if positive
            return h
        else
            return -h
