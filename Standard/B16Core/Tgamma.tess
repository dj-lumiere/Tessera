# Tessera stdlib: the correctly rounded gamma function of B16
#
# Near zero gamma(x) = 1/x - euler_gamma + O(x). Positive integers give (x-1)!
# exactly. Otherwise gamma on [2.375, 3.375) (x reduced to x - 23/8 = i + d)
# from a degree-15 polynomial in d, shifted to x by the product of the i
# factors between them, all in B64. Round to nearest only: overflow gives
# +inf, +-0 gives +-inf, the negative integers and -inf give NaN, NaN comes
# back quiet, and a result too small for B16 is a zero with the sign of
# gamma(x).
#
# Ported from CORE-MATH, src/binary16/tgamma/tgammaf16.c via RazorForge's B16Tgamma.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca> and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Γ(`me`), correctly rounded (to nearest): overflow gives +inf, +-0 gives +-inf, the negative integers and -inf
### give NaN, NaN comes back quiet, and a result too small for B16 is a zero with the sign of Γ(`me`).
### :returns: Γ(`me`).
routine B16.gamma(me: Me) -> Me
    local xf: B32 = me.to[B32]()
    local tu: U32 = xf.bits()
    local ax: U32 = tu << 1
    local z: B64 = xf.to[B64]()
    local fx: B32 = xf.floor()

    special: Bool = ax >= 0xFF000000
    tiny: Bool = ax <= 0x6F000000  # |x| <= 2^-16
    over: Bool = xf >= 9.2265625
    integer: Bool = fx == xf
    when
        special =>
            # +-inf or NaN: gamma(+inf) = +inf, gamma(-inf) has no real result (the
            # negative quiet NaN of the original's x / x on x86), and a NaN is quieted by x + x
            infinite: Bool = ax == 0xFF000000
            minusinf: Bool = infinite and tu >> 31 == 1
            wide: B32 = me.to[B32]()
            when
                minusinf => return Me.from_bits(0xFE00)
                infinite => return me
                else => return (wide + wide).to[Me]()
        tiny =>
            # |x| <= 2^-16: gamma(x) = 1/x - euler_gamma + O(x)
            c: B64 = B64.sub(0.9890559953279725, z * 0.9074790760808863)
            d: B64 = c * z - 0.5772156649015329
            recip: B64 = B64.div(1.0, z)
            return (recip + d).to[Me]()
        over => return Me.from_bits(0x7C00)
        integer =>
            # an integer: a pole at zero, no real result at the negative integers (the
            # positive quiet NaN of the original's constant 0.0f / 0.0f), else (k - 1)!
            zero: Bool = xf == 0.0
            when
                zero => return B32.div(1.0, xf).to[Me]()
                xf < 0.0 => return Me.from_bits(0x7E00)
                else =>
                    k: S32 = fx.to[S32]()

                    each i in 1 til k with t0: B64 = 1.0, x0: B64 = 1.0
                        continue with t0: t0 * x0, x0: x0 + 1.0
                    then
                        return t0.to[Me]()
        xf < -16.0 =>
            # x < -16, not an integer: |gamma(x)| < 2^-25 rounds to a zero of the sign of gamma(x)
            whole: S32 = fx.to[S32]()
            if whole & 1 == 0
                return Me.from_bits(0x0000)
            else
                return Me.from_bits(0x8000)
        else =>
            # gamma(23/8 + i + d) from a polynomial in d, shifted by the i factors between
            m: B64 = z - 2.875
            i: B64 = m.round_ties_even()
            step: B64 = B64.copysign(1.0, i)
            d: B64 = m - i
            d2: B64 = d * d
            d4: B64 = d2 * d2
            d8: B64 = d4 * d4
            a0: B64 = d * 1.5591939012079508 + 1.7877108988969403
            a2: B64 = d * 0.47065801829337245 + 1.0510493266811867
            a4: B64 = d * 0.058831548411746724 + 0.18881863831977497
            a6: B64 = d * 0.004228758148929772 + 0.017825943652294146
            a8: B64 = d * 0.00019456568933897892 + 0.001097917853717287
            a10: B64 = d * 4.914144140610218e-06 + 5.197131759674315e-05
            a12: B64 = d * -1.4461519623063317e-07 + 2.437173471710669e-06
            a14: B64 = d * -4.919948895618967e-08 + 1.8260131876052383e-07
            b0: B64 = a0 + d2 * a2
            b4: B64 = a4 + d2 * a6
            b8: B64 = a8 + d2 * a10
            b12: B64 = a12 + d2 * a14
            lo: B64 = b0 + d4 * b4
            hi: B64 = b8 + d4 * b12
            f: B64 = lo + d8 * hi
            jm: S32 = i.abs().to[S32]()
            if jm == 0
                # the first factor: x - 1/2 - step/2
                # for x below the polynomial's interval the product divides
                w: B64 = 1.0
                below: Bool = i <= -0.5
                wv: B64 = when
                    below => B64.div(1.0, w)
                    else => w
                return (f * wv).to[Me]()
            else
                z1: B64 = z - (step * 0.5 + 0.5)

                while j != 0 with zj: B64 = z1, w: B64 = z1, j: S32 = jm - 1
                    continue with zj: zj - step, w: w * (zj - step), j: j - 1
                then
                    below: Bool = i <= -0.5
                    wv: B64 = when
                        below => B64.div(1.0, w)
                        else => w
                    return (f * wv).to[Me]()
