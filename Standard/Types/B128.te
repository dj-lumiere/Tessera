# Tessera stdlib: B128 — IEEE 754 binary128, in software
#
# Layout: sign (1 bit) | exponent (15 bits, bias 16383) | fraction (112 bits),
# in an i128 that the code here reads as a U128 (bits, from_bits). No target
# has to support LLVM's fp128: every operation is integer code here, so results
# are bit-identical everywhere and need no compiler-rt routines. Arithmetic
# rounds correctly (to nearest, ties to even).
# The structure follows RazorForge's B128 and TLFloat (Naoki Shibata, Boost 1.0),
# with 256-bit steps done in 64-bit pieces instead, and division by 3-by-2
# limb steps (divq on x86_64, Möller–Granlund elsewhere).
#
# Internally a finite value is sig × 2^(exponent - 16383 - 115): the significand
# carries three extra low bits (guard, round, sticky) under the 113 kept ones.

module Standard/Core

### The exponent bias of binary128: a biased exponent field `e` encodes 2^(e - 16383).
preset B128_BIAS:      S64  = 16383
### The all-ones exponent field, 32767, which marks infinities and NaNs.
preset B128_EXP_MAX:   S64  = B128_BIAS.mul(2).add(1)  # all-ones exponent
### The implicit leading significand bit, 2^112, just above the 112 stored fraction bits.
preset B128_IMPLICIT:  U128 = 0x10000000000000000000000000000  # 2^112
### A mask of the 112 stored fraction bits.
preset B128_FRAC_MASK: U128 = B128_IMPLICIT.sub(1)
### The sign bit, bit 127.
preset B128_SIGN:      U128 = 0x80000000000000000000000000000000
### The bits of +inf: the all-ones exponent with a zero fraction.
preset B128_INF:       U128 = B128_EXP_MAX.to[U128]().shl(112)
### The bits of the canonical quiet NaN: +inf's bits with the quiet bit set.
preset B128_QNAN:      U128 = B128_INF.bitor(B128_QUIET_BIT)
### The quiet bit of a NaN, the top fraction bit (2^111).
preset B128_QUIET_BIT: U128 = B128_IMPLICIT.shr(1)  # 2^111
### Positive infinity: the result of overflow and of dividing a positive value by +0.0.
preset B128.INFINITY:     B128 = B128.from_bits(B128_INF)
### Negative infinity.
preset B128.NEG_INFINITY: B128 = B128.from_bits(B128_SIGN.bitor(B128_INF))
### The canonical quiet NaN.
### :note: NaN is unequal to everything, itself included, so test for it with {B128.is_nan}, not `eq`.
preset B128.NAN:          B128 = B128.from_bits(B128_QNAN)
### The largest finite B128, about 1.1897314953572318e4932.
preset B128.MAX:          B128 = B128.from_bits(B128_INF.sub(1))
### The most negative finite B128, the negation of `B128.MAX`.
preset B128.MIN:          B128 = B128.from_bits(B128_SIGN.bitor(B128_INF.sub(1)))
### The smallest positive normal B128, 2^-16382, about 3.3621031431120935e-4932. Subnormal values go below it.
preset B128.MIN_POSITIVE: B128 = B128.from_bits(B128_IMPLICIT)
### The gap between 1.0 and the next larger B128, 2^-112, about 1.9259299443872359e-34 (bits `0x3F8F0000000000000000000000000000`).
preset B128.EPSILON:      B128 = B128.from_bits(0x3F8F0000000000000000000000000000)  # 2^-112

### A 128-bit IEEE 754 binary128 floating-point number (quadruple precision), implemented in software.
### It is stored as an LLVM `i128` (sign bit, 15-bit exponent with bias 16383, 112-bit fraction) and has a 113-bit significand, about 34 significant decimal digits.
### :note: Every operation is integer code, so results are bit-identical on every target and need no compiler-rt routines. Arithmetic rounds to nearest, ties to even.
### :see: {B64} for hardware speed.
@llvm("i128")
record B128
obeys Equatable[B128], Comparable[B128], Hashable[B128]

# -- bits ----------------------------------------------------------------------

### Reinterprets raw IEEE 754 binary128 bits as a B128, exactly.
### :param bits: The encoding: sign bit 127, a 15-bit exponent field, then 112 fraction bits.
### :returns: The value with that encoding. NaN payloads are kept.
### :see: {B128.bits} for the inverse.
routine B128.from_bits(bits: U128) -> Me
    r: Me = bitcast[U128, Me](bits)
    return r

### The raw IEEE 754 binary128 bits, exactly.
### :returns: The encoding: sign bit 127, a 15-bit exponent field, then 112 fraction bits.
### :see: {B128.from_bits} for the inverse.
routine B128.bits(me: Me) -> U128
    r: U128 = bitcast[Me, U128](me)
    return r

### {B128.from_bits}, short for the stdlib's own B128 code.
### :param bits: The binary128 encoding.
### :returns: The value with that encoding.
routine b128_of(bits: U128) -> B128
    r: B128 = bitcast[U128, B128](bits)
    return r

### Reads the sign bit of binary128 bits.
### :param bits: The binary128 encoding.
### :returns: `true` when the sign bit is set, for -0 and NaNs with the bit set too.
routine b128_is_negative_bits(bits: U128) -> Bool
    return bits >= B128_SIGN

### Extracts the biased exponent field of binary128 bits.
### :param bits: The binary128 encoding.
### :returns: The 15-bit exponent field, 0 for zeros and subnormals and `B128_EXP_MAX` for infinities and NaNs.
routine b128_exponent(bits: U128) -> S64
    exponent_bits: U128 = bits >> 112
    r: S64 = exponent_bits.to[S64]() & 32767
    return r

### Extracts the stored fraction of binary128 bits, without the implicit bit.
### :param bits: The binary128 encoding.
### :returns: The low 112 bits.
routine b128_fraction(bits: U128) -> U128
    r: U128 = bits & B128_FRAC_MASK
    return r

### Whether binary128 bits encode a NaN: the all-ones exponent with a nonzero fraction.
### :param bits: The binary128 encoding.
### :returns: True for quiet and signaling NaNs.
routine b128_is_nan_bits(bits: U128) -> Bool
    all_ones: Bool = b128_exponent(bits) == B128_EXP_MAX
    payload: Bool = b128_fraction(bits) != 0
    return all_ones and payload

### Whether binary128 bits encode +0.0 or -0.0.
### :param bits: The binary128 encoding.
### :returns: True when every bit but the sign is 0.
routine b128_is_zero_bits(bits: U128) -> Bool
    return bits & B128_SIGN.bitnot() == 0

# -- classification ------------------------------------------------------------

### Whether `me` is NaN, quiet or signaling.
### :returns: True for NaN, the only value unordered with itself.
routine B128.is_nan(me: Me) -> Bool
    return b128_is_nan_bits(me.bits())

### Whether `me` is +inf or -inf.
### :returns: True for either infinity, false for NaN and finite values.
routine B128.is_infinite(me: Me) -> Bool
    magnitude: U128 = me.bits() & B128_SIGN.bitnot()
    return magnitude == B128_INF

### Neither infinite nor NaN.
### :returns: True for zeros, subnormals and normal values.
routine B128.is_finite(me: Me) -> Bool
    return b128_exponent(me.bits()) != B128_EXP_MAX

### Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
### :returns: Whether the sign bit is set.
routine B128.is_sign_negative(me: Me) -> Bool
    return b128_is_negative_bits(me.bits())

### Flips the sign bit, exactly.
### :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine B128.neg(me: Me) -> Me
    r: Me = b128_of(me.bits() ^ B128_SIGN)
    return r

### Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
### :returns: The magnitude of `me`.
routine B128.abs(me: Me) -> Me
    r: Me = b128_of(me.bits() & B128_SIGN.bitnot())
    return r

### The magnitude of `me` with the sign of `sign`, exactly.
### :param sign: The value whose sign bit is taken, NaN included.
### :returns: `me` with its sign bit replaced.
routine B128.copysign(me: Me, sign: Me) -> Me
    magnitude: U128 = me.bits() & B128_SIGN.bitnot()
    signed: U128 = sign.bits() & B128_SIGN
    r: Me = b128_of(magnitude | signed)
    return r

# -- shifting and rounding -----------------------------------------------------

### A finite, nonzero value as (significand with the implicit bit at 112, unbiased
### exponent). Subnormals are normalized, so their exponent drops below -16382.
record B128Parts
    sig: U128
    exponent: S64

### `value >> n`, with every bit shifted out ORed into bit 0.
### :param value: The bits to shift.
### :param n: The shift amount, at least 0. From 128 on, every bit is shifted out.
### :returns: The shifted value, its bit 0 set when any set bit was lost.
routine shr_sticky(value: U128, n: S64) -> U128
    none: Bool = n == 0
    when
        none => return value
        n >= 128 => return (value != 0).to[U128]()
        else =>
            amount: U128 = n.to[U128]()
            mask: U128 = (1 << amount) - 1
            lost: Bool = value & mask != 0
            shifted: U128 = (value >> amount) | lost.to[U128]()
            return shifted

### Packs `sig` × 2^(`exponent` - 16383 - 115) into binary128 bits, rounding to nearest even. `sig` may sit at any bit
### position, and its lowest bit may be a sticky bit. Handles overflow to infinity, subnormals, and underflow to zero.
### :param negative: The sign of the result.
### :param exponent: The biased exponent the value has when the leading bit of `sig` is at bit 115.
### :param sig: The significand, with 3 bits below the kept ones for rounding.
### :returns: The binary128 bits: a signed zero for a zero `sig`, a signed infinity on overflow.
routine b128_round_pack(negative: Bool, exponent: S64, sig: U128) -> U128
    local sign: U128 = when

        negative => B128_SIGN
        else => 0

    if sig == 0
        return sign
    else
        # Put the leading bit at 115 (12 leading zeros), unless that would push
        # the exponent below 1: then the value is subnormal at exponent 1.
        lz: S64 = sig.leading_zeros().to[S64]()
        shift: S64 = 12 - lz  # > 0: right, < 0: left
        new_exp: S64 = exponent + shift
        subnormal: Bool = new_exp < 1
        amount: S64 = when
            subnormal => 1 - exponent
            else => shift
        final_exp: S64 = when
            subnormal => 1
            else => new_exp
        right: Bool = amount > 0
        values2: (U128, S64) = when
            right => (shr_sticky(value: sig, n: amount), final_exp)
            else => (sig << (0 - amount).to[U128](), final_exp)
        s, e = values2
        extra: U128 = s & 7
        kept: U128 = s >> 3
        above: Bool = extra > 4
        tie: Bool = extra == 4
        odd: Bool = kept & 1 == 1
        up: Bool = above or (tie and odd)
        rounded: U128 = kept + up.to[U128]()
        carry: Bool = rounded == 0x20000000000000000000000000000  # 2^113
        final: U128 = when
            carry => rounded >> 1
            else => rounded
        e2: S64 = e + carry.to[S64]()
        normal: Bool = final >= B128_IMPLICIT
        biased: S64 = when
            normal => e2
            else => 0
        overflow: Bool = biased >= B128_EXP_MAX
        field: U128 = biased.to[U128]() << 112
        bits: U128 = sign | field | (final & B128_FRAC_MASK)
        if overflow
            return sign | B128_INF
        else
            return bits

### Splits finite, nonzero binary128 bits into a significand and an unbiased exponent.
### :param bits: The encoding of a finite, nonzero value.
### :returns: {B128Parts} with the implicit bit at 112. A subnormal is normalized, so its exponent drops below -16382.
routine b128_unpack(bits: U128) -> B128Parts
    local biased: S64 = b128_exponent(bits)
    local fraction: U128 = b128_fraction(bits)

    if biased == 0
        lz: U128 = fraction.leading_zeros()
        shift: S64 = lz.to[S64]() - 15
        p: B128Parts = B128Parts(sig: fraction << shift.to[U128](), exponent: -16382 - shift)
        return p
    else
        p: B128Parts = B128Parts(sig: fraction | B128_IMPLICIT, exponent: biased - B128_BIAS)
        return p

# -- arithmetic ----------------------------------------------------------------

### Makes a NaN quiet by setting its quiet bit, keeping the rest of the payload.
### :param bits: The bits of a NaN.
### :returns: The quiet NaN's bits.
routine b128_quiet(bits: U128) -> U128
    r: U128 = bits | B128_QUIET_BIT
    return r

### Whether `x` is a signaling NaN: a NaN whose quiet bit is clear.
### :param x: The value.
### :returns: True for a signaling NaN.
routine b128_is_signaling(x: B128) -> Bool
    quiet: Bool = x.bits() & B128_QUIET_BIT != 0
    return x.is_nan() and not quiet

### The NaN an operation on `a` and `b` gives when one of them is NaN, as `add` and `mul` give it: `a` quieted when
### it is NaN, else `b` quieted, the payload kept.
### :param a: The first operand.
### :param b: The second operand.
### :returns: The quiet NaN.
routine b128_nan_of(a: B128, b: B128) -> B128
    first: U128 = when
        a.is_nan() => a.bits()
        else => b.bits()
    return b128_of(b128_quiet(first))

### Adds `other` to `me` in software, rounded to nearest (ties to even).
### :param other: The value to add.
### :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
### :see: {b128_add_bits} for the algorithm.
routine B128.add(me: Me, other: Me) -> Me
    r: Me = b128_of(b128_add_bits(a: me.bits(), b: other.bits()))
    return r

### Subtracts `other` from `me` in software: adds `other` with its sign flipped, rounded to nearest (ties to even).
### :param other: The value to subtract.
### :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine B128.sub(me: Me, other: Me) -> Me
    r: Me = b128_of(b128_add_bits(a: me.bits(), b: other.bits() ^ B128_SIGN))
    return r

### Adds two binary128 values on their bits, rounded to nearest (ties to even). {B128.add} and {B128.sub} call it.
### :param a: The first addend's bits.
### :param b: The second addend's bits.
### :returns: The bits of `a + b`: a NaN operand comes back quieted, `inf + -inf` is NaN, and a sum of two zeros is -0 only when both are -0.
routine b128_add_bits(a: U128, b: U128) -> U128
    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    a_inf: Bool = b128_exponent(a) == B128_EXP_MAX
    b_inf: Bool = b128_exponent(b) == B128_EXP_MAX
    a_zero: Bool = b128_is_zero_bits(a)
    b_zero: Bool = b128_is_zero_bits(b)
    when
        a_nan => return b128_quiet(a)
        b_nan => return b128_quiet(b)
        a_inf =>
            # inf + inf keeps the sign, and inf - inf is NaN
            b_inf2: Bool = b128_exponent(b) == B128_EXP_MAX
            same: Bool = ~b128_is_negative_bits(a ^ b)
            if b_inf2 & not same
                return B128_QNAN
            else
                return a
        b_inf => return b
        a_zero =>
            # -0 + -0 is -0. Any other zero sum of zeros is +0
            both_negative: Bool = b128_is_negative_bits(a & b)
            zero: U128 = when
                both_negative => B128_SIGN
                else => 0
            if b_zero
                return zero
            else
                return b
        b_zero => return a
        else =>
            a_exp: S64 = b128_exponent(a)
            b_exp: S64 = b128_exponent(b)
            a_sub: Bool = a_exp == 0
            b_sub: Bool = b_exp == 0
            # subnormals sit at exponent 1 without the implicit bit
            a_e: S64 = when
                a_sub => 1
                else => a_exp
            b_e: S64 = when
                b_sub => 1
                else => b_exp
            a_hid: U128 = when
                a_sub => 0
                else => B128_IMPLICIT
            b_hid: U128 = when
                b_sub => 0
                else => B128_IMPLICIT
            a_frac: U128 = b128_fraction(a) | a_hid
            a_sig: U128 = a_frac << 3
            b_frac: U128 = b128_fraction(b) | b_hid
            b_sig: U128 = b_frac << 3
            a_big: Bool = a_e >= b_e
            big_sig: U128 = when
                a_big => a_sig
                else => b_sig
            small_sig: U128 = when
                a_big => b_sig
                else => a_sig
            big_e: S64 = when
                a_big => a_e
                else => b_e
            small_e: S64 = when
                a_big => b_e
                else => a_e
            big_bits: U128 = when
                a_big => a
                else => b
            small_bits: U128 = when
                a_big => b
                else => a
            big_neg: Bool = b128_is_negative_bits(big_bits)
            small_neg: Bool = b128_is_negative_bits(small_bits)
            aligned: U128 = shr_sticky(value: small_sig, n: big_e - small_e)
            if big_neg == small_neg
                r: U128 = b128_round_pack(negative: big_neg, exponent: big_e,
                    sig: big_sig + aligned)
                return r
            else
                # x - y. An exact zero is +0
                x_larger: Bool = big_sig >= aligned
                m: U128 = big_sig.abs_diff(aligned)
                sign: Bool = when
                    x_larger => big_neg
                    else => not big_neg
                negative: Bool = sign and m != 0
                r: U128 = b128_round_pack(negative, exponent: big_e, sig: m)
                return r

### Multiplies `me` by `other` in software, rounded to nearest (ties to even).
### :param other: The factor.
### :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine B128.mul(me: Me, other: Me) -> Me
    r: Me = b128_of(b128_mul_bits(a: me.bits(), b: other.bits()))
    return r

### Multiplies two binary128 values on their bits, rounded to nearest (ties to even): the 226-bit product is formed exactly from 64-bit halves.
### :param a: The first factor's bits.
### :param b: The second factor's bits.
### :returns: The bits of `a * b`: a NaN operand comes back quieted, `inf * 0` is NaN, and the sign is the XOR of the signs.
routine b128_mul_bits(a: U128, b: U128) -> U128
    sign: U128 = (a ^ b) & B128_SIGN
    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    a_inf: Bool = b128_exponent(a) == B128_EXP_MAX
    b_inf: Bool = b128_exponent(b) == B128_EXP_MAX
    a_zero: Bool = b128_is_zero_bits(a)
    b_zero: Bool = b128_is_zero_bits(b)
    any_inf: Bool = a_inf or b_inf
    any_zero: Bool = a_zero or b_zero
    when
        a_nan => return b128_quiet(a)
        b_nan => return b128_quiet(b)
        any_inf =>
            if any_zero
                return B128_QNAN
            else
                return sign | B128_INF
        any_zero => return sign
        else =>
            # The 226-bit product of two 113-bit significands, from 64-bit halves:
            # P = hi × 2^128 + lo. Then sig = P >> 109 with a sticky bit, so the
            # leading bit lands at 115 or 116.
            pa: B128Parts = b128_unpack(a)
            pb: B128Parts = b128_unpack(b)
            ma: U128 = pa.sig
            mb: U128 = pb.sig
            a0: U128 = ma & 0xFFFFFFFFFFFFFFFF
            a1: U128 = ma >> 64
            b0: U128 = mb & 0xFFFFFFFFFFFFFFFF
            b1: U128 = mb >> 64
            p00: U128 = a0 * b0
            mid: U128 = a0 * b1 + a1 * b0
            p11: U128 = a1 * b1
            lo: U128 = p00 +% (mid << 64)
            lo_carry: U128 = (lo < p00).to[U128]()
            hi: U128 = p11 + (mid >> 64) + lo_carry
            top: U128 = (hi << 19) | (lo >> 109)
            sticky: Bool = lo & 0x1FFFFFFFFFFFFFFFFFFFFFFFFFFF != 0  # low 109 bits
            sig: U128 = top | sticky.to[U128]()
            exponent: S64 = pa.exponent + pb.exponent + B128_BIAS
            negative: Bool = sign != 0
            r: U128 = b128_round_pack(negative, exponent, sig)
            return r

### Divides `me` by `other` in software, rounded to nearest (ties to even).
### :param other: The divisor.
### :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine B128.truediv(me: Me, other: Me) -> Me
    r: Me = b128_of(b128_div_bits(a: me.bits(), b: other.bits()))
    return r

### Divides two binary128 values on their bits, rounded to nearest (ties to even), with two 3-by-2 limb division steps.
### :param a: The dividend's bits.
### :param b: The divisor's bits.
### :returns: The bits of `a / b`: a NaN operand comes back quieted, `0 / 0` and `inf / inf` are NaN, a nonzero value over zero is a signed infinity.
routine b128_div_bits(a: U128, b: U128) -> U128
    local sign: U128 = (a ^ b) & B128_SIGN

    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    a_inf: Bool = b128_exponent(a) == B128_EXP_MAX
    b_inf: Bool = b128_exponent(b) == B128_EXP_MAX
    a_zero: Bool = b128_is_zero_bits(a)
    b_zero: Bool = b128_is_zero_bits(b)
    both_inf: Bool = a_inf and b_inf
    both_zero: Bool = a_zero and b_zero
    invalid: Bool = both_inf or both_zero
    to_inf: Bool = a_inf or b_zero
    when
        a_nan => return b128_quiet(a)
        b_nan => return b128_quiet(b)
        invalid => return B128_QNAN
        to_inf => return sign | B128_INF
        b_inf or a_zero => return sign
        else =>
            # q = floor(ma × 2^116 / mb) = floor(ma × 2^131 / d) with the divisor
            # normalized to d = mb × 2^15 (two limbs, top bit set). ma × 2^131 is four
            # limbs, (ma × 8, 0, 0), so the quotient takes two 3-by-2 steps
            # (Standard/WideDiv.te). The last remainder is the sticky bit.
            pa: B128Parts = b128_unpack(a)
            pb: B128Parts = b128_unpack(b)
            d: U128 = pb.sig << 15
            d1: U64 = (d >> 64).to[U64]()
            d0: U64 = d.to_wrap[U64]()
            divisor: Divisor3By2 = div_3by2_prepare(d1, d0)
            n: U128 = pa.sig << 3
            high: Div3By2 = div_3by2(u2: (n >> 64).to[U64](), u1: n.to_wrap[U64](), u0: 0, divisor)
            r: U128 = high.remainder
            low: Div3By2 = div_3by2(u2: (r >> 64).to[U64](), u1: r.to_wrap[U64](), u0: 0, divisor)
            q_high: U128 = high.quotient.to[U128]() << 64
            q: U128 = q_high | low.quotient.to[U128]()
            sticky: Bool = low.remainder != 0
            sig: U128 = q | sticky.to[U128]()
            unbiased: S64 = pa.exponent - pb.exponent - 1
            exponent: S64 = unbiased + B128_BIAS
            negative: Bool = sign != 0
            bits: U128 = b128_round_pack(negative, exponent, sig)
            return bits

### The square root of a binary128 value on its bits, correctly rounded, from a 256-bit integer square root.
### :param a: The radicand's bits.
### :returns: The bits of sqrt(a): -0 for -0, +inf for +inf, a quieted NaN for NaN, and NaN for any other negative value.
routine b128_sqrt_bits(a: U128) -> U128
    nan: Bool = b128_is_nan_bits(a)
    zero: Bool = b128_is_zero_bits(a)
    negative: Bool = b128_is_negative_bits(a)
    when
        nan => return b128_quiet(a)
        zero => return a
        negative => return B128_QNAN
        b128_exponent(a) == B128_EXP_MAX => return a
        else =>
            # sqrt(-0) is -0
            # With an even exponent e, sqrt(m × 2^(e-112)) = sqrt(m × 2^118) × 2^((e-230)/2),
            # and the integer root of the 232-bit m × 2^118 has 116 bits (isqrt_256).
            p: B128Parts = b128_unpack(a)
            odd: Bool = p.exponent & 1 == 1
            m: U128 = when
                odd => p.sig << 1
                else => p.sig
            e: S64 = when
                odd => p.exponent - 1
                else => p.exponent
            hi: U128 = m >> 10
            lo: U128 = m << 118
            exponent: S64 = e.div_trunc(2) + B128_BIAS
            root: U128 = isqrt_256(hi, lo)
            # the root is exact exactly when root^2 = radicand. Otherwise set the sticky bit
            exact: Bool = square_equals(x: root, hi, lo)
            sig: U128 = root | (not exact).to[U128]()
            bits: U128 = b128_round_pack(negative: false, exponent, sig)
            return bits

### floor(n / x) for n = `hi` × 2^128 + `lo`, when the quotient fits in 128 bits and `hi` < `x` (after normalizing,
### the 3-by-2 steps need it). `x` must be nonzero.
### :param hi: The high 128 bits of the dividend.
### :param lo: The low 128 bits of the dividend.
### :param x: The divisor.
### :returns: The quotient.
routine div_256_by_128(hi: U128, lo: U128, x: U128) -> U128
    s: S64 = x.leading_zeros().to[S64]()
    d: U128 = x << s.to[U128]()
    spill_shift: S64 = (128 - s).min(127)
    spill: U128 = lo >> spill_shift.to[U128]()
    carry: U128 = when
        s == 0 => 0
        else => spill
    n_hi: U128 = (hi << s.to[U128]()) | carry
    n_lo: U128 = lo << s.to[U128]()
    d1: U64 = (d >> 64).to[U64]()
    d0: U64 = d.to_wrap[U64]()
    divisor: Divisor3By2 = div_3by2_prepare(d1, d0)
    high: Div3By2 = div_3by2(u2: (n_hi >> 64).to[U64](), u1: n_hi.to_wrap[U64](),
        u0: (n_lo >> 64).to[U64](), divisor)
    r: U128 = high.remainder
    low: Div3By2 = div_3by2(u2: (r >> 64).to[U64](), u1: r.to_wrap[U64](), u0: n_lo.to_wrap[U64](),
        divisor)
    q_high: U128 = high.quotient.to[U128]() << 64
    q: U128 = q_high | low.quotient.to[U128]()
    return q

### floor(sqrt(n)) for n = `hi` × 2^128 + `lo` with 2^230 <= n < 2^232: Newton's method on integers, started above the
### root from a B64 square root of the top bits of n, stops at the first step that does not go down.
### :param hi: The high 128 bits of n.
### :param lo: The low 128 bits of n.
### :returns: The integer square root.
routine isqrt_256(hi: U128, lo: U128) -> U128
    bits: S64 = 256 - hi.leading_zeros().to[S64]()
    shift: S64 = bits - 64
    even: S64 = shift + (shift & 1)
    top: U64 = (hi >> (even - 128).to[U128]()).to[U64]()
    # B64's root of top is within 2^-50 relative: + 2 makes the seed an overestimate
    root: B64 = top.to[B64]().sqrt()
    guess: U64 = root.to[U64]() + 2

    while true with x: U128 = guess.to[U128]() << (even.div_trunc(2)).to[U128]()
        q2: U128 = div_256_by_128(hi, lo, x)
        next2: U128 = x + q2 >> 1
        if next2 >= x
            return x
        else
            continue with x: next2

### Whether `x`^2 = `hi` × 2^128 + `lo`, for `x` < 2^116.
### :param x: The root to square.
### :param hi: The high 128 bits of the value.
### :param lo: The low 128 bits of the value.
### :returns: `true` when the square matches exactly.
routine square_equals(x: U128, hi: U128, lo: U128) -> Bool
    x0: U128 = x & 0xFFFFFFFFFFFFFFFF
    x1: U128 = x >> 64
    low: U128 = x0 * x0
    cross: U128 = x0 * x1 << 1
    sq_lo: U128 = low +% (cross << 64)
    carry: U128 = (sq_lo < low).to[U128]()
    x1_sq: U128 = x1 * x1
    sq_hi: U128 = x1_sq + (cross >> 64) + carry
    return sq_hi == hi and sq_lo == lo

# -- comparison ----------------------------------------------------------------

### Maps binary128 bits to an unsigned key that orders like the values, -0 below +0 and NaNs at the ends.
### :param bits: The binary128 encoding.
### :returns: The bits inverted for a negative value, else the bits with the top bit set.
routine b128_order_key(bits: U128) -> U128
    negative: Bool = b128_is_negative_bits(bits)
    r: U128 = when
        negative => ~bits
        else => bits | B128_SIGN
    return r

### Whether two binary128 values compare at all: neither is NaN.
### :param a: The first encoding.
### :param b: The second encoding.
### :returns: `true` unless `a` or `b` is NaN.
routine b128_ordered(a: U128, b: U128) -> Bool
    either_nan: Bool = b128_is_nan_bits(a) | b128_is_nan_bits(b)
    return not either_nan

### IEEE equality, on the bits.
### :param other: The value to compare against.
### :returns: True when the encodings match or both are zeros of either sign, false whenever either operand is NaN.
routine B128.eq(me: Me, other: Me) -> Bool
    a: U128 = me.bits()
    b: U128 = other.bits()
    zeros: Bool = b128_is_zero_bits(a) & b128_is_zero_bits(b)
    same: Bool = a == b or zeros
    return same & b128_ordered(a, b)

### IEEE inequality: the negation of {B128.eq}.
### :param other: The value to compare against.
### :returns: True when the values differ or either operand is NaN, false for -0.0 against +0.0.
routine B128.ne(me: Me, other: Me) -> Bool
    return me != other

### Whether `me` is less than `other`, as an ordered IEEE comparison on the bits.
### :param other: The value to compare against.
### :returns: `me < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B128.lt(me: Me, other: Me) -> Bool
    a: U128 = me.bits()
    b: U128 = other.bits()
    zeros: Bool = b128_is_zero_bits(a) & b128_is_zero_bits(b)
    below: Bool = b128_order_key(a) < b128_order_key(b)
    return (below and not zeros) & b128_ordered(a, b)

### Whether `me` is greater than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B128.gt(me: Me, other: Me) -> Bool
    return other < me

### Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B128.le(me: Me, other: Me) -> Bool
    return me < other or me == other

### Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine B128.ge(me: Me, other: Me) -> Bool
    return other <= me

### Three-way comparison of `me` and `other`, -0.0 equal to +0.0.
### :param other: The value to compare with.
### :returns: -1, 0, or 1 as `me` is below, equal to, or above `other`. 0 also when either is NaN, as for the other
###     float types.
routine B128.compare(me: Me, other: Me) -> S32
    lt: Bool = me < other
    when
        lt => return -1
        me > other => return 1
        else => return 0

### Orders by IEEE 754 totalOrder: -NaN < -inf < ... < -0 < +0 < ... < +inf < +NaN.
### :param other: The value to compare with.
### :returns: -1, 0, or 1 as `me` is below, equal to, or above `other` in that order.
routine B128.total_compare(me: Me, other: Me) -> S32
    a: U128 = b128_order_key(me.bits())
    b: U128 = b128_order_key(other.bits())
    lt: Bool = a < b
    when
        lt => return -1
        a > b => return 1
        else => return 0

# -- conversions ---------------------------------------------------------------

### Widens exactly to B128 from a narrower binary format. NaN payloads move to the top of the fraction.
### :param bits: The narrower value's bits, in the low `format.width` bits.
### :param format: The narrower format (B64, B32, B16, or BF16).
### :returns: The same value as a B128.
routine b128_widen(bits: U64, format: FloatFormat) -> B128
    local width: U64 = format.width.to[U64]()
    local mantissa_bits: U64 = format.fraction_bits.to[U64]()
    local bias: S64 = format.bias.to[S64]()
    local exponent_max: U64 = format.exponent_max.to[U64]()
    local sign_bit: U64 = (bits >> width - 1) & 1
    local fraction: U64 = bits & (1 << mantissa_bits) - 1
    local top: U128 = fraction.to[U128]() << (112 - mantissa_bits).to[U128]()
    local negative: Bool = sign_bit == 1
    local sign: U128 = when

        negative => B128_SIGN
        else => 0
    local exponent: U64 = (bits >> mantissa_bits) & exponent_max

    special: Bool = exponent == exponent_max
    zero: Bool = exponent == 0 and fraction == 0
    subnormal: Bool = exponent == 0
    r: U128 = when
        special => sign | B128_INF | top
        zero => sign
        subnormal =>
            # value = fraction × 2^(1 - bias - mantissa_bits): exact after normalizing
            min_exponent: S64 = 1 - bias + B128_BIAS
            pack_exponent: S64 = min_exponent + 3
            becomes b128_round_pack(negative, exponent: pack_exponent, sig: top)
        else =>
            unbiased: S64 = exponent.to[S64]() - bias
            rebiased: S64 = unbiased + B128_BIAS
            field: U128 = rebiased.to[U128]() << 112
            becomes sign | field | top
    v: B128 = b128_of(r)
    return v

### Rounds to nearest even into a narrower binary format. Rounds once, so B128 to B32 is not B128 to B64 to B32.
### :param value: The B128 to narrow.
### :param format: The narrower format (B64, B32, B16, or BF16).
### :returns: The format's bits, the sign at bit `format.width - 1`. A NaN keeps its top payload bits and comes back
###     quiet.
routine b128_narrow(value: B128, format: FloatFormat) -> U64
    local width: U64 = format.width.to[U64]()
    local mantissa_bits: U64 = format.fraction_bits.to[U64]()
    local bias: S64 = format.bias.to[S64]()
    local exponent_max: U64 = format.exponent_max.to[U64]()
    local bits: U128 = value.bits()
    local top_bit: U64 = 1 << width - 1
    local sign: U64 = when

        b128_is_negative_bits(bits) => top_bit
        else => 0
    local infinity: U64 = exponent_max << mantissa_bits

    nan: Bool = b128_is_nan_bits(bits)
    inf: Bool = b128_exponent(bits) == B128_EXP_MAX
    when
        nan =>
            # keep the top payload bits and force the quiet bit
            top_fraction: U128 = b128_fraction(bits) >> (112 - mantissa_bits).to[U128]()
            payload: U64 = top_fraction.to[U64]()
            quiet: U64 = 1 << mantissa_bits - 1
            signed_inf: U64 = sign | infinity
            r: U64 = signed_inf | payload | quiet
            return r
        inf => return sign | infinity
        b128_is_zero_bits(bits) => return sign
        else =>
            # q = round(sig / 2^shift): the quantum is 2^(e - mantissa_bits), or the
            # subnormal quantum when e is below the target's smallest normal exponent.
            p: B128Parts = b128_unpack(bits)
            min_e: S64 = 1 - bias
            e_used: S64 = p.exponent.max(min_e)
            shift: S64 = 112 - mantissa_bits.to[S64]() + (e_used - p.exponent)
            sticky: U128 = shr_sticky(value: p.sig, n: (shift - 2).max(0))
            grs_shift: S64 = (2 - shift).max(0)
            # two extra bits (half, rest) under the kept ones
            grs: U128 = when
                shift < 2 => p.sig << grs_shift.to[U128]()
                else => sticky
            kept: U128 = grs >> 2
            low: U128 = grs & 3
            up: Bool = low > 2 or (low == 2 and kept & 1 == 1)
            q: U64 = (kept + up.to[U128]()).to[U64]()
            carry: Bool = q == 1 << mantissa_bits + 1
            q2: U64 = when
                carry => q >> 1
                else => q
            e2: S64 = e_used + carry.to[S64]()
            hidden: U64 = 1 << mantissa_bits
            normal: Bool = q2 >= hidden
            biased: S64 = when
                normal => e2 + bias
                else => 0
            overflow: Bool = biased >= exponent_max.to[S64]()
            r: U64 = sign | (biased.to[U64]() << mantissa_bits) | (q2 & hidden - 1)
            if overflow
                return sign | infinity
            else
                return r

### Widens to B128, exactly.
### :returns: The same value as a B128. NaN payloads move to the top of the fraction.
routine B64.to[B128](me: Me) -> B128
    r: B128 = b128_widen(bits: me.bits(), format: Me.FORMAT.peek())
    return r

### Widens to B128, exactly.
### :returns: The same value as a B128. NaN payloads move to the top of the fraction.
routine B32.to[B128](me: Me) -> B128
    r: B128 = b128_widen(bits: me.bits().to[U64](), format: Me.FORMAT.peek())
    return r

### Widens to B128, exactly.
### :returns: The same value as a B128. NaN payloads move to the top of the fraction.
routine B16.to[B128](me: Me) -> B128
    r: B128 = b128_widen(bits: me.bits().to[U64](), format: Me.FORMAT.peek())
    return r

### Widens to B128, exactly.
### :returns: The same value as a B128. NaN payloads move to the top of the fraction.
routine BF16.to[B128](me: Me) -> B128
    r: B128 = b128_widen(bits: me.bits().to[U64](), format: Me.FORMAT.peek())
    return r

### Narrows to B64, rounding once to nearest (ties to even).
### :returns: The nearest B64: infinity beyond B64's range, a subnormal or zero for tiny values, NaN for NaN.
routine B128.to[B64](me: Me) -> B64
    r: B64 = .from_bits(b128_narrow(value: me, format: B64.FORMAT.peek()))
    return r

### Narrows to B32, rounding once to nearest (ties to even), so it can differ from going through B64.
### :returns: The nearest B32: infinity beyond B32's range, a subnormal or zero for tiny values, NaN for NaN.
routine B128.to[B32](me: Me) -> B32
    r: B32 = .from_bits(b128_narrow(value: me, format: B32.FORMAT.peek()).to[U32]())
    return r

### Narrows to B16, rounding once to nearest (ties to even).
### :returns: The nearest B16: infinity above 65504, a subnormal or zero for tiny values, NaN for NaN.
routine B128.to[B16](me: Me) -> B16
    r: B16 = .from_bits(b128_narrow(value: me, format: B16.FORMAT.peek()).to[U16]())
    return r

### Narrows to BF16, rounding once to nearest (ties to even).
### :returns: The nearest BF16: infinity beyond BF16's range, a subnormal or zero for tiny values, NaN for NaN.
routine B128.to[BF16](me: Me) -> BF16
    r: BF16 = .from_bits(b128_narrow(value: me, format: BF16.FORMAT.peek()).to[U16]())
    return r

### The identity conversion, so generic code can call `to[T]()` when `T` is B128.
### :returns: `me` unchanged.
routine B128.to[Me](me: Me) -> Me
    return me

### Converts to B128, rounding to nearest (ties to even) when the value needs more than 113 bits.
### :returns: The nearest B128, exact below 2^113.
routine U128.to[B128](me: Me) -> B128
    bits: Me = b128_round_pack(negative: false, exponent: B128_BIAS.add(115), sig: me)
    r: B128 = b128_of(bits)
    return r

### Converts to B128, rounding to nearest (ties to even) when the magnitude needs more than 113 bits.
### :returns: The nearest B128, exact for magnitudes below 2^113.
routine S128.to[B128](me: Me) -> B128
    negative: Bool = me < 0
    magnitude: U128 = me.abs_diff(0)
    bits: U128 = b128_round_pack(negative, exponent: B128_BIAS.add(115), sig: magnitude)
    r: B128 = b128_of(bits)
    return r

### Converts to B128, exactly: every U64 fits in B128's 113-bit significand.
### :returns: The same value as a B128.
routine U64.to[B128](me: Me) -> B128
    r: B128 = me.to[U128]().to[B128]()
    return r

### Converts to B128, exactly: every S64 fits in B128's 113-bit significand.
### :returns: The same value as a B128.
routine S64.to[B128](me: Me) -> B128
    r: B128 = me.to[S128]().to[B128]()
    return r

### Converts to B128, exactly.
### :returns: The same value as a B128.
routine U32.to[B128](me: Me) -> B128
    r: B128 = me.to[U128]().to[B128]()
    return r

### Converts to B128, exactly.
### :returns: The same value as a B128.
routine S32.to[B128](me: Me) -> B128
    r: B128 = me.to[S128]().to[B128]()
    return r

### |value| rounded toward zero, saturating at U128.MAX. NaN and values below 1 give 0.
### :param bits: The binary128 encoding.
### :returns: The integer part of the magnitude, U128.MAX from 2^128 up and for infinities.
routine b128_whole_magnitude(bits: U128) -> U128
    nan: Bool = b128_is_nan_bits(bits)
    when
        nan => return 0
        b128_is_zero_bits(bits) => return 0
        else =>
            p: B128Parts = b128_unpack(bits)
            small: Bool = p.exponent < 0
            when
                small => return 0
                p.exponent >= 128 => return U128.MAX
                else =>
                    up: Bool = p.exponent >= 112
                    left_shift: S64 = (p.exponent - 112).max(0)
                    left: U128 = p.sig << left_shift.to[U128]()
                    right_shift: S64 = (112 - p.exponent).max(0)
                    right: U128 = p.sig >> right_shift.to[U128]()
                    r: U128 = when
                        up => left
                        else => right
                    return r

# -- rounding to integers ------------------------------------------------------

### The rounding direction {b128_round_int} applies when it rounds a B128 to an integer value.
### :note: `TowardZero` backs {B128.trunc}, `Down` {B128.floor}, `Up` {B128.ceil}, `NearestAway` {B128.round}, and `NearestEven` {B128.round_ties_even}.
choice B128Rounding: U8
    TOWARD_ZERO
    DOWN
    UP
    NEAREST_AWAY
    NEAREST_EVEN

### Rounds to an integer value by clearing the fraction bits of the encoding and, when `mode` says so, adding one unit
### of the lowest integer bit. A carry out of the fraction moves into the exponent, as the encoding is ordered.
### :param bits: The binary128 encoding.
### :param mode: The rounding direction.
### :returns: The bits of the rounded value. Zeros and infinities come back unchanged, and a NaN comes back quieted.
routine b128_round_int(bits: U128, mode: B128Rounding) -> U128
    local biased: S64 = b128_exponent(bits)
    local e: S64 = biased - B128_BIAS

    special: Bool = biased == B128_EXP_MAX
    whole: Bool = e >= 112
    zero: Bool = b128_is_zero_bits(bits)
    when
        special =>
            if b128_is_nan_bits(bits)
                return b128_quiet(bits)
            else
                return bits
        whole => return bits
        zero => return bits
        e < 0 =>
            # |x| < 1: the result is ±0 or ±1 (1.0 is 0x3FFF << 112)
            sign: U128 = bits & B128_SIGN
            one: U128 = sign | 0x3FFF0000000000000000000000000000
            negative: Bool = sign != 0
            half_up: Bool = e == -1  # |x| >= 0.5
            exact_half: Bool = half_up and b128_fraction(bits) == 0
            down: U128 = when
                negative => one
                else => sign
            up: U128 = when
                negative => sign
                else => one
            away: U128 = when
                half_up => one
                else => sign
            over: Bool = half_up and not exact_half
            even: U128 = when
                over => one
                else => sign
            when mode
                B128Rounding.TOWARD_ZERO => return sign
                B128Rounding.DOWN => return down
                B128Rounding.UP => return up
                B128Rounding.NEAREST_AWAY => return away
                B128Rounding.NEAREST_EVEN => return even
        else =>
            frac_bits: U128 = (112 - e).to[U128]()
            unit: U128 = 1 << frac_bits
            mask: U128 = unit - 1
            kept: U128 = bits & ~mask
            rest: U128 = bits & mask
            half: U128 = unit >> 1
            negative: Bool = b128_is_negative_bits(bits)
            inexact: Bool = rest != 0
            odd: Bool = kept & unit != 0
            over_half: Bool = rest > half
            at_half: Bool = rest == half
            away: Bool = over_half or at_half
            even_up: Bool = over_half or (at_half and odd)
            down: Bool = negative and inexact
            up: Bool = not negative and inexact
            bump: Bool = when mode
                B128Rounding.TOWARD_ZERO => false
                B128Rounding.DOWN => down
                B128Rounding.UP => up
                B128Rounding.NEAREST_AWAY => away
                B128Rounding.NEAREST_EVEN => even_up
            r: U128 = when
                bump => kept + unit
                else => kept
            return r

### Rounds toward zero on the encoding, exactly.
### :returns: The integer part of `me`, with its sign (-0.5 gives -0.0). Infinities and NaN come back unchanged.
routine B128.trunc(me: Me) -> Me
    r: Me = b128_of(b128_round_int(bits: me.bits(), mode: B128Rounding.TOWARD_ZERO))
    return r

### Rounds toward negative infinity on the encoding (exact).
### :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
routine B128.floor(me: Me) -> Me
    r: Me = b128_of(b128_round_int(bits: me.bits(), mode: B128Rounding.DOWN))
    return r

### Rounds toward positive infinity on the encoding (exact).
### :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine B128.ceil(me: Me) -> Me
    r: Me = b128_of(b128_round_int(bits: me.bits(), mode: B128Rounding.UP))
    return r

### Rounds to the nearest integer on the encoding, half-way cases away from zero (exact).
### :returns: The rounded value, with the sign of `me`. Zeros and infinities come back unchanged, and a NaN comes
###     back quieted.
routine B128.round(me: Me) -> Me
    r: Me = b128_of(b128_round_int(bits: me.bits(), mode: B128Rounding.NEAREST_AWAY))
    return r

### Rounds to the nearest integer on the encoding, half-way cases to the even neighbor (exact).
### :returns: The rounded value, with the sign of `me`. Zeros and infinities come back unchanged, and a NaN comes
###     back quieted.
routine B128.round_ties_even(me: Me) -> Me
    r: Me = b128_of(b128_round_int(bits: me.bits(), mode: B128Rounding.NEAREST_EVEN))
    return r

### `me` minus its integer part, with the sign of `me`.
### :returns: `me - me.trunc()`, NaN for an infinity or NaN.
routine B128.fract(me: Me) -> Me
    whole: Me = me.trunc()
    r: Me = me - whole
    return r

### The smaller value, or the other one if one operand is NaN. Equal values, -0.0 and +0.0 included, give `me`.
### :param other: The value to compare with.
### :returns: The smaller of `me` and `other`, NaN only when both are NaN.
routine B128.min(me: Me, other: Me) -> Me
    self_nan: Bool = me.is_nan()
    other_nan: Bool = other.is_nan()
    when
        self_nan => return other
        other_nan => return me
        other < me => return other
        else => return me

### The larger value, or the other one if one operand is NaN. Equal values, -0.0 and +0.0 included, give `me`.
### :param other: The value to compare with.
### :returns: The larger of `me` and `other`, NaN only when both are NaN.
routine B128.max(me: Me, other: Me) -> Me
    self_nan: Bool = me.is_nan()
    other_nan: Bool = other.is_nan()
    when
        self_nan => return other
        other_nan => return me
        other > me => return other
        else => return me

# -- fused multiply-add ----------------------------------------------------------

### `x >> n`, with everything shifted out ORed into bit 0.
### :param x: The bits to shift.
### :param n: The shift amount, at least 0. From 256 on, every bit is shifted out.
### :returns: The shifted value, its bit 0 set when any set bit was lost.
routine shr_sticky(x: U256, n: S64) -> U256
    if n >= 256
        nonzero: U64 = (x != 0).to[U64]()
        any: U256 = nonzero.to[U256]()
        return any
    else
        shift: U256 = n.to[U256]()
        mask: U256 = (1 << shift) - 1
        lost: Bool = x & mask != 0
        r: U256 = (x >> shift) | lost.to[U64]().to[U256]()
        return r

### `me * a + b` with a single rounding: the 226-bit product is exact, `b` is aligned to it in 256 bits (anything
### shifted further out becomes a sticky bit), and only the sum is rounded.
### :param a: The factor to multiply `me` by.
### :param b: The addend.
### :returns: `me * a + b`, correctly rounded.
### :see: {b128_fma_bits}
routine B128.mul_add(me: Me, a: Me, b: Me) -> Me
    r: Me = b128_of(b128_fma_bits(x: me.bits(), y: a.bits(), c: b.bits()))
    return r

### Fused multiply-add on binary128 bits: `x * y + c` with a single rounding, the exact product aligned with `c` in 256 bits.
### :param x: The first factor's bits.
### :param y: The second factor's bits.
### :param c: The addend's bits.
### :returns: The bits of the rounded result: NaN operands come back quieted, `inf * 0` and `inf - inf` are NaN, and a zero product plus a zero is -0 only when both are -0.
routine b128_fma_bits(x: U128, y: U128, c: U128) -> U128
    sign: U128 = (x ^ y) & B128_SIGN
    x_nan: Bool = b128_is_nan_bits(x)
    y_nan: Bool = b128_is_nan_bits(y)
    c_nan: Bool = b128_is_nan_bits(c)
    x_inf: Bool = b128_exponent(x) == B128_EXP_MAX
    y_inf: Bool = b128_exponent(y) == B128_EXP_MAX
    c_inf: Bool = b128_exponent(c) == B128_EXP_MAX
    x_zero: Bool = b128_is_zero_bits(x)
    y_zero: Bool = b128_is_zero_bits(y)
    c_zero: Bool = b128_is_zero_bits(c)
    p_inf: Bool = x_inf or y_inf
    p_zero: Bool = x_zero or y_zero
    when
        x_nan => return b128_quiet(x)
        y_nan => return b128_quiet(y)
        c_nan => return b128_quiet(c)
        p_inf =>
            # inf × 0 and inf - inf are NaN
            clash: Bool = c_inf and c & B128_SIGN != sign
            invalid: Bool = p_zero or clash
            inf: U128 = sign | B128_INF
            if invalid
                return B128_QNAN
            else
                return inf
        c_inf => return c
        p_zero =>
            # ±0 + c is c, except ±0 + ±0: -0 only when both are -0
            both_neg: Bool = (sign != 0) & b128_is_negative_bits(c)
            zero: U128 = when
                both_neg => B128_SIGN
                else => 0
            if c_zero
                return zero
            else
                return c
        c_zero => return b128_mul_bits(a: x, b: y)
        else =>
            # P = mx my × 2^(ex + ey - 224) sits at bits ≤ 254 after << 29, and
            # C = mc × 2^(ec - 112) at bits ≤ 254 after << 142. One bit of headroom stays for a carry.
            px: B128Parts = b128_unpack(x)
            py: B128Parts = b128_unpack(y)
            pc: B128Parts = b128_unpack(c)
            p: U256 = px.sig.mul_wide(py.sig) << 29
            p_e: S64 = px.exponent + py.exponent - 253
            cc: U256 = pc.sig.to[U256]() << 142
            c_e: S64 = pc.exponent - 254
            p_neg: Bool = sign != 0
            c_neg: Bool = b128_is_negative_bits(c)
            p_first: Bool = p_e >= c_e
            big: U256 = when
                p_first => p
                else => cc
            small: U256 = when
                p_first => cc
                else => p
            e: S64 = when
                p_first => p_e
                else => c_e
            diff: S64 = when
                p_first => p_e - c_e
                else => c_e - p_e
            big_neg: Bool = when
                p_first => p_neg
                else => c_neg
            small_neg: Bool = when
                p_first => c_neg
                else => p_neg
            aligned: U256 = shr_sticky(x: small, n: diff)
            same: Bool = big_neg == small_neg
            values2: (U256, Bool) = when
                same => (big + aligned, big_neg)
                else =>
                    # an exact zero is +0
                    a_larger: Bool = big >= aligned
                    m: U256 = big.abs_diff(aligned)
                    negative: Bool = when
                        a_larger => big_neg
                        else => not big_neg
                    becomes (m, negative)
            r, negative = values2
            # value = r × 2^e: bring the top bit to 255, then hand the high half (with
            # a sticky bit for the low one) to b128_round_pack
            if r == 0
                return 0
            lz: S64 = r.leading_zeros().to[S64]()
            n: U256 = r << lz.to[U256]()
            high: U128 = (n >> 128).to[U128]()
            low_sticky: Bool = n.to_wrap[U128]() != 0
            sig: U128 = high | low_sticky.to[U128]()
            unbiased: S64 = e - lz + 128
            exponent: S64 = unbiased + B128_BIAS + 115
            bits: U128 = b128_round_pack(negative, exponent, sig)
            return bits

# ============================================================
# B64's surface, and IEEE operations on the encoding
# ============================================================

# -- constants (each the correctly rounded value) ------------------------------

### Pi, rounded to the nearest B128.
preset B128.PI:            B128 = B128.from_bits(0x4000921FB54442D18469898CC51701B8)  # pi
### Tau (2 pi), one full turn in radians, rounded to the nearest B128.
preset B128.TAU:           B128 = B128.from_bits(0x4001921FB54442D18469898CC51701B8)  # 2 pi

### Euler's number e, rounded to the nearest B128.
preset B128.E:             B128 = B128.from_bits(0x40005BF0A8B1457695355FB8AC404E7A)  # Euler's number

### Pi / 2, rounded to the nearest B128.
preset B128.FRAC_PI_2:     B128 = B128.from_bits(0x3FFF921FB54442D18469898CC51701B8)  # pi / 2
### Pi / 4, rounded to the nearest B128.
preset B128.FRAC_PI_4:     B128 = B128.from_bits(0x3FFE921FB54442D18469898CC51701B8)  # pi / 4
### 1 / pi, rounded to the nearest B128.
preset B128.FRAC_1_PI:     B128 = B128.from_bits(0x3FFD45F306DC9C882A53F84EAFA3EA6A)  # 1 / pi
### The square root of 2, rounded to the nearest B128.
preset B128.SQRT_2:        B128 = B128.from_bits(0x3FFF6A09E667F3BCC908B2FB1366EA95)  # sqrt(2)
### 1 / sqrt(2), rounded to the nearest B128.
preset B128.FRAC_1_SQRT_2: B128 = B128.from_bits(0x3FFE6A09E667F3BCC908B2FB1366EA95)  # 1 / sqrt(2)
### The natural logarithm of 2, rounded to the nearest B128.
preset B128.LN_2:          B128 = B128.from_bits(0x3FFE62E42FEFA39EF35793C7673007E6)  # ln(2)
### The natural logarithm of 10, rounded to the nearest B128.
preset B128.LN_10:         B128 = B128.from_bits(0x400026BB1BBB5551582DD4ADAC5705A6)  # ln(10)
### Log2(e), rounded to the nearest B128.
preset B128.LOG2_E:        B128 = B128.from_bits(0x3FFF71547652B82FE1777D0FFDA0D23A)  # log2(e)
### Log10(e), rounded to the nearest B128.
preset B128.LOG10_E:       B128 = B128.from_bits(0x3FFDBCB7B1526E50E32A6AB7555F5A68)  # log10(e)
### The bits of 1.0: the biased exponent 16383 with a zero fraction.
preset B128_ONE: U128 = B128_BIAS.to[U128]().shl(112)

# -- hashing, reciprocal ------------------------------------------------------

### Hashes the raw bits, like B64: +0 and -0 hash apart, and so do NaN payloads.
### :returns: The 64-bit hash of {B128.bits}.
routine B128.hash(me: Me) -> U64
    r: U64 = me.bits().hash()
    return r

### The reciprocal `1 / me`, rounded once.
### :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine B128.recip(me: Me) -> Me
    one: Me = b128_of(B128_ONE)
    r: Me = one / me
    return r

# -- sign and classification ---------------------------------------------------

### The sign of `me` as a number.
### :returns: 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine B128.signum(me: Me) -> Me
    nan: Bool = me.is_nan()
    unit: Me = b128_of(B128_ONE).copysign(me)
    r: Me = when
        nan => me
        else => unit
    return r

### Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
### :returns: Whether the sign bit is clear.
routine B128.is_sign_positive(me: Me) -> Bool
    return ~b128_is_negative_bits(me.bits())

### Whether `me` is a normal value: not zero, subnormal, infinite, or NaN.
### :returns: True when the exponent field is neither all zeros nor all ones.
routine B128.is_normal(me: Me) -> Bool
    exponent: S64 = b128_exponent(me.bits())
    return exponent != 0 and exponent != B128_EXP_MAX

### Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `B128.MIN_POSITIVE`.
### :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine B128.is_subnormal(me: Me) -> Bool
    exponent: S64 = b128_exponent(me.bits())
    fraction: U128 = b128_fraction(me.bits())
    return exponent == 0 and fraction != 0

# -- remainders ----------------------------------------------------------------

### |a| mod |b| for finite nonzero a and b, exact, with the parity of the
### truncated quotient: the part frem and remainder share.
record B128Remainder
    magnitude: B128
    odd: Bool

### |`a`| mod |`b`| by long division, one quotient bit per step: x = ma × 2^(ea - eb) mod mb. Up to 32877 steps (MAX
### mod the smallest subnormal), each a compare and a shift.
### :param a: The dividend's bits, finite and nonzero.
### :param b: The divisor's bits, finite and nonzero.
### :returns: The exact remainder magnitude and whether the truncated quotient is odd.
routine b128_remainder_parts(a: U128, b: U128) -> B128Remainder
    local x: @U128 <- .hollow()

    pa: B128Parts = b128_unpack(a)
    pb: B128Parts = b128_unpack(b)
    same_exp: Bool = pa.exponent == pb.exponent
    a_smaller: Bool = pa.exponent < pb.exponent or (same_exp and pa.sig < pb.sig)
    magnitude: B128 = b128_of(a & B128_SIGN.bitnot())
    as_is: B128Remainder = B128Remainder(magnitude: magnitude, odd: false)
    if a_smaller
        return as_is
    pa.sig.poke_into(x)

    mb: U128 = pb.sig

    eb: S64 = pb.exponent

    while steps != 0 with steps: S64 = pa.exponent - pb.exponent
        fits: Bool = x.peek() >= mb
        taken: U128 = when
            fits => mb
            else => 0
        left: U128 = x.peek() - taken
        (left << 1).poke_into(x)
        continue with steps: steps - 1
    then
        # x < 2 mb: one more subtraction gives the quotient's last bit. The rest is x × 2^(eb - 112)
        odd: Bool = x.peek() >= mb
        taken: U128 = when
            odd => mb
            else => 0
        rest: U128 = x.peek() - taken
        bits: U128 = b128_round_pack(negative: false, exponent: eb + B128_BIAS, sig: rest << 3)
        r: B128Remainder = B128Remainder(magnitude: b128_of(bits), odd: odd)
        return r

### The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact.
### :param other: The divisor.
### :returns: `me - q * other` for `q` the quotient rounded toward zero. `me` when `other` is infinite or `me` is
###     a zero, NaN when `other` is 0 or `me` is infinite, and a NaN operand comes back quieted.
routine B128.mod_trunc(me: Me, other: Me) -> Me
    a: U128 = me.bits()
    b: U128 = other.bits()
    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    invalid: Bool = me.is_infinite() | b128_is_zero_bits(b)
    when
        a_nan => return b128_of(b128_quiet(a))
        b_nan => return b128_of(b128_quiet(b))
        invalid => return Me.NAN
        other.is_infinite() | b128_is_zero_bits(a) => return me
        else =>
            parts: B128Remainder = b128_remainder_parts(a: me.bits(), b: other.bits())
            r: Me = parts.magnitude.copysign(me)
            return r

### IEEE 754 remainder: `me - n * other` with `n` = `me / other` rounded to the nearest integer, ties to even (C
### remainder). Exact, with |result| <= |other| / 2, and a zero result has the sign of `me`.
### :param other: The divisor.
### :returns: The remainder. `me` when `other` is infinite or `me` is a zero, NaN when `other` is 0 or `me` is
###     infinite, and a NaN operand comes back quieted.
routine B128.rem(me: Me, other: Me) -> Me
    a: U128 = me.bits()
    b: U128 = other.bits()
    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    invalid: Bool = me.is_infinite() | b128_is_zero_bits(b)
    when
        a_nan => return b128_of(b128_quiet(a))
        b_nan => return b128_of(b128_quiet(b))
        invalid => return Me.NAN
        other.is_infinite() | b128_is_zero_bits(a) => return me
        else =>
            # past half of |other|, or at half with an odd quotient, step down by |other|:
            # r - |other| is exact, as |other| / 2 <= r < |other|
            parts: B128Remainder = b128_remainder_parts(a: me.bits(), b: other.bits())
            r: Me = parts.magnitude
            divisor: Me = other.abs()
            twice: Me = r + r
            over: Bool = twice > divisor
            tie: Bool = (twice == divisor) & parts.odd
            nearest: Bool = over or tie
            down: Me = r - divisor
            m: Me = when
                nearest => down
                else => r
            negative: Bool = b128_is_negative_bits(me.bits())
            result: Me = when
                negative => -m
                else => m
            return result

### The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
### :param other: The divisor.
### :returns: The truncated quotient, moved one step down (for a positive `other`) or up when the remainder is negative.
routine B128.div(me: Me, other: Me) -> Me
    local q: Me = me.truediv(other).trunc()

    rem: Me = me.mod_trunc(other)
    zero: Me = b128_of(0)
    if rem < zero
        one: Me = b128_of(B128_ONE)
        zero2: Me = b128_of(0)
        positive_divisor: Bool = other > zero2
        down: Me = q - one
        up: Me = q + one
        r: Me = when
            positive_divisor => down
            else => up
        return r
    else
        return q

### The least non-negative remainder of `me / other`.
### :param other: The divisor.
### :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
###     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine B128.mod(me: Me, other: Me) -> Me
    rem: Me = me.mod_trunc(other)
    zero: Me = b128_of(0)
    if not (rem < zero)
        return rem
    magnitude: Me = other.abs()
    r: Me = rem + magnitude
    # a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
    # one in range
    if r == magnitude and magnitude.is_finite()
        return Me.from_bits(magnitude.bits() - 1)
    else
        return r

### The positive difference (C fdim).
### :param other: The value to subtract.
### :returns: `me - other` when `me > other`, else +0. NaN when either is NaN.
routine B128.fdim(me: Me, other: Me) -> Me
    unordered: Bool = ~b128_ordered(a: me.bits(), b: other.bits())
    above: Bool = me > other
    subtract: Bool = unordered or above
    zero: Me = b128_of(0)
    if not subtract
        return zero
    r: Me = me - other
    return r

### (`me` + `other`) / 2 with one rounding and no intermediate overflow (Rust's midpoint): halving is exact except
### near the subnormals, where a tiny operand is added whole.
### :param other: The other end.
### :returns: The value halfway between `me` and `other`.
routine B128.midpoint(me: Me, other: Me) -> Me
    lo: Me = b128_of(0x00020000000000000000000000000000)  # 2 × MIN_POSITIVE
    hi: Me = b128_of(0x7FFDFFFFFFFFFFFFFFFFFFFFFFFFFFFF)  # MAX / 2
    half: Me = b128_of(0x3FFE0000000000000000000000000000)
    abs_a: Me = me.abs()
    abs_b: Me = other.abs()
    small: Bool = abs_a <= hi and abs_b <= hi
    a_tiny: Bool = abs_a < lo
    b_tiny: Bool = abs_b < lo
    sum: Me = me + other
    a_half: Me = me * half
    b_half: Me = other * half
    both: Me = sum * half
    a_whole: Me = me + b_half
    b_whole: Me = a_half + other
    halves: Me = a_half + b_half
    when
        small => return both
        a_tiny => return a_whole
        b_tiny => return b_whole
        else => return halves

# -- ordering ------------------------------------------------------------------

### The smaller value, NaN if either is NaN, and -0.0 below +0.0 (IEEE 754-2019 minimum).
### :param other: The value to compare with.
### :returns: The smaller of `me` and `other`, or the NaN operand quieted.
routine B128.minimum(me: Me, other: Me) -> Me
    a: U128 = me.bits()
    b: U128 = other.bits()
    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    when
        a_nan => return b128_of(b128_quiet(a))
        b_nan => return b128_of(b128_quiet(b))
        b128_order_key(a) <= b128_order_key(b) => return me
        else => return other

### The larger value, NaN if either is NaN, and +0.0 above -0.0 (IEEE 754-2019 maximum).
### :param other: The value to compare with.
### :returns: The larger of `me` and `other`, or the NaN operand quieted.
routine B128.maximum(me: Me, other: Me) -> Me
    a: U128 = me.bits()
    b: U128 = other.bits()
    a_nan: Bool = b128_is_nan_bits(a)
    b_nan: Bool = b128_is_nan_bits(b)
    when
        a_nan => return b128_of(b128_quiet(a))
        b_nan => return b128_of(b128_quiet(b))
        b128_order_key(a) >= b128_order_key(b) => return me
        else => return other

### Restricts `me` to `lo ..= hi`. NaN stays NaN.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` when `me < lo`, `hi` when `me > hi`, else `me`.
### :throws: Crashes with `InvalidValueError` unless `lo <= hi` (so also when either bound is NaN).
@track_caller
routine B128.clamp(me: Me, lo: Me, hi: Me) -> Me
    if lo <= hi
        below: Bool = me < lo
        above: Bool = me > hi
        upper: Me = when
            above => hi
            else => me
        r: Me = when
            below => lo
            else => upper
        return r
    else
        crash_invalid_value()

### Whether `me` lies in [`lo`, `hi`], both ends included. False when `lo > hi` or any operand is NaN.
### :param lo: The lower bound, included.
### :param hi: The upper bound, included.
### :returns: `true` when `lo <= me <= hi`.
routine B128.between(me: Me, lo: Me, hi: Me) -> Bool
    return me >= lo and me <= hi

### Whether `me` lies in [`lo`, `end`): `lo` included, `end` not. False when `lo >= end` or any operand is NaN.
### :param lo: The lower bound, included.
### :param end: The upper bound, excluded.
### :returns: `true` when `lo <= me < end`.
routine B128.in_range(me: Me, lo: Me, end: Me) -> Bool
    return me >= lo and me < end

# -- stepping and scaling ------------------------------------------------------

### me = fraction × 2^exponent with 0.5 <= |fraction| < 1.
record B128Frexp
    fraction: B128
    exponent: S64

### The least value above `me` (IEEE 754 nextUp).
### :returns: The next value up: the smallest subnormal after ±0, +inf stays +inf, -tiny steps to -0, and a NaN comes
###     back quieted.
routine B128.next_up(me: Me) -> Me
    bits: U128 = me.bits()
    nan: Bool = b128_is_nan_bits(bits)
    top: Bool = bits == B128_INF
    zero: Bool = b128_is_zero_bits(bits)
    positive: Bool = ~b128_is_negative_bits(bits)
    tiny: Me = b128_of(1)
    when
        nan => return b128_of(b128_quiet(bits))
        top => return me
        zero => return tiny
        positive => return b128_of(bits + 1)
        else => return b128_of(bits - 1)

### The greatest value below `me` (IEEE 754 nextDown), as `-(-me).next_up()`.
### :returns: The next value down: -inf stays -inf, and a NaN comes back quieted.
routine B128.next_down(me: Me) -> Me
    negated_up: Me = (-me).next_up()
    r: Me = -negated_up
    return r

### `me` × 2^`n`: exact unless it overflows (to ±inf) or lands among the subnormals, where it rounds once, to nearest
### even (C scalbn).
### :param n: The power of two to scale by.
### :returns: The scaled value. Zeros and infinities come back unchanged, and a NaN comes back quieted.
routine B128.scalbn(me: Me, n: S64) -> Me
    local bits: U128 = me.bits()

    nan: Bool = b128_is_nan_bits(bits)
    when
        nan => return b128_of(b128_quiet(bits))
        b128_is_zero_bits(bits) | me.is_infinite() => return me
        else =>
            # past ±40000 every finite value over- or underflows, and the sum can't wrap
            p: B128Parts = b128_unpack(bits)
            shift: S64 = n.clamp(lo: -40000, hi: 40000)
            negative: Bool = b128_is_negative_bits(bits)
            packed: U128 = b128_round_pack(negative, exponent: p.exponent + shift + B128_BIAS,
                sig: p.sig << 3)
            r: Me = b128_of(packed)
            return r

### floor(log2 |`me`|) as a float (IEEE 754 logB).
### :returns: The unbiased exponent: -inf for ±0, +inf for ±inf, and a NaN comes back quieted.
routine B128.logb(me: Me) -> Me
    bits: U128 = me.bits()
    nan: Bool = b128_is_nan_bits(bits)
    zero: Bool = b128_is_zero_bits(bits)
    when
        nan => return b128_of(b128_quiet(bits))
        zero => return Me.NEG_INFINITY
        me.is_infinite() => return Me.INFINITY
        else =>
            p: B128Parts = b128_unpack(me.bits())
            r: Me = p.exponent.to[Me]()
            return r

### Splits `me` into a signed fraction with 0.5 <= |fraction| < 1 and a power of two (C frexp).
### :returns: The fraction and exponent with `me` = fraction × 2^exponent. Zeros and infinities come back whole with
###     exponent 0, a NaN quieted with exponent 0.
routine B128.frexp(me: Me) -> B128Frexp
    bits: U128 = me.bits()
    nan: Bool = b128_is_nan_bits(bits)
    keep: Bool = b128_is_zero_bits(bits) | me.is_infinite()
    quiet: B128Frexp = B128Frexp(fraction: b128_of(b128_quiet(bits)), exponent: 0)
    whole: B128Frexp = B128Frexp(fraction: me, exponent: 0)
    when
        nan => return quiet
        keep => return whole
        else =>
            p: B128Parts = b128_unpack(me.bits())
            e: S64 = p.exponent + 1
            r: B128Frexp = B128Frexp(fraction: me.scalbn(0 - e), exponent: e)
            return r

# -- integer conversions ---------------------------------------------------------
#
# to_[int] rounds toward zero and crashes on NaN or a value out of the integer's
# range, while to_[int]_checked returns None instead and to_[int]_clamp saturates
# (NaN gives 0).

### 2^`k`, for |`k`| within the normal range.
### :param k: The exponent.
### :returns: The power of two.
routine b128_pow2(k: S64) -> B128
    biased: S64 = B128_BIAS.add(k)
    r: B128 = b128_of(biased.to[U128]() << 112)
    return r

### Whether `me`, rounded toward zero, lies in [-2^`lo_bits`, 2^`hi_bits`). False for NaN.
### :param lo_bits: The power of two of the lower bound's magnitude. A negative value means a lower bound of 0.
### :param hi_bits: The power of two of the upper bound, excluded.
### :returns: `true` when `me.trunc()` is in range.
routine B128.is_trunc_in_range(me: Me, lo_bits: S64, hi_bits: S64) -> Bool
    local whole: Me = me.trunc()
    local hi: Me = b128_pow2(hi_bits)

    if lo_bits < 0
        zero: Me = b128_of(0)
        return whole.in_range(lo: zero, end: hi)
    else
        lo: Me = -b128_pow2(lo_bits)
        return whole.in_range(lo, end: hi)

### Converts to U128, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, U128.MAX from 2^128 up, 0 for NaN and negative values.
routine B128.to_clamp[U128](me: Me) -> U128
    negative: Bool = b128_is_negative_bits(me.bits())
    magnitude: U128 = b128_whole_magnitude(me.bits())
    r: U128 = when
        negative => 0
        else => magnitude
    return r

### Converts to S128, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to S128.MIN ..= S128.MAX. NaN gives 0.
routine B128.to_clamp[S128](me: Me) -> S128
    local negative: Bool = b128_is_negative_bits(me.bits())
    local magnitude: U128 = b128_whole_magnitude(me.bits())

    if negative
        over: Bool = magnitude >= 0x80000000000000000000000000000000
        r: S128 = when
            over => S128.MIN
            else => magnitude.to_wrap[S128]().neg_wrap()
        return r
    else
        r: S128 = magnitude.to_clamp[S128]()
        return r

### Converts to S8, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
### :see: {B128.to_checked[S8]} to get an absent value instead, {B128.to_clamp[S8]} to saturate.
@track_caller
routine B128.to[S8](me: Me) -> S8
    if not me.is_trunc_in_range(lo_bits: 7, hi_bits: 7)
        crash_overflow()
    r: S8 = me.to_clamp[S8]()
    return r

### Converts to S8, rounding toward zero, without crashing.
### :returns: The integer part of `me` when it fits.
### :absent: When `me` is NaN or its integer part lies outside [-128, 127].
### :see: {B128.to[S8]} to crash instead, {B128.to_clamp[S8]} to saturate.
routine B128.to_checked[S8](me: Me) -> Maybe[S8]
    fits: Bool = me.is_trunc_in_range(lo_bits: 7, hi_bits: 7)
    value: S8 = me.to_clamp[S8]()
    r: Maybe[S8] = fits.then_present(value)
    return r

### Converts to S8, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
### :see: {B128.to_checked[S8]} to detect values that do not fit.
routine B128.to_clamp[S8](me: Me) -> S8
    r: S8 = me.to_clamp[S128]().to_clamp[S8]()
    return r

