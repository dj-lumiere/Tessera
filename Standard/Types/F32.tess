        return(r)

/// Converts to U128, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^128 - 1]. The crash reports the caller's location.
/// :see: {F32.to_checked<U128>} to get an absent value instead, {F32.to_clamp<U128>} to saturate.
#track_caller
routine F32.to<U128>(me: Me) -> U128
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 340282366920938463463374607431768211456.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U128 = fptoui_sat<Me, U128>(me)
        return(r)

/// Converts to U128, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 2^128 - 1].
/// :see: {F32.to<U128>} to crash instead, {F32.to_clamp<U128>} to saturate.
routine F32.to_checked<U128>(me: Me) -> Option<U128>
    block entry()
        fits  : Bool         = me.is_trunc_in_range(0.0, 340282366920938463463374607431768211456.0)
        value : U128         = fptoui_sat<Me, U128>(me)
        r     : Option<U128> = fits.then_present(value)
        return(r)

/// Converts to U128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 2^128 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<U128>} to detect values that do not fit.
routine F32.to_clamp<U128>(me: Me) -> U128
    block entry()
        r : U128 = fptoui_sat<Me, U128>(me)
        return(r)

/// Whether `me`, rounded toward zero, lies in `[lo, hi)`. False for NaN.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, excluded.
/// :returns: True when `lo <= trunc(me) < hi`.
routine F32.is_trunc_in_range(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        whole : Me   = me.trunc()
        r     : Bool = whole.in_range(lo, hi)
        return(r)
