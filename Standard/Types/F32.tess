/// :absent: When `me` is NaN or its integer part lies outside [0, 2^64 - 1].
/// :see: {F32.to<U64>} to crash instead, {F32.to_clamp<U64>} to saturate.
routine F32.to_checked<U64>(me: Me) -> Option<U64>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(0.0, 18446744073709551616.0)
        value : U64         = fptoui_sat<Me, U64>(me)
        r     : Option<U64> = fits.then_present(value)
        return(r)

/// Converts to U64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 2^64 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<U64>} to detect values that do not fit.
routine F32.to_clamp<U64>(me: Me) -> U64
