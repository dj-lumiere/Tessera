// Tessera stdlib: F32 — 32-bit IEEE 754 floating-point
//
// Maps to LLVM IR float.

module Standard::Core

/// A 32-bit IEEE 754 binary32 floating-point number (single precision), mapped to LLVM `float`.
/// It has a 24-bit significand (about 6 to 9 significant decimal digits) and finite magnitudes up to about 3.4e38.
/// :note: Arithmetic rounds to nearest, ties to even. `eq` is IEEE equality, so NaN is unequal to itself and -0.0 equals +0.0.
/// :see: {F64} for more precision and range.
#llvm("float")
record F32
conform Equatable<F32>, Comparable<F32>, Hashable<F32>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7F800000`): the result of overflow and of dividing a positive value by +0.0.
preset F32.INFINITY:     F32 = F32.from_bits(0x7F800000)  // +inf bits
/// Negative infinity (bits `0xFF800000`).
preset F32.NEG_INFINITY: F32 = F32.from_bits(0xFF800000)  // -inf bits
/// The canonical quiet NaN (bits `0x7FC00000`).
/// :note: NaN is unequal to everything, itself included, so test for it with {F32.is_nan}, not `eq`.
preset F32.NAN:          F32 = F32.from_bits(0x7FC00000)  // canonical quiet NaN bits

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
/// :returns: `me` with the sign bit cleared.
routine F32.abs(me: Me) -> Me
    block entry()
        r : Me = fabs<Me>(me)
        return(r)

/// The smaller value. If one operand is NaN, the other one.
/// :param other: The value to compare with.
/// :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine F32.min(me: Me, other: Me) -> Me
    block entry()
        self_nan  : Bool = me.is_nan()
        other_nan : Bool = other.is_nan()
        both      : Bool = self_nan.bitand(other_nan)
        when
            both      -> return(me.add(other))
            self_nan  -> return(other)
            other_nan -> return(me)
            else      -> compare()

    // no minnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare()
        pick : Bool = me.le(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// The larger value. If one operand is NaN, the other one.
/// :param other: The value to compare with.
/// :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine F32.max(me: Me, other: Me) -> Me
    block entry()
        self_nan  : Bool = me.is_nan()
        other_nan : Bool = other.is_nan()
        both      : Bool = self_nan.bitand(other_nan)
        when
            both      -> return(me.add(other))
            self_nan  -> return(other)
            other_nan -> return(me)
            else      -> compare()

    // no maxnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare()
        pick : Bool = me.ge(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// Adds `other` to `me`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine F32.add(me: Me, other: Me) -> Me
    block entry()
        r : Me = fadd<Me>(me, other)
        return(r)

/// Subtracts `other` from `me`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine F32.sub(me: Me, other: Me) -> Me
    block entry()
        r : Me = fsub<Me>(me, other)
        return(r)

/// Multiplies `me` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine F32.mul(me: Me, other: Me) -> Me
    block entry()
        r : Me = fmul<Me>(me, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `me` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me < other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F32.lt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = flt<Me>(me, other)
        return(r)

/// Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me <= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F32.le(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fle<Me>(me, other)
        return(r)

/// Whether `me` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me > other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F32.gt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fgt<Me>(me, other)
        return(r)

/// Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me >= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F32.ge(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fge<Me>(me, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `me` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine F32.div(me: Me, other: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(me, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine F32.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = feq<Me>(me, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ. False for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {F32.eq}.
routine F32.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fne<Me>(me, other)
        return(r)

/// Three-way comparison for the `Comparable` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {F32.total_compare} for a total order that ranks NaN and the signed zeros.
routine F32.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine F32.hash(me: Me) -> U64
    block entry()
        h : U64 = siphash24(me.bits().to<U64>(), hash_key())
        return(h)

// -- named widening conversion -------------------------------------------------

/// Widens to F64, exactly.
/// :returns: The same value as an F64. Every F32 is representable.
routine F32.to<F64>(me: Me) -> F64
    block entry()
        result : F64 = fpext<Me, F64>(me)
        return(result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite F32, about 3.4028235e38 (bits `0x7F7FFFFF`).
preset F32.MAX:          F32 = F32.from_bits(0x7F7FFFFF)  // largest finite value
/// The most negative finite F32, the negation of `F32.MAX` (bits `0xFF7FFFFF`).
preset F32.MIN:          F32 = F32.from_bits(0xFF7FFFFF)  // most negative finite value
/// The smallest positive normal F32, 2^-126, about 1.1754944e-38 (bits `0x00800000`). Subnormal values go below it.
preset F32.MIN_POSITIVE: F32 = F32.from_bits(0x00800000)  // smallest positive normal value
/// The gap between 1.0 and the next larger F32, 2^-23, about 1.1920929e-7 (bits `0x34000000`).
preset F32.EPSILON:      F32 = F32.from_bits(0x34000000)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest F32.
preset F32.PI: F32 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest F32.
preset F32.TAU: F32 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest F32.
preset F32.E: F32 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest F32.
preset F32.FRAC_PI_2: F32 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest F32.
preset F32.FRAC_PI_4: F32 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest F32.
preset F32.FRAC_1_PI: F32 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest F32.
preset F32.SQRT_2: F32 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest F32.
preset F32.FRAC_1_SQRT_2: F32 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest F32.
preset F32.LN_2: F32 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest F32.
preset F32.LN_10: F32 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest F32.
preset F32.LOG2_E: F32 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest F32.
preset F32.LOG10_E: F32 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine F32.neg(me: Me) -> Me
    block entry()
        r : Me = fneg<Me>(me)
        return(r)

/// The magnitude of `me` with the sign of `sign`.
/// :param sign: The value whose sign bit is used.
/// :returns: `me` with its sign bit replaced by the sign bit of `sign`.
routine F32.copysign(me: Me, sign: Me) -> Me
    block entry()
        r : Me = copysign<Me>(me, sign)
        return(r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
/// :returns: 1.0, -1.0, or NaN, by the sign of `me`.
routine F32.signum(me: Me) -> Me
    block entry()
        nan  : Bool = me.is_nan()
        unit : Me   = copysign<Me>(1.0, me)
        r    : Me   = nan
            ? me
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
/// :returns: Whether the sign bit is clear.
routine F32.is_sign_positive(me: Me) -> Bool
    block entry()
        bits : S32  = me.bits().to_wrap<S32>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine F32.is_sign_negative(me: Me) -> Bool
    block entry()
        bits : S32  = me.bits().to_wrap<S32>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact: F64's remainder of the
/// same values is an F32.
/// :param other: The divisor.
/// :returns: The remainder. NaN when either operand is NaN, `me` is infinite, or `other` is 0. Otherwise `me`
///     itself when `other` is infinite or `me` is a zero.
routine F32.mod(me: Me, other: Me) -> Me
    block entry()
        remainder : F64 = me.to<F64>().mod(other.to<F64>())
        r         : Me  = remainder.to<Me>()
        return(r)

/// The reciprocal `1 / me`, rounded once.
/// :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine F32.recip(me: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(1.0, me)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed with the AArch64 FMA instruction.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#target(arch: "aarch64")
routine F32.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = fma<Me>(me, a, b)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed with the x86 FMA instruction (targets with the `fma` feature, as with `--cpu x86-64-v3`).
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: "x86_64"), feature("fma")]
routine F32.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = fma<Me>(me, a, b)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed in software ({F32.mul_add_soft}) on x86 without the `fma` feature.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: "x86_64"), feature(not "fma")]
routine F32.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = me.mul_add_soft(a, b)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed in software ({F32.mul_add_soft}) on targets other than AArch64 and x86_64.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#target(arch: not ("aarch64", "x86_64"))
routine F32.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = me.mul_add_soft(a, b)
        return(r)

/// me * a + b with a single rounding, without an FMA instruction.
///
/// Without one LLVM calls libm's fmaf, so this adds the exact F64 product with round-to-odd
/// (f64_add_round_to_odd) and narrows once, as F16's mul_add does.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
private routine F32.mul_add_soft(me: Me, a: Me, b: Me) -> Me
    block entry()
        product : F64 = me.to<F64>().mul(a.to<F64>())
        sum     : F64 = f64_add_round_to_odd(product, b.to<F64>())
        r       : Me  = sum.to<F32>()
        return(r)

/// The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
/// :param other: The divisor.
/// :returns: The quotient `q`. NaN when either operand is NaN.
routine F32.div_euclid(me: Me, other: Me) -> Me
    block entry()
        q            : Me   = me.div(other).trunc()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Me   = q.sub(1.0)
        up               : Me   = q.add(1.0)
        r                : Me   = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of `me / other`.
/// :param other: The divisor.
/// :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
///     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine F32.mod_euclid(me: Me, other: Me) -> Me
    block entry()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Me   = other.abs()
        r         : Me   = rem.add(magnitude)
        whole     : Bool = r.eq(magnitude).bitand(magnitude.is_finite())
        // a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
        // one in range
        branch whole
            ? return(Me.from_bits(magnitude.bits().sub(1)))
            : return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
/// :param other: The value to compare with.
/// :returns: The smaller value, or NaN when either operand is NaN.
routine F32.minimum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitor(other.bits())))
            : continue
        pick : Bool = me.lt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
/// :param other: The value to compare with.
/// :returns: The larger value, or NaN when either operand is NaN.
routine F32.maximum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitand(other.bits())))
            : continue
        pick : Bool = me.gt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// Restricts `me` to `lo ..= hi`. NaN stays NaN.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` unless `lo <= hi`, so also when either bound is NaN.
#track_caller
routine F32.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        below : Bool = me.lt(lo)
        above : Bool = me.gt(hi)
        upper : Me   = above
            ? hi
            : me
        r : Me = below
            ? lo
            : upper
        return(r)

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`. False when any operand is NaN.
routine F32.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`. False when any operand is NaN.
routine F32.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as `me` comes before, at the same place as, or after `other` in that order.
routine F32.total_compare(me: Me, other: Me) -> S32
    block entry()
        a : S32 = me.bits().to_wrap<S32>()
        b : S32 = other.bits().to_wrap<S32>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S32 = a.bitxor(a.shr(31).bitand(S32.MAX))
        b_key : S32 = b.bitxor(b.shr(31).bitand(S32.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

// AArch64 has an instruction for each. Elsewhere LLVM calls libm (x86 before SSE4.1 has none), so the other
// targets work on the bits: trunc clears the fraction bits, and the rest adjust its result, all exactly.

/// Rounds toward negative infinity with the AArch64 rounding instruction.
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F32.floor(me: Me) -> Me
    block entry()
        r : Me = floor<Me>(me)
        return(r)

/// Rounds toward negative infinity from {F32.trunc}, stepping one down when truncation moved the value up (exact).
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F32.floor(me: Me) -> Me
    block entry()
        t    : Me   = me.trunc()
        down : Bool = t.gt(me)
        r    : Me   = down
            ? t.sub(1.0)
            : t
        return(r)

/// Rounds toward positive infinity with the AArch64 rounding instruction.
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F32.ceil(me: Me) -> Me
    block entry()
        r : Me = ceil<Me>(me)
        return(r)

/// Rounds toward positive infinity from {F32.trunc}, stepping one up when truncation moved the value down (exact).
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F32.ceil(me: Me) -> Me
    block entry()
        t  : Me   = me.trunc()
        up : Bool = t.lt(me)
        r  : Me   = up
            ? t.add(1.0)
            : t
        return(r)

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F32.round(me: Me) -> Me
    block entry()
        r : Me = round<Me>(me)
        return(r)

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F32.round(me: Me) -> Me
    block entry()
        t        : Me   = me.trunc()
        fraction : Me   = me.sub(t)
        half     : Bool = fraction.abs().ge(0.5)
        away     : Me   = t.add(Me.copysign(1.0, me))
        r        : Me   = half
            ? away
            : t
        return(r)

/// Rounds half-way cases to the even neighbor.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F32.round_ties_even(me: Me) -> Me
    block entry()
        r : Me = rint<Me>(me)
        return(r)

/// Rounds half-way cases to the even neighbor.
///
/// Below 2^23, adding and subtracting 2^23 leaves the magnitude rounded to an integer by the addition.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F32.round_ties_even(me: Me) -> Me
    block entry()
        magnitude : Me   = me.abs()
        integral  : Bool = magnitude.ge(8388608.0)
        branch integral
            ? return(me)
            : continue
        rounded : Me = magnitude.add(8388608.0).sub(8388608.0)
        r       : Me = rounded.copysign(me)
        return(r)

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F32.trunc(me: Me) -> Me
    block entry()
        r : Me = ftrunc<Me>(me)
        return(r)

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F32.trunc(me: Me) -> Me
    shared bits  : U32 = me.bits()
    shared field : U32 = bits.shr(23).bitand(0xFF)

    block entry()
        special   : Bool = field.eq(0xFF)
        integral  : Bool = field.ge(150)
        below_one : Bool = field.lt(127)
        when
            special   -> return(me.add(me))
            integral  -> return(me)
            below_one -> return(Me.from_bits(bits.bitand(0x80000000)))
            else      -> fraction()

    // 1 <= |me| < 2^23: the lowest 150 - field bits are the fraction
    block fraction()
        mask : U32 = 1.shl(U32.sub(150, field)).sub(1)
        r    : Me  = Me.from_bits(bits.bitand(mask.bitnot()))
        return(r)

/// `me` minus its integer part, with the sign of `me`.
/// :returns: The fractional part. NaN for an infinity or NaN.
routine F32.fract(me: Me) -> Me
    block entry()
        whole : Me = me.trunc()
        r     : Me = me.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in Standard/F32Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// The square root of `me`.
/// :returns: The square root: NaN for negative values other than -0.0, which gives -0.0.
routine F32.sqrt(me: Me) -> Me
    block entry()
        r : Me = sqrt<Me>(me)
        return(r)

/// me raised to an integer power, correctly rounded. An n of at most 2^24 in magnitude converts to F32
/// exactly and goes to powf. A larger one goes through the F64 power, whose rounding to F32 is correct unless it
/// lands exactly on an F32 midpoint. There the F128 power decides (checked for every x and n that reach it).
/// :param n: The integer exponent.
/// :returns: `me` to the power `n`, rounded once.
routine F32.powi(me: Me, n: S32) -> Me
    block entry()
        small : Bool = n.abs_diff(0).le(0x1000000)
        branch small
            ? continue
            : wide()
        r : Me = me.powf(n.to<Me>())
        return(r)

    block wide()
        r   : F64  = me.to<F64>().powf(n.to<F64>())
        tie : Bool = f32_is_on_midpoint_f64(r)
        branch tie
            ? exact()
            : return(r.to<Me>())

    block exact()
        r : F128 = me.to<F128>().powf(n.to<F128>())
        return(r.to<Me>())

/// Whether r lies exactly between two F32 values.
/// :param r: The F64 value to test.
/// :returns: True when `r` is finite and lies exactly halfway between two adjacent F32 values.
private routine f32_is_on_midpoint_f64(r: F64) -> Bool
    shared a : F64 = r.abs()

    block entry()
        sub : Bool = a.lt(0x1p-126)
        branch sub
            ? subnormal()
            : normal()

    // F32 keeps 23 fraction bits: a midpoint has bit 28 set and nothing below it.
    block normal()
        low : U64  = a.bits().bitand(0x1FFFFFFF)
        mid : Bool = a.is_finite().bitand(low.eq(0x10000000))
        return(mid)

    // Below 2^-126 F32's quantum is 2^-149: a midpoint is an odd multiple of 2^-150.
    block subnormal()
        t     : F64  = a.mul(0x1p150)
        whole : Bool = t.trunc().eq(t)
        odd   : Bool = t.mod(2.0).eq(1.0)
        return(whole.bitand(odd))

/// The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even). Three
/// tiers, each kept only when an error band around its quotient rounds to one F32 (Ziv's test): the correctly rounded
/// F64 logarithms divided in F64 (within 3 × 2^-53 relative, band 2^-50), then the correctly rounded F128 logarithms
/// divided in F128 (band 2^-109), then both logarithms in F128Big ({big_log_ratio}). Exact results come out exact:
/// log(8, 2) = 3, log(1000, 10) = 3, log(x, x) = 1.
/// :param base: The base of the logarithm.
/// :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the F32 quotient
///     ln(`me`) / ln(`base`): NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for
///     `me` 1 or base 0 or +inf, NaN when both logarithms are zero or both infinite.
/// :note: Every positive finite `me` with base 2 and base 10 gives the correctly rounded log2 and log10.
routine F32.log(me: Me, base: Me) -> Me
    block entry()
        x_ok    : Bool = me.gt(0.0).bitand(me.is_finite())
        base_ok : Bool = base.gt(0.0).bitand(base.is_finite())
        one     : Bool = me.eq(1.0).bitor(base.eq(1.0))
        general : Bool = x_ok.bitand(base_ok).bitand(one.bitnot())
        branch general
            ? narrow()
            : return(me.ln().div(base.ln()))

    block narrow()
        q     : F64 = me.to<F64>().ln().div(base.to<F64>().ln())
        width : F64 = q.abs().mul(0x1p-50)
        left  : Me  = q.sub(width).to<Me>()
        right : Me  = q.add(width).to<Me>()
        branch left.eq(right)
            ? return(left)
            : wide()

    block wide()
        q     : F128 = me.to<F128>().ln().div(base.to<F128>().ln())
        width : F128 = q.abs().scalbn(-109)
        left  : Me   = q.sub(width).to<Me>()
        right : Me   = q.add(width).to<Me>()
        branch left.eq(right)
            ? return(left)
            : exact()

    block exact()
        r : F128 = big_log_ratio(me.to<F128>(), base.to<F128>(), 23)
        return(r.to<Me>())

// -- special functions ---------------------------------------------------------

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to F32).
/// :returns: `me` in degrees, rounded once.
routine F32.to_degrees(me: Me) -> Me
    block entry()
        r : Me = me.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to F32).
/// :returns: `me` in radians, rounded once.
routine F32.to_radians(me: Me) -> Me
    block entry()
        r : Me = me.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- classification ------------------------------------------------------------

/// Whether `me` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine F32.is_nan(me: Me) -> Bool
    block entry()
        r : Bool = funo<Me>(me, me)
        return(r)

/// Whether `me` is +inf or -inf.
/// :returns: True for either infinity. False for NaN and finite values.
routine F32.is_infinite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.eq(Me.INFINITY)
        return(r)

/// Neither infinite nor NaN.
/// :returns: True for zeros, subnormals and normal values. False for infinities and NaN.
routine F32.is_finite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.lt(Me.INFINITY)
        return(r)

/// Not zero, subnormal, infinite, or NaN.
/// :returns: True when the exponent field is neither all zeros nor all ones.
routine F32.is_normal(me: Me) -> Bool
    block entry()
        exponent : U32  = me.bits().bitand(0x7F800000)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7F800000))
        return(r)

/// Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `F32.MIN_POSITIVE`.
/// :returns: True for subnormals. False for zero, normal values, infinities and NaN.
routine F32.is_subnormal(me: Me) -> Bool
    block entry()
        bits     : U32  = me.bits()
        exponent : U32  = bits.bitand(0x7F800000)
        mantissa : U32  = bits.bitand(0x007FFFFF)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
/// :returns: The encoding as a U32: sign bit at the top, then the exponent field, then the fraction.
routine F32.bits(me: Me) -> U32
    block entry()
        r : U32 = bitcast<Me, U32>(me)
        return(r)

/// Reinterprets raw IEEE 754 binary32 bits as a F32, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {F32.bits} for the inverse.
routine F32.from_bits(bits: U32) -> Me
    block entry()
        r : Me = bitcast<U32, Me>(bits)
        return(r)

// -- float conversions -----------------------------------------------------------

/// Rounds to nearest, ties to even. Written with integer operations instead of
/// fptrunc, which would call compiler-rt's `__truncsfhf2`.
/// :returns: The nearest F16. Values past the F16 range give a signed infinity, and NaN stays NaN (made quiet).
routine F32.to<F16>(me: Me) -> F16
    shared bits      : U32 = me.bits()
    shared high_half : U16 = bits.shr(16).to<U16>()
    shared sign      : U16 = high_half.bitand(0x8000)
    shared magnitude : U32 = bits.bitand(0x7FFFFFFF)

    block entry()
        when
            magnitude.ge(0x7F800000) -> special()
            magnitude.ge(0x477FF000) -> overflow()
            magnitude.lt(0x38800000) -> subnormal()
            else                     -> normal()

    block overflow()
        r : F16 = .from_bits(sign.bitor(0x7C00))
        return(r)

    // Infinity stays infinity. NaN keeps its top payload bits and is made quiet.
    block special()
        payload_bits : U32  = magnitude.bitand(0x7FFFFF).shr(13)
        payload      : U16  = payload_bits.to<U16>()
        is_nan       : Bool = magnitude.gt(0x7F800000)
        nan_bits     : U16  = payload.bitor(0x7E00)
        body         : U16  = is_nan
            ? nan_bits
            : 0x7C00
        r : F16 = .from_bits(sign.bitor(body))
        return(r)

    // Below F16's smallest normal: scale so one F16 subnormal step is 1.0, and
    // round to an integer (exact in F32, ties to even). 0x400 carries into the
    // smallest normal, which is the right encoding.
    block subnormal()
        scaled : Me  = Me.from_bits(magnitude).mul(16777216.0)
        steps  : U16 = scaled.round_ties_even().to<U16>()
        r      : F16 = .from_bits(sign.bitor(steps))
        return(r)

    // Round the 13 dropped mantissa bits to even, then rebias the exponent from
    // 127 to 15. A carry out of the mantissa bumps the exponent, as it should.
    block normal()
        lowest_kept : U32 = magnitude.shr(13).bitand(1)
        rounded     : U32 = magnitude.add(0xFFF).add(lowest_kept)
        rebiased    : U32 = rounded.shr(13).sub(0x1C000)
        r           : F16 = .from_bits(sign.bitor(rebiased.to<U16>()))
        return(r)

/// Rounds to nearest, ties to even, by adding a bias below the kept 16 bits.
/// Written out because the Windows compiler-rt has no __truncsfbf2.
/// :returns: The nearest BF16. NaN stays NaN (made quiet).
routine F32.to<BF16>(me: Me) -> BF16
    shared bits : U32 = me.bits()

    block entry()
        nan : Bool = me.is_nan()
        branch nan
            ? quiet_nan()
            : round()

    // Keep the sign and top payload bits, and force the quiet bit.
    block quiet_nan()
        high_half : U16  = bits.shr(16).to<U16>()
        top       : U16  = high_half.bitor(0x0040)
        r         : BF16 = .from_bits(top)
        return(r)

    block round()
        lowest_kept  : U32  = bits.shr(16).bitand(1)
        bias         : U32  = lowest_kept.add(0x7FFF)
        rounded_bits : U32  = bits.add(bias).shr(16)
        top          : U16  = rounded_bits.to<U16>()
        r            : BF16 = .from_bits(top)
        return(r)

/// The identity conversion, so generic code can call `to<T>()` when `T` is F32.
/// :returns: `me` unchanged.
routine F32.to<Me>(me: Me) -> Me
    block entry()
        return(me)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_<int>_checked returns None instead and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {F32.to_checked<S8>} to get an absent value instead, {F32.to_clamp<S8>} to saturate.
#track_caller
routine F32.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.is_trunc_in_range(-128.0, 128.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-128, 127].
/// :see: {F32.to<S8>} to crash instead, {F32.to_clamp<S8>} to saturate.
routine F32.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.is_trunc_in_range(-128.0, 128.0)
        value : S8         = fptosi_sat<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<S8>} to detect values that do not fit.
routine F32.to_clamp<S8>(me: Me) -> S8
    block entry()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {F32.to_checked<S16>} to get an absent value instead, {F32.to_clamp<S16>} to saturate.
#track_caller
routine F32.to<S16>(me: Me) -> S16
    block entry()
        fits : Bool = me.is_trunc_in_range(-32768.0, 32768.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = fptosi_sat<Me, S16>(me)
        return(r)

/// Converts to S16, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-32768, 32767].
/// :see: {F32.to<S16>} to crash instead, {F32.to_clamp<S16>} to saturate.
routine F32.to_checked<S16>(me: Me) -> Option<S16>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-32768.0, 32768.0)
        value : S16         = fptosi_sat<Me, S16>(me)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts to S16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<S16>} to detect values that do not fit.
routine F32.to_clamp<S16>(me: Me) -> S16
    block entry()
        r : S16 = fptosi_sat<Me, S16>(me)
        return(r)

/// Converts to S32, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1]. The crash reports the caller's location.
/// :see: {F32.to_checked<S32>} to get an absent value instead, {F32.to_clamp<S32>} to saturate.
#track_caller
routine F32.to<S32>(me: Me) -> S32
    block entry()
        fits : Bool = me.is_trunc_in_range(-2147483648.0, 2147483648.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = fptosi_sat<Me, S32>(me)
        return(r)

/// Converts to S32, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1].
/// :see: {F32.to<S32>} to crash instead, {F32.to_clamp<S32>} to saturate.
routine F32.to_checked<S32>(me: Me) -> Option<S32>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-2147483648.0, 2147483648.0)
        value : S32         = fptosi_sat<Me, S32>(me)
        r     : Option<S32> = fits.then_present(value)
        return(r)

/// Converts to S32, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^31, 2^31 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<S32>} to detect values that do not fit.
routine F32.to_clamp<S32>(me: Me) -> S32
    block entry()
        r : S32 = fptosi_sat<Me, S32>(me)
        return(r)

/// Converts to S64, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1]. The crash reports the caller's location.
/// :see: {F32.to_checked<S64>} to get an absent value instead, {F32.to_clamp<S64>} to saturate.
#track_caller
routine F32.to<S64>(me: Me) -> S64
    block entry()
        fits : Bool = me.is_trunc_in_range(-9223372036854775808.0, 9223372036854775808.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S64 = fptosi_sat<Me, S64>(me)
        return(r)

/// Converts to S64, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1].
/// :see: {F32.to<S64>} to crash instead, {F32.to_clamp<S64>} to saturate.
routine F32.to_checked<S64>(me: Me) -> Option<S64>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-9223372036854775808.0, 9223372036854775808.0)
        value : S64         = fptosi_sat<Me, S64>(me)
        r     : Option<S64> = fits.then_present(value)
        return(r)

/// Converts to S64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^63, 2^63 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<S64>} to detect values that do not fit.
routine F32.to_clamp<S64>(me: Me) -> S64
    block entry()
        r : S64 = fptosi_sat<Me, S64>(me)
        return(r)

/// Converts to S128, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1]. The crash reports the caller's location.
/// :see: {F32.to_checked<S128>} to get an absent value instead, {F32.to_clamp<S128>} to saturate.
#track_caller
routine F32.to<S128>(me: Me) -> S128
    block entry()
        fits : Bool = me.is_trunc_in_range(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S128 = fptosi_sat<Me, S128>(me)
        return(r)

/// Converts to S128, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
/// :see: {F32.to<S128>} to crash instead, {F32.to_clamp<S128>} to saturate.
routine F32.to_checked<S128>(me: Me) -> Option<S128>
    block entry()
        fits  : Bool         = me.is_trunc_in_range(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        value : S128         = fptosi_sat<Me, S128>(me)
        r     : Option<S128> = fits.then_present(value)
        return(r)

/// Converts to S128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^127, 2^127 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<S128>} to detect values that do not fit.
routine F32.to_clamp<S128>(me: Me) -> S128
    block entry()
        r : S128 = fptosi_sat<Me, S128>(me)
        return(r)

/// Converts to U8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 255]. The crash reports the caller's location.
/// :see: {F32.to_checked<U8>} to get an absent value instead, {F32.to_clamp<U8>} to saturate.
#track_caller
routine F32.to<U8>(me: Me) -> U8
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 256.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U8 = fptoui_sat<Me, U8>(me)
        return(r)

/// Converts to U8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 255].
/// :see: {F32.to<U8>} to crash instead, {F32.to_clamp<U8>} to saturate.
routine F32.to_checked<U8>(me: Me) -> Option<U8>
    block entry()
        fits  : Bool       = me.is_trunc_in_range(0.0, 256.0)
        value : U8         = fptoui_sat<Me, U8>(me)
        r     : Option<U8> = fits.then_present(value)
        return(r)

/// Converts to U8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 255]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<U8>} to detect values that do not fit.
routine F32.to_clamp<U8>(me: Me) -> U8
    block entry()
        r : U8 = fptoui_sat<Me, U8>(me)
        return(r)

/// Converts to U16, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 65535]. The crash reports the caller's location.
/// :see: {F32.to_checked<U16>} to get an absent value instead, {F32.to_clamp<U16>} to saturate.
#track_caller
routine F32.to<U16>(me: Me) -> U16
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 65536.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U16 = fptoui_sat<Me, U16>(me)
        return(r)

/// Converts to U16, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 65535].
/// :see: {F32.to<U16>} to crash instead, {F32.to_clamp<U16>} to saturate.
routine F32.to_checked<U16>(me: Me) -> Option<U16>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(0.0, 65536.0)
        value : U16         = fptoui_sat<Me, U16>(me)
        r     : Option<U16> = fits.then_present(value)
        return(r)

/// Converts to U16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 65535]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<U16>} to detect values that do not fit.
routine F32.to_clamp<U16>(me: Me) -> U16
    block entry()
        r : U16 = fptoui_sat<Me, U16>(me)
        return(r)

/// Converts to U32, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^32 - 1]. The crash reports the caller's location.
/// :see: {F32.to_checked<U32>} to get an absent value instead, {F32.to_clamp<U32>} to saturate.
#track_caller
routine F32.to<U32>(me: Me) -> U32
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 4294967296.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U32 = fptoui_sat<Me, U32>(me)
        return(r)

/// Converts to U32, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 2^32 - 1].
/// :see: {F32.to<U32>} to crash instead, {F32.to_clamp<U32>} to saturate.
routine F32.to_checked<U32>(me: Me) -> Option<U32>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(0.0, 4294967296.0)
        value : U32         = fptoui_sat<Me, U32>(me)
        r     : Option<U32> = fits.then_present(value)
        return(r)

/// Converts to U32, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 2^32 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F32.to_checked<U32>} to detect values that do not fit.
routine F32.to_clamp<U32>(me: Me) -> U32
    block entry()
        r : U32 = fptoui_sat<Me, U32>(me)
        return(r)

/// Converts to U64, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^64 - 1]. The crash reports the caller's location.
/// :see: {F32.to_checked<U64>} to get an absent value instead, {F32.to_clamp<U64>} to saturate.
#track_caller
routine F32.to<U64>(me: Me) -> U64
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 18446744073709551616.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U64 = fptoui_sat<Me, U64>(me)
        return(r)

