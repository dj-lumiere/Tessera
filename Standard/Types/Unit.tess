// Tessera stdlib: Unit — the type with exactly one value
//
// Maps to the empty LLVM struct {} (zero size). Unlike Void, Unit values
// exist: they can be bound, passed, stored in fields, and used as a generic
// argument. Use it where a generic slot needs "no payload", most commonly
// Result<Unit, E> for operations that either succeed or fail with an error.

module Standard::Core

/// The type with exactly one value, mapped to the empty LLVM struct `{}`. Unlike `Void` it can be bound, passed, and stored, so it fills a generic slot that needs no payload, such as `Result<Unit, E>`.
record Unit
conform Equal<Unit>, Hash<Unit>

/// The only `Unit` value.
/// :returns: The `Unit` value.
routine Unit.value() -> Self
    block entry():
        u : Self = Self {}
        return(u)

// -- equality, hashing ---------------------------------------------------------

/// There is only one Unit value, so every pair is equal.
routine Unit.eq(self: Self, other: Self) -> Bool
    block entry():
        return(true)

/// Hashes the one `Unit` value; every `Unit` hashes the same.
/// :returns: A constant 64-bit hash.
routine Unit.hash(self: Self) -> U64
    block entry():
        h : U64 = xxh64_hash_u64(0, 0)
        return(h)
