// Tessera stdlib: Unit — the type with exactly one value
//
// Maps to the empty LLVM struct {} (zero size). Unlike Void, Unit values
// exist: they can be bound, passed, stored in fields, and used as a generic
// argument. Its value is written Unit(). It is the branch of Maybe[T] that
// holds nothing, and Result[Unit, E] is an operation that either succeeds or
// fails with an error.

module Standard/Core

/// The type with exactly one value, mapped to the empty LLVM struct `{}`. Unlike `Void` it can be bound, passed, and stored, so it fills a generic slot that needs no payload, such as `Result[Unit, E]`.
record Unit
conform Equatable[Unit], Hashable[Unit], Comparable[Unit]

// -- equality, hashing ---------------------------------------------------------

/// There is only one `Unit` value, so every pair is equal.
/// :param other: The other `Unit`.
/// :returns: Always `true`.
routine Unit.eq(me: Me, other: Me) -> Bool
    block entry()
        return(true)

/// Hashes the one `Unit` value. Every `Unit` hashes the same.
/// :returns: A constant 64-bit hash.
routine Unit.hash(me: Me) -> U64
    block entry()
        h: U64 = siphash24(value: 0, key: hash_key())
        return(h)

/// Unit values are all equal.
/// :param other: The value to compare with.
/// :returns: Always 0.
routine Unit.compare(me: Me, other: Me) -> S32
    block entry()
        return(0)
