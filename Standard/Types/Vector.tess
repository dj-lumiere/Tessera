// Tessera stdlib: Vector<T, LANES> — LANES lanes of T as one SIMD value
//
// Maps to LLVM IR <LANES x T>, built into the builder like Array<T, COUNT>. A lane is an integer (S8..S64, U8..U64, USize,
// SSize), a float (F32, F64), or a Bool, which makes Vector<Bool, LANES> a lane mask: what a compare gives and select
// takes. LANES is any buildtime USize of at least 1, and the width is the program's choice: the same Vector<F32, 8>
// is one AVX register on x86-64-v3 and two SSE ones on x86-64-v1, and correct either way. SIMD_BYTES says how wide
// the target's native vectors are, for code that wants to match it.
//
// Operations are lane-wise and named like the scalar ones, with the same rules: integer add, sub, and mul crash if
// any lane overflows (the _wrap and _clamp forms don't), a shift by the lane width or more shifts every bit out,
// and float min and max return the other operand when one is NaN. Compares give a mask. The layout is LLVM's:
// lanes packed (a Bool lane is one bit) and aligned for the whole vector, so Vector<F32, 3> takes 16 bytes where
// Array<F32, 3> takes 12. A Vector can't cross the C ABI yet.

module Standard::Core

/// `LANES` lanes of `T` held as one SIMD value, mapped to LLVM `<LANES x T>`. A lane is an integer, a float, or a `Bool` (a `Vector<Bool, LANES>` is a lane mask). Operations are lane-wise and follow the scalar rules, and `LANES` may be any buildtime `USize` of at least 1.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
#llvm("<{LANES} x {T}>")
record Vector<T, LANES>
require T: typename, LANES: USize

// -- lane kinds ----------------------------------------------------------------------

/// T is an integer lane: wrapping, clamping, and bitwise operations.
concept IntLane<T>
require T: typename

/// T is a float lane: division, square root, negation.
concept FloatLane<T>
require T: typename

/// T is a number lane, integer or float: arithmetic, compares, min and max, memory.
concept NumberLane<T>
require T: typename

/// T is a lane the bitwise operations take: an integer or a Bool.
concept BitLane<T>
require T: typename

/// T is Bool: the vector is a lane mask.
concept MaskLane<T>
require T: typename

conform IntLane<S8>, IntLane<S16>, IntLane<S32>, IntLane<S64>, IntLane<U8>, IntLane<U16>, IntLane<U32>, IntLane<U64>, IntLane<USize>, IntLane<SSize>
conform FloatLane<F32>, FloatLane<F64>
conform NumberLane<S8>, NumberLane<S16>, NumberLane<S32>, NumberLane<S64>, NumberLane<U8>, NumberLane<U16>, NumberLane<U32>, NumberLane<U64>, NumberLane<USize>, NumberLane<SSize>, NumberLane<F32>, NumberLane<F64>
conform BitLane<S8>, BitLane<S16>, BitLane<S32>, BitLane<S64>, BitLane<U8>, BitLane<U16>, BitLane<U32>, BitLane<U64>, BitLane<USize>, BitLane<SSize>, BitLane<Bool>
conform MaskLane<Bool>

// -- the target's native width ---------------------------------------------------------

// The bytes in one of the target's vector registers, or 0 without SIMD registers: Vector<F32, SIMD_BYTES.div(4)>
// matches it. 32 with AVX2 (--cpu x86-64-v3 and up). 16 with SSE2, on AArch64, on ARM with NEON, and on RISC-V with
// V (its registers are at least 128 bits). 0 on i386 without SSE2, ARM without NEON (Cortex-M), RISC-V without V,
// and AVR. A wider Vector still works on any target, split into several registers or into scalar code.
/// The `SIMD_BYTES` value on x86-64 with AVX2: 32 bytes, one 256-bit register.
#[target(arch: "x86_64"), feature("avx2")]
preset SIMD_BYTES: USize = 32
/// The `SIMD_BYTES` value on x86-64 without AVX2: 16 bytes, one SSE2 register.
#[target(arch: "x86_64"), feature(not "avx2")]
preset SIMD_BYTES: USize = 16
/// The `SIMD_BYTES` value on 32-bit x86 with AVX2: 32 bytes, one 256-bit register.
#[target(arch: "x86"), feature("avx2")]
preset SIMD_BYTES: USize = 32
/// The `SIMD_BYTES` value on 32-bit x86 without AVX2 but with SSE2: 16 bytes, one SSE2 register.
#[target(arch: "x86"), feature(not "avx2"), feature("sse2")]
preset SIMD_BYTES: USize = 16
/// The `SIMD_BYTES` value on 32-bit x86 without SSE2: 0, since there are no vector registers.
#[target(arch: "x86"), feature(not "sse2")]
preset SIMD_BYTES: USize = 0
/// The `SIMD_BYTES` value on AArch64: 16 bytes, one NEON register.
#target(arch: "aarch64")
preset SIMD_BYTES: USize = 16
/// The `SIMD_BYTES` value on ARM with NEON: 16 bytes, one NEON register.
#[target(arch: "arm"), feature("neon")]
preset SIMD_BYTES: USize = 16
/// The `SIMD_BYTES` value on ARM without NEON: 0, since there are no vector registers.
#[target(arch: "arm"), feature(not "neon")]
preset SIMD_BYTES: USize = 0
/// The `SIMD_BYTES` value on 64-bit RISC-V with the V extension: 16 bytes, the minimum register width of V.
#[target(arch: "riscv64"), feature("v")]
preset SIMD_BYTES: USize = 16
/// The `SIMD_BYTES` value on 64-bit RISC-V without the V extension: 0, since there are no vector registers.
#[target(arch: "riscv64"), feature(not "v")]
preset SIMD_BYTES: USize = 0
/// The `SIMD_BYTES` value on 32-bit RISC-V with the V extension: 16 bytes, the minimum register width of V.
#[target(arch: "riscv32"), feature("v")]
preset SIMD_BYTES: USize = 16
/// The `SIMD_BYTES` value on 32-bit RISC-V without the V extension: 0, since there are no vector registers.
#[target(arch: "riscv32"), feature(not "v")]
preset SIMD_BYTES: USize = 0
/// The `SIMD_BYTES` value on any other architecture: 0, since no vector registers are known.
#target(arch: not ("x86_64", "x86", "aarch64", "arm", "riscv64", "riscv32"))
preset SIMD_BYTES: USize = 0

// -- metadata --------------------------------------------------------------------------

/// The number of lanes, which is `LANES`.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :returns: `LANES` as a `USize`.
routine Vector<T, LANES>.count() -> USize
require T: typename, LANES: USize
    block entry()
        return(LANES)

// -- construction ----------------------------------------------------------------------

/// A vector with every lane set to `x`.
/// :param x: The value for every lane.
/// :returns: The vector of `LANES` copies of `x`.
#[external("llvm"),
    template("{t0} = insertelement {Me} poison, {T} {x}, i64 0\n{result} = shufflevector {Me} {t0}, {Me} poison, <{LANES} x i32> zeroinitializer")]
routine Vector<T, LANES>.splat(x: T) -> Me
require T: typename, LANES: USize

/// Every lane zero (false, for a mask).
/// :returns: The all-zero vector.
#[external("llvm"), template("{result} = bitcast {Me} zeroinitializer to {Me}")]
routine Vector<T, LANES>.zero() -> Me
require T: typename, LANES: USize

/// The array's elements as lanes, element i in lane i.
/// :returns: The vector whose lane i is element i.
routine Array<T, COUNT>.to<Vector<T, COUNT>>(me: Me) -> Vector<T, COUNT>
require T: typename, COUNT: USize
    shared elements : @Me               <- me
    shared acc      : @Vector<T, COUNT> <- uninit

    block entry()
        start : Vector<T, COUNT> = Vector<T, COUNT>.zero()
        start.store_into(acc)
        jump fill(0)

    block fill(i: USize)
        more : Bool = i.lt(COUNT)
        branch more
            ? put(i)
            : return(acc.load())

    block put(i: USize)
        lane : T                = elements.getitem(i)
        next : Vector<T, COUNT> = acc.load().with(i, lane)
        next.store_into(acc)
        jump fill(i.add(1))

/// The lanes as an array, lane i in element i.
/// :returns: The array whose element i is lane i.
routine Vector<T, LANES>.to<Array<T, LANES>>(me: Me) -> Array<T, LANES>
require T: typename, LANES: USize
    shared elements : @Array<T, LANES> <- uninit

    block entry()
        jump fill(0)

    block fill(i: USize)
        more : Bool = i.lt(LANES)
        branch more
            ? put(i)
            : done()

    block put(i: USize)
        lane : T = me.getitem(i)
        elements.setitem(i, lane)
        jump fill(i.add(1))

    block done()
        array : Array<T, LANES> = elements.load()
        return(array)

// -- lanes -----------------------------------------------------------------------------

/// Reads lane `index` with no bounds check. {Vector.get} is the checked form.
/// :param index: The lane to read. It must be less than `LANES`.
/// :returns: The lane value.
#[external("llvm"), template("{result} = extractelement {Me} {me}, {USize} {index}")]
private routine Vector<T, LANES>.get_unchecked(me: Me, index: USize) -> T
require T: typename, LANES: USize

/// Replaces lane `index` with no bounds check. {Vector.with} is the checked form.
/// :param index: The lane to replace. It must be less than `LANES`.
/// :param x: The new lane value.
/// :returns: A copy of `me` with that lane set.
#[external("llvm"), template("{result} = insertelement {Me} {me}, {T} {x}, {USize} {index}")]
private routine Vector<T, LANES>.with_unchecked(me: Me, index: USize, x: T) -> Me
require T: typename, LANES: USize

/// Reads lane `index`.
/// :param index: The lane to read.
/// :returns: The lane value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index` is `LANES` or more.
#track_caller
routine Vector<T, LANES>.getitem(me: Me, index: USize) -> T
require T: typename, LANES: USize
    block entry()
        in_bounds : Bool = index.lt(LANES)
        branch in_bounds
            ? continue
            : crash_out_of_bounds()
        lane : T = me.get_unchecked(index)
        return(lane)

/// A copy of `me` with lane `index` set to `x`.
/// :param index: The lane to replace.
/// :param x: The new lane value.
/// :returns: The copy with that lane set.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index` is `LANES` or more.
#track_caller
routine Vector<T, LANES>.with(me: Me, index: USize, x: T) -> Me
require T: typename, LANES: USize
    block entry()
        in_bounds : Bool = index.lt(LANES)
        branch in_bounds
            ? continue
            : crash_out_of_bounds()
        r : Me = me.with_unchecked(index, x)
        return(r)

// -- memory ----------------------------------------------------------------------------

// A @Vector<T, LANES> loads and stores the whole vector at the vector's alignment. These read and write LANES Ts in a
// row at any T-aligned address: an array's elements, a list's storage.

/// Reads the `LANES` values of `T` starting at `first` as lanes. `first` need only be aligned for `T`.
/// :param first: The address of the first value.
/// :returns: The vector, value i in lane i.
#[external("llvm"), template("{result} = load {Me}, ptr {first}, align {sizeof T}")]
routine Vector<T, LANES>.load_at(first: @T) -> Me
require T: typename, LANES: USize, NumberLane<T>

/// Writes the lanes to the `LANES` values of `T` starting at `first`. `first` need only be aligned for `T`.
/// :param first: The address of the first value.
#[external("llvm"), template("store {Me} {me}, ptr {first}, align {sizeof T}")]
routine Vector<T, LANES>.store_at(me: Me, first: @T) -> Void
require T: typename, LANES: USize, NumberLane<T>

// -- arithmetic ------------------------------------------------------------------------

/// Lane-wise sum with no overflow check: integer lanes wrap, float lanes add normally.
/// :param other: The right-hand operand.
/// :returns: The lane-wise sum.
#[external("llvm"), template("{result} = {by T|fadd|add|add} {Me} {me}, {other}")]
private routine Vector<T, LANES>.add_raw(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise difference with no overflow check: integer lanes wrap, float lanes subtract normally.
/// :param other: The right-hand operand.
/// :returns: The lane-wise difference.
#[external("llvm"), template("{result} = {by T|fsub|sub|sub} {Me} {me}, {other}")]
private routine Vector<T, LANES>.sub_raw(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise product with no overflow check: integer lanes wrap, float lanes multiply normally.
/// :param other: The right-hand operand.
/// :returns: The lane-wise product.
#[external("llvm"), template("{result} = {by T|fmul|mul|mul} {Me} {me}, {other}")]
private routine Vector<T, LANES>.mul_raw(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>

// Whether any lane overflows: never for floats.
/// Whether adding `other` overflows in any lane. Always false for float lanes.
/// :param other: The right-hand operand.
/// :returns: `true` when some lane overflows.
#[external("llvm"),
    template("{by T|{result} = or i1 false, false|{t0} = call {{ {Me}, <{LANES} x i1> }} @llvm.sadd.with.overflow.{mangle Me}({Me} {me}, {Me} {other})\n{t1} = extractvalue {{ {Me}, <{LANES} x i1> }} {t0}, 1\n{result} = call i1 @llvm.vector.reduce.or.v{LANES}i1(<{LANES} x i1> {t1})|{t0} = call {{ {Me}, <{LANES} x i1> }} @llvm.uadd.with.overflow.{mangle Me}({Me} {me}, {Me} {other})\n{t1} = extractvalue {{ {Me}, <{LANES} x i1> }} {t0}, 1\n{result} = call i1 @llvm.vector.reduce.or.v{LANES}i1(<{LANES} x i1> {t1})}")]
private routine Vector<T, LANES>.add_overflows(me: Me, other: Me) -> Bool
require T: typename, LANES: USize, NumberLane<T>

/// Whether subtracting `other` overflows in any lane. Always false for float lanes.
/// :param other: The right-hand operand.
/// :returns: `true` when some lane overflows.
#[external("llvm"),
    template("{by T|{result} = or i1 false, false|{t0} = call {{ {Me}, <{LANES} x i1> }} @llvm.ssub.with.overflow.{mangle Me}({Me} {me}, {Me} {other})\n{t1} = extractvalue {{ {Me}, <{LANES} x i1> }} {t0}, 1\n{result} = call i1 @llvm.vector.reduce.or.v{LANES}i1(<{LANES} x i1> {t1})|{t0} = call {{ {Me}, <{LANES} x i1> }} @llvm.usub.with.overflow.{mangle Me}({Me} {me}, {Me} {other})\n{t1} = extractvalue {{ {Me}, <{LANES} x i1> }} {t0}, 1\n{result} = call i1 @llvm.vector.reduce.or.v{LANES}i1(<{LANES} x i1> {t1})}")]
private routine Vector<T, LANES>.sub_overflows(me: Me, other: Me) -> Bool
require T: typename, LANES: USize, NumberLane<T>

/// Whether multiplying by `other` overflows in any lane. Always false for float lanes.
/// :param other: The right-hand operand.
/// :returns: `true` when some lane overflows.
#[external("llvm"),
    template("{by T|{result} = or i1 false, false|{t0} = call {{ {Me}, <{LANES} x i1> }} @llvm.smul.with.overflow.{mangle Me}({Me} {me}, {Me} {other})\n{t1} = extractvalue {{ {Me}, <{LANES} x i1> }} {t0}, 1\n{result} = call i1 @llvm.vector.reduce.or.v{LANES}i1(<{LANES} x i1> {t1})|{t0} = call {{ {Me}, <{LANES} x i1> }} @llvm.umul.with.overflow.{mangle Me}({Me} {me}, {Me} {other})\n{t1} = extractvalue {{ {Me}, <{LANES} x i1> }} {t0}, 1\n{result} = call i1 @llvm.vector.reduce.or.v{LANES}i1(<{LANES} x i1> {t1})}")]
private routine Vector<T, LANES>.mul_overflows(me: Me, other: Me) -> Bool
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise sum. For integers, crashes if any lane overflows.
/// :param other: The right-hand operand.
/// :returns: The lane-wise sum.
/// :throws: Crashes with `IntegerOverflowError` when an integer lane overflows.
#track_caller
routine Vector<T, LANES>.add(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>
    block entry()
        overflow : Bool = me.add_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = me.add_raw(other)
        return(r)

/// Lane-wise difference. For integers, crashes if any lane overflows.
/// :param other: The right-hand operand.
/// :returns: The lane-wise difference.
/// :throws: Crashes with `IntegerOverflowError` when an integer lane overflows.
#track_caller
routine Vector<T, LANES>.sub(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>
    block entry()
        overflow : Bool = me.sub_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = me.sub_raw(other)
        return(r)

/// Lane-wise product. For integers, crashes if any lane overflows.
/// :param other: The right-hand operand.
/// :returns: The lane-wise product.
/// :throws: Crashes with `IntegerOverflowError` when an integer lane overflows.
#track_caller
routine Vector<T, LANES>.mul(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>
    block entry()
        overflow : Bool = me.mul_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = me.mul_raw(other)
        return(r)

/// Lane-wise sum, each lane wrapping modulo 2^bits, where bits is the lane width.
/// :param other: The right-hand operand.
/// :returns: The wrapped lane-wise sum.
routine Vector<T, LANES>.add_wrap(me: Me, other: Me) -> Me
require T: typename, LANES: USize, IntLane<T>, NumberLane<T>
    block entry()
        r : Me = me.add_raw(other)
        return(r)

/// Lane-wise difference, each lane wrapping modulo 2^bits, where bits is the lane width.
/// :param other: The right-hand operand.
/// :returns: The wrapped lane-wise difference.
routine Vector<T, LANES>.sub_wrap(me: Me, other: Me) -> Me
require T: typename, LANES: USize, IntLane<T>, NumberLane<T>
    block entry()
        r : Me = me.sub_raw(other)
        return(r)

/// Lane-wise product, each lane wrapping modulo 2^bits, where bits is the lane width.
/// :param other: The right-hand operand.
/// :returns: The wrapped lane-wise product.
routine Vector<T, LANES>.mul_wrap(me: Me, other: Me) -> Me
require T: typename, LANES: USize, IntLane<T>, NumberLane<T>
    block entry()
        r : Me = me.mul_raw(other)
        return(r)

/// Lane-wise sum, each lane saturating at `T`'s `MIN` / `MAX`.
/// :param other: The right-hand operand.
/// :returns: The saturated lane-wise sum.
#[external("llvm"),
    template("{result} = call {Me} @llvm.{by T||s|u}add.sat.{mangle Me}({Me} {me}, {Me} {other})")]
routine Vector<T, LANES>.add_clamp(me: Me, other: Me) -> Me
require T: typename, LANES: USize, IntLane<T>

/// Lane-wise difference, each lane saturating at `T`'s `MIN` / `MAX`.
/// :param other: The right-hand operand.
/// :returns: The saturated lane-wise difference.
#[external("llvm"),
    template("{result} = call {Me} @llvm.{by T||s|u}sub.sat.{mangle Me}({Me} {me}, {Me} {other})")]
routine Vector<T, LANES>.sub_clamp(me: Me, other: Me) -> Me
require T: typename, LANES: USize, IntLane<T>

/// Lane-wise quotient of float lanes.
/// :param other: The divisor.
/// :returns: The lane-wise quotient.
#[external("llvm"), template("{result} = fdiv {Me} {me}, {other}")]
routine Vector<T, LANES>.div(me: Me, other: Me) -> Me
require T: typename, LANES: USize, FloatLane<T>

/// Each lane negated (-0.0 for 0.0).
/// :returns: `me` with every lane negated.
#[external("llvm"), template("{result} = fneg {Me} {me}")]
routine Vector<T, LANES>.neg(me: Me) -> Me
require T: typename, LANES: USize, FloatLane<T>

/// Each lane's magnitude.
/// :returns: The lane-wise absolute value.
#[external("llvm"), template("{result} = call {Me} @llvm.fabs.{mangle Me}({Me} {me})")]
routine Vector<T, LANES>.abs(me: Me) -> Me
require T: typename, LANES: USize, FloatLane<T>

/// Each lane's square root. NaN for a negative lane (other than -0.0).
/// :returns: The lane-wise square root.
#[external("llvm"), template("{result} = call {Me} @llvm.sqrt.{mangle Me}({Me} {me})")]
routine Vector<T, LANES>.sqrt(me: Me) -> Me
require T: typename, LANES: USize, FloatLane<T>

// min and max as selects, not minnum / maxnum: those become libm calls on 32-bit ARM. A NaN lane gives the other
// operand's lane, as the scalar min and max do. The templates take scalars or vectors alike.
/// Lane-wise minimum. When one lane is NaN the other operand's lane is returned, as the scalar `min` does.
/// :param other: The right-hand operand.
/// :returns: The smaller lane of each pair.
#[external("llvm"),
    template("{by T|{t0} = fcmp uno {Me} {me}, {me}\n{t1} = fcmp uno {Me} {other}, {other}\n{t2} = fcmp ole {Me} {me}, {other}\n{t3} = select <{LANES} x i1> {t2}, {Me} {me}, {Me} {other}\n{t4} = select <{LANES} x i1> {t0}, {Me} {other}, {Me} {t3}\n{result} = select <{LANES} x i1> {t1}, {Me} {me}, {Me} {t4}|{result} = call {Me} @llvm.smin.{mangle Me}({Me} {me}, {Me} {other})|{result} = call {Me} @llvm.umin.{mangle Me}({Me} {me}, {Me} {other})}")]
routine Vector<T, LANES>.min(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise maximum. When one lane is NaN the other operand's lane is returned, as the scalar `max` does.
/// :param other: The right-hand operand.
/// :returns: The larger lane of each pair.
#[external("llvm"),
    template("{by T|{t0} = fcmp uno {Me} {me}, {me}\n{t1} = fcmp uno {Me} {other}, {other}\n{t2} = fcmp oge {Me} {me}, {other}\n{t3} = select <{LANES} x i1> {t2}, {Me} {me}, {Me} {other}\n{t4} = select <{LANES} x i1> {t0}, {Me} {other}, {Me} {t3}\n{result} = select <{LANES} x i1> {t1}, {Me} {me}, {Me} {t4}|{result} = call {Me} @llvm.smax.{mangle Me}({Me} {me}, {Me} {other})|{result} = call {Me} @llvm.umax.{mangle Me}({Me} {me}, {Me} {other})}")]
routine Vector<T, LANES>.max(me: Me, other: Me) -> Me
require T: typename, LANES: USize, NumberLane<T>

// -- bitwise and shifts ----------------------------------------------------------------

/// Lane-wise bitwise AND.
/// :param other: The right-hand operand.
/// :returns: The lane-wise AND.
#[external("llvm"), template("{result} = and {Me} {me}, {other}")]
routine Vector<T, LANES>.bitand(me: Me, other: Me) -> Me
require T: typename, LANES: USize, BitLane<T>

/// Lane-wise bitwise OR.
/// :param other: The right-hand operand.
/// :returns: The lane-wise OR.
#[external("llvm"), template("{result} = or {Me} {me}, {other}")]
routine Vector<T, LANES>.bitor(me: Me, other: Me) -> Me
require T: typename, LANES: USize, BitLane<T>

/// Lane-wise bitwise XOR.
/// :param other: The right-hand operand.
/// :returns: The lane-wise XOR.
#[external("llvm"), template("{result} = xor {Me} {me}, {other}")]
routine Vector<T, LANES>.bitxor(me: Me, other: Me) -> Me
require T: typename, LANES: USize, BitLane<T>

/// Lane-wise bitwise complement.
/// :returns: `me` with every bit of every lane flipped.
#[external("llvm"), template("{result} = xor {Me} {me}, splat ({T} -1)")]
routine Vector<T, LANES>.bitnot(me: Me) -> Me
require T: typename, LANES: USize, BitLane<T>

/// Each lane shifted left by the matching lane of `n`. A shift by the lane width or more (or a negative one) gives 0.
/// :param n: The shift amount for each lane.
/// :returns: The shifted lanes.
#[external("llvm"),
    template("{t0} = icmp ult {Me} {n}, splat ({T} {bits T})\n{t1} = shl {Me} {me}, {n}\n{result} = select <{LANES} x i1> {t0}, {Me} {t1}, {Me} zeroinitializer")]
routine Vector<T, LANES>.shl(me: Me, n: Me) -> Me
require T: typename, LANES: USize, IntLane<T>

/// Each lane shifted right by the matching lane of `n`: arithmetic for signed lanes, logical for unsigned. A shift
/// by the lane width or more (or a negative one) gives the sign fill: 0, or -1 for a negative signed lane.
/// :param n: The shift amount for each lane.
/// :returns: The shifted lanes.
#[external("llvm"),
    template("{t0} = icmp ult {Me} {n}, splat ({T} {bits T})\n{by T||{t1} = ashr {Me} {me}, {n}\n{t3} = icmp slt {Me} {me}, zeroinitializer\n{t2} = sext <{LANES} x i1> {t3} to {Me}|{t1} = lshr {Me} {me}, {n}\n{t2} = bitcast {Me} zeroinitializer to {Me}}\n{result} = select <{LANES} x i1> {t0}, {Me} {t1}, {Me} {t2}")]
routine Vector<T, LANES>.shr(me: Me, n: Me) -> Me
require T: typename, LANES: USize, IntLane<T>

// -- compares --------------------------------------------------------------------------

// Each gives a mask, lane i true where the compare holds for lane i. Float compares are ordered (false when a lane
// is NaN), as the scalar ones are.

/// Lane-wise test of whether each lane of `me` is equal to the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :param other: The right-hand operand.
/// :returns: A mask whose lane i is true where the relation holds for lane i.
#[external("llvm"), template("{result} = {by T|fcmp oeq|icmp eq|icmp eq} {Me} {me}, {other}")]
routine Vector<T, LANES>.eq(me: Me, other: Me) -> Vector<Bool, LANES>
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise test of whether each lane of `me` is different from the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :param other: The right-hand operand.
/// :returns: A mask whose lane i is true where the relation holds for lane i.
#[external("llvm"), template("{result} = {by T|fcmp one|icmp ne|icmp ne} {Me} {me}, {other}")]
routine Vector<T, LANES>.ne(me: Me, other: Me) -> Vector<Bool, LANES>
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise test of whether each lane of `me` is less than the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :param other: The right-hand operand.
/// :returns: A mask whose lane i is true where the relation holds for lane i.
#[external("llvm"), template("{result} = {by T|fcmp olt|icmp slt|icmp ult} {Me} {me}, {other}")]
routine Vector<T, LANES>.lt(me: Me, other: Me) -> Vector<Bool, LANES>
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise test of whether each lane of `me` is less than or equal to the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :param other: The right-hand operand.
/// :returns: A mask whose lane i is true where the relation holds for lane i.
#[external("llvm"), template("{result} = {by T|fcmp ole|icmp sle|icmp ule} {Me} {me}, {other}")]
routine Vector<T, LANES>.le(me: Me, other: Me) -> Vector<Bool, LANES>
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise test of whether each lane of `me` is greater than the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :param other: The right-hand operand.
/// :returns: A mask whose lane i is true where the relation holds for lane i.
#[external("llvm"), template("{result} = {by T|fcmp ogt|icmp sgt|icmp ugt} {Me} {me}, {other}")]
routine Vector<T, LANES>.gt(me: Me, other: Me) -> Vector<Bool, LANES>
require T: typename, LANES: USize, NumberLane<T>

/// Lane-wise test of whether each lane of `me` is greater than or equal to the matching lane of `other`. Float compares are ordered, so a NaN lane gives false.
/// :typeparam T: The lane type.
/// :typeparam LANES: The number of lanes.
/// :param other: The right-hand operand.
/// :returns: A mask whose lane i is true where the relation holds for lane i.
#[external("llvm"), template("{result} = {by T|fcmp oge|icmp sge|icmp uge} {Me} {me}, {other}")]
routine Vector<T, LANES>.ge(me: Me, other: Me) -> Vector<Bool, LANES>
require T: typename, LANES: USize, NumberLane<T>

// -- masks -----------------------------------------------------------------------------

/// Whether every lane is true.
/// :returns: `true` when every lane of the mask is true.
#[external("llvm"), template("{result} = call i1 @llvm.vector.reduce.and.{mangle Me}({Me} {me})")]
routine Vector<T, LANES>.is_all_true(me: Me) -> Bool
require T: typename, LANES: USize, MaskLane<T>

/// Whether some lane is true.
/// :returns: `true` when at least one lane of the mask is true.
#[external("llvm"), template("{result} = call i1 @llvm.vector.reduce.or.{mangle Me}({Me} {me})")]
routine Vector<T, LANES>.is_any_true(me: Me) -> Bool
require T: typename, LANES: USize, MaskLane<T>

/// Whether no lane is true.
/// :returns: `true` when every lane of the mask is false.
routine Vector<T, LANES>.is_none_true(me: Me) -> Bool
require T: typename, LANES: USize, MaskLane<T>
    block entry()
        some : Bool = me.is_any_true()
        return(some.bitnot())

/// How many lanes are true.
/// :returns: The count of true lanes, from 0 to `LANES`.
#[external("llvm"),
    template("{t0} = bitcast {Me} {me} to i{LANES}\n{t1} = call i{LANES} @llvm.ctpop.i{LANES}(i{LANES} {t0})\n{result} = zext i{LANES} {t1} to {USize}")]
routine Vector<T, LANES>.count_true(me: Me) -> USize
require T: typename, LANES: USize, MaskLane<T>

/// Lane i of `if_true` where this mask's lane i is true, else lane i of `if_false`.
/// :typeparam TValue: The lane type of the vectors to choose from.
/// :param if_true: The lanes taken where the mask is true.
/// :param if_false: The lanes taken where the mask is false.
/// :returns: The lanes chosen by the mask.
#[external("llvm"),
    template("{result} = select {Me} {me}, <{LANES} x {TValue}> {if_true}, <{LANES} x {TValue}> {if_false}")]
routine Vector<T, LANES>.select<TValue>(me: Me, if_true: Vector<TValue, LANES>,
    if_false: Vector<TValue, LANES>) -> Vector<TValue, LANES>
require T: typename, LANES: USize, MaskLane<T>, TValue: typename

// -- reductions ------------------------------------------------------------------------

/// Adds two scalar lanes with no overflow check, for {Vector.sum}.
/// :param a: The accumulated value.
/// :param b: The lane to add.
/// :returns: The sum, wrapping for integers.
#[external("llvm"), template("{result} = {by T|fadd|add|add} {T} {a}, {b}")]
private routine Vector<T, LANES>.lane_add(a: T, b: T) -> T
require T: typename, LANES: USize, NumberLane<T>

/// Whether adding two scalar lanes overflows. Always false for floats.
/// :param a: The accumulated value.
/// :param b: The lane to add.
/// :returns: `true` when the integer sum overflows.
#[external("llvm"),
    template("{by T|{result} = or i1 false, false|{t0} = call {{ {T}, i1 }} @llvm.sadd.with.overflow.{mangle T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1|{t0} = call {{ {T}, i1 }} @llvm.uadd.with.overflow.{mangle T}({T} {a}, {T} {b})\n{result} = extractvalue {{ {T}, i1 }} {t0}, 1}")]
private routine Vector<T, LANES>.lane_add_overflows(a: T, b: T) -> Bool
require T: typename, LANES: USize, NumberLane<T>

/// The smaller of two scalar lanes for {Vector.reduce_min}. A NaN operand yields the other.
/// :param a: The accumulated value.
/// :param b: The lane to compare.
/// :returns: The smaller value.
#[external("llvm"),
    template("{by T|{t0} = fcmp uno {T} {a}, {a}\n{t1} = fcmp uno {T} {b}, {b}\n{t2} = fcmp ole {T} {a}, {b}\n{t3} = select i1 {t2}, {T} {a}, {T} {b}\n{t4} = select i1 {t0}, {T} {b}, {T} {t3}\n{result} = select i1 {t1}, {T} {a}, {T} {t4}|{result} = call {T} @llvm.smin.{mangle T}({T} {a}, {T} {b})|{result} = call {T} @llvm.umin.{mangle T}({T} {a}, {T} {b})}")]
private routine Vector<T, LANES>.lane_min(a: T, b: T) -> T
require T: typename, LANES: USize, NumberLane<T>

/// The larger of two scalar lanes for {Vector.reduce_max}. A NaN operand yields the other.
/// :param a: The accumulated value.
/// :param b: The lane to compare.
/// :returns: The larger value.
#[external("llvm"),
    template("{by T|{t0} = fcmp uno {T} {a}, {a}\n{t1} = fcmp uno {T} {b}, {b}\n{t2} = fcmp oge {T} {a}, {b}\n{t3} = select i1 {t2}, {T} {a}, {T} {b}\n{t4} = select i1 {t0}, {T} {b}, {T} {t3}\n{result} = select i1 {t1}, {T} {a}, {T} {t4}|{result} = call {T} @llvm.smax.{mangle T}({T} {a}, {T} {b})|{result} = call {T} @llvm.umax.{mangle T}({T} {a}, {T} {b})}")]
private routine Vector<T, LANES>.lane_max(a: T, b: T) -> T
require T: typename, LANES: USize, NumberLane<T>

/// The lanes added in order, lane 0 first. For integers, crashes on overflow. In order, so a float sum is the same
/// on every target, though a tree of adds would be faster.
/// :returns: The sum of the lanes.
/// :throws: Crashes with `IntegerOverflowError` when an integer running sum overflows.
#track_caller
routine Vector<T, LANES>.sum(me: Me) -> T
require T: typename, LANES: USize, NumberLane<T>
    block entry()
        first : T = me.getitem(0)
        jump step(1, first)

    block step(i: USize, acc: T)
        more : Bool = i.lt(LANES)
        branch more
            ? add(i, acc)
            : return(acc)

    block add(i: USize, acc: T)
        lane     : T    = me.getitem(i)
        overflow : Bool = Me.lane_add_overflows(acc, lane)
        branch overflow
            ? crash_overflow()
            : continue
        next : T = Me.lane_add(acc, lane)
        jump step(i.add(1), next)

/// The smallest lane. A NaN lane counts only if every lane is NaN.
/// :returns: The smallest lane value.
routine Vector<T, LANES>.reduce_min(me: Me) -> T
require T: typename, LANES: USize, NumberLane<T>
    shared acc : @T <- uninit

    block entry()
        first : T = me.getitem(0)
        first.store_into(acc)
        jump step(1)

    block step(i: USize)
        more : Bool = i.lt(LANES)
        branch more
            ? take(i)
            : return(acc.load())

    block take(i: USize)
        lane : T = me.getitem(i)
        next : T = Me.lane_min(acc.load(), lane)
        next.store_into(acc)
        jump step(i.add(1))

/// The largest lane. A NaN lane counts only if every lane is NaN.
/// :returns: The largest lane value.
routine Vector<T, LANES>.reduce_max(me: Me) -> T
require T: typename, LANES: USize, NumberLane<T>
    shared acc : @T <- uninit

    block entry()
        first : T = me.getitem(0)
        first.store_into(acc)
        jump step(1)

    block step(i: USize)
        more : Bool = i.lt(LANES)
        branch more
            ? take(i)
            : return(acc.load())

    block take(i: USize)
        lane : T = me.getitem(i)
        next : T = Me.lane_max(acc.load(), lane)
        next.store_into(acc)
        jump step(i.add(1))
