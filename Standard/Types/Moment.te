# Tessera stdlib: Moment, a point in time
#
# A Moment is whole seconds since 1970-01-01 00:00:00 UTC in an S64 and the nanoseconds past them in a U32 (0 up to
# 999999999), the same as a Duration. `Clock.now()` reads one. A Moment plus a Duration is a Moment, and one Moment
# minus another is the Duration between them. Dates use the Gregorian calendar, extended to before it began.

module Standard/Core

### A point in time: whole seconds since 1970-01-01 00:00:00 UTC and the nanoseconds past them. `Clock.now()` reads
### the current one. It shows as `2026-10-19 08:30:00` (UTC).
record Moment
obeys Equatable[Moment], Comparable[Moment], Hashable[Moment]
    ### The whole seconds since 1970-01-01 00:00:00 UTC, rounded down, negative before then.
    secret secs: S64
    ### The nanoseconds past `secs`, 0 up to 999999999.
    secret nanos: U32

### Makes a `Moment` from its fields.
### :param secs: Its `secs`.
### :param nanos: Its `nanos`.
### :returns: The new value.
routine Moment.construct(secs: S64, nanos: U32) -> Me
    return Me(secs, nanos)

### Releases nothing: a `Moment` holds no memory of its own.
routine Moment.destruct(me: @Me) -> None
    return

# -- making one ----------------------------------------------------------------

### 1970-01-01 00:00:00 UTC.
### :returns: The moment.
routine Moment.epoch() -> Me
    return Me(secs: 0, nanos: 0)

### The moment `seconds` whole seconds after 1970-01-01 00:00:00 UTC (before it when negative).
### :param seconds: The seconds since 1970.
### :returns: The moment.
routine Moment.from_timestamp(seconds: S64) -> Me
    return Me(secs: seconds, nanos: 0)

### The moment `since` after 1970-01-01 00:00:00 UTC (before it when negative).
### :param since: The time since 1970.
### :returns: The moment.
routine Moment.from_epoch(since: Duration) -> Me
    return Me(secs: since.seconds(), nanos: since.subsecond_nanoseconds())

### The time since 1970-01-01 00:00:00 UTC, negative before then.
### :returns: The time since 1970.
routine Moment.since_epoch(me: Me) -> Duration
    return Duration(secs: me.secs, nanos: me.nanos)

### The whole seconds since 1970-01-01 00:00:00 UTC, rounded down.
### :returns: The seconds.
routine Moment.timestamp(me: Me) -> S64
    return me.secs

### The nanoseconds past the whole second, 0 up to 999999999.
### :returns: The nanoseconds.
routine Moment.subsecond_nanoseconds(me: Me) -> U32
    return me.nanos

# -- the date and time of day (UTC) --------------------------------------------

### The year, month and day (UTC) of a day counted from 1970-01-01, by the Gregorian calendar extended to before it
### began.
### :param days: The days since 1970-01-01, negative before.
### :returns: The year, the month (1 up to 12) and the day of the month (1 up to 31).
secret routine civil_from_days(days: S64) -> (S64, S64, S64)
    # Counted from 0000-03-01, so February, with its leap day, ends each year. An era is 400 years, 146097 days.
    from_march: S64 = days + 719468
    era: S64 = from_march // 146097
    day_of_era: S64 = from_march - era * 146097
    year_of_era: S64 = (day_of_era - day_of_era // 1460 + day_of_era // 36524 - day_of_era // 146096) // 365
    day_of_year: S64 = day_of_era - (365 * year_of_era + year_of_era // 4 - year_of_era // 100)
    month_from_march: S64 = (5 * day_of_year + 2) // 153
    day: S64 = day_of_year - (153 * month_from_march + 2) // 5 + 1
    month: S64 = (month_from_march + 2) % 12 + 1
    year: S64 = year_of_era + era * 400 + month_from_march // 10
    return (year, month, day)

### The year (UTC).
### :returns: The year, 0 for 1 BC and negative before it.
routine Moment.year(me: Me) -> S64
    return civil_from_days(me.secs // 86400).item0

### The month (UTC).
### :returns: The month, 1 up to 12.
routine Moment.month(me: Me) -> S64
    return civil_from_days(me.secs // 86400).item1

### The day of the month (UTC).
### :returns: The day, 1 up to 31.
routine Moment.day(me: Me) -> S64
    return civil_from_days(me.secs // 86400).item2

### The day of the week (UTC).
### :returns: 0 for Monday up to 6 for Sunday.
routine Moment.day_of_week(me: Me) -> S64
    # 1970-01-01 was a Thursday.
    return (me.secs // 86400 + 3) % 7

### The hour (UTC).
### :returns: The hour, 0 up to 23.
routine Moment.hour(me: Me) -> S64
    return me.secs % 86400 // 3600

### The minute.
### :returns: The minute, 0 up to 59.
routine Moment.minute(me: Me) -> S64
    return me.secs % 3600 // 60

### The second.
### :returns: The second, 0 up to 59.
routine Moment.second(me: Me) -> S64
    return me.secs % 60

# -- arithmetic ----------------------------------------------------------------

### The moment `d` later (earlier when `d` is negative): `me + d`.
### :param d: How much later.
### :returns: The moment.
### :throws: Crashes with `IntegerOverflowError` when it is beyond the range of a Moment.
@track_caller
routine Moment.add(me: Me, d: Duration) -> Me
    return Me.from_epoch(me.since_epoch() + d)

### The moment `d` later, stopping at the ends of the range: `me +^ d`.
### :param d: How much later.
### :returns: The moment, or the end it went past.
routine Moment.add_clamp(me: Me, d: Duration) -> Me
    return Me.from_epoch(me.since_epoch() +^ d)

### The moment `d` earlier (later when `d` is negative): `me - d`.
### :param d: How much earlier.
### :returns: The moment.
### :throws: Crashes with `IntegerOverflowError` when it is beyond the range of a Moment.
@track_caller
routine Moment.sub(me: Me, d: Duration) -> Me
    return Me.from_epoch(me.since_epoch() - d)

### The time from `earlier` to `me`: `me - earlier`. It is negative when `earlier` is later.
### :param earlier: The moment to measure from.
### :returns: The time between them.
### :throws: Crashes with `IntegerOverflowError` when it is beyond the range of a Duration.
@track_caller
routine Moment.sub(me: Me, earlier: Me) -> Duration
    return me.since_epoch() - earlier.since_epoch()

# -- comparison and hashing ----------------------------------------------------

### Whether the two moments are the same.
### :param other: The moment to compare with.
### :returns: True when they are the same.
routine Moment.eq(me: Me, other: Me) -> Bool
    return me.secs == other.secs and me.nanos == other.nanos

### Whether the two moments differ.
### :param other: The moment to compare with.
### :returns: True when they differ.
routine Moment.ne(me: Me, other: Me) -> Bool
    return not me.eq(other)

### Whether `me` comes before `other`.
### :param other: The moment to compare with.
### :returns: `me < other`.
routine Moment.lt(me: Me, other: Me) -> Bool
    if me.secs == other.secs
        return me.nanos < other.nanos
    return me.secs < other.secs

### Whether `me` comes before `other` or is the same.
### :param other: The moment to compare with.
### :returns: `me <= other`.
routine Moment.le(me: Me, other: Me) -> Bool
    return not other.lt(me)

### Whether `me` comes after `other`.
### :param other: The moment to compare with.
### :returns: `me > other`.
routine Moment.gt(me: Me, other: Me) -> Bool
    return other.lt(me)

### Whether `me` comes after `other` or is the same.
### :param other: The moment to compare with.
### :returns: `me >= other`.
routine Moment.ge(me: Me, other: Me) -> Bool
    return not me.lt(other)

### Three-way comparison of `me` and `other`.
### :param other: The moment to compare with.
### :returns: -1, 0, or 1 as `me` comes before, is the same, or comes after.
routine Moment.compare(me: Me, other: Me) -> S32
    if me.lt(other)
        return -1
    if other.lt(me)
        return 1
    return 0

### The keyed hash of the seconds and the nanoseconds.
### :returns: The hash.
routine Moment.hash(me: Me) -> U64
    return me.since_epoch().hash()
