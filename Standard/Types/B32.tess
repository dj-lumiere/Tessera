/// :see: {B32.to[S64]} to crash instead, {B32.to_clamp[S64]} to saturate.
routine B32.to_checked[S64](me: Me) -> Maybe[S64]
    fits: Bool = me.is_trunc_in_range(lo: -9223372036854775808.0, hi: 9223372036854775808.0)
