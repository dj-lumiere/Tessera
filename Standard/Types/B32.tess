/// Converts to S128, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1]. The crash reports the caller's location.
/// :see: {B32.to_checked[S128]} to get an absent value instead, {B32.to_clamp[S128]} to saturate.
#track_caller
routine B32.to[S128](me: Me) -> S128
    fits: Bool = me.is_trunc_in_range(lo: -170141183460469231731687303715884105728.0,
        hi: 170141183460469231731687303715884105728.0)
    branch fits
        ? continue
