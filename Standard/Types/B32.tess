/// Converts to U32, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^32 - 1]. The crash reports the caller's location.
/// :see: {B32.to_checked[U32]} to get an absent value instead, {B32.to_clamp[U32]} to saturate.
#track_caller
routine B32.to[U32](me: Me) -> U32
    fits: Bool = me.is_trunc_in_range(lo: 0.0, hi: 4294967296.0)
    branch fits
        ? continue
        : crash_overflow()
    r: U32 = fptoui_sat[Me, U32](me)
    return(r)

/// Converts to U32, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 2^32 - 1].
/// :see: {B32.to[U32]} to crash instead, {B32.to_clamp[U32]} to saturate.
routine B32.to_checked[U32](me: Me) -> Maybe[U32]
    fits: Bool = me.is_trunc_in_range(lo: 0.0, hi: 4294967296.0)
    value: U32 = fptoui_sat[Me, U32](me)
    r: Maybe[U32] = fits.then_present(value)
    return(r)

/// Converts to U32, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 2^32 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {B32.to_checked[U32]} to detect values that do not fit.
routine B32.to_clamp[U32](me: Me) -> U32
    r: U32 = fptoui_sat[Me, U32](me)
    return(r)

/// Converts to U64, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^64 - 1]. The crash reports the caller's location.
/// :see: {B32.to_checked[U64]} to get an absent value instead, {B32.to_clamp[U64]} to saturate.
#track_caller
routine B32.to[U64](me: Me) -> U64
    fits: Bool = me.is_trunc_in_range(lo: 0.0, hi: 18446744073709551616.0)
    branch fits
        ? continue
        : crash_overflow()
    r: U64 = fptoui_sat[Me, U64](me)
    return(r)

/// Converts to U64, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 2^64 - 1].
/// :see: {B32.to[U64]} to crash instead, {B32.to_clamp[U64]} to saturate.
routine B32.to_checked[U64](me: Me) -> Maybe[U64]
    fits: Bool = me.is_trunc_in_range(lo: 0.0, hi: 18446744073709551616.0)
    value: U64 = fptoui_sat[Me, U64](me)
    r: Maybe[U64] = fits.then_present(value)
    return(r)

/// Converts to U64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 2^64 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {B32.to_checked[U64]} to detect values that do not fit.
routine B32.to_clamp[U64](me: Me) -> U64
    r: U64 = fptoui_sat[Me, U64](me)
    return(r)

/// Converts to U128, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 2^128 - 1]. The crash reports the caller's location.
/// :see: {B32.to_checked[U128]} to get an absent value instead, {B32.to_clamp[U128]} to saturate.
#track_caller
routine B32.to[U128](me: Me) -> U128
    fits: Bool = me.is_trunc_in_range(lo: 0.0, hi: 340282366920938463463374607431768211456.0)
    branch fits
        ? continue
        : crash_overflow()
    r: U128 = fptoui_sat[Me, U128](me)
    return(r)

/// Converts to U128, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 2^128 - 1].
/// :see: {B32.to[U128]} to crash instead, {B32.to_clamp[U128]} to saturate.
routine B32.to_checked[U128](me: Me) -> Maybe[U128]
    fits: Bool = me.is_trunc_in_range(lo: 0.0, hi: 340282366920938463463374607431768211456.0)
    value: U128 = fptoui_sat[Me, U128](me)
    r: Maybe[U128] = fits.then_present(value)
    return(r)

/// Converts to U128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 2^128 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {B32.to_checked[U128]} to detect values that do not fit.
routine B32.to_clamp[U128](me: Me) -> U128
    r: U128 = fptoui_sat[Me, U128](me)
    return(r)

/// Whether `me`, rounded toward zero, lies in `[lo, hi)`. False for NaN.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, excluded.
/// :returns: True when `lo <= trunc(me) < hi`.
routine B32.is_trunc_in_range(me: Me, lo: Me, hi: Me) -> Bool
    whole: Me = me.trunc()
    r: Bool = whole.in_range(lo, end: hi)
    return(r)
