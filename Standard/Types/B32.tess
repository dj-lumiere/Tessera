// Tessera stdlib: B32 — 32-bit IEEE 754 floating-point
//
// Maps to LLVM IR float.

module Standard/Core

/// A 32-bit IEEE 754 binary32 floating-point number (single precision), mapped to LLVM `float`.
/// It has a 24-bit significand (about 6 to 9 significant decimal digits) and finite magnitudes up to about 3.4e38.
/// :note: Arithmetic rounds to nearest, ties to even. `eq` is IEEE equality, so NaN is unequal to itself and -0.0 equals +0.0.
/// :see: {B64} for more precision and range.
@llvm("float")
record B32
obeys Equatable[B32], Comparable[B32], Hashable[B32]

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7F800000`): the result of overflow and of dividing a positive value by +0.0.
preset B32.INFINITY:     B32 = B32.from_bits(0x7F800000)  // +inf bits
/// Negative infinity (bits `0xFF800000`).
preset B32.NEG_INFINITY: B32 = B32.from_bits(0xFF800000)  // -inf bits
/// The canonical quiet NaN (bits `0x7FC00000`).
/// :note: NaN is unequal to everything, itself included, so test for it with {B32.is_nan}, not `eq`.
preset B32.NAN:          B32 = B32.from_bits(0x7FC00000)  // canonical quiet NaN bits

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
/// :returns: `me` with the sign bit cleared.
routine B32.abs(me: Me) -> Me
    r: Me = fabs[Me](me)
    return r

/// The smaller value. If one operand is NaN, the other one.
/// :param other: The value to compare with.
/// :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine B32.min(me: Me, other: Me) -> Me
    self_nan: Bool = me.is_nan()
    other_nan: Bool = other.is_nan()
    when
        self_nan and other_nan => return me + other
        self_nan => return other
        other_nan => return me
        else =>
            // no minnum intrinsic: on 32-bit ARM it becomes a libm call
            pick: Bool = me <= other
            r: Me = when
                pick => me
                else => other
            return r

/// The larger value. If one operand is NaN, the other one.
/// :param other: The value to compare with.
/// :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine B32.max(me: Me, other: Me) -> Me
    self_nan: Bool = me.is_nan()
    other_nan: Bool = other.is_nan()
    when
        self_nan and other_nan => return me + other
        self_nan => return other
        other_nan => return me
        else =>
            // no maxnum intrinsic: on 32-bit ARM it becomes a libm call
            pick: Bool = me >= other
            r: Me = when
                pick => me
                else => other
            return r

/// Adds `other` to `me`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine B32.add(me: Me, other: Me) -> Me
    r: Me = fadd[Me](me, other)
    return r

/// Subtracts `other` from `me`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine B32.sub(me: Me, other: Me) -> Me
    r: Me = fsub[Me](me, other)
    return r

/// Multiplies `me` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine B32.mul(me: Me, other: Me) -> Me
    r: Me = fmul[Me](me, other)
    return r

// -- comparisons ---------------------------------------------------------------

/// Whether `me` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me < other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B32.lt(me: Me, other: Me) -> Bool
    return flt[Me](me, other)

/// Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me <= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B32.le(me: Me, other: Me) -> Bool
    return fle[Me](me, other)

/// Whether `me` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me > other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B32.gt(me: Me, other: Me) -> Bool
    return fgt[Me](me, other)

/// Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me >= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B32.ge(me: Me, other: Me) -> Bool
    return fge[Me](me, other)

// -- division ------------------------------------------------------------------

/// Divides `me` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine B32.div(me: Me, other: Me) -> Me
    r: Me = fdiv[Me](me, other)
    return r

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine B32.eq(me: Me, other: Me) -> Bool
    return feq[Me](me, other)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ. False for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {B32.eq}.
routine B32.ne(me: Me, other: Me) -> Bool
    return fne[Me](me, other)

/// Three-way comparison for the `Comparable` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {B32.total_compare} for a total order that ranks NaN and the signed zeros.
routine B32.compare(me: Me, other: Me) -> S32
    if me < other
        return -1
    if me > other
        return 1
    else
        return 0

/// Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine B32.hash(me: Me) -> U64
    h: U64 = siphash24(value: me.bits().to[U64](), key: hash_key())
    return h

// -- named widening conversion -------------------------------------------------

/// Widens to B64, exactly.
/// :returns: The same value as a B64. Every B32 is representable.
routine B32.to[B64](me: Me) -> B64
    result: B64 = fpext[Me, B64](me)
    return result

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite B32, about 3.4028235e38 (bits `0x7F7FFFFF`).
preset B32.MAX:          B32 = B32.from_bits(0x7F7FFFFF)  // largest finite value
/// The most negative finite B32, the negation of `B32.MAX` (bits `0xFF7FFFFF`).
preset B32.MIN:          B32 = B32.from_bits(0xFF7FFFFF)  // most negative finite value
/// The smallest positive normal B32, 2^-126, about 1.1754944e-38 (bits `0x00800000`). Subnormal values go below it.
preset B32.MIN_POSITIVE: B32 = B32.from_bits(0x00800000)  // smallest positive normal value
/// The gap between 1.0 and the next larger B32, 2^-23, about 1.1920929e-7 (bits `0x34000000`).
preset B32.EPSILON:      B32 = B32.from_bits(0x34000000)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest B32.
preset B32.PI: B32 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest B32.
preset B32.TAU: B32 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest B32.
preset B32.E: B32 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest B32.
preset B32.FRAC_PI_2: B32 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest B32.
preset B32.FRAC_PI_4: B32 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest B32.
preset B32.FRAC_1_PI: B32 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest B32.
preset B32.SQRT_2: B32 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest B32.
preset B32.FRAC_1_SQRT_2: B32 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest B32.
preset B32.LN_2: B32 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest B32.
preset B32.LN_10: B32 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest B32.
preset B32.LOG2_E: B32 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest B32.
preset B32.LOG10_E: B32 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine B32.neg(me: Me) -> Me
    r: Me = fneg[Me](me)
    return r

/// The magnitude of `me` with the sign of `sign`.
/// :param sign: The value whose sign bit is used.
/// :returns: `me` with its sign bit replaced by the sign bit of `sign`.
routine B32.copysign(me: Me, sign: Me) -> Me
    r: Me = copysign[Me](mag: me, sign)
    return r

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
/// :returns: 1.0, -1.0, or NaN, by the sign of `me`.
routine B32.signum(me: Me) -> Me
    nan: Bool = me.is_nan()
    unit: Me = copysign[Me](mag: 1.0, sign: me)
    r: Me = when
        nan => me
        else => unit
    return r

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
/// :returns: Whether the sign bit is clear.
routine B32.is_sign_positive(me: Me) -> Bool
    bits: S32 = me.bits().to_wrap[S32]()
    return bits >= 0

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine B32.is_sign_negative(me: Me) -> Bool
    bits: S32 = me.bits().to_wrap[S32]()
    return bits < 0

// -- arithmetic ----------------------------------------------------------------

/// The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact: B64's remainder of the
/// same values is a B32.
/// :param other: The divisor.
/// :returns: The remainder. NaN when either operand is NaN, `me` is infinite, or `other` is 0. Otherwise `me`
///     itself when `other` is infinite or `me` is a zero.
routine B32.mod(me: Me, other: Me) -> Me
    remainder: B64 = me.to[B64]() % other.to[B64]()
    r: Me = remainder.to[Me]()
    return r

/// The reciprocal `1 / me`, rounded once.
/// :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine B32.recip(me: Me) -> Me
    r: Me = fdiv[Me](1.0, me)
    return r

/// Fused multiply-add: `me * a + b` with a single rounding, computed with the AArch64 FMA instruction.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: "aarch64")
routine B32.mul_add(me: Me, a: Me, b: Me) -> Me
    r: Me = fma[Me](a: me, b: a, c: b)
    return r

/// Fused multiply-add: `me * a + b` with a single rounding, computed with the x86 FMA instruction (targets with the `fma` feature, as with `--cpu x86-64-v3`).
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: "x86_64")
@feature("fma")
routine B32.mul_add(me: Me, a: Me, b: Me) -> Me
    r: Me = fma[Me](a: me, b: a, c: b)
    return r

/// Fused multiply-add: `me * a + b` with a single rounding, computed in software ({B32.mul_add_soft}) on x86 without the `fma` feature.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: "x86_64")
@feature(not "fma")
routine B32.mul_add(me: Me, a: Me, b: Me) -> Me
    r: Me = me.mul_add_soft(a, b)
    return r

/// Fused multiply-add: `me * a + b` with a single rounding, computed in software ({B32.mul_add_soft}) on targets other than AArch64 and x86_64.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: not ("aarch64", "x86_64"))
routine B32.mul_add(me: Me, a: Me, b: Me) -> Me
    r: Me = me.mul_add_soft(a, b)
    return r

/// me * a + b with a single rounding, without an FMA instruction.
///
/// Without one LLVM calls libm's fmaf, so this adds the exact B64 product with round-to-odd
/// (b64_add_round_to_odd) and narrows once, as B16's mul_add does.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
private routine B32.mul_add_soft(me: Me, a: Me, b: Me) -> Me
    product: B64 = me.to[B64]() * a.to[B64]()
    sum: B64 = b64_add_round_to_odd(a: product, b: b.to[B64]())
    r: Me = sum.to[B32]()
    return r

/// The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
/// :param other: The divisor.
/// :returns: The quotient `q`. NaN when either operand is NaN.
routine B32.div_euclid(me: Me, other: Me) -> Me
    q: Me = (me / other).trunc()
    rem: Me = me % other
    if not (rem < 0.0)
        return q
    positive_divisor: Bool = other > 0.0
    down: Me = q - 1.0
    up: Me = q + 1.0
    r: Me = when
        positive_divisor => down
        else => up
    return r

/// The least non-negative remainder of `me / other`.
/// :param other: The divisor.
/// :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
///     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine B32.mod_euclid(me: Me, other: Me) -> Me
    rem: Me = me % other
    if not (rem < 0.0)
        return rem
    magnitude: Me = other.abs()
    r: Me = rem + magnitude
    // a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
    // one in range
    if r == magnitude and magnitude.is_finite()
        return Me.from_bits(magnitude.bits() - 1)
    else
        return r

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
/// :param other: The value to compare with.
/// :returns: The smaller value, or NaN when either operand is NaN.
routine B32.minimum(me: Me, other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me + other
    // equal values have equal bits except ±0, where bitor picks the negative one
    if me == other
        return Me.from_bits(me.bits() | other.bits())
    pick: Bool = me < other
    r: Me = when
        pick => me
        else => other
    return r

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
/// :param other: The value to compare with.
/// :returns: The larger value, or NaN when either operand is NaN.
routine B32.maximum(me: Me, other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me + other
    // equal values have equal bits except ±0, where bitand picks the positive one
    if me == other
        return Me.from_bits(me.bits() & other.bits())
    pick: Bool = me > other
    r: Me = when
        pick => me
        else => other
    return r

/// Restricts `me` to `lo ..= hi`. NaN stays NaN.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` unless `lo <= hi`, so also when either bound is NaN.
@track_caller
routine B32.clamp(me: Me, lo: Me, hi: Me) -> Me
    if lo <= hi
        below: Bool = me < lo
        above: Bool = me > hi
        upper: Me = when
            above => hi
            else => me
        r: Me = when
            below => lo
            else => upper
        return r
    else
        crash_invalid_value()

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`. False when any operand is NaN.
routine B32.between(me: Me, lo: Me, hi: Me) -> Bool
    return me >= lo and me <= hi

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`. False when any operand is NaN.
routine B32.in_range(me: Me, lo: Me, end: Me) -> Bool
    return me >= lo and me < end

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as `me` comes before, at the same place as, or after `other` in that order.
routine B32.total_compare(me: Me, other: Me) -> S32
    a: S32 = me.bits().to_wrap[S32]()
    b: S32 = other.bits().to_wrap[S32]()
    // Flipping every bit but the sign of negative values makes the bits order like signed integers.
    a_key: S32 = a ^ ((a >> 31) & S32.MAX)
    b_key: S32 = b ^ ((b >> 31) & S32.MAX)
    r: S32 = a_key.compare(b_key)
    return r

// -- rounding ------------------------------------------------------------------

// AArch64 has an instruction for each. Elsewhere LLVM calls libm (x86 before SSE4.1 has none), so the other
// targets work on the bits: trunc clears the fraction bits, and the rest adjust its result, all exactly.

/// Rounds toward negative infinity with the AArch64 rounding instruction.
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B32.floor(me: Me) -> Me
    r: Me = floor[Me](me)
    return r

/// Rounds toward negative infinity from {B32.trunc}, stepping one down when truncation moved the value up (exact).
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B32.floor(me: Me) -> Me
    t: Me = me.trunc()
    down: Bool = t > me
    r: Me = when
        down => t - 1.0
        else => t
    return r

/// Rounds toward positive infinity with the AArch64 rounding instruction.
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B32.ceil(me: Me) -> Me
    r: Me = ceil[Me](me)
    return r

/// Rounds toward positive infinity from {B32.trunc}, stepping one up when truncation moved the value down (exact).
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B32.ceil(me: Me) -> Me
    t: Me = me.trunc()
    up: Bool = t < me
    r: Me = when
        up => t + 1.0
        else => t
    return r

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B32.round(me: Me) -> Me
    r: Me = round[Me](me)
    return r

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B32.round(me: Me) -> Me
    t: Me = me.trunc()
    fraction: Me = me - t
    half: Bool = fraction.abs() >= 0.5
    away: Me = t + Me.copysign(1.0, me)
    r: Me = when
        half => away
        else => t
    return r

/// Rounds half-way cases to the even neighbor.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B32.round_ties_even(me: Me) -> Me
    r: Me = rint[Me](me)
    return r

/// Rounds half-way cases to the even neighbor.
///
/// Below 2^23, adding and subtracting 2^23 leaves the magnitude rounded to an integer by the addition.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B32.round_ties_even(me: Me) -> Me
    magnitude: Me = me.abs()
    if magnitude >= 8388608.0
        return me
    rounded: Me = magnitude + 8388608.0 - 8388608.0
    r: Me = rounded.copysign(me)
    return r

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B32.trunc(me: Me) -> Me
    r: Me = ftrunc[Me](me)
    return r

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B32.trunc(me: Me) -> Me
    local bits: U32 = me.bits()
    local field: U32 = (bits >> 23) & 0xFF

    special: Bool = field == 0xFF
    integral: Bool = field >= 150
    when
        special => return me + me
        integral => return me
        field < 127 => return Me.from_bits(bits & 0x80000000)
        else =>
            // 1 <= |me| < 2^23: the lowest 150 - field bits are the fraction
            mask: U32 = (1 << U32.sub(150, field)) - 1
            r: Me = Me.from_bits(bits & ~mask)
            return r

/// `me` minus its integer part, with the sign of `me`.
/// :returns: The fractional part. NaN for an infinity or NaN.
routine B32.fract(me: Me) -> Me
    whole: Me = me.trunc()
    r: Me = me - whole
    return r

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in Standard/B32Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// The square root of `me`.
/// :returns: The square root: NaN for negative values other than -0.0, which gives -0.0.
routine B32.sqrt(me: Me) -> Me
    r: Me = sqrt[Me](me)
    return r

/// me raised to an integer power, correctly rounded. An n of at most 2^24 in magnitude converts to B32
/// exactly and goes to powf. A larger one goes through the B64 power, whose rounding to B32 is correct unless it
/// lands exactly on a B32 midpoint. There the B128 power decides (checked for every x and n that reach it).
/// :param n: The integer exponent.
/// :returns: `me` to the power `n`, rounded once.
routine B32.powi(me: Me, n: S32) -> Me
    if not (n.abs_diff(0) <= 0x1000000)
        r: B64 = me.to[B64]().powf(n.to[B64]())
        if b32_is_on_midpoint_b64(r)
            r2: B128 = me.to[B128]().powf(n.to[B128]())
            return r2.to[Me]()
        else
            return r.to[Me]()
    r: Me = me.powf(n.to[Me]())
    return r

/// Whether r lies exactly between two B32 values.
/// :param r: The B64 value to test.
/// :returns: True when `r` is finite and lies exactly halfway between two adjacent B32 values.
private routine b32_is_on_midpoint_b64(r: B64) -> Bool
    local a: B64 = r.abs()

    if a < 1.1754943508222875e-38
        // B32 keeps 23 fraction bits: a midpoint has bit 28 set and nothing below it.
        // Below 2^-126 B32's quantum is 2^-149: a midpoint is an odd multiple of 2^-150.
        t: B64 = a * 1.42724769270596e45
        whole: Bool = t.trunc() == t
        odd: Bool = t % 2.0 == 1.0
        return whole and odd
    else
        low: U64 = a.bits() & 0x1FFFFFFF
        return a.is_finite() and low == 0x10000000

/// The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even). Three
/// tiers, each kept only when an error band around its quotient rounds to one B32 (Ziv's test): the correctly rounded
/// B64 logarithms divided in B64 (within 3 × 2^-53 relative, band 2^-50), then the correctly rounded B128 logarithms
/// divided in B128 (band 2^-109), then both logarithms in B128Big ({big_log_ratio}). Exact results come out exact:
/// log(8, 2) = 3, log(1000, 10) = 3, log(x, x) = 1.
/// :param base: The base of the logarithm.
/// :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the B32 quotient
///     ln(`me`) / ln(`base`): NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for
///     `me` 1 or base 0 or +inf, NaN when both logarithms are zero or both infinite.
/// :note: Every positive finite `me` with base 2 and base 10 gives the correctly rounded log2 and log10.
routine B32.log(me: Me, base: Me) -> Me
    x_ok: Bool = me > 0.0 and me.is_finite()
    base_ok: Bool = base > 0.0 and base.is_finite()
    one: Bool = me == 1.0 or base == 1.0
    if x_ok and base_ok and not one
        q: B64 = me.to[B64]().ln() / base.to[B64]().ln()
        width: B64 = q.abs() * 8.881784197001252e-16
        left: Me = (q - width).to[Me]()
        right: Me = (q + width).to[Me]()
        if left == right
            return left
        else
            q2: B128 = me.to[B128]().ln() / base.to[B128]().ln()
            width2: B128 = q2.abs().scalbn(-109)
            left2: Me = (q2 - width2).to[Me]()
            right2: Me = (q2 + width2).to[Me]()
            if left2 == right2
                return left2
            else
                r: B128 = big_log_ratio(x: me.to[B128](), base: base.to[B128](), fraction_bits: 23)
                return r.to[Me]()
    else
        return me.ln() / base.ln()

// -- special functions ---------------------------------------------------------

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to B32).
/// :returns: `me` in degrees, rounded once.
routine B32.to_degrees(me: Me) -> Me
    r: Me = me * 57.29577951308232
    return r

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to B32).
/// :returns: `me` in radians, rounded once.
routine B32.to_radians(me: Me) -> Me
    r: Me = me * 0.017453292519943295
    return r

// -- classification ------------------------------------------------------------

/// Whether `me` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine B32.is_nan(me: Me) -> Bool
    return funo[Me](me, me)

/// Whether `me` is +inf or -inf.
/// :returns: True for either infinity. False for NaN and finite values.
routine B32.is_infinite(me: Me) -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude == Me.INFINITY

/// Neither infinite nor NaN.
/// :returns: True for zeros, subnormals and normal values. False for infinities and NaN.
routine B32.is_finite(me: Me) -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude < Me.INFINITY

/// Not zero, subnormal, infinite, or NaN.
/// :returns: True when the exponent field is neither all zeros nor all ones.
routine B32.is_normal(me: Me) -> Bool
    exponent: U32 = me.bits() & 0x7F800000
    return exponent != 0 and exponent != 0x7F800000

/// Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `B32.MIN_POSITIVE`.
/// :returns: True for subnormals. False for zero, normal values, infinities and NaN.
routine B32.is_subnormal(me: Me) -> Bool
    bits: U32 = me.bits()
    exponent: U32 = bits & 0x7F800000
    mantissa: U32 = bits & 0x007FFFFF
    return exponent == 0 and mantissa != 0

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
/// :returns: The encoding as a U32: sign bit at the top, then the exponent field, then the fraction.
routine B32.bits(me: Me) -> U32
    r: U32 = bitcast[Me, U32](me)
    return r

/// Reinterprets raw IEEE 754 binary32 bits as a B32, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {B32.bits} for the inverse.
routine B32.from_bits(bits: U32) -> Me
    r: Me = bitcast[U32, Me](bits)
    return r

// -- float conversions -----------------------------------------------------------

/// Rounds to nearest, ties to even. Written with integer operations instead of
/// fptrunc, which would call compiler-rt's `__truncsfhf2`.
/// :returns: The nearest B16. Values past the B16 range give a signed infinity, and NaN stays NaN (made quiet).
routine B32.to[B16](me: Me) -> B16
    local bits: U32 = me.bits()
    local high_half: U16 = (bits >> 16).to[U16]()
    local sign: U16 = high_half & 0x8000
    local magnitude: U32 = bits & 0x7FFFFFFF

    when
        magnitude >= 0x7F800000 =>
            // Infinity stays infinity. NaN keeps its top payload bits and is made quiet.
            payload_bits: U32 = (magnitude & 0x7FFFFF) >> 13
            payload: U16 = payload_bits.to[U16]()
            is_nan: Bool = magnitude > 0x7F800000
            nan_bits: U16 = payload | 0x7E00
            body: U16 = when
                is_nan => nan_bits
                else => 0x7C00
            r: B16 = .from_bits(sign | body)
            return r
        magnitude >= 0x477FF000 =>
            r: B16 = .from_bits(sign | 0x7C00)
            return r
        magnitude < 0x38800000 =>
            // Below B16's smallest normal: scale so one B16 subnormal step is 1.0, and
            // round to an integer (exact in B32, ties to even). 0x400 carries into the
            // smallest normal, which is the right encoding.
            scaled: Me = Me.from_bits(magnitude) * 16777216.0
            steps: U16 = scaled.round_ties_even().to[U16]()
            r: B16 = .from_bits(sign | steps)
            return r
        else =>
            // Round the 13 dropped mantissa bits to even, then rebias the exponent from
            // 127 to 15. A carry out of the mantissa bumps the exponent, as it should.
            lowest_kept: U32 = (magnitude >> 13) & 1
            rounded: U32 = magnitude + 0xFFF + lowest_kept
            rebiased: U32 = (rounded >> 13) - 0x1C000
            r: B16 = .from_bits(sign | rebiased.to[U16]())
            return r

/// Rounds to nearest, ties to even, by adding a bias below the kept 16 bits.
/// Written out because the Windows compiler-rt has no __truncsfbf2.
/// :returns: The nearest BF16. NaN stays NaN (made quiet).
routine B32.to[BF16](me: Me) -> BF16
    local bits: U32 = me.bits()

    if me.is_nan()
        // Keep the sign and top payload bits, and force the quiet bit.
        high_half: U16 = (bits >> 16).to[U16]()
        top: U16 = high_half | 0x0040
        r: BF16 = .from_bits(top)
        return r
    else
        lowest_kept: U32 = (bits >> 16) & 1
        bias: U32 = lowest_kept + 0x7FFF
        rounded_bits: U32 = bits + bias >> 16
        top: U16 = rounded_bits.to[U16]()
        r: BF16 = .from_bits(top)
        return r

/// The identity conversion, so generic code can call `to[T]()` when `T` is B32.
/// :returns: `me` unchanged.
routine B32.to[Me](me: Me) -> Me
    return me

// -- integer conversions ---------------------------------------------------------
//
// to_[int] rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_[int]_checked returns None instead and to_[int]_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {B32.to_checked[S8]} to get an absent value instead, {B32.to_clamp[S8]} to saturate.
@track_caller
routine B32.to[S8](me: Me) -> S8
    if not me.is_trunc_in_range(lo: -128.0, hi: 128.0)
        crash_overflow()
    r: S8 = fptosi_sat[Me, S8](me)
    return r

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-128, 127].
/// :see: {B32.to[S8]} to crash instead, {B32.to_clamp[S8]} to saturate.
routine B32.to_checked[S8](me: Me) -> Maybe[S8]
    fits: Bool = me.is_trunc_in_range(lo: -128.0, hi: 128.0)
    value: S8 = fptosi_sat[Me, S8](me)
    r: Maybe[S8] = fits.then_present(value)
    return r

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {B32.to_checked[S8]} to detect values that do not fit.
routine B32.to_clamp[S8](me: Me) -> S8
    r: S8 = fptosi_sat[Me, S8](me)
    return r

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {B32.to_checked[S16]} to get an absent value instead, {B32.to_clamp[S16]} to saturate.
@track_caller
routine B32.to[S16](me: Me) -> S16
    if not me.is_trunc_in_range(lo: -32768.0, hi: 32768.0)
        crash_overflow()
    r: S16 = fptosi_sat[Me, S16](me)
    return r

/// Converts to S16, rounding toward zero, without crashing.
