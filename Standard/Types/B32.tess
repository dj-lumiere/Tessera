/// Converts to S128, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
/// :see: {B32.to[S128]} to crash instead, {B32.to_clamp[S128]} to saturate.
routine B32.to_checked[S128](me: Me) -> Maybe[S128]
    fits: Bool = me.is_trunc_in_range(lo: -170141183460469231731687303715884105728.0,
        hi: 170141183460469231731687303715884105728.0)
    value: S128 = fptosi_sat[Me, S128](me)
