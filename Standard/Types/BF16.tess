routine BF16.to<U8>(self: Self) -> U8
    block entry()
        fits : Bool = self.fits_int(0.0, 256.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U8 = fptoui_sat<Self, U8>(self)
        return(r)

/// Converts to U8, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [0, 255].
/// :see: {BF16.to<U8>} to crash instead, {BF16.to_clamp<U8>} to saturate.
