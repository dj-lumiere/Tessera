// Tessera stdlib: BF16 — 16-bit bfloat16 (F32's exponent, 7-bit mantissa)
//
// Maps to LLVM IR bfloat. x86 has no BF16 arithmetic, so LLVM computes in F32
// and rounds. The conversions call compiler-rt, which the builder links.

module Standard::Core

/// A 16-bit bfloat16 floating-point number, mapped to LLVM `bfloat`: F32's 8-bit exponent with a 7-bit stored mantissa.
/// It keeps F32's range (finite magnitudes up to about 3.4e38) with an 8-bit significand (2 to 3 significant decimal digits).
/// :note: Targets without BF16 arithmetic (x86) compute in F32 and round back. The math functions compute in F32 and round once to BF16.
/// :see: {F16} for more precision in a smaller range.
#llvm("bfloat")
record BF16
conform Equal<BF16>, Compare<BF16>, Hash<BF16>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7F80`): the result of overflow and of dividing a positive value by +0.0.
preset BF16.INFINITY:     BF16 = BF16.from_bits(0x7F80)  // +inf bits
/// Negative infinity (bits `0xFF80`).
preset BF16.NEG_INFINITY: BF16 = BF16.from_bits(0xFF80)  // -inf bits
/// The canonical quiet NaN (bits `0x7FC0`).
/// :note: NaN is unequal to everything, itself included, so test for it with {BF16.is_nan}, not `eq`.
preset BF16.NAN:          BF16 = BF16.from_bits(0x7FC0)  // canonical quiet NaN bits

// -- runtime support ---------------------------------------------------------

// x86 has no BF16 arithmetic, so LLVM computes in F32 and narrows the result by
// calling these compiler-rt routines. The Windows builds of compiler-rt lack
// them, so the stdlib provides them under their C names.

/// Windows-only replacement for compiler-rt's `__truncsfbf2`, exported under that name: narrows F32 to BF16, rounding to nearest (ties to even).
/// :param x: The F32 to narrow.
/// :returns: The nearest BF16.
/// :note: LLVM calls it on x86 to round BF16 arithmetic computed in F32. The Windows compiler-rt lacks it.
#[export("__truncsfbf2"), target(os: "windows")]
private routine export_truncsfbf2(x: F32) -> BF16
    block entry()
        r : BF16 = x.to<BF16>()
        return(r)

/// Windows-only replacement for compiler-rt's `__truncdfbf2`, exported under that name: narrows F64 to BF16, rounding once to nearest (ties to even).
/// :param x: The F64 to narrow.
/// :returns: The nearest BF16.
#[export("__truncdfbf2"), target(os: "windows")]
private routine export_truncdfbf2(x: F64) -> BF16
    block entry()
        r : BF16 = x.to<BF16>()
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine BF16.abs(self: Self) -> Self
    block entry()
        r : Self = fabs<Self>(self)
        return(r)

/// The smaller value, or the other one if one operand is NaN.
routine BF16.min(self: Self, other: Self) -> Self
    block entry()
        smaller : F32  = self.to<F32>().min(other.to<F32>())
        r       : Self = smaller.to<Self>()  // via F32 (exact)
        return(r)

/// The larger value, or the other one if one operand is NaN.
routine BF16.max(self: Self, other: Self) -> Self
    block entry()
        larger : F32  = self.to<F32>().max(other.to<F32>())
        r      : Self = larger.to<Self>()  // via F32 (exact)
        return(r)

/// Adds `other` to `self`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `self + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine BF16.add(self: Self, other: Self) -> Self
    block entry()
        r : Self = fadd<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `self - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine BF16.sub(self: Self, other: Self) -> Self
    block entry()
        r : Self = fsub<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `self * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine BF16.mul(self: Self, other: Self) -> Self
    block entry()
        r : Self = fmul<Self>(self, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `self` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.lt(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = flt<Self>(self, other)
        return(r)

/// Whether `self` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.le(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fle<Self>(self, other)
        return(r)

/// Whether `self` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.gt(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fgt<Self>(self, other)
        return(r)

/// Whether `self` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.ge(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fge<Self>(self, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `self` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `self / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine BF16.div(self: Self, other: Self) -> Self
    block entry()
        r : Self = fdiv<Self>(self, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine BF16.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = feq<Self>(self, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ, false for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {BF16.eq}.
routine BF16.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fne<Self>(self, other)
        return(r)

/// Three-way comparison for the `Compare` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `self < other`, 1 when `self > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {BF16.total_compare} for a total order that ranks NaN and the signed zeros.
routine BF16.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with `xxh64` (seed 0), for the `Hash` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine BF16.hash(self: Self) -> U64
    block entry()
        h : U64 = xxh64(self.bits().to<U64>(), 0)
        return(h)

// -- named widening conversion -------------------------------------------------

/// Widens to F64, exactly.
/// :returns: The same value as an F64. Every BF16 is representable.
routine BF16.to<F64>(self: Self) -> F64
    block entry()
        result : F64 = fpext<Self, F64>(self)
        return(result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite BF16, about 3.3895314e38 (bits `0x7F7F`).
preset BF16.MAX:          BF16 = BF16.from_bits(0x7F7F)  // largest finite value
/// The most negative finite BF16, the negation of `BF16.MAX` (bits `0xFF7F`).
preset BF16.MIN:          BF16 = BF16.from_bits(0xFF7F)  // most negative finite value
/// The smallest positive normal BF16, 2^-126, about 1.1754944e-38 (bits `0x0080`). Subnormal values go below it.
preset BF16.MIN_POSITIVE: BF16 = BF16.from_bits(0x0080)  // smallest positive normal value
/// The gap between 1.0 and the next larger BF16, 2^-7, 0.0078125 (bits `0x3C00`).
preset BF16.EPSILON:      BF16 = BF16.from_bits(0x3C00)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest BF16.
preset BF16.PI: BF16 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest BF16.
preset BF16.TAU: BF16 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest BF16.
preset BF16.E: BF16 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest BF16.
preset BF16.FRAC_PI_2: BF16 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest BF16.
preset BF16.FRAC_PI_4: BF16 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest BF16.
preset BF16.FRAC_1_PI: BF16 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest BF16.
preset BF16.SQRT_2: BF16 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest BF16.
preset BF16.FRAC_1_SQRT_2: BF16 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest BF16.
preset BF16.LN_2: BF16 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest BF16.
preset BF16.LN_10: BF16 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest BF16.
preset BF16.LOG2_E: BF16 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest BF16.
preset BF16.LOG10_E: BF16 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-self`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine BF16.neg(self: Self) -> Self
    block entry()
        r : Self = fneg<Self>(self)
        return(r)

/// The magnitude of self with the sign of sign.
routine BF16.copysign(self: Self, sign: Self) -> Self
    block entry()
        r : Self = copysign<Self>(self, sign)
        return(r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine BF16.signum(self: Self) -> Self
    block entry()
        nan  : Bool = self.is_nan()
        unit : Self = copysign<Self>(1.0, self)
        r    : Self = nan
            ? self
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine BF16.is_sign_positive(self: Self) -> Bool
    block entry()
        bits : S16  = self.bits().to_wrap<S16>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine BF16.is_sign_negative(self: Self) -> Bool
    block entry()
        bits : S16  = self.bits().to_wrap<S16>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of self / other, with the sign of self (C fmod, Rust's %). Exact: F32's remainder of the
/// same values is an BF16.
routine BF16.mod(self: Self, other: Self) -> Self
    block entry()
        remainder : F32  = self.to<F32>().mod(other.to<F32>())
        r         : Self = remainder.to<Self>()
        return(r)

/// The reciprocal `1 / self`, rounded once.
/// :returns: `1 / self`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine BF16.recip(self: Self) -> Self
    block entry()
        r : Self = fdiv<Self>(1.0, self)
        return(r)

/// self * a + b, rounded once. The product of two 8-bit significands is exact in F64. The sum is added
/// with round-to-odd (f64_add_round_to_odd), which the narrowing then rounds as it would the exact result.
routine BF16.mul_add(self: Self, a: Self, b: Self) -> Self
    block entry()
        product : F64  = self.to<F64>().mul(a.to<F64>())
        sum     : F64  = f64_add_round_to_odd(product, b.to<F64>())
        r       : Self = sum.to<Self>()
        return(r)

/// The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine BF16.div_euclid(self: Self, other: Self) -> Self
    block entry()
        q            : Self = self.div(other).trunc()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Self = q.sub(1.0)
        up               : Self = q.add(1.0)
        r                : Self = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of self / other.
routine BF16.mod_euclid(self: Self, other: Self) -> Self
    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Self = other.abs()
        r         : Self = rem.add(magnitude)
        return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine BF16.minimum(self: Self, other: Self) -> Self
    block entry()
        nan : Bool = self.is_nan().bitor(other.is_nan())
        branch nan
            ? return(self.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = self.eq(other)
        branch equal
            ? return(Self.from_bits(self.bits().bitor(other.bits())))
            : continue
        pick : Bool = self.lt(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine BF16.maximum(self: Self, other: Self) -> Self
    block entry()
        nan : Bool = self.is_nan().bitor(other.is_nan())
        branch nan
            ? return(self.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = self.eq(other)
        branch equal
            ? return(Self.from_bits(self.bits().bitand(other.bits())))
            : continue
        pick : Bool = self.gt(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// Restricts self to lo ..= hi. NaN stays NaN. Crashes unless lo <= hi.
#track_caller
routine BF16.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        below : Bool = self.lt(lo)
        above : Bool = self.gt(hi)
        upper : Self = above
            ? hi
            : self
        r : Self = below
            ? lo
            : upper
        return(r)

/// self in [lo, hi], both ends included. False when lo > hi.
routine BF16.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine BF16.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine BF16.total_compare(self: Self, other: Self) -> S32
    block entry()
        a : S16 = self.bits().to_wrap<S16>()
        b : S16 = other.bits().to_wrap<S16>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S16 = a.bitxor(a.shr(15).bitand(S16.MAX))
        b_key : S16 = b.bitxor(b.shr(15).bitand(S16.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

/// Rounds toward negative infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The largest integer value not above `self`. Zeros, infinities and NaN come back unchanged.
routine BF16.floor(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.floor().to<Self>()
        return(r)

/// Rounds toward positive infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The smallest integer value not below `self` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine BF16.ceil(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.ceil().to<Self>()
        return(r)

/// Rounds half-way cases away from zero.
routine BF16.round(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.round().to<Self>()
        return(r)

/// Rounds half-way cases to the even neighbor.
routine BF16.round_ties_even(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.round_ties_even().to<Self>()
        return(r)

/// Rounds toward zero.
routine BF16.trunc(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.trunc().to<Self>()
        return(r)

/// self minus its integer part, with the sign of self.
routine BF16.fract(self: Self) -> Self
    block entry()
        whole : Self = self.trunc()
        r     : Self = self.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------

/// NaN for negative values (other than -0.0).
routine BF16.sqrt(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.sqrt().to<Self>()
        return(r)

/// The cube root, defined for every input: negative values give negative roots. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.cbrt(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.cbrt().to<Self>()
        return(r)

/// self raised to an integer power, correctly rounded. The F64 power (n converts exactly) rounds correctly to
/// BF16 unless it lands exactly on a BF16 midpoint. There the F128 power decides (checked for every x and n
/// that reach it).
routine BF16.powi(self: Self, n: S32) -> Self
    block entry()
        r   : F64  = self.to<F64>().powf(n.to<F64>())
        tie : Bool = bf16_on_midpoint(r)
        branch tie
            ? exact()
            : return(r.to<Self>())

    block exact()
        r : F128 = self.to<F128>().powf(n.to<F128>())
        return(r.to<Self>())

/// `self` raised to the power `exponent`, correctly rounded.
/// Computed in F32 and rounded to BF16. When the F32 result lands exactly on a BF16 midpoint, the F64 power decides the rounding instead.
/// :param exponent: The power to raise `self` to.
/// :returns: The correctly rounded BF16 result, following C `pow` for the special cases (NaN for a negative base with a non-integer exponent).
routine BF16.powf(self: Self, exponent: Self) -> Self
    block entry()
        narrow : F32  = self.to<F32>().powf(exponent.to<F32>())
        tie    : Bool = bf16_on_midpoint(narrow)
        branch tie
            ? wide()
            : return(narrow.to<Self>())

    // On a BF16 midpoint the F32 result can't tell which way to round. The F64 one can (checked on all pairs:
    // where it too is a midpoint, the result is exact and ties to even).
    block wide()
        r : F64 = self.to<F64>().powf(exponent.to<F64>())
        return(r.to<Self>())

/// e^self
routine BF16.exp(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.exp().to<Self>()
        return(r)

/// 2^self
routine BF16.exp2(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.exp2().to<Self>()
        return(r)

/// e^self - 1, accurate near 0.
routine BF16.exp_m1(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.exp_m1().to<Self>()
        return(r)

/// The natural logarithm.
routine BF16.ln(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.ln().to<Self>()
        return(r)

/// The base-2 logarithm. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, -inf at +-0.0 and NaN below 0.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.log2(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.log2().to<Self>()
        return(r)

/// The base-10 logarithm. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, -inf at +-0.0 and NaN below 0.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.log10(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.log10().to<Self>()
        return(r)

/// ln(1 + self), accurate near 0.
routine BF16.ln_1p(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.ln_1p().to<Self>()
        return(r)

/// The logarithm with an arbitrary base.
routine BF16.log(self: Self, base: Self) -> Self
    block entry()
        num : Self = self.ln()
        den : Self = base.ln()
        r   : Self = num.div(den)
        return(r)

/// sqrt(self^2 + other^2). Squares of 16-bit floats cannot overflow F32.
routine BF16.hypot(self: Self, other: Self) -> Self
    block entry()
        narrow : F32  = self.to<F32>().hypot(other.to<F32>())
        tie    : Bool = bf16_on_midpoint(narrow)
        branch tie
            ? wide()
            : return(narrow.to<Self>())

    // As in powf: the F64 result decides, and where it too is a midpoint the result is exact.
    block wide()
        r : F64 = self.to<F64>().hypot(other.to<F64>())
        return(r.to<Self>())

// -- trigonometry --------------------------------------------------------------

/// In radians.
routine BF16.sin(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.sin().to<Self>()
        return(r)

/// In radians.
routine BF16.cos(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.cos().to<Self>()
        return(r)

/// In radians.
routine BF16.tan(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.tan().to<Self>()
        return(r)

/// The arcsine, in radians in [-pi/2, pi/2]. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, NaN outside [-1, 1].
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.asin(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.asin().to<Self>()
        return(r)

/// The arccosine, in radians in [0, pi]. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, NaN outside [-1, 1].
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.acos(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.acos().to<Self>()
        return(r)

/// The arctangent, in radians in (-pi/2, pi/2). Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.atan(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.atan().to<Self>()
        return(r)

/// The hyperbolic sine. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, infinity on overflow.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.sinh(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.sinh().to<Self>()
        return(r)

/// The hyperbolic cosine, at least 1. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, infinity on overflow.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.cosh(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.cosh().to<Self>()
        return(r)

/// The hyperbolic tangent, in [-1, 1]. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.tanh(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.tanh().to<Self>()
        return(r)

/// The inverse hyperbolic sine. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.asinh(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.asinh().to<Self>()
        return(r)

/// The inverse hyperbolic cosine. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, NaN below 1.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.acosh(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.acosh().to<Self>()
        return(r)

/// The inverse hyperbolic tangent. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, +-inf at +-1 and NaN outside [-1, 1].
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.atanh(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.atanh().to<Self>()
        return(r)

/// The angle of the point (other, self): self is y and other is x.
routine BF16.atan2(self: Self, other: Self) -> Self
    block entry()
        narrow : F32  = self.to<F32>().atan2(other.to<F32>())
        tie    : Bool = bf16_on_midpoint(narrow)
        branch tie
            ? wide()
            : return(narrow.to<Self>())

    block wide()
        r     : F64  = self.to<F64>().atan2(other.to<F64>())
        still : Bool = bf16_on_midpoint(r)
        branch still
            ? tiny(r)
            : return(r.to<Self>())

    // Still a midpoint in F64: x > 0 and |y / x| tiny (checked on all pairs), where atan2 = atan(y / x) lies
    // just inside y / x. One F64 ulp toward zero puts it on the right side.
    block tiny(r: F64)
        inside : F64 = F64.from_bits(r.bits().sub(1))
        return(inside.to<Self>())

// -- special functions ---------------------------------------------------------

/// The error function.
routine BF16.erf(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.erf().to<Self>()
        return(r)

/// 1 - erf(self), accurate where erf is near 1.
routine BF16.erfc(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.erfc().to<Self>()
        return(r)

/// Γ(self): ±inf at ±0, NaN at the negative integers and -inf.
routine BF16.gamma(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.gamma().to<Self>()
        return(r)

/// ln |Γ(self)|: +inf at 0 and the negative integers.
routine BF16.ln_gamma(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.ln_gamma().to<Self>()
        return(r)

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to BF16).
/// :returns: `self` in degrees, rounded once.
routine BF16.to_degrees(self: Self) -> Self
    block entry()
        r : Self = self.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to BF16).
/// :returns: `self` in radians, rounded once.
routine BF16.to_radians(self: Self) -> Self
    block entry()
        r : Self = self.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- rounding from wider results -------------------------------------------------
//
// The math functions compute in F32 with its correctly rounded CORE-MATH ports and round to BF16. That
// rounding is itself correct unless the F32 result lands exactly on a BF16 midpoint: F32 rounding keeps order
// and every BF16 midpoint is an F32 value. For the one-argument functions no input rounds wrongly (every BF16
// input checked with mpmath). The two-argument ones (powf, hypot, atan2) go through F64 at a midpoint.

/// Whether r lies exactly between two BF16 values: its low 16 bits are 0x8000.
private routine bf16_on_midpoint(r: F32) -> Bool
    block entry()
        low : U32  = r.bits().bitand(0xFFFF)
        mid : Bool = r.is_finite().bitand(low.eq(0x8000))
        return(mid)

/// Whether r lies exactly between two BF16 values.
private routine bf16_on_midpoint(r: F64) -> Bool
    block entry()
        a   : F64  = r.abs()
        sub : Bool = a.lt(0x1p-126)
        branch sub
            ? subnormal(a)
            : normal(a)

    // BF16 keeps 7 fraction bits: a midpoint has bit 44 set and nothing below it.
    block normal(a: F64)
        low : U64  = a.bits().bitand(0x1FFFFFFFFFFF)
        mid : Bool = a.is_finite().bitand(low.eq(0x100000000000))
        return(mid)

    // Below 2^-126 BF16's quantum is 2^-133: a midpoint is an odd multiple of 2^-134.
    block subnormal(a: F64)
        t     : F64  = a.mul(0x1p134)
        whole : Bool = t.trunc().eq(t)
        odd   : Bool = t.mod(2.0).eq(1.0)
        return(whole.bitand(odd))

// -- classification ------------------------------------------------------------

/// Whether `self` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine BF16.is_nan(self: Self) -> Bool
    block entry()
        r : Bool = funo<Self>(self, self)
        return(r)

/// Whether `self` is +inf or -inf.
/// :returns: True for either infinity, false for NaN and finite values.
routine BF16.is_infinite(self: Self) -> Bool
    block entry()
        magnitude : Self = fabs<Self>(self)
        r         : Bool = magnitude.eq(Self.INFINITY)
        return(r)

/// Neither infinite nor NaN.
routine BF16.is_finite(self: Self) -> Bool
    block entry()
        magnitude : Self = fabs<Self>(self)
        r         : Bool = magnitude.lt(Self.INFINITY)
        return(r)

/// Not zero, subnormal, infinite, or NaN.
routine BF16.is_normal(self: Self) -> Bool
    block entry()
        exponent : U16  = self.bits().bitand(0x7F80)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7F80))
        return(r)

/// Whether `self` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `BF16.MIN_POSITIVE`.
/// :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine BF16.is_subnormal(self: Self) -> Bool
    block entry()
        bits     : U16  = self.bits()
        exponent : U16  = bits.bitand(0x7F80)
        mantissa : U16  = bits.bitand(0x007F)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
routine BF16.bits(self: Self) -> U16
    block entry()
        r : U16 = bitcast<Self, U16>(self)
        return(r)

/// Reinterprets raw IEEE 754 bfloat16 bits as a BF16, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {BF16.bits} for the inverse.
routine BF16.from_bits(bits: U16) -> Self
    block entry()
        r : Self = bitcast<U16, Self>(bits)
        return(r)

// -- float conversions -----------------------------------------------------------

/// Converts to F16 by widening to F32 exactly and rounding once to nearest (ties to even).
/// :returns: The nearest F16: infinity above F16's range (65504), a subnormal or zero for tiny values, NaN for NaN.
routine BF16.to<F16>(self: Self) -> F16
    block entry()
        wide : F32 = self.to<F32>()
        r    : F16 = wide.to<F16>()
        return(r)

/// The identity conversion, so generic code can call `to<T>()` when `T` is BF16.
/// :returns: `self` unchanged.
routine BF16.to<Self>(self: Self) -> Self
    block entry()
        return(self)

/// Widens to F32, exactly: BF16 is the upper half of an F32 encoding.
/// :returns: The same value as an F32.
routine BF16.to<F32>(self: Self) -> F32
    block entry()
        r : F32 = fpext<Self, F32>(self)
        return(r)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_<int>_checked returns None instead and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S8>} to get an absent value instead, {BF16.to_clamp<S8>} to saturate.
#track_caller
routine BF16.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.fits_int(-128.0, 128.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = fptosi_sat<Self, S8>(self)
        return(r)

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-128, 127].
/// :see: {BF16.to<S8>} to crash instead, {BF16.to_clamp<S8>} to saturate.
routine BF16.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.fits_int(-128.0, 128.0)
        value : S8         = fptosi_sat<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S8>} to detect values that do not fit.
routine BF16.to_clamp<S8>(self: Self) -> S8
    block entry()
        r : S8 = fptosi_sat<Self, S8>(self)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S16>} to get an absent value instead, {BF16.to_clamp<S16>} to saturate.
#track_caller
routine BF16.to<S16>(self: Self) -> S16
    block entry()
        fits : Bool = self.fits_int(-32768.0, 32768.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = fptosi_sat<Self, S16>(self)
        return(r)

/// Converts to S16, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-32768, 32767].
/// :see: {BF16.to<S16>} to crash instead, {BF16.to_clamp<S16>} to saturate.
routine BF16.to_checked<S16>(self: Self) -> Option<S16>
    block entry()
        fits  : Bool        = self.fits_int(-32768.0, 32768.0)
        value : S16         = fptosi_sat<Self, S16>(self)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts to S16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S16>} to detect values that do not fit.
routine BF16.to_clamp<S16>(self: Self) -> S16
    block entry()
        r : S16 = fptosi_sat<Self, S16>(self)
        return(r)

/// Converts to S32, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [-2^31, 2^31 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S32>} to get an absent value instead, {BF16.to_clamp<S32>} to saturate.
#track_caller
routine BF16.to<S32>(self: Self) -> S32
    block entry()
        fits : Bool = self.fits_int(-2147483648.0, 2147483648.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = fptosi_sat<Self, S32>(self)
        return(r)

/// Converts to S32, rounding toward zero, without crashing.
