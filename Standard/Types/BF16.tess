// Tessera stdlib: BF16 — 16-bit bfloat16 (F32's exponent, 7-bit mantissa)
//
// Maps to LLVM IR bfloat. x86 has no BF16 arithmetic, so LLVM computes in F32
// and rounds. The conversions call compiler-rt, which the builder links.

module Standard::Core

/// A 16-bit bfloat16 floating-point number, mapped to LLVM `bfloat`: F32's 8-bit exponent with a 7-bit stored mantissa.
/// It keeps F32's range (finite magnitudes up to about 3.4e38) with an 8-bit significand (2 to 3 significant decimal digits).
/// :note: Targets without BF16 arithmetic (x86) compute in F32 and round back. The math functions compute in F32 and round once to BF16.
/// :see: {F16} for more precision in a smaller range.
#llvm("bfloat")
record BF16
conform Equatable<BF16>, Comparable<BF16>, Hashable<BF16>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7F80`): the result of overflow and of dividing a positive value by +0.0.
preset BF16.INFINITY:     BF16 = BF16.from_bits(0x7F80)  // +inf bits
/// Negative infinity (bits `0xFF80`).
preset BF16.NEG_INFINITY: BF16 = BF16.from_bits(0xFF80)  // -inf bits
/// The canonical quiet NaN (bits `0x7FC0`).
/// :note: NaN is unequal to everything, itself included, so test for it with {BF16.is_nan}, not `eq`.
preset BF16.NAN:          BF16 = BF16.from_bits(0x7FC0)  // canonical quiet NaN bits

// -- runtime support ---------------------------------------------------------

// x86 has no BF16 arithmetic, so LLVM computes in F32 and narrows the result by
// calling these compiler-rt routines. The Windows builds of compiler-rt lack
// them, so the stdlib provides them under their C names.

/// Windows-only replacement for compiler-rt's `__truncsfbf2`, exported under that name: narrows F32 to BF16, rounding to nearest (ties to even).
/// :param x: The F32 to narrow.
/// :returns: The nearest BF16.
/// :note: LLVM calls it on x86 to round BF16 arithmetic computed in F32. The Windows compiler-rt lacks it.
#[export("__truncsfbf2"), target(os: "windows")]
private routine export_truncsfbf2(x: F32) -> BF16
    block entry()
        r : BF16 = x.to<BF16>()
        return(r)

/// Windows-only replacement for compiler-rt's `__truncdfbf2`, exported under that name: narrows F64 to BF16, rounding once to nearest (ties to even).
/// :param x: The F64 to narrow.
/// :returns: The nearest BF16.
#[export("__truncdfbf2"), target(os: "windows")]
private routine export_truncdfbf2(x: F64) -> BF16
    block entry()
        r : BF16 = x.to<BF16>()
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
/// :returns: `|me|`.
routine BF16.abs(me: Me) -> Me
    block entry()
        r : Me = fabs<Me>(me)
        return(r)

/// The smaller value, or the other one if one operand is NaN. Computed in F32, which is exact.
/// :param other: The value to compare with.
/// :returns: The smaller of `me` and `other`, NaN only when both are NaN.
routine BF16.min(me: Me, other: Me) -> Me
    block entry()
        smaller : F32 = me.to<F32>().min(other.to<F32>())
        r       : Me  = smaller.to<Me>()  // via F32 (exact)
        return(r)

/// The larger value, or the other one if one operand is NaN. Computed in F32, which is exact.
/// :param other: The value to compare with.
/// :returns: The larger of `me` and `other`, NaN only when both are NaN.
routine BF16.max(me: Me, other: Me) -> Me
    block entry()
        larger : F32 = me.to<F32>().max(other.to<F32>())
        r      : Me  = larger.to<Me>()  // via F32 (exact)
        return(r)

/// Adds `other` to `me`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine BF16.add(me: Me, other: Me) -> Me
    block entry()
        r : Me = fadd<Me>(me, other)
        return(r)

/// Subtracts `other` from `me`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine BF16.sub(me: Me, other: Me) -> Me
    block entry()
        r : Me = fsub<Me>(me, other)
        return(r)

/// Multiplies `me` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine BF16.mul(me: Me, other: Me) -> Me
    block entry()
        r : Me = fmul<Me>(me, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `me` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.lt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = flt<Me>(me, other)
        return(r)

/// Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.le(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fle<Me>(me, other)
        return(r)

/// Whether `me` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.gt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fgt<Me>(me, other)
        return(r)

/// Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine BF16.ge(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fge<Me>(me, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `me` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine BF16.div(me: Me, other: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(me, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine BF16.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = feq<Me>(me, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ, false for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {BF16.eq}.
routine BF16.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fne<Me>(me, other)
        return(r)

/// Three-way comparison for the `Comparable` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {BF16.total_compare} for a total order that ranks NaN and the signed zeros.
routine BF16.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine BF16.hash(me: Me) -> U64
    block entry()
        h : U64 = siphash24(me.bits().to<U64>(), hash_key())
        return(h)

// -- named widening conversion -------------------------------------------------

/// Widens to F64, exactly.
/// :returns: The same value as an F64. Every BF16 is representable.
routine BF16.to<F64>(me: Me) -> F64
    block entry()
        result : F64 = fpext<Me, F64>(me)
        return(result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite BF16, about 3.3895314e38 (bits `0x7F7F`).
preset BF16.MAX:          BF16 = BF16.from_bits(0x7F7F)  // largest finite value
/// The most negative finite BF16, the negation of `BF16.MAX` (bits `0xFF7F`).
preset BF16.MIN:          BF16 = BF16.from_bits(0xFF7F)  // most negative finite value
/// The smallest positive normal BF16, 2^-126, about 1.1754944e-38 (bits `0x0080`). Subnormal values go below it.
preset BF16.MIN_POSITIVE: BF16 = BF16.from_bits(0x0080)  // smallest positive normal value
/// The gap between 1.0 and the next larger BF16, 2^-7, 0.0078125 (bits `0x3C00`).
preset BF16.EPSILON:      BF16 = BF16.from_bits(0x3C00)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest BF16.
preset BF16.PI: BF16 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest BF16.
preset BF16.TAU: BF16 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest BF16.
preset BF16.E: BF16 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest BF16.
preset BF16.FRAC_PI_2: BF16 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest BF16.
preset BF16.FRAC_PI_4: BF16 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest BF16.
preset BF16.FRAC_1_PI: BF16 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest BF16.
preset BF16.SQRT_2: BF16 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest BF16.
preset BF16.FRAC_1_SQRT_2: BF16 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest BF16.
preset BF16.LN_2: BF16 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest BF16.
preset BF16.LN_10: BF16 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest BF16.
preset BF16.LOG2_E: BF16 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest BF16.
preset BF16.LOG10_E: BF16 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine BF16.neg(me: Me) -> Me
    block entry()
        r : Me = fneg<Me>(me)
        return(r)

/// The magnitude of `me` with the sign of `sign`, exactly.
/// :param sign: The value whose sign bit is taken.
/// :returns: `|me|` with the sign bit of `sign`.
routine BF16.copysign(me: Me, sign: Me) -> Me
    block entry()
        r : Me = copysign<Me>(me, sign)
        return(r)

/// The sign of `me` as a number.
/// :returns: 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine BF16.signum(me: Me) -> Me
    block entry()
        nan  : Bool = me.is_nan()
        unit : Me   = copysign<Me>(1.0, me)
        r    : Me   = nan
            ? me
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
/// :returns: Whether the sign bit is clear.
routine BF16.is_sign_positive(me: Me) -> Bool
    block entry()
        bits : S16  = me.bits().to_wrap<S16>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine BF16.is_sign_negative(me: Me) -> Bool
    block entry()
        bits : S16  = me.bits().to_wrap<S16>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact: F32's remainder of the same
/// values is a BF16.
/// :param other: The divisor.
/// :returns: `me - q * other` for `q` the quotient rounded toward zero. NaN when `other` is 0 or `me` is infinite.
routine BF16.mod(me: Me, other: Me) -> Me
    block entry()
        remainder : F32 = me.to<F32>().mod(other.to<F32>())
        r         : Me  = remainder.to<Me>()
        return(r)

/// The reciprocal `1 / me`, rounded once.
/// :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine BF16.recip(me: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(1.0, me)
        return(r)

/// `me * a + b`, rounded once. The product of two 8-bit significands is exact in F64. The sum is added with
/// round-to-odd ({f64_add_round_to_odd}), which the narrowing then rounds as it would the exact result.
/// :param a: The factor to multiply `me` by.
/// :param b: The addend.
/// :returns: `me * a + b`, correctly rounded.
routine BF16.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        product : F64 = me.to<F64>().mul(a.to<F64>())
        sum     : F64 = f64_add_round_to_odd(product, b.to<F64>())
        r       : Me  = sum.to<Me>()
        return(r)

/// The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
/// :param other: The divisor.
/// :returns: The truncated quotient, moved one step down (for a positive `other`) or up when the remainder is negative.
routine BF16.div_euclid(me: Me, other: Me) -> Me
    block entry()
        q            : Me   = me.div(other).trunc()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Me   = q.sub(1.0)
        up               : Me   = q.add(1.0)
        r                : Me   = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of `me / other`.
/// :param other: The divisor.
/// :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
///     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine BF16.mod_euclid(me: Me, other: Me) -> Me
    block entry()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Me   = other.abs()
        r         : Me   = rem.add(magnitude)
        whole     : Bool = r.eq(magnitude).bitand(magnitude.is_finite())
        // a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
        // one in range
        branch whole
            ? return(Me.from_bits(magnitude.bits().sub(1)))
            : return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0 (IEEE 754 minimum).
/// :param other: The value to compare with.
/// :returns: The smaller of `me` and `other`.
routine BF16.minimum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitor(other.bits())))
            : continue
        pick : Bool = me.lt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0 (IEEE 754 maximum).
/// :param other: The value to compare with.
/// :returns: The larger of `me` and `other`.
routine BF16.maximum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitand(other.bits())))
            : continue
        pick : Bool = me.gt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// Restricts `me` to `lo ..= hi`. NaN stays NaN.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, else `me`.
/// :throws: Crashes with `InvalidValueError` unless `lo <= hi` (so also when either bound is NaN).
#track_caller
routine BF16.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        below : Bool = me.lt(lo)
        above : Bool = me.gt(hi)
        upper : Me   = above
            ? hi
            : me
        r : Me = below
            ? lo
            : upper
        return(r)

/// Whether `me` lies in [`lo`, `hi`], both ends included. False when `lo > hi` or any operand is NaN.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: `true` when `lo <= me <= hi`.
routine BF16.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Whether `me` lies in [`lo`, `end`): `lo` included, `end` not. False when `lo >= end` or any operand is NaN.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: `true` when `lo <= me < end`.
routine BF16.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

/// Orders by IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as `me` is below, equal to, or above `other` in that order.
routine BF16.total_compare(me: Me, other: Me) -> S32
    block entry()
        a : S16 = me.bits().to_wrap<S16>()
        b : S16 = other.bits().to_wrap<S16>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S16 = a.bitxor(a.shr(15).bitand(S16.MAX))
        b_key : S16 = b.bitxor(b.shr(15).bitand(S16.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

/// Rounds toward negative infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
routine BF16.floor(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.floor().to<Me>()
        return(r)

/// Rounds toward positive infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine BF16.ceil(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.ceil().to<Me>()
        return(r)

/// Rounds to the nearest integer, half-way cases away from zero, through F32 (exact).
/// :returns: The rounded value. Zeros, infinities and NaN come back unchanged.
routine BF16.round(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.round().to<Me>()
        return(r)

/// Rounds to the nearest integer, half-way cases to the even neighbor, through F32 (exact).
/// :returns: The rounded value. Zeros, infinities and NaN come back unchanged.
routine BF16.round_ties_even(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.round_ties_even().to<Me>()
        return(r)

/// Rounds toward zero, through F32 (exact).
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
routine BF16.trunc(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.trunc().to<Me>()
        return(r)

/// `me` minus its integer part, with the sign of `me`.
/// :returns: `me - me.trunc()`, NaN for an infinity or NaN.
routine BF16.fract(me: Me) -> Me
    block entry()
        whole : Me = me.trunc()
        r     : Me = me.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------

/// The square root, computed in F32 and rounded once to BF16.
/// :returns: The square root. NaN for negative values (other than -0.0).
routine BF16.sqrt(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.sqrt().to<Me>()
        return(r)

/// The cube root, defined for every input: negative values give negative roots. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.cbrt(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.cbrt().to<Me>()
        return(r)

/// `me` raised to an integer power, correctly rounded. The F64 power (`n` converts exactly) rounds correctly to
/// BF16 unless it lands exactly on a BF16 midpoint. There the F128 power decides (checked for every x and n that
/// reach it).
/// :param n: The exponent.
/// :returns: `me` to the power `n`.
routine BF16.powi(me: Me, n: S32) -> Me
    block entry()
        r   : F64  = me.to<F64>().powf(n.to<F64>())
        tie : Bool = bf16_is_on_midpoint(r)
        branch tie
            ? exact()
            : return(r.to<Me>())

    block exact()
        r : F128 = me.to<F128>().powf(n.to<F128>())
        return(r.to<Me>())

/// `me` raised to the power `exponent`, correctly rounded.
/// Computed in F32 and rounded to BF16. When the F32 result lands exactly on a BF16 midpoint, the F64 power decides the rounding instead.
/// :param exponent: The power to raise `me` to.
/// :returns: The correctly rounded BF16 result, following C `pow` for the special cases (NaN for a negative base with a non-integer exponent).
routine BF16.powf(me: Me, exponent: Me) -> Me
    block entry()
        narrow : F32  = me.to<F32>().powf(exponent.to<F32>())
        tie    : Bool = bf16_is_on_midpoint(narrow)
        branch tie
            ? wide()
            : return(narrow.to<Me>())

    // On a BF16 midpoint the F32 result can't tell which way to round. The F64 one can (checked on all pairs:
    // where it too is a midpoint, the result is exact and ties to even).
    block wide()
        r : F64 = me.to<F64>().powf(exponent.to<F64>())
        return(r.to<Me>())

/// e raised to `me`, computed in F32 and rounded once to BF16.
/// :returns: e^`me`.
routine BF16.exp(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.exp().to<Me>()
        return(r)

/// 2 raised to `me`, computed in F32 and rounded once to BF16.
/// :returns: 2^`me`.
routine BF16.exp2(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.exp2().to<Me>()
        return(r)

/// e^`me` - 1, accurate near 0. Computed in F32 and rounded once to BF16.
/// :returns: e^`me` - 1.
routine BF16.exp_m1(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.exp_m1().to<Me>()
        return(r)

/// The natural logarithm, computed in F32 and rounded once to BF16.
/// :returns: ln(`me`), -inf at +-0.0 and NaN below 0.
routine BF16.ln(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.ln().to<Me>()
        return(r)

/// The base-2 logarithm. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, -inf at +-0.0 and NaN below 0.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.log2(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.log2().to<Me>()
        return(r)

/// The base-10 logarithm. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, -inf at +-0.0 and NaN below 0.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.log10(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.log10().to<Me>()
        return(r)

/// ln(1 + `me`), accurate near 0. Computed in F32 and rounded once to BF16.
/// :returns: ln(1 + `me`).
routine BF16.ln_1p(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.ln_1p().to<Me>()
        return(r)

/// The logarithm with an arbitrary base, ln(`me`) / ln(`base`), correctly rounded to BF16. The quotient of the two
/// correctly rounded F64 logarithms is within about 2^-51 of the true value, so it rounds to BF16 correctly unless it
/// lies within 2^-36 of a BF16 midpoint. There both logarithms and the quotient are taken again in F128.
/// :param base: The base of the logarithm.
/// :returns: log base `base` of `me`, NaN for a negative `me` or `base` and for base 1, ±inf or ±0 where the
///     logarithms are infinite or zero.
/// :note: No result is exactly a BF16 midpoint: that would take x^(2^e) = base^m with an odd m of 9 bits, which
///     8-bit significands and exponents within ±133 rule out, so the F128 quotient decides every case it gets. A scan
///     of every pair of positive finite inputs found two quotients in the band, both rounded the same in F128.
routine BF16.log(me: Me, base: Me) -> Me
    block entry()
        num  : F64  = me.to<F64>().ln()
        den  : F64  = base.to<F64>().ln()
        wide : F64  = num.div(den)
        near : Bool = bf16_is_near_midpoint(wide)
        branch near
            ? precise()
            : return(wide.to<Me>())

    block precise()
        num : F128 = me.to<F128>().ln()
        den : F128 = base.to<F128>().ln()
        return(num.div(den).to<Me>())

/// sqrt(`me`^2 + `other`^2), correctly rounded. Squares of 16-bit floats cannot overflow F32. Computed in F32, and
/// in F64 when the F32 result lands on a BF16 midpoint.
/// :param other: The other side.
/// :returns: The length of the hypotenuse.
routine BF16.hypot(me: Me, other: Me) -> Me
    block entry()
        narrow : F32  = me.to<F32>().hypot(other.to<F32>())
        tie    : Bool = bf16_is_on_midpoint(narrow)
        branch tie
            ? wide()
            : return(narrow.to<Me>())

    // As in powf: the F64 result decides, and where it too is a midpoint the result is exact.
    block wide()
        r : F64 = me.to<F64>().hypot(other.to<F64>())
        return(r.to<Me>())

// -- trigonometry --------------------------------------------------------------

/// The sine of `me` in radians, computed in F32 and rounded once to BF16.
/// :returns: sin(`me`), NaN for an infinity or NaN.
routine BF16.sin(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.sin().to<Me>()
        return(r)

/// The cosine of `me` in radians, computed in F32 and rounded once to BF16.
/// :returns: cos(`me`), NaN for an infinity or NaN.
routine BF16.cos(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.cos().to<Me>()
        return(r)

/// The tangent of `me` in radians, computed in F32 and rounded once to BF16.
/// :returns: tan(`me`), NaN for an infinity or NaN.
routine BF16.tan(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.tan().to<Me>()
        return(r)

/// The arcsine, in radians in [-pi/2, pi/2]. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, NaN outside [-1, 1].
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.asin(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.asin().to<Me>()
        return(r)

/// The arccosine, in radians in [0, pi]. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, NaN outside [-1, 1].
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.acos(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.acos().to<Me>()
        return(r)

/// The arctangent, in radians in (-pi/2, pi/2). Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.atan(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.atan().to<Me>()
        return(r)

/// The hyperbolic sine. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, infinity on overflow.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.sinh(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.sinh().to<Me>()
        return(r)

/// The hyperbolic cosine, at least 1. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, infinity on overflow.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.cosh(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.cosh().to<Me>()
        return(r)

/// The hyperbolic tangent, in [-1, 1]. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.tanh(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.tanh().to<Me>()
        return(r)

/// The inverse hyperbolic sine. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.asinh(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.asinh().to<Me>()
        return(r)

/// The inverse hyperbolic cosine. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, NaN below 1.
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.acosh(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.acosh().to<Me>()
        return(r)

/// The inverse hyperbolic tangent. Computed with F32's correctly rounded CORE-MATH port and rounded once to BF16.
/// :returns: The correctly rounded BF16 result, +-inf at +-1 and NaN outside [-1, 1].
/// :note: No BF16 input rounds wrongly through F32: every one was checked against mpmath.
routine BF16.atanh(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.atanh().to<Me>()
        return(r)

/// The angle of the point (`other`, `me`): `me` is y and `other` is x. Computed in F32, and in F64 when the F32
/// result lands on a BF16 midpoint.
/// :param other: The x coordinate.
/// :returns: The angle in radians, in [-pi, pi].
routine BF16.atan2(me: Me, other: Me) -> Me
    block entry()
        narrow : F32  = me.to<F32>().atan2(other.to<F32>())
        tie    : Bool = bf16_is_on_midpoint(narrow)
        branch tie
            ? wide()
            : return(narrow.to<Me>())

    block wide()
        r     : F64  = me.to<F64>().atan2(other.to<F64>())
        still : Bool = bf16_is_on_midpoint(r)
        branch still
            ? tiny(r)
            : return(r.to<Me>())

    // Still a midpoint in F64: x > 0 and |y / x| tiny (checked on all pairs), where atan2 = atan(y / x) lies
    // just inside y / x. One F64 ulp toward zero puts it on the right side.
    block tiny(r: F64)
        inside : F64 = F64.from_bits(r.bits().sub(1))
        return(inside.to<Me>())

// -- special functions ---------------------------------------------------------

/// The error function, computed in F32 and rounded once to BF16.
/// :returns: erf(`me`), in [-1, 1].
routine BF16.erf(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.erf().to<Me>()
        return(r)

/// 1 - erf(`me`), accurate where erf is near 1. Computed in F32 and rounded once to BF16.
/// :returns: erfc(`me`), in [0, 2].
routine BF16.erfc(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.erfc().to<Me>()
        return(r)

/// The gamma function, computed in F32 and rounded once to BF16.
/// :returns: Γ(`me`): ±inf at ±0, NaN at the negative integers and -inf.
routine BF16.gamma(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.gamma().to<Me>()
        return(r)

/// The logarithm of the absolute value of the gamma function, computed in F32 and rounded once to BF16.
/// :returns: ln |Γ(`me`)|: +inf at 0 and the negative integers.
routine BF16.ln_gamma(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.ln_gamma().to<Me>()
        return(r)

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to BF16).
/// :returns: `me` in degrees, rounded once.
routine BF16.to_degrees(me: Me) -> Me
    block entry()
        r : Me = me.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to BF16).
/// :returns: `me` in radians, rounded once.
routine BF16.to_radians(me: Me) -> Me
    block entry()
        r : Me = me.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- rounding from wider results -------------------------------------------------
//
// The math functions compute in F32 with its correctly rounded CORE-MATH ports and round to BF16. That
// rounding is itself correct unless the F32 result lands exactly on a BF16 midpoint: F32 rounding keeps order
// and every BF16 midpoint is an F32 value. For the one-argument functions no input rounds wrongly (every BF16
// input checked with mpmath). The two-argument ones (powf, hypot, atan2) go through F64 at a midpoint.

/// Whether `r` lies exactly between two BF16 values: it is finite and its low 16 bits are 0x8000.
/// :param r: The F32 result to test.
/// :returns: `true` on a BF16 midpoint.
private routine bf16_is_on_midpoint(r: F32) -> Bool
    block entry()
        low : U32  = r.bits().bitand(0xFFFF)
        mid : Bool = r.is_finite().bitand(low.eq(0x8000))
        return(mid)

/// Whether the normal F64 `r` is within 2^16 of its own units (2^-36 relative) of a BF16 midpoint.
/// :param r: The F64 result to test.
/// :returns: `true` near a midpoint. Zeros, infinities, NaN, and values below BF16's normal range give `false`.
private routine bf16_is_near_midpoint(r: F64) -> Bool
    block entry()
        a      : F64  = r.abs()
        normal : Bool = a.is_finite().bitand(a.ge(0x1p-126))
        branch normal
            ? continue
            : return(false)
        low      : U64 = a.bits().bitand(0x1FFFFFFFFFFF)
        distance : U64 = low.abs_diff(0x100000000000)
        return(distance.le(0x10000))

/// Whether `r` lies exactly between two BF16 values, normal or subnormal.
/// :param r: The F64 result to test.
/// :returns: `true` on a BF16 midpoint.
private routine bf16_is_on_midpoint(r: F64) -> Bool
    shared a : F64 = r.abs()

    block entry()
        sub : Bool = a.lt(0x1p-126)
        branch sub
            ? subnormal()
            : normal()

    // BF16 keeps 7 fraction bits: a midpoint has bit 44 set and nothing below it.
    block normal()
        low : U64  = a.bits().bitand(0x1FFFFFFFFFFF)
        mid : Bool = a.is_finite().bitand(low.eq(0x100000000000))
        return(mid)

    // Below 2^-126 BF16's quantum is 2^-133: a midpoint is an odd multiple of 2^-134.
    block subnormal()
        t     : F64  = a.mul(0x1p134)
        whole : Bool = t.trunc().eq(t)
        odd   : Bool = t.mod(2.0).eq(1.0)
        return(whole.bitand(odd))

// -- classification ------------------------------------------------------------

/// Whether `me` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine BF16.is_nan(me: Me) -> Bool
    block entry()
        r : Bool = funo<Me>(me, me)
        return(r)

/// Whether `me` is +inf or -inf.
/// :returns: True for either infinity, false for NaN and finite values.
routine BF16.is_infinite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.eq(Me.INFINITY)
        return(r)

/// Whether `me` is neither infinite nor NaN.
/// :returns: True for zeros, subnormals and normal values.
routine BF16.is_finite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.lt(Me.INFINITY)
        return(r)

/// Whether `me` is a normal value: not zero, subnormal, infinite, or NaN.
/// :returns: True when the exponent field is neither all zeros nor all ones.
routine BF16.is_normal(me: Me) -> Bool
    block entry()
        exponent : U16  = me.bits().bitand(0x7F80)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7F80))
        return(r)

/// Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `BF16.MIN_POSITIVE`.
/// :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine BF16.is_subnormal(me: Me) -> Bool
    block entry()
        bits     : U16  = me.bits()
        exponent : U16  = bits.bitand(0x7F80)
        mantissa : U16  = bits.bitand(0x007F)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bfloat16 bits.
/// :returns: The encoding: sign bit at the top, then the exponent field, then the fraction.
routine BF16.bits(me: Me) -> U16
    block entry()
        r : U16 = bitcast<Me, U16>(me)
        return(r)

/// Reinterprets raw IEEE 754 bfloat16 bits as a BF16, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {BF16.bits} for the inverse.
routine BF16.from_bits(bits: U16) -> Me
    block entry()
        r : Me = bitcast<U16, Me>(bits)
        return(r)

// -- float conversions -----------------------------------------------------------

/// Converts to F16 by widening to F32 exactly and rounding once to nearest (ties to even).
/// :returns: The nearest F16: infinity above F16's range (65504), a subnormal or zero for tiny values, NaN for NaN.
routine BF16.to<F16>(me: Me) -> F16
    block entry()
        wide : F32 = me.to<F32>()
        r    : F16 = wide.to<F16>()
        return(r)

/// The identity conversion, so generic code can call `to<T>()` when `T` is BF16.
/// :returns: `me` unchanged.
routine BF16.to<Me>(me: Me) -> Me
    block entry()
        return(me)

/// Widens to F32, exactly: BF16 is the upper half of an F32 encoding.
/// :returns: The same value as an F32.
routine BF16.to<F32>(me: Me) -> F32
    block entry()
        r : F32 = fpext<Me, F32>(me)
        return(r)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_<int>_checked returns None instead and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S8>} to get an absent value instead, {BF16.to_clamp<S8>} to saturate.
#track_caller
routine BF16.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.is_trunc_in_range(-128.0, 128.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-128, 127].
/// :see: {BF16.to<S8>} to crash instead, {BF16.to_clamp<S8>} to saturate.
routine BF16.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.is_trunc_in_range(-128.0, 128.0)
        value : S8         = fptosi_sat<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S8>} to detect values that do not fit.
routine BF16.to_clamp<S8>(me: Me) -> S8
    block entry()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S16>} to get an absent value instead, {BF16.to_clamp<S16>} to saturate.
#track_caller
routine BF16.to<S16>(me: Me) -> S16
    block entry()
        fits : Bool = me.is_trunc_in_range(-32768.0, 32768.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = fptosi_sat<Me, S16>(me)
        return(r)

/// Converts to S16, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-32768, 32767].
/// :see: {BF16.to<S16>} to crash instead, {BF16.to_clamp<S16>} to saturate.
routine BF16.to_checked<S16>(me: Me) -> Option<S16>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-32768.0, 32768.0)
        value : S16         = fptosi_sat<Me, S16>(me)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts to S16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S16>} to detect values that do not fit.
routine BF16.to_clamp<S16>(me: Me) -> S16
    block entry()
        r : S16 = fptosi_sat<Me, S16>(me)
        return(r)

/// Converts to S32, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S32>} to get an absent value instead, {BF16.to_clamp<S32>} to saturate.
#track_caller
routine BF16.to<S32>(me: Me) -> S32
    block entry()
        fits : Bool = me.is_trunc_in_range(-2147483648.0, 2147483648.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = fptosi_sat<Me, S32>(me)
        return(r)

/// Converts to S32, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1].
/// :see: {BF16.to<S32>} to crash instead, {BF16.to_clamp<S32>} to saturate.
routine BF16.to_checked<S32>(me: Me) -> Option<S32>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-2147483648.0, 2147483648.0)
        value : S32         = fptosi_sat<Me, S32>(me)
        r     : Option<S32> = fits.then_present(value)
        return(r)

/// Converts to S32, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^31, 2^31 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S32>} to detect values that do not fit.
routine BF16.to_clamp<S32>(me: Me) -> S32
    block entry()
        r : S32 = fptosi_sat<Me, S32>(me)
        return(r)

/// Converts to S64, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S64>} to get an absent value instead, {BF16.to_clamp<S64>} to saturate.
#track_caller
routine BF16.to<S64>(me: Me) -> S64
    block entry()
        fits : Bool = me.is_trunc_in_range(-9223372036854775808.0, 9223372036854775808.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S64 = fptosi_sat<Me, S64>(me)
        return(r)

/// Converts to S64, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1].
/// :see: {BF16.to<S64>} to crash instead, {BF16.to_clamp<S64>} to saturate.
routine BF16.to_checked<S64>(me: Me) -> Option<S64>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-9223372036854775808.0, 9223372036854775808.0)
        value : S64         = fptosi_sat<Me, S64>(me)
        r     : Option<S64> = fits.then_present(value)
        return(r)

/// Converts to S64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^63, 2^63 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S64>} to detect values that do not fit.
routine BF16.to_clamp<S64>(me: Me) -> S64
    block entry()
        r : S64 = fptosi_sat<Me, S64>(me)
        return(r)

/// Converts to S128, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<S128>} to get an absent value instead, {BF16.to_clamp<S128>} to saturate.
#track_caller
routine BF16.to<S128>(me: Me) -> S128
    block entry()
        fits : Bool = me.is_trunc_in_range(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S128 = fptosi_sat<Me, S128>(me)
        return(r)

/// Converts to S128, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
/// :see: {BF16.to<S128>} to crash instead, {BF16.to_clamp<S128>} to saturate.
routine BF16.to_checked<S128>(me: Me) -> Option<S128>
    block entry()
        fits  : Bool         = me.is_trunc_in_range(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        value : S128         = fptosi_sat<Me, S128>(me)
        r     : Option<S128> = fits.then_present(value)
        return(r)

/// Converts to S128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^127, 2^127 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<S128>} to detect values that do not fit.
routine BF16.to_clamp<S128>(me: Me) -> S128
    block entry()
        r : S128 = fptosi_sat<Me, S128>(me)
        return(r)

/// Converts to U8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 255]. The crash reports the caller's location.
/// :see: {BF16.to_checked<U8>} to get an absent value instead, {BF16.to_clamp<U8>} to saturate.
#track_caller
routine BF16.to<U8>(me: Me) -> U8
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 256.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U8 = fptoui_sat<Me, U8>(me)
        return(r)

/// Converts to U8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [0, 255].
/// :see: {BF16.to<U8>} to crash instead, {BF16.to_clamp<U8>} to saturate.
routine BF16.to_checked<U8>(me: Me) -> Option<U8>
    block entry()
        fits  : Bool       = me.is_trunc_in_range(0.0, 256.0)
        value : U8         = fptoui_sat<Me, U8>(me)
        r     : Option<U8> = fits.then_present(value)
        return(r)

/// Converts to U8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [0, 255]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<U8>} to detect values that do not fit.
routine BF16.to_clamp<U8>(me: Me) -> U8
    block entry()
        r : U8 = fptoui_sat<Me, U8>(me)
        return(r)

