/// Converts to U32, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [0, 2^32 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<U32>} to get an absent value instead, {BF16.to_clamp<U32>} to saturate.
#track_caller
routine BF16.to<U32>(self: Self) -> U32
    block entry()
        fits : Bool = self.fits_int(0.0, 4294967296.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U32 = fptoui_sat<Self, U32>(self)
        return(r)

/// Converts to U32, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [0, 2^32 - 1].
/// :see: {BF16.to<U32>} to crash instead, {BF16.to_clamp<U32>} to saturate.
routine BF16.to_checked<U32>(self: Self) -> Option<U32>
    block entry()
        fits  : Bool        = self.fits_int(0.0, 4294967296.0)
        value : U32         = fptoui_sat<Self, U32>(self)
        r     : Option<U32> = fits.then_present(value)
        return(r)

/// Converts to U32, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [0, 2^32 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<U32>} to detect values that do not fit.
routine BF16.to_clamp<U32>(self: Self) -> U32
    block entry()
        r : U32 = fptoui_sat<Self, U32>(self)
        return(r)

/// Converts to U64, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [0, 2^64 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<U64>} to get an absent value instead, {BF16.to_clamp<U64>} to saturate.
#track_caller
routine BF16.to<U64>(self: Self) -> U64
    block entry()
        fits : Bool = self.fits_int(0.0, 18446744073709551616.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U64 = fptoui_sat<Self, U64>(self)
        return(r)

/// Converts to U64, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [0, 2^64 - 1].
/// :see: {BF16.to<U64>} to crash instead, {BF16.to_clamp<U64>} to saturate.
routine BF16.to_checked<U64>(self: Self) -> Option<U64>
    block entry()
        fits  : Bool        = self.fits_int(0.0, 18446744073709551616.0)
        value : U64         = fptoui_sat<Self, U64>(self)
        r     : Option<U64> = fits.then_present(value)
        return(r)

/// Converts to U64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [0, 2^64 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<U64>} to detect values that do not fit.
routine BF16.to_clamp<U64>(self: Self) -> U64
    block entry()
        r : U64 = fptoui_sat<Self, U64>(self)
        return(r)

/// Converts to U128, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [0, 2^128 - 1]. The crash reports the caller's location.
/// :see: {BF16.to_checked<U128>} to get an absent value instead, {BF16.to_clamp<U128>} to saturate.
#track_caller
routine BF16.to<U128>(self: Self) -> U128
    block entry()
        fits : Bool = self.fits_int(0.0, 340282366920938463463374607431768211456.0)
        branch fits
            ? continue
            : crash_overflow()
        r : U128 = fptoui_sat<Self, U128>(self)
        return(r)

/// Converts to U128, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [0, 2^128 - 1].
/// :see: {BF16.to<U128>} to crash instead, {BF16.to_clamp<U128>} to saturate.
routine BF16.to_checked<U128>(self: Self) -> Option<U128>
    block entry()
        fits  : Bool         = self.fits_int(0.0, 340282366920938463463374607431768211456.0)
        value : U128         = fptoui_sat<Self, U128>(self)
        r     : Option<U128> = fits.then_present(value)
        return(r)

/// Converts to U128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [0, 2^128 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {BF16.to_checked<U128>} to detect values that do not fit.
routine BF16.to_clamp<U128>(self: Self) -> U128
    block entry()
        r : U128 = fptoui_sat<Self, U128>(self)
        return(r)

/// Whether self, rounded toward zero, lies in [lo, hi). False for NaN.
routine BF16.fits_int(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        whole : Self = self.trunc()
        r     : Bool = whole.in_range(lo, hi)
        return(r)
