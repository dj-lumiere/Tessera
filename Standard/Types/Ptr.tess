// Tessera stdlib: @T — typed pointer
//
// Maps to LLVM IR ptr (opaque pointer).  The type parameter T records the
// pointee type for load/store — it is erased at the IR level.

module Standard::Core

/// A typed pointer `@T`, mapped to LLVM `ptr`. `T` records the pointee type for `load` and `store` and is erased in the IR. The pointer does not own what it points at.
/// :typeparam T: The pointee type.
#llvm("ptr")
record Ptr<T>
require T: typename

// -- pointer identity ----------------------------------------------------------

/// Whether `me` and `other` hold the same address.
/// :typeparam T: The pointee type.
/// :param other: The right-hand operand.
/// :returns: `true` when the addresses are equal.
routine Ptr<T>.ptr_eq(me: Me, other: Me) -> Bool
require T: typename
    block entry()
        a : S64  = ptrtoint<Me, S64>(me)
        b : S64  = ptrtoint<Me, S64>(other)
        r : Bool = ieq<S64>(a, b)
        return(r)

/// Whether `me` and `other` hold different addresses.
/// :typeparam T: The pointee type.
/// :param other: The right-hand operand.
/// :returns: `true` when the addresses differ.
routine Ptr<T>.ptr_ne(me: Me, other: Me) -> Bool
require T: typename
    block entry()
        a : S64  = ptrtoint<Me, S64>(me)
        b : S64  = ptrtoint<Me, S64>(other)
        r : Bool = ine<S64>(a, b)
        return(r)

// -- predicates ----------------------------------------------------------------

/// Whether `me` is the null pointer.
/// :typeparam T: The pointee type.
/// :returns: `true` when the address is 0.
routine Ptr<T>.is_null(me: Me) -> Bool
require T: typename
    block entry()
        a : S64  = ptrtoint<Me, S64>(me)
        r : Bool = ieq<S64>(a, 0)
        return(r)

/// Whether `me` is a non-null pointer.
/// :typeparam T: The pointee type.
/// :returns: `true` when the address is not 0.
routine Ptr<T>.is_not_null(me: Me) -> Bool
require T: typename
    block entry()
        a : S64  = ptrtoint<Me, S64>(me)
        r : Bool = ine<S64>(a, 0)
        return(r)

// -- pointer arithmetic --------------------------------------------------------

/// Returns a pointer `bytes` bytes further on (back for a negative `bytes`).
/// No bounds checking: the caller is responsible for staying in bounds.
/// :param bytes: The distance in bytes, negative to move back.
/// :returns: The moved pointer, with the same pointee type.
routine Ptr<T>.offset(me: Me, bytes: SSize) -> Me
require T: typename
    block entry()
        raw    : Addr = me
        moved  : Addr = raw.offset(bytes)
        result : Me   = moved.to<Me>()
        return(result)

// `p.stride(n)`, the pointer n Ts further on (`offset` counted in elements rather than bytes, with n a USize, or
// an SSize to move back), is built into the builder: it's a place like a field, so `p.stride(i).f` chains and a
// load or store through it keeps a dense record's real alignment. No bounds checking.

// -- casting -------------------------------------------------------------------

/// Reinterprets this pointer as a pointer to a different type.
/// No-op at the IR level: it only changes the static type.
/// :typeparam TPointee: The new pointee type.
/// :returns: The same address as a `@TPointee`.
routine Ptr<T>.to<@TPointee>(me: Me) -> @TPointee
require T: typename, TPointee: typename
    block entry()
        result : @TPointee = bitcast<Me, @TPointee>(me)
        return(result)

/// The address alone, without the pointee type: what `{p.to<Addr>()}` prints (`0x7ffd5e8c1a40`), since a pointer
/// itself is neither Representable nor Diagnosable. `{p.load()}` prints what it points to.
/// :typeparam T: The pointee type.
/// :returns: The same address as an `Addr`.
routine Ptr<T>.to<Addr>(me: Me) -> Addr
require T: typename
    block entry()
        address : Addr = me
        return(address)

// -- memory --------------------------------------------------------------------

/// Reads the T at this address.
/// :returns: The value stored there.
#[external("llvm"), template("{result} = load {T}, ptr {me}")]
routine Ptr<T>.load(me: Me) -> T
require T: typename

/// Writes `value` to this address.
/// :param value: The value to write.
#[external("llvm"), template("store {T} {value}, ptr {me}")]
routine Ptr<T>.store(me: Me, value: T) -> Void
require T: typename

/// Writes this value to `dest`: `dest.store(me)` read from the value's side, for a chain that ends in memory
/// (`a.add(b).store_into(sum)`).
/// :param dest: The address to write to.
#[external("llvm"), template("store {T} {me}, ptr {dest}")]
routine T.store_into(me: T, dest: @T) -> Void
require T: typename

/// Reads the T at this address, which may not be aligned for T: a wire format, a packed buffer, a field taken out of a
/// #layout(dense) record. Costs nothing extra where the CPU allows unaligned access (x86, AArch64) and reads byte
/// by byte where it doesn't (Cortex-M0, RISC-V without Zicclsm).
/// :returns: The value stored there.
#[external("llvm"), template("{result} = load {T}, ptr {me}, align 1")]
routine Ptr<T>.load_unaligned(me: Me) -> T
require T: typename

/// Writes `value` to this address, which may not be aligned for T.
/// :param value: The value to write.
#[external("llvm"), template("store {T} {value}, ptr {me}, align 1")]
routine Ptr<T>.store_unaligned(me: Me, value: T) -> Void
require T: typename

/// A read the compiler may not remove, merge, or reorder with other volatile accesses: for memory-mapped registers.
/// :returns: The value stored there.
#[external("llvm"), template("{result} = load volatile {T}, ptr {me}")]
routine Ptr<T>.volatile_load(me: Me) -> T
require T: typename

/// A write the compiler may not remove, merge, or reorder with other volatile accesses.
/// :param value: The value to write.
#[external("llvm"), template("store volatile {T} {value}, ptr {me}")]
routine Ptr<T>.volatile_store(me: Me, value: T) -> Void
require T: typename

/// Sets `count` Ts from here on to all-zero bytes, padding included.
/// :param count: The number of Ts to clear.
/// :throws: Crashes with `IntegerOverflowError` when `count` times the size of T does not fit in USize.
routine Ptr<T>.zeroinit(me: Me, count: USize) -> Void
require T: typename
    block entry()
        elem_size : USize = sizeof<T>()
        size      : USize = elem_size.mul(count)
        ptr_zero_bytes(me, size)
        return()

// llvm.memset, so the core layer needs no libc: without an operating system, Freestanding.tess supplies memset.
/// Fills `bytes` bytes at `dst` with zero through `llvm.memset`.
/// :param dst: The first byte to clear.
/// :param bytes: The number of bytes to clear.
#[external("llvm"),
    template("call void @llvm.memset.p0.{USize}(ptr {dst}, i8 0, {USize} {bytes}, i1 false)")]
private routine ptr_zero_bytes(dst: Addr, bytes: USize) -> Void
