// Tessera stdlib: Char — a Unicode scalar value
//
// Maps to LLVM IR i32 and always holds 0 ..= 0x10FFFF outside the surrogates
// 0xD800 ..= 0xDFFF. A literal is written 'A', and U32.to<Char>() checks a number.

module Standard::Core

/// A Unicode scalar value, mapped to LLVM `i32`. It holds a code point from 0 to 0x10FFFF, excluding the surrogates 0xD800 to 0xDFFF. A literal is written `'A'`, and `U32.to<Char>()` checks a number.
#llvm("i32")
record Char
conform Equal<Char>, Compare<Char>, Hash<Char>

/// Reinterprets `self` as its code point number.
/// :returns: The code point as a `U32`.
routine Char.to<U32>(self: Self) -> U32
    block entry()
        r : U32 = bitcast<Self, U32>(self)
        return(r)

/// Hashes `self` as its `U32` code point.
/// :returns: The 64-bit hash.
routine Char.hash(self: Self) -> U64
    block entry()
        h : U64 = self.to<U32>().hash()
        return(h)

/// Whether `self` and `other` are the same character.
/// :param other: The right-hand operand.
/// :returns: `true` when the code points are equal.
routine Char.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Whether `self` and `other` are different characters.
/// :param other: The right-hand operand.
/// :returns: `true` when the code points differ.
routine Char.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Whether the code point of `self` is less than that of `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ult i32 {self}, {other}")]
routine Char.lt(self: Self, other: Self) -> Bool

/// Whether the code point of `self` is less than or equal to that of `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ule i32 {self}, {other}")]
routine Char.le(self: Self, other: Self) -> Bool

/// Whether the code point of `self` is greater than that of `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ugt i32 {self}, {other}")]
routine Char.gt(self: Self, other: Self) -> Bool

/// Whether the code point of `self` is greater than or equal to that of `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp uge i32 {self}, {other}")]
routine Char.ge(self: Self, other: Self) -> Bool

/// self in [lo, hi], both ends included. False when lo > hi.
routine Char.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine Char.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

/// -1, 0, or 1, by code point.
routine Char.compare(self: Self, other: Self) -> S32
    block entry()
        r : S32 = self.to<U32>().compare(other.to<U32>())
        return(r)

/// Whether `self` is an ASCII character, that is, a code point below 128.
/// :returns: `true` for code points 0 to 127.
routine Char.is_ascii(self: Self) -> Bool
    block entry()
        r : Bool = self.to<U32>().lt(128)
        return(r)
