// Tessera stdlib: the layout of the IEEE binary float formats
//
// A binary float's bits are a sign bit at the top, then a biased exponent field, then the stored fraction. The routines
// that work on several formats from their bits (the soft-float conversions, widening and narrowing through F128,
// decimal parsing, decimal formatting) take the format as one FloatFormat value instead of its numbers one by one.
// Each float type names its own as `F32.FORMAT` and so on: read-only data, loaded where it's passed.

module Standard::Core

/// F16's layout: 1 sign bit, 5 exponent bits, 10 fraction bits.
preset F16.FORMAT: @FloatFormat <- { width: 16, fraction_bits: 10, bias: 15, exponent_max: 31 }
/// BF16's layout: 1 sign bit, 8 exponent bits (F32's), 7 fraction bits.
preset BF16.FORMAT: @FloatFormat <- { width: 16, fraction_bits: 7, bias: 127, exponent_max: 255 }
/// F32's layout: 1 sign bit, 8 exponent bits, 23 fraction bits.
preset F32.FORMAT: @FloatFormat <- { width: 32, fraction_bits: 23, bias: 127, exponent_max: 255 }
/// F64's layout: 1 sign bit, 11 exponent bits, 52 fraction bits.
preset F64.FORMAT: @FloatFormat <- { width: 64, fraction_bits: 52, bias: 1023, exponent_max: 2047 }

/// F128's layout: 1 sign bit, 15 exponent bits, 112 fraction bits.
preset F128.FORMAT: @FloatFormat <- { width: 128, fraction_bits: 112, bias: 16383,
    exponent_max: 32767 }

/// The layout of an IEEE binary float format: where its bits put the sign, the exponent, and the fraction. The sign is
/// bit `width - 1`, the exponent field the `width - 1 - fraction_bits` bits under it, and the fraction the low
/// `fraction_bits` bits.
record FloatFormat
    width         : U32  // the format's width in bits
    fraction_bits : U32  // the stored fraction bits, without the implicit leading bit
    bias          : S32  // the exponent bias: a normal value is 1.fraction × 2^(field - bias)
    exponent_max  : S32  // the all-ones exponent field, of infinity and NaN

/// The format's sign bit, in place in the low 32 bits: bit 15 for F16 and BF16, bit 31 for F32.
/// :returns: `1 << (width - 1)`. The format must be at most 32 bits wide.
#inline
routine FloatFormat.sign_bit(me: Me) -> U32
    block entry()
        top : U32 = me.width.sub(1)
        return(U32.shl(1, top))
