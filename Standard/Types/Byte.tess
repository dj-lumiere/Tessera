// Tessera stdlib: Byte — 8 bits of memory
//
// The unit of memory and text: @Byte is untyped memory, a Bytes is bytes.
// A Byte compares (as 0 ..= 255, with byte literals like b'0'), hashes, and
// takes bit operations, but has no arithmetic: .to<U8>() (or .to<S8>()) gives
// the number. A Byte literal is hex with exactly two digits (0xFF) or b'A'.

module Standard::Core

/// Eight bits of memory, mapped to LLVM `i8`. A `Byte` compares (as 0 to 255), hashes, and takes the bitwise operations, but has no arithmetic: convert with `to<U8>()` to get the number.
#llvm("i8")
record Byte
conform Equatable<Byte>, Comparable<Byte>, Hashable<Byte>

/// Reinterprets `me` as the `U8` with the same bits.
/// :returns: The byte value as a number from 0 to 255.
routine Byte.to<U8>(me: Me) -> U8
    block entry()
        r : U8 = bitcast<Me, U8>(me)
        return(r)

/// Reinterprets `me` as the `S8` with the same bits.
/// :returns: The byte value as a number from -128 to 127.
routine Byte.to<S8>(me: Me) -> S8
    block entry()
        r : S8 = bitcast<Me, S8>(me)
        return(r)

/// Whether `me` and `other` are the same byte.
/// :param other: The right-hand operand.
/// :returns: `true` when the bits are equal.
routine Byte.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ieq<Me>(me, other)
        return(r)

/// Whether `me` and `other` are different bytes.
/// :param other: The right-hand operand.
/// :returns: `true` when the bits differ.
routine Byte.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ine<Me>(me, other)
        return(r)

/// Whether `me` is less than `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ult i8 {me}, {other}")]
routine Byte.lt(me: Me, other: Me) -> Bool

/// Whether `me` is less than or equal to `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ule i8 {me}, {other}")]
routine Byte.le(me: Me, other: Me) -> Bool

/// Whether `me` is greater than `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ugt i8 {me}, {other}")]
routine Byte.gt(me: Me, other: Me) -> Bool

/// Whether `me` is greater than or equal to `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp uge i8 {me}, {other}")]
routine Byte.ge(me: Me, other: Me) -> Bool

/// Whether `me` lies in [`lo`, `hi`], both ends included, compared as 0 to 255. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: `true` when `lo <= me <= hi`.
routine Byte.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Whether `me` lies in [`lo`, `end`): `lo` included, `end` not, compared as 0 to 255. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: `true` when `lo <= me < end`.
routine Byte.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

/// Three-way comparison of `me` and `other` as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: -1, 0, or 1 as `me` is below, equal to, or above `other`.
routine Byte.compare(me: Me, other: Me) -> S32
    block entry()
        r : S32 = me.to<U8>().compare(other.to<U8>())
        return(r)

/// Hashes `me` as the `U8` with the same bits, so a `Byte` and a `U8` of equal value hash alike.
/// :returns: The 64-bit hash.
routine Byte.hash(me: Me) -> U64
    block entry()
        r : U64 = me.to<U8>().hash()
        return(r)

/// Bitwise AND of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A byte with a bit set where both operands have it set.
routine Byte.bitand(me: Me, other: Me) -> Me
    block entry()
        r : Me = band<Me>(me, other)
        return(r)

/// Bitwise OR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A byte with a bit set where either operand has it set.
routine Byte.bitor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bor<Me>(me, other)
        return(r)

/// Bitwise XOR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A byte with a bit set where exactly one operand has it set.
routine Byte.bitxor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bxor<Me>(me, other)
        return(r)

/// Bitwise complement of `me`.
/// :returns: `me` with every bit flipped.
routine Byte.bitnot(me: Me) -> Me
    block entry()
        r : Me = bnot<Me>(me)
        return(r)

/// Shifts `me` left by `n` bits, filling with zeros. A shift by 8 or more shifts every bit out and gives 0x00.
/// :param n: The shift amount.
/// :returns: The shifted byte.
routine Byte.shl(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.lt(0x08)
        shifted  : Me   = shl<Me>(me, n)
        r        : Me   = in_range
            ? shifted
            : 0x00
        return(r)

/// Shifts `me` right by `n` bits, filling with zeros (a logical shift). A shift by 8 or more gives 0x00.
/// :param n: The shift amount.
/// :returns: The shifted byte.
routine Byte.shr(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.lt(0x08)
        shifted  : Me   = lshr<Me>(me, n)
        r        : Me   = in_range
            ? shifted
            : 0x00
        return(r)
