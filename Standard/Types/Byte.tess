// Tessera stdlib: Byte — 8 bits of memory
//
// The unit of memory and text: @Byte is untyped memory, a Bytes is bytes.
// A Byte compares (as 0 ..= 255, with byte literals like b'0'), hashes, and
// takes bit operations, but has no arithmetic: .to<U8>() (or .to<S8>()) gives
// the number. A Byte literal is hex with exactly two digits (0xFF) or b'A'.

module Standard::Core

/// Eight bits of memory, mapped to LLVM `i8`. A `Byte` compares (as 0 to 255), hashes, and takes the bitwise operations, but has no arithmetic: convert with `to<U8>()` to get the number.
#llvm("i8")
record Byte
conform Equatable<Byte>, Comparable<Byte>, Hashable<Byte>

/// Reinterprets `self` as the `U8` with the same bits.
/// :returns: The byte value as a number from 0 to 255.
routine Byte.to<U8>(self: Self) -> U8
    block entry()
        r : U8 = bitcast<Self, U8>(self)
        return(r)

/// Reinterprets `self` as the `S8` with the same bits.
/// :returns: The byte value as a number from -128 to 127.
routine Byte.to<S8>(self: Self) -> S8
    block entry()
        r : S8 = bitcast<Self, S8>(self)
        return(r)

/// Whether `self` and `other` are the same byte.
/// :param other: The right-hand operand.
/// :returns: `true` when the bits are equal.
routine Byte.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Whether `self` and `other` are different bytes.
/// :param other: The right-hand operand.
/// :returns: `true` when the bits differ.
routine Byte.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Whether `self` is less than `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ult i8 {self}, {other}")]
routine Byte.lt(self: Self, other: Self) -> Bool

/// Whether `self` is less than or equal to `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ule i8 {self}, {other}")]
routine Byte.le(self: Self, other: Self) -> Bool

/// Whether `self` is greater than `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ugt i8 {self}, {other}")]
routine Byte.gt(self: Self, other: Self) -> Bool

/// Whether `self` is greater than or equal to `other`, compared as 0 to 255.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp uge i8 {self}, {other}")]
routine Byte.ge(self: Self, other: Self) -> Bool

/// self in [lo, hi], both ends included. False when lo > hi.
routine Byte.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine Byte.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

/// -1, 0, or 1, as 0 ..= 255.
routine Byte.compare(self: Self, other: Self) -> S32
    block entry()
        r : S32 = self.to<U8>().compare(other.to<U8>())
        return(r)

/// Hashes `self` as the `U8` with the same bits, so a `Byte` and a `U8` of equal value hash alike.
/// :returns: The 64-bit hash.
routine Byte.hash(self: Self) -> U64
    block entry()
        r : U64 = self.to<U8>().hash()
        return(r)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A byte with a bit set where both operands have it set.
routine Byte.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A byte with a bit set where either operand has it set.
routine Byte.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A byte with a bit set where exactly one operand has it set.
routine Byte.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise complement of `self`.
/// :returns: `self` with every bit flipped.
routine Byte.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

/// A shift by 8 or more shifts every bit out (see Operations, Bitwise and Shifts).
routine Byte.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(0x08)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0x00
        return(r)

/// Logical: zeros fill in. A shift by 8 or more gives 0x00.
routine Byte.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(0x08)
        shifted  : Self = lshr<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0x00
        return(r)
