// Tessera stdlib: CStr, CWStr — C strings at the FFI boundary
//
// CStr points at C chars that end with a NUL (C's char*), CChar units the way
// CWStr points at CWChar units. CWStr points at wide characters that end with a
// 0 (C's wchar_t*): UTF-16 units on Windows, UTF-32 code points elsewhere, as
// CWChar says. Both are one-field records, so they cost nothing over the
// pointer, and the type says the terminator is there. CChar is S8 or U8 as the
// target's char is, so a Bytes view of a CStr reinterprets the same memory.
//
// A string literal becomes a CStr or CWStr where one is expected, terminator
// included. Text built at run time becomes one explicitly: Bytes.to<OwnedCStr>
// and Bytes.to<OwnedCWStr> copy through an allocator into an owner (Memory.tess),
// and a List<Byte> ends itself with a NUL (List<Byte>.to<CStr>). A Bytes is a
// view with no terminator, so it never converts implicitly.

module Standard::Core

/// A C string: a pointer to `CChar` units that end with a NUL (C's `char*`). It is a one-field record, so it costs nothing over the pointer, and the type records that the terminator is there.
record CStr
    data : @CChar

/// A C wide string: a pointer to `CWChar` units that end with a 0 (C's `wchar_t*`), UTF-16 units on Windows and UTF-32 code points elsewhere. It costs nothing over the pointer.
record CWStr
    data : @CWChar

// -- CStr ------------------------------------------------------------------------

/// The C string at this pointer: it must point at C chars ending with a NUL, and nothing checks it. Memory typed as
/// bytes has its own `to<CStr>()`.
routine Ptr<T>.to<CStr>(self: @CChar) -> CStr
require T: typename
    block entry()
        c : CStr = CStr { data: self }
        return(c)

/// The pointer to the first C char.
/// :returns: The underlying `@CChar`, still NUL-terminated.
routine CStr.to<@CChar>(self: Self) -> @CChar
    block entry()
        data : @CChar = self.data
        return(data)

/// The number of C chars before the NUL, like strlen.
routine CStr.count(self: Self) -> USize
    block entry()
        data : @CChar = self.data
        jump scan(data, 0)

    block scan(data: @CChar, i: USize)
        current : CChar = data.stride(i).load()
        at_end  : Bool  = current.eq(0)
        branch at_end
            ? return(i)
            : scan(data, i.add(1))

/// A Bytes view of the C chars before the NUL, without copying: text a C
/// function returned, for example. It's valid as long as the text is.
routine CStr.to<Bytes>(self: Self) -> Bytes
    block entry()
        data  : @Byte = self.data.to<@Byte>()
        count : USize = self.count()
        text  : Bytes = .from_ptr(data, count)
        return(text)

// -- CWStr -----------------------------------------------------------------------

/// The C string at this memory: it must hold C chars ending with a NUL, and nothing checks it.
routine Ptr<T>.to<CStr>(self: @Byte) -> CStr
require T: typename
    block entry()
        c : CStr = CStr { data: self.to<@CChar>() }
        return(c)

/// The C wide string at this pointer: it must point at wide characters ending with a 0, and nothing checks it.
routine Ptr<T>.to<CWStr>(self: @CWChar) -> CWStr
require T: typename
    block entry()
        c : CWStr = CWStr { data: self }
        return(c)

/// The pointer to the first wide character.
/// :returns: The underlying `@CWChar`, still 0-terminated.
routine CWStr.to<@CWChar>(self: Self) -> @CWChar
    block entry()
        data : @CWChar = self.data
        return(data)

/// The number of CWChar units before the 0, like wcslen: UTF-16 units on
/// Windows, so a character outside the BMP counts twice there.
routine CWStr.count(self: Self) -> USize
    block entry()
        data : @CWChar = self.data
        jump scan(data, 0)

    block scan(data: @CWChar, i: USize)
        unit   : CWChar = data.stride(i).load()
        at_end : Bool   = unit.eq(0)
        branch at_end
            ? return(i)
            : scan(data, i.add(1))
