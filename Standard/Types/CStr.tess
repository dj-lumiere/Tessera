// Tessera stdlib: CStr, CWStr — C strings at the FFI boundary
//
// CStr points at C chars that end with a NUL (C's char*), CChar units the way
// CWStr points at CWChar units. CWStr points at wide characters that end with a
// 0 (C's wchar_t*): UTF-16 units on Windows, UTF-32 code points elsewhere, as
// CWChar says. Both are one-field records, so they cost nothing over the
// pointer, and the type says the terminator is there. CChar is S8 or U8 as the
// target's char is, so a Span[Byte] view of a CStr reinterprets the same memory.
//
// A string literal becomes a CStr or CWStr where one is expected, terminator
// included. Text built at run time becomes one explicitly: Span[Byte].to[OwnedCStr]
// and Span[Byte].to[OwnedCWStr] copy through an allocator into an owner (Memory.tess),
// and a List[Byte] ends itself with a NUL (List[Byte].to[CStr]). A Span[Byte] is a
// view with no terminator, so it never converts implicitly.

module Standard/Core

/// A C string: a pointer to `CChar` units that end with a NUL (C's `char*`). It is a one-field record, so it costs nothing over the pointer, and the type records that the terminator is there.
record CStr
    data: @CChar

/// A C wide string: a pointer to `CWChar` units that end with a 0 (C's `wchar_t*`), UTF-16 units on Windows and UTF-32 code points elsewhere. It costs nothing over the pointer.
record CWStr
    data: @CWChar

/// Makes a `CStr` from its fields.
/// :param data: Its `data`.
/// :returns: The new value.
routine CStr.construct(data: @CChar) -> Me
    return(Me(data))

/// Releases nothing: a `CStr` holds no memory of its own.
routine CStr.destruct(me: @Me) -> Void
    return()

/// Makes a `CWStr` from its fields.
/// :param data: Its `data`.
/// :returns: The new value.
routine CWStr.construct(data: @CWChar) -> Me
    return(Me(data))

/// Releases nothing: a `CWStr` holds no memory of its own.
routine CWStr.destruct(me: @Me) -> Void
    return()

// -- CStr ------------------------------------------------------------------------

/// The C string at this pointer: it must point at C chars ending with a NUL, and nothing checks it. Memory typed as
/// bytes has its own `to[CStr]()`.
/// :returns: The `CStr` over the same pointer.
routine Ptr[T].to[CStr](me: @CChar) -> CStr
require T: typename
    c: CStr = CStr(data: me)
    return(c)

/// The pointer to the first C char.
/// :returns: The underlying `@CChar`, still NUL-terminated.
routine CStr.to[@CChar](me: Me) -> @CChar
    data: @CChar = me.data
    return(data)

/// The number of C chars before the NUL, like strlen.
/// :returns: The count of C chars before the NUL.
routine CStr.count(me: Me) -> USize
    local data: @CChar = me.data

    jump scan(0)

    block scan(i: USize)
        current: CChar = data.stride(i).peek()
        at_end: Bool = current.eq(0)
        branch at_end
            ? return(i)
            : scan(i.add(1))

/// A view of the C chars before the NUL, without copying: text a C function returned, for example. It is valid as long
/// as the text is.
/// :returns: The text, the NUL left out.
routine CStr.getview(me: Me) -> Span[Byte]
    data: @Byte = me.data.to[@Byte]()
    return(Span[Byte].construct(data, count: me.count()))

// -- CWStr -----------------------------------------------------------------------

/// The C string at this memory: it must hold C chars ending with a NUL, and nothing checks it.
/// :returns: The `CStr` over the same memory.
routine Ptr[T].to[CStr](me: @Byte) -> CStr
require T: typename
    c: CStr = CStr(data: me.to[@CChar]())
    return(c)

/// The C wide string at this pointer: it must point at wide characters ending with a 0, and nothing checks it.
/// :returns: The `CWStr` over the same pointer.
routine Ptr[T].to[CWStr](me: @CWChar) -> CWStr
require T: typename
    c: CWStr = CWStr(data: me)
    return(c)

/// The pointer to the first wide character.
/// :returns: The underlying `@CWChar`, still 0-terminated.
routine CWStr.to[@CWChar](me: Me) -> @CWChar
    data: @CWChar = me.data
    return(data)

/// The number of `CWChar` units before the 0, like wcslen: UTF-16 units on Windows, so a character outside the BMP
/// counts twice there.
/// :returns: The count of units before the 0.
routine CWStr.count(me: Me) -> USize
    local data: @CWChar = me.data

    jump scan(0)

    block scan(i: USize)
        unit: CWChar = data.stride(i).peek()
        at_end: Bool = unit.eq(0)
        branch at_end
            ? return(i)
            : scan(i.add(1))
