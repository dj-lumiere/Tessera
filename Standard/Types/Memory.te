# Tessera stdlib: Memory[T] and Box[T], memory taken from a manager
#
# `Memory[T]` is a run of values and `Box[T]` one value, both from a MemoryManager, and each is released exactly once:
# `drop()` gives the memory back, and so does handing the value to a routine that takes a `Memory` or a `Box` (it
# releases it then). Lending is passing it where a `Span[T]` (or a `@T`) is expected: `getview()` makes the view, and
# an argument makes it on its own. A copy (`b = a`) is the same memory, so drop it once whichever copy you hold, and
# `duplicate()` makes memory of its own.
#
# A literal names the manager with `at`: `claim xs: Memory[U64] <- [0] * n at heap` is a Memory of n zeros (the count
# may be known only while running), and `claim node: Box[Node] <- (value: 1, next: null) at heap` a Box of one value.
#
# Every block starts with a stamp: the generation the block was given when it was taken, a number no other block of
# the program has. The value keeps its own copy. `drop()` clears the block's stamp before giving the memory back, and
# `load`, `store`, `getslot`, and `getview` compare the two first: a value whose memory was given back already (through
# another copy, or in another routine) crashes with DestructedMemoryError instead of reading freed memory. `resize`
# gives the moved block a new generation, so a copy taken before it no longer passes either.
#
# `.hollow()` is a Memory or a Box holding nothing (no address, no manager): `drop()` on it does nothing, and a read
# crashes.

module Standard/Core

import Standard/Alloc

### The last generation given out, on a target with threads.
@target(os: not "none")
secret global LAST_GENERATION: @U64
### The last generation given out, on a target without an operating system.
@target(os: "none")
secret global LAST_GENERATION: @U64

### The bytes the stamp takes in front of the values.
secret preset STAMP_SIZE: U64 = 16
### The offset from the values back to the stamp.
secret preset STAMP_BACK: S64 = -16

### The stamp in front of a block's values: its generation, 0 once dropped.
secret record BlockStamp
    generation: U64
    unused: U64

### A generation no block has had yet.
### :returns: The next generation, never 0.
@target(os: not "none")
secret routine next_generation() -> U64
    return LAST_GENERATION.atomic_fetch_add(1) + 1

### A generation no block has had yet.
### :returns: The next generation, never 0.
@target(os: "none")
secret routine next_generation() -> U64
    next: U64 = LAST_GENERATION.peek() + 1
    next.poke_into(LAST_GENERATION)
    return next

### The room in front of the values of a `T`: the stamp, rounded up to keep the values aligned.
### :typeparam T: The value type.
### :returns: The room in bytes.
secret routine stamp_room[T]() -> U64
needs T: typename
    return alignof[T]().max(STAMP_SIZE)

### The stamp of the block whose values start at `data`.
### :typeparam T: The value type.
### :param data: The first value.
### :returns: The stamp's address.
secret routine stamp_of[T](data: @T) -> @BlockStamp
needs T: typename
    raw: Addr = data
    return raw.offset(STAMP_BACK).to[@BlockStamp]()

### Crashes unless the block at `data` still has `generation`: a dropped block, or one that moved, doesn't.
### :typeparam T: The value type.
### :param data: The first value, or null.
### :param generation: The generation the value was given.
### :throws: Crashes with `InvalidValueError` when `data` is null (a hollow value), and with `DestructedMemoryError`
###     when the block was dropped or moved.
@track_caller
secret routine check_generation[T](data: @T, generation: U64) -> None
needs T: typename
    if data.is_null()
        crash(name: "InvalidValueError",
            message: "This memory holds nothing: it is hollow, or was dropped.")
    now: U64 = stamp_of[T](data).generation.peek()
    if now == generation
        return
    else
        crash(name: "DestructedMemoryError",
            message: "This memory was given back already, or moved by a resize: the value is a stale copy.")

### Takes room for `count` values of `T` and a stamp from `manager`, the stamp set to a new generation.
### :typeparam T: The value type.
### :param count: The number of values, more than 0.
### :param manager: Where the memory comes from.
### :returns: The first value's address and its generation, or a null address when the manager has none to give.
### :throws: Crashes with `IntegerOverflowError` when the size doesn't fit in U64.
@expensive("allocates memory")
secret routine take_block[T](count: U64, manager: @MemoryManager) -> (@T, U64)
needs T: typename
    room: U64 = stamp_room[T]()
    size: U64 = sizeof[T]() * count + room
    taken: Addr = manager.alloc(size, align: room)
    if taken.is_null()
        return (null, 0)
    data: @T = taken.offset(room.to[S64]()).to[@T]()
    generation: U64 = next_generation()
    generation.poke_into(stamp_of[T](data).generation)
    return (data, generation)

### Clears the stamp of the block at `data` and gives the block back to `manager`.
### :typeparam T: The value type.
### :param data: The first value.
### :param manager: Where the memory came from.
@track_caller
@expensive("frees memory")
secret routine give_block[T](data: @T, manager: @MemoryManager) -> None
needs T: typename
    stamp_of[T](data).generation.poke(0)
    raw: Addr = data
    manager.free(raw.offset(-stamp_room[T]().to[S64]()))
    return

# == Memory[T] ====================================================================================================

### `count` values of `T` from a manager, released exactly once with `drop`. An entity: never copied, lent as a
### `@Memory[T]`. `load` and `store` check that the memory hasn't been given back. Lend `getview()` where a `Span[T]`
### is expected.
### :typeparam T: The element type.
entity Memory[T]
needs T: typename
    data: @T
    count: U64
    manager: @MemoryManager
    generation: U64

### `count` uninitialized values of `T` from `manager`, given back with `drop`. A count of 0 takes nothing and keeps
### the manager.
### :param count: The number of values.
### :param manager: Where the memory comes from and goes back to.
### :returns: The memory.
### :throws: Crashes with `MemoryAllocationError` when the manager has no memory to give. See
###     {Memory[T].construct_result}.
@track_caller
@expensive("allocates memory")
routine Memory[T].construct(count: U64, manager: @MemoryManager) -> Me
needs T: typename
    when Me.construct_result(count, manager)
        is Me as memory => return memory
        is AllocFailed => crash_allocation()

### `values` written `times` over, one run after another, in memory from `manager`: what `[a, b] * n at manager`
### makes.
### :param values: The values to repeat.
### :param times: How many times they are written.
### :param manager: Where the memory comes from and goes back to.
### :returns: The memory, `times` runs of `values`.
### :throws: Crashes with `IntegerOverflowError` when the count doesn't fit in a U64, and with
###     `MemoryAllocationError` when the manager has no memory to give.
@track_caller
@expensive("allocates memory")
routine Memory[T].construct(values: Span[T], times: U64, manager: @MemoryManager) -> Me
needs T: typename
    local made: @Me <- Me.construct(count: values.count * times, manager)
    local view: Span[T] = made.getview()

    if values.count == 0
        return made
    else
        each i in 0 til times
            view.getslot(i * values.count).copy(src: values.data, count: values.count)
        then
            return made

### `construct`, returning an error instead of crashing when the manager has no memory to give.
### :param count: The number of values.
### :param manager: Where the memory comes from and goes back to.
### :returns: The memory.
### :throws: Returns `AllocFailed` when the manager has no memory to give.
@expensive("allocates memory")
routine Memory[T].construct_result(count: U64, manager: @MemoryManager) -> Result[Me, AllocFailed]
needs T: typename
    if count == 0
        return Me(data: null, count: 0, manager, generation: 0)
    data, generation = take_block[T](count, manager)
    if data.is_null()
        return AllocFailed()
    return Me(data, count, manager, generation)

### The number of values.
### :returns: The count.
routine Memory[T].count(me: @Me) -> U64
needs T: typename
    return me.count.peek()

### The values as a view, after checking that the memory is still there: what lending passes.
### :returns: A span over the same values, valid until the memory is dropped or resized.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped or moved, and with `InvalidValueError` when
###     it is hollow.
@track_caller
routine Memory[T].getview(me: @Me) -> Span[T]
needs T: typename
    data: @T = me.data.peek()
    count: U64 = me.count.peek()
    if count == 0
        return Span[T].construct(data, count: 0)
    check_generation[T](data, generation: me.generation.peek())
    return Span[T].construct(data, count)

### The address of the first value, after checking that the memory is still there: a window valid until the memory
### is dropped or resized.
### :returns: `data`, null for an empty memory.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped or moved.
@track_caller
routine Memory[T].to[@T](me: @Me) -> @T
needs T: typename
    return me.getview().data

### The value at `index`, after checking the memory and the index.
### :param index: The zero-based position.
### :returns: A copy of the value.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped or moved, and with `IndexOutOfBoundsError`
###     when `index >= count`.
@track_caller
routine Memory[T].load(me: @Me, index: U64) -> T
needs T: typename
    return me.getview()[index]

### Writes `value` at `index`, after checking the memory and the index.
### :param index: The zero-based position.
### :param value: The value to write, taken over.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped or moved, and with `IndexOutOfBoundsError`
###     when `index >= count`.
@track_caller
routine Memory[T].store(me: @Me, index: U64, value: T) -> None
needs T: typename
    me.getview().getslot(index).poke(steal value)
    return

### The address of the value at `index`, after checking the memory and the index: a window valid until the memory is
### dropped or resized.
### :param index: The zero-based position.
### :returns: The value's address.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped or moved, and with `IndexOutOfBoundsError`
###     when `index >= count`.
@track_caller
routine Memory[T].getslot(me: @Me, index: U64) -> @T
needs T: typename
    return me.getview().getslot(index)

### Exchanges the values at `first` and `second` in place, after checking the memory and both indices. Each value is
### moved, never copied, so entity values swap too, and neither place is left hollow. The same index twice changes
### nothing.
### :param first: The zero-based position of one value.
### :param second: The zero-based position of the other value.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped or moved, and with `IndexOutOfBoundsError`
###     when `first >= count` or `second >= count`.
@track_caller
routine Memory[T].swap(me: @Me, first: U64, second: U64) -> None
needs T: typename
    me.getview().swap(first, second)
    return

### Keeps only the first `count` values in use: no copy and no reallocation, for a buffer filled with less than it
### holds.
### :param count: How many of the values are in use, at most `count()`.
### :throws: Crashes with `IndexOutOfBoundsError` when `count` is more than the memory holds.
@track_caller
routine Memory[T].keep_first(me: @Me, count: U64) -> None
needs T: typename
    if count > me.count.peek()
        crash_out_of_bounds()
    count.poke_into(me.count)
    return

### A copy in memory of its own from the same manager, released on its own. The values are copied bit for bit.
### :returns: The copy.
### :throws: Crashes with `DestructedMemoryError` when the memory was dropped, and with `MemoryAllocationError` when the
###     manager has no memory to give.
@track_caller
@expensive("allocates memory")
routine Memory[T].duplicate(me: @Me) -> Me
needs T: typename
    local view: Span[T] = me.getview()
    local copy: @Me <- Me.construct(count: view.count, manager: me.manager.peek())

    if view.count == 0
        return copy
    copy.data.peek().copy(src: view.data, count: view.count)
    return copy

### Holds `count` values from here on, keeping the first ones (as many as both counts allow). The memory may move, so
### it gets a new generation: views, addresses, and copies taken before no longer pass the check. A count of 0 gives
### the memory back and keeps the manager.
### :param count: The new number of values.
### :throws: Crashes with `MemoryAllocationError` when the manager has no memory to give. See
###     {Memory[T].resize_result}.
@track_caller
@expensive("reallocates memory")
@reshaping
routine Memory[T].resize(me: @Me, count: U64) -> None
needs T: typename
    resized: Result[None, AllocFailed] = me.resize_result(count)
    when resized
        is None => return
        is AllocFailed => crash_allocation()

### `resize`, returning an error instead of crashing when the manager has no memory to give. The memory is unchanged
### then.
### :param count: The new number of values.
### :returns: None once the memory holds `count` values.
### :throws: Crashes with `DestructedMemoryError` when the memory was given back already, and with `InvalidValueError` on a
###     hollow memory (no manager). Returns `AllocFailed` when the manager has no memory to give.
@track_caller
@expensive("reallocates memory")
@reshaping
routine Memory[T].resize_result(me: @Me, count: U64) -> Result[None, AllocFailed]
needs T: typename
    local manager: @MemoryManager = me.manager.peek()
    local data: @T = me.data.peek()

    if manager.is_null()
        crash(name: "InvalidValueError",
            message: "This memory is hollow (it has no manager), so it can't be resized.")
    if count == 0
        drop me
        me.manager.poke(manager)
        return None()
    else if data.is_null()
        when Me.construct_result(count, manager)
            is Me as memory =>
                me.poke(steal memory)
                return None()
            is AllocFailed => return AllocFailed()
    else
        check_generation[T](data, generation: me.generation.peek())
        room: U64 = stamp_room[T]()
        raw: Addr = data
        grown: Addr = manager.realloc(at: raw.offset(-room.to[S64]()),
            size: sizeof[T]() * count + room, align: room)
        if grown.is_null()
            return AllocFailed()
        moved: @T = grown.offset(room.to[S64]()).to[@T]()
        generation: U64 = next_generation()
        generation.poke_into(stamp_of[T](moved).generation)
        me.poke(Me(data: moved, count, manager, generation))
        return None()

### Gives the memory back to its manager and leaves the value hollow. Does nothing on a hollow or empty value. The
### values themselves are not destructed: see `destruct_all`.
### :throws: Crashes with `DestructedMemoryError` when the memory was given back already through another copy.
@track_caller
routine Memory[T].destruct(me: @Me) -> None
needs T: typename
    data: @T = me.data.peek()
    if not data.is_null()
        check_generation[T](data, generation: me.generation.peek())
        give_block[T](data, manager: me.manager.peek())
    me.poke(.hollow())
    return

### Gives the memory back and puts `value` in its place: how a global that holds memory changes (the program's end
### gives the last one back).
### :param value: The memory that takes its place, taken over.
### :throws: Crashes with `DestructedMemoryError` when the memory was given back already through another copy.
@track_caller
routine Memory[T].replace(me: @Me, value: Me) -> None
needs T: typename
    drop me
    me.poke(steal value)
    return

### Gives the memory back and keeps the manager: it holds nothing afterward, and a `resize` draws from the same manager
### again. What a collection's `destruct` does with its storage. Nothing on a hollow or empty value.
### :throws: Crashes with `DestructedMemoryError` when the memory was given back already through another copy.
@track_caller
routine Memory[T].give_back(me: @Me) -> None
needs T: typename
    manager: @MemoryManager = me.manager.peek()
    drop me
    me.manager.poke(manager)
    return

### Moves the memory out to the caller and leaves this one holding nothing, with the same manager: a `resize` draws
### from it again.
### :returns: The memory that was here, which the caller drops.
routine Memory[T].take(me: @Me) -> Me
needs T: typename
    local taken: @Me <- steal me.stride(0)

    me.poke(.hollow())
    me.manager.poke(taken.manager.peek())
    return taken

### Destructs every value, then drops the memory: for values that hold something, such as lists. Every value must be
### initialized.
### :throws: Crashes with `DestructedMemoryError` when the memory was given back already through another copy.
@track_caller
routine Memory[T].destruct_all(me: @Me) -> None
needs T: typename, Destructible[T]
    local view: Span[T] = me.getview()

    each i in 0 til view.count
        drop view.getslot(i)
    drop me
    return

# == Box[T] =======================================================================================================

### One value of `T` from a manager, released exactly once with `drop`. An entity: never copied, lent as a `@Box[T]`.
### `load` and `store` check that it hasn't been given back. Lend `getview()` where a `@T` is expected.
### :typeparam T: The value type.
entity Box[T]
needs T: typename
    at: @T
    manager: @MemoryManager
    generation: U64

### `value`, in memory from `manager`, given back with `drop`.
### :param value: The value, taken over.
### :param manager: Where the memory comes from and goes back to.
### :returns: The box.
### :throws: Crashes with `MemoryAllocationError` when the manager has no memory to give.
@track_caller
@expensive("allocates memory")
routine Box[T].construct(value: T, manager: @MemoryManager) -> Me
needs T: typename
    at, generation = take_block[T](count: 1, manager)
    if at.is_null()
        crash_allocation()
    at.poke(steal value)
    return Me(at, manager, generation)

### The value's address, after checking that the memory is still there: what lending passes.
### :returns: The address, valid until the box is dropped.
### :throws: Crashes with `DestructedMemoryError` when the box was dropped, and with `InvalidValueError` when it is hollow.
@track_caller
routine Box[T].getview(me: @Me) -> @T
needs T: typename
    at: @T = me.at.peek()
    check_generation[T](data: at, generation: me.generation.peek())
    return at

### The value, after checking that the box is still there.
### :returns: A copy of the value.
### :throws: Crashes with `DestructedMemoryError` when the box was dropped, and with `InvalidValueError` when it is hollow.
@track_caller
routine Box[T].load(me: @Me) -> T
needs T: typename
    return me.getview().peek()

### Writes `value` into the box, after checking that it is still there.
### :param value: The value to write, taken over.
### :throws: Crashes with `DestructedMemoryError` when the box was dropped, and with `InvalidValueError` when it is hollow.
@track_caller
routine Box[T].store(me: @Me, value: T) -> None
needs T: typename
    me.getview().poke(steal value)
    return

### The value in a box of its own from the same manager.
### :returns: The copy.
### :throws: Crashes with `DestructedMemoryError` when the box was dropped.
@track_caller
@expensive("allocates memory")
routine Box[T].duplicate(me: @Me) -> Me
needs T: typename
    return Me.construct(value: me.load(), manager: me.manager.peek())

### Gives the memory back to its manager and leaves the box hollow. Does nothing on a hollow box. The value itself
### is not destructed.
### :throws: Crashes with `DestructedMemoryError` when the box was given back already through another copy.
@track_caller
routine Box[T].destruct(me: @Me) -> None
needs T: typename
    at: @T = me.at.peek()
    if not at.is_null()
        check_generation[T](data: at, generation: me.generation.peek())
        give_block[T](data: at, manager: me.manager.peek())
    me.poke(.hollow())
    return

### Gives the memory back and puts `value` in its place: how a global that holds a box changes (the program's end
### gives the last one back).
### :param value: The box that takes its place, taken over.
### :throws: Crashes with `DestructedMemoryError` when the box was given back already through another copy.
@track_caller
routine Box[T].replace(me: @Me, value: Me) -> None
needs T: typename
    drop me
    me.poke(steal value)
    return
