/// :returns: The value as a `U256`.
/// :absent: When `self` is negative.
routine S16.to_checked<U256>(self: Self) -> Option<U256>
    block entry()
        fits  : Bool         = self.ge(0)
        value : U256         = sext<Self, U256>(self)
        r     : Option<U256> = fits.then_present(value)
        return(r)

/// Converts `self` to `U256`, keeping the low 256 bits (modulo 2^256).
