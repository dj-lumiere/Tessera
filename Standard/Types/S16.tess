        at_least : Self = smax<Self>(self, 0)
        r        : U256 = sext<Self, U256>(at_least)
        return(r)

/// Converts `self` to `F32`, rounding to nearest, ties to even.
/// :returns: The `F32` nearest to `self`.
routine S16.to<F32>(self: Self) -> F32
    block entry()
        r : F32 = sitofp<Self, F32>(self)
        return(r)

/// Converts `self` to `F64`, rounding to nearest, ties to even.
/// :returns: The `F64` nearest to `self`.
routine S16.to<F64>(self: Self) -> F64
    block entry()
        r : F64 = sitofp<Self, F64>(self)
        return(r)
