// Tessera stdlib: S16 — 16-bit signed integer
//
// Maps to LLVM IR i16. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// S16 is a 16-bit signed two's-complement integer. Arithmetic crashes on overflow, with `_checked`, `_wrap`, and `_clamp` forms for the other behaviors.
#llvm("i16")
record S16
conform Equatable<S16>, Comparable<S16>, Hashable<S16>

// -- constants -------------------------------------------------------------------

/// The smallest value a S16 can hold.
preset S16.MIN: S16 = -32768
/// The largest value a S16 can hold.
preset S16.MAX: S16 = 32767
/// The width of S16 in bits.
preset S16.BITS: S16 = 16

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine S16.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine S16.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine S16.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine S16.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: `BITS` minus the population count.
routine S16.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is -1.
routine S16.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is -1.
routine S16.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Reverses the order of the bytes of `self`.
/// :returns: The byte-swapped value.
routine S16.swap_bytes(self: Self) -> Self
    block entry()
        r : Self = bswap<Self>(self)
        return(r)

/// Converts from this target's byte order to big-endian, which swaps the bytes.
/// :returns: The value in big-endian byte order.
routine S16.to_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts from big-endian to this target's byte order, which swaps the bytes.
/// :returns: The value in native byte order.
routine S16.from_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts from this target's byte order to little-endian. The target is little-endian, so this returns `self` unchanged.
/// :returns: The value in little-endian byte order.
routine S16.to_le(self: Self) -> Self
    block entry()
        return(self)

/// Converts from little-endian to this target's byte order. The target is little-endian, so this returns `self` unchanged.
/// :returns: The value in native byte order.
routine S16.from_le(self: Self) -> Self
    block entry()
        return(self)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine S16.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine S16.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine S16.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise NOT: flips every bit of `self`.
/// :returns: The complement, which equals `-self - 1`.
routine S16.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0, and a negative amount counts as out of range too.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted left by `n`, or 0 when `n` is outside `0 ..< BITS`.
/// :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine S16.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, arithmetic: the sign bit fills in. A shift by `BITS` or more, or by a negative amount, gives the sign fill (0 or -1).
/// :param n: The shift amount in bits.
/// :returns: `self` shifted right by `n`, or the sign fill when `n` is outside `0 ..< BITS`.
routine S16.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        shifted  : Self = ashr<Self>(self, n)
        out      : Self = ashr<Self>(self, Self.BITS.sub(1))
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine S16.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine S16.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted left by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine S16.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Arithmetic shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted right by `n`, with the sign bit filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine S16.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = ashr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted left, with 0 bits filling in.
routine S16.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 15)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Arithmetic shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of saturating.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted right with the sign bit filling in.
routine S16.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 15)
        r      : Self = ashr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `self` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in `S16`.
#track_caller
routine S16.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = sadd_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in `S16`.
routine S16.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = sadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The sum of `self` and `other`, wrapped modulo 2^16.
/// :param other: The value to add.
/// :returns: The low 16 bits of the exact sum.
routine S16.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// The sum of `self` and `other`, saturated at `MIN` / `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MIN` / `MAX` when the exact sum is below / above the range.
routine S16.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = sadd_sat<Self>(self, other)
        return(r)

/// The difference of `self` and `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `IntegerOverflowError` when the difference does not fit in `S16`.
#track_caller
routine S16.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = ssub_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in `S16`.
routine S16.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = ssub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The difference of `self` and `other`, wrapped modulo 2^16.
/// :param other: The value to subtract.
/// :returns: The low 16 bits of the exact difference.
routine S16.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// The difference of `self` and `other`, saturated at `MIN` / `MAX`.
/// :param other: The value to subtract.
/// :returns: The difference, or `MIN` / `MAX` when the exact difference is below / above the range.
routine S16.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = ssub_sat<Self>(self, other)
        return(r)

/// The product of `self` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in `S16`.
#track_caller
routine S16.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = smul_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in `S16`.
routine S16.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = smul_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The product of `self` and `other`, wrapped modulo 2^16.
/// :param other: The factor to multiply by.
/// :returns: The low 16 bits of the exact product.
routine S16.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// The product of `self` and `other`, saturated at `MIN` / `MAX` by the sign of the exact product.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MIN` / `MAX` when the exact product does not fit.
routine S16.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow        : Bool = self.mul_overflows(other)
        negative_result : Bool = self.bitxor(other).lt(0)
        limit           : Self = negative_result
            ? Self.MIN
            : Self.MAX
        product : Self = mul<Self>(self, other)
        r       : Self = overflow
            ? limit
            : product
        return(r)

/// Tests whether the exact product of `self` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in `S16`.
routine S16.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = smul_overflows<Self>(self, other)
        return(r)

/// The exact product of `self` and `other` in twice the width. It never overflows.
/// :param other: The factor to multiply by.
/// :returns: The product as an `S32`.
routine S16.mul_wide(self: Self, other: Self) -> S32
    block entry()
        r : S32 = self.to<S32>().mul_wrap(other.to<S32>())
        return(r)

// -- sign ------------------------------------------------------------------------

/// The negation of `self`.
/// :returns: `-self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is `MIN`, whose negation does not fit.
#track_caller
routine S16.neg(self: Self) -> Self
    block entry()
        is_min : Bool = self.eq(Self.MIN)
        branch is_min
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(0, self)
        return(r)

/// Negation that reports overflow.
/// :returns: `-self`.
/// :absent: When `self` is `MIN`, whose negation does not fit.
routine S16.neg_checked(self: Self) -> Option<Self>
    block entry()
        fits    : Bool         = self.ne(Self.MIN)
        negated : Self         = sub<Self>(0, self)
        r       : Option<Self> = fits.then_present(negated)
        return(r)

/// The negation of `self`, wrapped modulo 2^16, so `MIN.neg_wrap()` is `MIN`.
/// :returns: `-self`, or `MIN` when `self` is `MIN`.
routine S16.neg_wrap(self: Self) -> Self
    block entry()
        r : Self = sub<Self>(0, self)
        return(r)

/// The negation of `self`, saturated at `MAX`, so `MIN.neg_clamp()` is `MAX`.
/// :returns: `-self`, or `MAX` when `self` is `MIN`.
routine S16.neg_clamp(self: Self) -> Self
    block entry()
        r : Self = ssub_sat<Self>(0, self)
        return(r)

/// The absolute value of `self`.
/// :returns: The magnitude of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is `MIN`, whose magnitude does not fit.
#track_caller
routine S16.abs(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? continue
            : return(self)
        r : Self = self.neg()
        return(r)

/// Absolute value that reports overflow.
/// :returns: The magnitude of `self`.
/// :absent: When `self` is `MIN`, whose magnitude does not fit.
routine S16.abs_checked(self: Self) -> Option<Self>
    block entry()
        fits      : Bool         = self.ne(Self.MIN)
        magnitude : Self         = self.abs_wrap()
        r         : Option<Self> = fits.then_present(magnitude)
        return(r)

/// The absolute value of `self`, wrapped modulo 2^16, so `MIN.abs_wrap()` is `MIN`.
/// :returns: The magnitude of `self`, or `MIN` when `self` is `MIN`.
routine S16.abs_wrap(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        negated  : Self = sub<Self>(0, self)
        r        : Self = negative
            ? negated
            : self
        return(r)

/// The absolute value of `self`, saturated at `MAX`, so `MIN.abs_clamp()` is `MAX`.
/// :returns: The magnitude of `self`, or `MAX` when `self` is `MIN`.
routine S16.abs_clamp(self: Self) -> Self
    block entry()
        is_min    : Bool = self.eq(Self.MIN)
        magnitude : Self = self.abs_wrap()
        r         : Self = is_min
            ? Self.MAX
            : magnitude
        return(r)

/// The sign of `self`.
/// :returns: -1 when `self` is negative, 0 when it is 0, and 1 when it is positive.
routine S16.signum(self: Self) -> Self
    block entry()
        negative     : Bool = self.lt(0)
        positive     : Bool = self.gt(0)
        non_negative : Self = positive
            ? 1
            : 0
        r : Self = negative
            ? -1
            : non_negative
        return(r)

/// Tests whether `self` is below zero.
/// :returns: True when `self < 0`.
routine S16.is_negative(self: Self) -> Bool
    block entry()
        r : Bool = self.lt(0)
        return(r)

/// Tests whether `self` is above zero.
/// :returns: True when `self > 0`.
routine S16.is_positive(self: Self) -> Bool
    block entry()
        r : Bool = self.gt(0)
        return(r)

// -- division --------------------------------------------------------------------

/// The quotient of `self` divided by `other`, truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.div(-1)`.
#track_caller
routine S16.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sdiv<Self>(self, other)
        return(r)

/// The remainder of `self` divided by `other`. It has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder, with the sign of `self`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.mod(-1)`.
#track_caller
routine S16.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = srem<Self>(self, other)
        return(r)

/// Division that reports failure instead of crashing. The quotient is truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient of `self` divided by `other`.
/// :absent: On a zero divisor and on `MIN.div_checked(-1)`.
routine S16.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Self>.Absent)
            : continue
        r : Self = sdiv<Self>(self, other)
        return(Option<Self>.Present(r))

/// Remainder that reports failure instead of crashing. The result has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder of `self` divided by `other`.
/// :absent: On a zero divisor and on `MIN.mod_checked(-1)`.
routine S16.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Self>.Absent)
            : continue
        r : Self = srem<Self>(self, other)
        return(Option<Self>.Present(r))

/// The quotient of `self` divided by `other`, truncated toward zero. `MIN.div_wrap(-1)` wraps to `MIN`.
/// :param other: The divisor.
/// :returns: The quotient, or `MIN` for `MIN.div_wrap(-1)`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine S16.div_wrap(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(Self.MIN)
            : continue
        r : Self = sdiv<Self>(self, other)
        return(r)

/// The remainder of `self` divided by `other`, with the dividend's sign. `MIN.mod_wrap(-1)` is 0.
/// :param other: The divisor.
/// :returns: The remainder, or 0 for `MIN.mod_wrap(-1)`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine S16.mod_wrap(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(0)
            : continue
        r : Self = srem<Self>(self, other)
        return(r)

/// The quotient of Euclidean division, chosen so the remainder is never negative.
/// :param other: The divisor.
/// :returns: The quotient `q` for which `self - q * other` is in `0 ..< |other|`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.div_euclid(-1)`.
#track_caller
routine S16.div_euclid(self: Self, other: Self) -> Self
    shared q : Self = self.div(other)

    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0)
        branch positive_divisor
            ? down()
            : up()

    block down()
        r : Self = q.sub(1)
        return(r)

    block up()
        r : Self = q.add(1)
        return(r)

/// The remainder of Euclidean division, always in `0 ..< |other|`.
/// :param other: The divisor.
/// :returns: The remainder, never negative.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.mod_euclid(-1)`.
#track_caller
routine S16.mod_euclid(self: Self, other: Self) -> Self
    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Self = other.abs_wrap()
        r         : Self = add<Self>(rem, magnitude)
        return(r)

// -- powers ----------------------------------------------------------------------

/// Raises `self` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `self` to the power `exponent`.
/// :throws: Crashes with `IntegerOverflowError` when the exact power does not fit in `S16`.
#track_caller
routine S16.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `self` to the power `exponent` by squaring, wrapping modulo 2^16.
/// :param exponent: The power to raise to.
/// :returns: The low 16 bits of the exact power.
routine S16.pow_wrap(self: Self, exponent: U32) -> Self
    shared base : @Self <- self
    shared acc  : @Self <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc.load(), base.load())
        next_acc  : Self = odd
            ? with_base
            : acc.load()
        next_acc2 : Self = next_acc
        next_base : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Power that reports overflow.
/// :param exponent: The power to raise to.
/// :returns: `self` to the power `exponent`.
/// :absent: When the exact power does not fit in `S16`.
routine S16.pow_checked(self: Self, exponent: U32) -> Option<Self>
    shared base     : @Self <- self
    shared acc      : @Self <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = smul_overflows<Self>(acc.load(), base.load()).bitand(odd)
        with_base    : Self = mul<Self>(acc.load(), base.load())
        next_acc     : Self = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = smul_overflows<Self>(base.load(), base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Self = next_acc
        next_base     : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool         = overflow.load().bitnot()
        r    : Option<Self> = fits.then_present(acc.load())
        return(r)

/// Raises `self` to the power `exponent`, saturated at `MIN` or `MAX` by the sign the exact power would have.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MIN` / `MAX` when the exact power does not fit.
routine S16.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        odd_exp         : Bool = exponent.bitand(1).ne(0)
        negative_result : Bool = self.lt(0).bitand(odd_exp)
        limit           : Self = negative_result
            ? Self.MIN
            : Self.MAX
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(limit)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `self` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine S16.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Tests whether `self` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine S16.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Signed less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self < other`.
#[external("llvm"), template("{result} = icmp slt i16 {self}, {other}")]
routine S16.lt(self: Self, other: Self) -> Bool

/// Signed less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self <= other`.
#[external("llvm"), template("{result} = icmp sle i16 {self}, {other}")]
routine S16.le(self: Self, other: Self) -> Bool

/// Signed greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self > other`.
#[external("llvm"), template("{result} = icmp sgt i16 {self}, {other}")]
routine S16.gt(self: Self, other: Self) -> Bool

/// Signed greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self >= other`.
#[external("llvm"), template("{result} = icmp sge i16 {self}, {other}")]
routine S16.ge(self: Self, other: Self) -> Bool

/// Compares `self` with `other` by signed order.
/// :param other: The value to compare with.
/// :returns: -1 when `self < other`, 0 when they are equal, and 1 when `self > other`.
routine S16.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is smaller.
routine S16.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = smin<Self>(self, other)
        return(r)

/// Returns the larger of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is larger.
routine S16.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = smax<Self>(self, other)
        return(r)

/// Limits `self` to the range from `lo` to `hi`, both ends included.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `self < lo`, `hi` when `self > hi`, otherwise `self`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine S16.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Self = smax<Self>(self, lo)
        r           : Self = smin<Self>(at_least_lo, hi)
        return(r)

/// Tests whether `self` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= self <= hi`.
routine S16.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// Tests whether `self` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= self < end`.
routine S16.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the bits widened to 64, under the process key, the same hash for `S16` and `U16`.
/// :returns: The 64-bit hash of `self`.
routine S16.hash(self: Self) -> U64
    block entry()
        bits : U16 = bitcast<Self, U16>(self)
        h    : U64 = siphash24(bits.to<U64>(), hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `self` and `other`, `|self - other|`, which always fits in `U16`.
/// :param other: The value to measure from.
/// :returns: `|self - other|` as a `U16`.
routine S16.abs_diff(self: Self, other: Self) -> U16
    block entry()
        hi   : Self = smax<Self>(self, other)
        lo   : Self = smin<Self>(self, other)
        diff : Self = sub<Self>(hi, lo)
        r    : U16  = bitcast<Self, U16>(diff)
        return(r)

/// The average of `self` and `other`, rounded toward zero, computed without overflow.
/// :param other: The other value.
/// :returns: `(self + other) / 2`, rounded toward zero.
routine S16.midpoint(self: Self, other: Self) -> Self
    block entry()
        common       : Self = self.bitand(other)
        half_diff    : Self = self.bitxor(other).shr(1)
        rounded_down : Self = add<Self>(common, half_diff)
        parity       : Self = self.bitxor(other).bitand(1)
        odd_sum      : Bool = parity.ne(0)
        round_up     : Bool = odd_sum.bitand(rounded_down.lt(0))
        up           : Self = add<Self>(rounded_down, 1)
        r            : Self = round_up
            ? up
            : rounded_down
        return(r)

/// The base-2 logarithm of `self`, rounded down.
/// :returns: `floor(log2(self))`.
/// :throws: Crashes with `NumericDomainError` when `self <= 0`.
#track_caller
routine S16.ilog2(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U16, Self>(bitcast<Self, U16>(self).ilog2())
        return(r)

/// The base-10 logarithm of `self`, rounded down.
/// :returns: `floor(log10(self))`.
/// :throws: Crashes with `NumericDomainError` when `self <= 0`.
#track_caller
routine S16.ilog10(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U16, Self>(bitcast<Self, U16>(self).ilog10())
        return(r)

/// The integer square root of `self`, rounded down.
/// :returns: `floor(sqrt(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is negative.
#track_caller
routine S16.isqrt(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? crash_numeric_domain()
            : continue
        r : Self = bitcast<U16, Self>(bitcast<Self, U16>(self).isqrt())
        return(r)

// -- conversions -----------------------------------------------------------------

/// Converts `self` to `S8`.
/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// :returns: The same numeric value as an `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine S16.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.between(-128, 127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8` when the value fits.
/// :returns: The value as an `S8`.
/// :absent: When `self` is outside the range of `S8`.
routine S16.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.between(-128, 127)
        value : S8         = trunc<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `self` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: `self` modulo 2^8, as an `S8`.
routine S16.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8`, saturating at `S8`'s range.
/// :returns: `self`, or the nearest end of `S8`'s range when it does not fit.
routine S16.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_least : Self = smax<Self>(self, -128)
        at_most  : Self = smin<Self>(at_least, 127)
        r        : S8   = trunc<Self, S8>(at_most)
        return(r)

/// The identity conversion: returns `self` unchanged.
/// :returns: `self` as `S16`.
routine S16.to<Self>(self: Self) -> Self
    block entry()
        return(self)

/// Sign-extends `self` to `S32`. Every `S16` value fits, so this never fails.
/// :returns: The same numeric value as an `S32`.
routine S16.to<S32>(self: Self) -> S32
    block entry()
        r : S32 = sext<Self, S32>(self)
        return(r)

/// Sign-extends `self` to `S64`. Every `S16` value fits, so this never fails.
/// :returns: The same numeric value as an `S64`.
routine S16.to<S64>(self: Self) -> S64
    block entry()
        r : S64 = sext<Self, S64>(self)
        return(r)

/// Sign-extends `self` to `S128`. Every `S16` value fits, so this never fails.
/// :returns: The same numeric value as an `S128`.
routine S16.to<S128>(self: Self) -> S128
    block entry()
        r : S128 = sext<Self, S128>(self)
        return(r)

/// Sign-extends `self` to `S256`. Every `S16` value fits, so this never fails.
/// :returns: The same numeric value as an `S256`.
routine S16.to<S256>(self: Self) -> S256
    block entry()
        r : S256 = sext<Self, S256>(self)
        return(r)

/// Converts `self` to `U8`.
/// :returns: The same numeric value as a `U8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U8`.
#track_caller
routine S16.to<U8>(self: Self) -> U8
    block entry()
        fits : Bool = self.between(0, 255)
        branch fits
            ? continue
            : crash_overflow()
        r : U8 = trunc<Self, U8>(self)
        return(r)

/// Converts `self` to `U8` when the value fits.
/// :returns: The value as a `U8`.
/// :absent: When `self` is negative or above the largest `U8`.
routine S16.to_checked<U8>(self: Self) -> Option<U8>
    block entry()
        fits  : Bool       = self.between(0, 255)
        value : U8         = trunc<Self, U8>(self)
        r     : Option<U8> = fits.then_present(value)
        return(r)

/// Converts `self` to `U8`, keeping the low 8 bits (modulo 2^8).
/// :returns: `self` modulo 2^8, as a `U8`.
routine S16.to_wrap<U8>(self: Self) -> U8
    block entry()
        r : U8 = trunc<Self, U8>(self)
        return(r)

/// Converts `self` to `U8`, saturating at `U8`'s range.
/// :returns: `self`, or the nearest end of `U8`'s range when it does not fit.
routine S16.to_clamp<U8>(self: Self) -> U8
    block entry()
        at_least : Self = smax<Self>(self, 0)
        at_most  : Self = smin<Self>(at_least, 255)
        r        : U8   = trunc<Self, U8>(at_most)
        return(r)

/// Converts `self` to `U16`.
/// :returns: The same numeric value as a `U16`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U16`.
#track_caller
routine S16.to<U16>(self: Self) -> U16
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U16 = bitcast<Self, U16>(self)
        return(r)

/// Converts `self` to `U16` when the value fits.
/// :returns: The value as a `U16`.
/// :absent: When `self` is negative.
routine S16.to_checked<U16>(self: Self) -> Option<U16>
    block entry()
        fits  : Bool        = self.ge(0)
        value : U16         = bitcast<Self, U16>(self)
        r     : Option<U16> = fits.then_present(value)
        return(r)

/// Converts `self` to `U16`, keeping the low 16 bits (modulo 2^16).
/// :returns: `self` modulo 2^16, as a `U16`.
routine S16.to_wrap<U16>(self: Self) -> U16
    block entry()
        r : U16 = bitcast<Self, U16>(self)
        return(r)

/// Converts `self` to `U16`, saturating at `U16`'s range.
/// :returns: `self`, or the nearest end of `U16`'s range when it does not fit.
routine S16.to_clamp<U16>(self: Self) -> U16
    block entry()
        at_least : Self = smax<Self>(self, 0)
        r        : U16  = bitcast<Self, U16>(at_least)
        return(r)

/// Converts `self` to `U32`.
/// :returns: The same numeric value as a `U32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U32`.
#track_caller
routine S16.to<U32>(self: Self) -> U32
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U32 = sext<Self, U32>(self)
        return(r)

/// Converts `self` to `U32` when the value fits.
/// :returns: The value as a `U32`.
/// :absent: When `self` is negative.
routine S16.to_checked<U32>(self: Self) -> Option<U32>
    block entry()
        fits  : Bool        = self.ge(0)
        value : U32         = sext<Self, U32>(self)
        r     : Option<U32> = fits.then_present(value)
        return(r)

/// Converts `self` to `U32`, keeping the low 32 bits (modulo 2^32).
/// :returns: `self` modulo 2^32, as a `U32`.
routine S16.to_wrap<U32>(self: Self) -> U32
    block entry()
        r : U32 = sext<Self, U32>(self)
        return(r)

/// Converts `self` to `U32`, saturating at `U32`'s range.
/// :returns: `self`, or the nearest end of `U32`'s range when it does not fit.
routine S16.to_clamp<U32>(self: Self) -> U32
    block entry()
        at_least : Self = smax<Self>(self, 0)
        r        : U32  = sext<Self, U32>(at_least)
        return(r)

/// Converts `self` to `U64`.
/// :returns: The same numeric value as a `U64`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U64`.
#track_caller
routine S16.to<U64>(self: Self) -> U64
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U64 = sext<Self, U64>(self)
        return(r)

/// Converts `self` to `U64` when the value fits.
/// :returns: The value as a `U64`.
/// :absent: When `self` is negative.
routine S16.to_checked<U64>(self: Self) -> Option<U64>
    block entry()
        fits  : Bool        = self.ge(0)
        value : U64         = sext<Self, U64>(self)
        r     : Option<U64> = fits.then_present(value)
        return(r)

/// Converts `self` to `U64`, keeping the low 64 bits (modulo 2^64).
/// :returns: `self` modulo 2^64, as a `U64`.
routine S16.to_wrap<U64>(self: Self) -> U64
    block entry()
        r : U64 = sext<Self, U64>(self)
        return(r)

/// Converts `self` to `U64`, saturating at `U64`'s range.
/// :returns: `self`, or the nearest end of `U64`'s range when it does not fit.
routine S16.to_clamp<U64>(self: Self) -> U64
    block entry()
        at_least : Self = smax<Self>(self, 0)
        r        : U64  = sext<Self, U64>(at_least)
        return(r)

/// Converts `self` to `U128`.
/// :returns: The same numeric value as a `U128`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U128`.
#track_caller
routine S16.to<U128>(self: Self) -> U128
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U128 = sext<Self, U128>(self)
        return(r)

/// Converts `self` to `U128` when the value fits.
/// :returns: The value as a `U128`.
/// :absent: When `self` is negative.
routine S16.to_checked<U128>(self: Self) -> Option<U128>
    block entry()
        fits  : Bool         = self.ge(0)
        value : U128         = sext<Self, U128>(self)
        r     : Option<U128> = fits.then_present(value)
        return(r)

/// Converts `self` to `U128`, keeping the low 128 bits (modulo 2^128).
/// :returns: `self` modulo 2^128, as a `U128`.
routine S16.to_wrap<U128>(self: Self) -> U128
    block entry()
        r : U128 = sext<Self, U128>(self)
        return(r)

/// Converts `self` to `U128`, saturating at `U128`'s range.
/// :returns: `self`, or the nearest end of `U128`'s range when it does not fit.
routine S16.to_clamp<U128>(self: Self) -> U128
