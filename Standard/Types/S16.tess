        return(r)

/// Converts `self` to `U256`.
/// :returns: The same numeric value as a `U256`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U256`.
#track_caller
routine S16.to<U256>(self: Self) -> U256
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U256 = sext<Self, U256>(self)
        return(r)

