// Tessera stdlib: SSize — the target's pointer-width signed integer
//
// For pointer offsets and differences, and other signed counts. It is S16, S32, or S64 underneath, by the target's
// pointer width, but a type of its own on every target: it never mixes with
// a fixed-width integer without a to<T>() call, so a program type-checks
// the same way everywhere. Every method has the same signature on every
// target. A conversion that can lose the value on some target has its
// _checked / _wrap / _clamp forms on all of them.
//
// The method set mirrors S32.tess and S64.tess.

module Standard::Core

/// SSize is the target's pointer-width signed integer, for offsets and signed counts. It is S16, S32, or S64 underneath, but a distinct type that never mixes with a fixed-width integer without a `to<T>()` call.
record SSize
conform Equatable<SSize>, Comparable<SSize>, Hashable<SSize>

// -- constants -------------------------------------------------------------------

/// The smallest value a SSize can hold.
#target(size: 64)
preset SSize.MIN: SSize = -9223372036854775808

/// The smallest value a SSize can hold.
#target(size: 32)
preset SSize.MIN: SSize = -2147483648

/// The largest value a SSize can hold.
#target(size: 64)
preset SSize.MAX: SSize = 9223372036854775807

/// The largest value a SSize can hold.
#target(size: 32)
preset SSize.MAX: SSize = 2147483647

/// The width of SSize in bits.
#target(size: 64)
preset SSize.BITS: SSize = 64

/// The width of SSize in bits.
#target(size: 32)
preset SSize.BITS: SSize = 32

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine SSize.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine SSize.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine SSize.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine SSize.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: `BITS` minus the population count.
routine SSize.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is -1.
routine SSize.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is -1.
routine SSize.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Reverses the order of the bytes of `self`.
/// :returns: The byte-swapped value.
routine SSize.swap_bytes(self: Self) -> Self
    block entry()
        r : Self = bswap<Self>(self)
        return(r)

/// Converts from this target's byte order to big-endian, which swaps the bytes.
/// :returns: The value in big-endian byte order.
routine SSize.to_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts from big-endian to this target's byte order, which swaps the bytes.
/// :returns: The value in native byte order.
routine SSize.from_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts from this target's byte order to little-endian. The target is little-endian, so this returns `self` unchanged.
/// :returns: The value in little-endian byte order.
routine SSize.to_le(self: Self) -> Self
    block entry()
        return(self)

/// Converts from little-endian to this target's byte order. The target is little-endian, so this returns `self` unchanged.
/// :returns: The value in native byte order.
routine SSize.from_le(self: Self) -> Self
    block entry()
        return(self)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine SSize.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine SSize.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine SSize.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise NOT: flips every bit of `self`.
/// :returns: The complement, which equals `-self - 1`.
routine SSize.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts `self` left by `n` bits, zeros filling in. A shift by `BITS` or more shifts every bit out and gives 0, and so does a negative `n`.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
routine SSize.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shifts `self` right by `n` bits, arithmetic: the sign bit fills in. A shift by `BITS` or more, or a negative `n`, gives the sign fill (0 or -1).
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
routine SSize.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        shifted  : Self = ashr<Self>(self, n)
        out      : Self = ashr<Self>(self, Self.BITS.sub(1))
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine SSize.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine SSize.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted left by `n`, zeros filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine SSize.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Arithmetic shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted right by `n`, with the sign bit filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine SSize.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = ashr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts `self` left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted left, zeros filling in.
#target(size: 64)
routine SSize.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 63)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Shifts `self` left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted left, zeros filling in.
#target(size: 32)
routine SSize.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 31)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Arithmetic shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of saturating.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted right with the sign bit filling in.
#target(size: 64)
routine SSize.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 63)
        r      : Self = ashr<Self>(self, amount)
        return(r)

/// Arithmetic shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of saturating.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted right with the sign bit filling in.
#target(size: 32)
routine SSize.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 31)
        r      : Self = ashr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `self` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in SSize.
#track_caller
routine SSize.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = sadd_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in SSize.
routine SSize.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = sadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The sum of `self` and `other`, wrapping modulo 2^BITS.
/// :param other: The value to add.
/// :returns: The sum modulo 2^BITS.
routine SSize.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// The sum of `self` and `other`, saturating at `MIN` / `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MIN` / `MAX` when the exact sum is out of range.
routine SSize.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = sadd_sat<Self>(self, other)
        return(r)

/// The difference of `self` and `other`.
/// :param other: The value to subtract.
/// :returns: `self - other`.
/// :throws: Crashes with `IntegerOverflowError` when the difference does not fit in SSize.
#track_caller
routine SSize.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = ssub_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in SSize.
routine SSize.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = ssub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The difference of `self` and `other`, wrapping modulo 2^BITS.
/// :param other: The value to subtract.
/// :returns: `self - other` modulo 2^BITS.
routine SSize.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// The difference of `self` and `other`, saturating at `MIN` / `MAX`.
/// :param other: The value to subtract.
/// :returns: `self - other`, or `MIN` / `MAX` when the exact difference is out of range.
routine SSize.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = ssub_sat<Self>(self, other)
        return(r)

/// The product of `self` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in SSize.
#track_caller
routine SSize.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = smul_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in SSize.
routine SSize.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = smul_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The product of `self` and `other`, wrapping modulo 2^BITS.
/// :param other: The factor to multiply by.
/// :returns: The product modulo 2^BITS.
routine SSize.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// The product of `self` and `other`, saturating at `MIN` / `MAX` by the sign of the exact product.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MIN` / `MAX` when the exact product is out of range.
routine SSize.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow        : Bool = self.mul_overflows(other)
        negative_result : Bool = self.bitxor(other).lt(0)
        limit           : Self = negative_result
            ? Self.MIN
            : Self.MAX
        product : Self = mul<Self>(self, other)
        r       : Self = overflow
            ? limit
            : product
        return(r)

/// Tests whether the exact product of `self` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in SSize.
routine SSize.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = smul_overflows<Self>(self, other)
        return(r)

// -- sign ------------------------------------------------------------------------

/// The negation of `self`.
/// :returns: `-self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is `MIN`, whose negation does not fit.
#track_caller
routine SSize.neg(self: Self) -> Self
    block entry()
        is_min : Bool = self.eq(Self.MIN)
        branch is_min
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(0, self)
        return(r)

/// Negation that reports overflow.
/// :returns: `-self`.
/// :absent: When `self` is `MIN`, whose negation does not fit.
routine SSize.neg_checked(self: Self) -> Option<Self>
    block entry()
        fits    : Bool         = self.ne(Self.MIN)
        negated : Self         = sub<Self>(0, self)
        r       : Option<Self> = fits.then_present(negated)
        return(r)

/// The negation of `self`, wrapping modulo 2^BITS, so `MIN.neg_wrap()` is `MIN`.
/// :returns: `-self`, or `MIN` when `self` is `MIN`.
routine SSize.neg_wrap(self: Self) -> Self
    block entry()
        r : Self = sub<Self>(0, self)
        return(r)

/// The negation of `self`, saturating, so `MIN.neg_clamp()` is `MAX`.
/// :returns: `-self`, or `MAX` when `self` is `MIN`.
routine SSize.neg_clamp(self: Self) -> Self
    block entry()
        r : Self = ssub_sat<Self>(0, self)
        return(r)

/// The absolute value of `self`.
/// :returns: The magnitude of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is `MIN`, whose magnitude does not fit.
routine SSize.abs(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? continue
            : return(self)
        r : Self = self.neg()
        return(r)

/// Absolute value that reports overflow.
/// :returns: The magnitude of `self`.
/// :absent: When `self` is `MIN`, whose magnitude does not fit.
routine SSize.abs_checked(self: Self) -> Option<Self>
    block entry()
        fits      : Bool         = self.ne(Self.MIN)
        magnitude : Self         = self.abs_wrap()
        r         : Option<Self> = fits.then_present(magnitude)
        return(r)

/// The absolute value of `self`, wrapping, so `MIN.abs_wrap()` is `MIN`.
/// :returns: The magnitude of `self`, or `MIN` when `self` is `MIN`.
routine SSize.abs_wrap(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        negated  : Self = sub<Self>(0, self)
        r        : Self = negative
            ? negated
            : self
        return(r)

/// The absolute value of `self`, saturating, so `MIN.abs_clamp()` is `MAX`.
/// :returns: The magnitude of `self`, or `MAX` when `self` is `MIN`.
routine SSize.abs_clamp(self: Self) -> Self
    block entry()
        is_min    : Bool = self.eq(Self.MIN)
        magnitude : Self = self.abs_wrap()
        r         : Self = is_min
            ? Self.MAX
            : magnitude
        return(r)

/// The sign of `self`.
/// :returns: -1 when `self` is negative, 0 when it is 0, and 1 when it is positive.
routine SSize.signum(self: Self) -> Self
    block entry()
        negative     : Bool = self.lt(0)
        positive     : Bool = self.gt(0)
        non_negative : Self = positive
            ? 1
            : 0
        r : Self = negative
            ? -1
            : non_negative
        return(r)

/// Tests whether `self` is below zero.
/// :returns: True when `self < 0`.
routine SSize.is_negative(self: Self) -> Bool
    block entry()
        r : Bool = self.lt(0)
        return(r)

/// Tests whether `self` is above zero.
/// :returns: True when `self > 0`.
routine SSize.is_positive(self: Self) -> Bool
    block entry()
        r : Bool = self.gt(0)
        return(r)

// -- division --------------------------------------------------------------------

/// The quotient of `self` divided by `other`, truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when `self` is `MIN` and `other` is -1.
#track_caller
routine SSize.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sdiv<Self>(self, other)
        return(r)

/// The remainder of `self` divided by `other`. It has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when `self` is `MIN` and `other` is -1.
#track_caller
routine SSize.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = srem<Self>(self, other)
        return(r)

/// Division that reports failure instead of crashing. The quotient is truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient of `self` divided by `other`.
/// :absent: On a zero divisor and on `MIN.div(-1)`.
routine SSize.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Self>.Absent)
            : continue
        r : Self = sdiv<Self>(self, other)
        return(Option<Self>.Present(r))

/// Remainder that reports failure instead of crashing. The result has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder of `self` divided by `other`.
/// :absent: On a zero divisor and on `MIN.mod(-1)`.
routine SSize.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Self>.Absent)
            : continue
        r : Self = srem<Self>(self, other)
        return(Option<Self>.Present(r))

/// The quotient of `self` divided by `other`, truncated toward zero. `MIN.div_wrap(-1)` wraps to `MIN`.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine SSize.div_wrap(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(Self.MIN)
            : continue
        r : Self = sdiv<Self>(self, other)
        return(r)

/// The remainder of `self` divided by `other`, with the dividend's sign. `MIN.mod_wrap(-1)` is 0.
/// :param other: The divisor.
/// :returns: The remainder.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine SSize.mod_wrap(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(0)
            : continue
        r : Self = srem<Self>(self, other)
        return(r)

/// The quotient of Euclidean division, chosen so the remainder is never negative.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when `self` is `MIN` and `other` is -1.
routine SSize.div_euclid(self: Self, other: Self) -> Self
    shared q : Self = self.div(other)

    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0)
        branch positive_divisor
            ? down()
            : up()

    block down()
        r : Self = q.sub(1)
        return(r)

    block up()
        r : Self = q.add(1)
        return(r)

/// The remainder of Euclidean division, always in `0 ..< |other|`.
/// :param other: The divisor.
/// :returns: The non-negative remainder.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when `self` is `MIN` and `other` is -1.
routine SSize.mod_euclid(self: Self, other: Self) -> Self
    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Self = other.abs_wrap()
        r         : Self = add<Self>(rem, magnitude)
        return(r)

// -- powers ----------------------------------------------------------------------

/// Raises `self` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `self` to the power `exponent`, which is 1 when `exponent` is 0.
/// :throws: Crashes with `IntegerOverflowError` when the power does not fit in SSize.
#track_caller
routine SSize.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `self` to the power `exponent` by squaring, wrapping modulo 2^BITS.
/// :param exponent: The power to raise to.
/// :returns: The power modulo 2^BITS, which is 1 when `exponent` is 0.
routine SSize.pow_wrap(self: Self, exponent: U32) -> Self
    shared base : @Self <- self
    shared acc  : @Self <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc.load(), base.load())
        next_acc  : Self = odd
            ? with_base
            : acc.load()
        next_acc2 : Self = next_acc
        next_base : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Raises `self` to the power `exponent` by squaring, reporting overflow.
/// :param exponent: The power to raise to.
/// :returns: The power, which is 1 when `exponent` is 0.
/// :absent: When the power does not fit in SSize.
routine SSize.pow_checked(self: Self, exponent: U32) -> Option<Self>
    shared base     : @Self <- self
    shared acc      : @Self <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = smul_overflows<Self>(acc.load(), base.load()).bitand(odd)
        with_base    : Self = mul<Self>(acc.load(), base.load())
        next_acc     : Self = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = smul_overflows<Self>(base.load(), base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Self = next_acc
        next_base     : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool         = overflow.load().bitnot()
        r    : Option<Self> = fits.then_present(acc.load())
        return(r)

/// Raises `self` to the power `exponent`, saturating at `MIN` / `MAX` by the sign the exact result would have.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MIN` / `MAX` when it does not fit.
routine SSize.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        odd_exp         : Bool = exponent.bitand(1).ne(0)
        negative_result : Bool = self.lt(0).bitand(odd_exp)
        limit           : Self = negative_result
            ? Self.MIN
            : Self.MAX
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(limit)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `self` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine SSize.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Tests whether `self` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine SSize.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Signed less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self < other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp slt i64 {self}, {other}")]
routine SSize.lt(self: Self, other: Self) -> Bool

/// Signed less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self < other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp slt i32 {self}, {other}")]
routine SSize.lt(self: Self, other: Self) -> Bool

/// Signed less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self <= other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp sle i64 {self}, {other}")]
routine SSize.le(self: Self, other: Self) -> Bool

/// Signed less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self <= other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp sle i32 {self}, {other}")]
routine SSize.le(self: Self, other: Self) -> Bool

/// Signed greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self > other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp sgt i64 {self}, {other}")]
routine SSize.gt(self: Self, other: Self) -> Bool

/// Signed greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self > other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp sgt i32 {self}, {other}")]
routine SSize.gt(self: Self, other: Self) -> Bool

/// Signed greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self >= other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp sge i64 {self}, {other}")]
routine SSize.ge(self: Self, other: Self) -> Bool

/// Signed greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self >= other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp sge i32 {self}, {other}")]
routine SSize.ge(self: Self, other: Self) -> Bool

/// Three-way signed comparison of `self` with `other`.
/// :param other: The value to compare with.
/// :returns: -1 when `self < other`, 0 when they are equal, and 1 when `self > other`.
routine SSize.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is smaller.
routine SSize.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = smin<Self>(self, other)
        return(r)

/// Returns the larger of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is larger.
routine SSize.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = smax<Self>(self, other)
        return(r)

/// Limits `self` to the range `lo ..= hi`.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `self < lo`, `hi` when `self > hi`, else `self`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine SSize.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Self = smax<Self>(self, lo)
        r           : Self = smin<Self>(at_least_lo, hi)
        return(r)

/// Tests whether `self` is in `lo ..= hi`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= self <= hi`.
routine SSize.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// Tests whether `self` is in `lo ..< end`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= self < end`.
routine SSize.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the bits widened to 64, under the process key, the same hash for SSize and USize.
/// :returns: The 64-bit hash of `self`.
routine SSize.hash(self: Self) -> U64
    block entry()
        wide : U64 = bitcast<Self, USize>(self).to<U64>()
        h    : U64 = siphash24(wide, hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `self` and `other`, `|self - other|`, which always fits in USize.
/// :param other: The other value.
/// :returns: The absolute difference as a USize.
routine SSize.abs_diff(self: Self, other: Self) -> USize
    block entry()
        hi   : Self  = smax<Self>(self, other)
        lo   : Self  = smin<Self>(self, other)
        diff : Self  = sub<Self>(hi, lo)
        r    : USize = bitcast<Self, USize>(diff)
        return(r)

/// The average of `self` and `other`, rounded toward zero, computed without overflow.
/// :param other: The other value.
/// :returns: `(self + other) / 2`, rounded toward zero.
routine SSize.midpoint(self: Self, other: Self) -> Self
    block entry()
        common       : Self = self.bitand(other)
        half_diff    : Self = self.bitxor(other).shr(1)
        rounded_down : Self = add<Self>(common, half_diff)
        parity       : Self = self.bitxor(other).bitand(1)
        odd_sum      : Bool = parity.ne(0)
        round_up     : Bool = odd_sum.bitand(rounded_down.lt(0))
        up           : Self = add<Self>(rounded_down, 1)
        r            : Self = round_up
            ? up
            : rounded_down
        return(r)

/// The base-2 logarithm of `self`, rounded down.
/// :returns: `floor(log2(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0 or negative.
#[target(size: 64), track_caller]
routine SSize.ilog2(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U64, Self>(bitcast<Self, U64>(self).ilog2())
        return(r)

/// The base-2 logarithm of `self`, rounded down.
/// :returns: `floor(log2(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0 or negative.
#[target(size: 32), track_caller]
routine SSize.ilog2(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U32, Self>(bitcast<Self, U32>(self).ilog2())
        return(r)

/// The base-10 logarithm of `self`, rounded down.
/// :returns: `floor(log10(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0 or negative.
#[target(size: 64), track_caller]
routine SSize.ilog10(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U64, Self>(bitcast<Self, U64>(self).ilog10())
        return(r)

/// The base-10 logarithm of `self`, rounded down.
/// :returns: `floor(log10(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0 or negative.
#[target(size: 32), track_caller]
routine SSize.ilog10(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U32, Self>(bitcast<Self, U32>(self).ilog10())
        return(r)

/// The square root of `self`, rounded down.
/// :returns: `floor(sqrt(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is negative.
#[target(size: 64), track_caller]
routine SSize.isqrt(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? crash_numeric_domain()
            : continue
        r : Self = bitcast<U64, Self>(bitcast<Self, U64>(self).isqrt())
        return(r)

/// The square root of `self`, rounded down.
/// :returns: `floor(sqrt(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is negative.
#[target(size: 32), track_caller]
routine SSize.isqrt(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? crash_numeric_domain()
            : continue
        r : Self = bitcast<U32, Self>(bitcast<Self, U32>(self).isqrt())
        return(r)

// -- conversions -----------------------------------------------------------------

/// The identity conversion: returns `self` unchanged.
/// :returns: `self` as SSize.
routine SSize.to<Self>(self: Self) -> Self
    block entry()
        return(self)

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Converts `self` to `S8`.
/// :returns: The same value as a `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine SSize.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.between(-128, 127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to S8 when the value fits.
/// :returns: The value as a S8.
/// :absent: When `self` is outside the range of S8.
routine SSize.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.between(-128, 127)
        value : S8         = trunc<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `self` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: `self` modulo 2^8, as a `S8`.
routine SSize.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8`, saturating at the ends of `S8`'s range.
/// :returns: `self` clamped to `S8.MIN ..= S8.MAX`.
routine SSize.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_least : Self = smax<Self>(self, -128)
        at_most  : Self = smin<Self>(at_least, 127)
        r        : S8   = trunc<Self, S8>(at_most)
        return(r)

/// Converts `self` to `S16`.
/// :returns: The same value as a `S16`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S16`.
#track_caller
routine SSize.to<S16>(self: Self) -> S16
    block entry()
        fits : Bool = self.between(-32768, 32767)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = trunc<Self, S16>(self)
        return(r)

/// Converts `self` to S16 when the value fits.
/// :returns: The value as a S16.
/// :absent: When `self` is outside the range of S16.
routine SSize.to_checked<S16>(self: Self) -> Option<S16>
    block entry()
        fits  : Bool        = self.between(-32768, 32767)
        value : S16         = trunc<Self, S16>(self)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts `self` to `S16`, keeping the low 16 bits (modulo 2^16).
/// :returns: `self` modulo 2^16, as a `S16`.
routine SSize.to_wrap<S16>(self: Self) -> S16
    block entry()
        r : S16 = trunc<Self, S16>(self)
        return(r)

/// Converts `self` to `S16`, saturating at the ends of `S16`'s range.
/// :returns: `self` clamped to `S16.MIN ..= S16.MAX`.
routine SSize.to_clamp<S16>(self: Self) -> S16
    block entry()
        at_least : Self = smax<Self>(self, -32768)
        at_most  : Self = smin<Self>(at_least, 32767)
        r        : S16  = trunc<Self, S16>(at_most)
        return(r)

/// Converts `self` to `S32`.
/// :returns: The same value as a `S32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S32`.
#[target(size: 64), track_caller]
routine SSize.to<S32>(self: Self) -> S32
    block entry()
        fits : Bool = self.between(-2147483648, 2147483647)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = trunc<Self, S32>(self)
        return(r)

/// Reinterprets `self` as S32. On this target the two types have the same width, so every value fits and the bits are unchanged.
/// :returns: The same numeric value as a S32.
#target(size: 32)
routine SSize.to<S32>(self: Self) -> S32
    block entry()
        r : S32 = bitcast<Self, S32>(self)
        return(r)

/// Converts `self` to S32 when the value fits.
/// :returns: The value as a S32.
/// :absent: When `self` is outside the range of S32.
#target(size: 64)
routine SSize.to_checked<S32>(self: Self) -> Option<S32>
    block entry()
        fits  : Bool        = self.between(-2147483648, 2147483647)
        value : S32         = trunc<Self, S32>(self)
        r     : Option<S32> = fits.then_present(value)
        return(r)

/// Converts `self` to S32, always present on this target because every SSize value fits.
/// :returns: The value as a S32, wrapped in `Option`.
#target(size: 32)
routine SSize.to_checked<S32>(self: Self) -> Option<S32>
    block entry()
        r : S32 = self.to<S32>()
        return(Option<S32>.Present(r))

/// Converts `self` to `S32`, keeping the low 32 bits (modulo 2^32).
/// :returns: `self` modulo 2^32, as a `S32`.
#target(size: 64)
routine SSize.to_wrap<S32>(self: Self) -> S32
    block entry()
        r : S32 = trunc<Self, S32>(self)
        return(r)

/// Wrapping conversion to S32. On this target every SSize value fits, so this equals `to<S32>` and nothing is wrapped or clamped.
/// :returns: The same numeric value as a S32.
#target(size: 32)
routine SSize.to_wrap<S32>(self: Self) -> S32
    block entry()
        r : S32 = self.to<S32>()
        return(r)

/// Converts `self` to `S32`, saturating at the ends of `S32`'s range.
/// :returns: `self` clamped to `S32.MIN ..= S32.MAX`.
#target(size: 64)
routine SSize.to_clamp<S32>(self: Self) -> S32
    block entry()
        at_least : Self = smax<Self>(self, -2147483648)
        at_most  : Self = smin<Self>(at_least, 2147483647)
        r        : S32  = trunc<Self, S32>(at_most)
        return(r)

/// Saturating conversion to S32. On this target every SSize value fits, so this equals `to<S32>` and nothing is wrapped or clamped.
/// :returns: The same numeric value as a S32.
#target(size: 32)
routine SSize.to_clamp<S32>(self: Self) -> S32
    block entry()
        r : S32 = self.to<S32>()
        return(r)

/// Reinterprets `self` as S64. On this target the two types have the same width, so every value fits and the bits are unchanged.
/// :returns: The same numeric value as a S64.
#target(size: 64)
routine SSize.to<S64>(self: Self) -> S64
    block entry()
        r : S64 = bitcast<Self, S64>(self)
        return(r)

/// Sign-extends `self` to S64. Every SSize value fits, so this never fails.
/// :returns: The same numeric value as a S64.
#target(size: 32)
routine SSize.to<S64>(self: Self) -> S64
    block entry()
        r : S64 = sext<Self, S64>(self)
        return(r)

/// Sign-extends `self` to S128. Every SSize value fits, so this never fails.
/// :returns: The same numeric value as a S128.
routine SSize.to<S128>(self: Self) -> S128
    block entry()
        r : S128 = sext<Self, S128>(self)
        return(r)

/// Sign-extends `self` to S256. Every SSize value fits, so this never fails.
/// :returns: The same numeric value as a S256.
routine SSize.to<S256>(self: Self) -> S256
    block entry()
        r : S256 = sext<Self, S256>(self)
        return(r)

/// Converts `self` to `U8`.
/// :returns: The same value as a `U8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U8`.
#track_caller
routine SSize.to<U8>(self: Self) -> U8
    block entry()
        fits : Bool = self.between(0, 255)
        branch fits
            ? continue
            : crash_overflow()
        r : U8 = trunc<Self, U8>(self)
        return(r)

/// Converts `self` to U8 when the value fits.
/// :returns: The value as a U8.
/// :absent: When `self` is negative or above the largest U8.
routine SSize.to_checked<U8>(self: Self) -> Option<U8>
    block entry()
        fits  : Bool       = self.between(0, 255)
        value : U8         = trunc<Self, U8>(self)
        r     : Option<U8> = fits.then_present(value)
        return(r)

/// Converts `self` to `U8`, keeping the low 8 bits (modulo 2^8).
/// :returns: `self` modulo 2^8, as a `U8`.
routine SSize.to_wrap<U8>(self: Self) -> U8
    block entry()
        r : U8 = trunc<Self, U8>(self)
        return(r)

/// Converts `self` to `U8`, saturating at the ends of `U8`'s range.
/// :returns: `self` clamped to `U8.MIN ..= U8.MAX`.
routine SSize.to_clamp<U8>(self: Self) -> U8
    block entry()
        at_least : Self = smax<Self>(self, 0)
        at_most  : Self = smin<Self>(at_least, 255)
        r        : U8   = trunc<Self, U8>(at_most)
        return(r)

/// Converts `self` to `U16`.
/// :returns: The same value as a `U16`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U16`.
#track_caller
routine SSize.to<U16>(self: Self) -> U16
    block entry()
        fits : Bool = self.between(0, 65535)
        branch fits
            ? continue
            : crash_overflow()
        r : U16 = trunc<Self, U16>(self)
        return(r)

/// Converts `self` to U16 when the value fits.
/// :returns: The value as a U16.
/// :absent: When `self` is negative or above the largest U16.
routine SSize.to_checked<U16>(self: Self) -> Option<U16>
    block entry()
        fits  : Bool        = self.between(0, 65535)
        value : U16         = trunc<Self, U16>(self)
        r     : Option<U16> = fits.then_present(value)
        return(r)

/// Converts `self` to `U16`, keeping the low 16 bits (modulo 2^16).
/// :returns: `self` modulo 2^16, as a `U16`.
routine SSize.to_wrap<U16>(self: Self) -> U16
    block entry()
        r : U16 = trunc<Self, U16>(self)
        return(r)

/// Converts `self` to `U16`, saturating at the ends of `U16`'s range.
/// :returns: `self` clamped to `U16.MIN ..= U16.MAX`.
routine SSize.to_clamp<U16>(self: Self) -> U16
    block entry()
        at_least : Self = smax<Self>(self, 0)
        at_most  : Self = smin<Self>(at_least, 65535)
        r        : U16  = trunc<Self, U16>(at_most)
        return(r)

/// Converts `self` to `U32`.
/// :returns: The same value as a `U32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U32`.
#[target(size: 64), track_caller]
routine SSize.to<U32>(self: Self) -> U32
    block entry()
        fits : Bool = self.between(0, 4294967295)
        branch fits
            ? continue
            : crash_overflow()
        r : U32 = trunc<Self, U32>(self)
        return(r)

/// Converts `self` to `U32`.
/// :returns: The same value as a `U32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U32`.
#[target(size: 32), track_caller]
routine SSize.to<U32>(self: Self) -> U32
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U32 = bitcast<Self, U32>(self)
        return(r)

/// Converts `self` to U32 when the value fits.
/// :returns: The value as a U32.
/// :absent: When `self` is negative or above the largest U32.
#target(size: 64)
routine SSize.to_checked<U32>(self: Self) -> Option<U32>
    block entry()
        fits  : Bool        = self.between(0, 4294967295)
        value : U32         = trunc<Self, U32>(self)
        r     : Option<U32> = fits.then_present(value)
        return(r)

/// Converts `self` to U32 when the value fits.
/// :returns: The value as a U32.
/// :absent: When `self` is negative.
#target(size: 32)
routine SSize.to_checked<U32>(self: Self) -> Option<U32>
    block entry()
        fits  : Bool        = self.ge(0)
        value : U32         = bitcast<Self, U32>(self)
        r     : Option<U32> = fits.then_present(value)
        return(r)

/// Converts `self` to `U32`, keeping the low 32 bits (modulo 2^32).
/// :returns: `self` modulo 2^32, as a `U32`.
#target(size: 64)
routine SSize.to_wrap<U32>(self: Self) -> U32
    block entry()
        r : U32 = trunc<Self, U32>(self)
        return(r)

/// Converts `self` to `U32`, keeping the low 32 bits (modulo 2^32).
/// :returns: `self` modulo 2^32, as a `U32`.
#target(size: 32)
routine SSize.to_wrap<U32>(self: Self) -> U32
    block entry()
        r : U32 = bitcast<Self, U32>(self)
        return(r)

/// Converts `self` to `U32`, saturating at the ends of `U32`'s range.
/// :returns: `self` clamped to `U32.MIN ..= U32.MAX`.
#target(size: 64)
routine SSize.to_clamp<U32>(self: Self) -> U32
    block entry()
        at_least : Self = smax<Self>(self, 0)
        at_most  : Self = smin<Self>(at_least, 4294967295)
        r        : U32  = trunc<Self, U32>(at_most)
        return(r)

/// Converts `self` to `U32`, saturating at the ends of `U32`'s range.
/// :returns: `self` clamped to `U32.MIN ..= U32.MAX`.
#target(size: 32)
routine SSize.to_clamp<U32>(self: Self) -> U32
    block entry()
        at_least : Self = smax<Self>(self, 0)
        r        : U32  = bitcast<Self, U32>(at_least)
        return(r)

