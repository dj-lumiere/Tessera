/// Converts `self` to `F32`, rounding to nearest, ties to even.
/// :returns: The nearest `F32` value.
routine SSize.to<F32>(self: Self) -> F32
    block entry()
        r : F32 = sitofp<Self, F32>(self)
        return(r)

/// Converts `self` to `F64`, rounding to nearest, ties to even.
/// :returns: The nearest `F64` value.
routine SSize.to<F64>(self: Self) -> F64
    block entry()
        r : F64 = sitofp<Self, F64>(self)
        return(r)

// -- conversions into SSize ------------------------------------------------------

/// Sign-extends `self` to SSize. Every S8 value fits, so this never fails.
/// :returns: The same numeric value as a SSize.
routine S8.to<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = sext<Self, SSize>(self)
        return(r)

/// Sign-extends `self` to SSize. Every S16 value fits, so this never fails.
/// :returns: The same numeric value as a SSize.
routine S16.to<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = sext<Self, SSize>(self)
        return(r)

/// Sign-extends `self` to SSize. Every S32 value fits, so this never fails.
/// :returns: The same numeric value as a SSize.
#target(size: 64)
routine S32.to<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = sext<Self, SSize>(self)
        return(r)

/// Reinterprets `self` as SSize. On this target the two types have the same width, so every value fits and the bits are unchanged.
/// :returns: The same numeric value as a SSize.
#target(size: 32)
routine S32.to<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = bitcast<Self, SSize>(self)
        return(r)

/// Converts `self` to SSize, always present on this target because every S32 value fits.
/// :returns: The value as a SSize, wrapped in `Option`.
routine S32.to_checked<SSize>(self: Self) -> Option<SSize>
    block entry()
        r : SSize = self.to<SSize>()
        return(Option<SSize>.Present(r))

/// Wrapping conversion to SSize. On this target every S32 value fits, so this equals `to<SSize>` and nothing is wrapped or clamped.
/// :returns: The same numeric value as a SSize.
routine S32.to_wrap<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = self.to<SSize>()
        return(r)

/// Saturating conversion to SSize. On this target every S32 value fits, so this equals `to<SSize>` and nothing is wrapped or clamped.
/// :returns: The same numeric value as a SSize.
routine S32.to_clamp<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = self.to<SSize>()
        return(r)

/// Reinterprets `self` as SSize. On this target the two types have the same width, so every value fits and the bits are unchanged.
/// :returns: The same numeric value as a SSize.
#target(size: 64)
routine S64.to<SSize>(self: Self) -> SSize
    block entry()
        r : SSize = bitcast<Self, SSize>(self)
        return(r)

/// Converts `self` to `SSize`.
/// :returns: The same value as a `SSize`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `SSize`.
#[target(size: 32), track_caller]
routine S64.to<SSize>(self: Self) -> SSize
    block entry()
        fits : Bool = self.between(-2147483648, 2147483647)
        branch fits
            ? continue
            : crash_overflow()
        r : SSize = trunc<Self, SSize>(self)
        return(r)

/// Converts `self` to SSize, always present on this target because every S64 value fits.
/// :returns: The value as a SSize, wrapped in `Option`.
#target(size: 64)
routine S64.to_checked<SSize>(self: Self) -> Option<SSize>
    block entry()
        r : SSize = self.to<SSize>()
        return(Option<SSize>.Present(r))

/// Converts `self` to SSize when the value fits.
/// :returns: The value as a SSize.
/// :absent: When `self` is outside the range of SSize.
#target(size: 32)
routine S64.to_checked<SSize>(self: Self) -> Option<SSize>
    block entry()
        fits  : Bool          = self.between(-2147483648, 2147483647)
        value : SSize         = trunc<Self, SSize>(self)
        r     : Option<SSize> = fits.then_present(value)
        return(r)

