// Tessera stdlib: U256 — 256-bit unsigned integer
//
// Maps to LLVM IR i256. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// 256-bit unsigned integer, mapped to LLVM `i256`. Arithmetic, shifts, and lossy conversions crash when the result does not fit. The `_checked` forms return an `Option`, the `_wrap` forms are modular, and the `_clamp` forms saturate.
#llvm("i256")
record U256
conform Equatable<U256>, Comparable<U256>, Hashable<U256>

// -- constants -------------------------------------------------------------------

/// The smallest `U256` value, 0.
preset U256.MIN: U256 = 0
/// The largest `U256` value, `115792089237316195423570985008687907853269984665640564039457584007913129639935`.
preset U256.MAX: U256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
/// The width of `U256` in bits.
preset U256.BITS: U256 = 256

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `me` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine U256.count_ones(me: Me) -> Me
    block entry()
        r : Me = popcount<Me>(me)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `me` is 0.
routine U256.leading_zeros(me: Me) -> Me
    block entry()
        r : Me = clz<Me>(me, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `me` is 0.
routine U256.trailing_zeros(me: Me) -> Me
    block entry()
        r : Me = ctz<Me>(me, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine U256.reverse_bits(me: Me) -> Me
    block entry()
        r : Me = bitreverse<Me>(me)
        return(r)

/// Counts the bits of `me` that are 0.
/// :returns: `BITS` minus the population count.
routine U256.count_zeros(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = popcount<Me>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `me` is `MAX`.
routine U256.leading_ones(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = clz<Me>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `me` is `MAX`.
routine U256.trailing_ones(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = ctz<Me>(inverted, false)
        return(r)

/// Reverses the order of the bytes of `me`.
/// :returns: The byte-swapped value.
routine U256.swap_bytes(me: Me) -> Me
    block entry()
        r : Me = bswap<Me>(me)
        return(r)

/// Converts from this target's byte order to big-endian, which swaps the bytes.
/// :returns: The value in big-endian byte order.
routine U256.to_be(me: Me) -> Me
    block entry()
        r : Me = me.swap_bytes()
        return(r)

/// Converts from big-endian to this target's byte order, which swaps the bytes.
/// :returns: The value in native byte order.
routine U256.from_be(me: Me) -> Me
    block entry()
        r : Me = me.swap_bytes()
        return(r)

/// Converts from this target's byte order to little-endian. The target is little-endian, so this returns `me` unchanged.
/// :returns: The value in little-endian byte order.
routine U256.to_le(me: Me) -> Me
    block entry()
        return(me)

/// Converts from little-endian to this target's byte order. The target is little-endian, so this returns `me` unchanged.
/// :returns: The value in native byte order.
routine U256.from_le(me: Me) -> Me
    block entry()
        return(me)

/// Tests whether exactly one bit of `me` is set.
/// :returns: True when `me` is a power of two.
routine U256.is_power_of_two(me: Me) -> Bool
    block entry()
        ones : Me   = popcount<Me>(me)
        r    : Bool = ones.eq(1)
        return(r)

/// Bitwise AND of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine U256.bitand(me: Me, other: Me) -> Me
    block entry()
        r : Me = band<Me>(me, other)
        return(r)

/// Bitwise OR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine U256.bitor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bor<Me>(me, other)
        return(r)

/// Bitwise XOR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine U256.bitxor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bxor<Me>(me, other)
        return(r)

/// Bitwise NOT: flips every bit of `me`.
/// :returns: The complement, which equals `MAX - me`.
routine U256.bitnot(me: Me) -> Me
    block entry()
        r : Me = bnot<Me>(me)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted left by `n`, or 0 when `n` is `BITS` or more.
/// :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine U256.shl(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        shifted  : Me   = shl<Me>(me, n)
        r        : Me   = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, logical: 0 bits fill in. A shift by `BITS` or more gives 0.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted right by `n`, or 0 when `n` is `BITS` or more.
routine U256.shr(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        shifted  : Me   = lshr<Me>(me, n)
        out      : Me   = 0
        r        : Me   = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine U256.rotl(me: Me, n: Me) -> Me
    block entry()
        r : Me = fshl<Me>(me, me, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine U256.rotr(me: Me, n: Me) -> Me
    block entry()
        r : Me = fshr<Me>(me, me, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted left by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine U256.shl_checked(me: Me, n: Me) -> Option<Me>
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        branch in_range
            ? continue
            : return(Option<Me>.Absent)
        r : Me = shl<Me>(me, n)
        return(Option<Me>.Present(r))

/// Logical shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted right by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine U256.shr_checked(me: Me, n: Me) -> Option<Me>
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        branch in_range
            ? continue
            : return(Option<Me>.Absent)
        r : Me = lshr<Me>(me, n)
        return(Option<Me>.Present(r))

/// Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted left, with 0 bits filling in.
routine U256.shl_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 255)
        r      : Me = shl<Me>(me, amount)
        return(r)

/// Logical shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted right with 0 bits filling in.
routine U256.shr_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 255)
        r      : Me = lshr<Me>(me, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `me` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in `U256`.
#track_caller
routine U256.add(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = uadd_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = add<Me>(me, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in `U256`.
routine U256.add_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = uadd_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = add<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The sum of `me` and `other`, wrapped modulo 2^256.
/// :param other: The value to add.
/// :returns: The low 256 bits of the exact sum.
routine U256.add_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = add<Me>(me, other)
        return(r)

/// The sum of `me` and `other`, saturated at `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MAX` when the exact sum is above the range.
routine U256.add_clamp(me: Me, other: Me) -> Me
    block entry()
        r : Me = uadd_sat<Me>(me, other)
        return(r)

/// The difference of `me` and `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `IntegerOverflowError` when the difference does not fit in `U256`.
#track_caller
routine U256.sub(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = usub_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = sub<Me>(me, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in `U256`.
routine U256.sub_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = usub_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = sub<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The difference of `me` and `other`, wrapped modulo 2^256.
/// :param other: The value to subtract.
/// :returns: The low 256 bits of the exact difference.
routine U256.sub_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = sub<Me>(me, other)
        return(r)

/// The difference of `me` and `other`, saturated at 0.
/// :param other: The value to subtract.
/// :returns: The difference, or 0 when the exact difference is below 0.
routine U256.sub_clamp(me: Me, other: Me) -> Me
    block entry()
        r : Me = usub_sat<Me>(me, other)
        return(r)

/// The product of `me` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in `U256`.
#track_caller
routine U256.mul(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = me.mul_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = mul<Me>(me, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in `U256`.
routine U256.mul_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = me.mul_overflows(other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = mul<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The product of `me` and `other`, wrapped modulo 2^256.
/// :param other: The factor to multiply by.
/// :returns: The low 256 bits of the exact product.
routine U256.mul_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = mul<Me>(me, other)
        return(r)

/// The product of `me` and `other`, saturated at `MAX`.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MAX` when the exact product is above the range.
routine U256.mul_clamp(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = me.mul_overflows(other)
        product  : Me   = mul<Me>(me, other)
        r        : Me   = overflow
            ? Me.MAX
            : product
        return(r)

/// Tests whether the exact product of `me` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in `U256`.
/// :note: The product overflows exactly when dividing the wrapped product by `me` does not give back `other`.
routine U256.mul_overflows(me: Me, other: Me) -> Bool
    block entry()
        zero : Bool = me.eq(0)
        branch zero
            ? return(false)
            : continue
        product : Me   = mul<Me>(me, other)
        back    : Me   = product.div(me)
        r       : Bool = back.ne(other)
        return(r)

// -- division --------------------------------------------------------------------

/// The quotient of `me` divided by `other`, truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
#expensive("divides in software")
routine U256.div(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Me = wide_div(me, other)
        return(r)

/// The remainder of `me` divided by `other`.
/// :param other: The divisor.
/// :returns: The remainder, between 0 and `other - 1`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
#expensive("divides in software")
routine U256.mod(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Me = wide_rem(me, other)
        return(r)

/// Division that reports failure instead of crashing. The quotient is truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient of `me` divided by `other`.
/// :absent: On a zero divisor.
#expensive("divides in software")
routine U256.div_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Me>.Absent)
            : continue
        r : Me = wide_div(me, other)
        return(Option<Me>.Present(r))

/// Remainder that reports failure instead of crashing.
/// :param other: The divisor.
/// :returns: The remainder of `me` divided by `other`.
/// :absent: On a zero divisor.
#expensive("divides in software")
routine U256.mod_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Me>.Absent)
            : continue
        r : Me = wide_rem(me, other)
        return(Option<Me>.Present(r))

/// The quotient of `me` divided by `other`, rounded up.
/// :param other: The divisor.
/// :returns: The quotient, rounded up.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
#expensive("divides in software")
routine U256.div_ceil(me: Me, other: Me) -> Me
    block entry()
        q     : Me   = me.div(other)
        rem   : Me   = wide_rem(me, other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(q)
            : continue
        r : Me = add<Me>(q, 1)
        return(r)

/// The smallest multiple of `other` that is at least `me`.
/// :param other: The value whose multiple to round up to.
/// :returns: `me` when it is already a multiple of `other`, else the next multiple above it.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when the multiple does not fit in `U256`.
#track_caller
routine U256.next_multiple_of(me: Me, other: Me) -> Me
    block entry()
        rem   : Me   = me.mod(other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(me)
            : continue
        gap : Me = sub<Me>(other, rem)
        r   : Me = me.add(gap)
        return(r)

/// The smallest power of two that is at least `me`. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :throws: Crashes with `IntegerOverflowError` when the power of two does not fit in `U256`.
#track_caller
routine U256.next_power_of_two(me: Me) -> Me
    block entry()
        r : Option<Me> = me.next_power_of_two_checked()
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// The smallest power of two that is at least `me`, reporting when it does not fit. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :absent: When the power of two does not fit in `U256`.
routine U256.next_power_of_two_checked(me: Me) -> Option<Me>
    block entry()
        small : Bool = me.le(1)
        branch small
            ? return(Option<Me>.Present(1))
            : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up()
        below : Me   = sub<Me>(me, 1)
        lz    : Me   = clz<Me>(below, true)
        shift : Me   = sub<Me>(Me.BITS, lz)
        fits  : Bool = shift.lt(Me.BITS)
        branch fits
            ? continue
            : return(Option<Me>.Absent)
        power : Me = shl<Me>(1, shift)
        return(Option<Me>.Present(power))

// -- powers ----------------------------------------------------------------------

/// Raises `me` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :throws: Crashes with `IntegerOverflowError` when the exact power does not fit in `U256`.
#track_caller
routine U256.pow(me: Me, exponent: U32) -> Me
    block entry()
        r : Option<Me> = me.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `me` to the power `exponent` by squaring, wrapping modulo 2^256.
/// :param exponent: The power to raise to.
/// :returns: The low 256 bits of the exact power.
routine U256.pow_wrap(me: Me, exponent: U32) -> Me
    shared base : @Me <- me
    shared acc  : @Me <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Me   = mul<Me>(acc.load(), base.load())
        next_acc  : Me   = odd
            ? with_base
            : acc.load()
        next_acc2 : Me = next_acc
        next_base : Me = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Power that reports overflow.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :absent: When the exact power does not fit in `U256`.
routine U256.pow_checked(me: Me, exponent: U32) -> Option<Me>
    shared base     : @Me   <- me
    shared acc      : @Me   <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = acc.load().mul_overflows(base.load()).bitand(odd)
        with_base    : Me   = mul<Me>(acc.load(), base.load())
        next_acc     : Me   = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = base.load().mul_overflows(base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Me   = next_acc
        next_base     : Me   = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool       = overflow.load().bitnot()
        r    : Option<Me> = fits.then_present(acc.load())
        return(r)

/// Raises `me` to the power `exponent`, saturated at `MAX`.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MAX` when the exact power does not fit.
routine U256.pow_clamp(me: Me, exponent: U32) -> Me
    block entry()
        checked : Option<Me> = me.pow_checked(exponent)
        r       : Me         = checked.unwrap_or(Me.MAX)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `me` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine U256.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ieq<Me>(me, other)
        return(r)

/// Tests whether `me` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine U256.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ine<Me>(me, other)
        return(r)

/// Unsigned less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me < other`.
#[external("llvm"), template("{result} = icmp ult i256 {me}, {other}")]
routine U256.lt(me: Me, other: Me) -> Bool

/// Unsigned less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me <= other`.
#[external("llvm"), template("{result} = icmp ule i256 {me}, {other}")]
routine U256.le(me: Me, other: Me) -> Bool

/// Unsigned greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me > other`.
#[external("llvm"), template("{result} = icmp ugt i256 {me}, {other}")]
routine U256.gt(me: Me, other: Me) -> Bool

/// Unsigned greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me >= other`.
#[external("llvm"), template("{result} = icmp uge i256 {me}, {other}")]
routine U256.ge(me: Me, other: Me) -> Bool

/// Compares `me` with `other` by unsigned order.
/// :param other: The value to compare with.
/// :returns: -1 when `me < other`, 0 when they are equal, and 1 when `me > other`.
routine U256.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by unsigned comparison.
/// :param other: The value to compare with.
/// :returns: `me` or `other`, whichever is smaller.
routine U256.min(me: Me, other: Me) -> Me
    block entry()
        r : Me = umin<Me>(me, other)
        return(r)

/// Returns the larger of two values by unsigned comparison.
/// :param other: The value to compare with.
/// :returns: `me` or `other`, whichever is larger.
routine U256.max(me: Me, other: Me) -> Me
    block entry()
        r : Me = umax<Me>(me, other)
        return(r)

/// Limits `me` to the range from `lo` to `hi`, both ends included.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine U256.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Me = umax<Me>(me, lo)
        r           : Me = umin<Me>(at_least_lo, hi)
        return(r)

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`.
routine U256.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`.
routine U256.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the 32 bytes under the process key, the same hash for `S256` and `U256`.
/// :returns: The 64-bit hash of `me`.
routine U256.hash(me: Me) -> U64
    block entry()
        claim bits : @Me <- me
        h : U64 = siphash24(bits.to<@Byte>(), 32, hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `me` and `other`, `|me - other|`, which always fits in `U256`.
/// :param other: The value to measure from.
/// :returns: `|me - other|` as a `U256`.
routine U256.abs_diff(me: Me, other: Me) -> Me
    block entry()
        hi   : Me = umax<Me>(me, other)
        lo   : Me = umin<Me>(me, other)
        diff : Me = sub<Me>(hi, lo)
        r    : Me = bitcast<Me, Me>(diff)
        return(r)

/// The average of `me` and `other`, rounded down, computed without overflow.
/// :param other: The other value.
/// :returns: `(me + other) / 2`, rounded down.
routine U256.midpoint(me: Me, other: Me) -> Me
    block entry()
        common    : Me = me.bitand(other)
        half_diff : Me = me.bitxor(other).shr(1)
        r         : Me = add<Me>(common, half_diff)
        return(r)

/// The base-2 logarithm of `me`, rounded down.
/// :returns: `floor(log2(me))`.
/// :throws: Crashes with `NumericDomainError` when `me` is 0.
#track_caller
routine U256.ilog2(me: Me) -> Me
    block entry()
        zero : Bool = me.eq(0)
        branch zero
            ? crash_numeric_domain()
            : continue
        lz : Me = clz<Me>(me, true)
        r  : Me = sub<Me>(Me.BITS.sub(1), lz)
        return(r)

/// The base-10 logarithm of `me`, rounded down. It counts the powers of ten up to `me` by multiplying, since a 256-bit
/// division is done in software and a multiplication is far cheaper.
/// :returns: `floor(log10(me))`.
/// :throws: Crashes with `NumericDomainError` when `me` is 0.
#track_caller
routine U256.ilog10(me: Me) -> Me
    block entry()
        zero : Bool = me.eq(0)
        branch zero
            ? crash_numeric_domain()
            : loop(0, 10)

    // power is 10^(digits + 1): one more while it is still at most me. A power past 2^256 is past every me.
    block loop(digits: Me, power: Me)
        more : Bool = power.le(me)
        branch more
            ? continue
            : return(digits)
        next : Option<Me> = power.mul_checked(10)
        when next
            .Present(bigger) -> loop(digits.add(1), bigger)
            .Absent          -> return(digits.add(1))

/// The integer square root of `me`, rounded down.
/// :returns: `floor(sqrt(me))`.
routine U256.isqrt(me: Me) -> Me
    block entry()
        top_bit : Me = shl<Me>(1, Me.BITS.sub(2))
        jump align(top_bit)

    // Start from the highest power of four that is <= me.
    block align(bit: Me)
        too_big : Bool = bit.gt(me)
        branch too_big
            ? align(bit.shr(2))
            : loop(me, 0, bit)

    block loop(rest: Me, root: Me, bit: Me)
        done : Bool = bit.eq(0)
        branch done
            ? return(root)
            : continue
        trial     : Me   = add<Me>(root, bit)
        fits      : Bool = rest.ge(trial)
        half_root : Me   = root.shr(1)
        next_bit  : Me   = bit.shr(2)
        branch fits
            ? take(rest, trial, half_root, bit, next_bit) \
            : loop(rest, half_root, next_bit)

    block take(rest: Me, trial: Me, half_root: Me, bit: Me, next_bit: Me)
        jump loop(sub<Me>(rest, trial), add<Me>(half_root, bit), next_bit)

// -- conversions -----------------------------------------------------------------

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Converts `me` to `S8`.
/// :returns: The same numeric value as an `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine U256.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.le(127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Me, S8>(me)
        return(r)

/// Converts `me` to `S8` when the value fits.
/// :returns: The value as an `S8`.
/// :absent: When `me` is outside the range of `S8`.
routine U256.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.le(127)
        value : S8         = trunc<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `me` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: The low bits of `me`, read as an `S8`.
routine U256.to_wrap<S8>(me: Me) -> S8
    block entry()
        r : S8 = trunc<Me, S8>(me)
        return(r)

/// Converts `me` to `S8`, saturating at `S8.MAX`.
/// :returns: The value, or `S8.MAX` when it is greater.
routine U256.to_clamp<S8>(me: Me) -> S8
    block entry()
        at_most : Me = umin<Me>(me, 127)
        r       : S8 = trunc<Me, S8>(at_most)
        return(r)

