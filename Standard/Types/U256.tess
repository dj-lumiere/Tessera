// Tessera stdlib: U256 — 256-bit unsigned integer
//
// Maps to LLVM IR i256. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// 256-bit unsigned integer, mapped to LLVM `i256`. Arithmetic, shifts, and lossy conversions crash when the result does not fit. The `_checked` forms return an `Option`, the `_wrap` forms are modular, and the `_clamp` forms saturate.
#llvm("i256")
record U256
conform Equatable<U256>, Comparable<U256>, Hashable<U256>

// -- constants -------------------------------------------------------------------

/// The smallest `U256` value, 0.
preset U256.MIN: U256 = 0
/// The largest `U256` value, `115792089237316195423570985008687907853269984665640564039457584007913129639935`.
preset U256.MAX: U256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
/// The width of `U256` in bits.
preset U256.BITS: U256 = 256

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are set to 1.
/// :returns: The population count, from 0 to `U256.BITS`.
routine U256.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The leading zero count, or `U256.BITS` when `self` is 0.
routine U256.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The trailing zero count, or `U256.BITS` when `self` is 0.
routine U256.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of the bits of `self`, so the least significant bit becomes the most significant.
/// :returns: `self` with its bits mirrored.
routine U256.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: The number of clear bits, from 0 to `U256.BITS`.
routine U256.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The leading one count, or `U256.BITS` when every bit is set.
routine U256.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The trailing one count, or `U256.BITS` when every bit is set.
routine U256.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Reverses the byte order of `self`.
/// :returns: `self` with its bytes in the opposite order.
routine U256.swap_bytes(self: Self) -> Self
    block entry()
        r : Self = bswap<Self>(self)
        return(r)

/// Converts `self` from the host byte order to big-endian. Tessera targets are little-endian, so this swaps the bytes.
/// :returns: The big-endian representation of `self`.
routine U256.to_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts a big-endian value to the host byte order. Tessera targets are little-endian, so this swaps the bytes.
/// :returns: The host-order value of `self`.
routine U256.from_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts `self` from the host byte order to little-endian. Tessera targets are little-endian, so this returns `self` unchanged.
/// :returns: The little-endian representation of `self`.
routine U256.to_le(self: Self) -> Self
    block entry()
        return(self)

/// Converts a little-endian value to the host byte order. Tessera targets are little-endian, so this returns `self` unchanged.
/// :returns: The host-order value of `self`.
routine U256.from_le(self: Self) -> Self
    block entry()
        return(self)

/// True when exactly one bit of `self` is set.
/// :returns: `true` when `self` is a power of two.
routine U256.is_power_of_two(self: Self) -> Bool
    block entry()
        ones : Self = popcount<Self>(self)
        r    : Bool = ones.eq(1)
        return(r)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where both operands have it set.
routine U256.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where either operand has it set.
routine U256.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where exactly one operand has it set.
routine U256.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise complement of `self`.
/// :returns: `self` with every bit flipped.
routine U256.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts `self` left by `n`, filling in zeros. A shift by `U256.BITS` or more shifts every bit out, so the result is 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value, or 0 when `n` is `U256.BITS` or more.
/// :note: The raw shift is poison for such an `n`, and the select never picks it.
routine U256.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shifts `self` right by `n`, logical: zeros fill in. A shift by `U256.BITS` or more gives 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value, or 0 when `n` is `U256.BITS` or more.
routine U256.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = lshr<Self>(self, n)
        out      : Self = 0
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits of `self` left by `n`, modulo the bit width. Bits shifted out at the top re-enter at the bottom.
/// :param n: The rotation amount in bits.
/// :returns: The rotated value.
routine U256.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits of `self` right by `n`, modulo the bit width. Bits shifted out at the bottom re-enter at the top.
/// :param n: The rotation amount in bits.
/// :returns: The rotated value.
routine U256.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// Shifts `self` left (zeros fill in), reporting an out-of-range amount instead of saturating to 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
/// :absent: `n` is outside `0 ..< U256.BITS`.
routine U256.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts `self` right (zeros fill in), reporting an out-of-range amount instead of saturating to 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
/// :absent: `n` is outside `0 ..< U256.BITS`.
routine U256.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = lshr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts `self` left (zeros fill in) by `n` modulo the bit width.
/// :param n: The shift amount in bits, reduced modulo `U256.BITS`.
/// :returns: The shifted value.
routine U256.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 255)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Shifts `self` right (zeros fill in) by `n` modulo the bit width.
/// :param n: The shift amount in bits, reduced modulo `U256.BITS`.
/// :returns: The shifted value.
routine U256.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 255)
        r      : Self = lshr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// Adds `other` to `self`.
/// :param other: The right-hand operand.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum exceeds `U256.MAX`.
#track_caller
routine U256.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = uadd_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Adds `other` to `self`, reporting overflow instead of crashing.
/// :param other: The right-hand operand.
/// :returns: The sum.
/// :absent: The sum exceeds `U256.MAX`.
routine U256.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = uadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Adds `other` to `self`, wrapping modulo 2^256.
/// :param other: The right-hand operand.
/// :returns: The sum modulo 2^256.
routine U256.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// Adds `other` to `self`, saturating at `U256.MAX`.
/// :param other: The right-hand operand.
/// :returns: The sum, or `U256.MAX` when the sum does not fit.
routine U256.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = uadd_sat<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`.
/// :param other: The right-hand operand.
/// :returns: The difference.
/// :throws: Crashes with `IntegerOverflowError` when `other` is greater than `self`, so the result would be below 0.
#track_caller
routine U256.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = usub_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, reporting underflow instead of crashing.
/// :param other: The right-hand operand.
/// :returns: The difference.
/// :absent: `other` is greater than `self`, so the result would be below 0.
routine U256.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = usub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Subtracts `other` from `self`, wrapping modulo 2^256.
/// :param other: The right-hand operand.
/// :returns: The difference modulo 2^256.
routine U256.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, saturating at 0.
/// :param other: The right-hand operand.
/// :returns: The difference, or 0 when `other` is greater than `self`.
routine U256.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = usub_sat<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`.
/// :param other: The right-hand operand.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product exceeds `U256.MAX`.
#track_caller
routine U256.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = self.mul_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, reporting overflow instead of crashing.
/// :param other: The right-hand operand.
/// :returns: The product.
/// :absent: The product exceeds `U256.MAX`.
routine U256.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = self.mul_overflows(other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Multiplies `self` by `other`, wrapping modulo 2^256.
/// :param other: The right-hand operand.
/// :returns: The product modulo 2^256.
routine U256.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, saturating at `U256.MAX`.
/// :param other: The right-hand operand.
/// :returns: The product, or `U256.MAX` when the product does not fit.
routine U256.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = self.mul_overflows(other)
        product  : Self = mul<Self>(self, other)
        r        : Self = overflow
            ? Self.MAX
            : product
        return(r)

/// Whether the exact product of `self` and `other` exceeds `U256.MAX`.
/// :param other: The right-hand operand.
/// :returns: `true` when the product does not fit in `U256`.
/// :note: The product overflows exactly when dividing the wrapped product by `self` does not give back `other`.
routine U256.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? return(false)
            : continue
        product : Self = mul<Self>(self, other)
        back    : Self = product.div(self)
        r       : Bool = back.ne(other)
        return(r)

// -- division --------------------------------------------------------------------

/// Divides `self` by `other`, rounding down.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U256.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Self = wide_div(self, other)
        return(r)

/// The remainder of `self` divided by `other`.
/// :param other: The divisor.
/// :returns: The remainder, from 0 to `other - 1`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U256.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Self = wide_rem(self, other)
        return(r)

/// Divides `self` by `other`, rounding down, reporting a zero divisor instead of crashing.
/// :param other: The divisor.
/// :returns: The quotient.
/// :absent: `other` is 0.
routine U256.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = wide_div(self, other)
        return(Option<Self>.Present(r))

/// Remainder of `self` divided by `other`, reporting a zero divisor instead of crashing.
/// :param other: The divisor.
/// :returns: The remainder, from 0 to `other - 1`.
/// :absent: `other` is 0.
routine U256.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = wide_rem(self, other)
        return(Option<Self>.Present(r))

/// Divides `self` by `other`, rounding up.
/// :param other: The divisor.
/// :returns: The quotient, rounded up.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
routine U256.div_ceil(self: Self, other: Self) -> Self
    block entry()
        q     : Self = self.div(other)
        rem   : Self = wide_rem(self, other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(q)
            : continue
        r : Self = add<Self>(q, 1)
        return(r)

/// The smallest multiple of `other` that is greater than or equal to `self`.
/// :param other: The value whose multiple is wanted.
/// :returns: `self` rounded up to a multiple of `other`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when the multiple exceeds `U256.MAX`.
routine U256.next_multiple_of(self: Self, other: Self) -> Self
    block entry()
        rem   : Self = self.mod(other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(self)
            : continue
        gap : Self = sub<Self>(other, rem)
        r   : Self = self.add(gap)
        return(r)

/// The smallest power of two greater than or equal to `self`. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :throws: Crashes with `IntegerOverflowError` when the power of two exceeds `U256.MAX`.
#track_caller
routine U256.next_power_of_two(self: Self) -> Self
    block entry()
        r : Option<Self> = self.next_power_of_two_checked()
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// The smallest power of two greater than or equal to `self`, reporting overflow instead of crashing. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :absent: The power of two exceeds `U256.MAX`.
routine U256.next_power_of_two_checked(self: Self) -> Option<Self>
    block entry()
        small : Bool = self.le(1)
        branch small
            ? return(Option<Self>.Present(1))
            : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up()
        below : Self = sub<Self>(self, 1)
        lz    : Self = clz<Self>(below, true)
        shift : Self = sub<Self>(Self.BITS, lz)
        fits  : Bool = shift.lt(Self.BITS)
        branch fits
            ? continue
            : return(Option<Self>.Absent)
        power : Self = shl<Self>(1, shift)
        return(Option<Self>.Present(power))

// -- powers ----------------------------------------------------------------------

/// Raises `self` to the power `exponent`. Any value to the power 0 is 1.
/// :param exponent: The power to raise `self` to.
/// :returns: `self` to the power `exponent`.
/// :throws: Crashes with `IntegerOverflowError` when the power exceeds `U256.MAX`.
#track_caller
routine U256.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `self` to the power `exponent` by squaring, wrapping modulo 2^256.
/// :param exponent: The power to raise `self` to.
/// :returns: The power modulo 2^256.
routine U256.pow_wrap(self: Self, exponent: U32) -> Self
    shared base : @Self <- self
    shared acc  : @Self <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc.load(), base.load())
        next_acc  : Self = odd
            ? with_base
            : acc.load()
        next_acc2 : Self = next_acc
        next_base : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Raises `self` to the power `exponent` by squaring, reporting overflow instead of crashing.
/// :param exponent: The power to raise `self` to.
/// :returns: `self` to the power `exponent`.
/// :absent: The power exceeds `U256.MAX`.
routine U256.pow_checked(self: Self, exponent: U32) -> Option<Self>
    shared base     : @Self <- self
    shared acc      : @Self <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = acc.load().mul_overflows(base.load()).bitand(odd)
        with_base    : Self = mul<Self>(acc.load(), base.load())
        next_acc     : Self = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = base.load().mul_overflows(base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Self = next_acc
        next_base     : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool         = overflow.load().bitnot()
        r    : Option<Self> = fits.then_present(acc.load())
        return(r)

/// Raises `self` to the power `exponent`, saturating at `U256.MAX`.
/// :param exponent: The power to raise `self` to.
/// :returns: The power, or `U256.MAX` when it does not fit.
routine U256.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(Self.MAX)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Whether `self` and `other` hold the same value.
/// :param other: The right-hand operand.
/// :returns: `true` when the values are equal.
routine U256.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Whether `self` and `other` hold different values.
/// :param other: The right-hand operand.
/// :returns: `true` when the values differ.
routine U256.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Whether `self` is less than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ult i256 {self}, {other}")]
routine U256.lt(self: Self, other: Self) -> Bool

/// Whether `self` is less than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ule i256 {self}, {other}")]
routine U256.le(self: Self, other: Self) -> Bool

/// Whether `self` is greater than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ugt i256 {self}, {other}")]
routine U256.gt(self: Self, other: Self) -> Bool

/// Whether `self` is greater than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp uge i256 {self}, {other}")]
routine U256.ge(self: Self, other: Self) -> Bool

/// Compares `self` with `other` as unsigned values.
/// :param other: The right-hand operand.
/// :returns: -1 when `self` is less than `other`, 0 when they are equal, and 1 when `self` is greater.
routine U256.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// The smaller of `self` and `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: The lesser operand.
routine U256.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = umin<Self>(self, other)
        return(r)

/// The larger of `self` and `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: The greater operand.
routine U256.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = umax<Self>(self, other)
        return(r)

/// Limits `self` to the range from `lo` to `hi`, both ends included.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `self` is below it, `hi` when `self` is above it, else `self`.
/// :throws: Crashes with `InvalidValueError` when `lo` is greater than `hi`.
#track_caller
routine U256.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Self = umax<Self>(self, lo)
        r           : Self = umin<Self>(at_least_lo, hi)
        return(r)

/// True when `self` is in `lo ..= hi`, both ends included. False when `lo` is greater than `hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: `true` when `lo <= self` and `self <= hi`.
routine U256.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// True when `self` is in `lo ..< end`: `lo` included, `end` not. False when `lo` is greater than or equal to `end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: `true` when `lo <= self` and `self < end`.
routine U256.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the 32 bytes under the process key, the same hash for S256 and U256.
/// :returns: The 64-bit hash of `self`.
routine U256.hash(self: Self) -> U64
    block entry()
        claim bits : @Self <- self
        h : U64 = siphash24(bits.to<@Byte>(), 32, hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The absolute difference of `self` and `other`, which always fits in `U256`.
/// :param other: The right-hand operand.
/// :returns: `|self - other|`.
routine U256.abs_diff(self: Self, other: Self) -> Self
    block entry()
        hi   : Self = umax<Self>(self, other)
        lo   : Self = umin<Self>(self, other)
        diff : Self = sub<Self>(hi, lo)
        r    : Self = bitcast<Self, Self>(diff)
        return(r)

/// The midpoint of `self` and `other`, rounded down, computed without overflow.
/// :param other: The right-hand operand.
/// :returns: `floor((self + other) / 2)`.
routine U256.midpoint(self: Self, other: Self) -> Self
    block entry()
        common    : Self = self.bitand(other)
        half_diff : Self = self.bitxor(other).shr(1)
        r         : Self = add<Self>(common, half_diff)
        return(r)

/// The base-2 logarithm of `self`, rounded down.
/// :returns: `floor(log2(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0.
#track_caller
routine U256.ilog2(self: Self) -> Self
    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? crash_numeric_domain()
            : continue
        lz : Self = clz<Self>(self, true)
        r  : Self = sub<Self>(Self.BITS.sub(1), lz)
        return(r)

/// The base-10 logarithm of `self`, rounded down.
/// :returns: `floor(log10(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0.
#track_caller
routine U256.ilog10(self: Self) -> Self
    shared digits : @Self <- 0

    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? crash_numeric_domain()
            : loop(self)

    block loop(rest: Self)
        last : Bool = rest.lt(10)
        branch last
            ? return(digits.load())
            : continue
        digits.load().add(1).store_into(digits)
        jump loop(rest.div(10))

/// The square root of `self`, rounded down, computed one result bit at a time.
/// :returns: `floor(sqrt(self))`.
routine U256.isqrt(self: Self) -> Self
    block entry()
        top_bit : Self = shl<Self>(1, Self.BITS.sub(2))
        jump align(top_bit)

    // Start from the highest power of four that is <= self.
    block align(bit: Self)
        too_big : Bool = bit.gt(self)
        branch too_big
            ? align(bit.shr(2))
            : loop(self, 0, bit)

    block loop(rest: Self, root: Self, bit: Self)
        done : Bool = bit.eq(0)
        branch done
            ? return(root)
            : continue
        trial     : Self = add<Self>(root, bit)
        fits      : Bool = rest.ge(trial)
        half_root : Self = root.shr(1)
        next_bit  : Self = bit.shr(2)
        branch fits
            ? take(rest, trial, half_root, bit, next_bit) \
            : loop(rest, half_root, next_bit)

    block take(rest: Self, trial: Self, half_root: Self, bit: Self, next_bit: Self)
        jump loop(sub<Self>(rest, trial), add<Self>(half_root, bit), next_bit)

// -- conversions -----------------------------------------------------------------

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Converts `self` to `S8`.
/// :returns: The same numeric value as an `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine U256.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.le(127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8` if the value is in that type's range.
/// :returns: The value as an `S8`.
/// :absent: The value does not fit in `S8`.
routine U256.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.le(127)
        value : S8         = trunc<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `self` to `S8` by keeping the low bits (modulo 2^8).
/// :returns: The low bits of `self`, read as an `S8`.
routine U256.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8`, saturating at `S8.MAX`.
/// :returns: The value, or `S8.MAX` when it is greater.
routine U256.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_most : Self = umin<Self>(self, 127)
        r       : S8   = trunc<Self, S8>(at_most)
        return(r)

