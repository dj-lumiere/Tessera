// Tessera stdlib: Option<T> and KVPair<K, V>
//
// Option<T> is a value that may be absent. It is the return type of every
// collection iterator's next(). Read it with when
//
//     when item
//         .Present(value) -> use(value)
//         .Absent          -> done()
//
// Absent is the first case, so a zeroed Option is Absent and Absent orders
// before every Present.
//
// KVPair<K, V> is a plain value pair used by Dict and SortedDict iterators.

module Standard::Core

import Standard::Format

// -- Option --------------------------------------------------------------------

/// A value that may be absent, and the return type of every iterator's `next`. Read it with `when`: `.Present(value)` carries the value and `.Absent` means none. `Absent` is the first case, so a zeroed `Option` is `Absent` and `Absent` orders before every `Present`.
/// :typeparam T: The type of the present value.
#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
variant Option<T>
require T: typename
    Absent
    Present : T

/// Whether `self` holds a value.
/// :typeparam T: The type of the present value.
/// :returns: `true` for `.Present`, `false` for `.Absent`.
routine Option<T>.is_present(self: Self) -> Bool
require T: typename
    block entry()
        when self
            .Present -> return(true)
            .Absent  -> return(false)

/// Whether `self` holds no value.
/// :typeparam T: The type of the present value.
/// :returns: `true` for `.Absent`, `false` for `.Present`.
routine Option<T>.is_absent(self: Self) -> Bool
require T: typename
    block entry()
        when self
            .Present -> return(false)
            .Absent  -> return(true)

/// The value. Crashes if it's absent.
#track_caller
routine Option<T>.unwrap(self: Self) -> T
require T: typename
    block entry()
        when self
            .Present(value) -> return(value)
            .Absent         -> crash_absent_value()

/// The value if present, otherwise default.
routine Option<T>.unwrap_or(self: Self, default: T) -> T
require T: typename
    block entry()
        when self
            .Present(value) -> return(value)
            .Absent         -> return(default)

// -- KVPair --------------------------------------------------------------------

/// Yielded by Dict and SortedDict iterators.
#derive(Equatable, Hashable)
record KVPair<K, V>
require K: typename, V: typename
    key   : K
    value : V
