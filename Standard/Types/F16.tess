/// :see: {F16.to_checked<S32>} to get an absent value instead, {F16.to_clamp<S32>} to saturate.
#track_caller
routine F16.to<S32>(self: Self) -> S32
    block entry()
        fits : Bool = self.fits_int(-2147483648.0, 2147483648.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = fptosi_sat<Self, S32>(self)
        return(r)

