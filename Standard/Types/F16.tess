/// Converts to S64, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1]. The crash reports the caller's location.
/// :see: {F16.to_checked<S64>} to get an absent value instead, {F16.to_clamp<S64>} to saturate.
#track_caller
routine F16.to<S64>(me: Me) -> S64
    block entry()
        fits : Bool = me.is_trunc_in_range(-9223372036854775808.0, 9223372036854775808.0)
        branch fits
