// Tessera stdlib: F16 — 16-bit IEEE 754 half precision
//
// Maps to LLVM IR half. x86 has no F16 arithmetic, so LLVM computes in F32
// and rounds. The conversions call compiler-rt, which the builder links.

module Standard::Core

/// A 16-bit IEEE 754 binary16 floating-point number (half precision), mapped to LLVM `half`.
/// It has an 11-bit significand (about 3 significant decimal digits) and finite magnitudes up to 65504.
/// :note: Targets without F16 arithmetic (x86) compute in F32 and round back, which gives the same correctly rounded result.
/// :see: {BF16} for F32's range at lower precision.
#llvm("half")
record F16
conform Equatable<F16>, Comparable<F16>, Hashable<F16>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7C00`): the result of overflow and of dividing a positive value by +0.0.
preset F16.INFINITY:     F16 = F16.from_bits(0x7C00)  // +inf bits
/// Negative infinity (bits `0xFC00`).
preset F16.NEG_INFINITY: F16 = F16.from_bits(0xFC00)  // -inf bits
/// The canonical quiet NaN (bits `0x7E00`).
/// :note: NaN is unequal to everything, itself included, so test for it with {F16.is_nan}, not `eq`.
preset F16.NAN:          F16 = F16.from_bits(0x7E00)  // canonical quiet NaN bits

// -- runtime support ---------------------------------------------------------

// x86 has no F16 arithmetic, so LLVM computes in F32 and converts with these
// compiler-rt routines. The Windows build of compiler-rt passes half values in
// integer registers while LLVM passes them in SSE registers, so the stdlib
// provides its own under the same names.

/// Windows-only replacement for compiler-rt's `__extendhfsf2`, exported under that name: widens F16 to F32 exactly.
/// :param x: The F16 to widen.
/// :returns: The same value as an F32.
/// :note: LLVM calls it on x86, which computes F16 arithmetic in F32. The Windows compiler-rt passes half values in integer registers where LLVM uses SSE registers.
#[export("__extendhfsf2"), target(os: "windows")]
private routine export_extendhfsf2(x: F16) -> F32
    block entry()
        r : F32 = x.to<F32>()
        return(r)

/// Windows-only replacement for compiler-rt's `__truncsfhf2`, exported under that name: narrows F32 to F16, rounding to nearest (ties to even).
/// :param x: The F32 to narrow.
/// :returns: The nearest F16.
/// :note: LLVM calls it on x86 to round F16 arithmetic computed in F32.
#[export("__truncsfhf2"), target(os: "windows")]
private routine export_truncsfhf2(x: F32) -> F16
    block entry()
        r : F16 = x.to<F16>()
        return(r)

/// Windows-only replacement for compiler-rt's `__truncdfhf2`, exported under that name: narrows F64 to F16, rounding once to nearest (ties to even).
/// :param x: The F64 to narrow.
/// :returns: The nearest F16.
#[export("__truncdfhf2"), target(os: "windows")]
private routine export_truncdfhf2(x: F64) -> F16
    block entry()
        r : F16 = x.to<F16>()
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
/// :returns: `me` with the sign bit cleared.
routine F16.abs(me: Me) -> Me
    block entry()
        r : Me = fabs<Me>(me)
        return(r)

/// The smaller value, or the other one if one operand is NaN.
/// :param other: The value to compare with.
/// :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine F16.min(me: Me, other: Me) -> Me
    block entry()
        smaller : F32 = me.to<F32>().min(other.to<F32>())
        r       : Me  = smaller.to<Me>()  // via F32 (exact)
        return(r)

/// The larger value, or the other one if one operand is NaN.
/// :param other: The value to compare with.
/// :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine F16.max(me: Me, other: Me) -> Me
    block entry()
        larger : F32 = me.to<F32>().max(other.to<F32>())
        r      : Me  = larger.to<Me>()  // via F32 (exact)
        return(r)

/// Adds `other` to `me`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine F16.add(me: Me, other: Me) -> Me
    block entry()
        r : Me = fadd<Me>(me, other)
        return(r)

/// Subtracts `other` from `me`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine F16.sub(me: Me, other: Me) -> Me
    block entry()
        r : Me = fsub<Me>(me, other)
        return(r)

/// Multiplies `me` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine F16.mul(me: Me, other: Me) -> Me
    block entry()
        r : Me = fmul<Me>(me, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `me` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.lt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = flt<Me>(me, other)
        return(r)

/// Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.le(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fle<Me>(me, other)
        return(r)

/// Whether `me` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.gt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fgt<Me>(me, other)
        return(r)

/// Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.ge(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fge<Me>(me, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `me` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine F16.div(me: Me, other: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(me, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine F16.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = feq<Me>(me, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ, false for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {F16.eq}.
routine F16.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fne<Me>(me, other)
        return(r)

/// Three-way comparison for the `Comparable` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {F16.total_compare} for a total order that ranks NaN and the signed zeros.
routine F16.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine F16.hash(me: Me) -> U64
    block entry()
        h : U64 = siphash24(me.bits().to<U64>(), hash_key())
        return(h)

// -- named widening conversion -------------------------------------------------

/// Widens to F64, exactly, through F32.
/// :returns: The same value as an F64. Every F16 is representable.
routine F16.to<F64>(me: Me) -> F64
    block entry()
        wide : F32 = me.to<F32>()
        r    : F64 = wide.to<F64>()
        return(r)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite F16, 65504 (bits `0x7BFF`).
preset F16.MAX:          F16 = F16.from_bits(0x7BFF)  // largest finite value
/// The most negative finite F16, the negation of `F16.MAX` (bits `0xFBFF`).
preset F16.MIN:          F16 = F16.from_bits(0xFBFF)  // most negative finite value
/// The smallest positive normal F16, 2^-14, about 6.1035156e-5 (bits `0x0400`). Subnormal values go below it.
preset F16.MIN_POSITIVE: F16 = F16.from_bits(0x0400)  // smallest positive normal value
/// The gap between 1.0 and the next larger F16, 2^-10, 0.0009765625 (bits `0x1400`).
preset F16.EPSILON:      F16 = F16.from_bits(0x1400)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest F16.
preset F16.PI: F16 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest F16.
preset F16.TAU: F16 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest F16.
preset F16.E: F16 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest F16.
preset F16.FRAC_PI_2: F16 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest F16.
preset F16.FRAC_PI_4: F16 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest F16.
preset F16.FRAC_1_PI: F16 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest F16.
preset F16.SQRT_2: F16 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest F16.
preset F16.FRAC_1_SQRT_2: F16 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest F16.
preset F16.LN_2: F16 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest F16.
preset F16.LN_10: F16 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest F16.
preset F16.LOG2_E: F16 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest F16.
preset F16.LOG10_E: F16 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine F16.neg(me: Me) -> Me
    block entry()
        r : Me = fneg<Me>(me)
        return(r)

/// The magnitude of `me` with the sign of `sign`.
/// :param sign: The value whose sign bit is used.
/// :returns: `me` with its sign bit replaced by the sign bit of `sign`.
routine F16.copysign(me: Me, sign: Me) -> Me
    block entry()
        r : Me = copysign<Me>(me, sign)
        return(r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
/// :returns: 1.0, -1.0, or NaN, by the sign of `me`.
routine F16.signum(me: Me) -> Me
    block entry()
        nan  : Bool = me.is_nan()
        unit : Me   = copysign<Me>(1.0, me)
        r    : Me   = nan
            ? me
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
/// :returns: Whether the sign bit is clear.
routine F16.is_sign_positive(me: Me) -> Bool
    block entry()
        bits : S16  = me.bits().to_wrap<S16>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine F16.is_sign_negative(me: Me) -> Bool
    block entry()
        bits : S16  = me.bits().to_wrap<S16>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of `me / other`, with the sign of `me` (C fmod, Rust's %). Exact: F32's remainder of the
/// same values is an F16.
/// :param other: The divisor.
/// :returns: The remainder. NaN when either operand is NaN, `me` is infinite, or `other` is 0. Otherwise `me`
///     itself when `other` is infinite or `me` is a zero.
routine F16.mod(me: Me, other: Me) -> Me
    block entry()
        remainder : F32 = me.to<F32>().mod(other.to<F32>())
        r         : Me  = remainder.to<Me>()
        return(r)

/// The reciprocal `1 / me`, rounded once.
/// :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine F16.recip(me: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(1.0, me)
        return(r)

/// `me * a + b`, rounded once. The product of two 11-bit significands is exact in F64. The sum is added
/// with round-to-odd ({f64_add_round_to_odd}), which the narrowing then rounds as it would the exact result.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
routine F16.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        product : F64 = me.to<F64>().mul(a.to<F64>())
        sum     : F64 = f64_add_round_to_odd(product, b.to<F64>())
        r       : Me  = sum.to<Me>()
        return(r)

/// The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
/// :param other: The divisor.
/// :returns: The quotient `q`. NaN when either operand is NaN.
routine F16.div_euclid(me: Me, other: Me) -> Me
    block entry()
        q            : Me   = me.div(other).trunc()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Me   = q.sub(1.0)
        up               : Me   = q.add(1.0)
        r                : Me   = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of `me / other`.
/// :param other: The divisor.
/// :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
///     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine F16.mod_euclid(me: Me, other: Me) -> Me
    block entry()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Me   = other.abs()
        r         : Me   = rem.add(magnitude)
        whole     : Bool = r.eq(magnitude).bitand(magnitude.is_finite())
        // a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
        // one in range
        branch whole
            ? return(Me.from_bits(magnitude.bits().sub(1)))
            : return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
/// :param other: The value to compare with.
/// :returns: The smaller value, or NaN when either operand is NaN.
routine F16.minimum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitor(other.bits())))
            : continue
        pick : Bool = me.lt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
/// :param other: The value to compare with.
/// :returns: The larger value, or NaN when either operand is NaN.
routine F16.maximum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitand(other.bits())))
            : continue
        pick : Bool = me.gt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// Restricts `me` to `lo ..= hi`. NaN stays NaN.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` unless `lo <= hi`, so also when either bound is NaN.
#track_caller
routine F16.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        below : Bool = me.lt(lo)
        above : Bool = me.gt(hi)
        upper : Me   = above
            ? hi
            : me
        r : Me = below
            ? lo
            : upper
        return(r)

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`. False when any operand is NaN.
routine F16.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`. False when any operand is NaN.
routine F16.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as `me` comes before, at the same place as, or after `other` in that order.
routine F16.total_compare(me: Me, other: Me) -> S32
    block entry()
        a : S16 = me.bits().to_wrap<S16>()
        b : S16 = other.bits().to_wrap<S16>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S16 = a.bitxor(a.shr(15).bitand(S16.MAX))
        b_key : S16 = b.bitxor(b.shr(15).bitand(S16.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

/// Rounds toward negative infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
routine F16.floor(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.floor().to<Me>()
        return(r)

/// Rounds toward positive infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine F16.ceil(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.ceil().to<Me>()
        return(r)

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
routine F16.round(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.round().to<Me>()
        return(r)

/// Rounds half-way cases to the even neighbor.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
routine F16.round_ties_even(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.round_ties_even().to<Me>()
        return(r)

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
routine F16.trunc(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.trunc().to<Me>()
        return(r)

/// `me` minus its integer part, with the sign of `me`.
/// :returns: The fractional part. NaN for an infinity or NaN.
routine F16.fract(me: Me) -> Me
    block entry()
        whole : Me = me.trunc()
        r     : Me = me.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in Standard/F16Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// The square root of `me`.
/// :returns: The square root: NaN for negative values other than -0.0, which gives -0.0.
routine F16.sqrt(me: Me) -> Me
    block entry()
        wide : F32 = me.to<F32>()
        r    : Me  = wide.sqrt().to<Me>()
        return(r)

/// me raised to an integer power, correctly rounded. The F64 power (n converts exactly) rounds correctly to
/// F16 unless it lands exactly on an F16 midpoint. There the F128 power decides (checked for every x and n that
/// reach it).
/// :param n: The integer exponent.
/// :returns: `me` to the power `n`, rounded once.
routine F16.powi(me: Me, n: S32) -> Me
    block entry()
        r   : F64  = me.to<F64>().powf(n.to<F64>())
        tie : Bool = f16_is_on_midpoint_f64(r)
        branch tie
            ? exact()
            : return(r.to<Me>())

    block exact()
        r : F128 = me.to<F128>().powf(n.to<F128>())
        return(r.to<Me>())

/// Whether r lies exactly between two F16 values.
/// :param r: The F64 value to test.
/// :returns: True when `r` is finite and lies exactly halfway between two adjacent F16 values.
private routine f16_is_on_midpoint_f64(r: F64) -> Bool
    shared a : F64 = r.abs()

    block entry()
        sub : Bool = a.lt(0x1p-14)
        branch sub
            ? subnormal()
            : normal()

    // F16 keeps 10 fraction bits: a midpoint has bit 41 set and nothing below it.
    block normal()
        low : U64  = a.bits().bitand(0x3FFFFFFFFFF)
        mid : Bool = a.is_finite().bitand(low.eq(0x20000000000))
        return(mid)

    // Below 2^-14 F16's quantum is 2^-24: a midpoint is an odd multiple of 2^-25.
    block subnormal()
        t     : F64  = a.mul(0x1p25)
        whole : Bool = t.trunc().eq(t)
        odd   : Bool = t.mod(2.0).eq(1.0)
        return(whole.bitand(odd))

/// The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even): the
/// quotient of the correctly rounded F64 logarithms, rounded once to F16. That quotient is within 3 × 2^-53 relative of
/// the true value, and over every pair of positive finite F16 inputs no true value lies closer than 2^-41.2 relative to
/// an F16 midpoint (subnormal results included), so the one rounding is always the correct one.
/// :param base: The base of the logarithm.
/// :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the quotient of the
///     logarithms: NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for `me` 1 or base
///     0 or +inf, NaN when both logarithms are zero or both infinite.
/// :note: The scan behind it checked all 1,007,554,564 pairs (bases and arguments other than 1), with the 164 pairs
///     closer than 2^-34 to a midpoint compared against mpmath.
routine F16.log(me: Me, base: Me) -> Me
    block entry()
        q : F64 = me.to<F64>().ln().div(base.to<F64>().ln())
        return(q.to<Me>())

// -- special functions ---------------------------------------------------------

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to F16).
/// :returns: `me` in degrees, rounded once.
routine F16.to_degrees(me: Me) -> Me
    block entry()
        r : Me = me.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to F16).
/// :returns: `me` in radians, rounded once.
routine F16.to_radians(me: Me) -> Me
    block entry()
        r : Me = me.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- classification ------------------------------------------------------------

/// Whether `me` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine F16.is_nan(me: Me) -> Bool
    block entry()
        r : Bool = funo<Me>(me, me)
        return(r)

/// Whether `me` is +inf or -inf.
/// :returns: True for either infinity, false for NaN and finite values.
routine F16.is_infinite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.eq(Me.INFINITY)
        return(r)

/// Neither infinite nor NaN.
/// :returns: True for zeros, subnormals and normal values. False for infinities and NaN.
routine F16.is_finite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.lt(Me.INFINITY)
        return(r)

/// Not zero, subnormal, infinite, or NaN.
/// :returns: True when the exponent field is neither all zeros nor all ones.
routine F16.is_normal(me: Me) -> Bool
    block entry()
        exponent : U16  = me.bits().bitand(0x7C00)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7C00))
        return(r)

/// Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `F16.MIN_POSITIVE`.
/// :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine F16.is_subnormal(me: Me) -> Bool
    block entry()
        bits     : U16  = me.bits()
        exponent : U16  = bits.bitand(0x7C00)
        mantissa : U16  = bits.bitand(0x03FF)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
/// :returns: The encoding as a U16: sign bit at the top, then the exponent field, then the fraction.
routine F16.bits(me: Me) -> U16
    block entry()
        r : U16 = bitcast<Me, U16>(me)
        return(r)

/// Reinterprets raw IEEE 754 binary16 bits as a F16, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {F16.bits} for the inverse.
routine F16.from_bits(bits: U16) -> Me
    block entry()
        r : Me = bitcast<U16, Me>(bits)
        return(r)

// -- float conversions -----------------------------------------------------------

/// The identity conversion, so generic code can call `to<T>()` when `T` is F16.
/// :returns: `me` unchanged.
routine F16.to<Me>(me: Me) -> Me
    block entry()
        return(me)

/// Converts to BF16 by widening to F32 exactly and rounding once to nearest (ties to even).
/// :returns: The nearest BF16: BF16 covers F16's range but keeps only 8 significant bits, so low bits may round off.
routine F16.to<BF16>(me: Me) -> BF16
    block entry()
        wide : F32  = me.to<F32>()
        r    : BF16 = wide.to<BF16>()
        return(r)

/// Widens to F32 exactly. Written with integer operations instead of fpext, which would call
/// compiler-rt's `__extendhfsf2` (on Windows the stdlib's own replacement for it is built on this routine).
/// :returns: The same value as an F32. Every F16 is representable.
routine F16.to<F32>(me: Me) -> F32
    shared bits     : U32 = me.bits().to<U32>()
    shared sign     : U32 = bits.bitand(0x8000).shl(16)
    shared exponent : U32 = bits.shr(10).bitand(0x1F)
    shared mantissa : U32 = bits.bitand(0x3FF)

    block entry()
        when
            exponent.eq(0x1F) -> special()
            exponent.eq(0)    -> small()
            else              -> normal()

    block special()
        r : F32 = .from_bits(sign.bitor(0x7F800000).bitor(mantissa.shl(13)))
        return(r)

    block normal()
        r : F32 = .from_bits(sign.bitor(exponent.add(112).shl(23)).bitor(mantissa.shl(13)))
        return(r)

    // Zero or subnormal: the value is mantissa * 2^-24, which F32 holds exactly.
    block small()
        value     : F32 = mantissa.to<F32>().mul(0.000000059604644775390625)
        magnitude : U32 = value.bits()
        r         : F32 = .from_bits(magnitude.bitor(sign))
        return(r)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_<int>_checked returns None instead and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {F16.to_checked<S8>} to get an absent value instead, {F16.to_clamp<S8>} to saturate.
#track_caller
routine F16.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.is_trunc_in_range(-128.0, 128.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-128, 127].
/// :see: {F16.to<S8>} to crash instead, {F16.to_clamp<S8>} to saturate.
routine F16.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.is_trunc_in_range(-128.0, 128.0)
        value : S8         = fptosi_sat<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S8>} to detect values that do not fit.
routine F16.to_clamp<S8>(me: Me) -> S8
    block entry()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {F16.to_checked<S16>} to get an absent value instead, {F16.to_clamp<S16>} to saturate.
#track_caller
routine F16.to<S16>(me: Me) -> S16
    block entry()
        fits : Bool = me.is_trunc_in_range(-32768.0, 32768.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = fptosi_sat<Me, S16>(me)
        return(r)

/// Converts to S16, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-32768, 32767].
/// :see: {F16.to<S16>} to crash instead, {F16.to_clamp<S16>} to saturate.
routine F16.to_checked<S16>(me: Me) -> Option<S16>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-32768.0, 32768.0)
        value : S16         = fptosi_sat<Me, S16>(me)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts to S16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S16>} to detect values that do not fit.
routine F16.to_clamp<S16>(me: Me) -> S16
    block entry()
        r : S16 = fptosi_sat<Me, S16>(me)
        return(r)

/// Converts to S32, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1]. The crash reports the caller's location.
/// :see: {F16.to_checked<S32>} to get an absent value instead, {F16.to_clamp<S32>} to saturate.
#track_caller
routine F16.to<S32>(me: Me) -> S32
    block entry()
        fits : Bool = me.is_trunc_in_range(-2147483648.0, 2147483648.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = fptosi_sat<Me, S32>(me)
        return(r)

/// Converts to S32, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^31, 2^31 - 1].
/// :see: {F16.to<S32>} to crash instead, {F16.to_clamp<S32>} to saturate.
routine F16.to_checked<S32>(me: Me) -> Option<S32>
    block entry()
