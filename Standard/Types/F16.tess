// F16 to a 128-bit integer goes through F32 (exact): LLVM 21 at -O0 on AArch64 lowers the saturating half to i128
// conversion to one 64-bit fcvtzs/fcvtzu and leaves the high word 0 or unset, so -1 came back as 2^64 - 1.
/// Converts to S128, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [-2^127, 2^127 - 1]. The crash reports the caller's location.
/// :see: {F16.to_checked<S128>} to get an absent value instead, {F16.to_clamp<S128>} to saturate.
#track_caller
routine F16.to<S128>(self: Self) -> S128
    block entry()
        fits : Bool = self.fits_int(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S128 = fptosi_sat<F32, S128>(self.to<F32>())
        return(r)

/// Converts to S128, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
/// :see: {F16.to<S128>} to crash instead, {F16.to_clamp<S128>} to saturate.
routine F16.to_checked<S128>(self: Self) -> Option<S128>
    block entry()
        fits  : Bool         = self.fits_int(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        value : S128         = fptosi_sat<F32, S128>(self.to<F32>())
        r     : Option<S128> = fits.then_present(value)
        return(r)

/// Converts to S128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-2^127, 2^127 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S128>} to detect values that do not fit.
routine F16.to_clamp<S128>(self: Self) -> S128
    block entry()
        r : S128 = fptosi_sat<F32, S128>(self.to<F32>())
        return(r)

