// Tessera stdlib: F16 — 16-bit IEEE 754 half precision
//
// Maps to LLVM IR half. x86 has no F16 arithmetic, so LLVM computes in F32
// and rounds. The conversions call compiler-rt, which the builder links.

module Standard::Core

/// A 16-bit IEEE 754 binary16 floating-point number (half precision), mapped to LLVM `half`.
/// It has an 11-bit significand (about 3 significant decimal digits) and finite magnitudes up to 65504.
/// :note: Targets without F16 arithmetic (x86) compute in F32 and round back, which gives the same correctly rounded result.
/// :see: {BF16} for F32's range at lower precision.
#llvm("half")
record F16
conform Equatable<F16>, Comparable<F16>, Hashable<F16>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7C00`): the result of overflow and of dividing a positive value by +0.0.
preset F16.INFINITY:     F16 = F16.from_bits(0x7C00)  // +inf bits
/// Negative infinity (bits `0xFC00`).
preset F16.NEG_INFINITY: F16 = F16.from_bits(0xFC00)  // -inf bits
/// The canonical quiet NaN (bits `0x7E00`).
/// :note: NaN is unequal to everything, itself included, so test for it with {F16.is_nan}, not `eq`.
preset F16.NAN:          F16 = F16.from_bits(0x7E00)  // canonical quiet NaN bits

// -- runtime support ---------------------------------------------------------

// x86 has no F16 arithmetic, so LLVM computes in F32 and converts with these
// compiler-rt routines. The Windows build of compiler-rt passes half values in
// integer registers while LLVM passes them in SSE registers, so the stdlib
// provides its own under the same names.

/// Windows-only replacement for compiler-rt's `__extendhfsf2`, exported under that name: widens F16 to F32 exactly.
/// :param x: The F16 to widen.
/// :returns: The same value as an F32.
/// :note: LLVM calls it on x86, which computes F16 arithmetic in F32. The Windows compiler-rt passes half values in integer registers where LLVM uses SSE registers.
#[export("__extendhfsf2"), target(os: "windows")]
private routine export_extendhfsf2(x: F16) -> F32
    block entry()
        r : F32 = x.to<F32>()
        return(r)

/// Windows-only replacement for compiler-rt's `__truncsfhf2`, exported under that name: narrows F32 to F16, rounding to nearest (ties to even).
/// :param x: The F32 to narrow.
/// :returns: The nearest F16.
/// :note: LLVM calls it on x86 to round F16 arithmetic computed in F32.
#[export("__truncsfhf2"), target(os: "windows")]
private routine export_truncsfhf2(x: F32) -> F16
    block entry()
        r : F16 = x.to<F16>()
        return(r)

/// Windows-only replacement for compiler-rt's `__truncdfhf2`, exported under that name: narrows F64 to F16, rounding once to nearest (ties to even).
/// :param x: The F64 to narrow.
/// :returns: The nearest F16.
#[export("__truncdfhf2"), target(os: "windows")]
private routine export_truncdfhf2(x: F64) -> F16
    block entry()
        r : F16 = x.to<F16>()
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine F16.abs(self: Self) -> Self
    block entry()
        r : Self = fabs<Self>(self)
        return(r)

/// The smaller value, or the other one if one operand is NaN.
routine F16.min(self: Self, other: Self) -> Self
    block entry()
        smaller : F32  = self.to<F32>().min(other.to<F32>())
        r       : Self = smaller.to<Self>()  // via F32 (exact)
        return(r)

/// The larger value, or the other one if one operand is NaN.
routine F16.max(self: Self, other: Self) -> Self
    block entry()
        larger : F32  = self.to<F32>().max(other.to<F32>())
        r      : Self = larger.to<Self>()  // via F32 (exact)
        return(r)

/// Adds `other` to `self`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `self + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine F16.add(self: Self, other: Self) -> Self
    block entry()
        r : Self = fadd<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `self - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine F16.sub(self: Self, other: Self) -> Self
    block entry()
        r : Self = fsub<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `self * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine F16.mul(self: Self, other: Self) -> Self
    block entry()
        r : Self = fmul<Self>(self, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `self` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self < other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.lt(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = flt<Self>(self, other)
        return(r)

/// Whether `self` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self <= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.le(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fle<Self>(self, other)
        return(r)

/// Whether `self` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self > other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.gt(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fgt<Self>(self, other)
        return(r)

/// Whether `self` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self >= other`, or false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F16.ge(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fge<Self>(self, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `self` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `self / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine F16.div(self: Self, other: Self) -> Self
    block entry()
        r : Self = fdiv<Self>(self, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine F16.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = feq<Self>(self, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ, false for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {F16.eq}.
routine F16.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = fne<Self>(self, other)
        return(r)

/// Three-way comparison for the `Comparable` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `self < other`, 1 when `self > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {F16.total_compare} for a total order that ranks NaN and the signed zeros.
routine F16.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine F16.hash(self: Self) -> U64
    block entry()
        h : U64 = siphash24(self.bits().to<U64>(), hash_key())
        return(h)

// -- named widening conversion -------------------------------------------------

/// Widens to F64, exactly, through F32.
/// :returns: The same value as an F64. Every F16 is representable.
routine F16.to<F64>(self: Self) -> F64
    block entry()
        wide : F32 = self.to<F32>()
        r    : F64 = wide.to<F64>()
        return(r)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite F16, 65504 (bits `0x7BFF`).
preset F16.MAX:          F16 = F16.from_bits(0x7BFF)  // largest finite value
/// The most negative finite F16, the negation of `F16.MAX` (bits `0xFBFF`).
preset F16.MIN:          F16 = F16.from_bits(0xFBFF)  // most negative finite value
/// The smallest positive normal F16, 2^-14, about 6.1035156e-5 (bits `0x0400`). Subnormal values go below it.
preset F16.MIN_POSITIVE: F16 = F16.from_bits(0x0400)  // smallest positive normal value
/// The gap between 1.0 and the next larger F16, 2^-10, 0.0009765625 (bits `0x1400`).
preset F16.EPSILON:      F16 = F16.from_bits(0x1400)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest F16.
preset F16.PI: F16 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest F16.
preset F16.TAU: F16 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest F16.
preset F16.E: F16 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest F16.
preset F16.FRAC_PI_2: F16 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest F16.
preset F16.FRAC_PI_4: F16 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest F16.
preset F16.FRAC_1_PI: F16 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest F16.
preset F16.SQRT_2: F16 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest F16.
preset F16.FRAC_1_SQRT_2: F16 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest F16.
preset F16.LN_2: F16 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest F16.
preset F16.LN_10: F16 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest F16.
preset F16.LOG2_E: F16 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest F16.
preset F16.LOG10_E: F16 = 0.434294481903251827651128918916605082  // log10(e)

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-self`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine F16.neg(self: Self) -> Self
    block entry()
        r : Self = fneg<Self>(self)
        return(r)

/// The magnitude of self with the sign of sign.
routine F16.copysign(self: Self, sign: Self) -> Self
    block entry()
        r : Self = copysign<Self>(self, sign)
        return(r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine F16.signum(self: Self) -> Self
    block entry()
        nan  : Bool = self.is_nan()
        unit : Self = copysign<Self>(1.0, self)
        r    : Self = nan
            ? self
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine F16.is_sign_positive(self: Self) -> Bool
    block entry()
        bits : S16  = self.bits().to_wrap<S16>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine F16.is_sign_negative(self: Self) -> Bool
    block entry()
        bits : S16  = self.bits().to_wrap<S16>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of self / other, with the sign of self (C fmod, Rust's %). Exact: F32's remainder of the
/// same values is an F16.
routine F16.mod(self: Self, other: Self) -> Self
    block entry()
        remainder : F32  = self.to<F32>().mod(other.to<F32>())
        r         : Self = remainder.to<Self>()
        return(r)

/// The reciprocal `1 / self`, rounded once.
/// :returns: `1 / self`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine F16.recip(self: Self) -> Self
    block entry()
        r : Self = fdiv<Self>(1.0, self)
        return(r)

/// self * a + b, rounded once. The product of two 11-bit significands is exact in F64. The sum is added
/// with round-to-odd (f64_add_round_to_odd), which the narrowing then rounds as it would the exact result.
routine F16.mul_add(self: Self, a: Self, b: Self) -> Self
    block entry()
        product : F64  = self.to<F64>().mul(a.to<F64>())
        sum     : F64  = f64_add_round_to_odd(product, b.to<F64>())
        r       : Self = sum.to<Self>()
        return(r)

/// The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine F16.div_euclid(self: Self, other: Self) -> Self
    block entry()
        q            : Self = self.div(other).trunc()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Self = q.sub(1.0)
        up               : Self = q.add(1.0)
        r                : Self = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of self / other.
routine F16.mod_euclid(self: Self, other: Self) -> Self
    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Self = other.abs()
        r         : Self = rem.add(magnitude)
        return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine F16.minimum(self: Self, other: Self) -> Self
    block entry()
        nan : Bool = self.is_nan().bitor(other.is_nan())
        branch nan
            ? return(self.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = self.eq(other)
        branch equal
            ? return(Self.from_bits(self.bits().bitor(other.bits())))
            : continue
        pick : Bool = self.lt(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine F16.maximum(self: Self, other: Self) -> Self
    block entry()
        nan : Bool = self.is_nan().bitor(other.is_nan())
        branch nan
            ? return(self.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = self.eq(other)
        branch equal
            ? return(Self.from_bits(self.bits().bitand(other.bits())))
            : continue
        pick : Bool = self.gt(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// Restricts self to lo ..= hi. NaN stays NaN. Crashes unless lo <= hi.
#track_caller
routine F16.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        below : Bool = self.lt(lo)
        above : Bool = self.gt(hi)
        upper : Self = above
            ? hi
            : self
        r : Self = below
            ? lo
            : upper
        return(r)

/// self in [lo, hi], both ends included. False when lo > hi.
routine F16.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine F16.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine F16.total_compare(self: Self, other: Self) -> S32
    block entry()
        a : S16 = self.bits().to_wrap<S16>()
        b : S16 = other.bits().to_wrap<S16>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S16 = a.bitxor(a.shr(15).bitand(S16.MAX))
        b_key : S16 = b.bitxor(b.shr(15).bitand(S16.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

/// Rounds toward negative infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The largest integer value not above `self`. Zeros, infinities and NaN come back unchanged.
routine F16.floor(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.floor().to<Self>()
        return(r)

/// Rounds toward positive infinity by widening to F32, rounding there, and narrowing back (exact).
/// :returns: The smallest integer value not below `self` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
routine F16.ceil(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.ceil().to<Self>()
        return(r)

/// Rounds half-way cases away from zero.
routine F16.round(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.round().to<Self>()
        return(r)

/// Rounds half-way cases to the even neighbor.
routine F16.round_ties_even(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.round_ties_even().to<Self>()
        return(r)

/// Rounds toward zero.
routine F16.trunc(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.trunc().to<Self>()
        return(r)

/// self minus its integer part, with the sign of self.
routine F16.fract(self: Self) -> Self
    block entry()
        whole : Self = self.trunc()
        r     : Self = self.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in Standard/F16Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// NaN for negative values (other than -0.0).
routine F16.sqrt(self: Self) -> Self
    block entry()
        wide : F32  = self.to<F32>()
        r    : Self = wide.sqrt().to<Self>()
        return(r)

/// self raised to an integer power, correctly rounded. The F64 power (n converts exactly) rounds correctly to
/// F16 unless it lands exactly on an F16 midpoint. There the F128 power decides (checked for every x and n that
/// reach it).
routine F16.powi(self: Self, n: S32) -> Self
    block entry()
        r   : F64  = self.to<F64>().powf(n.to<F64>())
        tie : Bool = f16_on_midpoint_f64(r)
        branch tie
            ? exact()
            : return(r.to<Self>())

    block exact()
        r : F128 = self.to<F128>().powf(n.to<F128>())
        return(r.to<Self>())

/// Whether r lies exactly between two F16 values.
private routine f16_on_midpoint_f64(r: F64) -> Bool
    shared a : F64 = r.abs()

    block entry()
        sub : Bool = a.lt(0x1p-14)
        branch sub
            ? subnormal()
            : normal()

    // F16 keeps 10 fraction bits: a midpoint has bit 41 set and nothing below it.
    block normal()
        low : U64  = a.bits().bitand(0x3FFFFFFFFFF)
        mid : Bool = a.is_finite().bitand(low.eq(0x20000000000))
        return(mid)

    // Below 2^-14 F16's quantum is 2^-24: a midpoint is an odd multiple of 2^-25.
    block subnormal()
        t     : F64  = a.mul(0x1p25)
        whole : Bool = t.trunc().eq(t)
        odd   : Bool = t.mod(2.0).eq(1.0)
        return(whole.bitand(odd))

/// The logarithm with an arbitrary base.
routine F16.log(self: Self, base: Self) -> Self
    block entry()
        num : Self = self.ln()
        den : Self = base.ln()
        r   : Self = num.div(den)
        return(r)

// -- special functions ---------------------------------------------------------

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to F16).
/// :returns: `self` in degrees, rounded once.
routine F16.to_degrees(self: Self) -> Self
    block entry()
        r : Self = self.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to F16).
/// :returns: `self` in radians, rounded once.
routine F16.to_radians(self: Self) -> Self
    block entry()
        r : Self = self.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- classification ------------------------------------------------------------

/// Whether `self` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine F16.is_nan(self: Self) -> Bool
    block entry()
        r : Bool = funo<Self>(self, self)
        return(r)

/// Whether `self` is +inf or -inf.
/// :returns: True for either infinity, false for NaN and finite values.
routine F16.is_infinite(self: Self) -> Bool
    block entry()
        magnitude : Self = fabs<Self>(self)
        r         : Bool = magnitude.eq(Self.INFINITY)
        return(r)

/// Neither infinite nor NaN.
routine F16.is_finite(self: Self) -> Bool
    block entry()
        magnitude : Self = fabs<Self>(self)
        r         : Bool = magnitude.lt(Self.INFINITY)
        return(r)

/// Not zero, subnormal, infinite, or NaN.
routine F16.is_normal(self: Self) -> Bool
    block entry()
        exponent : U16  = self.bits().bitand(0x7C00)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7C00))
        return(r)

/// Whether `self` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `F16.MIN_POSITIVE`.
/// :returns: True for subnormals, false for zero, normal values, infinities and NaN.
routine F16.is_subnormal(self: Self) -> Bool
    block entry()
        bits     : U16  = self.bits()
        exponent : U16  = bits.bitand(0x7C00)
        mantissa : U16  = bits.bitand(0x03FF)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// The raw IEEE 754 bits.
routine F16.bits(self: Self) -> U16
    block entry()
        r : U16 = bitcast<Self, U16>(self)
        return(r)

/// Reinterprets raw IEEE 754 binary16 bits as a F16, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {F16.bits} for the inverse.
routine F16.from_bits(bits: U16) -> Self
    block entry()
        r : Self = bitcast<U16, Self>(bits)
        return(r)

// -- float conversions -----------------------------------------------------------

/// The identity conversion, so generic code can call `to<T>()` when `T` is F16.
/// :returns: `self` unchanged.
routine F16.to<Self>(self: Self) -> Self
    block entry()
        return(self)

/// Converts to BF16 by widening to F32 exactly and rounding once to nearest (ties to even).
/// :returns: The nearest BF16: BF16 covers F16's range but keeps only 8 significant bits, so low bits may round off.
routine F16.to<BF16>(self: Self) -> BF16
    block entry()
        wide : F32  = self.to<F32>()
        r    : BF16 = wide.to<BF16>()
        return(r)

/// Exact. Written with integer operations instead of fpext, which calls
/// compiler-rt's __extendhfsf2 (see the runtime support section).
routine F16.to<F32>(self: Self) -> F32
    shared bits     : U32 = self.bits().to<U32>()
    shared sign     : U32 = bits.bitand(0x8000).shl(16)
    shared exponent : U32 = bits.shr(10).bitand(0x1F)
    shared mantissa : U32 = bits.bitand(0x3FF)

    block entry()
        when
            exponent.eq(0x1F) -> special()
            exponent.eq(0)    -> small()
            else              -> normal()

    block special()
        r : F32 = .from_bits(sign.bitor(0x7F800000).bitor(mantissa.shl(13)))
        return(r)

    block normal()
        r : F32 = .from_bits(sign.bitor(exponent.add(112).shl(23)).bitor(mantissa.shl(13)))
        return(r)

    // Zero or subnormal: the value is mantissa * 2^-24, which F32 holds exactly.
    block small()
        value     : F32 = mantissa.to<F32>().mul(0.000000059604644775390625)
        magnitude : U32 = value.bits()
        r         : F32 = .from_bits(magnitude.bitor(sign))
        return(r)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_<int>_checked returns None instead and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {F16.to_checked<S8>} to get an absent value instead, {F16.to_clamp<S8>} to saturate.
#track_caller
routine F16.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.fits_int(-128.0, 128.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = fptosi_sat<Self, S8>(self)
        return(r)

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-128, 127].
/// :see: {F16.to<S8>} to crash instead, {F16.to_clamp<S8>} to saturate.
routine F16.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.fits_int(-128.0, 128.0)
        value : S8         = fptosi_sat<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S8>} to detect values that do not fit.
routine F16.to_clamp<S8>(self: Self) -> S8
    block entry()
        r : S8 = fptosi_sat<Self, S8>(self)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Crashes with `IntegerOverflowError` when `self` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {F16.to_checked<S16>} to get an absent value instead, {F16.to_clamp<S16>} to saturate.
#track_caller
routine F16.to<S16>(self: Self) -> S16
    block entry()
        fits : Bool = self.fits_int(-32768.0, 32768.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = fptosi_sat<Self, S16>(self)
        return(r)

/// Converts to S16, rounding toward zero, without crashing.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-32768, 32767].
/// :see: {F16.to<S16>} to crash instead, {F16.to_clamp<S16>} to saturate.
routine F16.to_checked<S16>(self: Self) -> Option<S16>
    block entry()
        fits  : Bool        = self.fits_int(-32768.0, 32768.0)
        value : S16         = fptosi_sat<Self, S16>(self)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts to S16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-32768, 32767]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S16>} to detect values that do not fit.
routine F16.to_clamp<S16>(self: Self) -> S16
    block entry()
