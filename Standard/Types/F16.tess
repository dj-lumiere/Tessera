/// Converts to S64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^63, 2^63 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S64>} to detect values that do not fit.
routine F16.to_clamp<S64>(me: Me) -> S64
    block entry()
        r : S64 = fptosi_sat<Me, S64>(me)
        return(r)

// F16 to a 128-bit integer goes through F32 (exact): LLVM 21 at -O0 on AArch64 lowers the saturating half to i128
// conversion to one 64-bit fcvtzs/fcvtzu and leaves the high word 0 or unset, so -1 came back as 2^64 - 1.
/// Converts to S128, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1]. The crash reports the caller's location.
/// :see: {F16.to_checked<S128>} to get an absent value instead, {F16.to_clamp<S128>} to saturate.
#track_caller
routine F16.to<S128>(me: Me) -> S128
    block entry()
        fits : Bool = me.is_trunc_in_range(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S128 = fptosi_sat<F32, S128>(me.to<F32>())
        return(r)

/// Converts to S128, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
/// :see: {F16.to<S128>} to crash instead, {F16.to_clamp<S128>} to saturate.
routine F16.to_checked<S128>(me: Me) -> Option<S128>
    block entry()
        fits  : Bool         = me.is_trunc_in_range(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        value : S128         = fptosi_sat<F32, S128>(me.to<F32>())
        r     : Option<S128> = fits.then_present(value)
        return(r)

/// Converts to S128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-2^127, 2^127 - 1]. Infinities give the nearer end and NaN gives 0.
/// :see: {F16.to_checked<S128>} to detect values that do not fit.
routine F16.to_clamp<S128>(me: Me) -> S128
    block entry()
        r : S128 = fptosi_sat<F32, S128>(me.to<F32>())
        return(r)

/// Converts to U8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [0, 255]. The crash reports the caller's location.
/// :see: {F16.to_checked<U8>} to get an absent value instead, {F16.to_clamp<U8>} to saturate.
#track_caller
routine F16.to<U8>(me: Me) -> U8
    block entry()
        fits : Bool = me.is_trunc_in_range(0.0, 256.0)
