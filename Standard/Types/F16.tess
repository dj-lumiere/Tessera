        r : S64 = fptosi_sat<Me, S64>(me)
        return(r)

/// Converts to S64, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-2^63, 2^63 - 1].
/// :see: {F16.to<S64>} to crash instead, {F16.to_clamp<S64>} to saturate.
routine F16.to_checked<S64>(me: Me) -> Option<S64>
    block entry()
        fits  : Bool        = me.is_trunc_in_range(-9223372036854775808.0, 9223372036854775808.0)
        value : S64         = fptosi_sat<Me, S64>(me)
        r     : Option<S64> = fits.then_present(value)
