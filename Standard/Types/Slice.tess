// Tessera stdlib: Slice[T], a run of values whose count is known at run time
//
// Two types say where values are. `@T` is an address (a claim slot, a field, an element, memory from C) and frees
// nothing. `Slice[T]` is an address, a count, and the allocator the memory came from. `Array[T, COUNT]` is the other run
// of values, with its count fixed in the type and its values inline.
//
// The allocator is what destruct() gives the memory back to. A null allocator means the slice is borrowed: a view of
// memory something else gives back (an array, a list, another slice, a literal), and destruct() does nothing. Views
// made from a slice (getslice, getview, to[Slice[T]]() of a list or an array) are borrowed. Copying a slice copies the
// allocator with it, so either copy can give the memory back: destruct exactly one.
//
// `at(i)` is the checked address, and every access through it is `@T`'s own: load, store, volatile_load,
// atomic_fetch_add, and the rest. getitem and setitem are the value shortcuts.

module Standard/Core

import Standard/Alloc

/// `count` values of `T` at `data`, and `alloc`, the allocator the memory came from. A null `alloc` means the slice is
/// borrowed and `destruct()` does nothing. Its count is chosen at run time (`Array[T, COUNT]` has its count in the type),
/// and `resize` changes it.
/// :typeparam T: The element type.
record Slice[T]
conform Destructible[Slice[T]]
require T: typename
    data: @T
    count: USize
    alloc: @MemoryManager

// -- making one ---------------------------------------------------------------------------------------------------

/// The `count` values starting at `data`, borrowed (a null allocator). The count is yours to get right.
/// :param data: The first value.
/// :param count: The number of values from `data` on.
/// :returns: The slice, which `destruct()` leaves alone.
routine Slice[T].construct(data: @T, count: USize) -> Me
require T: typename
    block entry()
        slice: Me = Me(data: data, count: count, alloc: null)
        return(slice)

/// The empty slice: a null data, a count of 0, and a null allocator, so `destruct()` does nothing on it. It is the
/// start value of a head slot that a `finish` block destructs (`shared buf : @Slice[Byte] <- .empty()`), so the
/// release is right on a path that never filled the slot.
/// :returns: The empty slice.
routine Slice[T].empty() -> Me
require T: typename
    block entry()
        return(Me(data: null, count: 0, alloc: null))

/// `count` uninitialized values of `T` from `alloc`, given back with `destruct()`. A count of 0 allocates nothing and
/// keeps the allocator.
/// :param count: The number of values.
/// :param alloc: The allocator the memory comes from and goes back to.
/// :returns: The slice.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails. See {Slice[T].construct_result}.
#track_caller
#expensive("allocates heap memory")
routine Slice[T].construct(count: USize, alloc: @MemoryManager) -> Me
require T: typename
    block entry()
        made: Result[Me, AllocFailed] = Me.construct_result(count, alloc)
        when made
            is Me as slice => return(slice)
            is AllocFailed => crash_allocation()

/// `construct`, returning an error instead of crashing when the allocator fails. A count of 0 allocates nothing and
/// keeps the allocator.
/// :param count: The number of values.
/// :param alloc: The allocator the memory comes from and goes back to.
/// :returns: The slice of `count` uninitialized values.
/// :throws: Returns `AllocFailed` when the allocator fails.
#expensive("allocates heap memory")
routine Slice[T].construct_result(count: USize, alloc: @MemoryManager) -> Result[Me, AllocFailed]
require T: typename
    block entry()
        nothing: Bool = count.eq(0)
        branch nothing
            ? empty()
            : continue
        data: @T = allocate[T](count, alloc)
        failed: Bool = data.is_null()
        branch failed
            ? return(AllocFailed())
            : continue
        slice: Me = Me(data: data, count: count, alloc: alloc)
        return(slice)

    block empty()
        slice: Me = Me(data: null, count: 0, alloc: alloc)
        return(slice)

// -- reading ------------------------------------------------------------------------------------------------------

/// The number of values.
/// :returns: The count.
routine Slice[T].count(me: Me) -> USize
require T: typename
    block entry()
        count: USize = me.count
        return(count)

/// The number of values.
/// :returns: The count.
routine Slice[T].count(me: @Me) -> USize
require T: typename
    block entry()
        count: USize = me.count.peek()
        return(count)

/// The same values, borrowed: the same data and count with a null allocator, so `destruct()` on it does nothing.
/// :returns: The borrowed view.
routine Slice[T].getview(me: Me) -> Me
require T: typename
    block entry()
        view: Me = Me(data: me.data, count: me.count, alloc: null)
        return(view)

/// The same values, borrowed: the same data and count with a null allocator, so `destruct()` on it does nothing.
/// :returns: The borrowed view.
routine Slice[T].getview(me: @Me) -> Me
require T: typename
    block entry()
        view: Me = me.peek().getview()
        return(view)

/// The address of the value at `index`, checked against the count. Everything else is `@T`'s own: `load`, `store`,
/// `volatile_load`, `atomic_fetch_add`, ...
/// :param index: The zero-based position.
/// :returns: The address of the value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine Slice[T].getslot(me: Me, index: USize) -> @T
require T: typename
    block entry()
        outside: Bool = index.ge(me.count)
        branch outside
            ? crash_out_of_bounds()
            : continue
        place: @T = me.data.stride(index)
        return(place)

/// The address of the value at `index`, checked against the count.
/// :param index: The zero-based position.
/// :returns: The address of the value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine Slice[T].getslot(me: @Me, index: USize) -> @T
require T: typename
    block entry()
        place: @T = me.peek().getslot(index)
        return(place)

/// The value at `index`, checked: `at(index).peek()`.
/// :param index: The zero-based position.
/// :returns: A copy of the value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`. See {Slice[T].getitem_checked}.
#track_caller
routine Slice[T].getitem(me: Me, index: USize) -> T
require T: typename
    block entry()
        value: T = me.getslot(index).peek()
        return(value)

/// The value at `index`, checked.
/// :param index: The zero-based position.
/// :returns: A copy of the value.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`. See {Slice[T].getitem_checked}.
#track_caller
routine Slice[T].getitem(me: @Me, index: USize) -> T
require T: typename
    block entry()
        value: T = me.peek().getitem(index)
        return(value)

/// `getitem`, returning Unit instead of crashing on an index past the end.
/// :param index: The zero-based position.
/// :returns: A copy of the value.
/// :absent: When `index >= count`.
routine Slice[T].getitem_checked(me: Me, index: USize) -> Maybe[T]
require T: typename
    block entry()
        inside: Bool = index.lt(me.count)
        branch inside
            ? continue
            : return(Unit())
        value: T = me.data.stride(index).peek()
        return(value)

/// `getitem`, returning Unit instead of crashing on an index past the end.
/// :param index: The zero-based position.
/// :returns: A copy of the value.
/// :absent: When `index >= count`.
routine Slice[T].getitem_checked(me: @Me, index: USize) -> Maybe[T]
require T: typename
    block entry()
        value: Maybe[T] = me.peek().getitem_checked(index)
        return(value)

/// Writes `value` at `index`, checked: `at(index).poke(value)`.
/// :param index: The zero-based position.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine Slice[T].setitem(me: Me, index: USize, value: T) -> Void
require T: typename
    block entry()
        me.getslot(index).poke(value)
        return()

/// Writes `value` at `index`, checked.
/// :param index: The zero-based position.
/// :param value: The value to store.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index >= count`.
#track_caller
routine Slice[T].setitem(me: @Me, index: USize, value: T) -> Void
require T: typename
    block entry()
        me.peek().setitem(index, value)
        return()

/// The `count` values from `start`, borrowed (a null allocator), checked against this slice.
/// :param start: The position of the first value.
/// :param count: The number of values.
/// :returns: A slice over that range.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine Slice[T].getslice(me: Me, start: USize, count: USize) -> Me
require T: typename
    block entry()
        past_end: Bool = start.gt(me.count)
        branch past_end
            ? crash_out_of_bounds()
            : continue
        room: USize = me.count.sub(start)
        too_many: Bool = count.gt(room)
        branch too_many
            ? crash_out_of_bounds()
            : continue
        first: @T = me.data.stride(start)
        part: Me = Me(data: first, count: count, alloc: null)
        return(part)

/// The `count` values from `start`, borrowed, checked against this slice.
/// :param start: The position of the first value.
/// :param count: The number of values.
/// :returns: A slice over that range.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine Slice[T].getslice(me: @Me, start: USize, count: USize) -> Me
require T: typename
    block entry()
        part: Me = me.peek().getslice(start, count)
        return(part)

/// The address of the first value.
/// :returns: `data`, which is null for an empty slice made by `empty()` or `resize(0)`.
routine Slice[T].to[@T](me: Me) -> @T
require T: typename
    block entry()
        data: @T = me.data
        return(data)

/// The address of the first value.
/// :returns: `data`, which is null for an empty slice made by `empty()` or `resize(0)`.
routine Slice[T].to[@T](me: @Me) -> @T
require T: typename
    block entry()
        data: @T = me.data.peek()
        return(data)

// -- changing the memory ------------------------------------------------------------------------------------------

/// Reallocates to hold `count` values, keeping the first ones (as many as both counts allow). The memory may move,
/// so addresses and slices taken before are stale. A count of 0 gives the memory back and keeps the allocator.
/// :param count: The new number of values.
/// :throws: Crashes with `InvalidValueError` on a borrowed slice (a null allocator), and with `MemoryAllocationError`
///     when the allocator fails. See {Slice[T].resize_result}.
#track_caller
#expensive("reallocates heap memory")
routine Slice[T].resize(me: @Me, count: USize) -> Void
require T: typename
    block entry()
        resized: Result[Unit, AllocFailed] = me.resize_result(count)
        when resized
            is Unit => return()
            is AllocFailed => crash_allocation()

/// `resize`, returning an error instead of crashing when the allocator fails. The slice is unchanged then.
/// :param count: The new number of values.
/// :returns: Success once the slice holds `count` values.
/// :throws: Crashes with `InvalidValueError` on a borrowed slice (a null allocator). Returns `AllocFailed`
///     when the allocator fails.
#track_caller
#expensive("reallocates heap memory")
routine Slice[T].resize_result(me: @Me, count: USize) -> Result[Unit, AllocFailed]
require T: typename
    local alloc: @MemoryManager = me.alloc.peek()

    block entry()
        borrowed: Bool = alloc.is_null()
        branch borrowed
            ? crash(name: "InvalidValueError",
                message: "This slice is borrowed (its allocator is null), so it can't be resized.")
            : continue
        nothing: Bool = count.eq(0)
        branch nothing
            ? emptied()
            : continue
        data: @T = reallocate[T](ptr: me.data.peek(), new_count: count, alloc)
        failed: Bool = data.is_null()
        branch failed
            ? return(AllocFailed())
            : continue
        me.data.poke(data)
        me.count.poke(count)
        return(Unit())

    block emptied()
        data: @T = me.data.peek()
        none: Bool = data.is_null()
        branch none
            ? reset()
            : continue
        deallocate[T](data, alloc)
        jump reset()

    block reset()
        me.data.poke(null)
        me.count.poke(0)
        return(Unit())

/// Gives the memory back to the allocator it came from and leaves the slice empty: a null data, a count of 0, and a
/// null allocator. Does nothing on a borrowed slice (a null allocator). The values themselves are not destructed:
/// see `destruct_all`.
#track_caller
routine Slice[T].destruct(me: @Me) -> Void
require T: typename
    block entry()
        alloc: @MemoryManager = me.alloc.peek()
        borrowed: Bool = alloc.is_null()
        branch borrowed
            ? return()
            : continue
        data: @T = me.data.peek()
        empty: Bool = data.is_null()
        branch empty
            ? reset()
            : continue
        deallocate[T](data, alloc)
        jump reset()

    block reset()
        me.data.poke(null)
        me.count.poke(0)
        me.alloc.poke(null)
        return()

/// Destructs every value, then gives the memory back: for values that own something, such as lists. Every value
/// must be initialized. Does nothing on a borrowed slice (a null allocator), whose values belong to someone else.
#track_caller
routine Slice[T].destruct_all(me: @Me) -> Void
require T: typename, Destructible[T]
    block entry()
        borrowed: Bool = me.alloc.peek().is_null()
        branch borrowed
            ? finish()
            : continue
        first: @T = me.data.peek()
        count: USize = me.count.peek()
        jump each(first, count, 0)

    block each(first: @T, count: USize, i: USize)
        done: Bool = i.ge(count)
        branch done
            ? finish()
            : continue
        first.stride(i).destruct()
        jump each(first, count, i.add(1))

    block finish()
        me.destruct()
        return()

// -- text ---------------------------------------------------------------------------------------------------------

/// The bytes as text, borrowed (a null allocator): valid until the slice's memory is given back or resized.
/// :returns: The bytes over the same memory.
routine Slice[Byte].to[Bytes](me: Me) -> Bytes
    block entry()
        text: Bytes = Bytes.from_ptr(data: me.data, count: me.count)
        return(text)

/// The bytes as text, borrowed (a null allocator): valid until the slice's memory is given back or resized.
/// :returns: The bytes over the same memory.
routine Slice[Byte].to[Bytes](me: @Me) -> Bytes
    block entry()
        text: Bytes = me.peek().to[Bytes]()
        return(text)

// -- views of the built-in containers -------------------------------------------------------------------------

/// The array's values, borrowed (a null allocator): valid as long as the array is.
/// :returns: A slice of all `COUNT` values.
routine Array[T, COUNT].to[Slice[T]](me: @Me) -> Slice[T]
require T: typename, COUNT: USize
    block entry()
        first: @T = me.to[@T]()
        slice: Slice[T] = Slice[T].construct(data: first, count: COUNT)
        return(slice)

/// The `count` values from `start`, borrowed, checked against `COUNT`.
/// :param start: The position of the first value.
/// :param count: The number of values.
/// :returns: A slice over that range.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine Array[T, COUNT].getslice(me: @Me, start: USize, count: USize) -> Slice[T]
require T: typename, COUNT: USize
    block entry()
        whole: Slice[T] = me.to[Slice[T]]()
        part: Slice[T] = whole.getslice(start, count)
        return(part)

/// The bytes as a slice, borrowed (a null allocator): the same memory, element by element.
/// :returns: A slice over the same memory.
routine Bytes.to[Slice[Byte]](me: Me) -> Slice[Byte]
    block entry()
        slice: Slice[Byte] = Slice[Byte].construct(data: me.data, count: me.count)
        return(slice)

/// The bytes as a slice, borrowed (a null allocator): the same memory, element by element.
/// :returns: A slice over the same memory.
routine Bytes.to[Slice[Byte]](me: @Me) -> Slice[Byte]
    block entry()
        slice: Slice[Byte] = Slice[Byte].construct(data: me.data.peek(), count: me.count.peek())
        return(slice)

/// The `count` bytes from `start`, borrowed, checked against the count.
/// :param start: The position of the first byte.
/// :param count: The number of bytes.
/// :returns: A slice over that range.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine Bytes.getslice(me: Me, start: USize, count: USize) -> Slice[Byte]
    block entry()
        whole: Slice[Byte] = me.to[Slice[Byte]]()
        part: Slice[Byte] = whole.getslice(start, count)
        return(part)

/// The `count` bytes from `start`, borrowed, checked against the count.
/// :param start: The position of the first byte.
/// :param count: The number of bytes.
/// :returns: A slice over that range.
/// :throws: Crashes with `IndexOutOfBoundsError` when the range runs past the end.
#track_caller
routine Bytes.getslice(me: @Me, start: USize, count: USize) -> Slice[Byte]
    block entry()
        part: Slice[Byte] = me.to[Slice[Byte]]().getslice(start, count)
        return(part)
