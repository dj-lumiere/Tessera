// Tessera stdlib: Bool — 1-bit boolean
//
// Maps to LLVM IR i1.

module Standard/Core

/// One-bit boolean, mapped to LLVM `i1`. Holds `true` or `false`, and takes the bitwise operations `bitand`, `bitor`, `bitxor`, and `bitnot` in place of the keyword operators.
@llvm("i1")
record Bool
obeys Equatable[Bool], Hashable[Bool]

// -- bitwise operations --------------------------------------------------------

/// Logical AND of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: `true` only when both operands are `true`.
routine Bool.bitand(me: Me, other: Me) -> Me
    r: Me = band[Me](me, other)
    return r

/// Logical OR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when at least one operand is `true`.
routine Bool.bitor(me: Me, other: Me) -> Me
    r: Me = bor[Me](me, other)
    return r

/// Logical exclusive OR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when exactly one operand is `true`.
routine Bool.bitxor(me: Me, other: Me) -> Me
    r: Me = bxor[Me](me, other)
    return r

/// Logical negation of `me`.
/// :returns: `true` when `me` is `false`, and `false` when `me` is `true`.
routine Bool.bitnot(me: Me) -> Me
    r: Me = bnot[Me](me)
    return r

// -- equality, hashing ---------------------------------------------------------

/// Whether `me` and `other` are the same boolean.
/// :param other: The right-hand operand.
/// :returns: `true` when both are `true` or both are `false`.
routine Bool.eq(me: Me, other: Me) -> Me
    r: Me = ieq[Me](me, other)
    return r

/// Whether `me` and `other` are different booleans.
/// :param other: The right-hand operand.
/// :returns: `true` when exactly one operand is `true`.
routine Bool.ne(me: Me, other: Me) -> Me
    r: Me = ine[Me](me, other)
    return r

/// Hashes `me` by widening it to a `U64` (0 or 1) and hashing that with SipHash-2-4 under the process key.
/// :returns: The 64-bit hash.
routine Bool.hash(me: Me) -> U64
    h: U64 = siphash24(value: me.to[U64](), key: hash_key())
    return h

// -- options ---------------------------------------------------------------------

/// value when `me` is true, None when false (Rust's bool/then_some).
/// :typeparam T: The type of the value.
/// :param value: The value to wrap.
/// :returns: `value` when `me` is true, else `Unit`.
routine Bool.then_present[T](me: Me, value: T) -> Maybe[T]
needs T: typename
    if me
        r: Maybe[T] = value
        return r
    else
        r: Maybe[T] = None()
        return r

// -- generic conversions -------------------------------------------------------

/// Zero-extends `me` to the integer type `T`.
/// :typeparam T: The destination integer type.
/// :returns: 1 when `me` is `true`, 0 when it is `false`, as a `T`.
routine Bool.zext[T](me: Me) -> T
needs T: typename
    r: T = zext[Me, T](me)
    return r

// -- named conversions ---------------------------------------------------------

/// Converts `me` to `S8`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[S8](me: Me) -> S8
    result: S8 = zext[Me, S8](me)
    return result

/// Converts `me` to `S32`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[S32](me: Me) -> S32
    result: S32 = zext[Me, S32](me)
    return result

/// Converts `me` to `S64`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[S64](me: Me) -> S64
    result: S64 = zext[Me, S64](me)
    return result

/// Converts `me` to `S128`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[S128](me: Me) -> S128
    result: S128 = zext[Me, S128](me)
    return result

/// Converts `me` to `U8`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[U8](me: Me) -> U8
    result: U8 = zext[Me, U8](me)
    return result

/// Converts `me` to `U32`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[U32](me: Me) -> U32
    result: U32 = zext[Me, U32](me)
    return result

/// Converts `me` to `U64`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[U64](me: Me) -> U64
    result: U64 = zext[Me, U64](me)
    return result

/// Converts `me` to `USize`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[USize](me: Me) -> USize
    result: USize = zext[Me, USize](me)
    return result

/// Converts `me` to `U128`.
/// :returns: 1 when `me` is `true`, 0 when it is `false`.
routine Bool.to[U128](me: Me) -> U128
    result: U128 = zext[Me, U128](me)
    return result
