// Tessera stdlib: Bool — 1-bit boolean
//
// Maps to LLVM IR i1.

module Standard::Core

/// One-bit boolean, mapped to LLVM `i1`. Holds `true` or `false`, and takes the bitwise operations `bitand`, `bitor`, `bitxor`, and `bitnot` in place of the keyword operators.
#llvm("i1")
record Bool
conform Equatable<Bool>, Hashable<Bool>

// -- bitwise operations --------------------------------------------------------

/// Logical AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: `true` only when both operands are `true`.
routine Bool.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Logical OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when at least one operand is `true`.
routine Bool.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Logical exclusive OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: `true` when exactly one operand is `true`.
routine Bool.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Logical negation of `self`.
/// :returns: `true` when `self` is `false`, and `false` when `self` is `true`.
routine Bool.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- equality, hashing ---------------------------------------------------------

/// Whether `self` and `other` are the same boolean.
/// :param other: The right-hand operand.
/// :returns: `true` when both are `true` or both are `false`.
routine Bool.eq(self: Self, other: Self) -> Self
    block entry()
        r : Self = ieq<Self>(self, other)
        return(r)

/// Whether `self` and `other` are different booleans.
/// :param other: The right-hand operand.
/// :returns: `true` when exactly one operand is `true`.
routine Bool.ne(self: Self, other: Self) -> Self
    block entry()
        r : Self = ine<Self>(self, other)
        return(r)

/// Hashes `self` by widening it to a `U64` (0 or 1) and hashing that with SipHash-2-4 under the process key.
/// :returns: The 64-bit hash.
routine Bool.hash(self: Self) -> U64
    block entry()
        h : U64 = siphash24(self.to<U64>(), hash_key())
        return(h)

// -- options ---------------------------------------------------------------------

/// Present(value) when true, Absent when false (Rust's bool::then_some).
routine Bool.then_present<T>(self: Self, value: T) -> Option<T>
require T: typename
    block entry()
        branch self
            ? present()
            : absent()

    block present()
        r : Option<T> = .Present(value)
        return(r)

    block absent()
        r : Option<T> = .Absent
        return(r)

// -- generic conversions -------------------------------------------------------

/// Zero-extends `self` to the integer type `To`.
/// :typeparam To: The destination integer type.
/// :returns: 1 when `self` is `true`, 0 when it is `false`, as a `To`.
routine Bool.zext<To>(self: Self) -> To
require To: typename
    block entry()
        r : To = zext<Self, To>(self)
        return(r)

// -- named conversions ---------------------------------------------------------

/// Converts `self` to `S8`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<S8>(self: Self) -> S8
    block entry()
        result : S8 = zext<Self, S8>(self)
        return(result)

/// Converts `self` to `S32`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<S32>(self: Self) -> S32
    block entry()
        result : S32 = zext<Self, S32>(self)
        return(result)

/// Converts `self` to `S64`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<S64>(self: Self) -> S64
    block entry()
        result : S64 = zext<Self, S64>(self)
        return(result)

/// Converts `self` to `S128`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<S128>(self: Self) -> S128
    block entry()
        result : S128 = zext<Self, S128>(self)
        return(result)

/// Converts `self` to `U8`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<U8>(self: Self) -> U8
    block entry()
        result : U8 = zext<Self, U8>(self)
        return(result)

/// Converts `self` to `U32`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<U32>(self: Self) -> U32
    block entry()
        result : U32 = zext<Self, U32>(self)
        return(result)

/// Converts `self` to `U64`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<U64>(self: Self) -> U64
    block entry()
        result : U64 = zext<Self, U64>(self)
        return(result)

/// Converts `self` to `USize`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<USize>(self: Self) -> USize
    block entry()
        result : USize = zext<Self, USize>(self)
        return(result)

/// Converts `self` to `U128`.
/// :returns: 1 when `self` is `true`, 0 when it is `false`.
routine Bool.to<U128>(self: Self) -> U128
    block entry()
        result : U128 = zext<Self, U128>(self)
        return(result)
