/// Converts `self` to `S256`. Every `U128` value fits in `S256`, so the conversion never fails.
/// :returns: The same numeric value as an `S256`.
routine U128.to<S256>(self: Self) -> S256
    block entry()
        r : S256 = zext<Self, S256>(self)
        return(r)

