        r : U256 = zext<Me, U256>(me)
        return(r)

/// Converts `me` to `F32`, rounding to nearest, ties to even.
/// :returns: The `F32` nearest to `me`.
routine U128.to<F32>(me: Me) -> F32
    block entry()
        r : F32 = uitofp<Me, F32>(me)
        return(r)

/// Converts `me` to `F64`, rounding to nearest, ties to even.
/// :returns: The `F64` nearest to `me`.
