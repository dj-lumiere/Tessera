// Tessera stdlib: U128 — 128-bit unsigned integer
//
// Maps to LLVM IR i128. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// 128-bit unsigned integer, mapped to LLVM `i128`. Arithmetic, shifts, and lossy conversions crash when the result does not fit. The `_checked` forms return an `Option`, the `_wrap` forms are modular, and the `_clamp` forms saturate.
#llvm("i128")
record U128
conform Equatable<U128>, Comparable<U128>, Hashable<U128>

// -- constants -------------------------------------------------------------------

/// The smallest `U128` value, 0.
preset U128.MIN: U128 = 0
/// The largest `U128` value, `340282366920938463463374607431768211455`.
preset U128.MAX: U128 = 340282366920938463463374607431768211455
/// The width of `U128` in bits.
preset U128.BITS: U128 = 128

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are set to 1.
/// :returns: The population count, from 0 to `U128.BITS`.
routine U128.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The leading zero count, or `U128.BITS` when `self` is 0.
routine U128.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The trailing zero count, or `U128.BITS` when `self` is 0.
routine U128.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of the bits of `self`, so the least significant bit becomes the most significant.
/// :returns: `self` with its bits mirrored.
routine U128.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: The number of clear bits, from 0 to `U128.BITS`.
routine U128.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The leading one count, or `U128.BITS` when every bit is set.
routine U128.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The trailing one count, or `U128.BITS` when every bit is set.
routine U128.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Reverses the byte order of `self`.
/// :returns: `self` with its bytes in the opposite order.
routine U128.swap_bytes(self: Self) -> Self
    block entry()
        r : Self = bswap<Self>(self)
        return(r)

/// Converts `self` from the host byte order to big-endian. Tessera targets are little-endian, so this swaps the bytes.
/// :returns: The big-endian representation of `self`.
routine U128.to_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts a big-endian value to the host byte order. Tessera targets are little-endian, so this swaps the bytes.
/// :returns: The host-order value of `self`.
routine U128.from_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts `self` from the host byte order to little-endian. Tessera targets are little-endian, so this returns `self` unchanged.
/// :returns: The little-endian representation of `self`.
routine U128.to_le(self: Self) -> Self
    block entry()
        return(self)

/// Converts a little-endian value to the host byte order. Tessera targets are little-endian, so this returns `self` unchanged.
/// :returns: The host-order value of `self`.
routine U128.from_le(self: Self) -> Self
    block entry()
        return(self)

/// Tests whether exactly one bit of `self` is set.
/// :returns: True when `self` is a power of two.
routine U128.is_power_of_two(self: Self) -> Bool
    block entry()
        ones : Self = popcount<Self>(self)
        r    : Bool = ones.eq(1)
        return(r)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where both operands have it set.
routine U128.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where either operand has it set.
routine U128.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where exactly one operand has it set.
routine U128.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise complement of `self`.
/// :returns: `self` with every bit flipped.
routine U128.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts `self` left by `n` bits, zeros filling in. A shift by `BITS` or more shifts every bit out and gives 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
routine U128.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shifts `self` right by `n` bits, logical: zeros fill in. A shift by `BITS` or more gives 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
routine U128.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = lshr<Self>(self, n)
        out      : Self = 0
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine U128.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits of `self` right by `n`, modulo the bit width. Bits shifted out at the bottom re-enter at the top.
/// :param n: The rotation amount in bits.
/// :returns: The rotated value.
routine U128.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted left by `n`, zeros filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine U128.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts `self` right (zeros fill in), reporting an out-of-range amount instead of saturating to 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
/// :absent: `n` is outside `0 ..< U128.BITS`.
routine U128.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = lshr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts `self` left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted left, zeros filling in.
routine U128.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 127)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Shifts `self` right (zeros fill in) by `n` modulo the bit width.
/// :param n: The shift amount in bits, reduced modulo `U128.BITS`.
/// :returns: The shifted value.
routine U128.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 127)
        r      : Self = lshr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `self` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in U128.
#track_caller
routine U128.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = uadd_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Adds `other` to `self`, reporting overflow instead of crashing.
/// :param other: The right-hand operand.
/// :returns: The sum.
/// :absent: The sum exceeds `U128.MAX`.
routine U128.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = uadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The sum of `self` and `other`, wrapping modulo 2^128.
/// :param other: The value to add.
/// :returns: The sum modulo 2^128.
routine U128.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// The sum of `self` and `other`, saturating at `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MAX` when the exact sum is out of range.
routine U128.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = uadd_sat<Self>(self, other)
        return(r)

/// The difference of `self` and `other`.
/// :param other: The value to subtract.
/// :returns: `self - other`.
/// :throws: Crashes with `IntegerOverflowError` when `other` is greater than `self`.
#track_caller
routine U128.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = usub_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, reporting underflow instead of crashing.
/// :param other: The right-hand operand.
/// :returns: The difference.
/// :absent: `other` is greater than `self`, so the result would be below 0.
routine U128.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = usub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The difference of `self` and `other`, wrapping modulo 2^128.
/// :param other: The value to subtract.
/// :returns: `self - other` modulo 2^128.
routine U128.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// The difference of `self` and `other`, saturating at 0.
/// :param other: The value to subtract.
/// :returns: `self - other`, or 0 when `other` is greater than `self`.
routine U128.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = usub_sat<Self>(self, other)
        return(r)

/// The product of `self` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in U128.
#track_caller
routine U128.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = umul_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, reporting overflow instead of crashing.
/// :param other: The right-hand operand.
/// :returns: The product.
/// :absent: The product exceeds `U128.MAX`.
routine U128.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = umul_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The product of `self` and `other`, wrapping modulo 2^128.
/// :param other: The factor to multiply by.
/// :returns: The product modulo 2^128.
routine U128.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// The product of `self` and `other`, saturating at `MAX`.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MAX` when the exact product is out of range.
routine U128.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = self.mul_overflows(other)
        product  : Self = mul<Self>(self, other)
        r        : Self = overflow
            ? Self.MAX
            : product
        return(r)

/// Tests whether the exact product of `self` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in U128.
routine U128.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = umul_overflows<Self>(self, other)
        return(r)

/// The exact product of `self` and `other` in twice the width. It never overflows.
/// :param other: The factor to multiply by.
/// :returns: The product as a U256.
routine U128.mul_wide(self: Self, other: Self) -> U256
    block entry()
        r : U256 = self.to<U256>().mul_wrap(other.to<U256>())
        return(r)

// -- division --------------------------------------------------------------------

/// The quotient of `self` divided by `other`, rounded down.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U128.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Self = wide_divrem(self, other).quotient
        return(r)

/// The remainder of `self` divided by `other`.
/// :param other: The divisor.
/// :returns: The remainder, from 0 to `other - 1`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U128.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Self = wide_divrem(self, other).remainder
        return(r)

/// Quotient of `self` divided by `other`, reporting a zero divisor instead of crashing.
/// :param other: The divisor.
/// :returns: The quotient, rounded down.
/// :absent: When `other` is 0.
routine U128.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = wide_divrem(self, other).quotient
        return(Option<Self>.Present(r))

/// Remainder of `self` divided by `other`, reporting a zero divisor instead of crashing.
/// :param other: The divisor.
/// :returns: The remainder, from 0 to `other - 1`.
/// :absent: `other` is 0.
routine U128.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = wide_divrem(self, other).remainder
        return(Option<Self>.Present(r))

/// The quotient of `self` divided by `other`, rounded up.
/// :param other: The divisor.
/// :returns: The quotient, rounded up.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
routine U128.div_ceil(self: Self, other: Self) -> Self
    block entry()
        q     : Self = self.div(other)
        rem   : Self = wide_divrem(self, other).remainder
        exact : Bool = rem.eq(0)
        branch exact
            ? return(q)
            : continue
        r : Self = add<Self>(q, 1)
        return(r)

/// The smallest multiple of `other` that is at least `self`.
/// :param other: The value whose multiple to round up to.
/// :returns: `self` when it is already a multiple of `other`, else the next multiple above it.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when the multiple does not fit in U128.
routine U128.next_multiple_of(self: Self, other: Self) -> Self
    block entry()
        rem   : Self = self.mod(other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(self)
            : continue
        gap : Self = sub<Self>(other, rem)
        r   : Self = self.add(gap)
        return(r)

/// The smallest power of two that is at least `self`. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :throws: Crashes with `IntegerOverflowError` when the power of two does not fit in U128.
#track_caller
routine U128.next_power_of_two(self: Self) -> Self
    block entry()
        r : Option<Self> = self.next_power_of_two_checked()
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// The smallest power of two that is at least `self`, reporting when it does not fit. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :absent: When the power of two does not fit in U128.
routine U128.next_power_of_two_checked(self: Self) -> Option<Self>
    block entry()
        small : Bool = self.le(1)
        branch small
            ? return(Option<Self>.Present(1))
            : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up()
        below : Self = sub<Self>(self, 1)
        lz    : Self = clz<Self>(below, true)
        shift : Self = sub<Self>(Self.BITS, lz)
        fits  : Bool = shift.lt(Self.BITS)
        branch fits
            ? continue
            : return(Option<Self>.Absent)
        power : Self = shl<Self>(1, shift)
        return(Option<Self>.Present(power))

// -- powers ----------------------------------------------------------------------

/// Raises `self` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `self` to the power `exponent`, which is 1 when `exponent` is 0.
/// :throws: Crashes with `IntegerOverflowError` when the power does not fit in U128.
#track_caller
routine U128.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `self` to the power `exponent` by squaring, wrapping modulo 2^128.
/// :param exponent: The power to raise to.
/// :returns: The power modulo 2^128, which is 1 when `exponent` is 0.
routine U128.pow_wrap(self: Self, exponent: U32) -> Self
    shared base : @Self <- self
    shared acc  : @Self <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc.load(), base.load())
        next_acc  : Self = odd
            ? with_base
            : acc.load()
        next_acc2 : Self = next_acc
        next_base : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Raises `self` to the power `exponent` by squaring, reporting overflow.
/// :param exponent: The power to raise to.
/// :returns: The power, which is 1 when `exponent` is 0.
/// :absent: When the power does not fit in U128.
routine U128.pow_checked(self: Self, exponent: U32) -> Option<Self>
    shared base     : @Self <- self
    shared acc      : @Self <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = umul_overflows<Self>(acc.load(), base.load()).bitand(odd)
        with_base    : Self = mul<Self>(acc.load(), base.load())
        next_acc     : Self = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = umul_overflows<Self>(base.load(), base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Self = next_acc
        next_base     : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool         = overflow.load().bitnot()
        r    : Option<Self> = fits.then_present(acc.load())
        return(r)

/// Raises `self` to the power `exponent`, saturating at `MAX`.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MAX` when it does not fit.
routine U128.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(Self.MAX)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Whether `self` and `other` hold the same value.
/// :param other: The right-hand operand.
/// :returns: `true` when the values are equal.
routine U128.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Whether `self` and `other` hold different values.
/// :param other: The right-hand operand.
/// :returns: `true` when the values differ.
routine U128.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Whether `self` is less than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ult i128 {self}, {other}")]
routine U128.lt(self: Self, other: Self) -> Bool

/// Whether `self` is less than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ule i128 {self}, {other}")]
routine U128.le(self: Self, other: Self) -> Bool

/// Whether `self` is greater than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp ugt i128 {self}, {other}")]
routine U128.gt(self: Self, other: Self) -> Bool

/// Whether `self` is greater than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#[external("llvm"), template("{result} = icmp uge i128 {self}, {other}")]
routine U128.ge(self: Self, other: Self) -> Bool

/// Three-way unsigned comparison of `self` with `other`.
/// :param other: The value to compare with.
/// :returns: -1 when `self < other`, 0 when they are equal, and 1 when `self > other`.
routine U128.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// The smaller of `self` and `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: The lesser operand.
routine U128.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = umin<Self>(self, other)
        return(r)

/// The larger of `self` and `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: The greater operand.
routine U128.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = umax<Self>(self, other)
        return(r)

/// Limits `self` to the range `lo ..= hi`.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `self < lo`, `hi` when `self > hi`, else `self`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine U128.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Self = umax<Self>(self, lo)
        r           : Self = umin<Self>(at_least_lo, hi)
        return(r)

/// Tests whether `self` is in `lo ..= hi`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= self <= hi`.
routine U128.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// Tests whether `self` is in `lo ..< end`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= self < end`.
routine U128.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the 16 bytes under the process key, the same hash for S128 and U128.
/// :returns: The 64-bit hash of `self`.
routine U128.hash(self: Self) -> U64
    block entry()
        bits : Self = bitcast<Self, Self>(self)
        lo   : U64  = bits.to_wrap<U64>()
        hi   : U64  = bits.shr(64).to<U64>()
        h    : U64  = siphash24(lo, hi, hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `self` and `other`, `|self - other|`, which always fits in U128.
/// :param other: The other value.
/// :returns: The absolute difference as a U128.
routine U128.abs_diff(self: Self, other: Self) -> Self
    block entry()
        hi   : Self = umax<Self>(self, other)
        lo   : Self = umin<Self>(self, other)
        diff : Self = sub<Self>(hi, lo)
        r    : Self = bitcast<Self, Self>(diff)
        return(r)

/// The average of `self` and `other`, rounded down, computed without overflow.
/// :param other: The other value.
/// :returns: `floor((self + other) / 2)`.
routine U128.midpoint(self: Self, other: Self) -> Self
    block entry()
        common    : Self = self.bitand(other)
        half_diff : Self = self.bitxor(other).shr(1)
        r         : Self = add<Self>(common, half_diff)
        return(r)

/// The base-2 logarithm of `self`, rounded down.
/// :returns: `floor(log2(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0.
#track_caller
routine U128.ilog2(self: Self) -> Self
    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? crash_numeric_domain()
            : continue
        lz : Self = clz<Self>(self, true)
        r  : Self = sub<Self>(Self.BITS.sub(1), lz)
        return(r)

/// The base-10 logarithm of `self`, rounded down.
/// :returns: `floor(log10(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0.
#track_caller
routine U128.ilog10(self: Self) -> Self
    shared digits : @Self <- 0

    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? crash_numeric_domain()
            : loop(self)

    block loop(rest: Self)
        last : Bool = rest.lt(10)
        branch last
            ? return(digits.load())
            : continue
        digits.load().add(1).store_into(digits)
        jump loop(rest.div(10))

/// The square root of `self`, rounded down, computed one result bit at a time.
/// :returns: `floor(sqrt(self))`.
routine U128.isqrt(self: Self) -> Self
    block entry()
        top_bit : Self = shl<Self>(1, Self.BITS.sub(2))
        jump align(top_bit)

    // Start from the highest power of four that is <= self.
    block align(bit: Self)
        too_big : Bool = bit.gt(self)
        branch too_big
            ? align(bit.shr(2))
            : loop(self, 0, bit)

    block loop(rest: Self, root: Self, bit: Self)
        done : Bool = bit.eq(0)
        branch done
            ? return(root)
            : continue
        trial     : Self = add<Self>(root, bit)
        fits      : Bool = rest.ge(trial)
        half_root : Self = root.shr(1)
        next_bit  : Self = bit.shr(2)
        branch fits
            ? take(rest, trial, half_root, bit, next_bit) \
            : loop(rest, half_root, next_bit)

    block take(rest: Self, trial: Self, half_root: Self, bit: Self, next_bit: Self)
        jump loop(sub<Self>(rest, trial), add<Self>(half_root, bit), next_bit)

// -- conversions -----------------------------------------------------------------

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Converts `self` to `S8`.
/// :returns: The same value as a `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine U128.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.le(127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8` if the value is in that type's range.
/// :returns: The value as an `S8`.
/// :absent: The value does not fit in `S8`.
routine U128.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.le(127)
        value : S8         = trunc<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `self` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: `self` modulo 2^8, as a `S8`.
routine U128.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8`, saturating at the ends of `S8`'s range.
/// :returns: `self` clamped to `S8.MIN ..= S8.MAX`.
routine U128.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_most : Self = umin<Self>(self, 127)
        r       : S8   = trunc<Self, S8>(at_most)
        return(r)

