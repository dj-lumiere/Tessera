// Tessera stdlib: Maybe[T] and KVPair[TKey, TValue]
//
// Maybe[T] is a value that may be absent: a T, or Unit when there is none. Every `_checked` routine returns one,
// an iterator's emit_checked() included. A T goes where a Maybe[T] is expected as it is, and so does Unit():
//
//     return(value)
//     return(Unit())
//
// Read it with when:
//
//     when item
//         is S64 as value => use(value)
//         is Unit => done()
//
// KVPair[TKey, TValue] is a plain value pair used by Dict and SortedDict iterators.

module Standard/Core

import Standard/Format

// -- Maybe ---------------------------------------------------------------------

/// A value that may be absent: a `T`, or `Unit` when there is none. A `T` or `Unit()` goes where a `Maybe[T]` is
/// expected as it is, and `when` observes which with `is T as value` / `is Unit`. The `_checked` routines return one.
/// A `Maybe[Unit]` can't exist (both branches would be `Unit`), nor a `Maybe[Maybe[T]]`.
/// :typeparam T: The type of the present value.
#derive(Representable, Diagnosable, Equatable, Hashable, Comparable)
variant Maybe[T]
require T: typename
    T
    Unit

/// Releases nothing: a `Maybe` holds no memory of its own.
routine Maybe[T].destruct(me: @Me) -> Void
require T: typename
    return()

/// Whether `me` holds a value.
/// :typeparam T: The type of the present value.
/// :returns: `true` for a `T`, `false` for `Unit`.
routine Maybe[T].is_present(me: Me) -> Bool
require T: typename
    when me
        is T => return(true)
        is Unit => return(false)

/// Whether `me` holds no value.
/// :typeparam T: The type of the present value.
/// :returns: `true` for `Unit`, `false` for a `T`.
routine Maybe[T].is_absent(me: Me) -> Bool
require T: typename
    when me
        is T => return(false)
        is Unit => return(true)

/// The value. Crashes if it's absent.
/// :returns: The present value.
/// :throws: Crashes with `AbsentValueError` when `me` is `Unit`.
#track_caller
routine Maybe[T].unwrap(me: Me) -> T
require T: typename
    when me
        is T as value => return(value)
        is Unit => crash_absent_value()

/// The value if present, otherwise `default`.
/// :param default: The value to return when `me` is `Unit`.
/// :returns: The present value, or `default`.
routine Maybe[T].unwrap_or(me: Me, default: T) -> T
require T: typename
    when me
        is T as value => return(value)
        is Unit => return(default)

// -- KVPair --------------------------------------------------------------------

/// Yielded by Dict and SortedDict iterators.
#derive(Equatable, Hashable)
record KVPair[TKey, TValue]
require TKey: typename, TValue: typename
    key: TKey
    value: TValue

/// Makes a `KVPair` from its fields.
/// :param key: Its `key`.
/// :param value: Its `value`.
/// :returns: The new value.
routine KVPair[TKey, TValue].construct(key: TKey, value: TValue) -> Me
require TKey: typename, TValue: typename
    return(Me(key, value))

/// Releases nothing: a `KVPair` holds no memory of its own.
routine KVPair[TKey, TValue].destruct(me: @Me) -> Void
require TKey: typename, TValue: typename
    return()
