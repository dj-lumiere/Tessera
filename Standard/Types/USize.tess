    block entry()
        fits  : Bool        = self.le(9223372036854775807)
        value : S64         = bitcast<Self, S64>(self)
        r     : Option<S64> = fits.then_present(value)
        return(r)

/// Converts `self` to `S64`. Every `USize` value fits in `S64` here, so the result is always present. On 32-bit targets.
/// :returns: The value as an `S64`, wrapped in an `Option`.
#target(size: 32)
routine USize.to_checked<S64>(self: Self) -> Option<S64>
    block entry()
        r : S64 = self.to<S64>()
        return(Option<S64>.Present(r))

/// Keeps the low 64 bits (modulo 2^64).
#target(size: 64)
routine USize.to_wrap<S64>(self: Self) -> S64
    block entry()
        r : S64 = bitcast<Self, S64>(self)
        return(r)

/// Converts `self` to `S64` like {USize.to<S64>}; no value is lost here, so no wrapping or saturation occurs. On 32-bit targets.
/// :returns: The same numeric value as an `S64`.
#target(size: 32)
routine USize.to_wrap<S64>(self: Self) -> S64
    block entry()
        r : S64 = self.to<S64>()
        return(r)

/// Saturates at S64's range.
#target(size: 64)
routine USize.to_clamp<S64>(self: Self) -> S64
    block entry()
        at_most : Self = umin<Self>(self, 9223372036854775807)
        r       : S64  = bitcast<Self, S64>(at_most)
        return(r)

/// Converts `self` to `S64` like {USize.to<S64>}; no value is lost here, so no wrapping or saturation occurs. On 32-bit targets.
/// :returns: The same numeric value as an `S64`.
#target(size: 32)
routine USize.to_clamp<S64>(self: Self) -> S64
    block entry()
        r : S64 = self.to<S64>()
        return(r)

