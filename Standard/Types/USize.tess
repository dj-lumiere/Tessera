/// Converts `me` to `USize`. On 32-bit targets.
/// :returns: The same numeric value as a `USize`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `USize`.
#[target(size: 32), track_caller]
routine U64.to<USize>(me: Me) -> USize
    block entry()
        fits : Bool = me.le(4294967295)
        branch fits
            ? continue
            : crash_overflow()
        r : USize = trunc<Me, USize>(me)
        return(r)

