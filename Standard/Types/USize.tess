/// :returns: The value, 0 when `me` is negative, or `USize.MAX` when it is greater.
#target(size: 32)
routine S256.to_clamp<USize>(me: Me) -> USize
    block entry()
        at_least : Me    = smax<Me>(me, 0)
        at_most  : Me    = smin<Me>(at_least, 4294967295)
        r        : USize = trunc<Me, USize>(at_most)
        return(r)

/// Converts `me` to `USize`. Every `U8` value fits in `USize`, so the conversion never fails.
/// :returns: The same numeric value as a `USize`.
routine U8.to<USize>(me: Me) -> USize
    block entry()
        r : USize = zext<Me, USize>(me)
        return(r)

/// Converts `me` to `USize`. Every `U16` value fits in `USize`, so the conversion never fails.
/// :returns: The same numeric value as a `USize`.
routine U16.to<USize>(me: Me) -> USize
