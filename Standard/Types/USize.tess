/// Converts `me` to `USize`. Every `U64` value fits in `USize`, so the conversion never fails. On 64-bit targets.
/// :returns: The same numeric value as a `USize`.
#target(size: 64)
routine U64.to<USize>(me: Me) -> USize
    block entry()
        r : USize = bitcast<Me, USize>(me)
