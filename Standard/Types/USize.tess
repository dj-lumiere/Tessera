/// Converts `me` to `USize`. Every `U32` value fits in `USize`, so the conversion never fails. On 64-bit targets.
/// :returns: The same numeric value as a `USize`.
#target(size: 64)
routine U32.to<USize>(me: Me) -> USize
    block entry()
        r : USize = zext<Me, USize>(me)
        return(r)

/// Converts `me` to `USize`. Every `U32` value fits in `USize`, so the conversion never fails. On 32-bit targets.
/// :returns: The same numeric value as a `USize`.
#target(size: 32)
routine U32.to<USize>(me: Me) -> USize
    block entry()
        r : USize = bitcast<Me, USize>(me)
        return(r)

/// Converts `me` to `USize`. Every `U32` value fits in `USize` here, so the result is always present.
/// :returns: The value as a `USize`, wrapped in an `Option`.
routine U32.to_checked<USize>(me: Me) -> Option<USize>
    block entry()
        r : USize = me.to<USize>()
        return(Option<USize>.Present(r))

/// Converts `me` to `USize` like {U32.to<USize>}. No value is lost here, so no wrapping or saturation occurs.
/// :returns: The same numeric value as a `USize`.
routine U32.to_wrap<USize>(me: Me) -> USize
    block entry()
        r : USize = me.to<USize>()
        return(r)

