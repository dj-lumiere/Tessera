        return(r)

/// Panics when the value doesn't fit in S64.
#[target(size: 64), track_caller]
routine USize.to<S64>(self: Self) -> S64
    block entry()
        fits : Bool = self.le(9223372036854775807)
        branch fits
            ? continue
            : panic_overflow()
        r : S64 = bitcast<Self, S64>(self)
        return(r)

/// Converts `self` to `S64`. Every `USize` value fits in `S64`, so the conversion never fails. On 32-bit targets.
/// :returns: The same numeric value as an `S64`.
#target(size: 32)
routine USize.to<S64>(self: Self) -> S64
    block entry()
        r : S64 = zext<Self, S64>(self)
        return(r)

/// Converts `self` to `S64` if the value is in that type's range. On 64-bit targets.
/// :returns: The value as an `S64`.
/// :absent: The value does not fit in `S64`.
