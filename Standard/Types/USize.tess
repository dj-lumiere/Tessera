// Tessera stdlib: USize — the target's pointer-width unsigned integer
//
// For lengths, indices, counts, and sizes. It is U16, U32, or U64 underneath, by the target's
// pointer width, but a type of its own on every target: it never mixes with
// a fixed-width integer without a to<T>() call, so a program type-checks
// the same way everywhere. Every method has the same signature on every
// target; a conversion that can lose the value on some target has its
// _checked / _wrap / _clamp forms on all of them.
//
// Generated by scripts/gen_size_types.py from U32.tess and U64.tess.

module Standard::Core

/// Pointer-width unsigned integer: 32 or 64 bits by the target. Use it for lengths, indices, counts, and sizes; it never mixes with a fixed-width integer without a `to<...>()` call.
/// Arithmetic panics on overflow; `_checked` forms return an `Option`, `_wrap` forms are modular, and `_clamp` forms saturate.
record USize
conform Equal<USize>, Compare<USize>, Hash<USize>

// -- constants -------------------------------------------------------------------

/// The smallest `USize` value, 0.
preset USize.MIN: USize = 0

/// The largest `USize` value: 2^64 - 1 on 64-bit targets, 2^32 - 1 on 32-bit targets.
#target(size: 64)
preset USize.MAX: USize = 18446744073709551615

/// The largest `USize` value: 2^64 - 1 on 64-bit targets, 2^32 - 1 on 32-bit targets.
#target(size: 32)
preset USize.MAX: USize = 4294967295

/// The width of `USize` in bits: the target pointer width (64 or 32).
#target(size: 64)
preset USize.BITS: USize = 64

/// The width of `USize` in bits: the target pointer width (64 or 32).
#target(size: 32)
preset USize.BITS: USize = 32

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are set to 1.
/// :returns: The population count, from 0 to `USize.BITS`.
routine USize.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The leading zero count; `USize.BITS` when `self` is 0.
routine USize.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The trailing zero count; `USize.BITS` when `self` is 0.
routine USize.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of the bits of `self`, so the least significant bit becomes the most significant.
/// :returns: `self` with its bits mirrored.
routine USize.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: The number of clear bits, from 0 to `USize.BITS`.
routine USize.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The leading one count; `USize.BITS` when every bit is set.
routine USize.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The trailing one count; `USize.BITS` when every bit is set.
routine USize.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Reverses the byte order of `self`.
/// :returns: `self` with its bytes in the opposite order.
routine USize.swap_bytes(self: Self) -> Self
    block entry()
        r : Self = bswap<Self>(self)
        return(r)

/// Converts `self` from the host byte order to big-endian. Tessera targets are little-endian, so this swaps the bytes.
/// :returns: The big-endian representation of `self`.
routine USize.to_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts a big-endian value to the host byte order. Tessera targets are little-endian, so this swaps the bytes.
/// :returns: The host-order value of `self`.
routine USize.from_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts `self` from the host byte order to little-endian. Tessera targets are little-endian, so this returns `self` unchanged.
/// :returns: The little-endian representation of `self`.
routine USize.to_le(self: Self) -> Self
    block entry()
        return(self)

/// Converts a little-endian value to the host byte order. Tessera targets are little-endian, so this returns `self` unchanged.
/// :returns: The host-order value of `self`.
routine USize.from_le(self: Self) -> Self
    block entry()
        return(self)

/// True when exactly one bit is set.
routine USize.is_power_of_two(self: Self) -> Bool
    block entry()
        ones : Self = popcount<Self>(self)
        r    : Bool = ones.eq(1)
        return(r)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where both operands have it set.
routine USize.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where either operand has it set.
routine USize.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with a bit set where exactly one operand has it set.
routine USize.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise complement of `self`.
/// :returns: `self` with every bit flipped.
routine USize.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// A shift by BITS or more shifts every bit out: the result is 0 (see Operations, Bitwise and Shifts).
/// The raw shift is poison then, and the select never picks it.
routine USize.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, logical: zeros fill in. A shift by BITS or more gives 0.
routine USize.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = lshr<Self>(self, n)
        out      : Self = 0
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates by n modulo the bit width.
routine USize.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits of `self` right by `n`, modulo the bit width. Bits shifted out at the bottom re-enter at the top.
/// :param n: The rotation amount in bits.
/// :returns: The rotated value.
routine USize.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// None when n is outside 0 ..< BITS.
routine USize.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts `self` right (zeros fill in), reporting an out-of-range amount instead of saturating to 0.
/// :param n: The shift amount in bits.
/// :returns: The shifted value.
/// :absent: `n` is outside `0 ..< USize.BITS`.
routine USize.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = lshr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts by n modulo the bit width.
#target(size: 64)
routine USize.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 63)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Shifts by n modulo the bit width.
#target(size: 32)
routine USize.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 31)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Shifts `self` right (zeros fill in) by `n` modulo the bit width.
/// :param n: The shift amount in bits; reduced modulo `USize.BITS`.
/// :returns: The shifted value.
#target(size: 64)
routine USize.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 63)
        r      : Self = lshr<Self>(self, amount)
        return(r)

/// Shifts `self` right (zeros fill in) by `n` modulo the bit width.
/// :param n: The shift amount in bits; reduced modulo `USize.BITS`.
/// :returns: The shifted value.
#target(size: 32)
routine USize.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 31)
        r      : Self = lshr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// Panics on overflow.
#track_caller
routine USize.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = uadd_overflows<Self>(self, other)
        branch overflow
            ? panic_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Adds `other` to `self`, reporting overflow instead of panicking.
/// :param other: The right-hand operand.
/// :returns: The sum.
/// :absent: The sum exceeds `USize.MAX`.
routine USize.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = uadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Wraps modulo 2^BITS.
routine USize.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// Saturates at MIN / MAX.
routine USize.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = uadd_sat<Self>(self, other)
        return(r)

/// Panics on overflow.
#track_caller
routine USize.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = usub_overflows<Self>(self, other)
        branch overflow
            ? panic_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, reporting underflow instead of panicking.
/// :param other: The right-hand operand.
/// :returns: The difference.
/// :absent: `other` is greater than `self`, so the result would be below 0.
routine USize.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = usub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Wraps modulo 2^BITS.
routine USize.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// Saturates at MIN / MAX.
routine USize.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = usub_sat<Self>(self, other)
        return(r)

/// Panics on overflow.
#track_caller
routine USize.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = umul_overflows<Self>(self, other)
        branch overflow
            ? panic_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, reporting overflow instead of panicking.
/// :param other: The right-hand operand.
/// :returns: The product.
/// :absent: The product exceeds `USize.MAX`.
routine USize.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = umul_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Wraps modulo 2^BITS.
routine USize.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// Saturates at MAX.
routine USize.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = self.mul_overflows(other)
        product  : Self = mul<Self>(self, other)
        r        : Self = overflow
            ? Self.MAX
            : product
        return(r)

/// Whether the exact product is outside MIN ..= MAX.
routine USize.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = umul_overflows<Self>(self, other)
        return(r)

// -- division --------------------------------------------------------------------

/// Panics on a zero divisor.
#track_caller
routine USize.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? panic_division_by_zero()
            : continue
        r : Self = udiv<Self>(self, other)
        return(r)

/// Panics on a zero divisor.
#track_caller
routine USize.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? panic_division_by_zero()
            : continue
        r : Self = urem<Self>(self, other)
        return(r)

/// None on a zero divisor.
routine USize.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = udiv<Self>(self, other)
        return(Option<Self>.Present(r))

/// Remainder of `self` divided by `other`, reporting a zero divisor instead of panicking.
/// :param other: The divisor.
/// :returns: The remainder, from 0 to `other - 1`.
/// :absent: `other` is 0.
routine USize.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = urem<Self>(self, other)
        return(Option<Self>.Present(r))

/// Division rounding up. Panics on a zero divisor.
routine USize.div_ceil(self: Self, other: Self) -> Self
    block entry()
        q     : Self = self.div(other)
        rem   : Self = urem<Self>(self, other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(q)
            : continue
        r : Self = add<Self>(q, 1)
        return(r)

/// The smallest multiple of other that is >= self. Panics on a zero other and
/// when the multiple doesn't fit.
routine USize.next_multiple_of(self: Self, other: Self) -> Self
    block entry()
        rem   : Self = self.mod(other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(self)
            : continue
        gap : Self = sub<Self>(other, rem)
        r   : Self = self.add(gap)
        return(r)

/// The smallest power of two >= self; 0 and 1 give 1. Panics when it doesn't fit.
#track_caller
routine USize.next_power_of_two(self: Self) -> Self
    block entry()
        r : Option<Self> = self.next_power_of_two_checked()
        when r
            .Present(value) -> return(value)
            .Absent         -> panic_overflow()

/// None when the power of two doesn't fit.
routine USize.next_power_of_two_checked(self: Self) -> Option<Self>
    block entry()
        small : Bool = self.le(1)
        branch small
            ? return(Option<Self>.Present(1))
            : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up()
        below : Self = sub<Self>(self, 1)
        lz    : Self = clz<Self>(below, true)
        shift : Self = sub<Self>(Self.BITS, lz)
        fits  : Bool = shift.lt(Self.BITS)
        branch fits
            ? continue
            : return(Option<Self>.Absent)
        power : Self = shl<Self>(1, shift)
        return(Option<Self>.Present(power))

// -- powers ----------------------------------------------------------------------

/// Panics when the power doesn't fit.
#track_caller
routine USize.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> panic_overflow()

/// Wrapping power by squaring.
routine USize.pow_wrap(self: Self, exponent: U32) -> Self
    block entry()
        jump loop(self, exponent, 1)

    block loop(base: Self, exponent_left: U32, acc: Self)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc)
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc, base)
        next_acc  : Self = odd
            ? with_base
            : acc
        jump loop(mul<Self>(base, base), exponent_left.shr(1), next_acc)

/// None if any step overflows.
#target(size: 64)
routine USize.pow_checked(self: Self, exponent: U32) -> Option<Self>
    block entry()
        jump loop(self, exponent, 1, false)

    block loop(base: Self, exponent_left: U32, acc: Self, overflow: Bool)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish(acc, overflow)
            : step(base, exponent_left, acc, overflow)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(base: Self, exponent_left: U32, acc: Self, overflow: Bool)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = umul_overflows<Self>(acc, base).bitand(odd)
        with_base    : Self = mul<Self>(acc, base)
        next_acc     : Self = odd
            ? with_base
            : acc
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = umul_overflows<Self>(base, base).bitand(more)
        any           : Bool = overflow.bitor(acc_overflow).bitor(base_overflow)
        jump loop(mul<Self>(base, base), rest, next_acc, any)

    block finish(acc: Self, overflow: Bool)
        fits : Bool         = overflow.bitnot()
        r    : Option<Self> = fits.then_present(acc)
        return(r)

/// None if any step overflows.
#target(size: 32)
routine USize.pow_checked(self: Self, exponent: U32) -> Option<Self>
    block entry()
        jump loop(self, exponent, 1, false)

    block loop(base: Self, exponent_left: U32, acc: Self, overflow: Bool)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish(acc, overflow)
            : step(base, exponent_left, acc, overflow)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(base: Self, exponent_left: U32, acc: Self, overflow: Bool)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = umul_overflows<Self>(acc, base).bitand(odd)
        with_base    : Self = mul<Self>(acc, base)
        next_acc     : Self = odd
            ? with_base
            : acc
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = umul_overflows<Self>(base, base).bitand(more)
        any           : Bool = overflow.bitor(acc_overflow).bitor(base_overflow)
        jump loop(mul<Self>(base, base), rest, next_acc, any)

    block finish(acc: Self, overflow: Bool)
        fits : Bool         = overflow.bitnot()
        r    : Option<Self> = fits.then_present(acc)
        return(r)

/// MAX on overflow.
routine USize.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(Self.MAX)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Whether `self` and `other` hold the same value.
/// :param other: The right-hand operand.
/// :returns: `true` when the values are equal.
routine USize.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Whether `self` and `other` hold different values.
/// :param other: The right-hand operand.
/// :returns: `true` when the values differ.
routine USize.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Whether `self` is less than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 64)
#[external("llvm"), template("{result} = icmp ult i64 {self}, {other}")]
routine USize.lt(self: Self, other: Self) -> Bool

/// Whether `self` is less than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 32)
#[external("llvm"), template("{result} = icmp ult i32 {self}, {other}")]
routine USize.lt(self: Self, other: Self) -> Bool

/// Whether `self` is less than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 64)
#[external("llvm"), template("{result} = icmp ule i64 {self}, {other}")]
routine USize.le(self: Self, other: Self) -> Bool

/// Whether `self` is less than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 32)
#[external("llvm"), template("{result} = icmp ule i32 {self}, {other}")]
routine USize.le(self: Self, other: Self) -> Bool

/// Whether `self` is greater than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 64)
#[external("llvm"), template("{result} = icmp ugt i64 {self}, {other}")]
routine USize.gt(self: Self, other: Self) -> Bool

/// Whether `self` is greater than `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 32)
#[external("llvm"), template("{result} = icmp ugt i32 {self}, {other}")]
routine USize.gt(self: Self, other: Self) -> Bool

/// Whether `self` is greater than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 64)
#[external("llvm"), template("{result} = icmp uge i64 {self}, {other}")]
routine USize.ge(self: Self, other: Self) -> Bool

/// Whether `self` is greater than or equal to `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: `true` when the relation holds.
#target(size: 32)
#[external("llvm"), template("{result} = icmp uge i32 {self}, {other}")]
routine USize.ge(self: Self, other: Self) -> Bool

/// -1, 0, or 1.
routine USize.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// The smaller of `self` and `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: The lesser operand.
routine USize.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = umin<Self>(self, other)
        return(r)

/// The larger of `self` and `other`, compared as unsigned values.
/// :param other: The right-hand operand.
/// :returns: The greater operand.
routine USize.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = umax<Self>(self, other)
        return(r)

/// Panics if lo > hi.
#track_caller
routine USize.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : panic_invalid_value()

    block clamp()
        at_least_lo : Self = umax<Self>(self, lo)
        r           : Self = umin<Self>(at_least_lo, hi)
        return(r)

/// self in [lo, hi], both ends included. False when lo > hi.
routine USize.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine USize.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// xxh64 of the bits widened to 64, the same hash for USize and SSize.
routine USize.hash(self: Self) -> U64
    block entry()
        wide : U64 = self.to<U64>()
        h    : U64 = xxh64_hash_u64(wide, 0)
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// |self - other|, which always fits in USize.
routine USize.abs_diff(self: Self, other: Self) -> Self
    block entry()
        hi   : Self = umax<Self>(self, other)
        lo   : Self = umin<Self>(self, other)
        diff : Self = sub<Self>(hi, lo)
        r    : Self = bitcast<Self, Self>(diff)
        return(r)

/// floor((self + other) / 2) without overflow.
routine USize.midpoint(self: Self, other: Self) -> Self
    block entry()
        common    : Self = self.bitand(other)
        half_diff : Self = self.bitxor(other).shr(1)
        r         : Self = add<Self>(common, half_diff)
        return(r)

/// floor(log2(self)). Panics on 0.
#track_caller
routine USize.ilog2(self: Self) -> Self
    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? panic_numeric_domain()
            : continue
        lz : Self = clz<Self>(self, true)
        r  : Self = sub<Self>(Self.BITS.sub(1), lz)
        return(r)

/// floor(log10(self)). Panics on 0.
#track_caller
routine USize.ilog10(self: Self) -> Self
    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? panic_numeric_domain()
            : loop(self, 0)

    block loop(rest: Self, digits: Self)
        last : Bool = rest.lt(10)
        branch last
            ? return(digits)
            : continue
        jump loop(rest.div(10), digits.add(1))

/// floor(sqrt(self)), computed one result bit at a time.
routine USize.isqrt(self: Self) -> Self
    block entry()
        top_bit : Self = shl<Self>(1, Self.BITS.sub(2))
        jump align(top_bit)

    // Start from the highest power of four that is <= self.
    block align(bit: Self)
        too_big : Bool = bit.gt(self)
        branch too_big
            ? align(bit.shr(2))
            : loop(self, 0, bit)

    block loop(rest: Self, root: Self, bit: Self)
        done : Bool = bit.eq(0)
        branch done
            ? return(root)
            : continue
        trial     : Self = add<Self>(root, bit)
        fits      : Bool = rest.ge(trial)
        half_root : Self = root.shr(1)
        next_bit  : Self = bit.shr(2)
        branch fits
            ? take(rest, trial, half_root, bit, next_bit) \
            : loop(rest, half_root, next_bit)

    block take(rest: Self, trial: Self, half_root: Self, bit: Self, next_bit: Self)
        jump loop(sub<Self>(rest, trial), add<Self>(half_root, bit), next_bit)

// -- conversions -----------------------------------------------------------------

/// Identity conversion: returns `self` unchanged.
/// :returns: `self`.
routine USize.to<Self>(self: Self) -> Self
    block entry()
        return(self)

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly; one that can panics when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Panics when the value doesn't fit in S8.
#track_caller
routine USize.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.le(127)
        branch fits
            ? continue
            : panic_overflow()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to `S8` if the value is in that type's range.
/// :returns: The value as an `S8`.
/// :absent: The value does not fit in `S8`.
routine USize.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.le(127)
        value : S8         = trunc<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Keeps the low 8 bits (modulo 2^8).
routine USize.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Saturates at S8's range.
routine USize.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_most : Self = umin<Self>(self, 127)
        r       : S8   = trunc<Self, S8>(at_most)
        return(r)

/// Panics when the value doesn't fit in S16.
#track_caller
routine USize.to<S16>(self: Self) -> S16
    block entry()
        fits : Bool = self.le(32767)
        branch fits
            ? continue
            : panic_overflow()
        r : S16 = trunc<Self, S16>(self)
        return(r)

/// Converts `self` to `S16` if the value is in that type's range.
/// :returns: The value as an `S16`.
/// :absent: The value does not fit in `S16`.
routine USize.to_checked<S16>(self: Self) -> Option<S16>
    block entry()
        fits  : Bool        = self.le(32767)
        value : S16         = trunc<Self, S16>(self)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Keeps the low 16 bits (modulo 2^16).
routine USize.to_wrap<S16>(self: Self) -> S16
    block entry()
        r : S16 = trunc<Self, S16>(self)
        return(r)

/// Saturates at S16's range.
routine USize.to_clamp<S16>(self: Self) -> S16
    block entry()
        at_most : Self = umin<Self>(self, 32767)
        r       : S16  = trunc<Self, S16>(at_most)
        return(r)

/// Panics when the value doesn't fit in S32.
#[target(size: 64), track_caller]
routine USize.to<S32>(self: Self) -> S32
    block entry()
        fits : Bool = self.le(2147483647)
