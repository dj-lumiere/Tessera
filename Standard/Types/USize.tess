// Tessera stdlib: USize — the target's pointer-width unsigned integer
//
// For lengths, indices, counts, and sizes. It is U16, U32, or U64 underneath, by the target's
// pointer width, but a type of its own on every target: it never mixes with
// a fixed-width integer without a to<T>() call, so a program type-checks
// the same way everywhere. Every method has the same signature on every
// target. A conversion that can lose the value on some target has its
// _checked / _wrap / _clamp forms on all of them.
//
// The method set mirrors U32.tess and U64.tess.

module Standard::Core

/// Pointer-width unsigned integer: 32 or 64 bits by the target. Use it for lengths, indices, counts, and sizes. It never mixes with a fixed-width integer without a `to<...>()` call.
/// Arithmetic crashes on overflow. The `_checked` forms return an `Option`, `_wrap` forms are modular, and `_clamp` forms saturate.
record USize
conform Equatable<USize>, Comparable<USize>, Hashable<USize>

// -- constants -------------------------------------------------------------------

/// The smallest `USize` value, 0.
preset USize.MIN: USize = 0

/// The largest `USize` value: 2^64 - 1 on 64-bit targets, 2^32 - 1 on 32-bit targets.
#target(size: 64)
preset USize.MAX: USize = 18446744073709551615

/// The largest `USize` value: 2^64 - 1 on 64-bit targets, 2^32 - 1 on 32-bit targets.
#target(size: 32)
preset USize.MAX: USize = 4294967295

/// The width of `USize` in bits: the target pointer width (64 or 32).
#target(size: 64)
preset USize.BITS: USize = 64

/// The width of `USize` in bits: the target pointer width (64 or 32).
#target(size: 32)
preset USize.BITS: USize = 32

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `me` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine USize.count_ones(me: Me) -> Me
    block entry()
        r : Me = popcount<Me>(me)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `me` is 0.
routine USize.leading_zeros(me: Me) -> Me
    block entry()
        r : Me = clz<Me>(me, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `me` is 0.
routine USize.trailing_zeros(me: Me) -> Me
    block entry()
        r : Me = ctz<Me>(me, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine USize.reverse_bits(me: Me) -> Me
    block entry()
        r : Me = bitreverse<Me>(me)
        return(r)

/// Counts the bits of `me` that are 0.
/// :returns: `BITS` minus the population count.
routine USize.count_zeros(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = popcount<Me>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `me` is `MAX`.
routine USize.leading_ones(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = clz<Me>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `me` is `MAX`.
routine USize.trailing_ones(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = ctz<Me>(inverted, false)
        return(r)

/// Reverses the order of the bytes of `me`.
/// :returns: The byte-swapped value.
routine USize.swap_bytes(me: Me) -> Me
    block entry()
        r : Me = bswap<Me>(me)
        return(r)

/// Converts from this target's byte order to big-endian, which swaps the bytes.
/// :returns: The value in big-endian byte order.
routine USize.to_be(me: Me) -> Me
    block entry()
        r : Me = me.swap_bytes()
        return(r)

/// Converts from big-endian to this target's byte order, which swaps the bytes.
/// :returns: The value in native byte order.
routine USize.from_be(me: Me) -> Me
    block entry()
        r : Me = me.swap_bytes()
        return(r)

/// Converts from this target's byte order to little-endian. The target is little-endian, so this returns `me` unchanged.
/// :returns: The value in little-endian byte order.
routine USize.to_le(me: Me) -> Me
    block entry()
        return(me)

/// Converts from little-endian to this target's byte order. The target is little-endian, so this returns `me` unchanged.
/// :returns: The value in native byte order.
routine USize.from_le(me: Me) -> Me
    block entry()
        return(me)

/// Tests whether exactly one bit of `me` is set.
/// :returns: True when `me` is a power of two.
routine USize.is_power_of_two(me: Me) -> Bool
    block entry()
        ones : Me   = popcount<Me>(me)
        r    : Bool = ones.eq(1)
        return(r)

/// Bitwise AND of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine USize.bitand(me: Me, other: Me) -> Me
    block entry()
        r : Me = band<Me>(me, other)
        return(r)

/// Bitwise OR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine USize.bitor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bor<Me>(me, other)
        return(r)

/// Bitwise XOR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine USize.bitxor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bxor<Me>(me, other)
        return(r)

/// Bitwise NOT: flips every bit of `me`.
/// :returns: The complement, which equals `MAX - me`.
routine USize.bitnot(me: Me) -> Me
    block entry()
        r : Me = bnot<Me>(me)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted left by `n`, or 0 when `n` is `BITS` or more.
/// :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine USize.shl(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        shifted  : Me   = shl<Me>(me, n)
        r        : Me   = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, logical: 0 bits fill in. A shift by `BITS` or more gives 0.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted right by `n`, or 0 when `n` is `BITS` or more.
routine USize.shr(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        shifted  : Me   = lshr<Me>(me, n)
        out      : Me   = 0
        r        : Me   = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine USize.rotl(me: Me, n: Me) -> Me
    block entry()
        r : Me = fshl<Me>(me, me, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine USize.rotr(me: Me, n: Me) -> Me
    block entry()
        r : Me = fshr<Me>(me, me, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted left by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine USize.shl_checked(me: Me, n: Me) -> Option<Me>
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        branch in_range
            ? continue
            : return(Option<Me>.Absent)
        r : Me = shl<Me>(me, n)
        return(Option<Me>.Present(r))

/// Logical shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted right by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine USize.shr_checked(me: Me, n: Me) -> Option<Me>
    block entry()
        in_range : Bool = n.lt(Me.BITS)
        branch in_range
            ? continue
            : return(Option<Me>.Absent)
        r : Me = lshr<Me>(me, n)
        return(Option<Me>.Present(r))

/// Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out. On 64-bit targets.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted left, with 0 bits filling in.
#target(size: 64)
routine USize.shl_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 63)
        r      : Me = shl<Me>(me, amount)
        return(r)

/// Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out. On 32-bit targets.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted left, with 0 bits filling in.
#target(size: 32)
routine USize.shl_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 31)
        r      : Me = shl<Me>(me, amount)
        return(r)

/// Logical shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted right with 0 bits filling in.
#target(size: 64)
routine USize.shr_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 63)
        r      : Me = lshr<Me>(me, amount)
        return(r)

/// Logical shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted right with 0 bits filling in.
#target(size: 32)
routine USize.shr_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 31)
        r      : Me = lshr<Me>(me, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `me` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in `USize`.
#track_caller
routine USize.add(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = uadd_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = add<Me>(me, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in `USize`.
routine USize.add_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = uadd_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = add<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The sum of `me` and `other`, wrapped modulo 2^`BITS`.
/// :param other: The value to add.
/// :returns: The low `BITS` bits of the exact sum.
routine USize.add_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = add<Me>(me, other)
        return(r)

/// The sum of `me` and `other`, saturated at `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MAX` when the exact sum is above the range.
routine USize.add_clamp(me: Me, other: Me) -> Me
    block entry()
        r : Me = uadd_sat<Me>(me, other)
        return(r)

/// The difference of `me` and `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `IntegerOverflowError` when the difference does not fit in `USize`.
#track_caller
routine USize.sub(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = usub_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = sub<Me>(me, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in `USize`.
routine USize.sub_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = usub_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = sub<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The difference of `me` and `other`, wrapped modulo 2^`BITS`.
/// :param other: The value to subtract.
/// :returns: The low `BITS` bits of the exact difference.
routine USize.sub_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = sub<Me>(me, other)
        return(r)

/// The difference of `me` and `other`, saturated at 0.
/// :param other: The value to subtract.
/// :returns: The difference, or 0 when the exact difference is below 0.
routine USize.sub_clamp(me: Me, other: Me) -> Me
    block entry()
        r : Me = usub_sat<Me>(me, other)
        return(r)

/// The product of `me` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in `USize`.
#track_caller
routine USize.mul(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = umul_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = mul<Me>(me, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in `USize`.
routine USize.mul_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = umul_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = mul<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The product of `me` and `other`, wrapped modulo 2^`BITS`.
/// :param other: The factor to multiply by.
/// :returns: The low `BITS` bits of the exact product.
routine USize.mul_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = mul<Me>(me, other)
        return(r)

/// The product of `me` and `other`, saturated at `MAX`.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MAX` when the exact product is above the range.
routine USize.mul_clamp(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = me.mul_overflows(other)
        product  : Me   = mul<Me>(me, other)
        r        : Me   = overflow
            ? Me.MAX
            : product
        return(r)

/// Tests whether the exact product of `me` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in `USize`.
routine USize.mul_overflows(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = umul_overflows<Me>(me, other)
        return(r)

// -- division --------------------------------------------------------------------

/// The quotient of `me` divided by `other`, truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine USize.div(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Me = udiv<Me>(me, other)
        return(r)

/// The remainder of `me` divided by `other`.
/// :param other: The divisor.
/// :returns: The remainder, between 0 and `other - 1`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine USize.mod(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Me = urem<Me>(me, other)
        return(r)

/// Division that reports failure instead of crashing. The quotient is truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient of `me` divided by `other`.
/// :absent: On a zero divisor.
routine USize.div_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Me>.Absent)
            : continue
        r : Me = udiv<Me>(me, other)
        return(Option<Me>.Present(r))

/// Remainder that reports failure instead of crashing.
/// :param other: The divisor.
/// :returns: The remainder of `me` divided by `other`.
/// :absent: On a zero divisor.
routine USize.mod_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Me>.Absent)
            : continue
        r : Me = urem<Me>(me, other)
        return(Option<Me>.Present(r))

/// The quotient of `me` divided by `other`, rounded up.
/// :param other: The divisor.
/// :returns: The quotient, rounded up.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine USize.div_ceil(me: Me, other: Me) -> Me
    block entry()
        q     : Me   = me.div(other)
        rem   : Me   = urem<Me>(me, other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(q)
            : continue
        r : Me = add<Me>(q, 1)
        return(r)

/// The smallest multiple of `other` that is at least `me`.
/// :param other: The value whose multiple to round up to.
/// :returns: `me` when it is already a multiple of `other`, else the next multiple above it.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when the multiple does not fit in `USize`.
#track_caller
routine USize.next_multiple_of(me: Me, other: Me) -> Me
    block entry()
        rem   : Me   = me.mod(other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(me)
            : continue
        gap : Me = sub<Me>(other, rem)
        r   : Me = me.add(gap)
        return(r)

/// The smallest power of two that is at least `me`. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :throws: Crashes with `IntegerOverflowError` when the power of two does not fit in `USize`.
#track_caller
routine USize.next_power_of_two(me: Me) -> Me
    block entry()
        r : Option<Me> = me.next_power_of_two_checked()
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// The smallest power of two that is at least `me`, reporting when it does not fit. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :absent: When the power of two does not fit in `USize`.
routine USize.next_power_of_two_checked(me: Me) -> Option<Me>
    block entry()
        small : Bool = me.le(1)
        branch small
            ? return(Option<Me>.Present(1))
            : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up()
        below : Me   = sub<Me>(me, 1)
        lz    : Me   = clz<Me>(below, true)
        shift : Me   = sub<Me>(Me.BITS, lz)
        fits  : Bool = shift.lt(Me.BITS)
        branch fits
            ? continue
            : return(Option<Me>.Absent)
        power : Me = shl<Me>(1, shift)
        return(Option<Me>.Present(power))

// -- powers ----------------------------------------------------------------------

/// Raises `me` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :throws: Crashes with `IntegerOverflowError` when the exact power does not fit in `USize`.
#track_caller
routine USize.pow(me: Me, exponent: U32) -> Me
    block entry()
        r : Option<Me> = me.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `me` to the power `exponent` by squaring, wrapping modulo 2^`BITS`.
/// :param exponent: The power to raise to.
/// :returns: The low `BITS` bits of the exact power.
routine USize.pow_wrap(me: Me, exponent: U32) -> Me
    shared base : @Me <- me
    shared acc  : @Me <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Me   = mul<Me>(acc.load(), base.load())
        next_acc  : Me   = odd
            ? with_base
            : acc.load()
        next_acc2 : Me = next_acc
        next_base : Me = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Power that reports overflow. On 64-bit targets.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :absent: When the exact power does not fit in `USize`.
#target(size: 64)
routine USize.pow_checked(me: Me, exponent: U32) -> Option<Me>
    shared base     : @Me   <- me
    shared acc      : @Me   <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = umul_overflows<Me>(acc.load(), base.load()).bitand(odd)
        with_base    : Me   = mul<Me>(acc.load(), base.load())
        next_acc     : Me   = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = umul_overflows<Me>(base.load(), base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Me   = next_acc
        next_base     : Me   = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool       = overflow.load().bitnot()
        r    : Option<Me> = fits.then_present(acc.load())
        return(r)

/// Power that reports overflow. On 32-bit targets.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :absent: When the exact power does not fit in `USize`.
#target(size: 32)
routine USize.pow_checked(me: Me, exponent: U32) -> Option<Me>
    shared base     : @Me   <- me
    shared acc      : @Me   <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = umul_overflows<Me>(acc.load(), base.load()).bitand(odd)
        with_base    : Me   = mul<Me>(acc.load(), base.load())
        next_acc     : Me   = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = umul_overflows<Me>(base.load(), base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Me   = next_acc
        next_base     : Me   = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool       = overflow.load().bitnot()
        r    : Option<Me> = fits.then_present(acc.load())
        return(r)

/// Raises `me` to the power `exponent`, saturated at `MAX`.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MAX` when the exact power does not fit.
routine USize.pow_clamp(me: Me, exponent: U32) -> Me
    block entry()
        checked : Option<Me> = me.pow_checked(exponent)
        r       : Me         = checked.unwrap_or(Me.MAX)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `me` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine USize.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ieq<Me>(me, other)
        return(r)

/// Tests whether `me` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine USize.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ine<Me>(me, other)
        return(r)

/// Unsigned less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me < other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp ult i64 {me}, {other}")]
routine USize.lt(me: Me, other: Me) -> Bool

/// Unsigned less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me < other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp ult i32 {me}, {other}")]
routine USize.lt(me: Me, other: Me) -> Bool

/// Unsigned less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me <= other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp ule i64 {me}, {other}")]
routine USize.le(me: Me, other: Me) -> Bool

/// Unsigned less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me <= other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp ule i32 {me}, {other}")]
routine USize.le(me: Me, other: Me) -> Bool

/// Unsigned greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me > other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp ugt i64 {me}, {other}")]
routine USize.gt(me: Me, other: Me) -> Bool

/// Unsigned greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me > other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp ugt i32 {me}, {other}")]
routine USize.gt(me: Me, other: Me) -> Bool

/// Unsigned greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me >= other`.
#target(size: 64)
#[external("llvm"), template("{result} = icmp uge i64 {me}, {other}")]
routine USize.ge(me: Me, other: Me) -> Bool

/// Unsigned greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me >= other`.
#target(size: 32)
#[external("llvm"), template("{result} = icmp uge i32 {me}, {other}")]
routine USize.ge(me: Me, other: Me) -> Bool

/// Compares `me` with `other` by unsigned order.
/// :param other: The value to compare with.
/// :returns: -1 when `me < other`, 0 when they are equal, and 1 when `me > other`.
routine USize.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by unsigned comparison.
/// :param other: The value to compare with.
/// :returns: `me` or `other`, whichever is smaller.
routine USize.min(me: Me, other: Me) -> Me
    block entry()
        r : Me = umin<Me>(me, other)
        return(r)

/// Returns the larger of two values by unsigned comparison.
/// :param other: The value to compare with.
/// :returns: `me` or `other`, whichever is larger.
routine USize.max(me: Me, other: Me) -> Me
    block entry()
        r : Me = umax<Me>(me, other)
        return(r)

/// Limits `me` to the range from `lo` to `hi`, both ends included.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine USize.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Me = umax<Me>(me, lo)
        r           : Me = umin<Me>(at_least_lo, hi)
        return(r)

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`.
routine USize.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`.
routine USize.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the bits widened to 64, under the process key, the same hash for `USize` and `SSize`.
/// :returns: The 64-bit hash of `me`.
routine USize.hash(me: Me) -> U64
    block entry()
        wide : U64 = me.to<U64>()
        h    : U64 = siphash24(wide, hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `me` and `other`, `|me - other|`, which always fits in `USize`.
/// :param other: The value to measure from.
/// :returns: `|me - other|` as a `USize`.
routine USize.abs_diff(me: Me, other: Me) -> Me
    block entry()
        hi   : Me = umax<Me>(me, other)
        lo   : Me = umin<Me>(me, other)
        diff : Me = sub<Me>(hi, lo)
        r    : Me = bitcast<Me, Me>(diff)
        return(r)

/// The average of `me` and `other`, rounded down, computed without overflow.
/// :param other: The other value.
/// :returns: `(me + other) / 2`, rounded down.
routine USize.midpoint(me: Me, other: Me) -> Me
    block entry()
        common    : Me = me.bitand(other)
        half_diff : Me = me.bitxor(other).shr(1)
        r         : Me = add<Me>(common, half_diff)
        return(r)

/// The base-2 logarithm of `me`, rounded down.
/// :returns: `floor(log2(me))`.
/// :throws: Crashes with `NumericDomainError` when `me` is 0.
#track_caller
routine USize.ilog2(me: Me) -> Me
    block entry()
        zero : Bool = me.eq(0)
        branch zero
            ? crash_numeric_domain()
            : continue
        lz : Me = clz<Me>(me, true)
        r  : Me = sub<Me>(Me.BITS.sub(1), lz)
        return(r)

/// The base-10 logarithm of `me`, rounded down.
/// :returns: `floor(log10(me))`.
/// :throws: Crashes with `NumericDomainError` when `me` is 0.
#track_caller
routine USize.ilog10(me: Me) -> Me
    shared digits : @Me <- 0

    block entry()
        zero : Bool = me.eq(0)
        branch zero
            ? crash_numeric_domain()
            : loop(me)

    block loop(rest: Me)
        last : Bool = rest.lt(10)
        branch last
            ? return(digits.load())
            : continue
        digits.load().add(1).store_into(digits)
        jump loop(rest.div(10))

/// The integer square root of `me`, rounded down.
/// :returns: `floor(sqrt(me))`.
routine USize.isqrt(me: Me) -> Me
    block entry()
        top_bit : Me = shl<Me>(1, Me.BITS.sub(2))
        jump align(top_bit)

    // Start from the highest power of four that is <= me.
    block align(bit: Me)
        too_big : Bool = bit.gt(me)
        branch too_big
            ? align(bit.shr(2))
            : loop(me, 0, bit)

    block loop(rest: Me, root: Me, bit: Me)
        done : Bool = bit.eq(0)
        branch done
            ? return(root)
            : continue
        trial     : Me   = add<Me>(root, bit)
        fits      : Bool = rest.ge(trial)
        half_root : Me   = root.shr(1)
        next_bit  : Me   = bit.shr(2)
        branch fits
            ? take(rest, trial, half_root, bit, next_bit) \
            : loop(rest, half_root, next_bit)

    block take(rest: Me, trial: Me, half_root: Me, bit: Me, next_bit: Me)
        jump loop(sub<Me>(rest, trial), add<Me>(half_root, bit), next_bit)

// -- conversions -----------------------------------------------------------------

/// The identity conversion: returns `me` unchanged.
/// :returns: `me` as `USize`.
routine USize.to<Me>(me: Me) -> Me
    block entry()
        return(me)

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Converts `me` to `S8`.
/// :returns: The same numeric value as an `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine USize.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.le(127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Me, S8>(me)
        return(r)

/// Converts `me` to `S8` when the value fits.
/// :returns: The value as an `S8`.
/// :absent: When `me` is outside the range of `S8`.
routine USize.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.le(127)
        value : S8         = trunc<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `me` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: The low bits of `me`, read as an `S8`.
routine USize.to_wrap<S8>(me: Me) -> S8
    block entry()
        r : S8 = trunc<Me, S8>(me)
        return(r)

/// Converts `me` to `S8`, saturating at `S8.MAX`.
/// :returns: The value, or `S8.MAX` when it is greater.
routine USize.to_clamp<S8>(me: Me) -> S8
    block entry()
        at_most : Me = umin<Me>(me, 127)
        r       : S8 = trunc<Me, S8>(at_most)
        return(r)

/// Converts `me` to `S16`.
/// :returns: The same numeric value as an `S16`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S16`.
#track_caller
routine USize.to<S16>(me: Me) -> S16
    block entry()
        fits : Bool = me.le(32767)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = trunc<Me, S16>(me)
        return(r)

/// Converts `me` to `S16` when the value fits.
/// :returns: The value as an `S16`.
/// :absent: When `me` is outside the range of `S16`.
routine USize.to_checked<S16>(me: Me) -> Option<S16>
    block entry()
        fits  : Bool        = me.le(32767)
        value : S16         = trunc<Me, S16>(me)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts `me` to `S16`, keeping the low 16 bits (modulo 2^16).
/// :returns: The low bits of `me`, read as an `S16`.
routine USize.to_wrap<S16>(me: Me) -> S16
    block entry()
        r : S16 = trunc<Me, S16>(me)
        return(r)

/// Converts `me` to `S16`, saturating at `S16.MAX`.
/// :returns: The value, or `S16.MAX` when it is greater.
routine USize.to_clamp<S16>(me: Me) -> S16
    block entry()
        at_most : Me  = umin<Me>(me, 32767)
        r       : S16 = trunc<Me, S16>(at_most)
        return(r)

/// Converts `me` to `S32`. On 64-bit targets.
/// :returns: The same numeric value as an `S32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S32`.
#[target(size: 64), track_caller]
routine USize.to<S32>(me: Me) -> S32
    block entry()
        fits : Bool = me.le(2147483647)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = trunc<Me, S32>(me)
        return(r)

/// Converts `me` to `S32`. On 32-bit targets.
/// :returns: The same numeric value as an `S32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S32`.
#[target(size: 32), track_caller]
routine USize.to<S32>(me: Me) -> S32
    block entry()
        fits : Bool = me.le(2147483647)
        branch fits
            ? continue
            : crash_overflow()
        r : S32 = bitcast<Me, S32>(me)
        return(r)

/// Converts `me` to `S32` when the value fits. On 64-bit targets.
/// :returns: The value as an `S32`.
/// :absent: When `me` is outside the range of `S32`.
#target(size: 64)
routine USize.to_checked<S32>(me: Me) -> Option<S32>
    block entry()
        fits  : Bool        = me.le(2147483647)
        value : S32         = trunc<Me, S32>(me)
        r     : Option<S32> = fits.then_present(value)
        return(r)

/// Converts `me` to `S32` when the value fits. On 32-bit targets.
/// :returns: The value as an `S32`.
/// :absent: When `me` is outside the range of `S32`.
#target(size: 32)
routine USize.to_checked<S32>(me: Me) -> Option<S32>
    block entry()
        fits  : Bool        = me.le(2147483647)
        value : S32         = bitcast<Me, S32>(me)
        r     : Option<S32> = fits.then_present(value)
        return(r)

/// Converts `me` to `S32`, keeping the low 32 bits (modulo 2^32). On 64-bit targets.
/// :returns: The low bits of `me`, read as an `S32`.
#target(size: 64)
routine USize.to_wrap<S32>(me: Me) -> S32
    block entry()
        r : S32 = trunc<Me, S32>(me)
        return(r)

/// Converts `me` to `S32`, keeping the low 32 bits (modulo 2^32). On 32-bit targets.
/// :returns: The low bits of `me`, read as an `S32`.
#target(size: 32)
routine USize.to_wrap<S32>(me: Me) -> S32
    block entry()
        r : S32 = bitcast<Me, S32>(me)
        return(r)

/// Converts `me` to `S32`, saturating at `S32.MAX`. On 64-bit targets.
/// :returns: The value, or `S32.MAX` when it is greater.
#target(size: 64)
routine USize.to_clamp<S32>(me: Me) -> S32
    block entry()
        at_most : Me  = umin<Me>(me, 2147483647)
        r       : S32 = trunc<Me, S32>(at_most)
        return(r)

/// Converts `me` to `S32`, saturating at `S32.MAX`. On 32-bit targets.
/// :returns: The value, or `S32.MAX` when it is greater.
#target(size: 32)
routine USize.to_clamp<S32>(me: Me) -> S32
    block entry()
        at_most : Me  = umin<Me>(me, 2147483647)
        r       : S32 = bitcast<Me, S32>(at_most)
        return(r)

/// Converts `me` to `S64`. On 64-bit targets.
/// :returns: The same numeric value as an `S64`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S64`.
#[target(size: 64), track_caller]
routine USize.to<S64>(me: Me) -> S64
    block entry()
        fits : Bool = me.le(9223372036854775807)
        branch fits
            ? continue
            : crash_overflow()
        r : S64 = bitcast<Me, S64>(me)
        return(r)

/// Converts `me` to `S64`. Every `USize` value fits in `S64`, so the conversion never fails. On 32-bit targets.
/// :returns: The same numeric value as an `S64`.
#target(size: 32)
routine USize.to<S64>(me: Me) -> S64
    block entry()
        r : S64 = zext<Me, S64>(me)
        return(r)

/// Converts `me` to `S64` when the value fits. On 64-bit targets.
/// :returns: The value as an `S64`.
/// :absent: When `me` is outside the range of `S64`.
#target(size: 64)
routine USize.to_checked<S64>(me: Me) -> Option<S64>
    block entry()
        fits  : Bool        = me.le(9223372036854775807)
        value : S64         = bitcast<Me, S64>(me)
        r     : Option<S64> = fits.then_present(value)
        return(r)

/// Converts `me` to `S64`. Every `USize` value fits in `S64` here, so the result is always present. On 32-bit targets.
/// :returns: The value as an `S64`, wrapped in an `Option`.
#target(size: 32)
routine USize.to_checked<S64>(me: Me) -> Option<S64>
    block entry()
        r : S64 = me.to<S64>()
        return(Option<S64>.Present(r))

/// Converts `me` to `S64`, keeping the low 64 bits (modulo 2^64). On 64-bit targets.
/// :returns: The low bits of `me`, read as an `S64`.
#target(size: 64)
routine USize.to_wrap<S64>(me: Me) -> S64
    block entry()
        r : S64 = bitcast<Me, S64>(me)
        return(r)

/// Converts `me` to `S64` like {USize.to<S64>}. No value is lost here, so no wrapping or saturation occurs. On 32-bit targets.
/// :returns: The same numeric value as an `S64`.
#target(size: 32)
routine USize.to_wrap<S64>(me: Me) -> S64
    block entry()
        r : S64 = me.to<S64>()
        return(r)

/// Converts `me` to `S64`, saturating at `S64.MAX`. On 64-bit targets.
/// :returns: The value, or `S64.MAX` when it is greater.
#target(size: 64)
routine USize.to_clamp<S64>(me: Me) -> S64
    block entry()
        at_most : Me  = umin<Me>(me, 9223372036854775807)
        r       : S64 = bitcast<Me, S64>(at_most)
        return(r)

/// Converts `me` to `S64` like {USize.to<S64>}. No value is lost here, so no wrapping or saturation occurs. On 32-bit targets.
/// :returns: The same numeric value as an `S64`.
#target(size: 32)
routine USize.to_clamp<S64>(me: Me) -> S64
    block entry()
        r : S64 = me.to<S64>()
        return(r)

/// Converts `me` to `S128`. Every `USize` value fits in `S128`, so the conversion never fails.
/// :returns: The same numeric value as an `S128`.
routine USize.to<S128>(me: Me) -> S128
    block entry()
        r : S128 = zext<Me, S128>(me)
        return(r)

/// Converts `me` to `S256`. Every `USize` value fits in `S256`, so the conversion never fails.
/// :returns: The same numeric value as an `S256`.
routine USize.to<S256>(me: Me) -> S256
    block entry()
        r : S256 = zext<Me, S256>(me)
        return(r)

/// Converts `me` to `U8`.
/// :returns: The same numeric value as a `U8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U8`.
#track_caller
routine USize.to<U8>(me: Me) -> U8
    block entry()
        fits : Bool = me.le(255)
        branch fits
            ? continue
            : crash_overflow()
        r : U8 = trunc<Me, U8>(me)
        return(r)

/// Converts `me` to `U8` when the value fits.
/// :returns: The value as a `U8`.
/// :absent: When `me` is outside the range of `U8`.
routine USize.to_checked<U8>(me: Me) -> Option<U8>
    block entry()
        fits  : Bool       = me.le(255)
        value : U8         = trunc<Me, U8>(me)
        r     : Option<U8> = fits.then_present(value)
        return(r)

/// Converts `me` to `U8`, keeping the low 8 bits (modulo 2^8).
/// :returns: The low bits of `me`, read as a `U8`.
routine USize.to_wrap<U8>(me: Me) -> U8
    block entry()
        r : U8 = trunc<Me, U8>(me)
        return(r)

/// Converts `me` to `U8`, saturating at `U8.MAX`.
/// :returns: The value, or `U8.MAX` when it is greater.
routine USize.to_clamp<U8>(me: Me) -> U8
    block entry()
        at_most : Me = umin<Me>(me, 255)
        r       : U8 = trunc<Me, U8>(at_most)
        return(r)

/// Converts `me` to `U16`.
/// :returns: The same numeric value as a `U16`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U16`.
#track_caller
routine USize.to<U16>(me: Me) -> U16
    block entry()
        fits : Bool = me.le(65535)
        branch fits
            ? continue
            : crash_overflow()
        r : U16 = trunc<Me, U16>(me)
        return(r)

/// Converts `me` to `U16` when the value fits.
/// :returns: The value as a `U16`.
/// :absent: When `me` is outside the range of `U16`.
routine USize.to_checked<U16>(me: Me) -> Option<U16>
    block entry()
        fits  : Bool        = me.le(65535)
        value : U16         = trunc<Me, U16>(me)
        r     : Option<U16> = fits.then_present(value)
        return(r)

/// Converts `me` to `U16`, keeping the low 16 bits (modulo 2^16).
/// :returns: The low bits of `me`, read as a `U16`.
routine USize.to_wrap<U16>(me: Me) -> U16
    block entry()
        r : U16 = trunc<Me, U16>(me)
        return(r)

/// Converts `me` to `U16`, saturating at `U16.MAX`.
/// :returns: The value, or `U16.MAX` when it is greater.
routine USize.to_clamp<U16>(me: Me) -> U16
    block entry()
        at_most : Me  = umin<Me>(me, 65535)
        r       : U16 = trunc<Me, U16>(at_most)
        return(r)

/// Converts `me` to `U32`. On 64-bit targets.
/// :returns: The same numeric value as a `U32`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U32`.
#[target(size: 64), track_caller]
routine USize.to<U32>(me: Me) -> U32
    block entry()
        fits : Bool = me.le(4294967295)
        branch fits
            ? continue
            : crash_overflow()
        r : U32 = trunc<Me, U32>(me)
        return(r)

/// Converts `me` to `U32`. Every `USize` value fits in `U32`, so the conversion never fails. On 32-bit targets.
/// :returns: The same numeric value as a `U32`.
#target(size: 32)
routine USize.to<U32>(me: Me) -> U32
    block entry()
        r : U32 = bitcast<Me, U32>(me)
        return(r)

/// Converts `me` to `U32` when the value fits. On 64-bit targets.
/// :returns: The value as a `U32`.
/// :absent: When `me` is outside the range of `U32`.
#target(size: 64)
routine USize.to_checked<U32>(me: Me) -> Option<U32>
    block entry()
        fits  : Bool        = me.le(4294967295)
        value : U32         = trunc<Me, U32>(me)
        r     : Option<U32> = fits.then_present(value)
        return(r)

/// Converts `me` to `U32`. Every `USize` value fits in `U32` here, so the result is always present. On 32-bit targets.
/// :returns: The value as a `U32`, wrapped in an `Option`.
#target(size: 32)
routine USize.to_checked<U32>(me: Me) -> Option<U32>
    block entry()
        r : U32 = me.to<U32>()
        return(Option<U32>.Present(r))

/// Converts `me` to `U32`, keeping the low 32 bits (modulo 2^32). On 64-bit targets.
/// :returns: The low bits of `me`, read as a `U32`.
#target(size: 64)
routine USize.to_wrap<U32>(me: Me) -> U32
    block entry()
        r : U32 = trunc<Me, U32>(me)
        return(r)

/// Converts `me` to `U32` like {USize.to<U32>}. No value is lost here, so no wrapping or saturation occurs. On 32-bit targets.
/// :returns: The same numeric value as a `U32`.
#target(size: 32)
routine USize.to_wrap<U32>(me: Me) -> U32
    block entry()
        r : U32 = me.to<U32>()
        return(r)

/// Converts `me` to `U32`, saturating at `U32.MAX`. On 64-bit targets.
/// :returns: The value, or `U32.MAX` when it is greater.
#target(size: 64)
routine USize.to_clamp<U32>(me: Me) -> U32
    block entry()
        at_most : Me  = umin<Me>(me, 4294967295)
        r       : U32 = trunc<Me, U32>(at_most)
        return(r)

/// Converts `me` to `U32` like {USize.to<U32>}. No value is lost here, so no wrapping or saturation occurs. On 32-bit targets.
/// :returns: The same numeric value as a `U32`.
#target(size: 32)
routine USize.to_clamp<U32>(me: Me) -> U32
    block entry()
        r : U32 = me.to<U32>()
        return(r)

/// Converts `me` to `U64`. Every `USize` value fits in `U64`, so the conversion never fails. On 64-bit targets.
/// :returns: The same numeric value as a `U64`.
#target(size: 64)
routine USize.to<U64>(me: Me) -> U64
    block entry()
        r : U64 = bitcast<Me, U64>(me)
        return(r)

/// Converts `me` to `U64`. Every `USize` value fits in `U64`, so the conversion never fails. On 32-bit targets.
/// :returns: The same numeric value as a `U64`.
#target(size: 32)
routine USize.to<U64>(me: Me) -> U64
    block entry()
        r : U64 = zext<Me, U64>(me)
        return(r)

/// Converts `me` to `U128`. Every `USize` value fits in `U128`, so the conversion never fails.
/// :returns: The same numeric value as a `U128`.
routine USize.to<U128>(me: Me) -> U128
    block entry()
        r : U128 = zext<Me, U128>(me)
        return(r)

/// Converts `me` to `U256`. Every `USize` value fits in `U256`, so the conversion never fails.
/// :returns: The same numeric value as a `U256`.
routine USize.to<U256>(me: Me) -> U256
    block entry()
        r : U256 = zext<Me, U256>(me)
        return(r)

/// Converts `me` to `SSize`. On 64-bit targets.
/// :returns: The same numeric value as an `SSize`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `SSize`.
#[target(size: 64), track_caller]
routine USize.to<SSize>(me: Me) -> SSize
    block entry()
        fits : Bool = me.le(9223372036854775807)
        branch fits
            ? continue
            : crash_overflow()
        r : SSize = bitcast<Me, SSize>(me)
        return(r)

/// Converts `me` to `SSize`. On 32-bit targets.
/// :returns: The same numeric value as an `SSize`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `SSize`.
#[target(size: 32), track_caller]
routine USize.to<SSize>(me: Me) -> SSize
    block entry()
        fits : Bool = me.le(2147483647)
        branch fits
            ? continue
            : crash_overflow()
        r : SSize = bitcast<Me, SSize>(me)
        return(r)

/// Converts `me` to `SSize` when the value fits. On 64-bit targets.
/// :returns: The value as an `SSize`.
/// :absent: When `me` is outside the range of `SSize`.
#target(size: 64)
routine USize.to_checked<SSize>(me: Me) -> Option<SSize>
    block entry()
        fits  : Bool          = me.le(9223372036854775807)
        value : SSize         = bitcast<Me, SSize>(me)
        r     : Option<SSize> = fits.then_present(value)
        return(r)

/// Converts `me` to `SSize` when the value fits. On 32-bit targets.
/// :returns: The value as an `SSize`.
/// :absent: When `me` is outside the range of `SSize`.
#target(size: 32)
routine USize.to_checked<SSize>(me: Me) -> Option<SSize>
    block entry()
        fits  : Bool          = me.le(2147483647)
        value : SSize         = bitcast<Me, SSize>(me)
        r     : Option<SSize> = fits.then_present(value)
        return(r)

/// Converts `me` to `SSize`, keeping the low 64 bits (modulo 2^64). On 64-bit targets.
/// :returns: The low bits of `me`, read as an `SSize`.
#target(size: 64)
routine USize.to_wrap<SSize>(me: Me) -> SSize
    block entry()
        r : SSize = bitcast<Me, SSize>(me)
        return(r)

/// Converts `me` to `SSize`, keeping the low 32 bits (modulo 2^32). On 32-bit targets.
/// :returns: The low bits of `me`, read as an `SSize`.
#target(size: 32)
routine USize.to_wrap<SSize>(me: Me) -> SSize
    block entry()
        r : SSize = bitcast<Me, SSize>(me)
        return(r)

/// Converts `me` to `SSize`, saturating at `SSize.MAX`. On 64-bit targets.
/// :returns: The value, or `SSize.MAX` when it is greater.
#target(size: 64)
routine USize.to_clamp<SSize>(me: Me) -> SSize
    block entry()
        at_most : Me    = umin<Me>(me, 9223372036854775807)
        r       : SSize = bitcast<Me, SSize>(at_most)
        return(r)

/// Converts `me` to `SSize`, saturating at `SSize.MAX`. On 32-bit targets.
/// :returns: The value, or `SSize.MAX` when it is greater.
#target(size: 32)
routine USize.to_clamp<SSize>(me: Me) -> SSize
    block entry()
        at_most : Me    = umin<Me>(me, 2147483647)
        r       : SSize = bitcast<Me, SSize>(at_most)
        return(r)

/// Converts `me` to `F32`, rounding to nearest, ties to even.
/// :returns: The `F32` nearest to `me`.
routine USize.to<F32>(me: Me) -> F32
    block entry()
        r : F32 = uitofp<Me, F32>(me)
        return(r)

/// Converts `me` to `F64`, rounding to nearest, ties to even.
/// :returns: The `F64` nearest to `me`.
routine USize.to<F64>(me: Me) -> F64
    block entry()
        r : F64 = uitofp<Me, F64>(me)
        return(r)

// -- conversions into USize ------------------------------------------------------

/// Converts `me` to `USize`.
/// :returns: The same numeric value as a `USize`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `USize`.
#track_caller
routine S8.to<USize>(me: Me) -> USize
    block entry()
        fits : Bool = me.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : USize = sext<Me, USize>(me)
        return(r)

/// Converts `me` to `USize` when the value fits.
/// :returns: The value as a `USize`.
/// :absent: When `me` is outside the range of `USize`.
routine S8.to_checked<USize>(me: Me) -> Option<USize>
    block entry()
        fits  : Bool          = me.ge(0)
        value : USize         = sext<Me, USize>(me)
        r     : Option<USize> = fits.then_present(value)
        return(r)

/// Converts `me` to `USize`, wrapping modulo 2^64: a negative value wraps around to the top of the range. On 64-bit targets.
/// :returns: `me` modulo 2^64, as a `USize`.
#target(size: 64)
routine S8.to_wrap<USize>(me: Me) -> USize
    block entry()
        r : USize = sext<Me, USize>(me)
        return(r)

/// Converts `me` to `USize`, wrapping modulo 2^32: a negative value wraps around to the top of the range. On 32-bit targets.
/// :returns: `me` modulo 2^32, as a `USize`.
#target(size: 32)
routine S8.to_wrap<USize>(me: Me) -> USize
    block entry()
        r : USize = sext<Me, USize>(me)
        return(r)

/// Converts `me` to `USize`, saturating at 0.
/// :returns: The value, or 0 when `me` is negative.
routine S8.to_clamp<USize>(me: Me) -> USize
    block entry()
        at_least : Me    = smax<Me>(me, 0)
        r        : USize = sext<Me, USize>(at_least)
        return(r)

