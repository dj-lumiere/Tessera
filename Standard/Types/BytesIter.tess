// Tessera stdlib: BytesIter
//
// Forward iterator over the raw bytes (U8) of a Bytes.
// emit_checked() returns Unit after the last byte, emit() crashes there.
//
// Satisfies concept Iterator[U8, BytesIter].

module Standard/Core

/// Iterator over the raw bytes (`U8`) of a {Bytes}. It satisfies `Iterator[U8, BytesIter]`, and `emit_checked` yields each byte in order and then reports absent.
record BytesIter
conform Iterator[U8, BytesIter]
    str: Bytes
    index: USize

/// Releases the memory its `str` holds.
routine BytesIter.destruct(me: @Me) -> Void
    me.str.destruct()
    return()

/// Starts an iterator at the first byte of `str`.
/// :param str: The view to iterate. It is not copied, so its bytes must outlive the iterator.
/// :returns: An iterator positioned before the first element.
routine BytesIter.construct(str: Bytes) -> Me
    iter: Me = Me(str: str, index: 0)
    return(iter)

/// Advances the iterator and returns the element it passed.
/// :returns: The next byte.
/// :absent: The end of the view has been reached.
routine BytesIter.emit_checked(me: @Me) -> Maybe[U8]
    local index: USize = me.index.peek()
    local str: Bytes = me.str.peek()

    str_len: USize = str.count
    done: Bool = index.ge(str_len)
    branch done
        ? return_none()
        : return_some()

    block return_none()
        none: Maybe[U8] = Unit()
        return(none)

    block return_some()
        data: @Byte = str.data
        byte: U8 = Byte.to[U8](data.stride(index).peek())
        me.index.poke(index.add(1))
        some: Maybe[U8] = byte
        return(some)

/// Yields the next element and advances the iterator, crashing when there is none.
/// :returns: The next element, in order.
/// :throws: Crashes with `AbsentValueError` after the last element has been yielded.
#track_caller
routine BytesIter.emit(me: @Me) -> U8
    item: Maybe[U8] = me.emit_checked()
    when item
        is U8 as value => return(value)
        is Unit => crash_absent_value()
