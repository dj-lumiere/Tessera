// Tessera stdlib: BytesIter
//
// Forward iterator over the raw bytes (U8) of a Bytes.
// next() returns Option<U8>.Absent after the last byte.
//
// Satisfies concept Iterator<U8, BytesIter>.

module Standard::Core

/// Iterator over the raw bytes (`U8`) of a {Bytes}. It satisfies `Iterator<U8, BytesIter>`, and `next` yields each byte in order and then reports absent.
record BytesIter
conform Iterator<U8, BytesIter>
    str   : Bytes
    index : USize

/// Starts an iterator at the first byte of `str`.
/// :param str: The view to iterate. It is not copied, so its bytes must outlive the iterator.
/// :returns: An iterator positioned before the first element.
routine BytesIter.construct(str: Bytes) -> Self
    block entry()
        iter : Self = Self { str: str, index: 0 }
        return(iter)

/// Advances the iterator and returns the element it passed.
/// :returns: The next byte.
/// :absent: The end of the view has been reached.
routine BytesIter.next(self: @Self) -> Option<U8>
    block entry()
        index   : USize = self.index.load()
        str     : Bytes = self.str.load()
        str_len : USize = str.count
        done    : Bool  = index.ge(str_len)
        branch done
            ? return_none()
            : return_some(index, str)

    block return_none()
        none : Option<U8> = .Absent
        return(none)

    block return_some(index: USize, str: Bytes)
        data : @Byte = str.data
        byte : U8    = Byte.to<U8>(data.stride(index).load())
        self.index.store(index.add(1))
        some : Option<U8> = .Present(byte)
        return(some)
