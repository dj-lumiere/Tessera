// Tessera stdlib: F64 — 64-bit IEEE 754 floating-point
//
// Maps to LLVM IR double.

module Standard::Core

/// A 64-bit IEEE 754 binary64 floating-point number (double precision), mapped to LLVM `double`.
/// It has a 53-bit significand (about 15 to 17 significant decimal digits) and finite magnitudes up to about 1.8e308.
/// :note: Arithmetic rounds to nearest, ties to even. `eq` is IEEE equality, so NaN is unequal to itself and -0.0 equals +0.0.
/// :see: {F32} for half the size, {F128} for more precision.
#llvm("double")
record F64
conform Equal<F64>, Compare<F64>, Hash<F64>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7FF0000000000000`): the result of overflow and of dividing a positive value by +0.0.
preset F64.INFINITY:     F64 = F64.from_bits(0x7FF0000000000000)  // +inf bits
/// Negative infinity (bits `0xFFF0000000000000`).
preset F64.NEG_INFINITY: F64 = F64.from_bits(0xFFF0000000000000)  // -inf bits
/// The canonical quiet NaN (bits `0x7FF8000000000000`).
/// :note: NaN is unequal to everything, itself included, so test for it with {F64.is_nan}, not `eq`.
preset F64.NAN:          F64 = F64.from_bits(0x7FF8000000000000)  // canonical quiet NaN bits

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
routine F64.abs(self: Self) -> Self
    block entry():
        r : Self = fabs<Self>(self)
        return(r)

/// The smaller value; if one operand is NaN, the other one.
routine F64.min(self: Self, other: Self) -> Self
    block entry():
        self_nan  : Bool = self.is_nan()
        other_nan : Bool = other.is_nan()
        both      : Bool = self_nan.bitand(other_nan)
        when:
            both      -> return(self.add(other))
            self_nan  -> return(other)
            other_nan -> return(self)
            else      -> compare()

    // no minnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare():
        pick : Bool = self.le(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// The larger value; if one operand is NaN, the other one.
routine F64.max(self: Self, other: Self) -> Self
    block entry():
        self_nan  : Bool = self.is_nan()
        other_nan : Bool = other.is_nan()
        both      : Bool = self_nan.bitand(other_nan)
        when:
            both      -> return(self.add(other))
            self_nan  -> return(other)
            other_nan -> return(self)
            else      -> compare()

    // no maxnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare():
        pick : Bool = self.ge(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// Adds `other` to `self`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `self + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine F64.add(self: Self, other: Self) -> Self
    block entry():
        r : Self = fadd<Self>(self, other)
        return(r)

/// Subtracts `other` from `self`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `self - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine F64.sub(self: Self, other: Self) -> Self
    block entry():
        r : Self = fsub<Self>(self, other)
        return(r)

/// Multiplies `self` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `self * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine F64.mul(self: Self, other: Self) -> Self
    block entry():
        r : Self = fmul<Self>(self, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `self` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self < other`; false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.lt(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = flt<Self>(self, other)
        return(r)

/// Whether `self` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self <= other`; false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.le(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = fle<Self>(self, other)
        return(r)

/// Whether `self` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self > other`; false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.gt(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = fgt<Self>(self, other)
        return(r)

/// Whether `self` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `self >= other`; false when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.ge(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = fge<Self>(self, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `self` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `self / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine F64.div(self: Self, other: Self) -> Self
    block entry():
        r : Self = fdiv<Self>(self, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine F64.eq(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = feq<Self>(self, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ; false for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {F64.eq}.
routine F64.ne(self: Self, other: Self) -> Bool
    block entry():
        r : Bool = fne<Self>(self, other)
        return(r)

/// Three-way comparison for the `Compare` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `self < other`, 1 when `self > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {F64.total_compare} for a total order that ranks NaN and the signed zeros.
routine F64.compare(self: Self, other: Self) -> S32
    block entry():
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with `xxh64_hash_u64` (seed 0), for the `Hash` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine F64.hash(self: Self) -> U64
    block entry():
        bits : U64 = self.bits()
        h    : U64 = xxh64_hash_u64(bits, 0)
        return(h)

// -- generic conversions -------------------------------------------------------

/// Narrows to a smaller float type with LLVM `fptrunc`, rounding to nearest (ties to even).
/// :typeparam To: The narrower float type.
/// :returns: The rounded value: infinity when it overflows `To`, a subnormal or zero when it underflows, NaN for NaN.
routine F64.fptrunc<To>(self: Self) -> To
require To: typename
    block entry():
        r : To = fptrunc<Self, To>(self)
        return(r)

/// Converts to a signed integer type with LLVM `fptosi`, rounding toward zero.
/// :typeparam To: The signed integer type.
/// :returns: The integer part of `self`.
/// :note: NaN or a value out of the range of `To` gives poison; the checked `to<S..>`, `to_checked<S..>` and `to_clamp<S..>` conversions avoid it.
routine F64.fptosi<To>(self: Self) -> To
require To: typename
    block entry():
        r : To = fptosi<Self, To>(self)
        return(r)

// -- named narrowing conversion ------------------------------------------------

/// Narrows to F32, rounding to nearest (ties to even).
/// :returns: The nearest F32: infinity beyond F32's range, a subnormal or zero for tiny values, NaN for NaN.
routine F64.to<F32>(self: Self) -> F32
    block entry():
        result : F32 = fptrunc<Self, F32>(self)
        return(result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite F64, about 1.7976931348623157e308 (bits `0x7FEFFFFFFFFFFFFF`).
preset F64.MAX:          F64 = F64.from_bits(0x7FEFFFFFFFFFFFFF)  // largest finite value
/// The most negative finite F64, the negation of `F64.MAX` (bits `0xFFEFFFFFFFFFFFFF`).
preset F64.MIN:          F64 = F64.from_bits(0xFFEFFFFFFFFFFFFF)  // most negative finite value
/// The smallest positive normal F64, 2^-1022, about 2.2250738585072014e-308 (bits `0x0010000000000000`). Subnormal values go below it.
preset F64.MIN_POSITIVE: F64 = F64.from_bits(0x0010000000000000)  // smallest positive normal value

/// The gap between 1.0 and the next larger F64, 2^-52, about 2.220446049250313e-16 (bits `0x3CB0000000000000`).
preset F64.EPSILON:      F64 = F64.from_bits(0x3CB0000000000000)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest F64.
preset F64.PI: F64 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest F64.
preset F64.TAU: F64 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest F64.
preset F64.E: F64 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest F64.
preset F64.FRAC_PI_2: F64 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest F64.
preset F64.FRAC_PI_4: F64 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest F64.
preset F64.FRAC_1_PI: F64 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest F64.
preset F64.SQRT_2: F64 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest F64.
preset F64.FRAC_1_SQRT_2: F64 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest F64.
preset F64.LN_2: F64 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest F64.
preset F64.LN_10: F64 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest F64.
preset F64.LOG2_E: F64 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest F64.
preset F64.LOG10_E: F64 = 0.434294481903251827651128918916605082  // log10(e)

// -- C math library -----------------------------------------------------------

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-self`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine F64.neg(self: Self) -> Self
    block entry():
        r : Self = fneg<Self>(self)
        return(r)

/// The magnitude of self with the sign of sign.
routine F64.copysign(self: Self, sign: Self) -> Self
    block entry():
        r : Self = copysign<Self>(self, sign)
        return(r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
routine F64.signum(self: Self) -> Self
    block entry():
        nan  : Bool = self.is_nan()
        unit : Self = copysign<Self>(1.0, self)
        r    : Self = nan
            ? self
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
routine F64.is_sign_positive(self: Self) -> Bool
    block entry():
        bits : S64  = self.bits().to_wrap<S64>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine F64.is_sign_negative(self: Self) -> Bool
    block entry():
        bits : S64  = self.bits().to_wrap<S64>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of self / other, with the sign of self (C fmod; Rust's %). Exact.
///
/// A long division on the significands, one quotient bit per step (up to 2098), since LLVM lowers frem to
/// libm's fmod on every target.
routine F64.mod(self: Self, other: Self) -> Self
    block entry():
        nan     : Bool = self.is_nan().bitor(other.is_nan())
        invalid : Bool = self.is_infinite().bitor(other.eq(0.0))
        keep    : Bool = other.is_infinite().bitor(self.eq(0.0))
        when:
            nan     -> return(self.add(other))
            invalid -> return(Self.NAN)
            keep    -> return(self)
            else    -> finite()

    block finite():
        a        : F64Parts = f64_unpack(self)
        b        : F64Parts = f64_unpack(other)
        same_exp : Bool     = a.exponent.eq(b.exponent)
        smaller  : Bool     = a.exponent.lt(b.exponent).bitor(same_exp.bitand(a.sig.lt(b.sig)))
        branch smaller
            ? return(self)
            : divide(a.sig, b.sig, a.exponent.sub(b.exponent), b.exponent)

    // x < 2 mb throughout, as both significands are normalized
    block divide(x: U64, mb: U64, steps: S64, eb: S64):
        done : Bool = steps.eq(0)
        branch done
            ? last(x, mb, eb)
            : step(x, mb, steps, eb)

    block step(x: U64, mb: U64, steps: S64, eb: S64):
        fits  : Bool = x.ge(mb)
        taken : U64  = fits
            ? mb
            : 0
        left : U64 = x.sub(taken)
        jump divide(left.shl(1), mb, steps.sub(1), eb)

    // the remainder is rest × 2^(eb - 1075), which F64 holds exactly
    block last(x: U64, mb: U64, eb: S64):
        fits  : Bool = x.ge(mb)
        taken : U64  = fits
            ? mb
            : 0
        rest : U64  = x.sub(taken)
        zero : Bool = rest.eq(0)
        branch zero
            ? return(Self.copysign(0.0, self))
            : continue
        lz        : U64  = rest.leading_zeros()
        magnitude : Self = f64_round_pack(false, eb.sub(lz.to<S64>()).add(11), rest.shl(lz))
        r         : Self = magnitude.copysign(self)
        return(r)

/// The reciprocal `1 / self`, rounded once.
/// :returns: `1 / self`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine F64.recip(self: Self) -> Self
    block entry():
        r : Self = fdiv<Self>(1.0, self)
        return(r)

/// self * a + b with a single rounding: the FMA instruction where the CPU has one (every AArch64, x86 with the
/// fma feature, as in --cpu x86-64-v3), mul_add_soft elsewhere.
#target(arch: "aarch64")
routine F64.mul_add(self: Self, a: Self, b: Self) -> Self
    block entry():
        r : Self = fma<Self>(self, a, b)
        return(r)

/// Fused multiply-add: `self * a + b` with a single rounding, computed with the x86 FMA instruction (targets with the `fma` feature, as with `--cpu x86-64-v3`).
/// :param a: The factor `self` is multiplied by.
/// :param b: The addend.
/// :returns: `self * a + b` rounded once to nearest (ties to even); NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: "x86_64"), feature("fma")]
routine F64.mul_add(self: Self, a: Self, b: Self) -> Self
    block entry():
        r : Self = fma<Self>(self, a, b)
        return(r)

/// Fused multiply-add: `self * a + b` with a single rounding, computed in software ({F64.mul_add_soft}) on x86 without the `fma` feature.
/// :param a: The factor `self` is multiplied by.
/// :param b: The addend.
/// :returns: `self * a + b` rounded once to nearest (ties to even); NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: "x86_64"), feature(not "fma")]
routine F64.mul_add(self: Self, a: Self, b: Self) -> Self
    block entry():
        r : Self = self.mul_add_soft(a, b)
        return(r)

/// Fused multiply-add: `self * a + b` with a single rounding, computed in software ({F64.mul_add_soft}) on targets other than AArch64 and x86_64.
/// :param a: The factor `self` is multiplied by.
/// :param b: The addend.
/// :returns: `self * a + b` rounded once to nearest (ties to even); NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#target(arch: not "aarch64", arch: not "x86_64")
routine F64.mul_add(self: Self, a: Self, b: Self) -> Self
    block entry():
        r : Self = self.mul_add_soft(a, b)
        return(r)

/// self * a + b with a single rounding, without an FMA instruction.
///
/// Without one LLVM calls libm's fma, so this forms the 106-bit product exactly in a U128,
/// aligns b to it (bits shifted out past the product become a sticky bit), and rounds only the sum.
private routine F64.mul_add_soft(self: Self, a: Self, b: Self) -> Self
    block entry():
        factors_finite : Bool = self.is_finite().bitand(a.is_finite())
        factor_special : Bool = factors_finite.bitnot()
        addend_special : Bool = b.is_finite().bitnot()
        zero_product   : Bool = self.eq(0.0).bitor(a.eq(0.0))
        zero_addend    : Bool = b.eq(0.0)
        when:
            // an infinite or NaN factor makes the product exact; so does a zero one
            factor_special -> return(self.mul(a).add(b))
            addend_special -> return(b.add(b))
            zero_product   -> return(self.mul(a).add(b))
            // a nonzero product plus zero is the product, whatever the zero's sign
            zero_addend -> return(self.mul(a))
            else        -> finite()

    // P = mx my × 2^(ex + ey - 2170) and C = mc × 2^(ec - 1148), each below 2^126 with its top bit at 124
    // or 125, leaving room for a carry
    block finite():
        px      : F64Parts = f64_unpack(self)
        py      : F64Parts = f64_unpack(a)
        pc      : F64Parts = f64_unpack(b)
        p       : U128     = px.sig.mul_wide(py.sig).shl(20)
        p_e     : S64      = px.exponent.add(py.exponent).sub(2170)
        cc      : U128     = pc.sig.to<U128>().shl(73)
        c_e     : S64      = pc.exponent.sub(1148)
        p_neg   : Bool     = self.is_sign_negative().ne(a.is_sign_negative())
        c_neg   : Bool     = b.is_sign_negative()
        p_first : Bool     = p_e.ge(c_e)
        big     : U128     = p_first
            ? p
            : cc
        small : U128 = p_first
            ? cc
            : p
        e : S64 = p_first
            ? p_e
            : c_e
        diff : S64 = p_first
            ? p_e.sub(c_e)
            : c_e.sub(p_e)
        big_neg : Bool = p_first
            ? p_neg
            : c_neg
        small_neg : Bool = p_first
            ? c_neg
            : p_neg
        aligned : U128 = f64_shr_sticky128(small, diff)
        same    : Bool = big_neg.eq(small_neg)
        branch same
            ? sum(big, aligned, e, big_neg)
            : difference(big, aligned, e, big_neg)

    block sum(x: U128, y: U128, e: S64, negative: Bool):
        total : U128 = x.add(y)
        jump round(total, e, negative)

    // an exact zero is +0
    block difference(x: U128, y: U128, e: S64, x_negative: Bool):
        x_larger : Bool = x.ge(y)
        m        : U128 = x.abs_diff(y)
        negative : Bool = x_larger
            ? x_negative
            : x_negative.bitnot()
        jump round(m, e, negative)

    // value = r × 2^e: bring the top bit to 127 and round the high half, with a sticky bit for the low one
    block round(r: U128, e: S64, negative: Bool):
        zero : Bool = r.eq(0)
        branch zero
            ? return(0.0)
            : continue
        lz         : U128 = r.leading_zeros()
        n          : U128 = r.shl(lz)
        high       : U64  = n.shr(64).to<U64>()
        low_sticky : Bool = n.to_wrap<U64>().ne(0)
        sig        : U64  = high.bitor(low_sticky.to<U64>())
        exponent   : S64  = e.sub(lz.to<S64>()).add(1150)
        result     : Self = f64_round_pack(negative, exponent, sig)
        return(result)

/// The quotient q of Euclidean division, so that self = q * other + r with 0 <= r < |other|.
routine F64.div_euclid(self: Self, other: Self) -> Self
    block entry():
        q            : Self = self.div(other).trunc()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Self = q.sub(1.0)
        up               : Self = q.add(1.0)
        r                : Self = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of self / other.
routine F64.mod_euclid(self: Self, other: Self) -> Self
    block entry():
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Self = other.abs()
        r         : Self = rem.add(magnitude)
        return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
routine F64.minimum(self: Self, other: Self) -> Self
    block entry():
        nan : Bool = self.is_nan().bitor(other.is_nan())
        branch nan
            ? return(self.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = self.eq(other)
        branch equal
            ? return(Self.from_bits(self.bits().bitor(other.bits())))
            : continue
        pick : Bool = self.lt(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
routine F64.maximum(self: Self, other: Self) -> Self
    block entry():
        nan : Bool = self.is_nan().bitor(other.is_nan())
        branch nan
            ? return(self.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = self.eq(other)
        branch equal
            ? return(Self.from_bits(self.bits().bitand(other.bits())))
            : continue
        pick : Bool = self.gt(other)
        r    : Self = pick
            ? self
            : other
        return(r)

/// Restricts self to lo ..= hi; NaN stays NaN. Traps unless lo <= hi.
#track_caller
routine F64.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry():
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : panic(TrapCode.InvalidArgument)

    block clamp():
        below : Bool = self.lt(lo)
        above : Bool = self.gt(hi)
        upper : Self = above
            ? hi
            : self
        r : Self = below
            ? lo
            : upper
        return(r)

/// self in [lo, hi], both ends included. False when lo > hi.
routine F64.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry():
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine F64.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry():
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
routine F64.total_compare(self: Self, other: Self) -> S32
    block entry():
        a : S64 = self.bits().to_wrap<S64>()
        b : S64 = other.bits().to_wrap<S64>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S64 = a.bitxor(a.shr(63).bitand(S64.MAX))
        b_key : S64 = b.bitxor(b.shr(63).bitand(S64.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

// AArch64 has an instruction for each; elsewhere LLVM calls libm (x86 before SSE4.1 has none), so the other
// targets work on the bits: trunc clears the fraction bits, and the rest adjust its result, all exactly.

/// Rounds toward negative infinity with the AArch64 rounding instruction.
/// :returns: The largest integer value not above `self`; zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.floor(self: Self) -> Self
    block entry():
        r : Self = floor<Self>(self)
        return(r)

/// Rounds toward negative infinity from {F64.trunc}, stepping one down when truncation moved the value up (exact).
/// :returns: The largest integer value not above `self`; zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.floor(self: Self) -> Self
    block entry():
        t    : Self = self.trunc()
        down : Bool = t.gt(self)
        r    : Self = down
            ? t.sub(1.0)
            : t
        return(r)

/// Rounds toward positive infinity with the AArch64 rounding instruction.
/// :returns: The smallest integer value not below `self` (-0.5 gives -0.0); zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.ceil(self: Self) -> Self
    block entry():
        r : Self = ceil<Self>(self)
        return(r)

/// Rounds toward positive infinity from {F64.trunc}, stepping one up when truncation moved the value down (exact).
/// :returns: The smallest integer value not below `self` (-0.5 gives -0.0); zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.ceil(self: Self) -> Self
    block entry():
        t  : Self = self.trunc()
        up : Bool = t.lt(self)
        r  : Self = up
            ? t.add(1.0)
            : t
        return(r)

/// Rounds half-way cases away from zero.
#target(arch: "aarch64")
routine F64.round(self: Self) -> Self
    block entry():
        r : Self = round<Self>(self)
        return(r)

/// Rounds half-way cases away from zero.
#target(arch: not "aarch64")
routine F64.round(self: Self) -> Self
    block entry():
        t        : Self = self.trunc()
        fraction : Self = self.sub(t)
        half     : Bool = fraction.abs().ge(0.5)
        away     : Self = t.add(Self.copysign(1.0, self))
        r        : Self = half
            ? away
            : t
        return(r)

/// Rounds half-way cases to the even neighbor.
#target(arch: "aarch64")
routine F64.round_ties_even(self: Self) -> Self
    block entry():
        r : Self = rint<Self>(self)
        return(r)

/// Rounds half-way cases to the even neighbor.
///
/// Below 2^52, adding and subtracting 2^52 leaves the magnitude rounded to an integer by the addition.
#target(arch: not "aarch64")
routine F64.round_ties_even(self: Self) -> Self
    block entry():
        magnitude : Self = self.abs()
        integral  : Bool = magnitude.ge(4503599627370496.0)
        branch integral
            ? return(self)
            : continue
        rounded : Self = magnitude.add(4503599627370496.0).sub(4503599627370496.0)
        r       : Self = rounded.copysign(self)
        return(r)

/// Rounds toward zero.
#target(arch: "aarch64")
routine F64.trunc(self: Self) -> Self
    block entry():
        r : Self = ftrunc<Self>(self)
        return(r)

/// Rounds toward zero.
#target(arch: not "aarch64")
routine F64.trunc(self: Self) -> Self
    block entry():
        bits      : U64  = self.bits()
        field     : U64  = bits.shr(52).bitand(0x7FF)
        special   : Bool = field.eq(0x7FF)
        integral  : Bool = field.ge(1075)
        below_one : Bool = field.lt(1023)
        when:
            special   -> return(self.add(self))
            integral  -> return(self)
            below_one -> return(Self.from_bits(bits.bitand(0x8000000000000000)))
            else      -> fraction(bits, field)

    // 1 <= |self| < 2^52: the lowest 1075 - field bits are the fraction
    block fraction(bits: U64, field: U64):
        mask : U64  = 1.shl(U64.sub(1075, field)).sub(1)
        r    : Self = Self.from_bits(bits.bitand(mask.bitnot()))
        return(r)

/// self minus its integer part, with the sign of self.
routine F64.fract(self: Self) -> Self
    block entry():
        whole : Self = self.trunc()
        r     : Self = self.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in Standard/F64Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// NaN for negative values (other than -0.0).
routine F64.sqrt(self: Self) -> Self
    block entry():
        r : Self = sqrt<Self>(self)
        return(r)

/// self raised to an integer power, correctly rounded: powf with n converted, which is exact.
routine F64.powi(self: Self, n: S32) -> Self
    block entry():
        r : Self = self.powf(n.to<Self>())
        return(r)

/// The logarithm with an arbitrary base.
routine F64.log(self: Self, base: Self) -> Self
    block entry():
        num : Self = self.ln()
        den : Self = base.ln()
        r   : Self = num.div(den)
        return(r)

// -- special functions ---------------------------------------------------------

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to F64).
/// :returns: `self` in degrees, rounded once.
routine F64.to_degrees(self: Self) -> Self
    block entry():
        r : Self = self.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to F64).
/// :returns: `self` in radians, rounded once.
routine F64.to_radians(self: Self) -> Self
    block entry():
        r : Self = self.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- classification ------------------------------------------------------------

/// Whether `self` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine F64.is_nan(self: Self) -> Bool
    block entry():
        r : Bool = funo<Self>(self, self)
        return(r)

/// Whether `self` is +inf or -inf.
/// :returns: True for either infinity; false for NaN and finite values.
routine F64.is_infinite(self: Self) -> Bool
    block entry():
        magnitude : Self = fabs<Self>(self)
        r         : Bool = magnitude.eq(Self.INFINITY)
        return(r)

/// Neither infinite nor NaN.
routine F64.is_finite(self: Self) -> Bool
    block entry():
        magnitude : Self = fabs<Self>(self)
        r         : Bool = magnitude.lt(Self.INFINITY)
        return(r)

/// Not zero, subnormal, infinite, or NaN.
routine F64.is_normal(self: Self) -> Bool
    block entry():
        exponent : U64  = self.bits().bitand(0x7FF0000000000000)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7FF0000000000000))
        return(r)

/// Whether `self` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `F64.MIN_POSITIVE`.
/// :returns: True for subnormals; false for zero, normal values, infinities and NaN.
routine F64.is_subnormal(self: Self) -> Bool
    block entry():
        bits     : U64  = self.bits()
        exponent : U64  = bits.bitand(0x7FF0000000000000)
        mantissa : U64  = bits.bitand(0x000FFFFFFFFFFFFF)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// A finite nonzero F64 as sig × 2^(exponent - 1075), with sig normalized to [2^52, 2^53), subnormals too.
record F64Parts
    sig      : U64
    exponent : S64

/// The raw IEEE 754 bits.
routine F64.bits(self: Self) -> U64
    block entry():
        r : U64 = bitcast<Self, U64>(self)
        return(r)

/// Reinterprets raw IEEE 754 binary64 bits as a F64, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding; NaN payloads are kept.
/// :see: {F64.bits} for the inverse.
routine F64.from_bits(bits: U64) -> Self
    block entry():
        r : Self = bitcast<U64, Self>(bits)
        return(r)

/// Splits a finite, nonzero F64 into a normalized significand and biased exponent, so that `x = sig * 2^(exponent - 1075)`.
/// :param x: A finite, nonzero F64; zeros, infinities and NaN are not handled.
/// :returns: {F64Parts} with `sig` in [2^52, 2^53); a subnormal is normalized, so its exponent drops to 0 or below.
routine f64_unpack(x: F64) -> F64Parts
    block entry():
        bits     : U64  = x.bits()
        field    : U64  = bits.shr(52).bitand(0x7FF)
        fraction : U64  = bits.bitand(0x000FFFFFFFFFFFFF)
        normal   : Bool = field.ne(0)
        branch normal
            ? normal(field, fraction)
            : subnormal(fraction)

    block normal(field: U64, fraction: U64):
        sig   : U64      = fraction.bitor(0x0010000000000000)
        parts : F64Parts = F64Parts { sig: sig, exponent: field.to<S64>() }
        return(parts)

    block subnormal(fraction: U64):
        shift : U64      = fraction.leading_zeros().sub(11)
        sig   : U64      = fraction.shl(shift)
        parts : F64Parts = F64Parts { sig: sig, exponent: S64.sub(1, shift.to<S64>()) }
        return(parts)

/// x >> n with everything shifted out ORed into bit 0.
routine f64_shr_sticky128(x: U128, n: S64) -> U128
    block entry():
        all : Bool = n.ge(128)
        branch all
            ? all()
            : some()

    block all():
        nonzero : U64  = x.ne(0).to<U64>()
        any     : U128 = nonzero.to<U128>()
        return(any)

    block some():
        shift : U128 = n.to<U128>()
        mask  : U128 = 1.shl(shift).sub(1)
        lost  : Bool = x.bitand(mask).ne(0)
        r     : U128 = x.shr(shift).bitor(lost.to<U64>().to<U128>())
        return(r)

/// sig × 2^(exponent - 1086) rounded to nearest, ties to even, where sig has its top bit (63) set and exponent
/// is the biased exponent the result has if it's normal. Rounds into the subnormals below 1 and overflows to
/// infinity at 0x7FF.
routine f64_round_pack(negative: Bool, exponent: S64, sig: U64) -> F64
    block entry():
        sign : U64 = negative
            ? 0x8000000000000000
            : 0
        overflow : Bool = exponent.ge(0x7FF)
        tiny     : Bool = exponent.lt(1)
        when:
            overflow -> return(F64.from_bits(sign.bitor(0x7FF0000000000000)))
            tiny     -> subnormal(sign, exponent, sig)
            else     -> round(sign, exponent, sig)

    // shift to the scale of exponent 1, which encodes as the subnormal field 0
    block subnormal(sign: U64, exponent: S64, sig: U64):
        shift : S64  = S64.sub(1, exponent)
        all   : Bool = shift.ge(64)
        some  : U64  = sig.shr(shift.min(63).to<U64>())
        lost  : Bool = all
            ? sig.ne(0)
            : sig.ne(some.shl(shift.min(63).to<U64>()))
        shifted : U64 = all
            ? 0
            : some
        jump round(sign, 1, shifted.bitor(lost.to<U64>()))

    // a carry out of the 53 kept bits bumps the exponent, up to infinity
    block round(sign: U64, exponent: S64, sig: U64):
        kept            : U64  = sig.shr(11)
        rest            : U64  = sig.bitand(0x7FF)
        odd             : Bool = kept.bitand(1).eq(1)
        up              : Bool = rest.gt(0x400).bitor(rest.eq(0x400).bitand(odd))
        rounded         : U64  = kept.add(up.to<U64>())
        biased_exponent : U64  = exponent.sub(1).to<U64>()
        magnitude       : U64  = biased_exponent.shl(52).add(rounded)
        r               : F64  = F64.from_bits(sign.bitor(magnitude))
        return(r)

// -- float conversions -----------------------------------------------------------

/// a + b rounded to odd: truncated toward zero, with the lowest bit set when the sum is inexact. A narrower
/// format with at most 51 bits rounds it to nearest exactly as it would the true sum, so F16's and BF16's
/// mul_add add their exact F64 product this way and narrow once. Finite inputs; an infinite or NaN sum is
/// returned as the addition gives it.
routine f64_add_round_to_odd(a: F64, b: F64) -> F64
    block entry():
        s      : F64  = a.add(b)
        finite : Bool = s.is_finite()
        branch finite
            ? error(s)
            : return(s)

    // TwoSum: e is exactly (a + b) - s.
    block error(s: F64):
        bv      : F64  = s.sub(a)
        av      : F64  = s.sub(bv)
        e       : F64  = a.sub(av).add(b.sub(bv))
        inexact : Bool = e.ne(0.0)
        low_bit : U64  = s.bits().bitand(1)
        even    : Bool = low_bit.eq(0)
        bump    : Bool = inexact.bitand(even)
        branch bump
            ? toward(s, e)
            : return(s)

    // s rounded to an even neighbour: the odd one is the other neighbour of the true sum, one ulp toward e.
    block toward(s: F64, e: F64):
        outward : Bool = e.is_sign_negative().eq(s.is_sign_negative())
        bits    : U64  = s.bits()
        odd     : U64  = outward
            ? bits.add_wrap(1)
            : bits.sub_wrap(1)
        return(F64.from_bits(odd))

/// Narrows to F32 with round-to-odd, then rounds that to F16; F32's 24 bits are
/// enough (2 * 11 + 2) for the second rounding to be exact.
routine F64.to<F16>(self: Self) -> F16
    block entry():
        narrow  : F32  = fptrunc<Self, F32>(self)
        back    : Self = narrow.to<Self>()
        inexact : Bool = back.ne(self)
        finite  : Bool = narrow.is_finite()
        sticky  : Bool = inexact.bitand(finite)
        // Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
        away  : Bool = sticky.bitand(back.abs().gt(self.abs()))
        trunc : U32  = narrow.bits().sub(away.to<U32>())
        bits  : U32  = trunc.bitor(sticky.to<U32>())
        odd   : F32  = .from_bits(bits)
        r     : F16  = odd.to<F16>()
        return(r)

/// Narrows to F32 with round-to-odd (an inexact result gets its lowest bit set),
/// then rounds that to BF16. Round-to-odd keeps the second rounding from
/// double-rounding, because F32 has more than twice BF16's precision.
routine F64.to<BF16>(self: Self) -> BF16
    block entry():
        narrow  : F32  = fptrunc<Self, F32>(self)
        back    : Self = narrow.to<Self>()
        inexact : Bool = back.ne(self)
        finite  : Bool = narrow.is_finite()
        sticky  : Bool = inexact.bitand(finite)
        // Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
        away  : Bool = sticky.bitand(back.abs().gt(self.abs()))
        trunc : U32  = narrow.bits().sub(away.to<U32>())
        bits  : U32  = trunc.bitor(sticky.to<U32>())
        odd   : F32  = .from_bits(bits)
        r     : BF16 = odd.to<BF16>()
        return(r)

/// The identity conversion, so generic code can call `to<T>()` when `T` is F64.
/// :returns: `self` unchanged.
routine F64.to<Self>(self: Self) -> Self
    block entry():
        return(self)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and panics on NaN or a value out of the integer's
// range; to_<int>_checked returns None instead, and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Panics with `TrapCode.Overflow` when `self` is NaN or its integer part lies outside [-128, 127]; the panic reports the caller's location.
/// :see: {F64.to_checked<S8>} to get an absent value instead, {F64.to_clamp<S8>} to saturate.
#track_caller
routine F64.to<S8>(self: Self) -> S8
    block entry():
        fits : Bool = self.fits_int(-128.0, 128.0)
        branch fits
            ? continue
            : panic(TrapCode.Overflow)
        r : S8 = fptosi_sat<Self, S8>(self)
        return(r)

/// Converts to S8, rounding toward zero, without panicking.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-128, 127].
/// :see: {F64.to<S8>} to panic instead, {F64.to_clamp<S8>} to saturate.
routine F64.to_checked<S8>(self: Self) -> Option<S8>
    block entry():
        fits  : Bool       = self.fits_int(-128.0, 128.0)
        value : S8         = fptosi_sat<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-128, 127]; infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<S8>} to detect values that do not fit.
routine F64.to_clamp<S8>(self: Self) -> S8
    block entry():
        r : S8 = fptosi_sat<Self, S8>(self)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Panics with `TrapCode.Overflow` when `self` is NaN or its integer part lies outside [-32768, 32767]; the panic reports the caller's location.
/// :see: {F64.to_checked<S16>} to get an absent value instead, {F64.to_clamp<S16>} to saturate.
#track_caller
routine F64.to<S16>(self: Self) -> S16
    block entry():
        fits : Bool = self.fits_int(-32768.0, 32768.0)
        branch fits
            ? continue
            : panic(TrapCode.Overflow)
        r : S16 = fptosi_sat<Self, S16>(self)
        return(r)

/// Converts to S16, rounding toward zero, without panicking.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-32768, 32767].
/// :see: {F64.to<S16>} to panic instead, {F64.to_clamp<S16>} to saturate.
routine F64.to_checked<S16>(self: Self) -> Option<S16>
    block entry():
        fits  : Bool        = self.fits_int(-32768.0, 32768.0)
        value : S16         = fptosi_sat<Self, S16>(self)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts to S16, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-32768, 32767]; infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<S16>} to detect values that do not fit.
routine F64.to_clamp<S16>(self: Self) -> S16
    block entry():
        r : S16 = fptosi_sat<Self, S16>(self)
        return(r)

/// Converts to S32, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Panics with `TrapCode.Overflow` when `self` is NaN or its integer part lies outside [-2^31, 2^31 - 1]; the panic reports the caller's location.
/// :see: {F64.to_checked<S32>} to get an absent value instead, {F64.to_clamp<S32>} to saturate.
#track_caller
routine F64.to<S32>(self: Self) -> S32
    block entry():
        fits : Bool = self.fits_int(-2147483648.0, 2147483648.0)
        branch fits
            ? continue
            : panic(TrapCode.Overflow)
        r : S32 = fptosi_sat<Self, S32>(self)
        return(r)

/// Converts to S32, rounding toward zero, without panicking.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-2^31, 2^31 - 1].
/// :see: {F64.to<S32>} to panic instead, {F64.to_clamp<S32>} to saturate.
routine F64.to_checked<S32>(self: Self) -> Option<S32>
    block entry():
        fits  : Bool        = self.fits_int(-2147483648.0, 2147483648.0)
        value : S32         = fptosi_sat<Self, S32>(self)
        r     : Option<S32> = fits.then_present(value)
        return(r)

/// Converts to S32, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-2^31, 2^31 - 1]; infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<S32>} to detect values that do not fit.
routine F64.to_clamp<S32>(self: Self) -> S32
    block entry():
        r : S32 = fptosi_sat<Self, S32>(self)
        return(r)

/// Converts to S64, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Panics with `TrapCode.Overflow` when `self` is NaN or its integer part lies outside [-2^63, 2^63 - 1]; the panic reports the caller's location.
/// :see: {F64.to_checked<S64>} to get an absent value instead, {F64.to_clamp<S64>} to saturate.
#track_caller
routine F64.to<S64>(self: Self) -> S64
    block entry():
        fits : Bool = self.fits_int(-9223372036854775808.0, 9223372036854775808.0)
        branch fits
            ? continue
            : panic(TrapCode.Overflow)
        r : S64 = fptosi_sat<Self, S64>(self)
        return(r)

/// Converts to S64, rounding toward zero, without panicking.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-2^63, 2^63 - 1].
/// :see: {F64.to<S64>} to panic instead, {F64.to_clamp<S64>} to saturate.
routine F64.to_checked<S64>(self: Self) -> Option<S64>
    block entry():
        fits  : Bool        = self.fits_int(-9223372036854775808.0, 9223372036854775808.0)
        value : S64         = fptosi_sat<Self, S64>(self)
        r     : Option<S64> = fits.then_present(value)
        return(r)

/// Converts to S64, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-2^63, 2^63 - 1]; infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<S64>} to detect values that do not fit.
routine F64.to_clamp<S64>(self: Self) -> S64
    block entry():
        r : S64 = fptosi_sat<Self, S64>(self)
        return(r)

/// Converts to S128, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Panics with `TrapCode.Overflow` when `self` is NaN or its integer part lies outside [-2^127, 2^127 - 1]; the panic reports the caller's location.
/// :see: {F64.to_checked<S128>} to get an absent value instead, {F64.to_clamp<S128>} to saturate.
#track_caller
routine F64.to<S128>(self: Self) -> S128
    block entry():
        fits : Bool = self.fits_int(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        branch fits
            ? continue
            : panic(TrapCode.Overflow)
        r : S128 = fptosi_sat<Self, S128>(self)
        return(r)

/// Converts to S128, rounding toward zero, without panicking.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [-2^127, 2^127 - 1].
/// :see: {F64.to<S128>} to panic instead, {F64.to_clamp<S128>} to saturate.
routine F64.to_checked<S128>(self: Self) -> Option<S128>
    block entry():
        fits  : Bool         = self.fits_int(-170141183460469231731687303715884105728.0,
            170141183460469231731687303715884105728.0)
        value : S128         = fptosi_sat<Self, S128>(self)
        r     : Option<S128> = fits.then_present(value)
        return(r)

/// Converts to S128, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [-2^127, 2^127 - 1]; infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<S128>} to detect values that do not fit.
routine F64.to_clamp<S128>(self: Self) -> S128
    block entry():
        r : S128 = fptosi_sat<Self, S128>(self)
        return(r)

/// Converts to U8, rounding toward zero.
/// :returns: The integer part of `self`.
/// :throws: Panics with `TrapCode.Overflow` when `self` is NaN or its integer part lies outside [0, 255]; the panic reports the caller's location.
/// :see: {F64.to_checked<U8>} to get an absent value instead, {F64.to_clamp<U8>} to saturate.
#track_caller
routine F64.to<U8>(self: Self) -> U8
    block entry():
        fits : Bool = self.fits_int(0.0, 256.0)
        branch fits
            ? continue
            : panic(TrapCode.Overflow)
        r : U8 = fptoui_sat<Self, U8>(self)
        return(r)

/// Converts to U8, rounding toward zero, without panicking.
/// :returns: The integer part of `self` when it fits.
/// :absent: When `self` is NaN or its integer part lies outside [0, 255].
/// :see: {F64.to<U8>} to panic instead, {F64.to_clamp<U8>} to saturate.
routine F64.to_checked<U8>(self: Self) -> Option<U8>
    block entry():
        fits  : Bool       = self.fits_int(0.0, 256.0)
        value : U8         = fptoui_sat<Self, U8>(self)
        r     : Option<U8> = fits.then_present(value)
        return(r)

/// Converts to U8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `self`, clamped to [0, 255]; infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<U8>} to detect values that do not fit.
routine F64.to_clamp<U8>(self: Self) -> U8
    block entry():
        r : U8 = fptoui_sat<Self, U8>(self)
        return(r)

