// Tessera stdlib: F64 — 64-bit IEEE 754 floating-point
//
// Maps to LLVM IR double.

module Standard::Core

/// A 64-bit IEEE 754 binary64 floating-point number (double precision), mapped to LLVM `double`.
/// It has a 53-bit significand (about 15 to 17 significant decimal digits) and finite magnitudes up to about 1.8e308.
/// :note: Arithmetic rounds to nearest, ties to even. `eq` is IEEE equality, so NaN is unequal to itself and -0.0 equals +0.0.
/// :see: {F32} for half the size, {F128} for more precision.
#llvm("double")
record F64
conform Equatable<F64>, Comparable<F64>, Hashable<F64>

// -- constants -----------------------------------------------------------------

/// Positive infinity (bits `0x7FF0000000000000`): the result of overflow and of dividing a positive value by +0.0.
preset F64.INFINITY:     F64 = F64.from_bits(0x7FF0000000000000)  // +inf bits
/// Negative infinity (bits `0xFFF0000000000000`).
preset F64.NEG_INFINITY: F64 = F64.from_bits(0xFFF0000000000000)  // -inf bits
/// The canonical quiet NaN (bits `0x7FF8000000000000`).
/// :note: NaN is unequal to everything, itself included, so test for it with {F64.is_nan}, not `eq`.
preset F64.NAN:          F64 = F64.from_bits(0x7FF8000000000000)  // canonical quiet NaN bits

// -- arithmetic ----------------------------------------------------------------

/// Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
/// :returns: `me` with the sign bit cleared.
routine F64.abs(me: Me) -> Me
    block entry()
        r : Me = fabs<Me>(me)
        return(r)

/// The smaller value. If one operand is NaN, the other one.
/// :param other: The value to compare with.
/// :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine F64.min(me: Me, other: Me) -> Me
    block entry()
        self_nan  : Bool = me.is_nan()
        other_nan : Bool = other.is_nan()
        both      : Bool = self_nan.bitand(other_nan)
        when
            both      -> return(me.add(other))
            self_nan  -> return(other)
            other_nan -> return(me)
            else      -> compare()

    // no minnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare()
        pick : Bool = me.le(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// The larger value. If one operand is NaN, the other one.
/// :param other: The value to compare with.
/// :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine F64.max(me: Me, other: Me) -> Me
    block entry()
        self_nan  : Bool = me.is_nan()
        other_nan : Bool = other.is_nan()
        both      : Bool = self_nan.bitand(other_nan)
        when
            both      -> return(me.add(other))
            self_nan  -> return(other)
            other_nan -> return(me)
            else      -> compare()

    // no maxnum intrinsic: on 32-bit ARM it becomes a libm call
    block compare()
        pick : Bool = me.ge(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// Adds `other` to `me`, rounded to nearest (ties to even).
/// :param other: The value to add.
/// :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine F64.add(me: Me, other: Me) -> Me
    block entry()
        r : Me = fadd<Me>(me, other)
        return(r)

/// Subtracts `other` from `me`, rounded to nearest (ties to even).
/// :param other: The value to subtract.
/// :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine F64.sub(me: Me, other: Me) -> Me
    block entry()
        r : Me = fsub<Me>(me, other)
        return(r)

/// Multiplies `me` by `other`, rounded to nearest (ties to even).
/// :param other: The factor.
/// :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine F64.mul(me: Me, other: Me) -> Me
    block entry()
        r : Me = fmul<Me>(me, other)
        return(r)

// -- comparisons ---------------------------------------------------------------

/// Whether `me` is less than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me < other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.lt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = flt<Me>(me, other)
        return(r)

/// Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me <= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.le(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fle<Me>(me, other)
        return(r)

/// Whether `me` is greater than `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me > other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.gt(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fgt<Me>(me, other)
        return(r)

/// Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
/// :param other: The value to compare against.
/// :returns: `me >= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine F64.ge(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fge<Me>(me, other)
        return(r)

// -- division ------------------------------------------------------------------

/// Divides `me` by `other`, rounded to nearest (ties to even).
/// :param other: The divisor.
/// :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine F64.div(me: Me, other: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(me, other)
        return(r)

// -- equality, ordering, hashing -----------------------------------------------

/// IEEE equality.
/// :param other: The value to compare against.
/// :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine F64.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = feq<Me>(me, other)
        return(r)

/// Ordered inequality (LLVM `fcmp one`).
/// :param other: The value to compare against.
/// :returns: True when both operands are numbers and they differ. False for -0.0 against +0.0.
/// :note: Also false when either operand is NaN, so for NaN this is not the negation of {F64.eq}.
routine F64.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = fne<Me>(me, other)
        return(r)

/// Three-way comparison for the `Comparable` conformance.
/// :param other: The value to compare against.
/// :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
/// :see: {F64.total_compare} for a total order that ranks NaN and the signed zeros.
routine F64.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
/// :returns: The 64-bit hash.
/// :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine F64.hash(me: Me) -> U64
    block entry()
        bits : U64 = me.bits()
        h    : U64 = siphash24(bits, hash_key())
        return(h)

// -- generic conversions -------------------------------------------------------

/// Narrows to a smaller float type with LLVM `fptrunc`, rounding to nearest (ties to even).
/// :typeparam T: The narrower float type.
/// :returns: The rounded value: infinity when it overflows `T`, a subnormal or zero when it underflows, NaN for NaN.
routine F64.fptrunc<T>(me: Me) -> T
require T: typename
    block entry()
        r : T = fptrunc<Me, T>(me)
        return(r)

/// Converts to a signed integer type with LLVM `fptosi`, rounding toward zero.
/// :typeparam T: The signed integer type.
/// :returns: The integer part of `me`.
/// :note: NaN or a value out of the range of `T` gives poison. The checked `to<S..>`, `to_checked<S..>` and `to_clamp<S..>` conversions avoid it.
routine F64.fptosi<T>(me: Me) -> T
require T: typename
    block entry()
        r : T = fptosi<Me, T>(me)
        return(r)

// -- named narrowing conversion ------------------------------------------------

/// Narrows to F32, rounding to nearest (ties to even).
/// :returns: The nearest F32: infinity beyond F32's range, a subnormal or zero for tiny values, NaN for NaN.
routine F64.to<F32>(me: Me) -> F32
    block entry()
        result : F32 = fptrunc<Me, F32>(me)
        return(result)

// ============================================================
// Rust-level operations
// ============================================================

// -- constants ------------------------------------------------------------------

/// The largest finite F64, about 1.7976931348623157e308 (bits `0x7FEFFFFFFFFFFFFF`).
preset F64.MAX:          F64 = F64.from_bits(0x7FEFFFFFFFFFFFFF)  // largest finite value
/// The most negative finite F64, the negation of `F64.MAX` (bits `0xFFEFFFFFFFFFFFFF`).
preset F64.MIN:          F64 = F64.from_bits(0xFFEFFFFFFFFFFFFF)  // most negative finite value
/// The smallest positive normal F64, 2^-1022, about 2.2250738585072014e-308 (bits `0x0010000000000000`). Subnormal values go below it.
preset F64.MIN_POSITIVE: F64 = F64.from_bits(0x0010000000000000)  // smallest positive normal value

/// The gap between 1.0 and the next larger F64, 2^-52, about 2.220446049250313e-16 (bits `0x3CB0000000000000`).
preset F64.EPSILON:      F64 = F64.from_bits(0x3CB0000000000000)  // the gap between 1.0 and the next value

/// Pi, rounded to the nearest F64.
preset F64.PI: F64 = 3.14159265358979323846264338327950288  // pi
/// Tau (2 pi), one full turn in radians, rounded to the nearest F64.
preset F64.TAU: F64 = 6.28318530717958647692528676655900577  // 2 pi
/// Euler's number e, rounded to the nearest F64.
preset F64.E: F64 = 2.71828182845904523536028747135266250  // Euler's number
/// Pi / 2, rounded to the nearest F64.
preset F64.FRAC_PI_2: F64 = 1.57079632679489661923132169163975144  // pi / 2
/// Pi / 4, rounded to the nearest F64.
preset F64.FRAC_PI_4: F64 = 0.785398163397448309615660845819875721  // pi / 4
/// 1 / pi, rounded to the nearest F64.
preset F64.FRAC_1_PI: F64 = 0.318309886183790671537767526745028724  // 1 / pi
/// The square root of 2, rounded to the nearest F64.
preset F64.SQRT_2: F64 = 1.41421356237309504880168872420969808  // sqrt(2)
/// 1 / sqrt(2), rounded to the nearest F64.
preset F64.FRAC_1_SQRT_2: F64 = 0.707106781186547524400844362104849039  // 1 / sqrt(2)
/// The natural logarithm of 2, rounded to the nearest F64.
preset F64.LN_2: F64 = 0.693147180559945309417232121458176568  // ln(2)
/// The natural logarithm of 10, rounded to the nearest F64.
preset F64.LN_10: F64 = 2.30258509299404568401799145468436421  // ln(10)
/// Log2(e), rounded to the nearest F64.
preset F64.LOG2_E: F64 = 1.44269504088896340735992468100189214  // log2(e)
/// Log10(e), rounded to the nearest F64.
preset F64.LOG10_E: F64 = 0.434294481903251827651128918916605082  // log10(e)

// -- C math library -----------------------------------------------------------

// -- sign ----------------------------------------------------------------------

/// Flips the sign bit, exactly.
/// :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine F64.neg(me: Me) -> Me
    block entry()
        r : Me = fneg<Me>(me)
        return(r)

/// The magnitude of `me` with the sign of `sign`.
/// :param sign: The value whose sign bit is used.
/// :returns: `me` with its sign bit replaced by the sign bit of `sign`.
routine F64.copysign(me: Me, sign: Me) -> Me
    block entry()
        r : Me = copysign<Me>(me, sign)
        return(r)

/// 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
/// :returns: 1.0, -1.0, or NaN, by the sign of `me`.
routine F64.signum(me: Me) -> Me
    block entry()
        nan  : Bool = me.is_nan()
        unit : Me   = copysign<Me>(1.0, me)
        r    : Me   = nan
            ? me
            : unit
        return(r)

/// Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
/// :returns: Whether the sign bit is clear.
routine F64.is_sign_positive(me: Me) -> Bool
    block entry()
        bits : S64  = me.bits().to_wrap<S64>()
        r    : Bool = bits.ge(0)
        return(r)

/// Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
/// :returns: Whether the sign bit is set.
routine F64.is_sign_negative(me: Me) -> Bool
    block entry()
        bits : S64  = me.bits().to_wrap<S64>()
        r    : Bool = bits.lt(0)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The remainder of me / other, with the sign of me (C fmod, Rust's %). Exact.
///
/// A long division on the significands, one quotient bit per step (up to 2098), since LLVM lowers frem to
/// libm's fmod on every target.
/// :param other: The divisor.
/// :returns: The remainder. NaN when either operand is NaN, `me` is infinite, or `other` is 0. Otherwise `me`
///     itself when `other` is infinite or `me` is a zero.
routine F64.mod(me: Me, other: Me) -> Me
    block entry()
        nan     : Bool = me.is_nan().bitor(other.is_nan())
        invalid : Bool = me.is_infinite().bitor(other.eq(0.0))
        keep    : Bool = other.is_infinite().bitor(me.eq(0.0))
        when
            nan     -> return(me.add(other))
            invalid -> return(Me.NAN)
            keep    -> return(me)
            else    -> finite()

    block finite()
        a        : F64Parts = f64_unpack(me)
        b        : F64Parts = f64_unpack(other)
        same_exp : Bool     = a.exponent.eq(b.exponent)
        smaller  : Bool     = a.exponent.lt(b.exponent).bitor(same_exp.bitand(a.sig.lt(b.sig)))
        branch smaller
            ? return(me)
            : divide(a.sig, b.sig, a.exponent.sub(b.exponent), b.exponent)

    // x < 2 mb throughout, as both significands are normalized
    block divide(x: U64, mb: U64, steps: S64, eb: S64)
        done : Bool = steps.eq(0)
        branch done
            ? last(x, mb, eb)
            : step(x, mb, steps, eb)

    block step(x: U64, mb: U64, steps: S64, eb: S64)
        fits  : Bool = x.ge(mb)
        taken : U64  = fits
            ? mb
            : 0
        left : U64 = x.sub(taken)
        jump divide(left.shl(1), mb, steps.sub(1), eb)

    // the remainder is rest × 2^(eb - 1075), which F64 holds exactly
    block last(x: U64, mb: U64, eb: S64)
        fits  : Bool = x.ge(mb)
        taken : U64  = fits
            ? mb
            : 0
        rest : U64  = x.sub(taken)
        zero : Bool = rest.eq(0)
        branch zero
            ? return(Me.copysign(0.0, me))
            : continue
        lz        : U64 = rest.leading_zeros()
        magnitude : Me  = f64_round_pack(false, eb.sub(lz.to<S64>()).add(11), rest.shl(lz))
        r         : Me  = magnitude.copysign(me)
        return(r)

/// The reciprocal `1 / me`, rounded once.
/// :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine F64.recip(me: Me) -> Me
    block entry()
        r : Me = fdiv<Me>(1.0, me)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed with the AArch64 FMA instruction.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#target(arch: "aarch64")
routine F64.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = fma<Me>(me, a, b)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed with the x86 FMA instruction (targets with the `fma` feature, as with `--cpu x86-64-v3`).
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: "x86_64"), feature("fma")]
routine F64.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = fma<Me>(me, a, b)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed in software ({F64.mul_add_soft}) on x86 without the `fma` feature.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: "x86_64"), feature(not "fma"), inline]
routine F64.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = me.mul_add_soft(a, b)
        return(r)

/// Fused multiply-add: `me * a + b` with a single rounding, computed in software ({F64.mul_add_soft}) on targets other than AArch64 and x86_64.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#[target(arch: not ("aarch64", "x86_64")), inline]
routine F64.mul_add(me: Me, a: Me, b: Me) -> Me
    block entry()
        r : Me = me.mul_add_soft(a, b)
        return(r)

/// me * a + b with a single rounding, without an FMA instruction.
///
/// Without one LLVM calls libm's fma. When the operands' exponents keep every intermediate below away from
/// overflow and underflow, this is Boldo and Melquiond's emulation in F64 arithmetic: the exact product
/// p + e (Dekker), the exact sum c + p = th + tl (TwoSum), then th + (tl + e rounded to odd), rounded once.
/// Rounding the small part to odd keeps the information the last rounding needs, so the result is the
/// correctly rounded `me * a + b`. Plain th + (tl + e) is that same value except near a tie, which an exact
/// check of both roundings' errors rules out, so the round to odd runs only there. Outside that window
/// (zeros, subnormals, infinities, NaN, huge or tiny products) it forms the 106-bit product exactly in a U128,
/// aligns b to it (bits shifted out past the product become a sticky bit), and rounds only the sum
/// ({F64.mul_add_wide}).
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#inline
private routine F64.mul_add_soft(me: Me, a: Me, b: Me) -> Me
    shared field_x : U64 = me.bits().shr(52).bitand(0x7FF)
    shared field_a : U64 = a.bits().shr(52).bitand(0x7FF)
    shared field_b : U64 = b.bits().shr(52).bitand(0x7FF)

    // The emulation is exact when the factors are normal and below 2^996 (splitting them can't overflow),
    // their product's exponent is in [-918, 960] (its error is a multiple of 2^-1022, the product
    // and the sum stay below 2^1003), and the addend's exponent is in [-960, 1000] (its ulp is at least
    // 2^-1012). Every nonzero intermediate is then a normal number.
    block entry()
        x_normal  : Bool = field_x.sub_wrap(1).lt(2018)
        a_normal  : Bool = field_a.sub_wrap(1).lt(2018)
        product   : U64  = field_x.add_wrap(field_a)
        p_inside  : Bool = product.sub_wrap(1128).lt(1879)
        b_inside  : Bool = field_b.sub_wrap(63).lt(1961)
        factors   : Bool = x_normal.bitand(a_normal)
        operands  : Bool = p_inside.bitand(b_inside)
        emulation : Bool = factors.bitand(operands)
        branch emulation
            ? emulated()
            : return(me.mul_add_wide(a, b))

    // R = th + tl + e exactly. z = th + (tl + e), each sum rounded, is R rounded once unless the first
    // rounding moved the sum across a rounding boundary of z. The two errors d and r are exact (TwoSum), so
    // R = z + r + d, and when |r| + |d| is below the distance from z to its nearer boundary, z is the answer.
    // The check runs beside the next operation, and only a sum within a few ulps of a tie of z falls back to
    // rounding tl + e to odd.
    block emulated()
        p  : Me = me.mul(a)
        e  : Me = f64_dekker_error(a, me, p)
        th : Me = b.add(p)
        bv : Me = th.sub(b)
        av : Me = th.sub(bv)
        tl : Me = b.sub(av).add(p.sub(bv))
        s  : Me = tl.add(e)
        z  : Me = th.add(s)
        sv : Me = s.sub(tl)
        su : Me = s.sub(sv)
        d  : Me = tl.sub(su).add(e.sub(sv))
        zv : Me = z.sub(th)
        zu : Me = z.sub(zv)
        r  : Me = th.sub(zu).add(s.sub(zv))
        w  : Me = r.abs().add(d.abs())
        // |r + d| <= |r| + |d|, and w, that sum rounded, is below a power of two only when the sum is. The
        // boundaries of z are half an ulp away, the power of two with the exponent field of z less 53, and a
        // quarter ulp below a power of two, one field less (for z not tiny: a field of 55 or more).
        z_bits   : U64  = z.bits()
        z_field  : U64  = z_bits.shr(52).bitand(0x7FF)
        power    : Bool = z_bits.bitand(0x000FFFFFFFFFFFFF).eq(0)
        boundary : U64  = z_field.sub_wrap(53).sub_wrap(power.to<U64>())
        w_field  : U64  = w.bits().shr(52)
        normal   : Bool = z_field.ge(55)
        inside   : Bool = w_field.lt(boundary)
        decided  : Bool = normal.bitand(inside)
        branch decided
            ? return(z)
            : return(th.add(f64_add_round_to_odd(tl, e)))

/// me * a + b with a single rounding, for every operand: the slow path of {F64.mul_add_soft}, kept out of line so
/// the emulated path that callers inline stays small. It forms the 106-bit product exactly in a U128, aligns b to it
/// (bits shifted out past the product become a sticky bit), and rounds only the sum.
/// :param a: The factor `me` is multiplied by.
/// :param b: The addend.
/// :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
#noinline
private routine F64.mul_add_wide(me: Me, a: Me, b: Me) -> Me
    block entry()
        factors_finite : Bool = me.is_finite().bitand(a.is_finite())
        factor_special : Bool = factors_finite.bitnot()
        addend_special : Bool = b.is_finite().bitnot()
        zero_product   : Bool = me.eq(0.0).bitor(a.eq(0.0))
        zero_addend    : Bool = b.eq(0.0)
        when
            // an infinite or NaN factor makes the product exact, and so does a zero one
            factor_special -> return(me.mul(a).add(b))
            addend_special -> return(b.add(b))
            zero_product   -> return(me.mul(a).add(b))
            // a nonzero product plus zero is the product, whatever the zero's sign
            zero_addend -> return(me.mul(a))
            else        -> finite()

    // P = mx my × 2^(ex + ey - 2170) and C = mc × 2^(ec - 1148), each below 2^126 with its top bit at 124
    // or 125, leaving room for a carry
    block finite()
        px      : F64Parts = f64_unpack(me)
        py      : F64Parts = f64_unpack(a)
        pc      : F64Parts = f64_unpack(b)
        p       : U128     = px.sig.mul_wide(py.sig).shl(20)
        p_e     : S64      = px.exponent.add(py.exponent).sub(2170)
        cc      : U128     = pc.sig.to<U128>().shl(73)
        c_e     : S64      = pc.exponent.sub(1148)
        p_neg   : Bool     = me.is_sign_negative().ne(a.is_sign_negative())
        c_neg   : Bool     = b.is_sign_negative()
        p_first : Bool     = p_e.ge(c_e)
        big     : U128     = p_first
            ? p
            : cc
        small : U128 = p_first
            ? cc
            : p
        e : S64 = p_first
            ? p_e
            : c_e
        diff : S64 = p_first
            ? p_e.sub(c_e)
            : c_e.sub(p_e)
        big_neg : Bool = p_first
            ? p_neg
            : c_neg
        small_neg : Bool = p_first
            ? c_neg
            : p_neg
        aligned : U128 = shr_sticky(small, diff)
        same    : Bool = big_neg.eq(small_neg)
        branch same
            ? sum(big, aligned, e, big_neg)
            : difference(big, aligned, e, big_neg)

    block sum(x: U128, y: U128, e: S64, negative: Bool)
        total : U128 = x.add(y)
        jump round(total, e, negative)

    // an exact zero is +0
    block difference(x: U128, y: U128, e: S64, x_negative: Bool)
        x_larger : Bool = x.ge(y)
        m        : U128 = x.abs_diff(y)
        negative : Bool = x_larger
            ? x_negative
            : x_negative.bitnot()
        jump round(m, e, negative)

    // value = r × 2^e: bring the top bit to 127 and round the high half, with a sticky bit for the low one
    block round(r: U128, e: S64, negative: Bool)
        zero : Bool = r.eq(0)
        branch zero
            ? return(0.0)
            : continue
        lz         : U128 = r.leading_zeros()
        n          : U128 = r.shl(lz)
        high       : U64  = n.shr(64).to<U64>()
        low_sticky : Bool = n.to_wrap<U64>().ne(0)
        sig        : U64  = high.bitor(low_sticky.to<U64>())
        exponent   : S64  = e.sub(lz.to<S64>()).add(1150)
        result     : Me   = f64_round_pack(negative, exponent, sig)
        return(result)

/// The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
/// :param other: The divisor.
/// :returns: The quotient `q`. NaN when either operand is NaN.
routine F64.div_euclid(me: Me, other: Me) -> Me
    block entry()
        q            : Me   = me.div(other).trunc()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0.0)
        down             : Me   = q.sub(1.0)
        up               : Me   = q.add(1.0)
        r                : Me   = positive_divisor
            ? down
            : up
        return(r)

/// The least non-negative remainder of `me / other`.
/// :param other: The divisor.
/// :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
///     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine F64.mod_euclid(me: Me, other: Me) -> Me
    block entry()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0.0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Me   = other.abs()
        r         : Me   = rem.add(magnitude)
        whole     : Bool = r.eq(magnitude).bitand(magnitude.is_finite())
        // a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
        // one in range
        branch whole
            ? return(Me.from_bits(magnitude.bits().sub(1)))
            : return(r)

// -- ordering ------------------------------------------------------------------

/// The smaller value, NaN if either is NaN, and -0.0 below +0.0.
/// :param other: The value to compare with.
/// :returns: The smaller value, or NaN when either operand is NaN.
routine F64.minimum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitor picks the negative one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitor(other.bits())))
            : continue
        pick : Bool = me.lt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// The larger value, NaN if either is NaN, and +0.0 above -0.0.
/// :param other: The value to compare with.
/// :returns: The larger value, or NaN when either operand is NaN.
routine F64.maximum(me: Me, other: Me) -> Me
    block entry()
        nan : Bool = me.is_nan().bitor(other.is_nan())
        branch nan
            ? return(me.add(other))
            : continue
        // equal values have equal bits except ±0, where bitand picks the positive one
        equal : Bool = me.eq(other)
        branch equal
            ? return(Me.from_bits(me.bits().bitand(other.bits())))
            : continue
        pick : Bool = me.gt(other)
        r    : Me   = pick
            ? me
            : other
        return(r)

/// Restricts `me` to `lo ..= hi`. NaN stays NaN.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` unless `lo <= hi`, so also when either bound is NaN.
#track_caller
routine F64.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        below : Bool = me.lt(lo)
        above : Bool = me.gt(hi)
        upper : Me   = above
            ? hi
            : me
        r : Me = below
            ? lo
            : upper
        return(r)

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`. False when any operand is NaN.
routine F64.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`. False when any operand is NaN.
routine F64.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

/// IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as `me` comes before, at the same place as, or after `other` in that order.
routine F64.total_compare(me: Me, other: Me) -> S32
    block entry()
        a : S64 = me.bits().to_wrap<S64>()
        b : S64 = other.bits().to_wrap<S64>()
        // Flipping every bit but the sign of negative values makes the bits order like signed integers.
        a_key : S64 = a.bitxor(a.shr(63).bitand(S64.MAX))
        b_key : S64 = b.bitxor(b.shr(63).bitand(S64.MAX))
        r     : S32 = a_key.compare(b_key)
        return(r)

// -- rounding ------------------------------------------------------------------

// AArch64 has an instruction for each. Elsewhere LLVM calls libm (x86 before SSE4.1 has none), so the other
// targets work on the bits: trunc clears the fraction bits, and the rest adjust its result, all exactly.

/// Rounds toward negative infinity with the AArch64 rounding instruction.
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.floor(me: Me) -> Me
    block entry()
        r : Me = floor<Me>(me)
        return(r)

/// Rounds toward negative infinity from {F64.trunc}, stepping one down when truncation moved the value up (exact).
/// :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.floor(me: Me) -> Me
    block entry()
        t    : Me   = me.trunc()
        down : Bool = t.gt(me)
        r    : Me   = down
            ? t.sub(1.0)
            : t
        return(r)

/// Rounds toward positive infinity with the AArch64 rounding instruction.
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.ceil(me: Me) -> Me
    block entry()
        r : Me = ceil<Me>(me)
        return(r)

/// Rounds toward positive infinity from {F64.trunc}, stepping one up when truncation moved the value down (exact).
/// :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.ceil(me: Me) -> Me
    block entry()
        t  : Me   = me.trunc()
        up : Bool = t.lt(me)
        r  : Me   = up
            ? t.add(1.0)
            : t
        return(r)

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.round(me: Me) -> Me
    block entry()
        r : Me = round<Me>(me)
        return(r)

/// Rounds half-way cases away from zero.
/// :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.round(me: Me) -> Me
    block entry()
        t        : Me   = me.trunc()
        fraction : Me   = me.sub(t)
        half     : Bool = fraction.abs().ge(0.5)
        away     : Me   = t.add(Me.copysign(1.0, me))
        r        : Me   = half
            ? away
            : t
        return(r)

/// Rounds half-way cases to the even neighbor.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.round_ties_even(me: Me) -> Me
    block entry()
        r : Me = rint<Me>(me)
        return(r)

/// Rounds half-way cases to the even neighbor.
///
/// Below 2^52, adding and subtracting 2^52 leaves the magnitude rounded to an integer by the addition.
/// :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.round_ties_even(me: Me) -> Me
    block entry()
        magnitude : Me   = me.abs()
        integral  : Bool = magnitude.ge(4503599627370496.0)
        branch integral
            ? return(me)
            : continue
        rounded : Me = magnitude.add(4503599627370496.0).sub(4503599627370496.0)
        r       : Me = rounded.copysign(me)
        return(r)

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: "aarch64")
routine F64.trunc(me: Me) -> Me
    block entry()
        r : Me = ftrunc<Me>(me)
        return(r)

/// Rounds toward zero.
/// :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
#target(arch: not "aarch64")
routine F64.trunc(me: Me) -> Me
    shared bits  : U64 = me.bits()
    shared field : U64 = bits.shr(52).bitand(0x7FF)

    block entry()
        special   : Bool = field.eq(0x7FF)
        integral  : Bool = field.ge(1075)
        below_one : Bool = field.lt(1023)
        when
            special   -> return(me.add(me))
            integral  -> return(me)
            below_one -> return(Me.from_bits(bits.bitand(0x8000000000000000)))
            else      -> fraction()

    // 1 <= |me| < 2^52: the lowest 1075 - field bits are the fraction
    block fraction()
        mask : U64 = 1.shl(U64.sub(1075, field)).sub(1)
        r    : Me  = Me.from_bits(bits.bitand(mask.bitnot()))
        return(r)

/// `me` minus its integer part, with the sign of `me`.
/// :returns: The fractional part. NaN for an infinity or NaN.
routine F64.fract(me: Me) -> Me
    block entry()
        whole : Me = me.trunc()
        r     : Me = me.sub(whole)
        return(r)

// -- powers --------------------------------------------------------------------
//
// cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
// defined in Standard/F64Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
// bits on every target, unlike the platform libm.

/// The square root of `me`.
/// :returns: The square root: NaN for negative values other than -0.0, which gives -0.0.
routine F64.sqrt(me: Me) -> Me
    block entry()
        r : Me = sqrt<Me>(me)
        return(r)

/// me raised to an integer power, correctly rounded: powf with n converted, which is exact.
/// :param n: The integer exponent.
/// :returns: `me` to the power `n`, rounded once.
routine F64.powi(me: Me, n: S32) -> Me
    block entry()
        r : Me = me.powf(n.to<Me>())
        return(r)

/// The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even). Three
/// tiers, each kept only when an error band around its quotient rounds to one F64 (Ziv's test): the double-double
/// logarithms of F64.ln's fast path divided in double-double ({cm_f64_log_ratio_fast}), then the correctly rounded F128
/// logarithms divided in F128 (within 2^-111 relative, band 2^-109), then both logarithms in F128Big
/// ({big_log_ratio}). Exact results come out exact: log(8, 2) = 3, log(1000, 10) = 3, log(x, x) = 1.
/// :param base: The base of the logarithm.
/// :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the F64 quotient
///     ln(`me`) / ln(`base`): NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for
///     `me` 1 or base 0 or +inf, NaN when both logarithms are zero or both infinite.
/// :note: The first tier decides all but about 2 in a million random pairs. Within about 2^-12 of 1 its absolute
///     bound is too wide and the F128 tier decides. Some pairs near 1 need the last tier: the true quotient of
///     log(1 - 2^-52, 1 + 2^-50) lies within 2^-154 of a midpoint.
routine F64.log(me: Me, base: Me) -> Me
    block entry()
        x_ok    : Bool = me.gt(0.0).bitand(me.is_finite())
        base_ok : Bool = base.gt(0.0).bitand(base.is_finite())
        one     : Bool = me.eq(1.0).bitor(base.eq(1.0))
        general : Bool = x_ok.bitand(base_ok).bitand(one.bitnot())
        branch general
            ? fast()
            : return(me.ln().div(base.ln()))

    block fast()
        r : Option<Me> = cm_f64_log_ratio_fast(me, base)
        when r
            .Present(v) -> return(v)
            .Absent     -> wide()

    block wide()
        q     : F128 = me.to<F128>().ln().div(base.to<F128>().ln())
        width : F128 = q.abs().scalbn(-109)
        left  : Me   = q.sub(width).to<Me>()
        right : Me   = q.add(width).to<Me>()
        branch left.eq(right)
            ? return(left)
            : exact()

    block exact()
        r : F128 = big_log_ratio(me.to<F128>(), base.to<F128>(), 52)
        return(r.to<Me>())

// -- special functions ---------------------------------------------------------

/// Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to F64).
/// :returns: `me` in degrees, rounded once.
routine F64.to_degrees(me: Me) -> Me
    block entry()
        r : Me = me.mul(57.2957795130823208767981548141051703)
        return(r)

/// Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to F64).
/// :returns: `me` in radians, rounded once.
routine F64.to_radians(me: Me) -> Me
    block entry()
        r : Me = me.mul(0.0174532925199432957692369076848861271)
        return(r)

// -- classification ------------------------------------------------------------

/// Whether `me` is NaN, quiet or signaling.
/// :returns: True for NaN, the only value unordered with itself.
routine F64.is_nan(me: Me) -> Bool
    block entry()
        r : Bool = funo<Me>(me, me)
        return(r)

/// Whether `me` is +inf or -inf.
/// :returns: True for either infinity. False for NaN and finite values.
routine F64.is_infinite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.eq(Me.INFINITY)
        return(r)

/// Neither infinite nor NaN.
/// :returns: True for zeros, subnormals and normal values. False for infinities and NaN.
routine F64.is_finite(me: Me) -> Bool
    block entry()
        magnitude : Me   = fabs<Me>(me)
        r         : Bool = magnitude.lt(Me.INFINITY)
        return(r)

/// Not zero, subnormal, infinite, or NaN.
/// :returns: True when the exponent field is neither all zeros nor all ones.
routine F64.is_normal(me: Me) -> Bool
    block entry()
        exponent : U64  = me.bits().bitand(0x7FF0000000000000)
        r        : Bool = exponent.ne(0).bitand(exponent.ne(0x7FF0000000000000))
        return(r)

/// Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `F64.MIN_POSITIVE`.
/// :returns: True for subnormals. False for zero, normal values, infinities and NaN.
routine F64.is_subnormal(me: Me) -> Bool
    block entry()
        bits     : U64  = me.bits()
        exponent : U64  = bits.bitand(0x7FF0000000000000)
        mantissa : U64  = bits.bitand(0x000FFFFFFFFFFFFF)
        r        : Bool = exponent.eq(0).bitand(mantissa.ne(0))
        return(r)

// -- bits ----------------------------------------------------------------------

/// A finite nonzero F64 as sig × 2^(exponent - 1075), with sig normalized to [2^52, 2^53), subnormals too.
record F64Parts
    sig      : U64
    exponent : S64

/// The raw IEEE 754 bits.
/// :returns: The encoding as a U64: sign bit at the top, then the exponent field, then the fraction.
routine F64.bits(me: Me) -> U64
    block entry()
        r : U64 = bitcast<Me, U64>(me)
        return(r)

/// Reinterprets raw IEEE 754 binary64 bits as a F64, exactly.
/// :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
/// :returns: The value with that encoding. NaN payloads are kept.
/// :see: {F64.bits} for the inverse.
routine F64.from_bits(bits: U64) -> Me
    block entry()
        r : Me = bitcast<U64, Me>(bits)
        return(r)

/// Splits a finite, nonzero F64 into a normalized significand and biased exponent, so that `x = sig * 2^(exponent - 1075)`.
/// :param x: A finite, nonzero F64. Zeros, infinities and NaN are not handled.
/// :returns: {F64Parts} with `sig` in [2^52, 2^53). A subnormal is normalized, so its exponent drops to 0 or below.
routine f64_unpack(x: F64) -> F64Parts
    shared bits     : U64 = x.bits()
    shared field    : U64 = bits.shr(52).bitand(0x7FF)
    shared fraction : U64 = bits.bitand(0x000FFFFFFFFFFFFF)

    block entry()
        normal : Bool = field.ne(0)
        branch normal
            ? normal()
            : subnormal()

    block normal()
        sig   : U64      = fraction.bitor(0x0010000000000000)
        parts : F64Parts = F64Parts { sig: sig, exponent: field.to<S64>() }
        return(parts)

    block subnormal()
        shift : U64      = fraction.leading_zeros().sub(11)
        sig   : U64      = fraction.shl(shift)
        parts : F64Parts = F64Parts { sig: sig, exponent: S64.sub(1, shift.to<S64>()) }
        return(parts)

/// sig × 2^(exponent - 1086) rounded to nearest, ties to even, where sig has its top bit (63) set and exponent
/// is the biased exponent the result has if it's normal. Rounds into the subnormals below 1 and overflows to
/// infinity at 0x7FF.
/// :param negative: The sign of the result.
/// :param exponent: The biased exponent the result has if it is normal.
/// :param sig: The significand, with its top bit (63) set.
/// :returns: The rounded F64: a subnormal or zero below exponent 1, and infinity at 0x7FF or above.
routine f64_round_pack(negative: Bool, exponent: S64, sig: U64) -> F64
    shared sign : U64 = negative
        ? 0x8000000000000000
        : 0

    block entry()
        overflow : Bool = exponent.ge(0x7FF)
        tiny     : Bool = exponent.lt(1)
        when
            overflow -> return(F64.from_bits(sign.bitor(0x7FF0000000000000)))
            tiny     -> subnormal()
            else     -> round(exponent, sig)

    // shift to the scale of exponent 1, which encodes as the subnormal field 0
    block subnormal()
        shift : S64  = S64.sub(1, exponent)
        all   : Bool = shift.ge(64)
        some  : U64  = sig.shr(shift.min(63).to<U64>())
        lost  : Bool = all
            ? sig.ne(0)
            : sig.ne(some.shl(shift.min(63).to<U64>()))
        shifted : U64 = all
            ? 0
            : some
        jump round(1, shifted.bitor(lost.to<U64>()))

    // a carry out of the 53 kept bits bumps the exponent, up to infinity
    block round(result_exponent: S64, result_sig: U64)
        kept            : U64  = result_sig.shr(11)
        rest            : U64  = result_sig.bitand(0x7FF)
        odd             : Bool = kept.bitand(1).eq(1)
        up              : Bool = rest.gt(0x400).bitor(rest.eq(0x400).bitand(odd))
        rounded         : U64  = kept.add(up.to<U64>())
        biased_exponent : U64  = result_exponent.sub(1).to<U64>()
        magnitude       : U64  = biased_exponent.shl(52).add(rounded)
        r               : F64  = F64.from_bits(sign.bitor(magnitude))
        return(r)

// -- float conversions -----------------------------------------------------------

/// a + b rounded to odd: truncated toward zero, with the lowest bit set when the sum is inexact. A narrower
/// format with at most 51 bits rounds it to nearest exactly as it would the true sum, so F16's and BF16's
/// mul_add add their exact F64 product this way and narrow once. Finite inputs. An infinite or NaN sum is
/// returned as the addition gives it.
/// :param a: The first addend, finite.
/// :param b: The second addend, finite.
/// :returns: `a + b` rounded to odd, or the plain sum when it is infinite or NaN.
routine f64_add_round_to_odd(a: F64, b: F64) -> F64
    shared s : F64 = a.add(b)

    block entry()
        finite : Bool = s.is_finite()
        branch finite
            ? error()
            : return(s)

    // TwoSum: e is exactly (a + b) - s.
    block error()
        bv      : F64  = s.sub(a)
        av      : F64  = s.sub(bv)
        e       : F64  = a.sub(av).add(b.sub(bv))
        inexact : Bool = e.ne(0.0)
        low_bit : U64  = s.bits().bitand(1)
        even    : Bool = low_bit.eq(0)
        bump    : Bool = inexact.bitand(even)
        branch bump
            ? toward(e)
            : return(s)

    // s rounded to an even neighbour: the odd one is the other neighbour of the true sum, one ulp toward e.
    block toward(e: F64)
        outward : Bool = e.is_sign_negative().eq(s.is_sign_negative())
        bits    : U64  = s.bits()
        odd     : U64  = outward
            ? bits.add_wrap(1)
            : bits.sub_wrap(1)
        return(F64.from_bits(odd))

/// The rounding error of the product `p = x * y`: `x * y - p` rounded once, as `x.mul_add(y, p.neg())` gives it,
/// which is exact whenever that difference is a F64 (unless the product underflows). With the FMA instruction.
/// :param x: The first factor.
/// :param y: The second factor.
/// :param p: `x * y` rounded to nearest.
/// :returns: `x.mul_add(y, p.neg())`.
#[target(arch: "aarch64"), inline]
routine f64_mul_error(x: F64, y: F64, p: F64) -> F64
    block entry()
        e : F64 = x.mul_add(y, p.neg())
        return(e)

/// The rounding error of the product `p = x * y`: `x * y - p` rounded once, as `x.mul_add(y, p.neg())` gives it,
/// which is exact whenever that difference is a F64 (unless the product underflows). With the x86 FMA instruction
/// (targets with the `fma` feature).
/// :param x: The first factor.
/// :param y: The second factor.
/// :param p: `x * y` rounded to nearest.
/// :returns: `x.mul_add(y, p.neg())`.
#[target(arch: "x86_64"), feature("fma"), inline]
routine f64_mul_error(x: F64, y: F64, p: F64) -> F64
    block entry()
        e : F64 = x.mul_add(y, p.neg())
        return(e)

/// The rounding error of the product `p = x * y`: the same value as `x.mul_add(y, p.neg())`, by Dekker's product
/// ({f64_mul_error_soft}) on x86 without the `fma` feature.
/// :param x: The first factor.
/// :param y: The second factor.
/// :param p: `x * y` rounded to nearest.
/// :returns: `x.mul_add(y, p.neg())`.
#[target(arch: "x86_64"), feature(not "fma"), inline]
routine f64_mul_error(x: F64, y: F64, p: F64) -> F64
    block entry()
        e : F64 = f64_mul_error_soft(x, y, p)
        return(e)

/// The rounding error of the product `p = x * y`: the same value as `x.mul_add(y, p.neg())`, by Dekker's product
/// ({f64_mul_error_soft}) on targets other than AArch64 and x86_64.
/// :param x: The first factor.
/// :param y: The second factor.
/// :param p: `x * y` rounded to nearest.
/// :returns: `x.mul_add(y, p.neg())`.
#[target(arch: not ("aarch64", "x86_64")), inline]
routine f64_mul_error(x: F64, y: F64, p: F64) -> F64
    block entry()
        e : F64 = f64_mul_error_soft(x, y, p)
        return(e)

/// `x.mul_add(y, p.neg())` for `p = x * y` without an FMA instruction. When the factors are normal and below
/// 2^996, and their exponents add up to a value in [-970, 1021], the error is a F64 and Dekker's product
/// ({f64_dekker_error}) gives it exactly, so it equals the fused result. Elsewhere it is that fused result.
/// :param x: The first factor.
/// :param y: The second factor.
/// :param p: `x * y` rounded to nearest.
/// :returns: `x.mul_add(y, p.neg())`.
#inline
private routine f64_mul_error_soft(x: F64, y: F64, p: F64) -> F64
    shared field_x : U64 = x.bits().shr(52).bitand(0x7FF)
    shared field_y : U64 = y.bits().shr(52).bitand(0x7FF)

    block entry()
        x_normal : Bool = field_x.sub_wrap(1).lt(2018)
        y_normal : Bool = field_y.sub_wrap(1).lt(2018)
        product  : U64  = field_x.add_wrap(field_y)
        inside   : Bool = product.sub_wrap(1076).lt(1992)
        factors  : Bool = x_normal.bitand(y_normal)
        exact    : Bool = factors.bitand(inside)
        branch exact
            ? return(f64_dekker_error(x, y, p))
            : return(x.mul_add(y, p.neg()))

/// The rounding error of the product `p = x * y` (rounded to nearest), exactly: `x * y - p`, by Dekker's
/// product. Each factor splits into a high part of 26 bits (its encoding rounded to nearest at bit 27, then
/// cut there: two integer operations, where Veltkamp's split takes three dependent float operations) and a
/// low part of at most 26 bits, so the four partial products are exact. Exact when `x` and `y` are normal
/// and below 2^1023, `p` is finite, and the error is a multiple of 2^-1074, which holds when the exponents
/// of `x` and `y` add up to at least -970.
/// :param x: The first factor.
/// :param y: The second factor.
/// :param p: `x * y` rounded to nearest.
/// :returns: `x * y - p`.
#inline
private routine f64_dekker_error(x: F64, y: F64, p: F64) -> F64
    block entry()
        xr : U64 = x.bits().add_wrap(0x4000000)
        xh : F64 = F64.from_bits(xr.bitand(0xFFFFFFFFF8000000))
        xl : F64 = x.sub(xh)
        yr : U64 = y.bits().add_wrap(0x4000000)
        yh : F64 = F64.from_bits(yr.bitand(0xFFFFFFFFF8000000))
        yl : F64 = y.sub(yh)
        t1 : F64 = p.sub(xh.mul(yh))
        t2 : F64 = t1.sub(xh.mul(yl))
        t3 : F64 = t2.sub(xl.mul(yh))
        e  : F64 = xl.mul(yl).sub(t3)
        return(e)

/// Narrows to F32 with round-to-odd, then rounds that to F16. F32's 24 bits are
/// enough (2 * 11 + 2) for the second rounding to be exact.
/// :returns: The nearest F16, rounded once. Values past the F16 range give a signed infinity.
routine F64.to<F16>(me: Me) -> F16
    block entry()
        narrow  : F32  = fptrunc<Me, F32>(me)
        back    : Me   = narrow.to<Me>()
        inexact : Bool = back.ne(me)
        finite  : Bool = narrow.is_finite()
        sticky  : Bool = inexact.bitand(finite)
        // Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
        away  : Bool = sticky.bitand(back.abs().gt(me.abs()))
        trunc : U32  = narrow.bits().sub(away.to<U32>())
        bits  : U32  = trunc.bitor(sticky.to<U32>())
        odd   : F32  = .from_bits(bits)
        r     : F16  = odd.to<F16>()
        return(r)

/// Narrows to F32 with round-to-odd (an inexact result gets its lowest bit set),
/// then rounds that to BF16. Round-to-odd keeps the second rounding from
/// double-rounding, because F32 has more than twice BF16's precision.
/// :returns: The nearest BF16, rounded once.
routine F64.to<BF16>(me: Me) -> BF16
    block entry()
        narrow  : F32  = fptrunc<Me, F32>(me)
        back    : Me   = narrow.to<Me>()
        inexact : Bool = back.ne(me)
        finite  : Bool = narrow.is_finite()
        sticky  : Bool = inexact.bitand(finite)
        // Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
        away  : Bool = sticky.bitand(back.abs().gt(me.abs()))
        trunc : U32  = narrow.bits().sub(away.to<U32>())
        bits  : U32  = trunc.bitor(sticky.to<U32>())
        odd   : F32  = .from_bits(bits)
        r     : BF16 = odd.to<BF16>()
        return(r)

/// The identity conversion, so generic code can call `to<T>()` when `T` is F64.
/// :returns: `me` unchanged.
routine F64.to<Me>(me: Me) -> Me
    block entry()
        return(me)

// -- integer conversions ---------------------------------------------------------
//
// to_<int> rounds toward zero and crashes on NaN or a value out of the integer's
// range, while to_<int>_checked returns None instead and to_<int>_clamp saturates
// (NaN gives 0).

/// Converts to S8, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
/// :see: {F64.to_checked<S8>} to get an absent value instead, {F64.to_clamp<S8>} to saturate.
#track_caller
routine F64.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.is_trunc_in_range(-128.0, 128.0)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S8, rounding toward zero, without crashing.
/// :returns: The integer part of `me` when it fits.
/// :absent: When `me` is NaN or its integer part lies outside [-128, 127].
/// :see: {F64.to<S8>} to crash instead, {F64.to_clamp<S8>} to saturate.
routine F64.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.is_trunc_in_range(-128.0, 128.0)
        value : S8         = fptosi_sat<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts to S8, rounding toward zero and saturating at the ends of its range.
/// :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
/// :see: {F64.to_checked<S8>} to detect values that do not fit.
routine F64.to_clamp<S8>(me: Me) -> S8
    block entry()
        r : S8 = fptosi_sat<Me, S8>(me)
        return(r)

/// Converts to S16, rounding toward zero.
/// :returns: The integer part of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
/// :see: {F64.to_checked<S16>} to get an absent value instead, {F64.to_clamp<S16>} to saturate.
#track_caller
routine F64.to<S16>(me: Me) -> S16
