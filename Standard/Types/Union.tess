// Tessera stdlib: the variants written inline
//
// `A | B` is a variant with no declaration of its own: it is Union2[A, B] here, its branches in the order of their
// types' names, so `A | B` and `B | A` are one type, written back as `A | B` in messages. `A | B | C` is Union3, up to
// eight branches. A value of A goes where `A | B` is expected, and an `A | B` goes where `A | B | C` is. Name a union
// used often with define: `define ConfigError = IoError | ParseError`.

module Standard/Core

/// The variant written inline with 2 branches, `T0 | T1`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
@union
variant Union2[T0, T1]
needs T0: typename, T1: typename
    T0
    T1

/// The variant written inline with 3 branches, `T0 | T1 | T2`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
/// :typeparam T2: Branch 3, in the order of the types' names.
@union
variant Union3[T0, T1, T2]
needs T0: typename, T1: typename, T2: typename
    T0
    T1
    T2

/// The variant written inline with 4 branches, `T0 | T1 | T2 | T3`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
/// :typeparam T2: Branch 3, in the order of the types' names.
/// :typeparam T3: Branch 4, in the order of the types' names.
@union
variant Union4[T0, T1, T2, T3]
needs T0: typename, T1: typename, T2: typename, T3: typename
    T0
    T1
    T2
    T3

/// The variant written inline with 5 branches, `T0 | T1 | T2 | T3 | T4`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
/// :typeparam T2: Branch 3, in the order of the types' names.
/// :typeparam T3: Branch 4, in the order of the types' names.
/// :typeparam T4: Branch 5, in the order of the types' names.
@union
variant Union5[T0, T1, T2, T3, T4]
needs T0: typename, T1: typename, T2: typename, T3: typename, T4: typename
    T0
    T1
    T2
    T3
    T4

/// The variant written inline with 6 branches, `T0 | T1 | T2 | T3 | T4 | T5`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
/// :typeparam T2: Branch 3, in the order of the types' names.
/// :typeparam T3: Branch 4, in the order of the types' names.
/// :typeparam T4: Branch 5, in the order of the types' names.
/// :typeparam T5: Branch 6, in the order of the types' names.
@union
variant Union6[T0, T1, T2, T3, T4, T5]
needs T0: typename, T1: typename, T2: typename, T3: typename, T4: typename, T5: typename
    T0
    T1
    T2
    T3
    T4
    T5

/// The variant written inline with 7 branches, `T0 | T1 | T2 | T3 | T4 | T5 | T6`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
/// :typeparam T2: Branch 3, in the order of the types' names.
/// :typeparam T3: Branch 4, in the order of the types' names.
/// :typeparam T4: Branch 5, in the order of the types' names.
/// :typeparam T5: Branch 6, in the order of the types' names.
/// :typeparam T6: Branch 7, in the order of the types' names.
@union
variant Union7[T0, T1, T2, T3, T4, T5, T6]
needs T0: typename, T1: typename, T2: typename, T3: typename, T4: typename, T5: typename, T6: typename
    T0
    T1
    T2
    T3
    T4
    T5
    T6

/// The variant written inline with 8 branches, `T0 | T1 | T2 | T3 | T4 | T5 | T6 | T7`.
/// :typeparam T0: Branch 1, in the order of the types' names.
/// :typeparam T1: Branch 2, in the order of the types' names.
/// :typeparam T2: Branch 3, in the order of the types' names.
/// :typeparam T3: Branch 4, in the order of the types' names.
/// :typeparam T4: Branch 5, in the order of the types' names.
/// :typeparam T5: Branch 6, in the order of the types' names.
/// :typeparam T6: Branch 7, in the order of the types' names.
/// :typeparam T7: Branch 8, in the order of the types' names.
@union
variant Union8[T0, T1, T2, T3, T4, T5, T6, T7]
needs T0: typename, T1: typename, T2: typename, T3: typename, T4: typename, T5: typename, T6: typename, T7: typename
    T0
    T1
    T2
    T3
    T4
    T5
    T6
    T7
