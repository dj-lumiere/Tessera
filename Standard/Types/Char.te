# Tessera stdlib: Char — a Unicode scalar value
#
# Maps to LLVM IR i32 and always holds 0 ..= 0x10FFFF outside the surrogates
# 0xD800 ..= 0xDFFF. A literal is written 'A', and U32.to[Char]() checks a number.

module Standard/Core

### A Unicode scalar value, mapped to LLVM `i32`. It holds a code point from 0 to 0x10FFFF, excluding the surrogates 0xD800 to 0xDFFF. A literal is written `'A'`, and `U32.to[Char]()` checks a number.
@llvm("i32")
record Char
obeys Equatable[Char], Comparable[Char], Hashable[Char]

### Reinterprets `me` as its code point number.
### :returns: The code point as a `U32`.
routine Char.to[U32]() -> U32
    r: U32 = bitcast[Me, U32](me)
    return r

### Hashes `me` as its `U32` code point.
### :returns: The 64-bit hash.
routine Char.hash() -> U64
    h: U64 = me.to[U32]().hash()
    return h

### Whether `me` and `other` are the same character.
### :param other: The right-hand operand.
### :returns: `true` when the code points are equal.
routine Char.eq(other: Me) -> Bool
    return ieq[Me](me, other)

### Whether `me` and `other` are different characters.
### :param other: The right-hand operand.
### :returns: `true` when the code points differ.
routine Char.ne(other: Me) -> Bool
    return ine[Me](me, other)

### Whether the code point of `me` is less than that of `other`.
### :param other: The right-hand operand.
### :returns: `true` when the relation holds.
@external("llvm")
@template("{result} = icmp ult i32 {me}, {other}")
routine Char.lt(other: Me) -> Bool

### Whether the code point of `me` is less than or equal to that of `other`.
### :param other: The right-hand operand.
### :returns: `true` when the relation holds.
@external("llvm")
@template("{result} = icmp ule i32 {me}, {other}")
routine Char.le(other: Me) -> Bool

### Whether the code point of `me` is greater than that of `other`.
### :param other: The right-hand operand.
### :returns: `true` when the relation holds.
@external("llvm")
@template("{result} = icmp ugt i32 {me}, {other}")
routine Char.gt(other: Me) -> Bool

### Whether the code point of `me` is greater than or equal to that of `other`.
### :param other: The right-hand operand.
### :returns: `true` when the relation holds.
@external("llvm")
@template("{result} = icmp uge i32 {me}, {other}")
routine Char.ge(other: Me) -> Bool

### Three-way comparison of `me` and `other` by code point.
### :param other: The right-hand operand.
### :returns: -1, 0, or 1 as `me` is below, equal to, or above `other`.
routine Char.compare(other: Me) -> S32
    r: S32 = me.to[U32]().compare(other.to[U32]())
    return r

### Whether `me` is an ASCII character, that is, a code point below 128.
### :returns: `true` for code points 0 to 127.
routine Char.is_ascii() -> Bool
    return me.to[U32]() < 128
