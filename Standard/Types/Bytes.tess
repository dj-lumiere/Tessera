// Tessera stdlib: Bytes
//
// Bytes is a non-owning immutable view over a byte sequence, UTF-8 by convention:
//   data   — @Byte to the first byte (a literal's bytes are also NUL-terminated; other views aren't)
//   length — USize byte count (not including the null terminator)
//
// Nothing checks that the bytes are UTF-8; is_utf8 does when it matters. The character operations read a malformed
// sequence as U+FFFD and move on, so they are defined for any bytes. A string literal ("hello", "안녕") is a Bytes
// constant holding its UTF-8 encoding: no heap allocation, no allocator needed.
//
// Bytes never owns its bytes.  The caller is responsible for ensuring the
// pointed-to data outlives the Bytes.  To build text on the heap, write into
// a List<Byte> (it's a Writer) and view it with buf.to_bytes().
//
// Factory routines (concat) take an explicit @Allocator and
// return a Bytes whose data must be freed by the caller with `data.free(alloc)`.

module Standard::Core

import Standard::Alloc

/// A non-owning, immutable view over a byte sequence, UTF-8 by convention. `data` points at the first byte and `length` counts bytes without any terminator; the view never owns its bytes, so they must outlive it. A string literal is a `Bytes` constant.
record Bytes
conform Equal<Bytes>, Compare<Bytes>, Hash<Bytes>
    data   : @Byte
    length : USize

// -- construction --------------------------------------------------------------

/// The empty view: a null `data` pointer and a length of 0.
/// :returns: An empty `Bytes`.
routine Bytes.empty() -> Self
    block entry()
        str : Self = Self { data: null, length: 0 }
        return(str)

/// Views `length` bytes starting at `data`, without copying. Nothing checks that the memory is valid or UTF-8.
/// :param data: A pointer to the first byte.
/// :param length: The number of bytes in the view.
/// :returns: A view over those bytes.
routine Bytes.from_ptr(data: @Byte, length: USize) -> Self
    block entry()
        str : Self = Self { data: data, length: length }
        return(str)

// -- predicates ----------------------------------------------------------------

/// The length in bytes of the UTF-8 text, not in characters (count those with chars()).
routine Bytes.length(self: Self) -> USize
    block entry()
        length : USize = self.length
        return(length)

/// Whether the view holds no bytes.
/// :returns: `true` when the length is 0.
routine Bytes.is_empty(self: Self) -> Bool
    block entry()
        length : USize = self.length
        result : Bool  = length.eq(0)
        return(result)

// -- element access ------------------------------------------------------------

/// Reads the byte at `index`.
/// :param index: The zero-based byte position.
/// :returns: The byte as a number from 0 to 255.
/// :throws: Panics with `TrapCode.Bounds` when `index` is not less than the length.
#track_caller
routine Bytes.byte_at(self: Self, index: USize) -> U8
    block entry()
        length    : USize = self.length
        in_bounds : Bool  = index.lt(length)
        branch in_bounds
            ? load()
            : panic(TrapCode.Bounds)

    block load()
        data : @Byte = self.data
        byte : U8    = .from_byte(data.stride(index).load())
        return(byte)

// -- slicing -------------------------------------------------------------------

/// Returns a sub-view [start, end).  Traps if range is out of bounds.
#track_caller
routine Bytes.slice(self: Self, start: USize, end: USize) -> Self
    block entry()
        length      : USize = self.length
        valid_end   : Bool  = end.le(length)
        valid_order : Bool  = start.le(end)
        valid       : Bool  = valid_end.bitand(valid_order)
        branch valid
            ? make()
            : panic(TrapCode.Bounds)

    block make()
        base      : @Byte = self.data
        from      : @Byte = base.stride(start)
        length    : USize = self.length
        slice_len : USize = end.sub(start)
        result    : Self  = Self { data: from, length: slice_len }
        return(result)

// -- heap-allocating operations ------------------------------------------------

/// Allocates a new buffer containing a followed by b.
/// The caller frees the returned Bytes's data with `data.free(alloc)`.
#track_caller
routine Bytes.concat(a: Self, b: Self, alloc: @Allocator) -> Self
    block entry()
        la     : USize = a.length
        lb     : USize = b.length
        length : USize = la.add(lb)
        data   : @Byte = allocate<Byte>(alloc, length.add(1))
        failed : Bool  = data.is_null()
        branch failed
            ? panic(TrapCode.AllocFailed)
            : continue
        src_a : @Byte = a.data
        len_a : USize = a.length
        copy<Byte>(data, src_a, len_a)
        jump copy_b(data, len_a)

    block copy_b(data: @Byte, offset: USize)
        dst   : @Byte = data.stride(offset)
        src_b : @Byte = b.data
        len_b : USize = b.length
        copy<Byte>(dst, src_b, len_b)
        length : USize = offset.add(len_b)
        data.stride(length).store(0x00)
        result : Self = Self { data: data, length: length }
        return(result)

// -- equality, ordering, hashing -----------------------------------------------

/// Whether both views hold the same bytes: equal lengths and equal contents, not the same address.
/// :param other: The right-hand operand.
/// :returns: `true` when the contents are identical.
routine Bytes.eq(self: Self, other: Self) -> Bool
    block entry()
        la       : USize = self.length
        lb       : USize = other.length
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? loop(0, la, self.data, other.data)
            : return(false)

    block loop(i: USize, len: USize, pa: @Byte, pb: @Byte)
        done : Bool = i.ge(len)
        branch done
            ? return(true)
            : continue
        ba : U8   = .from_byte(pa.stride(i).load())
        bb : U8   = .from_byte(pb.stride(i).load())
        eq : Bool = ba.eq(bb)
        branch eq
            ? loop(i.add(1), len, pa, pb)
            : return(false)

/// Lexicographic byte-wise compare. Returns -1, 0, 1.
/// Bytes are compared as U8, so this matches `memcmp` ordering.
routine Bytes.compare(self: Self, other: Self) -> S32
    block entry()
        la        : USize = self.length
        lb        : USize = other.length
        a_shorter : Bool  = la.le(lb)
        min       : USize = a_shorter
            ? la
            : lb
        pa : @Byte = self.data
        pb : @Byte = other.data
        jump loop(0, min, la, lb, pa, pb)

    block loop(i: USize, min: USize, la: USize, lb: USize, pa: @Byte, pb: @Byte)
        done : Bool = i.ge(min)
        branch done
            ? lengths(la, lb)
            : step(i, min, la, lb, pa, pb)

    block step(i: USize, min: USize, la: USize, lb: USize, pa: @Byte, pb: @Byte)
        ba : U8   = .from_byte(pa.stride(i).load())
        bb : U8   = .from_byte(pb.stride(i).load())
        lt : Bool = ba.lt(bb)
        branch lt
            ? return(-1)
            : maybe_gt(i, min, la, lb, ba, bb, pa, pb)

    block maybe_gt(i: USize, min: USize, la: USize, lb: USize, ba: U8, bb: U8, pa: @Byte, pb: @Byte)
        gt : Bool = ba.gt(bb)
        branch gt
            ? return(1)
            : loop(i.add(1), min, la, lb, pa, pb)

    block lengths(la: USize, lb: USize)
        lt : Bool = la.lt(lb)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = la.gt(lb)
        branch gt
            ? return(1)
            : return(0)

/// xxHash64 of the byte contents, seeded with 0.
routine Bytes.hash(self: Self) -> U64
    block entry()
        data : @Byte = self.data
        len  : USize = self.length
        h    : U64   = xxh64(data, len, 0)
        return(h)

// -- search --------------------------------------------------------------------

/// Whether the view begins with `prefix`.
/// :param prefix: The bytes to look for at the start.
/// :returns: `true` when `prefix` matches the first bytes; an empty `prefix` always matches.
routine Bytes.starts_with(self: Self, prefix: Self) -> Bool
    block entry()
        sl   : USize = self.length
        pl   : USize = prefix.length
        fits : Bool  = pl.le(sl)
        branch fits
            ? loop(0, pl, self.data, prefix.data)
            : return(false)

    block loop(i: USize, pl: USize, sd: @Byte, pd: @Byte)
        done : Bool = i.ge(pl)
        branch done
            ? return(true)
            : continue
        a  : U8   = .from_byte(sd.stride(i).load())
        b  : U8   = .from_byte(pd.stride(i).load())
        eq : Bool = a.eq(b)
        branch eq
            ? loop(i.add(1), pl, sd, pd)
            : return(false)

/// Whether the view ends with `suffix`.
/// :param suffix: The bytes to look for at the end.
/// :returns: `true` when `suffix` matches the last bytes; an empty `suffix` always matches.
routine Bytes.ends_with(self: Self, suffix: Self) -> Bool
    block entry()
        sl   : USize = self.length
        fl   : USize = suffix.length
        fits : Bool  = fl.le(sl)
        branch fits
            ? loop(0, fl, sl.sub(fl), self.data, suffix.data)
            : return(false)

    block loop(i: USize, fl: USize, off: USize, sd: @Byte, fd: @Byte)
        done : Bool = i.ge(fl)
        branch done
            ? return(true)
            : continue
        idx : USize = off.add(i)
        a   : U8    = .from_byte(sd.stride(idx).load())
        b   : U8    = .from_byte(fd.stride(i).load())
        eq  : Bool  = a.eq(b)
        branch eq
            ? loop(i.add(1), fl, off, sd, fd)
            : return(false)

/// Naive O(n*m) substring search. Returns the byte index of the first match,
/// or Option<USize>.Absent when not found. An empty needle matches at 0.
routine Bytes.find(self: Self, needle: Self) -> Option<USize>
    block entry()
        nlen         : USize = needle.length
        slen         : USize = self.length
        empty_needle : Bool  = nlen.eq(0)
        branch empty_needle
            ? hit(0)
            : check_fits(nlen, slen)

    block check_fits(nlen: USize, slen: USize)
        too_big : Bool = nlen.gt(slen)
        branch too_big
            ? miss()
            : start(nlen, slen)

    block miss()
        r : Option<USize> = .Absent
        return(r)

    block hit(i: USize)
        r : Option<USize> = .Present(i)
        return(r)

    block start(nlen: USize, slen: USize)
        sd   : @Byte = self.data
        nd   : @Byte = needle.data
        last : USize = slen.sub(nlen)
        jump outer(0, last, nlen, sd, nd)

    block outer(i: USize, last: USize, nlen: USize, sd: @Byte, nd: @Byte)
        past : Bool = i.gt(last)
        branch past
            ? miss()
            : inner(i, 0, last, nlen, sd, nd)

    block inner(i: USize, j: USize, last: USize, nlen: USize, sd: @Byte, nd: @Byte)
        done : Bool = j.ge(nlen)
        branch done
            ? hit(i)
            : check(i, j, last, nlen, sd, nd)

    block check(i: USize, j: USize, last: USize, nlen: USize, sd: @Byte, nd: @Byte)
        idx : USize = i.add(j)
        a   : U8    = .from_byte(sd.stride(idx).load())
        b   : U8    = .from_byte(nd.stride(j).load())
        eq  : Bool  = a.eq(b)
        branch eq
            ? inner(i, j.add(1), last, nlen, sd, nd)
            : outer(i.add(1), last, nlen, sd, nd)

/// Whether `needle` occurs anywhere in the view, using {Bytes.find}.
/// :param needle: The bytes to look for.
/// :returns: `true` when a match exists; an empty `needle` always matches.
routine Bytes.contains(self: Self, needle: Self) -> Bool
    block entry()
        r     : Option<USize> = self.find(needle)
        found : Bool          = r.is_present()
        return(found)

// -- UTF-8 -----------------------------------------------------------------------

/// Whether the bytes are well-formed UTF-8: no bad lead or continuation byte, overlong form, surrogate, or value past
/// U+10FFFF.
routine Bytes.is_utf8(self: Self) -> Bool
    block entry()
        jump next(0)

    block next(pos: USize)
        done : Bool = pos.ge(self.length)
        branch done
            ? return(true)
            : decode(pos)

    block decode(pos: USize)
        d : Utf8Decoded = utf8_decode(self.data, pos, self.length)
        branch d.ok
            ? next(d.next_pos)
            : return(false)

/// Whether a character can start at byte index: the byte there isn't a UTF-8 continuation byte. True at the end,
/// false past it.
routine Bytes.is_char_boundary(self: Self, index: USize) -> Bool
    block entry()
        at_end : Bool = index.eq(self.length)
        past   : Bool = index.gt(self.length)
        when
            at_end -> return(true)
            past   -> return(false)
            else   -> inside()

    block inside()
        b    : U8   = U8.from_byte(self.data.stride(index).load())
        lead : Bool = b.bitand(0xC0).ne(0x80)
        return(lead)

// -- iterators -----------------------------------------------------------------

/// Iterates over the raw bytes as `U8` values.
/// :returns: A {BytesIter} positioned at the first byte.
routine Bytes.bytes(self: Self) -> BytesIter
    block entry()
        iter : BytesIter = BytesIter { str: self, index: 0 }
        return(iter)

/// Iterates over the characters, decoding UTF-8; a malformed sequence yields U+FFFD.
/// :returns: A {BytesCharsIter} positioned at the first character.
routine Bytes.chars(self: Self) -> BytesCharsIter
    block entry()
        iter : BytesCharsIter = BytesCharsIter { str: self, index: 0 }
        return(iter)
