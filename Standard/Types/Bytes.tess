// Tessera stdlib: Bytes
//
// Bytes is text: UTF-8 by convention, and the type of a string literal. It is three fields:
//   data  — @Byte to the first byte (a literal's bytes are also NUL-terminated, but other text isn't)
//   count — USize byte count (not including any terminator)
//   alloc — @Allocator the bytes came from, or null when they're borrowed
//
// Nothing checks that the bytes are UTF-8, but is_utf8 does when it matters. The character operations read a malformed
// sequence as U+FFFD and move on, so they are defined for any bytes.
//
// destruct() gives the bytes back to alloc and leaves the value empty. A null alloc means the text is borrowed and
// destruct() does nothing: a string literal (its bytes are in the program image), Bytes.from_ptr, and every text made
// from other text (slice, getview, the iterators, to<Bytes>() of a List<Byte>) have a null alloc. Text a routine
// allocates (concat, In.read_line, File.read_all, join_path) carries its allocator, and the caller destructs it.
// Copying a Bytes copies the allocator with it, so either copy can give the bytes back: destruct exactly one. ==,
// compare, and hash look at the bytes only, never at alloc.
//
// Slice<Byte> has the same layout and is plain bytes. to<Slice<Byte>>() and Slice<Byte>.to<Bytes>() convert between
// them as borrowed views.

module Standard::Core

import Standard::Alloc

/// Text, UTF-8 by convention: `count` bytes at `data`, and `alloc`, the allocator they came from. A null `alloc` means
/// the bytes are borrowed and `destruct()` does nothing. A string literal is a `Bytes` with a null `alloc`.
record Bytes
conform Equatable<Bytes>, Comparable<Bytes>, Hashable<Bytes>, Destructible<Bytes>
    data  : @Byte
    count : USize
    alloc : @Allocator

// -- construction --------------------------------------------------------------

/// The empty text: a null `data` pointer, a count of 0, and a null allocator.
/// :returns: An empty `Bytes`.
routine Bytes.empty() -> Self
    block entry()
        str : Self = Self { data: null, count: 0, alloc: null }
        return(str)

/// The `count` bytes starting at `data`, borrowed (a null allocator), without copying. Nothing checks that the memory
/// is valid or UTF-8.
/// :param data: A pointer to the first byte.
/// :param count: The number of bytes.
/// :returns: The text, which `destruct()` leaves alone.
routine Bytes.from_ptr(data: @Byte, count: USize) -> Self
    block entry()
        str : Self = Self { data: data, count: count, alloc: null }
        return(str)

/// The same bytes, borrowed: the same data and count with a null allocator, so `destruct()` on it does nothing.
routine Bytes.getview(self: Self) -> Self
    block entry()
        view : Self = Self { data: self.data, count: self.count, alloc: null }
        return(view)

/// The same bytes, borrowed: the same data and count with a null allocator, so `destruct()` on it does nothing.
routine Bytes.getview(self: @Self) -> Self
    block entry()
        view : Self = self.load().getview()
        return(view)

/// Gives the bytes back to the allocator they came from and leaves the text empty: a null data, a count of 0, and a
/// null allocator. Does nothing when the allocator is null (a literal, or text borrowed from somewhere else).
#track_caller
routine Bytes.destruct(self: @Self) -> Void
    block entry()
        alloc    : @Allocator = self.alloc.load()
        borrowed : Bool       = alloc.is_null()
        branch borrowed
            ? return()
            : continue
        data  : @Byte = self.data.load()
        empty : Bool  = data.is_null()
        branch empty
            ? reset()
            : continue
        deallocate<Byte>(alloc, data)
        jump reset()

    block reset()
        self.data.store(null)
        self.count.store(0)
        self.alloc.store(null)
        return()

// -- predicates ----------------------------------------------------------------

/// The number of bytes of the UTF-8 text, not of characters (count those with chars()).
routine Bytes.count(self: Self) -> USize
    block entry()
        count : USize = self.count
        return(count)

/// Whether the text holds no bytes.
/// :returns: `true` when the count is 0.
routine Bytes.is_empty(self: Self) -> Bool
    block entry()
        count  : USize = self.count
        result : Bool  = count.eq(0)
        return(result)

// -- element access ------------------------------------------------------------

/// Reads the byte at `index`.
/// :param index: The zero-based byte position.
/// :returns: The byte as a number from 0 to 255.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index` is not less than the count.
#track_caller
routine Bytes.byte_at(self: Self, index: USize) -> U8
    block entry()
        count     : USize = self.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        data : @Byte = self.data
        byte : U8    = Byte.to<U8>(data.stride(index).load())
        return(byte)

// -- slicing -------------------------------------------------------------------

/// The bytes in [start, end), borrowed (a null allocator).
/// :throws: Crashes with `IndexOutOfBoundsError` when the range is out of bounds.
#track_caller
routine Bytes.slice(self: Self, start: USize, end: USize) -> Self
    block entry()
        count       : USize = self.count
        valid_end   : Bool  = end.le(count)
        valid_order : Bool  = start.le(end)
        valid       : Bool  = valid_end.bitand(valid_order)
        branch valid
            ? make()
            : crash_out_of_bounds()

    block make()
        base      : @Byte = self.data
        from      : @Byte = base.stride(start)
        count     : USize = self.count
        slice_len : USize = end.sub(start)
        result    : Self  = Self { data: from, count: slice_len, alloc: null }
        return(result)

// -- heap-allocating operations ------------------------------------------------

/// a followed by b in new memory from `alloc`, with a NUL after them that the count leaves out. The caller gives it
/// back with destruct().
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails.
#track_caller
routine Bytes.concat(a: Self, b: Self, alloc: @Allocator) -> Self
    block entry()
        la     : USize = a.count
        lb     : USize = b.count
        count  : USize = la.add(lb)
        data   : @Byte = allocate<Byte>(alloc, count.add(1))
        failed : Bool  = data.is_null()
        branch failed
            ? crash_allocation()
            : continue
        src_a : @Byte = a.data
        len_a : USize = a.count
        copy<Byte>(data, src_a, len_a)
        jump copy_b(data, len_a)

    block copy_b(data: @Byte, offset: USize)
        dst   : @Byte = data.stride(offset)
        src_b : @Byte = b.data
        len_b : USize = b.count
        copy<Byte>(dst, src_b, len_b)
        count : USize = offset.add(len_b)
        data.stride(count).store(0x00)
        result : Self = Self { data: data, count: count, alloc: alloc }
        return(result)

// -- equality, ordering, hashing -----------------------------------------------

/// Whether both hold the same bytes: equal counts and equal contents, not the same address or allocator.
/// :param other: The right-hand operand.
/// :returns: `true` when the contents are identical.
routine Bytes.eq(self: Self, other: Self) -> Bool
    block entry()
        la       : USize = self.count
        lb       : USize = other.count
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? loop(0, la, self.data, other.data)
            : return(false)

    block loop(i: USize, len: USize, pa: @Byte, pb: @Byte)
        done : Bool = i.ge(len)
        branch done
            ? return(true)
            : continue
        ba : U8   = Byte.to<U8>(pa.stride(i).load())
        bb : U8   = Byte.to<U8>(pb.stride(i).load())
        eq : Bool = ba.eq(bb)
        branch eq
            ? loop(i.add(1), len, pa, pb)
            : return(false)

/// Lexicographic byte-wise compare. Returns -1, 0, 1.
/// Bytes are compared as U8, so this matches `memcmp` ordering. The allocator plays no part.
routine Bytes.compare(self: Self, other: Self) -> S32
    block entry()
        la        : USize = self.count
        lb        : USize = other.count
        a_shorter : Bool  = la.le(lb)
        min       : USize = a_shorter
            ? la
            : lb
        pa : @Byte = self.data
        pb : @Byte = other.data
        jump loop(0, min, la, lb, pa, pb)

    block loop(i: USize, min: USize, la: USize, lb: USize, pa: @Byte, pb: @Byte)
        done : Bool = i.ge(min)
        branch done
            ? counts(la, lb)
            : step(i, min, la, lb, pa, pb)

    block step(i: USize, min: USize, la: USize, lb: USize, pa: @Byte, pb: @Byte)
        ba : U8   = Byte.to<U8>(pa.stride(i).load())
        bb : U8   = Byte.to<U8>(pb.stride(i).load())
        lt : Bool = ba.lt(bb)
        branch lt
            ? return(-1)
            : maybe_gt(i, min, la, lb, ba, bb, pa, pb)

    block maybe_gt(i: USize, min: USize, la: USize, lb: USize, ba: U8, bb: U8, pa: @Byte, pb: @Byte)
        gt : Bool = ba.gt(bb)
        branch gt
            ? return(1)
            : loop(i.add(1), min, la, lb, pa, pb)

    block counts(la: USize, lb: USize)
        lt : Bool = la.lt(lb)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = la.gt(lb)
        branch gt
            ? return(1)
            : return(0)

/// xxHash64 of the byte contents, seeded with 0. The allocator plays no part.
routine Bytes.hash(self: Self) -> U64
    block entry()
        data : @Byte = self.data
        len  : USize = self.count
        h    : U64   = xxh64(data, len, 0)
        return(h)

// -- search --------------------------------------------------------------------

/// Whether the text begins with `prefix`.
/// :param prefix: The bytes to look for at the start.
/// :returns: `true` when `prefix` matches the first bytes. An empty `prefix` always matches.
routine Bytes.starts_with(self: Self, prefix: Self) -> Bool
    block entry()
        sl   : USize = self.count
        pl   : USize = prefix.count
        fits : Bool  = pl.le(sl)
        branch fits
            ? loop(0, pl, self.data, prefix.data)
            : return(false)

    block loop(i: USize, pl: USize, sd: @Byte, pd: @Byte)
        done : Bool = i.ge(pl)
        branch done
            ? return(true)
            : continue
        a  : U8   = Byte.to<U8>(sd.stride(i).load())
        b  : U8   = Byte.to<U8>(pd.stride(i).load())
        eq : Bool = a.eq(b)
        branch eq
            ? loop(i.add(1), pl, sd, pd)
            : return(false)

/// Whether the text ends with `suffix`.
/// :param suffix: The bytes to look for at the end.
/// :returns: `true` when `suffix` matches the last bytes. An empty `suffix` always matches.
routine Bytes.ends_with(self: Self, suffix: Self) -> Bool
    block entry()
        sl   : USize = self.count
        fl   : USize = suffix.count
        fits : Bool  = fl.le(sl)
        branch fits
            ? loop(0, fl, sl.sub(fl), self.data, suffix.data)
            : return(false)

    block loop(i: USize, fl: USize, off: USize, sd: @Byte, fd: @Byte)
        done : Bool = i.ge(fl)
        branch done
            ? return(true)
            : continue
        idx : USize = off.add(i)
        a   : U8    = Byte.to<U8>(sd.stride(idx).load())
        b   : U8    = Byte.to<U8>(fd.stride(i).load())
        eq  : Bool  = a.eq(b)
        branch eq
            ? loop(i.add(1), fl, off, sd, fd)
            : return(false)

/// Naive O(n*m) substring search. Returns the byte index of the first match,
/// or Option<USize>.Absent when not found. An empty needle matches at 0.
routine Bytes.find(self: Self, needle: Self) -> Option<USize>
    block entry()
        nlen         : USize = needle.count
        slen         : USize = self.count
        empty_needle : Bool  = nlen.eq(0)
        branch empty_needle
            ? hit(0)
            : check_fits(nlen, slen)

    block check_fits(nlen: USize, slen: USize)
        too_big : Bool = nlen.gt(slen)
        branch too_big
            ? miss()
            : start(nlen, slen)

    block miss()
        r : Option<USize> = .Absent
        return(r)

    block hit(i: USize)
        r : Option<USize> = .Present(i)
        return(r)

    block start(nlen: USize, slen: USize)
        sd   : @Byte = self.data
        nd   : @Byte = needle.data
        last : USize = slen.sub(nlen)
        jump outer(0, last, nlen, sd, nd)

    block outer(i: USize, last: USize, nlen: USize, sd: @Byte, nd: @Byte)
        past : Bool = i.gt(last)
        branch past
            ? miss()
            : inner(i, 0, last, nlen, sd, nd)

    block inner(i: USize, j: USize, last: USize, nlen: USize, sd: @Byte, nd: @Byte)
        done : Bool = j.ge(nlen)
        branch done
            ? hit(i)
            : check(i, j, last, nlen, sd, nd)

    block check(i: USize, j: USize, last: USize, nlen: USize, sd: @Byte, nd: @Byte)
        idx : USize = i.add(j)
        a   : U8    = Byte.to<U8>(sd.stride(idx).load())
        b   : U8    = Byte.to<U8>(nd.stride(j).load())
        eq  : Bool  = a.eq(b)
        branch eq
            ? inner(i, j.add(1), last, nlen, sd, nd)
            : outer(i.add(1), last, nlen, sd, nd)

/// Whether `needle` occurs anywhere in the text, using {Bytes.find}.
/// :param needle: The bytes to look for.
/// :returns: `true` when a match exists. An empty `needle` always matches.
routine Bytes.contains(self: Self, needle: Self) -> Bool
    block entry()
        r     : Option<USize> = self.find(needle)
        found : Bool          = r.is_present()
        return(found)

// -- UTF-8 -----------------------------------------------------------------------

/// Whether the bytes are well-formed UTF-8: no bad lead or continuation byte, overlong form, surrogate, or value past
/// U+10FFFF.
routine Bytes.is_utf8(self: Self) -> Bool
    block entry()
        jump next(0)

    block next(pos: USize)
        done : Bool = pos.ge(self.count)
        branch done
            ? return(true)
            : decode(pos)

    block decode(pos: USize)
        d : Utf8Decoded = utf8_decode(self.data, pos, self.count)
        branch d.ok
            ? next(d.next_pos)
            : return(false)

/// Whether a character can start at byte index: the byte there isn't a UTF-8 continuation byte. True at the end,
/// false past it.
routine Bytes.is_char_boundary(self: Self, index: USize) -> Bool
    block entry()
        at_end : Bool = index.eq(self.count)
        past   : Bool = index.gt(self.count)
        when
            at_end -> return(true)
            past   -> return(false)
            else   -> inside()

    block inside()
        b    : U8   = Byte.to<U8>(self.data.stride(index).load())
        lead : Bool = b.bitand(0xC0).ne(0x80)
        return(lead)

// -- iterators -----------------------------------------------------------------

/// Iterates over the raw bytes as `U8` values.
/// :returns: A {BytesIter} positioned at the first byte.
routine Bytes.bytes(self: Self) -> BytesIter
    block entry()
        iter : BytesIter = BytesIter { str: self.getview(), index: 0 }
        return(iter)

/// Iterates over the characters, decoding UTF-8. A malformed sequence yields U+FFFD.
/// :returns: A {BytesCharsIter} positioned at the first character.
routine Bytes.chars(self: Self) -> BytesCharsIter
    block entry()
        iter : BytesCharsIter = BytesCharsIter { str: self.getview(), index: 0 }
        return(iter)
