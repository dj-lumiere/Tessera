// Tessera stdlib: Bytes
//
// Bytes is text: UTF-8 by convention, and the type of a string literal. It is three fields:
//   data  — @Byte to the first byte (a literal's bytes are also NUL-terminated, but other text isn't)
//   count — USize byte count (not including any terminator)
//   alloc — @Allocator the bytes came from, or null when they're borrowed
//
// Nothing checks that the bytes are UTF-8, but is_utf8 does when it matters. The character operations read a malformed
// sequence as U+FFFD and move on, so they are defined for any bytes.
//
// destruct() gives the bytes back to alloc and leaves the value empty. A null alloc means the text is borrowed and
// destruct() does nothing: a string literal (its bytes are in the program image), Bytes.from_ptr, and every text made
// from other text (slice, getview, the iterators, to<Bytes>() of a List<Byte>) have a null alloc. Text a routine
// allocates (concat, In.read_line, File.read_all, join_path) carries its allocator, and the caller destructs it.
// Copying a Bytes copies the allocator with it, so either copy can give the bytes back: destruct exactly one. ==,
// compare, and hash look at the bytes only, never at alloc.
//
// Slice<Byte> has the same layout and is plain bytes. to<Slice<Byte>>() and Slice<Byte>.to<Bytes>() convert between
// them as borrowed views.

module Standard::Core

import Standard::Alloc

/// Text, UTF-8 by convention: `count` bytes at `data`, and `alloc`, the allocator they came from. A null `alloc` means
/// the bytes are borrowed and `destruct()` does nothing. A string literal is a `Bytes` with a null `alloc`.
record Bytes
conform Equatable<Bytes>, Comparable<Bytes>, Hashable<Bytes>, Destructible<Bytes>
    data  : @Byte
    count : USize
    alloc : @Allocator

// -- construction --------------------------------------------------------------

/// The empty text: a null `data` pointer, a count of 0, and a null allocator.
/// :returns: An empty `Bytes`.
routine Bytes.empty() -> Me
    block entry()
        str : Me = Me { data: null, count: 0, alloc: null }
        return(str)

/// The `count` bytes starting at `data`, borrowed (a null allocator), without copying. Nothing checks that the memory
/// is valid or UTF-8.
/// :param data: A pointer to the first byte.
/// :param count: The number of bytes.
/// :returns: The text, which `destruct()` leaves alone.
routine Bytes.from_ptr(data: @Byte, count: USize) -> Me
    block entry()
        str : Me = Me { data: data, count: count, alloc: null }
        return(str)

/// The same bytes, borrowed: the same data and count with a null allocator, so `destruct()` on it does nothing.
/// :returns: The borrowed view.
routine Bytes.getview(me: Me) -> Me
    block entry()
        view : Me = Me { data: me.data, count: me.count, alloc: null }
        return(view)

/// The same bytes, borrowed: the same data and count with a null allocator, so `destruct()` on it does nothing.
/// :returns: The borrowed view.
routine Bytes.getview(me: @Me) -> Me
    block entry()
        view : Me = me.load().getview()
        return(view)

/// Gives the bytes back to the allocator they came from and leaves the text empty: a null data, a count of 0, and a
/// null allocator. Does nothing when the allocator is null (a literal, or text borrowed from somewhere else).
#track_caller
routine Bytes.destruct(me: @Me) -> Void
    block entry()
        alloc    : @Allocator = me.alloc.load()
        borrowed : Bool       = alloc.is_null()
        branch borrowed
            ? return()
            : continue
        data  : @Byte = me.data.load()
        empty : Bool  = data.is_null()
        branch empty
            ? reset()
            : continue
        deallocate<Byte>(data, alloc)
        jump reset()

    block reset()
        me.data.store(null)
        me.count.store(0)
        me.alloc.store(null)
        return()

// -- predicates ----------------------------------------------------------------

/// The number of bytes of the UTF-8 text, not of characters (count those with `chars()`).
/// :returns: The byte count.
routine Bytes.count(me: Me) -> USize
    block entry()
        count : USize = me.count
        return(count)

/// The number of bytes of the UTF-8 text, not of characters (count those with `chars()`).
/// :returns: The byte count.
routine Bytes.count(me: @Me) -> USize
    block entry()
        count : USize = me.count.load()
        return(count)

/// Whether the text holds no bytes.
/// :returns: `true` when the count is 0.
routine Bytes.is_empty(me: Me) -> Bool
    block entry()
        count  : USize = me.count
        result : Bool  = count.eq(0)
        return(result)

/// Whether the text holds no bytes.
/// :returns: `true` when the count is 0.
routine Bytes.is_empty(me: @Me) -> Bool
    block entry()
        result : Bool = me.count.load().eq(0)
        return(result)

// -- element access ------------------------------------------------------------

/// Reads the byte at `index`.
/// :param index: The zero-based byte position.
/// :returns: The byte as a number from 0 to 255.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index` is not less than the count.
#track_caller
routine Bytes.byte_at(me: Me, index: USize) -> U8
    block entry()
        count     : USize = me.count
        in_bounds : Bool  = index.lt(count)
        branch in_bounds
            ? load()
            : crash_out_of_bounds()

    block load()
        data : @Byte = me.data
        byte : U8    = Byte.to<U8>(data.stride(index).load())
        return(byte)

/// Reads the byte at `index`.
/// :param index: The zero-based byte position.
/// :returns: The byte as a number from 0 to 255.
/// :throws: Crashes with `IndexOutOfBoundsError` when `index` is not less than the count.
#track_caller
routine Bytes.byte_at(me: @Me, index: USize) -> U8
    block entry()
        byte : U8 = me.load().byte_at(index)
        return(byte)

// -- slicing -------------------------------------------------------------------

/// The bytes in [`start`, `end`), borrowed (a null allocator), without copying.
/// :param start: The index of the first byte, included.
/// :param end: The index after the last byte.
/// :returns: The borrowed text.
/// :throws: Crashes with `IndexOutOfBoundsError` when `end` is past the count or `start > end`.
#track_caller
routine Bytes.slice(me: Me, start: USize, end: USize) -> Me
    block entry()
        count       : USize = me.count
        valid_end   : Bool  = end.le(count)
        valid_order : Bool  = start.le(end)
        valid       : Bool  = valid_end.bitand(valid_order)
        branch valid
            ? make()
            : crash_out_of_bounds()

    block make()
        base      : @Byte = me.data
        from      : @Byte = base.stride(start)
        count     : USize = me.count
        slice_len : USize = end.sub(start)
        result    : Me    = Me { data: from, count: slice_len, alloc: null }
        return(result)

/// The bytes in [`start`, `end`), borrowed (a null allocator), without copying.
/// :param start: The index of the first byte, included.
/// :param end: The index after the last byte.
/// :returns: The borrowed text.
/// :throws: Crashes with `IndexOutOfBoundsError` when `end` is past the count or `start > end`.
#track_caller
routine Bytes.slice(me: @Me, start: USize, end: USize) -> Me
    block entry()
        result : Me = me.load().slice(start, end)
        return(result)

// -- heap-allocating operations ------------------------------------------------

/// `a` followed by `b` in new memory from `alloc`, with a NUL after them that the count leaves out. The caller gives
/// it back with `destruct()`.
/// :param a: The first text.
/// :param b: The text that follows it.
/// :param alloc: The allocator for the new bytes, which the result carries.
/// :returns: The joined text.
/// :throws: Crashes with `MemoryAllocationError` when the allocator fails.
#track_caller
routine Bytes.concat(a: Me, b: Me, alloc: @Allocator) -> Me
    shared len_a : USize = a.count
    shared la    : USize = a.count
    shared lb    : USize = b.count
    shared count : USize = la.add(lb)
    shared data  : @Byte = allocate<Byte>(count.add(1), alloc)

    block entry()
        failed : Bool = data.is_null()
        branch failed
            ? crash_allocation()
            : continue
        src_a : @Byte = a.data
        data.copy(src_a, len_a)
        jump copy_b()

    block copy_b()
        dst   : @Byte = data.stride(len_a)
        src_b : @Byte = b.data
        len_b : USize = b.count
        dst.copy(src_b, len_b)
        data.stride(count).store(0x00)
        result : Me = Me { data: data, count: count, alloc: alloc }
        return(result)

// -- equality, ordering, hashing -----------------------------------------------

/// Whether both hold the same bytes: equal counts and equal contents, not the same address or allocator.
/// :param other: The right-hand operand.
/// :returns: `true` when the contents are identical.
routine Bytes.eq(me: Me, other: Me) -> Bool
    shared la : USize = me.count
    shared pa : @Byte = me.data
    shared pb : @Byte = other.data

    block entry()
        lb       : USize = other.count
        same_len : Bool  = la.eq(lb)
        branch same_len
            ? loop(0)
            : return(false)

    block loop(i: USize)
        done : Bool = i.ge(la)
        branch done
            ? return(true)
            : continue
        ba : U8   = Byte.to<U8>(pa.stride(i).load())
        bb : U8   = Byte.to<U8>(pb.stride(i).load())
        eq : Bool = ba.eq(bb)
        branch eq
            ? loop(i.add(1))
            : return(false)

/// Lexicographic byte-wise comparison. Bytes compare as U8, so this matches `memcmp` ordering, and a text that is a
/// prefix of the other comes first. The allocator plays no part.
/// :param other: The right-hand operand.
/// :returns: -1, 0, or 1 as `me` orders before, equal to, or after `other`.
routine Bytes.compare(me: Me, other: Me) -> S32
    shared la        : USize = me.count
    shared lb        : USize = other.count
    shared a_shorter : Bool  = la.le(lb)
    shared min       : USize = a_shorter
        ? la
        : lb
    shared pa : @Byte = me.data
    shared pb : @Byte = other.data

    block entry()
        jump loop(0)

    block loop(i: USize)
        done : Bool = i.ge(min)
        branch done
            ? counts()
            : step(i)

    block step(i: USize)
        ba : U8   = Byte.to<U8>(pa.stride(i).load())
        bb : U8   = Byte.to<U8>(pb.stride(i).load())
        lt : Bool = ba.lt(bb)
        branch lt
            ? return(-1)
            : maybe_gt(i, ba, bb)

    block maybe_gt(i: USize, ba: U8, bb: U8)
        gt : Bool = ba.gt(bb)
        branch gt
            ? return(1)
            : loop(i.add(1))

    block counts()
        lt : Bool = la.lt(lb)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = la.gt(lb)
        branch gt
            ? return(1)
            : return(0)

/// SipHash-2-4 of the byte contents under the process key. The allocator plays no part.
/// :returns: The 64-bit hash.
routine Bytes.hash(me: Me) -> U64
    block entry()
        data : @Byte = me.data
        len  : USize = me.count
        h    : U64   = siphash24(data, len, hash_key())
        return(h)

// -- search --------------------------------------------------------------------

/// Whether the text begins with `prefix`.
/// :param prefix: The bytes to look for at the start.
/// :returns: `true` when `prefix` matches the first bytes. An empty `prefix` always matches.
routine Bytes.has_prefix(me: Me, prefix: Me) -> Bool
    shared pl : USize = prefix.count
    shared sd : @Byte = me.data
    shared pd : @Byte = prefix.data

    block entry()
        sl   : USize = me.count
        fits : Bool  = pl.le(sl)
        branch fits
            ? loop(0)
            : return(false)

    block loop(i: USize)
        done : Bool = i.ge(pl)
        branch done
            ? return(true)
            : continue
        a  : U8   = Byte.to<U8>(sd.stride(i).load())
        b  : U8   = Byte.to<U8>(pd.stride(i).load())
        eq : Bool = a.eq(b)
        branch eq
            ? loop(i.add(1))
            : return(false)

/// Whether the text begins with `prefix`.
/// :param prefix: The bytes to look for at the start.
/// :returns: `true` when `prefix` matches the first bytes. An empty `prefix` always matches.
routine Bytes.has_prefix(me: @Me, prefix: Me) -> Bool
    block entry()
        result : Bool = me.load().has_prefix(prefix)
        return(result)

/// Whether the text ends with `suffix`.
/// :param suffix: The bytes to look for at the end.
/// :returns: `true` when `suffix` matches the last bytes. An empty `suffix` always matches.
routine Bytes.has_suffix(me: Me, suffix: Me) -> Bool
    shared fl : USize = suffix.count
    shared sd : @Byte = me.data
    shared fd : @Byte = suffix.data

    block entry()
        sl   : USize = me.count
        fits : Bool  = fl.le(sl)
        branch fits
            ? loop(0, sl.sub(fl))
            : return(false)

    block loop(i: USize, off: USize)
        done : Bool = i.ge(fl)
        branch done
            ? return(true)
            : continue
        idx : USize = off.add(i)
        a   : U8    = Byte.to<U8>(sd.stride(idx).load())
        b   : U8    = Byte.to<U8>(fd.stride(i).load())
        eq  : Bool  = a.eq(b)
        branch eq
            ? loop(i.add(1), off)
            : return(false)

/// Whether the text ends with `suffix`.
/// :param suffix: The bytes to look for at the end.
/// :returns: `true` when `suffix` matches the last bytes. An empty `suffix` always matches.
routine Bytes.has_suffix(me: @Me, suffix: Me) -> Bool
    block entry()
        result : Bool = me.load().has_suffix(suffix)
        return(result)

/// The byte index of the first match of `needle`, by a naive O(n*m) search.
/// :param needle: The bytes to look for.
/// :returns: The index where the first match starts. An empty `needle` matches at 0.
/// :absent: When `needle` does not occur in the text.
routine Bytes.find(me: Me, needle: Me) -> Option<USize>
    shared nlen : USize = needle.count
    shared slen : USize = me.count
    shared sd   : @Byte = me.data
    shared nd   : @Byte = needle.data

    block entry()
        empty_needle : Bool = nlen.eq(0)
        branch empty_needle
            ? hit(0)
            : check_fits()

    block check_fits()
        too_big : Bool = nlen.gt(slen)
        branch too_big
            ? miss()
            : start()

    block miss()
        r : Option<USize> = .Absent
        return(r)

    block hit(i: USize)
        r : Option<USize> = .Present(i)
        return(r)

    block start()
        last : USize = slen.sub(nlen)
        jump outer(0, last)

    block outer(i: USize, last: USize)
        past : Bool = i.gt(last)
        branch past
            ? miss()
            : inner(i, 0, last)

    block inner(i: USize, j: USize, last: USize)
        done : Bool = j.ge(nlen)
        branch done
            ? hit(i)
            : check(i, j, last)

    block check(i: USize, j: USize, last: USize)
        idx : USize = i.add(j)
        a   : U8    = Byte.to<U8>(sd.stride(idx).load())
        b   : U8    = Byte.to<U8>(nd.stride(j).load())
        eq  : Bool  = a.eq(b)
        branch eq
            ? inner(i, j.add(1), last)
            : outer(i.add(1), last)

/// The byte index of the first match of `needle`.
/// :param needle: The bytes to look for.
/// :returns: The index where the first match starts. An empty `needle` matches at 0.
/// :absent: When `needle` does not occur in the text.
routine Bytes.find(me: @Me, needle: Me) -> Option<USize>
    block entry()
        r : Option<USize> = me.load().find(needle)
        return(r)

/// Whether `needle` occurs anywhere in the text, using {Bytes.find}.
/// :param needle: The bytes to look for.
/// :returns: `true` when a match exists. An empty `needle` always matches.
routine Bytes.has(me: Me, needle: Me) -> Bool
    block entry()
        r     : Option<USize> = me.find(needle)
        found : Bool          = r.is_present()
        return(found)

/// Whether `needle` occurs anywhere in the text, using {Bytes.find}.
/// :param needle: The bytes to look for.
/// :returns: `true` when a match exists. An empty `needle` always matches.
routine Bytes.has(me: @Me, needle: Me) -> Bool
    block entry()
        found : Bool = me.load().has(needle)
        return(found)

// -- UTF-8 -----------------------------------------------------------------------

/// Whether the bytes are well-formed UTF-8: no bad lead or continuation byte, overlong form, surrogate, or value past
/// U+10FFFF.
/// :returns: `true` when the whole text decodes as UTF-8. An empty text is valid.
routine Bytes.is_utf8(me: Me) -> Bool
    block entry()
        jump next(0)

    block next(pos: USize)
        done : Bool = pos.ge(me.count)
        branch done
            ? return(true)
            : decode(pos)

    block decode(pos: USize)
        d : Utf8Decoded = utf8_decode(me.data, pos, me.count)
        branch d.ok
            ? next(d.next_pos)
            : return(false)

/// Whether the bytes are well-formed UTF-8.
/// :returns: `true` when the whole text decodes as UTF-8. An empty text is valid.
routine Bytes.is_utf8(me: @Me) -> Bool
    block entry()
        valid : Bool = me.load().is_utf8()
        return(valid)

/// Whether a character can start at byte `index`: the byte there is not a UTF-8 continuation byte.
/// :param index: The byte position.
/// :returns: `true` when `index` is the count or the byte there is not a continuation byte. `false` past the end.
routine Bytes.is_char_boundary(me: Me, index: USize) -> Bool
    block entry()
        at_end : Bool = index.eq(me.count)
        past   : Bool = index.gt(me.count)
        when
            at_end -> return(true)
            past   -> return(false)
            else   -> inside()

    block inside()
        b    : U8   = Byte.to<U8>(me.data.stride(index).load())
        lead : Bool = b.bitand(0xC0).ne(0x80)
        return(lead)

/// Whether a character can start at byte `index`: the byte there is not a UTF-8 continuation byte.
/// :param index: The byte position.
/// :returns: `true` when `index` is the count or the byte there is not a continuation byte. `false` past the end.
routine Bytes.is_char_boundary(me: @Me, index: USize) -> Bool
    block entry()
        lead : Bool = me.load().is_char_boundary(index)
        return(lead)

// -- iterators -----------------------------------------------------------------

/// Iterates over the raw bytes as `U8` values.
/// :returns: A {BytesIter} positioned at the first byte.
routine Bytes.bytes(me: Me) -> BytesIter
    block entry()
        iter : BytesIter = BytesIter { str: me.getview(), index: 0 }
        return(iter)

/// Iterates over the raw bytes as `U8` values.
/// :returns: A {BytesIter} positioned at the first byte.
routine Bytes.bytes(me: @Me) -> BytesIter
    block entry()
        iter : BytesIter = me.load().bytes()
        return(iter)

/// Iterates over the characters, decoding UTF-8. A malformed sequence yields U+FFFD.
/// :returns: A {BytesCharsIter} positioned at the first character.
routine Bytes.chars(me: Me) -> BytesCharsIter
    block entry()
        iter : BytesCharsIter = BytesCharsIter { str: me.getview(), index: 0 }
        return(iter)

/// Iterates over the characters, decoding UTF-8. A malformed sequence yields U+FFFD.
/// :returns: A {BytesCharsIter} positioned at the first character.
routine Bytes.chars(me: @Me) -> BytesCharsIter
    block entry()
        iter : BytesCharsIter = me.load().chars()
        return(iter)
