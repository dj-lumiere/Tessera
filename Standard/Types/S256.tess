        return(r)

/// Converts `me` to `U8` when the value fits.
/// :returns: The value as a `U8`.
/// :absent: When `me` is negative or above the largest `U8`.
routine S256.to_checked<U8>(me: Me) -> Option<U8>
    block entry()
        fits  : Bool       = me.between(0, 255)
        value : U8         = trunc<Me, U8>(me)
