// Tessera stdlib: S256 — 256-bit signed integer
//
// Maps to LLVM IR i256. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// S256 is a 256-bit signed two's-complement integer. Arithmetic crashes on overflow, with `_checked`, `_wrap`, and `_clamp` forms for the other behaviors.
#llvm("i256")
record S256
conform Equatable<S256>, Comparable<S256>, Hashable<S256>

// -- constants -------------------------------------------------------------------

/// The smallest value a S256 can hold.
preset S256.MIN: S256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
/// The largest value a S256 can hold.
preset S256.MAX: S256 = 57896044618658097711785492504343953926634992332820282019728792003956564819967
/// The width of S256 in bits.
preset S256.BITS: S256 = 256

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine S256.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine S256.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine S256.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine S256.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: `BITS` minus the population count.
routine S256.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is -1.
routine S256.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is -1.
routine S256.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Reverses the order of the bytes of `self`.
/// :returns: The byte-swapped value.
routine S256.swap_bytes(self: Self) -> Self
    block entry()
        r : Self = bswap<Self>(self)
        return(r)

/// Converts from this target's byte order to big-endian, which swaps the bytes.
/// :returns: The value in big-endian byte order.
routine S256.to_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts from big-endian to this target's byte order, which swaps the bytes.
/// :returns: The value in native byte order.
routine S256.from_be(self: Self) -> Self
    block entry()
        r : Self = self.swap_bytes()
        return(r)

/// Converts from this target's byte order to little-endian. The target is little-endian, so this returns `self` unchanged.
/// :returns: The value in little-endian byte order.
routine S256.to_le(self: Self) -> Self
    block entry()
        return(self)

/// Converts from little-endian to this target's byte order. The target is little-endian, so this returns `self` unchanged.
/// :returns: The value in native byte order.
routine S256.from_le(self: Self) -> Self
    block entry()
        return(self)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine S256.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine S256.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine S256.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise NOT: flips every bit of `self`.
/// :returns: The complement, which equals `-self - 1`.
routine S256.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// A shift by BITS or more shifts every bit out: the result is 0 (see Operations, Bitwise and Shifts).
/// The raw shift is poison then, and the select never picks it. A negative amount counts as out of range.
routine S256.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, arithmetic: the sign bit fills in. A shift by BITS or more gives the sign fill (0 or -1).
routine S256.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        shifted  : Self = ashr<Self>(self, n)
        out      : Self = ashr<Self>(self, Self.BITS.sub(1))
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates by n modulo the bit width.
routine S256.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine S256.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// None when n is outside 0 ..< BITS.
routine S256.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Arithmetic shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted right by `n`, with the sign bit filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine S256.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.in_range(0, Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = ashr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts by n modulo the bit width.
routine S256.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 255)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Arithmetic shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of saturating.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted right with the sign bit filling in.
routine S256.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 255)
        r      : Self = ashr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// Crashes on overflow.
#track_caller
routine S256.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = sadd_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in S256.
routine S256.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = sadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Wraps modulo 2^256.
routine S256.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// Saturates at MIN / MAX.
routine S256.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = sadd_sat<Self>(self, other)
        return(r)

/// Crashes on overflow.
#track_caller
routine S256.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = ssub_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in S256.
routine S256.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = ssub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Wraps modulo 2^256.
routine S256.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// Saturates at MIN / MAX.
routine S256.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = ssub_sat<Self>(self, other)
        return(r)

/// Crashes on overflow.
#track_caller
routine S256.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = self.mul_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in S256.
routine S256.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = self.mul_overflows(other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// Wraps modulo 2^256.
routine S256.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// Saturates at MIN / MAX, by the sign of the exact product.
routine S256.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow        : Bool = self.mul_overflows(other)
        negative_result : Bool = self.bitxor(other).lt(0)
        limit           : Self = negative_result
            ? Self.MIN
            : Self.MAX
        product : Self = mul<Self>(self, other)
        r       : Self = overflow
            ? limit
            : product
        return(r)

/// Whether the exact product is outside MIN ..= MAX: its magnitude must fit in
/// 255 bits, or be exactly 2^255 when the product is negative.
routine S256.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        // abs_wrap(MIN) is MIN, whose bits read as unsigned are its magnitude.
        a    : U256 = bitcast<Self, U256>(self.abs_wrap())
        b    : U256 = bitcast<Self, U256>(other.abs_wrap())
        wide : Bool = a.mul_overflows(b)
        branch wide
            ? return(true)
            : continue
        m        : U256 = mul<U256>(a, b)
        negative : Bool = self.bitxor(other).lt(0)
        limit    : U256 = negative
            ? 57896044618658097711785492504343953926634992332820282019728792003956564819968
            : 57896044618658097711785492504343953926634992332820282019728792003956564819967
        r : Bool = m.gt(limit)
        return(r)

// -- sign ------------------------------------------------------------------------

/// Crashes on MIN, whose negation doesn't fit.
#track_caller
routine S256.neg(self: Self) -> Self
    block entry()
        is_min : Bool = self.eq(Self.MIN)
        branch is_min
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(0, self)
        return(r)

/// Negation that reports overflow.
/// :returns: `-self`.
/// :absent: When `self` is `MIN`, whose negation does not fit.
routine S256.neg_checked(self: Self) -> Option<Self>
    block entry()
        fits    : Bool         = self.ne(Self.MIN)
        negated : Self         = sub<Self>(0, self)
        r       : Option<Self> = fits.then_present(negated)
        return(r)

/// MIN.neg_wrap() is MIN.
routine S256.neg_wrap(self: Self) -> Self
    block entry()
        r : Self = sub<Self>(0, self)
        return(r)

/// MIN.neg_clamp() is MAX.
routine S256.neg_clamp(self: Self) -> Self
    block entry()
        r : Self = ssub_sat<Self>(0, self)
        return(r)

/// Crashes on MIN.
routine S256.abs(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? continue
            : return(self)
        r : Self = self.neg()
        return(r)

/// Absolute value that reports overflow.
/// :returns: The magnitude of `self`.
/// :absent: When `self` is `MIN`, whose magnitude does not fit.
routine S256.abs_checked(self: Self) -> Option<Self>
    block entry()
        fits      : Bool         = self.ne(Self.MIN)
        magnitude : Self         = self.abs_wrap()
        r         : Option<Self> = fits.then_present(magnitude)
        return(r)

/// MIN.abs_wrap() is MIN.
routine S256.abs_wrap(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        negated  : Self = sub<Self>(0, self)
        r        : Self = negative
            ? negated
            : self
        return(r)

/// MIN.abs_clamp() is MAX.
routine S256.abs_clamp(self: Self) -> Self
    block entry()
        is_min    : Bool = self.eq(Self.MIN)
        magnitude : Self = self.abs_wrap()
        r         : Self = is_min
            ? Self.MAX
            : magnitude
        return(r)

/// -1, 0, or 1.
routine S256.signum(self: Self) -> Self
    block entry()
        negative     : Bool = self.lt(0)
        positive     : Bool = self.gt(0)
        non_negative : Self = positive
            ? 1
            : 0
        r : Self = negative
            ? -1
            : non_negative
        return(r)

/// Tests whether `self` is below zero.
/// :returns: True when `self < 0`.
routine S256.is_negative(self: Self) -> Bool
    block entry()
        return(self.lt(0))

/// Tests whether `self` is above zero.
/// :returns: True when `self > 0`.
routine S256.is_positive(self: Self) -> Bool
    block entry()
        return(self.gt(0))

// -- division --------------------------------------------------------------------

/// Truncates toward zero. Crashes on a zero divisor and on MIN.div(-1).
#track_caller
routine S256.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = wide_div(self, other)
        return(r)

/// Has the dividend's sign. Crashes on a zero divisor and on MIN.mod(-1).
#track_caller
routine S256.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = wide_rem(self, other)
        return(r)

/// None on a zero divisor and on MIN.div_checked(-1).
routine S256.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Self>.Absent)
            : continue
        r : Self = wide_div(self, other)
        return(Option<Self>.Present(r))

/// Remainder that reports failure instead of crashing. The result has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder of `self` divided by `other`.
/// :absent: On a zero divisor and on `MIN.mod(-1)`.
routine S256.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Self>.Absent)
            : continue
        r : Self = wide_rem(self, other)
        return(Option<Self>.Present(r))

/// MIN.div_wrap(-1) is MIN. Still crashes on a zero divisor.
#track_caller
routine S256.div_wrap(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(Self.MIN)
            : continue
        r : Self = wide_div(self, other)
        return(r)

/// MIN.mod_wrap(-1) is 0. Still crashes on a zero divisor.
#track_caller
routine S256.mod_wrap(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = self.eq(Self.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(0)
            : continue
        r : Self = wide_rem(self, other)
        return(r)

/// Quotient of Euclidean division: the remainder is never negative.
routine S256.div_euclid(self: Self, other: Self) -> Self
    block entry()
        q            : Self = self.div(other)
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0)
        branch positive_divisor
            ? down(q)
            : up(q)

    block down(q: Self)
        r : Self = q.sub(1)
        return(r)

    block up(q: Self)
        r : Self = q.add(1)
        return(r)

/// Remainder of Euclidean division: always in 0 ..< |other|.
routine S256.mod_euclid(self: Self, other: Self) -> Self
    block entry()
        rem          : Self = self.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Self = other.abs_wrap()
        r         : Self = add<Self>(rem, magnitude)
        return(r)

// -- powers ----------------------------------------------------------------------

/// Crashes when the power doesn't fit.
#track_caller
routine S256.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Wrapping power by squaring.
routine S256.pow_wrap(self: Self, exponent: U32) -> Self
    block entry()
        jump loop(self, exponent, 1)

    block loop(base: Self, exponent_left: U32, acc: Self)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc)
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc, base)
        next_acc  : Self = odd
            ? with_base
            : acc
        jump loop(mul<Self>(base, base), exponent_left.shr(1), next_acc)

/// None if any step overflows.
routine S256.pow_checked(self: Self, exponent: U32) -> Option<Self>
    block entry()
        jump loop(self, exponent, 1, false)

    block loop(base: Self, exponent_left: U32, acc: Self, overflow: Bool)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish(acc, overflow)
            : step(base, exponent_left, acc, overflow)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(base: Self, exponent_left: U32, acc: Self, overflow: Bool)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = acc.mul_overflows(base).bitand(odd)
        with_base    : Self = mul<Self>(acc, base)
        next_acc     : Self = odd
            ? with_base
            : acc
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = base.mul_overflows(base).bitand(more)
        any           : Bool = overflow.bitor(acc_overflow).bitor(base_overflow)
        jump loop(mul<Self>(base, base), rest, next_acc, any)

    block finish(acc: Self, overflow: Bool)
        fits : Bool         = overflow.bitnot()
        r    : Option<Self> = fits.then_present(acc)
        return(r)

/// MAX or MIN (by the sign the exact result would have) on overflow.
routine S256.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        odd_exp         : Bool = exponent.bitand(1).ne(0)
        negative_result : Bool = self.lt(0).bitand(odd_exp)
        limit           : Self = negative_result
            ? Self.MIN
            : Self.MAX
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(limit)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `self` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine S256.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Tests whether `self` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine S256.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Signed less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self < other`.
#[external("llvm"), template("{result} = icmp slt i256 {self}, {other}")]
routine S256.lt(self: Self, other: Self) -> Bool

/// Signed less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self <= other`.
#[external("llvm"), template("{result} = icmp sle i256 {self}, {other}")]
routine S256.le(self: Self, other: Self) -> Bool

/// Signed greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self > other`.
#[external("llvm"), template("{result} = icmp sgt i256 {self}, {other}")]
routine S256.gt(self: Self, other: Self) -> Bool

/// Signed greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self >= other`.
#[external("llvm"), template("{result} = icmp sge i256 {self}, {other}")]
routine S256.ge(self: Self, other: Self) -> Bool

/// -1, 0, or 1.
routine S256.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is smaller.
routine S256.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = smin<Self>(self, other)
        return(r)

/// Returns the larger of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is larger.
routine S256.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = smax<Self>(self, other)
        return(r)

/// Crashes if lo > hi.
#track_caller
routine S256.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Self = smax<Self>(self, lo)
        r           : Self = smin<Self>(at_least_lo, hi)
        return(r)

/// self in [lo, hi], both ends included. False when lo > hi.
routine S256.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// self in [lo, end): lo included, end not. False when lo >= end.
routine S256.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// xxh64 of the bits, the same hash for S256 and U256.
routine S256.hash(self: Self) -> U64
    block entry()
        bits : U256 = bitcast<Self, U256>(self)
        h0   : U64  = xxh64(bits.to_wrap<U64>(), 0)
        h1   : U64  = xxh64(bits.shr(64).to_wrap<U64>(), 0)
        h2   : U64  = xxh64(bits.shr(128).to_wrap<U64>(), 0)
        h3   : U64  = xxh64(bits.shr(192).to<U64>(), 0)
        h    : U64  = xxh64_combine2(xxh64_combine2(h0, h1, 0), xxh64_combine2(h2, h3, 0), 0)
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// |self - other|, which always fits in U256.
routine S256.abs_diff(self: Self, other: Self) -> U256
    block entry()
        hi   : Self = smax<Self>(self, other)
        lo   : Self = smin<Self>(self, other)
        diff : Self = sub<Self>(hi, lo)
        r    : U256 = bitcast<Self, U256>(diff)
        return(r)

/// (self + other) / 2 without overflow, rounded toward zero.
routine S256.midpoint(self: Self, other: Self) -> Self
    block entry()
        common       : Self = self.bitand(other)
        half_diff    : Self = self.bitxor(other).shr(1)
        rounded_down : Self = add<Self>(common, half_diff)
        parity       : Self = self.bitxor(other).bitand(1)
        odd_sum      : Bool = parity.ne(0)
        round_up     : Bool = odd_sum.bitand(rounded_down.lt(0))
        up           : Self = add<Self>(rounded_down, 1)
        r            : Self = round_up
            ? up
            : rounded_down
        return(r)

/// floor(log2(self)). Crashes on values <= 0.
#track_caller
routine S256.ilog2(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U256, Self>(bitcast<Self, U256>(self).ilog2())
        return(r)

/// floor(log10(self)). Crashes on values <= 0.
#track_caller
routine S256.ilog10(self: Self) -> Self
    block entry()
        positive : Bool = self.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Self = bitcast<U256, Self>(bitcast<Self, U256>(self).ilog10())
        return(r)

/// floor(sqrt(self)). Crashes on negative values.
#track_caller
routine S256.isqrt(self: Self) -> Self
    block entry()
        negative : Bool = self.lt(0)
        branch negative
            ? crash_numeric_domain()
            : continue
        r : Self = bitcast<U256, Self>(bitcast<Self, U256>(self).isqrt())
        return(r)

// -- conversions -----------------------------------------------------------------

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Crashes when the value doesn't fit in S8.
#track_caller
routine S256.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.between(-128, 127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Converts `self` to S8 when the value fits.
/// :returns: The value as a S8.
/// :absent: When `self` is outside the range of S8.
routine S256.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.between(-128, 127)
        value : S8         = trunc<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Keeps the low 8 bits (modulo 2^8).
routine S256.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = trunc<Self, S8>(self)
        return(r)

/// Saturates at S8's range.
routine S256.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_least : Self = smax<Self>(self, -128)
        at_most  : Self = smin<Self>(at_least, 127)
        r        : S8   = trunc<Self, S8>(at_most)
        return(r)

