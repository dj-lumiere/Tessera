// Tessera stdlib: S256 — 256-bit signed integer
//
// Maps to LLVM IR i256. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// S256 is a 256-bit signed two's-complement integer. Arithmetic crashes on overflow, with `_checked`, `_wrap`, and `_clamp` forms for the other behaviors.
#llvm("i256")
record S256
conform Equatable<S256>, Comparable<S256>, Hashable<S256>

// -- constants -------------------------------------------------------------------

/// The smallest value a S256 can hold.
preset S256.MIN: S256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
/// The largest value a S256 can hold.
preset S256.MAX: S256 = 57896044618658097711785492504343953926634992332820282019728792003956564819967
/// The width of S256 in bits.
preset S256.BITS: S256 = 256

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `me` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine S256.count_ones(me: Me) -> Me
    block entry()
        r : Me = popcount<Me>(me)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `me` is 0.
routine S256.leading_zeros(me: Me) -> Me
    block entry()
        r : Me = clz<Me>(me, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `me` is 0.
routine S256.trailing_zeros(me: Me) -> Me
    block entry()
        r : Me = ctz<Me>(me, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine S256.reverse_bits(me: Me) -> Me
    block entry()
        r : Me = bitreverse<Me>(me)
        return(r)

/// Counts the bits of `me` that are 0.
/// :returns: `BITS` minus the population count.
routine S256.count_zeros(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = popcount<Me>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `me` is -1.
routine S256.leading_ones(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = clz<Me>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `me` is -1.
routine S256.trailing_ones(me: Me) -> Me
    block entry()
        inverted : Me = me.bitnot()
        r        : Me = ctz<Me>(inverted, false)
        return(r)

/// Reverses the order of the bytes of `me`.
/// :returns: The byte-swapped value.
routine S256.swap_bytes(me: Me) -> Me
    block entry()
        r : Me = bswap<Me>(me)
        return(r)

/// Converts from this target's byte order to big-endian, which swaps the bytes.
/// :returns: The value in big-endian byte order.
routine S256.to_be(me: Me) -> Me
    block entry()
        r : Me = me.swap_bytes()
        return(r)

/// Converts from big-endian to this target's byte order, which swaps the bytes.
/// :returns: The value in native byte order.
routine S256.from_be(me: Me) -> Me
    block entry()
        r : Me = me.swap_bytes()
        return(r)

/// Converts from this target's byte order to little-endian. The target is little-endian, so this returns `me` unchanged.
/// :returns: The value in little-endian byte order.
routine S256.to_le(me: Me) -> Me
    block entry()
        return(me)

/// Converts from little-endian to this target's byte order. The target is little-endian, so this returns `me` unchanged.
/// :returns: The value in native byte order.
routine S256.from_le(me: Me) -> Me
    block entry()
        return(me)

/// Bitwise AND of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine S256.bitand(me: Me, other: Me) -> Me
    block entry()
        r : Me = band<Me>(me, other)
        return(r)

/// Bitwise OR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine S256.bitor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bor<Me>(me, other)
        return(r)

/// Bitwise XOR of `me` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine S256.bitxor(me: Me, other: Me) -> Me
    block entry()
        r : Me = bxor<Me>(me, other)
        return(r)

/// Bitwise NOT: flips every bit of `me`.
/// :returns: The complement, which equals `-me - 1`.
routine S256.bitnot(me: Me) -> Me
    block entry()
        r : Me = bnot<Me>(me)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0, and a negative amount counts as out of range too.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted left by `n`, or 0 when `n` is outside `0 ..< BITS`.
/// :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine S256.shl(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.in_range(0, Me.BITS)
        shifted  : Me   = shl<Me>(me, n)
        r        : Me   = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, arithmetic: the sign bit fills in. A shift by `BITS` or more, or by a negative amount, gives the sign fill (0 or -1).
/// :param n: The shift amount in bits.
/// :returns: `me` shifted right by `n`, or the sign fill when `n` is outside `0 ..< BITS`.
routine S256.shr(me: Me, n: Me) -> Me
    block entry()
        in_range : Bool = n.in_range(0, Me.BITS)
        shifted  : Me   = ashr<Me>(me, n)
        out      : Me   = ashr<Me>(me, Me.BITS.sub(1))
        r        : Me   = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine S256.rotl(me: Me, n: Me) -> Me
    block entry()
        r : Me = fshl<Me>(me, me, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine S256.rotr(me: Me, n: Me) -> Me
    block entry()
        r : Me = fshr<Me>(me, me, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted left by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine S256.shl_checked(me: Me, n: Me) -> Option<Me>
    block entry()
        in_range : Bool = n.in_range(0, Me.BITS)
        branch in_range
            ? continue
            : return(Option<Me>.Absent)
        r : Me = shl<Me>(me, n)
        return(Option<Me>.Present(r))

/// Arithmetic shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `me` shifted right by `n`, with the sign bit filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine S256.shr_checked(me: Me, n: Me) -> Option<Me>
    block entry()
        in_range : Bool = n.in_range(0, Me.BITS)
        branch in_range
            ? continue
            : return(Option<Me>.Absent)
        r : Me = ashr<Me>(me, n)
        return(Option<Me>.Present(r))

/// Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted left, with 0 bits filling in.
routine S256.shl_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 255)
        r      : Me = shl<Me>(me, amount)
        return(r)

/// Arithmetic shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of saturating.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `me` shifted right with the sign bit filling in.
routine S256.shr_wrap(me: Me, n: Me) -> Me
    block entry()
        amount : Me = band<Me>(n, 255)
        r      : Me = ashr<Me>(me, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `me` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in `S256`.
#track_caller
routine S256.add(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = sadd_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = add<Me>(me, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in `S256`.
routine S256.add_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = sadd_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = add<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The sum of `me` and `other`, wrapped modulo 2^256.
/// :param other: The value to add.
/// :returns: The low 256 bits of the exact sum.
routine S256.add_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = add<Me>(me, other)
        return(r)

/// The sum of `me` and `other`, saturated at `MIN` / `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MIN` / `MAX` when the exact sum is below / above the range.
routine S256.add_clamp(me: Me, other: Me) -> Me
    block entry()
        r : Me = sadd_sat<Me>(me, other)
        return(r)

/// The difference of `me` and `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `IntegerOverflowError` when the difference does not fit in `S256`.
#track_caller
routine S256.sub(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = ssub_overflows<Me>(me, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = sub<Me>(me, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in `S256`.
routine S256.sub_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = ssub_overflows<Me>(me, other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = sub<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The difference of `me` and `other`, wrapped modulo 2^256.
/// :param other: The value to subtract.
/// :returns: The low 256 bits of the exact difference.
routine S256.sub_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = sub<Me>(me, other)
        return(r)

/// The difference of `me` and `other`, saturated at `MIN` / `MAX`.
/// :param other: The value to subtract.
/// :returns: The difference, or `MIN` / `MAX` when the exact difference is below / above the range.
routine S256.sub_clamp(me: Me, other: Me) -> Me
    block entry()
        r : Me = ssub_sat<Me>(me, other)
        return(r)

/// The product of `me` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in `S256`.
#track_caller
routine S256.mul(me: Me, other: Me) -> Me
    block entry()
        overflow : Bool = me.mul_overflows(other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = mul<Me>(me, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in `S256`.
routine S256.mul_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        overflow : Bool       = me.mul_overflows(other)
        fits     : Bool       = overflow.bitnot()
        result   : Me         = mul<Me>(me, other)
        r        : Option<Me> = fits.then_present(result)
        return(r)

/// The product of `me` and `other`, wrapped modulo 2^256.
/// :param other: The factor to multiply by.
/// :returns: The low 256 bits of the exact product.
routine S256.mul_wrap(me: Me, other: Me) -> Me
    block entry()
        r : Me = mul<Me>(me, other)
        return(r)

/// The product of `me` and `other`, saturated at `MIN` / `MAX` by the sign of the exact product.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MIN` / `MAX` when the exact product does not fit.
routine S256.mul_clamp(me: Me, other: Me) -> Me
    block entry()
        overflow        : Bool = me.mul_overflows(other)
        negative_result : Bool = me.bitxor(other).lt(0)
        limit           : Me   = negative_result
            ? Me.MIN
            : Me.MAX
        product : Me = mul<Me>(me, other)
        r       : Me = overflow
            ? limit
            : product
        return(r)

/// Tests whether the exact product of `me` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in `S256`.
/// :note: The product fits when its magnitude is at most 2^255 - 1, or at most 2^255 when the product is negative.
routine S256.mul_overflows(me: Me, other: Me) -> Bool
    block entry()
        // abs_wrap(MIN) is MIN, whose bits read as unsigned are its magnitude.
        a    : U256 = bitcast<Me, U256>(me.abs_wrap())
        b    : U256 = bitcast<Me, U256>(other.abs_wrap())
        wide : Bool = a.mul_overflows(b)
        branch wide
            ? return(true)
            : continue
        m        : U256 = mul<U256>(a, b)
        negative : Bool = me.bitxor(other).lt(0)
        limit    : U256 = negative
            ? 57896044618658097711785492504343953926634992332820282019728792003956564819968
            : 57896044618658097711785492504343953926634992332820282019728792003956564819967
        r : Bool = m.gt(limit)
        return(r)

// -- sign ------------------------------------------------------------------------

/// The negation of `me`.
/// :returns: `-me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is `MIN`, whose negation does not fit.
#track_caller
routine S256.neg(me: Me) -> Me
    block entry()
        is_min : Bool = me.eq(Me.MIN)
        branch is_min
            ? crash_overflow()
            : continue
        r : Me = sub<Me>(0, me)
        return(r)

/// Negation that reports overflow.
/// :returns: `-me`.
/// :absent: When `me` is `MIN`, whose negation does not fit.
routine S256.neg_checked(me: Me) -> Option<Me>
    block entry()
        fits    : Bool       = me.ne(Me.MIN)
        negated : Me         = sub<Me>(0, me)
        r       : Option<Me> = fits.then_present(negated)
        return(r)

/// The negation of `me`, wrapped modulo 2^256, so `MIN.neg_wrap()` is `MIN`.
/// :returns: `-me`, or `MIN` when `me` is `MIN`.
routine S256.neg_wrap(me: Me) -> Me
    block entry()
        r : Me = sub<Me>(0, me)
        return(r)

/// The negation of `me`, saturated at `MAX`, so `MIN.neg_clamp()` is `MAX`.
/// :returns: `-me`, or `MAX` when `me` is `MIN`.
routine S256.neg_clamp(me: Me) -> Me
    block entry()
        r : Me = ssub_sat<Me>(0, me)
        return(r)

/// The absolute value of `me`.
/// :returns: The magnitude of `me`.
/// :throws: Crashes with `IntegerOverflowError` when `me` is `MIN`, whose magnitude does not fit.
#track_caller
routine S256.abs(me: Me) -> Me
    block entry()
        negative : Bool = me.lt(0)
        branch negative
            ? continue
            : return(me)
        r : Me = me.neg()
        return(r)

/// Absolute value that reports overflow.
/// :returns: The magnitude of `me`.
/// :absent: When `me` is `MIN`, whose magnitude does not fit.
routine S256.abs_checked(me: Me) -> Option<Me>
    block entry()
        fits      : Bool       = me.ne(Me.MIN)
        magnitude : Me         = me.abs_wrap()
        r         : Option<Me> = fits.then_present(magnitude)
        return(r)

/// The absolute value of `me`, wrapped modulo 2^256, so `MIN.abs_wrap()` is `MIN`.
/// :returns: The magnitude of `me`, or `MIN` when `me` is `MIN`.
routine S256.abs_wrap(me: Me) -> Me
    block entry()
        negative : Bool = me.lt(0)
        negated  : Me   = sub<Me>(0, me)
        r        : Me   = negative
            ? negated
            : me
        return(r)

/// The absolute value of `me`, saturated at `MAX`, so `MIN.abs_clamp()` is `MAX`.
/// :returns: The magnitude of `me`, or `MAX` when `me` is `MIN`.
routine S256.abs_clamp(me: Me) -> Me
    block entry()
        is_min    : Bool = me.eq(Me.MIN)
        magnitude : Me   = me.abs_wrap()
        r         : Me   = is_min
            ? Me.MAX
            : magnitude
        return(r)

/// The sign of `me`.
/// :returns: -1 when `me` is negative, 0 when it is 0, and 1 when it is positive.
routine S256.signum(me: Me) -> Me
    block entry()
        negative     : Bool = me.lt(0)
        positive     : Bool = me.gt(0)
        non_negative : Me   = positive
            ? 1
            : 0
        r : Me = negative
            ? -1
            : non_negative
        return(r)

/// Tests whether `me` is below zero.
/// :returns: True when `me < 0`.
routine S256.is_negative(me: Me) -> Bool
    block entry()
        return(me.lt(0))

/// Tests whether `me` is above zero.
/// :returns: True when `me > 0`.
routine S256.is_positive(me: Me) -> Bool
    block entry()
        return(me.gt(0))

// -- division --------------------------------------------------------------------

/// The quotient of `me` divided by `other`, truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.div(-1)`.
#track_caller
routine S256.div(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = me.eq(Me.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = wide_div(me, other)
        return(r)

/// The remainder of `me` divided by `other`. It has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder, with the sign of `me`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.mod(-1)`.
#track_caller
routine S256.mod(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = me.eq(Me.MIN).bitand(other.eq(-1))
        branch overflow
            ? crash_overflow()
            : continue
        r : Me = wide_rem(me, other)
        return(r)

/// Division that reports failure instead of crashing. The quotient is truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient of `me` divided by `other`.
/// :absent: On a zero divisor and on `MIN.div_checked(-1)`.
routine S256.div_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = me.eq(Me.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Me>.Absent)
            : continue
        r : Me = wide_div(me, other)
        return(Option<Me>.Present(r))

/// Remainder that reports failure instead of crashing. The result has the dividend's sign.
/// :param other: The divisor.
/// :returns: The remainder of `me` divided by `other`.
/// :absent: On a zero divisor and on `MIN.mod_checked(-1)`.
routine S256.mod_checked(me: Me, other: Me) -> Option<Me>
    block entry()
        by_zero  : Bool = other.eq(0)
        overflow : Bool = me.eq(Me.MIN).bitand(other.eq(-1))
        fails    : Bool = by_zero.bitor(overflow)
        branch fails
            ? return(Option<Me>.Absent)
            : continue
        r : Me = wide_rem(me, other)
        return(Option<Me>.Present(r))

/// The quotient of `me` divided by `other`, truncated toward zero. `MIN.div_wrap(-1)` wraps to `MIN`.
/// :param other: The divisor.
/// :returns: The quotient, or `MIN` for `MIN.div_wrap(-1)`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine S256.div_wrap(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = me.eq(Me.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(Me.MIN)
            : continue
        r : Me = wide_div(me, other)
        return(r)

/// The remainder of `me` divided by `other`, with the dividend's sign. `MIN.mod_wrap(-1)` is 0.
/// :param other: The divisor.
/// :returns: The remainder, or 0 for `MIN.mod_wrap(-1)`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine S256.mod_wrap(me: Me, other: Me) -> Me
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        overflow : Bool = me.eq(Me.MIN).bitand(other.eq(-1))
        branch overflow
            ? return(0)
            : continue
        r : Me = wide_rem(me, other)
        return(r)

/// The quotient of Euclidean division, chosen so the remainder is never negative.
/// :param other: The divisor.
/// :returns: The quotient `q` for which `me - q * other` is in `0 ..< |other|`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.div_euclid(-1)`.
#track_caller
routine S256.div_euclid(me: Me, other: Me) -> Me
    shared q : Me = me.div(other)

    block entry()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(q)
        positive_divisor : Bool = other.gt(0)
        branch positive_divisor
            ? down()
            : up()

    block down()
        r : Me = q.sub(1)
        return(r)

    block up()
        r : Me = q.add(1)
        return(r)

/// The remainder of Euclidean division, always in `0 ..< |other|`.
/// :param other: The divisor.
/// :returns: The remainder, never negative.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` on `MIN.mod_euclid(-1)`.
#track_caller
routine S256.mod_euclid(me: Me, other: Me) -> Me
    block entry()
        rem          : Me   = me.mod(other)
        rem_negative : Bool = rem.lt(0)
        branch rem_negative
            ? continue
            : return(rem)
        magnitude : Me = other.abs_wrap()
        r         : Me = add<Me>(rem, magnitude)
        return(r)

// -- powers ----------------------------------------------------------------------

/// Raises `me` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :throws: Crashes with `IntegerOverflowError` when the exact power does not fit in `S256`.
#track_caller
routine S256.pow(me: Me, exponent: U32) -> Me
    block entry()
        r : Option<Me> = me.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `me` to the power `exponent` by squaring, wrapping modulo 2^256.
/// :param exponent: The power to raise to.
/// :returns: The low 256 bits of the exact power.
routine S256.pow_wrap(me: Me, exponent: U32) -> Me
    shared base : @Me <- me
    shared acc  : @Me <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Me   = mul<Me>(acc.load(), base.load())
        next_acc  : Me   = odd
            ? with_base
            : acc.load()
        next_acc2 : Me = next_acc
        next_base : Me = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Power that reports overflow.
/// :param exponent: The power to raise to.
/// :returns: `me` to the power `exponent`.
/// :absent: When the exact power does not fit in `S256`.
routine S256.pow_checked(me: Me, exponent: U32) -> Option<Me>
    shared base     : @Me   <- me
    shared acc      : @Me   <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = acc.load().mul_overflows(base.load()).bitand(odd)
        with_base    : Me   = mul<Me>(acc.load(), base.load())
        next_acc     : Me   = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = base.load().mul_overflows(base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Me   = next_acc
        next_base     : Me   = mul<Me>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool       = overflow.load().bitnot()
        r    : Option<Me> = fits.then_present(acc.load())
        return(r)

/// Raises `me` to the power `exponent`, saturated at `MIN` or `MAX` by the sign the exact power would have.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MIN` / `MAX` when the exact power does not fit.
routine S256.pow_clamp(me: Me, exponent: U32) -> Me
    block entry()
        odd_exp         : Bool = exponent.bitand(1).ne(0)
        negative_result : Bool = me.lt(0).bitand(odd_exp)
        limit           : Me   = negative_result
            ? Me.MIN
            : Me.MAX
        checked : Option<Me> = me.pow_checked(exponent)
        r       : Me         = checked.unwrap_or(limit)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `me` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine S256.eq(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ieq<Me>(me, other)
        return(r)

/// Tests whether `me` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine S256.ne(me: Me, other: Me) -> Bool
    block entry()
        r : Bool = ine<Me>(me, other)
        return(r)

/// Signed less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me < other`.
#[external("llvm"), template("{result} = icmp slt i256 {me}, {other}")]
routine S256.lt(me: Me, other: Me) -> Bool

/// Signed less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me <= other`.
#[external("llvm"), template("{result} = icmp sle i256 {me}, {other}")]
routine S256.le(me: Me, other: Me) -> Bool

/// Signed greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `me > other`.
#[external("llvm"), template("{result} = icmp sgt i256 {me}, {other}")]
routine S256.gt(me: Me, other: Me) -> Bool

/// Signed greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `me >= other`.
#[external("llvm"), template("{result} = icmp sge i256 {me}, {other}")]
routine S256.ge(me: Me, other: Me) -> Bool

/// Compares `me` with `other` by signed order.
/// :param other: The value to compare with.
/// :returns: -1 when `me < other`, 0 when they are equal, and 1 when `me > other`.
routine S256.compare(me: Me, other: Me) -> S32
    block entry()
        lt : Bool = me.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = me.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `me` or `other`, whichever is smaller.
routine S256.min(me: Me, other: Me) -> Me
    block entry()
        r : Me = smin<Me>(me, other)
        return(r)

/// Returns the larger of two values by signed comparison.
/// :param other: The value to compare with.
/// :returns: `me` or `other`, whichever is larger.
routine S256.max(me: Me, other: Me) -> Me
    block entry()
        r : Me = smax<Me>(me, other)
        return(r)

/// Limits `me` to the range from `lo` to `hi`, both ends included.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine S256.clamp(me: Me, lo: Me, hi: Me) -> Me
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Me = smax<Me>(me, lo)
        r           : Me = smin<Me>(at_least_lo, hi)
        return(r)

/// Tests whether `me` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= me <= hi`.
routine S256.between(me: Me, lo: Me, hi: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.le(hi))
        return(r)

/// Tests whether `me` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= me < end`.
routine S256.in_range(me: Me, lo: Me, end: Me) -> Bool
    block entry()
        r : Bool = me.ge(lo).bitand(me.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the 32 bytes under the process key, the same hash for `S256` and `U256`.
/// :returns: The 64-bit hash of `me`.
routine S256.hash(me: Me) -> U64
    block entry()
        claim bits : @U256 <- bitcast<Me, U256>(me)
        h : U64 = siphash24(bits.to<@Byte>(), 32, hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `me` and `other`, `|me - other|`, which always fits in `U256`.
/// :param other: The value to measure from.
/// :returns: `|me - other|` as a `U256`.
routine S256.abs_diff(me: Me, other: Me) -> U256
    block entry()
        hi   : Me   = smax<Me>(me, other)
        lo   : Me   = smin<Me>(me, other)
        diff : Me   = sub<Me>(hi, lo)
        r    : U256 = bitcast<Me, U256>(diff)
        return(r)

/// The average of `me` and `other`, rounded toward zero, computed without overflow.
/// :param other: The other value.
/// :returns: `(me + other) / 2`, rounded toward zero.
routine S256.midpoint(me: Me, other: Me) -> Me
    block entry()
        common       : Me   = me.bitand(other)
        half_diff    : Me   = me.bitxor(other).shr(1)
        rounded_down : Me   = add<Me>(common, half_diff)
        parity       : Me   = me.bitxor(other).bitand(1)
        odd_sum      : Bool = parity.ne(0)
        round_up     : Bool = odd_sum.bitand(rounded_down.lt(0))
        up           : Me   = add<Me>(rounded_down, 1)
        r            : Me   = round_up
            ? up
            : rounded_down
        return(r)

/// The base-2 logarithm of `me`, rounded down.
/// :returns: `floor(log2(me))`.
/// :throws: Crashes with `NumericDomainError` when `me <= 0`.
#track_caller
routine S256.ilog2(me: Me) -> Me
    block entry()
        positive : Bool = me.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Me = bitcast<U256, Me>(bitcast<Me, U256>(me).ilog2())
        return(r)

/// The base-10 logarithm of `me`, rounded down.
/// :returns: `floor(log10(me))`.
/// :throws: Crashes with `NumericDomainError` when `me <= 0`.
#track_caller
routine S256.ilog10(me: Me) -> Me
    block entry()
        positive : Bool = me.gt(0)
        branch positive
            ? continue
            : crash_numeric_domain()
        r : Me = bitcast<U256, Me>(bitcast<Me, U256>(me).ilog10())
        return(r)

/// The integer square root of `me`, rounded down.
/// :returns: `floor(sqrt(me))`.
/// :throws: Crashes with `NumericDomainError` when `me` is negative.
#track_caller
routine S256.isqrt(me: Me) -> Me
    block entry()
        negative : Bool = me.lt(0)
        branch negative
            ? crash_numeric_domain()
            : continue
        r : Me = bitcast<U256, Me>(bitcast<Me, U256>(me).isqrt())
        return(r)

// -- conversions -----------------------------------------------------------------

/// Converts `me` to `S8`.
/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// :returns: The same numeric value as an `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine S256.to<S8>(me: Me) -> S8
    block entry()
        fits : Bool = me.between(-128, 127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = trunc<Me, S8>(me)
        return(r)

/// Converts `me` to `S8` when the value fits.
/// :returns: The value as an `S8`.
/// :absent: When `me` is outside the range of `S8`.
routine S256.to_checked<S8>(me: Me) -> Option<S8>
    block entry()
        fits  : Bool       = me.between(-128, 127)
        value : S8         = trunc<Me, S8>(me)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `me` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: `me` modulo 2^8, as an `S8`.
routine S256.to_wrap<S8>(me: Me) -> S8
    block entry()
        r : S8 = trunc<Me, S8>(me)
        return(r)

/// Converts `me` to `S8`, saturating at `S8`'s range.
/// :returns: `me`, or the nearest end of `S8`'s range when it does not fit.
routine S256.to_clamp<S8>(me: Me) -> S8
    block entry()
        at_least : Me = smax<Me>(me, -128)
        at_most  : Me = smin<Me>(at_least, 127)
        r        : S8 = trunc<Me, S8>(at_most)
        return(r)

/// Converts `me` to `S16`.
/// :returns: The same numeric value as an `S16`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S16`.
#track_caller
routine S256.to<S16>(me: Me) -> S16
    block entry()
        fits : Bool = me.between(-32768, 32767)
        branch fits
            ? continue
            : crash_overflow()
        r : S16 = trunc<Me, S16>(me)
        return(r)

/// Converts `me` to `S16` when the value fits.
/// :returns: The value as an `S16`.
/// :absent: When `me` is outside the range of `S16`.
routine S256.to_checked<S16>(me: Me) -> Option<S16>
    block entry()
        fits  : Bool        = me.between(-32768, 32767)
        value : S16         = trunc<Me, S16>(me)
        r     : Option<S16> = fits.then_present(value)
        return(r)

/// Converts `me` to `S16`, keeping the low 16 bits (modulo 2^16).
/// :returns: `me` modulo 2^16, as an `S16`.
routine S256.to_wrap<S16>(me: Me) -> S16
    block entry()
        r : S16 = trunc<Me, S16>(me)
        return(r)

/// Converts `me` to `S16`, saturating at `S16`'s range.
/// :returns: `me`, or the nearest end of `S16`'s range when it does not fit.
routine S256.to_clamp<S16>(me: Me) -> S16
    block entry()
        at_least : Me  = smax<Me>(me, -32768)
        at_most  : Me  = smin<Me>(at_least, 32767)
        r        : S16 = trunc<Me, S16>(at_most)
        return(r)

