    block entry()
        r : U64 = trunc<Self, U64>(self)
        return(r)

/// Converts `self` to U64, saturating at U64's range.
/// :returns: `self`, or the nearest end of U64's range when it does not fit.
routine S256.to_clamp<U64>(self: Self) -> U64
    block entry()
        at_least : Self = smax<Self>(self, 0)
        at_most  : Self = smin<Self>(at_least, 18446744073709551615)
        r        : U64  = trunc<Self, U64>(at_most)
        return(r)

/// Converts `self` to U128.
/// :returns: The same numeric value as a U128.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in U128.
#track_caller
routine S256.to<U128>(self: Self) -> U128
    block entry()
        fits : Bool = self.between(0, 340282366920938463463374607431768211455)
        branch fits
            ? continue
            : crash_overflow()
        r : U128 = trunc<Self, U128>(self)
        return(r)

/// Converts `self` to U128 when the value fits.
/// :returns: The value as a U128.
/// :absent: When `self` is negative or above the largest U128.
routine S256.to_checked<U128>(self: Self) -> Option<U128>
    block entry()
        fits  : Bool         = self.between(0, 340282366920938463463374607431768211455)
        value : U128         = trunc<Self, U128>(self)
        r     : Option<U128> = fits.then_present(value)
        return(r)

/// Keeps the low 128 bits (modulo 2^128).
/// :returns: The low 128 bits of `self`, read as a U128.
routine S256.to_wrap<U128>(self: Self) -> U128
    block entry()
        r : U128 = trunc<Self, U128>(self)
        return(r)

/// Converts `self` to U128, saturating at U128's range.
/// :returns: `self`, or the nearest end of U128's range when it does not fit.
routine S256.to_clamp<U128>(self: Self) -> U128
    block entry()
        at_least : Self = smax<Self>(self, 0)
        at_most  : Self = smin<Self>(at_least, 340282366920938463463374607431768211455)
        r        : U128 = trunc<Self, U128>(at_most)
        return(r)

/// Converts `self` to U256.
/// :returns: The same numeric value as a U256.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in U256.
#track_caller
routine S256.to<U256>(self: Self) -> U256
    block entry()
        fits : Bool = self.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U256 = bitcast<Self, U256>(self)
        return(r)

/// Converts `self` to U256 when the value fits.
/// :returns: The value as a U256.
/// :absent: When `self` is negative.
routine S256.to_checked<U256>(self: Self) -> Option<U256>
    block entry()
        fits  : Bool         = self.ge(0)
        value : U256         = bitcast<Self, U256>(self)
        r     : Option<U256> = fits.then_present(value)
        return(r)

/// Keeps the low 256 bits (modulo 2^256).
/// :returns: The low 256 bits of `self`, read as a U256.
routine S256.to_wrap<U256>(self: Self) -> U256
    block entry()
        r : U256 = bitcast<Self, U256>(self)
        return(r)

/// Converts `self` to U256, saturating at U256's range.
/// :returns: `self`, or the nearest end of U256's range when it does not fit.
routine S256.to_clamp<U256>(self: Self) -> U256
    block entry()
        at_least : Self = smax<Self>(self, 0)
        r        : U256 = bitcast<Self, U256>(at_least)
        return(r)
