            ? continue
            : crash_overflow()
        r : U64 = trunc<Me, U64>(me)
        return(r)

/// Converts `me` to `U64` when the value fits.
/// :returns: The value as a `U64`.
/// :absent: When `me` is negative or above the largest `U64`.
routine S256.to_checked<U64>(me: Me) -> Option<U64>
    block entry()
        fits  : Bool        = me.between(0, 18446744073709551615)
        value : U64         = trunc<Me, U64>(me)
        r     : Option<U64> = fits.then_present(value)
        return(r)

/// Converts `me` to `U64`, keeping the low 64 bits (modulo 2^64).
/// :returns: `me` modulo 2^64, as a `U64`.
routine S256.to_wrap<U64>(me: Me) -> U64
    block entry()
        r : U64 = trunc<Me, U64>(me)
        return(r)

/// Converts `me` to `U64`, saturating at `U64`'s range.
/// :returns: `me`, or the nearest end of `U64`'s range when it does not fit.
routine S256.to_clamp<U64>(me: Me) -> U64
    block entry()
        at_least : Me  = smax<Me>(me, 0)
        at_most  : Me  = smin<Me>(at_least, 18446744073709551615)
        r        : U64 = trunc<Me, U64>(at_most)
        return(r)

/// Converts `me` to `U128`.
/// :returns: The same numeric value as a `U128`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U128`.
#track_caller
routine S256.to<U128>(me: Me) -> U128
    block entry()
        fits : Bool = me.between(0, 340282366920938463463374607431768211455)
        branch fits
            ? continue
            : crash_overflow()
        r : U128 = trunc<Me, U128>(me)
        return(r)

/// Converts `me` to `U128` when the value fits.
/// :returns: The value as a `U128`.
/// :absent: When `me` is negative or above the largest `U128`.
routine S256.to_checked<U128>(me: Me) -> Option<U128>
    block entry()
        fits  : Bool         = me.between(0, 340282366920938463463374607431768211455)
        value : U128         = trunc<Me, U128>(me)
        r     : Option<U128> = fits.then_present(value)
        return(r)

/// Converts `me` to `U128`, keeping the low 128 bits (modulo 2^128).
/// :returns: `me` modulo 2^128, as a `U128`.
routine S256.to_wrap<U128>(me: Me) -> U128
    block entry()
        r : U128 = trunc<Me, U128>(me)
        return(r)

/// Converts `me` to `U128`, saturating at `U128`'s range.
/// :returns: `me`, or the nearest end of `U128`'s range when it does not fit.
routine S256.to_clamp<U128>(me: Me) -> U128
    block entry()
        at_least : Me   = smax<Me>(me, 0)
        at_most  : Me   = smin<Me>(at_least, 340282366920938463463374607431768211455)
        r        : U128 = trunc<Me, U128>(at_most)
        return(r)

/// Converts `me` to `U256`.
/// :returns: The same numeric value as a `U256`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `U256`.
#track_caller
routine S256.to<U256>(me: Me) -> U256
    block entry()
        fits : Bool = me.ge(0)
        branch fits
            ? continue
            : crash_overflow()
        r : U256 = bitcast<Me, U256>(me)
        return(r)

/// Converts `me` to `U256` when the value fits.
/// :returns: The value as a `U256`.
/// :absent: When `me` is negative.
routine S256.to_checked<U256>(me: Me) -> Option<U256>
    block entry()
        fits  : Bool         = me.ge(0)
        value : U256         = bitcast<Me, U256>(me)
        r     : Option<U256> = fits.then_present(value)
        return(r)

/// Converts `me` to `U256`, keeping the low 256 bits (modulo 2^256).
/// :returns: `me` modulo 2^256, as a `U256`.
routine S256.to_wrap<U256>(me: Me) -> U256
    block entry()
        r : U256 = bitcast<Me, U256>(me)
        return(r)

/// Converts `me` to `U256`, saturating at `U256`'s range.
/// :returns: `me`, or the nearest end of `U256`'s range when it does not fit.
routine S256.to_clamp<U256>(me: Me) -> U256
    block entry()
        at_least : Me   = smax<Me>(me, 0)
        r        : U256 = bitcast<Me, U256>(at_least)
        return(r)
