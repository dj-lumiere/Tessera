// Tessera stdlib: tuples
//
// (A, B) is Tuple2<A, B>, up to (A, B, C, D), Tuple4. A tuple is a record whose
// fields are item0, item1, and so on. `(a, b)` makes one, and it's the only value a
// binding takes apart: `q, r = div_rem(a, b)`. It's for values that are just
// several values. A result whose parts mean something is a record with names.
//
// Every tuple is Equatable, Hashable, and Comparable (item by item, in order) when its items
// are, and Representable / Diagnosable writes it as (1, "a").

module Standard::Core

import Standard::Format

// -- Tuple2 -------------------------------------------------------------------

/// A tuple of 2 values, written `(a, b)`, with fields `item0, item1`. It is Equatable, Hashable, and Comparable item by item when its items are, and it can be taken apart by a binding.
/// :typeparam TItem0: The type of item0.
/// :typeparam TItem1: The type of item1.
#derive(Equatable, Hashable, Comparable)
record Tuple2<TItem0, TItem1>
conform Representable<Tuple2<TItem0, TItem1>> when TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>
conform Diagnosable<Tuple2<TItem0, TItem1>>   when TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>
require TItem0: typename, TItem1: typename
    item0 : TItem0
    item1 : TItem1

/// Writes the items, each diagnosed (strings quoted), in parentheses: (1, "a").
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Tuple2<TItem0, TItem1>.represent_into<TWriter>(self: Self, out: @TWriter) -> Void
require TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TWriter: typename, Writer<TWriter>
    block entry()
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ")")
        return()

/// Writes the items as Tessera source, each diagnosed, in parentheses: (1, "a").
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Tuple2<TItem0, TItem1>.diagnose_into<TWriter>(self: Self, out: @TWriter) -> Void
require TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TWriter: typename, Writer<TWriter>
    block entry()
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ")")
        return()

// -- Tuple3 -------------------------------------------------------------------

/// A tuple of 3 values, written `(a, b, c)`, with fields `item0, item1, item2`. It is Equatable, Hashable, and Comparable item by item when its items are, and it can be taken apart by a binding.
/// :typeparam TItem0: The type of item0.
/// :typeparam TItem1: The type of item1.
/// :typeparam TItem2: The type of item2.
#derive(Equatable, Hashable, Comparable)
record Tuple3<TItem0, TItem1, TItem2>
conform Representable<Tuple3<TItem0, TItem1, TItem2>> when TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>
conform Diagnosable<Tuple3<TItem0, TItem1, TItem2>>   when TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>
require TItem0: typename, TItem1: typename, TItem2: typename
    item0 : TItem0
    item1 : TItem1
    item2 : TItem2

/// Writes the items, each diagnosed (strings quoted), in parentheses: (1, "a").
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Tuple3<TItem0, TItem1, TItem2>.represent_into<TWriter>(self: Self, out: @TWriter) -> Void
require TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>, TWriter: typename, Writer<TWriter>
    block entry()
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ")")
        return()

/// Writes the items as Tessera source, each diagnosed, in parentheses: (1, "a").
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Tuple3<TItem0, TItem1, TItem2>.diagnose_into<TWriter>(self: Self, out: @TWriter) -> Void
require TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>, TWriter: typename, Writer<TWriter>
    block entry()
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ")")
        return()

// -- Tuple4 -------------------------------------------------------------------

/// A tuple of 4 values, written `(a, b, c, d)`, with fields `item0, item1, item2, item3`. It is Equatable, Hashable, and Comparable item by item when its items are, and it can be taken apart by a binding.
/// :typeparam TItem0: The type of item0.
/// :typeparam TItem1: The type of item1.
/// :typeparam TItem2: The type of item2.
/// :typeparam TItem3: The type of item3.
#derive(Equatable, Hashable, Comparable)
record Tuple4<TItem0, TItem1, TItem2, TItem3>
conform Representable<Tuple4<TItem0, TItem1, TItem2, TItem3>> when TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>, TItem3: typename, Diagnosable<TItem3>
conform Diagnosable<Tuple4<TItem0, TItem1, TItem2, TItem3>>   when TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>, TItem3: typename, Diagnosable<TItem3>
require TItem0: typename, TItem1: typename, TItem2: typename, TItem3: typename
    item0 : TItem0
    item1 : TItem1
    item2 : TItem2
    item3 : TItem3

/// Writes the items, each diagnosed (strings quoted), in parentheses: (1, "a").
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Tuple4<TItem0, TItem1, TItem2, TItem3>.represent_into<TWriter>(self: Self,
    out: @TWriter) -> Void
require TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>, TItem3: typename, Diagnosable<TItem3>, TWriter: typename, Writer<TWriter>
    block entry()
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ", ")
        self.item3.diagnose_into(out)
        write_str(out, ")")
        return()

/// Writes the items as Tessera source, each diagnosed, in parentheses: (1, "a").
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Tuple4<TItem0, TItem1, TItem2, TItem3>.diagnose_into<TWriter>(self: Self,
    out: @TWriter) -> Void
require TItem0: typename, Diagnosable<TItem0>, TItem1: typename, Diagnosable<TItem1>, TItem2: typename, Diagnosable<TItem2>, TItem3: typename, Diagnosable<TItem3>, TWriter: typename, Writer<TWriter>
    block entry()
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ", ")
        self.item3.diagnose_into(out)
        write_str(out, ")")
        return()
