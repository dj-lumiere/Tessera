// Tessera stdlib: tuples
//
// (A, B) is Tuple2<A, B>, up to (A, B, C, D), Tuple4. A tuple is a record whose
// fields are item0, item1, ...; `(a, b)` makes one, and it's the only value a
// binding takes apart: `q, r = div_rem(a, b)`. It's for values that are just
// several values; a result whose parts mean something is a record with names.
//
// Every tuple is Equal, Hash, and Compare (item by item, in order) when its items
// are, and Represent / Diagnose writes it as (1, "a").

module Standard::Core

import Standard::Format

// -- Tuple2 -------------------------------------------------------------------

/// A tuple of 2 values, written `(a, b)`, with fields `item0, item1`. It is Equal, Hash, and Compare item by item when its items are, and it can be taken apart by a binding.
/// :typeparam T0: The type of item0.
/// :typeparam T1: The type of item1.
#derive(Equal, Hash, Compare)
record Tuple2<T0, T1>
conform Represent<Tuple2<T0, T1>> when T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>
conform Diagnose<Tuple2<T0, T1>>  when T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>
require T0: typename, T1: typename
    item0 : T0
    item1 : T1

/// The items, each diagnosed (strings quoted): (1, "a").
routine Tuple2<T0, T1>.represent_into<W>(self: Self, out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, W: typename, Writer<W>
    block entry():
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ")")
        return()

/// The items as Tessera source: (1, "a").
routine Tuple2<T0, T1>.diagnose_into<W>(self: Self, out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, W: typename, Writer<W>
    block entry():
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ")")
        return()

// -- Tuple3 -------------------------------------------------------------------

/// A tuple of 3 values, written `(a, b, c)`, with fields `item0, item1, item2`. It is Equal, Hash, and Compare item by item when its items are, and it can be taken apart by a binding.
/// :typeparam T0: The type of item0.
/// :typeparam T1: The type of item1.
/// :typeparam T2: The type of item2.
#derive(Equal, Hash, Compare)
record Tuple3<T0, T1, T2>
conform Represent<Tuple3<T0, T1, T2>> when T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>
conform Diagnose<Tuple3<T0, T1, T2>>  when T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>
require T0: typename, T1: typename, T2: typename
    item0 : T0
    item1 : T1
    item2 : T2

/// The items, each diagnosed (strings quoted): (1, "a").
routine Tuple3<T0, T1, T2>.represent_into<W>(self: Self, out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, W: typename, Writer<W>
    block entry():
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ")")
        return()

/// The items as Tessera source: (1, "a").
routine Tuple3<T0, T1, T2>.diagnose_into<W>(self: Self, out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, W: typename, Writer<W>
    block entry():
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ")")
        return()

// -- Tuple4 -------------------------------------------------------------------

/// A tuple of 4 values, written `(a, b, c, d)`, with fields `item0, item1, item2, item3`. It is Equal, Hash, and Compare item by item when its items are, and it can be taken apart by a binding.
/// :typeparam T0: The type of item0.
/// :typeparam T1: The type of item1.
/// :typeparam T2: The type of item2.
/// :typeparam T3: The type of item3.
#derive(Equal, Hash, Compare)
record Tuple4<T0, T1, T2, T3>
conform Represent<Tuple4<T0, T1, T2, T3>> when T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, T3: typename, Diagnose<T3>
conform Diagnose<Tuple4<T0, T1, T2, T3>>  when T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, T3: typename, Diagnose<T3>
require T0: typename, T1: typename, T2: typename, T3: typename
    item0 : T0
    item1 : T1
    item2 : T2
    item3 : T3

/// The items, each diagnosed (strings quoted): (1, "a").
routine Tuple4<T0, T1, T2, T3>.represent_into<W>(self: Self, out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, T3: typename, Diagnose<T3>, W: typename, Writer<W>
    block entry():
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ", ")
        self.item3.diagnose_into(out)
        write_str(out, ")")
        return()

/// The items as Tessera source: (1, "a").
routine Tuple4<T0, T1, T2, T3>.diagnose_into<W>(self: Self, out: @W) -> Void
require T0: typename, Diagnose<T0>, T1: typename, Diagnose<T1>, T2: typename, Diagnose<T2>, T3: typename, Diagnose<T3>, W: typename, Writer<W>
    block entry():
        write_str(out, "(")
        self.item0.diagnose_into(out)
        write_str(out, ", ")
        self.item1.diagnose_into(out)
        write_str(out, ", ")
        self.item2.diagnose_into(out)
        write_str(out, ", ")
        self.item3.diagnose_into(out)
        write_str(out, ")")
        return()
