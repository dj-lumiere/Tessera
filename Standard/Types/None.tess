// Tessera stdlib: None — nothing, as a value
//
// As a routine's return type, None says nothing comes back. Everywhere else it is this record, the type with
// exactly one value, mapped to the empty LLVM struct {} (zero size): None() can be bound, passed, stored in a
// field, and used as a generic argument. It is the branch of Maybe[T] that holds nothing, and Result[None, E] is
// an operation that either succeeds or fails with an error.

module Standard/Core

/// The type with exactly one value, `None()`, mapped to the empty LLVM struct `{}`: it can be bound, passed, and stored, so it fills a generic slot that needs no payload, such as `Result[None, E]`. A routine returning `None` returns nothing.
record None
obeys Equatable[None], Hashable[None], Comparable[None]

// -- equality, hashing ---------------------------------------------------------

/// There is only one `Unit` value, so every pair is equal.
/// :param other: The other `Unit`.
/// :returns: Always `true`.
routine None.eq(me: Me, other: Me) -> Bool
    return true

/// Hashes the one `Unit` value. Every `Unit` hashes the same.
/// :returns: A constant 64-bit hash.
routine None.hash(me: Me) -> U64
    h: U64 = siphash24(value: 0, key: hash_key())
    return h

/// None values are all equal.
/// :param other: The value to compare with.
/// :returns: Always 0.
routine None.compare(me: Me, other: Me) -> S32
    return 0
