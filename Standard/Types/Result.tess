// Tessera stdlib: Result<T, E>
//
// Result<T, E> is either a success value (T) or an error (E) — the standard way
// to report an expected failure (malformed input, I/O error, allocation
// failure). Contract violations (bugs) still crash; Result is for failures the
// caller is expected to handle.
//
// A variant, so the value and the error share storage: a Result is as big as
// the larger of the two plus its tag. Void has no values and cannot be T; use
// Result<Unit, E> for operations that only succeed or fail.
//
// Propagation idiom (caller returns Result<U, E>):
//
//     when r
//         .Success(value) -> use(value)
//         .Failure(error) -> fail(error)
//
//     block fail(error: ParseError)
//         failed : Result<U, ParseError> = .Failure(error)
//         return(failed)

module Standard::Core

import Standard::Format

// Failure is the first case, so a Success hashes with tag 1 and a Failure with
// tag 0, and Failure orders before every Success.
/// Either a success value or an error: the standard way to report an expected failure such as malformed input, an I/O error, or an allocation failure. Contract violations still crash. `Failure` is the first case, so it orders before every `Success`.
/// :typeparam T: The success value type.
/// :typeparam E: The error type.
#derive(Represent, Diagnose, Equal, Hash, Compare)
variant Result<T, E>
require T: typename, E: typename
    Failure : E
    Success : T

// -- predicates ----------------------------------------------------------------

/// Whether `self` holds a success value.
/// :typeparam T: The success value type.
/// :typeparam E: The error type.
/// :returns: `true` for `.Success`, `false` for `.Failure`.
routine Result<T, E>.is_success(self: Self) -> Bool
require T: typename, E: typename
    block entry()
        when self
            .Success -> return(true)
            .Failure -> return(false)

/// Whether `self` holds an error.
/// :typeparam T: The success value type.
/// :typeparam E: The error type.
/// :returns: `true` for `.Failure`, `false` for `.Success`.
routine Result<T, E>.is_failure(self: Self) -> Bool
require T: typename, E: typename
    block entry()
        when self
            .Success -> return(false)
            .Failure -> return(true)

// -- extraction ----------------------------------------------------------------

/// The value. Crashes if the Result is a Failure.
#track_caller
routine Result<T, E>.unwrap(self: Self) -> T
require T: typename, E: typename
    block entry()
        when self
            .Success(value) -> return(value)
            .Failure        -> crash_unwrap_failure()

/// The error. Crashes if the Result is a Success.
#track_caller
routine Result<T, E>.unwrap_failure(self: Self) -> E
require T: typename, E: typename
    block entry()
        when self
            .Failure(error) -> return(error)
            .Success        -> crash_unwrap_success()
