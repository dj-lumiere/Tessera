    r: U16 = trunc[Me, U16](me)
    return r

### Converts `me` to `U16`, saturating at the ends of `U16`'s range.
### :returns: `me` clamped to `U16.MIN ..= U16.MAX`.
routine CSSize.to_clamp[U16]() -> U16
    at_least: Me = smax[Me](me, 0)
    at_most: Me = smin[Me](at_least, 65535)
    r: U16 = trunc[Me, U16](at_most)
