### Converts `me` to `U128` when the value fits.
### :returns: The value as a `U128`.
### :absent: When `me` is negative.
routine CSSize.to_checked[U128]() -> Maybe[U128]
    fits: Bool = me >= 0
    value: U128 = sext[Me, U128](me)
    r: Maybe[U128] = fits.then_present(value)
