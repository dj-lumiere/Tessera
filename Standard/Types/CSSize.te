### Converts `me` to `CSSize` when the value fits.
### :returns: The value as an `CSSize`.
### :absent: When `me` is above the largest `CSSize`.
@target(size: 64)
routine U256.to_checked[CSSize]() -> Maybe[CSSize]
    fits: Bool = me <= 9223372036854775807
    value: CSSize = trunc[Me, CSSize](me)
    r: Maybe[CSSize] = fits.then_present(value)
    return r

