### :returns: `me` modulo 2^32, as an `CSSize`.
@target(size: 32)
routine U128.to_wrap[CSSize]() -> CSSize
    r: CSSize = trunc[Me, CSSize](me)
    return r

### Converts `me` to `CSSize`, saturating at the ends of `CSSize`'s range.
### :returns: `me` clamped to `CSSize.MIN ..= CSSize.MAX`.
@target(size: 64)
routine U128.to_clamp[CSSize]() -> CSSize
    at_most: Me = umin[Me](me, 9223372036854775807)
    r: CSSize = trunc[Me, CSSize](at_most)
    return r

