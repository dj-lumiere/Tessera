// Tessera stdlib: Addr — an address with no pointee type
//
// Maps to LLVM IR ptr, like Ptr<T>. Addr is C's `void*`: what an allocator hands out, a callback's state, an
// opaque C handle. It says where, not what, so it has no load or store: memory is read through a @T, and
// to<@T>() names what is there. Any @T converts to Addr where one is expected.

module Standard::Core

/// An address with no pointee type, mapped to LLVM `ptr` (C's `void*`). It says where, not what: it has no load or store, and `to<@T>()` names what is there.
#llvm("ptr")
record Addr

// -- identity ------------------------------------------------------------------

/// Whether `me` and `other` are the same address.
/// :param other: The right-hand operand.
/// :returns: `true` when the addresses are equal.
routine Addr.ptr_eq(me: Me, other: Me) -> Bool
    block entry()
        a : U64  = ptrtoint<Me, U64>(me)
        b : U64  = ptrtoint<Me, U64>(other)
        r : Bool = ieq<U64>(a, b)
        return(r)

/// Whether `me` and `other` are different addresses.
/// :param other: The right-hand operand.
/// :returns: `true` when the addresses differ.
routine Addr.ptr_ne(me: Me, other: Me) -> Bool
    block entry()
        a : U64  = ptrtoint<Me, U64>(me)
        b : U64  = ptrtoint<Me, U64>(other)
        r : Bool = ine<U64>(a, b)
        return(r)

// -- predicates ----------------------------------------------------------------

/// Whether `me` is the null address (0).
/// :returns: `true` when the address is 0.
routine Addr.is_null(me: Me) -> Bool
    block entry()
        a : U64  = ptrtoint<Me, U64>(me)
        r : Bool = ieq<U64>(a, 0)
        return(r)

/// Whether `me` is a non-null address.
/// :returns: `true` when the address is not 0.
routine Addr.is_not_null(me: Me) -> Bool
    block entry()
        a : U64  = ptrtoint<Me, U64>(me)
        r : Bool = ine<U64>(a, 0)
        return(r)

// -- arithmetic and typing -----------------------------------------------------

/// The address `bytes` bytes further on (back when `bytes` is negative). No bounds checking: staying in bounds is the
/// caller's job.
/// :param bytes: The signed byte distance to move.
/// :returns: The moved address.
routine Addr.offset(me: Me, bytes: SSize) -> Me
    block entry()
        r : Me = addr_offset(me, bytes)
        return(r)

/// The raw byte-offset arithmetic behind {Addr.offset}: a `getelementptr i8` with no bounds checking.
/// :param base: The starting address.
/// :param bytes: The signed byte distance to move.
/// :returns: The moved address.
#[external("llvm"), template("{result} = getelementptr i8, ptr {base}, {SSize} {bytes}")]
private routine addr_offset(base: Addr, bytes: SSize) -> Addr

/// The same address as a pointer to T.
/// :returns: `me` typed as `@T`.
routine Addr.to<@T>(me: Me) -> @T
require T: typename
    block entry()
        r : @T = bitcast<Me, @T>(me)
        return(r)
