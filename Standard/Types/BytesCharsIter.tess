// Tessera stdlib: BytesCharsIter
//
// Forward iterator over the characters (Char) of a UTF-8 Bytes.
// Advances by a variable number of bytes per step via utf8_decode.
// emit_checked() returns Unit after the last character, emit() crashes there.
// A malformed byte sequence yields U+FFFD (the replacement character) and
// advances past the offending byte, so iteration always terminates.
//
// Satisfies concept Iterator[Char, BytesCharsIter].

module Standard/Core

/// Iterator over the characters (`Char`) of a UTF-8 {Bytes}. It satisfies `Iterator[Char, BytesCharsIter]`. A malformed sequence yields U+FFFD and skips one byte, so iteration always ends.
record BytesCharsIter
conform Iterator[Char, BytesCharsIter]
    str: Bytes
    index: USize

/// Starts an iterator at the first byte of `str`.
/// :param str: The view to iterate. It is not copied, so its bytes must outlive the iterator.
/// :returns: An iterator positioned before the first element.
routine BytesCharsIter.construct(str: Bytes) -> Me
    iter: Me = Me(str: str, index: 0)
    return(iter)

/// Advances the iterator and returns the element it passed.
/// :returns: The next character.
/// :absent: The end of the view has been reached.
routine BytesCharsIter.emit_checked(me: @Me) -> Maybe[Char]
    local index: USize = me.index.peek()
    local str: Bytes = me.str.peek()

    str_len: USize = str.count
    done: Bool = index.ge(str_len)
    branch done
        ? return_none()
        : decode()

    block return_none()
        none: Maybe[Char] = Unit()
        return(none)

    block decode()
        data: @Byte = str.data
        decoded: Utf8Decoded = utf8_decode(bytes: data, pos: index, len: str.count)
        ok: Bool = decoded.ok
        // on a decode error next_pos == index, so advance by 1 to avoid an infinite loop
        safe_next: USize = index.add(1)
        advance: USize = ok
            ? decoded.next_pos
            : safe_next
        me.index.poke(advance)
        some: Maybe[Char] = decoded.char
        return(some)

/// Yields the next element and advances the iterator, crashing when there is none.
/// :returns: The next element, in order.
/// :throws: Crashes with `AbsentValueError` after the last element has been yielded.
#track_caller
routine BytesCharsIter.emit(me: @Me) -> Char
    item: Maybe[Char] = me.emit_checked()
    when item
        is Char as value => return(value)
        is Unit => crash_absent_value()
