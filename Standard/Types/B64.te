# Tessera stdlib: B64 — 64-bit IEEE 754 floating-point
#
# Maps to LLVM IR double.

module Standard/Core

### A 64-bit IEEE 754 binary64 floating-point number (double precision), mapped to LLVM `double`.
### It has a 53-bit significand (about 15 to 17 significant decimal digits) and finite magnitudes up to about 1.8e308.
### :note: Arithmetic rounds to nearest, ties to even. `eq` is IEEE equality, so NaN is unequal to itself and -0.0 equals +0.0.
### :see: {B32} for half the size, {B128} for more precision.
@llvm("double")
record B64
obeys Equatable[B64], Comparable[B64], Hashable[B64]
obeys Numeric[B64], Divisible[B64], Negatable[B64]
obeys UncheckedArithmetic[B64]

# -- constants -----------------------------------------------------------------

### Positive infinity (bits `0x7FF0000000000000`): the result of overflow and of dividing a positive value by +0.0.
preset B64.INFINITY:     B64 = B64.from_bits(0x7FF0000000000000)  # +inf bits
### Negative infinity (bits `0xFFF0000000000000`).
preset B64.NEG_INFINITY: B64 = B64.from_bits(0xFFF0000000000000)  # -inf bits
### The canonical quiet NaN (bits `0x7FF8000000000000`).
### :note: NaN is unequal to everything, itself included, so test for it with {B64.is_nan}, not `eq`.
preset B64.NAN:          B64 = B64.from_bits(0x7FF8000000000000)  # canonical quiet NaN bits

# -- arithmetic ----------------------------------------------------------------

### Clears the sign bit, so abs(-0.0) is 0.0 and NaN stays NaN.
### :returns: `me` with the sign bit cleared.
routine B64.abs() -> Me
    r: Me = fabs[Me](me)
    return r

### The smaller value. If one operand is NaN, the other one.
### :param other: The value to compare with.
### :returns: The smaller value, the other operand when one is NaN, and NaN when both are.
routine B64.min(other: Me) -> Me
    self_nan: Bool = me.is_nan()
    other_nan: Bool = other.is_nan()
    when
        self_nan and other_nan => return me +! other
        self_nan => return other
        other_nan => return me
        else =>
            # no minnum intrinsic: on 32-bit ARM it becomes a libm call
            pick: Bool = me <= other
            r: Me = when
                pick => me
                else => other
            return r

### The larger value. If one operand is NaN, the other one.
### :param other: The value to compare with.
### :returns: The larger value, the other operand when one is NaN, and NaN when both are.
routine B64.max(other: Me) -> Me
    self_nan: Bool = me.is_nan()
    other_nan: Bool = other.is_nan()
    when
        self_nan and other_nan => return me +! other
        self_nan => return other
        other_nan => return me
        else =>
            # no maxnum intrinsic: on 32-bit ARM it becomes a libm call
            pick: Bool = me >= other
            r: Me = when
                pick => me
                else => other
            return r

### Adds `other` to `me`, rounded to nearest (ties to even).
### :param other: The value to add.
### :returns: `me + other`: infinity on overflow, NaN when either operand is NaN or for `inf + -inf`.
routine B64.add_unchecked(other: Me) -> Me
    r: Me = fadd[Me](me, other)
    return r

### Subtracts `other` from `me`, rounded to nearest (ties to even).
### :param other: The value to subtract.
### :returns: `me - other`: infinity on overflow, NaN when either operand is NaN or for `inf - inf`.
routine B64.sub_unchecked(other: Me) -> Me
    r: Me = fsub[Me](me, other)
    return r

### Multiplies `me` by `other`, rounded to nearest (ties to even).
### :param other: The factor.
### :returns: `me * other`: infinity on overflow, NaN when either operand is NaN or for `0 * inf`.
routine B64.mul_unchecked(other: Me) -> Me
    r: Me = fmul[Me](me, other)
    return r

# -- comparisons ---------------------------------------------------------------

### Whether `me` is less than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me < other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B64.lt(other: Me) -> Bool
    return flt[Me](me, other)

### Whether `me` is less than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me <= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B64.le(other: Me) -> Bool
    return fle[Me](me, other)

### Whether `me` is greater than `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me > other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B64.gt(other: Me) -> Bool
    return fgt[Me](me, other)

### Whether `me` is greater than or equal to `other`, as an ordered IEEE comparison.
### :param other: The value to compare against.
### :returns: `me >= other`. False when either operand is NaN. -0.0 and +0.0 compare equal.
routine B64.ge(other: Me) -> Bool
    return fge[Me](me, other)

# -- division ------------------------------------------------------------------

### Divides `me` by `other`, rounded to nearest (ties to even).
### :param other: The divisor.
### :returns: `me / other`: a signed infinity for a nonzero value divided by zero, NaN for `0 / 0`, `inf / inf`, or a NaN operand.
routine B64.truediv_unchecked(other: Me) -> Me
    r: Me = fdiv[Me](me, other)
    return r

# -- equality, ordering, hashing -----------------------------------------------

### IEEE equality.
### :param other: The value to compare against.
### :returns: True when the values are equal: -0.0 equals +0.0, and NaN is unequal to everything, itself included.
routine B64.eq(other: Me) -> Bool
    return feq[Me](me, other)

### Three-way comparison for the `Comparable` conformance.
### :param other: The value to compare against.
### :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, which includes -0.0 against +0.0 and any comparison with NaN.
### :see: {B64.total_compare} for a total order that ranks NaN and the signed zeros.
routine B64.compare(other: Me) -> S32
    if me < other
        return -1
    if me > other
        return 1
    return 0

### Hashes the raw IEEE bits with SipHash-2-4 under the process key, for the `Hashable` conformance.
### :returns: The 64-bit hash.
### :note: -0.0 and +0.0 are `eq` but hash apart, and NaNs with different payloads hash apart.
routine B64.hash() -> U64
    bits: U64 = me.bits()
    h: U64 = siphash24(value: bits, key: hash_key())
    return h

# -- generic conversions -------------------------------------------------------

### Narrows to a smaller float type with LLVM `fptrunc`, rounding to nearest (ties to even).
### :typeparam T: The narrower float type.
### :returns: The rounded value: infinity when it overflows `T`, a subnormal or zero when it underflows, NaN for NaN.
routine B64.fptrunc[T]() -> T
needs T: typename
    r: T = fptrunc[Me, T](me)
    return r

### Converts to a signed integer type with LLVM `fptosi`, rounding toward zero.
### :typeparam T: The signed integer type.
### :returns: The integer part of `me`.
### :note: NaN or a value out of the range of `T` gives poison. The checked `to[S..]`, `to_checked[S..]` and `to_clamp[S..]` conversions avoid it.
routine B64.fptosi[T]() -> T
needs T: typename
    r: T = fptosi[Me, T](me)
    return r

# -- named narrowing conversion ------------------------------------------------

### Narrows to B32, rounding to nearest (ties to even).
### :returns: The nearest B32: infinity beyond B32's range, a subnormal or zero for tiny values, NaN for NaN.
routine B64.to[B32]() -> B32
    result: B32 = fptrunc[Me, B32](me)
    return result

# ============================================================
# Rust-level operations
# ============================================================

# -- constants ------------------------------------------------------------------

### The largest finite B64, about 1.7976931348623157e308 (bits `0x7FEFFFFFFFFFFFFF`).
preset B64.MAX:          B64 = B64.from_bits(0x7FEFFFFFFFFFFFFF)  # largest finite value
### The most negative finite B64, the negation of `B64.MAX` (bits `0xFFEFFFFFFFFFFFFF`).
preset B64.MIN:          B64 = B64.from_bits(0xFFEFFFFFFFFFFFFF)  # most negative finite value
### The smallest positive normal B64, 2^-1022, about 2.2250738585072014e-308 (bits `0x0010000000000000`). Subnormal values go below it.
preset B64.MIN_POSITIVE: B64 = B64.from_bits(0x0010000000000000)  # smallest positive normal value

### The gap between 1.0 and the next larger B64, 2^-52, about 2.220446049250313e-16 (bits `0x3CB0000000000000`).
preset B64.EPSILON:      B64 = B64.from_bits(0x3CB0000000000000)  # the gap between 1.0 and the next value

### Pi, rounded to the nearest B64.
preset B64.PI: B64 = 3.14159265358979323846264338327950288  # pi
### Tau (2 pi), one full turn in radians, rounded to the nearest B64.
preset B64.TAU: B64 = 6.28318530717958647692528676655900577  # 2 pi
### Euler's number e, rounded to the nearest B64.
preset B64.E: B64 = 2.71828182845904523536028747135266250  # Euler's number
### Pi / 2, rounded to the nearest B64.
preset B64.FRAC_PI_2: B64 = 1.57079632679489661923132169163975144  # pi / 2
### Pi / 4, rounded to the nearest B64.
preset B64.FRAC_PI_4: B64 = 0.785398163397448309615660845819875721  # pi / 4
### 1 / pi, rounded to the nearest B64.
preset B64.FRAC_1_PI: B64 = 0.318309886183790671537767526745028724  # 1 / pi
### The square root of 2, rounded to the nearest B64.
preset B64.SQRT_2: B64 = 1.41421356237309504880168872420969808  # sqrt(2)
### 1 / sqrt(2), rounded to the nearest B64.
preset B64.FRAC_1_SQRT_2: B64 = 0.707106781186547524400844362104849039  # 1 / sqrt(2)
### The natural logarithm of 2, rounded to the nearest B64.
preset B64.LN_2: B64 = 0.693147180559945309417232121458176568  # ln(2)
### The natural logarithm of 10, rounded to the nearest B64.
preset B64.LN_10: B64 = 2.30258509299404568401799145468436421  # ln(10)
### Log2(e), rounded to the nearest B64.
preset B64.LOG2_E: B64 = 1.44269504088896340735992468100189214  # log2(e)
### Log10(e), rounded to the nearest B64.
preset B64.LOG10_E: B64 = 0.434294481903251827651128918916605082  # log10(e)

# -- C math library -----------------------------------------------------------

# -- sign ----------------------------------------------------------------------

### Flips the sign bit, exactly.
### :returns: `-me`: 0.0 becomes -0.0, infinities swap sign, and NaN keeps its payload.
routine B64.neg() -> Me
    r: Me = fneg[Me](me)
    return r

### The magnitude of `me` with the sign of `sign`.
### :param sign: The value whose sign bit is used.
### :returns: `me` with its sign bit replaced by the sign bit of `sign`.
routine B64.copysign(sign: Me) -> Me
    r: Me = copysign[Me](mag: me, sign)
    return r

### 1.0 for +0.0 and positive values, -1.0 for -0.0 and negative values, NaN for NaN.
### :returns: 1.0, -1.0, or NaN, by the sign of `me`.
routine B64.signum() -> Me
    nan: Bool = me.is_nan()
    unit: Me = copysign[Me](mag: 1.0, sign: me)
    r: Me = when
        nan => me
        else => unit
    return r

### Reads the sign bit, so it is true for +0.0 and for NaNs with the bit clear.
### :returns: Whether the sign bit is clear.
routine B64.is_sign_positive() -> Bool
    bits: S64 = me.bits().to_wrap[S64]()
    return bits >= 0

### Reads the sign bit, so it is true for -0.0 and for NaNs with the bit set.
### :returns: Whether the sign bit is set.
routine B64.is_sign_negative() -> Bool
    bits: S64 = me.bits().to_wrap[S64]()
    return bits < 0

# -- arithmetic ----------------------------------------------------------------

### The remainder of me / other, with the sign of me (C fmod, Rust's %). Exact.
###
### A long division on the significands, one quotient bit per step (up to 2098), since LLVM lowers frem to
### libm's fmod on every target.
### :param other: The divisor.
### :returns: The remainder. NaN when either operand is NaN, `me` is infinite, or `other` is 0. Otherwise `me`
###     itself when `other` is infinite or `me` is a zero.
routine B64.mod_trunc_unchecked(other: Me) -> Me
    nan: Bool = me.is_nan() or other.is_nan()
    invalid: Bool = me.is_infinite() or other == 0.0
    when
        nan => return me +! other
        invalid => return Me.NAN
        other.is_infinite() or me == 0.0 => return me
        else =>
            a: B64Parts = b64_unpack(me)
            b: B64Parts = b64_unpack(other)
            same_exp: Bool = a.exponent == b.exponent
            if a.exponent < b.exponent or (same_exp and a.sig < b.sig)
                return me
            # x < 2 mb throughout, as both significands are normalized
            mb: U64 = b.sig
            eb: S64 = b.exponent
            while steps != 0 with x: U64 = a.sig, steps: S64 = a.exponent - b.exponent
                fits: Bool = x >= mb
                taken: U64 = when
                    fits => mb
                    else => 0
                left: U64 = x - taken
                continue with x: left << 1, steps: steps - 1
            then
                # the remainder is rest × 2^(eb - 1075), which B64 holds exactly
                fits: Bool = x >= mb
                taken: U64 = when
                    fits => mb
                    else => 0
                rest: U64 = x - taken
                if rest == 0
                    return Me.copysign(0.0, me)
                lz: U64 = rest.leading_zeros()
                magnitude: Me = b64_round_pack(negative: false,
                    exponent: eb - lz.to[S64]() + 11, sig: rest << lz)
                r: Me = magnitude.copysign(me)
                return r

### The reciprocal `1 / me`, rounded once.
### :returns: `1 / me`: a signed infinity for a signed zero, a signed zero for an infinity, NaN for NaN.
routine B64.recip_unchecked() -> Me
    r: Me = fdiv[Me](1.0, me)
    return r

### Fused multiply-add: `me * a + b` with a single rounding, computed with the AArch64 FMA instruction.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: "aarch64")
routine B64.mul_add_unchecked(a: Me, b: Me) -> Me
    r: Me = fma[Me](me, a, b)
    return r

### Fused multiply-add: `me * a + b` with a single rounding, computed with the x86 FMA instruction (targets with the `fma` feature, as with `--cpu x86-64-v3`).
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: "x86_64")
@feature("fma")
routine B64.mul_add_unchecked(a: Me, b: Me) -> Me
    r: Me = fma[Me](me, a, b)
    return r

### Fused multiply-add: `me * a + b` with a single rounding, computed in software ({B64.mul_add_soft}) on x86 without the `fma` feature.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: "x86_64")
@feature(not "fma")
@inline
routine B64.mul_add_unchecked(a: Me, b: Me) -> Me
    r: Me = me.mul_add_soft(a, b)
    return r

### Fused multiply-add: `me * a + b` with a single rounding, computed in software ({B64.mul_add_soft}) on targets other than AArch64 and x86_64.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@target(arch: not ("aarch64", "x86_64"))
@inline
routine B64.mul_add_unchecked(a: Me, b: Me) -> Me
    r: Me = me.mul_add_soft(a, b)
    return r

### me * a + b with a single rounding, without an FMA instruction.
###
### Without one LLVM calls libm's fma. When the operands' exponents keep every intermediate below away from
### overflow and underflow, this is Boldo and Melquiond's emulation in B64 arithmetic: the exact product
### p + e (Dekker), the exact sum c + p = th + tl (TwoSum), then th + (tl + e rounded to odd), rounded once.
### Rounding the small part to odd keeps the information the last rounding needs, so the result is the
### correctly rounded `me * a + b`. Plain th + (tl + e) is that same value except near a tie, which an exact
### check of both roundings' errors rules out, so the round to odd runs only there. Outside that window
### (zeros, subnormals, infinities, NaN, huge or tiny products) it forms the 106-bit product exactly in a U128,
### aligns b to it (bits shifted out past the product become a sticky bit), and rounds only the sum
### ({B64.mul_add_wide}).
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@inline
secret routine B64.mul_add_soft(a: Me, b: Me) -> Me
    local field_x: U64 = (me.bits() >> 52) & 0x7FF
    local field_a: U64 = (a.bits() >> 52) & 0x7FF
    local field_b: U64 = (b.bits() >> 52) & 0x7FF

    # The emulation is exact when the factors are normal and below 2^996 (splitting them can't overflow),
    # their product's exponent is in [-918, 960] (its error is a multiple of 2^-1022, the product
    # and the sum stay below 2^1003), and the addend's exponent is in [-960, 1000] (its ulp is at least
    # 2^-1012). Every nonzero intermediate is then a normal number.
    x_normal: Bool = field_x -% 1 < 2018
    a_normal: Bool = field_a -% 1 < 2018
    product: U64 = field_x +% field_a
    p_inside: Bool = product -% 1128 < 1879
    b_inside: Bool = field_b -% 63 < 1961
    factors: Bool = x_normal and a_normal
    operands: Bool = p_inside and b_inside
    if factors and operands
        # R = th + tl + e exactly. z = th + (tl + e), each sum rounded, is R rounded once unless the first
        # rounding moved the sum across a rounding boundary of z. The two errors d and r are exact (TwoSum), so
        # R = z + r + d, and when |r| + |d| is below the distance from z to its nearer boundary, z is the answer.
        # The check runs beside the next operation, and only a sum within a few ulps of a tie of z falls back to
        # rounding tl + e to odd.
        p: Me = me *! a
        e: Me = b64_dekker_error(x: a, y: me, p)
        th: Me = b +! p
        bv: Me = th -! b
        av: Me = th -! bv
        tl: Me = b -! av +! (p -! bv)
        s: Me = tl +! e
        z: Me = th +! s
        sv: Me = s -! tl
        su: Me = s -! sv
        d: Me = tl -! su +! (e -! sv)
        zv: Me = z -! th
        zu: Me = z -! zv
        r: Me = th -! zu +! (s -! zv)
        w: Me = r.abs() +! d.abs()
        # |r + d| <= |r| + |d|, and w, that sum rounded, is below a power of two only when the sum is. The
        # boundaries of z are half an ulp away, the power of two with the exponent field of z less 53, and a
        # quarter ulp below a power of two, one field less (for z not tiny: a field of 55 or more).
        z_bits: U64 = z.bits()
        z_field: U64 = (z_bits >> 52) & 0x7FF
        power: Bool = z_bits & 0x000FFFFFFFFFFFFF == 0
        boundary: U64 = z_field -% 53 -% power.to[U64]()
        w_field: U64 = w.bits() >> 52
        normal: Bool = z_field >= 55
        inside: Bool = w_field < boundary
        if normal and inside
            return z
        return th +! b64_add_round_to_odd(a: tl, b: e)
    return me.mul_add_wide(a, b)

### me * a + b with a single rounding, for every operand: the slow path of {B64.mul_add_soft}, kept out of line so
### the emulated path that callers inline stays small. It forms the 106-bit product exactly in a U128, aligns b to it
### (bits shifted out past the product become a sticky bit), and rounds only the sum.
### :param a: The factor `me` is multiplied by.
### :param b: The addend.
### :returns: `me * a + b` rounded once to nearest (ties to even). NaN for a NaN operand, `inf * 0`, or `inf - inf`.
@noinline
secret routine B64.mul_add_wide(a: Me, b: Me) -> Me
    factors_finite: Bool = me.is_finite() and a.is_finite()
    factor_special: Bool = not factors_finite
    addend_special: Bool = not b.is_finite()
    zero_product: Bool = me == 0.0 or a == 0.0
    when
        factor_special => return me *! a +! b
        addend_special => return b +! b
        zero_product => return me *! a +! b
        b == 0.0 => return me *! a
        else =>
            # an infinite or NaN factor makes the product exact, and so does a zero one
            # a nonzero product plus zero is the product, whatever the zero's sign
            # P = mx my × 2^(ex + ey - 2170) and C = mc × 2^(ec - 1148), each below 2^126 with its top bit at 124
            # or 125, leaving room for a carry
            px: B64Parts = b64_unpack(me)
            py: B64Parts = b64_unpack(a)
            pc: B64Parts = b64_unpack(b)
            p: U128 = px.sig.mul_wide(py.sig) << 20
            p_e: S64 = px.exponent + py.exponent - 2170
            cc: U128 = pc.sig.to[U128]() << 73
            c_e: S64 = pc.exponent - 1148
            p_neg: Bool = me.is_sign_negative() != a.is_sign_negative()
            c_neg: Bool = b.is_sign_negative()
            p_first: Bool = p_e >= c_e
            big: U128 = when
                p_first => p
                else => cc
            small: U128 = when
                p_first => cc
                else => p
            e: S64 = when
                p_first => p_e
                else => c_e
            diff: S64 = when
                p_first => p_e - c_e
                else => c_e - p_e
            big_neg: Bool = when
                p_first => p_neg
                else => c_neg
            small_neg: Bool = when
                p_first => c_neg
                else => p_neg
            aligned: U128 = shr_sticky(value: small, n: diff)
            same: Bool = big_neg == small_neg
            values2: (U128, Bool) = when
                same => (big + aligned, big_neg)
                else =>
                    # an exact zero is +0
                    x_larger: Bool = big >= aligned
                    m: U128 = big.abs_diff(aligned)
                    negative: Bool = when
                        x_larger => big_neg
                        else => not big_neg
                    becomes (m, negative)
            r, negative = values2
            # value = r × 2^e: bring the top bit to 127 and round the high half, with a sticky bit for the low one
            if r == 0
                return 0.0
            lz: U128 = r.leading_zeros()
            n: U128 = r << lz
            high: U64 = (n >> 64).to[U64]()
            low_sticky: Bool = n.to_wrap[U64]() != 0
            sig: U64 = high | low_sticky.to[U64]()
            exponent: S64 = e - lz.to[S64]() + 1150
            result: Me = b64_round_pack(negative, exponent, sig)
            return result

### The quotient `q` of Euclidean division, so that `me = q * other + r` with `0 <= r < |other|`.
### :param other: The divisor.
### :returns: The quotient `q`. NaN when either operand is NaN.
routine B64.floordiv_unchecked(other: Me) -> Me
    q: Me = me.truediv_unchecked(other).trunc()
    rem: Me = me.mod_trunc_unchecked(other)
    if not (rem < 0.0)
        return q
    positive_divisor: Bool = other > 0.0
    down: Me = q -! 1.0
    up: Me = q +! 1.0
    r: Me = when
        positive_divisor => down
        else => up
    return r

### The least non-negative remainder of `me / other`.
### :param other: The divisor.
### :returns: The remainder, in `0 ..< |other|` for a finite `other`. When the exact remainder is a tiny negative value,
###     `|other|` plus it would round to `|other|`, so the largest value below `|other|` comes back instead.
routine B64.mod_unchecked(other: Me) -> Me
    rem: Me = me.mod_trunc_unchecked(other)
    if not (rem < 0.0)
        return rem
    magnitude: Me = other.abs()
    r: Me = rem +! magnitude
    # a tiny negative remainder plus |other| rounds up to |other|: the largest value below it is the nearest
    # one in range
    if r == magnitude and magnitude.is_finite()
        return Me.from_bits(magnitude.bits() - 1)
    return r

# -- ordering ------------------------------------------------------------------

### The smaller value, NaN if either is NaN, and -0.0 below +0.0.
### :param other: The value to compare with.
### :returns: The smaller value, or NaN when either operand is NaN.
routine B64.minimum(other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me +! other
    # equal values have equal bits except ±0, where bitor picks the negative one
    if me == other
        return Me.from_bits(me.bits() | other.bits())
    pick: Bool = me < other
    r: Me = when
        pick => me
        else => other
    return r

### The larger value, NaN if either is NaN, and +0.0 above -0.0.
### :param other: The value to compare with.
### :returns: The larger value, or NaN when either operand is NaN.
routine B64.maximum(other: Me) -> Me
    if me.is_nan() or other.is_nan()
        return me +! other
    # equal values have equal bits except ±0, where bitand picks the positive one
    if me == other
        return Me.from_bits(me.bits() & other.bits())
    pick: Bool = me > other
    r: Me = when
        pick => me
        else => other
    return r

### Restricts `me` to `lo ..= hi`. NaN stays NaN.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` when `me < lo`, `hi` when `me > hi`, otherwise `me`.
### :throws: Crashes with `InvalidValueError` unless `lo <= hi`, so also when either bound is NaN.
@track_caller
routine B64.clamp(lo: Me, hi: Me) -> Me
    if lo <= hi
        below: Bool = me < lo
        above: Bool = me > hi
        upper: Me = when
            above => hi
            else => me
        r: Me = when
            below => lo
            else => upper
        return r
    crash_invalid_value()

### IEEE 754 totalOrder: -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN.
### :param other: The value to compare with.
### :returns: -1, 0, or 1 as `me` comes before, at the same place as, or after `other` in that order.
routine B64.total_compare(other: Me) -> S32
    a: S64 = me.bits().to_wrap[S64]()
    b: S64 = other.bits().to_wrap[S64]()
    # Flipping every bit but the sign of negative values makes the bits order like signed integers.
    a_key: S64 = a ^ ((a >> 63) & S64.MAX)
    b_key: S64 = b ^ ((b >> 63) & S64.MAX)
    r: S32 = a_key.compare(b_key)
    return r

# -- rounding ------------------------------------------------------------------

# AArch64 has an instruction for each. Elsewhere LLVM calls libm (x86 before SSE4.1 has none), so the other
# targets work on the bits: trunc clears the fraction bits, and the rest adjust its result, all exactly.

### Rounds toward negative infinity with the AArch64 rounding instruction.
### :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B64.floor() -> Me
    r: Me = floor[Me](me)
    return r

### Rounds toward negative infinity from {B64.trunc}, stepping one down when truncation moved the value up (exact).
### :returns: The largest integer value not above `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B64.floor() -> Me
    t: Me = me.trunc()
    down: Bool = t > me
    r: Me = when
        down => t -! 1.0
        else => t
    return r

### Rounds toward positive infinity with the AArch64 rounding instruction.
### :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B64.ceil() -> Me
    r: Me = ceil[Me](me)
    return r

### Rounds toward positive infinity from {B64.trunc}, stepping one up when truncation moved the value down (exact).
### :returns: The smallest integer value not below `me` (-0.5 gives -0.0). Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B64.ceil() -> Me
    t: Me = me.trunc()
    up: Bool = t < me
    r: Me = when
        up => t +! 1.0
        else => t
    return r

### Rounds half-way cases away from zero.
### :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B64.round() -> Me
    r: Me = round[Me](me)
    return r

### Rounds half-way cases away from zero.
### :returns: The nearest integer value, half-way cases away from zero. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B64.round() -> Me
    t: Me = me.trunc()
    fraction: Me = me -! t
    half: Bool = fraction.abs() >= 0.5
    away: Me = t +! Me.copysign(1.0, me)
    r: Me = when
        half => away
        else => t
    return r

### Rounds half-way cases to the even neighbor.
### :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B64.round_ties_even() -> Me
    r: Me = rint[Me](me)
    return r

### Rounds half-way cases to the even neighbor.
###
### Below 2^52, adding and subtracting 2^52 leaves the magnitude rounded to an integer by the addition.
### :returns: The nearest integer value, half-way cases to the even one. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B64.round_ties_even() -> Me
    magnitude: Me = me.abs()
    if magnitude >= 4503599627370496.0
        return me
    rounded: Me = magnitude +! 4503599627370496.0 -! 4503599627370496.0
    r: Me = rounded.copysign(me)
    return r

### Rounds toward zero.
### :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: "aarch64")
routine B64.trunc() -> Me
    r: Me = ftrunc[Me](me)
    return r

### Rounds toward zero.
### :returns: The integer part of `me`. Zeros, infinities and NaN come back unchanged.
@target(arch: not "aarch64")
routine B64.trunc() -> Me
    local bits: U64 = me.bits()
    local field: U64 = (bits >> 52) & 0x7FF

    special: Bool = field == 0x7FF
    integral: Bool = field >= 1075
    when
        special => return me +! me
        integral => return me
        field < 1023 => return Me.from_bits(bits & 0x8000000000000000)
        else =>
            # 1 <= |me| < 2^52: the lowest 1075 - field bits are the fraction
            mask: U64 = (1 << U64.sub(1075, field)) - 1
            r: Me = Me.from_bits(bits & ~mask)
            return r

### `me` minus its integer part, with the sign of `me`.
### :returns: The fractional part. NaN for an infinity or NaN.
routine B64.fract() -> Me
    whole: Me = me.trunc()
    r: Me = me -! whole
    return r

# -- powers --------------------------------------------------------------------
#
# cbrt, powf, the exponentials, logarithms, and trigonometric, hyperbolic, and special functions are
# defined in Standard/B64Core/, one file each: ports of CORE-MATH, correctly rounded, so they give the same
# bits on every target, unlike the platform libm.

### The square root of `me`.
### :returns: The square root: NaN for negative values other than -0.0, which gives -0.0.
routine B64.sqrt_unchecked() -> Me
    r: Me = sqrt[Me](me)
    return r

### me raised to an integer power, correctly rounded: powf with n converted, which is exact.
### :param n: The integer exponent.
### :returns: `me` to the power `n`, rounded once.
routine B64.powi_unchecked(n: S32) -> Me
    r: Me = me.powf_unchecked(n.to[Me]())
    return r

### The logarithm of `me` in base `base`, ln(`me`) / ln(`base`) correctly rounded (to nearest, ties to even). Three
### tiers, each kept only when an error band around its quotient rounds to one B64 (Ziv's test): the double-double
### logarithms of B64.ln's fast path divided in double-double ({cm_b64_log_ratio_fast}), then the correctly rounded B128
### logarithms divided in B128 (within 2^-111 relative, band 2^-109), then both logarithms in B128Big
### ({big_log_ratio}). Exact results come out exact: log(8, 2) = 3, log(1000, 10) = 3, log(x, x) = 1.
### :param base: The base of the logarithm.
### :returns: log base `base` of `me`. Where `me` or `base` is 0, 1, +inf, negative, or NaN, the B64 quotient
###     ln(`me`) / ln(`base`): NaN for a negative or NaN argument, ±inf for base 1 or `me` 0 or +inf, ±0 for
###     `me` 1 or base 0 or +inf, NaN when both logarithms are zero or both infinite.
### :note: The first tier decides all but about 2 in a million random pairs. Within about 2^-12 of 1 its absolute
###     bound is too wide and the B128 tier decides. Some pairs near 1 need the last tier: the true quotient of
###     log(1 - 2^-52, 1 + 2^-50) lies within 2^-154 of a midpoint.
routine B64.log_unchecked(base: Me) -> Me
    x_ok: Bool = me > 0.0 and me.is_finite()
    base_ok: Bool = base > 0.0 and base.is_finite()
    one: Bool = me == 1.0 or base == 1.0
    if x_ok and base_ok and not one
        r: Maybe[Me] = cm_b64_log_ratio_fast(x: me, base)
        when r
            is Me as v => return v
            is None =>
                q: B128 = me.to[B128]().ln_unchecked() /! base.to[B128]().ln_unchecked()
                width: B128 = q.abs().scalbn_unchecked(-109)
                left: Me = (q -! width).to[Me]()
                right: Me = (q +! width).to[Me]()
                if left == right
                    return left
                r2: B128 = big_log_ratio(x: me.to[B128](), base: base.to[B128](),
                    fraction_bits: 52)
                return r2.to[Me]()
    else
        return me.ln_unchecked() /! base.ln_unchecked()

# -- special functions ---------------------------------------------------------

### Converts an angle from radians to degrees by multiplying by 180 / pi (the constant rounded to B64).
### :returns: `me` in degrees, rounded once.
routine B64.to_degrees_unchecked() -> Me
    r: Me = me *! 57.2957795130823208767981548141051703
    return r

### Converts an angle from degrees to radians by multiplying by pi / 180 (the constant rounded to B64).
### :returns: `me` in radians, rounded once.
routine B64.to_radians() -> Me
    r: Me = me *! 0.0174532925199432957692369076848861271
    return r

# -- classification ------------------------------------------------------------

### Whether `me` is NaN, quiet or signaling.
### :returns: True for NaN, the only value unordered with itself.
routine B64.is_nan() -> Bool
    return funo[Me](me, me)

### Whether `me` is +inf or -inf.
### :returns: True for either infinity. False for NaN and finite values.
routine B64.is_infinite() -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude == Me.INFINITY

### Neither infinite nor NaN.
### :returns: True for zeros, subnormals and normal values. False for infinities and NaN.
routine B64.is_finite() -> Bool
    magnitude: Me = fabs[Me](me)
    return magnitude < Me.INFINITY

### Not zero, subnormal, infinite, or NaN.
### :returns: True when the exponent field is neither all zeros nor all ones.
routine B64.is_normal() -> Bool
    exponent: U64 = me.bits() & 0x7FF0000000000000
    return exponent != 0 and exponent != 0x7FF0000000000000

### Whether `me` is subnormal: a zero exponent field with a nonzero fraction, so its magnitude is below `B64.MIN_POSITIVE`.
### :returns: True for subnormals. False for zero, normal values, infinities and NaN.
routine B64.is_subnormal() -> Bool
    bits: U64 = me.bits()
    exponent: U64 = bits & 0x7FF0000000000000
    mantissa: U64 = bits & 0x000FFFFFFFFFFFFF
    return exponent == 0 and mantissa != 0

# -- bits ----------------------------------------------------------------------

### A finite nonzero B64 as sig × 2^(exponent - 1075), with sig normalized to [2^52, 2^53), subnormals too.
secret record B64Parts
    sig: U64
    exponent: S64

### The raw IEEE 754 bits.
### :returns: The encoding as a U64: sign bit at the top, then the exponent field, then the fraction.
routine B64.bits() -> U64
    r: U64 = bitcast[Me, U64](me)
    return r

### Reinterprets raw IEEE 754 binary64 bits as a B64, exactly.
### :param bits: The encoding: sign bit at the top, then the exponent field, then the fraction.
### :returns: The value with that encoding. NaN payloads are kept.
### :see: {B64.bits} for the inverse.
common routine B64.from_bits(bits: U64) -> Me
    r: Me = bitcast[U64, Me](bits)
    return r

### Splits a finite, nonzero B64 into a normalized significand and biased exponent, so that `x = sig * 2^(exponent - 1075)`.
### :param x: A finite, nonzero B64. Zeros, infinities and NaN are not handled.
### :returns: {B64Parts} with `sig` in [2^52, 2^53). A subnormal is normalized, so its exponent drops to 0 or below.
secret routine b64_unpack(x: B64) -> B64Parts
    local bits: U64 = x.bits()
    local field: U64 = (bits >> 52) & 0x7FF
    local fraction: U64 = bits & 0x000FFFFFFFFFFFFF

    if field != 0
        sig: U64 = fraction | 0x0010000000000000
        parts: B64Parts = B64Parts(sig: sig, exponent: field.to[S64]())
        return parts
    shift: U64 = fraction.leading_zeros() - 11
    sig: U64 = fraction << shift
    parts: B64Parts = B64Parts(sig: sig, exponent: S64.sub(1, shift.to[S64]()))
    return parts

### sig × 2^(exponent - 1086) rounded to nearest, ties to even, where sig has its top bit (63) set and exponent
### is the biased exponent the result has if it's normal. Rounds into the subnormals below 1 and overflows to
### infinity at 0x7FF.
### :param negative: The sign of the result.
### :param exponent: The biased exponent the result has if it is normal.
### :param sig: The significand, with its top bit (63) set.
### :returns: The rounded B64: a subnormal or zero below exponent 1, and infinity at 0x7FF or above.
secret routine b64_round_pack(negative: Bool, exponent: S64, sig: U64) -> B64
    local sign: U64 = when

        negative => 0x8000000000000000
        else => 0

    overflow: Bool = exponent >= 0x7FF
    values: (S64, U64) = when
        overflow => return B64.from_bits(sign | 0x7FF0000000000000)
        exponent < 1 =>
            # shift to the scale of exponent 1, which encodes as the subnormal field 0
            shift: S64 = S64.sub(1, exponent)
            all: Bool = shift >= 64
            some: U64 = sig >> shift.min(63).to[U64]()
            lost: Bool = when
                all => sig != 0
                else => sig != some << shift.min(63).to[U64]()
            shifted: U64 = when
                all => 0
                else => some
            becomes (1, shifted | lost.to[U64]())
        else => (exponent, sig)
    result_exponent, result_sig = values

    # a carry out of the 53 kept bits bumps the exponent, up to infinity
    kept: U64 = result_sig >> 11
    rest: U64 = result_sig & 0x7FF
    odd: Bool = kept & 1 == 1
    up: Bool = rest > 0x400 or (rest == 0x400 and odd)
    rounded: U64 = kept + up.to[U64]()
    biased_exponent: U64 = (result_exponent - 1).to[U64]()
    magnitude: U64 = (biased_exponent << 52) + rounded
    r: B64 = B64.from_bits(sign | magnitude)
    return r

# -- float conversions -----------------------------------------------------------

### a + b rounded to odd: truncated toward zero, with the lowest bit set when the sum is inexact. A narrower
### format with at most 51 bits rounds it to nearest exactly as it would the true sum, so B16's and BF16's
### mul_add add their exact B64 product this way and narrow once. Finite inputs. An infinite or NaN sum is
### returned as the addition gives it.
### :param a: The first addend, finite.
### :param b: The second addend, finite.
### :returns: `a + b` rounded to odd, or the plain sum when it is infinite or NaN.
secret routine b64_add_round_to_odd(a: B64, b: B64) -> B64
    local s: B64 = a +! b

    if s.is_finite()
        # TwoSum: e is exactly (a + b) - s.
        bv: B64 = s -! a
        av: B64 = s -! bv
        e: B64 = a -! av +! (b -! bv)
        inexact: Bool = e != 0.0
        low_bit: U64 = s.bits() & 1
        even: Bool = low_bit == 0
        if inexact and even
            # s rounded to an even neighbour: the odd one is the other neighbour of the true sum, one ulp toward e.
            outward: Bool = e.is_sign_negative() == s.is_sign_negative()
            bits: U64 = s.bits()
            odd: U64 = when
                outward => bits +% 1
                else => bits -% 1
            return B64.from_bits(odd)
        return s
    return s

### The rounding error of the product `p = x * y`: `x * y - p` rounded once, as `x.mul_add(y, p.neg())` gives it,
### which is exact whenever that difference is a B64 (unless the product underflows). With the FMA instruction.
### :param x: The first factor.
### :param y: The second factor.
### :param p: `x * y` rounded to nearest.
### :returns: `x.mul_add(y, p.neg())`.
@target(arch: "aarch64")
@inline
secret routine b64_mul_error(x: B64, y: B64, p: B64) -> B64
    e: B64 = x.mul_add_unchecked(a: y, b: -p)
    return e

### The rounding error of the product `p = x * y`: `x * y - p` rounded once, as `x.mul_add(y, p.neg())` gives it,
### which is exact whenever that difference is a B64 (unless the product underflows). With the x86 FMA instruction
### (targets with the `fma` feature).
### :param x: The first factor.
### :param y: The second factor.
### :param p: `x * y` rounded to nearest.
### :returns: `x.mul_add(y, p.neg())`.
@target(arch: "x86_64")
@feature("fma")
@inline
secret routine b64_mul_error(x: B64, y: B64, p: B64) -> B64
    e: B64 = x.mul_add_unchecked(a: y, b: -p)
    return e

### The rounding error of the product `p = x * y`: the same value as `x.mul_add(y, p.neg())`, by Dekker's product
### ({b64_mul_error_soft}) on x86 without the `fma` feature.
### :param x: The first factor.
### :param y: The second factor.
### :param p: `x * y` rounded to nearest.
### :returns: `x.mul_add(y, p.neg())`.
@target(arch: "x86_64")
@feature(not "fma")
@inline
secret routine b64_mul_error(x: B64, y: B64, p: B64) -> B64
    e: B64 = b64_mul_error_soft(x, y, p)
    return e

### The rounding error of the product `p = x * y`: the same value as `x.mul_add(y, p.neg())`, by Dekker's product
### ({b64_mul_error_soft}) on targets other than AArch64 and x86_64.
### :param x: The first factor.
### :param y: The second factor.
### :param p: `x * y` rounded to nearest.
### :returns: `x.mul_add(y, p.neg())`.
@target(arch: not ("aarch64", "x86_64"))
@inline
secret routine b64_mul_error(x: B64, y: B64, p: B64) -> B64
    e: B64 = b64_mul_error_soft(x, y, p)
    return e

### `x.mul_add(y, p.neg())` for `p = x * y` without an FMA instruction. When the factors are normal and below
### 2^996, and their exponents add up to a value in [-970, 1021], the error is a B64 and Dekker's product
### ({b64_dekker_error}) gives it exactly, so it equals the fused result. Elsewhere it is that fused result.
### :param x: The first factor.
### :param y: The second factor.
### :param p: `x * y` rounded to nearest.
### :returns: `x.mul_add(y, p.neg())`.
@inline
secret routine b64_mul_error_soft(x: B64, y: B64, p: B64) -> B64
    local field_x: U64 = (x.bits() >> 52) & 0x7FF
    local field_y: U64 = (y.bits() >> 52) & 0x7FF

    x_normal: Bool = field_x -% 1 < 2018
    y_normal: Bool = field_y -% 1 < 2018
    product: U64 = field_x +% field_y
    inside: Bool = product -% 1076 < 1992
    factors: Bool = x_normal and y_normal
    if factors and inside
        return b64_dekker_error(x, y, p)
    return x.mul_add_unchecked(a: y, b: -p)

### The rounding error of the product `p = x * y` (rounded to nearest), exactly: `x * y - p`, by Dekker's
### product. Each factor splits into a high part of 26 bits (its encoding rounded to nearest at bit 27, then
### cut there: two integer operations, where Veltkamp's split takes three dependent float operations) and a
### low part of at most 26 bits, so the four partial products are exact. Exact when `x` and `y` are normal
### and below 2^1023, `p` is finite, and the error is a multiple of 2^-1074, which holds when the exponents
### of `x` and `y` add up to at least -970.
### :param x: The first factor.
### :param y: The second factor.
### :param p: `x * y` rounded to nearest.
### :returns: `x * y - p`.
@inline
secret routine b64_dekker_error(x: B64, y: B64, p: B64) -> B64
    xr: U64 = x.bits() +% 0x4000000
    xh: B64 = B64.from_bits(xr & 0xFFFFFFFFF8000000)
    xl: B64 = x -! xh
    yr: U64 = y.bits() +% 0x4000000
    yh: B64 = B64.from_bits(yr & 0xFFFFFFFFF8000000)
    yl: B64 = y -! yh
    t1: B64 = p -! xh *! yh
    t2: B64 = t1 -! xh *! yl
    t3: B64 = t2 -! xl *! yh
    e: B64 = xl *! yl -! t3
    return e

### Narrows to B32 with round-to-odd, then rounds that to B16. B32's 24 bits are
### enough (2 * 11 + 2) for the second rounding to be exact.
### :returns: The nearest B16, rounded once. Values past the B16 range give a signed infinity.
routine B64.to[B16]() -> B16
    narrow: B32 = fptrunc[Me, B32](me)
    back: Me = narrow.to[Me]()
    inexact: Bool = back != me
    finite: Bool = narrow.is_finite()
    sticky: Bool = inexact and finite
    # Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
    away: Bool = sticky and back.abs() > me.abs()
    trunc: U32 = narrow.bits() - away.to[U32]()
    bits: U32 = trunc | sticky.to[U32]()
    odd: B32 = .from_bits(bits)
    r: B16 = odd.to[B16]()
    return r

### Narrows to B32 with round-to-odd (an inexact result gets its lowest bit set),
### then rounds that to BF16. Round-to-odd keeps the second rounding from
### double-rounding, because B32 has more than twice BF16's precision.
### :returns: The nearest BF16, rounded once.
routine B64.to[BF16]() -> BF16
    narrow: B32 = fptrunc[Me, B32](me)
    back: Me = narrow.to[Me]()
    inexact: Bool = back != me
    finite: Bool = narrow.is_finite()
    sticky: Bool = inexact and finite
    # Round-to-odd truncates, then sets the low bit: where fptrunc rounded away from zero, step back one ulp.
    away: Bool = sticky and back.abs() > me.abs()
    trunc: U32 = narrow.bits() - away.to[U32]()
    bits: U32 = trunc | sticky.to[U32]()
    odd: B32 = .from_bits(bits)
    r: BF16 = odd.to[BF16]()
    return r

### The identity conversion, so generic code can call `to[T]()` when `T` is B64.
### :returns: `me` unchanged.
routine B64.to[Me]() -> Me
    return me

# -- integer conversions ---------------------------------------------------------
#
# to_[int] rounds toward zero and crashes on NaN or a value out of the integer's
# range, while to_[int]_checked returns None instead and to_[int]_clamp saturates
# (NaN gives 0).

### Converts to S8, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-128, 127]. The crash reports the caller's location.
### :see: {B64.to_checked[S8]} to get an absent value instead, {B64.to_clamp[S8]} to saturate.
@track_caller
routine B64.to[S8]() -> S8
    if not me.is_trunc_in_range(lo: -128.0, hi: 128.0)
        crash_overflow()
    r: S8 = fptosi_sat[Me, S8](me)
    return r

### Converts to S8, rounding toward zero, without crashing.
### :returns: The integer part of `me` when it fits.
### :absent: When `me` is NaN or its integer part lies outside [-128, 127].
### :see: {B64.to[S8]} to crash instead, {B64.to_clamp[S8]} to saturate.
routine B64.to_checked[S8]() -> Maybe[S8]
    fits: Bool = me.is_trunc_in_range(lo: -128.0, hi: 128.0)
    value: S8 = fptosi_sat[Me, S8](me)
    r: Maybe[S8] = fits.then_present(value)
    return r

### Converts to S8, rounding toward zero and saturating at the ends of its range.
### :returns: The integer part of `me`, clamped to [-128, 127]. Infinities give the nearer end and NaN gives 0.
### :see: {B64.to_checked[S8]} to detect values that do not fit.
routine B64.to_clamp[S8]() -> S8
    r: S8 = fptosi_sat[Me, S8](me)
    return r

### Converts to S16, rounding toward zero.
### :returns: The integer part of `me`.
### :throws: Crashes with `IntegerOverflowError` when `me` is NaN or its integer part lies outside [-32768, 32767]. The crash reports the caller's location.
### :see: {B64.to_checked[S16]} to get an absent value instead, {B64.to_clamp[S16]} to saturate.
@track_caller
routine B64.to[S16]() -> S16
    if not me.is_trunc_in_range(lo: -32768.0, hi: 32768.0)
        crash_overflow()
    r: S16 = fptosi_sat[Me, S16](me)
    return r

### Converts to S16, rounding toward zero, without crashing.
### :returns: The integer part of `me` when it fits.
### :absent: When `me` is NaN or its integer part lies outside [-32768, 32767].
### :see: {B64.to[S16]} to crash instead, {B64.to_clamp[S16]} to saturate.
routine B64.to_checked[S16]() -> Maybe[S16]
    fits: Bool = me.is_trunc_in_range(lo: -32768.0, hi: 32768.0)
    value: S16 = fptosi_sat[Me, S16](me)
    r: Maybe[S16] = fits.then_present(value)
    return r

