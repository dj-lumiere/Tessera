### Converts `me` to `B32`, rounding to nearest, ties to even.
### :returns: The `B32` nearest to `me`.
routine S8.to[B32](me: Me) -> B32
    r: B32 = sitofp[Me, B32](me)
    return r

### Converts `me` to `B64`, rounding to nearest, ties to even.
### :returns: The `B64` nearest to `me`.
routine S8.to[B64](me: Me) -> B64
    r: B64 = sitofp[Me, B64](me)
    return r

# -- byte ------------------------------------------------------------------------

### Reinterprets the bits of `me` as a `Byte`.
### :returns: The same 8 bits as a `Byte`.
routine S8.bits(me: Me) -> Byte
    r: Byte = bitcast[Me, Byte](me)
    return r
