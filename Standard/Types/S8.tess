/// Converts `me` to `F32`, rounding to nearest, ties to even.
/// :returns: The `F32` nearest to `me`.
routine S8.to<F32>(me: Me) -> F32
    block entry()
        r : F32 = sitofp<Me, F32>(me)
        return(r)

/// Converts `me` to `F64`, rounding to nearest, ties to even.
/// :returns: The `F64` nearest to `me`.
routine S8.to<F64>(me: Me) -> F64
    block entry()
        r : F64 = sitofp<Me, F64>(me)
        return(r)

// -- byte ------------------------------------------------------------------------

/// Reinterprets the bits of `me` as a `Byte`.
/// :returns: The same 8 bits as a `Byte`.
routine S8.bits(me: Me) -> Byte
    block entry()
        r : Byte = bitcast<Me, Byte>(me)
        return(r)
