/// Converts `self` to `F32`, rounding to nearest, ties to even.
/// :returns: The nearest `F32` value.
routine S8.to<F32>(self: Self) -> F32
    block entry()
        r : F32 = sitofp<Self, F32>(self)
        return(r)

/// Converts `self` to `F64`, rounding to nearest, ties to even.
/// :returns: The nearest `F64` value.
routine S8.to<F64>(self: Self) -> F64
    block entry()
        r : F64 = sitofp<Self, F64>(self)
        return(r)

// -- byte ------------------------------------------------------------------------

/// The bits as a Byte.
/// :returns: The same 8 bits as a `Byte`.
routine S8.bits(self: Self) -> Byte
    block entry()
        r : Byte = bitcast<Self, Byte>(self)
        return(r)
