// Tessera stdlib: U8 — 8-bit unsigned integer
//
// Maps to LLVM IR i8. Every S / U width shares the same method set.
//
// add / sub / mul / div / mod / neg / abs / pow and lossy to<T>
// conversions crash when the result doesn't fit. Each has a _checked form
// that returns Option instead, and add / sub / mul / pow / neg / abs and the
// conversions have _wrap (modular) and _clamp (saturating) forms.

module Standard::Core

/// 8-bit unsigned integer, mapped to LLVM `i8`. Arithmetic, shifts, and lossy conversions crash when the result does not fit. The `_checked` forms return an `Option`, the `_wrap` forms are modular, and the `_clamp` forms saturate.
#llvm("i8")
record U8
conform Equatable<U8>, Comparable<U8>, Hashable<U8>

// -- constants -------------------------------------------------------------------

/// The smallest `U8` value, 0.
preset U8.MIN: U8 = 0
/// The largest `U8` value, `255`.
preset U8.MAX: U8 = 255
/// The width of `U8` in bits.
preset U8.BITS: U8 = 8

// -- bits ------------------------------------------------------------------------

/// Counts the bits of `self` that are 1.
/// :returns: The population count, between 0 and `BITS`.
routine U8.count_ones(self: Self) -> Self
    block entry()
        r : Self = popcount<Self>(self)
        return(r)

/// Counts the consecutive 0 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine U8.leading_zeros(self: Self) -> Self
    block entry()
        r : Self = clz<Self>(self, false)
        return(r)

/// Counts the consecutive 0 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is 0.
routine U8.trailing_zeros(self: Self) -> Self
    block entry()
        r : Self = ctz<Self>(self, false)
        return(r)

/// Reverses the order of all bits, so the most significant bit becomes the least significant.
/// :returns: The bit-reversed value.
routine U8.reverse_bits(self: Self) -> Self
    block entry()
        r : Self = bitreverse<Self>(self)
        return(r)

/// Counts the bits of `self` that are 0.
/// :returns: `BITS` minus the population count.
routine U8.count_zeros(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = popcount<Self>(inverted)
        return(r)

/// Counts the consecutive 1 bits starting at the most significant bit.
/// :returns: The count, which is `BITS` when `self` is `MAX`.
routine U8.leading_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = clz<Self>(inverted, false)
        return(r)

/// Counts the consecutive 1 bits starting at the least significant bit.
/// :returns: The count, which is `BITS` when `self` is `MAX`.
routine U8.trailing_ones(self: Self) -> Self
    block entry()
        inverted : Self = self.bitnot()
        r        : Self = ctz<Self>(inverted, false)
        return(r)

/// Tests whether exactly one bit of `self` is set.
/// :returns: True when `self` is a power of two.
routine U8.is_power_of_two(self: Self) -> Bool
    block entry()
        ones : Self = popcount<Self>(self)
        r    : Bool = ones.eq(1)
        return(r)

/// Bitwise AND of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set only when it is set in both operands.
routine U8.bitand(self: Self, other: Self) -> Self
    block entry()
        r : Self = band<Self>(self, other)
        return(r)

/// Bitwise OR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in either operand.
routine U8.bitor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bor<Self>(self, other)
        return(r)

/// Bitwise XOR of `self` and `other`.
/// :param other: The right-hand operand.
/// :returns: A value with each bit set when it is set in exactly one operand.
routine U8.bitxor(self: Self, other: Self) -> Self
    block entry()
        r : Self = bxor<Self>(self, other)
        return(r)

/// Bitwise NOT: flips every bit of `self`.
/// :returns: The complement, which equals `MAX - self`.
routine U8.bitnot(self: Self) -> Self
    block entry()
        r : Self = bnot<Self>(self)
        return(r)

// -- shifts ----------------------------------------------------------------------

/// Shifts the bits left by `n`, filling with 0 bits. A shift by `BITS` or more shifts every bit out and gives 0.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted left by `n`, or 0 when `n` is `BITS` or more.
/// :note: The raw shift is poison for an out-of-range amount, and the select never picks it.
routine U8.shl(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = shl<Self>(self, n)
        r        : Self = in_range
            ? shifted
            : 0
        return(r)

/// Shift right, logical: 0 bits fill in. A shift by `BITS` or more gives 0.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted right by `n`, or 0 when `n` is `BITS` or more.
routine U8.shr(self: Self, n: Self) -> Self
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        shifted  : Self = lshr<Self>(self, n)
        out      : Self = 0
        r        : Self = in_range
            ? shifted
            : out
        return(r)

/// Rotates the bits left by `n` modulo the bit width, so bits shifted out at the top re-enter at the bottom.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine U8.rotl(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshl<Self>(self, self, n)
        return(r)

/// Rotates the bits right by `n` modulo the bit width, so bits shifted out at the bottom re-enter at the top.
/// :param n: The rotate amount in bits.
/// :returns: The rotated value.
routine U8.rotr(self: Self, n: Self) -> Self
    block entry()
        r : Self = fshr<Self>(self, self, n)
        return(r)

/// Shift left that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted left by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine U8.shl_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = shl<Self>(self, n)
        return(Option<Self>.Present(r))

/// Logical shift right that reports an out-of-range amount.
/// :param n: The shift amount in bits.
/// :returns: `self` shifted right by `n`, with 0 bits filling in.
/// :absent: When `n` is outside `0 ..< BITS`.
routine U8.shr_checked(self: Self, n: Self) -> Option<Self>
    block entry()
        in_range : Bool = n.lt(Self.BITS)
        branch in_range
            ? continue
            : return(Option<Self>.Absent)
        r : Self = lshr<Self>(self, n)
        return(Option<Self>.Present(r))

/// Shifts left by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of shifting every bit out.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted left, with 0 bits filling in.
routine U8.shl_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 7)
        r      : Self = shl<Self>(self, amount)
        return(r)

/// Logical shift right by `n` modulo the bit width, so an amount of `BITS` or more wraps instead of giving 0.
/// :param n: The shift amount in bits, taken modulo `BITS`.
/// :returns: `self` shifted right with 0 bits filling in.
routine U8.shr_wrap(self: Self, n: Self) -> Self
    block entry()
        amount : Self = band<Self>(n, 7)
        r      : Self = lshr<Self>(self, amount)
        return(r)

// -- arithmetic ------------------------------------------------------------------

/// The sum of `self` and `other`.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `IntegerOverflowError` when the sum does not fit in `U8`.
#track_caller
routine U8.add(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = uadd_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = add<Self>(self, other)
        return(r)

/// Addition that reports overflow.
/// :param other: The value to add.
/// :returns: The sum.
/// :absent: When the exact sum does not fit in `U8`.
routine U8.add_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = uadd_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = add<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The sum of `self` and `other`, wrapped modulo 2^8.
/// :param other: The value to add.
/// :returns: The low 8 bits of the exact sum.
routine U8.add_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = add<Self>(self, other)
        return(r)

/// The sum of `self` and `other`, saturated at `MAX`.
/// :param other: The value to add.
/// :returns: The sum, or `MAX` when the exact sum is above the range.
routine U8.add_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = uadd_sat<Self>(self, other)
        return(r)

/// The difference of `self` and `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `IntegerOverflowError` when the difference does not fit in `U8`.
#track_caller
routine U8.sub(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = usub_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = sub<Self>(self, other)
        return(r)

/// Subtraction that reports overflow.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :absent: When the exact difference does not fit in `U8`.
routine U8.sub_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = usub_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = sub<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The difference of `self` and `other`, wrapped modulo 2^8.
/// :param other: The value to subtract.
/// :returns: The low 8 bits of the exact difference.
routine U8.sub_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = sub<Self>(self, other)
        return(r)

/// The difference of `self` and `other`, saturated at 0.
/// :param other: The value to subtract.
/// :returns: The difference, or 0 when the exact difference is below 0.
routine U8.sub_clamp(self: Self, other: Self) -> Self
    block entry()
        r : Self = usub_sat<Self>(self, other)
        return(r)

/// The product of `self` and `other`.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :throws: Crashes with `IntegerOverflowError` when the product does not fit in `U8`.
#track_caller
routine U8.mul(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = umul_overflows<Self>(self, other)
        branch overflow
            ? crash_overflow()
            : continue
        r : Self = mul<Self>(self, other)
        return(r)

/// Multiplication that reports overflow.
/// :param other: The factor to multiply by.
/// :returns: The product.
/// :absent: When the exact product does not fit in `U8`.
routine U8.mul_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        overflow : Bool         = umul_overflows<Self>(self, other)
        fits     : Bool         = overflow.bitnot()
        result   : Self         = mul<Self>(self, other)
        r        : Option<Self> = fits.then_present(result)
        return(r)

/// The product of `self` and `other`, wrapped modulo 2^8.
/// :param other: The factor to multiply by.
/// :returns: The low 8 bits of the exact product.
routine U8.mul_wrap(self: Self, other: Self) -> Self
    block entry()
        r : Self = mul<Self>(self, other)
        return(r)

/// The product of `self` and `other`, saturated at `MAX`.
/// :param other: The factor to multiply by.
/// :returns: The product, or `MAX` when the exact product is above the range.
routine U8.mul_clamp(self: Self, other: Self) -> Self
    block entry()
        overflow : Bool = self.mul_overflows(other)
        product  : Self = mul<Self>(self, other)
        r        : Self = overflow
            ? Self.MAX
            : product
        return(r)

/// Tests whether the exact product of `self` and `other` is outside `MIN ..= MAX`.
/// :param other: The factor to multiply by.
/// :returns: True when the product does not fit in `U8`.
routine U8.mul_overflows(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = umul_overflows<Self>(self, other)
        return(r)

/// The exact product of `self` and `other` in twice the width. It never overflows.
/// :param other: The factor to multiply by.
/// :returns: The product as a `U16`.
routine U8.mul_wide(self: Self, other: Self) -> U16
    block entry()
        r : U16 = self.to<U16>().mul_wrap(other.to<U16>())
        return(r)

// -- division --------------------------------------------------------------------

/// The quotient of `self` divided by `other`, truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U8.div(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Self = udiv<Self>(self, other)
        return(r)

/// The remainder of `self` divided by `other`.
/// :param other: The divisor.
/// :returns: The remainder, between 0 and `other - 1`.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U8.mod(self: Self, other: Self) -> Self
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? crash_division_by_zero()
            : continue
        r : Self = urem<Self>(self, other)
        return(r)

/// Division that reports failure instead of crashing. The quotient is truncated toward zero.
/// :param other: The divisor.
/// :returns: The quotient of `self` divided by `other`.
/// :absent: On a zero divisor.
routine U8.div_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = udiv<Self>(self, other)
        return(Option<Self>.Present(r))

/// Remainder that reports failure instead of crashing.
/// :param other: The divisor.
/// :returns: The remainder of `self` divided by `other`.
/// :absent: On a zero divisor.
routine U8.mod_checked(self: Self, other: Self) -> Option<Self>
    block entry()
        by_zero : Bool = other.eq(0)
        branch by_zero
            ? return(Option<Self>.Absent)
            : continue
        r : Self = urem<Self>(self, other)
        return(Option<Self>.Present(r))

/// The quotient of `self` divided by `other`, rounded up.
/// :param other: The divisor.
/// :returns: The quotient, rounded up.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0.
#track_caller
routine U8.div_ceil(self: Self, other: Self) -> Self
    block entry()
        q     : Self = self.div(other)
        rem   : Self = urem<Self>(self, other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(q)
            : continue
        r : Self = add<Self>(q, 1)
        return(r)

/// The smallest multiple of `other` that is at least `self`.
/// :param other: The value whose multiple to round up to.
/// :returns: `self` when it is already a multiple of `other`, else the next multiple above it.
/// :throws: Crashes with `DivisionByZeroError` when `other` is 0, and with `IntegerOverflowError` when the multiple does not fit in `U8`.
#track_caller
routine U8.next_multiple_of(self: Self, other: Self) -> Self
    block entry()
        rem   : Self = self.mod(other)
        exact : Bool = rem.eq(0)
        branch exact
            ? return(self)
            : continue
        gap : Self = sub<Self>(other, rem)
        r   : Self = self.add(gap)
        return(r)

/// The smallest power of two that is at least `self`. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :throws: Crashes with `IntegerOverflowError` when the power of two does not fit in `U8`.
#track_caller
routine U8.next_power_of_two(self: Self) -> Self
    block entry()
        r : Option<Self> = self.next_power_of_two_checked()
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// The smallest power of two that is at least `self`, reporting when it does not fit. Both 0 and 1 give 1.
/// :returns: The power of two.
/// :absent: When the power of two does not fit in `U8`.
routine U8.next_power_of_two_checked(self: Self) -> Option<Self>
    block entry()
        small : Bool = self.le(1)
        branch small
            ? return(Option<Self>.Present(1))
            : round_up()

    // A shift by the full width would be poison, so check the amount first.
    block round_up()
        below : Self = sub<Self>(self, 1)
        lz    : Self = clz<Self>(below, true)
        shift : Self = sub<Self>(Self.BITS, lz)
        fits  : Bool = shift.lt(Self.BITS)
        branch fits
            ? continue
            : return(Option<Self>.Absent)
        power : Self = shl<Self>(1, shift)
        return(Option<Self>.Present(power))

// -- powers ----------------------------------------------------------------------

/// Raises `self` to the power `exponent`.
/// :param exponent: The power to raise to.
/// :returns: `self` to the power `exponent`.
/// :throws: Crashes with `IntegerOverflowError` when the exact power does not fit in `U8`.
#track_caller
routine U8.pow(self: Self, exponent: U32) -> Self
    block entry()
        r : Option<Self> = self.pow_checked(exponent)
        when r
            .Present(value) -> return(value)
            .Absent         -> crash_overflow()

/// Raises `self` to the power `exponent` by squaring, wrapping modulo 2^8.
/// :param exponent: The power to raise to.
/// :returns: The low 8 bits of the exact power.
routine U8.pow_wrap(self: Self, exponent: U32) -> Self
    shared base : @Self <- self
    shared acc  : @Self <- 1

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? return(acc.load())
            : continue
        odd       : Bool = exponent_left.bitand(1).ne(0)
        with_base : Self = mul<Self>(acc.load(), base.load())
        next_acc  : Self = odd
            ? with_base
            : acc.load()
        next_acc2 : Self = next_acc
        next_base : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        jump loop(exponent_left.shr(1))

/// Power that reports overflow.
/// :param exponent: The power to raise to.
/// :returns: `self` to the power `exponent`.
/// :absent: When the exact power does not fit in `U8`.
routine U8.pow_checked(self: Self, exponent: U32) -> Option<Self>
    shared base     : @Self <- self
    shared acc      : @Self <- 1
    shared overflow : @Bool <- false

    block entry()
        jump loop(exponent)

    block loop(exponent_left: U32)
        done : Bool = exponent_left.eq(0)
        branch done
            ? finish()
            : step(exponent_left)

    // The accumulator only multiplies on odd bits, and the base only needs
    // squaring while bits remain, so only those overflows count.
    block step(exponent_left: U32)
        odd          : Bool = exponent_left.bitand(1).ne(0)
        acc_overflow : Bool = umul_overflows<Self>(acc.load(), base.load()).bitand(odd)
        with_base    : Self = mul<Self>(acc.load(), base.load())
        next_acc     : Self = odd
            ? with_base
            : acc.load()
        rest          : U32  = exponent_left.shr(1)
        more          : Bool = rest.ne(0)
        base_overflow : Bool = umul_overflows<Self>(base.load(), base.load()).bitand(more)
        any           : Bool = overflow.load().bitor(acc_overflow).bitor(base_overflow)
        next_overflow : Bool = any
        next_acc2     : Self = next_acc
        next_base     : Self = mul<Self>(base.load(), base.load())
        next_base.store_into(base)
        next_acc2.store_into(acc)
        next_overflow.store_into(overflow)
        jump loop(rest)

    block finish()
        fits : Bool         = overflow.load().bitnot()
        r    : Option<Self> = fits.then_present(acc.load())
        return(r)

/// Raises `self` to the power `exponent`, saturated at `MAX`.
/// :param exponent: The power to raise to.
/// :returns: The power, or `MAX` when the exact power does not fit.
routine U8.pow_clamp(self: Self, exponent: U32) -> Self
    block entry()
        checked : Option<Self> = self.pow_checked(exponent)
        r       : Self         = checked.unwrap_or(Self.MAX)
        return(r)

// -- equality and ordering -------------------------------------------------------

/// Tests whether `self` and `other` are equal.
/// :param other: The value to compare with.
/// :returns: True when the values are equal.
routine U8.eq(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ieq<Self>(self, other)
        return(r)

/// Tests whether `self` and `other` differ.
/// :param other: The value to compare with.
/// :returns: True when the values are not equal.
routine U8.ne(self: Self, other: Self) -> Bool
    block entry()
        r : Bool = ine<Self>(self, other)
        return(r)

/// Unsigned less-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self < other`.
#[external("llvm"), template("{result} = icmp ult i8 {self}, {other}")]
routine U8.lt(self: Self, other: Self) -> Bool

/// Unsigned less-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self <= other`.
#[external("llvm"), template("{result} = icmp ule i8 {self}, {other}")]
routine U8.le(self: Self, other: Self) -> Bool

/// Unsigned greater-than comparison.
/// :param other: The value to compare with.
/// :returns: True when `self > other`.
#[external("llvm"), template("{result} = icmp ugt i8 {self}, {other}")]
routine U8.gt(self: Self, other: Self) -> Bool

/// Unsigned greater-than-or-equal comparison.
/// :param other: The value to compare with.
/// :returns: True when `self >= other`.
#[external("llvm"), template("{result} = icmp uge i8 {self}, {other}")]
routine U8.ge(self: Self, other: Self) -> Bool

/// Compares `self` with `other` by unsigned order.
/// :param other: The value to compare with.
/// :returns: -1 when `self < other`, 0 when they are equal, and 1 when `self > other`.
routine U8.compare(self: Self, other: Self) -> S32
    block entry()
        lt : Bool = self.lt(other)
        branch lt
            ? return(-1)
            : continue
        gt : Bool = self.gt(other)
        branch gt
            ? return(1)
            : return(0)

/// Returns the smaller of two values by unsigned comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is smaller.
routine U8.min(self: Self, other: Self) -> Self
    block entry()
        r : Self = umin<Self>(self, other)
        return(r)

/// Returns the larger of two values by unsigned comparison.
/// :param other: The value to compare with.
/// :returns: `self` or `other`, whichever is larger.
routine U8.max(self: Self, other: Self) -> Self
    block entry()
        r : Self = umax<Self>(self, other)
        return(r)

/// Limits `self` to the range from `lo` to `hi`, both ends included.
/// :param lo: The lower bound.
/// :param hi: The upper bound.
/// :returns: `lo` when `self < lo`, `hi` when `self > hi`, otherwise `self`.
/// :throws: Crashes with `InvalidValueError` when `lo > hi`.
#track_caller
routine U8.clamp(self: Self, lo: Self, hi: Self) -> Self
    block entry()
        valid : Bool = lo.le(hi)
        branch valid
            ? clamp()
            : crash_invalid_value()

    block clamp()
        at_least_lo : Self = umax<Self>(self, lo)
        r           : Self = umin<Self>(at_least_lo, hi)
        return(r)

/// Tests whether `self` is in `[lo, hi]`, both ends included. False when `lo > hi`.
/// :param lo: The lower bound, included.
/// :param hi: The upper bound, included.
/// :returns: True when `lo <= self <= hi`.
routine U8.between(self: Self, lo: Self, hi: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.le(hi))
        return(r)

/// Tests whether `self` is in `[lo, end)`: `lo` included, `end` not. False when `lo >= end`.
/// :param lo: The lower bound, included.
/// :param end: The upper bound, excluded.
/// :returns: True when `lo <= self < end`.
routine U8.in_range(self: Self, lo: Self, end: Self) -> Bool
    block entry()
        r : Bool = self.ge(lo).bitand(self.lt(end))
        return(r)

// -- hash ------------------------------------------------------------------------

/// SipHash-2-4 of the bits widened to 64, under the process key, the same hash for `S8` and `U8`.
/// :returns: The 64-bit hash of `self`.
routine U8.hash(self: Self) -> U64
    block entry()
        bits : Self = bitcast<Self, Self>(self)
        h    : U64  = siphash24(bits.to<U64>(), hash_key())
        return(h)

// -- differences, midpoints, logarithms, roots -----------------------------------

/// The distance between `self` and `other`, `|self - other|`, which always fits in `U8`.
/// :param other: The value to measure from.
/// :returns: `|self - other|` as a `U8`.
routine U8.abs_diff(self: Self, other: Self) -> Self
    block entry()
        hi   : Self = umax<Self>(self, other)
        lo   : Self = umin<Self>(self, other)
        diff : Self = sub<Self>(hi, lo)
        r    : Self = bitcast<Self, Self>(diff)
        return(r)

/// The average of `self` and `other`, rounded down, computed without overflow.
/// :param other: The other value.
/// :returns: `(self + other) / 2`, rounded down.
routine U8.midpoint(self: Self, other: Self) -> Self
    block entry()
        common    : Self = self.bitand(other)
        half_diff : Self = self.bitxor(other).shr(1)
        r         : Self = add<Self>(common, half_diff)
        return(r)

/// The base-2 logarithm of `self`, rounded down.
/// :returns: `floor(log2(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0.
#track_caller
routine U8.ilog2(self: Self) -> Self
    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? crash_numeric_domain()
            : continue
        lz : Self = clz<Self>(self, true)
        r  : Self = sub<Self>(Self.BITS.sub(1), lz)
        return(r)

/// The base-10 logarithm of `self`, rounded down.
/// :returns: `floor(log10(self))`.
/// :throws: Crashes with `NumericDomainError` when `self` is 0.
#track_caller
routine U8.ilog10(self: Self) -> Self
    shared digits : @Self <- 0

    block entry()
        zero : Bool = self.eq(0)
        branch zero
            ? crash_numeric_domain()
            : loop(self)

    block loop(rest: Self)
        last : Bool = rest.lt(10)
        branch last
            ? return(digits.load())
            : continue
        digits.load().add(1).store_into(digits)
        jump loop(rest.div(10))

/// The integer square root of `self`, rounded down.
/// :returns: `floor(sqrt(self))`.
routine U8.isqrt(self: Self) -> Self
    block entry()
        top_bit : Self = shl<Self>(1, Self.BITS.sub(2))
        jump align(top_bit)

    // Start from the highest power of four that is <= self.
    block align(bit: Self)
        too_big : Bool = bit.gt(self)
        branch too_big
            ? align(bit.shr(2))
            : loop(self, 0, bit)

    block loop(rest: Self, root: Self, bit: Self)
        done : Bool = bit.eq(0)
        branch done
            ? return(root)
            : continue
        trial     : Self = add<Self>(root, bit)
        fits      : Bool = rest.ge(trial)
        half_root : Self = root.shr(1)
        next_bit  : Self = bit.shr(2)
        branch fits
            ? take(rest, trial, half_root, bit, next_bit) \
            : loop(rest, half_root, next_bit)

    block take(rest: Self, trial: Self, half_root: Self, bit: Self, next_bit: Self)
        jump loop(sub<Self>(rest, trial), add<Self>(half_root, bit), next_bit)

// -- conversions -----------------------------------------------------------------

/// to<T> returns the same value in another integer type. A conversion that
/// can't lose the value returns it directly. One that can crashes when the value
/// doesn't fit, and has to_checked<T> (Option), to_wrap<T> (keep the low bits),
/// and to_clamp<T> (saturate) forms.
/// Converts `self` to `S8`.
/// :returns: The same numeric value as an `S8`.
/// :throws: Crashes with `IntegerOverflowError` when the value does not fit in `S8`.
#track_caller
routine U8.to<S8>(self: Self) -> S8
    block entry()
        fits : Bool = self.le(127)
        branch fits
            ? continue
            : crash_overflow()
        r : S8 = bitcast<Self, S8>(self)
        return(r)

/// Converts `self` to `S8` when the value fits.
/// :returns: The value as an `S8`.
/// :absent: When `self` is outside the range of `S8`.
routine U8.to_checked<S8>(self: Self) -> Option<S8>
    block entry()
        fits  : Bool       = self.le(127)
        value : S8         = bitcast<Self, S8>(self)
        r     : Option<S8> = fits.then_present(value)
        return(r)

/// Converts `self` to `S8`, keeping the low 8 bits (modulo 2^8).
/// :returns: The low bits of `self`, read as an `S8`.
routine U8.to_wrap<S8>(self: Self) -> S8
    block entry()
        r : S8 = bitcast<Self, S8>(self)
        return(r)

/// Converts `self` to `S8`, saturating at `S8.MAX`.
/// :returns: The value, or `S8.MAX` when it is greater.
routine U8.to_clamp<S8>(self: Self) -> S8
    block entry()
        at_most : Self = umin<Self>(self, 127)
        r       : S8   = bitcast<Self, S8>(at_most)
        return(r)

/// Converts `self` to `S16`. Every `U8` value fits in `S16`, so the conversion never fails.
/// :returns: The same numeric value as an `S16`.
routine U8.to<S16>(self: Self) -> S16
    block entry()
        r : S16 = zext<Self, S16>(self)
        return(r)

/// Converts `self` to `S32`. Every `U8` value fits in `S32`, so the conversion never fails.
/// :returns: The same numeric value as an `S32`.
routine U8.to<S32>(self: Self) -> S32
    block entry()
        r : S32 = zext<Self, S32>(self)
        return(r)

/// Converts `self` to `S64`. Every `U8` value fits in `S64`, so the conversion never fails.
/// :returns: The same numeric value as an `S64`.
routine U8.to<S64>(self: Self) -> S64
    block entry()
        r : S64 = zext<Self, S64>(self)
        return(r)

/// Converts `self` to `S128`. Every `U8` value fits in `S128`, so the conversion never fails.
/// :returns: The same numeric value as an `S128`.
routine U8.to<S128>(self: Self) -> S128
    block entry()
        r : S128 = zext<Self, S128>(self)
        return(r)

/// Converts `self` to `S256`. Every `U8` value fits in `S256`, so the conversion never fails.
/// :returns: The same numeric value as an `S256`.
routine U8.to<S256>(self: Self) -> S256
    block entry()
        r : S256 = zext<Self, S256>(self)
        return(r)

/// The identity conversion: returns `self` unchanged.
/// :returns: `self` as `U8`.
routine U8.to<Self>(self: Self) -> Self
    block entry()
        return(self)

/// Converts `self` to `U16`. Every `U8` value fits in `U16`, so the conversion never fails.
/// :returns: The same numeric value as a `U16`.
routine U8.to<U16>(self: Self) -> U16
    block entry()
        r : U16 = zext<Self, U16>(self)
        return(r)

/// Converts `self` to `U32`. Every `U8` value fits in `U32`, so the conversion never fails.
/// :returns: The same numeric value as a `U32`.
routine U8.to<U32>(self: Self) -> U32
    block entry()
        r : U32 = zext<Self, U32>(self)
        return(r)

/// Converts `self` to `U64`. Every `U8` value fits in `U64`, so the conversion never fails.
/// :returns: The same numeric value as a `U64`.
routine U8.to<U64>(self: Self) -> U64
    block entry()
        r : U64 = zext<Self, U64>(self)
        return(r)

/// Converts `self` to `U128`. Every `U8` value fits in `U128`, so the conversion never fails.
/// :returns: The same numeric value as a `U128`.
routine U8.to<U128>(self: Self) -> U128
    block entry()
        r : U128 = zext<Self, U128>(self)
        return(r)

/// Converts `self` to `U256`. Every `U8` value fits in `U256`, so the conversion never fails.
/// :returns: The same numeric value as a `U256`.
routine U8.to<U256>(self: Self) -> U256
    block entry()
        r : U256 = zext<Self, U256>(self)
        return(r)

/// Converts `self` to `F32`, rounding to nearest, ties to even.
/// :returns: The `F32` nearest to `self`.
routine U8.to<F32>(self: Self) -> F32
    block entry()
        r : F32 = uitofp<Self, F32>(self)
        return(r)

/// Converts `self` to `F64`, rounding to nearest, ties to even.
/// :returns: The `F64` nearest to `self`.
routine U8.to<F64>(self: Self) -> F64
    block entry()
        r : F64 = uitofp<Self, F64>(self)
        return(r)

// -- byte ------------------------------------------------------------------------

/// Reinterprets the bits of `self` as a `Byte`.
/// :returns: The same 8 bits as a `Byte`.
routine U8.bits(self: Self) -> Byte
    block entry()
        r : Byte = bitcast<Self, Byte>(self)
        return(r)
