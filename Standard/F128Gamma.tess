    0x212F9D7FE00E86BF, 0xDEC6A3133DAA155D, 0xCFB08F8D13458B4D, 0x94BC900144192023,
    0xEB3F8E4325F5A534 }

preset BIG_LN_PI: @Array<U64, 7> <- { 0x39C5543C3AB0C9BA, 0x69201612B6D85C33, 0x2D53626FA918B073,
    0x19C0176577D49847, 0x2F36EDF9D9F93037, 0xAFCAB635421FA4CC, 0x928682473D0DE85E }

routine wide_gamma_coef(i: USize) -> F128Extended
    block entry():
        w   : F128Extended = wide_table(WIDE_GAMMA_COEF_HI.to<@U128>(),
            WIDE_GAMMA_COEF_LO.to<@U64>(), WIDE_GAMMA_COEF_EXP.to<@S64>(), i)
        neg : Bool         = WIDE_GAMMA_COEF_NEG.get(i)
        r   : F128Extended = neg
            ? w.neg()
            : w
        return(r)

// -- fast tier: F128Extended ---------------------------------------------------

/// ln |Γ| in F128Extended, and the scale of its error: the largest exponent among the terms summed
/// into it. Each term is off by about 2^-188 of itself, so the value is off by about 2^(scale -
/// 188) however much of the sum cancels; the fast tier measures its band against that scale, not
/// against the value.
record LnGammaWide
    value : F128Extended
    scale : S64

/// Entry i of the ln Γ(1 + z) table (two false) or the ln Γ(2 + z) one: the coefficient of z^(i +
/// 1).
routine ln_gamma_near_coef(two: Bool, i: USize) -> F128Extended
    block entry():
        branch two
            ? near_two()
            : near_one()

    block near_one():
        w   : F128Extended = wide_table(LN_GAMMA_NEAR_ONE_HI.to<@U128>(),
            LN_GAMMA_NEAR_ONE_LO.to<@U64>(), LN_GAMMA_NEAR_ONE_EXP.to<@S64>(), i)
        neg : Bool         = LN_GAMMA_NEAR_ONE_NEG.get(i)
        r   : F128Extended = neg
            ? w.neg()
            : w
        return(r)

    block near_two():
        w   : F128Extended = wide_table(LN_GAMMA_NEAR_TWO_HI.to<@U128>(),
            LN_GAMMA_NEAR_TWO_LO.to<@U64>(), LN_GAMMA_NEAR_TWO_EXP.to<@S64>(), i)
        neg : Bool         = LN_GAMMA_NEAR_TWO_NEG.get(i)
        r   : F128Extended = neg
            ? w.neg()
            : w
        return(r)

/// Entry i of WIDE_EXP_COEF, 1 / i!.
routine wide_exp_coef(i: USize) -> F128Extended
    block entry():
        w : F128Extended = wide_table(WIDE_EXP_COEF_HI.to<@U128>(), WIDE_EXP_COEF_LO.to<@U64>(),
            WIDE_EXP_COEF_EXP.to<@S64>(), i)
        return(w)

/// e^x as wide_exp computes it, but with all 36 Taylor terms: x = q ln 2 + d with |d| <= ln 2 / 2,
/// and the first dropped term is below 2^-193, so the result is within about 2^-189 relative, plus
/// 2^-191 |x| from the reduction. For |x| below about 12000 (the callers check).
routine gamma_wide_exp(x: F128Extended) -> F128Extended
    block entry():
        q    : S64          = x.mul(wide_const(1)).to_i64_nearest()
        d    : F128Extended = x.sub(wide_from_i64(q).mul(wide_const(0)))
        last : F128Extended = wide_exp_coef(35)
        jump horner(34, last, d, q)

    block horner(i: S64, s: F128Extended, d: F128Extended, q: S64):
        done : Bool = i.lt(0)
        branch done
            ? return(s.ldexp(q))
            : continue
        c : F128Extended = wide_exp_coef(i.to<USize>())
        jump horner(i.sub(1), s.mul(d).add(c), d, q)

/// ln a for a > 0: a = m 2^e with m in [1, 2), and ln m from F128's correctly rounded ln
/// (CORE-MATH) refined by one Newton step y ← y + m e^-y - 1, which squares its 2^-113 error away.
/// Within about 2^-188 absolute, plus 2^-192 |e| from ln 2.
routine gamma_wide_ln(a: F128Extended) -> F128Extended
    block entry():
        e      : S64          = a.exponent
        m      : F128Extended = a.ldexp(0.sub(e))
        y      : F128Extended = wide_from_f128(m.to<F128>().ln())
        step   : F128Extended = m.mul(gamma_wide_exp(y.neg())).sub(wide_one())
        scaled : F128Extended = wide_from_i64(e).mul(wide_const(0))
        r      : F128Extended = y.add(step).add(scaled)
        return(r)

/// Whether |z| < 2^-5, where the Taylor series of ln Γ around 1 and 2 take over.
routine wide_is_small(z: F128Extended) -> Bool
    block entry():
        r : Bool = z.is_zero().bitor(z.exponent.lt(-5))
        return(r)

/// ln Γ(1 + z) = -γ z + Σ (-1)^k ζ(k) / k z^k (40 terms), or ln Γ(2 + z) = (1 - γ) z + Σ (-1)^k
/// (ζ(k) - 1) / k z^k (34 terms), for |z| < 2^-5: the first dropped term is below 2^-204 of the
/// first one. Near the zeros at 1 and 2 this keeps the error relative to the value.
routine wide_ln_gamma_near(z: F128Extended, two: Bool) -> LnGammaWide
    block entry():
        count : USize = two
            ? 34
            : 40
        last : F128Extended = ln_gamma_near_coef(two, count.sub(1))
        jump horner(count.sub(1), last)

    // s ← s z + c_i, down to i = 0; the value is then s z
    block horner(i: USize, s: F128Extended):
        done : Bool = i.eq(0)
        branch done
            ? finish(s.mul(z))
            : continue
        c : F128Extended = ln_gamma_near_coef(two, i.sub(1))
        jump horner(i.sub(1), s.mul(z).add(c))

    // the terms fall by 2^-5 or faster, so the value's own exponent (plus one) is the scale
    block finish(value: F128Extended):
        r : LnGammaWide = LnGammaWide { value: value, scale: value.exponent.add(1) }
        return(r)

/// ln |Γ(a)| for a > 0 or -1 < a < 0 (a exact in F128Extended), floor = floor(a) (saturated): the
/// series near 1 and 2; else the recurrence Γ(a) = Γ(a + n) / (a (a + 1) … (a + n - 1)) up to a + n
/// in [30, 31), and Stirling's series there, 36 terms in 1/b² (the first dropped one is below
/// 2^-207 at b = 30).
routine wide_ln_gamma_positive(a: F128Extended, floor: S64) -> LnGammaWide
    block entry():
        z1     : F128Extended = a.sub(wide_one())
        z2     : F128Extended = a.sub(wide_from_i64(2))
        near_1 : Bool         = wide_is_small(z1)
        near_2 : Bool         = wide_is_small(z2)
        steps  : S64          = GAMMA_WIDE_LIFT.sub(floor).max(0)
        when:
            near_1 -> return(wide_ln_gamma_near(z1, false))
            near_2 -> return(wide_ln_gamma_near(z2, true))
            else   -> lift(0, steps, wide_one())

    // w = a (a + 1) … (a + j - 1)
    block lift(j: S64, steps: S64, w: F128Extended):
        done : Bool = j.ge(steps)
        branch done
            ? stirling(a.add(wide_from_i64(steps)), w)
            : lift(j.add(1), steps, w.mul(a.add(wide_from_i64(j))))

    block stirling(b: F128Extended, w: F128Extended):
        inv_bb : F128Extended = wide_one().div(b.mul(b))
        last   : F128Extended = wide_gamma_coef(35)
        jump series(34, last, b, w, inv_bb)

    block series(i: S64, s: F128Extended, b: F128Extended, w: F128Extended, inv_bb: F128Extended):
        done : Bool = i.lt(0)
        branch done
            ? assemble(s, b, w)
            : continue
        c : F128Extended = wide_gamma_coef(i.to<USize>())
        jump series(i.sub(1), s.mul(inv_bb).add(c), b, w, inv_bb)

    // (b - 1/2) ln b - b + ln(2π)/2 + series / b - ln |w|
    block assemble(s: F128Extended, b: F128Extended, w: F128Extended):
        half           : F128Extended = wide_one().ldexp(-1)
        main           : F128Extended = b.sub(half).mul(gamma_wide_ln(b))
        ln_w           : F128Extended = gamma_wide_ln(w.abs())
        half_ln_two_pi : F128Extended = wide_special(1).ldexp(-1)
        tail           : F128Extended = half_ln_two_pi.add(s.div(b))
        ln_gamma_b     : F128Extended = main.sub(b).add(tail)
        value          : F128Extended = ln_gamma_b.sub(ln_w)
        scale          : S64          = main.exponent.max(b.exponent).max(ln_w.exponent)
        r              : LnGammaWide  = LnGammaWide { value: value, scale: scale }
        return(r)

/// |sin πx| for a finite x that is not an integer: πx = r π/2 + θ exactly reduced (f128_pi_reduce),
/// then sin θ = 2 s c or cos θ = (c - s)(c + s) from s, c at θ/2, where the series' first dropped
/// term is below 2^-186.
routine wide_abs_sin_pi(x: F128) -> F128Extended
    block entry():
        red   : PiReduced    = f128_pi_reduce(x)
        theta : F128Extended = wide_from_f128(red.d).mul(wide_half_pi())
        half  : F128Extended = theta.ldexp(-1)
        s     : F128Extended = wide_sin_core(half)
        c     : F128Extended = wide_cos_core(half)
        odd   : Bool         = red.quadrant.bitand(1).eq(1)
        sin   : F128Extended = s.mul(c).ldexp(1)
        cos   : F128Extended = c.sub(s).mul(c.add(s))
        r     : F128Extended = odd
            ? cos.abs()
            : sin.abs()
        return(r)

/// ln |Γ(x)| in F128Extended for a finite x that is not a pole. Below -1, reflection: ln |Γ(x)| =
/// ln π - ln |sin πx| - ln Γ(1 - x).
routine wide_ln_gamma(x: F128) -> LnGammaWide
    block entry():
        reflect : Bool = x.lt(f128_of(0xBFFF0000000000000000000000000000))  // -1
        branch reflect
            ? reflected()
            : continue
        r : LnGammaWide = wide_ln_gamma_positive(wide_from_f128(x), x.floor().to_clamp<S64>())
        return(r)

    // floor(1 - x) = 1 - ceil(x), exact for |x| < 2^112 (the larger ones are poles)
    block reflected():
        a              : F128Extended = wide_one().sub(wide_from_f128(x))
        one_minus_ceil : F128         = f128_of(F128_ONE).sub(x.ceil())
        floor          : S64          = one_minus_ceil.to_clamp<S64>()
        inner          : LnGammaWide  = wide_ln_gamma_positive(a, floor)
        ln_sin         : F128Extended = gamma_wide_ln(wide_abs_sin_pi(x))
        reflection     : F128Extended = wide_special(2).sub(ln_sin)
        value          : F128Extended = reflection.sub(inner.value)
        inner_scale    : S64          = inner.scale.max(inner.value.exponent)
        scale          : S64          = inner_scale.max(ln_sin.exponent).max(1)
        r              : LnGammaWide  = LnGammaWide { value: value, scale: scale }
        return(r)

/// The band left for the fast tier's value once cancellation took its bits: band minus how far the
/// value fell below its scale.
routine ln_gamma_band(l: LnGammaWide, band: S64) -> S64
    block entry():
        lost : S64 = l.scale.sub(l.value.exponent).max(0)
        r    : S64 = band.sub(lost)
        return(r)

// -- exact tier: F128Big -------------------------------------------------------

routine big_half_ln_two_pi() -> F128Big
    block entry():
        r : F128Big = big_from_limbs(BIG_HALF_LN_TWO_PI.to<@U64>(), -448)
        return(r)

routine big_ln_pi() -> F128Big
    block entry():
        r : F128Big = big_from_limbs(BIG_LN_PI.to<@U64>(), -447)
        return(r)

/// c_(i+1) = B(2i + 2) / ((2i + 2)(2i + 1)): 1/12, -1/360, 1/1260, …
routine big_stirling_coef(i: USize) -> F128Big
    block entry():
        limbs : @U64    = BIG_STIRLING_LIMBS.to<@U64>()
        c     : F128Big = big_from_limbs(limbs.stride(i.mul(7)), BIG_STIRLING_EXP.get(i))
        odd   : Bool    = i.bitand(1).eq(1)
        r     : F128Big = odd
            ? c.neg()
            : c
        return(r)

/// ln Γ(b) for b >= 100 by Stirling's series (b - 1/2) ln b - b + ln(2π)/2 + Σ c_k / b^(2k-1). For
/// a real b > 0 the remainder after any term is below the first term left out, and the terms fall
/// while k < π b; at b = 100 the 62nd is below 2^-470, so the sum stops at its first negligible
/// term (big_negligible) within the 61 of the table.
routine big_stirling(b: F128Big) -> F128Big
    block entry():
        inv    : F128Big = b.recip()
        inv_sq : F128Big = inv.mul(inv)
        jump series(0, inv, big_zero(), inv_sq)

    // power = 1 / b^(2i + 1)
    block series(i: USize, power: F128Big, sum: F128Big, inv_sq: F128Big):
        full : Bool = i.ge(61)
        branch full
            ? assemble(sum)
            : continue
        term : F128Big = big_stirling_coef(i).mul(power)
        done : Bool    = big_negligible(term, sum)
        branch done
            ? assemble(sum)
            : series(i.add(1), power.mul(inv_sq), sum.add(term), inv_sq)

    block assemble(sum: F128Big):
        half    : F128Big = big_one().ldexp(-1)
        main    : F128Big = b.sub(half).mul(big_ln(b))
        leading : F128Big = main.sub(b).add(big_half_ln_two_pi())
        r       : F128Big = leading.add(sum)
        return(r)

/// ln |Γ(a)| for a > 0 or -1 < a < 0, floor = floor(a) (saturated): the recurrence up to a + n in
/// [100, 101), then Stirling's series.
routine big_ln_gamma_positive(a: F128Big, floor: S64) -> F128Big
    block entry():
        steps : S64 = GAMMA_BIG_LIFT.sub(floor).max(0)
        jump lift(0, steps, big_one())

    // w = a (a + 1) … (a + j - 1)
    block lift(j: S64, steps: S64, w: F128Big):
        done : Bool = j.ge(steps)
        branch done
            ? finish(steps, w)
            : lift(j.add(1), steps, w.mul(a.add(big_from_s64(j))))

    block finish(steps: S64, w: F128Big):
        b : F128Big = a.add(big_from_s64(steps))
        r : F128Big = big_stirling(b).sub(big_ln(w.abs()))
        return(r)

/// |sin πx| for a finite x that is not an integer, from the exact reduction.
routine big_abs_sin_pi(x: F128) -> F128Big
    block entry():
        red   : PiReduced = f128_pi_reduce(x)
        theta : F128Big   = big_from_f128(red.d).mul(big_half_pi())
        odd   : Bool      = red.quadrant.bitand(1).eq(1)
        branch odd
            ? return(big_cos_core(theta).abs())
            : return(big_sin_core(theta).abs())

/// ln |Γ(x)| in F128Big for a finite x that is not a pole, the same way as wide_ln_gamma. 1 - x is
/// exact: it has at most 114 significant bits.
routine big_ln_gamma(x: F128) -> F128Big
    block entry():
        reflect : Bool = x.lt(f128_of(0xBFFF0000000000000000000000000000))  // -1
        branch reflect
            ? reflected()
            : continue
        r : F128Big = big_ln_gamma_positive(big_from_f128(x), x.floor().to_clamp<S64>())
        return(r)

    block reflected():
        a              : F128Big = big_one().sub(big_from_f128(x))
        one_minus_ceil : F128    = f128_of(F128_ONE).sub(x.ceil())
        floor          : S64     = one_minus_ceil.to_clamp<S64>()
        inner          : F128Big = big_ln_gamma_positive(a, floor)
        reflection     : F128Big = big_ln_pi().sub(big_ln(big_abs_sin_pi(x)))
        r              : F128Big = reflection.sub(inner)
        return(r)

// -- ln_gamma ------------------------------------------------------------------

/// ln |Γ(self)|, correctly rounded: +inf at the poles (0 and the negative integers) and at ±inf, +0
/// at 1 and 2.
routine F128.ln_gamma(self: Self) -> Self
    block entry():
        r : Self = f128_ln_gamma(self, false)
        return(r)

/// exact skips the fast tier (the tests use it to check the exact tier on its own).
routine f128_ln_gamma(x: F128, exact: Bool) -> F128
    block entry():
        nan      : Bool = x.is_nan()
        zero     : Bool = f128_is_zero_bits(x.bits())
        inf      : Bool = x.is_infinite()
        pole     : Bool = f128_is_negative_bits(x.bits()).bitand(f128_is_integer(x))
        one      : Bool = x.eq(f128_of(F128_ONE))
        two      : Bool = x.eq(f128_of(0x40000000000000000000000000000000))
        blows_up : Bool = zero.bitor(inf).bitor(pole)
        root     : Bool = one.bitor(two)
        when:
            nan      -> return(f128_of(f128_quiet(x.bits())))
            blows_up -> return(F128.INFINITY)
            root     -> return(f128_of(0))
            exact    -> slow()
            else     -> fast()

    block fast():
        l      : LnGammaWide = wide_ln_gamma(x)
        band   : S64         = ln_gamma_band(l, F128_LN_GAMMA_BAND)
        useful : Bool        = band.ge(GAMMA_MIN_BAND).bitand(l.value.is_zero().bitnot())
        branch useful
            ? continue
            : slow()
        rounded : WideRounding = wide_round_within(l.value, band)
        branch rounded.ok
            ? return(rounded.value)
            : slow()

    block slow():
        r : F128 = big_ln_gamma(x).to<F128>()
        return(r)

// -- gamma ---------------------------------------------------------------------

/// Γ(self), correctly rounded: ±inf at ±0, NaN at the negative integers and -inf; it overflows to
/// +inf past x = 1755.548.
routine F128.gamma(self: Self) -> Self
    block entry():
        r : Self = f128_gamma(self, false)
        return(r)

/// The sign of Γ(x) for x not a pole: negative on (-1, 0), (-3, -2), …, where trunc(x) is even.
routine f128_gamma_is_negative(x: F128) -> Bool
    block entry():
        below : Bool = f128_is_negative_bits(x.bits())
        whole : S128 = x.trunc().to_clamp<S128>()
        even  : Bool = whole.bitand(1).eq(0)
        r     : Bool = below.bitand(even)
        return(r)

/// exact skips the fast tier (the tests use it to check the exact tier on its own).
routine f128_gamma(x: F128, exact: Bool) -> F128
    block entry():
        nan       : Bool = x.is_nan()
        zero      : Bool = f128_is_zero_bits(x.bits())
        pole      : Bool = f128_is_negative_bits(x.bits()).bitand(f128_is_integer(x))
        invalid   : Bool = pole.bitor(x.eq(F128.NEG_INFINITY))
        huge      : Bool = x.ge(f128_of(0x4009B700000000000000000000000000))  // 1756
        tiny      : Bool = x.lt(f128_of(0xC009C200000000000000000000000000))  // -1800
        small     : Bool = x.le(f128_of(0x40044000000000000000000000000000))  // 40
        factorial : Bool = f128_is_integer(x).bitand(small)
        negative  : Bool = f128_gamma_is_negative(x)
        // below -1800, |Γ| <= π / (|sin πx| Γ(1 - x)) < 2^-16700 even next to an integer: it rounds
        // to ±0
        when:
            nan       -> return(f128_of(f128_quiet(x.bits())))
            zero      -> return(F128.INFINITY.copysign(x))
            invalid   -> return(F128.NAN)
            huge      -> return(F128.INFINITY)
            tiny      -> signed(f128_of(0), negative)
            factorial -> product(2, x.to<U64>(), big_one())
            exact     -> slow(negative)
            else      -> fast(negative)

    // Γ(n) = (n - 1)!, exact in F128Big (38! has a 114-bit odd part), rounded once
    block product(k: U64, n: U64, p: F128Big):
        done : Bool = k.ge(n)
        branch done
            ? return(p.to<F128>())
            : product(k.add(1), n, p.mul_u64(k))

    // past ln |Γ| = 11360, Γ overflows; below -11488 it is under half the smallest subnormal
    block fast(negative: Bool):
        l     : LnGammaWide = wide_ln_gamma(x)
        ln    : F128        = l.value.to<F128>()
        over  : Bool        = ln.gt(f128_of(0x400C6300000000000000000000000000))  // 11360
        under : Bool        = ln.lt(f128_of(0xC00C6700000000000000000000000000))  // -11488
        band  : S64         = F128_GAMMA_BAND.sub(l.scale.max(0))
        loose : Bool        = band.lt(GAMMA_MIN_BAND)
        when:
            over  -> signed(F128.INFINITY, negative)
            under -> signed(f128_of(0), negative)
            loose -> slow(negative)
            else  -> fast_exp(l.value, band, negative)

    block fast_exp(ln: F128Extended, band: S64, negative: Bool):
        rounded : WideRounding = wide_round_within(gamma_wide_exp(ln), band)
        branch rounded.ok
            ? signed(rounded.value, negative)
            : slow(negative)

    block slow(negative: Bool):
        l     : F128Big = big_ln_gamma(x)
        ln    : F128    = l.to<F128>()
        over  : Bool    = ln.gt(f128_of(0x400C6300000000000000000000000000))  // 11360
        under : Bool    = ln.lt(f128_of(0xC00C6700000000000000000000000000))  // -11488
        when:
            over  -> signed(F128.INFINITY, negative)
            under -> signed(f128_of(0), negative)
            else  -> signed(big_exp(l).to<F128>(), negative)

    block signed(r: F128, negative: Bool):
        s : F128 = negative
            ? r.neg()
            : r
        return(s)
