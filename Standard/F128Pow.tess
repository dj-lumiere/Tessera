// Tessera stdlib: F128 powf and powi
//
// x^y, correctly rounded (to nearest, ties to even). CORE-MATH has no binary128 pow, so this uses sin_pi's two
// tiers (F128Extra.tess) behind a check for the results no approximation can round:
//
// - exact and midpoint cases: x^y exactly representable, or exactly halfway between two F128s, is found and
//   computed with integers first (f128_pow_dyadic, which says why the check is complete).
// - fast: ln|x| and e^(y ln|x|) in F128Extended (192 bits). ln x = e ln 2 + ln f with f in [sqrt(1/2), sqrt(2)),
//   ln f by ln_1p's 2 atanh series, directly for |f - 1| < 1/8 and else as 2 ln sqrt(f), so its first dropped
//   term stays near 2^-190 or below. e^z = 2^q e^d with |d| <= ln 2 / 2 and e^d = 1 + expm1(d) by the 35-term
//   series. The result is kept when all of it × (1 ± 2^-F128_POW_BAND) rounds to the same F128.
// - exact tier: otherwise ln, y ln x, and exp in F128Big (448 bits, Standard/F128Big.tess), rounded once. With
//   |y ln x| < 2^14 the result is off by under about 2^-415 relative.
//
// The band is measured, not proven. Over 489391 (x, y) pairs, 449558 of which reached the fast tier (random over
// the whole domain, x near 1 with |y| up to 2^100, results near overflow and in the subnormals, dyadic y
// (integer, half, quarter, and finer), powers of two, and 120000 with f on the 2 ln sqrt(f) path and |y ln x| in
// [10000, 11356]), the fast tier's worst relative error against mpmath was 2^-172.8: y ln x off by about 2^-186
// relative (f just past the 1 ± 1/8 switch), times |y ln x| near 2^13.5. So 2^-168 leaves about 5 bits. Values
// that close to a midpoint without being one do occur: x = 1 + a 2^-112 and y = n / 2 (a n odd) give
// 1 + a n 2^-113 + O(a² n² 2^-227), next to a midpoint, and the fast tier alone rounds some of those the wrong
// way (tests/f128_pow.tess has them). The exact tier has no rounding test of its own: it is within about 2^-415 of
// x^y, while the 2^256 inputs, over 2^113 rounding intervals, are expected to come within about 2^-(113 + 256) of
// a midpoint at the closest. No hard-to-round bound is known for binary128 pow.

module Standard::Core

preset F128_POW_BAND: S64 = 168

// e^z overflows past z = 11356.52 and is below half the smallest subnormal before z = -11433.4. Beyond these two
// there is nothing to compute
preset F128_POW_OVER:  F128 = F128.from_bits(0x400C6300000000000000000000000000)  // 11360
preset F128_POW_UNDER: F128 = F128.from_bits(0xC00C6700000000000000000000000000)  // -11488

// -- powf, powi ----------------------------------------------------------------

/// x^y, correctly rounded, with the special cases of IEEE 754 and C99 Annex F: x^±0 = 1 and 1^y = 1 (a quiet NaN
/// included), a zero or infinite base by the sign of y, (-1)^±inf = 1, NaN for a negative base and a
/// non-integer y, and a negative base with an odd integer y keeps the minus sign. A signaling NaN operand, or any
/// other NaN, comes back quieted (`me` first), the payload kept, as in every F128 operation.
/// :param y: The exponent.
/// :returns: `me`^y.
routine F128.powf(me: Me, y: Me) -> Me
    block entry()
        r : Me = f128_pow(me, y, false)
        return(r)

/// me^n, the same as powf with n converted.
/// :param n: The integer exponent.
/// :returns: `me`^n.
routine F128.powi(me: Me, n: S32) -> Me
    block entry()
        r : Me = me.powf(n.to<Me>())
        return(r)

/// x^y, correctly rounded, as {F128.powf}.
/// :param x: The base.
/// :param y: The exponent.
/// :param exact: True skips the fast tier (the tests use it to check the exact tier on its own).
/// :returns: x^y.
routine f128_pow(x: F128, y: F128, exact: Bool) -> F128
    block entry()
        one       : F128 = f128_of(F128_ONE)
        signaling : Bool = f128_is_signaling(x).bitor(f128_is_signaling(y))
        y_zero    : Bool = f128_is_zero_bits(y.bits())
        x_one     : Bool = x.eq(one)
        nan       : Bool = x.is_nan().bitor(y.is_nan())
        when
            signaling -> return(f128_nan_of(x, y))
            y_zero    -> return(one)
            x_one     -> return(one)
            nan       -> return(f128_nan_of(x, y))
            else      -> cases()

    block cases()
        one       : F128 = f128_of(F128_ONE)
        x_zero    : Bool = f128_is_zero_bits(x.bits())
        x_inf     : Bool = x.is_infinite()
        y_inf     : Bool = y.is_infinite()
        y_neg     : Bool = f128_is_negative_bits(y.bits())
        odd       : Bool = f128_is_odd_integer(y)
        int       : Bool = f128_is_integer(y)
        x_neg     : Bool = f128_is_negative_bits(x.bits())
        big_x     : Bool = x.abs().gt(one)
        minus_one : Bool = x.eq(one.neg())
        zero      : F128 = f128_of(0)
        infinity  : F128 = F128.INFINITY
        // x = ±0: a pole for y < 0, zero for y > 0. Odd integers keep x's sign
        at_zero : F128 = y_neg
            ? infinity
            : zero
        zero_r : F128 = odd
            ? at_zero.copysign(x)
            : at_zero
        // y = ±inf: |x| > 1 grows for +inf, |x| < 1 grows for -inf
        grows  : Bool = big_x.bitxor(y_neg)
        growth : F128 = grows
            ? infinity
            : zero
        inf_r : F128 = minus_one
            ? one
            : growth
        // x = ±inf: like 1/0 for y < 0. Odd integers keep x's sign
        x_inf_r0 : F128 = y_neg
            ? zero
            : infinity
        x_inf_r : F128 = odd
            ? x_inf_r0.copysign(x)
            : x_inf_r0
        bad : Bool = x_neg.bitand(int.bitnot())
        // x = -1 and an integer y: ±1
        unit : F128 = odd
            ? one.neg()
            : one
        when
            x_zero    -> return(zero_r)
            y_inf     -> return(inf_r)
            x_inf     -> return(x_inf_r)
            bad       -> return(F128.NAN)
            minus_one -> return(unit)
            else      -> general(odd)

    // |x|^y, negated for a negative x and an odd integer y
    block general(odd: Bool)
        magnitude : F128 = f128_pow_positive(x.abs(), y, exact)
        flip      : Bool = odd.bitand(f128_is_negative_bits(x.bits()))
        r         : F128 = flip
            ? magnitude.neg()
            : magnitude
        return(r)

/// x^y for a finite x > 0 other than 1 and a finite nonzero y: the exact and midpoint cases first, then the two
/// tiers.
/// :param x: The base.
/// :param y: The exponent.
/// :param exact: True skips the fast tier.
/// :returns: x^y, correctly rounded.
routine f128_pow_positive(x: F128, y: F128, exact: Bool) -> F128
    block entry()
        d : PowDyadic = f128_pow_dyadic(x, y)
        branch d.found
            ? return(d.value)
            : continue
        branch exact
            ? slow()
            : fast()

    block fast()
        z     : F128Extended = y.to<F128Extended>().mul(wide_pow_ln(x))
        zf    : F128         = z.to<F128>()
        over  : Bool         = zf.gt(F128_POW_OVER)
        under : Bool         = zf.lt(F128_POW_UNDER)
        when
            over  -> return(F128.INFINITY)
            under -> return(f128_of(0))
            else  -> fast_exp(z)

    block fast_exp(z: F128Extended)
        rounded : WideRounding = wide_round_within(wide_pow_exp(z), F128_POW_BAND)
        branch rounded.ok
            ? return(rounded.value)
            : slow()

    block slow()
        r : F128 = f128_pow_big(x, y)
        return(r)

// -- the exact and midpoint cases ----------------------------------------------

/// x^y when the check below finds it, rounded once.
record PowDyadic
    found : Bool
    value : F128

/// A finite nonzero F128 as ±odd × 2^shift.
private record OddScaled
    odd   : U128
    shift : S64

/// A finite nonzero F128's magnitude as odd × 2^shift.
/// :param x: The value.
/// :returns: The odd part and the shift.
private routine f128_odd_scaled(x: F128) -> OddScaled
    block entry()
        p     : F128Parts = f128_unpack(x.bits())
        zeros : U128      = p.sig.trailing_zeros()
        r     : OddScaled = OddScaled { odd: p.sig.shr(zeros),
            shift: p.exponent.sub(112).add(zeros.to<S64>()) }
        return(r)

/// x^y exactly, when it is w × 2^f with w an odd integer below 2^128 (x > 0 finite and not 1, y finite and
/// nonzero). Every F128, and every midpoint between two, is such a number with w < 2^114, so this finds every
/// result the tiers can't round. With x = m 2^E and y = ±n 2^j (m and n odd):
///
/// - x^y is a dyadic rational only as follows. For an integer y (j >= 0), x^y = m^y 2^(E y), which for y < 0 has
///   the odd factor m^|y| in its denominator unless m = 1. For y = ±n / 2^k (k = -j >= 1), if x^y = r is dyadic
///   then r^(2^k) = x^(±n). With m > 1 that needs y > 0 and 2^k dividing n times each prime's exponent in m, so
///   (n odd) m = a^(2^k) and 2^k divides E, and x^y = a^n 2^(E n / 2^k). With m = 1, x^y = 2^(E y) is dyadic
///   exactly when E y is an integer, that is when 2^k divides E.
/// - Bounds: m^y < 2^128 with m >= 3 needs y < 81, a >= 3 with a^(2^k) = m < 2^113 needs 2^k <= 71, so k <= 6,
///   and a^n < 2^128 needs n < 81. So an integer y >= 128, k > 6, or n >= 128 rules the case out at once.
///
/// For a power of two, |E y| >= 2^20 overflows or underflows whatever it is. It is clamped to ±2^30, which
/// f128_round_pack turns into inf or +0 as the real one would.
/// :param x: The base.
/// :param y: The exponent.
/// :returns: The rounded x^y with `found` true, or `found` false when x^y is no such number.
routine f128_pow_dyadic(x: F128, y: F128) -> PowDyadic
    shared bx         : OddScaled = f128_odd_scaled(x)
    shared by         : OddScaled = f128_odd_scaled(y)
    shared y_negative : Bool      = f128_is_negative_bits(y.bits())
    shared e          : S64       = bx.shift

    block entry()
        two_power : Bool = bx.odd.eq(1)
        integer   : Bool = by.shift.ge(0)
        when
            two_power  -> two_power()
            y_negative -> return(pow_dyadic_none())
            integer    -> integer_power()
            else       -> root_power()

    // x = 2^E: 2^(E y) when E y is an integer, and then |E y| >= n 2^max(j, 0)
    block two_power()
        j     : S64  = by.shift
        k     : S64  = 0.sub(j)
        mask  : S64  = S64.shl(1, k.min(62)).sub(1)
        whole : Bool = j.ge(0).bitor(k.lt(15).bitand(e.bitand(mask).eq(0)))
        huge  : Bool = j.ge(20).bitor(by.odd.ge(0x100000))
        down  : Bool = e.lt(0).bitxor(y_negative)
        clamp : S64  = down
            ? -0x40000000
            : 0x40000000
        partial : Bool = whole.bitnot()
        when
            partial -> return(pow_dyadic_none())
            huge    -> return(pow_dyadic_place(1, clamp))
            else    -> two_power_exact(j, by.odd.to<S64>())

    block two_power_exact(j: S64, n: S64)
        scaled : S64 = j.ge(0)
            ? e.shl(j)
            : e.shr(0.sub(j))
        f      : S64 = scaled.mul(n)
        signed : S64 = y_negative
            ? f.neg()
            : f
        return(pow_dyadic_place(1, signed))

    // y = n 2^j > 0: m^y 2^(E y)
    block integer_power()
        small : Bool = by.shift.lt(7).bitand(by.odd.lt(128))
        branch small
            ? continue
            : return(pow_dyadic_none())
        power : S64  = by.odd.to<S64>().shl(by.shift)
        large : Bool = power.ge(128)
        branch large
            ? return(pow_dyadic_none())
            : continue
        w : Option<U128> = u128_power_checked(bx.odd, power)
        when w
            .Present(value) -> return(pow_dyadic_place(value, bx.shift.mul(power)))
            .Absent         -> return(pow_dyadic_none())

    // y = n / 2^k > 0: a^n 2^(E n / 2^k) with m = a^(2^k)
    block root_power()
        k          : S64  = 0.sub(by.shift)
        mask       : S64  = S64.shl(1, k.min(62)).sub(1)
        small_root : Bool = k.le(6).bitand(by.odd.lt(128))
        fits       : Bool = small_root.bitand(bx.shift.bitand(mask).eq(0))
        branch fits
            ? continue
            : return(pow_dyadic_none())
        root : Option<U128> = u128_root_two_power(bx.odd, k)
        when root
            .Present(a) -> continue
            .Absent     -> return(pow_dyadic_none())
        n : S64          = by.odd.to<S64>()
        w : Option<U128> = u128_power_checked(a, n)
        when w
            .Present(value) -> return(pow_dyadic_place(value, bx.shift.shr(k).mul(n)))
            .Absent         -> return(pow_dyadic_none())

/// The "not found" answer of {f128_pow_dyadic}.
/// :returns: A PowDyadic with `found` false.
private routine pow_dyadic_none() -> PowDyadic
    block entry()
        r : PowDyadic = PowDyadic { found: false, value: f128_of(0) }
        return(r)

/// w × 2^f, rounded once (overflow, subnormals, and underflow included).
/// :param w: The integer part.
/// :param f: The power of two.
/// :returns: The rounded value with `found` true.
private routine pow_dyadic_place(w: U128, f: S64) -> PowDyadic
    block entry()
        bits : U128      = f128_round_pack(false, f.add(F128_BIAS).add(115), w)
        r    : PowDyadic = PowDyadic { found: true, value: f128_of(bits) }
        return(r)

/// base^n for 0 <= n.
/// :param base: The base.
/// :param n: The exponent, at least 0.
/// :returns: The power.
/// :absent: When the power doesn't fit in a U128.
private routine u128_power_checked(base: U128, n: S64) -> Option<U128>
    block entry()
        jump step(1, n)

    block step(acc: U128, left: S64)
        done : Bool = left.eq(0)
        branch done
            ? return(.Present(acc))
            : continue
        next : Option<U128> = acc.mul_checked(base)
        when next
            .Present(v) -> step(v, left.sub(1))
            .Absent     -> return(.Absent)

/// The 2^k-th root of m when m is a perfect 2^k-th power, by k exact square roots.
/// :param m: The value.
/// :param k: How many square roots, at least 0.
/// :returns: The root.
/// :absent: When some square root along the way is not exact.
private routine u128_root_two_power(m: U128, k: S64) -> Option<U128>
    block entry()
        jump step(m, k)

    block step(a: U128, left: S64)
        done : Bool = left.eq(0)
        branch done
            ? return(.Present(a))
            : continue
        r      : U128 = a.isqrt()
        square : Bool = r.mul(r).eq(a)
        branch square
            ? step(r, left.sub(1))
            : return(.Absent)

// -- fast tier: F128Extended ---------------------------------------------------

/// ln x for a finite x > 0, to about 2^-186 relative: x = f 2^e with f in [sqrt(1/2), sqrt(2)), and ln f from
/// ln_1p's series, directly for |f - 1| < 1/8 (f - 1 is exact, and the series' argument is under 0.067) and
/// else as 2 ln sqrt(f), which brings the argument under 0.087.
/// :param x: The argument, positive.
/// :returns: ln x at 192 bits.
routine wide_pow_ln(x: F128) -> F128Extended
    shared w         : F128Extended = x.to<F128Extended>()
    shared f0        : F128Extended = w.ldexp(0.sub(w.exponent))  // in [1, 2)
    shared sqrt_half : F128Extended = wide_const(2)
    shared low       : Bool         = f0.hi.lt(sqrt_half.hi)  // below sqrt(2): the same mantissa
    shared f         : F128Extended = low
        ? f0
        : f0.ldexp(-1)
    shared e : S64 = low
        ? w.exponent
        : w.exponent.add(1)

    block entry()
        u    : F128Extended = f.sub(wide_one())  // exact
        near : Bool         = u.is_zero().bitor(u.exponent.lt(-3))
        branch near
            ? finish(wide_ln_1p(u))
            : halved()

    block halved()
        root : F128Extended = f.sqrt()
        jump finish(wide_ln_1p(root.sub(wide_one())).ldexp(1))

    block finish(ln_f: F128Extended)
        e_ln2 : F128Extended = e.to<F128Extended>().mul(wide_const(0))
        r     : F128Extended = e_ln2.add(ln_f)
        return(r)

/// e^z for |z| < 2^14: z = q ln 2 + d, and e^d = 1 + expm1(d) by its series (|d| < 1/2).
/// :param z: The exponent.
/// :returns: e^z at 192 bits.
routine wide_pow_exp(z: F128Extended) -> F128Extended
    block entry()
        q     : S64          = z.mul(wide_const(1)).to_nearest<S64>()
        d     : F128Extended = z.sub(q.to<F128Extended>().mul(wide_const(0)))
        exp_d : F128Extended = wide_one().add(wide_exp_m1(d))
        r     : F128Extended = exp_d.ldexp(q)
        return(r)

/// The fast tier's x^y (x > 0, y ln x in range), before rounding.
/// :param x: The base.
/// :param y: The exponent.
/// :returns: x^y at 192 bits.
routine wide_pow(x: F128, y: F128) -> F128Extended
    block entry()
        z : F128Extended = y.to<F128Extended>().mul(wide_pow_ln(x))
        r : F128Extended = wide_pow_exp(z)
        return(r)

// -- exact tier: F128Big -------------------------------------------------------

/// x^y in F128Big, rounded once, for x > 0 finite and not 1 and y finite and nonzero.
/// :param x: The base.
/// :param y: The exponent.
/// :returns: x^y, with inf past overflow and +0 past underflow.
routine f128_pow_big(x: F128, y: F128) -> F128
    block entry()
        z     : F128Big = big_ln(x.to<F128Big>()).mul(y.to<F128Big>())
        zf    : F128    = z.to<F128>()
        over  : Bool    = zf.gt(F128_POW_OVER)
        under : Bool    = zf.lt(F128_POW_UNDER)
        when
            over  -> return(F128.INFINITY)
            under -> return(f128_of(0))
            else  -> return(big_exp(z).to<F128>())
