# Tessera stdlib: the correctly rounded base-10 exponential 10^x of B64
#
# x log2(10) = (k + h) / 2^12 with k an integer: 2^(k/2^12) as a double-double from exp's tables, 10^(h log10(2)
# / 2^12) from a short polynomial. When that can't decide the rounding, a triple-double reduction and a degree-5
# double-double polynomial redo it, and a few arguments too close to a rounding boundary even for that are looked
# up. The exact powers 10^0 .. 10^22 are computed exactly. Round to nearest only: overflow gives +inf, underflow a
# correctly rounded subnormal or +0, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary64/exp10/exp10.c via RazorForge's B64Exp10.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Double-double coefficients (high, low) of the degree-5 polynomial of the accurate path, as B64 bits.
preset CM_B64_EXP10_ACC_C: @Array[U64, 12] <- [0x40026BB1BBB55516, 0xBCAF48AD494EA102,
    0x40053524C73CEA69, 0xBCAE2BFAB318D399, 0x4000470591DE2CA4, 0x3CA81F50779E162B,
    0x3FF2BD7609FD98C4, 0x3C931A5CC5D3D313, 0x3FE1429FFD336AA3, 0x3C8910DE8C68A0C2,
    0x3FCA7ED7086882B4, 0xBC605E703D496537]
### The arguments (sorted bits) whose power of ten is too close to a rounding boundary for the accurate
### path.
preset CM_B64_EXP10_DB: @Array[U64, 49] <- [0x3F4821E0F2AFB970, 0x3F57C3DDD23AC8CA,
    0x3F5A2D7C1699E82D, 0x3F7EC65645EDC394, 0x3F890D7373B3A546, 0x3F97E3C84F2CB9B5,
    0x3FA25765968ECD68, 0x3FA9AA6FD4D21A47, 0x3FAE7B525705EDEF, 0x3FD12E02AA997AF2,
    0x3FDC414AA8BD83B1, 0x3FDD7D271AB4EEB4, 0x3FE1FE5F30572361, 0x3FE522C9F19CC202,
    0x3FF1DAF94CF0BD01, 0x3FF75F49C6AD3BAD, 0x3FFA3C782D4F54FC, 0x3FFCC30B915EC8C4,
    0x400EE9674267E65F, 0x4012D5494EB1DD13, 0x40389063309F3004, 0x4052A59B82B6FC5E,
    0x406CDE37694F4D10, 0xBF045DDB10382E3F, 0xBF0485426A688467, 0xBF06506061AAE6F7,
    0xBF0898A8C3990624, 0xBF117362E953393B, 0xBF1E40231E216CAD, 0xBF27A7F33CC3FD0B,
    0xBF363DF14C04AB23, 0xBF3A1B18D3A28957, 0xBF3E12494018E44C, 0xBF44C7A2BE09B10E,
    0xBF4DE686910F4F52, 0xBF5EBB11D32C9493, 0xBF7F6F96F005FD47, 0xBF8B44E17164CE91,
    0xBF93B95082297EA7, 0xBF95B25114A07A72, 0xBFBA9CF11E5ADBC5, 0xBFCC360CDDE773F7,
    0xBFD56FF305822F26, 0xBFDC03419F51B93E, 0xBFE1416C72A588A6, 0xBFED18176754AAC7,
    0xC01AA5575135E2D3, 0xC034CD4AF2FCA2B4, 0xC05DA5B10D8689FD]

### 10^me, correctly rounded (to nearest, ties to even). 10^-inf = +0, 10^+inf = +inf, overflow gives +inf,
### underflow a correctly rounded subnormal or +0, and NaN comes back quiet. 10^n is exact for n in 0..22.
### :returns: 10^`me`, correctly rounded.
routine B64.exp10(me: Me) -> Me
    local ux: U64 = me.bits()
    local aix: U64 = ux & 0x7FFFFFFFFFFFFFFF
    local r: @Me <- .hollow()

    # |x| > 0x1.34413509f79fep+8
    if aix > 0x40734413509F79FE
        nan: Bool = aix > 0x7FF0000000000000
        inf: Bool = aix == 0x7FF0000000000000
        positive: Bool = ux >> 63 == 0
        # x < -0x1.439b746e36b52p+8
        when
            nan => return me + me
            inf =>
                # overflow
                # underflow to +0
                if positive
                    return me
                else
                    return 0.0
            positive => return Me.mul(0x1p1023, 2.0)
            aix > 0x407439B746E36B52 => return Me.mul(0x1.8p-1022, 0x1p-55)
            else => pass

    # a nonnegative integer n <= 22 (bits below 2^(e - 1023 - 4) all 0): 10^n by exact products
    if ux << 16 == 0 and aix >> 48 <= 0x4036
        kx: Me = me.round_ties_even()
        if kx == me
            k: S64 = kx.to[S64]()
            if k >= 0
                1.0.poke_into(r)

                each i in 0 til k
                    (r.peek() * 10.0).poke_into(r)
                then
                    return r.peek()
    # |x| <= 0x1.bcb7b1526e50ep-56: 10^x rounds to 1
    if aix <= 0x3C7BCB7B1526E50E
        return Me.add(1.0, me)
    else
        t: Me = Me.mul(0x1.a934f0979a371p+13, me).round_ties_even()
        jt: S64 = t.to[S64]()
        ie: S64 = jt >> 12
        tt: CmF64ExpDd = cm_b64_exp_table_2pow(jt.to_wrap[U64]())
        dx: Me = me - Me.mul(0x1.34413508p-14, t) - Me.mul(0x1.f79fef311f12bp-46, t)
        dx2: Me = dx * dx
        p01: Me = Me.add(0x1.26bb1bbb55516p+1, dx * 0x1.53524c73cea69p+1)
        p23: Me = Me.add(0x1.0470591fd74e1p+1, dx * 0x1.2bd760a1f32a5p+0)
        p: Me = p01 + dx2 * p23
        fx: Me = tt.hi * dx
        fl: Me = tt.lo + fx * p
        # x <= -0x1.33a7146f72a42p+8: subnormal result
        if ux >= 0xC0733A7146F72A42
            bias_e: U64 = S64.sub(1, ie).to_wrap[U64]()
            bias: Me = Me.from_bits(bias_e << 52)
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: bias, y: tt.hi)
            sl: Me = fl + s.lo
            lb: Me = s.hi + (sl - 2.17e-19)
            ub: Me = s.hi + (sl + 2.17e-19)
            if lb == ub
                return Me.from_bits((s.hi + sl).bits() & 0x000FFFFFFFFFFFFF)
            else
                return cm_b64_exp10_accurate(me)
        else
            fh: Me = tt.hi
            ub: Me = fh + (fl + 2.17e-19)
            lb: Me = fh + (fl - 2.17e-19)
            if lb == ub
                return cm_b64_exp_ldexp(x: fh + fl, e: ie)
            else
                return cm_b64_exp10_accurate(me)

### The slow accurate path of exp10, for finite x whose 10^x neither overflows nor underflows to 0.
### :param x: The argument.
### :returns: 10^`x`, correctly rounded.
private routine cm_b64_exp10_accurate(x: B64) -> B64
    local ch: @B64 <- .hollow()
    local cl: @B64 <- .hollow()
    local ux: U64 = x.bits()
    local t: B64 = B64.mul(0x1.a934f0979a371p+13, x).round_ties_even()
    local jt: S64 = t.to[S64]()
    local ujt: U64 = jt.to_wrap[U64]()
    local ie: S64 = jt >> 12
    local tt: CmF64ExpDd = cm_b64_exp_table_2pow(ujt)
    # Cody-Waite reduction with a triple-double log10(2)/2^12
    local dx: B64 = x - B64.mul(0x1.34413508p-14, t)
    local dxl: B64 = B64.mul(-0x1.f79fef311f12bp-46, t)
    # the rounding error of dxl
    local dxle: B64 = B64.mul_add(-0x1.f79fef311f12bp-46, a: t, b: -dxl)
    local dxll: B64 = B64.mul(-0x1.ac0b7c917826bp-101, t) + dxle
    local dxh: B64 = dx + dxl
    local dxlo: B64 = dx - dxh + dxl + dxll

    B64.from_bits(CM_B64_EXP10_ACC_C.getitem(10)).poke_into(ch)
    B64.from_bits(CM_B64_EXP10_ACC_C.getitem(11)).poke_into(cl)

    # Horner's rule over the double-double coefficients, top down
    while i != 0 with i: USize = 5
        j: USize = i - 1
        r: CmF64ExpDd = cm_b64_exp_muldd(xh: dxh, xl: dxlo, ch: ch.peek(), cl: cl.peek())
        ci: B64 = B64.from_bits(CM_B64_EXP10_ACC_C.getitem(j * 2))
        cil: B64 = B64.from_bits(CM_B64_EXP10_ACC_C.getitem(j * 2 + 1))
        sh: B64 = r.hi + ci
        sl: B64 = ci - sh + r.hi
        (r.lo + (sl + cil)).poke_into(cl)
        sh.poke_into(ch)
        continue with i: j
    f: CmF64ExpDd = cm_b64_exp_muldd(xh: dxh, xl: dxlo, ch: ch.peek(), cl: cl.peek())
    sub: Bool = ux >= 0xC0733A7146F72A42  # subnormal result
    # 2^(k/2^12) is exactly 1
    when
        sub =>
            bias_e: U64 = S64.sub(1, ie).to_wrap[U64]()
            bias: B64 = B64.from_bits(bias_e << 52)
            g: CmF64ExpDd = cm_b64_exp_muldd(xh: f.hi, xl: f.lo, ch: tt.hi, cl: tt.lo)
            h: CmF64ExpDd = cm_b64_exp_fastsum(xh: tt.hi, xl: tt.lo, yh: g.hi, yl: g.lo)
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: bias, y: h.hi)
            fl: B64 = h.lo + s.lo
            res: B64 = s.hi + fl
            return B64.from_bits(res.bits() & 0x000FFFFFFFFFFFFF)
        ujt & 0xFFF == 0 =>
            # add 1 in without a product
            s1: CmF64ExpDd = cm_b64_exp_fasttwosum(x: f.hi, y: f.lo)
            s2: CmF64ExpDd = cm_b64_exp_fasttwosum(x: tt.hi, y: s1.hi)
            s3: CmF64ExpDd = cm_b64_exp_fasttwosum(x: s2.lo, y: s1.lo)
            ub: U64 = s3.hi.bits()
            if ub << 12 == 0
                # the tail is a power of 2: push it away from the rounding boundary toward the sign of its own tail
                same: Bool = ub >> 63 == s3.lo.bits() >> 63
                u: U64 = when
                    same => ub +% U64.shl(1, 51)
                    else => ub -% (U64.shl(1, 51) +% 1)
                return cm_b64_exp_ldexp(x: s2.hi + B64.from_bits(u), e: ie)
            else
                return cm_b64_exp_ldexp(x: s2.hi + s3.hi, e: ie)
        else =>
            g: CmF64ExpDd = cm_b64_exp_muldd(xh: f.hi, xl: f.lo, ch: tt.hi, cl: tt.lo)
            h: CmF64ExpDd = cm_b64_exp_fastsum(xh: tt.hi, xl: tt.lo, yh: g.hi, yl: g.lo)
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: h.hi, y: h.lo)
            ul: U64 = s.lo.bits()
            near: Bool = ul +% 4 & 0x000FFFFFFFFFFFFF <= 4
            tiny: Bool = (ul >> 52) & 0x7FF < 918
            if near or tiny
                return cm_b64_exp_ldexp(x: cm_b64_exp10_database(x, f: s.hi), e: ie)
            else
                return cm_b64_exp_ldexp(x: s.hi, e: ie)

### Looks x up among the arguments whose 10^x lies too close to a rounding boundary for the accurate path, and
### returns the correctly rounded (unscaled) result for them, or f unchanged otherwise.
### :param x: The argument.
### :param f: The unscaled result of the accurate path, returned when `x` is not in the table.
### :returns: The correctly rounded unscaled result for a listed `x`, else `f`.
private routine cm_b64_exp10_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 48
        m: S64 = a + b >> 1
        cm: U64 = CM_B64_EXP10_DB.getitem(m.to[USize]())
        ux: U64 = x.bits()
        below: Bool = cm < ux
        when
            below => continue with a: m + 1, b: b
            cm == ux =>
                um: U64 = m.to_wrap[U64]()
                sign_bit: U64 = (U64.shr(371470981966157, um) & 1) << 63
                dr: B64 = B64.from_bits(sign_bit | 0x3C90000000000000)
                upper: Bool = um >> 5 == 1
                s2: U64 = when
                    upper => 0x3781B19E1
                    else => 0x7EB37EF5AC3FE7C6
                t: U64 = (s2 >> ((um & 31) << 1)) & 3
                return cm_b64_exp_pick(f, t, dr)
            else => continue with a: a, b: m - 1
    then
        return f
