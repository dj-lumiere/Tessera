# Tessera stdlib: the correctly rounded inverse hyperbolic sine of B64
#
# For |x| < 0x1.bp-4 an odd polynomial, redone in double-double when its error bound can't decide the rounding.
# Otherwise asinh |x| = log(|x| + sqrt(x^2 + 1)), with the argument as a double-double (2|x| + 1/(2|x|) past
# 2^26, just 2|x| past 2^52) and the logarithm from the tables of ArchypShared.te, checked with an error
# bound. The accurate path computes the logarithm to about 150 bits and looks the few hardest arguments up in
# a table of exact values.
# Round to nearest only: ±0, ±inf and NaN map to themselves (NaN quiet), asinh(-x) = -asinh(x).
#
# Ported from CORE-MATH, src/binary64/asinh/asinh.c via RazorForge's B64Asinh.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Hard-to-round arguments |x| (sorted), as B64 bits.
secret preset CM_B64_ASINH_DB_X: @Array[U64, 35] <- [0x3FD00F9476450863, 0x3FD1F0A79315B287,
    0x3FD2B9618FF7ACB7, 0x3FD389EF683F3AA7, 0x3FD3B07E0C779DDA, 0x3FD48441DF33B6D3,
    0x3FD687BD068C1C1E, 0x3FD8740C4453A056, 0x3FD891ACDA11167E, 0x3FDBAFC3479FC9CC,
    0x3FDC59869F17B483, 0x3FDC8BE879787986, 0x3FDE73B46ABB01E1, 0x3FDED6236DA268B0,
    0x3FDF399EBAFC1951, 0x3FDF70975AB0D471, 0x3FDFBDD4A37760B7, 0x3FDFEE72EFB4BFDD,
    0x3FE02339D6BDB741, 0x3FE09E7C831B1A23, 0x3FE16D32C862FC3B, 0x3FE857954132083D,
    0x3FE8A5C3B60F7E11, 0x3FE9740EB419DD04, 0x3FEA16D9CC06011A, 0x3FEBB635BE2213D1,
    0x3FED4B21EBF542F0, 0x3FF7B8516FFD2406, 0x3FF9295B9116E2E2, 0x3FFFEDC65E327140,
    0x40057E377B3F0B4B, 0x4026056B06A21918, 0x403843E1B5E5979C, 0x409FEE8F69C4CD25,
    0x4170FBC6C02B1C90]

### The high parts of asinh |x| for those arguments, as B64 bits.
secret preset CM_B64_ASINH_DB_H: @Array[U64, 35] <- [0x3FCFCB35067F343C, 0x3FD1B68AAE88FEBA,
    0x3FD27781D9AA4E25, 0x3FD33F52DB6DF1AF, 0x3FD364303E1AD8F6, 0x3FD42E385800F0A4,
    0x3FD616CC75D49226, 0x3FD7E4F2AD132A1D, 0x3FD8009D924A3FFD, 0x3FDAE3773250E7D2,
    0x3FDB7EFA91915C95, 0x3FDBAD0485E0FE0A, 0x3FDD68039861AB53, 0x3FDDC0CB8F638126,
    0x3FDE1A4F519FAB77, 0x3FDE4BAE8BCD6EA6, 0x3FDE90F16EB88C09, 0x3FDEBC791A88BED8,
    0x3FDF0B2264E34555, 0x3FDFE694C3C89138, 0x3FE0A9C9334066DB, 0x3FE67425FE575C88,
    0x3FE6B23AD4415A17, 0x3FE754AB7535D47D, 0x3FE7D3755D851062, 0x3FE91167CAE3CFA9,
    0x3FEA3FC7E4DD47D1, 0x3FF2F5D3B178914A, 0x3FF3BFFA88639760, 0x3FF710F91E844F9B,
    0x3FFB6E2C73F41415, 0x4008C0A26D055288, 0x400F0F978201EB84, 0x4020A19AEBB51E90,
    0x40316369CD53BB69]

### The low parts, as B64 bits.
secret preset CM_B64_ASINH_DB_L: @Array[U64, 35] <- [0x3C60000000000000, 0x3C70000000000000,
    0xBC70000000000000, 0x3C70000000000000, 0x3C70000000000000, 0x3C70000000000000,
    0xBC70000000000000, 0x3C70000000000000, 0x3C70000000000000, 0x3C70000000000000,
    0x3C70000000000000, 0xBC70000000000000, 0x3C70000000000000, 0x3C70000000000000,
    0xBC70000000000000, 0x3C70000000000000, 0x3C70000000000000, 0x3C70000000000000,
    0x3C70000000000000, 0x3C70000000000000, 0xBC80000000000000, 0xBC80000000000000,
    0xBC80000000000000, 0x3C80000000000000, 0xBC80000000000000, 0x3C80000000000000,
    0xBC80000000000000, 0x3C90000000000000, 0x3C90000000000000, 0x3C90000000000000,
    0x3C90000000000000, 0x3CA0000000000000, 0x3CA0000000000000, 0xBCC0000000000000,
    0x3CD0000000000000]

### asinh `me`, correctly rounded.
### :returns: The inverse hyperbolic sine of `me`.
routine B64.asinh() -> Me
    local ax: Me = me.abs()
    local u: U64 = ax.bits()

    small: Bool = u < 0x3FBB000000000000  # |x| < 0x1.bp-4
    mid: Bool = u < 0x4190000000000000  # |x| < 2^26
    big: Bool = u < 0x4330000000000000  # |x| < 2^52
    if small
        zero: Bool = u == 0
        # |x| < 0x1.7137449123ef7p-26: asinh x rounds to x
        when
            zero => return me
            u < 0x3E57137449123EF7 => return Me.mul_add_unchecked(-0x1p-60, a: me, b: me)
            else => pass
        x2h: Me = me *! me
        x2l: Me = b64_mul_error(x: me, y: me, p: x2h)
        x3h: Me = x2h *! me
        lt6: Bool = u < 0x3F93000000000000  # |x| < 0x1.3p-6
        lt12: Bool = u < 0x3F30000000000000  # |x| < 2^-12
        # |x| < 0x1.ap-26
        sl: Me = when
            u < 0x3E5A000000000000 => x3h *! -0x1.5555555555555p-3
            lt12 => x3h *! (x2h *! 0x1.3333327c57c6p-4 +! -0x1.5555555555555p-3)
            lt6 =>
                # 2^-12 <= |x| < 0x1.3p-6
                c0: Me = x2h *! 0x1.f186866d775fp-6 +! -0x1.6db6d9a665159p-5
                c1: Me = x2h *! c0 +! 0x1.333333332f2ffp-4
                c2: Me = x2h *! c1 +! -0x1.5555555555555p-3
                becomes x3h *! c2
            else =>
                # 0x1.3p-6 <= |x| < 0x1.bp-4: a minimax polynomial with relative error < 2^-63.091
                c1: Me = x2h *! -0x1.6db6db6da466cp-5 +! 0x1.333333333331p-4
                c3: Me = x2h *! -0x1.6e8b651b09d72p-6 +! 0x1.f1c71c2ea7be4p-6
                c5: Me = x2h *! -0x1.bab7833c1ep-7 +! 0x1.1c309fc0e69c2p-6
                x4: Me = x2h *! x2h
                s3: Me = x4 *! (x4 *! c5 +! c3) +! c1
                s: Me = x2h *! s3 +! -0x1.5555555555555p-3
                becomes x3h *! s
        eps: Me = Me.mul_unchecked(0x1.79p-53, x3h)
        lb: Me = me +! (sl -! eps)
        ub: Me = me +! (sl +! eps)
        if lb == ub
            return lb
        return cm_b64_asinh_zero(x: me, x2h, x2l)

    # the logarithm's argument ah + al, the exponent offset off, and x^2 as a double-double (zero
    # past 2^26)
    values: (Me, Me, S64, CmF64HypDd) = when
        mid =>
            # 0x1.bp-4 <= |x| < 2^26: ah + al = |x| + sqrt(x^2 + 1)
            x2h: Me = me *! me
            x2l: Me = b64_mul_error(x: me, y: me, p: x2h)
            below: Bool = u < 0x3FF0000000000000
            s: CmF64HypDd = when
                below => cm_b64_hyp_fasttwosum(x: 1.0, y: x2h)
                else => cm_b64_hyp_fasttwosum(x: x2h, y: 1.0)
            th: Me = s.hi
            tl: Me = s.lo +! x2l
            sh: Me = th.sqrt_unchecked()
            rs: Me = Me.truediv_unchecked(0.5, th)
            sl: Me = (tl -! sh.mul_add_unchecked(a: sh, b: -th)) *! (rs *! sh)
            a: CmF64HypDd = cm_b64_hyp_fasttwosum(x: sh, y: ax)
            becomes (a.hi, sl +! a.lo, 0x3FF, CmF64HypDd(hi: x2h, lo: x2l))
        big => (Me.mul_unchecked(2.0, ax), Me.truediv_unchecked(0.5, ax), 0x3FF, CmF64HypDd(hi: 0.0, lo: 0.0))
        u >= 0x7FF0000000000000 => return me +! me
        # log(2|x|) = log(|x|) + log(2)
        else => (ax, 0.0, 0x3FE, CmF64HypDd(hi: 0.0, lo: 0.0))
    ah, al, off, x2 = values

    # log(ah + al) (less log(2) when off = 0x3FE), from the tables
    tb: U64 = ah.bits()
    eb: S64 = (tb >> 52).to[S64]()
    e: S64 = eb - off
    tm: U64 = tb & 0x000FFFFFFFFFFFFF
    ed: Me = e.to[Me]()
    j: U64 = cm_b64_archyp_index(tm)
    m: Me = Me.from_bits(tm | 0x3FF0000000000000)
    i1: U64 = (j >> 5).to[U64]()
    i2: U64 = (j & 0x1F).to[U64]()
    r: Me = Me.from_bits(CM_B64_ARCHYP_R1.getitem(i1)) *! Me.from_bits(CM_B64_ARCHYP_R2.getitem(i2))
    dx: Me = r.mul_add_unchecked(a: m, b: -1.0)
    dx2: Me = dx *! dx
    f: Me = dx2 *! cm_b64_archyp_log_poly(dx, dx2)
    # log(2) as l2h + l2l with l2h on 42 bits, so l2h ed is exact
    l1h: Me = Me.from_bits(CM_B64_ARCHYP_L1_HI.getitem(i1))
    l2h: Me = Me.from_bits(CM_B64_ARCHYP_L2_HI.getitem(i2))
    l1l: Me = Me.from_bits(CM_B64_ARCHYP_L1_LO.getitem(i1))
    l2l: Me = Me.from_bits(CM_B64_ARCHYP_L2_LO.getitem(i2))
    lh0: Me = Me.mul_unchecked(0x1.62e42fefa38p-1, ed) +! (l1h +! l2h)
    ll3: Me = Me.mul_unchecked(0x1.ef35793c7673p-45, ed) +! l1l
    ll2: Me = ll3 +! l2l +! al /! ah
    ll1: Me = ll2 +! f
    ll0: Me = ll1 +! dx
    sgn: Me = Me.copysign(1.0, me)
    lh: Me = lh0 *! sgn
    ll: Me = ll0 *! sgn
    eps: Me = 0x1.80df744ce99c7p-63  # 1.63e-19 in the original
    lb: Me = lh +! (ll -! eps)
    ub: Me = lh +! (ll +! eps)
    sure: Bool = lb == ub
    when
        sure => return lb
        ax < 0x1p-2 => return cm_b64_asinh_zero(x: me, x2h: x2.hi, x2l: x2.lo)
        else => return cm_b64_asinh_refine(x: me, zh: ah, zl: al,
            a: Me.mul_unchecked(0x1.71547652b82fep+0, lb.abs()))

### The double-double sum (xh + xl) + (ch + cl), the high parts with an exact two-sum.
### :param xh: The high part of the first addend.
### :param xl: The low part of the first addend.
### :param ch: The high part of the second addend.
### :param cl: The low part of the second addend.
### :returns: The sum as a double-double.
secret routine cm_b64_asinh_adddd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    s: B64 = xh +! ch
    d: B64 = s -! xh
    err: B64 = ch -! d +! (xh +! (d -! s))
    l: B64 = err +! (xl +! cl)
    return CmF64HypDd(hi: s, lo: l)

### The double-double product (xh + xl) (ch + cl), renormalized.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The product as a double-double.
secret routine cm_b64_asinh_muldd_acc(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    ahlh: B64 = ch *! xl
    alhh: B64 = cl *! xh
    ahhh: B64 = ch *! xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) +! (alhh +! ahlh)
    h: B64 = ahhh +! ahhl
    l: B64 = ahhh -! h +! ahhl
    return CmF64HypDd(hi: h, lo: l)

### The double-double times double product (xh + xl) ch, renormalized.
### :param xh: The high part of the double-double factor.
### :param xl: The low part of the double-double factor.
### :param ch: The B64 factor.
### :returns: The product as a double-double.
secret routine cm_b64_asinh_mulddd(xh: B64, xl: B64, ch: B64) -> CmF64HypDd
    ahlh: B64 = ch *! xl
    ahhh: B64 = ch *! xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) +! ahlh
    h: B64 = ahhh +! ahhl
    l: B64 = ahhh -! h +! ahhl
    return CmF64HypDd(hi: h, lo: l)

### The first Horner step of a double-double polynomial: (c_hi + c_lo) + l.
### :param l: The B64 to add.
### :param c_hi: The high part of the coefficient.
### :param c_lo: The low part of the coefficient.
### :returns: The sum as a double-double.
secret routine cm_b64_asinh_polydd_init(l: B64, c_hi: B64, c_lo: B64) -> CmF64HypDd
    ch: B64 = c_hi +! l
    err: B64 = c_hi -! ch +! l
    cl: B64 = err +! c_lo
    return CmF64HypDd(hi: ch, lo: cl)

### One Horner step of a double-double polynomial: `value` `x` + `c`.
### :param x: The point, as a double-double.
### :param value: The polynomial so far, as a double-double.
### :param c: The next coefficient, as a double-double.
### :returns: The new value as a double-double.
secret routine cm_b64_asinh_polydd_step(x: CmF64HypDd, value: CmF64HypDd,
    c: CmF64HypDd) -> CmF64HypDd
    p: CmF64HypDd = cm_b64_asinh_muldd_acc(xh: x.hi, xl: x.lo, ch: value.hi, cl: value.lo)
    th: B64 = p.hi +! c.hi
    tl: B64 = c.hi -! th +! p.hi
    l: B64 = p.lo +! (tl +! c.lo)
    return CmF64HypDd(hi: th, lo: l)

### The accurate path of asinh for small |x|: a double-double odd polynomial, with x^2 = x2h + x2l.
### :param x: The argument.
### :param x2h: The high part of `x`^2.
### :param x2l: The low part of `x`^2.
### :returns: asinh(`x`), correctly rounded.
secret routine cm_b64_asinh_zero(x: B64, x2h: B64, x2l: B64) -> B64
    x2dd: CmF64HypDd = (hi: x2h, lo: x2l)
    c0: B64 = x2h *! -0x1.3b92d6368192cp-9 +! 0x1.0095da47b392cp-8
    c1: B64 = x2h *! c0 +! -0x1.2e6d98527bcc6p-8
    c2: B64 = x2h *! c1 +! 0x1.51712f7bee368p-8
    y2: B64 = x2h *! (x2h *! c2 +! -0x1.7828d553ec8p-8)
    p25: CmF64HypDd = cm_b64_asinh_polydd_init(l: y2, c_hi: 0x1.a685fc5de7a04p-8,
        c_lo: 0x1.40d284a1d67f9p-62)
    p23: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p25,
        c: CmF64HypDd(hi: -0x1.df3bd104aa267p-8, lo: -0x1.546da9bc5b32ap-62))
    p21: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p23,
        c: CmF64HypDd(hi: 0x1.12ef3ceae4d12p-7, lo: -0x1.ba9c13deb261fp-61))
    p19: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p21,
        c: CmF64HypDd(hi: -0x1.3fde50d764083p-7, lo: -0x1.d024df7fa0542p-61))
    p17: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p19,
        c: CmF64HypDd(hi: 0x1.7a87878786c7ep-7, lo: 0x1.a83c7bace55ebp-61))
    p15: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p17,
        c: CmF64HypDd(hi: -0x1.c999999999977p-7, lo: -0x1.38e7a467ecc55p-61))
    p13: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p15,
        c: CmF64HypDd(hi: 0x1.1c4ec4ec4ec4fp-6, lo: -0x1.74e3c1dfd4c3dp-60))
    p11: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p13,
        c: CmF64HypDd(hi: -0x1.6e8ba2e8ba2e9p-6, lo: 0x1.17f937248cf81p-60))
    p9: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p11,
        c: CmF64HypDd(hi: 0x1.f1c71c71c71c7p-6, lo: 0x1.c71a35cfa0671p-62))
    p7: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p9,
        c: CmF64HypDd(hi: -0x1.6db6db6db6db7p-5, lo: 0x1.2492496091b0cp-60))
    p5: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p7,
        c: CmF64HypDd(hi: 0x1.3333333333333p-4, lo: 0x1.99999999949dfp-59))
    p3: CmF64HypDd = cm_b64_asinh_polydd_step(x: x2dd, value: p5,
        c: CmF64HypDd(hi: -0x1.5555555555555p-3, lo: -0x1.5555555555555p-57))
    px: CmF64HypDd = cm_b64_asinh_muldd_acc(xh: p3.hi, xl: p3.lo, ch: x2h, cl: x2l)
    p: CmF64HypDd = cm_b64_asinh_mulddd(xh: px.hi, xl: px.lo, ch: x)
    s0: CmF64HypDd = cm_b64_hyp_fasttwosum(x, y: p.hi)
    s1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: s0.lo, y: p.lo)
    return s0.hi +! cm_b64_hyp_nudge(y1: s1.hi, y2: s1.lo)

### The accurate path of asinh: log(zh + zl) to about 150 bits, where zh + zl is |x| + sqrt(x^2 + 1) (or
### 2|x| + 1/(2|x|), or |x| when zl = 0 and the exponent then gets one more) and a approximates log2(zh + zl).
### :param x: The argument.
### :param zh: The high part of the logarithm's argument.
### :param zl: The low part of the logarithm's argument.
### :param a: The approximation of log2(`zh` + `zl`).
### :returns: asinh(`x`), correctly rounded.
secret routine cm_b64_asinh_refine(x: B64, zh: B64, zl: B64, a: B64) -> B64
    tb: U64 = zh.bits()
    zero: Bool = zl == 0.0
    eb: S64 = (tb >> 52).to[S64]()
    e0: S64 = eb - 0x3FF
    e: S64 = when
        zero => e0 + 1
        else => e0
    m: B64 = B64.from_bits((tb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000)
    ed: B64 = e.to[B64]()
    fr: B64 = a -! ed +! 0x1.00008p+0
    fm: U64 = fr.bits() -% 0x3FF0000000000000
    i: U64 = fm >> 36
    i1u: U64 = (i >> 12) & 0x1F
    i1: U64 = i1u.to[U64]()
    i2u: U64 = (i >> 8) & 0xF
    i2: U64 = i2u.to[U64]()
    i3u: U64 = (i >> 4) & 0xF
    i3: U64 = i3u.to[U64]()
    i4: U64 = (i & 0xF).to[U64]()
    el2: B64 = B64.mul_unchecked(-0x1.9ff0342542fc3p-91, ed)
    el1: B64 = B64.mul_unchecked(0x1.ef35793c768p-46, ed)
    el0: B64 = B64.mul_unchecked(0x1.62e42fefa38p-2, ed)
    big: CmF64ArchypTd = cm_b64_archyp_log_table(i1, i2, i3, i4)
    big0: B64 = big.hi +! el0
    rt: CmF64HypDd = cm_b64_archyp_rt(i1, i2, i3, i4)
    dh: B64 = rt.hi *! m
    dl: B64 = b64_mul_error(x: rt.hi, y: m, p: dh)
    sh: B64 = rt.lo *! m
    sl: B64 = b64_mul_error(x: rt.lo, y: m, p: sh)
    q: CmF64HypDd = cm_b64_hyp_fasttwosum(x: dh -! 1.0, y: dl)
    # zl / 2^e, scaled like m = zh / 2^e
    zs: B64 = B64.from_bits(zl.bits() -% (e.to_wrap[U64]() << 52))
    xl: B64 = when
        zero => q.lo
        else => q.lo +! rt.hi *! zs
    xs: CmF64HypDd = cm_b64_asinh_adddd(xh: q.hi, xl, ch: sh, cl: sl)
    xh: B64 = xs.hi
    c: B64 = xh *! -0x1.55555555c3157p-4 +! 0x1.9999999a0754fp-4
    tail: B64 = xh *! (xh *! c +! -0x1p-3)
    p3: CmF64HypDd = cm_b64_asinh_polydd_init(l: tail, c_hi: 0x1.5555555555555p-3,
        c_lo: 0x1.55540c15cf91fp-57)
    p2: CmF64HypDd = cm_b64_asinh_polydd_step(x: xs, value: p3,
        c: CmF64HypDd(hi: -0x1p-2, lo: -0x1.932ce43199a8dp-110))
    p1: CmF64HypDd = cm_b64_asinh_polydd_step(x: xs, value: p2,
        c: CmF64HypDd(hi: 0x1p-1, lo: 0x1.24b67ee516e3bp-111))
    p0: CmF64HypDd = cm_b64_asinh_muldd_acc(xh, xl: xs.lo, ch: p1.hi, cl: p1.lo)
    pe: CmF64HypDd = cm_b64_asinh_adddd(xh: p0.hi, xl: p0.lo, ch: el1, cl: el2)
    s: CmF64HypDd = cm_b64_asinh_adddd(xh: pe.hi, xl: pe.lo, ch: big.mid, cl: big.lo)
    # big0 + s as a triple-double v0 + v1 + v2, renormalized
    w0: CmF64HypDd = cm_b64_hyp_fasttwosum(x: big0, y: s.hi)
    w1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: w0.lo, y: s.lo)
    w2: CmF64HypDd = cm_b64_hyp_fasttwosum(x: w0.hi, y: w1.hi)
    w3: CmF64HypDd = cm_b64_hyp_fasttwosum(x: w2.lo, y: w1.lo)
    two: B64 = B64.copysign(2.0, x)
    v0: B64 = w2.hi *! two
    v1: B64 = cm_b64_hyp_nudge(y1: w3.hi *! two, y2: w3.lo *! two)
    tu: U64 = v1.bits()
    er: U64 = tu +% 41 & 0x000FFFFFFFFFFFFF
    v0_top: U64 = v0.bits() >> 52
    de: U64 = (v0_top & 0x7FF) -% ((tu >> 52) & 0x7FF)
    res: B64 = v0 +! v1
    if de > 99 or er < 80
        return cm_b64_asinh_database(x, f: res)
    return res

### The exact asinh x for the arguments the fast and accurate paths can't round, or f for any other x.
### :param x: The argument.
### :param f: The result for an argument that is not in the table.
### :returns: The tabulated asinh(`x`) for a listed `x`, else `f`.
secret routine cm_b64_asinh_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 34
        m: S64 = (a + b).div_trunc(2)
        mu: U64 = m.to[U64]()
        key: B64 = B64.from_bits(CM_B64_ASINH_DB_X.getitem(mu))
        ax: B64 = x.abs()
        below: Bool = key < ax
        when
            below => continue with a: m + 1, b: b
            key == ax =>
                sgn: B64 = B64.copysign(1.0, x)
                h: B64 = B64.from_bits(CM_B64_ASINH_DB_H.getitem(mu))
                l: B64 = B64.from_bits(CM_B64_ASINH_DB_L.getitem(mu))
                return sgn *! h +! sgn *! l
            else => continue with a: a, b: m - 1
    then
        return f
