# Tessera stdlib: the correctly rounded cube root of B64
#
# x = ±2^(3 et + it) z with 1 <= z < 2: a cubic polynomial gives cbrt(z) to
# about 13 bits, a cubic Newton step triples that, and a linear Newton step
# with y^3 in double-double arithmetic lands within half an ulp. When the
# correction sits too close to a rounding boundary, one more step settles it
# (with two inputs known to need more), and an exact cube root has its
# rounding noise cleared. Round to nearest only: ±0, ±inf and NaN map to
# themselves (NaN comes back quiet), and cbrt(-x) = -cbrt(x).
#
# Ported from CORE-MATH, src/binary64/cbrt/cbrt.c via RazorForge's B64Cbrt.rf.
# Copyright (c) 2021-2022 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The cube root of `me`, correctly rounded.
### :returns: The cube root.
routine B64.cbrt(me: Me) -> Me
    local hx: U64 = me.bits()
    local sign: U64 = hx >> 63
    local mant: U64 = hx & 0x000FFFFFFFFFFFFF
    local ebits: U64 = (hx >> 52) & 0x7FF
    local e: S64 = ebits.to[S64]()

    edge: Bool = e == 0 or e == 0x7FF
    values2: (U64, S64) = when
        edge =>
            # ±0, subnormals, ±inf and NaN
            ix: U64 = hx & 0x7FFFFFFFFFFFFFFF
            if e == 0x7FF or ix == 0  # x + x also quiets a signaling NaN
                return me + me
            # subnormal: normalize the mantissa
            nz: U64 = ix.leading_zeros() - 11
            becomes ((mant << nz) & 0x000FFFFFFFFFFFFF, e - (nz.to[S64]() - 1))
        else => (mant, e)
    mant_norm, e_norm = values2

    # 2^(3 et + it) <= |x| < 2^(3 et + it + 1) with 0 <= it <= 2 (et biased)
    eb: S64 = e_norm + 3072
    cvt1: U64 = mant_norm | 0x3FF0000000000000
    et: S64 = eb.div_trunc(3)
    it: S64 = eb.mod_trunc(3)
    # cbrt(x) = cbrt(zz) 2^(et-1365) where 1 <= |zz| < 8
    zz: Me = Me.from_bits(cvt1 + (it.to_wrap[U64]() << 52) | (sign << 63))
    # cbrt(zz) = cbrt(z) isc, where isc is ±1, ±2^(1/3) or ±2^(2/3), and 1 <= z < 2
    escale: Me = cm_cbrt_escale(it)
    isc: Me = Me.from_bits(escale.bits() | (sign << 63))
    z: Me = Me.from_bits(cvt1)
    r: Me = Me.truediv(1.0, z)
    rr: Me = r * cm_b64_cbrt_rsc(it, sign)
    z2: Me = z * z
    c0: Me = Me.add(0x1.1b0babccfef9cp-1, z * 0x1.2c9a3e94d1da5p-1)
    c2: Me = Me.add(-0x1.4dc30b1a1ddbap-3, z * 0x1.7a8d3e4ec9b07p-6)
    # c0 + c1 z + c2 z^2 + c3 z^3 approximates z^(1/3) on [1, 2] with error < 9.2e-5
    y0: Me = c0 + z2 * c2
    y02: Me = y0 * y0
    h0: Me = y02 * (y0 * r) - 1.0
    # a cubic variant of Newton's method on f(y) = 1 - z/y^3
    k: Me = Me.sub(0x1.5555555555555p-2, Me.mul(0x1.c71c71c71c71cp-3, h0))
    yz: Me = y0 - h0 * y0 * k
    y: Me = yz * isc
    # one more (linear) Newton iteration, with y^3 computed to about 106 bits
    y2: Me = y * y
    y2l: Me = b64_mul_error(x: y, y, p: y2)
    y3: Me = y2 * y
    y3l: Me = b64_mul_error(x: y, y: y2, p: y3) + y * y2l
    resid: Me = y3 - zz + y3l
    h: Me = resid * rr
    dy0: Me = h * (y * 0x1.5555555555555p-2)
    y1: Me = y - dy0
    dy: Me = y - y1 - dy0
    # the cube root is now y1 + dy with |dy| < 1/2 ulp(y1): rounding is hard only when dy is close to
    # 1/2 ulp or 3/2 ulp
    hard: Bool = cm_b64_cbrt_is_near_boundary(dy, tol: 0x1p-75)
    values3: (Me, Me) = when
        hard =>
            y22: Me = y1 * y1
            y2l2: Me = b64_mul_error(x: y1, y: y1, p: y22)
            y32: Me = y22 * y1
            y3l2: Me = b64_mul_error(x: y1, y: y22, p: y32) + y1 * y2l2
            resid2: Me = y32 - zz + y3l2
            h2: Me = resid2 * rr
            dy02: Me = h2 * (y1 * 0x1.5555555555555p-2)
            y4: Me = y1 - dy02
            dy2: Me = y1 - y4 - dy02
            if cm_b64_cbrt_is_near_boundary(dy: dy2, tol: 0x1p-98)
                # two inputs whose cube root lies within 2^-98 of a rounding boundary
                azz: Me = zz.abs()
                first: Bool = azz == 0x1.9b78223aa307cp+1
                when
                    first =>
                        becomes (Me.copysign(0x1.79d15d0e8d59cp+0, zz), dy2)
                    azz == 0x1.a202bfc89ddffp+2 =>
                        becomes (Me.copysign(0x1.de87aa837820fp+0, zz), dy2)
                    else =>
                        becomes (y4, dy2)
            else
                becomes (y4, dy2)
        else => (y1, dy)
    y12, dy2 = values3
    out_e: S64 = et - 342 - 1023
    bits: U64 = y12.bits() +% (out_e.to_wrap[U64]() << 52)
    # exact cube roots have the low 34 mantissa bits all 0 or all 1
    m0: U64 = bits << 30
    m0neg: Bool = m0 >> 63 == 1
    m1: U64 = when
        m0neg => ~m0
        else => m0
    if m1 <= U64.shl(1, 30)
        # a cube root that may be exact: round the last bits away
        rounded_bits: U64 = y12.bits() +% U64.shl(1, 15)
        cvt4: Me = Me.from_bits(rounded_bits & 0xFFFFFFFFFFFF0000)
        diff: Me = cvt4 - y12 - dy2
        tight: Bool = diff.abs() < 0x1p-60
        one: Bool = zz.abs() == 1.0
        if tight or one
            return Me.from_bits(bits +% U64.shl(1, 15) & 0xFFFFFFFFFFFF0000)
        else
            return Me.from_bits(bits)
    else
        return Me.from_bits(bits)

### Whether the correction dy lies within tol of 1/2 ulp or 3/2 ulp of the
### approximation (ulp 2^-52 on [1, 2)).
### :param dy: The correction.
### :param tol: The tolerance.
### :returns: True when |`dy`| is within `tol` of 2^-53 or of 3 2^-53.
private routine cm_b64_cbrt_is_near_boundary(dy: B64, tol: B64) -> Bool
    ady: B64 = dy.abs()
    ady0: B64 = (ady - 0x1p-53).abs()
    ady1: B64 = (ady - 0x1.8p-52).abs()  # 0x1p-52 + 0x1p-53
    return ady0 < tol or ady1 < tol

### The scale 2^(it/3) of the cube root reduction, for it in 0..2.
### :param it: 0, 1 or 2 (anything above 1 is taken as 2).
### :returns: 2^(`it`/3).
internal routine cm_cbrt_escale(it: S64) -> B64
    when it
        0 => return 1.0
        1 => return 0x1.428a2f98d728bp+0
        else => return 0x1.965fea53d6e3dp+0

### The reciprocal scale ±2^-it applied to 1/z, for it in 0..2, negated when
### the sign bit is 1.
### :param it: 0, 1 or 2.
### :param sign: The sign bit, 0 or 1.
### :returns: ±2^-`it`.
private routine cm_b64_cbrt_rsc(it: S64, sign: U64) -> B64
    magnitude: B64 = cm_b64_cbrt_rsc_magnitude(it)
    if sign == 1
        return -magnitude
    else
        return magnitude

### The magnitude 2^-it of {cm_b64_cbrt_rsc}, for it in 0..2.
### :param it: 0, 1 or 2 (anything above 1 is taken as 2).
### :returns: 1, 0.5 or 0.25.
private routine cm_b64_cbrt_rsc_magnitude(it: S64) -> B64
    when it
        0 => return 1.0
        1 => return 0.5
        else => return 0.25
