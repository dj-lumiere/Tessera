    0x404F7216C4B435C9, 0x40654CD1FEA7663A, 0x407D6479EBA7C971, 0xBF1664716B68A409,
    0xBF2A2FEFEFD580DF, 0xBF3CE3F638D0C742, 0xBF3CEFF32831E2C2, 0xBF433ACCAE78B371,
    0xBF4D792B60084F92, 0xBF77FB235D76CCE7, 0xBF81FF9B8E8B38BE, 0xBF854511E930898C,
