### A double-double number hi + lo.
secret record CmF64ExpDd
    hi: B64
    lo: B64

### e^`me`, correctly rounded (to nearest). Overflow gives +inf, underflow a correctly rounded subnormal or +0, and
### NaN comes back quiet.
### :returns: e^`me`.
routine B64.exp_unchecked() -> Me
    local ux: U64 = me.bits()
    local aix: U64 = ux & 0x7FFFFFFFFFFFFFFF

    # |x| <= 2^-54: e^x rounds to 1
    when
        aix <= 0x3C90000000000000 => return Me.add_unchecked(1.0, me)
        aix >= 0x40862E42FEFA39F0 =>
            # |x| >= 0x1.62e42fefa39fp+9, infinite or NaN
            is_nan: Bool = aix > 0x7FF0000000000000
            is_inf: Bool = aix == 0x7FF0000000000000
            positive: Bool = ux >> 63 == 0
            # x <= -0x1.74910d52d3052p+9
            when
                is_nan => return me +! me
                is_inf =>
                    if positive
                        return me
                    return 0.0
                positive => return inf
                aix >= 0x40874910D52D3052 => return 0.0
                else => pass
        else => pass
    t: Me = (me *! 0x1.71547652b82fep+12).round_ties_even()
    jt: S64 = t.to[S64]()
    ie: S64 = jt >> 12
    tt: CmF64ExpDd = cm_b64_exp_table_2pow(jt.to_wrap[U64]())
    # Cody-Waite reduction: |t| < 2^23 and the high part of log(2)/2^12 fits in 29 bits, so its product is exact
    dx: Me = me -! t *! 0x1.62e42ffp-13 +! t *! 0x1.718432a1b0e26p-47
    dx2: Me = dx *! dx
    # 1 + dx (c0 + c1 dx + c2 dx^2 + c3 dx^3) approximates e^dx with absolute error below 2^-76.173
    p01: Me = Me.add_unchecked(1.0, dx *! 0x1p-1)
    p23: Me = Me.add_unchecked(0x1.55555557e54ffp-3, dx *! 0x1.55555553a12f4p-5)
    p: Me = p01 +! dx2 *! p23
    tx: Me = tt.hi *! dx
    fl: Me = tt.lo +! tx *! p
    # x < -0x1.6232bdd7abcd2p+9: subnormal result
    if ux > 0xC086232BDD7ABCD2
        bias_e: U64 = S64.sub(1, ie).to_wrap[U64]()
        bias: Me = Me.from_bits(bias_e << 52)
        s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: bias, y: tt.hi)
        sl: Me = fl +! s.lo
        ub: Me = s.hi +! (sl +! 1.64e-19)
        lb: Me = s.hi +! (sl -! 1.64e-19)
        if ub == lb
            return Me.from_bits(lb.bits() & 0x000FFFFFFFFFFFFF)
        return cm_b64_exp_accurate(me)
    fh: Me = tt.hi
    ub: Me = fh +! (fl +! 1.64e-19)
    lb: Me = fh +! (fl -! 1.64e-19)
    if ub == lb
        return cm_b64_exp_ldexp(x: lb, e: ie)
    return cm_b64_exp_accurate(me)

### The slow accurate path of exp, for finite x with |x| in (2^-54, 0x1.74910d52d3052p+9).
### :param x: The argument.
### :returns: e^`x` from the accurate path.
secret routine cm_b64_exp_accurate(x: B64) -> B64
    ux: U64 = x.bits()
    ebits: U64 = (ux >> 52) & 0x7FF
    if ebits < 0x3C9
        return B64.add_unchecked(1.0, x)
    t: B64 = (x *! 0x1.71547652b82fep+12).round_ties_even()
    jt: S64 = t.to[S64]()
    ie: S64 = jt >> 12
    tt: CmF64ExpDd = cm_b64_exp_table_2pow(jt.to_wrap[U64]())
    # Cody-Waite reduction with a triple-double log(2)/2^12
    dx: B64 = x -! t *! 0x1.62e42ffp-13
    dxl: B64 = B64.mul_unchecked(0x1.718432a1b0e26p-47, t)
    dxl3: B64 = B64.mul_unchecked(0x1.9ff0342542fc3p-102, t)
    dxle: B64 = B64.mul_add_unchecked(0x1.718432a1b0e26p-47, a: t, b: -dxl)
    # the rounding error of dxl
    dxll: B64 = dxl3 +! dxle
    dxh: B64 = dx +! dxl
    dxe: B64 = dx -! dxh +! dxl
    dxlo: B64 = dxe +! dxll
    p: CmF64ExpDd = cm_b64_exp_poly_acc(xh: dxh, xl: dxlo)
    f: CmF64ExpDd = cm_b64_exp_muldd(xh: dxh, xl: dxlo, ch: p.hi, cl: p.lo)
    # x < -0x1.6232bdd7abcd2p+9: subnormal result
    when
        ux > 0xC086232BDD7ABCD2 =>
            bias_e: U64 = S64.sub(1, ie).to_wrap[U64]()
            bias: B64 = B64.from_bits(bias_e << 52)
            g: CmF64ExpDd = cm_b64_exp_muldd(xh: f.hi, xl: f.lo, ch: tt.hi, cl: tt.lo)
            h: CmF64ExpDd = cm_b64_exp_fastsum(xh: tt.hi, xl: tt.lo, yh: g.hi, yl: g.lo)
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: bias, y: h.hi)
            fl: B64 = h.lo +! s.lo
            res: B64 = s.hi +! fl
            return B64.from_bits(res.bits() & 0x000FFFFFFFFFFFFF)
        tt.hi == 1.0 =>
            # 2^(k/2^12) is exactly 1: add it in without a product
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: tt.hi, y: f.hi)
            s2: CmF64ExpDd = cm_b64_exp_fasttwosum(x: s.lo, y: f.lo)
            ul: U64 = s2.hi.bits()
            if ul & 0x000FFFFFFFFFFFFF == 0
                # the low part is a power of 2: nudge it one ulp toward the sign of the tail
                same: Bool = ul >> 63 == s2.lo.bits() >> 63
                u: U64 = when
                    same => ul +% 1
                    else => ul -% 1

                fl: B64 = B64.from_bits(u)
                s3: CmF64ExpDd = cm_b64_exp_fasttwosum(x: s.hi, y: fl)
                lo_bits: U64 = s3.lo.bits()
                d: U64 = lo_bits +% 2 & 0x000FFFFFFFFFFFFF
                if d <= 2
                    return cm_b64_exp_ldexp(x: cm_b64_exp_database(x, f: s3.hi), e: ie)
                return cm_b64_exp_ldexp(x: s3.hi, e: ie)
            s3: CmF64ExpDd = cm_b64_exp_fasttwosum(x: s.hi, y: s2.hi)
            lo_bits: U64 = s3.lo.bits()
            d: U64 = lo_bits +% 2 & 0x000FFFFFFFFFFFFF
            if d <= 2
                return cm_b64_exp_ldexp(x: cm_b64_exp_database(x, f: s3.hi), e: ie)
            return cm_b64_exp_ldexp(x: s3.hi, e: ie)
        else =>
            g: CmF64ExpDd = cm_b64_exp_muldd(xh: f.hi, xl: f.lo, ch: tt.hi, cl: tt.lo)
            h: CmF64ExpDd = cm_b64_exp_fastsum(xh: tt.hi, xl: tt.lo, yh: g.hi, yl: g.lo)
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: h.hi, y: h.lo)
            lo_bits: U64 = s.lo.bits()
            d: U64 = lo_bits +% 2 & 0x000FFFFFFFFFFFFF
            if d <= 2
                return cm_b64_exp_ldexp(x: cm_b64_exp_database(x, f: s.hi), e: ie)
            return cm_b64_exp_ldexp(x: s.hi, e: ie)

### The degree-6 double-double polynomial of the accurate path at xh + xl, by
### Horner's rule with fused double-word multiply-adds.
### :param xh: The high part of the point.
### :param xl: The low part of the point.
### :returns: The polynomial's value as a double-double.
secret routine cm_b64_exp_poly_acc(xh: B64, xl: B64) -> CmF64ExpDd
    local x: CmF64ExpDd = (hi: xh, lo: xl)
    local acc: @CmF64ExpDd <- .hollow()

    top_hi: B64 = B64.from_bits(CM_B64_EXP_ACC_CH.getitem(12))
    top_lo: B64 = B64.from_bits(CM_B64_EXP_ACC_CH.getitem(13))
    acc.poke(CmF64ExpDd(hi: top_hi, lo: top_lo))

    while i != 0 with i: U64 = 6
        i2: U64 = i - 1
        c0: B64 = B64.from_bits(CM_B64_EXP_ACC_CH.getitem(i2 * 2))
        c1: B64 = B64.from_bits(CM_B64_EXP_ACC_CH.getitem(i2 * 2 + 1))
        cm_b64_exp_fastfma_dw(a: x, b: acc.peek(), c: CmF64ExpDd(hi: c0, lo: c1)).poke_into(acc)
        continue with i: i2
    then
        return acc.peek()

### Looks x up among the arguments whose e^x lies too close to a rounding
### boundary for the accurate path, and returns the correctly rounded
### (unscaled) result for them, or f unchanged otherwise.
### :param x: The argument.
### :param f: The accurate path's unscaled result.
### :returns: The tabulated result for a listed `x`, else `f`.
secret routine cm_b64_exp_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 50
        m: S64 = a + b >> 1
        cm: U64 = CM_B64_EXP_DB.getitem(m.to[U64]())
        ux: U64 = x.bits()
        below: Bool = cm < ux
        when
            below => continue with a: m + 1, b: b
            cm == ux =>
                um: U64 = m.to_wrap[U64]()
                sign_bit: U64 = U64.arith_shift_right(333811522313371, um) << 63
                dr: B64 = B64.from_bits(sign_bit | 0x3C90000000000000)
                upper: Bool = um >> 5 == 1
                s2: U64 = when
                    upper => 0x3C1F16B8ED
                    else => 0x57F5FE2E5BDE4075
                t: U64 = (s2 >> ((um << 1) & 63)) & 3
                return cm_b64_exp_pick(f, t, dr)
            else => continue with a: a, b: m - 1
    then
        return f

### Picks, among f - 1ulp, f, f + 1ulp, the one whose two low bits equal t, and
### adds the tiny correction dr to it (the databases' encoding of a
### hard-to-round result). Returns f when no neighbour matches.
### :param f: The approximate result.
### :param t: The two low bits of the wanted neighbour.
### :param dr: The tiny correction.
### :returns: The matching neighbour plus `dr`, or `f`.
secret routine cm_b64_exp_pick(f: B64, t: U64, dr: B64) -> B64
    jf: U64 = f.bits()
    r0: U64 = jf -% 1
    r2: U64 = jf +% 1
    below: Bool = r0 & 3 == t
    same: Bool = jf & 3 == t
    when
        below => return B64.from_bits(r0) +! dr
        same => return B64.from_bits(jf) +! dr
        r2 & 3 == t => return B64.from_bits(r2) +! dr
        else => return f

### The double-double value of 2^((j mod 2^12) / 2^12), as the product of the
### table entries 2^(i0/2^6) and 2^(i1/2^12), where i0, i1 are bits 6..11 and
### 0..5 of j.
### :param j: The table index (only its low 12 bits are used).
### :returns: 2^((`j` mod 2^12) / 2^12) as a double-double.
secret routine cm_b64_exp_table_2pow(j: U64) -> CmF64ExpDd
    i0u: U64 = (j >> 6) & 0x3F
    i0: U64 = i0u.to[U64]()
    i1: U64 = (j & 0x3F).to[U64]()
    xh: B64 = B64.from_bits(CM_B64_EXP_T0.getitem(i0 * 2 + 1))
    xl: B64 = B64.from_bits(CM_B64_EXP_T0.getitem(i0 * 2))
    ch: B64 = B64.from_bits(CM_B64_EXP_T1.getitem(i1 * 2 + 1))
    cl: B64 = B64.from_bits(CM_B64_EXP_T1.getitem(i1 * 2))
    return cm_b64_exp_muldd(xh, xl, ch, cl)

### x 2^e by integer addition on the exponent field of x (no range checks):
### right only when the result stays normal.
### :param x: The value to scale.
### :param e: The power of two.
### :returns: `x` 2^`e`.
secret routine cm_b64_exp_ldexp(x: B64, e: S64) -> B64
    return B64.from_bits(x.bits() +% (e.to_wrap[U64]() << 52))

### Fast two-sum: s = x + y and its exact error, for |x| >= |y| (or x = 0).
### :param x: The larger addend.
### :param y: The smaller addend.
### :returns: The rounded sum and its exact error.
secret routine cm_b64_exp_fasttwosum(x: B64, y: B64) -> CmF64ExpDd
    s: B64 = x +! y
    z: B64 = s -! x
    return CmF64ExpDd(hi: s, lo: y -! z)

### Double-double sum (xh + xl) + (yh + yl), for |xh| >= |yh|.
### :param xh: The high part of the first addend.
### :param xl: The low part of the first addend.
### :param yh: The high part of the second addend.
### :param yl: The low part of the second addend.
### :returns: The sum as a double-double.
secret routine cm_b64_exp_fastsum(xh: B64, xl: B64, yh: B64, yl: B64) -> CmF64ExpDd
    s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: xh, y: yh)
    return CmF64ExpDd(hi: s.hi, lo: xl +! yl +! s.lo)

### Double-double product (xh + xl) (ch + cl).
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The product as a double-double.
secret routine cm_b64_exp_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64ExpDd
    ahhh: B64 = ch *! xh
    cross: B64 = ch *! xl +! cl *! xh
    lo: B64 = cross +! b64_mul_error(x: ch, y: xh, p: ahhh)
    return CmF64ExpDd(hi: ahhh, lo: lo)

### Double-word fused multiply-add `a` `b` + `c` (Jeannerod, Joldes, Louvet and
### Muller, Algorithm 4, with its last two FMAs split into a product and a sum as
### in CORE-MATH).
### :param a: The first factor, as a double-double.
### :param b: The second factor, as a double-double.
### :param c: The addend, as a double-double.
### :returns: The result as a double-double.
secret routine cm_b64_exp_fastfma_dw(a: CmF64ExpDd, b: CmF64ExpDd, c: CmF64ExpDd) -> CmF64ExpDd
    dh: B64 = a.hi.mul_add_unchecked(a: b.hi, b: c.hi)
    t: B64 = c.hi -! dh
    e: B64 = a.hi.mul_add_unchecked(a: b.hi, b: t)
    f: B64 = e +! c.lo
    g: B64 = a.hi *! b.lo +! f
    return CmF64ExpDd(hi: dh, lo: a.lo *! b.hi +! g)
