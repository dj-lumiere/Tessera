# Tessera stdlib: the correctly rounded hyperbolic cosine of B64
#
# For |x| < 1/8 an even polynomial, checked with an error bound and redone in double-double when the bound
# can't decide the rounding. Otherwise cosh x = (e^|x| + e^-|x|) / 2 with both exponentials from the tables
# and polynomial of HypShared.te (e^-|x| is dropped past |x| ~ 36.7), again checked with an error bound.
# The accurate path evaluates the exponentials in double-double and looks the few hardest arguments up in a
# table of exact values.
# Round to nearest only: overflow and ±inf give +inf, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary64/cosh/cosh.c via RazorForge's B64Cosh.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Hard-to-round arguments |x| (sorted), as B64 bits.
secret preset CM_B64_COSH_DB_X: @Array[U64, 21] <- [0x3FB9A5E3CBE1985E, 0x3FC52A11832E847D,
    0x3FCBF0305E2C6C37, 0x3FD17326FFC09F68, 0x3FD3D27BF16D8BDB, 0x3FE03923F2B47C07,
    0x3FEA6031CD5F93BA, 0x3FF104B648F113A1, 0x3FF1585720F35CD9, 0x3FFE9CC7ED2E1A7E,
    0x40043180EA854696, 0x401725811DCF6782, 0x4025AFD56F7D565B, 0x402759A2AD4C4D56,
    0x4027FCE95EA5C653, 0x403743D5609348AC, 0x404E07E71BFCF06F, 0x4056474C604CC0D7,
    0x40654CD1FEA7663A, 0x4072DA9E5E6AF0B0, 0x407D6479EBA7C971]

### The high parts of cosh x for those arguments, as B64 bits.
secret preset CM_B64_COSH_DB_H: @Array[U64, 21] <- [0x3FF01492F72F984B, 0x3FF0381E68CAC923,
    0x3FF061F4C39E16F2, 0x3FF099318A43AC80, 0x3FF0C6091056E06A, 0x3FF219C1989E3373,
    0x3FF5BFF041B260FE, 0x3FF9EFDCA62B700A, 0x3FFA5BF3ACFDE4B2, 0x400BB0FF220D8EB5,
    0x40191F1122B6B63A, 0x40645EA160DDC71F, 0x40D8FF8E0CCEA7C0, 0x40ECB62EEC26BD78,
    0x40F3BF8009648DC0, 0x41F7A87A8BB7FA28, 0x45491EC4412C344F, 0x47E7A8F65AD009BD,
    0x4F3C90810D354618, 0x5B127D6FE867D6F6, 0x6A462A88613629B6]

### The low parts, as B64 bits.
secret preset CM_B64_COSH_DB_L: @Array[U64, 21] <- [0xB940000000000000, 0x3970000000000000,
    0x3940000000000000, 0x3970000000000000, 0xB940000000000000, 0xBC90000000000000,
    0xB940000000000000, 0xB920000000000000, 0x3960000000000000, 0xBCA0000000000000,
    0x3990000000000000, 0xB9B0000000000000, 0x3A50000000000000, 0xBA30000000000000,
    0x3A70000000000000, 0xBE90000000000000, 0x3E70000000000000, 0xC130000000000000,
    0x4860000000000000, 0x5480000000000000, 0xE370000000000000]

### cosh `me`, correctly rounded.
### :returns: The hyperbolic cosine of `me`.
routine B64.cosh() -> Me
    local ax: Me = me.abs()
    local aix: U64 = ax.bits()

    small: Bool = aix < 0x3FC0000000000000  # |x| < 1/8
    # |x| > 0x1.633ce8fb9f87dp+9 ~ 710.47586
    when
        small =>
            # |x| < 2^-26
            if aix < 0x3E50000000000000
                return ax.mul_add(a: 0x1p-55, b: 1.0)
            # 1 + p is a minimax approximation of cosh x on [2^-26, 1/8], |1 + p - cosh x| < 2^-67.518 x^2
            x2: Me = me * me
            x4: Me = x2 * x2
            c0: Me = x2 * 0x1.5555555555554p-5 + 0x1p-1
            c4: Me = x2 * 0x1.a01a0075066b4p-16 + 0x1.6c16c16c1d0cp-10
            c48: Me = x4 * 0x1.27faff8dcc1c8p-22 + c4
            p: Me = x2 * (x4 * c48 + c0)
            e: Me = x2 * 0x1.84p-51
            lb: Me = p - e + 1.0
            ub: Me = p + e + 1.0
            if lb == ub
                return lb
            return cm_b64_cosh_zero(me)
        aix > 0x408633CE8FB9F87D =>
            # NaN, infinities, or overflow
            nan: Bool = aix > 0x7FF0000000000000
            when
                nan => return me + me
                aix == 0x7FF0000000000000 => return ax
                else => return Me.mul(0x1p+1023, 2.0)
        else => return cm_b64_cosh_main(me)

### cosh x for 1/8 <= |x| <= 0x1.633ce8fb9f87dp+9.
### :param x: The argument.
### :returns: cosh(`x`), correctly rounded.
secret routine cm_b64_cosh_main(x: B64) -> B64
    local ax: B64 = x.abs()
    local aix: U64 = ax.bits()
    # t = round(|x| 2^12 / log 2), and its bits il = 2^12 ie + 2^6 i0 + i1
    local v0: B64 = ax.mul_add(a: 0x1.71547652b82fep+12, b: 0x1.8000002p+26)
    local jt: U64 = v0.bits()
    local t: B64 = B64.from_bits(jt & 0xFFFFFFFFFC000000) - 0x1.8p+26
    local ilu: U64 = (jt << 14) >> 40
    local il: S64 = ilu.to[S64]()
    local ie: S64 = il >> 12
    local i1: U64 = (il & 0x3F).to[U64]()
    local i0s: S64 = (il >> 6) & 0x3F
    local i0: U64 = i0s.to[U64]()
    local sp: B64 = cm_b64_hyp_scale(ie + 1022)
    local tt: CmF64HypDd = cm_b64_hyp_table(i0, i1)
    # |x| = t log(2) / 2^12 + dx, with log(2) / 2^12 as l2h + l2l and l2h t exact
    local dx: B64 = ax - t * 0x1.62e42ffp-13 + t * 0x1.718432a1b0e26p-47
    local dx2: B64 = dx * dx
    local pp: B64 = cm_b64_hyp_poly(d: dx, d2: dx2)
    local jl: S64 = -il
    local th: B64 = tt.hi
    local tl: B64 = tt.lo

    # |x| > ~36.736801: e^-|x| is negligible
    when
        aix > 0x40425E4F7B2737FA =>
            # cosh x ~ e^|x| / 2
            sp_huge: B64 = cm_b64_hyp_scale(ie + 1021)
            rl: B64 = tl + th * pp
            e: B64 = B64.mul(0x1.1b578c96db19bp-63, th)  # 0.12e-18 in the original
            lb: B64 = th + (rl - e)
            ub: B64 = th + (rl + e)
            if lb == ub
                return lb * sp_huge * 2.0
            a0: CmF64HypDd = cm_b64_hyp_exp_accurate(x: ax, t, th, tl)
            a: CmF64HypDd = cm_b64_hyp_fasttwosum(x: a0.hi, y: a0.lo)
            hard: Bool = cm_b64_hyp_is_hard(h: a.hi, l: a.lo)
            r0: B64 = (a.hi + a.lo) * 2.0
            r: B64 = r0 * sp_huge
            if hard
                return cm_b64_cosh_database(x, f: r)
            return r
        aix > 0x4014000000000000 =>
            # 5 < |x| <= ~36.736801: e^-|x| matters only to the low part
            j1: U64 = (jl & 0x3F).to[U64]()
            j0s: S64 = (jl >> 6) & 0x3F
            j0: U64 = j0s.to[U64]()
            sm: B64 = cm_b64_hyp_scale((jl >> 12) + 1022)
            q: CmF64HypDd = cm_b64_hyp_table(i0: j0, i1: j1)
            th_scaled: B64 = th * sp
            tl_scaled: B64 = tl * sp
            qh: B64 = q.hi * sm
            pm: B64 = cm_b64_hyp_poly(d: -dx, d2: dx2)
            em: B64 = qh * pm + qh
            rl: B64 = tl_scaled + em + th_scaled * pp
            e: B64 = B64.mul(0x1.202p-63, th_scaled)
            lb: B64 = th_scaled + (rl - e)
            ub: B64 = th_scaled + (rl + e)
            if lb == ub
                return lb
            a: CmF64HypDd = cm_b64_hyp_exp_accurate(x: ax, t, th: th_scaled, tl: tl_scaled)
            # |x| > 0x1.f666666666666p+4
            if aix > 0x403F666666666666
                # e^-|x| as the one B64 qh
                rh: B64 = a.hi + qh
                err: B64 = a.hi - rh + qh
                # e^-|x| in double-double
                # 1/8 <= |x| <= 5
                s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: rh, y: err + a.lo)
                hard: Bool = cm_b64_hyp_is_hard(h: s.hi, l: s.lo)
                r: B64 = s.hi + s.lo
                if hard
                    return cm_b64_cosh_database(x, f: r)
                return r
            m: CmF64HypDd = cm_b64_hyp_exp_accurate(x: -ax, t: -t, th: q.hi * sm,
                tl: q.lo * sm)
            rh: B64 = a.hi + m.hi
            err: B64 = a.hi - rh + m.hi
            s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: rh, y: err + m.lo + a.lo)
            hard: Bool = cm_b64_hyp_is_hard(h: s.hi, l: s.lo)
            r: B64 = s.hi + s.lo
            if hard
                return cm_b64_cosh_database(x, f: r)
            return r
        else =>
            j1: U64 = (jl & 0x3F).to[U64]()
            j0s: S64 = (jl >> 6) & 0x3F
            j0: U64 = j0s.to[U64]()
            sm: B64 = cm_b64_hyp_scale((jl >> 12) + 1022)
            q: CmF64HypDd = cm_b64_hyp_table(i0: j0, i1: j1)
            th_scaled: B64 = th * sp
            tl_scaled: B64 = tl * sp
            qh: B64 = q.hi * sm
            ql: B64 = q.lo * sm
            pm: B64 = cm_b64_hyp_poly(d: -dx, d2: dx2)
            fpl: B64 = tl_scaled + th_scaled * pp
            fml: B64 = ql + qh * pm
            rh: B64 = th_scaled + qh
            err: B64 = th_scaled - rh + qh
            rl: B64 = err + fml + fpl
            e: B64 = B64.mul(0x1.c0ap-62, rh)
            lb: B64 = rh + (rl - e)
            ub: B64 = rh + (rl + e)
            if lb == ub
                return lb
            a: CmF64HypDd = cm_b64_hyp_exp_accurate(x: ax, t, th: th_scaled, tl: tl_scaled)
            m: CmF64HypDd = cm_b64_hyp_exp_accurate(x: -ax, t: -t, th: qh, tl: ql)
            rh2: B64 = a.hi + m.hi
            err2: B64 = a.hi - rh2 + m.hi
            s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: rh2, y: err2 + m.lo + a.lo)
            hard: Bool = cm_b64_hyp_is_hard(h: s.hi, l: s.lo)
            r: B64 = s.hi + s.lo
            if hard
                return cm_b64_cosh_database(x, f: r)
            return r

### The accurate path of cosh for 2^-26 <= |x| < 1/8: a double-double even polynomial.
### :param x: The argument.
### :returns: cosh(`x`), correctly rounded.
secret routine cm_b64_cosh_zero(x: B64) -> B64
    x2: B64 = x * x
    x2l: B64 = b64_mul_error(x, y: x, p: x2)
    x2dd: CmF64HypDd = (hi: x2, lo: x2l)
    c: B64 = x2 * 0x1.ae9891efb6691p-45 + 0x1.939749ce13dadp-37
    c2: B64 = x2 * c + 0x1.1eed8eff9089cp-29
    y2: B64 = x2 * (x2 * c2 + 0x1.27e4fb7789f5cp-22)
    p8: CmF64HypDd = cm_b64_hyp_polydd_init(l: y2, c_hi: 0x1.a01a01a01a01ap-16,
        c_lo: 0x1.a4ffbe15316aap-76)
    p6: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p8,
        c: CmF64HypDd(hi: 0x1.6c16c16c16c17p-10, lo: -0x1.f49f4a6e838f2p-65))
    p4: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p6,
        c: CmF64HypDd(hi: 0x1.5555555555555p-5, lo: 0x1.5555555556135p-59))
    p2: CmF64HypDd = cm_b64_hyp_polydd_step(x: x2dd, value: p4,
        c: CmF64HypDd(hi: 0x1p-1, lo: -0x1.c7e8db669f624p-111))
    p: CmF64HypDd = cm_b64_hyp_muldd(xh: p2.hi, xl: p2.lo, ch: x2, cl: x2l)
    s0: CmF64HypDd = cm_b64_hyp_fasttwosum(x: 1.0, y: p.hi)
    s1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: s0.lo, y: p.lo)
    y1: B64 = cm_b64_hyp_nudge(y1: s1.hi, y2: s1.lo)
    r: B64 = s0.hi + y1
    m: U64 = y1.bits() & 0x000FFFFFFFFFFFFF
    if m == 0x000FFFFFFFFFFFFF
        return cm_b64_cosh_database(x, f: r)
    return r

### The exact cosh x for the arguments the fast and accurate paths can't round, or f for any other x.
### :param x: The argument.
### :param f: The result for an argument that is not in the table.
### :returns: The tabulated cosh(`x`) for a listed `x`, else `f`.
secret routine cm_b64_cosh_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 20
        m: S64 = (a + b).div_trunc(2)
        mu: U64 = m.to[U64]()
        key: B64 = B64.from_bits(CM_B64_COSH_DB_X.getitem(mu))
        ax: B64 = x.abs()
        below: Bool = key < ax
        when
            below => continue with a: m + 1, b: b
            key == ax =>
                h: B64 = B64.from_bits(CM_B64_COSH_DB_H.getitem(mu))
                l: B64 = B64.from_bits(CM_B64_COSH_DB_L.getitem(mu))
                return h + l
            else => continue with a: a, b: m - 1
    then
        return f
