        sgn: CM_B64_POW_T2_2_SGN.getitem(i))

### Coefficient i of the second-phase log(1+z) polynomial, highest degree first.
### :param i: The coefficient index.
### :returns: The coefficient.
secret routine cm_b64_pow_p_2_at(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_P_2_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_P_2_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_P_2_EX.getitem(i),
        sgn: CM_B64_POW_P_2_SGN.getitem(i))

### Coefficient i of the second-phase exp(z) polynomial, highest degree first.
### :param i: The coefficient index.
### :returns: The coefficient.
secret routine cm_b64_pow_q_2_at(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_Q_2_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_Q_2_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_Q_2_EX.getitem(i),
