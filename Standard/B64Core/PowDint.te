# Tessera stdlib: 128-bit floating-point arithmetic for the second phase of the B64 power x^y
#
# A CmF64PowDint is (-1)^sgn r 2^(ex - 127), with the top bit of r set when normalized (the C dint64_t). The
# second phase computes exp(y log(x)) with it to a relative error below 2^-117.
#
# Ported from CORE-MATH, src/binary64/pow/pow.c and dint.h via RazorForge's B64Pow.rf.
# Copyright (c) 2022-2025 CERN and Inria
# Authors: Tom Hubrecht and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### A 128-bit floating-point value (-1)^sgn r 2^(ex - 127).
record CmF64PowDint
    r: U128
    ex: S64
    sgn: U64

### The upper 64 bits of v.
### :param v: The 128-bit value.
### :returns: The upper limb.
secret routine cm_b64_pow_hi(v: U128) -> U64
    return (v >> 64).to_wrap[U64]()

### The lower 64 bits of v.
### :param v: The 128-bit value.
### :returns: The lower limb.
secret routine cm_b64_pow_lo(v: U128) -> U64
    return v.to_wrap[U64]()

### hi 2^64 + lo.
### :param hi: The upper limb.
### :param lo: The lower limb.
### :returns: The 128-bit value.
secret routine cm_b64_pow_join(hi: U64, lo: U64) -> U128
    hi_part: U128 = hi.to[U128]() << 64
    return hi_part | lo.to[U128]()

### The zero CmF64PowDint.
### :returns: Zero, with exponent -1076.
secret routine cm_b64_pow_dint_zero() -> CmF64PowDint
    return CmF64PowDint(r: 0, ex: -1076, sgn: 0)

### Compares |a| and |b|: -1, 0 or 1.
### :param a: The first value.
### :param b: The second value.
### :returns: -1 when |a| < |b|, 0 when they are equal, 1 when |a| > |b|.
secret routine cm_b64_pow_cmp_dint_abs(a: CmF64PowDint, b: CmF64PowDint) -> S64
    a_zero: Bool = cm_b64_pow_hi(a.r) == 0
    b_zero: Bool = cm_b64_pow_hi(b.r) == 0
    both: Bool = a_zero and b_zero
    by_ex: S32 = a.ex.compare(b.ex)
    by_r: S32 = a.r.compare(b.r)
    c: S32 = when
        by_ex != 0 => by_ex
        else => by_r
    when
        both => return 0
        a_zero => return -1
        b_zero => return 1
        else => return c.to[S64]()

### Compares |a| and |b| using only their upper limbs: -1, 0 or 1.
### :param a: The first value.
### :param b: The second value.
### :returns: -1, 0 or 1 as |a| is below, equal to or above |b|.
secret routine cm_b64_pow_cmp_dint_11(a: CmF64PowDint, b: CmF64PowDint) -> S64
    by_ex: S32 = a.ex.compare(b.ex)
    by_r: S32 = cm_b64_pow_hi(a.r).compare(cm_b64_pow_hi(b.r))
    c: S32 = when
        by_ex != 0 => by_ex
        else => by_r
    return c.to[S64]()

### a + b with error below 2 ulps (exact in the Sterbenz case).
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
secret routine cm_b64_pow_add_dint(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    if a.r == 0
        return b
    c: S64 = cm_b64_pow_cmp_dint_abs(a, b)
    if c == 0
        if a.sgn != b.sgn
            return cm_b64_pow_dint_zero()
        return CmF64PowDint(r: a.r, ex: a.ex + 1, sgn: a.sgn)
    swap: Bool = c < 0
    aa: CmF64PowDint = when
        swap => b
        else => a
    bb: CmF64PowDint = when
        swap => a
        else => b
    k: U64 = (aa.ex -% bb.ex).to_wrap[U64]()
    big_b: U128 = bb.r >> k.to[U128]()
    if aa.sgn != bb.sgn
        cc: U128 = aa.r -% big_b
        ex: U64 = cc.leading_zeros().to_wrap[U64]()
        renorm: Bool = ex > 0
        values2: (U128, U64, S64, U64) = when
            renorm =>
                # redo the subtraction with both operands shifted left by ex, so that no bit of b is lost
                shifted_a: U128 = aa.r << ex.to[U128]()
                near: Bool = k == 1
                shifted_b: U128 = when
                    near => bb.r << (ex - 1).to[U128]()
                    else => big_b << ex.to[U128]()
                cc2: U128 = shifted_a -% shifted_b
                becomes (cc2, cm_b64_pow_hi(cc2).leading_zeros(), aa.ex - ex.to[S64](), aa.sgn)
            else => (cc, 0, aa.ex, aa.sgn)
        cc2, ex2, rex, sgn = values2
        return CmF64PowDint(r: cc2 << ex2.to[U128](), ex: rex - ex2.to[S64](), sgn: sgn)
    cc: U128 = aa.r +% big_b
    if cc < aa.r
        return CmF64PowDint(r: U128.shift_left(1, 127) | (cc >> 1), ex: aa.ex + 1, sgn: aa.sgn)
    return CmF64PowDint(r: cc, ex: aa.ex, sgn: aa.sgn)

### a + b using only the upper limbs of a and b, with error below 2 ulps (64-bit ulps). The lower limb of the
### result keeps the lower limb of b, as the C code (which writes into b) does.
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
secret routine cm_b64_pow_add_dint_11(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    a_zero: Bool = cm_b64_pow_hi(a.r) == 0
    when
        a_zero => return b
        cm_b64_pow_hi(b.r) == 0 => return a
        else =>
            stale: U64 = cm_b64_pow_lo(b.r)
            c: S64 = cm_b64_pow_cmp_dint_11(a, b)
            if c == 0
                if a.sgn != b.sgn
                    return cm_b64_pow_dint_zero()
                return CmF64PowDint(r: a.r, ex: a.ex + 1, sgn: a.sgn)
            swap: Bool = c < 0
            aa: CmF64PowDint = when
                swap => b
                else => a
            bb: CmF64PowDint = when
                swap => a
                else => b
            big_a: U64 = cm_b64_pow_hi(aa.r)
            apart: Bool = aa.ex > bb.ex
            k: U64 = when
                apart => (aa.ex -% bb.ex).to_wrap[U64]()
                else => 0
            big_b: U64 = cm_b64_pow_hi(bb.r) >> k
            if aa.sgn != bb.sgn
                rex: S64 = aa.ex

                sgn: U64 = aa.sgn
                cc: U64 = big_a -% big_b
                ex: U64 = cc.leading_zeros()
                renorm: Bool = ex > 0
                values2: (U64, U64, S64) = when
                    renorm =>
                        cc2: U64 = (big_a << ex) -% (big_b << ex)
                        becomes (cc2, cc2.leading_zeros(), rex - ex.to[S64]())
                    else => (cc, 0, rex)
                cc2, ex2, rex2 = values2
                r: U128 = cm_b64_pow_join(hi: cc2 << ex2, lo: stale)
                return CmF64PowDint(r: r, ex: rex2 - ex2.to[S64](), sgn: sgn)
            rex: S64 = aa.ex
            cc: U64 = big_a +% big_b
            carry: Bool = cc < big_a
            hi: U64 = when
                carry => (cc >> 1) | 0x8000000000000000
                else => cc
            ex: S64 = when
                carry => rex + 1
                else => rex
            return CmF64PowDint(r: cm_b64_pow_join(hi, lo: stale), ex: ex, sgn: aa.sgn)

### Normalizes a 128-bit product whose top bit is at position 126 or 127.
### :param r: The product's 128 bits.
### :param ex: The exponent before normalization.
### :param sgn: The sign bit.
### :returns: The normalized value.
secret routine cm_b64_pow_dint_norm(r: U128, ex: S64, sgn: U64) -> CmF64PowDint
    top: Bool = r >> 127 != 0
    rr: U128 = when
        top => r
        else => r << 1
    rex: S64 = when
        top => ex + 1
        else => ex
    return CmF64PowDint(r: rr, ex: rex, sgn: sgn)

### a b with error below 6 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine cm_b64_pow_mul_dint(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    bh: U64 = cm_b64_pow_hi(b.r)
    bl: U64 = cm_b64_pow_lo(b.r)
    ah: U64 = cm_b64_pow_hi(a.r)
    m1: U128 = ah.mul_wide(bl)
    m2: U128 = cm_b64_pow_lo(a.r).mul_wide(bh)
    r0: U128 = ah.mul_wide(bh)
    r: U128 = r0 +% ((m1 >> 64) +% (m2 >> 64))
    return cm_b64_pow_dint_norm(r, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### a b assuming the lower limb of b is zero, with error below 2 ulps.
### :param a: The first factor.
### :param b: The second factor, its lower limb zero.
### :returns: The product.
secret routine cm_b64_pow_mul_dint_21(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    bh: U64 = cm_b64_pow_hi(b.r)
    hi: U128 = cm_b64_pow_hi(a.r).mul_wide(bh)
    lo: U128 = cm_b64_pow_lo(a.r).mul_wide(bh)
    return cm_b64_pow_dint_norm(r: hi +% (lo >> 64), ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### a b using only the upper limbs of a and b (exact).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product of the upper limbs.
secret routine cm_b64_pow_mul_dint_11(a: CmF64PowDint, b: CmF64PowDint) -> CmF64PowDint
    r: U128 = cm_b64_pow_hi(a.r).mul_wide(cm_b64_pow_hi(b.r))
    return cm_b64_pow_dint_norm(r, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### a b for an integer b, with error below 1 ulp.
### :param a: The value.
### :param b: The integer factor.
### :returns: The product.
secret routine cm_b64_pow_mul_dint_int64(a: CmF64PowDint, b: S64) -> CmF64PowDint
    if b == 0
        return cm_b64_pow_dint_zero()
    neg: Bool = b < 0
    c0: U64 = b.to_wrap[U64]()
    c: U64 = when
        neg => U64.sub_wrap(0, c0)
        else => c0
    sgn: U64 = when
        neg => a.sgn ^ 1
        else => a.sgn
    r0: U128 = cm_b64_pow_hi(a.r).mul_wide(c)
    rh: U64 = cm_b64_pow_hi(r0)
    m: U64 = when
        rh != 0 => rh.leading_zeros()
        else => 64
    r1: U128 = r0 << m.to[U128]()
    rex: S64 = a.ex + 64 - m.to[S64]()
    l0: U128 = cm_b64_pow_lo(a.r).mul_wide(c)
    l: U128 = (l0 << (m -% 1).to[U128]()) >> 63
    r: U128 = r1 +% l
    if r < l
        return CmF64PowDint(r: U128.shift_left(1, 127) | (r >> 1), ex: rex + 1, sgn: sgn)
    return CmF64PowDint(r: r, ex: rex, sgn: sgn)

### A nonzero finite B64 as a CmF64PowDint (exact).
### :returns: `me` as a normalized CmF64PowDint.
routine B64.to[CmF64PowDint]() -> CmF64PowDint
    u: U64 = me.bits()
    exp_field: U64 = (u >> 52) & 0x7FF
    e0: S64 = exp_field.to[S64]()
    m0: U64 = u & 0x000FFFFFFFFFFFFF
    normal: Bool = e0 != 0
    m1: U64 = when
        normal => m0 + 0x0010000000000000
        else => m0
    e1: S64 = e0 - 0x3FF
    t: U64 = m1.leading_zeros()
    sgn: U64 = when
        me < 0.0 => 1
        else => 0
    e: S64 = when
        t > 11 => e1 - (t.to[S64]() - 12)
        else => e1
    return CmF64PowDint(r: cm_b64_pow_join(hi: m1 << t, lo: 0), ex: e, sgn: sgn)

### a as an integer, rounded toward zero.
### :param a: The value, below 2^63 in magnitude.
### :returns: The integer part of `a`.
secret routine cm_b64_pow_dint_toi(a: CmF64PowDint) -> S64
    if a.ex < 0
        return 0
    integer_part: U64 = cm_b64_pow_hi(a.r) >> S64.sub(63, a.ex).to_wrap[U64]()
    r: S64 = integer_part.to_wrap[S64]()
    if a.sgn != 0
        return S64.sub(0, r)
    return r

### log(1+z) for |z| <= 2^-13 (lower limb of z zero), with relative error below 2^-124.82.
### :param z: The reduced argument.
### :returns: log(1 + `z`).
secret routine cm_b64_pow_p_2(z: CmF64PowDint) -> CmF64PowDint
    local r: @CmF64PowDint <- .hollow()

    r1: CmF64PowDint = cm_b64_pow_mul_dint_11(a: z, b: cm_b64_pow_p_2_at(0))
    r2: CmF64PowDint = cm_b64_pow_add_dint_11(a: cm_b64_pow_p_2_at(1), b: r1)
    r3: CmF64PowDint = cm_b64_pow_mul_dint_11(a: z, b: r2)
    r4: CmF64PowDint = cm_b64_pow_add_dint_11(a: cm_b64_pow_p_2_at(2), b: r3)
    r5: CmF64PowDint = cm_b64_pow_mul_dint_11(a: z, b: r4)
    r6: CmF64PowDint = cm_b64_pow_add_dint_11(a: cm_b64_pow_p_2_at(3), b: r5)
    r7: CmF64PowDint = cm_b64_pow_mul_dint_11(a: z, b: r6)
    r8: CmF64PowDint = cm_b64_pow_add_dint(a: cm_b64_pow_p_2_at(4), b: r7)
    r8.poke_into(r)

    while true with k: U64 = 5
        zr2: CmF64PowDint = cm_b64_pow_mul_dint_21(a: r.peek(), b: z)
        if k == 9
            return zr2
        next: CmF64PowDint = cm_b64_pow_add_dint(a: cm_b64_pow_p_2_at(k), b: zr2)
        next.poke_into(r)
        continue with k: k + 1

### exp(y) for |y| < 0.00016923, with relative error below 2^-122.29.
### :param y: The reduced argument.
### :returns: exp(`y`).
secret routine cm_b64_pow_q_2(y: CmF64PowDint) -> CmF64PowDint
    local r: @CmF64PowDint <- .hollow()

    r1: CmF64PowDint = cm_b64_pow_mul_dint_11(a: y, b: cm_b64_pow_q_2_at(0))
    r2: CmF64PowDint = cm_b64_pow_add_dint_11(a: cm_b64_pow_q_2_at(1), b: r1)
    r3: CmF64PowDint = cm_b64_pow_mul_dint_11(a: y, b: r2)
    r4: CmF64PowDint = cm_b64_pow_add_dint_11(a: cm_b64_pow_q_2_at(2), b: r3)
    r5: CmF64PowDint = cm_b64_pow_mul_dint_11(a: y, b: r4)
    r6: CmF64PowDint = cm_b64_pow_add_dint(a: cm_b64_pow_q_2_at(3), b: r5)
    r6.poke_into(r)

    each k: U64 in 4 til 8
        yr: CmF64PowDint = cm_b64_pow_mul_dint(a: y, b: r.peek())
        next: CmF64PowDint = cm_b64_pow_add_dint(a: cm_b64_pow_q_2_at(k), b: yr)
        next.poke_into(r)
    then
        return r.peek()

### log(x) with relative error below 2^-122.88.
### :param x: The positive argument.
### :returns: log(`x`).
secret routine cm_b64_pow_log_2(x: CmF64PowDint) -> CmF64PowDint
    xh: U64 = cm_b64_pow_hi(x.r)
    above: Bool = xh > 0xB504F333F9DE6484
    big_e: S64 = when
        above => x.ex + 1
        else => x.ex
    i: U64 = when  # 90 <= i <= 181, sqrt(2)/2 < x < sqrt(2)
        above => xh >> 57
        else => xh >> 56
    ii: U64 = (i - 90).to[U64]()
    xx: CmF64PowDint = CmF64PowDint(r: x.r, ex: x.ex - big_e, sgn: x.sgn)
    z1: CmF64PowDint = cm_b64_pow_mul_dint_11(a: xx, b: cm_b64_pow_inverse_2_1(ii))
    j: U64 = cm_b64_pow_hi(z1.r) >> S64.sub(50, z1.ex).to_wrap[U64]()
    jj: U64 = (j - 8128).to[U64]()
    z2: CmF64PowDint = cm_b64_pow_mul_dint_11(a: z1, b: cm_b64_pow_inverse_2_2(jj))
    m_one: CmF64PowDint = CmF64PowDint(r: U128.shift_left(1, 127), ex: 0, sgn: 1)
    z: CmF64PowDint = cm_b64_pow_add_dint(a: m_one, b: z2)
    log2: CmF64PowDint = CmF64PowDint(
        r: cm_b64_pow_join(hi: 0xB17217F7D1CF79AB, lo: 0xC9E3B39803F2F6AF), ex: -1, sgn: 0)
    r: CmF64PowDint = cm_b64_pow_mul_dint_int64(a: log2, b: big_e)
    p0: CmF64PowDint = cm_b64_pow_p_2(z)
    p1: CmF64PowDint = cm_b64_pow_add_dint(a: cm_b64_pow_log_inv_2_2(jj), b: p0)
    p2: CmF64PowDint = cm_b64_pow_add_dint(a: cm_b64_pow_log_inv_2_1(ii), b: p1)
    return cm_b64_pow_add_dint(a: p2, b: r)

### exp(x) for |x| < 744.45 with relative error below 2^-121.70. For larger |x| a value whose exponent marks the
### underflow (-1076) or overflow (1025).
### :param x: The argument.
### :returns: exp(`x`), or a value with exponent -1076 or 1025 when |x| is too large.
secret routine cm_b64_pow_exp_2(x: CmF64PowDint) -> CmF64PowDint
    if x.ex >= 10
        if x.sgn == 1
            return CmF64PowDint(r: x.r, ex: -1076, sgn: 0)
        return CmF64PowDint(r: x.r, ex: 1025, sgn: 0)
    log2: CmF64PowDint = CmF64PowDint(
        r: cm_b64_pow_join(hi: 0xB17217F7D1CF79AB, lo: 0xC9E3B39803F2F6AF), ex: -1, sgn: 0)
    log2_inv: CmF64PowDint = CmF64PowDint(r: cm_b64_pow_join(hi: 0xB8AA3B295C17F0BC, lo: 0),
        ex: 12, sgn: 0)
    kk0: CmF64PowDint = cm_b64_pow_mul_dint_11(a: x, b: log2_inv)
    k: S64 = cm_b64_pow_dint_toi(kk0)
    kk1: CmF64PowDint = cm_b64_pow_mul_dint_int64(a: log2, b: k)
    kk: CmF64PowDint = CmF64PowDint(r: kk1.r, ex: kk1.ex - 12, sgn: kk1.sgn ^ 1)
    y: CmF64PowDint = cm_b64_pow_add_dint(a: x, b: kk)
    big_m: S64 = k >> 12
    k_high: U64 = (k >> 6).to_wrap[U64]()
    i2: U64 = (k_high & 0x3F).to[U64]()
    k_bits: U64 = k.to_wrap[U64]()
    i1: U64 = (k_bits & 0x3F).to[U64]()
    r0: CmF64PowDint = cm_b64_pow_q_2(y)
    r1: CmF64PowDint = cm_b64_pow_mul_dint(a: cm_b64_pow_t1_2(i2), b: r0)
    r2: CmF64PowDint = cm_b64_pow_mul_dint(a: cm_b64_pow_t2_2(i1), b: r1)
    return CmF64PowDint(r: r2.r, ex: r2.ex + big_m, sgn: r2.sgn)

### a (with a.ex < -1022) rounded to the nearest subnormal B64.
### :param a: The value.
### :returns: The nearest subnormal B64 (or a signed zero), with the sign of `a`.
secret routine cm_b64_pow_dint_tod_subnormal(a: CmF64PowDint) -> B64
    local ah: U64 = cm_b64_pow_hi(a.r)
    local al: U64 = cm_b64_pow_lo(a.r)
    local ex: U64 = S64.sub(0, a.ex + 1011).to_wrap[U64]()

    if ex >= 64
        # all bits disappear: |a| < 2^-1074
        rb0: U64 = ah >> 63
        sb0: U64 = (ah << 1) | al
        no_round: Bool = ex > 64 or rb0 == 0
        zero: Bool = no_round or sb0 == 0
        ret: B64 = when
            zero => 0.0
            else => B64.from_bits(1)
        if a.sgn != 0
            return -ret
        return ret
    hi0: U64 = ah >> ex
    rb: U64 = (ah >> ex - 1) & 1
    ah_sticky: Bool = ah << U64.sub(65, ex) != 0
    sticky: Bool = ah_sticky or al != 0
    hi: U64 = when
        sticky => hi0 + rb
        else => hi0 + (hi0 & rb)
    return B64.from_bits(hi | (a.sgn << 63))

### a rounded to the nearest B64. An exponent below -1022 goes through the subnormal rounding.
### :returns: The nearest B64, an infinity of the sign of `me` when it overflows.
routine CmF64PowDint.to[B64]() -> B64
    if me.ex < -1022
        return cm_b64_pow_dint_tod_subnormal(me)
    ah: U64 = cm_b64_pow_hi(me.r)
    al: U64 = cm_b64_pow_lo(me.r)
    r0: B64 = B64.from_bits((ah >> 11) | 0x3FF0000000000000)  # the significand in [1, 2)
    round_bit: U64 = (ah >> 10) & 1
    half: Bool = round_bit != 0
    rd0: B64 = when
        half => B64.add(0.0, 0x1p-53)
        else => 0.0
    ah_sticky: Bool = ah & 0x3FF != 0
    sticky: Bool = ah_sticky or al != 0
    rd1: B64 = when
        sticky => rd0 + 0x1p-54
        else => rd0
    neg: Bool = me.sgn != 0
    rd: B64 = when
        neg => -rd1
        else => rd1
    r1: B64 = B64.from_bits(r0.bits() | (me.sgn << 63))
    r: B64 = r1 + rd
    edge: Bool = me.ex == 1024
    when
        edge => return r * 2.0 * 0x1p+1023
        me.ex > 1023 => return r * 0x1.fffffffffffffp+1023 * 0x1.fffffffffffffp+1023
        else =>
            biased_exponent: U64 = (me.ex + 1023).to_wrap[U64]()
            return r * B64.from_bits((biased_exponent & 0x7FF) << 52)

### A CmF64PowDint from a table entry's two limbs, exponent and sign.
### :param hi: The upper limb.
### :param lo: The lower limb.
### :param ex: The exponent.
### :param sgn: The sign bit.
### :returns: The value.
secret routine cm_b64_pow_dint_entry(hi: U64, lo: U64, ex: S64, sgn: U64) -> CmF64PowDint
    return CmF64PowDint(r: cm_b64_pow_join(hi, lo), ex: ex, sgn: sgn)

### Entry i of CM_B64_POW_INVERSE_2_1, the 128-bit inverses of the first log reduction.
### :param i: The index, 0..91.
### :returns: The inverse.
secret routine cm_b64_pow_inverse_2_1(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_INVERSE_2_1_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_INVERSE_2_1_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_INVERSE_2_1_EX.getitem(i),
        sgn: CM_B64_POW_INVERSE_2_1_SGN.getitem(i))

### Entry i of CM_B64_POW_INVERSE_2_2, the 128-bit inverses of the second log reduction.
### :param i: The index, 0..128.
### :returns: The inverse.
secret routine cm_b64_pow_inverse_2_2(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_INVERSE_2_2_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_INVERSE_2_2_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_INVERSE_2_2_EX.getitem(i),
        sgn: CM_B64_POW_INVERSE_2_2_SGN.getitem(i))

### Entry i of CM_B64_POW_LOG_INV_2_1, the 128-bit -log of the first-reduction inverse.
### :param i: The index, 0..91.
### :returns: The logarithm.
secret routine cm_b64_pow_log_inv_2_1(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_LOG_INV_2_1_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_LOG_INV_2_1_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_LOG_INV_2_1_EX.getitem(i),
        sgn: CM_B64_POW_LOG_INV_2_1_SGN.getitem(i))

### Entry i of CM_B64_POW_LOG_INV_2_2, the 128-bit -log of the second-reduction inverse.
### :param i: The index, 0..128.
### :returns: The logarithm.
secret routine cm_b64_pow_log_inv_2_2(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_LOG_INV_2_2_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_LOG_INV_2_2_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_LOG_INV_2_2_EX.getitem(i),
        sgn: CM_B64_POW_LOG_INV_2_2_SGN.getitem(i))

### Entry i of CM_B64_POW_T1_2, the 128-bit 2^(i/64).
### :param i: The index, 0..63.
### :returns: 2^(`i`/64).
secret routine cm_b64_pow_t1_2(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_T1_2_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_T1_2_MANT.getitem(i * 2 + 1)
    return cm_b64_pow_dint_entry(hi, lo, ex: CM_B64_POW_T1_2_EX.getitem(i),
        sgn: CM_B64_POW_T1_2_SGN.getitem(i))

### Entry i of CM_B64_POW_T2_2, the 128-bit 2^(i/2^12).
### :param i: The index, 0..63.
### :returns: 2^(`i`/2^12).
secret routine cm_b64_pow_t2_2(i: U64) -> CmF64PowDint
    hi: U64 = CM_B64_POW_T2_2_MANT.getitem(i * 2)
    lo: U64 = CM_B64_POW_T2_2_MANT.getitem(i * 2 + 1)
