# Tessera stdlib: the correctly rounded base-2 exponential 2^x of B64
#
# x = (k + z) / 2^12 with k an integer: 2^(k/2^12) as a double-double from
# the exp tables, 2^(z/2^12) from a short polynomial. Integers give exact
# powers of two. When the fast path can't decide the rounding, a degree-6
# double-double polynomial redoes it, and a few arguments too close to a
# rounding boundary even for that are looked up. Round to nearest only:
# overflow gives +inf, underflow a correctly rounded subnormal or +0, NaN
# comes back quiet.
#
# Ported from CORE-MATH, src/binary64/exp2/exp2.c via RazorForge's B64Exp2.rf.
# Copyright (c) 2023-2026 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Double-double coefficients (high, low) of the accurate polynomial, as B64 bits.
secret preset CM_B64_EXP2_ACC_CD: @Array[U64, 12] <- [0x3F262E42FEFA39EF, 0x3BBABC9E3B39873E,
    0x3E4EBFBDFF82C58F, 0xBAE5E43A53E44950, 0x3D6C6B08D704A0C0, 0xBA0D3A15710D3D83,
    0x3C83B2AB6FBA4E77, 0x3914DD5D2A5E025A, 0x3B95D87FE7A66459, 0xB83DC47E47BEB9DD,
    0x3AA430912F9FB79D, 0xB744FCD51FCB7640]

### The arguments (sorted bits) whose 2^x is too close to a rounding boundary
### for the accurate path.
secret preset CM_B64_EXP2_DB: @Array[U64, 43] <- [0x3F5E4596526BF94D, 0x3F5E76049073067F,
    0x3F6755AA6FA428CD, 0x3F679015CE2843D7, 0x3F7F99AFEFA30D65, 0x3F98D040898B73F5,
    0x3FB673A7779D5293, 0x3FB8859F5E252908, 0x3FBFA18DFAD6E466, 0x3FC6C4175EA0C6E1,
    0x3FC926961243BABA, 0x3FE3E34FA6AB969E, 0x3FEB32A6C92D1185, 0x3FF9F1A7D355CB4F,
    0xBF243C1CEA9BD4D9, 0xBF277970470A37ED, 0xBF27D44C7C8229A6, 0xBF395A914543EAB7,
    0xBF399BE01D01064A, 0xBF413F898B1E4F28, 0xBF468E7A49000B1C, 0xBF486D2A6E5E8368,
    0xBF5120D3BDFB6ED8, 0xBF53EC814D260D02, 0xBF647B667916C4B2, 0xBF6899E0474BA2D5,
    0xBF6BA84C6EBFB038, 0xBF7111BC29CCDBB1, 0xBF71FB57E1996E26, 0xBF772E40977492C3,
    0xBF7EBF8CF367FCB8, 0xBF807F812303F10A, 0xBF9234ADA2403885, 0xBF935DD739305031,
    0xBFA526CE079B05A5, 0xBFB3EA95A5C16E4A, 0xBFC33564DB4BB9EC, 0xBFCD4854D9F87FCA,
    0xBFCFE89353E31CBF, 0xBFD83960B2A8D2C4, 0xBFDE242801B45D0D, 0xBFECEF4C143B5ADF,
    0xBFF60E582CAA34B1]

### 2^me, correctly rounded (to nearest, ties to even). 2^-inf = +0, 2^+inf = +inf, overflow gives +inf,
### underflow a correctly rounded subnormal or +0, and NaN comes back quiet. 2^n is exact for integer n.
### :returns: 2^`me`, correctly rounded.
routine B64.exp2_unchecked() -> Me
    local ux: U64 = me.bits()
    local ax: U64 = ux << 1

    zero: Bool = ax == 0
    # |x| >= 1024, infinite or NaN
    # |x| <= 0x1.71547652b82fep-54: 2^x rounds to 1
    when
        zero => return 1.0
        ax >= 0x8120000000000000 =>
            nan: Bool = ax > 0xFFE0000000000000
            inf: Bool = ax == 0xFFE0000000000000
            positive: Bool = ux >> 63 == 0
            # x <= -1075
            when
                nan => return me +! me
                inf =>
                    # x >= 1024: overflow
                    if positive
                        return me
                    return 0.0
                positive => return Me.mul_unchecked(0x1p1023, me)
                ux >= 0xC090CC0000000000 => return 0.0
                else => pass
        ax <= 0x792E2A8ECA5705FC => return Me.add_unchecked(1.0, Me.copysign(0x1p-54, me))
        else => pass
    # frac is nonzero exactly when x is not an integer
    m: U64 = ux << 12
    ex: U64 = (ax >> 53) -% 0x3FF
    frac: U64 = (ex >> 63) | (m << (ex & 63))
    sx: Me = Me.mul_unchecked(4096.0, me)
    fx: Me = sx.round_ties_even()
    z: Me = sx -! fx
    z2: Me = z *! z
    k: S64 = fx.to[S64]()
    ie: S64 = k >> 12
    tt: CmF64ExpDd = cm_b64_exp_table_2pow(k.to_wrap[U64]())
    tz: Me = tt.hi *! z
    p01: Me = Me.add_unchecked(0x1.62e42fefa39efp-13, z *! 0x1.ebfbdff82c58fp-27)
    p23: Me = Me.add_unchecked(0x1.c6b08d73b3e01p-41, z *! 0x1.3b2ab6fdda001p-55)
    fl: Me = tz *! (p01 +! z2 *! p23) +! tt.lo
    normal: Bool = ux <= 0xC08FF00000000000  # x >= -1022
    whole: Bool = frac == 0
    when
        normal =>
            fh: Me = tt.hi
            if whole
                return cm_b64_exp_ldexp(x: fh, e: ie)
            ub: Me = fh +! (fl +! 0x1.fdp-63)
            lb: Me = fh +! (fl -! 0x1.fdp-63)
            if ub == lb
                return cm_b64_exp_ldexp(x: lb, e: ie)
            return cm_b64_exp2_accurate(me)
        else =>
            bias_e: U64 = S64.sub(1, ie).to_wrap[U64]()
            bias: Me = Me.from_bits(bias_e << 52)
            s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: bias, y: tt.hi)
            sl: Me = fl +! s.lo
            if whole
                return Me.from_bits(s.hi.bits() & 0x000FFFFFFFFFFFFF)
            ub: Me = s.hi +! (sl +! 0x1.fdp-63)
            lb: Me = s.hi +! (sl -! 0x1.fdp-63)
            if ub == lb
                return Me.from_bits(lb.bits() & 0x000FFFFFFFFFFFFF)
            return cm_b64_exp2_accurate(me)

### The slow accurate path of exp2, for finite x that is not an integer, with
### 2^x neither overflowing nor below 2^-1075.
### :param x: The argument.
### :returns: 2^`x`, correctly rounded.
secret routine cm_b64_exp2_accurate(x: B64) -> B64
    local sx: B64 = B64.mul_unchecked(4096.0, x)
    local fx: B64 = sx.round_ties_even()
    local z: B64 = sx -! fx
    local k: S64 = fx.to[S64]()
    local uk: U64 = k.to_wrap[U64]()
    local ie: S64 = k >> 12
    local tt: CmF64ExpDd = cm_b64_exp_table_2pow(uk)
    local p: CmF64ExpDd = cm_b64_exp2_poly_acc(z)
    local f: CmF64ExpDd = cm_b64_exp2_mulddd(xh: z, ch: p.hi, cl: p.lo)

    ux: U64 = x.bits()
    # x >= -1022
    if ux <= 0xC08FF00000000000
        above: Bool = B64.le(-0x1.71547652b82fep-54, x)
        below: Bool = x <= 0x1.71547652b82fdp-53
        if above and below
            return x.mul_add_unchecked(a: 0.5, b: 1.0)
        whole: Bool = uk & 0xFFF == 0  # 4096 x rounds to 4096 times an integer
        values2: (B64, B64) = when
            whole =>
                # 2^(k/2^12) is exactly 1: add it in without a product
                s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: tt.hi, y: f.hi)
                s2: CmF64ExpDd = cm_b64_exp_fasttwosum(x: s.lo, y: f.lo)
                ul: U64 = s2.hi.bits()
                pow2: Bool = ul & 0x000FFFFFFFFFFFFF == 0
                ebits: U64 = (ul >> 52) & 0x7FF
                nonzero: Bool = ebits != 0
                if pow2 and nonzero
                    # the low part is a nonzero power of 2: nudge it one ulp toward the sign of the tail
                    same: Bool = ul >> 63 == s2.lo.bits() >> 63
                    u: U64 = when
                        same => ul +% 1
                        else => ul -% 1
                    becomes (s.hi, B64.from_bits(u))
                else
                    becomes (s.hi, s2.hi)
            else =>
                g: CmF64ExpDd = cm_b64_exp_muldd(xh: f.hi, xl: f.lo, ch: tt.hi, cl: tt.lo)
                h: CmF64ExpDd = cm_b64_exp_fastsum(xh: tt.hi, xl: tt.lo, yh: g.hi, yl: g.lo)
                becomes (h.hi, h.lo)
        fh, fl = values2
        s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: fh, y: fl)
        lo_bits: U64 = s.lo.bits()
        d: U64 = lo_bits +% 2 & 0x000FFFFFFFFFFFFF
        if d <= 2
            return cm_b64_exp_ldexp(x: cm_b64_exp2_database(x, f: s.hi), e: ie)
        return cm_b64_exp_ldexp(x: s.hi, e: ie)
    bias_e: U64 = S64.sub(1, ie).to_wrap[U64]()
    bias: B64 = B64.from_bits(bias_e << 52)
    g: CmF64ExpDd = cm_b64_exp_muldd(xh: f.hi, xl: f.lo, ch: tt.hi, cl: tt.lo)
    h: CmF64ExpDd = cm_b64_exp_fastsum(xh: tt.hi, xl: tt.lo, yh: g.hi, yl: g.lo)
    s: CmF64ExpDd = cm_b64_exp_fasttwosum(x: bias, y: h.hi)
    fl: B64 = h.lo +! s.lo
    res: B64 = s.hi +! fl
    return B64.from_bits(res.bits() & 0x000FFFFFFFFFFFFF)

### The degree-6 double-double polynomial (constant term 0) of the accurate
### path, divided by z, at z: Horner's rule on CM_B64_EXP2_ACC_CD.
### :param z: The reduced argument, 4096 x minus its nearest integer (|z| <= 1/2).
### :returns: The polynomial value as a double-double.
secret routine cm_b64_exp2_poly_acc(z: B64) -> CmF64ExpDd
    local ch: @B64 <- .hollow()
    local cl: @B64 <- .hollow()

    B64.from_bits(CM_B64_EXP2_ACC_CD.getitem(10)).poke_into(ch)
    B64.from_bits(CM_B64_EXP2_ACC_CD.getitem(11)).poke_into(cl)

    while i != 0 with i: U64 = 5
        i2: U64 = i - 1
        r: CmF64ExpDd = cm_b64_exp2_mulddd(xh: z, ch: ch.peek(), cl: cl.peek())
        c0: B64 = B64.from_bits(CM_B64_EXP2_ACC_CD.getitem(i2 * 2))
        c1: B64 = B64.from_bits(CM_B64_EXP2_ACC_CD.getitem(i2 * 2 + 1))
        sh: B64 = r.hi +! c0
        sl: B64 = c0 -! sh +! r.hi
        next_cl: B64 = r.lo +! (sl +! c1)
        next_ch: B64 = sh
        next_ch.poke_into(ch)
        next_cl.poke_into(cl)
        continue with i: i2
    then
        return CmF64ExpDd(hi: ch.peek(), lo: cl.peek())

### Double-double times double (ch + cl) xh.
### :param xh: The double factor.
### :param ch: The high part of the double-double factor.
### :param cl: The low part of the double-double factor.
### :returns: The product as a double-double, not renormalized.
secret routine cm_b64_exp2_mulddd(xh: B64, ch: B64, cl: B64) -> CmF64ExpDd
    ahhh: B64 = ch *! xh
    lo: B64 = cl *! xh +! b64_mul_error(x: ch, y: xh, p: ahhh)
    return CmF64ExpDd(hi: ahhh, lo: lo)

### Looks x up among the arguments whose 2^x lies too close to a rounding
### boundary for the accurate path, and returns the correctly rounded
### (unscaled) result for them, or f unchanged otherwise.
### :param x: The argument.
### :param f: The unscaled result of the accurate path, returned when `x` is not in the table.
### :returns: The correctly rounded unscaled result for a listed `x`, else `f`.
secret routine cm_b64_exp2_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 42
        m: S64 = a + b >> 1
        cm: U64 = CM_B64_EXP2_DB.getitem(m.to[U64]())
        ux: U64 = x.bits()
        below: Bool = cm < ux
        when
            below => continue with a: m + 1, b: b
            cm == ux =>
                um: U64 = m.to_wrap[U64]()
                sign_bit: U64 = U64.arith_shift_right(8677191773140, um) << 63
                dr: B64 = B64.from_bits(sign_bit | 0x3C90000000000000)
                upper: Bool = um >> 5 == 1
                s2: U64 = when
                    upper => 0x34C797
                    else => 0x3B216FBD5FD7665F
                t: U64 = (s2 >> ((um << 1) & 63)) & 3
                return cm_b64_exp_pick(f, t, dr)
            else => continue with a: a, b: m - 1
    then
        return f
