// Tessera stdlib: the correctly rounded arc sine of B64
//
// For |x| <= 1/2 a piecewise polynomial in x^2 (33 pieces of width 1/128).
// Above, asin(x) = sign(x) pi/2 - 2 asin(sqrt((1 - |x|)/2)) with the same
// polynomial. The fast path carries an error bound. When it can't decide the
// rounding, the accurate path rotates the angle by a multiple of pi/64 and
// evaluates the small remainder in double-double, with a table of the inputs
// too close to a rounding boundary. Round to nearest only: |x| > 1 gives the
// x86 default NaN, NaN comes back quiet. Tables and helpers in
// InvtrigShared.tess.
//
// Ported from CORE-MATH, src/binary64/asin/asin.c via RazorForge's B64Asin.rf.
// Copyright (c) 2022-2026 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// The inputs |x| whose arc sine is too close to a rounding boundary, as B64 bits.
preset CM_B64_ASIN_DB_X: @Array[U64, 29] <- [0x3E57137449123EF6, 0x3E5D12ED0AF1A27E,
    0x3E851C4B960778F5, 0x3E93CFC2A006A414, 0x3E9CBAA95DADB559, 0x3EBACD69F89AD8F1,
    0x3EF2BFFFFFFC233B, 0x3EFFF0F3022B2E9D, 0x3F13217783D70D1D, 0x3F1C373FF4AAD79B,
    0x3F6B3F28593CAD2F, 0x3F8E17B3F6BB5E6E, 0x3F941D60A76A82ED, 0x3F9921C0A0486537,
    0x3F99C360A8DD681A, 0x3F9D6315F7EE7E01, 0x3F9EA6FDC56FC61A, 0x3FA2749DC4D19C6D,
    0x3FA69768DC89BB00, 0x3FAA4816B2066707, 0x3FAD77B117F230D6, 0x3FAFC7A07B2549AA,
    0x3FB2DF0542154F1B, 0x3FB51CF5DB1B1956, 0x3FCD0EF799001BA9, 0x3FD4A8E1A96E38E3,
    0x3FDCEEE68154D1C9, 0x3FDDA4E0E6C717A5, 0x3FDE9950730C4696]

/// The high parts of their arc sines, as B64 bits.
preset CM_B64_ASIN_DB_H: @Array[U64, 29] <- [0x3E57137449123EF7, 0x3E5D12ED0AF1A27F,
    0x3E851C4B9607790D, 0x3E93CFC2A006A465, 0x3E9CBAA95DADB650, 0x3EBACD69F89AE57A,
    0x3EF2C00000006DDD, 0x3EFFF0F3024065E7, 0x3F132177841FFBEF, 0x3F1C373FF594D65B,
    0x3F6B3F2BA40DBC66, 0x3F8E17FAEFAC7797, 0x3F941DB571D96126, 0x3F99226605233224,
    0x3F99C412D62C1440, 0x3F9D641E6D5E769A, 0x3F9EA829E3E988E5, 0x3FA275A3D78C01EC,
    0x3FA69949B3D51FB1, 0x3FAA4B0BFB0454D5, 0x3FAD7BDCD778049F, 0x3FAFCCDC252CAD1F,
    0x3FB2E36813A98740, 0x3FB5231B416BA885, 0x3FCD5064E6FE82C5, 0x3FD50954B7BBF87B,
    0x3FDE05B0E0A809BC, 0x3FDED25C5EB8C916, 0x3FDFE767739D0F6D]

/// The low parts of their arc sines, as B64 bits.
preset CM_B64_ASIN_DB_L: @Array[U64, 29] <- [0xBAFFFFFFFFFFFFFF, 0xB7963676AA7969AA,
    0x3B2FFFFFFFFFFFFF, 0xB7C1E68BC303367C, 0x37F742593EF4C3D3, 0x381B0DDFE3E29B3C,
    0xB851C26F2054C230, 0xBB9FFFFFFFFFFFFE, 0xBBBFFFFFFFFFFFFF, 0xBBBFFFFFFFFFFFFF,
    0xB8B27CA20C684481, 0xB8F15A1C95184D1B, 0xB8DDF34BCDACF353, 0xB9338E672F1696D5,
    0x3911EDD261167BAF, 0xB92AF7DEC023F5B9, 0xB92F358E90326F9A, 0x39149AB71C17BD11,
    0xB8E14B91318650E8, 0x3C4FFFFFFFFFFFFF, 0x38DAAFC31A59E093, 0xB92DC02FDAC5159A,
    0xB9363ABAA885A4DA, 0xB93E1E3F45D0BEC3, 0xB9284B9ECB11E241, 0xB93B9F88CFB1EF42,
    0x394117D6AECD2594, 0xB9289E120E5744A5, 0x38716376667A73F3]

/// arcsin(`me`), correctly rounded.
/// :returns: The arc sine of `me`, in radians.
routine B64.asin(me: Me) -> Me
    local xu: U64 = me.bits()
    local ax: U64 = xu << 1

    // |x| > 1/2
    if ax > 0x7FC0000000000000
        jump large()
    else
        jump small()

    block large()
        neg: Bool = xu >> 63 != 0
        f0h: Me = when
            neg => -1.5707963267948966
            else => 1.5707963267948966
        f0l: Me = when
            neg => -6.123233995736766e-17
            else => 6.123233995736766e-17
        // |x| >= 1
        if ax >= 0x7FE0000000000000
            jump edge(f0h, f0l)
        // asin(x) = pi/2 - 2 asin(sqrt((1 - x)/2)), and for x < -1/2 -pi/2 + 2 asin(sqrt((1 - |x|)/2))
        t: Me = Me.sub(2.0, Me.mul(2.0, me.abs()))
        jd: Me = (t * 32.0).round_ties_even()
        z: Me = t.sqrt().copysign(-me)
        zl: Me = z.mul_add(a: z, b: -t) * (Me.div(-0.5, t) * z)
        tr: Me = Me.mul(0.25, t) - jd * 0.0078125
        ztr: Me = (z * tr).abs()
        jump poly(z, zl, tr, jd, f0h, f0l, ztr * 3.5475095083725705e-16)

    // |x| = 1, |x| > 1 or NaN
    block edge(f0h: Me, f0l: Me)
        one: Bool = ax == 0x7FE0000000000000
        when
            one => return f0h + f0l
            ax > 0xFFE0000000000000 => return me + me
            else => return Me.from_bits(0xFFF8000000000000)

    // |x| <= 1/2: below 0x1.7137449123ef6p-26, |asin(x) - x| is under half an ulp of asin(x)
    block small()
        if ax < 0x7CAE26E892247DEC
            return Me.mul_add(2.7755575615628914e-17, a: me, b: me)
        t2: Me = me * me
        jd: Me = (t2 * 128.0).round_ties_even()
        t: Me = me.mul_add(a: me, b: Me.mul(-0.0078125, jd))
        xt: Me = (me * t).abs()
        jump poly(me, 0.0, t, jd, 0.0, 0.0, xt * 3.2526065174565133e-16)

    // asin(z + zl) from the piece j = round(128 z^2), t = z^2 - j/128, plus f0h + f0l
    block poly(z: Me, zl: Me, t: Me, jd: Me, f0h: Me, f0l: Me, eps: Me)
        j: USize = jd.to[U64]().to[USize]()
        j8: USize = j * 8
        zdd: CmF64InvtrigDD = (hi: z, lo: zl)
        f0: CmF64InvtrigDD = (hi: f0h, lo: f0l)
        f: CmF64InvtrigDD = cm_b64_invtrig_asin_poly(z: zdd, t, j8, f0)
        lb: Me = f.hi + (f.lo - eps)
        ub: Me = f.hi + (f.lo + eps)
        if lb == ub
            return lb
        else
            return cm_b64_asin_accurate(x: me, phi: lb)

/// The accurate path, for the inputs the fast path can't round: with |x| = sin(phi),
/// rotates the angle by j pi/64 close to phi and evaluates the arc sine of the small
/// remainder in double-double. phi is the fast-path approximation of asin(x).
/// :param x: The argument.
/// :param phi: The fast-path approximation of asin(`x`).
/// :returns: asin(`x`), correctly rounded.
routine cm_b64_asin_accurate(x: B64, phi: B64) -> B64
    // jf = round(|phi| 64/pi), 0 <= jf <= 32
    abs_phi: B64 = phi.abs()
    jfd: B64 = (abs_phi * 20.371832715762604).round_ties_even()
    r: CmF64InvtrigDD = cm_b64_invtrig_rotate(x, jf: jfd.to[U64]().to[USize]())
    sgn: B64 = B64.copysign(1.0, x)
    jt: B64 = jfd * sgn
    // -32 <= jt <= 32
    sq: CmF64InvtrigDD = cm_b64_invtrig_muldd(xh: r.hi, xl: r.lo, ch: r.hi, cl: r.lo)
    f: CmF64InvtrigDD = cm_b64_invtrig_asin_dd(v: r.hi * sgn, dv: r.lo * sgn, v2: sq.hi, dv2: sq.lo)
    // jt pi/64 in three parts. Since |jt| <= 32, ph and pl are exact
    ph0: B64 = jt * 0.04908738521234035
    pl0: B64 = B64.mul(1.684469643174416e-16, jt)
    ps0: B64 = B64.mul(-3.917809439666406e-31, jt)
    q1: CmF64InvtrigDD = cm_b64_invtrig_fastsum(xh: f.hi, xl: f.lo, yh: pl0, yl: ps0)
    q2: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: ph0, y: q1.hi)
    q3: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: q2.lo, y: q1.lo)
    q4: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: q2.hi, y: q3.hi)
    q5: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: q4.lo, y: q3.lo)
    ph: B64 = q4.hi
    pl: B64 = q5.hi
    th: U64 = ph.bits()
    tl: U64 = pl.bits() & 0x7FFFFFFFFFFFFFFF
    tn: U64 = (th & 0x7FF0000000000000) -% 0x0350000000000000
    dn: S64 = (tl -% tn).to_wrap[S64]()
    de: U64 = tn -% tl >> 52
    res: B64 = ph + pl
    if dn.between(lo: -2, hi: 0) | (de > 47)
        // the inputs whose arc sine is too close to a rounding boundary
        ax: B64 = x.abs()
        each k in 0 til 29
            if B64.from_bits(CM_B64_ASIN_DB_X.getitem(k)) == ax
                rh: B64 = B64.from_bits(CM_B64_ASIN_DB_H.getitem(k))
                rl: B64 = B64.from_bits(CM_B64_ASIN_DB_L.getitem(k))
                if x > 0.0
                    return rh + rl
                else
                    return -rh - rl
            else
                continue
        then
            return res
    else
        return res
