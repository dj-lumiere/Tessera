# Tessera stdlib: the correctly rounded power x^y of B64
#
# x^y = exp(y log(x)) in three phases. A double-double evaluation with a
# rounding test settles almost every input. The rest go to a 128-bit
# evaluation (CmF64PowDint, PowDint.tess) with its own rounding test, then an
# exact/midpoint detector (x^y exactly representable, or exactly halfway
# between two B64), and finally a 256-bit evaluation (CmF64PowQint,
# PowQint.tess) for the hardest cases. Round to nearest only, with the IEEE
# 754 pow special cases: overflow gives ±inf, a negative base with a
# non-integer exponent gives NaN, x^±0 = 1 and 1^y = 1 for a quiet NaN too,
# and a NaN comes back quiet.
#
# Ported from CORE-MATH, src/binary64/pow/pow.c (with pow.h, dint.h and
# qint.h) via RazorForge's B64Pow.rf. Where x is a power of two and y is so
# large that the integer exponent g = y log2(x) does not fit in S64 (only
# reachable for |y| >= 2^1014 when the 128-bit rounding test fails), the C
# conversion is undefined. Here g is clamped to ±2000, which still gives the
# overflowed or underflowed result.
# Copyright (c) 2022-2025 CERN and Inria
# Authors: Tom Hubrecht and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### A double-double value hi + lo.
record CmF64PowDd
    hi: B64
    lo: B64

### The phase-1 logarithm: h + l approximates log(x), and cancel tells whether
### the looser error bound for 1/sqrt(2) < x < sqrt(2) applies.
record CmF64PowLog1
    h: B64
    l: B64
    cancel: Bool

### me^exponent, correctly rounded (to nearest, ties to even), with the IEEE 754 pow special cases: overflow gives
### ±inf, a negative base with a non-integer exponent gives NaN, x^±0 = 1 and 1^y = 1 even for a quiet NaN, and a
### NaN comes back quiet.
### :param exponent: The power to raise `me` to.
### :returns: `me` raised to `exponent`.
routine B64.powf(me: Me, exponent: Me) -> Me
    local xu: U64 = me.bits()
    local yu: U64 = exponent.bits()

    # x or y is NaN or infinite, or x has its sign bit set
    if xu >= 0x7FF0000000000000 or yu >= 0x7FF0000000000000
        nan_x: Bool = me.is_nan()
        nan_y: Bool = exponent.is_nan()
        inf_x: Bool = xu == 0x7FF0000000000000
        ninf_x: Bool = xu == 0xFFF0000000000000
        inf_y: Bool = yu == 0x7FF0000000000000
        when
            nan_x =>
                # NaN^±0 = 1 for a quiet NaN, and x + x quiets a signaling one
                if exponent == 0.0 and xu & 0x0008000000000000 != 0
                    return 1.0
                else
                    return me + me
            nan_y =>
                # 1^NaN = 1 for a quiet NaN
                if me == 1.0 and yu & 0x0008000000000000 != 0
                    return 1.0
                else
                    return exponent + exponent
            inf_x =>
                zero_y: Bool = exponent == 0.0
                when
                    zero_y => return 1.0
                    exponent < 0.0 => return 0.0
                    else => return Me.INFINITY
            ninf_x =>
                # x = -inf. A y of ±0 goes on to the finite code, which returns 1
                ninf_y: Bool = yu == 0xFFF0000000000000
                odd: Bool = cm_b64_pow_is_odd(exponent)
                neg_y: Bool = exponent < 0.0
                pos_y: Bool = exponent > 0.0
                signed: Me = when
                    neg_y => Me.from_bits(0x8000000000000000)
                    else => Me.NEG_INFINITY
                when
                    inf_y => return exponent
                    ninf_y => return 0.0
                    odd => return signed
                    neg_y => return 0.0
                    pos_y => return Me.INFINITY
                    else => pass
            inf_y =>
                # y = +inf, x finite
                zero_x: Bool = me == 0.0
                unit_x: Bool = me.abs() == 1.0
                when
                    zero_x => return 0.0
                    unit_x => return 1.0
                    me.abs() < 1.0 => return 0.0
                    else => return Me.INFINITY
            yu == 0xFFF0000000000000 =>
                # y = -inf, x finite
                zero_x: Bool = me == 0.0
                unit_x: Bool = me.abs() == 1.0
                when
                    zero_x => return Me.INFINITY
                    unit_x => return 1.0
                    me.abs() < 1.0 => return Me.INFINITY
                    else => return 0.0
            else => pass

    # from here on x and y are finite: the base ax = |x| and the sign s of the result
    values: (Me, Me) = when
        me <= 0.0 =>
            zero_y: Bool = exponent == 0.0
            pzero_x: Bool = xu == 0
            nzero_x: Bool = xu == 0x8000000000000000
            when
                zero_y => return 1.0
                pzero_x or nzero_x =>
                    # x = ±0: an odd y keeps the sign of the zero (±inf for y < 0, ±0 for y > 0).
                    # Otherwise +inf or +0
                    odd: Bool = cm_b64_pow_is_odd(exponent)
                    neg_y: Bool = exponent < 0.0
                    pos_y: Bool = exponent > 0.0
                    r: Me = when
                        neg_y and pzero_x => Me.INFINITY
                        neg_y => Me.NEG_INFINITY
                        pzero_x => 0.0
                        else => Me.from_bits(0x8000000000000000)
                    when
                        odd => return r
                        pos_y => return 0.0
                        else => return Me.INFINITY
                ~cm_b64_pow_is_int(exponent) => return Me.NAN
                else => pass
            # x < 0 and y an integer: the result is negative when y is odd
            sign: Me = when
                exponent.abs() < 0x1p53 =>
                    int_exponent: S64 = exponent.to[S64]()
                    odd: Bool = int_exponent & 1 != 0
                    becomes when
                        odd => -1.0
                        else => 1.0
                else => 1.0
            becomes (-me, sign)
        else => (me, 1.0)
    ax, s = values

    # double-double s exp(y log(ax)). A tiny or huge y skips to the next phase, to avoid a
    # spurious underflow or overflow in y log(x)
    lg: CmF64PowLog1 = cm_b64_pow_log_1(ax)
    ey: U64 = (yu >> 52) & 0x7FF
    extreme: Bool = ey < 0x36 or ey >= 0x7F5
    lh: Me = when
        extreme => Me.NAN
        else => lg.h
    ll: Me = when
        extreme => Me.NAN
        else => lg.l
    rh: Me = exponent * lh
    rs: Me = b64_mul_error(x: exponent, y: lh, p: rh)
    rl: Me = exponent.mul_add(a: ll, b: rs)
    e: CmF64PowDd = cm_b64_pow_exp_1(rh, rl, s)
    err: Me = when
        lg.cancel => 0x1.57p-58
        else => 0x1.27p-64
    res_min: Me = e.hi + err.mul_add(a: -e.hi, b: e.lo)
    res_max: Me = e.hi + err.mul_add(a: e.hi, b: e.lo)
    settled: Bool = res_min == res_max
    one: Bool = exponent == 1.0
    two: Bool = exponent == 2.0
    half: Bool = exponent == 0.5
    when
        settled => return res_max
        one => return s * ax
        two => return ax * ax
        half => return ax.sqrt()
        exponent == 0.0 => return 1.0
        else => return cm_b64_pow_accurate(x0: me, x: ax, y: exponent, s)

### True when x (finite) is an integer.
### :param x: The finite value to test.
### :returns: True when `x` is an integer.
private routine cm_b64_pow_is_int(x: B64) -> Bool
    return x == x.round_ties_even()

### True when y (finite) is an odd integer.
### :param y: The finite value to test.
### :returns: True when `y` is an odd integer.
private routine cm_b64_pow_is_odd(y: B64) -> Bool
    whole: Bool = cm_b64_pow_is_int(y)
    even: Bool = cm_b64_pow_is_int(y * 0.5)
    return whole and not even

### a + b as a double-double, assuming |a| >= |b|.
### :param a: The larger addend.
### :param b: The smaller addend.
### :returns: The rounded sum and its exact error.
private routine cm_b64_pow_fast_two_sum(a: B64, b: B64) -> CmF64PowDd
    hi: B64 = a + b
    e: B64 = hi - a
    return CmF64PowDd(hi: hi, lo: b - e)

### a + (bh + bl) as a double-double, assuming |a| >= |bh|.
### :param a: The larger addend.
### :param bh: The high part of the smaller addend.
### :param bl: The low part of the smaller addend.
### :returns: The sum as a double-double.
private routine cm_b64_pow_fast_sum(a: B64, bh: B64, bl: B64) -> CmF64PowDd
    t: CmF64PowDd = cm_b64_pow_fast_two_sum(a, b: bh)
    return CmF64PowDd(hi: t.hi, lo: t.lo + bl)

### (ah + al) (bh + bl), ignoring al bl.
### :param ah: The high part of the first factor.
### :param al: The low part of the first factor.
### :param bh: The high part of the second factor.
### :param bl: The low part of the second factor.
### :returns: The product as a double-double.
private routine cm_b64_pow_d_mul(ah: B64, al: B64, bh: B64, bl: B64) -> CmF64PowDd
    hi: B64 = ah * bh
    s: B64 = b64_mul_error(x: ah, y: bh, p: hi)
    t: B64 = al.mul_add(a: bh, b: s)
    return CmF64PowDd(hi: hi, lo: ah.mul_add(a: bl, b: t))

### Entry i of the phase-1 log polynomial (CM_B64_POW_P1).
### :param i: The coefficient index, 0..5.
### :returns: The coefficient as a B64.
private routine cm_b64_pow_p1(i: USize) -> B64
    return B64.from_bits(CM_B64_POW_P1.getitem(i))

### log(1+z) - z for |z| <= 33 2^-13, z an integer multiple of 2^-61, as (ph, pl).
### :param z: The reduced argument.
### :returns: log(1 + `z`) - `z` as a double-double.
private routine cm_b64_pow_p_1(z: B64) -> CmF64PowDd
    wh: B64 = z * z
    wl: B64 = b64_mul_error(x: z, y: z, p: wh)
    t: B64 = cm_b64_pow_p1(5).mul_add(a: z, b: cm_b64_pow_p1(4))
    u0: B64 = cm_b64_pow_p1(3).mul_add(a: z, b: cm_b64_pow_p1(2))
    v0: B64 = cm_b64_pow_p1(1).mul_add(a: z, b: cm_b64_pow_p1(0))
    u1: B64 = t.mul_add(a: wh, b: u0)
    v1: B64 = u1.mul_add(a: wh, b: v0)
    u: B64 = v1 * wh
    return CmF64PowDd(hi: wh * -0.5, lo: u.mul_add(a: z, b: wl * -0.5))

### Entry i of the phase-1 exp polynomial.
### :param i: The coefficient index, 0..4.
### :returns: The coefficient as a B64.
private routine cm_b64_pow_q1(i: USize) -> B64
    return B64.from_bits(CM_B64_POW_Q1.getitem(i))

### exp(z) for |z| < 2^-12.905, as (qh, ql).
### :param z: The reduced argument.
### :returns: exp(`z`) as a double-double.
private routine cm_b64_pow_q_1(z: B64) -> CmF64PowDd
    q0: B64 = cm_b64_pow_q1(4).mul_add(a: z, b: cm_b64_pow_q1(3))
    q: B64 = q0.mul_add(a: z, b: cm_b64_pow_q1(2))
    h0: B64 = q.mul_add(a: z, b: cm_b64_pow_q1(1))
    h1: B64 = z * h0
    l1: B64 = b64_mul_error(x: z, y: h0, p: h1)
    return cm_b64_pow_fast_sum(a: cm_b64_pow_q1(0), bh: h1, bl: l1)

### log(x) as h + l, for 2^-1074 <= x <= B64 MAX, with the cancellation flag.
### :param x: The positive finite argument.
### :returns: log(`x`) as a double-double, with the cancellation flag.
private routine cm_b64_pow_log_1(x: B64) -> CmF64PowLog1
    local xu: U64 = x.bits()
    local m: U64 = xu & 0x000FFFFFFFFFFFFF

    exp_field: U64 = (xu >> 52) & 0x7FF
    e: S64 = exp_field.to[S64]()
    normal: Bool = e != 0
    values2: (U64, S64, U64) = when
        normal => (m + 0x0010000000000000, e - 0x3FF, m | 0x3FF0000000000000)
        else =>
            k: U64 = m.leading_zeros() - 11
            mk: U64 = m << k
            becomes (mk, S64.sub(-1022, k.to[S64]()), mk | 0x3FF0000000000000)
    m_norm, e0, tu = values2

    # x = 2^e t with 1 <= t < 2 and 2^52 <= m_norm < 2^53. Above sqrt(2), halve t so that
    # 1/sqrt(2) < t < sqrt(2)
    t0: B64 = B64.from_bits(tu)
    big: Bool = m_norm >= 0x16A09E667F3BCD
    e2: S64 = when
        big => e0 + 1
        else => e0
    i: U64 = when
        big => m_norm >> 45
        else => m_norm >> 44
    t: B64 = when
        big => t0 * 0.5
        else => t0
    big_e: B64 = e2.to[B64]()
    j: USize = (i - 181).to[USize]()
    r: B64 = B64.from_bits(CM_B64_POW_INVERSE.getitem(j))
    l1: B64 = B64.from_bits(CM_B64_POW_LOG_INV.getitem(j * 2))
    l2: B64 = B64.from_bits(CM_B64_POW_LOG_INV.getitem(j * 2 + 1))
    z: B64 = r.mul_add(a: t, b: -1.0)
    th: B64 = big_e.mul_add(a: 0x1.62e42fefa38p-1, b: l1)
    tl: B64 = big_e.mul_add(a: 0x1.ef35793c7673p-45, b: l2)
    hl: CmF64PowDd = cm_b64_pow_fast_sum(a: th, bh: z, bl: tl)
    p: CmF64PowDd = cm_b64_pow_p_1(z)
    s: CmF64PowDd = cm_b64_pow_fast_sum(a: hl.hi, bh: p.hi, bl: hl.lo + p.lo)
    cancel: Bool = e2 == 0 and s.lo.abs() > s.hi.abs() * 0x1p-24
    plain: CmF64PowLog1 = CmF64PowLog1(h: s.hi, l: s.lo, cancel: false)
    if cancel
        n: CmF64PowDd = cm_b64_pow_fast_two_sum(a: s.hi, b: s.lo)
        return CmF64PowLog1(h: n.hi, l: n.lo, cancel: true)
    else
        return plain

### s exp(rh + rl) as a double-double. NaN when the result may underflow or overflow (left to the next phase).
### :param rh: The high part of the exponent.
### :param rl: The low part of the exponent.
### :param s: The sign of the result, 1 or -1.
### :returns: The double-double result, or NaN parts when the next phase must decide.
private routine cm_b64_pow_exp_1(rh: B64, rl: B64, s: B64) -> CmF64PowDd
    high: Bool = rh.is_nan() or rh > 0x1.62e42e709a95bp+9
    when
        high =>
            if rh > 0x1.62e4316ea5df9p+9
                # sure overflow
                big: B64 = B64.mul(0x1.fffffffffffffp+1023, s)
                return CmF64PowDd(hi: big, lo: big)
            else
                return CmF64PowDd(hi: B64.NAN, lo: B64.NAN)
        rh < -0x1.483b8cca421afp+9 =>
            if rh < -0x1.74910ee4e8a27p+9
                # sure underflow
                lo: B64 = B64.from_bits(1) * B64.mul(0.5, s)
                return CmF64PowDd(hi: B64.mul(0.0, s), lo: lo)
            else
                return CmF64PowDd(hi: B64.NAN, lo: B64.NAN)
        else =>
            # rh = k log(2)/2^12 + z, and 2^(k/2^12) = 2^(k >> 12) T2[k mod 64] T1[(k >> 6) mod 64]
            k: B64 = (rh * 0x1.71547652b82fep+12).round_ties_even()
            zh: B64 = B64.mul_add(0x1.62e42fefa39efp-13, a: -k, b: rh)
            zl: B64 = B64.mul_add(0x1.abc9e3b39803fp-68, a: -k, b: rl)
            big_k: S64 = k.to[S64]()
            big_m: S64 = (big_k >> 12) + 0x3FF
            k_high: U64 = (big_k >> 6).to_wrap[U64]()
            slot2: U64 = k_high & 0x3F
            i2: USize = slot2.to[USize]() * 2
            slot1: U64 = big_k.to_wrap[U64]() & 0x3F
            i1: USize = slot1.to[USize]() * 2
            t2h: B64 = B64.from_bits(CM_B64_POW_T2.getitem(i1))
            t2l: B64 = B64.from_bits(CM_B64_POW_T2.getitem(i1 + 1))
            t1h: B64 = B64.from_bits(CM_B64_POW_T1.getitem(i2))
            t1l: B64 = B64.from_bits(CM_B64_POW_T1.getitem(i2 + 1))
            e0: CmF64PowDd = cm_b64_pow_d_mul(ah: t2h, al: t2l, bh: t1h, bl: t1l)
            q: CmF64PowDd = cm_b64_pow_q_1(zh + zl)
            e: CmF64PowDd = cm_b64_pow_d_mul(ah: e0.hi, al: e0.lo, bh: q.hi, bl: q.lo)
            d: B64 = B64.from_bits(big_m.to_wrap[U64]() << 52) * s
            return CmF64PowDd(hi: e.hi * d, lo: e.lo * d)

### Phases 2 and 3 of pow, for inputs phase 1 could not round: x0 is the original base, x = |x0| (finite, nonzero),
### y finite and nonzero, s the sign of the result (1 or -1).
### :param x0: The original base.
### :param x: |x0|.
### :param y: The exponent.
### :param s: The sign of the result, 1 or -1.
### :returns: x0^y, correctly rounded.
private routine cm_b64_pow_accurate(x0: B64, x: B64, y: B64, s: B64) -> B64
    local sgn: U64 = when

        s == -1.0 => 1
        else => 0
    local dx: CmF64PowDint = x.to[CmF64PowDint]()
    local dy: CmF64PowDint = y.to[CmF64PowDint]()
    local lx: CmF64PowDint = cm_b64_pow_log_2(dx)
    local ylx: CmF64PowDint = cm_b64_pow_mul_dint_21(a: lx, b: dy)
    local br: CmF64PowDint = cm_b64_pow_exp_2(ylx)

    underflow: Bool = br.ex < -1075
    rounds: Bool = when
        underflow => return B64.mul(0.5, s * B64.from_bits(1))
        br.ex < -1022 =>
            # rounding test: the significand has to be shifted right by 1 <= sh <= 53 bits
            sh: U64 = S64.sub(0, br.ex + 1022).to_wrap[U64]()
            lo_shifted: U64 = cm_b64_pow_lo(br.r) >> sh + 10
            m: U64 = lo_shifted | (cm_b64_pow_hi(br.r) << U64.sub(54, sh))
            becomes m +% 14 > 28
        else =>
            # rounding test on the 64 bits after the round bit
            lo_tail: U64 = cm_b64_pow_lo(br.r) >> 10
            lo: U64 = lo_tail | (cm_b64_pow_hi(br.r) << 54)
            becomes lo +% 28 > 56
    z: CmF64PowDint = CmF64PowDint(r: br.r, ex: br.ex, sgn: sgn)
    if rounds
        return z.to[B64]()
    exact: Bool = cm_b64_pow_is_exact(x, y)
    ep: B64 = cm_b64_pow_exact_pow(x: x0, y, z, exact)
    if not ep.is_nan()
        return ep
    else
        qx: CmF64PowQint = x.to[CmF64PowQint]()
        qy: CmF64PowQint = y.to[CmF64PowQint]()
        qlx: CmF64PowQint = cm_b64_pow_log_3(qx)
        qr: CmF64PowQint = cm_b64_pow_mul_qint_41(a: qlx, b: qy)
        qz: CmF64PowQint = cm_b64_pow_exp_3(qr)
        hh: U64 = cm_b64_pow_hi(qz.rh)
        hl: U64 = cm_b64_pow_lo(qz.rh)
        lh: U64 = cm_b64_pow_hi(qz.rl)
        ll: U64 = cm_b64_pow_lo(qz.rl)
        r1: U64 = (hh << 54) | (hl >> 10)
        r2: U64 = (hl << 54) | (lh >> 10)
        r3: U64 = (lh << 54) | (ll >> 10)
        top_zero: Bool = r1 == 0 and r2 == 0
        low: Bool = top_zero and r3 <= 60
        r1_ones: Bool = ~r1 == 0
        high: Bool = r1_ones and ~r2 == 0 and r3 +% 120 <= 60
        hard: Bool = low or high
        rl: U128 = qz.rl & 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFC00
        qs: CmF64PowQint = CmF64PowQint(rh: qz.rh, rl: rl, ex: qz.ex, sgn: sgn)
        if hard
            # x^y very close to 1: exp(qr) rounds to 1 (the sign of qr picks the side, which rounds to 1 anyway).
            # Otherwise not reachable (CORE-MATH reports an unexpected worst case there)
            near_one: Bool = qr.ex < -56
            when
                near_one and qr.sgn == 0 => return B64.add(1.0, 0x1p-100)
                near_one => return B64.sub(1.0, 0x1p-100)
                else => return qz.to[B64]()
        else
            return qs.to[B64]()

### |v| = m 2^e with m odd, for the bits u of a nonzero finite B64.
### :param u: The bits of the value.
### :returns: The odd m and the exponent e.
private routine cm_b64_pow_odd_part(u: U64) -> (U64, S64)
    m0: U64 = u & 0x000FFFFFFFFFFFFF
    exp_field: U64 = (u << 1) >> 53
    e0: S64 = exp_field.to[S64]() - 0x433
    normal: Bool = e0 >= -1074
    m1: U64 = when
        normal => m0 | 0x0010000000000000
        else => m0
    e1: S64 = when
        normal => e0
        else => e0 + 1
    t: U64 = m1.trailing_zeros()
    return (m1 >> t, e1 + t.to[S64]())

### True when x^y is exactly representable, for x > 0 finite and y finite.
### :param x: The base.
### :param y: The exponent.
### :returns: True when x^y is a B64.
private routine cm_b64_pow_is_exact(x: B64, y: B64) -> Bool
    local vu: U64 = x.bits()
    local wu: U64 = y.bits()
    local my: @U64 <- .hollow()

    unit: Bool = vu << 1 == 0x7FE0000000000000
    loose: Bool = wu << 22 != 0  # in all exact cases other than x = 1, the low 42 bits of y are zero
    when
        unit => return true
        loose => return false
        (y >= 0.0) & cm_b64_pow_is_int(y) =>
            # y >= 0 an integer, x = m 2^e with m odd
            m, e = cm_b64_pow_odd_part(vu)
            trivial: Bool = y == 0.0 or y == 1.0
            power_of_two: Bool = m == 1
            when
                trivial => return true
                power_of_two =>
                    ye: B64 = y * e.to[B64]()
                    return ye >= -1074.0 and ye < 1024.0
                y < 0.0 or y > 33.0 => return false
                else =>
                    # x^y is an odd multiple of 2^(e y)
                    y_int: S64 = y.to[S64]()
                    if m > CM_B64_POW_XMAX.getitem(y_int.to[USize]())
                        return false
                    tb: S64 = U64.sub(64, m.leading_zeros()).to[S64]()
                    ey: S64 = e * y_int
                    ez: S64 = ey + tb
                    if ez <= -1074 or ez > 1024
                        return false
                    else
                        return ey >= -1074
        else =>
            # y < 0 or y not an integer: |y| = n 2^f and |x| = m 2^e with m, n odd
            n, f = cm_b64_pow_odd_part(wu)
            m, e = cm_b64_pow_odd_part(vu)
            if y < 0.0
                # the only exact case is x = 2^e with n e 2^f an integer
                not_pow2: Bool = m != 1
                when
                    not_pow2 => return false
                    f >= 0 =>
                        small: Bool = f < 12
                        product: U64 = U64.sub_wrap(0, n) *% e.to_wrap[U64]()
                        ez: S64 = (product << f.to_wrap[U64]()).to_wrap[S64]()
                        if small
                            return ez >= -1074 and ez < 1024
                        else
                            ez2: S64 = 1024
                            return ez2 >= -1074 and ez2 < 1024
                    else =>
                        te: U64 = e.to_wrap[U64]().trailing_zeros()
                        nf: S64 = S64.sub(0, f)
                        if nf.to_wrap[U64]() > te
                            return false
                        quotient: S64 = S64.sub(0, e) >> nf
                        ez_bits: U64 = quotient.to_wrap[U64]() *% n

                        ez: S64 = ez_bits.to_wrap[S64]()
                        return ez >= -1074 and ez < 1024
            else
                # y > 0 is not an integer: f < 0, so x must be a (2^-f)th power
                each f2 in f til 0 with m2: U64 = m, e2: S64 = e
                    if e2 & 1 != 0
                        return false
                    dm: B64 = m2.to[B64]()
                    sq: B64 = dm.sqrt().round()
                    if sq * sq == dm
                        continue with m2: sq.to[U64](), e2: e2 >> 1
                    else
                        return false
                then
                    # now |x^y| = (m 2^e)^n with m and n odd
                    wide_m: Bool = m2 > 1
                    many: Bool = wide_m and n > 33
                    when
                        many => return false
                        wide_m and m2 > CM_B64_POW_XMAX.getitem(n.min(33).to[USize]()) => return false
                        else => pass
                    m2.poke_into(my)

                    m3: U64 = m2

                    e3: S64 = e2

                    while left > 1 with left: U64 = n
                        (my.peek() *% m3).poke_into(my)
                        continue with left: left - 1
                    then
                        tb: S64 = U64.sub(64, my.peek().leading_zeros()).to[S64]()
                        en: S64 = e3 * n.to[S64]()
                        return en >= -1074 and en + tb <= 1024

### x 2^e in two steps, so that the intermediate stays representable (|e| <= 2046).
### :param x: The value to scale.
### :param e: The power of two.
### :returns: x 2^e.
private routine cm_b64_pow_pow2(x: B64, e: S64) -> B64
    odd: Bool = e & 1 != 0
    r: B64 = when
        odd => x * 2.0
        else => x
    half_e: U64 = (e >> 1).to_wrap[U64]()
    biased_exponent: U64 = half_e +% 0x3FF & 0x7FF
    e2: B64 = B64.from_bits(biased_exponent << 52)
    return r * e2 * e2

### x^y exactly when it fits into 54 bits (the exact and midpoint cases, Algorithm detectRoundingBoundaryCase of
### Lauter and Lefevre), else NaN. Here z is the phase-2 approximation of |x|^y, with the sign of the result
### and a relative error below 2^-117.
### :param x: The base.
### :param y: The exponent.
### :param z: The phase-2 approximation of the result.
### :param exact: Whether x^y is known to be exactly representable, from {cm_b64_pow_is_exact}.
### :returns: x^y when it fits into 54 bits, else NaN.
private routine cm_b64_pow_exact_pow(x: B64, y: B64, z: CmF64PowDint, exact: Bool) -> B64
    local sg: S64 = when

        z.sgn != 0 => -1
        else => 1

    m, big_e = cm_b64_pow_odd_part(x.bits())
    when
        m == 1 =>
            # x is a power of 2
            g: B64 = big_e.to[B64]() * y
            if not cm_b64_pow_is_int(g)
                return B64.NAN
            r: B64 = when
                z.sgn != 0 => -1.0
                else => 1.0
            clamped: B64 = g.max(-2000.0).min(2000.0)
            gi: S64 = clamped.to[S64]()
            return cm_b64_pow_pow2(x: r, e: gi)
        y < 0.0 or y > 34.0 => return B64.NAN
        else =>
            # y = n 2^big_f with n odd
            n, big_f = cm_b64_pow_odd_part(y.bits())
            when
                n > 34 or big_f < -5 => return B64.NAN
                big_f < 0 =>
                    # -5 <= big_f < 0: big_e must be divisible by 2^-big_f. Round z to 54 bits, k 2^big_g
                    mask: U64 = U64.shr(0xFFFFFFFFFFFFFFFF, (big_f + 64).to_wrap[U64]())
                    e_bits: U64 = big_e.to_wrap[U64]()
                    if e_bits & mask != 0
                        return B64.NAN
                    root_e: U64 = (big_e >> S64.sub(0, big_f)).to_wrap[U64]()
                    g: S64 = (root_e *% n).to_wrap[S64]()
                    zh: U64 = cm_b64_pow_hi(z.r)
                    big_g: S64 = z.ex - 53
                    rounded: U64 = (zh >> 10) + ((zh >> 9) & 1)
                    k: S64 = rounded.to_wrap[S64]()
                    if not exact
                        # check that |2^big_g k - z| < 2^-116 z
                        cnt: U64 = k.to_wrap[U64]().leading_zeros()
                        r: U128 = cm_b64_pow_join(hi: k.to_wrap[U64]() << cnt, lo: 0)
                        ex: S64 = big_g + 63 - cnt.to[S64]()
                        d0: CmF64PowDint = CmF64PowDint(r: r, ex: ex, sgn: U64.sub(1, z.sgn))
                        d1: CmF64PowDint = cm_b64_pow_add_dint(a: z, b: d0)
                        d: CmF64PowDint = CmF64PowDint(r: d1.r, ex: d1.ex + 116, sgn: d1.sgn)
                        if cm_b64_pow_cmp_dint_abs(a: d, b: z) >= 0
                            return B64.NAN
                    # k must be an odd number times 2^(g - big_g)
                    if big_g > g
                        return B64.NAN
                    gg: U64 = (g - big_g).to_wrap[U64]()
                    mask2: U64 = ~U64.shl(0xFFFFFFFFFFFFFFFE, gg)
                    k_low: U64 = k.to_wrap[U64]() & mask2
                    if not (k_low == U64.shl(1, gg))
                        return B64.NAN
                    q: S64 = (k >> gg.to_wrap[S64]()) * sg
                    return cm_b64_pow_pow2(x: q.to[B64](), e: g)
                else =>
                    # y an integer, 2 <= y <= 34: k = m^y by binary powering should fit into 54 bits
                    t: U64 = n << big_f.to_wrap[U64]()

                    ey: S64 = big_e * t.to[S64]()

                    while true with t2: U64 = t, k: U64 = 1, mm: U64 = m
                        done: Bool = t2 == 0
                        k2: U64 = when
                            done =>
                                if k >> 54 != 0
                                    return B64.NAN
                                signed_k: S64 = k.to_wrap[S64]() * sg
                                r: B64 = signed_k.to[B64]()
                                return cm_b64_pow_pow2(x: r, e: ey)
                            t2 & 1 != 0 =>
                                p: U128 = mm.mul_wide(k)
                                if p > 0x7FFFFFFFFFFFFFFF
                                    return B64.NAN
                                else
                                    becomes p.to_wrap[U64]()
                            else => k
                        next: U64 = t2 >> 1
                        if next != 0
                            p2: U128 = mm.mul_wide(mm)
                            if p2 >> 64 != 0
                                return B64.NAN
                            else
                                continue with t2: next, k: k2, mm: p2.to_wrap[U64]()
                        else
                            continue with t2: next, k: k2, mm: mm
