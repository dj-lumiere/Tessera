### A crude piecewise quadratic approximation of atan that picks the table index:
### constant terms.
preset CM_B64_ATAN_C0: @Array[U64, 31] <- [419, 500, 582, 745, 908, 1234, 1559, 2210, 2860, 4156,
    5444, 7989, 10476, 15224, 19601, 27105, 33036, 41266, 46469, 52375, 55587, 58906, 60612, 62325,
    63192, 64056, 64491, 64923, 65141, 65358, 65467]

### Linear terms of the index quadratic.
preset CM_B64_ATAN_C1: @Array[U64, 31] <- [81, 81, 163, 163, 326, 326, 651, 650, 1299, 1293, 2569,
    2520, 4917, 4576, 8341, 6648, 10210, 6292, 7926, 4038, 4591, 2172, 2390, 1107, 1207, 556, 605,
    278, 303, 139, 151]

### Quadratic terms of the index quadratic (subtracted).
preset CM_B64_ATAN_C2: @Array[U64, 31] <- [0, 0, 0, 0, 0, 0, 0, 1, 3, 4, 24, 32, 168, 200, 838, 731,
    1998, 1117, 2048, 849, 1291, 479, 688, 247, 349, 124, 175, 62, 88, 31, 44]

### The inputs |x| whose arc tangent is too close to a rounding boundary, as B64 bits
### (two appear twice, as in CORE-MATH, and the first match wins).
preset CM_B64_ATAN_DB_X: @Array[U64, 12] <- [0x3F80DC89A3B55010, 0x3F7E3FB41D2D2260,
    0x3FE7BA49F739829F, 0x3FCA933FE176B375, 0x3F7BB04A79820063, 0x3F7CD30A9499618B,
    0x3F8F44AA37B8E66B, 0x3F7FD2AC95E57EF9, 0x3F96419079BBF601, 0x3FE7BA49F739829F,
    0x3FCD768804487B07, 0x3F7BB04A79820063]

### The high parts of their arc tangents, as B64 bits.
preset CM_B64_ATAN_DB_H: @Array[U64, 12] <- [0x3F80DC70AC228717, 0x3F7E3F9013A852F8,
    0x3FE46AC372243536, 0x3FCA33F32AC5CEB5, 0x3F7BB02ED5C5E956, 0x3F7CD2EB65F92A46,
    0x3F8F440B04187C87, 0x3F7FD2829FEBC03A, 0x3F9640AADE8F5427, 0x3FE46AC372243536,
    0x3FCCF5676F373EC1, 0x3F7BB02ED5C5E956]

### The low parts of their arc tangents, as B64 bits.
preset CM_B64_ATAN_DB_L: @Array[U64, 12] <- [0x3C20000000000000, 0x3C10000000000000,
    0x3920000000000000, 0xB8F0000000000000, 0xB8C0000000000000, 0xB8F0000000000000,
    0xB8F0000000000000, 0xB8F0000000000000, 0x38D0000000000000, 0x3910000000000000,
    0xB910000000000000, 0xB8C0000000000000]

### arctan(`me`), correctly rounded.
### :returns: The arc tangent of `me`, in radians.
routine B64.atan(me: Me) -> Me
    local tu: U64 = me.bits()
    local at: U64 = tu & 0x7FFFFFFFFFFFFFFF

    # |x|

    small: Bool = at < 0x3F7B21C475E6362A  # |x| < 0x1.b21c475e6362ap-8
    # |x| > 0x1.2ded8e34a9035p+7
    when
        small => jump small()
        at > 0x4062DED8E34A9035 => jump large()
        else => jump table()

    block small()
        zero: Bool = at == 0
        # |x| < 2^-27
        when
            zero => return me
            at < 0x3E40000000000000 => return Me.mul_add(-5.551115123125783e-17, a: me, b: me)
            else => jump series()

    # x + x^3 p(x^2)
    block series()
        x2: Me = me * me
        x3: Me = me * x2
        x4: Me = x2 * x2
        a01: Me = x2 * 0.199999999999994 + -0.3333333333333333
        a23: Me = x2 * 0.11110113960028833 + -0.1428571424743179
        f: Me = x3 * (a01 + x4 * a23)
        epsp: Me = f * 1.2212453270876722e-15
        epsm: Me = f * 6.106226635438361e-16
        ub: Me = f + epsp + me
        lb: Me = f - epsm + me
        if ub == lb
            return ub
        else
            return cm_b64_atan_accurate(x: me, a: ub)

    # sign(x) pi/2 + atan(-1/x). From 0x1.d02967c31cdb5p+53 on just sign(x) pi/2 rounded, or NaN
    block large()
        ah: Me = Me.copysign(1.5707963267948966, me)
        al: Me = Me.copysign(6.123233995736766e-17, me)
        nan: Bool = at > 0x7FF0000000000000
        when
            nan => return me + me
            at >= 0x434D02967C31CDB5 => return ah + al
            else => jump evaluate(Me.truediv(-1.0, me), ah, al)

    # 0x1.b21c475e6362ap-8 <= |x| <= 0x1.2ded8e34a9035p+7: reduce by tan(j pi/256), 1 <= i <= 30
    block table()
        iu: U64 = (at >> 51) - 2030
        i: USize = iu.to[USize]()
        u: U64 = tu & 0x0007FFFFFFFFFFFF
        ut: U64 = u >> 35
        ut2: U64 = ut *% ut >> 16
        c0: U64 = CM_B64_ATAN_C0.getitem(i)
        j0: U64 = (c0 << 16) +% ut *% CM_B64_ATAN_C1.getitem(i)
        ju: U64 = j0 -% ut2 *% CM_B64_ATAN_C2.getitem(i) >> 25
        j: USize = ju.to[USize]()
        sg: Me = Me.copysign(1.0, me)
        ta: Me = sg * Me.from_bits(CM_B64_ATAN_AH.getitem(j))
        id: Me = sg * j.to[U64]().to[Me]()
        al: Me = sg * Me.from_bits(CM_B64_ATAN_AL.getitem(j)) + Me.mul(4.2111741079360304e-17, id)
        h: Me = (me - ta) / (me * ta + 1.0)
        jump evaluate(h, Me.mul(0.012271846303085088, id), al)

    # ah + al + atan(h), with the fast path's error bound
    block evaluate(h: Me, ah: Me, al: Me)
        h2: Me = h * h
        h4: Me = h2 * h2
        a01: Me = h2 * -0.333333333333331 + 1.0
        a23: Me = h2 * -0.1428473928322857 + 0.1999999997326265
        fp: Me = a01 + h4 * a23
        all: Me = h.mul_add(a: fp, b: al)
        e: Me = h * 8.743006318923108e-16
        ub: Me = all + e + ah
        lb: Me = all - e + ah
        if ub == lb
            return ub
        else
            return cm_b64_atan_accurate(x: me, a: ub)

### The accurate path, for the inputs the fast path can't round: atan(x) to about 107
### bits in double-double, with 2^-27 <= |x|, and a is the fast-path approximation.
### :param x: The argument, with 2^-27 <= |`x`|.
### :param a: The fast-path approximation of atan(`x`).
### :returns: atan(`x`), correctly rounded.
routine cm_b64_atan_accurate(x: B64, a: B64) -> B64
    local abs_a: B64 = a.abs()
    local phi: B64 = abs_a * 81.48733086305042 + 256.5
    local ib: U64 = phi.bits() >> 44
    local i: USize = (ib & 0xFF).to[USize]()

    # 256.5 < phi < 384.5, so 0 <= i <= 128

    inf: Bool = i == 128
    values2: (B64, B64) = when
        inf =>
            # h = -1/x
            h: B64 = B64.truediv(-1.0, x)
            becomes (h, B64.mul_add(h, a: x, b: 1.0) * h)
        else =>
            # h = (x - ta) / (1 + x ta) with ta = tan(i pi/256)
            ta: B64 = B64.from_bits(CM_B64_ATAN_AH.getitem(i)).copysign(x)
            zta: B64 = x * ta
            ztal: B64 = b64_mul_error(x, y: ta, p: zta)
            zmta: B64 = x - ta
            v: B64 = B64.add(1.0, zta)
            d: B64 = B64.sub(1.0, v)
            ev0: B64 = d + zta - (d + v - 1.0)
            ev: B64 = ev0 + ztal
            r: B64 = B64.truediv(1.0, v)
            rem: B64 = r.mul_add(a: -v, b: 1.0) - ev * r
            rl: B64 = rem * r
            h: B64 = r * zmta
            becomes (h, b64_mul_error(x: r, y: zmta, p: h) + rl * zmta)
    h, hl = values2

    # atan(h + hl) = h + h^3 q(h^2) in double-double
    p2: CmF64InvtrigDD = cm_b64_atan_muldd(xh: h, xl: hl, ch: h, cl: hl)
    h2: B64 = p2.hi
    h2l: B64 = p2.lo
    h4: B64 = h2 * h2
    p3: CmF64InvtrigDD = cm_b64_atan_muldd(xh: h, xl: hl, ch: h2, cl: h2l)
    a01: B64 = h2 * -0.09090909090907358 + 0.1111111111111111
    a23: B64 = h2 * -0.06665779689246536 + 0.07692307637971313
    fl: B64 = h2 * (a01 + h4 * a23)
    # the double-double polynomial over ch[0..2], Horner from the top coefficient
    ch3: B64 = B64.add(-0.14285714285714285, fl)
    tl3: B64 = B64.sub(-0.14285714285714285, ch3) + fl
    cl3: B64 = tl3 + -7.930161522310759e-18
    m2: CmF64InvtrigDD = cm_b64_atan_muldd(xh: h2, xl: h2l, ch: ch3, cl: cl3)
    th2: B64 = m2.hi + 0.2
    tl2: B64 = B64.sub(0.2, th2) + m2.hi
    cl2: B64 = m2.lo + (tl2 + -1.1102230246265417e-17)
    m1: CmF64InvtrigDD = cm_b64_atan_muldd(xh: h2, xl: h2l, ch: th2, cl: cl2)
    th1: B64 = m1.hi + -0.3333333333333333
    tl1: B64 = B64.sub(-0.3333333333333333, th1) + m1.hi
    cl1: B64 = m1.lo + (tl1 + -1.850371707708594e-17)
    f: CmF64InvtrigDD = cm_b64_atan_muldd(xh: p3.hi, xl: p3.lo, ch: th1, cl: cl1)
    sg: B64 = B64.copysign(1.0, x)
    zero: Bool = i == 0
    values3: (B64, B64, B64) = when
        zero => (h, f.hi, f.lo)
        else =>
            # add i pi/256 (three parts) and atan(tan(i pi/256)) - i pi/256
            inner: Bool = i < 128
            df: B64 = when
                inner => sg * B64.from_bits(CM_B64_ATAN_AL.getitem(i))
                else => 0.0
            fi: B64 = i.to[U64]().to[B64]()
            id: B64 = fi.copysign(x)
            ah: B64 = B64.mul(0.012271846303085088, id)
            al: B64 = B64.mul(4.21117410793604e-17, id)
            at: B64 = B64.mul(-9.794523599166037e-32, id)
            s1: CmF64InvtrigDD = cm_b64_atan_adddd(xh: al, xl: at, ch: df, cl: 0.0)
            s2: CmF64InvtrigDD = cm_b64_atan_adddd(xh: s1.hi, xl: s1.lo, ch: h, cl: hl)
            s3: CmF64InvtrigDD = cm_b64_atan_adddd(xh: s2.hi, xl: s2.lo, ch: f.hi, cl: f.lo)
            becomes (ah, s3.hi, s3.lo)
    ah, al, at = values3

    # ah + al + at, with the inputs too close to a rounding boundary settled apart
    s0: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: ah, y: al)
    s1: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: s0.lo, y: at)
    v0: B64 = s0.hi
    v1: B64 = s1.hi
    t0: U64 = v0.bits()
    t1: U64 = v1.bits()
    frac1: U64 = t1 +% 1 & 0x000FFFFFFFFFFFFF
    near: Bool = frac1 <= 2
    e0: U64 = (t0 >> 52) & 0x7FF
    gap: Bool = e0 -% ((t1 >> 52) & 0x7FF) > 103
    if near or gap
        ax: B64 = x.abs()

        v2: B64 = s1.lo

        each k in 0 til 12
            if ax == B64.from_bits(CM_B64_ATAN_DB_X.getitem(k))
                rh: B64 = B64.from_bits(CM_B64_ATAN_DB_H.getitem(k)).copysign(x)
                rl: B64 = sg * B64.from_bits(CM_B64_ATAN_DB_L.getitem(k))
                return rh + rl
            else
                continue
        then
            # v1 has an all-zero significand: move it one ulp toward v2
            t12: U64 = v1.bits()
            if t12 & 0x000FFFFFFFFFFFFF != 0
                return v1 + v0
            sign_diff: U64 = v2.bits() ^ t12
            opposite: Bool = sign_diff >> 63 != 0
            t: U64 = when
                opposite => t12 -% 1
                else => t12 +% 1
            return B64.from_bits(t) + v0
    else
        return v1 + v0

### The double-double sum (xh + xl) + (ch + cl), for any operands.
### :param xh: The high part of the first addend.
### :param xl: The low part of the first addend.
### :param ch: The high part of the second addend.
### :param cl: The low part of the second addend.
### :returns: The sum as a double-double.
routine cm_b64_atan_adddd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64InvtrigDD
    s: B64 = xh + ch
    d: B64 = s - xh
    err: B64 = ch - d + (xh + (d - s))
    l: B64 = err + (xl + cl)
    return CmF64InvtrigDD(hi: s, lo: l)

### The double-double product (xh + xl) (ch + cl), renormalized.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The product as a double-double.
routine cm_b64_atan_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64InvtrigDD
    ahlh: B64 = ch * xl
    alhh: B64 = cl * xh
    ahhh: B64 = ch * xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) + (alhh + ahlh)
    return cm_b64_invtrig_fasttwosum(x: ahhh, y: ahhl)
