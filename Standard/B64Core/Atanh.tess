# Tessera stdlib: the correctly rounded inverse hyperbolic tangent of B64
#
# For |x| < 1/4 an odd polynomial, redone in double-double when its error bound can't decide the rounding.
# Otherwise atanh |x| = log((1 + |x|) / (1 - |x|)) / 2, with the quotient as a double-double and the logarithm
# from the tables of ArchypShared.tess (halved: this file keeps its own -log(r) / 2 tables), checked with an
# error bound. The accurate path computes the logarithm to about 150 bits and looks the two hardest arguments
# up in a table of exact values.
# Round to nearest only: ±1 give ±inf, |x| > 1 gives the default NaN (C's sqrt(-1.0) on x86), ±0 and NaN map
# to themselves (NaN quiet), atanh(-x) = -atanh(x).
#
# Ported from CORE-MATH, src/binary64/atanh/atanh.c via RazorForge's B64Atanh.rf.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Low parts of -log(r1[i]) / 2 as a double-double, as B64 bits.
preset CM_B64_ATANH_L1_LO: @Array[U64, 33] <- [0x0000000000000000, 0xBE4532C1269E2038,
    0x3E4CE42D81B54E84, 0xBE525826F815EC3D, 0x3E50DB1B1E7CEE11, 0xBE51F3A8C6C95003,
    0xBE5774CD4FB8C30D, 0x3E2452E56C030A0A, 0x3E36B63C4966A79A, 0xBE3B20A21CCB525E,
    0x3E54006CFB3D8F85, 0xBE5CDB026B310C41, 0xBE569124FDC0F16D, 0xBE5084656CDC2727,
    0xBE5376FA8B0357FD, 0x3E3E56AE55A47B4A, 0x3E5070FF8834EEB4, 0x3E5623516109F4FE,
    0xBE2EC656B95FBDAC, 0x3E3F0CA2E729F510, 0xBE57D260A858354A, 0x3E4E7279075503D3,
    0x3E439E1A0A503873, 0x3E5CD86D7B87C3D6, 0x3E5060AB88DE341E, 0x3E320A860D3F9390,
    0xBE4DACEE95FC2F10, 0x3E545DE3A86E0ACA, 0x3E4C164CBFB991AF, 0x3E5D3F66B24225EF,
    0x3E5FC023EFA144BA, 0x3E3086A8AF6F26C0, 0xBE105C610CA86C39]

