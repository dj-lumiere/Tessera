### Hard-to-round arguments |x| (sorted), as B64 bits.
preset CM_B64_ATANH_DB_X: @Array[U64, 2] <- [0x3FD2DBB7B1C91363, 0x3FDC493DC899E4A5]

### The high parts of atanh |x| for those arguments, as B64 bits.
preset CM_B64_ATANH_DB_H: @Array[U64, 2] <- [0x3FD36F33D51C264D, 0x3FDE611AA58AB608]

### The low parts, as B64 bits.
preset CM_B64_ATANH_DB_L: @Array[U64, 2] <- [0x3C70000000000000, 0xBC70000000000000]

### atanh `me`, correctly rounded.
### :returns: The inverse hyperbolic tangent of `me`.
routine B64.atanh(me: Me) -> Me
    local ax: Me = me.abs()
    local aix: U64 = ax.bits()

    outside: Bool = aix >= 0x3FF0000000000000  # |x| >= 1
    # |x| < 1/4
    when
        outside =>
            pole: Bool = aix == 0x3FF0000000000000
            when
                pole => return Me.INFINITY.copysign(me)
                aix > 0x7FF0000000000000 => return me + me
                else => return Me.from_bits(0xFFF8000000000000)
        aix < 0x3FD0000000000000 =>
            # |x| < 0x1.d12ed0af1a27fp-27: atanh x rounds to x
            if aix < 0x3E4D12ED0AF1A27F
                return me.mul_add(a: 2.7755575615628914e-17, b: me)
            # x + (0x1.5555555555555p-2 + 0x1.5555555555555p-56) x^3 + x^5 p(x^2) approximates atanh x with relative
            # error <= 2^-64.377 on [0x1.d12ed0af1a27fp-27, 1/4]
            x2: Me = me * me
            dx2: Me = b64_mul_error(x: me, y: me, p: x2)
            x4: Me = x2 * x2
            x3: Me = x2 * me
            x8: Me = x4 * x4
            dx3: Me = b64_mul_error(x: x2, y: me, p: x3) + dx2 * me
            c5: Me = x2 * 0.14285714285712647 + 0.2
            c9: Me = x2 * 0.09090908976892513 + 0.11111111111808246
            c13: Me = x2 * 0.06666239776817569 + 0.07692317014814237
            c17: Me = x2 * 0.05086774199149965 + 0.058937769446109164
            lo: Me = x4 * c9 + c5
            hi0: Me = x4 * c17 + c13
            hi: Me = hi0 + x8 * 0.06193697662487306
            p: Me = lo + x8 * hi
            t: Me = x2.mul_add(a: p, b: 1.850371707708594e-17)
            c: CmF64HypDd = cm_b64_hyp_fasttwosum(x: 0.3333333333333333, y: t)
            c3: CmF64HypDd = cm_b64_atanh_muldd(xh: c.hi, xl: c.lo, ch: x3, cl: dx3)
            s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: me, y: c3.hi)
            pl: Me = c3.lo + s.lo
            eps: Me = me * (x4 * 2.0122792321330962e-16 + 9.860761315262648e-32)
            lb: Me = s.hi + (pl - eps)
            ub: Me = s.hi + (pl + eps)
            if lb == ub
                return lb
            else
                return cm_b64_atanh_zero(me)
        else => return cm_b64_atanh_main(me)

### atanh x for 1/4 <= |x| < 1: log((1 + |x|) / (1 - |x|)) / 2.
### :param x: The argument, 1/4 <= |`x`| < 1.
### :returns: atanh(`x`), correctly rounded.
private routine cm_b64_atanh_main(x: B64) -> B64
    ax: B64 = x.abs()
    # th + tl = (ph + pl) / (qh + ql) = (1 + |x|) / (1 - |x|)
    p: CmF64HypDd = cm_b64_hyp_fasttwosum(x: 1.0, y: ax)
    q: CmF64HypDd = cm_b64_atanh_fasttwosub(x: 1.0, y: ax)
    iqh: B64 = B64.div(1.0, q.hi)
    th: B64 = p.hi * iqh
    rem: B64 = (-q.hi).mul_add(a: iqh, b: 1.0)
    corr: B64 = rem - q.lo * iqh
    tl: B64 = b64_mul_error(x: p.hi, y: iqh, p: th) + (p.lo + p.hi * corr) * iqh
    tb: U64 = th.bits()
    eb: S64 = (tb >> 52).to[S64]()
    e: S64 = eb - 0x3FF
    tm: U64 = tb & 0x000FFFFFFFFFFFFF
    ed: B64 = e.to[B64]()
    j: U64 = cm_b64_archyp_index(tm)
    tf: B64 = B64.from_bits(tm | 0x3FF0000000000000)
    i1: USize = (j >> 5).to[USize]()
    i2: USize = (j & 0x1F).to[USize]()
    r1: B64 = B64.from_bits(CM_B64_ARCHYP_R1.getitem(i1))
    r: B64 = B64.mul(0.5, r1) * B64.from_bits(CM_B64_ARCHYP_R2.getitem(i2))
    dx: B64 = r.mul_add(a: tf, b: -0.5)
    dx2: B64 = dx * dx
    rx: B64 = r * tf
    dxl: B64 = b64_mul_error(x: r, y: tf, p: rx)
    f: B64 = dx2 * cm_b64_atanh_log_poly(dx, dx2)
    # log(2) / 2 as l2h + l2l
    l1h: B64 = B64.from_bits(CM_B64_ATANH_L1_HI.getitem(i1))
    l2h: B64 = B64.from_bits(CM_B64_ATANH_L2_HI.getitem(i2))
    l1l: B64 = B64.from_bits(CM_B64_ATANH_L1_LO.getitem(i1))
    l2l: B64 = B64.from_bits(CM_B64_ATANH_L2_LO.getitem(i2))
    lh0: B64 = l1h + l2h + B64.mul(0.3465735902799736, ed)
    ls: CmF64HypDd = cm_b64_hyp_fasttwosum(x: lh0, y: rx - 0.5)
    lt0: B64 = B64.mul(-9.320943368621517e-16, ed) + (l1l + l2l)
    lt: B64 = lt0 + dxl
    ll0: B64 = ls.lo + (lt + B64.mul(0.5, tl) / th)
    ll1: B64 = ll0 + f
    sgn: B64 = B64.copysign(1.0, x)
    lh: B64 = ls.hi * sgn
    ll: B64 = ll1 * sgn
    eps: B64 = dx2 * 1.7763568394002505e-15 + 3.8e-23  # 38e-24 in the original
    lb: B64 = lh + (ll - eps)
    ub: B64 = lh + (ll + eps)
    if lb == ub
        return lb
    else
        z: CmF64HypDd = cm_b64_hyp_fasttwosum(x: th, y: tl)
        return cm_b64_atanh_refine(x, zh: z.hi, zl: z.lo, a: B64.mul(2.8853900817779268, (lh + ll).abs()))

### The fast-path polynomial of log(1 + 2dx) / 2 - dx, divided by dx^2.
### :param dx: The reduced argument.
### :param dx2: `dx`^2.
### :returns: The polynomial's value.
private routine cm_b64_atanh_log_poly(dx: B64, dx2: B64) -> B64
    a: B64 = dx * 1.333333333333325 + -1.0
    b: B64 = dx * 3.2000005485719383 + -1.9999999999999787
    c: B64 = dx2 * -5.333334430663483 + b
    return dx2 * c + a

### x - y as hi + lo exactly, when |x| >= |y|.
### :param x: The minuend, |`x`| >= |`y`|.
### :param y: The subtrahend.
### :returns: The difference as a double-double.
private routine cm_b64_atanh_fasttwosub(x: B64, y: B64) -> CmF64HypDd
    s: B64 = x - y
    z: B64 = x - s
    e: B64 = z - y
    return CmF64HypDd(hi: s, lo: e)

### The double-double sum (xh + xl) + (ch + cl), the high parts with an exact two-sum.
### :param xh: The high part of the first addend.
### :param xl: The low part of the first addend.
### :param ch: The high part of the second addend.
### :param cl: The low part of the second addend.
### :returns: The sum as a double-double.
private routine cm_b64_atanh_adddd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    s: B64 = xh + ch
    d: B64 = s - xh
    err: B64 = ch - d + (xh + (d - s))
    l: B64 = err + (xl + cl)
    return CmF64HypDd(hi: s, lo: l)

### The double-double product (xh + xl) (ch + cl), renormalized.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The product as a double-double.
private routine cm_b64_atanh_muldd_acc(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    ahlh: B64 = ch * xl
    alhh: B64 = cl * xh
    ahhh: B64 = ch * xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) + (alhh + ahlh)
    return cm_b64_hyp_fasttwosum(x: ahhh, y: ahhl)

### The double-double product (xh + xl) (ch + cl), not renormalized.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The product as a double-double.
private routine cm_b64_atanh_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    ahlh: B64 = ch * xl
    alhh: B64 = cl * xh
    ahhh: B64 = ch * xh
    l: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) + (alhh + ahlh)
    return CmF64HypDd(hi: ahhh, lo: l)

### One Horner step of a double-double polynomial: `value` `x` + `c`.
### :param x: The point, as a double-double.
### :param value: The polynomial so far, as a double-double.
### :param c: The next coefficient, as a double-double.
### :returns: The new value as a double-double.
private routine cm_b64_atanh_polydd_step(x: CmF64HypDd, value: CmF64HypDd,
    c: CmF64HypDd) -> CmF64HypDd
    p: CmF64HypDd = cm_b64_atanh_muldd_acc(xh: x.hi, xl: x.lo, ch: value.hi, cl: value.lo)
    s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: c.hi, y: p.hi)
    l: B64 = p.lo + (s.lo + c.lo)
    return CmF64HypDd(hi: s.hi, lo: l)

### The accurate path of atanh for 0x1.d12ed0af1a27fp-27 <= |x| < 1/4: a double-double odd polynomial.
### :param x: The argument.
### :returns: atanh(`x`), correctly rounded.
private routine cm_b64_atanh_zero(x: B64) -> B64
    x2: B64 = x * x
    x2l: B64 = b64_mul_error(x, y: x, p: x2)
    x2dd: CmF64HypDd = (hi: x2, lo: x2l)
    c0: B64 = x2 * 0.05003849976370781 + 0.02116642652779962
    c1: B64 = x2 * c0 + 0.03167530391844863
    c2: B64 = x2 * c1 + 0.03208910526814049
    y2: B64 = x2 * (x2 * c2 + 0.03449753297471624)
    p27: CmF64HypDd = cm_b64_hyp_polydd_init(l: y2, c_hi: 0.03703608620183014, c_lo: 5.333875183633964e-19)
    p25: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p27, c: CmF64HypDd(hi: 0.04000004590716563, lo: -9.100057887980383e-19))
    p23: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p25, c: CmF64HypDd(hi: 0.043478259192632006, lo: 2.406803221946237e-18))
    p21: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p23, c: CmF64HypDd(hi: 0.04761904766540985, lo: -7.243272668421443e-19))
    p19: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p21, c: CmF64HypDd(hi: 0.052631578946404994, lo: 9.70086346040831e-19))
    p17: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p19, c: CmF64HypDd(hi: 0.05882352941177954, lo: -3.4181660383881804e-18))
    p15: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p17, c: CmF64HypDd(hi: 0.0666666666666665, lo: 2.2639864550633525e-18))
    p13: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p15, c: CmF64HypDd(hi: 0.07692307692307693, lo: -2.985467266913514e-18))
    p11: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p13, c: CmF64HypDd(hi: 0.09090909090909091, lo: -2.5298429906136707e-18))
    p9: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p11, c: CmF64HypDd(hi: 0.1111111111111111, lo: 6.167926368992028e-18))
    p7: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p9, c: CmF64HypDd(hi: 0.14285714285714285, lo: 7.930164427506819e-18))
    p5: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p7, c: CmF64HypDd(hi: 0.2, lo: -1.1102230246229284e-17))
    p3: CmF64HypDd = cm_b64_atanh_polydd_step(x: x2dd, value: p5, c: CmF64HypDd(hi: 0.3333333333333333, lo: 1.850371707708594e-17))
    px: CmF64HypDd = cm_b64_hyp_mulddd(xh: p3.hi, xl: p3.lo, ch: x)
    p: CmF64HypDd = cm_b64_atanh_muldd_acc(xh: x2, xl: x2l, ch: px.hi, cl: px.lo)
    s0: CmF64HypDd = cm_b64_hyp_fasttwosum(x, y: p.hi)
    s1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: s0.lo, y: p.lo)
    return s0.hi + cm_b64_hyp_nudge(y1: s1.hi, y2: s1.lo)

### The accurate path of atanh: log(zh + zl) / 2 to about 150 bits, where zh + zl is (1 + |x|) / (1 - |x|) and
### a approximates log2(zh + zl).
### :param x: The argument.
### :param zh: The high part of (1 + |`x`|) / (1 - |`x`|).
### :param zl: The low part of (1 + |`x`|) / (1 - |`x`|).
### :param a: The approximation of log2(`zh` + `zl`).
### :returns: atanh(`x`), correctly rounded.
private routine cm_b64_atanh_refine(x: B64, zh: B64, zl: B64, a: B64) -> B64
    tb: U64 = zh.bits()
    eb: S64 = (tb >> 52).to[S64]()
    e: S64 = eb - 0x3FF
    m: B64 = B64.from_bits((tb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000)
    ed: B64 = e.to[B64]()
    fr: B64 = a - ed + 1.0000076293945312
    fm: U64 = fr.bits() -% 0x3FF0000000000000
    i: U64 = fm >> 36
    i1: USize = (i >> 12).to[USize]()
    i2u: U64 = (i >> 8) & 0xF
    i2: USize = i2u.to[USize]()
    i3u: U64 = (i >> 4) & 0xF
    i3: USize = i3u.to[USize]()
    i4: USize = (i & 0xF).to[USize]()
    # log(2) / 2 as a triple-double
    el2: B64 = B64.mul(9.735225461903722e-32, ed)
    el1: B64 = B64.mul(-9.320943368621517e-16, ed)
    el0: B64 = B64.mul(0.3465735902799736, ed)
    big: CmF64ArchypTd = cm_b64_archyp_log_table(i1, i2, i3, i4)
    big0: B64 = big.hi + el0
    rt: CmF64HypDd = cm_b64_archyp_rt(i1, i2, i3, i4)
    dh: B64 = rt.hi * m
    dl: B64 = b64_mul_error(x: rt.hi, y: m, p: dh)
    sh: B64 = rt.lo * m
    sl: B64 = b64_mul_error(x: rt.lo, y: m, p: sh)
    q: CmF64HypDd = cm_b64_hyp_fasttwosum(x: dh - 1.0, y: dl)
    # zl / 2^e, scaled like m = zh / 2^e
    zs: B64 = B64.from_bits(zl.bits() -% (e.to_wrap[U64]() << 52))
    xs: CmF64HypDd = cm_b64_atanh_adddd(xh: q.hi, xl: q.lo + rt.hi * zs, ch: sh, cl: sl)
    xh: B64 = xs.hi
    c: B64 = xh * -0.08333333333957192 + 0.10000000000623753
    tail: B64 = xh * (xh * c + -0.125)
    p3: CmF64HypDd = cm_b64_hyp_polydd_init(l: tail, c_hi: 0.16666666666666666, c_lo: 9.251722364706052e-18)
    p2: CmF64HypDd = cm_b64_atanh_polydd_step(x: xs, value: p3, c: CmF64HypDd(hi: -0.25, lo: -1.2132617075138667e-33))
    p1: CmF64HypDd = cm_b64_atanh_polydd_step(x: xs, value: p2, c: CmF64HypDd(hi: 0.5, lo: 4.4042538178616445e-34))
    p0: CmF64HypDd = cm_b64_atanh_muldd_acc(xh, xl: xs.lo, ch: p1.hi, cl: p1.lo)
    pe: CmF64HypDd = cm_b64_atanh_adddd(xh: p0.hi, xl: p0.lo, ch: el1, cl: el2)
    s: CmF64HypDd = cm_b64_atanh_adddd(xh: pe.hi, xl: pe.lo, ch: big.mid, cl: big.lo)
    w0: CmF64HypDd = cm_b64_hyp_fasttwosum(x: big0, y: s.hi)
    w1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: w0.lo, y: s.lo)
    # a power-of-two v1 has the sign of the rest: add one ulp of v1 in the direction of its sign
    tu0: U64 = w1.hi.bits()
    pow2: Bool = tu0 & 0x000FFFFFFFFFFFFF == 0
    tu: U64 = when
        pow2 => tu0 +% 1
        else => tu0
    er: U64 = tu +% 1 & 0x000FFFFFFFFFFFFF
    w0_top: U64 = w0.hi.bits() >> 52
    de: U64 = (w0_top & 0x7FF) -% ((tu >> 52) & 0x7FF)
    sgn: B64 = B64.copysign(1.0, x)
    res: B64 = w0.hi * sgn + B64.from_bits(tu) * sgn
    if de > 104 or er < 3
        return cm_b64_atanh_database(x, f: res)
    else
        return res

### The exact atanh x for the arguments the fast and accurate paths can't round, or f for any other x.
### :param x: The argument.
### :param f: The result for an argument that is not in the table.
### :returns: The tabulated atanh(`x`) for a listed `x`, else `f`.
private routine cm_b64_atanh_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 1
        m: S64 = (a + b) / 2
        mu: USize = m.to[USize]()
        key: B64 = B64.from_bits(CM_B64_ATANH_DB_X.getitem(mu))
        ax: B64 = x.abs()
        below: Bool = key < ax
        when
            below => continue with a: m + 1, b: b
            key == ax =>
                sgn: B64 = B64.copysign(1.0, x)
                h: B64 = B64.from_bits(CM_B64_ATANH_DB_H.getitem(mu))
                l: B64 = B64.from_bits(CM_B64_ATANH_DB_L.getitem(mu))
                return sgn * h + sgn * l
            else => continue with a: a, b: m - 1
    then
        return f
