// Tessera stdlib: the correctly rounded inverse hyperbolic cosine of B64
//
// Near 1, acosh(1 + z) = sqrt(2z) (1 + z P(z)). Elsewhere acosh x = log(x + sqrt(x^2 - 1)), with the argument
// as a double-double below 111.75 and as log(2x) plus a short correction series in 1/x^2 above, and the
// logarithm from the tables of ArchypShared.tess, checked with an error bound. The accurate path computes the
// logarithm to about 150 bits and looks the few hardest arguments up in a table of exact values.
// Round to nearest only: acosh(1) = +0, +inf maps to +inf, NaN comes back quiet, and x < 1 (-inf included)
// gives the default NaN (C's 0.0 / 0.0 on x86).
//
// Ported from CORE-MATH, src/binary64/acosh/acosh.c via RazorForge's B64Acosh.rf.
// Copyright (c) 2023 Alexei Sibidanov.
// MIT license: see LICENSE-CORE-MATH

module Standard/Core

/// Hard-to-round arguments x (sorted), as B64 bits.
preset CM_B64_ACOSH_DB_X: @Array[U64, 7] <- [0x3FF5BFF041B260FE, 0x3FF9EFDCA62B700A,
    0x3FFA5BF3ACFDE4B2, 0x40645EA160DDC71F, 0x4092A686E4B567CE, 0x40ECB62EEC26BD78,
    0x40F3BF8009648DC0]

/// The high parts of acosh x for those arguments, as B64 bits.
preset CM_B64_ACOSH_DB_H: @Array[U64, 7] <- [0x3FEA6031CD5F93BA, 0x3FF104B648F113A1,
    0x3FF1585720F35CD9, 0x401725811DCF6782, 0x401F1C928E7F1E65, 0x402759A2AD4C4D56,
    0x4027FCE95EA5C653]

/// The low parts, as B64 bits.
preset CM_B64_ACOSH_DB_L: @Array[U64, 7] <- [0x3C80000000000000, 0x3C90000000000000,
    0xBC90000000000000, 0x3CB0000000000000, 0x3CB0000000000000, 0x3CC0000000000000,
    0xBCA0000000000000]

/// acosh `me`, correctly rounded.
/// :returns: The inverse hyperbolic cosine of `me`.
routine B64.acosh(me: Me) -> Me
    local ix: U64 = me.bits()

    special: Bool = ix >= 0x7FF0000000000000

    // x < 0, NaN or +inf
    upto_one: Bool = ix <= 0x3FF0000000000000
    // 0 <= x <= 1
    near_one: Bool = ix < 0x3FF1E83E425AEE63
    // x < 0x1.1e83e425aee63p+0
    moderate: Bool = ix < 0x405BF00000000000
    // x < 111.75
    below738: Bool = ix < 0x4087100000000000
    below2e4: Bool = ix < 0x40E0100000000000
    // x < 32896
    // x < 0x1.ap+31
    when
        special => jump special()
        upto_one => jump upto_one()
        near_one => jump near_one()
        moderate => jump moderate()
        below738 => jump series3()
        below2e4 => jump series2()
        ix < 0x41EA000000000000 => jump series1()
        else => jump log_fast(ix, 0x3FE, 0.0, 1.8380614955418317e-19)

    block special()
        // +inf or NaN
        if ix == 0x7FF0000000000000 or ix << 1 > 0xFFE0000000000000
            return me + me
        else
            return Me.from_bits(0xFFF8000000000000)

    block upto_one()
        if ix == 0x3FF0000000000000
            return 0.0
        else
            return Me.from_bits(0xFFF8000000000000)

    // 1 < x < 0x1.1e83e425aee63p+0: acosh(1 + z) = sqrt(2z) (1 + z P(z)), with sqrt(2z) = sh + sl
    block near_one()
        z: Me = me - 1.0
        iz: Me = Me.div(-0.25, z)
        zt: Me = Me.mul(2.0, z)
        sh: Me = zt.sqrt()
        sl: Me = sh.mul_add(a: sh, b: -zt) * (sh * iz)
        z2: Me = z * z
        z4: Me = z2 * z2
        c2: Me = z * -0.0055803571425102165 + 0.018749999999996787
        c4: Me = z * -0.0006991293701336483 + 0.0018988715087326544
        c6: Me = z * -0.00010896132591969038 + 0.00027112534949498546
        c8: Me = z * -1.4840272705632399e-05 + 4.410690395968596e-05
        c24: Me = z2 * c4 + c2
        c68: Me = z2 * c8 + c6
        poly: Me = z * (z4 * c68 + c24) + -0.08333333333333333
        ds: Me = (sh * z).mul_add(a: poly, b: sl)
        eps: Me = ds * 8.881784197001252e-16 - Me.mul(4.930380657631324e-32, sh)
        lb: Me = sh + (ds - eps)
        ub: Me = sh + (ds + eps)
        if lb == ub
            return lb
        else
            return cm_b64_acosh_one(z, sh, sl)

    // x < 111.75: th + tl = x + sqrt(x^2 - 1), and log(th + tl) = log(th) + tl/th
    block moderate()
        x2h: Me = me * me
        wh: Me = x2h - 1.0
        wl: Me = b64_mul_error(x: me, y: me, p: x2h)
        sh: Me = wh.sqrt()
        ish: Me = Me.div(0.5, wh)
        sl: Me = (wl - sh.mul_add(a: sh, b: -wh)) * (sh * ish)
        s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: me, y: sh)
        tl: Me = s.lo + sl
        jump log_fast(s.hi.bits(), 0x3FF, tl / s.hi, 1.6305384234645282e-19)

    // 111.75 <= x < 738: log(x + sqrt(x^2 - 1)) = log(2x) + g with g a series in z = 1/x^2
    block series3()
        z: Me = Me.div(1.0, me * me)
        c0: Me = z * -0.052088933292329824 + -0.09374999970827397
        c1: Me = z * c0 + -0.2500000000000051
        jump log_fast(me.bits(), 0x3FE, z * c1 + 1.8438554824029686e-20, 1.9100592960584473e-19)

    // 738 <= x < 32896
    block series2()
        z: Me = Me.div(1.0, me * me)
        c0: Me = z * -0.09375014351472541 + -0.24999999999990108
        jump log_fast(me.bits(), 0x3FE, z * c0 + -1.0150310783512001e-20, 1.7364175418713157e-19)

    // 32896 <= x < 0x1.ap+31
    block series1()
        z: Me = Me.div(1.0, me * me)
        jump log_fast(me.bits(), 0x3FE, z * -0.25000000008663337 + 1.0007109452477697e-20, 1.7321823771350442e-19)

    // log(2^(e - off) m) + g for the bits t of 2^e m, from the tables
    block log_fast(t: U64, off: S64, g: Me, eps: Me)
        eb: S64 = (t >> 52).to[S64]()
        e: S64 = eb - off
        tm: U64 = t & 0x000FFFFFFFFFFFFF
        ed: Me = e.to[Me]()
        j: U64 = cm_b64_archyp_index(tm)
        m: Me = Me.from_bits(tm | 0x3FF0000000000000)
        i1: USize = (j >> 5).to[USize]()
        i2: USize = (j & 0x1F).to[USize]()
        r: Me = Me.from_bits(CM_B64_ARCHYP_R1.getitem(i1)) * Me.from_bits(CM_B64_ARCHYP_R2.getitem(i2))
        dx: Me = r.mul_add(a: m, b: -1.0)
        dx2: Me = dx * dx
        f: Me = dx2 * cm_b64_archyp_log_poly(dx, dx2)
        // log(2) as l2h + l2l with l2h on 42 bits, so l2h ed is exact
        l1h: Me = Me.from_bits(CM_B64_ARCHYP_L1_HI.getitem(i1))
        l2h: Me = Me.from_bits(CM_B64_ARCHYP_L2_HI.getitem(i2))
        l1l: Me = Me.from_bits(CM_B64_ARCHYP_L1_LO.getitem(i1))
        l2l: Me = Me.from_bits(CM_B64_ARCHYP_L2_LO.getitem(i2))
        lh: Me = l1h + l2h + Me.mul(0.6931471805598903, ed)
        t1: Me = Me.mul(5.497923018708371e-14, ed) + (l1l + l2l)
        t2: Me = f + t1
        t3: Me = g + t2
        ll: Me = dx + t3
        lb: Me = lh + (ll - eps)
        ub: Me = lh + (ll + eps)
        // 0x1.71547652b82fep+0 approximates 1/log(2)
        if lb == ub
            return lb
        else
            return cm_b64_acosh_refine(x: me, a: Me.mul(1.4426950408889634, lb))

/// The double-double sum (xh + xl) + (ch + cl): an exact two-sum of the high parts plus the low parts.
/// :param xh: The high part of the first addend.
/// :param xl: The low part of the first addend.
/// :param ch: The high part of the second addend.
/// :param cl: The low part of the second addend.
/// :returns: The sum as a double-double.
private routine cm_b64_acosh_adddd(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    s: B64 = xh + ch
    ap: B64 = s - ch
    bp: B64 = s - ap
    da: B64 = xh - ap
    db: B64 = ch - bp
    return CmF64HypDd(hi: s, lo: da + db + (xl + cl))

/// The double-double product (xh + xl) (ch + cl), renormalized.
/// :param xh: The high part of the first factor.
/// :param xl: The low part of the first factor.
/// :param ch: The high part of the second factor.
/// :param cl: The low part of the second factor.
/// :returns: The product as a double-double.
private routine cm_b64_acosh_muldd_acc(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    ahlh: B64 = ch * xl
    alhh: B64 = cl * xh
    ahhh: B64 = ch * xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) + (alhh + ahlh)
    return cm_b64_hyp_fasttwosum(x: ahhh, y: ahhl)

/// The double-double times double product (xh + xl) ch, renormalized.
/// :param xh: The high part of the double-double factor.
/// :param xl: The low part of the double-double factor.
/// :param ch: The B64 factor.
/// :returns: The product as a double-double.
private routine cm_b64_acosh_mulddd(xh: B64, xl: B64, ch: B64) -> CmF64HypDd
    ahlh: B64 = ch * xl
    ahhh: B64 = ch * xh
    ahhl: B64 = b64_mul_error(x: ch, y: xh, p: ahhh) + ahlh
    h: B64 = ahhh + ahhl
    l: B64 = ahhh - h + ahhl
    return CmF64HypDd(hi: h, lo: l)

/// One Horner step of a double-double polynomial: `value` `x` + `c`.
/// :param x: The point, as a double-double.
/// :param value: The polynomial so far, as a double-double.
/// :param c: The next coefficient, as a double-double.
/// :returns: The new value as a double-double.
private routine cm_b64_acosh_polydd_step(x: CmF64HypDd, value: CmF64HypDd,
    c: CmF64HypDd) -> CmF64HypDd
    p: CmF64HypDd = cm_b64_acosh_muldd_acc(xh: x.hi, xl: x.lo, ch: value.hi, cl: value.lo)
    s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: c.hi, y: p.hi)
    l: B64 = p.lo + (s.lo + c.lo)
    return CmF64HypDd(hi: s.hi, lo: l)

/// The accurate path of acosh near 1: acosh(1 + z) = sqrt(2z) (1 + z P(z)), with sqrt(2z) = sh + sl.
/// :param z: x - 1.
/// :param sh: The high part of sqrt(2 `z`).
/// :param sl: The low part of sqrt(2 `z`).
/// :returns: acosh(1 + `z`), correctly rounded.
private routine cm_b64_acosh_one(z: B64, sh: B64, sl: B64) -> B64
    zdd: CmF64HypDd = (hi: z, lo: 0.0)
    c0: B64 = z * 4.1117419046327436e-08 + -1.3222134018555206e-07
    c1: B64 = z * c0 + 3.1186638489529637e-07
    c2: B64 = z * c1 + -7.002006354495226e-07
    c3: B64 = z * c2 + 1.5739619710158544e-06
    y2: B64 = z * (z * c3 + -3.570563089012387e-06)
    p10: CmF64HypDd = cm_b64_hyp_polydd_init(l: y2, c_hi: 8.193686867890108e-06, c_lo: 1.6342510450995029e-24)
    p9: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p10, c: CmF64HypDd(hi: -1.9065643587602643e-05, lo: 2.144112338226363e-22))
    p8: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p9, c: CmF64HypDd(hi: 4.5124222249574996e-05, lo: -1.885407160762854e-21))
    p7: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p8, c: CmF64HypDd(hi: -0.00010910034179684623, lo: 6.538737541041623e-21))
    p6: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p7, c: CmF64HypDd(hi: 0.0002711369441105763, lo: 2.4059605609238967e-20))
    p5: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p6, c: CmF64HypDd(hi: -0.0006991299715909091, lo: 3.867929897043247e-20))
    p4: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p5, c: CmF64HypDd(hi: 0.0018988715277777778, lo: 2.4004217442971665e-20))
    p3: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p4, c: CmF64HypDd(hi: -0.005580357142857143, lo: 1.239093492806872e-19))
    p2: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p3, c: CmF64HypDd(hi: 0.01875, lo: 6.938893887350383e-19))
    p1: CmF64HypDd = cm_b64_acosh_polydd_step(x: zdd, value: p2, c: CmF64HypDd(hi: -0.08333333333333333, lo: -4.625929269269436e-18))
    p: CmF64HypDd = cm_b64_acosh_mulddd(xh: p1.hi, xl: p1.lo, ch: z)
    s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: 1.0, y: p.hi)
    q: CmF64HypDd = cm_b64_acosh_muldd_acc(xh: s.hi, xl: s.lo + p.lo, ch: sh, cl: sl)
    return q.hi + q.lo

/// The accurate path of acosh: log(x + sqrt(x^2 - 1)) to about 150 bits, where a approximates
/// acosh(x) / log(2).
/// :param x: The argument.
/// :param a: The approximation of acosh(`x`) / log(2).
/// :returns: acosh(`x`), correctly rounded.
private routine cm_b64_acosh_refine(x: B64, a: B64) -> B64
    ix: U64 = x.bits()
    moderate: Bool = ix < 0x4190000000000000
    // x < 2^26
    big: Bool = ix < 0x4330000000000000
    // x < 2^52
    values2: (B64, B64, S64) = when
        moderate =>
            // 2x could overflow: zh = x, and the exponent gets one more
            // zh + zl = x + sqrt(x^2 - 1)
            x2h: B64 = x * x
            x2l: B64 = b64_mul_error(x, y: x, p: x2h)
            w: CmF64HypDd = cm_b64_hyp_fasttwosum(x: x2h - 1.0, y: x2l)
            sh: B64 = w.hi.sqrt()
            sl: B64 = (w.lo - sh.mul_add(a: sh, b: -w.hi)) / B64.mul(2.0, sh)
            z0: CmF64HypDd = cm_b64_hyp_fasttwosum(x, y: sh)
            z: CmF64HypDd = cm_b64_hyp_fasttwosum(x: z0.hi, y: z0.lo + sl)
            becomes (z.hi, z.lo, 0)
        big => (B64.mul(2.0, x), B64.div(-0.5, x), 0)
        else => (x, 0.0, 1)
    zh, zl, huge = values2

    // zh + zl approximates x + sqrt(x^2 - 1), or half of it when huge = 1
    tb: U64 = zh.bits()
    eb: S64 = (tb >> 52).to[S64]()
    e: S64 = eb - 0x3FF + huge
    m: B64 = B64.from_bits((tb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000)
    ed: B64 = e.to[B64]()
    fr: B64 = a - ed + 1.0000076293945312
    fm: U64 = fr.bits() -% 0x3FF0000000000000
    i: U64 = fm >> 36
    i1u: U64 = (i >> 12) & 0x1F
    i1: USize = i1u.to[USize]()
    i2u: U64 = (i >> 8) & 0xF
    i2: USize = i2u.to[USize]()
    i3u: U64 = (i >> 4) & 0xF
    i3: USize = i3u.to[USize]()
    i4: USize = (i & 0xF).to[USize]()
    el2: B64 = B64.mul(-6.562349208892628e-28, ed)
    el1: B64 = B64.mul(2.7489615093542512e-14, ed)
    el0: B64 = B64.mul(0.34657359027994517, ed)
    big2: CmF64ArchypTd = cm_b64_archyp_log_table(i1, i2, i3, i4)
    big0: B64 = big2.hi + el0
    rt: CmF64HypDd = cm_b64_archyp_rt(i1, i2, i3, i4)
    dh: B64 = rt.hi * m
    dl: B64 = b64_mul_error(x: rt.hi, y: m, p: dh)
    sh: B64 = rt.lo * m
    sl: B64 = b64_mul_error(x: rt.lo, y: m, p: sh)
    q: CmF64HypDd = cm_b64_hyp_fasttwosum(x: dh - 1.0, y: dl)
    // zl / 2^e, scaled like m = zh / 2^e
    zs: B64 = B64.from_bits(zl.bits() -% (e.to_wrap[U64]() << 52))
    zero: Bool = zl == 0.0
    xl: B64 = when
        zero => q.lo
        else => q.lo + rt.hi * zs
    xs: CmF64HypDd = cm_b64_acosh_adddd(xh: q.hi, xl, ch: sh, cl: sl)
    xh: B64 = xs.hi
    c: B64 = xh * -0.08333333333957192 + 0.10000000000623753
    tail: B64 = xh * (xh * c + -0.125)
    p3: CmF64HypDd = cm_b64_hyp_polydd_init(l: tail, c_hi: 0.16666666666666666, c_lo: 9.251722364706052e-18)
    p2: CmF64HypDd = cm_b64_acosh_polydd_step(x: xs, value: p3, c: CmF64HypDd(hi: -0.25, lo: -1.2132617075138667e-33))
    p1: CmF64HypDd = cm_b64_acosh_polydd_step(x: xs, value: p2, c: CmF64HypDd(hi: 0.5, lo: 4.4042538178616445e-34))
    p0: CmF64HypDd = cm_b64_acosh_muldd_acc(xh, xl: xs.lo, ch: p1.hi, cl: p1.lo)
    pe: CmF64HypDd = cm_b64_acosh_adddd(xh: p0.hi, xl: p0.lo, ch: el1, cl: el2)
    s: CmF64HypDd = cm_b64_acosh_adddd(xh: pe.hi, xl: pe.lo, ch: big2.mid, cl: big2.lo)
    w0: CmF64HypDd = cm_b64_hyp_fasttwosum(x: big0, y: s.hi)
    w1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: w0.lo, y: s.lo)
    v0: B64 = w0.hi * 2.0
    v1: B64 = cm_b64_hyp_nudge(y1: w1.hi * 2.0, y2: w1.lo * 2.0)
    tu: U64 = v1.bits()
    er: U64 = tu +% 7 & 0x000FFFFFFFFFFFFF
    v0_top: U64 = v0.bits() >> 52
    de: U64 = (v0_top & 0x7FF) -% ((tu >> 52) & 0x7FF)
    res: B64 = v0 + v1
    if de > 102 or er < 15
        return cm_b64_acosh_database(x, f: res)
    else
        return res

/// The exact acosh x for the arguments the fast and accurate paths can't round, or f for any other x.
/// :param x: The argument.
/// :param f: The result for an argument that is not in the table.
/// :returns: The tabulated acosh(`x`) for a listed `x`, else `f`.
private routine cm_b64_acosh_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 6
        m: S64 = (a + b) / 2
        mu: USize = m.to[USize]()
        key: B64 = B64.from_bits(CM_B64_ACOSH_DB_X.getitem(mu))
        below: Bool = key < x
        when
            below => continue with a: m + 1, b: b
            key == x =>
                h: B64 = B64.from_bits(CM_B64_ACOSH_DB_H.getitem(mu))
                l: B64 = B64.from_bits(CM_B64_ACOSH_DB_L.getitem(mu))
                return h + l
            else => continue with a: a, b: m - 1
    then
        return f
