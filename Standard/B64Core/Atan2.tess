    0xC00921FB54442D18, 0xBFF921FB54442D18]

### The low parts of the quadrant offsets, as B64 bits.
preset CM_B64_ATAN2_OL: @Array[U64, 8] <- [0x0000000000000000, 0x3C91A62633145C07,
    0x0000000000000000, 0xBC91A62633145C07, 0x3CA1A62633145C07, 0x3C91A62633145C07,
    0xBCA1A62633145C07, 0xBC91A62633145C07]

### A tint: (-1)^sgn (hm/2^128 + l/2^192) 2^ex, where the top bit of hm is 1
### unless the value is zero.
record CmF64Atan2Tint
    hm: U128
    l: U64
    ex: S64
    sgn: U64

### A 192-bit significand: h 2^64 + l.
record CmF64Atan2Sig
    h: U128
    l: U64

### The angle of the point (`other`, `me`), correctly rounded: `me` is y and `other` is x.
### :param other: The x coordinate.
### :returns: atan2(`me`, `other`), in radians.
routine B64.atan2(me: Me, other: Me) -> Me
    local iy: U64 = me.bits()
    local ix: U64 = other.bits()
    local aiy: U64 = iy & 0x7FFFFFFFFFFFFFFF
    local aix: U64 = ix & 0x7FFFFFFFFFFFFFFF
    local sy: U64 = iy >> 63
    local sx: U64 = ix >> 63
    local gt: U64 = (aix < aiy).to[U64]()

    yodd: Bool = aiy == 0 or aiy >= 0x7FF0000000000000
    xodd: Bool = aix == 0 or aix >= 0x7FF0000000000000
    if yodd or xodd
        return cm_b64_atan2_special(y: me, x: other)
    dxy: U64 = aix -% aiy ^ U64.sub_wrap(0, gt)
    # the exponents differ by 53 or more
    if dxy >= 0x0350000000000000
        return cm_b64_atan2_accurate(y: me, x: other)
    else
        # offset + atan(j/64) + atan((ym - xm j/64) / (xm + ym j/64)), with xm = max(|x|, |y|) and ym the other
        swap: Bool = me.abs() > other.abs()
        xm0: Me = when
            swap => me.abs()
            else => other.abs()
        ym0: Me = when
            swap => other.abs()
            else => me.abs()
        sign_parity: U64 = gt ^ sx ^ sy
        cs: Me = when
            sign_parity != 0 => -1.0
            else => 1.0
        kw_xy: U64 = (sx << 2) | (sy << 1)
        kw: USize = (kw_xy | gt).to[USize]()
        jj: Me = ym0 / xm0 + 2.0078125
        jb: U64 = jj.bits() >> 45
        jt: USize = (jb & 127).to[USize]()
        fh0: Me = Me.from_bits(CM_B64_ATAN2_F2H.getitem(jt)) * cs
        fl0: Me = Me.from_bits(CM_B64_ATAN2_F2L.getitem(jt)) * cs
        fh: Me = fh0 + Me.from_bits(CM_B64_ATAN2_OH.getitem(kw))
        fl: Me = fl0 + Me.from_bits(CM_B64_ATAN2_OL.getitem(kw))
        # scale tiny operands up, and huge ones down (unless j = 0)
        tiny: Bool = xm0 < 1.1282464849155185e-277
        huge: Bool = xm0 > 4.49423283715579e307 and jt != 0
        xm1: Me = when
            tiny => xm0 * 8.863311460481781e276
            else => xm0
        ym1: Me = when
            tiny => ym0 * 8.863311460481781e276
            else => ym0
        xm: Me = when
            huge => xm1 * 0.5
            else => xm1
        ym: Me = when
            huge => ym1 * 0.5
            else => ym1
        t0: Me = Me.from_bits(CM_B64_ATAN2_T2.getitem(jt))
        zn: Me = (-t0).mul_add(a: xm, b: ym)
        zd: Me = t0.mul_add(a: ym, b: xm)
        z0: Me = zn / zd
        z2: Me = z0 * z0
        z: Me = z0 * cs
        p2: Me = z2 * -0.14284292170535642 + 0.19999999943116925
        p1: Me = z2 * p2 + -0.33333333333332604
        dz: Me = z * z2 * p1
        abs_z: Me = z.abs()
        eps: Me = abs_z * 4.528712474471952e-16 + 8.077935669463161e-28
        s: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: fh, y: z)
        rl: Me = fl + dz + s.lo
        lb: Me = s.hi + (rl - eps)
        ub: Me = s.hi + (rl + eps)
        if lb == ub
            return ub
        else
            # the same reduction with z in double-double
            dh0: Me = ym * t0
            dl0: Me = b64_mul_error(x: ym, y: t0, p: dh0)
            d: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: xm, y: dh0)
            dh: Me = d.hi
            rdh: Me = Me.div(1.0, dh)
            dl: Me = dl0 + d.lo
            nh0: Me = xm * t0
            nl0: Me = b64_mul_error(x: xm, y: t0, p: nh0)
            dt: Me = ym - nh0
            y1: Me = dt + nh0
            lost: Bool = y1 != ym
            nlo: Me = when
                lost => ym - y1 - nl0
                else => -nl0
            n: CmF64InvtrigDD = cm_b64_invtrig_fasttwosum(x: dt, y: nlo)
            zh0: Me = n.hi * rdh
            z22: Me = zh0 * zh0
            zl0: Me = rdh * (dh.mul_add(a: -zh0, b: n.hi) + (n.lo - n.hi * rdh * dl))
            pa: Me = z22 * 0.19999999999974255 + -0.3333333333333333
            pb: Me = z22 * 0.11107620301764512 + -0.14285713816496304
            zl1: Me = zl0 + zh0 * z22 * (pa + z22 * z22 * pb)
            zh: Me = zh0 * cs
            zl: Me = zl1 * cs
            abs_zh: Me = zh.abs()
            eps2: Me = Me.mul(1.1102230246251565e-15, abs_zh * z22 + 4.440892098500626e-16)
            f: CmF64InvtrigDD = cm_b64_invtrig_fastsum(xh: fh, xl: fl, yh: zh, yl: zl)
            lb2: Me = f.hi + (f.lo - eps2)
            ub2: Me = f.hi + (f.lo + eps2)
            if lb2 == ub2
                return ub2
            else
                return cm_b64_atan2_accurate(y: me, x: other)

### atan2 when a coordinate is zero, infinite or NaN.
### :param y: The y coordinate.
### :param x: The x coordinate.
### :returns: atan2(`y`, `x`).
routine cm_b64_atan2_special(y: B64, x: B64) -> B64
    local aiy: U64 = y.bits() << 1
    local aix: U64 = x.bits() << 1
    local yinf: Bool = aiy == 0xFFE0000000000000

    nan: Bool = aiy > 0xFFE0000000000000 or aix > 0xFFE0000000000000
    xinf: Bool = aix == 0xFFE0000000000000
    when
        nan =>
            # the first NaN operand wins, quiet, like x86's y + x
            if y.is_nan()
                return y + y
            else
                return x + x
        xinf =>
            xneg: Bool = x < 0.0
            if yinf
                # +-3pi/4 or +-pi/4
                if xneg
                    return B64.copysign(2.356194490192345, y) + B64.copysign(5.551115123125783e-17, y)
                else
                    return B64.copysign(0.7853981633974483, y) + B64.copysign(2.7755575615628914e-17, y)
            else if xneg
                return B64.copysign(3.141592653589793, y) + B64.copysign(1.2246467991473532e-16, y)
            else
                return B64.copysign(0.0, y)
        yinf => return B64.copysign(1.5707963267948966, y) + B64.copysign(6.123233995736766e-17, y)
        aiy == 0 or aix == 0 =>
            both: Bool = aiy == 0 and aix == 0
            yz: Bool = aiy == 0
            when
                both =>
                    # +-0 for x = +0, +-pi for x = -0
                    xplus: Bool = x.bits() == 0
                    when
                        xplus => return y
                        y.bits() == 0 => return B64.add(3.141592653589793, 1.2246467991473532e-16)
                        else => return B64.sub(-3.141592653589793, 1.2246467991473532e-16)
                yz =>
                    xpos: Bool = x > 0.0
                    ysign: U64 = y.bits() >> 63
                    when
                        xpos => return y / x
                        ysign == 0 => return B64.add(3.141592653589793, 1.2246467991473532e-16)
                        else => return B64.sub(-3.141592653589793, 1.2246467991473532e-16)
                y > 0.0 => return B64.add(1.5707963267948966, 6.123233995736766e-17)
                else => return B64.sub(-1.5707963267948966, 6.123233995736766e-17)
        else => return 0.0

### The accurate path: atan2(y, x) for finite non-zero y and x, from a degree-29/29
### rational approximation of atan in tint arithmetic.
### :param y: The y coordinate, finite and non-zero.
### :param x: The x coordinate, finite and non-zero.
### :returns: atan2(`y`, `x`), correctly rounded.
routine cm_b64_atan2_accurate(y: B64, x: B64) -> B64
    local t: B64 = y / x

    if t == 0.0
        # y/x underflows to zero
        xpos: Bool = x > 0.0
        when
            xpos => return t
            y > 0.0 => return B64.add(3.141592653589793, 1.2246467991473532e-16)
            else => return B64.sub(-3.141592653589793, 1.2246467991473532e-16)
    else
        corr: B64 = t.mul_add(a: x, b: -y)
        if corr == 0.0 and x > 0.0
            # t = y/x exactly, x > 0: for a tiny t, atan(t) is t minus a hair
            if t.abs() <= 1.3538603431225864e-08
                if y.abs() >= 3.610388751729659e-276
                    return t.mul_add(a: -5.551115123125783e-17, b: t)
                corr2: B64 = (t * 4.056481920730334e31).mul_add(a: x, b: -y * 4.056481920730334e31)
                if corr2 == 0.0
                    return t.mul_add(a: -5.551115123125783e-17, b: t)
        inv: Bool = y.abs() > x.abs()
        num: B64 = when
            inv => x
            else => y
        den: B64 = when
            inv => y
            else => x
        z: CmF64Atan2Tint = cm_b64_atan2_div(b: num.to[CmF64Atan2Tint](), a: den.to[CmF64Atan2Tint]())
        direct_pos: Bool = not inv and x > 0.0
        if direct_pos and z.ex <= -96
            # atan(y/x) rounds like y/x nudged slightly toward zero
            zl: U64 = z.l -% 2
            zh0: U64 = (z.hm >> 64).to[U64]()
            zm0: U64 = z.hm.to_wrap[U64]()
            zm: U64 = when
                zl < 2 => zm0 -% 1
                else => zm0
            zh: U64 = when
                zm < 1 => zh0 -% 1
                else => zh0
            hi_word: U128 = zh.to[U128]() << 64
            hm: U128 = hi_word | zm.to[U128]()
            return CmF64Atan2Tint.to[B64](CmF64Atan2Tint(hm: hm, l: zl, ex: z.ex, sgn: z.sgn), 1)
        else
            # z P(z) / Q(z) for the positive z, by Horner's rule from the top coefficients

            sz: U64 = z.sgn

            za: CmF64Atan2Tint = CmF64Atan2Tint(hm: z.hm, l: z.l, ex: z.ex, sgn: 0)

            while i != 0 with i: USize = 29, p: CmF64Atan2Tint = cm_b64_atan2_p(29), q: CmF64Atan2Tint = cm_b64_atan2_q(29)
                k: USize = i - 1
                pz: CmF64Atan2Tint = cm_b64_atan2_mul(a: p, b: za)
                qz: CmF64Atan2Tint = cm_b64_atan2_mul(a: q, b: za)
                continue with i: k, p: cm_b64_atan2_add(a: pz, b: cm_b64_atan2_p(k)), q: cm_b64_atan2_add(a: qz, b: cm_b64_atan2_q(k))
            then
                # z approximates atan(y/x) (or atan(x/y) when inv), with -pi/4 < z < pi/4
                r: CmF64Atan2Tint = cm_b64_atan2_div(b: cm_b64_atan2_mul(a: p, b: za), a: q)
                a: CmF64Atan2Tint = CmF64Atan2Tint(hm: r.hm, l: r.l, ex: r.ex, sgn: sz)
                values2: (CmF64Atan2Tint, U64) = when
                    inv =>
                        # +-pi/2 - atan(x/y)
                        pi2: CmF64Atan2Tint = cm_b64_atan2_pi(1)
                        if a.sgn == 0
                            # pi/2 - atan(x/y)
                            neg: CmF64Atan2Tint = CmF64Atan2Tint(hm: a.hm, l: a.l, ex: a.ex, sgn: 1)
                            becomes (cm_b64_atan2_add(a: pi2, b: neg), 524)
                        else
                            # -pi/2 - atan(x/y)
                            s: CmF64Atan2Tint = cm_b64_atan2_add(a, b: pi2)
                            becomes (CmF64Atan2Tint(hm: s.hm, l: s.l, ex: s.ex, sgn: 1), 524)
                    else => (a, 662)
                a2, err = values2
                # now -pi/2 < z < pi/2. A negative x moves it to the opposite quadrant
                if not (x < 0.0)
                    return a2.to[B64](err)
                pi: CmF64Atan2Tint = cm_b64_atan2_pi(2)
                if a2.sgn == 0
                    # -(pi - z)
                    neg: CmF64Atan2Tint = CmF64Atan2Tint(hm: a2.hm, l: a2.l, ex: a2.ex, sgn: 1)
                    s: CmF64Atan2Tint = cm_b64_atan2_add(a: pi, b: neg)
                    return CmF64Atan2Tint.to[B64](CmF64Atan2Tint(hm: s.hm, l: s.l, ex: s.ex, sgn: 1), 266)
                else
                    return CmF64Atan2Tint.to[B64](cm_b64_atan2_add(a: a2, b: pi), 266)

### The tint pi (ex = 2) or pi/2 (ex = 1), with error below 2^-196.
### :param ex: 2 for pi, 1 for pi/2.
### :returns: The tint.
routine cm_b64_atan2_pi(ex: S64) -> CmF64Atan2Tint
    hm: U128 = 0xC90FDAA22168C234C4C6628B80DC1CD1
    return CmF64Atan2Tint(hm: hm, l: 0x29024E088A67CC74, ex: ex, sgn: 0)

### Coefficient i of the numerator polynomial P.
### :param i: The coefficient's index.
### :returns: The coefficient as a tint.
routine cm_b64_atan2_p(i: USize) -> CmF64Atan2Tint
    ph: U128 = CM_B64_ATAN2_PH.getitem(i).to[U128]()
    hm: U128 = (ph << 64) | CM_B64_ATAN2_PM.getitem(i).to[U128]()
    return CmF64Atan2Tint(hm: hm, l: CM_B64_ATAN2_PL.getitem(i), ex: CM_B64_ATAN2_PEX.getitem(i), sgn: CM_B64_ATAN2_PSGN.getitem(i))

### Coefficient i of the denominator polynomial Q.
### :param i: The coefficient's index.
### :returns: The coefficient as a tint.
routine cm_b64_atan2_q(i: USize) -> CmF64Atan2Tint
    qh: U128 = CM_B64_ATAN2_QH.getitem(i).to[U128]()
    hm: U128 = (qh << 64) | CM_B64_ATAN2_QM.getitem(i).to[U128]()
    return CmF64Atan2Tint(hm: hm, l: CM_B64_ATAN2_QL.getitem(i), ex: CM_B64_ATAN2_QEX.getitem(i), sgn: CM_B64_ATAN2_QSGN.getitem(i))

### The product of two tints, with error below 10 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
routine cm_b64_atan2_mul(a: CmF64Atan2Tint, b: CmF64Atan2Tint) -> CmF64Atan2Tint
    mask: U128 = 0xFFFFFFFFFFFFFFFF
    ah: U128 = a.hm >> 64
    am: U128 = a.hm & mask
    al: U128 = a.l.to[U128]()
    bh: U128 = b.hm >> 64
    bm: U128 = b.hm & mask
    bl: U128 = b.l.to[U128]()
    rh: U128 = ah *% bh
    rm1: U128 = ah *% bm
    rm2: U128 = am *% bh
    rl1: U128 = ah *% bl
    rl2: U128 = am *% bm
    rl3: U128 = al *% bh
    h0: U64 = (rh >> 64).to[U64]()
    m0: U64 = rh.to_wrap[U64]()
    # accumulate rm1
    l0: U64 = rm1.to_wrap[U64]()
    t1: U64 = (rm1 >> 64).to[U64]()
    m1: U64 = m0 +% t1
    h1: U64 = when
        m1 < t1 => h0 +% 1
        else => h0
    # accumulate rm2
    l2: U64 = rm2.to_wrap[U64]()
    t2: U64 = (rm2 >> 64).to[U64]()
    l1: U64 = l0 +% l2
    cm0: U64 = (l1 < l2).to[U64]()
    m2: U64 = m1 +% t2
    h2: U64 = when
        m2 < t2 => h1 +% 1
        else => h1
    # accumulate rl1 + rl2 + rl3
    sl12: U128 = (rl1 >> 64) +% (rl2 >> 64)
    sl: U128 = sl12 +% (rl3 >> 64)
    l3: U64 = sl.to_wrap[U64]()
    cm1: U64 = cm0 +% (sl >> 64).to[U64]()
    lf: U64 = l1 +% l3
    cm: U64 = when
        lf < l3 => cm1 +% 1
        else => cm1
    # accumulate cm
    m: U64 = m2 +% cm
    h: U64 = when
        m < cm => h2 +% 1
        else => h2
    ex: S64 = a.ex + b.ex
    sgn: U64 = a.sgn ^ b.sgn
    norm: Bool = h >> 63 == 0
    hm: U128 = cm_b64_atan2_words(h, m)
    if not norm
        return CmF64Atan2Tint(hm: hm, l: lf, ex: ex, sgn: sgn)
    hn: U64 = (h << 1) | (m >> 63)
    mn: U64 = (m << 1) | (lf >> 63)
    return CmF64Atan2Tint(hm: cm_b64_atan2_words(h: hn, m: mn), l: lf << 1, ex: ex - 1, sgn: sgn)

### The top two significand words of a tint joined into its `hm`.
### :param h: The top significand word.
### :param m: The middle significand word.
### :returns: `h` 2^64 + `m`.
routine cm_b64_atan2_words(h: U64, m: U64) -> U128
    hi_word: U128 = h.to[U128]() << 64
    return hi_word | m.to[U128]()

### Compares |a| with |b|: -1, 0 or 1.
### :param a: The first tint.
### :param b: The second tint.
### :returns: -1 when |`a`| < |`b`|, 0 when they are equal, 1 when |`a`| > |`b`|.
routine cm_b64_atan2_cmp_abs(a: CmF64Atan2Tint, b: CmF64Atan2Tint) -> S64
    az: Bool = a.hm >> 64 == 0
    bz: Bool = b.hm >> 64 == 0
    when
        az => return if bz then 0 else -1
        bz => return 1
        else =>
            when
                a.ex > b.ex => return 1
                a.ex < b.ex => return -1
                a.hm > b.hm => return 1
                a.hm < b.hm => return -1
                a.l > b.l => return 1
                a.l < b.l => return -1
                else => return 0

### A 192-bit significand shifted right by k bits.
### :param h: The top 128 bits.
### :param l: The low 64 bits.
### :param k: The shift amount (192 or more gives 0).
### :returns: The shifted significand.
routine cm_b64_atan2_rshift(h: U128, l: U64, k: U64) -> CmF64Atan2Sig
    local k128: U128 = k.to[U128]()

    when
        k == 0 => return CmF64Atan2Sig(h: h, l: l)
        k < 64 =>
            hi_bits: U64 = (h << U128.sub(64, k128)).to_wrap[U64]()
            lo: U64 = hi_bits | (l >> k)
            return CmF64Atan2Sig(h: h >> k128, l: lo)
        k == 64 => return CmF64Atan2Sig(h: h >> 64, l: h.to_wrap[U64]())
        k < 128 => return CmF64Atan2Sig(h: h >> k128, l: (h >> k128 - 64).to_wrap[U64]())
        k < 192 => return CmF64Atan2Sig(h: 0, l: (h >> k128 - 64).to_wrap[U64]())
        else => return CmF64Atan2Sig(h: 0, l: 0)

### A 192-bit significand shifted left by k bits.
### :param h: The top 128 bits.
### :param l: The low 64 bits.
### :param k: The shift amount (192 or more gives 0).
### :returns: The shifted significand.
routine cm_b64_atan2_lshift(h: U128, l: U64, k: U64) -> CmF64Atan2Sig
    local k128: U128 = k.to[U128]()

    wl: U128 = l.to[U128]()
    when
        k == 0 => return CmF64Atan2Sig(h: h, l: l)
        k < 64 =>
            hi: U128 = (h << k128) | (l >> U64.sub(64, k)).to[U128]()
            return CmF64Atan2Sig(h: hi, l: l << k)
        k == 64 => return CmF64Atan2Sig(h: (h << 64) | wl, l: 0)
        k < 128 => return CmF64Atan2Sig(h: (h << k128) | (wl << k128 - 64), l: 0)
        k < 192 => return CmF64Atan2Sig(h: wl << k128 - 64, l: 0)
        else => return CmF64Atan2Sig(h: 0, l: 0)

### The leading zero count of a 192-bit significand.
### :param h: The top 128 bits.
### :param l: The low 64 bits.
### :returns: The number of leading zero bits.
routine cm_b64_atan2_clz(h: U128, l: U64) -> U64
    if h != 0
        return h.leading_zeros().to[U64]()
    else
        return l.leading_zeros() + 128

### The sum of two tints, with error below 2 ulps.
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
routine cm_b64_atan2_add(a: CmF64Atan2Tint, b: CmF64Atan2Tint) -> CmF64Atan2Tint
    c: S64 = cm_b64_atan2_cmp_abs(a, b)
    when c
        0 => jump equal()
        -1 => jump ordered(b, a)
        else => jump ordered(a, b)

    # |a| = |b|: 0 or 2 a, exactly
    block equal()
        if a.sgn ^ b.sgn != 0
            return CmF64Atan2Tint(hm: 0, l: 0, ex: -1076, sgn: 0)
        else
            return CmF64Atan2Tint(hm: a.hm, l: a.l, ex: a.ex + 1, sgn: a.sgn)

    # |u| > |v|, thus u.ex >= v.ex
    block ordered(u: CmF64Atan2Tint, v: CmF64Atan2Tint)
        sh: U64 = u.ex.to_wrap[U64]() -% v.ex.to_wrap[U64]()
        t: CmF64Atan2Sig = cm_b64_atan2_rshift(h: v.hm, l: v.l, k: sh)
        if u.sgn ^ v.sgn != 0
            jump subtract(u, v, sh, t)
        else
            jump sum(u, t)

    block subtract(u: CmF64Atan2Tint, v: CmF64Atan2Tint, sh: U64, t: CmF64Atan2Sig)
        tl: U64 = u.l -% t.l
        th0: U128 = u.hm -% t.h
        th: U128 = when
            tl > u.l => th0 -% 1
            else => th0
        ex: U64 = cm_b64_atan2_clz(h: th, l: tl)
        if not (ex <= 1 or sh == 0)
            jump exact(u, v, sh, ex)
        r: CmF64Atan2Sig = cm_b64_atan2_lshift(h: th, l: tl, k: ex)
        return CmF64Atan2Tint(hm: r.h, l: r.l, ex: u.ex - ex.to[S64](), sgn: u.sgn)

    # ex >= 2 and sh >= 1: redo the subtraction without neglecting the low part of v
    block exact(u: CmF64Atan2Tint, v: CmF64Atan2Tint, sh: U64, ex: U64)
        t2: CmF64Atan2Sig = cm_b64_atan2_lshift(h: v.hm, l: v.l, k: ex -% sh)
        r0: CmF64Atan2Sig = cm_b64_atan2_lshift(h: u.hm, l: u.l, k: ex)
        ul: U64 = r0.l -% t2.l
        uh0: U128 = r0.h -% t2.h
        uh: U128 = when
            ul > r0.l => uh0 -% 1
            else => uh0
        ex1: U64 = cm_b64_atan2_clz(h: uh, l: ul)
        r1: CmF64Atan2Sig = cm_b64_atan2_lshift(h: uh, l: ul, k: ex1)
        return CmF64Atan2Tint(hm: r1.h, l: r1.l, ex: u.ex - (ex + ex1).to[S64](), sgn: u.sgn)

    block sum(u: CmF64Atan2Tint, t: CmF64Atan2Sig)
        rl: U64 = u.l +% t.l
        cl: U128 = (rl < u.l).to[U128]()
        rh0: U128 = u.hm +% t.h
        ch0: U128 = (rh0 < u.hm).to[U128]()
        rh: U128 = rh0 +% cl
        ch: U128 = when
            rh < cl => ch0 +% 1
            else => ch0
        if not (ch != 0)
            return CmF64Atan2Tint(hm: rh, l: rl, ex: u.ex, sgn: u.sgn)
        carry_bit: U64 = (rh << 63).to_wrap[U64]()
        rl2: U64 = carry_bit | (rl >> 1)
        rh2: U128 = (ch << 127) | (rh >> 1)
        return CmF64Atan2Tint(hm: rh2, l: rl2, ex: u.ex + 1, sgn: u.sgn)

### The tint equal to a finite non-zero B64.
### :returns: `me` as a tint.
routine B64.to[CmF64Atan2Tint](me: Me) -> CmF64Atan2Tint
    local u: U64 = me.bits()
    local sgn: U64 = u >> 63
    local ax: U64 = u & 0x7FFFFFFFFFFFFFFF

    e: U64 = ax >> 52
    if not (e != 0)
        lz: U64 = ax.leading_zeros()
        hs: U64 = ax << lz
        return CmF64Atan2Tint(hm: hs.to[U128]() << 64, l: 0, ex: S64.sub(-1010, lz.to[S64]()), sgn: sgn)
    else
        hn: U64 = (ax << 11) | 0x8000000000000000
        return CmF64Atan2Tint(hm: hn.to[U128]() << 64, l: 0, ex: e.to[S64]() - 0x3FE, sgn: sgn)

### A tint rounded to the nearest B64. err is 0 to convert a tint that holds a B64
### exactly, and otherwise a bound in ulps on the error of the low word.
### :param err: 0 for an exact tint, else the error bound in ulps of the low word.
### :returns: The rounded B64.
routine CmF64Atan2Tint.to[B64](me: Me, err: U64) -> B64
    local sgn: U64 = me.sgn
    local ex: S64 = me.ex
    local hh: U64 = (me.hm >> 64).to[U64]()
    local mm: U64 = me.hm.to_wrap[U64]()
    local ll: U64 = me.l

    over: Bool = ex >= 1025  # |me| >= 2^1024
    under: Bool = ex <= -1074  # |me| < 2^-1074
    when
        over => return B64.from_bits((sgn << 63) | 0x7FF0000000000000)
        under => jump underflow()
        ex <= -1022 => jump subnormal()
        else => jump round(ex, hh, mm, ll)

    # below 2^-1075 to zero, exactly 2^-1075 to zero (ties to even), above to 2^-1074
    block underflow()
        small: Bool = ex < -1074
        top_only: Bool = hh == 0x8000000000000000 and mm == 0
        when
            small => return B64.from_bits(sgn << 63)
            top_only and ll == 0 => return B64.from_bits(sgn << 63)
            else => return B64.from_bits((sgn << 63) | 1)

    # shift the significand to the subnormal quantum, keeping a sticky bit
    block subnormal()
        sh: U64 = S64.sub(-1021, ex).to[U64]()  # 1 <= sh <= 52
        c: U64 = U64.sub(64, sh)
        sticky: U64 = (ll > 0).to[U64]()
        ll1: U64 = (mm << c) | (ll >> sh)
        ll2: U64 = ll1 | sticky
        jump round(ex + sh.to[S64](), hh >> sh, (hh << c) | (mm >> sh), ll2)

    block round(ex_round: S64, hh_round: U64, mm_round: U64, ll_round: U64)
        low: U64 = hh_round & 0x7FF
        h: B64 = (hh_round >> 11).to[B64]()
        zero: Bool = err == 0
        below: Bool = low < 0x400
        above: Bool = low > 0x400
        middle: Bool = mm_round == 0 and ll_round == 0
        # 0.25 rounds toward zero, 0.75 away, 0.5 is the exact middle
        lmid: B64 = when
            middle => 0.5
            else => 0.75
        lhigh: B64 = when
            above => 0.75
            else => lmid
        lround: B64 = when
            below => 0.25
            else => lhigh
        l: B64 = when
            zero => 0.0
            else => lround
        sg: B64 = when
            sgn != 0 => -1.0
            else => 1.0
        hr: B64 = B64.mul_add(l, a: sg, b: sg * h) * 2.220446049250313e-16
        # now -1021 <= ex_round <= 1024, so 2^(ex_round - 1) is a normal number
        exp_field: U64 = (ex_round - 1).to_wrap[U64]()
        scale: B64 = B64.from_bits(U64.add_wrap(0x3FF0000000000000, exp_field << 52))
        return hr * scale

### An approximation of 1/a, with absolute error below 2^-103.9 when 1 <= 1/a <= 2.
### :param a: The tint to invert.
### :returns: The approximation of 1/`a`.
routine cm_b64_atan2_inv(a: CmF64Atan2Tint) -> CmF64Atan2Tint
    d0: B64 = a.to[B64](0)  # exact
    subnormal: Bool = d0.abs() < 2.2250738585072014e-308
    d: B64 = when
        subnormal => d0 * 9007199254740992.0
        else => d0
    r0: CmF64Atan2Tint = B64.to[CmF64Atan2Tint](B64.div(1.0, d))
    rex: S64 = when
        subnormal => r0.ex + 53
        else => r0.ex
    r: CmF64Atan2Tint = CmF64Atan2Tint(hm: r0.hm, l: r0.l, ex: rex, sgn: r0.sgn)
    # one Newton step r + r (1 - a r)
    ar: CmF64Atan2Tint = cm_b64_atan2_mul(a, b: r)
    nar: CmF64Atan2Tint = CmF64Atan2Tint(hm: ar.hm, l: ar.l, ex: ar.ex, sgn: U64.sub_wrap(1, ar.sgn))
    one: CmF64Atan2Tint = CmF64Atan2Tint(hm: 0x80000000000000000000000000000000, l: 0, ex: 1, sgn: 0)
    e: CmF64Atan2Tint = cm_b64_atan2_add(a: one, b: nar)
    return cm_b64_atan2_add(a: r, b: cm_b64_atan2_mul(a: r, b: e))

### An approximation of b/a, with relative error below 2^-185.53.
### :param b: The dividend.
### :param a: The divisor.
### :returns: The approximation of `b`/`a`.
routine cm_b64_atan2_div(b: CmF64Atan2Tint, a: CmF64Atan2Tint) -> CmF64Atan2Tint
    y: CmF64Atan2Tint = cm_b64_atan2_inv(a)
    r: CmF64Atan2Tint = cm_b64_atan2_mul(a: y, b)
    # Karp-Markstein: r + y (b - a r)
    ar: CmF64Atan2Tint = cm_b64_atan2_mul(a, b: r)
    nar: CmF64Atan2Tint = CmF64Atan2Tint(hm: ar.hm, l: ar.l, ex: ar.ex, sgn: U64.sub_wrap(1, ar.sgn))
    e: CmF64Atan2Tint = cm_b64_atan2_add(a: b, b: nar)
    return cm_b64_atan2_add(a: r, b: cm_b64_atan2_mul(a: y, b: e))
