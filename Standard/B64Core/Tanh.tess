# Tessera stdlib: the correctly rounded hyperbolic tangent of B64
#
# For |x| < 1/4 an odd polynomial, redone in double-double when its error bound can't decide the rounding.
# Otherwise tanh |x| = 1 - 2 / (1 + e^(2|x|)) = 2 (1/2 - e^(-2|x|) / (1 + e^(-2|x|))), with e^(-2|x|) from the
# tables of HypShared.tess and a short polynomial, checked with an error bound. The accurate path evaluates
# the exponential and the quotient in double-double and looks the few hardest arguments up in a table of
# exact values. Past |x| ~ 19.06 the result rounds to ±1.
# Round to nearest only: ±inf give ±1, NaN comes back quiet, ±0 map to themselves.
#
# Ported from CORE-MATH, src/binary64/tanh/tanh.c via RazorForge's B64Tanh.rf.
# Copyright (c) 2023-2026 Alexei Sibidanov, Cyprien Peignier, Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### Hard-to-round arguments |x| (sorted), as B64 bits.
preset CM_B64_TANH_DB_X: @Array[U64, 12] <- [0x3FCAC343B179FEC4, 0x3FD00764A988BF73,
    0x3FD17D1E8A63711F, 0x3FD291C601A05276, 0x3FD36F33D51C264D, 0x3FD43EAEA23649C3,
    0x3FDD88D7550B2826, 0x3FDE611AA58AB608, 0x3FE01EFE7AC8C15D, 0x3FE1005EC0BCCABB,
    0x3FE33DFEB0FA4BFE, 0x3FE49F24AC5CAC35]

### The high parts of tanh |x| for those arguments, as B64 bits.
preset CM_B64_TANH_DB_H: @Array[U64, 12] <- [0x3FCA612499C53078, 0x3FCF676484C0703B,
    0x3FD110E96A6C2D96, 0x3FD210B7D0C03743, 0x3FD2DBB7B1C91363, 0x3FD39877ED028641,
    0x3FDB9A3637366AFD, 0x3FDC493DC899E4A6, 0x3FDDC3FE1B524821, 0x3FDF20B1C8557DED,
    0x3FE1372F9EE76E99, 0x3FE22C495FF06104]

### The low parts, as B64 bits.
preset CM_B64_TANH_DB_L: @Array[U64, 12] <- [0x3C60000000000000, 0xB970000000000000,
    0xB960000000000000, 0x3C70000000000000, 0xB950000000000000, 0xBC80000000000000,
    0x3C70000000000000, 0xBC80000000000000, 0xB970000000000000, 0xBC80000000000000,
    0x3C80000000000000, 0xB970000000000000]

### tanh me, correctly rounded.
### :returns: tanh `me`, correctly rounded.
routine B64.tanh(me: Me) -> Me
    local ax: Me = me.abs()
    local aix: U64 = ax.bits()

    # |x| >= 0x1.30fc1931f09cap+4: tanh x rounds to ±1
    if aix >= 0x40330FC1931F09CA
        jump saturated()
    # t = round(-2|x| 2^12 / log 2) and its bits: e^(-2|x|) = 2^ie 2^(i0/64) 2^(i1/2^12) e^dx
    v0: Me = ax.mul_add(a: -11818.557774962388, b: 50331648.5)
    jt: U64 = v0.bits()
    t: Me = Me.from_bits(jt & 0xFFFFFFFFF8000000) - 50331648.0
    slot1: U64 = (jt >> 27) & 0x3F
    i1: USize = slot1.to[USize]()
    slot0: U64 = (jt >> 33) & 0x3F
    i0: USize = slot0.to[USize]()
    exp_signed: S64 = (jt << 13).to_wrap[S64]()
    ie: S64 = exp_signed >> 52
    sp: Me = cm_b64_hyp_scale(ie + 1023)
    two: Me = Me.copysign(2.0, me)
    below: Bool = aix < 0x400D76C8B4395810  # |x| < ~3.683
    # |x| < 1/4
    when
        aix < 0x3FD0000000000000 => jump small()
        below => jump medium(t, i0, i1, sp, two)
        else => jump large(t, i0, i1, sp, two)

    block saturated()
        nan: Bool = aix > 0x7FF0000000000000
        infinite: Bool = aix == 0x7FF0000000000000
        f: Me = Me.copysign(1.0, me)
        when
            nan => return me + me
            infinite => return f
            else => return f - Me.copysign(2.7755575615628914e-17, me)

    block small()
        zero: Bool = aix == 0
        # |x| <= 0x1.d12ed0af1a27fp-27
        when
            zero => return me
            aix <= 0x3E4D12ED0AF1A27F => return me.mul_add(a: -2.7755575615628914e-17, b: me)
            else => jump series()

    block series()
        x2: Me = me * me
        x3: Me = x2 * me
        x4: Me = x2 * x2
        x8: Me = x4 * x4
        a1: Me = x2 * 0.003591725367929998 + -0.008863221769815069
        b1: Me = x2 * 0.0005287354884097332 + -0.001449063961717272
        p1: Me = x4 * b1 + a1
        a0: Me = x2 * 0.13333333333332006 + -0.3333333333333333
        b0: Me = x2 * 0.021869488267393555 + -0.053968253965448285
        p0: Me = x4 * b0 + a0
        p: Me = (p0 + x8 * p1) * x3
        r: CmF64HypDd = cm_b64_hyp_fasttwosum(x: me, y: p)
        e: Me = x3 * 3.885780586188048e-16
        lb: Me = r.hi + (r.lo - e)
        ub: Me = r.hi + (r.lo + e)
        if lb == ub
            return lb
        else
            return cm_b64_tanh_zero(me)

    # 1/4 <= |x| < ~3.683: tanh |x| = 2 (1/2 - r / (1 + r)) with r = e^(-2|x|)
    block medium(t: Me, i0: USize, i1: USize, sp: Me, two: Me)
        tt: CmF64HypDd = cm_b64_hyp_table(i0, i1)
        th: Me = tt.hi * sp
        tl: Me = tt.lo * sp
        # -2|x| = t log(2) / 2^12 + dx, with log(2) / 2^13 as l2h + l2l
        dx_hi: Me = t * -8.461269294457452e-05 - ax
        dx: Me = dx_hi - t * -5.128070157081402e-15
        dx2: Me = dx * dx
        p: Me = cm_b64_tanh_poly(d: dx, d2: dx2)
        r: CmF64HypDd = cm_b64_hyp_fasttwosum(x: th, y: tl + th * p)
        q: CmF64HypDd = cm_b64_hyp_fasttwosum(x: 1.0, y: r.hi)
        ql: Me = r.lo + q.lo
        rqh: Me = Me.div(1.0, q.hi)
        rq_err: Me = ql * rqh + rqh.mul_add(a: q.hi, b: -1.0)
        rql: Me = rq_err * -rqh
        pp: CmF64HypDd = cm_b64_tanh_muldd_acc(xh: r.hi, xl: r.lo, ch: rqh, cl: rql)
        e: Me = r.hi * 2.278518628114068e-19
        d: CmF64HypDd = cm_b64_tanh_fasttwosub(x: 0.5, y: pp.hi)
        dh: Me = d.hi * two
        dl: Me = (d.lo - pp.lo) * two
        lb: Me = dh + (dl - e)
        ub: Me = dh + (dl + e)
        if lb == ub
            return lb
        else
            jump accurate(t, th, tl, two)

    # ~3.683 <= |x| < 0x1.30fc1931f09cap+4: tanh |x| = 1 - 2r / (1 + r) with r = e^(-2|x|)
    block large(t: Me, i0: USize, i1: USize, sp: Me, two: Me)
        t0h: Me = Me.from_bits(CM_B64_HYP_T0_HI.getitem(i0))
        t1h: Me = Me.from_bits(CM_B64_HYP_T1_HI.getitem(i1))
        dx: Me = Me.mul_add(-8.461269293944645e-05, a: t, b: -ax)
        dx2: Me = dx * dx
        p: Me = cm_b64_tanh_poly(d: dx, d2: dx2)
        rh0: Me = t0h * t1h * sp
        rh1: Me = rh0 + (p + Me.mul(6.591949208711867e-17, ax)) * rh0
        e: Me = rh1 * 1.887379141862766e-15
        rh2: Me = Me.mul(2.0, rh1) / Me.add(1.0, rh1)
        one: Me = Me.copysign(1.0, me)
        rh: Me = rh2.copysign(me)
        lb: Me = one - (rh + e)
        ub: Me = one - (rh - e)
        if lb == ub
            return lb
        else
            jump large_accurate(t, i0, i1, sp, two)

    block large_accurate(t: Me, i0: USize, i1: USize, sp: Me, two: Me)
        tt: CmF64HypDd = cm_b64_hyp_table(i0, i1)
        jump accurate(t, tt.hi * sp, tt.lo * sp, two)

    # tanh |x| = 2 (1/2 - r / (1 + r)) in double-double, with r = e^(-2|x|) = th + tl times the polynomial
    block accurate(t: Me, th: Me, tl: Me, two: Me)
        r: CmF64HypDd = cm_b64_tanh_exp_accurate(x: Me.mul(-2.0, ax), t, th, tl)
        q0: CmF64HypDd = cm_b64_hyp_fasttwosum(x: 1.0, y: r.hi)
        q: CmF64HypDd = cm_b64_hyp_fasttwosum(x: q0.hi, y: r.lo + q0.lo)
        rqh: Me = Me.div(1.0, q.hi)
        rq_err: Me = q.lo * rqh + rqh.mul_add(a: q.hi, b: -1.0)
        rql: Me = rq_err * -rqh
        pp: CmF64HypDd = cm_b64_tanh_muldd_acc(xh: r.hi, xl: r.lo, ch: rqh, cl: rql)
        d0: CmF64HypDd = cm_b64_tanh_fasttwosub(x: 0.5, y: pp.hi)
        d: CmF64HypDd = cm_b64_hyp_fasttwosum(x: d0.hi, y: d0.lo - pp.lo)
        res: Me = two * d.hi + two * d.lo
        dl_near: U64 = d.lo.bits() +% 32
        if dl_near & 0x000FFFFFFFFFFFFF < 65
            return cm_b64_tanh_database(x: me, f: res)
        else
            return res

### The fast-path polynomial e^d - 1 ~ d ((2 + 2d) + d2 (c2 + d c3)) of tanh (scaled by 2), with d2 = d^2.
### :param d: The reduced argument.
### :param d2: `d` squared.
### :returns: The polynomial's value, about 2 (e^`d` - 1).
private routine cm_b64_tanh_poly(d: B64, d2: B64) -> B64
    a: B64 = d * 2.0 + 2.0
    b: B64 = d * 0.6666666664683292 + 1.3333333339299427
    return d * (d2 * b + a)

### x - y as hi + lo exactly, when |x| >= |y|.
### :param x: The minuend, at least as large as `y` in magnitude.
### :param y: The subtrahend.
### :returns: The exact difference as a double-double.
private routine cm_b64_tanh_fasttwosub(x: B64, y: B64) -> CmF64HypDd
    s: B64 = x - y
    z: B64 = x - s
    e: B64 = z - y
    return CmF64HypDd(hi: s, lo: e)

### The double-double product (xh + xl) (ch + cl), renormalized.
### :param xh: The high part of the double-double.
### :param xl: The low part of the double-double.
### :param ch: The high part of the other factor.
### :param cl: The low part of the other factor.
### :returns: The product as a double-double.
private routine cm_b64_tanh_muldd_acc(xh: B64, xl: B64, ch: B64, cl: B64) -> CmF64HypDd
    plh: B64 = xl * ch
    phl: B64 = xh * cl
    phh: B64 = xh * ch
    rest: B64 = b64_mul_error(x: xh, y: ch, p: phh) + (phl + plh)
    return cm_b64_hyp_fasttwosum(x: phh, y: rest)

### The double-double times double product (xh + xl) c, renormalized.
### :param xh: The high part of the double-double.
### :param xl: The low part of the double-double.
### :param c: The B64 factor.
### :returns: The product as a double-double.
private routine cm_b64_tanh_mulddd_acc(xh: B64, xl: B64, c: B64) -> CmF64HypDd
    pl: B64 = xl * c
    ph: B64 = xh * c
    rest: B64 = b64_mul_error(x: xh, y: c, p: ph) + pl
    return cm_b64_hyp_fasttwosum(x: ph, y: rest)

### One Horner step of a double-double polynomial with the renormalizing product: `value` `x` + `c`.
### :param x: The point, as a double-double.
### :param value: The polynomial so far, as a double-double.
### :param c: The next coefficient, as a double-double.
### :returns: The polynomial after this step, as a double-double.
private routine cm_b64_tanh_polydd_step(x: CmF64HypDd, value: CmF64HypDd,
    c: CmF64HypDd) -> CmF64HypDd
    p: CmF64HypDd = cm_b64_tanh_muldd_acc(xh: x.hi, xl: x.lo, ch: value.hi, cl: value.lo)
    s: CmF64HypDd = cm_b64_hyp_fasttwosum(x: c.hi, y: p.hi)
    l: B64 = p.lo + c.lo + s.lo
    return CmF64HypDd(hi: s.hi, lo: l)

### Accurate exp(x) as a double-double, given t = round(x 2^12 / log 2) as a B64 and the scaled table value
### th + tl. It is cm_b64_hyp_exp_accurate with the renormalizing products.
### :param x: The argument.
### :param t: round(`x` 2^12 / log 2), as a B64.
### :param th: The high part of the scaled table value.
### :param tl: The low part of the scaled table value.
### :returns: exp(`x`) as a double-double.
private routine cm_b64_tanh_exp_accurate(x: B64, t: B64, th: B64, tl: B64) -> CmF64HypDd
    dx: B64 = x - t * 0.00016922538588914904
    dxl0: B64 = t * 1.0256140314162804e-14
    dxll: B64 = t * 3.2042720746546034e-31 + t.mul_add(a: 1.0256140314162804e-14, b: -dxl0)
    dxh: B64 = dx + dxl0
    dx_err: B64 = dx - dxh + dxl0
    dxl: B64 = dx_err + dxll
    dxdd: CmF64HypDd = (hi: dxh, lo: dxl)
    tail: B64 = dxh * 0.0013888888882434365 + 0.008333333338507347
    fl: B64 = dxh * (dxh * tail + 0.041666666666666664)
    p3: CmF64HypDd = cm_b64_hyp_polydd_init(l: fl, c_hi: 0.16666666666666666, c_lo: 9.213309146126262e-18)
    p2: CmF64HypDd = cm_b64_tanh_polydd_step(x: dxdd, value: p3, c: CmF64HypDd(hi: 0.5, lo: -1.523885870582321e-28))
    p1: CmF64HypDd = cm_b64_tanh_polydd_step(x: dxdd, value: p2, c: CmF64HypDd(hi: 1.0, lo: 7.180385960686095e-29))
    p0: CmF64HypDd = cm_b64_tanh_muldd_acc(xh: dxh, xl: dxl, ch: p1.hi, cl: p1.lo)
    f: CmF64HypDd = cm_b64_tanh_muldd_acc(xh: th, xl: tl, ch: p0.hi, cl: p0.lo)
    zh: B64 = th + f.hi
    zl: B64 = th - zh + f.hi
    uh: B64 = zh + tl
    uh_err: B64 = zh - uh + tl
    ul: B64 = uh_err + zl
    vh: B64 = uh + f.lo
    vh_err: B64 = uh - vh + f.lo
    vl: B64 = vh_err + ul
    return CmF64HypDd(hi: vh, lo: vl)

### The accurate path of tanh for 0x1.d12ed0af1a27fp-27 < |x| < 1/4: a double-double odd polynomial.
### :param x: The argument.
### :returns: tanh `x`, correctly rounded.
private routine cm_b64_tanh_zero(x: B64) -> B64
    x2: B64 = x * x
    x2l: B64 = b64_mul_error(x, y: x, p: x2)
    x2dd: CmF64HypDd = (hi: x2, lo: x2l)
    c0: B64 = x2 * 2.1673633623487625e-06 + -6.360840639260085e-06
    c1: B64 = x2 * c0 + 1.590775186439605e-05
    c2: B64 = x2 * c1 + -3.927741240271311e-05
    y2: B64 = x2 * (x2 * c2 + 9.691532755754035e-05)
    p19: CmF64HypDd = cm_b64_hyp_polydd_init(l: y2, c_hi: -0.00023912911212249058, c_lo: -1.1938491442160294e-20)
    p17: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p19, c: CmF64HypDd(hi: 0.0005900274408832999, lo: -5.0907881059533396e-20))
    p15: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p17, c: CmF64HypDd(hi: -0.0014558343870500075, lo: -4.528021102697416e-20))
    p13: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p15, c: CmF64HypDd(hi: 0.0035921280365724616, lo: -3.90923225015485e-20))
    p11: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p13, c: CmF64HypDd(hi: -0.008863235529902196, lo: -7.74871507811202e-19))
    p9: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p11, c: CmF64HypDd(hi: 0.021869488536155203, lo: -1.7506565827004166e-19))
    p7: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p9, c: CmF64HypDd(hi: -0.05396825396825397, lo: 2.555280216203743e-18))
    p5: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p7, c: CmF64HypDd(hi: 0.13333333333333333, lo: 1.8503716978873156e-18))
    p3: CmF64HypDd = cm_b64_tanh_polydd_step(x: x2dd, value: p5, c: CmF64HypDd(hi: -0.3333333333333333, lo: -1.8503717077079184e-17))
    px: CmF64HypDd = cm_b64_tanh_mulddd_acc(xh: p3.hi, xl: p3.lo, c: x)
    p: CmF64HypDd = cm_b64_tanh_muldd_acc(xh: px.hi, xl: px.lo, ch: x2, cl: x2l)
    s0: CmF64HypDd = cm_b64_hyp_fasttwosum(x, y: p.hi)
    s1: CmF64HypDd = cm_b64_hyp_fasttwosum(x: s0.lo, y: p.lo)
    y1: B64 = cm_b64_hyp_nudge(y1: s1.hi, y2: s1.lo)
    r: B64 = s0.hi + y1
    # the one argument whose nudged sum still rounds the wrong way
    mantissa: U64 = s1.hi.bits() & 0x000FFFFFFFFFFFFF
    pow2: Bool = mantissa == 0
    if pow2 and x.abs() == 0.2090839974007307
        return cm_b64_tanh_database(x, f: r)
    else
        return r

### The exact tanh x for the arguments the fast and accurate paths can't round, or f for any other x.
### :param x: The argument.
### :param f: The result to return when `x` isn't listed.
### :returns: The listed tanh `x`, or `f`.
private routine cm_b64_tanh_database(x: B64, f: B64) -> B64
    while a <= b with a: S64 = 0, b: S64 = 11
        m: S64 = (a + b) / 2
        mu: USize = m.to[USize]()
        key: B64 = B64.from_bits(CM_B64_TANH_DB_X.getitem(mu))
        ax: B64 = x.abs()
        below: Bool = key < ax
        when
            below => continue with a: m + 1, b: b
            key == ax =>
                sgn: B64 = B64.copysign(1.0, x)
                h: B64 = B64.from_bits(CM_B64_TANH_DB_H.getitem(mu))
                l: B64 = B64.from_bits(CM_B64_TANH_DB_L.getitem(mu))
                return sgn * h + sgn * l
            else => continue with a: a, b: m - 1
    then
        return f
