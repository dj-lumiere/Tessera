# Tessera stdlib: the correctly rounded cosine of B64
#
# The fast path is the sine's (Sin.tess) a quarter turn further: cos x = sin(x + pi/2), and the sine's reductions
# give x as k steps of pi/2^14 plus a remainder, so the cosine is the sine's double-double evaluation at k + 2^13
# with the same remainder. Its error bound holds for every k, so the sine's rounding test decides the cosine too.
# When it can't, the accurate path reduces |x| to x/(2pi) mod 1 = i/2^11 + X (TrigReduce.tess), folds it into
# [0, pi/4] by the symmetries of the cosine, and evaluates in 128-bit floating point. Five arguments that path
# still can't round have their results written out. Round to nearest only: infinities give the default NaN (sign
# bit set, as x86's 0/0), a NaN comes back quiet.
#
# The fast path is ported from CORE-MATH, src/binary64/sin/sin.c, the accurate path from src/binary64/cos/cos.c via
# RazorForge's B64Cos.rf.
# Copyright (c) 2022-2026 Paul Zimmermann and Tom Hubrecht and Alexei Sibidanov
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The cosine of `me` (in radians), correctly rounded (to nearest). Infinities give the default NaN (sign bit
### set, as x86's 0/0), and a NaN comes back quiet.
### :returns: cos(`me`).
routine B64.cos(me: Me) -> Me
    local ux: U64 = me.bits()
    local ax: Me = Me.from_bits(ux & 0x7FFFFFFFFFFFFFFF)

    ebits: U64 = (ux >> 52) & 0x7FF
    if ebits == 0x7FF
        # |x| <= 0x1.6a09e667f3bccp-27: cos(x) rounds like 1 - x^2/2
        # an infinity gives the default NaN of an invalid operation, a NaN comes back quiet
        if ux << 1 == 0xFFE0000000000000
            return Me.from_bits(0xFFF8000000000000)
        else
            return me + me
    else
        if ax.bits() <= 0x3E46A09E667F3BCC
            return ax.mul_add(a: -0x1p-28, b: 1.0)
        if ebits < 1054
            # |x| < 2^31, a quarter turn is 2^13 steps of pi/2^14
            red: CmF64SinReduced = cm_b64_sin_reduce_moderate(ax)
            f: CmF64TrigDD = cm_b64_sin_moderate_parts(k: red.k + 0x2000, r: red.r)
            fl: Me = f.lo - 0x1.dep-64
            lb: Me = f.hi + fl
            ub: Me = f.hi + (fl + 0x1.dep-63)
            if ub == lb
                return lb
            else
                return cm_b64_cos_accurate(ax)
        else
            # |x| >= 2^31
            red: CmF64SinReduced = cm_b64_sin_reduce_large(ax)
            f: CmF64TrigDD = cm_b64_sin_large_parts(k: red.k + 0x2000, r: red.r)
            lb: Me = f.hi + (f.lo - 0x1.41p-63)
            ub: Me = f.hi + (f.lo + 0x1.41p-63)
            if lb == ub
                return lb
            else
                return cm_b64_cos_accurate(ax)

### The accurate path for x > 0x1.6a09e667f3bccp-27, in 128-bit floating point.
### :param x: The argument, |x| of the caller.
### :returns: cos(`x`), correctly rounded.
private routine cm_b64_cos_accurate(x: B64) -> B64
    local red: CmF64TrigAccurate = cm_b64_trig_accurate_reduce(x)
    local i: U64 = red.i
    local q: U64 = red.quadrant
    # pi <= x < 2pi: cos(x) = -cos(x - pi), and pi/2 <= x < pi: cos(x) = -sin(x - pi/2)
    local neg: U64 = (q & 1) ^ ((q >> 1) & 1)

    is_cos: U64 = U64.bitxor(1, (q >> 1) & 1)
    # pi/4 <= x < pi/2: cos(x) = sin(pi/2 - x)
    is_cos2: U64 = is_cos ^ ((q >> 2) & 1)
    is_sin: Bool = is_cos2 == 0
    u: CmF64TrigDint = when
        is_sin =>
            # sin2pi(R) ~ sin2pi(i/2^11) cos2pi(X) + cos2pi(i/2^11) sin2pi(X)
            u: CmF64TrigDint = cm_b64_trig_dint_mul(a: cm_b64_trig_s(i), b: red.cos)
            v: CmF64TrigDint = cm_b64_trig_dint_mul(a: cm_b64_trig_c(i), b: red.sin)
            becomes cm_b64_trig_dint_add(a0: u, b0: v)
        else =>
            # cos2pi(R) ~ cos2pi(i/2^11) cos2pi(X) - sin2pi(i/2^11) sin2pi(X)
            u: CmF64TrigDint = cm_b64_trig_dint_mul(a: cm_b64_trig_c(i), b: red.cos)
            v: CmF64TrigDint = cm_b64_trig_dint_mul(a: cm_b64_trig_s(i), b: red.sin)
            becomes cm_b64_trig_dint_add(a0: u, b0: cm_b64_trig_dint_neg(v))

    # the total error is below 41 ulps of the low word: check the upper 54 bits are determined
    if not cm_b64_trig_is_rounding_decided(r: u.r, err: 41)
        hard1: Bool = x == 0x1.8000000000009p-23
        hard2: Bool = x == 0x1.8000000000024p-22
        hard3: Bool = x == 0x1.800000000009p-21
        hard4: Bool = x == 0x1.20000000000f3p-20
        when
            hard1 => return B64.add(0x1.fffffffffff7p-1, 0x1.b56666666666cp-143)
            hard2 => return B64.add(0x1.ffffffffffdcp-1, 0x1.b56666666667ep-137)
            hard3 => return B64.add(0x1.ffffffffff7p-1, 0x1.b5666666666c4p-131)
            hard4 => return B64.add(0x1.fffffffffebcp-1, 0x1.37642666666fdp-127)
            x == 0x1.800000000024p-20 => return B64.add(0x1.fffffffffdcp-1, 0x1.b5666666667ddp-125)
            else => pass
    if neg != 0
        return CmF64TrigDint.to[B64](cm_b64_trig_dint_neg(u))
    else
        return u.to[B64]()
