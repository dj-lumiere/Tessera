# Tessera stdlib: the interrupt lines of an AArch64 board without an operating system, through an Arm GIC
#
# Devices and timers raise interrupts on numbered lines of the board's interrupt controller, and the controller passes
# one line at a time to the core, which goes to the CpuEventManager's IRQ entry. The interrupt lines are a resource the
# whole program shares, so InterruptManagerByGic manages them: it turns the controller on, holds one handler per line,
# turns lines on and off, and, when the core takes an interrupt, asks the controller which line it is, tells the
# controller the line is taken, and calls that line's handler. It works the GICv2 way: a distributor and a CPU
# interface, each at an address the board gives (QEMU's virt machine: 0x08000000 and 0x08010000).
#
# The manager tells the controller the line is taken before its handler runs, so a handler may switch to another
# thread (ThreadManagerByRoundRobin does on a timer tick) without leaving the controller waiting. Interrupts stay off
# on the core while a handler runs, so handlers never interrupt each other. A level line still raised once its handler
# returns comes again: the handler clears what raised it (the device's register, the timer's deadline).
#
# One manager runs at a time: start puts it in the CpuEventManager's interrupt slot, and stop puts the handler that
# was there back.
#
# The core's own interrupt mask (PSTATE.I) goes with it: mask_interrupts, unmask_interrupts, and
# restore_interrupts, for code that changes what an interrupt handler reads.

module Unhosted

### The manager that start put in the CpuEventManager's interrupt slot, null while none runs.
@target(arch: "aarch64", os: "none")
secret global RUNNING_GIC: &@InterruptManagerByGic

### How many lines the manager holds handlers for: the 16 software lines, the 16 lines of the core's own devices
### (its timers among them), and 96 lines of the board's devices.
@target(arch: "aarch64", os: "none")
preset GIC_LINES: U64 = 128

### The interrupt lines of a GICv2: a handler per line, called when the line raises an interrupt.
@target(arch: "aarch64", os: "none")
entity InterruptManagerByGic
    ### The distributor's registers: which lines are on, and where each goes.
    distributor: Addr
    ### The CPU interface's registers: which line came, and that it is taken.
    cpu_interface: Addr
    ### The handler of each line, by its number, null for none.
    handlers: Items[Addr, GIC_LINES]
    ### The handler that held the CpuEventManager's interrupt slot before start.
    before: Addr

### Makes the manager of the GICv2 whose distributor and CPU interface are at these addresses.
### :param distributor: The distributor's first register (GICD_CTLR).
### :param cpu_interface: The CPU interface's first register (GICC_CTLR).
### :returns: The manager, with no line on.
@target(arch: "aarch64", os: "none")
common routine InterruptManagerByGic.construct(distributor: Addr, cpu_interface: Addr) -> Me
    return Me(distributor, cpu_interface, handlers: .hollow(), before: .hollow())

### Turns the controller on and takes the CpuEventManager's interrupt slot: from now on an interrupt on a line goes to
### that line's handler. The lines themselves stay off until `turn_on`.
@target(arch: "aarch64", os: "none")
routine @InterruptManagerByGic.start() -> None
    # GICD_CTLR: forward interrupts. GICC_PMR: let every priority through. GICC_CTLR: signal them to the core.
    me.register(at: me.distributor.peek(), offset: 0x000).poke_volatile(1)
    me.register(at: me.cpu_interface.peek(), offset: 0x004).poke_volatile(0xFF)
    me.register(at: me.cpu_interface.peek(), offset: 0x000).poke_volatile(1)
    RUNNING_GIC.poke(me)
    before: Callable[(CpuEvent,), None] = CpuEventManager.when_interrupt_requested(gic_interrupt.to[Callable]())
    me.before.poke(before.addr())
    return

### Turns the controller off and puts the handler that held the CpuEventManager's interrupt slot before `start` back.
@target(arch: "aarch64", os: "none")
routine @InterruptManagerByGic.stop() -> None
    me.register(at: me.cpu_interface.peek(), offset: 0x000).poke_volatile(0)
    me.register(at: me.distributor.peek(), offset: 0x000).poke_volatile(0)
    before: Callable[(CpuEvent,), None] = bitcast(me.before.peek())
    CpuEventManager.when_interrupt_requested(before)
    RUNNING_GIC.poke(.hollow())
    return

### Puts `holder` in the slot of line `line`.
### :param line: The line's number, below GIC_LINES.
### :param holder: The handler, given the line's number, or `.hollow()` for none.
### :returns: The handler that held the line before, `.hollow()` for none.
### :throws: Crashes with `IndexOutOfBoundsError` for a line past GIC_LINES.
@target(arch: "aarch64", os: "none")
@track_caller
routine @InterruptManagerByGic.when_line_raised(line: U32,
    holder: Callable[(U32,), None]) -> Callable[(U32,), None]
    slot: @Addr = me.handlers.getslot(line.to[U64]())
    before: Addr = slot.peek()
    slot.poke(holder.addr())
    return bitcast(before)

### Turns line `line` on: the controller passes its interrupts to this core.
### :param line: The line's number.
@target(arch: "aarch64", os: "none")
routine @InterruptManagerByGic.turn_on(line: U32) -> None
    # A board device's line (32 and up) goes to CPU 0 (GICD_ITARGETSR, a byte per line).
    if line >= 32
        target: @U8 = inttoptr[U64, @U8](ptrtoint[Addr, U64](me.distributor.peek()) + 0x800 + line.to[U64]())
        target.poke_volatile(1)
    # GICD_ISENABLER: a bit per line, 32 lines per register.
    me.line_register(base: 0x100, line).poke_volatile(line_bit(line))
    return

### Turns line `line` off: the controller keeps its interrupts from the core.
### :param line: The line's number.
@target(arch: "aarch64", os: "none")
routine @InterruptManagerByGic.turn_off(line: U32) -> None
    # GICD_ICENABLER: a bit per line, 32 lines per register.
    me.line_register(base: 0x180, line).poke_volatile(line_bit(line))
    return

### A 32-bit register of the controller.
### :param at: The distributor or the CPU interface.
### :param offset: The register's offset from it.
### :returns: The register.
@target(arch: "aarch64", os: "none")
secret routine @InterruptManagerByGic.register(at: Addr, offset: U64) -> @U32
    return inttoptr[U64, @U32](ptrtoint[Addr, U64](at) + offset)

### The distributor's register that holds line `line`'s bit, in a bank of registers with 32 lines each.
### :param base: The bank's offset from the distributor.
### :param line: The line's number.
### :returns: The register.
@target(arch: "aarch64", os: "none")
secret routine @InterruptManagerByGic.line_register(base: U64, line: U32) -> @U32
    return me.register(at: me.distributor.peek(), offset: base + (line.to[U64]() >> 5) * 4)

### Line `line`'s bit in its register of a bank.
### :param line: The line's number.
### :returns: The bit.
@target(arch: "aarch64", os: "none")
secret routine line_bit(line: U32) -> U32
    one: U32 = 1
    return one << (line & 31)

### The CpuEventManager's interrupt handler while a manager runs: it asks the CPU interface which line came (GICC_IAR),
### tells it the line is taken (GICC_EOIR), and calls the line's handler. A spurious interrupt (1020 and up) has no
### line and calls nothing.
### :param event: The interrupt.
@target(arch: "aarch64", os: "none")
secret routine gic_interrupt(event: CpuEvent) -> None
    gic: @InterruptManagerByGic = RUNNING_GIC.peek()
    if gic.is_hollow()
        return
    taken: U32 = gic.register(at: gic.cpu_interface.peek(), offset: 0x00C).peek_volatile()
    line: U32 = taken & 0x3FF
    if line >= 1020
        return
    gic.register(at: gic.cpu_interface.peek(), offset: 0x010).poke_volatile(taken)
    if line.to[U64]() >= GIC_LINES
        throw HardwareFault(description: "An interrupt came on a line past GIC_LINES, which no handler can hold.")
    holder: Callable[(U32,), None] = bitcast(gic.handlers.getslot(line.to[U64]()).peek())
    if holder.addr().is_hollow()
        throw HardwareFault(description: "An interrupt came on a line no InterruptManagerByGic.when_line_raised handler holds.")
    holder.call(line)
    return

# -- the core's interrupt mask --------------------------------------------------------------------------------------

### Keeps interrupts from the core (PSTATE.I set) and gives what the mask was before, for restore_interrupts.
### :returns: DAIF before.
@target(arch: "aarch64", os: "none")
@external("asm")
routine mask_interrupts() -> U64
    block entry()
        mrs[U64](R0, DAIF)  # mrs x0, daif
        msr(DAIFSet, 2)  # msr daifset, #2
        return R0

### Lets interrupts reach the core (PSTATE.I clear).
@target(arch: "aarch64", os: "none")
@external("asm")
routine unmask_interrupts() -> None
    block entry()
        msr(DAIFClr, 2)  # msr daifclr, #2
        return

### Puts the core's interrupt mask back as mask_interrupts found it.
### :param was: What mask_interrupts gave.
@target(arch: "aarch64", os: "none")
@external("asm")
routine restore_interrupts(was: U64) -> None
    block entry()
        msr[U64](DAIF, was)  # msr daif, <was>
        return

### Waits for an interrupt: the core sleeps until one comes (or one is waiting already).
@target(arch: "aarch64", os: "none")
routine wait_for_next_interrupt() -> None
    wait_for_interrupt()
    return
