# Tessera stdlib: an Arm PL031 real-time clock, on a board without an operating system
#
# The PL031 counts seconds in a 32-bit register (RTCDR, at offset 0) and keeps counting while the core runs. QEMU's
# virt machine has one at 0x09010000, started at the host's date and time. The real-time clock is one device the whole
# program shares, so RtcManagerByPl031 manages it: it reads the date and time and sets it. Clock.now() reads the
# board's clock through one (Time.te), so a program names this manager only to set the clock.

module Unhosted

### The manager of a PL031 real-time clock: its count is the seconds since 1970-01-01 00:00:00 UTC.
entity RtcManagerByPl031
    ### Where its registers are.
    base: Addr

### The manager of the PL031 whose registers start at `base`.
### :param base: The address of its registers.
### :returns: The manager.
common routine RtcManagerByPl031.construct(base: Addr) -> Me
    return Me(base)

### Reads the date and time.
### :returns: The moment, to the second.
routine @RtcManagerByPl031.now() -> Moment
    data: @U32 = inttoptr[U64, @U32](ptrtoint[Addr, U64](me.base.peek()))
    return Moment.from_timestamp(data.peek_volatile().to[S64]())

### Sets the date and time, to the second: the clock counts on from there.
### :param to: The moment, from 1970 up to 2106.
routine @RtcManagerByPl031.set(to: Moment) -> None
    load: @U32 = inttoptr[U64, @U32](ptrtoint[Addr, U64](me.base.peek()) + 8)
    load.poke_volatile(to.timestamp().to[U32]())
    return
