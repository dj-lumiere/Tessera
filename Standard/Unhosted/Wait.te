# Tessera stdlib: waiting on an address, without an operating system
#
# wait_on(at, expected) puts the running thread to sleep while the U32 at `at` still holds `expected`, until another
# thread calls wake_one or wake_all on `at`. It may also return without a wake, so a caller checks its condition again
# in a loop. The threads are those of the ThreadManagerByRoundRobin whose `run` is going on (Thread.te): each routine
# goes to that manager's own routine of the same name. Outside `run` no other thread can change the word, so wait_on
# returns at once and the wakes have no one to wake.

module Standard/Unhosted

### Puts the running thread to sleep while the U32 at `at` still holds `expected`, until {wake_one} or {wake_all} is
### called on `at`. It may also return without a wake, so the caller checks its condition again in a loop.
### :param at: The word to wait on.
### :param expected: The value it must still hold for the thread to sleep. If it already differs, this returns at
### once.
@target(arch: "aarch64")
routine wait_on(at: @U32, expected: U32) -> None
    manager: @ThreadManagerByRoundRobin = RUNNING_ROUND_ROBIN.peek()
    if manager.is_hollow()
        return
    manager.wait_on(at, expected)
    return

### Wakes the thread that has waited longest on `at`, if any.
### :param at: The word the thread waits on.
@target(arch: "aarch64")
routine wake_one(at: @U32) -> None
    manager: @ThreadManagerByRoundRobin = RUNNING_ROUND_ROBIN.peek()
    if manager.is_hollow()
        return
    manager.wake_one(at)
    return

### Wakes every thread waiting on `at`.
### :param at: The word the threads wait on.
@target(arch: "aarch64")
routine wake_all(at: @U32) -> None
    manager: @ThreadManagerByRoundRobin = RUNNING_ROUND_ROBIN.peek()
    if manager.is_hollow()
        return
    manager.wake_all(at)
    return
