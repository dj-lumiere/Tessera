// Tessera stdlib: B128Big, the exact tier of B128's math functions
//
// The B128 functions without a CORE-MATH port run in two tiers, as sin_pi does (B128Extra.tess): a fast one in
// B128Extended (192 bits) that keeps its result when a band around it rounds to one B128, and this one for the
// rest. B128Big is a float with a 448-bit mantissa. Each operation is off by at most about one unit in its last
// place, so the series and Newton steps below stay within about 2^-430 relative, far closer than any B128 lies to
// a rounding boundary except the exact cases, which each function handles before it gets here.

module Standard/Core

import Standard/Format

/// Bits in a B128Big mantissa.
preset BIG_BITS: USize = 448

// ln 2 and π/2 as hi + lo, each 448 bits, least significant limb first: ln 2 = hi × 2^-448 + lo × 2^-898,
// π/2 = hi × 2^-447 + lo × 2^-896 (computed with mpmath at 2000 bits)
preset BIG_LN2_HI: @Array[U64, 7] <- [0xED2EAE35C1382144, 0x559552FB4AFA1B10, 0xE7B876206DEBAC98,
    0x8A0D175B8BAAFA2B, 0x40F343267298B62D, 0xC9E3B39803F2F6AF, 0xB17217F7D1CF79AB]

preset BIG_LN2_LO: @Array[U64, 7] <- [0xD77E9AF4E0C0C921, 0xCB3A1EC67595232B, 0x95BE83B1D95FDD2D,
    0xE7AA6F0EC4D980EC, 0x6B2F6844C5F0E1FA, 0xFA5B2858892BA314, 0x9D5CECA445A6E094]

preset BIG_HALF_PI_HI: @Array[U64, 7] <- [0x302B0A6DF25F1437, 0xEF9519B3CD3A431B,
    0x514A08798E3404DD, 0x020BBEA63B139B22, 0x29024E088A67CC74, 0xC4C6628B80DC1CD1,
    0xC90FDAA22168C234]

preset BIG_HALF_PI_LO: @Array[U64, 7] <- [0x9250CCA3D9C8B67B, 0x5D3E4822F8963FCC,
    0xDC70D7F6B5133F4B, 0x17FEB96DE80D6FDB, 0xE89885D34C6FDAD6, 0xC90B6AECC4BCFD8D,
    0x9FC26ADADAA3848B]

/// mant × 2^exponent, with mant exactly BIG_BITS bits long (top bit set). Zero has an empty mant.
record B128Big
    negative: Bool
    exponent: S64
    mant: BigNat[16]

// -- making one ----------------------------------------------------------------

/// `m` × 2^`exponent` with `m` brought to BIG_BITS bits (rounded to nearest, ties to even, when longer). Uses `m`
/// as working space. A zero `m` gives +0.
/// :param negative: Whether the value is negative.
/// :param exponent: The power of two `m` is scaled by.
/// :param m: The mantissa, changed in place.
/// :returns: The value.
routine big_make(negative: Bool, exponent: S64, m: @BigNat[16]) -> B128Big
    local adjusted: @S64 <- exponent

    if m.is_zero()
        r: B128Big = B128Big(negative: false, exponent: 0, mant: m.peek())
        return r
    else
        while true
            length: USize = m.bit_length()
            long: Bool = length > BIG_BITS
            when
                long =>
                    // rounding up can carry to 2^BIG_BITS, which the next pass shifts down
                    n: USize = length - BIG_BITS
                    m.shr_round_even(n)
                    (adjusted.peek() + n.to[S64]()).poke_into(adjusted)
                    continue
                length < BIG_BITS =>
                    n: USize = BIG_BITS.sub(length)
                    m.shl(n)
                    (adjusted.peek() - n.to[S64]()).poke_into(adjusted)
                    continue
                else => break
        r: B128Big = B128Big(negative: negative, exponent: adjusted.peek(), mant: m.peek())
        return r

/// Zero, as a B128Big (+0, with an empty mantissa).
/// :returns: +0.
routine big_zero() -> B128Big
    local m: @BigNat[16] <- .hollow()
    m.set(U64.MIN)
    r: B128Big = big_make(negative: false, exponent: 0, m)
    return r

/// `value` × 2^`exponent`, exactly.
/// :param negative: Whether the value is negative.
/// :param value: The mantissa.
/// :param exponent: The power of two `value` is scaled by.
/// :returns: The value.
routine big_from_u128(negative: Bool, value: U128, exponent: S64) -> B128Big
    local m: @BigNat[16] <- .hollow()
    m.set(value)
    r: B128Big = big_make(negative, exponent, m)
    return r

/// An S64, exactly.
/// :returns: The same value as a B128Big.
routine S64.to[B128Big](me: Me) -> B128Big
    r: B128Big = big_from_u128(negative: me < 0, value: me.abs_diff(0).to[U128](), exponent: 0)
    return r

/// One, as a B128Big.
/// :returns: 1.
routine big_one() -> B128Big
    r: B128Big = big_from_u128(negative: false, value: 1, exponent: 0)
    return r

/// A B128, exactly.
/// :returns: The same value as a B128Big (both zeros give +0).
routine B128.to[B128Big](me: Me) -> B128Big
    if b128_is_zero_bits(me.bits())
        return big_zero()
    p: B128Parts = b128_unpack(me.bits())
    r: B128Big = big_from_u128(negative: b128_is_negative_bits(me.bits()), value: p.sig, exponent: p.exponent - 112)
    return r

/// A B128Extended, exactly.
/// :returns: The same value as a B128Big.
routine B128Extended.to[B128Big](me: Me) -> B128Big
    local m: @BigNat[16] <- .hollow()
    local low: @BigNat[16] <- .hollow()
    m.set(me.hi)
    m.shl(64)
    low.set(me.lo)
    m.add(low)
    r: B128Big = big_make(negative: me.negative, exponent: me.exponent - 191, m)
    return r

/// `limbs` (7 of them, least significant first) × 2^`exponent`.
/// :param limbs: The first of the seven limbs.
/// :param exponent: The power of two the limbs are scaled by.
/// :returns: The value, rounded to BIG_BITS bits if it is longer.
routine big_from_limbs(limbs: @U64, exponent: S64) -> B128Big
    local m: @BigNat[16] <- .hollow()

    m.set(U64.MIN)

    each i in 0 til 7
        limb: U64 = limbs.stride(i).peek()
        m.push_limb(limb)
    r: B128Big = big_make(negative: false, exponent, m)
    return r

/// The high part of ln 2: `BIG_LN2_HI` × 2^-448, its first 448 bits.
/// :returns: The high part.
routine big_ln2_hi() -> B128Big
    r: B128Big = big_from_limbs(limbs: BIG_LN2_HI.to[@U64](), exponent: -448)
    return r

/// The low part of ln 2, the next bits below `big_ln2_hi`: `BIG_LN2_LO` × 2^-898.
/// :returns: The low part.
routine big_ln2_lo() -> B128Big
    r: B128Big = big_from_limbs(limbs: BIG_LN2_LO.to[@U64](), exponent: -898)
    return r

/// ln 2 to 448 bits (`big_ln2_hi`).
/// :returns: ln 2.
routine big_ln2() -> B128Big
    r: B128Big = big_ln2_hi()
    return r

/// π/2 to 448 bits.
/// :returns: π/2.
routine big_half_pi() -> B128Big
    r: B128Big = big_from_limbs(limbs: BIG_HALF_PI_HI.to[@U64](), exponent: -447)
    return r

/// π to 448 bits.
/// :returns: π.
routine big_pi() -> B128Big
    r: B128Big = big_half_pi().ldexp(1)
    return r

// -- reading one ---------------------------------------------------------------

/// True when `me` is zero (its mantissa is empty).
/// :returns: True for zero.
routine B128Big.is_zero(me: Me) -> Bool
    return me.mant.count == 0

/// floor(log2 |me|) for a nonzero me: |me| is in [2^top, 2^(top + 1)).
/// :returns: `top`, the exponent of the leading bit.
routine B128Big.top(me: Me) -> S64
    r: S64 = me.exponent + BIG_BITS.to[S64]() - 1
    return r

/// Rounded once to B128, to nearest, ties to even (overflow, subnormals, and underflow included). Zero is +0.
/// :returns: The nearest B128.
routine B128Big.to[B128](me: Me) -> B128
    if me.is_zero()
        return b128_of(0)
    else
        // the top 125 bits with a sticky bit, as big_to_b128 hands them to b128_round_pack
        local m: @BigNat[16] <- me.mant
        shift: USize = BIG_BITS.sub(125)
        sticky: Bool = m.has_any_below(shift)
        top: U128 = m.bits128(shift)
        sig: U128 = top | sticky.to[U128]()
        shifted: S64 = me.exponent + shift.to[S64]()
        exponent: S64 = shifted + B128_BIAS + 115
        bits: U128 = b128_round_pack(negative: me.negative, exponent, sig)
        r: B128 = b128_of(bits)
        return r

/// The top 192 bits, truncated: seeds for Newton's method and for reductions.
/// :returns: The truncated B128Extended.
routine B128Big.to[B128Extended](me: Me) -> B128Extended
    if me.is_zero()
        return wide_zero()
    local m: @BigNat[16] <- me.mant
    shift: USize = BIG_BITS.sub(192)
    hi: U128 = m.bits128(shift + 64)
    lo: U64 = m.bits128(shift).to_wrap[U64]()
    w: B128Extended = B128Extended(negative: me.negative, exponent: me.exponent + shift.to[S64]() + 191, hi: hi, lo: lo)
    return w

/// Compares the magnitudes of `me` and `other`.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as |`me`| is below, equal to, or above |`other`|.
routine B128Big.compare_magnitude(me: Me, other: Me) -> S32
    a_zero: Bool = me.is_zero()
    b_zero: Bool = other.is_zero()
    low: S32 = when
        b_zero => 0
        else => -1
    when
        a_zero => return low
        b_zero => return 1
        else =>
            lower: Bool = me.exponent < other.exponent
            when
                lower => return -1
                me.exponent > other.exponent => return 1
                else =>
                    local a: @BigNat[16] <- me.mant
                    local b: @BigNat[16] <- other.mant
                    r: S32 = a.compare(b)
                    return r

// -- arithmetic ----------------------------------------------------------------

/// The negation of `me`. Zero stays +0.
/// :returns: -`me`.
routine B128Big.neg(me: Me) -> Me
    if me.is_zero()
        return me
    r: Me = Me(negative: ~me.negative, exponent: me.exponent, mant: me.mant)
    return r

/// The magnitude of `me`.
/// :returns: |`me`|.
routine B128Big.abs(me: Me) -> Me
    r: Me = Me(negative: false, exponent: me.exponent, mant: me.mant)
    return r

/// `me` × 2^`k`, exactly.
/// :param k: The power of two.
/// :returns: The scaled value.
routine B128Big.ldexp(me: Me, k: S64) -> Me
    if me.is_zero()
        return me
    r: Me = Me(negative: me.negative, exponent: me.exponent + k, mant: me.mant)
    return r

/// The sum, rounded once. Both mantissas get 64 guard bits. The smaller is shifted exactly when it's within 64
/// bits of the larger, else rounded, which only happens when it can't cancel.
/// :param other: The value to add.
/// :returns: The sum.
routine B128Big.add(me: Me, other: Me) -> Me
    local x: @BigNat[16] <- .hollow()
    local y: @BigNat[16] <- .hollow()

    a_zero: Bool = me.is_zero()
    when
        a_zero => return other
        other.is_zero() => return me
        else =>
            a_first: Bool = me.compare_magnitude(other) >= 0
            big: Me = when
                a_first => me
                else => other
            small: Me = when
                a_first => other
                else => me
            d: S64 = big.exponent - small.exponent
            if d > BIG_BITS.to[S64]() + 66
                return big
            else
                x.poke(big.mant)
                y.poke(small.mant)
                x.shl(64)
                if d <= 64
                    y.shl((64 - d).to[USize]())
                else
                    y.shr_round_even((d - 64).to[USize]())
                if big.negative == small.negative
                    x.add(y)
                else
                    x.sub(y)
                r: Me = big_make(negative: big.negative, exponent: big.exponent - 64, m: x)
                return r

/// The difference, rounded once: `me` plus the negation of `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
routine B128Big.sub(me: Me, other: Me) -> Me
    r: Me = me + -other
    return r

/// The product, rounded once.
/// :param other: The value to multiply by.
/// :returns: The product.
routine B128Big.mul(me: Me, other: Me) -> Me
    local a: @BigNat[16] <- me.mant
    local b: @BigNat[16] <- other.mant
    local p: @BigNat[16] <- .hollow()
    p.set_product(a, b)
    negative: Bool = me.negative ^ other.negative
    r: Me = big_make(negative, exponent: me.exponent + other.exponent, m: p)
    return r

/// me × n, rounded once.
/// :param n: The factor.
/// :returns: The product.
routine B128Big.mul(me: Me, n: U64) -> Me
    local a: @BigNat[16] <- me.mant
    a.mul_add(m: n, addend: 0)
    a.trim()
    // n = 0 leaves zero limbs
    r: Me = big_make(negative: me.negative, exponent: me.exponent, m: a)
    return r

/// me × n for a signed n, rounded once.
/// :param n: The factor.
/// :returns: The product.
routine B128Big.mul(me: Me, n: S64) -> Me
    m: Me = me * n.abs_diff(0)
    r: Me = when
        n < 0 => -m
        else => m
    return r

/// me / n (n > 0), rounded once: 64 more bits go into the division.
/// :param n: The divisor, not zero.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `n` is 0 and `me` is not zero.
routine B128Big.div(me: Me, n: U64) -> Me
    local a: @BigNat[16] <- me.mant
    a.shl(64)
    dropped: U64 = a.div_limb(n)
    sticky: Bool = dropped != 0
    // a remainder only matters as a sticky bit below the 64 extra bits
    a.shl(1)
    bit: U64 = sticky.to[U64]()
    local s: @BigNat[16] <- .hollow()
    s.set(bit)
    a.add(s)
    r: Me = big_make(negative: me.negative, exponent: me.exponent - 65, m: a)
    return r

/// 1 / me for a nonzero me: two Newton steps y ← y + y (1 - me y) from B128Extended's 190 bits.
/// :returns: The reciprocal.
routine B128Big.recip(me: Me) -> Me
    seed: B128Extended = wide_one() / me.to[B128Extended]()
    y0: Me = seed.to[Me]()
    one: Me = big_one()
    y1: Me = y0 + y0 * (one - me * y0)
    y2: Me = y1 + y1 * (one - me * y1)
    return y2

/// `me` / `other` for a nonzero `other`, as `me` times the reciprocal of `other`.
/// :param other: The divisor, not zero.
/// :returns: The quotient.
routine B128Big.div(me: Me, other: Me) -> Me
    r: Me = me * other.recip()
    return r

/// sqrt for me >= 0: two Newton steps s ← (s + me / s) / 2 from B128Extended's 190 bits.
/// :returns: The square root.
routine B128Big.sqrt(me: Me) -> Me
    if me.is_zero()
        return me
    s0: Me = B128Extended.to[Me](me.to[B128Extended]().sqrt())
    s1: Me = (s0 + me / s0).ldexp(-1)
    s2: Me = (s1 + me / s1).ldexp(-1)
    return s2

// -- series --------------------------------------------------------------------

/// Whether a term no longer moves a sum: |term| < 2^-(BIG_BITS + 8) |sum|.
/// :param term: The next term.
/// :param sum: The sum so far.
/// :returns: True when `term` is zero, or below that bound and `sum` is nonzero.
routine big_is_negligible(term: B128Big, sum: B128Big) -> Bool
    zero: Bool = term.is_zero()
    sum_top: S64 = sum.top()
    floor: S64 = sum_top - BIG_BITS.to[S64]() - 8
    tiny: Bool = term.top() < floor
    sum_nonzero: Bool = not sum.is_zero()
    return zero or (sum_nonzero and tiny)

// -- exp, exp_m1 ---------------------------------------------------------------

/// e^x for |x| < 2^15: x = q ln 2 + r with ln 2 in two parts, then e^(r / 256) by its Taylor series and 8
/// squarings (each doubles the relative error, to about 2^-438 in all).
/// :param x: The exponent, |x| < 2^15.
/// :returns: e^x.
routine big_exp(x: B128Big) -> B128Big
    local x_over_ln2: B128Extended = x.to[B128Extended]() * wide_const(1)
    local q: S64 = x_over_ln2.to_nearest[S64]()
    local r: B128Big = x - big_ln2_hi() * q - big_ln2_lo() * q
    local small: B128Big = r.ldexp(-8)

    one: B128Big = big_one()
    jump series(1, small, one + small)

    // term = small^j / j!
    block series(j: U64, term: B128Big, sum: B128Big)
        next: B128Big = term * small / (j + 1)
        if big_is_negligible(term: next, sum)
            jump square(0, sum)
        else
            jump series(j + 1, next, sum + next)

    block square(i: S64, e: B128Big)
        if i >= 8
            return e.ldexp(q)
        else
            jump square(i + 1, e * e)

/// e^x - 1 without cancellation: below 2^-20 its own series x Σ x^j / (j+1)!, else e^x - 1, which loses at most
/// 21 of the 448 bits.
/// :param x: The exponent.
/// :returns: e^x - 1.
routine big_exp_m1(x: B128Big) -> B128Big
    zero: Bool = x.is_zero()
    when
        zero => return x
        x.top() < -20 =>
            // term = x^j / j!
            while true with j: U64 = 1, term: B128Big = x, sum: B128Big = x
                next2: B128Big = term * x / (j + 1)
                if big_is_negligible(term: next2, sum)
                    return sum
                else
                    continue with j: j + 1, term: next2, sum: sum + next2
        else => return big_exp(x) - big_one()

// -- ln, ln_1p -----------------------------------------------------------------

/// ln x for x > 0: x = m 2^e with m in [sqrt(1/2), sqrt(2)), ln m from B128Extended's log (about 135 bits), then
/// two Newton steps y ← y + m e^-y - 1. Near 1, where ln m is small, ln_1p of m - 1 keeps it accurate.
/// :param x: The argument, positive.
/// :returns: ln x.
routine big_ln(x: B128Big) -> B128Big
    local top: S64 = x.top()
    local m0: B128Big = x.ldexp(0 - top)
    // in [1, 2)
    local sqrt_two: B128Extended = wide_const(2).ldexp(1)
    local high: Bool = m0.to[B128Extended]().hi >= sqrt_two.hi
    local m: B128Big = when
        high => m0.ldexp(-1)
        else => m0
    local e: S64 = when
        high => top + 1
        else => top

    one: B128Big = big_one()
    u: B128Big = m - one
    // exact
    if e == 0 and (u.is_zero() or u.top() < -20)
        return big_ln_1p(u)
    else
        one2: B128Big = big_one()
        y0: B128Big = B128Extended.to[B128Big](wide_log(m.to[B128Extended]()))
        y1: B128Big = y0 + (m * big_exp(-y0) - one2)
        y2: B128Big = y1 + (m * big_exp(-y1) - one2)
        k_hi: B128Big = big_ln2_hi() * e
        k: B128Big = k_hi + big_ln2_lo() * e
        r: B128Big = y2 + k
        return r

/// ln(1 + u) for u > -1: below 2^-20 its series u - u²/2 + u³/3 - …, else ln of 1 + u.
/// :param u: The argument, above -1.
/// :returns: ln(1 + u).
routine big_ln_1p(u: B128Big) -> B128Big
    zero: Bool = u.is_zero()
    when
        zero => return u
        u.top() < -20 =>
            // power = u^j, and the next term is (-1)^j u^(j+1) / (j+1)
            while true with j: U64 = 1, power: B128Big = u, sum: B128Big = u
                next_power2: B128Big = power * u
                term2: B128Big = next_power2 / (j + 1)
                odd2: Bool = j & 1 == 1
                signed2: B128Big = when
                    odd2 => -term2
                    else => term2
                if big_is_negligible(term: term2, sum)
                    return sum
                else
                    continue with j: j + 1, power: next_power2, sum: sum + signed2
        else => return big_ln(big_one() + u)

/// ln `x` / ln `base` in B128Big (within about 2^-430 relative), rounded to a B128 that narrows correctly to a binary
/// format with `fraction_bits` fraction bits: the last tier of B32.log and B64.log, whose results are normal. The
/// nearest B128 narrows to the nearest value of the quotient unless it is exactly a midpoint of the narrow format
/// (double rounding), so there the B128 one step toward the B128Big quotient is taken instead.
/// :param x: The argument, positive and finite, not 1.
/// :param base: The base, positive and finite, not 1.
/// :param fraction_bits: The narrow format's fraction bits: 23 for B32, 52 for B64.
/// :returns: A B128 whose nearest value in the narrow format is the correctly rounded quotient.
/// :note: The quotient is never exactly a midpoint of B32 or B64: ln x / ln base = p / q in lowest terms means
///     x^q = base^p, so x and base are powers c^p and c^q of one rational c. A midpoint needs q a power of 2 and p
///     odd with at least 25 bits (54 for B64), and c^p is then no B128 (an odd prime of c to that power, or a power
///     of 2 far out of range) unless c = 1, which base = c^q rules out.
routine big_log_ratio(x: B128, base: B128, fraction_bits: U128) -> B128
    local quotient: B128Big = big_ln(x.to[B128Big]()) / big_ln(base.to[B128Big]())
    local nearest: B128 = quotient.to[B128]()

    dropped: U128 = U128.sub(112, fraction_bits)
    half: U128 = U128.shl(1, dropped - 1)
    low: U128 = nearest.bits() & (half << 1) - 1
    if low == half
        // a midpoint of the narrow format: step off it toward the quotient, so the narrowing rounds the right way
        gap: B128Big = quotient - nearest.to[B128Big]()
        exact: Bool = gap.is_zero()
        when
            exact => return nearest
            gap.negative => return nearest.next_down()
            else => return nearest.next_up()
    else
        return nearest

// -- sin, cos ------------------------------------------------------------------

/// |x| = k π/2 + θ with k mod 4 and |θ| <= π/4, for a finite nonzero x.
record BigReduced
    quadrant: U64
    theta: B128Big

/// sin θ = θ Σ (-θ²)^k / (2k+1)! for |θ| <= π/4.
/// :param t: θ, with |θ| <= π/4.
/// :returns: sin θ.
routine big_sin_core(t: B128Big) -> B128Big
    if t.is_zero()
        return t

    // term = θ (-θ²)^k / (2k+1)!, and j = 2k + 1
    u: B128Big = -(t * t)
    while true with j: U64 = 1, term: B128Big = t, sum: B128Big = t
        next2: B128Big = term * u / ((j + 1) * (j + 2))
        if big_is_negligible(term: next2, sum)
            return sum
        else
            continue with j: j + 2, term: next2, sum: sum + next2

/// cos θ = Σ (-θ²)^k / (2k)! for |θ| <= π/4.
/// :param t: θ, with |θ| <= π/4.
/// :returns: cos θ.
routine big_cos_core(t: B128Big) -> B128Big
    one: B128Big = big_one()
    if t.is_zero()
        return one

    // term = (-θ²)^k / (2k)!, and j = 2k
    u: B128Big = -(t * t)
    while true with j: U64 = 0, term: B128Big = one, sum: B128Big = one
        next2: B128Big = term * u / ((j + 1) * (j + 2))
        if big_is_negligible(term: next2, sum)
            return sum
        else
            continue with j: j + 2, term: next2, sum: sum + next2

/// Reduces |x| by π/2 (Payne-Hanek). With |x| = m × 2^(e - 112), the bits of 2/π that land below 4 are a window W
/// of 14 limbs (896 bits) from limb s on: |x| × 2/π mod 4 = m W × 2^-sh. The bits above sh give the quadrant, the
/// ones below it the fraction, accurate to about 2^-650 absolute: far past any B128's distance to a multiple of
/// π/2, so θ keeps its 448 bits.
/// :param x: The argument, finite and nonzero.
/// :returns: The quadrant `k` mod 4 and θ.
routine big_reduce(x: B128) -> BigReduced
    local p: B128Parts = b128_unpack(x.bits())
    local w: @BigNat[24] <- .hollow()
    local prod: @BigNat[24] <- .hollow()
    // f = F × 2^-sh with F the bits under sh. Past 1/2, count the next quadrant and use f - 1
    local f: @BigNat[16] <- .hollow()
    local q: @U64 <- .hollow()

    // |x| < 1/2 < π/4
    if p.exponent < -1
        r: BigReduced = BigReduced(quadrant: 0, theta: B128.to[B128Big](x.abs()))
        return r
    else
        bits_above: S64 = (p.exponent - 114).max(0)
        s: USize = (bits_above / 64).to[USize]()
        window_bits: USize = (s + 14) * 64
        window_gap: S64 = window_bits.to[S64]() - p.exponent
        sh: S64 = window_gap + 112
        w.set(U64.MIN)
        // limb k of W, least significant first, is TWO_OVER_PI[s + 13 - k]
        each k in 0 til 14
            limb: U64 = TWO_OVER_PI.getitem(s + 13 - k)
            w.push_limb(limb)
        then
            local m: @BigNat[24] <- .hollow()
            w.trim()
            m.set(p.sig)
            prod.set_product(a: m, b: w)
            at: USize = sh.to[USize]()
            whole_low: U64 = prod.bits128(at).to_wrap[U64]()
            quadrant: U64 = whole_low & 3
            past_half: Bool = prod.has_bit(at - 1)
            f.set(U64.MIN)
            quadrant.poke_into(q)
            // copy the bits under sh into f, 64 at a time from the bottom (sh is a whole number of limbs past any
            // leftover bits, which bits128 reads across)
            while i * 64 < at with i: USize = 0
                pos2: USize = i * 64
                left: USize = at - pos2
                word: U64 = prod.bits128(pos2).to_wrap[U64]()
                mask: U64 = U64.MAX >> (64 - left.min(64)).to[U64]()
                f.push_limb(word & mask)
                continue with i: i + 1
            then
                f.trim()
                values2: (Bool, @BigNat[16]) = when
                    past_half =>
                        // f - 1 = -(2^sh - F) × 2^-sh, taken exactly before any rounding
                        local c: @BigNat[16] <- .hollow()
                        one: U64 = 1
                        c.set(one)
                        c.shl(at)
                        c.sub(f)
                        q.poke(q.peek() +% 1 & 3)
                        becomes (true, c)
                    else => (false, f)
                negative, g = values2
                frac: B128Big = big_make(negative, exponent: 0 - at.to[S64](), m: g)
                r: BigReduced = BigReduced(quadrant: q.peek(), theta: frac * big_half_pi())
                return r
