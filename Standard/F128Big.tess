// Tessera stdlib: F128Big, the exact tier of F128's math functions
//
// The F128 functions without a CORE-MATH port run in two tiers, as sin_pi does (F128Extra.tess): a fast one in
// F128Extended (192 bits) that keeps its result when a band around it rounds to one F128, and this one for the
// rest. F128Big is a float with a 448-bit mantissa. Each operation is off by at most about one unit in its last
// place, so the series and Newton steps below stay within about 2^-430 relative, far closer than any F128 lies to
// a rounding boundary except the exact cases, which each function handles before it gets here.

module Standard::Core

import Standard::Format

/// Bits in an F128Big mantissa.
preset BIG_BITS: USize = 448

// ln 2 and π/2 as hi + lo, each 448 bits, least significant limb first: ln 2 = hi × 2^-448 + lo × 2^-898,
// π/2 = hi × 2^-447 + lo × 2^-896 (computed with mpmath at 2000 bits)
preset BIG_LN2_HI: @Array<U64, 7> <- { 0xED2EAE35C1382144, 0x559552FB4AFA1B10, 0xE7B876206DEBAC98,
    0x8A0D175B8BAAFA2B, 0x40F343267298B62D, 0xC9E3B39803F2F6AF, 0xB17217F7D1CF79AB }

preset BIG_LN2_LO: @Array<U64, 7> <- { 0xD77E9AF4E0C0C921, 0xCB3A1EC67595232B, 0x95BE83B1D95FDD2D,
    0xE7AA6F0EC4D980EC, 0x6B2F6844C5F0E1FA, 0xFA5B2858892BA314, 0x9D5CECA445A6E094 }

preset BIG_HALF_PI_HI: @Array<U64, 7> <- { 0x302B0A6DF25F1437, 0xEF9519B3CD3A431B,
    0x514A08798E3404DD, 0x020BBEA63B139B22, 0x29024E088A67CC74, 0xC4C6628B80DC1CD1,
    0xC90FDAA22168C234 }

preset BIG_HALF_PI_LO: @Array<U64, 7> <- { 0x9250CCA3D9C8B67B, 0x5D3E4822F8963FCC,
    0xDC70D7F6B5133F4B, 0x17FEB96DE80D6FDB, 0xE89885D34C6FDAD6, 0xC90B6AECC4BCFD8D,
    0x9FC26ADADAA3848B }

/// mant × 2^exponent, with mant exactly BIG_BITS bits long (top bit set). Zero has an empty mant.
record F128Big
    negative : Bool
    exponent : S64
    mant     : BigNat<16>

// -- making one ----------------------------------------------------------------

/// `m` × 2^`exponent` with `m` brought to BIG_BITS bits (rounded to nearest, ties to even, when longer). Uses `m`
/// as working space. A zero `m` gives +0.
/// :param negative: Whether the value is negative.
/// :param exponent: The power of two `m` is scaled by.
/// :param m: The mantissa, changed in place.
/// :returns: The value.
routine big_make(negative: Bool, exponent: S64, m: @BigNat<16>) -> F128Big
    shared adjusted : @S64 <- exponent

    block entry()
        zero : Bool = m.is_zero()
        branch zero
            ? zero()
            : fit()

    block zero()
        r : F128Big = F128Big { negative: false, exponent: 0, mant: m.load() }
        return(r)

    block fit()
        length : USize = m.bit_length()
        long   : Bool  = length.gt(BIG_BITS)
        short  : Bool  = length.lt(BIG_BITS)
        when
            long  -> shrink(length.sub(BIG_BITS))
            short -> grow(BIG_BITS.sub(length))
            else  -> done()

    // rounding up can carry to 2^BIG_BITS, which the next pass shifts down
    block shrink(n: USize)
        m.shr_round_even(n)
        adjusted.load().add(n.to<S64>()).store_into(adjusted)
        jump fit()

    block grow(n: USize)
        m.shl(n)
        adjusted.load().sub(n.to<S64>()).store_into(adjusted)
        jump fit()

    block done()
        r : F128Big = F128Big { negative: negative, exponent: adjusted.load(), mant: m.load() }
        return(r)

/// Zero, as an F128Big (+0, with an empty mantissa).
/// :returns: +0.
routine big_zero() -> F128Big
    block entry()
        claim m : @BigNat<16> <- uninit
        m.set(U64.MIN)
        r : F128Big = big_make(false, 0, m)
        return(r)

/// `value` × 2^`exponent`, exactly.
/// :param negative: Whether the value is negative.
/// :param value: The mantissa.
/// :param exponent: The power of two `value` is scaled by.
/// :returns: The value.
routine big_from_u128(negative: Bool, value: U128, exponent: S64) -> F128Big
    block entry()
        claim m : @BigNat<16> <- uninit
        m.set(value)
        r : F128Big = big_make(negative, exponent, m)
        return(r)

/// An S64, exactly.
/// :returns: The same value as an F128Big.
routine S64.to<F128Big>(self: Self) -> F128Big
    block entry()
        r : F128Big = big_from_u128(self.lt(0), self.abs_diff(0).to<U128>(), 0)
        return(r)

/// One, as an F128Big.
/// :returns: 1.
routine big_one() -> F128Big
    block entry()
        r : F128Big = big_from_u128(false, 1, 0)
        return(r)

/// An F128, exactly.
/// :returns: The same value as an F128Big (both zeros give +0).
routine F128.to<F128Big>(self: Self) -> F128Big
    block entry()
        zero : Bool = f128_is_zero_bits(self.bits())
        branch zero
            ? return(big_zero())
            : continue
        p : F128Parts = f128_unpack(self.bits())
        r : F128Big   = big_from_u128(f128_is_negative_bits(self.bits()), p.sig,
            p.exponent.sub(112))
        return(r)

/// An F128Extended, exactly.
/// :returns: The same value as an F128Big.
routine F128Extended.to<F128Big>(self: Self) -> F128Big
    block entry()
        claim m   : @BigNat<16> <- uninit
        claim low : @BigNat<16> <- uninit
        m.set(self.hi)
        m.shl(64)
        low.set(self.lo)
        m.add(low)
        r : F128Big = big_make(self.negative, self.exponent.sub(191), m)
        return(r)

/// `limbs` (7 of them, least significant first) × 2^`exponent`.
/// :param limbs: The first of the seven limbs.
/// :param exponent: The power of two the limbs are scaled by.
/// :returns: The value, rounded to BIG_BITS bits if it is longer.
routine big_from_limbs(limbs: @U64, exponent: S64) -> F128Big
    shared m : @BigNat<16> <- uninit

    block entry()
        m.set(U64.MIN)
        jump load(0)

    block load(i: USize)
        done : Bool = i.ge(7)
        branch done
            ? finish()
            : one(i)

    block one(i: USize)
        limb : U64 = limbs.stride(i).load()
        m.push_limb(limb)
        jump load(i.add(1))

    block finish()
        r : F128Big = big_make(false, exponent, m)
        return(r)

/// The high part of ln 2: `BIG_LN2_HI` × 2^-448, its first 448 bits.
/// :returns: The high part.
routine big_ln2_hi() -> F128Big
    block entry()
        r : F128Big = big_from_limbs(BIG_LN2_HI.to<@U64>(), -448)
        return(r)

/// The low part of ln 2, the next bits below `big_ln2_hi`: `BIG_LN2_LO` × 2^-898.
/// :returns: The low part.
routine big_ln2_lo() -> F128Big
    block entry()
        r : F128Big = big_from_limbs(BIG_LN2_LO.to<@U64>(), -898)
        return(r)

/// ln 2 to 448 bits (`big_ln2_hi`).
/// :returns: ln 2.
routine big_ln2() -> F128Big
    block entry()
        r : F128Big = big_ln2_hi()
        return(r)

/// π/2 to 448 bits.
/// :returns: π/2.
routine big_half_pi() -> F128Big
    block entry()
        r : F128Big = big_from_limbs(BIG_HALF_PI_HI.to<@U64>(), -447)
        return(r)

/// π to 448 bits.
/// :returns: π.
routine big_pi() -> F128Big
    block entry()
        r : F128Big = big_half_pi().ldexp(1)
        return(r)

// -- reading one ---------------------------------------------------------------

/// True when `self` is zero (its mantissa is empty).
/// :returns: True for zero.
routine F128Big.is_zero(self: Self) -> Bool
    block entry()
        r : Bool = self.mant.count.eq(0)
        return(r)

/// floor(log2 |self|) for a nonzero self: |self| is in [2^top, 2^(top + 1)).
/// :returns: `top`, the exponent of the leading bit.
routine F128Big.top(self: Self) -> S64
    block entry()
        r : S64 = self.exponent.add(BIG_BITS.to<S64>()).sub(1)
        return(r)

/// Rounded once to F128, to nearest, ties to even (overflow, subnormals, and underflow included). Zero is +0.
/// :returns: The nearest F128.
routine F128Big.to<F128>(self: Self) -> F128
    block entry()
        zero : Bool = self.is_zero()
        branch zero
            ? return(f128_of(0))
            : round()

    // the top 125 bits with a sticky bit, as big_to_f128 hands them to f128_round_pack
    block round()
        claim m : @BigNat<16> <- self.mant
        shift    : USize = BIG_BITS.sub(125)
        sticky   : Bool  = m.has_any_below(shift)
        top      : U128  = m.bits128(shift)
        sig      : U128  = top.bitor(sticky.to<U128>())
        shifted  : S64   = self.exponent.add(shift.to<S64>())
        exponent : S64   = shifted.add(F128_BIAS).add(115)
        bits     : U128  = f128_round_pack(self.negative, exponent, sig)
        r        : F128  = f128_of(bits)
        return(r)

/// The top 192 bits, truncated: seeds for Newton's method and for reductions.
/// :returns: The truncated F128Extended.
routine F128Big.to<F128Extended>(self: Self) -> F128Extended
    block entry()
        zero : Bool = self.is_zero()
        branch zero
            ? return(wide_zero())
            : continue
        claim m : @BigNat<16> <- self.mant
        shift : USize        = BIG_BITS.sub(192)
        hi    : U128         = m.bits128(shift.add(64))
        lo    : U64          = m.bits128(shift).to_wrap<U64>()
        w     : F128Extended = F128Extended { negative: self.negative,
            exponent: self.exponent.add(shift.to<S64>()).add(191), hi: hi, lo: lo }
        return(w)

/// Compares the magnitudes of `self` and `other`.
/// :param other: The value to compare with.
/// :returns: -1, 0, or 1 as |`self`| is below, equal to, or above |`other`|.
routine F128Big.compare_magnitude(self: Self, other: Self) -> S32
    block entry()
        a_zero : Bool = self.is_zero()
        b_zero : Bool = other.is_zero()
        low    : S32  = b_zero
            ? 0
            : -1
        when
            a_zero -> return(low)
            b_zero -> return(1)
            else   -> both()

    block both()
        lower  : Bool = self.exponent.lt(other.exponent)
        higher : Bool = self.exponent.gt(other.exponent)
        when
            lower  -> return(-1)
            higher -> return(1)
            else   -> mantissas()

    block mantissas()
        claim a : @BigNat<16> <- self.mant
        claim b : @BigNat<16> <- other.mant
        r : S32 = a.compare(b)
        return(r)

// -- arithmetic ----------------------------------------------------------------

/// The negation of `self`. Zero stays +0.
/// :returns: -`self`.
routine F128Big.neg(self: Self) -> Self
    block entry()
        zero : Bool = self.is_zero()
        branch zero
            ? return(self)
            : continue
        r : Self = Self { negative: self.negative.bitnot(), exponent: self.exponent,
            mant: self.mant }
        return(r)

/// The magnitude of `self`.
/// :returns: |`self`|.
routine F128Big.abs(self: Self) -> Self
    block entry()
        r : Self = Self { negative: false, exponent: self.exponent, mant: self.mant }
        return(r)

/// `self` × 2^`k`, exactly.
/// :param k: The power of two.
/// :returns: The scaled value.
routine F128Big.ldexp(self: Self, k: S64) -> Self
    block entry()
        zero : Bool = self.is_zero()
        branch zero
            ? return(self)
            : continue
        r : Self = Self { negative: self.negative, exponent: self.exponent.add(k), mant: self.mant }
        return(r)

/// The sum, rounded once. Both mantissas get 64 guard bits. The smaller is shifted exactly when it's within 64
/// bits of the larger, else rounded, which only happens when it can't cancel.
/// :param other: The value to add.
/// :returns: The sum.
routine F128Big.add(self: Self, other: Self) -> Self
    shared x : @BigNat<16> <- uninit
    shared y : @BigNat<16> <- uninit

    block entry()
        a_zero : Bool = self.is_zero()
        b_zero : Bool = other.is_zero()
        when
            a_zero -> return(other)
            b_zero -> return(self)
            else   -> order()

    block order()
        a_first : Bool = self.compare_magnitude(other).ge(0)
        big     : Self = a_first
            ? self
            : other
        small : Self = a_first
            ? other
            : self
        d   : S64  = big.exponent.sub(small.exponent)
        far : Bool = d.gt(BIG_BITS.to<S64>().add(66))
        branch far
            ? return(big)
            : align(big, small, d)

    block align(big: Self, small: Self, d: S64)
        x.store(big.mant)
        y.store(small.mant)
        x.shl(64)
        near : Bool = d.le(64)
        branch near
            ? up(big, small, d)
            : down(big, small, d)

    block up(big: Self, small: Self, d: S64)
        y.shl(64.sub(d).to<USize>())
        jump combine(big, small)

    block down(big: Self, small: Self, d: S64)
        y.shr_round_even(d.sub(64).to<USize>())
        jump combine(big, small)

    block combine(big: Self, small: Self)
        same : Bool = big.negative.eq(small.negative)
        branch same
            ? plus(big)
            : minus(big)

    block plus(big: Self)
        x.add(y)
        jump assemble(big)

    block minus(big: Self)
        x.sub(y)
        jump assemble(big)

    block assemble(big: Self)
        r : Self = big_make(big.negative, big.exponent.sub(64), x)
        return(r)

/// The difference, rounded once: `self` plus the negation of `other`.
/// :param other: The value to subtract.
/// :returns: The difference.
routine F128Big.sub(self: Self, other: Self) -> Self
    block entry()
        r : Self = self.add(other.neg())
        return(r)

/// The product, rounded once.
/// :param other: The value to multiply by.
/// :returns: The product.
routine F128Big.mul(self: Self, other: Self) -> Self
    block entry()
        claim a : @BigNat<16> <- self.mant
        claim b : @BigNat<16> <- other.mant
        claim p : @BigNat<16> <- uninit
        p.set_product(a, b)
        negative : Bool = self.negative.bitxor(other.negative)
        r        : Self = big_make(negative, self.exponent.add(other.exponent), p)
        return(r)

/// self × n, rounded once.
/// :param n: The factor.
/// :returns: The product.
routine F128Big.mul(self: Self, n: U64) -> Self
    block entry()
        claim a : @BigNat<16> <- self.mant
        a.mul_add(n, 0)
        a.trim()  // n = 0 leaves zero limbs
        r : Self = big_make(self.negative, self.exponent, a)
        return(r)

/// self × n for a signed n, rounded once.
/// :param n: The factor.
/// :returns: The product.
routine F128Big.mul(self: Self, n: S64) -> Self
    block entry()
        m : Self = self.mul(n.abs_diff(0))
        r : Self = n.lt(0)
            ? m.neg()
            : m
        return(r)

/// self / n (n > 0), rounded once: 64 more bits go into the division.
/// :param n: The divisor, not zero.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `n` is 0 and `self` is not zero.
routine F128Big.div(self: Self, n: U64) -> Self
    block entry()
        claim a : @BigNat<16> <- self.mant
        a.shl(64)
        dropped : U64  = a.div_limb(n)
        sticky  : Bool = dropped.ne(0)
        // a remainder only matters as a sticky bit below the 64 extra bits
        a.shl(1)
        bit : U64 = sticky.to<U64>()
        claim s : @BigNat<16> <- uninit
        s.set(bit)
        a.add(s)
        r : Self = big_make(self.negative, self.exponent.sub(65), a)
        return(r)

/// 1 / self for a nonzero self: two Newton steps y ← y + y (1 - self y) from F128Extended's 190 bits.
/// :returns: The reciprocal.
routine F128Big.recip(self: Self) -> Self
    block entry()
        seed : F128Extended = wide_one().div(self.to<F128Extended>())
        y0   : Self         = seed.to<Self>()
        one  : Self         = big_one()
        y1   : Self         = y0.add(y0.mul(one.sub(self.mul(y0))))
        y2   : Self         = y1.add(y1.mul(one.sub(self.mul(y1))))
        return(y2)

/// `self` / `other` for a nonzero `other`, as `self` times the reciprocal of `other`.
/// :param other: The divisor, not zero.
/// :returns: The quotient.
routine F128Big.div(self: Self, other: Self) -> Self
    block entry()
        r : Self = self.mul(other.recip())
        return(r)

/// sqrt for self >= 0: two Newton steps s ← (s + self / s) / 2 from F128Extended's 190 bits.
/// :returns: The square root.
routine F128Big.sqrt(self: Self) -> Self
    block entry()
        zero : Bool = self.is_zero()
        branch zero
            ? return(self)
            : continue
        s0 : Self = F128Extended.to<Self>(self.to<F128Extended>().sqrt())
        s1 : Self = s0.add(self.div(s0)).ldexp(-1)
        s2 : Self = s1.add(self.div(s1)).ldexp(-1)
        return(s2)

// -- series --------------------------------------------------------------------

/// Whether a term no longer moves a sum: |term| < 2^-(BIG_BITS + 8) |sum|.
/// :param term: The next term.
/// :param sum: The sum so far.
/// :returns: True when `term` is zero, or below that bound and `sum` is nonzero.
routine big_is_negligible(term: F128Big, sum: F128Big) -> Bool
    block entry()
        zero        : Bool = term.is_zero()
        sum_top     : S64  = sum.top()
        floor       : S64  = sum_top.sub(BIG_BITS.to<S64>()).sub(8)
        tiny        : Bool = term.top().lt(floor)
        sum_nonzero : Bool = sum.is_zero().bitnot()
        r           : Bool = zero.bitor(sum_nonzero.bitand(tiny))
        return(r)

// -- exp, exp_m1 ---------------------------------------------------------------

/// e^x for |x| < 2^15: x = q ln 2 + r with ln 2 in two parts, then e^(r / 256) by its Taylor series and 8
/// squarings (each doubles the relative error, to about 2^-438 in all).
/// :param x: The exponent, |x| < 2^15.
/// :returns: e^x.
routine big_exp(x: F128Big) -> F128Big
    shared x_over_ln2 : F128Extended = x.to<F128Extended>().mul(wide_const(1))
    shared q          : S64          = x_over_ln2.to_nearest<S64>()
    shared r          : F128Big      = x.sub(big_ln2_hi().mul(q)).sub(big_ln2_lo().mul(q))
    shared small      : F128Big      = r.ldexp(-8)

    block entry()
        one : F128Big = big_one()
        jump series(1, small, one.add(small))

    // term = small^j / j!
    block series(j: U64, term: F128Big, sum: F128Big)
        next : F128Big = term.mul(small).div(j.add(1))
        done : Bool    = big_is_negligible(next, sum)
        branch done
            ? square(0, sum)
            : series(j.add(1), next, sum.add(next))

    block square(i: S64, e: F128Big)
        done : Bool = i.ge(8)
        branch done
            ? return(e.ldexp(q))
            : square(i.add(1), e.mul(e))

/// e^x - 1 without cancellation: below 2^-20 its own series x Σ x^j / (j+1)!, else e^x - 1, which loses at most
/// 21 of the 448 bits.
/// :param x: The exponent.
/// :returns: e^x - 1.
routine big_exp_m1(x: F128Big) -> F128Big
    block entry()
        zero  : Bool = x.is_zero()
        small : Bool = x.top().lt(-20)
        when
            zero  -> return(x)
            small -> series(1, x, x)
            else  -> return(big_exp(x).sub(big_one()))

    // term = x^j / j!
    block series(j: U64, term: F128Big, sum: F128Big)
        next : F128Big = term.mul(x).div(j.add(1))
        done : Bool    = big_is_negligible(next, sum)
        branch done
            ? return(sum)
            : series(j.add(1), next, sum.add(next))

// -- ln, ln_1p -----------------------------------------------------------------

/// ln x for x > 0: x = m 2^e with m in [sqrt(1/2), sqrt(2)), ln m from F128Extended's log (about 135 bits), then
/// two Newton steps y ← y + m e^-y - 1. Near 1, where ln m is small, ln_1p of m - 1 keeps it accurate.
/// :param x: The argument, positive.
/// :returns: ln x.
routine big_ln(x: F128Big) -> F128Big
    shared top      : S64          = x.top()
    shared m0       : F128Big      = x.ldexp(0.sub(top))  // in [1, 2)
    shared sqrt_two : F128Extended = wide_const(2).ldexp(1)
    shared high     : Bool         = m0.to<F128Extended>().hi.ge(sqrt_two.hi)
    shared m        : F128Big      = high
        ? m0.ldexp(-1)
        : m0
    shared e : S64 = high
        ? top.add(1)
        : top

    block entry()
        one  : F128Big = big_one()
        u    : F128Big = m.sub(one)  // exact
        near : Bool    = e.eq(0).bitand(u.is_zero().bitor(u.top().lt(-20)))
        branch near
            ? return(big_ln_1p(u))
            : newton()

    block newton()
        one  : F128Big = big_one()
        y0   : F128Big = F128Extended.to<F128Big>(wide_log(m.to<F128Extended>()))
        y1   : F128Big = y0.add(m.mul(big_exp(y0.neg())).sub(one))
        y2   : F128Big = y1.add(m.mul(big_exp(y1.neg())).sub(one))
        k_hi : F128Big = big_ln2_hi().mul(e)
        k    : F128Big = k_hi.add(big_ln2_lo().mul(e))
        r    : F128Big = y2.add(k)
        return(r)

/// ln(1 + u) for u > -1: below 2^-20 its series u - u²/2 + u³/3 - …, else ln of 1 + u.
/// :param u: The argument, above -1.
/// :returns: ln(1 + u).
routine big_ln_1p(u: F128Big) -> F128Big
    block entry()
        zero  : Bool = u.is_zero()
        small : Bool = u.top().lt(-20)
        when
            zero  -> return(u)
            small -> series(1, u, u)
            else  -> return(big_ln(big_one().add(u)))

    // power = u^j, and the next term is (-1)^j u^(j+1) / (j+1)
    block series(j: U64, power: F128Big, sum: F128Big)
        next_power : F128Big = power.mul(u)
        term       : F128Big = next_power.div(j.add(1))
        odd        : Bool    = j.bitand(1).eq(1)
        signed     : F128Big = odd
            ? term.neg()
            : term
        done : Bool = big_is_negligible(term, sum)
        branch done
            ? return(sum)
            : series(j.add(1), next_power, sum.add(signed))

/// ln `x` / ln `base` in F128Big (within about 2^-430 relative), rounded to an F128 that narrows correctly to a binary
/// format with `fraction_bits` fraction bits: the last tier of F32.log and F64.log, whose results are normal. The
/// nearest F128 narrows to the nearest value of the quotient unless it is exactly a midpoint of the narrow format
/// (double rounding), so there the F128 one step toward the F128Big quotient is taken instead.
/// :param x: The argument, positive and finite, not 1.
/// :param base: The base, positive and finite, not 1.
/// :param fraction_bits: The narrow format's fraction bits: 23 for F32, 52 for F64.
/// :returns: An F128 whose nearest value in the narrow format is the correctly rounded quotient.
/// :note: The quotient is never exactly a midpoint of F32 or F64: ln x / ln base = p / q in lowest terms means
///     x^q = base^p, so x and base are powers c^p and c^q of one rational c. A midpoint needs q a power of 2 and p
///     odd with at least 25 bits (54 for F64), and c^p is then no F128 (an odd prime of c to that power, or a power
///     of 2 far out of range) unless c = 1, which base = c^q rules out.
routine big_log_ratio(x: F128, base: F128, fraction_bits: U128) -> F128
    shared quotient : F128Big = big_ln(x.to<F128Big>()).div(big_ln(base.to<F128Big>()))
    shared nearest  : F128    = quotient.to<F128>()

    block entry()
        dropped : U128 = U128.sub(112, fraction_bits)
        half    : U128 = U128.shl(1, dropped.sub(1))
        low     : U128 = nearest.bits().bitand(half.shl(1).sub(1))
        branch low.eq(half)
            ? nudge()
            : return(nearest)

    // a midpoint of the narrow format: step off it toward the quotient, so the narrowing rounds the right way
    block nudge()
        gap   : F128Big = quotient.sub(nearest.to<F128Big>())
        exact : Bool    = gap.is_zero()
        below : Bool    = gap.negative
        when
            exact -> return(nearest)
            below -> return(nearest.next_down())
            else  -> return(nearest.next_up())

// -- sin, cos ------------------------------------------------------------------

/// |x| = k π/2 + θ with k mod 4 and |θ| <= π/4, for a finite nonzero x.
record BigReduced
    quadrant : U64
    theta    : F128Big

/// sin θ = θ Σ (-θ²)^k / (2k+1)! for |θ| <= π/4.
/// :param t: θ, with |θ| <= π/4.
/// :returns: sin θ.
routine big_sin_core(t: F128Big) -> F128Big
    block entry()
        zero : Bool = t.is_zero()
        branch zero
            ? return(t)
            : continue
        u : F128Big = t.mul(t).neg()
        jump series(1, t, t, u)

    // term = θ (-θ²)^k / (2k+1)!, and j = 2k + 1
    block series(j: U64, term: F128Big, sum: F128Big, u: F128Big)
        next : F128Big = term.mul(u).div(j.add(1).mul(j.add(2)))
        done : Bool    = big_is_negligible(next, sum)
        branch done
            ? return(sum)
            : series(j.add(2), next, sum.add(next), u)

/// cos θ = Σ (-θ²)^k / (2k)! for |θ| <= π/4.
/// :param t: θ, with |θ| <= π/4.
/// :returns: cos θ.
routine big_cos_core(t: F128Big) -> F128Big
    block entry()
        one  : F128Big = big_one()
        zero : Bool    = t.is_zero()
        branch zero
            ? return(one)
            : continue
        u : F128Big = t.mul(t).neg()
        jump series(0, one, one, u)

    // term = (-θ²)^k / (2k)!, and j = 2k
    block series(j: U64, term: F128Big, sum: F128Big, u: F128Big)
        next : F128Big = term.mul(u).div(j.add(1).mul(j.add(2)))
        done : Bool    = big_is_negligible(next, sum)
        branch done
            ? return(sum)
            : series(j.add(2), next, sum.add(next), u)

/// Reduces |x| by π/2 (Payne-Hanek). With |x| = m × 2^(e - 112), the bits of 2/π that land below 4 are a window W
/// of 14 limbs (896 bits) from limb s on: |x| × 2/π mod 4 = m W × 2^-sh. The bits above sh give the quadrant, the
/// ones below it the fraction, accurate to about 2^-650 absolute: far past any F128's distance to a multiple of
/// π/2, so θ keeps its 448 bits.
/// :param x: The argument, finite and nonzero.
/// :returns: The quadrant `k` mod 4 and θ.
routine big_reduce(x: F128) -> BigReduced
    shared p    : F128Parts   = f128_unpack(x.bits())
    shared w    : @BigNat<24> <- uninit
    shared prod : @BigNat<24> <- uninit
    // f = F × 2^-sh with F the bits under sh. Past 1/2, count the next quadrant and use f - 1
    shared f : @BigNat<16> <- uninit
    shared q : @U64        <- uninit

    block entry()
        small : Bool = p.exponent.lt(-1)  // |x| < 1/2 < π/4
        branch small
            ? near_zero()
            : window()

    block near_zero()
        r : BigReduced = BigReduced { quadrant: 0, theta: F128.to<F128Big>(x.abs()) }
        return(r)

    block window()
        bits_above  : S64   = p.exponent.sub(114).max(0)
        s           : USize = bits_above.div(64).to<USize>()
        window_bits : USize = s.add(14).mul(64)
        window_gap  : S64   = window_bits.to<S64>().sub(p.exponent)
        sh          : S64   = window_gap.add(112)
        w.set(U64.MIN)
        jump load(0, s, sh)

    // limb k of W, least significant first, is TWO_OVER_PI[s + 13 - k]
    block load(k: USize, s: USize, sh: S64)
        done : Bool = k.ge(14)
        branch done
            ? multiply(sh)
            : load_one(k, s, sh)

    block load_one(k: USize, s: USize, sh: S64)
        limb : U64 = TWO_OVER_PI.getitem(s.add(13).sub(k))
        w.push_limb(limb)
        jump load(k.add(1), s, sh)

    block multiply(sh: S64)
        claim m : @BigNat<24> <- uninit
        w.trim()
        m.set(p.sig)
        prod.set_product(m, w)
        at        : USize = sh.to<USize>()
        whole_low : U64   = prod.bits128(at).to_wrap<U64>()
        quadrant  : U64   = whole_low.bitand(3)
        past_half : Bool  = prod.has_bit(at.sub(1))
        f.set(U64.MIN)
        quadrant.store_into(q)
        jump fraction(0, at, past_half)

    // copy the bits under sh into f, 64 at a time from the bottom (sh is a whole number of limbs past any
    // leftover bits, which bits128 reads across)
    block fraction(i: USize, at: USize, past_half: Bool)
        pos  : USize = i.mul(64)
        done : Bool  = pos.ge(at)
        branch done
            ? trim(at, past_half)
            : fraction_one(i, at, past_half)

    block fraction_one(i: USize, at: USize, past_half: Bool)
        pos  : USize = i.mul(64)
        left : USize = at.sub(pos)
        word : U64   = prod.bits128(pos).to_wrap<U64>()
        mask : U64   = U64.MAX.shr(64.sub(left.min(64)).to<U64>())
        f.push_limb(word.bitand(mask))
        jump fraction(i.add(1), at, past_half)

    block trim(at: USize, past_half: Bool)
        f.trim()
        branch past_half
            ? complement(at)
            : scale(false, at, f)

    // f - 1 = -(2^sh - F) × 2^-sh, taken exactly before any rounding
    block complement(at: USize)
        claim c : @BigNat<16> <- uninit
        one : U64 = 1
        c.set(one)
        c.shl(at)
        c.sub(f)
        q.store(q.load().add_wrap(1).bitand(3))
        jump scale(true, at, c)

    block scale(negative: Bool, at: USize, g: @BigNat<16>)
        frac : F128Big    = big_make(negative, 0.sub(at.to<S64>()), g)
        r    : BigReduced = BigReduced { quadrant: q.load(), theta: frac.mul(big_half_pi()) }
        return(r)
