# Tessera stdlib: the correctly rounded arc sine of BF16 divided by pi
#
# Evaluated in B32 like asin: an odd degree-5 minimax polynomial for asin on [0, 0.25] and an odd degree-7 one on
# [0.25, 0.5], and for |x| >= 0.5 the reduction asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2)), with the result scaled
# by 1/pi. Round to nearest only: |x| > 1, an infinity and NaN give the default NaN.
#
# Ported from CORE-MATH, src/binaryb16/asinpi/asinpi_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The arc sine of `me` divided by pi, in [-0.5, 0.5], correctly rounded (to nearest, ties to even). An input with
### |x| > 1, an infinity and NaN give the default NaN (bits 0xFFC0), and +-0 comes back as itself.
### :returns: asin(`me`) / pi.
routine BF16.asin_pi_unchecked() -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    local negative: Bool = u >> 31 != 0

    # NaN, infinity or |x| >= 1
    if au >= 0x3F800000
        if au == 0x3F800000
            if u == 0x3F800000
                return 0.5
            return -0.5
        # The C code's NaN test never holds, so a NaN takes this path too: 0/0, the default NaN.
        return Me.from_bits(0xFFC0)

    # For |x| < 0.5 t is not reduced to -t: the odd polynomials hold on the negative side too.
    reduce: Bool = au >= 0x3F000000
    t: B32 = when
        # argument reduction: asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2))
        reduce => (B32.sub_unchecked(1.0, B32.from_bits(au)) *! 0.5).sqrt_unchecked()
        else => v
    ta: U32 = t.bits() & 0x7FFFFFFF

    # now 0 <= |t| <= 0.5
    y: B32 = when
        ta < 0x3E800000 =>
            # For |x| < 0x1.58p-7 asinpi(x) rounds like x/pi (the B32 product) in every rounding mode.
            if ta < 0x3C2C0000 and not reduce
                if ta == 0
                    return me
                # |x| = 0x1.92p-125: the result directly, which avoids a spurious underflow
                if ta == 0x01490000
                    if negative
                        return B32.to[Me](-0x1.ffd7ap-127)
                    return B32.to[Me](0x1.ffd7ap-127)
                return (v *! 0x1.45f306p-2).to_unchecked[Me]()
            tt: B32 = t *! t
            c1: B32 = B32.mul_add_unchecked(0x1.43696ep-4, a: tt, b: 0x1.552e8ep-3)
            becomes c1.mul_add_unchecked(a: tt, b: 1.0)
        else =>
            # 0.25 <= t <= 0.5
            tt: B32 = t *! t
            c5: B32 = B32.mul_add_unchecked(0x1.08e44p-4, a: tt, b: 0x1.258e54p-4)
            c1: B32 = B32.mul_add_unchecked(0x1.55a7ep-3, a: tt, b: 1.0)
            becomes c5.mul_add_unchecked(a: tt *! tt, b: c1)
    # asin(t), then times 1/pi
    ty: B32 = t *! y *! 0x1.45f306p-2
    if not reduce
        return ty.to_unchecked[Me]()

    # argument reconstruction
    r: B32 = B32.sub_unchecked(0.5, ty *! 2.0)
    if negative
        return (-r).to_unchecked[Me]()
    return r.to_unchecked[Me]()
