# Tessera stdlib: the correctly rounded square root of BF16
#
# The B32 square root of x is correctly rounded and has more than twice BF16's precision, so rounding it once more
# to BF16 gives the correctly rounded result. Round to nearest only: +-0 and +inf map to themselves, a negative x
# gives NaN, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/sqrt/sqrt_bf16.c.
# Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The square root of `me`, correctly rounded (to nearest, ties to even). +-0 and +inf map to themselves, a value
### below zero gives NaN, and a NaN comes back quiet.
### :returns: sqrt(`me`).
routine BF16.sqrt_unchecked() -> Me
    # B32 carries 24 bits, more than 2 * 8 + 2, so the double rounding through B32 is harmless.
    return me.to[B32]().sqrt_unchecked().to[Me]()
