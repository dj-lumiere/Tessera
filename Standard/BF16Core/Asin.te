# Tessera stdlib: the correctly rounded arc sine of BF16
#
# Evaluated in B32: an odd degree-5 minimax polynomial on [0, 0.25] and an odd degree-7 one on [0.25, 0.5], and for
# |x| >= 0.5 the reduction asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2)). Round to nearest only: |x| > 1, an infinity
# and NaN give the default NaN.
#
# Ported from CORE-MATH, src/binaryb16/asin/asin_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The arc sine of `me` in radians, in [-pi/2, pi/2], correctly rounded (to nearest, ties to even). An input with
### |x| > 1, an infinity and NaN give the default NaN (bits 0xFFC0), and +-0 comes back as itself.
### :returns: asin(`me`).
routine BF16.asin_unchecked() -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    local negative: Bool = u >> 31 != 0

    # NaN, infinity or |x| >= 1
    if au >= 0x3F800000
        if au == 0x3F800000
            if u == 0x3F800000
                return B32.to[Me](0x1.921fb6p+0)
            return B32.to[Me](-0x1.921fb6p+0)
        # The C code's NaN test never holds, so a NaN takes this path too: 0/0, the default NaN.
        return Me.from_bits(0xFFC0)

    # For |x| < 0.5 t is not reduced to -t: the odd polynomials hold on the negative side too.
    reduce: Bool = au >= 0x3F000000
    t: B32 = when
        reduce =>
            pos: B32 = when
                negative => -v
                else => v
            # argument reduction: asin(x) = pi/2 - 2 asin(sqrt((1 - x)/2))
            becomes (B32.sub_unchecked(1.0, pos) *! 0.5).sqrt_unchecked()
        else => v
    ta: U32 = t.bits() & 0x7FFFFFFF

    # now 0 <= |t| <= 0.5
    y: B32 = when
        ta < 0x3E800000 =>
            # For |x| <= 0x1.dp-4 asin(x) rounds to x to nearest. The product keeps a subnormal power of two
            # underflowing, as in C.
            if ta <= 0x3DE80000 and not reduce
                if ta == 0
                    return me
                return (v *! 0x1.000002p+0).to[Me]()
            tt: B32 = t *! t
            c1: B32 = B32.mul_add_unchecked(0x1.43696ep-4, a: tt, b: 0x1.552e8ep-3)
            becomes c1.mul_add_unchecked(a: tt, b: 1.0)
        else =>
            # 0.25 <= t <= 0.5
            tt: B32 = t *! t
            c5: B32 = B32.mul_add_unchecked(0x1.08e44p-4, a: tt, b: 0x1.258e54p-4)
            c1: B32 = B32.mul_add_unchecked(0x1.55a7ep-3, a: tt, b: 1.0)
            becomes c5.mul_add_unchecked(a: tt *! tt, b: c1)
    ty: B32 = t *! y
    if not reduce
        return ty.to[Me]()

    # argument reconstruction
    r: B32 = B32.sub_unchecked(0x1.921fb6p+0, ty *! 2.0)
    if negative
        return (-r).to[Me]()
    return r.to[Me]()
