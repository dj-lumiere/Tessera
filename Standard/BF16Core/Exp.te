### e^`me`, correctly rounded (to nearest, ties to even). Overflow gives +inf, underflow +0, and NaN comes back quiet.
### :returns: e^`me`.
routine BF16.exp() -> Me
    u: U16 = me.bits()
    au: U16 = u & 0x7FFF
    # e^x rounds to 1 for |x| <= 2^-9.
    if au <= 0x3B00
        return 1.0
    if au >= 0x42BA
        # |x| >= 0x1.74p+6: e^x overflows or rounds to 0, unless x is an infinity or NaN.
        if au >= 0x7F80
            if u == 0xFF80
                return 0.0
            return me + me
        if au == u
            return BF16.INFINITY
        return 0.0
    # The exponent lies in [118, 133], so au takes 11 bits.
    sign: U16 = u >> 15
    i1: U16 = (sign << 8) + (au >> 3) - 0x760
    i2: U16 = (sign << 7) + (((au >> 7) << 3) | (au & 0x7)) - 0x3B0
    t1: B32 = B32.from_bits(CM_BF16_EXP_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_EXP_T2.getitem(i2.to[U64]()))
    return (t1 * t2).to[Me]()
