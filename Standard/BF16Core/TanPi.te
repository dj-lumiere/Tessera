# Tessera stdlib: the correctly rounded tan(pi x) of BF16
#
# Integers and half-integers are settled from the encoding (a signed zero or a signed infinity). Otherwise x = x1 +
# x2, where x1 keeps the exponent and the upper 4 bits of the mantissa and x2 the exponent and the lower 3 bits, and
# tan(pi x) = sin(pi x) / cos(pi x), both expanded by the addition formulas over the B32 tables of sin and cos of
# pi x1 and pi x2 in SinPi.te, and the B32 quotient rounds once to BF16. Near 0, tan(pi x) rounds like pi x but for
# four inputs. Round to nearest only.
#
# Ported from CORE-MATH, src/binaryb16/tanpi/tanpi_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The mask of the fraction bits of a BF16 with biased exponent 126 + i, i = the index: 0xFFFF for |x| in [1/2, 1),
### where the bit of weight 1 is not in the encoding, then 0x7F for |x| in [1, 2) down to 0 for |x| in [128, 256).
preset CM_BF16_TAN_PI_M: @Array[U16, 9] <- [0xFFFF, 0x7F, 0x3F, 0x1F, 0xF, 0x7, 0x3, 0x1, 0x0]

### tan(pi `me`), correctly rounded (to nearest, ties to even). An integer n gives +0 for a positive even n or a
### negative odd one and -0 otherwise (+-0 comes back unchanged), n + 1/2 gives +inf for an even n and -inf for an
### odd one (n of |x|, the sign flipped for a negative `me`), +-inf and a quiet NaN give the NaN 0xFFC0, and a
### signaling NaN comes back quiet (0x7F81 and 0xFF81 give 0xFFC0 too).
### :returns: tan(pi `me`).
routine BF16.tan_pi() -> Me
    local u: U16 = me.bits()
    local au: U16 = u & 0x7FFF
    local positive: Bool = au == u
    local sign: B32 = when
        positive => 1.0
        else => -1.0

    if au >= 0x3F00
        # |x| >= 1/2, so x might be an integer or a half-integer
        if au >= 0x7F80
            # NaN or infinity. 0xFFC0 is what the C code's 0.0f / 0.0f gives on x86.
            if au > 0x7F81 and au < 0x7FC0
                return me + me
            return Me.from_bits(0xFFC0)
        e: U16 = au >> 7  # 126 <= e <= 254
        if e >= 134 or au & CM_BF16_TAN_PI_M.getitem((e - 126).to[U64]()) == 0
            # x is an integer: tan(pi (2n+1)) = -0 and tan(pi (2n+2)) = +0, the other way round for negative x. For
            # 2^7 <= |x| < 2^8, where ulp(x) = 1, e = 134, so the bit of weight 1 is bit 134 - e of au.
            even: Bool = when
                e >= 135 => true
                else => au & U16.shl(1, U16.sub(134, e)) == 0
            if even == positive
                return 0.0
            return Me.from_bits(0x8000)
        if au & CM_BF16_TAN_PI_M.getitem((e - 125).to[U64]()) == 0
            # x is a half-integer. |x| = 1/2 is apart because its bit of weight 1/2 is not in the encoding.
            near_even: Bool = when
                e == 126 => true
                else => au & U16.shl(1, U16.sub(134, e)) == 0
            # near_even says |x| = 2n + 1/2
            if near_even == positive
                return Me.INFINITY
            return Me.NEG_INFINITY
    # now |x| < 2^6 and x is neither an integer nor a half-integer
    if au < 0x3B00
        # |x| < 2^-9
        if au == 0
            return me
        # pi x rounds correctly except for |x| = 0x1.c4p-13, 0x1.c4p-12, 0x1.c4p-11 and 0x1.c4p-10
        when au
            0x3962 => return (sign * 0x1.630002p-11).to[Me]()
            0x39E2 => return (sign * 0x1.63000cp-10).to[Me]()
            0x3A62 => return (sign * 0x1.630036p-9).to[Me]()
            0x3AE2 => return (sign * 0x1.6300e2p-8).to[Me]()
            else => pass
        pi24: B32 = 0x1.921fb6p+1
        small: B32 = pi24 * me.to[B32]()
        return small.to[Me]()
    # now 2^-9 <= |x| < 2^6, the exponent lies in [118, 132], and 0x3B00 is 118 << 7, so i1 < 240 and i2 < 120
    i1: U16 = (au - 0x3B00) >> 3
    i2: U16 = (((au - 0x3B00) >> 7) << 3) | (au & 0x7)
    s1: B32 = .from_bits(CM_BF16_SIN_PI_S1.getitem(i1.to[U64]()))
    c1: B32 = .from_bits(CM_BF16_SIN_PI_C1.getitem(i1.to[U64]()))
    s2: B32 = .from_bits(CM_BF16_SIN_PI_S2.getitem(i2.to[U64]()))
    c2: B32 = .from_bits(CM_BF16_SIN_PI_C2.getitem(i2.to[U64]()))
    # the fmas fix the evaluation order
    s: B32 = s1.mul_add(a: c2, b: c1 * s2)
    c: B32 = c1.mul_add(a: c2, b: -s1 * s2)
    return (sign * (s / c)).to[Me]()
