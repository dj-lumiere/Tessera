# Tessera stdlib: the correctly rounded arc cosine of BF16
#
# Evaluated in B32 on t = |x|: degree-4 minimax polynomials for acos(t) on [0, 0.25] and [0.25, 0.5], and for
# acos(t)/sqrt(1 - t) on [0.5, 1], with acos(-t) = pi - acos(t) for a negative x. Round to nearest only: |x| > 1, an
# infinity and NaN give the default NaN.
#
# Ported from CORE-MATH, src/binaryb16/acos/acos_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The arc cosine of `me` in radians, in [0, pi], correctly rounded (to nearest, ties to even). An input with
### |x| > 1, an infinity and NaN give the default NaN (bits 0xFFC0).
### :returns: acos(`me`).
routine BF16.acos_unchecked() -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF
    local negative: Bool = u >> 31 != 0

    # NaN, infinity or |x| >= 1
    if au >= 0x3F800000
        if au == 0x3F800000
            if u == 0x3F800000
                return 0.0
            return B32.to[Me](0x1.921fb6p+1)
        # The C code's NaN test never holds, so a NaN takes this path too: 0/0, the default NaN.
        return Me.from_bits(0xFFC0)

    t: B32 = when
        negative => -v
        else => v

    y: B32 = when
        au < 0x3E800000 =>
            # |x| < 0.25. For |x| <= 0x1.fap-12 acos(x) rounds like pi/2 in every rounding mode, and returning it
            # avoids a spurious underflow for a tiny x.
            if au <= 0x39FD0000
                return B32.to[Me](0x1.921fb6p+0)
            c1: B32 = B32.mul_add_unchecked(-0x1.25e6b8p-10, a: t, b: -0x1.fffb44p-1)
            c3: B32 = B32.mul_add_unchecked(-0x1.a85b22p-5, a: t, b: -0x1.3cc114p-3)
            p: B32 = c3.mul_add_unchecked(a: t *! t, b: c1)
            becomes p.mul_add_unchecked(a: t, b: 0x1.921fb4p+0)
        au < 0x3F000000 =>
            # 0.25 <= |x| < 0.5
            c1: B32 = B32.mul_add_unchecked(-0x1.bd043ap-4, a: t, b: -0x1.f515cap-1)
            c3: B32 = B32.mul_add_unchecked(-0x1.190806p-2, a: t, b: 0x1.7e2d5ap-4)
            p: B32 = c3.mul_add_unchecked(a: t *! t, b: c1)
            becomes p.mul_add_unchecked(a: t, b: 0x1.91b678p+0)
        else =>
            # 0.5 <= |x| < 1: the polynomial approximates acos(t)/sqrt(1 - t)
            c1: B32 = B32.mul_add_unchecked(0x1.31640cp-4, a: t, b: -0x1.ae5c5ep-3)
            c3: B32 = B32.mul_add_unchecked(0x1.251b5p-8, a: t, b: -0x1.98038p-6)
            p: B32 = c3.mul_add_unchecked(a: t *! t, b: c1)
            q: B32 = p.mul_add_unchecked(a: t, b: 0x1.91fa1cp+0)
            becomes B32.sub_unchecked(1.0, t).sqrt_unchecked() *! q

    # acos(-x) = pi - acos(x)
    if negative
        return B32.sub_unchecked(0x1.921fb6p+1, y).to_unchecked[Me]()
    return y.to_unchecked[Me]()
