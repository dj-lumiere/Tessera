### log2(1 + `me`), accurate near 0 and correctly rounded (to nearest, ties to even). log2_1p(-1) = -inf, `me` < -1
### (-inf and a negative NaN included) gives the quiet NaN, log2_1p(+inf) = +inf, and a positive NaN comes back quiet.
### :returns: log2(1 + `me`).
routine BF16.log2_1p() -> Me
    v: B32 = me.to[B32]()
    u: U32 = v.bits()
    au: U32 = u & 0x7FFFFFFF
    if u >= 0xBF800000
        # x <= -1, and every negative NaN: -1 gives -inf, the rest the quiet NaN.
        if u == 0xBF800000
            return BF16.NEG_INFINITY
        return BF16.NAN
    if u >> 23 == 0xFF
        # +inf or a positive NaN
        return me + me
    if au >= 0x45B60000
        # For x >= 0x1.6cp+12, log2(1 + x) rounds to the same value as log2(x), except when x is a power of 2: then
        # i2 = 0, and entry 0 of CM_BF16_LOG2P1_T2 is slightly above 0 so that this also rounds correctly upward.
        i1: U64 = (u >> 23).to[U64]()
        i2: U64 = ((u >> 16) & 0x7F).to[U64]()
        t1: B32 = B32.from_bits(CM_BF16_LOG2_T1.getitem(i1))
        t2: B32 = B32.from_bits(CM_BF16_LOG2P1_T2.getitem(i2))
        return (t1 + t2).to[Me]()
    if au <= 0x3BA00000
        # For |x| <= 0x1.84p-7 the Taylor terms round correctly. A zero keeps its sign.
        if au == 0
            return me
        return cm_bf16_log2p1_tiny(v).to[Me]()
    # Exact results and hard cases
    when u >> 16
        0x437F => return 8.0
        0x42FE => return 7.0
        0x427C => return 6.0
        0x41F8 => return 5.0
        0x4170 => return 4.0
        0x40E0 => return 3.0
        0x4040 => return 2.0
        0x3F80 => return 1.0
        0xBF00 => return -1.0
        0xBF40 => return -2.0
        0xBF60 => return -3.0
        0xBF70 => return -4.0
        0xBF78 => return -5.0
        0xBF7C => return -6.0
        0xBF7E => return -7.0
        0xBF7F => return -8.0
        0x3C73 => return B32.to[Me](0x1.5c0024p-6)
        else =>
            # Now 0x1.86p-7 <= |x| <= 0x1.6ap+12, so 1 + x is exact in B32.
            w: B32 = v + 1.0
            wb: U32 = w.bits()
            i: U64 = (wb >> 23).to[U64]()
            # Reduce 1 + x to m in [1, 2): log2(1 + x) = (i - 127) + log2(m).
            m: B32 = B32.from_bits((wb & 0x7FFFFF) | 0x3F800000)
            # the upper 6 bits of the fraction of m
            j: U64 = ((m.bits() >> 17) & 0x3F).to[U64]()
            r: B32 = B32.from_bits(CM_BF16_LOG2P1_R.getitem(j * 2))
            logr: B32 = B32.from_bits(CM_BF16_LOG2P1_R.getitem(j * 2 + 1))
            # z = r m - 1 is exact, and r m = 1 + z gives log2(m) = -log2(r) + log2(1 + z).
            z: B32 = r.mul_add(a: m, b: -1.0)
            e: B32 = B32.from_bits(CM_BF16_LOG2P1_R0.getitem(i - 119))
            return (e + (logr + cm_bf16_log2p1_tiny(z))).to[Me]()

### log2(1 + x) for a tiny B32 `x`, by the Taylor terms x/ln(2) - x^2/(2 ln(2)).
### :param x: The tiny argument.
### :returns: The approximation of log2(1 + `x`).
secret routine cm_bf16_log2p1_tiny(x: B32) -> B32
    # 0x1.715476p+0 is 1/ln(2) rounded to B32.
    t: B32 = x * 0x1.715476p+0
    return t.mul_add(a: -0.5 * x, b: t)
