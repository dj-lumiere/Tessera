# Tessera stdlib: the correctly rounded arc tangent of BF16
#
# Evaluated in B32 on t = |x|, reduced to [0, 1] by atan(t) = pi/2 - atan(1/t), with an odd degree-7 minimax
# polynomial on [0, 0.25] and degree-4 ones on [0.25, 0.5], [0.5, 0.75] and [0.75, 1]. Round to nearest only:
# +-inf gives +-pi/2 rounded, NaN comes back quiet.
#
# Ported from CORE-MATH, src/binaryb16/atan/atan_bf16.c.
# Copyright (c) 2025 Paul Zimmermann
# MIT license: see LICENSE-CORE-MATH

module Standard/Core

### The arc tangent of `me` in radians, in [-pi/2, pi/2], correctly rounded (to nearest, ties to even). +-inf gives
### +-pi/2 rounded, +-0 comes back as itself, and NaN comes back quiet.
### :returns: atan(`me`).
routine BF16.atan() -> Me
    local v: B32 = me.to[B32]()
    local u: U32 = v.bits()
    local au: U32 = u & 0x7FFFFFFF

    # For x >= 0x1.04p+11 atan(x) rounds like pi/2, and atan(-x) like -pi/2.
    if au >= 0x45020000
        # NaN, infinity or |x| >= 0x1.04p+11
        if au <= 0x7F800000
            if au == u
                return B32.to[Me](0x1.921fb6p+0)
            return B32.to[Me](-0x1.921fb6p+0)
        return me +! me

    # for x < 0, atan(-x) = -atan(x)
    neg: Bool = u >> 31 != 0
    s: B32 = when
        neg => -1.0
        else => 1.0
    pos: B32 = v *! s

    # now t >= 0. For x > 1, atan(x) = pi/2 - atan(1/x).
    reduce: Bool = au > 0x3F800000
    t: B32 = when
        reduce => B32.truediv_unchecked(1.0, pos)
        else => pos

    # now 0 <= t <= 1
    y: B32 = when
        t <= 0.25 =>
            # For |x| < 0x1.7p-4 atan(x) rounds to x to nearest.
            if not reduce and au <= 0x3DB80000
                if au == 0
                    return me
                return v.mul_add_unchecked(a: -0x1p-25, b: v).to_unchecked[Me]()
            tt: B32 = t *! t
            c5: B32 = B32.mul_add_unchecked(-0x1.0c7c54p-3, a: tt, b: 0x1.98d0e2p-3)
            c1: B32 = B32.mul_add_unchecked(-0x1.55546ep-2, a: tt, b: 1.0)
            c: B32 = c5.mul_add_unchecked(a: tt *! tt, b: c1)
            becomes t *! c
        # the degree-4 polynomial p0 + p1 t + ... + p4 t^4 for the subinterval holding t
        t <= 0.5 =>
            c3: B32 = B32.mul_add_unchecked(0x1.81dd4ap-3, a: t, b: -0x1.a6fc8ep-2)
            c2: B32 = c3.mul_add_unchecked(a: t, b: 0x1.1ee658p-6)
            y0: B32 = B32.mul_add_unchecked(0x1.ff0772p-1, a: t, b: 0x1.411628p-14)
            becomes c2.mul_add_unchecked(a: t *! t, b: y0)
        t <= 0.75 =>
            c3: B32 = B32.mul_add_unchecked(0x1.a5eb88p-4, a: t, b: -0x1.e70ab4p-3)
            c2: B32 = c3.mul_add_unchecked(a: t, b: -0x1.e652e2p-4)
            y0: B32 = B32.mul_add_unchecked(0x1.0bad76p+0, a: t, b: -0x1.95964cp-8)
            becomes c2.mul_add_unchecked(a: t *! t, b: y0)
        else =>
            c3: B32 = B32.mul_add_unchecked(0x1.6aa268p-6, a: t, b: 0x1.d18c96p-13)
            c2: B32 = c3.mul_add_unchecked(a: t, b: -0x1.882376p-2)
            y0: B32 = B32.mul_add_unchecked(0x1.2d3d1p+0, a: t, b: -0x1.f75b16p-6)
            becomes c2.mul_add_unchecked(a: t *! t, b: y0)

    # argument reconstruction
    r: B32 = when
        reduce => B32.sub_unchecked(0x1.921fb6p+0, y)
        else => y
    if neg
        return (-r).to_unchecked[Me]()
    return r.to_unchecked[Me]()
