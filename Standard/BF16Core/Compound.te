### The compound function (1 + `me`)^`exponent`, correctly rounded (to nearest, ties to even), accurate when `me` is
### near 0. compound(x, +-0) is 1 for x >= -1 or a quiet NaN, compound(+-0, y) is 1 unless y is a signaling NaN,
### compound(x, y) is NaN for x < -1, compound(-1, y) is +inf for y < 0 and +0 for y > 0, compound(+inf, y) is +inf
### for y > 0 and +0 for y < 0, overflow gives +inf and underflow +0. Any other NaN comes back quiet.
### :param exponent: The power to raise 1 + `me` to.
### :returns: (1 + `me`)^`exponent`.
routine BF16.compound(exponent: Me) -> Me
    local x: B32 = me.to[B32]()
    local y: B32 = exponent.to[B32]()
    local nx: U32 = x.bits()
    local ny: U32 = y.bits()
    local ax: U32 = nx << 1
    local ay: U32 = ny << 1

    # x <= -1 (the bits of -1 are 0xBF800000)
    if nx >= 0xBF800000
        return cm_bf16_compound_special(x: me, y: exponent)
    # now x > -1: x = +-0, +inf, NaN, y = +-0, +-inf or NaN
    if ax == 0 or ax >= 0xFF000000 or ay == 0 or ay >= 0xFF000000
        return cm_bf16_compound_special(x: me, y: exponent)
    xd: B64 = x.to[B64]()
    yd: B64 = y.to[B64]()
    # l approximates log2(1 + x) with relative error < 2^-47.997, and 2^-149 <= |l| < 128
    l: B64 = when
        ax < 0x62000000 =>
            # |x| < 2^-29: log2(1 + x) ~ (x - x^2/2)/log(2), x^2/2 is exact
            t0: B64 = xd - (xd * xd) * 0.5
            becomes B64.mul(0x1.71547652b82fep+0, t0)
        else => cm_bf16_compound_log2p1(xd)
    # 2^-298 <= |t| < 2^135, so neither overflows nor underflows in B64
    t: B64 = l * yd
    tu: U64 = t.bits()
    # |t| >= 128: overflow for t >= 128, underflow for t <= -150
    if (tu << 1) >= 0x80C0000000000000
        if tu >= 0xC062C00000000000
            return B32.mul(0x1p-126, 0x1p-126).to[Me]()
        if tu >> 63 == 0
            return B32.mul(0x1p+126, 0x1p+126).to[Me]()
    # 2^t rounds to 1 when |t| <= 0x1.715476ba97f14p-25
    if (tu << 1) <= 0x3E6715476BA97F14
        if tu >> 63 != 0
            return B32.sub(1.0, 0x1p-25).to[Me]()
        return B32.add(1.0, 0x1p-25).to[Me]()
    exact: Bool = cm_bf16_compound_is_exact(x, y)
    res: Me = cm_bf16_compound_exp2_fast(t)
    if res != -1.0
        return res
    # the fast path's rounding test failed
    return cm_bf16_compound_accurate(x, y, exact)

### compound(x, y) for x <= -1, x = +-0, +-inf or NaN, or y = +-0, +-inf or NaN.
### :param x: The base minus 1.
### :param y: The exponent.
### :returns: (1 + x)^y for those special cases.
@noinline
secret routine cm_bf16_compound_special(x: BF16, y: BF16) -> BF16
    local nx: U16 = x.bits()
    local ny: U16 = y.bits()
    local ax: U16 = nx << 1
    local ay: U16 = ny << 1
    local xf: B32 = x.to[B32]()
    local yf: B32 = y.to[B32]()

    if ax == 0 or ay == 0
        # compound(0, y) = 1 except for y a signaling NaN
        if ax == 0
            if cm_bf16_compound_is_signaling(y)
                return (xf + yf).to[BF16]()
            return 1.0
        # compound(x, 0) = 1 except for x a signaling NaN or x < -1
        if cm_bf16_compound_is_signaling(x)
            return (xf + yf).to[BF16]()
        if xf < -1.0
            return B32.truediv(0.0, 0.0).to[BF16]()
        return 1.0
    # the bits of -1 are 0xBF80
    if ay >= 0xFF00
        # y = +-inf or NaN, x = 0 was handled above
        if ax > 0xFF00
            return (xf + yf).to[BF16]()
        if ay == 0xFF00
            # x < -1 gives NaN
            if nx > 0xBF80
                return B32.truediv(0.0, 0.0).to[BF16]()
            # +0 for (x = -1 or |1 + x| < 1) and y = +inf, or 1 + x > 1 and y = -inf, +inf for the other two
            sy: U16 = ny >> 15
            if nx == 0xBF80
                if sy == 0
                    return 0.0
                return B32.truediv(1.0, 0.0).to[BF16]()
            if xf < 0.0
                if sy == 0
                    return 0.0
                return B32.truediv(1.0, 0.0).to[BF16]()
            if xf > 0.0
                if sy != 0
                    return 0.0
                return B32.truediv(1.0, 0.0).to[BF16]()
            return 1.0
        return (xf + yf).to[BF16]()
    # since -1 < x < 0 can't reach here, this means x = +-inf, NaN, or x <= -1
    if nx >= 0x7F80
        if ax == 0xFF00
            # compound(-inf, y) is NaN, (1 + inf)^y = +inf for y > 0, +0 for y < 0
            if nx >> 15 != 0
                return B32.truediv(0.0, 0.0).to[BF16]()
            if ny >> 15 != 0
                return B32.truediv(1.0, xf).to[BF16]()
            return x
        if ax > 0xFF00
            return (xf + yf).to[BF16]()
        # x < -1 gives NaN
        if nx > 0xBF80
            return B32.truediv(0.0, 0.0).to[BF16]()
        # now x = -1: +inf for y < 0, +0 for y > 0
        if ny >> 15 != 0
            return B32.truediv(1.0, 0.0).to[BF16]()
        return 0.0
    return 0.0

### Whether a BF16 is a signaling NaN.
### :param x: The value.
### :returns: True for a signaling NaN.
secret routine cm_bf16_compound_is_signaling(x: BF16) -> Bool
    u: U16 = x.bits() & 0x7FFF
    return 0x7F80 < u < 0x7FC0

### Whether a B32 is an integer (infinities and NaN count as integers).
### :param y: The value.
### :returns: True for an integer.
secret routine cm_bf16_compound_isint(y: B32) -> Bool
    wy: U32 = y.bits()
    ey: S32 = ((wy >> 23) & 0xFF).to[S32]() - 127
    s: S32 = ey + 9
    if ey >= 0
        if s >= 32
            return true
        return wy << s.to[U32]() == 0
    return wy << 1 == 0

### Coefficient k of the CM_BF16_COMPOUND_P polynomial.
### :param k: The degree.
### :returns: The coefficient.
### :throws: Crashes with `IndexOutOfBoundsError` when `k` is past the table.
secret routine cm_bf16_compound_p(k: U64) -> B64
    return B64.from_bits(CM_BF16_COMPOUND_P.getitem(k))

### An approximation of log2(1 + z) for |z| <= 1/64, with relative error < 2^-49.642.
### :param z: The argument.
### :returns: log2(1 + `z`), less than 2^-5.459 in magnitude.
secret routine cm_bf16_compound_p1(z: B64) -> B64
    z2: B64 = z * z
    c5: B64 = cm_bf16_compound_p(6).mul_add(a: z, b: cm_bf16_compound_p(5))
    c3: B64 = cm_bf16_compound_p(4).mul_add(a: z, b: cm_bf16_compound_p(3))
    c1: B64 = cm_bf16_compound_p(2).mul_add(a: z, b: cm_bf16_compound_p(1))
    z4: B64 = z2 * z2
    d5: B64 = cm_bf16_compound_p(7).mul_add(a: z2, b: c5)
    d1: B64 = c3.mul_add(a: z2, b: c1)
    e1: B64 = d5.mul_add(a: z4, b: d1)
    return z * e1

### An approximation of log2(1 + x) for -1 < x < 2^128, with relative error < 2^-47.997.
### :param x: The argument.
### :returns: log2(1 + `x`).
secret routine cm_bf16_compound_log2p1(x: B64) -> B64
    # For x < 2^53, 1 + x is exact.
    u: B64 = 1.0 + x
    vu: U64 = u.bits()
    m: U64 = vu & 0xFFFFFFFFFFFFF
    # 2^e/sqrt(2) < u < 2^e sqrt(2), with -29 <= e <= 128
    e: S64 = ((vu >> 52).to[S64]() - 0x3FF) + (m >= 0x6A09E667F3BCD).to[S64]()
    # u = 2^e t with 1/sqrt(2) < t < sqrt(2), so log2(u) = e + log2(t)
    t: B64 = B64.from_bits(vu -% (e * 0x10000000000000).to_wrap[U64]())
    # t + 2 lies in the binade [2, 4)
    i: U64 = ((t + 2.0).bits() >> 45) - 0x2002D
    r: B64 = B64.from_bits(CM_BF16_COMPOUND_INV.getitem(i))
    # exact, -1/64 <= z <= 1/64: log2(t) = -log2(r) + log2(r t)
    z: B64 = r.mul_add(a: t, b: -1.0)
    p: B64 = cm_bf16_compound_p1(z)
    return e.to[B64]() + (B64.from_bits(CM_BF16_COMPOUND_LOG2INV.getitem(2 * i)) + p)

### Whether (1 + x)^y is exact or a midpoint in BF16, for x and y not zero. It can be only when (a) y is an integer
### with 0 <= y <= 5, (b) y < 0 with 1 + x = 2^e and |y| = n 2^-k where 2^k divides e, or (c) y = n 2^f with
### -3 <= f <= -1 and 1 <= n <= 5.
### :param x: The base minus 1.
### :param y: The exponent.
### :returns: True when the power is exact or a midpoint.
secret routine cm_bf16_compound_is_exact(x: B32, y: B32) -> Bool
    # ulp(x) = 2^e0, and only 2^-31 <= ulp(x) <= 2^-6 can give an exact or midpoint power
    e0: S32 = ((x.bits() << 1) >> 24).to[S32]() - 0x96
    if e0 < -31 or -6 < e0
        return false
    # the same for 1 + x
    v: U32 = B32.add(1.0, x).bits()
    e1: S32 = ((v << 1) >> 24).to[S32]() - 0x96
    if y >= 0.0 and cm_bf16_compound_isint(y)
        return cm_bf16_compound_is_exact_int(v, e: e1, y)
    # |y| = n 2^f with n odd
    wu: U32 = y.bits()
    f0: S32 = ((wu << 1) >> 24).to[S32]() - 0x96
    n0: U32 = when
        f0 >= -149 => (wu & 0x7FFFFF) | 0x800000
        else => wu & 0x7FFFFF
    f1: S32 = when
        f0 >= -149 => f0
        else => f0 + 1
    tn: U32 = n0.trailing_zeros()
    n: U32 = n0 >> tn
    f: S32 = f1 + tn.to[S32]()
    # |1 + x| = m 2^e with m odd
    m0: U32 = when
        e1 >= -149 => (v & 0x7FFFFF) | 0x800000
        else => v & 0x7FFFFF
    e2: S32 = when
        e1 >= -149 => e1
        else => e1 + 1
    tm: U32 = m0.trailing_zeros()
    m: U32 = m0 >> tm
    e: S32 = e2 + tm.to[S32]()
    if y < 0.0
        # Only (a) y an integer and 1 + x = 2^e, or (b) y = -n/2^k with k >= 1 and 2^k dividing e.
        if m != 1
            return false
        # in case (a) f >= 0, in case (b) f < 0 and k = -f
        te: S32 = e.to_wrap[U32]().trailing_zeros().to[S32]()
        if -f > te
            return false
        ez: S32 = when
            e >= 0 and f >= 0 => (-(e << f)) *% n.to_wrap[S32]()
            e >= 0 => (-(e >> (-f))) *% n.to_wrap[S32]()
            f >= 0 => ((-e) << f) *% n.to_wrap[S32]()
            else => ((-e) >> (-f)) *% n.to_wrap[S32]()
        return -133 <= ez < 128
    # Now y > 0 is no integer, y = n 2^f with n odd and f < 0. As x^(n 2^f) = (x^(2^f))^n with n odd, x is an exact
    # (2^k)th power with k = -f, so a square: m is a square and e is even.
    while f2 != 0 with f2: S32 = f, e3: S32 = e, m1: U32 = m
        if e3 & 1 != 0
            return false
        dm: B32 = m1.to[B32]()
        s: B32 = dm.sqrt().round()
        if s * s != dm
            return false
        continue with f2: f2 + 1, e3: e3.div_trunc(2), m1: s.to[U32]()
    then
        return cm_bf16_compound_is_exact_odd(m: m1, e: e3, n)

### The end of cm_bf16_compound_is_exact for y >= 0 an integer: (1 + x)^y with 1 + x = m 2^e, m odd, is exact for
### y = 0 or 1, for m = 1 and -133 <= e y < 128, and for 2 <= y <= 5 when m^y fits in 9 bits.
### :param v: The B32 bits of 1 + x.
### :param e: The exponent of the ulp of 1 + x.
### :param y: The exponent of the power, a nonnegative integer.
### :returns: True when the power is exact or a midpoint.
secret routine cm_bf16_compound_is_exact_int(v: U32, e: S32, y: B32) -> Bool
    m0: U32 = (v & 0x7FFFFF) | 0x800000
    t: U32 = m0.trailing_zeros()
    m: U32 = m0 >> t
    e1: S32 = e + t.to[S32]()
    # 1 + x = m 2^e1
    if y == 0.0 or y == 1.0
        return y == 0.0 or t >= 16
    if m == 1
        ye: B32 = y * e1.to[B32]()
        return -133.0 <= ye < 128.0
    # now for y < 0 or 5 < y it can't be exact
    if y < 0.0 or 5.0 < y
        return false
    y_int: S32 = y.to[S32]()
    if m > CM_BF16_COMPOUND_XMAX.getitem(y_int.to[U64]())
        return false
    # |x^y| = m^y 2^(e1 y)
    each i: S32 in 2 til y_int with my: U64 = (m *% m).to[U64]()
        continue with my: my *% m.to[U64]()
    then
        # 2^(t2 - 1) <= m^y < 2^t2, so 2^(e1 y + t2 - 1) <= |x^y| < 2^(e1 y + t2)
        t2: S32 = 32 - my.to_wrap[U32]().leading_zeros().to[S32]()
        ez: S32 = e1 * y_int + t2
        if ez <= -133 or 128 < ez
            return false
        # m is odd, so x^y is an odd multiple of 2^(e1 y)
        return e1 * y_int >= -133

### The end of cm_bf16_compound_is_exact for y > 0 not an integer: |x^y| = (m 2^e)^n with m and n odd.
### :param m: The odd part of the base's root.
### :param e: The exponent of the base's root.
### :param n: The odd numerator of y.
### :returns: True when the power is exact or a midpoint.
secret routine cm_bf16_compound_is_exact_odd(m: U32, e: S32, n: U32) -> Bool
    # for 5 < n it can't be exact, unless m = 1
    if m > 1
        if 5 < n
            return false
        if m > CM_BF16_COMPOUND_XMAX.getitem(n.to[U64]())
            return false
    # |x^y| = m^n 2^(e n)
    while n0 > 1 with n0: U32 = n, my: U32 = m
        continue with n0: n0 - 1, my: my *% m
    then
        # t significant bits of m^n: x^y is an odd multiple of 2^(e n), so e n >= -133, and e n + t <= 128
        t: S32 = 32 - my.leading_zeros().to[S32]()
        en: S32 = e * n.to_wrap[S32]()
        return -133 <= en and en + t <= 128

### Entry k of CM_BF16_COMPOUND_Q.
### :param k: The degree.
### :returns: The coefficient.
### :throws: Crashes with `IndexOutOfBoundsError` when `k` is past the table.
secret routine cm_bf16_compound_q(k: U64) -> B64
    return B64.from_bits(CM_BF16_COMPOUND_Q.getitem(k))

### An approximation of 2^z for |z| <= 2^-6, with absolute error < 2^-43.549.
### :param z: The argument.
### :returns: 2^`z`.
secret routine cm_bf16_compound_q1(z: B64) -> B64
    z2: B64 = z * z
    c3: B64 = cm_bf16_compound_q(4).mul_add(a: z, b: cm_bf16_compound_q(3))
    c0: B64 = cm_bf16_compound_q(1).mul_add(a: z, b: cm_bf16_compound_q(0))
    c2: B64 = c3.mul_add(a: z, b: cm_bf16_compound_q(2))
    return c2.mul_add(a: z2, b: c0)

### 2^t rounded to BF16, or -1 when the rounding test fails or the result may underflow, for t within 2^-40.680 of
### y log2(1 + x) and 0x1.7154759a0df53p-24 <= |t| <= 150.
### :param t: The approximation of y log2(1 + x).
### :returns: The correctly rounded power, or -1.
secret routine cm_bf16_compound_exp2_fast(t: B64) -> BF16
    if t <= -134.0
        return B64.to[BF16](0x1p-134)
    # 0 <= |k| <= 150, and |r| <= 1/2 exactly
    k: B64 = t.round_ties_even()
    r: B64 = t - k
    # 2.5 <= 3.015625 + r <= 3.5015625: adding 2^-6 rounds i to nearest, r is near (i - 16)/2^5
    i: U64 = ((3.015625 + r).bits() >> 46) - 0x10010
    # now |r1| <= 2^-6, exactly, and 2^t = 2^k exp2_U[i] 2^r1
    r1: B64 = r - B64.from_bits(CM_BF16_COMPOUND_EXP2_T.getitem(i))
    v: B64 = B64.from_bits(CM_BF16_COMPOUND_EXP2_U.getitem(2 * i)) * cm_bf16_compound_q1(r1)
    # The total absolute error on v is below 2^-40.849 < 0x1.1dp-41. Scale v and the error by 2^k.
    scale: U64 = (k.to[S64]() * 0x10000000000000).to_wrap[U64]()
    vs: B64 = B64.from_bits(v.bits() +% scale)
    # a potential underflow goes to the accurate path
    if vs < 0x1.00000000008e2p-126
        return -1.0
    err: B64 = B64.from_bits(B64.bits(0x1.1dp-41) +% scale)
    lb: BF16 = (vs - err).to[BF16]()
    rb: BF16 = (vs + err).to[BF16]()
    if lb != rb
        return -1.0
    return lb

### hi + lo = a b exactly.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product as a double-double.
secret routine cm_bf16_compound_a_mul(a: B64, b: B64) -> CmBF16CompoundDd
    hi: B64 = a * b
    return CmBF16CompoundDd(hi: hi, lo: a.mul_add(a: b, b: -hi))

### a (bh + bl) as a double-double.
### :param a: The B64 factor.
### :param bh: The high part of the double-double factor.
### :param bl: The low part of the double-double factor.
### :returns: The product.
secret routine cm_bf16_compound_s_mul(a: B64, bh: B64, bl: B64) -> CmBF16CompoundDd
    p: CmBF16CompoundDd = cm_bf16_compound_a_mul(a, b: bh)
    return CmBF16CompoundDd(hi: p.hi, lo: a.mul_add(a: bl, b: p.lo))

### (ah + al) (bh + bl) - al bl as a double-double, al bl being negligible when al <= ulp(ah) and bl <= ulp(bh).
### :param ah: The high part of the first factor.
### :param al: The low part of the first factor.
### :param bh: The high part of the second factor.
### :param bl: The low part of the second factor.
### :returns: The product.
secret routine cm_bf16_compound_d_mul(ah: B64, al: B64, bh: B64, bl: B64) -> CmBF16CompoundDd
    p: CmBF16CompoundDd = cm_bf16_compound_a_mul(a: ah, b: bh)
    t: B64 = al.mul_add(a: bh, b: p.lo)
    return CmBF16CompoundDd(hi: p.hi, lo: ah.mul_add(a: bl, b: t))

### s + t = a + b for |a| >= |b| (Fast2Sum), with an error below 2^-105 |s|.
### :param a: The larger addend.
### :param b: The smaller addend.
### :returns: The rounded sum and its error.
secret routine cm_bf16_compound_fast_two_sum(a: B64, b: B64) -> CmBF16CompoundDd
    s: B64 = a + b
    e: B64 = s - a
    return CmBF16CompoundDd(hi: s, lo: b - e)

### Coefficient k of CM_BF16_COMPOUND_P2.
### :param k: The entry.
### :returns: The coefficient.
### :throws: Crashes with `IndexOutOfBoundsError` when `k` is past the table.
secret routine cm_bf16_compound_p2c(k: U64) -> B64
    return B64.from_bits(CM_BF16_COMPOUND_P2.getitem(k))

### One Horner step in double-double: v z + c.
### :param v: The running value.
### :param z: The variable.
### :param c: The coefficient.
### :returns: The new running value.
secret routine cm_bf16_compound_dd_step(v: CmBF16CompoundDd, z: CmBF16CompoundDd,
        c: CmBF16CompoundDd) -> CmBF16CompoundDd
    p: CmBF16CompoundDd = cm_bf16_compound_d_mul(ah: v.hi, al: v.lo, bh: z.hi, bl: z.lo)
    s: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: c.hi, b: p.hi)
    return CmBF16CompoundDd(hi: s.hi, lo: p.lo + (s.lo + c.lo))

### A double-double approximation of log2(1 + zh + zl) for |zh + zl| <= 1/64, with relative error < 2^-93.777.
### :param zh: The high part of the argument.
### :param zl: The low part of the argument.
### :returns: log2(1 + zh + zl).
secret routine cm_bf16_compound_p2(zh: B64, zl: B64) -> CmBF16CompoundDd
    # The relative accuracy can't beat 2^-93.777, so the low part needs only about 41 accurate bits. Since
    # |p7 z^7/p1| < 2^-44, the terms of degree 7 and up are evaluated in B64 only.
    each i: U64 in 0 til 6 with h: B64 = cm_bf16_compound_p2c(17)
        continue with h: h.mul_add(a: zh, b: cm_bf16_compound_p2c(16 - i))
    then
        # now in double-double: h + l = h z + p6
        z: CmBF16CompoundDd = CmBF16CompoundDd(hi: zh, lo: zl)
        q: CmBF16CompoundDd = cm_bf16_compound_s_mul(a: h, bh: zh, bl: zl)
        s: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: cm_bf16_compound_p2c(10), b: q.hi)
        l6: B64 = q.lo + s.lo
        # (h + l) z + p5, p4, p3, p2, p1
        d5: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: CmBF16CompoundDd(hi: s.hi, lo: l6), z,
            c: CmBF16CompoundDd(hi: cm_bf16_compound_p2c(8), lo: cm_bf16_compound_p2c(9)))
        d4: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: d5, z,
            c: CmBF16CompoundDd(hi: cm_bf16_compound_p2c(6), lo: cm_bf16_compound_p2c(7)))
        d3: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: d4, z,
            c: CmBF16CompoundDd(hi: cm_bf16_compound_p2c(4), lo: cm_bf16_compound_p2c(5)))
        d2: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: d3, z,
            c: CmBF16CompoundDd(hi: cm_bf16_compound_p2c(2), lo: cm_bf16_compound_p2c(3)))
        d1: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: d2, z,
            c: CmBF16CompoundDd(hi: cm_bf16_compound_p2c(0), lo: cm_bf16_compound_p2c(1)))
        # the final multiplication by z
        return cm_bf16_compound_d_mul(ah: d1.hi, al: d1.lo, bh: zh, bl: zl)

### A double-double approximation of log2(1 + x) for -1 < x < 2^128 representable in B32, with relative error below
### 2^-91.123 and |lo| < 2^-48.574 |hi|.
### :param x: The argument.
### :returns: log2(1 + `x`).
secret routine cm_bf16_compound_log2p1_accurate(x: B64) -> CmBF16CompoundDd
    # h + l = 1 + x + eps with |eps| <= 2^-105 |h| and |l| <= ulp(h): exact by Fast2Sum's condition when
    # 2^-53 <= |x| <= 1 or 1 < x < 2^54
    s: CmBF16CompoundDd = when
        1.0 >= x =>
            when
                x.abs() >= 0x1p-53 => becomes cm_bf16_compound_fast_two_sum(a: 1.0, b: x)
                else => becomes CmBF16CompoundDd(hi: 1.0, lo: x)
        else => cm_bf16_compound_fast_two_sum(a: x, b: 1.0)
    vu: U64 = s.hi.bits()
    m: U64 = vu & 0xFFFFFFFFFFFFF
    # 2^e/sqrt(2) < h < 2^e sqrt(2), with -29 <= e <= 128: divide h and l by 2^e
    e: S64 = ((vu >> 52).to[S64]() - 0x3FF) + (m >= 0x6A09E667F3BCD).to[S64]()
    sc: B64 = B64.from_bits(CM_BF16_COMPOUND_SCALE.getitem((e + 29).to[U64]()))
    h: B64 = s.hi * sc
    l: B64 = s.lo * sc
    # now |h| < sqrt(2) and |l| <= 2^-52, 1 + x ~ 2^e (h + l), log2(1 + x) ~ e + log2(h + l)
    i: U64 = ((2.0 + h).bits() >> 45) - 0x2002D
    r: B64 = B64.from_bits(CM_BF16_COMPOUND_INV.getitem(i))
    # zh exactly, -1/64 <= zh <= 1/64, zh + zl = r (h + l) - 1, log2(h + l) = -log2(r) + log2(1 + zh + zl)
    zh0: B64 = r.mul_add(a: h, b: -1.0)
    zl0: B64 = r * l
    z: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: zh0, b: zl0)
    p: CmBF16CompoundDd = cm_bf16_compound_p2(zh: z.hi, zl: z.lo)
    # |log2inv[i][0]| < 1 and e is an integer, so Fast2Sum's condition holds
    li: B64 = B64.from_bits(CM_BF16_COMPOUND_LOG2INV.getitem(2 * i))
    a: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: e.to[B64](), b: li)
    al: B64 = a.lo + B64.from_bits(CM_BF16_COMPOUND_LOG2INV.getitem(2 * i + 1))
    b: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: a.hi, b: p.hi)
    return CmBF16CompoundDd(hi: b.hi, lo: al + (b.lo + p.lo))

### Coefficient k of CM_BF16_COMPOUND_Q2.
### :param k: The entry.
### :returns: The coefficient.
### :throws: Crashes with `IndexOutOfBoundsError` when `k` is past the table.
secret routine cm_bf16_compound_q2c(k: U64) -> B64
    return B64.from_bits(CM_BF16_COMPOUND_Q2.getitem(k))

### A double-double approximation of 2^(h + l) for |h| <= 2^-6 and |l| <= 2^-58, with absolute error < 2^-85.218.
### :param h: The high part of the argument.
### :param l: The low part of the argument.
### :returns: 2^(h + l).
secret routine cm_bf16_compound_q2(h: B64, l: B64) -> CmBF16CompoundDd
    z: CmBF16CompoundDd = CmBF16CompoundDd(hi: h, lo: l)
    h2: B64 = h * h
    c7: B64 = cm_bf16_compound_q2c(11).mul_add(a: h, b: cm_bf16_compound_q2c(10))
    c5: B64 = cm_bf16_compound_q2c(9).mul_add(a: h, b: cm_bf16_compound_q2c(8))
    d5: B64 = c7.mul_add(a: h2, b: c5)
    # ulp(c5 h^5) <= 2^-86, so c5 h stays in B64
    q: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: cm_bf16_compound_q2c(7), b: d5 * h)
    # multiply by h + l and add the coefficients of degree 3, 2 and 1
    q3: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: q, z,
        c: CmBF16CompoundDd(hi: cm_bf16_compound_q2c(5), lo: cm_bf16_compound_q2c(6)))
    q2: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: q3, z,
        c: CmBF16CompoundDd(hi: cm_bf16_compound_q2c(3), lo: cm_bf16_compound_q2c(4)))
    q1: CmBF16CompoundDd = cm_bf16_compound_dd_step(v: q2, z,
        c: CmBF16CompoundDd(hi: cm_bf16_compound_q2c(1), lo: cm_bf16_compound_q2c(2)))
    # multiply by h + l and add the coefficient of degree 0
    p: CmBF16CompoundDd = cm_bf16_compound_d_mul(ah: q1.hi, al: q1.lo, bh: h, bl: l)
    s: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: cm_bf16_compound_q2c(0), b: p.hi)
    return CmBF16CompoundDd(hi: s.hi, lo: p.lo + s.lo)

### (1 + x)^y correctly rounded, from h + l within a relative error of 2^-91.120 of y log2(1 + x), with |h + l| < 150
### and |l| < 2^-48.445 |h|.
### :param t: y log2(1 + x) as a double-double.
### :param x: The base minus 1.
### :param y: The exponent.
### :param exact: Whether (1 + x)^y is exact or a midpoint.
### :returns: The correctly rounded power.
secret routine cm_bf16_compound_exp2_accurate(t: CmBF16CompoundDd, x: B32, y: B32, exact: Bool) -> BF16
    local h: B64 = t.hi
    local l: B64 = t.lo

    if y == 1.0
        return B32.add(1.0, x).to[BF16]()
    # |k| <= 150
    k: B64 = h.round_ties_even()
    # h + l tiny: 2^h rounds to 1 (also to 1- or 1+ for the other rounding modes)
    if k == 0.0 and h.abs() <= 0x1.716001718d0dfp-12
        return (1.0 + h * 0.5).to[BF16]()
    # |r| <= 1/2, exactly, and r is a multiple of ulp(h), so the Fast2Sum is exact
    s: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: h - k, b: l)
    # 2.5 <= 3.015625 + h <= 3.5015625: adding 2^-6 rounds i to nearest, h is near (i - 16)/2^5
    i: U64 = ((3.015625 + s.hi).bits() >> 46) - 0x10010
    # now |h| <= 2^-6, exactly, and 2^(h + l) = 2^k exp2_U[i] 2^(h + l)
    hr: B64 = s.hi - B64.from_bits(CM_BF16_COMPOUND_EXP2_T.getitem(i))
    # renormalize: |l| <= ulp(2^-6) = 2^-58
    z: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: hr, b: s.lo)
    # 0.989 < qh < 1.011, |ql| < 2^-51.959, |qh + ql - 2^(h+l)| < 2^-85.210
    q: CmBF16CompoundDd = cm_bf16_compound_q2(h: z.hi, l: z.lo)
    uh: B64 = B64.from_bits(CM_BF16_COMPOUND_EXP2_U.getitem(2 * i))
    ul: B64 = B64.from_bits(CM_BF16_COMPOUND_EXP2_U.getitem(2 * i + 1))
    p: CmBF16CompoundDd = cm_bf16_compound_d_mul(ah: uh, al: ul, bh: q.hi, bl: q.lo)
    w: CmBF16CompoundDd = cm_bf16_compound_fast_two_sum(a: p.hi, b: p.lo)
    scale: U64 = (k.to[S64]() * 0x10000000000000).to_wrap[U64]()
    # The total absolute error on qh + ql is below 2^-83.242. As |ql| < ulp(qh), the rounding test can fail only when
    # the last 53 - 25 = 28 bits of qh are a signed number in [-1, 1].
    wu: U64 = w.hi.bits()
    if (wu +% 1) & 0xFFFFFFF <= 2
        vu: U64 = (w.hi + (w.lo - 0x1.b1p-84)).bits() +% scale
        wwu: U64 = (w.hi + (w.lo + 0x1.b1p-84)).bits() +% scale
        left: BF16 = B64.from_bits(vu).to[BF16]()
        right: BF16 = B64.from_bits(wwu).to[BF16]()
        # exact or midpoint: the bound with more trailing zeros is the right one
        if exact
            if vu.trailing_zeros() >= wwu.trailing_zeros()
                return left
            return right
        # (1 + x)^y rounds like x^y where x^y is exact for y = 1/2, 1/4, 3/4 and x >= 2^8
        if y == 0.5 or y == 0.25 or y == 0.75
            return right
    # multiply qh + ql by 2^k: 0.69 < qh + ql < 1.44, so the scaling neither overflows nor underflows
    v: B64 = w.hi + w.lo
    # When qh fits in 25 bits and qh + ql rounds to qh, round to odd to avoid a double rounding.
    odd: Bool = wu << 36 == 0 and v == w.hi and w.lo != 0.0
    vu: U64 = when
        odd and w.lo > 0.0 => v.bits() +% 1
        odd => v.bits() -% 1
        else => v.bits()
    return B64.from_bits(vu +% scale).to[BF16]()

### (1 + x)^y through the double-double path, for when the fast path's rounding test failed.
### :param x: The base minus 1.
### :param y: The exponent.
### :param exact: Whether (1 + x)^y is exact or a midpoint.
### :returns: The correctly rounded power.
secret routine cm_bf16_compound_accurate(x: B32, y: B32, exact: Bool) -> BF16
    # h + l approximates log2(1 + x) with relative error below 2^-91.123, and |l| < 2^-48.574 |h|
    lg: CmBF16CompoundDd = cm_bf16_compound_log2p1_accurate(x.to[B64]())
    # y log2(1 + x): 2^-298 <= |h + l| < 2^135, so no overflow or underflow, relative error below 2^-91.120
    t: CmBF16CompoundDd = cm_bf16_compound_s_mul(a: y.to[B64](), bh: lg.hi, bl: lg.lo)
    return cm_bf16_compound_exp2_accurate(t, x, y, exact)
