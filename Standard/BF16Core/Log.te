### The natural logarithm ln(`me`), correctly rounded (to nearest, ties to even). ln(+-0) = -inf, a negative `me`
### (-inf and a negative NaN included) gives the quiet NaN, ln(+inf) = +inf, and a positive NaN comes back quiet.
### :returns: ln(`me`).
routine BF16.ln() -> Me
    u: U16 = me.bits()
    i1: U16 = u >> 7
    i2: U16 = u & 0x7F
    if u >> 15 != 0
        # -0 gives -inf, every other negative x (a negative NaN included) gives the quiet NaN.
        if u == 0x8000
            return BF16.NEG_INFINITY
        return BF16.NAN
    if u >> 7 == 0xFF
        # +inf or a positive NaN
        return me + me
    if i1 == 0
        # subnormal or +0
        return B32.from_bits(CM_BF16_LOG_T3.getitem(i2.to[U64]())).to[Me]()
    t1: B32 = B32.from_bits(CM_BF16_LOG_T1.getitem(i1.to[U64]()))
    t2: B32 = B32.from_bits(CM_BF16_LOG_T2.getitem(i2.to[U64]()))
    return (t1 + t2).to[Me]()
