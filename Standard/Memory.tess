// Tessera stdlib: Allocator pattern and memory routines
//
// The Allocator record is a manual vtable: callers pass @Allocator to any
// routine that performs heap allocation. Nothing here needs an operating system;
// make_heap_allocator(), backed by libc malloc / realloc / free, is in
// Standard::Os (Os/Heap.tess).
//
// Generic routines (alloc, realloc, free, zero, copy) form the prelude memory
// surface used by every collection.  Sizes and counts are USize.

module Standard::Alloc

import Standard::Format

// ============================================================
// Allocator record
//
// Callbacks use the C calling convention and USize sizes, so libc's own
// functions fit behind them.
// ============================================================

/// A manual vtable for heap allocation: the allocate, reallocate and free callbacks plus an opaque `state` passed to each. Callers pass `@Allocator` to any routine that allocates, so no allocation is hidden.
record Allocator
    alloc_fn   : Callable<(Addr, USize), Addr>
    realloc_fn : Callable<(Addr, Addr, USize), Addr>
    free_fn    : Callable<(Addr, Addr), Void>
    state      : Addr

/// The error of a `_result` operation whose allocator returned null, such as
/// `List.push_result`. The collection is left as it was before the call.
#derive(Represent, Diagnose, Equal, Hash)
record AllocFailed

// ============================================================
// Generic memory routines (prelude surface)
//
// Sizes and counts are USize, the same type the allocator callbacks and libc
// take.
// ============================================================

/// Allocates room for `count` values of `T` through `alloc` and returns a pointer to it, uninitialized.
/// :typeparam T: The element type to allocate room for.
/// :param alloc: The allocator to use.
/// :param count: The number of values of `T` to make room for.
/// :returns: A pointer to the new block, or a null pointer when the allocator fails.
/// :note: The byte size is `sizeof<T>() * count` with checked multiplication. The memory is uninitialized, and a failed allocation returns a null pointer rather than crashing.
routine allocate<T>(alloc: @Allocator, count: USize) -> @T
require T: typename
    block entry()
        elem_size : USize                         = sizeof<T>()
        size      : USize                         = elem_size.mul(count)
        alloc_fn  : Callable<(Addr, USize), Addr> = alloc.alloc_fn.load()
        state     : Addr                          = alloc.state.load()
        raw       : Addr                          = alloc_fn.call(state, size)
        typed     : @T                            = raw.to<@T>()
        return(typed)

/// Resizes the block at `ptr` to hold `new_count` values of `T` through `alloc` and returns the possibly moved pointer.
/// :typeparam T: The element type.
/// :param alloc: The allocator to use.
/// :param ptr: The block to resize, from `allocate` or an earlier `reallocate`.
/// :param new_count: The new number of values of `T`.
/// :returns: A pointer to the resized block, which may have moved, or a null pointer when the allocator fails.
/// :note: A failed reallocation returns a null pointer, and the old block stays valid.
routine reallocate<T>(alloc: @Allocator, ptr: @T, new_count: USize) -> @T
require T: typename
    block entry()
        elem_size  : USize                               = sizeof<T>()
        size       : USize                               = elem_size.mul(new_count)
        raw_old    : Addr                                = ptr
        realloc_fn : Callable<(Addr, Addr, USize), Addr> = alloc.realloc_fn.load()
        state      : Addr                                = alloc.state.load()
        raw        : Addr                                = realloc_fn.call(state, raw_old, size)
        typed      : @T                                  = raw.to<@T>()
        return(typed)

/// Copies `count` values of `T` from `src` to `dst` as raw bytes (`llvm.memcpy`).
/// :typeparam T: The element type.
/// :param dst: The first value to write to.
/// :param src: The first value to read.
/// :param count: The number of values of `T` to copy.
/// :note: The ranges must not overlap, and no destructor or copy hook runs.
routine copy<T>(dst: @T, src: @T, count: USize) -> Void
require T: typename
    block entry()
        elem_size : USize = sizeof<T>()
        size      : USize = elem_size.mul(count)
        raw_dst   : Addr  = dst
        raw_src   : Addr  = src
        copy_bytes(raw_dst, raw_src, size)
        return()

// llvm.memcpy, so the alloc layer needs no libc: without an operating system, Freestanding.tess supplies memcpy.
/// Copies `bytes` bytes from `src` to `dst` with `llvm.memcpy`.
/// :param dst: The destination address.
/// :param src: The source address.
/// :param bytes: The number of bytes to copy.
/// :note: The ranges must not overlap.
#[external("llvm"),
    template("call void @llvm.memcpy.p0.p0.{USize}(ptr {dst}, ptr {src}, {USize} {bytes}, i1 false)")]
private routine copy_bytes(dst: Addr, src: Addr, bytes: USize) -> Void

// ============================================================
// C strings (Types/CStr.tess)
// ============================================================

/// Copies self into memory from alloc and ends it with a NUL. Free it with
/// c.to<@Byte>().free(alloc).
#track_caller
routine Bytes.to_cstr(self: Self, alloc: @Allocator) -> CStr
    block entry()
        count  : USize = self.count
        buffer : @Byte = allocate<Byte>(alloc, count.add(1))
        failed : Bool  = buffer.is_null()
        branch failed
            ? crash_allocation()
            : continue
        copy<Byte>(buffer, self.data, count)
        buffer.stride(count).store(0x00)
        return(.from_ptr(buffer))

/// Converts self to wide characters in memory from alloc, ending with a 0:
/// UTF-16 on Windows, UTF-32 elsewhere. Free it with w.to<@CWChar>().free(alloc).
/// A UTF-8 byte count bounds both unit counts, so one allocation is enough.
#track_caller
routine Bytes.to_cwstr(self: Self, alloc: @Allocator) -> CWStr
    block entry()
        units  : @CWChar = allocate<CWChar>(alloc, self.count.add(1))
        failed : Bool    = units.is_null()
        branch failed
            ? crash_allocation()
            : continue
        claim iter : @BytesCharsIter <- self.chars()
        jump next(iter, units, 0)

    block next(iter: @BytesCharsIter, units: @CWChar, n: USize)
        c : Option<Char> = iter.next()
        when c
            .Present(char) -> put(iter, units, n, char)
            .Absent        -> finish(units, n)

    block put(iter: @BytesCharsIter, units: @CWChar, n: USize, char: Char)
        count : USize = encode_cwchar(char, units.stride(n))
        jump next(iter, units, n.add(count))

    block finish(units: @CWChar, n: USize)
        units.stride(n).store(0)
        return(.from_ptr(units))

/// Writes char at out as UTF-16, one unit or a surrogate pair, and returns
/// how many units it wrote.
#target(os: "windows")
private routine encode_cwchar(char: Char, out: @CWChar) -> USize
    block entry()
        cp  : U32  = char.to<U32>()
        bmp : Bool = cp.lt(0x10000)
        branch bmp
            ? single(cp)
            : pair(cp)

    block single(cp: U32)
        out.store(cp.to<U16>())
        return(1)

    block pair(cp: U32)
        v         : U32 = cp.sub(0x10000)
        high_unit : U32 = v.shr(10).add(0xD800)
        out.store(high_unit.to<U16>())
        low_unit : U32 = v.bitand(0x3FF).add(0xDC00)
        out.stride(1).store(low_unit.to<U16>())
        return(2)

/// Writes char at out as one UTF-32 unit. CWChar is S32 on some targets and U32 on others (ARM and AArch64 outside
/// Apple); the code point's bits are the same either way.
#target(os: not "windows")
private routine encode_cwchar(char: Char, out: @CWChar) -> USize
    block entry()
        unit : @U32 = out.to<@U32>()
        unit.store(char.to<U32>())
        return(1)
