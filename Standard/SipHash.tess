// Tessera stdlib: SipHash-2-4, the keyed hash behind every `hash()`
//
// SipHash (Aumasson and Bernstein, 2012) is a pseudorandom function of a 128-bit key: without the key, nobody can
// pick inputs that collide, so a hash table keyed by input from outside can't be driven into one long probe run
// (hash flooding). The stdlib's `hash()` is SipHash-2-4 under the process's key (HashKey.tess). This file is the
// algorithm itself, keyed by the caller, bit for bit the reference's: two rounds per 8-byte block, four to finish,
// the input read little-endian, and its length in the top byte of the last block.
//
// Public surface:
//   siphash24(data, count, key) -> U64    one-shot hash of count bytes
//   siphash24(value, key) -> U64    one U64, the same as its 8 bytes in memory
//   siphash24(low, high, key) -> U64    two U64s, the same as their 16 bytes in memory (low first)
//
// The state is four 64-bit words, carried from step to step as a SipState. All arithmetic is modulo 2^64.

module Standard::Core

// "somepseudorandomlygeneratedbytes", the four words the state starts from before the key is mixed in.
private preset SIP_C0: U64 = 0x736F6D6570736575

private preset SIP_C1: U64 = 0x646F72616E646F6D
private preset SIP_C2: U64 = 0x6C7967656E657261
private preset SIP_C3: U64 = 0x7465646279746573

/// A SipHash key: 128 bits, as two 64-bit words. `k0` is the key's first 8 bytes read little-endian and `k1` the next
/// 8, as the reference reads the 16-byte key.
record SipKey
    k0 : U64
    k1 : U64

/// The SipHash state: four 64-bit words that every round mixes and every block is absorbed into.
record SipState
    v0 : U64  // the first word, which a block is xored into after its rounds
    v1 : U64  // the second word
    v2 : U64  // the third word, which the finish xors with 0xFF
    v3 : U64  // the fourth word, which a block is xored into before its rounds

/// One SipRound: additions, rotations, and xors that mix the four state words.
/// :param s: The state.
/// :returns: The mixed state.
#inline
private routine sip_round(s: SipState) -> SipState
    block entry()
        a0    : U64      = s.v0.add_wrap(s.v1)
        a1    : U64      = s.v1.rotl(13).bitxor(a0)
        b0    : U64      = a0.rotl(32)
        a2    : U64      = s.v2.add_wrap(s.v3)
        a3    : U64      = s.v3.rotl(16).bitxor(a2)
        c0    : U64      = b0.add_wrap(a3)
        c3    : U64      = a3.rotl(21).bitxor(c0)
        c2    : U64      = a2.add_wrap(a1)
        c1    : U64      = a1.rotl(17).bitxor(c2)
        d2    : U64      = c2.rotl(32)
        state : SipState = SipState { v0: c0, v1: c1, v2: d2, v3: c3 }
        return(state)

/// The starting state for a key: the four constants, each xored with one of the key's words.
/// :param key: The 128-bit key.
/// :returns: The starting state.
#inline
private routine sip_init(key: SipKey) -> SipState
    block entry()
        v0    : U64      = key.k0.bitxor(SIP_C0)
        v1    : U64      = key.k1.bitxor(SIP_C1)
        v2    : U64      = key.k0.bitxor(SIP_C2)
        v3    : U64      = key.k1.bitxor(SIP_C3)
        state : SipState = SipState { v0: v0, v1: v1, v2: v2, v3: v3 }
        return(state)

/// Absorbs one 64-bit block `m` with two SipRounds.
/// :param s: The state before the block.
/// :param m: The block, its bytes read little-endian.
/// :returns: The state after the block.
#inline
private routine sip_compress(s: SipState, m: U64) -> SipState
    block entry()
        mixed : SipState = SipState { v0: s.v0, v1: s.v1, v2: s.v2, v3: s.v3.bitxor(m) }
        a     : SipState = sip_round(mixed)
        b     : SipState = sip_round(a)
        state : SipState = SipState { v0: b.v0.bitxor(m), v1: b.v1, v2: b.v2, v3: b.v3 }
        return(state)

/// Finishes with four SipRounds and folds the state into the 64-bit digest.
/// :param s: The state after the last block.
/// :returns: The 64-bit hash.
#inline
private routine sip_finish(s: SipState) -> U64
    block entry()
        mixed : SipState = SipState { v0: s.v0, v1: s.v1, v2: s.v2.bitxor(0xFF), v3: s.v3 }
        a     : SipState = sip_round(mixed)
        b     : SipState = sip_round(a)
        c     : SipState = sip_round(b)
        d     : SipState = sip_round(c)
        low   : U64      = d.v0.bitxor(d.v1)
        high  : U64      = d.v2.bitxor(d.v3)
        return(low.bitxor(high))

/// The last block of a `count`-byte input: the bytes from `from` (fewer than 8) little-endian, and the count's low byte
/// in the top byte, as the algorithm says.
/// :param data: The first byte of the input.
/// :param from: Where the last, partial block starts.
/// :param count: The input's length in bytes.
/// :returns: The last block.
private routine sip_last_block(data: @Byte, from: USize, count: USize) -> U64
    shared block_value : @U64 <- 0

    block entry()
        length : U64 = count.to<U64>().bitand(0xFF)
        length.shl(56).store_into(block_value)
        jump gather(from)

    block gather(at: USize)
        done : Bool = at.ge(count)
        branch done
            ? return(block_value.load())
            : continue
        b     : Byte = data.stride(at).load()
        bits  : U64  = b.to<U8>().to<U64>()
        shift : U64  = at.sub(from).to<U64>().mul(8)
        block_value.load().bitor(bits.shl(shift)).store_into(block_value)
        jump gather(at.add(1))

/// SipHash-2-4 of `count` bytes starting at `data` under `key`, matching the reference's output.
/// :param data: The first byte of the input. It need not be aligned.
/// :param count: The number of bytes to hash. An empty input (`count` of 0) is valid.
/// :param key: The 128-bit key.
/// :returns: The 64-bit hash.
routine siphash24(data: @Byte, count: USize, key: SipKey) -> U64
    shared whole : USize = count.sub(count.bitand(7))

    block entry()
        jump blocks(0, sip_init(key))

    block blocks(at: USize, state: SipState)
        done : Bool = at.ge(whole)
        branch done
            ? last(state)
            : continue
        // Every target Tessera supports is little-endian, so the block's 8 bytes read as one U64 are the block.
        m : U64 = data.stride(at).to<@U64>().load_unaligned()
        jump blocks(at.add(8), sip_compress(state, m))

    block last(state: SipState)
        m     : U64      = sip_last_block(data, whole, count)
        final : SipState = sip_compress(state, m)
        return(sip_finish(final))

/// SipHash-2-4 of one U64 under `key`, the same as `siphash24` over its 8 bytes in memory (little-endian), without a
/// buffer: one full block, then the length (8) in the top byte of a block of its own.
/// :param value: The value to hash.
/// :param key: The 128-bit key.
/// :returns: The 64-bit hash.
#inline
routine siphash24(value: U64, key: SipKey) -> U64
    block entry()
        start  : SipState = sip_init(key)
        block1 : SipState = sip_compress(start, value)
        final  : SipState = sip_compress(block1, 0x0800000000000000)
        return(sip_finish(final))

/// SipHash-2-4 of two U64s under `key`, the same as `siphash24` over their 16 bytes in memory, `low` first (a U128's
/// low and high words): two full blocks, then the length (16) in the top byte of a block of its own.
/// :param low: The first 8 bytes, as a little-endian U64.
/// :param high: The next 8 bytes, as a little-endian U64.
/// :param key: The 128-bit key.
/// :returns: The 64-bit hash.
#inline
routine siphash24(low: U64, high: U64, key: SipKey) -> U64
    block entry()
        start  : SipState = sip_init(key)
        block1 : SipState = sip_compress(start, low)
        block2 : SipState = sip_compress(block1, high)
        final  : SipState = sip_compress(block2, 0x1000000000000000)
        return(sip_finish(final))
