// Tessera stdlib: the correctly rounded tan(pi x) of F32
//
// x = n + z with n the nearest integer and |z| <= 1/2: tan(pi z) is z (1 - z^2) P(z^2) / (Q(z^2) (1/4 - z^2)), a
// rational approximation in F64 whose factors carry the zeros at z = 0, +-1 and the poles at z = +-1/2 exactly.
// Multiples of 1/4 are exact, and two arguments the rational function can't round are listed. Round to nearest
// only.
//
// Ported from CORE-MATH, src/binary32/tanpi/tanpif.c via RazorForge's B32Tanpi.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// tan(pi self), correctly rounded (to nearest, ties to even). An integer n gives +0 for a positive even n or a
/// negative odd one and -0 otherwise, n + 1/2 gives +inf for an even n and -inf for an odd one, +-inf gives NaN,
/// and NaN comes back quiet.
routine F32.tan_pi(self: Self) -> Self
    shared ix : U32 = self.bits()

    block entry()
        e     : U32  = ix.bitand(0x7F800000)
        large : Bool = e.gt(0x4B000000)  // |x| >= 2^24
        branch large
            ? large(e)
            : continue
        x4      : Self = Self.mul(4.0, self)
        dx4     : Self = x4.sub(x4.round_ties_even())
        zf      : Self = self.sub(self.round_ties_even())  // x minus the nearest integer
        quarter : Bool = dx4.eq(0.0)
        branch quarter
            ? quarter(x4.to<S32>(), zf)
            : continue
        a : U32 = zf.bits().bitand(0x7FFFFFFF)
        when a
            0x3E933802 -> listed(0x1.44cfbap+0, 0x1p-25, zf)
            0x38F26685 -> listed(0x1.7cc304p-12, 0x1p-37, zf)
            else       -> rational(zf)

    // NaN comes back quiet with its sign and payload, an infinity gives NaN, any other x is an even integer
    block large(e: U32)
        special : Bool = e.eq(0x7F800000)
        branch special
            ? continue
            : return(Self.copysign(0.0, self))
        infinite : Bool = ix.shl(9).eq(0)
        branch infinite
            ? return(Self.from_bits(0x7FC00000))
            : return(self.add(self))

    // x = k/4 for an integer k
    block quarter(k: S32, zf: Self)
        odd : Bool = k.bitand(1).eq(1)  // x = 1/4 mod 1/2: +-1 with the sign of tan
        branch odd
            ? return(Self.copysign(1.0, zf))
            : continue
        zero : Self = Self.copysign(0.0, self)
        turn : S32  = k.bitand(6)  // 4 x mod 8, k being even: x mod 2 in quarters
        when turn
            0    -> return(zero)  // x = 0 mod 2
            4    -> return(zero.neg())  // x = 1 mod 2
            2    -> return(Self.INFINITY)  // x = 1/2 mod 2
            else -> return(Self.NEG_INFINITY)  // x = -1/2 mod 2

    // the two arguments whose rational evaluation would round wrongly: sign(z) (rh + rl)
    block listed(rh: Self, rl: Self, zf: Self)
        return(Self.copysign(rh, zf).add(Self.copysign(rl, zf)))

    block rational(zf: Self)
        z     : F64 = zf.to<F64>()
        z2    : F64 = z.mul(z)
        z4    : F64 = z2.mul(z2)
        n23   : F64 = F64.add(0x1.68a34bd0b8f6ap-6, z2.mul(-0x1.e4866f7a25f99p-13))
        n01   : F64 = F64.add(0x1.921fb54442d19p-1, z2.mul(-0x1.1f458b3e1f8d6p-2))
        poly  : F64 = n01.add(z4.mul(n23))
        num   : F64 = z.sub(z.mul(z2)).mul(poly)
        d23   : F64 = F64.add(0x1.8e9926d2bb901p-4, z2.mul(-0x1.a6f77fd847eep-9))
        d01   : F64 = F64.add(0x1p+0, z2.mul(-0x1.4b4b98d2df3a7p-1))
        dpoly : F64 = d01.add(z4.mul(d23))
        den   : F64 = dpoly.mul(F64.sub(0.25, z2))
        r     : F64 = num.div(den)
        return(r.to<Self>())
