// Tessera stdlib: the correctly rounded natural logarithm of F32
//
// x = 2^e (1 + m), 1 + m = (1 + j/64) (1 + z) with 1/(1 + j/64) from a table:
// log x = e log(2) - log(r_j) + log(1 + z), with a short polynomial in F64.
// A longer polynomial and a two-part log(2) settle the cases the first can't
// round. Round to nearest only: log(+-0) is -inf, a negative input gives NaN,
// NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/log/logf.c via RazorForge's B32Log.rf.
// Copyright (c) 2023-2026 Alexei Sibidanov and Paul Zimmermann
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// 1/(1 + i/64) for i in 0..64, rounded to 29 bits, as F64 bits.
preset CM_F32_LOG_TR: @Array<U64, 65> <- { 0x3FF0000000000000, 0x3FEF81F820000000,
    0x3FEF07C1F0000000, 0x3FEE9131AC000000, 0x3FEE1E1E1E000000, 0x3FEDAE6077000000,
    0x3FED41D41D000000, 0x3FECD85689000000, 0x3FEC71C71C000000, 0x3FEC0E0704000000,
    0x3FEBACF915000000, 0x3FEB4E81B5000000, 0x3FEAF286BD000000, 0x3FEA98EF60000000,
    0x3FEA41A41A000000, 0x3FE9EC8E95000000, 0x3FE999999A000000, 0x3FE948B0FD000000,
    0x3FE8F9C190000000, 0x3FE8ACB90F000000, 0x3FE8618618000000, 0x3FE8181818000000,
    0x3FE7D05F41000000, 0x3FE78A4C81000000, 0x3FE745D174000000, 0x3FE702E05C000000,
    0x3FE6C16C17000000, 0x3FE6816817000000, 0x3FE642C859000000, 0x3FE6058160000000,
    0x3FE5C9882C000000, 0x3FE58ED231000000, 0x3FE5555555000000, 0x3FE51D07EB000000,
    0x3FE4E5E0A7000000, 0x3FE4AFD6A0000000, 0x3FE47AE148000000, 0x3FE446F865000000,
    0x3FE4141414000000, 0x3FE3E22CBD000000, 0x3FE3B13B14000000, 0x3FE3813814000000,
    0x3FE3521CFB000000, 0x3FE323E34A000000, 0x3FE2F684BE000000, 0x3FE2C9FB4E000000,
    0x3FE29E412A000000, 0x3FE27350B9000000, 0x3FE2492492000000, 0x3FE21FB781000000,
    0x3FE1F7047E000000, 0x3FE1CF06AE000000, 0x3FE1A7B961000000, 0x3FE1811812000000,
    0x3FE15B1E5F000000, 0x3FE135C811000000, 0x3FE1111111000000, 0x3FE0ECF56C000000,
    0x3FE0C97150000000, 0x3FE0A6810A000000, 0x3FE0842108000000, 0x3FE0624DD3000000,
    0x3FE0410410000000, 0x3FE0204081000000, 0x3FE0000000000000 }

/// -log(CM_F32_LOG_TR[i]) for i in 0..64, as F64 bits.
preset CM_F32_LOG_TL: @Array<U64, 65> <- { 0xBD23B40815CD0628, 0x3F8FC0A890FBB514,
    0x3F9F829B1E780B98, 0x3FA77458F532C948, 0x3FAF0A30C2114EF2, 0x3FB341D793BBC7F7,
    0x3FB6F0D28D256172, 0x3FBA926D3A6ACB89, 0x3FBE2707722AE90C, 0x3FC0D77E7A90896C,
    0x3FC29552F6FFF036, 0x3FC44D2B6C5B7831, 0x3FC5FF306EE78EE7, 0x3FC7AB890410D41C,
    0x3FC9525A9E3451C7, 0x3FCAF3C94ED0BB06, 0x3FCC8FF7C59A9535, 0x3FCE27076D5AEDF9,
    0x3FCFB9186B5E393E, 0x3FD0A324E38B8E6D, 0x3FD1675CACABA398, 0x3FD22941FC0F76EF,
    0x3FD2E8E2BC311ABA, 0x3FD3A64C56B14373, 0x3FD4618BC31C5C4C, 0x3FD51AAD874DF5B7,
    0x3FD5D1BDBEA80754, 0x3FD686C81D331238, 0x3FD739D7F6DBCD90, 0x3FD7EAF83C82AD4D,
    0x3FD89A3385813FE4, 0x3FD947941AA91484, 0x3FD9F323EDBF95D5, 0x3FDA9CEC9A4205D3,
    0x3FDB44F77C5C8CEC, 0x3FDBEB4D9EA71905, 0x3FDC8FF7C69A97AB, 0x3FDD32FE7F38E95F,
    0x3FDDD46A0501C22A, 0x3FDE7442617E8511, 0x3FDF128F5EAF0476, 0x3FDFAF588DD8F0A8,
    0x3FE02552A5EDCFC4, 0x3FE0723E5C64DE05, 0x3FE0BE72E3852947, 0x3FE109F39D554B5C,
    0x3FE154C3D2C4D4AE, 0x3FE19EE6B38BC834, 0x3FE1E85F5EF03F95, 0x3FE23130D7FABE07,
    0x3FE2795E1219AFE0, 0x3FE2C0E9EC9C8D50, 0x3FE307D7337F0F83, 0x3FE34E289CB4E098,
    0x3FE393E0D42E28DE, 0x3FE3D9026AD555BF, 0x3FE41D8FE8667173, 0x3FE4618BC1EC5D87,
    0x3FE4A4F85D303D80, 0x3FE4E7D8127F5A75, 0x3FE52A2D26DBC470, 0x3FE56BF9D597F25E,
    0x3FE5AD404CB59DF2, 0x3FE5EE02A928153A, 0x3FE62E42FEFA38B4 }

/// The natural logarithm, correctly rounded (to nearest). ln(+-0) = -inf, a negative input gives NaN, and NaN comes
/// back quiet.
/// :returns: ln(`self`).
routine F32.ln(self: Self) -> Self
    shared ux : U32 = self.bits()

    block entry()
        edge : Bool = ux.lt(0x00800000).bitor(ux.ge(0x7F800000))
        branch edge
            ? edge()
            : normal(ux)

    // x <= 0, a subnormal, +inf, or NaN
    block edge()
        special : Bool = ux.eq(0).bitor(ux.ge(0x7F800000))
        branch special
            ? return(cm_f32_log_special(self))
            : subnormal()

    block subnormal()
        n : U32 = ux.leading_zeros().sub(8)
        jump normal(ux.shl(n).sub_wrap(n.shl(23)))

    // ux_norm is a normalized positive pattern (the exponent field may be below 1 for a subnormal x)
    block normal(ux_norm: U32)
        one : Bool = ux_norm.eq(0x3F800000)
        branch one
            ? return(0.0)
            : continue
        m               : U32   = ux_norm.bitand(0x7FFFFF)
        j_bits          : U32   = m.add(0x10000).shr(17)
        j               : USize = j_bits.to<USize>()
        biased_exponent : S32   = ux_norm.to_wrap<S32>().shr(23)
        e               : S64   = biased_exponent.to<S64>().sub(127)
        ed              : F64   = e.to<F64>()
        m_wide          : U64   = m.to<U64>().bitor(0x1FF800000)
        tz              : F64   = F64.from_bits(m_wide.shl(29))
        tlj             : F64   = F64.from_bits(CM_F32_LOG_TL.getitem(j))
        z               : F64   = tz.mul(F64.from_bits(CM_F32_LOG_TR.getitem(j))).sub(1.0)
        z2              : F64   = z.mul(z)
        e_log           : F64   = ed.mul(0x1.62e42fefa39efp-1).add(tlj)
        head            : F64   = e_log.add(z.mul(0x1.00000006342eap+0))
        tail            : F64   = z.mul(0x1.554a4e5cae9cfp-2).add(-0x1.0001f7fdc3977p-1)
        r               : F64   = head.add(z2.mul(tail))
        ub              : Self  = r.to<Self>()
        lb              : Self  = r.add(0x1.f06p-33).to<Self>()
        sure            : Bool  = ub.eq(lb)
        branch sure
            ? return(ub)
            : slow(z, z2, ed, tlj)

    // The fast path can't decide the rounding: a longer polynomial and a two-part log(2).
    block slow(z: F64, z2: F64, ed: F64, tlj: F64)
        c01      : F64  = z.mul(0x1.55555555571cap-2).add(-0x1p-1)
        c23      : F64  = z.mul(0x1.9999987d0c963p-3).add(-0x1.0000000002d85p-2)
        c4z      : F64  = z.mul(0x1.24aebcf71a38fp-3).add(-0x1.555554059a8bbp-3)
        c46      : F64  = c4z.sub(z2.mul(0x1.001c73915d758p-3))
        f        : F64  = z2.mul(c01.add(z2.mul(c23.add(z2.mul(c46)))))
        distance : Self = self.sub(1.0).abs()
        near     : Bool = distance.lt(0x1p-10)
        branch near
            ? return(z.add(f).to<Self>())
            : continue
        f1       : F64  = f.sub(ed.mul(0x1.0ca86c3898dp-49)).add(z)
        f2       : F64  = f1.add(tlj.sub(F64.from_bits(CM_F32_LOG_TL.getitem(0))))
        el       : F64  = ed.mul(0x1.62e42fefa3ap-1)
        r        : F64  = el.add(f2)
        low_bits : U64  = r.bits().bitand(0x0FFFFFFF)
        boundary : Bool = low_bits.eq(0)
        branch boundary
            ? nudge(el, f2, r)
            : return(r.to<Self>())

    // r lies on an F32 rounding boundary: nudge it by the rounding error of el + f
    block nudge(el: F64, f: F64, r: F64)
        dr : F64 = el.sub(r).add(f)
        return(r.add(dr.mul(64.0)).to<Self>())

/// log of +-0 (-inf), +inf (itself), NaN (itself, quiet) or a negative input (NaN).
/// :param x: The special input.
/// :returns: The logarithm of `x`.
private routine cm_f32_log_special(x: F32) -> F32
    block entry()
        ux   : U32  = x.bits()
        zero : Bool = ux.shl(1).eq(0)
        inf  : Bool = ux.eq(0x7F800000)
        nan  : Bool = ux.shl(1).gt(0xFF000000)
        when
            zero -> return(F32.from_bits(0xFF800000))
            inf  -> return(x)
            nan  -> return(x.add(x))
            else -> return(F32.from_bits(0xFFC00000))
