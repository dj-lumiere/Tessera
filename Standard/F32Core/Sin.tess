// Tessera stdlib: the correctly rounded sine of F32
//
// x * 16/pi = q + z: sin(q pi/16) and cos(q pi/16) from a table, sin(z pi/16) and cos(z pi/16) from
// polynomials, all in F64. Four arguments the fast path can't round come from a small table of exact results.
// Round to nearest only: +-0 stays itself, infinities give NaN, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/sin/sinf.c via RazorForge's B32Sin.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// In radians.
routine F32.sin(self: Self) -> Self
    shared ax : U32 = self.bits().shl(1)

    block entry()
        outside : Bool = ax.gt(0x99000000).bitor(ax.lt(0x73000000))
        branch outside
            ? edge()
            : reduce()

    // |x| > 0x1p+26, x is NaN, or |x| < 0x1p-12
    block edge()
        tiny  : Bool = ax.lt(0x66000000)
        small : Bool = ax.lt(0x73000000)
        when
            tiny  -> tiny()
            small -> cubic()
            else  -> return(cm_f32_sin_big(self))

    block cubic()
        cube_term : Self = self.mul(-0x1.555556p-3).mul(self.mul(self))
        return(cube_term.add(self))

    // |x| < 0x1p-25: sin(x) rounds like x - x |x| tiny
    block tiny()
        zero : Bool = ax.eq(0)
        branch zero
            ? return(self)
            : return(self.neg().mul_add(self.abs(), self))

    block reduce()
        z0        : F64  = self.to<F64>()
        small     : Bool = ax.lt(0x822D97C8)
        hard_pair : Bool = ax.eq(0x7E75B8A2).bitor(ax.eq(0x7F4F0654))
        hard      : Bool = hard_pair.bitor(ax.eq(0x8C333330))
        when
            hard  -> return(cm_f32_sin_database(self))
            small -> fast(cm_f32_trig_reduce_small(z0))
            else  -> fast(cm_f32_trig_reduce_medium(z0))

    block fast(red: CmF32TrigReduced)
        z    : F64 = red.z
        ia   : U64 = red.q
        z2   : F64 = z.mul(z)
        z4   : F64 = z2.mul(z2)
        aa   : F64 = cm_f32_trig_poly_a(z2, z4)
        bb   : F64 = cm_f32_trig_poly_b(z2, z4)
        s0   : F64 = cm_f32_trig_sin_tb(ia)
        c0   : F64 = cm_f32_trig_sin_tb(ia.add_wrap(8))
        head : F64 = aa.mul(z.mul(c0)).add(s0)
        r    : F64 = head.sub(bb.mul(z2.mul(s0)))
        return(r.to<Self>())

/// The sine of the four arguments whose fast path isn't correctly rounded: sign(x) (rh + rl).
private routine cm_f32_sin_database(x: F32) -> F32
    block entry()
        ax : U32 = x.bits().bitand(0x7FFFFFFF)
        when ax
            0x46199998 -> finish(-0x1.63f4bap-2, -0x1p-27)
            0x3F3ADC51 -> finish(0x1.55688ap-1, -0x1p-26)
            0x3FA7832A -> finish(0x1.ee836cp-1, -0x1p-26)
            else       -> finish(-0x1.99bc5ap-26, -0x1p-51)

    block finish(rh: F32, rl: F32)
        sgn : F32 = F32.copysign(1.0, x)
        return(sgn.mul(rh).add(sgn.mul(rl)))

/// The sine for |x| > 2^26, infinities and NaN.
private routine cm_f32_sin_big(x: F32) -> F32
    shared t : U32 = x.bits()

    block entry()
        special : Bool = t.shl(1).ge(0xFF000000)
        branch special
            ? special()
            : continue
        red   : CmF32TrigReduced = cm_f32_trig_reduce_big(t, 147)
        z     : F64              = red.z
        ia    : U64              = red.q
        z2    : F64              = z.mul(z)
        z4    : F64              = z2.mul(z2)
        aa    : F64              = cm_f32_trig_poly_a(z2, z4)
        bb    : F64              = cm_f32_trig_poly_b(z2, z4)
        s0    : F64              = cm_f32_trig_sin_tb(ia)
        c0    : F64              = cm_f32_trig_sin_tb(ia.add_wrap(8))
        slope : F64              = aa.mul(c0).sub(bb.mul(z.mul(s0)))
        r     : F64              = slope.mul(z).add(s0)
        return(r.to<F32>())

    // NaN comes back quiet with its sign and payload, an infinity gives a NaN
    block special()
        nan : Bool = t.shl(9).ne(0)
        branch nan
            ? return(x.add(x))
            : return(F32.from_bits(0xFFC00000))
