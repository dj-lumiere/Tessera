// Tessera stdlib: the correctly rounded gamma function of F32
//
// Near zero gamma(x) = 1/x - euler_gamma + O(x). Positive integers give (x-1)!
// exactly. Otherwise gamma on [2.375, 3.375) (x reduced to x - 23/8 = i + d)
// from a degree-15 polynomial in d, shifted to x by the product of the
// i factors between them, all in F64. Hard-to-round inputs come from a table.
// Round to nearest only: overflow gives +inf, +-0 gives +-inf, the negative
// integers and -inf give NaN, and NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/tgamma/tgammaf.c via RazorForge's B32Tgamma.rf.
// Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// Inputs whose gamma is hard to round, as F32 bits.
preset CM_F32_TGAMMA_EXC_X: @Array<U32, 10> <- { 0x27DE86A9, 0x27E05475, 0xB63BEFB3, 0x3C7BB570,
    0x41E886D1, 0xC067D177, 0xBD99DA31, 0xBF54C45A, 0x41EE77FE, 0x3F843A64 }

/// The correctly rounded results for those inputs, as f + df (F32 bits).
preset CM_F32_TGAMMA_EXC_F: @Array<U32, 10> <- { 0x57134133, 0x57121211, 0xC8AE5B72, 0x42810EC8,
    0x709989B5, 0x3E7B4286, 0xC15F7F33, 0xC0D35A76, 0x7269B18E, 0x3F7B631C }
/// The low-order corrections `df` for the inputs in {CM_F32_TGAMMA_EXC_X}, as F32 bits: `f + df` is the correctly rounded result.
preset CM_F32_TGAMMA_EXC_DF: @Array<U32, 10> <- { 0x4A800000, 0x4A800000, 0x3C000000, 0x36000000,
    0x64000000, 0x31800000, 0xB4800000, 0x34000000, 0x99800000, 0x32800000 }

/// Γ(self): ±inf at ±0, NaN at the negative integers and -inf.
routine F32.gamma(self: Self) -> Self
    shared tu : U32  = self.bits()
    shared ax : U32  = tu.shl(1)
    shared t0 : @F64 <- uninit
    shared x0 : @F64 <- uninit

    block entry()
        z       : F64  = self.to<F64>()
        fx      : Self = self.floor()
        special : Bool = ax.ge(0xFF000000)
        tiny    : Bool = ax.lt(0x6D000000)  // |x| < 0x1p-18
        over    : Bool = self.ge(0x1.18522p+5)
        integer : Bool = fx.eq(self)
        under   : Bool = self.lt(-42.0)
        when
            special -> special()
            tiny    -> tiny(z)
            over    -> return(Self.mul(0x1p127, 0x1p127))
            integer -> integer(fx)
            under   -> under(fx)
            else    -> main(z)

    // NaN or +-inf
    block special()
        infinite : Bool = ax.eq(0xFF000000)
        minusinf : Bool = infinite.bitand(tu.shr(31).eq(1))
        when
            minusinf -> return(Self.from_bits(0xFFC00000))
            infinite -> return(self)
            else     -> return(self.add(self))

    // |x| < 0x1p-18: gamma(x) = 1/x - euler_gamma + O(x)
    block tiny(z: F64)
        c           : F64  = F64.sub(0x1.fa658c23b1578p-1, z.mul(0x1.d0a118f324b63p-1))
        d           : F64  = c.mul(z).sub(0x1.2788cfc6fb619p-1)
        f           : F64  = F64.div(1.0, z).add(d)
        r           : Self = f.to<Self>()
        biased_bits : U64  = f.bits().add_wrap(2)
        hard        : Bool = biased_bits.bitand(0xFFFFFFF).lt(4)
        branch hard
            ? return(cm_f32_tgamma_exception(tu, r))
            : return(r)

    // an integer: a pole (NaN) for the negative ones, (k-1)! for the positive ones
    block integer(fx: Self)
        zero     : Bool = self.eq(0.0)
        negative : Bool = self.lt(0.0)
        when
            zero     -> return(Self.div(1.0, self))
            negative -> return(Self.from_bits(0xFFC00000))
            else     -> continue
        1.0.store_into(t0)
        1.0.store_into(x0)
        jump factorial(fx.to<S64>(), 1)

    block factorial(k: S64, i: S64)
        more : Bool = i.lt(k)
        branch more
            ? continue
            : return(t0.load().to<Self>())
        next_x0 : F64 = x0.load().add(1.0)
        next_t0 : F64 = t0.load().mul(x0.load())
        next_t0.store_into(t0)
        next_x0.store_into(x0)
        jump factorial(k, i.add(1))

    // x < -42, not an integer: |gamma(x)| < 2^-151 rounds to a signed zero
    block under(fx: Self)
        whole : S64  = fx.to<S64>()
        even  : Bool = whole.bitand(1).eq(0)
        branch even
            ? return(Self.mul(0x1p-127, 0x1p-127))
            : return(Self.mul(0x1p-127, -0x1p-127))

    // gamma(23/8 + i + d) from a polynomial in d, shifted by the i factors between
    block main(z: F64)
        m    : F64  = z.sub(0x1.7p+1)
        i    : F64  = m.round_ties_even()
        step : F64  = F64.copysign(1.0, i)
        d    : F64  = m.sub(i)
        d2   : F64  = d.mul(d)
        d4   : F64  = d2.mul(d2)
        d8   : F64  = d4.mul(d4)
        a0   : F64  = d.mul(0x1.8f2754ddcf90dp+0).add(0x1.c9a76be577123p+0)
        a2   : F64  = d.mul(0x1.e1f42cf0ae4a1p-2).add(0x1.0d1191949419bp+0)
        a4   : F64  = d.mul(0x1.e1f2b30cd907bp-5).add(0x1.82b358a3ab638p-3)
        a6   : F64  = d.mul(0x1.1522c9f3cd012p-8).add(0x1.240f6d4071bd8p-6)
        a8   : F64  = d.mul(0x1.9808a8b96c37ep-13).add(0x1.1fd0051a0525bp-10)
        a10  : F64  = d.mul(0x1.49c85a7e1fd04p-18).add(0x1.b3f78e01152b5p-15)
        a12  : F64  = d.mul(-0x1.368f0b7ed9e36p-23).add(0x1.471ca49184475p-19)
        a14  : F64  = d.mul(-0x1.a69ed2042842cp-25).add(0x1.882222f9049efp-23)
        b0   : F64  = a0.add(d2.mul(a2))
        b4   : F64  = a4.add(d2.mul(a6))
        b8   : F64  = a8.add(d2.mul(a10))
        b12  : F64  = a12.add(d2.mul(a14))
        lo   : F64  = b0.add(d4.mul(b4))
        hi   : F64  = b8.add(d4.mul(b12))
        f    : F64  = lo.add(d8.mul(hi))
        jm   : S64  = i.abs().to<S64>()
        none : Bool = jm.eq(0)
        branch none
            ? finish(f, i, 1.0)
            : shift(z, f, i, step, jm)

    // the first factor: x - 1/2 - step/2
    block shift(z: F64, f: F64, i: F64, step: F64, jm: S64)
        z1 : F64 = z.sub(step.mul(0.5).add(0.5))
        jump product(z1, z1, jm.sub(1), f, i, step)

    block product(z: F64, w: F64, j: S64, f: F64, i: F64, step: F64)
        done : Bool = j.eq(0)
        branch done
            ? finish(f, i, w)
            : product(z.sub(step), w.mul(z.sub(step)), j.sub(1), f, i, step)

    // for x below the polynomial's interval the product divides
    block finish(f: F64, i: F64, w: F64)
        below : Bool = i.le(-0.5)
        wv    : F64  = below
            ? F64.div(1.0, w)
            : w
        g           : F64  = f.mul(wv)
        r           : Self = g.to<Self>()
        biased_bits : U64  = g.bits().add_wrap(2)
        hard        : Bool = biased_bits.bitand(0xFFFFFFF).lt(8)
        branch hard
            ? return(cm_f32_tgamma_exception(tu, r))
            : return(r)

/// The tabulated correctly rounded gamma for a hard-to-round input with F32 bits xb, or fallback.
private routine cm_f32_tgamma_exception(xb: U32, fallback: F32) -> F32
    block entry()
        jump scan(0)

    block scan(k: USize)
        done : Bool = k.eq(10)
        branch done
            ? return(fallback)
            : check(k)

    block check(k: USize)
        found : Bool = CM_F32_TGAMMA_EXC_X.getitem(k).eq(xb)
        branch found
            ? hit(k)
            : scan(k.add(1))

    block hit(k: USize)
        f  : F32 = F32.from_bits(CM_F32_TGAMMA_EXC_F.getitem(k))
        df : F32 = F32.from_bits(CM_F32_TGAMMA_EXC_DF.getitem(k))
        return(f.add(df))
