// Tessera stdlib: the correctly rounded arc cosine of F32
//
// pi/2 minus a fast odd polynomial in x covers |x| < 0x1.c2a1dcp-1 and settles
// most inputs. The rest go through an accurate path in F64: for |x| < 1/2
// pi/2 - x - x^3 p(x^2), above that sqrt(1 - |x|) times a polynomial in
// 1 - |x|, plus pi for negative x. Both polynomials are cm_f32_asin_poly12
// (Asin.tess). Round to nearest only: |x| > 1 gives NaN, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/acos/acosf.c via RazorForge's B32Acos.rf.
// Copyright (c) 2023 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// arccos(self), correctly rounded.
routine F32.acos(self: Self) -> Self
    block entry():
        xs   : F64  = self.to<F64>()
        t    : U32  = self.bits()
        ax   : U32  = t.shl(1)
        edge : Bool = ax.ge(0x7F000000)
        fast : Bool = ax.lt(0x7EC2A1DC)
        when:
            edge -> edge(t, ax)
            fast -> fast(t, ax, xs)
            else -> accurate(t, ax, xs)

    // |x| >= 1 or NaN, which comes back quiet with its sign and payload
    block edge(t: U32, ax: U32):
        one       : Bool = t.eq(0x3F800000)
        minus_one : Bool = t.eq(0xBF800000)
        nan       : Bool = ax.gt(0xFF000000)
        when:
            one       -> return(0.0)
            minus_one -> return(Self.add(0x1.921fb6p+1, -0x1p-24))
            nan       -> return(self.add(self))
            else      -> return(Self.from_bits(0xFFC00000))

    // |x| < 0x1.c2a1dcp-1
    block fast(t: U32, ax: U32, xs: F64):
        tiny : Bool = ax.lt(0x40000000)  // |x| < 2^-63
        branch tiny
            ? return(Self.add(0x1.921fb6p+0, -0x1.777a5cp-25))
            : continue
        z2   : F64  = xs.mul(xs)
        z4   : F64  = z2.mul(z2)
        z8   : F64  = z4.mul(z4)
        z16  : F64  = z8.mul(z8)
        a01  : F64  = z2.mul(0x1.5555c94838007p-3).add(0x1.fffffffd9ccb8p-1)
        a23  : F64  = z2.mul(0x1.8566df703309ep-5).add(0x1.32ded4b7c20fap-4)
        a45  : F64  = z2.mul(0x1.56fbb04998344p-1).add(-0x1.980c959bec9a3p-6)
        a67  : F64  = z2.mul(0x1.b06c3e9f311eap+4).add(-0x1.403d8e4c49f52p+2)
        p0   : F64  = z8.mul(z4.mul(a67).add(a45)).add(z4.mul(a23).add(a01))
        b01  : F64  = z2.mul(0x1.200b8261cc61bp+8).add(-0x1.9ea97c4e2c21fp+6)
        b23  : F64  = z2.mul(0x1.a558a59cc19d3p+9).add(-0x1.2274c2799a5c7p+9)
        b45  : F64  = z2.mul(0x1.228744703f813p+9).add(-0x1.aca4b6a529ffp+9)
        b67  : F64  = z2.mul(0x1.5c2018c0c0105p+5).add(-0x1.d7dbb0b322228p+7)
        p1   : F64  = z8.mul(z4.mul(b67).add(b45)).add(z4.mul(b23).add(b01))
        rf   : F64  = xs.mul(z16.mul(p1).add(p0))
        ub   : Self = F64.sub(0x1.921fb54574191p+0, rf).to<Self>()
        lb   : Self = F64.sub(0x1.921fb543118ap+0, rf).to<Self>()
        sure : Bool = ub.eq(lb)
        branch sure
            ? return(ub)
            : accurate(t, ax, xs)

    // The fast path can't decide the rounding, or |x| >= 0x1.c2a1dcp-1.
    block accurate(t: U32, ax: U32, xs: F64):
        half : Bool = ax.lt(0x7E000000)  // |x| < 1/2
        branch half
            ? small(t, xs)
            : large(t, xs)

    // pi/2 - x - x^3 p(x^2)
    block small(t: U32, xs: F64):
        hard1 : Bool = t.eq(0x328885A3)
        hard2 : Bool = t.eq(0x39826222)
        when:
            hard1 -> return(Self.add(0x1.921fb6p+0, 0x1p-25))
            hard2 -> return(Self.add(0x1.920f6ap+0, 0x1p-25))
            else  -> continue
        x2 : F64 = xs.mul(xs)
        r  : F64 = F64.sub(0x1.921fb54442d18p+0, xs).sub(xs.mul(x2).mul(cm_f32_asin_poly12(x2, 0)))
        return(r.to<Self>())

    // o + sign(x) sqrt(z) q(z) with z = 1 - |x|, o = pi for negative x and 0 otherwise
    block large(t: U32, xs: F64):
        z        : F64  = F64.sub(1.0, xs.abs())
        s        : F64  = z.sqrt().copysign(xs)
        negative : Bool = t.shr(31).eq(1)
        o        : F64  = negative
            ? 0x1.921fb54442d18p+1
            : 0.0
        r : F64 = s.mul(cm_f32_asin_poly12(z, 12)).add(o)
        return(r.to<Self>())
