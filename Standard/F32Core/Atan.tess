// Tessera stdlib: the correctly rounded arc tangent of F32
//
// A degree-7/7 rational approximation in F64, evaluated at x for |x| < 1 and at
// 1/x above, with atan(x) = sign(x) pi/2 - atan(1/x). Tiny and huge |x| are
// handled apart. Round to nearest only: +-0 stays itself, +-inf gives +-pi/2
// rounded, NaN comes back quiet.
//
// Ported from CORE-MATH, src/binary32/atan/atanf.c via RazorForge's B32Atan.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov <sibid@uvic.ca>
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// arctan(self), correctly rounded.
routine F32.atan(self: Self) -> Self
    shared t  : U32 = self.bits()
    shared e  : U32 = t.shr(23).bitand(0xFF)
    shared ta : U32 = t.bitand(0x7FFFFFFF)

    block entry()
        huge : Bool = ta.ge(0x4C700518)  // |x| >= 0x1.e00a3p+25
        tiny : Bool = e.lt(114)  // |x| < 2^-13
        when
            huge -> huge()
            tiny -> tiny()
            else -> rational()

    // sign(x) pi/2 rounded, or NaN, which comes back quiet with its sign and payload
    block huge()
        nan : Bool = ta.gt(0x7F800000)
        branch nan
            ? return(self.add(self))
            : return(F64.copysign(0x1.921fb54442d18p+0, self.to<F64>()).to<Self>())

    // x - x^3 / 3, and x - x |x| below 2^-25 to round the right way
    block tiny()
        very_tiny : Bool = e.lt(102)  // |x| < 2^-25
        zero      : Bool = t.shl(1).eq(0)
        when
            zero      -> return(self)
            very_tiny -> return(self.neg().mul_add(self.abs(), self))
            else      -> return(Self.mul(-0x1.555556p-2, self).mul_add(self.mul(self), self))

    // |x| >= 2^-13: for |x| >= 1 the rational approximation is evaluated at 1/x
    block rational()
        gt : Bool = e.ge(127)
        xd : F64  = self.to<F64>()
        z  : F64  = gt
            ? F64.div(1.0, xd)
            : xd
        z2  : F64 = z.mul(z)
        z4  : F64 = z2.mul(z2)
        z8  : F64 = z4.mul(z4)
        cn0 : F64 = z2.mul(0x1.a76bb5637f2f2p-1).add(0x1.51eccde075d67p-2)
        cn2 : F64 = z2.mul(0x1.376c8ca67d11dp-2).add(0x1.81e0eed20de88p-1)
        cn4 : F64 = z2.mul(0x1.9561899acc73ep-9).add(0x1.aec7b69202ac6p-5)
        cn6 : F64 = 0x1.bf9fa5b67e6p-16
        n0  : F64 = z4.mul(cn2).add(cn0)
        n4  : F64 = z4.mul(cn6).add(cn4)
        n07 : F64 = z8.mul(n4).add(n0)
        n   : F64 = n07.mul(z)
        cd0 : F64 = z2.mul(0x1.dfbdd7b392d28p-1).add(0x1.51eccde075d66p-2)
        cd2 : F64 = z2.mul(0x1.fd22bf0e89b54p-2).add(0x1p+0)
        cd4 : F64 = z2.mul(0x1.653ea99fc9bbp-7).add(0x1.d91ff8b576282p-4)
        cd6 : F64 = 0x1.1e7fcc202340ap-12
        d0  : F64 = z4.mul(cd2).add(cd0)
        d4  : F64 = z4.mul(cd6).add(cd4)
        d   : F64 = z8.mul(d4).add(d0)
        r   : F64 = n.div(d)
        branch gt  // for |x| < 1, the rounded r is correct
            ? reflect(z, r)
            : return(r.to<Self>())

    // atan(x) = sign(x) pi/2 - atan(1/x), with pi/2 split as 0x1.9p+0 + 0x1.0fdaa22168c23p-7
    block reflect(z: F64, r: F64)
        lo        : F64 = F64.copysign(0x1.0fdaa22168c23p-7, z)
        hi        : F64 = F64.copysign(0x1.9p+0, z)
        reflected : F64 = lo.sub(r).add(hi)
        return(reflected.to<Self>())
