// Tessera stdlib: the correctly rounded sin(pi x) of F32
//
// With 64 x = iq + z/2^32 for an integer iq: sin(iq pi/64) and cos(iq pi/64) from a table, sin(z pi/2^38) and
// cos(z pi/2^38) - 1 from short polynomials, all in F64, where one evaluation rounds correctly to F32. Integers
// give +-0 with the sign of x, |x| >= 2^23 is an even integer. Round to nearest only.
//
// Also home to the sin(i pi/64) table that cos_pi shares.
//
// Ported from CORE-MATH, src/binary32/sinpi/sinpif.c via RazorForge's B32Sinpi.rf.
// Copyright (c) 2022-2025 Alexei Sibidanov
// MIT license: see LICENSE-CORE-MATH

module Standard::Core

/// sin(i pi/64) for i in 0..127, as F64 bits. Cos_pi uses it too.
preset CM_F32_SIN_PI_S: @Array<U64, 128> <- { 0x0000000000000000, 0x3FA91F65F10DD814,
    0x3FB917A6BC29B42C, 0x3FC2C8106E8E613A, 0x3FC8F8B83C69A60B, 0x3FCF19F97B215F1B,
    0x3FD294062ED59F06, 0x3FD58F9A75AB1FDD, 0x3FD87DE2A6AEA963, 0x3FDB5D1009E15CC0,
    0x3FDE2B5D3806F63B, 0x3FE073879922FFEE, 0x3FE1C73B39AE68C8, 0x3FE30FF7FCE17035,
    0x3FE44CF325091DD6, 0x3FE57D69348CECA0, 0x3FE6A09E667F3BCD, 0x3FE7B5DF226AAFAF,
    0x3FE8BC806B151741, 0x3FE9B3E047F38741, 0x3FEA9B66290EA1A3, 0x3FEB728345196E3E,
    0x3FEC38B2F180BDB1, 0x3FECED7AF43CC773, 0x3FED906BCF328D46, 0x3FEE212104F686E5,
    0x3FEE9F4156C62DDA, 0x3FEF0A7EFB9230D7, 0x3FEF6297CFF75CB0, 0x3FEFA7557F08A517,
    0x3FEFD88DA3D12526, 0x3FEFF621E3796D7E, 0x3FF0000000000000, 0x3FEFF621E3796D7E,
    0x3FEFD88DA3D12526, 0x3FEFA7557F08A517, 0x3FEF6297CFF75CB0, 0x3FEF0A7EFB9230D7,
    0x3FEE9F4156C62DDA, 0x3FEE212104F686E5, 0x3FED906BCF328D46, 0x3FECED7AF43CC773,
    0x3FEC38B2F180BDB1, 0x3FEB728345196E3E, 0x3FEA9B66290EA1A3, 0x3FE9B3E047F38741,
    0x3FE8BC806B151741, 0x3FE7B5DF226AAFAF, 0x3FE6A09E667F3BCD, 0x3FE57D69348CECA0,
    0x3FE44CF325091DD6, 0x3FE30FF7FCE17035, 0x3FE1C73B39AE68C8, 0x3FE073879922FFEE,
    0x3FDE2B5D3806F63B, 0x3FDB5D1009E15CC0, 0x3FD87DE2A6AEA963, 0x3FD58F9A75AB1FDD,
    0x3FD294062ED59F06, 0x3FCF19F97B215F1B, 0x3FC8F8B83C69A60B, 0x3FC2C8106E8E613A,
    0x3FB917A6BC29B42C, 0x3FA91F65F10DD814, 0x0000000000000000, 0xBFA91F65F10DD814,
    0xBFB917A6BC29B42C, 0xBFC2C8106E8E613A, 0xBFC8F8B83C69A60B, 0xBFCF19F97B215F1B,
    0xBFD294062ED59F06, 0xBFD58F9A75AB1FDD, 0xBFD87DE2A6AEA963, 0xBFDB5D1009E15CC0,
    0xBFDE2B5D3806F63B, 0xBFE073879922FFEE, 0xBFE1C73B39AE68C8, 0xBFE30FF7FCE17035,
    0xBFE44CF325091DD6, 0xBFE57D69348CECA0, 0xBFE6A09E667F3BCD, 0xBFE7B5DF226AAFAF,
    0xBFE8BC806B151741, 0xBFE9B3E047F38741, 0xBFEA9B66290EA1A3, 0xBFEB728345196E3E,
    0xBFEC38B2F180BDB1, 0xBFECED7AF43CC773, 0xBFED906BCF328D46, 0xBFEE212104F686E5,
    0xBFEE9F4156C62DDA, 0xBFEF0A7EFB9230D7, 0xBFEF6297CFF75CB0, 0xBFEFA7557F08A517,
    0xBFEFD88DA3D12526, 0xBFEFF621E3796D7E, 0xBFF0000000000000, 0xBFEFF621E3796D7E,
    0xBFEFD88DA3D12526, 0xBFEFA7557F08A517, 0xBFEF6297CFF75CB0, 0xBFEF0A7EFB9230D7,
    0xBFEE9F4156C62DDA, 0xBFEE212104F686E5, 0xBFED906BCF328D46, 0xBFECED7AF43CC773,
    0xBFEC38B2F180BDB1, 0xBFEB728345196E3E, 0xBFEA9B66290EA1A3, 0xBFE9B3E047F38741,
    0xBFE8BC806B151741, 0xBFE7B5DF226AAFAF, 0xBFE6A09E667F3BCD, 0xBFE57D69348CECA0,
    0xBFE44CF325091DD6, 0xBFE30FF7FCE17035, 0xBFE1C73B39AE68C8, 0xBFE073879922FFEE,
    0xBFDE2B5D3806F63B, 0xBFDB5D1009E15CC0, 0xBFD87DE2A6AEA963, 0xBFD58F9A75AB1FDD,
    0xBFD294062ED59F06, 0xBFCF19F97B215F1B, 0xBFC8F8B83C69A60B, 0xBFC2C8106E8E613A,
    0xBFB917A6BC29B42C, 0xBFA91F65F10DD814 }

/// sin(pi me), correctly rounded (to nearest, ties to even). An integer gives +-0 with the sign of me, a
/// half-integer +-1, +-inf gives NaN, and NaN comes back quiet.
/// :returns: sin(pi `me`).
routine F32.sin_pi(me: Me) -> Me
    shared ix        : U32  = me.bits()
    shared e         : S32  = ix.shr(23).bitand(0xFF).to_wrap<S32>()
    shared negative  : Bool = ix.shr(31).eq(1)
    shared zero      : Me   = Me.copysign(0.0, me)
    shared magnitude : U32  = ix.bitand(0x7FFFFF).bitor(0x800000)
    shared sgn       : U32  = negative
        ? 0xFFFFFFFF
        : 0
    // the significand with the sign of x, in two's complement
    shared m : U32 = magnitude.bitxor(sgn).sub_wrap(sgn)

    block entry()
        special : Bool = e.eq(0xFF)
        branch special
            ? special()
            : continue
        s     : S32  = S32.sub(143, e)
        big   : Bool = s.lt(0)
        small : Bool = s.gt(30)
        when
            big   -> large(s)
            small -> tiny()
            else  -> moderate(s)

    // infinities give NaN, NaN comes back quiet with its sign and payload
    block special()
        infinite : Bool = ix.shl(9).eq(0)
        branch infinite
            ? return(Me.from_bits(0x7FC00000))
            : return(me.add(me))

    // |x| >= 2^17: x is a multiple of 1/64
    block large(s: S32)
        even : Bool = s.lt(-6)  // |x| >= 2^23: x is an even integer
        branch even
            ? return(zero)
            : continue
        shift   : U32  = s.neg().sub(1).to<U32>()
        iq      : U32  = m.shl(shift).bitand(127)
        integer : Bool = iq.eq(0).bitor(iq.eq(64))
        branch integer
            ? return(zero)
            : continue
        r : F64 = F64.from_bits(CM_F32_SIN_PI_S.getitem(iq.to<USize>()))
        return(r.to<Me>())

    // |x| < 2^-14: sin(pi x) ~ pi x - (pi x)^3 / 6
    block tiny()
        z  : F64 = me.to<F64>()
        z2 : F64 = z.mul(z)
        p  : F64 = F64.add(0x1.921fb54442d18p+1, z2.mul(-0x1.4abbce625be53p+2))
        r  : F64 = z.mul(p)
        return(r.to<Me>())

    block moderate(s: S32)
        si      : S32  = S32.sub(25, s)
        bits_in : Bool = si.ge(0)
        branch bits_in
            ? fraction(s, si.to<U32>())
            : evaluate(s)

    // 2^-1 <= |x| < 2^17: x is an integer when its bits below the binary point are all 0
    block fraction(s: S32, si: U32)
        integer : Bool = m.shl(si).eq(0)
        branch integer
            ? return(zero)
            : evaluate(s)

    block evaluate(s: S32)
        shift   : U32 = S32.sub(31, s).to<U32>()
        k       : S32 = m.shl(shift).to_wrap<S32>()  // 64 x - round(64 x), scaled by 2^32
        z       : F64 = k.to<F64>()
        z2      : F64 = z.mul(z)
        fs2     : F64 = F64.add(-0x1.4abbce6102b94p-112, z2.mul(0x1.4669fa3c58463p-189))
        fs      : F64 = F64.add(0x1.921fb54442d0fp-37, z2.mul(fs2))
        fc2     : F64 = F64.add(0x1.03c1f08088742p-150, z2.mul(-0x1.55d1e5eff55a5p-228))
        fc      : F64 = F64.add(-0x1.3bd3cc9be45cfp-74, z2.mul(fc2))
        shifted : U32 = m.to_wrap<S32>().shr(s).to_wrap<U32>()
        iq      : U32 = shifted.add_wrap(1).shr(1)  // round(64 x)
        ts      : F64 = F64.from_bits(CM_F32_SIN_PI_S.getitem(iq.bitand(127).to<USize>()))
        tc_i    : U32 = iq.add_wrap(32).bitand(127)
        tc      : F64 = F64.from_bits(CM_F32_SIN_PI_S.getitem(tc_i.to<USize>()))
        head    : F64 = ts.add(ts.mul(z2).mul(fc))
        r       : F64 = head.add(tc.mul(z).mul(fs))
        return(r.to<Me>())
