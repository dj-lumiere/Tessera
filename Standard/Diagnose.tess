// Tessera stdlib: diagnosing
//
// Diagnose writes a value the way a programmer reads it: as Tessera source
// where there is a literal for it. Represent is for the program's own output,
// so a Bytes represents as its text but diagnoses in quotes with escapes:
//
//     Out.write("{name}")              // Ada
//     Out.write("{name.diagnose()}")   // "Ada"
//
// x.diagnose() and x.represent() don't write anything: they hand back x in an
// adapter (Diagnosed<T>, Represented<T>) that writes it the chosen way where
// it is written, so a template hole picks the form. diagnose_into(out) and
// represent_into(out) are the routines that write, which a type defines.
//
// Numbers and Bool read the same both ways. Char diagnoses as 'A', Byte as b'A'
// (b'\x7f' when it isn't printable ASCII), and an Array as [1, 2, 3]. Pointers
// diagnose as their address.
//
// A record, choice, or variant gets a diagnose from the builder with
// #derive(Diagnose): Point { x: 1, y: 2 }, Color.Red, Option.Present(3).
// #derive(Represent) writes the same record text (fields are diagnosed inside
// any aggregate), a choice member as Red, and a variant case as Present(3).

module Standard::Format

/// A type that can write itself the way a programmer reads it, as Tessera source where a literal exists, with `diagnose_into`.
/// :typeparam T: The type that can write its source-like text.
concept Diagnose<T>
require T: typename
    routine Self.diagnose_into<W>(self: Self, out: @W) -> Void

conform Diagnose<S8>, Diagnose<S16>, Diagnose<S32>, Diagnose<S64>, Diagnose<S128>, Diagnose<S256>
conform Diagnose<U8>, Diagnose<U16>, Diagnose<U32>, Diagnose<U64>, Diagnose<U128>, Diagnose<U256>
conform Diagnose<USize>, Diagnose<SSize>
conform Diagnose<F16>, Diagnose<BF16>, Diagnose<F32>, Diagnose<F64>, Diagnose<F128>
conform Diagnose<Bool>, Diagnose<Char>, Diagnose<Byte>, Diagnose<Bytes>, Diagnose<Unit>, Diagnose<Addr>
conform Diagnose<@T>          when T: typename
conform Diagnose<Array<T, N>> when T: typename, N: USize, Diagnose<T>

// -- text ----------------------------------------------------------------------

/// One byte inside a quoted literal: an escape (\n, \t, \r, \0, \\, or the
/// quote), the byte itself when it's printable ASCII, and otherwise \xHH, or
/// \u0000HH when as_char (a character literal takes no \x).
routine write_escaped_byte<W>(out: @W, byte: Byte, quote: Byte, as_char: Bool) -> Void
require W: typename, Writer<W>
    block entry()
        is_quote : Bool = byte.eq(quote)
        branch is_quote
            ? escaped()
            : named()

    block escaped()
        write_str(out, "\\")
        jump raw()

    block named()
        when byte
            b'\n' -> escape("\\n")
            b'\t' -> escape("\\t")
            b'\r' -> escape("\\r")
            b'\0' -> escape("\\0")
            b'\\' -> escape("\\\\")
            else  -> other()

    block escape(text: Bytes)
        write_str(out, text)
        return()

    block other()
        printable : Bool = byte.between(0x20, 0x7E)
        branch printable
            ? raw()
            : hex()

    block raw()
        claim slot : @Byte <- byte
        out.write_bytes(slot, 1)
        return()

    block hex()
        branch as_char
            ? char_hex()
            : byte_hex()

    block byte_hex()
        write_str(out, "\\x")
        code : U64 = byte.to<U8>().to<U64>()
        code.represent_hex(out, 2)
        return()

    block char_hex()
        write_str(out, "\\u")
        code : U64 = byte.to<U8>().to<U64>()
        code.represent_hex(out, 6)
        return()

/// In quotes: ASCII through the byte escapes, a well-formed UTF-8 character as
/// it is, and each byte of a malformed sequence as \xHH, so the text reads back
/// as the same bytes.
routine Bytes.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        write_str(out, "\"")
        jump walk(0)

    block walk(at: USize)
        count : USize = self.count
        more  : Bool  = at.lt(count)
        branch more
            ? step(at)
            : close()

    block step(at: USize)
        data  : @Byte = self.data
        byte  : Byte  = data.stride(at).load()
        ascii : Bool  = byte.lt(0x80)
        branch ascii
            ? ascii(at, byte)
            : wide(at, byte)

    block ascii(at: USize, byte: Byte)
        write_escaped_byte(out, byte, b'"', false)
        jump walk(at.add(1))

    block wide(at: USize, byte: Byte)
        data : @Byte       = self.data
        d    : Utf8Decoded = utf8_decode(data, at, self.count)
        branch d.ok
            ? character(at, d.next_pos)
            : malformed(at, byte)

    block character(at: USize, next: USize)
        data : @Byte = self.data
        out.write_bytes(data.stride(at), next.sub(at))
        jump walk(next)

    block malformed(at: USize, byte: Byte)
        write_escaped_byte(out, byte, b'"', false)
        jump walk(at.add(1))

    block close()
        write_str(out, "\"")
        return()

/// Writes the byte as a byte literal such as `b'A'`, escaping quotes, backslashes and non-printable bytes.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Byte.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        write_str(out, "b'")
        write_escaped_byte(out, self, b'\'', false)
        write_str(out, "'")
        return()

/// ASCII goes through the byte escapes, and any other character is written as its
/// UTF-8.
routine Char.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        write_str(out, "'")
        code  : U32  = self.to<U32>()
        ascii : Bool = code.lt(128)
        branch ascii
            ? ascii(code)
            : wide()

    block ascii(code: U32)
        byte : Byte = code.to<U8>().bits()
        write_escaped_byte(out, byte, b'\'', true)
        jump close()

    block wide()
        self.represent_into(out)
        jump close()

    block close()
        write_str(out, "'")
        return()

// -- values that read the same both ways ---------------------------------------

/// Writes `true` or `false`, the same as `represent_into`.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Bool.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        self.represent_into(out)
        return()

/// Writes the unit value as `Unit`.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Unit.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        write_str(out, "Unit")
        return()

/// Writes the address like `represent_into`: `0x` and lowercase hex.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Addr.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        self.represent_into(out)
        return()

/// Writes the pointer as its address, never what it points to.
/// :typeparam T: The pointee type.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Ptr<T>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, W: typename, Writer<W>
    block entry()
        self.represent_into(out)
        return()

// -- arrays --------------------------------------------------------------------

/// Writes the array as `[a, b, c]`, diagnosing each of the `N` elements in order.
/// :typeparam T: The element type, which must conform to {Diagnose}.
/// :typeparam N: The number of elements.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Array<T, N>.diagnose_into<W>(self: Self, out: @W) -> Void
require T: typename, N: USize, Diagnose<T>, W: typename, Writer<W>
    block entry()
        claim slot : @Self <- self
        write_str(out, "[")
        jump walk(0, slot)

    block walk(at: USize, slot: @Self)
        more : Bool = at.lt(N)
        branch more
            ? item(at, slot)
            : close()

    block item(at: USize, slot: @Self)
        first : Bool = at.eq(0)
        branch first
            ? element(at, slot)
            : separate(at, slot)

    block separate(at: USize, slot: @Self)
        write_str(out, ", ")
        jump element(at, slot)

    block element(at: USize, slot: @Self)
        value : T = slot.getitem(at)
        value.diagnose_into(out)
        jump walk(at.add(1), slot)

    block close()
        write_str(out, "]")
        return()

// -- numbers -------------------------------------------------------------------
//
// A number's decimal text is already its literal (floats keep a .0 or an
// exponent), so diagnose is represent.

/// Writes the S8 as its decimal literal, the same as `represent_into`.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S8.diagnose_into<W>(self: Self, out: @W) -> Void
require W: typename, Writer<W>
    block entry()
        self.represent_into(out)
        return()

