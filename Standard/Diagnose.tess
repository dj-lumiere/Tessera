// Tessera stdlib: diagnosing
//
// Diagnosable writes a value the way a programmer reads it: as Tessera source
// where there is a literal for it. Representable is for the program's own output,
// so a Bytes represents as its text but diagnoses in quotes with escapes:
//
//     Out.write("{name}")              // Ada
//     Out.write("{name.diagnose()}")   // "Ada"
//
// x.diagnose() and x.represent() don't write anything: they hand back x in an
// adapter (Diagnosed<T>, Represented<T>) that writes it the chosen way where
// it is written, so a template hole picks the form. diagnose_into(out) and
// represent_into(out) are the routines that write, which a type defines.
//
// Numbers and Bool read the same both ways. Char diagnoses as 'A', Byte as b'A'
// (b'\x7f' when it isn't printable ASCII), and an Array as [1, 2, 3]. Pointers
// diagnose as their address.
//
// A record, choice, or variant gets a diagnose from the builder with
// #derive(Diagnosable): Point { x: 1, y: 2 }, Color.Red, Option.Present(3).
// #derive(Representable) writes the same record text (fields are diagnosed inside
// any aggregate), a choice member as Red, and a variant case as Present(3).

module Standard::Format

/// A type that can write itself the way a programmer reads it, as Tessera source where a literal exists, with `diagnose_into`.
/// :typeparam T: The type that can write its source-like text.
concept Diagnosable<T>
require T: typename
    /// Writes `me` the way a programmer reads it, as Tessera source where a literal exists.
    /// :typeparam TWriter: The type of the Writer that receives the text.
    /// :param out: The Writer the text is written to.
    routine Me.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void

conform Diagnosable<S8>, Diagnosable<S16>, Diagnosable<S32>, Diagnosable<S64>, Diagnosable<S128>, Diagnosable<S256>
conform Diagnosable<U8>, Diagnosable<U16>, Diagnosable<U32>, Diagnosable<U64>, Diagnosable<U128>, Diagnosable<U256>
conform Diagnosable<USize>, Diagnosable<SSize>
conform Diagnosable<F16>, Diagnosable<BF16>, Diagnosable<F32>, Diagnosable<F64>, Diagnosable<F128>
conform Diagnosable<Bool>, Diagnosable<Char>, Diagnosable<Byte>, Diagnosable<Bytes>, Diagnosable<Unit>, Diagnosable<Addr>
conform Diagnosable<Array<T, COUNT>> when T: typename, COUNT: USize, Diagnosable<T>

// -- text ----------------------------------------------------------------------

/// Writes one byte inside a quoted literal: an escape (\n, \t, \r, \0, \\, or the quote), the byte itself when it's
/// printable ASCII, and otherwise \xHH, or \u0000HH when `as_char` (a character literal takes no \x).
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
/// :param byte: The byte to write.
/// :param quote: The literal's quote character, which gets a backslash.
/// :param as_char: Whether the literal is a character literal.
routine write_escaped_byte<T>(out: @T, byte: Byte, quote: Byte, as_char: Bool) -> Void
require T: typename, Writer<T>
    block entry()
        is_quote : Bool = byte.eq(quote)
        branch is_quote
            ? escaped()
            : named()

    block escaped()
        write_str(out, "\\")
        jump raw()

    block named()
        when byte
            b'\n' -> escape("\\n")
            b'\t' -> escape("\\t")
            b'\r' -> escape("\\r")
            b'\0' -> escape("\\0")
            b'\\' -> escape("\\\\")
            else  -> other()

    block escape(text: Bytes)
        write_str(out, text)
        return()

    block other()
        printable : Bool = byte.between(0x20, 0x7E)
        branch printable
            ? raw()
            : hex()

    block raw()
        claim slot : @Byte <- byte
        out.write_bytes(slot, 1)
        return()

    block hex()
        branch as_char
            ? char_hex()
            : byte_hex()

    block byte_hex()
        write_str(out, "\\x")
        code : U64 = byte.to<U8>().to<U64>()
        code.represent_hex_into(out, 2)
        return()

    block char_hex()
        write_str(out, "\\u")
        code : U64 = byte.to<U8>().to<U64>()
        code.represent_hex_into(out, 6)
        return()

/// Writes the text in quotes: ASCII through the byte escapes, a well-formed UTF-8 character as it is, and each byte
/// of a malformed sequence as \xHH, so the text reads back as the same bytes.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Bytes.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        write_str(out, "\"")
        jump walk(0)

    block walk(at: USize)
        count : USize = me.count
        more  : Bool  = at.lt(count)
        branch more
            ? step(at)
            : close()

    block step(at: USize)
        data  : @Byte = me.data
        byte  : Byte  = data.stride(at).load()
        ascii : Bool  = byte.lt(0x80)
        branch ascii
            ? ascii(at, byte)
            : wide(at, byte)

    block ascii(at: USize, byte: Byte)
        write_escaped_byte(out, byte, b'"', false)
        jump walk(at.add(1))

    block wide(at: USize, byte: Byte)
        data : @Byte       = me.data
        d    : Utf8Decoded = utf8_decode(data, at, me.count)
        branch d.ok
            ? character(at, d.next_pos)
            : malformed(at, byte)

    block character(at: USize, next: USize)
        data : @Byte = me.data
        out.write_bytes(data.stride(at), next.sub(at))
        jump walk(next)

    block malformed(at: USize, byte: Byte)
        write_escaped_byte(out, byte, b'"', false)
        jump walk(at.add(1))

    block close()
        write_str(out, "\"")
        return()

/// Writes the byte as a byte literal such as `b'A'`, escaping quotes, backslashes and non-printable bytes.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Byte.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        write_str(out, "b'")
        write_escaped_byte(out, me, b'\'', false)
        write_str(out, "'")
        return()

/// Writes the character as a character literal such as `'A'`: ASCII goes through the byte escapes, and any other
/// character is written as its UTF-8.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Char.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    shared code : U32 = me.to<U32>()

    block entry()
        write_str(out, "'")
        ascii : Bool = code.lt(128)
        branch ascii
            ? ascii()
            : wide()

    block ascii()
        byte : Byte = code.to<U8>().bits()
        write_escaped_byte(out, byte, b'\'', true)
        jump close()

    block wide()
        me.represent_into(out)
        jump close()

    block close()
        write_str(out, "'")
        return()

// -- values that read the same both ways ---------------------------------------

/// Writes `true` or `false`, the same as `represent_into`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Bool.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        me.represent_into(out)
        return()

/// Writes the unit value as `Unit`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Unit.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        write_str(out, "Unit")
        return()

/// Writes the address like `represent_into`: `0x` and lowercase hex.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Addr.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        me.represent_into(out)
        return()

// -- arrays --------------------------------------------------------------------

/// Writes the array as `[a, b, c]`, diagnosing each of the `COUNT` elements in order.
/// :typeparam T: The element type, which must conform to {Diagnosable}.
/// :typeparam COUNT: The number of elements.
/// :typeparam TWriter: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Array<T, COUNT>.diagnose_into<TWriter>(me: Me, out: @TWriter) -> Void
require T: typename, COUNT: USize, Diagnosable<T>, TWriter: typename, Writer<TWriter>
    shared slot : @Me <- me

    block entry()
        write_str(out, "[")
        jump walk(0)

    block walk(at: USize)
        more : Bool = at.lt(COUNT)
        branch more
            ? item(at)
            : close()

    block item(at: USize)
        first : Bool = at.eq(0)
        branch first
            ? element(at)
            : separate(at)

    block separate(at: USize)
        write_str(out, ", ")
        jump element(at)

    block element(at: USize)
        value : T = slot.getitem(at)
        value.diagnose_into(out)
        jump walk(at.add(1))

    block close()
        write_str(out, "]")
        return()

// -- numbers -------------------------------------------------------------------
//
// A number's decimal text is already its literal (floats keep a .0 or an
// exponent), so diagnose is represent.

/// Writes the S8 as its decimal literal, the same as `represent_into`.
/// :typeparam T: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine S8.diagnose_into<T>(me: Me, out: @T) -> Void
require T: typename, Writer<T>
    block entry()
        me.represent_into(out)
        return()

