// -- the adapters --------------------------------------------------------------

/// x, to be written by its diagnose_into: what x.diagnose() hands back.
record Diagnosed<T>
    value : T

/// x, to be written by its represent_into: what x.represent() hands back.
record Represented<T>
    value : T

conform Represent<Diagnosed<T>>   when T: typename, Diagnose<T>
conform Represent<Represented<T>> when T: typename, Represent<T>

/// self, to be written as Tessera source: Out.write("{x.diagnose()}").
routine T.diagnose(self: T) -> Diagnosed<T>
require T: typename, Diagnose<T>
    block entry()
        return(Diagnosed<Self> { value: self })

/// self, to be written as the program's output (what a plain hole already does): Out.write("{x.represent()}").
routine T.represent(self: T) -> Represented<T>
require T: typename, Represent<T>
    block entry()
        return(Represented<Self> { value: self })

/// Writes the wrapped value with its `diagnose_into`, so a template hole holding `x.diagnose()` prints the source form.
/// :typeparam T: The wrapped type, which must conform to {Diagnose}.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Diagnosed<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Diagnose<T>, W: typename, Writer<W>
    block entry()
        self.value.diagnose_into(out)
        return()

/// Writes the wrapped value with its `represent_into`.
/// :typeparam T: The wrapped type, which must conform to {Represent}.
/// :typeparam W: The type of the Writer that receives the text.
/// :param out: The Writer the text is written to.
routine Represented<T>.represent_into<W>(self: Self, out: @W) -> Void
require T: typename, Represent<T>, W: typename, Writer<W>
    block entry()
        self.value.represent_into(out)
        return()
