; SHA-256 (FIPS 180-4) — Tessera playground
;
; Hashes the standard NIST test vectors and prints each digest in hex.
;
; What this program stresses:
;   * no operators: every rotate, xor, and add of the round function is a
;     method call, so one line of the spec becomes several named values
;   * loop-carried state: the eight working variables a..h ride through the
;     round loop as one struct value (Working) instead of eight block params
;   * static data: the 64 round constants and the initial hash are const
;     arrays, read-only globals that the rounds load from (K[t])
;
; Expected output:
;   empty     e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
;   abc       ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
;   448-bit   248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
;   million-a cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0

; ── C FFI ─────────────────────────────────────────────────────────────────────

@[external("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<I8>) -> I32

; ── Types ─────────────────────────────────────────────────────────────────────

const MILLION: I64 = 1000000

; K[0..64): the first 32 bits of the fractional parts of the cube roots of the
; first 64 primes.
const K: Array<I32, 64> = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

; H(0): the first 32 bits of the fractional parts of the square roots of the
; first 8 primes.
const H0: Array<I32, 8> = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

; The eight working variables of one compression. The round loop carries them
; as a single SSA value, so each jump passes one argument instead of eight.
struct Working
    a: I32
    b: I32
    c: I32
    d: I32
    e: I32
    f: I32
    g: I32
    h: I32

; ── Round functions (FIPS 180-4 §4.1.2) ──────────────────────────────────────

; Σ0(x) = ROTR²(x) ⊕ ROTR¹³(x) ⊕ ROTR²²(x)
routine big_sigma0(%x: I32) -> I32
    block entry():
        %r2:     I32 = %x.rotr(2)
        %r13:    I32 = %x.rotr(13)
        %r22:    I32 = %x.rotr(22)
        %result: I32 = %r2.bitxor(%r13).bitxor(%r22)
        return(%result)

; Σ1(x) = ROTR⁶(x) ⊕ ROTR¹¹(x) ⊕ ROTR²⁵(x)
routine big_sigma1(%x: I32) -> I32
    block entry():
        %r6:     I32 = %x.rotr(6)
        %r11:    I32 = %x.rotr(11)
        %r25:    I32 = %x.rotr(25)
        %result: I32 = %r6.bitxor(%r11).bitxor(%r25)
        return(%result)

; σ0(x) = ROTR⁷(x) ⊕ ROTR¹⁸(x) ⊕ SHR³(x)
routine small_sigma0(%x: I32) -> I32
    block entry():
        %r7:     I32 = %x.rotr(7)
        %r18:    I32 = %x.rotr(18)
        %s3:     I32 = %x.lshr(3)
        %result: I32 = %r7.bitxor(%r18).bitxor(%s3)
        return(%result)

; σ1(x) = ROTR¹⁷(x) ⊕ ROTR¹⁹(x) ⊕ SHR¹⁰(x)
routine small_sigma1(%x: I32) -> I32
    block entry():
        %r17:    I32 = %x.rotr(17)
        %r19:    I32 = %x.rotr(19)
        %s10:    I32 = %x.lshr(10)
        %result: I32 = %r17.bitxor(%r19).bitxor(%s10)
        return(%result)

; Ch(e, f, g) = (e ∧ f) ⊕ (¬e ∧ g): each bit of e picks f or g.
routine choose(%e: I32, %f: I32, %g: I32) -> I32
    block entry():
        %from_f: I32 = %e.bitand(%f)
        %from_g: I32 = %e.bitnot().bitand(%g)
        %result: I32 = %from_f.bitxor(%from_g)
        return(%result)

; Maj(a, b, c) = (a ∧ b) ⊕ (a ∧ c) ⊕ (b ∧ c): the bitwise majority vote.
routine majority(%a: I32, %b: I32, %c: I32) -> I32
    block entry():
        %ab:     I32 = %a.bitand(%b)
        %ac:     I32 = %a.bitand(%c)
        %bc:     I32 = %b.bitand(%c)
        %result: I32 = %ab.bitxor(%ac).bitxor(%bc)
        return(%result)

; One round:
;   T1 = h + Σ1(e) + Ch(e, f, g) + K[t] + W[t]
;   T2 = Σ0(a) + Maj(a, b, c)
;   (a, b, c, d, e, f, g, h) ← (T1 + T2, a, b, c, d + T1, e, f, g)
routine sha256_round(%v: Working, %k: I32, %w: I32) -> Working
    block entry():
        %a: I32 = %v.a
        %b: I32 = %v.b
        %c: I32 = %v.c
        %d: I32 = %v.d
        %e: I32 = %v.e
        %f: I32 = %v.f
        %g: I32 = %v.g
        %h: I32 = %v.h

        %sigma1: I32 = big_sigma1(%e)
        %ch:     I32 = choose(%e, %f, %g)
        %t1:     I32 = %h.add(%sigma1).add(%ch).add(%k).add(%w)
        %sigma0: I32 = big_sigma0(%a)
        %maj:    I32 = majority(%a, %b, %c)
        %t2:     I32 = %sigma0.add(%maj)

        %new_a: I32 = %t1.add(%t2)
        %new_e: I32 = %d.add(%t1)
        %next:  Working = Working {
            a: %new_a, b: %a, c: %b, d: %c,
            e: %new_e, f: %e, g: %f, h: %g
        }
        return(%next)

; ── Byte order ────────────────────────────────────────────────────────────────

; Reads 4 bytes as a big-endian word. Byte loads, so #p needs no alignment.
routine load_be32(#p: Ptr<I8>) -> I32
    block entry():
        %b0: I8 := #p[0]
        %b1: I8 := #p[1]
        %b2: I8 := #p[2]
        %b3: I8 := #p[3]
        %w0: I32 = %b0.to_u32().shl(24)
        %w1: I32 = %b1.to_u32().shl(16)
        %w2: I32 = %b2.to_u32().shl(8)
        %w3: I32 = %b3.to_u32()
        %result: I32 = %w0.bitor(%w1).bitor(%w2).bitor(%w3)
        return(%result)

; Writes %value as 8 big-endian bytes.
routine store_be64(#p: Ptr<I8>, %value: I64) -> Void
    block entry():
        jump byte_loop(0)

    block byte_loop(%i: I64):
        %done: Bool = %i.sge(8)
        branch %done ? return() : store_byte(%i)

    block store_byte(%i: I64):
        %shift: I64 = 56.sub(%i.mul(8))
        %byte:  I8  = %value.lshr(%shift).to_i8()
        #p[%i] = %byte
        jump byte_loop(%i.add(1))

; ── Compression ───────────────────────────────────────────────────────────────

; Mixes one 64-byte block into the 8-word #state.
routine sha256_compress(#state: Ptr<I32>, #block: Ptr<I8>) -> Void
    block entry():
        #schedule: Ptr<Array<I32, 64>> = alloca<Array<I32, 64>>
        #w:        Ptr<I32>             = #schedule.cast<I32>()
        jump load_words(0, #w)

    ; W[0..16) — the block's own words.
    block load_words(%t: I64, #w: Ptr<I32>):
        %done: Bool = %t.sge(16)
        branch %done ? extend(16, #w) : load_word(%t, #w)

    block load_word(%t: I64, #w: Ptr<I32>):
        %offset: I64     = %t.mul(4)
        #src:    Ptr<I8> = #block[%offset]
        %word:   I32     = load_be32(#src)
        #w[%t] = %word
        jump load_words(%t.add(1), #w)

    ; W[16..64) — W[t] = σ1(W[t-2]) + W[t-7] + σ0(W[t-15]) + W[t-16]
    block extend(%t: I64, #w: Ptr<I32>):
        %done: Bool = %t.sge(64)
        branch %done ? rounds(#w) : extend_word(%t, #w)

    block extend_word(%t: I64, #w: Ptr<I32>):
        %i2:  I64 = %t.sub(2)
        %i7:  I64 = %t.sub(7)
        %i15: I64 = %t.sub(15)
        %i16: I64 = %t.sub(16)
        %w2:  I32 := #w[%i2]
        %w7:  I32 := #w[%i7]
        %w15: I32 := #w[%i15]
        %w16: I32 := #w[%i16]
        %s1:  I32 = small_sigma1(%w2)
        %s0:  I32 = small_sigma0(%w15)
        #w[%t] = %s1.add(%w7).add(%s0).add(%w16)
        jump extend(%t.add(1), #w)

    block rounds(#w: Ptr<I32>):
        %a: I32 := #state[0]
        %b: I32 := #state[1]
        %c: I32 := #state[2]
        %d: I32 := #state[3]
        %e: I32 := #state[4]
        %f: I32 := #state[5]
        %g: I32 := #state[6]
        %h: I32 := #state[7]
        %start: Working = Working { a: %a, b: %b, c: %c, d: %d, e: %e, f: %f, g: %g, h: %h }
        jump round_loop(0, %start, #w)

    block round_loop(%t: I64, %v: Working, #w: Ptr<I32>):
        %done: Bool = %t.sge(64)
        branch %done ? finish(%v) : round(%t, %v, #w)

    block round(%t: I64, %v: Working, #w: Ptr<I32>):
        %k_t:  I32     := K[%t]
        %w_t:  I32     := #w[%t]
        %next: Working = sha256_round(%v, %k_t, %w_t)
        jump round_loop(%t.add(1), %next, #w)

    ; H[i] += working variable i
    block finish(%v: Working):
        %h0: I32 := #state[0]
        %h1: I32 := #state[1]
        %h2: I32 := #state[2]
        %h3: I32 := #state[3]
        %h4: I32 := #state[4]
        %h5: I32 := #state[5]
        %h6: I32 := #state[6]
        %h7: I32 := #state[7]
        #state[0] = %h0.add(%v.a)
        #state[1] = %h1.add(%v.b)
        #state[2] = %h2.add(%v.c)
        #state[3] = %h3.add(%v.d)
        #state[4] = %h4.add(%v.e)
        #state[5] = %h5.add(%v.f)
        #state[6] = %h6.add(%v.g)
        #state[7] = %h7.add(%v.h)
        return()

; ── One-shot hash ─────────────────────────────────────────────────────────────

; Hashes #data[0..len) and writes the 8-word digest to #digest.
routine sha256(#data: Ptr<I8>, %len: I64, #digest: Ptr<I32>) -> Void
    block entry():
        #h0: Ptr<I32> = H0.as_ptr()
        copy<I32>(#digest, #h0, 8)
        %full_blocks: I64 = %len.sdiv(64)
        jump block_loop(0, %full_blocks)

    ; Every complete 64-byte block is compressed straight from #data.
    block block_loop(%i: I64, %full_blocks: I64):
        %done: Bool = %i.sge(%full_blocks)
        branch %done ? pad(%full_blocks) : compress_block(%i, %full_blocks)

    block compress_block(%i: I64, %full_blocks: I64):
        %offset: I64     = %i.mul(64)
        #src:    Ptr<I8> = #data[%offset]
        sha256_compress(#digest, #src)
        jump block_loop(%i.add(1), %full_blocks)

    ; The tail: leftover bytes, then 0x80, zeros, and the message length in
    ; bits as a big-endian I64. That fits one block when fewer than 56 bytes
    ; are left over, and takes two otherwise.
    block pad(%full_blocks: I64):
        %rest_start: I64 = %full_blocks.mul(64)
        %rest_len:   I64 = %len.sub(%rest_start)

        #tail_buf: Ptr<Array<I8, 128>> = alloca<Array<I8, 128>>
        #tail:     Ptr<I8>             = #tail_buf.cast<I8>()
        zero<I8>(#tail, 128)
        #rest: Ptr<I8> = #data[%rest_start]
        copy<I8>(#tail, #rest, %rest_len)
        #tail[%rest_len] = b'\x80'

        %one_block: Bool = %rest_len.slt(56)
        %tail_len:  I64  = %one_block ? 64 : 128
        %len_at:    I64  = %tail_len.sub(8)
        %bits:      I64  = %len.shl(3)
        #len_dst: Ptr<I8> = #tail[%len_at]
        store_be64(#len_dst, %bits)

        sha256_compress(#digest, #tail)
        branch %one_block ? return() : second_tail(#tail)

    block second_tail(#tail: Ptr<I8>):
        #second: Ptr<I8> = #tail[64]
        sha256_compress(#digest, #second)
        return()

; ── Output ────────────────────────────────────────────────────────────────────

routine print_digest(#label: Ptr<I8>, #digest: Ptr<I32>) -> Void
    block entry():
        c_printf("%-9s ", #label)
        jump word_loop(0)

    block word_loop(%i: I64):
        %done: Bool = %i.sge(8)
        branch %done ? end_line() : print_word(%i)

    block print_word(%i: I64):
        %word: I32 := #digest[%i]
        c_printf("%08x", %word)
        jump word_loop(%i.add(1))

    block end_line():
        c_printf("\n")
        return()

routine hash_and_print(#label: Ptr<I8>, #data: Ptr<I8>, %len: I64) -> Void
    block entry():
        #digest_buf: Ptr<Array<I32, 8>> = alloca<Array<I32, 8>>
        #digest:     Ptr<I32>            = #digest_buf.cast<I32>()
        sha256(#data, %len, #digest)
        print_digest(#label, #digest)
        return()

routine hash_string(#label: Ptr<I8>, %message: String) -> Void
    block entry():
        #data: Ptr<I8> = %message.data
        %len:  I64     = %message.length
        hash_and_print(#label, #data, %len)
        return()

; ── main ──────────────────────────────────────────────────────────────────────

routine main() -> I32
    block entry():
        hash_string("empty", "")
        hash_string("abc", "abc")
        hash_string("448-bit", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")

        ; One million 'a' bytes: 15,625 full blocks plus a two-block tail.
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        #many:  Ptr<I8>        = alloc<I8>(#alloc, MILLION)
        %failed: Bool = #many.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : fill_loop(0, #alloc, #many)

    block fill_loop(%i: I64, #alloc: Ptr<Allocator>, #many: Ptr<I8>):
        %done: Bool = %i.sge(MILLION)
        branch %done ? hash_many(#alloc, #many) : fill_byte(%i, #alloc, #many)

    block fill_byte(%i: I64, #alloc: Ptr<Allocator>, #many: Ptr<I8>):
        #many[%i] = b'a'
        jump fill_loop(%i.add(1), #alloc, #many)

    block hash_many(#alloc: Ptr<Allocator>, #many: Ptr<I8>):
        hash_and_print("million-a", #many, MILLION)
        free<I8>(#alloc, #many)
        return(0)
