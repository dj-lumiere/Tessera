// Integer expression calculator — Tessera playground
//
// Parses and evaluates integer expressions such as "-(4 - 10) % 4":
//
//     expr    = term    (("+" | "-") term)*
//     term    = primary (("*" | "/" | "%") primary)*
//     primary = number | "(" expr ")" | "-" primary
//
// The parser builds a heap-allocated tree, the evaluator walks it with
// overflow-checked S64 arithmetic, and every error (bad token, missing ")",
// division by zero, overflow) is reported with its column.
//
// What this program stresses:
//   * sum types: Expr is a tag plus every variant's fields. There is no
//     payload-carrying choice; switches on the tag name every kind instead of
//     using '_', so adding a kind is a compile error until each one handles it
//   * error propagation: every call that can fail is followed by an explicit
//     tag test and branch; Result<Ptr<Expr>, CalcError> is spelled out each time
//   * cleanup on failure paths: when the right operand fails to parse, the
//     already-built left subtree has to be freed by hand
//   * recursion: parse_binary, parse_primary, eval, and free_expr recurse

// ── C FFI ─────────────────────────────────────────────────────────────────────

@[external("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<Byte>) -> S32

// ── Tokens ────────────────────────────────────────────────────────────────────

choice TokenKind: U8
    Number
    Plus
    Minus
    Star
    Slash
    Percent
    LParen
    RParen
    End
    Invalid

record Token
    kind  : TokenKind
    value : S64  // Number only
    pos   : U64  // byte offset of the first character
    end   : U64  // byte offset just past the token

record CalcError
    message : Ptr<Byte>
    pos     : U64

// ── Syntax tree ───────────────────────────────────────────────────────────────

choice ExprKind: U8
    Num
    Neg
    Add
    Sub
    Mul
    Div
    Rem

/// A manual sum type: `kind` says which fields mean something.
///   Num                    value
///   Neg                    lhs (the operand)
///   Add Sub Mul Div Rem    lhs, rhs
/// `pos` is the column of the number or operator, for error messages.
record Expr
    kind  : ExprKind
    value : S64
    lhs   : Ptr<Expr>
    rhs   : Ptr<Expr>
    pos   : U64

routine new_expr(#alloc: Ptr<Allocator>, %node: Expr) -> Ptr<Expr>
    block entry():
        #p      : Ptr<Expr> = alloc<Expr>(#alloc, 1)
        %failed : Bool      = #p.is_null()
        branch %failed ? panic(TrapCode.AllocFailed) : store(#p)

    block store(#p: Ptr<Expr>):
        #p.store(%node)
        return(#p)

/// Frees #e and its whole subtree.
routine free_expr(#e: Ptr<Expr>, #alloc: Ptr<Allocator>) -> Void
    block entry():
        %kind : ExprKind = #e.kind.load()
        when %kind:
            ExprKind.Num                                                         -> release()
            ExprKind.Neg                                                         -> free_operand()
            ExprKind.Add, ExprKind.Sub, ExprKind.Mul, ExprKind.Div, ExprKind.Rem -> free_both()

    block free_operand():
        #operand : Ptr<Expr> = #e.lhs.load()
        free_expr(#operand, #alloc)
        jump release()

    block free_both():
        #lhs : Ptr<Expr> = #e.lhs.load()
        #rhs : Ptr<Expr> = #e.rhs.load()
        free_expr(#lhs, #alloc)
        free_expr(#rhs, #alloc)
        jump release()

    block release():
        #e.free(#alloc)
        return()

// ── Lexer ─────────────────────────────────────────────────────────────────────

record Parser
    src   : Ptr<Byte>
    len   : U64
    pos   : U64
    alloc : Ptr<Allocator>

routine is_digit(%c: Byte) -> Bool
    block entry():
        %above  : Bool = %c.ge(b'0')
        %below  : Bool = %c.le(b'9')
        %result : Bool = %above.bitand(%below)
        return(%result)

/// Reads the token at the current position without consuming it.
/// Fails only on a number that doesn't fit in S64.
routine Parser.peek(#self: Ptr<Self>) -> Result<Token, CalcError>
    block entry():
        %start : U64 = #self.pos.load()
        jump skip_space(%start)

    block skip_space(%i: U64):
        %len    : U64  = #self.len.load()
        %at_end : Bool = %i.ge(%len)
        branch %at_end ? end_token(%i) : check_space(%i)

    block check_space(%i: U64):
        #src      : Ptr<Byte> = #self.src.load()
        %c        : Byte      = #src[%i].load()
        %is_space : Bool      = %c.eq(b' ')
        branch %is_space ? skip_space(%i.add(1)) : classify(%i, %c)

    block end_token(%i: U64):
        %tok : Token                    = Token { kind: TokenKind.End, value: 0, pos: %i, end: %i }
        %r   : Result<Token, CalcError> = .success(%tok)
        return(%r)

    block classify(%i: U64, %c: Byte):
        %digit : Bool = is_digit(%c)
        branch %digit ? digits(%i, %i, 0) : punct(%i, %c)

    block punct(%i: U64, %c: Byte):
        when %c:
            b'+' -> single(%i, TokenKind.Plus)
            b'-' -> single(%i, TokenKind.Minus)
            b'*' -> single(%i, TokenKind.Star)
            b'/' -> single(%i, TokenKind.Slash)
            b'%' -> single(%i, TokenKind.Percent)
            b'(' -> single(%i, TokenKind.LParen)
            b')' -> single(%i, TokenKind.RParen)
            _    -> single(%i, TokenKind.Invalid)

    block single(%i: U64, %kind: TokenKind):
        %end : U64                      = %i.add(1)
        %tok : Token                    = Token { kind: %kind, value: 0, pos: %i, end: %end }
        %r   : Result<Token, CalcError> = .success(%tok)
        return(%r)

    // %acc is the value of src[start..j) so far.
    block digits(%start: U64, %j: U64, %acc: S64):
        %len    : U64  = #self.len.load()
        %at_end : Bool = %j.ge(%len)
        branch %at_end ? number_done(%start, %j, %acc) : check_digit(%start, %j, %acc)

    block check_digit(%start: U64, %j: U64, %acc: S64):
        #src   : Ptr<Byte> = #self.src.load()
        %c     : Byte      = #src[%j].load()
        %digit : Bool      = is_digit(%c)
        branch %digit ? scale(%start, %j, %acc, %c) : number_done(%start, %j, %acc)

    block scale(%start: U64, %j: U64, %acc: S64, %c: Byte):
        %scaled  : Option<S64> = %acc.mul_checked(10)
        %fits    : Bool        = %scaled.tag
        %times10 : S64         = %scaled.value
        branch %fits ? add_digit(%start, %j, %times10, %c) : too_large(%start)

    block add_digit(%start: U64, %j: U64, %times10: S64, %c: Byte):
        %digit : S64         = %c.to_u8().sub(b'0'.to_u8()).to_s64()
        %sum   : Option<S64> = %times10.add_checked(%digit)
        %fits  : Bool        = %sum.tag
        %next  : S64         = %sum.value
        branch %fits ? digits(%start, %j.add(1), %next) : too_large(%start)

    block too_large(%start: U64):
        %e : CalcError                = CalcError { message: "number too large", pos: %start }
        %r : Result<Token, CalcError> = .failure(%e)
        return(%r)

    block number_done(%start: U64, %j: U64, %acc: S64):
        %tok : Token                    = Token { kind: TokenKind.Number, value: %acc, pos: %start,
                end: %j }
        %r   : Result<Token, CalcError> = .success(%tok)
        return(%r)

routine Parser.advance(#self: Ptr<Self>, %tok: Token) -> Void
    block entry():
        %end : U64 = %tok.end
        #self.pos.store(%end)
        return()

// ── Parser ────────────────────────────────────────────────────────────────────

/// The binary operator %kind stands for at precedence %level
/// (0: + -, 1: * / %), or None when it isn't one.
routine operator_at(%kind: TokenKind, %level: S64) -> Option<ExprKind>
    block entry():
        %additive : Bool = %level.eq(0)
        branch %additive ? additive() : multiplicative()

    block additive():
        when %kind:
            TokenKind.Plus  -> found(ExprKind.Add)
            TokenKind.Minus -> found(ExprKind.Sub)
            _               -> not_found()

    block multiplicative():
        when %kind:
            TokenKind.Star    -> found(ExprKind.Mul)
            TokenKind.Slash   -> found(ExprKind.Div)
            TokenKind.Percent -> found(ExprKind.Rem)
            _                 -> not_found()

    block found(%op: ExprKind):
        %r : Option<ExprKind> = .present(%op)
        return(%r)

    block not_found():
        %r : Option<ExprKind> = .absent()
        return(%r)

/// An operand of a level-%level operator: the next level down, or a primary.
routine Parser.parse_operand(#self: Ptr<Self>, %level: S64) -> Result<Ptr<Expr>, CalcError>
    block entry():
        %lowest : Bool = %level.eq(0)
        branch %lowest ? term() : primary()

    block term():
        %r : Result<Ptr<Expr>, CalcError> = #self.parse_binary(1)
        return(%r)

    block primary():
        %r : Result<Ptr<Expr>, CalcError> = #self.parse_primary()
        return(%r)

/// operand (op operand)* at one precedence level, folded to the left.
routine Parser.parse_binary(#self: Ptr<Self>, %level: S64) -> Result<Ptr<Expr>, CalcError>
    block entry():
        %first : Result<Ptr<Expr>, CalcError> = #self.parse_operand(%level)
        %ok    : Bool                         = %first.tag
        #lhs   : Ptr<Expr>                    = %first.value
        branch %ok ? next_op(#lhs) : return(%first)

    block next_op(#lhs: Ptr<Expr>):
        %peeked : Result<Token, CalcError> = #self.peek()
        %ok     : Bool                     = %peeked.tag
        %tok    : Token                    = %peeked.value
        %error  : CalcError                = %peeked.error
        branch %ok ? check_op(#lhs, %tok) : abandon(#lhs, %error)

    block check_op(#lhs: Ptr<Expr>, %tok: Token):
        %tok_kind : TokenKind                    = %tok.kind
        %op       : Option<ExprKind>             = operator_at(%tok_kind, %level)
        %is_op    : Bool                         = %op.tag
        %kind     : ExprKind                     = %op.value
        %done     : Result<Ptr<Expr>, CalcError> = .success(#lhs)
        branch %is_op ? continue : return(%done)
        #self.advance(%tok)
        %rhs   : Result<Ptr<Expr>, CalcError> = #self.parse_operand(%level)
        %ok    : Bool                         = %rhs.tag
        #right : Ptr<Expr>                    = %rhs.value
        %error : CalcError                    = %rhs.error
        %pos   : U64                          = %tok.pos
        branch %ok ? combine(#lhs, #right, %kind, %pos) : abandon(#lhs, %error)

    block combine(#lhs: Ptr<Expr>, #right: Ptr<Expr>, %kind: ExprKind, %pos: U64):
        #alloc : Ptr<Allocator> = #self.alloc.load()
        %node  : Expr           = Expr { kind: %kind, value: 0, lhs: #lhs, rhs: #right, pos: %pos }
        #tree  : Ptr<Expr>      = new_expr(#alloc, %node)
        jump next_op(#tree)

    // The left side parsed but what follows didn't: free it before failing.
    block abandon(#lhs: Ptr<Expr>, %error: CalcError):
        #alloc : Ptr<Allocator> = #self.alloc.load()
        free_expr(#lhs, #alloc)
        %r : Result<Ptr<Expr>, CalcError> = .failure(%error)
        return(%r)

routine Parser.parse_primary(#self: Ptr<Self>) -> Result<Ptr<Expr>, CalcError>
    block entry():
        %peeked : Result<Token, CalcError> = #self.peek()
        %ok     : Bool                     = %peeked.tag
        %tok    : Token                    = %peeked.value
        %error  : CalcError                = %peeked.error
        branch %ok ? dispatch(%tok) : fail(%error)

    block dispatch(%tok: Token):
        %kind : TokenKind = %tok.kind
        %pos  : U64       = %tok.pos
        when %kind:
            TokenKind.Number  -> number(%tok)
            TokenKind.LParen  -> group(%tok)
            TokenKind.Minus   -> negate(%tok)
            TokenKind.End     -> fail_at("unexpected end of input", %pos)
            TokenKind.Invalid -> fail_at("unexpected character", %pos)
            _                 -> fail_at("expected a number or '('", %pos)

    block number(%tok: Token):
        #self.advance(%tok)
        #alloc : Ptr<Allocator>               = #self.alloc.load()
        %value : S64                          = %tok.value
        %pos   : U64                          = %tok.pos
        %node  : Expr                         = Expr { kind: ExprKind.Num, value: %value, lhs: null,
                rhs: null, pos: %pos }
        #leaf  : Ptr<Expr>                    = new_expr(#alloc, %node)
        %r     : Result<Ptr<Expr>, CalcError> = .success(#leaf)
        return(%r)

    block negate(%tok: Token):
        #self.advance(%tok)
        %inner   : Result<Ptr<Expr>, CalcError> = #self.parse_primary()
        %ok      : Bool                         = %inner.tag
        #operand : Ptr<Expr>                    = %inner.value
        %pos     : U64                          = %tok.pos
        branch %ok ? wrap_neg(#operand, %pos) : return(%inner)

    block wrap_neg(#operand: Ptr<Expr>, %pos: U64):
        #alloc : Ptr<Allocator>               = #self.alloc.load()
        %node  : Expr                         = Expr { kind: ExprKind.Neg, value: 0, lhs: #operand,
                rhs: null, pos: %pos }
        #tree  : Ptr<Expr>                    = new_expr(#alloc, %node)
        %r     : Result<Ptr<Expr>, CalcError> = .success(#tree)
        return(%r)

    // "(" expr ")"
    block group(%open: Token):
        #self.advance(%open)
        %inner : Result<Ptr<Expr>, CalcError> = #self.parse_binary(0)
        %ok    : Bool                         = %inner.tag
        #tree  : Ptr<Expr>                    = %inner.value
        branch %ok ? expect_close(#tree) : return(%inner)

    block expect_close(#tree: Ptr<Expr>):
        %peeked : Result<Token, CalcError> = #self.peek()
        %ok     : Bool                     = %peeked.tag
        %close  : Token                    = %peeked.value
        %error  : CalcError                = %peeked.error
        branch %ok ? check_close(#tree, %close) : abandon(#tree, %error)

    block check_close(#tree: Ptr<Expr>, %close: Token):
        %kind   : TokenKind = %close.kind
        %closed : Bool      = %kind.eq(TokenKind.RParen)
        %pos    : U64       = %close.pos
        %e      : CalcError = CalcError { message: "expected ')'", pos: %pos }
        branch %closed ? close(#tree, %close) : abandon(#tree, %e)

    block close(#tree: Ptr<Expr>, %close: Token):
        #self.advance(%close)
        %r : Result<Ptr<Expr>, CalcError> = .success(#tree)
        return(%r)

    block abandon(#tree: Ptr<Expr>, %error: CalcError):
        #alloc : Ptr<Allocator> = #self.alloc.load()
        free_expr(#tree, #alloc)
        jump fail(%error)

    block fail_at(#message: Ptr<Byte>, %pos: U64):
        %e : CalcError = CalcError { message: #message, pos: %pos }
        jump fail(%e)

    block fail(%error: CalcError):
        %r : Result<Ptr<Expr>, CalcError> = .failure(%error)
        return(%r)

/// Parses all of %source; anything left after the expression is an error.
routine parse(%source: String, #alloc: Ptr<Allocator>) -> Result<Ptr<Expr>, CalcError>
    block entry():
        #src   : Ptr<Byte> = %source.data
        %len   : U64       = %source.length
        %state : Parser    = Parser { src: #src, len: %len, pos: 0, alloc: #alloc }
        claim #self : Ptr<Parser>
        #self.store(%state)
        %parsed : Result<Ptr<Expr>, CalcError> = #self.parse_binary(0)
        %ok     : Bool                         = %parsed.tag
        #tree   : Ptr<Expr>                    = %parsed.value
        branch %ok ? expect_end(#self, #tree) : return(%parsed)

    block expect_end(#self: Ptr<Parser>, #tree: Ptr<Expr>):
        %peeked : Result<Token, CalcError>     = #self.peek()
        %tok    : Token                        = %peeked.value
        %kind   : TokenKind                    = %tok.kind
        %at_end : Bool                         = %kind.eq(TokenKind.End)
        %pos    : U64                          = %tok.pos
        %done   : Result<Ptr<Expr>, CalcError> = .success(#tree)
        // a lex error here is still "something after the expression"
        branch %at_end ? return(%done) : continue
        free_expr(#tree, #alloc)
        %e : CalcError                    = CalcError {
                message: "unexpected input after expression", pos: %pos }
        %r : Result<Ptr<Expr>, CalcError> = .failure(%e)
        return(%r)

// ── Evaluator ─────────────────────────────────────────────────────────────────

routine eval(#e: Ptr<Expr>) -> Result<S64, CalcError>
    block entry():
        %kind : ExprKind = #e.kind.load()
        %pos  : U64      = #e.pos.load()
        when %kind:
            ExprKind.Num                                                         -> number()
            ExprKind.Neg                                                         -> negate(%pos)
            ExprKind.Add, ExprKind.Sub, ExprKind.Mul, ExprKind.Div, ExprKind.Rem -> binary(%kind,
                    %pos)

    block number():
        %value : S64                    = #e.value.load()
        %r     : Result<S64, CalcError> = .success(%value)
        return(%r)

    block negate(%pos: U64):
        #operand : Ptr<Expr>              = #e.lhs.load()
        %inner   : Result<S64, CalcError> = eval(#operand)
        %ok      : Bool                   = %inner.tag
        %x       : S64                    = %inner.value
        branch %ok ? checked(%x.neg_checked(), %pos) : return(%inner)

    block binary(%kind: ExprKind, %pos: U64):
        #lhs  : Ptr<Expr>              = #e.lhs.load()
        %left : Result<S64, CalcError> = eval(#lhs)
        %ok   : Bool                   = %left.tag
        %a    : S64                    = %left.value
        branch %ok ? eval_rhs(%kind, %pos, %a) : return(%left)

    block eval_rhs(%kind: ExprKind, %pos: U64, %a: S64):
        #rhs   : Ptr<Expr>              = #e.rhs.load()
        %right : Result<S64, CalcError> = eval(#rhs)
        %ok    : Bool                   = %right.tag
        %b     : S64                    = %right.value
        branch %ok ? continue : return(%right)
        %zero_divisor : Bool = %b.eq(0)
        when %kind:
            ExprKind.Add -> checked(%a.add_checked(%b), %pos)
            ExprKind.Sub -> checked(%a.sub_checked(%b), %pos)
            ExprKind.Mul -> checked(%a.mul_checked(%b), %pos)
            ExprKind.Div -> divide(%pos, %a, %b, %zero_divisor)
            ExprKind.Rem -> remainder(%pos, %a, %b, %zero_divisor)
            _            -> unreachable  // binary() only ever passes the five binary kinds

    block divide(%pos: U64, %a: S64, %b: S64, %zero_divisor: Bool):
        %quotient : Option<S64> = %a.div_checked(%b)
        branch %zero_divisor ? division_by_zero(%pos) : checked(%quotient, %pos)

    block remainder(%pos: U64, %a: S64, %b: S64, %zero_divisor: Bool):
        %rest : Option<S64> = %a.rem_checked(%b)
        branch %zero_divisor ? division_by_zero(%pos) : checked(%rest, %pos)

    // None from a checked operation with a nonzero divisor means overflow.
    block checked(%result: Option<S64>, %pos: U64):
        %fits  : Bool                   = %result.tag
        %value : S64                    = %result.value
        %ok    : Result<S64, CalcError> = .success(%value)
        %e     : CalcError              = CalcError { message: "overflow", pos: %pos }
        %fail  : Result<S64, CalcError> = .failure(%e)
        branch %fits ? return(%ok) : return(%fail)

    block division_by_zero(%pos: U64):
        %e : CalcError              = CalcError { message: "division by zero", pos: %pos }
        %r : Result<S64, CalcError> = .failure(%e)
        return(%r)

// ── Driver ────────────────────────────────────────────────────────────────────

routine calculate(%source: String, #alloc: Ptr<Allocator>) -> Void
    block entry():
        #src : Ptr<Byte> = %source.data
        c_printf("%-34s ", #src)
        %parsed : Result<Ptr<Expr>, CalcError> = parse(%source, #alloc)
        %ok     : Bool                         = %parsed.tag
        #tree   : Ptr<Expr>                    = %parsed.value
        %error  : CalcError                    = %parsed.error
        branch %ok ? evaluate(#tree) : report(%error)

    block evaluate(#tree: Ptr<Expr>):
        %result : Result<S64, CalcError> = eval(#tree)
        free_expr(#tree, #alloc)
        %ok    : Bool      = %result.tag
        %value : S64       = %result.value
        %error : CalcError = %result.error
        branch %ok ? show(%value) : report(%error)

    block show(%value: S64):
        c_printf("= %lld\n", %value)
        return()

    block report(%error: CalcError):
        %pos     : U64       = %error.pos
        #message : Ptr<Byte> = %error.message
        c_printf("error at column %lld: %s\n", %pos.add(1), #message)
        return()

routine main() -> S32
    block entry():
        %heap : Allocator = make_heap_allocator()
        claim #alloc : Ptr<Allocator>
        #alloc.store(%heap)

        calculate("1 + 2 * 3", #alloc)
        calculate("(1 + 2) * 3", #alloc)
        calculate("-(4 - 10) % 4", #alloc)
        calculate("2 * (3 + 4) * 5 - 100 / 7", #alloc)
        calculate("--7", #alloc)
        calculate("((((42))))", #alloc)
        calculate("9223372036854775807", #alloc)

        calculate("7 / (3 - 3)", #alloc)
        calculate("9223372036854775807 + 1", #alloc)
        calculate("-9223372036854775807 - 1 - 1", #alloc)
        calculate("99999999999999999999", #alloc)
        calculate("1 + * 2", #alloc)
        calculate("(1 + 2", #alloc)
        calculate("1 + 2)", #alloc)
        calculate("3 $ 4", #alloc)
        calculate("", #alloc)
        return(0)
