; Tessera stdlib algorithm: iterative lazy segment tree
;
; T and L must satisfy LazySegmentOps<T, L>.
; Ranges are half-open: [left, right).
;
; Layout:
;   data[1..size)      internal aggregate nodes
;   data[size..2*size) leaves
;   lazy[1..size)      pending internal lazy tags
;
; The bit routines below hide the heap-index arithmetic. They are compact on
; purpose, but callers use names that describe the tree operation.

concept Monoid<T>
require T: typename
    routine Self.identity() -> Self
    routine Self.combine(%self: Self, %right: Self) -> Self

concept Group<T>
conform Monoid<T>
require T: typename
    routine Self.inverse(%self: Self) -> Self

; Constrains two types at once, so there is no single conforming Self —
; required routines name their owner (T or L) explicitly.
concept LazySegmentOps<T, L>
require T: typename, L: typename
    ; Aggregate two child values.
    routine T.combine(%self: Self, %right: Self) -> Self

    ; Apply one lazy tag to an aggregate value over a segment of length.
    routine T.apply(%self: Self, %lazy: L, %length: I64) -> Self

    ; Compose tags so the returned tag represents newer after older.
    routine L.compose(%self: Self, %older: Self) -> Self

    routine T.identity() -> Self
    routine L.identity() -> Self
    routine L.is_identity_lazy(%self: Self) -> Bool

struct LazySegmentTree<T, L>
require T: typename, L: typename, LazySegmentOps<T, L>
    data: Ptr<T>
    lazy: Ptr<L>
    length: I64
    size: I64
    height: I64

routine LazySegmentTree<T, L>.parent(#self: Ptr<Self>, %node: I64) -> I64
    block entry():
        %parent: I64 = %node.lshr(1)
        return(%parent)

routine LazySegmentTree<T, L>.left_child(#self: Ptr<Self>, %node: I64) -> I64
    block entry():
        %child: I64 = %node.shl(1)
        return(%child)

routine LazySegmentTree<T, L>.right_child(#self: Ptr<Self>, %node: I64) -> I64
    block entry():
        %right_child: I64 = %node.shl(1).bitor(1)
        return(%right_child)

routine LazySegmentTree<T, L>.is_right_child(#self: Ptr<Self>, %node: I64) -> Bool
    block entry():
        %is_right: Bool = %node.bitand(1).ne(0)
        return(%is_right)

routine LazySegmentTree<T, L>.leaf(#self: Ptr<Self>, %index: I64) -> I64
    block entry():
        %size: I64 := #self.size
        %leaf: I64 = %index.bitor(%size)
        return(%leaf)

routine LazySegmentTree<T, L>.cover_width(#self: Ptr<Self>, %height: I64) -> I64
    block entry():
        %width: I64 = 1.shl(%height)
        return(%width)

routine LazySegmentTree<T, L>.cover_mask(#self: Ptr<Self>, %height: I64) -> I64
    block entry():
        %mask: I64 = #self.cover_width(%height).sub(1)
        return(%mask)

routine LazySegmentTree<T, L>.aligned_to_cover(#self: Ptr<Self>, %node: I64, %height: I64) -> Bool
    block entry():
        %mask: I64 = #self.cover_mask(%height)
        %aligned: Bool = %node.bitand(%mask).eq(0)
        return(%aligned)

routine LazySegmentTree<T, L>.new(%length: I64, #alloc: Ptr<Allocator>) -> Self
    block entry():
        %invalid: Bool = %length.sle(0)
        branch %invalid ? panic(TrapCode.InvalidArgument) : choose_size(1, 0)

    block choose_size(%size: I64, %height: I64):
        %done: Bool = %size.sge(%length)
        branch %done ? allocate(%size, %height) : grow(%size, %height)

    block grow(%size: I64, %height: I64):
        jump choose_size(%size.shl(1), %height.add(1))

    block allocate(%size: I64, %height: I64):
        %data_count: I64 = %size.shl(1)
        #data: Ptr<T> = alloc<T>(#alloc, %data_count)
        #lazy: Ptr<L> = alloc<L>(#alloc, %size)
        %data_failed: Bool = #data.is_null()
        %lazy_failed: Bool = #lazy.is_null()
        %failed: Bool = %data_failed.bitor(%lazy_failed)
        branch %failed ? panic(TrapCode.AllocFailed) : init_data(#data, #lazy, %length, %size, %height, %data_count)

    block init_data(
            #data: Ptr<T>, #lazy: Ptr<L>, %length: I64,
            %size: I64, %height: I64, %data_count: I64):
        jump data_loop(0, #data, #lazy, %length, %size, %height, %data_count)

    block data_loop(
            %i: I64, #data: Ptr<T>, #lazy: Ptr<L>, %length: I64,
            %size: I64, %height: I64, %data_count: I64):
        %done: Bool = %i.sge(%data_count)
        branch %done
            ? init_lazy(0, #data, #lazy, %length, %size, %height)
            : data_one(%i, #data, #lazy, %length, %size, %height, %data_count)

    block data_one(
            %i: I64, #data: Ptr<T>, #lazy: Ptr<L>, %length: I64,
            %size: I64, %height: I64, %data_count: I64):
        %identity: T = T.identity()
        #data[%i] = %identity
        jump data_loop(%i.add(1), #data, #lazy, %length, %size, %height, %data_count)

    block init_lazy(%i: I64, #data: Ptr<T>, #lazy: Ptr<L>, %length: I64, %size: I64, %height: I64):
        %done: Bool = %i.sge(%size)
        branch %done
            ? finish(#data, #lazy, %length, %size, %height)
            : lazy_one(%i, #data, #lazy, %length, %size, %height)

    block lazy_one(%i: I64, #data: Ptr<T>, #lazy: Ptr<L>, %length: I64, %size: I64, %height: I64):
        %identity: L = L.identity()
        #lazy[%i] = %identity
        jump init_lazy(%i.add(1), #data, #lazy, %length, %size, %height)

    block finish(#data: Ptr<T>, #lazy: Ptr<L>, %length: I64, %size: I64, %height: I64):
        %tree: Self = Self {
            data: #data,
            lazy: #lazy,
            length: %length,
            size: %size,
            height: %height
        }
        return(%tree)

routine LazySegmentTree<T, L>.length(#self: Ptr<Self>) -> I64
    block entry():
        %length: I64 := #self.length
        return(%length)

routine LazySegmentTree<T, L>.build_from(#self: Ptr<Self>, #values: Ptr<T>) -> Void
    block entry():
        jump copy_loop(0)

    block copy_loop(%i: I64):
        %length: I64 := #self.length
        %done: Bool = %i.sge(%length)
        branch %done ? reset_lazy(0) : copy_one(%i)

    block copy_one(%i: I64):
        #data: Ptr<T> := #self.data
        %leaf: I64 = #self.leaf(%i)
        %value: T := #values[%i]
        #data[%leaf] = %value
        jump copy_loop(%i.add(1))

    block reset_lazy(%i: I64):
        %size: I64 := #self.size
        %done: Bool = %i.sge(%size)
        branch %done ? pull_all() : reset_one(%i)

    block reset_one(%i: I64):
        #lazy: Ptr<L> := #self.lazy
        %identity: L = L.identity()
        #lazy[%i] = %identity
        jump reset_lazy(%i.add(1))

    block pull_all():
        %size: I64 := #self.size
        %start: I64 = %size.sub(1)
        jump pull_loop(%start)

    block pull_loop(%node: I64):
        %done: Bool = %node.sle(0)
        branch %done ? return() : pull_one(%node)

    block pull_one(%node: I64):
        #self.pull_node(%node)
        jump pull_loop(%node.sub(1))

routine LazySegmentTree<T, L>.pull_node(#self: Ptr<Self>, %node: I64) -> Void
    block entry():
        #data: Ptr<T> := #self.data
        %left: I64 = #self.left_child(%node)
        %right: I64 = #self.right_child(%node)
        %left_value: T := #data[%left]
        %right_value: T := #data[%right]
        %value: T = %left_value.combine(%right_value)
        #data[%node] = %value
        return()

routine LazySegmentTree<T, L>.apply_node(#self: Ptr<Self>, %node: I64, %tag: L, %width: I64) -> Void
    block entry():
        #data: Ptr<T> := #self.data
        %value: T := #data[%node]
        %next_value: T = %value.apply(%tag, %width)
        #data[%node] = %next_value
        %size: I64 := #self.size
        %internal: Bool = %node.slt(%size)
        branch %internal ? store_lazy(%node, %tag, %width) : return()

    block store_lazy(%node: I64, %tag: L, %width: I64):
        #lazy: Ptr<L> := #self.lazy
        %old: L := #lazy[%node]
        %next: L = %tag.compose(%old)
        #lazy[%node] = %next
        return()

routine LazySegmentTree<T, L>.push_node(#self: Ptr<Self>, %node: I64, %width: I64) -> Void
    block entry():
        #lazy: Ptr<L> := #self.lazy
        %tag: L := #lazy[%node]
        %clean: Bool = %tag.is_identity_lazy()
        branch %clean ? return() : spread(%node, %tag, %width)

    block spread(%node: I64, %tag: L, %width: I64):
        %child_width: I64 = %width.lshr(1)
        %left: I64 = #self.left_child(%node)
        %right: I64 = #self.right_child(%node)
        #self.apply_node(%left, %tag, %child_width)
        #self.apply_node(%right, %tag, %child_width)
        #lazy: Ptr<L> := #self.lazy
        %identity: L = L.identity()
        #lazy[%node] = %identity
        return()

routine LazySegmentTree<T, L>.push_path(#self: Ptr<Self>, %node: I64) -> Void
    block entry():
        %height: I64 := #self.height
        jump loop(%height)

    block loop(%level: I64):
        %done: Bool = %level.sle(0)
        branch %done ? return() : push_one(%level)

    block push_one(%level: I64):
        %ancestor: I64 = %node.lshr(%level)
        %width: I64 = #self.cover_width(%level)
        #self.push_node(%ancestor, %width)
        jump loop(%level.sub(1))

routine LazySegmentTree<T, L>.rebuild_path(#self: Ptr<Self>, %node: I64) -> Void
    block entry():
        %parent: I64 = #self.parent(%node)
        jump loop(%parent)

    block loop(%node: I64):
        %done: Bool = %node.sle(0)
        branch %done ? return() : pull(%node)

    block pull(%node: I64):
        #self.pull_node(%node)
        %parent: I64 = #self.parent(%node)
        jump loop(%parent)

routine LazySegmentTree<T, L>.rebuild_left_boundary(#self: Ptr<Self>, %node: I64) -> Void
    block entry():
        jump loop(1)

    block loop(%level: I64):
        %height: I64 := #self.height
        %done: Bool = %level.sgt(%height)
        branch %done ? return() : check(%level)

    block check(%level: I64):
        %aligned: Bool = #self.aligned_to_cover(%node, %level)
        branch %aligned ? next(%level) : pull(%level)

    block pull(%level: I64):
        %ancestor: I64 = %node.lshr(%level)
        #self.pull_node(%ancestor)
        jump next(%level)

    block next(%level: I64):
        jump loop(%level.add(1))

routine LazySegmentTree<T, L>.rebuild_right_boundary(#self: Ptr<Self>, %exclusive: I64) -> Void
    block entry():
        jump loop(1)

    block loop(%level: I64):
        %height: I64 := #self.height
        %done: Bool = %level.sgt(%height)
        branch %done ? return() : check(%level)

    block check(%level: I64):
        %aligned: Bool = #self.aligned_to_cover(%exclusive, %level)
        branch %aligned ? next(%level) : pull(%level)

    block pull(%level: I64):
        %ancestor: I64 = %exclusive.sub(1).lshr(%level)
        #self.pull_node(%ancestor)
        jump next(%level)

    block next(%level: I64):
        jump loop(%level.add(1))

routine LazySegmentTree<T, L>.set(#self: Ptr<Self>, %index: I64, %value: T) -> Void
    block entry():
        %length: I64 := #self.length
        %not_negative: Bool = %index.sge(0)
        %before_end: Bool = %index.slt(%length)
        %in_bounds: Bool = %not_negative.bitand(%before_end)
        branch %in_bounds ? update(%index, %value) : panic(TrapCode.Bounds)

    block update(%index: I64, %value: T):
        %node: I64 = #self.leaf(%index)
        #self.push_path(%node)
        #data: Ptr<T> := #self.data
        #data[%node] = %value
        #self.rebuild_path(%node)
        return()

routine LazySegmentTree<T, L>.get(#self: Ptr<Self>, %index: I64) -> T
    block entry():
        %length: I64 := #self.length
        %not_negative: Bool = %index.sge(0)
        %before_end: Bool = %index.slt(%length)
        %in_bounds: Bool = %not_negative.bitand(%before_end)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: I64):
        %node: I64 = #self.leaf(%index)
        #self.push_path(%node)
        #data: Ptr<T> := #self.data
        %value: T := #data[%node]
        return(%value)

routine LazySegmentTree<T, L>.range_apply(#self: Ptr<Self>, %left: I64, %right: I64, %tag: L) -> Void
    block entry():
        %valid_left: Bool = %left.sge(0)
        %valid_order: Bool = %left.sle(%right)
        %length: I64 := #self.length
        %valid_right: Bool = %right.sle(%length)
        %valid_a: Bool = %valid_left.bitand(%valid_order)
        %valid: Bool = %valid_a.bitand(%valid_right)
        branch %valid ? maybe_empty(%left, %right, %tag) : panic(TrapCode.Bounds)

    block maybe_empty(%left: I64, %right: I64, %tag: L):
        %empty: Bool = %left.eq(%right)
        branch %empty ? return() : prepare(%left, %right, %tag)

    block prepare(%left: I64, %right: I64, %tag: L):
        %l0: I64 = #self.leaf(%left)
        %r0: I64 = #self.leaf(%right.sub(1))
        %rex0: I64 = %r0.add(1)
        #self.push_path(%l0)
        #self.push_path(%r0)
        jump loop(%l0, %rex0, 1, %tag, %l0, %rex0)

    block loop(%l: I64, %r: I64, %width: I64, %tag: L, %l0: I64, %rex0: I64):
        %done: Bool = %l.sge(%r)
        branch %done ? rebuild(%l0, %rex0) : apply_left(%l, %r, %width, %tag, %l0, %rex0)

    block apply_left(%l: I64, %r: I64, %width: I64, %tag: L, %l0: I64, %rex0: I64):
        %take_left: Bool = #self.is_right_child(%l)
        branch %take_left
            ? take_left(%l, %r, %width, %tag, %l0, %rex0)
            : apply_right(%l, %r, %width, %tag, %l0, %rex0)

    block take_left(%l: I64, %r: I64, %width: I64, %tag: L, %l0: I64, %rex0: I64):
        #self.apply_node(%l, %tag, %width)
        jump apply_right(%l.add(1), %r, %width, %tag, %l0, %rex0)

    block apply_right(%l: I64, %r: I64, %width: I64, %tag: L, %l0: I64, %rex0: I64):
        %take_right: Bool = #self.is_right_child(%r)
        branch %take_right
            ? take_right(%l, %r, %width, %tag, %l0, %rex0)
            : climb(%l, %r, %width, %tag, %l0, %rex0)

    block take_right(%l: I64, %r: I64, %width: I64, %tag: L, %l0: I64, %rex0: I64):
        %node: I64 = %r.sub(1)
        #self.apply_node(%node, %tag, %width)
        jump climb(%l, %node, %width, %tag, %l0, %rex0)

    block climb(%l: I64, %r: I64, %width: I64, %tag: L, %l0: I64, %rex0: I64):
        %next_l: I64 = #self.parent(%l)
        %next_r: I64 = #self.parent(%r)
        %next_width: I64 = %width.shl(1)
        jump loop(%next_l, %next_r, %next_width, %tag, %l0, %rex0)

    block rebuild(%l0: I64, %rex0: I64):
        #self.rebuild_left_boundary(%l0)
        #self.rebuild_right_boundary(%rex0)
        return()

routine LazySegmentTree<T, L>.range_query(#self: Ptr<Self>, %left: I64, %right: I64) -> T
    block entry():
        %valid_left: Bool = %left.sge(0)
        %valid_order: Bool = %left.sle(%right)
        %length: I64 := #self.length
        %valid_right: Bool = %right.sle(%length)
        %valid_a: Bool = %valid_left.bitand(%valid_order)
        %valid: Bool = %valid_a.bitand(%valid_right)
        branch %valid ? maybe_empty(%left, %right) : panic(TrapCode.Bounds)

    block maybe_empty(%left: I64, %right: I64):
        %empty: Bool = %left.eq(%right)
        branch %empty ? empty() : prepare(%left, %right)

    block empty():
        %identity: T = T.identity()
        return(%identity)

    block prepare(%left: I64, %right: I64):
        %l: I64 = #self.leaf(%left)
        %r: I64 = #self.leaf(%right.sub(1))
        #self.push_path(%l)
        #self.push_path(%r)
        %left_acc: T = T.identity()
        %right_acc: T = T.identity()
        jump loop(%l, %r.add(1), %left_acc, %right_acc)

    block loop(%l: I64, %r: I64, %left_acc: T, %right_acc: T):
        %done: Bool = %l.sge(%r)
        branch %done ? finish(%left_acc, %right_acc) : take_left(%l, %r, %left_acc, %right_acc)

    block take_left(%l: I64, %r: I64, %left_acc: T, %right_acc: T):
        %use_left: Bool = #self.is_right_child(%l)
        branch %use_left
            ? use_left(%l, %r, %left_acc, %right_acc)
            : take_right(%l, %r, %left_acc, %right_acc)

    block use_left(%l: I64, %r: I64, %left_acc: T, %right_acc: T):
        #data: Ptr<T> := #self.data
        %value: T := #data[%l]
        %next_left: T = %left_acc.combine(%value)
        jump take_right(%l.add(1), %r, %next_left, %right_acc)

    block take_right(%l: I64, %r: I64, %left_acc: T, %right_acc: T):
        %use_right: Bool = #self.is_right_child(%r)
        branch %use_right
            ? use_right(%l, %r, %left_acc, %right_acc)
            : climb(%l, %r, %left_acc, %right_acc)

    block use_right(%l: I64, %r: I64, %left_acc: T, %right_acc: T):
        %node: I64 = %r.sub(1)
        #data: Ptr<T> := #self.data
        %value: T := #data[%node]
        %next_right: T = %value.combine(%right_acc)
        jump climb(%l, %node, %left_acc, %next_right)

    block climb(%l: I64, %r: I64, %left_acc: T, %right_acc: T):
        %next_l: I64 = #self.parent(%l)
        %next_r: I64 = #self.parent(%r)
        jump loop(%next_l, %next_r, %left_acc, %right_acc)

    block finish(%left_acc: T, %right_acc: T):
        %value: T = %left_acc.combine(%right_acc)
        return(%value)

routine LazySegmentTree<T, L>.free(#self: Ptr<Self>, #alloc: Ptr<Allocator>) -> Void
    block entry():
        #data: Ptr<T> := #self.data
        #lazy: Ptr<L> := #self.lazy
        %has_data: Bool = #data.is_not_null()
        branch %has_data ? free_data(#data, #lazy) : free_lazy(#lazy)

    block free_data(#data: Ptr<T>, #lazy: Ptr<L>):
        free<T>(#alloc, #data)
        jump free_lazy(#lazy)

    block free_lazy(#lazy: Ptr<L>):
        %has_lazy: Bool = #lazy.is_not_null()
        branch %has_lazy ? release_lazy(#lazy) : reset()

    block release_lazy(#lazy: Ptr<L>):
        free<L>(#alloc, #lazy)
        jump reset()

    block reset():
        #self.data = null
        #self.lazy = null
        #self.length = 0
        #self.size = 0
        #self.height = 0
        return()

; ── Demo: range add, range sum ────────────────────────────────────────────────

; A segment's sum. Applying an add of %delta to %length elements adds %delta * %length.
struct RangeSum
    sum: I64

; A pending add over every element of a segment.
struct RangeAdd
    delta: I64

routine RangeSum.identity() -> Self
    block entry():
        %zero: Self = Self { sum: 0 }
        return(%zero)

routine RangeSum.combine(%self: Self, %right: Self) -> Self
    block entry():
        %total: Self = Self { sum: %self.sum.add(%right.sum) }
        return(%total)

routine RangeSum.apply(%self: Self, %lazy: RangeAdd, %length: I64) -> Self
    block entry():
        %added: I64 = %lazy.delta.mul(%length)
        %result: Self = Self { sum: %self.sum.add(%added) }
        return(%result)

routine RangeAdd.identity() -> Self
    block entry():
        %none: Self = Self { delta: 0 }
        return(%none)

routine RangeAdd.compose(%self: Self, %older: Self) -> Self
    block entry():
        %both: Self = Self { delta: %self.delta.add(%older.delta) }
        return(%both)

routine RangeAdd.is_identity_lazy(%self: Self) -> Bool
    block entry():
        %none: Bool = %self.delta.eq(0)
        return(%none)

routine print_sum(
        #out: Ptr<BufWriter<FdWriter>>, #tree: Ptr<LazySegmentTree<RangeSum, RangeAdd>>,
        %left: I64, %right: I64) -> Void
    block entry():
        %total: RangeSum = #tree.range_query(%left, %right)
        write_str(#out, "sum [")
        %left.format(#out)
        write_str(#out, ", ")
        %right.format(#out)
        write_str(#out, ") = ")
        %total.sum.format(#out)
        write_line(#out)
        return()

routine print_get(#out: Ptr<BufWriter<FdWriter>>, #tree: Ptr<LazySegmentTree<RangeSum, RangeAdd>>, %index: I64) -> Void
    block entry():
        %value: RangeSum = #tree.get(%index)
        write_str(#out, "get ")
        %index.format(#out)
        write_str(#out, " = ")
        %value.sum.format(#out)
        write_line(#out)
        return()

routine print_add(#out: Ptr<BufWriter<FdWriter>>, %left: I64, %right: I64, %delta: I64) -> Void
    block entry():
        write_str(#out, "add ")
        %delta.format(#out)
        write_str(#out, " to [")
        %left.format(#out)
        write_str(#out, ", ")
        %right.format(#out)
        write_str(#out, ")")
        write_line(#out)
        return()

; Fills %count leaves with i * 7 mod 10: 0 7 4 1 8 5 2 9 6 3.
routine fill_values(#values: Ptr<RangeSum>, %count: I64) -> Void
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %done: Bool = %i.sge(%count)
        branch %done ? return() : store(%i)

    block store(%i: I64):
        %leaf: RangeSum = RangeSum { sum: %i.mul(7).srem(10) }
        #values[%i] = %leaf
        jump loop(%i.add(1))

routine main() -> I32
    block entry():
        %fd_val: FdWriter      = FdWriter.stdout()
        #fd:     Ptr<FdWriter> = alloca<FdWriter>([%fd_val])
        #out: Ptr<BufWriter<FdWriter>> = alloca<BufWriter<FdWriter>>
        #out.init(#fd)
        %heap:  Allocator      = make_heap_allocator()
        #alloc: Ptr<Allocator> = alloca<Allocator>([%heap])
        #values: Ptr<RangeSum> = alloc<RangeSum>(#alloc, 10)
        %no_values: Bool = #values.is_null()
        branch %no_values ? panic(TrapCode.AllocFailed) : run(#out, #alloc, #values)

    block run(#out: Ptr<BufWriter<FdWriter>>, #alloc: Ptr<Allocator>, #values: Ptr<RangeSum>):
        fill_values(#values, 10)
        %tree_val: LazySegmentTree<RangeSum, RangeAdd> = LazySegmentTree<RangeSum, RangeAdd>.new(10, #alloc)
        #tree: Ptr<LazySegmentTree<RangeSum, RangeAdd>> = alloca<LazySegmentTree<RangeSum, RangeAdd>>([%tree_val])
        #tree.build_from(#values)
        free<RangeSum>(#alloc, #values)
        print_sum(#out, #tree, 0, 10)
        print_sum(#out, #tree, 3, 8)

        print_add(#out, 2, 7, 10)
        #tree.range_apply(2, 7, RangeAdd { delta: 10 })
        print_sum(#out, #tree, 0, 10)
        print_sum(#out, #tree, 3, 5)
        print_sum(#out, #tree, 6, 9)

        print_add(#out, 0, 4, -3)
        #tree.range_apply(0, 4, RangeAdd { delta: -3 })
        print_sum(#out, #tree, 0, 4)
        print_sum(#out, #tree, 1, 8)
        print_get(#out, #tree, 3)

        #tree.set(5, RangeSum { sum: 100 })
        print_get(#out, #tree, 5)
        print_sum(#out, #tree, 4, 7)
        print_sum(#out, #tree, 4, 4)
        print_sum(#out, #tree, 0, 10)
        #tree.free(#alloc)
        #out.flush()
        return(0)
