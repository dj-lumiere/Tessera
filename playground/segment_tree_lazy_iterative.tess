// Tessera stdlib algorithm: iterative lazy segment tree
//
// T and L must satisfy LazySegmentOps<T, L>.
// Ranges are half-open: [left, right).
//
// Layout:
//   data[1..size)      internal aggregate nodes
//   data[size..2*size) leaves
//   lazy[1..size)      pending internal lazy tags
//
// The bit routines below hide the heap-index arithmetic. They are compact on
// purpose, but callers use names that describe the tree operation.

import Standard::Alloc
import Standard::Format

concept Monoid<T>
require T: typename
    routine Self.identity() -> Self
    routine Self.combine(%self: Self, %right: Self) -> Self

concept Group<T>
conform Monoid<T>
require T: typename
    routine Self.inverse(%self: Self) -> Self

/// Constrains two types at once, so there is no single conforming Self —
/// required routines name their owner (T or L) explicitly.
concept LazySegmentOps<T, L>
require T: typename, L: typename
    /// Aggregate two child values.
    routine T.combine(%self: Self, %right: Self) -> Self

    /// Apply one lazy tag to an aggregate value over a segment of length.
    routine T.apply(%self: Self, %lazy: L, %length: USize) -> Self

    /// Compose tags so the returned tag represents newer after older.
    routine L.compose(%self: Self, %older: Self) -> Self

    routine T.identity() -> Self
    routine L.identity() -> Self
    routine L.is_identity_lazy(%self: Self) -> Bool

record LazySegmentTree<T, L>
require T: typename, L: typename, LazySegmentOps<T, L>
    data   : Ptr<T>
    lazy   : Ptr<L>
    length : USize
    size   : USize
    height : USize

routine LazySegmentTree<T, L>.parent(%self: Ptr<Self>, %node: USize) -> USize
    block entry():
        %parent : USize = %node.shr(1)
        return(%parent)

routine LazySegmentTree<T, L>.left_child(%self: Ptr<Self>, %node: USize) -> USize
    block entry():
        %child : USize = %node.shl(1)
        return(%child)

routine LazySegmentTree<T, L>.right_child(%self: Ptr<Self>, %node: USize) -> USize
    block entry():
        %right_child : USize = %node.shl(1).bitor(1)
        return(%right_child)

routine LazySegmentTree<T, L>.is_right_child(%self: Ptr<Self>, %node: USize) -> Bool
    block entry():
        %is_right : Bool = %node.bitand(1).ne(0)
        return(%is_right)

routine LazySegmentTree<T, L>.leaf(%self: Ptr<Self>, %index: USize) -> USize
    block entry():
        %size : USize = %self.size.load()
        %leaf : USize = %index.bitor(%size)
        return(%leaf)

routine LazySegmentTree<T, L>.cover_width(%self: Ptr<Self>, %height: USize) -> USize
    block entry():
        %width : USize = 1.shl(%height)
        return(%width)

routine LazySegmentTree<T, L>.cover_mask(%self: Ptr<Self>, %height: USize) -> USize
    block entry():
        %mask : USize = %self.cover_width(%height).sub(1)
        return(%mask)

routine LazySegmentTree<T, L>.aligned_to_cover(%self: Ptr<Self>, %node: USize,
        %height: USize) -> Bool
    block entry():
        %mask    : USize = %self.cover_mask(%height)
        %aligned : Bool  = %node.bitand(%mask).eq(0)
        return(%aligned)

routine LazySegmentTree<T, L>.construct(%length: USize, %alloc: Ptr<Allocator>) -> Self
    block entry():
        %invalid : Bool = %length.le(0)
        branch %invalid ? panic(TrapCode.InvalidArgument) : choose_size(1, 0)

    block choose_size(%size: USize, %height: USize):
        %done : Bool = %size.ge(%length)
        branch %done ? allocate(%size, %height) : grow(%size, %height)

    block grow(%size: USize, %height: USize):
        jump choose_size(%size.shl(1), %height.add(1))

    block allocate(%size: USize, %height: USize):
        %data_count  : USize  = %size.shl(1)
        %data        : Ptr<T> = allocate<T>(%alloc, %data_count)
        %lazy        : Ptr<L> = allocate<L>(%alloc, %size)
        %data_failed : Bool   = %data.is_null()
        %lazy_failed : Bool   = %lazy.is_null()
        %failed      : Bool   = %data_failed.bitor(%lazy_failed)
        branch %failed
            ? panic(TrapCode.AllocFailed)
            : init_data(%data, %lazy, %length, %size, %height, %data_count)

    block init_data(%data: Ptr<T>, %lazy: Ptr<L>, %length: USize, %size: USize, %height: USize,
            %data_count: USize):
        jump data_loop(0, %data, %lazy, %length, %size, %height, %data_count)

    block data_loop(%i: USize, %data: Ptr<T>, %lazy: Ptr<L>, %length: USize, %size: USize,
            %height: USize, %data_count: USize):
        %done : Bool = %i.ge(%data_count)
        branch %done
            ? init_lazy(0, %data, %lazy, %length, %size, %height)
            : data_one(%i, %data, %lazy, %length, %size, %height, %data_count)

    block data_one(%i: USize, %data: Ptr<T>, %lazy: Ptr<L>, %length: USize, %size: USize,
            %height: USize, %data_count: USize):
        %identity : T = .identity()
        %data[%i].store(%identity)
        jump data_loop(%i.add(1), %data, %lazy, %length, %size, %height, %data_count)

    block init_lazy(%i: USize, %data: Ptr<T>, %lazy: Ptr<L>, %length: USize, %size: USize,
            %height: USize):
        %done : Bool = %i.ge(%size)
        branch %done
            ? finish(%data, %lazy, %length, %size, %height)
            : lazy_one(%i, %data, %lazy, %length, %size, %height)

    block lazy_one(%i: USize, %data: Ptr<T>, %lazy: Ptr<L>, %length: USize, %size: USize,
            %height: USize):
        %identity : L = .identity()
        %lazy[%i].store(%identity)
        jump init_lazy(%i.add(1), %data, %lazy, %length, %size, %height)

    block finish(%data: Ptr<T>, %lazy: Ptr<L>, %length: USize, %size: USize, %height: USize):
        %tree : Self = Self { data: %data, lazy: %lazy, length: %length, size: %size,
                height: %height }
        return(%tree)

routine LazySegmentTree<T, L>.length(%self: Ptr<Self>) -> USize
    block entry():
        %length : USize = %self.length.load()
        return(%length)

routine LazySegmentTree<T, L>.build_from(%self: Ptr<Self>, %values: Ptr<T>) -> Void
    block entry():
        jump copy_loop(0)

    block copy_loop(%i: USize):
        %length : USize = %self.length.load()
        %done   : Bool  = %i.ge(%length)
        branch %done ? reset_lazy(0) : copy_one(%i)

    block copy_one(%i: USize):
        %data  : Ptr<T> = %self.data.load()
        %leaf  : USize  = %self.leaf(%i)
        %value : T      = %values[%i].load()
        %data[%leaf].store(%value)
        jump copy_loop(%i.add(1))

    block reset_lazy(%i: USize):
        %size : USize = %self.size.load()
        %done : Bool  = %i.ge(%size)
        branch %done ? pull_all() : reset_one(%i)

    block reset_one(%i: USize):
        %lazy     : Ptr<L> = %self.lazy.load()
        %identity : L      = .identity()
        %lazy[%i].store(%identity)
        jump reset_lazy(%i.add(1))

    block pull_all():
        %size  : USize = %self.size.load()
        %start : USize = %size.sub(1)
        jump pull_loop(%start)

    block pull_loop(%node: USize):
        %done : Bool = %node.le(0)
        branch %done ? return() : continue
        %self.pull_node(%node)
        jump pull_loop(%node.sub(1))

routine LazySegmentTree<T, L>.pull_node(%self: Ptr<Self>, %node: USize) -> Void
    block entry():
        %data        : Ptr<T> = %self.data.load()
        %left        : USize  = %self.left_child(%node)
        %right       : USize  = %self.right_child(%node)
        %left_value  : T      = %data[%left].load()
        %right_value : T      = %data[%right].load()
        %value       : T      = %left_value.combine(%right_value)
        %data[%node].store(%value)
        return()

routine LazySegmentTree<T, L>.apply_node(%self: Ptr<Self>, %node: USize, %tag: L,
        %width: USize) -> Void
    block entry():
        %data : Ptr<T> = %self.data.load()
        %data[%node].load().apply(%tag, %width).store_into(%data[%node])
        %size        : USize = %self.size.load()
        %is_internal : Bool  = %node.lt(%size)
        branch %is_internal ? continue : return()
        %lazy : Ptr<L> = %self.lazy.load()
        %old  : L      = %lazy[%node].load()
        %next : L      = %tag.compose(%old)
        %lazy[%node].store(%next)
        return()

routine LazySegmentTree<T, L>.push_node(%self: Ptr<Self>, %node: USize, %width: USize) -> Void
    block entry():
        %lazy  : Ptr<L> = %self.lazy.load()
        %tag   : L      = %lazy[%node].load()
        %clean : Bool   = %tag.is_identity_lazy()
        branch %clean ? return() : spread(%node, %tag, %width)

    block spread(%node: USize, %tag: L, %width: USize):
        %child_width : USize = %width.shr(1)
        %left        : USize = %self.left_child(%node)
        %right       : USize = %self.right_child(%node)
        %self.apply_node(%left, %tag, %child_width)
        %self.apply_node(%right, %tag, %child_width)
        %lazy     : Ptr<L> = %self.lazy.load()
        %identity : L      = .identity()
        %lazy[%node].store(%identity)
        return()

routine LazySegmentTree<T, L>.push_path(%self: Ptr<Self>, %node: USize) -> Void
    block entry():
        %height : USize = %self.height.load()
        jump loop(%height)

    block loop(%level: USize):
        %done : Bool = %level.le(0)
        branch %done ? return() : continue
        %ancestor : USize = %node.shr(%level)
        %width    : USize = %self.cover_width(%level)
        %self.push_node(%ancestor, %width)
        jump loop(%level.sub(1))

routine LazySegmentTree<T, L>.rebuild_path(%self: Ptr<Self>, %node: USize) -> Void
    block entry():
        %parent : USize = %self.parent(%node)
        jump loop(%parent)

    block loop(%node: USize):
        %done : Bool = %node.le(0)
        branch %done ? return() : continue
        %self.pull_node(%node)
        %parent : USize = %self.parent(%node)
        jump loop(%parent)

routine LazySegmentTree<T, L>.rebuild_left_boundary(%self: Ptr<Self>, %node: USize) -> Void
    block entry():
        jump loop(1)

    block loop(%level: USize):
        %height : USize = %self.height.load()
        %done   : Bool  = %level.gt(%height)
        branch %done ? return() : continue
        %aligned : Bool = %self.aligned_to_cover(%node, %level)
        branch %aligned ? next(%level) : pull(%level)

    block pull(%level: USize):
        %ancestor : USize = %node.shr(%level)
        %self.pull_node(%ancestor)
        jump next(%level)

    block next(%level: USize):
        jump loop(%level.add(1))

routine LazySegmentTree<T, L>.rebuild_right_boundary(%self: Ptr<Self>, %exclusive: USize) -> Void
    block entry():
        jump loop(1)

    block loop(%level: USize):
        %height : USize = %self.height.load()
        %done   : Bool  = %level.gt(%height)
        branch %done ? return() : continue
        %aligned : Bool = %self.aligned_to_cover(%exclusive, %level)
        branch %aligned ? next(%level) : pull(%level)

    block pull(%level: USize):
        %ancestor : USize = %exclusive.sub(1).shr(%level)
        %self.pull_node(%ancestor)
        jump next(%level)

    block next(%level: USize):
        jump loop(%level.add(1))

routine LazySegmentTree<T, L>.set(%self: Ptr<Self>, %index: USize, %value: T) -> Void
    block entry():
        %length       : USize = %self.length.load()
        %not_negative : Bool  = %index.ge(0)
        %before_end   : Bool  = %index.lt(%length)
        %in_bounds    : Bool  = %not_negative.bitand(%before_end)
        branch %in_bounds ? continue : panic(TrapCode.Bounds)
        %node : USize = %self.leaf(%index)
        %self.push_path(%node)
        %data : Ptr<T> = %self.data.load()
        %data[%node].store(%value)
        %self.rebuild_path(%node)
        return()

routine LazySegmentTree<T, L>.get(%self: Ptr<Self>, %index: USize) -> T
    block entry():
        %length       : USize = %self.length.load()
        %not_negative : Bool  = %index.ge(0)
        %before_end   : Bool  = %index.lt(%length)
        %in_bounds    : Bool  = %not_negative.bitand(%before_end)
        branch %in_bounds ? load(%index) : panic(TrapCode.Bounds)

    block load(%index: USize):
        %node : USize = %self.leaf(%index)
        %self.push_path(%node)
        %data  : Ptr<T> = %self.data.load()
        %value : T      = %data[%node].load()
        return(%value)

routine LazySegmentTree<T, L>.range_apply(%self: Ptr<Self>, %left: USize, %right: USize,
        %tag: L) -> Void
    block entry():
        %valid_left  : Bool  = %left.ge(0)
        %valid_order : Bool  = %left.le(%right)
        %length      : USize = %self.length.load()
        %valid_right : Bool  = %right.le(%length)
        %valid_a     : Bool  = %valid_left.bitand(%valid_order)
        %valid       : Bool  = %valid_a.bitand(%valid_right)
        branch %valid ? continue : panic(TrapCode.Bounds)
        %empty : Bool = %left.eq(%right)
        branch %empty ? return() : continue
        %l0   : USize = %self.leaf(%left)
        %r0   : USize = %self.leaf(%right.sub(1))
        %rex0 : USize = %r0.add(1)
        %self.push_path(%l0)
        %self.push_path(%r0)
        jump loop(%l0, %rex0, 1, %tag, %l0, %rex0)

    block loop(%l: USize, %r: USize, %width: USize, %tag: L, %l0: USize, %rex0: USize):
        %done : Bool = %l.ge(%r)
        branch %done ? rebuild(%l0, %rex0) : apply_left(%l, %r, %width, %tag, %l0, %rex0)

    block apply_left(%l: USize, %r: USize, %width: USize, %tag: L, %l0: USize, %rex0: USize):
        %take_left : Bool = %self.is_right_child(%l)
        branch %take_left
            ? take_left(%l, %r, %width, %tag, %l0, %rex0)
            : apply_right(%l, %r, %width, %tag, %l0, %rex0)

    block take_left(%l: USize, %r: USize, %width: USize, %tag: L, %l0: USize, %rex0: USize):
        %self.apply_node(%l, %tag, %width)
        jump apply_right(%l.add(1), %r, %width, %tag, %l0, %rex0)

    block apply_right(%l: USize, %r: USize, %width: USize, %tag: L, %l0: USize, %rex0: USize):
        %take_right : Bool = %self.is_right_child(%r)
        branch %take_right
            ? take_right(%l, %r, %width, %tag, %l0, %rex0)
            : climb(%l, %r, %width, %tag, %l0, %rex0)

    block take_right(%l: USize, %r: USize, %width: USize, %tag: L, %l0: USize, %rex0: USize):
        %node : USize = %r.sub(1)
        %self.apply_node(%node, %tag, %width)
        jump climb(%l, %node, %width, %tag, %l0, %rex0)

    block climb(%l: USize, %r: USize, %width: USize, %tag: L, %l0: USize, %rex0: USize):
        %next_l     : USize = %self.parent(%l)
        %next_r     : USize = %self.parent(%r)
        %next_width : USize = %width.shl(1)
        jump loop(%next_l, %next_r, %next_width, %tag, %l0, %rex0)

    block rebuild(%l0: USize, %rex0: USize):
        %self.rebuild_left_boundary(%l0)
        %self.rebuild_right_boundary(%rex0)
        return()

routine LazySegmentTree<T, L>.range_query(%self: Ptr<Self>, %left: USize, %right: USize) -> T
    block entry():
        %valid_left  : Bool  = %left.ge(0)
        %valid_order : Bool  = %left.le(%right)
        %length      : USize = %self.length.load()
        %valid_right : Bool  = %right.le(%length)
        %valid_a     : Bool  = %valid_left.bitand(%valid_order)
        %valid       : Bool  = %valid_a.bitand(%valid_right)
        branch %valid ? continue : panic(TrapCode.Bounds)
        %empty : Bool = %left.eq(%right)
        branch %empty ? empty() : prepare(%left, %right)

    block empty():
        %identity : T = .identity()
        return(%identity)

    block prepare(%left: USize, %right: USize):
        %l : USize = %self.leaf(%left)
        %r : USize = %self.leaf(%right.sub(1))
        %self.push_path(%l)
        %self.push_path(%r)
        %left_acc  : T = .identity()
        %right_acc : T = .identity()
        jump loop(%l, %r.add(1), %left_acc, %right_acc)

    block loop(%l: USize, %r: USize, %left_acc: T, %right_acc: T):
        %done : Bool = %l.ge(%r)
        branch %done ? finish(%left_acc, %right_acc) : take_left(%l, %r, %left_acc, %right_acc)

    block take_left(%l: USize, %r: USize, %left_acc: T, %right_acc: T):
        %use_left : Bool = %self.is_right_child(%l)
        branch %use_left
            ? use_left(%l, %r, %left_acc, %right_acc)
            : take_right(%l, %r, %left_acc, %right_acc)

    block use_left(%l: USize, %r: USize, %left_acc: T, %right_acc: T):
        %data      : Ptr<T> = %self.data.load()
        %value     : T      = %data[%l].load()
        %next_left : T      = %left_acc.combine(%value)
        jump take_right(%l.add(1), %r, %next_left, %right_acc)

    block take_right(%l: USize, %r: USize, %left_acc: T, %right_acc: T):
        %use_right : Bool = %self.is_right_child(%r)
        branch %use_right
            ? use_right(%l, %r, %left_acc, %right_acc)
            : climb(%l, %r, %left_acc, %right_acc)

    block use_right(%l: USize, %r: USize, %left_acc: T, %right_acc: T):
        %node       : USize  = %r.sub(1)
        %data       : Ptr<T> = %self.data.load()
        %value      : T      = %data[%node].load()
        %next_right : T      = %value.combine(%right_acc)
        jump climb(%l, %node, %left_acc, %next_right)

    block climb(%l: USize, %r: USize, %left_acc: T, %right_acc: T):
        %next_l : USize = %self.parent(%l)
        %next_r : USize = %self.parent(%r)
        jump loop(%next_l, %next_r, %left_acc, %right_acc)

    block finish(%left_acc: T, %right_acc: T):
        %value : T = %left_acc.combine(%right_acc)
        return(%value)

routine LazySegmentTree<T, L>.destruct(%self: Ptr<Self>, %alloc: Ptr<Allocator>) -> Void
    block entry():
        %data     : Ptr<T> = %self.data.load()
        %lazy     : Ptr<L> = %self.lazy.load()
        %has_data : Bool   = %data.is_not_null()
        branch %has_data ? free_data(%data, %lazy) : free_lazy(%lazy)

    block free_data(%data: Ptr<T>, %lazy: Ptr<L>):
        %data.free(%alloc)
        jump free_lazy(%lazy)

    block free_lazy(%lazy: Ptr<L>):
        %has_lazy : Bool = %lazy.is_not_null()
        branch %has_lazy ? release_lazy(%lazy) : reset()

    block release_lazy(%lazy: Ptr<L>):
        %lazy.free(%alloc)
        jump reset()

    block reset():
        %self.data.store(null)
        %self.lazy.store(null)
        %self.length.store(0)
        %self.size.store(0)
        %self.height.store(0)
        return()

// ── Demo: range add, range sum ────────────────────────────────────────────────

/// A segment's sum. Applying an add of delta to length elements adds delta * length.
record RangeSum
    sum : S64

/// A pending add over every element of a segment.
record RangeAdd
    delta : S64

/// LazySegmentOps constrains two types at once, so the conformance is its own declaration.
conform LazySegmentOps<RangeSum, RangeAdd>

routine RangeSum.identity() -> Self
    block entry():
        %zero : Self = Self { sum: 0 }
        return(%zero)

routine RangeSum.combine(%self: Self, %right: Self) -> Self
    block entry():
        %total : Self = Self { sum: %self.sum.add(%right.sum) }
        return(%total)

routine RangeSum.apply(%self: Self, %lazy: RangeAdd, %length: USize) -> Self
    block entry():
        %added  : S64  = %lazy.delta.mul(%length.to_s64())
        %result : Self = Self { sum: %self.sum.add(%added) }
        return(%result)

routine RangeAdd.identity() -> Self
    block entry():
        %none : Self = Self { delta: 0 }
        return(%none)

routine RangeAdd.compose(%self: Self, %older: Self) -> Self
    block entry():
        %both : Self = Self { delta: %self.delta.add(%older.delta) }
        return(%both)

routine RangeAdd.is_identity_lazy(%self: Self) -> Bool
    block entry():
        %none : Bool = %self.delta.eq(0)
        return(%none)

routine print_sum(%out: Ptr<BufWriter<FdWriter>>, %tree: Ptr<LazySegmentTree<RangeSum, RangeAdd>>,
        %left: USize, %right: USize) -> Void
    block entry():
        %total : RangeSum = %tree.range_query(%left, %right)
        write(%out, "sum [{%left}, {%right}) = {%total.sum}\n")
        return()

routine print_get(%out: Ptr<BufWriter<FdWriter>>, %tree: Ptr<LazySegmentTree<RangeSum, RangeAdd>>,
        %index: USize) -> Void
    block entry():
        %value : RangeSum = %tree.get(%index)
        write(%out, "get {%index} = {%value.sum}\n")
        return()

routine print_add(%out: Ptr<BufWriter<FdWriter>>, %left: USize, %right: USize, %delta: S64) -> Void
    block entry():
        write(%out, "add {%delta} to [{%left}, {%right})\n")
        return()

/// Fills count leaves with i * 7 mod 10: 0 7 4 1 8 5 2 9 6 3.
routine fill_values(%values: Ptr<RangeSum>, %count: USize) -> Void
    block entry():
        jump loop(0)

    block loop(%i: USize):
        %done : Bool = %i.ge(%count)
        branch %done ? return() : store(%i)

    block store(%i: USize):
        %leaf : RangeSum = RangeSum { sum: %i.mul(7).rem(10).to_s64() }
        %values[%i].store(%leaf)
        jump loop(%i.add(1))

routine main() -> S32
    block entry():
        %fd_val : FdWriter = .stdout()
        claim %fd : Ptr<FdWriter>
        %fd.store(%fd_val)
        claim %out : Ptr<BufWriter<FdWriter>>
        %out.construct(%fd)
        %heap : Allocator = make_heap_allocator()
        claim %alloc : Ptr<Allocator>
        %alloc.store(%heap)
        %values    : Ptr<RangeSum> = allocate<RangeSum>(%alloc, 10)
        %no_values : Bool          = %values.is_null()
        branch %no_values ? panic(TrapCode.AllocFailed) : continue
        fill_values(%values, 10)
        %tree_val : LazySegmentTree<RangeSum, RangeAdd> = .construct(10, %alloc)
        claim %tree : Ptr<LazySegmentTree<RangeSum, RangeAdd>>
        %tree.store(%tree_val)
        %tree.build_from(%values)
        %values.free(%alloc)
        print_sum(%out, %tree, 0, 10)
        print_sum(%out, %tree, 3, 8)

        print_add(%out, 2, 7, 10)
        %tree.range_apply(2, 7, RangeAdd { delta: 10 })
        print_sum(%out, %tree, 0, 10)
        print_sum(%out, %tree, 3, 5)
        print_sum(%out, %tree, 6, 9)

        print_add(%out, 0, 4, -3)
        %tree.range_apply(0, 4, RangeAdd { delta: -3 })
        print_sum(%out, %tree, 0, 4)
        print_sum(%out, %tree, 1, 8)
        print_get(%out, %tree, 3)

        %tree.set(5, RangeSum { sum: 100 })
        print_get(%out, %tree, 5)
        print_sum(%out, %tree, 4, 7)
        print_sum(%out, %tree, 4, 4)
        print_sum(%out, %tree, 0, 10)
        %tree.destruct(%alloc)
        %out.flush()
        return(0)
