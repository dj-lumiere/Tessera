// Tessera playground: "union" via comptime-sized record
//
// Tessera has no `union` keyword. The same effect comes from declaring a record
// whose only field is an aligned byte buffer sized to fit the largest member.
// `sizeof<T>()`, `alignof<T>()`, and `max(...)` are comptime-reducible, so the
// compiler still picks up the right layout at monomorphization time.
//
//     record N
//         @aligned(max(alignof<A>(), alignof<B>()))
//         storage: Array<S8, max(sizeof<A>(), sizeof<B>())>
//
// Access is always an explicit pointer cast to the active view. Whoever owns
// the data is responsible for knowing which view is currently active.
//
// Trade-off: an overlay value can only be read through memory (cast + load),
// so a value-held overlay needs a stack slot before it can be inspected.
// That is the right cost for C ABI unions (Section 2). For everyday tagged
// results, prefer stdlib Result<T, E>, whose separate fields are readable by
// plain extraction (%r.value) — Section 1 exists to show the mechanism, not as
// the recommended Result.

@[external("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<Byte>) -> S32

// ============================================================
// A generic two-way overlay. Stdlib could ship UnionTwo / UnionThree, or
// users can inline the same shape — there is no special type-form involved.
// ============================================================

@aggregate
record UnionTwo<A, B>
require A: typename, B: typename
    @aligned(max(alignof<A>(), alignof<B>()))
    storage: Array<Byte, max(sizeof<A>(), sizeof<B>())>

// ============================================================
// Section 1: Manual tagged sum type
//
// IntResult — either an Ok S64 or an S32 error code. The tag lives in the
// wrapping record; the overlay carries the payload bytes.
//
// Constructors zero the overlay before writing a view: the Err view is only
// 4 of the 8 bytes, and loading the whole overlay must not pick up
// uninitialized bytes.
// ============================================================

choice IntResultTag: S32
    Ok:  0
    Err: 1

record IntResult
    tag: IntResultTag
    payload: UnionTwo<S64, S32>

routine IntResult.ok(%value: S64) -> Self
    block entry():
        #payload_buf: Ptr<UnionTwo<S64, S32>> = alloca
        #payload_buf.zeroinit(1)
        #ok_view: Ptr<S64> = #payload_buf.cast<S64>()
        #ok_view.store(%value)
        %payload: UnionTwo<S64, S32> = #payload_buf.load()
        %r: Self = Self {
            tag: IntResultTag.Ok,
            payload: %payload
        }
        return(%r)

routine IntResult.err(%code: S32) -> Self
    block entry():
        #payload_buf: Ptr<UnionTwo<S64, S32>> = alloca
        #payload_buf.zeroinit(1)
        #err_view: Ptr<S32> = #payload_buf.cast<S32>()
        #err_view.store(%code)
        %payload: UnionTwo<S64, S32> = #payload_buf.load()
        %r: Self = Self {
            tag: IntResultTag.Err,
            payload: %payload
        }
        return(%r)

/// Caller checks the tag explicitly, then casts to the active view.
routine IntResult.print(#self: Ptr<Self>) -> Void
    block entry():
        %tag: IntResultTag = #self.tag.load()
        switch %tag:
            IntResultTag.Ok -> print_ok()
            IntResultTag.Err -> print_err()
            _ -> unreachable

    block print_ok():
        #payload: Ptr<UnionTwo<S64, S32>> = #self.payload
        #ok_view: Ptr<S64> = #payload.cast<S64>()
        %v: S64 = #ok_view.load()
        c_printf("Ok(%lld)\n", %v)
        return()

    block print_err():
        #payload: Ptr<UnionTwo<S64, S32>> = #self.payload
        #err_view: Ptr<S32> = #payload.cast<S32>()
        %code: S32 = #err_view.load()
        c_printf("Err(%lld)\n", %code.to_s64())
        return()

// ============================================================
// Section 2: C ABI overlay — Number that is either int-shaped or float-shaped
//
// This is the pattern for `union sigval`, sockaddr families, or any C API
// that hands you a union by value. Tessera declares the storage record; thin
// wrappers name the views so callers don't sprinkle casts at every site.
// Both views are the full 8 bytes, so no zeroing is needed.
// ============================================================

@aggregate
record Number
    @aligned(max(alignof<S64>(), alignof<F64>()))
    storage: Array<Byte, max(sizeof<S64>(), sizeof<F64>())>

routine Number.from_int(%n: S64) -> Self
    block entry():
        #buf: Ptr<Self> = alloca
        #int_view: Ptr<S64> = #buf.cast<S64>()
        #int_view.store(%n)
        %u: Self  = #buf.load()
        return(%u)

routine Number.from_float(%f: F64) -> Self
    block entry():
        #buf: Ptr<Self> = alloca
        #float_view: Ptr<F64> = #buf.cast<F64>()
        #float_view.store(%f)
        %u: Self = #buf.load()
        return(%u)

routine Number.to_int(#self: Ptr<Self>) -> S64
    block entry():
        #view: Ptr<S64> = #self.cast<S64>()
        %n: S64 = #view.load()
        return(%n)

routine Number.to_float(#self: Ptr<Self>) -> F64
    block entry():
        #view: Ptr<F64> = #self.cast<F64>()
        %f: F64 = #view.load()
        return(%f)

// ============================================================
// main
// ============================================================

routine main() -> S32
    block entry():
        // --- tagged result ---
        %ok: IntResult = IntResult.ok(42)
        %err: IntResult = IntResult.err(-5)

        #ok_ptr: Ptr<IntResult> = alloca
        #ok_ptr.store(%ok)
        #err_ptr: Ptr<IntResult> = alloca
        #err_ptr.store(%err)
        #ok_ptr.print()
        #err_ptr.print()

        // --- C ABI overlay ---
        %to_int: Number = Number.from_int(7)
        %to_float: Number = Number.from_float(3.14)

        #int_ptr: Ptr<Number> = alloca
        #int_ptr.store(%to_int)
        #flt_ptr: Ptr<Number> = alloca
        #flt_ptr.store(%to_float)

        c_printf("Number int view: %lld\n", #int_ptr.to_int())
        c_printf("Number float view: %f\n", #flt_ptr.to_float())

        return(0)
