; Tessera playground: "union" via comptime-sized struct
;
; Tessera has no `union` keyword. The same effect comes from declaring a struct
; whose only field is an aligned byte buffer sized to fit the largest member.
; `sizeof<T>()`, `alignof<T>()`, and `max(...)` are comptime-reducible, so the
; compiler still picks up the right layout at monomorphization time.
;
;     struct N
;         @aligned(max(alignof<A>(), alignof<B>()))
;         storage: Array<I8, max(sizeof<A>(), sizeof<B>())>
;
; Access is always an explicit pointer cast to the active view. Whoever owns
; the data is responsible for knowing which view is currently active.
;
; Trade-off: an overlay value can only be read through memory (cast + load),
; so a value-held overlay needs a stack slot before it can be inspected.
; That is the right cost for C ABI unions (Section 2). For everyday tagged
; results, prefer stdlib Result<T, E>, whose separate fields are readable by
; plain extraction (%r.value) — Section 1 exists to show the mechanism, not as
; the recommended Result.

@[external("c"), callconv("c"), symbol("printf"), variadic]
routine c_printf(#fmt: Ptr<I8>) -> I32

; ============================================================
; A generic two-way overlay. Stdlib could ship UnionTwo / UnionThree, or
; users can inline the same shape — there is no special type-form involved.
; ============================================================

struct UnionTwo<A, B>
require A: typename, B: typename
    @aligned(max(alignof<A>(), alignof<B>()))
    storage: Array<I8, max(sizeof<A>(), sizeof<B>())>

; ============================================================
; Section 1: Manual tagged sum type
;
; IntResult — either an Ok I64 or an I32 error code. The tag lives in the
; wrapping struct; the overlay carries the payload bytes.
;
; Constructors zero the overlay before writing a view: the Err view is only
; 4 of the 8 bytes, and loading the whole overlay must not pick up
; uninitialized bytes.
; ============================================================

enum IntResultTag: I32
    Ok:  0
    Err: 1

struct IntResult
    tag: IntResultTag
    payload: UnionTwo<I64, I32>

routine IntResult.ok(%value: I64) -> Self
    block entry():
        #payload_buf: Ptr<UnionTwo<I64, I32>> = alloca<UnionTwo<I64, I32>>
        zero<UnionTwo<I64, I32>>(#payload_buf, 1)
        #ok_view: Ptr<I64> = #payload_buf.cast<I64>()
        #ok_view = %value
        %payload: UnionTwo<I64, I32> := #payload_buf
        %r: Self = Self {
            tag: IntResultTag.Ok,
            payload: %payload
        }
        return(%r)

routine IntResult.err(%code: I32) -> Self
    block entry():
        #payload_buf: Ptr<UnionTwo<I64, I32>> = alloca<UnionTwo<I64, I32>>
        zero<UnionTwo<I64, I32>>(#payload_buf, 1)
        #err_view: Ptr<I32> = #payload_buf.cast<I32>()
        #err_view = %code
        %payload: UnionTwo<I64, I32> := #payload_buf
        %r: Self = Self {
            tag: IntResultTag.Err,
            payload: %payload
        }
        return(%r)

; Caller checks the tag explicitly, then casts to the active view.
routine IntResult.print(#self: Ptr<Self>) -> Void
    block entry():
        %tag: IntResultTag := #self.tag
        switch %tag:
            IntResultTag.Ok -> print_ok()
            IntResultTag.Err -> print_err()
            _ -> unreachable

    block print_ok():
        #payload: Ptr<UnionTwo<I64, I32>> = #self.payload
        #ok_view: Ptr<I64> = #payload.cast<I64>()
        %v: I64 := #ok_view
        c_printf("Ok(%lld)\n", %v)
        return()

    block print_err():
        #payload: Ptr<UnionTwo<I64, I32>> = #self.payload
        #err_view: Ptr<I32> = #payload.cast<I32>()
        %code: I32 := #err_view
        c_printf("Err(%lld)\n", %code.to_i64())
        return()

; ============================================================
; Section 2: C ABI overlay — Number that is either int-shaped or float-shaped
;
; This is the pattern for `union sigval`, sockaddr families, or any C API
; that hands you a union by value. Tessera declares the storage struct; thin
; wrappers name the views so callers don't sprinkle casts at every site.
; Both views are the full 8 bytes, so no zeroing is needed.
; ============================================================

struct Number
    @aligned(max(alignof<I64>(), alignof<F64>()))
    storage: Array<I8, max(sizeof<I64>(), sizeof<F64>())>

routine Number.from_int(%n: I64) -> Self
    block entry():
        #buf: Ptr<Self> = alloca<Self>
        #int_view: Ptr<I64> = #buf.cast<I64>()
        #int_view = %n
        %u: Self := #buf
        return(%u)

routine Number.from_float(%f: F64) -> Self
    block entry():
        #buf: Ptr<Self> = alloca<Self>
        #float_view: Ptr<F64> = #buf.cast<F64>()
        #float_view = %f
        %u: Self := #buf
        return(%u)

routine Number.as_int(#self: Ptr<Self>) -> I64
    block entry():
        #view: Ptr<I64> = #self.cast<I64>()
        %n: I64 := #view
        return(%n)

routine Number.as_float(#self: Ptr<Self>) -> F64
    block entry():
        #view: Ptr<F64> = #self.cast<F64>()
        %f: F64 := #view
        return(%f)

; ============================================================
; main
; ============================================================

routine main() -> I32
    block entry():
        ; --- tagged result ---
        %ok: IntResult = IntResult.ok(42)
        %err: IntResult = IntResult.err(-5)

        #ok_ptr: Ptr<IntResult> = alloca<IntResult>([%ok])
        #err_ptr: Ptr<IntResult> = alloca<IntResult>([%err])
        #ok_ptr.print()
        #err_ptr.print()

        ; --- C ABI overlay ---
        %as_int: Number = Number.from_int(7)
        %as_float: Number = Number.from_float(3.14)

        #int_ptr: Ptr<Number> = alloca<Number>([%as_int])
        #flt_ptr: Ptr<Number> = alloca<Number>([%as_float])

        c_printf("Number int view: %lld\n", #int_ptr.as_int())
        c_printf("Number float view: %f\n", #flt_ptr.as_float())

        return(0)
